# zgenerator.z -- preparing a declared `generator` for the ordinary class walk.
#
# A generator is a DECLARATION: its `is` block is the state it is constructed
# with, and its `call` member is a body that suspends. The class is the
# author's, so this unit synthesises nothing the author already wrote -- it
# adds `call`'s implicit receiver and the option wrapper around its element
# type, generates the `create` the `is` fields describe, and appends the fields
# the suspension transform needs: a `state` cursor, the yield-crossing locals,
# the loop counters, and the resume slots. The state machine itself is the
# emitter's job; what happens here is that the class arrives at it complete.
#
# Nothing here infers ownership. A field's marker is what the author declared,
# and the generated `create`'s parameter follows from it -- which is the whole
# reason the form exists.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :GenDeclared
    :lowerDeclared
}

Node: zast.Node
Ast: zast.Ast


# The counter the synthetic `_iterN` names draw from. Node ids do not
# come from here: a synthesised node reserves its own table slot with
# zast.tableReserve.
NameCtr: class {
    # the next `_iterN` number. Node ids do NOT come from here -- a synthesised
    # node reserves its own table slot
    next: u32
} as {
    # take the next number and reserve a table slot for the node that will use
    # it
    bump: function {:this} out zast.nodeid is {
        id: this.next
        this.next = this.next + 1
        return (zast.nodeid.create from: id)
    }
}

# bodyContainsYield -- a yield anywhere in this subtree, not descending
# into nested function literals (their yields belong to that function).
bodyContainsYield: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case functiondef then {
        return false
    } case statement then {
        stx789: u64
        for stx789 < n.statements.count.u64 loop {
            s0Id: zast.kidAt kids: ast.kids span: n.statements i: stx789
            stx789 = stx789 + 1
            if (bodyContainsYield :ast n: (ast.nodes.get i: s0Id.u64)) then return true
        }
        return false
    } case statementline then {
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.statementline.u64))
    } case expression then {
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.expression.u64))
    } case assignment then {
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.value.u64))
    } case reassignment then {
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.value.u64))
    } case ifexpr then {
        clx1119: u64
        for clx1119 < n.clauses.count.u64 loop {
            cl0Id: zast.kidAt kids: ast.kids span: n.clauses i: clx1119
            clx1119 = clx1119 + 1
            if (bodyContainsYield :ast n: (ast.nodes.get i: cl0Id.u64)) then return true
        }
        return (bodyContainsYieldOptAt :ast oId: n.elseclause)
    } case ifclause then {
        cox1359: u64
        for cox1359 < n.conditions.count.u64 loop {
            c0Id: zast.kidAt kids: ast.kids span: n.conditions i: cox1359
            cox1359 = cox1359 + 1
            if (bodyContainsYield :ast n: (ast.nodes.get i: c0Id.u64)) then return true
        }
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.statement.u64))
    } case forexpr then {
        cox1369: u64
        for cox1369 < n.conditions.count.u64 loop {
            f0: zast.kidAt kids: ast.kids span: n.conditions i: cox1369
            cox1369 = cox1369 + 1
            if (bodyContainsYield :ast n: (ast.nodes.get i: f0.u64)) then return true
        }
        if (bodyContainsYieldOptAt :ast oId: n.body) then return true
        pox1439: u64
        for pox1439 < n.postconditions.count.u64 loop {
            p0: zast.kidAt kids: ast.kids span: n.postconditions i: pox1439
            pox1439 = pox1439 + 1
            if (bodyContainsYield :ast n: (ast.nodes.get i: p0.u64)) then return true
        }
        return false
    } case doexpr then {
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.statement.u64))
    } case withexpr then {
        if (bodyContainsYield :ast n: (ast.nodes.get i: n.value.u64)) then return true
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.body.u64))
    } case caseexpr then {
        if (bodyContainsYield :ast n: (ast.nodes.get i: n.subject.u64)) then return true
        clx1129: u64
        for clx1129 < n.clauses.count.u64 loop {
            m0: zast.kidAt kids: ast.kids span: n.clauses i: clx1129
            clx1129 = clx1129 + 1
            if (bodyContainsYield :ast n: (ast.nodes.get i: m0.u64)) then return true
        }
        return (bodyContainsYieldOptAt :ast oId: n.elseclause)
    } case caseclause then {
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.statement.u64))
    } case namedoperation then {
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.operation.u64))
    } case call then {
        if (zast.isYieldCalleeAt :ast callableId: n.callable) then return true
        if (bodyContainsYield :ast n: (ast.nodes.get i: n.callable.u64)) then return true
        arx659: u64
        for arx659 < n.arguments.count.u64 loop {
            a0: zast.kidAt kids: ast.kids span: n.arguments i: arx659
            arx659 = arx659 + 1
            if (bodyContainsYield :ast n: (ast.nodes.get i: a0.u64)) then return true
        }
        return false
    } case binop then {
        if (bodyContainsYield :ast n: (ast.nodes.get i: n.lhs.u64)) then return true
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.rhs.u64))
    } else {
        return false
    }
}

# true when the optional body `oId` contains a `yield`.
bodyContainsYieldOptAt: function {ast: Ast.view oId: zast.nodeid} out bool is {
    if oId.isZero then return false
    return (bodyContainsYield :ast n: (ast.nodes.get i: oId.u64))
}

# leafAtomName -- an atom's name (owned copy); "" for other shapes.
leafAtomName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# leafAtomNameId -- an atom's name id; 0 for other shapes. The id twin of
# leafAtomName: a resolved compare needs the pool id, never the text.
leafAtomNameId: function {ast: Ast.view n: Node.view} out zast.nameid is {
    ast
    match (
        n
    ) case atomid then {
        return n.name
    } else {
        return (zast.nameid.create from: 0)
    }
}

# the return-type head name id of operation `n`.
returnHeadIdOf: function {ast: Ast.view n: Node.view} out zast.nameid is {
    match (
        n
    ) case expression then {
        return (returnHeadIdOf :ast n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        return (leafAtomNameId :ast n: (ast.nodes.get i: n.callable.u64))
    } case atomid then {
        return n.name
    } else {
        return (zast.nameid.create from: 0)
    }
}

# pathLeafName -- the take/borrow ownership leaf on a dotted path, "" when
# none. It answers only those two: a `.view` or `.hold` leaf comes back
# unmarked, so a caller that needs every marker must read the leaf by name id.
pathLeafName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case dottedpath then {
        ln: leafAtomName :ast n: (ast.nodes.get i: n.child.u64)
        if ln.stringView == "take" then return ln
        if ln.stringView == "borrow" then return ln
        return "".string
    } else {
        return "".string
    }
}

# clonePath -- deep-copy a type-path subtree (atom / labelvalue / dotted /
# expression / call / namedoperation shapes), minting fresh nodeids. The
# synth wrapper and field types embed clones because a node owns exactly
# one parent. `n` may be a detached node; its children are table rows,
# cloned and interned by id (clonePathAt) before the clone's own slot is
# reserved, so nothing lends ast while a row view is live.
clonePath: function {ast: Ast n: Node.view} out Node is {
    kids: (ListVal u32)
    if (pathShape :n) then kids = zast.childIds :ast :n
    cloned: clonePathKids :ast :kids
    myId: zast.tableReserve :ast
    built: clonePathArm :n :myId :cloned kids: ast.kids
    if built.placeholder then return (clonePathUnsupported :ast :myId)
    return built
}

# clonePathAt -- clonePath of the row `nid` names. Each row view is scoped
# to a block that lends nothing: the children go first (by id), then the
# clone's slot, then the arm is built from the row's scalars.
clonePathAt: function {ast: Ast nid: zast.nodeid} out Node is {
    kids: (ListVal u32)
    {
        n: ast.nodes.get i: nid.u64
        if (pathShape :n) then kids = zast.childIds :ast :n
    }
    cloned: clonePathKids :ast :kids
    myId: zast.tableReserve :ast
    built: Node.placeholder
    {
        n: ast.nodes.get i: nid.u64
        built = clonePathArm :n :myId :cloned kids: ast.kids
    }
    if built.placeholder then return (clonePathUnsupported :ast :myId)
    return built
}

# pathShape -- `n` is a shape clonePath copies structurally.
pathShape: function {n: Node.view} out bool is {
    match (
        n
    ) case atomid then {
        return true
    } case labelvalue then {
        return true
    } case dottedpath then {
        return true
    } case expression then {
        return true
    } case call then {
        return true
    } case namedoperation then {
        return true
    } case binop then {
        return true
    } case atomstring then {
        return true
    } case stringchunk then {
        return true
    } else {
        return false
    }
}

# clonePathKids -- clone each child by id and intern the clones, in order.
clonePathKids: function {ast: Ast kids: (ListVal u32).view} out (ListVal u32) is {
    cloned: (ListVal u32)
    with it: kids.iterate do for k: it loop {
        c0: clonePathAt :ast nid: (zast.nodeid.create from: k)
        cloned.append (zast.tableAdd :ast n: c0)
    }
    return cloned
}

# idsSlice -- the ids `cloned` holds from index `lo` up to `hi`.
idsSlice: function {cloned: (ListVal u32).view lo: u64 hi: u64} out (ListVal u32) is {
    acc: (ListVal u32)
    i: lo
    for i < hi loop {
        acc.append from: (cloned.get :i)
        i = i + 1
    }
    return acc
}

# clonePathArm -- the clone of `n`'s arm under `myId`, its children the
# interned clones in `cloned` (canonical childIds order); the placeholder
# arm for any shape clonePath does not copy. Reads the view only.
clonePathArm: function {
    kids: ListVal u32
    n: Node.view
    myId: zast.nodeid
    cloned: (ListVal u32).view
} out Node is {
    match (
        n
    ) case atomid then {
        # interned name: the clone shares the pool id
        return (Node.atomid (zast.AtomIdData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name)
        )
    } case labelvalue then {
        return (Node.labelvalue (zast.LabelValueData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name)
        )
    } case dottedpath then {
        return (Node.dottedpath (zast.DottedPathData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            parent: (zast.nodeid.create from: (cloned.get i: 0))
            child: (zast.nodeid.create from: (cloned.get i: 1)))
        )
    } case expression then {
        return (Node.expression (zast.ExpressionData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            expression: (zast.nodeid.create from: (cloned.get i: 0)))
        )
    } case call then {
        return (Node.call (zast.CallData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            callable: (zast.nodeid.create from: (cloned.get i: 0))
            arguments: (zast.kidsAdd :kids xs: (idsSlice :cloned lo: 1 hi: cloned.length)))
        )
    } case namedoperation then {
        return (Node.namedoperation (zast.NamedOperationData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
            operation: (zast.nodeid.create from: (cloned.get i: 0)))
        )
    } case binop then {
        return (Node.binop (zast.BinOpData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            lhs: (zast.nodeid.create from: (cloned.get i: 0))
            operator: (zast.nodeid.create from: (cloned.get i: 1))
            rhs: (zast.nodeid.create from: (cloned.get i: 2)))
        )
    } case atomstring then {
        return (Node.atomstring (zast.AtomStringData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            stringparts: (zast.kidsAdd :kids xs: (idsSlice :cloned lo: 0 hi: cloned.length)))
        )
    } case stringchunk then {
        tv8: n.text.stringView
        tc8: tv8.string
        ck8: n.chunkKind
        return (Node.stringchunk (zast.StringChunkData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            text: tc8
            chunkKind: ck8)
        )
    } else {
        return Node.placeholder
    }
}

# clonePathUnsupported -- an unsupported path shape clones to an error
# atom, which keeps the tree total.
clonePathUnsupported: function {ast: Ast myId: zast.nodeid} out Node is {
    return (Node.atomid (zast.AtomIdData
        nodeid: myId
        lineno: 0
        colno: 0
        name: (internSynthName :ast text: "?"))
    )
}


# GivesParts -- split the iterator return into (gives base path CLONE,
# ownership leaf, accepts path CLONE or none). The base clone feeds the
# synth wrapper; a "borrow" leaf selects OptionView, anything else Option.
GivesParts: class {
    # a CLONE of the element path, which feeds the option wrapper. A clone
    # because the original stays in the tree
    base: (Option Node)
    # the ownership leaf. "borrow" selects OptionView and anything else
    # selects Option, which is the whole of the choice
    leaf: String
}

# read the `gives` type from operation `n` into `dst`.
givesFromOp: function {ast: Ast nid: zast.nodeid dst: GivesParts} is {
    innerId: zast.nodeid
    isDotted: false
    parentId: zast.nodeid
    lf: String
    {
        n: ast.nodes.get i: nid.u64
        match (
            n
        ) case expression then {
            innerId = n.expression
        } case dottedpath then {
            isDotted = true
            parentId = n.parent
        } else null
        if innerId.isZero then lf = pathLeafName :ast :n
    }
    if (innerId.isZero) == false then {
        givesFromOp :ast nid: innerId :dst
        return
    }
    if lf.length > 0 then {
        if isDotted then {
            bc: clonePathAt :ast nid: parentId
            dst.base = (Option.some bc)
            dst.leaf = lf
        }
    } else {
        bc2: clonePathAt :ast :nid
        dst.base = (Option.some bc2)
    }
}

# mkAtom / mkNamedOp / mkBareOp -- small node factories at a source
# position (the synthesized members all carry the function's start).
# internSynthName -- the pool id for synthesized-name text (deduplicated
# by the pool, so ref equality holds across parsed and synthesized atoms).
internSynthName: function {ast: Ast text: StringView} out zast.nameid is {
    return (ast.names.set s: text)
}

# build an atomid node for a name and return its node id.
mkAtom: function {
    ast: Ast
    line: u32
    col: u32
    name: StringView
} out Node is {
    return (Node.atomid (zast.AtomIdData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        name: (internSynthName :ast text: name))
    )
}

# build a namedoperation node (a name paired with an operation) in `ast`
# and return its node id.
mkNamedOp: function {
    ast: Ast
    line: u32
    col: u32
    name: StringView
    op: Node.take
} out Node is {
    return (Node.namedoperation (zast.NamedOperationData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        name: (ast.names.set s: name)
        operation: (zast.tableAdd :ast n: op))
    )
}

# build a bare namedoperation node and return its node id.
mkBareOp: function {
    ast: Ast
    line: u32
    col: u32
    op: Node.take
} out Node is {
    return (Node.namedoperation (zast.NamedOperationData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        name: zast.nameid
        operation: (zast.tableAdd :ast n: op))
    )
}

# mkReturnBody -- `{ return (<inner>) }`: the single-statement body both
# the create method and the factory share.
mkReturnBody: function {
    ast: Ast
    line: u32
    col: u32
    inner: Node.take
} out Node is {
    retCal: mkAtom :ast :line :col name: "return"
    retArg: mkBareOp :ast :line :col op: inner
    retArgs: (ListVal u32)
    retArgs.append (zast.tableAdd :ast n: retArg)
    retCall: (Node.call (zast.CallData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        callable: (zast.tableAdd :ast n: retCal)
        arguments: (zast.kidsAdd kids: ast.kids xs: retArgs))
    )
    retExpr: (Node.expression (zast.ExpressionData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        expression: (zast.tableAdd :ast n: retCall))
    )
    sline: (Node.statementline (zast.StatementLineData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        statementline: (zast.tableAdd :ast n: retExpr))
    )
    slist: (ListVal u32)
    slist.append (zast.tableAdd :ast n: sline)
    return (Node.statement (zast.StatementData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        statements: (zast.kidsAdd kids: ast.kids xs: slist))
    )
}

# typePathIsReference -- the field's type path ends in a `.borrow`/`.view`
# marker: the field is a reference the instance keeps locked for its life.
typePathIsReference: function {ast: Ast.view nid: zast.nodeid} out bool is {
    if nid.isZero then return false
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case dottedpath then {
        lid: leafAtomNameId :ast n: (ast.nodes.get i: n.child.u64)
        if lid == zast.names.wkBorrow then return true
        return lid == zast.names.wkView
    } case expression then {
        return (typePathIsReference :ast nid: n.expression)
    } else {
        return false
    }
}

# buildCreateMethod -- `create: function {<param-clones>} out this is {
# return (meta.create state: 0 p1: :p1 ...) }`, `outx this` when a captured
# field is a reference: captured parameters forward by label-value shorthand;
# promoted locals are reserved fields the body's first write initialises.
buildCreateMethod: function {
    ast: Ast
    line: u32
    col: u32
    params: (ListVal u32).take
    fwdNames: (List String).view
    # a captured field is a reference, so the create is `outx this`
    pins: bool
} out Node is {
    metaAtom: mkAtom :ast :line :col name: "meta"
    createAtom: mkAtom :ast :line :col name: "create"
    metaCreate: (Node.dottedpath (zast.DottedPathData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        parent: (zast.tableAdd :ast n: metaAtom)
        child: (zast.tableAdd :ast n: createAtom))
    )
    zeroAtom: mkAtom :ast :line :col name: "0"
    stArg: mkNamedOp :ast :line :col name: "state" op: zeroAtom
    cargs: (ListVal u32)
    cargs.append (zast.tableAdd :ast n: stArg)
    fi: u64
    fn: fwdNames.length
    for fi < fn loop {
        f0: fwdNames.get i: fi
        f0v: f0.stringView
        lv0: (Node.labelvalue (zast.LabelValueData
            nodeid: (zast.tableReserve :ast)
            lineno: line
            colno: col
            name: (internSynthName :ast text: f0v))
        )
        fa0: mkNamedOp :ast :line :col name: f0v op: lv0
        cargs.append (zast.tableAdd :ast n: fa0)
        fi = fi + 1
    }
    icall: (Node.call (zast.CallData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        callable: (zast.tableAdd :ast n: metaCreate)
        arguments: (zast.kidsAdd kids: ast.kids xs: cargs))
    )
    body: mkReturnBody :ast :line :col inner: icall
    # `outx this` when the synth class captures a NON-OWNED parameter -- a
    # reference into the caller that has to stay pinned for the iterator's
    # lifetime; a plain `out this` when it captures nothing non-owned, since
    # an `outx` with nothing to pin is refused.
    thisRet: mkAtom :ast :line :col name: "this"
    thisRetId: zast.tableAdd :ast n: thisRet
    return (Node.functiondef (zast.FunctionData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        returntype: thisRetId
        parameters: (zast.kidsAdd kids: ast.kids xs: params)
        body: (zast.tableAdd :ast n: body)
        isNative: false
        :pins
        asItems: (zast.kidsAdd kids: ast.kids xs: (ListVal u32)))
    )
}


# buildWrapper -- the synth `.call` return `(Option|OptionView <base>)`: an
# owned wrapper unless the leaf is a reference. The type argument is written
# WITHOUT its label: this unit lowers the AST before typecheck and so has no
# symbol table to ask a template for its parameter name, and the elided leading
# argument is rebound to that parameter by getOrMintSpec anyway. Both wrappers
# take exactly one parameter, which is what makes eliding it safe.
buildWrapper: function {
    ast: Ast
    line: u32
    col: u32
    base: Node.take
    leaf: StringView
} out Node is {
    # the wrapper is owned unless the leaf asks for a view: `Option` for a
    # plain or `.take` leaf, `OptionView` for `.borrow` -- which the checker
    # then refuses, since nothing implements a reference yield. The checker
    # collapses the owned wrapper further (a valtype element to optionval).
    wn: "Option"
    if leaf == "borrow" then wn = "OptionView"
    wAtom: mkAtom :ast :line :col name: wn
    tArg: mkBareOp :ast :line :col op: base
    wargs: (ListVal u32)
    wargs.append (zast.tableAdd :ast n: tArg)
    return (Node.call (zast.CallData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        callable: (zast.tableAdd :ast n: wAtom)
        arguments: (zast.kidsAdd kids: ast.kids xs: wargs))
    )
}


# isYieldValue -- the assignment RHS is a yield expression (through
# expression wrappers): the expression-form `name: yield E`.
isYieldValue: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (isYieldValue :ast n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        return (zast.isYieldCalleeAt :ast callableId: n.callable)
    } else {
        return false
    }
}

# GenCross -- the crossing-locals walk state: yields passed so far, each
# local's first-definition yield count, its maximum-use yield count, and
# whether any reference sits inside a yielding loop (next iteration
# resumes past the suspension, so reuse crosses implicitly).
GenCross: class {
    # how many yields the walk has passed, which is the clock every other field
    # is measured against
    yieldCount: u64
    # each local's first-definition yield count
    firstDef: (MapRV String v: u64)
    # each local's last-use yield count. A local whose use count exceeds its
    # definition count CROSSES a suspension and must live in the state class
    maxUse: (MapRV String v: u64)
    # whether any reference sits inside a yielding loop. It crosses implicitly
    # there, the next iteration resuming past the suspension
    inLoop: (MapRV String v: bool)
    # which names are parameters, since a parameter crosses whatever the counts
    # say
    params: (MapRV String v: bool)
    # `name: yield E` resume-input bindings: per-call borrowed aliases into
    # the caller's storage -- NEVER promoted (a stored pointer would dangle
    # across calls; the liveness rule already confines each to one window).
    yieldBound: (MapRV String v: bool)
}

# yieldSlotsOpt -- the suspension count of an optional body, which is how many
# resume slots the state class needs. Reads through a view: the body is still
# needed afterwards.
yieldSlotsOpt: function {ast: Ast.view o: (Option Node).view} out u64 is {
    match (
        o
    ) case some then {
        return (zast.yieldCountOf :ast n: o)
    } case none then {
        return 0
    }
}

# forCounterSlotsOpt -- how many loop-counter fields the state class needs: one
# per label-bound `for` whose body suspends. Counted by the SAME function the
# emitter draws its counters from. Reads through a view, like yieldSlotsOpt.
forCounterSlotsOpt: function {ast: Ast.view o: (Option Node).view} out u64 is {
    match (
        o
    ) case some then {
        return (zast.suspendingForCountOf :ast n: o)
    } case none then {
        return 0
    }
}

# recurse a node, recording locals that cross a yield-loop boundary.
crossWalk: function {ast: Ast.view gc: GenCross n: Node.view inYieldLoop: bool} is {
    match (
        n
    ) case functiondef then null case assignment then {
        av: ast.nodes.get i: n.value.u64
        crossWalk :ast :gc n: av :inYieldLoop
        anvC: zast.poolTextAt pool: ast.names ref: n.name
        anv: anvC.stringView
        if (isYieldValue :ast n: av) then {
            ybk: anv.string
            ybv: true
            gc.yieldBound.set key: ybk value: ybv
        }
        isP: (gc.params.get key: anv.string).or d: false
        if (isP) == false then {
            seen: (gc.firstDef.get key: anv.string).or d: 18446744073709551615.u64
            if seen == 18446744073709551615.u64 then {
                dk: anv.string
                dv: gc.yieldCount
                gc.firstDef.set key: dk value: dv
            }
            if inYieldLoop then {
                lk: anv.string
                lv: true
                gc.inLoop.set key: lk value: lv
            }
        }
    } case atomid then {
        unvC: zast.nameTextAt :ast ref: n.name
        unv: unvC.stringView
        seen2: (gc.firstDef.get key: unv.string).or d: 18446744073709551615.u64
        if seen2 != 18446744073709551615.u64 then {
            uk: unv.string
            uv: gc.yieldCount
            prev: (gc.maxUse.get key: unv.string).or d: 0
            if uv > prev then {
                gc.maxUse.set key: uk value: uv
            }
            if inYieldLoop then {
                lk2: unv.string
                lv2: true
                gc.inLoop.set key: lk2 value: lv2
            }
        }
    } case forexpr then {
        bodyYields: bodyContainsYieldOptAt :ast oId: n.body
        sub: inYieldLoop
        if bodyYields then sub = true
        cox1379: u64
        for cox1379 < n.conditions.count.u64 loop {
            f0: zast.kidAt kids: ast.kids span: n.conditions i: cox1379
            cox1379 = cox1379 + 1
            crossWalk :ast :gc n: (ast.nodes.get i: f0.u64) inYieldLoop: sub
        }
        if n.body > 0 then {
            fcb: ast.nodes.get i: n.body.u64
            crossWalk :ast :gc n: fcb inYieldLoop: sub
        }
        pox1449: u64
        for pox1449 < n.postconditions.count.u64 loop {
            p0: zast.kidAt kids: ast.kids span: n.postconditions i: pox1449
            pox1449 = pox1449 + 1
            crossWalk :ast :gc n: (ast.nodes.get i: p0.u64) inYieldLoop: sub
        }
    } case caseclause then {
        # the arm pattern is not a use of a local
        crossWalk :ast :gc n: (ast.nodes.get i: n.statement.u64) :inYieldLoop
    } case call then {
        # the callee name is not a use of a local
        cwx99: u64
        for cwx99 < n.arguments.count.u64 loop {
            cwId99: zast.kidAt kids: ast.kids span: n.arguments i: cwx99
            cwx99 = cwx99 + 1
            crossWalk :ast :gc n: (ast.nodes.get i: cwId99.u64) :inYieldLoop
        }
        # a suspension point advances the clock every other field is read
        # against. The operand is walked FIRST, so a local used in the yielded
        # value is recorded against the count before this yield moves it.
        if (zast.isYieldCalleeAt :ast callableId: n.callable) then gc.yieldCount = gc.yieldCount + 1
    } case binop then {
        # the operator atom is not a use of a local
        crossWalk :ast :gc n: (ast.nodes.get i: n.lhs.u64) :inYieldLoop
        crossWalk :ast :gc n: (ast.nodes.get i: n.rhs.u64) :inYieldLoop
    } case dottedpath then {
        # a member selector is not a use of a local
        crossWalk :ast :gc n: (ast.nodes.get i: n.parent.u64) :inYieldLoop
    } else {
        crossWalkIds :ast :gc ids: (zast.childIds :ast :n) :inYieldLoop
    }
}

# crossWalkIds -- walk a list of children carrying the crossing state through
# them in order. `inYieldLoop` stays set once entered, because a reference
# inside a yielding loop crosses a suspension implicitly: the next iteration
# resumes past it.
crossWalkIds: function {ast: Ast.view gc: GenCross ids: (ListVal u32).view inYieldLoop: bool} is {
    with it: ids.iterate do for c: it loop {
        crossWalk :ast :gc n: (ast.nodes.get i: c.u64) :inYieldLoop
    }
}

# crossWalk over an optional node.
crossWalkOpt: function {ast: Ast.view gc: GenCross o: (Option Node).view inYieldLoop: bool} is {
    match (
        o
    ) case some then {
        crossWalk :ast :gc n: o :inYieldLoop
    } case none then null
}

# crossingLocals -- EVERY generator-body local promotes: a resumable body
# has no persistent stack frame, so a local surviving to any later flush
# (scope exit, fn exit) would free garbage on a fresh frame. Fields live on
# the instance; the synth class's auto-destructor owns their cleanup.
# (Historically only yield-crossing/looped locals promoted -- the
# non-crossing remainder was the fresh-frame free family.)
crossingLocals: function {gc: GenCross.view dst: List String} is {
    with kit: gc.firstDef.iterate do for k0: kit loop {
        kv0: k0.stringView
        yb0: (gc.yieldBound.get key: kv0.string).or d: false
        if (yb0) == false then {
            kc0: kv0.string
            dst.append kc0
        }
    }
}

# firstRhsOf -- the first `name: <rhs>` assignment's INNER rhs (a clone),
# feeding the promoted local's typeof field. The root may be a detached
# node (a promoted body not yet interned); its children are table rows and
# the search continues by id.
firstRhsOf: function {
    ast: Ast
    n: Node.view
    name: StringView
    dst: GivesParts
} is {
    kids: (ListVal u32)
    rhsId: firstRhsScan :ast :n :name :kids
    firstRhsDescend :ast :rhsId :kids :name :dst
}

# firstRhsOfAt -- the id-taking search: the row view is this frame's and
# dies at the block close, before the clone or the recursion lends `ast`.
firstRhsOfAt: function {
    ast: Ast
    nid: zast.nodeid
    name: StringView
    dst: GivesParts
} is {
    kids: (ListVal u32)
    rhsId: zast.nodeid
    {
        n: ast.nodes.get i: nid.u64
        rhsId = firstRhsScan :ast :n :name :kids
    }
    firstRhsDescend :ast :rhsId :kids :name :dst
}

# firstRhsScan -- read-only: the assignment's value id when `n` is
# `name: <rhs>` (zero otherwise), and the children the search descends
# into. A function body is opaque, an assignment's value is not searched,
# and a for/with descends into its body only.
firstRhsScan: function {
    ast: Ast.view
    n: Node.view
    name: StringView
    kids: ListVal u32
} out zast.nodeid is {
    rhs: zast.nodeid
    match (
        n
    ) case functiondef then null case assignment then {
        if (zast.nameTextEq :ast ref: n.name s: name) then rhs = n.value
    } case statement then {
        stx799: u64
        for stx799 < n.statements.count.u64 loop {
            s0Id: zast.kidAt kids: ast.kids span: n.statements i: stx799
            stx799 = stx799 + 1
            kids.append from: s0Id
        }
    } case statementline then {
        kids.append from: n.statementline.u32
    } case expression then {
        kids.append from: n.expression.u32
    } case ifexpr then {
        clx1139: u64
        for clx1139 < n.clauses.count.u64 loop {
            cl0Id: zast.kidAt kids: ast.kids span: n.clauses i: clx1139
            clx1139 = clx1139 + 1
            kids.append from: cl0Id
        }
        if n.elseclause > 0 then kids.append from: n.elseclause.u32
    } case ifclause then {
        kids.append from: n.statement.u32
    } case forexpr then {
        if n.body > 0 then kids.append from: n.body.u32
    } case doexpr then {
        kids.append from: n.statement.u32
    } case withexpr then {
        kids.append from: n.body.u32
    } case caseexpr then {
        clx1149: u64
        for clx1149 < n.clauses.count.u64 loop {
            m0: zast.kidAt kids: ast.kids span: n.clauses i: clx1149
            clx1149 = clx1149 + 1
            kids.append from: m0
        }
        if n.elseclause > 0 then kids.append from: n.elseclause.u32
    } case caseclause then {
        kids.append from: n.statement.u32
    } else null
    return rhs
}

# firstRhsDescend -- clone the found rhs into `dst` (the first match wins),
# otherwise continue the search by id through `kids`.
firstRhsDescend: function {
    ast: Ast
    rhsId: zast.nodeid
    kids: (ListVal u32).view
    name: StringView
    dst: GivesParts
} is {
    if (rhsId.isZero) == false then {
        already: false
        match (
            dst.base
        ) case some then {
            already = true
        } case none then null
        if (already) == false then {
            rc: cloneInner :ast nid: rhsId
            dst.base = (Option.some rc)
        }
        return
    }
    with it: kids.iterate do for k: it loop {
        firstRhsOfAt :ast nid: (zast.nodeid.create from: k) :name :dst
    }
}

# the first right-hand-side node under an optional node (for promotion).
firstRhsOfOpt: function {
    ast: Ast
    o: (Option Node).view
    name: StringView
    dst: GivesParts
} is {
    match (
        o
    ) case some then {
        firstRhsOf :ast n: o :name :dst
    } case none then null
}

# cloneInner -- clone the inside of an expression wrapper (the typeof
# field embeds the bare operation). The unwrap continues by id; the view
# dies before the clone lends `ast`.
cloneInner: function {ast: Ast nid: zast.nodeid} out Node is {
    inner: nid
    {
        n: ast.nodes.get i: nid.u64
        if n.expression then inner = n.expression
    }
    if inner == nid then return (clonePathAt :ast :nid)
    return (cloneInner :ast nid: inner)
}

# promoteIterables -- clone the body, and for each top-level `for` whose
# loop body suspends, hoist every non-trivial named iterable into a
# synthetic `_iterN: <expr>` binding before the loop (the loop references
# `_iterN`). Without this, the iterable would be a C-stack local that
# does not survive a suspension; the synthetic local is visible to the
# crossing analysis (the yielding-loop rule promotes it) and to the
# typeof field machinery. Recurses into for bodies only.
promoteIterables: function {ast: Ast ctr: NameCtr nid: zast.nodeid} out Node is {
    isStmt: false
    lnP: u32
    coP: u32
    lineIds: (ListVal u32)
    {
        n: ast.nodes.get i: nid.u64
        if n.statement then {
            isStmt = true
            lnP = n.lineno
            coP = n.colno
            stx809: u64
            for stx809 < n.statements.count.u64 loop {
                s: zast.kidAt kids: ast.kids span: n.statements i: stx809
                stx809 = stx809 + 1
                lineIds.append from: s
            }
        }
    }
    if (isStmt) == false then return (clonePathAt :ast :nid)
    newLines: (ListVal u32)
    with lit: lineIds.iterate do for s0Id: lit loop {
        promoteLine :ast :ctr nid: (zast.nodeid.create from: s0Id) dst: newLines
    }
    return (Node.statement (zast.StatementData
        nodeid: (zast.tableReserve :ast)
        lineno: lnP
        colno: coP
        statements: (zast.kidsAdd kids: ast.kids xs: newLines))
    )
}


# promoteIterablesIdAt -- promote and intern a loop body (0 = absent).
promoteIterablesIdAt: function {
    ast: Ast
    ctr: NameCtr
    oId: zast.nodeid
} out u32 is {
    if oId.isZero then return 0
    r: promoteIterables :ast :ctr nid: oId
    return (zast.tableAdd :ast n: r)
}

# promoteLine -- one statement line: a for-statement transforms (possibly
# appending synthetic bindings first); anything else passes through as a
# rewrite-clone (the rewrite with no promotions is a faithful deep copy).
promoteLine: function {ast: Ast ctr: NameCtr nid: zast.nodeid dst: ListVal u32} is {
    isFor: false
    innerId: zast.nodeid
    lnQ: u32
    coQ: u32
    {
        n: ast.nodes.get i: nid.u64
        if n.statementline then {
            innerId = n.statementline
            lnQ = n.lineno
            coQ = n.colno
            isFor = lineIsFor :ast n: (ast.nodes.get i: n.statementline.u64)
            if (isFor) == false then {
                isFor = lineIsWith :ast n: (ast.nodes.get i: n.statementline.u64)
            }
        }
    }
    if isFor then {
        ni: promoteInExpr :ast :ctr nid: innerId :dst
        nl: (Node.statementline (zast.StatementLineData
            nodeid: (zast.tableReserve :ast)
            lineno: lnQ
            colno: coQ
            statementline: (zast.tableAdd :ast n: ni))
        )
        dst.append (zast.tableAdd :ast n: nl)
    } else {
        empty: (MapRV String v: bool)
        nc: rewriteToThisAt :ast :nid promoted: empty
        dst.append (zast.tableAdd :ast n: nc)
    }
}

# true when node `n` is a with-statement line.
lineIsWith: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (lineIsWith :ast n: (ast.nodes.get i: n.expression.u64))
    } case withexpr then {
        return true
    } else {
        return false
    }
}

# withValueIsOwned -- true when a `with` value is OWNED by shape alone.
#
# A conservative mirror of the checker's `withValueOwnership`: that one answers
# BORROWED for a bare name bound to a runtime variable and for a plain dotted
# path, OWNED for everything else. The runtime-variable half is a symbol-table
# question and lowering has no symbol table, so both name-shaped arms answer
# false here. Being wrong in that direction only leaves a binding unpromoted;
# being wrong the other way would rebind a borrow, which the checker refuses.
withValueIsOwned: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (withValueIsOwned :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return false
    } case labelvalue then {
        return false
    } case dottedpath then {
        return false
    } else {
        return true
    }
}

# prependIntoBlock -- a statement block with `name: src` inserted as its first
# line; 0 when the node is not a block.
prependIntoBlock: function {
    # the tree the block is read from, and where the synth nodes are minted
    ast: Ast
    # the block to prepend to
    bodyId: u32
    # the name the new binding introduces
    name: zast.nameid
    # the name it is bound to, which the header now carries
    src: StringView
    # the line the synth binding is reported at
    line: u32
    # the column the synth binding is reported at
    col: u32
} out u32 is {
    lnB: u32
    coB: u32
    lineIds: (ListVal u32)
    isStmt: false
    {
        b: ast.nodes.get i: bodyId.u64
        if b.statement then {
            isStmt = true
            lnB = b.lineno
            coB = b.colno
            stx819: u64
            for stx819 < b.statements.count.u64 loop {
                s: zast.kidAt kids: ast.kids span: b.statements i: stx819
                stx819 = stx819 + 1
                lineIds.append from: s
            }
        }
    }
    if (isStmt) == false then return 0
    sa2: mkAtom :ast :line :col name: src
    ba2: (Node.assignment (zast.AssignmentData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        :name
        value: (zast.tableAdd :ast n: sa2))
    )
    bl2: (Node.statementline (zast.StatementLineData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        statementline: (zast.tableAdd :ast n: ba2))
    )
    newLines: (ListVal u32)
    newLines.append (zast.tableAdd :ast n: bl2)
    with nit: lineIds.iterate do for s2: nit loop newLines.append from: s2
    nb2: (Node.statement (zast.StatementData
        nodeid: (zast.tableReserve :ast)
        lineno: lnB
        colno: coB
        statements: (zast.kidsAdd kids: ast.kids xs: newLines))
    )
    return (zast.tableAdd :ast n: nb2)
}

# prependBindLine -- prependIntoBlock through the `expression` and `doexpr`
# wrappers a `with` body sits under, rebuilding them around the result.
prependBindLine: function {
    # the tree the body is read from, and where the synth nodes are minted
    ast: Ast
    # the already-promoted body to prepend to
    bodyId: u32
    # the name the new binding introduces
    name: zast.nameid
    # the name it is bound to, which the header now carries
    src: StringView
    # the line the synth binding is reported at
    line: u32
    # the column the synth binding is reported at
    col: u32
} out u32 is {
    direct: prependIntoBlock :ast :bodyId :name :src :line :col
    if direct > 0 then return direct
    isE2: false
    isD2: false
    inner2: zast.nodeid
    lnE2: u32
    coE2: u32
    {
        b2: ast.nodes.get i: bodyId.u64
        match (
            b2
        ) case expression then {
            isE2 = true
            inner2 = b2.expression
            lnE2 = b2.lineno
            coE2 = b2.colno
        } case doexpr then {
            isD2 = true
            inner2 = b2.statement
            lnE2 = b2.lineno
            coE2 = b2.colno
        } else null
    }
    if (isE2) == false when (isD2) == false then return bodyId
    deep: prependBindLine :ast bodyId: inner2.u32 :name :src :line :col
    if deep == inner2.u32 then return bodyId
    if isD2 then {
        rdo: (Node.doexpr (zast.DoData
            nodeid: (zast.tableReserve :ast)
            lineno: lnE2
            colno: coE2
            statement: (zast.nodeid.create from: deep))
        )
        return (zast.tableAdd :ast n: rdo)
    }
    rew: (Node.expression (zast.ExpressionData
        nodeid: (zast.tableReserve :ast)
        lineno: lnE2
        colno: coE2
        expression: (zast.nodeid.create from: deep))
    )
    return (zast.tableAdd :ast n: rew)
}

# promoteWrappedBody -- promote a body that may sit under `expression`
# wrappers, rebuilding them around the result.
#
# A `for` body is a bare statement block, but a `with` body is wrapped, and
# `promoteIterables` answers `clonePathAt` for anything that is not a
# `statement` -- which clones PATH shapes only and silently drops a block's
# contents. Unwrap first, promote, then put the wrappers back.
promoteWrappedBody: function {ast: Ast ctr: NameCtr oId: zast.nodeid} out u32 is {
    if oId.isZero then return 0
    isExpr: false
    innerId: zast.nodeid
    lnY: u32
    coY: u32
    {
        n: ast.nodes.get i: oId.u64
        if n.expression then {
            isExpr = true
            innerId = n.expression
            lnY = n.lineno
            coY = n.colno
        }
    }
    isDo: false
    {
        n: ast.nodes.get i: oId.u64
        if n.doexpr then {
            isDo = true
            innerId = n.statement
            lnY = n.lineno
            coY = n.colno
        }
    }
    if (isExpr) == false when (isDo) == false then return (promoteIterablesIdAt :ast :ctr :oId)
    innerNew: promoteWrappedBody :ast :ctr oId: innerId
    if innerNew == 0 then return 0
    if isDo then {
        redo: (Node.doexpr (zast.DoData
            nodeid: (zast.tableReserve :ast)
            lineno: lnY
            colno: coY
            statement: (zast.nodeid.create from: innerNew))
        )
        return (zast.tableAdd :ast n: redo)
    }
    wrapped: (Node.expression (zast.ExpressionData
        nodeid: (zast.tableReserve :ast)
        lineno: lnY
        colno: coY
        expression: (zast.nodeid.create from: innerNew))
    )
    return (zast.tableAdd :ast n: wrapped)
}

# promoteWith -- a `with` whose body suspends: re-bind the user's name inside
# the body so the crossing analysis can see it.
#
# `with s: E do { .. }` emits `T s = E;` ahead of the block, and the resume
# `goto` re-enters past that line -- so a suspending body read indeterminate
# garbage. The name cannot be promoted where it stands: it is a nameid on the
# `with` row, so `crossWalk` never records it and `rewriteToThis` has no shape
# to turn it into `this.s`. Binding a fresh name in the header and re-binding
# the user's name as the block's first statement makes it an ordinary
# assignment, which the existing pipeline promotes and types.
#
# The `with` keeps its value, its scope and therefore its locks; only the
# header's NAME changes, and the block gains one statement ahead of the rest.
promoteWith: function {ast: Ast ctr: NameCtr nid: zast.nodeid} out Node is {
    isWith: false
    lnW: u32
    coW: u32
    nameW: zast.nameid
    valW: zast.nodeid
    bodyW: zast.nodeid
    {
        n: ast.nodes.get i: nid.u64
        if n.withexpr then {
            isWith = true
            lnW = n.lineno
            coW = n.colno
            nameW = n.name
            valW = n.value
            bodyW = n.body
        }
    }
    if (isWith) == false then {
        empty9: (MapRV String v: bool)
        return (rewriteToThisAt :ast :nid promoted: empty9)
    }
    # the body is promoted first, so a nested suspending loop or `with` has
    # already had its own rewrite applied. The suspension test reads the
    # ORIGINAL body, which is in the table and so needs no wrapper peeling.
    suspW: false
    if (zast.yieldCountIn :ast nid: bodyW) > 0 then suspW = true
    nbodyId: promoteWrappedBody :ast :ctr oId: bodyW
    doRebind: false
    if nbodyId > 0 when suspW then {
        if (zast.nameTextAt :ast ref: nameW).length > 0 then {
            vW: ast.nodes.get i: valW.u64
            if (withValueIsOwned :ast n: vW) then doRebind = true
        }
    }
    emptyA: (MapRV String v: bool)
    nval: rewriteToThisAt :ast nid: valW promoted: emptyA
    nvalId: zast.tableAdd :ast n: nval
    nName: nameW
    if doRebind then {
        synthW: "_wb\{ctr.bump}"
        swv: synthW.stringView
        nName = zast.poolSet pool: ast.names text: swv
        nbodyId = (prependBindLine
            :ast
            bodyId: nbodyId
            name: nameW
            src: swv
            line: lnW
            col: coW
        )
    }
    return (Node.withexpr (zast.WithData
        nodeid: (zast.tableReserve :ast)
        lineno: lnW
        colno: coW
        name: nName
        value: (zast.nodeid.create from: nvalId)
        body: (zast.nodeid.create from: nbodyId))
    )
}

# true when node `n` is a for-statement line.
lineIsFor: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (lineIsFor :ast n: (ast.nodes.get i: n.expression.u64))
    } case forexpr then {
        return true
    } else {
        return false
    }
}

# promote yield-crossing locals to state fields within an expression.
promoteInExpr: function {
    ast: Ast
    ctr: NameCtr
    nid: zast.nodeid
    dst: ListVal u32
} out Node is {
    isExpr: false
    innerId: zast.nodeid
    lnR: u32
    coR: u32
    {
        n: ast.nodes.get i: nid.u64
        if n.expression then {
            isExpr = true
            innerId = n.expression
            lnR = n.lineno
            coR = n.colno
        }
    }
    if (isExpr) == false then {
        isW: false
        {
            n9: ast.nodes.get i: nid.u64
            if n9.withexpr then isW = true
        }
        if isW then return (promoteWith :ast :ctr :nid)
        return (promoteFor :ast :ctr :nid :dst)
    }
    ni: promoteInExpr :ast :ctr nid: innerId :dst
    return (Node.expression (zast.ExpressionData
        nodeid: (zast.tableReserve :ast)
        lineno: lnR
        colno: coR
        expression: (zast.tableAdd :ast n: ni))
    )
}

# promoteForInit -- hoist a C-STYLE for-binding out of its header, so the
# crossing analysis can see it.
#
# `for i: 0 while i < n loop` initialises `i` once and tests it per iteration;
# the binding lives only in the emitted `int64_t i = 0;` ahead of the `while`,
# and `goto L_resume_k` re-enters the loop past it, so a suspending body read
# indeterminate garbage and the loop yielded once. Rewriting it to `i: 0`
# followed by `for while i < n loop` is the same program -- and `i` is then an
# ordinary assignment, which `crossWalk` records and `crossingLocals` promotes
# to a state field, typed by the shell-and-swap the other promoted locals use.
#
# Only the BINDING moves; the condition it shared the header with stays put.
promoteForInit: function {
    # the tree the condition is read from, and where the synth nodes are minted
    ast: Ast
    # the binding condition being hoisted
    c0Id: u32
    # the statement list ahead of the loop, which the new assignment joins
    dst: ListVal u32
} is {
    # read through a view scoped to this block: the mint below lends ast
    opId: zast.nodeid
    cnId: zast.nameid
    hl1: u32
    hc1: u32
    {
        c0: ast.nodes.get i: c0Id.u64
        if c0.namedoperation then {
            hp1: zast.posOf n: (ast.nodes.get i: c0.operation.u64)
            hl1 = hp1.line
            hc1 = hp1.col
            opId = c0.operation
            cnId = c0.name
        }
    }
    if opId.isZero then return
    empty8: (MapRV String v: bool)
    rhs1: rewriteToThisAt :ast nid: opId promoted: empty8
    rhsE1: ensureExpr :ast line: hl1 col: hc1 n: rhs1
    sa1: (Node.assignment (zast.AssignmentData
        nodeid: (zast.tableReserve :ast)
        lineno: hl1
        colno: hc1
        name: cnId
        value: (zast.tableAdd :ast n: rhsE1))
    )
    sl1: (Node.statementline (zast.StatementLineData
        nodeid: (zast.tableReserve :ast)
        lineno: hl1
        colno: hc1
        statementline: (zast.tableAdd :ast n: sa1))
    )
    dst.append (zast.tableAdd :ast n: sl1)
}

# forInitIdx -- the 1-based index of a C-STYLE for-binding among `condIds`, or 0
# when the header has none.
#
# The discriminator is the emitter's own dispatch, mirrored: `emitObjIterFor`
# and `emitIntRangeFor` both bail unless there is EXACTLY ONE condition, so a
# header carrying a binding AND a further condition is already emitted as an
# init line ahead of a `while`. More than one condition, exactly one of them
# named, is therefore precisely the C-style form.
forInitIdx: function {ast: Ast.view condIds: (ListVal u32).view} out u64 is {
    if condIds.length < 2 then return 0
    found: u64
    ci: u64
    for ci < condIds.length loop {
        c0: ast.nodes.get i: (condIds.get i: ci).u64
        ci = ci + 1
        if c0.namedoperation then {
            if (zast.nameTextAt :ast ref: c0.name).length > 0 then {
                # a second binding is not this shape; the parser forbids it,
                # so answer 0 rather than guessing which one to hoist
                if found > 0 then return 0
                found = ci
            }
        }
    }
    return found
}

# promoteForCond -- one condition of a for-loop being promoted: a
# suspending loop's non-trivial named iterable moves into a synthetic
# `_iterN` binding (appended to `dst`, ahead of the loop) and the condition
# then names `_iterN`; any other condition is a rewrite-clone. The rewritten
# condition's id goes to `nconds`.
promoteForCond: function {
    ast: Ast
    ctr: NameCtr
    c0Id: u32
    suspends: bool
    dst: ListVal u32
    nconds: ListVal u32
} is {
    # the condition is read through a view scoped to this block: the
    # synth below mints, which lends ast exclusively
    doHoist: false
    opId: zast.nodeid
    cnId: zast.nameid
    hl0: u32
    hc0: u32
    {
        c0: ast.nodes.get i: c0Id.u64
        if c0.namedoperation then {
            cn0: zast.nameTextAt :ast ref: c0.name
            if cn0.length > 0 when suspends then {
                if (condIsTrivial
                    :ast
                    n: (ast.nodes.get i: c0.operation.u64)
                ) == false then doHoist = true
            }
            if doHoist then {
                # synth nodes carry the ITERABLE's source position
                hp0: zast.posOf n: (ast.nodes.get i: c0.operation.u64)
                hl0 = hp0.line
                hc0 = hp0.col
                opId = c0.operation
                cnId = c0.name
            }
        }
    }
    if doHoist then {
        synthN: "_iter\{ctr.bump}"
        empty7: (MapRV String v: bool)
        rhs0: rewriteToThisAt :ast nid: opId promoted: empty7
        rhsE: ensureExpr :ast line: hl0 col: hc0 n: rhs0
        snv0: synthN.stringView
        snid0: zast.poolSet pool: ast.names text: snv0
        sno1: snv0
        sa0: (Node.assignment (zast.AssignmentData
            nodeid: (zast.tableReserve :ast)
            lineno: hl0
            colno: hc0
            name: snid0
            value: (zast.tableAdd :ast n: rhsE))
        )
        sl0: (Node.statementline (zast.StatementLineData
            nodeid: (zast.tableReserve :ast)
            lineno: hl0
            colno: hc0
            statementline: (zast.tableAdd :ast n: sa0))
        )
        dst.append (zast.tableAdd :ast n: sl0)
        # an owned copy: the name must outlive the mints below, which lend ast
        cn1: zast.nameTextCopy :ast ref: cnId
        na0: mkAtom :ast line: hl0 col: hc0 name: sno1
        nc0: mkNamedOp :ast line: hl0 col: hc0 name: cn1.stringView op: na0
        nconds.append (zast.tableAdd :ast n: nc0)
    } else {
        empty6: (MapRV String v: bool)
        cc0: rewriteToThisAt :ast nid: (zast.nodeid.create from: c0Id) promoted: empty6
        nconds.append (zast.tableAdd :ast n: cc0)
    }
}

# promote yield-crossing locals across a for-loop boundary.
promoteFor: function {
    ast: Ast
    ctr: NameCtr
    nid: zast.nodeid
    dst: ListVal u32
} out Node is {
    isFor: false
    lnS: u32
    coS: u32
    bodyId: zast.nodeid
    condIds: (ListVal u32)
    postIds: (ListVal u32)
    {
        n: ast.nodes.get i: nid.u64
        if n.forexpr then {
            isFor = true
            lnS = n.lineno
            coS = n.colno
            bodyId = n.body
            cox1389: u64
            for cox1389 < n.conditions.count.u64 loop {
                c: zast.kidAt kids: ast.kids span: n.conditions i: cox1389
                cox1389 = cox1389 + 1
                condIds.append from: c
            }
            pox1459: u64
            for pox1459 < n.postconditions.count.u64 loop {
                p: zast.kidAt kids: ast.kids span: n.postconditions i: pox1459
                pox1459 = pox1459 + 1
                postIds.append from: p
            }
        }
    }
    if (isFor) == false then {
        empty4: (MapRV String v: bool)
        return (rewriteToThisAt :ast :nid promoted: empty4)
    }
    # recurse into the loop body first (nested suspending fors)
    nbodyId: promoteIterablesIdAt :ast :ctr oId: bodyId
    suspends: false
    if nbodyId > 0 then {
        nb: ast.nodes.get i: nbodyId.u64
        suspends = bodyContainsYield :ast n: nb
    }
    nconds: (ListVal u32)
    # a C-style binding in a suspending loop is hoisted to its own statement
    # instead of being rewritten in place; every other condition is unchanged
    initIdx: u64
    if suspends then initIdx = forInitIdx :ast :condIds
    ci9: u64
    for ci9 < condIds.length loop {
        c0Id: condIds.get i: ci9
        ci9 = ci9 + 1
        if ci9 == initIdx then {
            promoteForInit :ast :c0Id :dst
        } else {
            promoteForCond :ast :ctr :c0Id :suspends :dst :nconds
        }
    }
    nposts: (ListVal u32)
    piter: postIds.iterate
    for p0Id: piter loop {
        empty5: (MapRV String v: bool)
        pp0: rewriteToThisAt :ast nid: (zast.nodeid.create from: p0Id) promoted: empty5
        nposts.append (zast.tableAdd :ast n: pp0)
    }
    return (Node.forexpr (zast.ForData
        nodeid: (zast.tableReserve :ast)
        lineno: lnS
        colno: coS
        conditions: (zast.kidsAdd kids: ast.kids xs: nconds)
        body: (zast.nodeid.create from: nbodyId)
        postconditions: (zast.kidsAdd kids: ast.kids xs: nposts))
    )
}

# true when condition `n` is a trivial always-true form.
condIsTrivial: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (condIsTrivial :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return true
    } else {
        return false
    }
}

# wrap a node as an expression node and return its id.
wrapExprNode: function {
    ast: Ast
    line: u32
    col: u32
    n: Node.take
} out Node is {
    return (Node.expression (zast.ExpressionData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        expression: (zast.tableAdd :ast :n))
    )
}

# true when `n` is an expression-kind node.
isExprNode: function {n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return true
    } else {
        return false
    }
}

# ensureExpr -- wrap in an Expression unless already one.
ensureExpr: function {
    ast: Ast
    line: u32
    col: u32
    n: Node.take
} out Node is {
    if (isExprNode :n) then {
        return n
    } else {
        return (wrapExprNode :ast :line :col :n)
    }
}

# rwplan -- what rewriting one row needs once its view is gone. mode: 0 =
# not a rewrite shape (clonePath copies it whole), 1 = rewrite every child,
# 2 = dottedpath (the child is a field label: it clones), 3 = binop (the
# operator clones), 4 = caseclause (the arm pattern clones). special: 0 =
# none, 1 = atomid, 2 = labelvalue, 3 = assignment; promotedName says the
# special arm names a promoted local (nameId, at ln:co).
rwplan: record {
    # how the row is rewritten: 0 copies it whole, 1 rewrites every child, 2 is
    # a dottedpath whose child is a field label, 3 a binop whose operator
    # clones, 4 a caseclause whose arm pattern clones
    mode: u32
    # which special arm it is: 0 none, 1 atomid, 2 labelvalue, 3 assignment
    special: u32
    # whether that special arm names a local promoted into the state class
    promotedName: bool
    # the promoted local's name, when it names one
    nameId: zast.nameid
    # the line to report it at
    ln: u32
    # the column to report it at
    co: u32
}

# rewritePlan -- read-only: the plan for `n`, and its child ids (canonical
# order) appended to `kids` when it is a rewrite shape.
rewritePlan: function {
    ast: Ast.view
    n: Node.view
    promoted: (MapRV String v: bool)
    kids: ListVal u32
} out rwplan is {
    mode: 1.u32
    special: u32
    isP: false
    nameId: zast.nameid
    ln: u32
    co: u32
    match (
        n
    ) case atomid then {
        special = 1
        nameId = n.name
        ln = n.lineno
        co = n.colno
        anvC: zast.nameTextAt :ast ref: n.name
        anv: anvC.stringView
        isP = (promoted.get key: anv.string).or d: false
    } case labelvalue then {
        special = 2
        nameId = n.name
        ln = n.lineno
        co = n.colno
        lnvC: zast.nameTextAt :ast ref: n.name
        lnv: lnvC.stringView
        isP = (promoted.get key: lnv.string).or d: false
    } case assignment then {
        special = 3
        nameId = n.name
        ln = n.lineno
        co = n.colno
        anvC: zast.nameTextAt :ast ref: n.name
        anv: anvC.stringView
        isP = (promoted.get key: anv.string).or d: false
    } case dottedpath then {
        mode = 2
    } case binop then {
        mode = 3
    } case caseclause then {
        mode = 4
    } case error then {
        mode = 0
    } case typeofexpr then {
        mode = 0
    } case datablock then {
        mode = 0
    } case functiondef then {
        mode = 0
    } case objectdef then {
        mode = 0
    } case unitdef then {
        mode = 0
    } case program then {
        mode = 0
    } case placeholder then {
        mode = 0
    } else null
    if mode > 0 then {
        ids: zast.childIds :ast :n
        with it: ids.iterate do for i: it loop kids.append from: i
    }
    return (rwplan :mode :special promotedName: isP :nameId :ln :co)
}

# rewriteKids -- rewrite (or, at the plan's clone-only positions, copy) each
# child by id and intern the results, in order.
rewriteKids: function {
    ast: Ast
    kids: (ListVal u32).view
    mode: u32
    promoted: (MapRV String v: bool)
} out (ListVal u32) is {
    cloned: (ListVal u32)
    ki: u64
    kn: kids.length
    for ki < kn loop {
        kid: zast.nodeid.create from: (kids.get i: ki)
        cloneOnly: false
        if mode == 2 when ki == 1 then cloneOnly = true
        if mode == 3 when ki == 1 then cloneOnly = true
        if mode == 4 when ki == 0 then cloneOnly = true
        if cloneOnly then {
            c0: clonePathAt :ast nid: kid
            cloned.append (zast.tableAdd :ast n: c0)
        } else {
            r0: rewriteToThisAt :ast nid: kid :promoted
            cloned.append (zast.tableAdd :ast n: r0)
        }
        ki = ki + 1
    }
    return cloned
}

# rewritePromoted -- the promoted-name rewrite when the plan names one (an
# atom/labelvalue becomes `this.<name>`; an assignment a reassignment
# through it, its value the already-interned child), else the placeholder
# arm. Mints.
rewritePromoted: function {
    ast: Ast
    plan: rwplan
    cloned: (ListVal u32).view
} out Node is {
    if (plan.promotedName) == false then return Node.placeholder
    nm: zast.nameTextCopy :ast ref: plan.nameId
    if plan.special == 3 then {
        topath: mkThisDotted :ast line: plan.ln col: plan.co name: nm.stringView
        return (Node.reassignment (zast.ReassignmentData
            nodeid: (zast.tableReserve :ast)
            lineno: plan.ln
            colno: plan.co
            topath: (zast.tableAdd :ast n: topath)
            value: (zast.nodeid.create from: (cloned.get i: 0)))
        )
    }
    return (mkThisDotted :ast line: plan.ln col: plan.co name: nm.stringView)
}

# rewriteArm -- the rewrite of `n`'s arm under `myId`, its children the
# interned results in `cloned` (canonical childIds order; an absent optional
# child is simply not there). Reads the view only.
rewriteArm: function {
    kids: ListVal u32
    n: Node.view
    myId: zast.nodeid
    cloned: (ListVal u32).view
} out Node is {
    match (
        n
    ) case atomid then {
        return (Node.atomid (zast.AtomIdData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name)
        )
    } case labelvalue then {
        return (Node.labelvalue (zast.LabelValueData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name)
        )
    } case dottedpath then {
        return (Node.dottedpath (zast.DottedPathData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            parent: (zast.nodeid.create from: (cloned.get i: 0))
            child: (zast.nodeid.create from: (cloned.get i: 1)))
        )
    } case expression then {
        return (Node.expression (zast.ExpressionData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            expression: (zast.nodeid.create from: (cloned.get i: 0)))
        )
    } case call then {
        return (Node.call (zast.CallData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            callable: (zast.nodeid.create from: (cloned.get i: 0))
            arguments: (zast.kidsAdd :kids xs: (idsSlice :cloned lo: 1 hi: cloned.length)))
        )
    } case namedoperation then {
        return (Node.namedoperation (zast.NamedOperationData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
            operation: (zast.nodeid.create from: (cloned.get i: 0)))
        )
    } case binop then {
        return (Node.binop (zast.BinOpData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            lhs: (zast.nodeid.create from: (cloned.get i: 0))
            operator: (zast.nodeid.create from: (cloned.get i: 1))
            rhs: (zast.nodeid.create from: (cloned.get i: 2)))
        )
    } case statement then {
        return (Node.statement (zast.StatementData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            statements: (zast.kidsAdd :kids xs: (idsSlice :cloned lo: 0 hi: cloned.length)))
        )
    } case statementline then {
        return (Node.statementline (zast.StatementLineData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            statementline: (zast.nodeid.create from: (cloned.get i: 0)))
        )
    } case assignment then {
        return (Node.assignment (zast.AssignmentData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
            value: (zast.nodeid.create from: (cloned.get i: 0)))
        )
    } case reassignment then {
        return (Node.reassignment (zast.ReassignmentData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            topath: (zast.nodeid.create from: (cloned.get i: 0))
            value: (zast.nodeid.create from: (cloned.get i: 1)))
        )
    } case swapstmt then {
        return (Node.swapstmt (zast.SwapStmtData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            lhs: (zast.nodeid.create from: (cloned.get i: 0))
            rhs: (zast.nodeid.create from: (cloned.get i: 1)))
        )
    } case ifexpr then {
        k: n.clauses.count.u64
        els: zast.nodeid
        if n.elseclause > 0 then els = zast.nodeid.create from: (cloned.get i: k)
        return (Node.ifexpr (zast.IfData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            clauses: (zast.kidsAdd :kids xs: (idsSlice :cloned lo: 0 hi: k))
            elseclause: els)
        )
    } case ifclause then {
        k: n.conditions.count.u64
        return (Node.ifclause (zast.IfClauseData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            conditions: (zast.kidsAdd :kids xs: (idsSlice :cloned lo: 0 hi: k))
            statement: (zast.nodeid.create from: (cloned.get i: k)))
        )
    } case forexpr then {
        k: n.conditions.count.u64
        bodyId: zast.nodeid
        postsAt: k
        if n.body > 0 then {
            bodyId = zast.nodeid.create from: (cloned.get i: k)
            postsAt = k + 1
        }
        return (Node.forexpr (zast.ForData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            conditions: (zast.kidsAdd :kids xs: (idsSlice :cloned lo: 0 hi: k))
            body: bodyId
            postconditions: (zast.kidsAdd
                :kids
                xs: (idsSlice :cloned lo: postsAt hi: cloned.length)
            ))
        )
    } case doexpr then {
        return (Node.doexpr (zast.DoData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            statement: (zast.nodeid.create from: (cloned.get i: 0)))
        )
    } case withexpr then {
        return (Node.withexpr (zast.WithData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
            value: (zast.nodeid.create from: (cloned.get i: 0))
            body: (zast.nodeid.create from: (cloned.get i: 1)))
        )
    } case caseexpr then {
        k: n.clauses.count.u64
        els: zast.nodeid
        if n.elseclause > 0 then els = zast.nodeid.create from: (cloned.get i: (k + 1))
        return (Node.caseexpr (zast.CaseData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            subject: (zast.nodeid.create from: (cloned.get i: 0))
            clauses: (zast.kidsAdd :kids xs: (idsSlice :cloned lo: 1 hi: (k + 1)))
            elseclause: els)
        )
    } case caseclause then {
        return (Node.caseclause (zast.CaseClauseData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
            matcharm: (zast.nodeid.create from: (cloned.get i: 0))
            statement: (zast.nodeid.create from: (cloned.get i: 1)))
        )
    } case atomstring then {
        return (Node.atomstring (zast.AtomStringData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            stringparts: (zast.kidsAdd :kids xs: (idsSlice :cloned lo: 0 hi: cloned.length)))
        )
    } case stringchunk then {
        tvL: n.text.stringView
        tcL: tvL.string
        ckL: n.chunkKind
        return (Node.stringchunk (zast.StringChunkData
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            text: tcL
            chunkKind: ckL)
        )
    } else {
        return Node.placeholder
    }
}

# rewriteToThis -- deep-clone the body, rewriting every promoted-name
# reference to `this.<name>`: atoms and labelvalues in value position
# become the dotted path, dotted HEADS rewrite (children are field
# labels), and an assignment to a promoted name becomes a reassignment
# through `this` (the field was reserved at create time). `n` may be a
# detached node; its children are table rows, rewritten and interned by
# id (rewriteToThisAt) before the clone's own slot is reserved, so nothing
# lends ast while a row view is live.
rewriteToThis: function {
    ast: Ast
    n: Node.view
    promoted: (MapRV String v: bool)
} out Node is {
    kids: (ListVal u32)
    plan: rewritePlan :ast :n :promoted :kids
    if plan.mode == 0 then return (clonePath :ast :n)
    cloned: rewriteKids :ast :kids mode: plan.mode :promoted
    special: rewritePromoted :ast :plan :cloned
    if (special.placeholder) == false then return special
    myId: zast.tableReserve :ast
    return (rewriteArm :n :myId :cloned kids: ast.kids)
}

# rewriteToThisAt -- rewriteToThis of the row `nid` names. Each row view is
# scoped to a block that lends nothing: the plan is read first, the children
# go next (by id), then the clone's slot, then the arm is built from the row.
rewriteToThisAt: function {
    ast: Ast
    nid: zast.nodeid
    promoted: (MapRV String v: bool)
} out Node is {
    kids: (ListVal u32)
    plan: (rwplan
        mode: 0
        special: 0
        promotedName: false
        nameId: (zast.nameid.create from: 0)
        ln: 0
        co: 0
    )
    {
        n: ast.nodes.get i: nid.u64
        plan = rewritePlan :ast :n :promoted :kids
    }
    if plan.mode == 0 then return (clonePathAt :ast :nid)
    cloned: rewriteKids :ast :kids mode: plan.mode :promoted
    special: rewritePromoted :ast :plan :cloned
    if (special.placeholder) == false then return special
    myId: zast.tableReserve :ast
    built: Node.placeholder
    {
        n: ast.nodes.get i: nid.u64
        built = rewriteArm :n :myId :cloned kids: ast.kids
    }
    return built
}

# rewrite an optional node's local references to `this.<field>` for the lowered class.
rewriteOptToThis: function {
    ast: Ast
    o: (Option Node).view
    promoted: (MapRV String v: bool)
} out Option Node is {
    match (
        o
    ) case some then {
        r: rewriteToThis :ast n: o :promoted
        return (Option.some r)
    } case none then {
        return (Option.none Node)
    }
}

# build a `this.<name>` dotted-path node and return its id.
mkThisDotted: function {
    ast: Ast
    line: u32
    col: u32
    name: StringView
} out Node is {
    thisAtom: mkAtom :ast :line :col name: "this"
    childAtom: mkAtom :ast :line :col :name
    return (Node.dottedpath (zast.DottedPathData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        parent: (zast.tableAdd :ast n: thisAtom)
        child: (zast.tableAdd :ast n: childAtom))
    )
}

# i64TypePath -- the `system.i64` type path the state cursor and the loop
# counters are declared with. Minted fresh per field: a type path is a node, and
# two fields may not share one.
i64TypePath: function {
    # the tree the path is minted into
    ast: Ast
    # the line the field is attributed to
    line: u32
    # the column likewise
    col: u32
} out Node is {
    sysAtom: mkAtom :ast :line :col name: "system"
    i64Leaf: mkAtom :ast :line :col name: "i64"
    return (Node.dottedpath (zast.DottedPathData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        parent: (zast.tableAdd :ast n: sysAtom)
        child: (zast.tableAdd :ast n: i64Leaf))
    )
}

# wrapDeclaredCallReturn -- `out U` on a declared `call` is the ELEMENT type, so
# the option wrapper goes on here and the ownership leaf selects it exactly as
# `Gives:` did. Answers the wrapper node's id -- the id the optionval collapse
# is keyed on -- or 0 when `call` declares no element type.
wrapDeclaredCallReturn: function {
    # the tree the wrapper is minted into
    ast: Ast
    # the `call` whose return type is being wrapped
    callFnId: zast.nodeid
    # the line the wrapper is attributed to
    line: u32
    # the column likewise
    col: u32
} out u32 is {
    retId: zast.nodeid
    {
        cf: ast.nodes.get i: callFnId.u64
        if cf.functiondef then retId = cf.returntype
    }
    if retId.isZero then return 0
    gp: (GivesParts
        base: (Option.none Node)
        leaf: "".string
    )
    givesFromOp :ast nid: retId dst: gp
    gb: gp.base.take
    match (
        gb
    ) case some then {
        wrapper: buildWrapper :ast :line :col base: gb.take leaf: gp.leaf.stringView
        wrapExpr: (Node.expression (zast.ExpressionData
            nodeid: (zast.tableReserve :ast)
            lineno: line
            colno: col
            expression: (zast.tableAdd :ast n: wrapper))
        )
        wid: zast.tableAdd :ast n: wrapExpr
        cfm: ast.nodes.getMut i: callFnId.u64
        if cfm.functiondef then cfm.returntype = (zast.nodeid.create from: wid)
        return wid
    } case none then null
    return 0
}

# injectCallReceiver -- the receiver `call` is declared to have implicitly. The
# state machine writes through it, so it is a borrow like every other receiver,
# and it goes FIRST: the input parameter the author may have written keeps its
# own position and its own call-site label behind it.
injectCallReceiver: function {
    # the tree the parameter is minted into
    ast: Ast
    # the `call` gaining the receiver
    callFnId: zast.nodeid
    # the line the parameter is attributed to
    line: u32
    # the column likewise
    col: u32
} is {
    thisP: mkAtom :ast :line :col name: "this"
    thisParam: mkNamedOp :ast :line :col name: "this" op: thisP
    tpId: zast.tableAdd :ast n: thisParam
    cfm2: ast.nodes.getMut i: callFnId.u64
    if cfm2.functiondef then {
        rest: (ListVal u32)
        rest.append tpId
        pax1569: u64
        for pax1569 < cfm2.parameters.count.u64 loop {
            pId: zast.kidAt kids: ast.kids span: cfm2.parameters i: pax1569
            pax1569 = pax1569 + 1
            rest.append pId
        }
        cfm2.parameters = (zast.kidsAdd kids: ast.kids xs: rest)
    }
}

# buildDeclaredCreate -- `.create` generated from the `is` fields, in order, and
# appended to the `as` block. The parameter's ownership follows the FIELD's: an
# owned field takes ownership of its argument, a non-owned one borrows it, and
# `outx this` pins whatever a non-owned field points into for the instance's
# lifetime.
buildDeclaredCreate: function {
    # the tree the create is minted into
    ast: Ast
    # the generator definition gaining the create
    objId: zast.nodeid
    # the line the create is attributed to
    line: u32
    # the column likewise
    col: u32
    # the author's `is` field names, in declaration order
    authorNames: (List String).view
    # their type nodes, in the same order
    authorTypes: (ListVal u64).view
} is {
    createParams: (ListVal u32)
    anyRef: false
    api: u64
    apn: authorNames.length
    for api < apn loop {
        a0: authorNames.get i: api
        a0v: a0.stringView
        at0: authorTypes.get i: api
        if (typePathIsReference
            :ast
            nid: (zast.nodeid.create from: at0.u32.orPanic)
        ) then anyRef = true
        ap0: createParamPath :ast nid: (zast.nodeid.create from: at0.u32.orPanic)
        np0: mkNamedOp :ast :line :col name: a0v op: ap0
        createParams.append (zast.tableAdd :ast n: np0)
        api = api + 1
    }
    createM: (buildCreateMethod
        :ast
        :line
        :col
        params: createParams
        fwdNames: authorNames
        pins: anyRef
    )
    cmN: mkNamedOp :ast :line :col name: "create" op: createM
    cmId: zast.tableAdd :ast n: cmN
    objc: ast.nodes.getMut i: objId.u64
    if objc.objectdef then {
        asMerged: (ListVal u32)
        asx1799: u64
        for asx1799 < objc.asItems.count.u64 loop {
            aId2: zast.kidAt kids: ast.kids span: objc.asItems i: asx1799
            asx1799 = asx1799 + 1
            asMerged.append aId2
        }
        asMerged.append cmId
        objc.asItems = (zast.kidsAdd kids: ast.kids xs: asMerged)
    }
}

# appendDeclaredFields -- the fields the suspension transform needs, appended
# after the ones the author declared. Order matters: the generated `create`
# forwards the author's fields by name and leaves these to their first write.
appendDeclaredFields: function {
    # the tree holding the definition
    ast: Ast
    # the generator definition gaining the fields
    objId: zast.nodeid
    # the field nodes to append, in order
    addFields: (ListVal u32).view
} is {
    objm: ast.nodes.getMut i: objId.u64
    if objm.objectdef then {
        merged: (ListVal u32)
        isx1969: u64
        for isx1969 < objm.isItems.count.u64 loop {
            iId: zast.kidAt kids: ast.kids span: objm.isItems i: isx1969
            isx1969 = isx1969 + 1
            merged.append iId
        }
        with afit: addFields.iterate do for afId: afit loop merged.append afId
        objm.isItems = (zast.kidsAdd kids: ast.kids xs: merged)
    }
}

# callBodyIdOf -- the body of a `call` functiondef; 0 when it has none. Asked
# again after the iterable hoist, which replaces the body with a new node.
callBodyIdOf: function {
    # the tree holding the function
    ast: Ast.view
    # the `call` whose body is wanted
    callFnId: zast.nodeid
} out zast.nodeid is {
    cf: ast.nodes.get i: callFnId.u64
    match (
        cf
    ) case functiondef then {
        return cf.body
    } else {
        return (zast.nodeid.create from: 0)
    }
}

# declaredInputTypeId -- the per-call input parameter's type node on a declared
# `call`, 0 when it declares none. Asked BEFORE the receiver is injected, so the
# input is the first parameter; afterwards it is the second.
declaredInputTypeId: function {
    # the tree holding the function
    ast: Ast.view
    # the `call` whose input is wanted
    callFnId: zast.nodeid
} out zast.nodeid is {
    cf: ast.nodes.get i: callFnId.u64
    if cf.functiondef then {
        pax1579: u64
        for pax1579 < cf.parameters.count.u64 loop {
            pId: zast.kidAt kids: ast.kids span: cf.parameters i: pax1579
            pax1579 = pax1579 + 1
            pn: ast.nodes.get i: pId.u64
            if pn.namedoperation then return pn.operation
        }
    }
    return (zast.nodeid.create from: 0)
}

# resumeFieldPath -- the `_resume_input` field's type for a declared input. The
# field holds the most recent resumed value: an OWNED input (`.take` / `.hold`)
# strips to an owned field, a non-owned one (`.borrow` / `.view`) keeps its
# marker, and an unmarked one is a reference into the caller's argument for the
# call's duration, so it becomes a `.borrow` field. Read by NAME ID for the same
# reason createParamPath is.
resumeFieldPath: function {
    # the tree the field type is minted into
    ast: Ast
    # the input parameter's declared type node
    nid: zast.nodeid
} out Node is {
    leafId: zast.nameid
    parentId: zast.nodeid
    line: u32
    col: u32
    {
        pp: zast.posOf n: (ast.nodes.get i: nid.u64)
        line = pp.line
        col = pp.col
        bn: ast.nodes.get i: nid.u64
        if bn.dottedpath then {
            parentId = bn.parent
            leafId = leafAtomNameId :ast n: (ast.nodes.get i: bn.child.u64)
        }
    }
    if leafId == zast.names.wkBorrow then return (clonePathAt :ast :nid)
    if leafId == zast.names.wkView then return (clonePathAt :ast :nid)
    isOwned: false
    if leafId == zast.names.wkTake then isOwned = true
    if leafId == zast.names.wkHold then isOwned = true
    if isOwned then {
        if (parentId.isZero) == false then return (clonePathAt :ast nid: parentId)
        return (clonePathAt :ast :nid)
    }
    base: clonePathAt :ast :nid
    bl: mkAtom :ast :line :col name: "borrow"
    return (Node.dottedpath (zast.DottedPathData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        parent: (zast.tableAdd :ast n: base)
        child: (zast.tableAdd :ast n: bl))
    )
}

# DeclParts -- what one pass over a `generator`'s definition yields: where it
# was written, its `call`, and the fields the author declared. The `is` list is
# read ONCE, before this pass appends its own fields, so the generated `create`
# takes exactly the author's and never the state machine's.
DeclParts: class {
    # `call`'s functiondef node, 0 when the definition declares none
    callFnId: zast.nodeid
    # the line the definition was written on, for the nodes minted against it
    line: u32
    # the column it was written at, likewise
    colno: u32
    # the author's `is` field names, in declaration order
    names: (List String)
    # their type nodes, in the same order
    types: (ListVal u64)
    # the per-call input parameter's type node, 0 when `call` declares none.
    # Read before the receiver is injected, so it is the FIRST parameter here.
    inputTypeId: zast.nodeid
}

# readDeclaredParts -- fill `dst` from one `generator` objectdef.
readDeclaredParts: function {
    # the tree holding the definition
    ast: Ast.view
    # the generator definition to read
    objId: zast.nodeid
    # filled with what the definition declares
    dst: DeclParts
} is {
    obn: ast.nodes.get i: objId.u64
    if obn.objectdef then {
        dst.line = obn.lineno
        dst.colno = obn.colno
        asx1809: u64
        for asx1809 < obn.asItems.count.u64 loop {
            amId: zast.kidAt kids: ast.kids span: obn.asItems i: asx1809
            asx1809 = asx1809 + 1
            am: ast.nodes.get i: amId.u64
            if am.namedoperation then {
                if am.name == zast.names.wkCall then {
                    dst.callFnId = am.operation
                    dst.inputTypeId = declaredInputTypeId :ast callFnId: am.operation
                }
            }
        }
        # the AUTHOR's fields, read before this pass appends its own: the
        # generated `create` takes exactly these, so what the state machine
        # needs never reaches the construction site.
        isx1979: u64
        for isx1979 < obn.isItems.count.u64 loop {
            imId: zast.kidAt kids: ast.kids span: obn.isItems i: isx1979
            isx1979 = isx1979 + 1
            im: ast.nodes.get i: imId.u64
            if im.namedoperation then {
                inm: zast.nameTextAt :ast ref: im.name
                dst.names.append inm.copy
                dst.types.append im.operation.u64
            }
        }
    }
}

# appendCrossingFields -- one `typeof`-typed field per local live across a
# suspension, typed from its FIRST assignment: a promoted local has no
# declaration to read a type from, and the first write is what gives it one.
appendCrossingFields: function {
    # the tree the typeof fields are minted into
    ast: Ast
    # the line a promoted local's field is attributed to
    line: u32
    # the column likewise
    col: u32
    # the locals live across a suspension, in first-assignment order
    crossing: (List String).view
    # the body their first assignments are read from
    pBody: (Option Node).view
    # the field list the typeof fields join
    addFields: ListVal u32
} is {
    with cit2: crossing.iterate do for l3: cit2 loop {
        l3v: l3.stringView
        rhsCar: (GivesParts
            base: (Option.none Node)
            leaf: "".string
        )
        firstRhsOfOpt :ast o: pBody name: l3v dst: rhsCar
        rc3: rhsCar.base.take
        match (
            rc3
        ) case some then {
            tof3: (Node.typeofexpr (zast.TypeOfExprData
                nodeid: (zast.tableReserve :ast)
                lineno: line
                colno: col
                source: (zast.tableAdd :ast n: rc3.take))
            )
            nf4: mkNamedOp :ast :line :col name: l3v op: tof3
            addFields.append (zast.tableAdd :ast n: nf4)
        } case none then null
    }
}

# appendResumeFields -- the resume slots and the input store, for a `call` that
# declares a per-call input. A yield hoisted out of expression position leaves
# its resumed value in one of these, not in a C local: the suspension RETURNS
# from `.call`, so a local does not survive a later suspension in the same
# statement. One slot per suspension point, numbered as the emitter numbers its
# resume labels.
appendResumeFields: function {
    # the tree the counter fields are minted into
    ast: Ast
    # the line a counter field is attributed to
    line: u32
    # the column likewise
    col: u32
    # the input parameter's declared type node
    inputTypeId: zast.nodeid
    # how many suspension points the body has
    yieldSlots: u64
    # the field list the counters join
    addFields: ListVal u32
} is {
    yvi: u64
    for yvi < yieldSlots loop {
        yvi = yvi + 1
        yvT: resumeFieldPath :ast nid: inputTypeId
        yvNm: "_yv_\{yvi}"
        yvF: mkNamedOp :ast :line :col name: yvNm.stringView op: yvT
        addFields.append (zast.tableAdd :ast n: yvF)
    }
    riT: resumeFieldPath :ast nid: inputTypeId
    riF: mkNamedOp :ast :line :col name: "_resume_input" op: riT
    addFields.append (zast.tableAdd :ast n: riF)
}

# appendForCounterFields -- one counter field per label-bound `for` whose body
# suspends. A `for` counter lives only in the C header, and `goto L_resume_k`
# jumps in past the init clause, so it has to be a field like everything else
# live across a suspension. It cannot come from the crossing analysis: a `for`
# label is a nameid on the header's namedoperation, not an assignment.
appendForCounterFields: function {
    # the tree the resume fields are minted into
    ast: Ast
    # the line a resume field is attributed to
    line: u32
    # the column likewise
    col: u32
    # how many suspending `for` loops the body has
    forSlots: u64
    # the field list the resume fields join
    addFields: ListVal u32
} is {
    fci: u64
    for fci < forSlots loop {
        fci = fci + 1
        fcTy: i64TypePath :ast :line :col
        fcNm: "_fc_\{fci}"
        fcF: mkNamedOp :ast :line :col name: fcNm.stringView op: fcTy
        addFields.append (zast.tableAdd :ast n: fcF)
    }
}

# promotedSet -- the crossing locals as the name set rewriteToThis rewrites
# through `this`. A declared generator promotes ONLY these: its `is` fields are
# already read as `this.x` because the author wrote them that way.
promotedSet: function {
    # the locals live across a suspension
    crossing: (List String).view
    # filled with one entry per name
    dst: (MapRV String v: bool)
} is {
    with cit: crossing.iterate do for ce: cit loop {
        cev: ce.stringView
        ck: cev.string
        cv: true
        dst.set key: ck value: cv
    }
}

# GenDeclared -- what preparing a declared `generator` leaves the checker to
# record: the `call` whose body `yield` is legal in, and the wrapper node whose
# Option collapses to `optionval` over a valtype element. Both are node ids the
# checker keys side tables on; nothing here is a node the pass hands back.
GenDeclared: class {
    # `call`'s own functiondef node, 0 when there was no `call` to prepare
    callFnId: u32
    # the `.call` return wrapper, 0 when `call` declares no element type
    wrapperNodeId: u32
    # the body binds `yield`'s own value while `call` declares no input to
    # receive: the binding names a value nothing can ever supply
    readsAbsentInput: bool
}

# createParamPath -- the generated `create`'s parameter type for one `is` field.
# An OWNED field (no marker, or `.take` / `.hold`) takes a `.take` parameter:
# the field owns what it is given, and a create whose parameter merely borrowed
# it could not move it into the instance -- that refusal is what a bare reftype
# capture used to hit. A non-owned field (`.borrow` / `.view`) keeps its own
# marker, and the create's `outx this` pins the source it points into.
createParamPath: function {
    # the tree the parameter type is minted into
    ast: Ast
    # the field's declared type node
    nid: zast.nodeid
} out Node is {
    # the leaf is read by NAME ID, not through pathLeafName: that one answers
    # only take/lock/borrow, and a `.view` field read through it comes back
    # unmarked and would be handed a `.take` parameter -- an owned copy of a
    # reference. That is the same take/lock/borrow blind spot this whole form
    # exists to delete, and it is easy to reintroduce by reusing the reader.
    leafId: zast.nameid
    parentId: zast.nodeid
    {
        bn: ast.nodes.get i: nid.u64
        if bn.dottedpath then {
            parentId = bn.parent
            leafId = leafAtomNameId :ast n: (ast.nodes.get i: bn.child.u64)
        }
    }
    isNonOwned: false
    if leafId == zast.names.wkBorrow then isNonOwned = true
    if leafId == zast.names.wkView then isNonOwned = true
    if isNonOwned then return (clonePathAt :ast :nid)
    base: clonePathAt :ast :nid
    if (parentId.isZero) == false then base = clonePathAt :ast nid: parentId
    takeLeaf: mkAtom :ast line: 0 col: 0 name: "take"
    return (Node.dottedpath (zast.DottedPathData
        nodeid: (zast.tableReserve :ast)
        lineno: 0
        colno: 0
        parent: (zast.tableAdd :ast n: base)
        child: (zast.tableAdd :ast n: takeLeaf))
    )
}

# lowerDeclared -- prepare one DECLARED `generator` for the ordinary class walk.
#
# The class is authored here, not synthesised: its fields are the `is` block and
# its `call` is a written method, so this pass adds only what the suspension
# transform needs and nothing that the author already said. `call` gains the
# receiver it is declared to have implicitly and the option wrapper around its
# ELEMENT type; the state cursor, the yield-crossing locals, the loop counters
# and the resume slots are appended as fields.
#
# The captured-parameter half of `lowerOne` has no counterpart here, and that is
# the point of the form: an `is` field is read as `this.x` because the author
# wrote it that way, so nothing is promoted on its behalf and its ownership is
# whatever the field declares.
#
# Fills `dst` with the two node ids the checker keys side tables on: `call`'s
# own functiondef -- the id `yield` legality is keyed on, the same id lowerOne
# hands back for the `.call` it mints -- and the return wrapper, whose Option
# collapses to `optionval` over a valtype element. Both stay 0 when there is no
# `call` to prepare; the checker reports that, this pass only declines to touch
# it.
lowerDeclared: function {
    # the tree the definition lives in
    ast: Ast
    # the generator definition to prepare
    objId: zast.nodeid
    # filled with the node ids the checker keys its side tables on
    dst: GenDeclared
} is {
    parts: (DeclParts
        callFnId: (zast.nodeid.create from: 0)
        line: 0
        colno: 0
        names: (List String)
        types: (ListVal u64)
        inputTypeId: (zast.nodeid.create from: 0)
    )
    readDeclaredParts :ast :objId dst: parts
    ctr: (NameCtr next: 0)
    line: parts.line
    col: parts.colno
    callFnId: parts.callFnId
    if callFnId.isZero then return
    bodyId: callBodyIdOf :ast :callFnId
    if bodyId.isZero then return

    dst.wrapperNodeId = wrapDeclaredCallReturn :ast :callFnId :line :col
    injectCallReceiver :ast :callFnId :line :col
    # the suspension transform, on the body the author wrote
    newBodyId: promoteIterablesIdAt :ast :ctr oId: bodyId
    if newBodyId > 0 then {
        cfm3: ast.nodes.getMut i: callFnId.u64
        if cfm3.functiondef then cfm3.body = (zast.nodeid.create from: newBodyId)
    }
    bodyId2: callBodyIdOf :ast :callFnId
    # the body is TAKEN out of the table for the analysis: read in place it
    # holds a shared lock on `ast.nodes`, and every helper below wants `ast`
    # exclusively to mint into it. lowerOne is lock-free here for the same
    # reason -- it owns the whole functiondef.
    pBody: (Option.some (zast.tableTake :ast id: bodyId2.u32))
    gc: (GenCross
        yieldCount: 0
        firstDef: (MapRV String v: u64)
        maxUse: (MapRV String v: u64)
        inLoop: (MapRV String v: bool)
        params: (MapRV String v: bool)
        yieldBound: (MapRV String v: bool)
    )
    crossWalkOpt :ast :gc o: pBody inYieldLoop: false
    # one resume SLOT per suspension point, counted by the SAME function the
    # emitter numbers its resume labels with. An out-only generator has none:
    # the slots hold the value a suspension is RESUMED with, and nothing resumes
    # one with a value.
    yieldSlots: yieldSlotsOpt :ast o: pBody
    forSlots: forCounterSlotsOpt :ast o: pBody
    crossing: (List String)
    crossingLocals :gc dst: crossing
    # `a: yield e` binds the value the NEXT call supplies. With no input
    # declared there is no next value, so the binding is a read of something
    # that cannot exist -- reported by the checker, which holds the errors.
    if parts.inputTypeId.isZero when gc.yieldBound.length > 0 then dst.readsAbsentInput = true
    promoted: (MapRV String v: bool)
    promotedSet :crossing dst: promoted

    # the fields the transform needs, appended to the ones the author declared
    addFields: (ListVal u32)
    {
        stTy: i64TypePath :ast :line :col
        stField: mkNamedOp :ast :line :col name: "state" op: stTy
        addFields.append (zast.tableAdd :ast n: stField)
    }
    appendCrossingFields :ast :line :col :crossing :pBody :addFields
    newBodyOpt: rewriteOptToThis :ast o: pBody :promoted
    match (
        newBodyOpt
    ) case some then {
        nbId: zast.tableAdd :ast n: newBodyOpt.take
        cfm4: ast.nodes.getMut i: callFnId.u64
        if cfm4.functiondef then cfm4.body = (zast.nodeid.create from: nbId)
    } case none then null
    appendForCounterFields :ast :line :col :forSlots :addFields
    if (parts.inputTypeId.isZero) == false then (appendResumeFields
        :ast
        :line
        :col
        inputTypeId: parts.inputTypeId
        :yieldSlots
        :addFields
    )
    (buildDeclaredCreate :ast :objId :line :col authorNames: parts.names authorTypes: parts.types)
    appendDeclaredFields :ast :objId :addFields
    dst.callFnId = callFnId.u32
}

