# zgenerator.z -- generator-function lowering. A generator is a function
# whose body yields and whose declared return is the Iterator protocol (the
# caller decides which). Lowering turns it into a synthesized iterator class
# -- a `state` cursor plus the captured parameters and yield-crossing locals,
# a `create` forwarding to meta.create, and a `call` method holding the
# original body with its yields intact (the state machine is the emitter's
# job) -- and rebinds the original function to a factory returning the class.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :canLowerNow
    :clonePath
    :fnBodyHasYield
    :lowerOne
    :mkNamedOp
    :returnHeadName
    :rewriteOptToThisAt
}

Node: zast.Node
Ast: zast.Ast


# The counter the synthetic `_iterN` names draw from. Node ids do not
# come from here: a synthesised node reserves its own table slot with
# zast.tableReserve.
NameCtr: class {
    next: u32
} as {
    bump: function {:this} out zast.nodeid is {
        id: this.next
        this.next = this.next + 1
        return (zast.nodeid.create from: id)
    }
}

# One lowered generator: the factory that replaces the original function
# definition, the synth class to append to the unit body, and the synth
# `.call` return wrapper-EXPRESSION's nodeid (the pendingMono key; the
# typechecker collapses that wrapper to optionval for valtype elements).
GenLowered: class {
    factory: Node
    synthClass: Node
    wrapperNodeId: u32
    noStamp: (ListVal u32)
}

# topNodeId -- a cloned type-path's top node id (the typeref-stamp key the
# resolution records); 0 for unhandled shapes.
topNodeId: function {n: Node.view} out zast.nodeid is {
    match (
        n
    ) case atomid then {
        return n.nodeid
    } case labelvalue then {
        return n.nodeid
    } case dottedpath then {
        return n.nodeid
    } case expression then {
        return n.nodeid
    } case call then {
        return n.nodeid
    } else {
        return (zast.nodeid.create from: 0)
    }
}

# the operation node id of parameter node `n`.
paramOpId: function {ast: Ast.view n: Node.view} out zast.nodeid is {
    match (
        n
    ) case namedoperation then {
        return (topNodeId n: (ast.nodes.get i: n.operation.u64))
    } else {
        return (zast.nodeid.create from: 0)
    }
}

# bodyContainsYield -- a yield anywhere in this subtree, not descending
# into nested function literals (their yields belong to that function).
bodyContainsYield: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case yieldexpr then {
        return true
    } case functiondef then {
        return false
    } case statement then {
        siter: n.statements.iterate
        for s0Id: siter loop {
            if (bodyContainsYield :ast n: (ast.nodes.get i: s0Id.u64)) then return true
        }
        return false
    } case statementline then {
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.statementline.u64))
    } case expression then {
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.expression.u64))
    } case assignment then {
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.value.u64))
    } case reassignment then {
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.value.u64))
    } case ifexpr then {
        cliter: n.clauses.iterate
        for cl0Id: cliter loop {
            if (bodyContainsYield :ast n: (ast.nodes.get i: cl0Id.u64)) then return true
        }
        return (bodyContainsYieldOptAt :ast oId: n.elseclause)
    } case ifclause then {
        coiter: n.conditions.iterate
        for c0Id: coiter loop {
            if (bodyContainsYield :ast n: (ast.nodes.get i: c0Id.u64)) then return true
        }
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.statement.u64))
    } case forexpr then {
        fiter: n.conditions.iterate
        for f0: fiter loop {
            if (bodyContainsYield :ast n: (ast.nodes.get i: f0.u64)) then return true
        }
        if (bodyContainsYieldOptAt :ast oId: n.body) then return true
        piter: n.postconditions.iterate
        for p0: piter loop {
            if (bodyContainsYield :ast n: (ast.nodes.get i: p0.u64)) then return true
        }
        return false
    } case doexpr then {
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.statement.u64))
    } case withexpr then {
        if (bodyContainsYield :ast n: (ast.nodes.get i: n.value.u64)) then return true
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.body.u64))
    } case caseexpr then {
        if (bodyContainsYield :ast n: (ast.nodes.get i: n.subject.u64)) then return true
        mliter: n.clauses.iterate
        for m0: mliter loop {
            if (bodyContainsYield :ast n: (ast.nodes.get i: m0.u64)) then return true
        }
        return (bodyContainsYieldOptAt :ast oId: n.elseclause)
    } case caseclause then {
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.statement.u64))
    } case namedoperation then {
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.operation.u64))
    } case call then {
        if (bodyContainsYield :ast n: (ast.nodes.get i: n.callable.u64)) then return true
        aiter: n.arguments.iterate
        for a0: aiter loop {
            if (bodyContainsYield :ast n: (ast.nodes.get i: a0.u64)) then return true
        }
        return false
    } case binop then {
        if (bodyContainsYield :ast n: (ast.nodes.get i: n.lhs.u64)) then return true
        return (bodyContainsYield :ast n: (ast.nodes.get i: n.rhs.u64))
    } else {
        return false
    }
}

# true when the optional body `oId` contains a `yield`.
bodyContainsYieldOptAt: function {ast: Ast.view oId: zast.nodeid} out bool is {
    if oId.isZero then return false
    return (bodyContainsYield :ast n: (ast.nodes.get i: oId.u64))
}

# fnBodyHasYield -- the cheap structural generator pre-test on a
# functiondef Node (spec/native bodies are never generators).
fnBodyHasYield: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case functiondef then {
        return (bodyContainsYieldOptAt :ast oId: n.body)
    } else {
        return false
    }
}

# leafAtomName -- an atom's name (owned copy); "" for other shapes.
leafAtomName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# returnHeadName -- the callable head atom of a parenthesized return-type
# call (`out (Iterator gives: i64)` -> "Iterator"); "" for other shapes.
returnHeadName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case functiondef then {
        return (returnHeadOpt :ast oId: n.returntype)
    } else {
        return "".string
    }
}

# the return-type head name of optional operation `oId` (or "").
returnHeadOpt: function {ast: Ast.view oId: zast.nodeid} out String is {
    if oId.isZero then return "".string
    o: ast.nodes.get i: oId.u64
    return (returnHeadOf :ast n: o)

}

# the return-type head name of operation `n`.
returnHeadOf: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (returnHeadOf :ast n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        return (leafAtomName :ast n: (ast.nodes.get i: n.callable.u64))
    } else {
        return "".string
    }
}
# isNonOwnedLeaf -- a path leaf naming a NON-OWNED marker. `lock` and `borrow`
# mean the same thing here (not owned, mutable), and the generator desugarer has
# to accept both while `.lock` retires: the recognisers below keyed on the
# literal `lock`, so a receiver spelled `.borrow` was silently not a receiver and
# the factory came back with the wrong result type.
isNonOwnedLeaf: function {name: StringView} out bool is {
    if name == "lock" then return true
    return name == "borrow"
}


# pathLeafName -- the take/lock/borrow ownership leaf on a dotted path,
# "" when none.
pathLeafName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case dottedpath then {
        ln: leafAtomName :ast n: (ast.nodes.get i: n.child.u64)
        if ln.stringview == "take" then return ln
        if ln.stringview == "lock" then return ln
        if ln.stringview == "borrow" then return ln
        return "".string
    } else {
        return "".string
    }
}

# clonePath -- deep-copy a type-path subtree (atom / labelvalue / dotted /
# expression / call / namedoperation shapes), minting fresh nodeids. The
# synth wrapper and field types embed clones because a node owns exactly
# one parent.
clonePath: function {ast: Ast.view n: Node.view} out Node is {
    match (
        n
    ) case atomid then {
        # interned name: the clone shares the pool id
        return (Node.atomid (zast.AtomIdData
            nodeid: (zast.tableReserve :ast)
            lineno: n.lineno
            colno: n.colno
            name: n.name)
        )
    } case labelvalue then {
        return (Node.labelvalue (zast.LabelValueData
            nodeid: (zast.tableReserve :ast)
            lineno: n.lineno
            colno: n.colno
            name: n.name)
        )
    } case dottedpath then {
        ln2: n.lineno
        co2: n.colno
        np: clonePath :ast n: (ast.nodes.get i: n.parent.u64)
        nc: clonePath :ast n: (ast.nodes.get i: n.child.u64)
        return (Node.dottedpath (zast.DottedPathData
            nodeid: (zast.tableReserve :ast)
            lineno: ln2
            colno: co2
            parent: (zast.tableAdd :ast n: np)
            child: (zast.tableAdd :ast n: nc))
        )
    } case expression then {
        ln3: n.lineno
        co3: n.colno
        ne: clonePath :ast n: (ast.nodes.get i: n.expression.u64)
        return (Node.expression (zast.ExpressionData
            nodeid: (zast.tableReserve :ast)
            lineno: ln3
            colno: co3
            expression: (zast.tableAdd :ast n: ne))
        )
    } case call then {
        ln4: n.lineno
        co4: n.colno
        ncal: clonePath :ast n: (ast.nodes.get i: n.callable.u64)
        nargs: (ListVal u32)
        aiter: n.arguments.iterate
        for a0Id: aiter loop {
            na0: clonePath :ast n: (ast.nodes.get i: a0Id.u64)
            nargs.append (zast.tableAdd :ast n: na0)
        }
        return (Node.call (zast.CallData
            nodeid: (zast.tableReserve :ast)
            lineno: ln4
            colno: co4
            callable: (zast.tableAdd :ast n: ncal)
            arguments: nargs)
        )
    } case namedoperation then {
        ln5: n.lineno
        co5: n.colno
        nop: clonePath :ast n: (ast.nodes.get i: n.operation.u64)
        nnm: n.name
        return (Node.namedoperation (zast.NamedOperationData
            nodeid: (zast.tableReserve :ast)
            lineno: ln5
            colno: co5
            name: nnm
            operation: (zast.tableAdd :ast n: nop))
        )
    } case binop then {
        ln6: n.lineno
        co6: n.colno
        nl6: clonePath :ast n: (ast.nodes.get i: n.lhs.u64)
        no6: clonePath :ast n: (ast.nodes.get i: n.operator.u64)
        nr6: clonePath :ast n: (ast.nodes.get i: n.rhs.u64)
        return (Node.binop (zast.BinOpData
            nodeid: (zast.tableReserve :ast)
            lineno: ln6
            colno: co6
            lhs: (zast.tableAdd :ast n: nl6)
            operator: (zast.tableAdd :ast n: no6)
            rhs: (zast.tableAdd :ast n: nr6))
        )
    } case atomstring then {
        ln7: n.lineno
        co7: n.colno
        nparts: (ListVal u32)
        spiter: n.stringparts.iterate
        for sp0Id: spiter loop {
            np0: clonePath :ast n: (ast.nodes.get i: sp0Id.u64)
            nparts.append (zast.tableAdd :ast n: np0)
        }
        return (Node.atomstring (zast.AtomStringData
            nodeid: (zast.tableReserve :ast)
            lineno: ln7
            colno: co7
            stringparts: nparts)
        )
    } case stringchunk then {
        ln8: n.lineno
        co8: n.colno
        tv8: n.text.stringview
        tc8: tv8.string
        ck8: n.chunkKind
        return (Node.stringchunk (zast.StringChunkData
            nodeid: (zast.tableReserve :ast)
            lineno: ln8
            colno: co8
            text: tc8
            chunkKind: ck8)
        )
    } else {
        # unsupported path shape -- an error atom keeps the tree total
        return (Node.atomid (zast.AtomIdData
            nodeid: (zast.tableReserve :ast)
            lineno: 0
            colno: 0
            name: (internSynthName :ast text: "?"))
        )
    }
}


# givesParts -- split the iterator return into (gives base path CLONE,
# ownership leaf, accepts path CLONE or none). The base clone feeds the
# synth wrapper; leaf "take" selects Option, else OptionView.
GivesParts: class {
    base: (Option Node)
    leaf: String
    acceptsTy: (Option Node)
}

# the per-iteration gives/accepts shape derived from generator node `n`.
givesParts: function {ast: Ast.view n: Node.view} out GivesParts is {
    result: (GivesParts base: (Option.none Node) leaf: "".string acceptsTy: (Option.none Node))
    match (
        n
    ) case functiondef then {
        givesPartsOpt :ast oId: n.returntype dst: result
    } else null
    return result
}

# fill `dst` with the gives/accepts shape of optional node `oId`.
givesPartsOpt: function {ast: Ast.view oId: zast.nodeid dst: GivesParts} is {
    if oId.isZero then return
    o: ast.nodes.get i: oId.u64
    givesPartsOf :ast n: o :dst

}

# fill `dst` with the gives/accepts shape of node `n`.
givesPartsOf: function {ast: Ast.view n: Node.view dst: GivesParts} is {
    match (
        n
    ) case expression then {
        givesPartsOf :ast n: (ast.nodes.get i: n.expression.u64) :dst
    } case call then {
        aiter: n.arguments.iterate
        for a0Id: aiter loop {
            a0: ast.nodes.get i: a0Id.u64
            match (
                a0
            ) case namedoperation then {
                an: zast.nameTextAt :ast ref: a0.name
                if an.stringview == "gives" then {
                    givesFromOp :ast n: (ast.nodes.get i: a0.operation.u64) :dst
                }
                if an.stringview == "accepts" then {
                    acceptsFromOp :ast n: (ast.nodes.get i: a0.operation.u64) :dst
                }
            } else null
        }
    } else null
}

# read the `gives` type from operation `n` into `dst`.
givesFromOp: function {ast: Ast.view n: Node.view dst: GivesParts} is {
    isExpr: false
    match (
        n
    ) case expression then {
        isExpr = true
        givesFromOp :ast n: (ast.nodes.get i: n.expression.u64) :dst
    } else null
    if isExpr then return
    lf: pathLeafName :ast :n
    if lf.length > 0 then {
        match (
            n
        ) case dottedpath then {
            bc: clonePath :ast n: (ast.nodes.get i: n.parent.u64)
            dst.base = (Option.some bc)
            dst.leaf = lf
        } else null
    } else {
        bc2: clonePath :ast :n
        dst.base = (Option.some bc2)
    }
}

# read the `accepts` type from operation `n` into `dst`.
acceptsFromOp: function {ast: Ast.view n: Node.view dst: GivesParts} is {
    nm0: leafAtomName :ast :n
    if nm0.stringview != "null" then {
        ac: clonePath :ast :n
        dst.acceptsTy = (Option.some ac)
    }
}

# resumeBaseId -- pathBaseAtomId over an optional path.
resumeBaseId: function {ast: Ast.view o: Option Node} out zast.nodeid is {
    match (
        o
    ) case some then {
        return (pathBaseAtomId :ast n: o)
    } case none then {
        return (zast.nodeid.create from: 0)
    }
}

# pathBaseAtomId -- the head atom's node id of a (possibly dotted /
# wrapped) type path; 0 for other shapes.
pathBaseAtomId: function {ast: Ast.view n: Node.view} out zast.nodeid is {
    match (
        n
    ) case atomid then {
        return n.nodeid
    } case labelvalue then {
        return n.nodeid
    } case dottedpath then {
        return (pathBaseAtomId :ast n: (ast.nodes.get i: n.parent.u64))
    } case expression then {
        return (pathBaseAtomId :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        return (zast.nodeid.create from: 0)
    }
}

# cloneDottedParent -- a clone of a dotted path's parent (the ownership
# leaf stripped); none for non-dotted shapes.
cloneDottedParent: function {ast: Ast.view n: Node.view} out Option Node is {
    match (
        n
    ) case dottedpath then {
        c: clonePath :ast n: (ast.nodes.get i: n.parent.u64)
        return (Option.some c)
    } else {
        return (Option.none Node)
    }
}

# mkAtom / mkNamedOp / mkBareOp -- small node factories at a source
# position (the synthesized members all carry the function's start).
# internSynthName -- the pool id for synthesized-name text (deduplicated
# by the pool, so ref equality holds across parsed and synthesized atoms).
internSynthName: function {ast: Ast text: StringView} out zast.nameid is {
    return (ast.names.set s: text)
}

# build an atomid node for a name and return its node id.
mkAtom: function {
    ast: Ast.view
    line: u32
    col: u32
    name: StringView
} out Node is {
    return (Node.atomid (zast.AtomIdData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        name: (internSynthName :ast text: name))
    )
}

# build a namedoperation node (a name paired with an operation) in `ast`
# and return its node id.
mkNamedOp: function {
    ast: Ast
    line: u32
    col: u32
    name: StringView
    op: Node.take
} out Node is {
    return (Node.namedoperation (zast.NamedOperationData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        name: (ast.names.set s: name)
        operation: (zast.tableAdd :ast n: op))
    )
}

# build a bare namedoperation node and return its node id.
mkBareOp: function {
    ast: Ast.view
    line: u32
    col: u32
    op: Node.take
} out Node is {
    return (Node.namedoperation (zast.NamedOperationData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        name: zast.nameid
        operation: (zast.tableAdd :ast n: op))
    )
}

# mkReturnBody -- `{ return (<inner>) }`: the single-statement body both
# the create method and the factory share.
mkReturnBody: function {
    ast: Ast.view
    line: u32
    col: u32
    inner: Node.take
} out Node is {
    retCal: mkAtom :ast :line :col name: "return"
    retArg: mkBareOp :ast :line :col op: inner
    retArgs: (ListVal u32)
    retArgs.append (zast.tableAdd :ast n: retArg)
    retCall: (Node.call (zast.CallData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        callable: (zast.tableAdd :ast n: retCal)
        arguments: retArgs)
    )
    retExpr: (Node.expression (zast.ExpressionData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        expression: (zast.tableAdd :ast n: retCall))
    )
    sline: (Node.statementline (zast.StatementLineData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        statementline: (zast.tableAdd :ast n: retExpr))
    )
    slist: (ListVal u32)
    slist.append (zast.tableAdd :ast n: sline)
    return (Node.statement (zast.StatementData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        statements: slist)
    )
}

# buildCreateMethod -- `create: function {<param-clones>} out this is {
# return (meta.create state: 0 p1: :p1 ...) }`: captured parameters
# forward by label-value shorthand; promoted locals are reserved fields
# the body's first write initialises.
buildCreateMethod: function {
    ast: Ast.view
    line: u32
    col: u32
    params: (ListVal u32).take
    fwdNames: (List String).view
} out Node is {
    metaAtom: mkAtom :ast :line :col name: "meta"
    createAtom: mkAtom :ast :line :col name: "create"
    metaCreate: (Node.dottedpath (zast.DottedPathData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        parent: (zast.tableAdd :ast n: metaAtom)
        child: (zast.tableAdd :ast n: createAtom))
    )
    zeroAtom: mkAtom :ast :line :col name: "0"
    stArg: mkNamedOp :ast :line :col name: "state" op: zeroAtom
    cargs: (ListVal u32)
    cargs.append (zast.tableAdd :ast n: stArg)
    fi: u64
    fn: fwdNames.length
    for fi < fn loop {
        f0: fwdNames.get i: fi
        f0v: f0.stringview
        lv0: (Node.labelvalue (zast.LabelValueData
            nodeid: (zast.tableReserve :ast)
            lineno: line
            colno: col
            name: (internSynthName :ast text: f0v))
        )
        fa0: mkNamedOp :ast :line :col name: f0v op: lv0
        cargs.append (zast.tableAdd :ast n: fa0)
        fi = fi + 1
    }
    icall: (Node.call (zast.CallData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        callable: (zast.tableAdd :ast n: metaCreate)
        arguments: cargs)
    )
    body: mkReturnBody :ast :line :col inner: icall
    # `out this.takex`, not a bare `this`: the synth class captures its
    # parameters, and a captured NON-OWNED one is a reference into the caller
    # that has to stay pinned for the iterator's lifetime. When nothing
    # non-owned is captured the marker pins nothing and costs nothing.
    thisRet: mkAtom :ast :line :col name: "this"
    takexRet: mkAtom :ast :line :col name: "takex"
    thisRetPath: (Node.dottedpath (zast.DottedPathData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        parent: (zast.tableAdd :ast n: thisRet)
        child: (zast.tableAdd :ast n: takexRet))
    )
    thisRetId: zast.tableAdd :ast n: thisRetPath
    return (Node.functiondef (zast.FunctionData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        returntype: thisRetId
        parameters: params
        body: (zast.tableAdd :ast n: body)
        isNative: false
        asItems: (ListVal u32))
    )
}

# buildCallMethod -- the iterator protocol implementation: `call: function
# {this: this} out (<wrapper> t: <gives>) is <original body>`. Yields stay
# in place; promoted-name rewriting lands with the parameterized examples.
buildCallMethod: function {
    ast: Ast.view
    line: u32
    col: u32
    body: Node.take
    wrapExprId: zast.nodeid
    valueParam: (Option Node).take
} out Node is {
    thisP: mkAtom :ast :line :col name: "this"
    thisParam: mkNamedOp :ast :line :col name: "this" op: thisP
    params: (ListVal u32)
    params.append (zast.tableAdd :ast n: thisParam)
    vp: valueParam.take
    match (
        vp
    ) case some then {
        vparam: mkNamedOp :ast :line :col name: "value" op: vp.take
        params.append (zast.tableAdd :ast n: vparam)
    } case none then null
    return (Node.functiondef (zast.FunctionData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        returntype: wrapExprId
        parameters: params
        body: (zast.tableAdd :ast n: body)
        isNative: false
        asItems: (ListVal u32))
    )
}

# buildWrapper -- the synth `.call` return `(Option|OptionView t: <base>)`;
# leaf "take" selects Option, anything else OptionView.
buildWrapper: function {
    ast: Ast.view
    line: u32
    col: u32
    base: Node.take
    leaf: StringView
} out Node is {
    wn: "OptionView"
    if leaf == "take" then wn = "Option"
    wAtom: mkAtom :ast :line :col name: wn
    tArg: mkNamedOp :ast :line :col name: "t" op: base
    wargs: (ListVal u32)
    wargs.append (zast.tableAdd :ast n: tArg)
    return (Node.call (zast.CallData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        callable: (zast.tableAdd :ast n: wAtom)
        arguments: wargs)
    )
}

# buildFactory -- the replacement for the original function: return type =
# the synth class, body = `return (<synth_name> p1: p1 ...)` forwarding
# each captured parameter by name.
buildFactory: function {
    ast: Ast.view
    line: u32
    col: u32
    synthName: StringView
    params: (ListVal u32).take
    fwdNames: (List String).view
    privNames: (MapRV String value: bool)
} out Node is {
    synthAtom: mkAtom :ast :line :col name: synthName
    fargs: (ListVal u32)
    fi: u64
    fn: fwdNames.length
    for fi < fn loop {
        f0: fwdNames.get i: fi
        f0v: f0.stringview
        va0: mkAtom :ast :line :col name: f0v
        # a private-lock receiver forwards through `.private`: the synth
        # class's field needs friend access, while the factory's own
        # public `this.lock` parameter stays callable from outside.
        f0o: f0v
        isPriv: boolOrDefault o: (privNames.get key: f0o.asString) d: false
        if isPriv then {
            pa0: mkAtom :ast :line :col name: "private"
            vp0: (Node.dottedpath (zast.DottedPathData
                nodeid: (zast.tableReserve :ast)
                lineno: line
                colno: col
                parent: (zast.tableAdd :ast n: va0)
                child: (zast.tableAdd :ast n: pa0))
            )
            fa1: mkNamedOp :ast :line :col name: f0v op: vp0
            fargs.append (zast.tableAdd :ast n: fa1)
        } else {
            fa0: mkNamedOp :ast :line :col name: f0v op: va0
            fargs.append (zast.tableAdd :ast n: fa0)
        }
        fi = fi + 1
    }
    icall: (Node.call (zast.CallData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        callable: (zast.tableAdd :ast n: synthAtom)
        arguments: fargs)
    )
    body: mkReturnBody :ast :line :col inner: icall
    retAtom: mkAtom :ast :line :col name: synthName
    retAtomId: zast.tableAdd :ast n: retAtom
    return (Node.functiondef (zast.FunctionData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        returntype: retAtomId
        parameters: params
        body: (zast.tableAdd :ast n: body)
        isNative: false
        asItems: (ListVal u32))
    )
}

# isYieldValue -- the assignment RHS is a yield expression (through
# expression wrappers): the expression-form `name: yield E`.
isYieldValue: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (isYieldValue :ast n: (ast.nodes.get i: n.expression.u64))
    } case yieldexpr then {
        return true
    } else {
        return false
    }
}

# GenCross -- the crossing-locals walk state: yields passed so far, each
# local's first-definition yield count, its maximum-use yield count, and
# whether any reference sits inside a yielding loop (next iteration
# resumes past the suspension, so reuse crosses implicitly).
GenCross: class {
    yieldCount: u64
    firstDef: (MapRV String value: u64)
    maxUse: (MapRV String value: u64)
    inLoop: (MapRV String value: bool)
    params: (MapRV String value: bool)
    # `name: yield E` resume-input bindings: per-call borrowed aliases into
    # the caller's storage -- NEVER promoted (a stored pointer would dangle
    # across calls; the liveness rule already confines each to one window).
    yieldBound: (MapRV String value: bool)
}

# recurse a node, recording locals that cross a yield-loop boundary.
crossWalk: function {ast: Ast gc: GenCross n: Node.view inYieldLoop: bool} is {
    match (
        n
    ) case functiondef then null case yieldexpr then {
        crossWalk :ast :gc n: (ast.nodes.get i: n.expr.u64) :inYieldLoop
        gc.yieldCount = gc.yieldCount + 1
    } case assignment then {
        av: ast.nodes.get i: n.value.u64
        crossWalk :ast :gc n: av :inYieldLoop
        anvC: zast.poolTextAt pool: ast.names ref: n.name
        anv: anvC.stringview
        if (isYieldValue :ast n: av) then {
            ybk: anv.string
            ybv: true
            gc.yieldBound.set key: ybk value: ybv
        }
        isP: boolOrDefault o: (gc.params.get key: anv.string) d: false
        if (isP) == false then {
            seen: u64OrDefault o: (gc.firstDef.get key: anv.string) d: 18446744073709551615.u64
            if seen == 18446744073709551615.u64 then {
                dk: anv.string
                dv: gc.yieldCount
                gc.firstDef.set key: dk value: dv
            }
            if inYieldLoop then {
                lk: anv.string
                lv: true
                gc.inLoop.set key: lk value: lv
            }
        }
    } case atomid then {
        unvC: zast.nameTextAt :ast ref: n.name
        unv: unvC.stringview
        seen2: u64OrDefault o: (gc.firstDef.get key: unv.string) d: 18446744073709551615.u64
        if seen2 != 18446744073709551615.u64 then {
            uk: unv.string
            uv: gc.yieldCount
            prev: u64OrDefault o: (gc.maxUse.get key: unv.string) d: 0
            if uv > prev then {
                gc.maxUse.set key: uk value: uv
            }
            if inYieldLoop then {
                lk2: unv.string
                lv2: true
                gc.inLoop.set key: lk2 value: lv2
            }
        }
    } case forexpr then {
        bodyYields: bodyContainsYieldOptAt :ast oId: n.body
        sub: inYieldLoop
        if bodyYields then sub = true
        fiter: n.conditions.iterate
        for f0: fiter loop {
            crossWalk :ast :gc n: (ast.nodes.get i: f0.u64) inYieldLoop: sub
        }
        if n.body > 0 then {
            fcb: ast.nodes.get i: n.body.u64
            crossWalk :ast :gc n: fcb inYieldLoop: sub
        }
        piter: n.postconditions.iterate
        for p0: piter loop {
            crossWalk :ast :gc n: (ast.nodes.get i: p0.u64) inYieldLoop: sub
        }
    } case caseclause then {
        # the arm pattern is not a use of a local
        crossWalk :ast :gc n: (ast.nodes.get i: n.statement.u64) :inYieldLoop
    } case call then {
        # the callee name is not a use of a local
        crossWalkIds :ast :gc ids: n.arguments :inYieldLoop
    } case binop then {
        # the operator atom is not a use of a local
        crossWalk :ast :gc n: (ast.nodes.get i: n.lhs.u64) :inYieldLoop
        crossWalk :ast :gc n: (ast.nodes.get i: n.rhs.u64) :inYieldLoop
    } case dottedpath then {
        # a member selector is not a use of a local
        crossWalk :ast :gc n: (ast.nodes.get i: n.parent.u64) :inYieldLoop
    } else {
        crossWalkIds :ast :gc ids: (zast.childIds :ast :n) :inYieldLoop
    }
}

crossWalkIds: function {ast: Ast gc: GenCross ids: (ListVal u32).view inYieldLoop: bool} is {
    with it: ids.iterate do for c: it loop {
        crossWalk :ast :gc n: (ast.nodes.get i: c.u64) :inYieldLoop
    }
}

# crossWalk over an optional node.
crossWalkOpt: function {ast: Ast.view gc: GenCross o: Option Node inYieldLoop: bool} is {
    match (
        o
    ) case some then {
        crossWalk :ast :gc n: o :inYieldLoop
    } case none then null
}

# the value of optional `o`, or `d` when none.
u64OrDefault: function {o: optionval u64 d: u64} out u64 is {
    match (
        o
    ) case some then {
        return o
    } case none then {
        return d
    }
}

# the value of optional bool `o`, or `d` when none.
boolOrDefault: function {o: optionval bool d: bool} out bool is {
    match (
        o
    ) case some then {
        return o
    } case none then {
        return d
    }
}

# crossingLocals -- EVERY generator-body local promotes: a resumable body
# has no persistent stack frame, so a local surviving to any later flush
# (scope exit, fn exit) would free garbage on a fresh frame. Fields live on
# the instance; the synth class's auto-destructor owns their cleanup.
# (Historically only yield-crossing/looped locals promoted -- the
# non-crossing remainder was the fresh-frame free family.)
crossingLocals: function {gc: GenCross dst: List String} is {
    with kit: gc.firstDef.iterate do for k0: kit loop {
        kv0: k0.stringview
        yb0: boolOrDefault o: (gc.yieldBound.get key: kv0.string) d: false
        if (yb0) == false then {
            kc0: kv0.string
            dst.append kc0
        }
    }
}

# firstRhsOf -- the first `name: <rhs>` assignment's INNER rhs (a clone),
# feeding the promoted local's typeof field.
firstRhsOf: function {
    ast: Ast.view
    n: Node.view
    name: StringView
    dst: GivesParts
} is {
    match (
        n
    ) case functiondef then null case assignment then {
        already: false
        match (
            dst.base
        ) case some then {
            already = true
        } case none then null
        if (already) == false then {
            if (zast.nameTextEq :ast ref: n.name s: name) then {
                rc: cloneInner :ast n: (ast.nodes.get i: n.value.u64)
                dst.base = (Option.some rc)
            }
        }
    } case statement then {
        siter: n.statements.iterate
        for s0Id: siter loop {
            firstRhsOf :ast n: (ast.nodes.get i: s0Id.u64) :name :dst
        }
    } case statementline then {
        firstRhsOf :ast n: (ast.nodes.get i: n.statementline.u64) :name :dst
    } case expression then {
        firstRhsOf :ast n: (ast.nodes.get i: n.expression.u64) :name :dst
    } case ifexpr then {
        cliter: n.clauses.iterate
        for cl0Id: cliter loop {
            firstRhsOf :ast n: (ast.nodes.get i: cl0Id.u64) :name :dst
        }
        if n.elseclause > 0 then {
            ec: ast.nodes.get i: n.elseclause.u64
            firstRhsOf :ast n: ec :name :dst
        }
    } case ifclause then {
        firstRhsOf :ast n: (ast.nodes.get i: n.statement.u64) :name :dst
    } case forexpr then {
        if n.body > 0 then {
            fb: ast.nodes.get i: n.body.u64
            firstRhsOf :ast n: fb :name :dst
        }
    } case doexpr then {
        firstRhsOf :ast n: (ast.nodes.get i: n.statement.u64) :name :dst
    } case withexpr then {
        firstRhsOf :ast n: (ast.nodes.get i: n.body.u64) :name :dst
    } case caseexpr then {
        mliter: n.clauses.iterate
        for m0: mliter loop {
            firstRhsOf :ast n: (ast.nodes.get i: m0.u64) :name :dst
        }
        if n.elseclause > 0 then {
            elseclauseNode: ast.nodes.get i: n.elseclause.u64
            firstRhsOf :ast n: elseclauseNode :name :dst
        }
    } case caseclause then {
        firstRhsOf :ast n: (ast.nodes.get i: n.statement.u64) :name :dst
    } else null
}

# the first right-hand-side node under an optional node (for promotion).
firstRhsOfOpt: function {
    ast: Ast.view
    o: Option Node
    name: StringView
    dst: GivesParts
} is {
    match (
        o
    ) case some then {
        firstRhsOf :ast n: o :name :dst
    } case none then null
}

# cloneInner -- clone the inside of an expression wrapper (the typeof
# field embeds the bare operation).
cloneInner: function {ast: Ast.view n: Node.view} out Node is {
    match (
        n
    ) case expression then {
        return (cloneInner :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        return (clonePath :ast :n)
    }
}

# promoteIterables -- clone the body, and for each top-level `for` whose
# loop body suspends, hoist every non-trivial named iterable into a
# synthetic `_iterN: <expr>` binding before the loop (the loop references
# `_iterN`). Without this, the iterable would be a C-stack local that
# does not survive a suspension; the synthetic local is visible to the
# crossing analysis (the yielding-loop rule promotes it) and to the
# typeof field machinery. Recurses into for bodies only.
promoteIterables: function {ast: Ast.view ctr: NameCtr n: Node.view} out Node is {
    match (
        n
    ) case statement then {
        lnP: n.lineno
        coP: n.colno
        newLines: (ListVal u32)
        siter: n.statements.iterate
        for s0Id: siter loop {
            promoteLine :ast :ctr n: (ast.nodes.get i: s0Id.u64) dst: newLines
        }
        return (Node.statement (zast.StatementData
            nodeid: (zast.tableReserve :ast)
            lineno: lnP
            colno: coP
            statements: newLines)
        )
    } else {
        return (clonePath :ast :n)
    }
}

# promoteIterablesOptAt -- the id-taking entry (0 = absent); the promoted
# clone comes back owned.
promoteIterablesOptAt: function {
    ast: Ast.view
    ctr: NameCtr
    oId: zast.nodeid
} out Option Node is {
    if oId.isZero then return (Option.none Node)
    b: ast.nodes.get i: oId.u64
    r: promoteIterables :ast :ctr n: b
    return (Option.some r)
}

# promoteIterablesIdAt -- promote and intern a loop body (0 = absent).
promoteIterablesIdAt: function {
    ast: Ast.view
    ctr: NameCtr
    oId: zast.nodeid
} out u32 is {
    if oId.isZero then return 0
    b: ast.nodes.get i: oId.u64
    r: promoteIterables :ast :ctr n: b
    return (zast.tableAdd :ast n: r)
}

# promoteLine -- one statement line: a for-statement transforms (possibly
# appending synthetic bindings first); anything else passes through as a
# rewrite-clone (the rewrite with no promotions is a faithful deep copy).
promoteLine: function {ast: Ast.view ctr: NameCtr n: Node.view dst: ListVal u32} is {
    isFor: false
    match (
        n
    ) case statementline then {
        inner: ast.nodes.get i: n.statementline.u64
        isFor = lineIsFor :ast n: inner
    } else null
    if isFor then {
        match (
            n
        ) case statementline then {
            lnQ: n.lineno
            coQ: n.colno
            ni: promoteInExpr :ast :ctr n: (ast.nodes.get i: n.statementline.u64) :dst
            nl: (Node.statementline (zast.StatementLineData
                nodeid: (zast.tableReserve :ast)
                lineno: lnQ
                colno: coQ
                statementline: (zast.tableAdd :ast n: ni))
            )
            dst.append (zast.tableAdd :ast n: nl)
        } else null
    } else {
        empty: (MapRV String value: bool)
        nc: rewriteToThis :ast :n promoted: empty
        dst.append (zast.tableAdd :ast n: nc)
    }
}

# true when node `n` is a for-statement line.
lineIsFor: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (lineIsFor :ast n: (ast.nodes.get i: n.expression.u64))
    } case forexpr then {
        return true
    } else {
        return false
    }
}

# promote yield-crossing locals to state fields within an expression.
promoteInExpr: function {
    ast: Ast.view
    ctr: NameCtr
    n: Node.view
    dst: (ListVal u32).view
} out Node is {
    match (
        n
    ) case expression then {
        lnR: n.lineno
        coR: n.colno
        ni: promoteInExpr :ast :ctr n: (ast.nodes.get i: n.expression.u64) :dst
        return (Node.expression (zast.ExpressionData
            nodeid: (zast.tableReserve :ast)
            lineno: lnR
            colno: coR
            expression: (zast.tableAdd :ast n: ni))
        )
    } else {
        return (promoteFor :ast :ctr :n :dst)
    }
}

# promote yield-crossing locals across a for-loop boundary.
promoteFor: function {
    ast: Ast
    ctr: NameCtr
    n: Node.view
    dst: ListVal u32
} out Node is {
    match (
        n
    ) case forexpr then {
        lnS: n.lineno
        coS: n.colno
        # recurse into the loop body first (nested suspending fors)
        nbodyId: promoteIterablesIdAt :ast :ctr oId: n.body
        suspends: false
        if nbodyId > 0 then {
            nb: ast.nodes.get i: nbodyId.u64
            suspends = bodyContainsYield :ast n: nb
        }
        nconds: (ListVal u32)
        citer: n.conditions.iterate
        for c0Id: citer loop {
            c0: ast.nodes.get i: c0Id.u64
            doHoist: false
            match (
                c0
            ) case namedoperation then {
                cn0: zast.nameTextAt :ast ref: c0.name
                if cn0.length > 0 when suspends then {
                    if (condIsTrivial
                        :ast
                        n: (ast.nodes.get i: c0.operation.u64)
                    ) == false then doHoist = true
                }
            } else null
            if doHoist then {
                match (
                    c0
                ) case namedoperation then {
                    # synth nodes carry the ITERABLE's source position
                    hp0: zast.posOf n: (ast.nodes.get i: c0.operation.u64)
                    hl0: hp0.line
                    hc0: hp0.col
                    synthN: "_iter\{ctr.bump}"
                    empty7: (MapRV String value: bool)
                    rhs0: (rewriteToThis
                        :ast
                        n: (ast.nodes.get i: c0.operation.u64)
                        promoted: empty7
                    )
                    rhsE: ensureExpr :ast line: hl0 col: hc0 n: rhs0
                    snv0: synthN.stringview
                    snid0: zast.poolSet pool: ast.names text: snv0
                    sno1: snv0
                    sa0: (Node.assignment (zast.AssignmentData
                        nodeid: (zast.tableReserve :ast)
                        lineno: hl0
                        colno: hc0
                        name: snid0
                        value: (zast.tableAdd :ast n: rhsE))
                    )
                    sl0: (Node.statementline (zast.StatementLineData
                        nodeid: (zast.tableReserve :ast)
                        lineno: hl0
                        colno: hc0
                        statementline: (zast.tableAdd :ast n: sa0))
                    )
                    dst.append (zast.tableAdd :ast n: sl0)
                    cn1: zast.nameTextAt :ast ref: c0.name
                    na0: mkAtom :ast line: hl0 col: hc0 name: sno1
                    nc0: mkNamedOp :ast line: hl0 col: hc0 name: cn1.stringview op: na0
                    nconds.append (zast.tableAdd :ast n: nc0)
                } else null
            } else {
                empty6: (MapRV String value: bool)
                cc0: rewriteToThis :ast n: c0 promoted: empty6
                nconds.append (zast.tableAdd :ast n: cc0)
            }
        }
        nposts: (ListVal u32)
        piter: n.postconditions.iterate
        for p0Id: piter loop {
            empty5: (MapRV String value: bool)
            pp0: rewriteToThis :ast n: (ast.nodes.get i: p0Id.u64) promoted: empty5
            nposts.append (zast.tableAdd :ast n: pp0)
        }
        return (Node.forexpr (zast.ForData
            nodeid: (zast.tableReserve :ast)
            lineno: lnS
            colno: coS
            conditions: nconds
            body: (zast.nodeid.create from: nbodyId)
            postconditions: nposts)
        )
    } else {
        empty4: (MapRV String value: bool)
        return (rewriteToThis :ast :n promoted: empty4)
    }
}

# true when condition `n` is a trivial always-true form.
condIsTrivial: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (condIsTrivial :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return true
    } else {
        return false
    }
}

# wrap a node as an expression node and return its id.
wrapExprNode: function {
    ast: Ast.view
    line: u32
    col: u32
    n: Node.take
} out Node is {
    return (Node.expression (zast.ExpressionData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        expression: (zast.tableAdd :ast :n))
    )
}

# true when `n` is an expression-kind node.
isExprNode: function {n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return true
    } else {
        return false
    }
}

# ensureExpr -- wrap in an Expression unless already one.
ensureExpr: function {
    ast: Ast.view
    line: u32
    col: u32
    n: Node.take
} out Node is {
    if (isExprNode :n) then {
        return n
    } else {
        return (wrapExprNode :ast :line :col :n)
    }
}

# rewriteToThis -- deep-clone the body, rewriting every promoted-name
# reference to `this.<name>`: atoms and labelvalues in value position
# become the dotted path, dotted HEADS rewrite (children are field
# labels), and an assignment to a promoted name becomes a reassignment
# through `this` (the field was reserved at create time).
rewriteToThis: function {
    ast: Ast
    n: Node.view
    promoted: (MapRV String value: bool)
} out Node is {
    match (
        n
    ) case atomid then {
        ln0: n.lineno
        co0: n.colno
        anvC: zast.nameTextAt :ast ref: n.name
        anv: anvC.stringview
        isP: boolOrDefault o: (promoted.get key: anv.string) d: false
        if isP then {
            return (mkThisDotted :ast line: ln0 col: co0 name: anv)
        } else {
            return (Node.atomid (zast.AtomIdData
                nodeid: (zast.tableReserve :ast)
                lineno: ln0
                colno: co0
                name: n.name)
            )
        }
    } case labelvalue then {
        ln1: n.lineno
        co1: n.colno
        lnvC: zast.nameTextAt :ast ref: n.name
        lnv: lnvC.stringview
        isP1: boolOrDefault o: (promoted.get key: lnv.string) d: false
        if isP1 then {
            return (mkThisDotted :ast line: ln1 col: co1 name: lnv)
        } else {
            return (Node.labelvalue (zast.LabelValueData
                nodeid: (zast.tableReserve :ast)
                lineno: ln1
                colno: co1
                name: n.name)
            )
        }
    } case dottedpath then {
        ln2: n.lineno
        co2: n.colno
        np: rewriteToThis :ast n: (ast.nodes.get i: n.parent.u64) :promoted
        nc: clonePath :ast n: (ast.nodes.get i: n.child.u64)
        return (Node.dottedpath (zast.DottedPathData
            nodeid: (zast.tableReserve :ast)
            lineno: ln2
            colno: co2
            parent: (zast.tableAdd :ast n: np)
            child: (zast.tableAdd :ast n: nc))
        )
    } case expression then {
        ln3: n.lineno
        co3: n.colno
        ne: rewriteToThis :ast n: (ast.nodes.get i: n.expression.u64) :promoted
        return (Node.expression (zast.ExpressionData
            nodeid: (zast.tableReserve :ast)
            lineno: ln3
            colno: co3
            expression: (zast.tableAdd :ast n: ne))
        )
    } case call then {
        ln4: n.lineno
        co4: n.colno
        ncal: rewriteToThis :ast n: (ast.nodes.get i: n.callable.u64) :promoted
        nargs: (ListVal u32)
        aiter: n.arguments.iterate
        for a0Id: aiter loop {
            na0: rewriteToThis :ast n: (ast.nodes.get i: a0Id.u64) :promoted
            nargs.append (zast.tableAdd :ast n: na0)
        }
        return (Node.call (zast.CallData
            nodeid: (zast.tableReserve :ast)
            lineno: ln4
            colno: co4
            callable: (zast.tableAdd :ast n: ncal)
            arguments: nargs)
        )
    } case namedoperation then {
        ln5: n.lineno
        co5: n.colno
        nop: rewriteToThis :ast n: (ast.nodes.get i: n.operation.u64) :promoted
        nnm: n.name
        return (Node.namedoperation (zast.NamedOperationData
            nodeid: (zast.tableReserve :ast)
            lineno: ln5
            colno: co5
            name: nnm
            operation: (zast.tableAdd :ast n: nop))
        )
    } case binop then {
        ln6: n.lineno
        co6: n.colno
        nl6: rewriteToThis :ast n: (ast.nodes.get i: n.lhs.u64) :promoted
        no6: clonePath :ast n: (ast.nodes.get i: n.operator.u64)
        nr6: rewriteToThis :ast n: (ast.nodes.get i: n.rhs.u64) :promoted
        return (Node.binop (zast.BinOpData
            nodeid: (zast.tableReserve :ast)
            lineno: ln6
            colno: co6
            lhs: (zast.tableAdd :ast n: nl6)
            operator: (zast.tableAdd :ast n: no6)
            rhs: (zast.tableAdd :ast n: nr6))
        )
    } case statement then {
        ln7: n.lineno
        co7: n.colno
        nstmts: (ListVal u32)
        siter: n.statements.iterate
        for s0Id: siter loop {
            ns0: rewriteToThis :ast n: (ast.nodes.get i: s0Id.u64) :promoted
            nstmts.append (zast.tableAdd :ast n: ns0)
        }
        return (Node.statement (zast.StatementData
            nodeid: (zast.tableReserve :ast)
            lineno: ln7
            colno: co7
            statements: nstmts)
        )
    } case statementline then {
        ln8: n.lineno
        co8: n.colno
        ni8: rewriteToThis :ast n: (ast.nodes.get i: n.statementline.u64) :promoted
        return (Node.statementline (zast.StatementLineData
            nodeid: (zast.tableReserve :ast)
            lineno: ln8
            colno: co8
            statementline: (zast.tableAdd :ast n: ni8))
        )
    } case assignment then {
        ln9c: n.lineno
        co9c: n.colno
        nval: rewriteToThis :ast n: (ast.nodes.get i: n.value.u64) :promoted
        nvalId: zast.tableAdd :ast n: nval
        anvC: zast.poolTextAt pool: ast.names ref: n.name
        anv: anvC.stringview
        isP: boolOrDefault o: (promoted.get key: anv.string) d: false
        if isP then {
            topath: mkThisDotted :ast line: ln9c col: co9c name: anv
            return (Node.reassignment (zast.ReassignmentData
                nodeid: (zast.tableReserve :ast)
                lineno: ln9c
                colno: co9c
                topath: (zast.tableAdd :ast n: topath)
                value: nvalId)
            )
        } else {
            return (Node.assignment (zast.AssignmentData
                nodeid: (zast.tableReserve :ast)
                lineno: ln9c
                colno: co9c
                name: n.name
                value: nvalId)
            )
        }
    } case reassignment then {
        lnA: n.lineno
        coA: n.colno
        ntp: rewriteToThis :ast n: (ast.nodes.get i: n.topath.u64) :promoted
        nvA: rewriteToThis :ast n: (ast.nodes.get i: n.value.u64) :promoted
        return (Node.reassignment (zast.ReassignmentData
            nodeid: (zast.tableReserve :ast)
            lineno: lnA
            colno: coA
            topath: (zast.tableAdd :ast n: ntp)
            value: (zast.tableAdd :ast n: nvA))
        )
    } case swapstmt then {
        lnB: n.lineno
        coB: n.colno
        nlB: rewriteToThis :ast n: (ast.nodes.get i: n.lhs.u64) :promoted
        nrB: rewriteToThis :ast n: (ast.nodes.get i: n.rhs.u64) :promoted
        return (Node.swapstmt (zast.SwapStmtData
            nodeid: (zast.tableReserve :ast)
            lineno: lnB
            colno: coB
            lhs: (zast.tableAdd :ast n: nlB)
            rhs: (zast.tableAdd :ast n: nrB))
        )
    } case ifexpr then {
        lnC: n.lineno
        coC: n.colno
        ncls: (ListVal u32)
        cliter: n.clauses.iterate
        for cl0Id: cliter loop {
            ncl0: rewriteToThis :ast n: (ast.nodes.get i: cl0Id.u64) :promoted
            ncls.append (zast.tableAdd :ast n: ncl0)
        }
        nels: rewriteOptToThisAt :ast oId: n.elseclause :promoted
        return (Node.ifexpr (zast.IfData
            nodeid: (zast.tableReserve :ast)
            lineno: lnC
            colno: coC
            clauses: ncls
            elseclause: (zast.nodeid.create from: nels))
        )
    } case ifclause then {
        lnD: n.lineno
        coD: n.colno
        nconds: (ListVal u32)
        coiter: n.conditions.iterate
        for c0Id: coiter loop {
            nc0: rewriteToThis :ast n: (ast.nodes.get i: c0Id.u64) :promoted
            nconds.append (zast.tableAdd :ast n: nc0)
        }
        nst: rewriteToThis :ast n: (ast.nodes.get i: n.statement.u64) :promoted
        return (Node.ifclause (zast.IfClauseData
            nodeid: (zast.tableReserve :ast)
            lineno: lnD
            colno: coD
            conditions: nconds
            statement: (zast.tableAdd :ast n: nst))
        )
    } case forexpr then {
        lnE: n.lineno
        coE: n.colno
        nfconds: (ListVal u32)
        fiter: n.conditions.iterate
        for f0Id: fiter loop {
            nf0: rewriteToThis :ast n: (ast.nodes.get i: f0Id.u64) :promoted
            nfconds.append (zast.tableAdd :ast n: nf0)
        }
        nbody: rewriteOptToThisAt :ast oId: n.body :promoted
        nposts: (ListVal u32)
        piter: n.postconditions.iterate
        for p0Id: piter loop {
            np0: rewriteToThis :ast n: (ast.nodes.get i: p0Id.u64) :promoted
            nposts.append (zast.tableAdd :ast n: np0)
        }
        return (Node.forexpr (zast.ForData
            nodeid: (zast.tableReserve :ast)
            lineno: lnE
            colno: coE
            conditions: nfconds
            body: (zast.nodeid.create from: nbody)
            postconditions: nposts)
        )
    } case doexpr then {
        lnF: n.lineno
        coF: n.colno
        nstF: rewriteToThis :ast n: (ast.nodes.get i: n.statement.u64) :promoted
        nstFId: zast.tableAdd :ast n: nstF
        return (Node.doexpr (zast.DoData
            nodeid: (zast.tableReserve :ast)
            lineno: lnF
            colno: coF
            statement: nstFId
        ))
    } case withexpr then {
        lnG: n.lineno
        coG: n.colno
        nvG: rewriteToThis :ast n: (ast.nodes.get i: n.value.u64) :promoted
        nbG: rewriteToThis :ast n: (ast.nodes.get i: n.body.u64) :promoted
        return (Node.withexpr (zast.WithData
            nodeid: (zast.tableReserve :ast)
            lineno: lnG
            colno: coG
            name: n.name
            value: (zast.tableAdd :ast n: nvG)
            body: (zast.tableAdd :ast n: nbG))
        )
    } case caseexpr then {
        lnH: n.lineno
        coH: n.colno
        nsubH: rewriteToThis :ast n: (ast.nodes.get i: n.subject.u64) :promoted
        nclsH: (ListVal u32)
        mliter: n.clauses.iterate
        for m0Id: mliter loop {
            nm0: rewriteToThis :ast n: (ast.nodes.get i: m0Id.u64) :promoted
            nclsH.append (zast.tableAdd :ast n: nm0)
        }
        nelsH: rewriteOptToThisAt :ast oId: n.elseclause :promoted
        return (Node.caseexpr (zast.CaseData
            nodeid: (zast.tableReserve :ast)
            lineno: lnH
            colno: coH
            subject: (zast.tableAdd :ast n: nsubH)
            clauses: nclsH
            elseclause: (zast.nodeid.create from: nelsH))
        )
    } case caseclause then {
        lnI: n.lineno
        coI: n.colno
        nma: clonePath :ast n: (ast.nodes.get i: n.matcharm.u64)
        nstI: rewriteToThis :ast n: (ast.nodes.get i: n.statement.u64) :promoted
        return (Node.caseclause (zast.CaseClauseData
            nodeid: (zast.tableReserve :ast)
            lineno: lnI
            colno: coI
            name: n.name
            matcharm: (zast.tableAdd :ast n: nma)
            statement: (zast.tableAdd :ast n: nstI))
        )
    } case yieldexpr then {
        lnJ: n.lineno
        coJ: n.colno
        nxJ: rewriteToThis :ast n: (ast.nodes.get i: n.expr.u64) :promoted
        return (Node.yieldexpr (zast.YieldExprData
            nodeid: (zast.tableReserve :ast)
            lineno: lnJ
            colno: coJ
            expr: (zast.tableAdd :ast n: nxJ))
        )
    } case atomstring then {
        lnK: n.lineno
        coK: n.colno
        npartsK: (ListVal u32)
        spiter: n.stringparts.iterate
        for sp0Id: spiter loop {
            nsp0: rewriteToThis :ast n: (ast.nodes.get i: sp0Id.u64) :promoted
            npartsK.append (zast.tableAdd :ast n: nsp0)
        }
        return (Node.atomstring (zast.AtomStringData
            nodeid: (zast.tableReserve :ast)
            lineno: lnK
            colno: coK
            stringparts: npartsK)
        )
    } case stringchunk then {
        lnL: n.lineno
        coL: n.colno
        tvL: n.text.stringview
        tcL: tvL.string
        ckL: n.chunkKind
        return (Node.stringchunk (zast.StringChunkData
            nodeid: (zast.tableReserve :ast)
            lineno: lnL
            colno: coL
            text: tcL
            chunkKind: ckL)
        )
    } else {
        return (clonePath :ast :n)
    }
}

# rewriteOptToThisAt -- rewrite a child named by id and intern the result,
# returning its id (0 = absent). The clone's own id is the one it carries.
rewriteOptToThisAt: function {
    ast: Ast.view
    oId: zast.nodeid
    promoted: (MapRV String value: bool)
} out u32 is {
    if oId.isZero then return 0
    o: ast.nodes.get i: oId.u64
    r: rewriteToThis :ast n: o :promoted
    return (zast.tableAdd :ast n: r)
}

# rewrite an optional node's local references to `this.<field>` for the lowered class.
rewriteOptToThis: function {
    ast: Ast.view
    o: Option Node
    promoted: (MapRV String value: bool)
} out Option Node is {
    match (
        o
    ) case some then {
        r: rewriteToThis :ast n: o :promoted
        return (Option.some r)
    } case none then {
        return (Option.none Node)
    }
}

# build a `this.<name>` dotted-path node and return its id.
mkThisDotted: function {
    ast: Ast.view
    line: u32
    col: u32
    name: StringView
} out Node is {
    thisAtom: mkAtom :ast :line :col name: "this"
    childAtom: mkAtom :ast :line :col :name
    return (Node.dottedpath (zast.DottedPathData
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        parent: (zast.tableAdd :ast n: thisAtom)
        child: (zast.tableAdd :ast n: childAtom))
    )
}

# cloneWithThisHead -- clone a type path replacing its `this` head atom
# with the named receiver type (`this.private.lock` -> `Bag.private.lock`).
# The rewritten spine carries the supplied position (the function's start).
cloneWithThisHead: function {
    ast: Ast.view
    n: Node.view
    receiverType: StringView
    line: u32
    col: u32
} out Node is {
    match (
        n
    ) case atomid then {
        if n.name.u32 == zast.wkThis then {
            return (mkAtom :ast :line :col name: receiverType)
        } else {
            return (Node.atomid (zast.AtomIdData
                nodeid: (zast.tableReserve :ast)
                lineno: line
                colno: col
                name: n.name)
            )
        }
    } case labelvalue then {
        if n.name.u32 == zast.wkThis then {
            return (mkAtom :ast :line :col name: receiverType)
        } else {
            return (Node.labelvalue (zast.LabelValueData
                nodeid: (zast.tableReserve :ast)
                lineno: line
                colno: col
                name: n.name)
            )
        }
    } case dottedpath then {
        np: (cloneWithThisHead
            :ast
            n: (ast.nodes.get i: n.parent.u64)
            :receiverType
            :line
            :col
        )
        nc: clonePath :ast n: (ast.nodes.get i: n.child.u64)
        return (Node.dottedpath (zast.DottedPathData
            nodeid: (zast.tableReserve :ast)
            lineno: line
            colno: col
            parent: (zast.tableAdd :ast n: np)
            child: (zast.tableAdd :ast n: nc))
        )
    } case expression then {
        iex: ast.nodes.get i: n.expression.u64
        ne: cloneWithThisHead :ast n: iex :receiverType :line :col
        return (Node.expression (zast.ExpressionData
            nodeid: (zast.tableReserve :ast)
            lineno: line
            colno: col
            expression: (zast.tableAdd :ast n: ne))
        )
    } else {
        return (clonePath :ast :n)
    }
}

# isThisPrivateLock -- the `this.private.lock` friend-access receiver form.
isThisPrivateLock: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case dottedpath then {
        ln: leafAtomName :ast n: (ast.nodes.get i: n.child.u64)
        if (isNonOwnedLeaf name: ln.stringview) then {
            return (isThisPrivate :ast n: (ast.nodes.get i: n.parent.u64))
        } else {
            return false
        }
    } else {
        return false
    }
}

# true when node `n` reads a private `this` member.
isThisPrivate: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case dottedpath then {
        pn: leafAtomName :ast n: (ast.nodes.get i: n.child.u64)
        if pn.stringview == "private" then {
            return (pathHeadIsThis :ast n: (ast.nodes.get i: n.parent.u64))
        } else {
            return false
        }
    } else {
        return false
    }
}

# paramFieldPath -- the synth class's field type for one captured
# parameter: a take-leaf strips (fields hold owned values), lock keeps
# its suffix, bare passes through. Receiver (`this`-headed) params
# capture as receiver-type lock fields.
paramFieldPath: function {
    ast: Ast.view
    n: Node.view
    receiverType: StringView
} out Node is {
    if receiverType.length > 0 then {
        if (pathHeadIsThis :ast :n) then {
            fp0: zast.posOf :n
            fl0: fp0.line
            fc0: fp0.col
            return (cloneWithThisHead :ast :n :receiverType line: fl0 col: fc0)
        }
    }
    lf: pathLeafName :ast :n
    if lf.stringview == "take" then {
        match (
            n
        ) case dottedpath then {
            return (clonePath :ast n: (ast.nodes.get i: n.parent.u64))
        } else {
            return (clonePath :ast :n)
        }
    } else {
        return (clonePath :ast :n)
    }
}

# cloneCreateParam -- the synth create's parameter: a clone with any
# `this` head rewritten to the receiver type (inside the synth class,
# `this` is the iterator, not the original receiver).
cloneCreateParam: function {
    ast: Ast.view
    n: Node.view
    receiverType: StringView
    fnLine: u32
    fnCol: u32
} out Node is {
    match (
        n
    ) case namedoperation then {
        ln0: n.lineno
        co0: n.colno
        nnm: n.name
        isTh0: false
        if receiverType.length > 0 then {
            nOpNode: ast.nodes.get i: n.operation.u64
            isTh0 = pathHeadIsThis :ast n: nOpNode
        }
        if isTh0 then {
            nop1: (cloneWithThisHead
                :ast
                n: (ast.nodes.get i: n.operation.u64)
                :receiverType
                line: fnLine
                col: fnCol
            )
            return (Node.namedoperation (zast.NamedOperationData
                nodeid: (zast.tableReserve :ast)
                lineno: ln0
                colno: co0
                name: nnm
                operation: (zast.tableAdd :ast n: nop1))
            )
        } else {
            nop: clonePath :ast n: (ast.nodes.get i: n.operation.u64)
            return (Node.namedoperation (zast.NamedOperationData
                nodeid: (zast.tableReserve :ast)
                lineno: ln0
                colno: co0
                name: nnm
                operation: (zast.tableAdd :ast n: nop))
            )
        }
    } else {
        return (clonePath :ast :n)
    }
}

# cloneFactoryParam -- the factory's parameter: `this.private.lock`
# exposes publicly as `this.lock` (the body projects `.private` when
# forwarding); everything else clones as-is.
cloneFactoryParam: function {
    ast: Ast.view
    n: Node.view
    fnLine: u32
    fnCol: u32
} out Node is {
    match (
        n
    ) case namedoperation then {
        ln0: n.lineno
        co0: n.colno
        nnm: n.name
        if (isThisPrivateLock :ast n: (ast.nodes.get i: n.operation.u64)) then {
            # the public this.lock replacement carries the function's start
            ta0: mkAtom :ast line: fnLine col: fnCol name: "this"
            la0: mkAtom :ast line: fnLine col: fnCol name: "borrow"
            nop2: (Node.dottedpath (zast.DottedPathData
                nodeid: (zast.tableReserve :ast)
                lineno: fnLine
                colno: fnCol
                parent: (zast.tableAdd :ast n: ta0)
                child: (zast.tableAdd :ast n: la0))
            )
            return (Node.namedoperation (zast.NamedOperationData
                nodeid: (zast.tableReserve :ast)
                lineno: ln0
                colno: co0
                name: nnm
                operation: (zast.tableAdd :ast n: nop2))
            )
        } else {
            nop: clonePath :ast n: (ast.nodes.get i: n.operation.u64)
            return (Node.namedoperation (zast.NamedOperationData
                nodeid: (zast.tableReserve :ast)
                lineno: ln0
                colno: co0
                name: nnm
                operation: (zast.tableAdd :ast n: nop))
            )
        }
    } else {
        return (clonePath :ast :n)
    }
}

# canLowerNow -- pre-surgery shape gate on the borrowed definition: a
# parenthesized gives, a real body, and no receiver (`this`-headed)
# parameter types (method generators are not lowered).
canLowerNow: function {ast: Ast.view n: Node.view hasReceiver: bool} out bool is {
    match (
        n
    ) case functiondef then {
        piter: n.parameters.iterate
        for p0Id: piter loop {
            p0: ast.nodes.get i: p0Id.u64
            if (paramHeadIsThis :ast n: p0) then {
                if hasReceiver then {
                    if (paramIsThisLock :ast n: p0) == false then return false
                } else {
                    return false
                }
            }
        }
        hd: returnHeadOpt :ast oId: n.returntype
        if hd.length == 0 then return false

        return n.body > 0
    } else {
        return false
    }
}

# true when parameter `n`'s path head is `this`.
paramHeadIsThis: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case namedoperation then {
        return (pathHeadIsThis :ast n: (ast.nodes.get i: n.operation.u64))
    } else {
        return false
    }
}

# paramIsThisLock -- the receiver parameter forms a generator method may
# carry: `this.lock` or `this.private.lock`.
paramIsThisLock: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case namedoperation then {
        lf: pathLeafName :ast n: (ast.nodes.get i: n.operation.u64)
        if (isNonOwnedLeaf name: lf.stringview) then {
            return true
        } else {
            return false
        }
    } else {
        return false
    }
}

# true when path `n`'s head is `this`.
pathHeadIsThis: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case atomid then {
        return n.name.u32 == zast.wkThis
    } case labelvalue then {
        return n.name.u32 == zast.wkThis
    } case dottedpath then {
        return (pathHeadIsThis :ast n: (ast.nodes.get i: n.parent.u64))
    } case expression then {
        return (pathHeadIsThis :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        return false
    }
}

# lowerOne -- lower one generator: collect the captured parameters and
# yield-crossing locals, deep-clone the body with promoted names
# rewritten through `this`, and assemble the synth class (state +
# captured fields + create + call) plus the forwarding factory.
lowerOne: function {
    ast: Ast.view
    fn: Node.take
    synthName: StringView
    receiverType: StringView
} out Option GenLowered is {
    gp: givesParts :ast n: fn
    match (
        fn
    ) case functiondef then {
        line: fn.lineno
        col: fn.colno
        gbase: gp.base.take
        match (
            gbase
        ) case some then {
            wrapper: buildWrapper :ast :line :col base: gbase.take leaf: gp.leaf.stringview
            # the EXPRESSION wrapper keys the valtype collapse the
            # typechecker applies to the `.call` return, and interning is
            # what settles its id -- so key on what it carries afterwards
            wrapExpr: (Node.expression (zast.ExpressionData
                nodeid: (zast.tableReserve :ast)
                lineno: line
                colno: col
                expression: (zast.tableAdd :ast n: wrapper))
            )
            wid: zast.tableAdd :ast n: wrapExpr
            # captured parameters: names, field paths, create/factory clones
            pNames: (List String)
            pFields: (List Node)
            createParams: (ListVal u32)
            factoryParams: (ListVal u32)
            noStamp: (ListVal u32)
            thisFlags: (ListVal bool)
            privNames: (MapRV String value: bool)
            piter: fn.parameters.iterate
            for p0Id: piter loop {
                p0: ast.nodes.get i: p0Id.u64
                cp0: cloneCreateParam :ast n: p0 :receiverType fnLine: line fnCol: col
                isThP: paramHeadIsThis :ast n: p0
                cpid0: paramOpId :ast n: cp0
                if cpid0 > 0 when isThP then {} else {
                    if cpid0 > 0 then noStamp.append cpid0
                }
                fp0: cloneFactoryParam :ast n: p0 fnLine: line fnCol: col
                match (
                    p0
                ) case namedoperation then {
                    pn0: zast.nameTextCopy :ast ref: p0.name
                    if pn0.length > 0 then {
                        if (isThisPrivateLock
                            :ast
                            n: (ast.nodes.get i: p0.operation.u64)
                        ) then {
                            pnv1: pn0.stringview
                            pk1: pnv1.string
                            pv1: true
                            privNames.set key: pk1 value: pv1
                        }
                        pf0: (paramFieldPath
                            :ast
                            n: (ast.nodes.get i: p0.operation.u64)
                            :receiverType
                        )
                        pFields.append pf0
                        createParams.append (zast.tableAdd :ast n: cp0)
                        factoryParams.append (zast.tableAdd :ast n: fp0)
                        pNames.append pn0
                        tf0: isThP
                        thisFlags.append tf0
                    }
                } else null
            }
            # the suspending-iterable promotion runs first; the analyses and
            # the this-rewrite read the promoted body.
            ictr: (NameCtr next: 0)
            pBody: promoteIterablesOptAt :ast ctr: ictr oId: fn.body
            # promoted = parameters + yield-crossing locals
            gc: (GenCross
                yieldCount: 0
                firstDef: (MapRV String value: u64)
                maxUse: (MapRV String value: u64)
                inLoop: (MapRV String value: bool)
                params: (MapRV String value: bool)
                yieldBound: (MapRV String value: bool)
            )
            gi: u64
            gn: pNames.length
            for gi < gn loop {
                g0: pNames.get i: gi
                g0v: g0.stringview
                gk0: g0v.string
                gv0: true
                gc.params.set key: gk0 value: gv0
                gi = gi + 1
            }
            crossWalkOpt :ast :gc o: pBody inYieldLoop: false
            crossing: (List String)
            crossingLocals :gc dst: crossing
            promoted: (MapRV String value: bool)
            pi2: u64
            pn2: pNames.length
            for pi2 < pn2 loop {
                pe2: pNames.get i: pi2
                pe2v: pe2.stringview
                pk2: pe2v.string
                pv2: true
                promoted.set key: pk2 value: pv2
                pi2 = pi2 + 1
            }
            ci2: u64
            cn2: crossing.length
            for ci2 < cn2 loop {
                ce2: crossing.get i: ci2
                ce2v: ce2.stringview
                ck2: ce2v.string
                cv2: true
                promoted.set key: ck2 value: cv2
                ci2 = ci2 + 1
            }
            # the call body: a deep clone with promoted names through `this`
            newBodyOpt: rewriteOptToThis :ast o: pBody :promoted
            match (
                newBodyOpt
            ) case some then {
                # bidirectional: the accepts path becomes the call's value
                # parameter; the _resume_input field stores the most recent
                # resumed value (take strips to an owned field, lock keeps,
                # bare/borrow wraps in .lock).
                valueParam: (Option.none Node)
                resumeField: (Option.none Node)
                rfRootStamp: false
                acc: gp.acceptsTy.take
                match (
                    acc
                ) case some then {
                    ap: zast.posOf n: acc
                    al: ap.line
                    ac: ap.col
                    vp0: clonePath :ast n: acc
                    valueParam = (Option.some vp0)
                    alf: pathLeafName :ast n: acc
                    if alf.stringview == "take" then {
                        resumeField = cloneDottedParent :ast n: acc
                        rfb0: resumeBaseId :ast o: resumeField
                        if rfb0 > 0 then noStamp.append rfb0
                    } else {
                        if (isNonOwnedLeaf name: alf.stringview) then {
                            rf1: clonePath :ast n: acc
                            # the field copy shares the param's stamp in the
                            # reference -- one stamp per ref (the recorder
                            # keys the head atom)
                            rfb1: pathBaseAtomId :ast n: rf1
                            if rfb1 > 0 then noStamp.append rfb1
                            rfRootStamp = true
                            resumeField = (Option.some rf1)
                        } else {
                            base: (Option.none Node)
                            if alf.stringview == "borrow" then {
                                base = cloneDottedParent :ast n: acc
                            } else {
                                b10: clonePath :ast n: acc
                                base = (Option.some b10)
                            }
                            rfb2: resumeBaseId :ast o: base
                            if rfb2 > 0 then noStamp.append rfb2
                            bg: base.take
                            match (
                                bg
                            ) case some then {
                                la: mkAtom :ast line: al col: ac name: "borrow"
                                rf2: (Node.dottedpath (zast.DottedPathData
                                    nodeid: (zast.tableReserve :ast)
                                    lineno: al
                                    colno: ac
                                    parent: (zast.tableAdd :ast n: bg.take)
                                    child: (zast.tableAdd :ast n: la))
                                )
                                resumeField = (Option.some rf2)
                            } case none then null
                        }
                    }
                } case none then null
                callM: (buildCallMethod
                    :ast
                    :line
                    :col
                    body: newBodyOpt.take
                    wrapExprId: wid
                    :valueParam
                )
                createM: (buildCreateMethod
                    :ast
                    :line
                    :col
                    params: createParams
                    fwdNames: pNames
                )
                # class fields: the state cursor, captured params, then
                # typeof-typed yield-crossing locals (first-assignment order)
                sysAtom: mkAtom :ast :line :col name: "system"
                i64Leaf: mkAtom :ast :line :col name: "i64"
                i64Atom: (Node.dottedpath (zast.DottedPathData
                    nodeid: (zast.tableReserve :ast)
                    lineno: line
                    colno: col
                    parent: (zast.tableAdd :ast n: sysAtom)
                    child: (zast.tableAdd :ast n: i64Leaf))
                )
                stField: mkNamedOp :ast :line :col name: "state" op: i64Atom
                isItems: (ListVal u32)
                isItems.append (zast.tableAdd :ast n: stField)
                fi3: u64
                fn3: pNames.length
                for fi3 < fn3 loop {
                    f3: pNames.get i: fi3
                    f3v: f3.stringview
                    pf3: pFields.get i: fi3
                    # field paths staged owned: List.get is a borrow, the
                    # namedoperation stores owned -- clone out
                    pf3o: clonePath :ast n: pf3
                    # receiver-lock fields stamp fresh; ordinary param fields
                    # share the factory's stamp
                    tf3: thisFlags.get i: fi3
                    nf3: mkNamedOp :ast :line :col name: f3v op: pf3o
                    if (tf3) == false then {
                        pfid3: paramOpId :ast n: nf3
                        if pfid3 > 0 then noStamp.append pfid3
                    }
                    isItems.append (zast.tableAdd :ast n: nf3)
                    fi3 = fi3 + 1
                }
                li3: u64
                ln3: crossing.length
                for li3 < ln3 loop {
                    l3: crossing.get i: li3
                    l3v: l3.stringview
                    rhsCar: (GivesParts
                        base: (Option.none Node)
                        leaf: "".string
                        acceptsTy: (Option.none Node)
                    )
                    firstRhsOfOpt :ast o: pBody name: l3v dst: rhsCar
                    rc3: rhsCar.base.take
                    match (
                        rc3
                    ) case some then {
                        tof3: (Node.typeofexpr (zast.TypeOfExprData
                            nodeid: (zast.tableReserve :ast)
                            lineno: line
                            colno: col
                            source: (zast.tableAdd :ast n: rc3.take))
                        )
                        nf4: mkNamedOp :ast :line :col name: l3v op: tof3
                        isItems.append (zast.tableAdd :ast n: nf4)
                    } case none then null
                    li3 = li3 + 1
                }
                rfg: resumeField.take
                match (
                    rfg
                ) case some then {
                    rfn: mkNamedOp :ast :line :col name: "_resume_input" op: rfg.take
                    if rfRootStamp then {
                        rfd: paramOpId :ast n: rfn
                        if rfd > 0 then noStamp.append rfd
                    }
                    isItems.append (zast.tableAdd :ast n: rfn)
                } case none then null
                createNamed: mkNamedOp :ast :line :col name: "create" op: createM
                callNamed: mkNamedOp :ast :line :col name: "call" op: callM
                asItems: (ListVal u32)
                asItems.append (zast.tableAdd :ast n: createNamed)
                asItems.append (zast.tableAdd :ast n: callNamed)
                synthClass: (Node.objectdef (zast.ObjectDefData
                    nodeid: (zast.tableReserve :ast)
                    lineno: line
                    colno: col
                    kind: zast.objectkind.classDef
                    :isItems
                    :asItems
                    isNative: false)
                )
                factory: (buildFactory
                    :ast
                    :line
                    :col
                    :synthName
                    params: factoryParams
                    fwdNames: pNames
                    :privNames
                )
                return (Option.some (GenLowered
                    :factory
                    :synthClass
                    wrapperNodeId: wid
                    :noStamp)
                )
            } case none then {
                return (Option.none GenLowered)
            }
        } case none then {
            return (Option.none GenLowered)
        }
    } else {
        return (Option.none GenLowered)
    }
}
