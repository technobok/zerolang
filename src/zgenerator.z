# zgenerator.z -- preparing a declared `generator` for the ordinary class walk.
#
# A generator is a DECLARATION: its `is` block is the state it is constructed
# with, and its `call` member is a body that suspends. The class is the
# author's, so this unit synthesises nothing the author already wrote -- it
# adds `call`'s implicit receiver and the option wrapper around its element
# type, generates the `create` the `is` fields describe, and appends the fields
# the suspension transform needs: a `state` cursor, the loop counters, and the
# resume slots. The body's locals, the payload a suspending loop binds, the
# iterable it constructs and the value a `with` holds are the checker's fields:
# it mints them during the body walk, where their types are known. The state machine itself is the emitter's job; what happens here is
# that the class arrives at it complete.
#
# Nothing here infers ownership. A field's marker is what the author declared,
# and the generated `create`'s parameter follows from it -- which is the whole
# reason the form exists.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :GenDeclared
    :lowerDeclared
}

astnode: zast.astnode
Ast: zast.Ast


# The counter the synthetic `_iterN` names draw from. astnode ids do not
# come from here: a synthesised node reserves its own table slot with
# zast.tableReserve.
NameCtr: class {
    # the next `_iterN` number. astnode ids do NOT come from here -- a synthesised
    # node reserves its own table slot
    next: u32
} as {
    # take the next number and reserve a table slot for the node that will use
    # it
    bump: function {:this} out zast.nodeid is {
        id: this.next
        this.next = this.next + 1
        return (zast.nodeid.create from: id)
    }
}

# leafAtomName -- an atom's name (owned copy); "" for other shapes.
leafAtomName: function {ast: Ast.view n: astnode.view} out String is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# leafAtomNameId -- an atom's name id; 0 for other shapes. The id twin of
# leafAtomName: a resolved compare needs the pool id, never the text.
leafAtomNameId: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    ast
    match (
        n
    ) case atomid then {
        return n.name
    } else {
        return (zast.nameid.create from: 0)
    }
}


# pathLeafName -- the take/borrow ownership leaf on a dotted path, "" when
# none. It answers only those two: a `.view` or `.hold` leaf comes back
# unmarked, so a caller that needs every marker must read the leaf by name id.
pathLeafName: function {ast: Ast.view n: astnode.view} out String is {
    match (
        n
    ) case dottedpath then {
        ln: leafAtomName :ast n: (ast.nodes.get i: n.child.u64)
        if ln.stringView == "take" then return ln
        if ln.stringView == "borrow" then return ln
        return "".string
    } else {
        return "".string
    }
}

# clonePathAt -- deep-copy the type-path subtree the row `nid` names (atom /
# labelvalue / dotted / call / namedoperation / string shapes), minting fresh
# nodeids and keeping positions. The synth wrapper and field types embed copies
# because a node owns exactly one parent. Each row view is scoped to a block
# that lends nothing: the children go first (by id), then the copy's slot, then
# the arm is built from the row's scalars.
clonePathAt: function {ast: Ast nid: zast.nodeid} out astnode is {
    kids: ListVal u32
    {
        n: ast.nodes.get i: nid.u64
        if (pathShape :n) then kids = zast.childIds :ast :n
    }
    cloned: clonePathKids :ast :kids
    myId: zast.tableReserve :ast
    built: astnode.placeholder
    {
        n: ast.nodes.get i: nid.u64
        built = clonePathArm :n :myId :cloned kids: ast.kids
    }
    if built.placeholder then return (clonePathUnsupported :ast :myId)
    return built
}

# pathShape -- `n` is a shape clonePathAt copies structurally.
pathShape: function {n: astnode.view} out bool is {
    match (
        n
    ) case atomid then {
        return true
    } case labelvalue then {
        return true
    } case dottedpath then {
        return true
    } case call then {
        return true
    } case namedoperation then {
        return true
    } case atomstring then {
        return true
    } case stringchunk then {
        return true
    } else {
        return false
    }
}

# clonePathKids -- clone each child by id and intern the clones, in order.
clonePathKids: function {ast: Ast kids: (ListVal u32).view} out ListVal u32 is {
    cloned: ListVal u32
    with it: kids.iterate do for k: it loop {
        c0: clonePathAt :ast nid: (zast.nodeid.create from: k)
        cloned.append (zast.tableAdd :ast n: c0)
    }
    return cloned
}

# clonePathArm -- the clone of `n`'s arm under `myId`, its children the
# interned clones in `cloned` (canonical childIds order); the placeholder
# arm for any shape clonePathAt does not copy. Reads the view only.
clonePathArm: function {
    kids: ListVal u32
    n: astnode.view
    myId: zast.nodeid
    cloned: (ListVal u32).view
} out astnode is {
    match (
        n
    ) case atomid then {
        # interned name: the clone shares the pool id
        return (astnode.atomid (zast.atomidrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
        )
        )
    } case labelvalue then {
        return (astnode.labelvalue (zast.labelvaluerow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
        )
        )
    } case dottedpath then {
        return (astnode.dottedpath (zast.dottedpathrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            parent: (zast.nodeid.create from: (cloned.get i: 0))
            child: (zast.nodeid.create from: (cloned.get i: 1))
        )
        )
    } case call then {
        return (astnode.call (zast.callrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            callable: (zast.nodeid.create from: (cloned.get i: 0))
            arguments: (zast.kidsAddWindow :kids xs: (cloned.slice from: 1 to: cloned.length))
            infix: n.infix
        )
        )
    } case namedoperation then {
        return (astnode.namedoperation (zast.namedoperationrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
            operation: (zast.nodeid.create from: (cloned.get i: 0))
        )
        )
    } case atomstring then {
        return (astnode.atomstring (zast.atomstringrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            stringparts: (zast.kidsAddWindow :kids xs: (cloned.slice from: 0 to: cloned.length))
        )
        )
    } case stringchunk then {
        ck8: n.chunkKind
        return (astnode.stringchunk (zast.stringchunkrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            text: n.text
            chunkKind: ck8
        )
        )
    } else {
        return astnode.placeholder
    }
}

# clonePathUnsupported -- an unsupported path shape clones to an error
# atom, which keeps the tree total.
clonePathUnsupported: function {ast: Ast myId: zast.nodeid} out astnode is {
    return (astnode.atomid (zast.atomidrow
        nodeid: myId
        lineno: 0
        colno: 0
        name: (internSynthName :ast text: "?")
    )
    )
}


# GivesParts -- split the iterator return into (gives base path CLONE,
# ownership leaf, accepts path CLONE or none). The base clone feeds the
# synth wrapper; a "borrow" leaf selects OptionView, anything else Option.
GivesParts: class {
    # a CLONE of the element path, which feeds the option wrapper. A clone
    # because the original stays in the tree
    base: optionval astnode
    # the ownership leaf. "borrow" selects OptionView and anything else
    # selects Option, which is the whole of the choice
    leaf: String
}

# read the `gives` type from operation `n` into `dst`.
givesFromOp: function {ast: Ast nid: zast.nodeid dst: GivesParts} is {
    innerId: zast.nodeid
    isDotted: false
    parentId: zast.nodeid
    lf: String
    {
        n: ast.nodes.get i: nid.u64
        match (
            n
        ) case dottedpath then {
            isDotted = true
            parentId = n.parent
        } else null
        if innerId.isZero then lf = pathLeafName :ast :n
    }
    if innerId.isZero.not then {
        givesFromOp :ast nid: innerId :dst
        return
    }
    if lf.length > 0 then {
        if isDotted then {
            bc: clonePathAt :ast nid: parentId
            dst.base = optionval.some bc
            dst.leaf = lf
        }
    } else {
        bc2: clonePathAt :ast :nid
        dst.base = optionval.some bc2
    }
}

# mkAtom / mkNamedOp / mkBareOp -- small node factories at a source
# position (the synthesized members all carry the function's start).
# internSynthName -- the pool id for synthesized-name text (deduplicated
# by the pool, so ref equality holds across parsed and synthesized atoms).
internSynthName: function {ast: Ast text: StringView} out zast.nameid is {
    return (ast.names.set s: text)
}

# build an atomid node for a name and return its node id.
mkAtom: function {
    ast: Ast
    line: u32
    col: u32
    name: StringView
} out astnode is {
    return (astnode.atomid (zast.atomidrow
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        name: (internSynthName :ast text: name)
    )
    )
}

# build a namedoperation node (a name paired with an operation) in `ast`
# and return its node id.
mkNamedOp: function {
    ast: Ast
    line: u32
    col: u32
    name: StringView
    op: astnode
} out astnode is {
    return (astnode.namedoperation (zast.namedoperationrow
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        name: (ast.names.set s: name)
        operation: (zast.tableAdd :ast n: op)
    )
    )
}

# build a bare namedoperation node and return its node id.
mkBareOp: function {
    ast: Ast
    line: u32
    col: u32
    op: astnode
} out astnode is {
    return (astnode.namedoperation (zast.namedoperationrow
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        name: zast.nameid
        operation: (zast.tableAdd :ast n: op)
    )
    )
}

# mkReturnBody -- `{ return (<inner>) }`: the single-statement body both
# the create method and the factory share.
mkReturnBody: function {
    ast: Ast
    line: u32
    col: u32
    inner: astnode
} out astnode is {
    retCal: mkAtom :ast :line :col name: "return"
    retArg: mkBareOp :ast :line :col op: inner
    retArgs: ListVal u32
    retArgs.append (zast.tableAdd :ast n: retArg)
    retCall: astnode.call (zast.callrow
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        callable: (zast.tableAdd :ast n: retCal)
        arguments: (zast.kidsAdd kids: ast.kids xs: retArgs)
        infix: false
    )
    sline: astnode.statementline (zast.statementlinerow
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        statementline: (zast.tableAdd :ast n: retCall)
    )
    slist: ListVal u32
    slist.append (zast.tableAdd :ast n: sline)
    return (astnode.statement (zast.statementrow
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        statements: (zast.kidsAdd kids: ast.kids xs: slist)
    )
    )
}

# typePathIsReference -- the field's type path ends in a `.borrow`/`.view`
# marker: the field is a reference the instance keeps locked for its life.
typePathIsReference: function {ast: Ast.view nid: zast.nodeid} out bool is {
    if nid.isZero then return false
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case dottedpath then {
        lid: leafAtomNameId :ast n: (ast.nodes.get i: n.child.u64)
        if lid == zast.names.wkBorrow then return true
        return lid == zast.names.wkView
    } else {
        return false
    }
}

# buildCreateMethod -- `create: function {<param-clones>} out this is {
# return (meta.create state: 0 p1: :p1 ...) }`, `outx this` when a captured
# field is a reference: captured parameters forward by label-value shorthand;
# every other field starts zero, until the body writes it.
buildCreateMethod: function {
    ast: Ast
    line: u32
    col: u32
    params: (ListVal u32).take
    fwdNames: (List String).view
    # a captured field is a reference, so the create is `outx this`
    pins: bool
} out astnode is {
    metaAtom: mkAtom :ast :line :col name: "meta"
    createAtom: mkAtom :ast :line :col name: "create"
    metaCreate: astnode.dottedpath (zast.dottedpathrow
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        parent: (zast.tableAdd :ast n: metaAtom)
        child: (zast.tableAdd :ast n: createAtom)
    )
    zeroAtom: mkAtom :ast :line :col name: "0"
    stArg: mkNamedOp :ast :line :col name: "state" op: zeroAtom
    cargs: ListVal u32
    cargs.append (zast.tableAdd :ast n: stArg)
    fi: u64
    fn: fwdNames.length
    for fi < fn loop {
        f0: fwdNames.get i: fi
        f0v: f0.stringView
        lv0: astnode.labelvalue (zast.labelvaluerow
            nodeid: (zast.tableReserve :ast)
            lineno: line
            colno: col
            name: (internSynthName :ast text: f0v)
        )
        fa0: mkNamedOp :ast :line :col name: f0v op: lv0
        cargs.append (zast.tableAdd :ast n: fa0)
        fi = fi + 1
    }
    icall: astnode.call (zast.callrow
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        callable: (zast.tableAdd :ast n: metaCreate)
        arguments: (zast.kidsAdd kids: ast.kids xs: cargs)
        infix: false
    )
    body: mkReturnBody :ast :line :col inner: icall
    # `outx this` when the synth class captures a NON-OWNED parameter -- a
    # reference into the caller that has to stay pinned for the iterator's
    # lifetime; a plain `out this` when it captures nothing non-owned, since
    # an `outx` with nothing to pin is refused.
    thisRet: mkAtom :ast :line :col name: "this"
    thisRetId: zast.tableAdd :ast n: thisRet
    return (astnode.functiondef (zast.functionrow
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        returntype: thisRetId
        parameters: (zast.kidsAdd kids: ast.kids xs: params)
        body: (zast.tableAdd :ast n: body)
        isNative: false
        :pins
        asItems: (zast.kidsAdd kids: ast.kids xs: ListVal u32)
    )
    )
}


# buildWrapper -- the synth `.call` return `(Option|OptionView <base>)`: an
# owned wrapper unless the leaf is a reference. The type argument is written
# WITHOUT its label: this unit lowers the AST before typecheck and so has no
# symbol table to ask a template for its parameter name, and the elided leading
# argument is rebound to that parameter by getOrMintSpec anyway. Both wrappers
# take exactly one parameter, which is what makes eliding it safe.
buildWrapper: function {
    ast: Ast
    line: u32
    col: u32
    base: astnode
    leaf: StringView
} out astnode is {
    # the wrapper is owned unless the leaf asks for a view: `Option` for a
    # plain or `.take` leaf, `OptionView` for `.borrow` -- which the checker
    # then refuses, since nothing implements a reference yield. The checker
    # collapses the owned wrapper further (a valtype element to optionval).
    wn: "Option"
    if leaf == "borrow" then wn = "OptionView"
    wAtom: mkAtom :ast :line :col name: wn
    tArg: mkBareOp :ast :line :col op: base
    wargs: ListVal u32
    wargs.append (zast.tableAdd :ast n: tArg)
    return (astnode.call (zast.callrow
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        callable: (zast.tableAdd :ast n: wAtom)
        arguments: (zast.kidsAdd kids: ast.kids xs: wargs)
        infix: false
    )
    )
}


# isYieldValue -- the assignment RHS is a yield expression: the expression-form
# `name: yield E`.
isYieldValue: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case call then {
        return (zast.isYieldCalleeAt :ast callableId: n.callable)
    } else {
        return false
    }
}

# bindsYieldValue -- the body binds `yield`'s own value somewhere (`a: yield e`),
# outside a nested function literal.
bindsYieldValue: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case functiondef then {
        return false
    } case assignment then {
        if (isYieldValue :ast n: (ast.nodes.get i: n.value.u64)) then return true
    } else null
    kids: zast.childIds :ast :n
    i: u64
    for i < kids.length loop {
        if (bindsYieldValue :ast n: (ast.nodes.get i: (kids.get :i).u64)) then return true
        i = i + 1
    }
    return false
}

# promoteIterables -- clone the body, and for each top-level `for` whose
# loop body suspends, hoist every non-trivial named iterable into a
# synthetic `_iterN: <expr>` binding before the loop (the loop references
# `_iterN`). Without this, the iterable would be a C-stack local that
# does not survive a suspension; the synthetic local is an ordinary local,
# which the checker keeps in the instance like any other. Recurses into for
# bodies only.
#
# A body is always a block: the parser wraps a brace-less `for` body in a
# one-line block, and a brace-less `with` body reaches promoteWrappedBody,
# which routes a bare `for`/`with` line through promoteBareLine. What remains
# here that is not a block is a leaf, cloned as a path.
promoteIterables: function {ast: Ast ctr: NameCtr nid: zast.nodeid} out astnode is {
    isStmt: false
    lnP: u32
    coP: u32
    lineIds: ListVal u32
    {
        n: ast.nodes.get i: nid.u64
        if n.statement then {
            isStmt = true
            lnP = n.lineno
            coP = n.colno
            stx809: u64
            for stx809 < n.statements.count.u64 loop {
                s: zast.kidAt kids: ast.kids span: n.statements i: stx809
                stx809 = stx809 + 1
                lineIds.append from: s
            }
        }
    }
    if isStmt.not then return (clonePathAt :ast :nid)
    newLines: ListVal u32
    with lit: lineIds.iterate do for s0Id: lit loop {
        promoteLine :ast :ctr nid: (zast.nodeid.create from: s0Id) dst: newLines
    }
    return (astnode.statement (zast.statementrow
        nodeid: (zast.tableReserve :ast)
        lineno: lnP
        colno: coP
        statements: (zast.kidsAdd kids: ast.kids xs: newLines)
    )
    )
}


# spillBeforeYields -- in every block of a generator body, a line whose
# expression suspends part-way through: each part written before the first part
# that holds a yield is bound to a synthetic local ahead of the line, and the
# line reads the local instead. The emitter lifts that yield out of the
# expression and suspends ahead of the line, so a part left in place would run
# only after the resume; the local crosses the suspension and becomes a field
# like any other.
spillBeforeYields: function {ast: Ast ctr: NameCtr nid: zast.nodeid} is {
    if nid.isZero then return
    kids: ListVal u32
    lines: ListVal u32
    {
        n: ast.nodes.get i: nid.u64
        if n.functiondef or n.objectdef or n.unitdef then return
        if (zast.yieldCountOf :ast :n) == 0 then return
        zast.childIdsInto :ast :n acc: kids
        if n.statement then {
            li: u64
            for li < n.statements.count.u64 loop {
                lines.append (zast.kidAt kids: ast.kids span: n.statements i: li)
                li = li + 1
            }
        }
    }
    with kit: kids.iterate do for k: kit loop {
        spillBeforeYields :ast :ctr nid: (zast.nodeid.create from: k)
    }
    if lines.length == 0 then return
    newLines: ListVal u32
    with lit: lines.iterate do for l: lit loop {
        inner: zast.nodeid
        {
            ln: ast.nodes.get i: l.u64
            if ln.statementline then inner = ln.statementline
        }
        spillIn :ast :ctr nid: inner dst: newLines
        newLines.append l
    }
    if newLines.length == lines.length then return
    span: zast.kidsAdd kids: ast.kids xs: newLines
    bm: ast.nodes.getMut i: nid.u64
    if bm.statement then bm.statements = span
}

# spillIn -- the parts of expression `nid` evaluated before its last yield, each
# spilled into `dst` in the order it is written. The walk follows evaluation down
# to the yields: a binding's value, the first condition of an `if` (the one part
# of it that runs unconditionally), a member read's receiver, a yield's operand,
# and a call's receiver and then its arguments. A call's part that holds a yield
# is spilled whole when a later part holds one too, so what lies between the two
# runs between the suspensions; the call's last such part is walked in turn.
spillIn: function {ast: Ast ctr: NameCtr nid: zast.nodeid dst: ListVal u32} is {
    if nid.isZero then return
    if (zast.yieldCountIn :ast :nid) == 0 then return
    parts: ListVal u32
    holders: ListVal u32
    next: spillStep :ast :nid :parts :holders
    if next.isZero.not then {
        spillIn :ast :ctr nid: next :dst
        return
    }
    spillCallParts :ast :ctr :parts :holders :dst
}

# spillStep -- where evaluation of `nid` goes next on the way to its yields: the
# node to walk, or zero for a call, whose receiver and arguments are appended to
# `parts` in written order beside the node holding each (`holders`).
spillStep: function {
    ast: Ast.view
    nid: zast.nodeid
    parts: ListVal u32
    holders: ListVal u32
} out zast.nodeid is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case assignment then {
        return n.value
    } case reassignment then {
        return n.value
    } case namedoperation then {
        return n.operation
    } case dottedpath then {
        return n.parent
    } case ifexpr then {
        return (firstConditionOf :ast clauses: n.clauses)
    } case call then {
        # a yield's operand runs before it suspends
        if (zast.isYieldCalleeAt :ast callableId: n.callable) then {
            return (zast.yieldCallOperandAt :ast :nid)
        }
        cb: ast.nodes.get i: n.callable.u64
        if cb.dottedpath then {
            parts.append cb.parent.u32
            holders.append n.callable.u32
        }
        ai: u64
        for ai < n.arguments.count.u64 loop {
            aId: zast.kidAt kids: ast.kids span: n.arguments i: ai
            ai = ai + 1
            a: ast.nodes.get i: aId.u64
            if a.namedoperation then {
                parts.append a.operation.u32
                holders.append aId
            }
        }
        return zast.nodeid
    } else {
        return zast.nodeid
    }
}

# firstConditionOf -- an `if`'s first clause's first condition, the one part of
# it that runs unconditionally; zero when it has none.
firstConditionOf: function {ast: Ast.view clauses: zast.kidspan} out zast.nodeid is {
    if clauses.count.u64 == 0 then return zast.nodeid
    c0: ast.nodes.get i: (zast.kidAt kids: ast.kids span: clauses i: 0).u64
    if c0.ifclause when c0.conditions.count.u64 > 0 then {
        return (zast.nodeid.create from: (zast.kidAt kids: ast.kids span: c0.conditions i: 0))
    }
    return zast.nodeid
}

# spillCallParts -- a call's parts, in written order: each one before the last
# part that holds a yield is spilled, unless it stays put and holds none; the
# last such part is walked in turn.
spillCallParts: function {
    ast: Ast
    ctr: NameCtr
    parts: (ListVal u32).view
    holders: (ListVal u32).view
    dst: ListVal u32
} is {
    last: parts.length
    pi: u64
    for pi < parts.length loop {
        if (partHoldsYield :ast part: (parts.get i: pi)) then last = pi
        pi = pi + 1
    }
    if last == parts.length then return
    pi = 0
    for pi < last loop {
        part: parts.get i: pi
        if (partHoldsYield :ast :part) or (spillStaysPut :ast nid: part).not then {
            spillPart :ast :ctr :part holder: (holders.get i: pi) :dst
        }
        pi = pi + 1
    }
    spillIn :ast :ctr nid: (zast.nodeid.create from: (parts.get i: last)) :dst
}

# partHoldsYield -- a yield is written somewhere inside `part`.
partHoldsYield: function {ast: Ast.view part: u32} out bool is {
    return (zast.yieldCountIn :ast nid: (zast.nodeid.create from: part)) > 0
}

# spillStaysPut -- a part that reads the same after the resume as before the
# suspension: a literal, a name, and a member read through names. Nothing else
# runs in the body while it is suspended, and a name bound to a synthetic local
# would borrow what it names.
spillStaysPut: function {ast: Ast.view nid: u32} out bool is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case atomid then {
        return true
    } case labelvalue then {
        return true
    } case atomstring then {
        pi: u64
        for pi < n.stringparts.count.u64 loop {
            p: ast.nodes.get i: (zast.kidAt kids: ast.kids span: n.stringparts i: pi).u64
            if p.stringchunk.not then return false
            pi = pi + 1
        }
        return true
    } case dottedpath then {
        return (spillStaysPut :ast nid: n.parent.u32)
    } else {
        return false
    }
}

# spillPart -- bind `part` to a synthetic `_partN` on a line of its own, appended
# to `dst` after the part's own spills, and read the local where the part stood:
# as the argument `holder` carries, or as the receiver of the member read
# `holder` is.
spillPart: function {ast: Ast ctr: NameCtr part: u32 holder: u32 dst: ListVal u32} is {
    spillIn :ast :ctr nid: (zast.nodeid.create from: part) :dst
    ln: u32
    co: u32
    {
        pp: zast.posOf n: (ast.nodes.get i: part.u64)
        ln = pp.line
        co = pp.col
    }
    synthN: "_part\{ctr.bump}"
    snid: zast.poolSet pool: ast.names text: synthN.stringView
    sa: astnode.assignment (zast.assignmentrow
        nodeid: (zast.tableReserve :ast)
        lineno: ln
        colno: co
        name: snid
        value: (zast.nodeid.create from: part)
    )
    sl: astnode.statementline (zast.statementlinerow
        nodeid: (zast.tableReserve :ast)
        lineno: ln
        colno: co
        statementline: (zast.tableAdd :ast n: sa)
    )
    dst.append (zast.tableAdd :ast n: sl)
    at: mkAtom :ast line: ln col: co name: synthN.stringView
    atId: zast.nodeid.create from: (zast.tableAdd :ast n: at)
    hm: ast.nodes.getMut i: holder.u64
    if hm.namedoperation then {
        hm.operation = atId
    } else if hm.dottedpath then {
        hm.parent = atId
    }
}

# promoteIterablesIdAt -- promote and intern a loop body (0 = absent).
promoteIterablesIdAt: function {
    ast: Ast
    ctr: NameCtr
    oId: zast.nodeid
} out u32 is {
    if oId.isZero then return 0
    r: promoteIterables :ast :ctr nid: oId
    return (zast.tableAdd :ast n: r)
}

# promoteLine -- one statement line: a for-statement transforms (possibly
# appending synthetic bindings first); anything else passes through as a deep
# copy (cloneTreeAt).
promoteLine: function {ast: Ast ctr: NameCtr nid: zast.nodeid dst: ListVal u32} is {
    isFor: false
    innerId: zast.nodeid
    lnQ: u32
    coQ: u32
    {
        n: ast.nodes.get i: nid.u64
        if n.statementline then {
            innerId = n.statementline
            lnQ = n.lineno
            coQ = n.colno
            isFor = lineIsFor n: (ast.nodes.get i: n.statementline.u64)
            if isFor.not then {
                isFor = lineIsWith n: (ast.nodes.get i: n.statementline.u64)
            }
        }
    }
    if isFor then {
        # what is hoisted ahead of the loop sits in a block of its own with the
        # loop (promoteBareLine), scoped as the loop's header was: two loops in
        # one block may bind the same name
        pr: promoteBareLine :ast :ctr nid: innerId
        nl: astnode.statementline (zast.statementlinerow
            nodeid: (zast.tableReserve :ast)
            lineno: lnQ
            colno: coQ
            statementline: (zast.nodeid.create from: pr)
        )
        dst.append (zast.tableAdd :ast n: nl)
    } else {
        nc: cloneTreeAt :ast :nid
        dst.append (zast.tableAdd :ast n: nc)
    }
}

# true when node `n` is a with-statement line.
lineIsWith: function {n: astnode.view} out bool is {
    match (
        n
    ) case withexpr then {
        return true
    } else {
        return false
    }
}

# promoteWrappedBody -- promote a `with` body, rebuilding the `do` around the
# result when it has one.
#
# `promoteIterables` answers `clonePathAt` for anything that is not a
# `statement` -- which clones PATH shapes only and silently drops a block's
# contents -- so a `do` is opened first and closed again after. A `with` body
# may also be a bare `for` or `with` LINE with no block at all (`with it: E
# do for e: it loop { .. }`), which the path clone answered with a `?` atom
# that reached the C; that line is promoted as the one line it is.
promoteWrappedBody: function {ast: Ast ctr: NameCtr oId: zast.nodeid} out u32 is {
    if oId.isZero then return 0
    isDo: false
    innerId: zast.nodeid
    lnY: u32
    coY: u32
    {
        n: ast.nodes.get i: oId.u64
        if n.doexpr then {
            isDo = true
            innerId = n.statement
            lnY = n.lineno
            coY = n.colno
        }
    }
    if isDo.not then {
        bareLine: false
        {
            nB: ast.nodes.get i: oId.u64
            if (lineIsFor n: nB) then bareLine = true
            if (lineIsWith n: nB) then bareLine = true
        }
        if bareLine then return (promoteBareLine :ast :ctr nid: oId)
        return (promoteIterablesIdAt :ast :ctr :oId)
    }
    innerNew: promoteWrappedBody :ast :ctr oId: innerId
    if innerNew == 0 then return 0
    redo: astnode.doexpr (zast.dorow
        nodeid: (zast.tableReserve :ast)
        lineno: lnY
        colno: coY
        statement: (zast.nodeid.create from: innerNew)
    )
    return (zast.tableAdd :ast n: redo)
}

# promoteBareLine -- one `for` or `with` line, promoted: a line of a block, or a
# `with` body that is a bare line rather than a block. A binding hoisted ahead
# of the loop needs a block to sit in, scoped as the loop's header was, so the
# line then becomes the `do { .. }` block the author could have written -- the
# line a statement of its own, the block under a `doexpr`, exactly the shape a
# braced body has. With nothing hoisted the promoted node stands alone.
promoteBareLine: function {ast: Ast ctr: NameCtr nid: zast.nodeid} out u32 is {
    hoisted: ListVal u32
    ni: promoteInExpr :ast :ctr :nid dst: hoisted
    if hoisted.length == 0 then return (zast.tableAdd :ast n: ni)
    lnB: u32
    coB: u32
    {
        nP: ast.nodes.get i: nid.u64
        pB: zast.posOf n: nP
        lnB = pB.line
        coB = pB.col
    }
    sl: astnode.statementline (zast.statementlinerow
        nodeid: (zast.tableReserve :ast)
        lineno: lnB
        colno: coB
        statementline: (zast.tableAdd :ast n: ni)
    )
    hoisted.append (zast.tableAdd :ast n: sl)
    blk: astnode.statement (zast.statementrow
        nodeid: (zast.tableReserve :ast)
        lineno: lnB
        colno: coB
        statements: (zast.kidsAdd kids: ast.kids xs: hoisted)
    )
    redo: astnode.doexpr (zast.dorow
        nodeid: (zast.tableReserve :ast)
        lineno: lnB
        colno: coB
        statement: (zast.nodeid.create from: (zast.tableAdd :ast n: blk))
    )
    return (zast.tableAdd :ast n: redo)
}

# promoteWith -- a `with` inside a suspending body: promote the body, so a
# nested suspending loop or `with` has its own iterables hoisted, and carry the
# header's name and value across it.
#
# `with s: E do { .. }` emits `T s = E;` ahead of the block, and the resume
# `goto` re-enters past that line. Whether E is owned is a symbol-table question
# this pass cannot ask (a dotted auto-call reads as a plain path), so the checker
# minds it: an owned value whose block suspends gets a state field of the value's
# type, and the emitter binds the name to that field for the body.
promoteWith: function {ast: Ast ctr: NameCtr nid: zast.nodeid} out astnode is {
    isWith: false
    lnW: u32
    coW: u32
    nameW: zast.nameid
    valW: zast.nodeid
    bodyW: zast.nodeid
    {
        n: ast.nodes.get i: nid.u64
        if n.withexpr then {
            isWith = true
            lnW = n.lineno
            coW = n.colno
            nameW = n.name
            valW = n.value
            bodyW = n.body
        }
    }
    if isWith.not then {
        return (cloneTreeAt :ast :nid)
    }
    nbodyId: promoteWrappedBody :ast :ctr oId: bodyW
    nval: cloneTreeAt :ast nid: valW
    nvalId: zast.tableAdd :ast n: nval
    return (astnode.withexpr (zast.withrow
        nodeid: (zast.tableReserve :ast)
        lineno: lnW
        colno: coW
        name: nameW
        value: (zast.nodeid.create from: nvalId)
        body: (zast.nodeid.create from: nbodyId)
    )
    )
}

# true when node `n` is a for-statement line.
lineIsFor: function {n: astnode.view} out bool is {
    match (
        n
    ) case forexpr then {
        return true
    } else {
        return false
    }
}

# promoteInExpr -- a `for` or `with` line of a suspending body, with its
# iterables hoisted (promoteFor, promoteWith).
promoteInExpr: function {
    ast: Ast
    ctr: NameCtr
    nid: zast.nodeid
    dst: ListVal u32
} out astnode is {
    isW: false
    {
        n9: ast.nodes.get i: nid.u64
        if n9.withexpr then isW = true
    }
    if isW then return (promoteWith :ast :ctr :nid)
    return (promoteFor :ast :ctr :nid :dst)
}

# promoteForInit -- hoist a C-STYLE for-binding out of its header, so it is an
# ordinary local.
#
# `for i: 0 while i < n loop` initialises `i` once and tests it per iteration;
# the binding lives only in the emitted `int64_t i = 0;` ahead of the `while`,
# and `goto L_resume_k` re-enters the loop past it, so a suspending body read
# indeterminate garbage and the loop yielded once. Rewriting it to `i: 0`
# followed by `for while i < n loop` is the same program -- and `i` is then an
# ordinary local, which the checker keeps in a field of the instance.
#
# Only the BINDING moves; the condition it shared the header with stays put.
promoteForInit: function {
    # the tree the condition is read from, and where the synth nodes are minted
    ast: Ast
    # the binding condition being hoisted
    c0Id: u32
    # the statement list ahead of the loop, which the new assignment joins
    dst: ListVal u32
} is {
    # read through a view scoped to this block: the mint below lends ast
    opId: zast.nodeid
    cnId: zast.nameid
    hl1: u32
    hc1: u32
    {
        c0: ast.nodes.get i: c0Id.u64
        if c0.namedoperation then {
            hp1: zast.posOf n: (ast.nodes.get i: c0.operation.u64)
            hl1 = hp1.line
            hc1 = hp1.col
            opId = c0.operation
            cnId = c0.name
        }
    }
    if opId.isZero then return
    rhs1: cloneTreeAt :ast nid: opId
    sa1: astnode.assignment (zast.assignmentrow
        nodeid: (zast.tableReserve :ast)
        lineno: hl1
        colno: hc1
        name: cnId
        value: (zast.tableAdd :ast n: rhs1)
    )
    sl1: astnode.statementline (zast.statementlinerow
        nodeid: (zast.tableReserve :ast)
        lineno: hl1
        colno: hc1
        statementline: (zast.tableAdd :ast n: sa1)
    )
    dst.append (zast.tableAdd :ast n: sl1)
}

# forInitIdx -- the 1-based index of a C-STYLE for-binding among `condIds`, or 0
# when the header has none.
#
# The discriminator is the emitter's own dispatch, mirrored: `emitObjIterFor`
# and `emitIntRangeFor` both bail unless there is EXACTLY ONE condition, so a
# header carrying a binding AND a further condition is already emitted as an
# init line ahead of a `while`. More than one condition, exactly one of them
# named, is therefore precisely the C-style form.
forInitIdx: function {ast: Ast.view condIds: (ListVal u32).view} out u64 is {
    if condIds.length < 2 then return 0
    found: u64
    ci: u64
    for ci < condIds.length loop {
        c0: ast.nodes.get i: (condIds.get i: ci).u64
        ci = ci + 1
        if c0.namedoperation when (zast.nameTextAt :ast ref: c0.name).length > 0 then {
            # a second binding is not this shape; the parser forbids it,
            # so answer 0 rather than guessing which one to hoist
            if found > 0 then return 0
            found = ci
        }
    }
    return found
}

# promoteForCond -- one condition of a for-loop being promoted: a
# suspending loop's non-trivial named iterable moves into a synthetic
# `_iterN` binding (appended to `dst`, ahead of the loop) and the condition
# then names `_iterN`; any other condition is a deep copy. The new condition's id
# goes to `nconds`.
promoteForCond: function {
    ast: Ast
    ctr: NameCtr
    c0Id: u32
    suspends: bool
    dst: ListVal u32
    nconds: ListVal u32
} is {
    # the condition is read through a view scoped to this block: the
    # synth below mints, which lends ast exclusively
    doHoist: false
    opId: zast.nodeid
    cnId: zast.nameid
    hl0: u32
    hc0: u32
    {
        c0: ast.nodes.get i: c0Id.u64
        if c0.namedoperation then {
            cn0: zast.nameTextAt :ast ref: c0.name
            if cn0.length > 0 when suspends when (condIsTrivial
                n: (ast.nodes.get i: c0.operation.u64)
            ).not then doHoist = true
            if doHoist then {
                # synth nodes carry the ITERABLE's source position
                hp0: zast.posOf n: (ast.nodes.get i: c0.operation.u64)
                hl0 = hp0.line
                hc0 = hp0.col
                opId = c0.operation
                cnId = c0.name
            }
        }
    }
    if doHoist then {
        synthN: "_iter\{ctr.bump}"
        rhs0: cloneTreeAt :ast nid: opId
        snv0: synthN.stringView
        snid0: zast.poolSet pool: ast.names text: snv0
        sa0: astnode.assignment (zast.assignmentrow
            nodeid: (zast.tableReserve :ast)
            lineno: hl0
            colno: hc0
            name: snid0
            value: (zast.tableAdd :ast n: rhs0)
        )
        sl0: astnode.statementline (zast.statementlinerow
            nodeid: (zast.tableReserve :ast)
            lineno: hl0
            colno: hc0
            statementline: (zast.tableAdd :ast n: sa0)
        )
        dst.append (zast.tableAdd :ast n: sl0
        # an owned copy: the name must outlive the mints below, which lend ast
        )
        cn1: zast.nameTextCopy :ast ref: cnId
        na0: mkAtom :ast line: hl0 col: hc0 name: snv0
        nc0: mkNamedOp :ast line: hl0 col: hc0 name: cn1.stringView op: na0
        nconds.append (zast.tableAdd :ast n: nc0)
    } else {
        cc0: cloneTreeAt :ast nid: (zast.nodeid.create from: c0Id)
        nconds.append (zast.tableAdd :ast n: cc0)
    }
}

# promoteFor -- a `for` line of a suspending body: its body promoted first, then
# each named iterable of a loop whose body suspends hoisted ahead of it
# (promoteForCond), and a C-style binding hoisted to its own statement
# (promoteForInit).
promoteFor: function {
    ast: Ast
    ctr: NameCtr
    nid: zast.nodeid
    dst: ListVal u32
} out astnode is {
    isFor: false
    lnS: u32
    coS: u32
    bodyId: zast.nodeid
    condIds: ListVal u32
    postIds: ListVal u32
    {
        n: ast.nodes.get i: nid.u64
        if n.forexpr then {
            isFor = true
            lnS = n.lineno
            coS = n.colno
            bodyId = n.body
            cox1389: u64
            for cox1389 < n.conditions.count.u64 loop {
                c: zast.kidAt kids: ast.kids span: n.conditions i: cox1389
                cox1389 = cox1389 + 1
                condIds.append from: c
            }
            pox1459: u64
            for pox1459 < n.postconditions.count.u64 loop {
                p: zast.kidAt kids: ast.kids span: n.postconditions i: pox1459
                pox1459 = pox1459 + 1
                postIds.append from: p
            }
        }
    }
    if isFor.not then {
        return (cloneTreeAt :ast :nid)
    }
    # recurse into the loop body first (nested suspending fors)
    nbodyId: promoteIterablesIdAt :ast :ctr oId: bodyId
    suspends: false
    if nbodyId > 0 then {
        nb: ast.nodes.get i: nbodyId.u64
        suspends = (zast.yieldCountOf :ast n: nb) > 0
    }
    nconds: ListVal u32
    # a C-style binding in a suspending loop is hoisted to its own statement
    # instead of being rewritten in place; every other condition is unchanged
    initIdx: u64
    if suspends then initIdx = forInitIdx :ast :condIds
    ci9: u64
    for ci9 < condIds.length loop {
        c0Id: condIds.get i: ci9
        ci9 = ci9 + 1
        if ci9 == initIdx then {
            promoteForInit :ast :c0Id :dst
        } else {
            promoteForCond :ast :ctr :c0Id :suspends :dst :nconds
        }
    }
    nposts: ListVal u32
    piter: postIds.iterate
    for p0Id: piter loop {
        pp0: cloneTreeAt :ast nid: (zast.nodeid.create from: p0Id)
        nposts.append (zast.tableAdd :ast n: pp0)
    }
    return (astnode.forexpr (zast.forrow
        nodeid: (zast.tableReserve :ast)
        lineno: lnS
        colno: coS
        conditions: (zast.kidsAdd kids: ast.kids xs: nconds)
        body: (zast.nodeid.create from: nbodyId)
        postconditions: (zast.kidsAdd kids: ast.kids xs: nposts)
    )
    )
}

# true when condition `n` is a trivial always-true form.
condIsTrivial: function {n: astnode.view} out bool is {
    match (
        n
    ) case atomid then {
        return true
    } else {
        return false
    }
}

# clonePlanOf -- read-only: how `n` copies, with its child ids (canonical order)
# appended to `kids` when it copies child by child. 0 copies the row whole as a
# path (clonePathAt); 1 copies every child; 2 is a dottedpath, whose child is a
# field label or an operator and copies as a path; 3 is a caseclause, whose arm
# pattern copies as a path.
clonePlanOf: function {ast: Ast.view n: astnode.view kids: ListVal u32} out u32 is {
    mode: 1.u32
    match (
        n
    ) case dottedpath then {
        mode = 2
    } case caseclause then {
        mode = 3
    } case error then {
        mode = 0
    } case datablock then {
        mode = 0
    } case functiondef then {
        mode = 0
    } case objectdef then {
        mode = 0
    } case unitdef then {
        mode = 0
    } case program then {
        mode = 0
    } case placeholder then {
        mode = 0
    } else null
    if mode > 0 then {
        ids: zast.childIds :ast :n
        with it: ids.iterate do for i: it loop kids.append from: i
    }
    return mode
}

# cloneTreeKids -- copy each child by id (as a path at the plan's path-only
# positions) and intern the copies, in order.
cloneTreeKids: function {ast: Ast kids: (ListVal u32).view mode: u32} out ListVal u32 is {
    cloned: ListVal u32
    ki: u64
    kn: kids.length
    for ki < kn loop {
        kid: zast.nodeid.create from: (kids.get i: ki)
        pathOnly: (
            mode == 2 and (ki == 1) or (mode == 3 and (ki == 0))
        )
        if pathOnly then {
            c0: clonePathAt :ast nid: kid
            cloned.append (zast.tableAdd :ast n: c0)
        } else {
            r0: cloneTreeAt :ast nid: kid
            cloned.append (zast.tableAdd :ast n: r0)
        }
        ki = ki + 1
    }
    return cloned
}

# cloneTreeAt -- a deep copy of the row `nid` names, keeping every position. Each
# row view is scoped to a block that lends nothing: the plan is read first, the
# children are copied next (by id), then the copy's slot is reserved, then the
# arm is built from the row.
cloneTreeAt: function {ast: Ast nid: zast.nodeid} out astnode is {
    kids: ListVal u32
    mode: u32
    {
        n: ast.nodes.get i: nid.u64
        mode = clonePlanOf :ast :n :kids
    }
    if mode == 0 then return (clonePathAt :ast :nid)
    cloned: cloneTreeKids :ast :kids :mode
    myId: zast.tableReserve :ast
    built: astnode.placeholder
    {
        n: ast.nodes.get i: nid.u64
        built = cloneTreeArm :n :myId :cloned kids: ast.kids
    }
    return built
}

# cloneTreeArm -- the copy of `n`'s arm under `myId`, its children the interned
# copies in `cloned` (canonical childIds order; an absent optional child is simply
# not there). Reads the view only.
cloneTreeArm: function {
    kids: ListVal u32
    n: astnode.view
    myId: zast.nodeid
    cloned: (ListVal u32).view
} out astnode is {
    match (
        n
    ) case atomid then {
        return (astnode.atomid (zast.atomidrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
        )
        )
    } case labelvalue then {
        return (astnode.labelvalue (zast.labelvaluerow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
        )
        )
    } case dottedpath then {
        return (astnode.dottedpath (zast.dottedpathrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            parent: (zast.nodeid.create from: (cloned.get i: 0))
            child: (zast.nodeid.create from: (cloned.get i: 1))
        )
        )
    } case call then {
        return (astnode.call (zast.callrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            callable: (zast.nodeid.create from: (cloned.get i: 0))
            arguments: (zast.kidsAddWindow :kids xs: (cloned.slice from: 1 to: cloned.length))
            infix: n.infix
        )
        )
    } case namedoperation then {
        return (astnode.namedoperation (zast.namedoperationrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
            operation: (zast.nodeid.create from: (cloned.get i: 0))
        )
        )
    } case statement then {
        return (astnode.statement (zast.statementrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            statements: (zast.kidsAddWindow :kids xs: (cloned.slice from: 0 to: cloned.length))
        )
        )
    } case statementline then {
        return (astnode.statementline (zast.statementlinerow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            statementline: (zast.nodeid.create from: (cloned.get i: 0))
        )
        )
    } case assignment then {
        return (astnode.assignment (zast.assignmentrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
            value: (zast.nodeid.create from: (cloned.get i: 0))
        )
        )
    } case reassignment then {
        return (astnode.reassignment (zast.reassignmentrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            topath: (zast.nodeid.create from: (cloned.get i: 0))
            value: (zast.nodeid.create from: (cloned.get i: 1))
        )
        )
    } case swapstmt then {
        return (astnode.swapstmt (zast.swapstmtrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            lhs: (zast.nodeid.create from: (cloned.get i: 0))
            rhs: (zast.nodeid.create from: (cloned.get i: 1))
        )
        )
    } case ifexpr then {
        k: n.clauses.count.u64
        els: zast.nodeid
        if n.elseclause > 0 then els = zast.nodeid.create from: (cloned.get i: k)
        return (astnode.ifexpr (zast.ifrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            clauses: (zast.kidsAddWindow :kids xs: (cloned.slice from: 0 to: k))
            elseclause: els
        )
        )
    } case ifclause then {
        k: n.conditions.count.u64
        return (astnode.ifclause (zast.ifclauserow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            conditions: (zast.kidsAddWindow :kids xs: (cloned.slice from: 0 to: k))
            statement: (zast.nodeid.create from: (cloned.get i: k))
        )
        )
    } case forexpr then {
        k: n.conditions.count.u64
        bodyId: zast.nodeid
        postsAt: k
        if n.body > 0 then {
            bodyId = zast.nodeid.create from: (cloned.get i: k)
            postsAt = k + 1
        }
        return (astnode.forexpr (zast.forrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            conditions: (zast.kidsAddWindow :kids xs: (cloned.slice from: 0 to: k))
            body: bodyId
            postconditions: (zast.kidsAddWindow
                :kids
                xs: (cloned.slice from: postsAt to: cloned.length)
            )
        )
        )
    } case doexpr then {
        return (astnode.doexpr (zast.dorow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            statement: (zast.nodeid.create from: (cloned.get i: 0))
        )
        )
    } case withexpr then {
        return (astnode.withexpr (zast.withrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
            value: (zast.nodeid.create from: (cloned.get i: 0))
            body: (zast.nodeid.create from: (cloned.get i: 1))
        )
        )
    } case caseexpr then {
        k: n.clauses.count.u64
        els: zast.nodeid
        if n.elseclause > 0 then els = zast.nodeid.create from: (cloned.get i: k + 1)
        return (astnode.caseexpr (zast.caserow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            subject: (zast.nodeid.create from: (cloned.get i: 0))
            clauses: (zast.kidsAddWindow :kids xs: (cloned.slice from: 1 to: k + 1))
            elseclause: els
        )
        )
    } case caseclause then {
        return (astnode.caseclause (zast.caseclauserow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            name: n.name
            matcharm: (zast.nodeid.create from: (cloned.get i: 0))
            statement: (zast.nodeid.create from: (cloned.get i: 1))
        )
        )
    } case atomstring then {
        return (astnode.atomstring (zast.atomstringrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            stringparts: (zast.kidsAddWindow :kids xs: (cloned.slice from: 0 to: cloned.length))
        )
        )
    } case stringchunk then {
        ckL: n.chunkKind
        return (astnode.stringchunk (zast.stringchunkrow
            nodeid: myId
            lineno: n.lineno
            colno: n.colno
            text: n.text
            chunkKind: ckL
        )
        )
    } else {
        return astnode.placeholder
    }
}

# i64TypePath -- the `system.i64` type path the state cursor and the loop
# counters are declared with. Minted fresh per field: a type path is a node, and
# two fields may not share one.
i64TypePath: function {
    # the tree the path is minted into
    ast: Ast
    # the line the field is attributed to
    line: u32
    # the column likewise
    col: u32
} out astnode is {
    sysAtom: mkAtom :ast :line :col name: "system"
    i64Leaf: mkAtom :ast :line :col name: "i64"
    return (astnode.dottedpath (zast.dottedpathrow
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        parent: (zast.tableAdd :ast n: sysAtom)
        child: (zast.tableAdd :ast n: i64Leaf)
    )
    )
}

# wrapDeclaredCallReturn -- `out U` on a declared `call` is the ELEMENT type, so
# the option wrapper goes on here and the ownership leaf selects it exactly as
# `Gives:` did. Answers the wrapper node's id -- the id the optionval collapse
# is keyed on -- or 0 when `call` declares no element type.
wrapDeclaredCallReturn: function {
    # the tree the wrapper is minted into
    ast: Ast
    # the `call` whose return type is being wrapped
    callFnId: zast.nodeid
    # the line the wrapper is attributed to
    line: u32
    # the column likewise
    col: u32
} out u32 is {
    retId: zast.nodeid
    {
        cf: ast.nodes.get i: callFnId.u64
        if cf.functiondef then retId = cf.returntype
    }
    if retId.isZero then return 0
    gp: (GivesParts
        base: optionval.none astnode
        leaf: "".string
    )
    givesFromOp :ast nid: retId dst: gp
    gb: gp.base
    match (
        gb
    ) case some then {
        wrapper: buildWrapper :ast :line :col base: gb leaf: gp.leaf.stringView
        wid: zast.tableAdd :ast n: wrapper
        cfm: ast.nodes.getMut i: callFnId.u64
        if cfm.functiondef then cfm.returntype = zast.nodeid.create from: wid
        return wid
    } case none then null
    return 0
}

# injectCallReceiver -- the receiver `call` is declared to have implicitly. The
# state machine writes through it, so it is a borrow like every other receiver,
# and it goes FIRST: the input parameter the author may have written keeps its
# own position and its own call-site label behind it.
injectCallReceiver: function {
    # the tree the parameter is minted into
    ast: Ast
    # the `call` gaining the receiver
    callFnId: zast.nodeid
    # the line the parameter is attributed to
    line: u32
    # the column likewise
    col: u32
} is {
    thisP: mkAtom :ast :line :col name: "this"
    thisParam: mkNamedOp :ast :line :col name: "this" op: thisP
    tpId: zast.tableAdd :ast n: thisParam
    cfm2: ast.nodes.getMut i: callFnId.u64
    if cfm2.functiondef then {
        rest: ListVal u32
        rest.append tpId
        pax1569: u64
        for pax1569 < cfm2.parameters.count.u64 loop {
            pId: zast.kidAt kids: ast.kids span: cfm2.parameters i: pax1569
            pax1569 = pax1569 + 1
            rest.append pId
        }
        cfm2.parameters = zast.kidsAdd kids: ast.kids xs: rest
    }
}

# buildDeclaredCreate -- `.create` generated from the `is` fields, in order, and
# appended to the `as` block. The parameter's ownership follows the FIELD's: an
# owned field takes ownership of its argument, a non-owned one borrows it, and
# `outx this` pins whatever a non-owned field points into for the instance's
# lifetime.
buildDeclaredCreate: function {
    # the tree the create is minted into
    ast: Ast
    # the generator definition gaining the create
    objId: zast.nodeid
    # the line the create is attributed to
    line: u32
    # the column likewise
    col: u32
    # the author's `is` field names, in declaration order
    authorNames: (List String).view
    # their type nodes, in the same order
    authorTypes: (ListVal u64).view
} is {
    createParams: ListVal u32
    anyRef: false
    api: u64
    apn: authorNames.length
    for api < apn loop {
        a0: authorNames.get i: api
        a0v: a0.stringView
        at0: authorTypes.get i: api
        if (typePathIsReference
            :ast
            nid: (zast.nodeid.create from: at0.u32.orPanic)
        ) then anyRef = true
        ap0: createParamPath :ast nid: (zast.nodeid.create from: at0.u32.orPanic)
        np0: mkNamedOp :ast :line :col name: a0v op: ap0
        createParams.append (zast.tableAdd :ast n: np0)
        api = api + 1
    }
    createM: (buildCreateMethod
        :ast
        :line
        :col
        params: createParams
        fwdNames: authorNames
        pins: anyRef
    )
    cmN: mkNamedOp :ast :line :col name: "create" op: createM
    cmId: zast.tableAdd :ast n: cmN
    objc: ast.nodes.getMut i: objId.u64
    if objc.objectdef then {
        asMerged: ListVal u32
        asx1799: u64
        for asx1799 < objc.asItems.count.u64 loop {
            aId2: zast.kidAt kids: ast.kids span: objc.asItems i: asx1799
            asx1799 = asx1799 + 1
            asMerged.append aId2
        }
        asMerged.append cmId
        objc.asItems = zast.kidsAdd kids: ast.kids xs: asMerged
    }
}

# appendDeclaredFields -- the fields the suspension transform needs, appended
# after the ones the author declared. Order matters: the generated `create`
# forwards the author's fields by name and leaves these to their first write.
appendDeclaredFields: function {
    # the tree holding the definition
    ast: Ast
    # the generator definition gaining the fields
    objId: zast.nodeid
    # the field nodes to append, in order
    addFields: (ListVal u32).view
} is {
    objm: ast.nodes.getMut i: objId.u64
    if objm.objectdef then {
        merged: ListVal u32
        isx1969: u64
        for isx1969 < objm.isItems.count.u64 loop {
            iId: zast.kidAt kids: ast.kids span: objm.isItems i: isx1969
            isx1969 = isx1969 + 1
            merged.append iId
        }
        with afit: addFields.iterate do for afId: afit loop merged.append afId
        objm.isItems = zast.kidsAdd kids: ast.kids xs: merged
    }
}

# callBodyIdOf -- the body of a `call` functiondef; 0 when it has none. Asked
# again after the iterable hoist, which replaces the body with a new node.
callBodyIdOf: function {
    # the tree holding the function
    ast: Ast.view
    # the `call` whose body is wanted
    callFnId: zast.nodeid
} out zast.nodeid is {
    cf: ast.nodes.get i: callFnId.u64
    match (
        cf
    ) case functiondef then {
        return cf.body
    } else {
        return (zast.nodeid.create from: 0)
    }
}

# declaredInputTypeId -- the per-call input parameter's type node on a declared
# `call`, 0 when it declares none. Asked BEFORE the receiver is injected, so the
# input is the first parameter; afterwards it is the second.
declaredInputTypeId: function {
    # the tree holding the function
    ast: Ast.view
    # the `call` whose input is wanted
    callFnId: zast.nodeid
} out zast.nodeid is {
    cf: ast.nodes.get i: callFnId.u64
    if cf.functiondef then {
        pax1579: u64
        for pax1579 < cf.parameters.count.u64 loop {
            pId: zast.kidAt kids: ast.kids span: cf.parameters i: pax1579
            pax1579 = pax1579 + 1
            pn: ast.nodes.get i: pId.u64
            if pn.namedoperation then return pn.operation
        }
    }
    return (zast.nodeid.create from: 0)
}

# resumeFieldPath -- the `_resume_input` field's type for a declared input. The
# field holds the most recent resumed value: an OWNED input (`.take` / `.hold`)
# strips to an owned field, a non-owned one (`.borrow` / `.view`) keeps its
# marker, and an unmarked one is a reference into the caller's argument for the
# call's duration, so it becomes a `.borrow` field. Read by NAME ID for the same
# reason createParamPath is.
resumeFieldPath: function {
    # the tree the field type is minted into
    ast: Ast
    # the input parameter's declared type node
    nid: zast.nodeid
} out astnode is {
    leafId: zast.nameid
    parentId: zast.nodeid
    line: u32
    col: u32
    {
        pp: zast.posOf n: (ast.nodes.get i: nid.u64)
        line = pp.line
        col = pp.col
        bn: ast.nodes.get i: nid.u64
        if bn.dottedpath then {
            parentId = bn.parent
            leafId = leafAtomNameId :ast n: (ast.nodes.get i: bn.child.u64)
        }
    }
    if leafId == zast.names.wkBorrow then return (clonePathAt :ast :nid)
    if leafId == zast.names.wkView then return (clonePathAt :ast :nid)
    isOwned: leafId == zast.names.wkTake or (leafId == zast.names.wkHold)
    if isOwned then {
        if parentId.isZero.not then return (clonePathAt :ast nid: parentId)
        return (clonePathAt :ast :nid)
    }
    base: clonePathAt :ast :nid
    bl: mkAtom :ast :line :col name: "borrow"
    return (astnode.dottedpath (zast.dottedpathrow
        nodeid: (zast.tableReserve :ast)
        lineno: line
        colno: col
        parent: (zast.tableAdd :ast n: base)
        child: (zast.tableAdd :ast n: bl)
    )
    )
}

# DeclParts -- what one pass over a `generator`'s definition yields: where it
# was written, its `call`, and the fields the author declared. The `is` list is
# read ONCE, before this pass appends its own fields, so the generated `create`
# takes exactly the author's and never the state machine's.
DeclParts: class {
    # `call`'s functiondef node, 0 when the definition declares none
    callFnId: zast.nodeid
    # the line the definition was written on, for the nodes minted against it
    line: u32
    # the column it was written at, likewise
    colno: u32
    # the author's `is` field names, in declaration order
    names: List String
    # their type nodes, in the same order
    types: ListVal u64
    # the per-call input parameter's type node, 0 when `call` declares none.
    # Read before the receiver is injected, so it is the FIRST parameter here.
    inputTypeId: zast.nodeid
}

# readDeclaredParts -- fill `dst` from one `generator` objectdef.
readDeclaredParts: function {
    # the tree holding the definition
    ast: Ast.view
    # the generator definition to read
    objId: zast.nodeid
    # filled with what the definition declares
    dst: DeclParts
} is {
    obn: ast.nodes.get i: objId.u64
    if obn.objectdef then {
        dst.line = obn.lineno
        dst.colno = obn.colno
        asx1809: u64
        for asx1809 < obn.asItems.count.u64 loop {
            amId: zast.kidAt kids: ast.kids span: obn.asItems i: asx1809
            asx1809 = asx1809 + 1
            am: ast.nodes.get i: amId.u64
            if am.namedoperation when am.name == zast.names.wkCall then {
                dst.callFnId = am.operation
                dst.inputTypeId = declaredInputTypeId :ast callFnId: am.operation
            }
        }
        # the AUTHOR's fields, read before this pass appends its own: the
        # generated `create` takes exactly these, so what the state machine
        # needs never reaches the construction site.
        isx1979: u64
        for isx1979 < obn.isItems.count.u64 loop {
            imId: zast.kidAt kids: ast.kids span: obn.isItems i: isx1979
            isx1979 = isx1979 + 1
            im: ast.nodes.get i: imId.u64
            if im.namedoperation then {
                inm: zast.nameTextAt :ast ref: im.name
                dst.names.append inm.copy
                dst.types.append im.operation.u64
            }
        }
    }
}

# appendResumeFields -- the resume slots and the input store, for a `call` that
# declares a per-call input. A yield hoisted out of expression position leaves
# its resumed value in one of these, not in a C local: the suspension RETURNS
# from `.call`, so a local does not survive a later suspension in the same
# statement. One slot per suspension point, numbered as the emitter numbers its
# resume labels.
appendResumeFields: function {
    # the tree the counter fields are minted into
    ast: Ast
    # the line a counter field is attributed to
    line: u32
    # the column likewise
    col: u32
    # the input parameter's declared type node
    inputTypeId: zast.nodeid
    # how many suspension points the body has
    yieldSlots: u64
    # the field list the counters join
    addFields: ListVal u32
} is {
    yvi: u64
    for yvi < yieldSlots loop {
        yvi = yvi + 1
        yvT: resumeFieldPath :ast nid: inputTypeId
        yvNm: "_yv_\{yvi}"
        yvF: mkNamedOp :ast :line :col name: yvNm.stringView op: yvT
        addFields.append (zast.tableAdd :ast n: yvF)
    }
    riT: resumeFieldPath :ast nid: inputTypeId
    riF: mkNamedOp :ast :line :col name: "_resume_input" op: riT
    addFields.append (zast.tableAdd :ast n: riF)
}

# appendForCounterFields -- one counter field per label-bound `for` whose body
# suspends. A `for` counter lives only in the C header, and `goto L_resume_k`
# jumps in past the init clause, so it has to be a field like everything else
# live across a suspension. It is not a local the checker binds: a `for` label
# is a nameid on the header's namedoperation, not an assignment. The loop's
# PAYLOAD and its constructed iterable are the checker's fields
# (forPayloadField, forIterableField), minted where their types are known.
appendForCounterFields: function {
    # the tree the resume fields are minted into
    ast: Ast
    # the line a resume field is attributed to
    line: u32
    # the column likewise
    col: u32
    # how many suspending `for` loops the body has
    forSlots: u64
    # the field list the resume fields join
    addFields: ListVal u32
} is {
    fci: u64
    for fci < forSlots loop {
        fci = fci + 1
        fcTy: i64TypePath :ast :line :col
        fcNm: "_fc_\{fci}"
        fcF: mkNamedOp :ast :line :col name: fcNm.stringView op: fcTy
        addFields.append (zast.tableAdd :ast n: fcF)
    }
}

# GenDeclared -- what preparing a declared `generator` leaves the checker to
# record: the `call` whose body `yield` is legal in, and the wrapper node whose
# Option collapses to `optionval` over a valtype element. Both are node ids the
# checker keys side tables on; nothing here is a node the pass hands back.
GenDeclared: class {
    # `call`'s own functiondef node, 0 when there was no `call` to prepare
    callFnId: u32
    # the `.call` return wrapper, 0 when `call` declares no element type
    wrapperNodeId: u32
    # the body binds `yield`'s own value while `call` declares no input to
    # receive: the binding names a value nothing can ever supply
    readsAbsentInput: bool
}

# createParamPath -- the generated `create`'s parameter type for one `is` field.
# An OWNED field (no marker, or `.take` / `.hold`) takes a `.take` parameter:
# the field owns what it is given, and a create whose parameter merely borrowed
# it could not move it into the instance -- that refusal is what a bare reftype
# capture used to hit. A non-owned field (`.borrow` / `.view`) keeps its own
# marker, and the create's `outx this` pins the source it points into.
createParamPath: function {
    # the tree the parameter type is minted into
    ast: Ast
    # the field's declared type node
    nid: zast.nodeid
} out astnode is {
    # the leaf is read by NAME ID, not through pathLeafName: that one answers
    # only take/lock/borrow, and a `.view` field read through it comes back
    # unmarked and would be handed a `.take` parameter -- an owned copy of a
    # reference. That is the same take/lock/borrow blind spot this whole form
    # exists to delete, and it is easy to reintroduce by reusing the reader.
    leafId: zast.nameid
    parentId: zast.nodeid
    {
        bn: ast.nodes.get i: nid.u64
        if bn.dottedpath then {
            parentId = bn.parent
            leafId = leafAtomNameId :ast n: (ast.nodes.get i: bn.child.u64)
        }
    }
    isNonOwned: leafId == zast.names.wkBorrow or (leafId == zast.names.wkView)
    if isNonOwned then return (clonePathAt :ast :nid)
    base: clonePathAt :ast :nid
    if parentId.isZero.not then base = clonePathAt :ast nid: parentId
    takeLeaf: mkAtom :ast line: 0 col: 0 name: "take"
    return (astnode.dottedpath (zast.dottedpathrow
        nodeid: (zast.tableReserve :ast)
        lineno: 0
        colno: 0
        parent: (zast.tableAdd :ast n: base)
        child: (zast.tableAdd :ast n: takeLeaf)
    )
    )
}

# lowerDeclared -- prepare one DECLARED `generator` for the ordinary class walk.
#
# The class is authored here, not synthesised: its fields are the `is` block and
# its `call` is a written method, so this pass adds only what the suspension
# transform needs and nothing that the author already said. `call` gains the
# receiver it is declared to have implicitly and the option wrapper around its
# ELEMENT type; the state cursor, the loop counters and the resume slots are
# appended as fields.
#
# The captured-parameter half of `lowerOne` has no counterpart here, and that is
# the point of the form: an `is` field is read as `this.x` because the author
# wrote it that way, so nothing is promoted on its behalf and its ownership is
# whatever the field declares.
#
# Fills `dst` with the two node ids the checker keys side tables on: `call`'s
# own functiondef -- the id `yield` legality is keyed on, the same id lowerOne
# hands back for the `.call` it mints -- and the return wrapper, whose Option
# collapses to `optionval` over a valtype element. Both stay 0 when there is no
# `call` to prepare; the checker reports that, this pass only declines to touch
# it.
lowerDeclared: function {
    # the tree the definition lives in
    ast: Ast
    # the generator definition to prepare
    objId: zast.nodeid
    # filled with the node ids the checker keys its side tables on
    dst: GenDeclared
} is {
    parts: (DeclParts
        callFnId: (zast.nodeid.create from: 0)
        line: 0
        colno: 0
        names: List String
        types: ListVal u64
        inputTypeId: (zast.nodeid.create from: 0)
    )
    readDeclaredParts :ast :objId dst: parts
    ctr: NameCtr next: 0
    line: parts.line
    col: parts.colno
    callFnId: parts.callFnId
    if callFnId.isZero then return
    bodyId: callBodyIdOf :ast :callFnId
    if bodyId.isZero then return

    dst.wrapperNodeId = wrapDeclaredCallReturn :ast :callFnId :line :col
    injectCallReceiver :ast :callFnId :line :col
    spillBeforeYields :ast :ctr nid: bodyId
    # the suspension transform, on the body the author wrote
    newBodyId: promoteIterablesIdAt :ast :ctr oId: bodyId
    if newBodyId > 0 then {
        cfm3: ast.nodes.getMut i: callFnId.u64
        if cfm3.functiondef then cfm3.body = zast.nodeid.create from: newBodyId
    }
    bodyId2: callBodyIdOf :ast :callFnId
    # one resume SLOT per suspension point and one counter per suspending loop,
    # counted by the SAME functions the emitter numbers its resume labels and
    # draws its counters with. An out-only generator has no slots: they hold the
    # value a suspension is RESUMED with, and nothing resumes one with a value.
    yieldSlots: u64
    forSlots: u64
    {
        body: ast.nodes.get i: bodyId2.u64
        yieldSlots = zast.yieldCountOf :ast n: body
        forSlots = zast.suspendingForCountOf :ast n: body
        # `a: yield e` binds the value the NEXT call supplies. With no input
        # declared there is no next value, so the binding is a read of something
        # that cannot exist -- reported by the checker, which holds the errors.
        if parts.inputTypeId.isZero when (bindsYieldValue :ast n: body
        ) then dst.readsAbsentInput = true
    }

    # the fields the transform needs, appended to the ones the author declared.
    # The body's locals are the checker's: it keeps each in a field of its own.
    addFields: ListVal u32
    {
        stTy: i64TypePath :ast :line :col
        stField: mkNamedOp :ast :line :col name: "state" op: stTy
        addFields.append (zast.tableAdd :ast n: stField)
    }
    appendForCounterFields :ast :line :col :forSlots :addFields
    if parts.inputTypeId.isZero.not then (appendResumeFields
        :ast
        :line
        :col
        inputTypeId: parts.inputTypeId
        :yieldSlots
        :addFields
    )
    buildDeclaredCreate :ast :objId :line :col authorNames: parts.names authorTypes: parts.types
    appendDeclaredFields :ast :objId :addFields
    dst.callFnId = callFnId.u32
}
