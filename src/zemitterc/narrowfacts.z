# narrowfacts -- narrowing facts: arm seeds, variable entries, aliases. An
# implementation subunit of zemitterc.

# isOrdinalVariant -- the value IS its own discriminator: no tag field to read,
# no struct to compose, and `==` rather than a comparator.
#
# Reads the record rather than asking ordinalVariantCType and measuring what it
# says: this is a QUESTION, asked 11503 times in a self-compile, and building a
# string to answer it allocated once per ask.
isOrdinalVariant: function {prog: Program.view tid: ztypes.tid} out bool is {
    ao: prog.typing.ordinalVariant.get key: tid
    match (
        ao
    ) case some then {
        return true
    } case none then {
        return false
    }
}

# atomTextOf -- an atomid node's name text ("" for any other shape), a view
# into the pool: the tree is read-only throughout emission, so the text is
# never copied out of it. The node is taken by copy: the text points into
# `ast`'s pool, never into it, so only `ast` stays locked.
atomTextOf: function {prog: Program.view n: astnode} outx StringView is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextAt ast: prog.ast ref: n.name).stringView
    } else {
        return ""
    }
}

# dottedArmPredicateTid -- the arm-predicate stamp for a dotted node: the
# variant/union type id when `value.arm` is a tag test; 0 otherwise.
dottedArmPredicateTid: function {prog: Program.view nid: zast.nodeid} out ztypes.tid is {
    return ((prog.typing.dpArmPredicate.get key: nid).or d: ztypes.tid.zero)
}

# varArmsGet -- the arms recorded for `vid`, none when absent.
varArmsGet: function {xs: (List VarArms).view vid: ztypes.vid} out ListVal zast.nameid is {
    f: vidFind :xs :vid
    if f > 0 then return (xs.get i: f - 1).arms.copy
    none: ListVal zast.nameid
    return none
}

# varArmsSet -- replace-or-append: one entry per variable.
varArmsSet: function {xs: List VarArms vid: ztypes.vid arms: (ListVal zast.nameid).view} is {
    if vid.isZero then return
    f: vidFind :xs :vid
    if f > 0 then {
        xs.set i: f - 1 val: (VarArms :vid arms: arms.copy)
    } else {
        xs.append (VarArms :vid arms: arms.copy)
    }
}

# idListHas -- whether name id `id` is in `xs`.
idListHas: function {xs: (ListVal zast.nameid).view id: zast.nameid} out bool is {
    for each x: xs loop {
        if x == id then return true
    }
    return false
}

# vidFind -- the 1-based index of `vid`'s entry in `xs`, an assoc list keyed by
# variable id (VarEntry, VarTid, VarArms), 0 when absent. The
# value is copied only on a hit, so a miss allocates nothing at all. varEntryGet's
# empty-String sentinel cost 277,711 one-byte allocations on a self-compile
# (2.9% of every allocation the compiler makes) because the miss is the common
# case: read through this, not varEntryGet, on any hot path.
vidFind: function as { T: AnyRef.generic } in {xs: (List T).view vid: ztypes.vid} out u64 is {
    if vid.isZero then return 0
    i: u64
    n: xs.length
    for i < n loop {
        if (xs.get :i).vid == vid then return i + 1
        i = i + 1
    }
    return 0
}

# varEntryGet -- the value recorded for `vid`, "" when absent (values never empty).
varEntryGet: function {xs: (List VarEntry).view vid: ztypes.vid} out String is {
    f: vidFind :xs :vid
    if f == 0 then return "".string
    return (xs.get i: f - 1).val.copy
}

# true when list `xs` has an entry for `vid`.
varEntryHas: function {xs: (List VarEntry).view vid: ztypes.vid} out bool is {
    return (vidFind :xs :vid) > 0
}

# varEntryFactsOf -- the facts recorded for `vid`'s value; none stated when absent.
varEntryFactsOf: function {xs: (List VarEntry).view vid: ztypes.vid} out exprfacts is {
    f: vidFind :xs :vid
    if f == 0 then return exprfacts
    return (xs.get i: f - 1).facts
}

# varEntryHasPtr -- `vid`'s entry reads through a pointer (a borrow alias).
varEntryHasPtr: function {xs: (List VarEntry).view vid: ztypes.vid} out bool is {
    f: vidFind :xs :vid
    if f == 0 then return false
    return (xs.get i: f - 1).ptr.length > 0
}

# varEntryPtrOf -- the pointer `vid`'s entry reads through, "" when it has none.
varEntryPtrOf: function {xs: (List VarEntry).view vid: ztypes.vid} out String is {
    f: vidFind :xs :vid
    if f == 0 then return "".string
    return (xs.get i: f - 1).ptr.copy
}

# the type id bound to `vid` in `xs`, or none.
varTidGet: function {xs: (List VarTid).view vid: ztypes.vid} out optionval ztypes.tid is {
    f: vidFind :xs :vid
    if f == 0 then return (optionval.none ztypes.tid)
    return (optionval.some (xs.get i: f - 1).tid)
}

# pushNarrow -- point `vid` at the narrowed value `val` of type `tid`, saving
# what the narrow tables held so restoreNarrowSeeds can put it back. The saved
# pair is appended newest last, one per seeded vid.
pushNarrow: function {
    narrow: NarrowState
    vid: ztypes.vid
    val: StringView
    valF: exprfacts
    tid: ztypes.tid
    prevV: List String
    prevF: ListVal exprfacts
    prevT: ListVal ztypes.tid
} is {
    pv: varEntryGet xs: narrow.box :vid
    prevV.append pv
    prevF.append (varEntryFactsOf xs: narrow.box :vid)
    prevT.append ((varTidGet xs: narrow.tid :vid).or d: ztypes.tid.zero)
    stmtblocks.varEntrySet xs: narrow.box :vid :val facts: valF
    stmtblocks.varTidSet xs: narrow.tid :vid :tid
}

# aliasResolvesToSelf -- does `vid` stand for its own name, rather than for a
# narrowing box or a take alias? The question aliasResolve is asked when the
# caller wants no text, only the answer; asking it this way copies nothing.
aliasResolvesToSelf: function {
    narrow: NarrowState.view name: StringView vid: ztypes.vid
} out bool is {
    nb: vidFind xs: narrow.box :vid
    if nb > 0 then {
        eNb: narrow.box.get i: nb - 1
        return eNb.val.stringView == name
    }
    al: vidFind xs: narrow.aliases :vid
    if al > 0 then {
        eAl: narrow.aliases.get i: al - 1
        return eAl.val.stringView == name
    }
    return true
}

# aliasResolveWith -- aliasResolve, the entry's facts stated into `facts`; none
# stated when no table has an entry for the variable.
aliasResolveWith: function {
    ctx: Ctx name: StringView vid: ztypes.vid facts: exprfacts.borrow
} out String is {
    nb: vidFind xs: ctx.narrow.box :vid
    if nb > 0 then {
        noteAliasRead :ctx :vid
        return (entryText xs: ctx.narrow.box at: nb - 1 :facts)
    }
    al: vidFind xs: ctx.narrow.aliases :vid
    if al > 0 then return (entryText xs: ctx.narrow.aliases at: al - 1 :facts)
    return name.string
}

# aliasResolve -- a `.take` alias's base C name, or the name itself if none.
aliasResolve: function {ctx: Ctx name: StringView vid: ztypes.vid} out String is {
    # A match-arm narrowing (narrowBox) takes priority: inside the arm the
    # variable resolves to the narrowed union payload cast, not the un-narrowed
    # binding or a stale for-loop/borrow/take alias -- mirrors emitLocalAtomName.
    # `name` is only what comes back when neither table has an entry.
    nb: vidFind xs: ctx.narrow.box :vid
    if nb > 0 then {
        noteAliasRead :ctx :vid
        return (ctx.narrow.box.get i: nb - 1).val.copy
    }
    al: vidFind xs: ctx.narrow.aliases :vid
    if al > 0 then return (ctx.narrow.aliases.get i: al - 1).val.copy
    return name.string
}

# atomOrBaseText -- the atom's own text, or a dotted path's base atom's text:
# the two shapes a receiver or a `.take` source is spelt in ("" otherwise).
atomOrBaseText: function {prog: Program.view n: astnode.view} outx StringView is {
    t: atomTextOf :prog :n
    if t.length > 0 then return t
    return (callorder.dottedBaseAtom :prog :n)
}

# typedefBorrowSource -- the source node of a borrowed typedef (`Bytes xs.borrow`,
# `Bytes.create from: xs.borrow`), the path under its `.borrow`; 0 for any other
# value.
# The binding is a second name for that source.
typedefBorrowSource: function {
    prog: Program.view
    n: astnode.view
} out zast.nodeid is {
    match (
        n
    ) case statementline then {
        return (typedefBorrowSource :prog n: (prog.ast.nodes.getView i: n.statementline))
    } case call then {
        ck: prog.typing.callKind.get key: n.nodeid
        if ck.none then return zast.nodeid
        if ck != zast.callkind.typedefBorrow then return zast.nodeid
        return (underBorrowMarker :prog nid: (castSourceArg :prog call: n))
    } else {
        return zast.nodeid
    }
}

# castSourceArg -- the value a cast is built from: its `from:` argument, or its
# one unlabelled argument; 0 when it has neither.
castSourceArg: function {prog: Program.view call: zast.callrow.view} out zast.nodeid is {
    for each aId: (zast.kidsOf ast: prog.ast span: call.arguments) loop {
        a: prog.ast.nodes.getView i: aId
        if a.namedoperation when (
            a.name.isZero or (a.name == zast.wellKnown.slot.wkFrom)
        ) then return a.operation
    }
    return zast.nodeid
}

# underBorrowMarker -- the path a `.borrow` marker is written on (`xs` of
# `xs.borrow`), else the node itself.
underBorrowMarker: function {prog: Program.view nid: zast.nodeid} out zast.nodeid is {
    if nid.isZero then return zast.nodeid
    src: prog.ast.nodes.getView i: nid
    if src.dottedpath.not then return nid
    if (
        (aliasOrChildId :prog aliasId: src.nodeid childId: src.child) !=
        zast.wellKnown.slot.wkBorrow
    ) then return nid
    return src.parent
}

# emitLocalAtomNameWith -- emitLocalAtomName, its facts stated into `facts`.
emitLocalAtomNameWith: function {
    prog: Program.view
    ctx: Ctx
    name: StringView
    vid: ztypes.vid
    facts: exprfacts.borrow
} out String is {
    # Probed directly rather than through aliasResolve: that would synthesize a
    # copy of `name` for the no-alias case, which is the common one, only for the
    # comparison below to discard it.
    nb: vidFind xs: ctx.narrow.box :vid
    if nb > 0 then {
        noteAliasRead :ctx :vid
        return (entryText xs: ctx.narrow.box at: nb - 1 :facts)
    }
    al: vidFind xs: ctx.narrow.aliases :vid
    if al > 0 then return (entryText xs: ctx.narrow.aliases at: al - 1 :facts)
    return (localnames.localNameText :prog :ctx :vid :name :facts)
}

# entryText -- the text an alias or narrowing entry records for a variable, and
# its facts.
entryText: function {xs: (List VarEntry).view at: u64 facts: exprfacts.borrow} out String is {
    e: xs.get i: at
    return (stating :facts from: e.facts text: e.val.copy)
}

# narrowingEndedAt -- whether the read at `nid` sees the WHOLE local although a
# narrowing aliases its name to a payload: a write ended the narrowing before
# this read -- in this block, in a scope nested before it, in the loop around
# it -- or the read is a write's own target, which is the whole local. The
# checker records each such read (ZTyping.wholeLocalReads), so the emitter never
# has to re-derive where a narrowing ends.
narrowingEndedAt: function {
    prog: Program.view
    narrow: NarrowState.view
    nid: zast.nodeid
    vid: ztypes.vid
} out bool is {
    if (varEntryHas xs: narrow.box :vid).not then return false
    return (prog.typing.wholeLocalReads.has item: nid)
}

# wholeLocalName -- the local's own storage: a take alias where one stands,
# never the payload a narrowing aliased it to; its facts are stated into `facts`.
wholeLocalName: function {
    prog: Program.view
    ctx: Ctx.view
    name: StringView
    vid: ztypes.vid
    facts: exprfacts.borrow
} out String is {
    al: vidFind xs: ctx.narrow.aliases :vid
    if al > 0 then return (entryText xs: ctx.narrow.aliases at: al - 1 :facts)
    return (localnames.localNameText :prog :ctx :vid :name :facts)
}

# emitLocalAtomNameAt -- emitLocalAtomNameWith for the read at `nid`, which sees
# the whole local once a write ended its narrowing.
emitLocalAtomNameAt: function {
    prog: Program.view
    ctx: Ctx
    nid: zast.nodeid
    name: StringView
    vid: ztypes.vid
    facts: exprfacts.borrow
} out String is {
    if (narrowingEndedAt :prog narrow: ctx.narrow :nid :vid) then {
        return (wholeLocalName :prog :ctx :name :vid :facts)
    }
    return (emitLocalAtomNameWith :prog :ctx :name :vid :facts)
}

# aliasResolveAt -- aliasResolve for the read at `nid`: past a narrowing a
# write ended, only a take alias substitutes for the name.
aliasResolveAt: function {
    prog: Program.view
    ctx: Ctx
    nid: zast.nodeid
    name: StringView
    vid: ztypes.vid
} out String is {
    if (narrowingEndedAt :prog narrow: ctx.narrow :nid :vid).not then return (
        aliasResolve
        :ctx
        :name
        :vid
    )
    al: vidFind xs: ctx.narrow.aliases :vid
    if al > 0 then return (ctx.narrow.aliases.get i: al - 1).val.copy
    return name.string
}

# aliasResolvesToSelfAt -- aliasResolvesToSelf for the read at `nid`.
aliasResolvesToSelfAt: function {
    prog: Program.view
    narrow: NarrowState.view
    nid: zast.nodeid
    name: StringView
    vid: ztypes.vid
} out bool is {
    if (narrowingEndedAt :prog :narrow :nid :vid).not then {
        return (aliasResolvesToSelf :narrow :name :vid)
    }
    al: vidFind xs: narrow.aliases :vid
    if al == 0 then return true
    return (narrow.aliases.get i: al - 1).val.stringView == name
}

# emitPrintViaStringView -- an atom printed through its type's own `stringView`
# projection: the projection is called on the value and its result printed. A
# class held BY VALUE is addressed for that call; a pointer, a mono or a
# valtype passes as it stands. A type declaring no such projection cannot be
# printed, and says so where the program can see it.
emitPrintViaStringView: function {
    prog: Program.view
    ctx: Ctx
    argTid: ztypes.tid
    name: StringView
    vid: ztypes.vid
    line: u32
    ind: StringView
    buf: String.borrow
} is {
    svco: prog.typing.declChildOfId parentTypeId: argTid nameId: zast.wellKnown.slot.wkStringView
    match (
        svco
    ) case some then {
        mcb: spelledCname :ctx tid: svco
        argOrig: originTidOf :prog tid: argTid
        usesAmp: false
        if (
            (prog.reg.typetypeOf typeId: argTid) == ztypes.ztypetype.classType
        ) when argOrig.isZero when (
            isPtrVid
            :ctx
            :vid
        ).not then usesAmp = true
        if usesAmp then {
            preludeNeed :ctx memb: "@StringView_print"
            lpt: "\{ind}\{ctx.known.svC}_print(\{mcb}(&\{name}));\n"
            buf.append lpt
        } else {
            preludeNeed :ctx memb: "@StringView_print"
            printLine: "\{ind}\{ctx.known.svC}_print(\{mcb}(\{name}));\n"
            buf.append printLine
        }
    } case none then {
        tn: prog.reg.nameViewOf tid: argTid
        emitFail :ctx what: "unhandled print of \{name} type \{tn}" :line
    }
}

# emitPrintAtom -- a bare name argument of `print`, printed by what its stamp
# says it holds: an owned String, a StringView, a str mono, or any other type
# through its own stringView projection.
emitPrintAtom: function {
    prog: Program.view
    ctx: Ctx
    n: zast.atomidrow.view
    ind: StringView
    buf: String.borrow
} is {
    anC: zast.nameTextAt ast: prog.ast ref: n.name
    an: anC.stringView
    nameVid: atomVid :prog nid: n.nodeid
    anm: aliasResolveAt :prog :ctx nid: n.nodeid name: an vid: nameVid
    anv: ztypes.vid
    if anm.stringView == an then anv = nameVid
    # anm stays the SOURCE name (the alias/narrow lookups key on it); anmE
    # is what reaches the C
    anmF: exprfacts
    anmE: (
        emitLocalAtomNameAt
        :prog
        :ctx
        nid: n.nodeid
        name: an
        vid: nameVid
        facts: anmF
    )
    # a unit string CONSTANT reaching print by name. emitExpr answers for a
    # constant on its own first line; print resolves atoms itself and never
    # goes through it, so without this the NAME reaches the C undeclared.
    # A stamped local is not a constant, so the probe is skipped for one --
    # the same order emitExpr's atomid arm uses.
    {
        alo: prog.typing.atomVariableId.get key: n.nodeid
        if alo.none then {
            mainUnit: consts.mainUnitTid :prog known: ctx.known
            facts: exprfacts
            cst: consts.memberConstStringText :prog :ctx unitTid: mainUnit nameId: n.name :facts
            if cst.length > 0 then anmE = cst.copy
        }
    }
    if (argforms.stampIsStr :prog known: ctx.known nid: n.nodeid) then {
        if (isPtrVid :ctx vid: anv) then {
            preludeNeed :ctx memb: "@String_print"
            lps: "\{ind}\{ctx.known.strC}_print(\{anmE});\n"
            buf.append lps
        } else {
            preludeNeed :ctx memb: "@String_print"
            printLine: "\{ind}\{ctx.known.strC}_print(&\{anmE});\n"
            buf.append printLine
        }
        return
    }
    argTid: stampIdOf :prog nid: n.nodeid
    if ctx.known.svTid == argTid then {
        preludeNeed :ctx memb: "@StringView_print"
        lpv: "\{ind}\{ctx.known.svC}_print(\{anmE});\n"
        buf.append lpv
        return
    }
    if (originIsTid :prog tid: argTid originTid: (ctx.origins.get i: family.slot.str)) then {
        preludeNeed :ctx memb: "@StringView_print"
        svT: values.svTypeC :ctx
        lpstr: "\{ind}\{ctx.known.svC}_print((\{svT}){ .data = \{anmE}.data, .size = \{anmE}.len });\n"
        buf.append lpstr
        return
    }
    (
        emitPrintViaStringView
        :prog
        :ctx
        :argTid
        name: anmE.stringView
        vid: anv
        line: n.lineno
        :ind
        :buf
    )
}

# dropStaleBorrowAlias -- a binding statement introduces a FRESH local, so a
# borrow alias left by an earlier binding of the same name points at a C
# variable that is out of scope here. Drop it before the binding legs
# re-establish one; anything that is not a borrow alias is left alone.
dropStaleBorrowAlias: function {narrow: NarrowState vid: ztypes.vid} is {
    if (varEntryHasPtr xs: narrow.aliases :vid) then (
        stmtblocks.vidRemove
        xs: narrow.aliases
        :vid
    )
}

# emitReassignStmt -- `x = <value>`: the old value is freed where the binding owns
# heap, the new one is stored, and a move source is zeroed so its scope-exit free
# becomes a no-op.
emitReassignStmt: function {
    prog: Program.view
    ctx: Ctx
    n: zast.reassignmentrow.view
    ind: StringView
    tmp: FnTemps
    buf: String.borrow
} is {
    if (prog.typing.repoints.has item: n.nodeid) then {
        emitRepointStmt :prog :ctx :n :ind :tmp :buf
        return
    }
    topathNode: prog.ast.nodes.getView i: n.topath
    nm2: emitReassignLvalue :prog :ctx n: topathNode
    rtnid: interpPartNodeId n: topathNode
    # a collection-typedef lvalue (Bytes) stores and destroys as its
    # chased underlying mono, exactly like the binding path
    rtsid: (
        chaseAggregateTypedef
        :prog
        :ctx
        tid: (reassignDestroyTid :prog n: topathNode nid: rtnid)
    )
    # a local's old value dies as the checker recorded it: not when it was
    # moved away, nor when the local owns nothing; a field's always does, and
    # so does that of a name a loop's header binds, which is no variable of
    # the checker's
    destroyOld: true
    if topathNode.atomid when (atomVid :prog nid: rtnid).notZero then {
        destroyOld = namedDestroyOwes :prog nid: n.nodeid
    }
    (
        values.emitStoreTo
        :prog
        :ctx
        nm2: nm2.stringView
        :rtnid
        :rtsid
        valueNode: (prog.ast.nodes.getView i: n.value)
        :destroyOld
        :ind
        :tmp
        :buf
    )
}

# emitRepointStmt -- `x = v` re-pointing the borrowed `x` (the checker's
# repoints). A borrow the C holds as a pointer -- an alias `(*__borrow_x)`, a
# pointer parameter -- is given the address of the storage `v` names (a
# `.borrow` marker names the path under it); any other borrow -- a view, a
# borrowed box, a collection's own pointer -- is its value, stored whole.
# Nothing is freed and no source is zeroed: `x` owns nothing.
emitRepointStmt: function {
    prog: Program.view
    ctx: Ctx
    n: zast.reassignmentrow.view
    ind: StringView
    tmp: FnTemps
    buf: String.borrow
} is {
    topathNode: prog.ast.nodes.getView i: n.topath
    tgt: emitReassignLvalue :prog :ctx n: topathNode
    xv: atomVid :prog nid: (atomNodeId n: topathNode)
    ptr: String
    tv: tgt.stringView
    # a borrow alias re-points the pointer it reads through
    ap: varEntryPtrOf xs: ctx.narrow.aliases vid: xv
    if ap.length > 0 then {
        ptr.append ap
    } else if (isPtrVid :ctx vid: xv) then {
        ptr.append tv
    }
    if (prog.typing.ownedRepoints.has item: n.nodeid) then {
        (
            values.emitOwnedRepoint
            :prog
            :ctx
            :n
            :xv
            ptr: ptr.stringView
            tgt: tgt.stringView
            :ind
            :tmp
            :buf
        )
        return
    }
    base: prog.ast.nodes.getView i: (underBorrowMarker :prog nid: n.value)
    rvm: emitExpr :prog :ctx n: base
    flushArgHoists :ctx :ind :tmp :buf
    if ptr.length > 0 then {
        addr: "&"
        if (pathIsPointer :prog :ctx n: base) then addr = ""
        buf.append "\{ind}\{ptr} = \{addr}\{rvm};\n"
        return
    }
    buf.append "\{ind}\{tgt} = \{rvm};\n"
}

# namedDestroyOwes -- whether the `.drop` or the reassignment at `nid` destroys
# the value its local holds: the checker recorded one there (exitDestroy) for
# a local that owns what it holds, and the local was not moved away first.
namedDestroyOwes: function {prog: Program.view nid: zast.nodeid} out bool is {
    rg: prog.typing.exitDestroy.get key: nid
    if rg.none then return false
    return (prog.typing.destroyItems.get i: rg.start).state.moved.not
}

# reassignDestroyTid -- the type an assignment's old value is destroyed as. A
# REBIND of a bare name replaces the whole variable, so that is the variable's
# DECLARED type: under a narrowing the occurrence is stamped with the arm's
# payload type instead, whose destructor answers for the payload and not for
# the union holding it, and the arm the variable still held would leak. Every
# other target answers with its own stamp.
reassignDestroyTid: function {
    prog: Program.view
    n: astnode.view
    nid: zast.nodeid
} out ztypes.tid is {
    stamped: stampIdOf :prog :nid
    rbn: atomTextOf :prog :n
    if rbn.length == 0 then return stamped
    rbv: atomVid :prog nid: (atomNodeId :n)
    if rbv.isZero then return stamped
    declared: prog.reg.variableTypeOf id: rbv
    if declared.isZero then return stamped
    return declared
}

# emitReassignLvalue -- the C lvalue for a reassignment target. A `got.field`
# whose base atom is a narrowed match-arm binding over a borrowed reftype view
# (seeded in narrowBox) writes THROUGH the box into the live entry; the local
# read-copy is not the backing storage. Other targets emit normally.
emitReassignLvalue: function {
    prog: Program.view
    ctx: Ctx
    n: astnode.view
} out String is {
    # a REBIND names the VARIABLE, never the payload a narrowing aliased it to:
    # `s = Sum.two` inside an arm that narrowed `s` replaces the whole union,
    # and writing through the arm's payload view would assign a union to a
    # payload. A write THROUGH the subject (the dotted leg below) does take the
    # alias, which is what the narrowing is for.
    {
        rbNm: atomTextOf :prog :n
        if rbNm.length > 0 then {
            rbVid: atomVid :prog nid: (atomNodeId :n)
            if rbVid.notZero when (varEntryGet xs: ctx.narrow.box vid: rbVid).length > 0 then {
                rbF: exprfacts
                return (wholeLocalName :prog :ctx vid: rbVid name: rbNm facts: rbF)
            }
        }
    }
    if n.dottedpath then {
        ba: (
            zast.nameTextAt
            ast: prog.ast
            ref: (zast.atomNameIdOf n: (prog.ast.nodes.getView i: n.parent))
        )
        if ba.length > 0 then {
            baseVid: atomVid :prog nid: (atomNodeId n: (prog.ast.nodes.getView i: n.parent))
            nbo: varEntryGet xs: ctx.narrow.box vid: baseVid
            if nbo.length > 0 then {
                # the write spells the alias, and with it the payload's type
                noteAliasRead :ctx vid: baseVid
                memC: (
                    memberC
                    :prog
                    :ctx
                    owner: ((varTidGet xs: ctx.narrow.tid vid: baseVid).or d: ztypes.tid.zero)
                    kind: memberkind.field
                    nameId: (aliasOrChildId :prog aliasId: n.nodeid childId: n.child)
                )
                lvx: "\{nbo}.\{memC}"
                return lvx
            }
        }
        memFpId: aliasOrChildId :prog aliasId: n.nodeid childId: n.child
        rpnid: interpPartNodeId n: (prog.ast.nodes.getView i: n.parent)
        stampTid: stampIdOf :prog nid: rpnid
        rsc: stampTid
        rsFp: stampTid
        if rsc.notZero then rsFp = rsc
        rsFpc: chaseAggregateTypedef :prog :ctx tid: rsFp
        if (prog.typing.declIsFnptrFieldId parentTypeId: rsFpc nameId: memFpId) then {
            recvFp: (
                zast.nameTextAt
                ast: prog.ast
                ref: (zast.atomNameIdOf n: (prog.ast.nodes.getView i: n.parent))
            )
            accFpL: ".".string
            recvFpC: String
            if recvFp.length > 0 then {
                rfn: atomNodeId n: (prog.ast.nodes.getView i: n.parent)
                rfv: atomVid :prog nid: rfn
                if (isPtrVid :ctx vid: rfv) then accFpL = "->".string
                rfF: exprfacts
                recvFpC = (
                    emitLocalAtomNameAt
                    :prog
                    :ctx
                    nid: rfn
                    name: recvFp.stringView
                    vid: rfv
                    facts: rfF
                )
            } else {
                # a field reached through a path (`this.inner.zero`): the path
                # itself, through `->` when it resolves to a pointer
                recvFpC = emitExpr :prog :ctx n: (prog.ast.nodes.getView i: n.parent)
                if (pathIsPointer :prog :ctx n: (prog.ast.nodes.getView i: n.parent)
                ) then accFpL = "->".string
            }
            memFpC: (
                memberC
                :prog
                :ctx
                owner: rsFpc
                kind: memberkind.field
                nameId: (aliasOrChildId :prog aliasId: n.nodeid childId: n.child)
            )
            return "\{recvFpC}\{accFpL}\{memFpC}"
        }
    }
    return (emitExpr :prog :ctx :n)
}

# armMemberTid -- the payload type `arm` names on sum type `owner`, 0 when the
# arm is not a member of it.
armMemberTid: function {
    prog: Program.view
    owner: ztypes.tid
    arm: zast.nameid
} out ztypes.tid is {
    pt: (
        (prog.typing.declChildOfId parentTypeId: owner nameId: arm).or
        d: ztypes.tid.zero
    )
    return pt
}

# remainingArm -- the single arm of `tid` left after removing the
# ambient exclusions recorded for variable `subjVid` (ctx.exclArms) plus the
# `extra` space-joined arms; "" when zero or more than one remain.
remainingArm: function {
    prog: Program.view
    narrow: NarrowState.view
    subjVid: ztypes.vid
    tid: ztypes.tid
    extra: zast.nameid
} out zast.nameid is {
    exv: varArmsGet xs: narrow.exclArms vid: subjVid
    all: ListVal zast.nameid
    zenv.sumArmNameIds ty: prog.typing reg: prog.reg :tid ids: all
    remN: u64
    rem: zast.nameid
    for each a: all loop {
        if a != extra when (idListHas xs: exv id: a).not then {
            remN = remN + 1
            rem = a
        }
    }
    if remN != 1 then return zast.nameid
    return rem
}

# seedFromPredicate -- one POSITIVE bare arm predicate dotted node: admit a
# non-bool receiver variable whose arm carries a payload and whose
# subject the body does not reassign; append its narrowBox seed
# (subject, alias text, payload tid). The condition-form dispatch
# (trailing .true/.false, == true/false) lives in seedCondOp.
seedFromPredicate: function {
    prog: Program.view
    ctx: Ctx
    n: astnode.view
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    valFs: ListVal exprfacts
    tids: ListVal ztypes.tid
} is {
    match (
        n
    ) case dottedpath then {
        armId: aliasOrChildId :prog aliasId: n.nodeid childId: n.child
        armTid: dottedArmPredicateTid :prog nid: n.nodeid
        (
            seedPositiveCore
            :prog
            :ctx
            tid: armTid
            parent: (prog.ast.nodes.getView i: n.parent)
            childName: armId
            :names
            :svids
            :vals
            :valFs
            :tids
        )
    } else null
}

# seedPositiveCore -- the positive-seed core: the subject named by `parent` is
# known to hold `childName` of `tid`.
seedPositiveCore: function {
    prog: Program.view
    ctx: Ctx
    tid: ztypes.tid
    parent: astnode.view
    childName: zast.nameid
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    valFs: ListVal exprfacts
    tids: ListVal ztypes.tid
} is {
    if tid.isZero then return
    if (isOrdinalVariant :prog :tid) then return
    subj: atomTextOf :prog n: parent
    if subj.length == 0 then return
    recvF: exprfacts
    recvText: emitExprWith :prog :ctx n: parent facts: recvF
    accessOp: ".".string
    if (
        isPtrVid
        :ctx
        vid: (atomVid :prog nid: (atomNodeId n: parent))
    ) then accessOp = "->".string
    aliasF: exprfacts
    aliasText: (
        stmtblocks.armAliasText
        :prog
        :ctx
        :tid
        arm: childName
        recv: recvText.stringView
        :recvF
        acc: accessOp.stringView
        facts: aliasF
    )
    if aliasText.length == 0 then return
    names.append subj.string
    svids.append (atomVid :prog nid: (atomNodeId n: parent))
    vals.append aliasText
    valFs.append aliasF
    pt: (
        (prog.typing.declChildOfId parentTypeId: tid nameId: childName).or
        d: ztypes.tid.zero
    )
    tids.append pt
}

# seedNegatedFromPredicate -- a NEGATED bare arm predicate: the branch knows the
# subject does NOT hold `arm`. When exactly one payload arm remains, seed
# its alias (exclusion collapse, mirroring the checker).
seedNegatedFromPredicate: function {
    prog: Program.view
    ctx: Ctx
    n: astnode.view
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    valFs: ListVal exprfacts
    tids: ListVal ztypes.tid
} is {
    match (
        n
    ) case dottedpath then {
        dap: dottedArmPredicateTid :prog nid: n.nodeid
        if dap.isZero then return
        if (isOrdinalVariant :prog tid: dap) then return
        subj: atomTextOf :prog n: (prog.ast.nodes.getView i: n.parent)
        if subj.length == 0 then return
        snv: atomVid :prog nid: (atomNodeId n: (prog.ast.nodes.getView i: n.parent))
        ctorArmName: aliasOrChildId :prog aliasId: n.nodeid childId: n.child
        rem: remainingArm :prog narrow: ctx.narrow subjVid: snv tid: dap extra: ctorArmName
        if rem.isZero then return
        recvF: exprfacts
        recvText: emitExprWith :prog :ctx n: (prog.ast.nodes.getView i: n.parent) facts: recvF
        accessOp: ".".string
        if (isPtrVid :ctx vid: snv) then accessOp = "->".string
        aliasF: exprfacts
        aliasText: (
            stmtblocks.armAliasText
            :prog
            :ctx
            tid: dap
            arm: rem
            recv: recvText.stringView
            :recvF
            acc: accessOp.stringView
            facts: aliasF
        )
        if aliasText.length == 0 then return
        names.append subj.string
        svids.append snv
        vals.append aliasText
        valFs.append aliasF
        pt: (
            (prog.typing.declChildOfId parentTypeId: dap nameId: rem).or
            d: ztypes.tid.zero
        )
        tids.append pt
    } else null
}

# armSideAtNode -- which arm of ITS OWN stamped type the name `nameId` is, for
# the value at node `nid`. `true` and `false` are arms of bool, so a `== true`
# operand answers `truthy` and a `== false` one `falsy` -- from bool's arm
# ORDER, which is the whole content of the spelling test. Asking the node's own
# stamp rather than looking `bool` up by name costs nothing and is exact under
# a user type that shadows bool.
armSideAtNode: function {
    prog: Program.view
    nid: zast.nodeid
    nameId: zast.nameid
} out ztyping.armside is {
    if nameId.isZero then return ztyping.armside.none
    st: stampIdOf :prog :nid
    return (ztyping.armSideOfName ty: prog.typing typeId: st :nameId)
}

# boolArmSideOf -- armSideAtNode for a bare atom operand.
boolArmSideOf: function {
    prog: Program.view
    n: astnode.view
} out ztyping.armside is {
    match (
        n
    ) case atomid then {
        return (armSideAtNode :prog nid: n.nodeid nameId: n.name)
    } else {
        return ztyping.armside.none
    }
}

# seed a condition's operator so the branch emit can read it without re-
# resolving
# seedEqualityCond -- `== true` / `== false` seeds exactly what the ARM it
# names seeds, and answers whether it did. The comparison is an infix call, so
# its operands are read through the one seam that knows that layout; which side
# is which comes from bool's arm ORDER, never from the spelling of the operand.
seedEqualityCond: function {
    prog: Program.view
    ctx: Ctx
    n: astnode.view
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    valFs: ListVal exprfacts
    tids: ListVal ztypes.tid
} out bool is {
    ipS: zast.infixPartsOf ast: prog.ast :n
    if ipS.found.not then return false
    # the operator node is read ONCE: as a repeated subexpression it is emitted
    # per use, and the hoisted temporaries the uses it loses leave behind are a
    # warn-check failure
    opNS: prog.ast.nodes.getView i: ipS.operator
    if (zast.atomNameIdOf n: opNS) != zast.wellKnown.slot.wkOpEq then return false
    lsdS: boolArmSideOf :prog n: (prog.ast.nodes.getView i: ipS.lhs)
    rsdS: boolArmSideOf :prog n: (prog.ast.nodes.getView i: ipS.rhs)
    if rsdS.truthy then {
        blS: prog.ast.nodes.getView i: ipS.lhs
        seedFromPredicate :prog :ctx n: blS :names :svids :vals :valFs :tids
        return true
    }
    if rsdS.falsy then {
        lnS: prog.ast.nodes.getView i: ipS.lhs
        seedNegatedFromPredicate :prog :ctx n: lnS :names :svids :vals :valFs :tids
        return true
    }
    if lsdS.truthy then {
        brS: prog.ast.nodes.getView i: ipS.rhs
        seedFromPredicate :prog :ctx n: brS :names :svids :vals :valFs :tids
        return true
    }
    if lsdS.falsy then {
        rnS: prog.ast.nodes.getView i: ipS.rhs
        seedNegatedFromPredicate :prog :ctx n: rnS :names :svids :vals :valFs :tids
        return true
    }
    return false
}

# seed a condition's operator so the branch emit can read it without re-
# resolving
seedCondOp: function {
    prog: Program.view
    ctx: Ctx
    n: astnode.view
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    valFs: ListVal exprfacts
    tids: ListVal ztypes.tid
} is {
    # a bare 2-arm sum condition IS `x.<arm>` with the arm left implicit, so
    # it seeds the alias that form seeds.
    {
        ta0: ztypecheck.truthyCondArmOf typing: prog.typing nid: (interpPartNodeId :n)
        if ta0.notZero then {
            condTid: stampIdOf :prog nid: (interpPartNodeId :n)
            (
                seedPositiveCore
                :prog
                :ctx
                tid: condTid
                parent: n
                childName: ta0
                :names
                :svids
                :vals
                :valFs
                :tids
            )
            return
        }
    }
    if (seedEqualityCond :prog :ctx :n :names :svids :vals :valFs :tids) then return
    match (
        n
    ) case dottedpath then {
        cn: aliasOrChildId :prog aliasId: n.nodeid childId: n.child
        # `.true` / `.false` on a predicate: which side it is comes from the
        # stamped type's arm ORDER, never from the spelling of the segment.
        sd: (
            ztypecheck.armSuffixSide
            ast: prog.ast
            typing: prog.typing
            nid: n.nodeid
            parent: (prog.ast.nodes.getView i: n.parent)
            child: (prog.ast.nodes.getView i: n.child)
        )
        if sd.truthy then {
            dpp: prog.ast.nodes.getView i: n.parent
            seedFromPredicate :prog :ctx n: dpp :names :svids :vals :valFs :tids
            return
        }
        if sd.falsy then {
            dpq: prog.ast.nodes.getView i: n.parent
            seedNegatedFromPredicate :prog :ctx n: dpq :names :svids :vals :valFs :tids
            return
        }
        armTid: dottedArmPredicateTid :prog nid: n.nodeid
        (
            seedPositiveCore
            :prog
            :ctx
            tid: armTid
            parent: (prog.ast.nodes.getView i: n.parent)
            childName: cn
            :names
            :svids
            :vals
            :valFs
            :tids
        )
    } else null
}

# seedCondOne -- the narrowBox seeds one condition contributes, appended to the
# parallel lists. Seeding a conjunct as it is emitted is what lets the conjunct
# after it read the payload this one narrowed.
seedCondOne: function {
    prog: Program.view
    ctx: Ctx
    condId: zast.nodeid
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    valFs: ListVal exprfacts
    tids: ListVal ztypes.tid
} is {
    k: prog.ast.nodes.getView i: condId
    if k.namedoperation then {
        (
            seedCondOp
            :prog
            :ctx
            n: (prog.ast.nodes.getView i: k.operation)
            :names
            :svids
            :vals
            :valFs
            :tids
        )
    }
}

# seedAndLayerCond -- everything one conjunct owes the conjuncts after it and
# the clause body: the alias for what it narrowed, and the exclusion for what it
# ruled out. Both are installed before the next conjunct renders, because `when`
# short-circuits and a later conjunct is reached only where this one held.
seedAndLayerCond: function {
    prog: Program.view
    ctx: Ctx
    condId: zast.nodeid
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    valFs: ListVal exprfacts
    tids: ListVal ztypes.tid
    prevV: List String
    prevF: ListVal exprfacts
    prevT: ListVal ztypes.tid
} is {
    had: svids.length
    seedCondOne :prog :ctx :condId :names :svids :vals :valFs :tids
    installNarrowSeeds narrow: ctx.narrow :svids :vals :valFs :tids :prevV :prevF :prevT from: had
    layerCondExclusion :prog narrow: ctx.narrow :condId
}

# layerCondExclusion -- record that a conjunct's NEGATED arm predicate excludes
# its arm, for everything after it: the conjuncts that follow and the clause
# body. `remainingArm` reads ctx.exclArms, so two exclusions that leave one arm
# collapse the subject to that arm's payload -- the rule the checker applies,
# on both sides of the clause.
#
# Classification is the chain facts' own, so this cannot disagree with them, and
# it allocates nothing at all unless the conjunct really does exclude an arm.
layerCondExclusion: function {
    prog: Program.view
    narrow: NarrowState
    condId: zast.nodeid
} is {
    k: prog.ast.nodes.getView i: condId
    if k.namedoperation.not then return
    f: classifyCondFact :prog n: (prog.ast.nodes.getView i: k.operation)
    if f.ok.not then return
    if f.neg.not then return
    pushExclusion :narrow vid: f.svid arm: f.armRef owner: f.owner
}

# pushExclusion -- add `arm` to the arms already excluded for `vid`, saving what
# the exclusion tables held on ctx's stack so restoreCondExclusions can put it
# back. The arms accumulate space-joined, which is how remainingArm reads them.
pushExclusion: function {
    narrow: NarrowState
    vid: ztypes.vid
    arm: zast.nameid
    owner: ztypes.tid
} is {
    pv0: varArmsGet xs: narrow.exclArms :vid
    nx: pv0.copy
    nx.append arm
    narrow.exSaves.append (
        ExclSave
        :vid
        arms: pv0
        owner: ((varTidGet xs: narrow.exclTids :vid).or d: ztypes.tid.zero)
    )
    varArmsSet xs: narrow.exclArms :vid arms: nx
    stmtblocks.varTidSet xs: narrow.exclTids :vid tid: owner
}

# installNarrowSeeds -- install the aliases at index `from` and after, recording
# what each vid held so the clause can put it back. The saved value is the one
# in place BEFORE this clause touched it, so installing in stages still
# restores in one pass.
installNarrowSeeds: function {
    narrow: NarrowState
    svids: (ListVal ztypes.vid).view
    vals: (List String).view
    valFs: (ListVal exprfacts).view
    tids: (ListVal ztypes.tid).view
    prevV: List String
    prevF: ListVal exprfacts
    prevT: ListVal ztypes.tid
    from: u64
} is {
    si: from
    for si < svids.length loop {
        svv: vals.get i: si
        stt: tids.get i: si
        (
            pushNarrow
            :narrow
            vid: (svids.get i: si)
            val: svv.stringView
            valF: (valFs.get i: si)
            tid: stt
            :prevV
            :prevF
            :prevT
        )
        si = si + 1
    }
}

# ifPredicateSeeds -- collect the narrowBox seeds for a clause's bare
# arm-predicate conjuncts, all condition forms (parallel lists).
ifPredicateSeeds: function {
    prog: Program.view
    ctx: Ctx
    conds: zast.kidspan
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    valFs: ListVal exprfacts
    tids: ListVal ztypes.tid
} is {
    for each condId: (zast.kidsOf ast: prog.ast span: conds) loop {
        k: prog.ast.nodes.getView i: condId
        if k.namedoperation then {
            (
                seedCondOp
                :prog
                :ctx
                n: (prog.ast.nodes.getView i: k.operation)
                :names
                :svids
                :vals
                :valFs
                :tids
            )
        }
    }
}

# condarmfact -- one condition's arm-predicate classification, carrying no built
# text: which sum type the subject has, which node it is, which arm the
# predicate names, and whether the predicate is the falsy side. `ok` is false
# when the condition is not an arm predicate at all.
#
# Classification is split from recording so the two callers cannot drift: the
# else emission classifies and then builds its strings, while the exclusion
# layering classifies and stops. A separate probe that mirrored these legs could
# silently disagree, and a missed exclusion puts invalid C back.
condarmfact: record {
    ok: bool
    owner: ztypes.tid
    parentNid: zast.nodeid
    svid: ztypes.vid
    armRef: zast.nameid
    neg: bool
}

# noArmFact -- the "not an arm predicate" answer.
noArmFact: function out condarmfact is {
    return (
        condarmfact
        ok: false
        owner: ztypes.tid.zero
        parentNid: zast.nodeid
        svid: ztypes.vid.zero
        armRef: zast.nameid.zero
        neg: false
    )
}

# classifyFactCore -- the guards every arm-predicate fact must pass, answered
# without allocating: a real sum owner, not an ordinal variant, and a subject
# that is a bare atom.
classifyFactCore: function {
    prog: Program.view
    owner: ztypes.tid
    parentNid: zast.nodeid
    armRef: zast.nameid
    neg: bool
} out condarmfact is {
    noFact: noArmFact
    if owner.isZero then return noFact
    if (isOrdinalVariant :prog tid: owner) then return noFact
    parent: prog.ast.nodes.getView i: parentNid
    subj: atomTextOf :prog n: parent
    if subj.length == 0 then return noFact
    return (
        condarmfact
        ok: true
        :owner
        :parentNid
        svid: (atomVid :prog nid: (atomNodeId n: parent))
        :armRef
        :neg
    )
}

# classifyInnerFact -- the stamped bare-predicate core, as a classification.
classifyInnerFact: function {
    prog: Program.view
    n: astnode.view
    neg: bool
} out condarmfact is {
    match (
        n
    ) case dottedpath then {
        return (
            classifyFactCore
            :prog
            owner: (dottedArmPredicateTid :prog nid: n.nodeid)
            parentNid: n.parent
            armRef: (aliasOrChildId :prog aliasId: n.nodeid childId: n.child)
            :neg
        )
    } else {
        noFact: noArmFact
        return noFact
    }
}

# eqcondfact -- classifyEqualityCond's answer: whether the condition WAS an
# equality against a bool arm, and the fact it classifies to if so.
eqcondfact: record {
    # true when the condition is `== true` / `== false` and `fact` is its answer
    handled: bool
    # the arm fact, which may itself be `ok: false` when the operand names none
    fact: condarmfact
}

# classifyEqualityCond -- `== true` / `== false` classifies as the ARM it names.
# The comparison is an infix call, so its operands are read through the one seam
# that knows that layout; which side is which comes from bool's arm ORDER.
classifyEqualityCond: function {
    prog: Program.view
    n: astnode.view
} out eqcondfact is {
    miss: eqcondfact handled: false fact: noArmFact
    ipC: zast.infixPartsOf ast: prog.ast :n
    if ipC.found.not then return miss
    # read ONCE, as in seedEqualityCond
    opNC: prog.ast.nodes.getView i: ipC.operator
    if (zast.atomNameIdOf n: opNC) != zast.wellKnown.slot.wkOpEq then return miss
    lsdC: boolArmSideOf :prog n: (prog.ast.nodes.getView i: ipC.lhs)
    rsdC: boolArmSideOf :prog n: (prog.ast.nodes.getView i: ipC.rhs)
    if rsdC.truthy then return (
        eqcondfact
        handled: true
        fact: (classifyInnerFact :prog n: (prog.ast.nodes.getView i: ipC.lhs) neg: false)
    )
    if rsdC.falsy then return (
        eqcondfact
        handled: true
        fact: (classifyInnerFact :prog n: (prog.ast.nodes.getView i: ipC.lhs) neg: true)
    )
    if lsdC.truthy then return (
        eqcondfact
        handled: true
        fact: (classifyInnerFact :prog n: (prog.ast.nodes.getView i: ipC.rhs) neg: false)
    )
    if lsdC.falsy then return (
        eqcondfact
        handled: true
        fact: (classifyInnerFact :prog n: (prog.ast.nodes.getView i: ipC.rhs) neg: true)
    )
    return (eqcondfact handled: true fact: noArmFact)
}

# classifyCondFact -- one condition operation as an arm predicate, by the same
# legs the chain facts have always used: the bare stamped form, a `.true` /
# `.false` suffix whose side comes from the arm ORDER, and `== true` / `== false`
# against bool. Answers without building any text.
classifyCondFact: function {
    prog: Program.view
    n: astnode.view
} out condarmfact is {
    noFact: noArmFact
    {
        ta1: ztypecheck.truthyCondArmOf typing: prog.typing nid: (interpPartNodeId :n)
        if ta1.notZero then {
            return (
                classifyFactCore
                :prog
                owner: (stampIdOf :prog nid: (interpPartNodeId :n))
                # the subject here is `n` itself. classifyFactCore answers ok
                # only when that node is an atomid (atomTextOf names nothing
                # else), and interpPartNodeId of an atomid IS its own id, so
                # carrying the id is exactly carrying the node.
                parentNid: (interpPartNodeId :n)
                armRef: ta1
                neg: false
            )
        }
    }
    eqC: classifyEqualityCond :prog :n
    if eqC.handled then return eqC.fact
    match (
        n
    ) case dottedpath then {
        sd: (
            ztypecheck.armSuffixSide
            ast: prog.ast
            typing: prog.typing
            nid: n.nodeid
            parent: (prog.ast.nodes.getView i: n.parent)
            child: (prog.ast.nodes.getView i: n.child)
        )
        if sd.truthy then {
            return (classifyInnerFact :prog n: (prog.ast.nodes.getView i: n.parent) neg: false)
        }
        if sd.falsy then {
            return (classifyInnerFact :prog n: (prog.ast.nodes.getView i: n.parent) neg: true)
        }
        return (
            classifyFactCore
            :prog
            owner: (dottedArmPredicateTid :prog nid: n.nodeid)
            parentNid: n.parent
            armRef: (aliasOrChildId :prog aliasId: n.nodeid childId: n.child)
            neg: false
        )
    } else {
        return noFact
    }
}

# ChainFacts -- the arm facts of an if chain's clauses so far, one entry per
# clause whose one condition is a bare arm predicate (chainCondFact): what a
# later clause, and the else, run knowing failed
ChainFacts: class {
    # each subject as written, its variable, the arm, the arm's owner type, and
    # whether the predicate is negated
    subjects: List String
    svids: ListVal ztypes.vid
    arms: ListVal zast.nameid
    tids: ListVal ztypes.tid
    negs: ListVal bool
    # each subject's emitted C and its facts, which the else reuses rather than
    # emitting again
    recvs: List String
    recvFs: ListVal exprfacts
}

# chainCondFact -- one condition operation as a bare arm predicate, recorded
# onto `facts`. Classification is classifyCondFact's; this adds only the text
# the else emission reuses rather than re-deriving -- the subject spelling and
# the emitted receiver.
chainCondFact: function {prog: Program.view ctx: Ctx n: astnode.view facts: ChainFacts} is {
    f: classifyCondFact :prog :n
    if f.ok.not then return
    parent: prog.ast.nodes.getView i: f.parentNid
    subj: atomTextOf :prog n: parent
    rvF: exprfacts
    rv: emitExprWith :prog :ctx n: parent facts: rvF
    facts.subjects.append subj.string
    facts.svids.append f.svid
    facts.arms.append f.armRef
    facts.tids.append f.owner
    facts.negs.append f.neg
    facts.recvs.append rv
    facts.recvFs.append rvF
}

# layerChainExclusions -- on the else side every positive chain fact failed, so
# each one's arm is excluded for the else body. A negated fact names the arm the
# subject has instead, and is seeded rather than excluded.
layerChainExclusions: function {narrow: NarrowState facts: ChainFacts.view} is {
    fi: u64
    for fi < facts.negs.length loop {
        if (facts.negs.get i: fi).not then {
            (
                pushExclusion
                :narrow
                vid: (facts.svids.get i: fi)
                arm: (facts.arms.get i: fi)
                owner: (facts.tids.get i: fi)
            )
        }
        fi = fi + 1
    }
}

# seedElseSubject -- alias one chain subject to the arm the else side leaves it
# with: the arm a negated fact named, or the single arm the exclusions leave.
# Seeds nothing when the arm carries no payload to alias.
seedElseSubject: function {
    prog: Program.view
    ctx: Ctx
    subj: StringView
    subjVid: ztypes.vid
    owner: ztypes.tid
    recv: StringView
    recvF: exprfacts
    negArm: zast.nameid
    ind: StringView
    svids: ListVal ztypes.vid
    prevV: List String
    prevF: ListVal exprfacts
    prevT: ListVal ztypes.tid
    buf: String.borrow
} is {
    fArm: negArm
    if fArm.isZero then fArm = (
        remainingArm
        :prog
        narrow: ctx.narrow
        :subjVid
        tid: owner
        extra: zast.nameid
    )
    if fArm.isZero then return
    acc: ".".string
    if (isPtrVid :ctx vid: subjVid) then acc = "->".string
    aliasF: exprfacts
    aliasText: (
        stmtblocks.armAliasText
        :prog
        :ctx
        tid: owner
        arm: fArm
        :recv
        :recvF
        acc: acc.stringView
        facts: aliasF
    )
    if aliasText.length == 0 then return
    (
        pushNarrow
        narrow: ctx.narrow
        vid: subjVid
        val: aliasText.stringView
        valF: aliasF
        tid: (armMemberTid :prog :owner arm: fArm)
        :prevV
        :prevF
        :prevT
    )
    svids.append subjVid
    cmt: "\{ind}    /* alias: \{subj} => \{aliasText} */\n"
    buf.append cmt
}

# postGuardStmtId -- the node id of a guarding if/match statement that
# recorded a post-guard narrowing; 0 otherwise.
postGuardStmtId: function {
    prog: Program.view
    n: astnode.view
} out zast.nodeid is {
    match (
        n
    ) case statementline then {
        return (postGuardStmtId :prog n: (prog.ast.nodes.getView i: n.statementline))
    } case ifexpr then {
        po: prog.typing.postGuardName.get key: n.nodeid
        match (
            po
        ) case some then {
            return n.nodeid
        } case none then {
            return zast.nodeid
        }
    } case caseexpr then {
        po: prog.typing.postGuardName.get key: n.nodeid
        match (
            po
        ) case some then {
            return n.nodeid
        } case none then {
            return zast.nodeid
        }
    } else {
        return zast.nodeid
    }
}

# seedPostGuardAlias -- a guard statement that returns on the failing arm leaves
# its subject narrowed for everything after it, so alias the subject to that
# arm's payload for the rest of the block. The alias text is emitted C, so the
# receiver is the subject's identifier and the narrowing tables key on its
# variable. Seeds nothing when the checker recorded no complete guard.
seedPostGuardAlias: function {
    prog: Program.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    names: List String
    svids: ListVal ztypes.vid
    prevV: List String
    prevF: ListVal exprfacts
    prevT: ListVal ztypes.tid
    buf: String.borrow
} is {
    pgid: postGuardStmtId :prog :n
    if pgid.isZero then return
    pgRawId: (prog.typing.postGuardName.get key: pgid).or d: zast.nameid
    pgRawN: zast.poolTextAt pool: prog.ast.names ref: pgRawId
    if pgRawN.length == 0 then return
    pgrv: (
        (prog.typing.postGuardVarId.get key: pgid).or
        d: ztypes.vid.zero
    )
    if pgrv.isZero then return
    owner: (prog.typing.postGuardTid.get key: pgid).or d: ztypes.tid.zero
    if owner.isZero then return
    armId: (prog.typing.postGuardArm.get key: pgid).or d: zast.nameid
    if armId.isZero then return
    pgRecvF: exprfacts
    pgRecv: wholeLocalName :prog :ctx vid: pgrv name: pgRawN.stringView facts: pgRecvF
    acc: ".".string
    if (isPtrVid :ctx vid: pgrv) then acc = "->".string
    # a subject an enclosing narrowing still holds at the guard's type -- an
    # option narrowed to `some`, then guarded on its payload's arm -- is read
    # through that narrowing: the arm is the payload's, not the local's. The
    # narrowed value is the payload itself, read with `.`
    if ((varTidGet xs: ctx.narrow.tid vid: pgrv).or d: ztypes.tid.zero) == owner then {
        nb: varEntryGet xs: ctx.narrow.box vid: pgrv
        if nb.length > 0 then {
            pgRecv = nb.take
            pgRecvF = varEntryFactsOf xs: ctx.narrow.box vid: pgrv
            acc = ".".string
        }
    }
    if pgRecv.length == 0 then return
    aliasF: exprfacts
    aliasText: (
        stmtblocks.armAliasText
        :prog
        :ctx
        tid: owner
        arm: armId
        recv: pgRecv.stringView
        recvF: pgRecvF
        acc: acc.stringView
        facts: aliasF
    )
    if aliasText.length == 0 then return
    (
        pushNarrow
        narrow: ctx.narrow
        vid: pgrv
        val: aliasText.stringView
        valF: aliasF
        tid: (armMemberTid :prog :owner arm: armId)
        :prevV
        :prevF
        :prevT
    )
    cmt: "\{ind}/* post-guard alias: \{pgRawN} => \{aliasText} */\n"
    buf.append cmt
    pgrn: pgRawN.copy
    names.append pgrn
    svids.append pgrv
}

# noteAliasRead -- C being written reads `vid`'s narrowBox text: the types the
# text spells are recorded, once.
noteAliasRead: function {ctx: Ctx vid: ztypes.vid} is {
    if ctx.narrow.aliasHeld.length == 0 then return
    nb: vidFind xs: ctx.narrow.box :vid
    if nb == 0 then return
    hits: ListVal u64
    {
        v: (ctx.narrow.box.get i: nb - 1).val.stringView
        i: u64
        for i < ctx.narrow.aliasHeld.length loop {
            e: ctx.narrow.aliasHeld.get :i
            if e.tid.notZero when e.val.stringView == v then hits.append i
            i = i + 1
        }
    }
    for each h: hits loop {
        t: (ctx.narrow.aliasHeld.get i: h).tid
        emitplan.noteTypeUse :ctx tid: t
        ctx.narrow.aliasHeld.set i: h val: (AliasHeld val: "".string tid: ztypes.tid.zero)
    }
}
