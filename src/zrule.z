# zrule -- the zl rule catalogue. Metadata for every lint/format rule: a stable
# code, a name, the analysis tier it needs (TOKEN/PARSE run on the fast path;
# TYPECHECK runs only under --full), a default severity, whether it is on by
# default, and its fix safety. The check logic lives with the traversal (zsource
# for AST rules, the token pass for token rules); this unit is the catalogue
# that drives `zl explain` and listing.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :explain
}

# the analysis tier a rule needs: token or parse (fast path), or typecheck (--full only).
tier: variant {
    # needs only the token stream, so it runs on the fast path
    token: null
    # needs the tree, and still runs on the fast path
    parse: null
    # needs types, so it runs only under --full
    typecheck: null
} as { tag: u8.tag }

# whether a rule has an autofix `zl fmt` applies.
fixkind: variant {
    # no autofix; a human decides
    none: null
    # `zl fmt` applies it, the rewrite being meaning-preserving
    safe: null
} as { tag: u8.tag }

# ruleinfo -- one rule's catalogue entry: its code, name, tier, severity,
# default, fix safety and summary.
ruleinfo: data {
    # the code a diagnostic carries and a baseline keys on
    code: text
    # the short name `zl explain` prints
    name: text
    # which tier it needs, and so which gate it runs in
    rtier: tier
    # its default severity
    sev: zdiag.severity
    # whether it runs without a flag. An opt-in rule needs one, which is why an
    # unflagged run says nothing about it
    defaultOn: bool
    # whether it can be fixed automatically, and how safely
    fix: fixkind
    # the sentence `zl explain` prints, which is the rule's real documentation
    summary: text
}

# rules -- the rule catalogue, in the order the linter's documentation lists it.
rules: list {
    l001: (
        ruleinfo
        code: "L001"
        name: "empty-else"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.none
        summary: "an `else { }` clause with an empty body"
    )
    l002: (
        ruleinfo
        code: "L002"
        name: "empty-then"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.none
        summary: "a single-condition clause with an empty `then { }` body"
    )
    l003: (
        ruleinfo
        code: "L003"
        name: "elide-name"
        rtier: tier.typecheck
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.safe
        summary: "a generic reference's first argument names its template's first parameter (redundant)"
    )
    l004: (
        ruleinfo
        code: "L004"
        name: "for-while"
        rtier: tier.token
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.safe
        summary: "a redundant `for` before a bare `while` condition"
    )
    l005: (
        ruleinfo
        code: "L005"
        name: "redundant-suffix"
        rtier: tier.typecheck
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.safe
        summary: "a numeric literal suffix that matches its inferred type (redundant)"
    )
    w005: (
        ruleinfo
        code: "W005"
        name: "line-length"
        rtier: tier.token
        sev: zdiag.severity.info
        defaultOn: false
        fix: fixkind.none
        summary: "a line wider than the configured column limit (advisory; --line-length)"
    )
    l006: (
        ruleinfo
        code: "L006"
        name: "redundant-label"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.safe
        summary: "a named argument `name: name` whose label repeats its value (use the `:name` shorthand)"
    )
    l009: (
        ruleinfo
        code: "L009"
        name: "member-casing"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: false
        fix: fixkind.none
        summary: "a variant or union member name that is not lowerCamelCase (starts uppercase)"
    )
    l011: (
        ruleinfo
        code: "L011"
        name: "bare-zero-init"
        rtier: tier.typecheck
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.safe
        summary: "a zero/empty binding initializer written as a literal (`\"\".string`, `0.u64`) where the bare type name constructs the same value"
    )
    l012: (
        ruleinfo
        code: "L012"
        name: "unused-private-def"
        rtier: tier.typecheck
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.none
        summary: "a private definition (a unit-level def, alias, or type member excluded from a `public:` block) that is never referenced -- dead code"
    )
    l013: (
        ruleinfo
        code: "L013"
        name: "unused-local"
        rtier: tier.typecheck
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.none
        summary: "a local binding that is never read; remove it, or end it with `x.drop` if the binding is intentional"
    )
    l014: (
        ruleinfo
        code: "L014"
        name: "unused-parameter"
        rtier: tier.typecheck
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.none
        summary: "a parameter that is never read (the receiver is exempt); end it with `x.drop` if required by a signature"
    )
    l015: (
        ruleinfo
        code: "L015"
        name: "redundant-stringlike-conversion"
        rtier: tier.typecheck
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.safe
        summary: "a call argument converted to a sibling string form (`x.stringView` on a String, `sv.string` on a StringView) where the parameter accepts StringLike directly -- the view form is pointless and the owned form allocates a String the call only borrows"
    )
    l016: (
        ruleinfo
        code: "L016"
        name: "undocumented-def"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: false
        fix: fixkind.none
        summary: "a type, free function, or method definition with no leading `#` doc comment; opt-in via `zl lint --docs`"
    )
    l017: (
        ruleinfo
        code: "L017"
        name: "undocumented-param"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: false
        fix: fixkind.none
        summary: "a function parameter with no doc comment (a leading `#` block or a trailing `#`); advisory -- a parameter is documented when its name and type do not say enough; opt-in via `zl lint --docs-params`"
    )
    l018: (
        ruleinfo
        code: "L018"
        name: "undocumented-member"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: false
        fix: fixkind.none
        summary: "a member with no doc comment (a leading `#` block or a trailing `#`): a record or class field, a variant or union arm, or a generic parameter; advisory -- a member is documented when its name and type do not say enough; opt-in via `zl lint --docs-fields`, and add `--docs-private` to see a unit past its `public:` block"
    )
    l019: (
        ruleinfo
        code: "L019"
        name: "public-block-placement"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.none
        summary: "a unit's `public:` interface block must appear at the top of the file, before any definition (only the header comment may precede it)"
    )
    l020: (
        ruleinfo
        code: "L020"
        name: "unmutated-mutable-parameter"
        rtier: tier.typecheck
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.none
        summary: "a user reftype parameter that is mutable by default and never mutated should declare `.view`, so callers may keep reading the argument across the call; a forgotten `.view` otherwise surfaces as a lock conflict at a distant call site"
    )
    l021: (
        ruleinfo
        code: "L021"
        name: "type-casing"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.none
        summary: "a type name whose casing does not match its kind (valtypes lowercase, reftypes PascalCase)"
    )
    l022: (
        ruleinfo
        code: "L022"
        name: "viewable-local"
        rtier: tier.typecheck
        sev: zdiag.severity.info
        defaultOn: true
        fix: fixkind.none
        summary: "a String local bound from an owning conversion (`.string` on a view, `.copy`, nameTextCopy/poolTextCopy) that is never mutated: every use only reads it, so a borrowed view serves and the allocation is avoidable; the output is a migration worklist, not a proof"
    )
    a001: (
        ruleinfo
        code: "A001"
        name: "literal-compare"
        rtier: tier.parse
        sev: zdiag.severity.info
        defaultOn: false
        fix: fixkind.none
        summary: "a `==` / `!=` against a string literal: the code routes by spelling what it should compare by id (a name id, a declaration, a type id); opt-in via `zl lint --arch`"
    )
    a002: (
        ruleinfo
        code: "A002"
        name: "composed-key"
        rtier: tier.parse
        sev: zdiag.severity.info
        defaultOn: false
        fix: fixkind.none
        summary: "a string literal shaped like a composed key -- interpolation holes joined by a short separator (`\"\\{unit}.\\{name}\"`) -- standing in for a pair key or a tree walk; opt-in via `zl lint --arch`"
    )
    a003: (
        ruleinfo
        code: "A003"
        name: "named-literal-compare"
        rtier: tier.typecheck
        sev: zdiag.severity.warning
        defaultOn: false
        fix: fixkind.none
        summary: "a `==` / `!=` against a literal that spells a unit or type name of the program: the thing has a declaration and a type id to compare; opt-in via `zl lint --arch --full`"
    )
    a004: (
        ruleinfo
        code: "A004"
        name: "write-only-field"
        rtier: tier.typecheck
        sev: zdiag.severity.warning
        defaultOn: false
        fix: fixkind.none
        summary: "a record or class field that no dotted read anywhere in the project reaches -- written at construction or assignment and never read (units under --system and native types exempt); opt-in via `zl lint --arch --full`"
    )
    a005: (
        ruleinfo
        code: "A005"
        name: "long-function"
        rtier: tier.parse
        sev: zdiag.severity.info
        defaultOn: false
        fix: fixkind.none
        summary: "a function whose body spans more than 150 source lines, counted as raw source span from the definition to the deepest statement it reaches, so comments and an exploded parameter list count toward it; a body that is one `match` is exempt (a dispatcher is as long as its arms); opt-in via `zl lint --arch`"
    )
    l023: (
        ruleinfo
        code: "L023"
        name: "generic-param-casing"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.none
        summary: "a generic parameter whose first character's case differs from its bound's -- the bound already names the family, so the case tells a reader at every point of use whether a binding of that parameter copies or moves"
    )
    l024: (
        ruleinfo
        code: "L024"
        name: "doc-echoes-name"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: false
        fix: fixkind.none
        summary: "a doc comment whose every content word already appears in the declaration below :it re-says the name and the type instead of saying why the thing exists. This is the cheapest way to satisfy a doc-coverage ratchet, which is why the ratchet ships paired with it; opt-in via `zl lint --docs-quality`"
    )
    l025: (
        ruleinfo
        code: "L025"
        name: "duplicate-doc-body"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: false
        fix: fixkind.none
        summary: "the same doc body on more than two definitions in one file -- a real invariant stated at forty sites is one invariant and thirty-nine copies. State it once, in the unit header, and leave the sites bare; opt-in via `zl lint --docs-quality`"
    )
    l026: (
        ruleinfo
        code: "L026"
        name: "unreachable-statement"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.none
        summary: "a statement after a `return`, `break`, `continue` or a bare `for loop` nothing breaks out of, in the same block, can never run; the emitter drops it, so only the source carries it -- delete it"
    )
    a006: (
        ruleinfo
        code: "A006"
        name: "duplicate-body"
        rtier: tier.parse
        sev: zdiag.severity.info
        defaultOn: false
        fix: fixkind.none
        summary: "a function body of eight lines or more with the shape of another in the file -- arm names, operators and literals equal, only the names different; one function, with the difference as an argument; opt-in via `zl lint --arch`"
    )
    a007: (
        ruleinfo
        code: "A007"
        name: "unused-export"
        rtier: tier.typecheck
        sev: zdiag.severity.info
        defaultOn: false
        fix: fixkind.none
        summary: "a name in a unit's `public:` block that no other unit under --src reads as `unit.name`: a private definition wearing a public label; make it private and let L012 judge it (units under --system exempt); opt-in via `zl lint --arch --full`"
    )
    a008: (
        ruleinfo
        code: "A008"
        name: "cognitive-complexity"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: false
        fix: fixkind.none
        summary: "a function whose cognitive complexity exceeds the threshold (15; `--complexity N` overrides it): +1 for each `if`, `for` and `match` and one more per level it nests under another; a `match` adds its worst arm, not every arm, plus 1 for each local an arm reassigns but does not declare, never more than the arms' sum, so a long dispatcher of simple arms is not a finding; +1 for each `else` and `else if`, +1 for each `when`/`while` chain, +1 per direct recursive call (its own name, bare or after `this.`), a nested function literal nesting its body; split the function along its nesting. Opt-in via `zl lint --arch`, ratcheted"
    )
    l027: (
        ruleinfo
        code: "L027"
        name: "unmutated-receiver"
        rtier: tier.typecheck
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.none
        summary: "a receiver written `:this` that the body never mutates should declare `t: this.view`, so callers may keep reading the object across the call; the same mutation evidence L020 reads, so a call through `this` to a mutating method counts; a method implementing a member of a spec its type implements is exempt, since that receiver is the spec's"
    )
    l028: (
        ruleinfo
        code: "L028"
        name: "compare-bool-literal"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.safe
        summary: "a comparison with a boolean literal: `x == false` / `x != true` is `x.not`, and `x == true` / `x != false` is `x` itself; the safe fix rewrites the comparison"
    )
    l029: (
        ruleinfo
        code: "L029"
        name: "implied-iterate"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.safe
        summary: "`for each x: E.iterate` writes the call `each` already makes: `each` walks a type through its zero-argument `iterate` before anything else, so the header is `for each x: E`; the safe fix deletes `.iterate`"
    )
    l032: (
        ruleinfo
        code: "L032"
        name: "mixed-operator-chain"
        rtier: tier.parse
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.safe
        summary: "an operator chain that mixes kinds of operator -- arithmetic, bitwise, shift, comparison, logical -- without parentheses. Operators have no precedence and group left to right, so `x == y + 1` is `(x == y) + 1`; the safe fix writes that grouping out, which changes nothing it means and shows what it says"
    )
    l033: (
        ruleinfo
        code: "L033"
        name: "negated-twin"
        rtier: tier.typecheck
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.safe
        summary: "a negated test whose type has the positive twin: `x.isZero.not` where the type of `x` declares `notZero`, and `o.none.not` on an option, whose other arm is `some`. The safe fix writes the twin"
    )
    l031: (
        ruleinfo
        code: "L031"
        name: "redundant-widening"
        rtier: tier.typecheck
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.safe
        summary: "a numeric conversion that only widens, written where the destination is that wider type already: a builtin numeric widens losslessly by itself into a parameter, a field, a return, a reassigned place. A typedef does not, and is never reported. The safe fix deletes the conversion"
    )
    l030: (
        ruleinfo
        code: "L030"
        name: "valtype-borrow-param"
        rtier: tier.typecheck
        sev: zdiag.severity.warning
        defaultOn: true
        fix: fixkind.none
        summary: "a parameter of a value type marked `.borrow` that the body never mutates: `.borrow` passes a valtype by reference so the callee can write the caller's value, and this one writes nothing; drop the marker (the argument is copied) or write `.view`. The same mutation evidence L020 reads, a pass to another `.borrow` parameter included. Receivers are L027's"
    )
    a009: (
        ruleinfo
        code: "A009"
        name: "flag-accumulator"
        rtier: tier.parse
        sev: zdiag.severity.info
        defaultOn: false
        fix: fixkind.none
        summary: "a bool local bound to a literal and then set to the other literal by two or more consecutive single-clause `if` statements -- a disjunction written as a flag; bind the `or` chain instead. Opt-in via `zl lint --arch`, ratcheted"
    )
    a010: (
        ruleinfo
        code: "A010"
        name: "nested-if-collapsible"
        rtier: tier.parse
        sev: zdiag.severity.info
        defaultOn: false
        fix: fixkind.none
        summary: "an `if` with one clause and no else whose body holds exactly one `if` with one clause and no else: the two conditions are one `when` chain. Opt-in via `zl lint --arch`, ratcheted"
    )
    a011: (
        ruleinfo
        code: "A011"
        name: "literal-lookup"
        rtier: tier.parse
        sev: zdiag.severity.info
        defaultOn: false
        fix: fixkind.none
        summary: "a string literal handed to one of the compiler's name-lookup functions (poolFind, nameIdOf, walkLookupTyperef, nameTextEq, ...): a name the compiler spells is a zast.wellKnown entry and is read by id, never looked up by its spelling. Opt-in via `zl lint --arch`, ratcheted"
    )
    a012: (
        ruleinfo
        code: "A012"
        name: "missing-public-block"
        rtier: tier.typecheck
        sev: zdiag.severity.info
        defaultOn: false
        fix: fixkind.none
        summary: "a file unit with no `public:` block, so every top-level definition is its surface and L012 can judge none of them unused; list what other units read (a program lists its `main`), and L012 judges the rest. Subunits are exempt, a hidden one and an inline one alike; system units are not. Opt-in via `zl lint --arch --full`, ratcheted"
    )
    a013: (
        ruleinfo
        code: "A013"
        name: "hand-written-walk"
        rtier: tier.parse
        sev: zdiag.severity.info
        defaultOn: false
        fix: fixkind.none
        summary: "a function with a `match` of five or more arms that only recurse: each arm calls the function again on a part of the value, passes every other argument on as it is (`:name`), and does nothing else. The children of the value are walked kind by kind, by hand; walk them in one arm (zast.childCount and zast.childAt read a node's children without building a list) and keep arms only for the kinds that do work of their own or skip a child. Opt-in via `zl lint --arch`, ratcheted"
    )
} out staticlist ruleinfo

# explain -- print the catalogue entry for a code. Returns 0 on success, 2 when
# the code is unknown.
explain: function {code: StringView} out i32 is {
    for each r: rules loop {
        if r.code.stringView == code then {
            print "\{r.code}  \{r.name}\n  \{r.summary}"
            return 0
        }
    }
    eln: "zl explain: unknown code \{code}"
    io.eprintln eln
    return 2
}
