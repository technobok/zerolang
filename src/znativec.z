# znativec -- the C backend's implementation files, served. Each unit's
# `<unit>/nativec.zd` under the system directory, a runtime.nativec value
# (lib/system/runtime.zd), is served to every build as the generated unit
# `nativec` (servedText), made when a build first reads it (ServedProvider).
# zc's own build compiles it, so zc carries every unit's rows as static data,
# which its emitter registers (zemitterc.registerImplementations).

public: unit {
    :servedFile
    :showNative
    :servedProvider
    :servedText
    :listText
}

ZVfsProvider: zvfs.ZVfsProvider

# schema -- the implementation files' schema, as the served unit holds it
schema: nativec.runtime.nativec

# listText -- a list of texts, comma-separated, as the tools print and read one
listText: function {xs: staticlist text} out String is {
    r: String
    for each t: xs loop {
        if r.length > 0 then r.append ","
        r.append t.stringView
    }
    return r
}

# callWord -- a row's `call` choice by its arm's name; "" for the general paths
callWord: function {c: schema.call} out String is {
    match (
        c
    ) case simple then {
        return "simple".string
    } case argument then {
        return "argument".string
    } case parse then {
        return "parse".string
    } case noArguments then {
        return "noArguments".string
    } else return String
}

# unitsWithFiles -- the units under `systemdir` that carry a nativec file: those
# `order` names first, in its order, then the rest by name
unitsWithFiles: function {systemdir: StringView order: (List String).view} out List String is {
    r: List String
    for each o: order loop {
        p: "\{systemdir}/\{o}/nativec.zd"
        if (io.exists path: p) then r.append from: o.copy
    }
    rd: io.listDir path: systemdir
    match (
        rd
    ) case err then {
        return r
    } case ok then null
    rest: List String
    for each e: rd loop {
        p: "\{systemdir}/\{e}/nativec.zd"
        if (io.exists path: p) when (order.contains item: e).not then rest.append from: e.copy
    }
    rest.sort
    for each e: rest loop r.append from: e.copy
    return r
}

# servedFile -- the generated layer's file holding the standard library's C
# implementation as static data: the top-level unit `nativec`, read only by a
# build that names it
servedFile: "nativec.z"

# ServedText -- the text of servedFile, or why it could not be made
ServedText: class {
    text: String
    error: String
}

# servedText -- servedFile's text, made from the files under `systemdir` as they
# are now, each as written and indented under a unit of its own: runtime.zd as
# `runtime`, so each file's `c: runtime.nativec` names it; each unit's
# nativec.zd as `<unit>c`, a subunit file of it inline; then `units`, every
# unit's implementation by the unit's name, system's first, and `sources`, the
# length and hash of each file read.
servedText: function {systemdir: StringView} out ServedText is {
    g: ServedText text: String error: String
    g.text.append "# nativec.z -- GENERATED by zc from runtime.zd and each unit's nativec.zd in\n"
    g.text.append "# the system directory; do not edit. The standard library's C implementation\n"
    g.text.append "# as static data: a unit `<unit>c` per file, and `units`, every one of them.\n\n"
    sources: String
    appendServedUnit :g :sources :systemdir file: "runtime.zd" name: "runtime" by: ""
    first: List String
    first.append "system".string
    names: unitsWithFiles :systemdir order: first
    for each nm: names loop {
        if g.error.length > 0 then return g
        un: "\{nm}c"
        fp: "\{nm}/nativec.zd"
        (
            appendServedUnit
            :g
            :sources
            :systemdir
            file: fp.stringView
            name: un.stringView
            by: ""
            open: true
        )
        for each sf: (subunitFiles :systemdir owner: nm.stringView) loop {
            sp: "\{nm}/nativec/\{sf}"
            sn: sf.stringView.substring from: 0 to: sf.length - 3
            appendServedUnit :g :sources :systemdir file: sp.stringView name: sn by: "    "
        }
        g.text.append "}\n\n"
    }
    if g.error.length > 0 then return g
    g.text.append "# servedUnit -- one unit's implementation, by the unit's name\n"
    g.text.append "servedUnit: data {\n    name: text\n    implementation: runtime.nativec.implementation\n}\n\n"
    g.text.append "# units -- every unit's implementation, system's first\n"
    g.text.append "units: list {\n"
    for each nm: names loop {
        g.text.append "    (servedUnit name: \"\{nm}\" implementation: \{nm}c.implementation)\n"
    }
    g.text.append "} out staticlist servedUnit\n\n"
    g.text.append "# servedSource -- a file this text was made from, as it was then\n"
    g.text.append "servedSource: data {\n    path: text\n    length: 0\n    hash: 0.u64\n}\n\n"
    g.text.append "# sources -- every file this text was made from\n"
    g.text.append "sources: list {\n"
    g.text.append sources
    g.text.append "} out staticlist servedSource\n"
    return g
}

# appendServedUnit -- the file `file` under `systemdir` onto `g`'s text as the
# unit `name`, indented `by` and its lines once more; with `open`, the unit is
# left open for its subunits. Its `sources` row is added, or `g`'s error set.
appendServedUnit: function {
    g: ServedText.borrow
    sources: String.borrow
    systemdir: StringView
    file: StringView
    name: StringView
    by: StringView
    open: false
} is {
    full: "\{systemdir}/\{file}"
    rd: io.readText path: full
    match (
        rd
    ) case err then {
        g.error = "cannot read \{full}"
    } case ok then {
        g.text.append "\{by}\{name}: unit {\n"
        inner: "\{by}    "
        for each ln: rd.stringView.lines loop {
            if ln.length > 0 then {
                g.text.append inner
                g.text.append ln
            }
            g.text.append "\n"
        }
        if open.not then g.text.append "\{by}}\n"
        if by.length == 0 when open.not then g.text.append "\n"
        sources.append (sourceRow path: file text: rd.stringView)
    }
}

# subunitFiles -- the `.zd` files of the unit's nativec subunit folder
# (`<unit>/nativec/`), by name; none when it has no such folder
subunitFiles: function {systemdir: StringView owner: StringView} out List String is {
    r: List String
    dir: "\{systemdir}/\{owner}/nativec"
    if (io.exists path: dir).not then return r
    rd: io.listDir path: dir
    match (
        rd
    ) case ok then {
        for each e: rd loop {
            if e.stringView.endsWith ".zd" then r.append from: e.copy
        }
    } case err then null
    r.sort
    return r
}

# sourceRow -- one `sources` row: a file's path under the system directory,
# its length and its hash (zcheck.stableHash)
sourceRow: function {path: StringView text: StringView} out String is {
    return "    (servedSource path: \"\{path}\" length: \{text.length} hash: \{(
        zcheck.stableHash
        s: text
    )})\n"
}

# ServedProvider -- servedFile as a vfs provider of that one file, whose text
# is made when the file is read (servedText): a build that never names
# `nativec` reads no nativec file
ServedProvider: class {
    # the system directory the text is made from
    systemdir: String
    # the path a diagnostic names: the layer's copy of the file
    shown: String
} as {
    zvfsProvider: ZVfsProvider.implement
    # a file has no entries to walk to
    walk: function {:this name: StringView parent: u32} out u32 is {
        name.drop
        parent.drop
        return 0
    }
    # the text, made now
    open: function {t: this.view item: u32} out zvfs.OpenResult is {
        if item != 0 then {
            nf: IoError.notfound
            return (zvfs.OpenResult.err nf.take)
        }
        st: servedText systemdir: t.systemdir.stringView
        if st.error.length > 0 then {
            e: IoError.other st.error.copy
            return (zvfs.OpenResult.err e.take)
        }
        made: String
        made swap st.text
        return (zvfs.OpenResult.file made.take)
    }
    # the root is the file; nothing is below it
    stat: function {t: this.view item: u32} out zvfs.nodekind is {
        if item == 0 then return zvfs.nodekind.file
        return zvfs.nodekind.notfound
    }
    # the layer's copy, which a diagnostic names
    path: function {t: this.view item: u32} out String is {
        item.drop
        return t.shown.copy
    }
    # read-only: the text is the system directory's
    addFile: function {:this fpath: String.take content: String.take} is {
        fpath.drop
        content.drop
        panic "the served nativec file is read-only"
    }
}

# servedProvider -- servedFile, made from `systemdir`, as a provider to mount;
# `shown` is the path a diagnostic names
servedProvider: function {systemdir: StringView shown: StringView} out ZVfsProvider is {
    sp: ServedProvider systemdir: systemdir.string shown: shown.string
    return (ZVfsProvider.create from: sp.take)
}

# showNative -- `zc natives show WHAT`: what zc carries for WHAT, as the emitter
# holds it -- a unit's rows by key, one row (`unit.key`, every variant of it;
# a foundation group's as `group.key`, a structural row by its key alone) with
# its fields and texts, a template by name, or a fixed file of the foundation by
# its name (`hash`, one piece of it as `hash.mul128`) -- each with where the
# unit's nativec.zd under `systemdir` writes it, as that file's check places it
# (zdata.placeOf) and `zc emit --mark-natives` marks it. With `c`, only the C
# of each, as written, holes and all: a row's fragments or pieces then its
# destroy, a template's sections, a file's pieces. "" when WHAT names none of
# them.
showNative: function {what: StringView systemdir: StringView c: bool} out String is {
    buf: String
    for each u: nativec.units loop {
        un: u.name.stringView
        if (namesInUnit :what :u).not then continue
        path: "\{systemdir}/\{un}/nativec.zd"
        f: zdata.open file: path.stringView srcdirs: List String :systemdir
        im: zdata.definition :f name: "implementation"
        places: itemsNamed :f v: im name: "rows"
        cps: itemsNamed :f v: im name: "classes"
        if what == un when c.not then showUnitRows :buf :u :f :places classPlaces: cps
        showRows :buf :what rows: u.implementation.rows unitName: un :f :places :c
        showClasses :buf :what :u :f places: cps :c
        tps: itemsNamed :f v: im name: "templates"
        k: u64
        for each t: u.implementation.templates loop {
            if what == t.name.stringView then (
                showTemplate
                :buf
                :t
                unitName: un
                at: (placeAt :f places: tps :k).stringView
                :c
            )
            k = k + 1
        }
    }
    showFoundationRows :buf :what :systemdir :c
    showFiles :buf :what :systemdir :c
    return buf
}

# namesInUnit -- whether `what` names unit `u`, one of its rows or one of its
# templates
namesInUnit: function {what: StringView u: nativec.servedUnit} out bool is {
    if what == u.name.stringView then return true
    for each r: u.implementation.rows loop {
        if (namesRow :what unitName: u.name.stringView key: r.key.stringView) then return true
    }
    for each cl: u.implementation.classes loop {
        if (namesRow :what unitName: u.name.stringView key: cl.key.stringView) then return true
    }
    for each t: u.implementation.templates loop {
        if what == t.name.stringView then return true
    }
    return false
}

# showFoundationRows -- showNative over the foundation's rows, which system's
# nativec.zd holds: each group's rows, then the structural rows
showFoundationRows: function {
    buf: String.borrow what: StringView systemdir: StringView c: bool
} is {
    fd: nativec.systemc.foundation
    named: false
    for each g: fd.groups loop {
        for each r: g.rows loop {
            if (namesRow :what unitName: g.name.stringView key: r.key.stringView) then named = true
        }
    }
    for each r: fd.structural loop {
        if (namesRow :what unitName: "" key: r.key.stringView) then named = true
    }
    if named.not then return
    path: "\{systemdir}/system/nativec.zd"
    f: zdata.open file: path.stringView srcdirs: List String :systemdir
    fv: zdata.definition :f name: "foundation"
    gs: itemsNamed :f v: fv name: "groups"
    k: u64
    for each g: fd.groups loop {
        gv: ztypes.noConst
        if k < gs.length then gv = gs.get i: k
        (
            showRows
            :buf
            :what
            rows: g.rows
            unitName: g.name.stringView
            :f
            places: (itemsNamed :f v: gv name: "rows")
            :c
        )
        k = k + 1
    }
    (
        showRows
        :buf
        :what
        rows: fd.structural
        unitName: ""
        :f
        places: (itemsNamed :f v: fv name: "structural")
        :c
    )
}

# showFiles -- showNative over the foundation's fixed files: a file by its name,
# each of its pieces with it, or one piece as `<file>.<piece>`
showFiles: function {buf: String.borrow what: StringView systemdir: StringView c: bool} is {
    fd: nativec.systemc.foundation
    if (namesFile :what :fd).not then return
    path: "\{systemdir}/system/nativec.zd"
    f: zdata.open file: path.stringView srcdirs: List String :systemdir
    fs: itemsNamed :f v: (zdata.definition :f name: "foundation") name: "files"
    k: u64
    for each fl: fd.files loop {
        whole: what == fl.name.stringView
        if whole when c.not then buf.append "file \{fl.name}  \{placeAt :f places: fs :k}\n"
        fv: ztypes.noConst
        if k < fs.length then fv = fs.get i: k
        showFilePieces :buf :what :fl :whole :f places: (itemsNamed :f v: fv name: "pieces") :c
        k = k + 1
    }
}

# namesFile -- whether `what` names a fixed file of `fd` or one of its pieces
namesFile: function {what: StringView fd: schema.foundation} out bool is {
    for each fl: fd.files loop {
        if what == fl.name.stringView then return true
        for each p: fl.pieces loop {
            if (namesPiece :what file: fl.name.stringView piece: p.name.stringView) then return true
        }
    }
    return false
}

# showFilePieces -- showPiece for each piece of file `fl` that `what` names,
# every one when `whole`, placed by the same element of `places`
showFilePieces: function {
    buf: String.borrow
    what: StringView
    fl: schema.file
    whole: bool
    f: zdata.DataFile.view
    places: (ListVal ztypes.cval).view
    c: bool
} is {
    j: u64
    for each p: fl.pieces loop {
        if whole or (namesPiece :what file: fl.name.stringView piece: p.name.stringView) then (
            showPiece
            :buf
            :p
            at: (placeAt :f :places k: j).stringView
            :c
        )
        j = j + 1
    }
}

# namesPiece -- whether `what` is `<file>.<piece>` for a named piece
namesPiece: function {what: StringView file: StringView piece: StringView} out bool is {
    if piece.length == 0 then return false
    return (namesRow :what unitName: file key: piece)
}

# showRows -- showRow for each of `rows` that `what` names, placed by the same
# row of `places`, the rows as `f` checked them
showRows: function {
    buf: String.borrow
    what: StringView
    rows: staticlist schema.row
    unitName: StringView
    f: zdata.DataFile.view
    places: (ListVal ztypes.cval).view
    c: bool
} is {
    k: u64
    for each r: rows loop {
        if (namesRow :what :unitName key: r.key.stringView) then (
            showRow
            :buf
            :r
            :unitName
            at: (placeAt :f :places :k).stringView
            :c
        )
        k = k + 1
    }
}

# itemsNamed -- the elements of list field `name` of data value `v` of `f`
itemsNamed: function {
    f: zdata.DataFile.view v: ztypes.cval name: StringView
} out ListVal ztypes.cval is {
    return (zdata.itemsOf :f v: (zdata.fieldOf :f :v :name))
}

# placeAt -- where element `k` of `places` is written (zdata.placeOf); "" past
# its end, as for a file that did not check
placeAt: function {f: zdata.DataFile.view places: (ListVal ztypes.cval).view k: u64} out String is {
    if k >= places.length then return "".string
    return (zdata.placeOf :f v: (places.get i: k))
}

# showUnitRows -- a unit's rows, one line each: its key and where it is
# written; then its classes and its templates
showUnitRows: function {
    buf: String.borrow
    u: nativec.servedUnit
    f: zdata.DataFile.view
    places: (ListVal ztypes.cval).view
    classPlaces: (ListVal ztypes.cval).view
} is {
    k: u64
    for each r: u.implementation.rows loop {
        buf.append u.name.stringView
        buf.append "."
        buf.append r.key.stringView
        buf.append "  "
        buf.append (placeAt :f :places :k)
        if r.fact.length > 0 then buf.append "  (when \{r.fact})"
        buf.append "\n"
        k = k + 1
    }
    j: u64
    for each cl: u.implementation.classes loop {
        buf.append "class "
        buf.append u.name.stringView
        buf.append "."
        buf.append cl.key.stringView
        buf.append "  "
        buf.append (placeAt :f places: classPlaces k: j)
        buf.append "\n"
        j = j + 1
    }
    for each t: u.implementation.templates loop buf.append "template \{t.name}\n"
}

# showRow -- one row: where it is written, each field it sets, then its texts
# with their holes as written; with `c`, its texts alone
showRow: function {
    buf: String.borrow r: schema.row unitName: StringView at: StringView c: bool
} is {
    if c then {
        for each t: r.fragments loop buf.append "\{t}\n"
        for each p: r.pieces loop buf.append "\{p.text}\n"
        return
    }
    if unitName.length > 0 then buf.append "\{unitName}."
    buf.append r.key.stringView
    buf.append "  "
    buf.append at
    buf.append "\n"
    showField :buf name: "fact" value: r.fact.stringView
    showField :buf name: "body" value: r.body.stringView
    showField :buf name: "needs" value: (listText xs: r.needs).stringView
    showField :buf name: "demand" value: (listText xs: r.demand).stringView
    showField :buf name: "pulls" value: (listText xs: r.pulls).stringView
    showField :buf name: "members" value: (listText xs: r.members).stringView
    showField :buf name: "via" value: r.via.stringView
    showField :buf name: "call" value: (callWord c: r.call).stringView
    if r.form.value then showField :buf name: "form" value: "value"
    if r.byPointer then showField :buf name: "byPointer" value: "true"
    if r.callsEquals then showField :buf name: "callsEquals" value: "true"
    for each t: r.fragments loop showText :buf name: "fragment" text: t.stringView
    for each p: r.pieces loop showPiece :buf :p at: "" c: false
}

# showClasses -- showClass for each class of unit `u` that `what` names, placed
# by the same element of `places`
showClasses: function {
    buf: String.borrow
    what: StringView
    u: nativec.servedUnit
    f: zdata.DataFile.view
    places: (ListVal ztypes.cval).view
    c: bool
} is {
    k: u64
    for each cl: u.implementation.classes loop {
        if (namesRow :what unitName: u.name.stringView key: cl.key.stringView) then (
            showClass
            :buf
            :cl
            unitName: u.name.stringView
            at: (placeAt :f :places :k).stringView
            :c
        )
        k = k + 1
    }
}

# showClass -- one class: where it is written, each field it sets, then its
# destroy with its holes as written; with `c`, its destroy alone
showClass: function {
    buf: String.borrow cl: schema.classRow unitName: StringView at: StringView c: bool
} is {
    if c then {
        if cl.destroy.length > 0 then buf.append "\{cl.destroy}\n"
        return
    }
    buf.append unitName
    buf.append "."
    buf.append cl.key.stringView
    buf.append "  "
    buf.append at
    buf.append "\n"
    showField :buf name: "template" value: cl.template.stringView
    showField :buf name: "live" value: (listText xs: cl.live).stringView
    showField :buf name: "needs" value: (listText xs: cl.needs).stringView
    if cl.destroy.length > 0 then showText :buf name: "destroy" text: cl.destroy.stringView
}

# showTemplate -- a template: where it is written, its needs, then its sections
showTemplate: function {
    buf: String.borrow
    t: schema.template
    unitName: StringView
    at: StringView
    c: bool
} is {
    if c then {
        for each s: t.sections loop buf.append "\{s.text}\n"
        return
    }
    buf.append "template \{t.name} (\{unitName})  \{at}\n"
    showField :buf name: "needs" value: (listText xs: t.needs).stringView
    for each s: t.sections loop {
        reached: String
        if s.reached.length > 0 then reached = " reached=\{s.reached}"
        if s.member.length == 0 then {
            showText :buf name: "section\{reached}".stringView text: s.text.stringView
        } else {
            (
                showText
                :buf
                name: "section \{s.member} needs=\{listText xs: s.needs}\{reached}".stringView
                text: s.text.stringView
            )
        }
    }
}

# showPiece -- one piece: its name, demand and needs, where it is written when
# `at` says, then its text; with `c`, its text alone
showPiece: function {buf: String.borrow p: schema.piece at: StringView c: bool} is {
    if c then {
        buf.append "\{p.text}\n"
        return
    }
    if p.name.length == 0 then {
        showText :buf name: "piece" text: p.text.stringView
        return
    }
    hd: "piece \{p.name} demand=\{listText xs: p.demand}"
    hd.append " needs=\{listText xs: p.needs}"
    if at.length > 0 then hd.append "  \{at}"
    showText :buf name: hd.stringView text: p.text.stringView
}

# showField -- one field of a row as `show` lists it, left out when it is not set
showField: function {buf: String.borrow name: StringView value: StringView} is {
    if value.length > 0 then buf.append "  \{name}: \{value}\n"
}

# showText -- `  name:` then the text, each line indented under it
showText: function {buf: String.borrow name: StringView text: StringView} is {
    buf.append "  \{name}:\n"
    t: text
    if t.endsWith "\n" then t = t.substring from: 0 to: t.length - 1
    for each l: t.lines loop {
        if l.length == 0 then {
            buf.append "\n"
        } else {
            buf.append "    \{l}\n"
        }
    }
}

# namesRow -- whether `what`, as written on the command line, is `<unit>.<key>`,
# or the key alone for a row of no unit
namesRow: function {what: StringView unitName: StringView key: StringView} out bool is {
    if unitName.length == 0 then return what == key
    n: unitName.length
    if what.length != (n + 1 + key.length) then return false
    if (what.startsWith unitName).not then return false
    if ((what.byteAt i: n).or d: 0) != 46 then return false
    return (what.substring from: n + 1 to: what.length) == key
}
