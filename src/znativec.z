# znativec -- the C backend's implementation files. Each unit's
# `<unit>/nativec.zd` under the system directory, a runtime.nativec value
# (lib/system/runtime.zd), is served to every build as the generated unit
# `nativec` (servedText); zc's own build compiles it, so zc carries every unit's
# rows as static data. `generate` writes those rows out as the runtime the
# emitter reads: natives.tbl, natives/<fragment>.inc, the z_<name>.c.tmpl
# templates and the z_<name>.inc fixed files. A fragment's file is named after
# its row (`_Z_<UNIT>_<KEY>`); a piece and a template section are written
# between the markers the emitter cuts them at.

public: unit {
    :generate
    :servedFile
    :servedProvider
    :servedText
}

ZVfsProvider: zvfs.ZVfsProvider

# schema -- the implementation files' schema, as the served unit holds it
schema: nativec.runtime.nativec

# RuntimeFiles -- a generated runtime directory: each file's path relative to
# the directory and its text, in step
RuntimeFiles: class {
    paths: List String
    texts: List String
}

# Gen -- one generation: the files so far, the fragment names already given,
# the table's text
Gen: class {
    files: RuntimeFiles
    used: Set String
    tbl: String
} as {
    # row -- one row of natives.tbl, and the files of its fragments
    row: function {:this r: schema.row owner: StringView} is {
        key: r.key.stringView
        h: "[\{fullKey :owner :key}"
        h.append (attr name: "needs" value: (joined xs: r.needs).stringView)
        frags: String
        for each t: r.fragments loop {
            nm: fragmentName g: this :owner :key
            this.files.paths.append "natives/\{nm}.inc"
            this.files.texts.append "\{t}\n"
            if frags.length > 0 then frags.append ","
            frags.append nm
        }
        if r.pieces.length > 0 then {
            nm: fragmentName g: this :owner :key
            this.files.paths.append "natives/\{nm}.inc"
            this.files.texts.append from: (piecesText ps: r.pieces :owner)
            frags = nm.copy
        }
        h.append (attr name: "frag" value: frags.stringView)
        h.append (attr name: "demand" value: (joined xs: r.demand).stringView)
        if r.form.value then h.append " form=value"
        if r.byPointer then h.append " args=ptr"
        if r.callsEquals then h.append " calls=eq"
        h.append (attr name: "call" value: (callWord c: r.call).stringView)
        cs: String
        for each c: r.constant loop {
            if cs.length > 0 then cs.append ","
            cs.append "\{c}"
        }
        h.append (attr name: "const" value: cs.stringView)
        h.append (attr name: "when" value: r.fact.stringView)
        h.append (attr name: "pulls" value: (joined xs: r.pulls).stringView)
        h.append (attr name: "members" value: (joined xs: r.members).stringView)
        h.append (attr name: "via" value: r.via.stringView)
        if r.template.length > 0 then h.append " tmpl=z_\{r.template}.c.tmpl"
        h.append (attr name: "live" value: (joined xs: r.live).stringView)
        if r.destroy.length > 0 then {
            dkey: "\{key}_destroy"
            nm: fragmentName g: this :owner key: dkey.stringView
            this.files.paths.append "natives/\{nm}.inc"
            this.files.texts.append "\{r.destroy}\n"
            h.append " destroy=\{nm}"
        }
        h.append "]"
        if r.body.length > 0 then h.append " \{r.body}"
        this.tbl.append h
        this.tbl.append "\n"
    }

    # requirements -- a unit's links, sources and refusals as `@unit.` rows
    requirements: function {:this im: schema.implementation owner: StringView} is {
        for each l: im.links loop {
            this.tbl.append "[@unit.\{subunitPath sub: l.subunit.stringView :owner}"
            this.tbl.append (attr name: "when" value: l.fact.stringView)
            this.tbl.append (attr name: "os" value: (osJoined xs: l.os).stringView)
            this.tbl.append " link=\{l.library}]\n"
        }
        for each s: im.sources loop {
            this.tbl.append "[@unit.\{subunitPath sub: s.subunit.stringView :owner}"
            this.tbl.append (attr name: "when" value: s.fact.stringView)
            this.tbl.append (attr name: "os" value: (osJoined xs: s.os).stringView)
            this.tbl.append " csrc=\{s.path}"
            this.tbl.append (attr name: "cdefs" value: (joined xs: s.defines).stringView)
            this.tbl.append "]\n"
        }
        for each f: im.refusals loop {
            this.tbl.append "[@unit.\{subunitPath sub: f.subunit.stringView :owner}"
            this.tbl.append (attr name: "cfeature" value: f.feature.stringView)
            this.tbl.append (attr name: "nocc" value: (compilersJoined xs: f.compilers).stringView)
            this.tbl.append (
                attr
                name: "arch"
                value: (architecturesJoined xs: f.onlyArchitectures).stringView
            )
            this.tbl.append "]\n"
        }
    }

    # headRows -- the rows above every unit's own: the conditions, the facts,
    # the canons, the structural rows, the unit order and the foundation's groups
    headRows: function {:this fd: schema.foundation order: (ListVal u64).view} is {
        for each c: fd.conditions loop this.tbl.append "[@cond \{c.name} = \{c.expression}]\n"
        for each k: order loop {
            u: nativec.units.get i: k
            for each f: u.implementation.facts loop {
                this.tbl.append "[@fact.\{f.name} reach=\{joined xs: f.reach}]\n"
            }
        }
        for each k: order loop {
            u: nativec.units.get i: k
            for each c: u.implementation.canons loop {
                this.tbl.append "[@canon.\{c.stem} spec=\{joined xs: c.spec}]\n"
            }
        }
        for each r: fd.structural loop this.row :r owner: ""
        this.tbl.append "[@units order=\{joined xs: fd.order}]\n"
        for each g: fd.groups loop {
            for each r: g.rows loop this.row :r owner: g.name.stringView
        }
    }

    # template -- one template's file: its needs line, then its sections
    template: function {:this t: schema.template} is {
        x: String
        nd: joined xs: t.needs
        if nd.length > 0 then x.append "/*@@needs \{nd}@@*/\n"
        for each s: t.sections loop {
            if s.member.length == 0 then {
                x.append "\{s.text}\n"
            } else {
                snd: joined xs: s.needs
                x.append "/*@@member \{s.member}\{(
                    attr
                    name: "needs"
                    value: snd.stringView
                )}@@*/\n\{s.text}\n/*@@end@@*/\n"
            }
        }
        this.files.paths.append "z_\{t.name}.c.tmpl"
        this.files.texts.append from: x.take
    }
}

# fullKey -- a row's key as natives.tbl spells it: `<unit>.<key>`, a helper
# `@<unit>.<name>`, a structural case (no unit) `@<key>`
fullKey: function {owner: StringView key: StringView} out String is {
    if owner.length == 0 then return "@\{key}"
    if key.startsWith "@" then return "@\{owner}.\{key.substring from: 1 to: key.length}"
    return "\{owner}.\{key}"
}

# attr -- ` name=value` when the value is not empty
attr: function {name: StringView value: StringView} out String is {
    if value.length == 0 then return String
    return " \{name}=\{value}"
}

# joined -- a list of texts, comma-separated
joined: function {xs: staticlist text} out String is {
    r: String
    for each t: xs loop {
        if r.length > 0 then r.append ","
        r.append t.stringView
    }
    return r
}

# subunitPath -- `<unit>` or `<unit>.<subunit>` for a requirement
subunitPath: function {sub: StringView owner: StringView} out String is {
    if sub.length == 0 then return owner.string
    return "\{owner}.\{sub}"
}

# callWord -- the call choice as natives.tbl's `call=` word; none for the
# general paths
callWord: function {c: schema.call} out String is {
    match (
        c
    ) case simple then {
        return "simple".string
    } case argument then {
        return "arg".string
    } case parse then {
        return "parse".string
    } case noArguments then {
        return "noarg".string
    } else return String
}

# osJoined -- a list of operating systems by their arm names, comma-separated
osJoined: function {xs: staticlist schema.os} out String is {
    r: String
    for each o: xs loop {
        if r.length > 0 then r.append ","
        match (
            o
        ) case linux then {
            r.append "linux"
        } case darwin then {
            r.append "darwin"
        } case windows then {
            r.append "windows"
        } case other then {
            r.append "other"
        }
    }
    return r
}

# compilersJoined -- a list of compilers by their arm names, comma-separated
compilersJoined: function {xs: staticlist schema.compiler} out String is {
    r: String
    for each c: xs loop {
        if r.length > 0 then r.append ","
        match (
            c
        ) case gcc then {
            r.append "gcc"
        } case clang then {
            r.append "clang"
        } case tcc then {
            r.append "tcc"
        } case msvc then {
            r.append "msvc"
        }
    }
    return r
}

# architecturesJoined -- a list of architectures by their arm names
architecturesJoined: function {xs: staticlist schema.architecture} out String is {
    r: String
    for each a: xs loop {
        if r.length > 0 then r.append ","
        match (
            a
        ) case x86_64 then {
            r.append "x86_64"
        } case aarch64 then {
            r.append "aarch64"
        } case other then {
            r.append "other"
        }
    }
    return r
}

# piecesText -- a list of pieces as the text the emitter cuts
piecesText: function {ps: staticlist schema.piece owner: StringView} out String is {
    r: String
    for each p: ps loop {
        if p.name.length == 0 then {
            r.append "\{p.text}\n"
        } else {
            dem: joined xs: p.demand
            nd: joined xs: p.needs
            r.append "/*@@row @\{owner}.\{p.name}\{attr name: "demand" value: dem.stringView}\{(
                attr
                name: "needs"
                value: nd.stringView
            )}@@*/\n"
            r.append "\{p.text}\n/*@@end@@*/\n"
        }
    }
    return r
}

# fragmentName -- the file name of a row's fragment, `_Z_<UNIT>_<KEY>`
fragmentName: function {g: Gen.borrow owner: StringView key: StringView} out String is {
    base: "_Z_\{owner.toUpperAscii}_"
    k: key
    if k.startsWith "@" then k = k.substring from: 1 to: k.length
    up: k.toUpperAscii
    i: u64
    for i < up.length loop {
        b: (up.stringView.byteAt :i).or d: 0
        alnum: (b >= 0cA) and (b <= 0cZ) or ((b >= 0c0) and (b <= 0c9))
        if alnum then {
            base.appendByte :b
        } else {
            base.appendByte 0c_.u8
        }
        i = i + 1
    }
    nm: base.copy
    n: 2.u64
    for (g.used.has item: nm) loop {
        nm = "\{base}_\{n}"
        n = n + 1
    }
    g.used.add item: nm.copy
    return nm
}

# generate -- the runtime directory zc's own copy of the units' rows makes
# (`nativec.units`): the units in the order system's foundation gives, then the
# rest as served
generate: function out RuntimeFiles is {
    g: (
        Gen
        files: (RuntimeFiles paths: List String texts: List String)
        used: Set String
        tbl: String
    )
    fd: nativec.systemc.foundation
    order: unitOrder fd: nativec.systemc.foundation
    g.headRows :fd :order
    for each k: order loop {
        u: nativec.units.get i: k
        for each r: u.implementation.rows loop g.row :r owner: u.name.stringView
        g.requirements im: u.implementation owner: u.name.stringView
        for each t: u.implementation.templates loop g.template :t
    }
    for each fl: fd.files loop {
        g.files.paths.append "z_\{fl.name}.inc"
        g.files.texts.append from: (piecesText ps: fl.pieces owner: "prelude")
    }
    g.files.paths.append "natives.tbl".string
    g.files.texts.append from: g.tbl.copy
    r: RuntimeFiles paths: List String texts: List String
    r swap g.files
    return r
}

# unitOrder -- each served unit's place in `nativec.units`, in the order the
# foundation names them, then the units it does not name, as served
unitOrder: function {fd: schema.foundation} out ListVal u64 is {
    order: ListVal u64
    for each o: fd.order loop {
        k: u64
        for each u: nativec.units loop {
            if u.name.stringView == o.stringView then order.append k
            k = k + 1
        }
    }
    k: u64
    for each u: nativec.units loop {
        named: false
        for each o: fd.order loop {
            if u.name.stringView == o.stringView then named = true
        }
        if named.not then order.append k
        k = k + 1
    }
    return order
}

# unitsWithFiles -- the units under `systemdir` that carry a nativec file: those
# `order` names first, in its order, then the rest by name
unitsWithFiles: function {systemdir: StringView order: (List String).view} out List String is {
    r: List String
    for each o: order loop {
        p: "\{systemdir}/\{o}/nativec.zd"
        if (io.exists path: p) then r.append from: o.copy
    }
    rd: io.listDir path: systemdir
    match (
        rd
    ) case err then {
        return r
    } case ok then null
    rest: List String
    for each e: rd loop {
        p: "\{systemdir}/\{e}/nativec.zd"
        if (io.exists path: p) when (order.contains item: e).not then (
            rest.append
            from: e.copy
        )
    }
    rest.sort
    for each e: rest loop r.append from: e.copy
    return r
}

# servedFile -- the generated layer's file holding the standard library's C
# implementation as static data: the top-level unit `nativec`, read only by a
# build that names it
servedFile: "nativec.z"

# ServedText -- the text of servedFile, or why it could not be made
ServedText: class {
    text: String
    error: String
}

# servedText -- servedFile's text, made from the files under `systemdir` as they
# are now, each as written and indented under a unit of its own: runtime.zd as
# `runtime`, so each file's `c: runtime.nativec` names it; each unit's
# nativec.zd as `<unit>c`, a subunit file of it inline; then `units`, every
# unit's implementation by the unit's name, system's first, and `sources`, the
# length and hash of each file read.
servedText: function {systemdir: StringView} out ServedText is {
    g: ServedText text: String error: String
    g.text.append "# nativec.z -- GENERATED by zc from runtime.zd and each unit's nativec.zd in\n"
    g.text.append "# the system directory; do not edit. The standard library's C implementation\n"
    g.text.append "# as static data: a unit `<unit>c` per file, and `units`, every one of them.\n\n"
    sources: String
    appendServedUnit :g :sources :systemdir file: "runtime.zd" name: "runtime" by: ""
    first: List String
    first.append "system".string
    names: unitsWithFiles :systemdir order: first
    for each nm: names loop {
        if g.error.length > 0 then return g
        un: "\{nm}c"
        fp: "\{nm}/nativec.zd"
        (
            appendServedUnit
            :g
            :sources
            :systemdir
            file: fp.stringView
            name: un.stringView
            by: ""
            open: true
        )
        for each sf: (subunitFiles :systemdir owner: nm.stringView) loop {
            sp: "\{nm}/nativec/\{sf}"
            sn: sf.stringView.substring from: 0 to: sf.length - 3
            appendServedUnit :g :sources :systemdir file: sp.stringView name: sn by: "    "
        }
        g.text.append "}\n\n"
    }
    if g.error.length > 0 then return g
    g.text.append "# servedUnit -- one unit's implementation, by the unit's name\n"
    g.text.append "servedUnit: data {\n    name: text\n    implementation: runtime.nativec.implementation\n}\n\n"
    g.text.append "# units -- every unit's implementation, system's first\n"
    g.text.append "units: list {\n"
    for each nm: names loop {
        g.text.append "    (servedUnit name: \"\{nm}\" implementation: \{nm}c.implementation)\n"
    }
    g.text.append "} out staticlist servedUnit\n\n"
    g.text.append "# servedSource -- a file this text was made from, as it was then\n"
    g.text.append "servedSource: data {\n    path: text\n    length: 0\n    hash: 0.u64\n}\n\n"
    g.text.append "# sources -- every file this text was made from\n"
    g.text.append "sources: list {\n"
    g.text.append sources
    g.text.append "} out staticlist servedSource\n"
    return g
}

# appendServedUnit -- the file `file` under `systemdir` onto `g`'s text as the
# unit `name`, indented `by` and its lines once more; with `open`, the unit is
# left open for its subunits. Its `sources` row is added, or `g`'s error set.
appendServedUnit: function {
    g: ServedText.borrow
    sources: String.borrow
    systemdir: StringView
    file: StringView
    name: StringView
    by: StringView
    open: false
} is {
    full: "\{systemdir}/\{file}"
    rd: io.readText path: full
    match (
        rd
    ) case err then {
        g.error = "cannot read \{full}"
    } case ok then {
        g.text.append "\{by}\{name}: unit {\n"
        inner: "\{by}    "
        for each ln: rd.stringView.lines loop {
            if ln.length > 0 then {
                g.text.append inner
                g.text.append ln
            }
            g.text.append "\n"
        }
        if open.not then g.text.append "\{by}}\n"
        if by.length == 0 when open.not then g.text.append "\n"
        sources.append (sourceRow path: file text: rd.stringView)
    }
}

# subunitFiles -- the `.zd` files of the unit's nativec subunit folder
# (`<unit>/nativec/`), by name; none when it has no such folder
subunitFiles: function {systemdir: StringView owner: StringView} out List String is {
    r: List String
    dir: "\{systemdir}/\{owner}/nativec"
    if (io.exists path: dir).not then return r
    rd: io.listDir path: dir
    match (
        rd
    ) case ok then {
        for each e: rd loop {
            if e.stringView.endsWith ".zd" then r.append from: e.copy
        }
    } case err then null
    r.sort
    return r
}

# sourceRow -- one `sources` row: a file's path under the system directory,
# its length and its hash (zcheck.stableHash)
sourceRow: function {path: StringView text: StringView} out String is {
    return "    (servedSource path: \"\{path}\" length: \{text.length} hash: \{(
        zcheck.stableHash
        s: text
    )})\n"
}

# ServedProvider -- servedFile as a vfs provider of that one file, whose text
# is made when the file is read (servedText): a build that never names
# `nativec` reads no nativec file
ServedProvider: class {
    # the system directory the text is made from
    systemdir: String
    # the path a diagnostic names: the layer's copy of the file
    shown: String
} as {
    :ZVfsProvider
    # a file has no entries to walk to
    walk: function {:this name: StringView parent: u32} out u32 is {
        name.drop
        parent.drop
        return 0
    }
    # the text, made now
    open: function {t: this.view item: u32} out zvfs.OpenResult is {
        if item != 0 then {
            nf: IoError.notfound
            return (zvfs.OpenResult.err nf.take)
        }
        st: servedText systemdir: t.systemdir.stringView
        if st.error.length > 0 then {
            e: IoError.other st.error.copy
            return (zvfs.OpenResult.err e.take)
        }
        made: String
        made swap st.text
        return (zvfs.OpenResult.file made.take)
    }
    # the root is the file; nothing is below it
    stat: function {t: this.view item: u32} out zvfs.nodekind is {
        if item == 0 then return zvfs.nodekind.file
        return zvfs.nodekind.notfound
    }
    # the layer's copy, which a diagnostic names
    path: function {t: this.view item: u32} out String is {
        item.drop
        return t.shown.copy
    }
    # read-only: the text is the system directory's
    addFile: function {:this fpath: String.take content: String.take} is {
        fpath.drop
        content.drop
        panic "the served nativec file is read-only"
    }
}

# servedProvider -- servedFile, made from `systemdir`, as a provider to mount;
# `shown` is the path a diagnostic names
servedProvider: function {systemdir: StringView shown: StringView} out ZVfsProvider is {
    sp: ServedProvider systemdir: systemdir.string shown: shown.string
    return (ZVfsProvider.create from: sp.take)
}
