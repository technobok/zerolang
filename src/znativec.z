# znativec -- the C backend's implementation files, served. Each unit's
# `<unit>/nativec.zd` under the system directory, a runtime.nativec value
# (lib/system/runtime.zd), is served to every build as the generated unit
# `nativec` (servedText), made when a build first reads it (ServedProvider).
# zc's own build compiles it, so zc carries every unit's rows as static data,
# which its emitter registers (zemitterc.registerImplementations).

public: unit {
    :servedFile
    :servedProvider
    :servedText
}

ZVfsProvider: zvfs.ZVfsProvider

# unitsWithFiles -- the units under `systemdir` that carry a nativec file: those
# `order` names first, in its order, then the rest by name
unitsWithFiles: function {systemdir: StringView order: (List String).view} out List String is {
    r: List String
    for each o: order loop {
        p: "\{systemdir}/\{o}/nativec.zd"
        if (io.exists path: p) then r.append from: o.copy
    }
    rd: io.listDir path: systemdir
    match (
        rd
    ) case err then {
        return r
    } case ok then null
    rest: List String
    for each e: rd loop {
        p: "\{systemdir}/\{e}/nativec.zd"
        if (io.exists path: p) when (order.contains item: e).not then (
            rest.append
            from: e.copy
        )
    }
    rest.sort
    for each e: rest loop r.append from: e.copy
    return r
}

# servedFile -- the generated layer's file holding the standard library's C
# implementation as static data: the top-level unit `nativec`, read only by a
# build that names it
servedFile: "nativec.z"

# ServedText -- the text of servedFile, or why it could not be made
ServedText: class {
    text: String
    error: String
}

# servedText -- servedFile's text, made from the files under `systemdir` as they
# are now, each as written and indented under a unit of its own: runtime.zd as
# `runtime`, so each file's `c: runtime.nativec` names it; each unit's
# nativec.zd as `<unit>c`, a subunit file of it inline; then `units`, every
# unit's implementation by the unit's name, system's first, and `sources`, the
# length and hash of each file read.
servedText: function {systemdir: StringView} out ServedText is {
    g: ServedText text: String error: String
    g.text.append "# nativec.z -- GENERATED by zc from runtime.zd and each unit's nativec.zd in\n"
    g.text.append "# the system directory; do not edit. The standard library's C implementation\n"
    g.text.append "# as static data: a unit `<unit>c` per file, and `units`, every one of them.\n\n"
    sources: String
    appendServedUnit :g :sources :systemdir file: "runtime.zd" name: "runtime" by: ""
    first: List String
    first.append "system".string
    names: unitsWithFiles :systemdir order: first
    for each nm: names loop {
        if g.error.length > 0 then return g
        un: "\{nm}c"
        fp: "\{nm}/nativec.zd"
        (
            appendServedUnit
            :g
            :sources
            :systemdir
            file: fp.stringView
            name: un.stringView
            by: ""
            open: true
        )
        for each sf: (subunitFiles :systemdir owner: nm.stringView) loop {
            sp: "\{nm}/nativec/\{sf}"
            sn: sf.stringView.substring from: 0 to: sf.length - 3
            appendServedUnit :g :sources :systemdir file: sp.stringView name: sn by: "    "
        }
        g.text.append "}\n\n"
    }
    if g.error.length > 0 then return g
    g.text.append "# servedUnit -- one unit's implementation, by the unit's name\n"
    g.text.append "servedUnit: data {\n    name: text\n    implementation: runtime.nativec.implementation\n}\n\n"
    g.text.append "# units -- every unit's implementation, system's first\n"
    g.text.append "units: list {\n"
    for each nm: names loop {
        g.text.append "    (servedUnit name: \"\{nm}\" implementation: \{nm}c.implementation)\n"
    }
    g.text.append "} out staticlist servedUnit\n\n"
    g.text.append "# servedSource -- a file this text was made from, as it was then\n"
    g.text.append "servedSource: data {\n    path: text\n    length: 0\n    hash: 0.u64\n}\n\n"
    g.text.append "# sources -- every file this text was made from\n"
    g.text.append "sources: list {\n"
    g.text.append sources
    g.text.append "} out staticlist servedSource\n"
    return g
}

# appendServedUnit -- the file `file` under `systemdir` onto `g`'s text as the
# unit `name`, indented `by` and its lines once more; with `open`, the unit is
# left open for its subunits. Its `sources` row is added, or `g`'s error set.
appendServedUnit: function {
    g: ServedText.borrow
    sources: String.borrow
    systemdir: StringView
    file: StringView
    name: StringView
    by: StringView
    open: false
} is {
    full: "\{systemdir}/\{file}"
    rd: io.readText path: full
    match (
        rd
    ) case err then {
        g.error = "cannot read \{full}"
    } case ok then {
        g.text.append "\{by}\{name}: unit {\n"
        inner: "\{by}    "
        for each ln: rd.stringView.lines loop {
            if ln.length > 0 then {
                g.text.append inner
                g.text.append ln
            }
            g.text.append "\n"
        }
        if open.not then g.text.append "\{by}}\n"
        if by.length == 0 when open.not then g.text.append "\n"
        sources.append (sourceRow path: file text: rd.stringView)
    }
}

# subunitFiles -- the `.zd` files of the unit's nativec subunit folder
# (`<unit>/nativec/`), by name; none when it has no such folder
subunitFiles: function {systemdir: StringView owner: StringView} out List String is {
    r: List String
    dir: "\{systemdir}/\{owner}/nativec"
    if (io.exists path: dir).not then return r
    rd: io.listDir path: dir
    match (
        rd
    ) case ok then {
        for each e: rd loop {
            if e.stringView.endsWith ".zd" then r.append from: e.copy
        }
    } case err then null
    r.sort
    return r
}

# sourceRow -- one `sources` row: a file's path under the system directory,
# its length and its hash (zcheck.stableHash)
sourceRow: function {path: StringView text: StringView} out String is {
    return "    (servedSource path: \"\{path}\" length: \{text.length} hash: \{(
        zcheck.stableHash
        s: text
    )})\n"
}

# ServedProvider -- servedFile as a vfs provider of that one file, whose text
# is made when the file is read (servedText): a build that never names
# `nativec` reads no nativec file
ServedProvider: class {
    # the system directory the text is made from
    systemdir: String
    # the path a diagnostic names: the layer's copy of the file
    shown: String
} as {
    :ZVfsProvider
    # a file has no entries to walk to
    walk: function {:this name: StringView parent: u32} out u32 is {
        name.drop
        parent.drop
        return 0
    }
    # the text, made now
    open: function {t: this.view item: u32} out zvfs.OpenResult is {
        if item != 0 then {
            nf: IoError.notfound
            return (zvfs.OpenResult.err nf.take)
        }
        st: servedText systemdir: t.systemdir.stringView
        if st.error.length > 0 then {
            e: IoError.other st.error.copy
            return (zvfs.OpenResult.err e.take)
        }
        made: String
        made swap st.text
        return (zvfs.OpenResult.file made.take)
    }
    # the root is the file; nothing is below it
    stat: function {t: this.view item: u32} out zvfs.nodekind is {
        if item == 0 then return zvfs.nodekind.file
        return zvfs.nodekind.notfound
    }
    # the layer's copy, which a diagnostic names
    path: function {t: this.view item: u32} out String is {
        item.drop
        return t.shown.copy
    }
    # read-only: the text is the system directory's
    addFile: function {:this fpath: String.take content: String.take} is {
        fpath.drop
        content.drop
        panic "the served nativec file is read-only"
    }
}

# servedProvider -- servedFile, made from `systemdir`, as a provider to mount;
# `shown` is the path a diagnostic names
servedProvider: function {systemdir: StringView shown: StringView} out ZVfsProvider is {
    sp: ServedProvider systemdir: systemdir.string shown: shown.string
    return (ZVfsProvider.create from: sp.take)
}
