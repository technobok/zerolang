# znativec -- the C backend's implementation files: each unit's
# `<unit>/nativec.zd` under the system directory, a runtime.nativec value
# (lib/system/runtime.zd), read with zdata and written out as the runtime
# directory the emitter reads: natives.tbl, natives/<fragment>.inc, the
# z_<name>.c.tmpl templates and the z_<name>.inc fixed files. A fragment's file
# is named after its row (`_Z_<UNIT>_<KEY>`); a piece and a template section are
# written between the markers the emitter cuts them at.

public: unit {
    :generate
    :servedFile
    :servedProvider
    :servedText
}

Ast: zast.Ast
ZVfsProvider: zvfs.ZVfsProvider

# RuntimeFiles -- a generated runtime directory: each file's path relative to
# the directory and its text, in step; `error` is the reason none could be made
RuntimeFiles: class {
    paths: List String
    texts: List String
    error: String
}

# Gen -- one generation: the files so far, the fragment names already given,
# the table's text
Gen: class {
    files: RuntimeFiles
    used: Set String
    tbl: String
    # ncWord interned: the schema's arm names compared by slot
    words: zast.Vocab
} as {
    # row -- one row of natives.tbl, and the files of its fragments
    row: function {:this f: zdata.DataFile.view v: ztypes.cval owner: StringView} is {
        key: field :f :v name: "key"
        h: "[\{fullKey :owner key: key.stringView}"
        h.append (attr name: "needs" value: (joined :f :v name: "needs").stringView)
        frags: String
        for each t: (zdata.textsOf :f v: (zdata.fieldOf :f :v name: "fragments")) loop {
            nm: fragmentName g: this :owner key: key.stringView
            this.files.paths.append "natives/\{nm}.inc"
            this.files.texts.append "\{t}\n"
            if frags.length > 0 then frags.append ","
            frags.append nm
        }
        pv: zdata.fieldOf :f :v name: "pieces"
        if (zdata.itemsOf :f v: pv).length > 0 then {
            nm: fragmentName g: this :owner key: key.stringView
            this.files.paths.append "natives/\{nm}.inc"
            this.files.texts.append from: (piecesText :f v: pv :owner)
            frags = nm.copy
        }
        h.append (attr name: "frag" value: frags.stringView)
        h.append (attr name: "demand" value: (joined :f :v name: "demand").stringView)
        form: zdata.armOf :f v: (zdata.fieldOf :f :v name: "form")
        if (
            (this.words.slotOf text: form.stringView) == ncWord.slot.formValue
        ) then h.append " form=value"
        if (zdata.boolOf v: (zdata.fieldOf :f :v name: "byPointer")) then h.append " args=ptr"
        if (zdata.boolOf v: (zdata.fieldOf :f :v name: "callsEquals")) then h.append " calls=eq"
        call: zdata.armOf :f v: (zdata.fieldOf :f :v name: "call")
        h.append (
            attr
            name: "call"
            value: (callWord arm: (this.words.slotOf text: call.stringView)).stringView
        )
        cs: String
        for each c: (zdata.itemsOf :f v: (zdata.fieldOf :f :v name: "constant")) loop {
            if cs.length > 0 then cs.append ","
            cs.append "\{zdata.integerOf v: c}"
        }
        h.append (attr name: "const" value: cs.stringView)
        h.append (attr name: "when" value: (field :f :v name: "fact").stringView)
        h.append (attr name: "pulls" value: (joined :f :v name: "pulls").stringView)
        h.append (attr name: "members" value: (joined :f :v name: "members").stringView)
        h.append (attr name: "via" value: (field :f :v name: "via").stringView)
        tm: field :f :v name: "template"
        if tm.length > 0 then h.append " tmpl=z_\{tm}.c.tmpl"
        h.append (attr name: "live" value: (joined :f :v name: "live").stringView)
        ds: field :f :v name: "destroy"
        if ds.length > 0 then {
            dkey: "\{key}_destroy"
            nm: fragmentName g: this :owner key: dkey.stringView
            this.files.paths.append "natives/\{nm}.inc"
            this.files.texts.append "\{ds}\n"
            h.append " destroy=\{nm}"
        }
        h.append "]"
        body: field :f :v name: "body"
        if body.length > 0 then h.append " \{body}"
        this.tbl.append h
        this.tbl.append "\n"
    }

    # requirements -- a unit's links, sources and refusals as `@unit.` rows
    requirements: function {:this f: zdata.DataFile.view v: ztypes.cval owner: StringView} is {
        for each l: (zdata.itemsOf :f v: (zdata.fieldOf :f :v name: "links")) loop {
            this.tbl.append "[@unit.\{subunitPath :f v: l :owner}"
            this.tbl.append (attr name: "when" value: (field :f v: l name: "fact").stringView)
            this.tbl.append (attr name: "os" value: (armsJoined :f v: l name: "os").stringView)
            this.tbl.append " link=\{field :f v: l name: "library"}]\n"
        }
        for each s: (zdata.itemsOf :f v: (zdata.fieldOf :f :v name: "sources")) loop {
            this.tbl.append "[@unit.\{subunitPath :f v: s :owner}"
            this.tbl.append (attr name: "when" value: (field :f v: s name: "fact").stringView)
            this.tbl.append (attr name: "os" value: (armsJoined :f v: s name: "os").stringView)
            this.tbl.append " csrc=\{field :f v: s name: "path"}"
            this.tbl.append (attr name: "cdefs" value: (joined :f v: s name: "defines").stringView)
            this.tbl.append "]\n"
        }
        for each r: (zdata.itemsOf :f v: (zdata.fieldOf :f :v name: "refusals")) loop {
            this.tbl.append "[@unit.\{subunitPath :f v: r :owner}"
            this.tbl.append (attr name: "cfeature" value: (field :f v: r name: "feature").stringView
            )
            this.tbl.append (
                attr
                name: "nocc"
                value: (armsJoined :f v: r name: "compilers").stringView
            )
            this.tbl.append (
                attr
                name: "arch"
                value: (armsJoined :f v: r name: "onlyArchitectures").stringView
            )
            this.tbl.append "]\n"
        }
    }

    # headRows -- the rows above every unit's own: the conditions, the facts, the canons, the structural rows, the unit order and the foundation's groups
    headRows: function {
        :this
        sys: zdata.DataFile.view
        fd: ztypes.cval
        dfs: (List zdata.DataFile).view
        order: (List String).view
    } is {
        for each c: (zdata.itemsOf f: sys v: (zdata.fieldOf f: sys v: fd name: "conditions")) loop {
            this.tbl.append "[@cond \{field f: sys v: c name: "name"} = \{(
                field
                f: sys
                v: c
                name: "expression"
            )}]\n"
        }
        for each df: dfs loop {
            im: zdata.definition f: df name: "implementation"
            for each c: (zdata.itemsOf f: df v: (zdata.fieldOf f: df v: im name: "facts")) loop {
                this.tbl.append "[@fact.\{field f: df v: c name: "name"} reach=\{(
                    joined
                    f: df
                    v: c
                    name: "reach"
                )}]\n"
            }
        }
        for each df: dfs loop {
            im: zdata.definition f: df name: "implementation"
            for each c: (zdata.itemsOf f: df v: (zdata.fieldOf f: df v: im name: "canons")) loop {
                this.tbl.append "[@canon.\{field f: df v: c name: "stem"} spec=\{(
                    joined
                    f: df
                    v: c
                    name: "spec"
                )}]\n"
            }
        }
        for each r: (zdata.itemsOf f: sys v: (zdata.fieldOf f: sys v: fd name: "structural")) loop {
            this.row f: sys v: r owner: ""
        }
        ordText: String
        for each o: order loop {
            if ordText.length > 0 then ordText.append ","
            ordText.append o
        }
        this.tbl.append "[@units order=\{ordText}]\n"
        for each gr: (zdata.itemsOf f: sys v: (zdata.fieldOf f: sys v: fd name: "groups")) loop {
            gn: field f: sys v: gr name: "name"
            for each r: (zdata.itemsOf f: sys v: (zdata.fieldOf f: sys v: gr name: "rows")) loop {
                this.row f: sys v: r owner: gn.stringView
            }
        }
    }

    # unitRows -- each unit's rows, requirements and templates, in load order
    unitRows: function {:this dfs: (List zdata.DataFile).view names: (List String).view} is {
        k: u64
        for k < dfs.length loop {
            df: dfs.get i: k
            nm: names.get i: k
            k = k + 1
            im: zdata.definition f: df name: "implementation"
            for each r: (zdata.itemsOf f: df v: (zdata.fieldOf f: df v: im name: "rows")) loop {
                this.row f: df v: r owner: nm.stringView
            }
            this.requirements f: df v: im owner: nm.stringView
            for each t: (zdata.itemsOf f: df v: (zdata.fieldOf f: df v: im name: "templates")
            ) loop {
                this.template f: df v: t
            }
        }
    }

    # fixedFiles -- the fixed files the foundation holds, each its pieces
    fixedFiles: function {:this sys: zdata.DataFile.view fd: ztypes.cval} is {
        for each fl: (zdata.itemsOf f: sys v: (zdata.fieldOf f: sys v: fd name: "files")) loop {
            fname: field f: sys v: fl name: "name"
            txt: piecesText f: sys v: (zdata.fieldOf f: sys v: fl name: "pieces") owner: "prelude"
            this.files.paths.append "z_\{fname}.inc"
            this.files.texts.append from: txt.take
        }
    }

    # template -- one template's file: its needs line, then its sections
    template: function {:this f: zdata.DataFile.view v: ztypes.cval} is {
        t: String
        nd: joined :f :v name: "needs"
        if nd.length > 0 then t.append "/*@@needs \{nd}@@*/\n"
        for each s: (zdata.itemsOf :f v: (zdata.fieldOf :f :v name: "sections")) loop {
            m: field :f v: s name: "member"
            txt: field :f v: s name: "text"
            if m.length == 0 then {
                t.append "\{txt}\n"
            } else {
                snd: joined :f v: s name: "needs"
                t.append "/*@@member \{m}\{(
                    attr
                    name: "needs"
                    value: snd.stringView
                )}@@*/\n\{txt}\n/*@@end@@*/\n"
            }
        }
        this.files.paths.append "z_\{field :f :v name: "name"}.c.tmpl"
        this.files.texts.append from: t.take
    }
}

# takeFiles -- the files a generation made, moved out of it
takeFiles: function {g: Gen.borrow} out RuntimeFiles is {
    r: RuntimeFiles paths: List String texts: List String error: String
    r swap g.files
    return r
}

# subunitPath -- `<unit>` or `<unit>.<subunit>` for a requirement
subunitPath: function {f: zdata.DataFile.view v: ztypes.cval owner: StringView} out String is {
    sub: field :f :v name: "subunit"
    if sub.length == 0 then return owner.string
    return "\{owner}.\{sub}"
}

# ncWord -- the arm names of the nativec schema's choices that the table spells
# its own way, a vocabulary (ncWords) compared by slot
ncWord: list {
    formValue: "value"
    callGeneral: "general"
    callSimple: "simple"
    callArgument: "argument"
    callParse: "parse"
    callNoArguments: "noArguments"
} out staticlist StringView

# callWord -- the call choice's arm, by its ncWord slot, as natives.tbl's
# `call=` word; none for the general paths
callWord: function {arm: u64} out String is {
    if arm == ncWord.slot.callSimple then return "simple".string
    if arm == ncWord.slot.callArgument then return "arg".string
    if arm == ncWord.slot.callParse then return "parse".string
    if arm == ncWord.slot.callNoArguments then return "noarg".string
    return String
}

# generate -- the runtime directory the nativec files under `systemdir` stand
# for. The units load in the order system's foundation gives, then the rest by
# name.
generate: function {systemdir: StringView} out RuntimeFiles is {
    g: (
        Gen
        files: (RuntimeFiles paths: List String texts: List String error: String)
        used: Set String
        tbl: String
        words: (zast.Vocab.create block: ncWord)
    )
    sysPath: "\{systemdir}/system/nativec.zd"
    sys: openUnit file: sysPath.stringView :systemdir
    if sys.ok.not then {
        g.files.error = zdata.errorsText f: sys
        return (takeFiles :g)
    }
    fd: zdata.definition f: sys name: "foundation"
    order: zdata.textsOf f: sys v: (zdata.fieldOf f: sys v: fd name: "order")
    names: unitsWithFiles :systemdir :order
    dfs: List zdata.DataFile
    for each nm: names loop {
        p: "\{systemdir}/\{nm}/nativec.zd"
        df: openUnit file: p.stringView :systemdir
        if df.ok.not then {
            g.files.error = zdata.errorsText f: df
            return (takeFiles :g)
        }
        dfs.append from: df.take
    }
    g.headRows :sys :fd :dfs :order
    g.unitRows :dfs :names
    g.fixedFiles :sys :fd
    g.files.paths.append "natives.tbl".string
    g.files.texts.append from: g.tbl.copy
    return (takeFiles :g)
}

# openUnit -- a nativec file checked, its schema found under `systemdir`
openUnit: function {file: StringView systemdir: StringView} out zdata.DataFile is {
    return (zdata.open :file srcdirs: List String :systemdir)
}

# unitsWithFiles -- the units under `systemdir` that carry a nativec file: those
# `order` names first, in its order, then the rest by name
unitsWithFiles: function {systemdir: StringView order: (List String).view} out List String is {
    r: List String
    for each o: order loop {
        p: "\{systemdir}/\{o}/nativec.zd"
        if (io.exists path: p) then r.append from: o.copy
    }
    rd: io.listDir path: systemdir
    match (
        rd
    ) case err then {
        return r
    } case ok then null
    rest: List String
    for each e: rd loop {
        p: "\{systemdir}/\{e}/nativec.zd"
        if (io.exists path: p) when (order.contains item: e).not then (
            rest.append
            from: e.copy
        )
    }
    rest.sort
    for each e: rest loop r.append from: e.copy
    return r
}

# field -- a text field of a data value
field: function {f: zdata.DataFile.view v: ztypes.cval name: StringView} out String is {
    return (zdata.textOf :f v: (zdata.fieldOf :f :v :name))
}

# joined -- a list-of-text field, comma-separated
joined: function {f: zdata.DataFile.view v: ztypes.cval name: StringView} out String is {
    r: String
    for each t: (zdata.textsOf :f v: (zdata.fieldOf :f :v :name)) loop {
        if r.length > 0 then r.append ","
        r.append t
    }
    return r
}

# armsJoined -- a list-of-choice field, its arms comma-separated
armsJoined: function {f: zdata.DataFile.view v: ztypes.cval name: StringView} out String is {
    r: String
    for each a: (zdata.itemsOf :f v: (zdata.fieldOf :f :v :name)) loop {
        if r.length > 0 then r.append ","
        r.append (zdata.armOf :f v: a)
    }
    return r
}

# attr -- ` name=value` when the value is not empty
attr: function {name: StringView value: StringView} out String is {
    if value.length == 0 then return String
    return " \{name}=\{value}"
}

# fullKey -- a row's key as natives.tbl spells it: `<unit>.<key>`, a helper
# `@<unit>.<name>`, a structural case (no unit) `@<key>`
fullKey: function {owner: StringView key: StringView} out String is {
    if owner.length == 0 then return "@\{key}"
    if key.startsWith "@" then return "@\{owner}.\{key.substring from: 1 to: key.length}"
    return "\{owner}.\{key}"
}

# piecesText -- a list of pieces as the text the emitter cuts: a piece with no
# demand as it stands, a demanded one between `/*@@row` and `/*@@end@@*/`
piecesText: function {f: zdata.DataFile.view v: ztypes.cval owner: StringView} out String is {
    r: String
    for each p: (zdata.itemsOf :f :v) loop {
        nm: field :f v: p name: "name"
        txt: field :f v: p name: "text"
        if nm.length == 0 then {
            r.append "\{txt}\n"
        } else {
            dem: joined :f v: p name: "demand"
            nd: joined :f v: p name: "needs"
            r.append "/*@@row @\{owner}.\{nm}\{attr name: "demand" value: dem.stringView}\{(
                attr
                name: "needs"
                value: nd.stringView
            )}@@*/\n"
            r.append "\{txt}\n/*@@end@@*/\n"
        }
    }
    return r
}

# fragmentName -- the file name of a row's fragment, `_Z_<UNIT>_<KEY>`, each
# byte that is no letter or digit `_`, suffixed until it is unused
fragmentName: function {g: Gen.borrow owner: StringView key: StringView} out String is {
    base: "_Z_\{owner.toUpperAscii}_"
    k: key
    if k.startsWith "@" then k = k.substring from: 1 to: k.length
    up: k.toUpperAscii
    i: u64
    for i < up.length loop {
        b: (up.stringView.byteAt :i).or d: 0
        alnum: (b >= 0cA) and (b <= 0cZ) or ((b >= 0c0) and (b <= 0c9))
        if alnum then {
            base.appendByte :b
        } else {
            base.appendByte 0c_.u8
        }
        i = i + 1
    }
    nm: base.copy
    n: 2.u64
    for (g.used.has item: nm) loop {
        nm = "\{base}_\{n}"
        n = n + 1
    }
    g.used.add item: nm.copy
    return nm
}

# servedFile -- the generated layer's file holding the standard library's C
# implementation as static data: the top-level unit `nativec`, read only by a
# build that names it
servedFile: "nativec.z"

# ServedText -- the text of servedFile, or why it could not be made
ServedText: class {
    text: String
    error: String
}

# servedText -- servedFile's text, made from the files under `systemdir` as they
# are now, each as written and indented under a unit of its own: runtime.zd as
# `runtime`, so each file's `c: runtime.nativec` names it; each unit's
# nativec.zd as `<unit>c`, a subunit file of it inline; then `stdlib`, every
# unit's implementation, system's first, and `sources`, the length and hash of
# each file read.
servedText: function {systemdir: StringView} out ServedText is {
    g: ServedText text: String error: String
    g.text.append "# nativec.z -- GENERATED by zc from runtime.zd and each unit's nativec.zd in\n"
    g.text.append "# the system directory; do not edit. The standard library's C implementation\n"
    g.text.append "# as static data: a unit `<unit>c` per file, and `stdlib`, every one of them.\n\n"
    sources: String
    appendServedUnit :g :sources :systemdir file: "runtime.zd" name: "runtime" by: ""
    first: List String
    first.append "system".string
    names: unitsWithFiles :systemdir order: first
    for each nm: names loop {
        if g.error.length > 0 then return g
        un: "\{nm}c"
        fp: "\{nm}/nativec.zd"
        (
            appendServedUnit
            :g
            :sources
            :systemdir
            file: fp.stringView
            name: un.stringView
            by: ""
            open: true
        )
        for each sf: (subunitFiles :systemdir owner: nm.stringView) loop {
            sp: "\{nm}/nativec/\{sf}"
            sn: sf.stringView.substring from: 0 to: sf.length - 3
            appendServedUnit :g :sources :systemdir file: sp.stringView name: sn by: "    "
        }
        g.text.append "}\n\n"
    }
    if g.error.length > 0 then return g
    g.text.append "# stdlib -- every unit's implementation, system's first\n"
    g.text.append "stdlib: list {\n"
    for each nm: names loop g.text.append "    \{nm}c.implementation\n"
    g.text.append "} out staticlist runtime.nativec.implementation\n\n"
    g.text.append "# servedSource -- a file this text was made from, as it was then\n"
    g.text.append "servedSource: data {\n    path: text\n    length: 0\n    hash: 0.u64\n}\n\n"
    g.text.append "# sources -- every file this text was made from\n"
    g.text.append "sources: list {\n"
    g.text.append sources
    g.text.append "} out staticlist servedSource\n"
    return g
}

# appendServedUnit -- the file `file` under `systemdir` onto `g`'s text as the
# unit `name`, indented `by` and its lines once more; with `open`, the unit is
# left open for its subunits. Its `sources` row is added, or `g`'s error set.
appendServedUnit: function {
    g: ServedText.borrow
    sources: String.borrow
    systemdir: StringView
    file: StringView
    name: StringView
    by: StringView
    open: false
} is {
    full: "\{systemdir}/\{file}"
    rd: io.readText path: full
    match (
        rd
    ) case err then {
        g.error = "cannot read \{full}"
    } case ok then {
        g.text.append "\{by}\{name}: unit {\n"
        inner: "\{by}    "
        for each ln: rd.stringView.lines loop {
            if ln.length > 0 then {
                g.text.append inner
                g.text.append ln
            }
            g.text.append "\n"
        }
        if open.not then g.text.append "\{by}}\n"
        if by.length == 0 when open.not then g.text.append "\n"
        sources.append (sourceRow path: file text: rd.stringView)
    }
}

# subunitFiles -- the `.zd` files of the unit's nativec subunit folder
# (`<unit>/nativec/`), by name; none when it has no such folder
subunitFiles: function {systemdir: StringView owner: StringView} out List String is {
    r: List String
    dir: "\{systemdir}/\{owner}/nativec"
    if (io.exists path: dir).not then return r
    rd: io.listDir path: dir
    match (
        rd
    ) case ok then {
        for each e: rd loop {
            if e.stringView.endsWith ".zd" then r.append from: e.copy
        }
    } case err then null
    r.sort
    return r
}

# sourceRow -- one `sources` row: a file's path under the system directory,
# its length and its hash (zcheck.stableHash)
sourceRow: function {path: StringView text: StringView} out String is {
    return "    (servedSource path: \"\{path}\" length: \{text.length} hash: \{(
        zcheck.stableHash
        s: text
    )})\n"
}

# ServedProvider -- servedFile as a vfs provider of that one file, whose text
# is made when the file is read (servedText): a build that never names
# `nativec` reads no nativec file
ServedProvider: class {
    # the system directory the text is made from
    systemdir: String
    # the path a diagnostic names: the layer's copy of the file
    shown: String
} as {
    :ZVfsProvider
    # a file has no entries to walk to
    walk: function {:this name: StringView parent: u32} out u32 is {
        name.drop
        parent.drop
        return 0
    }
    # the text, made now
    open: function {t: this.view item: u32} out zvfs.OpenResult is {
        if item != 0 then {
            nf: IoError.notfound
            return (zvfs.OpenResult.err nf.take)
        }
        st: servedText systemdir: t.systemdir.stringView
        if st.error.length > 0 then {
            e: IoError.other st.error.copy
            return (zvfs.OpenResult.err e.take)
        }
        made: String
        made swap st.text
        return (zvfs.OpenResult.file made.take)
    }
    # the root is the file; nothing is below it
    stat: function {t: this.view item: u32} out zvfs.nodekind is {
        if item == 0 then return zvfs.nodekind.file
        return zvfs.nodekind.notfound
    }
    # the layer's copy, which a diagnostic names
    path: function {t: this.view item: u32} out String is {
        item.drop
        return t.shown.copy
    }
    # read-only: the text is the system directory's
    addFile: function {:this fpath: String.take content: String.take} is {
        fpath.drop
        content.drop
        panic "the served nativec file is read-only"
    }
}

# servedProvider -- servedFile, made from `systemdir`, as a provider to mount;
# `shown` is the path a diagnostic names
servedProvider: function {systemdir: StringView shown: StringView} out ZVfsProvider is {
    sp: ServedProvider systemdir: systemdir.string shown: shown.string
    return (ZVfsProvider.create from: sp.take)
}
