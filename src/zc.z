# zerolang compiler driver: the `zc` command-line interface.
#
# Parses a unit over a stdlib + source VFS, type-checks it, then builds
# it to a native executable (build), runs it (run), emits standalone C
# (emit), dumps the typecheck model (dump), or explains an error code
# (explain). A subcommand is required. See docs/zc.pdoc for the reference.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :main
}

Node: zast.Node

# spacesOf -- a String of n spaces (caret alignment).
spacesOf: function {n: u64} out String is {
    buf: String
    i: u64
    for i < n loop {
        buf.append " "
        i = i + 1
    }
    return buf
}

# caretsOf -- a String of n carets (token underline).
caretsOf: function {n: u64} out String is {
    buf: String
    i: u64
    for i < n loop {
        buf.append "^"
        i = i + 1
    }
    return buf
}

# rpad4 -- a number right-aligned to width 4 (the source-line gutter).
rpad4: function {n: u32} out String is {
    ns: "\{n}"
    w: ns.length
    buf: String
    if w < 4 then {
        k: 4.u64 - w
        sp: spacesOf n: k
        buf.append sp
    }
    buf.append ns
    return buf
}

# errorMessage -- rustc-style render: code+message, location, source snippet +
# caret, then note/hint. fallbackFsno (the main unit's file) covers errors that
# carry no file id of their own (typecheck errors stamp fsno 0).
errorMessage: function {
    e: zast.ErrorData.view
    vfs: zvfs.ZVfs
    ast: zast.Ast.view
    fallbackFsno: zvfs.fsno
} out String is {
    buf: zast.errorLine :e
    fno: e.fsno
    if fno.u64 == 0 when e.nodeid > 0 then {
        sf: ast.fsnoForNode nodeid: e.nodeid
        if sf.u64 > 0 then fno = sf
    }
    if fno.u64 == 0 then fno = fallbackFsno
    if fno.u64 > 0 when e.lineno > 0 then {
        path: vfs.pathfromprovider dentryid: fno
        loc: " --> \{path}:\{e.lineno}:\{e.colno}"
        buf.append "\n"
        buf.append loc
        lnOpt: vfs.getline dentryid: fno lineno: (e.lineno - 1).u64
        match (
            lnOpt
        ) case some then {
            src: lnOpt
            gut: rpad4 n: e.lineno
            eg: spacesOf n: 4
            co: e.colno
            if co > 0 then co = co - 1
            sp: spacesOf n: co.u64
            buf.append "\n"
            buf.append gut
            buf.append " | "
            buf.append src
            buf.append "\n"
            buf.append eg
            buf.append " | "
            buf.append sp
            cw: e.width
            if cw < 1 then cw = 1
            car: caretsOf n: cw.u64
            buf.append car
        } case none then null
    }
    if e.note.length > 0 then {
        ntl: "\n     = note: \{e.note}"
        buf.append ntl
    }
    if e.hint.length > 0 then {
        htl: "\n     = hint: \{e.hint}"
        buf.append htl
    }
    return buf
}

# failEmitErrors -- failures the emitter recorded: compile-time `error`
# calls proved reachable and constructs it cannot emit. Report each in the
# checker's format and exit non-zero (no C is written or compiled).
failEmitErrors: function {errs: (List String).view} is {
    n: errs.length
    if n == 0 then return
    with eit: errs.iterate do for e: eit loop {
        el: "error[E0500]: \{e.stringview}"
        io.eprintln el
    }
    if n == 1 then {
        io.eprintln "1 error found"
    } else {
        es: "\{n} errors found"
        io.eprintln es
    }
    os.exit code: 1
}

# printPhases -- the --time report: per-phase wall on the monotonic clock.
printPhases: function {t0: i64 t1: i64 t2: i64 t3: i64} is {
    io.eprintln "zc --time: parse=\{t1 - t0}ms typecheck=\{t2 - t1}ms emit=\{t3 - t2}ms total=\{t3 - t0}ms"
}

# isPipelineVerb -- arg1 is a verb that proceeds to flag parsing. build/run/
# emit/dump compile a unit; env prints settings. version/help/explain are
# handled before this and exit early, so they are intentionally absent here.
isPipelineVerb: function {name: StringView} out bool is {
    if name == "build" then return true
    if name == "run" then return true
    if name == "emit" then return true
    if name == "dump" then return true
    if name == "env" then return true
    return false
}

# printUsage -- the general help text (stderr): command groups, then flags.
printUsage: function is {
    io.eprintln "usage: zc <command> [arguments] [flags]"
    io.eprintln ""
    io.eprintln "build commands:"
    io.eprintln "  build <src>          compile <src> to a native executable"
    io.eprintln "  run   <src> [args]   build, then run it, forwarding [args]"
    io.eprintln "  emit  <src>          emit standalone C (-o FILE, else stdout)"
    io.eprintln ""
    io.eprintln "diagnostics:"
    io.eprintln "  dump  <src>          dump the typecheck model as SQL (--canon: id-normalized)"
    io.eprintln "  natives              print the generated conversion rows of natives.tbl"
    io.eprintln "  explain <code>       explain an error code, e.g. zc explain E0200"
    io.eprintln ""
    io.eprintln "info:"
    io.eprintln "  env                  print resolved tool paths and settings"
    io.eprintln "  version              print the version"
    io.eprintln "  help [command]       print usage, or help for one command"
    io.eprintln ""
    io.eprintln "<src> is a unit name (hello) or a path (hello.z, ./sub/hello.z)."
    io.eprintln ""
    io.eprintln "common flags:"
    io.eprintln "  -o OUT  --src DIR  --release  --cc CC  --cc-mode MODE"
    io.eprintln "  --target TRIPLE"
    io.eprintln "  --cflags STR  --ldflags STR  --save-temps  --time  --fast-hash"
    io.eprintln "  --readable-names  --eager"
    io.eprintln "  --system DIR  --runtime DIR  --tcc-lib DIR  -h/--help  -V/--version"
}

# printCommandHelp -- detailed help for one command (stderr).
printCommandHelp: function {cmd: StringView} is {
    if cmd == "build" then {
        io.eprintln "usage: zc build <src> [flags]"
        io.eprintln "Compile <src> to a native executable."
        io.eprintln "Output goes to -o OUT, else ./<unit> (./<unit>.exe for windows targets)."
        io.eprintln "Flags: --release --cc CC --cc-mode spawn|inproc --target TRIPLE"
        io.eprintln "       --save-temps"
        io.eprintln "       --cflags STR --ldflags STR --src DIR --tcc-lib DIR"
    } else if cmd == "run" then {
        io.eprintln "usage: zc run <src> [args] [flags]"
        io.eprintln "Build <src>, then run it. Flags before <src> configure the build;"
        io.eprintln "args after <src> (or after --) are passed to the program."
        io.eprintln "The program's own exit code is propagated."
    } else if cmd == "emit" then {
        io.eprintln "usage: zc emit <src> [flags]"
        io.eprintln "Emit standalone C17 to -o FILE (or stdout). The runtime is inlined,"
        io.eprintln "so the single .c needs no extra include paths."
    } else if cmd == "dump" then {
        io.eprintln "usage: zc dump <src> [--canon] [flags]"
        io.eprintln "Dump the typecheck model as SQL to -o FILE (or stdout)."
        io.eprintln "--canon emits the id-normalized model instead."
    } else if cmd == "natives" then {
        io.eprintln "usage: zc natives"
        io.eprintln "Print the conversions section of src/runtime/natives.tbl, derived from"
        io.eprintln "the numeric rule. natives-tbl-guard diffs this against the checked-in"
        io.eprintln "file, so the table cannot drift from the rule it caches."
    } else if cmd == "explain" then {
        io.eprintln "usage: zc explain <code>"
        io.eprintln "Explain a diagnostic error code, e.g. zc explain E0200."
    } else if cmd == "env" then {
        io.eprintln "usage: zc env"
        io.eprintln "Print resolved tool paths and settings: system, runtime and tcc dirs,"
        io.eprintln "the C compiler, the target triple, and the version."
    } else if cmd == "version" then {
        io.eprintln "usage: zc version"
        io.eprintln "Print the compiler version."
    } else if cmd == "help" then {
        io.eprintln "usage: zc help [command]"
        io.eprintln "Print general usage, or detailed help for one command."
    } else {
        m: "zc help: unknown command '\{cmd}'"
        io.eprintln m
        printUsage
    }
}

# printVersion -- a version line (stdout).
printVersion: function is {
    v: zversion.versionLine tool: "zc"
    print "\{v}\n"
}

# substr -- the bytes of p in [start, end) as a new String.
substr: function {p: StringView start: u64 end: u64} out String is {
    r: String
    i: start
    for i < end loop {
        b: p.byteAt :i
        match (
            b
        ) case some then {
            r.appendByte :b
        } case none then null
        i = i + 1
    }
    return r
}

# baseName -- the final path segment of p (everything after the last '/').
baseName: function {p: StringView} out String is {
    idxOpt: p.lastIndexOf needle: "/"
    match (
        idxOpt
    ) case some then {
        s: idxOpt + 1
        pl: p.length
        return (substr :p start: s end: pl)
    } case none then {
        return p.string
    }
}

# stripDotZ -- p without a trailing ".z" extension, if present.
stripDotZ: function {p: StringView} out String is {
    if (p.endsWith suffix: ".z") then {
        e: p.length - 2
        return (substr :p start: 0 end: e)
    }
    return p.string
}

# printEnv -- resolved tool paths and settings as KEY=VALUE lines (stdout).
printEnv: function {
    systemFlag: StringView
    runtimeFlag: StringView
    ccFlag: StringView
    ccModeFlag: StringView
    targetTriple: StringView
    tccLibFlag: StringView
} is {
    sysd: zcheck.resolveSystemDir flagVal: systemFlag
    rund: zcheck.resolveRuntimeDir flagVal: runtimeFlag
    cc: zcheck.pickCc :ccFlag :targetTriple
    ccm: zcheck.pickCcMode modeFlag: ccModeFlag
    tccd: zcheck.resolveTccDir flagVal: tccLibFlag
    tccx: zcheck.vendoredTcc
    root: zcheck.exeRoot
    ver: zversion.semver
    commit: os.buildCommit
    bdate: os.buildDate
    bcc: os.buildCompiler
    exep: String
    ep: os.exePath
    match (
        ep
    ) case ok then {
        exep = ep.copy
    } case err then null
    buf: String
    buf.append "ZEROLANG_ROOT="
    buf.append root
    buf.append "\nZEROLANG_SYSTEM="
    buf.append sysd
    buf.append "\nZEROLANG_RUNTIME="
    buf.append rund
    buf.append "\nZC_CC="
    buf.append cc
    buf.append "\nZC_CC_MODE="
    buf.append ccm
    buf.append "\nZC_TCC="
    buf.append tccx
    buf.append "\nZC_TCC_LIB="
    buf.append tccd
    buf.append "\nZC_TARGET="
    buf.append targetTriple
    buf.append "\nZC_VERSION="
    buf.append ver
    buf.append "\nZC_COMMIT="
    buf.append commit
    buf.append "\nZC_BUILD_DATE="
    buf.append bdate
    buf.append "\nZC_BUILD_CC="
    buf.append bcc
    buf.append "\nZC_EXE="
    buf.append exep
    buf.append "\n"
    print buf
}

# tempPath -- $TMPDIR (or /tmp) / zc-<pid>-<uname><ext>.
tempPath: function {uname: StringView ext: StringView} out String is {
    base: "/tmp".string
    te: os.env key: "TMPDIR"
    match (
        te
    ) case some then {
        if te.length > 0 then base = te.copy
    } case none then null
    pid: os.pid
    ps: "\{pid}"
    r: String
    r.append base
    r.append "/zc-"
    r.append ps
    r.append "-"
    r.append uname
    r.append ext
    return r
}

# buildExe -- turn the emitted C into an executable, by running the C
# compiler as a child process or by loading libtcc into this one. Debug is
# -O0 -g; --release is -O2. cflags/ldflags split on spaces. Empty out/err
# paths inherit the terminal so cc diagnostics print live.
#
# Both modes return the same i32 and write the same kind of artifact -- a
# file on disk -- so `zc run` spawns the result either way and exit codes,
# signals and the leak corpus see no difference. In-process buys the fast
# COMPILE and nothing else.
buildExe: function {
    cc: StringView
    tempC: StringView
    exe: StringView
    release: bool
    cflags: StringView
    ldflags: StringView
    libs: (List String).view
    tccDir: StringView
    inproc: bool
} out i32 is {
    if inproc then {
        # ldflags has no in-process counterpart: libtcc links through the
        # same state that compiled, and what it accepts arrives via cflags.
        return (tcc.compileToExe
            csrc: tempC
            :exe
            :tccDir
            :release
            :cflags
            :libs
        )
    }
    a: (List String)
    a.append from: cc.string
    if release then {
        a.append from: "-O2".string
    } else {
        a.append from: "-O0".string
        a.append from: "-g".string
    }
    a.append from: "-std=c17".string
    # tcc's runtime payload -- libtcc1.a and its own headers -- is fixed at
    # CONFIGURE time, so a tree that moved has to say where it went: without
    # -B, tcc cannot resolve stddef.h and rejects every program. Empty for
    # every other compiler, and the caller decides that.
    if tccDir.length > 0 then {
        a.append from: "-B".string
        a.append from: tccDir.string
    }
    with cf: (cflags.split sep: " ") do for piece: cf loop {
        if piece.length > 0 then {
            a.append from: piece.string
        }
    }
    a.append from: "-o".string
    a.append from: exe.string
    a.append from: tempC.string
    with lit9c: libs.iterate do for lb9c: lit9c loop {
        la9c: "-l".string
        la9c.append lb9c
        a.append from: la9c
    }
    a.append from: "-lm".string
    with lf: (ldflags.split sep: " ") do for piece2: lf loop {
        if piece2.length > 0 then {
            a.append from: piece2.string
        }
    }
    rc: os.spawn argv: a cwd: "" outPath: "" errPath: "" timeoutSecs: 0
    return rc
}

# runZlShim -- trigger the standalone zl linter/formatter. `zc lint`/`zc fmt` are
# thin shims: locate the `zl` binary alongside this executable in bin/, forward the
# remaining arguments, inherit stdio (empty out/err paths) so its output reaches the
# terminal, and propagate its exit code.
runZlShim: function {verb: StringView argv: (List String).borrow} out i32 is {
    ep: os.exePath
    zlpath: String
    match (
        ep
    ) case ok then {
        d: zcheck.dirname p: ep.stringview
        zlpath = zcheck.joinPath a: d.stringview b: "zl"
    } case err then {
        em: "zc \{verb}: cannot locate the zl binary (executable path unavailable)"
        io.eprintln em
        return 2
    }
    args: (List String)
    args.append from: zlpath.copy
    args.append from: verb.string
    i: 2.u64
    n: argv.length
    for i < n loop {
        a: (argv.get :i).copy
        args.append from: a
        i = i + 1
    }
    rc: os.spawn argv: args cwd: "" outPath: "" errPath: "" timeoutSecs: 0
    return rc
}

# writeOut -- write content to a file path, or stdout when the path is "-".
writeOut: function {target: StringView content: StringView what: StringView} is {
    if target == "-" then {
        print content
    } else {
        wr: io.writeText path: target :content
        match (
            wr
        ) case ok then null case err then {
            em: "zc: could not write \{what}"
            io.eprintln em
            os.exit code: 1
        }
    }
}

# removeTemp -- best-effort delete of a temporary build artifact.
removeTemp: function {path: StringView} is {
    rr: io.remove :path
    match (
        rr
    ) case ok then null case err then null
}

# parseECode -- the numeric code in an "E0200"/"0200"/"200" string (0 if none).
parseECode: function {s: StringView} out u32 is {
    r: u32
    i: u64
    n: s.length
    for i < n loop {
        bo: s.byteAt :i
        match (
            bo
        ) case some then {
            if bo >= 48 when bo <= 57 then {
                d: (bo - 48).u32
                r = r * 10
                r = r + d
            }
        } case none then null
        i = i + 1
    }
    return r
}

# runExplain -- print the explanation for an error code, or a category fallback.
runExplain: function {codeArg: StringView} is {
    code: parseECode s: codeArg
    if code == 0 then {
        m: "zc explain: not an error code: \{codeArg} (try e.g. zc explain E0200)"
        io.eprintln m
        os.exit code: 2
    }
    txt: zast.explainText :code
    if txt.length > 0 then {
        txt.append "\n"
        print txt
    } else {
        cat: "unknown category"
        if code < 100 then {
            cat = "parser / syntax error (E0001-E0099)"
        } else if code < 200 then {
            cat = "type resolution error (E0100-E0199)"
        } else if code < 300 then {
            cat = "ownership error (E0200-E0299)"
        } else if code < 400 then {
            cat = "call / argument error (E0300-E0399)"
        } else if code < 500 then {
            cat = "generic / monomorphization error (E0400-E0499)"
        } else if code < 600 then {
            cat = "emitter error (E0500-E0599)"
        } else if code < 700 then cat = "compile-time evaluation error (E0600-E0699)"
        m: "E\{code}: \{cat} -- no detailed explanation available\n"
        print m
    }
}

# CLI entry point: parse the arguments, run the requested subcommand
# (build / check / emit-c / explain), and exit with its status.
main: function is {
    argv: os.args
    n: argv.length
    if n < 2 then {
        printUsage
        os.exit code: 2
    }

    arg1: (argv.get i: 1).copy

    if arg1.stringview == "-h" then {
        printUsage
        os.exit code: 0
    }
    if arg1.stringview == "--help" then {
        printUsage
        os.exit code: 0
    }
    if arg1.stringview == "-V" then {
        printVersion
        os.exit code: 0
    }
    if arg1.stringview == "--version" then {
        printVersion
        os.exit code: 0
    }
    if arg1.stringview == "version" then {
        printVersion
        os.exit code: 0
    }
    if arg1.stringview == "help" then {
        if n > 2 then {
            hc: argv.get i: 2
            printCommandHelp cmd: hc.stringview
        } else {
            printUsage
        }
        os.exit code: 0
    }
    if arg1.stringview == "explain" then {
        if n > 2 then {
            ec: argv.get i: 2
            runExplain codeArg: ec.stringview
        } else {
            io.eprintln "zc explain: missing error code (e.g. zc explain E0200)"
            os.exit code: 2
        }
        os.exit code: 0
    }
    if arg1.stringview == "natives" then {
        nrows: zemitterc.nativeConvRows
        print nrows
        os.exit code: 0
    }
    if arg1.stringview == "fmt" then {
        rc: runZlShim verb: "fmt" :argv
        os.exit code: rc
    }
    if arg1.stringview == "lint" then {
        rc: runZlShim verb: "lint" :argv
        os.exit code: rc
    }

    sub: String
    unitname: String
    if (isPipelineVerb name: arg1.stringview) then {
        sub = arg1.copy
    } else {
        unitname = arg1.copy
    }

    srcdir: ".".string
    srcSet: false
    systemFlag: String
    runtimeFlag: String
    emitTarget: String
    dumpSqlTarget: String
    outPath: String
    canon: false
    release: false
    saveTemps: false
    timed: false
    fastHash: false
    readableNames: false
    eagerCheck: false
    ccFlag: String
    ccModeFlag: String
    tccLibFlag: String
    targetTriple: String
    cflags: String
    ldflags: String
    progArgs: (List String)
    inProgArgs: false
    isRun: sub.stringview == "run"

    i: 2.u64
    for i < n loop {
        a: argv.get :i
        if inProgArgs then {
            progArgs.append from: a.copy
        } else if a.stringview == "--" then {
            inProgArgs = true
        } else if a.stringview == "-h" then {
            printCommandHelp cmd: sub.stringview
            os.exit code: 0
        } else if a.stringview == "--help" then {
            printCommandHelp cmd: sub.stringview
            os.exit code: 0
        } else if a.stringview == "-V" then {
            printVersion
            os.exit code: 0
        } else if a.stringview == "--version" then {
            printVersion
            os.exit code: 0
        } else if a.stringview == "--src" then {
            i = i + 1
            srcdir = (argv.get :i).copy
            srcSet = true
        } else if a.stringview == "--system" then {
            i = i + 1
            systemFlag = (argv.get :i).copy
        } else if a.stringview == "--runtime" then {
            i = i + 1
            runtimeFlag = (argv.get :i).copy
        } else if a.stringview == "--emit-c" then {
            i = i + 1
            emitTarget = (argv.get :i).copy
        } else if a.stringview == "--dump-sql" then {
            i = i + 1
            dumpSqlTarget = (argv.get :i).copy
        } else if a.stringview == "-o" then {
            i = i + 1
            outPath = (argv.get :i).copy
        } else if a.stringview == "--cc" then {
            i = i + 1
            ccFlag = (argv.get :i).copy
        } else if a.stringview == "--cc-mode" then {
            i = i + 1
            ccModeFlag = (argv.get :i).copy
            # the one value-taking flag here that validates. It has to: an
            # unrecognised mode would otherwise resolve to `spawn` and the
            # build would silently do something other than what was asked,
            # which is the same failure `--cc-mode` exists to rule out.
            mv: ccModeFlag.stringview
            known: false
            if mv == "spawn" then known = true
            if mv == "inproc" then known = true
            if known == false then {
                mm: "zc: --cc-mode must be 'spawn' or 'inproc', not '\{mv}'"
                io.eprintln mm
                os.exit code: 2
            }
        } else if a.stringview == "--tcc-lib" then {
            i = i + 1
            tccLibFlag = (argv.get :i).copy
        } else if a.stringview == "--target" then {
            i = i + 1
            targetTriple = (argv.get :i).copy
        } else if a.stringview == "--cflags" then {
            i = i + 1
            cflags = (argv.get :i).copy
        } else if a.stringview == "--ldflags" then {
            i = i + 1
            ldflags = (argv.get :i).copy
        } else if a.stringview == "--canon" then {
            canon = true
        } else if a.stringview == "--release" then {
            release = true
        } else if a.stringview == "--save-temps" then {
            saveTemps = true
        } else if a.stringview == "--time" then {
            timed = true
        } else if a.stringview == "--fast-hash" then {
            fastHash = true
        } else if a.stringview == "--readable-names" then {
            readableNames = true
        } else if a.stringview == "--eager" then {
            eagerCheck = true
        } else if unitname.length == 0 then {
            unitname = a.copy
        } else if isRun then {
            progArgs.append from: a.copy
            inProgArgs = true
        }
        i = i + 1
    }

    if sub.stringview == "env" then {
        (printEnv
            systemFlag: systemFlag.stringview
            runtimeFlag: runtimeFlag.stringview
            ccFlag: ccFlag.stringview
            ccModeFlag: ccModeFlag.stringview
            targetTriple: targetTriple.stringview
            tccLibFlag: tccLibFlag.stringview
        )
        os.exit code: 0
    }

    isEmit: sub.stringview == "emit"
    isDumpSql: false
    isDumpCanon: false
    if sub.stringview == "dump" then {
        if canon then {
            isDumpCanon = true
        } else {
            isDumpSql = true
        }
    } else if sub.length == 0 then {
        if emitTarget.length > 0 then {
            isEmit = true
        } else if dumpSqlTarget.length > 0 then {
            isDumpSql = true
        } else {
            um: "zc: unknown command '\{unitname.stringview}'"
            io.eprintln um
            printUsage
            os.exit code: 2
        }
    }

    if unitname.length == 0 then {
        io.eprintln "zc: no unit specified"
        os.exit code: 2
    }

    if srcSet == false then {
        isPath: false
        if (unitname.stringview.endsWith suffix: ".z") then isPath = true
        if (unitname.stringview.contains needle: "/") then isPath = true
        if isPath then {
            baseNoExt: stripDotZ p: unitname.stringview
            d: zcheck.dirname p: baseNoExt.stringview
            bn: baseName p: baseNoExt.stringview
            srcdir = d
            unitname = bn
        }
    }

    systemdir: zcheck.resolveSystemDir flagVal: systemFlag.stringview
    runtimeDir: zcheck.resolveRuntimeDir flagVal: runtimeFlag.stringview
    # resolved BEFORE the parse: the `platform` unit's constants are folded
    # during type checking, so the answer has to exist by then. The build
    # branch below reuses this rather than resolving a second time.
    ccPath: zcheck.pickCc ccFlag: ccFlag.stringview targetTriple: targetTriple.stringview
    # resolved here for the same reason: the payload directory belongs to the
    # compiler choice, and the build branch below reuses this rather than
    # resolving a second time.
    tccDir: zcheck.resolveTccDir flagVal: tccLibFlag.stringview
    ccMode: zcheck.pickCcMode modeFlag: ccModeFlag.stringview


    tParse0: os.monotonicMillis
    vfs: (zvfs.ZVfs
        providers: (List zvfs.ProviderBox)
        providerRoot: (IdMapR u32 value: String)
        entrytable: (zvfs.DentryTable entries: (ListVal zvfs.dentry))
        file_names: (List String)
        walk_cache: (MapRV String value: zvfs.fsno)
        rootid: zvfs.fsno
    )
    vfs.registerNull
    systemid: vfs.registerFS rootpath: systemdir.copy parentpath: "".string
    srcid: vfs.registerFS rootpath: srcdir.copy parentpath: "".string
    vfs.bindRoot newid: systemid kind: zvfs.bindkind.instead
    rootid: vfs.bindRoot newid: srcid kind: zvfs.bindkind.before

    p: zparser.Parser.create
    prog: p.parse :vfs :rootid mainUnitName: unitname
    tParse1: os.monotonicMillis
    mfn: "\{unitname.stringview}.z"
    mainFsno: vfs.walk parent: rootid name: mfn.stringview

    # a dump introspects the unit rather than building it, so it asks for no
    # entry point -- the one command that reads the model instead of emitting it
    reqMain: true
    if isDumpSql then reqMain = false
    if isDumpCanon then reqMain = false
    match (
        prog
    ) case error then {
        emsg: errorMessage e: prog :vfs ast: p.ast fallbackFsno: mainFsno
        io.eprintln emsg
        io.eprintln "1 error found"
        os.exit code: 1
    } else {
        reg: ztypes.newRegistry
        # the model dump reads the per-frame rows; a build or emit does not
        wantRows: false
        if isDumpSql then wantRows = true
        if isDumpCanon then wantRows = true
        st: (ztypecheck.typecheck
            program: prog
            :reg
            eager: eagerCheck
            requireMain: reqMain
            dumpRows: wantRows
            ccPath: ccPath.stringview
            ccMode: ccMode.stringview
            target: targetTriple.stringview
        )
        checkStart: os.monotonicMillis
        nerr: st.typing.errors.length
        if nerr > 0 then {
            match (
                prog
            ) case program then {
                with eit: st.typing.errors.iterate do for er: eit loop {
                    elx: errorMessage e: er :vfs ast: prog.ast fallbackFsno: mainFsno
                    io.eprintln elx
                }
            } else null
            if nerr == 1 then {
                io.eprintln "1 error found"
            } else {
                summ: "\{nerr} errors found"
                io.eprintln summ
            }
            os.exit code: 1
        }
        if isEmit then {
            emitErrs: (List String)
            emitLibs: ztypecheck.requiredLibs :st program: prog
            csrc: (zemitterc.emitC
                program: prog
                symtab: st
                runtimeDir: runtimeDir.stringview
                :fastHash
                :readableNames
                errs: emitErrs
                libs: emitLibs
            )
            failEmitErrors errs: emitErrs
            if timed then printPhases t0: tParse0 t1: tParse1 t2: checkStart t3: os.monotonicMillis
            tgt: emitTarget.copy
            if tgt.length == 0 then tgt = outPath.copy
            if tgt.length == 0 then tgt = "-".string
            writeOut target: tgt.stringview content: csrc.stringview what: "C output"
        } else if isDumpCanon then {
            canonOut: zsqldump.dumpCanon program: prog symtab: st
            tgt2: outPath.copy
            if tgt2.length == 0 then tgt2 = "-".string
            writeOut target: tgt2.stringview content: canonOut.stringview what: "canonical dump"
        } else if isDumpSql then {
            sql: zsqldump.dumpSql program: prog :vfs symtab: st
            tgt3: dumpSqlTarget.copy
            if tgt3.length == 0 then tgt3 = outPath.copy
            if tgt3.length == 0 then tgt3 = "-".string
            writeOut target: tgt3.stringview content: sql.stringview what: "SQL dump"
        } else {
            emitErrs2: (List String)
            emitLibs2: ztypecheck.requiredLibs :st program: prog
            csrc2: (zemitterc.emitC
                program: prog
                symtab: st
                runtimeDir: runtimeDir.stringview
                :fastHash
                :readableNames
                errs: emitErrs2
                libs: emitLibs2
            )
            failEmitErrors errs: emitErrs2
            if timed then printPhases t0: tParse0 t1: tParse1 t2: checkStart t3: os.monotonicMillis
            tmpc: tempPath uname: unitname.stringview ext: ".c"
            wrc: io.writeText path: tmpc content: csrc2
            match (
                wrc
            ) case ok then null case err then {
                io.eprintln "zc: could not write temporary C"
                os.exit code: 1
            }
            cc: ccPath.copy
            exe: String
            if isRun then {
                exe = tempPath uname: unitname.stringview ext: ".bin"
            } else {
                if outPath.length > 0 then {
                    exe = outPath.copy
                } else {
                    e2: "./".string
                    e2.append unitname
                    if (targetTriple.stringview.contains needle: "windows") then e2.append ".exe"
                    exe = e2
                }
            }
            # -B goes to tcc and to nothing else: another compiler would
            # reject it, and a tcc that is not the one this tree ships has a
            # payload of its own. `--tcc-lib` overrides when both are present.
            ccTcc: String
            cka: ztypecheck.ccKindArm ccPath: cc.stringview
            isTcc: cka.stringview == "tcc"
            if isTcc then {
                if (io.exists path: tccDir) then ccTcc = tccDir.copy
            }
            # `--cc-mode inproc` means libtcc, so it means tcc. Rejecting the
            # combination here rather than letting the mode quietly apply to a
            # gcc build follows the rule everywhere: the resolved mode is the
            # requested one, or it is an error.
            inproc: ccMode.stringview == "inproc"
            if inproc then {
                if (isTcc) == false then {
                    nm: "zc: --cc-mode inproc needs a tcc compiler; --cc resolved to '\{cc.stringview}'"
                    io.eprintln nm
                    os.exit code: 2
                }
                if ccTcc.length == 0 then {
                    nd: "zc: --cc-mode inproc found no tcc runtime payload at '\{tccDir.stringview}'; set --tcc-lib or ZEROLANG_TCC"
                    io.eprintln nd
                    os.exit code: 2
                }
            }
            rc: (buildExe
                cc: cc.stringview
                tempC: tmpc.stringview
                exe: exe.stringview
                :release
                cflags: cflags.stringview
                ldflags: ldflags.stringview
                libs: emitLibs2
                tccDir: ccTcc.stringview
                :inproc
            )
            if saveTemps then {
                kept: "zc: kept generated C at \{tmpc.stringview}"
                io.eprintln kept
            } else {
                removeTemp path: tmpc.stringview
            }
            if rc != 0 then {
                if rc == 127 then {
                    # 127 from either mode: os.spawn returns it when exec
                    # fails, tcc.compileToExe when libtcc will not load. One
                    # code, one report, with the path that was actually tried.
                    cmsg: "zc: could not run C compiler '\{cc.stringview}' (not found?); set --cc or install it"
                    if inproc then {
                        cmsg = "zc: could not load libtcc from '\{ccTcc.stringview}/libtcc.so'; set --tcc-lib, or drop --cc-mode inproc to run tcc as a child process"
                    }
                    io.eprintln cmsg
                }
                os.exit code: rc
            }
            if isRun then {
                sargs: (List String)
                sargs.append from: exe.copy
                with pit: progArgs.iterate do for pe: pit loop {
                    sargs.append from: pe.copy
                }
                prc: os.spawn argv: sargs cwd: "" outPath: "" errPath: "" timeoutSecs: 0
                removeTemp path: exe.stringview
                os.exit code: prc
            }
        }
    }
}
