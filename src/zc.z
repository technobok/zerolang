# zerolang compiler driver: the `zc` command-line interface.
#
# Parses a unit over a stdlib + source VFS, type-checks it, then builds
# it to a native executable (build), runs it (run), emits standalone C
# (emit), dumps the typecheck model (dump), or explains an error code
# (explain). A subcommand is required. See docs/zc.pdoc for the reference.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :main
}

astnode: zast.astnode

# errorFsno -- the file an error belongs to (ztypecheck.errorFileOf: its own
# stamp when it carries one, else the file of the node it names), else the main
# unit's. A typecheck error stamps fsno 0, which is why there are three answers
# and not one.
errorFsno: function {
    e: zast.ErrorData.view
    ast: zast.Ast.view
    fallbackFsno: zvfs.fsno
} out zvfs.fsno is {
    f: ztypecheck.errorFileOf :e :ast
    if f.notZero then return f
    return fallbackFsno
}

# errorSnippet -- the source line the error sits on behind a line-number
# gutter, and under it a caret run the width of the span it names. "" when the
# file holds no such line.
errorSnippet: function {e: zast.ErrorData.view vfs: zvfs.ZVfs fno: zvfs.fsno} out String is {
    buf: String
    lnOpt: vfs.getline dentryid: fno lineno: e.lineno - 1
    if lnOpt.some then {
        gut: zdiag.rpad4 n: e.lineno
        eg: zdiag.spacesOf n: 4
        co: e.colno
        if co > 0 then co = co - 1
        sp: zdiag.spacesOf n: co
        buf.append "\n"
        buf.append gut
        buf.append " | "
        buf.append lnOpt
        buf.append "\n"
        buf.append eg
        buf.append " | "
        buf.append sp
        cw: e.width
        if cw < 1 then cw = 1
        car: zdiag.caretsOf n: cw
        buf.append car
    }
    return buf
}

# errorMessage -- rustc-style render: code+message, location, source snippet +
# caret, then note/hint. The location names the file by its root joined with
# its path under that root, cleaned and native (ZVfs.displayPath). fallbackFsno (the main unit's file) covers errors that
# carry no file id of their own (typecheck errors stamp fsno 0).
errorMessage: function {
    e: zast.ErrorData.view
    vfs: zvfs.ZVfs
    ast: zast.Ast.view
    fallbackFsno: zvfs.fsno
} out String is {
    buf: zast.errorLine :e
    fno: errorFsno :e :ast :fallbackFsno
    if fno.notZero when e.lineno > 0 then {
        path: vfs.displayPath dentryid: fno
        loc: " --> \{path}:\{e.lineno}:\{e.colno}"
        buf.append "\n"
        buf.append loc
        buf.append (errorSnippet :e :vfs :fno)
    }
    if e.note.length > 0 then {
        ntl: "\n     = note: \{e.note}"
        buf.append ntl
    }
    if e.hint.length > 0 then {
        htl: "\n     = hint: \{e.hint}"
        buf.append htl
    }
    return buf
}

# failEmitErrors -- failures the emitter recorded: compile-time `error`
# calls proved reachable (E0601) and constructs it cannot emit (E0500). Report
# each as reportTypeErrors does and exit non-zero (no C is written or compiled).
failEmitErrors: function {
    errs: (List zast.ErrorData).view
    vfs: zvfs.ZVfs
    prog: zast.Ast.view
    mainFsno: zvfs.fsno
} is {
    n: errs.length
    if n == 0 then return
    for each e: errs loop {
        el: errorMessage :e :vfs ast: prog fallbackFsno: mainFsno
        io.eprintln el
    }
    if n == 1 then {
        io.eprintln "1 error found"
    } else {
        es: "\{n} errors found"
        io.eprintln es
    }
    os.exit code: 1
}

# printPhases -- the --time report: per-phase wall on the monotonic clock.
printPhases: function {t0: i64 t1: i64 t2: i64 t3: i64} is {
    io.eprintln "zc --time: parse=\{t1 - t0}ms typecheck=\{t2 - t1}ms emit=\{t3 - t2}ms total=\{t3 - t0}ms"
}

# zcWord -- every word zc classifies on its command line: the verbs, the
# print-and-stop flags that may stand in a verb's place, the `natives`
# subcommands, the two compiler modes and `-` for standard output. A word is
# classified by its slot here (zast.Vocab), never by comparing its text.
zcWord: list {
    vBuild: "build"
    vRun: "run"
    vEmit: "emit"
    vDump: "dump"
    vNatives: "natives"
    vExplain: "explain"
    vEnv: "env"
    vCobj: "cobj"
    vVersion: "version"
    vHelp: "help"
    vInit: "init"
    vFmt: "fmt"
    vLint: "lint"
    vFormat: "format"
    vData: "data"
    fH: "-h"
    fHelp: "--help"
    fV: "-V"
    fVersion: "--version"
    nShow: "show"
    nCheck: "check"
    nConversions: "conversions"
    nSource: "source"
    mSpawn: "spawn"
    mInproc: "inproc"
    stdoutPath: "-"
} out staticlist StringView

# isPipelineVerb -- the verbs that proceed to flag parsing: build/run/emit/dump
# compile a unit; env prints settings. version/help/explain and init are handled
# before this and exit early, so they are absent here.
isPipelineVerb: function {w: u64} out bool is {
    if w == zcWord.slot.vBuild then return true
    if w == zcWord.slot.vRun then return true
    if w == zcWord.slot.vEmit then return true
    if w == zcWord.slot.vCobj then return true
    return (w == zcWord.slot.vDump) or (w == zcWord.slot.vEnv)
}

# opt -- the name of each flag and option zc's commands take, as it is written
# on the command line. A command's spec declares its own, and the command reads
# them back by the same names.
opt: list {
    help: "--help"
    version: "--version"
    canon: "--canon"
    release: "--release"
    saveTemps: "--save-temps"
    timed: "--time"
    fastHash: "--fast-hash"
    readableNames: "--readable-names"
    nativecFiles: "--nativec-files"
    markNatives: "--mark-natives"
    lineMarks: "--line-marks"
    eager: "--eager"
    src: "--src"
    system: "--system"
    emitC: "--emit-c"
    dumpSql: "--dump-sql"
    output: "-o"
    cc: "--cc"
    ccMode: "--cc-mode"
    tccLib: "--tcc-lib"
    target: "--target"
    cflags: "--cflags"
    ldflags: "--ldflags"
    onlyC: "--c"
    emitter: "--emitter"
    register: "--register"
    link: "--link"
} out staticlist StringView

# operand -- the name of each operand a command takes, as its usage line and a
# refusal write it
operand: list {
    src: "src"
    cFile: "file.c"
    dataFile: "file.zd"
    code: "code"
    dir: "dir"
    what: "WHAT"
    check: "CHECK"
    unitDir: "UNITDIR"
    file: "FILE"
} out staticlist StringView

# wrongUsage -- the exit code of a command line zc does not accept
wrongUsage: 2

# newSpec -- a spec for the command a refusal names as `prog`, holding the two
# flags every command answers wherever they stand: -h / --help and
# -V / --version. It has no help text: zc's usage is written by hand.
newSpec: function {prog: StringView} out cli.Spec is {
    sp: cli.Spec.create programName: prog.string summary: "".string
    cli.addFlag spec: sp name: opt.help.string shortName: "-h".string help: "".string
    cli.addFlag spec: sp name: opt.version.string shortName: "-V".string help: "".string
    return sp
}

# addSwitch -- declares a flag on `sp`
addSwitch: function {sp: cli.Spec.borrow name: StringView} is {
    cli.addFlag spec: sp name: name.string shortName: "".string help: "".string
}

# addValue -- declares an option on `sp` that a command line may leave out
addValue: function {sp: cli.Spec.borrow name: StringView repeats: bool} is {
    (
        cli.addOption
        spec: sp
        name: name.string
        shortName: "".string
        help: "".string
        required: false
        :repeats
    )
}

# addOperand -- declares an operand on `sp`. cli never requires it: a command
# asks for its own (missing), after -h and -V have had their answer.
addOperand: function {sp: cli.Spec.borrow name: StringView} is {
    cli.addPositional spec: sp name: name.string help: "".string required: false
}

# addToolchain -- declares on `sp` what picks the standard library, the C
# toolchain and the target: every command that reads the project does
addToolchain: function {sp: cli.Spec.borrow} is {
    addValue :sp name: opt.system repeats: false
    addValue :sp name: opt.cc repeats: false
    addValue :sp name: opt.ccMode repeats: false
    addValue :sp name: opt.tccLib repeats: false
    addValue :sp name: opt.target repeats: false
}

# compileSpec -- what every command that compiles a unit takes: the unit, its
# roots, the toolchain, -o, and the settings the generated `z` unit records
# for the build, which a program may read whatever the command writes
compileSpec: function out cli.Spec is {
    sp: newSpec prog: "zc"
    addToolchain :sp
    addValue :sp name: opt.src repeats: true
    addValue :sp name: opt.cflags repeats: false
    addValue :sp name: opt.ldflags repeats: false
    # -o has no long form: its name and its short alias are the same word
    (
        cli.addOption
        spec: sp
        name: opt.output.string
        shortName: opt.output.string
        help: "".string
        required: false
    )
    addSwitch :sp name: opt.release
    addSwitch :sp name: opt.fastHash
    addSwitch :sp name: opt.readableNames
    addSwitch :sp name: opt.eager
    addOperand :sp name: operand.src
    return sp
}

# addEmitSwitches -- declares on `sp` what only a command that writes C reads
addEmitSwitches: function {sp: cli.Spec.borrow} is {
    addSwitch :sp name: opt.timed
    addSwitch :sp name: opt.nativecFiles
    addSwitch :sp name: opt.markNatives
    addSwitch :sp name: opt.lineMarks
}

# buildSpec -- what `zc build` and `zc run` take: compileSpec's members, the
# switches of a command that writes C, and --save-temps for the C a build
# removes. What follows `--` is not read: `run` hands it to the program.
buildSpec: function out cli.Spec is {
    sp: compileSpec
    addEmitSwitches :sp
    addSwitch :sp name: opt.saveTemps
    return sp
}

# emitSpec -- what `zc emit` takes: compileSpec's members and the switches of
# a command that writes C. --emit-c names the file, as -o does.
emitSpec: function out cli.Spec is {
    sp: compileSpec
    addEmitSwitches :sp
    addValue :sp name: opt.emitC repeats: false
    return sp
}

# dumpSpec -- what `zc dump` takes: compileSpec's members and --canon, which
# asks for the id-normalized model. --dump-sql names the file, as -o does.
dumpSpec: function out cli.Spec is {
    sp: compileSpec
    addSwitch :sp name: opt.canon
    addValue :sp name: opt.dumpSql repeats: false
    return sp
}

# bareSpec -- the command line with no command: a unit, and --emit-c or
# --dump-sql to say what to write
bareSpec: function out cli.Spec is {
    sp: compileSpec
    addEmitSwitches :sp
    addValue :sp name: opt.emitC repeats: false
    addValue :sp name: opt.dumpSql repeats: false
    return sp
}

# envSpec -- the command line of `zc env`: only what its report resolves
envSpec: function out cli.Spec is {
    sp: newSpec prog: "zc"
    addToolchain :sp
    return sp
}

# cobjSpec -- the command line of `zc cobj`: the emitted file and the compiler
# that will link it
cobjSpec: function out cli.Spec is {
    sp: newSpec prog: "zc"
    addToolchain :sp
    addValue :sp name: opt.cflags repeats: false
    addSwitch :sp name: opt.link
    addOperand :sp name: operand.cFile
    return sp
}

# commandSpec -- the spec of the command whose slot in zcWord is `subW`; the
# one with no command for any other slot
commandSpec: function {subW: u64} out cli.Spec is {
    if subW == zcWord.slot.vBuild then return buildSpec
    if subW == zcWord.slot.vRun then return buildSpec
    if subW == zcWord.slot.vEmit then return emitSpec
    if subW == zcWord.slot.vDump then return dumpSpec
    if subW == zcWord.slot.vEnv then return envSpec
    if subW == zcWord.slot.vCobj then return cobjSpec
    return bareSpec
}

# refused -- says why `spec` refuses the command line, in cli's sentence for
# `e`, and where the options are listed when it names one zc does not know;
# answers wrongUsage
refused: function {spec: cli.Spec.view e: cli.CliError.view} out i32 is {
    why: cli.errorText :spec :e
    if e.unknownFlag then why.append "; `zc help` lists the options"
    io.eprintln why
    return wrongUsage
}

# missing -- refuses a command line that leaves out the operand `name`, in
# cli's sentence; answers wrongUsage
missing: function {spec: cli.Spec.view name: StringView} out i32 is {
    return (refused :spec e: cli.CliError.missingRequired name.string)
}

# surplusRefused -- says that `p` holds an operand its command does not take;
# false when it holds none
surplusRefused: function {spec: cli.Spec.view p: cli.Parsed.view} out bool is {
    if p.extraArgs.length == 0 then return false
    io.eprintln "\{spec.programName}: unexpected argument '\{p.extraArgs.get i: 0}'"
    return true
}

# textOf -- the value `v` holds, empty when it holds none: an option or an
# operand that was not written
textOf: function {v: (Option String).view} out String is {
    match (
        v
    ) case some then {
        return v.copy
    } case none then {
        return "".string
    }
}

# answerInline -- -h / --help and -V / --version written after a command: the
# help of the command `sub` names (the general usage when it names none), or
# the version, and stop
answerInline: function {p: cli.Parsed.view zv: zast.Vocab.view sub: StringView} is {
    if (p.hasFlag name: opt.help) then {
        if sub.length > 0 then printCommandHelp :zv cmd: sub else printUsage
        os.exit code: 0
    }
    if (p.hasFlag name: opt.version) then {
        printVersion
        os.exit code: 0
    }
}

# printUsage -- the general help text (stderr): command groups, then flags.
printUsage: function is {
    io.eprintln "usage: zc <command> [arguments] [flags]"
    io.eprintln ""
    io.eprintln "build commands:"
    io.eprintln "  build <src>          compile <src> to a native executable"
    io.eprintln "  run   <src> [-- args]"
    io.eprintln "                       build, then run it; args go to the program as written"
    io.eprintln "  emit  <src>          emit standalone C (-o FILE, else stdout)"
    io.eprintln ""
    io.eprintln "project:"
    io.eprintln "  init [dir]           make dir (default .) a project: project.zd, and main.z when"
    io.eprintln "                       it holds no unit"
    io.eprintln ""
    io.eprintln "diagnostics:"
    io.eprintln "  dump  <src>          dump the typecheck model as SQL (--canon: id-normalized)"
    io.eprintln "  natives show|check|conversions|source"
    io.eprintln "                       the C rows zc carries: show one, check them, print the"
    io.eprintln "                       numeric rule's rows, write the generated `nativec` unit"
    io.eprintln "  data <file.zd>       check a data file and print its values, defaults applied"
    io.eprintln "  explain <code>       explain an error code, e.g. zc explain E0200"
    io.eprintln ""
    io.eprintln "info:"
    io.eprintln "  env                  print resolved tool paths and settings"
    io.eprintln "  cobj <file.c>        build the C sources an emitted file's units need, print"
    io.eprintln "                       their cached objects (and, with --link, its libraries)"
    io.eprintln "  version              print the version"
    io.eprintln "  help [command]       print usage, or help for one command"
    io.eprintln ""
    io.eprintln "<src> is a unit name (hello) or a path (hello.z, ./sub/hello.z)."
    io.eprintln ""
    io.eprintln "common flags:"
    io.eprintln "  -o OUT  --src DIR  --release  --cc CC  --cc-mode MODE"
    io.eprintln "  --target TRIPLE"
    io.eprintln "  --cflags STR  --ldflags STR  --save-temps  --time  --fast-hash"
    io.eprintln "  --readable-names  --mark-natives  --line-marks  --eager"
    io.eprintln "  --system DIR  --tcc-lib DIR  -h/--help  -V/--version"
    io.eprintln "A command takes its own flags only (zc help <command>). A value is"
    io.eprintln "written `--name VALUE` or `--name=VALUE`."
}

# printCommandHelp -- detailed help for one command (stderr).
printCommandHelp: function {zv: zast.Vocab.view cmd: StringView} is {
    w: zv.slotOf text: cmd
    if w == zcWord.slot.vBuild then {
        io.eprintln "usage: zc build <src> [flags]"
        io.eprintln "Compile <src> to a native executable."
        io.eprintln "Output goes to -o OUT, else <unit> (<unit>.exe for windows targets) in the"
        io.eprintln "project's directory (project.zd's outputDir moves it), or outside a project in ."
        io.eprintln "Flags: --src DIR (may repeat) --system DIR --release"
        io.eprintln "       --cc CC --cc-mode spawn|inproc --tcc-lib DIR --target TRIPLE"
        io.eprintln "       --cflags STR --ldflags STR --save-temps --time"
        io.eprintln "       --fast-hash --readable-names --eager"
        io.eprintln "       --nativec-files --mark-natives --line-marks"
    } else if w == zcWord.slot.vRun then {
        io.eprintln "usage: zc run <src> [flags] [-- args]"
        io.eprintln "Build <src>, then run it. It takes the flags of build, before <src> or"
        io.eprintln "after it. Everything after `--` is passed to the program as written, a"
        io.eprintln "flag of its own among them; nothing before `--` is."
        io.eprintln "The program's own exit code is propagated."
    } else if w == zcWord.slot.vEmit then {
        io.eprintln "usage: zc emit <src> [flags]"
        io.eprintln "Emit standalone C17 to -o FILE (or stdout). The runtime is inlined,"
        io.eprintln "so the single .c needs no extra include paths."
        io.eprintln "--mark-natives writes a comment line before each piece of C a unit's"
        io.eprintln "nativec.zd rendered, naming the row and the file and line it is written"
        io.eprintln "at; without those lines the C is the same."
        io.eprintln "--line-marks writes `#line` directives naming the source file and line"
        io.eprintln "each statement's and each function's C came from, so a tool that reads C"
        io.eprintln "positions (a coverage counter, a debugger) reports zerolang ones; without"
        io.eprintln "those lines the C is the same."
        io.eprintln "It takes the flags of build, without --save-temps."
    } else if w == zcWord.slot.vDump then {
        io.eprintln "usage: zc dump <src> [--canon] [flags]"
        io.eprintln "Dump the typecheck model as SQL to -o FILE (or stdout)."
        io.eprintln "--canon emits the id-normalized model instead."
        io.eprintln "Flags: --src DIR (may repeat) --system DIR --release --eager"
        io.eprintln "       --cc CC --cc-mode spawn|inproc --tcc-lib DIR --target TRIPLE"
        io.eprintln "       --cflags STR --ldflags STR --fast-hash --readable-names"
    } else if w == zcWord.slot.vNatives then {
        io.eprintln "usage: zc natives show WHAT [--c] [--system DIR]"
        io.eprintln "       zc natives check rows [UNITDIR] [--system DIR]"
        io.eprintln "       zc natives check needs --emitter FILE [--system DIR]"
        io.eprintln "       zc natives check views --emitter FILE --register FILE [--system DIR]"
        io.eprintln "       zc natives conversions"
        io.eprintln "       zc natives source FILE [--system DIR]"
        io.eprintln "show WHAT prints what zc carries for WHAT -- a unit's rows, one row"
        io.eprintln "(unit.key, every variant of it; group.key for a row of a foundation group,"
        io.eprintln "the key alone for a structural row) with its fields and C, a template, or a"
        io.eprintln "fixed file (hash; one piece of it, hash.mul128) -- and the line of the"
        io.eprintln "nativec.zd each was written at, the line `zc emit --mark-natives` names."
        io.eprintln "--c prints only the C, holes as written: for a C file or a test to include."
        io.eprintln "check rows checks the rows zc carries against the standard library's"
        io.eprintln "declarations: every native function has a row, every hole names a declared"
        io.eprintln "type, arm or member, a value row's body calls nothing, every native operator"
        io.eprintln "has a row, and each numeric conversion is declared and has the rule's row"
        io.eprintln "(make native-guard). With UNITDIR, a unit's folder holding its nativec.zd"
        io.eprintln "beside the unit's own file, it checks that unit's rows the same way: every"
        io.eprintln "native function of the unit has a row, every row's key names a declaration"
        io.eprintln "of the unit, every hole names a known type, arm or member."
        io.eprintln "check needs checks that every text calling what a piece defines needs it, the"
        io.eprintln "emitter's source (--emitter FILE: the emitter unit's file; its subunit files"
        io.eprintln "are read with it) among them (the runner's piece kind). check views"
        io.eprintln "checks that a native receiver marked .view is const in the C taking it, and a"
        io.eprintln "const one is marked; the data file --register FILE places each receiver no C"
        io.eprintln "function the check reads takes (make view-guard)."
        io.eprintln "conversions prints the conversion rows the numeric rule gives, as system's"
        io.eprintln "nativec.zd writes them; check rows requires the rows zc carries to be these."
        io.eprintln "source FILE writes into FILE the generated unit `nativec` that every build"
        io.eprintln "serves beside z.z: the standard library's nativec files as static data."
    } else if w == zcWord.slot.vData then {
        io.eprintln "usage: zc data <file.zd> [--src DIR]... [--system DIR]"
        io.eprintln "Check a data file (docs/zdata.pdoc) and print every value it defines, one"
        io.eprintln "definition a line, each data value with all its fields. Its units are found"
        io.eprintln "in the file's own directory, then each --src DIR, then the system directory."
    } else if w == zcWord.slot.vExplain then {
        io.eprintln "usage: zc explain <code>"
        io.eprintln "Explain a diagnostic error code, e.g. zc explain E0200."
    } else if w == zcWord.slot.vEnv then {
        io.eprintln "usage: zc env [--system DIR] [--cc CC] [--cc-mode MODE] [--tcc-lib DIR]"
        io.eprintln "              [--target TRIPLE]"
        io.eprintln "Print resolved tool paths and settings: the system and tcc dirs,"
        io.eprintln "the C compiler, the target triple, and the version."
    } else if w == zcWord.slot.vCobj then {
        io.eprintln "usage: zc cobj <file.c> [--cc CC] [--target TRIPLE] [--cc-mode MODE] [--tcc-lib DIR]"
        io.eprintln "               [--cflags STR] [--system DIR] [--link]"
        io.eprintln "Compile each C source the emitted file's `/* zcsrc: */` header names (a unit's"
        io.eprintln "vendored library) with the compiler that will link it, into the object cache,"
        io.eprintln "and print each object's path: link them after the .c file. Cached by source,"
        io.eprintln "compiler, target and defines; $ZC_OBJ_CACHE moves the cache. --link prints,"
        io.eprintln "after the objects, each library the header's `/* zlink: */` line declares, as"
        io.eprintln "the compiler names one (-lX, or X.lib for cl): the whole link of the file."
    } else if w == zcWord.slot.vInit then {
        io.eprintln "usage: zc init [dir]"
        io.eprintln "Make dir (default .) a project: write its project.zd, and a main.z when"
        io.eprintln "it holds no unit."
    } else if w == zcWord.slot.vVersion then {
        io.eprintln "usage: zc version"
        io.eprintln "Print the compiler version."
    } else if w == zcWord.slot.vHelp then {
        io.eprintln "usage: zc help [command]"
        io.eprintln "Print general usage, or detailed help for one command."
    } else {
        m: "zc help: unknown command '\{cmd}'"
        io.eprintln m
        printUsage
    }
}

# printVersion -- a version line (stdout).
printVersion: function is {
    v: zversion.versionLine tool: "zc"
    print "\{v}\n"
}

# substr -- the bytes of p in [start, end) as a new String.
substr: function {p: StringView start: u64 end: u64} out String is {
    r: String
    i: start
    for i < end loop {
        b: p.byteAt :i
        if b.some then {
            r.appendByte :b
        }
        i = i + 1
    }
    return r
}

# namesADirectory -- whether p has a directory part (`sub/hello`, and on
# Windows `sub\hello` or `C:hello`), rather than being a bare name
namesADirectory: function {p: StringView} out bool is {
    return (path.baseName :p).length != p.length
}

# stripDotZ -- p without a trailing ".z" extension, if present.
stripDotZ: function {p: StringView} out String is {
    if (p.endsWith suffix: ".z") then {
        e: p.length - 2
        return (substr :p start: 0 end: e)
    }
    return p.string
}

# printEnv -- resolved tool paths and settings as KEY=VALUE lines (stdout).
printEnv: function {
    project: StringView
    systemFlag: StringView
    ccFlag: StringView
    ccModeFlag: StringView
    targetTriple: StringView
    tccLibFlag: StringView
} is {
    sysd: zcheck.resolveSystemDir flagVal: systemFlag
    cc: zcheck.pickCc :ccFlag :targetTriple
    ccm: zcheck.pickCcMode modeFlag: ccModeFlag
    tccd: zcheck.resolveTccDir flagVal: tccLibFlag
    tccx: zcheck.vendoredTcc
    root: zcheck.exeRoot
    ver: zversion.semver
    commit: os.buildCommit
    bdate: os.buildDate
    bcc: os.buildCompiler
    exep: String
    ep: os.exePath
    match (
        ep
    ) case ok then {
        exep = ep.copy
    } case err then null
    buf: String
    buf.append "ZEROLANG_ROOT="
    buf.append root
    buf.append "\nZEROLANG_SYSTEM="
    buf.append sysd
    buf.append "\nZC_CC="
    buf.append cc
    buf.append "\nZC_CC_MODE="
    buf.append ccm
    buf.append "\nZC_TCC="
    buf.append tccx
    buf.append "\nZC_TCC_LIB="
    buf.append tccd
    buf.append "\nZC_TARGET="
    buf.append targetTriple
    buf.append "\nZEROLANG_VENDOR="
    buf.append zcheck.resolveVendorDir
    buf.append "\nZC_OBJ_CACHE="
    buf.append zcobj.objectCacheDir
    buf.append "\nZC_PROJECT="
    if project.length > 0 then buf.append (path.join a: project b: "project.zd")
    buf.append "\nZC_VERSION="
    buf.append ver
    buf.append "\nZC_COMMIT="
    buf.append commit
    buf.append "\nZC_BUILD_DATE="
    buf.append bdate
    buf.append "\nZC_BUILD_CC="
    buf.append bcc
    buf.append "\nZC_EXE="
    buf.append exep
    buf.append "\n"
    print buf
}

# tempPath -- zc-<pid>-<uname><ext> in the temporary directory (os.tempDir:
# $TMPDIR, else /tmp; Windows' own on Windows).
tempPath: function {uname: StringView ext: StringView} out String is {
    ps: "\{os.pid}"
    name: String
    name.append "zc-"
    name.append ps
    name.append "-"
    name.append uname
    name.append ext
    tmp: os.tempDir
    return (path.join a: tmp.stringView b: name.stringView)
}

# ccOnPath -- the file a bare compiler name (`cc`) resolves to through PATH,
# the way the spawn will resolve it: PATH's entries split on path.listSeparator,
# and on Windows a name with no extension tried as written, then with .exe and
# .com. A name with a directory in it is its own answer. "" when nothing on
# PATH is that name.
ccOnPath: function {name: StringView} out String is {
    if (namesADirectory p: name) then return name.string
    pe: os.env key: "PATH"
    if pe.none then return "".string
    exts: List String
    exts.append "".string
    if z.build.os == z.build.oskind.windows when (name.contains needle: ".").not then {
        exts.append ".exe".string
        exts.append ".com".string
    }
    for each d: (pe.stringView.split sep: path.listSeparator) loop {
        if d.length > 0 then {
            for each x: exts loop {
                file: "\{name}\{x}"
                cand: path.join a: d b: file.stringView
                if (io.exists path: cand) then return cand
            }
        }
    }
    return "".string
}

# ccRealPath -- the compiler the name actually runs: PATH-resolved, then read
# through its symlink chain (`cc` -> /etc/alternatives/cc -> gcc-15 on Debian).
# Links are READ, never run, so ccFamilyOf's reason for not probing --version
# holds here too; a wrapper script still classifies as `other`. A name that
# resolves to nothing, or a link deeper than eight hops, answers as written.
ccRealPath: function {name: StringView} out String is {
    cur: ccOnPath :name
    if cur.length == 0 then return name.string
    hops: u64
    for hops < 8 loop {
        hops = hops + 1
        rl: io.readlink path: cur
        if rl.err then return cur
        t: rl.take
        if (path.isAbsolute p: t.stringView) then {
            cur = t.take
        } else {
            # a relative target is relative to the LINK's directory
            dir: path.dirname p: cur.stringView
            cur = path.join a: dir.stringView b: t.stringView
        }
    }
    return cur
}

# runtimeLinkArgs -- how the C compiler's runtime is linked: off Windows,
# libm; for Windows, no libm (the C runtime holds the math functions) and, for
# gcc and clang, -static, so the .exe needs no libgcc or winpthreads DLL
# beside it. tcc's own runtime (libtcc1.a) is always linked in, and under
# -static tcc would take libraries only as archives, never through its .def
# import lists.
runtimeLinkArgs: function {windowsTarget: bool ccKind: zcc.ccfamily} out List String is {
    a: List String
    if windowsTarget.not then {
        a.append from: "-lm".string
    } else if ccKind.tcc.not then {
        a.append from: "-static".string
    }
    for each sa: (zcc.mainStackArgs f: ccKind windows: windowsTarget) loop a.append from: sa.copy
    return a
}

# buildExe -- turn the emitted C into an executable, by running the C
# compiler as a child process or by loading libtcc into this one. Debug is
# -O0 -g; --release is -O2. cflags/ldflags split on spaces. Empty out/err
# paths inherit the terminal so cc diagnostics print live.
#
# Both modes return the same i32 and write the same kind of artifact -- a
# file on disk -- so `zc run` spawns the result either way and exit codes,
# signals and the leak corpus see no difference. In-process buys the fast
# COMPILE and nothing else.
buildExe: function {
    cc: StringView
    # the compiler family `cc` belongs to (zcc.ccFamilyOf): what decides
    # which warning spellings it is handed
    ccKind: zcc.ccfamily
    tempC: StringView
    exe: StringView
    release: bool
    cflags: StringView
    ldflags: StringView
    libs: (List String).view
    # objects linked in after the C (the reached units' compiled C sources)
    objs: (List String).view
    tccDir: StringView
    inproc: bool
    # the build is for Windows, whose executables link the compiler's runtime
    # libraries (libgcc, winpthreads, libquadmath) statically, so an .exe runs
    # with no DLL beside it, and whose math is the C runtime's -- there is no
    # libm to name
    windowsTarget: bool
} out i32 is {
    if inproc then {
        # There is no ldflags parameter read here: libtcc links through the
        # same state that compiled, so there is no link step to pass them to.
        # The caller REFUSES a non-empty --ldflags under inproc rather than
        # dropping it, so this branch never has any to drop. libtcc reads its
        # options as its command line does, the main stack's among them.
        tcf: cflags.string
        for each sa: (zcc.mainStackArgs f: zcc.ccfamily.tcc windows: windowsTarget) loop {
            tcf.append " "
            tcf.append sa
        }
        return (
            tcc.compileToExe
            csrc: tempC
            :exe
            :tccDir
            :release
            cflags: tcf.stringView
            :libs
            :objs
        )
    }
    if ccKind.msvc then return (buildExeMsvc :cc :tempC :exe :release :cflags :ldflags :libs :objs)
    a: List String
    a.append from: cc.string
    if release then {
        a.append from: "-O2".string
    } else {
        a.append from: "-O0".string
        a.append from: "-g".string
    }
    a.append from: "-std=c17".string
    # a `.view` receiver or parameter is `const` in the C, so a write through
    # one is a discarded qualifier: the checker refuses it first, and this
    # makes the C compiler refuse it too, should the checker ever miss one.
    # gcc and clang spell the warning differently; tcc has no such warning and
    # would silently accept the flag, so it is not handed one.
    if ccKind.gcc then a.append from: "-Werror=discarded-qualifiers".string
    if ccKind.clang then {
        a.append from: "-Werror=incompatible-pointer-types-discards-qualifiers".string
    }
    # tcc's runtime payload -- libtcc1.a and its own headers -- is fixed at
    # CONFIGURE time, so a tree that moved has to say where it went: without
    # -B, tcc cannot resolve stddef.h and rejects every program. Empty for
    # every other compiler, and the caller decides that.
    if tccDir.length > 0 then {
        a.append from: "-B".string
        a.append from: tccDir.string
    }
    appendWords :a text: cflags
    a.append from: "-o".string
    a.append from: exe.string
    a.append from: tempC.string
    for each ob: objs loop a.append from: ob.copy
    for each lib: libs loop {
        linkFlags: "-l".string
        linkFlags.append lib
        a.append from: linkFlags
    }
    for each rl: (runtimeLinkArgs :windowsTarget :ccKind) loop a.append from: rl.copy
    appendWords :a text: ldflags
    rc: os.spawn argv: a cwd: "" outPath: "" errPath: "" timeoutSecs: 0
    return rc
}

# buildExeMsvc -- buildExe for MSVC's cl, in its own spellings (zcc): -O2 for a
# release and -Od with debug information (-Z7, a .pdb beside the .exe, no
# incremental-link file) otherwise; the C file's object written beside it
# rather than into the directory zc runs in; libraries as `<name>.lib`; the
# linker's own options after `-link`. cl's default C runtime is the static one,
# so the .exe needs no DLL beside it, as -static gives gcc's. cl names each C
# file it compiles on its output, which zc drops: the rest -- warnings and
# errors -- goes to stderr, where the other compilers write theirs.
buildExeMsvc: function {
    cc: StringView
    tempC: StringView
    exe: StringView
    release: bool
    cflags: StringView
    ldflags: StringView
    libs: (List String).view
    objs: (List String).view
} out i32 is {
    a: List String
    a.append from: cc.string
    for each mf: zcc.msvcFlags loop a.append from: mf.copy
    if release then {
        a.append from: "-O2".string
    } else {
        a.append from: "-Od".string
        a.append from: "-Z7".string
    }
    appendWords :a text: cflags
    a.append from: (zcc.msvcPath p: tempC)
    od: path.dirname p: tempC
    a.append from: "-Fo:\{zcc.msvcPath p: od.stringView}/"
    for each of: (zcc.outputArgs f: zcc.ccfamily.msvc :exe) loop a.append from: of.copy
    for each ob: objs loop a.append from: (zcc.msvcPath p: ob.stringView)
    for each lb: libs loop a.append from: (zcc.libraryArg f: zcc.ccfamily.msvc name: lb.stringView)
    lf: List String
    if release.not then lf.append from: "-INCREMENTAL:NO".string
    for each sa: (zcc.mainStackArgs f: zcc.ccfamily.msvc windows: true) loop lf.append from: sa.copy
    appendWords a: lf text: ldflags
    if lf.length > 0 then {
        a.append from: "-link".string
        for each l2: lf loop a.append from: l2.copy
    }
    outp: "\{tempC}.cl.txt"
    rc: zcc.spawnCompiler argv: a f: zcc.ccfamily.msvc src: tempC scratch: outp.stringView
    return rc
}

# appendWords -- the space-separated words of `text` (a --cflags or --ldflags
# value), each appended to `a` as an argument of its own.
appendWords: function {a: List String text: StringView} is {
    for each w: (text.split sep: " ") loop {
        if w.length > 0 then a.append from: w.string
    }
}

# runZlShim -- trigger the standalone zl linter/formatter. `zc lint`/`zc fmt` are
# thin shims: locate the `zl` binary alongside this executable in bin/, forward the
# remaining arguments, inherit stdio (empty out/err paths) so its output reaches the
# terminal, and propagate its exit code.
runZlShim: function {verb: StringView argv: (List String).borrow} out i32 is {
    ep: os.exePath
    zlpath: String
    match (
        ep
    ) case ok then {
        d: path.dirname p: ep.stringView
        zlpath = path.join a: d.stringView b: "zl"
    } case err then {
        em: "zc \{verb}: cannot locate the zl binary (executable path unavailable)"
        io.eprintln em
        return 2
    }
    args: List String
    args.append from: zlpath.copy
    args.append from: verb.string
    i: 2.u64
    n: argv.length
    for i < n loop {
        a: (argv.get :i).copy
        args.append from: a
        i = i + 1
    }
    rc: os.spawn argv: args cwd: "" outPath: "" errPath: "" timeoutSecs: 0
    return rc
}

# writeOut -- write content to a file path, or stdout when the path is "-".
writeOut: function {
    zv: zast.Vocab.view target: StringView content: StringView what: StringView
} is {
    if (zv.slotOf text: target) == zcWord.slot.stdoutPath then {
        print content
    } else {
        wr: io.writeText path: target :content
        match (
            wr
        ) case ok then null case err then {
            em: "zc: could not write \{what}"
            io.eprintln em
            os.exit code: 1
        }
    }
}

# removeTemp -- best-effort delete of a temporary build artifact.
removeTemp: function {path: StringView} is {
    rr: io.remove :path
    match (
        rr
    ) case ok then null case err then null
}

# parseECode -- the numeric code in an "E0200"/"e0200"/"0200"/"200" string; 0
# for any other spelling. Every byte after the optional E is a digit: skipping
# the others read `A001` -- a zl rule code -- as E0001.
parseECode: function {s: StringView} out u32 is {
    i: u64
    b0: (s.byteAt i: 0).or d: 0
    if (b0 == 0cE) or (b0 == 0ce) then i = 1
    if i == s.length then return 0
    return (digitsValue :s from: i)
}

# digitsValue -- the decimal value of `s` from byte `from` on; 0 unless every
# byte there is a digit.
digitsValue: function {s: StringView from: u64} out u32 is {
    r: u32
    i: from
    for i < s.length loop {
        bo: (s.byteAt :i).or d: 0
        if (bo < 0c0) or (bo > 0c9) then return 0
        r = r * 10 + (bo - 0c0)
        i = i + 1
    }
    return r
}

# isZlRuleCode -- `A001`, `L013`: an architecture rule's or a lint's code, which
# zl explains rather than zc.
isZlRuleCode: function {s: StringView} out bool is {
    b0: (s.byteAt i: 0).or d: 0
    if b0 != 0cA when b0 != 0cL then return false
    if s.length < 2 then return false
    return (digitsValue :s from: 1) > 0
}

# runExplain -- print the explanation for an error code, or a category fallback.
runExplain: function {codeArg: StringView} is {
    code: parseECode s: codeArg
    if code == 0 when (isZlRuleCode s: codeArg) then {
        io.eprintln "zc explain: \{codeArg} is a zl rule code -- run `zl explain \{codeArg}`"
        os.exit code: 2
    }
    if code == 0 then {
        m: "zc explain: not an error code: \{codeArg} (try e.g. zc explain E0200)"
        io.eprintln m
        os.exit code: 2
    }
    txt: zast.explainText :code
    if txt.length > 0 then {
        txt.append "\n"
        print txt
    } else {
        cat: "unknown category"
        if code < 100 then {
            cat = "parser / syntax error (E0001-E0099)"
        } else if code < 200 then {
            cat = "type resolution error (E0100-E0199)"
        } else if code < 300 then {
            cat = "ownership error (E0200-E0299)"
        } else if code < 400 then {
            cat = "call / argument error (E0300-E0399)"
        } else if code < 500 then {
            cat = "generic / monomorphization error (E0400-E0499)"
        } else if code < 600 then {
            cat = "emitter error (E0500-E0599)"
        } else if code < 700 then cat = "compile-time evaluation error (E0600-E0699)"
        m: "E\{code}: \{cat} -- no detailed explanation available\n"
        print m
    }
}

# dispatchHelpVerb -- the verbs that only print and stop: -h, --help,
# help [command], -V, --version and version. Anything else returns.
dispatchHelpVerb: function {argv: (List String).view n: u64 zv: zast.Vocab.view w: u64} is {
    if w == zcWord.slot.fH then {
        printUsage
        os.exit code: 0
    }
    if w == zcWord.slot.fHelp then {
        printUsage
        os.exit code: 0
    }
    if w == zcWord.slot.fV then {
        printVersion
        os.exit code: 0
    }
    if w == zcWord.slot.fVersion then {
        printVersion
        os.exit code: 0
    }
    if w == zcWord.slot.vVersion then {
        printVersion
        os.exit code: 0
    }
    if w != zcWord.slot.vHelp then return
    if n > 2 then {
        hc: argv.get i: 2
        printCommandHelp :zv cmd: hc.stringView
    } else {
        printUsage
    }
    os.exit code: 0
}

# dispatchToolVerb -- the verbs that do work of their own before any unit is
# named: `explain`, `init`, the natives table, `data`, and the three that shim
# through to zl. Anything else returns.
dispatchToolVerb: function {argv: (List String).borrow w: u64 zv: zast.Vocab.view} is {
    if w == zcWord.slot.vExplain then os.exit code: (explainCommand :zv)
    if w == zcWord.slot.vInit then os.exit code: (initCommand :zv)
    if w == zcWord.slot.vNatives then os.exit code: (nativesCommand :argv :zv)
    if w == zcWord.slot.vData then os.exit code: (dataCommand :zv)
    if w == zcWord.slot.vFmt then {
        rcf: runZlShim verb: "fmt" :argv
        os.exit code: rcf
    }
    if w == zcWord.slot.vLint then {
        rcl: runZlShim verb: "lint" :argv
        os.exit code: rcl
    }
    if w == zcWord.slot.vFormat then {
        rcm: runZlShim verb: "format" :argv
        os.exit code: rcm
    }
}

# explainCommand -- `zc explain <code>`; answers the exit code
explainCommand: function {zv: zast.Vocab.view} out i32 is {
    sp: newSpec prog: "zc explain"
    addOperand :sp name: operand.code
    pr: cli.parse spec: sp args: os.args first: 2
    match (
        pr
    ) case ok then {
        answerInline p: pr :zv sub: "explain"
        if (surplusRefused spec: sp p: pr) then return wrongUsage
        if (pr.given name: operand.code).not then return (missing spec: sp name: operand.code)
        code: textOf v: (pr.positional name: operand.code)
        runExplain codeArg: code.stringView
        return 0
    } case err then {
        return (refused spec: sp e: pr)
    }
}

# initCommand -- `zc init [dir]`: make `dir`, the working directory when none
# is named, a project; answers the exit code
initCommand: function {zv: zast.Vocab.view} out i32 is {
    sp: newSpec prog: "zc init"
    addOperand :sp name: operand.dir
    pr: cli.parse spec: sp args: os.args first: 2
    match (
        pr
    ) case ok then {
        answerInline p: pr :zv sub: "init"
        if (surplusRefused spec: sp p: pr) then return wrongUsage
        idir: ".".string
        if (pr.given name: operand.dir) then idir = textOf v: (pr.positional name: operand.dir)
        ir: zproject.initProject dir: idir.stringView
        if ir.ok.not then {
            io.eprintln ir.text
            return wrongUsage
        }
        print ir.text.stringView.trim
        return 0
    } case err then {
        return (refused spec: sp e: pr)
    }
}

# nativesOperand -- the name of the operand the `zc natives` subcommand `sub`
# (its slot in zcWord) needs: show's WHAT, check's CHECK, source's FILE; empty
# for `conversions`, which takes none
nativesOperand: function {sub: u64} out StringView is {
    if sub == zcWord.slot.nShow then return operand.what
    if sub == zcWord.slot.nCheck then return operand.check
    if sub == zcWord.slot.nSource then return operand.file
    return ""
}

# nativesSpec -- the command line of the `zc natives` subcommand `sub` (its
# slot in zcWord), after the subcommand's own word
nativesSpec: function {sub: u64} out cli.Spec is {
    sp: newSpec prog: "zc natives"
    if sub == zcWord.slot.nConversions then return sp
    addValue :sp name: opt.system repeats: false
    addOperand :sp name: (nativesOperand :sub)
    if sub == zcWord.slot.nShow then addSwitch :sp name: opt.onlyC
    if sub == zcWord.slot.nCheck then {
        addOperand :sp name: operand.unitDir
        addValue :sp name: opt.emitter repeats: false
        addValue :sp name: opt.register repeats: false
    }
    return sp
}

# nativesCommand -- `zc natives SUB ...`: `show WHAT`, what zc carries for
# WHAT; `check CHECK`, a check of the rows (of a user unit's with UNITDIR);
# `conversions`, the conversion rows the numeric rule gives; `source FILE`,
# the generated unit the nativec files under the system directory make. Bare,
# the usage. Answers the exit code.
nativesCommand: function {argv: (List String).view zv: zast.Vocab.view} out i32 is {
    if argv.length <= 2 then {
        printCommandHelp :zv cmd: "natives"
        return wrongUsage
    }
    sub: zv.slotOf text: (argv.get i: 2).stringView
    if (sub == zcWord.slot.fH) or (sub == zcWord.slot.fHelp) then {
        printCommandHelp :zv cmd: "natives"
        return 0
    }
    known: (
        (sub == zcWord.slot.nShow) or
        (sub == zcWord.slot.nCheck) or
        (sub == zcWord.slot.nConversions) or
        (sub == zcWord.slot.nSource)
    )
    if known.not then {
        io.eprintln "zc natives: unknown subcommand '\{(
            argv.get
            i: 2
        )}' (show, check, conversions, source)"
        return wrongUsage
    }
    sp: nativesSpec :sub
    pr: cli.parse spec: sp args: os.args first: 3
    match (
        pr
    ) case ok then {
        answerInline p: pr :zv sub: "natives"
        if (surplusRefused spec: sp p: pr) then return wrongUsage
        needs: nativesOperand :sub
        if needs.length > 0 when (pr.given name: needs).not then {
            return (missing spec: sp name: needs)
        }
        return (runNatives :sub p: pr what: (textOf v: (pr.positional name: needs)).stringView)
    } case err then {
        return (refused spec: sp e: pr)
    }
}

# runNatives -- the `zc natives` subcommand `sub` (its slot in zcWord) on its
# command line `p`; `what` is the operand it needs. Answers the exit code.
runNatives: function {sub: u64 p: cli.Parsed.view what: StringView} out i32 is {
    sysFlag: textOf v: (p.option name: opt.system)
    sysdir: zcheck.resolveSystemDir flagVal: sysFlag.stringView
    if sub == zcWord.slot.nCheck then return (
        znativecheck.checkNatives
        :what
        systemdir: sysdir.stringView
        emitter: (textOf v: (p.option name: opt.emitter)).stringView
        register: (textOf v: (p.option name: opt.register)).stringView
        unitdir: (textOf v: (p.positional name: operand.unitDir)).stringView
    )
    if sub == zcWord.slot.nShow then {
        t: (
            znativec.showNative
            :what
            systemdir: sysdir.stringView
            c: (p.hasFlag name: opt.onlyC)
        )
        if t.length == 0 then {
            io.eprintln "zc natives: '\{what}' names no unit, row (unit.key), template or file zc carries"
            return 1
        }
        print (t.stringView.substring from: 0 to: t.length - 1)
        return 0
    }
    if sub == zcWord.slot.nSource then return (
        writeServedSource
        file: what
        systemdir: sysdir.stringView
    )
    print znativecheck.nativeConvRows
    return 0
}

# writeServedSource -- `zc natives source FILE`: the generated `nativec`
# unit (znativec.servedText) written to `file`. Answers the exit code.
writeServedSource: function {file: StringView systemdir: StringView} out i32 is {
    st: znativec.servedText :systemdir
    if st.error.length > 0 then {
        io.eprintln "zc natives: \{st.error}"
        return 1
    }
    sw: io.writeText path: file content: st.text
    match (
        sw
    ) case err then {
        io.eprintln "zc natives: cannot write \{file}"
        return 1
    } case ok then return 0
}

# dataCommand -- `zc data <file.zd> [--src DIR]... [--system DIR]`: check the
# data file and print its values (zdata.dumpText), or its errors and the count.
# Answers the exit code.
dataCommand: function {zv: zast.Vocab.view} out i32 is {
    sp: newSpec prog: "zc data"
    addValue :sp name: opt.src repeats: true
    addValue :sp name: opt.system repeats: false
    addOperand :sp name: operand.dataFile
    pr: cli.parse spec: sp args: os.args first: 2
    match (
        pr
    ) case ok then {
        answerInline p: pr :zv sub: "data"
        if (surplusRefused spec: sp p: pr) then return wrongUsage
        if (pr.given name: operand.dataFile).not then {
            return (missing spec: sp name: operand.dataFile)
        }
        file: textOf v: (pr.positional name: operand.dataFile)
        sysFlag: textOf v: (pr.option name: opt.system)
        df: (
            zdata.open
            file: file.stringView
            srcdirs: (pr.optionAll name: opt.src)
            systemdir: (zcheck.resolveSystemDir flagVal: sysFlag.stringView).stringView
        )
        reportDataErrors :df
        # one line a definition, each ending its line; print ends the last
        t: zdata.dumpText f: df
        if t.length > 0 then print (t.stringView.substring from: 0 to: t.length - 1)
        return 0
    } case err then {
        return (refused spec: sp e: pr)
    }
}

# refuseUnknownCcMode -- the one value-taking flag that validates its VALUE and
# not merely that one was given. It has to: an unrecognised mode would
# otherwise resolve to `spawn` and the build would silently do something other
# than what was asked, which is the same failure `--cc-mode` exists to rule
# out.
refuseUnknownCcMode: function {zv: zast.Vocab.view mode: StringView named: StringView} is {
    w: zv.slotOf text: mode
    known: (w == zcWord.slot.mSpawn) or (w == zcWord.slot.mInproc)
    if known then return
    mm: "zc: \{named} must be 'spawn' or 'inproc', not '\{mode}'"
    io.eprintln mm
    os.exit code: 2
}

# outmode -- what a run produces, which the subcommand and the flags decide
# together.
outmode: variant {
    # build a native executable, and under `run` execute it
    build: null
    # standalone C
    emitc: null
    # the typecheck model as SQL
    dumpsql: null
    # the canonical model dump
    dumpcanon: null
}

# resolveOutMode -- what was asked for. A bare unit name with --emit-c or
# --dump-sql means that output; with neither it names no command at all.
resolveOutMode: function {
    sub: StringView
    # the subcommand's slot in zcWord
    subW: u64
    unitname: StringView
    canon: bool
    emitTarget: StringView
    dumpSqlTarget: StringView
} out outmode is {
    if subW == zcWord.slot.vEmit then return outmode.emitc
    if subW == zcWord.slot.vDump then {
        if canon then return outmode.dumpcanon
        return outmode.dumpsql
    }
    if sub.length > 0 then return outmode.build
    if emitTarget.length > 0 then return outmode.emitc
    if dumpSqlTarget.length > 0 then return outmode.dumpsql
    um: "zc: unknown command '\{unitname}'"
    io.eprintln um
    printUsage
    os.exit code: 2
    return outmode.build
}

# ZcFlags -- what zc's command line sets: the roots and files it names, the
# switches it turns on, and the C toolchain it picks.
ZcFlags: class {
    # the unit to compile, from the command line or from a path argument
    unitname: String
    # every --src, in the order given: they are all roots, and the first one
    # that answers a name wins
    srcdirs: List String
    # --system: where the stdlib lives, "" for the resolved default
    systemFlag: String
    # --emit-c: where the C goes, "" for -o or stdout
    emitTarget: String
    # --dump-sql: where the SQL dump goes, "" for -o or stdout
    dumpSqlTarget: String
    # -o: where any output goes when its own flag named none
    outPath: String
    # where a build writes its executable when -o names none: the project
    # directory, or project.zd's outputDir under it; "" (the working directory)
    # outside a project
    outputDir: String
    # --cc: the C compiler to drive, "" to resolve one from the target
    ccFlag: String
    # --cc-mode: "spawn" to run the compiler as a child, "inproc" for libtcc
    ccModeFlag: String
    # --tcc-lib: the tcc runtime payload directory, "" for the vendored one
    tccLibFlag: String
    # --target: the triple to build for, "" for the host
    targetTriple: String
    # --cflags: passed through to the C compile step
    cflags: String
    # --ldflags: passed through to the link step, which inproc does not have
    ldflags: String
    # --canon: `dump` writes the canonical model rather than SQL
    canon: bool
    # --release: build with optimisation
    release: bool
    # --save-temps: keep the generated C rather than removing it
    saveTemps: bool
    # --time: print the per-phase timings
    timed: bool
    # --fast-hash: the emitter's cheaper name hash
    fastHash: bool
    # --readable-names: emit source names rather than numbered ones
    readableNames: bool
    # --nativec-files: read the standard library's C rows from its nativec.zd
    # files, checked, rather than from the rows zc carries (the agreement
    # check, nativec-agree-guard)
    nativecFiles: bool
    # --mark-natives: write before each native text in the C where its row is
    # written; the rows are then read from their nativec.zd files, which
    # carry the places
    markNatives: bool
    # --line-marks: write `#line` directives naming the source line each
    # statement's and each function's C came from
    lineMarks: bool
    # --link: `zc cobj` prints the libraries the file declares after its objects
    link: bool
    # --eager: typecheck every definition, not only what main reaches
    eagerCheck: bool
    # under `run`, the arguments that belong to the program and not to zc:
    # everything after `--`
    progArgs: List String
} as {
    # read -- what the command line `p` set. A name the command's spec does not
    # declare was not written, so one reading serves every command. `named` is
    # the name of the operand that names the unit, or the file `cobj` reads.
    read: function {p: cli.Parsed.view named: StringView} out this is {
        progArgs: List String
        i: p.extraOperands
        for i < p.extraArgs.length loop {
            progArgs.append from: (p.extraArgs.get :i).copy
            i = i + 1
        }
        return (
            meta.create
            unitname: (textOf v: (p.positional name: named))
            srcdirs: (p.optionAll name: opt.src)
            systemFlag: (textOf v: (p.option name: opt.system))
            emitTarget: (textOf v: (p.option name: opt.emitC))
            dumpSqlTarget: (textOf v: (p.option name: opt.dumpSql))
            outPath: (textOf v: (p.option name: opt.output))
            outputDir: String
            ccFlag: (textOf v: (p.option name: opt.cc))
            ccModeFlag: (textOf v: (p.option name: opt.ccMode))
            tccLibFlag: (textOf v: (p.option name: opt.tccLib))
            targetTriple: (textOf v: (p.option name: opt.target))
            cflags: (textOf v: (p.option name: opt.cflags))
            ldflags: (textOf v: (p.option name: opt.ldflags))
            canon: (p.hasFlag name: opt.canon)
            release: (p.hasFlag name: opt.release)
            saveTemps: (p.hasFlag name: opt.saveTemps)
            timed: (p.hasFlag name: opt.timed)
            fastHash: (p.hasFlag name: opt.fastHash)
            readableNames: (p.hasFlag name: opt.readableNames)
            nativecFiles: (p.hasFlag name: opt.nativecFiles)
            markNatives: (p.hasFlag name: opt.markNatives)
            lineMarks: (p.hasFlag name: opt.lineMarks)
            link: (p.hasFlag name: opt.link)
            eagerCheck: (p.hasFlag name: opt.eager)
            :progArgs
        )
    }

    # refusesSurplus -- says that `p` holds an argument its command does not
    # take: one unit is all a command compiles. `passesRest` is true for
    # `run`, which hands what follows `--` to the program; a second operand
    # before `--` is refused there too. False when `p` holds none.
    refusesSurplus: function {t: this.view p: cli.Parsed.view passesRest: bool} out bool is {
        surplus: p.extraArgs.length
        if passesRest then surplus = p.extraOperands
        if surplus == 0 then return false
        tok: p.extraArgs.get i: 0
        said: "zc: unexpected argument '\{tok}'"
        if t.unitname.length > 0 then said.append ": the unit is already '\{t.unitname}'"
        if passesRest then said.append "; the program's arguments go after `--`"
        io.eprintln said
        return true
    }

    # unitIsPath -- the unit was named by its file (`hello.z`, `sub/hello`)
    # rather than by its name
    unitIsPath: function {t: this.view} out bool is {
        return (
            (t.unitname.stringView.endsWith suffix: ".z") or
            (namesADirectory p: t.unitname.stringView)
        )
    }

    # projectStart -- where the search for project.zd begins: the directory of
    # a unit named by its file, else the working directory
    projectStart: function {t: this.view} out String is {
        if t.unitIsPath.not then return ".".string
        return (path.dirname p: t.unitname.stringView)
    }

    # applyProject -- each setting no flag gave, from project.zd (its programs
    # are unitsToCompile's). A flag
    # replaces the file's value outright, and a unit named by its file is its
    # own source root; a switch the file turns on stays on. Paths the file gives
    # are relative to the project directory.
    applyProject: function {t: this zv: zast.Vocab.view pf: zproject.ProjectFile.view} is {
        if pf.found.not then return
        if t.srcdirs.length == 0 when t.unitIsPath.not then {
            for each sr: pf.sourceRoots loop t.srcdirs.append from: sr.copy
        }
        t.applyProjectPaths :pf
        t.applyProjectTools :zv :pf
        if pf.release then t.release = true
        if pf.fastHash then t.fastHash = true
        if pf.readableNames then t.readableNames = true
        if pf.eager then t.eagerCheck = true
    }

    # applyProjectPaths -- the directories project.zd gives, under the project
    # directory, where no flag gave one
    applyProjectPaths: function {t: this pf: zproject.ProjectFile.view} is {
        d: pf.dir.stringView
        sys: zproject.inProject dir: d rel: pf.systemDir.stringView
        if t.systemFlag.length == 0 then t.systemFlag = sys.take
        tl: zproject.inProject dir: d rel: pf.tccLibDir.stringView
        if t.tccLibFlag.length == 0 then t.tccLibFlag = tl.take
        # a project's executable goes to its own directory, wherever in it the
        # build started; outputDir moves it
        t.outputDir = d.string
        if pf.outputDir.length > 0 then t.outputDir = (
            zproject.inProject
            dir: d
            rel: pf.outputDir.stringView
        )
    }

    # applyProjectTools -- the target and the C toolchain project.zd names, where
    # no flag named them
    applyProjectTools: function {t: this zv: zast.Vocab.view pf: zproject.ProjectFile.view} is {
        if t.targetTriple.length == 0 then t.targetTriple = pf.target.copy
        if t.ccFlag.length == 0 then t.ccFlag = pf.cCompiler.copy
        if t.ccModeFlag.length == 0 when pf.cCompilerMode.length > 0 then {
            t.ccModeFlag = pf.cCompilerMode.copy
            (
                refuseUnknownCcMode
                :zv
                mode: t.ccModeFlag.stringView
                named: "project.zd's cCompilerMode"
            )
        }
        if t.cflags.length == 0 then t.cflags = pf.cFlags.copy
        if t.ldflags.length == 0 then t.ldflags = pf.linkFlags.copy
    }

    # buildFacts -- the values this build uses, after every flag, for the
    # generated z/build.z; the toolchain as resolved
    buildFacts: function {
        t: this.view
        systemdir: StringView
        cc: StringView
        ccMode: StringView
        tccDir: StringView
    } out zproject.BuildFacts is {
        f: zproject.BuildFacts.create srcdirs: t.srcdirs :systemdir main: t.unitname.stringView
        f.triple = t.targetTriple.copy
        f.outputDir = t.outputDir.copy
        f.release = t.release
        f.fastHash = t.fastHash
        f.readableNames = t.readableNames
        f.eager = t.eagerCheck
        f.cCompiler = cc.string
        f.cCompilerMode = ccMode.string
        f.cFlags = t.cflags.copy
        f.linkFlags = t.ldflags.copy
        f.tccLibDir = tccDir.string
        return f
    }

    # resolveRoots -- with no --src given, a unit named as a PATH supplies its
    # own root: the directory it sits in, with the bare stem as the unit name.
    # With no root either way, the current directory is one.
    resolveRoots: function {t: this} is {
        if t.srcdirs.length == 0 when t.unitIsPath then {
            baseNoExt: stripDotZ p: t.unitname.stringView
            d: path.dirname p: baseNoExt.stringView
            bn: path.baseName p: baseNoExt.stringView
            t.srcdirs.append from: d
            t.unitname = bn.take
        }
        if t.srcdirs.length == 0 then t.srcdirs.append from: ".".string
    }
}

# reportDataErrors -- a data file's parse error, or every error its check
# found, rendered as a program's are, and stop. Returns when the file checked.
reportDataErrors: function {df: zdata.DataFile} is {
    if df.check.parseOk.not then (
        reportParseError
        prog: df.check.prog
        vfs: df.check.vfs
        fallbackFsno: zvfs.fsno
    )
    o: df.check.st
    if o.some then {
        reportTypeErrors st: o prog: df.check.prog vfs: df.check.vfs mainFsno: zvfs.fsno
    }
}

# userImplementations -- the C implementation file of each unit the program
# loaded that carries one beside it (`<unit>/nativec.zd`), each checked as a
# data file is (zdata.open), the build stopping at one that does not check.
# The standard library's units are left out: zc carries their rows.
userImplementations: function {
    prog: zast.Ast.view
    vfs: zvfs.ZVfs
    rootid: zvfs.fsno
    srcdirs: (List String).view
    systemdir: StringView
    # the standard library's units too, whose rows zc otherwise carries
    withServed: bool
} out List zemitterc.UserImplementation is {
    r: List zemitterc.UserImplementation
    sawSystem: false
    for each u: prog.units loop {
        n: prog.nodes.getView i: u
        if n.namedoperation then {
            nm: (zast.poolTextAt pool: prog.names ref: n.name).stringView
            if withServed or (zemitterc.isServedUnit name: nm).not then {
                got: openUserImplementation :vfs :rootid :srcdirs :systemdir unitName: nm :r
                if got when n.name == zast.wellKnown.slot.unSystem then sawSystem = true
            }
        }
    }
    if withServed when sawSystem.not then {
        io.eprintln "zc: no system/nativec.zd under the system directory to read the C rows from"
        os.exit code: 2
    }
    return r
}

# openUserImplementation -- the unit's implementation file, checked, onto `r`
# when it has one (nativecFileOf); a file that does not check stops the build.
# Whether there was one.
openUserImplementation: function {
    vfs: zvfs.ZVfs
    rootid: zvfs.fsno
    srcdirs: (List String).view
    systemdir: StringView
    unitName: StringView
    r: List zemitterc.UserImplementation
} out bool is {
    p: nativecFileOf :vfs :rootid :unitName
    if p.length == 0 then return false
    df: zdata.open file: p.stringView :srcdirs :systemdir
    reportDataErrors :df
    r.append (zemitterc.UserImplementation name: unitName.string file: df.take)
    return true
}

# nativecFileOf -- the path of `<unit>/nativec.zd` beside the unit's own file,
# "" when the unit has none
nativecFileOf: function {vfs: zvfs.ZVfs rootid: zvfs.fsno unitName: StringView} out String is {
    ufn: "\{unitName}.z"
    fsid: vfs.walk parent: rootid name: ufn.stringView
    if fsid.isZero then return String
    dirid: vfs.siblingDir fileid: fsid name: unitName
    zid: vfs.walk parent: dirid name: "nativec.zd"
    k: vfs.arm dentryid: zid
    match (
        k
    ) case file then {
        return (vfs.displayPath dentryid: zid)
    } case dir then null case notfound then null
    return String
}

# reportParseError -- a failed parse hands the tree back with the error as its
# root row: render it and stop.
reportParseError: function {
    prog: zast.Ast.view
    vfs: zvfs.ZVfs
    fallbackFsno: zvfs.fsno
} is {
    progRoot: prog.nodes.getView i: prog.root
    match (
        progRoot
    ) case error then {
        emsg: (
            errorMessage
            e: (zast.errorDataOf ast: prog row: progRoot)
            :vfs
            ast: prog
            :fallbackFsno
        )
        io.eprintln emsg
    } else null
    io.eprintln "1 error found"
    os.exit code: 1
}

# reportTypeErrors -- render every type error and stop, the count last.
# Returns when the program typechecked.
reportTypeErrors: function {
    st: zenv.ZSymbolTable.view
    prog: zast.Ast.view
    vfs: zvfs.ZVfs
    mainFsno: zvfs.fsno
} is {
    nerr: st.typing.errors.length
    if nerr == 0 then return
    for each er: st.typing.errors loop {
        elx: errorMessage e: er :vfs ast: prog fallbackFsno: mainFsno
        io.eprintln elx
    }
    if nerr == 1 then {
        io.eprintln "1 error found"
    } else {
        summ: "\{nerr} errors found"
        io.eprintln summ
    }
    os.exit code: 1
}

# outTarget -- where an output goes: the flag that names it, else -o, else
# stdout.
outTarget: function {primary: StringView fallback: StringView} out String is {
    if primary.length > 0 then return primary.string
    if fallback.length > 0 then return fallback.string
    return "-".string
}

# cOutputPath -- the file the C is written to, as --line-marks names it: the
# output of a command that writes C ("zc.c" for the standard output), else the
# temporary a build compiles (buildAndRun)
cOutputPath: function {zv: zast.Vocab.view cf: ZcFlags.view emitc: bool} out String is {
    if emitc.not then return (tempPath uname: cf.unitname.stringView ext: ".c")
    tgt: outTarget primary: cf.emitTarget.stringView fallback: cf.outPath.stringView
    if (zv.slotOf text: tgt.stringView) == zcWord.slot.stdoutPath then return "zc.c".string
    return tgt
}

# chooseExePath -- where a build writes its executable: a temporary under
# `run`, `-o` when it names one, else `<unit>` with the target's suffix in the
# project's output directory, or outside a project in the working directory.
chooseExePath: function {
    isRun: bool
    outPath: StringView
    outputDir: StringView
    unitname: StringView
    targetTriple: StringView
} out String is {
    if isRun then return (tempPath uname: unitname ext: ".bin")
    if outPath.length > 0 then return outPath.string
    file: "\{unitname}\{ztarget.targetExeSuffix triple: targetTriple}"
    if outputDir.length > 0 then {
        io.mkdirp path: outputDir
        return (path.join a: outputDir b: file.stringView)
    }
    # in the working directory, spelled as a path (`./hello`, `.\hello.exe`)
    return ".\{path.separator}\{file}"
}

# refuseCrossTarget -- a cross target is only as real as the compiler resolved
# for it. `--cc` wins over the triple in pickCc, which is right for picking but
# meant nobody ever asked whether the two AGREE: --cc tcc --target
# x86_64-windows built a Linux ELF that printed `os=windows`. The
# evidence accepted is the compiler's own name -- a `<triple>-` prefixed
# driver, which is exactly what pickCc synthesises when no --cc is given, so
# the documented cross path passes unchanged. cl is the other way round: it
# builds for Windows and nothing else, wherever it runs (under wine on a POSIX
# host), so it needs a Windows target, the host's or a --target.
refuseCrossTarget: function {targetTriple: StringView cc: StringView fam: zcc.ccfamily} is {
    if fam.msvc then {
        if (ztarget.targetIsWindows triple: targetTriple) then return
        mc: "zc: '\{cc}' is MSVC's cl, which builds only for Windows"
        io.eprintln mc
        io.eprintln "  pass --target x86_64-pc-windows-msvc to build with it on another host (under wine)"
        os.exit code: 2
    }
    if (ztarget.targetIsHost triple: targetTriple) then return
    cb: path.baseName p: cc
    tp: targetTriple.string
    tp.append "-"
    if (cb.stringView.startsWith prefix: tp) then return
    if fam.tcc then {
        tt: "zc: --cc tcc cannot build for --target '\{targetTriple}'"
        io.eprintln tt
        io.eprintln "  the vendored tinycc is a host-only linux-x86_64 build: one backend, one config triple"
    } else {
        tc: "zc: '\{cc}' cannot build for --target '\{targetTriple}'"
        io.eprintln tc
        th: "  a cross build needs a compiler named '\{tp.stringView}gcc' or '\{tp.stringView}clang'"
        io.eprintln th
    }
    os.exit code: 2
}

# refuseInprocMisuse -- `--cc-mode inproc` means libtcc, so it means tcc.
# Rejecting the combination here rather than letting the mode quietly apply to
# a gcc build follows the rule everywhere: the resolved mode is the requested
# one, or it is an error.
refuseInprocMisuse: function {
    isTcc: bool
    cc: StringView
    ccTcc: StringView
    tccDir: StringView
    ldflags: StringView
} is {
    if isTcc.not then {
        nm: "zc: --cc-mode inproc needs a tcc compiler; --cc resolved to '\{cc}'"
        io.eprintln nm
        os.exit code: 2
    }
    if ccTcc.length == 0 then {
        nd: "zc: --cc-mode inproc found no tcc runtime payload at '\{tccDir}'; set --tcc-lib or ZEROLANG_TCC"
        io.eprintln nd
        os.exit code: 2
    }
    # --ldflags reaches a linker and inproc has none. Dropping them would make
    # the SAME command fail under spawn and succeed here; that divergence is
    # what this refusal stops.
    if ldflags.length > 0 then {
        nf: "zc: --ldflags '\{ldflags}' cannot be honoured under --cc-mode inproc"
        io.eprintln nf
        io.eprintln "  libtcc links through the state that compiled, so there is no link step to pass them to; use --cc-mode spawn"
        os.exit code: 2
    }
}

# reportBuildFailure -- 127 from either mode: os.spawn returns it when exec
# fails, tcc.compileToExe when libtcc will not load. One code, one report, with
# the path that was actually tried. Returns when the build succeeded.
reportBuildFailure: function {rc: i32 inproc: bool cc: StringView ccTcc: StringView} is {
    if rc == 0 then return
    if rc == 127 then {
        cmsg: "zc: could not run C compiler '\{cc}' (not found?); set --cc or install it"
        if inproc then {
            lf: zcheck.libtccFile
            lib: path.join a: ccTcc b: lf.stringView
            cmsg = "zc: could not load libtcc from '\{lib}'; set --tcc-lib, or drop --cc-mode inproc to run tcc as a child process"
        }
        io.eprintln cmsg
    }
    os.exit code: rc
}

# runBuiltProgram -- `zc run`: hand the program its own arguments, remove the
# executable, and exit with its status.
runBuiltProgram: function {exe: StringView progArgs: (List String).view} is {
    sargs: List String
    sargs.append from: exe.string
    for each pe: progArgs loop {
        sargs.append from: pe.copy
    }
    prc: os.spawn argv: sargs cwd: "" outPath: "" errPath: "" timeoutSecs: 0
    removeTemp path: exe
    os.exit code: prc
}

# buildAndRun -- the default output: write the C to a temporary, compile it
# with the resolved toolchain, and under `run` execute the result.
buildAndRun: function {
    cf: ZcFlags.view
    csrc: StringView
    libs: (List String).view
    cc: StringView
    ccMode: StringView
    tccDir: StringView
    isRun: bool
    zv: zast.Vocab.view
} is {
    tmpc: tempPath uname: cf.unitname.stringView ext: ".c"
    wrc: io.writeText path: tmpc content: csrc
    match (
        wrc
    ) case ok then null case err then {
        io.eprintln "zc: could not write temporary C"
        os.exit code: 1
    }
    exe: (
        chooseExePath
        :isRun
        outPath: cf.outPath.stringView
        outputDir: cf.outputDir.stringView
        unitname: cf.unitname.stringView
        targetTriple: cf.targetTriple.stringView
    )
    # -B goes to tcc and to nothing else: another compiler would reject it, and
    # a tcc that is not the one this tree ships has a payload of its own.
    # `--tcc-lib` overrides when both are present.
    ccTcc: String
    ccReal: ccRealPath name: cc
    cka: zcc.ccFamilyOf ccPath: ccReal.stringView
    isTcc: cka.tcc
    if isTcc when (io.exists path: tccDir) then ccTcc = tccDir.string
    refuseCrossTarget targetTriple: cf.targetTriple.stringView :cc fam: cka
    inproc: (zv.slotOf text: ccMode) == zcWord.slot.mInproc
    if inproc then (
        refuseInprocMisuse
        :isTcc
        :cc
        ccTcc: ccTcc.stringView
        :tccDir
        ldflags: cf.ldflags.stringView
    )
    objs: (
        objectsForBuild
        :csrc
        :cc
        :ccMode
        :tccDir
        targetTriple: cf.targetTriple.stringView
        cflags: cf.cflags.stringView
        :zv
    )
    rc: (
        buildExe
        :cc
        ccKind: cka
        tempC: tmpc.stringView
        exe: exe.stringView
        release: cf.release
        cflags: cf.cflags.stringView
        ldflags: cf.ldflags.stringView
        :libs
        :objs
        tccDir: ccTcc.stringView
        :inproc
        windowsTarget: (ztarget.targetIsWindows triple: cf.targetTriple.stringView)
    )
    if cf.saveTemps then {
        kept: "zc: kept generated C at \{tmpc.stringView}"
        io.eprintln kept
    } else {
        removeTemp path: tmpc.stringView
    }
    reportBuildFailure :rc :inproc :cc ccTcc: ccTcc.stringView
    if isRun then runBuiltProgram exe: exe.stringView progArgs: cf.progArgs
}

# objectsForBuild -- the objects of the C sources an emitted file's header names
# (zcobj), built with the compiler that links it: a spawned compiler is known
# by its real path, libtcc by its library. A source that cannot be built stops
# zc with the reason.
objectsForBuild: function {
    csrc: StringView
    cc: StringView
    ccMode: StringView
    tccDir: StringView
    targetTriple: StringView
    # the program's C flags, whose sanitizers its objects take too
    cflags: StringView
    zv: zast.Vocab.view
} out List String is {
    none: List String
    if (zcc.csrcsOf :csrc).length == 0 then return none
    ccReal: ccRealPath name: cc
    fam: zcc.ccFamilyOf ccPath: ccReal.stringView
    inproc: (zv.slotOf text: ccMode) == zcWord.slot.mInproc
    ccId: ccReal.copy
    if inproc then {
        lf: zcheck.libtccFile
        ccId = path.join a: tccDir b: lf.stringView
    }
    payload: String
    if fam.tcc when (io.exists path: tccDir) then payload = tccDir.string
    if inproc then payload = tccDir.string
    r: (
        zcobj.objectsFor
        :csrc
        :cc
        ccId: ccId.stringView
        :fam
        triple: targetTriple
        tccDir: payload.stringView
        :inproc
        sanitize: (zcobj.sanitizerFlags :cflags).stringView
    )
    match (
        r
    ) case ok then {
        return r.take
    } case err then {
        io.eprintln r
        os.exit code: 1
    }
    return none
}

# printObjectsAndExit -- `zc cobj <file.c>`: the cached object of each C source
# the emitted file's header names, built first where needed, one path a line
# (stdout), and with --link then each library its header declares, as the
# compiler names one (`-lX`, or cl's `X.lib`); then stop
printObjectsAndExit: function {cf: ZcFlags.view zv: zast.Vocab.view} is {
    text: String
    rd: io.readText path: cf.unitname
    match (
        rd
    ) case ok then {
        text = rd.take
    } case err then {
        m: "zc cobj: cannot read '\{cf.unitname}'"
        io.eprintln m
        os.exit code: 2
    }
    cc: zcheck.pickCc ccFlag: cf.ccFlag.stringView targetTriple: cf.targetTriple.stringView
    objs: (
        objectsForBuild
        csrc: text.stringView
        cc: cc.stringView
        ccMode: (zcheck.pickCcMode modeFlag: cf.ccModeFlag.stringView).stringView
        tccDir: (zcheck.resolveTccDir flagVal: cf.tccLibFlag.stringView).stringView
        targetTriple: cf.targetTriple.stringView
        cflags: cf.cflags.stringView
        :zv
    )
    lines: String
    for each o: objs loop {
        if lines.length > 0 then lines.append "\n"
        lines.append o
    }
    if cf.link then {
        # the family of the compiler the build runs: the path resolved, as
        # build classifies it, so a `cc` that links to cl names `X.lib`
        fam: zcc.ccFamilyOf ccPath: (ccRealPath name: cc.stringView).stringView
        for each lib: (zcc.linksOf csrc: text.stringView) loop {
            if lines.length > 0 then lines.append "\n"
            lines.append (zcc.libraryArg f: fam name: lib.stringView)
        }
    }
    if lines.length > 0 then print lines
    os.exit code: 0
}

# refuseBadTarget -- validated here, not at the flag, because `--target` and
# `--cc` are order independent and this is the first point where both are
# known. It runs for every subcommand: `zc env --target <garbage>` reported a
# cross compiler for a triple that means nothing, and `zc emit` folded the host
# into it.
refuseBadTarget: function {targetTriple: StringView} is {
    te: ztarget.targetTripleError triple: targetTriple
    if te.length == 0 then return
    tm: "zc: \{te.stringView}"
    io.eprintln tm
    os.exit code: 2
}

# emitCSource -- the C for the whole program, with any emitter refusal reported
# and the phase timings printed when --time asked for them. Both output paths
# that need C ask this, so they cannot drift apart.
emitCSource: function {
    prog: zast.Ast.view
    st: zenv.ZSymbolTable
    # the files a reached `error` is shown from
    vfs: zvfs.ZVfs
    # the main unit's file, for a failure that carries no file of its own
    mainFsno: zvfs.fsno
    # the user units' C implementation files, checked
    users: (List zemitterc.UserImplementation).view
    cf: ZcFlags.view
    # the file the C is written to, which --line-marks names (cOutputPath)
    cPath: StringView
    ccFamily: zcc.ccfamily
    t0: i64
    t1: i64
    t2: i64
} out String is {
    emitErrs: List zast.ErrorData
    # what --line-marks names beside `cPath`: the main unit's file
    mainPath: String
    if cf.lineMarks then mainPath = vfs.displayPath dentryid: mainFsno
    csrc: (
        zemitterc.emitC
        program: prog
        reg: st.reg
        typing: st.typing
        :users
        servedRows: (cf.nativecFiles or cf.markNatives).not
        markNatives: cf.markNatives
        lineMarks: cf.lineMarks
        :cPath
        mainPath: mainPath.stringView
        fastHash: cf.fastHash
        readableNames: cf.readableNames
        errs: emitErrs
        :ccFamily
        targetArch: (ztarget.targetOrHostArch triple: cf.targetTriple.stringView).stringView
        targetOs: (ztarget.targetOrHostOs triple: cf.targetTriple.stringView).stringView
    )
    failEmitErrors errs: emitErrs :vfs :prog :mainFsno
    if cf.timed then printPhases :t0 :t1 :t2 t3: os.monotonicMillis
    return csrc
}

# applyProjectOrExit -- the project's settings under the flags, or, when its
# project.zd cannot be read, the error and stop.
applyProjectOrExit: function {cf: ZcFlags zv: zast.Vocab.view pf: zproject.ProjectFile.view} is {
    if pf.error.length > 0 then {
        io.eprintln pf.error
        if (
            pf.errorCount == 1
        ) then io.eprintln "1 error found" else io.eprintln "\{pf.errorCount} errors found"
        os.exit code: 2
    }
    cf.applyProject :zv :pf
}

# printEnvAndExit -- `zc env`: the resolved settings, then stop.
printEnvAndExit: function {cf: ZcFlags.view pf: zproject.ProjectFile.view} is {
    (
        printEnv
        project: pf.dir.stringView
        systemFlag: cf.systemFlag.stringView
        ccFlag: cf.ccFlag.stringView
        ccModeFlag: cf.ccModeFlag.stringView
        targetTriple: cf.targetTriple.stringView
        tccLibFlag: cf.tccLibFlag.stringView
    )
    os.exit code: 0
}

# mountBuild -- bind the build's roots into `vfs`: the stdlib, the generated
# `z` unit -- made from this build's values and written to disk for people
# and editors -- and the src roots. Answers the root a parse starts from.
mountBuild: function {
    vfs: zvfs.ZVfs
    cf: ZcFlags.view
    pf: zproject.ProjectFile.view
    systemdir: StringView
    cc: StringView
    ccMode: StringView
    tccDir: StringView
} out zvfs.fsno is {
    facts: cf.buildFacts :systemdir :cc :ccMode :tccDir
    layer: zproject.zLayer :pf :facts
    zproject.writeLayer :layer
    roots: zcheck.buildRoots :vfs :systemdir srcdirs: cf.srcdirs :layer
    return roots.root
}

# CLI entry point: read the verbs answered before any flag, then hand the
# command line to the command that compiles.
main: function is {
    argv: os.args
    n: argv.length
    if n < 2 then {
        printUsage
        os.exit code: wrongUsage
    }
    firstArg: (argv.get i: 1).copy
    zv: zast.Vocab.create block: zcWord
    w1: zv.slotOf text: firstArg.stringView
    dispatchHelpVerb :argv :n :zv w: w1
    dispatchToolVerb :argv w: w1 :zv
    rc: i32
    if (isPipelineVerb w: w1) then {
        rc = compileCommand :zv sub: firstArg.stringView subW: w1 first: 2
    } else {
        # with no command the unit stands where the command would
        rc = compileCommand :zv sub: "" subW: zv.none first: 1
    }
    # a command that did its work ends by returning, so everything it and
    # this function hold is released; os.exit releases nothing
    if rc != 0 then os.exit code: rc
}

# compileCommand -- `build`, `run`, `emit`, `dump`, `env`, `cobj`, or a unit
# with no command: read the command line by the command's own spec, then
# produce what the command and the flags ask for. `sub` is the command as
# written, empty when there is none, and `subW` its slot in zcWord; the
# arguments start at `first`. Answers the exit code of a refused command line;
# anything later stops zc itself.
compileCommand: function {
    zv: zast.Vocab.view
    sub: StringView
    subW: u64
    first: u64
} out i32 is {
    sp: commandSpec :subW
    pr: cli.parse spec: sp args: os.args :first
    match (
        pr
    ) case ok then {
        answerInline p: pr :zv :sub
        named: operand.src
        if subW == zcWord.slot.vCobj then named = operand.cFile
        cf: ZcFlags.read p: pr :named
        isRun: subW == zcWord.slot.vRun
        if (cf.refusesSurplus p: pr passesRest: isRun) then return wrongUsage
        if sub.length == 0 when (bareDumpRefused spec: sp p: pr) then return wrongUsage
        if subW == zcWord.slot.vCobj when cf.unitname.length == 0 then {
            return (missing spec: sp name: operand.cFile)
        }
        if (pr.given name: opt.ccMode) then {
            refuseUnknownCcMode :zv mode: cf.ccModeFlag.stringView named: opt.ccMode
        }
        compileUnits :cf :zv :sub :subW
        return 0
    } case err then {
        return (refused spec: sp e: pr)
    }
}

# bareDumpRefused -- with no command, --dump-sql asks for the model: says that
# the command line also asks for C (--emit-c), or holds a flag only a command
# that writes C reads. False when it does neither.
bareDumpRefused: function {spec: cli.Spec.view p: cli.Parsed.view} out bool is {
    if (p.given name: opt.dumpSql).not then return false
    if (p.given name: opt.emitC) then {
        io.eprintln "zc: --emit-c and --dump-sql name two different outputs"
        return true
    }
    unread: List String
    if (p.hasFlag name: opt.timed) then unread.append from: opt.timed.string
    if (p.hasFlag name: opt.nativecFiles) then unread.append from: opt.nativecFiles.string
    if (p.hasFlag name: opt.markNatives) then unread.append from: opt.markNatives.string
    if (p.hasFlag name: opt.lineMarks) then unread.append from: opt.lineMarks.string
    if unread.length == 0 then return false
    refused :spec e: cli.CliError.unknownFlag (unread.get i: 0).copy
    return true
}

# compileUnits -- what the command `sub` (its slot in zcWord `subW`) and the
# flags `cf` ask for: find the project, then C, a model dump, or a native
# executable, run when `run` asked for it -- for the unit the command line
# names, else for the project's programs.
compileUnits: function {cf: ZcFlags zv: zast.Vocab.view sub: StringView subW: u64} is {
    # project.zd is checked against this zc's own stdlib, the --system the
    # command names or the one installed with it. The prelude read for it is
    # kept for each program, which reads on from it where it finds the same
    # files (zparser.Parser.parseShared)
    prelude: zparser.PreludeStore.create share: true
    pf: (
        zproject.discoverProject
        start: cf.projectStart.stringView
        systemdir: (zcheck.resolveSystemDir flagVal: cf.systemFlag.stringView).stringView
        :prelude
    )
    applyProjectOrExit :cf :zv :pf
    refuseBadTarget targetTriple: cf.targetTriple.stringView
    if subW == zcWord.slot.vEnv then printEnvAndExit :cf :pf
    if subW == zcWord.slot.vCobj then printObjectsAndExit :cf :zv
    mode: (
        resolveOutMode
        :sub
        :subW
        unitname: cf.unitname.stringView
        canon: cf.canon
        emitTarget: cf.emitTarget.stringView
        dumpSqlTarget: cf.dumpSqlTarget.stringView
    )
    isRun: subW == zcWord.slot.vRun
    units: unitsToCompile :cf :pf :subW
    k: u64
    for each u: units loop {
        k = k + 1
        # no parse follows the last program's, so it keeps no prelude
        prelude.share = k < units.length
        cf.unitname = u.copy
        compileUnit :cf :pf :zv :mode :isRun :prelude
    }
}

# unitsToCompile -- the unit the command line names, else the project's
# programs: all of them for `build`, the one listed for any other command.
# Several programs for a command that makes one thing, or for one -o file, is
# refused, naming them.
unitsToCompile: function {
    cf: ZcFlags.view
    pf: zproject.ProjectFile.view
    # the subcommand's slot in zcWord
    subW: u64
} out List String is {
    r: List String
    if cf.unitname.length > 0 then {
        r.append from: cf.unitname.copy
        return r
    }
    if pf.programs.length == 0 then {
        io.eprintln "zc: no unit specified"
        os.exit code: 2
    }
    if pf.programs.length > 1 then {
        names: String
        for each pg: pf.programs loop {
            if names.length > 0 then names.append ", "
            names.append pg
        }
        if subW != zcWord.slot.vBuild then {
            io.eprintln "zc: project.zd lists several programs (\{names}); name the one to use"
            os.exit code: 2
        }
        if cf.outPath.length > 0 then {
            io.eprintln "zc: -o names one file, and project.zd lists several programs (\{names}); name the one to build"
            os.exit code: 2
        }
    }
    for each pg: pf.programs loop r.append from: pg.copy
    return r
}

# compileUnit -- the pipeline for `cf.unitname`: parse, check, then the C, the
# dump or the executable `mode` asks for, run when `run` asked for it. Any
# error is reported and stops zc.
compileUnit: function {
    cf: ZcFlags
    pf: zproject.ProjectFile.view
    zv: zast.Vocab.view
    mode: outmode
    isRun: bool
    # the prelude the project read kept, which the parse reads on from where it
    # finds the same files
    prelude: zparser.PreludeStore
} is {
    cf.resolveRoots
    systemdir: zcheck.resolveSystemDir flagVal: cf.systemFlag.stringView
    # resolved BEFORE the parse: the generated `z` unit records the toolchain
    # in its header, and is written before the build begins. The build branch
    # below reuses this rather than resolving a second time.
    ccPath: zcheck.pickCc ccFlag: cf.ccFlag.stringView targetTriple: cf.targetTriple.stringView
    # resolved here for the same reason: the payload directory belongs to the
    # compiler choice, and the build branch below reuses this rather than
    # resolving a second time.
    tccDir: zcheck.resolveTccDir flagVal: cf.tccLibFlag.stringView
    ccMode: zcheck.pickCcMode modeFlag: cf.ccModeFlag.stringView
    parseStart: os.monotonicMillis
    rootCause: zcheck.missingRootCause systemdir: systemdir.stringView srcdirs: cf.srcdirs
    if rootCause.length > 0 then {
        io.eprintln "zc: \{rootCause}"
        os.exit code: 2
    }
    vfs: zcheck.newVfs
    rootid: (
        mountBuild
        :vfs
        :cf
        :pf
        systemdir: systemdir.stringView
        cc: ccPath.stringView
        ccMode: ccMode.stringView
        tccDir: tccDir.stringView
    )
    p: zparser.Parser.create
    prog: p.parseShared :vfs :rootid mainUnitName: cf.unitname store: prelude
    parseEnd: os.monotonicMillis
    mfn: "\{cf.unitname.stringView}.z"
    mainFsno: vfs.walk parent: rootid name: mfn.stringView
    # a dump introspects the unit rather than building it, so it asks for no
    # entry point -- the one command that reads the model instead of emitting it
    wantRows: mode.dumpsql or mode.dumpcanon
    # a failed parse hands back the tree with the error as its root row. The
    # test is a call, not a binding, so no shared lock on `prog.nodes` outlives
    # it -- typecheck below takes the tree exclusively.
    if (zast.isErrorAt ast: prog id: prog.root) then {
        reportParseError :prog :vfs fallbackFsno: mainFsno
    }
    reg: ztypes.newRegistry
    reach: ztypecheck.checkreach.fromMain
    if cf.eagerCheck then reach = ztypecheck.checkreach.everything
    st: (
        ztypecheck.typecheck
        program: prog
        :reg
        :reach
        requireMain: wantRows.not
        dumpRows: wantRows
        filePaths: (ztypecheck.filePathsOf :vfs ast: prog)
    )
    checkStart: os.monotonicMillis
    reportTypeErrors :st :prog :vfs :mainFsno
    if mode.dumpcanon then {
        canonOut: zsqldump.dumpCanon program: prog symtab: st
        canonTarget: outTarget primary: "" fallback: cf.outPath.stringView
        (
            writeOut
            :zv
            target: canonTarget.stringView
            content: canonOut.stringView
            what: "canonical dump"
        )
        return
    }
    if mode.dumpsql then {
        sql: zsqldump.dumpSql program: prog :vfs symtab: st
        sqlTarget: outTarget primary: cf.dumpSqlTarget.stringView fallback: cf.outPath.stringView
        writeOut :zv target: sqlTarget.stringView content: sql.stringView what: "SQL dump"
        return
    }
    ccReal: ccRealPath name: ccPath.stringView
    users: (
        userImplementations
        :prog
        :vfs
        :rootid
        srcdirs: cf.srcdirs
        systemdir: systemdir.stringView
        withServed: cf.nativecFiles or cf.markNatives
    )
    cPath: String
    if cf.lineMarks then cPath = cOutputPath :zv :cf emitc: mode.emitc
    csrc: (
        emitCSource
        :prog
        :st
        :vfs
        :mainFsno
        :users
        :cf
        cPath: cPath.stringView
        ccFamily: (zcc.ccFamilyOf ccPath: ccReal.stringView)
        t0: parseStart
        t1: parseEnd
        t2: checkStart
    )
    if mode.emitc then {
        tgt: outTarget primary: cf.emitTarget.stringView fallback: cf.outPath.stringView
        writeOut :zv target: tgt.stringView content: csrc.stringView what: "C output"
        return
    }
    # the link line is the artifact's own: the reached units' libraries, the
    # ones the C backend added among them
    linkLibs: zcc.linksOf csrc: csrc.stringView
    (
        buildAndRun
        :cf
        csrc: csrc.stringView
        libs: linkLibs
        cc: ccPath.stringView
        ccMode: ccMode.stringView
        tccDir: tccDir.stringView
        :isRun
        :zv
    )
}
