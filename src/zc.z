# zerolang compiler driver: the `zc` command-line interface.
#
# Parses a unit over a stdlib + source VFS, type-checks it, then builds
# it to a native executable (build), runs it (run), emits standalone C
# (emit), dumps the typecheck model (dump), or explains an error code
# (explain). A subcommand is required. See docs/zc.pdoc for the reference.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :main
}

astnode: zast.astnode

# errorFsno -- the file an error belongs to: its own stamp when it carries one,
# else the file of the node it names, else the main unit's. A typecheck error
# stamps fsno 0, which is why there are three answers and not one.
errorFsno: function {
    e: zast.ErrorData.view
    ast: zast.Ast.view
    fallbackFsno: zvfs.fsno
} out zvfs.fsno is {
    if e.fsno.isZero.not then return e.fsno
    if e.nodeid.isZero.not then {
        sf: ast.fsnoForNode nodeid: e.nodeid
        if sf.isZero.not then return sf
    }
    return fallbackFsno
}

# errorSnippet -- the source line the error sits on behind a line-number
# gutter, and under it a caret run the width of the span it names. "" when the
# file holds no such line.
errorSnippet: function {e: zast.ErrorData.view vfs: zvfs.ZVfs fno: zvfs.fsno} out String is {
    buf: String
    lnOpt: vfs.getline dentryid: fno lineno: e.lineno - 1
    match (
        lnOpt
    ) case some then {
        gut: zdiag.rpad4 n: e.lineno
        eg: zdiag.spacesOf n: 4
        co: e.colno
        if co > 0 then co = co - 1
        sp: zdiag.spacesOf n: co
        buf.append "\n"
        buf.append gut
        buf.append " | "
        buf.append lnOpt
        buf.append "\n"
        buf.append eg
        buf.append " | "
        buf.append sp
        cw: e.width
        if cw < 1 then cw = 1
        car: zdiag.caretsOf n: cw
        buf.append car
    } case none then null
    return buf
}

# errorMessage -- rustc-style render: code+message, location, source snippet +
# caret, then note/hint. The location names the file by its root as given
# joined with its path under that root (ZVfs.displayPath). fallbackFsno (the main unit's file) covers errors that
# carry no file id of their own (typecheck errors stamp fsno 0).
errorMessage: function {
    e: zast.ErrorData.view
    vfs: zvfs.ZVfs
    ast: zast.Ast.view
    fallbackFsno: zvfs.fsno
} out String is {
    buf: zast.errorLine :e
    fno: errorFsno :e :ast :fallbackFsno
    if fno.isZero.not when e.lineno > 0 then {
        path: vfs.displayPath dentryid: fno
        loc: " --> \{path}:\{e.lineno}:\{e.colno}"
        buf.append "\n"
        buf.append loc
        buf.append (errorSnippet :e :vfs :fno)
    }
    if e.note.length > 0 then {
        ntl: "\n     = note: \{e.note}"
        buf.append ntl
    }
    if e.hint.length > 0 then {
        htl: "\n     = hint: \{e.hint}"
        buf.append htl
    }
    return buf
}

# failEmitErrors -- failures the emitter recorded: compile-time `error`
# calls proved reachable and constructs it cannot emit. Report each in the
# checker's format and exit non-zero (no C is written or compiled).
failEmitErrors: function {errs: (List String).view} is {
    n: errs.length
    if n == 0 then return
    for each e: errs loop {
        el: "error[E0500]: \{e.stringView}"
        io.eprintln el
    }
    if n == 1 then {
        io.eprintln "1 error found"
    } else {
        es: "\{n} errors found"
        io.eprintln es
    }
    os.exit code: 1
}

# printPhases -- the --time report: per-phase wall on the monotonic clock.
printPhases: function {t0: i64 t1: i64 t2: i64 t3: i64} is {
    io.eprintln "zc --time: parse=\{t1 - t0}ms typecheck=\{t2 - t1}ms emit=\{t3 - t2}ms total=\{t3 - t0}ms"
}

# zcWord -- every word zc reads off its command line: the verbs, the flags, the
# values a flag validates and `-` for standard output. A word is classified by
# its slot here (zast.Vocab), never by comparing its text.
zcWord: data {
    vBuild: "build"
    vRun: "run"
    vEmit: "emit"
    vDump: "dump"
    vNatives: "natives"
    vExplain: "explain"
    vEnv: "env"
    vVersion: "version"
    vHelp: "help"
    vInit: "init"
    vFmt: "fmt"
    vLint: "lint"
    vFormat: "format"
    fH: "-h"
    fHelp: "--help"
    fV: "-V"
    fVersion: "--version"
    fProgArgs: "--"
    fCanon: "--canon"
    fRelease: "--release"
    fSaveTemps: "--save-temps"
    fTime: "--time"
    fFastHash: "--fast-hash"
    fReadableNames: "--readable-names"
    fEager: "--eager"
    fSrc: "--src"
    fSystem: "--system"
    fRuntime: "--runtime"
    fEmitC: "--emit-c"
    fDumpSql: "--dump-sql"
    fOut: "-o"
    fCc: "--cc"
    fCcMode: "--cc-mode"
    fTccLib: "--tcc-lib"
    fTarget: "--target"
    fCflags: "--cflags"
    fLdflags: "--ldflags"
    mSpawn: "spawn"
    mInproc: "inproc"
    stdoutPath: "-"
} out stringdata

# isPipelineVerb -- the verbs that proceed to flag parsing: build/run/emit/dump
# compile a unit; env prints settings. version/help/explain and init are handled
# before this and exit early, so they are absent here.
isPipelineVerb: function {w: u64} out bool is {
    if w == zcWord.slot.vBuild then return true
    if w == zcWord.slot.vRun then return true
    if w == zcWord.slot.vEmit then return true
    return (w == zcWord.slot.vDump) or (w == zcWord.slot.vEnv)
}

# printUsage -- the general help text (stderr): command groups, then flags.
printUsage: function is {
    io.eprintln "usage: zc <command> [arguments] [flags]"
    io.eprintln ""
    io.eprintln "build commands:"
    io.eprintln "  build <src>          compile <src> to a native executable"
    io.eprintln "  run   <src> [args]   build, then run it, forwarding [args]"
    io.eprintln "  emit  <src>          emit standalone C (-o FILE, else stdout)"
    io.eprintln ""
    io.eprintln "project:"
    io.eprintln "  init [dir]           make dir (default .) a project: project.z, and main.z when"
    io.eprintln "                       it holds no unit"
    io.eprintln ""
    io.eprintln "diagnostics:"
    io.eprintln "  dump  <src>          dump the typecheck model as SQL (--canon: id-normalized)"
    io.eprintln "  natives              print the generated conversion rows of natives.tbl"
    io.eprintln "  explain <code>       explain an error code, e.g. zc explain E0200"
    io.eprintln ""
    io.eprintln "info:"
    io.eprintln "  env                  print resolved tool paths and settings"
    io.eprintln "  version              print the version"
    io.eprintln "  help [command]       print usage, or help for one command"
    io.eprintln ""
    io.eprintln "<src> is a unit name (hello) or a path (hello.z, ./sub/hello.z)."
    io.eprintln ""
    io.eprintln "common flags:"
    io.eprintln "  -o OUT  --src DIR  --release  --cc CC  --cc-mode MODE"
    io.eprintln "  --target TRIPLE"
    io.eprintln "  --cflags STR  --ldflags STR  --save-temps  --time  --fast-hash"
    io.eprintln "  --readable-names  --eager"
    io.eprintln "  --system DIR  --runtime DIR  --tcc-lib DIR  -h/--help  -V/--version"
}

# printCommandHelp -- detailed help for one command (stderr).
printCommandHelp: function {zv: zast.Vocab.view cmd: StringView} is {
    w: zv.slotOf text: cmd
    if w == zcWord.slot.vBuild then {
        io.eprintln "usage: zc build <src> [flags]"
        io.eprintln "Compile <src> to a native executable."
        io.eprintln "Output goes to -o OUT, else <unit> (<unit>.exe for windows targets) in the"
        io.eprintln "project's directory (project.z's outputDir moves it), or outside a project in ."
        io.eprintln "Flags: --release --cc CC --cc-mode spawn|inproc --target TRIPLE"
        io.eprintln "       --save-temps"
        io.eprintln "       --cflags STR --ldflags STR --src DIR --tcc-lib DIR"
    } else if w == zcWord.slot.vRun then {
        io.eprintln "usage: zc run <src> [args] [flags]"
        io.eprintln "Build <src>, then run it. Flags before <src> configure the build;"
        io.eprintln "args after <src> (or after --) are passed to the program."
        io.eprintln "The program's own exit code is propagated."
    } else if w == zcWord.slot.vEmit then {
        io.eprintln "usage: zc emit <src> [flags]"
        io.eprintln "Emit standalone C17 to -o FILE (or stdout). The runtime is inlined,"
        io.eprintln "so the single .c needs no extra include paths."
    } else if w == zcWord.slot.vDump then {
        io.eprintln "usage: zc dump <src> [--canon] [flags]"
        io.eprintln "Dump the typecheck model as SQL to -o FILE (or stdout)."
        io.eprintln "--canon emits the id-normalized model instead."
    } else if w == zcWord.slot.vNatives then {
        io.eprintln "usage: zc natives"
        io.eprintln "Print the conversions section of src/runtime/natives.tbl, derived from"
        io.eprintln "the numeric rule. natives-tbl-guard diffs this against the checked-in"
        io.eprintln "file, so the table cannot drift from the rule it caches."
    } else if w == zcWord.slot.vExplain then {
        io.eprintln "usage: zc explain <code>"
        io.eprintln "Explain a diagnostic error code, e.g. zc explain E0200."
    } else if w == zcWord.slot.vEnv then {
        io.eprintln "usage: zc env"
        io.eprintln "Print resolved tool paths and settings: system, runtime and tcc dirs,"
        io.eprintln "the C compiler, the target triple, and the version."
    } else if w == zcWord.slot.vVersion then {
        io.eprintln "usage: zc version"
        io.eprintln "Print the compiler version."
    } else if w == zcWord.slot.vHelp then {
        io.eprintln "usage: zc help [command]"
        io.eprintln "Print general usage, or detailed help for one command."
    } else {
        m: "zc help: unknown command '\{cmd}'"
        io.eprintln m
        printUsage
    }
}

# printVersion -- a version line (stdout).
printVersion: function is {
    v: zversion.versionLine tool: "zc"
    print "\{v}\n"
}

# substr -- the bytes of p in [start, end) as a new String.
substr: function {p: StringView start: u64 end: u64} out String is {
    r: String
    i: start
    for i < end loop {
        b: p.byteAt :i
        match (
            b
        ) case some then {
            r.appendByte :b
        } case none then null
        i = i + 1
    }
    return r
}

# baseName -- the final path segment of p (everything after the last '/').
baseName: function {p: StringView} out String is {
    idxOpt: p.lastIndexOf needle: "/"
    match (
        idxOpt
    ) case some then {
        s: idxOpt + 1
        pl: p.length
        return (substr :p start: s end: pl)
    } case none then {
        return p.string
    }
}

# stripDotZ -- p without a trailing ".z" extension, if present.
stripDotZ: function {p: StringView} out String is {
    if (p.endsWith suffix: ".z") then {
        e: p.length - 2
        return (substr :p start: 0 end: e)
    }
    return p.string
}

# printEnv -- resolved tool paths and settings as KEY=VALUE lines (stdout).
printEnv: function {
    project: StringView
    systemFlag: StringView
    runtimeFlag: StringView
    ccFlag: StringView
    ccModeFlag: StringView
    targetTriple: StringView
    tccLibFlag: StringView
} is {
    sysd: zcheck.resolveSystemDir flagVal: systemFlag
    rund: zcheck.resolveRuntimeDir flagVal: runtimeFlag
    cc: zcheck.pickCc :ccFlag :targetTriple
    ccm: zcheck.pickCcMode modeFlag: ccModeFlag
    tccd: zcheck.resolveTccDir flagVal: tccLibFlag
    tccx: zcheck.vendoredTcc
    root: zcheck.exeRoot
    ver: zversion.semver
    commit: os.buildCommit
    bdate: os.buildDate
    bcc: os.buildCompiler
    exep: String
    ep: os.exePath
    match (
        ep
    ) case ok then {
        exep = ep.copy
    } case err then null
    buf: String
    buf.append "ZEROLANG_ROOT="
    buf.append root
    buf.append "\nZEROLANG_SYSTEM="
    buf.append sysd
    buf.append "\nZEROLANG_RUNTIME="
    buf.append rund
    buf.append "\nZC_CC="
    buf.append cc
    buf.append "\nZC_CC_MODE="
    buf.append ccm
    buf.append "\nZC_TCC="
    buf.append tccx
    buf.append "\nZC_TCC_LIB="
    buf.append tccd
    buf.append "\nZC_TARGET="
    buf.append targetTriple
    buf.append "\nZC_PROJECT="
    if project.length > 0 then buf.append (zcheck.joinPath a: project b: "project.z")
    buf.append "\nZC_VERSION="
    buf.append ver
    buf.append "\nZC_COMMIT="
    buf.append commit
    buf.append "\nZC_BUILD_DATE="
    buf.append bdate
    buf.append "\nZC_BUILD_CC="
    buf.append bcc
    buf.append "\nZC_EXE="
    buf.append exep
    buf.append "\n"
    print buf
}

# tempPath -- $TMPDIR (or /tmp) / zc-<pid>-<uname><ext>.
tempPath: function {uname: StringView ext: StringView} out String is {
    base: "/tmp".string
    te: os.env key: "TMPDIR"
    match (
        te
    ) case some then {
        if te.length > 0 then base = te.copy
    } case none then null
    pid: os.pid
    ps: "\{pid}"
    r: String
    r.append base
    r.append "/zc-"
    r.append ps
    r.append "-"
    r.append uname
    r.append ext
    return r
}

# ccOnPath -- the file a bare compiler name (`cc`) resolves to through PATH,
# the way the spawn will resolve it; a name with a directory in it is its own
# answer. "" when nothing on PATH is that name.
ccOnPath: function {name: StringView} out String is {
    if (name.contains needle: "/") then return name.string
    pe: os.env key: "PATH"
    if pe.none then return ""
    for each d: (pe.stringView.split sep: ":") loop {
        if d.length > 0 then {
            cand: "\{d}/\{name}"
            if (io.exists path: cand) then return cand
        }
    }
    return ""
}

# ccRealPath -- the compiler the name actually runs: PATH-resolved, then read
# through its symlink chain (`cc` -> /etc/alternatives/cc -> gcc-15 on Debian).
# Links are READ, never run, so ccFamilyOf's reason for not probing --version
# holds here too; a wrapper script still classifies as `other`. A name that
# resolves to nothing, or a link deeper than eight hops, answers as written.
ccRealPath: function {name: StringView} out String is {
    cur: ccOnPath :name
    if cur.length == 0 then return name.string
    hops: u64
    for hops < 8 loop {
        hops = hops + 1
        rl: io.readlink path: cur
        if rl.err then return cur
        t: rl.take
        if t.stringView.startsWith "/" then {
            cur = t.take
        } else {
            # a relative target is relative to the LINK's directory
            dir: String
            slash: cur.stringView.lastIndexOf needle: "/"
            if slash.some then dir = (cur.stringView.substring from: 0 to: slash).string
            cur = "\{dir}/\{t}"
        }
    }
    return cur
}

# buildExe -- turn the emitted C into an executable, by running the C
# compiler as a child process or by loading libtcc into this one. Debug is
# -O0 -g; --release is -O2. cflags/ldflags split on spaces. Empty out/err
# paths inherit the terminal so cc diagnostics print live.
#
# Both modes return the same i32 and write the same kind of artifact -- a
# file on disk -- so `zc run` spawns the result either way and exit codes,
# signals and the leak corpus see no difference. In-process buys the fast
# COMPILE and nothing else.
buildExe: function {
    cc: StringView
    # the compiler family `cc` belongs to (zemitterc.ccFamilyOf): what decides
    # which warning spellings it is handed
    ccKind: zemitterc.ccfamily
    tempC: StringView
    exe: StringView
    release: bool
    cflags: StringView
    ldflags: StringView
    libs: (List String).view
    tccDir: StringView
    inproc: bool
} out i32 is {
    if inproc then {
        # There is no ldflags parameter read here: libtcc links through the
        # same state that compiled, so there is no link step to pass them to.
        # The caller REFUSES a non-empty --ldflags under inproc rather than
        # dropping it, so this branch never has any to drop.
        return (tcc.compileToExe
            csrc: tempC
            :exe
            :tccDir
            :release
            :cflags
            :libs
        )
    }
    a: List String
    a.append from: cc.string
    if release then {
        a.append from: "-O2".string
    } else {
        a.append from: "-O0".string
        a.append from: "-g".string
    }
    a.append from: "-std=c17".string
    # a `.view` receiver or parameter is `const` in the C, so a write through
    # one is a discarded qualifier: the checker refuses it first, and this
    # makes the C compiler refuse it too, should the checker ever miss one.
    # gcc and clang spell the warning differently; tcc has no such warning and
    # would silently accept the flag, so it is not handed one.
    if ccKind.gcc then a.append from: "-Werror=discarded-qualifiers".string
    if ccKind.clang then {
        a.append from: "-Werror=incompatible-pointer-types-discards-qualifiers".string
    }
    # tcc's runtime payload -- libtcc1.a and its own headers -- is fixed at
    # CONFIGURE time, so a tree that moved has to say where it went: without
    # -B, tcc cannot resolve stddef.h and rejects every program. Empty for
    # every other compiler, and the caller decides that.
    if tccDir.length > 0 then {
        a.append from: "-B".string
        a.append from: tccDir.string
    }
    for each piece: (cflags.split sep: " ") loop {
        if piece.length > 0 then {
            a.append from: piece.string
        }
    }
    a.append from: "-o".string
    a.append from: exe.string
    a.append from: tempC.string
    for each lb9c: libs loop {
        la9c: "-l".string
        la9c.append lb9c
        a.append from: la9c
    }
    a.append from: "-lm".string
    for each piece2: (ldflags.split sep: " ") loop {
        if piece2.length > 0 then {
            a.append from: piece2.string
        }
    }
    rc: os.spawn argv: a cwd: "" outPath: "" errPath: "" timeoutSecs: 0
    return rc
}

# runZlShim -- trigger the standalone zl linter/formatter. `zc lint`/`zc fmt` are
# thin shims: locate the `zl` binary alongside this executable in bin/, forward the
# remaining arguments, inherit stdio (empty out/err paths) so its output reaches the
# terminal, and propagate its exit code.
runZlShim: function {verb: StringView argv: (List String).borrow} out i32 is {
    ep: os.exePath
    zlpath: String
    match (
        ep
    ) case ok then {
        d: zcheck.dirname p: ep.stringView
        zlpath = zcheck.joinPath a: d.stringView b: "zl"
    } case err then {
        em: "zc \{verb}: cannot locate the zl binary (executable path unavailable)"
        io.eprintln em
        return 2
    }
    args: List String
    args.append from: zlpath.copy
    args.append from: verb.string
    i: 2.u64
    n: argv.length
    for i < n loop {
        a: (argv.get :i).copy
        args.append from: a
        i = i + 1
    }
    rc: os.spawn argv: args cwd: "" outPath: "" errPath: "" timeoutSecs: 0
    return rc
}

# writeOut -- write content to a file path, or stdout when the path is "-".
writeOut: function {
    zv: zast.Vocab.view target: StringView content: StringView what: StringView
} is {
    if (zv.slotOf text: target) == zcWord.slot.stdoutPath then {
        print content
    } else {
        wr: io.writeText path: target :content
        match (
            wr
        ) case ok then null case err then {
            em: "zc: could not write \{what}"
            io.eprintln em
            os.exit code: 1
        }
    }
}

# removeTemp -- best-effort delete of a temporary build artifact.
removeTemp: function {path: StringView} is {
    rr: io.remove :path
    match (
        rr
    ) case ok then null case err then null
}

# parseECode -- the numeric code in an "E0200"/"e0200"/"0200"/"200" string; 0
# for any other spelling. Every byte after the optional E is a digit: skipping
# the others read `A001` -- a zl rule code -- as E0001.
parseECode: function {s: StringView} out u32 is {
    i: u64
    b0: (s.byteAt i: 0).or d: 0
    if (b0 == 69) or (b0 == 101) then i = 1
    if i == s.length then return 0
    return (digitsValue :s from: i)
}

# digitsValue -- the decimal value of `s` from byte `from` on; 0 unless every
# byte there is a digit.
digitsValue: function {s: StringView from: u64} out u32 is {
    r: u32
    i: from
    for i < s.length loop {
        bo: (s.byteAt :i).or d: 0
        if (bo < 48) or (bo > 57) then return 0
        r = r * 10 + (bo - 48)
        i = i + 1
    }
    return r
}

# isZlRuleCode -- `A001`, `L013`: an architecture rule's or a lint's code, which
# zl explains rather than zc.
isZlRuleCode: function {s: StringView} out bool is {
    b0: (s.byteAt i: 0).or d: 0
    if b0 != 65 when b0 != 76 then return false
    if s.length < 2 then return false
    return (digitsValue :s from: 1) > 0
}

# runExplain -- print the explanation for an error code, or a category fallback.
runExplain: function {codeArg: StringView} is {
    code: parseECode s: codeArg
    if code == 0 when (isZlRuleCode s: codeArg) then {
        io.eprintln "zc explain: \{codeArg} is a zl rule code -- run `zl explain \{codeArg}`"
        os.exit code: 2
    }
    if code == 0 then {
        m: "zc explain: not an error code: \{codeArg} (try e.g. zc explain E0200)"
        io.eprintln m
        os.exit code: 2
    }
    txt: zast.explainText :code
    if txt.length > 0 then {
        txt.append "\n"
        print txt
    } else {
        cat: "unknown category"
        if code < 100 then {
            cat = "parser / syntax error (E0001-E0099)"
        } else if code < 200 then {
            cat = "type resolution error (E0100-E0199)"
        } else if code < 300 then {
            cat = "ownership error (E0200-E0299)"
        } else if code < 400 then {
            cat = "call / argument error (E0300-E0399)"
        } else if code < 500 then {
            cat = "generic / monomorphization error (E0400-E0499)"
        } else if code < 600 then {
            cat = "emitter error (E0500-E0599)"
        } else if code < 700 then cat = "compile-time evaluation error (E0600-E0699)"
        m: "E\{code}: \{cat} -- no detailed explanation available\n"
        print m
    }
}

# flagValue -- the value a value-taking flag consumes. A flag that ends the
# command line is a usage error and exits 2 naming the flag; without this the
# argument loop reads one past the end and the runtime aborts with an index
# message that names nothing the caller can act on.
flagValue: function {argv: (List String).view i: u64 n: u64 flagName: StringView} out String is {
    if (i + 1) < n then return (argv.get i: i + 1).copy
    fm: "zc: \{flagName} needs a value"
    io.eprintln fm
    os.exit code: 2
    return ""
}

# dispatchHelpVerb -- the verbs that only print and stop: -h, --help,
# help [command], -V, --version and version. Anything else returns.
dispatchHelpVerb: function {argv: (List String).view n: u64 zv: zast.Vocab.view w: u64} is {
    if w == zcWord.slot.fH then {
        printUsage
        os.exit code: 0
    }
    if w == zcWord.slot.fHelp then {
        printUsage
        os.exit code: 0
    }
    if w == zcWord.slot.fV then {
        printVersion
        os.exit code: 0
    }
    if w == zcWord.slot.fVersion then {
        printVersion
        os.exit code: 0
    }
    if w == zcWord.slot.vVersion then {
        printVersion
        os.exit code: 0
    }
    if w != zcWord.slot.vHelp then return
    if n > 2 then {
        hc: argv.get i: 2
        printCommandHelp :zv cmd: hc.stringView
    } else {
        printUsage
    }
    os.exit code: 0
}

# dispatchToolVerb -- the verbs that do work of their own before any unit is
# named: `explain`, the natives table, and the three that shim through to zl.
# Anything else returns.
dispatchToolVerb: function {argv: (List String).borrow n: u64 w: u64} is {
    if w == zcWord.slot.vExplain then {
        if n > 2 then {
            ec: argv.get i: 2
            runExplain codeArg: ec.stringView
        } else {
            io.eprintln "zc explain: missing error code (e.g. zc explain E0200)"
            os.exit code: 2
        }
        os.exit code: 0
    }
    if w == zcWord.slot.vInit then {
        idir: ".".string
        if n > 2 then idir = (argv.get i: 2).copy
        ir: zproject.initProject dir: idir.stringView
        if ir.ok.not then {
            io.eprintln ir.text
            os.exit code: 2
        }
        print ir.text.stringView.trim
        os.exit code: 0
    }
    if w == zcWord.slot.vNatives then {
        nrows: zemitterc.nativeConvRows
        print nrows
        os.exit code: 0
    }
    if w == zcWord.slot.vFmt then {
        rcf: runZlShim verb: "fmt" :argv
        os.exit code: rcf
    }
    if w == zcWord.slot.vLint then {
        rcl: runZlShim verb: "lint" :argv
        os.exit code: rcl
    }
    if w == zcWord.slot.vFormat then {
        rcm: runZlShim verb: "format" :argv
        os.exit code: rcm
    }
}

# dispatchInlineVerb -- the print-and-stop flags accepted anywhere on the line,
# after the subcommand rather than instead of it. Nothing returns true: each
# one exits, and the caller reads the result like any other flag group.
dispatchInlineVerb: function {zv: zast.Vocab.view w: u64 sub: StringView} out bool is {
    if w == zcWord.slot.fH then {
        printCommandHelp :zv cmd: sub
        os.exit code: 0
    }
    if w == zcWord.slot.fHelp then {
        printCommandHelp :zv cmd: sub
        os.exit code: 0
    }
    if w == zcWord.slot.fV then {
        printVersion
        os.exit code: 0
    }
    if w == zcWord.slot.fVersion then {
        printVersion
        os.exit code: 0
    }
    return false
}

# refuseUnknownCcMode -- the one value-taking flag that validates its VALUE and
# not merely that one was given. It has to: an unrecognised mode would
# otherwise resolve to `spawn` and the build would silently do something other
# than what was asked, which is the same failure `--cc-mode` exists to rule
# out.
refuseUnknownCcMode: function {zv: zast.Vocab.view mode: StringView named: StringView} is {
    w: zv.slotOf text: mode
    known: (w == zcWord.slot.mSpawn) or (w == zcWord.slot.mInproc)
    if known then return
    mm: "zc: \{named} must be 'spawn' or 'inproc', not '\{mode}'"
    io.eprintln mm
    os.exit code: 2
}

# argstep -- what reading one command-line argument decided.
argstep: record {
    # false when the argument named no flag, so the caller must judge it itself
    taken: bool
    # the index of the last argument consumed, one past the flag when the flag
    # took a value
    at: u64
}

# outmode -- what a run produces, which the subcommand and the flags decide
# together.
outmode: variant {
    # build a native executable, and under `run` execute it
    build: null
    # standalone C
    emitc: null
    # the typecheck model as SQL
    dumpsql: null
    # the canonical model dump
    dumpcanon: null
}

# resolveOutMode -- what was asked for. A bare unit name with --emit-c or
# --dump-sql means that output; with neither it names no command at all.
resolveOutMode: function {
    sub: StringView
    # the subcommand's slot in zcWord
    subW: u64
    unitname: StringView
    canon: bool
    emitTarget: StringView
    dumpSqlTarget: StringView
} out outmode is {
    if subW == zcWord.slot.vEmit then return outmode.emitc
    if subW == zcWord.slot.vDump then {
        if canon then return outmode.dumpcanon
        return outmode.dumpsql
    }
    if sub.length > 0 then return outmode.build
    if emitTarget.length > 0 then return outmode.emitc
    if dumpSqlTarget.length > 0 then return outmode.dumpsql
    um: "zc: unknown command '\{unitname}'"
    io.eprintln um
    printUsage
    os.exit code: 2
    return outmode.build
}

# ZcFlags -- what zc's command line sets: the roots and files it names, the
# switches it turns on, and the C toolchain it picks.
ZcFlags: class {
    # the unit to compile, from the command line or from a path argument
    unitname: String
    # every --src, in the order given: they are all roots, and the first one
    # that answers a name wins
    srcdirs: List String
    # --system: where the stdlib lives, "" for the resolved default
    systemFlag: String
    # --runtime: where the C runtime and natives.tbl live, "" for the default
    runtimeFlag: String
    # --emit-c: where the C goes, "" for -o or stdout
    emitTarget: String
    # --dump-sql: where the SQL dump goes, "" for -o or stdout
    dumpSqlTarget: String
    # -o: where any output goes when its own flag named none
    outPath: String
    # where a build writes its executable when -o names none: the project
    # directory, or project.z's outputDir under it; "" (the working directory)
    # outside a project
    outputDir: String
    # --cc: the C compiler to drive, "" to resolve one from the target
    ccFlag: String
    # --cc-mode: "spawn" to run the compiler as a child, "inproc" for libtcc
    ccModeFlag: String
    # --tcc-lib: the tcc runtime payload directory, "" for the vendored one
    tccLibFlag: String
    # --target: the triple to build for, "" for the host
    targetTriple: String
    # --cflags: passed through to the C compile step
    cflags: String
    # --ldflags: passed through to the link step, which inproc does not have
    ldflags: String
    # --canon: `dump` writes the canonical model rather than SQL
    canon: bool
    # --release: build with optimisation
    release: bool
    # --save-temps: keep the generated C rather than removing it
    saveTemps: bool
    # --time: print the per-phase timings
    timed: bool
    # --fast-hash: the emitter's cheaper name hash
    fastHash: bool
    # --readable-names: emit source names rather than numbered ones
    readableNames: bool
    # --eager: typecheck every definition, not only what main reaches
    eagerCheck: bool
    # the arguments after `--`, which belong to the program and not to zc
    progArgs: List String
    # whether `--` has been seen
    inProgArgs: bool
} as {
    # takeProgArg -- once `--` has been seen, every remaining argument belongs
    # to the program rather than to zc.
    takeProgArg: function {:this w: u64 arg: String.view} out bool is {
        if this.inProgArgs then {
            this.progArgs.append from: arg.copy
            return true
        }
        if w != zcWord.slot.fProgArgs then return false
        this.inProgArgs = true
        return true
    }

    # setSwitch -- the flags that take no value. True when `w` named one.
    setSwitch: function {:this w: u64} out bool is {
        if w == zcWord.slot.fCanon then {
            this.canon = true
            return true
        }
        if w == zcWord.slot.fRelease then {
            this.release = true
            return true
        }
        if w == zcWord.slot.fSaveTemps then {
            this.saveTemps = true
            return true
        }
        if w == zcWord.slot.fTime then {
            this.timed = true
            return true
        }
        if w == zcWord.slot.fFastHash then {
            this.fastHash = true
            return true
        }
        if w == zcWord.slot.fReadableNames then {
            this.readableNames = true
            return true
        }
        if w == zcWord.slot.fEager then {
            this.eagerCheck = true
            return true
        }
        return false
    }

    # takePathFlag -- the flags naming a file or a directory.
    takePathFlag: function {
        :this
        # the argument's slot in zcWord
        w: u64
        argv: (List String).view
        i: u64
        n: u64
    } out argstep is {
        if w == zcWord.slot.fSrc then {
            this.srcdirs.append from: (flagValue :argv :i :n flagName: "--src")
            return (argstep taken: true at: i + 1)
        }
        if w == zcWord.slot.fSystem then {
            this.systemFlag = flagValue :argv :i :n flagName: "--system"
            return (argstep taken: true at: i + 1)
        }
        if w == zcWord.slot.fRuntime then {
            this.runtimeFlag = flagValue :argv :i :n flagName: "--runtime"
            return (argstep taken: true at: i + 1)
        }
        if w == zcWord.slot.fEmitC then {
            this.emitTarget = flagValue :argv :i :n flagName: "--emit-c"
            return (argstep taken: true at: i + 1)
        }
        if w == zcWord.slot.fDumpSql then {
            this.dumpSqlTarget = flagValue :argv :i :n flagName: "--dump-sql"
            return (argstep taken: true at: i + 1)
        }
        if w == zcWord.slot.fOut then {
            this.outPath = flagValue :argv :i :n flagName: "-o"
            return (argstep taken: true at: i + 1)
        }
        return (argstep taken: false at: i)
    }

    # takeToolFlag -- the flags naming the C toolchain and what to hand it.
    takeToolFlag: function {
        :this
        zv: zast.Vocab.view
        # the argument's slot in zcWord
        w: u64
        argv: (List String).view
        i: u64
        n: u64
    } out argstep is {
        if w == zcWord.slot.fCc then {
            this.ccFlag = flagValue :argv :i :n flagName: "--cc"
            return (argstep taken: true at: i + 1)
        }
        if w == zcWord.slot.fCcMode then {
            this.ccModeFlag = flagValue :argv :i :n flagName: "--cc-mode"
            refuseUnknownCcMode :zv mode: this.ccModeFlag.stringView named: "--cc-mode"
            return (argstep taken: true at: i + 1)
        }
        if w == zcWord.slot.fTccLib then {
            this.tccLibFlag = flagValue :argv :i :n flagName: "--tcc-lib"
            return (argstep taken: true at: i + 1)
        }
        if w == zcWord.slot.fTarget then {
            this.targetTriple = flagValue :argv :i :n flagName: "--target"
            return (argstep taken: true at: i + 1)
        }
        if w == zcWord.slot.fCflags then {
            this.cflags = flagValue :argv :i :n flagName: "--cflags"
            return (argstep taken: true at: i + 1)
        }
        if w == zcWord.slot.fLdflags then {
            this.ldflags = flagValue :argv :i :n flagName: "--ldflags"
            return (argstep taken: true at: i + 1)
        }
        return (argstep taken: false at: i)
    }

    # takeOperand -- an argument naming no flag: the unit, and after it (under
    # `run`) the program's own arguments.
    takeOperand: function {:this arg: String.view isRun: bool} is {
        if this.unitname.length == 0 then {
            this.unitname = arg.copy
            return
        }
        if isRun.not then return
        this.progArgs.append from: arg.copy
        this.inProgArgs = true
    }

    # unitIsPath -- the unit was named by its file (`hello.z`, `sub/hello`)
    # rather than by its name
    unitIsPath: function {this: this.view} out bool is {
        return (
            (this.unitname.stringView.endsWith suffix: ".z") or
            (this.unitname.stringView.contains needle: "/")
        )
    }

    # projectStart -- where the search for project.z begins: the directory of
    # a unit named by its file, else the working directory
    projectStart: function {this: this.view} out String is {
        if this.unitIsPath.not then return "."
        d: zcheck.dirname p: this.unitname.stringView
        if d.length == 0 then return "."
        return d
    }

    # applyProject -- each setting no flag gave, from project.z. A flag
    # replaces the file's value outright, and a unit named by its file is its
    # own source root; a switch the file turns on stays on. Paths the file gives
    # are relative to the project directory.
    applyProject: function {:this zv: zast.Vocab.view pf: zproject.ProjectFile.view} is {
        if pf.found.not then return
        if this.srcdirs.length == 0 when this.unitIsPath.not then {
            for each sr: pf.sourceRoots loop this.srcdirs.append from: sr.copy
        }
        if this.unitname.length == 0 then this.unitname = pf.main.copy
        this.applyProjectPaths :pf
        this.applyProjectTools :zv :pf
        if pf.release then this.release = true
        if pf.fastHash then this.fastHash = true
        if pf.readableNames then this.readableNames = true
        if pf.eager then this.eagerCheck = true
    }

    # applyProjectPaths -- the directories project.z gives, under the project
    # directory, where no flag gave one
    applyProjectPaths: function {:this pf: zproject.ProjectFile.view} is {
        d: pf.dir.stringView
        sys: zproject.inProject dir: d rel: pf.systemDir.stringView
        if this.systemFlag.length == 0 then this.systemFlag = sys.take
        rt: zproject.inProject dir: d rel: pf.runtimeDir.stringView
        if this.runtimeFlag.length == 0 then this.runtimeFlag = rt.take
        tl: zproject.inProject dir: d rel: pf.tccLibDir.stringView
        if this.tccLibFlag.length == 0 then this.tccLibFlag = tl.take
        # a project's executable goes to its own directory, as C's and Go's do,
        # wherever in it the build started; outputDir moves it
        this.outputDir = d.string
        if pf.outputDir.length > 0 then this.outputDir = (zproject.inProject
            dir: d
            rel: pf.outputDir.stringView
        )
    }

    # applyProjectTools -- the target and the C toolchain project.z names, where
    # no flag named them
    applyProjectTools: function {:this zv: zast.Vocab.view pf: zproject.ProjectFile.view} is {
        if this.targetTriple.length == 0 then this.targetTriple = pf.target.copy
        if this.ccFlag.length == 0 then this.ccFlag = pf.cCompiler.copy
        if this.ccModeFlag.length == 0 when pf.cCompilerMode.length > 0 then {
            this.ccModeFlag = pf.cCompilerMode.copy
            (refuseUnknownCcMode
                :zv
                mode: this.ccModeFlag.stringView
                named: "project.z's cCompilerMode"
            )
        }
        if this.cflags.length == 0 then this.cflags = pf.cFlags.copy
        if this.ldflags.length == 0 then this.ldflags = pf.linkFlags.copy
    }

    # buildFacts -- the values this build uses, after every flag, for the
    # generated z/build.z; the toolchain as resolved
    buildFacts: function {
        this: this.view
        systemdir: StringView
        cc: StringView
        ccMode: StringView
        tccDir: StringView
    } out zproject.BuildFacts is {
        f: (zproject.BuildFacts.create
            srcdirs: this.srcdirs
            :systemdir
            main: this.unitname.stringView
        )
        f.triple = this.targetTriple.copy
        f.outputDir = this.outputDir.copy
        f.release = this.release
        f.fastHash = this.fastHash
        f.readableNames = this.readableNames
        f.eager = this.eagerCheck
        f.cCompiler = cc.string
        f.cCompilerMode = ccMode.string
        f.cFlags = this.cflags.copy
        f.linkFlags = this.ldflags.copy
        f.tccLibDir = tccDir.string
        return f
    }

    # resolveRoots -- with no --src given, a unit named as a PATH supplies its
    # own root: the directory it sits in, with the bare stem as the unit name.
    # With no root either way, the current directory is one.
    resolveRoots: function {:this} is {
        if this.srcdirs.length == 0 when this.unitIsPath then {
            baseNoExt: stripDotZ p: this.unitname.stringView
            d: zcheck.dirname p: baseNoExt.stringView
            bn: baseName p: baseNoExt.stringView
            this.srcdirs.append from: d
            this.unitname = bn.take
        }
        if this.srcdirs.length == 0 then this.srcdirs.append from: ".".string
    }
}

# parseZcArgs -- every argument after the subcommand, read into a fresh
# ZcFlags: the print-and-stop flags first, then the switches, then the two
# groups of value-taking flags, and anything left is the unit or the program's
# own argument.
parseZcArgs: function {
    argv: (List String).view
    n: u64
    zv: zast.Vocab.view
    sub: StringView
    unitname: String.view
    isRun: bool
} out ZcFlags is {
    cf: (ZcFlags
        unitname: unitname.copy
        srcdirs: List String
        systemFlag: String
        runtimeFlag: String
        emitTarget: String
        dumpSqlTarget: String
        outPath: String
        outputDir: String
        ccFlag: String
        ccModeFlag: String
        tccLibFlag: String
        targetTriple: String
        cflags: String
        ldflags: String
        canon: false
        release: false
        saveTemps: false
        timed: false
        fastHash: false
        readableNames: false
        eagerCheck: false
        progArgs: List String
        inProgArgs: false
    )
    i: 2.u64
    for i < n loop {
        a: argv.get :i
        w: zv.slotOf text: a.stringView
        known: cf.takeProgArg :w arg: a
        if known.not then known = dispatchInlineVerb :zv :w :sub
        if known.not then known = cf.setSwitch :w
        if known.not then {
            sp: cf.takePathFlag :w :argv :i :n
            known = sp.taken
            i = sp.at
        }
        if known.not then {
            st9: cf.takeToolFlag :zv :w :argv :i :n
            known = st9.taken
            i = st9.at
        }
        if known.not then cf.takeOperand arg: a :isRun
        i = i + 1
    }
    return cf
}

# reportParseError -- a failed parse hands the tree back with the error as its
# root row: render it and stop.
reportParseError: function {
    prog: zast.Ast.view
    vfs: zvfs.ZVfs
    fallbackFsno: zvfs.fsno
} is {
    progRoot: prog.nodes.get i: prog.root
    match (
        progRoot
    ) case error then {
        emsg: (errorMessage
            e: (zast.errorDataOf ast: prog row: progRoot)
            :vfs
            ast: prog
            :fallbackFsno
        )
        io.eprintln emsg
    } else null
    io.eprintln "1 error found"
    os.exit code: 1
}

# reportTypeErrors -- render every type error and stop, the count last.
# Returns when the program typechecked.
reportTypeErrors: function {
    st: zenv.ZSymbolTable.view
    prog: zast.Ast.view
    vfs: zvfs.ZVfs
    mainFsno: zvfs.fsno
} is {
    nerr: st.typing.errors.length
    if nerr == 0 then return
    for each er: st.typing.errors loop {
        elx: errorMessage e: er :vfs ast: prog fallbackFsno: mainFsno
        io.eprintln elx
    }
    if nerr == 1 then {
        io.eprintln "1 error found"
    } else {
        summ: "\{nerr} errors found"
        io.eprintln summ
    }
    os.exit code: 1
}

# outTarget -- where an output goes: the flag that names it, else -o, else
# stdout.
outTarget: function {primary: StringView fallback: StringView} out String is {
    if primary.length > 0 then return primary.string
    if fallback.length > 0 then return fallback.string
    return "-"
}

# chooseExePath -- where a build writes its executable: a temporary under
# `run`, `-o` when it names one, else `<unit>` with the target's suffix in the
# project's output directory, or outside a project in the working directory.
chooseExePath: function {
    isRun: bool
    outPath: StringView
    outputDir: StringView
    unitname: StringView
    targetTriple: StringView
} out String is {
    if isRun then return (tempPath uname: unitname ext: ".bin")
    if outPath.length > 0 then return outPath.string
    e2: "./".string
    if outputDir.length > 0 then {
        io.mkdirp path: outputDir
        e2 = zcheck.joinPath a: outputDir b: ""
    }
    e2.append unitname
    e2.append (ztarget.targetExeSuffix triple: targetTriple)
    return e2
}

# refuseCrossTarget -- a cross target is only as real as the compiler resolved
# for it. `--cc` wins over the triple in pickCc, which is right for picking but
# meant nobody ever asked whether the two AGREE: --cc tcc --target
# x86_64-windows built a Linux ELF that printed `os=windows`. The
# evidence accepted is the compiler's own name -- a `<triple>-` prefixed
# driver, which is exactly what pickCc synthesises when no --cc is given, so
# the documented cross path passes unchanged.
refuseCrossTarget: function {targetTriple: StringView cc: StringView isTcc: bool} is {
    if (ztarget.targetIsHost triple: targetTriple) then return
    cb: baseName p: cc
    tp: targetTriple.string
    tp.append "-"
    if (cb.stringView.startsWith prefix: tp) then return
    if isTcc then {
        tt: "zc: --cc tcc cannot build for --target '\{targetTriple}'"
        io.eprintln tt
        io.eprintln "  the vendored tinycc is a host-only linux-x86_64 build: one backend, one config triple"
    } else {
        tc: "zc: '\{cc}' cannot build for --target '\{targetTriple}'"
        io.eprintln tc
        th: "  a cross build needs a compiler named '\{tp.stringView}gcc' or '\{tp.stringView}clang'"
        io.eprintln th
    }
    os.exit code: 2
}

# refuseInprocMisuse -- `--cc-mode inproc` means libtcc, so it means tcc.
# Rejecting the combination here rather than letting the mode quietly apply to
# a gcc build follows the rule everywhere: the resolved mode is the requested
# one, or it is an error.
refuseInprocMisuse: function {
    isTcc: bool
    cc: StringView
    ccTcc: StringView
    tccDir: StringView
    ldflags: StringView
} is {
    if isTcc.not then {
        nm: "zc: --cc-mode inproc needs a tcc compiler; --cc resolved to '\{cc}'"
        io.eprintln nm
        os.exit code: 2
    }
    if ccTcc.length == 0 then {
        nd: "zc: --cc-mode inproc found no tcc runtime payload at '\{tccDir}'; set --tcc-lib or ZEROLANG_TCC"
        io.eprintln nd
        os.exit code: 2
    }
    # --ldflags reaches a linker and inproc has none. Dropping them would make
    # the SAME command fail under spawn and succeed here; that divergence is
    # what this refusal stops.
    if ldflags.length > 0 then {
        nf: "zc: --ldflags '\{ldflags}' cannot be honoured under --cc-mode inproc"
        io.eprintln nf
        io.eprintln "  libtcc links through the state that compiled, so there is no link step to pass them to; use --cc-mode spawn"
        os.exit code: 2
    }
}

# reportBuildFailure -- 127 from either mode: os.spawn returns it when exec
# fails, tcc.compileToExe when libtcc will not load. One code, one report, with
# the path that was actually tried. Returns when the build succeeded.
reportBuildFailure: function {rc: i32 inproc: bool cc: StringView ccTcc: StringView} is {
    if rc == 0 then return
    if rc == 127 then {
        cmsg: "zc: could not run C compiler '\{cc}' (not found?); set --cc or install it"
        if inproc then cmsg = "zc: could not load libtcc from '\{ccTcc}/libtcc.so'; set --tcc-lib, or drop --cc-mode inproc to run tcc as a child process"
        io.eprintln cmsg
    }
    os.exit code: rc
}

# runBuiltProgram -- `zc run`: hand the program its own arguments, remove the
# executable, and exit with its status.
runBuiltProgram: function {exe: StringView progArgs: (List String).view} is {
    sargs: List String
    sargs.append from: exe.string
    for each pe: progArgs loop {
        sargs.append from: pe.copy
    }
    prc: os.spawn argv: sargs cwd: "" outPath: "" errPath: "" timeoutSecs: 0
    removeTemp path: exe
    os.exit code: prc
}

# buildAndRun -- the default output: write the C to a temporary, compile it
# with the resolved toolchain, and under `run` execute the result.
buildAndRun: function {
    cf: ZcFlags.view
    csrc: StringView
    libs: (List String).view
    cc: StringView
    ccMode: StringView
    tccDir: StringView
    isRun: bool
    zv: zast.Vocab.view
} is {
    tmpc: tempPath uname: cf.unitname.stringView ext: ".c"
    wrc: io.writeText path: tmpc content: csrc
    match (
        wrc
    ) case ok then null case err then {
        io.eprintln "zc: could not write temporary C"
        os.exit code: 1
    }
    exe: (chooseExePath
        :isRun
        outPath: cf.outPath.stringView
        outputDir: cf.outputDir.stringView
        unitname: cf.unitname.stringView
        targetTriple: cf.targetTriple.stringView
    )
    # -B goes to tcc and to nothing else: another compiler would reject it, and
    # a tcc that is not the one this tree ships has a payload of its own.
    # `--tcc-lib` overrides when both are present.
    ccTcc: String
    ccReal: ccRealPath name: cc
    cka: zemitterc.ccFamilyOf ccPath: ccReal.stringView
    isTcc: cka.tcc
    if isTcc when (io.exists path: tccDir) then ccTcc = tccDir.string
    refuseCrossTarget targetTriple: cf.targetTriple.stringView :cc :isTcc
    inproc: (zv.slotOf text: ccMode) == zcWord.slot.mInproc
    if inproc then (refuseInprocMisuse
        :isTcc
        :cc
        ccTcc: ccTcc.stringView
        :tccDir
        ldflags: cf.ldflags.stringView
    )
    rc: (buildExe
        :cc
        ccKind: cka
        tempC: tmpc.stringView
        exe: exe.stringView
        release: cf.release
        cflags: cf.cflags.stringView
        ldflags: cf.ldflags.stringView
        :libs
        tccDir: ccTcc.stringView
        :inproc
    )
    if cf.saveTemps then {
        kept: "zc: kept generated C at \{tmpc.stringView}"
        io.eprintln kept
    } else {
        removeTemp path: tmpc.stringView
    }
    reportBuildFailure :rc :inproc :cc ccTcc: ccTcc.stringView
    if isRun then runBuiltProgram exe: exe.stringView progArgs: cf.progArgs
}

# refuseBadTarget -- validated here, not at the flag, because `--target` and
# `--cc` are order independent and this is the first point where both are
# known. It runs for every subcommand: `zc env --target <garbage>` reported a
# cross compiler for a triple that means nothing, and `zc emit` folded the host
# into it.
refuseBadTarget: function {targetTriple: StringView} is {
    te: ztarget.targetTripleError triple: targetTriple
    if te.length == 0 then return
    tm: "zc: \{te.stringView}"
    io.eprintln tm
    os.exit code: 2
}

# zlinkLibsOf -- the libraries an emitted C file's `/* zlink: ... */` header
# names, which is where emitC records every library the program links.
zlinkLibsOf: function {csrc: StringView} out List String is {
    r: List String
    n: u64
    for each ln: csrc.lines loop {
        n = n + 1
        if n > 8 then break
        lo: ln.stripPrefix p: "/* zlink:"
        match (
            lo
        ) case some then {
            # the words up to the comment's close
            words: lo
            ce: lo.indexOf needle: "*/"
            match (
                ce
            ) case some then {
                words = lo.substring from: 0 to: ce
            } case none then null
            for each w: (words.split sep: " ") loop {
                if w.length > 0 then r.append from: w.string
            }
            return r
        } case none then null
    }
    return r
}

# emitCSource -- the C for the whole program, with any emitter refusal reported
# and the phase timings printed when --time asked for them. Both output paths
# that need C ask this, so they cannot drift apart.
emitCSource: function {
    prog: zast.Ast.view
    st: zenv.ZSymbolTable
    runtimeDir: StringView
    cf: ZcFlags.view
    libs: (List String).view
    ccFamily: zemitterc.ccfamily
    t0: i64
    t1: i64
    t2: i64
} out String is {
    emitErrs: List String
    csrc: (zemitterc.emitC
        program: prog
        symtab: st
        :runtimeDir
        fastHash: cf.fastHash
        readableNames: cf.readableNames
        errs: emitErrs
        :libs
        :ccFamily
        targetArch: (ztarget.targetOrHostArch triple: cf.targetTriple.stringView).stringView
    )
    failEmitErrors errs: emitErrs
    if cf.timed then printPhases :t0 :t1 :t2 t3: os.monotonicMillis
    return csrc
}

# applyProjectOrExit -- the project's settings under the flags, or, when its
# project.z cannot be read, the error and stop.
applyProjectOrExit: function {cf: ZcFlags zv: zast.Vocab.view pf: zproject.ProjectFile.view} is {
    if pf.error.length > 0 then {
        io.eprintln pf.error
        io.eprintln "1 error found"
        os.exit code: 2
    }
    cf.applyProject :zv :pf
}

# printEnvAndExit -- `zc env`: the resolved settings, then stop.
printEnvAndExit: function {cf: ZcFlags.view pf: zproject.ProjectFile.view} is {
    (printEnv
        project: pf.dir.stringView
        systemFlag: cf.systemFlag.stringView
        runtimeFlag: cf.runtimeFlag.stringView
        ccFlag: cf.ccFlag.stringView
        ccModeFlag: cf.ccModeFlag.stringView
        targetTriple: cf.targetTriple.stringView
        tccLibFlag: cf.tccLibFlag.stringView
    )
    os.exit code: 0
}

# mountBuild -- bind the build's roots into `vfs`: the stdlib, the generated
# `z` unit -- made from this build's values and written to disk for people
# and editors -- and the src roots. Answers the root a parse starts from.
mountBuild: function {
    vfs: zvfs.ZVfs
    cf: ZcFlags.view
    pf: zproject.ProjectFile.view
    systemdir: StringView
    cc: StringView
    ccMode: StringView
    tccDir: StringView
} out zvfs.fsno is {
    facts: cf.buildFacts :systemdir :cc :ccMode :tccDir
    layer: zproject.zLayer :pf :facts
    zproject.writeLayer :layer
    roots: zcheck.buildRoots :vfs :systemdir srcdirs: cf.srcdirs :layer
    return roots.root
}

# CLI entry point: read the verbs answered before any flag, parse the rest of
# the command line, then produce what the subcommand and the flags asked for --
# C, a model dump, or a native executable, run when `run` asked for it.
main: function is {
    argv: os.args
    n: argv.length
    if n < 2 then {
        printUsage
        os.exit code: 2
    }
    arg1: (argv.get i: 1).copy
    zv: zast.Vocab.create block: zcWord
    w1: zv.slotOf text: arg1.stringView
    dispatchHelpVerb :argv :n :zv w: w1
    dispatchToolVerb :argv :n w: w1
    sub: String
    subW: zv.none
    unitname: String
    if (isPipelineVerb w: w1) then {
        sub = arg1.copy
        subW = w1
    } else {
        unitname = arg1.copy
    }
    isRun: subW == zcWord.slot.vRun
    cf: parseZcArgs :argv :n :zv sub: sub.stringView :unitname :isRun
    pf: zproject.discoverProject start: cf.projectStart.stringView
    applyProjectOrExit :cf :zv :pf
    refuseBadTarget targetTriple: cf.targetTriple.stringView
    if subW == zcWord.slot.vEnv then printEnvAndExit :cf :pf
    mode: (resolveOutMode
        sub: sub.stringView
        :subW
        unitname: cf.unitname.stringView
        canon: cf.canon
        emitTarget: cf.emitTarget.stringView
        dumpSqlTarget: cf.dumpSqlTarget.stringView
    )
    if cf.unitname.length == 0 then {
        io.eprintln "zc: no unit specified"
        os.exit code: 2
    }
    cf.resolveRoots
    systemdir: zcheck.resolveSystemDir flagVal: cf.systemFlag.stringView
    runtimeDir: zcheck.resolveRuntimeDir flagVal: cf.runtimeFlag.stringView
    # resolved BEFORE the parse: the generated `z` unit records the toolchain
    # in its header, and is written before the build begins. The build branch
    # below reuses this rather than resolving a second time.
    ccPath: (zcheck.pickCc
        ccFlag: cf.ccFlag.stringView
        targetTriple: cf.targetTriple.stringView
    )
    # resolved here for the same reason: the payload directory belongs to the
    # compiler choice, and the build branch below reuses this rather than
    # resolving a second time.
    tccDir: zcheck.resolveTccDir flagVal: cf.tccLibFlag.stringView
    ccMode: zcheck.pickCcMode modeFlag: cf.ccModeFlag.stringView
    tParse0: os.monotonicMillis
    rootCause: zcheck.missingRootCause systemdir: systemdir.stringView srcdirs: cf.srcdirs
    if rootCause.length > 0 then {
        io.eprintln "zc: \{rootCause}"
        os.exit code: 2
    }
    vfs: zcheck.newVfs
    rootid: (mountBuild
        :vfs
        :cf
        :pf
        systemdir: systemdir.stringView
        cc: ccPath.stringView
        ccMode: ccMode.stringView
        tccDir: tccDir.stringView
    )
    p: zparser.Parser.create
    prog: p.parse :vfs :rootid mainUnitName: cf.unitname
    tParse1: os.monotonicMillis
    mfn: "\{cf.unitname.stringView}.z"
    mainFsno: vfs.walk parent: rootid name: mfn.stringView
    # a dump introspects the unit rather than building it, so it asks for no
    # entry point -- the one command that reads the model instead of emitting it
    wantRows: mode.dumpsql or mode.dumpcanon
    # a failed parse hands back the tree with the error as its root row. The
    # test is a call, not a binding, so no shared lock on `prog.nodes` outlives
    # it -- typecheck below takes the tree exclusively.
    if (zast.isErrorAt ast: prog id: prog.root) then {
        reportParseError :prog :vfs fallbackFsno: mainFsno
    }
    reg: ztypes.newRegistry
    st: (ztypecheck.typecheck
        program: prog
        :reg
        eager: cf.eagerCheck
        requireMain: wantRows.not
        dumpRows: wantRows
    )
    checkStart: os.monotonicMillis
    reportTypeErrors :st :prog :vfs :mainFsno
    if mode.dumpcanon then {
        canonOut: zsqldump.dumpCanon program: prog symtab: st
        tgt2: outTarget primary: "" fallback: cf.outPath.stringView
        writeOut :zv target: tgt2.stringView content: canonOut.stringView what: "canonical dump"
        return
    }
    if mode.dumpsql then {
        sql: zsqldump.dumpSql program: prog :vfs symtab: st
        tgt3: (outTarget
            primary: cf.dumpSqlTarget.stringView
            fallback: cf.outPath.stringView
        )
        writeOut :zv target: tgt3.stringView content: sql.stringView what: "SQL dump"
        return
    }
    emitLibs: ztypecheck.requiredLibs :st program: prog
    ccReal0: ccRealPath name: ccPath.stringView
    csrc: (emitCSource
        :prog
        :st
        runtimeDir: runtimeDir.stringView
        :cf
        libs: emitLibs
        ccFamily: (zemitterc.ccFamilyOf ccPath: ccReal0.stringView)
        t0: tParse0
        t1: tParse1
        t2: checkStart
    )
    if mode.emitc then {
        tgt: outTarget primary: cf.emitTarget.stringView fallback: cf.outPath.stringView
        writeOut :zv target: tgt.stringView content: csrc.stringView what: "C output"
        return
    }
    # the link line is the artifact's own: the reached units' libraries, the
    # ones the C backend added among them
    linkLibs: zlinkLibsOf csrc: csrc.stringView
    (buildAndRun
        :cf
        csrc: csrc.stringView
        libs: linkLibs
        cc: ccPath.stringView
        ccMode: ccMode.stringView
        tccDir: tccDir.stringView
        :isRun
        :zv
    )
}
