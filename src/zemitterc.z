    )
    if dtid9.isZero then return "".string
    isData: ctx.dataElems.has key: (ztypes.tid.create from: dtid9.u64)
    if (isData) == false then return "".string
    if mn.stringview == "index" then {
        ax: "0".string
        aiter: call.arguments.iterate
        for aId9: aiter loop {
            a: ast.nodes.get i: aId9.u64
            match (
                a
            ) case namedoperation then {
                opf79: ast.nodes.get i: a.operation.u64
                ax = emitExpr :ast :symtab :ctx n: opf79
            } else null
        }
        dsym0: ctxCname :ctx tid: (ztypes.tid.create from: dtid9.u64)
        e0: "\{dsym0}[\{ax}]"
