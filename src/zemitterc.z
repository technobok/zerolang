    if fpfc9.length > 0 then return fpfc9
    imc9: emitInstanceMethodCall :ast :symtab :ctx :call
    if imc9.length > 0 then return imc9
    if fid > 0 then {
        fc: ctxCname :ctx tid: fid
        fpNames: (List String)
