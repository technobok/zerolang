    cuct: emitCrossUnitCtor :ast :symtab :ctx :call
    if cuct.length > 0 then return cuct
    bxc9: emitBoxCreate :ast :symtab :ctx :call
    if bxc9.length > 0 then return bxc9
    cn0: atomTextOf :ast n: (ast.nodes.get i: call.callable.u64)
    ecc9: emitEmptyColCreate :ast :symtab :ctx :call cn0: cn0.stringview
    if ecc9.length > 0 then return ecc9
    fid: userFnId :ast :symtab :ctx name: cn0.stringview
    if fid.isZero then {
