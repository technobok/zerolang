        if brid > 0 when (symtab.reg.typetypeOf typeId: brid) == ztypes.ztypetype.recordType then {
            btn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: brid.u64)
            cTypeLk1: (scalarCTypeFor
                :symtab
                name: btn.stringview
                tid: (ztypes.tid.create from: brid.u64)
