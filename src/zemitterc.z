        return (outerBaseAtomId :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (dottedBaseAtomId :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}

outerBaseAtom: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (outerBaseAtom :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (dottedBaseAtom :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

