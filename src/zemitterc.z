        } else null
    }
    if mn.stringview == "append" then {
        # The StringLike arg lowers to (data, length) by its concrete type:
        # an owned String reads .data/.size (through the pointer for a
        # borrowed param); a StringView reads .data/.length.
        if argTid9 == ctx.strTid then {
            aph9: (hoistBorrowValArg
                :ast
                :symtab
                :ctx
                av: argval.stringview
                pid: ctx.strTid
                paramTake: false
                isBorrow: argBor9
            )
            if aph9.length > 0 then argval = aph9
            aacc9: "."
            if argPtr9 then aacc9 = "->"
            rapps: "\{ctx.strC}_append(\{recvAddr}, (\{argval})\{aacc9}data, (\{argval})\{aacc9}size)"
            return rapps
        }
        rapp: "\{ctx.strC}_append(\{recvAddr}, (\{argval}).data, (\{argval}).size)"
        return rapp
    }
    r: "\{ctx.strC}_\{nativeM}(\{recvAddr}, \{argval})"
    return r
}

# isNonLvalueArg -- true when an emitted arg expression is a non-addressable
# rvalue (a call/cast result, e.g. `String_from_view(...)`) so `&expr` is invalid
# C and the arg must be hoisted to a named temp first. A deref projection
# `(*__borrow_x)` IS an lvalue, so it is excluded.
isNonLvalueArg: function {s: StringView} out bool is {
    if (s.contains needle: "(") == false then return false
    if (s.startsWith prefix: "(*") then return false
    return true
}

# flushArgHoists -- emit the `String_t _ahN = <rvalue>;` declarations recorded by
# emitInstanceMethodCall for borrow-String args that needed `&` on a non-lvalue.
# Called at statement level (which holds ind/tmp/buf) right after the call
# expression is built; registers each temp for scope-exit free.
# `floor`/`rawFloor` mark pending hoists that belong to an ENCLOSING scope: a
# string interpolation used as a value emits into its own `({ ... })` buffer, and
# declaring a sibling argument's temp in there produces C that gcc rejects with
# `_ahN undeclared`. Everything below the floor stays pending for the outer flush.
flushArgHoists: function {
    ctx: Ctx
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    floor: 0.u64
    rawFloor: 0.u64
} is {
    i: floor
    n: ctx.argHoistNames.length
    for i < n loop {
        nmo: ctx.argHoistNames.get :i
        vlo: ctx.argHoistVals.get :i
        cty: ctx.argHoistTypes.get :i
        decl: "\{ind}\{cty} \{nmo} = \{vlo};\n"
        buf.append decl
        dto: ctx.argHoistDtors.get :i
        if dto.length > 0 then {
            dtc: dto.copy
            tmp.listFrees.append dtc
            tmp.listFreeVars.append nmo.copy
            tmp.listFreeRaw.append (ztypes.vid.create from: 0)
        }
        i = i + 1
    }
    ri9: rawFloor
    rn9: ctx.argHoistRaw.length
    for ri9 < rn9 loop {
        rdo9: ctx.argHoistRaw.get i: ri9
        buf.append rdo9
        ri9 = ri9 + 1
    }
    # drop what was just emitted, back to the floor -- not to empty
    for ctx.argHoistNames.length > floor loop {
        ctx.argHoistNames.pop
        ctx.argHoistVals.pop
        ctx.argHoistTypes.pop
        ctx.argHoistDtors.pop
    }
    for ctx.argHoistRaw.length > rawFloor loop ctx.argHoistRaw.pop
}

# pushLoopLabel -- allocate a unique break-target label for a loop and push it.
# A zerolang `break` inside the loop emits `goto __zbrk_<id>`: a bare C `break`
# would only leave an enclosing match->switch, not the loop. The label is
# emitted after the loop by popLoopLabel, but only if a break referenced it.
pushLoopLabel: function {ctx: Ctx tmp: TmpCtr.view isDo: bool} out u64 is {
    id: ctx.breakLabelCtr
    ctx.breakLabelCtr = id + 1
    ctx.breakLabels.append id
    isDoC9: isDo
    ctx.breakLabelIsDo.append isDoC9
    ctx.breakFreesMarks.append tmp.frees.length
    ctx.breakListMarks.append tmp.listFrees.length
    cl9: String
    ctx.breakLabelCleanup.append cl9
    cv9: String
    ctx.breakLabelCleanupVar.append cv9
    cvr9: ztypes.vid
    ctx.breakLabelCleanupRaw.append cvr9
    return ctx.breakLabelCtr - 1
}

# emitContLabel -- the loop-body continue target: a `continue` inside a
# do{}while(0) wrapper jumps here (past the wrapper, before the loop's
# closing brace so the increment/condition re-evaluates). Emitted only
# when a continue referenced it.
emitContLabel: function {ctx: Ctx.view id: u64 ind: StringView buf: String.borrow} is {
    uo: ctx.contLabelUsed.get key: id
    match (
        uo
    ) case some then {
        lbl9: "\{ind}__zcont_\{id}: ;\n"
        buf.append lbl9
    } case none then null
}

# emit the C label that closes loop `id`.
popLoopLabel: function {ctx: Ctx id: u64 ind: StringView buf: String.borrow} is {
    if ctx.breakLabels.length > 0 then ctx.breakLabels.pop
    if ctx.breakLabelIsDo.length > 0 then ctx.breakLabelIsDo.pop
    if ctx.breakFreesMarks.length > 0 then {
        ctx.breakFreesMarks.pop
        ctx.breakListMarks.pop
    }
    if ctx.breakLabelCleanup.length > 0 then {
        ctx.breakLabelCleanup.pop
        ctx.breakLabelCleanupVar.pop
        ctx.breakLabelCleanupRaw.pop
    }
    uo: ctx.breakLabelUsed.get key: id
    match (
        uo
    ) case some then {
        lbl9: "\{ind}__zbrk_\{id}: ;\n"
        buf.append lbl9
    } case none then null
}

# emitInstanceMethodCall -- `recv.method args` on a user CLASS instance (not a
# Type qualifier, not a collection / system native): emit
# {methodCname}(&recv, posArgs) with the receiver mapped to the :this param and
# the explicit args reordered by the method's param labels. "" when the receiver
# is not a user class or the method is unresolved.
# methodOwnerId -- the type id that actually owns method `mn`. A cross-unit
# receiver may be stamped a same-named SHELL id whose childOf lacks the method;
# scan for the same-named type that has it (emitter twin of canonicalChildBase).
methodOwnerId: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    rtid: ztypes.tid
    mn: StringView
} out u64 is {
    direct: symtab.typing.declChildOf pool: ast.names parentTypeId: rtid name: mn
    match (
        direct
    ) case some then {
        return rtid
    } case none then null
    rn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: rtid.u64)
    if rn.length == 0 then return rtid
    last: symtab.reg.nextTypeId
    t: ztypes.tid
    for t < last loop {
        tn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: t.u64)
        if tn.stringview == rn.stringview then {
            co: symtab.typing.declChildOf pool: ast.names parentTypeId: t name: mn
            match (
                co
            ) case some then {
                return t.u64
            } case none then null
        }
        t = ztypes.tid.create from: (t + 1)
    }
    return rtid
}

# hoistBorrowValArg -- a by-value call argument that is an owned, destructible,
# non-lvalue temporary (e.g. a `Map.get` Option result) handed to a borrow param
# (not paramTake) is freed by neither side. Hoist it into a temp registered
# for scope-exit destroy (mirrors the by-ref `&`-hoist) and return the temp name;
# "" when no hoist is needed. `av` is borrowed -- the caller keeps ownership.
hoistBorrowValArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    av: StringView
    pid: ztypes.tid
    paramTake: bool
    isBorrow: bool
} out String is {
    if (isNonLvalueArg s: av) == false then return "".string
    if paramTake then return "".string
    vrid: pid
    vduo: definedInUnitOf :symtab tid: (ztypes.tid.create from: pid.u64)
    match (
        vduo
    ) case none then {
        vtn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: pid.u64)
        vrr: (canonTypeId
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: pid.u64)
            name: vtn.stringview
        )
        if vrr > 0 then vrid = ztypes.tid.create from: vrr.u64
    } case some then null
    isStrH9: vrid == ctx.strTid
    if (isStrH9) == false when (symtab.reg.hasDestructorName typeId: vrid) == false then {
        return "".string
    }
    vhn: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    vnmh: "_ah\{vhn}"
    vcty: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: pid.u64) thisTid: ztypes.tid
    vcb: ctxCname :ctx tid: (ztypes.tid.create from: vrid.u64)
    vdt: "    \{vcb}_destroy(&\{vnmh});\n"
    if isStrH9 then vdt = "    \{ctx.strC}_free(&\{vnmh});\n"
    # a borrow-returning call result is a shared view: hoist for
    # lvalue-ness only, never destroy
    if isBorrow then vdt = "".string
    avc: av.string
    ctx.argHoistVals.append avc
    ctx.argHoistTypes.append vcty.copy
    ctx.argHoistDtors.append vdt
    ctx.argHoistNames.append vnmh.copy
    return vnmh
}

# hoistLvalue9 -- bind an expression to a temp so its ADDRESS can be taken. The
# sv-native legs pass `&receiver`, and a receiver that is itself a call is not an
# lvalue: C rejects `&f(x)`. This is hoistBorrowValArg's isBorrow leg generalised
# to a type that carries no destructor at all -- a StringView owns nothing, so
# the temp is bound and never freed. The caller decides addressability; a
# compound literal already is one and must not come here (it would cost a temp
# for nothing, and every program emitting one would move).
hoistLvalue9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    av: StringView
    tid: ztypes.tid
} out String is {
    vhn9: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    vnm9: "_ah\{vhn9}"
    vcty9: typeRefC :ast :symtab :ctx :tid thisTid: ztypes.tid
    ctx.argHoistVals.append av.string
    ctx.argHoistTypes.append vcty9.copy
    ctx.argHoistDtors.append "".string
    ctx.argHoistNames.append vnm9.copy
    return vnm9
}

# svBinopOperand9 -- the `&view` form of one string operand of `+`. A plain
# atom or a pooled literal addresses directly. An owned String that is not an
# lvalue -- the inner `+` of a chain -- must HOIST first: svValueForm reads its
# expression twice, once for `.data` and once for `.size`, and a concat spelled
# twice allocates twice and leaks both. A non-lvalue StringView is the shape the
# sv-native call path already cannot address (`a.trim.concat other: b` reports
# the same `lvalue required` today), so it is left to say so rather than given a
# second answer here.
svBinopOperand9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: Node.view
    expr: StringView
    tname: StringView
} out String is {
    src9: expr.string
    if (isNonLvalueArg s: expr) then {
        hv9: (hoistBorrowValArg
            :ast
            :symtab
            :ctx
            av: expr
            pid: (stampIdDeep :ast :symtab :n)
            paramTake: false
            isBorrow: false
        )
        if hv9.length > 0 then src9 = hv9.copy
    }
    vid9: atomVidIfPlain :ast :symtab :ctx :n text: src9.stringview
    vf9: svValueForm :ctx expr: src9.stringview isStr: (tname == "String") vid: vid9
    r9: "&\{vf9}"
    return r9
}

# emit a call to an instance method.
emitInstanceMethodCall: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    call: zast.CallData.view
} out String is {
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if mn.length == 0 then return "".string
    xq179: ast.nodes.get i: call.callable.u64
    recvExpr: emitDottedReceiver :ast :symtab :ctx callable: xq179
    if recvExpr.length == 0 then return "".string
    rtid0: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: call.callable.u64)
    rtidc: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: rtid0.u64)
    rtid: methodOwnerId :ast :symtab rtid: (ztypes.tid.create from: rtidc.u64) mn: mn.stringview
    if rtid == 0 then return "".string
    # Both families reach here: a user record's methods take their receiver by
    # pointer too, so they need the same receiver-addressing logic below. The
    # stdlib units are still excluded further down -- they have dedicated
    # dispatchers.
    rttK9: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: rtid.u64)
    isUserObj9: false
    if rttK9 == ztypes.ztypetype.classType then isUserObj9 = true
    if rttK9 == ztypes.ztypetype.recordType then isUserObj9 = true
    if rttK9 == ztypes.ztypetype.variantType then isUserObj9 = true
    if rttK9 == ztypes.ztypetype.facetType then isUserObj9 = true
    if (isUserObj9) == false then return "".string
    monoLk2: originTidOf :symtab tid: (ztypes.tid.create from: rtid.u64)
    if monoLk2 > 0 then {
        if (isUserClassMonoTid
            :symtab
            :ctx
            tid: (ztypes.tid.create from: rtid.u64)
        ) == false then return "".string
    }
    # system natives (String/StringView/io/cli/os) have dedicated dispatchers.
    rdu9: definedInUnitOf :symtab tid: (ztypes.tid.create from: rtid.u64)
    match (
        rdu9
    ) case some then {
        if rdu9.stringview == "system" then return "".string
        if rdu9.stringview == "collections" then return "".string
        if rdu9.stringview == "io" then return "".string
        if rdu9.stringview == "cli" then return "".string
        if rdu9.stringview == "os" then return "".string
    } case none then null
    mco9: (symtab.typing.declChildOf
        pool: ast.names
        parentTypeId: (ztypes.tid.create from: rtid.u64)
        name: mn.stringview
    )
    match (
        mco9
    ) case some then {
        if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: mco9.u64)) == ztypes.ztypetype.functionType then {
            xq169: ast.nodes.get i: call.callable.u64
            rptr9: dottedReceiverIsPtr :ast :symtab :ctx callable: xq169
            mcn9: ctxCname :ctx tid: (ztypes.tid.create from: mco9.u64)
            pnames: (List String)
            pids: (ListVal u64)
            pidsNm: (ListVal u64)
            (recFieldLists
                :ast
                :symtab
                tid: (ztypes.tid.create from: mco9.u64)
                names: pnames
                ids: pids
                nameIds: pidsNm
            )
            # The receiver slot is identified by the method's receiver param name
            # (`this` for the `:this` shorthand, or the spelled name for a
            # `b: this.lock` receiver) -- matching how the definition site names
            # it. Matching the literal "this" alone drops a renamed receiver.
            recvNm9: "this".string
            {
                tpnm9: (zast.poolTextCopy
                    pool: ast.names
                    ref: (symtab.reg.thisParamNameIdOf tid: (ztypes.tid.create from: mco9.u64))
                )
                if tpnm9.length > 0 then recvNm9 = tpnm9
            }
            args: String
            posIdx9: u64
            pi9: u64
            pn9: pnames.length
            for pi9 < pn9 loop {
                pname9: pnames.get i: pi9
                pid9: pids.get i: pi9
                if pi9 > 0 then args.append ", "
                if pname9.stringview == recvNm9.stringview then {
                    if rptr9 then {
                        args.append recvExpr
                    } else {
                        ra9: "&\{recvExpr}"
                        args.append ra9
                    }
                } else {
                    isLbl9b: ctorHasLabel :ast :call label: pname9.stringview
                    iiVal9: String
                    if isLbl9b then {
                        iiVal9 = (ctorInterpArgByLabel
                            :ast
                            :symtab
                            :ctx
                            :call
                            label: pname9.stringview
                            fid: (ztypes.tid.create from: mco9.u64)
                            pname: pname9.stringview
                            pid: pid9
                        )
                    } else {
                        iiVal9 = (ctorInterpArgByPosition
                            :ast
                            :symtab
                            :ctx
                            :call
                            idx: posIdx9
                            fid: (ztypes.tid.create from: mco9.u64)
                            pname: pname9.stringview
                            pid: pid9
                        )
                    }
                    av9: String
                    avBor9: false
                    usedInterp9: false
                    # the argument's value node, so the pointer check below asks
                    # about the variable rather than the emitted text. An
                    # interpolated argument is a statement expression, never a
                    # variable, so it leaves this 0.
                    avNd9: u64
                    if iiVal9.length > 0 then {
                        av9 = iiVal9
                        usedInterp9 = true
                        if (isLbl9b) == false then posIdx9 = posIdx9 + 1
                    } else {
                        av9 = ctorArgByLabel :ast :symtab :ctx :call label: pname9.stringview
                        avBor9 = ctorArgIsBorrow :ast :symtab :ctx :call label: pname9.stringview
                        avNd9 = ctorArgNodeByLabel :ast :call label: pname9.stringview
                        if (isLbl9b) == false then {
                            pv9: ctorArgByPosition :ast :symtab :ctx :call idx: posIdx9
                            if pv9.length > 0 then {
                                av9 = pv9
                                avBor9 = ctorArgIsBorrowPos :ast :symtab :ctx :call idx: posIdx9
                                avNd9 = ctorArgNodeByPosition :ast :call idx: posIdx9
                            }
                            posIdx9 = posIdx9 + 1
                        }
                    }
                    avq9: ztypes.vid
                    if avNd9 > 0 then {
                        avq9 = (atomVidIfPlain
                            :ast
                            :symtab
                            :ctx
                            n: (ast.nodes.get i: avNd9)
                            text: av9.stringview
                        )
                    }
                    ptra9: false
                    isStrBorrow9: false
                    # a non-TAKE class arg passes by pointer (mirrors the method
                    # signature); isReftypeParam resolves a cross-unit class shell that
                    # a bare typetypeOf==CLASS check misses.
                    pTake9: (symtab.typing.declOwnershipIs
                        pool: ast.names
                        parentTypeId: (ztypes.tid.create from: mco9.u64)
                        name: pname9.stringview
                        own: ztypes.zparamownership.takeMode
                    )
                    isRef9: false
                    if pTake9 == false then {
                        if (isReftypeParam
                            :ast
                            :symtab
                            :ctx
                            tid: (ztypes.tid.create from: pid9.u64)
                        ) then isRef9 = true
                    }
                    if isRef9 then {
                        ptra9 = true
                    } else {
                        if (isBorrowStringParam
                            :ast
                            :symtab
                            fid: (ztypes.tid.create from: mco9.u64)
                            pname: pname9.stringview
                            pid: (ztypes.tid.create from: pid9.u64)
                        ) then {
                            ptra9 = true
                            isStrBorrow9 = true
                        }
                    }
                    if (ptra9) == false then {
                        if (isListPtrParam
                            :ast
                            :symtab
                            :ctx
                            fid: (ztypes.tid.create from: mco9.u64)
                            pname: pname9.stringview
                            tid: (ztypes.tid.create from: pid9.u64)
                        ) then ptra9 = true
                    }
                    if usedInterp9 then ptra9 = false
                    byref9: false
                    if ptra9 then {
                        if (isPtrVid :ctx vid: avq9) == false then byref9 = true
                    }
                    if byref9 then {
                        if (isNonLvalueArg s: av9.stringview) then {
                            # `&` of a non-lvalue (a call result) is invalid C: hoist
                            # to a typed temp + destroy at block exit, mirroring the
                            # reference (`T _t = expr; f(&_t); T_destroy(&_t)`).
                            hn9: ctx.argHoistCtr
                            ctx.argHoistCtr = ctx.argHoistCtr + 1
                            nmH9: "_ah\{hn9}"
                            hcty9: (typeRefC
                                :ast
                                :symtab
                                :ctx
                                tid: (ztypes.tid.create from: pid9.u64)
                                thisTid: ztypes.tid
                            )
                            htyc9: hcty9.copy
                            hdt9: String
                            if isStrBorrow9 when (avBor9) == false then {
                                hdt9 = "    \{ctx.strC}_free(&\{nmH9});\n"
                            } else if (avBor9) == false then {
                                hrid9: pid9
                                hduo9: (definedInUnitOf
                                    :symtab
                                    tid: (ztypes.tid.create from: pid9.u64)
                                )
                                match (
                                    hduo9
                                ) case none then {
                                    htn9: (typeNameOfReg9
                                        :symtab
                                        tid: (ztypes.tid.create from: pid9.u64)
                                    )
                                    hrr9: (resolveTypeIdByName
                                        :ast
                                        :symtab
                                        :ctx
                                        name: htn9.stringview
                                    )
                                    if hrr9 > 0 then hrid9 = hrr9
                                } case some then null
                                if (symtab.reg.hasDestructorName typeId: (ztypes.tid.create from: hrid9.u64)) then {
                                    hcb9: ctxCname :ctx tid: (ztypes.tid.create from: hrid9.u64)
                                    hdt9 = "    \{hcb9}_destroy(&\{nmH9});\n"
                                }
                            }
                            abh9: "&\{nmH9}"
                            args.append abh9
                            ctx.argHoistVals.append av9
                            ctx.argHoistTypes.append htyc9
                            ctx.argHoistDtors.append hdt9
                            ctx.argHoistNames.append nmH9
                        } else {
                            ab9: "&\{av9}"
                            args.append ab9
                        }
                    } else {
                        vbhm9: String
                        if (ptra9) == false when (usedInterp9) == false then {
                            vbhm9 = (hoistBorrowValArg
                                :ast
                                :symtab
                                :ctx
                                av: av9.stringview
                                pid: (ztypes.tid.create from: pid9.u64)
                                paramTake: pTake9
                                isBorrow: avBor9
                            )
                        }
                        if vbhm9.length > 0 then {
                            args.append vbhm9
                        } else {
                            args.append av9
                        }
                    }
                }
                pi9 = pi9 + 1
            }
            r9: "\{mcn9}(\{args})"
            return r9
        }
    } case none then null
    return "".string
}

# collectionValueCallRhs -- the binding RHS is a value-producing expression
# returning a collection (a call to a user function/method, or a bare dotted-path
# no-arg method auto-call / field access), as opposed to a collection construction
# (`(List of: T)` / `(Set ...)` / `(Map ...)` calls, or a bare typedef-collection
# atom like `Bytes` / `ByteView`). A value call must be emitted as the call;
# constructions emit the binding's mono create. Used by the List/Set/Map binding
# branches to choose between emitting the RHS expression and an empty create.
# A construction is recognised by its stamped callKind, not the written head
# name, so a re-export alias of a container constructs like its target.
collectionValueCallRhs: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: Node.view
} out bool is {
    match (
        n
    ) case expression then {
        return (collectionValueCallRhs :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (collectionValueCallRhs :ast :symtab n: (ast.nodes.get i: n.statementline.u64))
    } case dottedpath then {
        # a bare dotted path returning a collection (e.g. `st.allNames`) is a
        # no-arg method auto-call or field access -- a value, never a construction.
        atc9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        return atc9.length > 0
    } case atomid then {
        # a bare name resolving to a VARIABLE is that container's value -- a
        # move. A bare TYPE atom (`Bytes`, `ByteView`) is a construction, so the
        # variable stamp is what separates them.
        cav9: symtab.typing.atomVariableId.get key: n.nodeid.u64
        match (
            cav9
        ) case some then {
            return true
        } case none then null
        return false
    } case call then {
        cko9: symtab.typing.callKind.get key: n.nodeid.u64
        match (
            cko9
        ) case some then {
            if cko9 == zast.callkind.classCreate then return false
            if cko9 == zast.callkind.typedefCreate then return false
        } case none then null
        cn: atomTextOf :ast n: (ast.nodes.get i: n.callable.u64)
        if cn.length == 0 then {
            # a dotted-path method callable (e.g. `p.operationPaths lex: lx`)
            # returning a List is a value-producing call, not a construction --
            # emit the call rather than falling to the empty-collection default.
            dct9: dottedChildText :ast n: (ast.nodes.get i: n.callable.u64)
            return dct9.length > 0
        }
        return true
    } else {
        return false
    }
}

# bindingRhsIsBorrow -- the binding RHS yields a non-owning borrow, so the bound
# String local must NOT be freed at scope exit (its owner -- the list or the
# struct -- frees it; a premature free is a use-after-free / double-free). Two
# shapes: a `<list>.get i:` over a List/ListView (a shallow element view), and a
# plain field access `<base>.<field>` (the field's String is owned by `<base>`).
# A no-arg method call (the child resolves to a FUNCTION) returns an owned value
# and is NOT a borrow. (Map.get returns an owned Option, handled elsewhere;
# `.copy` / `.string` / `.take` are owned and handled before this check.)
funcBorrowFlag: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    g9: symtab.typing.funcReturnsBorrow.get key: tid
    match (
        g9
    ) case some then {
        return g9
    } case none then {
        return false
    }
}

# fnReturnsRefBorrow9 -- the function hands back a REFERENCE to a user reftype:
# its declared return carries `.borrow`/`.view` and names a reftype. Such a
# return is a `T*` in C -- returning the struct by value hands the caller a COPY,
# so a write through it is silently lost.
#
# Natives are excluded deliberately. `String` is a reftype and `is native`
# (lib/system/system.z:590), and `out String.borrow` already works: the struct
# copy shares the buffer and the borrow legs suppress the free. Natives hand back
# interior pointers by their own rules -- `List.get`'s `_r.data = &...` -- so
# starring them would ripple through every caller for no correctness gain.
# `retTid` is the caller's already-resolved return type: the registry's
# returnTypeOf is 0 for a user method, so both signature emitters fall back to
# isColGetMutRef9 -- `fid` is a List/ListView mono's `getMut` whose element is a
# COMPOUND VALTYPE, i.e. the one case where emitColGet's generated `getMut`
# returns a pointer that `get` does not.
isColGetMutRef9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    fid: ztypes.tid
} out bool is {
    ownG9: symtab.reg.ownerTidOf tid: fid
    if ownG9.isZero then return false
    isLG9: false
    if (isListOriginOf :symtab :ctx tid: ownG9) then isLG9 = true
    if (isListViewOriginOf :symtab :ctx tid: ownG9) then isLG9 = true
    if (isLG9) == false then return false
    if (regNameIs :symtab tid: fid name: "getMut") == false then return false
    eG9: listElemType :symtab monoId: ownG9
    if (elemBorrowsByPtr :ast :symtab :ctx tid: (ztypes.tid.create from: eG9.u64)) then return false
    return (elemRefByPtr :ast :symtab :ctx tid: (ztypes.tid.create from: eG9.u64))
}

# the AST (fnReturnTypeId) and pass the result in rather than repeat it.
fnReturnsRefBorrow9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    fid: ztypes.tid
    retTid: ztypes.tid
} out bool is {
    if fid.isZero then return false
    if retTid.isZero then return false
    if (funcBorrowFlag :symtab tid: fid) == false then return false
    # A container's `getMut` is native BY DECLARATION but its C is generated
    # HERE (emitColGet), not hand-written, so the exclusion below does not
    # reach it: for a compound valtype element it really does return a pointer
    # into the storage, and binding that by value is the write loss `getMut`
    # exists to prevent.
    if (isColGetMutRef9 :ast :symtab :ctx :fid) then return true
    # a NATIVE callee's ABI is fixed by its hand-written `.inc` fragment, which
    # returns its struct by value (`List.iterate` -> ListIter). This emitter only
    # rewrites the bodies it generates itself.
    if (symtab.reg.isNativeOf tid: fid) then return false
    # String/StringView and the collections are reftypes with hand-written C and
    # their own borrow legs; `isStringyTid` is asked rather than isNativeOf
    # because a String return arrives as a TYPEDEF id whose isNative is unset.
    if (isStringyTid :ctx tid: retTid) then return false
    if (isHeapPtrCollection :symtab :ctx tid: retTid) then return false
    if (isCollectionOriginTid :ctx originTid: (originTidOf :symtab tid: retTid)) then return false
    if (symtab.reg.isNativeOf tid: retTid) then return false
    # The question is the C ABI, NOT the ownership family: only a CLASS is
    # passed and returned by reference. A UNION is a reftype too, but it is a
    # `{tag, void* data}` fat pointer passed BY VALUE -- the copy already aliases
    # the source through `data`, so it needs no `*` and starring it produces C
    # that cannot be matched on. `isReftypeParam` is the emitter's existing
    # answer to exactly this and is what the param side already uses.
    return (isReftypeParam :ast :symtab :ctx tid: retTid)
}

# hoistExprIsBorrowRooted -- the hoisted expression's ROOT is a
# borrow-returning call (an element get and any field chain off it): the
# hoist is a shared view and must not register a free. Field chains off
# NAMED bases keep their existing legs untouched (a destructor-less box's
# field interp-free is load-bearing today).
hoistExprIsBorrowRooted: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
} out bool is {
    match (
        n
    ) case expression then {
        iex59: ast.nodes.get i: n.expression.u64
        return (hoistExprIsBorrowRooted :ast :symtab :ctx n: iex59)
    } case statementline then {
        sln9: ast.nodes.get i: n.statementline.u64
        return (hoistExprIsBorrowRooted :ast :symtab :ctx n: sln9)
    } case call then {
        return (callRhsIsBorrow :ast :symtab :ctx call: n)
    } case dottedpath then {
        return (hoistExprIsBorrowRooted :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
    } else {
        return false
    }
}

# callRhsIsBorrow -- the call-shaped leg of bindingRhsIsBorrow: the callee's
# declared return carries the `.borrow` marker (funcReturnsBorrow, recorded
# from the signature). Dotted method calls whose callable stamp missed probe
# the receiver mono's method child -- fully signature-driven (List/ListView
# element gets arrive here through their declared `out of.borrow`).
callRhsIsBorrow: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
} out bool is {
    cstid9: stampIdOf :symtab nid: (nodeIdOf9 n: (ast.nodes.get i: call.callable.u64))
    if (funcBorrowFlag :symtab tid: cstid9) then return true
    cnm9: atomTextOf :ast n: (ast.nodes.get i: call.callable.u64)
    if cnm9.length > 0 then {
        ufid9: userFnId :ast :symtab :ctx name: cnm9.stringview
        if (funcBorrowFlag :symtab tid: ufid9) then return true
    }
    ch: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if ch.length == 0 then return false
    rid: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: call.callable.u64)
    rid = chaseColMono :symtab :ctx tid: (ztypes.tid.create from: rid.u64)
    mfid9: optU64Or9 o: (symtab.typing.declChildOf
        pool: ast.names
        parentTypeId: rid
        name: ch.stringview
    )
    return (funcBorrowFlag :symtab tid: (ztypes.tid.create from: mfid9.u64))
}

# isSvAsStringNode -- the node is `sv.asString` on a StringView-typed base:
# the result is a `const String*` cast of the view's address, so a binding or
# hoist of it is a POINTER local (a 24-byte value copy would read `capacity`
# past the end of the view).
isSvAsStringNode: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
} out bool is {
    match (
        n
    ) case expression then {
        return (isSvAsStringNode :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        cn9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if cn9.stringview != "asString" then return false
        bnidA9: nodeIdOf9 n: (ast.nodes.get i: n.parent.u64)
        btA9: chaseStrTypedef :symtab :ctx tid: (stampIdOf :symtab nid: bnidA9)
        return btA9 == ctx.svTid
    } else {
        return false
    }
}

# svBaseExprOfAsString -- the rendered VIEW expression under `sv.asString`
# (the container probes pass the view itself, never a materialised String).
svBaseExprOfAsString: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    n: Node.view
} out String is {
    match (
        n
    ) case expression then {
        return (svBaseExprOfAsString :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# colArgAsStringViewExpr -- when the labelled argument is `sv.asString`, the
# rendered view expression for the C `_getv`/`_hasv`/`_deletev` probe; "".
colArgAsStringViewExpr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
    label: StringView
} out String is {
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringview == label then {
                opn9: ast.nodes.get i: a.operation.u64
                if (isSvAsStringNode :ast :symtab :ctx n: opn9) then {
                    return (svBaseExprOfAsString :ast :symtab :ctx n: opn9)
                }
                return "".string
            }
        } else null
    }
    return "".string
}

# refBorrowCalleeFid9 -- the CALLEE behind a borrow-returning binding RHS, or 0.
# Deliberately narrower than bindingRhsIsBorrow, which also answers true for a
# plain field read: only a declared `.borrow`/`.view` RETURN makes the binding a
# reference, and a field read keeps its existing shallow-copy leg.
refBorrowCalleeFid9: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    n: Node.view
} out u64 is {
    match (
        n
    ) case expression then {
        return (refBorrowCalleeFid9 :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (refBorrowCalleeFid9
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.statementline.u64)
        )
    } case call then {
        cid9: stampIdOf :symtab nid: (nodeIdOf9 n: (ast.nodes.get i: n.callable.u64))
        if (funcBorrowFlag :symtab tid: cid9) then return cid9
        ch8: aliasChildName :ast :symtab n: (ast.nodes.get i: n.callable.u64)
        if ch8.length == 0 then return 0
        rid8: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: n.callable.u64)
        rid8 = chaseColMono :symtab :ctx tid: (ztypes.tid.create from: rid8.u64)
        mf8: optU64Or9 o: (symtab.typing.declChildOf
            pool: ast.names
            parentTypeId: rid8
            name: ch8.stringview
        )
        if (funcBorrowFlag :symtab tid: (ztypes.tid.create from: mf8.u64)) then return mf8
        return 0
    } case dottedpath then {
        # a zero-arg method auto-call reads as a dotted path
        ch7: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        pt7: stampIdOf :symtab nid: (nodeIdOf9 n: (ast.nodes.get i: n.parent.u64))
        cc7: symtab.typing.declChildOf pool: ast.names parentTypeId: pt7 name: ch7.stringview
        match (
            cc7
        ) case some then {
            if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: cc7.u64)) == ztypes.ztypetype.functionType then {
                if (funcBorrowFlag :symtab tid: (ztypes.tid.create from: cc7.u64)) then return cc7
            }
            return 0
        } case none then {
            return 0
        }
    } else {
        return 0
    }
}

# true when a binding's right-hand side is a borrow.
bindingRhsIsBorrow: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    n: Node.view
} out bool is {
    match (
        n
    ) case expression then {
        return (bindingRhsIsBorrow :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        sln9: ast.nodes.get i: n.statementline.u64
        return (bindingRhsIsBorrow :ast :symtab :ctx n: sln9)
    } case call then {
        return (callRhsIsBorrow :ast :symtab :ctx call: n)
    } case dottedpath then {
        ch9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        bnmV9: atomVid :symtab nid: (atomNodeId9 n: (ast.nodes.get i: n.parent.u64))
        if (vvHas xs: ctx.narrowBox vid: bnmV9) then {
            # a field read off a narrowed subject is a shallow-copy borrow (it aliases
            # the subject's heap); an ownership builtin yields an owned value, and so
            # does a method auto-call (FUNCTION child) on the narrowed payload.
            if (isMoveMarker name: ch9.stringview) then return false
            if ch9.stringview == "copy" then return false
            if ch9.stringview == "string" then return false
            ntO2: vtGet xs: ctx.narrowTid vid: bnmV9
            match (
                ntO2
            ) case some then {
                ncc9: (symtab.typing.declChildOf
                    pool: ast.names
                    parentTypeId: ntO2
                    name: ch9.stringview
                )
                match (
                    ncc9
                ) case some then {
                    if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: ncc9.u64)) == ztypes.ztypetype.functionType then return false
                } case none then null
            } case none then null
            return true
        }
        ptid9: stampIdOf :symtab nid: (nodeIdOf9 n: (ast.nodes.get i: n.parent.u64))
        cco9: symtab.typing.declChildOf pool: ast.names parentTypeId: ptid9 name: ch9.stringview
        match (
            cco9
        ) case some then {
            # A zero-arg method auto-call reads as a dotted path, so this is the
            # only place its RETURN is consulted: a `.borrow` / `.view` return
            # aliases the receiver and must not be freed with the binding, the
            # same answer callRhsIsBorrow gives the parenthesised form.
            if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: cco9.u64)) == ztypes.ztypetype.functionType then {
                return (funcBorrowFlag :symtab tid: (ztypes.tid.create from: cco9.u64))
            }
            return true
        } case none then {
            return false
        }
    } else {
        return false
    }
}

# rhsIsBorrowGet -- the binding RHS is a List/ListView `get` lowered by pointer,
# so the local must ALIAS the element storage rather than snapshot it. Shares
# callRhsIsBorrow's receiver derivation, so the receiver text cannot diverge.
rhsIsBorrowGet: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
} out bool is {
    match (
        n
    ) case expression then {
        return (rhsIsBorrowGet :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (rhsIsBorrowGet :ast :symtab :ctx n: (ast.nodes.get i: n.statementline.u64))
    } case call then {
        cbl9: ast.nodes.get i: n.callable.u64
        ch9: aliasChildName :ast :symtab n: cbl9
        isG9: false
        if ch9.stringview == "get" then isG9 = true
        if ch9.stringview == "getMut" then isG9 = true
        if (isG9) == false then return false
        bt9: chaseColMono :symtab :ctx tid: (dottedReceiverStampId :ast :symtab callable: cbl9)
        isC9: false
        if (isListOriginOf :symtab :ctx tid: (ztypes.tid.create from: bt9.u64)) then isC9 = true
        if (isListViewOriginOf :symtab :ctx tid: (ztypes.tid.create from: bt9.u64)) then isC9 = true
        if (isC9) == false then return false
        return (listGetIsPtr :ast :symtab :ctx monoId: (ztypes.tid.create from: bt9.u64))
    } else {
        return false
    }
}

# emitStrConvCall -- the `.str` sized-conversion method on a String / StringView
# / str parent: `<parent>.str to: N` -> z_String_to_<name>(data, len). "" when
# not a .str-to-str conversion. The capacity rides the result mono type.
emitStrConvCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if mn.stringview != "str" then return "".string
    rid0: stampIdOf :symtab nid: call.nodeid.u64
    rid: chaseColMono :symtab :ctx tid: rid0
    if (originIsTid
        :symtab
        tid: (ztypes.tid.create from: rid.u64)
        originTid: ctx.strOriginTid
    ) == false then return "".string
    rnm: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: rid.u64)
    pv: emitDottedReceiver :ast :symtab :ctx callable: (ast.nodes.get i: call.callable.u64)
    ptid: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: call.callable.u64)
    lenAcc: "len".string
    if ptid == ctx.strTid then lenAcc = "size".string
    if ptid == ctx.svTid then lenAcc = "size".string
    return "\{ctx.strC}_to_\{rnm}(\{pv}.data, \{pv}.\{lenAcc})"
}

# allDigits -- true when s is non-empty and every byte is an ASCII digit 0-9.
# Distinguishes a numeric array index member (`a.0`) from a named member.
allDigits: function {s: StringView} out bool is {
    if s.length == 0 then return false
    i9: u64
    n9: s.length
    for i9 < n9 loop {
        bo9: s.byteAt i: i9
        match (
            bo9
        ) case some then {
            if bo9 < 48 then return false
            if bo9 > 57 then return false
        } case none then {
            return false
        }
        i9 = i9 + 1
    }
    return true
}

# emitBoxCreate -- `Box from: x`: heap-alloc a cell for the element and store x.
# Gated on the BOX_CREATE callKind stamp; hoists the alloc+store and returns the
# pointer temp. Mirrors the reference _emit_box_create (valtype/String inner).
emitBoxCreate: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.CallData.view
} out String is {
    cko9: symtab.typing.callKind.get key: call.nodeid.u64
    isBoxC9: false
    match (
        cko9
    ) case some then {
        if cko9 == zast.callkind.boxCreate then isBoxC9 = true
    } case none then null
    if (isBoxC9) == false then return "".string
    bmid9: stampIdOf :symtab nid: call.nodeid.u64
    bmn9: typeNameOfReg9 :symtab tid: bmid9
    ben9: monoElemName full: bmn9 prefixLen: 4
    beid9: resolveTypeIdByName :ast :symtab :ctx name: ben9.stringview
    binner9: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: beid9.u64) thisTid: ztypes.tid
    bval9: ctorArgByLabel :ast :symtab :ctx :call label: "from"
    bN9: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    bnm9: "_Box\{bN9}"
    braw9: "    \{binner9}* \{bnm9} = (\{binner9}*)z_xmalloc(sizeof(\{binner9}));\n    *\{bnm9} = \{bval9};\n"
    ctx.argHoistRaw.append braw9
    return bnm9
}

# emitEmptyColCreate -- an empty collection construction `(List of: T)` /
# `(Set of: T)` / `(Map ...)` as a value: emit the collection mono's create with
# capacity 0, resolved from the call-node stamp. "" when not such a construction.
emitEmptyColCreate: function {ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    cn0: StringView
} out String is {
    if cn0 == "array" then {
        amid0: stampIdOf :symtab nid: (nodeIdOf9 n: (ast.nodes.get i: call.callable.u64))
        amid9: chaseColMono :symtab :ctx tid: amid0
        if (originIsTid
            :symtab
            tid: (ztypes.tid.create from: amid9.u64)
            originTid: ctx.arrayOriginTid
        ) then {
            acb9: ctxCname :ctx tid: (ztypes.tid.create from: amid9.u64)
            return "\{acb9}_create()"
        }
    }
    if cn0 == "str" then {
        smid0: stampIdOf :symtab nid: (nodeIdOf9 n: (ast.nodes.get i: call.callable.u64))
        smid9: chaseColMono :symtab :ctx tid: smid0
        if (originIsTid
            :symtab
            tid: (ztypes.tid.create from: smid9.u64)
            originTid: ctx.strOriginTid
        ) then {
            scb9: ctxCname :ctx tid: (ztypes.tid.create from: smid9.u64)
            return "\{scb9}_create()"
        }
    }
    # the container leg is keyed on the stamped construction kind and the
    # mono's origin family, not the written head name, so a re-export alias
    # of a container constructs like its target.
    ckc9: symtab.typing.callKind.get key: call.nodeid.u64
    isCr9: false
    match (
        ckc9
    ) case some then {
        if ckc9 == zast.callkind.classCreate then isCr9 = true
    } case none then null
    if (isCr9) == false then return "".string
    mid9: stampIdOf :symtab nid: call.nodeid.u64
    mid9 = ztypes.tid.create from: (chaseColMono :symtab :ctx tid: mid9)
    monoLk3: originTidOf :symtab tid: mid9
    if monoLk3.isZero then return "".string
    isCol9: false
    if (isListOriginOf :symtab :ctx tid: mid9) then isCol9 = true
    if (isSetOriginOf :symtab :ctx tid: mid9) then isCol9 = true
    if (isMapOriginOf :symtab :ctx tid: mid9) then isCol9 = true
    if (isIdCollectionOriginOf :symtab :ctx tid: mid9) then isCol9 = true
    if (isCol9) == false then return "".string
    cb9: ctxCname :ctx tid: mid9
    ccap9: listCapArg :ast :symtab :ctx n: (ast.nodes.get i: call.nodeid.u64)
    return "\{cb9}_create((uint64_t)\{ccap9})"
}

# colRecvRef -- a collection (List) receiver as a C lvalue for a method call: a
# ptrVar List (a by-pointer param) is already a pointer and passes directly; a
# value List passes its address.
colRecvRef: function {ctx: Ctx.view bn: StringView vid: ztypes.vid} out String is {
    if (isPtrVid :ctx :vid) then return bn.string
    return "&\{bn}"
}

# emitCollectionMethodCall -- the collection method handlers behind ONE
# receiver computation: the receiver expression and its chased mono id are
# computed once, then the origin tid picks the array/List/Set/Map handler.
# "" when the receiver is not a collection mono (or the call is not dotted).
emitCollectionMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    bn: emitDottedReceiver :ast :symtab :ctx callable: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    bvid: (atomVidIfPlain
        :ast
        :symtab
        :ctx
        n: (ast.nodes.get i: call.callable.u64)
        text: bn.stringview
    )
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    brid9: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: call.callable.u64)
    bt: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: brid9.u64)
    # classify by the mono's ORIGIN NAME (the graph-independent identity):
    # a by-name-resolved origin tid can diverge from the mono's captured
    # genericOriginId when extra units register their own List/Map shells
    on9: monoOriginName :symtab tid: (ztypes.tid.create from: bt.u64)
    ov9: on9.stringview
    if ov9 == "array" then return (emitArrayMethodCall :ast :symtab :ctx :call :mn :bn :bt :bvid)
    isList9: false
    if ov9 == "ListRef" then isList9 = true
    if ov9 == "ListVal" then isList9 = true
    if ov9 == "ListView" then isList9 = true
    if ov9 == "ListViewVal" then isList9 = true
    if isList9 then return (emitListMethodCall
        :ast
        :symtab
        :ctx
        :call
        :mn
        :bn
        bt: (ztypes.tid.create from: bt.u64)
        :bvid
    )
    isSet9: false
    if ov9 == "SetRef" then isSet9 = true
    if ov9 == "SetVal" then isSet9 = true
    if isSet9 then return (emitSetMethodCall :ast :symtab :ctx :call :mn :bn :bt)
    isMap9: false
    if ov9 == "MapRR" then isMap9 = true
    if ov9 == "MapRV" then isMap9 = true
    if ov9 == "MapVR" then isMap9 = true
    if ov9 == "MapVV" then isMap9 = true
    if isMap9 then return (emitMapMethodCall :ast :symtab :ctx :call :mn :bn :bt)
    isIdMap9: false
    if ov9 == "IdMapR" then isIdMap9 = true
    if ov9 == "IdMapV" then isIdMap9 = true
    if isIdMap9 then return (emitIdMapMethodCall :ast :symtab :ctx :call :mn :bn :bt :bvid)
    if ov9 == "IdSet" then return (emitIdSetMethodCall :ast :symtab :ctx :call :mn :bn :bt :bvid)
    return "".string
}

# emit a call to a List method.
emitListMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    mn: String
    bn: String
    bt: ztypes.tid
    bvid: ztypes.vid
} out String is {
    cb: ctxCname :ctx tid: bt
    recvR9: colRecvRef :ctx bn: bn.stringview vid: bvid
    if mn.stringview == "append" then {
        v: colArg :ast :symtab :ctx :call label: "from" consumes: true
        e0: "\{cb}_append(\{recvR9}, \{v})"
        return e0
    }
    if mn.stringview == "get" then {
        v: listArg :ast :symtab :ctx :call label: "i"
        e1: "\{cb}_get(\{recvR9}, \{v})"
        if (listGetIsPtr
            :ast
            :symtab
            :ctx
            monoId: (ztypes.tid.create from: bt.u64)
        ) then return "(*\{e1})"
        return e1
    }
    if mn.stringview == "getMut" then {
        vm: listArg :ast :symtab :ctx :call label: "i"
        e1m: "\{cb}_getMut(\{recvR9}, \{vm})"
        if (listGetIsPtr
            :ast
            :symtab
            :ctx
            monoId: (ztypes.tid.create from: bt.u64)
        ) then return "(*\{e1m})"
        return e1m
    }
    if mn.stringview == "set" then {
        vi: listArg :ast :symtab :ctx :call label: "i"
        vv: listArg :ast :symtab :ctx :call label: "val"
        e2: "\{cb}_set(\{recvR9}, \{vi}, \{vv})"
        return e2
    }
    if mn.stringview == "pop" then {
        e3: "\{cb}_pop(\{recvR9})"
        return e3
    }
    if mn.stringview == "insert" then {
        vf: listArg :ast :symtab :ctx :call label: "from"
        va: listArg :ast :symtab :ctx :call label: "at"
        e4: "\{cb}_insert(\{recvR9}, \{vf}, \{va})"
        return e4
    }
    if mn.stringview == "extend" then {
        eaa: listTakeArgBase :ast :call label: "from"
        eaV9: atomVid :symtab nid: (listTakeArgBaseNid :ast :call label: "from")
        ea: emitLocalAtomName :ctx name: eaa.stringview vid: eaV9
        e5: "\{cb}_extend(\{recvR9}, &\{ea})"
        return e5
    }
    if mn.stringview == "contains" then {
        vc: listArg :ast :symtab :ctx :call label: "item"
        e6: "\{cb}_contains(\{recvR9}, \{vc})"
        return e6
    }
    if mn.stringview == "sort" then {
        e7: "\{cb}_sort(\{recvR9})"
        return e7
    }
    return "".string
}

# emitArrayMethodCall -- `.get i:` / `.set i: item:` on a fixed-size array mono
# receiver (a value type). get takes the receiver by value; set by address (it
# returns the previous element). "" when the receiver isn't an array mono.
# The value label is `item`, not List's `val` -- the two handlers are otherwise
# identical here, and reading the wrong label silently stored a zero.
emitArrayMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    mn: String
    bn: String
    bt: ztypes.tid
    bvid: ztypes.vid
} out String is {
    cb: ctxCname :ctx tid: (ztypes.tid.create from: bt.u64)
    if mn.stringview == "get" then {
        vi: listArg :ast :symtab :ctx :call label: "i"
        return "\{cb}_get(\{bn}, \{vi})"
    }
    if mn.stringview == "getMut" then {
        viM: listArg :ast :symtab :ctx :call label: "i"
        return "\{cb}_getMut(\{bn}, \{viM})"
    }
    if mn.stringview == "set" then {
        vi: listArg :ast :symtab :ctx :call label: "i"
        vv: listArg :ast :symtab :ctx :call label: "item"
        recvR9: colRecvRef :ctx bn: bn.stringview vid: bvid
        return "\{cb}_set(\{recvR9}, \{vi}, \{vv})"
    }
    return "".string
}

# mapKeyIsStr9 / setElemIsStr9 -- the mono's key/element is a String, i.e.
# its view-mode probe params are `const String*` in the template C.
mapKeyIsStr9: function {symtab: zenv.ZSymbolTable ctx: Ctx.view monoId: ztypes.tid} out bool is {
    kt9: mapKeyType :symtab :monoId
    return (keyHashKind :symtab :ctx tid: (ztypes.tid.create from: kt9.u64)) == 1
}

setElemIsStr9: function {symtab: zenv.ZSymbolTable ctx: Ctx.view monoId: ztypes.tid} out bool is {
    et9: setElemType :symtab :monoId
    return (keyHashKind :symtab :ctx tid: (ztypes.tid.create from: et9.u64)) == 1
}

# colStrKeyArg9 -- a String-keyed mono's view-mode key/item argument as a C
# POINTER: `&lvalue` directly, else a hoisted temp (owned by the statement,
# freed at its flush -- a probe never retains its key).
colStrKeyArg9: function {ctx: Ctx expr: StringView} out String is {
    if (isNonLvalueArg s: expr) then {
        hnK9: ctx.argHoistCtr
        ctx.argHoistCtr = ctx.argHoistCtr + 1
        nmK9: "_ah\{hnK9}"
        hdtK9: "    \{ctx.strC}_free(&\{nmK9});\n"
        exc9: expr.string
        ctx.argHoistVals.append exc9
        htK9: "\{ctx.strC}_t"
        ctx.argHoistTypes.append htK9
        ctx.argHoistDtors.append hdtK9
        retK9: "&\{nmK9}"
        ctx.argHoistNames.append nmK9
        return retK9
    }
    return "&\{expr}"
}

# ownedRecvHoist9 -- a member read whose RECEIVER is a temporary that owns
# heap: `(mk n: 1).length` emits the call inline, reads `.size` off the result
# and drops the only reference to it. Hoist the receiver into a statement temp
# (declared by flushArgHoists, freed with the scope) and read the member off
# that instead. "" when the receiver is already an lvalue, owns nothing, or is
# a BORROW-returning call -- a shared view must never be freed here.
ownedRecvHoist9: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    expr: StringView
    n: Node.view
} out String is {
    if (isNonLvalueArg s: expr) == false then return "".string
    rtid9: stampIdOf :symtab nid: (nodeIdOf9 :n)
    if rtid9.isZero then return "".string
    if (symtab.reg.hasDestructorName typeId: rtid9) == false then return "".string
    if (bindingRhsIsBorrow :ast :symtab :ctx :n) then return "".string
    rct9: typeRefC :ast :symtab :ctx tid: rtid9 thisTid: ztypes.tid
    if rct9.length == 0 then return "".string
    rhn9: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    rnm9: "_ah\{rhn9}"
    rdt9: "    \{ctx.strC}_free(&\{rnm9});\n"
    if (rtid9 == ctx.strTid) == false then {
        rcn9: ctxCname :ctx tid: rtid9
        rdt9 = "    \{rcn9}_destroy(&\{rnm9});\n"
    }
    rex9: expr.string
    ctx.argHoistVals.append rex9
    ctx.argHoistTypes.append rct9
    ctx.argHoistDtors.append rdt9
    rnc9: rnm9.copy
    ctx.argHoistNames.append rnc9
    return rnm9
}

# emitSetMethodCall -- an arg-taking method on a Set-mono receiver (a heap
# pointer, so the receiver passes directly without `&`). "" when not a Set
# call; the no-arg `.length`/`.iterate` reads ride the dottedpath leg.
emitSetMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    mn: String
    bn: String
    bt: ztypes.tid
} out String is {
    cb: ctxCname :ctx tid: (ztypes.tid.create from: bt.u64)
    if mn.stringview == "add" then {
        v: colArg :ast :symtab :ctx :call label: "item" consumes: true
        e0: "\{cb}_add(\{bn}, \{v})"
        return e0
    }
    if mn.stringview == "has" then {
        viv9: colArgAsStringViewExpr :ast :symtab :ctx :call label: "item"
        if viv9.length > 0 then return "\{cb}_hasv(\{bn}, \{viv9})"
        v: colArg :ast :symtab :ctx :call label: "item" consumes: false
        if (setElemIsStr9 :symtab :ctx monoId: bt) then {
            return "\{cb}_has(\{bn}, \{colStrKeyArg9 :ctx expr: v.stringview})"
        }
        e1: "\{cb}_has(\{bn}, \{v})"
        return e1
    }
    if mn.stringview == "delete" then {
        viv9: colArgAsStringViewExpr :ast :symtab :ctx :call label: "item"
        if viv9.length > 0 then return "\{cb}_deletev(\{bn}, \{viv9})"
        v: colArg :ast :symtab :ctx :call label: "item" consumes: false
        if (setElemIsStr9 :symtab :ctx monoId: bt) then {
            return "\{cb}_delete(\{bn}, \{colStrKeyArg9 :ctx expr: v.stringview})"
        }
        e2: "\{cb}_delete(\{bn}, \{v})"
        return e2
    }
    return "".string
}

# emitMapMethodCall -- an arg-taking method on a Map-mono receiver (a heap
# pointer). set/get/has/delete pass the pointer directly; "" otherwise. The
# no-arg `.length`/`.capacity` reads ride the dottedpath leg.
emitMapMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    mn: String
    bn: String
    bt: ztypes.tid
} out String is {
    cb: ctxCname :ctx tid: (ztypes.tid.create from: bt.u64)
    if mn.stringview == "set" then {
        vk: colArg :ast :symtab :ctx :call label: "key" consumes: true
        vv: colArg :ast :symtab :ctx :call label: "value" consumes: true
        e0: "\{cb}_set(\{bn}, \{vk}, \{vv})"
        return e0
    }
    if mn.stringview == "get" then {
        vkv9: colArgAsStringViewExpr :ast :symtab :ctx :call label: "key"
        if vkv9.length > 0 then return "\{cb}_getv(\{bn}, \{vkv9})"
        vk: colArg :ast :symtab :ctx :call label: "key" consumes: false
        if (mapKeyIsStr9 :symtab :ctx monoId: bt) then {
            return "\{cb}_get(\{bn}, \{colStrKeyArg9 :ctx expr: vk.stringview})"
        }
        e1: "\{cb}_get(\{bn}, \{vk})"
        return e1
    }
    if mn.stringview == "has" then {
        vkv9: colArgAsStringViewExpr :ast :symtab :ctx :call label: "key"
        if vkv9.length > 0 then return "\{cb}_hasv(\{bn}, \{vkv9})"
        vk: colArg :ast :symtab :ctx :call label: "key" consumes: false
        if (mapKeyIsStr9 :symtab :ctx monoId: bt) then {
            return "\{cb}_has(\{bn}, \{colStrKeyArg9 :ctx expr: vk.stringview})"
        }
        e2: "\{cb}_has(\{bn}, \{vk})"
        return e2
    }
    if mn.stringview == "remove" then {
        vk: colArg :ast :symtab :ctx :call label: "key" consumes: false
        if (mapKeyIsStr9 :symtab :ctx monoId: bt) then {
            return "\{cb}_remove(\{bn}, \{colStrKeyArg9 :ctx expr: vk.stringview})"
        }
        e9: "\{cb}_remove(\{bn}, \{vk})"
        return e9
    }
    return "".string
}

# emitIdMapMethodCall -- an arg-taking method on an IdMap-mono receiver. The
# receiver is a STACK struct, as a List is, so it goes through colRecvRef and
# arrives by address; a Map's receiver is already a pointer and does not. The
# key is a scalar by construction of the `idkey` bound, so none of the Map
# family's String-key detours apply here.
emitIdMapMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    mn: String
    bn: String
    bt: ztypes.tid
    bvid: ztypes.vid
} out String is {
    cb: ctxCname :ctx tid: (ztypes.tid.create from: bt.u64)
    recvR9: colRecvRef :ctx bn: bn.stringview vid: bvid
    if mn.stringview == "set" then {
        vk: colArg :ast :symtab :ctx :call label: "key" consumes: false
        vv: colArg :ast :symtab :ctx :call label: "value" consumes: true
        e0: "\{cb}_set(\{recvR9}, \{vk}, \{vv})"
        return e0
    }
    if mn.stringview == "get" then {
        vk: colArg :ast :symtab :ctx :call label: "key" consumes: false
        e1: "\{cb}_get(\{recvR9}, \{vk})"
        return e1
    }
    if mn.stringview == "getMut" then {
        vkm: colArg :ast :symtab :ctx :call label: "key" consumes: false
        e1m: "\{cb}_getMut(\{recvR9}, \{vkm})"
        return e1m
    }
    if mn.stringview == "has" then {
        vk: colArg :ast :symtab :ctx :call label: "key" consumes: false
        e2: "\{cb}_has(\{recvR9}, \{vk})"
        return e2
    }
    return "".string
}

# emitIdSetMethodCall -- the IdSet half of the above.
emitIdSetMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    mn: String
    bn: String
    bt: ztypes.tid
    bvid: ztypes.vid
} out String is {
    cb: ctxCname :ctx tid: (ztypes.tid.create from: bt.u64)
    recvR9: colRecvRef :ctx bn: bn.stringview vid: bvid
    if mn.stringview == "add" then {
        v: colArg :ast :symtab :ctx :call label: "item" consumes: false
        e0: "\{cb}_add(\{recvR9}, \{v})"
        return e0
    }
    if mn.stringview == "has" then {
        v: colArg :ast :symtab :ctx :call label: "item" consumes: false
        e1: "\{cb}_has(\{recvR9}, \{v})"
        return e1
    }
    return "".string
}

# emitInterpArgExpr -- if n is (or wraps/projects via .string/.stringview) an
# interpolated string literal, return a self-contained statement expression that
# builds and yields the owned String; "" otherwise. Used for inline argument
# positions, where the pure emitExpr cannot emit the multi-statement interp build.
emitInterpArgExpr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
} out String is {
    match (
        n
    ) case expression then {
        return (emitInterpArgExpr :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            ltmp: (TmpCtr
                n: 0
                frees: (List String)
                listFrees: (List String)
                listFreeVars: (List String)
                freeRaw: (ListVal ztypes.vid)
                listFreeRaw: (ListVal ztypes.vid)
            )
            lbuf: String
            # this interpolation emits into its OWN `({ ... })` scope, so hoists
            # already pending from the enclosing argument list must stay pending:
            # they are declared and used at the call, outside this block.
            sM: (emitInterpBuild
                :ast
                :symtab
                :ctx
                parts: n.stringparts
                ind: " "
                tmp: ltmp
                buf: lbuf
                hoistFloor: ctx.argHoistNames.length
                hoistRawFloor: ctx.argHoistRaw.length
            )
            r: "({ \{lbuf}_s\{sM}; })"
            return r
        }
        return "".string
    } case dottedpath then {
        cm: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if cm.stringview == "string" then {
            dpp9: ast.nodes.get i: n.parent.u64
            return (emitInterpArgExpr :ast :symtab :ctx n: dpp9)
        }
        if cm.stringview == "stringview" then return (emitInterpArgExpr
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.parent.u64)
        )
        return "".string
    } else {
        return "".string
    }
}

# emitInterpStmtValue -- like emitInterpArgExpr, but emits the interp build chain
# as PRIOR statements into buf (so a referenced local is read at THIS point) and
# returns the owned-String temp name "_sN"; "" otherwise. Used where the build
# must precede the statement -- a reassignment drop-old, so `s = "\{s}x"` reads
# old s before the old value is freed (mirrors emitStringBindValue / the
# reference's _temp.decls). emitInterpBuild does NOT register _sN for free, so the
# assignment `nm2 = _sN` moves the storage into the lvalue with no double-free.
emitInterpStmtValue: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} out String is {
    match (
        n
    ) case expression then {
        iex49: ast.nodes.get i: n.expression.u64
        return (emitInterpStmtValue :ast :symtab :ctx n: iex49 :ind :tmp :buf)
    } case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            sB: emitInterpBuild :ast :symtab :ctx parts: n.stringparts :ind :tmp :buf
            return "_s\{sB}"
        }
        return "".string
    } case dottedpath then {
        cm: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if cm.stringview == "string" then {
            dpr9: ast.nodes.get i: n.parent.u64
            return (emitInterpStmtValue :ast :symtab :ctx n: dpr9 :ind :tmp :buf)
        }
        if cm.stringview == "stringview" then {
            dpr9: ast.nodes.get i: n.parent.u64
            return (emitInterpStmtValue :ast :symtab :ctx n: dpr9 :ind :tmp :buf)
        }
        return "".string
    } else {
        return "".string
    }
}

# emitColInterpArg -- an interpolated-string collection-method argument hoisted to
# an owned String temp via the argHoist mechanism (flushed at the statement). When
# the method BORROWS the arg (consumes == false: has/delete/get), a scope-exit
# free is registered; a consuming method (add/set) moves the temp in. "" when n is
# not an interpolated string.
emitColInterpArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: Node.view
    consumes: bool
} out String is {
    sx: emitInterpArgExpr :ast :symtab :ctx :n
    if sx.length == 0 then {
        if consumes then return "".string
        tn9: stampNameDeep :ast :symtab :n
        if tn9.stringview != "String" then return "".string
        ex9: emitExpr :ast :symtab :ctx :n
        if (isNonLvalueArg s: ex9.stringview) == false then return "".string
        sx = ex9
    }
    hn: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    nmH: "_ah\{hn}"
    hdt: String
    if (consumes) == false when (hoistExprIsBorrowRooted :ast :symtab :ctx :n) == false then {
        hdt = "    \{ctx.strC}_free(&\{nmH});\n"
    }
    retx: nmH.copy
    ctx.argHoistVals.append sx
    ctx.argHoistTypes.append "\{ctx.strC}_t"
    ctx.argHoistDtors.append hdt
    ctx.argHoistNames.append nmH
    return retx
}

# emitInterpArgForParam -- an interpolated-string-literal argument built into a
# hoisted temp `_ah<N>` and coerced to the parameter's C form: a String.take
# param moves the temp in (no free); a String borrow takes it by pointer; a
# StringView param gets a by-value view. The temp is freed at block exit unless
# moved into a take param. Returns "" when the argument is not an interpolated
# literal (the caller emits it normally). Mirrors emitColInterpArg's hoist but
# generalises the returned form across param kinds.
emitInterpArgForParam: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: Node.view
    fid: ztypes.tid
    pname: StringView
    pid: u64
} out String is {
    sx: emitInterpArgExpr :ast :symtab :ctx :n
    if sx.length == 0 then return "".string
    isTake: false
    if pid == ctx.strTid when (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.takeMode
    ) then isTake = true
    hn: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    nmH: "_ah\{hn}"
    hdt: String
    if (isTake) == false then hdt = "    \{ctx.strC}_free(&\{nmH});\n"
    retx: String
    if pid == ctx.strTid then {
        if isTake then {
            retx = nmH.copy
        } else {
            retx = "&\{nmH}"
        }
    } else {
        retx = svValueForm :ctx expr: nmH.stringview isStr: true vid: (ztypes.vid.create from: 0)
    }
    ctx.argHoistVals.append sx
    ctx.argHoistTypes.append "\{ctx.strC}_t"
    ctx.argHoistDtors.append hdt
    ctx.argHoistNames.append nmH
    return retx
}

# colArg -- a collection-method argument: the interp-string hoist when the arg is
# an interpolated literal, else the plain expression (mirrors listArg). consumes
# distinguishes take params (add/set) from borrow params (has/delete/get).
colArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    label: StringView
    consumes: bool
} out String is {
    posFirst: String
    havePos: false
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringview == label then {
                ic: (emitColInterpArg
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                    :consumes
                )
                if ic.length > 0 then return ic
                return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64))
            }
            if an.length == 0 when havePos == false then {
                havePos = true
                icp: (emitColInterpArg
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                    :consumes
                )
                if icp.length > 0 then {
                    posFirst = icp
                } else {
                    opf119: ast.nodes.get i: a.operation.u64
                    posFirst = emitExpr :ast :symtab :ctx n: opf119
                }
            }
        } else null
    }
    if havePos then return posFirst
    return "0".string
}

# listArg -- the C expression for a labeled list-method argument ("0" if
# absent).
listArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    label: StringView
} out String is {
    posFirst: String
    havePos: false
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringview == label then return (emitExpr
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: a.operation.u64)
            )
            if an.length == 0 when havePos == false then {
                havePos = true
                opf129: ast.nodes.get i: a.operation.u64
                posFirst = emitExpr :ast :symtab :ctx n: opf129
            }
        } else null
    }
    # a single positional arg binds to the (sole) labelless call site, e.g.
    # `xs.get i2` -> the `i` param.
    if havePos then return posFirst
    return "0".string
}

# listTakeArgBase -- the base atom of a `x.take` list argument (the
# extend source); the bare atom text otherwise.
listTakeArgBaseNid: function {
    ast: Ast.view
    call: zast.CallData.view
    label: StringView
} out u64 is {
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringview == label then return (takeArgBaseNid
                :ast
                n: (ast.nodes.get i: a.operation.u64)
            )
        } else null
    }
    return 0
}

# listTakeArgBase -- that base atom's text, derived from the node above.
listTakeArgBase: function {
    ast: Ast.view
    call: zast.CallData.view
    label: StringView
} out String is {
    lid9: listTakeArgBaseNid :ast :call :label
    if lid9 == 0 then return "0".string
    return (atomTextOf :ast n: (ast.nodes.get i: lid9))
}

# the base path of a `.take` argument `n`.
takeArgBaseNid: function {ast: Ast.view n: Node.view} out u64 is {
    match (
        n
    ) case expression then {
        return (takeArgBaseNid :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (atomNodeId9 n: (ast.nodes.get i: n.parent.u64))
    } case atomid then {
        return n.nodeid.u64
    } else {
        return 0
    }
}

# emitTypedefCreateCall -- `meters.create from: 42` / `meters 42`: a
# zero-overhead cast; emit the single argument expression.
emitTypedefCreateCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    # the call's stamped return IS the typedef (covers the unit-qualified
    # head, whose base atom is the unit name); the name walk stays as the
    # fallback for stamp-less shapes. Gated on the stamped callKind -- any
    # ORDINARY call may return a typedef and must not lose itself here.
    ckS9: symtab.typing.callKind.get key: call.nodeid.u64
    isTdCk9: false
    match (
        ckS9
    ) case some then {
        if ckS9 == zast.callkind.typedefCreate then isTdCk9 = true
        if ckS9 == zast.callkind.typedefBorrow then isTdCk9 = true
    } case none then null
    tidS9: stampIdOf :symtab nid: call.nodeid.u64
    if isTdCk9 when (isTypedefType :symtab tid: tidS9) then {
        aiterS9: call.arguments.iterate
        for aIdS9: aiterS9 loop {
            aS9: ast.nodes.get i: aIdS9.u64
            match (
                aS9
            ) case namedoperation then {
                return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: aS9.operation.u64))
            } else null
        }
        return "0".string
    }
    calr9: ast.nodes.get i: call.callable.u64
    bn: dottedBaseAtom :ast n: calr9
    if bn.length == 0 then bn = atomTextOf :ast n: calr9
    if bn.length == 0 then return "".string
    tid: userFnId :ast :symtab :ctx name: bn.stringview
    if tid.isZero then {
        so9: (ztypecheck.resolveSystemChild
            :ast
            ty: symtab.typing
            reg: symtab.reg
            name: bn.stringview
        )
        match (
            so9
        ) case some then {
            tid = ztypes.tid.create from: (so9)
        } case none then null
    }
    if tid.isZero then return "".string
    if (isTypedefType :symtab :tid) == false then return "".string
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64))
        } else null
    }
    return "0".string
}

# emitVariantCtorCall -- `result.ok 42`: a dotted callee whose base is a
# variant type and whose member is a payload arm; emits a designated
# compound literal.
# emitInlineVariantCtor -- a value (inline-payload) variant/optionval/resultval
# constructor as a compound literal: some-arm carries the first arg in .data.arm,
# none-arm just the tag. tid is the concrete VARIANT/mono type.
emitInlineVariantCtor: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    tid: ztypes.tid
    arm: StringView
} out String is {
    pc: armPayloadC :ast :symtab :ctx :tid :arm
    tg: variantTag :symtab :tid :arm
    vc: ctxCname :ctx :tid
    if pc.length > 0 then {
        av: "0".string
        aiter: call.arguments.iterate
        got: false
        for aId9: aiter loop {
            a: ast.nodes.get i: aId9.u64
            match (
                a
            ) case namedoperation then {
                if (got) == false then {
                    got = true
                    opf139: ast.nodes.get i: a.operation.u64
                    av = emitExpr :ast :symtab :ctx n: opf139
                }
            } else null
        }
        e0: "((\{vc}_t){ .tag = \{tg}, .data.\{arm} = (\{av}) })"
        return e0
    } else {
        av19: armValueC :symtab :tid :arm
        if av19.length > 0 then return av19
        e1: "((\{vc}_t){ .tag = \{tg} })"
        return e1
    }
}

# emitUnionCtor -- a main-unit user union arm construction (`U.arm payload`):
# a GCC statement-expression building the heap-payload union value (tag + a
# malloc'd box for the payload, or NULL data for a payload-less arm). Generic
# monos (Option/Result) keep their own emission paths.
emitUnionCtor: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if mn.length == 0 then return "".string
    smid0: stampIdOf :symtab nid: call.nodeid.u64
    smOrig9: originTidOf :symtab tid: smid0
    # system union monos (optionval/resultval/Option/Result) are built by
    # emitVariantCtorCall; only USER generic union monos are built here.
    if smOrig9 > 0 then {
        sysU9: false
        if (originIsTid :symtab tid: smid0 originTid: ctx.optionvalOriginTid) then sysU9 = true
        if (originIsTid :symtab tid: smid0 originTid: ctx.resultvalOriginTid) then sysU9 = true
        if (originIsTid :symtab tid: smid0 originTid: ctx.optionOriginTid) then sysU9 = true
        if (originIsTid :symtab tid: smid0 originTid: ctx.resultOriginTid) then sysU9 = true
        if sysU9 then return "".string
    }
    utid: resolveTypeIdByName :ast :symtab :ctx name: bn.stringview
    if utid == 0 then return "".string
    if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: utid.u64)) != ztypes.ztypetype.unionType then return "".string
    # build from the mono (smid0) for a user generic union; else the named template
    ctid9: utid
    if smOrig9 > 0 when (symtab.reg.typetypeOf typeId: smid0) == ztypes.ztypetype.unionType then {
        ctid9 = smid0
    }
    vc: ctxCname :ctx tid: (ztypes.tid.create from: ctid9.u64)
    tg: variantTag :symtab tid: (ztypes.tid.create from: ctid9.u64) arm: mn.stringview
    payC: armPayloadC :ast :symtab :ctx tid: (ztypes.tid.create from: ctid9.u64) arm: mn.stringview
    if payC.length > 0 then {
        av: String
        got: false
        aiter: call.arguments.iterate
        for aId9: aiter loop {
            a: ast.nodes.get i: aId9.u64
            match (
                a
            ) case namedoperation then {
                if (got) == false then {
                    got = true
                    # an interpolated payload builds via a self-contained
                    # statement expression (emitExpr cannot emit the chain)
                    opf149: ast.nodes.get i: a.operation.u64
                    av = emitInterpArgExpr :ast :symtab :ctx n: opf149
                    if av.length == 0 then {
                        opf1019: ast.nodes.get i: a.operation.u64
                        av = emitExpr :ast :symtab :ctx n: opf1019
                    }
                }
            } else null
        }
        e: "({ \{vc}_t _u = {0}; _u.tag = \{tg}; \{payC}* _b = (\{payC}*)z_xmalloc(sizeof(\{payC})); *_b = \{av}; _u.data = _b; _u; })"
        return e
    } else {
        e2: "({ \{vc}_t _u = {0}; _u.tag = \{tg}; _u.data = NULL; _u; })"
        return e2
    }
}

# emit a variant-arm constructor call.
emitVariantCtorCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    # system monos (optionval/resultval inline, Option none) -- the call node is
    # stamped with the concrete mono id (userFnId fails for these). Option.some
    # is a heap box handled by emitOptionBoxHoist at the statement site.
    smid: stampIdOf :symtab nid: call.nodeid.u64
    sInline: false
    if (originIsTid
        :symtab
        tid: smid
        originTid: ctx.optionvalOriginTid
    ) when bn.stringview == "optionval" then sInline = true
    if (originIsTid
        :symtab
        tid: smid
        originTid: ctx.resultvalOriginTid
    ) when bn.stringview == "resultval" then sInline = true
    if sInline then return (emitInlineVariantCtor
        :ast
        :symtab
        :ctx
        :call
        tid: smid
        arm: mn.stringview
    )
    if (originIsTid :symtab tid: smid originTid: ctx.optionOriginTid) then {
        ovc9: ctxCname :ctx tid: smid
        if mn.stringview == "none" then {
            otg9: variantTag :symtab tid: smid arm: "none"
            en9: "((\{ovc9}_t){ .tag = \{otg9}, .data = NULL })"
            return en9
        }
        if mn.stringview == "some" then {
            otg9s: variantTag :symtab tid: smid arm: "some"
            opayC9: armPayloadC :ast :symtab :ctx tid: smid arm: "some"
            if opayC9.length == 0 then return "".string
            oav9: "0".string
            ogot9: false
            oaiter9: call.arguments.iterate
            for oa9Id9: oaiter9 loop {
                oa9: ast.nodes.get i: oa9Id9.u64
                match (
                    oa9
                ) case namedoperation then {
                    if (ogot9) == false then {
                        ogot9 = true
                        # an interpolated payload builds via a self-contained
                        # statement expression (emitExpr cannot emit the chain)
                        opf159: ast.nodes.get i: oa9.operation.u64
                        oav9 = emitInterpArgExpr :ast :symtab :ctx n: opf159
                        if oav9.length == 0 then {
                            opf1029: ast.nodes.get i: oa9.operation.u64
                            oav9 = emitExpr :ast :symtab :ctx n: opf1029
                        }
                    }
                } else null
            }
            es9: "({ \{ovc9}_t _u = {0}; _u.tag = \{otg9s}; \{opayC9}* _b = (\{opayC9}*)z_xmalloc(sizeof(\{opayC9})); *_b = \{oav9}; _u.data = _b; _u; })"
            return es9
        }
        return "".string
    }
    vtid: userFnId :ast :symtab :ctx name: bn.stringview
    if vtid.isZero then return "".string
    if (symtab.reg.typetypeOf typeId: vtid) != ztypes.ztypetype.variantType then return "".string
    return (emitInlineVariantCtor :ast :symtab :ctx :call tid: vtid arm: mn.stringview)
}

# emitColTypedefCall -- `ByteView.borrow from: X` / `Bytes.create from: X` on a
# collection-typedef-class (Bytes/ByteView): the typedef is a zero-overhead
# alias, so the borrow/create is transparent -- emit the underlying arg. ""
# for any non-collection-typedef base.
emitColTypedefCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    isBC: false
    if mn.stringview == "borrow" then isBC = true
    if mn.stringview == "create" then isBC = true
    if (isBC) == false then return "".string
    bid: resolveTypeIdByName :ast :symtab :ctx name: bn.stringview
    if bid == 0 then return "".string
    mid: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: bid.u64)
    if mid.u64 == bid then return "".string
    return (ctorArgByLabel :ast :symtab :ctx :call label: "from")
}

# emitTypeQualCall -- `point.add a: x b: y`: a dotted callee whose base
# resolves to a record type and whose member is a FUNCTION child; args
# reorder to the method's param order by label.
emitTypeQualCall: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    btid: userFnId :ast :symtab :ctx name: bn.stringview
    if btid.isZero then return "".string
    bttq: symtab.reg.typetypeOf typeId: btid
    isStructQ: false
    if bttq == ztypes.ztypetype.recordType then isStructQ = true
    if bttq == ztypes.ztypetype.classType then isStructQ = true
    if (isStructQ) == false then return "".string
    mco: symtab.typing.declChildOf pool: ast.names parentTypeId: btid name: mn.stringview
    match (
        mco
    ) case some then {
        if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: mco.u64)) == ztypes.ztypetype.functionType then {
            pnames: (List String)
            pids: (ListVal u64)
            pidsNm: (ListVal u64)
            (recFieldLists
                :ast
                :symtab
                tid: (ztypes.tid.create from: mco.u64)
                names: pnames
                ids: pids
                nameIds: pidsNm
            )
            # a synthesized `create` (no body) has field-shaped params but no
            # emitted create fn -- route it to the type's field-wise ctor, the
            # path bare-name construction uses; a user create (a body) is called.
            mcBody9: false
            {
                mcrn9: symtab.typing.funcReturnNode.get key: mco
                match (
                    mcrn9
                ) case some then {
                    mcBody9 = true
                } case none then null
            }
            if mn.stringview == "create" when mcBody9 == false then {
                return (emitRecordCtor :ast :symtab :ctx :call tid: btid)
            }
            pn: pnames.length
            args: String
            if mn.stringview == "create" then {
                # user create: args by the create's own param labels
                pi: u64
                for pi < pn loop {
                    pname: pnames.get i: pi
                    av: ctorArgByLabel :ast :symtab :ctx :call label: pname.stringview
                    if pi > 0 then args.append ", "
                    args.append av
                    pi = pi + 1
                }
            } else {
                # a method: positional args; a CLASS receiver passes by address
                ai9: u64
                with aiterQ: call.arguments.iterate do for aQId9: aiterQ loop {
                    aQ: ast.nodes.get i: aQId9.u64
                    match (
                        aQ
                    ) case namedoperation then {
                        avq: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: aQ.operation.u64)
                        # the receiver passes by address in BOTH families, and
                        # is identified by its PARAMETER name -- keying on the
                        # type would also catch a same-typed sibling
                        byRef9: false
                        if ai9 < pn then {
                            ppnm9: pnames.get i: ai9
                            if (paramIsReceiverName
                                :ast
                                :symtab
                                fid: (ztypes.tid.create from: mco.u64)
                                pname: ppnm9.stringview
                            ) then byRef9 = true
                        }
                        if (pathIsPointer
                            :ast
                            :symtab
                            :ctx
                            n: (ast.nodes.get i: aQ.operation.u64)
                        ) then byRef9 = false
                        if ai9 > 0 then args.append ", "
                        if byRef9 then {
                            argq9: "&\{avq}"
                            args.append argq9
                        } else {
                            args.append avq
                        }
                        ai9 = ai9 + 1
                    } else null
                }
            }
            mc3: ctxCname :ctx tid: (ztypes.tid.create from: mco.u64)
            e7: "\{mc3}(\{args})"
            return e7
        }
    } case none then null
    return "".string
}

# emitRecordCtor -- a record construction call: args reordered to field
# order by label, emitted through the create alias.
# renderDefault -- a member's recorded default as a C expression. A literal
# re-renders from its expression node; a function default is the target
# FUNCTION type's symbol (the parameter IS that function); an arm default is a
# tag-only struct literal of the target.
renderDefault: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    dv: ztyping.defaultval
    targetTid: ztypes.tid
} out String is {
    {
        dl9: dv
        if dl9.literal then {
            if dl9 == 0 then return "".string
            return (ztypecheck.rootNameOf :ast n: (ast.nodes.get i: dl9.u64))
        }
    }
    {
        df9: dv
        if df9.func then {
            tn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: targetTid.u64)
            cf9: (canonFnId
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: targetTid.u64)
                name: tn.stringview
            )
            if cf9 > 0 then return (ctxCname :ctx tid: (ztypes.tid.create from: cf9.u64))
            return (ctxCname :ctx tid: (ztypes.tid.create from: targetTid.u64))
        }
    }
    {
        da9: dv
        if da9.arm then {
            arm: String
            {
                ao9: symtab.typing.decls.get i: da9.u64
                arm = zast.poolTextCopy pool: ast.names ref: (zast.nameid.create from: ao9.name)
            }
            tn2: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: targetTid.u64)
            cv9: (canonFnId
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: targetTid.u64)
                name: tn2.stringview
            )
            vtarget9: targetTid
            if cv9 > 0 then vtarget9 = ztypes.tid.create from: cv9.u64
            tg: variantTag :symtab tid: (ztypes.tid.create from: vtarget9.u64) arm: arm.stringview
            tc: (typeRefC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: vtarget9.u64)
                thisTid: ztypes.tid
            )
            avd9: (armValueC
                :symtab
                tid: (ztypes.tid.create from: vtarget9.u64)
                arm: arm.stringview
            )
            if avd9.length > 0 then return avd9
            return "(\{tc}){ .tag = \{tg} }"
        }
    }
    return "".string
}

# fnTypeTakesThis -- a FUNCTION type whose signature carries a `this` receiver
# (a method-ref slot auto-calls through itself with the receiver).
fnTypeTakesThis: function {symtab: zenv.ZSymbolTable tid: ztypes.tid} out bool is {
    return (symtab.reg.hasThisParamName :tid)
}

# emitAllDefaultedCall -- a bare reference to a function whose params are ALL
# defaulted is a no-arg auto-call: `describe` -> `z_..._describe(<defaults>)`.
# "" when the function has no params or any param lacks a default.
emitAllDefaultedCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    fnTid: ztypes.tid
    fcn: StringView
} out String is {
    pn: (List String)
    pidl: (ListVal u64)
    pidlNm: (ListVal u64)
    (recFieldLists
        :ast
        :symtab
        tid: (ztypes.tid.create from: fnTid.u64)
        names: pn
        ids: pidl
        nameIds: pidlNm
    )
    m: pn.length
    if m == 0 then return "".string
    j: u64
    allDef: true
    for j < m loop {
        pnjId: pidlNm.get i: j
        hd9: (symtab.typing.declHasDefaultId
            parentTypeId: fnTid
            nameId: (zast.nameid.create from: pnjId.u32.orPanic)
        )
        if (hd9) == false then allDef = false
        j = j + 1
    }
    if allDef == false then return "".string
    args: String
    k: u64
    for k < m loop {
        pik: pidl.get i: k
        pnkId: pidlNm.get i: k
        dt: (symtab.typing.declDefaultOfId
            parentTypeId: fnTid
            nameId: (zast.nameid.create from: pnkId.u32.orPanic)
        )
        rv: renderDefault :ast :symtab :ctx dv: dt targetTid: (ztypes.tid.create from: pik.u64)
        if k > 0 then args.append ", "
        args.append rv
        k = k + 1
    }
    r: "\{fcn}(\{args})"
    return r
}

# renderedMethodDefaultArgs -- the comma-joined rendered defaults for every
# non-receiver parameter of a method, when ALL of them carry defaults; ""
# when any is required or there are none (the caller keeps its emission).
renderedMethodDefaultArgs: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    fnTid: ztypes.tid
} out String is {
    pn: (List String)
    pidl: (ListVal u64)
    pidlNm: (ListVal u64)
    (recFieldLists
        :ast
        :symtab
        tid: (ztypes.tid.create from: fnTid.u64)
        names: pn
        ids: pidl
        nameIds: pidlNm
    )
    thisPn9: String
    thisPn9 = zast.poolTextCopy pool: ast.names ref: (symtab.reg.thisParamNameIdOf tid: fnTid)
    args: String
    userSeen9: false
    j: u64
    m: pn.length
    for j < m loop {
        pnj: pn.get i: j
        pij: pidl.get i: j
        pnjId: pidlNm.get i: j
        j = j + 1
        isRecv9: false
        if pnjId == zast.wkThis.u64 then isRecv9 = true
        if thisPn9.length > 0 when thisPn9.stringview == pnj.stringview then isRecv9 = true
        if (isRecv9) == false then {
            userSeen9 = true
            hd9: (symtab.typing.declHasDefaultId
                parentTypeId: fnTid
                nameId: (zast.nameid.create from: pnjId.u32.orPanic)
            )
            if (hd9) == false then return "".string
            dt: (symtab.typing.declDefaultOfId
                parentTypeId: fnTid
                nameId: (zast.nameid.create from: pnjId.u32.orPanic)
            )
            rv: renderDefault :ast :symtab :ctx dv: dt targetTid: (ztypes.tid.create from: pij.u64)
            if args.length > 0 then args.append ", "
            args.append rv
        }
    }
    if (userSeen9) == false then return "".string
    return args
}

# emitExprStrZero -- the empty owned String value: the zero struct needs
# no allocation and no free.
emitExprStrZero: function {ctx: Ctx.view} out String is {
    return "((\{ctx.strC}_t){0})"
}

# emitCtorDefaultsFill -- the zero-argument construction of a record/class
# tid: a body-carrying user create called with its param defaults, else the
# generated field-wise create with each field's default (fnptr fields pass
# the method symbol). The typechecker's implicitCreate stamp guarantees no
# required argument remains.
emitCtorDefaultsFill: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    tid: ztypes.tid
} out String is {
    cco: symtab.typing.declChildOfId parentTypeId: tid nameId: zast.wkCreate
    match (
        cco
    ) case some then {
        if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: cco.u64)) == ztypes.ztypetype.functionType then {
            crB9: false
            crn9: symtab.typing.funcReturnNode.get key: cco
            match (
                crn9
            ) case some then {
                crB9 = true
            } case none then null
            if crB9 then {
                cpn: (List String)
                cpi: (ListVal u64)
                cpiNm: (ListVal u64)
                (recFieldLists
                    :ast
                    :symtab
                    tid: (ztypes.tid.create from: cco.u64)
                    names: cpn
                    ids: cpi
                    nameIds: cpiNm
                )
                cargs: String
                ci: u64
                ccn: cpn.length
                for ci < ccn loop {
                    cpid: cpi.get i: ci
                    cpnameId: cpiNm.get i: ci
                    ci = ci + 1
                    cav: "0".string
                    if (symtab.typing.declHasDefaultId
                        parentTypeId: tid
                        nameId: (zast.nameid.create from: cpnameId.u32.orPanic)
                    ) then {
                        cdt: (symtab.typing.declDefaultOfId
                            parentTypeId: tid
                            nameId: (zast.nameid.create from: cpnameId.u32.orPanic)
                        )
                        cav = (renderDefault
                            :ast
                            :symtab
                            :ctx
                            dv: cdt
                            targetTid: (ztypes.tid.create from: cpid.u64)
                        )
                    }
                    if cargs.length > 0 then cargs.append ", "
                    cargs.append cav
                }
                ccb: ctxCname :ctx tid: (ztypes.tid.create from: cco.u64)
                return "\{ccb}(\{cargs})"
            }
        }
    } case none then null
    fnames: (List String)
    fids: (ListVal u64)
    fidsNm: (ListVal u64)
    recFieldLists :ast :symtab :tid names: fnames ids: fids nameIds: fidsNm
    args: String
    fi: u64
    fn0: fnames.length
    for fi < fn0 loop {
        ffid: fids.get i: fi
        fnameId: fidsNm.get i: fi
        fi = fi + 1
        av: "0".string
        if (symtab.typing.declHasDefaultId
            parentTypeId: tid
            nameId: (zast.nameid.create from: fnameId.u32.orPanic)
        ) then {
            cdt1: (symtab.typing.declDefaultOfId
                parentTypeId: tid
                nameId: (zast.nameid.create from: fnameId.u32.orPanic)
            )
            av = (renderDefault
                :ast
                :symtab
                :ctx
                dv: cdt1
                targetTid: (ztypes.tid.create from: ffid.u64)
            )
        } else {
            if (symtab.typing.declIsFnptrFieldId
                parentTypeId: tid
                nameId: (zast.nameid.create from: fnameId.u32.orPanic)
            ) then {
                av = ctxCname :ctx tid: (ztypes.tid.create from: ffid.u64)
            }
        }
        if args.length > 0 then args.append ", "
        args.append av
    }
    rcb9: ctxCname :ctx :tid
    return "\{rcb9}_create(\{args})"
}

# emit a record constructor call.
emitRecordCtor: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
    tid: ztypes.tid
} out String is {
    # a user-defined `create` (non-empty params) overrides the field-wise ctor:
    # bare-name construction routes through it, args by the create's own labels.
    cco: symtab.typing.declChildOfId parentTypeId: tid nameId: zast.wkCreate
    match (
        cco
    ) case some then {
        if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: cco.u64)) == ztypes.ztypetype.functionType then {
            crB9: false
            crn9: symtab.typing.funcReturnNode.get key: cco
            match (
                crn9
            ) case some then {
                crB9 = true
            } case none then null
            cpn: (List String)
            cpi: (ListVal u64)
            cpiNm: (ListVal u64)
            (recFieldLists
                :ast
                :symtab
                tid: (ztypes.tid.create from: cco.u64)
                names: cpn
                ids: cpi
                nameIds: cpiNm
            )
            if crB9 then {
                cargs: String
                ci: u64
                ccn: cpn.length
                cposIdx: u64
                for ci < ccn loop {
                    cpname: cpn.get i: ci
                    cpnameId: cpiNm.get i: ci
                    cav: ctorArgByLabel :ast :symtab :ctx :call label: cpname.stringview
                    if (ctorHasLabel :ast :call label: cpname.stringview) == false then {
                        cposUsed: false
                        cpv: ctorArgByPosition :ast :symtab :ctx :call idx: cposIdx
                        if cpv.length > 0 then {
                            cav = cpv
                            cposUsed = true
                        }
                        cposIdx = cposIdx + 1
                        if (cposUsed) == false then {
                            if (symtab.typing.declHasDefaultId
                                parentTypeId: tid
                                nameId: (zast.nameid.create from: cpnameId.u32.orPanic)
                            ) then {
                                cdt0: (symtab.typing.declDefaultOfId
                                    parentTypeId: tid
                                    nameId: (zast.nameid.create from: cpnameId.u32.orPanic)
                                )
                                cpid0: cpi.get i: ci
                                cav = (renderDefault
                                    :ast
                                    :symtab
                                    :ctx
                                    dv: cdt0
                                    targetTid: (ztypes.tid.create from: cpid0.u64)
                                )
                            }
                        }
                    }
                    if ci > 0 then cargs.append ", "
                    cargs.append cav
                    ci = ci + 1
                }
                ccb: ctxCname :ctx tid: (ztypes.tid.create from: cco.u64)
                ce: "\{ccb}(\{cargs})"
                return ce
            }
        }
    } case none then null
    fnames: (List String)
    fids: (ListVal u64)
    fidsNm: (ListVal u64)
    recFieldLists :ast :symtab :tid names: fnames ids: fids nameIds: fidsNm
    args: String
    fi: u64
    fn0: fnames.length
    fposIdx: u64
    for fi < fn0 loop {
        fname: fnames.get i: fi
        ffid0: fids.get i: fi
        fnameId: fidsNm.get i: fi
        av: ctorArgByLabel :ast :symtab :ctx :call label: fname.stringview
        # an absent label binds the next positional (unlabeled) arg by cursor; then a
        # registered default; then an fnptr slot's method address; else the "0" fallback.
        if (ctorHasLabel :ast :call label: fname.stringview) == false then {
            fposUsed: false
            fpv: ctorArgByPosition :ast :symtab :ctx :call idx: fposIdx
            if fpv.length > 0 then {
                av = fpv
                fposUsed = true
            }
            fposIdx = fposIdx + 1
            if (fposUsed) == false then {
                if (symtab.typing.declHasDefaultId
                    parentTypeId: tid
                    nameId: (zast.nameid.create from: fnameId.u32.orPanic)
                ) then {
                    cdt1: (symtab.typing.declDefaultOfId
                        parentTypeId: tid
                        nameId: (zast.nameid.create from: fnameId.u32.orPanic)
                    )
                    av = (renderDefault
                        :ast
                        :symtab
                        :ctx
                        dv: cdt1
                        targetTid: (ztypes.tid.create from: ffid0.u64)
                    )
                } else {
                    if (symtab.typing.declIsFnptrFieldId
                        parentTypeId: tid
                        nameId: (zast.nameid.create from: fnameId.u32.orPanic)
                    ) then {
                        av = ctxCname :ctx tid: (ztypes.tid.create from: ffid0.u64)
                    }
                }
            }
        }
        if fi > 0 then args.append ", "
        args.append av
        fi = fi + 1
    }
    rc: ctxCname :ctx :tid
    e0: "\{rc}_create(\{args})"
    return e0
}

# ctorArgIsBorrow / ctorArgIsBorrowPos -- bindingRhsIsBorrow over the
# argument ctorArgByLabel / ctorArgByPosition would emit: a hoisted
# borrow-returning result must not register a destroy.
ctorArgIsBorrow: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    label: StringView
} out bool is {
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringview == label then return (hoistExprIsBorrowRooted
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: a.operation.u64)
            )
        } else null
    }
    return false
}

# true when a constructor argument sits in a borrow position.
ctorArgIsBorrowPos: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    idx: u64
} out bool is {
    seen9: u64
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.length == 0 then {
                if seen9 == idx then return (hoistExprIsBorrowRooted
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                )
                seen9 = seen9 + 1
            }
        } else null
    }
    return false
}

# the constructor-argument node matching a field label.
ctorArgNodeByLabel: function {ast: Ast.view call: zast.CallData.view label: StringView} out u64 is {
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringview == label then return a.operation.u64
        } else null
    }
    return 0
}

# ctorArgByLabel -- that argument's emitted text. Selected through the node
# above so a caller can ask about the same argument by node.
ctorArgByLabel: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    label: StringView
} out String is {
    aid9: ctorArgNodeByLabel :ast :call :label
    if aid9 == 0 then return "0".string
    and9: ast.nodes.get i: aid9
    # an interpolated argument builds via a self-contained statement
    # expression (emitExpr cannot emit the chain)
    iv9: emitInterpArgExpr :ast :symtab :ctx n: and9
    if iv9.length > 0 then return iv9
    return (emitExpr :ast :symtab :ctx n: and9)
}

# argIsPointerByLabel -- true when the arg at `label` already evaluates to a C
# pointer (a reftype/List param or a `.lock` field), so a native by-pointer
# parameter must pass it directly rather than re-addressing it with `&`.
argIsPointerByLabel: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    label: StringView
} out bool is {
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringview == label then return (pathIsPointer
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: a.operation.u64)
            )
        } else null
    }
    return false
}

# ctorArgByPosition -- the idx-th POSITIONAL (unlabeled) argument's C text, for a
# method call passing args positionally (`this.formatLockHolder holder`) rather
# than by label; "" when there is no such arg.
ctorArgNodeByPosition: function {ast: Ast.view call: zast.CallData.view idx: u64} out u64 is {
    seen9: u64
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.length == 0 then {
                if seen9 == idx then return a.operation.u64
                seen9 = seen9 + 1
            }
        } else null
    }
    return 0
}

# ctorArgByPosition -- that argument's emitted text, selected through the node
# above so a caller can ask about the same argument by node.
ctorArgByPosition: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    idx: u64
} out String is {
    pid9: ctorArgNodeByPosition :ast :call :idx
    if pid9 == 0 then return "".string
    pnd9: ast.nodes.get i: pid9
    ip9: emitInterpArgExpr :ast :symtab :ctx n: pnd9
    if ip9.length > 0 then return ip9
    return (emitExpr :ast :symtab :ctx n: pnd9)
}

# ctorInterpArgByLabel -- the interp-arg form (emitInterpArgForParam) for the
# labeled argument, or "" when absent or not an interpolated literal. Lets a
# method/ctor call pass an interpolated literal directly (build + coerce + free).
ctorInterpArgByLabel: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    label: StringView
    fid: ztypes.tid
    pname: StringView
    pid: u64
} out String is {
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringview == label then {
                return (emitInterpArgForParam
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                    :fid
                    :pname
                    :pid
                )
            }
        } else null
    }
    return "".string
}

# ctorInterpArgByPosition -- the interp-arg form for the idx-th positional argument.
ctorInterpArgByPosition: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    idx: u64
    fid: ztypes.tid
    pname: StringView
    pid: u64
} out String is {
    seen9: u64
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.length == 0 then {
                if seen9 == idx then {
                    return (emitInterpArgForParam
                        :ast
                        :symtab
                        :ctx
                        n: (ast.nodes.get i: a.operation.u64)
                        :fid
                        :pname
                        :pid
                    )
                }
                seen9 = seen9 + 1
            }
        } else null
    }
    return "".string
}

# argSlotList -- per call-argument (in call order), the index of the parameter
# slot it binds in `fpNames` (declaration order): a named arg binds by name, an
# unlabelled arg binds the next free slot via a positional cursor (first-arg
# elision). Returns `fpNames.length` (an out-of-range sentinel) for an argument
# that binds no value slot (e.g. a generic type-arg, whose name is not a value
# param). Lets a call's named args be emitted to C in PARAMETER order.
argSlotList: function {
    ast: Ast.view
    call: zast.CallData.view
    fpNames: (List String).view
} out ListVal u64 is {
    out9: (ListVal u64)
    cn9: fpNames.length
    consumed9: (ListVal bool)
    ci9: u64
    for ci9 < cn9 loop {
        consumed9.append false
        ci9 = ci9 + 1
    }
    cursor9: u64
    aiter9: call.arguments.iterate
    for a9Id9: aiter9 loop {
        a9: ast.nodes.get i: a9Id9.u64
        match (
            a9
        ) case namedoperation then {
            lbl9: zast.nameTextAt :ast ref: a9.name
            slot9: fpNames.length
            if lbl9.length > 0 then {
                fi9: u64
                for fi9 < cn9 loop {
                    fpn9: fpNames.get i: fi9
                    if fpn9.stringview == lbl9.stringview then slot9 = fi9
                    fi9 = fi9 + 1
                }
            } else {
                adv9: true
                for adv9 loop {
                    if cursor9 >= cn9 then {
                        adv9 = false
                    } else {
                        if (consumed9.get i: cursor9) then {
                            cursor9 = cursor9 + 1
                        } else {
                            adv9 = false
                        }
                    }
                }
                if cursor9 < cn9 then {
                    slot9 = cursor9
                    cursor9 = cursor9 + 1
                }
            }
            if slot9 < cn9 then consumed9.set i: slot9 val: true
            out9.append slot9
        } else {
            out9.append fpNames.length
        }
    }
    return out9
}

# cvalText -- the C literal for a compile-time value the typechecker folded.
# "" for a kind this emitter cannot render yet, which leaves the caller on its
# ordinary path rather than emitting something wrong.
# constSuffixForTid -- the C literal suffix a constant of type `tid` needs, so
# a value renders the way the rendered TEXT used to: `u32` wants U, `u64` wants
# ULL, and a scalar typedef wants whatever its base wants (`nameid` -> u32 ->
# U). The name-based half of this is literalSuffixBase's, which answers the
# same question starting from a suffix NAME rather than from a type.
constSuffixForTid: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out String is {
    if tid.isZero then return "".string
    tn9: typeNameOfReg9 :symtab :tid
    if tn9.length == 0 then return "".string
    # scalarCTypeFor rather than cTypeOf: it re-checks the tid for a user
    # shadow, so a user type named `u32` cannot pick up u32's C suffix. The
    # name lookup it needs is the shape shadow-guard sanctions.
    if (scalarCTypeFor :symtab name: tn9.stringview :tid).length > 0 then {
        return (numLitSuffix name: tn9.stringview)
    }
    # a scalar TYPEDEF chases to the builtin it spells, keyed by tid so the
    # answer does not depend on which unit the read happens in. numLitSuffix
    # yields "" for a name that is not a builtin, so no second scalar test is
    # needed here.
    bo9: symtab.typing.typedefBaseName.get key: tid
    match (
        bo9
    ) case some then {
        bn9: bo9.copy
        return (numLitSuffix name: bn9.stringview)
    } case none then null
    return "".string
}

cvalText: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
    v: ztypes.cval
} out String is {
    if v.kind.ivalKind then {
        iv: v.ival
        r9: "\{iv}"
        r9.append (constSuffixForTid :symtab :tid)
        return r9
    }
    if v.kind.fvalKind then {
        fv: v.fval
        return "\{fv}"
    }
    if v.kind.armKind then {
        if v.armTid.isZero then return "".string
        if v.armName.isZero then return "".string
        an9: ast.names.texts.get i: v.armName.u32.u64
        # a variant that maps onto a scalar C type (bool) renders as that
        # scalar; anything else is the payload-less compound literal
        # emitInlineVariantCtor builds for the same arm written as a call
        av9: armValueC :symtab tid: v.armTid arm: an9.stringview
        if av9.length > 0 then return av9
        tg9: variantTag :symtab tid: v.armTid arm: an9.stringview
        if tg9.length == 0 then return "".string
        vc9: ctxCname :ctx tid: v.armTid
        if vc9.length == 0 then return "".string
        return "((\{vc9}_t){ .tag = \{tg9} })"
    }
    return "".string
}

# cvalStrText -- the C text for a folded STRING value: a `_zcsN` static minted
# in ctx.constLits. "" for any other kind, which leaves the caller on its
# ordinary path exactly as cvalText's "" does.
#
# Deduplicated by TEXT, not by origin: two constants that fold to the same bytes
# are one static, and a folded value has no node identity to key on anyway.
cvalStrText: function {symtab: zenv.ZSymbolTable.view ctx: Ctx v: ztypes.cval} out String is {
    if (v.kind.svalKind) == false then return "".string
    if v.strId == 0 then return "".string
    t9: symtab.typing.constStrings.get i: v.strId.u64
    i9: u64
    n9: ctx.constLits.length
    hit9: u64
    for i9 < n9 loop {
        if hit9 == 0 then {
            e9: ctx.constLits.get i: i9
            if e9.stringview == t9.stringview then hit9 = i9 + 1
        }
        i9 = i9 + 1
    }
    if hit9 > 0 then {
        rh9: "_zcs\{hit9}"
        return rh9
    }
    ctx.constLits.append t9.copy
    r0: "_zcs\{ctx.constLits.length}"
    return r0
}

# foldedBranchOf9 -- the clause the typechecker's constant fold selected for an
# `if` or a `match`. `known` false means the conditions did not all fold, so a
# runtime branch must be emitted; `known` true with a zero stmt means nothing
# was selected and nothing is emitted at all.
foldedBranchOf9: function {symtab: zenv.ZSymbolTable.view nid: u64} out ztyping.foldedbranch is {
    go: symtab.typing.foldedBranch.get key: nid
    match (
        go
    ) case some then {
        return go
    } case none then {
        return (ztyping.foldedbranch known: false stmt: zast.nodeid)
    }
}

# nodeConstText -- the C literal for a node carrying a compile-time
# const stamp (folded .LABEL data access, unit constants); "" otherwise.
nodeConstText: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    nid: zast.nodeid
} out String is {
    if nid.isZero then return "".string
    g9: symtab.typing.nodeConst.get key: nid.u64
    match (
        g9
    ) case some then {
        tv9: ztyping.nodeTypeAt tbl: symtab.typing.nodeType nid: nid.u64
        sc9: cvalText :ast :symtab :ctx tid: tv9 v: g9
        if sc9.length > 0 then return sc9
        return (cvalStrText :symtab :ctx v: g9)
    } case none then {
        return "".string
    }
}

# memberCvalTid9 -- the declared type of a unit constant, 0 when it has none.
memberCvalTid9: function {
    symtab: zenv.ZSymbolTable.view
    unitTid: ztypes.tid
    nameId: zast.nameid
} out ztypes.tid is {
    co9: symtab.typing.declChildOfId parentTypeId: unitTid :nameId
    match (
        co9
    ) case some then {
        return (ztypes.tid.create from: co9)
    } case none then {
        return ztypes.tid
    }
}

# memberConstTextOf9 -- the C text for a unit constant, rendered from its VALUE
# and carrying the literal suffix its declared type asks for. "" when the
# member has no compile-time value, which is what leaves the caller on its
# ordinary path. SCALARS ONLY: it answers on a Ctx.view, which is what lets
# scalarArmLabel keep using it, and a folded string needs the mutable Ctx that
# memberConstStrText9 takes.
memberConstTextOf9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    unitTid: ztypes.tid
    nameId: zast.nameid
} out String is {
    if unitTid.isZero then return "".string
    if nameId.isZero then return "".string
    mv9: symtab.typing.memberConstOf parentTypeId: unitTid :nameId
    if mv9.kind.none then return "".string
    mt9: memberCvalTid9 :symtab :unitTid :nameId
    return (cvalText :ast :symtab :ctx tid: mt9 v: mv9)
}

# memberConstStrText9 -- the `_zcsN` a STRING constant renders as. The string
# half of memberConstTextOf9, split off rather than folded into it because
# minting needs a mutable Ctx and one caller -- scalarArmLabel, building a C
# case label -- can only ever want the scalar half: a case label is a scalar by
# definition, so the string pool must not be on its path.
memberConstStrText9: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    unitTid: ztypes.tid
    nameId: zast.nameid
} out String is {
    if unitTid.isZero then return "".string
    if nameId.isZero then return "".string
    mv9: symtab.typing.memberConstOf parentTypeId: unitTid :nameId
    return (cvalStrText :symtab :ctx v: mv9)
}

# unitTidOf9 -- the type id of the unit named `unitName`, or 0.
unitTidOf9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    unitName: StringView
} out ztypes.tid is {
    return (ztypecheck.declTypeIdOf
        ty: symtab.typing
        declId: (symtab.typing.declFindChild
            parentDeclId: symtab.typing.programRoot
            nameId: (zast.poolFind pool: ast.names text: unitName)
        )
    )
}

# emitMetaCreateCall -- `meta.create field: val ...`, the enclosing type's raw
# allocator (its field children as params). The typecheck stamps the call node
# with that type; emit `{type}_meta_create(args)` (never `_create`, which the
# user's own create may override -> recursion). "" when not a meta.create.
# ctorHasLabel -- whether a call carries a named argument with this label.
ctorHasLabel: function {ast: Ast.view call: zast.CallData.view label: StringView} out bool is {
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringview == label then return true
        } else null
    }
    return false
}

# emit a `.create` meta-constructor call.
emitMetaCreateCall: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    mcb: ztypecheck.metaCreateBaseId :ast n: (ast.nodes.get i: call.callable.u64)
    match (
        mcb
    ) case some then {
        et: stampIdOf :symtab nid: call.nodeid.u64
        if et.isZero then return "".string
        fnames: (List String)
        fids: (ListVal u64)
        fidsNm: (ListVal u64)
        recFieldLists :ast :symtab tid: et names: fnames ids: fids nameIds: fidsNm
        args: String
        fi: u64
        fn0: fnames.length
        for fi < fn0 loop {
            fname: fnames.get i: fi
            av: String
            if (ctorHasLabel :ast :call label: fname.stringview) then {
                av = ctorArgByLabel :ast :symtab :ctx :call label: fname.stringview
            } else {
                # a field absent from the meta.create args (a generator's promoted
                # local: an inner iterator struct or a loop counter) is value-
                # initialized; a typed zero compiles for both scalars and structs.
                ffid: fids.get i: fi
                ffct: (typeRefC
                    :ast
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: ffid.u64)
                    thisTid: ztypes.tid
                )
                if ffct.length == 0 then {
                    pmsg7: "zemitterc: unspellable field type id \{ffid}"
                    panic pmsg7
                }
                if (symtab.typing.declIsLockField
                    pool: ast.names
                    parentTypeId: et
                    name: fname.stringview
                ) when (lockFieldIsReftypePtr
                    :ast
                    :symtab
                    :ctx
                    fid: (ztypes.tid.create from: ffid.u64)
                ) then ffct = "\{ffct}*"
                av = "(\{ffct}){0}"
            }
            if fi > 0 then args.append ", "
            args.append av
            fi = fi + 1
        }
        ecb: ctxCname :ctx tid: et
        e0: "\{ecb}_meta_create(\{args})"
        return e0
    } case none then {
        return "".string
    }
}

# emitCrossUnitFnCall -- a cross-unit free-function call `unit.fn args`
# (e.g. zparser calling a zast/zlexer helper). The callee is a dottedpath whose
# base is a unit name; the function's shared id lives in resolved["{unit}.{fn}"],
# so emit z_t{id}_{fn}(args) with the same reftype-by-ref arg handling as a bare
# free-function call. "" when the callee is not a cross-unit function.
emitByrefArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    av: StringView
    pid: ztypes.tid
    isBorrow: bool
} out String is {
    if (isNonLvalueArg s: av) == false then return "&\{av}"
    hn: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    nmH: "_ah\{hn}"
    hcty: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: pid.u64) thisTid: ztypes.tid
    htyc: hcty.copy
    hrid: pid
    hduo: definedInUnitOf :symtab tid: (ztypes.tid.create from: pid.u64)
    match (
        hduo
    ) case none then {
        htn0: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: pid.u64)
        hrr: (canonTypeId
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: pid.u64)
            name: htn0.stringview
        )
        if hrr > 0 then hrid = ztypes.tid.create from: hrr.u64
    } case some then null
    hdt: String
    if isBorrow then {} else if hrid == ctx.strTid then {
        hdt = "    \{ctx.strC}_free(&\{nmH});\n"
    } else {
        if (symtab.reg.hasDestructorName typeId: hrid) then {
            hcb: ctxCname :ctx tid: (ztypes.tid.create from: hrid.u64)
            hdt = "    \{hcb}_destroy(&\{nmH});\n"
        }
    }
    avc: av.string
    r: "&\{nmH}"
    ctx.argHoistVals.append avc
    ctx.argHoistTypes.append htyc
    ctx.argHoistDtors.append hdt
    ctx.argHoistNames.append nmH
    return r
}

# fnIsNativeId -- the fn id's isNative flag (a mono inherits it from its
# native template at mint).
fnIsNativeId: function {symtab: zenv.ZSymbolTable fid: ztypes.tid} out bool is {
    return (symtab.reg.isNativeOf tid: fid)
}

# emitGenericFnCall -- a generic free-function call (identity 42): the callable
# atom is stamped to the mono FUNCTION id by checkGenericCall. Emit that mono's
# cname applied to the args. "" when the callable does not resolve to a mono fn,
# or when the mono's template is NATIVE (no emitted body -- its C comes from a
# name interception like z_stringJoin).
emitGenericFnCall: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    gdc9: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if gdc9.length > 0 then return "".string
    gmf9: stampIdOf :symtab nid: (nodeIdOf9 n: (ast.nodes.get i: call.callable.u64))
    if gmf9.isZero then return "".string
    if (symtab.reg.typetypeOf typeId: gmf9) != ztypes.ztypetype.functionType then return "".string
    gmo9: originTidOf :symtab tid: gmf9
    if gmo9.isZero then return "".string
    if (fnIsNativeId :symtab fid: gmf9) then return "".string
    fc9: ctxCname :ctx tid: gmf9
    fpNames9: (List String)
    fpIds9: (ListVal u64)
    fpIds9Nm: (ListVal u64)
    recFieldLists :ast :symtab tid: gmf9 names: fpNames9 ids: fpIds9 nameIds: fpIds9Nm
    slots9g: argSlotList :ast :call fpNames: fpNames9
    valBySlot9g: (IdMapR u64 value: String)
    ai9: u64
    aiter9: call.arguments.iterate
    for a9Id9: aiter9 loop {
        a9: ast.nodes.get i: a9Id9.u64
        match (
            a9
        ) case namedoperation then {
            opf2059: ast.nodes.get i: a9.operation.u64
            opf2049: ast.nodes.get i: a9.operation.u64
            slot9g: slots9g.get i: ai9
            if slot9g < fpNames9.length then {
                fpid9: fpIds9.get i: slot9g
                fpnO9: fpNames9.get i: slot9g
                iav9: (emitInterpArgForParam
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a9.operation.u64)
                    fid: gmf9
                    pname: fpnO9.stringview
                    pid: fpid9
                )
                if iav9.length > 0 then {
                    valBySlot9g.set key: slot9g value: iav9
                } else {
                    av9: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a9.operation.u64)
                    avq9: (atomVidIfPlain
                        :ast
                        :symtab
                        :ctx
                        n: (ast.nodes.get i: a9.operation.u64)
                        text: av9.stringview
                    )
                    byref9: false
                    argRef9: String
                    ptra9: false
                    if (paramIsReceiverName
                        :ast
                        :symtab
                        fid: gmf9
                        pname: fpnO9.stringview
                    ) then ptra9 = true
                    if (markedValtypeRefParam
                        :ast
                        :symtab
                        fid: gmf9
                        pname: fpnO9.stringview
                        pid: fpid9
                    ) then ptra9 = true
                    if (symtab.typing.declOwnershipIs
                        pool: ast.names
                        parentTypeId: gmf9
                        name: fpnO9.stringview
                        own: ztypes.zparamownership.takeMode
                    ) == false when (isReftypeParam
                        :ast
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: fpid9.u64)
                    ) then {
                        ptra9 = true
                    } else {
                        if (isBorrowStringParam
                            :ast
                            :symtab
                            fid: gmf9
                            pname: fpnO9.stringview
                            pid: (ztypes.tid.create from: fpid9.u64)
                        ) then ptra9 = true
                    }
                    if (ptra9) == false then {
                        if (isListPtrParam
                            :ast
                            :symtab
                            :ctx
                            fid: gmf9
                            pname: fpnO9.stringview
                            tid: (ztypes.tid.create from: fpid9.u64)
                        ) then ptra9 = true
                    }
                    if ptra9 then {
                        if (isPtrVid :ctx vid: avq9) == false then {
                            byref9 = true
                            argRef9 = (emitByrefArg
                                :ast
                                :symtab
                                :ctx
                                av: av9.stringview
                                pid: (ztypes.tid.create from: fpid9.u64)
                                isBorrow: (hoistExprIsBorrowRooted :ast :symtab :ctx n: opf2049)
                            )
                        }
                    }
                    vbh9x: String
                    if (ptra9) == false then {
                        vbh9x = (hoistBorrowValArg
                            :ast
                            :symtab
                            :ctx
                            av: av9.stringview
                            pid: (ztypes.tid.create from: fpid9.u64)
                            paramTake: (symtab.typing.declOwnershipIs
                                pool: ast.names
                                parentTypeId: gmf9
                                name: fpnO9.stringview
                                own: ztypes.zparamownership.takeMode
                            )
                            isBorrow: (hoistExprIsBorrowRooted :ast :symtab :ctx n: opf2059)
                        )
                    }
                    finalS9g: av9.copy
                    if byref9 then {
                        finalS9g = argRef9.copy
                    } else {
                        if vbh9x.length > 0 then finalS9g = vbh9x.copy
                    }
                    valBySlot9g.set key: slot9g value: finalS9g
                }
            }
            ai9 = ai9 + 1
        } else null
    }
    args9: String
    emitted9g: u64
    pp9g: u64
    ppn9g: fpNames9.length
    for pp9g < ppn9g loop {
        vo9g: valBySlot9g.get key: pp9g
        match (
            vo9g
        ) case some then {
            if emitted9g > 0 then args9.append ", "
            args9.append vo9g
            emitted9g = emitted9g + 1
        } case none then null
        pp9g = pp9g + 1
    }
    e9: "\{fc9}(\{args9})"
    return e9
}

