                    av9: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64)
                    avq9: (atomVidIfPlain
                        :ast
                        :symtab
                        :ctx
                        n: (ast.nodes.get i: a.operation.u64)
                        text: av9.stringview
                    )
                    byref8: false
                    argRef8: String
                    vbh8c: String
                    ptra8: false
                    if (paramIsReceiverName
                        :ast
                        :symtab
                        :fid
                        pname: fpnO8.stringview
                    ) then ptra8 = true
                    if (markedValtypeRefParam
                        :ast
                        :symtab
                        :fid
                        pname: fpnO8.stringview
                        pid: fpid8
                    ) then ptra8 = true
                    if (symtab.typing.declOwnershipIs
                        pool: ast.names
                        parentTypeId: fid
                        name: fpnO8.stringview
                        own: ztypes.zparamownership.takeMode
                    ) == false when (isReftypeParam
                        :ast
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: fpid8.u64)
                    ) then {
                        ptra8 = true
                    } else {
                        if (isBorrowStringParam
                            :ast
                            :symtab
                            :fid
                            pname: fpnO8.stringview
                            pid: (ztypes.tid.create from: fpid8.u64)
                        ) then ptra8 = true
                    }
                    if (ptra8) == false then {
                        if (isListPtrParam
                            :ast
                            :symtab
                            :ctx
                            :fid
                            pname: fpnO8.stringview
                            tid: (ztypes.tid.create from: fpid8.u64)
                        ) then ptra8 = true
                    }
                    if ptra8 then {
                        if (isPtrVid :ctx vid: avq9) == false then {
                            byref8 = true
                            argRef8 = (emitByrefArg
                                :ast
                                :symtab
                                :ctx
                                av: av9.stringview
                                pid: (ztypes.tid.create from: fpid8.u64)
                                isBorrow: (hoistExprIsBorrowRooted :ast :symtab :ctx n: opf2089)
                            )
                        }
                    }
                    if (ptra8) == false then {
                        vbh8c = (hoistBorrowValArg
                            :ast
                            :symtab
                            :ctx
                            av: av9.stringview
                            pid: (ztypes.tid.create from: fpid8.u64)
                            paramTake: (symtab.typing.declOwnershipIs
                                pool: ast.names
                                parentTypeId: fid
                                name: fpnO8.stringview
                                own: ztypes.zparamownership.takeMode
                            )
                            isBorrow: (hoistExprIsBorrowRooted :ast :symtab :ctx n: opf2099)
                        )
                    }
                    finalS9c: av9.copy
                    if byref8 then {
                        finalS9c = argRef8.copy
                    } else {
                        if vbh8c.length > 0 then finalS9c = vbh8c.copy
                    }
                    valBySlot9c.set key: slot9c value: finalS9c
                }
            }
            ai8 = ai8 + 1
        } else null
    }
    args: String
    emitted9c: u64
    pp9c: u64
    ppn9c: fpNames.length
    for pp9c < ppn9c loop {
        vo9c: valBySlot9c.get key: pp9c
        match (
            vo9c
        ) case some then {
            if emitted9c > 0 then args.append ", "
            args.append vo9c
            emitted9c = emitted9c + 1
        } case none then null
        pp9c = pp9c + 1
    }
    e8: "\{fc}(\{args})"
    return e8
}

# emitCrossUnitCtor -- construction of a cross-unit record/class
# `unit.TypeName field: val ...` (e.g. a Node arm's zast.ErrorData payload):
# resolve the type via the shared cross-unit identity and route to the field-wise
# (or user-create) constructor. "" when not such a construction.
# dottedParentChild -- the middle segment of a 3-segment dotted path `a.b.c`:
# the child text of the parent (`b`). "" when not a nested dotted path.
dottedParentChild: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (dottedParentChild :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (dottedChildText :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

