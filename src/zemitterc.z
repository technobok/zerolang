# zemitterc -- the C17 emitter. A typed-AST-to-C pass over the typechecker's
# stamps: the runtime preamble and the fragments/templates under src/runtime
# the program demands, the string-literal pool, then every reachable type and
# function, in sections assembled at the end. Unhandled shapes record an
# emitFail: zc reports every failure and exits nonzero without writing output.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :emitC
    :nativeConvRows
}

astnode: zast.astnode
Ast: zast.Ast


# OwedFree -- one destructor owed at the end of a block: the C name of the
# local it destroys, the statement that destroys it (empty for a plain String,
# whose free is composed where it is emitted so it can take that site's
# indent), and the variable behind it -- the alias table is keyed by variable,
# so only this can probe it; 0 for a synthesized temp, which is never a binding
# and so never aliased. One row, so the three cannot drift apart when a block
# flush pops them.
OwedFree: class {
    # the C identifier the destructor takes
    name: String
    # the full destructor statement, or empty for a plain String free
    stmt: String
    # the variable the local binds, 0 for a temp
    vid: ztypes.vid
}

# TmpCtr -- per-function temp name counter, and the destructors owed at the
# end of each open block.
TmpCtr: class {
    # the next temp number, so two temps in one function never collide
    n: u64
    # plain String frees owed at the end of the current block
    frees: List OwedFree
    # collection destructor calls owed at block end, kept apart because they are
    # emitted in the other order
    listFrees: List OwedFree
} as {
    # the next temp number, taken and consumed. Numbers are per FUNCTION, not
    # per block, so a temp in one block cannot collide with one in a sibling
    next: function {:this} out u64 is {
        v: this.n
        this.n = this.n + 1
        return v
    }

    # oweFree -- a String local to free at block end
    oweFree: function {:this name: String.take vid: ztypes.vid} is {
        this.frees.append (OwedFree :name stmt: String :vid)
    }

    # oweList -- a collection or class local to destroy at block end
    oweList: function {:this stmt: String.take name: String.take vid: ztypes.vid} is {
        this.listFrees.append (OwedFree :name :stmt :vid)
    }
}

# opCnameOf -- a C-identifier spelling for an operator method name (a
# typedef's shadowed `==`, a numeric `+`), "" for ordinary names.
opCnameOf: function {name: StringView} out String is {
    if name == "==" then return "op_eq".string
    if name == "!=" then return "op_ne".string
    if name == "<=" then return "op_le".string
    if name == ">=" then return "op_ge".string
    if name == "<" then return "op_lt".string
    if name == ">" then return "op_gt".string
    if name == "+" then return "op_add".string
    if name == "-" then return "op_sub".string
    if name == "*" then return "op_mul".string
    if name == "/" then return "op_div".string
    if name == "%" then return "op_mod".string
    if name == "&" then return "op_and".string
    return "".string
}

# cnameOf -- the id-based C name base for a type ("z_t{id}_{name}", dots
# joined with underscores).
cnameOf: function {tid: ztypes.tid ownerName: StringView name: StringView} out String is {
    flat: opCnameOf :name
    if flat.length == 0 then {
        biter: u64
        n: name.length
        for biter < n loop {
            bo: name.byteAt i: biter
            match (
                bo
            ) case some then {
                if bo == 46 then {
                    flat.append "_"
                } else {
                    identB: false
                    if bo >= 97 when bo <= 122 then identB = true
                    if bo >= 65 when bo <= 90 then identB = true
                    if bo >= 48 when bo <= 57 then identB = true
                    if bo == 95 then identB = true
                    if identB then {
                        flat.appendByte b: bo
                    } else {
                        flat.append "_"
                    }
                }
            } case none then null
            biter = biter + 1
        }
    }
    if ownerName.length == 0 then return "z_t\{tid}_\{flat}"
    oflat: ownerName.replace needle: "." replacement: "_"
    joined: "\{oflat}_\{flat}"
    return "z_t\{tid}_\{joined}"
}

# listCname -- a type's C name base from the table composed once at the start
# of emitC. "" when the id names no registered type.
listCname: function {cnames: (List String).view tid: ztypes.tid} out String is {
    if tid >= cnames.length then return "".string
    got: cnames.get i: tid
    return got.copy
}

# ctxCname -- listCname against the table the emission context carries.
ctxCname: function {ctx: Ctx.view tid: ztypes.tid} out String is {
    return (listCname cnames: ctx.cnames :tid)
}

# atomVid -- the variable a reference node resolves to, or 0.
atomVid: function {symtab: zenv.ZSymbolTable.view nid: u64} out ztypes.vid is {
    return ((symtab.typing.atomVariableId.get key: nid).or d: (ztypes.vid.create from: 0))
}

# defVid -- the variable a binding node introduces, or 0.
defVid: function {symtab: zenv.ZSymbolTable.view nid: u64} out ztypes.vid is {
    return ((symtab.typing.defVariableId.get key: nid).or d: (ztypes.vid.create from: 0))
}

# atomNodeIdDeep -- atomNodeId through `expression` wrappers, mirroring
# atomTextDeep so an id and a text always describe the same node.
atomNodeIdDeep: function {ast: Ast.view n: astnode.view} out u64 is {
    match (
        n
    ) case expression then {
        return (atomNodeIdDeep :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return n.nodeid.u64
    } else {
        return 0
    }
}

# atomVidIfPlain -- the variable an already-emitted value expression names, but
# only when the emitted text is that atom's own source name. An alias
# substitution, a C-keyword mangle or any compound expression makes the text
# something other than the binding, and then there is no variable to ask a
# pointer question about -- which is what a name compare answers by missing.
atomVidIfPlain: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: astnode.view
    text: StringView
} out ztypes.vid is {
    match (
        n
    ) case expression then {
        nx: ast.nodes.get i: n.expression.u64
        return (atomVidIfPlain :ast :symtab :ctx n: nx :text)
    } case atomid then {
        at: zast.nameTextAt :ast ref: n.name
        atomVarId: atomVid :symtab nid: n.nodeid.u64
        ae: emitLocalAtomName :ctx name: at.stringView vid: atomVarId
        if ae.stringView != text then return (ztypes.vid.create from: 0)
        return atomVarId
    } case labelvalue then {
        # the `:name` shorthand names a binding just as a bare atom does
        lv: zast.nameTextAt :ast ref: n.name
        lvv: atomVid :symtab nid: n.nodeid.u64
        le: emitLocalAtomName :ctx name: lv.stringView vid: lvv
        if le.stringView != text then return (ztypes.vid.create from: 0)
        return lvv
    } case dottedpath then {
        # a dotted path can still emit as its bare base -- a `.private` access
        # marker contributes no C text -- and then the base IS the value passed.
        dbn: ast.nodes.get i: n.parent.u64
        db: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: dbn)
        if db.length == 0 then return (ztypes.vid.create from: 0)
        dbv: atomVid :symtab nid: (atomNodeId n: dbn)
        de: emitLocalAtomName :ctx name: db.stringView vid: dbv
        if de.stringView != text then return (ztypes.vid.create from: 0)
        return dbv
    } else {
        return (ztypes.vid.create from: 0)
    }
}

# paramVidIn -- paramVidByNameId against a parameter list the caller already
# holds, rather than one reached through a function node. 0 when no parameter
# carries that name.
paramVidIn: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    params: zast.kidspan
    nameId: zast.nameid
} out ztypes.vid is {
    if nameId.isZero then return (ztypes.vid.create from: 0)
    h1x9: u64
    for h1x9 < params.count.u64 loop {
        pmId: zast.kidAt kids: ast.kids span: params i: h1x9
        h1x9 = h1x9 + 1
        pm: ast.nodes.get i: pmId.u64
        if pm.namedoperation then {
            if pm.name == nameId when pm.operation > 0 then {
                opNid: interpPartNodeId n: (ast.nodes.get i: pm.operation.u64)
                return (defVid :symtab nid: opNid)
            }
        }
    }
    return (ztypes.vid.create from: 0)
}

# paramVidByNameId -- the variable behind parameter `nameId` of the function
# node `op`, or 0. The type checker mints a parameter's variable while walking
# the AST parameter list and stamps it on the node the parameter WRAPS, so read
# it back the same way. The declaration tree cannot supply it: a generic clone
# shares its template's declaration, so a member lookup there answers with one
# node for every parameter alike.
paramVidByNameId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    op: astnode.view
    nameId: zast.nameid
} out ztypes.vid is {
    match (
        op
    ) case expression then {
        opx: ast.nodes.get i: op.expression.u64
        return (paramVidByNameId :ast :symtab op: opx :nameId)
    } case functiondef then {
        return (paramVidIn :ast :symtab params: op.parameters :nameId)
    } else {
        return (ztypes.vid.create from: 0)
    }
}

# cnameById -- a type's default C name: its id alone. The emitted C is a
# build artifact rather than a reading surface, so the source name rides
# along only under --readable-names.
cnameById: function {tid: ztypes.tid} out String is {
    return "z_t\{tid}"
}

# cTypeOf -- the C spelling of a scalar type NAME ("" when not scalar). A NAME is
# not an identity, so this is never the answer on its own: a caller holding a tid
# must go through scalarCTypeFor, which asks the declaration whether the tid is
# the builtin behind the name. shadow-guard holds the count down.
#
# The C spelling has to be SOMEWHERE, and the one place it cannot live is the
# table it helps build:
# convBodyOf reads it to GENERATE the natives.tbl conversion rows, so moving the
# spelling into that table would have the generator reading its own output. The
# rest have no declaration to ask -- two want a scalar-NAME predicate rather than
# a C type, and the others start from a typedef base name or an AST type name,
# with no tid in hand.
cTypeOf: function {name: StringView} out String is {
    if name == "i8" then return "int8_t".string
    if name == "i16" then return "int16_t".string
    if name == "i32" then return "int32_t".string
    if name == "i64" then return "int64_t".string
    if name == "u8" then return "uint8_t".string
    if name == "u16" then return "uint16_t".string
    if name == "u32" then return "uint32_t".string
    if name == "u64" then return "uint64_t".string
    if name == "i128" then return "__int128".string
    if name == "u128" then return "unsigned __int128".string
    if name == "f16" then return "_Float16".string
    if name == "f32" then return "float".string
    if name == "f64" then return "double".string
    if name == "f128" then return "__float128".string
    if name == "c8" then return "uint8_t".string
    if name == "c32" then return "uint32_t".string
    return "".string
}

# cFloatLitSuffix -- the C literal suffix that parses a float literal at
# the named width (single rounding): f (float), f16 (_Float16), Q
# (__float128); f64 literals stay bare (double).
cFloatLitSuffix: function {name: StringView} out String is {
    if name == "f32" then return "f".string
    if name == "f16" then return "f16".string
    if name == "f128" then return "Q".string
    return "".string
}

# isFloatLitText -- the expression text is a bare digit-led float literal
# (decimal point or exponent; no identifier characters).
isFloatLitText: function {s: StringView} out bool is {
    n: s.length
    if n == 0 then return false
    b0: s.byteAt 0
    match (
        b0
    ) case some then {
        if b0 < 48 then return false
        if b0 > 57 then return false
    } case none then {
        return false
    }
    hasDotE: false
    i: u64
    for i < n loop {
        bo: s.byteAt i
        match (
            bo
        ) case some then {
            ok: false
            if bo >= 48 when bo <= 57 then ok = true
            if bo == 46 then {
                ok = true
                hasDotE = true
            }
            if bo == 101 then {
                ok = true
                hasDotE = true
            }
            if bo == 69 then {
                ok = true
                hasDotE = true
            }
            if bo == 43 then ok = true
            if bo == 45 then ok = true
            if ok == false then return false
        } case none then {
            return false
        }
        i = i + 1
    }
    return hasDotE
}

# scalarTidIsBuiltin -- asked only where cTypeOf has already matched the NAME:
# is this tid the runtime-backed type behind that name, or a USER type wearing
# it? The DECLARATION answers it. The sixteen scalars are `record is native` and
# the two literal pseudo-types are minted by the registry itself, so the marker
# covers eighteen of cTypeOf's nineteen names; a user's `i64: record { hi: 0 }`
# carries no marker and is a shadow. `bool` carries it too: the grammar gives
# `is native`
# only to a type with no is-block -- and `bool` is a native VARIANT, which keeps
# its arms, so the marker covers all nineteen.
#
# A tid with no defining unit is a SHELL -- a fresh param/field child named
# after the real type -- not a user type wearing the name. There is no
# declaration there to shadow with, so it keeps the C scalar, as typeRefC says
# of shells. Asked of the declaration directly rather than through its unit's
# name, which is the same question one step earlier.
scalarTidIsBuiltin: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out bool is {
    if (symtab.reg.isNativeOf tid: (ztypes.tid.create from: tid.u64)) then return true
    dc: symtab.typing.declIdOfType typeId: (ztypes.tid.create from: tid.u64)
    return dc.isZero
}

# ordinalVariantCType -- the C scalar a VARIANT lowers to instead of a tag
# struct, "" when it needs one. A variant whose arms all carry no payload is an
# ordinal: nothing distinguishes one value from another but which arm it is, so
# a tagged struct carries nothing. TWO ordinals are exactly C `bool`. The
# checker records the shape, discriminator included, so this asks what the type
# IS rather than what it is called -- `bool` is the stdlib instance of the
# shape, and a user variant of the same shape gets the same C.
#
# Three-and-more-arm ordinals are the same argument and still get the struct;
# unwrapping those changes the C type every field, param and local of them is
# spelled with, which is its own change.
ordinalVariantCType: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out String is {
    ao: symtab.typing.ordinalVariant.get key: tid.u64
    match (
        ao
    ) case some then {
        if ao == 2 then return "bool".string
        # every recorded ordinal has a u8 discriminator BY CONSTRUCTION: the
        # checker only records one whose values are the arm ordinals, which is
        # the spec's default (u8, sequential from 0) or an explicit u8
        return "uint8_t".string
    } case none then {
        return "".string
    }
}

# tagStorageCType -- the C type a tagged type's DISCRIMINATOR is stored in, from
# what the declaration asked for (`tag: u8.tag`, or the spec's u8 default). The
# enum stays for the constants; it just stops being the storage, because a C
# enum is `int` and spelling the field with it ignores the declaration -- a
# `tag: u8.tag` was silently four bytes.
#
# "" when the type declares a `data`-sourced tag, whose constants set their own
# width, or when nothing was recorded: the enum remains the storage there.
tagStorageCType: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out String is {
    key: tid.u64
    # a MONO carries no declaration of its own: the template it was minted from
    # is where the tag was declared, and the instance stores it the same way
    {
        go: genericOriginTid :symtab :tid
        if go > 0 then {
            hasOwn: false
            {
                o: symtab.typing.variantTagBase.get key: tid.u64
                match (
                    o
                ) case some then {
                    hasOwn = true
                } case none then null
            }
            if hasOwn == false then key = go.u64
        }
    }
    tb: symtab.typing.variantTagBase.get :key
    match (
        tb
    ) case some then {
        # 0 is a data-sourced tag: its constants set their own width, so the
        # enum stays the storage
        if tb == 0 then return "".string
        # BIND the name: regNameOf hands back an OWNED copy, and taking a
        # view of it inline leaves the copy with no owner to free it.
        tn: regNameOf :symtab tid: (ztypes.tid.create from: tb.u64)
        # scalarCTypeFor, not cTypeOf: the tid is in hand, so a user type
        # shadowing a numeric name must not pick up that numeric's C spelling
        return (scalarCTypeFor
            :symtab
            name: tn.stringView
            tid: (ztypes.tid.create from: tb.u64)
        )
    } case none then {
        # nothing declared: the spec's default, u8
        return "uint8_t".string
    }
}

# isOrdinalVariant -- the value IS its own discriminator: no tag field to read,
# no struct to compose, and `==` rather than a comparator.
#
# Reads the record rather than asking ordinalVariantCType and measuring what it
# says: this is a QUESTION, asked 11503 times in a self-compile, and building a
# string to answer it allocated once per ask.
isOrdinalVariant: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    ao: symtab.typing.ordinalVariant.get key: tid.u64
    match (
        ao
    ) case some then {
        return true
    } case none then {
        return false
    }
}

# isOrdinalPair -- an ordinal with exactly TWO arms, which is a C `bool` and so
# answers to truthiness: the second arm is the value, the first its negation.
# Distinct from isOrdinalVariant, which is about there being no tag field --
# every ordinal loses the field, only a pair gains `x` / `!x`.
isOrdinalPair: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    ao: symtab.typing.ordinalVariant.get key: tid.u64
    match (
        ao
    ) case some then {
        return ao == 2
    } case none then {
        return false
    }
}

# ordinalPairFirstArmId -- the name-pool id of an ordinal pair's FIRST arm:
# ordinal 0, and so the false side of the C `bool`. `bool` writes `false` first
# for exactly this reason, and a user variant decides it the same way -- by the
# order it writes its arms. 0 when `tid` is not an ordinal pair.
#
# An id rather than the text, because the callers ask an IDENTITY question --
# is this arm the false one -- and rendering the name to answer it allocated a
# String once per ask. Read from what the checker recorded, never walked: an
# arm walk is a member walk, and forcing one during emission demands members
# the program never asked for.
ordinalPairFirstArmId: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out u64 is {
    if (isOrdinalPair :symtab :tid) == false then return 0
    fa: symtab.typing.sumPairFirstArm.get key: tid.u64
    match (
        fa
    ) case some then {
        return fa
    } case none then {
        return 0
    }
}

# scalarCTypeFor -- the C scalar type for a builtin-named tid, BUT empty when the
# tid is a user type SHADOWING the scalar. The caller then emits the user struct
# (typeRefC / cnameOf) instead of the C scalar. The single "trust the canonical
# id, not the name" gate for the by-name C-type sites.
scalarCTypeFor: function {
    symtab: zenv.ZSymbolTable.view
    name: StringView
    tid: ztypes.tid
} out String is {
    if (isOrdinalVariant :symtab tid: (ztypes.tid.create from: tid.u64)) then {
        return (ordinalVariantCType :symtab tid: (ztypes.tid.create from: tid.u64))
    }
    sc: cTypeOf :name
    if sc.length == 0 then return sc
    if (scalarTidIsBuiltin :symtab tid: (ztypes.tid.create from: tid.u64)) == false then {
        return "".string
    }
    return sc
}

# isIntName -- integer scalar family check (snprintf %ld path).
isIntName: function {name: StringView} out bool is {
    if name == "i8" then return true
    if name == "i16" then return true
    if name == "i32" then return true
    if name == "i64" then return true
    if name == "u8" then return true
    if name == "u16" then return true
    if name == "u32" then return true
    if name == "u64" then return true
    if name == "i128" then return true
    if name == "u128" then return true
    if name == "c8" then return true
    if name == "c32" then return true
    if name == "bool" then return true
    return false
}

# true when `name` is a floating-point type name.
isFloatName: function {name: StringView} out bool is {
    if name == "f16" then return true
    if name == "f32" then return true
    if name == "f64" then return true
    if name == "f128" then return true
    return false
}

# numBits -- integer numeric type bit width (0 if not an integer type).
numBits: function {name: StringView} out u64 is {
    if name == "i8" then return 8
    if name == "u8" then return 8
    if name == "c8" then return 8
    if name == "i16" then return 16
    if name == "u16" then return 16
    if name == "i32" then return 32
    if name == "u32" then return 32
    if name == "c32" then return 32
    if name == "i64" then return 64
    if name == "u64" then return 64
    if name == "i128" then return 128
    if name == "u128" then return 128
    return 0
}

# numSigned -- true for the signed integer family.
numSigned: function {name: StringView} out bool is {
    if name == "i8" then return true
    if name == "i16" then return true
    if name == "i32" then return true
    if name == "i64" then return true
    if name == "i128" then return true
    return false
}

# numLoStr / numHiStr -- decimal range bounds, the comparands of the
# overflow check emitted on a narrowing cast.
numLoStr: function {name: StringView} out String is {
    if name == "i8" then return "-128".string
    if name == "i16" then return "-32768".string
    if name == "i32" then return "-2147483648".string
    if name == "i64" then return "(-9223372036854775807LL - 1)".string
    if (
        name == "i128"
    ) then return "(-(__int128)((((unsigned __int128)0x7FFFFFFFFFFFFFFFULL) << 64) | 0xFFFFFFFFFFFFFFFFULL) - 1)".string
    return "0".string
}

# the maximum-value literal (as C text) for numeric type `name`.
numHiStr: function {name: StringView} out String is {
    if name == "i8" then return "127".string
    if name == "i16" then return "32767".string
    if name == "i32" then return "2147483647".string
    if name == "i64" then return "9223372036854775807".string
    if (
        name == "i128"
    ) then return "((__int128)((((unsigned __int128)0x7FFFFFFFFFFFFFFFULL) << 64) | 0xFFFFFFFFFFFFFFFFULL))".string
    if name == "u8" then return "255".string
    if name == "c8" then return "255".string
    if name == "u16" then return "65535".string
    if name == "u32" then return "4294967295U".string
    if name == "c32" then return "4294967295U".string
    if name == "u64" then return "18446744073709551615ULL".string
    if name == "u128" then return "(~(unsigned __int128)0)".string
    return "0".string
}

# numLitSuffix -- the C integer-literal suffix for an unsigned type, so a large
# decimal literal (e.g. u64 max) is unambiguously unsigned to the C compiler.
numLitSuffix: function {name: StringView} out String is {
    if name == "u64" then return "ULL".string
    if name == "u32" then return "U".string
    if name == "c32" then return "U".string
    return "".string
}

# castLitVal -- val with the unsigned C suffix appended when it is a bare decimal
# literal cast to an unsigned type, so large u64 constants don't warn as signed.
castLitVal: function {val: StringView dstName: StringView} out String is {
    r: val.string
    sfx: numLitSuffix name: dstName
    if sfx.length == 0 then return r
    if val.length == 0 then return r
    allDig: true
    i: u64
    n: val.length
    for i < n loop {
        bo: val.byteAt :i
        match (
            bo
        ) case some then {
            if bo < 48 then allDig = false
            if bo > 57 then allDig = false
        } case none then null
        i = i + 1
    }
    if allDig then r.append sfx
    return r
}

# numMantissa -- the significand width of a float type (0 if not one). A
# conversion INTO a float is exact only while the source's magnitude fits here.
numMantissa: function {name: StringView} out u64 is {
    if name == "f16" then return 11
    if name == "f32" then return 24
    if name == "f64" then return 53
    if name == "f128" then return 113
    return 0
}

# convIsLossy -- whether `<src>.<dst>` can lose information, which is exactly
# what decides the DECLARED return: the units give a lossy conversion a
# `resultval` and a provably-safe one the target type itself. Identity and
# widening within a signedness are safe; a signed source never fits an unsigned
# target; an unsigned one needs a strictly wider signed target; and a float
# target must have significand enough for the source's whole width.
# natives-tbl-guard checks this against the declarations, so the two encodings
# of the rule cannot drift apart.
convIsLossy: function {srcName: StringView dstName: StringView} out bool is {
    if srcName == dstName then return false
    sf: isFloatName name: srcName
    df: isFloatName name: dstName
    if sf then {
        if df then return (numMantissa name: srcName) > (numMantissa name: dstName)
        return true
    }
    if df then return (numBits name: srcName) > (numMantissa name: dstName)
    sb: numBits name: srcName
    db: numBits name: dstName
    ss: numSigned name: srcName
    ds: numSigned name: dstName
    if ss == ds then return sb > db
    if ss then return true
    return sb >= db
}

# convBodyOf -- the C natives.tbl gives for the conversion `<src>.<dst>`, as a
# row body. This is the SAME derivation emitNumericCast and emitNumericCastResult
# run -- numBits, numSigned, numLoStr, numHiStr -- so the checked-in rows cannot
# say anything the rule does not; natives-tbl-guard regenerates and diffs to keep
# it that way. `lossy` follows the DECLARATION: a conversion the units declare as
# returning `resultval` builds one, and one returning the type directly is a
# plain cast, so the table and the declaration agree by construction.
convBodyOf: function {srcName: StringView dstName: StringView lossy: bool} out String is {
    scT: cTypeOf name: srcName
    tcT: cTypeOf name: dstName
    if lossy == false then {
        d: "((\{tcT})@V@)"
        return d
    }
    okSet: "_r.tag = @OKTAG@; _r.data.ok = (\{tcT})_v;"
    sFloat: isFloatName name: srcName
    dFloat: isFloatName name: dstName
    body: String
    if sFloat then {
        if dFloat then {
            errInf: "_r.tag = @ERRTAG@; _r.data.err@TAG_converror@ = Z_CONVERROR_TAG_OUTOFRANGE;"
            errPrecF: "_r.tag = @ERRTAG@; _r.data.err@TAG_converror@ = Z_CONVERROR_TAG_PRECISIONLOSS;"
            okF: "_r.tag = @OKTAG@; _r.data.ok = _f;"
            body = "\{tcT} _f = (\{tcT})_v; if (isinf(_f) && !isinf(_v)) { \{errInf} } else if ((\{scT})_f != _v) { \{errPrecF} } else { \{okF} }"
        } else {
            b: numBits name: dstName
            dsig: numSigned name: dstName
            inRange: String
            if dsig then {
                bm1: b - 1
                inRange = "(_v >= -0x1p\{bm1} && _v < 0x1p\{bm1})"
            } else {
                inRange = "(_v >= 0.0 && _v < 0x1p\{b})"
            }
            errOor: "_r.tag = @ERRTAG@; _r.data.err@TAG_converror@ = Z_CONVERROR_TAG_OUTOFRANGE;"
            errPrecI: "_r.tag = @ERRTAG@; _r.data.err@TAG_converror@ = Z_CONVERROR_TAG_PRECISIONLOSS;"
            body = "if (!\{inRange}) { \{errOor} } else if ((double)(\{tcT})_v != (double)_v) { \{errPrecI} } else { \{okSet} }"
        }
    } else {
        if dFloat then {
            p: 53
            if dstName == "f32" then p = 24
            if dstName == "f16" then p = 11
            if dstName == "f128" then p = 113
            rangeAnd: ""
            if dstName == "f16" then rangeAnd = " && _mag <= 65504"
            ssig: numSigned name: srcName
            errPrecX: "_r.tag = @ERRTAG@; _r.data.err@TAG_converror@ = Z_CONVERROR_TAG_PRECISIONLOSS;"
            is128s: false
            if srcName == "i128" then is128s = true
            if srcName == "u128" then is128s = true
            if is128s then {
                magExpr2: String
                if ssig then {
                    magExpr2 = "(_v < 0 ? (unsigned __int128)(0 - (unsigned __int128)_v) : (unsigned __int128)_v)".string
                } else {
                    magExpr2 = "(unsigned __int128)_v".string
                }
                body = "unsigned __int128 _mag = \{magExpr2}; uint64_t _mh = (uint64_t)(_mag >> 64); uint64_t _ml = (uint64_t)_mag; int _bl = _mh ? (128 - __builtin_clzll(_mh)) : (_ml ? 64 - __builtin_clzll(_ml) : 0); int _tz = _ml ? __builtin_ctzll(_ml) : (_mh ? 64 + __builtin_ctzll(_mh) : 0); if (_mag == 0 || ((_bl - _tz) <= \{p}\{rangeAnd})) { \{okSet} } else { \{errPrecX} }"
            } else {
                magExpr: String
                if ssig then {
                    magExpr = "(_v < 0 ? (uint64_t)(0 - (uint64_t)_v) : (uint64_t)_v)".string
                } else {
                    magExpr = "(uint64_t)_v".string
                }
                body = "uint64_t _mag = \{magExpr}; if (_v == 0 || ((64 - __builtin_clzll(_mag) - __builtin_ctzll(_mag)) <= \{p}\{rangeAnd})) { \{okSet} } else { \{errPrecX} }"
            }
        } else {
            needsLo: true
            needsHi: true
            sbits: numBits name: srcName
            dbits: numBits name: dstName
            ssig: numSigned name: srcName
            dsig: numSigned name: dstName
            if ssig then {
                if dsig then {
                    if sbits <= dbits then needsLo = false
                }
            } else {
                needsLo = false
            }
            if ssig == dsig then {
                if sbits <= dbits then needsHi = false
            } else {
                if ssig then {
                    if sbits <= dbits then needsHi = false
                } else {
                    if sbits < dbits then needsHi = false
                }
            }
            cond: String
            if needsLo then {
                if needsHi then {
                    lo: numLoStr name: dstName
                    hi: numHiStr name: dstName
                    cond = "_v < \{lo} || _v > \{hi}"
                } else {
                    lo2: numLoStr name: dstName
                    cond = "_v < \{lo2}"
                }
            } else {
                if needsHi then {
                    hi2: numHiStr name: dstName
                    cond = "_v > \{hi2}"
                } else {
                    cond = "0".string
                }
            }
            errOor2: "_r.tag = @ERRTAG@; _r.data.err@TAG_converror@ = Z_CONVERROR_TAG_OUTOFRANGE;"
            body = "if (\{cond}) { \{errOor2} } else { \{okSet} }"
        }
    }
    r: "({ \{scT} _v = @V@; z_@RT@_t _r = {0}; \{body} _r; })"
    return r
}

# nativeConvRows -- the conversions section of natives.tbl, generated from the
# rule rather than written by hand: 256 pairs, and a bound written wrong on a
# pair no program happens to use is not something the corpus can catch.
# natives-tbl-guard regenerates this and diffs it against the checked-in file,
# so the table is provably the rule's own output.
nativeConvRows: function out String is {
    order: List String
    order.append from: "u8".string
    order.append from: "c8".string
    order.append from: "c32".string
    order.append from: "i8".string
    order.append from: "i16".string
    order.append from: "i32".string
    order.append from: "i64".string
    order.append from: "u16".string
    order.append from: "u32".string
    order.append from: "u64".string
    order.append from: "f32".string
    order.append from: "f64".string
    order.append from: "i128".string
    order.append from: "u128".string
    order.append from: "f16".string
    order.append from: "f128".string
    buf: String
    si: u64
    n: order.length
    for si < n loop {
        s: order.get i: si
        si = si + 1
        hdr: "\n# system.\{s} conversions\n"
        buf.append hdr
        di: u64
        for di < n loop {
            d: order.get i: di
            di = di + 1
            lo: convIsLossy srcName: s.stringView dstName: d.stringView
            bd: (convBodyOf
                srcName: s.stringView
                dstName: d.stringView
                lossy: lo
            )
            key: "[system.\{s}.\{d}]"
            pad: key.copy
            for pad.length < 30 loop pad.append " "
            row: "\{pad} \{bd}\n"
            buf.append row
        }
    }
    # `print` supplies the final newline, so the last row must not carry one:
    # the guard diffs this output against the checked-in section byte for byte.
    if buf.length > 0 then {
        cut: buf.stringView.substring from: 0 to: (buf.length - 1)
        return cut.string
    }
    return buf
}

# emitNumericCast -- a runtime numeric conversion `<val>.<dstName>`, filled from
# the natives.tbl row its qualified path names. The row already IS the derivation
# -- it was generated by it -- so the C is read rather than rebuilt here, and the
# declaration's return type decides only which bindings the row needs: a lossy
# conversion's row spells the resultval mono and its two tags.
emitNumericCast: function {
    ctx: Ctx
    dstName: StringView
    val: StringView
    symtab: zenv.ZSymbolTable.view
    retTid: ztypes.tid
    key: StringView
} out String is {
    if (isFloatName name: dstName) then {
        # a bare float-literal operand re-parses at the destination width
        # via the C literal suffix (single rounding, full precision). A LITERAL
        # concern, not a conversion one: there is no value to convert yet.
        if (isFloatLitText s: val) then {
            fl: cFloatLitSuffix name: dstName
            return "\{val}\{fl}"
        }
    }
    body: nativeImplOf :ctx path: key
    if body.length == 0 then {
        emitFail :ctx what: "no native implementation for '\{key}'" line: 0
        return "/* zemitterc: no native implementation */0".string
    }
    # a lossy conversion builds a `resultval`; the row spells the tags and the
    # mono's name, and the DECLARATION is what decided which shape it is
    resOrig: monoOriginName :symtab tid: retTid
    bn: List String
    bv: List String
    rn: List String
    rv: List String
    if resOrig.stringView == "resultval" then {
        bn.append from: "RT".string
        bv.append from: (ctxCname :ctx tid: retTid)
        rn.append from: "OKTAG".string
        rv.append from: (variantTag :symtab tid: retTid arm: "ok")
        rn.append from: "ERRTAG".string
        rv.append from: (variantTag :symtab tid: retTid arm: "err")
        # the error slot's assignment, spelled for whatever `converror` IS
        if ctx.converrorTid.isZero == false then {
            rn.append from: "TAG_converror".string
            if (isOrdinalVariant :symtab tid: ctx.converrorTid) then {
                rv.append from: "".string
            } else {
                rv.append from: ".tag".string
            }
        }
        rn.append from: "V".string
        rv.append from: val.string
    } else {
        sval: castLitVal :val :dstName
        rn.append from: "V".string
        rv.append from: sval.copy
    }
    return (fillHolesForCtx
        :ctx
        text: body
        path: key
        bindNames: bn
        bindVals: bv
        rawNames: rn
        rawVals: rv
    )
}

# cUpperOf -- ASCII upper-case for tag spellings.
cUpperOf: function {text: StringView} out String is {
    buf: String
    i: u64
    n: text.length
    for i < n loop {
        bo: text.byteAt :i
        match (
            bo
        ) case some then {
            if bo >= 97 then {
                if bo <= 122 then {
                    buf.appendByte b: bo - 32
                } else {
                    buf.appendByte b: bo
                }
            } else {
                buf.appendByte b: bo
            }
        } case none then null
        i = i + 1
    }
    return buf
}

# cEscape -- escape literal text for a C string body.
cEscape: function {text: StringView} out String is {
    buf: String
    i: u64
    n: text.length
    for i < n loop {
        bo: text.byteAt :i
        match (
            bo
        ) case some then {
            if bo == 92 then {
                buf.append "\\\\"
            } else if bo == 34 then {
                buf.append "\\\""
            } else if bo == 10 then {
                buf.append "\\n"
            } else if bo == 9 then {
                buf.append "\\t"
            } else {
                buf.appendByte b: bo
            }
        } case none then null
        i = i + 1
    }
    return buf
}

# substituteAll -- replace every occurrence of needle in text.
substituteAll: function {text: String needle: StringView repl: StringView} out String is {
    buf: String
    pos: u64
    total: text.length
    for pos < total loop {
        remv: (text.substring from: pos to: total)
        fo: remv.indexOf :needle
        match (
            fo
        ) case some then {
            pre: (remv.substring from: 0 to: fo)
            buf.append pre
            buf.append repl
            pos = pos + fo + needle.length
        } case none then {
            buf.append remv
            pos = total
        }
    }
    return buf
}

# holeNames -- every distinct `@Name@` hole in a fragment, in first-seen
# order: the holes a fragment spells ARE its demand. `@@KEY@@` template keys
# are opaque, so the mixed z_str.c.tmpl (which spells both) never reads the
# `@NAME@` inside a `@@NAME@@` as a hole.
holeNames: function {text: StringView} out List String is {
    names: List String
    pos: u64
    total: text.length
    for pos < total loop {
        rem: text.substring from: pos to: total
        ao: rem.indexOf needle: "@"
        match (
            ao
        ) case some then {
            at: pos + ao
            dbl: false
            {
                nx: text.byteAt i: (at + 1)
                match (
                    nx
                ) case some then {
                    if nx == 64 then dbl = true
                } case none then null
            }
            if dbl then {
                aft: text.substring from: (at + 2) to: total
                cl: aft.indexOf needle: "@@"
                match (
                    cl
                ) case some then {
                    pos = at + 2 + cl + 2
                } case none then {
                    pos = at + 2
                }
            } else {
                sub: text.substring from: (at + 1) to: total
                ho: sub.indexOf needle: "@"
                match (
                    ho
                ) case some then {
                    endn: at + 1 + ho
                    nm: text.substring from: (at + 1) to: endn
                    seen: false
                    si: u64
                    sn: names.length
                    for si < sn loop {
                        e: names.get i: si
                        if e.stringView == nm then seen = true
                        si = si + 1
                    }
                    if seen == false then names.append from: nm.string
                    pos = endn + 1
                } case none then {
                    pos = at + 1
                }
            }
        } case none then {
            pos = total
        }
    }
    return names
}

# hasUnfilledHole -- true when an unfilled single-`@` hole survives. `@@KEY@@` keys
# are opaque here too, so a template key still awaiting applyTmpl does not
# read as a hole.
hasUnfilledHole: function {text: StringView} out bool is {
    pos: u64
    total: text.length
    for pos < total loop {
        rem: text.substring from: pos to: total
        ao: rem.indexOf needle: "@"
        match (
            ao
        ) case some then {
            at: pos + ao
            dbl: false
            {
                nx: text.byteAt i: (at + 1)
                match (
                    nx
                ) case some then {
                    if nx == 64 then dbl = true
                } case none then null
            }
            if dbl then {
                aft: text.substring from: (at + 2) to: total
                cl: aft.indexOf needle: "@@"
                match (
                    cl
                ) case some then {
                    pos = at + 2 + cl + 2
                } case none then {
                    pos = at + 2
                }
            } else {
                return true
            }
        } case none then {
            pos = total
        }
    }
    return false
}

# hasHoleBinding -- is `name` bound at all? Separate from its VALUE, because a hole
# may legitimately fill with NOTHING: `@TAG_X@` is `.tag` while X is a tagged
# struct and empty once X is unwrapped, and "" from holeBindingText alone cannot be
# told from a hole nobody bound.
hasHoleBinding: function {
    name: StringView
    bindNames: (List String).view
    rawNames: (List String).view
} out bool is {
    with bit: bindNames.iterate do for k: bit loop {
        if k.stringView == name then return true
    }
    with rit: rawNames.iterate do for rk: rit loop {
        if rk.stringView == name then return true
    }
    return false
}

# holeBindingText -- the text a hole fills with. A CNAME binding fills with the
# bound name minus its `z_` prefix, because the body spells that prefix itself
# (`z_@File@_t`), and a value carrying no `z_` is a canon that resolved to
# nothing -- reported as fatal at the fill site. A RAW binding fills verbatim:
# an emitted operand is an arbitrary C expression, not a type's name, so the
# prefix rule would be a lie about it. Cnames are consulted first; a name in
# neither list is fatal.
holeBindingText: function {
    name: StringView
    bindNames: List String
    bindVals: List String
    rawNames: List String
    rawVals: List String
} out String is {
    bi: u64
    bn: bindNames.length
    for bi < bn loop {
        k: bindNames.get i: bi
        if k.stringView == name then {
            v: bindVals.get i: bi
            vv: v.stringView
            if (vv.startsWith prefix: "z_") == false then return "".string
            rest: vv.substring from: 2 to: vv.length
            return rest.string
        }
        bi = bi + 1
    }
    ri: u64
    rn: rawNames.length
    for ri < rn loop {
        rk: rawNames.get i: ri
        if rk.stringView == name then {
            rv: rawVals.get i: ri
            return rv.copy
        }
        ri = ri + 1
    }
    return "".string
}

# fillHoles -- fill every `z_@Name@` hole in a runtime fragment from the
# caller's bindings. The single substitution pass for every fragment loader:
# it scans once, so no needle order can matter, and `@@KEY@@` template keys
# pass through untouched for applyTmpl. Every failure is fatal and names the
# fragment and the hole.
fillHoles: function {
    text: String
    path: StringView
    bindNames: List String
    bindVals: List String
    rawNames: List String
    rawVals: List String
    fails: List String
} out String is {
    buf: String
    tv: text.stringView
    total: tv.length
    pos: u64
    bad: false
    for pos < total loop {
        rem: tv.substring from: pos to: total
        ao: rem.indexOf needle: "@"
        match (
            ao
        ) case some then {
            pre: rem.substring from: 0 to: ao
            buf.append pre
            at: pos + ao
            dbl: false
            {
                nx: tv.byteAt i: (at + 1)
                match (
                    nx
                ) case some then {
                    if nx == 64 then dbl = true
                } case none then null
            }
            if dbl then {
                aft: tv.substring from: (at + 2) to: total
                cl: aft.indexOf needle: "@@"
                match (
                    cl
                ) case some then {
                    ex: at + 2 + cl + 2
                    run: tv.substring from: at to: ex
                    buf.append run
                    pos = ex
                } case none then {
                    buf.append "@@"
                    pos = at + 2
                }
            } else {
                sub: tv.substring from: (at + 1) to: total
                ho: sub.indexOf needle: "@"
                match (
                    ho
                ) case some then {
                    endn: at + 1 + ho
                    nm: tv.substring from: (at + 1) to: endn
                    val: holeBindingText name: nm :bindNames :bindVals :rawNames :rawVals
                    if (hasHoleBinding name: nm :bindNames :rawNames) then {
                        buf.append val
                    } else {
                        fh: "fragment \{path}: hole @\{nm}@ is bound to nothing"
                        fails.append from: fh
                        bad = true
                        buf.append "@"
                        buf.append nm
                        buf.append "@"
                    }
                    pos = endn + 1
                } case none then {
                    fu: "fragment \{path}: unterminated hole"
                    fails.append from: fu
                    bad = true
                    buf.append "@"
                    pos = at + 1
                }
            }
        } case none then {
            buf.append rem
            pos = total
        }
    }
    if bad == false then {
        if (hasUnfilledHole text: buf.stringView) then {
            fr: "fragment \{path}: a hole survived the fill"
            fails.append from: fr
        }
    }
    return buf
}

# fillHolesForCtx -- fillHoles for every loader that holds a Ctx: the fill's
# failures are reported through the emit-failure channel, so a bad fragment
# fails the run. The three unconditional loads in emitC run before Ctx exists
# and drain fillHoles' sink into their own fails list instead.
fillHolesForCtx: function {
    ctx: Ctx
    text: String
    path: StringView
    bindNames: List String
    bindVals: List String
    rawNames: List String
    rawVals: List String
} out String is {
    ferr: List String
    cur: (fillHoles
        :text
        :path
        :bindNames
        :bindVals
        :rawNames
        :rawVals
        fails: ferr
    )
    fi: u64
    fn: ferr.length
    for fi < fn loop {
        m: ferr.get i: fi
        emitFail :ctx what: m.copy line: 0
        fi = fi + 1
    }
    return cur
}


# readTemplateCached -- the raw text of a runtime template file, read once
# per emit and cached by path. A missing file is fatal and reported once (the
# "" is cached so the read is not retried); no fragment on disk is empty, so a
# cached "" is unambiguously the missing-file path.
readTemplateCached: function {ctx: Ctx path: StringView} out String is {
    cached: String
    hit: false
    {
        got: ctx.tmplCache.get key: path.string
        match (
            got
        ) case some then {
            cached = got.copy
            hit = true
        } case none then null
    }
    if hit then return cached
    txt: String
    rd: io.readText :path
    match (
        rd
    ) case ok then {
        txt = rd.take
    } case err then {
        emitFail :ctx what: "missing runtime template \{path}" line: 0
    }
    ctx.tmplCache.set key: path.string value: txt.copy
    return txt
}

# loadNativeTbl -- parse natives.tbl into the three row tables. A row is
# `[<path> attr=value ...] <body>`; `#` starts a comment and blank lines are
# skipped. Read through readTemplateCached, which caches it and reports a
# missing file as an emission failure -- the table is not optional, so a
# program that cannot find it fails rather than falling back to something.
loadNativeTbl: function {ctx: Ctx runtimeDir: StringView} is {
    p: "\{runtimeDir}/natives.tbl"
    txt: readTemplateCached :ctx path: p.stringView
    if txt.length == 0 then return
    with lit: txt.stringView.lines do for ln: lit loop {
        t: ln.trim
        if t.length > 0 when (t.startsWith prefix: "#") == false then {
            if (t.startsWith prefix: "[") then {
                co: t.indexOf needle: "]"
                match (
                    co
                ) case some then {
                    head: t.substring from: 1 to: co
                    rest: t.substring from: (co + 1) to: t.length
                    body: rest.trim
                    key: String
                    need: String
                    frag: String
                    dem: String
                    ord: String
                    cst: String
                    ptr: false
                    isFold: false
                    with fit: (head.split sep: " ") do for f: fit loop {
                        if f.length > 0 then {
                            if key.length == 0 then {
                                key = f.string
                            } else {
                                if f == "args=ptr" then ptr = true
                                # a BARE attribute, like args=ptr. Matched by
                                # STRIPPING rather than comparing: the keyed
                                # attributes below already ask that way, and a
                                # spelling compare is what the architecture
                                # rules count against this file.
                                fdo: f.stripPrefix p: "fold"
                                match (
                                    fdo
                                ) case some then {
                                    if fdo.length == 0 then isFold = true
                                } case none then null
                                fo: f.stripPrefix p: "frag="
                                match (
                                    fo
                                ) case some then {
                                    frag = fo.string
                                } case none then null
                                demandText: f.stripPrefix p: "demand="
                                match (
                                    demandText
                                ) case some then {
                                    dem = demandText.string
                                } case none then null
                                so: f.stripPrefix p: "needs="
                                match (
                                    so
                                ) case some then {
                                    need = so.string
                                } case none then null
                                oo: f.stripPrefix p: "order="
                                match (
                                    oo
                                ) case some then {
                                    ord = oo.string
                                } case none then null
                                co: f.stripPrefix p: "const="
                                match (
                                    co
                                ) case some then {
                                    cst = co.string
                                } case none then null
                            }
                        }
                    }
                    if key == "@units" then {
                        # not a row: the order the units' runtimes run in
                        with oit: (ord.stringView.split sep: ",") do for ou: oit loop {
                            if ou.length > 0 then ctx.unitOrder.append from: ou.string
                        }
                        key = "".string
                    }
                    if key.length > 0 then {
                        kk: key.copy
                        ctx.nativeKeys.set key: kk value: true
                        # a receiver-only path is <unit>.<type>.<member>: three segments whose
                        # last is an identifier, AND it carries a body. A fragment-backed row
                        # has three segments too -- io.File.close -- and must not make `close`
                        # read as one, which is what routed a File close through the numeric
                        # cast. Only the member NAME is collected: it is the cheap filter the
                        # dotted-read leg asks first, and the row named by the source path is
                        # what actually answers. Pairing them here instead would be a CROSS
                        # PRODUCT -- every conv source crossed with every conv member -- which
                        # said yes to `u8.bits` on the strength of `bits` existing on i8.
                        if body.length > 0 when cst.length == 0 then {
                            firstDot: key.stringView.indexOf needle: "."
                            match (
                                firstDot
                            ) case some then {
                                afterFirstDot: (key.stringView.substring
                                    from: (firstDot + 1)
                                    to: key.length
                                )
                                secondDot: afterFirstDot.indexOf needle: "."
                                match (
                                    secondDot
                                ) case some then {
                                    mem: (afterFirstDot.substring
                                        from: (secondDot + 1)
                                        to: afterFirstDot.length
                                    )
                                    if (isBareCName s: mem) then {
                                        mk: mem.string
                                        # a row naming an ARGUMENT hole is not a
                                        # receiver-only conversion, and must not
                                        # be offered to the leg that fills @V@
                                        # and nothing else
                                        if (body.contains needle: "@A1@") then {
                                            ctx.nativeArgMemb.set key: mk value: true
                                        } else {
                                            ctx.nativeConvMemb.set key: mk value: true
                                        }
                                    }
                                } case none then null
                            } case none then null
                        }
                        if frag.length > 0 then {
                            fp: key.copy
                            ctx.nativeFragPaths.set key: fp value: true
                            # the row's own halves, split here and nowhere else: the unit is the
                            # path's first segment, the demand is `demand=` or the last segment.
                            # Neither starts as a copy of the key: both are assigned on every
                            # path below, so a copy here is written and never read -- one per
                            # fragment row, which was the whole of `make perf-elision`'s pool.
                            du: String
                            dm: String
                            {
                                fd: key.stringView.indexOf needle: "."
                                match (
                                    fd
                                ) case some then {
                                    hd: key.stringView.substring from: 0 to: fd
                                    # the `@` marks a path outside the declaration
                                    # space; the unit it names is still the unit
                                    so: hd.stripPrefix p: "@"
                                    match (
                                        so
                                    ) case some then {
                                        du = so.string
                                    } case none then {
                                        du = hd.string
                                    }
                                } case none then {
                                    # no `.` at all: the whole path is the unit
                                    du = key.copy
                                }
                            }
                            if dem.length == 0 then {
                                li: u64
                                kn: key.length
                                cut: u64
                                for li < kn loop {
                                    bo: key.stringView.byteAt i: li
                                    match (
                                        bo
                                    ) case some then {
                                        if bo == 46 then cut = li + 1
                                    } case none then null
                                    li = li + 1
                                }
                                dm = (key.stringView.substring from: cut to: kn).string
                            } else {
                                dm = dem.copy
                            }
                            tn: String
                            {
                                uo: dm.stringView.stripPrefix p: "uses_"
                                match (
                                    uo
                                ) case some then {
                                    tn = uo.string
                                } case none then null
                            }
                            ctx.fragUnits.append from: du
                            ctx.fragMembs.append from: dm
                            ctx.fragNames.append from: frag.copy
                            ctx.fragTypeNames.append from: tn
                        }
                        if body.length > 0 then {
                            kb: key.copy
                            if cst.length > 0 then {
                                ctx.nativeConstBody.set key: kb value: body.string
                                kc: key.copy
                                ctx.nativeConstPos.set key: kc value: cst.copy
                            } else {
                                ctx.nativeTbl.set key: kb value: body.string
                            }
                        }
                        if need.length > 0 then {
                            kn: key.copy
                            ctx.nativeNeed.set key: kn value: need.copy
                        }
                        if ptr then {
                            kp: key.copy
                            ctx.nativePtrArgs.set key: kp value: true
                        }
                        if isFold then {
                            kf: key.copy
                            ctx.nativeFold.set key: kf value: true
                        }
                    }
                } case none then null
            }
        }
    }
}

# nativeIsArgMembOf -- whether `memb` names ANY row that takes arguments. Like
# nativeIsConvMembOf it is a FILTER and not the answer: the row named by the
# receiver's own path is what decides, and this only says the question is worth
# asking. It exists because the alternative is composing a path per call.
nativeIsArgMembOf: function {ctx: Ctx.view memb: StringView} out bool is {
    return ((ctx.nativeArgMemb.get key: memb.asString).or d: false)
}

# nativeIsConvMembOf -- whether `memb` is the member name of ANY receiver-only
# row: a conversion, or `bits` / `not`. It asks nothing of the source type, so
# a caller can rule the receiver-only legs out before building a source path
# for them -- which is nearly every dotted marker. It is a FILTER and not the
# answer: the row named by `<srcPath>.<memb>` is what decides, so a name in
# this set on a type with no such row is a miss, not a conversion.
nativeIsConvMembOf: function {ctx: Ctx.view memb: StringView} out bool is {
    return ((ctx.nativeConvMemb.get key: memb.asString).or d: false)
}

# nativeIsFragBacked -- a fragment implements this path, so its C symbol is the
# convention one. The question is never which unit a native lives in, it is
# whether the runtime supplies its body, and a user unit that ships a fragment
# answers yes on the same terms as io does.
nativeIsFragBacked: function {ctx: Ctx.view path: StringView} out bool is {
    return ((ctx.nativeFragPaths.get key: path.asString).or d: false)
}

# nativeHasRow -- the table has a row for this path, whatever the row says. A
# row with no body and no fragment still answers the only question asked here:
# does the compiler claim to supply this native at all.
nativeHasRow: function {ctx: Ctx.view path: StringView} out bool is {
    return ((ctx.nativeKeys.get key: path.asString).or d: false)
}

# nativeIsFoldRow -- the row marks the path `fold`: the compiler answers it at
# compile time and emits nothing. Asked wherever a native would otherwise be
# lowered to C, so a fold that did not happen is reported as itself rather
# than as a missing implementation.
nativeIsFoldRow: function {ctx: Ctx.view path: StringView} out bool is {
    return ((ctx.nativeFold.get key: path.asString).or d: false)
}

# nativeImplOf -- the C body natives.tbl gives for a qualified path, "" when
# the table has no row for it. "" is the error case at every call site: the
# compiler supplies no implementation for that declaration.
nativeImplOf: function {ctx: Ctx.view path: StringView} out String is {
    result: String
    {
        g: ctx.nativeTbl.get key: path.asString
        match (
            g
        ) case some then {
            result = g.copy
        } case none then null
    }
    return result
}

# nativeConstImplOf -- the body of the row that answers only when the argument
# positions it names are COMPILE-TIME CONSTANTS; "" when the path has no such
# row. A row like `[system.u64.<< const=1]` gets to name its hole twice --
# normally forbidden, because holes fill verbatim and a call operand would be
# evaluated twice -- precisely because a constant position fills with a
# LITERAL. That is what puts a constant expression in the guard's condition,
# which is what a C compiler needs to see to fold it away: measured on the
# vendored tcc, the guarded form keeps a compare and two jumps and the const
# form is a single `shl $0x3,%rax`.
nativeConstImplOf: function {ctx: Ctx.view path: StringView} out String is {
    result: String
    {
        g: ctx.nativeConstBody.get key: path.asString
        match (
            g
        ) case some then {
            result = g.copy
        } case none then null
    }
    return result
}

# nativeConstPosOf -- the argument positions that row requires to be constant,
# 1-based with the receiver excluded, so the attribute reads the same for a
# binop (which has exactly one argument) and for an N-argument call later.
nativeConstPosOf: function {ctx: Ctx.view path: StringView} out String is {
    result: String
    {
        g: ctx.nativeConstPos.get key: path.asString
        match (
            g
        ) case some then {
            result = g.copy
        } case none then null
    }
    return result
}

# constPosIsFirstOnly -- the position list names argument 1 and nothing else.
# A binop HAS only argument 1, so a row asking for any other position cannot be
# satisfied by one and is not selected; the list form is what lets a call ask
# for two. Asked with stripPrefix rather than a literal compare, the way the
# loader reads every other attribute -- the architecture lint counts a `==`
# against a spelling, and it is right to.
constPosIsFirstOnly: function {pos: StringView} out bool is {
    o: pos.stripPrefix p: "1"
    match (
        o
    ) case some then {
        return o.length == 0
    } case none then null
    return false
}

# nativeNeedOf -- the runtime fragment a row's body calls, "" when it calls
# none. Recorded as data because the demand has to be registered before the
# fragment pass runs, and only the row knows it is needed.
nativeNeedOf: function {ctx: Ctx.view path: StringView} out String is {
    result: String
    {
        g: ctx.nativeNeed.get key: path.asString
        match (
            g
        ) case some then {
            result = g.copy
        } case none then null
    }
    return result
}

# nativePtrArgsOf -- true when a row's body takes its operands by pointer, so
# they must be projected as lvalues rather than values.
nativePtrArgsOf: function {ctx: Ctx.view path: StringView} out bool is {
    return ((ctx.nativePtrArgs.get key: path.asString).or d: false)
}

# emitFail -- record an emission failure for an unhandled construct. The
# marker comment still lands in the emitted C for context, but zc reports
# every recorded failure and exits nonzero without writing any output.
emitFail: function {ctx: Ctx what: String line: u32} is {
    msg: String
    if line > 0 then {
        msg = "zemitterc: \{what} [line \{line}]"
    } else {
        msg = "zemitterc: \{what}"
    }
    ctx.emitErrors.append from: msg
}

# loadFragment -- read a runtime fragment and fill its holes. Every fragment
# on this path spells only `z_@String@` / `z_@StringView@`, so the two
# bindings are the whole vocabulary and no registry lookup is needed -- which
# is what lets the three unconditional loads run before Ctx exists.
loadFragment: function {
    path: StringView
    svC: StringView
    strC: StringView
    fails: List String
} out String is {
    rd: io.readText :path
    match (
        rd
    ) case ok then {
        bn: List String
        bv: List String
        bn.append from: "StringView".string
        bv.append from: svC.string
        bn.append from: "String".string
        bv.append from: strC.string
        ferr: List String
        rwn: List String
        rwv: List String
        cur: (fillHoles
            text: rd
            :path
            bindNames: bn
            bindVals: bv
            rawNames: rwn
            rawVals: rwv
            fails: ferr
        )
        fi: u64
        fn: ferr.length
        for fi < fn loop {
            m: ferr.get i: fi
            fm: "zemitterc: \{m}"
            fails.append from: fm
            fi = fi + 1
        }
        return cur
    } case err then {
        f: "zemitterc: missing runtime fragment \{path}"
        fails.append from: f
        m: "/* zemitterc: missing runtime fragment \{path} */\n"
        return m
    }
}

# stringChunkText -- a stringchunk's text ("" for any other shape).
stringChunkText: function {ast: Ast.view n: astnode.view} out String is {
    match (
        n
    ) case stringchunk then {
        return (zast.poolTextCopy pool: ast.names ref: n.text)
    } else {
        return "".string
    }
}

# isInterp -- true when a literal has any non-chunk part.
isInterp: function {ast: Ast.view parts: zast.kidspan} out bool is {
    h3x9: u64
    for h3x9 < parts.count.u64 loop {
        pId: zast.kidAt kids: ast.kids span: parts i: h3x9
        h3x9 = h3x9 + 1
        p: ast.nodes.get i: pId.u64
        isC: false
        if p.stringchunk then isC = true
        if isC == false then return true
    }
    return false
}

# wholeText -- a plain literal's joined chunk text.
wholeText: function {ast: Ast.view parts: zast.kidspan} out String is {
    buf: String
    h4x9: u64
    for h4x9 < parts.count.u64 loop {
        pId: zast.kidAt kids: ast.kids span: parts i: h4x9
        h4x9 = h4x9 + 1
        t: stringChunkText :ast n: (ast.nodes.get i: pId.u64)
        buf.append t
    }
    return buf
}

# collectLiterals -- pool every PLAIN string-literal atom in walk order:
# parallel lists of (nodeid, text). Interpolated literals build at the
# use site instead.
collectLiterals: function {ast: Ast.view n: astnode.view ids: ListVal u64 texts: List String} is {
    match (
        n
    ) case statement then {
        stx719: u64
        for stx719 < n.statements.count.u64 loop {
            sId: zast.kidAt kids: ast.kids span: n.statements i: stx719
            stx719 = stx719 + 1
            collectLiterals :ast n: (ast.nodes.get i: sId.u64) :ids :texts
        }
    } case statementline then {
        collectLiterals :ast n: (ast.nodes.get i: n.statementline.u64) :ids :texts
    } case expression then {
        collectLiterals :ast n: (ast.nodes.get i: n.expression.u64) :ids :texts
    } case namedoperation then {
        collectLiterals :ast n: (ast.nodes.get i: n.operation.u64) :ids :texts
    } case call then {
        collectLiterals :ast n: (ast.nodes.get i: n.callable.u64) :ids :texts
        arx159: u64
        for arx159 < n.arguments.count.u64 loop {
            a: zast.kidAt kids: ast.kids span: n.arguments i: arx159
            arx159 = arx159 + 1
            collectLiterals :ast n: (ast.nodes.get i: a.u64) :ids :texts
        }
    } case dottedpath then {
        collectLiterals :ast n: (ast.nodes.get i: n.parent.u64) :ids :texts
    } case binop then {
        collectLiterals :ast n: (ast.nodes.get i: n.lhs.u64) :ids :texts
        collectLiterals :ast n: (ast.nodes.get i: n.rhs.u64) :ids :texts
    } case assignment then {
        collectLiterals :ast n: (ast.nodes.get i: n.value.u64) :ids :texts
    } case reassignment then {
        collectLiterals :ast n: (ast.nodes.get i: n.value.u64) :ids :texts
    } case ifexpr then {
        clx929: u64
        for clx929 < n.clauses.count.u64 loop {
            cId: zast.kidAt kids: ast.kids span: n.clauses i: clx929
            clx929 = clx929 + 1
            collectLiterals :ast n: (ast.nodes.get i: cId.u64) :ids :texts
        }
        if n.elseclause > 0 then {
            ec: ast.nodes.get i: n.elseclause.u64
            collectLiterals :ast n: ec :ids :texts
        }
    } case caseexpr then {
        collectLiterals :ast n: (ast.nodes.get i: n.subject.u64) :ids :texts
        clx939: u64
        for clx939 < n.clauses.count.u64 loop {
            mc: zast.kidAt kids: ast.kids span: n.clauses i: clx939
            clx939 = clx939 + 1
            collectLiterals :ast n: (ast.nodes.get i: mc.u64) :ids :texts
        }
        if n.elseclause > 0 then {
            ecl: ast.nodes.get i: n.elseclause.u64
            collectLiterals :ast n: ecl :ids :texts
        }
    } case caseclause then {
        collectLiterals :ast n: (ast.nodes.get i: n.statement.u64) :ids :texts
    } case ifclause then {
        cox1229: u64
        for cox1229 < n.conditions.count.u64 loop {
            kId: zast.kidAt kids: ast.kids span: n.conditions i: cox1229
            cox1229 = cox1229 + 1
            collectLiterals :ast n: (ast.nodes.get i: kId.u64) :ids :texts
        }
        collectLiterals :ast n: (ast.nodes.get i: n.statement.u64) :ids :texts
    } case withexpr then {
        collectLiterals :ast n: (ast.nodes.get i: n.value.u64) :ids :texts
        collectLiterals :ast n: (ast.nodes.get i: n.body.u64) :ids :texts
    } case doexpr then {
        collectLiterals :ast n: (ast.nodes.get i: n.statement.u64) :ids :texts
    } case forexpr then {
        cox1239: u64
        for cox1239 < n.conditions.count.u64 loop {
            f: zast.kidAt kids: ast.kids span: n.conditions i: cox1239
            cox1239 = cox1239 + 1
            collectLiterals :ast n: (ast.nodes.get i: f.u64) :ids :texts
        }
        if n.body > 0 then {
            fbl: ast.nodes.get i: n.body.u64
            collectLiterals :ast n: fbl :ids :texts
        }
    } case atomstring then {
        if (isInterp :ast parts: n.stringparts) == false then {
            t: wholeText :ast parts: n.stringparts
            nid: n.nodeid.u64
            ids.append nid
            texts.append t
        } else {
            stx49: u64
            for stx49 < n.stringparts.count.u64 loop {
                p: zast.kidAt kids: ast.kids span: n.stringparts i: stx49
                stx49 = stx49 + 1
                collectLiterals :ast n: (ast.nodes.get i: p.u64) :ids :texts
            }
        }
    } else null
}

# litIndexOf -- the 1-based pool index for a literal's nodeid (0 = absent).
litIndexOf: function {ctx: Ctx nid: u64} out u64 is {
    i: u64
    n: ctx.litIds.length
    for i < n loop {
        v: ctx.litIds.get :i
        if v == nid then {
            ctx.usedLits.add item: nid
            return i + 1
        }
        i = i + 1
    }
    return 0
}

# ternaryClause / ternaryElse -- if-expression rendering as nested C
# ternaries: each clause opens "(cond ? value : " and the else closes.
ternaryClause: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    c: astnode.view
} out String is {
    match (
        c
    ) case ifclause then {
        cond: String
        cox1249: u64
        for cox1249 < c.conditions.count.u64 loop {
            kId: zast.kidAt kids: ast.kids span: c.conditions i: cox1249
            cox1249 = cox1249 + 1
            k: ast.nodes.get i: kId.u64
            if k.namedoperation then {
                cv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: k.operation.u64)
                tw: (truthyCondText
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: k.operation.u64)
                    raw: cv.stringView
                )
                if cond.length > 0 then cond.append " && "
                if tw.length > 0 then {
                    cond.append tw
                } else {
                    cond.append cv
                }
            }
        }
        vx: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: c.statement.u64)
        t0: "((\{cond}) ? (\{vx}) : "
        return t0
    } else {
        return "(0 ? 0 : ".string
    }
}

# emit the else-arm of a C ternary expression.
ternaryElse: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    oId: zast.nodeid
} out String is {
    if oId > 0 then {
        ev: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: oId.u64)
        e0: "(\{ev})"
        return e0
    } else {
        return "(0)".string
    }
}

# atomNameIdOf -- an atom's interned name id (0 when the node is not an atom;
# no pool id is 0, so a lookup by it misses).
atomNameIdOf: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    ast
    match (
        n
    ) case atomid then {
        return n.name
    } else {
        return (zast.nameid.create from: 0)
    }
}

# atomTextOf -- an atomid node's name text ("" for any other shape), a view
# into the pool: the tree is read-only throughout emission, so the text is
# never copied out of it.
atomTextOf: function {ast: Ast.view n: astnode.view} outx StringView is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextAt :ast ref: n.name).stringView
    } else {
        return ""
    }
}

# atomTextDeep -- atom text through expression wrappers, a view into the pool.
atomTextDeep: function {ast: Ast.view n: astnode.view} outx StringView is {
    match (
        n
    ) case expression then {
        return (atomTextDeep :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return (zast.nameTextAt :ast ref: n.name).stringView
    } else {
        return ""
    }
}

# atomNodeId -- an atomid node's id (0 for any other shape).
atomNodeId: function {n: astnode.view} out u64 is {
    match (
        n
    ) case atomid then {
        return n.nodeid.u64
    } else {
        return 0
    }
}

# the stamp id recorded for node `nid`.
stampIdOf: function {symtab: zenv.ZSymbolTable.view nid: u64} out ztypes.tid is {
    return (ztypes.tid.create from: (ztyping.nodeTypeAt tbl: symtab.typing.nodeType :nid))
}

# stampIsStr / stampIsSv -- the type the checker stamped on `nid` IS String
# / StringView. Thirteen sites read a stamp for no other reason than to ask
# this, and each had to name the intermediate; the QUESTION is the thing worth
# naming, not the tid it goes through.
stampIsStr: function {symtab: zenv.ZSymbolTable.view ctx: Ctx.view nid: u64} out bool is {
    return (stampIdOf :symtab :nid) == ctx.strTid
}

# whether a node's stamped type is StringView, which decides the whole
# string emit path
stampIsSv: function {symtab: zenv.ZSymbolTable.view ctx: Ctx.view nid: u64} out bool is {
    return (stampIdOf :symtab :nid) == ctx.svTid
}

# monoStampIdOf -- the per-mono side stamp for a template node: the
# checker's instance walk records (monoId << 32 | nodeid) -> tid; consulted
# during mono re-walks (ctx.curThisTid) before any fallback resolution.
monoStampIdOf: function {symtab: zenv.ZSymbolTable.view ctx: Ctx.view nid: u64} out ztypes.tid is {
    if ctx.curThisTid.isZero then return (ztypes.tid.create from: 0)
    mk: (ztyping.monostamp mono: ctx.curThisTid.u64 node: nid)
    go: symtab.typing.monoNodeType.get key: mk
    match (
        go
    ) case some then {
        return (ztypes.tid.create from: go)
    } case none then {
        return (ztypes.tid.create from: 0)
    }
}

# binopStampAt -- the operator stamp a binop node carries: the instance table
# first when an instance walk is emitting, then the plain one. The owner and
# the method are two columns of one answer, so one walk reads either.
binopStampAt: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    nid: u64
    # read the resolved METHOD rather than the declaring owner
    wantMethod: bool
} out ztypes.tid is {
    if ctx.curThisTid > 0 then {
        mk: (ztyping.monostamp mono: ctx.curThisTid.u64 node: nid)
        mo: symtab.typing.monoBinopOwner.get key: mk
        if wantMethod then mo = symtab.typing.monoBinopMethod.get key: mk
        if mo.some then return (ztypes.tid.create from: mo)
    }
    go: symtab.typing.binopOwner.get key: nid
    if wantMethod then go = symtab.typing.binopMethod.get key: nid
    return (go.or d: ztypes.tid)
}

# binopOwnerAt / binopMethodAt -- the operator resolution the type checker
# recorded for a binop node: the type that DECLARES the operator, and the
# method it resolved to (0 where none was declared). The instance-walk answer
# comes first, because a monomorphised body re-walks the TEMPLATE's nodes --
# the flat table holds nothing for them, and one template node carries a
# different answer per instance. Both facts read through one accessor each so
# that no caller can consult one table and forget the other; consulting only
# the flat one is exactly what makes stampIdDeep blind inside a generic body.
binopOwnerAt: function {symtab: zenv.ZSymbolTable.view ctx: Ctx.view nid: u64} out ztypes.tid is {
    return (binopStampAt :symtab :ctx :nid wantMethod: false)
}

# the method a binary operator resolved to, read from the stamp rather than
# re-resolved
binopMethodAt: function {symtab: zenv.ZSymbolTable.view ctx: Ctx.view nid: u64} out ztypes.tid is {
    return (binopStampAt :symtab :ctx :nid wantMethod: true)
}

# nativeMemberKey -- the natives.tbl path of a MEMBER on a native receiver:
# the receiver's source path and the member name. Built in one place because
# two places building it would be two spellings of one key, and the table
# answers only the spelling it was given.
#
# It takes the PATH and not the tid on purpose. Deriving the path here would
# read well and cost a second convSrcPathOf on the conversion leg, which
# already holds one -- measured at 4,617 needless copies per self-compile.
nativeMemberKey: function {srcPath: StringView memb: StringView} out String is {
    if srcPath.length == 0 then return "".string
    return "\{srcPath}.\{memb}"
}

# convSrcPathOf -- the `<unit>.<type>` half of a conversion path, built from
# the SOURCE type's id. A conversion is declared on the type it converts FROM,
# so that type is the path's owner; a typedef converts as its chain end, which
# is where the declaration lives. "" when the source names no declaring unit,
# which is how a member that merely LOOKS like a type name -- a user record's
# field called `u32` -- fails to find a row and is not treated as a conversion.
convSrcPathOf: function {symtab: zenv.ZSymbolTable.view srcTid: ztypes.tid} out String is {
    if srcTid.isZero then return "".string
    uo: definedInUnitOf :symtab tid: srcTid
    match (
        uo
    ) case some then {
        tn: regNameOf :symtab tid: srcTid
        if tn.length == 0 then return "".string
        k: "\{uo}.\{tn}"
        return k
    } case none then null
    return "".string
}

# binopKeyOf -- the natives.tbl path for an operator on `owner`. A declared
# native is three segments, `<declaring unit>.<type>.<operator>`, built from
# the owner's id rather than from anything the source spelled. The synthesised
# structural cases have no declaration, and their `@` prefix keeps them out of
# the declaration space: a free function's path is `<unit>.<name>`, two segments
# just like theirs. They key on the SHAPE
# the emitter would have built by hand -- a variant's tag compare, a record's
# byte compare, or the inline compare a record whose typedef chain ends at a
# scalar gets instead.
binopKeyOf: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    owner: ztypes.tid
    isNative: bool
    op: StringView
} out String is {
    if isNative then {
        uo: definedInUnitOf :symtab tid: owner
        match (
            uo
        ) case some then {
            tn: regNameView :symtab tid: owner
            k: "\{uo}.\{tn}.\{op}"
            return k
        } case none then null
        return "".string
    }
    tt: symtab.reg.typetypeOf typeId: owner
    # an ORDINAL PAIR is a C scalar, so it compares with `==` rather than
    # through the tagged-struct comparator it has no struct for
    if (isOrdinalVariant :symtab tid: owner) then {
        k0: "@scalar.\{op}"
        return k0
    }
    if tt == ztypes.ztypetype.variantType then {
        k1: "@variant.\{op}"
        return k1
    }
    if tt == ztypes.ztypetype.recordType then {
        bn: typedefChaseBaseName :ast :symtab tid: owner
        if bn.length > 0 then {
            sc: (scalarCTypeFor
                :symtab
                name: bn.stringView
                tid: (typedefChaseTid :symtab tid: owner)
            )
            if sc.length > 0 then {
                k2: "@scalar.\{op}"
                return k2
            }
        }
        k3: "@record.\{op}"
        return k3
    }
    return "".string
}

# dottedTaggedTid -- the tagged-construction stamp for a dotted node: the
# variant/union type id when the path names a subtype member on the TYPE
# (`Type.arm`); 0 otherwise.
dottedTaggedTid: function {symtab: zenv.ZSymbolTable.view nid: u64} out u64 is {
    go: symtab.typing.dpTaggedParent.get key: nid
    match (
        go
    ) case some then {
        return go
    } case none then {
        return 0
    }
}

# dottedArmPredicateTid -- the arm-predicate stamp for a dotted node: the
# variant/union type id when `value.arm` is a tag test; 0 otherwise.
dottedArmPredicateTid: function {symtab: zenv.ZSymbolTable.view nid: u64} out u64 is {
    go: symtab.typing.dpArmPredicate.get key: nid
    match (
        go
    ) case some then {
        return go
    } case none then {
        return 0
    }
}

# dottedTagReadTid -- the tag-accessor stamp for a dotted node: the variant/
# union type id when `value.<accessor>` reads the discriminator; 0 otherwise.
dottedTagReadTid: function {symtab: zenv.ZSymbolTable.view nid: u64} out u64 is {
    go: symtab.typing.dpTagRead.get key: nid
    match (
        go
    ) case some then {
        return go
    } case none then {
        return 0
    }
}

# dataBlockTid -- the DATA type a data-block reference resolved to, read off
# the refDecl stamp on the access base. userFnId cannot serve here: it resolves
# against ctx.mainName, so it is main-relative and answers with the main unit's
# block for a dependency unit's reference.
dataBlockTid: function {symtab: zenv.ZSymbolTable.view nid: u64} out ztypes.tid is {
    if nid == 0 then return (ztypes.tid.create from: 0)
    rd: ztypes.declid
    {
        go: symtab.typing.refDecl.get key: nid
        match (
            go
        ) case some then {
            rd = go
        } case none then null
    }
    if rd.u64 == 0 then return (ztypes.tid.create from: 0)
    t: u64
    {
        d: symtab.typing.decls.get i: rd.u64
        t = d.typeId
    }
    if t == 0 then return (ztypes.tid.create from: 0)
    if (
        (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: t.u64)) != ztypes.ztypetype.dataType
    ) then return (ztypes.tid.create from: 0)
    return (ztypes.tid.create from: t)
}

# matchDiverges -- true when a match node is stamped `never` (the typechecker's
# exhaustive + all-arms-diverge result), so its `default:` is provably unreachable.
matchDiverges: function {symtab: zenv.ZSymbolTable.view nid: u64} out bool is {
    tid: stampIdOf :symtab :nid
    if tid.isZero then return false
    tt: symtab.reg.typetypeOf typeId: tid
    if tt == ztypes.ztypetype.neverType then return true
    return false
}

# blockDiverges -- the block's last statement leaves the block on every path: a
# `return`, or any statement the typechecker stamped `never` (panic, unreachable,
# break, continue, an exhaustive all-arms-diverge match). Whatever a caller would
# append after such a block is unreachable. Ask it about the block YOU emitted --
# an `if c then { break }` diverges as a block, its enclosing block does not.
blockDiverges: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: astnode.view
} out bool is {
    if (ztypecheck.blockEndsInReturn :ast block: n) then return true
    match (
        n
    ) case statement then {
        # ANY diverging statement makes the rest of the block unreachable, so
        # the block diverges -- not just a diverging last statement
        stx729: u64
        for stx729 < n.statements.count.u64 loop {
            dsId: zast.kidAt kids: ast.kids span: n.statements i: stx729
            stx729 = stx729 + 1
            if (stmtDiverges
                :ast
                :symtab
                :ctx
                sid: (zast.nodeid.create from: dsId.u64)
            ) then return true
        }
        return false
    } else {
        return false
    }
}

# stmtDiverges -- one statement leaves its block on every path: a `never` stamp
# (panic, unreachable, break, continue, an all-arms-diverge match), a `return`
# valued or bare, an if/else chain whose every arm diverges, or a `for true loop`
# with no break.
stmtDiverges: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    sid: zast.nodeid
} out bool is {
    if sid.isZero then return false
    sn: ast.nodes.get i: sid.u64
    match (
        sn
    ) case statementline then {
        inn: ast.nodes.get i: sn.statementline.u64
        # the typechecker's `never` stamp IS the control-flow fact: checkCase
        # only stamps it on an exhaustive match whose every arm -- else included
        # -- diverges, and a panic or diverging call carries it because it does
        # not return. No shape-matching needed here.
        if (matchDiverges :symtab nid: sid.u64) then return true
        if (matchDiverges :symtab nid: sn.statementline.u64) then return true
        if (isBareReturn :ast n: inn) then return true
        if (loopNeverExits :ast :symtab n: inn) then return true
        return (ifDiverges :ast :symtab :ctx n: inn)
    } else {
        return false
    }
}

# isBareReturn -- a valueless `return`, which parses as an atom rather than the
# call shape ztypecheck.blockEndsInReturn looks for. Diverges all the same.
isBareReturn: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case expression then {
        return (isBareReturn :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return n.name.u32 == zast.names.wkReturn
    } else {
        return false
    }
}

# loopNeverExits -- a `for true loop` with no break: its only exits are the
# return/panic statements inside it, so anything after the loop is unreachable.
# The condition is checked as the literal `true`; a computed condition, a
# postcondition, or any break leaves a normal exit and the answer is false.
loopNeverExits: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case expression then {
        return (loopNeverExits :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } case forexpr then {
        if n.body.isZero then return false
        if n.postconditions.count.u64 > 0 then return false
        if n.conditions.count.u64 != 1 then return false
        firstCondNode: ast.nodes.get i: (zast.kidAt kids: ast.kids span: n.conditions i: 0).u64
        alwaysT: false
        if firstCondNode.namedoperation then {
            if firstCondNode.name.isZero then {
                cop: ast.nodes.get i: firstCondNode.operation.u64
                if (boolArmSideOf :ast :symtab n: cop).truthy then alwaysT = true
                # `true` also arrives as the dotted tag bool.true
                if cop.dottedpath then {
                    chn: atomNameIdOf :ast n: (ast.nodes.get i: cop.child.u64)
                    chs: armSideAtNode :symtab nid: cop.nodeid.u64 nameId: chn
                    if chs.truthy then alwaysT = true
                }
            }
        }
        if alwaysT == false then return false
        return (ztypecheck.blockHasBreak
            :ast
            n: (ast.nodes.get i: n.body.u64)
        ) == false
    } else {
        return false
    }
}

# ifDiverges -- an if/else chain every arm of which diverges, else included. No
# else clause means the fall-through path is live, so the chain does not.
ifDiverges: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case expression then {
        return (ifDiverges :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case ifexpr then {
        # a chain whose every condition folds emits ONE branch, so only that
        # branch decides -- the arms the emitter dropped cannot run. Mirrors the
        # fold in emitStmt's ifexpr case.
        ffb: foldedBranchOf :symtab nid: n.nodeid.u64
        if ffb.known then {
            # every branch folded away: nothing is emitted, so nothing diverges
            if ffb.stmt.isZero then return false
            return (blockDiverges
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: ffb.stmt.u64)
            )
        }
        if n.elseclause.isZero then return false
        clx949: u64
        for clx949 < n.clauses.count.u64 loop {
            cId: zast.kidAt kids: ast.kids span: n.clauses i: clx949
            clx949 = clx949 + 1
            cl: ast.nodes.get i: cId.u64
            match (
                cl
            ) case ifclause then {
                if cl.statement.isZero then return false
                if (
                    (blockDiverges
                        :ast
                        :symtab
                        :ctx
                        n: (ast.nodes.get i: cl.statement.u64)
                    ) ==
                    false
                ) then return false
            } else {
                return false
            }
        }
        return (blockDiverges
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.elseclause.u64)
        )
    } else {
        return false
    }
}

# stampNameOf -- the registry name of a node's stamped type ("" unstamped).
stampNameOf: function {symtab: zenv.ZSymbolTable.view nid: u64} out String is {
    go: ztyping.nodeTypeAt tbl: symtab.typing.nodeType :nid
    if go > 0 then return (symtab.reg.nameOf tid: (ztypes.tid.create from: go.u64))
    return "".string
}

# builtinTidInU -- builtinTid for a builtin DECLARED IN `unit`: currentUnit is
# walkLookupTyperef's first probe, so naming the unit resolves without leaning on
# the stdlib fallbacks. For the builtins `core` does not re-export.
# builtinTidInU -- the canonical registry id of a stdlib builtin DECLARED IN
# `unitName`: currentUnit is walkLookupTyperef's first probe, so naming the unit
# is the qualified lookup, for the builtins `core` does not re-export. Passing
# "" is the unqualified form and the only other caller is builtinTid.
builtinTidInU: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    unitName: StringView
    base: StringView
} out u64 is {
    # every caller names the declared family form directly (ListRef, MapRR,
    # ...) and consumes what resolution already minted: the read-only walk
    # answers without the checker's mint legs.
    ud9: ztypecheck.unitDeclOfName st: symtab nameId: (zast.poolFind pool: ast.names text: unitName)
    return ((ztypecheck.walkLookupTyperefRo
        frame: ztypes.declid
        :ast
        st: symtab
        unitDecl: ud9
        :base
    ).or
        d: 0
    )
}

# builtinTid -- builtinTidInU with no unit named, so a user type of the same
# name never shadows it. 0 when absent from the program.
builtinTid: function {ast: Ast.view symtab: zenv.ZSymbolTable.view base: StringView} out u64 is {
    return (builtinTidInU :ast :symtab unitName: "" :base)
}

# specStemTid -- the minted instance of a system template over one or two
# concrete arguments, every part named by its SOURCE name (`optionval` over
# `u64`). A runtime fragment's text still carries the mangled spelling, but the
# identity comes off the spec trie. 0 when that instance was never demanded.
specStemTid: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    base: StringView
    arg1: StringView
    arg2: StringView
} out ztypes.tid is {
    arg2Tid: u64
    if arg2.length > 0 then arg2Tid = builtinTid :ast :symtab base: arg2
    templateTid9: (builtinTid :ast :symtab :base)
    a19: (builtinTid :ast :symtab base: arg1)
    return (specTidArgs
        :symtab
        templateTid: templateTid9
        a1: a19
        a2: arg2Tid
    )
}

# specTidArgs -- specStemTid's core, taking the argument TYPE IDS directly so a
# nested instance (Result over List_String) can be composed one level at a time.
specTidArgs: function {
    symtab: zenv.ZSymbolTable.view
    templateTid: u64
    a1: u64
    a2: u64
} out ztypes.tid is {
    argTids: ListVal u64
    argTids.append a1
    if a2 > 0 then argTids.append a2
    return (ztypecheck.specLookup
        st: symtab
        templateId: (ztypes.tid.create from: templateTid.u64)
        args: argTids
    )
}

# originTidOf -- a type's genericOriginId (the template it monomorphized from), or
# 0 when it has none. The id form of monoOriginName.
originTidOf: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out ztypes.tid is {
    # a partial spec (GENERIC_PARAM typetype) is trie bookkeeping, never an
    # emittable mono; origin-keyed sweeps must not select it
    if (symtab.reg.typetypeOf typeId: tid) == ztypes.ztypetype.genericParam then (return
        (ztypes.tid.create from: 0)
    )
    return (symtab.reg.genericOriginOf :tid)
}

# originIsTid -- true when tid's generic origin equals the (nonzero) originTid.
# The 0-guard means an origin-less type never matches an unresolved (0) builtin.
originIsTid: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
    originTid: ztypes.tid
} out bool is {
    if originTid.isZero then return false
    ot: originTidOf :symtab :tid
    return ot.u64 == originTid
}

# dataconstkey / dataslotkey -- which element of which data block. A data
# element is reached two ways -- `primes.first` by LABEL and `primes.0` by
# ORDINAL -- and a nameid and an ordinal are two id spaces, so they are two
# TABLES rather than one string that could spell either. Both fields are
# widened to u64 so the key has no padding for the container's byte hash to
# read (the callslot / constslot shape).
dataconstkey: record {
    # the data block's type
    owner: u64
    # the constant's name. The pair keys the emitted constant
    name: u64
}

# which element of which data block, as one key
dataslotkey: record {
    # the data block's type
    owner: u64
    # which element. The pair keys the emitted slot
    slot: u64
}

# The builtin templates the emitter keys on by ORIGIN tid, one constant per
# family. The constant IS the index into `ctx.origins`, so
# `ctx.origins.get i: ogListVal` is the tid `ListVal` was minted from -- and an
# id compare against it is shadow-proof, which comparing the spelling was not.
ogStr: 0.u64
ogArray: 1.u64
ogList: 2.u64
ogListVal: 3.u64
ogListView: 4.u64
ogListViewVal: 5.u64
ogMap: 6.u64
ogMapRV: 7.u64
ogMapVR: 8.u64
ogMapVV: 9.u64
ogSet: 10.u64
ogSetVal: 11.u64
ogIdMapR: 12.u64
ogIdMapV: 13.u64
ogIdSet: 14.u64
ogIdSetIter: 15.u64
ogIdMapItemIterR: 16.u64
ogIdMapItemIterV: 17.u64
ogIdMapEntryR: 18.u64
ogIdMapEntryV: 19.u64
ogMapEntry: 20.u64
ogListIter: 21.u64
ogListIterVal: 22.u64
ogSetIter: 23.u64
ogSetIterVal: 24.u64
ogMapKeyIter: 25.u64
ogMapItemIter: 26.u64
ogMapKeyIterRV: 27.u64
ogMapKeyIterVR: 28.u64
ogMapKeyIterVV: 29.u64
ogMapItemIterRV: 30.u64
ogMapItemIterVR: 31.u64
ogMapItemIterVV: 32.u64
ogMapEntryRV: 33.u64
ogMapEntryVR: 34.u64
ogMapEntryVV: 35.u64
ogOption: 36.u64
ogOptionView: 37.u64
ogResult: 38.u64
ogOptionval: 39.u64
ogResultval: 40.u64

# ogNone -- one past the last row: both the count and the "not one of ours"
# answer, so no real index can be mistaken for it.
ogNone: 41.u64

# The names the emitter DISPATCHES on -- a member selector, or the base atom of
# a path it recognises -- interned once per program. The
# constant IS the index into `ctx.mnames`, exactly as `ogXxx` indexes
# `ctx.origins` -- and an id compare is what the text compare was reaching for,
# without copying the name out of the pool to make it. A name this program
# never interned answers 0, and no member's name id is 0, so the miss is the
# right answer by construction.
mnOrPanic: 0.u64
mnCopy: 1.u64
mnPrivate: 2.u64
mnMeta: 3.u64
mnOption: 4.u64
mnResult: 5.u64
mnDrop: 6.u64
mnPrint: 7.u64
mnPanic: 8.u64
mnError: 9.u64
mnAppend: 10.u64
mnInsert: 11.u64
mnPush: 12.u64
mnGetMut: 13.u64
mnPop: 14.u64
mnExtend: 15.u64
mnHas: 16.u64
mnDelete: 17.u64
mnKeyAt: 18.u64
mnValueAt: 19.u64
mnBorrow: 20.u64

# ogPut -- place one row AT its own constant. Writing the index and the name
# together is what keeps the two halves of the table in step; a row that drifts
# fails here rather than silently renaming a family.
ogPut: function {acc: List String at: u64 name: StringView} is {
    if acc.length != at then {
        m: "zemitterc: origin table out of order at \{at} (\{name})"
        panic msg: m
    }
    acc.append name.string
}

# mnPut / memberDispatchNames -- ogPut's twin for the member-name table: the
# list and the mnXxx constants are one table written twice, so the filler
# checks the row it is about to write is the row the constant names.
mnPut: function {acc: List String at: u64 name: StringView} is {
    if acc.length != at then {
        m: "zemitterc: member-name table out of order at \{at} (\{name})"
        panic msg: m
    }
    acc.append name.string
}

# the member names a dispatch table needs, collected in one pass
memberDispatchNames: function {acc: List String} is {
    mnPut :acc at: mnOrPanic name: "orPanic"
    mnPut :acc at: mnCopy name: "copy"
    mnPut :acc at: mnPrivate name: "private"
    mnPut :acc at: mnMeta name: "meta"
    mnPut :acc at: mnOption name: "Option"
    mnPut :acc at: mnResult name: "Result"
    mnPut :acc at: mnDrop name: "drop"
    mnPut :acc at: mnPrint name: "print"
    mnPut :acc at: mnPanic name: "panic"
    mnPut :acc at: mnError name: "error"
    mnPut :acc at: mnAppend name: "append"
    mnPut :acc at: mnInsert name: "insert"
    mnPut :acc at: mnPush name: "push"
    mnPut :acc at: mnGetMut name: "getMut"
    mnPut :acc at: mnPop name: "pop"
    mnPut :acc at: mnExtend name: "extend"
    mnPut :acc at: mnHas name: "has"
    mnPut :acc at: mnDelete name: "delete"
    mnPut :acc at: mnKeyAt name: "keyAt"
    mnPut :acc at: mnValueAt name: "valueAt"
    mnPut :acc at: mnBorrow name: "borrow"
}

# mnIs -- is `id` the dispatch name at index `at`? TWO zeros meet here and they
# are not the same zero: a node with no member name answers 0, and a name this
# program never interned is 0 in the table. Comparing them directly would say
# yes to every nameless callable, so a zero id is no name at all and answers no.
mnIs: function {ctx: Ctx.view id: zast.nameid at: u64} out bool is {
    if id.isZero then return false
    return id == (ctx.mnames.get i: at)
}

# buildMemberNameIds -- those names as pool ids for the program being emitted,
# in mnXxx order. A carrier with no program answers zeros, which match nothing.
buildMemberNameIds: function {program: Ast.view acc: ListVal zast.nameid} is {
    names: List String
    memberDispatchNames acc: names
    mn9: names.length
    mi9: u64
    for mi9 < mn9 loop {
        nm9: names.get i: mi9
        acc.append (zast.poolFind pool: program.names text: nm9.stringView)
        mi9 = mi9 + 1
    }
}

# originBaseNames -- those templates by name, in ogXxx order. This list and the
# constants above are the same table read two ways; nothing else may reorder it,
# because the index is the identity.
originBaseNames: function {acc: List String} is {
    ogPut :acc at: ogStr name: "str"
    ogPut :acc at: ogArray name: "array"
    ogPut :acc at: ogList name: "ListRef"
    ogPut :acc at: ogListVal name: "ListVal"
    ogPut :acc at: ogListView name: "ListView"
    ogPut :acc at: ogListViewVal name: "ListViewVal"
    ogPut :acc at: ogMap name: "MapRR"
    ogPut :acc at: ogMapRV name: "MapRV"
    ogPut :acc at: ogMapVR name: "MapVR"
    ogPut :acc at: ogMapVV name: "MapVV"
    ogPut :acc at: ogSet name: "SetRef"
    ogPut :acc at: ogSetVal name: "SetVal"
    ogPut :acc at: ogIdMapR name: "IdMapR"
    ogPut :acc at: ogIdMapV name: "IdMapV"
    ogPut :acc at: ogIdSet name: "IdSet"
    ogPut :acc at: ogIdSetIter name: "IdSetIter"
    ogPut :acc at: ogIdMapItemIterR name: "IdMapItemIterR"
    ogPut :acc at: ogIdMapItemIterV name: "IdMapItemIterV"
    ogPut :acc at: ogIdMapEntryR name: "IdMapEntryR"
    ogPut :acc at: ogIdMapEntryV name: "IdMapEntryV"
    ogPut :acc at: ogMapEntry name: "MapEntry"
    ogPut :acc at: ogListIter name: "ListIter"
    ogPut :acc at: ogListIterVal name: "ListIterVal"
    ogPut :acc at: ogSetIter name: "SetIter"
    ogPut :acc at: ogSetIterVal name: "SetIterVal"
    ogPut :acc at: ogMapKeyIter name: "MapKeyIter"
    ogPut :acc at: ogMapItemIter name: "MapItemIter"
    ogPut :acc at: ogMapKeyIterRV name: "MapKeyIterRV"
    ogPut :acc at: ogMapKeyIterVR name: "MapKeyIterVR"
    ogPut :acc at: ogMapKeyIterVV name: "MapKeyIterVV"
    ogPut :acc at: ogMapItemIterRV name: "MapItemIterRV"
    ogPut :acc at: ogMapItemIterVR name: "MapItemIterVR"
    ogPut :acc at: ogMapItemIterVV name: "MapItemIterVV"
    ogPut :acc at: ogMapEntryRV name: "MapEntryRV"
    ogPut :acc at: ogMapEntryVR name: "MapEntryVR"
    ogPut :acc at: ogMapEntryVV name: "MapEntryVV"
    ogPut :acc at: ogOption name: "Option"
    ogPut :acc at: ogOptionView name: "OptionView"
    ogPut :acc at: ogResult name: "Result"
    ogPut :acc at: ogOptionval name: "optionval"
    ogPut :acc at: ogResultval name: "resultval"
}

# buildOriginTids -- resolve every row in one pass. A unit with no program node
# registers none of them and every row stays 0; the list is filled either way,
# so an ogXxx index is always in range.
buildOriginTids: function {
    program: Ast.view
    symtab: zenv.ZSymbolTable.view
    acc: ListVal ztypes.tid
} is {
    names: List String
    originBaseNames acc: names
    n: names.length
    i: u64
    for i < n loop {
        nm: names.get :i
        bt: builtinTid ast: program :symtab base: nm.stringView
        acc.append (ztypes.tid.create from: bt)
        i = i + 1
    }
}


# Ctx -- the per-program emission context (anchor cnames, main unit name,
# the literal pool, and the resolved-name map access).
Ctx: class {
    # the main unit's name as the C sees it
    mainName: String
    # the namespace unit whose functions are being emitted, 0 while emitting
    # the file unit's own. A name written inside a namespace resolves against
    # IT first: `deep.mul` in mymod/helper.z names helper's subunit, not one of
    # mymod's, and ctx.mainName can only ever name the file.
    nsTid: ztypes.tid
    # the real entry point's name, which differs when a wrapper stands in front
    # of it
    realMain: String
    # the C name of the String runtime type, looked up once because everything
    # touching strings needs it
    strC: String
    # the C name of the StringView runtime type
    svC: String
    # type id -> C name base, composed once at emit start; "" for a hole
    cnames: List String
    # the literal pool's ids in emission order
    litIds: ListVal u64
    # which literals were actually referenced, so the unused ones are not
    # emitted
    usedLits: IdSet u64
    # the FOLDED-string pool, beside the AST-literal one. A folded value has no
    # literal to point at -- a concatenation and a selected branch were never
    # written anywhere -- so litIndexOf cannot serve it. Rendered `_zcsN` in the
    # same static z_StringView_t shape as `_zs`, and MINTING IS THE USE: an
    # entry exists only because something asked to emit it, so unlike usedLits
    # there is no separate mark.
    constLits: List String
    # every runtime demand, as the (unit, member) PAIRS they are: parallel
    # rows, never joined. Joining them would only have to be split apart again
    # to name the fragment. A member of `@unit` is the unit ITSELF being
    # demanded.
    needUnits: List String
    # members some fragment needs declared before it can be emitted
    needMembs: List String
    # each data block's element text, by type
    dataElems: (IdMapR ztypes.tid V: String)
    # each data constant's emitted text, keyed by owner and name
    dataConst: (MapVR dataconstkey V: String)
    # each data slot's emitted text, keyed by owner and slot
    dataSlot: (MapVR dataslotkey V: String)
    # the current class method body's pointer-receiver params, by variable id
    ptrVids: ListVal ztypes.vid
    # the enclosing function hands back a REFERENCE to a user reftype, so its
    # `return` yields an address. Per-function, set by emitFnBody like ptrVids.
    refBorrowRet: bool
    # variables that are aliases of another's storage, so a write through one is
    # a write through both
    aliases: List VidVal
    # the box a narrowed variable projects out of
    narrowBox: List VidVal
    # the type a variable is currently narrowed to
    narrowTid: List VidTid
    # the arms ruled out for a variable, which lets a switch omit them
    exclArms: List VidVal
    # the types behind those exclusions
    exclTids: List VidTid
    # whether a generator body is being emitted, which changes what a return
    # means
    genActive: bool
    # the emitted C name of the generator receiver, for the state-machine
    # prologue: it is a renamed parameter, not the literal `this`
    genRecvC: String
    # and the emitted name of its resume-value parameter
    genValC: String
    # how many yields the generator has, so the state machine knows its arms
    genYieldCount: u64
    # the next yield's number as the body is walked
    genYieldNext: u64
    # the last `_fc_<k>` loop-counter field handed to a counted `for` whose
    # body suspends. Which field a loop gets does not matter, only that each
    # gets its own: they are all i64, and the lowering allocated at least this
    # many by the same walk
    genForNext: u64
    # the counted `for` loops currently open around the statement being
    # emitted, innermost last. Every suspension spills all of them and every
    # resume label reloads them
    genForSpills: List ForSpill
    # the yield number of each yield HOISTED out of expression position, by
    # call node id. The suspension runs as its own statement and the resume
    # value lands in `_yv_<k>`; the expression emitter then renders that yield
    # as a plain read of it
    yieldTempK: (IdMapV u64 v: u64)
    # the wrapper type the generator's `.call` returns
    genWrap: String
    # that wrapper's some tag
    genSomeTag: String
    # the wrapper's none tag, which the generator returns once it is exhausted
    genNoneTag: String
    # the payload's C type
    genPayC: String
    # whether the generator yields a value at all, as against yielding only to
    # suspend
    genHasValue: bool
    # the receiver type being emitted into, which decides what a bare member
    # resolves against
    curThisTid: ztypes.tid
    # use the fast hash rather than the seeded one, which makes a build
    # reproducible
    fastHash: bool
    # emit source-derived C names instead of id-based ones, for reading the
    # output rather than shipping it
    readableNames: bool
    # under --readable-names, the variables that may be spelled by their source
    # name alone: the first binding of a name in a function. Empty under the
    # default scheme, which asks no such question -- an id is unique already.
    rnBareVids: IdSet ztypes.vid
    # whether the statement being emitted is in tail position, where a return
    # needs no jump
    tailRetActive: bool
    # which unit each definition came from
    defUnitId: (IdMapV u64 v: u64)
    # the four stdlib units the emitter names outright, resolved once
    ioUnitDecl: u64
    # the os unit's declaration, cached because the native routing asks
    # constantly
    osUnitDecl: u64
    # the cli unit's declaration, cached for the same reason
    cliUnitDecl: u64
    # the net unit's declaration, cached for the same reason
    netUnitDecl: u64
    # the three fixed (unit, class) hooks, resolved once through the unit
    ioFileTid: u64
    # net.Listener's type, needed to route its natives
    netListenerTid: u64
    # net.Conn's type, needed to route its natives
    netConnTid: u64
    # the unit types, parallel to unitKeysC
    unitTidsC: ListVal ztypes.tid
    # their C keys, built once and reused
    unitKeysC: List String
    # whether those two are built yet
    unitCacheBuilt: bool
    # the member names this program interned, indexed by the mnXxx constants
    mnames: ListVal zast.nameid
    # name-id -> resolved tid (misses cached as 0): the typed model is
    # frozen during emission, so resolution per name id is emit-stable
    resolveByNameC: (IdMapV u64 v: u64)
    # the main unit's declaration, which every demand walk starts from
    mainUnitId: ztypes.declid
    # how deep in nested conditions the emit is, which decides whether a temp
    # can be hoisted out
    condDepth: u64
    # the constructs the emitter could not handle, collected rather than thrown
    # so one run reports all of them
    emitErrors: List String
    # the user types whose struct is already out, so a second demand does not
    # emit it twice
    emittedUserTypes: IdSet u64
    # each sum's tag stem, so its arms' tags agree
    tagStems: (MapRV String v: u64)
    # the types already forward-declared. Asking whether a FORWARD exists is not
    # the same as asking whether the body is out, and conflating them emits
    # invalid C
    fwdDeclaredTypes: IdSet u64
    # runtime templates already substituted, keyed by their instantiation
    tmplCache: (Map String V: String)
    # each io canonical stem's C name
    ioCanonC: (Map String V: String)
    # natives.tbl, read once at emit start: qualified path -> the C body, plus
    # the two row attributes. Parsed eagerly rather than on first lookup
    # because the lookup site is inside emitExpr, which holds a Ctx but not the
    # runtime dir; emitC has both.
    nativeTbl: (Map String V: String)
    # what each native fragment needs declared before it
    nativeNeed: (Map String V: String)
    # which natives take their arguments by pointer
    nativePtrArgs: (MapRV String v: bool)
    # a row that answers only when named ARGUMENTS are compile-time constants,
    # kept beside the ordinary body rather than in it: `nativeTbl` is keyed by
    # path alone, so a second row of the same path would overwrite the first
    # and the guarded form would simply vanish. The body and the positions it
    # requires are two maps rather than one composed key for the same reason
    # the rest of this table is: the path IS the key.
    nativeConstBody: (Map String V: String)
    # which argument position of a native must be a constant
    nativeConstPos: (Map String V: String)
    # the conversion rows, split so the two questions stay separate: is this
    # member a CONVERSION at all (a type that converts, and a member every
    # converting type declares), and if so what C does this pair emit. Asking
    # only the second would make a missing row read as "not a conversion" and
    # write the dotted path through to the C compiler.
    # every row's path, whatever the row carries: the check at the declaration
    # asks only whether one exists
    nativeKeys: (MapRV String v: bool)
    # the paths a `fold` row marks: the compiler answers them at COMPILE TIME
    # and there is no implementation to call. A call reaching emission is a
    # defect in the fold, not a missing body, and says so.
    nativeFold: (MapRV String v: bool)
    # the paths a FRAGMENT implements: a native whose C the runtime supplies
    # under the `z_<unit>_<name>` convention, whoever declares it
    nativeFragPaths: (MapRV String v: bool)
    # which natives are conversion members, whose routing differs
    nativeConvMemb: (MapRV String v: bool)
    # the member NAMES of rows that take ARGUMENTS -- the cheap filter that
    # nativeConvMemb is for the receiver-only rows. A call asks this before it
    # builds a path, because building one per call on a native receiver is an
    # allocation for every such call in the program just to be told no.
    nativeArgMemb: (MapRV String v: bool)
    # the fragment-backed rows, as the (unit, demand) PAIR each is reached by
    # plus the fragments it needs. Parallel lists because the demand is a pair
    # and stays one: nothing here joins the halves, and nothing splits them.
    fragUnits: List String
    # the members fragments were emitted for
    fragMembs: List String
    # their names, parallel to fragMembs
    fragNames: List String
    # a row whose demand is `uses_<Type>` is reached by that TYPE being
    # constructed rather than by a member being called. The name the table
    # spells, and the id it resolves to once the registry is built; 0 on every
    # member-demanded row, which is nearly all of them.
    fragTypeNames: List String
    # their owning types, parallel again
    fragTypeTids: ListVal u64
    # the type ids those rows gate, and the ones the program actually built
    demandGatedTids: IdSet u64
    # the types something actually referenced, which is what decides emission
    usedTypeIds: IdSet u64
    # conformance rows whose helper set is already in the buffer, by row index
    emittedConformance: IdSet u64
    # the units the table orders, in that order. A unit with rows that is not
    # named here runs after those that are.
    unitOrder: List String
    # the `_ah` temp names awaiting declaration
    argHoistNames: List String
    # their initialisers, parallel to the names
    argHoistVals: List String
    # their C types, parallel again
    argHoistTypes: List String
    # the destructor each needs at block end, empty when it needs none
    argHoistDtors: List String
    # raw declarations a fragment asked to be emitted alongside
    argHoistRaw: List String
    # the next `_ah` number
    argHoistCtr: u64
    # the next `_wc` number: the guard a suspending `when` condition computes
    # into, since its value has to outlive the `if` that computes it
    whenGuardCtr: u64
    # the enclosing loops' break labels, innermost last
    breakLabels: ListVal u64
    # whether each is a do-while, whose continue target differs
    breakLabelIsDo: ListVal bool
    # which continue labels were actually jumped to, so an unused one is not
    # emitted
    contLabelUsed: (IdMapV u64 v: bool)
    # the next label number
    breakLabelCtr: u64
    # which break labels were actually used
    breakLabelUsed: (IdMapV u64 v: bool)
    # the frees mark at each loop's entry, so a break frees exactly the body's
    # locals
    breakFreesMarks: ListVal u64
    # the same for collection frees
    breakListMarks: ListVal u64
    # the cleanup a break must run before jumping
    breakLabelCleanup: List String
    # the variable each cleanup entry destroys
    breakLabelCleanupVar: List String
    # variables for breakLabelCleanupVar, for the same reason as TmpCtr's
    breakLabelCleanupRaw: ListVal ztypes.vid
    # variables that borrow rather than own, so scope exit frees nothing for
    # them
    borrowedVars: (IdMapV u64 v: bool)
    # whether a collection `get` is being emitted from code rather than from a
    # fragment, which changes the borrow it takes
    colGetFromCode: bool
    # String's type id
    strTid: ztypes.tid
    # StringView's type id
    svTid: ztypes.tid
    # converror's canonical id. The numeric-conversion rule is ABOUT converror --
    # natives.tbl's conversion rows name its arms -- so the emitter has to know
    # which type that is to spell the error assignment for its representation.
    converrorTid: ztypes.tid
    # the well-known generic origins -- Option, Result, List and the rest --
    # looked up once and compared by id after
    origins: ListVal ztypes.tid
}

# canonFnId -- userFnId, but a tid already carrying a generic origin is a
# registered mono and inherently canonical: skip the name round-trip and use it.
canonFnId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
    name: StringView
} out u64 is {
    if (originTidOf :symtab :tid) > 0 then return tid
    return (userFnId :ast :symtab :ctx :name)
}

# canonTypeId -- resolveTypeIdByName with the same mono short-circuit.
canonTypeId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
    name: StringView
} out u64 is {
    if (originTidOf :symtab :tid) > 0 then return tid
    byName: resolveTypeIdByName :ast :symtab :ctx :name
    if byName > 0 then return byName
    # The name route cannot reach a type declared in a NESTED unit -- there is
    # no name-index entry to find it by -- but the id in hand is already that
    # type. Accept it when it names a real aggregate, so a field typed through
    # a subunit compares field-wise instead of falling through to a C `==` on
    # two structs.
    tt: symtab.reg.typetypeOf typeId: tid
    if tt == ztypes.ztypetype.recordType then return tid
    if tt == ztypes.ztypetype.variantType then return tid
    return 0
}

# userFnId -- the resolved type id of a main-unit function name (0 absent).
userFnId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    name: StringView
} out ztypes.tid is {
    uq0z: ctx.mainUnitId
    nameId9: (zast.poolFind pool: ast.names text: name)
    go: (ztypecheck.resolveUnitChildRo
        :ast
        st: symtab
        unitDecl: uq0z
        nameId: nameId9
    )
    match (
        go
    ) case some then {
        return (ztypes.tid.create from: go)
    } case none then {
        return (ztypes.tid.create from: 0)
    }
}

# userFnIdById -- id-keyed userFnId: the child name is already an Ast.names id.
userFnIdById: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    nameId: zast.nameid
} out u64 is {
    uq1z: ctx.mainUnitId
    go: (ztypecheck.resolveUnitChildRo
        :ast
        st: symtab
        unitDecl: uq1z
        :nameId
    )
    match (
        go
    ) case some then {
        return go
    } case none then {
        return 0
    }
}

# dropPtrVid -- forget that `vid` arrives by pointer, for the scope in which a
# narrowing has shadowed it with its payload VALUE; the caller re-appends it
# when that scope closes.
dropPtrVid: function {ctx: Ctx vid: ztypes.vid} is {
    kept: ListVal ztypes.vid
    with it: ctx.ptrVids.iterate do for v: it loop {
        if v != vid then kept.append from: v
    }
    ctx.ptrVids = kept
}

# isPtrVid -- true when variable `vid` is a pointer-receiver param of the
# current class method body (so field reads emit `->` instead of `.`). The
# id-addressed form; a vid of 0 means the site had no variable to name and is
# never a pointer receiver.
isPtrVid: function {ctx: Ctx.view vid: ztypes.vid} out bool is {
    if vid.isZero then return false
    return (ctx.ptrVids.contains item: vid)
}

# needsValueDeref -- a pointer-valued expression standing where a VALUE is
# wanted: a return, a binding's initialiser, a match subject. An as-block
# method's receiver is a C pointer in EVERY family, so a read of it in one of
# those positions has to load the pointee; ~50 other sites ask pathIsPointer to
# choose `->` over `.` or to drop an `&`, and none of them wants the load.
# A user CLASS is the exception and the gate is not caution: it is the one
# family passed BY REFERENCE, so its pointer already IS the value, and loading
# one would copy a struct whose destructor the source still owns -- a double
# free, where leaving it alone is a C type error the compiler still catches.
needsValueDeref: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    tid: ztypes.tid
} out bool is {
    if (nodeIsBareAtom :ast :n) == false then return false
    if (pathIsPointer :ast :symtab :ctx :n) == false then return false
    return (isReftypeParam :ast :symtab :ctx :tid) == false
}

# whether a node is a bare atom, which is what decides whether a name can be
# used directly or needs an expression
nodeIsBareAtom: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case expression then {
        return (nodeIsBareAtom :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return true
    } else {
        return false
    }
}

# pathIsPointer -- does the expression evaluate to a C pointer? A ptrVar atom
# (pointer receiver / borrow param) or a dotted read of a borrowed field both do,
# so field access on them chains with `->`.
pathIsPointer: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
} out bool is {
    match (
        n
    ) case expression then {
        return (pathIsPointer :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        anP: ast.names.texts.get i: n.name.u64
        rnV0: atomVid :symtab nid: n.nodeid.u64
        rnv: ztypes.vid
        if (aliasResolvesToSelf :ctx name: anP.stringView vid: rnV0) then rnv = rnV0
        return (isPtrVid :ctx vid: rnv)
    } case labelvalue then {
        lnP: ast.names.texts.get i: n.name.u64
        rlnV0: atomVid :symtab nid: n.nodeid.u64
        rlv: ztypes.vid
        if (aliasResolvesToSelf :ctx name: lnP.stringView vid: rlnV0) then rlv = rlnV0
        return (isPtrVid :ctx vid: rlv)
    } case call then {
        # a reference-returning call yields `T*`. The arm narrows `n` to
        # callrow, so the astnode is re-fetched by its own id.
        cnd: ast.nodes.get i: n.nodeid.u64
        return (nodeIsRefBorrowResult :ast :symtab :ctx n: cnd)
    } case dottedpath then {
        # a ZERO-ARG auto-call reads as a dotted path, so a reference-returning
        # one is itself a `T*` and a read off it is `->`. The arm narrows `n`, so
        # the astnode is re-fetched by its own id.
        dnd: ast.nodes.get i: n.nodeid.u64
        if (nodeIsRefBorrowResult :ast :symtab :ctx n: dnd) then return true
        cn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        # the parent's stamp whatever its shape: a borrowed field reached
        # through a nested owned field (`p.left.s`) is a pointer too
        pnid: (zast.nodeIdOf n: (ast.nodes.get i: n.parent.u64)).u64
        pstamp: stampIdOf :symtab nid: pnid
        pstn: regNameOf :symtab tid: pstamp
        prid: canonTypeId :ast :symtab :ctx tid: pstamp name: pstn.stringView
        ptid: pstamp
        if prid > 0 then ptid = ztypes.tid.create from: prid.u64
        return (symtab.typing.declIsBorrowedField
            pool: ast.names
            parentTypeId: ptid
            name: cn.stringView
        )
    } else {
        return false
    }
}

# nodeIsRefBorrowResult -- the node evaluates to a reference-returning call's
# result, i.e. a `T*` in the emitted C.
nodeIsRefBorrowResult: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
} out bool is {
    f: refBorrowCalleeFid :ast :symtab :ctx :n
    if f == 0 then return false
    r: stampIdOf :symtab nid: (interpPartNodeId :n)
    return (fnReturnsRefBorrow :ast :symtab :ctx fid: (ztypes.tid.create from: f.u64) retTid: r)
}

# ForSpill -- one counted `for` open around the statement being emitted, and
# the state field its counter is saved to across a suspension. Keyed by C NAME
# rather than variable id because a `for` label has neither: it is a nameid on
# the header's namedoperation, and the checker binds it with `define` rather
# than `defineVar`, so no node carries a variable id to look up. The C name is
# the right key anyway -- the spill and the reload are both plain C
# assignments, written in the loop's own scope.
ForSpill: class {
    # which `_fc_<slot>` field on the state class holds this counter
    slot: u64
    # the counter's emitted C name, as the for-header declared it
    cname: String
}

# VidVal / VidTid -- assoc-list entries for the per-function narrowing and alias
# state, keyed by VARIABLE ID. A name conflates two bindings that happen to share
# it, and it is not a key a declaration site and a use site can both produce -- a
# variable id is both. A vid of 0 means "no variable here" and never keys an
# entry. A handful of entries at most, so a linear probe beats a map's per-probe
# owned-key allocation and hash.
VidVal: class {
    # the variable
    vid: ztypes.vid
    # the text recorded for it
    val: String
}

# a variable paired with a type, for the side lists that record what a
# variable was narrowed or excluded to. A pair rather than a map: the lists
# are short and scanned, never indexed
VidTid: class {
    # the variable
    vid: ztypes.vid
    # the type recorded for it
    tid: ztypes.tid
}

# vvFind -- the 1-based index of `vid`'s entry in `xs`, 0 when absent. The
# value is copied only on a hit, so a miss allocates nothing at all. vvGet's
# empty-String sentinel cost 277,711 one-byte allocations on a self-compile
# (2.9% of every allocation the compiler makes) because the miss is the common
# case: read through this, not vvGet, on any hot path.
vvFind: function {xs: (List VidVal).view vid: ztypes.vid} out u64 is {
    if vid.isZero then return 0
    i: u64
    n: xs.length
    for i < n loop {
        if (xs.get :i).vid == vid then return i + 1
        i = i + 1
    }
    return 0
}

# vvGet -- the value recorded for `vid`, "" when absent (values never empty).
vvGet: function {xs: (List VidVal).view vid: ztypes.vid} out String is {
    f: vvFind :xs :vid
    if f == 0 then return "".string
    return (xs.get i: f - 1).val.copy
}

# true when list `xs` has an entry for `vid`.
vvHas: function {xs: (List VidVal).view vid: ztypes.vid} out bool is {
    if vid.isZero then return false
    i: u64
    n: xs.length
    for i < n loop {
        if (xs.get :i).vid == vid then return true
        i = i + 1
    }
    return false
}

# vvSet -- replace-or-append: one entry per variable (map.set semantics).
vvSet: function {xs: List VidVal vid: ztypes.vid val: StringView} is {
    if vid.isZero then return
    i: u64
    n: xs.length
    for i < n loop {
        if (xs.get :i).vid == vid then {
            xs.set :i val: (VidVal :vid val: val.string)
            return
        }
        i = i + 1
    }
    xs.append (VidVal :vid val: val.string)
}

# vvRemove -- drop `vid`'s entry (swap-with-last; vids are unique).
vvRemove: function {xs: List VidVal vid: ztypes.vid} is {
    if vid.isZero then return
    i: u64
    n: xs.length
    for i < n loop {
        if (xs.get :i).vid == vid then {
            last: xs.pop
            if i + 1 < n then xs.set :i val: last
            return
        }
        i = i + 1
    }
}

# the type id bound to `vid` in `xs`, or none.
vtGet: function {xs: (List VidTid).view vid: ztypes.vid} out optionval ztypes.tid is {
    if vid.isZero then return (optionval.none ztypes.tid)
    i: u64
    n: xs.length
    for i < n loop {
        e: xs.get :i
        if e.vid == vid then return (optionval.some e.tid)
        i = i + 1
    }
    return (optionval.none ztypes.tid)
}

# bind `vid` to type id `tid` in `xs`.
vtSet: function {xs: List VidTid vid: ztypes.vid tid: ztypes.tid} is {
    if vid.isZero then return
    i: u64
    n: xs.length
    for i < n loop {
        if (xs.get :i).vid == vid then {
            xs.set :i val: (VidTid :vid :tid)
            return
        }
        i = i + 1
    }
    xs.append (VidTid :vid :tid)
}

# remove `vid`'s binding from `xs`.
vtRemove: function {xs: List VidTid vid: ztypes.vid} is {
    if vid.isZero then return
    i: u64
    n: xs.length
    for i < n loop {
        if (xs.get :i).vid == vid then {
            last: xs.pop
            if i + 1 < n then xs.set :i val: last
            return
        }
        i = i + 1
    }
}

# aliasResolvesToSelf -- does `vid` stand for its own name, rather than for a
# narrowing box or a take alias? The question aliasResolve is asked when the
# caller wants no text, only the answer; asking it this way copies nothing.
aliasResolvesToSelf: function {ctx: Ctx.view name: StringView vid: ztypes.vid} out bool is {
    nb: vvFind xs: ctx.narrowBox :vid
    if nb > 0 then {
        eNb: ctx.narrowBox.get i: nb - 1
        return (eNb.val.stringView == name)
    }
    al: vvFind xs: ctx.aliases :vid
    if al > 0 then {
        eAl: ctx.aliases.get i: al - 1
        return (eAl.val.stringView == name)
    }
    return true
}

# aliasResolve -- a `.take` alias's base C name, or the name itself if none.
aliasResolve: function {ctx: Ctx.view name: StringView vid: ztypes.vid} out String is {
    # A match-arm narrowing (narrowBox) takes priority: inside the arm the
    # variable resolves to the narrowed union payload cast, not the un-narrowed
    # binding or a stale for-loop/borrow/take alias -- mirrors takeSourceResolve.
    # `name` is only what comes back when neither table has an entry.
    nb: vvFind xs: ctx.narrowBox :vid
    if nb > 0 then return (ctx.narrowBox.get i: nb - 1).val.copy
    al: vvFind xs: ctx.aliases :vid
    if al > 0 then return (ctx.aliases.get i: al - 1).val.copy
    return name.string
}

# takeSourceResolve -- the C lvalue to zero after a take of `name`: a match-arm
# narrowing's union box payload (narrowBox) takes priority over a plain `.take`
# alias, so the source zeroing invalidates the box, not just the narrowed copy.
takeSourceResolve: function {ctx: Ctx.view name: StringView vid: ztypes.vid} out String is {
    return (emitLocalAtomName :ctx :name :vid)
}

# takeAliasBaseNid -- takeAliasBase as an interned name id, for a caller that
# compares the base rather than printing it.
takeAliasBaseNid: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: astnode.view
} out u64 is {
    match (
        n
    ) case expression then {
        return (takeAliasBaseNid :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (takeAliasBaseNid :ast :symtab n: (ast.nodes.get i: n.statementline.u64))
    } case dottedpath then {
        cn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if (ztypecheck.isMoveMarker name: cn.stringView) == false then return 0
        bnid: atomNodeId n: (ast.nodes.get i: n.parent.u64)
        bt: stampIdOf :symtab nid: bnid
        bo: originTidOf :symtab tid: bt
        if bo > 0 then return 0
        btt: symtab.reg.typetypeOf typeId: bt
        isUC: false
        if btt == ztypes.ztypetype.recordType then isUC = true
        if btt == ztypes.ztypetype.classType then isUC = true
        if btt == ztypes.ztypetype.unionType then isUC = true
        if isUC then return bnid
        return 0
    } else {
        return 0
    }
}

# takeAliasBase -- the base atom of a `<x>.take` over a user record/class (an
# ownership-transfer alias: the binding reuses the source storage), else "".
# takeAliasBase -- that base atom's text, derived from the node above so the
# name and the id can never describe different atoms.
takeAliasBase: function {
    # the tree the alias is read from
    ast: Ast.view
    # the symbol table the alias stamp lives in
    symtab: zenv.ZSymbolTable.view
    # the `.take` node
    n: astnode.view
} outx StringView is {
    tbn: takeAliasBaseNid :ast :symtab :n
    if tbn == 0 then return ""
    return (atomTextOf :ast n: (ast.nodes.get i: tbn))
}

# takeStringSource -- if `n` is a `<atom>.take` over a String value, the resolved
# C name of the source local to zero after the move (the callee now owns the
# heap buffer), else "". Used at the statement level to suppress a double free.
takeStringSource: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: astnode.view
} out String is {
    match (
        n
    ) case expression then {
        return (takeStringSource :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (takeStringSource :ast :symtab :ctx n: (ast.nodes.get i: n.statementline.u64))
    } case dottedpath then {
        cn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if (ztypecheck.isMoveMarker name: cn.stringView) == false then return "".string
        bnid: atomNodeId n: (ast.nodes.get i: n.parent.u64)
        bid: stampIdOf :symtab nid: bnid
        isMv: false
        if bid == ctx.strTid then isMv = true
        if (symtab.reg.typetypeOf typeId: bid) == ztypes.ztypetype.unionType then isMv = true
        if (symtab.reg.typetypeOf typeId: bid) == ztypes.ztypetype.classType then {
            if (isPtrVid :ctx vid: (atomVid :symtab nid: bnid)) == false then isMv = true
        }
        if isMv == false then return "".string
        bn9r: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
        return (takeSourceResolve :ctx name: bn9r.stringView vid: (atomVid :symtab nid: bnid))
    } else {
        return "".string
    }
}

# takeMoveCtype -- the C type of a `<atom>.take` source (for the `(T){0}`
# zeroing), via typeRefC on the base's stamp (canonicalizes String to strC).
takeMoveCtype: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
} out String is {
    match (
        n
    ) case expression then {
        return (takeMoveCtype :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (takeMoveCtype :ast :symtab :ctx n: (ast.nodes.get i: n.statementline.u64))
    } case dottedpath then {
        bnid: atomNodeId n: (ast.nodes.get i: n.parent.u64)
        bid: stampIdOf :symtab nid: bnid
        return (typeRefC :ast :symtab :ctx tid: bid thisTid: ztypes.tid)
    } else {
        return "".string
    }
}

# isFieldTake -- true iff `n` reduces to a `<obj>.field.take` whose parent is
# itself a dotted path (a field, not a bare atom). The field lvalue is zeroed
# after the move so the owner's destructor does not double-free the payload the
# take aliased out (a bare `<x>.take` is handled by takeStringSource).
isFieldTake: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case expression then {
        return (isFieldTake :ast n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (isFieldTake :ast n: (ast.nodes.get i: n.statementline.u64))
    } case dottedpath then {
        cn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if (ztypecheck.isMoveMarker name: cn.stringView) == false then return false
        return (isDottedAutoCall n: (ast.nodes.get i: n.parent.u64))
    } else {
        return false
    }
}

# emitNarrowedTakeZero -- before a return's scope cleanup, zero the payload box of
# every narrowed-subject `.take` reachable in the return value (a bare take, or a take
# passed as a construction/call arg). The un-shadowed narrowed subject is freed by the
# return cleanup; its `.take` moved the payload out as a shallow struct copy sharing the
# heap buffer, so the box must read {0} when the destructor walks it, else that buffer is
# double-freed. Non-narrowed takes are kept live by refsLocal and are not touched here.
emitNarrowedTakeZero: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    buf: String.borrow
} is {
    match (
        n
    ) case expression then {
        (emitNarrowedTakeZero
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.expression.u64)
            :ind
            :buf
        )
    } case statementline then {
        sln: ast.nodes.get i: n.statementline.u64
        emitNarrowedTakeZero :ast :symtab :ctx n: sln :ind :buf
    } case dottedpath then {
        cn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if (ztypecheck.isMoveMarker name: cn.stringView) then {
            bn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
            bn9v: atomVid :symtab nid: (atomNodeId n: (ast.nodes.get i: n.parent.u64))
            if (vvHas xs: ctx.narrowBox vid: bn9v) then {
                box: takeSourceResolve :ctx name: bn.stringView vid: bn9v
                tido: vtGet xs: ctx.narrowTid vid: bn9v
                match (
                    tido
                ) case some then {
                    cTypeText: (typeRefC
                        :ast
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: tido.u64)
                        thisTid: ztypes.tid
                    )
                    inv: "\{ind}\{box} = (\{cTypeText}){0};\n"
                    buf.append inv
                } case none then null
            }
        }
    } case call then {
        arx169: u64
        for arx169 < n.arguments.count.u64 loop {
            a9Id: zast.kidAt kids: ast.kids span: n.arguments i: arx169
            arx169 = arx169 + 1
            a: ast.nodes.get i: a9Id.u64
            if a.namedoperation then {
                (emitNarrowedTakeZero
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                    :ind
                    :buf
                )
            }
        }
    } else null
}

# implicitTakeSourceAtom -- the C move-source lvalue of a bare atom, decided by
# the typechecker's stamps ALONE (the emitter never re-resolves a name; a local
# may legitimately shadow a type). A local variable (atomVariableId) is a move
# source; a def/type/fn reference (refDecl) is not; an atom the checker
# stamped as neither (e.g. a generator-promoted local, now instance state) is a
# plain value and IS a move source.
implicitTakeSourceAtom: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    nid: u64
    nm: StringView
} out String is {
    avo: symtab.typing.atomVariableId.get key: nid
    match (
        avo
    ) case some then {
        return (takeSourceResolve :ctx name: nm vid: avo)
    } case none then null
    udo: symtab.typing.refDecl.get key: nid
    match (
        udo
    ) case some then {
        return "".string
    } case none then null
    return (takeSourceResolve :ctx name: nm vid: (ztypes.vid.create from: 0))
}

# moveMarkerBase -- the base node id of an explicit `<x>.take` / `<x>.hold`,
# through any `expression` wrapper; 0 when the node is not a move marker.
moveMarkerBase: function {ast: Ast.view n: astnode.view} out u64 is {
    match (
        n
    ) case expression then {
        return (moveMarkerBase :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        mbc: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if (ztypecheck.isMoveMarker name: mbc.stringView) == false then return 0
        return n.parent.u64
    } else {
        return 0
    }
}

# isBareNameValue -- the value is a BARE name (through any expression wrapper).
# The binding legs test this before asking implicitTakeSource for a move source:
# that answer costs a String, and only a bare name can move an owned local.
isBareNameValue: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case expression then {
        return (isBareNameValue :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return true
    } case labelvalue then {
        return true
    } else {
        return false
    }
}

# the source path an implicit `.take` moves from, if any.
implicitTakeSource: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: astnode.view
} out String is {
    match (
        n
    ) case expression then {
        return (implicitTakeSource :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        itA: ast.names.texts.get i: n.name.u64
        return (implicitTakeSourceAtom :symtab :ctx nid: n.nodeid.u64 nm: itA.stringView)
    } case labelvalue then {
        itL: ast.names.texts.get i: n.name.u64
        return (implicitTakeSourceAtom :symtab :ctx nid: n.nodeid.u64 nm: itL.stringView)
    } else {
        return "".string
    }
}

# implicitTakeFnId -- the param-bearing type for a call's implicit-take check: a
# direct FUNCTION callable, else the constructed type's `create` child, else the
# type itself (a field-wise construction reads field ownership from the type).
implicitTakeFnId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out u64 is {
    ct: (ztypes.tid.create from: (userFnIdById
        :ast
        :symtab
        :ctx
        nameId: (atomNameIdOf :ast n: (ast.nodes.get i: call.callable.u64))
    )
    )
    if ct.isZero then {
        # A dotted method call resolves the method through the receiver's type,
        # not a bare-name lookup: a free function sharing the method's name
        # (zast.mkNamedOp vs the Parser.mkNamedOp method) otherwise wins below,
        # and its mismatched param names leave a moved-in owned arg un-zeroed.
        mdch0Id: aliasChildNameId :ast :symtab n: (ast.nodes.get i: call.callable.u64)
        if mdch0Id.isZero == false then {
            callableNode: ast.nodes.get i: call.callable.u64
            mrcv0: dottedReceiverStampId :ast :symtab callable: callableNode
            if mrcv0 > 0 then {
                mmco0: (symtab.typing.declChildOfId
                    parentTypeId: mrcv0
                    nameId: mdch0Id
                )
                match (
                    mmco0
                ) case some then {
                    if (
                        (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: mmco0.u64)) ==
                        ztypes.ztypetype.functionType
                    ) then {
                        ct = ztypes.tid.create from: mmco0
                    }
                } case none then null
            }
        }
    }
    if ct.isZero then {
        # a cross-unit construction's callable is a dotted path (e.g.
        # `zast.unitrow`); atomTextOf is empty, so resolve the type by its
        # child name to reach its consuming `create` below (the same-unit path
        # resolves via the bare-atom userFnId above). Without this the moved-in
        # owned arg is never zeroed -> double free at the owner's destructor.
        dn0: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
        if dn0.length > 0 then {
            rt0: resolveTypeIdByName :ast :symtab :ctx name: dn0
            if rt0 > 0 then ct = ztypes.tid.create from: rt0.u64
        }
    }
    callableNode: ast.nodes.get i: call.callable.u64
    if ct.isZero then return (stampIdOf :symtab nid: (interpPartNodeId n: callableNode))
    if (symtab.reg.typetypeOf typeId: ct) == ztypes.ztypetype.functionType then return ct
    cco: symtab.typing.declChildOfId parentTypeId: ct nameId: zast.names.wkCreate
    match (
        cco
    ) case some then {
        if (
            (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: cco.u64)) ==
            ztypes.ztypetype.functionType
        ) then return cco
    } case none then null
    return ct
}

# paramIsHold -- the LABELLED parameter this argument binds is declared `hold`.
# A hold param is passed by pointer and the callee never destroys it, so the
# caller keeps the storage and an explicit `.take` must NOT zero the source.
# Positional args keep the unconditional behaviour: the index-to-parameter walk
# misreads generic monos, and no positional case is known to need this.
paramIsHold: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ftid: ztypes.tid
    label: StringView
} out bool is {
    if ftid.isZero then return false
    if label.length == 0 then return false
    return (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: ftid
        name: label
        own: ztypes.zparamownership.holdMode
    )
}

# isCtorOwnerCall -- the call CONSTRUCTS its result rather than handing back
# someone else's: a meta.create, an Option or Result construction, or a user
# union-arm construction.
isCtorOwnerCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out bool is {
    smidO: stampIdOf :symtab nid: call.nodeid.u64
    bnOId: dottedBaseAtomId :ast n: (ast.nodes.get i: call.callable.u64)
    mcOId: aliasChildNameId :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if (mnIs :ctx id: bnOId at: mnMeta) when mcOId == zast.names.wkCreate then return true
    if (originIsTid
        :symtab
        tid: smidO
        originTid: (ctx.origins.get i: ogOption)
    ) when (mnIs :ctx id: bnOId at: mnOption) then return true
    if (originIsTid
        :symtab
        tid: smidO
        originTid: (ctx.origins.get i: ogResult)
    ) when (mnIs :ctx id: bnOId at: mnResult) then return true
    # user-defined union arm construction `MyUnion.arm <payload>`: the base atom
    # is the union TYPE (the child is the arm selector, not a type), so the
    # child-name resolution below misses it. The arm MOVES its payload into the
    # heap box, so the source must be zeroed.
    if bnOId.isZero == false then {
        uctO: resolveTypeIdByNameId :ast :symtab :ctx nameId: bnOId
        if uctO > 0 then {
            if (
                (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: uctO.u64)) ==
                ztypes.ztypetype.unionType
            ) then {
                monoOrigin: originTidOf :symtab tid: (ztypes.tid.create from: uctO.u64)
                if monoOrigin.isZero then return true
            }
        }
    }
    ct: (ztypes.tid.create from: (userFnIdById
        :ast
        :symtab
        :ctx
        nameId: (atomNameIdOf :ast n: (ast.nodes.get i: call.callable.u64))
    )
    )
    if ct.isZero then {
        # cross-unit construction (dotted callable, e.g. `zast.unitrow`):
        # resolve the constructed type by its child name so an owned arg moved
        # into a record/variant/class/union field is zeroed (else double free).
        if mcOId.isZero == false then {
            rt0: resolveTypeIdByNameId :ast :symtab :ctx nameId: mcOId
            if rt0 > 0 then ct = ztypes.tid.create from: rt0.u64
        }
    }
    if ct.isZero then return false
    if (symtab.reg.typetypeOf typeId: ct) == ztypes.ztypetype.classType then return true
    if (symtab.reg.typetypeOf typeId: ct) == ztypes.ztypetype.unionType then return true
    if (symtab.reg.typetypeOf typeId: ct) == ztypes.ztypetype.recordType then return true
    if (symtab.reg.typetypeOf typeId: ct) == ztypes.ztypetype.variantType then return true
    return false
}

# emitCallTakeInvalidations -- zero the source local of each ownership-moved arg
# of a call so its scope-exit destructor is a no-op (the move transferred
# ownership). An explicit `<atom>.take` uses takeStringSource; a bare owning-
# reftype local moved into a TAKE param is an implicit move (the needsDestructor
# gate excludes borrow/lock views and scalars, which carry no destructor).
emitCallTakeInvalidations: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    ind: StringView
    buf: String.borrow
} is {
    takeFnTid: implicitTakeFnId :ast :symtab :ctx :call
    ctorOwner: isCtorOwnerCall :ast :symtab :ctx :call
    mmnId: aliasChildNameId :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    collMove: false
    if (mnIs :ctx id: mmnId at: mnAppend) then collMove = true
    if (mnIs :ctx id: mmnId at: mnInsert) then collMove = true
    if (mnIs :ctx id: mmnId at: mnPush) then collMove = true
    if collMove then {
        # The collection-move rule is for container elements; String.append
        # borrows its StringLike arg (byte copy), it never moves it.
        xr: ast.nodes.get i: call.callable.u64
        tid9: (dottedReceiverStampId :ast :symtab callable: xr)
        rcm: (chaseColMono
            :symtab
            :ctx
            tid: tid9
        )
        if rcm == ctx.strTid then collMove = false
    }
    posI: u64
    arx179: u64
    for arx179 < call.arguments.count.u64 loop {
        a9Id: zast.kidAt kids: ast.kids span: call.arguments i: arx179
        arx179 = arx179 + 1
        a: ast.nodes.get i: a9Id.u64
        if a.namedoperation then {
            ts: takeStringSource :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64)
            if ts.length > 0 then {
                holdSkip: false
                if ctorOwner == false then holdSkip = (paramIsHold
                    :ast
                    :symtab
                    ftid: (ztypes.tid.create from: takeFnTid.u64)
                    label: (zast.nameTextAt :ast ref: a.name).stringView
                )
                if holdSkip == false then {
                    tc: (takeMoveCtype
                        :ast
                        :symtab
                        :ctx
                        n: (ast.nodes.get i: a.operation.u64)
                    )
                    inv: "\{ind}\{ts} = (\{tc}){0};\n"
                    buf.append inv
                }
            } else {
                isTake: ctorOwner
                if collMove then isTake = true
                lbl: zast.nameTextAt :ast ref: a.name
                if lbl.length > 0 then {
                    if (symtab.typing.declOwnershipIs
                        pool: ast.names
                        parentTypeId: (ztypes.tid.create from: takeFnTid.u64)
                        name: lbl.stringView
                        own: ztypes.zparamownership.takeMode
                    ) then isTake = true
                    if (symtab.typing.declOwnershipIs
                        pool: ast.names
                        parentTypeId: (ztypes.tid.create from: takeFnTid.u64)
                        name: lbl.stringView
                        own: ztypes.zparamownership.borrowMode
                    ) then isTake = false
                    # a hold param is passed by pointer and the CALLEE never
                    # destroys it, so the caller keeps the storage: zeroing its
                    # source here would strand the allocation
                    if (symtab.typing.declOwnershipIs
                        pool: ast.names
                        parentTypeId: (ztypes.tid.create from: takeFnTid.u64)
                        name: lbl.stringView
                        own: ztypes.zparamownership.holdMode
                    ) then isTake = false
                } else {
                    pnames: List String
                    pids: ListVal u64
                    pids9Nm: ListVal u64
                    (recFieldLists
                        :ast
                        :symtab
                        tid: (ztypes.tid.create from: takeFnTid.u64)
                        names: pnames
                        ids: pids
                        nameIds: pids9Nm
                    )
                    off: u64
                    if pnames.length > 0 then {
                        firstPname: pnames.get i: 0
                        if firstPname.stringView == "this" then off = 1
                    }
                    pidx: posI + off
                    if pidx < pnames.length then {
                        pn: pnames.get i: pidx
                        if (symtab.typing.declOwnershipIs
                            pool: ast.names
                            parentTypeId: (ztypes.tid.create from: takeFnTid.u64)
                            name: pn.stringView
                            own: ztypes.zparamownership.takeMode
                        ) then isTake = true
                    }
                }
                if isTake then {
                    isrc: (implicitTakeSource
                        :ast
                        :symtab
                        :ctx
                        n: (ast.nodes.get i: a.operation.u64)
                    )
                    if isrc.length > 0 then {
                        istid: (stampIdOf
                            :symtab
                            nid: (interpPartNodeId n: (ast.nodes.get i: a.operation.u64))
                        )
                        if (isHeapPtrCollection :symtab :ctx tid: istid) then {
                            iinvh: "\{ind}\{isrc} = NULL;\n"
                            buf.append iinvh
                        } else {
                            if (symtab.reg.needsDestructor typeId: istid) then {
                                itc: typeRefC :ast :symtab :ctx tid: istid thisTid: ztypes.tid
                                iinv: "\{ind}\{isrc} = (\{itc}){0};\n"
                                buf.append iinv
                            }
                        }
                    }
                }
            }
            (emitValueTakeInvalidations
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: a.operation.u64)
                :ind
                :buf
            )
            posI = posI + 1
        }
    }
}

# emitValueTakeInvalidations -- statement-level source zeroing for a value node
# that reduces to a call (unwraps expression/statementline wrappers).
emitValueTakeInvalidations: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    buf: String.borrow
} is {
    match (
        n
    ) case expression then {
        expressionNode: ast.nodes.get i: n.expression.u64
        emitValueTakeInvalidations :ast :symtab :ctx n: expressionNode :ind :buf
    } case statementline then {
        statementlineNode: ast.nodes.get i: n.statementline.u64
        emitValueTakeInvalidations :ast :symtab :ctx n: statementlineNode :ind :buf
    } case call then {
        emitCallTakeInvalidations :ast :symtab :ctx call: n :ind :buf
    } else null
}

# needsAddM -- record a runtime demand as a (unit, member) pair. The fragment
# name is composed from the pair once, where the fragment is loaded; nothing
# else ever needs the two halves stuck together.
needsAddM: function {ctx: Ctx uname: StringView memb: StringView} is {
    if (needsHasM :ctx :uname :memb) then return
    ctx.needUnits.append from: uname.string
    ctx.needMembs.append from: memb.string
    if uname == "os" then osCrossUnitNeeds :ctx :memb
}

# osCrossUnitNeeds -- the io helpers an os native's body calls. os.env builds a C
# string out of a StringView and os.cwd maps errno to an IoError: that C is
# io's, so the demand is io's. Recorded HERE, where the os member is demanded,
# rather than recomputed at emission by reading os's demands back -- which is
# what let io's runtime gate on a predicate no row could state. Both names wear
# the `@` that marks a demand outside the member space: no declaration is
# called sv_cstr, and no fragment answers to the name alone.
osCrossUnitNeeds: function {ctx: Ctx memb: StringView} is {
    svc: false
    if memb == "env" then svc = true
    if memb == "setEnv" then svc = true
    if memb == "unsetEnv" then svc = true
    if memb == "setCwd" then svc = true
    if memb == "spawn" then svc = true
    if svc then needsAddM :ctx uname: "io" memb: "@sv_cstr"
    er: false
    if memb == "setEnv" then er = true
    if memb == "unsetEnv" then er = true
    if memb == "cwd" then er = true
    if memb == "setCwd" then er = true
    if memb == "userName" then er = true
    if memb == "homeDir" then er = true
    if memb == "hostname" then er = true
    if memb == "exePath" then er = true
    if er then needsAddM :ctx uname: "io" memb: "@errno"
}

# needsHasM -- true when the (unit, member) pair was demanded.
needsHasM: function {ctx: Ctx.view uname: StringView memb: StringView} out bool is {
    i: u64
    n: ctx.needUnits.length
    for i < n loop {
        u: ctx.needUnits.get :i
        if u.stringView == uname then {
            m: ctx.needMembs.get :i
            if m.stringView == memb then return true
        }
        i = i + 1
    }
    return false
}

# typeUseAdd -- record that the program constructed this type.
typeUseAdd: function {ctx: Ctx tid: ztypes.tid} is {
    ctx.usedTypeIds.add item: tid.u64
}

# typeStructEmitted -- this emitter wrote the type's struct, which is the
# reachability signal the conformance helpers need: they forward to the impl's
# methods, so emitting them for a type the program never reached names natives
# that were never loaded.
typeStructEmitted: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    return (ctx.emittedUserTypes.has item: tid)
}

# conformanceRowMark / conformanceRowEmitted -- a conformance row is one
# (impl, spec, label) triple and produces one set of wrappers, a vtable and the
# two create helpers. Emitted once, keyed by the row's index in the table.
conformanceRowMark: function {ctx: Ctx row: u64} is {
    ctx.emittedConformance.add item: row
}

# whether a conformance's row is already out, so a second demand does not
# repeat it
conformanceRowEmitted: function {ctx: Ctx.view row: u64} out bool is {
    return (ctx.emittedConformance.has item: row)
}

# typeIsUsed -- the program constructed this type, so the rows its
# construction reaches have fired.
typeIsUsed: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    return (ctx.usedTypeIds.has item: tid)
}

# typeDemandMet -- may this type's body be emitted? A type no fragment row
# gates is unconditional; one that IS gated waits until it is constructed,
# because its struct exists to be dereferenced by a fragment that is itself
# demand-loaded. The gating set comes from natives.tbl, not from a list here.
typeDemandMet: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    if (ctx.demandGatedTids.has item: tid) == false then return true
    return (typeIsUsed :ctx :tid)
}

# true when `name` is a string-like type.
isStringy: function {name: StringView} out bool is {
    if name == "String" then return true
    if name == "StringView" then return true
    return false
}

# isStringyTid -- the id form of isStringy: tid is canonical String or StringView.
isStringyTid: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    if tid == ctx.strTid then return true
    return tid == ctx.svTid
}

# svValueForm -- a String/StringView operand as a by-value StringView C
# expression (a String operand view-converts via a compound literal).
svValueForm: function {ctx: Ctx.view expr: StringView isStr: bool vid: ztypes.vid} out String is {
    if isStr then {
        # callers hand this a bare atom name, so resolve it: a borrowed element
        # get binds the name to a deref projection, and the raw name has no
        # declaration. The pointer question is asked of `vid`, not of that text
        # -- but only when no alias intervened, since an alias means the value
        # being read is the projection and not the binding.
        rex: aliasResolve :ctx name: expr :vid
        valueVid: vid
        if rex.stringView != expr then valueVid = ztypes.vid.create from: 0
        acc: ".".string
        if (isPtrVid :ctx vid: valueVid) then acc = "->".string
        v1: "((\{ctx.svC}_t){ .data = \{rex}\{acc}data, .size = \{rex}\{acc}size })"
        return v1
    } else {
        v2: expr.string
        return v2
    }
}

# dottedBaseAtom / dottedChildText -- the parent atom and member name of
# a dotted path ("" when the shape is deeper than one segment).
# dottedBaseAtomId -- the base atom's interned name id (0 when absent). The
# id form of dottedBaseAtom, for callers that only need to identify the name.
dottedBaseAtomId: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    match (
        n
    ) case dottedpath then {
        return (atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}

# the base atom of a dotted path, which is the sanctioned discriminator the
# shadow guard allows
dottedBaseAtom: function {ast: Ast.view n: astnode.view} outx StringView is {
    match (
        n
    ) case dottedpath then {
        return (atomTextOf :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return ""
    }
}

# atomOrBaseText -- the atom's own text, or a dotted path's base atom's text:
# the two shapes a receiver or a `.take` source is spelt in ("" otherwise).
atomOrBaseText: function {ast: Ast.view n: astnode.view} outx StringView is {
    t: atomTextOf :ast :n
    if t.length > 0 then return t
    return (dottedBaseAtom :ast :n)
}

# the child member name of dotted-path node `n`.
dottedChildText: function {ast: Ast.view n: astnode.view} outx StringView is {
    match (
        n
    ) case dottedpath then {
        return (atomTextOf :ast n: (ast.nodes.get i: n.child.u64))
    } else {
        return ""
    }
}

# aliasOrChild / aliasChildName -- the internal member name a dotted-path node
# resolved to through a public-interface alias (typecheck stamp keyed on the
# dotted-path nodeid), else the plain AST child text. Centralizes rename-aware
# member-name emission so a renamed member emits its internal (declared) C name.
aliasOrChild: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    aliasId: zast.nodeid
    childId: u32
} outx StringView is {
    if symtab.typing.renameSeen then {
        ai: symtab.typing.aliasInternalName.get key: aliasId.u64
        match (
            ai
        ) case some then {
            if ai.length > 0 then return ai.stringView
        } case none then null
    }
    return (atomTextOf :ast n: (ast.nodes.get i: childId.u64))
}

# the emitted (internal) name of a possibly-renamed member access.
aliasChildName: function {
    # the tree the member name is read from
    ast: Ast.view
    # the symbol table holding the rename stamps
    symtab: zenv.ZSymbolTable.view
    # the dotted-path node
    n: astnode.view
} outx StringView is {
    match (
        n
    ) case dottedpath then {
        return (aliasOrChild :ast :symtab aliasId: n.nodeid childId: n.child)
    } else {
        return ""
    }
}

# stmtFormNameId -- the statement form a DOTTED callee resolves to ("print",
# "panic", "error", "return"), else "". Those four are core aliases onto natives
# in `io` and `system`, and the dispatch below reads the ATOM, so a program that
# spelled one qualified reached the generic native path instead: `io.print`
# failed at emit for want of a fragment it does not have, and `system.panic`
# emitted the mono's own cname as a function. Asking the resolved declaration
# routes both spellings to one emitter, and is what keeps a user unit's own
# `print` out of it.
stmtFormNameId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: astnode.view
} out zast.nameid is {
    # the child's name as an ID: this runs for every dotted callee in statement
    # position, and four compares against the four forms need no text at all
    cid: dottedChildNameIdOf :ast :n
    zid: zast.nameid
    if cid.isZero then return zid
    isSf: false
    if (mnIs :ctx id: cid at: mnPrint) then isSf = true
    if (mnIs :ctx id: cid at: mnPanic) then isSf = true
    if (mnIs :ctx id: cid at: mnError) then isSf = true
    if cid == zast.names.wkReturn then isSf = true
    if isSf == false then return zid
    bid: dottedBaseAtomId :ast :n
    if bid.isZero then return zid
    if (
        (ztypecheck.isUnitNameDecl
            st: symtab
            nameId: bid
        ) ==
        false
    ) then return zid
    # ... and a DECLARATION of that name here shadows the unit: name ids are
    # pooled program-wide, so the unit probe answers either way
    uq2z: ctx.mainUnitId
    sh: (ztypecheck.resolveUnitChildRo
        :ast
        st: symtab
        unitDecl: uq2z
        nameId: bid
    )
    match (
        sh
    ) case some then {
        shT: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: sh)
        if shT != ztypes.ztypetype.unitType then return zid
    } case none then null
    ud0x: ztypecheck.unitDeclOfName st: symtab nameId: bid
    fo: (ztypecheck.resolvedByIdsRo
        :ast
        st: symtab
        unitDecl: ud0x
        name: (dottedChildNameIdOf :ast :n)
    )
    match (
        fo
    ) case some then {
        calleeTid: ztypes.tid.create from: fo
        tt: symtab.reg.typetypeOf typeId: calleeTid
        if tt != ztypes.ztypetype.functionType then return zid
        if (fnIsNativeId :symtab fid: calleeTid) == false then return zid
        return cid
    } case none then null
    return zid
}

# the child member name id of dotted-path node `n` (0 when not one).
dottedChildNameIdOf: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    match (
        n
    ) case dottedpath then {
        return (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}

# the middle segment's name id of a LEFT-nested `(a.B).c` path (0 otherwise).
dottedParentChildId: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    match (
        n
    ) case expression then {
        return (dottedParentChildId :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (dottedChildNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}

# aliasChildName's pool id: the internal (renamed) member id when a rename
# stamp exists, else the child atom's own name id.
aliasChildNameId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: astnode.view
} out zast.nameid is {
    match (
        n
    ) case dottedpath then {
        return (aliasOrChildId :ast :symtab aliasId: n.nodeid childId: n.child)
    } else {
        return (zast.nameid.create from: 0)
    }
}

# aliasOrChildId -- aliasOrChild's id twin: the same answer as a pool id, for
# the sites that only need to know WHICH member this is.
aliasOrChildId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    aliasId: zast.nodeid
    childId: u32
} out zast.nameid is {
    if symtab.typing.renameSeen then {
        ai: symtab.typing.aliasInternalNameOf nodeid: aliasId
        if ai.length > 0 then return (zast.poolFind pool: ast.names text: ai.stringView)
    }
    return (atomNameIdOf :ast n: (ast.nodes.get i: childId.u64))
}

# the base node id of dotted-path node `n`.
dottedBaseNodeId: function {ast: Ast.view n: astnode.view} out u64 is {
    match (
        n
    ) case dottedpath then {
        return (atomNodeId n: (ast.nodes.get i: n.parent.u64))
    } else {
        return 0
    }
}

# isSvNoArgNative -- no-arg StringView natives whose fragments must be
# registered by the scanNeeds pre-pass: type-method bodies emit after
# the runtime pass, so an in-body demand comes too late to matter.
isSvNoArgNative: function {name: StringView} out bool is {
    if name == "count" then return true
    if name == "hash" then return true
    if name == "codepoints" then return true
    if name == "lines" then return true
    return false
}

# isSvParseNative -- a StringView parse native (parseF64/I64/U64) returning a
# resultval. Dispatched via ctx.svC so the canonical StringView cname is used
# (not a shell id stamped on a nested `.stringView` projection).
isSvParseNative: function {name: StringView} out bool is {
    if name == "parseF64" then return true
    if name == "parseF16" then return true
    if name == "parseF128" then return true
    if name == "parseI64" then return true
    if name == "parseU64" then return true
    return false
}

# isSvSimpleNative -- the simple StringView natives: the pointer-arg predicates
# and the trims. indexOf and byteAt are not among them -- they return an
# optionval, which waits on that struct's emission.
isSvSimpleNative: function {name: StringView} out bool is {
    if name == "isEmpty" then return true
    if name == "isAscii" then return true
    if name == "startsWith" then return true
    if name == "endsWith" then return true
    if name == "contains" then return true
    if name == "trim" then return true
    if name == "trimStart" then return true
    if name == "trimEnd" then return true
    if name == "toLowerAscii" then return true
    if name == "toUpperAscii" then return true
    if name == "replace" then return true
    if name == "replaceFirst" then return true
    if name == "repeated" then return true
    if name == "concat" then return true
    return false
}

# isSvArgNative -- an arg-taking StringView native returning optionval/
# Option (indexOf/byteAt/lastIndexOf/stripPrefix/stripSuffix/splitOnce).
isSvArgNative: function {name: StringView} out bool is {
    if name == "indexOf" then return true
    if name == "lastIndexOf" then return true
    if name == "byteAt" then return true
    if name == "stripPrefix" then return true
    if name == "stripSuffix" then return true
    if name == "splitOnce" then return true
    return false
}

# svNativeCall -- `<svC>_<m>(&recv, args)` for an sv-native method. `&` needs an
# LVALUE, and a receiver that is itself a CALL is not one: `a.trim.concat other: b`
# emitted `&z_t_trim(...)` and gcc rejected it. Such a receiver goes inside a
# statement expression that binds it first -- the same `({ ... })` shape the
# union and interpolation legs already emit. A StringView owns nothing, so the
# block only binds and reads the temp; a compound literal is already an lvalue
# and is spelled directly.
svNativeCall: function {
    ctx: Ctx.view
    m: StringView
    recv: StringView
    args: StringView
} out String is {
    addressable: (isNonLvalueArg s: recv) == false
    if (recv.startsWith prefix: "((") then addressable = true
    if addressable then {
        direct: "\{ctx.svC}_\{m}(&\{recv}\{args})"
        return direct
    }
    wrapped: "({ \{ctx.svC}_t _svr = \{recv}; \{ctx.svC}_\{m}(&_svr\{args}); })"
    return wrapped
}

# svArgAddr -- the &-form of a StringView native argument (pooled
# literal or local view); "" when unsupported.
svArgAddr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
} out String is {
    match (
        n
    ) case expression then {
        return (svArgAddr :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case atomstring then {
        li: litIndexOf :ctx nid: n.nodeid.u64
        if li > 0 then {
            a1: "&_zs\{li}"
            return a1
        } else {
            return "".string
        }
    } case atomid then {
        anSA: ast.names.texts.get i: n.name.u64
        an: anSA.stringView
        # scalar args pass BY VALUE (only string-like args are pointer-
        # passed): a numeric literal has no address at all, and a stamped
        # scalar variable must not be &-wrapped either
        b0d: an.byteAt 0
        match (
            b0d
        ) case some then {
            if b0d >= 48 when b0d <= 57 then return "".string
        } case none then null
        snm: stampNameOf :symtab nid: n.nodeid.u64
        if (isIntName name: snm.stringView) then return "".string
        if (isFloatName name: snm.stringView) then return "".string
        # an ordinal pair is a C scalar, and passes like one
        if (isOrdinalVariant
            :symtab
            tid: (stampIdOf :symtab nid: n.nodeid.u64)
        ) then return "".string
        # A String arg to a StringLike param projects to a by-value view.
        anV: atomVid :symtab nid: n.nodeid.u64
        anE: emitLocalAtomName :ctx name: an vid: anV
        if (stampIsStr :symtab :ctx nid: n.nodeid.u64) then {
            svs: svValueForm :ctx expr: anE.stringView isStr: true vid: anV
            a2s: "&\{svs}"
            return a2s
        }
        a2: "&\{anE}"
        return a2
    } case labelvalue then {
        anlC: ast.names.texts.get i: n.name.u64
        anl: anlC.stringView
        snl: stampNameOf :symtab nid: n.nodeid.u64
        if (isIntName name: snl.stringView) then return "".string
        if (isFloatName name: snl.stringView) then return "".string
        # an ordinal pair is a C scalar, and passes like one
        if (isOrdinalVariant
            :symtab
            tid: (stampIdOf :symtab nid: n.nodeid.u64)
        ) then return "".string
        anlV: atomVid :symtab nid: n.nodeid.u64
        anlE: emitLocalAtomName :ctx name: anl vid: anlV
        if (stampIsStr :symtab :ctx nid: n.nodeid.u64) then {
            svl: svValueForm :ctx expr: anlE.stringView isStr: true vid: anlV
            a2ls: "&\{svl}"
            return a2ls
        }
        a2l: "&\{anlE}"
        return a2l
    } case dottedpath then {
        dpm: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if (ztypecheck.isStringViewMember name: dpm.stringView) then {
            pe: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
            pIsStr: (stampIsStr
                :symtab
                :ctx
                nid: (interpPartNodeId n: (ast.nodes.get i: n.parent.u64))
            )
            pev: (atomVidIfPlain
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: n.parent.u64)
                text: pe.stringView
            )
            sv: svValueForm :ctx expr: pe.stringView isStr: pIsStr vid: pev
            a3: "&\{sv}"
            return a3
        }
        return "".string
    } else {
        return "".string
    }
}

# emitSvCompareCall -- `a.compare b` on a stamped String/StringView base:
# the by-value cmp in the base fragment, both sides projected to a view.
emitSvCompareCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    bnv: StringView
    mnv: StringView
    btid: ztypes.tid
    btIsStr: bool
    dcbV: ztypes.vid
} out String is {
    if (isStringyTid
        :ctx
        tid: (ztypes.tid.create from: btid.u64)
    ) when mnv == "compare" then {
        # compare maps to the by-value cmp in the base fragment
        bf: svValueForm :ctx expr: bnv isStr: btIsStr vid: dcbV
        cargs: String
        arx189: u64
        for arx189 < call.arguments.count.u64 loop {
            caId: zast.kidAt kids: ast.kids span: call.arguments i: arx189
            arx189 = arx189 + 1
            ca: ast.nodes.get i: caId.u64
            if ca.namedoperation then {
                cae: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: ca.operation.u64)
                cat: stampNameDeep :ast :symtab n: (ast.nodes.get i: ca.operation.u64)
                caIsStr: cat.stringView == "String"
                cav: (atomVidIfPlain
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: ca.operation.u64)
                    text: cae.stringView
                )
                caf: svValueForm :ctx expr: cae.stringView isStr: caIsStr vid: cav
                if cargs.length == 0 then cargs.append caf
            }
        }
        ce: "\{ctx.svC}_cmp(\{bf}, \{cargs})"
        return ce
    }
    return "".string
}

# emitSvSubstringCall -- `s.substring from: F to: T`. Declines (and falls to the
# arg-native leg) unless BOTH labels are present.
emitSvSubstringCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    bnv: StringView
    mnv: StringView
    btid: ztypes.tid
    btIsStr: bool
    dcbV: ztypes.vid
} out String is {
    if mnv == "substring" then {
        fromA: ctorArgByLabel :ast :symtab :ctx :call label: "from"
        toA: ctorArgByLabel :ast :symtab :ctx :call label: "to"
        if fromA.length > 0 when toA.length > 0 then {
            recvp: String
            if btid == ctx.svTid then {
                recvp = bnv.string
            } else {
                if btIsStr then {
                    bfs: svValueForm :ctx expr: bnv isStr: true vid: dcbV
                    recvp = bfs.copy
                } else {
                    sacc: ".".string
                    if (isPtrVid :ctx vid: dcbV) then sacc = "->".string
                    recvp = "((\{ctx.svC}_t){ .data = \{bnv}\{sacc}data, .size = \{bnv}\{sacc}len })"
                }
            }
            if recvp.length > 0 then {
                needsAddM :ctx uname: "system" memb: "substring"
                sargs: ", \{fromA}, \{toA}"
                esb: (svNativeCall
                    :ctx
                    m: "substring"
                    recv: recvp.stringView
                    args: sargs.stringView
                )
                return esb
            }
        }
    }
    return "".string
}

# svNativeArgFrag -- one argument of a view native, as the C text that passes it.
# An atom whose address can be taken passes as that address; a String-stamped
# expression projects to a view value and passes by address; anything else
# passes as the expression. `split` addresses its separator even in that last
# case, and that is the only thing `addrAlways` selects.
svNativeArgFrag: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    addrAlways: bool
} out String is {
    sav: svArgAddr :ast :symtab :ctx :n
    if sav.length > 0 then return sav
    sx: emitExpr :ast :symtab :ctx :n
    stampTid: stampIdOf :symtab nid: (interpPartNodeId :n)
    if stampTid == ctx.strTid then {
        isBorrow9: (hoistExprIsBorrowRooted :ast :symtab :ctx :n)
        sxh: (hoistBorrowValArg
            :ast
            :symtab
            :ctx
            isBorrow: isBorrow9
            av: sx.stringView
            pid: ctx.strTid
            paramTake: false
        )
        if sxh.length > 0 then sx = sxh
        sxq: atomVidIfPlain :ast :symtab :ctx :n text: sx.stringView
        svx: svValueForm :ctx expr: sx.stringView isStr: true vid: sxq
        r: "&\{svx}"
        return r
    }
    if addrAlways then {
        ra: "&\{sx}"
        return ra
    }
    return sx
}


# emitSvSplitCall -- `s.split sep`, the separator passed by address.
emitSvSplitCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    bnv: StringView
    mnv: StringView
    btid: ztypes.tid
} out String is {
    if (isStringyTid
        :ctx
        tid: (ztypes.tid.create from: btid.u64)
    ) when mnv == "split" then {
        needsAddM :ctx uname: "sviter" memb: "sv_split"
        sepx: String
        arx199: u64
        for arx199 < call.arguments.count.u64 loop {
            sa9Id: zast.kidAt kids: ast.kids span: call.arguments i: arx199
            arx199 = arx199 + 1
            sa: ast.nodes.get i: sa9Id.u64
            if sa.namedoperation then {
                saOpNode: ast.nodes.get i: sa.operation.u64
                if sepx.length == 0 then {
                    sfrag: svNativeArgFrag :ast :symtab :ctx n: saOpNode addrAlways: true
                    sepx.append sfrag
                }
            }
        }
        es: "\{ctx.svC}_split(&\{bnv}, \{sepx})"
        return es
    }
    return "".string
}

# emitSvLinesCall -- `s.lines`, the no-argument view iterator.
emitSvLinesCall: function {
    ctx: Ctx
    bnv: StringView
    mnv: StringView
    btid: ztypes.tid
} out String is {
    if (isStringyTid
        :ctx
        tid: (ztypes.tid.create from: btid.u64)
    ) when mnv == "lines" then {
        needsAddM :ctx uname: "sviter" memb: "sv_lines"
        el: "\{ctx.svC}_lines(&\{bnv})"
        return el
    }
    return "".string
}

# emitSvParseCall -- `s.toU64` and friends: a no-argument parse native on a
# receiver projected to a view value.
emitSvParseCall: function {
    ctx: Ctx
    bnv: StringView
    mnv: StringView
    btid: ztypes.tid
    btIsStr: bool
    dcbV: ztypes.vid
} out String is {
    if (isStringyTid
        :ctx
        tid: (ztypes.tid.create from: btid.u64)
    ) when (isSvParseNative name: mnv) then {
        bfp: svValueForm :ctx expr: bnv isStr: btIsStr vid: dcbV
        needsAddM :ctx uname: "system" memb: mnv
        epn: "\{ctx.svC}_\{mnv}(&\{bfp})"
        return epn
    }
    return "".string
}

# emitSvArgNativeCall -- the one-argument view natives (`startsWith`, `indexOf`,
# ...), plus `byteAt`, whose argument is an index and not a view.
emitSvArgNativeCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    bnv: StringView
    mnv: StringView
    btid: ztypes.tid
} out String is {
    if (isStringyTid
        :ctx
        tid: (ztypes.tid.create from: btid.u64)
    ) when (isSvArgNative name: mnv) then {
        needsAddM :ctx uname: "system" memb: mnv
        argx: String
        arx209: u64
        for arx209 < call.arguments.count.u64 loop {
            a9Id: zast.kidAt kids: ast.kids span: call.arguments i: arx209
            arx209 = arx209 + 1
            a: ast.nodes.get i: a9Id.u64
            if a.namedoperation then {
                aOpNode: ast.nodes.get i: a.operation.u64
                if argx.length == 0 then {
                    afrag: svNativeArgFrag :ast :symtab :ctx n: aOpNode addrAlways: false
                    argx.append afrag
                }
            }
        }
        if mnv == "byteAt" then {
            barg: String
            arx219: u64
            for arx219 < call.arguments.count.u64 loop {
                baId: zast.kidAt kids: ast.kids span: call.arguments i: arx219
                arx219 = arx219 + 1
                ba: ast.nodes.get i: baId.u64
                if ba.namedoperation then {
                    if barg.length == 0 then {
                        bx: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: ba.operation.u64)
                        barg.append bx
                    }
                }
            }
            bargs: ", \{barg}"
            eb: (svNativeCall
                :ctx
                m: "byteAt"
                recv: bnv
                args: bargs.stringView
            )
            return eb
        }
        aargs: ", \{argx}"
        ea: (svNativeCall
            :ctx
            m: mnv
            recv: bnv
            args: aargs.stringView
        )
        return ea
    }
    return "".string
}

# emitSvSimpleCall -- the remaining view natives on a String or StringView
# receiver: every argument that is a String projects to a view address.
emitSvSimpleCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    bnv: StringView
    mnv: StringView
    btid: ztypes.tid
    btIsStr: bool
    dcbV: ztypes.vid
} out String is {
    svRecvOk: false
    if btid == ctx.svTid then svRecvOk = true
    if btIsStr then svRecvOk = true
    if svRecvOk then {
        if (isSvSimpleNative name: mnv) then {
            needsAddM :ctx uname: "system" memb: mnv
            # a String receiver projects to a view value, like the
            # substring/parse legs (a StringView receiver is one already)
            recvS: bnv.string
            if btIsStr then {
                bfs2: svValueForm :ctx expr: bnv isStr: true vid: dcbV
                recvS = bfs2.copy
            }
            args: String
            arx229: u64
            for arx229 < call.arguments.count.u64 loop {
                aId: zast.kidAt kids: ast.kids span: call.arguments i: arx229
                arx229 = arx229 + 1
                a: ast.nodes.get i: aId.u64
                if a.namedoperation then {
                    aOpNode: ast.nodes.get i: a.operation.u64
                    args.append ", "
                    cfrag: svNativeArgFrag :ast :symtab :ctx n: aOpNode addrAlways: false
                    args.append cfrag
                }
            }
            e1: (svNativeCall
                :ctx
                m: mnv
                recv: recvS.stringView
                args: args.stringView
            )
            return e1
        }
    }
    return "".string
}


# emitSvNativeInfix -- a NATIVE NAMED method reached INFIX. `s startsWith "he"`
# and `s.startsWith prefix: "he"` are the same one-argument method, so they must
# emit the same C. The call form has always routed through emitDottedCall's
# native legs; the infix form reached emitOperatorAt, which asks natives.tbl for
# an inline body -- and a fragment-backed native like startsWith has no inline
# body, only a real C function. The lookup missed and reported "no native
# implementation" for a member that is implemented perfectly well.
#
# Scope is the simple view natives, the ones that take a single argument and
# return a plain value: startsWith, endsWith, contains, concat, repeated. The
# optionval-returning set (indexOf, byteAt, ...) keeps its dedicated call-form
# leg. "" means "not mine", and the caller falls through to the table.
emitSvNativeInfix: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    owner: ztypes.tid
    lhsNid: u64
    rhsNid: u64
    l: StringView
    r: StringView
    op: StringView
} out String is {
    if (isStringyTid :ctx tid: owner) == false then return "".string
    if (isSvSimpleNative name: op) == false then return "".string
    needsAddM :ctx uname: "system" memb: op
    # a String receiver projects to a view value; a StringView already is one
    recvS: l.string
    if owner == ctx.strTid then {
        lv: atomVid :symtab nid: lhsNid
        bfs: svValueForm :ctx expr: l isStr: true vid: lv
        recvS = bfs.copy
    }
    # ASK THE CONSTANT FIRST. The binop leg emits its operands before it knows
    # what the operator resolved to, so a literal argument has ALREADY been
    # folded to a `_zcsN` static by the time this runs. Recomputing the argument
    # from the node would mint the pooled literal instead and leave that static
    # referenced by nothing -- a `defined but not used` warning, which
    # warn-check reads as a failure. The folded static is a StringView; its
    # address is exactly what the native wants.
    afrag: String
    {
        cg: symtab.typing.nodeConst.get key: rhsNid
        match (
            cg
        ) case some then {
            if cg.kind.svalKind then afrag = "&\{r}"
        } case none then null
    }
    if afrag.length == 0 then {
        afrag = (svNativeArgFrag
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: rhsNid)
            addrAlways: false
        )
    }
    aargs: ", \{afrag}"
    return (svNativeCall :ctx m: op recv: recvS.stringView args: aargs.stringView)
}

# emitScalarIterateCall -- the VALUE form of a numeric `iterate` / `each`.
#
# These are Rule 3 generator functions: `{:this from: type} out (optionval type)`,
# re-invoked once per iteration, and a for-header is free to lower them to a
# counted loop instead -- which emitIntRangeFor does, emitting no call at all.
# That left the value form with no emitter at all: `v: 5.iterate from: 2`
# type-checks, mints its optionval mono, and then reported `unhandled callee`
# for a member the compiler supplies. natives.tbl carries an EMPTY row for each
# of them precisely to say the compiler supplies it, so an absent leg here is
# the compiler not keeping its own word.
#
# One step of the range: the element at `from` when the range has not ended,
# `none` when it has. Both operands are bound first -- either may be a call.
emitScalarIterateCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    mnI: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if mnI.length == 0 then return "".string
    nmIdI: zast.poolFind pool: ast.names text: mnI
    isRangeI: false
    if nmIdI == zast.names.wkIterate then isRangeI = true
    if nmIdI == zast.names.wkEach then isRangeI = true
    if isRangeI == false then return "".string
    # the call's own stamp names the optionval mono the checker minted; a
    # container's `iterate` returns an ITERATOR and never reaches this test
    ovidI: stampIdOf :symtab nid: call.nodeid.u64
    if ovidI.isZero then return "".string
    if (
        (originIsTid
            :symtab
            tid: ovidI
            originTid: (ctx.origins.get i: ogOptionval)
        ) ==
        false
    ) then return "".string
    recvI: (emitDottedReceiver
        :ast
        :symtab
        :ctx
        callable: (ast.nodes.get i: call.callable.u64)
    )
    if recvI.length == 0 then return "".string
    # `from:` is the only argument, and it defaults to 0 exactly as the
    # for-header's rangeFromExpr defaults it
    fromI: "0".string
    arx239: u64
    for arx239 < call.arguments.count.u64 loop {
        aIdI: zast.kidAt kids: ast.kids span: call.arguments i: arx239
        arx239 = arx239 + 1
        aI: ast.nodes.get i: aIdI.u64
        if aI.namedoperation then {
            axI: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: aI.operation.u64)
            if axI.length > 0 then fromI = axI.copy
        }
    }
    ovcI: ctxCname :ctx tid: ovidI
    someI: variantTag :symtab tid: ovidI arm: "some"
    noneI: variantTag :symtab tid: ovidI arm: "none"
    payI: armPayloadC :ast :symtab :ctx tid: ovidI arm: "some"
    if payI.length == 0 then return "".string
    r0I: "({ \{payI} _rf = (\{fromI}); \{payI} _rl = (\{recvI}); "
    r1I: "(_rf < _rl) ? ((\{ovcI}_t){ .tag = \{someI}, .data.some = _rf }) "
    r2I: ": ((\{ovcI}_t){ .tag = \{noneI} }); })"
    outI: "\{r0I}\{r1I}\{r2I}"
    return outI
}

# emitDottedCall -- a method call on a stamped String/StringView base:
# the simple native set emits {svC}_{member}(&base, &args...).
emitDottedCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    bn0: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    btid: ztypes.tid
    dcbV: ztypes.vid
    # the receiver's C text: the expression's, or the base atom's local name
    bn: String
    if bn0.length == 0 then {
        # nested/projected base ((zast.poolTextAt pool: ast.names ref: el.text).stringView.stripPrefix): no base atom, but
        # the base is a stamped String/StringView -- emit it as an expression (a
        # compound-literal lvalue, so the `&base` SV-native legs stay valid C).
        rsid: (dottedReceiverStampId
            :ast
            :symtab
            callable: (ast.nodes.get i: call.callable.u64)
        )
        if (isStringyTid :ctx tid: (ztypes.tid.create from: rsid.u64)) then {
            callableNode: ast.nodes.get i: call.callable.u64
            bn = emitDottedReceiver :ast :symtab :ctx callable: callableNode
            btid = ztypes.tid.create from: rsid
        } else {
            return "".string
        }
    } else {
        bnid: dottedBaseNodeId :ast n: (ast.nodes.get i: call.callable.u64)
        btid = stampIdOf :symtab nid: bnid
        # the simple-atom receiver becomes its own identifier (the bn.length==0
        # leg already routes through emitDottedReceiver). An alias or narrowing
        # in scope substitutes for it, and then no variable is being read -- so
        # the pointer question below has nothing to ask about.
        baseVid: atomVid :symtab nid: bnid
        bnA: aliasResolve :ctx name: bn0 vid: baseVid
        if bnA.stringView == bn0 then dcbV = (atomVid :symtab nid: bnid)
        bn = emitLocalAtomName :ctx name: bn0 vid: baseVid
    }
    btIsStr: btid == ctx.strTid
    bnv: bn.stringView
    mnv: mn
    eCmp: emitSvCompareCall :ast :symtab :ctx :call :bnv :mnv :btid :btIsStr :dcbV
    if eCmp.length > 0 then return eCmp
    eSub: emitSvSubstringCall :ast :symtab :ctx :call :bnv :mnv :btid :btIsStr :dcbV
    if eSub.length > 0 then return eSub
    eSpl: emitSvSplitCall :ast :symtab :ctx :call :bnv :mnv :btid
    if eSpl.length > 0 then return eSpl
    eLin: emitSvLinesCall :ctx :bnv :mnv :btid
    if eLin.length > 0 then return eLin
    ePar: emitSvParseCall :ctx :bnv :mnv :btid :btIsStr :dcbV
    if ePar.length > 0 then return ePar
    eArg: emitSvArgNativeCall :ast :symtab :ctx :call :bnv :mnv :btid
    if eArg.length > 0 then return eArg
    return (emitSvSimpleCall :ast :symtab :ctx :call :bnv :mnv :btid :btIsStr :dcbV)
}

# emitDataIndexCall -- `primes.index i`: a data-block element read,
# emitted as z_{name}[arg].
emitDataIndexCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    dtid: (dataBlockTid
        :symtab
        nid: (dottedBaseNodeId :ast n: (ast.nodes.get i: call.callable.u64))
    )
    if dtid.isZero then return "".string
    isData: ctx.dataElems.has key: (ztypes.tid.create from: dtid.u64)
    if isData == false then return "".string
    if mn == "index" then {
        ax: "0".string
        arx249: u64
        for arx249 < call.arguments.count.u64 loop {
            aId: zast.kidAt kids: ast.kids span: call.arguments i: arx249
            arx249 = arx249 + 1
            a: ast.nodes.get i: aId.u64
            if a.namedoperation then {
                aOpNode: ast.nodes.get i: a.operation.u64
                ax = emitExpr :ast :symtab :ctx n: aOpNode
            }
        }
        dsym0: ctxCname :ctx tid: (ztypes.tid.create from: dtid.u64)
        e0: "\{dsym0}[\{ax}]"
        return e0
    }
    return "".string
}

# listCapArg -- the capacity: argument of a list construction value, or
# "0" when absent.
listCapArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
} out String is {
    match (
        n
    ) case expression then {
        return (listCapArg :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        arx259: u64
        for arx259 < n.arguments.count.u64 loop {
            aId: zast.kidAt kids: ast.kids span: n.arguments i: arx259
            arx259 = arx259 + 1
            a: ast.nodes.get i: aId.u64
            if a.namedoperation then {
                an: zast.nameTextAt :ast ref: a.name
                if an.stringView == "capacity" then return (emitExpr
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                )
            }
        }
        return "0".string
    } else {
        return "0".string
    }
}

# emitDottedReceiver -- the C expression for the receiver of a dotted method
# call (call.callable = recv.method). Uses emitExpr on the base node so a nested
# receiver (this.field.method, obj.a.b.method) works, not just a bare atom. ""
# when the callable is not a dotted path.
emitDottedReceiver: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    callable: astnode.view
} out String is {
    match (
        callable
    ) case dottedpath then {
        return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: callable.parent.u64))
    } else {
        return "".string
    }
}

# dottedReceiverStampId -- the stamped type id of a dotted method call's
# receiver (the base node, via interpPartNodeId which handles a nested dottedpath base).
# 0 when not a dotted path.
dottedReceiverStampId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    callable: astnode.view
} out ztypes.tid is {
    match (
        callable
    ) case dottedpath then {
        return (stampIdOf :symtab nid: (interpPartNodeId n: (ast.nodes.get i: callable.parent.u64)))
    } else {
        return (ztypes.tid.create from: 0)
    }
}

# dottedReceiverIsPtr -- true when a dotted method call's receiver is already a
# C pointer (a ptrVar like `this`, or a borrowed field), so the call passes it
# directly rather than taking its address.
dottedReceiverIsPtr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    callable: astnode.view
} out bool is {
    match (
        callable
    ) case dottedpath then {
        return (pathIsPointer :ast :symtab :ctx n: (ast.nodes.get i: callable.parent.u64))
    } else {
        return false
    }
}

# emitNativeArgMethod -- a native method that takes ARGUMENTS, emitted from its
# own natives.tbl row. The receiver-only rows reach `emitNumericCast`, which
# binds one hole and knows nothing of arguments; the operator rows reach
# `emitBinop`, which binds two and is spelled for a binop. A row that names an
# argument hole had no way in at all, and every bodied row on a scalar was a
# conversion, `bits` or `not` because of it.
#
# @V@ is the receiver and @A1@, @A2@, ... the arguments -- 1-BASED WITH THE
# RECEIVER EXCLUDED, the same numbering `const=` uses, so one convention
# answers for both. Arguments fill in DECLARED order, not written order:
# argSlotList maps the labels the way every other call form does.
#
# The row is the authority. Nothing here compares a member name, so a native
# gaining an argument is a declaration and a row, as it should be.
emitNativeArgMethod: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    ownerTid: ztypes.tid
} out String is {
    if call.arguments.count.u64 == 0 then return "".string
    # the member name decides whether to look at all, and it is read through a
    # BORROWED view: an owned copy here is one allocation per call in the
    # program, paid to discover that almost none of them are this
    isArgM: false
    {
        mnId: aliasChildNameId :ast :symtab n: (ast.nodes.get i: call.callable.u64)
        mnv: zast.nameTextAt :ast ref: mnId
        isArgM = nativeIsArgMembOf :ctx memb: mnv.stringView
    }
    if isArgM == false then return "".string
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if mn.length == 0 then return "".string
    srcP: convSrcPathOf :symtab srcTid: ownerTid
    key: nativeMemberKey srcPath: srcP.stringView memb: mn
    if key.length == 0 then return "".string
    body: nativeImplOf :ctx path: key.stringView
    if body.length == 0 then return "".string
    if (body.stringView.contains needle: "@A1@") == false then return "".string
    recv: emitDottedReceiver :ast :symtab :ctx callable: (ast.nodes.get i: call.callable.u64)
    if recv.length == 0 then return "".string
    if (dottedReceiverIsPtr
        :ast
        :symtab
        :ctx
        callable: (ast.nodes.get i: call.callable.u64)
    ) then {
        rd: "(*\{recv})"
        recv = rd.copy
    }
    mtid: ztypes.tid.create from: ((symtab.typing.declChildOf
        pool: ast.names
        parentTypeId: ownerTid
        name: mn
    ).or
        d: 0
    )
    if mtid.isZero then return "".string
    rn: List String
    rv: List String
    rn.append from: "V".string
    rv.append from: recv.copy
    if (nativeArgHoles :ast :symtab :ctx :call fid: mtid names: rn vals: rv) == false then {
        return "".string
    }
    bn: List String
    bv: List String
    return (fillHolesForCtx
        :ctx
        text: body
        path: key.stringView
        bindNames: bn
        bindVals: bv
        rawNames: rn
        rawVals: rv
    )
}

# nativeArgHoles -- append @A1@, @A2@, ... and their values to a hole list, in
# DECLARED order. The receiver is the first parameter, so a parameter's slot
# index IS its hole number: slot 0 is the receiver and fills @V@, slot 1 fills
# @A1@. False when a slot has no argument, which leaves the caller on its
# ordinary path rather than emitting a body with a hole still in it.
nativeArgHoles: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    fid: ztypes.tid
    names: List String
    vals: List String
} out bool is {
    pNames: List String
    pIds: ListVal u64
    pNameIds: ListVal u64
    (recFieldLists :ast :symtab tid: fid names: pNames ids: pIds nameIds: pNameIds)
    if pNames.length < 2 then return false
    slots: argSlotList :ast :call fpNameIds: pNameIds
    valBySlot: (IdMapR u64 V: String)
    ai: u64
    arx269: u64
    for arx269 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx269
        arx269 = arx269 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            slot: slots.get i: ai
            if slot < pNames.length then {
                av: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64)
                valBySlot.set key: slot value: av
            }
        }
        ai = ai + 1
    }
    missing: false
    hi: 1.u64
    for hi < pNames.length loop {
        g: valBySlot.get key: hi
        match (
            g
        ) case some then {
            hn: "A\{hi}"
            names.append hn
            vals.append g.copy
        } case none then {
            missing = true
        }
        hi = hi + 1
    }
    return missing == false
}

# emitStringArgMethod -- a String mutating method WITH an arg (appendByte /
# reserve): emit \{ctx.strC}_<native>(&recv, arg). The native cname is
# snake_case (append_byte). "" when the receiver is not a String or the method
# is not one of these. String is a value-native, so the cname is always ctx.strC.
emitStringArgMethod: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    nativeM: String
    if mn == "appendByte" then nativeM = "append_byte".string
    if mn == "reserve" then nativeM = "reserve".string
    if mn == "append" then nativeM = "append".string
    if nativeM.length == 0 then return "".string
    callableNode: ast.nodes.get i: call.callable.u64
    recvExpr: emitDottedReceiver :ast :symtab :ctx callable: callableNode
    if recvExpr.length == 0 then return "".string
    rtid0: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: call.callable.u64)
    rtid: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: rtid0.u64)
    rtid = chaseStrTypedef :symtab :ctx tid: (ztypes.tid.create from: rtid.u64)
    rtn: regNameOf :symtab tid: (ztypes.tid.create from: rtid.u64)
    if rtn.stringView != "String" then return "".string
    rptr: dottedReceiverIsPtr :ast :symtab :ctx callable: (ast.nodes.get i: call.callable.u64)
    recvAddr: "&\{recvExpr}"
    if rptr then recvAddr = "\{recvExpr}"
    argval: String
    argTid: u64
    argBor: false
    argPtr: false
    arx279: u64
    for arx279 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx279
        arx279 = arx279 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            if argval.length == 0 then {
                # an interpolated-literal arg builds a multi-statement String:
                # hoist it to an _ah temp (freed at the statement flush, the
                # receiver only borrows), exactly like collection/user-fn args
                iv: (emitColInterpArg
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                    consumes: false
                )
                if iv.length > 0 then {
                    argval = iv
                    argTid = ctx.strTid
                } else {
                    av: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64)
                    argval = av
                    argOpNode: ast.nodes.get i: a.operation.u64
                    argBor = hoistExprIsBorrowRooted :ast :symtab :ctx n: argOpNode
                    argTid = stampIdOf :symtab nid: (interpPartNodeId n: argOpNode)
                    argPtr = pathIsPointer :ast :symtab :ctx n: argOpNode
                }
            }
        }
    }
    if mn == "append" then {
        # The StringLike arg lowers to (data, length) by its concrete type:
        # an owned String reads .data/.size (through the pointer for a
        # borrowed param); a StringView reads .data/.length.
        if argTid == ctx.strTid then {
            aph: (hoistBorrowValArg
                :ast
                :symtab
                :ctx
                av: argval.stringView
                pid: ctx.strTid
                paramTake: false
                isBorrow: argBor
            )
            if aph.length > 0 then argval = aph
            aacc: "."
            if argPtr then aacc = "->"
            rapps: "\{ctx.strC}_append(\{recvAddr}, (\{argval})\{aacc}data, (\{argval})\{aacc}size)"
            return rapps
        }
        rapp: "\{ctx.strC}_append(\{recvAddr}, (\{argval}).data, (\{argval}).size)"
        return rapp
    }
    r: "\{ctx.strC}_\{nativeM}(\{recvAddr}, \{argval})"
    return r
}

# isNonLvalueArg -- true when an emitted arg expression is a non-addressable
# rvalue (a call/cast result, e.g. `String_from_view(...)`) so `&expr` is invalid
# C and the arg must be hoisted to a named temp first. A deref projection
# `(*__borrow_x)` IS an lvalue, so it is excluded.
#
# A NUMERIC LITERAL is not an lvalue either. A folded constant -- a data
# element or a unit constant -- reaches an emitter site as its bare value, and
# a receiver typed by a record method then asked for `&10`, which C rejects.
isNonLvalueArg: function {s: StringView} out bool is {
    b0: s.byteAt 0.u64
    match (
        b0
    ) case some then {
        if b0 >= 48 when b0 <= 57 then return true
        if b0 == 45 then {
            b1: s.byteAt 1.u64
            match (
                b1
            ) case some then {
                if b1 >= 48 when b1 <= 57 then return true
            } case none then null
        }
    } case none then null
    if (s.contains needle: "(") == false then return false
    if (s.startsWith prefix: "(*") then return false
    return true
}

# flushArgHoists -- emit the `String_t _ahN = <rvalue>;` declarations recorded by
# emitInstanceMethodCall for borrow-String args that needed `&` on a non-lvalue.
# Called at statement level (which holds ind/tmp/buf) right after the call
# expression is built; registers each temp for scope-exit free.
# `floor`/`rawFloor` mark pending hoists that belong to an ENCLOSING scope: a
# string interpolation used as a value emits into its own `({ ... })` buffer, and
# declaring a sibling argument's temp in there produces C that gcc rejects with
# `_ahN undeclared`. Everything below the floor stays pending for the outer flush.
flushArgHoists: function {
    ctx: Ctx
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    floor: 0.u64
    rawFloor: 0.u64
} is {
    i: floor
    n: ctx.argHoistNames.length
    for i < n loop {
        nmo: ctx.argHoistNames.get :i
        vlo: ctx.argHoistVals.get :i
        cty: ctx.argHoistTypes.get :i
        decl: "\{ind}\{cty} \{nmo} = \{vlo};\n"
        buf.append decl
        dto: ctx.argHoistDtors.get :i
        if dto.length > 0 then {
            tmp.oweList stmt: dto.copy name: nmo.copy vid: (ztypes.vid.create from: 0)
        }
        i = i + 1
    }
    ri: rawFloor
    rn: ctx.argHoistRaw.length
    for ri < rn loop {
        rdo: ctx.argHoistRaw.get i: ri
        buf.append rdo
        ri = ri + 1
    }
    # drop what was just emitted, back to the floor -- not to empty
    for ctx.argHoistNames.length > floor loop {
        ctx.argHoistNames.pop
        ctx.argHoistVals.pop
        ctx.argHoistTypes.pop
        ctx.argHoistDtors.pop
    }
    for ctx.argHoistRaw.length > rawFloor loop ctx.argHoistRaw.pop
}

# pushLoopLabel -- allocate a unique break-target label for a loop and push it.
# A zerolang `break` inside the loop emits `goto __zbrk_<id>`: a bare C `break`
# would only leave an enclosing match->switch, not the loop. The label is
# emitted after the loop by popLoopLabel, but only if a break referenced it.
pushLoopLabel: function {ctx: Ctx tmp: TmpCtr.view isDo: bool} out u64 is {
    id: ctx.breakLabelCtr
    ctx.breakLabelCtr = id + 1
    ctx.breakLabels.append id
    isDoC: isDo
    ctx.breakLabelIsDo.append isDoC
    ctx.breakFreesMarks.append tmp.frees.length
    ctx.breakListMarks.append tmp.listFrees.length
    cl: String
    ctx.breakLabelCleanup.append cl
    cv: String
    ctx.breakLabelCleanupVar.append cv
    cvr: ztypes.vid
    ctx.breakLabelCleanupRaw.append cvr
    return ctx.breakLabelCtr - 1
}

# emitContLabel -- the loop-body continue target: a `continue` inside a
# do{}while(0) wrapper jumps here (past the wrapper, before the loop's
# closing brace so the increment/condition re-evaluates). Emitted only
# when a continue referenced it.
emitContLabel: function {ctx: Ctx.view id: u64 ind: StringView buf: String.borrow} is {
    uo: ctx.contLabelUsed.get key: id
    match (
        uo
    ) case some then {
        lbl: "\{ind}__zcont_\{id}: ;\n"
        buf.append lbl
    } case none then null
}

# emit the C label that closes loop `id`.
popLoopLabel: function {ctx: Ctx id: u64 ind: StringView buf: String.borrow} is {
    if ctx.breakLabels.length > 0 then ctx.breakLabels.pop
    if ctx.breakLabelIsDo.length > 0 then ctx.breakLabelIsDo.pop
    if ctx.breakFreesMarks.length > 0 then {
        ctx.breakFreesMarks.pop
        ctx.breakListMarks.pop
    }
    if ctx.breakLabelCleanup.length > 0 then {
        ctx.breakLabelCleanup.pop
        ctx.breakLabelCleanupVar.pop
        ctx.breakLabelCleanupRaw.pop
    }
    uo: ctx.breakLabelUsed.get key: id
    match (
        uo
    ) case some then {
        lbl: "\{ind}__zbrk_\{id}: ;\n"
        buf.append lbl
    } case none then null
}

# methodOwnerId -- the type id that actually owns method `mn`. A cross-unit
# receiver may be stamped a same-named SHELL id whose childOf lacks the method;
# scan for the same-named type that has it (emitter twin of canonicalChildBase).
methodOwnerId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    rtid: ztypes.tid
    mn: StringView
} out u64 is {
    direct: symtab.typing.declChildOf pool: ast.names parentTypeId: rtid name: mn
    match (
        direct
    ) case some then {
        return rtid
    } case none then null
    rn: regNameOf :symtab tid: (ztypes.tid.create from: rtid.u64)
    if rn.length == 0 then return rtid
    last: symtab.reg.nextTypeId
    t: ztypes.tid
    for t < last loop {
        tn: regNameOf :symtab tid: (ztypes.tid.create from: t.u64)
        if tn.stringView == rn.stringView then {
            co: symtab.typing.declChildOf pool: ast.names parentTypeId: t name: mn
            match (
                co
            ) case some then {
                return t.u64
            } case none then null
        }
        t = ztypes.tid.create from: (t + 1)
    }
    return rtid
}

# hoistBorrowValArg -- a by-value call argument that is an owned, destructible,
# non-lvalue temporary (e.g. a `Map.get` Option result) handed to a borrow param
# (not paramTake) is freed by neither side. Hoist it into a temp registered
# for scope-exit destroy (mirrors the by-ref `&`-hoist) and return the temp name;
# "" when no hoist is needed. `av` is borrowed -- the caller keeps ownership.
hoistBorrowValArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    av: StringView
    pid: ztypes.tid
    paramTake: bool
    isBorrow: bool
} out String is {
    if (isNonLvalueArg s: av) == false then return "".string
    if paramTake then return "".string
    vrid: pid
    vduo: definedInUnitOf :symtab tid: (ztypes.tid.create from: pid.u64)
    match (
        vduo
    ) case none then {
        vtn: regNameOf :symtab tid: (ztypes.tid.create from: pid.u64)
        vrr: (canonTypeId
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: pid.u64)
            name: vtn.stringView
        )
        if vrr > 0 then vrid = ztypes.tid.create from: vrr.u64
    } case some then null
    isStrH: vrid == ctx.strTid
    if isStrH == false when (symtab.reg.needsDestructor typeId: vrid) == false then {
        return "".string
    }
    vhn: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    vnmh: "_ah\{vhn}"
    vcty: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: pid.u64) thisTid: ztypes.tid
    vcb: ctxCname :ctx tid: (ztypes.tid.create from: vrid.u64)
    vdt: "    \{vcb}_destroy(&\{vnmh});\n"
    if isStrH then vdt = "    \{ctx.strC}_free(&\{vnmh});\n"
    # a borrow-returning call result is a shared view: hoist for
    # lvalue-ness only, never destroy
    if isBorrow then vdt = "".string
    avc: av.string
    ctx.argHoistVals.append avc
    ctx.argHoistTypes.append vcty.copy
    ctx.argHoistDtors.append vdt
    ctx.argHoistNames.append vnmh.copy
    return vnmh
}

# lvalueForm -- `av` as something `&` may be taken of. A receiver that is
# itself a call is not an lvalue -- C rejects `&f(x)` -- so it is bound to a
# temp the statement flush declares; a compound literal already is one and
# pays for nothing.
lvalueForm: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    av: StringView
    tid: ztypes.tid
} out String is {
    if (av.startsWith prefix: "((") then return av.string
    if (isNonLvalueArg s: av) == false then return av.string
    t: hoistLvalue :ast :symtab :ctx :av :tid
    if t.length > 0 then return t
    return av.string
}

# hoistLvalue -- bind an expression to a temp so its ADDRESS can be taken. The
# sv-native legs pass `&receiver`, and a receiver that is itself a call is not an
# lvalue: C rejects `&f(x)`. This is hoistBorrowValArg's isBorrow leg generalised
# to a type that carries no destructor at all -- a StringView owns nothing, so
# the temp is bound and never freed. The caller decides addressability; a
# compound literal already is one and must not come here (it would cost a temp
# for nothing, and every program emitting one would move).
hoistLvalue: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    av: StringView
    tid: ztypes.tid
} out String is {
    vhn: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    vnm: "_ah\{vhn}"
    vcty: typeRefC :ast :symtab :ctx :tid thisTid: ztypes.tid
    ctx.argHoistVals.append av.string
    ctx.argHoistTypes.append vcty.copy
    ctx.argHoistDtors.append "".string
    ctx.argHoistNames.append vnm.copy
    return vnm
}

# stringViewBinopOperand -- the `&view` form of one string operand of `+`. A plain
# atom or a pooled literal addresses directly. An owned String that is not an
# lvalue -- the inner `+` of a chain -- must HOIST first: svValueForm reads its
# expression twice, once for `.data` and once for `.size`, and a concat spelled
# twice allocates twice and leaks both. A non-lvalue StringView is the shape the
# sv-native call path already cannot address (`a.trim.concat other: b` reports
# the same `lvalue required` today), so it is left to say so rather than given a
# second answer here.
stringViewBinopOperand: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    expr: StringView
    tname: StringView
} out String is {
    src: expr.string
    if (isNonLvalueArg s: expr) then {
        pid9: (stampIdDeep :ast :symtab :n)
        hv: (hoistBorrowValArg
            :ast
            :symtab
            :ctx
            av: expr
            pid: pid9
            paramTake: false
            isBorrow: false
        )
        if hv.length > 0 then src = hv.copy
    }
    valueVid: atomVidIfPlain :ast :symtab :ctx :n text: src.stringView
    vf: svValueForm :ctx expr: src.stringView isStr: (tname == "String") vid: valueVid
    r: "&\{vf}"
    return r
}

# instargval -- what resolving one argument's VALUE answers. The text itself is
# appended to the caller's buffer; these four ride back beside it, `posIdx`
# because a positional argument advances a cursor the next parameter reads.
instargval: record {
    # the argument is borrowed rather than taken
    avBor: bool
    # the argument used an interpolation, which had to be built before the call
    usedInterp: bool
    # the variable behind it, 0 when it is not a bare name
    avq: ztypes.vid
    # its position, for the natives that map labels onto a positional C
    # signature
    posIdx: u64
}

# instargptr -- how a declared parameter takes its argument: by pointer, as a
# borrowed String, moved in, and whether THIS argument needs an `&`.
instargptr: record {
    # the argument is passed by pointer
    ptra: bool
    # it is a borrowed String, which the callee must not free
    isStrBorrow: bool
    # the parameter takes ownership
    pTake: bool
    # the parameter is by-reference, so a non-lvalue has to be hoisted to have
    # an address
    byref: bool
}

# instanceMethodArgValue -- the argument text for one declared parameter: an
# interpolated literal hoisted to a temp, else the labelled argument, else the
# next positional one. Advances the positional cursor exactly when it consumes
# a positional slot.
instanceMethodArgValue: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    mco: ztypes.tid
    posParamName: StringView
    posParamId: u64
    posIdx0: u64
    av: String.borrow
} out instargval is {
    positionalIdx: posIdx0
    # the label and the parameter name are the same text, but a reftype argument
    # may appear only once in a call -- projecting `.stringView` at each site
    # would cost two temporaries.
    pnameL: posParamName
    isLbl9b: ctorHasLabel :ast :call label: posParamName
    iiVal: String
    if isLbl9b then {
        iiVal = (ctorInterpArgAt
            :ast
            :symtab
            :ctx
            aid: (ctorArgNodeByLabel :ast :call label: posParamName)
            fid: (ztypes.tid.create from: mco.u64)
            pname: pnameL
            pid: posParamId
        )
    } else {
        iiVal = (ctorInterpArgAt
            :ast
            :symtab
            :ctx
            aid: (ctorArgNodeByPosition :ast :call idx: positionalIdx)
            fid: (ztypes.tid.create from: mco.u64)
            pname: posParamName
            pid: posParamId
        )
    }
    atomVarId: String
    avBor: false
    usedInterp: false
    # the argument's value node, so the pointer check below asks
    # about the variable rather than the emitted text. An
    # interpolated argument is a statement expression, never a
    # variable, so it leaves this 0.
    avNd: u64
    if iiVal.length > 0 then {
        atomVarId = iiVal
        usedInterp = true
        if isLbl9b == false then positionalIdx = positionalIdx + 1
    } else {
        atomVarId = (ctorArgByLabel
            :ast
            :symtab
            :ctx
            :call
            label: posParamName
        )
        avBor = (ctorArgIsBorrow
            :ast
            :symtab
            :ctx
            :call
            label: posParamName
        )
        avNd = ctorArgNodeByLabel :ast :call label: posParamName
        if isLbl9b == false then {
            pv: ctorArgByPosition :ast :symtab :ctx :call idx: positionalIdx
            if pv.length > 0 then {
                atomVarId = pv
                avBor = (ctorArgIsBorrowPos
                    :ast
                    :symtab
                    :ctx
                    :call
                    idx: positionalIdx
                )
                avNd = ctorArgNodeByPosition :ast :call idx: positionalIdx
            }
            positionalIdx = positionalIdx + 1
        }
    }
    avq: ztypes.vid
    if avNd > 0 then {
        avq = (atomVidIfPlain
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: avNd)
            text: atomVarId.stringView
        )
    }
    av.append atomVarId
    return (instargval
        :avBor
        :usedInterp
        :avq
        posIdx: positionalIdx
    )
}

# instanceMethodArgPtr -- a non-TAKE class argument passes by pointer (mirroring
# the method signature), and so do a borrowed String and a list. An interpolated
# argument is a statement expression, never an lvalue, so it never does.
instanceMethodArgPtr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    mco: ztypes.tid
    posParamName: StringView
    posParamId: u64
    usedInterp: bool
    avq: ztypes.vid
    # the call, so the argument this parameter binds can be found by label when
    # -- and only when -- the answer is needed
    call: zast.callrow.view
} out instargptr is {
    ptra: false
    isStrBorrow: false
    # a non-TAKE class arg passes by pointer (mirrors the method
    # signature); isReftypeParam resolves a cross-unit class shell that
    # a bare typetypeOf==CLASS check misses.
    pTake: (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: (ztypes.tid.create from: mco.u64)
        name: posParamName
        own: ztypes.zparamownership.takeMode
    )
    isRef: false
    if pTake == false then {
        if (isReftypeParam
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: posParamId.u64)
        ) then isRef = true
    }
    if isRef then {
        ptra = true
    } else {
        if (isBorrowStringParam
            :ast
            :symtab
            :ctx
            fid: (ztypes.tid.create from: mco.u64)
            pname: posParamName
            pid: (ztypes.tid.create from: posParamId.u64)
        ) then {
            ptra = true
            isStrBorrow = true
        }
    }
    if ptra == false then {
        if (isListPtrParam
            :ast
            :symtab
            :ctx
            fid: (ztypes.tid.create from: mco.u64)
            pname: posParamName
            tid: (ztypes.tid.create from: posParamId.u64)
        ) then ptra = true
    }
    # a VALTYPE parameter marked `.view` or `.borrow` is a pointer too. The
    # signature emitter has always known this (markedValtypeRefParam, asked
    # through paramTypeIsPointer on the free-function path); this site did not
    # ask, so a method declaring one got a pointer parameter and was handed a
    # value
    if ptra == false when pTake == false then {
        if (markedValtypeRefParam
            :ast
            :symtab
            fid: (ztypes.tid.create from: mco.u64)
            pname: posParamName
            pid: posParamId
        ) then ptra = true
    }
    if usedInterp then ptra = false
    byref: false
    # an argument that already holds a pointer must not be addressed again. A
    # bare local answers through its vid; a PATH -- a non-owned reftype field,
    # a reference-returning call -- has no vid, and only the argument's own
    # expression answers for it. Asking one half hands the callee a `T**`.
    # The path walk runs only when the cheap test has already said no
    if ptra when (isPtrVid :ctx vid: avq) == false then {
        if (
            (argIsPointerByLabel
                :ast
                :symtab
                :ctx
                :call
                label: posParamName
            ) ==
            false
        ) then byref = true
    }
    return (instargptr
        :ptra
        :isStrBorrow
        :pTake
        :byref
    )
}

# instanceMethodArgHoist -- `&` of a non-lvalue (a call result) is invalid C, so
# the value goes to a typed temp `_ah<N>` and the temp is destroyed at block
# exit. Returns the `&_ah<N>` the call site passes.
instanceMethodArgHoist: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    posParamId: u64
    isStrBorrow: bool
    avBor: bool
    atomVarId: StringView
} out String is {
    hn: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    nmH: "_ah\{hn}"
    hcty: (typeRefC
        :ast
        :symtab
        :ctx
        tid: (ztypes.tid.create from: posParamId.u64)
        thisTid: ztypes.tid
    )
    htyc: hcty.copy
    hdt: String
    if isStrBorrow when avBor == false then {
        hdt = "    \{ctx.strC}_free(&\{nmH});\n"
    } else if avBor == false then {
        hrid: posParamId
        hduo: (definedInUnitOf
            :symtab
            tid: (ztypes.tid.create from: posParamId.u64)
        )
        match (
            hduo
        ) case none then {
            htn: (regNameOf
                :symtab
                tid: (ztypes.tid.create from: posParamId.u64)
            )
            hrr: (resolveTypeIdByName
                :ast
                :symtab
                :ctx
                name: htn.stringView
            )
            if hrr > 0 then hrid = hrr
        } case some then null
        if (symtab.reg.needsDestructor typeId: (ztypes.tid.create from: hrid.u64)) then {
            hcb: ctxCname :ctx tid: (ztypes.tid.create from: hrid.u64)
            hdt = "    \{hcb}_destroy(&\{nmH});\n"
        }
    }
    abh: "&\{nmH}"
    ctx.argHoistVals.append atomVarId.string
    ctx.argHoistTypes.append htyc
    ctx.argHoistDtors.append hdt
    ctx.argHoistNames.append nmH
    return abh
}

# instanceMethodArg -- one declared parameter of a user-object method, from its
# name to the C text that passes it. Answers the positional cursor for the next.
instanceMethodArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    mco: ztypes.tid
    posParamName: StringView
    posParamId: u64
    posIdx0: u64
    args: String.borrow
} out u64 is {
    atomVarId: String
    avr: (instanceMethodArgValue
        :ast
        :symtab
        :ctx
        :call
        :mco
        :posParamName
        :posParamId
        :posIdx0
        av: atomVarId
    )
    ptr: (instanceMethodArgPtr
        :ast
        :symtab
        :ctx
        :mco
        :posParamName
        :posParamId
        usedInterp: avr.usedInterp
        avq: avr.avq
        :call
    )
    if ptr.byref then {
        if (isNonLvalueArg s: atomVarId.stringView) then {
            abh: (instanceMethodArgHoist
                :ast
                :symtab
                :ctx
                :posParamId
                isStrBorrow: ptr.isStrBorrow
                avBor: avr.avBor
                atomVarId: atomVarId.stringView
            )
            args.append abh
        } else {
            ab: "&\{atomVarId}"
            args.append ab
        }
    } else {
        vbhm: String
        if ptr.ptra == false when avr.usedInterp == false then {
            vbhm = (hoistBorrowValArg
                :ast
                :symtab
                :ctx
                av: atomVarId.stringView
                pid: (ztypes.tid.create from: posParamId.u64)
                paramTake: ptr.pTake
                isBorrow: avr.avBor
            )
        }
        if vbhm.length > 0 then {
            args.append vbhm
        } else {
            args.append atomVarId
        }
    }
    return avr.posIdx
}

# emitInstanceMethodBody -- the call text for a resolved user-object method:
# the receiver in the slot its definition names, then one argument per declared
# parameter, each passed the way that parameter is declared to take it.
emitInstanceMethodBody: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    mco: ztypes.tid
    recvExpr: StringView
    # whether recvExpr is ALREADY a C pointer, so the receiver slot takes it as
    # it stands rather than through emitByrefArg. The two call forms read this
    # from different places -- a dotted base from the path it was reached by, a
    # receiver passed as an argument from the expression it was written as -- so
    # the caller answers it and this stays one emission for both
    recvIsPtr: bool
    # where the positional cursor starts for the NON-receiver parameters. A
    # dotted receiver consumes no argument and leaves it at 0; a receiver
    # supplied as the call's one unlabelled argument has already taken slot 0
    posStart: u64
} out String is {
    mcn: ctxCname :ctx tid: (ztypes.tid.create from: mco.u64)
    pids: ListVal u64
    pidsNm: ListVal u64
    recFieldIds :symtab tid: (ztypes.tid.create from: mco.u64) ids: pids nameIds: pidsNm
    # The receiver slot is identified by the method's receiver param name
    # (`this` for the `:this` shorthand, or the spelled name for a
    # `b: this.borrow` receiver) -- matching how the definition site names
    # it. Matching the literal "this" alone drops a renamed receiver.
    recvNm: "this".string
    {
        tpnm: (zast.poolTextAt
            pool: ast.names
            ref: (symtab.reg.thisParamNameIdOf tid: (ztypes.tid.create from: mco.u64))
        )
        if tpnm.length > 0 then recvNm = tpnm.copy
    }
    args: String
    positionalIdx: posStart
    pi: u64
    pn: pidsNm.length
    for pi < pn loop {
        posParamNameB: (zast.poolTextAt
            pool: ast.names
            ref: (zast.nameid.create from: (pidsNm.get i: pi))
        )
        posParamName: posParamNameB.stringView
        posParamId: pids.get i: pi
        if pi > 0 then args.append ", "
        if posParamName == recvNm.stringView then {
            if recvIsPtr then {
                args.append recvExpr
            } else {
                # same rule as the auto-call base: a receiver that IS a call
                # has no address, so emitByrefArg hoists it into a temp
                ra: (emitByrefArg
                    :ast
                    :symtab
                    :ctx
                    av: recvExpr
                    pid: (ztypes.tid.create from: posParamId.u64)
                    isBorrow: false
                )
                args.append ra
            }
        } else {
            positionalIdx = (instanceMethodArg
                :ast
                :symtab
                :ctx
                :call
                :mco
                :posParamName
                :posParamId
                posIdx0: positionalIdx
                :args
            )
        }
        pi = pi + 1
    }
    r: "\{mcn}(\{args})"
    return r
}


# isOperatorName -- a member whose name is punctuation rather than an
# identifier. Not opCnameOf: that table names twelve spellings and has never
# carried `| ^ << >>`, which the bitwise arc added.
isOperatorName: function {name: StringView} out bool is {
    b0: name.byteAt 0.u64
    match (
        b0
    ) case some then {
        if b0 >= 97 when b0 <= 122 then return false
        if b0 >= 65 when b0 <= 90 then return false
        if b0 == 95 then return false
        return true
    } case none then null
    return false
}

# emitOperatorCallForm -- `a.+ rhs: b` through the same emitter the infix form
# uses. "" when this is not a one-argument operator call, which leaves the
# caller on its ordinary legs. The operands are prepared exactly as the binop
# arm prepares them, an atom box dereferenced alike, because from here down the
# two forms are one.
emitOperatorCallForm: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    mnO: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if mnO.length == 0 then return "".string
    if (isOperatorName name: mnO) == false then return "".string
    if call.arguments.count.u64 != 1 then return "".string
    rt0: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: call.callable.u64)
    rtc: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: rt0.u64)
    owner: methodOwnerId :ast :symtab rtid: (ztypes.tid.create from: rtc.u64) mn: mnO
    if owner == 0 then return "".string
    method: ztypes.tid
    {
        mo9: (symtab.typing.declChildOf
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: owner.u64)
            name: mnO
        )
        match (
            mo9
        ) case some then {
            method = ztypes.tid.create from: mo9.u64
        } case none then null
    }
    if method.isZero then return "".string
    lhsNid: u64
    {
        cb: ast.nodes.get i: call.callable.u64
        if cb.dottedpath then lhsNid = cb.parent.u64
    }
    if lhsNid == 0 then return "".string
    rhsNid: u64
    {
        a0: ast.nodes.get i: (zast.kidAt kids: ast.kids span: call.arguments i: 0).u64
        if a0.namedoperation then rhsNid = a0.operation.u64
    }
    if rhsNid == 0 then return "".string
    l: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: lhsNid)
    r: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: rhsNid)
    if (nodeIsAtomBox :ast :symtab :ctx n: (ast.nodes.get i: lhsNid)) then l = "(*\{l})"
    if (nodeIsAtomBox :ast :symtab :ctx n: (ast.nodes.get i: rhsNid)) then r = "(*\{r})"
    oid9: zast.poolFind pool: ast.names text: mnO
    return (emitOperatorAt
        :ast
        :symtab
        :ctx
        lineno: call.lineno
        opId: oid9
        owner: (ztypes.tid.create from: owner.u64)
        :method
        :lhsNid
        :rhsNid
        :l
        :r
        op: mnO
    )
}

# emitSynthOperatorCallForm -- the call form of a SYNTHESISED operator.
#
# A synth `==`/`!=` is a real member with a real signature, which is what makes
# `a.== rhs: b` type-check at all -- but it has no BODY, and no C function is
# ever written for it. The structural comparison is emitted per TYPE
# (`<cname>_eq`) and reached through the natives.tbl `@record.==` / `@variant.==`
# rows, which only the operator emitter consults. Left to the ordinary by-decl
# leg, the call form emitted a call to a symbol nobody defines.
#
# A DECLARED operator is deliberately NOT routed here: it has a body, and the
# by-decl leg is what emits the call to it.
emitSynthOperatorCallForm: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    mnS: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if mnS.length == 0 then return "".string
    if (isOperatorName name: mnS) == false then return "".string
    if call.arguments.count.u64 != 1 then return "".string
    rt0S: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: call.callable.u64)
    rtcS: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: rt0S.u64)
    ownerS: (methodOwnerId
        :ast
        :symtab
        rtid: (ztypes.tid.create from: rtcS.u64)
        mn: mnS
    )
    if ownerS == 0 then return "".string
    nidS: zast.poolFind pool: ast.names text: mnS
    if nidS.isZero then return "".string
    if (
        (symtab.typing.declMemberIsSynth
            parentTypeId: (ztypes.tid.create from: ownerS.u64)
            nameId: nidS
        ) ==
        false
    ) then return "".string
    return (emitOperatorCallForm :ast :symtab :ctx :call)
}

# emitInstanceMethodCall -- `recv.method args` on a user CLASS instance (not a
# Type qualifier, not a collection / system native): emit
# {methodCname}(&recv, posArgs) with the receiver mapped to the :this param and
# the explicit args reordered by the method's param labels. "" when the receiver
# is not a user class or the method is unresolved.
emitInstanceMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if mn.length == 0 then return "".string
    callableNode: ast.nodes.get i: call.callable.u64
    recvExpr: emitDottedReceiver :ast :symtab :ctx callable: callableNode
    if recvExpr.length == 0 then return "".string
    # the other side of the same stamp: a receiver the checker said comes from
    # the arguments is not reached through the dot, whatever the base emits to
    if (symtab.typing.callRecvFromArgs.has item: call.nodeid.u64) then return "".string
    rtid0: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: call.callable.u64)
    rtidc: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: rtid0.u64)
    rtid: methodOwnerId :ast :symtab rtid: (ztypes.tid.create from: rtidc.u64) :mn
    if rtid == 0 then return "".string
    # Both families reach here: a user record's methods take their receiver by
    # pointer too, so they need the same receiver-addressing logic below. The
    # stdlib units are still excluded further down -- they have dedicated
    # dispatchers.
    rttK: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: rtid.u64)
    isUserObj: false
    if rttK == ztypes.ztypetype.classType then isUserObj = true
    if rttK == ztypes.ztypetype.recordType then isUserObj = true
    if rttK == ztypes.ztypetype.variantType then isUserObj = true
    if rttK == ztypes.ztypetype.unionType then isUserObj = true
    if rttK == ztypes.ztypetype.facetType then isUserObj = true
    if isUserObj == false then return "".string
    monoOrigin: originTidOf :symtab tid: (ztypes.tid.create from: rtid.u64)
    if monoOrigin > 0 then {
        if (
            (isUserGenericMonoTid
                :symtab
                :ctx
                tid: (ztypes.tid.create from: rtid.u64)
            ) ==
            false
        ) then return "".string
    }
    mco: (symtab.typing.declChildOf
        pool: ast.names
        parentTypeId: (ztypes.tid.create from: rtid.u64)
        name: mn
    )
    # a NATIVE member is the dedicated dispatchers' to emit -- the String and
    # StringView emitters, the collection ones, the io/cli/os fragment call --
    # and there is no body here to call anyway. Asking which unit declared the
    # RECEIVER relinquished every method of every type in those units, so a
    # user unit spelled `cli` or `os` had its own bodied methods handed to a
    # dispatcher that did not want them either, and the call fell through to
    # `unhandled callee`.
    match (
        mco
    ) case some then {
        if (fnIsNativeId
            :symtab
            fid: (ztypes.tid.create from: mco.u64)
        ) then return "".string
    } case none then null
    match (
        mco
    ) case some then {
        if (
            (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: mco.u64)) ==
            ztypes.ztypetype.functionType
        ) then {
            rIsPtr: dottedReceiverIsPtr :ast :symtab :ctx callable: callableNode
            return (emitInstanceMethodBody
                :ast
                :symtab
                :ctx
                :call
                mco: (ztypes.tid.create from: mco.u64)
                recvExpr: recvExpr.stringView
                recvIsPtr: rIsPtr
                posStart: 0
            )
        }
    } case none then null
    return "".string
}

# collectionValueCallRhs -- the binding RHS is a value-producing expression
# returning a collection (a call to a user function/method, or a bare dotted-path
# no-arg method auto-call / field access), as opposed to a collection construction
# (`(List of: T)` / `(Set ...)` / `(Map ...)` calls, or a bare typedef-collection
# atom like `Bytes` / `ByteView`). A value call must be emitted as the call;
# constructions emit the binding's mono create. Used by the List/Set/Map binding
# branches to choose between emitting the RHS expression and an empty create.
# A construction is recognised by its stamped callKind, not the written head
# name, so a re-export alias of a container constructs like its target.
collectionValueCallRhs: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case expression then {
        return (collectionValueCallRhs :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (collectionValueCallRhs :ast :symtab n: (ast.nodes.get i: n.statementline.u64))
    } case dottedpath then {
        # a bare dotted path returning a collection (e.g. `st.allNames`) is a
        # no-arg method auto-call or field access -- a value, never a construction.
        atc: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        return atc.length > 0
    } case atomid then {
        # a bare name resolving to a VARIABLE is that container's value -- a
        # move. A bare TYPE atom (`Bytes`, `ByteView`) is a construction, so the
        # variable stamp is what separates them.
        cav: symtab.typing.atomVariableId.get key: n.nodeid.u64
        match (
            cav
        ) case some then {
            return true
        } case none then null
        return false
    } case call then {
        cko: symtab.typing.callKind.get key: n.nodeid.u64
        match (
            cko
        ) case some then {
            if cko == zast.callkind.classCreate then return false
            if cko == zast.callkind.typedefCreate then return false
        } case none then null
        cn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.callable.u64))
        if cn.length == 0 then {
            # a dotted-path method callable (e.g. `p.operationPaths lex: lx`)
            # returning a List is a value-producing call, not a construction --
            # emit the call rather than falling to the empty-collection default.
            dct: dottedChildText :ast n: (ast.nodes.get i: n.callable.u64)
            return dct.length > 0
        }
        return true
    } else {
        return false
    }
}

# funcBorrowFlag -- does the function type `tid` return a BORROW? A zero tid and
# a miss both answer false: a type that was never stamped is lending nothing.
funcBorrowFlag: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    g: symtab.typing.funcReturnsBorrow.get key: tid
    match (
        g
    ) case some then {
        return g
    } case none then {
        return false
    }
}

# isColGetMutRef -- `fid` is a List/ListView mono's `getMut` whose element is a
# COMPOUND VALTYPE, i.e. the one case where emitColGet's generated `getMut`
# returns a pointer that `get` does not.
isColGetMutRef: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    fid: ztypes.tid
} out bool is {
    ownG: symtab.reg.ownerTidOf tid: fid
    if ownG.isZero then return false
    isLG: false
    if (isListOriginOf :symtab :ctx tid: ownG) then isLG = true
    if (isListViewOriginOf :symtab :ctx tid: ownG) then isLG = true
    if isLG == false then return false
    if (regNameIs :symtab tid: fid name: "getMut") == false then return false
    eG: listElemType :symtab monoId: ownG
    if (elemBorrowsByPtr :ast :symtab :ctx tid: (ztypes.tid.create from: eG.u64)) then return false
    return (elemRefByPtr :ast :symtab :ctx tid: (ztypes.tid.create from: eG.u64))
}

# fnReturnsRefBorrow -- the function hands back a REFERENCE to a user reftype:
# its declared return carries `.borrow`/`.view` and names a reftype. Such a
# return is a `T*` in C -- returning the struct by value hands the caller a COPY,
# so a write through it is silently lost.
#
# Natives are excluded deliberately. `String` is a reftype and `is native`
# (lib/system/system.z:590), and `out String.borrow` already works: the struct
# copy shares the buffer and the borrow legs suppress the free. Natives hand back
# interior pointers by their own rules -- `List.get`'s `_r.data = &...` -- so
# starring them would ripple through every caller for no correctness gain.
# `retTid` is the caller's already-resolved return type: the registry's
# returnTypeOf is 0 for a user method, so both signature emitters fall back to
fnReturnsRefBorrow: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    fid: ztypes.tid
    retTid: ztypes.tid
} out bool is {
    if fid.isZero then return false
    if retTid.isZero then return false
    if (funcBorrowFlag :symtab tid: fid) == false then return false
    # A container's `getMut` is native BY DECLARATION but its C is generated
    # HERE (emitColGet), not hand-written, so the exclusion below does not
    # reach it: for a compound valtype element it really does return a pointer
    # into the storage, and binding that by value is the write loss `getMut`
    # exists to prevent.
    if (isColGetMutRef :ast :symtab :ctx :fid) then return true
    # a NATIVE callee's ABI is fixed by its hand-written `.inc` fragment, which
    # returns its struct by value (`List.iterate` -> ListIter). This emitter only
    # rewrites the bodies it generates itself.
    if (symtab.reg.isNativeOf tid: fid) then return false
    # String/StringView and the collections are reftypes with hand-written C and
    # their own borrow legs; `isStringyTid` is asked rather than isNativeOf
    # because a String return arrives as a TYPEDEF id whose isNative is unset.
    if (isStringyTid :ctx tid: retTid) then return false
    if (isHeapPtrCollection :symtab :ctx tid: retTid) then return false
    if (isCollectionOriginTid :ctx originTid: (originTidOf :symtab tid: retTid)) then return false
    if (symtab.reg.isNativeOf tid: retTid) then return false
    # The question is the C ABI, NOT the ownership family: only a CLASS is
    # passed and returned by reference. A UNION is a reftype too, but it is a
    # `{tag, void* data}` fat pointer passed BY VALUE -- the copy already aliases
    # the source through `data`, so it needs no `*` and starring it produces C
    # that cannot be matched on. `isReftypeParam` is the emitter's existing
    # answer to exactly this and is what the param side already uses.
    return (isReftypeParam :ast :symtab :ctx tid: retTid)
}

# hoistExprIsBorrowRooted -- the hoisted expression's ROOT is a
# borrow-returning call (an element get and any field chain off it): the
# hoist is a shared view and must not register a free. Field chains off
# NAMED bases keep their existing legs untouched (a destructor-less box's
# field interp-free is load-bearing today).
hoistExprIsBorrowRooted: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case expression then {
        expressionNode: ast.nodes.get i: n.expression.u64
        return (hoistExprIsBorrowRooted :ast :symtab :ctx n: expressionNode)
    } case statementline then {
        sln: ast.nodes.get i: n.statementline.u64
        return (hoistExprIsBorrowRooted :ast :symtab :ctx n: sln)
    } case call then {
        return (callRhsIsBorrow :ast :symtab :ctx call: n)
    } case dottedpath then {
        return (hoistExprIsBorrowRooted :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
    } else {
        return false
    }
}

# callRhsIsBorrow -- the call-shaped leg of bindingRhsIsBorrow: the callee's
# declared return carries the `.borrow` marker (funcReturnsBorrow, recorded
# from the signature). Dotted method calls whose callable stamp missed probe
# the receiver mono's method child -- fully signature-driven (List/ListView
# element gets arrive here through their declared `out of.borrow`).
callRhsIsBorrow: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.callrow.view
} out bool is {
    cstid: stampIdOf :symtab nid: (interpPartNodeId n: (ast.nodes.get i: call.callable.u64))
    if (funcBorrowFlag :symtab tid: cstid) then return true
    cnmId: atomNameIdOf :ast n: (ast.nodes.get i: call.callable.u64)
    if cnmId.isZero == false then {
        ufid: userFnIdById :ast :symtab :ctx nameId: cnmId
        if (funcBorrowFlag :symtab tid: (ztypes.tid.create from: ufid)) then return true
    }
    chId: aliasChildNameId :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if chId.isZero then return false
    rid: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: call.callable.u64)
    rid = chaseColMono :symtab :ctx tid: (ztypes.tid.create from: rid.u64)
    mfid: ((symtab.typing.declChildOfId
        parentTypeId: rid
        nameId: chId
    ).or
        d: 0
    )
    return (funcBorrowFlag :symtab tid: (ztypes.tid.create from: mfid.u64))
}

# isSvAsStringNode -- the node is `sv.asString` on a StringView-typed base:
# the result is a `const String*` cast of the view's address, so a binding or
# hoist of it is a POINTER local (a 24-byte value copy would read `capacity`
# past the end of the view).
isSvAsStringNode: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case expression then {
        return (isSvAsStringNode :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        cn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if cn.stringView != "asString" then return false
        bnidA: interpPartNodeId n: (ast.nodes.get i: n.parent.u64)
        btA: chaseStrTypedef :symtab :ctx tid: (stampIdOf :symtab nid: bnidA)
        return btA == ctx.svTid
    } else {
        return false
    }
}

# svBaseExprOfAsString -- the rendered VIEW expression under `sv.asString`
# (the container probes pass the view itself, never a materialised String).
svBaseExprOfAsString: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
} out String is {
    match (
        n
    ) case expression then {
        return (svBaseExprOfAsString :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# colArgAsStringViewExpr -- when the labelled argument is `sv.asString`, the
# rendered view expression for the C `_getv`/`_hasv`/`_deletev` probe; "".
colArgAsStringViewExpr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    label: StringView
} out String is {
    arx289: u64
    for arx289 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx289
        arx289 = arx289 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringView == label then {
                opn: ast.nodes.get i: a.operation.u64
                if (isSvAsStringNode :ast :symtab :ctx n: opn) then {
                    return (svBaseExprOfAsString :ast :symtab :ctx n: opn)
                }
                return "".string
            }
        }
    }
    return "".string
}

# refBorrowCalleeFid -- the CALLEE behind a borrow-returning binding RHS, or 0.
# Deliberately narrower than bindingRhsIsBorrow, which also answers true for a
# plain field read: only a declared `.borrow`/`.view` RETURN makes the binding a
# reference, and a field read keeps its existing shallow-copy leg.
refBorrowCalleeFid: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: astnode.view
} out u64 is {
    match (
        n
    ) case expression then {
        return (refBorrowCalleeFid :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (refBorrowCalleeFid
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.statementline.u64)
        )
    } case call then {
        cid: stampIdOf :symtab nid: (interpPartNodeId n: (ast.nodes.get i: n.callable.u64))
        if (funcBorrowFlag :symtab tid: cid) then return cid
        ch8: aliasChildName :ast :symtab n: (ast.nodes.get i: n.callable.u64)
        if ch8.length == 0 then return 0
        rid8: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: n.callable.u64)
        rid8 = chaseColMono :symtab :ctx tid: (ztypes.tid.create from: rid8.u64)
        mf8: ((symtab.typing.declChildOf
            pool: ast.names
            parentTypeId: rid8
            name: ch8
        ).or
            d: 0
        )
        if (funcBorrowFlag :symtab tid: (ztypes.tid.create from: mf8.u64)) then return mf8
        return 0
    } case dottedpath then {
        # a zero-arg method auto-call reads as a dotted path
        ch7: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        pt7: stampIdOf :symtab nid: (interpPartNodeId n: (ast.nodes.get i: n.parent.u64))
        cc7: symtab.typing.declChildOf pool: ast.names parentTypeId: pt7 name: ch7.stringView
        match (
            cc7
        ) case some then {
            if (
                (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: cc7.u64)) ==
                ztypes.ztypetype.functionType
            ) then {
                if (funcBorrowFlag :symtab tid: (ztypes.tid.create from: cc7.u64)) then return cc7
            }
            return 0
        } case none then {
            return 0
        }
    } else {
        return 0
    }
}

# bindingRhsIsBorrow -- the binding RHS yields a non-owning borrow, so the bound
# String local must NOT be freed at scope exit (its owner -- the list or the
# struct -- frees it; a premature free is a use-after-free / double-free). Two
# shapes: a `<list>.get i:` over a List/ListView (a shallow element view), and a
# plain field access `<base>.<field>` (the field's String is owned by `<base>`).
# A no-arg method call (the child resolves to a FUNCTION) returns an owned value
# and is NOT a borrow. (Map.get returns an owned Option, handled elsewhere;
# `.copy` / `.string` / `.take` are owned and handled before this check.)
bindingRhsIsBorrow: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case expression then {
        return (bindingRhsIsBorrow :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        sln: ast.nodes.get i: n.statementline.u64
        return (bindingRhsIsBorrow :ast :symtab :ctx n: sln)
    } case call then {
        return (callRhsIsBorrow :ast :symtab :ctx call: n)
    } case dottedpath then {
        ch: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        bnmV: atomVid :symtab nid: (atomNodeId n: (ast.nodes.get i: n.parent.u64))
        if (vvHas xs: ctx.narrowBox vid: bnmV) then {
            # a field read off a narrowed subject is a shallow-copy borrow (it aliases
            # the subject's heap); an ownership builtin yields an owned value, and so
            # does a method auto-call (FUNCTION child) on the narrowed payload.
            if (ztypecheck.isMoveMarker name: ch.stringView) then return false
            if ch.stringView == "copy" then return false
            if ch.stringView == "string" then return false
            ntO2: vtGet xs: ctx.narrowTid vid: bnmV
            match (
                ntO2
            ) case some then {
                ncc: (symtab.typing.declChildOf
                    pool: ast.names
                    parentTypeId: ntO2
                    name: ch.stringView
                )
                match (
                    ncc
                ) case some then {
                    if (
                        (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: ncc.u64)) ==
                        ztypes.ztypetype.functionType
                    ) then return false
                } case none then null
            } case none then null
            return true
        }
        ptid: stampIdOf :symtab nid: (interpPartNodeId n: (ast.nodes.get i: n.parent.u64))
        cco: symtab.typing.declChildOf pool: ast.names parentTypeId: ptid name: ch.stringView
        match (
            cco
        ) case some then {
            # A zero-arg method auto-call reads as a dotted path, so this is the
            # only place its RETURN is consulted: a `.borrow` / `.view` return
            # aliases the receiver and must not be freed with the binding, the
            # same answer callRhsIsBorrow gives the parenthesised form.
            if (
                (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: cco.u64)) ==
                ztypes.ztypetype.functionType
            ) then {
                return (funcBorrowFlag :symtab tid: (ztypes.tid.create from: cco.u64))
            }
            return true
        } case none then {
            # `.borrow` on a value is the ownership marker, not a member --
            # no type declares one, which is exactly why the lookup missed. The binding ALIASES its source, so the source's owner
            # frees the buffer and the binding must not free it again. A
            # protocol or facet declaring a real `borrow` projection resolves
            # above and never reaches here.
            chId: atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64)
            if (mnIs :ctx id: chId at: mnBorrow) then return true
            return false
        }
    } else {
        return false
    }
}

# rhsIsBorrowGet -- the binding RHS is a List/ListView `get` lowered by pointer,
# so the local must ALIAS the element storage rather than snapshot it. Shares
# callRhsIsBorrow's receiver derivation, so the receiver text cannot diverge.
rhsIsBorrowGet: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
} out bool is {
    match (
        n
    ) case expression then {
        return (rhsIsBorrowGet :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (rhsIsBorrowGet :ast :symtab :ctx n: (ast.nodes.get i: n.statementline.u64))
    } case call then {
        cbl: ast.nodes.get i: n.callable.u64
        ch: aliasChildName :ast :symtab n: cbl
        isG: false
        if ch == "get" then isG = true
        if ch == "getMut" then isG = true
        if isG == false then return false
        bt: chaseColMono :symtab :ctx tid: (dottedReceiverStampId :ast :symtab callable: cbl)
        isC: false
        if (isListOriginOf :symtab :ctx tid: (ztypes.tid.create from: bt.u64)) then isC = true
        if (isListViewOriginOf :symtab :ctx tid: (ztypes.tid.create from: bt.u64)) then isC = true
        if isC == false then return false
        return (listGetIsPtr :ast :symtab :ctx monoId: (ztypes.tid.create from: bt.u64))
    } else {
        return false
    }
}

# emitStrConvCall -- the `.str` sized-conversion method on a String / StringView
# / str parent: `<parent>.str to: N` -> z_String_to_<name>(data, len). "" when
# not a .str-to-str conversion. The capacity rides the result mono type.
emitStrConvCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if mn != "str" then return "".string
    rid0: stampIdOf :symtab nid: call.nodeid.u64
    rid: chaseColMono :symtab :ctx tid: rid0
    if (
        (originIsTid
            :symtab
            tid: (ztypes.tid.create from: rid.u64)
            originTid: (ctx.origins.get i: ogStr)
        ) ==
        false
    ) then return "".string
    rnm: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: rid.u64)
    pv: emitDottedReceiver :ast :symtab :ctx callable: (ast.nodes.get i: call.callable.u64)
    ptid: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: call.callable.u64)
    lenAcc: "len".string
    if ptid == ctx.strTid then lenAcc = "size".string
    if ptid == ctx.svTid then lenAcc = "size".string
    return "\{ctx.strC}_to_\{rnm}(\{pv}.data, \{pv}.\{lenAcc})"
}

# allDigits -- true when s is non-empty and every byte is an ASCII digit 0-9.
# Distinguishes a numeric array index member (`a.0`) from a named member.
allDigits: function {s: StringView} out bool is {
    if s.length == 0 then return false
    i: u64
    n: s.length
    for i < n loop {
        bo: s.byteAt :i
        match (
            bo
        ) case some then {
            if bo < 48 then return false
            if bo > 57 then return false
        } case none then {
            return false
        }
        i = i + 1
    }
    return true
}

# emitBoxCreate -- `Box from: x`: heap-alloc a cell for the element and store x.
# Gated on the BOX_CREATE callKind stamp; hoists the alloc+store and returns the
# pointer temp.
emitBoxCreate: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    cko: symtab.typing.callKind.get key: call.nodeid.u64
    isBoxC: false
    match (
        cko
    ) case some then {
        if cko == zast.callkind.boxCreate then isBoxC = true
    } case none then null
    if isBoxC == false then return "".string
    bmid: stampIdOf :symtab nid: call.nodeid.u64
    bmn: regNameOf :symtab tid: bmid
    ben: monoElemName full: bmn prefixLen: 4
    beid: resolveTypeIdByName :ast :symtab :ctx name: ben.stringView
    binner: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: beid.u64) thisTid: ztypes.tid
    bval: ctorArgByLabel :ast :symtab :ctx :call label: "from"
    bN: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    bnm: "_Box\{bN}"
    braw: "    \{binner}* \{bnm} = (\{binner}*)z_xmalloc(sizeof(\{binner}));\n    *\{bnm} = \{bval};\n"
    ctx.argHoistRaw.append braw
    return bnm
}

# emitEmptyColCreate -- an empty collection construction `(List of: T)` /
# `(Set of: T)` / `(Map ...)` as a value: emit the collection mono's create with
# capacity 0, resolved from the call-node stamp. "" when not such a construction.
emitEmptyColCreate: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    cn0: StringView
} out String is {
    if cn0 == "array" then {
        amid0: stampIdOf :symtab nid: (interpPartNodeId n: (ast.nodes.get i: call.callable.u64))
        amid: chaseColMono :symtab :ctx tid: amid0
        if (originIsTid
            :symtab
            tid: (ztypes.tid.create from: amid.u64)
            originTid: (ctx.origins.get i: ogArray)
        ) then {
            acb: ctxCname :ctx tid: (ztypes.tid.create from: amid.u64)
            return "\{acb}_create()"
        }
    }
    if cn0 == "str" then {
        smid0: stampIdOf :symtab nid: (interpPartNodeId n: (ast.nodes.get i: call.callable.u64))
        smid: chaseColMono :symtab :ctx tid: smid0
        if (originIsTid
            :symtab
            tid: (ztypes.tid.create from: smid.u64)
            originTid: (ctx.origins.get i: ogStr)
        ) then {
            scb: ctxCname :ctx tid: (ztypes.tid.create from: smid.u64)
            return "\{scb}_create()"
        }
    }
    # the container leg is keyed on the stamped construction kind and the
    # mono's origin family, not the written head name, so a re-export alias
    # of a container constructs like its target.
    ckc: symtab.typing.callKind.get key: call.nodeid.u64
    isCr: false
    match (
        ckc
    ) case some then {
        if ckc == zast.callkind.classCreate then isCr = true
    } case none then null
    if isCr == false then return "".string
    mid: stampIdOf :symtab nid: call.nodeid.u64
    mid = ztypes.tid.create from: (chaseColMono :symtab :ctx tid: mid)
    monoOrigin: originTidOf :symtab tid: mid
    if monoOrigin.isZero then return "".string
    isCol: false
    if (isListOriginOf :symtab :ctx tid: mid) then isCol = true
    if (isSetOriginOf :symtab :ctx tid: mid) then isCol = true
    if (isMapOriginOf :symtab :ctx tid: mid) then isCol = true
    if (isIdCollectionOriginOf :symtab :ctx tid: mid) then isCol = true
    if isCol == false then return "".string
    cb: ctxCname :ctx tid: mid
    ccap: listCapArg :ast :symtab :ctx n: (ast.nodes.get i: call.nodeid.u64)
    return "\{cb}_create((uint64_t)\{ccap})"
}

# colRecvRef -- a collection (List) receiver as a C lvalue for a method call: a
# ptrVar List (a by-pointer param) is already a pointer and passes directly; a
# value List passes its address.
colRecvRef: function {ctx: Ctx.view bn: StringView vid: ztypes.vid} out String is {
    if (isPtrVid :ctx :vid) then return bn.string
    return "&\{bn}"
}

# emitCollectionMethodCall -- the collection method handlers behind ONE
# receiver computation: the receiver expression and its chased mono id are
# computed once, then the origin tid picks the array/List/Set/Map handler.
# "" when the receiver is not a collection mono (or the call is not dotted).
emitCollectionMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    bn: emitDottedReceiver :ast :symtab :ctx callable: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    bvid: (atomVidIfPlain
        :ast
        :symtab
        :ctx
        n: (ast.nodes.get i: call.callable.u64)
        text: bn.stringView
    )
    mnId: aliasChildNameId :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    brid: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: call.callable.u64)
    bt: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: brid.u64)
    # classify by the mono's ORIGIN NAME (the graph-independent identity):
    # a by-name-resolved origin tid can diverge from the mono's captured
    # genericOriginId when extra units register their own List/Map shells
    originName: monoOriginName :symtab tid: (ztypes.tid.create from: bt.u64)
    ov: originName.stringView
    if ov == "array" then return (emitArrayMethodCall :ast :symtab :ctx :call :mnId :bn :bt :bvid)
    isList: false
    if ov == "ListRef" then isList = true
    if ov == "ListVal" then isList = true
    if ov == "ListView" then isList = true
    if ov == "ListViewVal" then isList = true
    if isList then return (emitListMethodCall
        :ast
        :symtab
        :ctx
        :call
        :mnId
        :bn
        bt: (ztypes.tid.create from: bt.u64)
        :bvid
    )
    isSet: false
    if ov == "SetRef" then isSet = true
    if ov == "SetVal" then isSet = true
    if isSet then return (emitSetMethodCall :ast :symtab :ctx :call :mnId :bn :bt)
    isMap: false
    if ov == "MapRR" then isMap = true
    if ov == "MapRV" then isMap = true
    if ov == "MapVR" then isMap = true
    if ov == "MapVV" then isMap = true
    if isMap then return (emitMapMethodCall :ast :symtab :ctx :call :mnId :bn :bt)
    isIdMap: false
    if ov == "IdMapR" then isIdMap = true
    if ov == "IdMapV" then isIdMap = true
    if isIdMap then return (emitIdMapMethodCall :ast :symtab :ctx :call :mnId :bn :bt :bvid)
    if ov == "IdSet" then return (emitIdSetMethodCall :ast :symtab :ctx :call :mnId :bn :bt :bvid)
    return "".string
}

# emitListMethodCall -- a method call on a List-mono receiver. Maps the
# labeled arguments to the runtime method's positional C signature.
emitListMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    mnId: zast.nameid
    bn: String
    bt: ztypes.tid
    bvid: ztypes.vid
} out String is {
    cb: ctxCname :ctx tid: bt
    recvR: colRecvRef :ctx bn: bn.stringView vid: bvid
    if (mnIs :ctx id: mnId at: mnAppend) then {
        v: colArg :ast :symtab :ctx :call label: "from" consumes: true
        e0: "\{cb}_append(\{recvR}, \{v})"
        return e0
    }
    if mnId == zast.names.wkGet then {
        v: listArg :ast :symtab :ctx :call label: "i"
        e1: "\{cb}_get(\{recvR}, \{v})"
        if (listGetIsPtr
            :ast
            :symtab
            :ctx
            monoId: (ztypes.tid.create from: bt.u64)
        ) then return "(*\{e1})"
        return e1
    }
    if (mnIs :ctx id: mnId at: mnGetMut) then {
        vm: listArg :ast :symtab :ctx :call label: "i"
        e1m: "\{cb}_getMut(\{recvR}, \{vm})"
        if (listGetIsPtr
            :ast
            :symtab
            :ctx
            monoId: (ztypes.tid.create from: bt.u64)
        ) then return "(*\{e1m})"
        return e1m
    }
    if mnId == zast.names.wkSet then {
        vi: listArg :ast :symtab :ctx :call label: "i"
        vv: listArg :ast :symtab :ctx :call label: "val"
        e2: "\{cb}_set(\{recvR}, \{vi}, \{vv})"
        return e2
    }
    if (mnIs :ctx id: mnId at: mnPop) then {
        e3: "\{cb}_pop(\{recvR})"
        return e3
    }
    if (mnIs :ctx id: mnId at: mnInsert) then {
        vf: listArg :ast :symtab :ctx :call label: "from"
        va: listArg :ast :symtab :ctx :call label: "at"
        e4: "\{cb}_insert(\{recvR}, \{vf}, \{va})"
        return e4
    }
    if (mnIs :ctx id: mnId at: mnExtend) then {
        eaa: listTakeArgBase :ast :call label: "from"
        eaV: atomVid :symtab nid: (listTakeArgBaseNid :ast :call label: "from")
        ea: emitLocalAtomName :ctx name: eaa vid: eaV
        e5: "\{cb}_extend(\{recvR}, &\{ea})"
        return e5
    }
    if mnId == zast.names.wkContains then {
        vc: listArg :ast :symtab :ctx :call label: "item"
        e6: "\{cb}_contains(\{recvR}, \{vc})"
        return e6
    }
    if mnId == zast.names.wkSort then {
        e7: "\{cb}_sort(\{recvR})"
        return e7
    }
    return "".string
}

# emitArrayMethodCall -- `.get i:` / `.set i: item:` on a fixed-size array mono
# receiver (a value type). get takes the receiver by value; set by address (it
# returns the previous element). "" when the receiver isn't an array mono.
# The value label is `item`, not List's `val` -- the two handlers are otherwise
# identical here, and reading the wrong label silently stored a zero.
emitArrayMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    mnId: zast.nameid
    bn: String
    bt: ztypes.tid
    bvid: ztypes.vid
} out String is {
    cb: ctxCname :ctx tid: (ztypes.tid.create from: bt.u64)
    if mnId == zast.names.wkGet then {
        vi: listArg :ast :symtab :ctx :call label: "i"
        return "\{cb}_get(\{bn}, \{vi})"
    }
    if (mnIs :ctx id: mnId at: mnGetMut) then {
        viM: listArg :ast :symtab :ctx :call label: "i"
        return "\{cb}_getMut(\{bn}, \{viM})"
    }
    if mnId == zast.names.wkSet then {
        vi: listArg :ast :symtab :ctx :call label: "i"
        vv: listArg :ast :symtab :ctx :call label: "item"
        recvR: colRecvRef :ctx bn: bn.stringView vid: bvid
        return "\{cb}_set(\{recvR}, \{vi}, \{vv})"
    }
    return "".string
}

# mapKeyIsString / setElemIsString -- the mono's key/element is a String, i.e.
# its view-mode probe params are `const String*` in the template C.
mapKeyIsString: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    monoId: ztypes.tid
} out bool is {
    kt: mapKeyType :symtab :monoId
    return (keyHashKind :symtab :ctx tid: (ztypes.tid.create from: kt.u64)) == 1
}

# whether a set's element is a String, which decides the hash and the
# compare the mono gets
setElemIsString: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    monoId: ztypes.tid
} out bool is {
    et: setElemType :symtab :monoId
    return (keyHashKind :symtab :ctx tid: (ztypes.tid.create from: et.u64)) == 1
}

# stringKeyArgPointer -- a String-keyed mono's view-mode key/item argument as a C
# POINTER: `&lvalue` directly, else a hoisted temp (owned by the statement,
# freed at its flush -- a probe never retains its key).
stringKeyArgPointer: function {ctx: Ctx expr: StringView} out String is {
    if (isNonLvalueArg s: expr) then {
        hnK: ctx.argHoistCtr
        ctx.argHoistCtr = ctx.argHoistCtr + 1
        nmK: "_ah\{hnK}"
        hdtK: "    \{ctx.strC}_free(&\{nmK});\n"
        exc: expr.string
        ctx.argHoistVals.append exc
        htK: "\{ctx.strC}_t"
        ctx.argHoistTypes.append htK
        ctx.argHoistDtors.append hdtK
        retK: "&\{nmK}"
        ctx.argHoistNames.append nmK
        return retK
    }
    return "&\{expr}"
}

# ownedReceiverHoist -- a member read whose RECEIVER is a temporary that owns
# heap: `(mk n: 1).length` emits the call inline, reads `.size` off the result
# and drops the only reference to it. Hoist the receiver into a statement temp
# (declared by flushArgHoists, freed with the scope) and read the member off
# that instead. "" when the receiver is already an lvalue, owns nothing, or is
# a BORROW-returning call -- a shared view must never be freed here.
ownedReceiverHoist: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    expr: StringView
    n: astnode.view
} out String is {
    if (isNonLvalueArg s: expr) == false then return "".string
    rtid: stampIdOf :symtab nid: (interpPartNodeId :n)
    if rtid.isZero then return "".string
    if (symtab.reg.needsDestructor typeId: rtid) == false then return "".string
    if (bindingRhsIsBorrow :ast :symtab :ctx :n) then return "".string
    rct: typeRefC :ast :symtab :ctx tid: rtid thisTid: ztypes.tid
    if rct.length == 0 then return "".string
    rhn: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    rnm: "_ah\{rhn}"
    rdt: "    \{ctx.strC}_free(&\{rnm});\n"
    if (rtid == ctx.strTid) == false then {
        rcn: ctxCname :ctx tid: rtid
        rdt = "    \{rcn}_destroy(&\{rnm});\n"
    }
    rex: expr.string
    ctx.argHoistVals.append rex
    ctx.argHoistTypes.append rct
    ctx.argHoistDtors.append rdt
    rnc: rnm.copy
    ctx.argHoistNames.append rnc
    return rnm
}

# emitSetMethodCall -- an arg-taking method on a Set-mono receiver (a heap
# pointer, so the receiver passes directly without `&`). "" when not a Set
# call; the no-arg `.length`/`.iterate` reads ride the dottedpath leg.
emitSetMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    mnId: zast.nameid
    bn: String
    bt: ztypes.tid
} out String is {
    cb: ctxCname :ctx tid: (ztypes.tid.create from: bt.u64)
    if mnId == zast.names.wkAdd then {
        v: colArg :ast :symtab :ctx :call label: "item" consumes: true
        e0: "\{cb}_add(\{bn}, \{v})"
        return e0
    }
    if (mnIs :ctx id: mnId at: mnHas) then {
        viv: colArgAsStringViewExpr :ast :symtab :ctx :call label: "item"
        if viv.length > 0 then return "\{cb}_hasv(\{bn}, \{viv})"
        v: colArg :ast :symtab :ctx :call label: "item" consumes: false
        if (setElemIsString :symtab :ctx monoId: bt) then {
            return "\{cb}_has(\{bn}, \{stringKeyArgPointer :ctx expr: v.stringView})"
        }
        e1: "\{cb}_has(\{bn}, \{v})"
        return e1
    }
    if (mnIs :ctx id: mnId at: mnDelete) then {
        viv: colArgAsStringViewExpr :ast :symtab :ctx :call label: "item"
        if viv.length > 0 then return "\{cb}_deletev(\{bn}, \{viv})"
        v: colArg :ast :symtab :ctx :call label: "item" consumes: false
        if (setElemIsString :symtab :ctx monoId: bt) then {
            return "\{cb}_delete(\{bn}, \{stringKeyArgPointer :ctx expr: v.stringView})"
        }
        e2: "\{cb}_delete(\{bn}, \{v})"
        return e2
    }
    return "".string
}

# emitMapMethodCall -- an arg-taking method on a Map-mono receiver (a heap
# pointer). set/get/has/delete pass the pointer directly; "" otherwise. The
# no-arg `.length`/`.capacity` reads ride the dottedpath leg.
emitMapMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    mnId: zast.nameid
    bn: String
    bt: ztypes.tid
} out String is {
    cb: ctxCname :ctx tid: (ztypes.tid.create from: bt.u64)
    if mnId == zast.names.wkSet then {
        vk: colArg :ast :symtab :ctx :call label: "key" consumes: true
        vv: colArg :ast :symtab :ctx :call label: "value" consumes: true
        e0: "\{cb}_set(\{bn}, \{vk}, \{vv})"
        return e0
    }
    if mnId == zast.names.wkGet then {
        vkv: colArgAsStringViewExpr :ast :symtab :ctx :call label: "key"
        if vkv.length > 0 then return "\{cb}_getv(\{bn}, \{vkv})"
        vk: colArg :ast :symtab :ctx :call label: "key" consumes: false
        if (mapKeyIsString :symtab :ctx monoId: bt) then {
            return "\{cb}_get(\{bn}, \{stringKeyArgPointer :ctx expr: vk.stringView})"
        }
        e1: "\{cb}_get(\{bn}, \{vk})"
        return e1
    }
    if (mnIs :ctx id: mnId at: mnHas) then {
        vkv: colArgAsStringViewExpr :ast :symtab :ctx :call label: "key"
        if vkv.length > 0 then return "\{cb}_hasv(\{bn}, \{vkv})"
        vk: colArg :ast :symtab :ctx :call label: "key" consumes: false
        if (mapKeyIsString :symtab :ctx monoId: bt) then {
            return "\{cb}_has(\{bn}, \{stringKeyArgPointer :ctx expr: vk.stringView})"
        }
        e2: "\{cb}_has(\{bn}, \{vk})"
        return e2
    }
    if mnId == zast.names.wkRemove then {
        vk: colArg :ast :symtab :ctx :call label: "key" consumes: false
        if (mapKeyIsString :symtab :ctx monoId: bt) then {
            return "\{cb}_remove(\{bn}, \{stringKeyArgPointer :ctx expr: vk.stringView})"
        }
        e: "\{cb}_remove(\{bn}, \{vk})"
        return e
    }
    return "".string
}

# emitIdMapMethodCall -- an arg-taking method on an IdMap-mono receiver. The
# receiver is a STACK struct, as a List is, so it goes through colRecvRef and
# arrives by address; a Map's receiver is already a pointer and does not. The
# key is a scalar by construction of the `idkey` bound, so none of the Map
# family's String-key detours apply here.
emitIdMapMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    mnId: zast.nameid
    bn: String
    bt: ztypes.tid
    bvid: ztypes.vid
} out String is {
    cb: ctxCname :ctx tid: (ztypes.tid.create from: bt.u64)
    recvR: colRecvRef :ctx bn: bn.stringView vid: bvid
    if mnId == zast.names.wkSet then {
        vk: colArg :ast :symtab :ctx :call label: "key" consumes: false
        vv: colArg :ast :symtab :ctx :call label: "value" consumes: true
        e0: "\{cb}_set(\{recvR}, \{vk}, \{vv})"
        return e0
    }
    if mnId == zast.names.wkGet then {
        vk: colArg :ast :symtab :ctx :call label: "key" consumes: false
        e1: "\{cb}_get(\{recvR}, \{vk})"
        return e1
    }
    if (mnIs :ctx id: mnId at: mnGetMut) then {
        vkm: colArg :ast :symtab :ctx :call label: "key" consumes: false
        e1m: "\{cb}_getMut(\{recvR}, \{vkm})"
        return e1m
    }
    if (mnIs :ctx id: mnId at: mnHas) then {
        vk: colArg :ast :symtab :ctx :call label: "key" consumes: false
        e2: "\{cb}_has(\{recvR}, \{vk})"
        return e2
    }
    if (mnIs :ctx id: mnId at: mnKeyAt) then {
        vi: colArg :ast :symtab :ctx :call label: "i" consumes: false
        e3: "\{cb}_keyAt(\{recvR}, \{vi})"
        return e3
    }
    if (mnIs :ctx id: mnId at: mnValueAt) then {
        vi2: colArg :ast :symtab :ctx :call label: "i" consumes: false
        e4: "\{cb}_valueAt(\{recvR}, \{vi2})"
        return e4
    }
    return "".string
}

# emitIdSetMethodCall -- the IdSet half of the above.
emitIdSetMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    mnId: zast.nameid
    bn: String
    bt: ztypes.tid
    bvid: ztypes.vid
} out String is {
    cb: ctxCname :ctx tid: (ztypes.tid.create from: bt.u64)
    recvR: colRecvRef :ctx bn: bn.stringView vid: bvid
    if mnId == zast.names.wkAdd then {
        v: colArg :ast :symtab :ctx :call label: "item" consumes: false
        e0: "\{cb}_add(\{recvR}, \{v})"
        return e0
    }
    if (mnIs :ctx id: mnId at: mnHas) then {
        v: colArg :ast :symtab :ctx :call label: "item" consumes: false
        e1: "\{cb}_has(\{recvR}, \{v})"
        return e1
    }
    return "".string
}

# emitInterpArgExpr -- if n is (or wraps/projects via .string/.stringView) an
# interpolated string literal, return a self-contained statement expression that
# builds and yields the owned String; "" otherwise. Used for inline argument
# positions, where the pure emitExpr cannot emit the multi-statement interp build.
emitInterpArgExpr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
} out String is {
    match (
        n
    ) case expression then {
        return (emitInterpArgExpr :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            ltmp: (TmpCtr n: 0 frees: (List OwedFree) listFrees: (List OwedFree))
            lbuf: String
            # this interpolation emits into its OWN `({ ... })` scope, so hoists
            # already pending from the enclosing argument list must stay pending:
            # they are declared and used at the call, outside this block.
            hf: ctx.argHoistNames.length
            hr: ctx.argHoistRaw.length
            sM: (emitInterpBuild
                :ast
                :symtab
                :ctx
                parts: n.stringparts
                ind: " "
                tmp: ltmp
                buf: lbuf
                hoistFloor: hf
                hoistRawFloor: hr
            )
            r: "({ \{lbuf}_s\{sM}; })"
            return r
        }
        return "".string
    } case dottedpath then {
        cm: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if cm.stringView == "string" then {
            dpp: ast.nodes.get i: n.parent.u64
            return (emitInterpArgExpr :ast :symtab :ctx n: dpp)
        }
        if (ztypecheck.isStringViewMember name: cm.stringView) then return (emitInterpArgExpr
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.parent.u64)
        )
        return "".string
    } else {
        return "".string
    }
}

# emitInterpStmtValue -- like emitInterpArgExpr, but emits the interp build chain
# as PRIOR statements into buf (so a referenced local is read at THIS point) and
# returns the owned-String temp name "_sN"; "" otherwise. Used where the build
# must precede the statement -- a reassignment drop-old, so `s = "\{s}x"` reads
# old s before the old value is freed (as emitStringBindValue does).
# emitInterpBuild does NOT register _sN for free, so the
# assignment `nm2 = _sN` moves the storage into the lvalue with no double-free.
emitInterpStmtValue: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out String is {
    match (
        n
    ) case expression then {
        expressionNode: ast.nodes.get i: n.expression.u64
        return (emitInterpStmtValue :ast :symtab :ctx n: expressionNode :ind :tmp :buf)
    } case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            sB: emitInterpBuild :ast :symtab :ctx parts: n.stringparts :ind :tmp :buf
            return "_s\{sB}"
        }
        return "".string
    } case dottedpath then {
        cm: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if cm.stringView == "string" then {
            dpr: ast.nodes.get i: n.parent.u64
            return (emitInterpStmtValue :ast :symtab :ctx n: dpr :ind :tmp :buf)
        }
        if (ztypecheck.isStringViewMember name: cm.stringView) then {
            dpr: ast.nodes.get i: n.parent.u64
            return (emitInterpStmtValue :ast :symtab :ctx n: dpr :ind :tmp :buf)
        }
        return "".string
    } else {
        return "".string
    }
}

# emitColInterpArg -- an interpolated-string collection-method argument hoisted to
# an owned String temp via the argHoist mechanism (flushed at the statement). When
# the method BORROWS the arg (consumes == false: has/delete/get), a scope-exit
# free is registered; a consuming method (add/set) moves the temp in. "" when n is
# not an interpolated string.
emitColInterpArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    consumes: bool
} out String is {
    sx: emitInterpArgExpr :ast :symtab :ctx :n
    if sx.length == 0 then {
        if consumes then return "".string
        tn: stampNameDeep :ast :symtab :n
        if tn.stringView != "String" then return "".string
        ex: emitExpr :ast :symtab :ctx :n
        if (isNonLvalueArg s: ex.stringView) == false then return "".string
        sx = ex
    }
    hn: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    nmH: "_ah\{hn}"
    hdt: String
    if consumes == false when (hoistExprIsBorrowRooted :ast :symtab :ctx :n) == false then {
        hdt = "    \{ctx.strC}_free(&\{nmH});\n"
    }
    retx: nmH.copy
    ctx.argHoistVals.append sx
    ctx.argHoistTypes.append "\{ctx.strC}_t"
    ctx.argHoistDtors.append hdt
    ctx.argHoistNames.append nmH
    return retx
}

# emitInterpArgForParam -- an interpolated-string-literal argument built into a
# hoisted temp `_ah<N>` and coerced to the parameter's C form: a String.take
# param moves the temp in (no free); a String borrow takes it by pointer; a
# StringView param gets a by-value view. The temp is freed at block exit unless
# moved into a take param. Returns "" when the argument is not an interpolated
# literal (the caller emits it normally). Mirrors emitColInterpArg's hoist but
# generalises the returned form across param kinds.
emitInterpArgForParam: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    fid: ztypes.tid
    pname: StringView
    pid: u64
} out String is {
    sx: emitInterpArgExpr :ast :symtab :ctx :n
    if sx.length == 0 then return "".string
    isTake: false
    if pid == ctx.strTid when (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.takeMode
    ) then isTake = true
    hn: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    nmH: "_ah\{hn}"
    hdt: String
    if isTake == false then hdt = "    \{ctx.strC}_free(&\{nmH});\n"
    retx: String
    if pid == ctx.strTid then {
        if isTake then {
            retx = nmH.copy
        } else {
            retx = "&\{nmH}"
        }
    } else {
        retx = svValueForm :ctx expr: nmH.stringView isStr: true vid: (ztypes.vid.create from: 0)
    }
    ctx.argHoistVals.append sx
    ctx.argHoistTypes.append "\{ctx.strC}_t"
    ctx.argHoistDtors.append hdt
    ctx.argHoistNames.append nmH
    return retx
}

# colArg -- a collection-method argument: the interp-string hoist when the arg is
# an interpolated literal, else the plain expression (mirrors listArg). consumes
# distinguishes take params (add/set) from borrow params (has/delete/get).
colArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    label: StringView
    consumes: bool
} out String is {
    posFirst: String
    havePos: false
    arx299: u64
    for arx299 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx299
        arx299 = arx299 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringView == label then {
                ic: (emitColInterpArg
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                    :consumes
                )
                if ic.length > 0 then return ic
                return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64))
            }
            if an.length == 0 when havePos == false then {
                havePos = true
                icp: (emitColInterpArg
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                    :consumes
                )
                if icp.length > 0 then {
                    posFirst = icp
                } else {
                    aOpNode: ast.nodes.get i: a.operation.u64
                    posFirst = emitExpr :ast :symtab :ctx n: aOpNode
                }
            }
        }
    }
    if havePos then return posFirst
    return "0".string
}

# listArg -- the C expression for a labeled list-method argument ("0" if
# absent).
listArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    label: StringView
} out String is {
    posFirst: String
    havePos: false
    arx309: u64
    for arx309 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx309
        arx309 = arx309 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringView == label then return (emitExpr
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: a.operation.u64)
            )
            if an.length == 0 when havePos == false then {
                havePos = true
                aOpNode: ast.nodes.get i: a.operation.u64
                posFirst = emitExpr :ast :symtab :ctx n: aOpNode
            }
        }
    }
    # a single positional arg binds to the (sole) labelless call site, e.g.
    # `xs.get i2` -> the `i` param.
    if havePos then return posFirst
    return "0".string
}

# listTakeArgBaseNid -- listTakeArgBase as an interned name id, for a caller
# that compares the base rather than printing it.
listTakeArgBaseNid: function {
    ast: Ast.view
    call: zast.callrow.view
    label: StringView
} out u64 is {
    arx319: u64
    for arx319 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx319
        arx319 = arx319 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringView == label then return (takeArgBaseNid
                :ast
                n: (ast.nodes.get i: a.operation.u64)
            )
        }
    }
    return 0
}

# listTakeArgBase -- the base atom of a `x.take` list argument (the
# extend source); the bare atom text otherwise.
listTakeArgBase: function {
    ast: Ast.view
    call: zast.callrow.view
    label: StringView
} outx StringView is {
    lid: listTakeArgBaseNid :ast :call :label
    if lid == 0 then return "0"
    return (atomTextOf :ast n: (ast.nodes.get i: lid))
}

# the base path of a `.take` argument `n`.
takeArgBaseNid: function {ast: Ast.view n: astnode.view} out u64 is {
    match (
        n
    ) case expression then {
        return (takeArgBaseNid :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (atomNodeId n: (ast.nodes.get i: n.parent.u64))
    } case atomid then {
        return n.nodeid.u64
    } else {
        return 0
    }
}

# emitTypedefCreateCall -- `meters.create from: 42` / `meters 42`: a
# zero-overhead cast; emit the single argument expression.
emitTypedefCreateCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    # the call's stamped return IS the typedef (covers the unit-qualified
    # head, whose base atom is the unit name); the name walk stays as the
    # fallback for stamp-less shapes. Gated on the stamped callKind -- any
    # ORDINARY call may return a typedef and must not lose itself here.
    ckS: symtab.typing.callKind.get key: call.nodeid.u64
    isTdCk: false
    match (
        ckS
    ) case some then {
        if ckS == zast.callkind.typedefCreate then isTdCk = true
        if ckS == zast.callkind.typedefBorrow then isTdCk = true
    } case none then null
    tidS: stampIdOf :symtab nid: call.nodeid.u64
    if isTdCk when (isTypedefType :symtab tid: tidS) then {
        arx329: u64
        for arx329 < call.arguments.count.u64 loop {
            aIdS: zast.kidAt kids: ast.kids span: call.arguments i: arx329
            arx329 = arx329 + 1
            aS: ast.nodes.get i: aIdS.u64
            if aS.namedoperation then {
                return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: aS.operation.u64))
            }
        }
        return "0".string
    }
    calr: ast.nodes.get i: call.callable.u64
    bn: atomOrBaseText :ast n: calr
    if bn.length == 0 then return "".string
    tid: userFnId :ast :symtab :ctx name: bn
    if tid.isZero then {
        so: (ztypecheck.resolveUnitChildRo
            :ast
            st: symtab
            unitDecl: symtab.typing.systemUnitRoot
            nameId: (zast.poolFind pool: ast.names text: bn)
        )
        match (
            so
        ) case some then {
            tid = ztypes.tid.create from: so
        } case none then null
    }
    if tid.isZero then return "".string
    if (isTypedefType :symtab :tid) == false then return "".string
    arx339: u64
    for arx339 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx339
        arx339 = arx339 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64))
        }
    }
    return "0".string
}

# emitInlineVariantCtor -- a value (inline-payload) variant/optionval/resultval
# constructor as a compound literal: some-arm carries the first arg in .data.arm,
# none-arm just the tag. tid is the concrete VARIANT/mono type.
emitInlineVariantCtor: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    tid: ztypes.tid
    arm: StringView
} out String is {
    pc: armPayloadC :ast :symtab :ctx :tid :arm
    tg: variantTag :symtab :tid :arm
    vc: ctxCname :ctx :tid
    if pc.length > 0 then {
        av: "0".string
        got: false
        axi99: u64
        for axi99 < call.arguments.count.u64 loop {
            aId: zast.kidAt kids: ast.kids span: call.arguments i: axi99
            axi99 = axi99 + 1
            a: ast.nodes.get i: aId.u64
            if a.namedoperation then {
                if got == false then {
                    got = true
                    aOpNode: ast.nodes.get i: a.operation.u64
                    av = emitExpr :ast :symtab :ctx n: aOpNode
                }
            }
        }
        armCiP: memberCPrefix name: arm
        e0: "((\{vc}_t){ .tag = \{tg}, .data.\{armCiP}\{arm} = (\{av}) })"
        return e0
    } else {
        armValue: armValueC :symtab :tid :arm
        if armValue.length > 0 then return armValue
        e1: "((\{vc}_t){ .tag = \{tg} })"
        return e1
    }
}

# emitUnionCtor -- a main-unit user union arm construction (`U.arm payload`):
# a GCC statement-expression building the heap-payload union value (tag + a
# malloc'd box for the payload, or NULL data for a payload-less arm). Generic
# monos (Option/Result) keep their own emission paths.
emitUnionCtor: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if mn.length == 0 then return "".string
    smid0: stampIdOf :symtab nid: call.nodeid.u64
    smOrig: originTidOf :symtab tid: smid0
    # system union monos (optionval/resultval/Option/Result) are built by
    # emitVariantCtorCall; only USER generic union monos are built here.
    if smOrig > 0 then {
        sysU: false
        if (originIsTid
            :symtab
            tid: smid0
            originTid: (ctx.origins.get i: ogOptionval)
        ) then sysU = true
        if (originIsTid
            :symtab
            tid: smid0
            originTid: (ctx.origins.get i: ogResultval)
        ) then sysU = true
        if (originIsTid
            :symtab
            tid: smid0
            originTid: (ctx.origins.get i: ogOption)
        ) then sysU = true
        if (originIsTid
            :symtab
            tid: smid0
            originTid: (ctx.origins.get i: ogResult)
        ) then sysU = true
        if sysU then return "".string
    }
    utid: resolveTypeIdByName :ast :symtab :ctx name: bn
    if utid == 0 then return "".string
    if (
        (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: utid.u64)) !=
        ztypes.ztypetype.unionType
    ) then return "".string
    # build from the mono (smid0) for a user generic union; else the named template
    ctid: utid
    if smOrig > 0 when (symtab.reg.typetypeOf typeId: smid0) == ztypes.ztypetype.unionType then {
        ctid = smid0
    }
    vc: ctxCname :ctx tid: (ztypes.tid.create from: ctid.u64)
    tg: variantTag :symtab tid: (ztypes.tid.create from: ctid.u64) arm: mn
    payC: armPayloadC :ast :symtab :ctx tid: (ztypes.tid.create from: ctid.u64) arm: mn
    if payC.length > 0 then {
        av: String
        got: false
        arx349: u64
        for arx349 < call.arguments.count.u64 loop {
            aId: zast.kidAt kids: ast.kids span: call.arguments i: arx349
            arx349 = arx349 + 1
            a: ast.nodes.get i: aId.u64
            if a.namedoperation then {
                if got == false then {
                    got = true
                    # an interpolated payload builds via a self-contained
                    # statement expression (emitExpr cannot emit the chain)
                    aOpNode: ast.nodes.get i: a.operation.u64
                    av = emitInterpArgExpr :ast :symtab :ctx n: aOpNode
                    if av.length == 0 then {
                        aOpNode: ast.nodes.get i: a.operation.u64
                        av = emitExpr :ast :symtab :ctx n: aOpNode
                    }
                }
            }
        }
        e: "({ \{vc}_t _u = {0}; _u.tag = \{tg}; \{payC}* _b = (\{payC}*)z_xmalloc(sizeof(\{payC})); *_b = \{av}; _u.data = _b; _u; })"
        return e
    } else {
        e2: "({ \{vc}_t _u = {0}; _u.tag = \{tg}; _u.data = NULL; _u; })"
        return e2
    }
}

# emitVariantCtorCall -- `result.ok 42`: a dotted callee whose base is a
# variant type and whose member is a payload arm; emits a designated
# compound literal.
emitVariantCtorCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    # system monos (optionval/resultval inline, Option none) -- the call node is
    # stamped with the concrete mono id (userFnId fails for these). Option.some
    # is a heap box handled by emitOptionBoxHoist at the statement site.
    smid: stampIdOf :symtab nid: call.nodeid.u64
    sInline: false
    if (originIsTid
        :symtab
        tid: smid
        originTid: (ctx.origins.get i: ogOptionval)
    ) when bn == "optionval" then sInline = true
    if (originIsTid
        :symtab
        tid: smid
        originTid: (ctx.origins.get i: ogResultval)
    ) when bn == "resultval" then sInline = true
    if sInline then return (emitInlineVariantCtor
        :ast
        :symtab
        :ctx
        :call
        tid: smid
        arm: mn
    )
    if (originIsTid :symtab tid: smid originTid: (ctx.origins.get i: ogOption)) then {
        ovc: ctxCname :ctx tid: smid
        if mn == "none" then {
            otg: variantTag :symtab tid: smid arm: "none"
            en: "((\{ovc}_t){ .tag = \{otg}, .data = NULL })"
            return en
        }
        if mn == "some" then {
            otg9s: variantTag :symtab tid: smid arm: "some"
            opayC: armPayloadC :ast :symtab :ctx tid: smid arm: "some"
            if opayC.length == 0 then return "".string
            oav: "0".string
            ogot: false
            arx359: u64
            for arx359 < call.arguments.count.u64 loop {
                oa9Id: zast.kidAt kids: ast.kids span: call.arguments i: arx359
                arx359 = arx359 + 1
                oa: ast.nodes.get i: oa9Id.u64
                if oa.namedoperation then {
                    if ogot == false then {
                        ogot = true
                        # an interpolated payload builds via a self-contained
                        # statement expression (emitExpr cannot emit the chain)
                        oaOpNode: ast.nodes.get i: oa.operation.u64
                        oav = emitInterpArgExpr :ast :symtab :ctx n: oaOpNode
                        if oav.length == 0 then {
                            oaOpNode: ast.nodes.get i: oa.operation.u64
                            oav = emitExpr :ast :symtab :ctx n: oaOpNode
                        }
                    }
                }
            }
            es: "({ \{ovc}_t _u = {0}; _u.tag = \{otg9s}; \{opayC}* _b = (\{opayC}*)z_xmalloc(sizeof(\{opayC})); *_b = \{oav}; _u.data = _b; _u; })"
            return es
        }
        return "".string
    }
    vtid: userFnId :ast :symtab :ctx name: bn
    if vtid.isZero then return "".string
    if (symtab.reg.typetypeOf typeId: vtid) != ztypes.ztypetype.variantType then return "".string
    # a generic variant's arm is WRITTEN against the template (`Slot.full`), so
    # the name resolves to the template and its cname and tags name a struct no
    # instance has. The mono the binding holds is on the call node's stamp; an
    # id compare against the template is what says the stamp is its instance.
    if (genericOriginTid :symtab tid: smid) == vtid then vtid = smid
    return (emitInlineVariantCtor :ast :symtab :ctx :call tid: vtid arm: mn)
}

# emitTypeQualCall -- `point.add a: x b: y`: a dotted callee whose base
# resolves to a record type and whose member is a FUNCTION child; args
# reorder to the method's param order by label.
emitTypeQualCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    btid: userFnId :ast :symtab :ctx name: bn
    if btid.isZero then return "".string
    bttq: symtab.reg.typetypeOf typeId: btid
    # a receiver's family decides how it is CARRIED, never how the call is
    # written, so every family that can declare a method is claimed here. A
    # variant or union left out reached emitInstanceMethodCall instead, which
    # takes its receiver from the dotted base -- and that base is the type name,
    # so the emitted C named a variable that does not exist.
    isUserObjQ: false
    if bttq == ztypes.ztypetype.recordType then isUserObjQ = true
    if bttq == ztypes.ztypetype.classType then isUserObjQ = true
    if bttq == ztypes.ztypetype.variantType then isUserObjQ = true
    if bttq == ztypes.ztypetype.unionType then isUserObjQ = true
    if bttq == ztypes.ztypetype.facetType then isUserObjQ = true
    if isUserObjQ == false then return "".string
    mco: symtab.typing.declChildOf pool: ast.names parentTypeId: btid name: mn
    match (
        mco
    ) case some then {
        if (
            (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: mco.u64)) ==
            ztypes.ztypetype.functionType
        ) then {
            pnames: List String
            pids: ListVal u64
            pidsNm: ListVal u64
            (recFieldLists
                :ast
                :symtab
                tid: (ztypes.tid.create from: mco.u64)
                names: pnames
                ids: pids
                nameIds: pidsNm
            )
            # a synthesized `create` (no body) has field-shaped params but no
            # emitted create fn -- route it to the type's field-wise ctor, the
            # path bare-name construction uses; a user create (a body) is called.
            mcBody: false
            {
                mcrn: symtab.typing.funcReturnNode.get key: mco
                match (
                    mcrn
                ) case some then {
                    mcBody = true
                } case none then null
            }
            if mn == "create" when mcBody == false then {
                return (emitRecordCtor :ast :symtab :ctx :call tid: btid)
            }
            pn: pnames.length
            if mn == "create" then {
                # user create: args by the create's own param labels
                args: String
                pi: u64
                for pi < pn loop {
                    pname: pnames.get i: pi
                    # the create's parameters decide how each argument is
                    # passed, as they do for any other call of it: a non-`take`
                    # user class is a `T*`, so a bare local has to be addressed.
                    aNid: ctorArgNodeByLabel :ast :call label: pname.stringView
                    av: "0".string
                    if aNid > 0 then {
                        av = (userFnArgText
                            :ast
                            :symtab
                            :ctx
                            fid: (ztypes.tid.create from: mco.u64)
                            pinId: (pids.get i: pi)
                            pinNm: pname.stringView
                            argOpNode: (ast.nodes.get i: aNid)
                        )
                    }
                    if pi > 0 then args.append ", "
                    args.append av
                    pi = pi + 1
                }
                mc3: ctxCname :ctx tid: (ztypes.tid.create from: mco.u64)
                e7: "\{mc3}(\{args})"
                return e7
            }
            # THE RECEIVER IS AMONG THE ARGUMENTS HERE, not reached through a
            # dot: it is the call's one unlabelled argument, or it carries the
            # receiver parameter's own declared name. Everything past that is
            # the ordinary method emission, so the two call forms share ONE
            # argument-placement rule and a label binds by name in both. This
            # leg used to walk the call's arguments in WRITTEN order, which
            # silently swapped a pair of reordered labels.
            # THE CHECKER ANSWERED THIS, and this reads the answer. A call
            # reaches here only when the walk stamped its receiver as coming
            # from the ARGUMENTS; otherwise the dot supplies it and the call is
            # emitInstanceMethodCall's. Deriving it a second time -- off the
            # base atom's variable id, or off the name -- is what let the two
            # sides disagree and emit a call with the receiver slot never
            # filled. A construction asks no such question and returns above.
            if (symtab.typing.callRecvFromArgs.has item: call.nodeid.u64) == false then {
                return "".string
            }
            recvNmQ: "this".string
            {
                tpq: (zast.poolTextAt
                    pool: ast.names
                    ref: (symtab.reg.thisParamNameIdOf tid: (ztypes.tid.create from: mco.u64))
                )
                if tpq.length > 0 then recvNmQ = tpq.copy
            }
            recvExQ: String
            recvPtrQ: false
            posStartQ: u64
            if (fnTypeTakesThis :symtab tid: (ztypes.tid.create from: mco.u64)) then {
                recvNdQ: u64
                if (ctorHasLabel :ast :call label: recvNmQ.stringView) then {
                    recvExQ = ctorArgByLabel :ast :symtab :ctx :call label: recvNmQ.stringView
                    recvNdQ = ctorArgNodeByLabel :ast :call label: recvNmQ.stringView
                } else {
                    recvExQ = ctorArgByPosition :ast :symtab :ctx :call idx: 0
                    recvNdQ = ctorArgNodeByPosition :ast :call idx: 0
                    posStartQ = 1
                }
                # a receiver already held as a pointer passes as it stands
                if recvNdQ > 0 then {
                    recvPtrQ = (pathIsPointer :ast :symtab :ctx n: (ast.nodes.get i: recvNdQ))
                }
                # no receiver supplied at all: the checker reports the missing
                # argument, and the stamp keeps the dotted leg from claiming
                # this call, so declining reports an unhandled callee rather
                # than hoisting a zeroed temp nobody passed
                if recvExQ.length == 0 then return "".string
            }
            return (emitInstanceMethodBody
                :ast
                :symtab
                :ctx
                :call
                mco: (ztypes.tid.create from: mco.u64)
                recvExpr: recvExQ.stringView
                recvIsPtr: recvPtrQ
                posStart: posStartQ
            )
        }
    } case none then null
    return "".string
}

# literalC -- a numeric literal lexeme as C text. `0b`, `0o` and `0c` are
# zerolang spellings with no C token behind them, so they are decoded to their
# value; decimal, hex and float lexemes are C as written. Empty when the lexeme
# does not parse, which each caller reports in its own terms.
literalC: function {lex: StringView} out String is {
    decode: false
    if lex.startsWith "0b" then decode = true
    if lex.startsWith "0o" then decode = true
    if lex.startsWith "0c" then decode = true
    if decode == false then return lex.string
    pnl: ztypes.parseNumber numstr: lex
    if pnl.err.length > 0 then return "".string
    vl: "\{pnl.ival}"
    return vl
}

# renderDefault -- a member's recorded default as a C expression. A literal
# re-renders from its expression node; a function default is the target
# FUNCTION type's symbol (the parameter IS that function); an arm default is a
# tag-only struct literal of the target.
renderDefault: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    dv: ztyping.defaultval
    targetTid: ztypes.tid
} out String is {
    {
        dl: dv
        if dl.literal then {
            if dl == 0 then return "".string
            lt: ztypecheck.rootNameOf :ast n: (ast.nodes.get i: dl.u64)
            lc: literalC lex: lt.stringView
            if lc.length > 0 then return lc
            return lt
        }
    }
    {
        df: dv
        if df.func then {
            tn: regNameOf :symtab tid: (ztypes.tid.create from: targetTid.u64)
            cf: (canonFnId
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: targetTid.u64)
                name: tn.stringView
            )
            if cf > 0 then return (ctxCname :ctx tid: (ztypes.tid.create from: cf.u64))
            return (ctxCname :ctx tid: (ztypes.tid.create from: targetTid.u64))
        }
    }
    {
        da: dv
        if da.arm then {
            armId: zast.nameid
            {
                ao: symtab.typing.decls.get i: da.u64
                armId = zast.nameid.create from: ao.name
            }
            arm: zast.poolTextAt pool: ast.names ref: armId
            tn2: regNameOf :symtab tid: (ztypes.tid.create from: targetTid.u64)
            cv: (canonFnId
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: targetTid.u64)
                name: tn2.stringView
            )
            vtarget: targetTid
            if cv > 0 then vtarget = ztypes.tid.create from: cv.u64
            tg: variantTag :symtab tid: (ztypes.tid.create from: vtarget.u64) arm: arm.stringView
            tc: (typeRefC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: vtarget.u64)
                thisTid: ztypes.tid
            )
            avd: (armValueC
                :symtab
                tid: (ztypes.tid.create from: vtarget.u64)
                arm: arm.stringView
            )
            if avd.length > 0 then return avd
            return "(\{tc}){ .tag = \{tg} }"
        }
    }
    return "".string
}

# fnTypeTakesThis -- a FUNCTION type whose signature carries a `this` receiver
# (a method-ref slot auto-calls through itself with the receiver).
#
# TWO SPELLINGS, ONE QUESTION. The long form (`self: this`) records the
# receiver's NAME, which hasThisParamName answers; the elided form (`:this`)
# declares a member literally named `this` and records no param name, so
# hasThisParamName answers false for a method that plainly has a receiver.
# Asking only the second half made `point.add.take` emit a call for `:this`
# methods and a reference for `self: this` ones -- the same declaration
# spelled two ways, emitting two different things. This mirrors the checker's
# methodHasThisReceiver, which has always asked both.
fnTypeTakesThis: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    if (symtab.typing.declHasMemberId parentTypeId: tid nameId: zast.names.wkThis) then return true
    return (symtab.reg.hasThisParamName :tid)
}

# emitAllDefaultedCall -- a bare reference to a function whose params are ALL
# defaulted is a no-arg auto-call: `describe` -> `z_..._describe(<defaults>)`.
# "" when the function has no params or any param lacks a default.
emitAllDefaultedCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    fnTid: ztypes.tid
    fcn: StringView
} out String is {
    pidl: ListVal u64
    pidlNm: ListVal u64
    (recFieldIds
        :symtab
        tid: (ztypes.tid.create from: fnTid.u64)
        ids: pidl
        nameIds: pidlNm
    )
    m: pidl.length
    if m == 0 then return "".string
    j: u64
    allDef: true
    for j < m loop {
        pnjId: pidlNm.get i: j
        hd: (symtab.typing.declHasDefaultId
            parentTypeId: fnTid
            nameId: (zast.nameid.create from: pnjId.u32.orPanic)
        )
        if hd == false then allDef = false
        j = j + 1
    }
    if allDef == false then return "".string
    args: String
    k: u64
    for k < m loop {
        pik: pidl.get i: k
        pnkId: pidlNm.get i: k
        dt: (symtab.typing.declDefaultOfId
            parentTypeId: fnTid
            nameId: (zast.nameid.create from: pnkId.u32.orPanic)
        )
        rv: renderDefault :ast :symtab :ctx dv: dt targetTid: (ztypes.tid.create from: pik.u64)
        if k > 0 then args.append ", "
        args.append rv
        k = k + 1
    }
    r: "\{fcn}(\{args})"
    return r
}

# renderedMethodDefaultArgs -- the comma-joined rendered defaults for every
# non-receiver parameter of a method, when ALL of them carry defaults; ""
# when any is required or there are none (the caller keeps its emission).
renderedMethodDefaultArgs: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    fnTid: ztypes.tid
} out String is {
    pn: List String
    pidl: ListVal u64
    pidlNm: ListVal u64
    (recFieldLists
        :ast
        :symtab
        tid: (ztypes.tid.create from: fnTid.u64)
        names: pn
        ids: pidl
        nameIds: pidlNm
    )
    thisPn: zast.poolTextAt pool: ast.names ref: (symtab.reg.thisParamNameIdOf tid: fnTid)
    args: String
    userSeen: false
    j: u64
    m: pn.length
    for j < m loop {
        pnj: pn.get i: j
        pij: pidl.get i: j
        pnjId: pidlNm.get i: j
        j = j + 1
        isRecv: false
        if pnjId == zast.names.wkThis.u64 then isRecv = true
        if thisPn.length > 0 when thisPn.stringView == pnj.stringView then isRecv = true
        if isRecv == false then {
            userSeen = true
            hd: (symtab.typing.declHasDefaultId
                parentTypeId: fnTid
                nameId: (zast.nameid.create from: pnjId.u32.orPanic)
            )
            if hd == false then return "".string
            dt: (symtab.typing.declDefaultOfId
                parentTypeId: fnTid
                nameId: (zast.nameid.create from: pnjId.u32.orPanic)
            )
            rv: renderDefault :ast :symtab :ctx dv: dt targetTid: (ztypes.tid.create from: pij.u64)
            if args.length > 0 then args.append ", "
            args.append rv
        }
    }
    if userSeen == false then return "".string
    return args
}

# emitExprStrZero -- the empty owned String value: the zero struct needs
# no allocation and no free.
emitExprStrZero: function {ctx: Ctx.view} out String is {
    return "((\{ctx.strC}_t){0})"
}

# emitCtorDefaultsFill -- the zero-argument construction of a record/class
# tid: a body-carrying user create called with its param defaults, else the
# generated field-wise create with each field's default (fnptr fields pass
# the method symbol). The typechecker's implicitCreate stamp guarantees no
# required argument remains.
emitCtorDefaultsFill: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
} out String is {
    cco: symtab.typing.declChildOfId parentTypeId: tid nameId: zast.names.wkCreate
    match (
        cco
    ) case some then {
        if (
            (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: cco.u64)) ==
            ztypes.ztypetype.functionType
        ) then {
            crB: false
            crn: symtab.typing.funcReturnNode.get key: cco
            match (
                crn
            ) case some then {
                crB = true
            } case none then null
            if crB then {
                cpi: ListVal u64
                cpiNm: ListVal u64
                (recFieldIds
                    :symtab
                    tid: (ztypes.tid.create from: cco.u64)
                    ids: cpi
                    nameIds: cpiNm
                )
                cargs: String
                ci: u64
                ccn: cpi.length
                for ci < ccn loop {
                    cpid: cpi.get i: ci
                    cpnameId: cpiNm.get i: ci
                    ci = ci + 1
                    cav: "0".string
                    if (symtab.typing.declHasDefaultId
                        parentTypeId: tid
                        nameId: (zast.nameid.create from: cpnameId.u32.orPanic)
                    ) then {
                        cdt: (symtab.typing.declDefaultOfId
                            parentTypeId: tid
                            nameId: (zast.nameid.create from: cpnameId.u32.orPanic)
                        )
                        cav = (renderDefault
                            :ast
                            :symtab
                            :ctx
                            dv: cdt
                            targetTid: (ztypes.tid.create from: cpid.u64)
                        )
                    }
                    if cargs.length > 0 then cargs.append ", "
                    cargs.append cav
                }
                ccb: ctxCname :ctx tid: (ztypes.tid.create from: cco.u64)
                return "\{ccb}(\{cargs})"
            }
        }
    } case none then null
    fids: ListVal u64
    fidsNm: ListVal u64
    recFieldIds :symtab :tid ids: fids nameIds: fidsNm
    args: String
    fi: u64
    fn0: fids.length
    for fi < fn0 loop {
        ffid: fids.get i: fi
        fnameId: fidsNm.get i: fi
        fi = fi + 1
        av: "0".string
        if (symtab.typing.declHasDefaultId
            parentTypeId: tid
            nameId: (zast.nameid.create from: fnameId.u32.orPanic)
        ) then {
            cdt1: (symtab.typing.declDefaultOfId
                parentTypeId: tid
                nameId: (zast.nameid.create from: fnameId.u32.orPanic)
            )
            av = (renderDefault
                :ast
                :symtab
                :ctx
                dv: cdt1
                targetTid: (ztypes.tid.create from: ffid.u64)
            )
        } else {
            if (symtab.typing.declIsFnptrFieldId
                parentTypeId: tid
                nameId: (zast.nameid.create from: fnameId.u32.orPanic)
            ) then {
                av = ctxCname :ctx tid: (ztypes.tid.create from: ffid.u64)
            }
        }
        if args.length > 0 then args.append ", "
        args.append av
    }
    rcb: ctxCname :ctx :tid
    return "\{rcb}_create(\{args})"
}

# emitRecordCtor -- a record construction call: args reordered to field
# order by label, emitted through the create alias.
emitRecordCtor: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    tid: ztypes.tid
} out String is {
    # a user-defined `create` (non-empty params) overrides the field-wise ctor:
    # bare-name construction routes through it, args by the create's own labels.
    cco: symtab.typing.declChildOfId parentTypeId: tid nameId: zast.names.wkCreate
    match (
        cco
    ) case some then {
        if (
            (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: cco.u64)) ==
            ztypes.ztypetype.functionType
        ) then {
            crB: false
            crn: symtab.typing.funcReturnNode.get key: cco
            match (
                crn
            ) case some then {
                crB = true
            } case none then null
            cpn: List String
            cpi: ListVal u64
            cpiNm: ListVal u64
            (recFieldLists
                :ast
                :symtab
                tid: (ztypes.tid.create from: cco.u64)
                names: cpn
                ids: cpi
                nameIds: cpiNm
            )
            if crB then {
                cargs: String
                ci: u64
                ccn: cpn.length
                cposIdx: u64
                for ci < ccn loop {
                    cpname: cpn.get i: ci
                    cpnameId: cpiNm.get i: ci
                    cpid0: cpi.get i: ci
                    # the create's own parameters decide how each argument is
                    # passed, exactly as they do for any other call of it: a
                    # non-`take` user class is a `T*`, so a bare local has to be
                    # addressed. userFnArgText is the same answer the direct-call
                    # path uses -- asking it here is what keeps a `create`
                    # reached by construction agreeing with one reached by name.
                    cav: "0".string
                    caNid: u64
                    if (ctorHasLabel :ast :call label: cpname.stringView) then {
                        caNid = ctorArgNodeByLabel :ast :call label: cpname.stringView
                    } else {
                        caNid = ctorArgNodeByPosition :ast :call idx: cposIdx
                        cposIdx = cposIdx + 1
                    }
                    if caNid > 0 then {
                        cav = (userFnArgText
                            :ast
                            :symtab
                            :ctx
                            fid: (ztypes.tid.create from: cco.u64)
                            pinId: cpid0
                            pinNm: cpname.stringView
                            argOpNode: (ast.nodes.get i: caNid)
                        )
                    } else {
                        if (symtab.typing.declHasDefaultId
                            parentTypeId: tid
                            nameId: (zast.nameid.create from: cpnameId.u32.orPanic)
                        ) then {
                            cdt0: (symtab.typing.declDefaultOfId
                                parentTypeId: tid
                                nameId: (zast.nameid.create from: cpnameId.u32.orPanic)
                            )
                            cav = (renderDefault
                                :ast
                                :symtab
                                :ctx
                                dv: cdt0
                                targetTid: (ztypes.tid.create from: cpid0.u64)
                            )
                        }
                    }
                    if ci > 0 then cargs.append ", "
                    cargs.append cav
                    ci = ci + 1
                }
                ccb: ctxCname :ctx tid: (ztypes.tid.create from: cco.u64)
                ce: "\{ccb}(\{cargs})"
                return ce
            }
        }
    } case none then null
    fnames: List String
    fids: ListVal u64
    fidsNm: ListVal u64
    recFieldLists :ast :symtab :tid names: fnames ids: fids nameIds: fidsNm
    args: String
    fi: u64
    fn0: fnames.length
    fposIdx: u64
    for fi < fn0 loop {
        fname: fnames.get i: fi
        ffid0: fids.get i: fi
        fnameId: fidsNm.get i: fi
        av: ctorArgByLabel :ast :symtab :ctx :call label: fname.stringView
        # an absent label binds the next positional (unlabeled) arg by cursor; then a
        # registered default; then an fnptr slot's method address; else the "0" fallback.
        if (ctorHasLabel :ast :call label: fname.stringView) == false then {
            fposUsed: false
            fpv: ctorArgByPosition :ast :symtab :ctx :call idx: fposIdx
            if fpv.length > 0 then {
                av = fpv
                fposUsed = true
            }
            fposIdx = fposIdx + 1
            if fposUsed == false then {
                if (symtab.typing.declHasDefaultId
                    parentTypeId: tid
                    nameId: (zast.nameid.create from: fnameId.u32.orPanic)
                ) then {
                    cdt1: (symtab.typing.declDefaultOfId
                        parentTypeId: tid
                        nameId: (zast.nameid.create from: fnameId.u32.orPanic)
                    )
                    av = (renderDefault
                        :ast
                        :symtab
                        :ctx
                        dv: cdt1
                        targetTid: (ztypes.tid.create from: ffid0.u64)
                    )
                } else {
                    if (symtab.typing.declIsFnptrFieldId
                        parentTypeId: tid
                        nameId: (zast.nameid.create from: fnameId.u32.orPanic)
                    ) then {
                        av = ctxCname :ctx tid: (ztypes.tid.create from: ffid0.u64)
                    }
                }
            }
        }
        # a borrowed reftype field is a pointer; a source stored INLINE (the
        # receiver's own field, a field of a parameter) is passed by address
        if (ctorHasLabel :ast :call label: fname.stringView) then {
            if (symtab.typing.declIsBorrowedFieldId
                parentTypeId: tid
                nameId: (zast.nameid.create from: fnameId.u32.orPanic)
            ) then {
                if (borrowedFieldIsReftypePtr
                    :ast
                    :symtab
                    :ctx
                    fid: (ztypes.tid.create from: ffid0.u64)
                ) then {
                    if (
                        (argIsPointerByLabel
                            :ast
                            :symtab
                            :ctx
                            :call
                            label: fname.stringView
                        ) ==
                        false
                    ) then {
                        avP: (emitByrefArg
                            :ast
                            :symtab
                            :ctx
                            av: av.stringView
                            pid: (ztypes.tid.create from: ffid0.u64)
                            isBorrow: true
                        )
                        av = avP
                    }
                }
            }
        }
        if fi > 0 then args.append ", "
        args.append av
        fi = fi + 1
    }
    rc: ctxCname :ctx :tid
    e0: "\{rc}_create(\{args})"
    return e0
}

# ctorArgIsBorrow / ctorArgIsBorrowPos -- bindingRhsIsBorrow over the
# argument ctorArgByLabel / ctorArgByPosition would emit: a hoisted
# borrow-returning result must not register a destroy.
ctorArgIsBorrow: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.callrow.view
    label: StringView
} out bool is {
    arx369: u64
    for arx369 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx369
        arx369 = arx369 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringView == label then return (hoistExprIsBorrowRooted
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: a.operation.u64)
            )
        }
    }
    return false
}

# true when a constructor argument sits in a borrow position.
ctorArgIsBorrowPos: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.callrow.view
    idx: u64
} out bool is {
    seen: u64
    arx379: u64
    for arx379 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx379
        arx379 = arx379 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.length == 0 then {
                if seen == idx then return (hoistExprIsBorrowRooted
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                )
                seen = seen + 1
            }
        }
    }
    return false
}

# the constructor-argument node matching a field label.
ctorArgNodeByLabel: function {ast: Ast.view call: zast.callrow.view label: StringView} out u64 is {
    arx389: u64
    for arx389 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx389
        arx389 = arx389 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringView == label then return a.operation.u64
        }
    }
    return 0
}

# ctorArgByLabel -- that argument's emitted text. Selected through the node
# above so a caller can ask about the same argument by node.
ctorArgByLabel: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    label: StringView
} out String is {
    aid: ctorArgNodeByLabel :ast :call :label
    if aid == 0 then return "0".string
    return (ctorArgTextAt :ast :symtab :ctx :aid)
}

# ctorArgTextAt -- one argument node's emitted text. An interpolated argument
# builds through a self-contained statement expression, which emitExpr cannot
# emit as a chain, so it is asked for first.
ctorArgTextAt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    aid: u64
} out String is {
    n: ast.nodes.get i: aid
    iv: emitInterpArgExpr :ast :symtab :ctx :n
    if iv.length > 0 then return iv
    return (emitExpr :ast :symtab :ctx :n)
}

# argAlreadyPointer -- does this argument expression already evaluate to a C
# pointer, so that addressing it again would hand the callee a `T**`? Two ways
# it can be one, and a site that asks only the first is wrong: a bare local
# holding a reference answers through its VID, while a path -- a non-owned
# reftype field, a reference-returning call -- has no vid of its own and only
# `pathIsPointer` sees it. Every byref decision asks this, not one half of it.
argAlreadyPointer: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    vid: ztypes.vid
} out bool is {
    if (isPtrVid :ctx :vid) then return true
    return (pathIsPointer :ast :symtab :ctx :n)
}

# argIsPointerByLabel -- true when the arg at `label` already evaluates to a C
# pointer (a reftype/List param or a borrowed field), so a native by-pointer
# parameter must pass it directly rather than re-addressing it with `&`.
argIsPointerByLabel: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    label: StringView
} out bool is {
    arx399: u64
    for arx399 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx399
        arx399 = arx399 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringView == label then return (pathIsPointer
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: a.operation.u64)
            )
        }
    }
    return false
}

# ctorArgNodeByPosition -- ctorArgByPosition's node id rather than its C text,
# for a caller that must look the argument up again instead of printing it.
# 0 when there is no positional argument at that index.
ctorArgNodeByPosition: function {ast: Ast.view call: zast.callrow.view idx: u64} out u64 is {
    seen: u64
    arx409: u64
    for arx409 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx409
        arx409 = arx409 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.length == 0 then {
                if seen == idx then return a.operation.u64
                seen = seen + 1
            }
        }
    }
    return 0
}

# ctorArgByPosition -- the idx-th POSITIONAL (unlabeled) argument's C text, for a
# method call passing args positionally (`this.formatLockHolder holder`) rather
# than by label; "" when there is no such arg.
# ctorArgByPosition -- that argument's emitted text, selected through the node
# above so a caller can ask about the same argument by node.
ctorArgByPosition: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    idx: u64
} out String is {
    posParamId: ctorArgNodeByPosition :ast :call :idx
    if posParamId == 0 then return "".string
    return (ctorArgTextAt :ast :symtab :ctx aid: posParamId)
}

# ctorInterpArgAt -- the interp-arg form (emitInterpArgForParam) for one
# argument node, or "" when there is none or it is not an interpolated
# literal. Lets a method or constructor call pass an interpolated literal
# directly: build, coerce, free. The caller finds the node, by label or by
# position, through the finders above.
ctorInterpArgAt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    aid: u64
    fid: ztypes.tid
    pname: StringView
    pid: u64
} out String is {
    if aid == 0 then return "".string
    return (emitInterpArgForParam :ast :symtab :ctx n: (ast.nodes.get i: aid) :fid :pname :pid)
}

# argSlotList -- per call-argument (in call order), the index of the parameter
# slot it binds in `fpNames` (declaration order): a named arg binds by name, an
# unlabelled arg binds the next free slot via a positional cursor (first-arg
# elision). Returns `fpNames.length` (an out-of-range sentinel) for an argument
# that binds no value slot (e.g. a generic type-arg, whose name is not a value
# param). Lets a call's named args be emitted to C in PARAMETER order.
argSlotList: function {
    ast: Ast.view
    call: zast.callrow.view
    fpNameIds: (ListVal u64).view
} out ListVal u64 is {
    result: ListVal u64
    cn: fpNameIds.length
    consumed: ListVal bool
    ci: u64
    for ci < cn loop {
        consumed.append false
        ci = ci + 1
    }
    cursor: u64
    arx419: u64
    for arx419 < call.arguments.count.u64 loop {
        a9Id: zast.kidAt kids: ast.kids span: call.arguments i: arx419
        arx419 = arx419 + 1
        a: ast.nodes.get i: a9Id.u64
        match (
            a
        ) case namedoperation then {
            # the label and the parameter names are both pool ids already, so
            # the match is an id compare. An UNLABELLED argument carries no name;
            # the empty spelling has an id of its own, so both are excluded
            hasLbl: a.name.isZero == false
            if hasLbl when a.name == zast.names.wkEmpty then hasLbl = false
            slot: fpNameIds.length
            if hasLbl then {
                fi: u64
                for fi < cn loop {
                    if (fpNameIds.get i: fi) == a.name.u64 then slot = fi
                    fi = fi + 1
                }
            } else {
                adv: true
                for adv loop {
                    if cursor >= cn then {
                        adv = false
                    } else {
                        if (consumed.get i: cursor) then {
                            cursor = cursor + 1
                        } else {
                            adv = false
                        }
                    }
                }
                if cursor < cn then {
                    slot = cursor
                    cursor = cursor + 1
                }
            }
            if slot < cn then consumed.set i: slot val: true
            result.append slot
        } else {
            result.append fpNameIds.length
        }
    }
    return result
}

# constScalarNameForTid -- the BUILTIN SCALAR NAME a constant of type `tid` is
# rendered as: `u32` for u32, and for a scalar typedef the base it spells
# (`nameid` -> u32). "" when the type is not a scalar at all.
#
# It answers a name rather than a suffix because the two things a literal needs
# from its type -- how wide it is and what suffix C wants -- are both read off
# that name, and resolving the tid twice to ask them separately is a second
# name-resolution site in the emitter for one question.
constScalarNameForTid: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out String is {
    if tid.isZero then return "".string
    tn: regNameOf :symtab :tid
    if tn.length == 0 then return "".string
    # scalarCTypeFor rather than cTypeOf: it re-checks the tid for a user
    # shadow, so a user type named `u32` cannot pick up u32's C suffix. The
    # name lookup it needs is the shape shadow-guard sanctions.
    if (scalarCTypeFor :symtab name: tn.stringView :tid).length > 0 then return tn
    # a scalar TYPEDEF chases to the builtin it spells, keyed by tid so the
    # answer does not depend on which unit the read happens in. numLitSuffix
    # yields "" for a name that is not a builtin, so no second scalar test is
    # needed here.
    bo: symtab.typing.typedefBaseName.get key: tid
    match (
        bo
    ) case some then {
        boId: zast.nameid
        boId = bo
        return (zast.nameTextCopy :ast ref: boId)
    } case none then null
    return "".string
}

# narrowConstToName -- a folded i64 reduced to what the named integer type can
# actually hold, the way the runtime operator does it. The evaluator works in i64
# and a cval carries no type by design, so the narrowing is the MATERIALISER's --
# and an inline use (an interpolation, a nested operator) has no assignment to
# truncate it the way a binding's C initializer does. `200.u8 * 2.u8` rendered
# 400 inline and 144 bound. Membership strings rather than a compare chain, which
# is the shape A001 exists to discourage.
narrowConstToName: function {v: i64 name: StringView} out i64 is {
    probe: " \{name} "
    mu8: " u8 c8 "
    if (mu8.contains needle: probe) then return (v & 255)
    mu16: " u16 "
    if (mu16.contains needle: probe) then return (v & 65535)
    mu32: " u32 c32 "
    if (mu32.contains needle: probe) then return (v & 4294967295)
    mi8: " i8 "
    if (mi8.contains needle: probe) then {
        t8: v & 255
        if t8 > 127 then return (t8 - 256)
        return t8
    }
    mi16: " i16 "
    if (mi16.contains needle: probe) then {
        t16: v & 65535
        if t16 > 32767 then return (t16 - 65536)
        return t16
    }
    mi32: " i32 "
    if (mi32.contains needle: probe) then {
        t32: v & 4294967295
        if t32 > 2147483647 then return (t32 - 4294967296)
        return t32
    }
    return v
}

# cvalText -- the C literal for a compile-time value the typechecker folded.
# "" for a kind this emitter cannot render yet, which leaves the caller on its
# ordinary path rather than emitting something wrong.
cvalText: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
    v: ztypes.cval
} out String is {
    if v.kind.ivalKind then {
        tnN: constScalarNameForTid :ast :symtab :tid
        iv: narrowConstToName v: v.ival name: tnN.stringView
        # C HAS NO NEGATIVE LITERALS. A leading `-` is an operator applied to a
        # POSITIVE constant, and the magnitude of the most negative i64 is one
        # past what a signed constant can hold -- so `-9223372036854775808`
        # reads as unsigned and the value arrives with the wrong type. It is
        # the one value that cannot be written directly; C spells it by
        # subtracting from the one below it, and so does this.
        if iv == ((0 - 9223372036854775807) - 1) then return "(-9223372036854775807LL - 1)".string
        r: "\{iv}"
        r.append (numLitSuffix name: tnN.stringView)
        return r
    }
    if v.kind.fvalKind then {
        fv: v.fval
        return "\{fv}"
    }
    if v.kind.armKind then {
        if v.armTid.isZero then return "".string
        if v.armName.isZero then return "".string
        an: ast.names.texts.get i: v.armName.u32.u64
        # a variant that maps onto a scalar C type (bool) renders as that
        # scalar; anything else is the payload-less compound literal
        # emitInlineVariantCtor builds for the same arm written as a call
        atomVarId: armValueC :symtab tid: v.armTid arm: an.stringView
        if atomVarId.length > 0 then return atomVarId
        tg: variantTag :symtab tid: v.armTid arm: an.stringView
        if tg.length == 0 then return "".string
        vc: ctxCname :ctx tid: v.armTid
        if vc.length == 0 then return "".string
        return "((\{vc}_t){ .tag = \{tg} })"
    }
    return "".string
}

# cvalStrText -- the C text for a folded STRING value: a `_zcsN` static minted
# in ctx.constLits. "" for any other kind, which leaves the caller on its
# ordinary path exactly as cvalText's "" does.
#
# Deduplicated by TEXT, not by origin: two constants that fold to the same bytes
# are one static, and a folded value has no node identity to key on anyway.
cvalStrText: function {symtab: zenv.ZSymbolTable.view ctx: Ctx v: ztypes.cval} out String is {
    if v.kind.svalKind == false then return "".string
    if v.strId == 0 then return "".string
    t: symtab.typing.constStrings.get i: v.strId.u64
    i: u64
    n: ctx.constLits.length
    hit: u64
    for i < n loop {
        if hit == 0 then {
            e: ctx.constLits.get :i
            if e.stringView == t.stringView then hit = i + 1
        }
        i = i + 1
    }
    if hit > 0 then {
        rh: "_zcs\{hit}"
        return rh
    }
    ctx.constLits.append t.copy
    r0: "_zcs\{ctx.constLits.length}"
    return r0
}

# foldedBranchOf -- the clause the typechecker's constant fold selected for an
# `if` or a `match`. `known` false means the conditions did not all fold, so a
# runtime branch must be emitted; `known` true with a zero stmt means nothing
# was selected and nothing is emitted at all.
foldedBranchOf: function {symtab: zenv.ZSymbolTable.view nid: u64} out ztyping.foldedbranch is {
    go: symtab.typing.foldedBranch.get key: nid
    match (
        go
    ) case some then {
        return go
    } case none then {
        return (ztyping.foldedbranch known: false stmt: zast.nodeid)
    }
}

# nodeConstText -- the C literal for a node carrying a compile-time const
# stamp; "" otherwise, which leaves the caller on its ordinary emit path.
#
# A FLOAT VALUE IS REFUSED HERE. The stamp says what a node evaluates to, and
# for a float the evaluator answers in f64 while the node may be f16, f32 or
# f128 -- `1.0e300.f128 * 1.0e50.f128` is finite as f128 and INFINITE as f64.
# The decimal rendering is not faithful either: it cannot spell a negative
# zero, and there is no literal for a non-finite value at all. Refusing is the
# whole of it -- the ordinary path emits the arithmetic and the program keeps
# its own precision. The integer, string and arm domains are exact and are
# rendered.
nodeConstText: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    nid: zast.nodeid
} out String is {
    if nid.isZero then return "".string
    g: symtab.typing.nodeConst.get key: nid.u64
    match (
        g
    ) case some then {
        if g.kind.fvalKind then return "".string
        tv: ztyping.nodeTypeAt tbl: symtab.typing.nodeType nid: nid.u64
        sc: cvalText :ast :symtab :ctx tid: tv v: g
        if sc.length > 0 then return sc
        return (cvalStrText :symtab :ctx v: g)
    } case none then {
        return "".string
    }
}

# memberConstTid -- the declared type of a unit constant, 0 when it has none.
memberConstTid: function {
    symtab: zenv.ZSymbolTable.view
    unitTid: ztypes.tid
    nameId: zast.nameid
} out ztypes.tid is {
    co: symtab.typing.declChildOfId parentTypeId: unitTid :nameId
    match (
        co
    ) case some then {
        return (ztypes.tid.create from: co)
    } case none then {
        return ztypes.tid
    }
}

# memberConstText -- the C text for a unit constant, rendered from its VALUE
# and carrying the literal suffix its declared type asks for. "" when the
# member has no compile-time value, which is what leaves the caller on its
# ordinary path. SCALARS ONLY: it answers on a Ctx.view, which is what lets
# scalarArmLabel keep using it, and a folded string needs the mutable Ctx that
# memberConstStringText takes.
memberConstText: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    unitTid: ztypes.tid
    nameId: zast.nameid
} out String is {
    if unitTid.isZero then return "".string
    if nameId.isZero then return "".string
    mv: symtab.typing.memberConstOf parentTypeId: unitTid :nameId
    if mv.kind.none then return "".string
    mt: memberConstTid :symtab :unitTid :nameId
    return (cvalText :ast :symtab :ctx tid: mt v: mv)
}

# memberConstStringText -- the `_zcsN` a STRING constant renders as. The string
# half of memberConstText, split off rather than folded into it because
# minting needs a mutable Ctx and one caller -- scalarArmLabel, building a C
# case label -- can only ever want the scalar half: a case label is a scalar by
# definition, so the string pool must not be on its path.
memberConstStringText: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    unitTid: ztypes.tid
    nameId: zast.nameid
} out String is {
    if unitTid.isZero then return "".string
    if nameId.isZero then return "".string
    mv: symtab.typing.memberConstOf parentTypeId: unitTid :nameId
    return (cvalStrText :symtab :ctx v: mv)
}

# unitTidOf -- the type id of the unit named `unitName`, or 0.
unitTidOf: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    unitName: StringView
} out ztypes.tid is {
    return (ztypecheck.declTypeIdOf
        st: symtab
        declId: (symtab.typing.declFindChild
            parentDeclId: symtab.typing.programRoot
            nameId: (zast.poolFind pool: ast.names text: unitName)
        )
    )
}

# ctorHasLabel -- whether a call carries a named argument with this label.
ctorHasLabel: function {ast: Ast.view call: zast.callrow.view label: StringView} out bool is {
    arx429: u64
    for arx429 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx429
        arx429 = arx429 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringView == label then return true
        }
    }
    return false
}

# emitMetaCreateCall -- `meta.create field: val ...`, the enclosing type's raw
# allocator (its field children as params). The typecheck stamps the call node
# with that type; emit `{type}_meta_create(args)` (never `_create`, which the
# user's own create may override -> recursion). "" when not a meta.create.
emitMetaCreateCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    mcb: ztypecheck.metaCreateBaseId :ast n: (ast.nodes.get i: call.callable.u64)
    match (
        mcb
    ) case some then {
        et: stampIdOf :symtab nid: call.nodeid.u64
        if et.isZero then return "".string
        fnames: List String
        fids: ListVal u64
        fidsNm: ListVal u64
        recFieldLists :ast :symtab tid: et names: fnames ids: fids nameIds: fidsNm
        args: String
        fi: u64
        fn0: fnames.length
        for fi < fn0 loop {
            fname: fnames.get i: fi
            av: String
            if (ctorHasLabel :ast :call label: fname.stringView) then {
                av = ctorArgByLabel :ast :symtab :ctx :call label: fname.stringView
                # a borrowed reftype field is a pointer; a source stored INLINE
                # (the receiver's own field, a field of a parameter) is passed
                # by address
                ffidL: fids.get i: fi
                if (symtab.typing.declIsBorrowedField
                    pool: ast.names
                    parentTypeId: et
                    name: fname.stringView
                ) then {
                    if (borrowedFieldIsReftypePtr
                        :ast
                        :symtab
                        :ctx
                        fid: (ztypes.tid.create from: ffidL.u64)
                    ) then {
                        if (
                            (argIsPointerByLabel
                                :ast
                                :symtab
                                :ctx
                                :call
                                label: fname.stringView
                            ) ==
                            false
                        ) then {
                            avM: (emitByrefArg
                                :ast
                                :symtab
                                :ctx
                                av: av.stringView
                                pid: (ztypes.tid.create from: ffidL.u64)
                                isBorrow: true
                            )
                            av = avM
                        }
                    }
                }
            } else {
                # a field absent from the meta.create args (a generator's promoted
                # local: an inner iterator struct or a loop counter) is value-
                # initialized; a typed zero compiles for both scalars and structs.
                ffid: fids.get i: fi
                ffct: (typeRefC
                    :ast
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: ffid.u64)
                    thisTid: ztypes.tid
                )
                if ffct.length == 0 then {
                    pmsg7: "zemitterc: unspellable field type id \{ffid}"
                    panic pmsg7
                }
                if (symtab.typing.declIsBorrowedField
                    pool: ast.names
                    parentTypeId: et
                    name: fname.stringView
                ) when (borrowedFieldIsReftypePtr
                    :ast
                    :symtab
                    :ctx
                    fid: (ztypes.tid.create from: ffid.u64)
                ) then ffct = "\{ffct}*"
                av = "(\{ffct}){0}"
            }
            if fi > 0 then args.append ", "
            args.append av
            fi = fi + 1
        }
        ecb: ctxCname :ctx tid: et
        e0: "\{ecb}_meta_create(\{args})"
        return e0
    } case none then {
        return "".string
    }
}

# emitByrefArg -- an argument passed BY REFERENCE. A non-lvalue has no address
# to take, so it is hoisted into a numbered `_ah` temp of the parameter's own C
# type and the temp's address goes to the call instead.
emitByrefArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    av: StringView
    pid: ztypes.tid
    isBorrow: bool
} out String is {
    if (isNonLvalueArg s: av) == false then return "&\{av}"
    hn: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    nmH: "_ah\{hn}"
    hcty: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: pid.u64) thisTid: ztypes.tid
    htyc: hcty.copy
    hrid: pid
    hduo: definedInUnitOf :symtab tid: (ztypes.tid.create from: pid.u64)
    match (
        hduo
    ) case none then {
        htn0: regNameOf :symtab tid: (ztypes.tid.create from: pid.u64)
        hrr: (canonTypeId
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: pid.u64)
            name: htn0.stringView
        )
        if hrr > 0 then hrid = ztypes.tid.create from: hrr.u64
    } case some then null
    hdt: String
    if isBorrow then null else if hrid == ctx.strTid then {
        hdt = "    \{ctx.strC}_free(&\{nmH});\n"
    } else {
        if (symtab.reg.needsDestructor typeId: hrid) then {
            hcb: ctxCname :ctx tid: (ztypes.tid.create from: hrid.u64)
            hdt = "    \{hcb}_destroy(&\{nmH});\n"
        }
    }
    avc: av.string
    r: "&\{nmH}"
    ctx.argHoistVals.append avc
    ctx.argHoistTypes.append htyc
    ctx.argHoistDtors.append hdt
    ctx.argHoistNames.append nmH
    return r
}

# fnIsNativeId -- the fn id's isNative flag (a mono inherits it from its
# native template at mint).
fnIsNativeId: function {symtab: zenv.ZSymbolTable.view fid: ztypes.tid} out bool is {
    return (symtab.reg.isNativeOf tid: fid)
}

# emitFnCallWithFid -- the argument work a call shares once its callee is
# known: the parameter lists, the slot each written argument fills, and per
# argument the pointer / byref / borrow-hoist question the parameter's own
# ownership answers. What differs between a generic function, a generic unit's
# method and a cross-unit function is only HOW the callee is found, which is
# each caller's guard.
emitFnCallWithFid: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    fid: ztypes.tid
} out String is {
    fc: ctxCname :ctx tid: fid
    fpNames: List String
    fpIds: ListVal u64
    fpIds9Nm: ListVal u64
    recFieldLists :ast :symtab tid: fid names: fpNames ids: fpIds nameIds: fpIds9Nm
    slots9g: argSlotList :ast :call fpNameIds: fpIds9Nm
    valBySlot9g: (IdMapR u64 V: String)
    ai: u64
    arx439: u64
    for arx439 < call.arguments.count.u64 loop {
        a9Id: zast.kidAt kids: ast.kids span: call.arguments i: arx439
        arx439 = arx439 + 1
        a: ast.nodes.get i: a9Id.u64
        if a.namedoperation then {
            argOpNode: ast.nodes.get i: a.operation.u64
            slot9g: slots9g.get i: ai
            if slot9g < fpNames.length then {
                fpid: fpIds.get i: slot9g
                fpnO: fpNames.get i: slot9g
                iav: (emitInterpArgForParam
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                    :fid
                    pname: fpnO.stringView
                    pid: fpid
                )
                if iav.length > 0 then {
                    valBySlot9g.set key: slot9g value: iav
                } else {
                    atomVarId: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64)
                    avq: (atomVidIfPlain
                        :ast
                        :symtab
                        :ctx
                        n: (ast.nodes.get i: a.operation.u64)
                        text: atomVarId.stringView
                    )
                    byref: false
                    argRef: String
                    ptra: false
                    if (paramIsReceiverName
                        :ast
                        :symtab
                        :fid
                        pname: fpnO.stringView
                    ) then ptra = true
                    if (markedValtypeRefParam
                        :ast
                        :symtab
                        :fid
                        pname: fpnO.stringView
                        pid: fpid
                    ) then ptra = true
                    if (
                        (symtab.typing.declOwnershipIs
                            pool: ast.names
                            parentTypeId: fid
                            name: fpnO.stringView
                            own: ztypes.zparamownership.takeMode
                        ) ==
                        false
                    ) when (isReftypeParam
                        :ast
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: fpid.u64)
                    ) then {
                        ptra = true
                    } else {
                        if (isBorrowStringParam
                            :ast
                            :symtab
                            :ctx
                            :fid
                            pname: fpnO.stringView
                            pid: (ztypes.tid.create from: fpid.u64)
                        ) then ptra = true
                    }
                    if ptra == false then {
                        if (isListPtrParam
                            :ast
                            :symtab
                            :ctx
                            :fid
                            pname: fpnO.stringView
                            tid: (ztypes.tid.create from: fpid.u64)
                        ) then ptra = true
                    }
                    if ptra then {
                        if (
                            (argAlreadyPointer
                                :ast
                                :symtab
                                :ctx
                                n: argOpNode
                                vid: avq
                            ) ==
                            false
                        ) then {
                            byref = true
                            isBorrow92: (hoistExprIsBorrowRooted :ast :symtab :ctx n: argOpNode)
                            argRef = (emitByrefArg
                                :ast
                                :symtab
                                :ctx
                                av: atomVarId.stringView
                                pid: (ztypes.tid.create from: fpid.u64)
                                isBorrow: isBorrow92
                            )
                        }
                    }
                    vbh9x: String
                    if ptra == false then {
                        isBorrow93: (hoistExprIsBorrowRooted :ast :symtab :ctx n: argOpNode)
                        take93: (symtab.typing.declOwnershipIs
                            pool: ast.names
                            parentTypeId: fid
                            name: fpnO.stringView
                            own: ztypes.zparamownership.takeMode
                        )
                        vbh9x = (hoistBorrowValArg
                            :ast
                            :symtab
                            :ctx
                            av: atomVarId.stringView
                            pid: (ztypes.tid.create from: fpid.u64)
                            paramTake: take93
                            isBorrow: isBorrow93
                        )
                    }
                    finalS9g: atomVarId.copy
                    if byref then {
                        finalS9g = argRef.copy
                    } else {
                        if vbh9x.length > 0 then finalS9g = vbh9x.copy
                    }
                    valBySlot9g.set key: slot9g value: finalS9g
                }
            }
            ai = ai + 1
        }
    }
    argTids: String
    emitted9g: u64
    pp9g: u64
    ppn9g: fpNames.length
    for pp9g < ppn9g loop {
        vo9g: valBySlot9g.get key: pp9g
        match (
            vo9g
        ) case some then {
            if emitted9g > 0 then argTids.append ", "
            argTids.append vo9g
            emitted9g = emitted9g + 1
        } case none then null
        pp9g = pp9g + 1
    }
    e: "\{fc}(\{argTids})"
    return e
}

# emitUnitMethodCall -- a generic-unit-instance method call (intmath.add a: 3
# b: 5): the receiver is stamped to a monomorphized UNIT type; the method is a
# concrete FUNCTION child of it. Emit that mono fn's cname applied to the args.

# emitGenericFnCall -- a generic free-function call (identity 42): the callable
# atom is stamped to the mono FUNCTION id by checkGenericCall. Emit that mono's
# cname applied to the args. "" when the callable does not resolve to a mono fn,
# or when the mono's template is NATIVE (no emitted body -- its C comes from a
# name interception like z_stringJoin).
emitGenericFnCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    gdc: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if gdc.length > 0 then return "".string
    gmf: stampIdOf :symtab nid: (interpPartNodeId n: (ast.nodes.get i: call.callable.u64))
    if gmf.isZero then return "".string
    if (symtab.reg.typetypeOf typeId: gmf) != ztypes.ztypetype.functionType then return "".string
    gmo: originTidOf :symtab tid: gmf
    if gmo.isZero then return "".string
    if (fnIsNativeId :symtab fid: gmf) then return "".string
    return (emitFnCallWithFid :ast :symtab :ctx :call fid: gmf)
}

# emitUnitMethodCall -- a generic-unit-instance method call (intmath.add a: 3
# b: 5): the receiver is stamped to a monomorphized UNIT type; the method is a
# concrete FUNCTION child of it. Emit that mono fn's cname applied to the args.
emitUnitMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    rsid: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: call.callable.u64)
    if rsid.isZero then return "".string
    if (symtab.reg.typetypeOf typeId: rsid) != ztypes.ztypetype.unitType then return "".string
    rmo: originTidOf :symtab tid: (ztypes.tid.create from: rsid.u64)
    if rmo.isZero then return "".string
    child: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if child.length == 0 then return "".string
    co: symtab.typing.declChildOf pool: ast.names parentTypeId: rsid name: child
    calleeTid: ztypes.tid
    match (
        co
    ) case some then {
        calleeTid = ztypes.tid.create from: co
    } case none then null
    if calleeTid.isZero then return "".string
    if (
        (symtab.reg.typetypeOf typeId: calleeTid) != ztypes.ztypetype.functionType
    ) then return "".string
    return (emitFnCallWithFid :ast :symtab :ctx :call fid: calleeTid)
}

# dottedMemberTidOf -- the type id a dotted callable's `base.child` names. A
# file-unit base answers through the unit-name index, which also follows
# re-exports; a namespace base is absent from that index by design, so it
# answers off its own type id. 0 when the base names no unit.
dottedMemberTidOf: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    callableId: u32
} out ztypes.tid is {
    baseId: dottedBaseAtomId :ast n: (ast.nodes.get i: callableId.u64)
    childId: aliasChildNameId :ast :symtab n: (ast.nodes.get i: callableId.u64)
    if childId.isZero then return ztypes.tid
    if baseId.isZero == false then {
        if (ztypecheck.isUnitNameDecl st: symtab nameId: baseId) then {
            ud1x: ztypecheck.unitDeclOfName st: symtab nameId: baseId
            go: (ztypecheck.resolvedByIdsRo
                :ast
                st: symtab
                unitDecl: ud1x
                name: childId
            )
            match (
                go
            ) case some then {
                return (ztypes.tid.create from: go)
            } case none then null
            return ztypes.tid
        }
    }
    pb: u32
    {
        cln: ast.nodes.get i: callableId.u64
        if cln.dottedpath then pb = cln.parent
    }
    nst: pathUnitTidOf :ast :symtab :ctx baseId: pb
    if nst.isZero then return ztypes.tid
    co: symtab.typing.declChildOfId parentTypeId: nst nameId: childId
    match (
        co
    ) case some then {
        return (ztypes.tid.create from: co)
    } case none then null
    return ztypes.tid
}

# emitCrossUnitFnCall -- a cross-unit free-function call `unit.fn args`
# (e.g. zparser calling a zast/zlexer helper). The callee is a dottedpath whose
# base is a unit name; the function's shared id lives in resolved["{unit}.{fn}"],
# so emit z_t{id}_{fn}(args) with the same reftype-by-ref arg handling as a bare
# free-function call. "" when the callee is not a cross-unit function.
emitCrossUnitFnCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    fid: dottedMemberTidOf :ast :symtab :ctx callableId: call.callable
    if fid.isZero then return "".string
    if (symtab.reg.typetypeOf typeId: fid) != ztypes.ztypetype.functionType then return "".string
    return (emitFnCallWithFid :ast :symtab :ctx :call :fid)
}

# dottedParentChild -- the middle segment of a 3-segment dotted path `a.b.c`:
# the child text of the parent (`b`). "" when not a nested dotted path.
dottedParentChild: function {ast: Ast.view n: astnode.view} out String is {
    match (
        n
    ) case expression then {
        return (dottedParentChild :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (dottedChildText :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# emitCrossUnitBareCreate -- a bare (no-arg) cross-unit construction
# `unit.Type.create` written as a dotted path (not a call): emit `<Type>_create()`
# (the user create, no receiver). "" when not such a 3-segment bare create.
emitCrossUnitBareCreate: function {
    ctx: Ctx.view
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    parent: astnode.view
    childId: zast.nameid
} out String is {
    if childId != zast.names.wkCreate then return "".string
    pbId: dottedBaseAtomId :ast n: parent
    ptId: dottedChildNameIdOf :ast n: parent
    if pbId.isZero then return "".string
    if ptId.isZero then return "".string
    if (
        (ztypecheck.isUnitNameDecl
            st: symtab
            nameId: pbId
        ) ==
        false
    ) then return "".string
    ud2x: ztypecheck.unitDeclOfName st: symtab nameId: pbId
    go: (ztypecheck.resolvedByIdsRo
        :ast
        st: symtab
        unitDecl: ud2x
        name: ptId
    )
    tid: u64
    match (
        go
    ) case some then {
        tid = go
    } case none then null
    if tid == 0 then return "".string
    cco: (symtab.typing.declChildOfId
        parentTypeId: (ztypes.tid.create from: tid.u64)
        nameId: zast.names.wkCreate
    )
    match (
        cco
    ) case some then {
        if (
            (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: cco.u64)) ==
            ztypes.ztypetype.functionType
        ) then {
            ccb: ctxCname :ctx tid: (ztypes.tid.create from: cco.u64)
            return "\{ccb}()"
        }
    } case none then null
    return "".string
}

# emitCrossUnitExplicitCreate -- an explicit cross-unit construction
# `unit.Type.create args`: resolve `unit.Type` and emit the user `create` call
# `<Type>_create(args)` (no receiver). "" when not such a 3-segment create.
emitCrossUnitExplicitCreate: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    armId: aliasChildNameId :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if armId != zast.names.wkCreate then return "".string
    obId: outerBaseAtomId :ast n: (ast.nodes.get i: call.callable.u64)
    pcId: dottedParentChildId :ast n: (ast.nodes.get i: call.callable.u64)
    if obId.isZero then return "".string
    if pcId.isZero then return "".string
    if (
        (ztypecheck.isUnitNameDecl
            st: symtab
            nameId: obId
        ) ==
        false
    ) then return "".string
    ud3x: ztypecheck.unitDeclOfName st: symtab nameId: obId
    go: (ztypecheck.resolvedByIdsRo
        :ast
        st: symtab
        unitDecl: ud3x
        name: pcId
    )
    tid: ztypes.tid
    match (
        go
    ) case some then {
        tid = ztypes.tid.create from: go
    } case none then null
    if tid.isZero then return "".string
    # a generic template's create resolves through the callable's mono
    # stamp (the constructor leg below); this leg handles concrete types only
    if (isGenericType :symtab :tid) then return "".string
    cco: symtab.typing.declChildOfId parentTypeId: tid nameId: zast.names.wkCreate
    match (
        cco
    ) case some then {
        if (
            (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: cco.u64)) ==
            ztypes.ztypetype.functionType
        ) then {
            cpn: List String
            cpi: ListVal u64
            cpiNm: ListVal u64
            (recFieldLists
                :ast
                :symtab
                tid: (ztypes.tid.create from: cco.u64)
                names: cpn
                ids: cpi
                nameIds: cpiNm
            )
            cargs: String
            ci: u64
            ccn: cpn.length
            for ci < ccn loop {
                cpname: cpn.get i: ci
                cav: ctorArgByLabel :ast :symtab :ctx :call label: cpname.stringView
                if ci > 0 then cargs.append ", "
                cargs.append cav
                ci = ci + 1
            }
            ccBody: false
            {
                ccrn: symtab.typing.funcReturnNode.get key: cco
                match (
                    ccrn
                ) case some then {
                    ccBody = true
                } case none then null
            }
            if ccBody then {
                ccb: ctxCname :ctx tid: (ztypes.tid.create from: cco.u64)
                return "\{ccb}(\{cargs})"
            }
            fwcb: ctxCname :ctx :tid
            return "\{fwcb}_create(\{cargs})"
        }
    } case none then null
    return "".string
}

# outerBaseAtomId -- the interned name id of outerBaseAtom's leftmost atom.
outerBaseAtomId: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    match (
        n
    ) case expression then {
        return (outerBaseAtomId :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (dottedBaseAtomId :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}

# outerBaseAtom -- the leftmost atom of a LEFT-nested three-segment
# dotted path `(a.B).c`: "a". "" for shallower shapes.
outerBaseAtom: function {ast: Ast.view n: astnode.view} out String is {
    match (
        n
    ) case expression then {
        return (outerBaseAtom :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (dottedBaseAtom :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# emitCrossUnitSumCtor -- a three-segment qualified sum-arm construction
# (`json.Value.text s`, `zvfs.dentry.file d`): the in-unit form resolves the
# type by bare name, so the qualified middle segment needs its own leg,
# resolved through the defining unit's key like the create legs. A variant is
# a valtype and carries its payload inline; only a union boxes one.
emitCrossUnitSumCtor: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    obId: outerBaseAtomId :ast n: (ast.nodes.get i: call.callable.u64)
    pcId: dottedParentChildId :ast n: (ast.nodes.get i: call.callable.u64)
    if obId.isZero then return "".string
    if pcId.isZero then return "".string
    if (
        (ztypecheck.isUnitNameDecl
            st: symtab
            nameId: obId
        ) ==
        false
    ) then return "".string
    ctorArmName: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if ctorArmName.length == 0 then return "".string
    if ctorArmName == "create" then return "".string
    if ctorArmName == "borrow" then return "".string
    ud4x: ztypecheck.unitDeclOfName st: symtab nameId: obId
    go: (ztypecheck.resolvedByIdsRo
        :ast
        st: symtab
        unitDecl: ud4x
        name: pcId
    )
    utid: ztypes.tid
    match (
        go
    ) case some then {
        utid = ztypes.tid.create from: go
    } case none then null
    if utid.isZero then return "".string
    ttx: symtab.reg.typetypeOf typeId: utid
    if ttx == ztypes.ztypetype.variantType then return (emitInlineVariantCtor
        :ast
        :symtab
        :ctx
        :call
        tid: utid
        arm: ctorArmName
    )
    if ttx != ztypes.ztypetype.unionType then return "".string
    vc: ctxCname :ctx tid: (ztypes.tid.create from: utid.u64)
    tg: variantTag :symtab tid: (ztypes.tid.create from: utid.u64) arm: ctorArmName
    payC: (armPayloadC
        :ast
        :symtab
        :ctx
        tid: (ztypes.tid.create from: utid.u64)
        arm: ctorArmName
    )
    if payC.length > 0 then {
        av: String
        got: false
        arx449: u64
        for arx449 < call.arguments.count.u64 loop {
            aId: zast.kidAt kids: ast.kids span: call.arguments i: arx449
            arx449 = arx449 + 1
            a: ast.nodes.get i: aId.u64
            if a.namedoperation then {
                if got == false then {
                    got = true
                    aOpNode: ast.nodes.get i: a.operation.u64
                    av = emitInterpArgExpr :ast :symtab :ctx n: aOpNode
                    if av.length == 0 then {
                        aOpNode: ast.nodes.get i: a.operation.u64
                        av = emitExpr :ast :symtab :ctx n: aOpNode
                    }
                }
            }
        }
        e: "({ \{vc}_t _u = {0}; _u.tag = \{tg}; \{payC}* _b = (\{payC}*)z_xmalloc(sizeof(\{payC})); *_b = \{av}; _u.data = _b; _u; })"
        return e
    } else {
        e2: "({ \{vc}_t _u = {0}; _u.tag = \{tg}; _u.data = NULL; _u; })"
        return e2
    }
}

# emitCrossUnitCtor -- construction of a cross-unit record/class
# `unit.TypeName field: val ...` (e.g. a astnode arm's zast.ErrorData payload):
# resolve the type via the shared cross-unit identity and route to the field-wise
# (or user-create) constructor. "" when not such a construction.
emitCrossUnitCtor: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    tid: dottedMemberTidOf :ast :symtab :ctx callableId: call.callable
    if tid.isZero then return "".string
    tt: symtab.reg.typetypeOf typeId: tid
    isRc: false
    if tt == ztypes.ztypetype.recordType then isRc = true
    if tt == ztypes.ztypetype.classType then isRc = true
    if isRc == false then return "".string
    return (emitRecordCtor :ast :symtab :ctx :call :tid)
}

# emitCrossUnitTag -- a 3-segment cross-unit variant/enum tag value
# `unit.Type.arm` (zlexer.toktype.dotTok, zast.err.badReference): pbase=unit, ptype=Type,
# arm=arm. Resolve the variant via the shared cross-unit identity and emit the
# no-payload tag value. "" when not such a reference.
emitCrossUnitTag: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    pbase: StringView
    ptype: StringView
    arm: StringView
} out String is {
    if pbase.length == 0 then return "".string
    if ptype.length == 0 then return "".string
    if arm.length == 0 then return "".string
    unm: (zast.poolFind
        pool: ast.names
        text: pbase
    )
    if (
        (ztypecheck.isUnitNameDecl
            st: symtab
            nameId: unm
        ) ==
        false
    ) then return "".string
    ud5x: ztypecheck.unitDeclOfName st: symtab nameId: unm
    go: (ztypecheck.resolvedByIdsRo
        :ast
        st: symtab
        unitDecl: ud5x
        name: (zast.poolFind pool: ast.names text: ptype)
    )
    vtid: ztypes.tid
    match (
        go
    ) case some then {
        vtid = ztypes.tid.create from: go
    } case none then null
    if vtid.isZero then return "".string
    vtt: symtab.reg.typetypeOf typeId: vtid
    isTagged: false
    if vtt == ztypes.ztypetype.variantType then isTagged = true
    if vtt == ztypes.ztypetype.unionType then isTagged = true
    if isTagged == false then return "".string
    pc: armPayloadC :ast :symtab :ctx tid: (ztypes.tid.create from: vtid.u64) :arm
    if pc.length == 0 then {
        tg: variantTag :symtab tid: (ztypes.tid.create from: vtid.u64) :arm
        vc: ctxCname :ctx tid: (ztypes.tid.create from: vtid.u64)
        avx: (armValueC
            :symtab
            tid: (ztypes.tid.create from: vtid.u64)
            :arm
        )
        if avx.length > 0 then return avx
        e: "((\{vc}_t){ .tag = \{tg} })"
        return e
    }
    return "".string
}

# emitFnptrFieldCall -- a call through a record/class fnptr field
# (`c.op a: 100 b: 200` -> `c.op(100, 200)`). "" when the callee member is not
# a flagged fnptr field. Explicit args only (slot params carry no `this`).
emitFnptrFieldCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if mn.length == 0 then return "".string
    rtid0: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: call.callable.u64)
    rtid: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: rtid0.u64)
    if rtid.isZero then return "".string
    if (
        (symtab.typing.declIsFnptrField
            pool: ast.names
            parentTypeId: rtid
            name: mn
        ) ==
        false
    ) then return "".string
    callableNode: ast.nodes.get i: call.callable.u64
    recvExpr: emitDottedReceiver :ast :symtab :ctx callable: callableNode
    if recvExpr.length == 0 then return "".string
    rptr: dottedReceiverIsPtr :ast :symtab :ctx callable: (ast.nodes.get i: call.callable.u64)
    acc: ".".string
    if rptr then acc = "->".string
    # the slot's own parameter list decides how each argument is passed:
    # fnptrParamTypeC pointerizes a param exactly when paramTypeIsPointer does,
    # and a receiver-typed param (`r: this` on a record) is one of those.
    fnTid: ztypes.tid
    {
        mnId: zast.poolFind pool: ast.names text: mn
        if mnId > 0 then {
            fnTid = (ztypes.tid.create
                from: ((symtab.typing.declChildOfId parentTypeId: rtid nameId: mnId).or d: 0)
            )
        }
    }
    pNames: List String
    pIds: ListVal u64
    pNmIds: ListVal u64
    if fnTid > 0 then {
        recFieldLists :ast :symtab tid: fnTid names: pNames ids: pIds nameIds: pNmIds
    }
    args: String
    ai: u64
    arx459: u64
    for arx459 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx459
        arx459 = arx459 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            av: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64)
            addr: false
            {
                anm: zast.nameTextAt :ast ref: a.name
                pj: u64
                pjn: pNames.length
                for pj < pjn loop {
                    pnm: pNames.get i: pj
                    if pnm.stringView == anm.stringView then {
                        if (paramTypeIsPointer
                            :ast
                            :symtab
                            :ctx
                            fid: fnTid
                            pname: anm.stringView
                            pid: (ztypes.tid.create from: (pIds.get i: pj))
                        ) then addr = true
                    }
                    pj = pj + 1
                }
            }
            # an argument that already holds a pointer must not be addressed
            # again -- the same guard the reftype/List param sweep uses
            if addr when (pathIsPointer
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: a.operation.u64)
            ) then addr = false
            if ai > 0 then args.append ", "
            if addr then args.append "&"
            args.append av
            ai = ai + 1
        }
    }
    mnFfP: memberCPrefix name: mn
    r: "\{recvExpr}\{acc}\{mnFfP}\{mn}(\{args})"
    return r
}

# emitFnptrLocalCall -- a call through a bare local/param of FUNCTION type
# (`cb a: 5 b: 7` -> `cb(5, 7)`, `f a: a b: b` -> `f(a, b)`). "" unless the
# callee is a bare atom whose stamped type is a FUNCTION (and not a top-level fn).
emitFnptrLocalCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    fid: ztypes.tid
    cn0: StringView
    cnVid: ztypes.vid
} out String is {
    if fid > 0 then return "".string
    dct: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if dct.length > 0 then return "".string
    cnid: interpPartNodeId n: (ast.nodes.get i: call.callable.u64)
    cTid: stampIdOf :symtab nid: cnid
    if cTid.isZero then return "".string
    if (symtab.reg.typetypeOf typeId: cTid) != ztypes.ztypetype.functionType then return "".string
    stn: regNameOf :symtab tid: cTid
    if stn.stringView == cn0 then return "".string
    fcm: varCName :ctx vid: cnVid name: cn0
    # THE SLOT'S OWN PARAMETER LIST DECIDES HOW EACH ARGUMENT IS PASSED, the
    # same question emitFnptrFieldCall asks of a fn-pointer FIELD. It matters
    # here as soon as an unbound METHOD reference can reach a local: a receiver
    # parameter is a pointer in both type families, so `f this: a rhs: 5`
    # emitted `z_v4(z_v3, 5)` and passed the receiver by value into a `z_t12_t*`.
    pNames: List String
    pIds: ListVal u64
    pNmIds: ListVal u64
    recFieldLists :ast :symtab tid: cTid names: pNames ids: pIds nameIds: pNmIds
    args: String
    ai: u64
    arx469: u64
    for arx469 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx469
        arx469 = arx469 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            av: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64)
            addr: false
            {
                anm: zast.nameTextAt :ast ref: a.name
                pj: u64
                pjn: pNames.length
                for pj < pjn loop {
                    pnm: pNames.get i: pj
                    if pnm.stringView == anm.stringView then {
                        if (paramTypeIsPointer
                            :ast
                            :symtab
                            :ctx
                            fid: cTid
                            pname: anm.stringView
                            pid: (ztypes.tid.create from: (pIds.get i: pj))
                        ) then addr = true
                    }
                    pj = pj + 1
                }
            }
            # an argument that already holds a pointer must not be addressed
            # again -- the same guard the field-call sweep uses
            if addr when (pathIsPointer
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: a.operation.u64)
            ) then addr = false
            if ai > 0 then args.append ", "
            if addr then args.append "&"
            args.append av
            ai = ai + 1
        }
    }
    r: "\{fcm}(\{args})"
    return r
}

# emit a call used as a value (its result expression).

# conformanceArgText -- a concrete class/record argument handed to a
# protocol / facet parameter goes in as its conformance box: the impl's
# `<cname>_<label>_create(&arg)`. "" when the parameter is no spec or the
# argument no conforming concrete type.
conformanceArgText: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    argOpNode: astnode.view
    av: StringView
    avVid: ztypes.vid
    protoTid: u64
} out String is {
    pptt: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: protoTid.u64)
    isProtoP: false
    if pptt == ztypes.ztypetype.protocolType then isProtoP = true
    if pptt == ztypes.ztypetype.facetType then isProtoP = true
    if isProtoP == false then return "".string
    aTid: stampIdOf :symtab nid: (interpPartNodeId n: argOpNode)
    aTT: symtab.reg.typetypeOf typeId: aTid
    aConc: false
    if aTT == ztypes.ztypetype.classType then aConc = true
    if aTT == ztypes.ztypetype.recordType then aConc = true
    if aConc == false then return "".string
    pLbl: conformanceLabelFor :symtab implTid: aTid :protoTid
    if pLbl.length == 0 then return "".string
    aIb: ctxCname :ctx tid: aTid
    aRcv: "&\{av}"
    if (isPtrVid :ctx vid: avVid) then aRcv = "\{av}"
    return "\{aIb}_\{pLbl}_create(\{aRcv})"
}

# userFnParamByPointer -- a user function's parameter takes its argument by
# pointer: the receiver (in both families), a marked valtype reference, an
# unowned reftype, a borrowed String, a List.
userFnParamByPointer: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    fid: ztypes.tid
    pname: StringView
    pid: u64
    take: bool
} out bool is {
    # The receiver is a pointer in both families, so a value-typed one still
    # needs `&`. Only this leg is added, not the whole definition-side
    # predicate: a Map/Set argument is already a pointer here and must not
    # be addressed again.
    if (paramIsReceiverName :ast :symtab :fid :pname) then return true
    if (markedValtypeRefParam :ast :symtab :fid :pname :pid) then return true
    if take == false when (isReftypeParam
        :ast
        :symtab
        :ctx
        tid: (ztypes.tid.create from: pid.u64)
    ) then return true
    if (isBorrowStringParam
        :ast
        :symtab
        :ctx
        :fid
        :pname
        pid: (ztypes.tid.create from: pid.u64)
    ) then return true
    return (isListPtrParam :ast :symtab :ctx :fid :pname tid: (ztypes.tid.create from: pid.u64))
}

# userFnArgText -- the C text of one argument of a user-function call, for
# the parameter it binds: the interpolation / conformance projections, then
# the by-reference or borrow hoist the parameter's mode asks for.
userFnArgText: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    fid: ztypes.tid
    pinId: u64
    pinNm: StringView
    argOpNode: astnode.view
} out String is {
    iavb: (emitInterpArgForParam
        :ast
        :symtab
        :ctx
        n: argOpNode
        :fid
        pname: pinNm
        pid: pinId
    )
    atomVarId: String
    projd: false
    if iavb.length > 0 then {
        atomVarId = iavb
        projd = true
    } else {
        atomVarId = emitExpr :ast :symtab :ctx n: argOpNode
    }
    avq: (atomVidIfPlain
        :ast
        :symtab
        :ctx
        n: argOpNode
        text: atomVarId.stringView
    )
    ppid: pinId
    {
        spec: (conformanceArgText
            :symtab
            :ctx
            :argOpNode
            av: atomVarId.stringView
            avVid: avq
            protoTid: ppid
        )
        if spec.length > 0 then {
            atomVarId = spec
            projd = true
        }
    }
    if projd then return atomVarId
    # the parameter's mode: by pointer (addressed unless already one), or a
    # borrow hoist of the value
    pTake8: (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pinNm
        own: ztypes.zparamownership.takeMode
    )
    isBorrowed: hoistExprIsBorrowRooted :ast :symtab :ctx n: argOpNode
    if (userFnParamByPointer :ast :symtab :ctx :fid pname: pinNm pid: pinId take: pTake8) then {
        if (argAlreadyPointer :ast :symtab :ctx n: argOpNode vid: avq) then return atomVarId
        return (emitByrefArg
            :ast
            :symtab
            :ctx
            av: atomVarId.stringView
            pid: (ztypes.tid.create from: pinId.u64)
            isBorrow: isBorrowed
        )
    }
    vbh8: (hoistBorrowValArg
        :ast
        :symtab
        :ctx
        av: atomVarId.stringView
        pid: (ztypes.tid.create from: pinId.u64)
        paramTake: pTake8
        isBorrow: isBorrowed
    )
    if vbh8.length > 0 then return vbh8
    return atomVarId
}

# emitUserFnCall -- a call of a user-declared function `fid` (a free function
# or a static method reached by its own id): its C name applied to the
# arguments in parameter order, defaults rendered for the omitted ones.
emitUserFnCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    fid: ztypes.tid
} out String is {
    fc: ctxCname :ctx tid: fid
    fpIds: ListVal u64
    fpIdsNm: ListVal u64
    recFieldIds :symtab tid: fid ids: fpIds nameIds: fpIdsNm
    slots: argSlotList :ast :call fpNameIds: fpIdsNm
    valBySlot: (IdMapR u64 V: String)
    ai8: u64
    arx479: u64
    for arx479 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx479
        arx479 = arx479 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            argOpNode: ast.nodes.get i: a.operation.u64
            slot9b: slots.get i: ai8
            if slot9b < fpIdsNm.length then {
                pinNmB: (zast.poolTextAt
                    pool: ast.names
                    ref: (zast.nameid.create from: (fpIdsNm.get i: slot9b))
                )
                valBySlot.set key: slot9b value: (userFnArgText
                    :ast
                    :symtab
                    :ctx
                    :fid
                    pinId: (fpIds.get i: slot9b)
                    pinNm: pinNmB.stringView
                    :argOpNode
                )
            }
            ai8 = ai8 + 1
        }
    }
    args: String
    emitted: u64
    pp: u64
    ppn: fpIdsNm.length
    for pp < ppn loop {
        vo: valBySlot.get key: pp
        match (
            vo
        ) case some then {
            if emitted > 0 then args.append ", "
            args.append vo
            emitted = emitted + 1
        } case none then {
            pdpn9Id: fpIdsNm.get i: pp
            if (symtab.typing.declHasDefaultId
                parentTypeId: fid
                nameId: (zast.nameid.create from: pdpn9Id.u32.orPanic)
            ) then {
                pddt: (symtab.typing.declDefaultOfId
                    parentTypeId: fid
                    nameId: (zast.nameid.create from: pdpn9Id.u32.orPanic)
                )
                pdpid: fpIds.get i: pp
                pdrv: (renderDefault
                    :ast
                    :symtab
                    :ctx
                    dv: pddt
                    targetTid: (ztypes.tid.create from: pdpid.u64)
                )
                if emitted > 0 then args.append ", "
                args.append pdrv
                emitted = emitted + 1
            }
        }
        pp = pp + 1
    }
    e8: "\{fc}(\{args})"
    return e8
}

# emitNamedCalleeChain -- the probe legs that need the callee's NAME or its resolved
# function id: the constructor shapes, the user function call, and the fn-pointer
# local. The name is consulted only after the checker's stamps have declined, and
# never for a callee the checker stamped as a local.
emitNamedCalleeChain: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    cn0: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: call.callable.u64))
    ecc: emitEmptyColCreate :ast :symtab :ctx :call cn0: cn0.stringView
    if ecc.length > 0 then return ecc
    # The callee's identity comes from the checker's stamps, never from
    # re-resolving the name: a fn-typed LOCAL may legitimately shadow a
    # function of the same name (`addit: mulit.take` inside a unit that also
    # declares `addit`), and the name route would then emit a direct call to
    # the function the local shadows -- silently, with the wrong answer. A
    # variable id stamped on the callable atom says "this is a local", which
    # is the fnptr leg's business. Same precedence implicitTakeSourceAtom
    # keeps for the same reason.
    cbn0: atomNodeId n: (ast.nodes.get i: call.callable.u64)
    calleeIsLocal: false
    if cbn0 > 0 when (symtab.typing.atomVariableId.has key: cbn0) then calleeIsLocal = true
    if (symtab.typing.atomVariableId.has key: call.callable.u64) then calleeIsLocal = true
    fid: ztypes.tid
    if calleeIsLocal == false then fid = userFnId :ast :symtab :ctx name: cn0.stringView
    if fid.isZero then {
        # the name route reads the FILE unit's members; a callee the checker
        # resolved in the scope the call was written in -- a namespace's
        # sibling function -- is not among them, but the callable atom carries
        # its id: the checker stamps a resolved unit FUNCTION on the callable
        # (a fn-typed LOCAL stamps its variable id instead, and stays with
        # the fnptr leg below)
        cbn: atomNodeId n: (ast.nodes.get i: call.callable.u64)
        if cbn > 0 then {
            clv: symtab.typing.atomVariableId.get key: cbn
            match (
                clv
            ) case some then null case none then {
                cst: monoStampIdOf :symtab :ctx nid: cbn
                if cst.isZero then cst = stampIdOf :symtab nid: cbn
                if cst > 0 then {
                    if (
                        (symtab.reg.typetypeOf typeId: cst) == ztypes.ztypetype.functionType
                    ) then fid = cst
                }
            }
        }
    }
    # a native fn (or generic native template) never takes the resolved-cname
    # route; zeroing routes it to the name interceptions below.
    if fid > 0 when (fnIsNativeId :symtab :fid) then fid = ztypes.tid.create from: 0
    ctorTid: fid
    if fid > 0 when (isGenericType :symtab tid: fid) then {
        gmid: stampIdOf :symtab nid: call.nodeid.u64
        if gmid > 0 then ctorTid = gmid
    }
    # parenthesized generic-type-application construction `(sized t: i64 size: 10)
    # val: 42`: the callable is a stamped Call/Expression (cn0 empty, fid 0), so
    # resolve the mono from the callable-node stamp and construct it.
    if fid.isZero then {
        cstid: stampIdOf :symtab nid: (interpPartNodeId n: (ast.nodes.get i: call.callable.u64))
        cstOrig: originTidOf :symtab tid: cstid
        if cstid > 0 when cstOrig > 0 then {
            cstt: symtab.reg.typetypeOf typeId: cstid
            cstOk: false
            if cstt == ztypes.ztypetype.recordType then cstOk = true
            if cstt == ztypes.ztypetype.classType then cstOk = true
            if cstOk then ctorTid = cstid
        }
    }
    if ctorTid > 0 when (
        (symtab.reg.typetypeOf typeId: ctorTid) == ztypes.ztypetype.recordType
    ) then {
        return (emitRecordCtor :ast :symtab :ctx :call tid: ctorTid)
    }
    if ctorTid > 0 when (symtab.reg.typetypeOf typeId: ctorTid) == ztypes.ztypetype.classType then {
        return (emitRecordCtor :ast :symtab :ctx :call tid: ctorTid)
    }
    iwc: emitIoWrapperCreate :ast :symtab :ctx :call
    if iwc.length > 0 then return iwc
    xcc: emitCrossUnitExplicitCreate :ast :symtab :ctx :call
    if xcc.length > 0 then return xcc
    tq: emitTypeQualCall :ast :symtab :ctx :call
    if tq.length > 0 then return tq
    fpfc: emitFnptrFieldCall :ast :symtab :ctx :call
    if fpfc.length > 0 then return fpfc
    if fid > 0 then return (emitUserFnCall :ast :symtab :ctx :call :fid)
    if cn0.stringView == "stringJoin" then {
        needsAddM :ctx uname: "collections" memb: "coll_join"
        sjargs: String
        sji: u64
        arx489: u64
        for arx489 < call.arguments.count.u64 loop {
            sja9Id: zast.kidAt kids: ast.kids span: call.arguments i: arx489
            arx489 = arx489 + 1
            sja: ast.nodes.get i: sja9Id.u64
            if sja.namedoperation then {
                if sji > 0 then sjargs.append ", "
                sjn: ast.nodes.get i: sja.operation.u64
                sjv: emitExpr :ast :symtab :ctx n: sjn
                sjq: atomVidIfPlain :ast :symtab :ctx n: sjn text: sjv.stringView
                if sji == 0 when (isPtrVid :ctx vid: sjq) == false then sjargs.append "&"
                sjIsStr: false
                if sji > 0 then {
                    sjat: (stampIdOf
                        :symtab
                        nid: (interpPartNodeId n: (ast.nodes.get i: sja.operation.u64))
                    )
                    if sjat == ctx.strTid then sjIsStr = true
                }
                if sjIsStr then {
                    sjsv: svValueForm :ctx expr: sjv.stringView isStr: true vid: sjq
                    sjargs.append sjsv
                } else {
                    sjargs.append sjv
                }
                sji = sji + 1
            }
        }
        return "z_stringJoin(\{sjargs})"
    }
    cnV: atomVid :symtab nid: (atomNodeId n: (ast.nodes.get i: call.callable.u64))
    fplc: (emitFnptrLocalCall
        :ast
        :symtab
        :ctx
        :call
        :fid
        cn0: cn0.stringView
        cnVid: cnV
    )
    if fplc.length > 0 then return fplc
    # AN OPERATOR IS THE SAME METHOD IN EITHER FORM. `a + b` and `a.+ rhs: b`
    # resolve to one declaration, and the infix form has emitted through the
    # natives.tbl leg since the single-source arc. A user-declared operator
    # already worked both ways -- its body is an ordinary method the dotted-call
    # legs above reach -- but a NATIVE one is nobody's dispatcher to emit, so
    # the call form arrived here.
    opc: emitOperatorCallForm :ast :symtab :ctx :call
    if opc.length > 0 then return opc
    # a numeric range asked for as a VALUE rather than driven by a for-header
    sic: emitScalarIterateCall :ast :symtab :ctx :call
    if sic.length > 0 then return sic
    # a yield hoisted out of expression position: the suspension has already
    # run as its own statement and left the resume value in a temp, so what is
    # left here is a plain read
    yk: ctx.yieldTempK.get key: call.nodeid.u64
    match (
        yk
    ) case some then {
        ytn: "\{ctx.genRecvC}->_yv_\{yk}"
        return ytn
    } case none then null
    # a yield the hoist declined -- a second one in the same expression, or one
    # inside a condition, where lifting the suspension would either lose the
    # temp across a return or run it on a path not taken. It is the same
    # fallback leg, so it says which construct rather than blaming the callee.
    what8: "unhandled callee \{cn0}"
    if (zast.isYieldCalleeAt :ast callableId: call.callable) then {
        what8 = "this `yield` is not split out of its expression; bind it first (`v: yield e`) and use `v`".string
    }
    emitFail :ctx what: what8 line: call.lineno
    m8: "/* zemitterc: \{what8} */0"
    return m8
}

# emitCallProbeChain -- the residual probe chain: every handler that the stamped
# routes above did not claim, asked in order until one answers. It retires leg by
# leg as each becomes reachable from a callKind arm instead.
emitCallProbeChain: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    mcc: emitMetaCreateCall :ast :symtab :ctx :call
    if mcc.length > 0 then return mcc
    fmc: emitFileMethodCall :ast :symtab :ctx :call
    if fmc.length > 0 then return fmc
    clisc: emitCliSpecCreate :ast :symtab :ctx :call
    if clisc.length > 0 then return clisc
    rcc: emitResultCombinator :ast :symtab :ctx :call
    if rcc.length > 0 then return rcc
    pmc: emitParsedMethodCall :ast :symtab :ctx :call
    if pmc.length > 0 then return pmc
    scv: emitStrConvCall :ast :symtab :ctx :call
    if scv.length > 0 then return scv
    dc: emitDottedCall :ast :symtab :ctx :call
    if dc.length > 0 then return dc
    umc: emitUnitMethodCall :ast :symtab :ctx :call
    if umc.length > 0 then return umc
    gfc: emitGenericFnCall :ast :symtab :ctx :call
    if gfc.length > 0 then return gfc
    xuc: emitCrossUnitSumCtor :ast :symtab :ctx :call
    if xuc.length > 0 then return xuc
    ddq: emitDataIndexCall :ast :symtab :ctx :call
    if ddq.length > 0 then return ddq
    cufc: emitCrossUnitFnCall :ast :symtab :ctx :call
    if cufc.length > 0 then return cufc
    cuct: emitCrossUnitCtor :ast :symtab :ctx :call
    if cuct.length > 0 then return cuct
    return (emitNamedCalleeChain :ast :symtab :ctx :call)
}

# emitCallByDecl -- route by the callee's DECLARATION: its kind and its owner's
# family name the handler outright, with no name lookup and no probe. The owner of
# a native collection's method is the TEMPLATE (a mono's methods are the
# template's), so its family is its own id.
emitCallByDecl: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    # route by the callee's DECLARATION: its kind and its owner's family
    # name the handler outright
    rdo: symtab.typing.refDecl.get key: call.callable.u64
    match (
        rdo
    ) case some then {
        rdecl: symtab.typing.decls.get i: rdo.u64
        rkind: rdecl.kind
        rtid: rdecl.typeId
        ownerTid: ztypes.tid
        if rdecl.parent.isZero == false then ownerTid = (symtab.typing.decls.get i: rdecl.parent.u64
        ).typeId
        if rkind.methodDecl when ownerTid.isZero == false then {
            # the owner is the TEMPLATE for a native collection's method (the
            # mono's methods are the template's); its family is its own id
            ownerFam: originTidOf :symtab tid: ownerTid
            if ownerFam.isZero then ownerFam = ownerTid
            isCol: false
            if ownerFam == (ctx.origins.get i: ogList) then isCol = true
            if ownerFam == (ctx.origins.get i: ogListVal) then isCol = true
            if ownerFam == (ctx.origins.get i: ogListView) then isCol = true
            if ownerFam == (ctx.origins.get i: ogListViewVal) then isCol = true
            if ownerFam == (ctx.origins.get i: ogSet) then isCol = true
            if ownerFam == (ctx.origins.get i: ogSetVal) then isCol = true
            if ownerFam == (ctx.origins.get i: ogMap) then isCol = true
            if ownerFam == (ctx.origins.get i: ogMapRV) then isCol = true
            if ownerFam == (ctx.origins.get i: ogMapVR) then isCol = true
            if ownerFam == (ctx.origins.get i: ogMapVV) then isCol = true
            if ownerFam == (ctx.origins.get i: ogIdMapR) then isCol = true
            if ownerFam == (ctx.origins.get i: ogIdMapV) then isCol = true
            if ownerFam == (ctx.origins.get i: ogIdSet) then isCol = true
            if ownerFam == (ctx.origins.get i: ogArray) then isCol = true
            if isCol then {
                rcol: emitCollectionMethodCall :ast :symtab :ctx :call
                if rcol.length > 0 then return rcol
            }
            if ownerTid == ctx.strTid then {
                rsa: emitStringArgMethod :ast :symtab :ctx :call
                if rsa.length > 0 then return rsa
                rsd: emitDottedCall :ast :symtab :ctx :call
                if rsd.length > 0 then return rsd
            }
            if ownerTid == ctx.svTid then {
                rsv: emitDottedCall :ast :symtab :ctx :call
                if rsv.length > 0 then return rsv
            }
            # a native that takes arguments answers from its own row, before
            # the receiver-only and operator legs get a chance to not know it
            rnam: emitNativeArgMethod :ast :symtab :ctx :call :ownerTid
            if rnam.length > 0 then return rnam
            ott: symtab.reg.typetypeOf typeId: ownerTid
            isSpec: false
            if ott == ztypes.ztypetype.protocolType then isSpec = true
            if ott == ztypes.ztypetype.facetType then isSpec = true
            if isSpec then {
                rpd: emitProtocolDispatch :ast :symtab :ctx :call
                if rpd.length > 0 then return rpd
            }
            isIoNat: false
            if ownerTid.u64 == ctx.ioFileTid then isIoNat = true
            if ownerTid.u64 == ctx.netListenerTid then isIoNat = true
            if ownerTid.u64 == ctx.netConnTid then isIoNat = true
            isCreate: (zast.nameid.create from: rdecl.name) == zast.names.wkCreate
            if (symtab.reg.isNativeOf tid: ownerTid) == false when isSpec == false when (
                isIoNat == false
            ) when isCreate == false then {
                ruic: emitUserIterCall :ast :symtab :ctx :call
                if ruic.length > 0 then return ruic
                rtq: emitTypeQualCall :ast :symtab :ctx :call
                if rtq.length > 0 then return rtq
                if rdecl.fnptrField then {
                    rfp: emitFnptrFieldCall :ast :symtab :ctx :call
                    if rfp.length > 0 then return rfp
                }
                rim: emitInstanceMethodCall :ast :symtab :ctx :call
                if rim.length > 0 then return rim
            }
        }
        if rkind.funcDecl then {
            if rtid > 0 when (symtab.reg.isNativeOf tid: rtid) then {
                rnf: emitNativeFreeFnCall :ast :symtab :ctx :call
                if rnf.length > 0 then return rnf
            } else {
                if rtid > 0 when (isGenericType :symtab tid: rtid) then {
                    rgf: emitGenericFnCall :ast :symtab :ctx :call
                    if rgf.length > 0 then return rgf
                }
                rcu: emitCrossUnitFnCall :ast :symtab :ctx :call
                if rcu.length > 0 then return rcu
                # a bare call of a function declared in the unit at hand; a
                # fn-typed LOCAL's atom carries its variable id and calls
                # through the pointer instead
                if rtid > 0 when (isGenericType :symtab tid: rtid) == false then {
                    rcal: ast.nodes.get i: call.callable.u64
                    if rcal.atomid when (
                        (symtab.typing.atomVariableId.has key: call.callable.u64) == false
                    ) then {
                        # inside a template instance's body the sibling is the
                        # instance's own function, on the per-mono stamp
                        mfid: monoStampIdOf :symtab :ctx nid: call.callable.u64
                        if mfid.isZero then mfid = rtid
                        return (emitUserFnCall :ast :symtab :ctx :call fid: mfid)
                    }
                }
            }
        }
        if rkind.armDecl then {
            rvc: emitVariantCtorCall :ast :symtab :ctx :call
            if rvc.length > 0 then return rvc
            ruc: emitUnionCtor :ast :symtab :ctx :call
            if ruc.length > 0 then return ruc
        }
        if rkind.typeDecl then {
            rxc: emitCrossUnitCtor :ast :symtab :ctx :call
            if rxc.length > 0 then return rxc
        }
    } case none then null
    return "".string
}

# emitCallValue -- the C expression for a call (the dispatch chain:
# dotted/list/typedef/data/record-ctor/type-qual/variant/user-fn).
# Shared by emitExpr's call arm and the statement-position call leg
# so neither clones the node (clones lose the type stamps).
emitCallValue: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    # stamped-kind dispatch head: a call whose kind names its owning handler
    # routes there directly; an empty result or an unstamped / chain-owned
    # kind falls through to the probe chain below.
    ckh: symtab.typing.callKind.get key: call.nodeid.u64
    match (
        ckh
    ) case some then {
        isTdk: false
        if ckh == zast.callkind.typedefCreate then isTdk = true
        if ckh == zast.callkind.typedefBorrow then isTdk = true
        if isTdk then {
            tdh: emitTypedefCreateCall :ast :symtab :ctx :call
            if tdh.length > 0 then return tdh
        }
        if ckh == zast.callkind.boxCreate then {
            bxh: emitBoxCreate :ast :symtab :ctx :call
            if bxh.length > 0 then return bxh
        }
        isPjk: false
        if ckh == zast.callkind.protocolCreate then isPjk = true
        if ckh == zast.callkind.protocolBorrow then isPjk = true
        if ckh == zast.callkind.facetCreate then isPjk = true
        if ckh == zast.callkind.facetBorrow then isPjk = true
        if isPjk then {
            pch: emitProtocolCreateCall :ast :symtab :ctx :call
            if pch.length > 0 then return pch
        }
    } case none then null
    # A SYNTHESISED OPERATOR HAS NO BODY TO CALL, so it must reach the
    # structural emitter before the by-decl leg claims it as an ordinary method.
    sopc: emitSynthOperatorCallForm :ast :symtab :ctx :call
    if sopc.length > 0 then return sopc
    cbd: emitCallByDecl :ast :symtab :ctx :call
    if cbd.length > 0 then return cbd
    # a construction by bare type name: the call's type is the type built
    match (
        ckh
    ) case some then {
        isCtorKind: false
        if ckh == zast.callkind.recordCreate then isCtorKind = true
        if ckh == zast.callkind.classCreate then isCtorKind = true
        if isCtorKind then {
            ccal: ast.nodes.get i: call.callable.u64
            if ccal.atomid when (symtab.typing.refDecl.has key: call.callable.u64) == false then {
                ctid: stampIdOf :symtab nid: call.nodeid.u64
                cnm: (zast.nameTextAt
                    :ast
                    ref: (atomNameIdOf :ast n: (ast.nodes.get i: call.callable.u64))
                )
                cec: emitEmptyColCreate :ast :symtab :ctx :call cn0: cnm.stringView
                if cec.length > 0 then return cec
                ctt: symtab.reg.typetypeOf typeId: ctid
                if ctt == ztypes.ztypetype.recordType then return (emitRecordCtor
                    :ast
                    :symtab
                    :ctx
                    :call
                    tid: ctid
                )
                if ctt == ztypes.ztypetype.classType then return (emitRecordCtor
                    :ast
                    :symtab
                    :ctx
                    :call
                    tid: ctid
                )
            }
        }
    } case none then null
    return (emitCallProbeChain :ast :symtab :ctx :call)
}

# emitStringMethod -- a String value-context method call. String is a native
# singleton whose struct + methods emit once under ctx.strC; dispatch by name so
# the cname is canonical (not a per-shell receiver id). `recv` is the receiver C
# expression; recvIsPtr picks `->`/no-`&`. "" for an unrecognized method.
emitStringMethod: function {
    ctx: Ctx.view
    recv: StringView
    recvIsPtr: bool
    mn: StringView
    recvVid: ztypes.vid
} out String is {
    if mn == "copy" then {
        if recvIsPtr then return "\{ctx.strC}_copy(\{recv})"
        return "\{ctx.strC}_copy(&\{recv})"
    }
    if mn == "length" then {
        if recvIsPtr then return "\{recv}->size"
        return "\{recv}.size"
    }
    if mn == "capacity" then {
        if recvIsPtr then return "\{recv}->capacity"
        return "\{recv}.capacity"
    }
    if (ztypecheck.isStringViewMember name: mn) then return (svValueForm
        :ctx
        expr: recv
        isStr: true
        vid: recvVid
    )
    if mn == "shrink" then {
        if recvIsPtr then return "\{ctx.strC}_shrink(\{recv})"
        return "\{ctx.strC}_shrink(&\{recv})"
    }
    return "".string
}

# varCName -- a local's emitted C identifier. Its variable id already names it
# uniquely, so no C-keyword mangling is needed; a site no id reached falls back
# to the mangled source name. --readable-names spells a local by that source
# name instead, and a source name is unique only inside the frame that binds
# it: a bare block is flattened into its enclosing C block, so a name a second
# frame of the same function binds would redefine the first one's C identifier.
# ctx.rnBareVids names the bindings that may keep the bare spelling; every
# other variable carries its id.
varCName: function {ctx: Ctx.view vid: ztypes.vid name: StringView} out String is {
    if ctx.readableNames then {
        rn: ztypes.mangleVarName :name
        if vid.isZero then return rn
        if (ctx.rnBareVids.has item: vid) then return rn
        vsfx: "_\{vid}"
        rn.append vsfx
        return rn
    }
    if vid.isZero then return (ztypes.mangleVarName :name)
    return "z_v\{vid}"
}

# memberCPrefix -- what a struct member's name needs in front of it to be a C
# identifier. A member keeps its source spelling: it has no id space of its
# own, and its namespace is the struct, so nothing but a C reserved word can
# collide. A field named `default` would emit `int64_t default;`, which the C
# compiler rejects, so the name carries the same `v_` a local does -- empty
# for every other name. Every spelling of a member -- the declaration, the
# reads and writes, the constructor parameters, the destructor, the generated
# `_eq` and the vtable slots cSlotName keeps in step -- puts this in front of
# it, because a prefix applied at the declaration and not at a read emits
# `b.v_default` against a field named `default`.
memberCPrefix: function {name: StringView} out StringView is {
    return (ztypes.mangleMemberPrefix :name)
}

# emitLocalAtomName -- a local variable's C spelling: the alias or narrowing
# cast in scope for it, else its own identifier. Shared by the atomid and
# labelvalue (:name shorthand) value legs.
emitLocalAtomName: function {ctx: Ctx.view name: StringView vid: ztypes.vid} out String is {
    # Probed directly rather than through aliasResolve: that would synthesize a
    # copy of `name` for the no-alias case, which is the common one, only for the
    # comparison below to discard it.
    nb: vvFind xs: ctx.narrowBox :vid
    if nb > 0 then return (ctx.narrowBox.get i: nb - 1).val.copy
    al: vvFind xs: ctx.aliases :vid
    if al > 0 then return (ctx.aliases.get i: al - 1).val.copy
    return (varCName :ctx :vid :name)
}

# emitDataMember -- a data block's element read through `n`, whose base is the
# block `dbt`: a label (`codes.ht`), an ordinal (`primes.0`), `.length`, or
# `.array` (the whole block copied into an array temp). "" for any other member.
emitDataMember: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    dbt: ztypes.tid
    mn2: String.view
} out String is {
    if mn2.stringView == "array" then {
        daid0: stampIdOf :symtab nid: n.nodeid.u64
        daid: chaseColMono :symtab :ctx tid: daid0
        daCt: (typeRefC
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: daid.u64)
            thisTid: ztypes.tid
        )
        daMn: regNameOf :symtab tid: (ztypes.tid.create from: daid.u64)
        daEid: listElemType :symtab monoId: (ztypes.tid.create from: daid.u64)
        daEln: regNameOf :symtab tid: (ztypes.tid.create from: daEid.u64)
        daPfx: daEln.length + 7
        daLen: monoElemName full: daMn prefixLen: daPfx
        daN: ctx.argHoistCtr
        ctx.argHoistCtr = ctx.argHoistCtr + 1
        daNm: "_da\{daN}"
        daSym: ctxCname :ctx tid: (ztypes.tid.create from: dbt.u64)
        daRaw: "    \{daCt} \{daNm};\n    for (int64_t _i = 0; _i < \{daLen.stringView}; _i++) { \{daNm}.data[_i] = \{daSym}[_i]; }\n"
        ctx.argHoistRaw.append daRaw
        return daNm
    }
    # `primes.0` reaches the element by ordinal, `primes.first`
    # by label; ask the right table rather than spelling one key
    # that could mean either
    dcIdx: mn2.stringView.parseU64
    match (
        dcIdx
    ) case ok then {
        dso: (ctx.dataSlot.get
            key: (dataslotkey owner: dbt.u64 slot: dcIdx)
        )
        match (
            dso
        ) case some then {
            dsv: dso.stringView
            return dsv.string
        } case none then null
    } else {
        dno: (ctx.dataConst.get
            key: (dataconstkey
                owner: dbt.u64
                name: (zast.poolFind pool: ast.names text: mn2.stringView).u64
            )
        )
        match (
            dno
        ) case some then {
            dnv: dno.stringView
            return dnv.string
        } case none then null
    }
    return "".string
}

# emitDefRefAtom -- a bare atom that names a DEFINITION rather than a local: a
# value alias for one arm of a tagged type (`NO: bool.false`), or a bare record /
# class construction, or a function reference. Empty when the atom names none of
# them.
emitDefRefAtom: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.atomidrow.view
    brid: ztypes.tid
    bdec: ztypes.declid
} out String is {
    # a VALUE alias (`NO: bool.false`) names one arm of a tagged type: its
    # Decl carries the ROOT's tid, so without this the atom fell through to
    # the raw-name fallback and the C referenced the alias name. Emit what
    # the dotted read emits.
    if brid > 0 when bdec.isZero == false then {
        btt: symtab.reg.typetypeOf typeId: brid
        isTag: false
        if btt == ztypes.ztypetype.variantType then isTag = true
        if btt == ztypes.ztypetype.unionType then isTag = true
        if isTag then {
            atk: (ztypecheck.reexportTargetIdsOf
                st: symtab
                :ast
                declId: bdec
            )
            if atk.unitName.u32 > 0 then {
                ctorArmName: (zast.poolTextAt pool: ast.names ref: atk.defName)
                if ctorArmName.length > 0 then {
                    ava: armValueC :symtab tid: brid arm: ctorArmName.stringView
                    if ava.length > 0 then return ava
                    atg: variantTag :symtab tid: brid arm: ctorArmName.stringView
                    if atg.length > 0 then {
                        avc: ctxCname :ctx tid: brid
                        ave: "((\{avc}_t){ .tag = \{atg} })"
                        return ave
                    }
                }
            }
        }
    }
    if brid > 0 when (symtab.reg.typetypeOf typeId: brid) == ztypes.ztypetype.recordType then {
        btn: regNameOf :symtab tid: (ztypes.tid.create from: brid.u64)
        boundCType: (scalarCTypeFor
            :symtab
            name: btn.stringView
            tid: (ztypes.tid.create from: brid.u64)
        )
        if boundCType.length > 0 then {
            # a stamped implicit zero-create is the scalar's zero value;
            # an unstamped scalar-name atom keeps the raw name text
            izo: symtab.typing.implicitCreate.get key: n.nodeid.u64
            match (
                izo
            ) case some then {
                ize: "((\{boundCType})0)"
                return ize
            } case none then null
            bsv: btn.stringView
            bsc: bsv.string
            return bsc
        }
        izr: symtab.typing.implicitCreate.get key: n.nodeid.u64
        match (
            izr
        ) case some then {
            # a typedef record (meters -> i64) is the chased scalar's zero
            ztd: typedefChaseC :ast :symtab :ctx tid: (ztypes.tid.create from: brid.u64)
            if ztd.length > 0 then return "((\{ztd})0)"
            return (emitCtorDefaultsFill
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: brid.u64)
            )
        } case none then null
        brc: ctxCname :ctx tid: (ztypes.tid.create from: brid.u64)
        be0: "((\{brc}_t){0})"
        return be0
    }
    if brid > 0 when (symtab.reg.typetypeOf typeId: brid) == ztypes.ztypetype.classType then {
        izc: symtab.typing.implicitCreate.get key: n.nodeid.u64
        match (
            izc
        ) case some then {
            # a collection-typedef class (Bytes) constructs through its
            # mono's create; a user class through its defaults fill;
            # String falls through to its own empty-value leg below
            if izc == ctx.strTid then return (emitExprStrZero :ctx)
            ztb: symtab.typing.typedefBaseName.get key: brid
            match (
                ztb
            ) case some then {
                # a String-typedef class (Path) shares the String
                # struct: the empty value is the zero struct
                ztbId: zast.nameid
                ztbId = ztb
                ztbT: zast.poolTextAt pool: ast.names ref: ztbId
                if ztbT.stringView == "String" then return (emitExprStrZero :ctx)
            } case none then null
            zmono: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: brid.u64)
            if zmono != brid then {
                zmc: ctxCname :ctx tid: (ztypes.tid.create from: zmono.u64)
                ilo: (isListOriginOf
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: zmono.u64)
                )
                if ilo then return "\{zmc}_create((uint64_t)0)"
                return "\{zmc}_create()"
            }
            return (emitCtorDefaultsFill
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: brid.u64)
            )
        } case none then null
    }
    if brid > 0 when (symtab.reg.typetypeOf typeId: brid) == ztypes.ztypetype.functionType then {
        # a bare no-arg unit fn that typecheck coerced to a CALL (its atom
        # stamp is the RETURN type, not FUNCTION) is invoked here; a genuine
        # fn reference (stamped FUNCTION) keeps the bare cname.
        fbcn: ctxCname :ctx tid: (ztypes.tid.create from: brid.u64)
        fastid: stampIdOf :symtab nid: n.nodeid.u64
        if fastid > 0 when (
            (symtab.reg.typetypeOf typeId: fastid) == ztypes.ztypetype.functionType
        ) then {
            # a node still stamped FUNCTION is a genuine reference (a
            # .take peel): the bare cname. Coerced calls carry the
            # return-type stamp and fill below.
            return fbcn
        }
        # a return-type-stamped atom is a coerced CALL: an all-defaulted
        # fn fills its defaults; a NO-PARAM fn coerces to `name()`; a fn
        # with required params reached here means a local binding shadows
        # the fn name -> emit the local instead.
        adCo: emitAllDefaultedCall :ast :symtab :ctx fnTid: brid fcn: fbcn.stringView
        if adCo.length > 0 then return adCo
        fpi: ListVal u64
        fpi9Nm: ListVal u64
        (recFieldIds
            :symtab
            tid: (ztypes.tid.create from: brid.u64)
            ids: fpi
            nameIds: fpi9Nm
        )
        if fpi.length == 0 then return "\{fbcn}()"
    }
    return "".string
}

# emitAtom -- the C text of a bare identifier. A STAMPED atom is a local and is
# answered first (the module-constant probe below costs an owned key and a hash);
# then a name written inside a namespace, then a stamped unit-def reference, and
# only then the name probe an unstamped template re-emission needs.
emitAtom: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.atomidrow.view
} out String is {
    avC: ast.names.texts.get i: n.name.u64
    av: avC.stringView
    # a `0b` / `0o` / `0c` literal has no C token behind it, so decode it here
    # (decimal, hex and float lexemes are C text as written; identifiers never
    # start with a digit)
    if av.startsWith "0" then {
        cl: literalC lex: av
        if cl.length > 0 when cl.stringView != av then return cl
        if cl.length == 0 then {
            emitFail :ctx what: "invalid numeric literal \{av}" line: n.lineno
            return "/* zemitterc: unhandled numeric literal \{av} */0"
        }
    }
    # stamped variable use first: the local, alias-resolved and C-mangled
    # -- a stamped atom is a LOCAL, so the module-constant probe (an owned
    # key alloc + hash) never runs for it
    avo: symtab.typing.atomVariableId.get key: n.nodeid.u64
    match (
        avo
    ) case some then {
        return (emitLocalAtomName :ctx name: av vid: avo)
    } case none then null
    # a name written inside a namespace resolves against that namespace
    # first, then the file unit -- the chain spec.pdoc gives an inline unit.
    # A generic unit's mono method is written in the TEMPLATE, whose Decl
    # the mono's id points at, so its chain starts there.
    nsAt: ctx.nsTid
    if nsAt.isZero when ctx.curThisTid.isZero == false then {
        if (
            (symtab.reg.typetypeOf typeId: ctx.curThisTid) == ztypes.ztypetype.unitType
        ) then nsAt = ctx.curThisTid
    }
    if nsAt.isZero == false then {
        # the nested frames, innermost outward: the unit the name is
        # written in, then each unit enclosing it. Asking only the
        # innermost inlined nothing for a constant of an enclosing inline
        # unit, and the bare source name reached the C.
        nsCur: ztypecheck.declOfTypeId st: symtab tid: nsAt
        for nsCur > 0 loop {
            nsFt: ztypecheck.declTypeIdOf st: symtab declId: nsCur
            if nsFt.isZero == false then {
                nsca: (memberConstText
                    :ast
                    :symtab
                    :ctx
                    unitTid: nsFt
                    nameId: n.name
                )
                if nsca.length > 0 then return nsca
                nscs: memberConstStringText :symtab :ctx unitTid: nsFt nameId: n.name
                if nscs.length > 0 then return nscs
            }
            nsNx: ztypecheck.declParentIdOf st: symtab declId: nsCur
            nsCur = ztypes.declid
            if nsNx.isZero == false then {
                if (ztypecheck.declDeclaresUnit
                    st: symtab
                    :ast
                    declId: nsNx
                ) then nsCur = nsNx
            }
        }
    }
    mutd: unitTidOf :ast :symtab unitName: ctx.mainName.stringView
    mca: (memberConstText
        :ast
        :symtab
        :ctx
        unitTid: mutd
        nameId: n.name
    )
    if mca.length > 0 then return mca
    mcsa: memberConstStringText :symtab :ctx unitTid: mutd nameId: n.name
    if mcsa.length > 0 then return mcsa
    # stamped unit-def reference: the RECORD / FUNCTION legs run off the
    # stamped tid; unstamped atoms (fn-mono template re-emission walks
    # the shared template AST) fall back to the name probe
    brid: ztypes.tid
    bdec: ztypes.declid
    {
        audo: symtab.typing.refDecl.get key: n.nodeid.u64
        match (
            audo
        ) case some then {
            d0x: symtab.typing.decls.get i: audo.u64
            brid = ztypes.tid.create from: d0x.typeId
            bdec = audo
        } case none then null
    }
    if brid.isZero then brid = userFnId :ast :symtab :ctx name: av
    dra: emitDefRefAtom :ast :symtab :ctx :n :brid :bdec
    if dra.length > 0 then return dra
    # a stamped implicit zero-create on a String atom is the empty
    # owned string: the zero struct needs no allocation and no free
    iso: symtab.typing.implicitCreate.get key: n.nodeid.u64
    match (
        iso
    ) case some then {
        if iso == ctx.strTid then return (emitExprStrZero :ctx)
    } case none then null
    return (emitLocalAtomName :ctx name: av vid: (atomVid :symtab nid: n.nodeid.u64))
}

# emitNestedStringViewBase -- `.stringView` on a nested String/StringView base
# projects an inline VIEW rather than reading a field, matching what the simple
# base does through svValueForm.
emitNestedStringViewBase: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    mn2: StringView
} out String is {
    if (ztypecheck.isStringViewMember name: mn2) then {
        ppid: interpPartNodeId n: (ast.nodes.get i: n.parent.u64)
        parentStampTid: stampIdOf :symtab nid: ppid
        if parentStampTid == ctx.strTid then {
            pbv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
            pbq: (atomVidIfPlain
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: n.parent.u64)
                text: pbv.stringView
            )
            sv: svValueForm :ctx expr: pbv.stringView isStr: true vid: pbq
            return sv
        }
        if parentStampTid == ctx.svTid then {
            return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
        }
    }
    return "".string
}

# emitNestedCollectionBase -- a str or collection mono reached through a FIELD.
# Set and Map are heap pointers and pass directly; the id-keyed pair are stack
# structs and go by address.
emitNestedCollectionBase: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    mn2: StringView
    nlid: ztypes.tid
    baseAtom: StringView
    bs9vid: ztypes.vid
} out String is {
    if (originIsTid :symtab tid: nlid originTid: (ctx.origins.get i: ogStr)) then {
        nstrcb: ctxCname :ctx tid: nlid
        if mn2 == "length" then return "\{baseAtom}.len"
        if mn2 == "size" then return "\{nstrcb}_size"
        if mn2 == "string" then return "\{nstrcb}_string(\{baseAtom})"
        if (ztypecheck.isStringViewMember name: mn2) then {
            return "(\{ctx.svC}_t){ .data = \{baseAtom}.data, .size = \{baseAtom}.len }"
        }
    }
    if (isListOriginOf :symtab :ctx tid: nlid) then {
        nlcb: ctxCname :ctx tid: nlid
        recvB: colRecvRef :ctx bn: baseAtom vid: bs9vid
        if mn2 == "pop" then return "\{nlcb}_pop(\{recvB})"
        if mn2 == "sort" then return "\{nlcb}_sort(\{recvB})"
        if (ztypecheck.isListViewMember name: mn2) then return "\{nlcb}_listView(\{recvB})"
        if mn2 == "iterate" then return "\{nlcb}_iterate(\{recvB})"
        if mn2 == "iterateMut" then return "\{nlcb}_iterateMut(\{recvB})"
    }
    # Set/Map are heap-pointer collections; their methods are emitted by the
    # collection template (not registry children), so a CLASS-dispatch
    # methodOwnerId scan would mis-resolve to a duplicate same-named mono. The
    # receiver field is already a pointer, so it is passed directly (no `&`).
    if (isSetOriginOf :symtab :ctx tid: nlid) then {
        nscb: ctxCname :ctx tid: nlid
        if mn2 == "iterate" then return "\{nscb}_iterate(\{baseAtom})"
    }
    if (isMapOriginOf :symtab :ctx tid: nlid) then {
        nmpcb: ctxCname :ctx tid: nlid
        if mn2 == "iterate" then return "\{nmpcb}_iterate(\{baseAtom})"
        if mn2 == "iterateItems" then return "\{nmpcb}_iterateItems(\{baseAtom})"
    }
    # the id-keyed pair reached through a FIELD. They are stack structs, so
    # the receiver goes by address where a Map's field is already a pointer.
    if (isIdCollectionOriginOf :symtab :ctx tid: nlid) then {
        nidcb: ctxCname :ctx tid: nlid
        nidrv: colRecvRef :ctx bn: baseAtom vid: bs9vid
        if mn2 == "iterate" then return "\{nidcb}_iterate(\{nidrv})"
        if mn2 == "iterateItems" then return "\{nidcb}_iterateItems(\{nidrv})"
    }
    return "".string
}

# emitNestedMonoMethodBase -- a no-argument METHOD on a nested receiver whose
# type is a registered mono: protocol dispatch, the view natives, then the
# owner's own method, taking the receiver by address where its signature says.
emitNestedMonoMethodBase: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    mn2: StringView
    nlid: ztypes.tid
    baseAtom: StringView
    bs9vid: ztypes.vid
} out String is {
    if nlid > 0 then {
        nrtt: symtab.reg.typetypeOf typeId: nlid
        # a protocol/facet-typed base reached through a FIELD dispatches
        # exactly as a bare one does; without this the member read falls
        # through to the struct-field leg below and gcc rejects it
        if (isDispatchableTid :symtab tid: nlid) then {
            if (vtableAutoCallName name: mn2) then {
                nacc: ".".string
                if (pathIsPointer
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: n.parent.u64)
                ) then nacc = "->".string
                return (vtableAutoCallC
                    recv: baseAtom
                    acc: nacc.stringView
                    mn: mn2
                    isFacet: nrtt == ztypes.ztypetype.facetType
                )
            }
        }
        nDisp: false
        if nrtt == ztypes.ztypetype.classType then nDisp = true
        if nrtt == ztypes.ztypetype.recordType then nDisp = true
        if nDisp then {
            nlidM: methodOwnerId :ast :symtab rtid: nlid mn: mn2
            nmco: (symtab.typing.declChildOf
                pool: ast.names
                parentTypeId: (ztypes.tid.create from: nlidM.u64)
                name: mn2
            )
            match (
                nmco
            ) case some then {
                if (
                    (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: nmco.u64)) ==
                    ztypes.ztypetype.functionType
                ) then {
                    # no-arg SV natives on a nested stringy base: the
                    # canonical native symbol, not the method-id cname
                    if (isSvNoArgNative name: mn2) when (isStringyTid
                        :ctx
                        tid: nlid
                    ) then {
                        needsAddM :ctx uname: "system" memb: mn2
                        svfn: (svValueForm
                            :ctx
                            expr: baseAtom
                            isStr: nlid == ctx.strTid
                            vid: bs9vid
                        )
                        return "\{ctx.svC}_\{mn2}(&\{svfn})"
                    }
                    nmc: ctxCname :ctx tid: (ztypes.tid.create from: nmco.u64)
                    # a receiver-taking method takes it by pointer in both
                    # families, so address it unless it already is one
                    nmrecv: "\{baseAtom}"
                    if (calleeTakesReceiverByPtr
                        :ast
                        :symtab
                        fid: (ztypes.tid.create from: nmco.u64)
                    ) then {
                        dpu: ast.nodes.get i: n.parent.u64
                        if (pathIsPointer :ast :symtab :ctx n: dpu) == false then {
                            # the receiver is passed by address, and a base
                            # that IS a call is not an lvalue -- `&f(x)` is C
                            # the compiler rejects. emitByrefArg hoists such a
                            # value into the `_ahN` temp an argument gets; a
                            # plain name still emits as `&name`.
                            nmrecv = (emitByrefArg
                                :ast
                                :symtab
                                :ctx
                                av: baseAtom
                                pid: nlid
                                isBorrow: false
                            )
                        }
                    }
                    return "\{nmc}(\{nmrecv})"
                }
            } case none then null
        }
    }
    return "".string
}

# emitDottedNestedBase -- a read whose base is itself a path (`it.target.a`,
# `this.field.pop`): emit the base expression, then chain `.` or `->` by whether
# the base resolves to a pointer. The collection legs repeat here because the
# atom-base ones key off a stamped ATOM, which a nested path does not have.
emitDottedNestedBase: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    mn2: StringView
} out String is {
    # `.stringView` on a String/StringView projects an inline view, not a
    # field access (matches the simple-base svValueForm path).
    eSv: emitNestedStringViewBase :ast :symtab :ctx :n :mn2
    if eSv.length > 0 then return eSv
    # a nested base (e.g. it.target.a): emit the base expression, then chain
    # `.`/`->` by whether the base resolves to a pointer (ptrVar / lock field).
    baseAtom: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
    {
        bh: (ownedReceiverHoist
            :ast
            :symtab
            :ctx
            expr: baseAtom.stringView
            n: (ast.nodes.get i: n.parent.u64)
        )
        if bh.length > 0 then baseAtom = bh
    }
    bs9vid: (atomVidIfPlain
        :ast
        :symtab
        :ctx
        n: (ast.nodes.get i: n.parent.u64)
        text: baseAtom.stringView
    )
    if (baseAtom.stringView.startsWith prefix: "/*") then {
        emitFail :ctx what: "unhandled dotted".string line: n.lineno
        return "/* zemitterc: unhandled dotted */0".string
    }
    nptn: stampNameDeep :ast :symtab n: (ast.nodes.get i: n.parent.u64)
    if nptn.stringView == "String" then {
        nptr: pathIsPointer :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
        nsm: (emitStringMethod
            :ctx
            recv: baseAtom.stringView
            recvIsPtr: nptr
            mn: mn2
            recvVid: bs9vid
        )
        if nsm.length > 0 then return nsm
    }
    if (isStringy name: nptn.stringView) when (isSvParseNative name: mn2) then {
        needsAddM :ctx uname: "system" memb: mn2
        npIsStr: nptn.stringView == "String"
        pnv: svValueForm :ctx expr: baseAtom.stringView isStr: npIsStr vid: bs9vid
        epnv: "\{ctx.svC}_\{mn2}(&\{pnv})"
        return epnv
    }
    # a no-arg List method on a nested receiver (this.field.pop): the bsmn
    # leg above missed it (bstamp keys off an atom base, 0 for a nested
    # path). Resolve the List mono from the base node and emit the call.
    nlid: stampIdOf :symtab nid: (interpPartNodeId n: (ast.nodes.get i: n.parent.u64))
    nlid = ztypes.tid.create from: (chaseColMono :symtab :ctx tid: nlid)
    eCo: (emitNestedCollectionBase
        :symtab
        :ctx
        :mn2
        :nlid
        baseAtom: baseAtom.stringView
        :bs9vid
    )
    if eCo.length > 0 then return eCo
    eMo: (emitNestedMonoMethodBase
        :ast
        :symtab
        :ctx
        :n
        :mn2
        :nlid
        baseAtom: baseAtom.stringView
        :bs9vid
    )
    if eMo.length > 0 then return eMo
    # a Map/Set-typed base is a heap pointer regardless of how it was
    # reached (a field path fails pathIsPointer's lock-field test)
    nsumT: symtab.reg.typetypeOf typeId: nlid
    isSum9: false
    if nsumT == ztypes.ztypetype.variantType then isSum9 = true
    if nsumT == ztypes.ztypetype.unionType then isSum9 = true
    if isSum9 then {
        eSmN: (sumMemberMethodRead
            :ast
            :symtab
            :ctx
            :mn2
            bn2: baseAtom.stringView
            bn2v: bs9vid
            bstamp: nlid
        )
        if eSmN.length > 0 then return eSmN
    }
    nstPtr: pathIsPointer :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
    if nstPtr == false then nstPtr = isHeapPtrCollection :symtab :ctx tid: nlid
    mnNbP: memberCPrefix name: mn2
    if nstPtr then {
        ep: "\{baseAtom}->\{mnNbP}\{mn2}"
        return ep
    } else {
        ed: "\{baseAtom}.\{mnNbP}\{mn2}"
        return ed
    }
}

# emitResolvedMemberRead -- the member resolved on the receiver's type: a protocol
# conformance field, an fn-pointer field, a plain field, or a no-arg method that
# auto-calls. The receiver goes by address or by value as its variable dictates.
emitResolvedMemberRead: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    mn2: StringView
    bn2: StringView
    bn2v: ztypes.vid
    bstamp: ztypes.tid
    mco: u64
    fbtn: StringView
} out String is {
    if (
        (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: mco.u64)) ==
        ztypes.ztypetype.protocolType
    ) then {
        # borrowed conformance projection: f.myreader ->
        # {Impl}_{label}_create(&f) (a borrowed fat pointer). Only an
        # as-block conformance LABEL materializes; a stored protocol
        # field (p: SomeProto) is a by-value fat pointer accessed
        # directly. (These differed by shell-ness pre-declare-before-
        # bind; now both children are the canonical PROTOCOL id, so
        # gate on the conformance row.)
        clab: conformanceLabelFor :symtab implTid: bstamp protoTid: mco
        if clab.stringView == mn2 then {
            ib: ctxCname :ctx tid: bstamp
            if (isPtrVid :ctx vid: bn2v) then {
                pj: "\{ib}_\{mn2}_create(\{bn2})"
                return pj
            }
            pj9b: "\{ib}_\{mn2}_create(&\{bn2})"
            return pj9b
        }
    }
    if (
        (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: mco.u64)) ==
        ztypes.ztypetype.functionType
    ) when (
        (symtab.typing.declIsFnptrField
            pool: ast.names
            parentTypeId: bstamp
            name: mn2
        ) ==
        false
    ) then {
        # member auto-call: a CLASS method takes its receiver by
        # pointer (&recv, or recv when already a ptrVar); a RECORD
        # method takes it by value.
        # no-arg SV natives (count/hash/codepoints/lines) have no
        # per-method C symbol: emit the canonical native over
        # the projected view (String or StringView receiver)
        if (isSvNoArgNative name: mn2) when (isStringyTid
            :ctx
            tid: bstamp
        ) then {
            needsAddM :ctx uname: "system" memb: mn2
            svfa: (svValueForm
                :ctx
                expr: bn2
                isStr: (bstamp == ctx.strTid)
                vid: bn2v
            )
            ef: "\{ctx.svC}_\{mn2}(&\{svfa})"
            return ef
        }
        mc2: ctxCname :ctx tid: (ztypes.tid.create from: mco.u64)
        # `Type.create` -- the base is the type name itself, not
        # an instance -- is a constructor/static call and takes no
        # receiver (fbtn is the enclosing type's name). The
        # native scalar/String creates have no C symbol: the
        # zero value is the construction.
        if bn2v.isZero when bn2 == fbtn when mn2 == "create" then {
            zsc: scalarCTypeFor :symtab name: fbtn tid: bstamp
            if zsc.length > 0 then {
                zse: "((\{zsc})0)"
                return zse
            }
            if bstamp == ctx.strTid then {
                zst: "((\{ctx.strC}_t){0})"
                return zst
            }
        }
        # static/type-qualified only when the base is the TYPE
        # NAME, not a local that happens to share its spelling
        # (--readable-names keeps source names, so the text
        # alone cannot discriminate; a local base has a vid)
        if bn2v.isZero when bn2 == fbtn then {
            # A RECEIVER-TAKING METHOD READ OFF THE TYPE NAME IS A REFERENCE,
            # and there is nothing else it can be: calling it needs a receiver
            # this leg has not got, and the call form (`T.f self: t rhs: 2`)
            # never arrives here. So `point.add.take` is the bare cname -- the
            # unbound function pointer, whose `_ft` typedef already pointerizes
            # the receiver. Emitting `z_..._add()` here would call a
            # receiver-taking function with nothing at all.
            #
            # A true zero-arg static declares no receiver and keeps its call.
            if (fnTypeTakesThis
                :symtab
                tid: (ztypes.tid.create from: mco.u64)
            ) then return mc2
            sda: (renderedMethodDefaultArgs
                :ast
                :symtab
                :ctx
                fnTid: (ztypes.tid.create from: mco.u64)
            )
            if sda.length > 0 then return "\{mc2}(\{sda})"
            return "\{mc2}()"
        }
        # a receiver-taking method takes it by pointer in both
        # families, so address it unless it already is one
        methodRecv: "\{bn2}"
        if (calleeTakesReceiverByPtr
            :ast
            :symtab
            fid: (ztypes.tid.create from: mco.u64)
        ) then {
            if (isPtrVid :ctx vid: bn2v) == false then methodRecv = "&\{bn2}"
        }
        ida: (renderedMethodDefaultArgs
            :ast
            :symtab
            :ctx
            fnTid: (ztypes.tid.create from: mco.u64)
        )
        if ida.length > 0 then return "\{mc2}(\{methodRecv}, \{ida})"
        e6: "\{mc2}(\{methodRecv})"
        return e6
    }
    if (
        (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: mco.u64)) ==
        ztypes.ztypetype.functionType
    ) when (symtab.typing.declIsFnptrField
        pool: ast.names
        parentTypeId: bstamp
        name: mn2
    ) then {
        mcFp: ctxCname :ctx tid: (ztypes.tid.create from: mco.u64)
        if bn2v.isZero when bn2 == fbtn then return mcFp
        if (fnTypeTakesThis :symtab tid: (ztypes.tid.create from: mco.u64)) then {
            accFp: ".".string
            rcvFp: "&\{bn2}"
            if (isPtrVid :ctx vid: bn2v) then {
                accFp = "->".string
                rcvFp = "\{bn2}"
            }
            mnFpP: memberCPrefix name: mn2
            return "\{bn2}\{accFp}\{mnFpP}\{mn2}(\{rcvFp})"
        }
    }
    return "".string
}

# sumMemberMethodRead -- a sum type's dotted read where the member is a declared
# METHOD rather than an arm. An arm and a method can never share a name (E0003
# rejects it), so the DECLARATION answers which one a bare read is; the payload
# read below applies only when it answers nothing, or names something with no
# body to read. The declared arms are children too, hence the FUNCTION test.
# fbtn names the enclosing type for a read whose base is a TYPE rather than a
# value; a sum value's base is always a variable, and the type-name form is
# taken by dottedAtomTaggedBase before this leg is reached.
sumMemberMethodRead: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    mn2: StringView
    bn2: StringView
    bn2v: ztypes.vid
    bstamp: ztypes.tid
} out String is {
    mco: (symtab.typing.declChildOf
        pool: ast.names
        parentTypeId: bstamp
        name: mn2
    )
    match (
        mco
    ) case some then {
        if (
            (symtab.reg.typetypeOf
                typeId: (ztypes.tid.create from: mco.u64)
            ) !=
            ztypes.ztypetype.functionType
        ) then return "".string
        return (emitResolvedMemberRead
            :ast
            :symtab
            :ctx
            :mn2
            :bn2
            :bn2v
            :bstamp
            :mco
            fbtn: ""
        )
    } case none then null
    return "".string
}

# emitUserTypeMemberRead -- a field or no-arg method read on a user record or
# class receiver: the field access itself, an auto-called no-arg method, and the
# defaults a method's unwritten parameters carry.
emitUserTypeMemberRead: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    mn2: StringView
    bn2: StringView
    bn2v: ztypes.vid
    bstamp: ztypes.tid
} out String is {
    fbtn: regNameView :symtab tid: bstamp
    if bstamp == ctx.strTid then {
        sptr: isPtrVid :ctx vid: bn2v
        sm: (emitStringMethod
            :ctx
            recv: bn2
            recvIsPtr: sptr
            mn: mn2
            recvVid: bn2v
        )
        if sm.length > 0 then return sm
    }
    isFN: false
    if mn2 == "close" then isFN = true
    if mn2 == "flush" then isFN = true
    if mn2 == "readLine" then isFN = true
    if mn2 == "accept" then isFN = true
    isFile: false
    isNetU: false
    if isFN then {
        # the member's OWN DECLARATION decides. A native member has no body to
        # emit, which is exactly what makes the read a fragment call; the
        # unit's name admitted every type declared in it instead, so a user
        # unit spelled `cli`, `os` or `net` handed its own bodied methods to a
        # fragment that never defined them -- `z_t13_close` was called and
        # never emitted, at exit 0. Being declared native also subsumes the
        # receiver test `accept` would otherwise need.
        mcoF: (symtab.typing.declChildOf
            pool: ast.names
            parentTypeId: bstamp
            name: mn2
        )
        match (
            mcoF
        ) case some then {
            if (fnIsNativeId
                :symtab
                fid: (ztypes.tid.create from: mcoF.u64)
            ) then isFile = true
        } case none then null
    }
    if isFile then {
        fduo: definedInUnitOf :symtab tid: bstamp
        match (
            fduo
        ) case some then {
            if fduo.stringView == "net" then isNetU = true
        } case none then null
        ffc: ctxCname :ctx tid: bstamp
        ffcc: ioCanonCname :ast :symtab :ctx canon: fbtn
        if ffcc.length > 0 then ffc = ffcc
        if isNetU then {
            needsAddM :ctx uname: "net" memb: "@unit"
        } else {
            needsAddM :ctx uname: "io" memb: "@unit"
            ffm: "file_\{mn2}"
            needsAddM :ctx uname: "io" memb: ffm.stringView
        }
        frecv: "&\{bn2}"
        if (isPtrVid :ctx vid: bn2v) then frecv = "\{bn2}"
        return "\{ffc}_\{mn2}(\{frecv})"
    }
    mco: (symtab.typing.declChildOf
        pool: ast.names
        parentTypeId: bstamp
        name: mn2
    )
    match (
        mco
    ) case some then {
        rmr: (emitResolvedMemberRead
            :ast
            :symtab
            :ctx
            :mn2
            :bn2
            :bn2v
            :bstamp
            :mco
            :fbtn
        )
        if rmr.length > 0 then return rmr
    } case none then null
    mnUtP: memberCPrefix name: mn2
    if (isPtrVid :ctx vid: bn2v) then {
        e5p: "\{bn2}->\{mnUtP}\{mn2}"
        return e5p
    }
    e5: "\{bn2}.\{mnUtP}\{mn2}"
    return e5
}

# emitIdCollectionMemberRead -- a counter or no-arg method on the id-keyed pair,
# on a Set or Map, or on a map ENTRY. A Set/Map is a heap pointer and reads
# through `->`; the id-keyed pair and the entries are stack structs and read
# through accB2, exactly as a List does.
emitIdCollectionMemberRead: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    mn2: StringView
    bn2: StringView
    bstamp: ztypes.tid
    accB2: StringView
    recvB2: StringView
} out String is {
    if (isIdCollectionOriginOf :symtab :ctx tid: bstamp) then {
        if mn2 == "length" then {
            eidl: "\{bn2}\{accB2}length"
            return eidl
        }
        if mn2 == "capacity" then {
            eidc: "\{bn2}\{accB2}capacity"
            return eidc
        }
        if mn2 == "iterate" then {
            idcb: ctxCname :ctx tid: bstamp
            eidi: "\{idcb}_iterate(\{recvB2})"
            return eidi
        }
        if mn2 == "iterateItems" then {
            idcb8: ctxCname :ctx tid: bstamp
            eidii: "\{idcb8}_iterateItems(\{recvB2})"
            return eidii
        }
    }
    if (isSetOriginOf :symtab :ctx tid: bstamp) then {
        if mn2 == "length" then {
            esl: "\{bn2}->length"
            return esl
        }
        if mn2 == "capacity" then {
            esc: "\{bn2}->capacity"
            return esc
        }
        scb2: ctxCname :ctx tid: bstamp
        if mn2 == "iterate" then {
            esi: "\{scb2}_iterate(\{bn2})"
            return esi
        }
    }
    if (isMapOriginOf :symtab :ctx tid: bstamp) then {
        if mn2 == "length" then {
            eml: "\{bn2}->length"
            return eml
        }
        if mn2 == "capacity" then {
            emc: "\{bn2}->capacity"
            return emc
        }
        mcb2: ctxCname :ctx tid: bstamp
        if mn2 == "iterate" then {
            emi: "\{mcb2}_iterate(\{bn2})"
            return emi
        }
        if mn2 == "iterateItems" then {
            emii: "\{mcb2}_iterateItems(\{bn2})"
            return emii
        }
    }
    isAnyEntry: isMapEntryOriginOf :symtab :ctx tid: bstamp
    if (isIdMapEntryOriginOf :symtab :ctx tid: bstamp) then isAnyEntry = true
    if isAnyEntry then {
        # a borrowed entry yielded by iterateItems: key/value project
        # the entry struct's fields. The loop var binds a deref alias
        # (`(*__borrow_e)`, a value), so access uses `.`; a genuine
        # entry pointer base keeps `->`.
        entryAcc: ".".string
        dpt: ast.nodes.get i: n.parent.u64
        if (pathIsPointer :ast :symtab :ctx n: dpt) then entryAcc = "->".string
        if mn2 == "key" then {
            eek: "\{bn2}\{entryAcc}key"
            return eek
        }
        if mn2 == "value" then {
            eev: "\{bn2}\{entryAcc}value"
            return eev
        }
    }
    dbt: (dataBlockTid
        :symtab
        nid: (atomNodeId n: (ast.nodes.get i: n.parent.u64))
    )
    if dbt.isZero == false then {
        dres: emitDataMember :ast :symtab :ctx :n :dbt mn2: mn2.string
        if dres.length > 0 then return dres
    }
    return "".string
}

# emitCollectionMemberRead -- a counter or no-arg method on a builtin collection
# receiver, keyed on the template the receiver's mono came from. The id-keyed
# pair are STACK structs, so their counters are read through `.` or `->` exactly
# as a List's are, not through the unconditional `->` a heap Map uses.
emitCollectionMemberRead: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    mn2: StringView
    bn2: StringView
    bn2v: ztypes.vid
    bstamp: ztypes.tid
} out String is {
    accB2: ".".string
    if (isPtrVid :ctx vid: bn2v) then accB2 = "->".string
    recvB2: colRecvRef :ctx bn: bn2 vid: bn2v
    if (originIsTid :symtab tid: bstamp originTid: (ctx.origins.get i: ogArray)) then {
        acba: ctxCname :ctx tid: bstamp
        if mn2 == "length" then {
            eal: "\{acba}_length"
            return eal
        }
        if (allDigits s: mn2) then {
            eai: "\{bn2}\{accB2}data[\{mn2}]"
            return eai
        }
    }
    if (originIsTid :symtab tid: bstamp originTid: (ctx.origins.get i: ogStr)) then {
        scba: ctxCname :ctx tid: bstamp
        if mn2 == "length" then {
            esl: "\{bn2}\{accB2}len"
            return esl
        }
        if mn2 == "size" then {
            ess: "\{scba}_size"
            return ess
        }
        if mn2 == "string" then {
            estr: "\{scba}_string(\{bn2})"
            return estr
        }
        if (ztypecheck.isStringViewMember name: mn2) then {
            esvw: "(\{ctx.svC}_t){ .data = \{bn2}\{accB2}data, .size = \{bn2}\{accB2}len }"
            return esvw
        }
    }
    if (isListOriginOf :symtab :ctx tid: bstamp) then {
        if mn2 == "length" then {
            el0: "\{bn2}\{accB2}length"
            return el0
        }
        if mn2 == "capacity" then {
            el1: "\{bn2}\{accB2}capacity"
            return el1
        }
        lcb2: ctxCname :ctx tid: bstamp
        if mn2 == "pop" then {
            ep0: "\{lcb2}_pop(\{recvB2})"
            return ep0
        }
        if mn2 == "sort" then {
            ep1: "\{lcb2}_sort(\{recvB2})"
            return ep1
        }
        if (ztypecheck.isListViewMember name: mn2) then {
            ep2: "\{lcb2}_listView(\{recvB2})"
            return ep2
        }
        if mn2 == "iterate" then {
            epLi: "\{lcb2}_iterate(\{recvB2})"
            return epLi
        }
        if mn2 == "iterateMut" then {
            epLiM: "\{lcb2}_iterateMut(\{recvB2})"
            return epLiM
        }
    }
    if (isListViewOriginOf :symtab :ctx tid: bstamp) then {
        if mn2 == "length" then {
            elv: "\{bn2}\{accB2}length"
            return elv
        }
    }
    # the id-keyed pair are STACK structs, so their counters are read
    # through accB2 (`.` or `->`) exactly as a List's are, not through
    # the unconditional `->` a heap Map uses
    icm: (emitIdCollectionMemberRead
        :ast
        :symtab
        :ctx
        :n
        :mn2
        :bn2
        :bstamp
        accB2: accB2.stringView
        recvB2: recvB2.stringView
    )
    if icm.length > 0 then return icm
    return "".string
}

# dottedAtomNumericBase -- `3.u64`: a typed numeric literal, whose "member" is
# the suffix and whose base text is the C literal. `0cA` is decoded first --
# the 0c lexeme is not a C token.
dottedAtomNumericBase: function {
    bn2: StringView
    mn2: StringView
} out String is {
    b1: bn2.byteAt i: 0
    match (
        b1
    ) case some then {
        if b1 >= 48 then {
            if b1 <= 57 then {
                # A LITERAL SUFFIX NAMES A BUILTIN SCALAR, always: it is a
                # conversion the literal type declares, and the literal types
                # declare only the sixteen. Chasing a scalar typedef to its base
                # as well would make `1.nameid` mean "u32".
                cTypeLk3: cTypeOf name: mn2
                if cTypeLk3.length > 0 then {
                    bv1: bn2
                    bc1: bv1.string
                    # `0cA.u8`: the 0c lexeme is not a C token; decode
                    if bv1.startsWith "0c" then {
                        pn1: ztypes.parseNumber numstr: bv1
                        if pn1.err.length == 0 then bc1 = "\{pn1.ival}"
                    }
                    sfx1: numLitSuffix name: cTypeLk3.stringView
                    bc1.append sfx1
                    return bc1
                }
            }
        }
    } case none then null
    return "".string
}

# dottedAtomConstCloneBase -- `Unit.CONST` where the base names a function-like
# declaration carrying an `as`-const clone: the member reads as that constant.
dottedAtomConstCloneBase: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    bn2: StringView
    mn2: StringView
} out String is {
    btC12: userFnId :ast :symtab :ctx name: bn2
    if btC12 > 0 then {
        ccoC12: (symtab.typing.declChildOf
            pool: ast.names
            parentTypeId: btC12
            name: mn2
        )
        match (
            ccoC12
        ) case some then {
            if (symtab.typing.isAsConstClone typeId: (ztypes.tid.create from: ccoC12.u64)) then {
                return (cnameOf tid: btC12 ownerName: bn2 name: mn2)
            }
        } case none then null
    }
    return "".string
}

# emitSvAtomBase -- a StringView base: `.length`, the pointer/one-past ends, the
# parse members, and the simple view natives, each a direct field or call on the
# view value rather than a dispatch.
emitSvAtomBase: function {
    ctx: Ctx
    bn2: StringView
    mn2: StringView
    bn2v: ztypes.vid
    bareSv: bool
} out String is {
    if bareSv then {
        if mn2 == "length" then {
            e2: "\{bn2}.size"
            return e2
        }
        if mn2 == "asString" then {
            # the cast IS the emission: {size, data} is a prefix of
            # String, so the view's address is a readonly String
            accA: "&".string
            if (isPtrVid :ctx vid: bn2v) then accA = "".string
            ea2: "((const \{ctx.strC}_t*)\{accA}\{bn2})"
            return ea2
        }
        if mn2 == "count" then {
            needsAddM :ctx uname: "system" memb: "count"
            ec2: "\{ctx.svC}_count(&\{bn2})"
            return ec2
        }
        if mn2 == "codepoints" then {
            needsAddM :ctx uname: "system" memb: "codepoints"
            ecp: "\{ctx.svC}_codepoints(&\{bn2})"
            return ecp
        }
        if mn2 == "parseI64" then {
            needsAddM :ctx uname: "system" memb: "parseI64"
            epi: "\{ctx.svC}_parseI64(&\{bn2})"
            return epi
        }
        if mn2 == "parseU64" then {
            needsAddM :ctx uname: "system" memb: "parseU64"
            epu: "\{ctx.svC}_parseU64(&\{bn2})"
            return epu
        }
        if mn2 == "parseF64" then {
            needsAddM :ctx uname: "system" memb: "parseF64"
            epf: "\{ctx.svC}_parseF64(&\{bn2})"
            return epf
        }
        if mn2 == "parseF16" then {
            needsAddM :ctx uname: "system" memb: "parseF16"
            eph: "\{ctx.svC}_parseF16(&\{bn2})"
            return eph
        }
        if mn2 == "parseF128" then {
            needsAddM :ctx uname: "system" memb: "parseF128"
            epq: "\{ctx.svC}_parseF128(&\{bn2})"
            return epq
        }
        if (isSvSimpleNative name: mn2) then {
            # a no-paren method reference auto-calls
            needsAddM :ctx uname: "system" memb: mn2
            e4: "\{ctx.svC}_\{mn2}(&\{bn2})"
            return e4
        }
        if mn2 == "lines" then {
            needsAddM :ctx uname: "sviter" memb: "sv_lines"
            eln2: "\{ctx.svC}_lines(&\{bn2})"
            return eln2
        }
    }
    return "".string
}

# dottedAtomTaggedBase -- `toktype.dotTok`: a bare TYPE name carrying the arm.
# The base is asked by its SOURCE name, and only when no local answers to it --
# a local shadows, and its emitted C identifier is not a name the registry can
# be asked about at all. Declines when the arm has a payload.
dottedAtomTaggedBase: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    mn2: StringView
    bn2r: StringView
    baseAtomVid: ztypes.vid
} out String is {
    vtid2: u64
    if baseAtomVid.isZero then vtid2 = (resolveTypeIdByName
        :ast
        :symtab
        :ctx
        name: bn2r
    )
    isTagged: false
    if vtid2 > 0 then {
        vtt2: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: vtid2.u64)
        if vtt2 == ztypes.ztypetype.variantType then isTagged = true
        if vtt2 == ztypes.ztypetype.unionType then isTagged = true
    }
    if isTagged then {
        pc2: (armPayloadC
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: vtid2.u64)
            arm: mn2
        )
        if pc2.length == 0 then {
            tg2: (variantTag
                :symtab
                tid: (ztypes.tid.create from: vtid2.u64)
                arm: mn2
            )
            vc2: ctxCname :ctx tid: (ztypes.tid.create from: vtid2.u64)
            armValueText: (armValueC
                :symtab
                tid: (ztypes.tid.create from: vtid2.u64)
                arm: mn2
            )
            if armValueText.length > 0 then return armValueText
            e8: "((\{vc2}_t){ .tag = \{tg2} })"
            return e8
        }
    }
    return "".string
}

# dottedAtomRecClsBase -- a user record or class base. Array and str monos are
# RECORD typetype and collection monos are CLASS typetype, but both keep their
# own legs, so both are excluded by origin here.
dottedAtomRecClsBase: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    bn2: StringView
    mn2: StringView
    bn2v: ztypes.vid
    bstamp: ztypes.tid
    rtt: ztypes.ztypetype
} out String is {
    isRecOrCls: false
    if rtt == ztypes.ztypetype.recordType then {
        # array/str monos are RECORD typetype but keep their own legs
        # below (a.0 -> a.data[0]; str .length -> .len etc.).
        if (
            (originIsTid
                :symtab
                tid: bstamp
                originTid: (ctx.origins.get i: ogArray)
            ) ==
            false
        ) when (
            (originIsTid
                :symtab
                tid: bstamp
                originTid: (ctx.origins.get i: ogStr)
            ) ==
            false
        ) then isRecOrCls = true
    }
    if rtt == ztypes.ztypetype.classType then {
        # user classes only -- collection monos (List/Set/Map, with a
        # generic origin) keep their own dottedpath legs below.
        baseStampOrigin: originTidOf :symtab tid: bstamp
        if baseStampOrigin.isZero then isRecOrCls = true
    }
    if isRecOrCls then {
        utm: (emitUserTypeMemberRead
            :ast
            :symtab
            :ctx
            :mn2
            :bn2
            :bn2v
            :bstamp
        )
        if utm.length > 0 then return utm
    }
    return "".string
}

# emitDottedAtomBase -- a read whose base is a bare ATOM with a stamped type: the
# native families (String / StringView / the collections / the id-keyed pair),
# then the user-type field and method legs. A base that is itself a path has no
# stamped atom and goes to emitDottedNestedBase instead.
emitDottedAtomBase: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    mn2: StringView
    bn2: StringView
    bn2r: StringView
    bn2v: ztypes.vid
    baseAtomVid: ztypes.vid
} out String is {
    eNum: dottedAtomNumericBase :bn2 :mn2
    if eNum.length > 0 then return eNum
    bnid2: interpPartNodeId n: (ast.nodes.get i: n.parent.u64)
    eCc: dottedAtomConstCloneBase :ast :symtab :ctx :bn2 :mn2
    if eCc.length > 0 then return eCc
    bareTid: chaseStrTypedef :symtab :ctx tid: (stampIdOf :symtab nid: bnid2)
    bareSv: bareTid == ctx.svTid
    bareStr: bareTid == ctx.strTid
    if bareStr when (isSvNoArgNative name: mn2) then {
        # String receivers project to a view for the no-arg SV
        # natives, mirroring the chained/auto-call legs
        needsAddM :ctx uname: "system" memb: mn2
        svfb: svValueForm :ctx expr: bn2 isStr: true vid: bn2v
        efb: "\{ctx.svC}_\{mn2}(&\{svfb})"
        return efb
    }
    eSv: emitSvAtomBase :ctx :bn2 :mn2 :bn2v :bareSv
    if eSv.length > 0 then return eSv
    if bareTid == ctx.strTid then {
        if mn2 == "length" then {
            sacc3: ".".string
            if (isPtrVid :ctx vid: bn2v) then sacc3 = "->".string
            e3: "\{bn2}\{sacc3}size"
            return e3
        }
    }
    eTg: dottedAtomTaggedBase :ast :symtab :ctx :mn2 :bn2r :baseAtomVid
    if eTg.length > 0 then return eTg
    bstamp0: stampIdOf :symtab nid: bnid2
    bstamp: bstamp0
    bsn0: regNameView :symtab tid: bstamp0
    bcid: canonFnId :ast :symtab :ctx tid: bstamp0 name: bsn0
    if bcid > 0 then {
        bstamp = ztypes.tid.create from: bcid
    } else {
        # canonicalize a SHELL (no defining unit) by name: a system type
        # like String reached via a fresh shell id resolves to the
        # registered class whose struct + methods are emitted (mirrors
        # the typeRefC canonicalization, so method cnames match).
        bduo: definedInUnitOf :symtab tid: bstamp0
        match (
            bduo
        ) case some then null case none then {
            brid: canonTypeId :ast :symtab :ctx tid: bstamp0 name: bsn0
            if brid > 0 then bstamp = ztypes.tid.create from: brid.u64
        }
    }
    bstamp = ztypes.tid.create from: (chaseColMono :symtab :ctx tid: bstamp)
    bstamp = ztypes.tid.create from: (chaseStrTypedef :symtab :ctx tid: bstamp)
    rtt: symtab.reg.typetypeOf typeId: bstamp
    if (isDispatchableTid :symtab tid: bstamp) then {
        if (vtableAutoCallName name: mn2) then {
            pacc: ".".string
            if (isPtrVid :ctx vid: bn2v) then pacc = "->".string
            return (vtableAutoCallC
                recv: bn2
                acc: pacc.stringView
                mn: mn2
                isFacet: rtt == ztypes.ztypetype.facetType
            )
        }
    }
    eRc: dottedAtomRecClsBase :ast :symtab :ctx :bn2 :mn2 :bn2v :bstamp :rtt
    if eRc.length > 0 then return eRc
    # a UNION reads its payload through legs further down, but the question of
    # whether the member is a METHOD at all is the same one the variant leg asks
    if rtt == ztypes.ztypetype.unionType then {
        eSmU: sumMemberMethodRead :ast :symtab :ctx :mn2 :bn2 :bn2v :bstamp
        if eSmU.length > 0 then return eSmU
    }
    if rtt == ztypes.ztypetype.variantType then {
        eSm: sumMemberMethodRead :ast :symtab :ctx :mn2 :bn2 :bn2v :bstamp
        if eSm.length > 0 then return eSm
        armDaP: memberCPrefix name: mn2
        e: "\{bn2}.data.\{armDaP}\{mn2}"
        return e
    }
    cmr: (emitCollectionMemberRead
        :ast
        :symtab
        :ctx
        :n
        :mn2
        :bn2
        :bn2v
        :bstamp
    )
    if cmr.length > 0 then return cmr
    return "".string
}

# emitDottedUnitRead -- a read whose BASE names a unit: another unit's constant
# inlines its rendered C text, a unit-qualified type path constructs, and a
# zero-argument function member of a unit or namespace auto-calls. A base naming a
# top-level unit may ALSO name a nested unit of the one being emitted, and the
# nested one is nearer -- it is what the checker bound.
emitDottedUnitRead: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.dottedpathrow.view
} out String is {
    # `unit.CONST` -- a constant of another unit inlines its rendered C
    # text, exactly as a bare reference to a constant of this unit does
    {
        ucv: unitConstTextOf :ast :symtab :ctx :n
        if ucv.length > 0 then return ucv
    }
    # a stamped implicit zero-create on a unit-qualified type path
    # (`unit.Conf`) constructs like the bare-atom legs
    izd: symtab.typing.implicitCreate.get key: n.nodeid.u64
    match (
        izd
    ) case some then {
        dzn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        dzc: (scalarCTypeFor
            :symtab
            name: dzn.stringView
            tid: (ztypes.tid.create from: izd.u64)
        )
        if dzc.length > 0 then return "((\{dzc})0)"
        if izd == ctx.strTid then return (emitExprStrZero :ctx)
        dzb: symtab.typing.typedefBaseName.get key: izd
        match (
            dzb
        ) case some then {
            dzbId: zast.nameid
            dzbId = dzb
            dzbT: zast.poolTextAt pool: ast.names ref: dzbId
            if dzbT.stringView == "String" then return (emitExprStrZero :ctx)
        } case none then null
        dzt: typedefChaseC :ast :symtab :ctx tid: (ztypes.tid.create from: izd.u64)
        if dzt.length > 0 then return "((\{dzt})0)"
        dzm: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: izd.u64)
        if dzm != izd then {
            dzmc: ctxCname :ctx tid: (ztypes.tid.create from: dzm.u64)
            if (isListOriginOf :symtab :ctx tid: (ztypes.tid.create from: dzm.u64)) then {
                return "\{dzmc}_create((uint64_t)0)"
            }
            return "\{dzmc}_create()"
        }
        return (emitCtorDefaultsFill :ast :symtab :ctx tid: (ztypes.tid.create from: izd.u64))
    } case none then null
    dpUb: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
    dpUbId: atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64)
    dpIsFile: false
    if (ztypecheck.isUnitNameDecl
        st: symtab
        nameId: dpUbId
    ) then dpIsFile = true
    # A base that names a top-level unit may ALSO name a nested unit of the
    # unit being emitted, and the nested one is nearer -- it is what the
    # checker bound. Deciding by the name alone let the emitter call the
    # other unit's member, with no diagnostic anywhere.
    if dpIsFile then {
        dpEncl: ctx.nsTid
        if dpEncl.isZero then dpEncl = (unitTidOf
            :ast
            :symtab
            unitName: ctx.mainName.stringView
        )
        dpOwn: unitChildTidOf :symtab parentTid: dpEncl nameId: dpUbId
        if dpOwn.isZero == false then dpIsFile = false
    }
    # a zero-argument function member reads as a dotted path, not a call,
    # so a namespace's own needs the by-id route here too
    dpNsTid: ztypes.tid
    if dpIsFile == false then dpNsTid = pathUnitTidOf :ast :symtab :ctx baseId: n.parent
    if dpIsFile when dpNsTid.isZero then {
        ud6x: ztypecheck.unitDeclOfName st: symtab nameId: dpUbId
        dpUfo: (ztypecheck.resolvedByIdsRo
            :ast
            st: symtab
            unitDecl: ud6x
            name: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        )
        match (
            dpUfo
        ) case some then {
            # a `fold` native has no implementation to call: the compiler was to
            # have answered it while type checking. Reaching here means the read
            # sat where the constant evaluator never visited, and the leg below
            # would emit the plain cname with parens -- which is how this failed
            # before it was checked: `implicit declaration of function 'z_t12'`,
            # a mangled name that never mentions the declaration.
            {
                dpCn: (zast.nameTextAt
                    :ast
                    ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
                )
                dpFp: dpUb.copy
                dpFp.append "."
                dpFp.append dpCn
                if (nativeIsFoldRow :ctx path: dpFp.stringView) then {
                    (emitFail
                        :ctx
                        what: "'\{dpFp}' is a fold native: nothing folded it, and there is no implementation to call"
                        line: n.lineno
                    )
                    return "".string
                }
            }
            # only a bodied + demanded non-native fn earns the id-cname
            # reference / auto-call route here, whichever unit declares it
            dpOk: (stdFnRefEmittable
                :ast
                :symtab
                fid: (ztypes.tid.create from: dpUfo.u64)
            )
            if dpOk when (
                (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: dpUfo.u64)) ==
                ztypes.ztypetype.functionType
            ) then {
                dpUfc: ctxCname :ctx tid: (ztypes.tid.create from: dpUfo.u64)
                # a node stamped FUNCTION is a fn REFERENCE (a .take peel
                # delegates here): the bare cname, like the atom leg
                dpStamp: stampIdOf :symtab nid: n.nodeid.u64
                if dpStamp > 0 then {
                    if (
                        (symtab.reg.typetypeOf typeId: dpStamp) == ztypes.ztypetype.functionType
                    ) then {
                        return dpUfc
                    }
                }
                dpAd: (emitAllDefaultedCall
                    :ast
                    :symtab
                    :ctx
                    fnTid: (ztypes.tid.create from: dpUfo.u64)
                    fcn: dpUfc.stringView
                )
                if dpAd.length > 0 then return dpAd
                return "\{dpUfc}()"
            }
        } case none then null
    }
    if dpNsTid.isZero == false then {
        nfo: (symtab.typing.declChildOfId
            parentTypeId: dpNsTid
            nameId: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        )
        match (
            nfo
        ) case some then {
            nftid: ztypes.tid.create from: nfo
            if (symtab.reg.typetypeOf typeId: nftid) == ztypes.ztypetype.functionType then {
                nfcn: ctxCname :ctx tid: nftid
                nfs: stampIdOf :symtab nid: n.nodeid.u64
                if nfs > 0 then {
                    if (
                        (symtab.reg.typetypeOf
                            typeId: nfs
                        ) ==
                        ztypes.ztypetype.functionType
                    ) then return nfcn
                }
                nfad: (emitAllDefaultedCall
                    :ast
                    :symtab
                    :ctx
                    fnTid: nftid
                    fcn: nfcn.stringView
                )
                if nfad.length > 0 then return nfad
                return "\{nfcn}()"
            }
        } case none then null
    }
    return "".string
}

# emitDottedConversionRead -- a cross-unit bare construction, and the two deep
# conversions `.copy` and `.string`, whose shape depends on the receiver family:
# a String clones its buffer, a container clones per element, a valtype is a
# bitwise copy, and a generic parameter's copy is chosen per instance.
emitDottedConversionRead: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.dottedpathrow.view
} out String is {
    mnc0Id: aliasOrChildId :ast :symtab aliasId: n.nodeid childId: n.child
    dps: ast.nodes.get i: n.parent.u64
    ccbc: emitCrossUnitBareCreate :ctx :ast :symtab parent: dps childId: mnc0Id
    if ccbc.length > 0 then return ccbc
    if (mnIs :ctx id: mnc0Id at: mnCopy) then {
        # `.copy` on a generic-param field inside a clone body: the node
        # carries no concrete stamp, so resolve the field's SUBSTITUTED
        # type through the current receiver mono. Only the clone-resolved
        # case is claimed here -- concrete receivers keep their legs.
        cvp: stampIdOf :symtab nid: (interpPartNodeId n: (ast.nodes.get i: n.parent.u64))
        cvgen: cvp.isZero
        if (symtab.reg.typetypeOf typeId: cvp) == ztypes.ztypetype.genericParam then cvgen = true
        # A CONCRETE valtype receiver takes the same lowering the resolved
        # generic leg below gives it: the value itself, copied by the
        # assignment or argument it feeds.
        if cvgen == false when cvp > 0 then {
            cvvt: symtab.reg.typetypeOf typeId: cvp
            cvval: false
            if cvvt == ztypes.ztypetype.recordType then cvval = true
            if cvvt == ztypes.ztypetype.variantType then cvval = true
            if cvvt == ztypes.ztypetype.facetType then cvval = true
            # An as-block `copy` OVERRIDES the default, so the default may
            # only be claimed when the type declares none -- otherwise the
            # author's method is silently skipped.
            if cvval then {
                cvown: (symtab.typing.declChildOf
                    pool: ast.names
                    parentTypeId: cvp
                    name: "copy"
                )
                match (
                    cvown
                ) case some then {
                    cvval = false
                } case none then null
            }
            if cvval when (symtab.reg.needsDestructor typeId: cvp) == false then {
                # the value itself -- but a POINTER receiver is not one yet.
                # Asked BEFORE the expression is built so the common path keeps
                # handing emitExpr's result straight back: binding it to a local
                # first costs a String on every `.copy` in the program.
                if (needsValueDeref
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: n.parent.u64)
                    tid: cvp
                ) then {
                    cvd: "(*\{emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)})"
                    return cvd
                }
                return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
            }
        }
        cvres: false
        if cvgen then {
            # the checker's per-mono instance walk side-stamps template
            # nodes with the substituted type
            cvms: (monoStampIdOf
                :symtab
                :ctx
                nid: (interpPartNodeId n: (ast.nodes.get i: n.parent.u64))
            )
            if cvms > 0 then {
                cvp = cvms
                cvres = true
            }
        }
        if cvres then {
            if cvp == ctx.svTid then {
                return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
            }
            cvtt: symtab.reg.typetypeOf typeId: cvp
            cvstr: cvp == ctx.strTid
            if (originIsTid
                :symtab
                tid: cvp
                originTid: (ctx.origins.get i: ogStr)
            ) then cvstr = true
            cvref: false
            if cvtt == ztypes.ztypetype.classType then cvref = true
            if cvtt == ztypes.ztypetype.unionType then cvref = true
            if cvtt == ztypes.ztypetype.protocolType then cvref = true
            if cvstr then cvref = true
            if cvref == false when (symtab.reg.needsDestructor typeId: cvp) == false then {
                return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
            }
            if cvstr then {
                cvpv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
                if (isNonLvalueArg s: cvpv.stringView) == false then {
                    cvpn: ast.nodes.get i: n.parent.u64
                    cvan2: atomTextDeep :ast n: cvpn
                    cvav: atomVid :symtab nid: (atomNodeIdDeep :ast n: cvpn)
                    if cvan2.length > 0 when (isPtrVid :ctx vid: cvav) then {
                        return "\{ctx.strC}_copy(\{cvpv})"
                    }
                    return "\{ctx.strC}_copy(&\{cvpv})"
                }
            }
            if cvgen then {
                cvtn: ctxCname :ctx tid: cvp
                (emitFail
                    :ctx
                    what: "unsupported .copy of type \{cvtn} in a generic body"
                    line: n.lineno
                )
                return "/* zemitterc: unhandled copy */0".string
            }
        } else if cvgen when ctx.curThisTid > 0 then {
            (emitFail
                :ctx
                what: "unresolved .copy receiver in a generic body".string
                line: n.lineno
            )
            return "/* zemitterc: unhandled copy */0".string
        }
    }
    if mnc0Id == zast.names.wkString then {
        scl: bindLitIndex :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
        if scl > 0 then {
            se0: "\{ctx.strC}_from_view(_zs\{scl})"
            return se0
        }
        if (stampIsSv :symtab :ctx nid: n.parent.u64) then {
            sbv0: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
            se1: "\{ctx.strC}_from_view(\{sbv0})"
            return se1
        }
    }
    xpb: dottedBaseAtom :ast n: (ast.nodes.get i: n.parent.u64)
    xpt: dottedChildText :ast n: (ast.nodes.get i: n.parent.u64)
    xar: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
    xtag: (emitCrossUnitTag
        :ast
        :symtab
        :ctx
        pbase: xpb
        ptype: xpt
        arm: xar.stringView
    )
    if xtag.length > 0 then return xtag
    return "".string
}

# emitDottedTagRead -- the three tagged-type stamps the checker leaves on a dotted
# path: a construction reference (`Type.arm`), an arm PREDICATE on a value
# receiver (a tag test), and an explicit tag-accessor read. A bool receiver is a
# C bool with no tag field, so its VALUE is its discriminator.
emitDottedTagRead: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    # the member, as an id: the two legs that SPELL an arm name copy it there,
    # and the common path -- a dotted read that is neither a tagged
    # construction nor an arm predicate -- copies nothing
    mnc0Id: zast.nameid
} out String is {
    # tagged-construction stamp: the typechecker resolved this path as
    # `Type.arm`, so member emission wins over the name-matched legs
    # below (io/os bases, ownership markers, numeric casts). Null-payload
    # arms emit the tag; payload arms and generic templates fall through
    # (construction calls and inference are handled by later legs).
    dtp: dottedTaggedTid :symtab nid: n.nodeid.u64
    if dtp > 0 then {
        mnc0: zast.nameTextAt :ast ref: mnc0Id
        dtg: false
        if (
            (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: dtp.u64)) ==
            ztypes.ztypetype.variantType
        ) then dtg = true
        if (
            (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: dtp.u64)) ==
            ztypes.ztypetype.unionType
        ) then dtg = true
        if dtg when (
            (isGenericType
                :symtab
                tid: (ztypes.tid.create from: dtp.u64)
            ) ==
            false
        ) then {
            vcH: ctxCname :ctx tid: (ztypes.tid.create from: dtp.u64)
            if vcH.length > 0 then {
                pcH: (armPayloadC
                    :ast
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: dtp.u64)
                    arm: mnc0.stringView
                )
                if pcH.length == 0 then {
                    tgH: (variantTag
                        :symtab
                        tid: (ztypes.tid.create from: dtp.u64)
                        arm: mnc0.stringView
                    )
                    avh: (armValueC
                        :symtab
                        tid: (ztypes.tid.create from: dtp.u64)
                        arm: mnc0.stringView
                    )
                    if avh.length > 0 then return avh
                    eH: "((\{vcH}_t){ .tag = \{tgH} })"
                    return eH
                }
            }
        }
    }
    # arm predicate on a VALUE receiver: the typechecker stamped
    # dpArmPredicate, so the path is a tag test. A bool receiver is a
    # C bool (no tag field): identity for `.true`, negation for
    # `.false`.
    dap: dottedArmPredicateTid :symtab nid: n.nodeid.u64
    if dap > 0 then {
        recvP: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
        # an ordinal's discriminator IS its value, so a receiver reached through a
        # pointer is LOADED before it is tested. The struct-shaped families read a
        # `tag` FIELD instead and chain with `->`, which is what accP is for.
        ptrP: (pathIsPointer :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
        valP: recvP.copy
        if ptrP then {
            dP: "(*\{recvP})"
            valP = dP
        }
        if (isOrdinalPair :symtab tid: (ztypes.tid.create from: dap.u64)) then {
            fa: (ordinalPairFirstArmId
                :symtab
                tid: (ztypes.tid.create from: dap.u64)
            )
            # the arm NAME resolved through any alias, as an id
            if fa > 0 when mnc0Id.u64 == fa then return "(!(\{valP}))"
            return "(\{valP})"
        }
        accP: ".".string
        rootP: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
        if rootP.length > 0 then {
            rpn: atomNodeId n: (ast.nodes.get i: n.parent.u64)
            if (isPtrVid :ctx vid: (atomVid :symtab nid: rpn)) then accP = "->".string
        }
        mnc0P: zast.nameTextAt :ast ref: mnc0Id
        tgP: variantTag :symtab tid: (ztypes.tid.create from: dap.u64) arm: mnc0P.stringView
        # an ordinal IS its discriminator: compare the value, not a field
        if (isOrdinalVariant
            :symtab
            tid: (ztypes.tid.create from: dap.u64)
        ) then return "((\{valP}) == \{tgP})"
        eP: "((\{recvP})\{accP}tag == \{tgP})"
        return eP
    }
    # explicit tag-accessor read: the discriminator cast to the declared
    # numeric type. A bool receiver is a C bool with no tag field -- the
    # bool VALUE is its discriminator.
    dtr: dottedTagReadTid :symtab nid: n.nodeid.u64
    if dtr > 0 then {
        recvT: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
        tatE: ztypes.tid
        tato: symtab.typing.tagAccessorTid.get key: (ztypes.tid.create from: dtr.u64)
        match (
            tato
        ) case some then {
            tatE = ztypes.tid.create from: tato
        } case none then null
        castT: (typeRefC
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: tatE.u64)
            thisTid: ztypes.tid
        )
        if (isOrdinalVariant
            :symtab
            tid: (ztypes.tid.create from: dtr.u64)
        ) then {
            if (pathIsPointer :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)) then {
                dT: "((\{castT})(*\{recvT}))"
                return dT
            }
            return "((\{castT})(\{recvT}))"
        }
        accT: ".".string
        rootT: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
        if rootT.length > 0 then {
            rtn: atomNodeId n: (ast.nodes.get i: n.parent.u64)
            if (isPtrVid :ctx vid: (atomVid :symtab nid: rtn)) then accT = "->".string
        }
        eT: "((\{castT})(\{recvT})\{accT}tag)"
        return eT
    }
    return "".string
}

# emitDottedNativeMarker -- a data block's element read, a zero-parameter native
# that auto-calls (io.stdout, os.pid), the compile-time markers `.private` /
# `.borrow` / `.take`, and a runtime numeric conversion. The conversion is whichever
# member resolves to a row on the SOURCE type, so a user field merely NAMED `u32`
# finds nothing and takes the member legs instead.
emitDottedNativeMarker: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    bn2r: StringView
} out String is {
    mn2Id: aliasOrChildId :ast :symtab aliasId: n.nodeid childId: n.child
    # a data block's element read (`codes.ht`, `consts.codes.ht`, `primes.0`):
    # the block is the base's stamped type, whatever shape the base takes;
    # no base is emitted
    dpbT: stampIdOf :symtab nid: (interpPartNodeId n: (ast.nodes.get i: n.parent.u64))
    if dpbT > 0 then {
        if (symtab.reg.typetypeOf typeId: dpbT) == ztypes.ztypetype.dataType then {
            mn2d: zast.nameTextAt :ast ref: mn2Id
            dres0: emitDataMember :ast :symtab :ctx :n dbt: dpbT mn2: mn2d
            if dres0.length > 0 then return dres0
        }
    }
    # a zero-parameter native read without parens auto-calls: the member's
    # DECLARATION says so, so io.stdout and os.pid take one leg and no
    # name is listed
    nnu: (nativeNoArgOf
        :ast
        :symtab
        unitName: ctx.mainName.stringView
        baseId: (atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
        base: bn2r
        membId: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
    )
    if nnu.length > 0 then {
        mn2n: zast.nameTextAt :ast ref: mn2Id
        needsAddM :ctx uname: nnu.stringView memb: "@unit"
        needsAddM :ctx uname: nnu.stringView memb: mn2n.stringView
        return "z_\{nnu}_\{mn2n}()"
    }
    # `.private` is a compile-time friend marker -- it emits the receiver itself.
    if (mnIs :ctx id: mn2Id at: mnPrivate) then {
        return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
    }
    # `.borrow` on a value is the ownership marker, and the checker accepts it
    # as one. A protocol or facet declares a real `borrow` projection, so the
    # split is drawn here off the base type exactly as checkBorrowLeg draws it
    # -- one discriminator, so the two cannot disagree.
    if (mnIs :ctx id: mn2Id at: mnBorrow) then {
        bmk: true
        bttB: symtab.reg.typetypeOf typeId: dpbT
        if bttB == ztypes.ztypetype.protocolType then bmk = false
        if bttB == ztypes.ztypetype.facetType then bmk = false
        if bmk then {
            bcoB: symtab.typing.declChildOfId parentTypeId: dpbT nameId: zast.names.wkBorrow
            match (
                bcoB
            ) case some then {
                if (
                    (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: bcoB.u64)) ==
                    ztypes.ztypetype.functionType
                ) then bmk = false
            } case none then null
        }
        if bmk then return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
    }
    # `.take` on a heap reftype (String / union / by-value class) is an
    # ownership MOVE: emit the base value. The statement-level emitter zeroes
    # the source after the call so its scope-exit free is a no-op (the callee
    # now owns the heap). A borrowed pointer-param class is not a move source.
    isMoveM: false
    {
        mn2b: zast.nameTextAt :ast ref: mn2Id
        isMoveM = ztypecheck.isMoveMarker name: mn2b.stringView
    }
    if isMoveM then {
        tknid: atomNodeId n: (ast.nodes.get i: n.parent.u64)
        if tknid == 0 then tknid = n.parent.u64
        tkt: stampIdOf :symtab nid: tknid
        isMove: false
        if tkt == ctx.strTid then isMove = true
        if (symtab.reg.typetypeOf typeId: tkt) == ztypes.ztypetype.unionType then isMove = true
        if (symtab.reg.typetypeOf typeId: tkt) == ztypes.ztypetype.classType then {
            tkv: atomVid :symtab nid: tknid
            if (isPtrVid :ctx vid: tkv) == false then isMove = true
        }
        if (symtab.reg.typetypeOf typeId: tkt) == ztypes.ztypetype.functionType then isMove = true
        if isMove then return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
    }
    # a runtime numeric conversion `<expr>.<numtype>` is whichever member
    # resolves to a conversion ROW on the source type -- so a user record's
    # field merely NAMED `u32` finds nothing and takes the member legs, with
    # no separate shadow test to keep in step. A typedef converts as its
    # chain end, which is where the declaration lives. Folded literal
    # conversions return earlier via nodeConstText.
    # the member half of the conversion question first: it needs neither the
    # source type nor the path built from it, and a member that names no
    # conversion is what nearly every dotted marker carries
    ncSrcP: String
    ncKey: String
    ncHas: false
    isConvM: false
    {
        mn2c: zast.nameTextAt :ast ref: mn2Id
        isConvM = nativeIsConvMembOf :ctx memb: mn2c.stringView
    }
    # a member the RECEIVER'S OWN type declares with a body the author wrote
    # wins over any conversion its typedef chain end would offer. A typedef
    # converts as its chain end, which is where the conversion is declared --
    # but that is only true of the conversions THEMSELVES, which the numeric
    # types declare `is native`. A record over `i64.typedef` that declares its
    # own `u32` declared a method, and the chase would answer with i64's
    # conversion instead of calling it.
    if isConvM then {
        ownTid9: (stampIdOf
            :symtab
            nid: (interpPartNodeId n: (ast.nodes.get i: n.parent.u64)).u64
        )
        mo9: symtab.typing.declChildOfId parentTypeId: ownTid9 nameId: mn2Id
        match (
            mo9
        ) case some then {
            mf9: ztypes.tid.create from: mo9
            if (fnIsNativeId :symtab fid: mf9) == false then isConvM = false
        } case none then null
    }
    if isConvM then {
        ncChase: (typedefChaseTid
            :symtab
            tid: (stampIdOf
                :symtab
                nid: (interpPartNodeId n: (ast.nodes.get i: n.parent.u64)).u64
            )
        )
        ncSrcP = convSrcPathOf :symtab srcTid: ncChase
        if ncSrcP.length > 0 then {
            mn2v: zast.nameTextAt :ast ref: mn2Id
            ncKey = nativeMemberKey srcPath: ncSrcP.stringView memb: mn2v.stringView
            ncHas = nativeHasRow :ctx path: ncKey.stringView
        }
    }
    if ncHas then {
        mn2k: zast.nameTextAt :ast ref: mn2Id
        ncVal: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
        if (pathIsPointer :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)) then {
            ncDeref: "(*\{ncVal})"
            ncVal = ncDeref.copy
        }
        ncRet: stampIdOf :symtab nid: n.nodeid.u64
        ncRetM: chaseColMono :symtab :ctx tid: ncRet
        return (emitNumericCast
            :ctx
            dstName: mn2k.stringView
            val: ncVal.stringView
            :symtab
            retTid: (ztypes.tid.create from: ncRetM.u64)
            key: ncKey.stringView
        )
    }
    return "".string
}


# emitDottedRead -- the C text of a dotted PATH read (the call form is
# emitDottedCall). The legs run in the order the checker's stamps settle them:
# built-in combinators, unit-qualified reads, the conversions, the tagged-type
# stamps, the markers, and only then the member families.
emitDottedRead: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.dottedpathrow.view
} out String is {
    # built-in `.orPanic` on a resultval/Result receiver -- any base
    # (a bound var, or a chained call/conversion), emitted via emitExpr so
    # the receiver value is materialized once. `.or d:` is a call node and
    # is handled by emitResultCombinator in the call dispatch instead.
    # the member is asked by ID: the legs below lend ast, and an id is a scalar
    dcMnId: atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64)
    if (mnIs :ctx id: dcMnId at: mnOrPanic) then {
        pStamp: stampIdOf :symtab nid: (interpPartNodeId n: (ast.nodes.get i: n.parent.u64))
        pMono: chaseColMono :symtab :ctx tid: pStamp
        pOrig: monoOriginName :symtab tid: (ztypes.tid.create from: pMono.u64)
        isRcc: false
        if pOrig.stringView == "resultval" then isRcc = true
        if isRcc then {
            rcRecv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
            okTagX: variantTag :symtab tid: (ztypes.tid.create from: pMono.u64) arm: "ok"
            rcT: ctxCname :ctx tid: (ztypes.tid.create from: pMono.u64)
            return "({ \{rcT}_t _rc = (\{rcRecv.stringView}); if (_rc.tag != \{okTagX.stringView}) z_panic(\"orPanic: result is err\"); _rc.data.ok; })"
        }
    }
    dur: emitDottedUnitRead :ast :symtab :ctx :n
    if dur.length > 0 then return dur
    dcr: emitDottedConversionRead :ast :symtab :ctx :n
    if dcr.length > 0 then return dcr
    dtg: (emitDottedTagRead
        :ast
        :symtab
        :ctx
        :n
        mnc0Id: (aliasOrChildId :ast :symtab aliasId: n.nodeid childId: n.child)
    )
    if dtg.length > 0 then return dtg
    bn2r: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
    baseAtomVid: atomVid :symtab nid: (atomNodeId n: (ast.nodes.get i: n.parent.u64))
    bn2a: aliasResolve :ctx name: bn2r.stringView vid: baseAtomVid
    # the receiver's variable, for the pointer-access checks below. An alias
    # substitution means the base binding is not what is being read, so the
    # vid stays 0 and bn2 becomes the substituted text.
    bn2v: ztypes.vid
    if bn2a.stringView == bn2r.stringView then {
        bn2v = (atomVid :symtab nid: (atomNodeId n: (ast.nodes.get i: n.parent.u64)))
    }
    bn2: emitLocalAtomName :ctx name: bn2r.stringView vid: baseAtomVid
    # a base with no atom NAME still has a stamped type. Every native leg
    # below sits behind `bn2.length > 0`, so a projection ((zast.poolTextAt pool: ast.names ref: h.text).stringView)
    # or a call (s.trim, (mk s: s)) skipped the lot and fell through to the
    # user-method path, which renders the callee as the method's
    # function-type id -- a symbol nothing defines. emitDottedCall already
    # carries this leg for the CALL form; the READ form never got it.
    if bn2.length == 0 then {
        nbId: interpPartNodeId n: (ast.nodes.get i: n.parent.u64)
        nbT: chaseStrTypedef :symtab :ctx tid: (stampIdOf :symtab nid: nbId)
        # StringView only: svValueForm reads a String receiver's expression
        # twice, once for .data and once for .size, and twice is a second
        # evaluation when the expression is a call.
        if nbT == ctx.svTid then {
            nbX: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
            if nbX.length > 0 then {
                # `&` needs an lvalue. A compound literal is one; a call is
                # not, so it binds to a temp the statement flush declares.
                nbH: isNonLvalueArg s: nbX.stringView
                if nbX.stringView.startsWith "((" then nbH = false
                if nbH then {
                    nbTmp: (hoistLvalue
                        :ast
                        :symtab
                        :ctx
                        av: nbX.stringView
                        tid: (ztypes.tid.create from: nbT.u64)
                    )
                    if nbTmp.length > 0 then nbX = nbTmp.copy
                }
                bn2 = nbX.copy
            }
        }
    }
    dnm: (emitDottedNativeMarker
        :ast
        :symtab
        :ctx
        :n
        bn2r: bn2r.stringView
    )
    if dnm.length > 0 then return dnm
    mn2: aliasOrChild :ast :symtab aliasId: n.nodeid childId: n.child
    if bn2.length > 0 then {
        aba: (emitDottedAtomBase
            :ast
            :symtab
            :ctx
            :n
            :mn2
            bn2: bn2.stringView
            bn2r: bn2r.stringView
            :bn2v
            :baseAtomVid
        )
        if aba.length > 0 then return aba
    }
    return (emitDottedNestedBase :ast :symtab :ctx :n :mn2)
}

# emitExpr -- the C expression text for a node (calls inline; the scalar
# examples carry no order-sensitive multi-call arguments).
emitExpr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
} out String is {
    cv: (nodeConstText
        :ast
        :symtab
        :ctx
        nid: (zast.nodeid.create from: (interpPartNodeId :n).u32.orPanic)
    )
    if cv.length > 0 then return cv
    match (
        n
    ) case expression then {
        return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.statementline.u64))
    } case statement then {
        if n.statements.count.u64 == 1 then {
            s0Id: zast.kidAt kids: ast.kids span: n.statements i: 0
            return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: s0Id.u64))
        }
        emitFail :ctx what: "unhandled expr (multi-statement)".string line: n.lineno
        return "/* zemitterc: unhandled expr */0".string
    } case atomid then {
        return (emitAtom :ast :symtab :ctx :n)
    } case labelvalue then {
        lvC: ast.names.texts.get i: n.name.u64
        lvv: atomVid :symtab nid: n.nodeid.u64
        return (emitLocalAtomName :ctx name: lvC.stringView vid: lvv)
    } case dottedpath then {
        return (emitDottedRead :ast :symtab :ctx :n)
    } case atomstring then {
        li: litIndexOf :ctx nid: n.nodeid.u64
        if li > 0 then {
            se: "_zs\{li}"
            return se
        }
        emitFail :ctx what: "unhandled atomstring expr".string line: n.lineno
        return "/* zemitterc: unhandled atomstring expr */0".string
    } case ifexpr then {
        # a chain whose every condition folds has ONE live branch: emit its
        # value alone. spec.pdoc, Conditional Compilation, promises the false
        # branch is not emitted, and that promise is not limited to statement
        # position.
        vfb: foldedBranchOf :symtab nid: n.nodeid.u64
        if vfb.known then {
            if vfb.stmt.isZero == false then {
                return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: vfb.stmt.u64))
            }
        }
        tx: String
        depth: u64
        clx959: u64
        for clx959 < n.clauses.count.u64 loop {
            cId: zast.kidAt kids: ast.kids span: n.clauses i: clx959
            clx959 = clx959 + 1
            c9r: ast.nodes.get i: cId.u64
            cx: ternaryClause :ast :symtab :ctx c: c9r
            tx.append cx
            depth = depth + 1
        }
        ex: ternaryElse :ast :symtab :ctx oId: n.elseclause
        tx.append ex
        dk: u64
        for dk < depth loop {
            tx.append ")"
            dk = dk + 1
        }
        return tx
    } case binop then {
        l: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.lhs.u64)
        op: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.operator.u64))
        r: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.rhs.u64)
        if (nodeIsAtomBox
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.lhs.u64)
        ) then l = "(*\{l})"
        if (nodeIsAtomBox
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.rhs.u64)
        ) then r = "(*\{r})"
        return (emitBinop :ast :symtab :ctx binop: n :l :r op: op.stringView)
    } case call then {
        return (emitCallValue :ast :symtab :ctx call: n)
    } else {
        emitFail :ctx what: "unhandled expr".string line: (ztypecheck.nodeLine :n)
        return "/* zemitterc: unhandled expr */0".string
    }
}

# emitBinop -- emit a binary operator by asking what it RESOLVED to, never
# what it was spelled. The type checker recorded the type that declares the
# operator and the method it found; from those the operator is one of three
# things, and the operator's text is a lookup key rather than a branch:
#
#   the author wrote it   -- an ordinary method call, negated for an inequality
#                            derived from a declared equality
#   the runtime owns it   -- a natives.tbl row, keyed by qualified path
#   nobody declared it    -- the synthesised structural compare, keyed by the
#                            shape the emitter would otherwise have built
#
# The receiver-shape derivations stay here because they choose WHICH row
# applies and what its operands look like; the C itself lives in the table.
emitBinop: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    binop: zast.binoprow.view
    l: String
    r: String
    op: StringView
} out String is {
    ow9: binopOwnerAt :symtab :ctx nid: binop.nodeid.u64
    mt9: binopMethodAt :symtab :ctx nid: binop.nodeid.u64
    oi9: atomNameIdOf :ast n: (ast.nodes.get i: binop.operator.u64)
    return (emitOperatorAt
        :ast
        :symtab
        :ctx
        lineno: binop.lineno
        opId: oi9
        owner: ow9
        method: mt9
        lhsNid: binop.lhs.u64
        rhsNid: binop.rhs.u64
        :l
        :r
        :op
    )
}

# emitOperatorAt -- emitBinop's body, driven by ids rather than by a binoprow.
# The infix form and the call form (`a.+ rhs: b`) are the SAME one-argument
# method, so they emit through here alike; only the node ids differ.
emitOperatorAt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    lineno: u32
    opId: zast.nameid
    owner: ztypes.tid
    method: ztypes.tid
    lhsNid: u64
    rhsNid: u64
    l: String
    r: String
    op: StringView
} out String is {
    if owner.isZero then {
        emitFail :ctx what: "operator '\{op}' resolved no declaring type" line: lineno
        return "/* zemitterc: unresolved operator */0".string
    }
    # a local: the derived-comparison leg below reassigns it
    call: method
    callName: opId
    neg: false
    # A DECLARED COMPARISON BEATS A SYNTHESISED ONE, IN EITHER DIRECTION. The
    # pair is generated per name now, so a type writing only `==` HAS a synth
    # `!=` member -- and taking it would silently give the STRUCTURAL answer
    # while `==` said something else. `!=` therefore prefers a declared `==`
    # and negates it, `==` prefers a declared `!=` and negates that, and only
    # when neither is written does the structural row answer. This also covers
    # `call.isZero`, the case where the member does not exist at all.
    mineSyn: true
    if call.isZero == false then {
        mineSyn = (symtab.typing.declMemberIsSynth parentTypeId: owner nameId: opId)
    }
    if mineSyn then {
        otherId: zast.names.wkOpEq
        if opId == zast.names.wkOpEq then otherId = zast.names.wkOpNe
        oo9: symtab.typing.declChildOfId parentTypeId: owner nameId: otherId
        match (
            oo9
        ) case some then {
            if (
                (symtab.typing.declMemberIsSynth
                    parentTypeId: owner
                    nameId: otherId
                ) ==
                false
            ) then {
                call = ztypes.tid.create from: oo9.u64
                callName = otherId
                neg = true
            }
        } case none then null
    }
    isNat: false
    isSyn: false
    if call > 0 then {
        isNat = fnIsNativeId :symtab fid: call
        isSyn = (symtab.typing.declMemberIsSynth
            parentTypeId: owner
            nameId: callName
        )
    }
    if call > 0 when isNat == false then {
        if isSyn == false then {
            # AN INTERFACE RECEIVER DISPATCHES. A binop is the call form for a
            # one-argument method, and taking the C name of the method it
            # resolves to would name the SPEC member for an interface, a
            # declaration with no body. The named call form on the same facet
            # emits `f.vtable->near(&f.data, a)`; a cname here calls a symbol
            # that does not exist.
            vd: (emitBinopVtableCall
                :ast
                :symtab
                :ctx
                :lhsNid
                :owner
                :callName
                lhs: l.stringView
                rhs: r.stringView
                :neg
            )
            if vd.length > 0 then return vd
            # a body the author wrote. Its receiver is a pointer like every
            # other method's, so address the lhs unless it already is one.
            cn: ctxCname :ctx tid: call
            recvText: l.copy
            if (
                (pathIsPointer
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: lhsNid)
                ) ==
                false
            ) then {
                # `&` needs an LVALUE, and a receiver that is itself a call is
                # not one -- `&f(x)` is rejected by C. Bind it to a temp the
                # statement flush declares. A compound literal already is an
                # lvalue and must not pay for a temp.
                lhsText: lvalueForm :ast :symtab :ctx av: l.stringView tid: owner
                amp: "&\{lhsText}"
                recvText = amp
            }
            if neg then {
                u1: "!\{cn}(\{recvText}, \{r})"
                return u1
            }
            u2: "\{cn}(\{recvText}, \{r})"
            return u2
        }
    }
    # A NATIVE NAMED METHOD IS NOT AN OPERATOR. The table holds inline bodies
    # for operators; a fragment-backed native like `startsWith` has none, so
    # asking for one reports "no native implementation" about a member that is
    # implemented. Emit the ordinary method call instead -- the mirror of
    # emitOperatorCallForm, which routes the other direction.
    if call > 0 when isNat then {
        eNi: (emitSvNativeInfix
            :ast
            :symtab
            :ctx
            :owner
            :lhsNid
            :rhsNid
            l: l.stringView
            r: r.stringView
            :op
        )
        if eNi.length > 0 then return eNi
    }
    key: binopKeyOf :ast :symtab :owner isNative: isNat :op
    body: nativeImplOf :ctx path: key.stringView
    if body.length == 0 then {
        emitFail :ctx what: "no native implementation for '\{key}'" line: lineno
        return "/* zemitterc: no native implementation */0".string
    }
    # A CONSTANT ARGUMENT MAY SELECT A DIFFERENT ROW. The table says which
    # positions a variant needs to be constant and the checker's value channel
    # says whether they are; neither the operator's spelling nor its meaning is
    # consulted here, so the C stays in the table where f34ecd07 put it.
    # the stamp is asked FIRST: it is a plain id lookup, where reaching the
    # table means building a key from a view. Most operands are not constants,
    # and those never touch the table at all.
    if (symtab.typing.nodeConst.has key: rhsNid) then {
        cbody: nativeConstImplOf :ctx path: key.stringView
        if cbody.length > 0 then {
            cpos: nativeConstPosOf :ctx path: key.stringView
            if (constPosIsFirstOnly pos: cpos.stringView) then body = cbody.copy
        }
    }
    nd: nativeNeedOf :ctx path: key.stringView
    if nd.length > 0 then needsAddM :ctx uname: "system" memb: nd.stringView
    # String and StringView reach one native: both project to a view, by value
    # for the compares and as an lvalue for the row that takes pointers.
    lf: l.copy
    rf: r.copy
    if (isStringyTid :ctx tid: owner) then {
        lt: stampNameDeep :ast :symtab n: (ast.nodes.get i: lhsNid)
        rt: stampNameDeep :ast :symtab n: (ast.nodes.get i: rhsNid)
        if (nativePtrArgsOf :ctx path: key.stringView) then {
            lf = (stringViewBinopOperand
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: lhsNid)
                expr: l.stringView
                tname: lt.stringView
            )
            rf = (stringViewBinopOperand
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: rhsNid)
                expr: r.stringView
                tname: rt.stringView
            )
        } else {
            lq: (atomVidIfPlain
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: lhsNid)
                text: l.stringView
            )
            rq: (atomVidIfPlain
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: rhsNid)
                text: r.stringView
            )
            lf = svValueForm :ctx expr: l.stringView isStr: (lt.stringView == "String") vid: lq
            rf = svValueForm :ctx expr: r.stringView isStr: (rt.stringView == "String") vid: rq
        }
    }
    # a typedef emits no helper of its own: the chain end owns it
    tcn: ctxCname :ctx tid: owner
    tdb: typedefChaseBaseName :ast :symtab tid: owner
    if tdb.length > 0 then {
        tcn = ctxCname :ctx tid: (typedefChaseTid :symtab tid: owner)
    }
    bn: List String
    bv: List String
    bn.append from: "StringView".string
    bv.append from: ctx.svC.copy
    bn.append from: "T".string
    bv.append from: tcn.copy
    rn: List String
    rv: List String
    rn.append from: "L".string
    rv.append from: lf.copy
    rn.append from: "R".string
    rv.append from: rf.copy
    return (fillHolesForCtx
        :ctx
        text: body
        path: key.stringView
        bindNames: bn
        bindVals: bv
        rawNames: rn
        rawVals: rv
    )
}

# emitInterpPrint -- the interpolated-print temp chain: create, per-part
# append (literal bytes or snprintf-formatted scalar), print, free.
emitInterpPrint: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    parts: zast.kidspan
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    sN: emitInterpBuild :ast :symtab :ctx :parts :ind :tmp :buf
    l1: "\{ind}\{ctx.strC}_print(&_s\{sN});\n"
    buf.append l1
    l2: "\{ind}\{ctx.strC}_free(&_s\{sN});\n"
    buf.append l2
}

# emitInterpBuild -- the create/append chain for an interpolated literal;
# returns the _sN temp index (caller prints/frees or binds it).
emitInterpBuild: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    parts: zast.kidspan
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    hoistFloor: 0.u64
    hoistRawFloor: 0.u64
} out u64 is {
    est: u64
    h5x9: u64
    for h5x9 < parts.count.u64 loop {
        pId: zast.kidAt kids: ast.kids span: parts i: h5x9
        h5x9 = h5x9 + 1
        p: ast.nodes.get i: pId.u64
        isC: false
        if p.stringchunk then {
            isC = true
            tl: (zast.poolTextAt pool: ast.names ref: p.text).length
            est = est + tl
        }
        if isC == false then est = est + 16
    }
    sN: tmp.next
    l0: "\{ind}\{ctx.strC}_t _s\{sN} = \{ctx.strC}_create((uint64_t)\{est});\n"
    buf.append l0
    h6x9: u64
    for h6x9 < parts.count.u64 loop {
        qId: zast.kidAt kids: ast.kids span: parts i: h6x9
        h6x9 = h6x9 + 1
        (emitInterpPart
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: qId.u64)
            :sN
            :ind
            :tmp
            :buf
            :hoistFloor
            :hoistRawFloor
        )
    }
    return sN
}

# the printf format specifier for a numeric type.
numericFormatName: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tn: StringView
} out String is {
    if (isIntName name: tn) then {
        r0: tn.string
        return r0
    }
    if (isFloatName name: tn) then {
        r1: tn.string
        return r1
    }
    tid: userFnId :ast :symtab :ctx name: tn
    if tid > 0 then {
        bc: typedefChaseC :ast :symtab :ctx :tid
        if bc.stringView == "double" then {
            return "f64".string
        } else if bc.stringView == "float" then {
            return "f32".string
        } else if bc.stringView == "_Float16" then {
            return "f16".string
        } else if bc.stringView == "__float128" then {
            return "f128".string
        } else if bc.length > 0 then return "i64".string
    }
    rr: tn.string
    return rr
}

# the element name for an indexed data-block access.
dataIndexElemName: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: astnode.view
} out String is {
    match (
        n
    ) case expression then {
        return (dataIndexElemName :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        mn: dottedChildText :ast n: (ast.nodes.get i: n.callable.u64)
        if mn == "index" then {
            dnid: dottedBaseNodeId :ast n: (ast.nodes.get i: n.callable.u64)
            dk: dataBlockTid :symtab nid: dnid
            go: ctx.dataElems.get key: dk
            match (
                go
            ) case some then {
                gv: go.stringView
                gc: gv.string
                return gc
            } case none then null
        }
        return "".string
    } else {
        return "".string
    }
}

# interpBaseIsMapEntry -- true when an interp part is `<entry>.key`/`.value`
# off a borrowed MapEntry: the projected String views the bucket, so it must
# be appended inline (freeing the hoisted copy would double-free the bucket
# key). All four entry forms project the same way.
interpBaseIsMapEntry: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case expression then {
        return (interpBaseIsMapEntry :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (interpBaseIsMapEntry :ast :symtab n: (ast.nodes.get i: n.statementline.u64))
    } case dottedpath then {
        bnid: atomNodeId n: (ast.nodes.get i: n.parent.u64)
        bt: stampIdOf :symtab nid: bnid
        meT: builtinTid :ast :symtab base: "MapEntry"
        if (originIsTid
            :symtab
            tid: bt
            originTid: (ztypes.tid.create from: meT.u64)
        ) then return true
        meRV: builtinTid :ast :symtab base: "MapEntryRV"
        if (originIsTid
            :symtab
            tid: bt
            originTid: (ztypes.tid.create from: meRV.u64)
        ) then return true
        ideR: builtinTid :ast :symtab base: "IdMapEntryR"
        if (originIsTid
            :symtab
            tid: bt
            originTid: (ztypes.tid.create from: ideR.u64)
        ) then return true
        ideV: builtinTid :ast :symtab base: "IdMapEntryV"
        if (originIsTid
            :symtab
            tid: bt
            originTid: (ztypes.tid.create from: ideV.u64)
        ) then return true
        meVR: builtinTid :ast :symtab base: "MapEntryVR"
        if (originIsTid
            :symtab
            tid: bt
            originTid: (ztypes.tid.create from: meVR.u64)
        ) then return true
        meVV: builtinTid :ast :symtab base: "MapEntryVV"
        if (originIsTid
            :symtab
            tid: bt
            originTid: (ztypes.tid.create from: meVV.u64)
        ) then return true
        return false
    } else {
        return false
    }
}

# interpBaseIsOwnedStructField -- a `<inst>.field` read off a user record/class:
# the projected String VIEWS the owner's field (freed by the owner's destructor),
# so it appends inline -- freeing a hoisted copy would double-free the field.
interpBaseIsOwnedStructField: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case expression then {
        expressionNode: ast.nodes.get i: n.expression.u64
        return (interpBaseIsOwnedStructField :ast :symtab n: expressionNode)
    } case statementline then {
        sln: ast.nodes.get i: n.statementline.u64
        return (interpBaseIsOwnedStructField :ast :symtab n: sln)
    } case dottedpath then {
        pnd: ast.nodes.get i: n.parent.u64
        bnid: atomNodeId n: pnd
        # A NESTED base (`b.it.name`) is itself a dotted path, not an atom, so
        # the atom lookup answers 0; its own stamp names the owner just as
        # well. Without this the read falls
        # through to the owned-call-result leg, which FREES the field's String
        # out from under its owner.
        if bnid == 0 then bnid = interpPartNodeId n: pnd
        bt: stampIdOf :symtab nid: bnid
        bo: originTidOf :symtab tid: bt
        # a user-generic mono owns its fields once it carries a destructor;
        # other monos (views, collections) keep the owned-call-result legs
        if bo > 0 then {
            if (symtab.reg.needsDestructor typeId: bt) == false then return false
        }
        btt: symtab.reg.typetypeOf typeId: bt
        isUC: false
        if btt == ztypes.ztypetype.recordType then isUC = true
        if btt == ztypes.ztypetype.classType then isUC = true
        if isUC == false then return false
        cn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        co: symtab.typing.declChildOf pool: ast.names parentTypeId: bt name: cn.stringView
        match (
            co
        ) case some then {
            if (
                (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: co.u64)) ==
                ztypes.ztypetype.functionType
            ) then {
                return false
            } else {
                return true
            }
        } case none then {
            return false
        }
    } else {
        return false
    }
}

# emit one part of a string interpolation.
emitInterpPart: function {
    hoistFloor: 0.u64
    hoistRawFloor: 0.u64
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    sN: u64
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    match (
        n
    ) case stringchunk then {
        tv: (zast.poolTextAt pool: ast.names ref: n.text).stringView
        esc: cEscape text: tv
        l3: "\{ind}\{ctx.strC}_append(&_s\{sN}, \"\{esc}\", sizeof(\"\{esc}\")-1);\n"
        buf.append l3
    } else {
        di0: dataIndexElemName :ast :symtab :ctx :n
        tn0: stampNameDeep :ast :symtab :n
        # the checker's per-mono instance walk side-stamps template nodes
        # the global table suppresses
        if tn0.length == 0 when ctx.curThisTid > 0 then {
            msid: monoStampIdOf :symtab :ctx nid: (interpPartNodeId :n)
            if msid > 0 then tn0 = regNameOf :symtab tid: msid
        }
        # a typedef part formats as its chain-end base
        tnTd0: typedefChaseBaseName :ast :symtab tid: (stampIdDeep :ast :symtab :n)
        if tnTd0.length > 0 then tn0 = tnTd0.copy
        tn: numericFormatName :ast :symtab :ctx tn: tn0.stringView
        if di0.length > 0 then tn = di0
        val: emitExpr :ast :symtab :ctx :n
        # a call fragment may have hoisted non-lvalue args to _ah temps:
        # declare them before the fragment uses them (mirrors the direct
        # print path's flush after emitCallValue)
        flushArgHoists :ctx :ind :tmp :buf floor: hoistFloor rawFloor: hoistRawFloor
        bN: tmp.next
        if tn.stringView == "i128" then {
            needsAddM :ctx uname: "prelude" memb: "fmt_128"
            l4a: "\{ind}char _b\{bN}[48]; int _b\{bN}_n = z_fmt_i128(_b\{bN}, (__int128)\{val});\n"
            buf.append l4a
            l5a: "\{ind}\{ctx.strC}_append(&_s\{sN}, _b\{bN}, (uint64_t)_b\{bN}_n);\n"
            buf.append l5a
        } else if tn.stringView == "u128" then {
            needsAddM :ctx uname: "prelude" memb: "fmt_128"
            l4b: "\{ind}char _b\{bN}[48]; int _b\{bN}_n = z_fmt_u128(_b\{bN}, (unsigned __int128)\{val});\n"
            buf.append l4b
            l5b: "\{ind}\{ctx.strC}_append(&_s\{sN}, _b\{bN}, (uint64_t)_b\{bN}_n);\n"
            buf.append l5b
        } else if (isIntName name: tn.stringView) then {
            # u64 is the one integer width whose range does not fit in
            # int64_t, so the signed conversion specifier turns its top half
            # negative -- u64 max printed as -1. The family answers this, not
            # the spelling: unsigned and 64 bits wide is the case, and i128 /
            # u128 have already taken their own branches above.
            conv: "%ld"
            cast: "(long)(int64_t)"
            if (numSigned name: tn.stringView) == false when (
                (numBits name: tn.stringView) == 64
            ) then {
                conv = "%lu"
                cast = "(unsigned long)(uint64_t)"
            }
            l4: "\{ind}char _b\{bN}[32]; int _b\{bN}_n = snprintf(_b\{bN}, 32, \"\{conv}\", \{cast}\{val});\n"
            buf.append l4
            l5: "\{ind}\{ctx.strC}_append(&_s\{sN}, _b\{bN}, (uint64_t)_b\{bN}_n);\n"
            buf.append l5
        } else if tn.stringView == "f128" then {
            l6q: "\{ind}char _b\{bN}[64]; int _b\{bN}_n = quadmath_snprintf(_b\{bN}, 64, \"%Qg\", \{val});\n"
            buf.append l6q
            l7q: "\{ind}\{ctx.strC}_append(&_s\{sN}, _b\{bN}, (uint64_t)_b\{bN}_n);\n"
            buf.append l7q
        } else if (isFloatName name: tn.stringView) then {
            l6: "\{ind}char _b\{bN}[64]; int _b\{bN}_n = snprintf(_b\{bN}, 64, \"%g\", (double)\{val});\n"
            buf.append l6
            l7: "\{ind}\{ctx.strC}_append(&_s\{sN}, _b\{bN}, (uint64_t)_b\{bN}_n);\n"
            buf.append l7
        } else if tn.stringView == "StringView" then {
            # by-value operand today; a pointer-passed SV would need the
            # String leg's accessor treatment below
            lsv: "\{ind}\{ctx.strC}_append(&_s\{sN}, \{val}.data, \{val}.size);\n"
            buf.append lsv
        } else if tn.stringView == "String" then {
            isAtomP: false
            an0: atomTextDeep :ast :n
            an0v: atomVid :symtab nid: (atomNodeIdDeep :ast :n)
            if an0.length > 0 then isAtomP = true
            if (interpBaseIsMapEntry :ast :symtab :n) then isAtomP = true
            if (interpBaseIsOwnedStructField :ast :symtab :n) then isAtomP = true
            if isAtomP then {
                # a borrowed String param is a pointer (isBorrowStringParam
                # registers the raw name); compound bases (map-entry deref,
                # owned struct field) have an0 == "" and keep the value form
                sAcc: ".".string
                if an0.length > 0 when (isPtrVid :ctx vid: an0v) then sAcc = "->".string
                lss: "\{ind}\{ctx.strC}_append(&_s\{sN}, \{val}\{sAcc}data, \{val}\{sAcc}size);\n"
                buf.append lss
            } else if (hoistExprIsBorrowRooted :ast :symtab :ctx :n) then {
                # borrow-returning call result (a shared element view): hoist
                # for single evaluation and append -- the container owns the
                # storage, so no free (the MapEntry exemption, generalized by
                # the declared signature).
                hN: tmp.next
                lh0: "\{ind}\{ctx.strC}_t _h\{hN} = \{val};\n"
                buf.append lh0
                lh1: "\{ind}\{ctx.strC}_append(&_s\{sN}, _h\{hN}.data, _h\{hN}.size);\n"
                buf.append lh1
            } else {
                # owned call result: hoist, append, free
                hN: tmp.next
                lh0: "\{ind}\{ctx.strC}_t _h\{hN} = \{val};\n"
                buf.append lh0
                lh1: "\{ind}\{ctx.strC}_append(&_s\{sN}, _h\{hN}.data, _h\{hN}.size);\n"
                buf.append lh1
                lh2: "\{ind}\{ctx.strC}_free(&_h\{hN});\n"
                buf.append lh2
            }
        } else {
            pStrId: stampIdOf :symtab nid: (interpPartNodeId :n)
            if (originIsTid :symtab tid: pStrId originTid: (ctx.origins.get i: ogStr)) then {
                lstri: "\{ind}\{ctx.strC}_append(&_s\{sN}, \{val}.data, \{val}.len);\n"
                buf.append lstri
            } else {
                (emitFail
                    :ctx
                    what: "unhandled interp part type \{tn}"
                    line: (ztypecheck.nodeLine :n)
                )
                l8: "\{ind}/* zemitterc: unhandled interp part type \{tn} */\n"
                buf.append l8
            }
        }
        # the part's value has been appended, so a `.take` argument inside it
        # has been consumed: zero its source here, as the statement paths do.
        # Without this the callee frees the moved value and the caller frees it
        # again at scope end.
        emitValueTakeInvalidations :ast :symtab :ctx :n :ind :buf
    }
}

# interpPartNodeId -- the nodeid of expression-ish shapes used by interp parts.
interpPartNodeId: function {n: astnode.view} out u64 is {
    match (
        n
    ) case expression then {
        return n.nodeid.u64
    } case atomid then {
        return n.nodeid.u64
    } case labelvalue then {
        return n.nodeid.u64
    } case call then {
        return n.nodeid.u64
    } case binop then {
        return n.nodeid.u64
    } case dottedpath then {
        return n.nodeid.u64
    } case atomstring then {
        return n.nodeid.u64
    } else {
        return 0
    }
}

# the fully-resolved emitted name for node `n`.
# stampIdDeep -- stampNameDeep's id form: the stamped type id, peeling
# expression wrappers and unwrapping a value-position FUNCTION stamp to its
# return tid. 0 where stampNameDeep would resolve a shell method by name (no
# clean id) or find nothing.
stampIdDeep: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: astnode.view
} out ztypes.tid is {
    nid: interpPartNodeId :n
    sid: stampIdOf :symtab :nid
    if sid > 0 then {
        if (symtab.reg.typetypeOf typeId: sid) == ztypes.ztypetype.functionType then {
            rto: fnReturnTidOf :symtab tid: sid
            if rto > 0 then return (ztypes.tid.create from: rto.u64)
            rno: symtab.typing.funcReturnNode.get key: sid
            match (
                rno
            ) case some then {
                rrt: stampIdOf :symtab nid: rno
                if rrt > 0 then return rrt
            } case none then null
            return (ztypes.tid.create from: 0)
        }
        return sid
    }
    match (
        n
    ) case expression then {
        return (stampIdDeep :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } else {
        return (ztypes.tid.create from: 0)
    }
}

# stampNameDeep -- a node's stamped type name, peeling expression
# wrappers when the wrapper itself is unstamped.
stampNameDeep: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: astnode.view
} out String is {
    nid: interpPartNodeId :n
    sid: stampIdOf :symtab :nid
    if sid > 0 then {
        # a value-position FUNCTION stamp is an auto-call; its value
        # type is the method's return.
        if (symtab.reg.typetypeOf typeId: sid) == ztypes.ztypetype.functionType then {
            rto: fnReturnTidOf :symtab tid: sid
            if rto > 0 then return (regNameOf :symtab tid: (ztypes.tid.create from: rto.u64))
            rno: symtab.typing.funcReturnNode.get key: sid
            match (
                rno
            ) case some then {
                rrt: stampIdOf :symtab nid: rno
                if rrt > 0 then return (regNameOf :symtab tid: rrt)
            } case none then null
        }
        return (regNameOf :symtab tid: sid)
    }
    match (
        n
    ) case expression then {
        return (stampNameDeep :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } else {
        return "".string
    }
}

# emitPrintStmt -- a statement-position print call.
emitPrintStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    emitted: false
    arx499: u64
    for arx499 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx499
        arx499 = arx499 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            if emitted == false then {
                emitted = true
                (emitPrintArg
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                    :ind
                    :tmp
                    :buf
                )
            }
        }
    }
    if emitted == false then buf.append "    /* zemitterc: print with no argument */\n"
}

# plainStringLiteral -- the text of a single-chunk string literal (through
# expression wrappers); "" for interpolated or non-literal expressions.
plainStringLiteral: function {ast: Ast.view n: astnode.view} out String is {
    match (
        n
    ) case expression then {
        return (plainStringLiteral :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomstring then {
        if n.stringparts.count.u64 == 1 then {
            p: ast.nodes.get i: (zast.kidAt kids: ast.kids span: n.stringparts i: 0).u64
            if p.stringchunk then {
                pt: (zast.poolTextAt pool: ast.names ref: p.text).stringView
                pc: pt.string
                return pc
            }
        }
        return "".string
    } else {
        return "".string
    }
}

# emitErrorStmt -- an `error` call the fold pass could not eliminate. Behind
# a runtime guard it traps via z_panic (reachability is not provable); in
# unconditional position the spec says compilation fails: the message is
# recorded for the driver and the trap emitted as a placeholder.
emitErrorStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    ind: StringView
    buf: String.borrow
} is {
    av: String
    lit: String
    got: false
    arx509: u64
    for arx509 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx509
        arx509 = arx509 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            if got == false then {
                got = true
                opn: ast.nodes.get i: a.operation.u64
                av = emitExpr :ast :symtab :ctx n: opn
                lit = plainStringLiteral :ast n: opn
            }
        }
    }
    okArg: false
    if got then {
        if (av.stringView.startsWith prefix: "/*") == false then okArg = true
    }
    if okArg then {
        el: "\{ind}z_panic((const char*)\{av}.data);\n"
        buf.append el
    } else {
        ef: "\{ind}z_panic(\"(compile-time error)\");\n"
        buf.append ef
    }
    if ctx.condDepth == 0 when ctx.genActive == false then {
        em: lit.copy
        if em.length == 0 then em = "compile-time error reached".string
        ctx.emitErrors.append from: em
    }
}

# emitPanicStmt -- `panic "msg"` routes through the shared z_panic runtime
# helper. msg is a StringLike (String/StringView); both expose `.data` as a
# char pointer. A non-string or unhandled arg falls back to a bare marker.
emitPanicStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    ind: StringView
    buf: String.borrow
} is {
    av: String
    got: false
    arx519: u64
    for arx519 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx519
        arx519 = arx519 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            if got == false then {
                got = true
                aOpNode: ast.nodes.get i: a.operation.u64
                av = emitExpr :ast :symtab :ctx n: aOpNode
            }
        }
    }
    okArg: false
    if got then {
        if (av.stringView.startsWith prefix: "/*") == false then okArg = true
    }
    if okArg then {
        pl: "\{ind}z_panic((const char*)\{av}.data);\n"
        buf.append pl
    } else {
        pf: "\{ind}z_panic(\"(panic)\");\n"
        buf.append pf
    }
}

# emit one argument of a `print` call.
emitPrintArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    match (
        n
    ) case expression then {
        emitPrintArg :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64) :ind :tmp :buf
    } case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            emitInterpPrint :ast :symtab :ctx parts: n.stringparts :ind :tmp :buf
        } else {
            li: litIndexOf :ctx nid: n.nodeid.u64
            if li > 0 then {
                l: "\{ind}\{ctx.svC}_print(_zs\{li});\n"
                buf.append l
            } else {
                buf.append "    /* zemitterc: unpooled literal */\n"
            }
        }
    } case atomid then {
        tn: stampNameOf :symtab nid: n.nodeid.u64
        anC: zast.nameTextAt :ast ref: n.name
        an: anC.stringView
        anmV0: atomVid :symtab nid: n.nodeid.u64
        anm: aliasResolve :ctx name: an vid: anmV0
        anv: ztypes.vid
        if anm.stringView == an then anv = anmV0
        # anm stays the SOURCE name (the alias/narrow lookups key on it); anmE
        # is what reaches the C
        anmE: emitLocalAtomName :ctx name: an vid: anmV0
        # a unit string CONSTANT reaching print by name. emitExpr answers for a
        # constant on its own first line; print resolves atoms itself and never
        # goes through it, so without this the NAME reaches the C undeclared.
        # A stamped local is not a constant, so the probe is skipped for one --
        # the same order emitExpr's atomid arm uses.
        {
            alo: symtab.typing.atomVariableId.get key: n.nodeid.u64
            if alo.none then {
                unitTid9: (unitTidOf :ast :symtab unitName: ctx.mainName.stringView)
                cst: (memberConstStringText
                    :symtab
                    :ctx
                    unitTid: unitTid9
                    nameId: n.name
                )
                if cst.length > 0 then anmE = cst.copy
            }
        }
        if (stampIsStr :symtab :ctx nid: n.nodeid.u64) then {
            if (isPtrVid :ctx vid: anv) then {
                lps: "\{ind}\{ctx.strC}_print(\{anmE});\n"
                buf.append lps
            } else {
                lps2: "\{ind}\{ctx.strC}_print(&\{anmE});\n"
                buf.append lps2
            }
        } else if ctx.svTid == (stampIdOf :symtab nid: n.nodeid.u64) then {
            lpv: "\{ind}\{ctx.svC}_print(\{anmE});\n"
            buf.append lpv
        } else {
            argTid: stampIdOf :symtab nid: n.nodeid.u64
            if (originIsTid :symtab tid: argTid originTid: (ctx.origins.get i: ogStr)) then {
                lpstr: "\{ind}\{ctx.svC}_print((\{ctx.svC}_t){ .data = \{anmE}.data, .size = \{anmE}.len });\n"
                buf.append lpstr
                return
            }
            svco: symtab.typing.declChildOfId parentTypeId: argTid nameId: zast.names.wkStringView
            match (
                svco
            ) case some then {
                mcb: ctxCname :ctx tid: (ztypes.tid.create from: svco.u64)
                argOrig: originTidOf :symtab tid: argTid
                usesAmp: false
                if (
                    (symtab.reg.typetypeOf typeId: argTid) == ztypes.ztypetype.classType
                ) when argOrig.isZero then {
                    if (isPtrVid :ctx vid: anv) == false then usesAmp = true
                }
                if usesAmp then {
                    lpt: "\{ind}\{ctx.svC}_print(\{mcb}(&\{anmE}));\n"
                    buf.append lpt
                } else {
                    lpt2: "\{ind}\{ctx.svC}_print(\{mcb}(\{anmE}));\n"
                    buf.append lpt2
                }
            } case none then {
                emitFail :ctx what: "unhandled print of \{anmE} type \{tn}" line: n.lineno
                lpu: "\{ind}/* zemitterc: unhandled print of \{anmE} type \{tn} */\n"
                buf.append lpu
            }
        }
    } case call then {
        ce: emitCallValue :ast :symtab :ctx call: n
        flushArgHoists :ctx :ind :tmp :buf
        if (stampIsSv :symtab :ctx nid: n.nodeid.u64) then {
            lpcv: "\{ind}\{ctx.svC}_print(\{ce});\n"
            buf.append lpcv
        } else {
            hpc: tmp.next
            lpa: "\{ind}\{ctx.strC}_t _h\{hpc} = \{ce};\n"
            buf.append lpa
            lpb: "\{ind}\{ctx.strC}_print(&_h\{hpc});\n"
            buf.append lpb
            lpf: "\{ind}\{ctx.strC}_free(&_h\{hpc});\n"
            buf.append lpf
        }
    } else {
        eid: interpPartNodeId :n
        if (stampIsSv :symtab :ctx nid: eid) then {
            ev: emitExpr :ast :symtab :ctx :n
            flushArgHoists :ctx :ind :tmp :buf
            lpe: "\{ind}\{ctx.svC}_print(\{ev});\n"
            buf.append lpe
        } else if ctx.strTid == (stampIdOf :symtab nid: eid) then {
            es: emitExpr :ast :symtab :ctx :n
            flushArgHoists :ctx :ind :tmp :buf
            if (isNonLvalueArg s: es.stringView) then {
                hps: tmp.next
                lsa: "\{ind}\{ctx.strC}_t _h\{hps} = \{es};\n"
                buf.append lsa
                lsb: "\{ind}\{ctx.strC}_print(&_h\{hps});\n"
                buf.append lsb
                lsf: "\{ind}\{ctx.strC}_free(&_h\{hps});\n"
                buf.append lsf
            } else {
                lsl: "\{ind}\{ctx.strC}_print(&\{es});\n"
                buf.append lsl
            }
        } else {
            emitFail :ctx what: "unhandled print argument".string line: (ztypecheck.nodeLine :n)
            buf.append "    /* zemitterc: unhandled print argument */\n"
        }
    }
}

# bindLitIndex -- the pool index of a plain-literal value node (0 = none).
bindLitIndex: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
} out u64 is {
    match (
        n
    ) case expression then {
        return (bindLitIndex :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            return 0
        } else {
            return (litIndexOf :ctx nid: n.nodeid.u64)
        }
    } else {
        return 0
    }
}

# stringviewOfBaseNid -- stringviewOfBase as an interned name id, for a caller
# that compares the base rather than printing it.
stringviewOfBaseNid: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: astnode.view
} out u64 is {
    match (
        n
    ) case expression then {
        return (stringviewOfBaseNid :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        mn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if (ztypecheck.isStringViewMember name: mn.stringView) then {
            bnid: atomNodeId n: (ast.nodes.get i: n.parent.u64)
            sid: stampIdOf :symtab nid: bnid
            if sid.u64 == (builtinTid :ast :symtab base: "String") then return bnid
        }
        return 0
    } else {
        return 0
    }
}

# stringviewOfBase -- the base name of `X.stringView` over a String local
# ("" otherwise).
# stringviewOfBase -- that base atom's text. Derived from the node above rather
# than re-walked, so the name and the id can never describe different atoms.
stringviewOfBase: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: astnode.view
} outx StringView is {
    sbn: stringviewOfBaseNid :ast :symtab :n
    if sbn == 0 then return ""
    return (atomTextOf :ast n: (ast.nodes.get i: sbn))
}

# stringCopyLitIndex -- the pool index of `\"lit\".string` (0 otherwise).
stringCopyLitIndex: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
} out u64 is {
    match (
        n
    ) case expression then {
        return (stringCopyLitIndex :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        mn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if mn.stringView == "string" then {
            return (bindLitIndex :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
        } else {
            return 0
        }
    } else {
        return 0
    }
}

# copyRvalueHoist -- `<rvalue>.copy` over a String (e.g. `(list.get i: n).copy`):
# the receiver is a non-lvalue, so hoist it to a borrowed temp (`list.get` returns
# a shallow view -- never freed) and return `String_copy(&temp)`. "" otherwise.
copyRvalueHoist: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    buf: String.borrow
} out String is {
    match (
        n
    ) case expression then {
        expressionNode: ast.nodes.get i: n.expression.u64
        return (copyRvalueHoist :ast :symtab :ctx n: expressionNode :ind :buf)
    } case dottedpath then {
        cn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if cn.stringView != "copy" then return "".string
        pnm: stampNameDeep :ast :symtab n: (ast.nodes.get i: n.parent.u64)
        if pnm.stringView != "String" then return "".string
        pv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
        if (isNonLvalueArg s: pv.stringView) == false then return "".string
        hn: ctx.argHoistCtr
        ctx.argHoistCtr = ctx.argHoistCtr + 1
        tnm: "_cpv\{hn}"
        th: "\{ind}\{ctx.strC}_t \{tnm} = \{pv};\n"
        buf.append th
        return "\{ctx.strC}_copy(&\{tnm})"
    } else {
        return "".string
    }
}

# emitStringBindValue -- bind an interpolated-literal value to a String
# local (build chain + binding + scope-end free); false when the value
# is not an interpolated literal.
emitStringBindValue: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    nm: StringView
    nmVid: ztypes.vid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    match (
        n
    ) case expression then {
        iex: ast.nodes.get i: n.expression.u64
        return (emitStringBindValue :ast :symtab :ctx n: iex :nm :nmVid :ind :tmp :buf)
    } case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            sB: emitInterpBuild :ast :symtab :ctx parts: n.stringparts :ind :tmp :buf
            lst: "\{ind}\{ctx.strC}_t \{nm} = _s\{sB};\n"
            buf.append lst
            tmp.oweFree name: nm.string vid: nmVid
            return true
        } else {
            return false
        }
    } case dottedpath then {
        cnd: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if cnd.stringView == "string" then {
            dpv: ast.nodes.get i: n.parent.u64
            return (emitStringBindValue :ast :symtab :ctx n: dpv :nm :nmVid :ind :tmp :buf)
        }
        if cnd.stringView == "copy" then {
            # `<rvalue>.copy` over a String (e.g. `(list.get i: n).copy`): the
            # receiver is a non-lvalue, so hoist it to a borrowed temp (List.get
            # returns a shallow view -- never freed) before String_copy(&temp).
            pnm: stampNameDeep :ast :symtab n: (ast.nodes.get i: n.parent.u64)
            if pnm.stringView == "String" then {
                pv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
                if (isNonLvalueArg s: pv.stringView) then {
                    hn: ctx.argHoistCtr
                    ctx.argHoistCtr = ctx.argHoistCtr + 1
                    tnm: "_cpv\{hn}"
                    th: "\{ind}\{ctx.strC}_t \{tnm} = \{pv};\n"
                    buf.append th
                    lc: "\{ind}\{ctx.strC}_t \{nm} = \{ctx.strC}_copy(&\{tnm});\n"
                    buf.append lc
                    tmp.oweFree name: nm.string vid: nmVid
                    return true
                }
            }
            return false
        }
        return false
    } else {
        return false
    }
}

# emitOptionBoxHoist -- `Option.some <val>`: a heap-boxed union ctor, emitted as
# statements (the box can't be an expression). Returns the `_cN` temp name, or ""
# when n is not an Option.some (so the caller falls back to the expression path).
emitOptionBoxHoist: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out String is {
    match (
        n
    ) case expression then {
        iexG: ast.nodes.get i: n.expression.u64
        return (emitOptionBoxHoist :ast :symtab :ctx n: iexG :ind :tmp :buf)
    } case statementline then {
        sln: ast.nodes.get i: n.statementline.u64
        return (emitOptionBoxHoist :ast :symtab :ctx n: sln :ind :tmp :buf)
    } case call then {
        cn: dottedChildText :ast n: (ast.nodes.get i: n.callable.u64)
        if cn != "some" then return "".string
        mid: stampIdOf :symtab nid: n.nodeid.u64
        if (originIsTid :symtab tid: mid originTid: (ctx.origins.get i: ogOption)) == false then {
            return "".string
        }
        av: "0".string
        got: false
        arx529: u64
        for arx529 < n.arguments.count.u64 loop {
            a9Id: zast.kidAt kids: ast.kids span: n.arguments i: arx529
            arx529 = arx529 + 1
            a: ast.nodes.get i: a9Id.u64
            if a.namedoperation then {
                if got == false then {
                    got = true
                    aOpNode: ast.nodes.get i: a.operation.u64
                    av = emitExpr :ast :symtab :ctx n: aOpNode
                }
            }
        }
        vc: ctxCname :ctx tid: mid
        payC: armPayloadC :ast :symtab :ctx tid: mid arm: "some"
        tg: variantTag :symtab tid: mid arm: "some"
        bN: tmp.next
        b0: "\{ind}\{vc}_t _c\{bN} = {0};\n"
        buf.append b0
        b1: "\{ind}_c\{bN}.tag = \{tg};\n"
        buf.append b1
        b2: "\{ind}\{payC} _t\{bN} = \{av};\n"
        buf.append b2
        b3: "\{ind}\{payC}* _Box\{bN} = (\{payC}*)z_xmalloc(sizeof(\{payC}));\n"
        buf.append b3
        b4: "\{ind}*_Box\{bN} = _t\{bN};\n"
        buf.append b4
        if (isBareCName s: av.stringView) when (isRegisteredOwned :tmp name: av.stringView) then {
            invB: "\{ind}\{av} = (\{payC}){0};\n"
            if (strHasSub hay: payC.stringView needle: "*") then invB = "\{ind}\{av} = NULL;\n"
            buf.append invB
        }
        b5: "\{ind}_c\{bN}.data = _Box\{bN};\n"
        buf.append b5
        return "_c\{bN}"
    } else {
        return "".string
    }
}

# emitStringReturnValue -- a `return "\{...}".string` whose value is an
# interpolated-String literal: build it (emitInterpBuild) then return the owned
# temp. Mirrors emitStringBindValue but the built String is the return value
# (ownership transfers to the caller -> no free registered). false when the
# value is not an interp-String-literal (caller falls back to emitExpr).
emitStringReturnValue: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    match (
        n
    ) case expression then {
        iexH: ast.nodes.get i: n.expression.u64
        return (emitStringReturnValue :ast :symtab :ctx n: iexH :ind :tmp :buf)
    } case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            sB: emitInterpBuild :ast :symtab :ctx parts: n.stringparts :ind :tmp :buf
            rexp: "_s\{sB}"
            emitReturnCleanup :ctx :tmp retExpr: rexp.stringView keepRefd: true :ind :buf
            lst: "\{ind}return _s\{sB};\n"
            buf.append lst
            return true
        } else {
            return false
        }
    } case dottedpath then {
        cnd: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if cnd.stringView == "string" then {
            dpw: ast.nodes.get i: n.parent.u64
            return (emitStringReturnValue :ast :symtab :ctx n: dpw :ind :tmp :buf)
        } else {
            return false
        }
    } else {
        return false
    }
}

# emitDiscardedResult -- a statement-position call (explicit, dotted auto-call,
# or bare-atom auto-call) whose result is discarded: when the stamped result
# type is an owned destructible value (String / class / union) and the RHS is
# not a borrow by the declared signature (bindingRhsIsBorrow: funcReturnsBorrow
# markers, container element views), bind the result to a temp and destroy it.
# Emits `expr;` alone otherwise.
emitDiscardedResult: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    isBorrow: bool
    ce: StringView
    rtid: ztypes.tid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    dctt: symtab.reg.typetypeOf typeId: rtid
    dcdrop: false
    if (symtab.reg.needsDestructor typeId: rtid) when isBorrow == false then {
        if rtid == ctx.strTid then dcdrop = true
        if dctt == ztypes.ztypetype.classType then dcdrop = true
        if dctt == ztypes.ztypetype.unionType then dcdrop = true
    }
    if dcdrop when (isNonLvalueArg s: ce) then {
        dctn: tmp.next
        dctnm: "_c\{dctn}"
        dcct: "\{ctx.strC}_t"
        dcfree: "\{ind}\{ctx.strC}_free(&\{dctnm});\n"
        if rtid != ctx.strTid then {
            dcct = (typeRefC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: rtid.u64)
                thisTid: ztypes.tid
            )
            dccb: ctxCname :ctx tid: (ztypes.tid.create from: rtid.u64)
            dcref: "&\{dctnm}"
            if (ctEndsWithStar ct: dcct.stringView) then dcref = "\{dctnm}"
            dcfree = "\{ind}\{dccb}_destroy(\{dcref});\n"
        }
        dcdecl: "\{ind}\{dcct} \{dctnm} = \{ce};\n"
        buf.append dcdecl
        buf.append dcfree
    } else {
        lc: "\{ind}(void)(\{ce});\n"
        buf.append lc
    }
}

# emitCallStmt -- one call-shaped statement: return / print / a plain call.
emitCallStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    relmnId: aliasChildNameId :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if (mnIs :ctx id: relmnId at: mnDrop) then {
        relbnid: dottedBaseNodeId :ast n: (ast.nodes.get i: call.callable.u64)
        reltid: stampIdOf :symtab nid: relbnid
        if (symtab.reg.typetypeOf typeId: reltid) == ztypes.ztypetype.protocolType then return
    }
    cn0Id: atomNameIdOf :ast n: (ast.nodes.get i: call.callable.u64)
    # a statement form arrives either as its core alias (an atom) or spelled
    # qualified (a dotted path, whose atom carries no name)
    sfnId: cn0Id
    if cn0Id.isZero then {
        sfnId = (stmtFormNameId
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: call.callable.u64)
        )
    }
    if (mnIs :ctx id: sfnId at: mnPrint) then {
        emitPrintStmt :ast :symtab :ctx :call :ind :tmp :buf
        return
    }
    if (mnIs :ctx id: sfnId at: mnPanic) then {
        emitPanicStmt :ast :symtab :ctx :call :ind :buf
        return
    }
    if (mnIs :ctx id: sfnId at: mnError) then {
        emitErrorStmt :ast :symtab :ctx :call :ind :buf
        return
    }
    if sfnId == zast.names.wkReturn then {
        hasArg: false
        arx539: u64
        for arx539 < call.arguments.count.u64 loop {
            aId: zast.kidAt kids: ast.kids span: call.arguments i: arx539
            arx539 = arx539 + 1
            a: ast.nodes.get i: aId.u64
            if a.namedoperation then {
                if hasArg == false then {
                    hasArg = true
                    emitReturnOfNode :ast :symtab :ctx vid: a.operation :ind :tmp :buf
                }
            }
        }
        if hasArg == false then {
            if ctx.genActive then {
                lgd: "\{ind}goto L_done;\n"
                buf.append lgd
            } else {
                emitReturnCleanup :ctx :tmp retExpr: "" keepRefd: true :ind :buf
                lr2: "\{ind}return;\n"
                buf.append lr2
            }
        }
        return
    }
    ce: emitCallValue :ast :symtab :ctx :call
    flushArgHoists :ctx :ind :tmp :buf
    dcrtid: stampIdOf :symtab nid: call.nodeid.u64
    isBorrow98: (callRhsIsBorrow :ast :symtab :ctx :call)
    (emitDiscardedResult
        :ast
        :symtab
        :ctx
        isBorrow: isBorrow98
        ce: ce.stringView
        rtid: dcrtid
        :ind
        :tmp
        :buf
    )
    emitCallTakeInvalidations :ast :symtab :ctx :call :ind :buf
}

# isDottedAutoCall -- the node is a dotted-path auto-call (a no-arg method
# reference used in statement position).
isDottedAutoCall: function {n: astnode.view} out bool is {
    match (
        n
    ) case dottedpath then {
        return true
    } else {
        return false
    }
}

# emitCollectionBind -- binding a List, Set or Map: the mono's own create, the
# capacity the construction asked for, and the cleanup entry the local earns.
# The cleanup entry is what `nbrw` gates, in each of the three legs below: a
# field read ALIASES the holder's heap -- the struct copy shares its buffer --
# so the holder alone owns it, and registering a destructor here freed that
# buffer twice.
emitCollectionBind: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: zast.assignmentrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    nm: StringView
    nameVid: ztypes.vid
} out bool is {
    handled: false
    avn: ast.nodes.get i: n.value.u64
    nbrw: bindingRhsIsBorrow :ast :symtab :ctx n: avn
    ltid: stampIdOf :symtab nid: n.nodeid.u64
    if ltid.isZero then ltid = stampIdOf :symtab nid: (interpPartNodeId n: avn)
    ltid = ztypes.tid.create from: (chaseColMono :symtab :ctx tid: ltid)
    if (isListOriginOf :symtab :ctx tid: ltid) then {
        lcb: ctxCname :ctx tid: ltid
        if (noArgNativeRhs :ast :symtab unitName: ctx.mainName.stringView n: avn) then {
            # owned List returned by os.args / os.envNames: emit the call.
            losr: emitExpr :ast :symtab :ctx n: avn
            losb: "\{ind}\{lcb}_t \{nm} = \{losr};\n"
            buf.append losb
        } else {
            if (forexprValue :ast n: avn) then {
                # list comprehension: `xs: for ... loop { expr }` create + populate
                lc0: "\{ind}\{lcb}_t \{nm} = \{lcb}_create((uint64_t)0);\n"
                buf.append lc0
                (emitListComprehension
                    :ast
                    :symtab
                    :ctx
                    forNode: avn
                    listCb: lcb.stringView
                    listVar: nm
                    :ind
                    :tmp
                    :buf
                )
            } else {
                if (collectionValueCallRhs :ast :symtab n: avn) then {
                    lvr0: emitExpr :ast :symtab :ctx n: avn
                    lb0: "\{ind}\{lcb}_t \{nm} = \{lvr0};\n"
                    buf.append lb0
                    emitValueTakeInvalidations :ast :symtab :ctx n: avn :ind :buf
                    # a binding from a bare owned local is a MOVE: zero the
                    # source so its scope-exit free no-ops now that this
                    # binding owns the buffer
                    if (isBareNameValue :ast n: avn) then {
                        lzs0: implicitTakeSource :ast :symtab :ctx n: avn
                        if lzs0.length > 0 then {
                            lzi0: "\{ind}\{lzs0} = (\{lcb}_t){0};\n"
                            buf.append lzi0
                        }
                    }
                    # a take out of a FIELD moves the buffer the same way:
                    # the field is zeroed so the holder's destroy no-ops
                    if (isFieldTake :ast n: avn) then {
                        lzf0: "\{ind}\{lvr0} = (\{lcb}_t){0};\n"
                        buf.append lzf0
                    }
                } else {
                    lcap: listCapArg :ast :symtab :ctx n: avn
                    lb1: "\{ind}\{lcb}_t \{nm} = \{lcb}_create((uint64_t)\{lcap});\n"
                    buf.append lb1
                }
            }
        }
        if nbrw == false then {
            lfree: "    \{lcb}_destroy(&\{nm});\n"
            lfsv: lfree.stringView
            tmp.oweList stmt: lfsv.string name: nm.string vid: nameVid
        }
        return true
    }
    if (isSetOriginOf :symtab :ctx tid: ltid) then {
        scb: ctxCname :ctx tid: ltid
        if (collectionValueCallRhs :ast :symtab n: avn) then {
            svr: emitExpr :ast :symtab :ctx n: avn
            sbc: "\{ind}\{scb}_t* \{nm} = \{svr};\n"
            buf.append sbc
            emitValueTakeInvalidations :ast :symtab :ctx n: avn :ind :buf
            # a heap collection binding from a bare owned local is a MOVE:
            # clear the source so its scope-exit destroy no-ops now that
            # this binding owns the allocation
            if (isBareNameValue :ast n: avn) then {
                hzs0: implicitTakeSource :ast :symtab :ctx n: avn
                if hzs0.length > 0 then {
                    hzi0: "\{ind}\{hzs0} = NULL;\n"
                    buf.append hzi0
                }
            }
            # a take out of a FIELD moves the allocation the same way: the
            # field is cleared so the holder's destroy no-ops
            if (isFieldTake :ast n: avn) then {
                hzf0: "\{ind}\{svr} = NULL;\n"
                buf.append hzf0
            }
        } else {
            scap: listCapArg :ast :symtab :ctx n: avn
            sb0: "\{ind}\{scb}_t* \{nm} = \{scb}_create((uint64_t)\{scap});\n"
            buf.append sb0
        }
        if nbrw == false then {
            sfree: "    \{scb}_destroy(\{nm});\n"
            sfsv: sfree.stringView
            tmp.oweList stmt: sfsv.string name: nm.string vid: nameVid
        }
        return true
    }
    if (isMapOriginOf :symtab :ctx tid: ltid) then {
        mcb: ctxCname :ctx tid: ltid
        if (collectionValueCallRhs :ast :symtab n: avn) then {
            mvr: emitExpr :ast :symtab :ctx n: avn
            mbc: "\{ind}\{mcb}_t* \{nm} = \{mvr};\n"
            buf.append mbc
            emitValueTakeInvalidations :ast :symtab :ctx n: avn :ind :buf
            # a heap collection binding from a bare owned local is a MOVE:
            # clear the source so its scope-exit destroy no-ops now that
            # this binding owns the allocation
            if (isBareNameValue :ast n: avn) then {
                hzs0: implicitTakeSource :ast :symtab :ctx n: avn
                if hzs0.length > 0 then {
                    hzi0: "\{ind}\{hzs0} = NULL;\n"
                    buf.append hzi0
                }
            }
            # a take out of a FIELD moves the allocation the same way: the
            # field is cleared so the holder's destroy no-ops
            if (isFieldTake :ast n: avn) then {
                mzf0: "\{ind}\{mvr} = NULL;\n"
                buf.append mzf0
            }
        } else {
            mcap: listCapArg :ast :symtab :ctx n: avn
            mb0: "\{ind}\{mcb}_t* \{nm} = \{mcb}_create((uint64_t)\{mcap});\n"
            buf.append mb0
        }
        if nbrw == false then {
            mfree: "    \{mcb}_destroy(\{nm});\n"
            mfsv: mfree.stringView
            tmp.oweList stmt: mfsv.string name: nm.string vid: nameVid
        }
        return true
    }
    return handled
}

# emitStringBind -- binding a StringView or a String. A view aliases its source and
# frees nothing; an owned String joins the scope's cleanup list unless the binding
# is a borrow.
emitStringBind: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.assignmentrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    nm: StringView
    nameVid: ztypes.vid
    btid: ztypes.tid
} out bool is {
    handled: false
    avn: ast.nodes.get i: n.value.u64
    if btid == ctx.svTid then {
        lvN: bindLitIndex :ast :symtab :ctx n: avn
        if lvN > 0 then {
            lsv2: "\{ind}\{ctx.svC}_t \{nm} = _zs\{lvN};\n"
            buf.append lsv2
            return true
        }
        svb: stringviewOfBase :ast :symtab n: avn
        if svb.length > 0 then {
            svacc4: ".".string
            svbV: atomVid :symtab nid: (stringviewOfBaseNid :ast :symtab n: avn)
            if (isPtrVid :ctx vid: svbV) then svacc4 = "->".string
            svbR4: emitLocalAtomName :ctx name: svb vid: svbV
            lsv4: "\{ind}\{ctx.svC}_t \{nm} = (\{ctx.svC}_t){ .data = \{svbR4}\{svacc4}data, .size = \{svbR4}\{svacc4}size };\n"
            buf.append lsv4
            return true
        }
        vx: emitExpr :ast :symtab :ctx n: avn
        flushArgHoists :ctx :ind :tmp :buf
        if (vx.stringView.startsWith prefix: "/*") then {
            emitFail :ctx what: "unhandled StringView binding \{nm}" line: n.lineno
            lsv3: "\{ind}/* zemitterc: unhandled StringView binding \{nm} */\n"
            buf.append lsv3
        } else {
            lsv5: "\{ind}\{ctx.svC}_t \{nm} = \{vx};\n"
            buf.append lsv5
        }
        return true
    }
    if btid == ctx.strTid then {
        fvN: stringCopyLitIndex :ast :symtab :ctx n: avn
        if fvN > 0 then {
            lsc: "\{ind}\{ctx.strC}_t \{nm} = \{ctx.strC}_from_view(_zs\{fvN});\n"
            buf.append lsc
            tmp.oweFree name: nm.string vid: nameVid
            return true
        }
        did: (emitStringBindValue
            :ast
            :symtab
            :ctx
            n: avn
            :nm
            nmVid: nameVid
            :ind
            :tmp
            :buf
        )
        if did then return true
        sx: emitExpr :ast :symtab :ctx n: avn
        flushArgHoists :ctx :ind :tmp :buf
        if (sx.stringView.startsWith prefix: "/*") then {
            emitFail :ctx what: "unhandled String binding \{nm}" line: n.lineno
            lst2: "\{ind}/* zemitterc: unhandled String binding \{nm} */\n"
            buf.append lst2
        } else {
            lst3: "\{ind}\{ctx.strC}_t \{nm} = \{sx};\n"
            buf.append lst3
            # the value may be a call that took ownership of an argument;
            # the caller zeroes that source here, as every other binding
            # branch does
            emitValueTakeInvalidations :ast :symtab :ctx n: avn :ind :buf
            if (bindingRhsIsBorrow :ast :symtab :ctx n: avn) == false then {
                tmp.oweFree name: nm.string vid: nameVid
                # a binding from a bare owned local is a MOVE, exactly as a
                # reassignment from one is: zero the source so its scope-exit
                # free no-ops now that this binding owns the buffer.
                if (isBareNameValue :ast n: avn) then {
                    szs: implicitTakeSource :ast :symtab :ctx n: avn
                    if szs.length > 0 then {
                        szi: "\{ind}\{szs} = (\{ctx.strC}_t){0};\n"
                        buf.append szi
                    }
                }
                # a take out of a FIELD moves the buffer the same way: the
                # field is zeroed so the holder's destructor no-ops on it
                if (isFieldTake :ast n: avn) then {
                    szf: "\{ind}\{sx} = (\{ctx.strC}_t){0};\n"
                    buf.append szf
                }
            }
        }
        return true
    }
    return handled
}

# emitTypedBind -- the general binding: a declared C type and a value, plus the
# cleanup entry the local earns. A union or a heap-owning record registers its
# destructor; a borrow registers nothing, since the source still owns the heap.
emitTypedBind: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.assignmentrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    nm: StringView
    nameVid: ztypes.vid
    ct: StringView
    ltid: ztypes.tid
    tn: StringView
} is {
    avn: ast.nodes.get i: n.value.u64
    rv: emitExpr :ast :symtab :ctx n: avn
    flushArgHoists :ctx :ind :tmp :buf
    if ct.length > 0 then {
        # a reference-returning callee hands back `T*`: the binding ALIASES
        # the source, so it is declared as a pointer and registered so every
        # later use emits `->`. Binding it by value would copy the struct and
        # silently lose writes through it.
        ctB8: "\{ct}"
        {
            rbf8: refBorrowCalleeFid :ast :symtab :ctx n: avn
            if rbf8 > 0 when (fnReturnsRefBorrow
                :ast
                :symtab
                :ctx
                fid: (ztypes.tid.create from: rbf8.u64)
                retTid: ltid
            ) then {
                ctB8 = "\{ct}*"
                ctx.ptrVids.append nameVid
            }
            if (isSvAsStringNode :ast :symtab :ctx n: avn) then {
                ctB8 = "const \{ct}*"
                ctx.ptrVids.append nameVid
            }
        }
        rvB8: "\{rv}"
        if ctB8.stringView == ct when (needsValueDeref
            :ast
            :symtab
            :ctx
            n: avn
            tid: ltid
        ) then rvB8 = "(*\{rv})"
        la: "\{ind}\{ctB8} \{nm} = \{rvB8};\n"
        buf.append la
        emitValueTakeInvalidations :ast :symtab :ctx n: avn :ind :buf
        ftFn: false
        ftnid: interpPartNodeId n: avn
        if ftnid > 0 then {
            ftst: stampIdOf :symtab nid: ftnid
            if ftst > 0 then {
                if (symtab.reg.typetypeOf typeId: ftst) == ztypes.ztypetype.functionType then {
                    # a function reference is POD: taking it moves nothing,
                    # so the source (a unit fn symbol or an fnptr field)
                    # is never zeroed
                    ftFn = true
                }
            }
        }
        if (isFieldTake :ast n: avn) when ftFn == false then {
            ftz: "\{ind}\{rv} = (\{ct}){0};\n"
            buf.append ftz
        } else {
            bts: takeStringSource :ast :symtab :ctx n: avn
            if bts.length > 0 then {
                bzz: "\{ind}\{rv} = (\{ct}){0};\n"
                buf.append bzz
            } else {
                # a binding from a bare owned local is a MOVE, exactly as a
                # reassignment from one is: zero the source so its scope-exit
                # free no-ops now that this binding owns the heap. A borrow
                # binding owns nothing, so its source keeps its value.
                # ownership is decided from the type BEFORE the source text
                # is composed: a scalar binding moves nothing, and asking for
                # the source costs a String.
                if (isBareNameValue :ast n: avn) then {
                    bzt: stampIdOf :symtab nid: (interpPartNodeId n: avn)
                    bzp: isHeapPtrCollection :symtab :ctx tid: bzt
                    bzo: bzp
                    if (symtab.reg.needsDestructor typeId: bzt) then bzo = true
                    if bzo when (
                        (bindingRhsIsBorrow
                            :ast
                            :symtab
                            :ctx
                            n: avn
                        ) ==
                        false
                    ) then {
                        bzs: implicitTakeSource :ast :symtab :ctx n: avn
                        if bzs.length > 0 then {
                            if bzp then {
                                bzh: "\{ind}\{bzs} = NULL;\n"
                                buf.append bzh
                            } else {
                                bzc: (typeRefC
                                    :ast
                                    :symtab
                                    :ctx
                                    tid: bzt
                                    thisTid: ztypes.tid
                                )
                                if bzc.length > 0 then {
                                    bzi: "\{ind}\{bzs} = (\{bzc}){0};\n"
                                    buf.append bzi
                                }
                            }
                        }
                    }
                }
            }
        }
        # an owned class/record local with heap fields is destroyed at scope
        # exit (String/collection locals returned earlier; take-aliases too).
        (registerScopeDestroy
            :ast
            :symtab
            :ctx
            tid: ltid
            :nm
            :nameVid
            valueNode: avn
            :tmp
        )
    } else {
        emitFail :ctx what: "unhandled binding type \{tn} for \{nm}" line: n.lineno
        lb: "\{ind}/* zemitterc: unhandled binding type \{tn} for \{nm} */\n"
        buf.append lb
    }
}

# emitTakeAliasBind -- `x: <inst>.take` over a record or class is an ownership
# ALIAS: record `x => inst` and emit no storage, so a later `x` resolves to
# `inst`. A narrowed-subject take is the exception -- it MOVES the payload out of
# the match arm's box, so it needs real storage and box zeroing.
emitTakeAliasBind: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.assignmentrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    nm: StringView
    nameVid: ztypes.vid
} out bool is {
    handled: false
    avn: ast.nodes.get i: n.value.u64
    # `x: <inst>.take` over a record/class is an ownership alias: record
    # `x => inst` and emit no storage (subsequent `x` resolves to `inst`).
    tabA: takeAliasBase :ast :symtab n: avn
    tabAV: atomVid :symtab nid: (takeAliasBaseNid :ast :symtab n: avn)
    if tabA.length > 0 then {
        # a narrowed-subject `.take` binding MOVES the payload out of
        # the match arm's box: real storage from the narrowed cast plus
        # box zeroing, so the subject's post-match destroy no-ops (a
        # pure alias would re-resolve to the whole un-narrowed subject)
        if (vvHas xs: ctx.narrowBox vid: tabAV) then {
            ntO: vtGet xs: ctx.narrowTid vid: tabAV
            match (
                ntO
            ) case some then {
                ctB: (typeRefC
                    :ast
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: ntO.u64)
                    thisTid: ztypes.tid
                )
                valB: takeSourceResolve :ctx name: tabA vid: tabAV
                lnB1: "\{ind}\{ctB} \{nm} = \{valB};\n"
                buf.append lnB1
                lnB2: "\{ind}\{valB} = (\{ctB}){0};\n"
                buf.append lnB2
                # a String payload is freed by the string runtime, which
                # has no `_destroy`: it rides the scope's String free list
                # like any other owned String local.
                ldcbC: ctxCname :ctx tid: (ztypes.tid.create from: ntO.u64)
                if ldcbC.stringView == ctx.strC.stringView then {
                    tmp.oweFree name: nm.string vid: nameVid
                } else {
                    if (symtab.reg.needsDestructor typeId: ntO) then {
                        ldcbB: ctxCname :ctx tid: (ztypes.tid.create from: ntO.u64)
                        ldfB: "    \{ldcbB}_destroy(&\{nm});\n"
                        tmp.oweList stmt: ldfB.copy name: nm.string vid: nameVid
                    }
                }
                return true
            } case none then null
        }
        # the alias VALUE is C text, so it must be the source's emitted
        # identifier -- its source name names nothing in the output
        tabAE: emitLocalAtomName :ctx name: tabA vid: tabAV
        lalA: "\{ind}/* alias: \{nm} => \{tabAE} */\n"
        buf.append lalA
        vvSet xs: ctx.aliases vid: nameVid val: tabAE.stringView
        return true
    }
    return handled
}

# bindDeclaredCType -- the C type a binding declares. The NAME says scalar; the TID
# says whether it is the BUILTIN one -- a shadow keeps the name and loses the C
# scalar, so it emits its struct instead. An unnamed binding takes the stamped
# type of the statement, or of the value when the statement carries none.
bindDeclaredCType: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.assignmentrow.view
    btid: ztypes.tid
    tn: StringView
} out String is {
    # the NAME says scalar; the tid says whether it is the builtin one. A
    # shadow keeps the name and loses the C scalar, so it emits its struct.
    avn: ast.nodes.get i: n.value.u64
    ct: cTypeOf name: tn
    if ct.length > 0 when btid > 0 then {
        if (scalarTidIsBuiltin :symtab tid: btid) == false then {
            ct = typeRefC :ast :symtab :ctx tid: btid thisTid: ztypes.tid
        }
    }
    if ct.length == 0 then {
        tgo: ztyping.nodeTypeAt tbl: symtab.typing.nodeType nid: n.nodeid.u64
        if tgo > 0 then {
            ct = (typeRefC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: tgo.u64)
                thisTid: ztypes.tid
            )
        } else {
            vgo: ztyping.nodeTypeAt tbl: symtab.typing.nodeType nid: (interpPartNodeId n: avn)
            if vgo > 0 then {
                ct = (typeRefC
                    :ast
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: vgo.u64)
                    thisTid: ztypes.tid
                )
            }
        }
    }
    return ct
}

# emitAssignment -- a binding statement (`x: <value>`): the declaration, the value,
# and the ownership bookkeeping the binding takes on -- a move zeroes its source,
# a borrow records its origin, and an owned local joins the scope's cleanup list.
emitAssignment: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: zast.assignmentrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    avn: ast.nodes.get i: n.value.u64
    tn: stampNameOf :symtab nid: n.nodeid.u64
    btid: stampIdOf :symtab nid: n.nodeid.u64
    ct: bindDeclaredCType :ast :symtab :ctx :n :btid tn: tn.stringView
    anmC: zast.poolTextAt pool: ast.names ref: n.name
    nameVid: defVid :symtab nid: n.nodeid.u64
    nm: varCName :ctx vid: nameVid name: anmC.stringView
    # this statement introduces a fresh local: a borrow alias left by an
    # earlier binding of the same name names a C variable that is out of
    # scope here, so drop it before the legs below re-establish one.
    {
        sab: vvGet xs: ctx.aliases vid: nameVid
        if sab.length > 0 when (sab.stringView.startsWith prefix: "(*__borrow_") then {
            vvRemove xs: ctx.aliases vid: nameVid
        }
    }
    nbrw: bindingRhsIsBorrow :ast :symtab :ctx n: avn
    ctx.borrowedVars.set key: (defVid :symtab nid: n.nodeid.u64) value: nbrw
    if ctx.genActive when (isYieldNode :ast n: avn) then {
        (emitExprFormYield
            :ast
            :symtab
            :ctx
            value: avn
            aid: n.nodeid.u64
            nm: nm.stringView
            nmVid: nameVid
            :ind
            :tmp
            :buf
        )
        return
    }
    if (emitTakeAliasBind
        :ast
        :symtab
        :ctx
        :n
        :ind
        :tmp
        :buf
        nm: nm.stringView
        :nameVid
    ) then return
    if (emitCollectionBind
        :ast
        :symtab
        :ctx
        :n
        :ind
        :tmp
        :buf
        nm: nm.stringView
        :nameVid
    ) then return
    ltid: stampIdOf :symtab nid: n.nodeid.u64
    if ltid.isZero then ltid = stampIdOf :symtab nid: (interpPartNodeId n: avn)
    ltid = ztypes.tid.create from: (chaseColMono :symtab :ctx tid: ltid)
    if (rhsIsBorrowGet :ast :symtab :ctx n: avn) then {
        # a borrowed element get: bind the POINTER and alias the name to the
        # deref, so every downstream use stays a value-shaped lvalue. No
        # destructor and no take-invalidation: the container owns the element.
        rvb: emitExpr :ast :symtab :ctx n: avn
        flushArgHoists :ctx :ind :tmp :buf
        bct: ct.copy
        if bct.length == 0 then bct = "int64_t".string
        lbg0: "\{ind}\{bct}* __borrow_\{nm} = &\{rvb};\n"
        buf.append lbg0
        lbg1: "\{ind}/* alias: \{nm} => (*__borrow_\{nm}) */\n"
        buf.append lbg1
        bga: "(*__borrow_\{nm})"
        vvSet xs: ctx.aliases vid: nameVid val: bga.stringView
        return
    }
    if (emitStringBind
        :ast
        :symtab
        :ctx
        :n
        :ind
        :tmp
        :buf
        nm: nm.stringView
        :nameVid
        :btid
    ) then return
    if ct.length > 0 then {
        dm: (emitMatchBindValue
            :ast
            :symtab
            :ctx
            n: avn
            nm: nm.stringView
            ct: ct.stringView
            :ind
            :tmp
            :buf
        )
        if dm then return
        di: (emitIfBindValue
            :ast
            :symtab
            :ctx
            n: avn
            nm: nm.stringView
            ct: ct.stringView
            :ind
            :tmp
            :buf
        )
        if di then return
        dd: (emitDoBindValue
            :ast
            :symtab
            :ctx
            n: avn
            nm: nm.stringView
            nmVid: nameVid
            ct: ct.stringView
            tid: ltid
            :ind
            :tmp
            :buf
        )
        if dd then return
    }
    (emitTypedBind
        :ast
        :symtab
        :ctx
        :n
        :ind
        :tmp
        :buf
        nm: nm.stringView
        :nameVid
        ct: ct.stringView
        :ltid
        tn: tn.stringView
    )
}

# emitDottedAutoCallStmt -- a no-argument METHOD auto-call in statement position
# (`this.accept`, `this.statepop`) parses as a dotted path. Emits the call as a
# statement, or nothing at all for a `.drop` transfer marker, whose destroy
# the scope exit already covers. ALWAYS handles the statement -- the four legs
# inside it were `return`s out of emitReturnStmt, so the caller returns too.
emitDottedAutoCallStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    # `.drop` on a protocol is a transfer marker (scope-exit destroy
    # covers it) -- emit nothing, like emitCallStmt.
    dct: dottedChildText :ast :n
    if dct == "drop" then {
        rrid: dottedReceiverStampId :ast :symtab callable: n
        rtt: symtab.reg.typetypeOf typeId: rrid
        if rtt == ztypes.ztypetype.protocolType then return
        rcvKey: atomVid :symtab nid: (dottedBaseNodeId :ast :n)
        rbrw: false
        bvg: ctx.borrowedVars.get key: rcvKey
        match (
            bvg
        ) case some then {
            rbrw = bvg
        } case none then null
        if rbrw then return
        rcvV: emitDottedReceiver :ast :symtab :ctx callable: n
        if rrid == ctx.strTid then {
            rdf: "\{ind}\{ctx.strC}_free(&\{rcvV});\n"
            buf.append rdf
        } else {
            if (symtab.reg.needsDestructor typeId: rrid) then {
                rdcb: ctxCname :ctx tid: (ztypes.tid.create from: rrid.u64)
                rdref: "&\{rcvV}"
                if (isBoxTid
                    :symtab
                    tid: (ztypes.tid.create from: rrid.u64)
                ) then rdref = "\{rcvV}"
                rdc: "\{ind}\{rdcb}_destroy(\{rdref});\n"
                buf.append rdc
            }
        }
        rinv: false
        if rrid == ctx.strTid then rinv = true
        if rtt == ztypes.ztypetype.classType then rinv = true
        if rtt == ztypes.ztypetype.unionType then rinv = true
        if rinv then {
            rci: (typeRefC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: rrid.u64)
                thisTid: ztypes.tid
            )
            riv: "\{ind}\{rcvV} = (\{rci}){0};\n"
            buf.append riv
        }
        return
    }
    de: emitExpr :ast :symtab :ctx :n
    if (de.stringView.startsWith prefix: "/*") then {
        emitFail :ctx what: "unhandled statement".string line: (ztypecheck.nodeLine :n)
        lud: "\{ind}/* zemitterc: unhandled statement */\n"
        buf.append lud
    } else {
        drtid: stampIdOf :symtab nid: (interpPartNodeId :n)
        isBorrow99: (bindingRhsIsBorrow :ast :symtab :ctx :n)
        (emitDiscardedResult
            :ast
            :symtab
            :ctx
            isBorrow: isBorrow99
            ce: de.stringView
            rtid: drtid
            :ind
            :tmp
            :buf
        )
    }
    return
}

# emitBreakStmt -- `break`: the block frees, then the owned-payload dtor the
# jump would skip, then the goto. A do-block entry carries an empty cleanup.
emitBreakStmt: function {
    ctx: Ctx
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    emitBreakFrees :ctx :tmp :ind :buf
    if ctx.breakLabels.length > 0 then {
        bid: ctx.breakLabels.get i: (ctx.breakLabels.length - 1)
        # an owned-payload loop's per-iteration dtor: the jump
        # skips the fall-through line, so emit its copy here (a
        # do-block entry carries an empty cleanup).
        bcl: ctx.breakLabelCleanup.get i: (ctx.breakLabels.length - 1)
        if bcl.length > 0 then {
            lbc: "\{ind}\{bcl}"
            buf.append lbc
        }
        lbkg: "\{ind}goto __zbrk_\{bid};\n"
        buf.append lbkg
        ubk: true
        ctx.breakLabelUsed.set key: bid value: ubk
    } else {
        lbk: "\{ind}break;\n"
        buf.append lbk
    }
}

# emitContinueStmt -- `continue`, and the bare atom that is neither `break` nor
# `continue` and so is a statement whose value is discarded.
emitContinueStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    bkw: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    if bkw == "continue" then {
        # inside a do{}while(0) block wrapper a C continue exits
        # the wrapper, not the loop: jump to the nearest LOOP
        # entry's __zcont label instead (frees since that loop).
        inDo: false
        loopIdx: u64
        hasLoop: false
        li: ctx.breakLabelIsDo.length
        if li > 0 then {
            if (ctx.breakLabelIsDo.get i: (li - 1)) then inDo = true
            sj: li
            for sj > 0 loop {
                sj = sj - 1
                if (ctx.breakLabelIsDo.get i: sj) == false when hasLoop == false then {
                    loopIdx = sj
                    hasLoop = true
                }
            }
        }
        if inDo when hasLoop then {
            emitContinueFrees :ctx :tmp idx: loopIdx :ind :buf
            ccl: ctx.breakLabelCleanup.get i: loopIdx
            if ccl.length > 0 then {
                lcc: "\{ind}\{ccl}"
                buf.append lcc
            }
            cid: ctx.breakLabels.get i: loopIdx
            lcg: "\{ind}goto __zcont_\{cid};\n"
            buf.append lcg
            ucn: true
            ctx.contLabelUsed.set key: cid value: ucn
        } else {
            emitBreakFrees :ctx :tmp :ind :buf
            if ctx.breakLabelCleanup.length > 0 then {
                pcl0: (ctx.breakLabelCleanup.get
                    i: (ctx.breakLabelCleanup.length - 1)
                )
                if pcl0.length > 0 then {
                    lpc: "\{ind}\{pcl0}"
                    buf.append lpc
                }
            }
            lct: "\{ind}continue;\n"
            buf.append lct
        }
    } else {
        ue: emitExpr :ast :symtab :ctx :n
        if (ue.stringView.startsWith prefix: "/*") then {
            (emitFail
                :ctx
                what: "unhandled statement".string
                line: (ztypecheck.nodeLine :n)
            )
            lu: "\{ind}/* zemitterc: unhandled statement */\n"
            buf.append lu
        } else {
            urtid: stampIdOf :symtab nid: (interpPartNodeId :n)
            isBorrow910: (bindingRhsIsBorrow :ast :symtab :ctx :n)
            (emitDiscardedResult
                :ast
                :symtab
                :ctx
                isBorrow: isBorrow910
                ce: ue.stringView
                rtid: urtid
                :ind
                :tmp
                :buf
            )
        }
    }
}

# emitReturnStmt -- the statement shapes that are not one of the named node arms:
# a `return` with its scope cleanup, `break` / `continue` with theirs, and a bare
# expression statement.
emitReturnStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    # a no-arg method auto-call in statement position (this.accept,
    # this.statepop) is a dotted path: emit the call expression as a statement.
    if (isDottedAutoCall :n) then {
        emitDottedAutoCallStmt :ast :symtab :ctx :n :ind :tmp :buf
        return
    }
    # a bare no-arg function call as a statement (`check_mode`): typecheck
    # coerced the atom to a call; emit the call expression as a statement.
    fcs: atomTextOf :ast :n
    ffid: userFnId :ast :symtab :ctx name: fcs
    if ffid > 0 when (symtab.reg.typetypeOf typeId: ffid) == ztypes.ztypetype.functionType then {
        fce: emitExpr :ast :symtab :ctx :n
        if (fce.stringView.startsWith prefix: "/*") == false then {
            artid: stampIdOf :symtab nid: (interpPartNodeId :n)
            isBorrow911: (bindingRhsIsBorrow :ast :symtab :ctx :n)
            (emitDiscardedResult
                :ast
                :symtab
                :ctx
                isBorrow: isBorrow911
                ce: fce.stringView
                rtid: artid
                :ind
                :tmp
                :buf
            )
            return
        }
    }
    # bare control keywords parse as an AtomId reference (no value): a
    # no-value `return` (goto L_done inside a generator), `break`, `continue`.
    bkw: atomTextOf :ast :n
    if bkw == "return" then {
        if ctx.genActive then {
            lgd: "\{ind}goto L_done;\n"
            buf.append lgd
        } else {
            emitReturnCleanup :ctx :tmp retExpr: "" keepRefd: true :ind :buf
            lrt: "\{ind}return;\n"
            buf.append lrt
        }
    } else {
        if bkw == "break" then {
            emitBreakStmt :ctx :ind :tmp :buf
        } else {
            emitContinueStmt :ast :symtab :ctx :n :bkw :ind :tmp :buf
        }
    }
}

# emitReassignStmt -- `x = <value>`: the old value is freed where the binding owns
# heap, the new one is stored, and a move source is zeroed so its scope-exit free
# becomes a no-op.
emitReassignStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.reassignmentrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    topathNode: ast.nodes.get i: n.topath.u64
    valueNode: ast.nodes.get i: n.value.u64
    nm2: emitReassignLvalue :ast :symtab :ctx n: topathNode
    rcph: copyRvalueHoist :ast :symtab :ctx n: valueNode :ind :buf
    rv2: String
    if rcph.length > 0 then {
        rv2 = rcph
    } else {
        rvi: emitInterpStmtValue :ast :symtab :ctx n: valueNode :ind :tmp :buf
        if rvi.length > 0 then {
            rv2 = rvi
        } else {
            rv2 = emitExpr :ast :symtab :ctx n: valueNode
        }
    }
    # the RHS walk may have recorded _ah arg hoists: declare them HERE,
    # before the assignment line that uses them (they would otherwise
    # flush at a later statement, after -- and outside -- this scope)
    flushArgHoists :ctx :ind :tmp :buf
    rtnid: interpPartNodeId n: topathNode
    rtsid: reassignDestroyTid :ast :symtab n: topathNode nid: rtnid
    # a collection-typedef lvalue (Bytes) stores and destroys as its
    # chased underlying mono, exactly like the binding path
    rtch: chaseColMono :symtab :ctx tid: rtsid
    rtChased: false
    if rtch != rtsid then {
        rtsid = ztypes.tid.create from: rtch
        rtChased = true
    }
    rdrop: false
    if (stampIsStr :symtab :ctx nid: rtnid) then {
        rdrop = true
    } else {
        if (symtab.reg.needsDestructor typeId: rtsid) then rdrop = true
    }
    if rdrop then {
        if (isNonLvalueArg s: rv2.stringView) then {
            rrt: "\{ctx.strC}_t"
            if (stampIsStr :symtab :ctx nid: rtnid) == false then {
                rrt = typeRefC :ast :symtab :ctx tid: rtsid thisTid: ztypes.tid
                if (isHeapPtrCollection :symtab :ctx tid: rtsid) then rrt = "\{rrt}*"
            }
            rrn: tmp.next
            rrh: "\{ind}\{rrt} _rr\{rrn} = \{rv2};\n"
            buf.append rrh
            rv2 = "_rr\{rrn}"
        }
    }
    if (stampIsStr :symtab :ctx nid: rtnid) then {
        rdo: "\{ind}\{ctx.strC}_free(&\{nm2});\n"
        buf.append rdo
    } else {
        if (symtab.reg.needsDestructor typeId: rtsid) then {
            rdcb: ctxCname :ctx tid: rtsid
            # the chased mono's registry cname is authoritative (the
            # stamp name still says the typedef)
            if rtChased then rdcb = ctxCname :ctx tid: rtsid
            if (isHeapPtrCollection :symtab :ctx tid: rtsid) then {
                rdoh: "\{ind}\{rdcb}_destroy(\{nm2});\n"
                buf.append rdoh
            } else {
                rdov: "\{ind}\{rdcb}_destroy(&\{nm2});\n"
                buf.append rdov
            }
        }
    }
    lc2: "\{ind}\{nm2} = \{rv2};\n"
    buf.append lc2
    # a `<obj>.field.take` RHS moved the field out as a shallow struct
    # copy: zero the field lvalue so the owner's destructor does not
    # double-free the payload (mirrors the binding case; fn-typed fields
    # are POD references and move nothing).
    rftFn: false
    rftnid: interpPartNodeId n: valueNode
    if rftnid > 0 then {
        rftst: stampIdOf :symtab nid: rftnid
        if rftst > 0 then {
            if (symtab.reg.typetypeOf typeId: rftst) == ztypes.ztypetype.functionType then {
                rftFn = true
            }
        }
    }
    if (isFieldTake :ast n: valueNode) when rftFn == false then {
        if (isHeapPtrCollection :symtab :ctx tid: rtsid) then {
            rftzh: "\{ind}\{rv2} = NULL;\n"
            buf.append rftzh
        } else {
            rfct: "\{ctx.strC}_t"
            if (stampIsStr :symtab :ctx nid: rtnid) == false then {
                rfct = typeRefC :ast :symtab :ctx tid: rtsid thisTid: ztypes.tid
            }
            rftz: "\{ind}\{rv2} = (\{rfct}){0};\n"
            buf.append rftz
        }
    }
    # args moved into a construction/call RHS (e.g. `v.f = Option.some bo`)
    # are consumed by it -- invalidate each moved source so its scope-exit
    # free no-ops (mirrors the binding case; disjoint from the bare-local
    # move below, which a construction RHS never matches).
    emitValueTakeInvalidations :ast :symtab :ctx n: valueNode :ind :buf
    emitNarrowedTakeZero :ast :symtab :ctx n: valueNode :ind :buf
    # a reassignment from a bare owned local is a MOVE: zero the source so its
    # scope-exit free no-ops (the lvalue -- a local or a struct field appended
    # into a container -- now owns the heap). Scalars/valtypes have no
    # destructor and are left untouched.
    zsrc: implicitTakeSource :ast :symtab :ctx n: valueNode
    if zsrc.length == 0 then {
        # an explicit `<local>.take` / `.hold` moves just as a bare name
        # does; the marker form arrives as a dotted path, which
        # implicitTakeSource (bare names only) does not see. Without this
        # the source keeps its buffer and frees it again at scope exit,
        # after the target has already freed it.
        mmb: moveMarkerBase :ast n: valueNode
        if mmb > 0 then {
            zsrc = (implicitTakeSource
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: mmb.u64)
            )
        }
    }
    if zsrc.length > 0 then {
        znid: interpPartNodeId n: valueNode
        zid: stampIdOf :symtab nid: znid
        if (isHeapPtrCollection :symtab :ctx tid: zid) then {
            zinvh: "\{ind}\{zsrc} = NULL;\n"
            buf.append zinvh
        } else {
            zct: String
            if (stampIsStr :symtab :ctx nid: znid) then {
                zct = "\{ctx.strC}_t"
            } else {
                if (symtab.reg.needsDestructor typeId: zid) then {
                    zct = typeRefC :ast :symtab :ctx tid: zid thisTid: ztypes.tid
                }
            }
            if zct.length > 0 then {
                zinv: "\{ind}\{zsrc} = (\{zct}){0};\n"
                buf.append zinv
            }
        }
    }
}

# emitForStmt -- a `for` in statement position: the iteration form comes from what
# the checker resolved its condition to -- an iterator object, a bare boolean
# while, or a counted range.
emitForStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: zast.forrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    ctx.condDepth = ctx.condDepth + 1
    if (emitObjIterFor :ast :symtab :ctx m: n :ind :tmp :buf) then {
        ctx.condDepth = ctx.condDepth - 1
        return
    }
    if (emitIntRangeFor :ast :symtab :ctx m: n :ind :tmp :buf) then {
        ctx.condDepth = ctx.condDepth - 1
        return
    }
    # do-while: no pre-conditions, a post-condition (`for loop {...} while C`).
    if n.conditions.count.u64 == 0 when n.postconditions.count.u64 > 0 then {
        emitDoWhileFor :ast :symtab :ctx :n :ind :tmp :buf
        ctx.condDepth = ctx.condDepth - 1
        return
    }
    # a SUSPENDING condition cannot be written in the `while (...)` header: the
    # suspension has to land on a statement, and it has to run once per
    # iteration, not once before the loop. `while (1) { <suspend>; if (!c)
    # break; ... }` is the same loop with the condition moved to where both
    # hold -- which is exactly how the condition would be hand-written to make
    # this work, and it is why a `goto` back into the loop body still lands
    # correctly on resume.
    suspCond: forCondSuspends :ast :ctx :n
    lidW: pushLoopLabel :ctx :tmp isDo: false
    ind2: "\{ind}    "
    if suspCond then {
        (emitSuspendingWhileHead
            :ast
            :symtab
            :ctx
            :n
            :ind
            ind2: ind2.stringView
            :buf
        )
    } else {
        emitPlainWhileHead :ast :symtab :ctx :n :ind :buf
    }
    fLw: tmp.frees.length
    lLw: tmp.listFrees.length
    dvG: false
    if n.body > 0 then {
        fbw: ast.nodes.get i: n.body.u64
        emitBodyNode :ast :symtab :ctx n: fbw ind: ind2.stringView :tmp :buf
        dvG = blockDiverges :ast :symtab :ctx n: fbw
    }
    flushBlockFrees :ctx :tmp fL: fLw lL: lLw diverged: dvG :buf
    emitContLabel :ctx id: lidW ind: ind2.stringView :buf
    lwc: "\{ind}}\n"
    buf.append lwc
    popLoopLabel :ctx id: lidW :ind :buf
    ctx.condDepth = ctx.condDepth - 1
}

# emitDoWhileFor -- `for loop { .. } while C`: no pre-conditions and at
# least one post-condition, which is a do-while.
emitDoWhileFor: function {
    # the tree the body and conditions are read from
    ast: Ast.view
    # the stamps the condition text is built against
    symtab: zenv.ZSymbolTable
    # the emit context, which carries the loop labels
    ctx: Ctx
    # the for node being emitted
    n: zast.forrow.view
    # the indent the loop is written at
    ind: StringView
    # the temp counter the body's frees are registered against
    tmp: TmpCtr
    # the do-while opening, its body and its trailing test all append here
    buf: String.borrow
} is {
    lidDW: pushLoopLabel :ctx :tmp isDo: false
    ldw: "\{ind}do {\n"
    buf.append ldw
    ind2d: "\{ind}    "
    fLd: tmp.frees.length
    lLd: tmp.listFrees.length
    dvG: false
    if n.body > 0 then {
        fbd: ast.nodes.get i: n.body.u64
        emitBodyNode :ast :symtab :ctx n: fbd ind: ind2d.stringView :tmp :buf
        dvG = blockDiverges :ast :symtab :ctx n: fbd
    }
    flushBlockFrees :ctx :tmp fL: fLd lL: lLd diverged: dvG :buf
    pcond: String
    pox1419: u64
    for pox1419 < n.postconditions.count.u64 loop {
        pk: zast.kidAt kids: ast.kids span: n.postconditions i: pox1419
        pox1419 = pox1419 + 1
        pkn: ast.nodes.get i: pk.u64
        # the checker stamps the OPERATION node, so unwrap the same way
        pkop: pk
        if pkn.namedoperation then pkop = pkn.operation
        pcv: emitExpr :ast :symtab :ctx n: pkn
        tw8: (truthyCondText
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: pkop.u64)
            raw: pcv.stringView
        )
        if pcond.length > 0 then pcond.append " && "
        if tw8.length > 0 then {
            pcond.append tw8
        } else {
            pcond.append pcv
        }
    }
    if pcond.length == 0 then pcond.append "0"
    emitContLabel :ctx id: lidDW ind: ind2d.stringView :buf
    cwP: condInParens cond: pcond.stringView
    lpw: "\{ind}} while \{cwP};\n"
    buf.append lpw
    popLoopLabel :ctx id: lidDW :ind :buf
}

# emitPlainWhileHead -- the ordinary `while (c) {` opening, where no condition
# suspends and the test can stay in the header.
emitPlainWhileHead: function {
    # the tree this loop's conditions are read from
    ast: Ast.view
    # the stamps the header text is built against
    symtab: zenv.ZSymbolTable
    # the emit context the condition text is built in
    ctx: Ctx
    # the for node whose conditions these are
    n: zast.forrow.view
    # the indent the loop is written at
    ind: StringView
    # the `while (c) {` line appends here
    buf: String.borrow
} is {
    cond: String
    cox1259: u64
    for cox1259 < n.conditions.count.u64 loop {
        kId: zast.kidAt kids: ast.kids span: n.conditions i: cox1259
        cox1259 = cox1259 + 1
        k9r: ast.nodes.get i: kId.u64
        emitForCond :ast :symtab :ctx n: k9r :cond :ind :buf
    }
    # `for loop { ... }` -- no conditions, no postconditions: an unconditional
    # loop that exits via break/return.
    if cond.length == 0 then cond.append "1"
    cwW: condInParens cond: cond.stringView
    lw: "\{ind}while \{cwW} {\n"
    buf.append lw
}

# forCondSuspends -- one of a loop's conditions holds a suspension point, so
# the header has to be written as a body test instead.
forCondSuspends: function {ast: Ast.view ctx: Ctx.view n: zast.forrow.view} out bool is {
    if ctx.genActive == false then return false
    cox1269: u64
    for cox1269 < n.conditions.count.u64 loop {
        kyId: zast.kidAt kids: ast.kids span: n.conditions i: cox1269
        cox1269 = cox1269 + 1
        if (zast.yieldCountIn :ast nid: (zast.nodeid.create from: kyId)) > 0 then return true
    }
    return false
}

# emitSuspendingWhileHead -- the opening of a loop whose CONDITION suspends:
# `while (1) {`, the condition's suspensions, then `if (!c) break;`.
#
# A suspension has to land on a statement, so it cannot be written inside the
# `while (...)` header; and it has to run once per iteration, so it cannot be
# hoisted above the loop either. Moving the test into the body satisfies both,
# and is the same loop -- it is what the condition would be hand-written as to
# make this work.
emitSuspendingWhileHead: function {
    # the tree this loop's conditions are read from
    ast: Ast.view
    # read for the resume type of each suspension in the condition
    symtab: zenv.ZSymbolTable
    # carries the state-machine cursor and the resume slots
    ctx: Ctx
    # the for node whose conditions these are
    n: zast.forrow.view
    # the indent the loop itself is written at
    ind: StringView
    # the indent inside it, where the suspensions and the test go
    ind2: StringView
    # the loop opening, the suspensions and the break test all append here
    buf: String.borrow
} is {
    buf.append "\{ind}while (1) {\n"
    cox1279: u64
    for cox1279 < n.conditions.count.u64 loop {
        kcId: zast.kidAt kids: ast.kids span: n.conditions i: cox1279
        cox1279 = cox1279 + 1
        (hoistExprYields
            :ast
            :symtab
            :ctx
            nid: (zast.nodeid.create from: kcId)
            ind: ind2
            :buf
        )
    }
    condS: String
    cox1289: u64
    for cox1289 < n.conditions.count.u64 loop {
        ksId: zast.kidAt kids: ast.kids span: n.conditions i: cox1289
        cox1289 = cox1289 + 1
        k9s: ast.nodes.get i: ksId.u64
        emitForCond :ast :symtab :ctx n: k9s cond: condS ind: ind2 :buf
    }
    if condS.length == 0 then condS.append "1"
    cwS: condInParens cond: condS.stringView
    buf.append "\{ind2}if (!\{cwS}) break;\n"
}

# emitIfStmt -- an `if` in statement position. A chain whose conditions all fold
# emits only the live branch: spec.pdoc promises the false branch is not emitted,
# and that promise is not limited to expression position.
emitIfStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: zast.ifrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    # constant guards: when every clause folds at emit time, only the
    # winning body is emitted -- provably-dead branches (including dead
    # `error` arms) are eliminated from the C.
    efb: foldedBranchOf :symtab nid: n.nodeid.u64
    if efb.known then {
        ewb: efb.stmt
        if ewb.isZero == false then {
            lfo: "\{ind}{\n"
            buf.append lfo
            indE: "\{ind}    "
            fLE: tmp.frees.length
            lLE: tmp.listFrees.length
            ewn: ast.nodes.get i: ewb.u64
            emitBodyNode :ast :symtab :ctx n: ewn ind: indE.stringView :tmp :buf
            dvF: blockDiverges :ast :symtab :ctx n: ewn
            flushBlockFrees :ctx :tmp fL: fLE lL: lLE diverged: dvF :buf
            lfc: "\{ind}}\n"
            buf.append lfc
        }
        return
    }
    ctx.condDepth = ctx.condDepth + 1
    ifAssign: String
    first: true
    clx969: u64
    for clx969 < n.clauses.count.u64 loop {
        cId: zast.kidAt kids: ast.kids span: n.clauses i: clx969
        clx969 = clx969 + 1
        isFirst: first
        first = false
        c: ast.nodes.get i: cId.u64
        (emitIfClause
            :ast
            :symtab
            :ctx
            n: c
            :isFirst
            assignTo: ifAssign.stringView
            :ind
            :tmp
            :buf
        )
    }
    chS: List String
    chV: ListVal ztypes.vid
    chA: List String
    chT: ListVal u64
    chN: ListVal bool
    chR: List String
    (chainFactsOfClauses
        :ast
        :symtab
        :ctx
        clauses: n.clauses
        subjects: chS
        svids: chV
        arms: chA
        tids: chT
        negs: chN
        recvs: chR
    )
    (emitElse
        :ast
        :symtab
        :ctx
        oId: n.elseclause
        assignTo: ifAssign.stringView
        :ind
        :tmp
        chSubjects: chS
        chSubjectVids: chV
        chArms: chA
        chTids: chT
        chNegs: chN
        chRecvs: chR
        :buf
    )
    le: "\{ind}}\n"
    buf.append le
    ctx.condDepth = ctx.condDepth - 1
}

# registerScopeDestroy -- record the scope-exit cleanup a freshly bound OWNED
# local earns: a String rides the block's String free list, and anything else
# carrying a destructor gets its `_destroy` registered against the same block.
# A BORROW registers nothing -- whoever owns the value frees it, and freeing it
# here would be the second free.
#
# Asked by every path that binds a name to a value, so no two of them can
# disagree about what a binding owes at scope exit. `with` did not ask at all,
# and leaked whatever it bound.
registerScopeDestroy: function {
    # the tree the value was read from
    ast: Ast.view
    # the symbol table the type and the borrow question are asked of
    symtab: zenv.ZSymbolTable.view
    # the emit context, for the C name and the box test
    ctx: Ctx
    # the bound value's type
    tid: ztypes.tid
    # the binding's emitted C name
    nm: StringView
    # the binding's variable id, which the flush matches against
    nameVid: ztypes.vid
    # the value node, for the borrow question
    valueNode: astnode.view
    # the block's pending-cleanup lists
    tmp: TmpCtr
} is {
    if (bindingRhsIsBorrow :ast :symtab :ctx n: valueNode) then return
    if tid == ctx.strTid then {
        tmp.oweFree name: nm.string vid: nameVid
        return
    }
    hasDtor: false
    if (symtab.reg.needsDestructor typeId: tid) then hasDtor = true
    uorig: originTidOf :symtab :tid
    if uorig > 0 when (symtab.reg.typetypeOf typeId: tid) == ztypes.ztypetype.unionType then {
        hasDtor = true
    }
    if hasDtor == false then return
    dcb: ctxCname :ctx :tid
    dref: "&\{nm}"
    if (isBoxTid :symtab :tid) then dref = nm.string
    df: "    \{dcb}_destroy(\{dref});\n"
    tmp.oweList stmt: df.copy name: nm.string vid: nameVid
}

# emitWithStmt -- `with x: <value> do <body>`: the value is bound for the body's
# duration and destroyed with the block it was bound in, whatever exit the body
# takes. The binding is emitted into the ENCLOSING C block rather than braces of
# its own, so that block's flush is where its cleanup belongs -- and inside a
# loop body that flush runs per iteration.
emitWithStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: zast.withrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    wnmR: zast.nameTextAt :ast ref: n.name
    wnm: varCName :ctx vid: (defVid :symtab nid: n.nodeid.u64) name: wnmR.stringView
    wsid: stampIdDeep :ast :symtab n: (ast.nodes.get i: n.value.u64)
    wct: String
    if (originTidOf :symtab tid: (ztypes.tid.create from: wsid.u64)) > 0 then {
        wct = (typeRefC
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: wsid.u64)
            thisTid: ztypes.tid
        )
    } else {
        wtn: stampNameDeep :ast :symtab n: (ast.nodes.get i: n.value.u64)
        wct = cTypeForName :ast :symtab :ctx name: wtn.stringView
    }
    wv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.value.u64)
    # a non-lvalue receiver (`with x: (mk).iterate do`) hoisted an _ahN temp
    # while that expression was built; declare it before the line that reads
    # it, as the plain-binding path does
    flushArgHoists :ctx :ind :tmp :buf
    # a reference-returning callee hands back `T*`, so a `with` binding
    # ALIASES its source exactly as a plain binding does
    {
        wrb: refBorrowCalleeFid :ast :symtab :ctx n: (ast.nodes.get i: n.value.u64)
        if wrb > 0 when (fnReturnsRefBorrow
            :ast
            :symtab
            :ctx
            fid: (ztypes.tid.create from: wrb.u64)
            retTid: (ztypes.tid.create from: wsid.u64)
        ) then {
            wct = "\{wct}*"
            ctx.ptrVids.append (defVid :symtab nid: n.nodeid.u64)
        }
    }
    if wct.length > 0 then {
        lwv: "\{ind}\{wct} \{wnm} = \{wv};\n"
        buf.append lwv
    } else {
        lwv2: "\{ind}int64_t \{wnm} = \{wv};\n"
        buf.append lwv2
    }
    # a `with` binds a value exactly as an ordinary binding does, and owes the
    # same two things -- neither of which it did. The value may be a call that
    # took ownership of an argument, so the caller zeroes that source here; and
    # an OWNED value earns its scope-exit destroy, which is what registerScopeDestroy
    # records for every other binding.
    #
    # THE TWO OMISSIONS CANCELLED IN ONE SHAPE. `with b: (Bag s: src)` was clean
    # only because the un-zeroed `src` freed the buffer the un-destroyed `b`
    # should have, so adding the destroy alone turns that program into a double
    # free. They belong together.
    emitValueTakeInvalidations :ast :symtab :ctx n: (ast.nodes.get i: n.value.u64) :ind :buf
    # INSIDE A GENERATOR the header binds a temp and the lowering re-binds the
    # author's name as the block's first statement, so that binding owns the
    # value -- promoted to a field and destroyed with the instance, or an
    # ordinary local registering its own cleanup. The temp holds nothing by the
    # time the block starts.
    #
    # It could not be freed at scope exit even if it did: the free site is
    # reachable only through a resume `goto` that jumped past the temp's
    # declaration, so it would free an indeterminate local. That is the same
    # rule every other name in a resumable body obeys -- a C local does not
    # survive a suspension -- and the corpus catches it as `free(): invalid
    # pointer` rather than as a leak.
    if ctx.genActive == false then (registerScopeDestroy
        :ast
        :symtab
        :ctx
        tid: (ztypes.tid.create from: wsid.u64)
        nm: wnm.stringView
        nameVid: (defVid :symtab nid: n.nodeid.u64)
        valueNode: (ast.nodes.get i: n.value.u64)
        :tmp
    )
    emitBodyNode :ast :symtab :ctx n: (ast.nodes.get i: n.body.u64) :ind :tmp :buf
}

# emitCaseStmt -- a `match` in statement position, delegated to the shared arm
# emitter.
emitCaseStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: zast.caserow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    # constant subject over literal arms: emit only the matching arm, as
    # the typechecker resolved it.
    mfb: foldedBranchOf :symtab nid: n.nodeid.u64
    if mfb.known then {
        mwb: mfb.stmt
        if mwb.isZero == false then {
            lmo: "\{ind}{\n"
            buf.append lmo
            indM: "\{ind}    "
            fLM: tmp.frees.length
            lLM: tmp.listFrees.length
            mwn: ast.nodes.get i: mwb.u64
            emitBodyNode :ast :symtab :ctx n: mwn ind: indM.stringView :tmp :buf
            dvF: blockDiverges :ast :symtab :ctx n: mwn
            flushBlockFrees :ctx :tmp fL: fLM lL: lLM diverged: dvF :buf
            lmc: "\{ind}}\n"
            buf.append lmc
        }
        return
    }
    ctx.condDepth = ctx.condDepth + 1
    emitMatchStmt :ast :symtab :ctx m: n assignTo: "" :ind :tmp :buf
    ctx.condDepth = ctx.condDepth - 1
}

# emitSwapStmt -- `a >< b`: a three-step exchange through one temporary, so both
# sides keep whatever ownership they held.
emitSwapStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.swapstmtrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    lhn: ast.nodes.get i: n.lhs.u64
    rhn: ast.nodes.get i: n.rhs.u64
    lx: emitExpr :ast :symtab :ctx n: lhn
    rx: emitExpr :ast :symtab :ctx n: rhn
    lnid: interpPartNodeId n: lhn
    lsid: stampIdOf :symtab nid: lnid
    lct: typeRefC :ast :symtab :ctx tid: lsid thisTid: ztypes.tid
    if lct.length == 0 then {
        pmsg6: "zemitterc: unspellable swap operand type id \{lsid}"
        panic pmsg6
    }
    sN: tmp.next
    s0: "\{ind}{\n"
    buf.append s0
    s1: "\{ind}    \{lct} _sw\{sN} = \{lx};\n"
    buf.append s1
    s2: "\{ind}    \{lx} = \{rx};\n"
    buf.append s2
    s3: "\{ind}    \{rx} = _sw\{sN};\n"
    buf.append s3
    s4: "\{ind}}\n"
    buf.append s4
}

# emitDoStmt -- a `do` block in statement position: its own C scope, so the locals
# it binds are freed at its end.
emitDoStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: zast.dorow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    if (ztypecheck.blockHasBreak :ast n: (ast.nodes.get i: n.statement.u64)) then {
        ldo: "\{ind}do {\n"
        buf.append ldo
        indd: "\{ind}    "
        # the block is its own break target: a break inside frees the
        # block's owned temps (since these marks) and lands after the
        # block, not on an enclosing loop's label
        sdoId: pushLoopLabel :ctx :tmp isDo: true
        sfL: tmp.frees.length
        slL: tmp.listFrees.length
        dst: ast.nodes.get i: n.statement.u64
        emitBodyNode :ast :symtab :ctx n: dst ind: indd.stringView :tmp :buf
        dvF: blockDiverges :ast :symtab :ctx n: dst
        flushBlockFrees :ctx :tmp fL: sfL lL: slL diverged: dvF :buf
        lwh: "\{ind}} while (0);\n"
        buf.append lwh
        popLoopLabel :ctx id: sdoId :ind :buf
    } else {
        (emitBodyNode
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.statement.u64)
            :ind
            :tmp
            :buf
        )
    }
}


# emitStmt -- one statement of a function body.
emitStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    # a suspension point is a CALL now, so it is intercepted before the match
    # rather than owning an arm -- adding a `call` arm here would re-route
    # every ordinary call away from the tail leg that handles them.
    if ctx.genActive when (isYieldNode :ast :n) then {
        ycs: zast.yieldCallIdAt :ast nid: (zast.nodeIdOf :n)
        # this yield's OPERAND may itself contain yields, and they evaluate
        # before it does -- so they suspend first
        (hoistExprYields
            :ast
            :symtab
            :ctx
            nid: (zast.yieldCallOperandAt :ast nid: ycs)
            :ind
            :buf
        )
        emitYieldStmt :ast :symtab :ctx callId: ycs :ind :buf
        return
    }
    # a yield written in EXPRESSION position suspends the function, so it
    # cannot stay inside the C expression: hoist each one to its own statement
    # first and leave a temp behind for the expression emitter to read.
    if ctx.genActive then {
        hnid: zast.nodeIdOf :n
        (hoistExprYields
            :ast
            :symtab
            :ctx
            nid: hnid
            :ind
            :buf
        )
    }
    match (
        n
    ) case statementline then {
        sln: ast.nodes.get i: n.statementline.u64
        emitStmt :ast :symtab :ctx n: sln :ind :tmp :buf
    } case expression then {
        emitStmt :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64) :ind :tmp :buf
    } case statement then {
        stx739: u64
        for stx739 < n.statements.count.u64 loop {
            s9Id: zast.kidAt kids: ast.kids span: n.statements i: stx739
            stx739 = stx739 + 1
            emitStmt :ast :symtab :ctx n: (ast.nodes.get i: s9Id.u64) :ind :tmp :buf
        }
    } case doexpr then {
        emitDoStmt :ast :symtab :ctx :n :ind :tmp :buf
    } case call then {
        emitCallStmt :ast :symtab :ctx call: n :ind :tmp :buf
    } case assignment then {
        emitAssignment :ast :symtab :ctx :n :ind :tmp :buf
    } case reassignment then {
        emitReassignStmt :ast :symtab :ctx :n :ind :tmp :buf
    } case swapstmt then {
        emitSwapStmt :ast :symtab :ctx :n :ind :tmp :buf
    } case ifexpr then {
        emitIfStmt :ast :symtab :ctx :n :ind :tmp :buf
    } case caseexpr then {
        emitCaseStmt :ast :symtab :ctx :n :ind :tmp :buf
    } case withexpr then {
        emitWithStmt :ast :symtab :ctx :n :ind :tmp :buf
    } case forexpr then {
        emitForStmt :ast :symtab :ctx :n :ind :tmp :buf
    } else {
        emitReturnStmt :ast :symtab :ctx :n :ind :tmp :buf
    }
}

# ensureUnitCache -- build the emit-stable unit lists (tids for the id probe,
# keys for the composed-key fallback) once per Ctx. The program root's children
# are settled in typecheck and never mutated during emit, so the snapshot stays
# valid.
ensureUnitCache: function {ctx: Ctx pool: zast.StringPool.view symtab: zenv.ZSymbolTable.view} is {
    if ctx.unitCacheBuilt then return
    puds: ztypecheck.programUnitDecls st: symtab
    with uit: puds.iterate do for ud: uit loop {
        ud8: ztypes.declid.create from: ud
        utd: ztypecheck.declTypeIdOf st: symtab declId: ud8
        if utd.isZero == false then {
            ukc: (zast.poolTextAt
                :pool
                ref: (ztypecheck.declNameIdOf st: symtab declId: ud8)
            )
            ctx.unitKeysC.append ukc.copy
            ctx.unitTidsC.append utd
        }
    }
    ctx.unitCacheBuilt = true
}

# resolveTypeIdByNameId -- a type id for an already-interned name (Ast.names
# pool id): main-unit, then system, then the cross-unit lookup. 0 when
# unresolved (incl. a 0 id -- a name not in the pool matches no member).
# Every stage is id-keyed (declChildOfId); the name text is materialised only on
# the rare composed-key fallback.
resolveTypeIdByNameId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    nameId: zast.nameid
} out u64 is {
    if nameId.isZero then return 0
    mc: ctx.resolveByNameC.get key: nameId.u64
    match (
        mc
    ) case some then {
        return mc
    } case none then null
    r: typeIdByNameStages :ast :symtab :ctx :nameId
    ctx.resolveByNameC.set key: nameId.u64 value: r
    return r
}

# resolve a type id by name across the resolution stages.
typeIdByNameStages: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    nameId: zast.nameid
} out u64 is {
    f: userFnIdById :ast :symtab :ctx :nameId
    if f > 0 then return f
    mo: ztypecheck.resolveUnitChildRo :ast st: symtab unitDecl: symtab.typing.systemUnitRoot :nameId
    match (
        mo
    ) case some then {
        return mo
    } case none then null
    lr: ((ztypecheck.walkLookupTyperefByIdRo
        frame: ztypes.declid
        :ast
        st: symtab
        unitDecl: ctx.mainUnitId
        baseId: nameId
    ).or
        d: 0
    )
    if lr > 0 then return lr
    # cross-unit: the type may live in a dep unit (zlexer/zast/zvfs) outside
    # walkLookupTyperefById's search list. Pass 1 probes each unit scope by id
    # (no key composition); the composed-key resolvedByKey pass (which also
    # follows unit-level aliases) runs only when every direct probe missed.
    found: u64
    ensureUnitCache :ctx pool: ast.names :symtab
    uki: u64
    ukn: ctx.unitTidsC.length
    for uki < ukn loop {
        if found == 0 then {
            co: (symtab.typing.declChildOfId
                parentTypeId: (ctx.unitTidsC.get i: uki)
                :nameId
            )
            match (
                co
            ) case some then {
                found = co
            } case none then null
        }
        uki = uki + 1
    }
    if found == 0 then {
        uki8: u64
        ukn8: ctx.unitKeysC.length
        for uki8 < ukn8 loop {
            if found == 0 then {
                uk: ctx.unitKeysC.get i: uki8
                ud7x: (ztypecheck.unitDeclOfName
                    st: symtab
                    nameId: (zast.poolFind pool: ast.names text: uk.stringView)
                )
                r2: (ztypecheck.resolvedByIdsRo
                    :ast
                    st: symtab
                    unitDecl: ud7x
                    name: nameId
                )
                match (
                    r2
                ) case some then {
                    found = r2
                } case none then null
            }
            uki8 = uki8 + 1
        }
    }
    return found
}

# resolveTypeIdByName -- text entry point: intern-probe the name to a pool id
# (a name not in the pool matches no interned member, so 0 resolves to 0) and
# resolve id-keyed.
resolveTypeIdByName: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    name: StringView
} out u64 is {
    nid: (zast.poolFind pool: ast.names text: name)
    return (resolveTypeIdByNameId :ast :symtab :ctx nameId: nid)
}

# fnReturnTidOf -- the registry-recorded return tid for a FUNCTION id, 0 when
# absent. Scopes the typeById view so no lock outlives the read.
fnReturnTidOf: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out u64 is {
    r: u64
    {
        rt: symtab.reg.returnTypeOf :tid
        if rt > 0 then r = rt
    }
    return r
}

# genericOriginTid -- the registry-recorded generic origin for `tid`, 0 when
# absent. Scopes the typeById view like fnReturnTidOf.
genericOriginTid: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out ztypes.tid is {
    g: u64
    {
        go: symtab.reg.genericOriginOf :tid
        if go > 0 then g = go
    }
    return (ztypes.tid.create from: g)
}

# definedInUnitOf -- the defining unit recorded for `tid`, as an OWNED option.
# The map view lives only inside this body: a view bound at a call site would
# hold its shared lock across symtab-passing calls and conflict.
definedInUnitOf: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out Option String is {
    duO: definedInUnitTid :symtab :tid
    if duO.isZero then return (Option.none String)
    nm: (ztypecheck.unitNameOfTid
        st: symtab
        tid: (ztypes.tid.create from: tid.u64)
    )
    if nm.length == 0 then return (Option.none String)
    return (Option.some nm)
}

# definedInUnitTid -- the id of the unit a type is DEFINED in, 0 when none (a
# shell, a builtin, a mono minted outside any unit). The same question
# definedInUnitOf answers, without the name: asking whether a type has a
# defining unit at all is what most callers want, and the name form costs a
# registry copy and a boxed Option to say yes.
definedInUnitTid: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out ztypes.tid is {
    ud: ztypecheck.unitDeclOfTid st: symtab tid: (ztypes.tid.create from: tid.u64)
    if ud.isZero then return ztypes.tid
    r: ztypes.tid
    {
        decl: symtab.typing.decls.get i: ud.u64
        r = decl.typeId
    }
    return r
}

# reassignDestroyTid -- the type an assignment's old value is destroyed as. A
# REBIND of a bare name replaces the whole variable, so that is the variable's
# DECLARED type: under a narrowing the occurrence is stamped with the arm's
# payload type instead, whose destructor answers for the payload and not for
# the union holding it, and the arm the variable still held would leak. Every
# other target answers with its own stamp.
reassignDestroyTid: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: astnode.view
    nid: u64
} out ztypes.tid is {
    stamped: stampIdOf :symtab :nid
    rbn: bareAtomText :ast :n
    if rbn.length == 0 then return stamped
    rbv: atomVid :symtab nid: (atomNodeId :n)
    if rbv.isZero then return stamped
    declared: symtab.reg.variableTypeOf id: rbv
    if declared.isZero then return stamped
    return declared
}

# emitReassignLvalue -- the C lvalue for a reassignment target. A `got.field`
# whose base atom is a narrowed match-arm binding over a borrowed reftype view
# (seeded in narrowBox) writes THROUGH the box into the live entry; the local
# read-copy is not the backing storage. Other targets emit normally.
emitReassignLvalue: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
} out String is {
    # a REBIND names the VARIABLE, never the payload a narrowing aliased it to:
    # `s = Sum.two` inside an arm that narrowed `s` replaces the whole union,
    # and writing through the arm's payload view would assign a union to a
    # payload. A write THROUGH the subject (the dotted leg below) does take the
    # alias, which is what the narrowing is for.
    {
        rbNm: bareAtomText :ast :n
        if rbNm.length > 0 then {
            rbVid: atomVid :symtab nid: (atomNodeId :n)
            if rbVid.isZero == false then {
                if (vvGet xs: ctx.narrowBox vid: rbVid).length > 0 then {
                    return (varCName :ctx vid: rbVid name: rbNm)
                }
            }
        }
    }
    if n.dottedpath then {
        ba: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
        if ba.length > 0 then {
            ba9V: atomVid :symtab nid: (atomNodeId n: (ast.nodes.get i: n.parent.u64))
            nbo: vvGet xs: ctx.narrowBox vid: ba9V
            if nbo.length > 0 then {
                mem: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
                memP: memberCPrefix name: mem
                lvx: "\{nbo}.\{memP}\{mem}"
                return lvx
            }
        }
        memFp: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        rpnid: interpPartNodeId n: (ast.nodes.get i: n.parent.u64)
        stampTid: stampIdOf :symtab nid: rpnid
        rsn: regNameOf :symtab tid: stampTid
        rsc: canonFnId :ast :symtab :ctx tid: stampTid name: rsn.stringView
        rsFp: stampTid
        if rsc > 0 then rsFp = ztypes.tid.create from: rsc.u64
        rsFpc: chaseColMono :symtab :ctx tid: rsFp
        if (symtab.typing.declIsFnptrField
            pool: ast.names
            parentTypeId: rsFpc
            name: memFp.stringView
        ) then {
            recvFp: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
            rfv: atomVid :symtab nid: (atomNodeId n: (ast.nodes.get i: n.parent.u64))
            accFpL: ".".string
            if (isPtrVid :ctx vid: rfv) then accFpL = "->".string
            recvFpC: emitLocalAtomName :ctx name: recvFp.stringView vid: rfv
            memFpP: memberCPrefix name: memFp.stringView
            return "\{recvFpC}\{accFpL}\{memFpP}\{memFp}"
        }
    }
    return (emitExpr :ast :symtab :ctx :n)
}

# genericOwnerKey -- the declaration of a generic's ORIGIN template, keyed from
# any of its instantiations, so every mono of one template answers the same id.
# 0 when the type is not a generic instance.
genericOwnerKey: function {
    symtab: zenv.ZSymbolTable.view
    ownerTid: ztypes.tid
} out ztypes.declid is {
    orig: genericOriginTid :symtab tid: ownerTid
    if orig.isZero then return (ztypes.declid.create from: 0)
    return (ztypecheck.declOfTypeId st: symtab tid: (ztypes.tid.create from: orig.u64))
}

# emit the selected arm of a compile-time generic `match`.
emitGenericDissect: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    m: zast.caserow.view
    ownerTid: ztypes.tid
    paramName: zast.nameid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    concrete: ztypes.tid
    isVal: false
    if ownerTid > 0 then {
        tk: genericOwnerKey :symtab :ownerTid
        if tk.isZero == false then {
            pnames: symtab.reg.genericParamNamesOf tdecl: tk
            found: false
            ord: u64
            k: u64
            with pnit: pnames.iterate do for pn: pnit loop {
                if found == false then {
                    if pn == paramName then {
                        found = true
                        ord = k
                    } else {
                        k = k + 1
                    }
                }
            }
            if found then {
                concrete = ztypes.tid.create from: (symtab.reg.genericArgAt
                    specId: ownerTid
                    ordinal: ord
                )
                isVal = symtab.reg.genericArgIsValueAt specId: ownerTid ordinal: ord
            }
        }
    }
    win: u32
    subjDesc: String
    if isVal then {
        subjDesc = "\{concrete}"
        clx979: u64
        for clx979 < m.clauses.count.u64 loop {
            cId: zast.kidAt kids: ast.kids span: m.clauses i: clx979
            clx979 = clx979 + 1
            cnode: ast.nodes.get i: cId.u64
            if cnode.caseclause then {
                if win == 0 then {
                    if cnode.name != 0 then {
                        cnt: zast.poolTextAt pool: ast.names ref: cnode.name
                        pu: cnt.stringView.parseU64
                        match (
                            pu
                        ) case ok then {
                            if pu == concrete then win = cnode.statement
                        } case err then null
                    }
                }
            }
        }
    } else {
        cn0: String
        if concrete > 0 then cn0 = (regNameOf
            :symtab
            tid: (ztypes.tid.create from: concrete.u64)
        )
        cnid: u32
        if cn0.length > 0 then cnid = zast.poolFind pool: ast.names text: cn0.stringView
        clx989: u64
        for clx989 < m.clauses.count.u64 loop {
            cId: zast.kidAt kids: ast.kids span: m.clauses i: clx989
            clx989 = clx989 + 1
            cnode: ast.nodes.get i: cId.u64
            if cnode.caseclause then {
                if win == 0 then {
                    if cnid != 0 when cnode.name.u32 == cnid then win = cnode.statement
                }
            }
        }
        subjDesc = cn0
    }
    if win == 0 then win = m.elseclause
    if win > 0 then {
        buf.append ind
        buf.append "{\n"
        emitBodyNode :ast :symtab :ctx n: (ast.nodes.get i: win.u64) :ind :tmp :buf
        buf.append ind
        buf.append "}\n"
    } else {
        pnmT: zast.poolTextAt pool: ast.names ref: paramName
        cnm: "generic match on '\{pnmT}' has no case for '\{subjDesc}' and no else"
        ctx.emitErrors.append from: cnm.copy
        ef: "\{ind}z_panic(\"(compile-time error)\");\n"
        buf.append ef
    }
}

# the core (stripped) subject node id of a match.
matchSubjectCore: function {ast: Ast.view nid: u64} out u64 is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case expression then {
        return (matchSubjectCore :ast nid: n.expression.u64)
    } else {
        return nid
    }
}

# matchOrdinalPairRoute -- an ordinal-pair subject (two ordinal variants matched
# together) has its own emitter. True when it took the match.
matchOrdinalPairRoute: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    m: zast.caserow.view
    subj: StringView
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    sTid: stampIdDeep :ast :symtab n: (ast.nodes.get i: m.subject.u64)
    if (isOrdinalPair :symtab tid: (ztypes.tid.create from: sTid.u64)) then {
        (emitOrdinalPairMatch
            :ast
            :symtab
            :ctx
            :m
            :subj
            tid: (ztypes.tid.create from: sTid.u64)
            :assignTo
            :ind
            :tmp
            :buf
        )
        return true
    }
    return false
}

# matchGenericRoute -- a subject whose type is a GENERIC PARAMETER, named either
# bare or through a dotted path, dissects instead of switching: there is no
# tag to switch on until the parameter is bound. True when it took the match.
matchGenericRoute: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    m: zast.caserow.view
    stn: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    subjSid: stampIdOf :symtab nid: (interpPartNodeId n: (ast.nodes.get i: m.subject.u64))
    if subjSid > 0 then {
        if (symtab.reg.typetypeOf typeId: subjSid) == ztypes.ztypetype.genericParam then {
            paramName9: (zast.poolFind pool: ast.names text: stn)
            (emitGenericDissect
                :ast
                :symtab
                :ctx
                :m
                ownerTid: ctx.curThisTid
                paramName: paramName9
                :ind
                :tmp
                :buf
            )
            return true
        }
    }
    dcore: matchSubjectCore :ast nid: m.subject.u64
    dcn: ast.nodes.get i: dcore.u64
    if dcn.dottedpath then {
        dleaf: dottedChildText :ast n: (ast.nodes.get i: dcore.u64)
        dbnid: dottedBaseNodeId :ast n: (ast.nodes.get i: dcore.u64)
        dbst: stampIdOf :symtab nid: dbnid
        downer: ctx.curThisTid
        if (symtab.reg.genericArgCount specId: dbst) > 0 then downer = dbst
        if downer > 0 when dleaf.length > 0 then {
            dkey: genericOwnerKey :symtab ownerTid: downer
            if dkey > 0 then {
                dleafId: zast.poolFind pool: ast.names text: dleaf
                if (symtab.reg.isGenericParamOf tdecl: dkey name: dleafId) then {
                    (emitGenericDissect
                        :ast
                        :symtab
                        :ctx
                        :m
                        ownerTid: downer
                        paramName: dleafId
                        :ind
                        :tmp
                        :buf
                    )
                    return true
                }
            }
        }
    }
    return false
}

# matchelse -- the residual narrowing an else arm inherits: when exactly ONE arm
# is uncovered, the else branch KNOWS the subject is that arm.
matchelse: record {
    # the else arm's type
    meT: ztypes.tid
    # whether that type was seeded rather than inferred
    meSeed: bool
}

# matchElseNarrowing -- work out that residual arm and the alias text for it.
# Answers seeded=false when the else covers more than one arm, when the subject
# has no name to narrow, or when the else body reassigns it.
matchElseNarrowing: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    m: zast.caserow.view
    vtid: ztypes.tid
    sname: StringView
    covA: (ListVal zast.nameid).view
    mN: u64
    meV: String.borrow
} out matchelse is {
    meT: ztypes.tid
    meSeed: false
    if (m.elseclause > 0) == false then return (matchelse :meT :meSeed)
    if sname.length == 0 then return (matchelse :meT :meSeed)
    allME: ListVal u64
    (zenv.sumArmNameIds
        ty: symtab.typing
        reg: symtab.reg
        tid: (ztypes.tid.create from: vtid.u64)
        ids: allME
    )
    remME: u64
    armME: zast.nameid
    with mit: allME.iterate do for ma: mit loop {
        maId: zast.nameid.create from: ma.u32.orPanic
        cov: false
        with cvi: covA.iterate do for cv: cvi loop {
            if cv == maId then cov = true
        }
        if cov == false then {
            remME = remME + 1
            armME = maId
        }
    }
    if remME == 1 then {
        mre: false
        if m.elseclause > 0 then {
            mec: ast.nodes.get i: m.elseclause.u64
            mre = bodyReassigns :ast n: mec name: sname
        }
        if mre == false then {
            mrecv: "_m\{mN}"
            # the residual arm's text is spelled into the alias: one copy, here
            armMET: zast.poolTextCopy pool: ast.names ref: armME
            aliasText: (armAliasText
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: vtid.u64)
                arm: armMET.stringView
                recv: mrecv.stringView
                acc: "."
            )
            if aliasText.length > 0 then {
                meV.append aliasText
                meT = ztypes.tid.create from: ((symtab.typing.declChildOfId
                    parentTypeId: (ztypes.tid.create from: vtid.u64)
                    nameId: armME
                ).or
                    d: 0
                )
                meSeed = true
            }
        }
    }
    return (matchelse :meT :meSeed)
}


# emitMatchStmt -- a variant-subject match as a tag switch over a temp;
# payload arms shadow the subject name with the payload value.
# emitGenericDissect -- compile-time `match` on a generic parameter. The concrete
# type bound to the parameter for the current mono instance (ctx.curThisTid) is
# resolved through the registry's generic-argument trie; the arm whose label
# names that type is emitted
# inline and every other arm is dropped (no runtime switch). No matching arm and
# no `else` emits nothing (the caller-level no-match check is a compile error).
emitMatchStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    m: zast.caserow.view
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    sx: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: m.subject.u64)
    stn: stampNameDeep :ast :symtab n: (ast.nodes.get i: m.subject.u64)
    if (matchOrdinalPairRoute
        :ast
        :symtab
        :ctx
        :m
        subj: sx.stringView
        :assignTo
        :ind
        :tmp
        :buf
    ) then return
    vtid: (canonTypeId
        :ast
        :symtab
        :ctx
        tid: (stampIdDeep :ast :symtab n: (ast.nodes.get i: m.subject.u64))
        name: stn.stringView
    )
    if (matchGenericRoute :ast :symtab :ctx :m stn: stn.stringView :ind :tmp :buf) then return
    isVar: false
    isUni: false
    if vtid > 0 then {
        vtt0: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: vtid.u64)
        if vtt0 == ztypes.ztypetype.variantType then isVar = true
        if vtt0 == ztypes.ztypetype.unionType then isUni = true
    }
    if isVar == false then {
        if isUni == false then {
            sct: (scalarCTypeFor
                :symtab
                name: stn.stringView
                tid: (ztypes.tid.create from: vtid.u64)
            )
            if sct.length > 0 then {
                emitScalarMatch :ast :symtab :ctx :m subj: sx.stringView :assignTo :ind :tmp :buf
                return
            }
            emitFail :ctx what: "unhandled match subject type \{stn}" line: m.lineno
            lu0: "\{ind}/* zemitterc: unhandled match subject type \{stn} */\n"
            buf.append lu0
            return
        }
    }
    vc: ctxCname :ctx tid: (ztypes.tid.create from: vtid.u64)
    mN: tmp.next
    sxM: "\{sx}"
    if (needsValueDeref
        :ast
        :symtab
        :ctx
        n: (ast.nodes.get i: m.subject.u64)
        tid: (ztypes.tid.create from: vtid.u64)
    ) then sxM = "(*\{sx})"
    l0: "\{ind}\{vc}_t _m\{mN} = \{sxM};\n"
    buf.append l0
    accM: ".tag".string
    if (isOrdinalVariant :symtab tid: (ztypes.tid.create from: vtid.u64)) then accM = "".string
    l1: "\{ind}switch (_m\{mN}\{accM}) {\n"
    buf.append l1
    sname: atomTextDeep :ast n: (ast.nodes.get i: m.subject.u64)
    # the subject's variable: inside an arm the bound name IS the subject,
    # narrowed, so its declaration must carry the same identifier the body's
    # references resolve to
    snameV: atomVid :symtab nid: (atomNodeIdDeep :ast n: (ast.nodes.get i: m.subject.u64))
    ind2: "\{ind}    "
    clx999: u64
    for clx999 < m.clauses.count.u64 loop {
        cId: zast.kidAt kids: ast.kids span: m.clauses i: clx999
        clx999 = clx999 + 1
        c: ast.nodes.get i: cId.u64
        (emitMatchClause
            :ast
            :symtab
            :ctx
            :c
            vtid: (ztypes.tid.create from: vtid.u64)
            :isUni
            :mN
            :sname
            snameVid: snameV
            :assignTo
            ind: ind2.stringView
            :tmp
            :buf
        )
    }
    covA: ListVal zast.nameid
    clx1009: u64
    for clx1009 < m.clauses.count.u64 loop {
        c3Id: zast.kidAt kids: ast.kids span: m.clauses i: clx1009
        clx1009 = clx1009 + 1
        c3: ast.nodes.get i: c3Id.u64
        if c3.caseclause then {
            cnm: c3.name
            covA.append cnm
        }
    }
    meV: String
    men: (matchElseNarrowing
        :ast
        :symtab
        :ctx
        :m
        vtid: (ztypes.tid.create from: vtid.u64)
        :sname
        :covA
        :mN
        :meV
    )
    meT: men.meT
    meSeed: men.meSeed
    mePrevV: String
    mePrevT: ztypes.tid
    if meSeed then {
        pv: vvGet xs: ctx.narrowBox vid: snameV
        mePrevV = pv
        mePrevT = ztypes.tid.create from: ((vtGet
            xs: ctx.narrowTid
            vid: snameV
        ).or
            d: (ztypes.tid.create from: 0)
        )
        vvSet xs: ctx.narrowBox vid: snameV val: meV.stringView
        vtSet xs: ctx.narrowTid vid: snameV tid: (ztypes.tid.create from: meT.u64)
    }
    mdvg: matchDiverges :symtab nid: m.nodeid.u64
    (emitMatchElse
        :ast
        :symtab
        :ctx
        oId: m.elseclause
        :assignTo
        ind: ind2.stringView
        :tmp
        diverges: mdvg
        :buf
    )
    if meSeed then {
        if mePrevV.length > 0 then {
            vvSet xs: ctx.narrowBox vid: snameV val: mePrevV.stringView
        } else {
            vvRemove xs: ctx.narrowBox vid: snameV
        }
        if mePrevT > 0 then {
            vtSet xs: ctx.narrowTid vid: snameV tid: (ztypes.tid.create from: mePrevT.u64)
        } else {
            vtRemove xs: ctx.narrowTid vid: snameV
        }
    }
    l: "\{ind}}\n"
    buf.append l
}

# emitScalarMatch -- a value match over a scalar subject: a C switch with
# constant arm labels (arm names resolve through the constant pool).
emitScalarMatch: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    m: zast.caserow.view
    subj: StringView
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    l0: "\{ind}switch (\{subj}) {\n"
    buf.append l0
    ind2: "\{ind}    "
    clx1019: u64
    for clx1019 < m.clauses.count.u64 loop {
        cId: zast.kidAt kids: ast.kids span: m.clauses i: clx1019
        clx1019 = clx1019 + 1
        (emitScalarClause
            :ast
            :symtab
            :ctx
            c: (ast.nodes.get i: cId.u64)
            :assignTo
            ind: ind2.stringView
            :tmp
            :buf
        )
    }
    mdvg: matchDiverges :symtab nid: m.nodeid.u64
    (emitMatchElse
        :ast
        :symtab
        :ctx
        oId: m.elseclause
        :assignTo
        ind: ind2.stringView
        :tmp
        diverges: mdvg
        :buf
    )
    l: "\{ind}}\n"
    buf.append l
}

# emitOrdinalPairMatch -- a match over a TWO-ARM ORDINAL sum, emitted as an
# if (subj) / else if (!subj) chain on the subject itself rather than a tag
# switch, with the optional else arm a trailing `else`. The arm whose
# DISCRIMINATOR is 0 takes the negated condition, which is what makes a bool
# subject an instance of this rather than a form of its own. assignTo writes the
# arm value in each branch.
emitOrdinalPairMatch: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    m: zast.caserow.view
    subj: StringView
    tid: ztypes.tid
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    falseArm: ordinalPairFirstArmId :symtab :tid
    firstB: true
    clx1029: u64
    for clx1029 < m.clauses.count.u64 loop {
        cId: zast.kidAt kids: ast.kids span: m.clauses i: clx1029
        clx1029 = clx1029 + 1
        c: ast.nodes.get i: cId.u64
        if c.caseclause then {
            condB: subj.string
            if falseArm > 0 when c.name.u64 == falseArm then condB = "!\{subj}"
            kwB: "if"
            if firstB == false then kwB = "else if"
            firstB = false
            lhB: "\{ind}\{kwB} (\{condB}) {\n"
            buf.append lhB
            indB: "\{ind}    "
            if assignTo.length > 0 then {
                vxB: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: c.statement.u64)
                laB: "\{ind}    \{assignTo} = \{vxB};\n"
                buf.append laB
            } else {
                fLB: tmp.frees.length
                lLB: tmp.listFrees.length
                cstB: ast.nodes.get i: c.statement.u64
                emitBodyNode :ast :symtab :ctx n: cstB ind: indB.stringView :tmp :buf
                dvF: blockDiverges :ast :symtab :ctx n: cstB
                flushBlockFrees :ctx :tmp fL: fLB lL: lLB diverged: dvF :buf
            }
            lcB: "\{ind}}\n"
            buf.append lcB
        }
    }
    bdvg: matchDiverges :symtab nid: m.nodeid.u64
    emitBoolElse :ast :symtab :ctx oId: m.elseclause :assignTo :ind :tmp diverges: bdvg :buf
}

# emitBoolElse -- the trailing `else { ... }` of a bool match (none = nothing).
emitBoolElse: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    oId: zast.nodeid
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    diverges: bool
    buf: String.borrow
} is {
    if oId > 0 then {
        o: ast.nodes.get i: oId.u64
        leB: "\{ind}else {\n"
        buf.append leB
        indE: "\{ind}    "
        if assignTo.length > 0 then {
            veB: emitExpr :ast :symtab :ctx n: o
            laE: "\{ind}    \{assignTo} = \{veB};\n"
            buf.append laE
        } else {
            fLE: tmp.frees.length
            lLE: tmp.listFrees.length
            emitBodyNode :ast :symtab :ctx n: o ind: indE.stringView :tmp :buf
            dvF: blockDiverges :ast :symtab :ctx n: o
            flushBlockFrees :ctx :tmp fL: fLE lL: lLE diverged: dvF :buf
        }
        lceB: "\{ind}}\n"
        buf.append lceB
    } else {
        if diverges then {
            leD: "\{ind}else {\n"
            buf.append leD
            lzD: "\{ind}    z_unreachable();\n"
            buf.append lzD
            lcD: "\{ind}}\n"
            buf.append lcD
        }
    }
}

# scalarArmLabel -- the C case label for a scalar arm: the constant
# pool's rendering when the arm names a constant, else the name itself.
scalarArmLabel: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    arm: StringView
} out String is {
    unitTid92: (unitTidOf :ast :symtab unitName: ctx.mainName.stringView)
    lv: (memberConstText
        :ast
        :symtab
        :ctx
        unitTid: unitTid92
        nameId: (zast.poolFind pool: ast.names text: arm)
    )
    if lv.length > 0 then return lv
    ac: arm.string
    return ac
}

# flushBlockFrees -- emit + reclaim the heap/collection destructors registered
# since (fL, lL) so a local declared inside a block (a match arm) is freed at
# block end, not function end (where it is out of C scope). LIFO order.
flushBlockFrees: function {
    ctx: Ctx.view
    tmp: TmpCtr
    fL: u64
    lL: u64
    diverged: bool
    buf: String.borrow
} is {
    # a block that diverges on every path already freed these -- through
    # emitReturnCleanup on a return, emitBreakFrees on a break -- so pop them
    # (the locals leave C scope either way) but emit nothing, or the frees land
    # after the diverging statement as unreachable code
    live: diverged == false
    for tmp.listFrees.length > lL loop {
        lvo: tmp.listFrees.pop
        if live then buf.append lvo.stmt
    }
    for tmp.frees.length > fL loop {
        fvo: tmp.frees.pop
        if live then {
            ff: "    \{ctx.strC}_free(&\{fvo.name});\n"
            buf.append ff
        }
    }
}

# emitBreakFrees -- free the loop-body owned locals (everything bound since the
# innermost loop entry) before a `break`/`continue`, which skips the loop body's
# end-of-block flushBlockFrees. Non-destructive (reads by index, no pop): the
# normal fall-through still flushes them at block close. Mirrors flushBlockFrees
# order (listFrees newest-first, then frees).
emitBreakFrees: function {ctx: Ctx.view tmp: TmpCtr.view ind: StringView buf: String.borrow} is {
    if ctx.breakFreesMarks.length == 0 then return
    fMark: ctx.breakFreesMarks.get i: (ctx.breakFreesMarks.length - 1)
    lMark: ctx.breakListMarks.get i: (ctx.breakListMarks.length - 1)
    i: tmp.listFrees.length
    for i > lMark loop {
        i = i - 1
        st: tmp.listFrees.get :i
        buf.append st.stmt
    }
    j: tmp.frees.length
    for j > fMark loop {
        j = j - 1
        nm: tmp.frees.get i: j
        ff0: "\{ind}\{ctx.strC}_free(&\{nm.name});\n"
        buf.append ff0
    }
}

# emitContinueFrees -- free the owned locals bound since the mark-stack entry
# at `idx` (the targeted LOOP's entry) before a continue that jumps out of a
# do-block wrapper. Non-destructive, mirroring emitBreakFrees.
emitContinueFrees: function {
    ctx: Ctx.view
    tmp: TmpCtr.view
    idx: u64
    ind: StringView
    buf: String.borrow
} is {
    fMark: ctx.breakFreesMarks.get i: idx
    lMark: ctx.breakListMarks.get i: idx
    i: tmp.listFrees.length
    for i > lMark loop {
        i = i - 1
        st: tmp.listFrees.get :i
        buf.append st.stmt
    }
    j: tmp.frees.length
    for j > fMark loop {
        j = j - 1
        nm: tmp.frees.get i: j
        ff0: "\{ind}\{ctx.strC}_free(&\{nm.name});\n"
        buf.append ff0
    }
}

# emit one arm of a match over a scalar subject.
emitScalarClause: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    c: astnode.view
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    if c.caseclause then {
        armC: zast.nameTextAt :ast ref: c.name
        arm: armC.stringView
        lbl: scalarArmLabel :ast :symtab :ctx :arm
        l2: "\{ind}case \{lbl}: {\n"
        buf.append l2
        ind3: "\{ind}    "
        dv: false
        if assignTo.length > 0 then {
            vx: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: c.statement.u64)
            la: "\{ind}    \{assignTo} = \{vx};\n"
            buf.append la
        } else {
            fL: tmp.frees.length
            lL: tmp.listFrees.length
            cst: ast.nodes.get i: c.statement.u64
            emitBodyNode :ast :symtab :ctx n: cst ind: ind3.stringView :tmp :buf
            dv = blockDiverges :ast :symtab :ctx n: cst
            flushBlockFrees :ctx :tmp :fL :lL diverged: dv :buf
        }
        if dv == false then {
            l5: "\{ind}    break;\n"
            buf.append l5
        }
        l6: "\{ind}}\n"
        buf.append l6
    }
}

# emit one arm of a match over a tagged sum.
emitMatchClause: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    c: astnode.view
    vtid: ztypes.tid
    isUni: bool
    mN: u64
    sname: StringView
    snameVid: ztypes.vid
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    if c.caseclause then {
        armC: zast.nameTextAt :ast ref: c.name
        arm: armC.stringView
        tg: variantTag :symtab tid: (ztypes.tid.create from: vtid.u64) :arm
        l2: "\{ind}case \{tg}: {\n"
        buf.append l2
        pc: armPayloadC :ast :symtab :ctx tid: (ztypes.tid.create from: vtid.u64) :arm
        ind3: "\{ind}    "
        didSeed: false
        unptr: false
        if pc.length > 0 when sname.length > 0 then {
            if isUni then {
                cmt: "\{ind}    /* alias: \{sname} => (*(\{pc}*)_m\{mN}.data) */\n"
                buf.append cmt
                nbv: "(*(\{pc}*)_m\{mN}.data)"
                vvSet xs: ctx.narrowBox vid: snameVid val: nbv.stringView
                co: symtab.typing.declChildOf pool: ast.names parentTypeId: vtid name: arm
                match (
                    co
                ) case some then {
                    vtSet xs: ctx.narrowTid vid: snameVid tid: (ztypes.tid.create from: co.u64)
                } case none then null
                didSeed = true
            } else {
                snE: varCName :ctx vid: snameVid name: sname
                armMP: memberCPrefix name: arm
                l3: "\{ind}    \{pc} \{snE} = _m\{mN}.data.\{armMP}\{arm};\n"
                buf.append l3
                l4: "\{ind}    (void)\{snE};\n"
                buf.append l4
                # a subject that arrives by pointer (a method's `this`) is
                # shadowed by a VALUE here, so the arm must read it as one
                if (isPtrVid :ctx vid: snameVid) then {
                    dropPtrVid :ctx vid: snameVid
                    unptr = true
                }
            }
        }
        dv: false
        if assignTo.length > 0 then {
            vx: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: c.statement.u64)
            la: "\{ind}    \{assignTo} = \{vx};\n"
            buf.append la
        } else {
            fL: tmp.frees.length
            lL: tmp.listFrees.length
            cst: ast.nodes.get i: c.statement.u64
            emitBodyNode :ast :symtab :ctx n: cst ind: ind3.stringView :tmp :buf
            dv = blockDiverges :ast :symtab :ctx n: cst
            flushBlockFrees :ctx :tmp :fL :lL diverged: dv :buf
        }
        if didSeed then {
            vvRemove xs: ctx.narrowBox vid: snameVid
            vtRemove xs: ctx.narrowTid vid: snameVid
        }
        if unptr then ctx.ptrVids.append from: snameVid
        if dv == false then {
            l5: "\{ind}    break;\n"
            buf.append l5
        }
        l6: "\{ind}}\n"
        buf.append l6
    }
}

# emit a match's else arm.
emitMatchElse: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    oId: zast.nodeid
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    diverges: bool
    buf: String.borrow
} is {
    if oId > 0 then {
        o: ast.nodes.get i: oId.u64
        l7: "\{ind}default: {\n"
        buf.append l7
        ind3: "\{ind}    "
        dv8: false
        if assignTo.length > 0 then {
            vx8: emitExpr :ast :symtab :ctx n: o
            la8: "\{ind}    \{assignTo} = \{vx8};\n"
            buf.append la8
        } else {
            fLe: tmp.frees.length
            lLe: tmp.listFrees.length
            emitBodyNode :ast :symtab :ctx n: o ind: ind3.stringView :tmp :buf
            dv8 = blockDiverges :ast :symtab :ctx n: o
            flushBlockFrees :ctx :tmp fL: fLe lL: lLe diverged: dv8 :buf
        }
        if dv8 == false then {
            l8: "\{ind}    break;\n"
            buf.append l8
        }
        l: "\{ind}}\n"
        buf.append l
    } else {
        if diverges then {
            ld0: "\{ind}default: z_unreachable();\n"
            buf.append ld0
        } else {
            ld1: "\{ind}default: break;\n"
            buf.append ld1
        }
    }
}

# emitOptionalAssign -- the some-arm assignment for a break-carrying do value:
# inline for a valtype optionval (payC ""), a malloc'd box for a reftype
# Option payload.
emitOptionalAssign: function {
    target: StringView
    someTag: StringView
    payC: StringView
    vx: StringView
    ind: StringView
    buf: String.borrow
} is {
    if payC.length > 0 then {
        lb: "\{ind}\{target}.tag = \{someTag};\n\{ind}{ \{payC}* _zb = (\{payC}*)z_xmalloc(sizeof(\{payC})); *_zb = \{vx}; \{target}.data = _zb; }\n"
        buf.append lb
    } else {
        la: "\{ind}\{target}.tag = \{someTag};\n\{ind}\{target}.data.some = \{vx};\n"
        buf.append la
    }
}

# emitBranchAssignOptional -- emit a do-block-with-break body, wrapping the final
# value in the optional's `some` arm (tag + data.some); a `break` reached first
# leaves the result at its pre-set `none` tag.
emitBranchAssignOptional: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: astnode.view
    target: StringView
    someTag: StringView
    payC: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    match (
        n
    ) case statement then {
        cnt: n.statements.count.u64
        si: u64
        for si < cnt loop {
            sxId: zast.kidAt kids: ast.kids span: n.statements i: si
            sx: ast.nodes.get i: sxId.u64
            if si + 1 == cnt then {
                vx: emitExpr :ast :symtab :ctx n: sx
                emitOptionalAssign :target :someTag :payC vx: vx.stringView :ind :buf
                emitValueTakeInvalidations :ast :symtab :ctx n: sx :ind :buf
            } else {
                emitStmt :ast :symtab :ctx n: sx :ind :tmp :buf
                # a diverging statement -- typically an `if` the emitter folded
                # to an unconditional break -- ends the block, so the value
                # assignment below it can never run. The optional stays none,
                # which is what the break path yields anyway.
                if (stmtDiverges
                    :ast
                    :symtab
                    :ctx
                    sid: (zast.nodeid.create from: sxId.u64)
                ) then si = cnt
            }
            si = si + 1
        }
    } else {
        vx2: emitExpr :ast :symtab :ctx :n
        emitOptionalAssign :target :someTag :payC vx: vx2.stringView :ind :buf
        emitValueTakeInvalidations :ast :symtab :ctx :n :ind :buf
    }
}

# emitDoBindValue -- `x: { ... }` (a do block): declare the local and emit the
# block. A do block whose own body breaks yields an optionval (default `none`,
# `some(last)` on normal completion, in a do/while(0) so a break exits to none);
# a breakless do block is a plain scoped block assigning the last value.
emitDoBindValue: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: astnode.view
    nm: StringView
    nmVid: ztypes.vid
    ct: StringView
    tid: ztypes.tid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    match (
        n
    ) case expression then {
        iexK: ast.nodes.get i: n.expression.u64
        return (emitDoBindValue :ast :symtab :ctx n: iexK :nm :nmVid :ct :tid :ind :tmp :buf)
    } case doexpr then {
        ld: "\{ind}\{ct} \{nm};\n"
        buf.append ld
        if (ztypecheck.blockHasBreak :ast n: (ast.nodes.get i: n.statement.u64)) then {
            noneTag: variantTag :symtab :tid arm: "none"
            someTag: variantTag :symtab :tid arm: "some"
            # a reftype value wraps in Option: the payload lives in a
            # malloc'd box, none carries NULL data, and the local owns the
            # box (scope-exit destroy).
            boxedC: String
            if (originIsTid :symtab :tid originTid: (ctx.origins.get i: ogOption)) then {
                boxedC = armPayloadC :ast :symtab :ctx :tid arm: "some"
            }
            l0: "\{ind}\{nm}.tag = \{noneTag};\n"
            buf.append l0
            if boxedC.length > 0 then {
                l0b: "\{ind}\{nm}.data = NULL;\n"
                buf.append l0b
                dcb: ctxCname :ctx :tid
                ldf: "    \{dcb}_destroy(&\{nm});\n"
                tmp.oweList stmt: ldf.copy name: nm.string vid: nmVid
            }
            l1: "\{ind}do {\n"
            buf.append l1
            ind2: "\{ind}    "
            # the block is its own break target: a break inside frees the
            # block's owned temps (since these marks) and lands after the
            # block, not on an enclosing loop's label
            doId: pushLoopLabel :ctx :tmp isDo: true
            fLd: tmp.frees.length
            lLd: tmp.listFrees.length
            (emitBranchAssignOptional
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: n.statement.u64)
                target: nm
                someTag: someTag.stringView
                payC: boxedC.stringView
                ind: ind2.stringView
                :tmp
                :buf
            )
            dvO: blockDiverges :ast :symtab :ctx n: (ast.nodes.get i: n.statement.u64)
            flushBlockFrees :ctx :tmp fL: fLd lL: lLd diverged: dvO :buf
            l2: "\{ind}} while (0);\n"
            buf.append l2
            popLoopLabel :ctx id: doId :ind :buf
        } else {
            # an owned destructible block value is destroyed at scope exit
            # (the binding path returns before its own registration).
            if (symtab.reg.needsDestructor typeId: tid) then {
                pdcb: ctxCname :ctx :tid
                pldf: "    \{pdcb}_destroy(&\{nm});\n"
                tmp.oweList stmt: pldf.copy name: nm.string vid: nmVid
            }
            l3: "\{ind}{\n"
            buf.append l3
            ind3: "\{ind}    "
            fLe: tmp.frees.length
            lLe: tmp.listFrees.length
            (emitBranchAssign
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: n.statement.u64)
                target: nm
                ind: ind3.stringView
                :tmp
                :buf
            )
            flushBlockFrees :ctx :tmp fL: fLe lL: lLe diverged: false :buf
            l4: "\{ind}}\n"
            buf.append l4
        }
        return true
    } else {
        return false
    }
}

# emitMatchBindValue -- `x: (match c case ok then 1 ...)`: declare the
# local and assign per arm; false when the value is not a match.
emitMatchBindValue: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: astnode.view
    nm: StringView
    ct: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    match (
        n
    ) case expression then {
        iexJ: ast.nodes.get i: n.expression.u64
        return (emitMatchBindValue :ast :symtab :ctx n: iexJ :nm :ct :ind :tmp :buf)
    } case caseexpr then {
        ld: "\{ind}\{ct} \{nm};\n"
        buf.append ld
        emitMatchStmt :ast :symtab :ctx m: n assignTo: nm :ind :tmp :buf
        return true
    } else {
        return false
    }
}

# isSimpleValueNode -- the node is a value expression, not a multi-statement
# block. A folded if-bind can only shortcut to emitExpr when its live branch is
# one; a block branch stays on the clause path, which knows how to assign from
# a body.
isSimpleValueNode: function {ast: Ast.view n: astnode.view} out bool is {
    ast
    match (
        n
    ) case statement then {
        # emitExpr copes with a one-statement block; a longer body needs the
        # clause path, which assigns from a walked body
        return n.statements.count.u64 <= 1
    } else {
        return true
    }
}

# emitIfBindValue -- `s: if c then a else b`: declare the local and emit
# an if-statement assigning the branch value to it; false otherwise.
emitIfBindValue: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: astnode.view
    nm: StringView
    ct: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    match (
        n
    ) case expression then {
        iexI: ast.nodes.get i: n.expression.u64
        return (emitIfBindValue :ast :symtab :ctx n: iexI :nm :ct :ind :tmp :buf)
    } case ifexpr then {
        # every condition folds: declare the local and assign the one live
        # branch, rather than emitting a runtime if whose other arms are dead
        bfb: foldedBranchOf :symtab nid: n.nodeid.u64
        if bfb.known then {
            bwb: bfb.stmt
            if bwb.isZero == false then {
                bwn: ast.nodes.get i: bwb.u64
                if (isSimpleValueNode :ast n: bwn) then {
                    bvx: emitExpr :ast :symtab :ctx n: bwn
                    lbf: "\{ind}\{ct} \{nm} = \{bvx};\n"
                    buf.append lbf
                    return true
                }
                # a multi-statement live branch: declare, then run the body
                # through the same assign helper the clause path uses, inside a
                # bare block rather than under a runtime `if`
                lbd: "\{ind}\{ct} \{nm};\n"
                buf.append lbd
                lbo: "\{ind}{\n"
                buf.append lbo
                indB: "\{ind}    "
                (emitBranchAssign
                    :ast
                    :symtab
                    :ctx
                    n: bwn
                    target: nm
                    ind: indB.stringView
                    :tmp
                    :buf
                )
                lbc: "\{ind}}\n"
                buf.append lbc
                return true
            }
        }
        ld: "\{ind}\{ct} \{nm};\n"
        buf.append ld
        first: true
        clx1039: u64
        for clx1039 < n.clauses.count.u64 loop {
            cId: zast.kidAt kids: ast.kids span: n.clauses i: clx1039
            clx1039 = clx1039 + 1
            isFirst: first
            first = false
            (emitIfClause
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: cId.u64)
                :isFirst
                assignTo: nm
                :ind
                :tmp
                :buf
            )
        }
        chS: List String
        chV: ListVal ztypes.vid
        chA: List String
        chT: ListVal u64
        chN: ListVal bool
        chR: List String
        (chainFactsOfClauses
            :ast
            :symtab
            :ctx
            clauses: n.clauses
            subjects: chS
            svids: chV
            arms: chA
            tids: chT
            negs: chN
            recvs: chR
        )
        (emitElse
            :ast
            :symtab
            :ctx
            oId: n.elseclause
            assignTo: nm
            :ind
            :tmp
            chSubjects: chS
            chSubjectVids: chV
            chArms: chA
            chTids: chT
            chNegs: chN
            chRecvs: chR
            :buf
        )
        le: "\{ind}}\n"
        buf.append le
        return true
    } else {
        return false
    }
}

# iterableNodeId -- the stamped node id of a for-loop iterable: peel expression
# wrappers, then take the inner atom / dotted-field / call node (the expression
# wrapper itself may be unstamped for a `this._iterN` field iterator).
iterableNodeId: function {ast: Ast.view n: astnode.view} out u64 is {
    match (
        n
    ) case expression then {
        return (iterableNodeId :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return n.nodeid.u64
    } case dottedpath then {
        return n.nodeid.u64
    } case call then {
        return n.nodeid.u64
    } else {
        return 0
    }
}

# isForIterCall -- the for-loop iterable is a call expression (an rvalue that
# must be hoisted to a temp before `&recv`); a bare atom / dotted field is an
# lvalue used directly.
isForIterCall: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case expression then {
        return (isForIterCall :ast n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        return true
    } case dottedpath then {
        cn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if cn.stringView == "iterateMut" then return true
        return cn.stringView == "iterate"
    } else {
        return false
    }
}

# objitertids -- what the iterable resolves to: the iterator class, and the
# generator function to call for it when the iterable was a bare fn name.
# A zero itid means the iterable names no iterator at all.
objitertids: record {
    # the iterator's type
    itid: ztypes.tid
    # the bare `.call` function behind it
    bareFnId: ztypes.tid
}

# objIterIterableTid -- the iterator class behind `for x: <iterable> loop`. A
# bare generator fn resolves through its return type and is auto-called; every
# other iterable resolves through its canonical origin, so a shadowed or
# re-exported name still finds the template that declares `.call`.
objIterIterableTid: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    cOp: zast.nodeid
} out objitertids is {
    oeid: iterableNodeId :ast n: (ast.nodes.get i: cOp.u64)
    itid0: stampIdOf :symtab nid: oeid
    if itid0.isZero then {
        oeidF: exprNodeId n: (ast.nodes.get i: cOp.u64)
        itid0 = stampIdOf :symtab nid: oeidF
    }
    itid: itid0
    # bare generator-fn iterable (`for x: counter loop`): itid0 is the
    # generator function itself; resolve via its return type (the iterator
    # class) and auto-call it below.
    bareFnId: ztypes.tid
    if (symtab.reg.typetypeOf typeId: itid0) == ztypes.ztypetype.functionType then {
        brt: u64
        brt = fnReturnTidOf :symtab tid: itid0
        if brt == 0 then {
            mro: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: itid0.u64)
            match (
                mro
            ) case some then {
                brt = mro
            } case none then null
        }
        hasCall: (symtab.typing.declHasMemberId
            parentTypeId: (ztypes.tid.create from: brt.u64)
            nameId: zast.names.wkCall
        )
        if brt > 0 when hasCall then {
            itid = ztypes.tid.create from: brt
            bareFnId = itid0
        }
    }
    if itid.isZero then return (objitertids :itid :bareFnId)
    if bareFnId.isZero then {
        canoT: u64
        if (originTidOf :symtab tid: itid0) > 0 then {
            canoT = itid0
        } else {
            itn0: regNameOf :symtab tid: itid0
            cano: (ztypecheck.walkLookupTyperefRo
                frame: ztypes.declid
                :ast
                st: symtab
                unitDecl: ctx.mainUnitId
                base: itn0.stringView
            )
            match (
                cano
            ) case some then {
                canoT = cano
            } case none then null
        }
        hasCallC: (symtab.typing.declHasMemberId
            parentTypeId: (ztypes.tid.create from: canoT.u64)
            nameId: zast.names.wkCall
        )
        if canoT > 0 when hasCallC then itid = ztypes.tid.create from: canoT.u64
    }
    return (objitertids :itid :bareFnId)
}

# objIterYieldTid -- the type the iterator YIELDS. The registry knows it for a
# native iterator; a user-class one leaves returnTypeId unset and carries the
# stamp on the `.call` return node instead. Zero when neither names one.
objIterYieldTid: function {
    symtab: zenv.ZSymbolTable.view
    cco: ztypes.tid
} out ztypes.tid is {
    ovid: ztypes.tid
    {
        rto: symtab.reg.returnTypeOf tid: (ztypes.tid.create from: cco.u64)
        if rto > 0 then ovid = rto
    }
    if ovid.isZero then {
        # user-class iterator: returnTypeId unset, but the .call return
        # node carries the mono stamp.
        mro: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: cco.u64)
        match (
            mro
        ) case some then {
            ovid = mro
        } case none then null
    }
    return ovid
}

# objIterCallC -- the C name of the iterator's `.call`. A main-unit user-class
# iterator is emitted by emitOneMethod under its own cname id; native and
# collection iterators keep the template's `{type}_call`.
objIterCallC: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    cco: ztypes.tid
    itid: ztypes.tid
} out String is {
    itn: regNameOf :symtab tid: itid
    # a main-unit user-class iterator's .call is emitted by emitOneMethod
    # (its own cname id); native/collection iterators (CpIter, SetIter,
    # emitted with the type-id cname) keep the template's `{type}_call`.
    callC: String
    itUfn: canonFnId :ast :symtab :ctx tid: itid name: itn.stringView
    isUserCls: false
    if itUfn > 0 when (symtab.reg.typetypeOf typeId: itid) == ztypes.ztypetype.classType then {
        # exclude collection monos (SetIter etc., which have a generic origin)
        itorig: originTidOf :symtab tid: itid
        if itorig.isZero then isUserCls = true
    }
    if isUserCls then {
        callC = ctxCname :ctx tid: (ztypes.tid.create from: cco.u64)
    } else {
        itc: ctxCname :ctx tid: itid
        callC = "\{itc}_call"
    }
    return callC
}

# emitObjIterRecv -- the iterator instance the loop calls into. A bare generator
# fn and an explicit `.iterate` call both produce a temporary the loop OWNS, so
# its destroy is registered for the enclosing block BEFORE the loop label --
# break and continue inside the loop must not free the live instance.
emitObjIterRecv: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    cOp: zast.nodeid
    itid: ztypes.tid
    bareFnId: ztypes.tid
    itCb: StringView
    mN: u64
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out String is {
    iterRecv: String
    ownGit: false
    if bareFnId > 0 then {
        bcn: ctxCname :ctx tid: (ztypes.tid.create from: bareFnId.u64)
        lgh: "\{ind}\{itCb}_t _git\{mN} = \{bcn}();\n"
        buf.append lgh
        iterRecv = "_git\{mN}"
        ownGit = true
    } else {
        ivex: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: cOp.u64)
        # A construction written as a bare TYPE NAME is an atom in the AST and a
        # call in the emitted C: the shape test reads `Counter` as an lvalue,
        # while what it becomes is `<T>_create(...)`, and the loop then asks for
        # `&` of it. The TEXT settles it -- anything an address cannot be taken
        # of is hoisted to the same owned temp a call already gets.
        hoistIt: isForIterCall :ast n: (ast.nodes.get i: cOp.u64)
        if hoistIt == false then hoistIt = isNonLvalueArg s: ivex.stringView
        if hoistIt then {
            lgi: "\{ind}\{itCb}_t _git\{mN} = \{ivex};\n"
            buf.append lgi
            iterRecv = "_git\{mN}"
            ownGit = true
        } else {
            iterRecv = ivex
        }
    }
    # An ownership-moved argument must be zeroed in the CALLER, exactly as a
    # binding-position call does it. This position skipped that, so
    # `for r: (g s: src) loop` with a `.take` param left `src` live: the
    # enclosing scope freed it and the iterator's destructor freed it again --
    # `free(): double free detected`. A non-call iterable reduces to a no-op.
    emitValueTakeInvalidations :ast :symtab :ctx n: (ast.nodes.get i: cOp.u64) :ind :buf
    # the loop owns the iterator instance: register its destroy for the
    # enclosing block's flush (and the return path), freeing owned
    # captured params. Registered BEFORE the loop label so break /
    # continue inside the loop never free the live instance.
    if ownGit then {
        # gated on structDestroyNontrivial ALONE: the destructor is now emitted
        # for anything it answers true for, and the stamped flag misses a synth
        # iterator whose only owned field is a promoted local
        if (structDestroyNontrivial :symtab :ctx tid: itid) then {
            gdt: "    \{itCb}_destroy(&_git\{mN});\n"
            gdn: "_git\{mN}"
            tmp.oweList stmt: gdt name: gdn vid: (ztypes.vid.create from: 0)
        }
    }
    return iterRecv
}

# emitObjIterPayload -- binding the yielded payload to the loop variable, in the
# three shapes a yield takes: a borrowed view (scalars copy, aggregates alias),
# an owned heap box (move the payload out, free the box), and a plain value.
emitObjIterPayload: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    ovid: ztypes.tid
    ovn: String
    oovorig: StringView
    payC: StringView
    lbl: StringView
    lblV: ztypes.vid
    mN: u64
    ind: StringView
    buf: String.borrow
} is {
    if (originIsTid
        :symtab
        tid: (ztypes.tid.create from: ovid.u64)
        originTid: (ctx.origins.get i: ogOptionView)
    ) then {
        # borrowed-view yield: scalar payloads copy by value; aggregate
        # payloads bind a borrowed pointer (no copy -> the shared fields
        # are never double-freed).
        payElemPfx: oovorig.length + 1
        payElemName: monoElemName full: ovn prefixLen: payElemPfx
        payElemTid: ((symtab.typing.declChildOfId
            parentTypeId: ovid
            nameId: zast.names.wkSome
        ).or
            d: 0
        )
        payScalarC: (cTypeForNameTid
            :ast
            :symtab
            :ctx
            name: payElemName.stringView
            tid: (ztypes.tid.create from: payElemTid.u64)
        )
        # A REFTYPE payload must alias. Copying its struct duplicates
        # a pointer the container still owns, so a write through the
        # copy reallocs and frees under the container -- silently for a
        # valtype field, as a use-after-free for a reftype one. A
        # valtype or scalar payload is self-contained and copies safely.
        payRef: false
        if payElemTid > 0 then payRef = (symtab.reg.isReftypeOf
            tid: (ztypes.tid.create from: payElemTid.u64)
        )
        if payScalarC.length > 0 when payRef == false then {
            l3v: "\{ind}    \{payC} \{lbl} = *(\{payC}*)_iter\{mN}.data;\n"
            buf.append l3v
        } else {
            l3p: "\{ind}    \{payC}* __borrow_\{lbl} = (\{payC}*)_iter\{mN}.data;\n"
            buf.append l3p
            l3pa: "\{ind}    /* alias: \{lbl} => (*__borrow_\{lbl}) */\n"
            buf.append l3pa
            av3p: "(*__borrow_\{lbl})"
            vvSet xs: ctx.aliases vid: lblV val: av3p.stringView
        }
    } else if (originIsTid
        :symtab
        tid: (ztypes.tid.create from: ovid.u64)
        originTid: (ctx.origins.get i: ogOption)
    ) then {
        # owned heap yield: move the payload out, free just the box; the
        # loop var owns it and is freed at the end of each iteration.
        l3op: "\{ind}    \{payC} \{lbl} = *(\{payC}*)_iter\{mN}.data;\n"
        buf.append l3op
        l3of: "\{ind}    free(_iter\{mN}.data);\n"
        buf.append l3of
    } else {
        l3: "\{ind}    \{payC} \{lbl} = _iter\{mN}.data.some;\n"
        buf.append l3
    }
}

# objIterPayCleanup -- an owned payload needs a per-iteration destroy. The
# fall-through copy is emitted at the end of the loop body; continue, break and
# return jump PAST that line, so the jump sites need their own copy -- which is
# what the break-label cleanup slot carries. Returns the line, "" when the yield
# owns nothing.
objIterPayCleanup: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    ovid: ztypes.tid
    lbl: StringView
    lblV: ztypes.vid
} out String is {
    payCleanup: String
    if (originIsTid
        :symtab
        tid: (ztypes.tid.create from: ovid.u64)
        originTid: (ctx.origins.get i: ogOption)
    ) then {
        pfree: (payloadDestructor
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: ovid.u64)
            arm: "some"
        )
        if pfree.length > 0 then payCleanup = "\{pfree}(&\{lbl});\n"
    }
    if payCleanup.length > 0 then {
        ctx.breakLabelCleanup.pop
        pcl: payCleanup.copy
        ctx.breakLabelCleanup.append pcl
        ctx.breakLabelCleanupVar.pop
        ctx.breakLabelCleanupRaw.pop
        pcv: lbl.string
        ctx.breakLabelCleanupVar.append pcv
        ctx.breakLabelCleanupRaw.append lblV
    }
    return payCleanup
}

# emitObjIterLoop -- the `while (1) { T _iter = C_call(&recv); ... }` an object
# iterator becomes: the yield type, the receiver, its destroy registration, the
# per-iteration payload bind, the body, and the loop labels.
emitObjIterLoop: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    m: zast.forrow.view
    cOp: zast.nodeid
    cco: ztypes.tid
    itid: ztypes.tid
    bareFnId: ztypes.tid
    lbl: StringView
    lblV: ztypes.vid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    ovid: objIterYieldTid :symtab :cco
    # neither the registered return nor the .call stamp names a yield
    # type: there is no iterator to emit against.
    if ovid.isZero then return false
    callC: objIterCallC :ast :symtab :ctx :cco :itid
    ovn: regNameOf :symtab tid: (ztypes.tid.create from: ovid.u64)
    ovc: ctxCname :ctx tid: (ztypes.tid.create from: ovid.u64)
    ovu: cUpperOf text: ovn.stringView
    payC: armPayloadC :ast :symtab :ctx tid: (ztypes.tid.create from: ovid.u64) arm: "some"
    oovorig: monoOriginName :symtab tid: (ztypes.tid.create from: ovid.u64)
    mN: tmp.next
    itCb: ctxCname :ctx tid: itid
    iterRecv: (emitObjIterRecv
        :ast
        :symtab
        :ctx
        :cOp
        :itid
        :bareFnId
        itCb: itCb.stringView
        :mN
        :ind
        :tmp
        :buf
    )
    lidO: pushLoopLabel :ctx :tmp isDo: false
    payCleanup: objIterPayCleanup :ast :symtab :ctx :ovid :lbl :lblV
    l0: "\{ind}while (1) {\n"
    buf.append l0
    l1: "\{ind}    \{ovc}_t _iter\{mN} = \{callC}(&\{iterRecv});\n"
    buf.append l1
    if (originIsTid
        :symtab
        tid: (ztypes.tid.create from: ovid.u64)
        originTid: (ctx.origins.get i: ogOption)
    ) then {
        # owned heap-payload union: destroy the box on the NONE arm too.
        l2o: "\{ind}    if (_iter\{mN}.tag == Z_\{ovu}_TAG_NONE) { \{ovc}_destroy(&_iter\{mN}); break; }\n"
        buf.append l2o
    } else {
        l2: "\{ind}    if (_iter\{mN}.tag == Z_\{ovu}_TAG_NONE) break;\n"
        buf.append l2
    }
    (emitObjIterPayload
        :ast
        :symtab
        :ctx
        :ovid
        :ovn
        oovorig: oovorig.stringView
        payC: payC.stringView
        :lbl
        :lblV
        :mN
        :ind
        :buf
    )
    ind2: "\{ind}    "
    fLO: tmp.frees.length
    lLO: tmp.listFrees.length
    dvG: false
    if m.body > 0 then {
        mb: ast.nodes.get i: m.body.u64
        emitBodyNode :ast :symtab :ctx n: mb ind: ind2.stringView :tmp :buf
        dvG = blockDiverges :ast :symtab :ctx n: mb
    }
    if payCleanup.length > 0 then {
        l3od: "\{ind}    \{payCleanup}"
        buf.append l3od
    }
    flushBlockFrees :ctx :tmp fL: fLO lL: lLO diverged: dvG :buf
    indO: "\{ind}    "
    emitContLabel :ctx id: lidO ind: indO.stringView :buf
    l: "\{ind}}\n"
    buf.append l
    popLoopLabel :ctx id: lidO :ind :buf
    return true
}

# objIterForNamed -- the single `name: iterable` condition of an object-iterator
# for-loop. False when the iterable resolves to no iterator, so the caller can
# try the other for-loop shapes.
objIterForNamed: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    m: zast.forrow.view
    cName: zast.nameid
    cOp: zast.nodeid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    lblR: zast.nameTextAt :ast ref: cName
    if lblR.length == 0 then return false
    lblV: defVid :symtab nid: (interpPartNodeId n: (ast.nodes.get i: cOp.u64))
    lbl: varCName :ctx vid: lblV name: lblR.stringView
    tids: objIterIterableTid :ast :symtab :ctx :cOp
    if tids.itid.isZero then return false
    itid: tids.itid
    bareFnId: tids.bareFnId
    cco: symtab.typing.declChildOfId parentTypeId: itid nameId: zast.names.wkCall
    match (
        cco
    ) case some then {
        return (emitObjIterLoop
            :ast
            :symtab
            :ctx
            :m
            :cOp
            cco: (ztypes.tid.create from: cco.u64)
            :itid
            :bareFnId
            lbl: lbl.stringView
            :lblV
            :ind
            :tmp
            :buf
        )
    } case none then {
        return false
    }
}


# emitObjIterFor -- `for x: <iter> loop` where <iter> is an iterator value
# (a type with a `.call` child returning optionval/Option). Emits the
# while(1) / call / tag==NONE break / payload-extract pattern. Value
# payloads (optionval) extract `.data.some`; reftype payloads (Option)
# wait on the heap-extract slice. Returns false when not an iterator loop.
emitObjIterFor: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    m: zast.forrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    if m.conditions.count.u64 != 1 then return false
    c0Id: zast.kidAt kids: ast.kids span: m.conditions i: 0
    c0: ast.nodes.get i: c0Id.u64
    match (
        c0
    ) case namedoperation then {
        return (objIterForNamed
            :ast
            :symtab
            :ctx
            :m
            cName: c0.name
            cOp: c0.operation
            :ind
            :tmp
            :buf
        )
    } else {
        return false
    }
}

# emitIntRangeFor -- `for x: N.iterate loop` / `for x: (N.iterate from: F)`:
# a counted C for-loop `for (T x = F; x < N; x++)`. Returns false when the
# header is not a single integer-range binding.
emitIntRangeFor: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    m: zast.forrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    if m.conditions.count.u64 != 1 then return false
    c0Id: zast.kidAt kids: ast.kids span: m.conditions i: 0
    c0: ast.nodes.get i: c0Id.u64
    match (
        c0
    ) case namedoperation then {
        lblR8: zast.nameTextAt :ast ref: c0.name
        if lblR8.length == 0 then return false
        lblV8: defVid :symtab nid: (interpPartNodeId n: (ast.nodes.get i: c0.operation.u64))
        lbl: varCName :ctx vid: lblV8 name: lblR8.stringView
        bound: rangeBoundExpr :ast :symtab :ctx n: (ast.nodes.get i: c0.operation.u64)
        if bound.length == 0 then return false
        fromx: rangeFromExpr :ast :symtab :ctx n: (ast.nodes.get i: c0.operation.u64)
        lidR: pushLoopLabel :ctx :tmp isDo: false
        # A suspension inside the body RETURNS from `.call`, and the resume
        # `goto` lands inside the loop, PAST the C for-init -- so the counter,
        # which lives only in the header, is indeterminate on the next call and
        # the loop yields once and reports itself exhausted. It cannot be
        # promoted the way a local is: a `for` label is a nameid on the header's
        # namedoperation, so crossWalk never records it and it carries no
        # variable id to alias a field to either. Instead the counter keeps its
        # C local -- so the header, `continue` and the increment are all
        # untouched -- and is SPILLED to a state field across each suspension.
        pushed: false
        if ctx.genActive when (zast.yieldCountIn :ast nid: m.body) > 0 then {
            ctx.genForNext = ctx.genForNext + 1
            (ctx.genForSpills.append (ForSpill
                slot: ctx.genForNext
                cname: lbl.copy
            )
            )
            pushed = true
        }
        lh: "\{ind}for (int64_t \{lbl} = \{fromx}; \{lbl} < (int64_t)(\{bound}); \{lbl}++) {\n"
        buf.append lh
        ind2: "\{ind}    "
        # the body is a BLOCK: whatever it registers -- an argument hoisted to an
        # `_ah` temp, an owned local -- is declared per iteration and has to be
        # freed per iteration. Without the mark those frees stayed pending and
        # landed after the loop, naming a temp that had left C scope.
        fLR: tmp.frees.length
        lLR: tmp.listFrees.length
        dvR: false
        if m.body > 0 then {
            bodyNode: ast.nodes.get i: m.body.u64
            emitBodyNode :ast :symtab :ctx n: bodyNode ind: ind2.stringView :tmp :buf
            dvR = blockDiverges :ast :symtab :ctx n: bodyNode
        }
        flushBlockFrees :ctx :tmp fL: fLR lL: lLR diverged: dvR :buf
        emitContLabel :ctx id: lidR ind: ind2.stringView :buf
        lc: "\{ind}}\n"
        buf.append lc
        popLoopLabel :ctx id: lidR :ind :buf
        # the counter leaves C scope with the loop, so a suspension after it
        # must not spill it
        if pushed then ctx.genForSpills.pop
        return true
    } else {
        return false
    }
}

# isIntScalarName -- one of the twelve INTEGER scalar names. The lean `for x: N`
# form below counts in an int64 induction variable, so a float bound would
# truncate silently and a bool one is meaningless -- cTypeOf answers for both, so
# it cannot be the test. Membership through one string rather than a compare
# chain, which is the shape A001 exists to discourage.
isIntScalarName: function {name: StringView} out bool is {
    if name.length == 0 then return false
    known: " i8 i16 i32 i64 i128 u8 u16 u32 u64 u128 c8 c32 "
    probe: " \{name} "
    return (known.contains needle: probe)
}

# isRangeMemberId -- `iterate` or its synonym `each`, by INTERNED ID. Both legs
# of the range emit ask through here: emitRangeStep once accepted `each` while
# rangeBoundExpr compared the spelling "iterate" alone, so `for x: N.each loop`
# missed the counted-loop path, fell through to the iterator protocol, and never
# advanced -- a loop that printed the receiver forever.
isRangeMemberId: function {id: zast.nameid} out bool is {
    if id == zast.names.wkIterate then return true
    if id == zast.names.wkEach then return true
    return false
}

# rangeBoundExpr -- the upper bound of an `N.iterate` / `N.each` range (the
# dotted receiver N); "" when the operation is not one of those calls.
rangeBoundExpr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
} out String is {
    # THE LEAN FORM, tested once for every arm below: `for x: N loop` is sugar for
    # `for x: N.iterate loop` (spec.pdoc, Iteration), so an integer-typed operand
    # IS its own bound and `from` is 0. It is asked here rather than in each arm
    # because a `case` arm narrows the subject to its payload and no longer holds
    # the whole node, and the shape varies: a bare literal is an atom, a
    # width-suffixed one (`3.u8`) a DOTTED PATH, and `xs.length` a dotted path too.
    # Without it the documented sugar found no bound at all, fell through to the
    # iterator protocol, and looped forever on its own receiver.
    isLean: false
    btnL: stampNameDeep :ast :symtab :n
    if (isIntScalarName name: btnL.stringView) then isLean = true
    match (
        n
    ) case expression then {
        return (rangeBoundExpr :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        callableNode: ast.nodes.get i: n.callable.u64
        mnId: dottedChildNameIdOf :ast n: callableNode
        if (isRangeMemberId id: mnId) then return (rangeReceiver :ast :symtab :ctx n: callableNode)
        if isLean then return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.nodeid.u64))
        return "".string
    } case dottedpath then {
        cmnId: atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64)
        if (isRangeMemberId id: cmnId) then {
            # the receiver may be a dotted-path itself (squares.length.iterate)
            # -- stampNameDeep resolves its scalar type either way.
            btn: stampNameDeep :ast :symtab n: (ast.nodes.get i: n.parent.u64)
            boundCType: cTypeOf name: btn.stringView
            if boundCType.length > 0 then {
                return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
            }
        }
        if isLean then return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.nodeid.u64))
        return "".string
    } else {
        if isLean then return (emitExpr :ast :symtab :ctx :n)
        return "".string
    }
}

# rangeReceiver -- the C expression for the receiver of a `.iterate`
# dotted callable.
rangeReceiver: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
} out String is {
    match (
        n
    ) case dottedpath then {
        return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# rangeFromExpr -- the `from:` argument of an iterate range, or "0".
rangeFromExpr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
} out String is {
    match (
        n
    ) case expression then {
        return (rangeFromExpr :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        arx549: u64
        for arx549 < n.arguments.count.u64 loop {
            aId: zast.kidAt kids: ast.kids span: n.arguments i: arx549
            arx549 = arx549 + 1
            a: ast.nodes.get i: aId.u64
            if a.namedoperation then {
                an: zast.nameTextAt :ast ref: a.name
                if an.stringView == "from" then return (emitExpr
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                )
            }
        }
        return "0".string
    } else {
        return "0".string
    }
}

# emitForCond -- one for-header arm: a `while:` arm joins the loop
# condition; a named binding arm emits its init before the loop.
emitForCond: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    cond: String.borrow
    ind: StringView
    buf: String.borrow
} is {
    if n.namedoperation then {
        lblR7: zast.nameTextAt :ast ref: n.name
        lblV7: defVid :symtab nid: (interpPartNodeId n: (ast.nodes.get i: n.operation.u64))
        lbl: varCName :ctx vid: lblV7 name: lblR7.stringView
        if lblR7.length == 0 then {
            cv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.operation.u64)
            tw7: (truthyCondText
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: n.operation.u64)
                raw: cv.stringView
            )
            if cond.length > 0 then cond.append " && "
            if tw7.length > 0 then {
                cond.append tw7
            } else {
                cond.append cv
            }
        } else {
            onid: exprNodeId n: (ast.nodes.get i: n.operation.u64)
            tn: stampNameOf :symtab nid: onid
            takeFnTid: stampIdOf :symtab nid: onid
            ct: scalarCTypeFor :symtab name: tn.stringView tid: takeFnTid
            iv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.operation.u64)
            if ct.length > 0 then {
                li: "\{ind}\{ct} \{lbl} = \{iv};\n"
                buf.append li
            } else {
                li2: "\{ind}int64_t \{lbl} = \{iv};\n"
                buf.append li2
            }
        }
    }
}

# the node id of expression `n`.
exprNodeId: function {n: astnode.view} out u64 is {
    match (
        n
    ) case expression then {
        return n.nodeid.u64
    } case atomid then {
        return n.nodeid.u64
    } else {
        return 0
    }
}

# sumArmNamesInto -- the arm names of a sum type, in declaration order (the
# checker's exclusion universe).
sumArmNamesInto: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
    names: List String
} is {
    zenv.sumArmNames ty: symtab.typing reg: symtab.reg pool: ast.names :tid :names
}

# armAliasText -- the C lvalue for `recv`'s payload of `arm` on sum type
# `tid`: the inline union member for variants, the heap cast for unions.
# "" when the arm carries no payload.
armAliasText: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
    arm: StringView
    recv: StringView
    acc: StringView
} out String is {
    pc: armPayloadC :ast :symtab :ctx :tid :arm
    if pc.length == 0 then return "".string
    if (symtab.reg.typetypeOf typeId: tid) == ztypes.ztypetype.unionType then {
        return "(*(\{pc}*)\{recv}\{acc}data)"
    }
    armAtP: memberCPrefix name: arm
    return "\{recv}\{acc}data.\{armAtP}\{arm}"
}

# remainingArm -- the single arm of `tid` left after removing the
# ambient exclusions recorded for variable `subjVid` (ctx.exclArms) plus the
# `extra` space-joined arms; "" when zero or more than one remain.
remainingArm: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    subjVid: ztypes.vid
    tid: ztypes.tid
    extra: StringView
} out String is {
    exv: vvGet xs: ctx.exclArms vid: subjVid
    all: List String
    sumArmNamesInto :ast :symtab :tid names: all
    remN: u64
    rem: String
    with ait: all.iterate do for a: ait loop {
        hit: false
        if exv.length > 0 then {
            if (hasSpaceDelimitedWord hay: exv.stringView word: a.stringView) then hit = true
        }
        if hit == false when extra.length > 0 then {
            if (hasSpaceDelimitedWord hay: extra word: a.stringView) then hit = true
        }
        if hit == false then {
            remN = remN + 1
            rv: a.copy
            rem = rv
        }
    }
    if remN != 1 then return "".string
    return rem
}

# hasSpaceDelimitedWord -- space-delimited word membership.
hasSpaceDelimitedWord: function {hay: StringView word: StringView} out bool is {
    with wit: (hay.split sep: " ") do for w: wit loop {
        if w == word then return true
    }
    return false
}

# bodyReassigns -- true when the body (at any depth through the common
# statement containers) reassigns `name`, which would stale a narrowBox
# alias for it.
bodyReassigns: function {ast: Ast.view n: astnode.view name: StringView} out bool is {
    match (
        n
    ) case statement then {
        hit: false
        stx749: u64
        for stx749 < n.statements.count.u64 loop {
            s9Id: zast.kidAt kids: ast.kids span: n.statements i: stx749
            stx749 = stx749 + 1
            if (bodyReassigns :ast n: (ast.nodes.get i: s9Id.u64) :name) then hit = true
        }
        return hit
    } case statementline then {
        sln: ast.nodes.get i: n.statementline.u64
        return (bodyReassigns :ast n: sln :name)
    } case expression then {
        return (bodyReassigns :ast n: (ast.nodes.get i: n.expression.u64) :name)
    } case reassignment then {
        # a write THROUGH the subject (`s.field = x`) goes through the alias
        # and leaves it standing; only a rebind of the bare name stales it
        tpn: ast.nodes.get i: n.topath.u64
        rb: bareAtomText :ast n: tpn
        return rb == name
    } case ifexpr then {
        hif: false
        clx1049: u64
        for clx1049 < n.clauses.count.u64 loop {
            c: zast.kidAt kids: ast.kids span: n.clauses i: clx1049
            clx1049 = clx1049 + 1
            if (bodyReassigns :ast n: (ast.nodes.get i: c.u64) :name) then hif = true
        }
        if hif then return true
        if n.elseclause.isZero then return false
        return (bodyReassigns :ast n: (ast.nodes.get i: n.elseclause.u64) :name)
    } case ifclause then {
        return (bodyReassigns :ast n: (ast.nodes.get i: n.statement.u64) :name)
    } case caseexpr then {
        hce: false
        clx1059: u64
        for clx1059 < n.clauses.count.u64 loop {
            k: zast.kidAt kids: ast.kids span: n.clauses i: clx1059
            clx1059 = clx1059 + 1
            if (bodyReassigns :ast n: (ast.nodes.get i: k.u64) :name) then hce = true
        }
        if hce then return true
        if n.elseclause.isZero then return false
        return (bodyReassigns :ast n: (ast.nodes.get i: n.elseclause.u64) :name)
    } case caseclause then {
        return (bodyReassigns :ast n: (ast.nodes.get i: n.statement.u64) :name)
    } case forexpr then {
        if n.body.isZero then return false
        return (bodyReassigns :ast n: (ast.nodes.get i: n.body.u64) :name)
    } case doexpr then {
        return (bodyReassigns :ast n: (ast.nodes.get i: n.statement.u64) :name)
    } case withexpr then {
        return (bodyReassigns :ast n: (ast.nodes.get i: n.body.u64) :name)
    } else {
        return false
    }
}

# seedFromPredicate -- one POSITIVE bare arm predicate dotted node: admit a
# non-bool receiver variable whose arm carries a payload and whose
# subject the body does not reassign; append its narrowBox seed
# (subject, alias text, payload tid). The condition-form dispatch
# (trailing .true/.false, == true/false) lives in seedCondOp.
seedFromPredicate: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    body: astnode.view
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    tids: ListVal u64
} is {
    match (
        n
    ) case expression then {
        iexA: ast.nodes.get i: n.expression.u64
        seedFromPredicate :ast :symtab :ctx n: iexA :body :names :svids :vals :tids
    } case dottedpath then {
        arm0: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        tid92: (ztypes.tid.create from: (dottedArmPredicateTid :symtab nid: n.nodeid.u64))
        (seedPositiveCore
            :ast
            :symtab
            :ctx
            tid: tid92
            parent: (ast.nodes.get i: n.parent.u64)
            childName: arm0.stringView
            :body
            :names
            :svids
            :vals
            :tids
        )
    } else null
}

# seedPositiveCore -- the positive-seed core: the subject named by `parent` is
# known to hold `childName` of `tid`.
seedPositiveCore: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
    parent: astnode.view
    childName: StringView
    body: astnode.view
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    tids: ListVal u64
} is {
    if tid.isZero then return
    if (isOrdinalVariant :symtab :tid) then return
    subj: atomTextOf :ast n: parent
    if subj.length == 0 then return
    if (bodyReassigns :ast n: body name: subj) then return
    recvText: emitExpr :ast :symtab :ctx n: parent
    accessOp: ".".string
    if (isPtrVid
        :ctx
        vid: (atomVid :symtab nid: (atomNodeId n: parent))
    ) then accessOp = "->".string
    aliasText: (armAliasText
        :ast
        :symtab
        :ctx
        :tid
        arm: childName
        recv: recvText.stringView
        acc: accessOp.stringView
    )
    if aliasText.length == 0 then return
    names.append subj.string
    svids.append (atomVid :symtab nid: (atomNodeId n: parent))
    vals.append aliasText
    pt: ((symtab.typing.declChildOf
        pool: ast.names
        parentTypeId: tid
        name: childName
    ).or
        d: 0
    )
    tids.append pt
}

# seedNegatedFromPredicate -- a NEGATED bare arm predicate: the branch knows the
# subject does NOT hold `arm`. When exactly one payload arm remains, seed
# its alias (exclusion collapse, mirroring the checker).
seedNegatedFromPredicate: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: astnode.view
    body: astnode.view
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    tids: ListVal u64
} is {
    match (
        n
    ) case expression then {
        iexB: ast.nodes.get i: n.expression.u64
        seedNegatedFromPredicate :ast :symtab :ctx n: iexB :body :names :svids :vals :tids
    } case dottedpath then {
        dap: dottedArmPredicateTid :symtab nid: n.nodeid.u64
        if dap == 0 then return
        if (isOrdinalVariant :symtab tid: (ztypes.tid.create from: dap.u64)) then return
        subj: atomTextOf :ast n: (ast.nodes.get i: n.parent.u64)
        if subj.length == 0 then return
        snv: atomVid :symtab nid: (atomNodeId n: (ast.nodes.get i: n.parent.u64))
        ctorArmName: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        rem: (remainingArm
            :ast
            :symtab
            :ctx
            subjVid: snv
            tid: (ztypes.tid.create from: dap.u64)
            extra: ctorArmName.stringView
        )
        if rem.length == 0 then return
        if (bodyReassigns :ast n: body name: subj) then return
        recvText: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
        accessOp: ".".string
        if (isPtrVid :ctx vid: snv) then accessOp = "->".string
        aliasText: (armAliasText
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: dap.u64)
            arm: rem.stringView
            recv: recvText.stringView
            acc: accessOp.stringView
        )
        if aliasText.length == 0 then return
        names.append subj.string
        svids.append snv
        vals.append aliasText
        pt: ((symtab.typing.declChildOf
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: dap.u64)
            name: rem.stringView
        ).or
            d: 0
        )
        tids.append pt
    } else null
}

# armSideAtNode -- which arm of ITS OWN stamped type the name `nameId` is, for
# the value at node `nid`. `true` and `false` are arms of bool, so a `== true`
# operand answers `truthy` and a `== false` one `falsy` -- from bool's arm
# ORDER, which is the whole content of the spelling test. Asking the node's own
# stamp rather than looking `bool` up by name costs nothing and is exact under
# a user type that shadows bool.
armSideAtNode: function {
    symtab: zenv.ZSymbolTable.view
    nid: u64
    nameId: zast.nameid
} out ztyping.armside is {
    if nameId.isZero then return ztyping.armside.none
    st: ztyping.nodeTypeAt tbl: symtab.typing.nodeType :nid
    return (ztyping.armSideOfName ty: symtab.typing typeId: st.u64 nameId: nameId.u64)
}

# boolArmSideOf -- armSideAtNode for a bare atom operand, through any
# expression wrapper.
boolArmSideOf: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: astnode.view
} out ztyping.armside is {
    match (
        n
    ) case expression then {
        return (boolArmSideOf :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return (armSideAtNode :symtab nid: n.nodeid.u64 nameId: n.name)
    } else {
        return ztyping.armside.none
    }
}

# truthyCondText -- the C for a condition whose type is a 2-arm sum rather
# than a bool: it holds when the value holds the arm the checker stamped. ""
# when the condition needs no wrapping at all -- a bool, and every other
# ordinal PAIR, already IS its discriminator in C, so the emitted expression is
# the answer.
#
# The arm comes off the stamp rather than a lookup here: a generic mono keeps
# its arm record on the template it was minted from.
truthyCondText: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: astnode.view
    raw: StringView
} out String is {
    fa: u64
    {
        fo: symtab.typing.truthyCondArm.get key: (interpPartNodeId :n)
        match (
            fo
        ) case some then {
            fa = fo
        } case none then null
    }
    if fa == 0 then return "".string
    tid: ztyping.nodeTypeAt tbl: symtab.typing.nodeType nid: (interpPartNodeId :n)
    if tid.isZero then return "".string
    if (isOrdinalPair :symtab :tid) then return "".string
    an: zast.nameTextAt :ast ref: (zast.nameid.create from: fa.u32.orPanic)
    tg: variantTag :symtab :tid arm: an.stringView
    if tg.length == 0 then return "".string
    accessOp: ".".string
    {
        rn: atomNodeId :n
        if rn > 0 then {
            if (isPtrVid :ctx vid: (atomVid :symtab nid: rn)) then accessOp = "->".string
        }
    }
    return "((\{raw})\{accessOp}tag == \{tg})"
}

# seed a condition's operator so the branch emit can read it without re-
# resolving
seedCondOp: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: astnode.view
    body: astnode.view
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    tids: ListVal u64
} is {
    # a bare 2-arm sum condition IS `x.<arm>` with the arm left implicit, so
    # it seeds the alias that form seeds.
    {
        ta0: ztypecheck.truthyCondArmOf st: symtab nid: (interpPartNodeId :n)
        if ta0 > 0 then {
            an0: zast.nameTextAt :ast ref: (zast.nameid.create from: ta0.u32.orPanic)
            tid93: (ztyping.nodeTypeAt tbl: symtab.typing.nodeType nid: (interpPartNodeId :n))
            (seedPositiveCore
                :ast
                :symtab
                :ctx
                tid: tid93
                parent: n
                childName: an0.stringView
                :body
                :names
                :svids
                :vals
                :tids
            )
            return
        }
    }
    match (
        n
    ) case expression then {
        iexC: ast.nodes.get i: n.expression.u64
        seedCondOp :ast :symtab :ctx n: iexC :body :names :svids :vals :tids
    } case dottedpath then {
        cn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        # `.true` / `.false` on a predicate: which side it is comes from the
        # stamped type's arm ORDER, never from the spelling of the segment.
        sd: (ztypecheck.armSuffixSide
            :ast
            st: symtab
            nid: n.nodeid.u64
            parent: (ast.nodes.get i: n.parent.u64)
            child: (ast.nodes.get i: n.child.u64)
        )
        if sd.truthy then {
            dpp: ast.nodes.get i: n.parent.u64
            seedFromPredicate :ast :symtab :ctx n: dpp :body :names :svids :vals :tids
            return
        }
        if sd.falsy then {
            dpq: ast.nodes.get i: n.parent.u64
            seedNegatedFromPredicate :ast :symtab :ctx n: dpq :body :names :svids :vals :tids
            return
        }
        tid94: (ztypes.tid.create from: (dottedArmPredicateTid :symtab nid: n.nodeid.u64))
        (seedPositiveCore
            :ast
            :symtab
            :ctx
            tid: tid94
            parent: (ast.nodes.get i: n.parent.u64)
            childName: cn.stringView
            :body
            :names
            :svids
            :vals
            :tids
        )
    } case binop then {
        opn: bareAtomText :ast n: (ast.nodes.get i: n.operator.u64)
        if opn == "==" then {
            # `== true` / `== false`: the operand names one of bool's arms,
            # and which side it is comes from bool's arm ORDER.
            lsd: boolArmSideOf :ast :symtab n: (ast.nodes.get i: n.lhs.u64)
            rsd: boolArmSideOf :ast :symtab n: (ast.nodes.get i: n.rhs.u64)
            if rsd.truthy then {
                bl: ast.nodes.get i: n.lhs.u64
                seedFromPredicate :ast :symtab :ctx n: bl :body :names :svids :vals :tids
                return
            }
            if rsd.falsy then {
                lhsNode: ast.nodes.get i: n.lhs.u64
                (seedNegatedFromPredicate
                    :ast
                    :symtab
                    :ctx
                    n: lhsNode
                    :body
                    :names
                    :svids
                    :vals
                    :tids
                )
                return
            }
            if lsd.truthy then {
                br: ast.nodes.get i: n.rhs.u64
                seedFromPredicate :ast :symtab :ctx n: br :body :names :svids :vals :tids
                return
            }
            if lsd.falsy then {
                rhsNode: ast.nodes.get i: n.rhs.u64
                (seedNegatedFromPredicate
                    :ast
                    :symtab
                    :ctx
                    n: rhsNode
                    :body
                    :names
                    :svids
                    :vals
                    :tids
                )
            }
        }
    } else null
}

# bareAtomText -- the expression-unwrapped bare atom text of a node,
# "" for any other shape; a view into the pool.
bareAtomText: function {ast: Ast.view n: astnode.view} outx StringView is {
    match (
        n
    ) case expression then {
        return (bareAtomText :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return (zast.nameTextAt :ast ref: n.name).stringView
    } else {
        return ""
    }
}

# ifPredicateSeeds -- collect the narrowBox seeds for a clause's bare
# arm-predicate conjuncts, all condition forms (parallel lists).
ifPredicateSeeds: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    conds: zast.kidspan
    bodyId: zast.nodeid
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    tids: ListVal u64
} is {
    body: ast.nodes.get i: bodyId.u64
    h2x9: u64
    for h2x9 < conds.count.u64 loop {
        k9Id: zast.kidAt kids: ast.kids span: conds i: h2x9
        h2x9 = h2x9 + 1
        k: ast.nodes.get i: k9Id.u64
        if k.namedoperation then {
            (seedCondOp
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: k.operation.u64)
                :body
                :names
                :svids
                :vals
                :tids
            )
        }
    }
}

# chainFactsOfClauses -- the accumulated single-bare-conjunct facts of an
# if chain (subject/arm/tid/negated parallel lists), by the checker's
# accumulation rule exactly.
chainFactsOfClauses: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    clauses: zast.kidspan
    subjects: List String
    svids: ListVal ztypes.vid
    arms: List String
    tids: ListVal u64
    negs: ListVal bool
    recvs: List String
} is {
    h8x9: u64
    for h8x9 < clauses.count.u64 loop {
        c9Id: zast.kidAt kids: ast.kids span: clauses i: h8x9
        h8x9 = h8x9 + 1
        c: ast.nodes.get i: c9Id.u64
        if c.ifclause then {
            if c.conditions.count.u64 == 1 then {
                tS: List String
                tV: ListVal ztypes.vid
                tA: List String
                tT: ListVal u64
                tN: ListVal bool
                tR: List String
                cox1299: u64
                for cox1299 < c.conditions.count.u64 loop {
                    k9Id: zast.kidAt kids: ast.kids span: c.conditions i: cox1299
                    cox1299 = cox1299 + 1
                    k: ast.nodes.get i: k9Id.u64
                    if k.namedoperation then {
                        (chainCondFact
                            :ast
                            :symtab
                            :ctx
                            n: (ast.nodes.get i: k.operation.u64)
                            subjects: tS
                            svids: tV
                            arms: tA
                            tids: tT
                            negs: tN
                            recvs: tR
                        )
                    }
                }
                if tS.length == 1 then {
                    ms: tS.pop
                    subjects.append ms
                    svids.append (tV.get i: 0)
                    ma: tA.pop
                    arms.append ma
                    tids.append (tT.get i: 0)
                    negs.append (tN.get i: 0)
                    mr: tR.pop
                    recvs.append mr
                }
            }
        }
    }
}

# chainCondFact -- recognize one condition operation as a bare arm
# predicate for chain accumulation (all four forms).
chainCondFact: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    subjects: List String
    svids: ListVal ztypes.vid
    arms: List String
    tids: ListVal u64
    negs: ListVal bool
    recvs: List String
} is {
    # the bare form again -- same fact, recorded for the else emission
    {
        ta1: ztypecheck.truthyCondArmOf st: symtab nid: (interpPartNodeId :n)
        if ta1 > 0 then {
            an1: zast.nameTextAt :ast ref: (zast.nameid.create from: ta1.u32.orPanic)
            own1: (ztyping.nodeTypeAt tbl: symtab.typing.nodeType nid: (interpPartNodeId :n)).u64
            (chainFactCore
                :ast
                :symtab
                :ctx
                owner: own1
                parent: n
                childName: an1.stringView
                neg: false
                :subjects
                :svids
                :arms
                :tids
                :negs
                :recvs
            )
            return
        }
    }
    match (
        n
    ) case expression then {
        iexD: ast.nodes.get i: n.expression.u64
        chainCondFact :ast :symtab :ctx n: iexD :subjects :svids :arms :tids :negs :recvs
    } case dottedpath then {
        cn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        # `.true` / `.false` on a predicate: which side it is comes from the
        # stamped type's arm ORDER, never from the spelling of the segment.
        sd: (ztypecheck.armSuffixSide
            :ast
            st: symtab
            nid: n.nodeid.u64
            parent: (ast.nodes.get i: n.parent.u64)
            child: (ast.nodes.get i: n.child.u64)
        )
        if sd.truthy then {
            (chainInnerFact
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: n.parent.u64)
                neg: false
                :subjects
                :svids
                :arms
                :tids
                :negs
                :recvs
            )
            return
        }
        if sd.falsy then {
            (chainInnerFact
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: n.parent.u64)
                neg: true
                :subjects
                :svids
                :arms
                :tids
                :negs
                :recvs
            )
            return
        }
        owner9: (dottedArmPredicateTid :symtab nid: n.nodeid.u64)
        (chainFactCore
            :ast
            :symtab
            :ctx
            owner: owner9
            parent: (ast.nodes.get i: n.parent.u64)
            childName: cn.stringView
            neg: false
            :subjects
            :svids
            :arms
            :tids
            :negs
            :recvs
        )
    } case binop then {
        opn: bareAtomText :ast n: (ast.nodes.get i: n.operator.u64)
        if opn == "==" then {
            # `== true` / `== false`: the operand names one of bool's arms,
            # and which side it is comes from bool's arm ORDER.
            lsd: boolArmSideOf :ast :symtab n: (ast.nodes.get i: n.lhs.u64)
            rsd: boolArmSideOf :ast :symtab n: (ast.nodes.get i: n.rhs.u64)
            if rsd.truthy then {
                (chainInnerFact
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: n.lhs.u64)
                    neg: false
                    :subjects
                    :svids
                    :arms
                    :tids
                    :negs
                    :recvs
                )
                return
            }
            if rsd.falsy then {
                (chainInnerFact
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: n.lhs.u64)
                    neg: true
                    :subjects
                    :svids
                    :arms
                    :tids
                    :negs
                    :recvs
                )
                return
            }
            if lsd.truthy then {
                (chainInnerFact
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: n.rhs.u64)
                    neg: false
                    :subjects
                    :svids
                    :arms
                    :tids
                    :negs
                    :recvs
                )
                return
            }
            if lsd.falsy then {
                (chainInnerFact
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: n.rhs.u64)
                    neg: true
                    :subjects
                    :svids
                    :arms
                    :tids
                    :negs
                    :recvs
                )
            }
        }
    } else null
}

# chainInnerFact -- the stamped bare-predicate core for chain facts.
chainInnerFact: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    neg: bool
    subjects: List String
    svids: ListVal ztypes.vid
    arms: List String
    tids: ListVal u64
    negs: ListVal bool
    recvs: List String
} is {
    match (
        n
    ) case expression then {
        iexE: ast.nodes.get i: n.expression.u64
        chainInnerFact :ast :symtab :ctx n: iexE :neg :subjects :svids :arms :tids :negs :recvs
    } case dottedpath then {
        arm0: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        owner92: (dottedArmPredicateTid :symtab nid: n.nodeid.u64)
        (chainFactCore
            :ast
            :symtab
            :ctx
            owner: owner92
            parent: (ast.nodes.get i: n.parent.u64)
            childName: arm0.stringView
            :neg
            :subjects
            :svids
            :arms
            :tids
            :negs
            :recvs
        )
    } else null
}

# chainFactCore -- the exploded chain-fact core (dotted node fields).
# Captures the emitted receiver text alongside the fact so the else
# emission never re-derives it from the name.
chainFactCore: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    owner: u64
    parent: astnode.view
    childName: StringView
    neg: bool
    subjects: List String
    svids: ListVal ztypes.vid
    arms: List String
    tids: ListVal u64
    negs: ListVal bool
    recvs: List String
} is {
    if owner == 0 then return
    if (isOrdinalVariant :symtab tid: (ztypes.tid.create from: owner.u64)) then return
    subj: atomTextOf :ast n: parent
    if subj.length == 0 then return
    an: childName.string
    rv: emitExpr :ast :symtab :ctx n: parent
    subjects.append subj.string
    svids.append (atomVid :symtab nid: (atomNodeId n: parent))
    arms.append an
    tids.append owner
    negs.append neg
    recvs.append rv
}

# emit one clause of an if-expression.
# condInParens -- a C `if`/`while` condition, wrapped in parens exactly once.
# An emitted expression is usually already fully parenthesized (`(a == b)`);
# wrapping it again makes clang warn (-Wparentheses-equality). A condition
# containing a string literal keeps the extra wrap rather than depth-counting
# through quoted parens. A STATEMENT EXPRESSION (`({ ... })`, what the result
# and option combinators lower to) opens with a paren the `if (` would swallow,
# leaving a block where C wants an expression, so it always takes the wrap.
condInParens: function {cond: StringView} out String is {
    n: cond.length
    wrapped: false
    isStmtExpr: cond.startsWith "({"
    if n >= 2 when (cond.contains "\"") == false when isStmtExpr == false then {
        b0: cond.byteAt 0.u64
        match (
            b0
        ) case some then {
            if b0 == 40 then {
                depth: u64
                i: u64
                bal: true
                for i < n loop {
                    bo: cond.byteAt i
                    match (
                        bo
                    ) case some then {
                        if bo == 40 then depth = depth + 1
                        if bo == 41 then {
                            depth = depth - 1
                            if depth == 0 when i < (n - 1) then bal = false
                        }
                    } case none then null
                    i = i + 1
                }
                if bal when depth == 0 then wrapped = true
            }
        } case none then null
    }
    if wrapped then return cond.string
    return "(\{cond})"
}

# appendCondText -- render one condition into the `&&` chain being built.
appendCondText: function {
    # the tree this one condition is read from
    ast: Ast.view
    # the stamps this condition's truthiness is judged against
    symtab: zenv.ZSymbolTable
    # the emit context the condition text is built in
    ctx: Ctx
    # the condition's namedoperation node id
    kId: u32
    # the chain so far; a `&&` is inserted when it is not empty
    cond: String.borrow
} is {
    k: ast.nodes.get i: kId.u64
    if k.namedoperation then {
        cv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: k.operation.u64)
        tw: (truthyCondText
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: k.operation.u64)
            raw: cv.stringView
        )
        if cond.length > 0 then cond.append " && "
        if tw.length > 0 then {
            cond.append tw
        } else {
            cond.append cv
        }
    }
}

# whenCondSuspends -- a `when` condition of this clause holds a suspension.
#
# The FIRST condition is not asked about: it runs unconditionally, so the
# ordinary statement-level hoist already reaches it. Every condition after it
# is guarded by the ones before -- `when` short-circuits -- so its suspension
# cannot be lifted above the `if` without running on a path never taken.
whenCondSuspends: function {ast: Ast.view ctx: Ctx.view n: zast.ifclauserow} out bool is {
    if ctx.genActive == false then return false
    wi: 1.u64
    for wi < n.conditions.count.u64 loop {
        cwi: zast.kidAt kids: ast.kids span: n.conditions i: wi
        wi = wi + 1
        if (zast.yieldCountIn :ast nid: (zast.nodeid.create from: cwi)) > 0 then return true
    }
    return false
}

# emitGuardedWhenCond -- compute a clause's conditions into a GUARD when one of
# the `when` parts suspends, and answer the guard's name for the header to test.
#
# `if a when b then` becomes `g = 0; if (a) { <suspend>; g = (b); }` and the
# header tests `g`. That is C's own short-circuit written out: `b` still runs
# only when `a` held, and the suspension now sits on a statement inside that
# guard rather than inside an expression that cannot hold one.
emitGuardedWhenCond: function {
    # the tree this clause's conditions are read from
    ast: Ast.view
    # read for the resume type of each suspension in a `when`
    symtab: zenv.ZSymbolTable
    # carries the guard counter and the resume slots
    ctx: Ctx
    # the clause whose conditions these are
    n: zast.ifclauserow
    # the indent the guard and its `if` are written at
    ind: StringView
    # the guard declaration and its computation append here
    buf: String.borrow
} out String is {
    gnum: ctx.whenGuardCtr
    ctx.whenGuardCtr = gnum + 1
    gvar: "_wc\{gnum}"
    c0: String
    (appendCondText
        :ast
        :symtab
        :ctx
        kId: (zast.kidAt kids: ast.kids span: n.conditions i: 0)
        cond: c0
    )
    if c0.length == 0 then c0.append "1"
    buf.append "\{ind}uint8_t \{gvar} = 0;\n"
    cw0: condInParens cond: c0.stringView
    buf.append "\{ind}if \{cw0} {\n"
    ind2: "\{ind}    "
    wi: 1.u64
    for wi < n.conditions.count.u64 loop {
        cwi: zast.kidAt kids: ast.kids span: n.conditions i: wi
        wi = wi + 1
        (hoistExprYields
            :ast
            :symtab
            :ctx
            nid: (zast.nodeid.create from: cwi)
            ind: ind2.stringView
            :buf
        )
    }
    rest: String
    ri9: 1.u64
    for ri9 < n.conditions.count.u64 loop {
        cri: zast.kidAt kids: ast.kids span: n.conditions i: ri9
        ri9 = ri9 + 1
        appendCondText :ast :symtab :ctx kId: cri cond: rest
    }
    if rest.length == 0 then rest.append "1"
    cwR: condInParens cond: rest.stringView
    buf.append "\{ind2}\{gvar} = \{cwR} ? 1 : 0;\n"
    buf.append "\{ind}}\n"
    return gvar
}

# emit one if or else-if clause: its conditions, then the body they guard
emitIfClause: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: astnode.view
    isFirst: bool
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    if n.ifclause then {
        # a suspending `when` cannot be built into the header text: rendering it
        # there would put the suspension inside an expression. Compute the
        # conditions into a guard first and let the header test that. Only the
        # FIRST clause takes this path -- a later clause's header is
        # `} else if (..) {`, which has nowhere to put the statements.
        guarded: false
        if isFirst when (whenCondSuspends :ast :ctx :n) then guarded = true
        cond: String
        if guarded then {
            flushArgHoists :ctx :ind :tmp :buf
            gv: emitGuardedWhenCond :ast :symtab :ctx :n :ind :buf
            cond.append gv
        } else {
            cox1309: u64
            for cox1309 < n.conditions.count.u64 loop {
                kId: zast.kidAt kids: ast.kids span: n.conditions i: cox1309
                cox1309 = cox1309 + 1
                appendCondText :ast :symtab :ctx :kId :cond
            }
        }
        if isFirst then {
            if guarded == false then flushArgHoists :ctx :ind :tmp :buf
            cw: condInParens cond: cond.stringView
            lf: "\{ind}if \{cw} {\n"
            buf.append lf
        } else {
            cw9x: condInParens cond: cond.stringView
            lg: "\{ind}} else if \{cw9x} {\n"
            buf.append lg
        }
        ind2: "\{ind}    "
        sN: List String
        sVid: ListVal ztypes.vid
        sV: List String
        sT: ListVal u64
        (ifPredicateSeeds
            :ast
            :symtab
            :ctx
            conds: n.conditions
            bodyId: n.statement
            names: sN
            svids: sVid
            vals: sV
            tids: sT
        )
        sPrevV: List String
        sPrevT: ListVal u64
        si: u64
        for si < sN.length loop {
            snm: sN.get i: si
            snv0: sVid.get i: si
            pv: vvGet xs: ctx.narrowBox vid: snv0
            sPrevV.append pv
            ptv: (vtGet xs: ctx.narrowTid vid: snv0).or d: (ztypes.tid.create from: 0)
            sPrevT.append ptv
            svv: sV.get i: si
            vvSet xs: ctx.narrowBox vid: snv0 val: svv.stringView
            stt: sT.get i: si
            vtSet xs: ctx.narrowTid vid: snv0 tid: (ztypes.tid.create from: stt.u64)
            cmtS: "\{ind}    /* alias: \{snm} => \{svv} */\n"
            buf.append cmtS
            si = si + 1
        }
        cst: ast.nodes.get i: n.statement.u64
        if assignTo.length > 0 then {
            (emitBranchAssign
                :ast
                :symtab
                :ctx
                n: cst
                target: assignTo
                ind: ind2.stringView
                :tmp
                :buf
            )
        } else {
            fLi: tmp.frees.length
            lLi: tmp.listFrees.length
            emitBodyNode :ast :symtab :ctx n: cst ind: ind2.stringView :tmp :buf
            dvF: blockDiverges :ast :symtab :ctx n: cst
            flushBlockFrees :ctx :tmp fL: fLi lL: lLi diverged: dvF :buf
        }
        ri: u64
        for ri < sN.length loop {
            rnv: sVid.get i: ri
            rv: sPrevV.get i: ri
            if rv.length > 0 then {
                vvSet xs: ctx.narrowBox vid: rnv val: rv.stringView
            } else {
                vvRemove xs: ctx.narrowBox vid: rnv
            }
            rt: sPrevT.get i: ri
            if rt > 0 then {
                vtSet xs: ctx.narrowTid vid: rnv tid: (ztypes.tid.create from: rt.u64)
            } else {
                vtRemove xs: ctx.narrowTid vid: rnv
            }
            ri = ri + 1
        }
    }
}

# emit an if/match else branch.
emitElse: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    oId: zast.nodeid
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    chSubjects: (List String).view
    chSubjectVids: (ListVal ztypes.vid).view
    chArms: (List String).view
    chTids: (ListVal u64).view
    chNegs: (ListVal bool).view
    chRecvs: (List String).view
    buf: String.borrow
} is {
    if oId > 0 then {
        o: ast.nodes.get i: oId.u64
        lh: "\{ind}} else {\n"
        buf.append lh
        ind2: "\{ind}    "
        # condition-false knowledge: each positive chain fact excludes its
        # arm for the else body (layered in ctx.exclArms so nested else-if
        # wraps compose); a negated fact IS the arm directly.
        exN: ListVal ztypes.vid
        exPrevV: List String
        exPrevT: ListVal u64
        fi: u64
        for fi < chSubjects.length loop {
            if (chNegs.get i: fi) == false then {
                fv: chSubjectVids.get i: fi
                pv0: vvGet xs: ctx.exclArms vid: fv
                exN.append fv
                pvc: pv0.copy
                exPrevV.append pvc
                exPrevT.append ((vtGet xs: ctx.exclTids vid: fv).or d: (ztypes.tid.create from: 0))
                fa: chArms.get i: fi
                nx: String
                if pv0.length > 0 then {
                    nj: "\{pv0} \{fa}"
                    nx = nj
                } else {
                    na0: fa.copy
                    nx = na0
                }
                vvSet xs: ctx.exclArms vid: fv val: nx.stringView
                vtSet xs: ctx.exclTids vid: fv tid: (ztypes.tid.create from: (chTids.get i: fi))
            }
            fi = fi + 1
        }
        sN: List String
        sVid: ListVal ztypes.vid
        sPrevV: List String
        sPrevT: ListVal u64
        doneS: IdSet ztypes.vid
        gi: u64
        for gi < chSubjects.length loop {
            gs: chSubjects.get i: gi
            gv: chSubjectVids.get i: gi
            if (doneS.has item: gv) == false then {
                doneS.add item: gv
                gtid: chTids.get i: gi
                negArm: String
                hj: u64
                for hj < chSubjects.length loop {
                    h2v: chSubjectVids.get i: hj
                    if h2v == gv then {
                        if (chNegs.get i: hj) then {
                            hav: chArms.get i: hj
                            hac: hav.copy
                            negArm = hac
                        }
                    }
                    hj = hj + 1
                }
                fArm: negArm.copy
                if fArm.length == 0 then {
                    rr: (remainingArm
                        :ast
                        :symtab
                        :ctx
                        subjVid: gv
                        tid: (ztypes.tid.create from: gtid.u64)
                        extra: ""
                    )
                    fArm = rr
                }
                if fArm.length > 0 then {
                    if (bodyReassigns :ast n: o name: gs.stringView) == false then {
                        mrecv: chRecvs.get i: gi
                        macc: ".".string
                        if (isPtrVid :ctx vid: gv) then macc = "->".string
                        aliasText: (armAliasText
                            :ast
                            :symtab
                            :ctx
                            tid: (ztypes.tid.create from: gtid.u64)
                            arm: fArm.stringView
                            recv: mrecv.stringView
                            acc: macc.stringView
                        )
                        if aliasText.length > 0 then {
                            pv: vvGet xs: ctx.narrowBox vid: gv
                            sPrevV.append pv
                            ptv: ((vtGet
                                xs: ctx.narrowTid
                                vid: gv
                            ).or
                                d: (ztypes.tid.create from: 0)
                            )
                            sPrevT.append ptv
                            gsv: gs.copy
                            sN.append gsv
                            sVid.append gv
                            vvSet xs: ctx.narrowBox vid: gv val: aliasText.stringView
                            pt: ((symtab.typing.declChildOf
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: gtid.u64)
                                name: fArm.stringView
                            ).or
                                d: 0
                            )
                            vtSet xs: ctx.narrowTid vid: gv tid: (ztypes.tid.create from: pt.u64)
                            cmtS: "\{ind}    /* alias: \{gs} => \{aliasText} */\n"
                            buf.append cmtS
                        }
                    }
                }
            }
            gi = gi + 1
        }
        if assignTo.length > 0 then {
            (emitBranchAssign
                :ast
                :symtab
                :ctx
                n: o
                target: assignTo
                ind: ind2.stringView
                :tmp
                :buf
            )
        } else {
            fLe: tmp.frees.length
            lLe: tmp.listFrees.length
            emitBodyNode :ast :symtab :ctx n: o ind: ind2.stringView :tmp :buf
            dvF: blockDiverges :ast :symtab :ctx n: o
            flushBlockFrees :ctx :tmp fL: fLe lL: lLe diverged: dvF :buf
        }
        ri: u64
        for ri < sN.length loop {
            rnv: sVid.get i: ri
            rv: sPrevV.get i: ri
            if rv.length > 0 then {
                vvSet xs: ctx.narrowBox vid: rnv val: rv.stringView
            } else {
                vvRemove xs: ctx.narrowBox vid: rnv
            }
            rt: sPrevT.get i: ri
            if rt > 0 then {
                vtSet xs: ctx.narrowTid vid: rnv tid: (ztypes.tid.create from: rt.u64)
            } else {
                vtRemove xs: ctx.narrowTid vid: rnv
            }
            ri = ri + 1
        }
        xi: exN.length
        for xi > 0 loop {
            xi = xi - 1
            xn: exN.get i: xi
            xv: exPrevV.get i: xi
            if xv.length > 0 then {
                vvSet xs: ctx.exclArms vid: xn val: xv.stringView
            } else {
                vvRemove xs: ctx.exclArms vid: xn
            }
            xt: exPrevT.get i: xi
            if xt > 0 then {
                vtSet xs: ctx.exclTids vid: xn tid: (ztypes.tid.create from: xt.u64)
            } else {
                vtRemove xs: ctx.exclTids vid: xn
            }
        }
    }
}

# emitReturnOfNode -- `return <value of node vid>;` with the explicit-return
# machinery: option-box hoist, string-return fast path, and the leak-safe
# temp-materialization + cleanup ordering. Shared by the `return` call arm
# and tail-position value yields.
emitReturnOfNode: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    vid: u32
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    bx: (emitOptionBoxHoist
        :ast
        :symtab
        :ctx
        n: (ast.nodes.get i: vid.u64)
        :ind
        :tmp
        :buf
    )
    if bx.length > 0 then {
        (emitValueTakeInvalidations
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: vid.u64)
            :ind
            :buf
        )
        emitReturnCleanup :ctx :tmp retExpr: bx.stringView keepRefd: true :ind :buf
        lrb: "\{ind}return \{bx};\n"
        buf.append lrb
    } else {
        sret: (emitStringReturnValue
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: vid.u64)
            :ind
            :tmp
            :buf
        )
        if sret == false then {
            rv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: vid.u64)
            flushArgHoists :ctx :ind :tmp :buf
            # A non-trivial value-type return may read an owned local the
            # cleanup would free -- a borrowed element or view (e.g.
            # `container.get idx`, or a StringView into a local String).
            # Materialize rv into a temp FIRST, then free. When an owned
            # local is named in rv (leakFix), free ALL owned locals
            # (clFull) after zeroing the moved-in call-arg sources
            # (emitValueTakeInvalidations): a read-from local is reclaimed
            # and a moved-in local's free is a no-op. Pointer returns
            # (protocol / Map / Set / by-ref class -- isPtr) arrive as bare
            # temps; hoisting a shallow pointer copy then freeing it would
            # dangle, so they keep the refsLocal (clProbe) cleanup inline.
            clProbe: String
            (emitReturnCleanup
                :ctx
                :tmp
                retExpr: rv.stringView
                keepRefd: true
                :ind
                buf: clProbe
            )
            clFull: String
            (emitReturnCleanup
                :ctx
                :tmp
                retExpr: rv.stringView
                keepRefd: false
                :ind
                buf: clFull
            )
            leakFix: false
            if clFull.length > clProbe.length then leakFix = true
            rtid: (stampIdOf
                :symtab
                nid: (interpPartNodeId n: (ast.nodes.get i: vid.u64))
            )
            retCt: typeRefC :ast :symtab :ctx tid: rtid thisTid: ztypes.tid
            isPtr: ctEndsWithStar ct: retCt.stringView
            if (isHeapPtrCollection :symtab :ctx tid: rtid) then isPtr = true
            trivial: isBareCName s: rv.stringView
            hoist: false
            if trivial == false when isPtr == false when retCt.length > 0 then {
                if clProbe.length > 0 then hoist = true
                if leakFix then hoist = true
            }
            if hoist then {
                rtmpN: tmp.next
                retNm: "_ret\{rtmpN}"
                hdecl: "\{ind}\{retCt} \{retNm} = \{rv};\n"
                buf.append hdecl
                if leakFix then {
                    (emitValueTakeInvalidations
                        :ast
                        :symtab
                        :ctx
                        n: (ast.nodes.get i: vid.u64)
                        :ind
                        :buf
                    )
                }
                (emitNarrowedTakeZero
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: vid.u64)
                    :ind
                    :buf
                )
                if leakFix then {
                    buf.append clFull
                } else {
                    buf.append clProbe
                }
                hret: "\{ind}return \{retNm};\n"
                buf.append hret
            } else {
                buf.append clProbe
                # a reference return hands back the address, not a copy of the
                # struct; without the `&` the caller writes through a temporary
                rvOut: "\{rv}"
                if ctx.refBorrowRet then rvOut = "&\{rv}"
                if ctx.refBorrowRet == false when (needsValueDeref
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: vid.u64)
                    tid: (stampIdOf :symtab nid: vid.u64)
                ) then rvOut = "(*\{rv})"
                lr: "\{ind}return \{rvOut};\n"
                buf.append lr
            }
        }
    }
}

# emitTailStmt -- the last statement of an `out`-typed function body sits in
# return position: a bare value expression becomes `return <expr>;`, and a
# with/do block forwards return position into its own final statement. False
# when the statement is not a tail-value shape (the caller emits it normally).
emitTailStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    match (
        n
    ) case statementline then {
        return (emitTailStmt
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.statementline.u64)
            :ind
            :tmp
            :buf
        )
    } case expression then {
        return (emitTailStmt
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.expression.u64)
            :ind
            :tmp
            :buf
        )
    } case atomid then {
        if n.name.u32 == zast.names.wkReturn then return false
        if n.name.u32 == zast.names.wkBreak then return false
        if n.name.u32 == zast.names.wkContinue then return false
        if (zast.nameTextEq :ast ref: n.name s: "null") then return false
        emitReturnOfNode :ast :symtab :ctx vid: n.nodeid :ind :tmp :buf
        return true
    } case binop then {
        emitReturnOfNode :ast :symtab :ctx vid: n.nodeid :ind :tmp :buf
        return true
    } case atomstring then {
        emitReturnOfNode :ast :symtab :ctx vid: n.nodeid :ind :tmp :buf
        return true
    } case withexpr then {
        # an owned copy: the with-binding's emission below lends ast
        wnmR8: zast.nameTextAt :ast ref: n.name
        wnmT: varCName :ctx vid: (defVid :symtab nid: n.nodeid.u64) name: wnmR8.stringView
        wsidT: stampIdDeep :ast :symtab n: (ast.nodes.get i: n.value.u64)
        wctT: String
        if (originTidOf :symtab tid: (ztypes.tid.create from: wsidT.u64)) > 0 then {
            wctT = (typeRefC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: wsidT.u64)
                thisTid: ztypes.tid
            )
        } else {
            wtnT: stampNameDeep :ast :symtab n: (ast.nodes.get i: n.value.u64)
            wctT = cTypeForName :ast :symtab :ctx name: wtnT.stringView
        }
        wvT: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.value.u64)
        # a reference-returning callee hands back `T*`, so a `with` binding
        # ALIASES its source exactly as a plain binding does
        {
            wrbT: refBorrowCalleeFid :ast :symtab :ctx n: (ast.nodes.get i: n.value.u64)
            if wrbT > 0 when (fnReturnsRefBorrow
                :ast
                :symtab
                :ctx
                fid: (ztypes.tid.create from: wrbT.u64)
                retTid: (ztypes.tid.create from: wsidT.u64)
            ) then {
                wctT = "\{wctT}*"
                ctx.ptrVids.append (defVid :symtab nid: n.nodeid.u64)
            }
        }
        if wctT.length > 0 then {
            lwT: "\{ind}\{wctT} \{wnmT} = \{wvT};\n"
            buf.append lwT
        } else {
            lwT8: "\{ind}int64_t \{wnmT} = \{wvT};\n"
            buf.append lwT8
        }
        ctx.tailRetActive = true
        emitBodyNode :ast :symtab :ctx n: (ast.nodes.get i: n.body.u64) :ind :tmp :buf
        return true
    } case doexpr then {
        dstT: ast.nodes.get i: n.statement.u64
        if (ztypecheck.blockHasBreak :ast n: dstT) then return false
        ctx.tailRetActive = true
        emitBodyNode :ast :symtab :ctx n: dstT :ind :tmp :buf
        return true
    } else {
        return false
    }
}

# emitBranchAssign -- emit an if/match branch whose final value assigns
# to a target: a block emits all but its last statement normally, the
# last as `target = <value>`; a single node assigns directly.
emitBranchAssign: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: astnode.view
    target: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    match (
        n
    ) case statement then {
        cnt: n.statements.count.u64
        si: u64
        for si < cnt loop {
            sxId: zast.kidAt kids: ast.kids span: n.statements i: si
            sx: ast.nodes.get i: sxId.u64
            if si + 1 == cnt then {
                vx: emitExpr :ast :symtab :ctx n: sx
                la: "\{ind}\{target} = \{vx};\n"
                buf.append la
                emitValueTakeInvalidations :ast :symtab :ctx n: sx :ind :buf
            } else {
                emitStmt :ast :symtab :ctx n: sx :ind :tmp :buf
            }
            si = si + 1
        }
    } else {
        vx2: emitExpr :ast :symtab :ctx :n
        la2: "\{ind}\{target} = \{vx2};\n"
        buf.append la2
        emitValueTakeInvalidations :ast :symtab :ctx :n :ind :buf
    }
}

# postGuardStmtId -- the node id of a guarding if/match statement that
# recorded a post-guard narrowing; 0 otherwise.
postGuardStmtId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: astnode.view
} out u64 is {
    match (
        n
    ) case statementline then {
        return (postGuardStmtId :ast :symtab n: (ast.nodes.get i: n.statementline.u64))
    } case expression then {
        return (postGuardStmtId :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } case ifexpr then {
        po: symtab.typing.postGuardName.get key: n.nodeid.u64
        match (
            po
        ) case some then {
            return n.nodeid.u64
        } case none then {
            return 0
        }
    } case caseexpr then {
        po: symtab.typing.postGuardName.get key: n.nodeid.u64
        match (
            po
        ) case some then {
            return n.nodeid.u64
        } case none then {
            return 0
        }
    } else {
        return 0
    }
}

# emit one statement or expression node of a body.
emitBodyNode: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    match (
        n
    ) case statement then {
        trTail: ctx.tailRetActive
        ctx.tailRetActive = false
        pgN: List String
        pgVid: ListVal ztypes.vid
        pgPrevV: List String
        pgPrevT: ListVal u64
        pgDead: IdSet ztypes.vid
        i: u64
        nst: n.statements.count.u64
        for i < nst loop {
            s9Id: zast.kidAt kids: ast.kids span: n.statements :i
            s: ast.nodes.get i: s9Id.u64
            # a reassignment of a seeded name ends its post-guard alias
            ri: u64
            for ri < pgN.length loop {
                rn: pgN.get i: ri
                rnv0: pgVid.get i: ri
                if (pgDead.has item: rnv0) == false then {
                    if (bodyReassigns :ast n: s name: rn.stringView) then {
                        rv: pgPrevV.get i: ri
                        if rv.length > 0 then {
                            vvSet xs: ctx.narrowBox vid: rnv0 val: rv.stringView
                        } else {
                            vvRemove xs: ctx.narrowBox vid: rnv0
                        }
                        rt: pgPrevT.get i: ri
                        if rt > 0 then {
                            vtSet xs: ctx.narrowTid vid: rnv0 tid: (ztypes.tid.create from: rt.u64)
                        } else {
                            vtRemove xs: ctx.narrowTid vid: rnv0
                        }
                        pgDead.add item: rnv0
                    }
                }
                ri = ri + 1
            }
            tailNow: false
            if trTail when i + 1 == nst then tailNow = true
            handled: false
            if tailNow then {
                handled = emitTailStmt :ast :symtab :ctx n: s :ind :tmp :buf
            }
            if handled == false then emitStmt :ast :symtab :ctx n: s :ind :tmp :buf
            trunc: false
            if (stmtDiverges
                :ast
                :symtab
                :ctx
                sid: (zast.nodeid.create from: s9Id.u64)
            ) then trunc = true
            pgid: postGuardStmtId :ast :symtab n: s
            if pgid > 0 then {
                pgRawId: zast.nameid
                {
                    pgnO: symtab.typing.postGuardName.get key: pgid
                    match (
                        pgnO
                    ) case some then {
                        pgRawId = pgnO
                    } case none then null
                }
                pgRawN: zast.poolTextAt pool: ast.names ref: pgRawId
                # the alias text is emitted C, so the receiver has to be the
                # subject's identifier, and the narrowing tables below key on
                # the subject's variable
                pgRecv: String
                pgrv: (symtab.typing.postGuardVarId.get key: pgid).or d: (ztypes.vid.create from: 0)
                if pgrv > 0 when pgRawN.length > 0 then {
                    pgre: varCName :ctx vid: pgrv name: pgRawN.stringView
                    pgRecv = pgre
                }
                guardStampTid: ztypes.tid
                {
                    pgtO: symtab.typing.postGuardTid.get key: pgid
                    match (
                        pgtO
                    ) case some then {
                        guardStampTid = ztypes.tid.create from: pgtO
                    } case none then null
                }
                guardStampArmId: zast.nameid
                {
                    pgaO: symtab.typing.postGuardArm.get key: pgid
                    match (
                        pgaO
                    ) case some then {
                        guardStampArmId = pgaO
                    } case none then null
                }
                guardStampArm: zast.poolTextAt pool: ast.names ref: guardStampArmId
                {
                    if pgRawN.length > 0 when pgRecv.length > 0 when guardStampTid > 0 when (
                        guardStampArm.length > 0
                    ) then {
                        accessOp: ".".string
                        pgv: ((symtab.typing.postGuardVarId.get key: pgid).or
                            d: (ztypes.vid.create from: 0)
                        )
                        if (isPtrVid :ctx vid: pgv) then accessOp = "->".string
                        aliasText: (armAliasText
                            :ast
                            :symtab
                            :ctx
                            tid: (ztypes.tid.create from: guardStampTid.u64)
                            arm: guardStampArm.stringView
                            recv: pgRecv.stringView
                            acc: accessOp.stringView
                        )
                        if aliasText.length > 0 then {
                            pv: vvGet xs: ctx.narrowBox vid: pgrv
                            pgPrevV.append pv
                            ptv: ((vtGet
                                xs: ctx.narrowTid
                                vid: pgrv
                            ).or
                                d: (ztypes.tid.create from: 0)
                            )
                            pgPrevT.append ptv
                            vvSet xs: ctx.narrowBox vid: pgrv val: aliasText.stringView
                            pt: ((symtab.typing.declChildOf
                                pool: ast.names
                                parentTypeId: guardStampTid
                                name: guardStampArm.stringView
                            ).or
                                d: 0
                            )
                            (vtSet
                                xs: ctx.narrowTid
                                vid: pgrv
                                tid: (ztypes.tid.create from: pt.u64)
                            )
                            cmt: "\{ind}/* post-guard alias: \{pgRawN} => \{aliasText} */\n"
                            buf.append cmt
                            pgrn: pgRawN.copy
                            pgN.append pgrn
                            pgVid.append pgrv
                        }
                    }
                }
            }
            i = i + 1
            if trunc then i = nst
        }
        zi: pgN.length
        for zi > 0 loop {
            zi = zi - 1
            znv: pgVid.get i: zi
            if (pgDead.has item: znv) == false then {
                zv: pgPrevV.get i: zi
                if zv.length > 0 then {
                    vvSet xs: ctx.narrowBox vid: znv val: zv.stringView
                } else {
                    vvRemove xs: ctx.narrowBox vid: znv
                }
                zt: pgPrevT.get i: zi
                if zt > 0 then {
                    vtSet xs: ctx.narrowTid vid: znv tid: (ztypes.tid.create from: zt.u64)
                } else {
                    vtRemove xs: ctx.narrowTid vid: znv
                }
            }
        }
    } else {
        emitStmt :ast :symtab :ctx :n :ind :tmp :buf
    }
}

# forexprValue -- the value being bound is a for-loop (a list comprehension).
forexprValue: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case expression then {
        return (forexprValue :ast n: (ast.nodes.get i: n.expression.u64))
    } case forexpr then {
        return true
    } else {
        return false
    }
}

# emitComprehensionBody -- unwrap the body Option (borrowed via the param) and
# emit its statements, the last appended to the list.
emitComprehensionBody: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    body: astnode.view
    listCb: StringView
    listVar: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    emitComprehensionNode :ast :symtab :ctx n: body :listCb :listVar :ind :tmp :buf
}

# emitComprehensionNode -- the body's statements: each but the last emits
# normally; the last is the value expression, appended to the list.
emitComprehensionNode: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: astnode.view
    listCb: StringView
    listVar: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    match (
        n
    ) case statement then {
        cnt: n.statements.count.u64
        si: u64
        for si < cnt loop {
            stId: zast.kidAt kids: ast.kids span: n.statements i: si
            st: ast.nodes.get i: stId.u64
            if si == (cnt - 1) then {
                av: emitExpr :ast :symtab :ctx n: st
                la: "\{ind}\{listCb}_append(&\{listVar}, (\{av}));\n"
                buf.append la
            } else {
                emitStmt :ast :symtab :ctx n: st :ind :tmp :buf
            }
            si = si + 1
        }
    } else {
        av2: emitExpr :ast :symtab :ctx :n
        la2: "\{ind}\{listCb}_append(&\{listVar}, (\{av2}));\n"
        buf.append la2
    }
}

# emitListComprehension -- populate listVar from `for x: N.iterate loop { expr }`:
# a counted for-loop whose body appends the comprehension's value expression.
emitListComprehension: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    forNode: astnode.view
    listCb: StringView
    listVar: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    match (
        forNode
    ) case expression then {
        (emitListComprehension
            :ast
            :symtab
            :ctx
            forNode: (ast.nodes.get i: forNode.expression.u64)
            :listCb
            :listVar
            :ind
            :tmp
            :buf
        )
    } case forexpr then {
        if forNode.conditions.count.u64 != 1 then return
        c0Id: zast.kidAt kids: ast.kids span: forNode.conditions i: 0
        c0: ast.nodes.get i: c0Id.u64
        if c0.namedoperation then {
            lblR6: zast.nameTextAt :ast ref: c0.name
            lblV6: defVid :symtab nid: (interpPartNodeId n: (ast.nodes.get i: c0.operation.u64))
            lbl: varCName :ctx vid: lblV6 name: lblR6.stringView
            bound: rangeBoundExpr :ast :symtab :ctx n: (ast.nodes.get i: c0.operation.u64)
            from: rangeFromExpr :ast :symtab :ctx n: (ast.nodes.get i: c0.operation.u64)
            if bound.length == 0 then return
            fh: "\{ind}for (int64_t \{lbl} = \{from}; \{lbl} < \{bound}; \{lbl}++) {\n"
            buf.append fh
            ind2: "\{ind}    "
            (emitComprehensionBody
                :ast
                :symtab
                :ctx
                body: (ast.nodes.get i: forNode.body.u64)
                :listCb
                :listVar
                ind: ind2.stringView
                :tmp
                :buf
            )
            lcc: "\{ind}}\n"
            buf.append lcc
        }
    } else null
}


# fnReturnTypeId -- the stamped type id of a function's return-type node (the
# typecheck stamps `op.returntype`, even for concrete fns whose registry
# returnTypeId is unset). 0 when the fn has no return type.
fnReturnTypeId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    op: astnode.view
} out u64 is {
    match (
        op
    ) case functiondef then {
        rtId: op.returntype
        if rtId > 0 then {
            rt: ast.nodes.get i: rtId.u64
            return (stampIdOf :symtab nid: (interpPartNodeId n: rt))
        } else {
            return 0
        }
    } else {
        return 0
    }
}

# isUserGenericMonoTid -- a specialization of a non-native USER generic type, as
# opposed to a collection mono or a runtime-owned one. Every family whose method
# bodies this emitter writes qualifies: a record, a variant and a facet carry
# the same method surface as a class, only by value.
isUserGenericMonoTid: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    og4: genericOriginTid :symtab :tid
    if og4.isZero then return false
    if (isCollectionOriginTid :ctx originTid: og4) then return false
    if (symtab.reg.isNativeOf tid: og4) then return false
    ott: symtab.reg.typetypeOf typeId: og4
    if ott == ztypes.ztypetype.classType then return true
    if ott == ztypes.ztypetype.recordType then return true
    if ott == ztypes.ztypetype.variantType then return true
    if ott == ztypes.ztypetype.unionType then return true
    if ott == ztypes.ztypetype.facetType then return true
    return false
}

# isUserClassMonoTid -- the CLASS subset of the above. Its instances behave like
# ordinary classes -- pointer receivers -- which a valtype mono does not, so the
# by-reference parameter rule asks this one and the method emitter asks the
# family-wide one.
isUserClassMonoTid: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    if (isUserGenericMonoTid :symtab :ctx :tid) == false then return false
    ott4: symtab.reg.typetypeOf typeId: (genericOriginTid :symtab :tid)
    if ott4 == ztypes.ztypetype.classType then return true
    return false
}

# isReftypeParam -- a user reftype (class/union) param, passed BY REFERENCE: a
# function param that is a CLASS or UNION, not a collection mono (List/Map/Set),
# and not a value-native (String/StringView live in the system/collections
# units). Records/variants/facets (valtypes) and natives stay by value.
isReftypeParam: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
} out bool is {
    cid: tid
    duT: definedInUnitTid :symtab :tid
    isShell: duT.isZero
    if isShell then {
        rtn0: regNameOf :symtab :tid
        rrid0: canonTypeId :ast :symtab :ctx :tid name: rtn0.stringView
        if rrid0 > 0 then cid = ztypes.tid.create from: rrid0.u64
    }
    tt: symtab.reg.typetypeOf typeId: cid
    # Only CLASS params pass by reference. A UNION is a small value-stable
    # {tag, void* data} struct passed BY VALUE (the data pointer is shared with
    # the source; the borrow is tracked separately).
    if tt != ztypes.ztypetype.classType then return false
    monoLk4: originTidOf :symtab tid: cid
    if monoLk4 > 0 then {
        if (isUserClassMonoTid :symtab :ctx tid: cid) == false then return false
    }
    # the types with their own family rule answer through it, not the
    # user-class one: containers via isListPtrParam/isSetMapPtrParam, String
    # via isBorrowStringParam (pointer when non-owned), StringView by value (a
    # 16-byte fat pointer with no owned interior). Each is asked by what it IS
    # -- the two well-known ids, a typedef base, a runtime-owned layout -- and
    # the collection monos left above already. Asking which unit declared it
    # answered for a user class of the same name too, which no id does.
    if cid == ctx.strTid then return false
    if cid == ctx.svTid then return false
    if (isTypedefType :symtab tid: cid) then return false
    if (symtab.reg.isNativeOf tid: cid) then return false
    return true
}

# elemBorrowsByPtr -- a List/ListView element type whose `get` lowers to a
# POINTER into the element storage, honouring the declared `out of.borrow`.
# Mirrors the parameter-passing classification: user CLASSES and String carry
# heap fields and inline container headers, so a copy is NOT a borrow (a field
# write is dropped, and an append through an inline container field reallocs
# the copy's buffer and strands the stored element on a freed pointer). A
# UNION is a value-stable {tag, void* data} whose payload pointer is already
# shared, and a valtype has no interior -- for both, the copy IS the borrow.
elemBorrowsByPtr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
} out bool is {
    if tid.isZero then return false
    if tid == ctx.strTid then return true
    chasedStrTid: chaseStrTypedef :symtab :ctx :tid
    if chasedStrTid == ctx.strTid then return true
    return (isReftypeParam :ast :symtab :ctx :tid)
}

# elemRefByPtr -- a List/ListView element type whose MUTABLE reference is a
# pointer into the storage. Everything `elemBorrowsByPtr` covers, plus a
# COMPOUND valtype: a record or variant has children, and mutating them in
# place is exactly what `getMut` is for, so handing back a copy loses the
# write. It is deliberately NOT the same question as `elemBorrowsByPtr`, which
# also answers "what calling convention does this type use" for the declared
# hash/`==` dispatch, where a record is still passed BY VALUE.
elemRefByPtr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
} out bool is {
    if (elemBorrowsByPtr :ast :symtab :ctx :tid) then return true
    tt: symtab.reg.typetypeOf typeId: tid
    if tt == ztypes.ztypetype.recordType then return true
    return tt == ztypes.ztypetype.variantType
}

# listGetIsPtr -- the `get` of this List/ListView mono returns a pointer. False
# while the runtime templates still carry their own by-value `get` (the
# emitted C must agree with whichever compiler read the template), so the
# lowering flips atomically when `get` moves into emitColGet.
listGetIsPtr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    monoId: ztypes.tid
} out bool is {
    if ctx.colGetFromCode == false then return false
    return (elemBorrowsByPtr :ast :symtab :ctx tid: (listElemType :symtab :monoId))
}

# isBorrowStringParam -- a non-owned String param (BORROW/LOCK or VIEW), passed
# BY REFERENCE: String is 24 bytes with a heap interior, so a copy is never a
# borrow -- `.borrow` needs the pointer for mutation (append/reserve), `.view`
# for cost and so a view-projected String (StringView.asString) can alias one.
# A `.take` String param is moved by value instead. StringView stays BY VALUE
# for a stated reason: a 16-byte fat pointer with no owned interior -- two
# registers on SysV, and copying it carries nothing that can dangle.
isBorrowStringParam: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    fid: ztypes.tid
    pname: StringView
    pid: ztypes.tid
} out bool is {
    if pid != ctx.strTid then return false
    if (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.borrowMode
    ) then return true
    if (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.viewMode
    ) then return true
    return false
}

# isSetMapPtrParam -- a non-TAKE Set/Map param. Set/Map are heap pointers, so the
# param is passed BY POINTER (Set_t*) and its arg (a Set/Map local/field, also a
# pointer) is passed directly -- unlike a by-value List param which needs &.
isSetMapPtrParam: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    fid: ztypes.tid
    pname: StringView
    tid: ztypes.tid
} out bool is {
    if (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.takeMode
    ) then return false
    # the param's own origin (a typedef wrapper chases to its base mono)
    # against the cached Set/Map template ids
    bt: chaseColMono :symtab :ctx :tid
    if (isSetOriginOf :symtab :ctx tid: (ztypes.tid.create from: bt.u64)) then return true
    if (isMapOriginOf :symtab :ctx tid: (ztypes.tid.create from: bt.u64)) then return true
    return false
}

# isListPtrParam -- a non-TAKE List param (a value-struct collection) passes BY
# POINTER so the callee's append/pop/set persist to the caller. A `.take` List is
# moved by value; Set/Map monos are already heap pointers (no extra `*`).
isListPtrParam: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    fid: ztypes.tid
    pname: StringView
    tid: ztypes.tid
} out bool is {
    if (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.takeMode
    ) then return false
    bt: chaseColMono :symtab :ctx :tid
    if (isIdCollectionOriginOf :symtab :ctx tid: (ztypes.tid.create from: bt.u64)) then return true
    return (isListOriginOf :symtab :ctx tid: (ztypes.tid.create from: bt.u64))
}

# registerReftypeParams -- add a top-level function's reftype (class/union)
# params to ctx.ptrVids, so the body reads them as `param->field` and method
# calls pass them directly (they arrive as pointers). Caller resets ptrVids.
registerReftypeParams: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    fid: ztypes.tid
    op: astnode.view
} is {
    pIds: ListVal u64
    pNmIds: ListVal u64
    recFieldIds :symtab tid: fid ids: pIds nameIds: pNmIds
    ri: u64
    rn: pNmIds.length
    for ri < rn loop {
        rpid: pIds.get i: ri
        rpnB: (zast.poolTextAt
            pool: ast.names
            ref: (zast.nameid.create from: (pNmIds.get i: ri))
        )
        rpn: rpnB.stringView
        regp: (paramTypeIsPointer
            :ast
            :symtab
            :ctx
            :fid
            pname: rpn
            pid: (ztypes.tid.create from: rpid.u64)
        )
        if regp then {
            rvd: (paramVidByNameId
                :ast
                :symtab
                :op
                nameId: (zast.nameid.create from: (pNmIds.get i: ri))
            )
            ctx.ptrVids.append rvd
        }
        ri = ri + 1
    }
}

# paramIsReceiverName -- is `pname` the method's receiver slot? `this` for the
# `:this` shorthand, or the spelled name for `{a: this}`. The receiver is a
# pointer in BOTH families, so a call passing a value-typed one must address it.
# Call sites add this leg ALONE, never the whole definition-side predicate: a
# Map or Set argument is already a pointer and must not be addressed again.
paramIsReceiverName: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    fid: ztypes.tid
    pname: StringView
} out bool is {
    # by id, and only fall back to the spelling when the type records no
    # receiver name of its own -- `this` is the implicit one
    pid: zast.poolFind pool: ast.names text: pname
    if (symtab.reg.thisParamNameIs tid: fid nameId: pid) then return true
    if (symtab.reg.thisParamNameIdOf tid: fid).isZero then return (pid == zast.names.wkThis)
    return false
}

# calleeTakesReceiverByPtr -- does this method's FIRST parameter occupy the
# receiver slot? Only then does a call address the base. A valtype method whose
# first parameter is an ordinary one of the same type (`double: function
# {self: meters}`) still takes it by value.
calleeTakesReceiverByPtr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    fid: ztypes.tid
} out bool is {
    fpN: List String
    fpI: ListVal u64
    fpNm: ListVal u64
    recFieldLists :ast :symtab tid: fid names: fpN ids: fpI nameIds: fpNm
    if fpN.length == 0 then return false
    firstFieldName: fpN.get i: 0
    return (paramIsReceiverName :ast :symtab :fid pname: firstFieldName.stringView)
}

# markedValtypeRefParam -- an explicitly marked VALTYPE parameter, which is a
# REFERENCE: `.borrow` so a write through it reaches the caller (passed by
# value the write was silently LOST), `.view` so a large value is not copied.
# An UNMARKED valtype parameter stays a copy: the marker is how a reference is
# asked for, and that is what holds this to the declarations that opt in.
#
# NATIVES are excluded -- their C is hand-written and takes the value by value.
# `Map.get key: key.view`, `Set.delete item: of.view` and `List.contains
# item: of.view` monomorphise that marker onto a valtype key, and the runtime
# templates would stop matching their own prototypes.
markedValtypeRefParam: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    fid: ztypes.tid
    pname: StringView
    pid: u64
} out bool is {
    if (symtab.reg.isNativeOf tid: fid) then return false
    if (symtab.reg.isValtypeOf tid: (ztypes.tid.create from: pid.u64)) == false then return false
    if (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.viewMode
    ) then return true
    if (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.borrowMode
    ) then return true
    return false
}

# paramTypeIsPointer -- is a parameter's C type `T*`? A non-`take` user class
# passes by reference, and the stdlib families answer separately because
# isReftypeParam deliberately covers user classes only.
#
# This is the DEFINITION-side question. Whether a CALL must write `&arg` is a
# DIFFERENT one and has its own answer at each call site: a Map or Set local
# already holds a pointer (their create returns one), so taking its address
# would build a `T**`, while a List local is a value and does need the `&`.
paramTypeIsPointer: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    fid: ztypes.tid
    pname: StringView
    pid: ztypes.tid
} out bool is {
    isTake: (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.takeMode
    )
    isHold: (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.holdMode
    )
    # The receiver is a reference in BOTH families -- its default is `borrow`,
    # not `take`, so a record method acts on the caller's instance rather than
    # on a copy of it.
    if isTake == false when isHold == false then {
        if pname == "this" then return true
        rnid: zast.poolFind pool: ast.names text: pname
        if rnid > 0 then {
            if (symtab.reg.thisParamNameIs tid: fid nameId: rnid) then return true
        }
    }
    if isTake == false when isHold == false then {
        if (markedValtypeRefParam :ast :symtab :fid :pname :pid) then return true
    }
    if isTake == false when (isReftypeParam
        :ast
        :symtab
        :ctx
        tid: (ztypes.tid.create from: pid.u64)
    ) then return true
    if (isBorrowStringParam :ast :symtab :ctx :fid :pname :pid) then return true
    if (isListPtrParam
        :ast
        :symtab
        :ctx
        :fid
        :pname
        tid: (ztypes.tid.create from: pid.u64)
    ) then return true
    if (isSetMapPtrParam
        :ast
        :symtab
        :ctx
        :fid
        :pname
        tid: (ztypes.tid.create from: pid.u64)
    ) then return true
    return false
}

# fnSignature -- "RET cname(PARAMS)" for a user function from its
# resolved type's children and return stamp (z_main for main).
fnSignature: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    name: StringView
    fid: ztypes.tid
    op: astnode.view
} out String is {
    if name == "main" then return "void z_main(void)".string
    ret: "void".string
    rbn: ztypecheck.fnReturnBaseNameOf :ast :op
    if rbn.length > 0 then {
        rbc: cTypeOf name: rbn.stringView
        rtid0: fnReturnTypeId :ast :symtab :op
        if rtid0 == ctx.strTid then {
            rs0: "\{ctx.strC}_t"
            ret = rs0
        } else if rtid0 == ctx.svTid then {
            rs1: "\{ctx.svC}_t"
            ret = rs1
        } else if rbc.length > 0 then {
            if (
                (scalarTidIsBuiltin
                    :symtab
                    tid: (ztypes.tid.create from: rtid0.u64)
                ) ==
                false
            ) then {
                ret = (typeRefC
                    :ast
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: rtid0.u64)
                    thisTid: ztypes.tid
                )
            } else {
                ret = rbc
            }
        } else {
            rbi: userFnId :ast :symtab :ctx name: rbn.stringView
            # a SELF-TYPED return is spelled as the template, so the name
            # answers the template and its C type names a struct no instance
            # has. The clone's own return type carries the substitution; an id
            # compare against the by-name answer is what says it is that
            # template's instance rather than an unrelated type.
            rbm: fnReturnTidOf :symtab tid: fid
            if rbi > 0 when (
                (genericOriginTid
                    :symtab
                    tid: (ztypes.tid.create from: rbm.u64)
                ) ==
                rbi
            ) then rbi = ztypes.tid.create from: rbm.u64
            if rbi > 0 then {
                rr: typeRefC :ast :symtab :ctx tid: rbi thisTid: ztypes.tid
                if rr.length > 0 then ret = rr
            }
        }
    }
    {
        rto: fnReturnTidOf :symtab tid: fid
        if rto > 0 then {
            {
                rn: regNameOf :symtab tid: (ztypes.tid.create from: rto.u64)
                rc: cTypeOf name: rn.stringView
                if rc.length > 0 then {
                    if (
                        (scalarTidIsBuiltin
                            :symtab
                            tid: (ztypes.tid.create from: rto.u64)
                        ) ==
                        false
                    ) then {
                        ret = (typeRefC
                            :ast
                            :symtab
                            :ctx
                            tid: (ztypes.tid.create from: rto.u64)
                            thisTid: ztypes.tid
                        )
                    } else {
                        ret = rc
                    }
                } else {
                    # a non-scalar return the rbn block didn't resolve -- e.g. an
                    # optionval/resultval (or other) mono. Use typeRefC, which
                    # gives the mono's C type. Only when ret is still void, so a
                    # resolution from rbn above is never overridden.
                    if ret.stringView == "void" then {
                        rr2: (typeRefC
                            :ast
                            :symtab
                            :ctx
                            tid: (ztypes.tid.create from: rto.u64)
                            thisTid: ztypes.tid
                        )
                        if rr2.length > 0 then ret = rr2
                    }
                }
            }
        }
    }
    if ret.stringView == "void" then {
        rtnid: fnReturnTypeId :ast :symtab :op
        if rtnid > 0 then {
            rtr: (typeRefC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: rtnid.u64)
                thisTid: ztypes.tid
            )
            if rtr.length > 0 then ret = rtr
        }
    }
    if ret.stringView != "void" then {
        retColId: fnReturnTidOf :symtab tid: fid
        if retColId == 0 then retColId = fnReturnTypeId :ast :symtab :op
        if retColId > 0 when (isHeapPtrCollection
            :symtab
            :ctx
            tid: (ztypes.tid.create from: retColId.u64)
        ) then ret = "\{ret}*"
        if (fnReturnsRefBorrow
            :ast
            :symtab
            :ctx
            :fid
            retTid: (ztypes.tid.create from: retColId.u64)
        ) then ret = "\{ret}*"
    }
    params: String
    cIds: ListVal u64
    cNmIds: ListVal u64
    recFieldIds :symtab tid: fid ids: cIds nameIds: cNmIds
    pi: u64
    pn: cNmIds.length
    for pi < pn loop {
        pnmId: (zast.nameid.create from: (cNmIds.get i: pi))
        pnameB: zast.poolTextAt pool: ast.names ref: pnmId
        pname: pnameB.stringView
        pid: cIds.get i: pi
        ct: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: pid.u64) thisTid: ztypes.tid
        ptrp: (paramTypeIsPointer
            :ast
            :symtab
            :ctx
            :fid
            :pname
            pid: (ztypes.tid.create from: pid.u64)
        )
        if ptrp then {
            if ct.length > 0 then {
                ctp: "\{ct}*"
                ct = ctp
            }
        }
        if pi > 0 then params.append ", "
        if ct.length > 0 then {
            params.append ct
        } else {
            params.append "int64_t"
        }
        params.append " "
        pmnV: paramVidByNameId :ast :symtab :op nameId: pnmId
        pmnDecl: varCName :ctx vid: pmnV name: pname
        params.append pmnDecl
        pi = pi + 1
    }
    if pn == 0 then params.append "void"
    fc: ctxCname :ctx tid: fid
    sig: "\{ret} \{fc}(\{params})"
    return sig
}

# typedefChaseTid -- the chain-end base tid of a typedef (tid itself when it
# is not one). The equality, cast and key-classification legs ask this so a
# typedef behaves exactly as its base at the C level.
typedefChaseTid: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out ztypes.tid is {
    cur: tid
    for true loop {
        bo: symtab.typing.typedefBaseTid.get key: cur
        match (
            bo
        ) case some then {
            cur = ztypes.tid.create from: bo
        } case none then break
    }
    return (ztypes.tid.create from: cur)
}

# typedefChaseBaseName -- the chain-end base NAME of a typedef, "" when tid
# is not one.
typedefChaseBaseName: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out String is {
    cur: tid
    nmId: zast.nameid
    for true loop {
        bn: symtab.typing.typedefBaseName.get key: cur
        match (
            bn
        ) case some then {
            nmId = bn
        } case none then null
        bo: symtab.typing.typedefBaseTid.get key: cur
        match (
            bo
        ) case some then {
            cur = ztypes.tid.create from: bo
        } case none then break
    }
    nm: String
    if nmId.isZero == false then nm = zast.poolTextCopy pool: ast.names ref: nmId
    return nm
}

# typedefChaseC -- the underlying C scalar of a typedef record, chasing
# the typedef-base chain (meters -> i64, height -> meters -> i64); ""
# when the type is not a typedef.
typedefChaseC: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
} out String is {
    boId: zast.nameid
    hitB: false
    {
        bo: symtab.typing.typedefBaseName.get key: tid
        match (
            bo
        ) case some then {
            hitB = true
            boId = bo
        } case none then null
    }
    if hitB then {
        bnX: zast.poolTextAt pool: ast.names ref: boId
        bc: cTypeOf name: bnX.stringView
        if bc.length > 0 then return bc
        bid: userFnId :ast :symtab :ctx name: bnX.stringView
        if bid > 0 then return (typeRefC :ast :symtab :ctx tid: bid thisTid: ztypes.tid)
        pmsg8: "zemitterc: unresolvable typedef base \{bnX} for id \{tid}"
        panic pmsg8
    }
    return "".string
}

# isTypedefType -- the type id carries a typedef base.
isTypedefType: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    return (symtab.typing.typedefBaseName.has key: tid)
}

# isBoxTid -- the type is a builtin Box mono (heap pointer), as flagged by the
# typechecker (isBox). Distinguishes the builtin Box from a user class also
# named Box (e.g. linkedlist's generic Box).
isBoxTid: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    return (symtab.reg.isBoxOf :tid)
}

# nodeIsAtomBox -- n is a bare atom whose type is a builtin Box (a heap pointer),
# so an arithmetic/compare operand must auto-deref (`b` -> `(*b)`).
nodeIsAtomBox: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case expression then {
        return (nodeIsAtomBox :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        bxt: stampIdOf :symtab nid: n.nodeid.u64
        return (isBoxTid :symtab tid: bxt)
    } else {
        return false
    }
}

# originFamilyOf -- the origins table read backwards: which ogXxx family an
# ORIGIN tid names, or ogNone. Zero is no family -- a builtin the program never
# registers leaves its row 0, and matching that would make every origin-less
# type a List.
originFamilyOf: function {ctx: Ctx.view originTid: ztypes.tid} out u64 is {
    if originTid.isZero then return ogNone
    i: u64
    for i < ogNone loop {
        if originTid == (ctx.origins.get :i) then return i
        i = i + 1
    }
    return ogNone
}

# monoFamilyOf -- the family a MONO was minted from, or ogNone. Every predicate
# below asks exactly this and differs only in which answers it accepts.
monoFamilyOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out u64 is {
    ot: originTidOf :symtab :tid
    return (originFamilyOf :ctx originTid: ot)
}

# isListOriginOf -- the type is a List of EITHER family. The two templates
# differ in what they DECLARE (a valtype element copies out, a reftype element
# hands back a view) and not at all in the C the emitter builds from them, so
# every site that just means "is this a List" asks this rather than naming one.
isListOriginOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :symtab :ctx :tid
    if f == ogList then return true
    return f == ogListVal
}

# isSetOriginOf -- the type is a Set of EITHER family. The two templates differ
# in what they DECLARE (a valtype element is passed and returned by value, a
# reftype element is taken and viewed) and not at all in the C the emitter
# builds from them, so every site that just means "is this a Set" asks this
# rather than naming one.
isSetOriginOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :symtab :ctx :tid
    if f == ogSet then return true
    return f == ogSetVal
}

# isMapOriginOf -- the type is a Map of ANY of the four key/value families.
isMapOriginOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :symtab :ctx :tid
    if f == ogMap then return true
    if f == ogMapRV then return true
    if f == ogMapVR then return true
    return f == ogMapVV
}

# isIdMapOriginOf -- the type is an IdMap of either value family.
isIdMapOriginOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :symtab :ctx :tid
    if f == ogIdMapR then return true
    return f == ogIdMapV
}

# isIdSetOriginOf -- the type is an IdSet.
isIdSetOriginOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :symtab :ctx :tid
    return f == ogIdSet
}

# isIdCollectionOriginOf -- the type is an IdMap or an IdSet: the id-keyed
# containers, which share a representation the general ones do not.
isIdCollectionOriginOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :symtab :ctx :tid
    if f == ogIdMapR then return true
    if f == ogIdMapV then return true
    return f == ogIdSet
}

# isListViewOriginOf -- the type is a ListView of either element family.
isListViewOriginOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :symtab :ctx :tid
    if f == ogListView then return true
    return f == ogListViewVal
}

# isMapEntryOriginOf -- the type is a MapEntry of any of the four families.
isMapEntryOriginOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :symtab :ctx :tid
    if f == ogMapEntry then return true
    if f == ogMapEntryRV then return true
    if f == ogMapEntryVR then return true
    return f == ogMapEntryVV
}

# isIdMapEntryOriginOf -- the type is an IdMapEntry of either value family.
isIdMapEntryOriginOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :symtab :ctx :tid
    if f == ogIdMapEntryR then return true
    return f == ogIdMapEntryV
}

# isCollectionOriginTid -- originTid (a genericOriginId) is one of the cached
# collection/iterator origins, i.e. a template that mints a C struct type
# (List/ListView/Set/Map/MapEntry and the iterators).
#
# The table has three zones and this is the MIDDLE one: ogStr and ogArray
# precede it, the option/result families follow it. Moving a row across either
# bound changes what counts as a collection, silently -- which is why the two
# bounds are named here rather than a membership list being written out again.
isCollectionOriginTid: function {ctx: Ctx.view originTid: ztypes.tid} out bool is {
    f: originFamilyOf :ctx :originTid
    if f == ogNone then return false
    if f < ogList then return false
    return f < ogOption
}

# cTypeForNameTid -- like cTypeForName, for a site that holds the tid: a
# native scalar (the declaration's marker) or a shell spells by name, as
# cTypeOf does; everything else -- a user type shadowing a scalar, a mono, a
# stdlib class -- spells from its id. For collection-mono VAL_T/KEY_T/ELEM_T
# where the element/key/value tid is known.
cTypeForNameTid: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    name: StringView
    tid: ztypes.tid
} out String is {
    if (scalarTidIsBuiltin :symtab :tid) then return (cTypeForName :ast :symtab :ctx :name)
    return (typeRefC :ast :symtab :ctx :tid thisTid: ztypes.tid)
}

# cTypeForName -- the C type for a type NAME: scalar via cTypeOf, else
# resolve the type id (across units) and use typeRefC; "" when unknown.
cTypeForName: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    name: StringView
} out String is {
    sc: cTypeOf :name
    if sc.length > 0 then return sc
    to: (ztypecheck.walkLookupTyperefRo
        frame: ztypes.declid
        :ast
        st: symtab
        unitDecl: ctx.mainUnitId
        base: name
    )
    match (
        to
    ) case some then {
        return (typeRefC
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: to.u64)
            thisTid: ztypes.tid
        )
    } case none then {
        # cross-unit: a dep-unit type (e.g. ztypes.zownership used as a ztyping
        # Map value) is outside walkLookupTyperef's search list; resolve via
        # the registry-wide cross-unit scan.
        xid: resolveTypeIdByName :ast :symtab :ctx :name
        if xid > 0 then return (typeRefC
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: xid.u64)
            thisTid: ztypes.tid
        )
        return "".string
    }
}

# chaseColMono -- if tid is a typedef-class over a collection mono (Bytes ->
# List_u8, ByteView -> ListView_u8), the underlying mono id; else tid. The
# emitter treats Bytes/ByteView as zero-overhead aliases of their collection.
chaseColMono: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out ztypes.tid is {
    bo: symtab.typing.typedefBaseTid.get key: tid
    match (
        bo
    ) case some then {
        if (isCollectionOriginTid
            :ctx
            originTid: (originTidOf :symtab tid: (ztypes.tid.create from: bo.u64))
        ) then return (ztypes.tid.create from: bo.u64)
    } case none then null
    return tid
}

# chaseStrTypedef -- a class typedef over String/StringView (Path, PathView)
# canonicalizes to the base tid: the wrapper shares the base's struct,
# methods, and cleanup. Single-level chase (stdlib typedefs are one level).
chaseStrTypedef: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out ztypes.tid is {
    bo: symtab.typing.typedefBaseTid.get key: tid
    match (
        bo
    ) case some then {
        if bo == ctx.strTid then return ctx.strTid
        if bo == ctx.svTid then return ctx.svTid
    } case none then null
    return tid
}

# typeRefC -- the C spelling for a type id: scalars by name, records by
# their id-based cname ("" when unsupported).
typeRefC: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
    thisTid: ztypes.tid
} out String is {
    # canonicalize shells: a param/field child may be a fresh shell id
    # named after the real type; this-typed params take the receiver.
    cid: tid
    # the name is compared twice and kept by nobody, so it is borrowed. The
    # binding is scoped: the pin must not outlive the two questions it answers
    {
        tn: regNameView :symtab :tid
        # A user type shadowing a builtin scalar carries the scalar NAME but not
        # the `is native` declaration -- emit its struct, not the C scalar.
        # scalarCTypeFor is that gate, and the sixteen scalars, `bool` and the
        # shells all come back through it with their C type intact.
        ct: scalarCTypeFor :symtab name: tn :tid
        if ct.length > 0 then return ct
        if tn == "this" when thisTid > 0 then cid = thisTid
    }
    cmid: chaseColMono :symtab :ctx tid: cid
    if cmid != cid then {
        cmc: ctxCname :ctx tid: (ztypes.tid.create from: cmid.u64)
        return "\{cmc}_t"
    }
    cid = ztypes.tid.create from: (chaseStrTypedef :symtab :ctx tid: cid)
    tdc: typedefChaseC :ast :symtab :ctx tid: cid
    if tdc.length > 0 then return tdc
    if cid == ctx.strTid then {
        ts0: "\{ctx.strC}_t"
        return ts0
    }
    if cid == ctx.svTid then {
        ts1: "\{ctx.svC}_t"
        return ts1
    }
    if (isBoxTid :symtab tid: cid) then {
        bxmn: regNameOf :symtab tid: cid
        bxen: monoElemName full: bxmn prefixLen: 4
        bxeid: resolveTypeIdByName :ast :symtab :ctx name: bxen.stringView
        bxinner: (typeRefC
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: bxeid.u64)
            thisTid: ztypes.tid
        )
        return "\{bxinner}*"
    }
    if (isCollectionOriginTid :ctx originTid: (originTidOf :symtab tid: cid)) then {
        cc: ctxCname :ctx tid: cid
        cTypeText: "\{cc}_t"
        return cTypeText
    }
    if (originIsTid :symtab tid: cid originTid: (ctx.origins.get i: ogArray)) then {
        aca: ctxCname :ctx tid: cid
        act: "\{aca}_t"
        return act
    }
    ctt: symtab.reg.typetypeOf typeId: cid
    if ctt == ztypes.ztypetype.recordType then {
        rc: ctxCname :ctx tid: cid
        rt: "\{rc}_t"
        return rt
    }
    if ctt == ztypes.ztypetype.variantType then {
        rc2: ctxCname :ctx tid: cid
        rt8: "\{rc2}_t"
        return rt8
    }
    if ctt == ztypes.ztypetype.classType then {
        rc3: ctxCname :ctx tid: cid
        rt7: "\{rc3}_t"
        return rt7
    }
    if ctt == ztypes.ztypetype.unionType then {
        rc4: ctxCname :ctx tid: cid
        rt6: "\{rc4}_t"
        return rt6
    }
    if ctt == ztypes.ztypetype.protocolType then {
        rc5: ctxCname :ctx tid: cid
        rt5: "\{rc5}_t"
        return rt5
    }
    if ctt == ztypes.ztypetype.facetType then {
        rc55: ctxCname :ctx tid: cid
        rt55: "\{rc55}_t"
        return rt55
    }
    if ctt == ztypes.ztypetype.functionType then {
        rcf: ctxCname :ctx tid: cid
        rtf: "\{rcf}_ft"
        return rtf
    }
    return "".string
}

# variantArmIds -- variantArms without the names: the arm payload ids and name
# ids, for the callers that never spell an arm.
variantArmIds: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
    ids: ListVal u64
    nameIds: ListVal u64
} is {
    otvi1: tid
    vi1: u64
    vn1: symtab.typing.declRowSlots ownerTid: otvi1
    for vi1 < vn1 loop {
        rwvi1: symtab.typing.declRowAt ownerTid: otvi1 membersOnly: true slot: vi1
        vi1 = vi1 + 1
        if rwvi1.keep then {
            vnid1: rwvi1.name
            vtid1: rwvi1.tid
            if (
                (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: vtid1.u64)) !=
                ztypes.ztypetype.functionType
            ) then {
                if vnid1 != zast.names.wkTag.u64 then {
                    cid0: vtid1
                    ids.append cid0
                    nid0: vnid1
                    nameIds.append nid0
                }
            }
        }
    }
}

# variantArms -- a variant's arm names and payload ids in order
# (non-FUNCTION children, the tag child excluded).
variantArms: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
    names: List String
    ids: ListVal u64
    nameIds: ListVal u64
} is {
    variantArmIds :symtab :tid :ids :nameIds
    ai0: u64
    an0: nameIds.length
    for ai0 < an0 loop {
        anx: nameIds.get i: ai0
        cnBv: ast.names.texts.get i: anx
        cnv: cnBv.copy
        names.append cnv
        ai0 = ai0 + 1
    }
}

# variantTag -- the C tag constant for an arm.
variantTag: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
    arm: StringView
} out String is {
    vn: regNameView :symtab :tid
    vu: cUpperOf text: vn
    au: cUpperOf text: arm
    t: "Z_\{vu}_TAG_\{au}"
    return t
}

# armValueC -- a no-payload arm's VALUE when the tagged type's C form is a
# SCALAR: `bool` lowers to C `bool`, not to a tag struct, so the struct literal
# every caller composes is invalid there. The tag enum is emitted for such
# types and its constants are the arm ordinals, so the value is the constant
# cast to that C form. Returns "" when the type carries a real tag struct --
# callers keep composing it, byte for byte.
armValueC: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
    arm: StringView
} out String is {
    avs: ordinalVariantCType :symtab :tid
    if avs.length == 0 then return "".string
    avt: variantTag :symtab :tid :arm
    avr: "((\{avs})\{avt})"
    return avr
}

# armPayloadC -- an arm's payload C type ("" for null arms).
armPayloadC: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
    arm: StringView
} out String is {
    co: symtab.typing.declChildOf pool: ast.names parentTypeId: tid name: arm
    match (
        co
    ) case some then {
        pn: regNameView :symtab tid: (ztypes.tid.create from: co.u64)
        if pn == "null" then return "".string
        return (typeRefC
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: co.u64)
            thisTid: ztypes.tid
        )
    } case none then {
        return "".string
    }
}

# recFieldIds -- recFieldLists without the names: the same fields, for the
# callers that walk the type ids and the name ids and never spell a field.
recFieldIds: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
    ids: ListVal u64
    nameIds: ListVal u64
} is {
    (ztypecheck.dataFieldIds
        st: symtab
        tid: (ztypes.tid.create from: tid.u64)
        :ids
        :nameIds
    )
}

# recFieldLists -- a record type's field names and type ids in order
# (non-FUNCTION children, conformance markers excluded). The filter lives in
# ztypecheck: the C struct layout the emitter lays down and the data-field
# list the checker validates against must agree field for field.
recFieldLists: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
    names: List String
    ids: ListVal u64
    nameIds: ListVal u64
} is {
    (ztypecheck.dataFieldNames
        :ast
        st: symtab
        tid: (ztypes.tid.create from: tid.u64)
        :names
        :ids
        :nameIds
    )
}

# regNameIs -- compare a type's registry name without materializing it
# (borrowed typeById view, StringView compare). The none arm mirrors
# comparing against the empty string.
regNameIs: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid name: StringView} out bool is {
    return (symtab.reg.nameIs :tid :name)
}

# unitClassTid -- the CLASS a unit declares under `nameId`, asked of THAT
# unit's own declarations. Exactly one name is in scope inside a unit, so this
# is a lookup and not a search. 0 when the unit declares no such class.
unitClassTid: function {
    symtab: zenv.ZSymbolTable.view
    unitDecl: u64
    nameId: zast.nameid
} out ztypes.tid is {
    z: ztypes.tid
    if unitDecl == 0 then return z
    d: (symtab.typing.declFindChild
        parentDeclId: (ztypes.declid.create from: unitDecl)
        :nameId
    )
    if d.isZero then return z
    t: ztypecheck.declTypeIdOf st: symtab declId: d
    if t.isZero then return z
    if (symtab.reg.typetypeOf typeId: t) != ztypes.ztypetype.classType then return z
    return t
}

# unitDeclByName -- the file unit spelled `name`, asked of the ENVIRONMENT:
# the program root's own children, which IS the list of units in scope. A name
# reaches this only from a source literal, a unit segment loadNativeTbl parsed
# out of a natives.tbl path, or the main-unit binding -- identity itself
# travels as a declid. Answering from the declaration tree rather than a side
# index means there is nothing to go stale and nothing silently overwritten
# when two files declare the same unit name.
unitDeclByName: function {
    symtab: zenv.ZSymbolTable.view
    ast: Ast.view
    name: StringView
} out ztypes.declid is {
    return (ztypecheck.unitDeclOfName st: symtab nameId: (zast.poolFind pool: ast.names text: name))
}

# defUnitIdOf -- the DECLARATION of the unit that defines tid (0 when none).
defUnitIdOf: function {ctx: Ctx.view tid: ztypes.tid} out u64 is {
    g: ctx.defUnitId.get key: tid
    match (
        g
    ) case some then {
        return g
    } case none then {
        return 0
    }
}

# a type's registry name as an owned String ("" when absent). The zerolang
# name, not the C one: the C type comes from feeding it through
# scalarCTypeFor / cTypeForNameTid.
regNameOf: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out String is {
    return (symtab.reg.nameOf tid: (ztypes.tid.create from: tid.u64))
}

# regNameView -- the type's written name BORROWED rather than copied, for a
# reader that only compares it or hands it straight to another call. The view
# pins the registry for its binding's scope; `symtab` is already a view
# everywhere in the emitter, so a shared pin sits beside the ones already held.
regNameView: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} outx StringView is {
    return (symtab.reg.nameViewOf tid: (ztypes.tid.create from: tid.u64))
}

# pathUnitTidOf -- the type id of the unit a dotted path's BASE names, or 0
# when the base names no unit. A file unit answers from the unit-name index; a
# nested namespace is deliberately absent from it, so it is found as a member
# of the unit being emitted, and `outer.inner` by walking that chain by id.
pathUnitTidOf: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    baseId: u32
} out ztypes.tid is {
    if baseId == 0 then return ztypes.tid
    b: ast.nodes.get i: baseId.u64
    match (
        b
    ) case expression then {
        return (pathUnitTidOf :ast :symtab :ctx baseId: b.expression)
    } case atomid then {
        # the enclosing unit answers first -- a name written inside a namespace
        # resolves against that namespace before anything wider, and a user
        # unit may shadow a top-level name
        encl: ctx.nsTid
        if encl.isZero then encl = unitTidOf :ast :symtab unitName: ctx.mainName.stringView
        # the nested frames, innermost outward: a path base written inside a
        # unit names that unit's children first, then those of each unit
        # enclosing it -- which is how a sibling inline unit is reached.
        pCur: ztypecheck.declOfTypeId st: symtab tid: encl
        for pCur > 0 loop {
            pFt: ztypecheck.declTypeIdOf st: symtab declId: pCur
            if pFt.isZero == false then {
                ph: unitChildTidOf :symtab parentTid: pFt nameId: b.name
                if ph.isZero == false then return ph
            }
            pNx: ztypecheck.declParentIdOf st: symtab declId: pCur
            pCur = ztypes.declid
            if pNx.isZero == false then {
                if (ztypecheck.declDeclaresUnit
                    st: symtab
                    :ast
                    declId: pNx
                ) then pCur = pNx
            }
        }
        ht: unitChildTidOf :symtab parentTid: encl nameId: b.name
        if ht.isZero == false then return ht
        uo: (ztypecheck.declTypeIdOf
            st: symtab
            declId: (symtab.typing.declFindChild
                parentDeclId: symtab.typing.programRoot
                nameId: b.name
            )
        )
        if uo.isZero == false then return (ztypes.tid.create from: uo)
        return ztypes.tid
    } case dottedpath then {
        pt: pathUnitTidOf :ast :symtab :ctx baseId: b.parent
        if pt.isZero then return ztypes.tid
        cn: zast.nameid
        {
            ca: ast.nodes.get i: b.child.u64
            if ca.atomid then cn = ca.name
        }
        return (unitChildTidOf :symtab parentTid: pt nameId: cn)
    } else {
        return ztypes.tid
    }
}

# unitChildTidOf -- the id of a member of `parentTid` when that member is
# itself a UNIT, else 0. Both legs of the path walk above ask exactly this, of
# the enclosing unit and of the segment before them.
unitChildTidOf: function {
    symtab: zenv.ZSymbolTable.view
    parentTid: ztypes.tid
    nameId: zast.nameid
} out ztypes.tid is {
    if nameId.isZero then return ztypes.tid
    co: symtab.typing.declChildOfId parentTypeId: parentTid :nameId
    match (
        co
    ) case some then {
        cTypeText: ztypes.tid.create from: co.u64
        if (
            (symtab.reg.typetypeOf typeId: cTypeText) == ztypes.ztypetype.unitType
        ) then return cTypeText
    } case none then null
    return ztypes.tid
}

# unitConstTextOf -- the rendered C text of a `unit.CONST` dotted path, or ""
# when the path names no constant of a known unit. Emission, the constant-shape
# test and the integer fold all ask this one question: a constant that folds
# under a bare name has to fold under this spelling too, and the difference was
# the spelling alone -- the same unit's own constant did not fold either.
unitConstTextOf: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: zast.dottedpathrow.view
} out String is {
    cn8: zast.nameid
    {
        ca8: ast.nodes.get i: n.child.u64
        if ca8.atomid then cn8 = ca8.name
    }
    if cn8 > 0 then {
        utd8: pathUnitTidOf :ast :symtab :ctx baseId: n.parent
        if utd8.isZero == false then {
            # the VALUE is the only source: a constant is never rendered to
            # text ahead of time and re-read.
            mct8: (memberConstText
                :ast
                :symtab
                :ctx
                unitTid: utd8
                nameId: cn8
            )
            if mct8.length > 0 then return mct8
            mcs8: memberConstStringText :symtab :ctx unitTid: utd8 nameId: cn8
            if mcs8.length > 0 then return mcs8
            # a constant the unit's `public:` block DEFINES is on the unit's
            # surface, keyed on the block (a nested unit named `public`)
            pbd8: ztypecheck.publicNsOf st: symtab tid: utd8
            pbt8: ztypecheck.declTypeIdOf st: symtab declId: pbd8
            if pbt8.isZero == false then {
                mcp8: (memberConstText
                    :ast
                    :symtab
                    :ctx
                    unitTid: pbt8
                    nameId: cn8
                )
                if mcp8.length > 0 then return mcp8
                mcq8: memberConstStringText :symtab :ctx unitTid: pbt8 nameId: cn8
                if mcq8.length > 0 then return mcq8
            }
        }
    }
    return "".string
}

# checkLoadedNatives -- drive checkNativesResolve over EVERY loaded unit. This
# rode inside fillMethodReturns until that table turned out to be unreadable;
# the CHECK was never part of the table's job and stays.
#
# The unit's own name is read PER UNIT and not hoisted, because it builds the
# lookup key. Hoisting it -- which is what the main-unit filter left behind --
# resolves every unit's natives under the main unit's name, so every row misses
# and every declaration in the program reads as unimplemented at once.
checkLoadedNatives: function {program: Ast.view ctx: Ctx} is {
    {
        uCnt9c: program.units.length
        uIdx9c: u64
        for uIdx9c < uCnt9c loop {
            uId: (zast.nodeid.create from: (program.units.get i: uIdx9c))
            uIdx9c = uIdx9c + 1
            opId: zast.nodeid
            unitName: String
            {
                u: program.nodes.get i: uId.u64
                if u.namedoperation then {
                    un: zast.poolTextAt pool: program.names ref: u.name
                    opId = u.operation
                    unitName = un.copy
                }
            }
            if opId > 0 then {
                (checkNativesResolve
                    ast: program
                    :ctx
                    unitOpId: opId
                    unitName: unitName.stringView
                )
            }
        }
    }
}

# checkNativeMembers -- the `is native` members of one of a type's two blocks
# must each name a row. Split out because both blocks are read and the walk is
# the same for either.
checkNativeMembers: function {
    ast: Ast.view
    ctx: Ctx
    items: zast.kidspan
    unitName: StringView
    typeName: StringView
} is {
    h7x9: u64
    for h7x9 < items.count.u64 loop {
        am: zast.kidAt kids: ast.kids span: items i: h7x9
        h7x9 = h7x9 + 1
        amn: ast.nodes.get i: am.u64
        if amn.namedoperation then {
            mn: zast.nameTextAt :ast ref: amn.name
            mo: ast.nodes.get i: amn.operation.u64
            if mo.functiondef then {
                if mo.isNative then {
                    mk: "\{unitName}.\{typeName}.\{mn}"
                    if (nativeHasRow :ctx path: mk.stringView) == false then {
                        (emitFail
                            :ctx
                            what: "no native implementation for '\{mk}'"
                            line: mo.lineno
                        )
                    }
                }
            }
        }
    }
}

# checkNativesResolve -- every `is native` declaration in a loaded unit must
# name a row in natives.tbl. `is native` says the compiler supplies the body, and
# this is where that claim is checked: at the declaration, whether or not anyone
# calls it. Without it an uncalled one is accepted in silence and a called one
# is only found at the call, as an emitter gap rather than as the missing
# implementation it is.
#
# EVERY loaded unit, not only the program's own. A program that loads
# collections.z sees its native declarations exactly as it sees the ones it
# wrote, so a standard library with a hole in it breaks the build that USES it
# and not only the build that ships it.
checkNativesResolve: function {
    ast: Ast.view
    ctx: Ctx
    unitOpId: zast.nodeid
    unitName: StringView
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitOpId
    vx239: u64
    for vx239 < bodyIds.count.u64 loop {
        bm: zast.kidAt kids: ast.kids span: bodyIds i: vx239
        vx239 = vx239 + 1
        bn: ast.nodes.get i: bm.u64
        if bn.namedoperation then {
            nm: zast.nameTextAt :ast ref: bn.name
            op: ast.nodes.get i: bn.operation.u64
            match (
                op
            ) case functiondef then {
                if op.isNative then {
                    pk: "\{unitName}.\{nm}"
                    if (nativeHasRow :ctx path: pk.stringView) == false then {
                        (emitFail
                            :ctx
                            what: "no native implementation for '\{pk}'"
                            line: op.lineno
                        )
                    }
                }
            } case objectdef then {
                # BOTH blocks. A native method may be written in either, and
                # which one carries it is a fact about the type rather than
                # about the method: the containers declare theirs in `as`,
                # io.File declares its five in the class body and keeps `as`
                # for the protocols it conforms to. Reading only `as` left
                # File.read and its four siblings checked by nothing.
                (checkNativeMembers
                    :ast
                    :ctx
                    items: op.isItems
                    :unitName
                    typeName: nm.stringView
                )
                (checkNativeMembers
                    :ast
                    :ctx
                    items: op.asItems
                    :unitName
                    typeName: nm.stringView
                )
            } case unitdef then {
                # a SUBUNIT -- lib/system/system/wideint.z and its siblings are
                # this shape. Its declarations are not in the program's unit
                # table, so nothing above reaches them, and they are keyed under
                # the PARENT unit's name: i128's operators are `system.i128.+`,
                # declared in wideint.z. So the name does NOT change on the way
                # down, and the path a call site builds is the path checked here.
                (checkNativesResolve
                    :ast
                    :ctx
                    unitOpId: bn.operation
                    :unitName
                )
            } else null
        }
    }
}

# fill the data-element cache for the whole program, once, before anything
# reads it
fillDataElems: function {program: Ast.view symtab: zenv.ZSymbolTable.view ctx: Ctx} is {
    {
        uCnt9a: program.units.length
        uIdx9a: u64
        for uIdx9a < uCnt9a loop {
            uId: (zast.nodeid.create from: (program.units.get i: uIdx9a))
            uIdx9a = uIdx9a + 1
            opId: zast.nodeid
            {
                u: program.nodes.get i: uId.u64
                if u.namedoperation then opId = u.operation
            }
            if opId > 0 then {
                (fillDataElemsIn
                    :symtab
                    :ctx
                    ast: program
                    mainOpId: opId
                )
            }
        }
    }
}

# populate a data block's element table.
fillDataElemsIn: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    ast: Ast.view
    mainOpId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: mainOpId
    vx249: u64
    for vx249 < bodyIds.count.u64 loop {
        bm: zast.kidAt kids: ast.kids span: bodyIds i: vx249
        vx249 = vx249 + 1
        bmNode: ast.nodes.get i: bm.u64
        if bmNode.namedoperation then {
            dnm: zast.nameTextAt :ast ref: bmNode.name
            (fillOneDataElem
                :ast
                :symtab
                :ctx
                name: dnm.stringView
                op: (ast.nodes.get i: bmNode.operation.u64)
            )
        }
    }
}

# populate one data-block element.
fillOneDataElem: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    name: StringView
    op: astnode.view
} is {
    match (
        op
    ) case expression then {
        fillOneDataElem :ast :symtab :ctx :name op: (ast.nodes.get i: op.expression.u64)
    } case datablock then {
        ebn: dataElemBaseName :ast oId: op.outType
        dtid: stampIdOf :symtab nid: op.nodeid.u64
        k: dtid
        if ebn.length > 0 then {
            ebv: ebn
            ev: ebv.string
            ctx.dataElems.set key: k value: ev
        } else {
            iv: "i64".string
            ctx.dataElems.set key: k value: iv
        }
        idx: u64
        hasLen: false
        ei9a: u64
        for ei9a < op.elements.count.u64 loop {
            e: zast.kidAt kids: ast.kids span: op.elements i: ei9a
            ei9a = ei9a + 1
            vx: emitDataElem :ast :symtab :ctx n: (ast.nodes.get i: e.u64)
            ik: (dataslotkey owner: dtid.u64 slot: idx)
            iv2: vx.copy
            ctx.dataSlot.set key: ik value: iv2
            elbl: dataElemLabel :ast n: (ast.nodes.get i: e.u64)
            if elbl.length > 0 then {
                elid: zast.poolFind pool: ast.names text: elbl.stringView
                if elid == zast.names.wkLength then hasLen = true
                lk: (dataconstkey owner: dtid.u64 name: elid.u64)
                lv: vx.copy
                ctx.dataConst.set key: lk value: lv
            }
            idx = idx + 1
        }
        # `.length` folds like a label: the count is known here, so reading it
        # never forces the static array out. An element labelled `length` has
        # already claimed the name.
        if hasLen == false then {
            lnk: (dataconstkey owner: dtid.u64 name: zast.names.wkLength.u64)
            lnv: "\{idx}"
            ctx.dataConst.set key: lnk value: lnv
        }
    } else null
}

# the label of data-block element `n`.
dataElemLabel: function {ast: Ast.view n: astnode.view} out String is {
    match (
        n
    ) case namedoperation then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# scan the program for the runtime helpers it needs.
fillNeeds: function {program: Ast.view symtab: zenv.ZSymbolTable.view ctx: Ctx} is {
    {
        uCnt9b: program.units.length
        uIdx9b: u64
        for uIdx9b < uCnt9b loop {
            uId: (zast.nodeid.create from: (program.units.get i: uIdx9b))
            uIdx9b = uIdx9b + 1
            opId: zast.nodeid
            unitNameText: String
            {
                u: program.nodes.get i: uId.u64
                if u.namedoperation then {
                    un: zast.poolTextAt pool: program.names ref: u.name
                    opId = u.operation
                    unitNameText = un.copy
                }
            }
            if opId > 0 then {
                (fillNeedsIn
                    :symtab
                    :ctx
                    ast: program
                    unitName: unitNameText.stringView
                    mainOpId: opId
                )
            }
        }
    }
}

# scan one unit for the runtime helpers it needs.
fillNeedsIn: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    ast: Ast.view
    unitName: StringView
    mainOpId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: mainOpId
    vx259: u64
    for vx259 < bodyIds.count.u64 loop {
        bm: zast.kidAt kids: ast.kids span: bodyIds i: vx259
        vx259 = vx259 + 1
        bmNode: ast.nodes.get i: bm.u64
        if bmNode.namedoperation then {
            # a body that will not be emitted must not register needs either:
            # a runtime fragment pulled in by dead code carries the signature
            # types that code named, and nothing minted them.
            fnn: zast.nameTextAt :ast ref: bmNode.name
            if (
                (stdFnUndemanded
                    :ast
                    :symtab
                    :unitName
                    fnName: fnn.stringView
                    ownerTid: ztypes.tid
                    wantWalked: true
                ) ==
                false
            ) then {
                (scanNeeds
                    :ast
                    :symtab
                    :ctx
                    :unitName
                    n: (ast.nodes.get i: bmNode.operation.u64)
                )
            }
        }
    }
}

# scanNativeNeed -- register the unit + `<unit>_<member>` needs behind a
# callee that RESOLVES to a native declaration. The discriminator is the
# resolved declaration and the unit that declares it, never the spelling of
# the base atom: a user unit named `os` declares bodied functions, so it
# resolves to nothing native and gates no fragment, while a native reached
# through any spelling is recorded under the unit that declares it.
scanNativeNeed: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    unitName: StringView
    baseId: zast.nameid
    membId: zast.nameid
} is {
    calleeTid: ztypes.tid
    if baseId.isZero == false when membId.isZero == false then {
        # a qualified path names a unit only when the base IS one: a program
        # may declare a TYPE with a runtime unit's name (a variant `io` with a
        # `stdout` arm), and `io.stdout` there constructs an arm rather than
        # reaching the native. Name ids are pooled program-wide, so resolving
        # the child without this gate would find the stdlib declaration.
        if (
            (ztypecheck.isUnitNameDecl
                st: symtab
                nameId: baseId
            ) ==
            false
        ) then return
        # ... but a DECLARATION of that name in the scanning unit shadows it:
        # a variant `io` with a `stdout` arm makes `io.stdout` an arm
        # construction, and the unit probe still answers because name ids are
        # pooled program-wide.
        uq3z: (ztypecheck.unitDeclOfName
            st: symtab
            nameId: (zast.poolFind pool: ast.names text: unitName)
        )
        sh: (ztypecheck.resolveUnitChildRo
            :ast
            st: symtab
            unitDecl: uq3z
            nameId: baseId
        )
        match (
            sh
        ) case some then {
            shT: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: sh)
            if shT != ztypes.ztypetype.unitType then return
        } case none then null
        ud8x: ztypecheck.unitDeclOfName st: symtab nameId: baseId
        fo: (ztypecheck.resolvedByIdsRo
            :ast
            st: symtab
            unitDecl: ud8x
            name: membId
        )
        match (
            fo
        ) case some then {
            calleeTid = ztypes.tid.create from: fo
        } case none then return
    } else {
        if membId.isZero then return
        uq4z: (ztypecheck.unitDeclOfName
            st: symtab
            nameId: (zast.poolFind pool: ast.names text: unitName)
        )
        go: (ztypecheck.resolveUnitChildRo
            :ast
            st: symtab
            unitDecl: uq4z
            nameId: membId
        )
        match (
            go
        ) case some then {
            calleeTid = ztypes.tid.create from: go
        } case none then return
    }
    if calleeTid.isZero then return
    if (symtab.reg.typetypeOf typeId: calleeTid) != ztypes.ztypetype.functionType then return
    if (fnIsNativeId :symtab fid: calleeTid) == false then return
    duo: definedInUnitOf :symtab tid: calleeTid
    match (
        duo
    ) case some then {
        # the need LISTS the member, so this leg -- and only this leg, which a
        # resolved native reaches -- spells it
        membT: zast.nameTextAt :ast ref: membId
        needsAddM :ctx uname: duo.stringView memb: "@unit"
        needsAddM :ctx uname: duo.stringView memb: membT.stringView
    } case none then null
}

# scanNeedsCall -- the needs a CALL declares: the string/view natives its
# member name asks for, the native rows its callee resolves to, and then the
# arguments, which are scanned like any other node.
scanNeedsCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    unitName: StringView
    n: zast.callrow.view
} is {
    mn0: dottedChildText :ast n: (ast.nodes.get i: n.callable.u64)
    cbi0: dottedBaseAtomId :ast n: (ast.nodes.get i: n.callable.u64)
    # the member as an id, by the same rule the text followed: the dotted
    # child, or the bare atom when the callable is not a path
    cmbId: dottedChildNameIdOf :ast n: (ast.nodes.get i: n.callable.u64)
    if cbi0.isZero then {
        cmbId = atomNameIdOf :ast n: (ast.nodes.get i: n.callable.u64)
    }
    (scanNativeNeed
        :ast
        :symtab
        :ctx
        :unitName
        baseId: cbi0
        membId: cmbId
    )
    if (isSvArgNative name: mn0) then (needsAddM
        :ctx
        uname: "system"
        memb: mn0
    )
    if (isSvSimpleNative name: mn0) then (needsAddM
        :ctx
        uname: "system"
        memb: mn0
    )
    # substring emits through its own leg (recv/from/to), so the arg-native
    # table cannot carry it; the need still must pre-register for method
    # bodies, which emit after the runtime pass runs
    if mn0 == "substring" then needsAddM :ctx uname: "system" memb: "substring"
    if (isSvParseNative name: mn0) then (needsAddM
        :ctx
        uname: "system"
        memb: mn0
    )
    if (isSvNoArgNative name: mn0) then (needsAddM
        :ctx
        uname: "system"
        memb: mn0
    )
    # split/lines emit through the iterator fragments (Splitter/LinesIter),
    # so the native tables cannot carry them; the sv_* needs still must
    # pre-register for method bodies, which emit after the runtime pass runs
    if mn0 == "split" then needsAddM :ctx uname: "sviter" memb: "sv_split"
    if mn0 == "lines" then needsAddM :ctx uname: "sviter" memb: "sv_lines"
    cjn0: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.callable.u64))
    if cjn0.stringView == "stringJoin" then (needsAddM
        :ctx
        uname: "collections"
        memb: "coll_join"
    )
    arx559: u64
    for arx559 < n.arguments.count.u64 loop {
        a: zast.kidAt kids: ast.kids span: n.arguments i: arx559
        arx559 = arx559 + 1
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: a.u64)
    }
}

# scanNeedsDotted -- the needs a DOTTED READ declares: the float parses and the
# no-argument view natives reached without a call, plus the base's own row.
scanNeedsDotted: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    unitName: StringView
    n: zast.dottedpathrow.view
} is {
    pdm: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
    if pdm.stringView == "parseF64" then needsAddM :ctx uname: "system" memb: "parseF64"
    if pdm.stringView == "parseF16" then needsAddM :ctx uname: "system" memb: "parseF16"
    if pdm.stringView == "parseF128" then needsAddM :ctx uname: "system" memb: "parseF128"
    if pdm.stringView == "parseI64" then needsAddM :ctx uname: "system" memb: "parseI64"
    if pdm.stringView == "parseU64" then needsAddM :ctx uname: "system" memb: "parseU64"
    if (isSvNoArgNative name: pdm.stringView) then (needsAddM
        :ctx
        uname: "system"
        memb: pdm.stringView
    )
    # a no-paren member read auto-calls, so the simple natives (trim,
    # isEmpty, ...) arrive as dottedpath too -- same parity the call arm has
    if (isSvSimpleNative name: pdm.stringView) then (needsAddM
        :ctx
        uname: "system"
        memb: pdm.stringView
    )
    if pdm.stringView == "lines" then needsAddM :ctx uname: "sviter" memb: "sv_lines"
    # a no-paren member read auto-calls, so a zero-parameter native (os.pid,
    # io.stdout) arrives here rather than at the call arm
    (scanNativeNeed
        :ast
        :symtab
        :ctx
        :unitName
        baseId: (atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
        membId: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
    )
    scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.parent.u64)
}


# scanNeeds -- recursively register io/os native needs for every call in a
# def/body. Structurally mirrors collectLiterals; emitFns registers free-fn
# needs ahead of the runtime pass, but type-method bodies emit afterwards (via
# emitRecordDefs), so a native used only inside a method (e.g. io.stat in
# zvfs's providers) would never have its runtime body emitted. A callee that
# RESOLVES to a native declaration registers the unit that declares it plus
# `<unit>_<member>`; a callee that resolves to anything else registers
# nothing, so a user unit named io or os gates no fragment.
scanNeeds: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    unitName: StringView
    n: astnode.view
} is {
    match (
        n
    ) case functiondef then {
        if n.body > 0 then (scanNeeds
            :ast
            :symtab
            :ctx
            :unitName
            n: (ast.nodes.get i: n.body.u64)
        )
    } case objectdef then {
        asx1689: u64
        for asx1689 < n.asItems.count.u64 loop {
            amId: zast.kidAt kids: ast.kids span: n.asItems i: asx1689
            asx1689 = asx1689 + 1
            am: ast.nodes.get i: amId.u64
            if am.namedoperation then {
                scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: am.operation.u64)
            }
        }
        isx1869: u64
        for isx1869 < n.isItems.count.u64 loop {
            imId: zast.kidAt kids: ast.kids span: n.isItems i: isx1869
            isx1869 = isx1869 + 1
            im: ast.nodes.get i: imId.u64
            if im.namedoperation then {
                scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: im.operation.u64)
            }
        }
    } case statement then {
        stx759: u64
        for stx759 < n.statements.count.u64 loop {
            sId: zast.kidAt kids: ast.kids span: n.statements i: stx759
            stx759 = stx759 + 1
            (scanNeeds
                :ast
                :symtab
                :ctx
                :unitName
                n: (ast.nodes.get i: sId.u64)
            )
        }
    } case statementline then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.statementline.u64)
    } case expression then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.expression.u64)
    } case namedoperation then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.operation.u64)
    } case call then {
        scanNeedsCall :ast :symtab :ctx :unitName :n
    } case dottedpath then {
        scanNeedsDotted :ast :symtab :ctx :unitName :n
    } case binop then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.lhs.u64)
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.rhs.u64)
    } case assignment then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.value.u64)
    } case reassignment then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.value.u64)
    } case ifexpr then {
        clx1069: u64
        for clx1069 < n.clauses.count.u64 loop {
            cId: zast.kidAt kids: ast.kids span: n.clauses i: clx1069
            clx1069 = clx1069 + 1
            (scanNeeds
                :ast
                :symtab
                :ctx
                :unitName
                n: (ast.nodes.get i: cId.u64)
            )
        }
        if n.elseclause > 0 then (scanNeeds
            :ast
            :symtab
            :ctx
            :unitName
            n: (ast.nodes.get i: n.elseclause.u64)
        )
    } case caseexpr then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.subject.u64)
        clx1079: u64
        for clx1079 < n.clauses.count.u64 loop {
            mc9Id: zast.kidAt kids: ast.kids span: n.clauses i: clx1079
            clx1079 = clx1079 + 1
            (scanNeeds
                :ast
                :symtab
                :ctx
                :unitName
                n: (ast.nodes.get i: mc9Id.u64)
            )
        }
        if n.elseclause > 0 then (scanNeeds
            :ast
            :symtab
            :ctx
            :unitName
            n: (ast.nodes.get i: n.elseclause.u64)
        )
    } case caseclause then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.statement.u64)
    } case ifclause then {
        cox1319: u64
        for cox1319 < n.conditions.count.u64 loop {
            kId: zast.kidAt kids: ast.kids span: n.conditions i: cox1319
            cox1319 = cox1319 + 1
            (scanNeeds
                :ast
                :symtab
                :ctx
                :unitName
                n: (ast.nodes.get i: kId.u64)
            )
        }
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.statement.u64)
    } case withexpr then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.value.u64)
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.body.u64)
    } case doexpr then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.statement.u64)
    } case forexpr then {
        cox1329: u64
        for cox1329 < n.conditions.count.u64 loop {
            fId: zast.kidAt kids: ast.kids span: n.conditions i: cox1329
            cox1329 = cox1329 + 1
            (scanNeeds
                :ast
                :symtab
                :ctx
                :unitName
                n: (ast.nodes.get i: fId.u64)
            )
        }
        if n.body > 0 then (scanNeeds
            :ast
            :symtab
            :ctx
            :unitName
            n: (ast.nodes.get i: n.body.u64)
        )
    } else null
}


# stdFnUndemanded -- a bodied free fn the program never referenced: its def was
# not resolved, so its body carries no stamps and emitting it renders the
# signature as `z_t0(void)` over unbound parameter names. Skip it everywhere
# (definition, needs pre-scan, literal pooling). Whether the fn resolved is a
# fact about the DEFINITION, not about which unit declares it: a demand-gated
# unit and an emittable one both leave an unreferenced body unresolved, and
# only the eager pass hid that for the second. ownerTid names the enclosing
# namespace / subunit type for a nested fn -- its members are children of IT,
# so the unit-root key below misses them and would drop a fn that IS used.
stdFnUndemanded: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    unitName: StringView
    fnName: StringView
    ownerTid: ztypes.tid
    # ask whether the body was WALKED, not merely resolved. Only the definition
    # pass may: the literal pool has to cover everything that might be emitted,
    # including a generic template unit's monos, whose template is never walked
    # under its own name.
    wantWalked: bool
} out bool is {
    if ownerTid.isZero == false then {
        co: (symtab.typing.declChildOfId
            parentTypeId: ownerTid
            nameId: (zast.poolFind pool: ast.names text: fnName)
        )
        match (
            co
        ) case some then {
            return false
        } case none then {
            return true
        }
    }
    ud9x: (ztypecheck.unitDeclOfName
        st: symtab
        nameId: (zast.poolFind pool: ast.names text: unitName)
    )
    ro: (ztypecheck.resolvedByIdsRo
        :ast
        st: symtab
        unitDecl: ud9x
        name: (zast.poolFind pool: ast.names text: fnName)
    )
    rres: false
    match (
        ro
    ) case some then {
        rres = true
    } case none then null
    if rres == false then return true
    # resolved is not enough: emitting a body that was never WALKED emits code
    # whose types were never minted -- a resolved but unwalked json.at emitted
    # a call whose return spec nothing ever created, `z_t0_t`. The walk is what
    # stamps a body, so being walked is the honest question. The main unit is
    # walked in full and keeps no such mark.
    if wantWalked == false then return false
    if unitName == symtab.reg.regMainUnit.stringView then return false
    ud10x: (ztypecheck.unitDeclOfName
        st: symtab
        nameId: (zast.poolFind pool: ast.names text: unitName)
    )
    wd: (ztypecheck.declOfUnitDefIds
        st: symtab
        unitDecl: ud10x
        nameId: (zast.poolFind pool: ast.names text: fnName)
    )
    return (symtab.typing.declIsWalked declId: wd) == false
}

# isGenericTemplateUnitOp -- a file unit that is a generic template (declares a
# bare `t: Any.generic` member). Its raw functions reference the unbound type
# param, so they are not emitted directly; emitUnitMonoInstances emits one
# concrete C function per (instantiation, method) instead.
isGenericTemplateUnitOp: function {ast: Ast.view opId: u32} out bool is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: opId
    vx269: u64
    for vx269 < bodyIds.count.u64 loop {
        m: zast.kidAt kids: ast.kids span: bodyIds i: vx269
        vx269 = vx269 + 1
        m9Node: ast.nodes.get i: m.u64
        if m9Node.namedoperation then {
            if (ztypecheck.isGenericParam
                :ast
                op: (ast.nodes.get i: m9Node.operation.u64)
            ) then return true
        }
    }
    return false
}

# emitUnitMonoInstances -- emit the monomorphized methods of a generic file unit
# (genmath instantiated as intmath: i64, i32math: i32). For each registry UNIT
# type whose generic origin is this template, emit one C function per template
# method keyed by the mono's concrete FUNCTION child id (so the signature carries
# the substituted types); the body AST is the template method itself (lock-safe:
# its root is the program AST, not symtab, so emitFnBody can borrow symtab).
emitUnitMonoInstances: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    templateName: StringView
    templateUnitOpId: u32
    declOnly: bool
    buf: String.borrow
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: templateUnitOpId
    tplId: u64
    tk: templateName
    tgo: (ztypecheck.declTypeIdOf
        st: symtab
        declId: (symtab.typing.declFindChild
            parentDeclId: symtab.typing.programRoot
            nameId: (zast.poolFind pool: ast.names text: tk)
        )
    )
    if tgo.isZero == false then tplId = tgo
    if tplId == 0 then {
        sgo: u64
        rid: u32
        {
            tuo: ast.nodes.get i: templateUnitOpId.u64
            if tuo.unitdef then rid = tuo.nodeid
        }
        if rid > 0 then sgo = stampIdOf :symtab nid: rid.u64
        if sgo > 0 then tplId = sgo
    }
    if tplId == 0 then return
    last: symtab.reg.nextTypeId
    t: u64
    for t < last loop {
        isMono: false
        if (
            (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: t.u64)) ==
            ztypes.ztypetype.unitType
        ) then {
            go9opt: symtab.reg.genericOriginOf tid: (ztypes.tid.create from: t.u64)
            if go9opt.u64 == tplId when go9opt > 0 then isMono = true
        }
        if isMono then {
            {
                vx279: u64
                for vx279 < bodyIds.count.u64 loop {
                    fm: zast.kidAt kids: ast.kids span: bodyIds i: vx279
                    vx279 = vx279 + 1
                    fm9Node: ast.nodes.get i: fm.u64
                    if fm9Node.namedoperation then {
                        if (ztypecheck.isFunctionDefWithBody
                            o: (ast.nodes.get i: fm9Node.operation.u64)
                        ) then {
                            mname: zast.nameTextAt :ast ref: fm9Node.name
                            cfo: (symtab.typing.declChildOf
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: t.u64)
                                name: mname.stringView
                            )
                            match (
                                cfo
                            ) case some then {
                                cfid: cfo
                                if (
                                    (symtab.reg.typetypeOf
                                        typeId: (ztypes.tid.create from: cfid.u64)
                                    ) ==
                                    ztypes.ztypetype.functionType
                                ) then {
                                    fnm: (regNameOf
                                        :symtab
                                        tid: (ztypes.tid.create from: cfid.u64)
                                    )
                                    sig: (fnSignature
                                        :ast
                                        :symtab
                                        :ctx
                                        name: fnm.stringView
                                        fid: (ztypes.tid.create from: cfid.u64)
                                        op: (ast.nodes.get i: fm9Node.operation.u64)
                                    )
                                    if declOnly then {
                                        ld: "\{sig};\n"
                                        buf.append ld
                                    } else {
                                        lo: "\{sig} {\n"
                                        buf.append lo
                                        ctx.ptrVids = ListVal ztypes.vid
                                        ctx.aliases = List VidVal
                                        ctx.narrowBox = List VidVal
                                        ctx.narrowTid = List VidTid
                                        ctx.exclArms = List VidVal
                                        ctx.exclTids = List VidTid
                                        (registerReftypeParams
                                            :ast
                                            :symtab
                                            :ctx
                                            fid: (ztypes.tid.create from: cfid.u64)
                                            op: (ast.nodes.get i: fm9Node.operation.u64)
                                        )
                                        ctx.curThisTid = ztypes.tid.create from: t
                                        (emitFnBody
                                            :ast
                                            :symtab
                                            :ctx
                                            op: (ast.nodes.get i: fm9Node.operation.u64)
                                            fid: (ztypes.tid.create from: cfid.u64)
                                            :buf
                                        )
                                        ctx.curThisTid = ztypes.tid.create from: 0
                                        buf.append "}\n\n"
                                    }
                                }
                            } case none then null
                        }
                    }
                }
            }
        }
        t = t + 1
    }
}

# emitFnsPass -- one declOnly-parameterized sweep over EVERY unit, routing
# generic template units to their mono instances and plain units to emitFnsIn.
# It asks no unit-level question: what a runtime-backed unit supplies is dropped
# per DEFINITION, by stdFnUndemanded and the native filters collectFnDecls
# applies. ctx.mainName is rebound to each unit for the duration.
emitFnsPass: function {
    program: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    declOnly: bool
    buf: String.borrow
} is {
    {
        uCnt9e: program.units.length
        uIdx9e: u64
        for uIdx9e < uCnt9e loop {
            uId: (zast.nodeid.create from: (program.units.get i: uIdx9e))
            uIdx9e = uIdx9e + 1
            opId: zast.nodeid
            unitNameText: String
            un9Id: zast.nameid
            {
                u: program.nodes.get i: uId.u64
                if u.namedoperation then {
                    un: zast.poolTextAt pool: program.names ref: u.name
                    opId = u.operation
                    unitNameText = un.copy
                    un9Id = u.name
                }
            }
            if opId > 0 then {
                sm: ctx.mainName.copy
                smD: ctx.mainUnitId
                (ctxBindMain
                    :ctx
                    name: unitNameText.stringView
                    unitDecl: (ztypecheck.unitDeclOfName st: symtab nameId: un9Id)
                )
                isTpl: isGenericTemplateUnitOp ast: program :opId
                if isTpl then {
                    (emitUnitMonoInstances
                        :symtab
                        ast: program
                        :ctx
                        templateName: unitNameText.stringView
                        templateUnitOpId: opId
                        :declOnly
                        :buf
                    )
                } else {
                    (emitFnsIn
                        :symtab
                        :ctx
                        ast: program
                        mainOpId: opId
                        ownerTid: ztypes.tid
                        :declOnly
                        :buf
                    )
                }
                ctxBindMain :ctx name: sm.stringView unitDecl: smD
            }
        }
    }
}

# emitFns -- the main unit's function declarations then definitions
# (two-phase index walk so the body list is free during emission).
emitFns: function {
    program: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    buf: String.borrow
} is {
    # every file unit's fn DECLARATIONS first, then every file unit's
    # DEFINITIONS -- a main-unit body may call a dep-unit fn declared
    # earlier (and vice versa).
    emitFnsPass :program :symtab :ctx declOnly: true :buf
    emitFnsPass :program :symtab :ctx declOnly: false :buf
}

# emitFnMonoInstances -- emit the monomorphized instances of a generic free
# function (identity_i64, identity_f64, first_i64_f64, ...). Each instance was
# minted by the typechecker (mintMono, params already substituted); emit one C
# function per registry FUNCTION whose generic origin is this template, keyed by
# the mono FUNCTION id (concrete signature) with the template body AST (lock-safe:
# the body AST root is the program, not symtab).
emitFnMonoInstances: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    templateFnId: u64
    templateFnOp: astnode.view
    declOnly: bool
    buf: String.borrow
} is {
    last: symtab.reg.nextTypeId
    t: ztypes.tid
    for t < last loop {
        isMono: false
        if (symtab.reg.typetypeOf typeId: t) == ztypes.ztypetype.functionType then {
            go9opt: symtab.reg.genericOriginOf tid: t
            if go9opt.u64 == templateFnId when go9opt > 0 then isMono = true
        }
        if isMono then {
            fnm: regNameOf :symtab tid: t
            sig: (fnSignature
                :ast
                :symtab
                :ctx
                name: fnm.stringView
                fid: (ztypes.tid.create from: t.u64)
                op: templateFnOp
            )
            if declOnly then {
                ld: "\{sig};\n"
                buf.append ld
            } else {
                lo: "\{sig} {\n"
                buf.append lo
                ctx.ptrVids = ListVal ztypes.vid
                ctx.aliases = List VidVal
                ctx.narrowBox = List VidVal
                ctx.narrowTid = List VidTid
                ctx.exclArms = List VidVal
                ctx.exclTids = List VidTid
                (registerReftypeParams
                    :ast
                    :symtab
                    :ctx
                    fid: (ztypes.tid.create from: t.u64)
                    op: templateFnOp
                )
                ctx.curThisTid = ztypes.tid.create from: t.u64
                (emitFnBody
                    :ast
                    :symtab
                    :ctx
                    op: templateFnOp
                    fid: (ztypes.tid.create from: t.u64)
                    :buf
                )
                ctx.curThisTid = ztypes.tid.create from: 0
                buf.append "}\n\n"
            }
        }
        t = ztypes.tid.create from: (t + 1)
    }
}

# emitNestedUnitFns -- a nested unit's own functions and mono instances, which
# are children of IT rather than of the file unit, so they are emitted by
# recursing with the nested namespace as the owner.
emitNestedUnitFns: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    bodyIds: zast.kidspan
    ownerTid: ztypes.tid
    declOnly: bool
    buf: String.borrow
} is {
    vx289: u64
    for vx289 < bodyIds.count.u64 loop {
        ium9Id: zast.kidAt kids: ast.kids span: bodyIds i: vx289
        vx289 = vx289 + 1
        ium: ast.nodes.get i: ium9Id.u64
        if ium.namedoperation then {
            iuOpId: ium.operation
            if (isGenericTemplateUnitOp :ast opId: iuOpId) then {
                iunm: zast.nameTextAt :ast ref: ium.name
                (emitUnitMonoInstances
                    :symtab
                    :ast
                    :ctx
                    templateName: iunm.stringView
                    templateUnitOpId: iuOpId
                    :declOnly
                    :buf
                )
            }
            isNs: false
            if (zast.unitOpDeclaresUnit :ast opId: iuOpId) then isNs = true
            # a `public:` block that DEFINES no function of its own has
            # nothing to emit here (its entries name the unit's siblings)
            if isNs when (zast.unitOpKindIs
                :ast
                opId: iuOpId
                k: zast.unitkind.publicNs
            ) then {
                if (unitOpHasBodiedFn :ast opId: iuOpId) == false then isNs = false
            }
            if isNs then {
                nsTid: ztypes.tid
                {
                    ownr: ownerTid
                    if ownr.isZero then {
                        ownr = unitTidOf :ast :symtab unitName: ctx.mainName.stringView
                    }
                    no: symtab.typing.declChildOfId parentTypeId: ownr nameId: ium.name
                    match (
                        no
                    ) case some then {
                        nsTid = ztypes.tid.create from: no
                    } case none then null
                }
                if nsTid.isZero == false then {
                    sns: ctx.nsTid
                    ctx.nsTid = nsTid
                    (emitFnsIn
                        :ast
                        :symtab
                        :ctx
                        mainOpId: (zast.nodeid.create from: iuOpId)
                        ownerTid: nsTid
                        :declOnly
                        :buf
                    )
                    ctx.nsTid = sns
                }
            }
        }
    }
}

# collectFnDecls -- the bodied, demanded function declarations of this unit, in
# source order: their body-list indices and their names.
collectFnDecls: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    bodyIds: zast.kidspan
    ownerTid: ztypes.tid
    idxs: ListVal u64
    names: List String
} is {
    di: u64
    vx299: u64
    for vx299 < bodyIds.count.u64 loop {
        bmId: zast.kidAt kids: ast.kids span: bodyIds i: vx299
        vx299 = vx299 + 1
        bm: ast.nodes.get i: bmId.u64
        if bm.namedoperation then {
            if (ztypecheck.isFunctionDefWithBody o: (ast.nodes.get i: bm.operation.u64)) then {
                nm: zast.nameTextAt :ast ref: bm.name
                skipDepMain: false
                # a runtime-backed unit's bodied fn only emits when the
                # program referenced it (undemanded bodies carry no stamps)
                if (stdFnUndemanded
                    :ast
                    :symtab
                    unitName: ctx.mainName.stringView
                    fnName: nm.stringView
                    :ownerTid
                    wantWalked: true
                ) then skipDepMain = true
                if nm.stringView == "main" then {
                    if ctx.mainName.stringView != ctx.realMain.stringView then skipDepMain = true
                }
                if skipDepMain == false then {
                    dv: di
                    idxs.append dv
                    names.append nm.copy
                }
            }
        }
        di = di + 1
    }
}

# emitFnDeclsInOrder -- one C function per collected declaration: its mono
# instances first, then the signature, then the body unless this is the
# declaration-only pass.
emitFnDeclsInOrder: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    bodyIds: zast.kidspan
    ownerTid: ztypes.tid
    idxs: (ListVal u64).view
    names: (List String).view
    declOnly: bool
    buf: String.borrow
} is {
    wn: idxs.length
    wi: u64
    for wi < wn loop {
        nm2: names.get i: wi
        didx: idxs.get i: wi
        dm2Id: zast.kidAt kids: ast.kids span: bodyIds i: didx
        dm2: ast.nodes.get i: dm2Id.u64
        if dm2.namedoperation then {
            fid: ztypes.tid
            if ownerTid.isZero then {
                fid = userFnId :ast :symtab :ctx name: nm2.stringView
            } else {
                fo: (symtab.typing.declChildOfId
                    parentTypeId: ownerTid
                    nameId: (zast.poolFind pool: ast.names text: nm2.stringView)
                )
                match (
                    fo
                ) case some then {
                    fid = ztypes.tid.create from: fo
                } case none then null
            }
            isGenFn: false
            if fid > 0 then {
                if (isGenericType :symtab tid: fid) then {
                    if (symtab.reg.typetypeOf typeId: fid) == ztypes.ztypetype.functionType then {
                        isGenFn = true
                    }
                }
            }
            if isGenFn then {
                (emitFnMonoInstances
                    :ast
                    :symtab
                    :ctx
                    templateFnId: fid
                    templateFnOp: (ast.nodes.get i: dm2.operation.u64)
                    :declOnly
                    :buf
                )
            } else {
                sig: (fnSignature
                    :ast
                    :symtab
                    :ctx
                    name: nm2.stringView
                    :fid
                    op: (ast.nodes.get i: dm2.operation.u64)
                )
                if declOnly then {
                    ld: "\{sig};\n"
                    buf.append ld
                } else {
                    lo: "\{sig} {\n"
                    buf.append lo
                    ctx.ptrVids = ListVal ztypes.vid
                    ctx.aliases = List VidVal
                    ctx.narrowBox = List VidVal
                    ctx.narrowTid = List VidTid
                    ctx.exclArms = List VidVal
                    ctx.exclTids = List VidTid
                    (registerReftypeParams
                        :ast
                        :symtab
                        :ctx
                        :fid
                        op: (ast.nodes.get i: dm2.operation.u64)
                    )
                    (emitFnBody
                        :ast
                        :symtab
                        :ctx
                        op: (ast.nodes.get i: dm2.operation.u64)
                        :fid
                        :buf
                    )
                    buf.append "}\n\n"
                }
            }
        }
        wi = wi + 1
    }
}


# emit a unit's function definitions.
emitFnsIn: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    mainOpId: zast.nodeid
    # the unit whose functions these are: 0 for the file unit ctx is bound to,
    # whose children the name-keyed lookup below already answers for, and the
    # namespace's own type id for a nested unit -- whose functions are children
    # of IT, so resolving them against the file unit misses and hands the
    # signature a tid of 0, which renders as `z_t0(void)`.
    ownerTid: ztypes.tid
    declOnly: bool
    buf: String.borrow
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: mainOpId
    {
        emitNestedUnitFns :ast :symtab :ctx :bodyIds :ownerTid :declOnly :buf
        idxs: ListVal u64
        names: List String
        collectFnDecls :ast :symtab :ctx :bodyIds :ownerTid :idxs :names
        (emitFnDeclsInOrder
            :ast
            :symtab
            :ctx
            :bodyIds
            :ownerTid
            :idxs
            :names
            :declOnly
            :buf
        )
        if declOnly then buf.append "\n"
    }
}

# unitOpHasBodiedFn -- does the unit body at `opId` define a function with a
# body among its own entries?
unitOpHasBodiedFn: function {ast: Ast.view opId: u32} out bool is {
    ids: zast.unitBodyIdsAt :ast unitId: opId
    uox9: u64
    for uox9 < ids.count.u64 loop {
        mId: zast.kidAt kids: ast.kids span: ids i: uox9
        uox9 = uox9 + 1
        m: ast.nodes.get i: mId.u64
        if m.namedoperation then {
            if (ztypecheck.isFunctionDefWithBody o: (ast.nodes.get i: m.operation.u64)
            ) then return true
        }
    }
    return false
}

# strHasSub -- substring containment with a dynamic needle, routed through a
# StringView receiver: the emitter resolves .contains on a param, not on a
# for-loop iterate element used directly as a method-call receiver.
strHasSub: function {hay: StringView needle: StringView} out bool is {
    return (hay.contains :needle)
}

# isBareCName -- true if s is a plain C identifier (only [A-Za-z0-9_]); such a
# return value is a bare local whose scope cleanup can safely run before the
# return. A compound expression (call / deref / field / cast) must be hoisted
# into a temp first, handled separately.
isBareCName: function {s: StringView} out bool is {
    if s.length == 0 then return false
    i: u64
    for i < s.length loop {
        bo: s.byteAt i
        match (
            bo
        ) case some then {
            ok: false
            if bo >= 48 when bo <= 57 then ok = true
            if bo >= 65 when bo <= 90 then ok = true
            if bo >= 97 when bo <= 122 then ok = true
            if bo == 95 then ok = true
            if ok == false then return false
        } case none then {
            return false
        }
        i = i + 1
    }
    return true
}

# cSlotName -- a member name as a C identifier for an interface vtable slot.
# An OPERATOR member (`==`, `<=`, ...) is not a C identifier: a facet or
# protocol declaring `==` would emit `bool (*==)(void*, T);`, which gcc
# rejects. The operator spelling comes from opCnameOf, the same table the
# implementation's own C name is built from, so the struct field, the wrapper
# name, the vtable row and the dispatch site cannot drift apart -- they are
# four spellings of one slot, and one table is what makes that true.
#
# The fallback is byte-wise so any operator the table misses still yields a
# unique, deterministic identifier rather than colliding with another one.
cSlotName: function {name: StringView} out String is {
    if (isBareCName s: name) then {
        sp: memberCPrefix :name
        return "\{sp}\{name}"
    }
    op: opCnameOf :name
    if op.length > 0 then return op
    result: "op".string
    i: u64
    for i < name.length loop {
        bo: name.byteAt i
        match (
            bo
        ) case some then {
            seg: "_\{bo}"
            result.append seg
        } case none then null
        i = i + 1
    }
    return result
}

# ctEndsWithStar -- true if the C type string ends in '*' (a pointer return:
# union, protocol, Map/Set, or a user reftype passed by reference). Takes a `ct`
# param so `.length`/`.byteAt` emit as field/method ops (a chained `.stringView`
# receiver mis-emits a free function call).
ctEndsWithStar: function {ct: StringView} out bool is {
    if ct.length == 0 then return false
    lb: (ct.byteAt (ct.length - 1)).or d: 0
    if lb == 42 then return true
    return false
}

# isIdChar -- a C-identifier byte [A-Za-z0-9_].
isIdChar: function {b: u8} out bool is {
    if b >= 48 when b <= 57 then return true
    if b >= 65 when b <= 90 then return true
    if b >= 97 when b <= 122 then return true
    if b == 95 then return true
    return false
}

# refsLocal -- true if `name` occurs in `expr` as a maximal C identifier (bounded
# by non-identifier bytes). A local referenced in the return expression is part of
# (or borrowed by) the return value, so it must NOT be freed before the return.
refsLocal: function {expr: StringView name: StringView} out bool is {
    nl: name.length
    el: expr.length
    if nl == 0 then return false
    if nl > el then return false
    i: u64
    for i + nl <= el loop {
        eq: true
        k: u64
        for k < nl loop {
            ebv: (expr.byteAt (i + k)).or d: 0
            nbv: (name.byteAt k).or d: 1
            if ebv != nbv then eq = false
            k = k + 1
        }
        if eq then {
            beforeOk: true
            if i > 0 then {
                if (isIdChar b: ((expr.byteAt (i - 1)).or d: 0)) then beforeOk = false
            }
            afterOk: true
            ep: i + nl
            if ep < el then {
                if (isIdChar b: ((expr.byteAt ep).or d: 0)) then afterOk = false
            }
            if beforeOk when afterOk then return true
        }
        i = i + 1
    }
    return false
}

# isRegisteredOwned -- true if `name` is a registered owned local (a String in
# tmp.frees or a collection/class in tmp.listFrees). Decides whether a value
# moved into an inline construction must be zeroed so its scope-cleanup destructor
# becomes a no-op.
isRegisteredOwned: function {tmp: TmpCtr.view name: StringView} out bool is {
    fit: tmp.frees.iterate
    for fv: fit loop {
        if fv.name.stringView == name then return true
    }
    vit: tmp.listFrees.iterate
    for vv: vit loop {
        if vv.name.stringView == name then return true
    }
    return false
}

# emitReturnCleanup -- free the registered owned locals (tmp.frees + tmp.listFrees)
# BEFORE a return, reclaiming them on the diverging path the function-end flush
# never reaches. Does NOT pop (other returns + the end flush still need them).
# Skips any local REFERENCED in the return expression `retExpr` (it is part of, or
# borrowed by, the return value) and any non-owning alias (`ctx.aliases`). A
# match-arm-narrowed subject is NOT skipped -- the arm aliases it via narrowBox (no
# shadow), so it stays a normal owned local whose destructor is correctly typed here.
emitReturnCleanup: function {
    ctx: Ctx.view
    tmp: TmpCtr.view
    retExpr: StringView
    keepRefd: bool
    ind: StringView
    buf: String.borrow
} is {
    fRi: u64
    for fRi < tmp.frees.length loop {
        fvR: tmp.frees.get i: fRi
        fRi = fRi + 1
        keepF: true
        if keepRefd then {
            if (refsLocal expr: retExpr name: fvR.name.stringView) then keepF = false
        }
        if (vvHas xs: ctx.aliases vid: fvR.vid) then keepF = false
        if keepF then {
            lfR: "\{ind}\{ctx.strC}_free(&\{fvR.name});\n"
            buf.append lfR
        }
    }
    li: u64
    nL: tmp.listFrees.length
    for li < nL loop {
        owed: tmp.listFrees.get i: li
        keepL: true
        if keepRefd then {
            if (refsLocal expr: retExpr name: owed.name.stringView) then keepL = false
        }
        if (vvHas xs: ctx.aliases vid: owed.vid) then keepL = false
        if keepL then buf.append owed.stmt
        li = li + 1
    }
    # a return exits every enclosing loop: emit each owned-payload loop's
    # per-iteration cleanup (empty for plain loops and do entries), unless
    # the payload is part of the return value or a non-owning alias.
    ci: u64
    cn: ctx.breakLabelCleanup.length
    for ci < cn loop {
        ccl0: ctx.breakLabelCleanup.get i: ci
        ccv0: ctx.breakLabelCleanupVar.get i: ci
        cRaw: ctx.breakLabelCleanupRaw.get i: ci
        if ccl0.length > 0 then {
            keepC: true
            if keepRefd then {
                if (refsLocal expr: retExpr name: ccv0.stringView) then keepC = false
            }
            if (vvHas xs: ctx.aliases vid: cRaw) then keepC = false
            if keepC then {
                lcr: "\{ind}\{ccl0}"
                buf.append lcr
            }
        }
        ci = ci + 1
    }
}

# emit a function's body.
emitFnBody: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    op: astnode.view
    fid: ztypes.tid
    buf: String.borrow
} is {
    {
        rbt: fnReturnTidOf :symtab tid: fid
        if rbt == 0 then rbt = fnReturnTypeId :ast :symtab :op
        ctx.refBorrowRet = (fnReturnsRefBorrow
            :ast
            :symtab
            :ctx
            :fid
            retTid: (ztypes.tid.create from: rbt.u64)
        )
    }
    if op.functiondef then {
        tmp: (TmpCtr n: 0 frees: (List OwedFree) listFrees: (List OwedFree))
        pids: ListVal u64
        pids9Nm: ListVal u64
        recFieldIds :symtab tid: fid ids: pids nameIds: pids9Nm
        pj: u64
        pn: pids9Nm.length
        for pj < pn loop {
            ppnB: (zast.poolTextAt
                pool: ast.names
                ref: (zast.nameid.create from: (pids9Nm.get i: pj))
            )
            ppn: ppnB.stringView
            ppid: pids.get i: pj
            if (symtab.typing.declOwnershipIs
                pool: ast.names
                parentTypeId: fid
                name: ppn
                own: ztypes.zparamownership.takeMode
            ) then {
                ptnm: regNameOf :symtab tid: (ztypes.tid.create from: ppid.u64)
                pmnB: (paramVidIn
                    :ast
                    :symtab
                    params: op.parameters
                    nameId: (zast.nameid.create from: (pids9Nm.get i: pj))
                )
                pmn: varCName :ctx vid: pmnB name: ppn
                if ppid == ctx.strTid then {
                    tmp.oweFree name: pmn.copy vid: pmnB
                } else {
                    # owned .take Set/Map params are skipped: declared by value, but a
                    # Set/Map _destroy frees the container as a heap pointer (would need
                    # &name); none exist in the self-host.
                    if (
                        (isHeapPtrCollection
                            :symtab
                            :ctx
                            tid: (ztypes.tid.create from: ppid.u64)
                        ) ==
                        false
                    ) then {
                        pcm: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: ppid.u64)
                        puse: pcm
                        if (symtab.reg.needsDestructor typeId: pcm) == false then {
                            prbn: (canonTypeId
                                :ast
                                :symtab
                                :ctx
                                tid: (ztypes.tid.create from: ppid.u64)
                                name: ptnm.stringView
                            )
                            if prbn > 0 then puse = ztypes.tid.create from: prbn.u64
                        }
                        if (symtab.reg.needsDestructor typeId: puse) then {
                            pcb: ctxCname :ctx tid: (ztypes.tid.create from: puse.u64)
                            pdf: "    \{pcb}_destroy(&\{pmn});\n"
                            tmp.oweList stmt: pdf.copy name: pmn.copy vid: pmnB
                        }
                    }
                }
            }
            pj = pj + 1
        }
        endsRet: false
        if op.body > 0 then {
            opb: ast.nodes.get i: op.body.u64
            rbnId: (ztypecheck.fnReturnBaseNameIdOf :ast op: (ast.nodes.get i: op.nodeid.u64))
            if rbnId.isZero == false when ctx.genActive == false then ctx.tailRetActive = true
            emitBodyNode :ast :symtab :ctx n: opb ind: "    " :tmp :buf
            ctx.tailRetActive = false
            endsRet = blockDiverges :ast :symtab :ctx n: opb
        }
        # a body that diverges on every path never reaches this flush; the
        # return/break cleanups already freed the same locals on those paths
        if endsRet == false then {
            fiter: tmp.frees.iterate
            for fv: fiter loop {
                lf: "    \{ctx.strC}_free(&\{fv.name});\n"
                buf.append lf
            }
            lfi: tmp.listFrees.iterate
            for lfs: lfi loop buf.append lfs.stmt
        }
    }
}

# collectUnitLiterals -- pool the plain literals of every main-unit
# function body.
collectUnitLiterals: function {
    program: Ast.view
    symtab: zenv.ZSymbolTable.view
    ids: ListVal u64
    texts: List String
} is {
    {
        uCnt9f: program.units.length
        uIdx9f: u64
        for uIdx9f < uCnt9f loop {
            uId: (zast.nodeid.create from: (program.units.get i: uIdx9f))
            uIdx9f = uIdx9f + 1
            opId: zast.nodeid
            unitNameText: String
            {
                u: program.nodes.get i: uId.u64
                if u.namedoperation then {
                    un: zast.poolTextAt pool: program.names ref: u.name
                    opId = u.operation
                    unitNameText = un.copy
                }
            }
            if opId > 0 then {
                (collectUnitLiteralsIn
                    ast: program
                    mainOpId: opId
                    :symtab
                    unitName: unitNameText.stringView
                    :ids
                    :texts
                )
            }
        }
    }
}

# collect a unit's string literals for the literal pool.
collectUnitLiteralsIn: function {
    ast: Ast.view
    mainOpId: zast.nodeid
    symtab: zenv.ZSymbolTable.view
    unitName: StringView
    ids: ListVal u64
    texts: List String
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: mainOpId
    vx309: u64
    for vx309 < bodyIds.count.u64 loop {
        bm: zast.kidAt kids: ast.kids span: bodyIds i: vx309
        vx309 = vx309 + 1
        bmNode: ast.nodes.get i: bm.u64
        if bmNode.namedoperation then {
            bn: zast.nameTextAt :ast ref: bmNode.name
            skipU: (stdFnUndemanded
                :ast
                :symtab
                :unitName
                fnName: bn.stringView
                ownerTid: ztypes.tid
                wantWalked: false
            )
            if skipU == false then (collectFnLiterals
                :ast
                n: (ast.nodes.get i: bmNode.operation.u64)
                :ids
                :texts
            )
        }
    }
}

# collect a function's string literals for the literal pool.
collectFnLiterals: function {
    ast: Ast.view
    n: astnode.view
    ids: ListVal u64
    texts: List String
} is {
    match (
        n
    ) case functiondef then {
        if n.body > 0 then collectLiterals :ast n: (ast.nodes.get i: n.body.u64) :ids :texts
    } case objectdef then {
        isx1879: u64
        for isx1879 < n.isItems.count.u64 loop {
            imId: zast.kidAt kids: ast.kids span: n.isItems i: isx1879
            isx1879 = isx1879 + 1
            im: ast.nodes.get i: imId.u64
            if im.namedoperation then {
                collectFnLiterals :ast n: (ast.nodes.get i: im.operation.u64) :ids :texts
            }
        }
        asx1699: u64
        for asx1699 < n.asItems.count.u64 loop {
            amId: zast.kidAt kids: ast.kids span: n.asItems i: asx1699
            asx1699 = asx1699 + 1
            am: ast.nodes.get i: amId.u64
            if am.namedoperation then {
                collectFnLiterals :ast n: (ast.nodes.get i: am.operation.u64) :ids :texts
            }
        }
    } case unitdef then {
        box2029: u64
        for box2029 < n.body.count.u64 loop {
            ubm: zast.kidAt kids: ast.kids span: n.body i: box2029
            box2029 = box2029 + 1
            ubn: ast.nodes.get i: ubm.u64
            if ubn.namedoperation then {
                collectFnLiterals :ast n: (ast.nodes.get i: ubn.operation.u64) :ids :texts
            }
        }
    } else null
}

# emitLiteralPools -- the two string pools, written ahead of the code they serve:
# the source literals, filtered to the ones an emission actually referenced, and
# the folded-constant pool, whose every entry was minted BY an emission and so
# has nothing unused to skip.
emitLiteralPools: function {
    ctx: Ctx.view
    litTexts: (List String).view
    poolBuf: String.borrow
} is {
    pi: u64
    pn: ctx.litIds.length
    for pi < pn loop {
        plid: ctx.litIds.get i: pi
        if (ctx.usedLits.has item: plid) then {
            pt: litTexts.get i: pi
            ptv: pt.stringView
            pesc: cEscape text: ptv
            pblen: ptv.length
            pidx: pi + 1
            poolDataDecl: "static const char _zs\{pidx}_d[] = \"\{pesc}\";\n"
            poolBuf.append poolDataDecl
            poolViewDecl: "static const \{ctx.svC}_t _zs\{pidx} = { .data = _zs\{pidx}_d, .size = \{pblen} };\n"
            poolBuf.append poolViewDecl
        }
        pi = pi + 1
    }
    # the folded-string pool, written after the literal one and into the same
    # buffer, so both precede the code. Every entry here was minted BY an
    # emission that asked for it, so there is nothing unused to skip.
    ci: u64
    cn9p: ctx.constLits.length
    for ci < cn9p loop {
        cTypeText: ctx.constLits.get i: ci
        ctv: cTypeText.stringView
        cesc: cEscape text: ctv
        cblen: ctv.length
        cidx: ci + 1
        constDataDecl: "static const char _zcs\{cidx}_d[] = \"\{cesc}\";\n"
        poolBuf.append constDataDecl
        constViewDecl: "static const \{ctx.svC}_t _zcs\{cidx} = { .data = _zcs\{cidx}_d, .size = \{cblen} };\n"
        poolBuf.append constViewDecl
        ci = ci + 1
    }
}

# assembleEmitOutput -- the file's final order: the prelude fragment (a unit of its
# own precisely because a need registered inside a type method is still in time
# for it, and no codeBuf walk may claim it), then the literal pools, the code, the
# function bodies and C's `main`.
assembleEmitOutput: function {
    program: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    errs: List String
    buf: String.borrow
    poolBuf: StringView
    codeBuf: StringView
    fnsBuf: StringView
} is {
    # every body has emitted by now, so a need registered inside a type
    # method -- which emits after the runtime pass -- is still in time. This is
    # why `prelude` is a unit of its own: it goes into the header, ahead of the
    # literal pool, and no codeBuf walk may claim it.
    {
        (emitRuntimeUnit
            ast: program
            :symtab
            :ctx
            :runtimeDir
            uname: "prelude"
            :buf
        )
    }
    buf.reserve n: poolBuf.length + codeBuf.length + fnsBuf.length + 4096
    buf.append poolBuf
    buf.append "\n"
    buf.append codeBuf
    buf.append fnsBuf
    buf.append "int main(int argc, char* argv[]) {\n"
    if (needsHasM :ctx uname: "os" memb: "args") then {
        buf.append "    z_os_argc_g = argc;\n"
        buf.append "    z_os_argv_g = argv;\n"
    }
    buf.append "    z_siphash_init();\n"
    buf.append "    z_main();\n"
    buf.append "    return 0;\n"
    buf.append "}\n"
    with eeit: ctx.emitErrors.iterate do for ee: eeit loop errs.append from: ee.copy
}

# emitCHeader -- the file's fixed header: the link libraries the reached units
# declared (so whatever drives the compiler reads them off the artifact instead
# of being told separately), then the prelude fragment -- the feature macros,
# the includes, and the allocator wrappers everything else is built on. The
# prelude is the same bytes in every program, so it is a runtime fragment and
# not a hundred appends.
emitCHeader: function {
    libs: (List String).view
    runtimeDir: StringView
    errs: List String
    buf: String.borrow
} is {
    # the link libraries the reached units declared, so whatever drives the C
    # compiler -- zc itself, the corpus runner, a hand-run cc -- reads them off
    # the artifact instead of being told separately. Fixed line, always present.
    buf.append "/* zlink:"
    with lit9z: libs.iterate do for lb9z: lit9z loop {
        buf.append " "
        buf.append lb9z
    }
    buf.append " */\n"
    buf.append "\n"
    p0: "\{runtimeDir}/z_prelude.inc"
    buf.append (loadFragment path: p0.stringView svC: "" strC: "" fails: errs)
}

# the three runtime types the emitter must name before anything else: String,
# StringView, and the C-error record. They are resolved by ID out of the system
# unit, never by the C names the fragments use.
runtimetids: record {
    # String's type id
    str: ztypes.tid
    # StringView's type id
    sv: ztypes.tid
    # converror's type id. The three are fetched together because every emit
    # path needs at least one
    cerr: ztypes.tid
}

# resolveRuntimeTids -- resolve those three, or leave a tid 0 where the program
# registers none (a unit with no main and no strings registers neither).
resolveRuntimeTids: function {
    program: Ast.view
    symtab: zenv.ZSymbolTable.view
} out runtimetids is {
    strId: ztypes.tid
    svId: ztypes.tid
    sysId: zast.nameid
    strNmId: zast.nameid
    svNmId: zast.nameid
    {
        sysId = zast.poolFind pool: program.names text: "system"
        strNmId = zast.poolFind pool: program.names text: "String"
        svNmId = zast.poolFind pool: program.names text: "StringView"
    }
    sgo: optionval.none u64
    {
        ud11x: ztypecheck.unitDeclOfName st: symtab nameId: sysId
        sgo = (ztypecheck.resolvedByIdsRo
            ast: program
            st: symtab
            unitDecl: ud11x
            name: strNmId
        )
    }
    match (
        sgo
    ) case some then {
        strId = ztypes.tid.create from: sgo
    } case none then null
    vgo: optionval.none u64
    {
        ud12x: ztypecheck.unitDeclOfName st: symtab nameId: sysId
        vgo = (ztypecheck.resolvedByIdsRo
            ast: program
            st: symtab
            unitDecl: ud12x
            name: svNmId
        )
    }
    match (
        vgo
    ) case some then {
        svId = ztypes.tid.create from: vgo
    } case none then null
    cerrId: ztypes.tid
    cgo: optionval.none u64
    {
        ud13x: ztypecheck.unitDeclOfName st: symtab nameId: sysId
        cgo = (ztypecheck.resolvedByIdsRo
            ast: program
            st: symtab
            unitDecl: ud13x
            name: (zast.poolFind pool: program.names text: "converror")
        )
    }
    match (
        cgo
    ) case some then {
        cerrId = ztypes.tid.create from: cgo
    } case none then null
    return (runtimetids str: strId sv: svId cerr: cerrId)
}

# collectRnBareVids -- the variables --readable-names may spell by their source
# name alone. Every runtime variable is a declaration row carrying its name,
# the frame that binds it and its variable id, and frames chain up to the
# function they belong to: the FIRST row a (function, name) pair produces keeps
# the bare spelling, and every later one is spelled with its id. A variable no
# declaration row names -- one a lowering mints outside any frame -- is absent
# here and is spelled with its id too, which is what makes the scheme unique by
# construction rather than by enumeration.
collectRnBareVids: function {symtab: zenv.ZSymbolTable.view bare: IdSet ztypes.vid} is {
    seenKeys: IdSet u64
    dn: symtab.typing.decls.length
    di: u64
    for di < dn loop {
        rvid: ztypes.vid
        rnm: u64
        rpar: ztypes.declid
        {
            d9r: symtab.typing.decls.get i: di
            rvid = d9r.varId
            rnm = d9r.name.u64
            rpar = d9r.parent
        }
        di = di + 1
        if rvid.isZero == false when rnm > 0 then {
            fnd: rpar
            for (symtab.typing.declIsFrame declId: fnd) loop {
                fnd = symtab.typing.declParentOf declId: fnd
            }
            rkey: (fnd.u64 * 4294967296) + rnm
            if (seenKeys.add item: rkey) then bare.add item: rvid
        }
    }
}

# buildTypeCnames -- the C name of every registered type, indexed by tid, built
# once so no later emission has to ask the registry by name.
buildTypeCnames: function {
    symtab: zenv.ZSymbolTable.view
    readableNames: bool
    typeCnames: List String
} is {
    ctb: ztypes.tid
    ctlast: symtab.reg.nextTypeId
    for ctb < ctlast loop {
        cn: String
        if (symtab.reg.typeValid tid: ctb) then {
            if readableNames then {
                onm: String
                oti: symtab.reg.ownerTidOf tid: ctb
                if oti > 0 then onm = symtab.reg.nameOf tid: oti
                tnm: symtab.reg.nameOf tid: ctb
                cn = (cnameOf
                    tid: (ztypes.tid.create from: ctb.u64)
                    ownerName: onm.stringView
                    name: tnm.stringView
                )
            } else {
                cn = cnameById tid: (ztypes.tid.create from: ctb.u64)
            }
        }
        typeCnames.append cn
        ctb = ztypes.tid.create from: (ctb + 1)
    }
}

# emitStringFragments -- the String, StringView and hash runtime fragments, plus
# the destructor aliases a String-typedef class needs: it SHARES the String
# struct, so its registered destructor is aliased to the String free and every
# generic destroy site links (an unused wrapper is fine, -Wno-unused-function).
emitStringFragments: function {
    symtab: zenv.ZSymbolTable.view
    runtimeDir: StringView
    errs: List String
    buf: String.borrow
    strC: StringView
    svC: StringView
    strId: ztypes.tid
    typeCnames: (List String).view
} is {
    p1: "\{runtimeDir}/z_String.inc"
    f1: loadFragment path: p1.stringView :svC :strC fails: errs
    buf.append f1
    # a String-typedef class (Path) shares the String struct: alias its
    # registered destructor to the String free so every generic destroy
    # site links (unused wrappers are fine: -Wno-unused-function)
    with sdit: symtab.typing.typedefBaseTid.iterateItems do for sde: sdit loop {
        if sde.value == strId then {
            if (symtab.reg.needsDestructor typeId: (ztypes.tid.create from: sde.key)) then {
                sdc: listCname cnames: typeCnames tid: (ztypes.tid.create from: sde.key)
                sdw: "static void \{sdc}_destroy(\{strC}_t* p) { \{strC}_free(p); }\n"
                buf.append sdw
            }
        }
    }
    p2: "\{runtimeDir}/z_StringView.inc"
    f2: loadFragment path: p2.stringView :svC :strC fails: errs
    buf.append f2
    ph: "\{runtimeDir}/z_hash.inc"
    fh: loadFragment path: ph.stringView :svC :strC fails: errs
    buf.append fh
}

# emitCodeBody -- everything that references a `_zsN` literal goes into codeBuf
# FIRST (each reference marks ctx.usedLits through litIndexOf), so the pool that
# precedes it in the file can be written with only the entries an emission asked
# for. The monos come before the runtime fragments: a fragment dereferences the
# layouts of the types it serves, so those must already be complete.
emitCodeBody: function {
    program: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    runtimeDir: StringView
    nodeEstE: u64
    codeBuf: String.borrow
} is {
    codeBuf.reserve n: nodeEstE * 8
    {
        emitMonos ast: program :symtab :ctx :runtimeDir buf: codeBuf
        # ahead of the runtime fragments: those dereference the layouts of the
        # types they serve, so anything a fragment touches must already be
        # complete, and this is the pass that orders by-value embedding in both
        # directions (a user struct inside a mono, a mono inside a user struct)
        emitFnptrTypedefs ast: program :symtab :ctx buf: codeBuf
        emitUserStructsOrdered ast: program :symtab :ctx :runtimeDir buf: codeBuf
        # File's methods are demanded by the class being REACHABLE rather than
        # by a call, so the injection runs before any row is consulted
        if (ioFileLive ast: program :symtab :ctx) then {
            needsAddM :ctx uname: "io" memb: "@unit"
            needsAddM :ctx uname: "io" memb: "file_close"
            needsAddM :ctx uname: "io" memb: "file_read"
            needsAddM :ctx uname: "io" memb: "file_write"
            needsAddM :ctx uname: "io" memb: "file_seek"
            needsAddM :ctx uname: "io" memb: "file_flush"
        }
        # every unit's runtime, in the order the table gives. The two io
        # emitters between io and cli generate C rather than load fragments, so
        # they stay named here -- they are the one seam the rows cannot state.
        # the unit order is copied first: the runtime emitters below lend ctx
        uos: List String
        with uoc: ctx.unitOrder.iterate do for uo0: uoc loop uos.append uo0.copy
        with uoit: uos.iterate do for uo: uoit loop {
            (emitRuntimeUnit
                ast: program
                :symtab
                :ctx
                :runtimeDir
                uname: uo.stringView
                buf: codeBuf
            )
            if uo.stringView == "io" then {
                emitIoFileConformance ast: program :symtab :ctx buf: codeBuf
                emitIoStdStreams ast: program :symtab :ctx buf: codeBuf
            }
        }
        (emitUnorderedUnits
            ast: program
            :symtab
            :ctx
            :runtimeDir
            buf: codeBuf
        )
    }
}


# emitC -- emit the C translation unit for a typechecked program.
emitC: function {
    program: Ast.view
    symtab: zenv.ZSymbolTable
    runtimeDir: StringView
    fastHash: bool
    readableNames: bool
    errs: List String
    libs: (List String).view
} out String is {
    buf: String
    buf.append "/* Generated by zerolang compiler */\n"
    emitCHeader :libs :runtimeDir :errs :buf
    rtids: resolveRuntimeTids :program :symtab
    strId: rtids.str
    svId: rtids.sv
    cerrId: rtids.cerr
    typeCnames: List String
    buildTypeCnames :symtab :readableNames :typeCnames
    strC: listCname cnames: typeCnames tid: strId
    svC: listCname cnames: typeCnames tid: svId
    # tid 0 is the "no type" sentinel, so a unit that registers neither String
    # nor StringView -- one with no main and no strings -- would hand both
    # runtime structs the same cname and emit two conflicting typedefs. The
    # fragments' own names are unique and already in the text.
    if strId.isZero then strC = "z_String".string
    if svId.isZero then svC = "z_StringView".string
    origins: ListVal ztypes.tid
    buildOriginTids :program :symtab acc: origins
    mnames: ListVal zast.nameid
    buildMemberNameIds :program acc: mnames
    (emitStringFragments
        :symtab
        :runtimeDir
        :errs
        :buf
        strC: strC.stringView
        svC: svC.stringView
        :strId
        :typeCnames
    )
    mn: mainCName :program
    litIds: ListVal u64
    litTexts: List String
    collectUnitLiterals :program :symtab ids: litIds texts: litTexts
    rm: mn.copy
    rnBare: IdSet ztypes.vid
    if readableNames then collectRnBareVids :symtab bare: rnBare
    ctx: (Ctx
        mainName: mn
        nsTid: ztypes.tid
        realMain: rm
        :fastHash
        :readableNames
        rnBareVids: rnBare
        :strC
        :svC
        cnames: typeCnames
        :litIds
        usedLits: (IdSet u64)
        constLits: (List String)
        tailRetActive: false
        defUnitId: (IdMapV u64 v: u64)
        ioUnitDecl: 0
        osUnitDecl: 0
        cliUnitDecl: 0
        netUnitDecl: 0
        ioFileTid: 0
        netListenerTid: 0
        netConnTid: 0
        unitTidsC: (ListVal ztypes.tid)
        unitKeysC: (List String)
        unitCacheBuilt: false
        :mnames
        resolveByNameC: (IdMapV u64 v: u64)
        mainUnitId: ztypes.declid
        condDepth: 0
        emitErrors: (List String)
        needUnits: (List String)
        needMembs: (List String)
        dataElems: (IdMapR ztypes.tid V: String)
        dataConst: (MapVR dataconstkey V: String)
        dataSlot: (MapVR dataslotkey V: String)
        ptrVids: (ListVal ztypes.vid)
        refBorrowRet: false
        aliases: (List VidVal)
        narrowBox: (List VidVal)
        narrowTid: (List VidTid)
        exclArms: (List VidVal)
        exclTids: (List VidTid)
        genActive: false
        genRecvC: "this".string
        genValC: "value".string
        genYieldCount: 0
        genYieldNext: 0
        genForNext: 0
        genForSpills: (List ForSpill)
        yieldTempK: (IdMapV u64 v: u64)
        genWrap: "".string
        genSomeTag: "".string
        genNoneTag: "".string
        genPayC: "".string
        genHasValue: false
        curThisTid: ztypes.tid
        emittedUserTypes: (IdSet u64)
        tagStems: (MapRV String v: u64)
        fwdDeclaredTypes: (IdSet u64)
        tmplCache: (Map String V: String)
        ioCanonC: (Map String V: String)
        nativeTbl: (Map String V: String)
        nativeConstBody: (Map String V: String)
        nativeConstPos: (Map String V: String)
        nativeNeed: (Map String V: String)
        nativePtrArgs: (MapRV String v: bool)
        nativeKeys: (MapRV String v: bool)
        nativeFold: (MapRV String v: bool)
        nativeFragPaths: (MapRV String v: bool)
        nativeConvMemb: (MapRV String v: bool)
        nativeArgMemb: (MapRV String v: bool)
        fragUnits: (List String)
        fragMembs: (List String)
        fragNames: (List String)
        fragTypeNames: (List String)
        fragTypeTids: (ListVal u64)
        demandGatedTids: (IdSet u64)
        usedTypeIds: (IdSet u64)
        emittedConformance: (IdSet u64)
        unitOrder: (List String)
        argHoistNames: (List String)
        argHoistVals: (List String)
        argHoistTypes: (List String)
        argHoistDtors: (List String)
        argHoistRaw: (List String)
        argHoistCtr: 0
        whenGuardCtr: 0
        breakLabels: (ListVal u64)
        breakLabelIsDo: (ListVal bool)
        contLabelUsed: (IdMapV u64 v: bool)
        breakLabelCtr: 0
        breakLabelUsed: (IdMapV u64 v: bool)
        breakFreesMarks: (ListVal u64)
        breakListMarks: (ListVal u64)
        breakLabelCleanup: (List String)
        breakLabelCleanupVar: (List String)
        breakLabelCleanupRaw: (ListVal ztypes.vid)
        borrowedVars: (IdMapV u64 v: bool)
        colGetFromCode: false
        strTid: (ztypes.tid.create from: strId.u64)
        svTid: (ztypes.tid.create from: svId.u64)
        converrorTid: (ztypes.tid.create from: cerrId.u64)
        :origins
    )
    {
        lgp: "\{runtimeDir}/z_List.c.tmpl"
        lgt: readTemplateCached :ctx path: lgp.stringView
        lgv: lgt.stringView
        if lgv.length > 0 when (lgv.contains needle: "_get(") == false then {
            ctx.colGetFromCode = true
        }
    }
    loadNativeTbl :ctx :runtimeDir
    {
        buildDefUnitIndex :symtab :ctx ast: program
        bindFragTypeTids :symtab :ctx ast: program
        rmn: ctx.realMain.copy
        (ctxBindMain
            :ctx
            name: rmn.stringView
            unitDecl: (unitDeclByName :symtab ast: program name: rmn.stringView)
        )
    }
    checkLoadedNatives :program :ctx
    fillDataElems :program :symtab :ctx
    fillNeeds :program :symtab :ctx
    nodeEstE: u64
    nodeEstE = program.nodes.length
    fnsBuf: String
    fnsBuf.reserve n: nodeEstE * 24
    emitFns :program :symtab :ctx buf: fnsBuf
    hasMain: programHasMain :program
    if hasMain == false then {
        fnsBuf.append "void z_main(void) {\n"
        fnsBuf.append "}\n\n"
    }
    codeBuf: String
    emitCodeBody :program :symtab :ctx :runtimeDir :nodeEstE :codeBuf
    emitRecordDefs :program :symtab :ctx buf: codeBuf
    poolBuf: String
    emitLiteralPools :ctx :litTexts :poolBuf
    (assembleEmitOutput
        :program
        :symtab
        :ctx
        :runtimeDir
        :errs
        :buf
        poolBuf: poolBuf.stringView
        codeBuf: codeBuf.stringView
        fnsBuf: fnsBuf.stringView
    )
    return buf
}

# true when the program defines a `main`.
programHasMain: function {program: Ast.view} out bool is {
    mainName: program.mainUnitName.stringView
    uCnt9g: program.units.length
    uIdx9g: u64
    for uIdx9g < uCnt9g loop {
        uId: (zast.nodeid.create from: (program.units.get i: uIdx9g))
        uIdx9g = uIdx9g + 1
        opId: zast.nodeid
        {
            u: program.nodes.get i: uId.u64
            if u.namedoperation then {
                un: zast.poolTextAt pool: program.names ref: u.name
                if un.stringView == mainName then opId = u.operation
            }
        }
        if opId > 0 then {
            if (unitHasMain ast: program mainOpId: opId) then return true
        }
    }
    return false
}

# true when a unit defines a `main`.
unitHasMain: function {ast: Ast.view mainOpId: zast.nodeid} out bool is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: mainOpId
    vx319: u64
    for vx319 < bodyIds.count.u64 loop {
        bm: zast.kidAt kids: ast.kids span: bodyIds i: vx319
        vx319 = vx319 + 1
        bmNode: ast.nodes.get i: bm.u64
        if bmNode.namedoperation then {
            bn: zast.nameTextAt :ast ref: bmNode.name
            if bn.stringView == "main" then return true
        }
    }
    return false
}

# the path to a native runtime fragment under `runtimeDir`.
nativePath: function {runtimeDir: StringView frag: StringView} out String is {
    p: "\{runtimeDir}/natives/\{frag}.inc"
    return p
}

# cbaseNoPrefix -- the id-based cname without the leading "z_" (the runtime
# templates spell z_@@NAME@@, so NAME omits the prefix).
cbaseNoPrefix: function {ctx: Ctx.view tid: ztypes.tid} out String is {
    full: ctxCname :ctx :tid
    fl: full.length
    rest: (full.substring from: 2 to: fl)
    return rest.string
}

# applyTmpl -- substitute one @@KEY@@ placeholder in template text.
applyTmpl: function {text: String key: StringView val: StringView} out String is {
    needle: "@@\{key}@@"
    return (substituteAll :text needle: needle.stringView repl: val)
}

# monoOriginName -- the template name a mono derives from (List/Map/Set),
# "" when not a mono.
monoOriginName: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out String is {
    # partial specs (GENERIC_PARAM typetype) are trie bookkeeping, not monos
    if (symtab.reg.typetypeOf typeId: tid) == ztypes.ztypetype.genericParam then return "".string
    go: genericOriginTid :symtab :tid
    if go > 0 then return (regNameOf :symtab tid: go)
    return "".string
}

# listElemType -- a List/ListView mono's element type id (the get-child
# return), 0 when absent.
listElemType: function {symtab: zenv.ZSymbolTable.view monoId: ztypes.tid} out ztypes.tid is {
    go: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.names.wkGet
    match (
        go
    ) case some then {
        return (symtab.reg.returnTypeOf tid: (ztypes.tid.create from: go.u64))
    } case none then null
    return (ztypes.tid.create from: 0)
}

# ctypeOrI64 -- the given C type name as an owned String, or int64_t
# when empty.
ctypeOrI64: function {s: StringView} out String is {
    if s.length > 0 then {
        return s.string
    } else {
        return "int64_t".string
    }
}

# emitArrayMono -- the array instance's runtime substitution, emitListMono's
# twin: the element mono supplies both the C element type and the `==` companion
# a linear scan needs.
emitArrayMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    mn: regNameOf :symtab tid: monoId
    nm: cbaseNoPrefix :ctx tid: monoId
    eid: listElemType :symtab :monoId
    eln: regNameOf :symtab tid: (ztypes.tid.create from: eid.u64)
    ect0: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: eid.u64) thisTid: ztypes.tid
    ect: ctypeOrI64 s: ect0.stringView
    lenPfx: eln.length + 7
    lenStr: monoElemName full: mn prefixLen: lenPfx
    createBody: "    z_\{nm}_t _this = {0};"
    eqBody: String
    eqo: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.names.wkOpEq
    match (
        eqo
    ) case some then {
        eqBody = "static bool z_\{nm}_eq(z_\{nm}_t a, z_\{nm}_t b) {\n    for (int _i = 0; _i < \{lenStr.stringView}; _i++) { if (a.data[_i] != b.data[_i]) return false; }\n    return true;\n}\n"
    } case none then null
    p: "\{runtimeDir}/z_array.c.tmpl"
    raw: readTemplateCached :ctx path: p.stringView
    if raw.length > 0 then {
        t1: applyTmpl text: raw key: "NAME" val: nm.stringView
        t2: applyTmpl text: t1 key: "ELEM_T" val: ect.stringView
        t3: applyTmpl text: t2 key: "LEN" val: lenStr.stringView
        t4: applyTmpl text: t3 key: "CREATE_BODY" val: createBody.stringView
        t5: applyTmpl text: t4 key: "EQ_BODY" val: eqBody.stringView
        buf.append t5
        buf.append "\n"
    }
}

# capLenT -- the C length-field type for a str mono of the given capacity:
# uint8/16/32 by capacity, keeping small str monos compact.
capLenT: function {cap: StringView} out String is {
    v: u64
    i: u64
    n: cap.length
    for i < n loop {
        bo: cap.byteAt :i
        match (
            bo
        ) case some then {
            v = (v * 10) + (bo - 48).u64
        } case none then null
        i = i + 1
    }
    if v <= 255 then return "uint8_t".string
    if v <= 65535 then return "uint16_t".string
    return "uint32_t".string
}

# emitStrMono -- a str valtype mono (fixed-capacity inline string). Substitutes
# z_str.c.tmpl (struct + create + .string + String_to_<name>). Read via
# loadFragment so the template's canonical z_String becomes ctx.strC.
# Capacity is the trailing segment of the mono name (str_<cap>), prefix "str_"=4.
emitStrMono: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    mn: regNameOf :symtab tid: monoId
    nm: cbaseNoPrefix :ctx tid: monoId
    capStr: monoElemName full: mn prefixLen: 4
    lenT: capLenT cap: capStr.stringView
    eqBody: String
    eqo: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.names.wkOpEq
    match (
        eqo
    ) case some then {
        eqBody = "static bool z_\{nm}_eq(z_\{nm}_t a, z_\{nm}_t b) {\n    return a.len == b.len && memcmp(a.data, b.data, a.len) == 0;\n}\n"
    } case none then null
    p: "\{runtimeDir}/z_str.c.tmpl"
    svL: ctx.svC
    strL: ctx.strC
    raw: (loadFragment
        path: p.stringView
        svC: svL.stringView
        strC: strL.stringView
        fails: ctx.emitErrors
    )
    t1: applyTmpl text: raw key: "NAME" val: nm.stringView
    t2: applyTmpl text: t1 key: "CAP" val: capStr.stringView
    t3: applyTmpl text: t2 key: "LEN_T" val: lenT.stringView
    t4: applyTmpl text: t3 key: "EQ_BODY" val: eqBody.stringView
    buf.append t4
    buf.append "\n"
}

# emitBoxMono -- a builtin Box mono (heap pointer). No struct (the type is
# <inner>*); emit only the destructor: free the inner (String/destructor) then
# the cell.
emitBoxMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    monoId: ztypes.tid
    buf: String.borrow
} is {
    mn: regNameOf :symtab tid: monoId
    nm: cbaseNoPrefix :ctx tid: monoId
    beName: monoElemName full: mn prefixLen: 4
    beid: resolveTypeIdByName :ast :symtab :ctx name: beName.stringView
    # the parameter is void*: a Box leaf's destroy may precede its element's
    # struct definition (a Box over a late-emitted system record), and the
    # body never needs the type -- a boxed element is a valtype, so the only
    # live action is freeing the cell (the String/dtor legs below are
    # bound-impossible today and convert implicitly if ever reached).
    bdecl: "static void z_\{nm}_destroy(void* v);\n"
    buf.append bdecl
    bsig: "static void z_\{nm}_destroy(void* v) {\n"
    buf.append bsig
    buf.append "    if (!v) return;\n"
    if beid == ctx.strTid then {
        bfree: "    \{ctx.strC}_free(v);\n"
        buf.append bfree
    } else {
        if (symtab.reg.needsDestructor typeId: (ztypes.tid.create from: beid.u64)) then {
            bicb: ctxCname :ctx tid: (ztypes.tid.create from: beid.u64)
            bidf: "    \{bicb}_destroy(v);\n"
            buf.append bidf
        }
    }
    buf.append "    free(v);\n"
    buf.append "}\n\n"
}

# emitListMethodOnDemand -- write one List template method, but only when the
# program actually calls it on THIS instance. `usedMemberDecl` holds the member
# declarations a use site resolved; the INSTANCE's own member is the question,
# because refDecl records the template's and so answers for every instance at
# once. A method nothing calls is a dead C function in every program that names
# the collection at all.
emitListMethodOnDemand: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    monoId: ztypes.tid
    nameId: zast.nameid
    file: StringView
    nm: StringView
    ect: StringView
    buf: String.borrow
} is {
    md: symtab.typing.declMemberIdOf parentTypeId: monoId :nameId
    if md.isZero then return
    if (symtab.typing.usedMemberDecl.has item: md.u64) == false then return
    fp: "\{runtimeDir}/\{file}"
    raw: readTemplateCached :ctx path: fp.stringView
    if raw.length == 0 then return
    f1: applyTmpl text: raw key: "NAME" val: nm
    f2: applyTmpl text: f1 key: "ELEM_T" val: ect
    buf.append f2
    buf.append "\n"
}

# emitListMono -- substitute z_List.c.tmpl for a List instance + the
# linear-scan contains companion (scalar element equality).
emitListMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    eid: listElemType :symtab :monoId
    eln: regNameOf :symtab tid: (ztypes.tid.create from: eid.u64)
    isStrEl: false
    if eid == ctx.strTid then isStrEl = true
    isSvEl: false
    if eid == ctx.svTid then isSvEl = true
    ect0: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: eid.u64) thisTid: ztypes.tid
    ect: ctypeOrI64 s: ect0.stringView
    p: "\{runtimeDir}/z_List.c.tmpl"
    raw: readTemplateCached :ctx path: p.stringView
    if raw.length == 0 then return
    {
        t1: applyTmpl text: raw key: "NAME" val: nm.stringView
        t2: applyTmpl text: t1 key: "ELEM_T" val: ect.stringView
        delems: String
        if isStrEl then {
            delems = "    for (uint64_t _di = 0; _di < p->length; _di++) {\n        \{ctx.strC}_free(&p->data[_di]);\n    }\n"
        } else {
            ecid: eid
            if (symtab.reg.needsDestructor typeId: ecid) == false then {
                rbn: (canonTypeId
                    :ast
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: eid.u64)
                    name: eln.stringView
                )
                if rbn > 0 then ecid = ztypes.tid.create from: rbn.u64
            }
            if (symtab.reg.needsDestructor typeId: ecid) then {
                ecb: ctxCname :ctx tid: (ztypes.tid.create from: ecid.u64)
                delems = "    for (uint64_t _di = 0; _di < p->length; _di++) {\n        \{ecb}_destroy(&p->data[_di]);\n    }\n"
            }
        }
        t3: applyTmpl text: t2 key: "DESTROY_ELEMS" val: delems.stringView
        lvm: listviewMethods :ctx :symtab :monoId nm: nm.stringView ect: ect.stringView
        t4: applyTmpl text: t3 key: "LISTVIEW_METHODS" val: lvm.stringView
        buf.append t4
        buf.append "\n"
    }
    # insert and extend are their own fragments, written only for an instance
    # that calls them. Every List instance used to carry both, and in the
    # compiler's own C half of them were never called
    (emitListMethodOnDemand
        :symtab
        :ctx
        :runtimeDir
        :monoId
        nameId: zast.names.wkInsert
        file: "z_List_insert.c.tmpl"
        nm: nm.stringView
        ect: ect.stringView
        :buf
    )
    (emitListMethodOnDemand
        :symtab
        :ctx
        :runtimeDir
        :monoId
        nameId: zast.names.wkExtend
        file: "z_List_extend.c.tmpl"
        nm: nm.stringView
        ect: ect.stringView
        :buf
    )
    if ctx.colGetFromCode then {
        (emitColGet
            nm: nm.stringView
            ect: ect.stringView
            kind: "List"
            ptr: (elemBorrowsByPtr :ast :symtab :ctx tid: (ztypes.tid.create from: eid.u64))
            mutPtr: (elemRefByPtr :ast :symtab :ctx tid: (ztypes.tid.create from: eid.u64))
            :buf
        )
    }
    co: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.names.wkContains
    match (
        co
    ) case some then {
        c0: "static bool z_\{nm}_contains(const z_\{nm}_t* _this, \{ect} _needle);\n"
        buf.append c0
        c1: "static bool z_\{nm}_contains(const z_\{nm}_t* _this, \{ect} _needle) {\n"
        buf.append c1
        buf.append "    for (uint64_t i = 0; i < _this->length; i++) {\n"
        if isStrEl then {
            buf.append "        if (_this->data[i].size == _needle.size && memcmp(_this->data[i].data, _needle.data, _needle.size) == 0) return true;\n"
        } else if isSvEl then {
            buf.append "        if (_this->data[i].size == _needle.size && memcmp(_this->data[i].data, _needle.data, _needle.size) == 0) return true;\n"
        } else if (keyHashKind :symtab :ctx tid: (ztypes.tid.create from: eid.u64)) == 3 then {
            # a by-value STRUCT element: C `==` does not apply to it. Same
            # byte comparison Set already uses for its elements.
            buf.append "        if (memcmp(&_this->data[i], &_needle, sizeof(_needle)) == 0) return true;\n"
        } else {
            buf.append "        if (_this->data[i] == _needle) return true;\n"
        }
        buf.append "    }\n"
        buf.append "    return false;\n"
        buf.append "}\n\n"
    } case none then null
    so: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.names.wkSort
    match (
        so
    ) case some then {
        (emitListSort
            nm: nm.stringView
            ect: ect.stringView
            isStr: isStrEl
            isSv: isSvEl
            isStruct: (keyHashKind :symtab :ctx tid: (ztypes.tid.create from: eid.u64)) == 3
            strC: ctx.strC.stringView
            svC: ctx.svC.stringView
            :buf
        )
    } case none then null
    emitListIter :ctx :symtab :monoId nm: nm.stringView :buf
}

# emitColGet -- the element `get` for a List / ListView mono. The declared
# signature is `out of.borrow`: for an element kind whose copy is not a borrow
# the C function returns a POINTER into the storage and the call site derefs,
# so every value context stays value-shaped. `kind` only spells the panic
# message. One emitter for both templates, so List.listView cannot hand out a
# view that disagrees with its source. The return type and its forward
# declaration come from one string and cannot diverge.
emitColGet: function {
    nm: StringView
    ect: StringView
    kind: StringView
    ptr: bool
    mutPtr: bool
    buf: String.borrow
} is {
    rt: ect.string
    rv: "    return _this->data[_idx];\n".string
    if ptr then {
        rt = "\{ect}*"
        rv = "    return &_this->data[_idx];\n".string
    }
    # `getMut` answers a DIFFERENT question from `get`: a valtype element copies
    # out of `get` (cheap, cannot alias) but must come back BY REFERENCE from
    # `getMut`, or a write to the referenced element's children lands on the
    # copy and is silently lost.
    mrt: ect.string
    mrv: "    return _this->data[_idx];\n".string
    if mutPtr then {
        mrt = "\{ect}*"
        mrv = "    return &_this->data[_idx];\n".string
    }
    # Both names are spelled LITERALLY -- view-guard reads these string literals
    # to learn which declaration each emitted function backs, and cannot see
    # through an interpolated method name.
    guard: String
    guard.append "    if (_idx >= _this->length) {\n"
    guard.append "        char _zp_buf[96];\n"
    b2: "        snprintf(_zp_buf, sizeof(_zp_buf), \"\{kind} get: index %lu out of bounds (length %lu)\", (unsigned long)_idx, (unsigned long)_this->length);\n"
    guard.append b2
    guard.append "        z_panic(_zp_buf);\n"
    guard.append "    }\n"
    s0: "static \{rt} z_\{nm}_get(z_\{nm}_t* _this, uint64_t _idx);\n"
    buf.append s0
    s1: "static \{rt} z_\{nm}_get(z_\{nm}_t* _this, uint64_t _idx) {\n"
    buf.append s1
    buf.append guard
    buf.append rv
    buf.append "}\n\n"
    m0: "static \{mrt} z_\{nm}_getMut(z_\{nm}_t* _this, uint64_t _idx);\n"
    buf.append m0
    m1: "static \{mrt} z_\{nm}_getMut(z_\{nm}_t* _this, uint64_t _idx) {\n"
    buf.append m1
    buf.append guard
    buf.append mrv
    buf.append "}\n\n"
}

# emitListIter -- the borrowed-view iterator over a List mono (a `{List*; idx}`
# cursor yielding OptionView<T> by reference), emitted only when List.iterate is
# used (the ListIter / OptionView monos were minted). The OptionView mono is
# emitted by the earlier OptionView pass, so this can reference it.
emitListIter: function {
    ctx: Ctx.view
    symtab: zenv.ZSymbolTable.view
    monoId: ztypes.tid
    nm: StringView
    buf: String.borrow
} is {
    liId: monoMethodReturn :symtab :monoId nameId: zast.names.wkIterate
    if liId == 0 then return
    ovId: (monoMethodReturn
        :symtab
        monoId: (ztypes.tid.create from: liId.u64)
        nameId: zast.names.wkCall
    )
    if ovId == 0 then return
    ovName: regNameOf :symtab tid: (ztypes.tid.create from: ovId.u64)
    li: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: liId.u64)
    ov: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: ovId.u64)
    ovu: cUpperOf text: ovName.stringView
    s0: "typedef struct {\n    z_\{nm}_t* list;\n    uint64_t idx;\n} z_\{li}_t;\n"
    buf.append s0
    s1: "static z_\{ov}_t z_\{li}_call(z_\{li}_t* _it);\n"
    buf.append s1
    s2: "static z_\{ov}_t z_\{li}_call(z_\{li}_t* _it) {\n"
    buf.append s2
    s3: "    z_\{ov}_t _out = {0};\n"
    buf.append s3
    s4: "    if (_it->idx >= _it->list->length) { _out.tag = Z_\{ovu}_TAG_NONE; return _out; }\n"
    buf.append s4
    s5: "    _out.tag = Z_\{ovu}_TAG_SOME;\n"
    buf.append s5
    s6: "    _out.data = &_it->list->data[_it->idx];\n"
    buf.append s6
    s7: "    _it->idx++;\n    return _out;\n}\n"
    buf.append s7
    # `iterate` is the READONLY walk, so its receiver is const and view-guard
    # checks it. The cursor keeps a plain T* and OptionView's payload is one
    # void* shared with the readers that hand out a mutable interior pointer on
    # purpose (List.get's write-back), so const stops at this ONE cast. That the
    # ELEMENTS are readonly is a typecheck-level guarantee -- the element
    # inherits the strength of the lock its holder has on the container.
    s8: "static z_\{li}_t z_\{nm}_iterate(const z_\{nm}_t* _this);\n"
    buf.append s8
    s: "static z_\{li}_t z_\{nm}_iterate(const z_\{nm}_t* _this) {\n    z_\{li}_t _it = {0};\n    _it.list = (z_\{nm}_t*)_this;\n    _it.idx = 0;\n    return _it;\n}\n\n"
    buf.append s
    # iterateMut -- the mutable walk. The same cursor over the same storage;
    # the two differ only in what the typechecker lets the caller do with the
    # elements, so the C bodies are identical.
    s10: "static z_\{li}_t z_\{nm}_iterateMut(z_\{nm}_t* _this);\n"
    buf.append s10
    s11: "static z_\{li}_t z_\{nm}_iterateMut(z_\{nm}_t* _this) {\n    z_\{li}_t _it = {0};\n    _it.list = _this;\n    _it.idx = 0;\n    return _it;\n}\n\n"
    buf.append s11
}

# emitListSort -- stable in-place mergesort companion (scalar `<`).
emitListSort: function {
    nm: StringView
    ect: StringView
    isStr: bool
    isSv: bool
    isStruct: bool
    strC: StringView
    svC: StringView
    buf: String.borrow
} is {
    if isStr then {
        s0s: "static int z_\{nm}_sort_lt(\{ect} _a, \{ect} _b) { return \{strC}_cmp(&_a, &_b) < 0; }\n"
        buf.append s0s
    } else if isSv then {
        s0v: "static int z_\{nm}_sort_lt(\{ect} _a, \{ect} _b) { return \{svC}_cmp(_a, _b) < 0; }\n"
        buf.append s0v
    } else if isStruct then {
        # a by-value STRUCT element has no C ordering. Byte order is a total
        # order and deterministic, which is what `sort` needs; an element that
        # wants a MEANINGFUL order declares `<`, and dispatching to it is the
        # same shape as the declared `==` the containers already honour.
        s0r: "static int z_\{nm}_sort_lt(\{ect} _a, \{ect} _b) { return memcmp(&_a, &_b, sizeof(_a)) < 0; }\n"
        buf.append s0r
    } else {
        s0: "static int z_\{nm}_sort_lt(\{ect} _a, \{ect} _b) { return _a < _b; }\n"
        buf.append s0
    }
    s1: "static void z_\{nm}_sort_merge(\{ect}* data, \{ect}* scratch, uint64_t lo, uint64_t mid, uint64_t hi) {\n"
    buf.append s1
    buf.append "    uint64_t i = lo, j = mid, k = lo;\n"
    buf.append "    while (i < mid && j < hi) {\n"
    sm: "        if (!z_\{nm}_sort_lt(data[j], data[i])) scratch[k++] = data[i++];\n"
    buf.append sm
    buf.append "        else scratch[k++] = data[j++];\n"
    buf.append "    }\n"
    buf.append "    while (i < mid) scratch[k++] = data[i++];\n"
    buf.append "    while (j < hi) scratch[k++] = data[j++];\n"
    buf.append "    memcpy(&data[lo], &scratch[lo], (hi - lo) * sizeof(*data));\n"
    buf.append "}\n"
    s2: "static void z_\{nm}_sort_rec(\{ect}* data, \{ect}* scratch, uint64_t lo, uint64_t hi) {\n"
    buf.append s2
    buf.append "    if (hi - lo <= 1) return;\n"
    buf.append "    uint64_t mid = lo + (hi - lo) / 2;\n"
    sr1: "    z_\{nm}_sort_rec(data, scratch, lo, mid);\n"
    buf.append sr1
    sr2: "    z_\{nm}_sort_rec(data, scratch, mid, hi);\n"
    buf.append sr2
    sr3: "    z_\{nm}_sort_merge(data, scratch, lo, mid, hi);\n"
    buf.append sr3
    buf.append "}\n"
    s3: "static void z_\{nm}_sort(z_\{nm}_t* _this) {\n"
    buf.append s3
    buf.append "    if (_this->length < 2) return;\n"
    sa: "    \{ect}* scratch = (\{ect}*)z_xmalloc(_this->length * sizeof(\{ect}));\n"
    buf.append sa
    sd: "    z_\{nm}_sort_rec(_this->data, scratch, 0, _this->length);\n"
    buf.append sd
    buf.append "    free(scratch);\n"
    buf.append "}\n\n"
}

# emitListViewMono -- substitute z_ListView.c.tmpl for a ListView mono.
emitListViewMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    eid: listElemType :symtab :monoId
    ect0: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: eid.u64) thisTid: ztypes.tid
    ect: ctypeOrI64 s: ect0.stringView
    p: "\{runtimeDir}/z_ListView.c.tmpl"
    raw: readTemplateCached :ctx path: p.stringView
    if raw.length > 0 then {
        t1: applyTmpl text: raw key: "NAME" val: nm.stringView
        t2: applyTmpl text: t1 key: "ELEM_T" val: ect.stringView
        buf.append t2
        buf.append "\n"
    }
    if ctx.colGetFromCode then {
        (emitColGet
            nm: nm.stringView
            ect: ect.stringView
            kind: "ListView"
            ptr: (elemBorrowsByPtr :ast :symtab :ctx tid: (ztypes.tid.create from: eid.u64))
            mutPtr: (elemRefByPtr :ast :symtab :ctx tid: (ztypes.tid.create from: eid.u64))
            :buf
        )
    }
}

# listviewMethods -- the _listview cast + _extendView companions when a
# List mono carries a listView child; "" otherwise.
listviewMethods: function {
    ctx: Ctx.view
    symtab: zenv.ZSymbolTable.view
    monoId: ztypes.tid
    nm: StringView
    ect: StringView
} out String is {
    lo: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.names.wkListView
    match (
        lo
    ) case some then {
        rt: fnReturnTidOf :symtab tid: (ztypes.tid.create from: lo.u64)
        if rt > 0 then {
            {
                lvc: ctxCname :ctx tid: (ztypes.tid.create from: rt.u64)
                buf: String
                m0: "static \{lvc}_t z_\{nm}_listView(z_\{nm}_t* _this) { return *(\{lvc}_t*)_this; }\n"
                buf.append m0
                m1: "static void z_\{nm}_extendView(z_\{nm}_t* _this, \{lvc}_t _from) {\n"
                buf.append m1
                m2: "    z_\{nm}_grow(_this, _this->length + _from.length);\n"
                buf.append m2
                m3: "    memcpy(&_this->data[_this->length], _from.data, _from.length * sizeof(\{ect}));\n"
                buf.append m3
                buf.append "    _this->length += _from.length;\n"
                buf.append "}\n\n"
                return buf
            }
        }
    } case none then null
    return "".string
}

# isGenericType -- the type is a generic template (arms typed by generic
# params; never emitted as a concrete struct).
isGenericType: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    return (symtab.reg.isGenericOf :tid)
}


# buildDefUnitIndex -- snapshot tid -> defining-unit DECLARATION once per
# emission (the Decl chain is immutable during emission); zero-alloc id
# lookups then serve the hot definedInNonMain path. Interning a fresh integer
# per unit NAME collapsed two units that share a spelling into one id.
buildDefUnitIndex: function {symtab: zenv.ZSymbolTable.view ctx: Ctx ast: Ast.view} is {
    t: u64
    n: symtab.reg.nextTypeId
    for t < n loop {
        udd: (ztypecheck.unitDeclOfTid
            st: symtab
            tid: (ztypes.tid.create from: t.u64)
        )
        if udd.isZero == false then {
            ctx.defUnitId.set key: t value: udd.u64
        }
        t = t + 1
    }
    ctx.ioUnitDecl = unitDeclByName :symtab :ast name: "io"
    ctx.osUnitDecl = unitDeclByName :symtab :ast name: "os"
    ctx.cliUnitDecl = unitDeclByName :symtab :ast name: "cli"
    ctx.netUnitDecl = unitDeclByName :symtab :ast name: "net"
    ctx.ioFileTid = (unitClassTid
        :symtab
        unitDecl: ctx.ioUnitDecl
        nameId: (zast.poolFind pool: ast.names text: "File")
    ).u64
    ctx.netListenerTid = (unitClassTid
        :symtab
        unitDecl: ctx.netUnitDecl
        nameId: (zast.poolFind pool: ast.names text: "Listener")
    ).u64
    ctx.netConnTid = (unitClassTid
        :symtab
        unitDecl: ctx.netUnitDecl
        nameId: (zast.poolFind pool: ast.names text: "Conn")
    ).u64
}

# ctxBindMain -- rebind the emission main unit: mainName plus its unit
# DECLARATION, which the CALLER supplies. Every caller already holds the unit
# by id -- off the type it is emitting, off the unit node it is walking, or
# saved from the bind it is restoring -- so nothing here asks which unit is
# spelled a given way. Every mainName assignment must route through here so
# mainUnitId never goes stale (definedInNonMain compares against it).
ctxBindMain: function {ctx: Ctx name: StringView unitDecl: ztypes.declid} is {
    nm: name.string
    ctx.mainName = nm
    ctx.mainUnitId = unitDecl
}

# typeHasNativeCreate -- the type's own `create` is declared native, so the
# runtime supplies that symbol and the field-wise meta_create alias would
# redeclare it with a different signature.
typeHasNativeCreate: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    co: symtab.typing.declChildOfId parentTypeId: tid nameId: zast.names.wkCreate
    match (
        co
    ) case some then {
        return (symtab.reg.isNativeOf tid: (ztypes.tid.create from: co))
    } case none then {
        return false
    }
}

# definedInNonMain -- the type is defined in a non-main (system/io/...)
# unit (a reachable library type to emit alongside the main closure).
definedInNonMain: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    symtab
    dgo: ctx.defUnitId.get key: tid
    match (
        dgo
    ) case some then {
        return dgo != ctx.mainUnitId
    } case none then {
        return false
    }
}

# emitUnionMono -- a UNION mono (Option/Result): tag enum + { tag; void*
# data } heap-payload struct + destroy (free the payload on non-null arms,
# recursing into an aggregate payload's destructor first).
emitUnionMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    if (ctx.emittedUserTypes.has item: tid) then return
    ctx.emittedUserTypes.add item: tid.u64
    anames: List String
    aids: ListVal u64
    aidsNm: ListVal u64
    variantArms :ast :symtab :tid names: anames ids: aids nameIds: aidsNm
    # an arm-less union is a constraint-only bound (`Any`, `AnyRef`): no
    # runtime form, and an empty C enum does not compile. See emitOneVariant.
    if anames.length == 0 then return
    checkTagStem :symtab :ctx :tid
    vc: ctxCname :ctx :tid
    buf.append "typedef enum {\n"
    ai: u64
    an: anames.length
    for ai < an loop {
        aname: anames.get i: ai
        tg: variantTag :symtab :tid arm: aname.stringView
        tv: armTagValueText :symtab :tid armNameId: (aidsNm.get i: ai)
        lt: "    \{tg}\{tv},\n"
        buf.append lt
        ai = ai + 1
    }
    le: "} \{vc}_tag_t;\n"
    buf.append le
    if (isFwdDeclared :ctx :tid) then {
        lopenU: "struct \{vc}_t {\n"
        buf.append lopenU
    } else {
        buf.append "typedef struct {\n"
    }
    tsc: tagStorageCType :symtab :tid
    if tsc.length == 0 then {
        lfE: "    \{vc}_tag_t tag;\n"
        buf.append lfE
    } else {
        lfD: "    \{tsc} tag;\n"
        buf.append lfD
    }
    buf.append "    void* data;\n"
    if (isFwdDeclared :ctx :tid) then {
        buf.append "};\n"
    } else {
        lg: "} \{vc}_t;\n"
        buf.append lg
    }
    ld: "static void \{vc}_destroy(\{vc}_t* u) {\n"
    buf.append ld
    buf.append "    if (!u) return;\n"
    buf.append "    if (!u->data) return;\n"
    buf.append "    switch (u->tag) {\n"
    pj: u64
    for pj < an loop {
        pname: anames.get i: pj
        pc: armPayloadC :ast :symtab :ctx :tid arm: pname.stringView
        if pc.length > 0 then {
            ptg: variantTag :symtab :tid arm: pname.stringView
            lcase: "        case \{ptg}:\n"
            buf.append lcase
            pdtr: payloadDestructor :ast :symtab :ctx :tid arm: pname.stringView
            if pdtr.length > 0 then {
                ldd: "            \{pdtr}((\{pc}*)u->data);\n"
                buf.append ldd
            }
            buf.append "            free(u->data);\n"
            buf.append "            break;\n"
        }
        pj = pj + 1
    }
    buf.append "        default: break;\n"
    buf.append "    }\n"
    buf.append "}\n\n"
}

# payloadDestructor -- the destructor cname for an arm whose payload is an
# aggregate with a destructor ("" for scalar/view payloads).
payloadDestructor: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
    arm: StringView
} out String is {
    co: symtab.typing.declChildOf pool: ast.names parentTypeId: tid name: arm
    match (
        co
    ) case some then {
        pn: regNameOf :symtab tid: (ztypes.tid.create from: co.u64)
        if pn.stringView == "null" then return "".string
        if co == ctx.strTid then return "\{ctx.strC}_free"
        # childOf already resolves the arm to its concrete (possibly cross-unit)
        # payload id; canonicalize a destructor-less shell via resolveTypeIdByName,
        # the same way the List-element destructor does. Build the cname with
        # cnameOf (a fresh String) -- never bind the borrowed destructorName, which
        # would move out of the registry borrow (scope-exit free -> UAF).
        rid: co
        if (symtab.reg.needsDestructor typeId: (ztypes.tid.create from: co.u64)) == false then {
            rbn: (canonTypeId
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: co.u64)
                name: pn.stringView
            )
            if rbn > 0 then rid = rbn
        }
        if (symtab.reg.needsDestructor typeId: (ztypes.tid.create from: rid.u64)) then {
            cb: ctxCname :ctx tid: (ztypes.tid.create from: rid.u64)
            return "\{cb}_destroy"
        }
    } case none then null
    return "".string
}

# monoMethodReturn -- a mono method child's registered return id (0 when the
# method or its return is absent). The id-first way to reach a collection's
# iterator/view/wrapper companions.
monoMethodReturn: function {
    symtab: zenv.ZSymbolTable.view
    monoId: ztypes.tid
    nameId: zast.nameid
} out u64 is {
    co: symtab.typing.declChildOfId parentTypeId: monoId :nameId
    match (
        co
    ) case some then {
        mro: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: co.u64)
        match (
            mro
        ) case some then {
            return mro
        } case none then null
    } case none then null
    return 0
}

# monoElemName -- a mono name's element segment, dropping a known prefix
# (e.g. "Set_i64" with prefixLen 4 -> "i64"). Substring rides String.stringView
# (a bare StringView receiver mis-resolves `from:/to:` to a .create).
monoElemName: function {full: String prefixLen: u64} out String is {
    fl: full.length
    rest: (full.substring from: prefixLen to: fl)
    return rest.string
}

# setHashBody / setEqBody / setDestroyItems -- the element-kind-specific
# fragments of a Set mono: the keyed byte hash (SipHash by default,
# z_fasthash_* under --fast-hash) + memcmp + per-item free for String keys,
# the integer hash + `==` + no item cleanup otherwise.
# declaredKeyFnC -- the C name of a `hash` or `==` the KEY TYPE declared, or
# "" when it declares none. A reftype key has no byte representation to hash --
# its contents live behind a pointer -- so RefHashable makes it declare both,
# and the container must then CALL them instead of casting the aggregate.
#
# The member's receiver is a pointer like any other method's, and the template
# holds the key BY VALUE, so the caller addresses it.
declaredKeyFnC: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
    member: StringView
} out String is {
    nid: zast.poolFind pool: ast.names text: member
    if nid.isZero then return "".string
    if (symtab.typing.declIsMethodId parentTypeId: tid nameId: nid) == false then return "".string
    if (symtab.typing.declMemberIsSynth parentTypeId: tid nameId: nid) then return "".string
    mo: symtab.typing.declChildOfId parentTypeId: tid nameId: nid
    match (
        mo
    ) case some then {
        return (ctxCname :ctx tid: (ztypes.tid.create from: mo.u64))
    } case none then {
        return "".string
    }
}

# keyHashKind -- classify a Set element / Map key by canonical id (never by
# name, so a user shadow is handled by its nature): 1 native String, 2
# StringView, 3 by-value struct (record/variant -> byte hash over contents), 0
# scalar or pointer (cast hash + C `==`). A builtin numeric/bool/char is a
# record whose C type is a scalar, so it classifies 0 with the pointers --
# scalarCTypeFor is the shadow-safe gate (a user type shadowing a scalar name
# stays a struct). A heap-owning struct lands in 3 and fails to build at its
# `_eq`; the typechecker does not yet reject it.
keyHashKind: function {symtab: zenv.ZSymbolTable.view ctx: Ctx.view tid: ztypes.tid} out u64 is {
    ktid: typedefChaseTid :symtab :tid
    if ktid == ctx.strTid then return 1
    if ktid == ctx.svTid then return 2
    tt: symtab.reg.typetypeOf typeId: ktid
    isRv: tt == ztypes.ztypetype.recordType
    if isRv == false then isRv = tt == ztypes.ztypetype.variantType
    if isRv then {
        tn: regNameOf :symtab tid: ktid
        sc: scalarCTypeFor :symtab name: tn.stringView tid: ktid
        if sc.length > 0 then return 0
        return 3
    }
    return 0
}

# the C body of a Set's hash function.
setHashBody: function {kind: u64 fast: bool} out String is {
    # a String key arrives BY POINTER (the probe never copies the header)
    if fast then {
        if kind == 1 then return "z_fasthash_bytes(_key->data, _key->size)".string
        if kind == 2 then return "z_fasthash_stringview(_key)".string
        if kind == 3 then return "z_fasthash_bytes(&_key, sizeof(_key))".string
    } else {
        if kind == 1 then return "z_siphash_bytes(_key->data, _key->size)".string
        if kind == 2 then return "z_siphash_stringview(_key)".string
        if kind == 3 then return "z_siphash_bytes(&_key, sizeof(_key))".string
    }
    return "z_hash_u64((uint64_t)_key)".string
}

# the C body of a Set's element-equality function.
setEqBody: function {kind: u64} out String is {
    if (
        kind == 1
    ) then return "_a->size == _b->size && memcmp(_a->data, _b->data, _a->size) == 0".string
    if kind == 2 then {
        return "_a.length == _b.length && memcmp(_a.data, _b.data, _a.length) == 0".string
    }
    if kind == 3 then return "memcmp(&_a, &_b, sizeof(_a)) == 0".string
    return "_a == _b".string
}

# the C body that destroys a Set's items.
setDestroyItems: function {isStr: bool strC: StringView} out String is {
    if isStr then {
        return "    for (uint64_t i = 0; i < p->entries_len; i++) {\n        if (p->entries[i].alive) {\n            \{strC}_free(&p->entries[i].item);\n        }\n    }\n"
    }
    return "".string
}

# the C snippet duplicating a Set item.
setFreeItemDup: function {isStr: bool strC: StringView} out String is {
    if isStr then return "        \{strC}_free(&_item);\n"
    return "".string
}

# the C snippet deleting a Set item.
setFreeItemDel: function {isStr: bool strC: StringView} out String is {
    if isStr then return "    \{strC}_free(&_this->entries[idx].item);\n"
    return "".string
}

# emitOptionViewMono -- the borrowed-view option a collection iterator yields:
# a {tag; void* data} struct with a no-op destroy (the view owns nothing).
emitOptionViewMono: function {
    ctx: Ctx.view
    symtab: zenv.ZSymbolTable.view
    monoId: ztypes.tid
    buf: String.borrow
} is {
    mn: regNameOf :symtab tid: monoId
    nm: cbaseNoPrefix :ctx tid: monoId
    ovu: cUpperOf text: mn.stringView
    buf.append "typedef enum {\n"
    l1: "    Z_\{ovu}_TAG_NONE,\n"
    buf.append l1
    l2: "    Z_\{ovu}_TAG_SOME,\n"
    buf.append l2
    l3: "} z_\{nm}_tag_t;\n"
    buf.append l3
    buf.append "typedef struct {\n"
    tscO: tagStorageCType :symtab tid: monoId
    if tscO.length == 0 then {
        l4: "    z_\{nm}_tag_t tag;\n"
        buf.append l4
    } else {
        l4d: "    \{tscO} tag;\n"
        buf.append l4d
    }
    buf.append "    void* data;\n"
    l5: "} z_\{nm}_t;\n"
    buf.append l5
    l6: "static void z_\{nm}_destroy(z_\{nm}_t* u) { (void)u; }\n\n"
    buf.append l6
}

# emitSetMono -- substitute z_Set.c.tmpl for a Set instance (compact-dict
# struct + add/has/delete/iterate + the SetIter companion). Depends on the
# element's OptionView mono being emitted first (the iterator yields it).
emitSetMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    mcr: cUpperOf text: nm.stringView
    elemTid: setElemType :symtab :monoId
    elemName: regNameOf :symtab tid: (ztypes.tid.create from: elemTid.u64)
    itemT: (cTypeForNameTid
        :ast
        :symtab
        :ctx
        name: elemName.stringView
        tid: (ztypes.tid.create from: elemTid.u64)
    )
    ekind: keyHashKind :symtab :ctx tid: (ztypes.tid.create from: elemTid.u64)
    isStr: ekind == 1
    siId: monoMethodReturn :symtab :monoId nameId: zast.names.wkIterate
    if siId == 0 then return
    ovId: (monoMethodReturn
        :symtab
        monoId: (ztypes.tid.create from: siId.u64)
        nameId: zast.names.wkCall
    )
    if ovId == 0 then return
    ovName: regNameOf :symtab tid: (ztypes.tid.create from: ovId.u64)
    ov: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: ovId.u64)
    ovu: cUpperOf text: ovName.stringView
    si: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: siId.u64)
    hashBody: setHashBody kind: ekind fast: ctx.fastHash
    eqBody: setEqBody kind: ekind
    {
        dh: String
        de: String
        if ekind == 0 then {
            dh = (declaredKeyFnC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: elemTid.u64)
                member: "hash"
            )
            de = (declaredKeyFnC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: elemTid.u64)
                member: "=="
            )
        }
        if dh.length > 0 when de.length > 0 then {
            hb: "\{dh}(&_key)"
            hashBody = hb
            rhsPs: elemBorrowsByPtr :ast :symtab :ctx tid: (ztypes.tid.create from: elemTid.u64)
            rhsAs: "_b".string
            rhsTs: itemT.copy
            if rhsPs then {
                rhsAs = "&_b".string
                rhsTsp: "\{itemT}*"
                rhsTs = rhsTsp
            }
            eb: "\{de}(&_a, \{rhsAs})"
            eqBody = eb
            fd: "static uint64_t \{dh}(\{itemT}*);\nstatic bool \{de}(\{itemT}*, \{rhsTs});\n"
            buf.append fd
        }
    }
    destroyItems: setDestroyItems :isStr strC: ctx.strC.stringView
    freeItemDup: setFreeItemDup :isStr strC: ctx.strC.stringView
    freeItemDel: setFreeItemDel :isStr strC: ctx.strC.stringView
    p: "\{runtimeDir}/z_Set.c.tmpl"
    raw: readTemplateCached :ctx path: p.stringView
    if raw.length > 0 then {
        t1: applyTmpl text: raw key: "NAME" val: nm.stringView
        t2: applyTmpl text: t1 key: "MACRO" val: mcr.stringView
        t3: applyTmpl text: t2 key: "ITEM_T" val: itemT.stringView
        itemArgT: itemT.copy
        itemRef: String
        if isStr then {
            itemArgT = "const \{itemT}*"
            itemRef = "&".string
        }
        t3 = applyTmpl text: t3 key: "ITEM_ARG_T" val: itemArgT.stringView
        t3 = applyTmpl text: t3 key: "ITEM_REF" val: itemRef.stringView
        t4: applyTmpl text: t3 key: "HASH_BODY" val: hashBody.stringView
        t5: applyTmpl text: t4 key: "EQ_BODY" val: eqBody.stringView
        t6: applyTmpl text: t5 key: "DESTROY_ITEMS" val: destroyItems.stringView
        t6b: applyTmpl text: t6 key: "FREE_ITEM_DUP" val: freeItemDup.stringView
        t6c: applyTmpl text: t6b key: "FREE_ITEM_DEL" val: freeItemDel.stringView
        t7: applyTmpl text: t6c key: "OPTIONVIEW" val: ov.stringView
        t8: applyTmpl text: t7 key: "OPTIONVIEW_TAG" val: ovu.stringView
        t: applyTmpl text: t8 key: "SETITER" val: si.stringView
        buf.append t
        buf.append "\n"
    }
    if isStr then {
        # String sets: view-keyed probes. The temporary String header aliases
        # the view bytes; has/delete only hash and compare, never store or
        # free the probe (delete frees the STORED item only).
        sv0: "static int z_\{nm}_hasv(const z_\{nm}_t* _this, \{ctx.svC}_t _item) {\n"
        buf.append sv0
        sv1: "    \{ctx.strC}_t _k = { _item.size, (char*)_item.data, _item.size };\n"
        buf.append sv1
        sv2: "    return z_\{nm}_has(_this, &_k);\n}\n\n"
        buf.append sv2
        sd0: "static int z_\{nm}_deletev(z_\{nm}_t* _this, \{ctx.svC}_t _item) {\n"
        buf.append sd0
        sd1: "    \{ctx.strC}_t _k = { _item.size, (char*)_item.data, _item.size };\n"
        buf.append sd1
        sd2: "    return z_\{nm}_delete(_this, &_k);\n}\n\n"
        buf.append sd2
    }
}

# mapDestroyEntries / mapFreeKeyDup / mapFreeKeyDel -- String-key cleanup
# fragments: per-entry key free on destroy, incoming-key free when a set hits
# an existing key, stored-key free on delete. Empty for non-heap keys.
mapDestroyEntries: function {isStr: bool strC: StringView valFree: StringView} out String is {
    keyLine: String
    if isStr then keyLine = "            \{strC}_free(&p->entries[i].key);\n"
    valLine: String
    if valFree.length > 0 then valLine = "            \{valFree}\n"
    if (keyLine.length + valLine.length) == 0 then return "".string
    return "    for (uint64_t i = 0; i < p->entries_len; i++) {\n        if (p->entries[i].alive) {\n\{keyLine}\{valLine}        }\n    }\n"
}

# the C snippet duplicating a Map key.
mapFreeKeyDup: function {isStr: bool strC: StringView} out String is {
    if isStr then return "        \{strC}_free(&_key);\n"
    return "".string
}

# the C snippet deleting a Map key (and its value).
mapFreeKeyDel: function {isStr: bool strC: StringView valFree: StringView} out String is {
    res: String
    if isStr then res = "    \{strC}_free(&_this->entries[idx].key);\n"
    if valFree.length > 0 then res = "\{res}    \{valFree}\n"
    return res
}

# mapValFreeStmt -- the value-free statement for a Map value slot: String value
# via the String free, reftype / heap-collection value via its destructor, empty
# for scalars. Mirrors emitStructDestructor's per-field cleanup.
mapValFreeStmt: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    valTid: ztypes.tid
    slot: StringView
} out String is {
    if valTid == ctx.strTid then return "\{ctx.strC}_free(&\{slot});"
    if valTid > 0 then {
        vmid: chaseColMono :symtab :ctx tid: valTid
        needs: false
        if (symtab.reg.needsDestructor typeId: vmid) then needs = true
        if (isHeapPtrCollection :symtab :ctx tid: valTid) then needs = true
        if needs then {
            vcb: ctxCname :ctx tid: (ztypes.tid.create from: vmid.u64)
            if (isHeapPtrCollection
                :symtab
                :ctx
                tid: valTid
            ) then return "\{vcb}_destroy(\{slot});"
            return "\{vcb}_destroy(&\{slot});"
        }
    }
    return "".string
}

# emitMapIters -- the MapKeyIter/MapItemIter/MapEntry block for a Map mono,
# emitted only when those iterator monos were minted. Their OptionView returns
# (OptionView_<K>, OptionView_MapEntry_<K>_<V>) are defined by the earlier
# OptionView leg.
emitMapIters: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    monoId: ztypes.tid
    runtimeDir: StringView
    nm: StringView
    keyT: StringView
    valT: StringView
    buf: String.borrow
} is {
    miiId: monoMethodReturn :symtab :monoId nameId: zast.names.wkIterateItems
    if miiId == 0 then return
    mkiId: monoMethodReturn :symtab :monoId nameId: zast.names.wkIterate
    if mkiId == 0 then return
    ovkId: (monoMethodReturn
        :symtab
        monoId: (ztypes.tid.create from: mkiId.u64)
        nameId: zast.names.wkCall
    )
    if ovkId == 0 then return
    ovkName: regNameOf :symtab tid: (ztypes.tid.create from: ovkId.u64)
    oveId: (monoMethodReturn
        :symtab
        monoId: (ztypes.tid.create from: miiId.u64)
        nameId: zast.names.wkCall
    )
    if oveId == 0 then return
    oveName: regNameOf :symtab tid: (ztypes.tid.create from: oveId.u64)
    meId: ztypes.tid
    meo: (symtab.typing.declChildOfId
        parentTypeId: (ztypes.tid.create from: oveId.u64)
        nameId: zast.names.wkSome
    )
    match (
        meo
    ) case some then {
        meId = ztypes.tid.create from: meo
    } case none then null
    if meId.isZero then return
    mki: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: mkiId.u64)
    mii: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: miiId.u64)
    me: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: meId.u64)
    ovk: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: ovkId.u64)
    ovku: cUpperOf text: ovkName.stringView
    ove: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: oveId.u64)
    oveu: cUpperOf text: oveName.stringView
    pi: "\{runtimeDir}/z_MapIter.c.tmpl"
    rawi: readTemplateCached :ctx path: pi.stringView
    if rawi.length > 0 then {
        i1: applyTmpl text: rawi key: "NAME" val: nm
        i2: applyTmpl text: i1 key: "KEY_T" val: keyT
        i3: applyTmpl text: i2 key: "VAL_T" val: valT
        i4: applyTmpl text: i3 key: "MAPKEYITER" val: mki.stringView
        i5: applyTmpl text: i4 key: "OPTIONVIEW_K" val: ovk.stringView
        i6: applyTmpl text: i5 key: "OPTIONVIEW_K_TAG" val: ovku.stringView
        i7: applyTmpl text: i6 key: "MAPENTRY" val: me.stringView
        i8: applyTmpl text: i7 key: "MAPITEMITER" val: mii.stringView
        i: applyTmpl text: i8 key: "OPTIONVIEW_ENTRY" val: ove.stringView
        i10: applyTmpl text: i key: "OPTIONVIEW_ENTRY_TAG" val: oveu.stringView
        buf.append i10
        buf.append "\n"
    }
}

# mapKeyType -- a Map mono's KEY type, read off its `set` member's `key`
# parameter rather than off the mono's name: the name is composed text, the
# parameter is the declaration.
mapKeyType: function {symtab: zenv.ZSymbolTable.view monoId: ztypes.tid} out u64 is {
    return (memberOfMemberType :symtab :monoId outer: zast.names.wkSet inner: zast.names.wkKey)
}

# the element type id of Set instantiation `monoId`.
setElemType: function {symtab: zenv.ZSymbolTable.view monoId: ztypes.tid} out u64 is {
    return (memberOfMemberType :symtab :monoId outer: zast.names.wkAdd inner: zast.names.wkItem)
}

# memberOfMemberType -- the type of `inner` on the type of `outer` on `monoId`:
# how a container instance names its key or element, through the method that
# takes one. 0 when either step has no such member.
memberOfMemberType: function {
    symtab: zenv.ZSymbolTable.view
    monoId: ztypes.tid
    outer: zast.nameid
    inner: zast.nameid
} out u64 is {
    oo: symtab.typing.declChildOfId parentTypeId: monoId nameId: outer
    if oo.some == false then return 0
    io: (symtab.typing.declChildOfId
        parentTypeId: (ztypes.tid.create from: oo.u64)
        nameId: inner
    )
    return (io.or d: 0)
}

# the value type id of Map instantiation `monoId`.
mapValType: function {symtab: zenv.ZSymbolTable.view monoId: ztypes.tid} out ztypes.tid is {
    so: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.names.wkSet
    match (
        so
    ) case some then {
        vo: (symtab.typing.declChildOfId
            parentTypeId: (ztypes.tid.create from: so.u64)
            nameId: zast.names.wkValue
        )
        match (
            vo
        ) case some then {
            return (ztypes.tid.create from: vo)
        } case none then null
    } case none then null
    return (ztypes.tid.create from: 0)
}

# emitMapMono -- substitute z_Map.c.tmpl for a Map instance (compact-dict +
# set/get/has/delete). The value's optionval mono (get's return) supplies the
# value type and the OPTIONVAL placeholders; the key name is the remainder.
# mapValType -- the canonical Map value type id, off the "set" method's "value"
# param (mirrors listElemType). 0 when absent.
emitMapMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    mcr: cUpperOf text: nm.stringView
    ovId: ztypes.tid
    go: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.names.wkGet
    match (
        go
    ) case some then {
        ovId = symtab.reg.returnTypeOf tid: (ztypes.tid.create from: go.u64)
    } case none then null
    if ovId.isZero then return
    ovName: regNameOf :symtab tid: (ztypes.tid.create from: ovId.u64)
    valTid: mapValType :symtab monoId: (ztypes.tid.create from: monoId.u64)
    valName: regNameOf :symtab tid: valTid
    valT: cTypeForNameTid :ast :symtab :ctx name: valName.stringView tid: valTid
    ov: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: ovId.u64)
    ovu: cUpperOf text: ovName.stringView
    keyTid: mapKeyType :symtab :monoId
    keyName: regNameOf :symtab tid: (ztypes.tid.create from: keyTid.u64)
    keyT: (cTypeForNameTid
        :ast
        :symtab
        :ctx
        name: keyName.stringView
        tid: (ztypes.tid.create from: keyTid.u64)
    )
    kkind: keyHashKind :symtab :ctx tid: (ztypes.tid.create from: keyTid.u64)
    keyIsStr: kkind == 1
    hashKeyBody: setHashBody kind: kkind fast: ctx.fastHash
    keysEqBody: setEqBody kind: kkind
    {
        # Only the FALLTHROUGH kind. String (1), StringView (2) and the
        # by-value structs (3) already have their own bodies, and String's
        # `hash`/`==` are NATIVES whose C is fixed by their .inc -- calling
        # them by emitted name links to nothing.
        dhm: String
        dem: String
        if kkind == 0 then {
            dhm = (declaredKeyFnC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: keyTid.u64)
                member: "hash"
            )
            dem = (declaredKeyFnC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: keyTid.u64)
                member: "=="
            )
        }
        if dhm.length > 0 when dem.length > 0 then {
            hbm: "\{dhm}(&_key)"
            hashKeyBody = hbm
            # the receiver is a pointer either way; the `rhs` PARAMETER follows
            # the key's own calling convention, which is a pointer for a class
            # and a value for a record
            rhsP: elemBorrowsByPtr :ast :symtab :ctx tid: (ztypes.tid.create from: keyTid.u64)
            rhsA: "_b".string
            rhsT: keyT.copy
            if rhsP then {
                rhsA = "&_b".string
                rhsTp: "\{keyT}*"
                rhsT = rhsTp
            }
            ebm: "\{dem}(&_a, \{rhsA})"
            keysEqBody = ebm
            # the mono is emitted before user method bodies, so declare the
            # two it calls
            fdm: "static uint64_t \{dhm}(\{keyT}*);\nstatic bool \{dem}(\{keyT}*, \{rhsT});\n"
            buf.append fdm
        }
    }
    vfDestroy: (mapValFreeStmt
        :symtab
        :ctx
        :valTid
        slot: "p->entries[i].value"
    )
    vfDup: (mapValFreeStmt
        :symtab
        :ctx
        :valTid
        slot: "_this->entries[existing].value"
    )
    freeValDup: String
    if vfDup.length > 0 then freeValDup = "        \{vfDup}\n"
    destroyEntries: (mapDestroyEntries
        isStr: keyIsStr
        strC: ctx.strC.stringView
        valFree: vfDestroy.stringView
    )
    freeKeyDup: mapFreeKeyDup isStr: keyIsStr strC: ctx.strC.stringView
    getBody: String
    if (originIsTid
        :symtab
        tid: (ztypes.tid.create from: ovId.u64)
        originTid: (ctx.origins.get i: ogOptionval)
    ) then {
        gbV: "    z_\{ov}_t _r;\n    if (idx >= 0) {\n        _r.tag = Z_\{ovu}_TAG_SOME;\n        _r.data.some = _this->entries[idx].value;\n    } else {\n        _r.tag = Z_\{ovu}_TAG_NONE;\n    }\n    return _r;"
        getBody = gbV
    } else {
        # every OptionView-producing value kind (class, String, union,
        # protocol, ...) borrows a pointer into the entry storage: the
        # view's SHARED lock pins the map, and OptionView destroy is a
        # no-op, so a malloc'd box here would leak (the audited get
        # contract is "no deep-copy on get")
        gbR: "    z_\{ov}_t _r = {0};\n    if (idx >= 0) {\n        _r.tag = Z_\{ovu}_TAG_SOME;\n        _r.data = &_this->entries[idx].value;\n    } else {\n        _r.tag = Z_\{ovu}_TAG_NONE;\n        _r.data = NULL;\n    }\n    return _r;"
        getBody = gbR
    }
    rmWrapId: ztypes.tid
    roMm: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.names.wkRemove
    match (
        roMm
    ) case some then {
        rmWrapId = symtab.reg.returnTypeOf tid: (ztypes.tid.create from: roMm.u64)
    } case none then null
    rmWrapName: regNameOf :symtab tid: (ztypes.tid.create from: rmWrapId.u64)
    rmWrap: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: rmWrapId.u64)
    rmWrapU: cUpperOf text: rmWrapName.stringView
    keyOnlyFree: mapFreeKeyDel isStr: keyIsStr strC: ctx.strC.stringView valFree: ""
    delTail: "\{keyOnlyFree}    _this->entries[idx].alive = 0;\n    _this->indices[slot] = Z_\{mcr}_INDEX_DELETED;\n    _this->length--;\n"
    removeBody: String
    if (originIsTid
        :symtab
        tid: (ztypes.tid.create from: rmWrapId.u64)
        originTid: (ctx.origins.get i: ogOptionval)
    ) then {
        removeBody = "    z_\{rmWrap}_t _r;\n    if (idx < 0) {\n        _r.tag = Z_\{rmWrapU}_TAG_NONE;\n        return _r;\n    }\n    _r.tag = Z_\{rmWrapU}_TAG_SOME;\n    _r.data.some = _this->entries[idx].value;\n\{delTail}    return _r;"
    } else {
        removeBody = "    z_\{rmWrap}_t _r = {0};\n    if (idx < 0) {\n        _r.tag = Z_\{rmWrapU}_TAG_NONE;\n        _r.data = NULL;\n        return _r;\n    }\n    _r.tag = Z_\{rmWrapU}_TAG_SOME;\n    \{valT}* _box = (\{valT}*)z_xmalloc(sizeof(\{valT}));\n    *_box = _this->entries[idx].value;\n    _r.data = _box;\n\{delTail}    return _r;"
    }
    p: "\{runtimeDir}/z_Map.c.tmpl"
    raw: readTemplateCached :ctx path: p.stringView
    if raw.length == 0 then return
    {
        t1: applyTmpl text: raw key: "NAME" val: nm.stringView
        t2: applyTmpl text: t1 key: "MACRO" val: mcr.stringView
        t3: applyTmpl text: t2 key: "KEY_T" val: keyT.stringView
        keyArgT: keyT.copy
        keyRef: String
        if keyIsStr then {
            keyArgT = "const \{keyT}*"
            keyRef = "&".string
        }
        t3 = applyTmpl text: t3 key: "KEY_ARG_T" val: keyArgT.stringView
        t3 = applyTmpl text: t3 key: "KEY_REF" val: keyRef.stringView
        t4: applyTmpl text: t3 key: "VAL_T" val: valT.stringView
        t5: applyTmpl text: t4 key: "HASH_KEY_BODY" val: hashKeyBody.stringView
        t6: applyTmpl text: t5 key: "KEYS_EQUAL_BODY" val: keysEqBody.stringView
        t7: applyTmpl text: t6 key: "DESTROY_ENTRIES" val: destroyEntries.stringView
        t8: applyTmpl text: t7 key: "FREE_KEY_DUP" val: freeKeyDup.stringView
        t10: applyTmpl text: t8 key: "OPTIONVAL" val: ov.stringView
        t11: applyTmpl text: t10 key: "OPTIONVAL_TAG" val: ovu.stringView
        t12: applyTmpl text: t11 key: "GET_BODY" val: getBody.stringView
        t13: applyTmpl text: t12 key: "FREE_VAL_DUP" val: freeValDup.stringView
        t14: applyTmpl text: t13 key: "REMOVE_WRAP" val: rmWrap.stringView
        t15: applyTmpl text: t14 key: "REMOVE_BODY" val: removeBody.stringView
        buf.append t15
        buf.append "\n"
    }
    if kkind == 1 then {
        # String-keyed maps: a view-keyed get. The temporary String header
        # aliases the view bytes; get/find only hash and compare the key,
        # never store or free it.
        gv0: "static z_\{ov}_t z_\{nm}_getv(z_\{nm}_t* _this, \{ctx.svC}_t _key) {\n"
        buf.append gv0
        gv1: "    \{ctx.strC}_t _k = { _key.size, (char*)_key.data, _key.size };\n"
        buf.append gv1
        gv2: "    return z_\{nm}_get(_this, &_k);\n}\n\n"
        buf.append gv2
        hv0: "static int z_\{nm}_hasv(const z_\{nm}_t* _this, \{ctx.svC}_t _key) {\n"
        buf.append hv0
        hv1: "    \{ctx.strC}_t _k = { _key.size, (char*)_key.data, _key.size };\n"
        buf.append hv1
        hv2: "    return z_\{nm}_has(_this, &_k);\n}\n\n"
        buf.append hv2
    }
    (emitMapIters
        :symtab
        :ctx
        :monoId
        :runtimeDir
        nm: nm.stringView
        keyT: keyT.stringView
        valT: valT.stringView
        :buf
    )
}

# idMapDestroyEntries -- the per-entry free loop for an IdMap. There is no
# `alive` test and no key line: entries are dense (nothing is ever removed) and
# an id key is a scalar that owns nothing.
idMapDestroyEntries: function {valFree: StringView} out String is {
    if valFree.length == 0 then return "".string
    return "    for (uint32_t i = 0; i < p->length; i++) {\n        \{valFree}\n    }\n"
}

# emitIdMapMono -- substitute z_IdMap.c.tmpl for an IdMap instance. Far fewer
# holes than emitMapMono: the bound guarantees a scalar key, so there is no
# hash body to choose, no key-equality body (C `==` is it), and no key to free.
emitIdMapMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    mcr: cUpperOf text: nm.stringView
    ovId: ztypes.tid
    go: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.names.wkGet
    match (
        go
    ) case some then {
        ovId = symtab.reg.returnTypeOf tid: (ztypes.tid.create from: go.u64)
    } case none then null
    if ovId.isZero then return
    ovName: regNameOf :symtab tid: (ztypes.tid.create from: ovId.u64)
    ov: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: ovId.u64)
    ovu: cUpperOf text: ovName.stringView
    valTid: mapValType :symtab monoId: (ztypes.tid.create from: monoId.u64)
    valName: regNameOf :symtab tid: valTid
    valT: cTypeForNameTid :ast :symtab :ctx name: valName.stringView tid: valTid
    keyTid: mapKeyType :symtab :monoId
    keyName: regNameOf :symtab tid: (ztypes.tid.create from: keyTid.u64)
    keyT: (cTypeForNameTid
        :ast
        :symtab
        :ctx
        name: keyName.stringView
        tid: (ztypes.tid.create from: keyTid.u64)
    )
    vfDestroy: (mapValFreeStmt :symtab :ctx :valTid slot: "p->entries[i].value")
    vfDup: (mapValFreeStmt
        :symtab
        :ctx
        :valTid
        slot: "_this->entries[existing].value"
    )
    freeValDup: String
    if vfDup.length > 0 then freeValDup = "        \{vfDup}\n"
    destroyEntries: idMapDestroyEntries valFree: vfDestroy.stringView
    getBody: String
    if (originIsTid
        :symtab
        tid: (ztypes.tid.create from: ovId.u64)
        originTid: (ctx.origins.get i: ogOptionval)
    ) then {
        getBody = "    z_\{ov}_t _r;\n    if (idx >= 0) {\n        _r.tag = Z_\{ovu}_TAG_SOME;\n        _r.data.some = _this->entries[idx].value;\n    } else {\n        _r.tag = Z_\{ovu}_TAG_NONE;\n    }\n    return _r;"
    } else {
        # same borrowed-pointer contract as Map.get: the OptionView pins the
        # container with a SHARED lock and its destroy is a no-op, so nothing
        # is copied out of the entry storage
        getBody = "    z_\{ov}_t _r = {0};\n    if (idx >= 0) {\n        _r.tag = Z_\{ovu}_TAG_SOME;\n        _r.data = (void*)&_this->entries[idx].value;\n    } else {\n        _r.tag = Z_\{ovu}_TAG_NONE;\n        _r.data = NULL;\n    }\n    return _r;"
    }
    p: "\{runtimeDir}/z_IdMap.c.tmpl"
    raw: readTemplateCached :ctx path: p.stringView
    if raw.length == 0 then return
    t1: applyTmpl text: raw key: "NAME" val: nm.stringView
    t2: applyTmpl text: t1 key: "MACRO" val: mcr.stringView
    t3: applyTmpl text: t2 key: "KEY_T" val: keyT.stringView
    t4: applyTmpl text: t3 key: "VAL_T" val: valT.stringView
    t5: applyTmpl text: t4 key: "DESTROY_ENTRIES" val: destroyEntries.stringView
    t6: applyTmpl text: t5 key: "FREE_VAL_DUP" val: freeValDup.stringView
    t7: applyTmpl text: t6 key: "OPTIONVAL" val: ov.stringView
    t8: applyTmpl text: t7 key: "OPTIONVAL_TAG" val: ovu.stringView
    t: applyTmpl text: t8 key: "GET_BODY" val: getBody.stringView
    buf.append t
    buf.append "\n"
    (emitIdMapGetMut
        :ast
        :symtab
        :ctx
        :monoId
        :runtimeDir
        nm: nm.stringView
        keyT: keyT.stringView
        :buf
    )
    (emitIdMapIters
        :symtab
        :ctx
        :monoId
        :runtimeDir
        nm: nm.stringView
        keyT: keyT.stringView
        valT: valT.stringView
        :buf
    )
}

# emitIdMapGetMut -- the in-place value reference, from its own template.
# `getMut` has no well-known name id, so its declared return -- an OptionView
# over the VALUE in both families, where `get`'s differs between them -- is
# resolved through the interned name.
emitIdMapGetMut: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    monoId: ztypes.tid
    runtimeDir: StringView
    nm: StringView
    keyT: StringView
    buf: String.borrow
} is {
    gmId: (monoMethodReturn
        :symtab
        :monoId
        nameId: (zast.poolFind pool: ast.names text: "getMut")
    )
    if gmId == 0 then return
    gmName: regNameOf :symtab tid: (ztypes.tid.create from: gmId.u64)
    gmv: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: gmId.u64)
    gmu: cUpperOf text: gmName.stringView
    pm: "\{runtimeDir}/z_IdMapMut.c.tmpl"
    rawm: readTemplateCached :ctx path: pm.stringView
    if rawm.length == 0 then return
    m1: applyTmpl text: rawm key: "NAME" val: nm
    m2: applyTmpl text: m1 key: "KEY_T" val: keyT
    m3: applyTmpl text: m2 key: "OPTIONVIEW_V" val: gmv.stringView
    m4: applyTmpl text: m3 key: "OPTIONVIEW_V_TAG" val: gmu.stringView
    buf.append m4
    buf.append "\n"
}

# emitIdMapIters -- the entry projection and the item iterator, from their own
# template. Separate from z_IdMap.c.tmpl for the reason emitMapIters is separate
# from z_Map.c.tmpl: a mono whose `iterateItems` never resolved must still emit
# its container, so the part that needs the iterator types is the part that can
# be skipped.
emitIdMapIters: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    monoId: ztypes.tid
    runtimeDir: StringView
    nm: StringView
    keyT: StringView
    valT: StringView
    buf: String.borrow
} is {
    miiId: monoMethodReturn :symtab :monoId nameId: zast.names.wkIterateItems
    if miiId == 0 then return
    oveId: (monoMethodReturn
        :symtab
        monoId: (ztypes.tid.create from: miiId.u64)
        nameId: zast.names.wkCall
    )
    if oveId == 0 then return
    oveName: regNameOf :symtab tid: (ztypes.tid.create from: oveId.u64)
    meId: ztypes.tid
    {
        meo: (symtab.typing.declChildOfId
            parentTypeId: (ztypes.tid.create from: oveId.u64)
            nameId: zast.names.wkSome
        )
        match (
            meo
        ) case some then {
            meId = ztypes.tid.create from: meo
        } case none then null
    }
    if meId.isZero then return
    mii: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: miiId.u64)
    me: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: meId.u64)
    ove: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: oveId.u64)
    oveu: cUpperOf text: oveName.stringView
    pi: "\{runtimeDir}/z_IdMapIter.c.tmpl"
    rawi: readTemplateCached :ctx path: pi.stringView
    if rawi.length == 0 then return
    j1: applyTmpl text: rawi key: "NAME" val: nm
    j2: applyTmpl text: j1 key: "KEY_T" val: keyT
    j3: applyTmpl text: j2 key: "VAL_T" val: valT
    j4: applyTmpl text: j3 key: "IDMAPITEMITER" val: mii.stringView
    j5: applyTmpl text: j4 key: "IDMAPENTRY" val: me.stringView
    j6: applyTmpl text: j5 key: "OPTIONVIEW_ENTRY" val: ove.stringView
    j7: applyTmpl text: j6 key: "OPTIONVIEW_ENTRY_TAG" val: oveu.stringView
    buf.append j7
    buf.append "\n"
}

# emitIdSetMono -- substitute z_IdSet.c.tmpl for an IdSet instance. Three
# holes: an id item is a scalar, so it has no hash body, no equality body and
# no destructor.
emitIdSetMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    mcr: cUpperOf text: nm.stringView
    elemTid: setElemType :symtab :monoId
    elemName: regNameOf :symtab tid: (ztypes.tid.create from: elemTid.u64)
    itemT: (cTypeForNameTid
        :ast
        :symtab
        :ctx
        name: elemName.stringView
        tid: (ztypes.tid.create from: elemTid.u64)
    )
    siId: monoMethodReturn :symtab :monoId nameId: zast.names.wkIterate
    if siId == 0 then return
    ovId: (monoMethodReturn
        :symtab
        monoId: (ztypes.tid.create from: siId.u64)
        nameId: zast.names.wkCall
    )
    if ovId == 0 then return
    ovName: regNameOf :symtab tid: (ztypes.tid.create from: ovId.u64)
    ov: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: ovId.u64)
    ovu: cUpperOf text: ovName.stringView
    si: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: siId.u64)
    p: "\{runtimeDir}/z_IdSet.c.tmpl"
    raw: readTemplateCached :ctx path: p.stringView
    if raw.length == 0 then return
    t1: applyTmpl text: raw key: "NAME" val: nm.stringView
    t2: applyTmpl text: t1 key: "MACRO" val: mcr.stringView
    t3: applyTmpl text: t2 key: "ITEM_T" val: itemT.stringView
    t4: applyTmpl text: t3 key: "IDSETITER" val: si.stringView
    t5: applyTmpl text: t4 key: "OPTIONVIEW" val: ov.stringView
    t6: applyTmpl text: t5 key: "OPTIONVIEW_TAG" val: ovu.stringView
    buf.append t6
    buf.append "\n"
}

# ioCanonTid -- the type id behind an io/cli runtime fragment's canonical stem,
# for the GENERIC INSTANCES only: resolved through the spec trie from
# SOURCE-named parts (Result over filestat and IoError), never by the mangled
# spelling. 0 for a plain source-name stem (File, IoError, Reader), which keeps
# the by-name path, and 0 when the instance was never demanded.
ioCanonTid: function {ast: Ast.view symtab: zenv.ZSymbolTable.view canon: StringView} out u64 is {
    if canon == "Option_StringView" then {
        return (specStemTid :ast :symtab base: "Option" arg1: "StringView" arg2: "")
    }
    if canon == "Option_String" then {
        return (specStemTid :ast :symtab base: "Option" arg1: "String" arg2: "")
    }
    if canon == "OptionView_String" then {
        return (specStemTid :ast :symtab base: "OptionView" arg1: "String" arg2: "")
    }
    if canon == "ListViewVal_u8" then {
        return (specStemTid :ast :symtab base: "ListViewVal" arg1: "u8" arg2: "")
    }
    if canon == "ListVal_u8" then {
        return (specStemTid :ast :symtab base: "ListVal" arg1: "u8" arg2: "")
    }
    if canon == "List_String" then {
        return (specStemTid :ast :symtab base: "ListRef" arg1: "String" arg2: "")
    }
    # the cli argument types are declared in `cli`, which the unqualified
    # builtinTid does not reach: naming the unit is what builtinTidInU is for.
    # These three resolved 0 and rode the by-name registry scan instead, which
    # agreed only while a mono's label happened to be spelled like the hole key.
    if canon == "List_PositionalDef" then {
        return (specTidArgs
            :symtab
            templateTid: (builtinTid :ast :symtab base: "ListRef")
            a1: (builtinTidInU :ast :symtab unitName: "cli" base: "PositionalDef")
            a2: 0
        )
    }
    if canon == "List_OptionDef" then {
        return (specTidArgs
            :symtab
            templateTid: (builtinTid :ast :symtab base: "ListRef")
            a1: (builtinTidInU :ast :symtab unitName: "cli" base: "OptionDef")
            a2: 0
        )
    }
    if canon == "List_FlagDef" then {
        return (specTidArgs
            :symtab
            templateTid: (builtinTid :ast :symtab base: "ListRef")
            a1: (builtinTidInU :ast :symtab unitName: "cli" base: "FlagDef")
            a2: 0
        )
    }
    if canon == "Map_String_String" then {
        return (specStemTid :ast :symtab base: "MapRR" arg1: "String" arg2: "String")
    }
    if canon == "Result_filestat_IoError" then {
        templateTid92: (builtinTid :ast :symtab base: "Result")
        templateTid93: (builtinTid :ast :symtab base: "Box")
        a192: (builtinTidInU :ast :symtab unitName: "io" base: "filestat")
        a29: (builtinTid :ast :symtab base: "IoError")
        rbf: (specTidArgs
            :symtab
            templateTid: templateTid92
            a1: (specTidArgs
                :symtab
                templateTid: templateTid93
                a1: a192
                a2: 0
            )
            a2: a29
        )
        if rbf > 0 then return rbf
        return (specStemTid :ast :symtab base: "Result" arg1: "filestat" arg2: "IoError")
    }
    if canon == "Result_String_IoError" then {
        return (specStemTid :ast :symtab base: "Result" arg1: "String" arg2: "IoError")
    }
    if canon == "Result_File_IoError" then {
        return (specStemTid :ast :symtab base: "Result" arg1: "File" arg2: "IoError")
    }
    if canon == "Result_null_IoError" then {
        return (specStemTid :ast :symtab base: "Result" arg1: "null" arg2: "IoError")
    }
    if canon == "Result_u64_IoError" then {
        templateTid94: (builtinTid :ast :symtab base: "Result")
        templateTid95: (builtinTid :ast :symtab base: "Box")
        a193: (builtinTid :ast :symtab base: "u64")
        a292: (builtinTid :ast :symtab base: "IoError")
        rbu: (specTidArgs
            :symtab
            templateTid: templateTid94
            a1: (specTidArgs
                :symtab
                templateTid: templateTid95
                a1: a193
                a2: 0
            )
            a2: a292
        )
        if rbu > 0 then return rbu
        return (specStemTid :ast :symtab base: "Result" arg1: "u64" arg2: "IoError")
    }
    if canon == "Result_Listener_IoError" then {
        return (specStemTid :ast :symtab base: "Result" arg1: "Listener" arg2: "IoError")
    }
    if canon == "Result_Conn_IoError" then {
        return (specStemTid :ast :symtab base: "Result" arg1: "Conn" arg2: "IoError")
    }
    if canon == "Result_bool_IoError" then {
        templateTid96: (builtinTid :ast :symtab base: "Result")
        templateTid97: (builtinTid :ast :symtab base: "Box")
        a194: (builtinTid :ast :symtab base: "bool")
        a293: (builtinTid :ast :symtab base: "IoError")
        rbb: (specTidArgs
            :symtab
            templateTid: templateTid96
            a1: (specTidArgs
                :symtab
                templateTid: templateTid97
                a1: a194
                a2: 0
            )
            a2: a293
        )
        if rbb > 0 then return rbb
        return (specStemTid :ast :symtab base: "Result" arg1: "bool" arg2: "IoError")
    }
    if canon == "Result_Parsed_CliError" then {
        return (specStemTid :ast :symtab base: "Result" arg1: "Parsed" arg2: "CliError")
    }
    if canon == "Result_List_String_IoError" then {
        templateTid98: (builtinTid :ast :symtab base: "Result")
        a195: (specStemTid :ast :symtab base: "ListRef" arg1: "String" arg2: "")
        a294: (builtinTid :ast :symtab base: "IoError")
        return (specTidArgs
            :symtab
            templateTid: templateTid98
            a1: a195
            a2: a294
        )
    }
    # the value-side monos the StringView natives return: stated here, the
    # hole resolves like every other name in a fragment.
    if canon == "optionval_u64" then {
        return (specStemTid :ast :symtab base: "optionval" arg1: "u64" arg2: "")
    }
    if canon == "optionval_u32" then {
        return (specStemTid :ast :symtab base: "optionval" arg1: "u32" arg2: "")
    }
    if canon == "optionval_u8" then {
        return (specStemTid :ast :symtab base: "optionval" arg1: "u8" arg2: "")
    }
    if canon == "resultval_i64_parseerror" then {
        return (specStemTid :ast :symtab base: "resultval" arg1: "i64" arg2: "parseerror")
    }
    if canon == "resultval_u64_parseerror" then {
        return (specStemTid :ast :symtab base: "resultval" arg1: "u64" arg2: "parseerror")
    }
    if canon == "resultval_f64_parseerror" then {
        return (specStemTid :ast :symtab base: "resultval" arg1: "f64" arg2: "parseerror")
    }
    if canon == "resultval_f16_parseerror" then {
        return (specStemTid :ast :symtab base: "resultval" arg1: "f16" arg2: "parseerror")
    }
    if canon == "resultval_f128_parseerror" then {
        return (specStemTid :ast :symtab base: "resultval" arg1: "f128" arg2: "parseerror")
    }
    return 0
}

# ioCanonCname -- memoized wrapper: the canon->cname map is emit-stable and io
# fragments reload the same canons once per unit, so cache each result (incl.
# the "" miss) per program, mirroring resolveByNameC. Avoids re-running the
# O(nextTypeId) registry scan in ioCanonCnameUncached ~30x per canon.
ioCanonCname: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    canon: StringView
} out String is {
    found: false
    cached: String
    {
        h: ctx.ioCanonC.get key: canon.string
        match (
            h
        ) case some then {
            found = true
            cached = h.copy
        } case none then null
    }
    if found then return cached
    r: ioCanonCnameUncached :ast :symtab :ctx :canon
    ctx.ioCanonC.set key: canon.string value: r.copy
    return r
}

# the type behind an io canonical stem, whatever kind it turns out to be
ioCanonTidAny: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    canon: StringView
} out ztypes.tid is {
    st: ioCanonTid :ast :symtab :canon
    if st > 0 then return (ztypes.tid.create from: st.u64)
    # a plain source-name stem (File, IoError, Reader): the system unit first,
    # then the registry scan below for the io/cli units it does not cover.
    nameId94: (zast.poolFind pool: ast.names text: canon)
    mo: (ztypecheck.resolveUnitChildRo
        :ast
        st: symtab
        unitDecl: symtab.typing.systemUnitRoot
        nameId: nameId94
    )
    match (
        mo
    ) case some then {
        return (ztypes.tid.create from: mo.u64)
    } case none then null
    last: symtab.reg.nextTypeId
    found: ztypes.tid
    ti: 1.u64
    for ti < last loop {
        if found.isZero then {
            okc: (definedInNonMain :symtab :ctx tid: (ztypes.tid.create from: ti.u64))
            if okc == false when (
                (originTidOf
                    :symtab
                    tid: (ztypes.tid.create from: ti.u64)
                ) >
                0
            ) then okc = true
            if okc then {
                if (regNameIs
                    :symtab
                    tid: (ztypes.tid.create from: ti.u64)
                    name: canon
                ) then found = ztypes.tid.create from: ti.u64
            }
        }
        ti = ti + 1
    }
    return found
}

# ioCanonCnameUncached -- the id-based cname for an io canonical stem (the part
# after `z_` in a runtime fragment): a mono (Result_*/List_u8/...) via its spec
# trie, else a named system type (IoError/File/filestat/Reader/...) by registry
# name. "" when the type is not in the (demand-driven) registry for this program.
ioCanonCnameUncached: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    canon: StringView
} out String is {
    t: ioCanonTidAny :ast :symtab :ctx :canon
    if t.isZero then return "".string
    return (ctxCname :ctx tid: (ztypes.tid.create from: t.u64))
}

# loadIoFragment -- read an io/cli runtime `.inc` and fill the `z_@Name@`
# holes it spells. The holes found in the file ARE the demand: each name
# resolves through StringView/String or the canon path, and a name that
# resolves to nothing is fatal. Tags (Z_IOERROR_TAG_*) are name-based and
# already match.
loadIoFragment: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    path: StringView
} out String is {
    rd: io.readText :path
    match (
        rd
    ) case ok then {
        bn: List String
        bv: List String
        rwn: List String
        rwv: List String
        names: holeNames text: rd.stringView
        ni: u64
        nn: names.length
        for ni < nn loop {
            nm: names.get i: ni
            nv: nm.stringView
            # `@TAG_<type>@` -- how to reach that type's discriminator. A tagged
            # struct is reached through `.tag`; a type the backend has unwrapped
            # IS its discriminator, and the hole fills with nothing. A fragment
            # spelling this stays correct across a change to the representation,
            # which matters because this file is read by the running compiler
            # AND by the committed seed, and they need not agree.
            if (nv.startsWith prefix: "TAG_") then {
                tn: nv.substring from: 4 to: nv.length
                tt: ioCanonTidAny :ast :symtab :ctx canon: tn
                rwn.append from: nv.string
                if (isOrdinalVariant :symtab tid: (ztypes.tid.create from: tt.u64)) then {
                    rwv.append from: "".string
                } else {
                    rwv.append from: ".tag".string
                }
            } else {
                bn.append from: nv.string
                if nv == "StringView" then {
                    sv: ctx.svC
                    bv.append from: sv.copy
                } else if nv == "String" then {
                    st: ctx.strC
                    bv.append from: st.copy
                } else {
                    cc: ioCanonCname :ast :symtab :ctx canon: nv
                    bv.append from: cc
                }
            }
            ni = ni + 1
        }
        return (fillHolesForCtx
            :ctx
            text: rd
            :path
            bindNames: bn
            bindVals: bv
            rawNames: rwn
            rawVals: rwv
        )
    } case err then {
        emitFail :ctx what: "missing io fragment \{path}" line: 0
        return "/* zemitterc: missing io fragment \{path} */\n"
    }
}

# ioFileId -- the io File class type id (0 when File is not reachable).
ioFileId: function {symtab: zenv.ZSymbolTable.view ctx: Ctx.view} out u64 is {
    last: symtab.reg.nextTypeId
    ti: 1.u64
    for ti < last loop {
        if (
            (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: ti.u64)) ==
            ztypes.ztypetype.classType
        ) then {
            if (regNameIs :symtab tid: (ztypes.tid.create from: ti.u64) name: "File") then {
                if (definedInNonMain
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: ti.u64)
                ) then return ti
            }
        }
        ti = ti + 1
    }
    return 0
}

# ioFileLive -- the File class is present AND its read/write param monos (the
# byte buffer's element mono / ListView_u8) exist, i.e. a File is actually live
# (constructed / io.open / a file method called). This is the order-independent
# gate for emitting File's natives + Reader/Writer conformance: it is true
# exactly when that emitted code's referenced monos have been demanded, so it
# always compiles.
ioFileLive: function {ast: Ast.view symtab: zenv.ZSymbolTable.view ctx: Ctx.view} out bool is {
    calleeTid: ioFileId :symtab :ctx
    if calleeTid == 0 then return false
    listValU8Tid: specStemTid :ast :symtab base: "ListVal" arg1: "u8" arg2: ""
    if listValU8Tid.isZero then return false
    listViewValU8Tid: specStemTid :ast :symtab base: "ListViewVal" arg1: "u8" arg2: ""
    if listViewValU8Tid.isZero then return false
    return true
}

# cliClassTypeId -- the type id of a cli-unit CLASS named `name` (0 absent).
cliClassTypeId: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    nameId: zast.nameid
} out u64 is {
    return (unitClassTid :symtab unitDecl: ctx.cliUnitDecl :nameId).u64
}

# isHeapPtrCollection -- a Map/Set mono is stored as a heap pointer (List is
# embedded by value); a struct field of one is a pointer, freed without `&`.
isHeapPtrCollection: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    cm: chaseColMono :symtab :ctx :tid
    if (isMapOriginOf :symtab :ctx tid: (ztypes.tid.create from: cm.u64)) then return true
    if (isSetOriginOf :symtab :ctx tid: (ztypes.tid.create from: cm.u64)) then return true
    return false
}

# bindFragTypeTids -- resolve each row's `uses_<Type>` demand to a type id.
# Runs after buildDefUnitIndex so the defining unit is an id question too; a
# name that resolves to nothing leaves 0, and the row keeps its member path.
# The registry scan is the house pattern and runs once over the handful of
# rows the table demand-types.
bindFragTypeTids: function {symtab: zenv.ZSymbolTable.view ctx: Ctx ast: Ast.view} is {
    last: symtab.reg.nextTypeId
    i: u64
    n: ctx.fragTypeNames.length
    for i < n loop {
        tn: ctx.fragTypeNames.get :i
        found: ztypes.tid
        if tn.length > 0 then {
            unitNameText: ctx.fragUnits.get :i
            uid: unitDeclByName :symtab :ast name: unitNameText.stringView
            if uid > 0 then {
                ti: 1.u64
                for ti < last loop {
                    if found.isZero then {
                        if (regNameIs
                            :symtab
                            tid: (ztypes.tid.create from: ti.u64)
                            name: tn.stringView
                        ) then {
                            du: defUnitIdOf :ctx tid: (ztypes.tid.create from: ti.u64)
                            if du == uid then found = ztypes.tid.create from: ti.u64
                        }
                    }
                    ti = ti + 1
                }
            }
        }
        ctx.fragTypeTids.append found.u64
        if found > 0 then ctx.demandGatedTids.add item: found.u64
        i = i + 1
    }
}

# rowDemandFired -- true when ANY demand the row at `i` names was demanded for that
# row's unit. `demand=a,b,c` means ANY OF: a helper several members share is one
# row naming the members that reach it, so it loads once however many fired.
rowDemandFired: function {ctx: Ctx.view i: u64} out bool is {
    tt: ctx.fragTypeTids.get :i
    if tt > 0 then return (typeIsUsed :ctx tid: (ztypes.tid.create from: tt.u64))
    u: ctx.fragUnits.get :i
    d: ctx.fragMembs.get :i
    fired: false
    with dit: (d.stringView.split sep: ",") do for dm: dit loop {
        if dm.length > 0 then {
            if (needsHasM :ctx uname: u.stringView memb: dm) then fired = true
        }
    }
    return fired
}

# emitRuntimeUnit -- one unit's runtime: every row it owns, in TABLE ORDER,
# loaded when its demands fired. This is the whole of what emitRuntimeIo,
# emitRuntimeCli, emitRuntimeOs, emitRuntimeNet, emitRuntimeTcc,
# emitNeededNatives and emitRuntimeSvIter did by hand. The order they spelled is
# the order the rows are written in -- including the alphabetical convention
# runs, because a subset of an alphabetically ordered list, taken in order, is
# already sorted. The per-unit skip lists are gone with them: a member the
# runtime does not supply has no row to walk.
emitRuntimeUnit: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    uname: StringView
    buf: String.borrow
} is {
    i: u64
    n: ctx.fragUnits.length
    for i < n loop {
        # the unit name is read through a view scoped to its block and the
        # fragment list is an owned copy: the fragment emitter below lends ctx
        isU: false
        {
            u: ctx.fragUnits.get :i
            isU = u.stringView == uname
        }
        if isU then {
            if (rowDemandFired :ctx :i) then {
                fl: (ctx.fragNames.get :i).copy
                with fit: (fl.stringView.split sep: ",") do for fr: fit loop {
                    if fr.length > 0 then {
                        ioFrag :ast :symtab :ctx :runtimeDir frag: fr :buf
                    }
                }
            }
        }
        i = i + 1
    }
}

# emitUnorderedUnits -- the units with rows the order directive does not name,
# each once, in the order the table first mentions them. A unit shipping its own
# natives.tbl rows is not in the compiler's list, and this is the slot it gets.
# `prelude` is not one of them: emitC emits it into the header itself.
emitUnorderedUnits: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    buf: String.borrow
} is {
    done: List String
    i: u64
    n: ctx.fragUnits.length
    for i < n loop {
        # an owned copy: the runtime emitter below lends ctx
        u: (ctx.fragUnits.get :i).copy
        skip: false
        if u.stringView == "prelude" then skip = true
        with oit: ctx.unitOrder.iterate do for o: oit loop {
            if o.stringView == u.stringView then skip = true
        }
        with dit: done.iterate do for d: dit loop {
            if d.stringView == u.stringView then skip = true
        }
        if skip == false then {
            done.append from: u.copy
            emitRuntimeUnit :ast :symtab :ctx :runtimeDir uname: u.stringView :buf
        }
        i = i + 1
    }
}

# ioFrag -- load + append an io runtime fragment unconditionally.
ioFrag: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    frag: StringView
    buf: String.borrow
} is {
    p: nativePath :runtimeDir :frag
    f: loadIoFragment :ast :symtab :ctx path: p.stringView
    buf.append f
}

# emitIoFileConformance -- protocol conformance helpers for every reachable io
# class (File -> Reader/Writer/Closer/Seeker; BufWriter -> Writer; BufReader ->
# Reader), emitted after the io natives the wrappers forward to.
emitIoFileConformance: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    buf: String.borrow
} is {
    ioUid: ctx.ioUnitDecl
    osUid: ctx.osUnitDecl
    cliUid: ctx.cliUnitDecl
    last: symtab.reg.nextTypeId
    ti: 1.u64
    for ti < last loop {
        if (
            (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: ti.u64)) ==
            ztypes.ztypetype.classType
        ) then {
            cmo: originTidOf :symtab tid: (ztypes.tid.create from: ti.u64)
            if cmo.isZero then {
                duId: defUnitIdOf :ctx tid: (ztypes.tid.create from: ti.u64)
                isIoC: false
                if duId > 0 then {
                    if duId == ioUid then isIoC = true
                    if duId == osUid then isIoC = true
                    if duId == cliUid then isIoC = true
                }
                if isIoC then {
                    cn: regNameOf :symtab tid: (ztypes.tid.create from: ti.u64)
                    okEmit: false
                    if cn.stringView == "File" then {
                        okEmit = ioFileLive :ast :symtab :ctx
                    } else {
                        okEmit = typeIsUsed :ctx tid: (ztypes.tid.create from: ti.u64)
                    }
                    if okEmit then {
                        (emitConformanceImplsForType
                            :ast
                            :symtab
                            :ctx
                            implTid: (ztypes.tid.create from: ti.u64)
                            isFacet: false
                            :buf
                        )
                    }
                }
            }
        }
        ti = ti + 1
    }
}

# emitIoStdStreams -- io.stdin/stdout/stderr: a borrowed Reader/Writer over a
# static backing File on fd 0/1/2 (closed=true so RAII never closes it).
emitIoStdStreams: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    buf: String.borrow
} is {
    needAny: false
    if (needsHasM :ctx uname: "io" memb: "stdout") then needAny = true
    if (needsHasM :ctx uname: "io" memb: "stderr") then needAny = true
    if (needsHasM :ctx uname: "io" memb: "stdin") then needAny = true
    if needAny == false then return
    fid: ioFileId :symtab :ctx
    if fid == 0 then return
    fbase: ctxCname :ctx tid: (ztypes.tid.create from: fid.u64)
    wcn: ioCanonCname :ast :symtab :ctx canon: "Writer"
    rcn: ioCanonCname :ast :symtab :ctx canon: "Reader"
    if (needsHasM :ctx uname: "io" memb: "stdout") then {
        b0: "static \{fbase}_t z_io_stdout_File = { 1, true };\nstatic \{wcn}_t z_io_stdout(void) {\n    return \{fbase}_Writer_create(&z_io_stdout_File);\n}\n\n"
        buf.append b0
    }
    if (needsHasM :ctx uname: "io" memb: "stderr") then {
        b1: "static \{fbase}_t z_io_stderr_File = { 2, true };\nstatic \{wcn}_t z_io_stderr(void) {\n    return \{fbase}_Writer_create(&z_io_stderr_File);\n}\n\n"
        buf.append b1
    }
    if (needsHasM :ctx uname: "io" memb: "stdin") then {
        b2: "static \{fbase}_t z_io_stdin_File = { 0, true };\nstatic \{rcn}_t z_io_stdin(void) {\n    return \{fbase}_Reader_create(&z_io_stdin_File);\n}\n\n"
        buf.append b2
    }
}

# emitIoFileClass -- the io.File value rep: { int32_t fd; bool closed } + a
# destructor that closes the fd once (RAII). Emitted only when File is reachable
# (in the demand-driven registry). The generic record path can't produce the
# close-fd destructor, so File gets this dedicated emitter. The type is marked
# in ctx.emittedUserTypes so every other path skips it -- without that mark a
# by-value use of File would emit a second struct carrying a generic destructor
# that never closes the fd.
emitIoFileClass: function {ctx: Ctx buf: String.borrow} is {
    fid: ztypes.tid.create from: ctx.ioFileTid
    if fid.isZero then return
    if (ctx.emittedUserTypes.has item: fid) then return
    ctx.emittedUserTypes.add item: fid.u64
    fc: ctxCname :ctx tid: fid
    if (isFwdDeclared :ctx tid: fid) then {
        l0: "struct \{fc}_t {\n    int32_t fd;\n    bool closed;\n};\n"
        buf.append l0
    } else {
        l0: "typedef struct {\n    int32_t fd;\n    bool closed;\n} \{fc}_t;\n"
        buf.append l0
    }
    l1: "static void \{fc}_destroy(\{fc}_t* p) {\n    if (!p) return;\n    if (p->closed) return;\n    close(p->fd);\n    p->closed = true;\n}\n\n"
    buf.append l1
}

# emitNetFdClass -- one net fd-holder class ({ int32_t fd; bool closed } + a
# close-once destructor), the net analogue of emitIoFileClass. The net runtime
# fragments dereference the fields, so the body is pre-emitted here and the
# type marked in ctx.emittedUserTypes so the ordered user-struct pass skips it
# (that pass runs after the fragments -- too late).
emitNetFdClass: function {ctx: Ctx tid: u64 buf: String.borrow} is {
    fid: ztypes.tid.create from: tid
    if fid.isZero then return
    if (ctx.emittedUserTypes.has item: fid) then return
    ctx.emittedUserTypes.add item: fid.u64
    fc: ctxCname :ctx tid: fid
    if (isFwdDeclared :ctx tid: fid) then {
        l0: "struct \{fc}_t {\n    int32_t fd;\n    bool closed;\n};\n"
        buf.append l0
    } else {
        l0: "typedef struct {\n    int32_t fd;\n    bool closed;\n} \{fc}_t;\n"
        buf.append l0
    }
    l1: "static void \{fc}_destroy(\{fc}_t* p) {\n    if (!p) return;\n    if (p->closed) return;\n    close(p->fd);\n    p->closed = true;\n}\n\n"
    buf.append l1
}

# emitNetClasses -- the net fd-holder value reps (Listener/Conn), need-gated.
emitNetClasses: function {ctx: Ctx buf: String.borrow} is {
    if (needsHasM :ctx uname: "net" memb: "@unit") == false then return
    emitNetFdClass :ctx tid: ctx.netListenerTid :buf
    emitNetFdClass :ctx tid: ctx.netConnTid :buf
}

# maybePreEmitElem -- a user type (variant/record/class/union) used as a
# collection element is embedded BY VALUE by the List/ListView mono, so its
# struct must precede the mono. Emit it here (guarded by ctx.emittedUserTypes);
# its methods still emit later in emitRecordDefsIn. Covers main-unit AND dep
# file-unit element types (the cross-unit astnode union returned by value from a
# ListView_Node mono); monos / generics / typedefs and system-unit types (which
# have their own dedicated sweeps above) are skipped.
maybePreEmitElem: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    eid: ztypes.tid
    buf: String.borrow
} is {
    if eid.isZero then return
    rid0: eid
    snm0: regNameOf :symtab tid: (ztypes.tid.create from: eid.u64)
    sduo: definedInUnitOf :symtab tid: (ztypes.tid.create from: eid.u64)
    match (
        sduo
    ) case some then null case none then {
        if snm0.length > 0 then {
            srid: (canonTypeId
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: eid.u64)
                name: snm0.stringView
            )
            if srid > 0 then rid0 = ztypes.tid.create from: srid.u64
        }
    }
    cid: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: rid0.u64)
    monoLk4: originTidOf :symtab tid: (ztypes.tid.create from: cid.u64)
    if monoLk4 > 0 then return
    if (isGenericType :symtab tid: (ztypes.tid.create from: cid.u64)) then return
    duoPe: definedInUnitOf :symtab tid: (ztypes.tid.create from: cid.u64)
    peUnit: ctx.mainName.copy
    match (
        duoPe
    ) case some then {
        if (symtab.reg.isNativeOf tid: (ztypes.tid.create from: cid.u64)) then return
        peUnit = duoPe.copy
    } case none then null
    nm: regNameOf :symtab tid: (ztypes.tid.create from: cid.u64)
    if nm.length == 0 then return
    tt: symtab.reg.typetypeOf typeId: cid
    smPe: ctx.mainName.copy
    smPeD: ctx.mainUnitId
    (ctxBindMain
        :ctx
        name: peUnit.stringView
        unitDecl: (ztypecheck.unitDeclOfTid
            st: symtab
            tid: (ztypes.tid.create from: cid.u64)
        )
    )
    if tt == ztypes.ztypetype.variantType then {
        emitOneVariant :ast :symtab :ctx tid: (ztypes.tid.create from: cid.u64) :buf
    }
    if tt == ztypes.ztypetype.recordType then {
        emitOneRecord :ast :symtab :ctx tid: (ztypes.tid.create from: cid.u64) :buf
    }
    if tt == ztypes.ztypetype.classType then {
        emitOneRecord :ast :symtab :ctx tid: (ztypes.tid.create from: cid.u64) :buf
    }
    if tt == ztypes.ztypetype.protocolType then {
        (emitOneProtocol
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: cid.u64)
            :buf
        )
    }
    if tt == ztypes.ztypetype.facetType then {
        emitOneFacet :ast :symtab :ctx tid: (ztypes.tid.create from: cid.u64) :buf
    }
    if tt == ztypes.ztypetype.unionType then {
        emitUnionMono :ast :symtab :ctx tid: (ztypes.tid.create from: cid.u64) :buf
    }
    ctxBindMain :ctx name: smPe.stringView unitDecl: smPeD
}

# preEmitEmbeddedTypes -- emit the main-unit user types a variant/record/class
# embeds BY VALUE (arm payloads, field types) before its own struct, so they are
# declared first. Idempotent via ctx.emittedUserTypes, which also breaks cycles.
preEmitEmbeddedTypes: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    ids: (ListVal u64).view
    buf: String.borrow
} is {
    pi: u64
    pn: ids.length
    for pi < pn loop {
        eidv: ids.get i: pi
        maybePreEmitElem :ast :symtab :ctx eid: (ztypes.tid.create from: eidv.u64) :buf
        pi = pi + 1
    }
}

# isFwdDeclared -- the type was forward-declared by emitMainFwdDecls, so its
# body must be emitted as a named `struct X_t { ... };` (the typedef is already
# in the forward-decl block).
isFwdDeclared: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    return (ctx.fwdDeclaredTypes.has item: tid)
}

# emitMainFwdDecls -- forward-declare every RECORD + UNION + CLASS type whose
# body this emitter writes (named-struct typedef + a destructor prototype)
# before the monos. The AST is a self-referential astnode union: Node_destroy +
# the Option/List monos + the print functions reference astnode and the arm *Data
# structs by pointer (or call their destroys) ahead of the bodies, so without
# forward declarations they are undeclared. The bodies then emit as plain
# `struct X_t { ... };` via isFwdDeclared.
#
# Which types those are is a question for the DECLARATION, not for the unit's
# name. `is native` on a class or record means the RUNTIME owns the layout: the
# sixteen scalars, String and StringView, and the sviter iterators all get their
# C from a fragment, and a forward declaration of one is a conflicting typedef
# -- LinesIter's fragment is `typedef z_Splitter_t z_LinesIter_t;`, an ALIAS
# that no `typedef struct X_t X_t;` can ever be made compatible with. Everything
# else this pass reaches is a struct the emitter writes, whichever unit declared
# it, so io's File and cli's Spec are forward-declared on the same terms as a
# user record -- and a USER type shadowing a builtin name carries no marker, so
# it keeps its forward declaration and its own layout.
#
# The two synthesized `tag__{elem}` carriers reach this pass and are forward-
# declared with it. Nothing names them in the C, so the declaration is dead but
# valid; measured, no structural property separates them from a real type here
# (their registry def is their own, not their unit root, which is what a
# synthesized type otherwise looks like).
emitMainFwdDecls: function {symtab: zenv.ZSymbolTable.view ctx: Ctx buf: String.borrow} is {
    last: symtab.reg.nextTypeId
    t: ztypes.tid
    for t < last loop {
        tt: symtab.reg.typetypeOf typeId: t
        isStructType: false
        isUnion: false
        if tt == ztypes.ztypetype.recordType then isStructType = true
        if tt == ztypes.ztypetype.unionType then {
            isStructType = true
            isUnion = true
        }
        if tt == ztypes.ztypetype.classType then isStructType = true
        if isStructType then {
            gen: isGenericType :symtab tid: (ztypes.tid.create from: t.u64)
            mo: originTidOf :symtab tid: (ztypes.tid.create from: t.u64)
            if mo.isZero when gen == false then {
                duo: definedInUnitOf :symtab tid: (ztypes.tid.create from: t.u64)
                match (
                    duo
                ) case some then {
                    if (symtab.reg.isNativeOf tid: (ztypes.tid.create from: t.u64)) == false then {
                        if (
                            (isTypedefType
                                :symtab
                                tid: (ztypes.tid.create from: t.u64)
                            ) ==
                            false
                        ) when (isBoxTid :symtab tid: t) == false then {
                            cn: ctxCname :ctx tid: (ztypes.tid.create from: t.u64)
                            ctx.fwdDeclaredTypes.add item: t.u64
                            l0: "typedef struct \{cn}_t \{cn}_t;\n"
                            buf.append l0
                            needDtor: isUnion
                            if (symtab.reg.needsDestructor typeId: t) then needDtor = true
                            if needDtor then {
                                l1: "static void \{cn}_destroy(\{cn}_t* p);\n"
                                buf.append l1
                            }
                        }
                    }
                } case none then null
            } else {
                fwdM: false
                if mo > 0 then {
                    if (symtab.reg.needsDestructor typeId: t) then fwdM = true
                    if (isListOriginOf
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: t.u64)
                    ) then fwdM = true
                    if (isListViewOriginOf
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: t.u64)
                    ) then fwdM = true
                    if (isSetOriginOf
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: t.u64)
                    ) then fwdM = true
                    if (isMapOriginOf
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: t.u64)
                    ) then fwdM = true
                }
                if (isBoxTid :symtab tid: (ztypes.tid.create from: t.u64)) then fwdM = false
                if fwdM then {
                    cnX: ctxCname :ctx tid: (ztypes.tid.create from: t.u64)
                    ctx.fwdDeclaredTypes.add item: t.u64
                    lx0: "typedef struct \{cnX}_t \{cnX}_t;\n"
                    buf.append lx0
                    fwdDtor: false
                    if (symtab.reg.needsDestructor typeId: t) then fwdDtor = true
                    if (isMapOriginOf
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: t.u64)
                    ) then fwdDtor = true
                    if (isSetOriginOf
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: t.u64)
                    ) then fwdDtor = true
                    if fwdDtor then {
                        lx1: "static void \{cnX}_destroy(\{cnX}_t* p);\n"
                        buf.append lx1
                    }
                }
            }
        }
        t = ztypes.tid.create from: (t + 1)
    }
}

# monoMapKV -- a Map/MapEntry mono's value + key type ids. A mono carries no
# concrete generic-argument row of its own, so resolve the value via the
# get-return OptionView's element name and the key via the mangled-name
# remainder, mirroring emitMapMono.
monoMapKV: function {symtab: zenv.ZSymbolTable.view monoId: ztypes.tid acc: ListVal u64} is {
    go: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.names.wkGet
    match (
        go
    ) case some then {
        vid: mapValType :symtab monoId: (ztypes.tid.create from: monoId.u64)
        if vid > 0 then acc.append vid
        kid: mapKeyType :symtab :monoId
        if kid > 0 then acc.append kid
    } case none then null
}

# monoElemIdsOf -- the type ids a collection/wrapper mono references by its
# element/key/value (List/ListView/Set/Map) or arm payloads (optionval/resultval/
# Option/Result/OptionView), or its fields for a user-generic record/class mono.
# Used by the early/late split to find which monos embed a user type.
monoElemIdsOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    monoId: ztypes.tid
    acc: ListVal u64
} is {
    isLV: false
    if (isListOriginOf :symtab :ctx tid: monoId) then isLV = true
    if (isListViewOriginOf :symtab :ctx tid: monoId) then isLV = true
    if isLV then {
        e: listElemType :symtab :monoId
        if e > 0 then acc.append e
        return
    }
    if (isSetOriginOf :symtab :ctx tid: monoId) then {
        eid: setElemType :symtab :monoId
        if eid > 0 then acc.append eid
        return
    }
    if (isMapOriginOf :symtab :ctx tid: monoId) then {
        monoMapKV :symtab :monoId :acc
        return
    }
    # the id-keyed pair read their element types the same way their hashed
    # siblings do. They need an arm of their own because, unlike a Map, they
    # are STACK structs: an IdMap embedding a user type by value is a real
    # ordering edge, and without this it looks like it embeds nothing and is
    # emitted ahead of the optionval its `get` returns.
    if (isIdSetOriginOf :symtab :ctx tid: monoId) then {
        ideid: setElemType :symtab :monoId
        if ideid > 0 then acc.append ideid
        return
    }
    if (isIdMapOriginOf :symtab :ctx tid: monoId) then {
        monoMapKV :symtab :monoId :acc
        return
    }
    isWrap: false
    if (originIsTid
        :symtab
        tid: monoId
        originTid: (ctx.origins.get i: ogOptionval)
    ) then isWrap = true
    if (originIsTid
        :symtab
        tid: monoId
        originTid: (ctx.origins.get i: ogResultval)
    ) then isWrap = true
    if (originIsTid :symtab tid: monoId originTid: (ctx.origins.get i: ogOption)) then isWrap = true
    if (originIsTid :symtab tid: monoId originTid: (ctx.origins.get i: ogResult)) then isWrap = true
    if (originIsTid
        :symtab
        tid: monoId
        originTid: (ctx.origins.get i: ogOptionView)
    ) then isWrap = true
    if isWrap then {
        aids: ListVal u64
        aidsNm: ListVal u64
        variantArmIds :symtab tid: monoId ids: aids nameIds: aidsNm
        ai: u64
        an: aids.length
        for ai < an loop {
            av: aids.get i: ai
            acc.append av
            ai = ai + 1
        }
        return
    }
    fids: ListVal u64
    fidsNm: ListVal u64
    recFieldIds :symtab tid: monoId ids: fids nameIds: fidsNm
    fi: u64
    fn: fids.length
    for fi < fn loop {
        fv: fids.get i: fi
        acc.append fv
        fi = fi + 1
    }
}

# buildUserTypeList -- every struct type whose C body this emitter writes:
# RECORD / CLASS / UNION / VARIANT / FACET that is not a mono, not a generic
# template, and whose layout the runtime does not own. A mono embedding one of
# these by value must be emitted after it. Types a fragment row demand-gates
# join only once the program constructs them, on the same terms the sweep's
# own drain applies -- without that the list would emit an io wrapper class
# into every program that merely imports io.
buildUserTypeList: function {symtab: zenv.ZSymbolTable.view ctx: Ctx.view acc: ListVal u64} is {
    last: symtab.reg.nextTypeId
    t: ztypes.tid
    for t < last loop {
        tt: symtab.reg.typetypeOf typeId: t
        isStruct: false
        if tt == ztypes.ztypetype.recordType then isStruct = true
        if tt == ztypes.ztypetype.classType then isStruct = true
        if tt == ztypes.ztypetype.unionType then isStruct = true
        if tt == ztypes.ztypetype.variantType then isStruct = true
        if tt == ztypes.ztypetype.facetType then isStruct = true
        if isStruct then {
            mo: originTidOf :symtab tid: (ztypes.tid.create from: t.u64)
            gen: isGenericType :symtab tid: (ztypes.tid.create from: t.u64)
            if mo.isZero when gen == false then {
                duo: definedInUnitOf :symtab tid: (ztypes.tid.create from: t.u64)
                match (
                    duo
                ) case some then {
                    emOk: (
                        (symtab.reg.isNativeOf
                            tid: (ztypes.tid.create from: t.u64)
                        ) ==
                        false
                    )
                    if emOk when (typeDemandMet
                        :ctx
                        tid: (ztypes.tid.create from: t.u64)
                    ) then acc.append t.u64
                } case none then null
            }
        }
        t = ztypes.tid.create from: (t + 1)
    }
}

# monoDependsOnUser -- does the mono's layout reference a user type, directly or
# through a nested mono? The seen list breaks cycles through boxed monos.
monoDependsOnUser: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    monoId: ztypes.tid
    userList: (ListVal u64).view
    seen: ListVal u64
} out bool is {
    if (seen.contains item: monoId) then return false
    seen.append monoId.u64
    elems: ListVal u64
    monoElemIdsOf :symtab :ctx :monoId acc: elems
    ei: u64
    en: elems.length
    for ei < en loop {
        eid: elems.get i: ei
        ceid: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: eid.u64)
        if (userList.contains item: ceid) then return true
        emo: originTidOf :symtab tid: (ztypes.tid.create from: ceid.u64)
        if emo > 0 then {
            if (monoDependsOnUser
                :ast
                :symtab
                :ctx
                monoId: (ztypes.tid.create from: ceid.u64)
                :userList
                :seen
            ) then return true
        }
        ei = ei + 1
    }
    return false
}

# monoIsLate -- the mono embeds a user type by value (a fresh seen per query).
monoIsLate: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    monoId: ztypes.tid
    userList: (ListVal u64).view
} out bool is {
    seen: ListVal u64
    return (monoDependsOnUser :ast :symtab :ctx :monoId :userList :seen)
}

# userDefnRefsUnemitted -- does the user type have a by-value field whose type is
# in groupList but not yet in emittedList? Map/Set fields are heap pointers in the
# port (fwd-decl suffices) so they impose no ordering edge; a UNION is boxed so it
# is never dragged by its own arms. Passing an empty emittedList answers the plain
# "references any group member" question used by the late-type closure.
userDefnRefsUnemitted: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    typeId: ztypes.tid
    group: (IdSet u64).view
    emitted: (IdSet u64).view
} out bool is {
    tt: symtab.reg.typetypeOf :typeId
    if tt == ztypes.ztypetype.unionType then return false
    fids: ListVal u64
    if tt == ztypes.ztypetype.variantType then {
        fidsNm: ListVal u64
        variantArmIds :symtab tid: typeId ids: fids nameIds: fidsNm
    } else if tt == ztypes.ztypetype.facetType then {
        # a facet's ordering edges are its conforming impls (embedded by
        # value in the data union), not record fields
        facetImplTids :symtab tid: typeId acc: fids
    } else {
        fidsNm: ListVal u64
        recFieldIds :symtab tid: typeId ids: fids nameIds: fidsNm
    }
    fi: u64
    fn: fids.length
    for fi < fn loop {
        fid: fids.get i: fi
        cfid: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: fid.u64)
        skip: isHeapPtrCollection :symtab :ctx tid: (ztypes.tid.create from: fid.u64)
        if skip == false then {
            if (group.has item: cfid) then {
                if (emitted.has item: cfid) == false then return true
            }
        }
        fi = fi + 1
    }
    return false
}

# monoLateDepsMet -- every late-group member the mono references by value is
# already emitted (so the mono can be emitted now).
monoLateDepsMet: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    monoId: ztypes.tid
    group: IdSet u64
    emitted: IdSet u64
    seen: ListVal u64
} out bool is {
    if (seen.contains item: monoId) then return true
    seen.append monoId.u64
    elems: ListVal u64
    monoElemIdsOf :symtab :ctx :monoId acc: elems
    ei: u64
    en: elems.length
    for ei < en loop {
        eid: elems.get i: ei
        ceid: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: eid.u64)
        if (group.has item: ceid) then {
            if (emitted.has item: ceid) == false then return false
        }
        emo: originTidOf :symtab tid: (ztypes.tid.create from: ceid.u64)
        if emo > 0 then {
            if (
                (monoLateDepsMet
                    :ast
                    :symtab
                    :ctx
                    monoId: (ztypes.tid.create from: ceid.u64)
                    :group
                    :emitted
                    :seen
                ) ==
                false
            ) then return false
        }
        ei = ei + 1
    }
    return true
}

# emitUserTypeById -- emit one user RECORD/CLASS/UNION/VARIANT/PROTOCOL struct by
# id, with ctx.mainName set to its defining unit (cross-unit create macros and
# resolution read it). Idempotent via ctx.emittedUserTypes inside each emitter.
emitUserTypeById: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    nm: regNameOf :symtab :tid
    if nm.length == 0 then return
    duo: definedInUnitOf :symtab :tid
    sm: ctx.mainName.copy
    smD: ctx.mainUnitId
    match (
        duo
    ) case some then {
        (ctxBindMain
            :ctx
            name: duo.stringView
            unitDecl: (ztypecheck.unitDeclOfTid st: symtab :tid)
        )
    } case none then null
    tt: symtab.reg.typetypeOf typeId: tid
    if tt == ztypes.ztypetype.variantType then (emitOneVariant
        :ast
        :symtab
        :ctx
        :tid
        :buf
    )
    if tt == ztypes.ztypetype.recordType then (emitOneRecord
        :ast
        :symtab
        :ctx
        :tid
        :buf
    )
    if tt == ztypes.ztypetype.classType then (emitOneRecord
        :ast
        :symtab
        :ctx
        :tid
        :buf
    )
    if tt == ztypes.ztypetype.unionType then (emitUnionMono
        :ast
        :symtab
        :ctx
        :tid
        :buf
    )
    if tt == ztypes.ztypetype.protocolType then {
        emitOneProtocol :ast :symtab :ctx :tid :buf
    }
    if tt == ztypes.ztypetype.facetType then {
        emitOneFacet :ast :symtab :ctx :tid :buf
    }
    ctxBindMain :ctx name: sm.stringView unitDecl: smD
}

# emitMonoById -- emit one late collection/variant mono by id (dispatch on origin).
emitMonoById: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    if (originIsTid :symtab tid: monoId originTid: (ctx.origins.get i: ogOptionval)) then {
        emitOneVariant :ast :symtab :ctx tid: monoId :buf
        return
    }
    if (originIsTid :symtab tid: monoId originTid: (ctx.origins.get i: ogResultval)) then {
        emitOneVariant :ast :symtab :ctx tid: monoId :buf
        return
    }
    if (isListViewOriginOf :symtab :ctx tid: monoId) then {
        emitListViewMono :ast :symtab :ctx :runtimeDir :monoId :buf
        return
    }
    if (originIsTid :symtab tid: monoId originTid: (ctx.origins.get i: ogArray)) then {
        emitArrayMono :ast :symtab :ctx :runtimeDir :monoId :buf
        return
    }
    if (isListOriginOf :symtab :ctx tid: monoId) then {
        emitListMono :ast :symtab :ctx :runtimeDir :monoId :buf
        return
    }
    if (isSetOriginOf :symtab :ctx tid: monoId) then {
        emitSetMono :ast :symtab :ctx :runtimeDir :monoId :buf
        return
    }
    if (isMapOriginOf :symtab :ctx tid: monoId) then {
        emitMapMono :ast :symtab :ctx :runtimeDir :monoId :buf
        return
    }
    if (isIdSetOriginOf :symtab :ctx tid: monoId) then {
        emitIdSetMono :ast :symtab :ctx :runtimeDir :monoId :buf
        return
    }
    if (isIdMapOriginOf :symtab :ctx tid: monoId) then {
        emitIdMapMono :ast :symtab :ctx :runtimeDir :monoId :buf
        return
    }
}

# collectLateMonosKind -- append late monos of one origin to acc. Called in
# kind-priority order so a mono returned by value by another (List.listView ->
# ListView, Map.get -> optionval) is collected, and thus emitted, before it.
collectLateMonosKind: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    originTid: ztypes.tid
    userList: (ListVal u64).view
    acc: ListVal u64
    last: u64
} is {
    tm: ztypes.tid
    for tm < last loop {
        if (originIsTid :symtab tid: tm :originTid) then {
            if (monoIsLate
                :ast
                :symtab
                :ctx
                monoId: (ztypes.tid.create from: tm.u64)
                :userList
            ) then acc.append tm.u64
        }
        tm = ztypes.tid.create from: (tm + 1)
    }
}

# fnDeclScopeTid -- the scope a FUNCTION is declared in, as a type id: the
# owning object type for a method, the namespace / subunit type for a nested
# fn, and 0 for a free function at file-unit scope, whose demand is recorded
# under the unit-root key instead. Read from the FUNCTION's own declaration
# parent, never from a member row: a fn-pointer FIELD's type IS the free
# function's type, so a member-row map answers "owned by the struct holding the
# field", which is not where that function's demand lives.
fnDeclScopeTid: function {symtab: zenv.ZSymbolTable.view fid: ztypes.tid} out ztypes.tid is {
    d: ztypecheck.declOfTypeId st: symtab tid: fid
    if d.isZero then return ztypes.tid
    p: ztypecheck.declParentIdOf st: symtab declId: d
    if p.isZero then return ztypes.tid
    ur: ztypecheck.unitDeclOfTid st: symtab tid: fid
    if p == ur then return ztypes.tid
    return (ztypecheck.declTypeIdOf st: symtab declId: p)
}

# stdFnRefEmittable -- a FUNCTION worth a reference cname / _ft typedef: one
# this emitter DEFINES. A native routes through the declaration-driven call
# emitter and has no id-cname definition, and an undemanded body carries no
# stamps. Both are facts about the DECLARATION. Answering `true` outright when
# the declaring unit is not on a six-name list makes an ordinary user record's C
# depend on whether its file is called `cli.z`.
stdFnRefEmittable: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    fid: ztypes.tid
} out bool is {
    duo: definedInUnitOf :symtab tid: fid
    match (
        duo
    ) case some then {
        if (fnIsNativeId :symtab :fid) then return false
        # demand is recorded under the composed "unit.fn" key; read the fn
        # name off the id-keyed registry entry to compose it
        fnm: symtab.reg.nameOf tid: fid
        if fnm.length == 0 then return false
        return (stdFnUndemanded
            :ast
            :symtab
            unitName: duo.stringView
            fnName: fnm.stringView
            ownerTid: (fnDeclScopeTid :symtab :fid)
            wantWalked: false
        ) == false
    } case none then {
        return false
    }
}

# fnptrTypedefEligible -- a FUNCTION type worth a `_ft` typedef: a real spec /
# free function / method whose C this emitter writes. Synthetic create/==/!=
# carry no declaration; generic templates and monos are skipped.
fnptrTypedefEligible: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out bool is {
    if (isGenericType :symtab :tid) then return false
    mo: originTidOf :symtab :tid
    if mo > 0 then return false
    return (stdFnRefEmittable :ast :symtab fid: (ztypes.tid.create from: tid.u64))
}

# fnRegReturnId -- a FUNCTION type's registered return type id (0 when none).
fnRegReturnId: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out ztypes.tid is {
    return (symtab.reg.returnTypeOf :tid)
}

# fnptrRetTypeC -- C return type for a FUNCTION's `_ft` typedef. The return type
# is read from funcReturnNode (the registry returnTypeId is not populated for
# top-level functions) via the node stamp, mirroring fnReturnTypeId.
fnptrRetTypeC: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
} out String is {
    rtid: ztypes.tid
    rno: symtab.typing.funcReturnNode.get key: tid
    match (
        rno
    ) case some then {
        rtid = stampIdOf :symtab nid: rno
    } case none then null
    if rtid.isZero then rtid = fnRegReturnId :symtab :tid
    if rtid.isZero then return "void".string
    rn: regNameOf :symtab tid: (ztypes.tid.create from: rtid.u64)
    base9: String
    if rtid == ctx.strTid then base9 = "\{ctx.strC}_t"
    if base9.length == 0 when rtid == ctx.svTid then base9 = "\{ctx.svC}_t"
    if base9.length == 0 then {
        rc: scalarCTypeFor :symtab name: rn.stringView tid: (ztypes.tid.create from: rtid.u64)
        if rc.length > 0 then base9 = rc
    }
    if base9.length == 0 then {
        rr: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: rtid.u64) thisTid: ztypes.tid
        if rr.length > 0 then base9 = rr
    }
    if base9.length == 0 then base9 = "int64_t".string
    # the typedef names the SIGNATURE, so it takes the same two promotions
    # fnSignature applies: a Map/Set return is a heap pointer, and a
    # reference-returning one hands back an address. They are mutually
    # exclusive -- fnReturnsRefBorrow declines a heap-pointer collection.
    if (isHeapPtrCollection :symtab :ctx tid: rtid) then {
        bs9: "\{base9}*"
        base9 = bs9
    }
    if (fnReturnsRefBorrow
        :ast
        :symtab
        :ctx
        fid: tid
        retTid: rtid
    ) then {
        bs9b: "\{base9}*"
        base9 = bs9b
    }
    return base9
}

# fnptrParamTypeC -- C type for one param of a FUNCTION's `_ft` typedef, applying
# the same pointer promotions as fnSignature so the typedef matches the emitted
# signature.
fnptrParamTypeC: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    fid: ztypes.tid
    pname: StringView
    pid: ztypes.tid
} out String is {
    ct: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: pid.u64) thisTid: ztypes.tid
    ptrp: paramTypeIsPointer :ast :symtab :ctx :fid :pname :pid
    if ptrp then {
        if ct.length > 0 then {
            ctp: "\{ct}*"
            ct = ctp
        }
    }
    if ct.length == 0 then return "int64_t".string
    return ct
}

# ensureFwdStruct -- forward-declare a user record/class referenced by a fnptr
# typedef (a pointer-to-incomplete or uncalled by-value return typedef is legal
# C). Guarded so emitUserStructsOrdered later emits the named struct body.
ensureFwdStruct: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    # the body is already out, so nothing needs declaring ahead of it -- and a
    # forward would CONTRADICT it: a type reaches its body through
    # fwdDeclaredTypes, and one that was not in that set was written as an
    # anonymous `typedef struct { ... } X_t;` with no tag for
    # `typedef struct X_t X_t;` to name. The monos emit before this pass runs.
    if (typeStructEmitted :ctx :tid) then return
    nmS: regNameOf :symtab :tid
    scalarCType: scalarCTypeFor :symtab name: nmS.stringView :tid
    if scalarCType.length > 0 then return
    duo5: definedInUnitOf :symtab :tid
    match (
        duo5
    ) case some then {
        if (symtab.reg.isNativeOf tid: (ztypes.tid.create from: tid.u64)) then return
    } case none then null
    # a typedef wrapper (Path over String) has no struct of its own -- its C
    # spelling is the wrapped type, so a forward struct tag would name nothing
    if (isTypedefType :symtab tid: (ztypes.tid.create from: tid.u64)) then return
    tt: symtab.reg.typetypeOf typeId: tid
    isStruct: false
    if tt == ztypes.ztypetype.recordType then isStruct = true
    if tt == ztypes.ztypetype.classType then isStruct = true
    if isStruct then {
        if (originIsTid :symtab :tid originTid: (ctx.origins.get i: ogStr)) then isStruct = false
        if (originIsTid :symtab :tid originTid: (ctx.origins.get i: ogArray)) then isStruct = false
    }
    if isStruct then {
        if (ctx.fwdDeclaredTypes.has item: tid) == false then {
            cn: ctxCname :ctx :tid
            ctx.fwdDeclaredTypes.add item: tid.u64
            l0: "typedef struct \{cn}_t \{cn}_t;\n"
            buf.append l0
        }
    }
}

# isComplexFnptrParam -- a PROTOCOL/FACET/UNION/VARIANT type is not cleanly
# forward-declarable as a by-value fnptr param/return (vtable fat pointers,
# anonymous tagged-union structs); a function using one is never an fnptr value.
isComplexFnptrParam: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    nm: regNameView :symtab :tid
    ct: tid
    can: canonFnId :ast :symtab :ctx :tid name: nm
    if can > 0 then ct = ztypes.tid.create from: can.u64
    tt: symtab.reg.typetypeOf typeId: ct
    if tt == ztypes.ztypetype.protocolType then return true
    if tt == ztypes.ztypetype.facetType then return true
    if tt == ztypes.ztypetype.unionType then return true
    if tt == ztypes.ztypetype.variantType then return true
    return false
}

# emitOneFnptrTypedef -- emit one `typedef RET (*<cname>_ft)(PARAMS);`,
# dependency-first (fnptr-typed params emitted before this one) with referenced
# structs forward-declared. `seen` dedupes by tid.
emitOneFnptrTypedef: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
    seen: ListVal u64
    fnOwner: (IdMapV u64 v: u64)
    buf: String.borrow
} is {
    if (seen.contains item: tid) then return
    seen.append tid.u64
    pIds: ListVal u64
    pIdsNm: ListVal u64
    recFieldIds :symtab :tid ids: pIds nameIds: pIdsNm
    # A method's `this`/self-typed receiver child is a fresh shell named after
    # the owner; resolve it to the owner's canonical id so the typedef matches
    # the method's emitted signature (a by-name canonicalization can land on an
    # unrelated same-named type, e.g. a stdlib generic template).
    ownT: ztypes.tid
    fno: fnOwner.get key: tid
    match (
        fno
    ) case some then {
        ownT = ztypes.tid.create from: fno
    } case none then null
    ownNm: regNameOf :symtab tid: (ztypes.tid.create from: ownT.u64)
    rIds: ListVal u64
    ri: u64
    rn: pIds.length
    for ri < rn loop {
        rpv: pIds.get i: ri
        if ownT > 0 then {
            rpnB: (zast.poolTextAt
                pool: ast.names
                ref: (zast.nameid.create from: (pIdsNm.get i: ri))
            )
            rpn: rpnB.stringView
            rtn: regNameOf :symtab tid: (ztypes.tid.create from: rpv.u64)
            isRecv: false
            if rpn == "this" then isRecv = true
            if rtn.stringView == "this" then isRecv = true
            if rtn.stringView == ownNm.stringView then isRecv = true
            if rpv == ownT then isRecv = true
            if isRecv then rpv = ownT
        }
        rIds.append rpv.u64
        ri = ri + 1
    }
    skipIt: false
    sj: u64
    sn: pIds.length
    for sj < sn loop {
        spid: rIds.get i: sj
        if (isComplexFnptrParam
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: spid.u64)
        ) then skipIt = true
        sj = sj + 1
    }
    srt: fnRegReturnId :symtab :tid
    if srt.isZero then {
        srno: symtab.typing.funcReturnNode.get key: tid
        match (
            srno
        ) case some then {
            srt = stampIdOf :symtab nid: srno
        } case none then null
    }
    if srt > 0 then {
        if (isComplexFnptrParam
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: srt.u64)
        ) then skipIt = true
    }
    if skipIt then return
    di: u64
    dn: pIds.length
    for di < dn loop {
        pidd: rIds.get i: di
        if (
            (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: pidd.u64)) ==
            ztypes.ztypetype.functionType
        ) then {
            (emitOneFnptrTypedef
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: pidd.u64)
                :seen
                :fnOwner
                :buf
            )
        }
        ensureFwdStruct :symtab :ctx tid: (ztypes.tid.create from: pidd.u64) :buf
        di = di + 1
    }
    rtid: fnRegReturnId :symtab :tid
    if rtid > 0 then ensureFwdStruct :symtab :ctx tid: (ztypes.tid.create from: rtid.u64) :buf
    params: String
    pi: u64
    pn: pIdsNm.length
    for pi < pn loop {
        pnmB: (zast.poolTextAt
            pool: ast.names
            ref: (zast.nameid.create from: (pIdsNm.get i: pi))
        )
        pnm: pnmB.stringView
        pidp: rIds.get i: pi
        pct: (fnptrParamTypeC
            :ast
            :symtab
            :ctx
            fid: (ztypes.tid.create from: tid.u64)
            pname: pnm
            pid: (ztypes.tid.create from: pidp.u64)
        )
        if pi > 0 then params.append ", "
        params.append pct
        pi = pi + 1
    }
    if pn == 0 then params.append "void"
    retc: fnptrRetTypeC :ast :symtab :ctx :tid
    cb: ctxCname :ctx :tid
    line: "typedef \{retc} (*\{cb}_ft)(\{params});\n"
    buf.append line
}

# emitFnptrTypedefs -- one `_ft` typedef per eligible user FUNCTION value-type so
# typeRefC's FUNCTION case (`<cname>_ft`) resolves at struct fields, params,
# locals, and signatures. Emitted before the user structs that embed them.
emitFnptrTypedefs: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    buf: String.borrow
} is {
    last: symtab.reg.nextTypeId
    seen: ListVal u64
    # method FUNCTION tid -> owning object tid, for receiver-param resolution
    fnOwner: (IdMapV u64 v: u64)
    {
        fowP0: ListVal u64
        fowN0: ListVal u64
        fowT0: ListVal u64
        (symtab.typing.declAllMemberRows
            lastTid: symtab.reg.nextTypeId
            owners: fowP0
            names: fowN0
            tids: fowT0
        )
        fk0: u64
        fn0: fowP0.length
        for fk0 < fn0 loop {
            fp0: fowP0.get i: fk0
            fco: fowT0.get i: fk0
            fk0 = fk0 + 1
            if (
                (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: fco.u64)) ==
                ztypes.ztypetype.functionType
            ) then {
                fpt0: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: fp0.u64)
                isObj: false
                if fpt0 == ztypes.ztypetype.recordType then isObj = true
                if fpt0 == ztypes.ztypetype.classType then isObj = true
                if fpt0 == ztypes.ztypetype.unionType then isObj = true
                if fpt0 == ztypes.ztypetype.variantType then isObj = true
                if fpt0 == ztypes.ztypetype.protocolType then isObj = true
                if fpt0 == ztypes.ztypetype.facetType then isObj = true
                if isObj then fnOwner.set key: fco value: fp0
            }
        }
    }
    t0: ztypes.tid
    for t0 < last loop {
        if (symtab.reg.typetypeOf typeId: t0) == ztypes.ztypetype.functionType then {
            if (fnptrTypedefEligible :ast :symtab tid: t0) then {
                (emitOneFnptrTypedef
                    :ast
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: t0.u64)
                    :seen
                    :fnOwner
                    :buf
                )
            }
        }
        t0 = ztypes.tid.create from: (t0 + 1)
    }
}

# emitUserProtocols -- user PROTOCOLs upfront: a protocol value is a fat pointer,
# so nothing embeds one by value and it can precede every struct that names it.
emitUserProtocols: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    last: u64
    buf: String.borrow
} is {
    tp: ztypes.tid
    for tp < last loop {
        if (symtab.reg.typetypeOf typeId: tp) == ztypes.ztypetype.protocolType then {
            pgen: isGenericType :symtab tid: tp
            pmo: originTidOf :symtab tid: tp
            if pmo.isZero when pgen == false then {
                pduo: definedInUnitOf :symtab tid: tp
                match (
                    pduo
                ) case some then {
                    if (symtab.reg.isNativeOf tid: tp) == false then {
                        (emitUserTypeById
                            :ast
                            :symtab
                            :ctx
                            tid: (ztypes.tid.create from: tp.u64)
                            :buf
                        )
                    }
                } case none then null
            }
        }
        tp = ztypes.tid.create from: (tp + 1)
    }
}

# collectLateGroup -- the late collection/variant monos: the by-value kinds that
# embed a user type, and so must follow the user structs. One pass per family.
# The LIST ORDER is the emission order of the group, so it is the order the
# fifteen open-coded calls stood in.
collectLateGroup: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    userList: (ListVal u64).view
    acc: ListVal u64
    last: u64
} is {
    fams: ListVal u64
    fams.append (ctx.origins.get i: ogOptionval).u64
    fams.append (ctx.origins.get i: ogResultval).u64
    fams.append (ctx.origins.get i: ogListView).u64
    fams.append (ctx.origins.get i: ogListViewVal).u64
    fams.append (ctx.origins.get i: ogList).u64
    fams.append (ctx.origins.get i: ogListVal).u64
    fams.append (ctx.origins.get i: ogSet).u64
    fams.append (ctx.origins.get i: ogSetVal).u64
    fams.append (ctx.origins.get i: ogMap).u64
    fams.append (ctx.origins.get i: ogMapRV).u64
    fams.append (ctx.origins.get i: ogIdSet).u64
    fams.append (ctx.origins.get i: ogIdMapR).u64
    fams.append (ctx.origins.get i: ogIdMapV).u64
    fams.append (ctx.origins.get i: ogMapVR).u64
    fams.append (ctx.origins.get i: ogMapVV).u64
    fi: u64
    fn: fams.length
    for fi < fn loop {
        (collectLateMonosKind
            :ast
            :symtab
            :ctx
            originTid: (ztypes.tid.create from: (fams.get i: fi))
            :userList
            :acc
            :last
        )
        fi = fi + 1
    }
}

# closeLateGroup -- the membership id-set mirroring lateGroup (the list keeps
# emission order), then the closure: a user struct embedding a late-group
# member by value is late too, to a fixpoint.
closeLateGroup: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    userList: (ListVal u64).view
    lateGroup: ListVal u64
    lateSet: IdSet u64
} is {
    li0: u64
    ln0: lateGroup.length
    for li0 < ln0 loop {
        lv0: lateGroup.get i: li0
        lateSet.add item: lv0
        li0 = li0 + 1
    }
    # closure: a user struct embedding a late-group member by value is late too
    emptySet: IdSet u64
    changed: true
    for changed loop {
        changed = false
        ui: u64
        un: userList.length
        for ui < un loop {
            uid: userList.get i: ui
            if (lateSet.has item: uid) == false then {
                if (userDefnRefsUnemitted
                    :symtab
                    :ctx
                    typeId: (ztypes.tid.create from: uid.u64)
                    group: lateSet
                    emitted: emptySet
                ) then {
                    lateGroup.append uid.u64
                    lateSet.add item: uid
                    changed = true
                }
            }
            ui = ui + 1
        }
    }
}

# emitEarlyUserStructs -- users not in the late group, in type-id order
# (preEmitEmbeddedTypes inside each emitter fixes intra-pass user->user order).
emitEarlyUserStructs: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    userList: (ListVal u64).view
    lateSet: (IdSet u64).view
    buf: String.borrow
} is {
    e0: u64
    n0: userList.length
    for e0 < n0 loop {
        uid0: userList.get i: e0
        if (lateSet.has item: uid0) == false then (emitUserTypeById
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: uid0)
            :buf
        )
        e0 = e0 + 1
    }
}

# emitLateGroupOrdered -- the late monos and late-user structs in dependency
# order, by fixpoint; whatever the fixpoint cannot place is emitted in list
# order rather than dropped.
emitLateGroupOrdered: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    lateGroup: (ListVal u64).view
    lateSet: IdSet u64
    buf: String.borrow
} is {
    emittedSet: IdSet u64
    totalPend: lateGroup.length
    emittedCount: u64
    done: false
    stuck: false
    for done == false loop {
        progressed: false
        pi: u64
        pn: lateGroup.length
        for pi < pn loop {
            x: lateGroup.get i: pi
            if (emittedSet.has item: x) == false then {
                xorigin: originTidOf :symtab tid: (ztypes.tid.create from: x.u64)
                if xorigin > 0 then {
                    seen: ListVal u64
                    if (monoLateDepsMet
                        :ast
                        :symtab
                        :ctx
                        monoId: (ztypes.tid.create from: x.u64)
                        group: lateSet
                        emitted: emittedSet
                        :seen
                    ) then {
                        (emitMonoById
                            :ast
                            :symtab
                            :ctx
                            :runtimeDir
                            monoId: (ztypes.tid.create from: x.u64)
                            :buf
                        )
                        emittedSet.add item: x
                        emittedCount = emittedCount + 1
                        progressed = true
                    }
                } else {
                    if (
                        (userDefnRefsUnemitted
                            :symtab
                            :ctx
                            typeId: (ztypes.tid.create from: x.u64)
                            group: lateSet
                            emitted: emittedSet
                        ) ==
                        false
                    ) then {
                        emitUserTypeById :ast :symtab :ctx tid: (ztypes.tid.create from: x.u64) :buf
                        emittedSet.add item: x
                        emittedCount = emittedCount + 1
                        progressed = true
                    }
                }
            }
            pi = pi + 1
        }
        if emittedCount >= totalPend then {
            done = true
        } else {
            if progressed == false then {
                done = true
                stuck = true
            }
        }
    }
    if stuck then {
        f0: u64
        f1: lateGroup.length
        for f0 < f1 loop {
            x2: lateGroup.get i: f0
            if (emittedSet.has item: x2) == false then {
                xo2: originTidOf :symtab tid: (ztypes.tid.create from: x2.u64)
                if xo2 > 0 then {
                    (emitMonoById
                        :ast
                        :symtab
                        :ctx
                        :runtimeDir
                        monoId: (ztypes.tid.create from: x2.u64)
                        :buf
                    )
                } else {
                    emitUserTypeById :ast :symtab :ctx tid: (ztypes.tid.create from: x2.u64) :buf
                }
                emittedSet.add item: x2
            }
            f0 = f0 + 1
        }
    }
}


# emitUserStructsOrdered -- emit user struct defs and the collection monos that
# embed them by value in dependency order, resolving the bidirectional
# constraint: a user record embeds an early (system-element) mono, while a late
# mono embeds a user type. Order: protocols -> early-user structs -> a fixpoint
# interleaving late monos and late-user structs. The early collection monos and
# the system scaffolding are already emitted by emitMonos; this owns user struct
# layout.
emitUserStructsOrdered: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    buf: String.borrow
} is {
    last: symtab.reg.nextTypeId
    userList: ListVal u64
    buildUserTypeList :symtab :ctx acc: userList
    emitUserProtocols :ast :symtab :ctx :last :buf
    lateGroup: ListVal u64
    collectLateGroup :ast :symtab :ctx :userList acc: lateGroup :last
    lateSet: IdSet u64
    closeLateGroup :symtab :ctx :userList :lateGroup :lateSet
    emitEarlyUserStructs :ast :symtab :ctx :userList :lateSet :buf
    emitLateGroupOrdered :ast :symtab :ctx :runtimeDir :lateGroup :lateSet :buf
}

# MonoWork -- the mono worklists that one classification sweep fills and the
# emitters drain. The categories stay NAMED rather than becoming rows of an
# indexed table: the emission order is made of them, and a nested generic
# container is not available anyway.
MonoWork: class {
    # the strings still owed emission
    wStr: ListVal u64
    # the boxes still owed emission
    wBox: ListVal u64
    # the system variants still owed emission
    wSysVar: ListVal u64
    # the valtype monos still owed emission
    wValMono: ListVal u64
    # the Option and Result instances still owed emission
    wOptRes: ListVal u64
    # the user generic unions still owed emission
    wUgUnion: ListVal u64
    # the OptionView instances still owed emission
    wOptView: ListVal u64
    # the arrays still owed emission
    wArr: ListVal u64
    # the list views still owed emission
    wListView: ListVal u64
    # the lists still owed emission
    wList: ListVal u64
    # the sets still owed emission
    wSet: ListVal u64
    # the maps still owed emission
    wMap: ListVal u64
    # the IdSets still owed emission
    wIdSet: ListVal u64
    # the IdMaps still owed emission
    wIdMap: ListVal u64
    # the protocols still owed emission
    wProto: ListVal u64
    # the user generic variants still owed emission
    wUgVar: ListVal u64
    # the user generic records still owed emission
    wUgRec: ListVal u64
}

# classifyCollectionMono -- the option / result / view families and the seven
# collection families, each keyed on the ORIGIN tid its mono was minted from. An
# id compare is what makes this shadow-proof: a user type spelled `ListRef` is not
# this ListRef.
classifyCollectionMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    userListM: (ListVal u64).view
    tcl: ztypes.tid
    tv: u64
    tt: ztypes.ztypetype
    isMono: bool
    isValMono: bool
    work: MonoWork
} out bool is {
    isColKind: false
    isOptRes: false
    if (originIsTid :symtab tid: tcl originTid: (ctx.origins.get i: ogOption)) then isOptRes = true
    if (originIsTid :symtab tid: tcl originTid: (ctx.origins.get i: ogResult)) then isOptRes = true
    if isOptRes then work.wOptRes.append tv
    if isMono when tt == ztypes.ztypetype.unionType then {
        ugu: true
        if isOptRes then ugu = false
        if ugu when isValMono then ugu = false
        if ugu when (originIsTid
            :symtab
            tid: tcl
            originTid: (ctx.origins.get i: ogOptionView)
        ) then ugu = false
        if ugu when (isCollectionOriginTid
            :ctx
            originTid: (originTidOf :symtab tid: tcl)
        ) then ugu = false
        if ugu then work.wUgUnion.append tv
    }
    if (originIsTid
        :symtab
        tid: tcl
        originTid: (ctx.origins.get i: ogOptionView)
    ) then work.wOptView.append tv
    colDst: u64
    if (originIsTid :symtab tid: tcl originTid: (ctx.origins.get i: ogArray)) then {
        isColKind = true
        colDst = 1
    }
    if (isListViewOriginOf :symtab :ctx tid: tcl) then {
        isColKind = true
        colDst = 2
    }
    if (isListOriginOf :symtab :ctx tid: tcl) then {
        isColKind = true
        colDst = 3
    }
    if (isSetOriginOf :symtab :ctx tid: tcl) then {
        isColKind = true
        colDst = 4
    }
    if (isMapOriginOf :symtab :ctx tid: tcl) then {
        isColKind = true
        colDst = 5
    }
    if (isIdSetOriginOf :symtab :ctx tid: tcl) then {
        isColKind = true
        colDst = 6
    }
    if (isIdMapOriginOf :symtab :ctx tid: tcl) then {
        isColKind = true
        colDst = 7
    }
    if isColKind then {
        if (
            (monoIsLate
                :ast
                :symtab
                :ctx
                monoId: (ztypes.tid.create from: tcl.u64)
                userList: userListM
            ) ==
            false
        ) then {
            if colDst == 1 then work.wArr.append tv
            if colDst == 2 then work.wListView.append tv
            if colDst == 3 then work.wList.append tv
            if colDst == 4 then work.wSet.append tv
            if colDst == 5 then work.wMap.append tv
            if colDst == 6 then work.wIdSet.append tv
            if colDst == 7 then work.wIdMap.append tv
        }
    }
    return isColKind
}

# classifyMonos -- ONE sweep over the registry fills the per-category worklists the
# emission loops then walk in the original sequence. Every predicate here reads
# only registry and typing state, which is immutable during emission; the
# io-wrapper demand gate is the one that must stay at emission time.
classifyMonos: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    userListM: (ListVal u64).view
    work: MonoWork
} is {
    last: symtab.reg.nextTypeId
    tcl: ztypes.tid
    for tcl < last loop {
        tv: tcl
        tt: symtab.reg.typetypeOf typeId: tcl
        oOrig: originTidOf :symtab tid: tcl
        gen: isGenericType :symtab tid: tcl
        isMono: oOrig > 0
        if (originIsTid
            :symtab
            tid: tcl
            originTid: (ctx.origins.get i: ogStr)
        ) then work.wStr.append tv
        if (isBoxTid :symtab tid: tcl) then work.wBox.append tv
        if tt == ztypes.ztypetype.variantType then {
            if isMono == false when gen == false then {
                if (definedInNonMain :symtab :ctx tid: tcl) then work.wSysVar.append tv
            }
        }
        isValMono: false
        if (originIsTid
            :symtab
            tid: tcl
            originTid: (ctx.origins.get i: ogOptionval)
        ) then isValMono = true
        if (originIsTid
            :symtab
            tid: tcl
            originTid: (ctx.origins.get i: ogResultval)
        ) then isValMono = true
        if isValMono then {
            mil: (monoIsLate
                :ast
                :symtab
                :ctx
                monoId: (ztypes.tid.create from: tcl.u64)
                userList: userListM
            )
            if mil == false then work.wValMono.append tv
        }
        (classifyCollectionMono
            :ast
            :symtab
            :ctx
            :userListM
            :tcl
            :tv
            :tt
            :isMono
            :isValMono
            :work
        )
        if tt == ztypes.ztypetype.protocolType then {
            if gen == false then {
                if (definedInNonMain :symtab :ctx tid: tcl) then work.wProto.append tv
            }
        }
        if isMono then {
            ugr: false
            if tt == ztypes.ztypetype.recordType then ugr = true
            if tt == ztypes.ztypetype.classType then ugr = true
            if ugr when (isCollectionOriginTid
                :ctx
                originTid: (originTidOf :symtab tid: tcl)
            ) then ugr = false
            if ugr when (originIsTid
                :symtab
                tid: tcl
                originTid: (ctx.origins.get i: ogArray)
            ) then ugr = false
            if ugr when (originIsTid
                :symtab
                tid: tcl
                originTid: (ctx.origins.get i: ogStr)
            ) then ugr = false
            if ugr when (isBoxTid :symtab tid: tcl) then ugr = false
            if ugr then work.wUgRec.append tv
            # a user generic VARIANT mono. optionval/resultval monos are
            # variantType and isMono too and drain from wValMono in their own
            # dependency position, so isValMono is what separates the families.
            ugv: false
            if tt == ztypes.ztypetype.variantType then ugv = true
            if ugv when isValMono then ugv = false
            if ugv when (isCollectionOriginTid
                :ctx
                originTid: (originTidOf :symtab tid: tcl)
            ) then ugv = false
            if ugv then work.wUgVar.append tv
        }
        tcl = ztypes.tid.create from: (tcl + 1)
    }
}

# emitCollectionMonos -- the collection families and what follows them, in the one
# order that works: array and ListView structs before the Lists whose listView
# companion embeds them; Set and Map after the OptionView their `get` returns;
# the id-keyed pair after the hashed ones for the same reason; protocols after
# the monos their vtable signatures reference; user generic monos last.
emitCollectionMonos: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    buf: String.borrow
    work: MonoWork.view
} is {
    # ListView structs next -- a List's listView companion references
    # the ListView struct by value.
    tarr: u64
    for tarr < work.wArr.length loop {
        arrId: work.wArr.get i: tarr
        (emitArrayMono
            :ast
            :symtab
            :ctx
            :runtimeDir
            monoId: (ztypes.tid.create from: arrId.u64)
            :buf
        )
        tarr = tarr + 1
    }
    tid: ztypes.tid
    for tid < work.wListView.length loop {
        lvId: work.wListView.get i: tid
        (emitListViewMono
            :ast
            :symtab
            :ctx
            :runtimeDir
            monoId: (ztypes.tid.create from: lvId.u64)
            :buf
        )
        tid = ztypes.tid.create from: (tid + 1)
    }
    tid2: u64
    for tid2 < work.wList.length loop {
        liId: work.wList.get i: tid2
        emitListMono :ast :symtab :ctx :runtimeDir monoId: (ztypes.tid.create from: liId.u64) :buf
        tid2 = tid2 + 1
    }
    # Set monos last -- the compact-dict + SetIter; needs its element's
    # OptionView (above) already defined.
    tset: u64
    for tset < work.wSet.length loop {
        seId: work.wSet.get i: tset
        emitSetMono :ast :symtab :ctx :runtimeDir monoId: (ztypes.tid.create from: seId.u64) :buf
        tset = tset + 1
    }
    # Map monos -- the compact-dict over key+value; get's return optionval
    # (emitted above) supplies the value type.
    tmap: u64
    for tmap < work.wMap.length loop {
        maId: work.wMap.get i: tmap
        emitMapMono :ast :symtab :ctx :runtimeDir monoId: (ztypes.tid.create from: maId.u64) :buf
        tmap = tmap + 1
    }
    # the id-keyed pair, after the hashed ones for the same reason: an IdMap's
    # `get` returns an optionval / OptionView emitted above.
    tidset: u64
    for tidset < work.wIdSet.length loop {
        isId: work.wIdSet.get i: tidset
        (emitIdSetMono
            :ast
            :symtab
            :ctx
            :runtimeDir
            monoId: (ztypes.tid.create from: isId.u64)
            :buf
        )
        tidset = tidset + 1
    }
    tidmap: u64
    for tidmap < work.wIdMap.length loop {
        imId: work.wIdMap.get i: tidmap
        (emitIdMapMono
            :ast
            :symtab
            :ctx
            :runtimeDir
            monoId: (ztypes.tid.create from: imId.u64)
            :buf
        )
        tidmap = tidmap + 1
    }
    # reachable system PROTOCOLs (Reader/Writer/Closer/Seeker) -- emitted after
    # the collection monos their vtable function-pointer signatures reference.
    tsp: u64
    for tsp < work.wProto.length loop {
        spId: work.wProto.get i: tsp
        (emitOneProtocol
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: spId.u64)
            :buf
        )
        tsp = tsp + 1
    }
    # user generic VARIANT monos (e.g. Slot<i64>): tag enum + tagged struct via
    # emitOneVariant, the same emitter the system variant monos use. Valtypes a
    # user record can embed by value, so ahead of wUgRec.
    tugv: u64
    for tugv < work.wUgVar.length loop {
        ugvId: work.wUgVar.get i: tugv
        emitOneVariant :ast :symtab :ctx tid: (ztypes.tid.create from: ugvId.u64) :buf
        tugv = tugv + 1
    }
    # user generic class/record monos (e.g. Box<i64>): RECORD/CLASS monos whose
    # origin is a user generic type. The collection / array / str / option / box
    # monos are handled by their own worklists; emit the rest via emitOneRecord.
    tug: u64
    for tug < work.wUgRec.length loop {
        ugId: work.wUgRec.get i: tug
        emitOneRecord :ast :symtab :ctx tid: (ztypes.tid.create from: ugId.u64) :buf
        tug = tug + 1
    }
}

# emitOptionMonos -- the option and result families, before the collections whose
# `get` returns one: the by-value variant monos, the heap-payload union monos,
# a user generic union, and the borrowed-view option every iterator yields.
emitOptionMonos: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    buf: String.borrow
    work: MonoWork.view
} is {
    # optionval + resultval variant monos -- iterators/collection-gets /
    # parsers return them by value (payloads now resolvable).
    tido: u64
    for tido < work.wValMono.length loop {
        vmId: work.wValMono.get i: tido
        emitOneVariant :ast :symtab :ctx tid: (ztypes.tid.create from: vmId.u64) :buf
        tido = tido + 1
    }
    # Option union monos (tag + void* data heap payload) -- reftype
    # option returns (string strip/split, map get over reftype).
    tiu: u64
    for tiu < work.wOptRes.length loop {
        orId: work.wOptRes.get i: tiu
        emitUnionMono :ast :symtab :ctx tid: (ztypes.tid.create from: orId.u64) :buf
        tiu = tiu + 1
    }
    # user generic UNION monos (e.g. MyOption<i64>): struct + tags via
    # emitUnionMono. The work.wUgRec list handles only RECORD/CLASS; system
    # option/result monos are handled above.
    tugu: u64
    for tugu < work.wUgUnion.length loop {
        uguId: work.wUgUnion.get i: tugu
        emitUnionMono :ast :symtab :ctx tid: (ztypes.tid.create from: uguId.u64) :buf
        tugu = tugu + 1
    }
    # OptionView structs -- the borrowed-view option every collection
    # iterator yields; emitted before the collections that reference it.
    tiov: u64
    for tiov < work.wOptView.length loop {
        ovId: work.wOptView.get i: tiov
        emitOptionViewMono :ctx :symtab monoId: (ztypes.tid.create from: ovId.u64) :buf
        tiov = tiov + 1
    }
}


# emitMonos -- emit every collection-mono instance in the registry (List
# today; Map/Set/iterators land with their slices).
emitMonos: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    runtimeDir: StringView
    buf: String.borrow
} is {
    userListM: ListVal u64
    buildUserTypeList :symtab :ctx acc: userListM
    emitMainFwdDecls :symtab :ctx :buf
    # one classification sweep over the registry fills the per-category
    # worklists; the category loops below emit in the original sequence.
    # Every predicate reads only registry/typing state (immutable during
    # emission); the io-wrapper demand gate stays at emission time.
    work: (MonoWork
        wStr: (ListVal u64)
        wBox: (ListVal u64)
        wSysVar: (ListVal u64)
        wValMono: (ListVal u64)
        wOptRes: (ListVal u64)
        wUgUnion: (ListVal u64)
        wOptView: (ListVal u64)
        wArr: (ListVal u64)
        wListView: (ListVal u64)
        wList: (ListVal u64)
        wSet: (ListVal u64)
        wMap: (ListVal u64)
        wIdSet: (ListVal u64)
        wIdMap: (ListVal u64)
        wProto: (ListVal u64)
        wUgVar: (ListVal u64)
        wUgRec: (ListVal u64)
    )
    (classifyMonos
        :ast
        :symtab
        :ctx
        :userListM
        :work
    )
    # str valtype monos are leaf PODs that user records embed by value, so emit
    # them first (before any user struct / collection mono that references them).
    tstr: u64
    for tstr < work.wStr.length loop {
        strId: work.wStr.get i: tstr
        emitStrMono :symtab :ctx :runtimeDir monoId: (ztypes.tid.create from: strId.u64) :buf
        tstr = tstr + 1
    }
    # builtin Box monos (heap pointers): destructor-only, leaf -- emit early.
    tbox: u64
    for tbox < work.wBox.length loop {
        boxId: work.wBox.get i: tbox
        emitBoxMono :ast :symtab :ctx monoId: (ztypes.tid.create from: boxId.u64) :buf
        tbox = tbox + 1
    }
    emitIoFileClass :ctx :buf
    emitNetClasses :ctx :buf
    # reachable non-mono system VARIANTs (parseerror, seekorigin, ...) --
    # payloads of the variant monos / used directly.
    tsv: u64
    for tsv < work.wSysVar.length loop {
        svId: work.wSysVar.get i: tsv
        emitOneVariant :ast :symtab :ctx tid: (ztypes.tid.create from: svId.u64) :buf
        tsv = tsv + 1
    }
    (emitOptionMonos
        :ast
        :symtab
        :ctx
        :work
        :buf
    )
    (emitCollectionMonos
        :ast
        :symtab
        :ctx
        :runtimeDir
        :work
        :buf
    )
}

# emitRecordDefs -- main-unit record structs + meta_create constructors
# (scalar/record fields).
emitRecordDefs: function {
    program: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    buf: String.borrow
} is {
    {
        # 3 phases across ALL file units so cross-unit refs resolve: every unit's
        # structs, then every unit's fwd-decls, then every unit's method bodies.
        ph: 1.u64
        for ph <= 3 loop {
            uCnt9h: program.units.length
            uIdx9h: u64
            for uIdx9h < uCnt9h loop {
                uId: (zast.nodeid.create from: (program.units.get i: uIdx9h))
                uIdx9h = uIdx9h + 1
                opId: zast.nodeid
                unitNameText: String
                un9Id: zast.nameid
                {
                    u: program.nodes.get i: uId.u64
                    if u.namedoperation then {
                        un: zast.poolTextAt pool: program.names ref: u.name
                        opId = u.operation
                        unitNameText = un.copy
                        un9Id = u.name
                    }
                }
                if opId > 0 then {
                    sm: ctx.mainName.copy
                    smD: ctx.mainUnitId
                    (ctxBindMain
                        :ctx
                        name: unitNameText.stringView
                        unitDecl: (ztypecheck.unitDeclOfName st: symtab nameId: un9Id)
                    )
                    (emitRecordDefsIn
                        :symtab
                        :ctx
                        ast: program
                        mainOpId: opId
                        phase: ph
                        :buf
                    )
                    ctxBindMain :ctx name: sm.stringView unitDecl: smD
                }
            }
            ph = ph + 1
        }
    }
}

# emitDefMethods -- emit a record/class def's as-block methods (forward decls
# when declOnly, bodies otherwise). Used by the method passes of emitRecordDefsIn.
emitDefMethods: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    bm: astnode.view
    declOnly: bool
    buf: String.borrow
} is {
    if bm.namedoperation then {
        # A VARIANT'S as-block METHODS ARE METHODS. Only a record leg and a
        # class leg existed, so NO user method on a variant was ever emitted --
        # named or operator -- while the call site emitted a call to it. Every
        # such program was accepted at exit 0 and rejected by the C compiler
        # for an implicit declaration.
        #
        # All three families take their receiver and emit alike, which is why
        # they share emitRecordMethods -- and why the name resolves ONCE here
        # rather than once per family.
        opn9: ast.nodes.get i: bm.operation.u64
        hasMethods: false
        if (isRecordDef n: opn9) then hasMethods = true
        if (isClassDef n: opn9) then hasMethods = true
        if (isVariantDef n: opn9) then hasMethods = true
        if (isUnionDef n: opn9) then hasMethods = true
        if hasMethods then {
            nm: zast.nameTextAt :ast ref: bm.name
            rid: userFnId :ast :symtab :ctx name: nm.stringView
            if rid > 0 then (emitRecordMethods
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: rid.u64)
                op: opn9
                :declOnly
                :buf
            )
        }
    }
}


# protoChildMethods -- a protocol's spec-method children (FUNCTION children,
# excluding the synth create/borrow), names + ids in registration order.
protoChildMethods: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
    names: List String
    ids: ListVal u64
    nameIds: ListVal u64
} is {
    otpi4: tid
    pi4: u64
    pn4: symtab.typing.declRowSlots ownerTid: otpi4
    for pi4 < pn4 loop {
        rwpi4: symtab.typing.declRowAt ownerTid: otpi4 membersOnly: true slot: pi4
        pi4 = pi4 + 1
        if rwpi4.keep then {
            pnid4: rwpi4.name
            ptid4: rwpi4.tid
            if (
                (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: ptid4.u64)) ==
                ztypes.ztypetype.functionType
            ) then {
                isSynth: false
                if pnid4 == zast.names.wkCreate.u64 then isSynth = true
                if pnid4 == zast.names.wkBorrow.u64 then isSynth = true
                if isSynth == false then {
                    cnBe4: ast.names.texts.get i: pnid4.u64
                    cn0: cnBe4.copy
                    names.append cn0
                    ids.append ptid4
                    nid0: pnid4
                    nameIds.append nid0
                }
            }
        }
    }
}

# methodRetCtype -- a method's C return type via the registry returnTypeId
# (scalars/records/classes resolve through typeRefC); "void" when unset.
methodRetCtype: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    mid: ztypes.tid
    thisTid: ztypes.tid
} out String is {
    mro: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: mid.u64)
    match (
        mro
    ) case some then {
        rr: typeRefC :ast :symtab :ctx tid: mro :thisTid
        if rr.length > 0 then return rr
    } case none then null
    return "void".string
}

# protoParamCtype -- a protocol spec-method param's C type: typeRefC, with a
# `*` for collection params (List/ListView/Map and the Bytes/ByteView typedefs),
# which the vtable function pointers and wrappers pass by pointer.
protoParamCtype: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    pid: ztypes.tid
    thisTid: ztypes.tid
} out String is {
    # The spec param is usually a SHELL named after the system type; canonicalize
    # it by name (resolveTypeIdByName covers system types) so typeRefC resolves it
    # (and chases ByteView/Bytes to their collection mono). But a param already
    # resolved to a CANONICAL id (a linked declaration, e.g. system i64) is trusted
    # as-is -- re-resolving "i64" by name would wrongly pick up a user shadow of
    # the scalar in the main unit. Mirrors typeRefC's none-branch shell gate.
    cpid: pid
    pidDu: definedInUnitOf :symtab tid: (ztypes.tid.create from: pid.u64)
    pidShell: false
    match (
        pidDu
    ) case some then null case none then {
        pidShell = true
    }
    if pidShell then {
        pn: regNameOf :symtab tid: (ztypes.tid.create from: pid.u64)
        rcid: (canonTypeId
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: pid.u64)
            name: pn.stringView
        )
        if rcid > 0 then cpid = ztypes.tid.create from: rcid.u64
    }
    pct: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: cpid.u64) :thisTid
    if pct.length == 0 then pct = "int64_t".string
    isCol: false
    ccm: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: cpid.u64)
    if (ccm.u64 == cpid) == false then isCol = true
    if (isCollectionOriginTid
        :ctx
        originTid: (originTidOf :symtab tid: (ztypes.tid.create from: cpid.u64))
    ) then isCol = true
    if isCol then return "\{pct}*"
    return pct
}

# facetImplTids -- the deduplicated impl type ids conforming to facet `tid`,
# in conformance-row (declaration) order.
facetImplTids: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid acc: ListVal u64} is {
    with citer: symtab.typing.conformance.iterate do for row: citer loop {
        if row.specTypeId == tid then {
            if (acc.contains item: row.implTypeId) == false then acc.append row.implTypeId
        }
    }
}

# specMemberIsSelfTyped -- a spec member with a parameter of the INTERFACE's
# OWN type, the receiver excluded. `type` inside an interface means the
# interface, so `near: function {:this rhs: type}` asks for a
# conformer-to-conformer call, and a vtable cannot type one: the slot would
# have to name a single implementation's argument and there may be many. Such a
# member is NOT part of the dispatchable surface -- no slot, no wrapper -- and
# calling it through the interface is refused where the call is written.
#
# It is the same test as "this parameter IS the receiver", read the other way
# round; read that way, a self-typed argument is silently swallowed.
specMemberIsSelfTyped: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ifaceTid: ztypes.tid
    smid: ztypes.tid
} out bool is {
    pnames: List String
    pids: ListVal u64
    pidsNm: ListVal u64
    (recFieldLists :ast :symtab tid: smid names: pnames ids: pids nameIds: pidsNm)
    rpn: symtab.reg.thisParamNameIdOf tid: smid
    found: false
    pi: u64
    for pi < pnames.length loop {
        isRecv: false
        if (pidsNm.get i: pi) == zast.names.wkThis.u64 then isRecv = true
        if rpn != 0 when (pidsNm.get i: pi) == rpn.u64 then isRecv = true
        if isRecv == false when (pids.get i: pi) == ifaceTid.u64 then found = true
        pi = pi + 1
    }
    return found
}

# emitOneFacet -- the facet value representation: a vtable typedef (one fn
# pointer per spec, void* receiver), an inline data union over the conforming
# impls (copied by value -- facets are valtype existentials), and the
# {vtable*, data} struct. No destroy helper: impls are valtypes. The impl
# structs are pre-emitted first because the union embeds them by value.
emitOneFacet: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    if (ctx.emittedUserTypes.has item: tid) then return
    ctx.emittedUserTypes.add item: tid.u64
    pbase: ctxCname :ctx :tid
    impls: ListVal u64
    facetImplTids :symtab :tid acc: impls
    preEmitEmbeddedTypes :ast :symtab :ctx ids: impls :buf
    mnames: List String
    mids: ListVal u64
    midsNm: ListVal u64
    protoChildMethods :ast :symtab :tid names: mnames ids: mids nameIds: midsNm
    vfuncs: String
    mi: u64
    mn: mnames.length
    for mi < mn loop {
        mname: mnames.get i: mi
        smid: mids.get i: mi
        # a member whose signature mentions the interface's own type is not
        # dispatchable: no slot, and no wrapper below either
        if (specMemberIsSelfTyped
            :ast
            :symtab
            ifaceTid: tid
            smid: (ztypes.tid.create from: smid.u64)
        ) then {
            mi = mi + 1
            continue
        }
        mroP: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: smid.u64)
        match (
            mroP
        ) case some then {
            maybePreEmitElem :ast :symtab :ctx eid: mroP :buf
        } case none then null
        ret: methodRetCtype :ast :symtab :ctx mid: (ztypes.tid.create from: smid.u64) thisTid: tid
        vparams: "void*".string
        pnames: List String
        pids: ListVal u64
        pidsNm: ListVal u64
        (recFieldLists
            :ast
            :symtab
            tid: (ztypes.tid.create from: smid.u64)
            names: pnames
            ids: pids
            nameIds: pidsNm
        )
        preEmitEmbeddedTypes :ast :symtab :ctx ids: pids :buf
        pi: u64
        pn: pnames.length
        for pi < pn loop {
            pnm: pnames.get i: pi
            pid: pids.get i: pi
            # spec receivers are dropped by resolveSpecFn; a MARKED one is
            # found by the registry below. A parameter of the interface's OWN
            # type is not the receiver -- reading it as one is what dropped it
            # from the slot while the wrapper still passed it.
            isThis: false
            if pnm.stringView == "this" then isThis = true
            # a marked receiver is an alias, so ask the registry which
            # parameter IS the receiver rather than matching on `this`
            {
                rpnV: symtab.reg.thisParamNameIdOf tid: (ztypes.tid.create from: smid.u64)
                if rpnV != 0 when (pidsNm.get i: pi) == rpnV.u64 then isThis = true
            }
            if isThis == false then {
                pct: (protoParamCtype
                    :ast
                    :symtab
                    :ctx
                    pid: (ztypes.tid.create from: pid.u64)
                    thisTid: (ztypes.tid.create from: tid.u64)
                )
                vparams.append ", "
                vparams.append pct
            }
            pi = pi + 1
        }
        vslot: cSlotName name: mname.stringView
        vline: "    \{ret} (*\{vslot})(\{vparams});\n"
        vfuncs.append vline
        mi = mi + 1
    }
    l0: "typedef struct {\n\{vfuncs}} \{pbase}_vtable_t;\n\n"
    buf.append l0
    du: String
    with iiter: impls.iterate do for itid: iiter loop {
        icn: ctxCname :ctx tid: (ztypes.tid.create from: itid.u64)
        drow: "    \{icn}_t _i\{itid};\n"
        du.append drow
    }
    if du.length == 0 then du.append "    char _none;\n"
    l1: "typedef union {\n\{du}} \{pbase}_data_u;\n\n"
    buf.append l1
    l2: "typedef struct {\n    \{pbase}_vtable_t* vtable;\n    \{pbase}_data_u data;\n} \{pbase}_t;\n\n"
    buf.append l2
}

# emitOneProtocol -- the protocol value representation: vtable typedef (one
# function pointer per spec method, `this` dropped for a leading void*),
# the fat-pointer struct {data, vtable, destroy}, and the destroy helper.
emitOneProtocol: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    if (ctx.emittedUserTypes.has item: tid) then return
    ctx.emittedUserTypes.add item: tid.u64
    pbase: ctxCname :ctx :tid
    mnames: List String
    mids: ListVal u64
    midsNm: ListVal u64
    protoChildMethods :ast :symtab :tid names: mnames ids: mids nameIds: midsNm
    vfuncs: String
    mi: u64
    mn: mnames.length
    for mi < mn loop {
        mname: mnames.get i: mi
        smid: mids.get i: mi
        # a member whose signature mentions the interface's own type is not
        # dispatchable: no slot, and no wrapper below either
        if (specMemberIsSelfTyped
            :ast
            :symtab
            ifaceTid: tid
            smid: (ztypes.tid.create from: smid.u64)
        ) then {
            mi = mi + 1
            continue
        }
        mroP: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: smid.u64)
        match (
            mroP
        ) case some then {
            maybePreEmitElem :ast :symtab :ctx eid: mroP :buf
        } case none then null
        ret: methodRetCtype :ast :symtab :ctx mid: (ztypes.tid.create from: smid.u64) thisTid: tid
        vparams: "void*".string
        pnames: List String
        pids: ListVal u64
        pidsNm: ListVal u64
        (recFieldLists
            :ast
            :symtab
            tid: (ztypes.tid.create from: smid.u64)
            names: pnames
            ids: pids
            nameIds: pidsNm
        )
        preEmitEmbeddedTypes :ast :symtab :ctx ids: pids :buf
        pi: u64
        pn: pnames.length
        for pi < pn loop {
            pnm: pnames.get i: pi
            pid: pids.get i: pi
            ptn: regNameOf :symtab tid: (ztypes.tid.create from: pid.u64)
            isThis: false
            if pnm.stringView == "this" then isThis = true
            if ptn.stringView == "this" then isThis = true
            # a marked receiver is an alias, so ask the registry which
            # parameter IS the receiver rather than matching on `this`
            {
                rpnV: symtab.reg.thisParamNameIdOf tid: (ztypes.tid.create from: smid.u64)
                if rpnV != 0 when (pidsNm.get i: pi) == rpnV.u64 then isThis = true
            }
            if isThis == false then {
                pct: (protoParamCtype
                    :ast
                    :symtab
                    :ctx
                    pid: (ztypes.tid.create from: pid.u64)
                    thisTid: (ztypes.tid.create from: tid.u64)
                )
                vparams.append ", "
                vparams.append pct
            }
            pi = pi + 1
        }
        vslot: cSlotName name: mname.stringView
        vline: "    \{ret} (*\{vslot})(\{vparams});\n"
        vfuncs.append vline
        mi = mi + 1
    }
    l0: "typedef struct {\n\{vfuncs}} \{pbase}_vtable_t;\n\n"
    buf.append l0
    l1: "typedef struct {\n    void* data;\n    \{pbase}_vtable_t* vtable;\n    void (*destroy)(void*);\n} \{pbase}_t;\n\n"
    buf.append l1
    l2: "static void \{pbase}_destroy(\{pbase}_t* proto) {\n    if (!proto) return;\n    if (proto->destroy) proto->destroy(proto->data);\n    proto->destroy = NULL;\n}\n\n"
    buf.append l2
}

# implMethodCname -- the C name a conformance wrapper calls for the impl's
# `mname`. A NATIVE member's symbol is the canon-named one a fragment defines,
# whichever unit is being emitted; the per-unit emission pass rebinds mainName,
# so the nonmain test below cannot answer that half on its own.
implMethodCname: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    implTid: ztypes.tid
    mnameId: zast.nameid
    mname: StringView
    implBase: StringView
} out String is {
    implMid: ztypes.tid
    imo: symtab.typing.declChildOfId parentTypeId: implTid nameId: mnameId
    match (
        imo
    ) case some then {
        implMid = ztypes.tid.create from: imo
    } case none then null
    if (fnIsNativeId :symtab fid: implMid) then return "\{implBase}_\{mname}"
    if (definedInNonMain
        :symtab
        :ctx
        tid: (ztypes.tid.create from: implTid.u64)
    ) then return "\{implBase}_\{mname}"
    return (ctxCname :ctx tid: (ztypes.tid.create from: implMid.u64))
}

# emitProtocolImpl -- the per-(impl,label) conformance helpers: one wrapper per
# spec method (casts void* -> impl, calls the impl method), the static vtable
# instance, the borrowed create (data=val, no destroy), and the owned
# create/destroy (heap-box the value, free + impl-destroy on drop).
emitProtocolImpl: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    implTid: ztypes.tid
    protoTid: ztypes.tid
    label: StringView
    buf: String.borrow
} is {
    implOrig: originTidOf :symtab tid: (ztypes.tid.create from: implTid.u64)
    if implOrig > 0 then return
    implBase: ctxCname :ctx tid: (ztypes.tid.create from: implTid.u64)
    implCtype: "\{implBase}_t"
    protoBase: ctxCname :ctx tid: protoTid
    protoCtype: "\{protoBase}_t"
    vtableCtype: "\{protoBase}_vtable_t"
    wbase: "\{implBase}_\{label}"
    mnames: List String
    mids: ListVal u64
    midsNm: ListVal u64
    protoChildMethods :ast :symtab tid: protoTid names: mnames ids: mids nameIds: midsNm
    mi: u64
    mn: mnames.length
    for mi < mn loop {
        mname: mnames.get i: mi
        mnameId: (zast.nameid.create from: (midsNm.get i: mi))
        smid: mids.get i: mi
        # the slot this wrapper would fill was omitted: a member naming the
        # interface's own type is not dispatchable
        if (specMemberIsSelfTyped
            :ast
            :symtab
            ifaceTid: protoTid
            smid: (ztypes.tid.create from: smid.u64)
        ) then {
            mi = mi + 1
            continue
        }
        ret: (methodRetCtype
            :ast
            :symtab
            :ctx
            mid: (ztypes.tid.create from: smid.u64)
            thisTid: protoTid
        )
        wparams: "void* _data".string
        # every method takes its receiver by pointer now, in both families
        cargs: "_self".string
        pnames: List String
        pids: ListVal u64
        pidsNm: ListVal u64
        (recFieldLists
            :ast
            :symtab
            tid: (ztypes.tid.create from: smid.u64)
            names: pnames
            ids: pids
            nameIds: pidsNm
        )
        pi: u64
        pn: pnames.length
        for pi < pn loop {
            pnm: pnames.get i: pi
            pid: pids.get i: pi
            ptn: regNameOf :symtab tid: (ztypes.tid.create from: pid.u64)
            isThis: false
            if pnm.stringView == "this" then isThis = true
            if ptn.stringView == "this" then isThis = true
            # A marked receiver is an ALIAS (`{t: this.view}`), so neither its
            # name nor its type says `this`. The registry records which
            # parameter IS the receiver; that is the question to ask, and it is
            # the same one methodReceiverIsView asks.
            {
                rpnW: symtab.reg.thisParamNameIdOf tid: (ztypes.tid.create from: smid.u64)
                if rpnW != 0 when (pidsNm.get i: pi) == rpnW.u64 then isThis = true
            }
            if isThis == false then {
                pct: (protoParamCtype
                    :ast
                    :symtab
                    :ctx
                    pid: (ztypes.tid.create from: pid.u64)
                    thisTid: (ztypes.tid.create from: protoTid.u64)
                )
                pnmP: memberCPrefix name: pnm.stringView
                wparams.append ", "
                wparams.append pct
                wparams.append " "
                wparams.append pnmP
                wparams.append pnm
                cargs.append ", "
                cargs.append pnmP
                cargs.append pnm
            }
            pi = pi + 1
        }
        implMc: (implMethodCname
            :symtab
            :ctx
            :implTid
            :mnameId
            mname: mname.stringView
            implBase: implBase.stringView
        )
        retkw: "return ".string
        if ret.stringView == "void" then retkw = "".string
        wslot: cSlotName name: mname.stringView
        w0: "static \{ret} \{wbase}_\{wslot}_wrapper(\{wparams}) {\n"
        buf.append w0
        w1: "    \{implCtype}* _self = (\{implCtype}*)_data;\n"
        buf.append w1
        w2: "    \{retkw}\{implMc}(\{cargs});\n"
        buf.append w2
        buf.append "}\n\n"
        mi = mi + 1
    }
    vi0: "static \{vtableCtype} \{wbase}_vtable = {\n"
    buf.append vi0
    mj: u64
    for mj < mn loop {
        mname2: mnames.get i: mj
        # the row for a member with no slot: there is nothing to point at
        if (specMemberIsSelfTyped
            :ast
            :symtab
            ifaceTid: protoTid
            smid: (ztypes.tid.create from: (mids.get i: mj))
        ) then {
            mj = mj + 1
            continue
        }
        rslot: cSlotName name: mname2.stringView
        vrow: "    .\{rslot} = \{wbase}_\{rslot}_wrapper,\n"
        buf.append vrow
        mj = mj + 1
    }
    buf.append "};\n\n"
    bc0: "static \{protoCtype} \{wbase}_create(\{implCtype}* val) {\n    \{protoCtype} proto = {0};\n    proto.data = val;\n    proto.vtable = &\{wbase}_vtable;\n    proto.destroy = NULL;\n    return proto;\n}\n\n"
    buf.append bc0
    od0: "static void \{wbase}_owned_destroy(void* p) {\n"
    buf.append od0
    if (symtab.reg.needsDestructor typeId: implTid) then {
        od1: "    \{implBase}_destroy((\{implCtype}*)p);\n"
        buf.append od1
    }
    buf.append "    free(p);\n}\n\n"
    oc0: "static \{protoCtype} \{wbase}_create_owned(\{implCtype}* val) {\n    \{protoCtype} proto = {0};\n    \{implCtype}* boxed = (\{implCtype}*)z_xmalloc(sizeof(\{implCtype}));\n    *boxed = *val;\n    proto.data = boxed;\n    proto.vtable = &\{wbase}_vtable;\n    proto.destroy = \{wbase}_owned_destroy;\n    return proto;\n}\n\n"
    buf.append oc0
}

# emitFacetImpl -- the per-(impl,label) facet conformance helpers: one
# wrapper per spec method (casts void* -> impl, calls the impl method), the
# static vtable instance, and a single copy-create (serves `.create` and
# `.borrow` -- a facet copies its source; borrow differs only at typecheck
# time). No owned variant, no heap, no destroy: impls are valtypes.
emitFacetImpl: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    implTid: ztypes.tid
    facetTid: ztypes.tid
    label: StringView
    buf: String.borrow
} is {
    if (isGenericType :symtab tid: (ztypes.tid.create from: implTid.u64)) then return
    implBase: ctxCname :ctx tid: (ztypes.tid.create from: implTid.u64)
    implCtype: "\{implBase}_t"
    facetBase: ctxCname :ctx tid: facetTid
    facetCtype: "\{facetBase}_t"
    vtableCtype: "\{facetBase}_vtable_t"
    wbase: "\{implBase}_\{label}"
    mnames: List String
    mids: ListVal u64
    midsNm: ListVal u64
    protoChildMethods :ast :symtab tid: facetTid names: mnames ids: mids nameIds: midsNm
    mi: u64
    mn: mnames.length
    for mi < mn loop {
        mname: mnames.get i: mi
        mnameId: (zast.nameid.create from: (midsNm.get i: mi))
        smid: mids.get i: mi
        # the slot this wrapper would fill was omitted: a member naming the
        # interface's own type is not dispatchable
        if (specMemberIsSelfTyped
            :ast
            :symtab
            ifaceTid: facetTid
            smid: (ztypes.tid.create from: smid.u64)
        ) then {
            mi = mi + 1
            continue
        }
        ret: (methodRetCtype
            :ast
            :symtab
            :ctx
            mid: (ztypes.tid.create from: smid.u64)
            thisTid: facetTid
        )
        wparams: "void* _data".string
        cargs: "_self".string
        pnames: List String
        pids: ListVal u64
        pidsNm: ListVal u64
        (recFieldLists
            :ast
            :symtab
            tid: (ztypes.tid.create from: smid.u64)
            names: pnames
            ids: pids
            nameIds: pidsNm
        )
        pi: u64
        pn: pnames.length
        for pi < pn loop {
            pnm: pnames.get i: pi
            pid: pids.get i: pi
            isThis: false
            if pnm.stringView == "this" then isThis = true
            # A marked receiver is an ALIAS (`{t: this.view}`), so neither its
            # name nor its type says `this`. The registry records which
            # parameter IS the receiver; that is the question to ask, and it is
            # the same one methodReceiverIsView asks.
            {
                rpnW: symtab.reg.thisParamNameIdOf tid: (ztypes.tid.create from: smid.u64)
                if rpnW != 0 when (pidsNm.get i: pi) == rpnW.u64 then isThis = true
            }
            if isThis == false then {
                pct: (protoParamCtype
                    :ast
                    :symtab
                    :ctx
                    pid: (ztypes.tid.create from: pid.u64)
                    thisTid: (ztypes.tid.create from: facetTid.u64)
                )
                pnmFP: memberCPrefix name: pnm.stringView
                wparams.append ", "
                wparams.append pct
                wparams.append " "
                wparams.append pnmFP
                wparams.append pnm
                cargs.append ", "
                cargs.append pnmFP
                cargs.append pnm
            }
            pi = pi + 1
        }
        implMc: (implMethodCname
            :symtab
            :ctx
            :implTid
            :mnameId
            mname: mname.stringView
            implBase: implBase.stringView
        )
        retkw: "return ".string
        if ret.stringView == "void" then retkw = "".string
        wslot: cSlotName name: mname.stringView
        w0: "static \{ret} \{wbase}_\{wslot}_wrapper(\{wparams}) {\n"
        buf.append w0
        w1: "    \{implCtype}* _self = (\{implCtype}*)_data;\n"
        buf.append w1
        w2: "    \{retkw}\{implMc}(\{cargs});\n"
        buf.append w2
        buf.append "}\n\n"
        mi = mi + 1
    }
    vi0: "static \{vtableCtype} \{wbase}_vtable = {\n"
    buf.append vi0
    mj: u64
    for mj < mn loop {
        mname2: mnames.get i: mj
        # the row for a member with no slot: there is nothing to point at
        if (specMemberIsSelfTyped
            :ast
            :symtab
            ifaceTid: facetTid
            smid: (ztypes.tid.create from: (mids.get i: mj))
        ) then {
            mj = mj + 1
            continue
        }
        rslot: cSlotName name: mname2.stringView
        vrow: "    .\{rslot} = \{wbase}_\{rslot}_wrapper,\n"
        buf.append vrow
        mj = mj + 1
    }
    buf.append "};\n\n"
    fc0: "static \{facetCtype} \{wbase}_create(\{implCtype}* val) {\n    \{facetCtype} facet = {0};\n    facet.vtable = &\{wbase}_vtable;\n    facet.data._i\{implTid} = *val;\n    return facet;\n}\n\n"
    buf.append fc0
}

# emitConformanceImplsForType -- the conformance helpers one impl type owes a
# family: every row of the conformance table naming it, each emitted once.
# The families differ in which impls they accept and which helper they emit,
# and in nothing else.
emitConformanceImplsForType: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    implTid: ztypes.tid
    # which family to emit for: a facet's helpers, or a protocol's
    isFacet: bool
    buf: String.borrow
} is {
    # a class impl is skipped for a facet: a class copied into an inline union
    # would break the valtype guarantee, and catching that is front-end work
    if isFacet then {
        if (symtab.reg.typetypeOf typeId: implTid) != ztypes.ztypetype.recordType then return
    }
    if (typeStructEmitted :ctx tid: implTid) == false then return
    tids: ListVal u64
    labels: List String
    rows: ListVal u64
    ri: u64
    with citer: symtab.typing.conformance.iterate do for row: citer loop {
        if row.implTypeId == implTid then {
            tids.append row.specTypeId
            labels.append row.label.copy
            rows.append ri
        }
        ri = ri + 1
    }
    want: ztypes.ztypetype.protocolType
    if isFacet then want = ztypes.ztypetype.facetType
    i: u64
    n: tids.length
    for i < n loop {
        tid: tids.get :i
        label: labels.get :i
        done: conformanceRowEmitted :ctx row: (rows.get :i)
        if (
            (symtab.reg.typetypeOf
                typeId: (ztypes.tid.create from: tid.u64)
            ) ==
            want
        ) when done == false then {
            conformanceRowMark :ctx row: (rows.get :i)
            if isFacet then {
                (emitFacetImpl
                    :ast
                    :symtab
                    :ctx
                    :implTid
                    facetTid: (ztypes.tid.create from: tid.u64)
                    label: label.stringView
                    :buf
                )
            } else {
                (emitProtocolImpl
                    :ast
                    :symtab
                    :ctx
                    :implTid
                    protoTid: (ztypes.tid.create from: tid.u64)
                    label: label.stringView
                    :buf
                )
            }
        }
        i = i + 1
    }
}

# conformanceLabelFor -- the as-block label under which implTid satisfies
# protoTid (e.g. "myreader"); "" when not found.
conformanceLabelFor: function {
    symtab: zenv.ZSymbolTable.view
    implTid: u64
    protoTid: u64
} out String is {
    res: String
    with citer: symtab.typing.conformance.iterate do for row: citer loop {
        if row.implTypeId == implTid when row.specTypeId == protoTid then {
            if res.length == 0 then res.append row.label
        }
    }
    return res
}

# fileTypeIdOf -- the class type id `nid` stamps to when that class supplies
# `mname` as a NATIVE member, else 0. A native member has no body to emit,
# which is what makes the call a fragment call; the defining unit's name used
# to stand in for that and admitted every type declared in the unit, so a user
# unit spelled `cli` or `os` had its own bodied methods called as fragments.
fileTypeIdOf: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    nid: u64
    mname: StringView
} out u64 is {
    tid: stampIdOf :symtab :nid
    if tid.isZero then return 0
    if (symtab.reg.typetypeOf typeId: tid) != ztypes.ztypetype.classType then return 0
    fileOrig: originTidOf :symtab :tid
    if fileOrig > 0 then return 0
    mo: (symtab.typing.declChildOf
        pool: ast.names
        parentTypeId: tid
        name: mname
    )
    match (
        mo
    ) case some then {
        if (fnIsNativeId
            :symtab
            fid: (ztypes.tid.create from: mo.u64)
        ) then return tid
    } case none then null
    return 0
}

# fileFromArgCoerce -- the emitted `from:` argument of a file-method call,
# projected to a by-value view when the arg is an owned String (TextWriter's
# StringLike param; ByteView args pass through unchanged). A non-lvalue
# String temp hoists for scope-exit free.
fileFromArgCoerce: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    av: StringView
} out String is {
    arx569: u64
    for arx569 < call.arguments.count.u64 loop {
        fa9Id: zast.kidAt kids: ast.kids span: call.arguments i: arx569
        arx569 = arx569 + 1
        fa: ast.nodes.get i: fa9Id.u64
        if fa.namedoperation then {
            faOpNode: ast.nodes.get i: fa.operation.u64
            fl: zast.nameTextAt :ast ref: fa.name
            if fl.stringView == "from" then {
                stampTid: (stampIdOf
                    :symtab
                    nid: (interpPartNodeId n: (ast.nodes.get i: fa.operation.u64))
                )
                if stampTid == ctx.strTid then {
                    isBorrow912: (hoistExprIsBorrowRooted :ast :symtab :ctx n: faOpNode)
                    fh: (hoistBorrowValArg
                        :ast
                        :symtab
                        :ctx
                        :av
                        pid: ctx.strTid
                        paramTake: false
                        isBorrow: isBorrow912
                    )
                    fb: av.string
                    if fh.length > 0 then fb = fh
                    fbq: atomVidIfPlain :ast :symtab :ctx n: faOpNode text: fb.stringView
                    return (svValueForm :ctx expr: fb.stringView isStr: true vid: fbq)
                }
            }
        }
    }
    return av.string
}

# emitFileMethodCall -- a File method (close/read/write/seek/flush), native,
# taking the receiver by pointer and collection args (Bytes/ByteView) by
# pointer. "" for any non-File receiver.
emitFileMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    isFM: false
    if mn == "close" then isFM = true
    if mn == "read" then isFM = true
    if mn == "write" then isFM = true
    if mn == "seek" then isFM = true
    if mn == "flush" then isFM = true
    if mn == "writeLine" then isFM = true
    if mn == "accept" then isFM = true
    if isFM == false then return "".string
    bnid: dottedBaseNodeId :ast n: (ast.nodes.get i: call.callable.u64)
    fid: fileTypeIdOf :ast :symtab nid: bnid mname: mn
    if fid == 0 then return "".string
    fc: ctxCname :ctx tid: (ztypes.tid.create from: fid.u64)
    {
        fcn: regNameOf :symtab tid: (ztypes.tid.create from: fid.u64)
        fcc: ioCanonCname :ast :symtab :ctx canon: fcn.stringView
        if fcc.length > 0 then fc = fcc
    }
    recvV0: atomVid :symtab nid: bnid
    recv: aliasResolve :ctx name: bn vid: recvV0
    recvV: ztypes.vid
    if recv.stringView == bn then recvV = recvV0
    recvC: emitLocalAtomName :ctx name: bn vid: recvV0
    recvExpr: "&\{recvC}"
    if (isPtrVid :ctx vid: recvV) then recvExpr = recvC
    isNet: false
    {
        fduo: definedInUnitOf :symtab tid: (ztypes.tid.create from: fid.u64)
        match (
            fduo
        ) case some then {
            if fduo.stringView == "net" then isNet = true
        } case none then null
    }
    if isNet then {
        needsAddM :ctx uname: "net" memb: "@unit"
    } else {
        needsAddM :ctx uname: "io" memb: "@unit"
        fmm: "file_\{mn}"
        needsAddM :ctx uname: "io" memb: fmm.stringView
    }
    if mn == "accept" then {
        if isNet == false then return "".string
        return "\{fc}_accept(\{recvExpr})"
    }
    if mn == "close" then return "\{fc}_close(\{recvExpr})"
    if mn == "flush" then return "\{fc}_flush(\{recvExpr})"
    if mn == "write" then {
        fv: ctorArgByLabel :ast :symtab :ctx :call label: "from"
        fvc: fileFromArgCoerce :ast :symtab :ctx :call av: fv.stringView
        return "\{fc}_write(\{recvExpr}, &\{fvc})"
    }
    if mn == "read" then {
        iv: ctorArgByLabel :ast :symtab :ctx :call label: "into"
        mv: ctorArgByLabel :ast :symtab :ctx :call label: "max"
        ivptr: argIsPointerByLabel :ast :symtab :ctx :call label: "into"
        if ivptr then return "\{fc}_read(\{recvExpr}, \{iv}, \{mv})"
        return "\{fc}_read(\{recvExpr}, &\{iv}, \{mv})"
    }
    if mn == "seek" then {
        tv: ctorArgByLabel :ast :symtab :ctx :call label: "to"
        ov: ctorArgByLabel :ast :symtab :ctx :call label: "from"
        return "\{fc}_seek(\{recvExpr}, \{tv}, \{ov})"
    }
    if mn == "writeLine" then {
        wlv: ctorArgByLabel :ast :symtab :ctx :call label: "from"
        wlc: fileFromArgCoerce :ast :symtab :ctx :call av: wlv.stringView
        return "\{fc}_writeLine(\{recvExpr}, &\{wlc})"
    }
    return "".string
}

# ioCreateWrapper -- the wrapper name X of an `io.X.create` callable, else "".
ioCreateWrapper: function {ast: Ast.view n: astnode.view} outx StringView is {
    if n.dottedpath then {
        ccn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if ccn.stringView == "create" then {
            pb: dottedBaseAtom :ast n: (ast.nodes.get i: n.parent.u64)
            if pb == "io" then return (dottedChildText :ast n: (ast.nodes.get i: n.parent.u64))
        }
    }
    return ""
}

# argBaseAtom / argBaseNodeId -- the base of a wrapper-create argument. The
# dotted extractors take the base of a PATH, which is what a `.borrow`-suffixed
# argument always was; a `borrow` parameter needs no suffix, so the argument
# arrives as a BARE atom and is its own base. Without the fallback the emitter
# builds `z_t0__create(&)` -- an unresolved type and an empty expression -- which
# typechecks clean and dies at gcc.
argBaseAtom: function {ast: Ast.view n: astnode.view} outx StringView is {
    b: dottedBaseAtom :ast :n
    if b.length > 0 then return b
    t: atomTextOf :ast :n
    if t.length > 0 then return t
    # the `:name` shorthand is a THIRD shape, and the one `zl fmt` writes
    # whenever the label and the variable agree -- so a hand-written
    # `bag: bag` becomes `:bag` on the next format and the base disappeared
    # with it. The label IS the value's name here.
    if n.labelvalue then return (zast.nameTextAt :ast ref: n.name).stringView
    return ""
}

# the node an argument's value ultimately comes from, unwrapping the
# wrappers between
argBaseNodeId: function {ast: Ast.view n: astnode.view} out u32 is {
    i: dottedBaseNodeId :ast :n
    if i > 0 then return i.u32.orPanic
    a: (atomNodeId :n).u32.orPanic
    if a > 0 then return a
    # the `:name` shorthand carries its own stamp on its own row
    if n.labelvalue then return n.nodeid.u32
    return 0
}

# wrapperCreateArg -- one io-wrapper create arg by the create-param type: a
# protocol-borrow param projects the `.borrow` base to that protocol; a class-borrow
# param takes the base's address; a scalar param emits the arg directly.
wrapperCreateArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    label: StringView
    ptid: ztypes.tid
} out String is {
    prtn: regNameOf :symtab tid: (ztypes.tid.create from: ptid.u64)
    prtid: (canonTypeId
        :ast
        :symtab
        :ctx
        tid: (ztypes.tid.create from: ptid.u64)
        name: prtn.stringView
    )
    arx579: u64
    for arx579 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx579
        arx579 = arx579 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            al: zast.nameTextAt :ast ref: a.name
            if al.stringView == label then {
                if (
                    (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: prtid.u64)) ==
                    ztypes.ztypetype.protocolType
                ) then {
                    ab: argBaseAtom :ast n: (ast.nodes.get i: a.operation.u64)
                    abnid: (argBaseNodeId
                        :ast
                        n: (ast.nodes.get i: a.operation.u64)
                    ).u64
                    abrV0: atomVid :symtab nid: abnid
                    abr: aliasResolve :ctx name: ab vid: abrV0
                    abtid: stampIdOf :symtab nid: abnid
                    abcb: ctxCname :ctx tid: abtid
                    ablab: conformanceLabelFor :symtab implTid: abtid protoTid: prtid
                    abv: ztypes.vid
                    if abr.stringView == ab then abv = (atomVid :symtab nid: abnid)
                    abrC: emitLocalAtomName :ctx name: ab vid: abrV0
                    abpfx: "&".string
                    if (isPtrVid :ctx vid: abv) then abpfx = "".string
                    return "\{abcb}_\{ablab}_create(\{abpfx}\{abrC})"
                }
                if (
                    (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: prtid.u64)) ==
                    ztypes.ztypetype.classType
                ) then {
                    a2op: ast.nodes.get i: a.operation.u64
                    ab2: argBaseAtom :ast n: a2op
                    argBaseVid: atomVid :symtab nid: (argBaseNodeId :ast n: a2op).u64
                    abr2: aliasResolve :ctx name: ab2 vid: argBaseVid
                    ab2v: ztypes.vid
                    if abr2.stringView == ab2 then ab2v = argBaseVid
                    abr2C: emitLocalAtomName :ctx name: ab2 vid: argBaseVid
                    ab2pfx: "&".string
                    if (isPtrVid :ctx vid: ab2v) then ab2pfx = "".string
                    return "\{ab2pfx}\{abr2C}"
                }
                return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64))
            }
        }
    }
    return "0".string
}

# emitIoWrapperCreate -- `io.BufWriter.create to: w.borrow capacity: 16` ->
# z_t{id}_BufWriter_create(<projected/addressed args in param order>). "" for
# any non-io-wrapper-create callee.
emitIoWrapperCreate: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    wn: ioCreateWrapper :ast n: (ast.nodes.get i: call.callable.u64)
    if wn.length == 0 then return "".string
    wid: resolveTypeIdByName :ast :symtab :ctx name: wn
    if wid == 0 then return "".string
    if (
        (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: wid.u64)) !=
        ztypes.ztypetype.classType
    ) then return "".string
    cco: (symtab.typing.declChildOfId
        parentTypeId: (ztypes.tid.create from: wid.u64)
        nameId: zast.names.wkCreate
    )
    cid: ztypes.tid
    match (
        cco
    ) case some then {
        cid = ztypes.tid.create from: cco
    } case none then null
    if cid.isZero then return "".string
    pnames: List String
    pids: ListVal u64
    pidsNm: ListVal u64
    (recFieldLists
        :ast
        :symtab
        tid: (ztypes.tid.create from: cid.u64)
        names: pnames
        ids: pids
        nameIds: pidsNm
    )
    args: String
    pi: u64
    pn: pnames.length
    for pi < pn loop {
        pnm: pnames.get i: pi
        ptid: pids.get i: pi
        astr: (wrapperCreateArg
            :ast
            :symtab
            :ctx
            :call
            label: pnm.stringView
            ptid: (ztypes.tid.create from: ptid.u64)
        )
        if pi > 0 then args.append ", "
        args.append astr
        pi = pi + 1
    }
    wcn: ctxCname :ctx tid: (ztypes.tid.create from: wid.u64)
    typeUseAdd :ctx tid: (ztypes.tid.create from: wid.u64)
    return "\{wcn}_create(\{args})"
}

# nativeNoArgOf -- the unit that DECLARES `base.memb` when the member is a
# native taking no parameters, so a no-paren read auto-calls it (os.pid,
# io.stdout). "" otherwise. The gates run cheapest first: nearly every dotted
# path has a non-unit base and stops at the registry lookup, and the shadow
# check -- a declaration of the base name in `unitName` displaces the unit,
# since name ids are pooled program-wide -- runs only once a native is in
# hand.
nativeNoArgOf: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    unitName: StringView
    baseId: zast.nameid
    base: StringView
    membId: zast.nameid
} out String is {
    if baseId.isZero then return "".string
    if (
        (ztypecheck.isUnitNameDecl
            st: symtab
            nameId: baseId
        ) ==
        false
    ) then return "".string
    ud14x: ztypecheck.unitDeclOfName st: symtab nameId: baseId
    fo: (ztypecheck.resolvedByIdsRo
        :ast
        st: symtab
        unitDecl: ud14x
        name: membId
    )
    calleeTid: ztypes.tid
    match (
        fo
    ) case some then {
        calleeTid = ztypes.tid.create from: fo
    } case none then {
        return "".string
    }
    if (
        (symtab.reg.typetypeOf typeId: calleeTid) != ztypes.ztypetype.functionType
    ) then return "".string
    if (fnIsNativeId :symtab fid: calleeTid) == false then return "".string
    pi: ListVal u64
    pnm: ListVal u64
    recFieldIds :symtab tid: calleeTid ids: pi nameIds: pnm
    if pi.length > 0 then return "".string
    uq5z: (ztypecheck.unitDeclOfName
        st: symtab
        nameId: (zast.poolFind pool: ast.names text: unitName)
    )
    nameId95: (zast.poolFind pool: ast.names text: base)
    sh: (ztypecheck.resolveUnitChildRo
        :ast
        st: symtab
        unitDecl: uq5z
        nameId: nameId95
    )
    match (
        sh
    ) case some then {
        shT: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: sh)
        if shT != ztypes.ztypetype.unitType then return "".string
    } case none then null
    duo: definedInUnitOf :symtab tid: calleeTid
    match (
        duo
    ) case some then {
        return duo.copy
    } case none then {
        return "".string
    }
}

# noArgNativeRhs -- a binding RHS that is a bare zero-parameter native
# auto-call (os.args / os.envNames return an owned List, so the binding's List
# branch must emit the call, not a fresh empty list).
noArgNativeRhs: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    unitName: StringView
    n: astnode.view
} out bool is {
    match (
        n
    ) case expression then {
        return (noArgNativeRhs :ast :symtab :unitName n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (noArgNativeRhs
            :ast
            :symtab
            :unitName
            n: (ast.nodes.get i: n.statementline.u64)
        )
    } case dottedpath then {
        baseAtom: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
        nu: (nativeNoArgOf
            :ast
            :symtab
            :unitName
            baseId: (atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
            base: baseAtom.stringView
            membId: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        )
        return nu.length > 0
    } else {
        return false
    }
}

# lowerNativeArg -- lower one native-call argument from the DECLARED
# parameter: StringView / StringLike-generic params take a by-value view
# (String args project, interpolations hoist to a view); class and
# borrowed-List params pass by pointer; take params pass the owned value;
# scalars pass verbatim.
lowerNativeArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    fid: ztypes.tid
    pname: StringView
    pid: ztypes.tid
    op: astnode.view
} out String is {
    isViewP: false
    if pid == ctx.svTid then isViewP = true
    if (symtab.reg.typetypeOf typeId: pid) == ztypes.ztypetype.genericParam then isViewP = true
    if isViewP then {
        avh: emitColInterpArg :ast :symtab :ctx n: op consumes: false
        if avh.length > 0 then return (svValueForm
            :ctx
            expr: avh.stringView
            isStr: true
            vid: (ztypes.vid.create from: 0)
        )
        av0: emitExpr :ast :symtab :ctx n: op
        if (stampIsStr :symtab :ctx nid: (interpPartNodeId n: op)) then {
            isBorrow913: (hoistExprIsBorrowRooted :ast :symtab :ctx n: op)
            hb: (hoistBorrowValArg
                :ast
                :symtab
                :ctx
                av: av0.stringView
                pid: ctx.strTid
                paramTake: false
                isBorrow: isBorrow913
            )
            if hb.length > 0 then av0 = hb
            av0q: atomVidIfPlain :ast :symtab :ctx n: op text: av0.stringView
            return (svValueForm :ctx expr: av0.stringView isStr: true vid: av0q)
        }
        return av0
    }
    iv: emitInterpArgExpr :ast :symtab :ctx n: op
    if iv.length > 0 then return iv
    isTake: (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.takeMode
    )
    needAmp: false
    if isTake == false then {
        if (isReftypeParam
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: pid.u64)
        ) then needAmp = true
        if (isListPtrParam
            :ast
            :symtab
            :ctx
            :fid
            :pname
            tid: (ztypes.tid.create from: pid.u64)
        ) then needAmp = true
        if (markedValtypeRefParam :ast :symtab :fid :pname :pid) then needAmp = true
    }
    av1: emitExpr :ast :symtab :ctx n: op
    if needAmp when (pathIsPointer :ast :symtab :ctx n: op) == false then return "&\{av1}"
    return av1
}

# emitNativeArg -- find one native-call argument by label, else by the
# positional cursor, and lower it (lowerNativeArg).
emitNativeArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
    fid: ztypes.tid
    pname: StringView
    pid: ztypes.tid
    usePos: bool
    posIdx: u64
} out String is {
    seen: u64
    arx589: u64
    for arx589 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx589
        arx589 = arx589 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            al: zast.nameTextAt :ast ref: a.name
            if usePos then {
                if al.length == 0 then {
                    if seen == posIdx then {
                        return (lowerNativeArg
                            :ast
                            :symtab
                            :ctx
                            :fid
                            :pname
                            :pid
                            op: (ast.nodes.get i: a.operation.u64)
                        )
                    }
                    seen = seen + 1
                }
            } else {
                if al.stringView == pname then {
                    return (lowerNativeArg
                        :ast
                        :symtab
                        :ctx
                        :fid
                        :pname
                        :pid
                        op: (ast.nodes.get i: a.operation.u64)
                    )
                }
            }
        }
    }
    return "0".string
}

# emitNativeFreeFnCall -- ANY call (dotted `io.remove ...` or a bare sibling
# `remove ...` inside the unit) that resolves to an `is native` FREE function
# of a runtime-convention unit emits `z_<unit>_<name>(<args>)`, each argument
# lowered from the declared parameter (emitNativeArg). "" for anything else:
# bodied siblings fall through to the id-cname route, methods to their own
# legs, non-convention natives (stringJoin/print/panic) to theirs.
emitNativeFreeFnCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    un: String
    mn: ""
    fidHint: u64
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    if bn.length > 0 then {
        calr: ast.nodes.get i: call.callable.u64
        mn = dottedChildText :ast n: calr
        dp: "\{bn}.\{mn}"
        if (nativeIsFragBacked :ctx path: dp.stringView) == false then return "".string
        un = bn.string
    } else {
        mn = atomTextOf :ast n: (ast.nodes.get i: call.callable.u64)
        if mn.length == 0 then return "".string
        fid0: userFnId :ast :symtab :ctx name: mn
        if fid0.isZero then return "".string
        if (
            (fnIsNativeId
                :symtab
                fid: (ztypes.tid.create from: fid0.u64)
            ) ==
            false
        ) then return "".string
        duo0: definedInUnitOf :symtab tid: fid0
        match (
            duo0
        ) case some then {
            bp: "\{duo0}.\{mn}"
            if (nativeIsFragBacked :ctx path: bp.stringView) == false then return "".string
            un = duo0.copy
        } case none then {
            return "".string
        }
        fidHint = fid0
    }
    if mn.length == 0 then return "".string
    fid: ztypes.tid
    if fidHint > 0 then {
        fid = ztypes.tid.create from: fidHint
    } else {
        ud15x: (ztypecheck.unitDeclOfName
            st: symtab
            nameId: (zast.poolFind pool: ast.names text: un.stringView)
        )
        fo: (ztypecheck.resolvedByIdsRo
            :ast
            st: symtab
            unitDecl: ud15x
            name: (zast.poolFind pool: ast.names text: mn)
        )
        match (
            fo
        ) case some then {
            fid = ztypes.tid.create from: fo
        } case none then {
            return "".string
        }
    }
    if (symtab.reg.typetypeOf typeId: fid) != ztypes.ztypetype.functionType then return "".string
    if (fnIsNativeId :symtab :fid) == false then return "".string
    needsAddM :ctx uname: un.stringView memb: "@unit"
    needsAddM :ctx uname: un.stringView memb: mn
    pn: List String
    pidl: ListVal u64
    pidlNm: ListVal u64
    recFieldLists :ast :symtab tid: fid names: pn ids: pidl nameIds: pidlNm
    args: String
    m: pn.length
    j: u64
    positionalIdx: u64
    for j < m loop {
        pname: pn.get i: j
        pid: pidl.get i: j
        j = j + 1
        hasL: ctorHasLabel :ast :call label: pname.stringView
        av: String
        if hasL then {
            av = (emitNativeArg
                :ast
                :symtab
                :ctx
                :call
                :fid
                pname: pname.stringView
                pid: (ztypes.tid.create from: pid.u64)
                usePos: false
                posIdx: 0
            )
        } else {
            av = (emitNativeArg
                :ast
                :symtab
                :ctx
                :call
                :fid
                pname: pname.stringView
                pid: (ztypes.tid.create from: pid.u64)
                usePos: true
                posIdx: positionalIdx
            )
            positionalIdx = positionalIdx + 1
        }
        if args.length > 0 then args.append ", "
        args.append av
    }
    return "z_\{un}_\{mn}(\{args})"
}

# cliCreateClass -- the class name X of a `cli.X.create` callable, else "".
cliCreateClass: function {ast: Ast.view n: astnode.view} outx StringView is {
    if n.dottedpath then {
        ccn: zast.nameTextAt :ast ref: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        if ccn.stringView == "create" then {
            pb: dottedBaseAtom :ast n: (ast.nodes.get i: n.parent.u64)
            if pb == "cli" then return (dottedChildText :ast n: (ast.nodes.get i: n.parent.u64))
        }
    }
    return ""
}

# emitCliSpecCreate -- `cli.Spec.create programName: ... summary: ...` ->
# z_t{id}_Spec_create(<args in param order>). "" for any non-cli-create callee.
emitCliSpecCreate: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    cn: cliCreateClass :ast n: (ast.nodes.get i: call.callable.u64)
    if cn.length == 0 then return "".string
    cid: (cliClassTypeId
        :symtab
        :ctx
        nameId: (zast.poolFind pool: ast.names text: cn)
    )
    if cid == 0 then return "".string
    cco: (symtab.typing.declChildOfId
        parentTypeId: (ztypes.tid.create from: cid.u64)
        nameId: zast.names.wkCreate
    )
    crid: ztypes.tid
    match (
        cco
    ) case some then {
        crid = ztypes.tid.create from: cco
    } case none then null
    if crid.isZero then return "".string
    # the class name reached here through a SOURCE-TEXT match on `cli.X.create`
    # and a lookup of X in whichever unit is spelled `cli` -- a user unit can
    # win that. Ask the resolved `create` its own declaration instead: the
    # stdlib's is `is native`, a fragment supplies the body, and the parameters
    # laid out below are its. A user's bodied create is not that one.
    if (fnIsNativeId :symtab fid: crid) == false then return "".string
    pnames: List String
    pids: ListVal u64
    pidsNm: ListVal u64
    (recFieldLists
        :ast
        :symtab
        tid: (ztypes.tid.create from: crid.u64)
        names: pnames
        ids: pids
        nameIds: pidsNm
    )
    args: String
    pi: u64
    pn: pnames.length
    for pi < pn loop {
        pnm: pnames.get i: pi
        astr: ctorArgByLabel :ast :symtab :ctx :call label: pnm.stringView
        if pi > 0 then args.append ", "
        args.append astr
        pi = pi + 1
    }
    needsAddM :ctx uname: "cli" memb: "@unit"
    needsAddM :ctx uname: "cli" memb: "spec_create"
    ccb: ctxCname :ctx tid: (ztypes.tid.create from: cid.u64)
    return "\{ccb}_create(\{args})"
}

# emitResultCombinator -- inline lowering of the built-in combinators `.orPanic`
# (unwrap the ok payload or abort) and `.or d:` (unwrap or default) on a
# `resultval` receiver, and `.or d:` on an `optionval` one (the variants are
# the only types declaring them; the `Result` and `Option` unions' C shapes
# have no tagged arm to project). Branchless statement-expression, no result
# struct call. "" when the call is not one of these.
emitResultCombinator: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    isP: false
    if mn == "orPanic" then isP = true
    isO: false
    if mn == "or" then isO = true
    bothMiss: isP == false
    if bothMiss when isO == false then return "".string
    bnid: u32
    {
        cnDp: ast.nodes.get i: call.callable.u64
        if cnDp.dottedpath then bnid = cnDp.parent
    }
    if bnid == 0 then return "".string
    rtid0: stampIdOf :symtab nid: (interpPartNodeId n: (ast.nodes.get i: bnid.u64))
    rtid: chaseColMono :symtab :ctx tid: rtid0
    if rtid.isZero then return "".string
    isRes: (originIsTid :symtab tid: rtid originTid: (ctx.origins.get i: ogResultval))
    isOpt: (originIsTid :symtab tid: rtid originTid: (ctx.origins.get i: ogOptionval))
    if isRes == false when isOpt == false then return "".string
    # `orPanic` is resultval's alone
    if isP when isRes == false then return "".string
    payArm: "ok"
    if isOpt then payArm = "some"
    recvExpr: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: bnid.u64)
    if recvExpr.length == 0 then return "".string
    okTag: variantTag :symtab tid: (ztypes.tid.create from: rtid.u64) arm: payArm
    rcT: ctxCname :ctx tid: (ztypes.tid.create from: rtid.u64)
    if isP then {
        rp: "({ \{rcT}_t _rc = (\{recvExpr.stringView}); if (_rc.tag != \{okTag.stringView}) z_panic(\"orPanic: result is err\"); _rc.data.ok; })"
        return rp
    }
    argN: call.arguments.count.u64
    if argN == 0 then return "".string
    firstArgId: zast.kidAt kids: ast.kids span: call.arguments i: 0
    opId: zast.nodeid
    {
        a: ast.nodes.get i: firstArgId.u64
        if a.namedoperation then opId = a.operation
    }
    if opId.isZero then return "".string
    dExpr: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: opId.u64)
    if dExpr.length == 0 then return "".string
    ro: "({ \{rcT}_t _rc = (\{recvExpr.stringView}); (_rc.tag == \{okTag.stringView}) ? _rc.data.\{payArm} : (\{dExpr.stringView}); })"
    return ro
}

# emitParsedMethodCall -- a Parsed accessor (hasFlag/option/positional), native,
# receiver by pointer (incl. the narrowed Result ok-arm projection) and the
# StringView name by pointer. "" for any non-Parsed receiver.
emitParsedMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    isPM: false
    if mn == "hasFlag" then isPM = true
    if mn == "option" then isPM = true
    if mn == "positional" then isPM = true
    if isPM == false then return "".string
    bnid: dottedBaseNodeId :ast n: (ast.nodes.get i: call.callable.u64)
    pid: fileTypeIdOf :ast :symtab nid: bnid mname: mn
    if pid == 0 then return "".string
    pcn: regNameOf :symtab tid: (ztypes.tid.create from: pid.u64)
    if pcn.stringView != "Parsed" then return "".string
    pc: ctxCname :ctx tid: (ztypes.tid.create from: pid.u64)
    recvV0: atomVid :symtab nid: bnid
    recv: aliasResolve :ctx name: bn vid: recvV0
    recvV: ztypes.vid
    if recv.stringView == bn then recvV = recvV0
    recvC: emitLocalAtomName :ctx name: bn vid: recvV0
    recvExpr: "&\{recvC}"
    if (isPtrVid :ctx vid: recvV) then recvExpr = recvC
    needsAddM :ctx uname: "cli" memb: "@unit"
    needsAddM :ctx uname: "cli" memb: mn
    nameArg: ctorArgByLabel :ast :symtab :ctx :call label: "name"
    return "\{pc}_\{mn}(\{recvExpr}, &\{nameArg})"
}

# emitUserIterCall -- a manual `g.call value: X` on a user iterator class (a
# generator's iter): `z_t{id}_{Fn}_iter_call(&g, X)`; a `.borrow` value
# passes by address. "" for any non-user-iter `.call`.
emitUserIterCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if mn != "call" then return "".string
    bnid: dottedBaseNodeId :ast n: (ast.nodes.get i: call.callable.u64)
    rid0: stampIdOf :symtab nid: bnid
    if rid0.isZero then return "".string
    iterId: rid0
    ot0: originTidOf :symtab tid: rid0
    if ot0.isZero then {
        rtn: regNameOf :symtab tid: rid0
        cano: (ztypecheck.walkLookupTyperefRo
            frame: ztypes.declid
            :ast
            st: symtab
            unitDecl: ctx.mainUnitId
            base: rtn.stringView
        )
        match (
            cano
        ) case some then {
            hasCallI: (symtab.typing.declHasMemberId
                parentTypeId: (ztypes.tid.create from: cano.u64)
                nameId: zast.names.wkCall
            )
            if hasCallI then iterId = ztypes.tid.create from: cano.u64
        } case none then null
    }
    if (symtab.reg.typetypeOf typeId: iterId) != ztypes.ztypetype.classType then return "".string
    itorig: originTidOf :symtab tid: iterId
    if itorig > 0 then return "".string
    itn: regNameOf :symtab tid: iterId
    if (canonFnId :ast :symtab :ctx tid: iterId name: itn.stringView) <= 0 then return "".string
    cco: symtab.typing.declChildOfId parentTypeId: iterId nameId: zast.names.wkCall
    match (
        cco
    ) case some then {
        callC: ctxCname :ctx tid: (ztypes.tid.create from: cco.u64)
        recvVid: atomVid :symtab nid: bnid
        recvText: aliasResolve :ctx name: bn vid: recvVid
        recvV: ztypes.vid
        if recvText.stringView == bn then recvV = recvVid
        recvC: emitLocalAtomName :ctx name: bn vid: recvVid
        recvExpr: "&\{recvC}"
        if (isPtrVid :ctx vid: recvV) then recvExpr = recvC
        valArg: String
        hasVal: false
        arx599: u64
        for arx599 < call.arguments.count.u64 loop {
            av9Id: zast.kidAt kids: ast.kids span: call.arguments i: arx599
            arx599 = arx599 + 1
            atomVarId: ast.nodes.get i: av9Id.u64
            if atomVarId.namedoperation then {
                # `.call` takes at most ONE argument -- the per-call input --
                # so the first one IS it, whatever the author labelled it.
                if hasVal == false then {
                    hasVal = true
                    ve: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: atomVarId.operation.u64)
                    # The resume value goes by REFERENCE when it is a reftype --
                    # the synthesised `.call` declares that parameter as a
                    # pointer. Decided by the TYPE, never by the argument's
                    # spelling (a `borrow` parameter's bare-name argument needs
                    # its `&` too); a `.borrow`-suffixed argument reaches the same
                    # answer through argBaseAtom.
                    vop: ast.nodes.get i: atomVarId.operation.u64
                    vbase: argBaseAtom :ast n: vop
                    vbnid: (argBaseNodeId :ast n: vop).u64
                    vIsRef: false
                    if vbase.length > 0 then {
                        tid95: (stampIdOf :symtab nid: vbnid)
                        vIsRef = (isReftypeParam
                            :ast
                            :symtab
                            :ctx
                            tid: tid95
                        )
                    }
                    if vIsRef then {
                        valueBaseVid: atomVid :symtab nid: vbnid
                        vbr: aliasResolve :ctx name: vbase vid: valueBaseVid
                        vbv: ztypes.vid
                        if vbr.stringView == vbase then vbv = valueBaseVid
                        vpfx: "&".string
                        if (isPtrVid :ctx vid: vbv) then vpfx = "".string
                        valArg = "\{vpfx}\{ve}"
                    } else {
                        valArg = ve
                    }
                }
            }
        }
        if hasVal then return "\{callC}(\{recvExpr}, \{valArg})"
        return "\{callC}(\{recvExpr})"
    } case none then {
        return "".string
    }
}

# isDispatchableTid -- a vtable-dispatch receiver type: protocol or facet.
isDispatchableTid: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    tt: symtab.reg.typetypeOf typeId: tid
    if tt == ztypes.ztypetype.protocolType then return true
    return tt == ztypes.ztypetype.facetType
}

# vtableDataArg -- the receiver argument a vtable slot takes. A protocol's
# `data` is already a pointer to the boxed impl; a facet stores the impl INLINE
# in a union, so the slot takes its address.
vtableDataArg: function {recv: StringView acc: StringView isFacet: bool} out String is {
    if isFacet then return "&\{recv}\{acc}data"
    return "\{recv}\{acc}data"
}

# vtableAutoCallName -- a member name that dispatches through the vtable. The
# three lifecycle verbs are emitted by their own legs (emitProtocolCreateCall
# and the destroy helper) and have no vtable slot.
vtableAutoCallName: function {name: StringView} out bool is {
    if name == "create" then return false
    if name == "borrow" then return false
    if name == "drop" then return false
    return true
}

# vtableAutoCallC -- a ZERO-ARG method auto-call on a protocol/facet receiver.
# A zero-arg method is not a Call node, so it never reaches
# emitProtocolDispatch; this is the same dispatch spelled for the dotted-path
# legs.
vtableAutoCallC: function {
    recv: StringView
    acc: StringView
    mn: StringView
    isFacet: bool
} out String is {
    return (vtableCallC :recv :acc :mn :isFacet argTail: "")
}

# emitBinopVtableCall -- a binary operator whose RECEIVER is an interface,
# dispatched through the vtable. "" when the receiver is not one, which leaves
# emitBinop on its ordinary leg.
#
# The receiver's spelling is inverted from that leg: there `pathIsPointer`
# decides whether to ADD an `&`, here it decides `.` against `->`, and
# vtableDataArg puts the `&` back for a facet -- whose impl is inline in a
# union rather than behind a pointer. The lvalue hoist is kept for the same
# reason it exists there: `&someCall().data` is not an lvalue either.
#
# The slot comes from callName, not from the operator as written: a `!=` the
# checker derived resolves to `==` and is negated here, so the name that
# resolved is the name that must be dispatched.
emitBinopVtableCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    lhsNid: u64
    owner: ztypes.tid
    callName: zast.nameid
    lhs: StringView
    rhs: StringView
    neg: bool
} out String is {
    if (isDispatchableTid :symtab tid: owner) == false then return "".string
    isFacet: (symtab.reg.typetypeOf typeId: owner) == ztypes.ztypetype.facetType
    acc: ".".string
    recvText: lhs.string
    if (pathIsPointer :ast :symtab :ctx n: (ast.nodes.get i: lhsNid)) then {
        acc = "->".string
    } else {
        recvText = lvalueForm :ast :symtab :ctx av: lhs tid: owner
    }
    mn: zast.nameTextAt :ast ref: callName
    if mn.length == 0 then return "".string
    tail: ", \{rhs}"
    d: (vtableCallC
        recv: recvText.stringView
        acc: acc.stringView
        mn: mn.stringView
        :isFacet
        argTail: tail.stringView
    )
    if neg then {
        nd: "!\{d}"
        return nd
    }
    return d
}

# vtableCallC -- the dispatch itself: `recv.vtable->slot(dataArg, args...)`.
# Four plain values and a ready-made argument tail, so every call form can
# reach it. emitProtocolDispatch builds a tail out of a callrow's arguments; a
# binop's one operand is already emitted by the time emitBinop runs, so it
# passes that. A binop is the call form for a one-argument method and it now
# dispatches through the same three spellings the slot, the wrapper and the
# vtable row come from.
vtableCallC: function {
    recv: StringView
    acc: StringView
    mn: StringView
    isFacet: bool
    argTail: StringView
} out String is {
    dargs: vtableDataArg :recv :acc :isFacet
    return "\{recv}\{acc}vtable->\{(cSlotName name: mn)}(\{dargs}\{argTail})"
}

# emitProtocolDispatch -- a method call on a protocol-typed receiver routes
# through the vtable: `r.read b: 5` -> `r.vtable->read(r.data, 5)`.
emitProtocolDispatch: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if mn.length == 0 then return "".string
    if mn == "create" then return "".string
    if mn == "borrow" then return "".string
    if mn == "drop" then return "".string
    rtid: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: call.callable.u64)
    if (isDispatchableTid :symtab tid: (ztypes.tid.create from: rtid.u64)) == false then {
        rtn0: regNameOf :symtab tid: (ztypes.tid.create from: rtid.u64)
        if rtn0.length > 0 then {
            brid: (canonTypeId
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: rtid.u64)
                name: rtn0.stringView
            )
            if (isDispatchableTid
                :symtab
                tid: (ztypes.tid.create from: brid.u64)
            ) then rtid = ztypes.tid.create from: brid.u64
        }
    }
    if (
        (isDispatchableTid
            :symtab
            tid: (ztypes.tid.create from: rtid.u64)
        ) ==
        false
    ) then return "".string
    isFacetR: (symtab.reg.typetypeOf typeId: rtid) == ztypes.ztypetype.facetType
    recv: emitDottedReceiver :ast :symtab :ctx callable: (ast.nodes.get i: call.callable.u64)
    if recv.length == 0 then return "".string
    acc: ".".string
    callableNode: ast.nodes.get i: call.callable.u64
    if (dottedReceiverIsPtr :ast :symtab :ctx callable: callableNode) then acc = "->".string
    dargs: (vtableDataArg
        recv: recv.stringView
        acc: acc.stringView
        isFacet: isFacetR
    )
    mtid: ((symtab.typing.declChildOf
        pool: ast.names
        parentTypeId: rtid
        name: mn
    ).or
        d: 0
    )
    mpNames: List String
    mpIds: ListVal u64
    mpIds9Nm: ListVal u64
    if mtid > 0 then (recFieldLists
        :ast
        :symtab
        tid: (ztypes.tid.create from: mtid.u64)
        names: mpNames
        ids: mpIds
        nameIds: mpIds9Nm
    )
    # the receiver is implicit at the call site, so it is not a slot an
    # argument can land in. Filtered by id, like the match itself
    vpn: ListVal u64
    vi: u64
    for vi < mpIds9Nm.length loop {
        nmId: mpIds9Nm.get i: vi
        if nmId != zast.names.wkThis.u64 then vpn.append nmId
        vi = vi + 1
    }
    if vpn.length > 0 then {
        slots9p: argSlotList :ast :call fpNameIds: vpn
        valBySlot9p: (IdMapR u64 V: String)
        ai9p: u64
        arx609: u64
        for arx609 < call.arguments.count.u64 loop {
            aId: zast.kidAt kids: ast.kids span: call.arguments i: arx609
            arx609 = arx609 + 1
            a: ast.nodes.get i: aId.u64
            if a.namedoperation then {
                slot9p: slots9p.get i: ai9p
                if slot9p < vpn.length then {
                    av: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64)
                    atid: (stampIdOf
                        :symtab
                        nid: (interpPartNodeId n: (ast.nodes.get i: a.operation.u64))
                    )
                    apfx: String
                    chasedColTid: chaseColMono :symtab :ctx tid: atid
                    if (chasedColTid == atid) == false then apfx = "&".string
                    if (isCollectionOriginTid
                        :ctx
                        originTid: (originTidOf :symtab tid: atid)
                    ) then apfx = "&".string
                    if (pathIsPointer
                        :ast
                        :symtab
                        :ctx
                        n: (ast.nodes.get i: a.operation.u64)
                    ) then apfx = "".string
                    fs9p: "\{apfx}\{av}"
                    valBySlot9p.set key: slot9p value: fs9p
                }
                ai9p = ai9p + 1
            }
        }
        pp9p: u64
        ppn9p: vpn.length
        for pp9p < ppn9p loop {
            vo9p: valBySlot9p.get key: pp9p
            match (
                vo9p
            ) case some then {
                dargs.append ", "
                dargs.append vo9p
            } case none then null
            pp9p = pp9p + 1
        }
    } else {
        arx619: u64
        for arx619 < call.arguments.count.u64 loop {
            aId: zast.kidAt kids: ast.kids span: call.arguments i: arx619
            arx619 = arx619 + 1
            a: ast.nodes.get i: aId.u64
            if a.namedoperation then {
                av: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64)
                atid: (stampIdOf
                    :symtab
                    nid: (interpPartNodeId n: (ast.nodes.get i: a.operation.u64))
                )
                apfx: String
                chasedColTidAlt: chaseColMono :symtab :ctx tid: atid
                if (chasedColTidAlt == atid) == false then apfx = "&".string
                if (isCollectionOriginTid :ctx originTid: (originTidOf :symtab tid: atid)) then {
                    apfx = "&".string
                }
                if (pathIsPointer
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                ) then apfx = "".string
                dargs.append ", "
                dargs.append apfx
                dargs.append av
            }
        }
    }
    dslot: cSlotName name: mn
    de: "\{recv}\{acc}vtable->\{dslot}(\{dargs})"
    return de
}

# emitProtocolCreateCall -- `Reader.create from: g.take` (owned, heap-box +
# source invalidation) / `Provider.borrow from: m.borrow` (borrowed, shares the
# source). Both route to the impl's conformance helper for the protocol.
emitProtocolCreateCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    isCreate: false
    if mn == "create" then isCreate = true
    if mn == "borrow" then isCreate = true
    if isCreate == false then return "".string
    protoTid: resolveTypeIdByName :ast :symtab :ctx name: bn
    ptt: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: protoTid.u64)
    isFct: ptt == ztypes.ztypetype.facetType
    if ptt != ztypes.ztypetype.protocolType when isFct == false then return "".string
    suffix: "create_owned".string
    if mn == "borrow" then suffix = "create".string
    # a facet copies its source either way: one helper serves both verbs
    if isFct then suffix = "create".string
    arx629: u64
    for arx629 < call.arguments.count.u64 loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments i: arx629
        arx629 = arx629 + 1
        a: ast.nodes.get i: aId.u64
        if a.namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringView == "from" then {
                fop: ast.nodes.get i: a.operation.u64
                fromBase: atomOrBaseText :ast n: fop
                fdn: stampNameDeep :ast :symtab n: (ast.nodes.get i: a.operation.u64)
                fromTid: (canonTypeId
                    :ast
                    :symtab
                    :ctx
                    tid: (stampIdDeep :ast :symtab n: (ast.nodes.get i: a.operation.u64))
                    name: fdn.stringView
                )
                if fromTid == 0 then return "".string
                implBase: ctxCname :ctx tid: (ztypes.tid.create from: fromTid.u64)
                label: conformanceLabelFor :symtab implTid: fromTid :protoTid
                if label.length == 0 then return "".string
                valueVid: atomVid :symtab nid: (dottedBaseNodeId :ast n: fop)
                if valueVid.isZero then valueVid = (atomVid :symtab nid: (atomNodeId n: fop))
                valVar: aliasResolve :ctx name: fromBase vid: valueVid
                vvv: ztypes.vid
                if valVar.stringView == fromBase then vvv = valueVid
                valVarC: emitLocalAtomName :ctx name: fromBase vid: valueVid
                refPfx: "&".string
                if (isPtrVid :ctx vid: vvv) then refPfx = "".string
                ce: "\{implBase}_\{label}_\{suffix}(\{refPfx}\{valVarC})"
                return ce
            }
        }
    }
    return "".string
}

# emitRecordDefsIn -- three passes so cross-class references resolve: the
# as-block constants and data blocks, then all method forward decls, then all
# method bodies (a method may return/construct a class defined later in the
# unit). Struct layout is NOT emitted here: emitUserStructsOrdered owns it, and
# resolves the by-value ordering between user types and the monos that embed
# them, which a per-unit walk in declaration order cannot.
emitRecordDefsIn: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    mainOpId: zast.nodeid
    phase: u64
    buf: String.borrow
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: mainOpId
    {
        if phase == 1 then {
            vx329: u64
            for vx329 < bodyIds.count.u64 loop {
                bmId: zast.kidAt kids: ast.kids span: bodyIds i: vx329
                vx329 = vx329 + 1
                bm: ast.nodes.get i: bmId.u64
                if bm.namedoperation then {
                    if (isRecordDef n: (ast.nodes.get i: bm.operation.u64)) then {
                        nm: zast.nameTextAt :ast ref: bm.name
                        rid: userFnId :ast :symtab :ctx name: nm.stringView
                        if rid > 0 when (isGenericType :symtab tid: rid) == false then {
                            (emitAsConsts
                                :ast
                                :symtab
                                :ctx
                                tid: rid
                                name: nm.stringView
                                op: (ast.nodes.get i: bm.operation.u64)
                                :buf
                            )
                        }
                    }
                    if (isClassDef n: (ast.nodes.get i: bm.operation.u64)) then {
                        nmc: zast.nameTextAt :ast ref: bm.name
                        cid: userFnId :ast :symtab :ctx name: nmc.stringView
                        if cid > 0 when (isGenericType :symtab tid: cid) == false then {
                            (emitAsConsts
                                :ast
                                :symtab
                                :ctx
                                tid: cid
                                name: nmc.stringView
                                op: (ast.nodes.get i: bm.operation.u64)
                                :buf
                            )
                        }
                    }
                    nm6: zast.nameTextAt :ast ref: bm.name
                    (emitDataBlock
                        :ast
                        :symtab
                        :ctx
                        name: nm6.stringView
                        op: (ast.nodes.get i: bm.operation.u64)
                        :buf
                    )
                }
            }
        }
        if phase == 2 then {
            vx339: u64
            for vx339 < bodyIds.count.u64 loop {
                bmdId: zast.kidAt kids: ast.kids span: bodyIds i: vx339
                vx339 = vx339 + 1
                bmd: ast.nodes.get i: bmdId.u64
                emitDefMethods :ast :symtab :ctx bm: bmd declOnly: true :buf
            }
            vx349: u64
            for vx349 < bodyIds.count.u64 loop {
                biId: zast.kidAt kids: ast.kids span: bodyIds i: vx349
                vx349 = vx349 + 1
                bi: ast.nodes.get i: biId.u64
                if bi.namedoperation then {
                    isImpl: false
                    if (isClassDef n: (ast.nodes.get i: bi.operation.u64)) then isImpl = true
                    if (isRecordDef n: (ast.nodes.get i: bi.operation.u64)) then isImpl = true
                    if isImpl then {
                        nmi7: zast.nameTextAt :ast ref: bi.name
                        iid7: userFnId :ast :symtab :ctx name: nmi7.stringView
                        if iid7 > 0 then {
                            (emitConformanceImplsForType
                                :ast
                                :symtab
                                :ctx
                                implTid: iid7
                                isFacet: false
                                :buf
                            )
                            (emitConformanceImplsForType
                                :ast
                                :symtab
                                :ctx
                                implTid: iid7
                                isFacet: true
                                :buf
                            )
                        }
                    }
                }
            }
            # main-unit function forward decls, after the struct defs (so a generator
            # function returning its synth iter class resolves) and before the method
            # bodies (a synth iterator's call body may call another generator's fn).
            vx359: u64
            for vx359 < bodyIds.count.u64 loop {
                bfdId: zast.kidAt kids: ast.kids span: bodyIds i: vx359
                vx359 = vx359 + 1
                bfd: ast.nodes.get i: bfdId.u64
                if bfd.namedoperation then {
                    if (ztypecheck.isFunctionDefWithBody o: (ast.nodes.get i: bfd.operation.u64)
                    ) then {
                        fdn: zast.nameTextAt :ast ref: bfd.name
                        fdid: userFnId :ast :symtab :ctx name: fdn.stringView
                        isGenFnFD: false
                        if fdid > 0 then {
                            if (isGenericType :symtab tid: fdid) then {
                                if (
                                    (symtab.reg.typetypeOf typeId: fdid) ==
                                    ztypes.ztypetype.functionType
                                ) then {
                                    isGenFnFD = true
                                }
                            }
                        }
                        # a definition that never resolved has no id, and its
                        # forward declaration renders as `z_t0(void)` over unbound
                        # parameter names -- two of them in one unit collide on
                        # return type, which is broken C rather than a diagnostic.
                        # Nothing can call what did not resolve, so there is nothing
                        # to declare.
                        if isGenFnFD == false when fdid > 0 then {
                            fdsig: (fnSignature
                                :ast
                                :symtab
                                :ctx
                                name: fdn.stringView
                                fid: (ztypes.tid.create from: fdid.u64)
                                op: (ast.nodes.get i: bfd.operation.u64)
                            )
                            fdl: "\{fdsig};\n"
                            buf.append fdl
                        }
                    }
                }
            }
        }
        if phase == 3 then {
            vx369: u64
            for vx369 < bodyIds.count.u64 loop {
                bmbId: zast.kidAt kids: ast.kids span: bodyIds i: vx369
                vx369 = vx369 + 1
                bmb: ast.nodes.get i: bmbId.u64
                emitDefMethods :ast :symtab :ctx bm: bmb declOnly: false :buf
            }
        }
    }
}

# emitDataBlock -- `name: data { e0 e1 ... } out T`: a static const array
# z_{name}[], with the element C type from out T (i64 default). Emitted only
# when the block is read at runtime (`.index` / `.array`); labels, ordinals and
# `.length` fold to constants and need no array.
emitDataBlock: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    name: StringView
    op: astnode.view
    buf: String.borrow
} is {
    match (
        op
    ) case expression then {
        emitDataBlock :ast :symtab :ctx :name op: (ast.nodes.get i: op.expression.u64) :buf
    } case datablock then {
        ridtid: stampIdOf :symtab nid: op.nodeid.u64
        ri: false
        {
            runtimeIndexed9v: symtab.reg.isRuntimeIndexedOf tid: ridtid
            ri = runtimeIndexed9v
        }
        if ri then {
            ect: "int64_t".string
            # the element type the CHECKER settled -- `out T`, the elements'
            # own tags, or the i64/f64 default -- not the `out` clause's name:
            # a block typed by its tags emits the same array as one typed by
            # the clause. scalarCTypeFor re-checks the tid for a user shadow.
            etd: symtab.reg.dataElemTypeOf tid: ridtid
            if etd.isZero == false then {
                rbn: regNameOf :symtab tid: etd
                if rbn.length > 0 then {
                    rc: scalarCTypeFor :symtab name: rbn.stringView tid: etd
                    if rc.length > 0 then ect = rc
                }
            }
            elems: String
            cnt: u64
            ei9b: u64
            for ei9b < op.elements.count.u64 loop {
                e: zast.kidAt kids: ast.kids span: op.elements i: ei9b
                ei9b = ei9b + 1
                ev: emitDataElem :ast :symtab :ctx n: (ast.nodes.get i: e.u64)
                if cnt > 0 then elems.append ", "
                elems.append ev
                cnt = cnt + 1
            }
            dsym: ctxCname :ctx tid: ridtid
            l0: "static const \{ect} \{dsym}[] = {\{elems}};\n\n"
            buf.append l0
        }
    } else null
}

# emitDataElem -- a data-block element (a NamedOperation wrapping the
# value atom); emit its inner expression.
emitDataElem: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
} out String is {
    match (
        n
    ) case namedoperation then {
        return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.operation.u64))
    } else {
        return (emitExpr :ast :symtab :ctx :n)
    }
}

# the base type name of data block `oId`.
dataElemBaseName: function {ast: Ast.view oId: zast.nodeid} outx StringView is {
    if oId.isZero then return ""
    return (atomTextDeep :ast n: (ast.nodes.get i: oId.u64))
}

# armTagValueText -- the declared discriminator of the arm named `armNameId`
# on the tagged type `tid`, as a C enumerator initialiser (" = 10"), or "" when
# the type's tag names no value for it.
#
# A `data`-sourced tag names its own values and the enum must carry them, or
# the declaration means nothing past the front end. The tag the compiler
# synthesizes when the author declares none names no values, so its enum keeps
# C's own numbering -- which IS the arm ordinals, the thing every other part of
# the backend already assumes.
armTagValueText: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
    armNameId: u64
} out String is {
    if armNameId == 0 then return "".string
    dt: u64
    {
        d0: symtab.typing.declChildOfId parentTypeId: tid nameId: zast.names.wkTag
        match (
            d0
        ) case some then {
            dt = d0
        } case none then null
    }
    if dt == 0 then return "".string
    c: (symtab.typing.memberConstOf
        parentTypeId: (ztypes.tid.create from: dt.u64)
        nameId: (zast.nameid.create from: armNameId.u32.orPanic)
    )
    if c.kind.ivalKind == false then return "".string
    iv: c.ival
    return " = \{iv}"
}

# checkTagStem -- a variant/union mono's tag ENUMERATORS are spelled from its
# canonical name (`Z_RESULTVAL_U8_CONVERROR_TAG_ERR`) while the type itself is
# spelled from its id, and deliberately so: hand-written runtime fragments name
# the tags literally, and under the default naming the id carries no name at
# all. The scheme therefore holds only while one canonical name means one
# emitted mono -- a typecheck invariant (the specialization trie) that the
# emitter cannot restore, so it says so here rather than handing gcc two
# declarations of one enumerator.
checkTagStem: function {symtab: zenv.ZSymbolTable.view ctx: Ctx tid: ztypes.tid} is {
    tsN: regNameOf :symtab :tid
    tsO: ctx.tagStems.get key: tsN
    match (
        tsO
    ) case some then {
        c1s: ctxCname :ctx tid: (ztypes.tid.create from: tsO.u64)
        c2s: ctxCname :ctx :tid
        mts: "two monos share the name '\{tsN}' (\{c1s}, \{c2s}); their tag enumerators collide"
        emitFail :ctx what: mts line: 0
    } case none then {
        ctx.tagStems.set key: tsN.copy value: tid
    }
}

# emitOneVariant -- tag enum + tagged struct (+ payload union when any
# arm carries one) + the by-tag/value eq helper.
emitOneVariant: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    if (ctx.emittedUserTypes.has item: tid) then return
    ctx.emittedUserTypes.add item: tid.u64
    anames: List String
    aids: ListVal u64
    aidsNm: ListVal u64
    variantArms :ast :symtab :tid names: anames ids: aids nameIds: aidsNm
    # An ARMLESS variant is a constraint-only marker (`anyval`): nothing can
    # ever hold one, and an empty C enum does not compile. emitUnionMono
    # carries the same guard for the union bounds `Any` and `AnyRef`. It did
    # not when this comment first claimed it did, and under `--eager` -- the
    # one mode that reaches a definition nothing references -- that cost every
    # program in the corpus its C.
    if anames.length == 0 then return
    checkTagStem :symtab :ctx :tid
    preEmitEmbeddedTypes :ast :symtab :ctx ids: aids :buf
    vc: ctxCname :ctx :tid
    buf.append "typedef enum {\n"
    ai: u64
    an: anames.length
    for ai < an loop {
        aname: anames.get i: ai
        tg: variantTag :symtab :tid arm: aname.stringView
        tv: armTagValueText :symtab :tid armNameId: (aidsNm.get i: ai)
        lt: "    \{tg}\{tv},\n"
        buf.append lt
        ai = ai + 1
    }
    le: "} \{vc}_tag_t;\n"
    buf.append le
    # An ORDINAL is its own discriminator. The struct would hold the tag and
    # nothing else, so the type IS the tag's storage -- the enum stays for the
    # constants, which are the arm ordinals. Comparison is `==` (binopKeyOf
    # routes it to @scalar), so there is no comparator to emit either.
    ovc: ordinalVariantCType :symtab :tid
    if ovc.length > 0 then {
        lo: "typedef \{ovc} \{vc}_t;\n"
        buf.append lo
        return
    }
    buf.append "typedef struct {\n"
    tsc: tagStorageCType :symtab :tid
    if tsc.length == 0 then {
        lfE: "    \{vc}_tag_t tag;\n"
        buf.append lfE
    } else {
        lfD: "    \{tsc} tag;\n"
        buf.append lfD
    }
    haveP: false
    pj: u64
    for pj < an loop {
        pname: anames.get i: pj
        pc: armPayloadC :ast :symtab :ctx :tid arm: pname.stringView
        if pc.length > 0 then {
            if haveP == false then {
                haveP = true
                buf.append "    union {\n"
            }
            pnameP: memberCPrefix name: pname.stringView
            lp: "        \{pc} \{pnameP}\{pname};\n"
            buf.append lp
        }
        pj = pj + 1
    }
    if haveP then buf.append "    } data;\n"
    lg: "} \{vc}_t;\n"
    buf.append lg
    lq: "static bool \{vc}_eq(\{vc}_t a, \{vc}_t b) {\n"
    buf.append lq
    if haveP then {
        buf.append "    if (a.tag != b.tag) return false;\n"
        buf.append "    switch (a.tag) {\n"
        qk: u64
        for qk < an loop {
            qname: anames.get i: qk
            qnameId: (zast.nameid.create from: (aidsNm.get i: qk))
            qc: armPayloadC :ast :symtab :ctx :tid arm: qname.stringView
            if qc.length > 0 then {
                qtg: variantTag :symtab :tid arm: qname.stringView
                qco: symtab.typing.declChildOfId parentTypeId: tid nameId: qnameId
                qeq: String
                match (
                    qco
                ) case some then {
                    # a typedef arm compares as its chain-end base
                    qcoC: typedefChaseTid :symtab tid: (ztypes.tid.create from: qco.u64)
                    qtn: regNameOf :symtab tid: qcoC
                    qsc: scalarCTypeFor :symtab name: qtn.stringView tid: qcoC
                    if qsc.length == 0 then {
                        qrid: canonTypeId :ast :symtab :ctx tid: qcoC name: qtn.stringView
                        if qrid > 0 then {
                            qtt: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: qrid.u64)
                            isAgg: false
                            if qtt == ztypes.ztypetype.recordType then isAgg = true
                            if qtt == ztypes.ztypetype.variantType then isAgg = true
                            if isAgg then {
                                qrc: ctxCname :ctx tid: (ztypes.tid.create from: qrid.u64)
                                qnameP: memberCPrefix name: qname.stringView
                                qe: "\{qrc}_eq(a.data.\{qnameP}\{qname}, b.data.\{qnameP}\{qname})"
                                qeq.append qe
                            }
                        }
                    }
                } case none then null
                if qeq.length == 0 then {
                    qname2P: memberCPrefix name: qname.stringView
                    qe2: "a.data.\{qname2P}\{qname} == b.data.\{qname2P}\{qname}"
                    qeq.append qe2
                }
                lr: "        case \{qtg}: return \{qeq};\n"
                buf.append lr
            }
            qk = qk + 1
        }
        buf.append "        default: return true;\n"
        buf.append "    }\n"
    } else {
        buf.append "    return a.tag == b.tag;\n"
    }
    buf.append "}\n\n"
}

# objectDefIsKind -- the node defines an object of that kind. The four
# predicates below differ in the kind alone.
objectDefIsKind: function {n: astnode.view kind: zast.objectkind} out bool is {
    if n.objectdef then return n.kind == kind
    return false
}

# true when `n` is a class definition. A generator is one: its `is` fields are
# a class's fields and its `call` is a method, so it emits through the same path.
isClassDef: function {n: astnode.view} out bool is {
    if (objectDefIsKind :n kind: zast.objectkind.classDef) then return true
    return (objectDefIsKind :n kind: zast.objectkind.generatorDef)
}

# true when `n` is a record definition.
isRecordDef: function {n: astnode.view} out bool is {
    return (objectDefIsKind :n kind: zast.objectkind.recordDef)
}

# true when `n` is a variant definition.
isVariantDef: function {n: astnode.view} out bool is {
    return (objectDefIsKind :n kind: zast.objectkind.variantDef)
}

# whether a node defines a union, which decides whether its arms may carry
# reftypes
isUnionDef: function {n: astnode.view} out bool is {
    return (objectDefIsKind :n kind: zast.objectkind.unionDef)
}

# structDestroyNontrivial -- the type's destructor frees at least one field.
# Mirrors emitStructDestructor's per-field tests (String, destructible
# aggregate, heap-ptr collection; borrowed fields never free). Gates call-site
# destroys for loop-owned iterator instances: an all-borrowed iterator has
# nothing to free and keeps its emission unchanged.
structDestroyNontrivial: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    fids: ListVal u64
    fidsNm: ListVal u64
    recFieldIds :symtab :tid ids: fids nameIds: fidsNm
    fi: u64
    fn0: fids.length
    for fi < fn0 loop {
        fid: fids.get i: fi
        fnameId: fidsNm.get i: fi
        if (
            (symtab.typing.declIsBorrowedFieldId
                parentTypeId: tid
                nameId: (zast.nameid.create from: fnameId.u32.orPanic)
            ) ==
            false
        ) then {
            if fid == ctx.strTid then return true
            fmid: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: fid.u64)
            if (symtab.reg.needsDestructor typeId: fmid) then return true
            if (isHeapPtrCollection
                :symtab
                :ctx
                tid: (ztypes.tid.create from: fid.u64)
            ) then return true
        }
        fi = fi + 1
    }
    return false
}

# emitStructDestructor -- a record/class destructor freeing each heap-owning
# field: String fields via the String free, aggregate fields with a destructor
# recursively; scalars are skipped. Emitted only when the type has a destructor.
# structDestroyNontrivial mirrors the per-field tests below -- keep them in sync.
emitStructDestructor: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
    fnames: (List String).view
    fids: (ListVal u64).view
    buf: String.borrow
} is {
    rc: ctxCname :ctx :tid
    d0: "static void \{rc}_destroy(\{rc}_t* p);\n"
    buf.append d0
    d1: "static void \{rc}_destroy(\{rc}_t* p) {\n"
    buf.append d1
    buf.append "    if (!p) return;\n"
    fi: u64
    fn0: fnames.length
    for fi < fn0 loop {
        fname: fnames.get i: fi
        fid: fids.get i: fi
        # a borrowed field is a borrowed pointer -- never freed by the destructor.
        if (
            (symtab.typing.declIsBorrowedField
                pool: ast.names
                parentTypeId: tid
                name: fname.stringView
            ) ==
            false
        ) then {
            if fid == ctx.strTid then {
                dsP: memberCPrefix name: fname.stringView
                ds: "    \{ctx.strC}_free(&p->\{dsP}\{fname});\n"
                buf.append ds
            } else {
                fmid: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: fid.u64)
                fneeds: false
                if (symtab.reg.needsDestructor typeId: fmid) then fneeds = true
                if (isHeapPtrCollection
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: fid.u64)
                ) then fneeds = true
                if fneeds then {
                    fcb: ctxCname :ctx tid: (ztypes.tid.create from: fmid.u64)
                    if (isHeapPtrCollection
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: fid.u64)
                    ) then {
                        dfP: memberCPrefix name: fname.stringView
                        df: "    \{fcb}_destroy(p->\{dfP}\{fname});\n"
                        buf.append df
                    } else {
                        df2P: memberCPrefix name: fname.stringView
                        df2: "    \{fcb}_destroy(&p->\{df2P}\{fname});\n"
                        buf.append df2
                    }
                }
            }
        }
        fi = fi + 1
    }
    buf.append "}\n\n"
}

# borrowedFieldIsReftypePtr -- a borrowed field is stored as a pointer to its container
# only when that container is a reftype (class/union); a protocol lock is the fat
# pointer by value, and a valtype lock (a bidirectional generator's bool resume
# input) is stored by value.
borrowedFieldIsReftypePtr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    fid: ztypes.tid
} out bool is {
    ftn: regNameOf :symtab tid: fid
    ftid: canonTypeId :ast :symtab :ctx tid: fid name: ftn.stringView
    if ftid == 0 then ftid = fid
    tt: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: ftid.u64)
    if tt == ztypes.ztypetype.classType then return true
    if tt == ztypes.ztypetype.unionType then return true
    return false
}

# emit one record's C struct.
emitOneRecord: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    if (ctx.emittedUserTypes.has item: tid) then return
    ctx.emittedUserTypes.add item: tid.u64
    if (isTypedefType :symtab :tid) then return
    fnames: List String
    fids: ListVal u64
    fidsNm: ListVal u64
    recFieldLists :ast :symtab :tid names: fnames ids: fids nameIds: fidsNm
    # A FIELDLESS record/class is a synthesized carrier -- a data block's
    # `tag__{elem}`, a marker type declared `is native` -- and an empty struct
    # is not C. Same rule as the armless variant above, for the same reason:
    # nothing can hold one, so emit nothing rather than invalid C.
    if fnames.length == 0 then return
    preEmitEmbeddedTypes :ast :symtab :ctx ids: fids :buf
    rc: ctxCname :ctx :tid
    if (isFwdDeclared :ctx :tid) then {
        lopenR: "struct \{rc}_t {\n"
        buf.append lopenR
    } else {
        buf.append "typedef struct {\n"
    }
    fi: u64
    fn0: fnames.length
    for fi < fn0 loop {
        fname: fnames.get i: fi
        fid: fids.get i: fi
        fnameId: fidsNm.get i: fi
        fct: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: fid.u64) thisTid: ztypes.tid
        if fct.length == 0 then fct = "int64_t".string
        # a borrowed field borrows the container: protocol-typed -> fat pointer by
        # value; class-typed -> a pointer to the container.
        if (symtab.typing.declIsBorrowedFieldId
            parentTypeId: tid
            nameId: (zast.nameid.create from: fnameId.u32.orPanic)
        ) then {
            if (borrowedFieldIsReftypePtr
                :ast
                :symtab
                :ctx
                fid: (ztypes.tid.create from: fid.u64)
            ) then fct = "\{fct}*"
        }
        if (isHeapPtrCollection
            :symtab
            :ctx
            tid: (ztypes.tid.create from: fid.u64)
        ) then fct = "\{fct}*"
        fnameP: memberCPrefix name: fname.stringView
        l1: "    \{fct} \{fnameP}\{fname};\n"
        buf.append l1
        fi = fi + 1
    }
    if (isFwdDeclared :ctx :tid) then {
        buf.append "};\n"
    } else {
        l2: "} \{rc}_t;\n"
        buf.append l2
    }
    params: String
    inits: String
    fj: u64
    for fj < fn0 loop {
        fname2: fnames.get i: fj
        fid2: fids.get i: fj
        fname2Id: fidsNm.get i: fj
        fct2: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: fid2.u64) thisTid: ztypes.tid
        if fct2.length == 0 then fct2 = "int64_t".string
        # a borrowed field's meta_create param matches the field (protocol by value).
        if (symtab.typing.declIsBorrowedFieldId
            parentTypeId: tid
            nameId: (zast.nameid.create from: fname2Id.u32.orPanic)
        ) then {
            if (borrowedFieldIsReftypePtr
                :ast
                :symtab
                :ctx
                fid: (ztypes.tid.create from: fid2.u64)
            ) then fct2 = "\{fct2}*"
        }
        if (isHeapPtrCollection
            :symtab
            :ctx
            tid: (ztypes.tid.create from: fid2.u64)
        ) then fct2 = "\{fct2}*"
        if fj > 0 then {
            params.append ", "
            inits.append ", "
        }
        fname2P: memberCPrefix name: fname2.stringView
        params.append fct2
        params.append " "
        params.append fname2P
        params.append fname2
        inits.append fname2P
        inits.append fname2
        fj = fj + 1
    }
    l3: "static \{rc}_t \{rc}_meta_create(\{params}) {\n"
    buf.append l3
    l4: "    \{rc}_t _this = { \{inits} };\n"
    buf.append l4
    buf.append "    return _this;\n"
    buf.append "}\n"
    aliasOk: (definedInNonMain :symtab :ctx :tid) == false
    if aliasOk when (typeHasNativeCreate :symtab :tid) == false then {
        l5: "#define \{rc}_create \{rc}_meta_create\n"
        buf.append l5
    }
    skipEqR: false
    if (symtab.reg.typetypeOf typeId: tid) == ztypes.ztypetype.classType then skipEqR = true
    if skipEqR == false then {
        lq: "static bool \{rc}_eq(\{rc}_t a, \{rc}_t b) {\n"
        buf.append lq
        if fn0 == 0 then {
            buf.append "    (void)a; (void)b;\n"
            buf.append "    return true;\n"
        } else {
            eqx: String
            fk: u64
            for fk < fn0 loop {
                fkn: fnames.get i: fk
                fki: fids.get i: fk
                if fk > 0 then eqx.append " && "
                fkiC: typedefChaseTid :symtab tid: (ztypes.tid.create from: fki.u64)
                ftn: regNameOf :symtab tid: fkiC
                fscalar: scalarCTypeFor :symtab name: ftn.stringView tid: fkiC
                fdone: false
                if fscalar.length == 0 then {
                    frid: canonTypeId :ast :symtab :ctx tid: fkiC name: ftn.stringView
                    if frid > 0 then {
                        ftt: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: frid.u64)
                        isAggF: false
                        if ftt == ztypes.ztypetype.recordType then isAggF = true
                        if ftt == ztypes.ztypetype.variantType then isAggF = true
                        if isAggF then {
                            frc: ctxCname :ctx tid: (ztypes.tid.create from: frid.u64)
                            fknP: memberCPrefix name: fkn.stringView
                            fe: "\{frc}_eq(a.\{fknP}\{fkn}, b.\{fknP}\{fkn})"
                            eqx.append fe
                            fdone = true
                        }
                    }
                }
                if fdone == false then {
                    fkn2P: memberCPrefix name: fkn.stringView
                    fe2: "a.\{fkn2P}\{fkn} == b.\{fkn2P}\{fkn}"
                    eqx.append fe2
                }
                fk = fk + 1
            }
            lr: "    return \{eqx};\n"
            buf.append lr
        }
        buf.append "}\n\n"
    }
    # `needsDestructor` is a flag STAMPED at check time; for a generator's synth
    # iterator class it is computed from the parameters alone, so a class whose
    # only owned field is a promoted LOCAL carries false and its local was never
    # freed. structDestroyNontrivial reads the REAL field types here at emit
    # time, so it is the accurate authority -- ask it too.
    wantDtor: false
    if (symtab.reg.needsDestructor typeId: tid) then wantDtor = true
    if wantDtor == false then {
        if (structDestroyNontrivial :symtab :ctx :tid) then wantDtor = true
    }
    if wantDtor then {
        emitStructDestructor :ast :symtab :ctx :tid :fnames :fids :buf
    }
}


# emitAsConsts -- a record/class `as`-block plain constant (`as { version: 1 }`)
# becomes a `static const` read as `Type.label` (see the Type.constlabel leg in
# emitExpr). Const items are the markAsConstClone children; methods/markers skip.
emitAsConsts: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
    name: StringView
    op: astnode.view
    buf: String.borrow
} is {
    if op.objectdef then {
        asx1709: u64
        for asx1709 < op.asItems.count.u64 loop {
            amId: zast.kidAt kids: ast.kids span: op.asItems i: asx1709
            asx1709 = asx1709 + 1
            am: ast.nodes.get i: amId.u64
            if am.namedoperation then {
                albl: zast.nameTextAt :ast ref: am.name
                cco: (symtab.typing.declChildOf
                    pool: ast.names
                    parentTypeId: tid
                    name: albl.stringView
                )
                match (
                    cco
                ) case some then {
                    if (symtab.typing.isAsConstClone typeId: (ztypes.tid.create from: cco.u64)
                    ) then {
                        cv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: am.operation.u64)
                        if cv.length > 0 then {
                            ctA: "int64_t".string
                            vtidA: (stampIdOf
                                :symtab
                                nid: (interpPartNodeId n: (ast.nodes.get i: am.operation.u64))
                            )
                            if vtidA > 0 then {
                                vtnA: regNameOf :symtab tid: vtidA
                                vtcA: (scalarCTypeFor
                                    :symtab
                                    name: vtnA.stringView
                                    tid: vtidA
                                )
                                if vtcA.length > 0 then ctA = vtcA
                            }
                            qnA: "\{name}.\{albl}"
                            csymA: cnameOf :tid ownerName: "" name: qnA.stringView
                            lA: "static const \{ctA} \{csymA} = \{cv};\n"
                            buf.append lA
                        }
                    }
                } case none then null
            }
        }
    }
}

# emitClassMonoMethods -- emit every specialization's bodied methods for a
# generic class template: the clone's FUNCTION id supplies the substituted
# signature and the template item supplies the body (the unit-mono pattern).
emitClassMonoMethods: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    tplId: ztypes.tid
    op: astnode.view
    declOnly: bool
    buf: String.borrow
} is {
    if op.objectdef then {
        last8: symtab.reg.nextTypeId
        t8: u64
        for t8 < last8 loop {
            isMono8: false
            go8opt: symtab.reg.genericOriginOf tid: (ztypes.tid.create from: t8.u64)
            if go8opt.u64 == tplId when go8opt > 0 then isMono8 = true
            if isMono8 then {
                isx1889: u64
                for isx1889 < op.isItems.count.u64 loop {
                    am8Id: zast.kidAt kids: ast.kids span: op.isItems i: isx1889
                    isx1889 = isx1889 + 1
                    am8: ast.nodes.get i: am8Id.u64
                    if am8.namedoperation then {
                        if (ztypecheck.isFunctionDefWithBody o: (ast.nodes.get i: am8.operation.u64)
                        ) then {
                            mn8: zast.nameTextAt :ast ref: am8.name
                            co8: (symtab.typing.declChildOf
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: t8.u64)
                                name: mn8.stringView
                            )
                            match (
                                co8
                            ) case some then {
                                cf8: co8
                                if (
                                    (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: cf8.u64)
                                    ) ==
                                    ztypes.ztypetype.functionType
                                ) then {
                                    fn8: (regNameOf
                                        :symtab
                                        tid: (ztypes.tid.create from: cf8.u64)
                                    )
                                    sg8: (fnSignature
                                        :ast
                                        :symtab
                                        :ctx
                                        name: fn8.stringView
                                        fid: (ztypes.tid.create from: cf8.u64)
                                        op: (ast.nodes.get i: am8.operation.u64)
                                    )
                                    if declOnly then {
                                        ld8: "\{sg8};\n"
                                        buf.append ld8
                                    } else {
                                        lo8: "\{sg8} {\n"
                                        buf.append lo8
                                        ctx.ptrVids = ListVal ztypes.vid
                                        ctx.aliases = List VidVal
                                        ctx.narrowBox = List VidVal
                                        ctx.narrowTid = List VidTid
                                        ctx.exclArms = List VidVal
                                        ctx.exclTids = List VidTid
                                        (registerReftypeParams
                                            :ast
                                            :symtab
                                            :ctx
                                            fid: (ztypes.tid.create from: cf8.u64)
                                            op: (ast.nodes.get i: am8.operation.u64)
                                        )
                                        ctx.curThisTid = ztypes.tid.create from: t8
                                        (emitFnBody
                                            :ast
                                            :symtab
                                            :ctx
                                            op: (ast.nodes.get i: am8.operation.u64)
                                            fid: (ztypes.tid.create from: cf8.u64)
                                            :buf
                                        )
                                        ctx.curThisTid = ztypes.tid.create from: 0
                                        buf.append "}\n\n"
                                    }
                                }
                            } case none then null
                        }
                    }
                }
                asx1719: u64
                for asx1719 < op.asItems.count.u64 loop {
                    am8bId: zast.kidAt kids: ast.kids span: op.asItems i: asx1719
                    asx1719 = asx1719 + 1
                    am8b: ast.nodes.get i: am8bId.u64
                    if am8b.namedoperation then {
                        if (ztypecheck.isFunctionDefWithBody
                            o: (ast.nodes.get i: am8b.operation.u64)
                        ) then {
                            mn8b: zast.nameTextAt :ast ref: am8b.name
                            co8b: (symtab.typing.declChildOf
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: t8.u64)
                                name: mn8b.stringView
                            )
                            match (
                                co8b
                            ) case some then {
                                cf8b: co8b
                                if (
                                    (symtab.reg.typetypeOf
                                        typeId: (ztypes.tid.create from: cf8b.u64)
                                    ) ==
                                    ztypes.ztypetype.functionType
                                ) then {
                                    fn8b: (regNameOf
                                        :symtab
                                        tid: (ztypes.tid.create from: cf8b.u64)
                                    )
                                    sg8b: (fnSignature
                                        :ast
                                        :symtab
                                        :ctx
                                        name: fn8b.stringView
                                        fid: (ztypes.tid.create from: cf8b.u64)
                                        op: (ast.nodes.get i: am8b.operation.u64)
                                    )
                                    if declOnly then {
                                        ld8b: "\{sg8b};\n"
                                        buf.append ld8b
                                    } else {
                                        lo8b: "\{sg8b} {\n"
                                        buf.append lo8b
                                        ctx.ptrVids = ListVal ztypes.vid
                                        ctx.aliases = List VidVal
                                        ctx.narrowBox = List VidVal
                                        ctx.narrowTid = List VidTid
                                        ctx.exclArms = List VidVal
                                        ctx.exclTids = List VidTid
                                        (registerReftypeParams
                                            :ast
                                            :symtab
                                            :ctx
                                            fid: (ztypes.tid.create from: cf8b.u64)
                                            op: (ast.nodes.get i: am8b.operation.u64)
                                        )
                                        ctx.curThisTid = ztypes.tid.create from: t8
                                        (emitFnBody
                                            :ast
                                            :symtab
                                            :ctx
                                            op: (ast.nodes.get i: am8b.operation.u64)
                                            fid: (ztypes.tid.create from: cf8b.u64)
                                            :buf
                                        )
                                        ctx.curThisTid = ztypes.tid.create from: 0
                                        buf.append "}\n\n"
                                    }
                                }
                            } case none then null
                        }
                    }
                }
            }
            t8 = t8 + 1
        }
    }
}

# emitRecordMethods -- the record's as-block functions as free C
# functions taking the record by value (params from the method type's
# children; the AST return fallback covers unstamped returns).
emitRecordMethods: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    tid: ztypes.tid
    op: astnode.view
    declOnly: bool
    buf: String.borrow
} is {
    if (isGenericType :symtab :tid) then {
        (emitClassMonoMethods
            :ast
            :symtab
            :ctx
            tplId: (ztypes.tid.create from: tid.u64)
            :op
            :declOnly
            :buf
        )
        return
    }
    if op.objectdef then {
        idxs: ListVal u64
        names: List String
        ai: u64
        asx1729: u64
        for asx1729 < op.asItems.count.u64 loop {
            amId: zast.kidAt kids: ast.kids span: op.asItems i: asx1729
            asx1729 = asx1729 + 1
            am: ast.nodes.get i: amId.u64
            if am.namedoperation then {
                if (ztypecheck.isFunctionDefWithBody o: (ast.nodes.get i: am.operation.u64)) then {
                    av: ai
                    idxs.append av
                    an: zast.nameTextCopy :ast ref: am.name
                    names.append an
                }
            }
            ai = ai + 1
        }
        wi: u64
        wn: idxs.length
        for wi < wn loop {
            midx: idxs.get i: wi
            mname: names.get i: wi
            am2Id: zast.kidAt kids: ast.kids span: op.asItems i: midx
            am2: ast.nodes.get i: am2Id.u64
            if am2.namedoperation then {
                mo: (symtab.typing.declChildOf
                    pool: ast.names
                    parentTypeId: tid
                    name: mname.stringView
                )
                match (
                    mo
                ) case some then {
                    (emitOneMethod
                        :ast
                        :symtab
                        :ctx
                        mid: (ztypes.tid.create from: mo.u64)
                        thisTid: tid
                        op: (ast.nodes.get i: am2.operation.u64)
                        :declOnly
                        :buf
                    )
                } case none then null
            }
            wi = wi + 1
        }
        iidxs: ListVal u64
        inames: List String
        iai: u64
        isx1899: u64
        for isx1899 < op.isItems.count.u64 loop {
            im9Id: zast.kidAt kids: ast.kids span: op.isItems i: isx1899
            isx1899 = isx1899 + 1
            im: ast.nodes.get i: im9Id.u64
            if im.namedoperation then {
                if (ztypecheck.isFunctionDefWithBody o: (ast.nodes.get i: im.operation.u64)) then {
                    iav: iai
                    iidxs.append iav
                    ian: zast.nameTextCopy :ast ref: im.name
                    inames.append ian
                }
            }
            iai = iai + 1
        }
        iwi: u64
        iwn: iidxs.length
        for iwi < iwn loop {
            imidx: iidxs.get i: iwi
            imname: inames.get i: iwi
            im2Id: zast.kidAt kids: ast.kids span: op.isItems i: imidx
            im2: ast.nodes.get i: im2Id.u64
            if im2.namedoperation then {
                imo: (symtab.typing.declChildOf
                    pool: ast.names
                    parentTypeId: tid
                    name: imname.stringView
                )
                match (
                    imo
                ) case some then {
                    (emitOneMethod
                        :ast
                        :symtab
                        :ctx
                        mid: (ztypes.tid.create from: imo.u64)
                        thisTid: tid
                        op: (ast.nodes.get i: im2.operation.u64)
                        :declOnly
                        :buf
                    )
                } case none then null
            }
            iwi = iwi + 1
        }
    }
}

# nodeYieldCount -- the number of `yield` expressions in a subtree (yields do
# not nest). Used to detect a generator `call` body and size its resume-state
# switch.
nodeYieldCount: function {ast: Ast.view n: astnode.view} out u64 is {
    return (zast.yieldCountOf :ast :n)
}

# fnYieldCount -- yields in a functiondef body (0 for a non-generator).
fnYieldCount: function {ast: Ast.view op: astnode.view} out u64 is {
    match (
        op
    ) case functiondef then {
        if op.body.isZero then return 0
        return (nodeYieldCount :ast n: (ast.nodes.get i: op.body.u64))
    } else {
        return 0
    }
}

# setupGenCtx -- arm the generator state-machine context on ctx when `op` is a
# generator `call` (its body yields). Resolves the optionval wrapper from the
# method's return type. Returns false (and disarms) for a normal method.
setupGenCtx: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    mid: ztypes.tid
    op: astnode.view
} out bool is {
    gyc: fnYieldCount :ast :op
    if gyc == 0 then {
        ctx.genActive = false
        return false
    }
    rid: fnReturnTidOf :symtab tid: mid
    if rid == 0 then {
        mro: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: mid.u64)
        match (
            mro
        ) case some then {
            rid = mro
        } case none then null
    }
    if rid == 0 then {
        ctx.genActive = false
        return false
    }
    rn: regNameOf :symtab tid: (ztypes.tid.create from: rid.u64)
    ru: cUpperOf text: rn.stringView
    rc: ctxCname :ctx tid: (ztypes.tid.create from: rid.u64)
    ctx.genActive = true
    ctx.genYieldCount = gyc
    ctx.genYieldNext = 1
    ctx.genForNext = 0
    for ctx.genForSpills.length > 0 loop ctx.genForSpills.pop
    ctx.genWrap = "\{rc}_t"
    ctx.genSomeTag = "Z_\{ru}_TAG_SOME"
    ctx.genNoneTag = "Z_\{ru}_TAG_NONE"
    # a reftype element wraps in Option: the yield leg boxes the payload
    # (emitOptionalAssign's malloc'd-box shape); valtype wrappers stay inline.
    gp: String
    if (originIsTid
        :symtab
        tid: (ztypes.tid.create from: rid.u64)
        originTid: (ctx.origins.get i: ogOption)
    ) then {
        gp = armPayloadC :ast :symtab :ctx tid: (ztypes.tid.create from: rid.u64) arm: "some"
    }
    ctx.genPayC = gp
    # a `.call` that receives a per-call input is one with a SECOND parameter --
    # the receiver is first. Asked by position rather than by the label, because
    # the label belongs to the author: the function form always spelled it
    # `value`, and a declared generator spells it whatever its call sites read.
    hasVal: false
    if op.functiondef then {
        pcnt: u64
        pax1499: u64
        for pax1499 < op.parameters.count.u64 loop {
            pm9Id: zast.kidAt kids: ast.kids span: op.parameters i: pax1499
            pax1499 = pax1499 + 1
            pm: ast.nodes.get i: pm9Id.u64
            if pm.namedoperation then pcnt = pcnt + 1
        }
        if pcnt > 1 then hasVal = true
    }
    ctx.genHasValue = hasVal
    return true
}

# emitGenPrologue -- the resume dispatch: switch on this->state to L_entry / the
# per-yield resume labels / L_done.
emitGenPrologue: function {ctx: Ctx.view buf: String.borrow} is {
    if ctx.genHasValue then {
        lgv: "    \{ctx.genRecvC}->_resume_input = \{ctx.genValC};\n"
        buf.append lgv
    }
    lgs: "    switch (\{ctx.genRecvC}->state) {\n"
    buf.append lgs
    buf.append "        case 0: goto L_entry;\n"
    k: 1.u64
    for k <= ctx.genYieldCount loop {
        lk: "        case \{k}: goto L_resume_\{k};\n"
        buf.append lk
        k = k + 1
    }
    buf.append "        default: goto L_done;\n"
    buf.append "    }\n"
    buf.append "L_entry:;\n"
}

# emitGenEpilogue -- the terminal landing: mark done and return the NONE wrapper.
emitGenEpilogue: function {ctx: Ctx.view buf: String.borrow} is {
    # a yield the body counted but never emitted -- one made unreachable by a
    # bare `return` before it -- still has a `case` in the resume switch, and a
    # switch arm jumping to a label that was never written is C that does not
    # compile. Land those on the terminal state: an unreachable yield can never
    # be the state the machine suspended at, so resuming into it is done.
    kd: ctx.genYieldNext
    for kd <= ctx.genYieldCount loop {
        ld: "L_resume_\{kd}:;\n"
        buf.append ld
        kd = kd + 1
    }
    buf.append "L_done:;\n"
    lge: "    \{ctx.genRecvC}->state = -1;\n"
    buf.append lge
    le: "    \{ctx.genWrap} _r_done = {0};\n"
    buf.append le
    lt: "    _r_done.tag = \{ctx.genNoneTag};\n"
    buf.append lt
    buf.append "    return _r_done;\n"
}

# isYieldNode -- the node (through expression wrappers) is a yield expression.
isYieldNode: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case expression then {
        return (isYieldNode :ast n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (isYieldNode :ast n: (ast.nodes.get i: n.statementline.u64))
    } case call then {
        return (zast.isYieldCalleeAt :ast callableId: n.callable)
    } else {
        return false
    }
}

# emitYieldFromNode -- emit the suspension for a yield reached through expression
# wrappers (the expression-form `name: yield E`).
emitYieldFromNode: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    match (
        n
    ) case expression then {
        iexF: ast.nodes.get i: n.expression.u64
        emitYieldFromNode :ast :symtab :ctx n: iexF :ind :tmp :buf
    } case call then {
        emitYieldStmt :ast :symtab :ctx callId: n.nodeid :ind :buf
    } else null
}

# emitExprFormYield -- `name: yield E` in a bidirectional generator: suspend
# (yield E), then bind name to the resume input the next `.call value:` provides.
# A valtype binds the value directly; a borrowed reftype binds a pointer alias.
emitExprFormYield: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    value: astnode.view
    aid: u64
    nm: StringView
    nmVid: ztypes.vid
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    # the hoist has already suspended this yield and left the resume value in
    # a temp; only a yield it declined (no resume type it could name) still
    # needs suspending here
    srcC: "\{ctx.genRecvC}->_resume_input"
    {
        ycid: zast.yieldCallIdAt :ast nid: (zast.nodeIdOf n: value)
        ykq: ctx.yieldTempK.get key: ycid.u64
        match (
            ykq
        ) case some then {
            srcC = "\{ctx.genRecvC}->_yv_\{ykq}"
        } case none then {
            emitYieldFromNode :ast :symtab :ctx n: value :ind :tmp :buf
        }
    }
    ltid: stampIdOf :symtab nid: aid
    cTypeText: typeRefC :ast :symtab :ctx tid: ltid thisTid: ztypes.tid
    if cTypeText.length == 0 then cTypeText = "int64_t".string
    tt: symtab.reg.typetypeOf typeId: ltid
    isRef: false
    if tt == ztypes.ztypetype.classType then isRef = true
    if tt == ztypes.ztypetype.unionType then isRef = true
    if isRef then {
        lp0: "\{ind}\{cTypeText}* __borrow_\{nm} = \{srcC};\n"
        buf.append lp0
        lp1: "\{ind}/* alias: \{nm} => (*__borrow_\{nm}) */\n"
        buf.append lp1
        atomVarId: "(*__borrow_\{nm})"
        vvSet xs: ctx.aliases vid: nmVid val: atomVarId.stringView
    } else {
        # bind the name TO ITS SLOT rather than copying it into a C local.
        # `a: yield 1` used after a later suspension read a dead local before
        # this -- silently, and long before expression-position yield existed:
        # crossingLocals excludes every `name: yield E` binding from promotion
        # (a REFTYPE resume value is an alias into the caller's storage and a
        # stored pointer would dangle), and for a valtype that left the value
        # in a local the next `return` threw away. The slot is a field, so it
        # survives, and the reftype path above is untouched.
        slotted: false
        {
            ycid2: zast.yieldCallIdAt :ast nid: (zast.nodeIdOf n: value)
            if (ctx.yieldTempK.has key: ycid2.u64) then slotted = true
        }
        if slotted then {
            lp3: "\{ind}/* alias: \{nm} => \{srcC} */\n"
            buf.append lp3
            vvSet xs: ctx.aliases vid: nmVid val: srcC.stringView
        } else {
            lp2: "\{ind}\{cTypeText} \{nm} = \{srcC};\n"
            buf.append lp2
        }
    }
}

# hoistStopsHere -- descent for the expression-yield hoist stops at anything
# whose evaluation is CONDITIONAL or REPEATED: a clause body, a loop, a `with`
# body, a nested definition. A yield there is a statement in its own right and
# emitStmt reaches it on that path; hoisting it would run the suspension
# whether or not the branch is taken.
hoistStopsHere: function {n: astnode.view} out bool is {
    match (
        n
    ) case statement then {
        return true
    } case ifexpr then {
        return true
    } case ifclause then {
        return true
    } case forexpr then {
        return true
    } case caseexpr then {
        return true
    } case caseclause then {
        return true
    } case withexpr then {
        return true
    } case doexpr then {
        return true
    } case functiondef then {
        return true
    } case objectdef then {
        return true
    } case unitdef then {
        return true
    } else {
        return false
    }
}

# hoistExprYields -- emit, as their own statements, the suspensions for every
# yield written in EXPRESSION position inside `nid`, binding each resume value
# to a temp the expression emitter then reads.
#
# A yield SUSPENDS the function: everything before it must already have run,
# and what follows resumes at a label. It cannot sit in the middle of a C
# expression, so the statement is split around it -- `b: (yield a) + 1` becomes
# the suspension, then `b = _yv_k + 1`.
#
# Operands are hoisted before the yield that contains them (post-order), which
# is the order they evaluate in, so `yield (yield a)` suspends innermost-first.
hoistExprYields: function {
    # the tree the statement's shape is walked from
    ast: Ast.view
    # read for each yield's resume TYPE, which the temp is declared with
    symtab: zenv.ZSymbolTable.view
    # carries the state-machine cursor, and takes the temp each hoist records
    ctx: Ctx
    # the statement, or the sub-expression of one, to lift yields out of
    nid: zast.nodeid
    # the indent the hoisted statements are written at
    ind: StringView
    # the function body being built; the suspensions append here, ahead of the
    # statement whose expression they were lifted from
    buf: String.borrow
} is {
    if nid.isZero then return
    {
        n: ast.nodes.get i: nid.u64
        # an `if`'s FIRST clause's FIRST condition is the one part of it that
        # runs unconditionally and exactly once, so it hoists like any other
        # expression. Every later condition is guarded by the ones before it
        # (`when` short-circuits) and every body is guarded by all of them, so
        # the descent goes no further.
        if n.ifexpr then {
            if n.clauses.count.u64 > 0 then {
                c0: ast.nodes.get i: (zast.kidAt kids: ast.kids span: n.clauses i: 0).u64
                if c0.ifclause then {
                    if c0.conditions.count.u64 > 0 then (hoistExprYields
                        :ast
                        :symtab
                        :ctx
                        nid: (zast.nodeid.create from: (zast.kidAt
                            kids: ast.kids
                            span: c0.conditions
                            i: 0
                        )
                        )
                        :ind
                        :buf
                    )
                }
            }
            return
        }
        if (hoistStopsHere :n) then return
        kids: zast.childIds :ast :n
        kiter: kids.iterate
        for k0: kiter loop {
            (hoistExprYields
                :ast
                :symtab
                :ctx
                nid: (zast.nodeid.create from: k0)
                :ind
                :buf
            )
        }
    }
    # canonicalise to the CALL's own id. The walk reaches a yield twice -- once
    # as the expression wrapper around it, once as the call -- and both must
    # answer the same key, or the suspension is emitted twice and every later
    # state number shifts.
    cid: zast.yieldCallIdAt :ast :nid
    if cid.isZero then return
    # already hoisted: emitStmt runs this over the statement and then over the
    # nodes inside it, so the walk has to be idempotent
    if (ctx.yieldTempK.has key: cid.u64) then return
    # the resume type. An out-only generator binds no `value`, so its yields
    # carry nothing and stay on the statement leg
    ltid: stampIdOf :symtab nid: cid.u64
    if ltid.isZero then return
    # a REFTYPE resume value is held as a pointer into the caller's argument,
    # and a temp for it would have to carry the borrow alias the binding leg
    # sets up. That leg still owns those; reftype `accepts` is deferred polish
    # either way, so the hoist declines rather than guessing at the C.
    {
        ttk: symtab.reg.typetypeOf typeId: ltid
        if ttk == ztypes.ztypetype.classType then return
        if ttk == ztypes.ztypetype.unionType then return
    }
    kNum: ctx.genYieldNext
    emitYieldStmt :ast :symtab :ctx callId: cid :ind :buf
    # into the state object's slot, NOT a C local: the suspension above
    # returned, so a local declared here would be gone by the next one. The
    # lowering allocated one slot per suspension point for exactly this.
    lrv: "\{ind}\{ctx.genRecvC}->_yv_\{kNum} = \{ctx.genRecvC}->_resume_input;\n"
    buf.append lrv
    kv: kNum
    ctx.yieldTempK.set key: cid.u64 value: kv
}

# emitYieldStmt -- one `yield E` suspension: set the resume state, return the
# SOME-wrapped value, then drop a resume label at column 0 (goto-reachable into
# the enclosing block).
emitYieldStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    # the yield CALL's node id. The suspension reads its one unlabelled
    # argument; the checker has already refused a labelled one
    callId: zast.nodeid
    ind: StringView
    buf: String.borrow
} is {
    k: ctx.genYieldNext
    ctx.genYieldNext = k + 1
    # an interpolated yield value builds via a self-contained statement
    # expression (emitExpr :ast cannot emit the chain)
    yopId: zast.yieldCallOperandAt :ast nid: callId
    yx: ast.nodes.get i: yopId.u64
    ve: emitInterpArgExpr :ast :symtab :ctx n: yx
    if ve.length == 0 then ve = emitExpr :ast :symtab :ctx n: yx
    ls: "\{ind}\{ctx.genRecvC}->state = \{k};\n"
    buf.append ls
    lw: "\{ind}\{ctx.genWrap} _ry_\{k} = {0};\n"
    buf.append lw
    tgt: "_ry_\{k}"
    (emitOptionalAssign
        target: tgt.stringView
        someTag: ctx.genSomeTag.stringView
        payC: ctx.genPayC.stringView
        vx: ve.stringView
        :ind
        :buf
    )
    # a boxed yield MOVES an lvalue operand (a promoted local `this->x`):
    # zero the source so the instance destructor does not double-free it
    if ctx.genPayC.length > 0 then {
        if (isNonLvalueArg s: ve.stringView) == false then {
            lzv: "\{ind}\{ve} = (\{ctx.genPayC}){0};\n"
            buf.append lzv
        }
    }
    # a counted `for` keeps its counter in the C for-header, which this
    # `return` destroys and the resume `goto` re-enters past. Spill each open
    # one to its state field here and reload it at the label
    with sit: ctx.genForSpills.iterate do for sp: sit loop {
        lsv: "\{ind}\{ctx.genRecvC}->_fc_\{sp.slot} = \{sp.cname};\n"
        buf.append lsv
    }
    lr: "\{ind}return _ry_\{k};\n"
    buf.append lr
    ll: "L_resume_\{k}:;\n"
    buf.append ll
    with rit: ctx.genForSpills.iterate do for sp: rit loop {
        lrv: "\{ind}\{sp.cname} = \{ctx.genRecvC}->_fc_\{sp.slot};\n"
        buf.append lrv
    }
}

# methodReturnC -- a method's C return type. The registry knows it for a plain
# return; a generic-mono return (optionval/Option/resultval) carries no
# returnTypeId and resolves through the return-node stamp; a `void` that is
# really a constructor answers the receiver; and a heap-pointer collection or a
# borrowed-reference return takes a `*` the declared type does not carry.
methodReturnC: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    mid: ztypes.tid
    thisTid: ztypes.tid
    op: astnode.view
} out String is {
    ret: "void".string
    {
        rto: fnReturnTidOf :symtab tid: mid
        if rto > 0 then {
            rr: (typeRefC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: rto.u64)
                thisTid: (ztypes.tid.create from: thisTid.u64)
            )
            if rr.length > 0 then ret = rr
        }
    }
    if ret.stringView == "void" then {
        # generic-mono returns (optionval/Option/resultval) carry no registry
        # returnTypeId; the return-type node stamp resolves the mono id.
        mro: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: mid.u64)
        match (
            mro
        ) case some then {
            mrr: typeRefC :ast :symtab :ctx tid: mro thisTid: (ztypes.tid.create from: thisTid.u64)
            if mrr.length > 0 then ret = mrr
        } case none then null
    }
    if ret.stringView == "void" when thisTid > 0 then {
        if (ztypecheck.fnReturnBaseNameIdOf :ast :op) == zast.names.wkThis then {
            tcb: ctxCname :ctx tid: thisTid
            ret = "\{tcb}_t"
        }
    }
    if ret.stringView == "void" then {
        rbn: ztypecheck.fnReturnBaseNameOf :ast :op
        if rbn.length > 0 then {
            rbi: userFnId :ast :symtab :ctx name: rbn.stringView
            if rbi > 0 then {
                rr2: (typeRefC
                    :ast
                    :symtab
                    :ctx
                    tid: rbi
                    thisTid: (ztypes.tid.create from: thisTid.u64)
                )
                if rr2.length > 0 then ret = rr2
            } else {
                rr3: cTypeOf name: rbn.stringView
                if rr3.length > 0 then ret = rr3
            }
        }
    }
    # a Set/Map return is a heap pointer (like a Set/Map param), so the
    # value-typed ret gets a `*`. Mirrors isSetMapPtrParam at the param sites.
    if ret.stringView != "void" then {
        retColId: ztypes.tid
        {
            rtoR: symtab.reg.returnTypeOf tid: mid
            if rtoR > 0 then retColId = rtoR
        }
        if retColId.isZero then {
            mroR: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: mid.u64)
            match (
                mroR
            ) case some then {
                retColId = mroR
            } case none then null
        }
        if retColId > 0 when (isHeapPtrCollection
            :symtab
            :ctx
            tid: retColId
        ) then ret = "\{ret}*"
        if (fnReturnsRefBorrow
            :ast
            :symtab
            :ctx
            fid: mid
            retTid: (ztypes.tid.create from: retColId.u64)
        ) then ret = "\{ret}*"
    }
    return ret
}

# emitMethodParams -- one C parameter per declared field, in declaration order:
# the receiver by pointer for a class, then each parameter passed the way its
# declaration says it is taken. Appends to `params`.
emitMethodParams: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    mid: ztypes.tid
    thisTid: ztypes.tid
    encIsClass: bool
    pnames: (List String).view
    pids: (ListVal u64).view
    pidsNm: (ListVal u64).view
    op: astnode.view
    params: String.borrow
} is {
    pi: u64
    pn: pnames.length
    for pi < pn loop {
        pname: pnames.get i: pi
        pid: pids.get i: pi
        pt: (typeRefC
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: pid.u64)
            thisTid: (ztypes.tid.create from: thisTid.u64)
        )
        if pt.length == 0 then pt = "int64_t".string
        # The receiver is identified by its PARAMETER name -- `this` for the
        # `:this` shorthand, or the spelled name for `{a: this}` -- exactly as
        # the call site names it. Keying on the parameter's TYPE instead would
        # also catch a same-typed sibling (`add: function {a: this b: point}`
        # takes two points), which classes hid by making both pointers anyway.
        recvNm: "this".string
        {
            tpnR: (zast.poolTextAt
                pool: ast.names
                ref: (symtab.reg.thisParamNameIdOf tid: mid)
            )
            if tpnR.length > 0 then recvNm = tpnR.copy
        }
        isRecv: false
        if pname.stringView == recvNm.stringView then isRecv = true
        # The receiver is a reference in BOTH families: a record method acts on
        # the caller's instance, not on a copy of it. The rest of the pointer
        # rule still applies to class methods only.
        if isRecv then {
            pt = "\{pt}*"
            pvd: (paramVidByNameId
                :ast
                :symtab
                :op
                nameId: (zast.nameid.create from: (pidsNm.get i: pi))
            )
            ctx.ptrVids.append pvd
        } else {
            if encIsClass then {
                # a non-TAKE class param borrows the container (LOCK/BORROW, or the
                # borrow-default whose ownership a cross-unit shell records as "none")
                # -> pass by pointer. A `.take` (owning) class param stays by value:
                # a create/meta_create moves it into the struct.
                giveptr: false
                if (
                    (symtab.typing.declOwnershipIs
                        pool: ast.names
                        parentTypeId: mid
                        name: pname.stringView
                        own: ztypes.zparamownership.takeMode
                    ) ==
                    false
                ) then {
                    if (isReftypeParam
                        :ast
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: pid.u64)
                    ) then giveptr = true
                }
                ibs: (isBorrowStringParam
                    :ast
                    :symtab
                    :ctx
                    fid: mid
                    pname: pname.stringView
                    pid: (ztypes.tid.create from: pid.u64)
                )
                if ibs then giveptr = true
                if (markedValtypeRefParam
                    :ast
                    :symtab
                    fid: mid
                    pname: pname.stringView
                    :pid
                ) then giveptr = true
                if (isListPtrParam
                    :ast
                    :symtab
                    :ctx
                    fid: mid
                    pname: pname.stringView
                    tid: (ztypes.tid.create from: pid.u64)
                ) then giveptr = true
                if (isSetMapPtrParam
                    :ast
                    :symtab
                    :ctx
                    fid: mid
                    pname: pname.stringView
                    tid: (ztypes.tid.create from: pid.u64)
                ) then giveptr = true
                if giveptr then {
                    pt = "\{pt}*"
                    pvd9b: (paramVidByNameId
                        :ast
                        :symtab
                        :op
                        nameId: (zast.nameid.create from: (pidsNm.get i: pi))
                    )
                    ctx.ptrVids.append pvd9b
                }
            }
        }
        if pi > 0 then params.append ", "
        params.append pt
        params.append " "
        pmnV9b: (paramVidByNameId
            :ast
            :symtab
            :op
            nameId: (zast.nameid.create from: (pidsNm.get i: pi))
        )
        pmnDecl: varCName :ctx vid: pmnV9b name: pname.stringView
        if pi == 0 then ctx.genRecvC = pmnDecl.copy
        if pi == 1 then ctx.genValC = pmnDecl.copy
        params.append pmnDecl
        pi = pi + 1
    }
}


# emit one method of a type: its signature, its body, and the receiver
# parameter the C form needs but the source does not write
emitOneMethod: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    mid: ztypes.tid
    thisTid: ztypes.tid
    op: astnode.view
    declOnly: bool
    buf: String.borrow
} is {
    mc: ctxCname :ctx tid: mid
    ret: methodReturnC :ast :symtab :ctx :mid :thisTid :op
    params: String
    pnames: List String
    pids: ListVal u64
    pidsNm: ListVal u64
    recFieldLists :ast :symtab tid: mid names: pnames ids: pids nameIds: pidsNm
    # a CLASS method takes its `this` receiver by pointer (reference semantics):
    # the receiver param gets a `*` and its name is recorded so the body emits
    # `c->field`. Reset for this method (names must not leak into other bodies).
    ctx.ptrVids = ListVal ztypes.vid
    ctx.aliases = List VidVal
    ctx.narrowBox = List VidVal
    ctx.narrowTid = List VidTid
    ctx.exclArms = List VidVal
    ctx.exclTids = List VidTid
    encIsClass: false
    if (symtab.reg.typetypeOf typeId: thisTid) == ztypes.ztypetype.classType then encIsClass = true
    (emitMethodParams
        :ast
        :symtab
        :ctx
        :mid
        :thisTid
        :encIsClass
        :pnames
        :pids
        :pidsNm
        :op
        :params
    )
    pn: pnames.length
    if pn == 0 then params.append "void"
    if declOnly then {
        ld: "static \{ret} \{mc}(\{params});\n"
        buf.append ld
    } else {
        lo: "static \{ret} \{mc}(\{params}) {\n"
        buf.append lo
        isGen: setupGenCtx :ast :symtab :ctx :mid :op
        if isGen then emitGenPrologue :ctx :buf
        ctx.curThisTid = ztypes.tid.create from: thisTid
        emitFnBody :ast :symtab :ctx :op fid: mid :buf
        ctx.curThisTid = ztypes.tid.create from: 0
        if isGen then {
            emitGenEpilogue :ctx :buf
            ctx.genActive = false
        }
        buf.append "}\n\n"
    }
    ctx.ptrVids = ListVal ztypes.vid
    ctx.aliases = List VidVal
    ctx.narrowBox = List VidVal
    ctx.narrowTid = List VidTid
    ctx.exclArms = List VidVal
    ctx.exclTids = List VidTid
}

# the C name of the program's `main`.
mainCName: function {program: Ast.view} out String is {
    mv: program.mainUnitName.stringView
    mc: mv.string
    return mc
}
