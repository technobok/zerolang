}

# emitStringMethod -- a String value-context method call. String is a native
# singleton whose struct + methods emit once under ctx.strC; dispatch by name so
# the cname is canonical (not a per-shell receiver id). `recv` is the receiver C
# expression; recvIsPtr picks `->`/no-`&`. "" for an unrecognized method.
emitStringMethod: function {
    ctx: Ctx.view
    recv: StringView
    recvIsPtr: bool
    mn: StringView
    recvVid: ztypes.vid
} out String is {
    if mn == "copy" then {
        if recvIsPtr then return "\{ctx.strC}_copy(\{recv})"
        return "\{ctx.strC}_copy(&\{recv})"
    }
    if mn == "length" then {
        if recvIsPtr then return "\{recv}->size"
        return "\{recv}.size"
    }
    if mn == "capacity" then {
        if recvIsPtr then return "\{recv}->capacity"
        return "\{recv}.capacity"
    }
    if mn == "stringview" then return (svValueForm :ctx expr: recv isStr: true vid: recvVid)
    if mn == "shrink" then {
        if recvIsPtr then return "\{ctx.strC}_shrink(\{recv})"
        return "\{ctx.strC}_shrink(&\{recv})"
    }
    return "".string
}

# varCName -- a local's emitted C identifier. Its variable id already names it
# uniquely, so no C-keyword mangling is needed; --readable-names, and any site
# no id reached, fall back to the mangled source name.
varCName: function {ctx: Ctx.view vid: ztypes.vid name: StringView} out String is {
    if ctx.readableNames then return (ztypes.mangleVarName :name)
    if vid.isZero then return (ztypes.mangleVarName :name)
    return "z_v\{vid}"
}

# emitLocalAtomName -- a local variable's C spelling: the alias or narrowing
# cast in scope for it, else its own identifier. Shared by the atomid and
# labelvalue (:name shorthand) value legs.
emitLocalAtomName: function {ctx: Ctx.view name: StringView vid: ztypes.vid} out String is {
    # Probed directly rather than through aliasResolve: that would synthesize a
    # copy of `name` for the no-alias case, which is the common one, only for the
    # comparison below to discard it.
    nb9: vvFind xs: ctx.narrowBox :vid
    if nb9 > 0 then return (ctx.narrowBox.get i: nb9 - 1).val.copy
    al9: vvFind xs: ctx.aliases :vid
    if al9 > 0 then return (ctx.aliases.get i: al9 - 1).val.copy
    return (varCName :ctx :vid :name)
}

# emitExpr -- the C expression text for a node (calls inline; the scalar
# examples carry no order-sensitive multi-call arguments).
emitExpr: function {ast: Ast symtab: zenv.ZSymbolTable ctx: Ctx n: Node.view} out String is {
    cv9: nodeConstText :ast :symtab :ctx nid: (zast.nodeid.create from: (nodeIdOf9 :n).u32.orPanic)
    if cv9.length > 0 then return cv9
    match (
        n
    ) case expression then {
        return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.statementline.u64))
    } case statement then {
        if n.statements.length == 1 then {
            s0Id9: n.statements.get i: 0
            return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: s0Id9.u64))
        }
        emitFail :ctx what: "unhandled expr (multi-statement)".string line: n.lineno
        return "/* zemitterc: unhandled expr */0".string
    } case atomid then {
        avC9: ast.names.texts.get i: n.name.u64
        av: avC9.stringview
        # `0c<char>` literal: the raw lexeme is not a C token, so decode
        # to its codepoint here (decimal/hex lexemes pass through below
        # as valid C text; identifiers never start with a digit)
        if av.startsWith "0c" then {
            pn9: ztypes.parseNumber numstr: av
            if pn9.err.length == 0 then {
                cl9: "\{pn9.ival}"
                return cl9
            }
            emitFail :ctx what: "invalid char literal \{av}" line: n.lineno
            return "/* zemitterc: unhandled char literal \{av} */0"
        }
        # stamped variable use first: the local, alias-resolved and C-mangled
        # -- a stamped atom is a LOCAL, so the module-constant probe (an owned
        # key alloc + hash) never runs for it
        avo9: symtab.typing.atomVariableId.get key: n.nodeid.u64
        match (
            avo9
        ) case some then {
            return (emitLocalAtomName :ctx name: av vid: avo9)
        } case none then null
        # a name written inside a namespace resolves against that namespace
        # first, then the file unit -- the chain spec.pdoc gives an inline unit.
        # A generic unit's mono method is written in the TEMPLATE, whose Decl
        # the mono's id points at, so its chain starts there.
        nsAt9: ctx.nsTid
        if nsAt9.isZero when (ctx.curThisTid.isZero) == false then {
            if (symtab.reg.typetypeOf typeId: ctx.curThisTid) == ztypes.ztypetype.unitType then nsAt9 = ctx.curThisTid
        }
        if (nsAt9.isZero) == false then {
            # the nested frames, innermost outward: the unit the name is
            # written in, then each unit enclosing it. Asking only the
            # innermost inlined nothing for a constant of an enclosing inline
            # unit, and the bare source name reached the C.
            nsCur9: ztypecheck.declOfTypeId reg: symtab.reg tid: nsAt9
            for nsCur9 > 0 loop {
                nsFt9: ztypecheck.declTypeIdOf ty: symtab.typing declId: nsCur9
                if (nsFt9.isZero) == false then {
                    nsca9: (memberConstTextOf9
                        :ast
                        :symtab
                        :ctx
                        unitTid: nsFt9
                        nameId: n.name
                    )
                    if nsca9.length > 0 then return nsca9
                    nscs9: memberConstStrText9 :symtab :ctx unitTid: nsFt9 nameId: n.name
                    if nscs9.length > 0 then return nscs9
                }
                nsNx9: ztypecheck.declParentIdOf ty: symtab.typing declId: nsCur9
                nsCur9 = ztypes.declid
                if (nsNx9.isZero) == false then {
                    if (ztypecheck.declDeclaresUnit
                        ty: symtab.typing
                        :ast
                        declId: nsNx9
                    ) then nsCur9 = nsNx9
                }
            }
        }
        mutd9: unitTidOf9 :ast :symtab unitName: ctx.mainName.stringview
        mca9: (memberConstTextOf9
            :ast
            :symtab
            :ctx
            unitTid: mutd9
            nameId: n.name
        )
        if mca9.length > 0 then return mca9
        mcsa9: memberConstStrText9 :symtab :ctx unitTid: mutd9 nameId: n.name
        if mcsa9.length > 0 then return mcsa9
        # stamped unit-def reference: the RECORD / FUNCTION legs run off the
        # stamped tid; unstamped atoms (fn-mono template re-emission walks
        # the shared template AST) fall back to the name probe
        brid: ztypes.tid
        bdec9: ztypes.declid
        {
            audo9: symtab.typing.refDecl.get key: n.nodeid.u64
            match (
                audo9
            ) case some then {
                d0x: symtab.typing.decls.get i: audo9.u64
                brid = ztypes.tid.create from: (d0x.typeId)
                bdec9 = audo9
