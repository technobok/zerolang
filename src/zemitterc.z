# zemitterc -- the C17 emitter. A typed-AST-to-C pass over the typechecker's
# stamps: the runtime preamble and the fragments and templates of the rows zc carries
# the program demands, the string-literal pool, then every reachable type and
# function, in sections assembled at the end. Unhandled shapes record an
# emitFail: zc reports every failure and exits nonzero without writing output.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :emitC
    :rtHole
    :servedKey
    :UserImplementation
    :isServedUnit
    # the C-backend facts the numeric conversion rule (znativecheck) is built from
    :kindCType
    :kindHiStr
    :kindLoStr
    :convRangeCond
}

astnode: zast.astnode
Ast: zast.Ast


# ArgHoist -- one statement temporary awaiting its declaration where the
# statement is flushed: its name, its initialiser (empty for one assigned where
# its part runs, which starts zero), its C type, and the destroy it owes (empty
# for none). One row, so the four cannot drift apart when a statement pops them.
ArgHoist: class {
    name: String
    val: String
    ctype: String
    dtor: String
}

# RawHoist -- statements the statement being built runs ahead of itself, which
# no declaration can hold (a copy loop, a control value's arms): their text,
# its lines unindented, and how many argument hoists were recorded before them,
# which is where they run among those.
RawHoist: class {
    text: String
    at: u64
    # an assignment the order machinery moved here from a call's comma prefix
    # (settleAhead): dropping it would lose the part it reads
    settles: bool
}

# OrderPend -- one part of a call waiting to learn whether a part evaluated
# after it needs it read into a temp first: its text, the C type its temp is
# given (empty to spell it from the parameter or the value), the slot it
# fills, the function, parameter type and parameter name the temp's type is
# spelled from, the value node a scalar part's temp is typed from (0 for none),
# whether it only reads, and its facts.
OrderPend: class {
    text: String
    ctype: String
    slot: u64
    fid: ztypes.tid
    pid: ztypes.tid
    pname: zast.nameid
    nid: zast.nodeid
    pure: bool
    facts: cfacts
    # where its call's slots begin in orderVals
    valBase: u64
    # when it was built, on the order counter every part and piece draws from
    seq: u64
    # settled ahead of a control value (settleAhead): its slot is filled
    done: bool
}

# LoopFrame -- one loop, or do{}while(0) block, open around the code being
# emitted: its break label's number, whether it is a do-block (whose
# `continue` targets the loop around it), and the frees mark at its entry (so
# a jump out frees exactly the temporaries the emitter registered since).
LoopFrame: class {
    id: u64
    isDo: bool
    # the loop tests its postconditions after its continue label
    # (emitIterationEnd): a `continue` jumps there
    postTest: bool
    listMark: u64
    # a `break` or `continue` of this frame was emitted: code later in it may
    # be skipped
    leftEarly: bool
}

# OwedFree -- one destroy the emitter owes a temporary of its own: the C name it
# destroys and the statement that destroys it. A local's destroy is not here:
# it is written where the checker lists the local (emitLocalDestroy).
OwedFree: class {
    # the C identifier the destructor takes
    name: String
    # the full destructor statement
    stmt: String
    # an argument's temporary, released at the end of its statement rather
    # than of the block
    temp: bool
    # the checker's unnamed local the temporary realises (its name id), 0 for
    # none: a `.drop` that releases the last borrow of it destroys it there
    tag: zast.nameid.zero
    # the statement that zeroes the temporary, which an early destroy leaves
    # behind so the block's own destroy of it is a no-op
    zero: String
}

# TmpCtr -- per-function temp name counter, and the destroys owed the emitter's
# own temporaries at the end of each open block.
TmpCtr: class {
    # the next temp number, so two temps in one function never collide
    n: u64
    # the destroys owed at block end, in the order registered
    listFrees: List OwedFree
} as {
    # the next temp number, taken and consumed. Numbers are per FUNCTION, not
    # per block, so a temp in one block cannot collide with one in a sibling
    next: function {:this} out u64 is {
        v: this.n
        this.n = this.n + 1
        return v
    }

    # oweList -- a temporary to destroy at block end
    oweList: function {:this stmt: String.take name: String.take} is {
        this.listFrees.append (OwedFree :name :stmt temp: false zero: String)
    }

    # oweTemp -- an argument's temporary to destroy at the end of its statement
    oweTemp: function {:this stmt: String.take name: String.take} is {
        this.listFrees.append (OwedFree :name :stmt temp: true zero: String)
    }
}

# opSpelling / opCname -- the operator method names a C identifier cannot spell
# (a typedef's shadowed `==`, a numeric `+`), and the spelling each takes instead,
# slot for slot. opSpelling is read through a zast.Vocab (ctx.opWords).
opSpelling: list {
    eq: "=="
    ne: "!="
    le: "<="
    ge: ">="
    lt: "<"
    gt: ">"
    add: "+"
    sub: "-"
    mul: "*"
    div: "/"
    mod: "%"
    band: "&"
} out staticlist StringView

opCname: list {
    eq: "op_eq"
    ne: "op_ne"
    le: "op_le"
    ge: "op_ge"
    lt: "op_lt"
    gt: "op_gt"
    add: "op_add"
    sub: "op_sub"
    mul: "op_mul"
    div: "op_div"
    mod: "op_mod"
    band: "op_and"
} out staticlist StringView

# opCnameOf -- the C-identifier spelling of an operator method name, "" for an
# ordinary name.
opCnameOf: function {ow: zast.Vocab.view name: StringView} out String is {
    k: ow.slotOf text: name
    if k == ow.none then return "".string
    return (opCname.get i: k).string
}

# cnameOf -- the id-based C name base for a type ("z_t{id}_{name}", dots
# joined with underscores).
cnameOf: function {
    tid: ztypes.tid
    ownerName: StringView
    name: StringView
    # the operator spellings (opSpelling)
    ow: zast.Vocab.view
} out String is {
    flat: opCnameOf :ow :name
    if flat.length == 0 then {
        biter: u64
        n: name.length
        for biter < n loop {
            bo: name.byteAt i: biter
            if bo.some then {
                if bo == 46 then {
                    flat.append "_"
                } else {
                    identB: (
                        (bo >= 97) and
                        (bo <= 122) or
                        ((bo >= 65) and (bo <= 90)) or
                        ((bo >= 48) and (bo <= 57)) or
                        (bo == 95)
                    )
                    if identB then {
                        flat.appendByte b: bo
                    } else {
                        flat.append "_"
                    }
                }
            }
            biter = biter + 1
        }
    }
    if ownerName.length == 0 then return "z_t\{tid}_\{flat}"
    oflat: ownerName.replace needle: "." replacement: "_"
    joined: "\{oflat}_\{flat}"
    return "z_t\{tid}_\{joined}"
}

# listCname -- a type's C name base from the table composed once at the start
# of emitC. "" when the id names no registered type.
listCname: function {cnames: (List String).view tid: ztypes.tid} out String is {
    if tid.u64 >= cnames.length then return "".string
    got: cnames.get i: tid
    return got.copy
}

# listCnameView -- the C name for `tid` BORROWED rather than copied, and "" when
# the table does not reach that far. `cnames` is built once before emission and
# never written again, so a view into it is good for the whole run; listCname is
# the owning twin, for a caller that keeps the String.
listCnameView: function {cnames: (List String).view tid: ztypes.tid} outx StringView is {
    if tid.u64 >= cnames.length then return ""
    got: cnames.get i: tid
    return got.stringView
}

# ctxCnameView -- listCnameView against the table the emission context carries.
ctxCnameView: function {ctx: Ctx.view tid: ztypes.tid} outx StringView is {
    return (listCnameView cnames: ctx.cnames :tid)
}

# isViewLaid -- a type laid out as a StringView: StringView, or text, which is
# one C type with it.
isViewLaid: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    return (tid == ctx.svTid) or (tid == ctx.textTid)
}

# ctxCname -- listCname against the table the emission context carries.
ctxCname: function {ctx: Ctx.view tid: ztypes.tid} out String is {
    return (listCname cnames: ctx.cnames :tid)
}

# spelledCname -- ctxCname for C being written: until the reached types are
# fixed, the type it names is a use they are closed from (closeReachedTypes),
# and a function it names is written (noteFnUse).
spelledCname: function {ctx: Ctx tid: ztypes.tid} out String is {
    if ctx.reachFixed.not then ctx.typeUses.add item: tid
    noteFnUse :ctx :tid
    return (listCname cnames: ctx.cnames :tid)
}

# atomVid -- the variable a reference node resolves to, or 0.
atomVid: function {typing: ztyping.ZTyping.view nid: zast.nodeid} out ztypes.vid is {
    return (
        (typing.atomVariableId.get key: nid).or
        d: ztypes.vid.zero
    )
}

# defVid -- the variable a binding node introduces, or 0.
defVid: function {typing: ztyping.ZTyping.view nid: zast.nodeid} out ztypes.vid is {
    return (
        (typing.defVariableAt :nid).or
        d: ztypes.vid.zero
    )
}

# atomVidIfPlain -- the variable an already-emitted value expression names, but
# only when the emitted text is that atom's own source name. An alias
# substitution, a C-keyword mangle or any compound expression makes the text
# something other than the binding, and then there is no variable to ask a
# pointer question about -- which is what a name compare answers by missing.
atomVidIfPlain: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    n: astnode.view
    text: StringView
} out ztypes.vid is {
    match (
        n
    ) case atomid then {
        at: zast.nameTextAt :ast ref: n.name
        atomVarId: atomVid :typing nid: n.nodeid
        if (
            localAtomNameIsAt
            :ast
            :reg
            :typing
            :ctx
            nid: n.nodeid
            name: at.stringView
            vid: atomVarId
            :text
        ) then {
            return atomVarId
        }
        return ztypes.vid.zero
    } case labelvalue then {
        # the `:name` shorthand names a binding just as a bare atom does
        lv: zast.nameTextAt :ast ref: n.name
        lvv: atomVid :typing nid: n.nodeid
        if (
            localAtomNameIsAt
            :ast
            :reg
            :typing
            :ctx
            nid: n.nodeid
            name: lv.stringView
            vid: lvv
            :text
        ) then {
            return lvv
        }
        return ztypes.vid.zero
    } case dottedpath then {
        # a dotted path can still emit as its bare base -- a `.private` access
        # marker contributes no C text -- and then the base IS the value passed.
        dbn: ast.nodes.get i: n.parent
        db: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: dbn)
        if db.length == 0 then return ztypes.vid.zero
        dbv: atomVid :typing nid: (atomNodeId n: dbn)
        atomNode: atomNodeId n: dbn
        if (
            localAtomNameIsAt
            :ast
            :reg
            :typing
            :ctx
            nid: atomNode
            name: db.stringView
            vid: dbv
            :text
        ) then return dbv
        return ztypes.vid.zero
    } else {
        return ztypes.vid.zero
    }
}

# paramVidIn -- paramVidByNameId against a parameter list the caller already
# holds, rather than one reached through a function node. 0 when no parameter
# carries that name.
paramVidIn: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    params: zast.kidspan
    nameId: zast.nameid
} out ztypes.vid is {
    if nameId.isZero then return ztypes.vid.zero
    for each pmId: (zast.kidsOf :ast span: params) loop {
        pm: ast.nodes.get i: pmId
        if pm.namedoperation when pm.name == nameId when pm.operation.notZero then {
            opNid: interpPartNodeId n: (ast.nodes.get i: pm.operation)
            return (defVid :typing nid: opNid)
        }
    }
    return ztypes.vid.zero
}

# paramVidByNameId -- the variable behind parameter `nameId` of the function
# node `op`, or 0. The type checker mints a parameter's variable while walking
# the AST parameter list and stamps it on the node the parameter WRAPS, so read
# it back the same way. The declaration tree cannot supply it: a generic clone
# shares its template's declaration, so a member lookup there answers with one
# node for every parameter alike.
paramVidByNameId: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    op: astnode.view
    nameId: zast.nameid
} out ztypes.vid is {
    match (
        op
    ) case functiondef then {
        return (paramVidIn :ast :typing params: op.parameters :nameId)
    } else {
        return ztypes.vid.zero
    }
}

# cnameById -- a type's default C name: its id alone. The emitted C is a
# build artifact rather than a reading surface, so the source name rides
# along only under --readable-names.
cnameById: function {tid: ztypes.tid} out String is {
    return "z_t\{tid}"
}

# The scalar kinds' C facts, one row each in ztypes.numkind's order and read
# by a kind's position, `k.tag`. What a scalar is in C is asked of its KIND,
# which the type's declaration settles (ztypecheck.numKindOfTid), never of a
# name: a program's own `u8` is no u8.

# kindfacts -- what one scalar kind is in C
kindfacts: data {
    # the C type the kind is spelled as
    ctype: text
    # the lower bound a narrowing check compares with, as C; "0" where no
    # check reads one
    lo: text
    # the upper bound a narrowing check compares with, as C; "0" where no
    # check reads one
    hi: text
    # the C literal suffix that keeps a large constant of an unsigned kind
    # unsigned
    suffix: text
}

# kindFacts -- each scalar kind's C facts
kindFacts: list {
    i8Type: (kindfacts ctype: "int8_t" lo: "-128" hi: "127" suffix: "")
    i16Type: (kindfacts ctype: "int16_t" lo: "-32768" hi: "32767" suffix: "")
    i32Type: (kindfacts ctype: "int32_t" lo: "(-2147483647 - 1)" hi: "2147483647" suffix: "")
    i64Type: (
        kindfacts
        ctype: "int64_t"
        lo: "(-9223372036854775807LL - 1)"
        hi: "9223372036854775807"
        suffix: ""
    )
    i128Type: (kindfacts ctype: "z_i128" lo: "0" hi: "0" suffix: "")
    u8Type: (kindfacts ctype: "uint8_t" lo: "0" hi: "255" suffix: "")
    u16Type: (kindfacts ctype: "uint16_t" lo: "0" hi: "65535" suffix: "")
    u32Type: (kindfacts ctype: "uint32_t" lo: "0" hi: "4294967295U" suffix: "U")
    u64Type: (kindfacts ctype: "uint64_t" lo: "0" hi: "18446744073709551615ULL" suffix: "ULL")
    u128Type: (kindfacts ctype: "z_u128" lo: "0" hi: "0" suffix: "")
    c8Type: (kindfacts ctype: "uint8_t" lo: "0" hi: "255" suffix: "")
    c32Type: (kindfacts ctype: "uint32_t" lo: "0" hi: "4294967295U" suffix: "U")
    f16Type: (kindfacts ctype: "z_f16" lo: "0" hi: "0" suffix: "")
    f32Type: (kindfacts ctype: "float" lo: "0" hi: "0" suffix: "")
    f64Type: (kindfacts ctype: "double" lo: "0" hi: "0" suffix: "")
    f128Type: (kindfacts ctype: "__float128" lo: "0" hi: "0" suffix: "")
} out staticlist kindfacts

# kindCType -- the C type scalar kind `k` is spelled as.
kindCType: function {k: ztypes.numkind} out StringView is {
    return (kindFacts.get i: k.tag.u64).ctype.stringView
}

# kindLoStr / kindHiStr -- kind `k`'s range bounds, as the C a narrowing check
# compares with.
kindLoStr: function {k: ztypes.numkind} out StringView is {
    return (kindFacts.get i: k.tag.u64).lo.stringView
}

# kindHiStr -- see kindLoStr.
kindHiStr: function {k: ztypes.numkind} out StringView is {
    return (kindFacts.get i: k.tag.u64).hi.stringView
}

# kindLitSuffix -- the C literal suffix of unsigned kind `k`, so a large decimal
# constant is unambiguously unsigned to the C compiler; "" for the others.
kindLitSuffix: function {k: ztypes.numkind} out StringView is {
    return (kindFacts.get i: k.tag.u64).suffix.stringView
}

# ordinalVariantCType -- the C scalar a VARIANT lowers to instead of a tag
# struct, "" when it needs one. A variant whose arms all carry no payload is an
# ordinal: nothing distinguishes one value from another but which arm it is, so
# a tagged struct carries nothing. TWO ordinals are exactly C `bool`. The
# checker records the shape, discriminator included, so this asks what the type
# IS rather than what it is called -- `bool` is the stdlib instance of the
# shape, and a user variant of the same shape gets the same C.
#
# Three-and-more-arm ordinals are the same argument and still get the struct;
# unwrapping those changes the C type every field, param and local of them is
# spelled with, which is its own change.
ordinalVariantCType: function {
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
} out String is {
    ao: typing.ordinalVariant.get key: tid
    match (
        ao
    ) case some then {
        if ao == 2 then return "bool".string
        # every recorded ordinal has a u8 discriminator BY CONSTRUCTION: the
        # checker only records one whose values are the arm ordinals, which is
        # the spec's default (u8, sequential from 0) or an explicit u8
        return "uint8_t".string
    } case none then {
        return "".string
    }
}

# tagStorageCType -- the C type a tagged type's DISCRIMINATOR is stored in, from
# what the declaration asked for (`tag: u8.tag`, or the spec's u8 default). The
# enum stays for the constants; it just stops being the storage, because a C
# enum is `int` and spelling the field with it ignores the declaration -- a
# `tag: u8.tag` was silently four bytes.
#
# "" when the type declares a list-sourced tag, whose constants set their own
# width, or when nothing was recorded: the enum remains the storage there.
tagStorageCType: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
} out String is {
    key: tid
    # a MONO carries no declaration of its own: the template it was minted from
    # is where the tag was declared, and the instance stores it the same way
    {
        go: genericOriginTid :reg :tid
        if go.notZero then {
            hasOwn: false
            o: typing.variantTagBase.get key: tid
            if o.some then {
                hasOwn = true
            }
            if hasOwn.not then key = go
        }
    }
    tb: typing.variantTagBase.get :key
    match (
        tb
    ) case some then {
        # 0 is a data-sourced tag: its constants set their own width, so the
        # enum stays the storage
        if tb.isZero then return "".string
        # BIND the name: reg.nameOf hands back an OWNED copy, and taking a
        # view of it inline leaves the copy with no owner to free it.
        # scalarCTypeFor, not a lookup by name: the tid is in hand, so a user type
        # shadowing a numeric name must not pick up that numeric's C spelling
        return (scalarCTypeFor :typing tid: tb)
    } case none then {
        # nothing declared: the spec's default, u8
        return "uint8_t".string
    }
}

# isOrdinalVariant -- the value IS its own discriminator: no tag field to read,
# no struct to compose, and `==` rather than a comparator.
#
# Reads the record rather than asking ordinalVariantCType and measuring what it
# says: this is a QUESTION, asked 11503 times in a self-compile, and building a
# string to answer it allocated once per ask.
isOrdinalVariant: function {typing: ztyping.ZTyping.view tid: ztypes.tid} out bool is {
    ao: typing.ordinalVariant.get key: tid
    match (
        ao
    ) case some then {
        return true
    } case none then {
        return false
    }
}

# isOrdinalPair -- an ordinal with exactly TWO arms, which is a C `bool` and so
# answers to truthiness: the second arm is the value, the first its negation.
# Distinct from isOrdinalVariant, which is about there being no tag field --
# every ordinal loses the field, only a pair gains `x` / `!x`.
isOrdinalPair: function {typing: ztyping.ZTyping.view tid: ztypes.tid} out bool is {
    ao: typing.ordinalVariant.get key: tid
    match (
        ao
    ) case some then {
        return ao == 2
    } case none then {
        return false
    }
}

# ordinalPairFirstArmId -- the name-pool id of an ordinal pair's FIRST arm:
# ordinal 0, and so the false side of the C `bool`. `bool` writes `false` first
# for exactly this reason, and a user variant decides it the same way -- by the
# order it writes its arms. 0 when `tid` is not an ordinal pair.
#
# An id rather than the text, because the callers ask an IDENTITY question --
# is this arm the false one -- and rendering the name to answer it allocated a
# String once per ask. Read from what the checker recorded, never walked: an
# arm walk is a member walk, and forcing one during emission demands members
# the program never asked for.
ordinalPairFirstArmId: function {
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
} out zast.nameid is {
    none: zast.nameid
    if (isOrdinalPair :typing :tid).not then return none
    return ((typing.sumPairFirstArm.get key: tid).or d: none)
}

# scalarCTypeFor -- the C scalar a type lowers to: an ordinal variant's (bool's)
# C type, or the C type of a scalar the system declares (its KIND, which the
# declaration settles); "" for any other type, a program's own type spelled like
# a scalar included. The caller then emits the type's struct (typeRefC /
# cnameOf). The one gate every C-type site asks, by id.
scalarCTypeFor: function {typing: ztyping.ZTyping.view tid: ztypes.tid} out String is {
    if (isOrdinalVariant :typing :tid) then {
        return (ordinalVariantCType :typing :tid)
    }
    nk: ztypecheck.numKindOfTid :typing :tid
    if nk.has.not then return "".string
    return (kindCType k: nk.kind).string
}

# isUserStructType -- the type-types whose values are user objects laid out as a
# C struct and can declare methods: record, class, variant, union and facet. A
# protocol is a vtable, not a struct, and the native families answer elsewhere.
isUserStructType: function {tt: ztypes.ztypetype} out bool is {
    return tt.isValueFamily or tt.isReferenceData
}

# wideLiteralOf -- an integer lexeme as a value of 128-bit integer kind `k`
# (int128WordsC); "" when `k` is no 128-bit kind or the lexeme is no integer.
wideLiteralOf: function {ctx: Ctx lex: StringView k: ztypes.suffixinfo} out String is {
    if k.has.not then return "".string
    if (ztypes.intKindBits k: k.kind) != 128 then return "".string
    wb: ztypecheck.constLiteralBig :lex
    if wb.some then {
        return (int128WordsC :ctx b: wb signed: (ztypes.isSignedIntKind k: k.kind))
    }
    return "".string
}

# int128WordsC -- a value of a 128-bit integer type as C: the prelude's
# Z_I128_C / Z_U128_C of its two 64-bit words, high first, in two's
# complement. C has no 128-bit literal, and a 64-bit one would overflow in 64
# bits before reaching the destination; the macro is the type's own value
# where the C compiler has the type and its two words where it has none.
int128WordsC: function {ctx: Ctx b: math.BigInt.view signed: bool} out String is {
    one: math.BigInt from: 1
    bits: b.copy
    if b.sign < 0 then bits = b + (one << 128)
    mask: (one << 64) - one
    hi: (bits >> 64).text base: 16
    lo: (bits & mask).text base: 16
    if signed then {
        preludeNeed :ctx memb: "@i128_c"
        return "Z_I128_C(0x\{hi}ULL, 0x\{lo}ULL)"
    }
    preludeNeed :ctx memb: "@u128_c"
    return "Z_U128_C(0x\{hi}ULL, 0x\{lo}ULL)"
}

# literalDefaultC -- a literal default's C text: a decimal past i64 with its
# unsigned suffix, a prefixed literal decoded, anything else as written.
literalDefaultC: function {lex: StringView ctx: Ctx} out String is {
    wl: wideLiteralC :ctx :lex
    if wl.length > 0 then return wl
    lc: literalC :lex
    if lc.length > 0 then return lc
    return lex.string
}

# wideLiteralC -- an integer literal outside i64 as C, from its exact value: the
# checker admits one only where a type takes it, and C reads an unsuffixed
# decimal as a signed type it does not fit, and has no token at all past u64
# or in binary. "" for any other text; a name is told apart by its first byte.
wideLiteralC: function {ctx: Ctx lex: StringView} out String is {
    if lex.length < 19 then return "".string
    b0: (lex.byteAt i: 0).or d: 0
    if b0 != 45 when (b0 < 48) or (b0 > 57) then return "".string
    bo: ztypecheck.constLiteralBig :lex
    if bo.some then {
        if bo.i64.ok then return "".string
        return (bigValueC :ctx b: bo)
    }
    return "".string
}

# castLitVal -- val with the unsigned C suffix appended when it is a bare decimal
# literal cast to an unsigned type, so large u64 constants don't warn as signed.
castLitVal: function {val: StringView dst: ztypes.suffixinfo} out String is {
    r: val.string
    if dst.has.not then return r
    sfx: kindLitSuffix k: dst.kind
    if sfx.length == 0 then return r
    if val.length == 0 then return r
    allDig: true
    i: u64
    n: val.length
    for i < n loop {
        bo: val.byteAt :i
        if bo.some then {
            if bo < 48 then allDig = false
            if bo > 57 then allDig = false
        }
        i = i + 1
    }
    if allDig then r.append sfx
    return r
}

# convRangeCond -- the C test for an integer conversion FAILING, built from
# whichever bounds can actually be breached. Neither bound means the conversion
# is total and the test is a constant.
convRangeCond: function {dstK: ztypes.numkind needsLo: bool needsHi: bool} out String is {
    if needsLo.not then {
        if needsHi.not then return "0".string
        hi2: kindHiStr k: dstK
        h: "(@V@) > \{hi2}"
        return h
    }
    lo: kindLoStr k: dstK
    if needsHi.not then {
        l: "(@V@) < \{lo}"
        return l
    }
    hi: kindHiStr k: dstK
    b: "(@V@) < \{lo} || (@V@) > \{hi}"
    return b
}

# convResultBindings -- the holes a checked conversion's row spells for the
# `resultval` it answers: its C type, its two tags and its two arms' members,
# and how the error arm reaches converror's tag.
convResultBindings: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    retTid: ztypes.tid
    bn: ListVal zast.nameid
    bv: List String
    rn: ListVal zast.nameid
    rv: List String
} is {
    bn.append (rtHoleId slot: rtHole.slot.holeRT)
    bv.append from: (spelledCname :ctx tid: retTid)
    rn.append (rtHoleId slot: rtHole.slot.holeOkTag)
    (
        rv.append
        from: (spelledTagConst :ast :ctx :reg :typing tid: retTid armId: zast.wellKnown.slot.wkOk)
    )
    rn.append (rtHoleId slot: rtHole.slot.holeErrTag)
    (
        rv.append
        from: (spelledTagConst :ast :ctx :reg :typing tid: retTid armId: zast.wellKnown.slot.wkErr)
    )
    rn.append (rtHoleId slot: rtHole.slot.holeOkMember)
    (
        rv.append
        from: (
            memberC
            :ast
            :reg
            :typing
            :ctx
            owner: retTid
            kind: memberkind.arm
            nameId: zast.wellKnown.slot.wkOk
        )
    )
    rn.append (rtHoleId slot: rtHole.slot.holeErrMember)
    (
        rv.append
        from: (
            memberC
            :ast
            :reg
            :typing
            :ctx
            owner: retTid
            kind: memberkind.arm
            nameId: zast.wellKnown.slot.wkErr
        )
    )
    # the error slot's assignment, spelled for whatever `converror` IS
    if ctx.converrorTid.notZero then {
        rn.append (rtHoleId slot: rtHole.slot.holeTagConverror)
        if (isOrdinalVariant :typing tid: ctx.converrorTid) then {
            rv.append from: "".string
        } else {
            rv.append from: ".tag".string
        }
    }
}

# emitNumericCast -- a runtime numeric conversion `<val>.<dstName>`, filled from
# the row keyed `rowKey` (convRowNameOf). The row already IS the derivation
# -- it was generated by it -- so the C is read rather than rebuilt here, and the
# declaration's return type decides only which bindings the row needs: a lossy
# conversion's row spells the resultval mono and its two tags. The value is the
# row's one part, placed in evaluation order: a row that names @V@ more than
# once reads it into its temp first.
emitNumericCast: function {
    # the arm names
    ast: Ast.view
    ctx: Ctx
    val: String.take
    valF: cfacts
    # the node whose value `val` is
    valNid: zast.nodeid
    # where the pending hoists stood before `val` was built
    mark: hoistmark
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    retTid: ztypes.tid
    rowKey: zemitrows.rowname
    facts: cfacts.borrow
} out String is {
    row: ctx.rows.ofName n: rowKey
    key: rowLabel :ctx :ast n: rowKey
    body: rtid
    if row > 0 then body = rowBody :ctx :row
    if body.isZero then {
        emitFail :ctx what: "no native implementation for '\{key}'" line: 0
        return (
            stating
            :facts
            from: failedFacts
            text: "0".string
        )
    }
    rowNeedsAdd :ctx :row cond: condAlways
    # a lossy conversion builds a `resultval`; the row spells the tags and the
    # mono's name, and the DECLARATION is what decided which shape it is
    isResultval: (
        originIsTid
        :reg
        tid: retTid
        originTid: (ctx.origins.get i: family.slot.resultval)
    )
    bn: ListVal zast.nameid
    bv: List String
    rn: ListVal zast.nameid
    rv: List String
    if isResultval then {
        convResultBindings :ast :reg :typing :ctx :retTid :bn :bv :rn :rv
    } else {
        # a row that builds a record spells the record's C type as @RT@
        if (rtHas :ctx id: body slot: rtHole.slot.holeRT) then {
            bn.append (rtHoleId slot: rtHole.slot.holeRT)
            bv.append from: (spelledCname :ctx tid: retTid)
        }
    }
    # a row over the runtime's string types (text's) spells them as holes
    if (rtHas :ctx id: body slot: rtHole.slot.holeStringView) then {
        bn.append (rtHoleId slot: rtHole.slot.holeStringView)
        preludeNeed :ctx memb: "@StringView_t"
        bv.append from: ctx.svC.copy
    }
    if (rtHas :ctx id: body slot: rtHole.slot.holeString) then {
        bn.append (rtHoleId slot: rtHole.slot.holeString)
        preludeNeed :ctx memb: "@String_t"
        bv.append from: ctx.strC.copy
    }
    # a checked conversion reads a constant into its temp too: spelled in
    # place, it would fold the tests, and the C compiler would report the
    # result they rule out as code never executed
    partF: valF
    constant: orderConstantWith :ast :typing :ctx n: (ast.nodes.get i: valNid) tf: valF byPtr: false
    if isResultval when constant then {
        constant = false
        partF.once = true
    }
    pre: String
    spelled: (
        orderOnePart
        :ast
        :reg
        :typing
        :ctx
        :mark
        text: val
        tf: partF
        nid: valNid
        ctype: ""
        :constant
        twice: (rtTwice :ctx id: body hole: (rtHoleId slot: rtHole.slot.holeV))
        prefix: pre
    )
    rn.append (rtHoleId slot: rtHole.slot.holeV)
    if isResultval then {
        rv.append from: spelled.copy
    } else {
        (
            rv.append
            from: (
                castLitVal
                val: spelled.stringView
                dst: (constScalarKindForTid :typing tid: retTid)
            )
        )
    }
    filled: (
        rtFillForCtx
        :ast
        :reg
        :typing
        :ctx
        id: body
        path: key.stringView
        bindIds: bn
        bindVals: bv
        rawIds: rn
        rawVals: rv
    )
    if pre.length == 0 when (ctx.rows.rows.get i: row).value then {
        return (stating :facts from: (operandFacts e: valF place: false) text: filled)
    }
    return (stating :facts from: callFacts text: (orderWrap prefix: pre call: filled))
}


# cUpperOf -- ASCII upper-case for tag spellings.
cUpperOf: function {text: StringView} out String is {
    buf: String
    i: u64
    n: text.length
    buf.reserve :n
    for i < n loop {
        bo: text.byteAt :i
        if bo.some then {
            if bo >= 97 then {
                if bo <= 122 then {
                    buf.appendByte b: bo - 32
                } else {
                    buf.appendByte b: bo
                }
            } else {
                buf.appendByte b: bo
            }
        }
        i = i + 1
    }
    return buf
}

# cEscape -- escape literal text for a C string body. A control byte other
# than \n and \t is written in octal, which takes at most three digits, so a
# digit after it stays a digit (a hex escape would swallow it). A `?` after a
# `?` is escaped: C17 reads `??=` and its kin as trigraphs.
cEscape: function {text: StringView} out String is {
    buf: String
    i: u64
    n: text.length
    for i < n loop {
        bo: (text.byteAt :i).or d: 0
        if bo == 92 then {
            buf.append "\\\\"
        } else if bo == 34 then {
            buf.append "\\\""
        } else if bo == 10 then {
            buf.append "\\n"
        } else if bo == 9 then {
            buf.append "\\t"
        } else if (bo < 32) or (bo == 127) then {
            buf.appendByte b: 92
            buf.appendByte b: 48 + (bo >> 6)
            buf.appendByte b: 48 + ((bo >> 3) & 7)
            buf.appendByte b: 48 + (bo & 7)
        } else if bo == 63 when i > 0 when ((text.byteAt i: i - 1).or d: 0) == 63 then {
            buf.append "\\?"
        } else {
            buf.appendByte b: bo
        }
        i = i + 1
    }
    return buf
}

# substituteAll -- replace every occurrence of needle in text.
substituteAll: function {text: String needle: StringView repl: StringView} out String is {
    buf: String
    pos: u64
    total: text.length
    for pos < total loop {
        remv: text.substring from: pos to: total
        fo: remv.indexOf :needle
        match (
            fo
        ) case some then {
            pre: remv.substring from: 0 to: fo
            buf.append pre
            buf.append repl
            pos = pos + fo + needle.length
        } case none then {
            buf.append remv
            pos = total
        }
    }
    return buf
}

# emitFillFails -- report each failure a fill gathered through the emit-failure
# channel, so a bad fragment or row fails the run
emitFillFails: function {ctx: Ctx fails: (List String).view} is {
    for each m: fails loop emitFail :ctx what: m.copy line: 0
}


# PiecedText -- a native text cut into pieces as its reader reads it, before
# RtTexts cuts its holes: the C (each piece's text and its line break, no
# marker), the pieces' names and needs (`heads`, kept beside the C), and where
# each piece lies
PiecedText: class {
    text: String
    heads: String
    pieces: ListVal rtpiece
} as {
    # plain -- text written wherever the text is, as it stands
    plain: function {:this text: StringView} is {
        this.text.append text
        this.text.append "\n"
    }

    # plainLines -- plain, for `text` that holds its own line breaks
    plainLines: function {:this text: StringView} is {
        this.text.append text
    }

    # named -- the piece or section `name`, needing `needs` (comma-separated),
    # answering row `row` (zero for a member section), written where the program
    # reaches the type template key `reached` names (none: wherever): written
    # where its plan keeps it
    named: function {
        :this name: StringView needs: StringView row: u64 reached: StringView text: StringView
    } is {
        this.namedLines :name :needs :row :reached :text
        this.text.append "\n"
        last: this.pieces.length - 1
        pc: this.pieces.get i: last
        pc.bodyTo = this.text.length
        pc.next = this.text.length
        this.pieces.set i: last val: pc
    }

    # namedLines -- named, for `text` that holds its own line breaks
    namedLines: function {
        :this name: StringView needs: StringView row: u64 reached: StringView text: StringView
    } is {
        hf: this.heads.length
        this.heads.append name
        nt: this.heads.length
        this.heads.append " "
        nf: this.heads.length
        this.heads.append needs
        ne: this.heads.length
        this.heads.append " "
        rf: this.heads.length
        this.heads.append reached
        re: this.heads.length
        this.heads.append "\n"
        at: this.text.length
        this.text.append text
        (
            this.pieces.append
            (
                rtpiece
                :at
                bodyFrom: at
                bodyTo: this.text.length
                next: this.text.length
                headFrom: hf
                nameTo: nt
                needsFrom: nf
                needsTo: ne
                reachedFrom: rf
                reachedTo: re
                :row
            )
        )
    }
}

# newPiecedText -- a text with nothing in it yet
newPiecedText: function out PiecedText is {
    return (PiecedText text: String heads: String pieces: ListVal rtpiece)
}

# pieceRow -- the row of a piece named `name` of `owner`'s file or of the
# foundation (`prelude`), answering `demands` (or its name when the list is
# empty) and needing `needs`: written in place, by the text holding it, when a
# demand it answers fires
pieceRow: function {
    ctx: Ctx owner: StringView name: StringView demands: (List String).view needs: StringView
} out u64 is {
    r: beginDemands :ctx r: (zemitrows.blankRow owner: (ctx.demands.names.intern s: owner))
    for each d: demands loop r = addRowDemands :ctx :r dm: d.stringView
    if r.demandTo == r.demandFrom then r = addRowDemands :ctx :r dm: name
    if needs.length > 0 then r.needText = rowNeedText :ctx :needs
    row: appendFragmentRow :ctx :r
    ctx.rowsInPlace.add item: row
    return row
}

# rtid -- a parsed runtime text's id in RtTexts (zemitrows.rtid: a row holds
# its body's)
rtid: zemitrows.rtid

# rtsegkind -- what one stretch of a parsed runtime text is (rtseg)
rtsegkind: variant {
    # text written as it stands
    literal: null
    # a `@Name@` hole, which a fill takes from its bindings
    hole: null
    # a `@@KEY@@` template key, or a piece marker's `@@...@@` run, which a fill
    # writes as it stands
    key: null
} as { tag: u8.tag }

# rtseg -- one stretch of a parsed runtime text, in text order: its bytes, and
# the name between a hole's `@`s or a key's `@@`s, interned in RtTexts.holes or
# RtTexts.keys
rtseg: record {
    kind: rtsegkind
    from: u64
    to: u64
    name: zast.nameid
}

# rtinfo -- where a parsed text's stretches lie in RtTexts.segs, and what a fill
# would otherwise search its bytes for
rtinfo: record {
    segFrom: u64
    segTo: u64
    # its member sections or row pieces in RtTexts.pieces, in text order (rtpiece)
    pieceFrom: u64
    pieceTo: u64
    # a `@` opens a hole that no `@` closes, which every fill reports
    open: bool
    # a hole is an `@ARM_<canon>.<arm>@` tag constant (rtBindArms)
    arms: bool
    # a hole is an `@MEMBER_<canon>.<name>@` member (rtBindMembers)
    members: bool
    # the text is cut; a deferred one (RtTexts.defer) is not until `ready`
    parsed: bool
}

# rtpiece -- one member section of a template, or one row piece of a fixed file
# or a unit's fragment, as its reader read it (PiecedText): where it lies in
# the text, its name and needs in the text's heads, and the row it answers
rtpiece: record {
    # where it starts in the text, and its body: the piece's own text and its
    # line break (a piece has no marker, so the body is the whole piece)
    at: u64
    bodyFrom: u64
    bodyTo: u64
    # where the text resumes after it
    next: u64
    # its name in the text's heads (RtTexts.heads): from `headFrom` to `nameTo`
    headFrom: u64
    nameTo: u64
    # its needs there, comma-separated; empty when it has none
    needsFrom: u64
    needsTo: u64
    # the template key whose type the program must reach for a section to be
    # written (`MAPENTRY`), there; empty when the member alone decides
    reachedFrom: u64
    reachedTo: u64
    # the row a row piece answers (its demands and needs, written in place);
    # zero for a member section
    row: u64
}

# rtmark -- the next hole or key of a runtime text (rtNextMark)
rtmark: record {
    # a hole or a key opens at or after the point searched from
    found: bool
    # it is a lone `@` that no `@` closes: the rest of the text is text
    open: bool
    # it is a `@@KEY@@` key rather than a `@Name@` hole
    key: bool
    # its bytes, its `@`s included
    at: u64
    to: u64
}

# rtNextMark -- the first hole or key of `text` at or after `from`. A `@@` opens a
# key that runs to the next `@@` and a lone `@` a hole that runs to the next `@`,
# as fillHoles reads them; a `@@` nothing closes is text.
rtNextMark: function {text: StringView from: u64} out rtmark is {
    m: rtmark found: false open: false key: false at: text.length to: text.length
    pos: from
    total: text.length
    for pos < total loop {
        ao: (text.substring from: pos to: total).indexOf needle: "@"
        if ao.none then return m
        at: pos + ao
        if ((text.byteAt i: at + 1).or d: 0) != 64 then {
            ho: (text.substring from: at + 1 to: total).indexOf needle: "@"
            m.found = true
            m.at = at
            if ho.none then {
                m.open = true
            } else {
                m.to = at + 1 + ho + 1
            }
            return m
        }
        cl: (text.substring from: at + 2 to: total).indexOf needle: "@@"
        if cl.some then {
            m.found = true
            m.key = true
            m.at = at
            m.to = at + 2 + cl + 2
            return m
        }
        pos = at + 2
    }
    return m
}

# rtHole -- the holes the emitter binds by name, interned first in RtTexts.holes
# so each is known by its slot (rtHoleId)
rtHole: list {
    holeL: "L"
    holeR: "R"
    holeV: "V"
    holeA1: "A1"
    holeT: "T"
    holeRT: "RT"
    holeStringView: "StringView"
    holeString: "String"
    holeOkTag: "OKTAG"
    holeErrTag: "ERRTAG"
    holeOkMember: "OKMEMBER"
    holeErrMember: "ERRMEMBER"
    holeTagConverror: "TAG_converror"
} out staticlist StringView

# rtHoleId -- the id of rtHole's hole `slot`: the vocabulary interns its block
# in order after the sentinel
rtHoleId: function {slot: u64} out zast.nameid is {
    return (zast.nameid from: (slot + 1).u32.orPanic)
}

# RtTexts -- the runtime text the emitter fills, each text parsed once: a
# row's body when the row is recorded. A text is cut into literal
# stretches, holes and keys, so a fill walks the stretches once, appending, and
# a question about the holes a text spells (does it spell @T@, does it name @L@
# twice) reads its holes instead of searching its bytes on every use. A value a
# fill puts in a hole is never searched for holes again.
RtTexts: class {
    # the texts, by id; id 0 is the sentinel empty text
    texts: (List String i: rtid)
    # each text's pieces' names and needs, by id as `texts` is ("" for a text
    # with no pieces): what a piece is answers is kept beside the C, not in it
    heads: (List String i: rtid)
    # each text's stretches and facts, by id as `texts` is
    infos: (ListVal rtinfo i: rtid)
    # every text's stretches, each text's in one run (rtinfo)
    segs: ListVal rtseg
    # every text's member sections or row pieces, each text's in one run (rtinfo)
    pieces: ListVal rtpiece
    # the hole names, rtHole's first
    holes: zast.Vocab
    # the key names
    keys: zast.StringPool
    # the table binding no key, for a fill that binds none
    noKeys: RtKeys
} as {
    # create -- the pool holding only the sentinel
    create: function {} out this is {
        r: (
            meta.create
            texts: (List String i: rtid)
            heads: (List String i: rtid)
            infos: (ListVal rtinfo i: rtid)
            segs: ListVal rtseg
            pieces: ListVal rtpiece
            holes: (zast.Vocab.create block: rtHole)
            keys: zast.StringPool.createEmpty
            noKeys: RtKeys.create
        )
        r.texts.append "".string
        r.heads.append "".string
        r.infos.append (
            rtinfo
            segFrom: 0
            segTo: 0
            pieceFrom: 0
            pieceTo: 0
            open: false
            arms: false
            members: false
            parsed: true
        )
        return r
    }

    # parse -- cut `text` into its stretches, and keep it: its id (rtNextMark
    # finds each hole and key)
    parse: function {:this text: StringView} out rtid is {
        this.infos.append (this.cut :text)
        this.heads.append "".string
        return (this.texts.append text.string)
    }

    # parsePieced -- `x`'s text cut into its stretches and kept with its pieces
    # and their heads, as its reader cut it: its id
    parsePieced: function {:this x: PiecedText.take} out rtid is {
        # a stretch never crosses a piece's edge: each is written or not with
        # its piece
        edges: ListVal u64
        for each p: x.pieces loop {
            edges.append p.at
            edges.append p.next
        }
        inf: this.cutAt text: x.text.stringView :edges
        inf.pieceFrom = this.pieces.length
        for each p: x.pieces loop this.pieces.append p
        inf.pieceTo = this.pieces.length
        this.infos.append inf
        hd: String
        hd swap x.heads
        this.heads.append hd.take
        tx: String
        tx swap x.text
        return (this.texts.append tx.take)
    }

    # defer -- keep `text` uncut: its id, which `ready` cuts on first use. A
    # row's body is kept so, as most rows go unused by a program
    defer: function {:this text: StringView} out rtid is {
        this.infos.append (
            rtinfo
            segFrom: 0
            segTo: 0
            pieceFrom: 0
            pieceTo: 0
            open: false
            arms: false
            members: false
            parsed: false
        )
        this.heads.append "".string
        return (this.texts.append text.string)
    }

    # ready -- text `id` cut, if it was deferred
    ready: function {:this id: rtid} is {
        if (this.infos.get i: id).parsed then return
        # cut where it stands: moved out of the list for the cut, which appends
        # to the other lists, then moved back
        t: this.texts.set i: id val: String
        this.infos.set i: id val: (this.cut text: t.stringView)
        this.texts.set i: id val: t.take
    }

    # cut -- `text`'s stretches appended, and where they lie
    cut: function {:this text: StringView} out rtinfo is {
        return (this.cutAt :text edges: ListVal u64)
    }

    # cutAt -- cut, with no literal stretch crossing any of `edges` (offsets in
    # rising order)
    cutAt: function {:this text: StringView edges: (ListVal u64).view} out rtinfo is {
        segFrom: this.segs.length
        pieceFrom: this.pieces.length
        open: false
        # what the holes and keys spell (addMark)
        spells: u64
        lit: u64
        for lit < text.length loop {
            m: rtNextMark :text from: lit
            if m.found.not or m.open then {
                open = m.open
                break
            }
            this.addLiterals from: lit to: m.at :edges
            spells = spells | (this.addMark :text :m)
            lit = m.to
        }
        this.addLiterals from: lit to: text.length :edges
        return (
            rtinfo
            :segFrom
            segTo: this.segs.length
            :pieceFrom
            pieceTo: this.pieces.length
            :open
            arms: (spells & 1) != 0
            members: (spells & 2) != 0
            parsed: true
        )
    }

    # addMark -- the hole or key `m` of `text` as a stretch, its name interned:
    # 1 when it is an ARM hole, 2 a MEMBER hole
    addMark: function {:this text: StringView m: rtmark} out u64 is {
        spells: u64
        hid: zast.nameid.zero
        k: rtsegkind.hole
        if m.key then {
            k = rtsegkind.key
            hid = this.keys.set s: (text.substring from: m.at + 2 to: m.to - 2)
        } else {
            nm: text.substring from: m.at + 1 to: m.to - 1
            if (nm.startsWith prefix: "ARM_") then spells = 1
            if (nm.startsWith prefix: "MEMBER_") then spells = 2
            hid = this.holes.pool.set s: nm
        }
        this.segs.append (rtseg kind: k from: m.at to: m.to name: hid)
        return spells
    }

    # addLiterals -- the text from `from` to `to` as literal stretches, cut at
    # each of `edges` inside it
    addLiterals: function {:this from: u64 to: u64 edges: (ListVal u64).view} is {
        at: from
        for each e: edges loop {
            if e > at when e < to then {
                this.addLiteral from: at to: e
                at = e
            }
        }
        this.addLiteral from: at :to
    }

    # addLiteral -- the text from `from` to `to` as a literal stretch, when there
    # is any
    addLiteral: function {:this from: u64 to: u64} is {
        if to > from then this.segs.append (
            rtseg
            kind: rtsegkind.literal
            :from
            :to
            name: zast.nameid.zero
        )
    }

    # holeCount -- how many times text `id` spells the hole `hole`
    holeCount: function {t: this.view id: rtid hole: zast.nameid} out u64 is {
        n: u64
        inf: t.infos.get i: id
        k: inf.segFrom
        for k < inf.segTo loop {
            sg: t.segs.get i: k
            if sg.kind.hole when sg.name == hole then n = n + 1
            k = k + 1
        }
        return n
    }

    # holeNamed -- the id of the hole spelled `name`, zero when no text spells it
    holeNamed: function {t: this.view name: StringView} out zast.nameid is {
        return (t.holes.pool.find s: name)
    }

    # holesNamed -- each distinct hole of text `id` whose name starts with
    # `prefix`, in the order first spelled: its id, and its name
    holesNamed: function {
        t: this.view
        id: rtid
        prefix: StringView
        ids: ListVal zast.nameid
        names: List String
    } is {
        inf: t.infos.get i: id
        k: inf.segFrom
        for k < inf.segTo loop {
            sg: t.segs.get i: k
            k = k + 1
            if sg.kind.hole.not then continue
            seen: false
            for each d: ids loop {
                if d == sg.name then seen = true
            }
            if seen then continue
            nm: t.holes.pool.texts.get i: sg.name
            nv: nm.stringView
            if (nv.startsWith :prefix) then {
                ids.append sg.name
                names.append from: nv.string
            }
        }
    }

    # fillSpan -- append bytes `from` to `to` of text `id` to `buf`: each key the
    # table `keys` binds filled from it (rtAppendKey); when `holes`, each hole from
    # the bindings, a cname binding (`bindIds`) without its `z_` prefix, which
    # the text spells itself (`z_@File@_t`), a raw one (`rawIds`) as it stands
    # (rtAppendHole), and a hole bound to nothing a failure added to `fails`
    # naming `path`. Every other key and hole is written as it stands.
    fillSpan: function {
        v: this.view
        id: rtid
        from: u64
        to: u64
        keys: RtKeys.view
        bindIds: (ListVal zast.nameid).view
        bindVals: (List String).view
        rawIds: (ListVal zast.nameid).view
        rawVals: (List String).view
        holes: bool
        path: StringView
        fails: List String
        buf: String.borrow
    } is {
        t: v.texts.get i: id
        tv: t.stringView
        inf: v.infos.get i: id
        k: inf.segFrom
        if from > 0 then k = v.segAt :inf at: from
        for k < inf.segTo loop {
            sg: v.segs.get i: k
            if sg.from >= to then break
            k = k + 1
            if (sg.from < from) or (sg.to > to) then {
                # a literal the span cuts: no hole or key straddles a span's end
                buf.append (tv.substring from: (rtClipFrom :sg :from) to: (rtClipTo :sg :to))
                continue
            }
            run: tv.substring from: sg.from to: sg.to
            if sg.kind.literal then {
                buf.append run
            } else if sg.kind.key then {
                if (rtAppendKey :buf name: sg.name :keys).not then buf.append run
            } else if holes.not then {
                buf.append run
            } else if (rtAppendHole :buf name: sg.name :bindIds :bindVals :rawIds :rawVals
            ).not then {
                fails.append from: "fragment \{path}: hole \{run} is bound to nothing"
                buf.append run
            }
        }
    }

    # segAt -- the first of text `inf`'s stretches that ends after byte `at`
    segAt: function {t: this.view inf: rtinfo at: u64} out u64 is {
        lo: inf.segFrom
        hi: inf.segTo
        for lo < hi loop {
            mid: lo + (hi - lo / 2)
            if (t.segs.get i: mid).to <= at then lo = mid + 1 else hi = mid
        }
        return lo
    }

    # keyNames -- each distinct key text `id` spells, in the order first spelled
    keyNames: function {t: this.view id: rtid names: List String} is {
        ids: ListVal zast.nameid
        inf: t.infos.get i: id
        k: inf.segFrom
        for k < inf.segTo loop {
            sg: t.segs.get i: k
            k = k + 1
            if sg.kind.key.not then continue
            seen: false
            for each d: ids loop {
                if d == sg.name then seen = true
            }
            if seen then continue
            ids.append sg.name
            names.append from: (t.keys.texts.get i: sg.name).copy
        }
    }
}

# RtKeys -- an instance's template keys and the text each fills with
# (fillSpan): the instance's writer binds each one before the template is
# written once
RtKeys: class {
    # each bound key, interned in RtTexts.keys
    ids: ListVal zast.nameid
    # the text each fills with
    vals: List String
} as {
    # create -- the table binding no key
    create: function {} out this is {
        return (meta.create ids: ListVal zast.nameid vals: List String)
    }
}

# rtKey -- bind template key `name` to `val` in `keys`. A key bound twice keeps
# its first value: the first substitution of a key leaves nothing for a second
# to find.
rtKey: function {ctx: Ctx keys: RtKeys name: StringView val: StringView} is {
    keys.ids.append (ctx.rt.keys.set s: name)
    keys.vals.append from: val.string
}

# rtKeyBound -- `keys` binds the key `name`
rtKeyBound: function {ctx: Ctx.view keys: RtKeys.view name: StringView} out bool is {
    kid: ctx.rt.keys.find s: name
    if kid.isZero then return false
    for each d: keys.ids loop {
        if d == kid then return true
    }
    return false
}

# rtAppendKey -- append the text `keys` binds key `name` to, to `buf`, and
# answer whether it binds it
rtAppendKey: function {buf: String.borrow name: zast.nameid keys: RtKeys.view} out bool is {
    ki: u64
    for ki < keys.ids.length loop {
        if (keys.ids.get i: ki) == name then {
            buf.append (keys.vals.get i: ki)
            return true
        }
        ki = ki + 1
    }
    return false
}

# rtEmpty -- text `id` is empty: a template that could not be read
rtEmpty: function {ctx: Ctx.view id: rtid} out bool is {
    return (ctx.rt.texts.get i: id).length == 0
}

# rtSpellsKey -- text `id` spells the key `name`
rtSpellsKey: function {ctx: Ctx.view id: rtid name: StringView} out bool is {
    kid: ctx.rt.keys.find s: name
    if kid.isZero then return false
    inf: ctx.rt.infos.get i: id
    k: inf.segFrom
    for k < inf.segTo loop {
        sg: ctx.rt.segs.get i: k
        if sg.kind.key when sg.name == kid then return true
        k = k + 1
    }
    return false
}

# rtFillKeys -- the whole of text `id` with the keys `keys` binds filled, every
# other key and every hole written as it stands
rtFillKeys: function {ctx: Ctx.view id: rtid keys: RtKeys.view} out String is {
    buf: String
    fails: List String
    (
        ctx.rt.fillSpan
        :id
        from: 0
        to: (ctx.rt.texts.get i: id).length
        :keys
        bindIds: ListVal zast.nameid
        bindVals: List String
        rawIds: ListVal zast.nameid
        rawVals: List String
        holes: false
        path: ""
        :fails
        :buf
    )
    return buf
}

# rtHas -- text `id` spells the hole rtHole `slot`
rtHas: function {ctx: Ctx.view id: rtid slot: u64} out bool is {
    return (ctx.rt.holeCount :id hole: (rtHoleId :slot)) > 0
}

# rtTwice -- text `id` spells the hole `hole` more than once: the part filling it
# is read into a temp (orderNamesTwice)
rtTwice: function {ctx: Ctx.view id: rtid hole: zast.nameid} out bool is {
    return (ctx.rt.holeCount :id :hole) > 1
}

# rtClipFrom -- where stretch `sg` starts within a span starting at `from`
rtClipFrom: function {sg: rtseg from: u64} out u64 is {
    if from > sg.from then return from
    return sg.from
}

# rtClipTo -- where stretch `sg` ends within a span ending at `to`
rtClipTo: function {sg: rtseg to: u64} out u64 is {
    if to < sg.to then return to
    return sg.to
}

# rtAppendHole -- append the text hole `name` fills with to `buf`, and answer
# whether anything binds it: appendHoleBinding, by hole id
rtAppendHole: function {
    buf: String.borrow
    name: zast.nameid
    bindIds: (ListVal zast.nameid).view
    bindVals: (List String).view
    rawIds: (ListVal zast.nameid).view
    rawVals: (List String).view
} out bool is {
    bi: u64
    for bi < bindIds.length loop {
        if (bindIds.get i: bi) == name then {
            v: bindVals.get i: bi
            vv: v.stringView
            if (vv.startsWith prefix: "z_") then buf.append (vv.substring from: 2 to: vv.length)
            return true
        }
        bi = bi + 1
    }
    ri: u64
    for ri < rawIds.length loop {
        if (rawIds.get i: ri) == name then {
            buf.append (rawVals.get i: ri)
            return true
        }
        ri = ri + 1
    }
    return false
}

# rtFillForCtx -- a row's body `id` filled: its tag-constant and
# member holes bound first (rtBindPrefixed), and each failure reported through
# the emit-failure channel
rtFillForCtx: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    id: rtid
    path: StringView
    bindIds: ListVal zast.nameid
    bindVals: List String
    rawIds: ListVal zast.nameid
    rawVals: List String
} out String is {
    inf: ctx.rt.infos.get i: id
    if inf.arms then rtBindHoles :ast :reg :typing :ctx :id arms: true :rawIds :rawVals
    if inf.members then rtBindHoles :ast :reg :typing :ctx :id arms: false :rawIds :rawVals
    ferr: List String
    cur: String
    (
        ctx.rt.fillSpan
        :id
        from: 0
        to: (ctx.rt.texts.get i: id).length
        keys: ctx.rt.noKeys
        :bindIds
        :bindVals
        :rawIds
        :rawVals
        holes: true
        :path
        fails: ferr
        buf: cur
    )
    if inf.open then ferr.append from: "fragment \{path}: unterminated hole"
    emitFillFails :ctx fails: ferr
    return cur
}

# rtFragHoles -- each distinct hole of text `id` that plan `plan` writes (every
# one when `all`), in the order first spelled
rtFragHoles: function {
    ctx: Ctx.view
    plan: RtPlan.view
    all: bool
    ids: ListVal zast.nameid
    names: List String
} is {
    inf: ctx.rt.infos.get i: plan.id
    k: inf.segFrom
    for k < inf.segTo loop {
        sg: ctx.rt.segs.get i: k
        k = k + 1
        if sg.kind.hole.not then continue
        if all.not when (rtPlanWrites :ctx :plan at: sg.from).not then continue
        seen: false
        for each d: ids loop {
            if d == sg.name then seen = true
        }
        if seen then continue
        ids.append sg.name
        names.append from: (ctx.rt.holes.pool.texts.get i: sg.name).copy
    }
}

# rtTagTypeHole -- text `id` spells `z_@<hole>@_tag_t`, the tag enum of the type
# the hole names: the hole, then a literal starting `_tag_t`
rtTagTypeHole: function {ctx: Ctx.view id: rtid hole: zast.nameid} out bool is {
    inf: ctx.rt.infos.get i: id
    t: ctx.rt.texts.get i: id
    tv: t.stringView
    k: inf.segFrom
    for (k + 1) < inf.segTo loop {
        sg: ctx.rt.segs.get i: k
        k = k + 1
        if sg.kind.hole.not or (sg.name != hole) then continue
        nx: ctx.rt.segs.get i: k
        if nx.kind.literal.not then continue
        if ((tv.substring from: nx.from to: nx.to).startsWith prefix: "_tag_t") then return true
    }
    return false
}

# rtFragmentText -- a runtime fragment or an instantiated class template, parsed
# (`id`), as plan `plan` writes it with its `z_@Name@` holes filled. The holes it
# writes (every one when `all`) ARE the demand: each name resolves through
# StringView/String or the canon path, and a name that resolves to nothing is
# fatal. A `@TAG_<canon>@` hole is how to reach that type's discriminator, an
# `@ARM_<canon>.<arm>@` hole a tag constant (armHoleC), an
# `@MEMBER_<canon>.<name>@` hole a member (memberHoleC).
rtFragmentText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    plan: RtPlan.view
    all: bool
    # the text, for its mark and the messages
    key: textkey
} out String is {
    path: textLabel :ctx :key
    bn: ListVal zast.nameid
    bv: List String
    rn: ListVal zast.nameid
    rv: List String
    hids: ListVal zast.nameid
    hnames: List String
    rtFragHoles :ctx :plan :all ids: hids names: hnames
    k: u64
    for k < hids.length loop {
        (
            rtFragHole
            :ast
            :reg
            :typing
            :ctx
            id: plan.id
            hole: (hids.get i: k)
            name: (hnames.get i: k).stringView
            path: path.stringView
            :bn
            :bv
            :rn
            :rv
        )
        k = k + 1
    }
    rtBindPrefixed :ast :reg :typing :ctx ids: hids names: hnames arms: true rawIds: rn rawVals: rv
    rtBindPrefixed :ast :reg :typing :ctx ids: hids names: hnames arms: false rawIds: rn rawVals: rv
    ferr: List String
    res: (
        rtRenderWith
        :ctx
        :plan
        keys: ctx.rt.noKeys
        bindIds: bn
        bindVals: bv
        rawIds: rn
        rawVals: rv
        holes: true
        :key
        fails: ferr
    )
    if (ctx.rt.infos.get i: plan.id).open then {
        ferr.append from: "fragment \{path}: unterminated hole"
    }
    emitFillFails :ctx fails: ferr
    return res
}

# rtFragHole -- bind the fragment hole `name` (`hole`): a `@TAG_<canon>@` to
# `.tag`, or to nothing for a type the backend has unwrapped, which IS its
# discriminator; a `@BOX_<type>.<protocol>@` to the function lending the type
# as the protocol (boxHoleC); StringView and String to their C names; any other
# name to the C name of the type its canon names. An ARM or MEMBER hole is bound
# apart (rtBindPrefixed).
rtFragHole: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    id: rtid
    hole: zast.nameid
    name: StringView
    path: StringView
    bn: ListVal zast.nameid
    bv: List String
    rn: ListVal zast.nameid
    rv: List String
} is {
    if (name.startsWith prefix: "ARM_") or (name.startsWith prefix: "MEMBER_") then return
    if (name.startsWith prefix: "TAG_") then {
        tt: stemTid :ast :reg :typing :ctx canon: (name.substring from: 4 to: name.length)
        rn.append hole
        tagv: ".tag"
        if (isOrdinalVariant :typing tid: tt) then tagv = ""
        rv.append from: tagv.string
        return
    }
    bn.append hole
    if (name.startsWith prefix: "BOX_") then {
        bc: boxHoleC :ast :reg :typing :ctx box: (name.substring from: 4 to: name.length) :path
        bv.append from: bc
        return
    }
    hw: ctx.nativeWords.slotOf text: name
    if hw == nativeWord.slot.holeStringView then {
        preludeNeed :ctx memb: "@StringView_t"
        bv.append from: ctx.svC.copy
        return
    }
    if hw == nativeWord.slot.holeString then {
        preludeNeed :ctx memb: "@String_t"
        bv.append from: ctx.strC.copy
        return
    }
    cc: stemCname :ast :reg :typing :ctx canon: name
    # `z_@X@_tag_t` spells X's tag enum
    if (rtTagTypeHole :ctx :id :hole) then (
        noteTagEnumUse
        :ctx
        :reg
        tid: (stemTid :ast :reg :typing :ctx canon: name)
    )
    # a type-name hole that resolves to nothing is reported here, not left
    # for the C compiler to find as `z__t`; the TAG channel above is where an
    # empty fill is legitimate
    if cc.length == 0 then {
        emitFail :ctx what: "fragment \{path}: hole @\{name}@ names no type in this program" line: 0
    }
    bv.append from: cc
}

# boxHoleC -- the C function a `@BOX_<type>.<protocol>@` hole names, which lends
# a `<type>` as the `<protocol>` (`<type>_<label>_create`, the label the type
# implements the protocol under); the fill writes it minus its z_, as every
# hole's C name. demandRowBoxes has noted the box; one that names no type, or
# that the type does not implement, is reported.
boxHoleC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    box: StringView
    path: StringView
} out String is {
    it: boxTidOf :ast :reg :typing :ctx one: box wantProtocol: false
    pt: boxTidOf :ast :reg :typing :ctx one: box wantProtocol: true
    lbl: String
    if it.notZero when pt.notZero then lbl = (
        boxLabelFor
        :reg
        :typing
        :ctx
        implTid: it
        protoTid: pt
    )
    if lbl.length == 0 then {
        (
            emitFail
            :ctx
            what: "fragment \{path}: hole @BOX_\{box}@ names no box in this program"
            line: 0
        )
        return "".string
    }
    fn: spelledCname :ctx tid: it
    fn.append "_"
    fn.append lbl
    fn.append "_create"
    return fn
}

# rtBindHoles -- bind each ARM hole (when `arms`) or MEMBER hole of the row body
# `id` (rtBindPrefixed)
rtBindHoles: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    id: rtid
    arms: bool
    rawIds: ListVal zast.nameid
    rawVals: List String
} is {
    hids: ListVal zast.nameid
    hnames: List String
    prefix: "MEMBER_"
    if arms then prefix = "ARM_"
    ctx.rt.holesNamed :id :prefix ids: hids names: hnames
    rtBindPrefixed :ast :reg :typing :ctx ids: hids names: hnames :arms :rawIds :rawVals
}

# rtBindPrefixed -- bind each hole of `ids` / `names` that is an `ARM_` hole
# (armHoleC) when `arms`, a `MEMBER_` hole (memberHoleC) otherwise, to the C it
# names; one that names nothing is left unbound, which the fill reports
rtBindPrefixed: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    ids: (ListVal zast.nameid).view
    names: (List String).view
    arms: bool
    rawIds: ListVal zast.nameid
    rawVals: List String
} is {
    prefix: "MEMBER_"
    if arms then prefix = "ARM_"
    k: u64
    for k < ids.length loop {
        nv: names.get i: k
        k = k + 1
        if (nv.stringView.startsWith :prefix).not then continue
        body: nv.stringView.substring from: prefix.length to: nv.length
        c: String
        if arms then {
            c = armHoleC :ast :reg :typing :ctx :body
        } else {
            c = memberHoleC :ast :reg :typing :ctx :body
        }
        if c.length > 0 then {
            rawIds.append (ids.get i: k - 1)
            rawVals.append from: c
        }
    }
}

# armHoleC -- the tag constant an ARM hole's `<canon>.<arm>` names, its use
# noted; "" when the canon names no type in this program or the type declares no
# such arm
armHoleC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the hole past its `ARM_`
    body: StringView
} out String is {
    dot: body.indexOf needle: "."
    if dot.none then return "".string
    tt: stemTid :ast :reg :typing :ctx canon: (body.substring from: 0 to: dot)
    aid: zast.poolFind pool: ast.names text: (body.substring from: dot + 1 to: body.length)
    ord: armOrdinalOf :reg :typing tid: tt armId: aid
    if ord.none then return "".string
    noteTagConstUse :ctx :reg :typing tid: tt
    return (tagConstC :ast :ctx :reg :typing tid: tt armOrd: ord)
}

# memberHoleC -- the C name of the member a MEMBER hole's `<canon>.<name>`
# names, "" when the canon names no type or the type declares no such member.
memberHoleC: function {
    # the member's name is interned here
    ast: Ast.view
    # the program the canon is resolved in
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the emission context memberC is spelled through
    ctx: Ctx
    # the hole past its `MEMBER_`
    body: StringView
} out String is {
    dot: body.indexOf needle: "."
    if dot.none then return "".string
    tt: stemTid :ast :reg :typing :ctx canon: (body.substring from: 0 to: dot)
    mid: zast.poolFind pool: ast.names text: (body.substring from: dot + 1 to: body.length)
    if tt.isZero or mid.isZero then return "".string
    k: memberkind.field
    ttt: reg.typetypeOf typeId: (chaseAggregateTypedef :reg :typing :ctx tid: tt)
    if ttt == ztypes.ztypetype.variantType then k = memberkind.arm
    if ttt == ztypes.ztypetype.unionType then k = memberkind.inlineArm
    if (ttt == ztypes.ztypetype.protocolType) or (ttt == ztypes.ztypetype.facetType) then {
        k = memberkind.slot
    }
    if (memberOrdinal :reg :typing :ctx owner: tt kind: k nameId: mid).none then return "".string
    return (memberC :ast :reg :typing :ctx owner: tt kind: k nameId: mid)
}

# textkind -- what a native text zc carries is
textkind: variant {
    # no text: a body written for a row has no text of its own
    none: null
    # one of the files every program's C is written from (`head`, `alloc`)
    fixedFile: null
    # a row's fragment, by the name the row gives it
    fragment: null
    # a template a class or a container is written from (`List`)
    template: null
} as { tag: u8.tag }

# textkey -- a native text by its kind (a textkind's tag) and its name (by id in
# Ctx.textNames)
textkey: record {
    kind: u8
    name: u32
}

# noText -- the key of no text
noText: function out textkey is {
    return (textkey kind: textkind.none.tag name: 0)
}

# textKey -- the key of the text of kind `kind` named `name`
textKey: function {ctx: Ctx kind: textkind name: StringView} out textkey is {
    if ctx.textNames.length == 0 then ctx.textNames.append "".string
    id: (ctx.textIds.get key: name.string).or d: 0
    if id == 0 then {
        id = ctx.textNames.length.u32.orPanic
        ctx.textIds.set key: name.string value: id
        ctx.textNames.append from: name.string
    }
    return (textkey kind: kind.tag name: id)
}

# fileKey -- the key of fixed file `name`
fileKey: function {ctx: Ctx name: StringView} out textkey is {
    return (textKey :ctx kind: textkind.fixedFile :name)
}

# fragKey -- the key of fragment `name`
fragKey: function {ctx: Ctx name: StringView} out textkey is {
    return (textKey :ctx kind: textkind.fragment :name)
}

# tmplKey -- the key of template `name`
tmplKey: function {ctx: Ctx name: StringView} out textkey is {
    return (textKey :ctx kind: textkind.template :name)
}

# textLabel -- text `key` as a message names it: `fixed file head`, `fragment
# _Z_F16`, `template List`; "" for no text
textLabel: function {ctx: Ctx.view key: textkey} out String is {
    if key.kind == textkind.none.tag then return String
    r: "template ".string
    if key.kind == textkind.fixedFile.tag then r = "fixed file ".string
    if key.kind == textkind.fragment.tag then r = "fragment ".string
    r.append (ctx.textNames.get i: key.name.u64)
    return r
}

# textOf -- the native text `key` names. A text zc does not carry is fatal and
# reported once (the "" is kept so it is not asked again); no text zc carries
# is empty, so a kept "" is unambiguously the missing one.
textOf: function {ctx: Ctx key: textkey} out String is {
    {
        got: ctx.texts.get :key
        if got.some then {
            return got.copy
        }
    }
    emitFail :ctx what: "zc carries no \{textLabel :ctx :key}" line: 0
    ctx.texts.set :key value: String
    return String
}

# setText -- `text` as the native text `key` names
setText: function {ctx: Ctx key: textkey text: String.take} is {
    ctx.texts.set :key value: text.take
}

# tmplTextOf -- a template's text, parsed once (RtTexts), for writing an
# instance of it, and its needs (the runtime the template calls, kept when it
# was read) registered at every instance as a row's are
tmplTextOf: function {ctx: Ctx key: textkey} out rtid is {
    id: tmplParsed :ctx :key
    nds: String
    {
        got: ctx.tmplNeeds.get :key
        if got.some then {
            nds = got.copy
        }
    }
    for each nd: (nds.stringView.split sep: ",") loop {
        if nd.length > 0 then rowNeedAddOne :ctx uname: "" need: nd
    }
    return id
}

# tmplParsed -- native text `key` parsed (RtTexts) on its first read and kept
# by key: a pieced text (a template, a fixed file, a fragment of pieces) with
# the pieces its reader cut
tmplParsed: function {ctx: Ctx key: textkey} out rtid is {
    id: (ctx.tmplTexts.get :key).or d: rtid.zero
    if id.notZero then return id
    po: ctx.piecedTexts.remove :key
    match (
        po
    ) case some then {
        id = ctx.rt.parsePieced x: po.take
    } case none then {
        raw: textOf :ctx :key
        id = ctx.rt.parse text: raw.stringView
    }
    ctx.tmplTexts.set :key value: id
    return id
}

# cReserved -- the words an emitted identifier must not collide with, so a local
# variable whose zerolang name is one of them is emitted as `v_<name>`: the C statement keywords (a local named one would be read as the
# statement it spells); the type specifiers, aggregate introducers and
# signedness words a declaration's type slot may hold; the storage classes and
# qualifiers a declaration may carry and `sizeof`; and the three library or
# entry-point names an emitted translation unit already defines, `main`, `abs`
# and `exit`. Read through ctx.cWords (zast.Vocab).
cReserved: list {
    kBreak: "break"
    kContinue: "continue"
    kReturn: "return"
    kSwitch: "switch"
    kCase: "case"
    kDefault: "default"
    kIf: "if"
    kElse: "else"
    kFor: "for"
    kWhile: "while"
    kDo: "do"
    kGoto: "goto"
    kInt: "int"
    kFloat: "float"
    kDouble: "double"
    kChar: "char"
    kVoid: "void"
    kBool: "bool"
    kLong: "long"
    kShort: "short"
    kSigned: "signed"
    kUnsigned: "unsigned"
    kStruct: "struct"
    kUnion: "union"
    kEnum: "enum"
    kStatic: "static"
    kConst: "const"
    kAuto: "auto"
    kRegister: "register"
    kExtern: "extern"
    kVolatile: "volatile"
    kInline: "inline"
    kRestrict: "restrict"
    kTypedef: "typedef"
    kSizeof: "sizeof"
    kMain: "main"
    kAbs: "abs"
    kExit: "exit"
} out staticlist StringView

# isCReserved -- `name` is one of cReserved's words.
isCReserved: function {cw: zast.Vocab.view name: StringView} out bool is {
    return (cw.slotOf text: name) != cw.none
}

# `name` mangled to a C-safe local identifier, dodging C reserved words.
mangleVarName: function {name: StringView cw: zast.Vocab.view} out String is {
    if (isCReserved :cw :name) then return ("v_".concat name)
    return name.string
}

# ClassRow -- a class whose C the runtime owns (a classRow of its unit's file).
# Its struct is laid out from its declaration as a record's is; the row adds
# what a declaration cannot say -- the fragment that destroys one (an fd closed
# once, a handle released) and the canons whose presence makes it LIVE, the
# moment its declared implementations need their native methods' addresses.
ClassRow: class {
    # the unit's name, `io`
    uname: String
    # the class's name, `File`
    cls: String
    # comma-separated canons, all of which must exist for the class to be live
    live: String
    # the destructor fragment's name; "" for none
    destroy: String
    # the C template a GENERIC class is instantiated from, one copy per
    # instance (emitTmplClassMono); "" for a class laid out from its declaration
    tmpl: String
    # comma-separated: what a templated class's instances call
    # (demandTmplClassNeeds)
    need: String
}

# UnitReq -- a link, source or refusal of a unit's file: what the unit (or its
# subunit) needs from the C toolchain when a program reaches it. The facts are this backend's, so they live in its table
# rather than in the unit, which says nothing about how it is built.
UnitReq: class {
    # the unit's dotted path, `system.quadfloat`
    path: String
    # a refusal's: the C feature its types are built on
    feature: String
    # a refusal's: the C compiler families that cannot build it, comma-separated
    nocc: String
    # a refusal's: the target architectures that can, comma-separated; empty
    # for every one
    arch: String
    # a link's or a source's: the target operating systems it is for,
    # comma-separated oskind arm names; empty for every one
    os: String
    # a link's: the library its runtime links
    link: String
    # a source's: a C source its runtime needs compiled and linked, a path under
    # the vendor directory (sqlite/sqlite3.c)
    csrc: String
    # a source's: the defines it is compiled with, comma-separated
    cdefs: String
}

# newUnitReq -- a requirement of unit `path` setting nothing yet
newUnitReq: function {path: String.take} out UnitReq is {
    return (
        UnitReq
        path: path.take
        feature: String
        nocc: String
        arch: String
        os: String
        link: String
        csrc: String
        cdefs: String
    )
}

# memberWord -- the template members an instance's text is cut into (its
# sections, PiecedText): a member written C calls is recorded by its instance
# and its slot here (noteMemberUse), never by its spelling.
memberWord: list {
    destroy: "destroy"
    create: "create"
    grow: "grow"
    append: "append"
    set: "set"
    pop: "pop"
    find: "find"
    add: "add"
    has: "has"
    delete: "delete"
    getOne: "get"
    remove: "remove"
    getMut: "getMut"
    getv: "getv"
    hasv: "hasv"
    deletev: "deletev"
    iterateAll: "iterate"
    hashItem: "hash_item"
    itemsEqual: "items_equal"
    hashKey: "hash_key"
    keysEqual: "keys_equal"
    hashSlot: "slot"
    entriesCap: "entries_cap"
    itemsCap: "items_cap"
    keyAt: "keyAt"
    valueAt: "valueAt"
    lengthOf: "length"
    size: "size"
    string: "string"
    toStr: "to"
    call: "call"
    capacity: "capacity"
    compareExchange: "compareExchange"
    copy: "copy"
    destroyElem: "destroyElem"
    detach: "detach"
    exchange: "exchange"
    fetchAdd: "fetchAdd"
    fetchSub: "fetchSub"
    id: "id"
    isFinished: "isFinished"
    join: "join"
    load: "load"
    lock: "lock"
    notifyAll: "notifyAll"
    notifyOne: "notifyOne"
    read: "read"
    receive: "receive"
    run: "run"
    send: "send"
    sender: "sender"
    share: "share"
    store: "store"
    tryReceive: "tryReceive"
    value: "value"
    wait: "wait"
    waitTimeout: "waitTimeout"
    write: "write"
    insert: "insert"
    extend: "extend"
    resize: "resize"
    contains: "contains"
    eq: "eq"
    sort: "sort"
    iterateReverse: "iterateReverse"
    iterateMut: "iterateMut"
    iterateItems: "iterateItems"
    listView: "listView"
    extendView: "extendView"
    slice: "slice"
    fill: "fill"
    clear: "clear"
    indexEmpty: "index_empty"
    indexDeleted: "index_deleted"
} out staticlist StringView

# nativeWord -- the words the rows and the runtime fragments spell that the
# loader acts on: the demand a unit-wide row answers, the runtime units it
# orders specially, the two type holes the emitter fills itself, and the arms
# of a checked file's choices.
# Read through a zast.Vocab (ctx.nativeWords), never compared as text.
nativeWord: list {
    unitDemand: "@unit"
    unitPrelude: "prelude"
    holeString: "String"
    holeStringView: "StringView"
    # the unit whose implementation file holds the foundation
    unitSystem: "system"
    # the arms of a checked implementation file's choices, by name (checkedRow)
    armValue: "value"
    armSimple: "simple"
    armArgument: "argument"
    armParse: "parse"
    armNoArguments: "noArguments"
    # the shapes a structural row's key names (rowShapeOf)
    shapeScalar: "scalar"
    shapeVariant: "variant"
    shapeRecord: "record"
} out staticlist StringView

# recordCanon -- a unit's canonical stem: the generic instance a runtime
# fragment spells as the hole <stem>, its template then each type argument
# (`spec`, comma-separated), kept by stem for stemInstanceTid
recordCanon: function {ctx: Ctx stem: StringView spec: StringView} is {
    ctx.canonSpecs.set key: stem.string value: spec.string
}

# recordUnitOrder -- the `@units` pseudo-row: not a row but the order the
# units' runtimes run in, comma-separated
recordUnitOrder: function {ctx: Ctx order: StringView} is {
    for each ou: (order.split sep: ",") loop {
        if ou.length > 0 then ctx.unitOrder.append from: ou.string
    }
}

# beginDemands -- row `r` as a fragment row whose demands follow
# (addRowDemands), its span opening where the table's demands end
beginDemands: function {ctx: Ctx.view r: zemitrows.nativerow} out zemitrows.nativerow is {
    fr: r
    fr.fragment = true
    fr.demandFrom = ctx.rows.demandKeys.length
    fr.demandTo = fr.demandFrom
    return fr
}

# endDemands -- fragment row `r`, keyed `key`, with its demands closed: a row
# whose file names none answers the key's last segment, a helper's (`@name`)
# without its `@`
endDemands: function {ctx: Ctx r: zemitrows.nativerow key: StringView} out zemitrows.nativerow is {
    if r.demandTo > r.demandFrom then return r
    from: u64
    ld: key.lastIndexOf needle: "."
    match (
        ld
    ) case some then {
        from = ld + 1
    } case none then {
        if key.startsWith "@" then from = 1
    }
    return (addRowDemands :ctx :r dm: (key.substring :from to: key.length))
}

# addRowDemands -- demands `dm` (one, or comma-separated) onto fragment row
# `r`, whose span ends where the table's demands do. The row's first demand,
# when it is `uses_<Type>` or `destroys_<Type>`, is its type demand: the row
# fires where written C spells the type, or calls its destructor, and on any
# member the rest names.
addRowDemands: function {
    ctx: Ctx r: zemitrows.nativerow dm: StringView
} out zemitrows.nativerow is {
    fr: r
    if fr.demandTo == fr.demandFrom then {
        with uo: (dm.stripPrefix p: "uses_") do match (
            uo
        ) case some then {
            fr.typeName = (
                ctx.demands.names.intern
                s: (uo.substring from: 0 to: ((uo.indexOf needle: ",").or d: uo.length))
            )
        } case none then null
        with dso: (dm.stripPrefix p: "destroys_") do match (
            dso
        ) case some then {
            fr.typeName = (
                ctx.demands.names.intern
                s: (dso.substring from: 0 to: ((dso.indexOf needle: ",").or d: dso.length))
            )
            fr.destroys = true
        } case none then null
    }
    for each w: (dm.split sep: ",") loop {
        if w.length > 0 then ctx.rows.demandKeys.append (
            zemitrows.demandkey
            owner: fr.owner
            name: (ctx.demands.names.intern s: w)
        )
    }
    fr.demandTo = ctx.rows.demandKeys.length
    return fr
}

# appendFragmentRow -- fragment row `r` into the row table and its fragment
# rows; its place
appendFragmentRow: function {ctx: Ctx r: zemitrows.nativerow} out u64 is {
    ctx.rows.rows.append r
    row: ctx.rows.rows.length - 1
    ctx.rows.fragRows.append row
    return row
}

# rowNeedText -- a row's needs as its file writes them, kept to be read on
# first use (readRowNeeds): RowTable.needTexts' place plus one
rowNeedText: function {ctx: Ctx needs: StringView} out u64 is {
    ctx.rows.needTexts.append from: needs.string
    return ctx.rows.needTexts.length
}

# svcall -- how a call of a StringView native member is emitted
# (zemitrows.svcall: the `call` of the member's row)
svcall: zemitrows.svcall

# svCallOf -- how a call of the StringView native named `nameId` is emitted:
# its row's `call` (svcall.none when it has no row, or the row says none)
svCallOf: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx.view nameId: zast.nameid
} out svcall is {
    row: ctx.rows.ofName n: (rowNameOfMember :reg :typing :ctx owner: ctx.svTid name: nameId)
    if row == 0 then return svcall.none
    return (ctx.rows.rows.get i: row).call
}

# constBit -- a constant-operand variant's position (1-based, the receiver
# excluded) as its bit of nativerow.constMask; zero for a position past 64
constBit: function {position: u64} out u64 is {
    if (position == 0) or (position > 64) then return 0
    return 1.u64 << (position - 1)
}

# shapeRow -- structural row `row`, keyed `<shape>.<op>`, found by the shape
# and the operator's name id (rowShapeOf); a shape the vocabulary does not
# hold, or an operator the program never spells, is not found
shapeRow: function {ctx: Ctx ast: Ast.view key: StringView row: u64} is {
    d: key.indexOf needle: "."
    if d.some then {
        sh: ctx.nativeWords.slotOf text: (key.substring from: 0 to: d)
        op: poolIdOf :ast text: (key.substring from: d + 1 to: key.length)
        if (sh == ctx.nativeWords.none) or op.isZero then return
        ctx.rows.shapes.set key: (zemitrows.shapekey shape: sh :op) value: row
    }
}

# nameRow -- row `row` of file `impl`, keyed `key` there, found by the key as
# the program's names spell it (rowname): `name`, or `Type.name`; a
# `constant` variant among the variants. A helper's key (`@name`) and a key
# naming what the program never spells name no declaration, and are not
# found this way. A type member's row with a body puts the member's name
# among RowTable.memberBodies.
nameRow: function {ctx: Ctx ast: Ast.view impl: u64 key: StringView row: u64 constant: bool} is {
    if key.startsWith "@" then return
    tn: zast.nameid
    from: u64
    d: key.indexOf needle: "."
    if d.some then {
        tn = poolIdOf :ast text: (key.substring from: 0 to: d)
        if tn.isZero then return
        from = d + 1
    }
    nm: poolIdOf :ast text: (key.substring :from to: key.length)
    if nm.isZero then return
    n: zemitrows.rowname :impl typeName: tn name: nm
    if constant then {
        ctx.rows.constByName.set key: n value: row
        return
    }
    ctx.rows.byName.set key: n value: row
    if tn.notZero when (ctx.rows.rows.get i: row).body.notZero then (
        ctx.rows.memberBodies.add
        item: nm
    )
}

# rowBody -- row `row`'s C body, cut on first use; zero for none
rowBody: function {ctx: Ctx row: u64} out rtid is {
    id: (ctx.rows.rows.get i: row).body
    ctx.rt.ready :id
    return id
}

# readRowNeeds -- row `row`'s needs (`u.m`, or `m` of the row's own unit, each
# `?NAME` holding under the foundation's condition NAME too) parsed onto the
# row table's needs, the first time the row is emitted from; a need under a
# condition no file declares is reported (condBitOf) and dropped
readRowNeeds: function {ctx: Ctx row: u64} is {
    r: ctx.rows.rows.get i: row
    if r.needText == 0 then return
    needs: (ctx.rows.needTexts.get i: r.needText - 1).copy
    r.needFrom = ctx.rows.needs.length
    parseRowNeeds :ctx owner: r.owner needs: needs.stringView
    r.needTo = ctx.rows.needs.length
    r.needText = 0
    ctx.rows.rows.set i: row val: r
}

# parseRowNeeds -- readRowNeeds' parse of the needs of a row of `owner`
parseRowNeeds: function {ctx: Ctx owner: zast.nameid needs: StringView} is {
    for each nd: (needs.split sep: ",") loop {
        if nd.length > 0 then {
            bit: u64
            keep: true
            cut: nd.length
            q: nd.indexOf needle: "?"
            if q.some then {
                bit = condBitOf :ctx name: (nd.substring from: q + 1 to: nd.length)
                keep = bit != 0
                cut = q
            }
            if keep then {
                bare: nd.substring from: 0 to: cut
                key: zemitrows.demandkey :owner name: zast.nameid.zero
                d: bare.indexOf needle: "."
                match (
                    d
                ) case some then {
                    key = (
                        ctx.demands.keyOf
                        owner: (bare.substring from: 0 to: d)
                        name: (bare.substring from: d + 1 to: bare.length)
                    )
                } case none then {
                    key.name = ctx.demands.names.intern s: bare
                }
                ctx.rows.needs.append (zemitrows.rowneed :key cond: bit)
            }
        }
    }
}

# rowNeedsAdd -- what row `row`'s body calls (its needs), demanded wherever
# the row is emitted from, in the configurations `cond` holds in
rowNeedsAdd: function {ctx: Ctx row: u64 cond: Cond.view} is {
    readRowNeeds :ctx :row
    r: ctx.rows.rows.get i: row
    k: r.needFrom
    for k < r.needTo loop {
        nd: ctx.rows.needs.get i: k
        if nd.cond == 0 then {
            needsAddKeyCond :ctx key: nd.key :cond
        } else {
            needsAddKeyCond :ctx key: nd.key cond: (condWith c: cond bit: nd.cond)
        }
        k = k + 1
    }
}

# schema -- the implementation files' schema, as the served unit holds it
schema: nativec.runtime.nativec

# registerImplementations -- the rows zc carries (`nativec.units`, foundation
# `nativec.systemc.foundation`) and each user unit's checked rows (`users`)
# into the row tables, in this order: the conditions, every unit's facts and canons, the
# structural rows, the unit order, the foundation's groups, then each unit's
# rows and requirements, the units in the foundation's order and the user
# units after them. A row's fragments, pieces, templates and the fixed files
# are put in the template cache under the paths the emitter reads them by, so
# no file is opened. The rows are read by a reader of each kind (servedRow and
# the like, checkedRow and the like) and registered by one RowWalk.
registerImplementations: function {
    ctx: Ctx
    ast: Ast.view
    typing: ztyping.ZTyping.view
    users: (List UserImplementation).view
} is {
    w: newRowWalk
    fd: nativec.systemc.foundation
    order: servedUnitOrder :fd
    for each c: fd.conditions loop (
        recordCondition
        :ctx
        name: c.name.stringView
        expression: c.expression.stringView
    )
    servedFactsAndCanons :w :ctx :ast :typing :order
    for each u: users loop checkedFacts :w :ast :typing :u
    for each u: users loop checkedCanons :ctx :u
    for each r: fd.structural loop servedRow :w :ctx :ast :r owner: ""
    recordUnitOrder :ctx order: (servedList xs: fd.order).stringView
    for each g: fd.groups loop {
        for each r: g.rows loop servedRow :w :ctx :ast :r owner: g.name.stringView
    }
    for each k: order loop servedUnit :w :ctx :ast :typing u: (nativec.units.get i: k)
    for each u: users loop checkedUnit :w :ctx :ast :typing :u
    for each fl: fd.files loop {
        (
            ctx.piecedTexts.set
            key: (fileKey :ctx name: fl.name.stringView)
            value: (servedPieces :ctx ps: fl.pieces owner: "prelude")
        )
    }
}

# servedUnit -- one unit zc carries: its rows, its classes, its requirements and
# its templates
servedUnit: function {
    w: RowWalk
    ctx: Ctx
    ast: Ast.view
    typing: ztyping.ZTyping.view
    u: nativec.servedUnit
} is {
    w.file :ctx :ast :typing owner: u.name.stringView
    for each r: u.implementation.rows loop servedRow :w :ctx :ast :r owner: u.name.stringView
    for each c: u.implementation.classes loop (
        w.classRow
        :ctx
        owner: u.name.stringView
        key: c.key.stringView
        template: c.template.stringView
        live: (servedList xs: c.live)
        destroy: c.destroy.stringView
        need: (servedList xs: c.needs)
    )
    servedRequirements :w :ctx im: u.implementation owner: u.name.stringView
    for each t: u.implementation.templates loop servedTemplate :ctx :t
}

# recordImplementedUnits -- the user units whose implementation file was read,
# for a refusal to say which unit has none (noNativeImplFailure)
recordImplementedUnits: function {ctx: Ctx users: (List UserImplementation).view} is {
    for each u: users loop ctx.implementedUnits.add item: u.name.copy
}

# newRowWalk -- a walk that has registered nothing yet
newRowWalk: function out RowWalk is {
    return (
        RowWalk
        used: Set String
        rf: (
            RowFacts
            declared: Set String
            held: Set String
            placed: Set String
            replaced: Set String
            linkReplaced: Set String
            sourceReplaced: Set String
        )
        frags: String
        boxes: String
        at: String
        impl: 0
        ownerText: String
        owner: zast.nameid.zero
        reached: false
    )
}

# servedFactsAndCanons -- every served unit's facts, then every one's canons,
# the units in `order`, above every unit's own rows
servedFactsAndCanons: function {
    w: RowWalk
    ctx: Ctx
    ast: Ast.view
    typing: ztyping.ZTyping.view
    order: (ListVal u64).view
} is {
    for each k: order loop {
        for each f: (nativec.units.get i: k).implementation.facts loop {
            w.fact :ast :typing name: f.name.stringView reach: (servedList xs: f.reach).stringView
        }
    }
    for each k: order loop {
        for each c: (nativec.units.get i: k).implementation.canons loop {
            recordCanon :ctx stem: c.stem.stringView spec: (servedList xs: c.spec).stringView
        }
    }
}

# servedRow -- one row zc carries, written into the row table from its typed
# fields (placeRow): its texts handed to the walk first
servedRow: function {
    w: RowWalk
    ctx: Ctx
    ast: Ast.view
    r: schema.row
    owner: StringView
} is {
    key: r.key.stringView
    if (w.admits :ctx :owner :key fact: r.fact.stringView).not then return
    for each t: r.fragments loop w.fragment :ctx :owner :key text: "\{t}\n"
    if r.pieces.length > 0 then (
        w.pieces
        :ctx
        :owner
        :key
        text: (servedPieces :ctx ps: r.pieces :owner)
    )
    x: zemitrows.blankRow owner: w.owner
    bd: r.body.stringView.trim
    if bd.length > 0 then x.body = ctx.rt.defer text: bd
    for each c: r.constant loop x.constMask = x.constMask | (constBit position: c)
    x.value = r.form.value
    x.byPointer = r.byPointer
    x.callsEquals = r.callsEquals
    x.call = servedCall c: r.call
    if r.via.length > 0 then x.via = ctx.demands.names.intern s: r.via.stringView
    if x.constMask == 0 when w.owner.notZero when r.needs.length > 0 then {
        x.needText = rowNeedText :ctx needs: (servedList xs: r.needs).stringView
    }
    if w.frags.length > 0 then {
        x = beginDemands :ctx r: x
        for each d: r.demand loop x = addRowDemands :ctx r: x dm: d.stringView
        x = endDemands :ctx r: x :key
    }
    (
        w.place
        :ctx
        :ast
        r: x
        :key
        members: (servedList xs: r.members).stringView
        pulls: (servedList xs: r.pulls).stringView
    )
}

# servedCall -- a row's `call` choice as the kind the emitter acts on
servedCall: function {c: schema.call} out svcall is {
    match (
        c
    ) case simple then {
        return svcall.simple
    } case argument then {
        return svcall.arg
    } case parse then {
        return svcall.parse
    } case noArguments then {
        return svcall.noarg
    } else return svcall.none
}

# servedRequirements -- a unit's links, sources and refusals, each recorded as
# a UnitReq when it holds
servedRequirements: function {
    w: RowWalk
    ctx: Ctx
    im: schema.implementation
    owner: StringView
} is {
    for each l: im.links loop {
        r: newUnitReq path: (servedSubunit sub: l.subunit.stringView :owner)
        r.os = servedOs xs: l.os
        r.link = l.library.string
        w.requirement :ctx req: r.take fact: l.fact.stringView
    }
    for each s: im.sources loop {
        r: newUnitReq path: (servedSubunit sub: s.subunit.stringView :owner)
        r.os = servedOs xs: s.os
        r.csrc = s.path.string
        r.cdefs = servedList xs: s.defines
        w.requirement :ctx req: r.take fact: s.fact.stringView
    }
    for each f: im.refusals loop {
        r: newUnitReq path: (servedSubunit sub: f.subunit.stringView :owner)
        r.feature = f.feature.string
        r.nocc = servedCompilers xs: f.compilers
        r.arch = servedArchitectures xs: f.onlyArchitectures
        w.requirement :ctx req: r.take fact: ""
    }
}

# RowWalk -- registering the rows a reader reads: the fragment names given so
# far, the facts the rows declared and settled (RowFacts), and what the reader
# handed over for the row it is reading -- its fragments' names
RowWalk: class {
    used: Set String
    rf: RowFacts
    frags: String
    # the boxes the row's fragments spell, `<type>.<protocol>` comma-separated
    # (spelledBoxes)
    boxes: String
    # where the row being read is written, as its texts' mark (NativeMark);
    # "" when none is asked for
    at: String
    # the place of the file being read (from 1), 0 while the
    # foundation's groups and structural rows are
    impl: u64
    # the unit or group the last row placed was read for, and its id in
    # DemandSet.names (zero for a structural row): read once per run of rows
    ownerText: String
    owner: zast.nameid
    # the program reaches the unit of the file being read
    reached: bool
} as {
    # file -- the file implementing unit `owner` is read next: found by the
    # unit's declaration (RowTable.fileOf) when the program reaches the unit,
    # and its rows found by name then only (nameRow)
    file: function {
        :this ctx: Ctx ast: Ast.view typing: ztyping.ZTyping.view owner: StringView
    } is {
        ctx.rows.fileUnits.append (ctx.demands.names.intern s: owner)
        this.impl = ctx.rows.fileUnits.length - 1
        ud: unitDeclByName :typing :ast name: owner
        this.reached = ud.notZero
        if this.reached then ctx.rows.fileOf.set key: ud value: this.impl
    }

    # fact -- a unit's fact: declared, and held when any of `reach`'s paths
    # (comma-separated) is reached
    fact: function {
        :this
        ast: Ast.view
        typing: ztyping.ZTyping.view
        name: StringView
        reach: StringView
    } is {
        this.rf.settle :ast :typing :name :reach
    }

    # fragment -- one of the row's fragments, cached under a name of its own
    fragment: function {:this ctx: Ctx owner: StringView key: StringView text: String.take} is {
        spelledBoxes text: text.stringView into: this.boxes
        nm: this.fragmentName :owner :key
        servedFragment :ctx name: nm.stringView text: text.take
        this.markFragment :ctx name: nm.stringView
        if this.frags.length > 0 then this.frags.append ","
        this.frags.append nm
    }

    # pieces -- the row's fragment as pieces (servedPieces), in place of its
    # fragments: written a piece at a time
    pieces: function {:this ctx: Ctx owner: StringView key: StringView text: PiecedText.take} is {
        nm: this.fragmentName :owner :key
        ctx.piecedTexts.set key: (fragKey :ctx name: nm.stringView) value: text.take
        ctx.piecedFrags.add item: nm.copy
        this.frags = nm.copy
    }

    # classRow -- a class whose C struct the runtime writes, recorded in the
    # order read (the order the structs are written in): its destroy fragment,
    # when it has one, cached under a name of its own
    classRow: function {
        :this
        ctx: Ctx
        owner: StringView
        key: StringView
        template: StringView
        live: String.take
        destroy: StringView
        need: String.take
    } is {
        dn: String
        if destroy.length > 0 then {
            dkey: "\{key}.@destroy"
            dn = this.fragmentName :owner key: dkey.stringView
            servedFragment :ctx name: dn.stringView text: "\{destroy}\n"
            this.markFragment :ctx name: dn.stringView
        }
        (
            ctx.classRows.append
            (
                ClassRow
                uname: owner.string
                cls: key.string
                live: live.take
                destroy: dn.take
                tmpl: template.string
                need: need.take
            )
        )
    }

    # markFragment -- the fragment `name` marked with where its row is written,
    # when a mark is asked for
    markFragment: function {t: this.view ctx: Ctx name: StringView} is {
        if t.at.length == 0 then return
        (
            recordMark
            :ctx
            key: (fragKey :ctx :name)
            m: (NativeMark mark: t.at.copy parts: (Map String V: String))
        )
    }

    # admits -- whether the row of `owner`'s file keyed `key`, a variant under
    # `fact` ("" for none), is recorded (RowFacts.applies); the owner is read
    # where its run of rows begins
    admits: function {
        :this ctx: Ctx owner: StringView key: StringView fact: StringView
    } out bool is {
        if owner != this.ownerText then {
            this.ownerText = owner.string
            this.owner = zast.nameid.zero
            if owner.length > 0 then this.owner = ctx.demands.names.intern s: owner
            this.rf.beginFile
        }
        return (this.rf.applies :ctx :fact :owner :key)
    }

    # requirement -- a link, source or refusal a reader read: a link or a
    # source recorded when it holds (RowFacts.requirementHolds), a refusal always
    requirement: function {:this ctx: Ctx req: UnitReq.take fact: StringView} is {
        holds: true
        if req.link.length > 0 then {
            holds = this.rf.requirementHolds :ctx link: true path: req.path.stringView :fact
        } else if req.csrc.length > 0 then {
            holds = this.rf.requirementHolds :ctx link: false path: req.path.stringView :fact
        }
        if holds then ctx.unitReqs.append req.take
    }

    # place -- row `r` of the file being read, keyed `key` there, into the row
    # table and the indexes it is found by: a fragment row with the fragments
    # and boxes handed over since the last, its `members` and its `pulls`
    # (comma-separated); a helper (`@name`) by its owner and name; a structural
    # row by its shape; a row of a file the program reaches by its key's names
    place: function {
        :this
        ctx: Ctx
        ast: Ast.view
        r: zemitrows.nativerow
        key: StringView
        members: StringView
        pulls: StringView
    } is {
        x: r
        rid: u64
        if x.fragment then {
            if this.frags.length > 0 then {
                ctx.rows.fragTexts.append from: this.frags.copy
                x.fragText = ctx.rows.fragTexts.length
                this.frags = String
            }
            if members.length > 0 then {
                ctx.rows.memberTexts.append from: members.string
                x.members = ctx.rows.memberTexts.length
            }
            if this.boxes.length > 0 then {
                ctx.rows.boxTexts.append from: this.boxes.copy
                x.boxes = ctx.rows.boxTexts.length
                this.boxes = String
            }
            rid = appendFragmentRow :ctx r: x
            if pulls.length > 0 then recordRowPulls :ctx row: rid :pulls
        } else {
            ctx.rows.rows.append x
            rid = ctx.rows.rows.length - 1
        }
        if x.owner.isZero then {
            shapeRow :ctx :ast :key row: rid
            return
        }
        if key.startsWith "@" then {
            (
                ctx.rows.helpers.set
                key: (zemitrows.demandkey owner: x.owner name: (ctx.demands.names.intern s: key))
                value: rid
            )
        }
        if this.reached then (
            nameRow
            :ctx
            :ast
            impl: this.impl
            :key
            row: rid
            constant: x.constMask != 0
        )
    }

    # fragmentName -- the name of a row's fragment, `_Z_<UNIT>_<KEY>`, each byte
    # that is no letter or digit `_`, suffixed until it is unused
    fragmentName: function {:this owner: StringView key: StringView} out String is {
        base: "_Z_\{owner.toUpperAscii}_"
        k: key
        if k.startsWith "@" then k = k.substring from: 1 to: k.length
        up: k.toUpperAscii
        i: u64
        for i < up.length loop {
            b: (up.stringView.byteAt :i).or d: 0
            alnum: (b >= 0cA) and (b <= 0cZ) or ((b >= 0c0) and (b <= 0c9))
            if alnum then {
                base.appendByte :b
            } else {
                base.appendByte 0c_.u8
            }
            i = i + 1
        }
        nm: base.copy
        n: 2.u64
        for (this.used.has item: nm) loop {
            nm = "\{base}_\{n}"
            n = n + 1
        }
        this.used.add item: nm.copy
        return nm
    }
}

# UserImplementation -- a user unit's C implementation file: its nativec.zd,
# checked when the program is built (zdata.open), whose rows register as the
# rows zc carries do
UserImplementation: class {
    # the name of the unit the file implements
    name: String
    # the file, checked
    file: zdata.DataFile
}

# checkedFacts -- a user unit's facts, read off its checked file
checkedFacts: function {
    w: RowWalk
    ast: Ast.view
    typing: ztyping.ZTyping.view
    u: UserImplementation.view
} is {
    f: u.file
    for each v: (zdata.itemsOf :f v: (checkedField :u name: "facts")) loop (
        w.fact
        :ast
        :typing
        name: (zdata.textOf :f v: (zdata.fieldOf :f :v name: "name")).stringView
        reach: (checkedTexts :u :v name: "reach").stringView
    )
}

# checkedCanons -- a user unit's canonical stems, read off its checked file
checkedCanons: function {
    ctx: Ctx
    u: UserImplementation.view
} is {
    f: u.file
    for each v: (zdata.itemsOf :f v: (checkedField :u name: "canons")) loop (
        recordCanon
        :ctx
        stem: (zdata.textOf :f v: (zdata.fieldOf :f :v name: "stem")).stringView
        spec: (checkedTexts :u :v name: "spec").stringView
    )
}

# checkedUnit -- a user unit's rows, requirements and templates, read off its
# checked file
checkedUnit: function {
    w: RowWalk
    ctx: Ctx
    ast: Ast.view
    typing: ztyping.ZTyping.view
    u: UserImplementation.view
} is {
    f: u.file
    owner: u.name.stringView
    w.file :ctx :ast :typing :owner
    for each r: (zdata.itemsOf :f v: (checkedField :u name: "rows")) loop (
        checkedRow
        :w
        :ctx
        :ast
        :u
        :r
        :owner
    )
    for each c: (zdata.itemsOf :f v: (checkedField :u name: "classes")) loop (
        checkedClass
        :w
        :ctx
        :u
        :c
        :owner
    )
    for each l: (zdata.itemsOf :f v: (checkedField :u name: "links")) loop {
        r: (
            newUnitReq
            path: (servedSubunit sub: (checkedText :u v: l name: "subunit").stringView :owner)
        )
        r.os = checkedArms :u v: l name: "os"
        r.link = checkedText :u v: l name: "library"
        w.requirement :ctx req: r.take fact: (checkedText :u v: l name: "fact").stringView
    }
    for each s: (zdata.itemsOf :f v: (checkedField :u name: "sources")) loop {
        r: (
            newUnitReq
            path: (servedSubunit sub: (checkedText :u v: s name: "subunit").stringView :owner)
        )
        r.os = checkedArms :u v: s name: "os"
        r.csrc = checkedText :u v: s name: "path"
        r.cdefs = checkedTexts :u v: s name: "defines"
        w.requirement :ctx req: r.take fact: (checkedText :u v: s name: "fact").stringView
    }
    for each x: (zdata.itemsOf :f v: (checkedField :u name: "refusals")) loop {
        r: (
            newUnitReq
            path: (servedSubunit sub: (checkedText :u v: x name: "subunit").stringView :owner)
        )
        r.feature = checkedText :u v: x name: "feature"
        r.nocc = checkedArms :u v: x name: "compilers"
        r.arch = checkedArms :u v: x name: "onlyArchitectures"
        w.requirement :ctx req: r.take fact: ""
    }
    for each t: (zdata.itemsOf :f v: (checkedField :u name: "templates")) loop {
        x: newPiecedText
        for each s: (zdata.itemsOf :f v: (zdata.fieldOf :f v: t name: "sections")) loop {
            mb: checkedText :u v: s name: "member"
            rd: checkedText :u v: s name: "reached"
            tx: checkedText :u v: s name: "text"
            if mb.length == 0 when rd.length == 0 then {
                x.plain text: tx.stringView
            } else {
                (
                    x.named
                    name: mb.stringView
                    needs: (checkedTexts :u v: s name: "needs").stringView
                    row: 0
                    reached: rd.stringView
                    text: tx.stringView
                )
            }
        }
        tn: checkedText :u v: t name: "name"
        k: tmplKey :ctx name: tn.stringView
        ctx.tmplNeeds.set key: k value: (checkedTexts :u v: t name: "needs")
        ctx.piecedTexts.set key: k value: x.take
        if ctx.markNatives then markTemplate :ctx :u :t name: tn.stringView
    }
}

# checkedRow -- one row of a user unit's checked file, written into the row
# table from its fields (placeRow), as servedRow writes a row zc carries
checkedRow: function {
    w: RowWalk
    ctx: Ctx
    ast: Ast.view
    u: UserImplementation.view
    r: ztypes.cval
    # the unit the row is keyed under: the file's unit, a foundation group,
    # "" for a structural row
    owner: StringView
} is {
    f: u.file
    key: checkedText :u v: r name: "key"
    if (w.admits :ctx :owner key: key.stringView fact: (checkedText :u v: r name: "fact").stringView
    ).not then return
    w.at = String
    if ctx.markNatives then w.at = "row \{rowAddress :owner key: key.stringView}, \{(
        zdata.placeOf
        :f
        v: r
    )}"
    for each t: (zdata.textsOf :f v: (zdata.fieldOf :f v: r name: "fragments")) loop (
        w.fragment
        :ctx
        :owner
        key: key.stringView
        text: "\{t}\n"
    )
    ps: zdata.itemsOf :f v: (zdata.fieldOf :f v: r name: "pieces")
    if ps.length > 0 then {
        w.pieces :ctx :owner key: key.stringView text: (checkedPieces :ctx :u :ps :owner)
        if ctx.markNatives then {
            (
                recordMark
                :ctx
                key: (fragKey :ctx name: w.frags.stringView)
                m: (piecesMark :u :ps mark: w.at.copy)
            )
        }
    }
    x: zemitrows.blankRow owner: w.owner
    bd: checkedText :u v: r name: "body"
    if bd.stringView.trim.length > 0 then x.body = ctx.rt.defer text: bd.stringView.trim
    for each c: (zdata.itemsOf :f v: (zdata.fieldOf :f v: r name: "constant")) loop {
        x.constMask = x.constMask | (constBit position: (c.ival.u64.or d: 0))
    }
    x.value = (
        (ctx.nativeWords.slotOf text: (checkedArm :u v: r name: "form").stringView) ==
        nativeWord.slot.armValue
    )
    x.byPointer = zdata.boolOf v: (zdata.fieldOf :f v: r name: "byPointer")
    x.callsEquals = zdata.boolOf v: (zdata.fieldOf :f v: r name: "callsEquals")
    x.call = callOfArm :ctx arm: (checkedArm :u v: r name: "call").stringView
    via: checkedText :u v: r name: "via"
    if via.length > 0 then x.via = ctx.demands.names.intern s: via.stringView
    nd: checkedTexts :u v: r name: "needs"
    if x.constMask == 0 when w.owner.notZero when nd.length > 0 then {
        x.needText = rowNeedText :ctx needs: nd.stringView
    }
    if w.frags.length > 0 then {
        x = beginDemands :ctx r: x
        for each d: (zdata.textsOf :f v: (zdata.fieldOf :f v: r name: "demand")) loop {
            x = addRowDemands :ctx r: x dm: d.stringView
        }
        x = endDemands :ctx r: x key: key.stringView
    }
    (
        w.place
        :ctx
        :ast
        r: x
        key: key.stringView
        members: (checkedTexts :u v: r name: "members").stringView
        pulls: (checkedTexts :u v: r name: "pulls").stringView
    )
}

# callOfArm -- a checked file's `call` arm, by its name, as the kind the emitter
# acts on
callOfArm: function {ctx: Ctx.view arm: StringView} out svcall is {
    k: ctx.nativeWords.slotOf text: arm
    if k == nativeWord.slot.armSimple then return svcall.simple
    if k == nativeWord.slot.armArgument then return svcall.arg
    if k == nativeWord.slot.armParse then return svcall.parse
    if k == nativeWord.slot.armNoArguments then return svcall.noarg
    return svcall.none
}

# checkedClass -- one class of a user unit's checked file, as the served
# reader reads a class zc carries
checkedClass: function {
    w: RowWalk
    ctx: Ctx
    u: UserImplementation.view
    c: ztypes.cval
    owner: StringView
} is {
    key: checkedText :u v: c name: "key"
    w.at = String
    if ctx.markNatives then w.at = "class \{rowAddress :owner key: key.stringView}, \{(
        zdata.placeOf
        f: u.file
        v: c
    )}"
    ds: checkedText :u v: c name: "destroy"
    (
        w.classRow
        :ctx
        :owner
        key: key.stringView
        template: (checkedText :u v: c name: "template").stringView
        live: (checkedTexts :u v: c name: "live")
        destroy: ds.stringView
        need: (checkedTexts :u v: c name: "needs")
    )
}

# checkedPieces -- a list of pieces read off a checked file as the text the
# emitter writes, as servedPieces reads the pieces zc carries
checkedPieces: function {
    ctx: Ctx
    u: UserImplementation.view
    ps: (ListVal ztypes.cval).view
    owner: StringView
} out PiecedText is {
    x: newPiecedText
    for each p: ps loop {
        nm: checkedText :u v: p name: "name"
        tx: checkedText :u v: p name: "text"
        if nm.length == 0 then {
            x.plain text: tx.stringView
            continue
        }
        dl: List String
        for each d: (zdata.textsOf f: u.file v: (zdata.fieldOf f: u.file v: p name: "demand")
        ) loop dl.append from: d.copy
        nd: checkedTexts :u v: p name: "needs"
        row: pieceRow :ctx :owner name: nm.stringView demands: dl needs: nd.stringView
        x.named name: nm.stringView needs: nd.stringView :row reached: "" text: tx.stringView
    }
    return x
}

# registerFromFiles -- registerImplementations with every unit's rows read off
# its checked nativec.zd, the standard library's among them (`users`, zc
# --nativec-files), rather than from the rows zc carries: the same order, the
# foundation read off system's file. The agreement check: what this registers
# must emit the same C (nativec-agree-guard).
registerFromFiles: function {
    ctx: Ctx
    ast: Ast.view
    typing: ztyping.ZTyping.view
    users: (List UserImplementation).view
} is {
    sk: u64
    found: false
    k: u64
    for each u: users loop {
        if (ctx.nativeWords.slotOf text: u.name.stringView) == nativeWord.slot.unitSystem then {
            sk = k
            found = true
        }
        k = k + 1
    }
    # zc refuses --nativec-files for a program whose files hold no system's
    # (userImplementations), so the foundation is there
    if found.not then return
    sys: users.get i: sk
    fd: zdata.definition f: sys.file name: "foundation"
    order: checkedUnitOrder :ctx :users :sys :fd
    for each c: (checkedItems u: sys v: fd name: "conditions") loop (
        recordCondition
        :ctx
        name: (checkedText u: sys v: c name: "name").stringView
        expression: (checkedText u: sys v: c name: "expression").stringView
    )
    w: newRowWalk
    for each i: order loop checkedFacts :w :ast :typing u: (users.get :i)
    for each i: order loop checkedCanons :ctx u: (users.get :i)
    for each r: (checkedItems u: sys v: fd name: "structural") loop (
        checkedRow
        :w
        :ctx
        :ast
        u: sys
        :r
        owner: ""
    )
    recordUnitOrder :ctx order: (checkedTexts u: sys v: fd name: "order").stringView
    for each g: (checkedItems u: sys v: fd name: "groups") loop {
        gn: checkedText u: sys v: g name: "name"
        for each r: (checkedItems u: sys v: g name: "rows") loop (
            checkedRow
            :w
            :ctx
            :ast
            u: sys
            :r
            owner: gn.stringView
        )
    }
    for each i: order loop checkedUnit :w :ctx :ast :typing u: (users.get :i)
    for each fl: (checkedItems u: sys v: fd name: "files") loop {
        fn: checkedText u: sys v: fl name: "name"
        k: fileKey :ctx name: fn.stringView
        ps: checkedItems u: sys v: fl name: "pieces"
        if ctx.markNatives then {
            fm: "file \{fn}, \{zdata.placeOf f: sys.file v: fl}"
            recordMark :ctx key: k m: (piecesMark u: sys :ps mark: fm.take)
        }
        ctx.piecedTexts.set key: k value: (checkedPieces :ctx u: sys :ps owner: "prelude")
    }
}

# NativeMark -- where a native text the emitter writes is written (zc emit
# --mark-natives), each part of it written before that part as a C comment:
# the text's own place, then each of its named pieces' or sections'
NativeMark: class {
    # what the text is and where it is written: `row <unit>.<key>, <file>:<line>`
    mark: String
    # each piece's and section's mark, by the name its head spells
    parts: (Map String V: String)
}

# recordMark -- `m` as the mark of native text `key`
recordMark: function {ctx: Ctx key: textkey m: NativeMark.take} is {
    if ctx.marks.length == 0 then ctx.marks.append (
        NativeMark
        mark: String
        parts: (Map String V: String)
    )
    ctx.nativeMarks.set :key value: ctx.marks.length
    ctx.marks.append m.take
}

# rowAddress -- a row's address as `zc natives show` takes it: `<unit>.<key>`,
# the key alone for a structural row
rowAddress: function {owner: StringView key: StringView} out String is {
    r: owner.string
    if r.length > 0 then r.append "."
    r.append key
    return r
}

# piecesMark -- `mark` with the place of each named piece of `ps`, by its name
piecesMark: function {
    u: UserImplementation.view
    ps: (ListVal ztypes.cval).view
    mark: String.take
} out NativeMark is {
    m: NativeMark mark: mark.take parts: (Map String V: String)
    for each p: ps loop {
        nm: checkedText :u v: p name: "name"
        if nm.length == 0 then continue
        m.parts.set key: nm.copy value: "piece \{nm}, \{zdata.placeOf f: u.file v: p}"
    }
    return m
}

# markTemplate -- template `t` of a checked file marked with where it and each
# of its member sections is written
markTemplate: function {ctx: Ctx u: UserImplementation.view t: ztypes.cval name: StringView} is {
    m: (
        NativeMark
        mark: "template \{name}, \{zdata.placeOf f: u.file v: t}"
        parts: (Map String V: String)
    )
    for each s: (checkedItems :u v: t name: "sections") loop {
        mb: checkedText :u v: s name: "member"
        if mb.length == 0 then continue
        m.parts.set key: mb.copy value: "section \{mb}, \{zdata.placeOf f: u.file v: s}"
    }
    recordMark :ctx key: (tmplKey :ctx :name) :m
}

# checkedUnitOrder -- each file's place in `users`, in the order the foundation
# `fd` names the units, then the files it does not name, system's first and the
# rest by name, as servedUnitOrder orders the rows zc carries
checkedUnitOrder: function {
    ctx: Ctx
    users: (List UserImplementation).view
    sys: UserImplementation.view
    fd: ztypes.cval
} out ListVal u64 is {
    named: zdata.textsOf f: sys.file v: (zdata.fieldOf f: sys.file v: fd name: "order")
    rest: List String
    if (named.contains item: sys.name).not then rest.append from: sys.name.copy
    sorted: List String
    for each u: users loop {
        isSys: (ctx.nativeWords.slotOf text: u.name.stringView) == nativeWord.slot.unitSystem
        if (named.contains item: u.name).not when isSys.not then sorted.append from: u.name.copy
    }
    sorted.sort
    for each nm: sorted loop rest.append from: nm.copy
    order: ListVal u64
    for each o: named loop appendUserIndex :users name: o.stringView :order
    for each o: rest loop appendUserIndex :users name: o.stringView :order
    return order
}

# appendUserIndex -- the place in `users` of the file named `name`, when there
# is one
appendUserIndex: function {
    users: (List UserImplementation).view
    name: StringView
    order: ListVal u64
} is {
    k: u64
    for each u: users loop {
        if u.name.stringView == name then order.append k
        k = k + 1
    }
}

# checkedItems -- the elements of list field `name` of data value `v`
checkedItems: function {
    u: UserImplementation.view v: ztypes.cval name: StringView
} out ListVal ztypes.cval is {
    return (zdata.itemsOf f: u.file v: (zdata.fieldOf f: u.file :v :name))
}

# checkedField -- field `name` of a user file's implementation
checkedField: function {u: UserImplementation.view name: StringView} out ztypes.cval is {
    im: zdata.definition f: u.file name: "implementation"
    return (zdata.fieldOf f: u.file v: im :name)
}

# checkedText -- text field `name` of data value `v` of a user file
checkedText: function {u: UserImplementation.view v: ztypes.cval name: StringView} out String is {
    return (zdata.textOf f: u.file v: (zdata.fieldOf f: u.file :v :name))
}

# checkedTexts -- list-of-text field `name` of data value `v`, comma-separated
# as servedList writes one
checkedTexts: function {u: UserImplementation.view v: ztypes.cval name: StringView} out String is {
    r: String
    for each t: (zdata.textsOf f: u.file v: (zdata.fieldOf f: u.file :v :name)) loop {
        if r.length > 0 then r.append ","
        r.append t
    }
    return r
}

# checkedArm -- the arm a choice field `name` of `v` holds, by its name
checkedArm: function {u: UserImplementation.view v: ztypes.cval name: StringView} out String is {
    return (zdata.armOf f: u.file v: (zdata.fieldOf f: u.file :v :name))
}

# checkedArms -- the arms a list-of-choice field `name` of `v` holds, by their
# names, comma-separated as servedOs writes them
checkedArms: function {u: UserImplementation.view v: ztypes.cval name: StringView} out String is {
    r: String
    for each a: (zdata.itemsOf f: u.file v: (zdata.fieldOf f: u.file :v :name)) loop {
        if r.length > 0 then r.append ","
        r.append (zdata.armOf f: u.file v: a)
    }
    return r
}

# isServedUnit -- whether zc carries the rows of unit `name` (`nativec.units`)
isServedUnit: function {name: StringView} out bool is {
    for each u: nativec.units loop {
        if u.name.stringView == name then return true
    }
    return false
}

# servedUnitOrder -- each served unit's place in `nativec.units`, in the order
# the foundation names them, then the units it does not name, as served
servedUnitOrder: function {fd: schema.foundation} out ListVal u64 is {
    order: ListVal u64
    for each o: fd.order loop {
        k: u64
        for each u: nativec.units loop {
            if u.name.stringView == o.stringView then order.append k
            k = k + 1
        }
    }
    k: u64
    for each u: nativec.units loop {
        named: false
        for each o: fd.order loop {
            if u.name.stringView == o.stringView then named = true
        }
        if named.not then order.append k
        k = k + 1
    }
    return order
}

# servedFragment -- a fragment's text, as fragment `name`
servedFragment: function {ctx: Ctx name: StringView text: String.take} is {
    setText :ctx key: (fragKey :ctx :name) text: text.take
}

# servedTemplate -- one template zc carries, its sections as pieces
# (PiecedText) and its needs kept by its key (tmplTextOf)
servedTemplate: function {ctx: Ctx t: schema.template} is {
    x: newPiecedText
    for each s: t.sections loop {
        if s.member.length == 0 when s.reached.length == 0 then {
            x.plain text: s.text.stringView
        } else {
            (
                x.named
                name: s.member.stringView
                needs: (servedList xs: s.needs).stringView
                row: 0
                reached: s.reached.stringView
                text: s.text.stringView
            )
        }
    }
    k: tmplKey :ctx name: t.name.stringView
    ctx.tmplNeeds.set key: k value: (servedList xs: t.needs)
    ctx.piecedTexts.set key: k value: x.take
}

# servedPieces -- pieces `ps` of `owner` zc carries as the text the emitter
# writes (PiecedText), each named piece a row of its own (pieceRow)
servedPieces: function {ctx: Ctx ps: staticlist schema.piece owner: StringView} out PiecedText is {
    x: newPiecedText
    for each p: ps loop {
        if p.name.length == 0 then {
            x.plain text: p.text.stringView
            continue
        }
        dl: List String
        for each d: p.demand loop dl.append from: d.string
        nd: servedList xs: p.needs
        row: pieceRow :ctx :owner name: p.name.stringView demands: dl needs: nd.stringView
        (
            x.named
            name: p.name.stringView
            needs: nd.stringView
            :row
            reached: ""
            text: p.text.stringView
        )
    }
    return x
}

# servedKey -- a row's key: `<unit>.<key>`, a helper `@<unit>.<name>`, a
# structural case (no unit) `@<key>`
servedKey: function {owner: StringView key: StringView} out String is {
    if owner.length == 0 then return "@\{key}"
    if key.startsWith "@" then return "@\{owner}.\{key.substring from: 1 to: key.length}"
    return "\{owner}.\{key}"
}

# servedList -- a list of texts, comma-separated
servedList: function {xs: staticlist text} out String is {
    r: String
    for each t: xs loop {
        if r.length > 0 then r.append ","
        r.append t.stringView
    }
    return r
}

# servedSubunit -- `<unit>` or `<unit>.<subunit>` for a requirement
servedSubunit: function {sub: StringView owner: StringView} out String is {
    if sub.length == 0 then return owner.string
    return "\{owner}.\{sub}"
}

# servedOs -- operating systems by their arm names, comma-separated
servedOs: function {xs: staticlist schema.os} out String is {
    r: String
    for each o: xs loop {
        if r.length > 0 then r.append ","
        match (
            o
        ) case linux then {
            r.append "linux"
        } case darwin then {
            r.append "darwin"
        } case windows then {
            r.append "windows"
        } case other then {
            r.append "other"
        }
    }
    return r
}

# servedCompilers -- C compilers by their arm names, comma-separated
servedCompilers: function {xs: staticlist schema.compiler} out String is {
    r: String
    for each c: xs loop {
        if r.length > 0 then r.append ","
        match (
            c
        ) case gcc then {
            r.append "gcc"
        } case clang then {
            r.append "clang"
        } case tcc then {
            r.append "tcc"
        } case msvc then {
            r.append "msvc"
        }
    }
    return r
}

# servedArchitectures -- architectures by their arm names, comma-separated
servedArchitectures: function {xs: staticlist schema.architecture} out String is {
    r: String
    for each a: xs loop {
        if r.length > 0 then r.append ","
        match (
            a
        ) case x86_64 then {
            r.append "x86_64"
        } case aarch64 then {
            r.append "aarch64"
        } case other then {
            r.append "other"
        }
    }
    return r
}

# RowFacts -- the facts the files declared so far, which of them hold, and,
# in the file being read, the keys recorded and those a held fact's variant
# replaced
RowFacts: class {
    # every fact read so far, by name
    declared: Set String
    # the declared facts the program makes hold
    held: Set String
    # the keys recorded so far in the file being read, as it writes them
    placed: Set String
    # the keys a variant under a held fact took, in the file being read
    replaced: Set String
    # the unit paths whose links, and whose sources, a variant under a held
    # fact took
    linkReplaced: Set String
    sourceReplaced: Set String
} as {
    # applies -- whether a row is recorded: a variant under a fact when the fact
    # holds; a plain row unless a variant of its key replaced it. A variant under
    # a fact no file declares, or below a plain row of its key that was already
    # recorded, is refused.
    applies: function {
        :this
        ctx: Ctx
        # the fact the row is a variant under, "" for a plain row
        fact: StringView
        # the file's unit or group, "" for the structural rows
        owner: StringView
        # the row's key, as its file writes it
        key: StringView
    } out bool is {
        if key.length == 0 then return false
        if fact.length == 0 then {
            if (this.replaced.has item: key.asString) then return false
            this.placed.add item: key.string
            return true
        }
        bad: String
        adr: rowAddress :owner :key
        if (this.declared.has item: fact.asString).not then {
            bad = "'\{adr}' is a variant under '\{fact}', which no file declares"
        } else if (this.placed.has item: key.asString) then {
            bad = "the variant of '\{adr}' under '\{fact}' stands below its plain row; place it above"
        }
        if bad.length > 0 then {
            emitFail :ctx what: "nativec: \{bad}" line: 0
            return false
        }
        if (this.held.has item: fact.asString).not then return false
        this.replaced.add item: key.string
        this.placed.add item: key.string
        return true
    }

    # beginFile -- the rows of another file are read next: its keys are its own
    beginFile: function {:this} is {
        this.placed = Set String
        this.replaced = Set String
    }

    # settle -- fact `name` is declared, and holds when any of its `reach`
    # paths (comma-separated) is reached
    settle: function {
        :this
        ast: Ast.view
        typing: ztyping.ZTyping.view
        name: StringView
        reach: StringView
    } is {
        this.declared.add item: name.string
        for each rp: (reach.split sep: ",") loop {
            if rp.length > 0 when (factPathReached :ast :typing path: rp) then (
                this.held.add
                item: name.string
            )
        }
    }

    # requirementHolds -- whether a link (`link`) or a source of unit `path` is
    # recorded: one under no fact unless a variant of its kind and path
    # took it; one under a fact when the fact holds, which takes the plain ones
    # of its kind and path that follow. A fact no file declares is refused.
    requirementHolds: function {
        :this ctx: Ctx link: bool path: StringView fact: StringView
    } out bool is {
        if fact.length == 0 then {
            if link then return (this.linkReplaced.has item: path.asString).not
            return (this.sourceReplaced.has item: path.asString).not
        }
        if (this.declared.has item: fact.asString).not then {
            (
                emitFail
                :ctx
                what: "nativec: a requirement of '\{path}' holds under '\{fact}', which no file declares"
                line: 0
            )
            return false
        }
        if (this.held.has item: fact.asString).not then return false
        if link then {
            this.linkReplaced.add item: path.string
        } else {
            this.sourceReplaced.add item: path.string
        }
        return true
    }
}

# rowNeedAddOne -- one need of a row's `needs=` list (rowNeedAdd): a member of
# the row's own unit `uname`, or `<unit>.<member>`.
rowNeedAddOne: function {ctx: Ctx uname: StringView need: StringView} is {
    rowNeedAddCond :ctx :uname :need cond: condAlways
}

# rowNeedAddCond -- rowNeedAddOne for a row holding under `cond`: a need
# `X?NAME` holds where the row does AND the foundation's condition NAME does
rowNeedAddCond: function {ctx: Ctx uname: StringView need: StringView cond: Cond.view} is {
    q: need.indexOf needle: "?"
    match (
        q
    ) case some then {
        cb: condBitOf :ctx name: (need.substring from: q + 1 to: need.length)
        if cb == 0 then return
        (
            rowNeedAddBare
            :ctx
            :uname
            need: (need.substring from: 0 to: q)
            cond: (condWith c: cond bit: cb)
        )
    } case none then rowNeedAddBare :ctx :uname :need :cond
}

# rowNeedAddBare -- one need with no condition of its own, under `cond`
rowNeedAddBare: function {ctx: Ctx uname: StringView need: StringView cond: Cond.view} is {
    qd: need.indexOf needle: "."
    match (
        qd
    ) case some then {
        (
            needsAddMCond
            :ctx
            uname: (need.substring from: 0 to: qd)
            memb: (need.substring from: qd + 1 to: need.length)
            :cond
        )
    } case none then {
        if uname.length > 0 then needsAddMCond :ctx :uname memb: need :cond
    }
}

# condBitOf -- the bit of the foundation's condition `name`; 0, and a failure,
# for a name it does not declare
condBitOf: function {ctx: Ctx name: StringView} out u64 is {
    k: u64
    for k < ctx.conds.length loop {
        if (ctx.conds.get i: k).name.stringView == name then return 1.u64 << k
        k = k + 1
    }
    (
        emitFail
        :ctx
        what: "nativec: a need names the condition '\{name}', which the foundation does not declare"
        line: 0
    )
    return 0
}

# recordCondition -- a foundation condition: the condition `name` a need
# `X?NAME` holds under, tested in the written C by `expression`
recordCondition: function {ctx: Ctx name: StringView expression: StringView} is {
    nm: name.trim
    ex: expression.trim
    bad: String
    if (
        (nm.length == 0) or (ex.length == 0)
    ) then bad = "a condition needs a name and a C expression".string
    for each c: ctx.conds loop {
        if c.name.stringView == nm then bad = "the condition '\{nm}' is declared twice"
    }
    if ctx.conds.length == 64 then bad = "more than 64 conditions".string
    if bad.length > 0 then {
        emitFail :ctx what: "nativec: \{bad}" line: 0
        return
    }
    ctx.conds.append (CondDecl name: nm.string expr: ex.string)
}

# CondDecl -- one condition the foundation declares: its name, which a need
# `X?NAME` holds under, and the C expression the written C tests it by. Its
# place in ctx.conds is its bit (Cond).
CondDecl: class {
    name: String
    expr: String
}

# emitFail -- record an emission failure for an unhandled construct. zc
# reports every recorded failure and exits nonzero without writing any
# output, so the text a leg answers after recording one is never read.
emitFail: function {ctx: Ctx what: String line: u32} is {
    ctx.emitErrors.append (emitterFailure :what :line)
}

# emitterFailure -- E0500, a construct the emitter cannot emit. It carries only
# a line, written into the message, and no node: the driver prints no snippet
# for it, since a bare line could name the wrong file.
emitterFailure: function {what: String line: u32} out zast.ErrorData is {
    msg: String
    if line > 0 then {
        msg = "zemitterc: \{what} [line \{line}]"
    } else {
        msg = "zemitterc: \{what}"
    }
    return (
        zast.ErrorData
        nodeid: zast.nodeid
        lineno: 0
        colno: 0
        width: 0
        err: zast.err.emitterError
        :msg
        fsno: zvfs.fsno
        note: "".string
        hint: "".string
    )
}

# stringChunkText -- a stringchunk's text ("" for any other shape).
stringChunkText: function {ast: Ast.view n: astnode.view} out String is {
    match (
        n
    ) case stringchunk then {
        return (zast.literalTextAt :ast ref: n.text).string
    } else {
        return "".string
    }
}

# isInterp -- true when a literal has any non-chunk part.
isInterp: function {ast: Ast.view parts: zast.kidspan} out bool is {
    for each pId: (zast.kidsOf :ast span: parts) loop {
        p: ast.nodes.get i: pId
        isC: false
        if p.stringchunk then isC = true
        if isC.not then return true
    }
    return false
}

# wholeText -- a plain literal's joined chunk text.
wholeText: function {ast: Ast.view parts: zast.kidspan} out String is {
    buf: String
    for each pId: (zast.kidsOf :ast span: parts) loop {
        t: stringChunkText :ast n: (ast.nodes.get i: pId)
        buf.append t
    }
    return buf
}

# collectLiterals -- pool every PLAIN string-literal atom in walk order:
# parallel lists of (nodeid, text). Interpolated literals build at the
# use site instead. The kinds a body is made of are spelled, one arm each:
# this walk meets every node of every body, and a walk through zast.childAt
# costs a copy of the node per child read (arch_baseline.txt, A013).
collectLiterals: function {
    ast: Ast.view n: astnode.view ids: ListVal zast.nodeid texts: List String
} is {
    match (
        n
    ) case statement then {
        for each sId: (zast.kidsOf :ast span: n.statements) loop {
            collectLiterals :ast n: (ast.nodes.get i: sId) :ids :texts
        }
    } case statementline then {
        collectLiterals :ast n: (ast.nodes.get i: n.statementline) :ids :texts
    } case namedoperation then {
        collectLiterals :ast n: (ast.nodes.get i: n.operation) :ids :texts
    } case call then {
        collectLiterals :ast n: (ast.nodes.get i: n.callable) :ids :texts
        for each a: (zast.kidsOf :ast span: n.arguments) loop {
            collectLiterals :ast n: (ast.nodes.get i: a) :ids :texts
        }
    } case dottedpath then {
        collectLiterals :ast n: (ast.nodes.get i: n.parent) :ids :texts
    } case assignment then {
        collectLiterals :ast n: (ast.nodes.get i: n.value) :ids :texts
    } case reassignment then {
        collectLiterals :ast n: (ast.nodes.get i: n.value) :ids :texts
    } case ifexpr then {
        for each cId: (zast.kidsOf :ast span: n.clauses) loop {
            collectLiterals :ast n: (ast.nodes.get i: cId) :ids :texts
        }
        if n.elseclause.notZero then {
            ec: ast.nodes.get i: n.elseclause
            collectLiterals :ast n: ec :ids :texts
        }
    } case caseexpr then {
        collectLiterals :ast n: (ast.nodes.get i: n.subject) :ids :texts
        for each mc: (zast.kidsOf :ast span: n.clauses) loop {
            collectLiterals :ast n: (ast.nodes.get i: mc) :ids :texts
        }
        if n.elseclause.notZero then {
            ecl: ast.nodes.get i: n.elseclause
            collectLiterals :ast n: ecl :ids :texts
        }
    } case caseclause then {
        collectLiterals :ast n: (ast.nodes.get i: n.statement) :ids :texts
    } case ifclause then {
        for each kId: (zast.kidsOf :ast span: n.conditions) loop {
            collectLiterals :ast n: (ast.nodes.get i: kId) :ids :texts
        }
        collectLiterals :ast n: (ast.nodes.get i: n.statement) :ids :texts
    } case withexpr then {
        collectLiterals :ast n: (ast.nodes.get i: n.value) :ids :texts
        collectLiterals :ast n: (ast.nodes.get i: n.body) :ids :texts
    } case doexpr then {
        collectLiterals :ast n: (ast.nodes.get i: n.statement) :ids :texts
    } case forexpr then {
        for each f: (zast.kidsOf :ast span: n.conditions) loop {
            collectLiterals :ast n: (ast.nodes.get i: f) :ids :texts
        }
        if n.body.notZero then {
            fbl: ast.nodes.get i: n.body
            collectLiterals :ast n: fbl :ids :texts
        }
    } case atomstring then {
        if (isInterp :ast parts: n.stringparts).not then {
            t: wholeText :ast parts: n.stringparts
            ids.append n.nodeid
            texts.append t
        } else {
            for each p: (zast.kidsOf :ast span: n.stringparts) loop {
                collectLiterals :ast n: (ast.nodes.get i: p) :ids :texts
            }
        }
    } else null
}

# litIndexOf -- the 1-based pool index for a literal's nodeid (0 = absent).
litIndexOf: function {ctx: Ctx nid: zast.nodeid} out u64 is {
    li: (ctx.litIndex.get key: nid).or d: 0
    if li > 0 then ctx.usedLits.add item: nid
    return li
}

# literalIndex -- each literal's node id -> its 1-based place in `ids`, the
# first place when a node is pooled twice
literalIndex: function {ids: (ListVal zast.nodeid).view} out (IdMapV zast.nodeid v: u64) is {
    m: IdMapV zast.nodeid v: u64 capacity: ids.length
    i: u64
    for each nid: ids loop {
        i = i + 1
        if (m.has key: nid).not then m.set key: nid value: i
    }
    return m
}

# ternaryClause / ternaryElse -- if-expression rendering as nested C
# ternaries: each clause opens "(cond ? value : " and the else closes.
ternaryClause: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    c: astnode.view
    # the first clause's first condition runs whenever the ternary does; every
    # other condition, and every arm, only on some paths
    isFirst: bool
    # the chain is a reference: the arm yields an address (armRefLeaf)
    ref: false
    facts: cfacts.borrow
} out String is {
    match (
        c
    ) case ifclause then {
        condF: cfacts
        cond: ternaryConds :ast :reg :typing :ctx :c :isFirst facts: condF
        if cond.length == 0 then return cond
        vxF: cfacts
        vx: armInPlace :ast :reg :typing :ctx n: (ast.nodes.get i: c.statement) :ref facts: vxF
        if vx.length == 0 then return vx
        stateFacts :facts from: (valueFacts a: condF b: vxF)
        return "((\{cond}) ? (\{vx}) : "
    } else {
        stateFacts :facts from: constFacts
        return "(0 ? 0 : ".string
    }
}

# ternaryConds -- a ternary clause's conditions as one `&&` chain; "" when one
# of them records a hoist that cannot be assigned where it runs.
ternaryConds: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    c: zast.ifclauserow
    isFirst: bool
    facts: cfacts.borrow
} out String is {
    cond: String
    condF: constFacts
    i: u64
    for i < c.conditions.count loop {
        kId: zast.kidAt kids: ast.kids span: c.conditions :i
        guarded: isFirst.not or (i > 0)
        i = i + 1
        k: ast.nodes.get i: kId
        if k.namedoperation then {
            cvF: cfacts
            cv: ternaryCondPart :ast :reg :typing :ctx op: k.operation :guarded facts: cvF
            if cv.length == 0 then return cv
            # one condition is the text itself; each further one joins it with `&&`
            if cond.length == 0 then condF = cvF else condF = valueFacts a: condF b: cvF
            if cond.length > 0 then cond.append " && "
            cond.append cv
        }
    }
    return (stating :facts from: condF text: cond)
}

# ternaryCondPart -- one condition of a ternary clause. A guarded one -- a later
# clause's, or one past the first -- assigns its hoists where it runs; "" when
# one of them cannot be.
ternaryCondPart: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the condition's operation node
    op: zast.nodeid
    guarded: bool
    facts: cfacts.borrow
} out String is {
    mk: openInPlace :ctx :guarded
    cvF: cfacts
    cv: valueExprC :ast :reg :typing :ctx n: (ast.nodes.get i: op) facts: cvF
    tw: truthyCondText :ast :reg :typing :ctx n: (ast.nodes.get i: op) raw: cv.stringView
    # a truthiness test written around the condition is a value computed from it
    if tw.length > 0 when tw.stringView != cv then {
        cv = tw.take
        cvF = operandFacts e: cvF place: false
    }
    if guarded when (hoistsGrew :ctx mark: mk) then return (
        stating
        :facts
        from: callFacts
        text: (assignInPlace :ctx mark: mk text: cv.stringView)
    )
    closeInPlace :ctx mark: mk
    return (stating :facts from: cvF text: cv)
}

# armInPlace -- a ternary arm's value, its hoists assigned where the arm runs;
# "" when one of them cannot be.
armInPlace: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    # the arm of a reference chain: its address is the answer (armRefLeaf)
    ref: false
    facts: cfacts.borrow
} out String is {
    mk: openInPlace :ctx guarded: true
    vxF: cfacts
    vx: armValueExpr :ast :reg :typing :ctx :n facts: vxF
    if (hoistsGrew :ctx mark: mk) then {
        # the address is taken of the value itself, which may be a place; the
        # hoists the value reads are assigned ahead of it
        part: vx.copy
        if ref when ctx.argHoistRaw.length == mk.raw then {
            rfF: cfacts
            part = armRefLeaf :ast :reg :typing :ctx :n text: vx.stringView textF: vxF facts: rfF
        }
        return (
            stating
            :facts
            from: callFacts
            text: (assignInPlace :ctx mark: mk text: part.stringView)
        )
    }
    closeInPlace :ctx mark: mk
    if ref then return (armRefLeaf :ast :reg :typing :ctx :n text: vx.stringView textF: vxF :facts)
    return (stating :facts from: vxF text: vx)
}

# emitTernaryChain -- an if used as a value whose arms are single values, as a
# chain of C ternaries.
emitTernaryChain: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.ifrow.view
    # a reference chain: every arm yields an address (emitControlRef)
    ref: false
    facts: cfacts.borrow
} out String is {
    tx: String
    txF: constFacts
    depth: u64
    tm: pendingHoistMark :ctx
    # nothing evaluated before the chain is moved into it: a control value in
    # it makes the whole if one (below)
    ctx.guardDepth = ctx.guardDepth + 1
    i: u64
    for i < n.clauses.count loop {
        cId: zast.kidAt kids: ast.kids span: n.clauses :i
        clause: ast.nodes.get i: cId
        cxF: cfacts
        cx: ternaryClause :ast :reg :typing :ctx c: clause isFirst: i == 0 :ref facts: cxF
        i = i + 1
        if cx.length == 0 then ctx.guardDepth = ctx.guardDepth - 1
        if cx.length == 0 then return (
            ternaryAsStatements
            :ast
            :reg
            :typing
            :ctx
            nid: n.nodeid
            mark: tm
            :ref
            :facts
        )
        tx.append cx
        txF = valueFacts a: txF b: cxF
        depth = depth + 1
    }
    exF: cfacts
    ex: ternaryElse :ast :reg :typing :ctx oId: n.elseclause :ref facts: exF
    ctx.guardDepth = ctx.guardDepth - 1
    # a control value anywhere in the chain runs as statements, which neither
    # a condition nor an arm of a ternary can hold
    if (ex.length == 0) or (ctx.argHoistRaw.length > tm.raw) then return (
        ternaryAsStatements
        :ast
        :reg
        :typing
        :ctx
        nid: n.nodeid
        mark: tm
        :ref
        :facts
    )
    tx.append ex
    txF = valueFacts a: txF b: exF
    dk: u64
    for dk < depth loop {
        tx.append ")"
        dk = dk + 1
    }
    # a value, read only where every part only reads; reading it twice reruns
    # its condition
    return (
        stating
        :facts
        from: (
            cfacts
            place: false
            literal: false
            once: true
            pure: txF.pure
            path: false
            stated: true
        )
        text: tx
    )
}

# dropHoistsTo -- forget the hoists recorded since `mark`: the text that would
# have read them is not being emitted.
dropHoistsTo: function {ctx: Ctx mark: hoistmark} is {
    for ctx.argHoists.length > mark.names loop ctx.argHoists.pop
    for ctx.argHoistRaw.length > mark.raw loop {
        # a part settleAhead moved out of its call reads nowhere else
        if (ctx.argHoistRaw.get i: ctx.argHoistRaw.length - 1).settles then {
            (
                emitFail
                :ctx
                what: "a speculative build dropped a part settled ahead of a control value".string
                line: 0
            )
        }
        ctx.argHoistRaw.pop
    }
}

# ternaryAsStatements -- an if whose ternary text recorded a hoist no
# expression can hold: the hoists that text recorded are dropped, and it is
# built as a control value, as a block-armed if is (emitControlExpr).
ternaryAsStatements: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the if's node id
    nid: zast.nodeid
    # where the pending hoists stood before the ternary began
    mark: hoistmark
    # the chain was a reference: so is the statement expression
    ref: false
    facts: cfacts.borrow
} out String is {
    dropHoistsTo :ctx :mark
    if ref then return (
        stating
        :facts
        from: callFacts
        text: (emitControlPtrExpr :ast :reg :typing :ctx n: (ast.nodes.get i: nid))
    )
    icx: emitControlExpr :ast :reg :typing :ctx n: (ast.nodes.get i: nid)
    if icx.length > 0 then return (stating :facts from: callFacts text: icx)
    return (
        stating
        :facts
        from: failedFacts
        text: (unhandledExpr :ctx line: (ztypecheck.nodeLine n: (ast.nodes.get i: nid)))
    )
}

# emit the else-arm of a C ternary expression.
ternaryElse: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    oId: zast.nodeid
    # the arm of a reference chain (armRefLeaf)
    ref: false
    facts: cfacts.borrow
} out String is {
    if oId.notZero then {
        evF: cfacts
        ev: armInPlace :ast :reg :typing :ctx n: (ast.nodes.get i: oId) :ref facts: evF
        if ev.length == 0 then return ev
        stateFacts :facts from: evF
        return "(\{ev})"
    } else {
        stateFacts :facts from: constFacts
        return "(0)".string
    }
}

# atomTextOf -- an atomid node's name text ("" for any other shape), a view
# into the pool: the tree is read-only throughout emission, so the text is
# never copied out of it. The node is taken by copy: the text points into
# `ast`'s pool, never into it, so only `ast` stays locked.
atomTextOf: function {ast: Ast.view n: astnode} outx StringView is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextAt :ast ref: n.name).stringView
    } else {
        return ""
    }
}

# atomNodeId -- an atomid node's id (0 for any other shape).
atomNodeId: function {n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case atomid then {
        return n.nodeid
    } else {
        return zast.nodeid
    }
}

# stampIdOf -- the type the checker stamped on node `nid`. An instance is
# emitted from its own copy of a function, so the stamp is that instance's.
stampIdOf: function {typing: ztyping.ZTyping.view nid: zast.nodeid} out ztypes.tid is {
    return (ztyping.nodeTypeAt tbl: typing.nodeType :nid)
}

# stampIsStr / stampIsSv -- the type the checker stamped on `nid` IS String
# / StringView. Thirteen sites read a stamp for no other reason than to ask
# this, and each had to name the intermediate; the QUESTION is the thing worth
# naming, not the tid it goes through.
stampIsStr: function {typing: ztyping.ZTyping.view ctx: Ctx.view nid: zast.nodeid} out bool is {
    return (stampIdOf :typing :nid) == ctx.strTid
}

# whether a node's stamped type is StringView, which decides the whole
# string emit path
stampIsSv: function {typing: ztyping.ZTyping.view ctx: Ctx.view nid: zast.nodeid} out bool is {
    return (stampIdOf :typing :nid) == ctx.svTid
}

# rowShapeOf -- the shape a structural row of an operator on `owner` is keyed
# by (shapekey), for a type that declares no native operator: the inline
# compare a C scalar gets (an ordinal variant, or a record whose typedef chain
# ends at a scalar), a variant's tag compare, a record's byte compare; the
# vocabulary's `none` for any other type
rowShapeOf: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    owner: ztypes.tid
} out u64 is {
    tt: reg.typetypeOf typeId: owner
    # an ORDINAL PAIR is a C scalar, so it compares with `==` rather than
    # through the tagged-struct comparator it has no struct for
    if (isOrdinalVariant :typing tid: owner) then return nativeWord.slot.shapeScalar
    if tt == ztypes.ztypetype.variantType then return nativeWord.slot.shapeVariant
    if tt == ztypes.ztypetype.recordType then {
        bn: typedefChaseBaseName :ast :typing tid: owner
        if bn.length > 0 then {
            sc: (
                scalarCTypeFor
                :typing
                tid: (ztypecheck.typedefChaseTid :typing tid: owner)
            )
            if sc.length > 0 then return nativeWord.slot.shapeScalar
        }
        return nativeWord.slot.shapeRecord
    }
    return ctx.nativeWords.none
}

# shapeLabel -- the structural row keyed `k` as the rows' check names it,
# `@<shape>.<op>`, written in one allocation
shapeLabel: function {ast: Ast.view k: zemitrows.shapekey} out String is {
    sw: ""
    if k.shape == nativeWord.slot.shapeScalar then sw = "scalar"
    if k.shape == nativeWord.slot.shapeVariant then sw = "variant"
    if k.shape == nativeWord.slot.shapeRecord then sw = "record"
    op: zast.nameTextAt :ast ref: k.op
    r: String
    r.reserve n: sw.length + op.length + 2
    r.append "@"
    r.append sw
    r.append "."
    r.append op
    return r
}

# dottedTaggedTid -- the tagged-construction stamp for a dotted node: the
# variant/union type id when the path names a subtype member on the TYPE
# (`Type.arm`); 0 otherwise.
dottedTaggedTid: function {typing: ztyping.ZTyping.view nid: zast.nodeid} out ztypes.tid is {
    return ((typing.dpTaggedParent.get key: nid).or d: ztypes.tid.zero)
}

# dottedArmPredicateTid -- the arm-predicate stamp for a dotted node: the
# variant/union type id when `value.arm` is a tag test; 0 otherwise.
dottedArmPredicateTid: function {typing: ztyping.ZTyping.view nid: zast.nodeid} out ztypes.tid is {
    return ((typing.dpArmPredicate.get key: nid).or d: ztypes.tid.zero)
}

# dottedTagReadTid -- the tag-accessor stamp for a dotted node: the variant/
# union type id when `value.<accessor>` reads the discriminator; 0 otherwise.
dottedTagReadTid: function {typing: ztyping.ZTyping.view nid: zast.nodeid} out ztypes.tid is {
    return ((typing.dpTagRead.get key: nid).or d: ztypes.tid.zero)
}

# listRowOf -- the list row the node at `nid` folded to: a list reached by a
# compile-time path (`codes`, `zast.wellKnown`), in the walk of the mono being
# emitted. 0 for any other node.
listRowOf: function {typing: ztyping.ZTyping.view nid: zast.nodeid} out u64 is {
    if nid.isZero then return 0
    v: typing.nodeConstAt :nid
    if v.kind.aggKind.not then return 0
    if (typing.constAggs.get i: v.aggId.u64).kind.staticList.not then return 0
    return v.aggId
}

# matchDiverges -- true when a match node is stamped `never` (the typechecker's
# exhaustive + all-arms-diverge result), so its `default:` is provably unreachable.
matchDiverges: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view nid: zast.nodeid
} out bool is {
    tid: stampIdOf :typing :nid
    if tid.isZero then return false
    tt: reg.typetypeOf typeId: tid
    if tt == ztypes.ztypetype.neverType then return true
    return false
}

# blockDiverges -- the block's last statement leaves the block on every path: a
# `return`, or any statement the typechecker stamped `never` (panic, unreachable,
# break, continue, an exhaustive all-arms-diverge match). Whatever a caller would
# append after such a block is unreachable. Ask it about the block YOU emitted --
# an `if c then { break }` diverges as a block, its enclosing block does not.
blockDiverges: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    n: astnode.view
} out bool is {
    if (ztypecheck.blockEndsInReturn :ast block: n) then return true
    match (
        n
    ) case statement then {
        # ANY diverging statement makes the rest of the block unreachable, so
        # the block diverges -- not just a diverging last statement
        for each dsId: (zast.kidsOf :ast span: n.statements) loop {
            if (stmtDiverges :ast :reg :typing :ctx sid: dsId) then return true
        }
        return false
    } case doexpr then {
        # a `do` body (a `with`'s) is the block it wraps
        return (blockDiverges :ast :reg :typing :ctx n: (ast.nodes.get i: n.statement))
    } else {
        return false
    }
}

# stmtDiverges -- one statement leaves its block on every path: a `never` stamp
# (panic, unreachable, break, continue, an all-arms-diverge match), a `return`
# valued or bare, an if/else chain whose every arm diverges, or a loop that never
# exits.
stmtDiverges: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    sid: zast.nodeid
} out bool is {
    if sid.isZero then return false
    sn: ast.nodes.get i: sid
    match (
        sn
    ) case statementline then {
        inn: ast.nodes.get i: sn.statementline
        # the typechecker's `never` stamp IS the control-flow fact: checkCase
        # only stamps it on an exhaustive match whose every arm -- else included
        # -- diverges, and a panic or diverging call carries it because it does
        # not return. No shape-matching needed here.
        if (matchDiverges :reg :typing nid: sid) then return true
        if (matchDiverges :reg :typing nid: sn.statementline) then return true
        if (isBareReturn n: inn) then return true
        if (loopNeverExits :typing n: inn) then return true
        return (ifDiverges :ast :reg :typing :ctx n: inn)
    } else {
        return false
    }
}

# isBareReturn -- a valueless `return`, which parses as an atom rather than the
# call shape ztypecheck.blockEndsInReturn looks for. Diverges all the same.
isBareReturn: function {n: astnode.view} out bool is {
    match (
        n
    ) case atomid then {
        return n.name == zast.wellKnown.slot.wkReturn
    } else {
        return false
    }
}

# loopNeverExits -- the checker found no condition that can stop this loop and
# no `break` that leaves it: its only ways out leave the function, so anything
# after the loop is unreachable.
loopNeverExits: function {
    typing: ztyping.ZTyping.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case forexpr then {
        return (foldedLoopOf :typing nid: n.nodeid).neverExits
    } else {
        return false
    }
}

# ifDiverges -- an if/else chain every arm of which diverges, else included. No
# else clause means the fall-through path is live, so the chain does not.
ifDiverges: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case ifexpr then {
        # a chain whose every condition folds emits ONE branch, so only that
        # branch decides -- the arms the emitter dropped cannot run. Mirrors the
        # fold in emitStmt's ifexpr case.
        ffb: foldedBranchOf :typing nid: n.nodeid
        if ffb.known then {
            # every branch folded away: nothing is emitted, so nothing diverges
            if ffb.stmt.isZero then return false
            return (blockDiverges :ast :reg :typing :ctx n: (ast.nodes.get i: ffb.stmt))
        }
        if n.elseclause.isZero then return false
        for each cId: (zast.kidsOf :ast span: n.clauses) loop {
            cl: ast.nodes.get i: cId
            match (
                cl
            ) case ifclause then {
                if cl.statement.isZero then return false
                if (
                    blockDiverges
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: (ast.nodes.get i: cl.statement)
                ).not then return false
            } else {
                return false
            }
        }
        return (blockDiverges :ast :reg :typing :ctx n: (ast.nodes.get i: n.elseclause))
    } else {
        return false
    }
}

# builtinTidInU -- the canonical registry id of a stdlib builtin DECLARED IN
# `unitName`: the unit is walkLookupTyperef's first probe, so naming the unit
# is the qualified lookup, for the builtins `core` does not re-export (a
# canon's part spelled `unit.name`).
builtinTidInU: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    unitName: StringView
    base: StringView
} out ztypes.tid is {
    # every caller names the declared family form directly (ListRef, MapRR,
    # ...) and consumes what resolution already minted: the read-only walk
    # answers without the checker's mint legs.
    ud9: (
        ztypecheck.unitDeclOfName
        :typing
        nameId: (zast.poolFind pool: ast.names text: unitName)
    )
    return (
        (
            ztypecheck.walkLookupTyperefRo
            scope: ztypes.declid
            :ast
            :typing
            unitDecl: ud9
            :base
        ).or
        d: ztypes.tid.zero
    )
}

# builtinTid -- the stdlib type a name names, resolved from the prelude by its
# id (ztypecheck.stdTidPeek), so a user type of the same name never shadows it.
# 0 when absent from the program.
builtinTid: function {
    ast: Ast.view typing: ztyping.ZTyping.view nameId: zast.nameid
} out ztypes.tid is {
    return (ztypecheck.stdTidPeek :ast :typing wk: nameId)
}

# specTidArgs -- the minted instance of a stdlib template over the argument TYPE
# IDS, so a nested instance (Result over List_String) can be composed one level
# at a time; 0 when that instance was never demanded.
specTidArgs: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    templateTid: ztypes.tid
    a1: ztypes.tid
    a2: ztypes.tid
} out ztypes.tid is {
    argTids: ListVal ztypes.tid
    argTids.append a1
    if a2.notZero then argTids.append a2
    return (ztypecheck.specLookup :reg :typing templateId: templateTid args: argTids)
}

# originTidOf -- a type's genericOriginId (the template it monomorphized from), or
# 0 when it has none.
originTidOf: function {reg: ztypes.ZTypeRegistry.view tid: ztypes.tid} out ztypes.tid is {
    # a partial spec is trie bookkeeping, never an emittable mono; origin-keyed
    # sweeps must not select it. Asked of the flag, not the typetype: a bare
    # type parameter and a trie interior node wear GENERIC_PARAM too, and both
    # already answer 0 through the origin below.
    if (reg.isPartialOf :tid) then return ztypes.tid.zero
    return (reg.genericOriginOf :tid)
}

# originIsTid -- true when tid's generic origin equals the (nonzero) originTid.
# The 0-guard means an origin-less type never matches an unresolved (0) builtin.
originIsTid: function {
    reg: ztypes.ZTypeRegistry.view
    tid: ztypes.tid
    originTid: ztypes.tid
} out bool is {
    if originTid.isZero then return false
    ot: originTidOf :reg :tid
    return ot == originTid
}

# family -- the builtin templates the emitter keys on by ORIGIN tid: one list, a
# family's label beside its template's name. A row's SLOT is its index into
# `ctx.origins`, which buildOriginTids fills by walking the names, so
# `ctx.origins.get i: family.slot.listVal` is the tid `ListVal` was minted from --
# and an id compare against it is shadow-proof, which comparing the spelling was
# not. `fixedArray` is the `array` template: a list's own `.array` member
# would shadow a label of that name.
family: list {
    str: "str"
    fixedArray: "array"
    listRef: "ListRef"
    listVal: "ListVal"
    listView: "ListView"
    listViewVal: "ListViewVal"
    spanVal: "SpanVal"
    map: "MapRR"
    mapRV: "MapRV"
    mapVR: "MapVR"
    mapVV: "MapVV"
    set: "SetRef"
    setVal: "SetVal"
    idMapR: "IdMapR"
    idMapV: "IdMapV"
    idSet: "IdSet"
    idSetIter: "IdSetIter"
    idMapItemIterR: "IdMapItemIterR"
    idMapItemIterV: "IdMapItemIterV"
    idMapEntryR: "IdMapEntryR"
    idMapEntryV: "IdMapEntryV"
    mapEntry: "MapEntry"
    listIter: "ListIter"
    listIterVal: "ListIterVal"
    listIterMut: "ListIterMut"
    listIterMutVal: "ListIterMutVal"
    staticIter: "StaticIter"
    setIter: "SetIter"
    setIterVal: "SetIterVal"
    mapKeyIter: "MapKeyIter"
    mapItemIter: "MapItemIter"
    mapKeyIterRV: "MapKeyIterRV"
    mapKeyIterVR: "MapKeyIterVR"
    mapKeyIterVV: "MapKeyIterVV"
    mapItemIterRV: "MapItemIterRV"
    mapItemIterVR: "MapItemIterVR"
    mapItemIterVV: "MapItemIterVV"
    mapEntryRV: "MapEntryRV"
    mapEntryVR: "MapEntryVR"
    mapEntryVV: "MapEntryVV"
    option: "Option"
    result: "Result"
    optionval: "optionval"
    resultval: "resultval"
    # the view unions, adjacent: isViewUnionOriginOf tests the span, and
    # StaticView closes it
    optionView: "OptionView"
    optionViewVal: "OptionViewVal"
    optionMut: "OptionMut"
    optionMutVal: "OptionMutVal"
    staticView: "StaticView"
    # the static list template
    staticList: "staticlist"
} out staticlist StringView

# noFamily -- one past the last row: the count of families and the "not one of
# ours" answer, so no real index can be mistaken for it
noFamily: family.length

# buildOriginTids -- resolve every row in one pass. A unit with no program node
# registers none of them and every row stays 0; the list is filled either way,
# so a `family` index is always in range.
buildOriginTids: function {
    program: Ast.view
    typing: ztyping.ZTyping.view
    acc: ListVal ztypes.tid
} is {
    # a family row is runtime text: interned, then asked by id
    for each nm: family loop {
        acc.append (
            builtinTid
            ast: program
            :typing
            nameId: (zast.poolFind pool: program.names text: nm)
        )
    }
}


# Ctx -- the per-program emission context (anchor cnames, main unit name,
# the literal pool, and the resolved-name map access).
Ctx: class {
    # the main unit's name as the C sees it
    mainName: String
    # the namespace unit whose functions are being emitted, 0 while emitting
    # the file unit's own. A name written inside a namespace resolves against
    # IT first: `deep.mul` in mymod/helper.z names helper's subunit, not one of
    # mymod's, and ctx.mainName can only ever name the file.
    nsTid: ztypes.tid
    # the real entry point's name, which differs when a wrapper stands in front
    # of it
    realMain: String
    # the C name of the String runtime type, looked up once because everything
    # touching strings needs it
    strC: String
    # the C name of the StringView runtime type
    svC: String
    # type id -> C name base, composed once at emit start; "" for a hole
    cnames: List String
    # the literal pool's ids in emission order
    litIds: ListVal zast.nodeid
    # a literal's node id -> its 1-based place in litIds
    litIndex: (IdMapV zast.nodeid v: u64)
    # each pooled literal's byte count, parallel to litIds: the `.size` its view
    # is built with where it is used
    litSizes: ListVal u64
    # which literals were actually referenced, so the unused ones are not
    # emitted
    usedLits: IdSet zast.nodeid
    # the FOLDED-string pool, beside the AST-literal one. A folded value has no
    # literal to point at -- a concatenation and a selected branch were never
    # written anywhere -- so litIndexOf cannot serve it. Its bytes are `_zcsN_d`
    # and its value is built as a source literal's is (constLitView), and
    # MINTING IS THE USE: an
    # entry exists only because something asked to emit it, so unlike usedLits
    # there is no separate mark.
    constLits: List String
    # every runtime demand written C made, and the configurations each holds in
    demands: zemitrows.DemandSet
    # bumped whenever a demand's condition grows: closeRowNeeds re-runs a fired
    # row's needs when its condition changed
    condEpoch: u64
    rowCondEpochAt: u64
    rowCondKey: (IdMapR u64 V: String)
    # the foundation's conditions, by bit (Cond)
    conds: List CondDecl
    # the Set and Map instances whose kept text spells their key's `==` /
    # `hash` (tmplKeptSpells): member uses only grow, so a yes is final
    keyEqKept: IdSet ztypes.tid
    keyHashKept: IdSet ztypes.tid
    # a no, with the member use count it was given at: still no while no
    # member use was added
    keyEqNoAt: (IdMapV ztypes.tid v: u64)
    keyHashNoAt: (IdMapV ztypes.tid v: u64)
    # each function's "RET cname(PARAMS)", by its type: the forward
    # declaration and the definition write the same text, built once
    fnSigs: (IdMapR ztypes.tid V: String)
    # a native operator row's hole bindings: `StringView` and `T` its cnames,
    # `L` and `R` its operands. The holes never change and the values are
    # replaced per operator, so the four lists live here and an operator
    # borrows them (emitOperatorAt) rather than building four of its own
    opBindIds: ListVal zast.nameid
    opBindVals: List String
    opRawIds: ListVal zast.nameid
    opRawVals: List String
    # the current class method body's pointer-receiver params, by variable id
    ptrVids: ListVal ztypes.vid
    # every variable holding a data value: a handle, read through with `->`
    # (noteStaticVids, once per program)
    staticVids: IdSet ztypes.vid
    # every data type, so a variable narrowed to one reads through its handle
    staticTids: IdSet ztypes.tid
    # the enclosing function hands back a REFERENCE to a user reftype, so its
    # `return` yields an address. Per-function, set by emitFnBody like ptrVids.
    refBorrowRet: bool
    # variables that are aliases of another's storage, so a write through one is
    # a write through both
    aliases: List VidVal
    # the box a narrowed variable projects out of
    narrowBox: List VidVal
    # the types each narrowBox text spells, recorded when the text is read
    aliasHeld: List AliasHeld
    # while an arm alias is built: noteTypeUse holds its types in heldTypeUses
    # instead of recording them
    typeUseHold: bool
    heldTypeUses: ListVal ztypes.tid
    # the type a variable is currently narrowed to
    narrowTid: List VidTid
    # the arms ruled out for a variable, which lets a switch omit them
    exclArms: List VidArms
    # the types behind those exclusions
    exclTids: List VidTid
    # the save stack for exclusions layered by an `if` clause's conjuncts. One
    # stack for the whole emission, indexed per clause, because a clause layers
    # nothing at all in the ordinary case and a list per clause is an
    # allocation per clause for an empty answer. Entries are popped in reverse,
    # so a nested clause restores before the one enclosing it.
    exSaves: List ExclSave
    # whether a generator body is being emitted, which changes what a return
    # means
    genActive: bool
    # the generator class whose `call` is being emitted: the owner of its state
    # fields
    genTid: ztypes.tid
    # that generator's row of synthesized state fields (typing.genFields)
    genFieldsRow: u64
    # the `return`, `break` or `continue` statement being emitted, whose
    # destroys the checker recorded (exitDestroy); 0 at a tail value, which
    # records none
    exitNode: zast.nodeid
    # the emitted C name of the generator receiver, for the state-machine
    # prologue: it is a renamed parameter, not the literal `this`
    genRecvC: String
    # and the emitted name of its resume-value parameter
    genValC: String
    # how many yields the generator has, so the state machine knows its arms
    genYieldCount: u64
    # the next yield's number as the body is walked
    genYieldNext: u64
    # the last `#fc_<k>` loop-counter field handed to a counted `for` whose
    # body suspends. Which field a loop gets does not matter, only that each
    # gets its own: they are all i64, and the lowering allocated at least this
    # many by the same walk
    genForNext: u64
    # the counted `for` loops currently open around the statement being
    # emitted, innermost last. Every suspension spills all of them and every
    # resume label reloads them
    genForSpills: List ForSpill
    # the for-EXPRESSION append targets open around the statement being
    # emitted, innermost last: a comprehension records one, and the loop's own
    # body takes it (emitBodyNode). Nested only through a comprehension inside
    # another's body, which is why it is a stack rather than a slot
    comprehendTo: List ComprehendTo
    # the yield number of each yield HOISTED out of expression position, by
    # call node id. The suspension runs as its own statement and the resume
    # value lands in `#yv_<k>`; the expression emitter then renders that yield
    # as a plain read of it
    yieldTempK: (IdMapV zast.nodeid v: u64)
    # the wrapper type the generator's `.call` returns
    genWrap: String
    # that wrapper's some tag
    genSomeTag: String
    # and its some arm's C member name
    genSomeC: String
    # the wrapper's none tag, which the generator returns once it is exhausted
    genNoneTag: String
    # the payload's C type
    genPayC: String
    # whether the generator yields a value at all, as against yielding only to
    # suspend
    genHasValue: bool
    # the receiver type being emitted into, which decides what a bare member
    # resolves against
    curThisTid: ztypes.tid
    # use the fast hash rather than the seeded one, which makes a build
    # reproducible
    fastHash: bool
    # emit source-derived C names instead of id-based ones, for reading the
    # output rather than shipping it
    readableNames: bool
    # whether the statement being emitted is in tail position, where a return
    # needs no jump
    tailRetActive: bool
    # the body's last statement was emitted as a `return`, so nothing after it runs
    tailReturned: bool
    # which unit each definition came from
    defUnitId: (IdMapV ztypes.tid v: ztypes.declid)
    # the classes the runtime writes, in table order, each class's id once bound
    # (bindClassRows), and the ones the program made live (markLiveClasses)
    classRows: List ClassRow
    classRowTids: ListVal ztypes.tid
    liveClasses: IdSet ztypes.tid
    # where each record's or class's data-field list starts in fieldNameIds, read
    # once per type (fieldOrdinalOf)
    fieldListAt: (IdMapV ztypes.tid v: u64)
    # those lists end to end, each ended by a zero id
    fieldNameIds: ListVal zast.nameid
    # the main unit's declaration, which every demand walk starts from
    mainUnitId: ztypes.declid
    # how deep in nested conditions the emit is, which decides whether a temp
    # can be hoisted out
    condDepth: u64
    # a `return` has been emitted in this function: what comes later does not
    # run on every path
    returnEmitted: bool
    # the constructs the emitter could not handle and the `error` calls it
    # proved reachable, collected rather than thrown so one run reports all of
    # them
    emitErrors: List zast.ErrorData
    # the user types whose struct is already out, so a second demand does not
    # emit it twice
    emittedUserTypes: IdSet ztypes.tid
    # the types whose generated `==` has been asked about, and those that have
    # one, so a C `_eq`
    eqAsked: IdSet ztypes.tid
    eqHasBody: IdSet ztypes.tid
    # the types whose generated `_eq` written C calls: only these are written
    # (noteEqUse)
    eqUsed: IdSet ztypes.tid
    # the types whose destructor written C calls: a record's or a class's is
    # written only then (noteDestroyUse)
    destroyUsed: IdSet ztypes.tid
    # the types written C builds field by field: a record's or a class's
    # `_meta_create` is written only then (noteCreateUse)
    createUsed: IdSet ztypes.tid
    # those whose `<rc>_create` name written C calls: only these get the
    # `#define` that names `_meta_create` so (noteCreateAliasUse)
    createAliasUsed: IdSet ztypes.tid
    # the types whose generated `_hash` is written, in the order they were
    # demanded
    hashAsked: IdSet ztypes.tid
    hashOrder: ListVal ztypes.tid
    # the generated helpers that call a method the author wrote: their bodies,
    # written after every function prototype
    lateDefs: String
    # the types already forward-declared. Asking whether a FORWARD exists is not
    # the same as asking whether the body is out, and conflating them emits
    # invalid C
    fwdDeclaredTypes: IdSet ztypes.tid
    # the function types whose `_ft` typedef the program needs: every one a
    # written signature names before the typedef pass, and every one a field,
    # parameter, variable or return declares
    fnptrDemand: IdSet ztypes.tid
    # the function types whose `_ft` typedef the pass wrote
    fnptrWritten: IdSet ztypes.tid
    # the typedef pass has run: a function type met after it must be one it wrote
    fnptrPassDone: bool
    # the struct types the generated code spells (typeRefC, a fragment's
    # holes) while it is generated, which is before any type is written
    typeUses: IdSet ztypes.tid
    # the ordinal variants written C spells a tag constant of (spelledTagConst):
    # their enum is written, but their type name only where it is spelled
    ordinalTagUses: IdSet ztypes.tid
    # the ordinal variants reached only through their tag constants: written
    # as their enum alone, with no type name (closeReachedTypes)
    tagOnlyTypes: IdSet ztypes.tid
    # the other variants whose tag enum written C spells -- a tag constant, or
    # the `_tag_t` type a fragment names: only these, and a variant whose struct
    # stores its tag as the enum, write it (tagEnumWritten)
    tagEnumUses: IdSet ztypes.tid
    # those closed over what each one's C spells in turn: its fields, arm
    # payloads, elements and the signatures of its used members. Only these
    # types are written
    reachedTypes: IdSet ztypes.tid
    # the reached set is closed: a struct type spelled after it must be in it
    reachFixed: bool
    # every function the units could write, in the order the C writes them
    # (planFns), and each one's job by its type id
    fnJobs: ListVal fnjob
    fnJobAt: (IdMapV ztypes.tid v: u64)
    # the written functions are fixed: a function spelled after must be one
    fnClosed: bool
    # every function written C spells, whether or not it is a job: a generated
    # member written only where named (hashMemberRead) asks it
    fnSpelled: IdSet ztypes.tid
    # the (impl, protocol) pairs a NATIVE implementer is boxed as -- a String or a
    # str mono handed to a StringViewable. The runtime supplies such an impl's struct, so
    # no unit pass writes its helpers: every box site asks for them here, and
    # emitC writes them once the last body is out
    nativeBoxes: ListVal nativebox
    # the native texts zc carries -- each fixed file, row fragment and
    # template -- by kind and name (textkey), and the names by id (row 0 the
    # sentinel "")
    texts: (MapVR textkey V: String)
    textIds: (MapRV String v: u32)
    textNames: List String
    # each canonical stem's C name (stemCname)
    stemCnames: (Map String V: String)
    # the units' canons: stem -> the instance's template and
    # type arguments, comma-separated
    canonSpecs: (Map String V: String)
    # the links, sources and refusals: what a reached unit needs from the C
    # toolchain
    unitReqs: List UnitReq
    # the runtime text the emitter fills, each parsed once (RtTexts)
    rt: RtTexts
    # each native text's parse (tmplTextOf), and the runtime a template needs
    tmplTexts: (MapVV textkey v: rtid)
    tmplNeeds: (MapVR textkey V: String)
    # the pieced texts read and not yet parsed (tmplParsed)
    piecedTexts: (MapVR textkey V: PiecedText)
    # the pulls of the rows answering each demand, comma-separated (needsAddPullsOf)
    pullsByDemand: (MapVR zemitrows.demandkey V: String)
    # the C words an emitted identifier dodges (cReserved)
    cWords: zast.Vocab
    # the operator spellings a C identifier cannot carry (opSpelling)
    opWords: zast.Vocab
    # the words the rows and the fragments spell that the loader acts on
    nativeWords: zast.Vocab
    # the user units whose C implementation file (`<unit>/nativec.zd`) was
    # read (UserImplementation), by name
    implementedUnits: Set String
    # zc emit --mark-natives: each native text written is marked with where
    # it is written (NativeMark)
    markNatives: bool
    # each native text's place: its row in `marks`, 0 for a text with none
    nativeMarks: (MapVV textkey v: u64)
    # row 0 is the sentinel, no place
    marks: List NativeMark
    # the rows, one table, each found by the declaration it implements
    # (rowNameOfFn, rowNameOfMember)
    rows: zemitrows.RowTable
    # the hoists that realise one of the checker's unnamed locals: the local's
    # name id by hoist name; flushing a hoist moves it onto the temporary it owes
    hoistTags: (MapRV String v: zast.nameid)
    # the fragment rows already written: a unit whose types a function type's
    # typedef spells is written ahead of the typedefs, and not again after
    rowsWritten: IdSet u64
    # the fired rows whose needs are registered (closeRowNeeds), and the
    # count of demands when that was last made whole
    rowsClosed: IdSet u64
    # the closed rows that hold in every configuration: their needs are final
    rowsAlwaysClosed: IdSet u64
    rowNeedsAt: u64
    # the rows a file writes in place, which no unit walk writes: every piece,
    # and the row whose fragment the header writes (z_panic's)
    rowsInPlace: IdSet u64
    # the prelude fragments holding pieces, by name: written a piece at a time
    piecedFrags: Set String
    # the template members written C calls, each keyed by its instance and its
    # memberWord slot (memberKey): a template's member section is written for an
    # instance only where its member is here (rtSectionPlan)
    memberUses: IdSet u64
    # a member used only under conditions has terms here (memberCond); one
    # used in every configuration after that is in memberAlways
    memberConds: ListVal membercond
    memberAlways: IdSet u64
    # the template members' vocabulary
    memberWords: zast.Vocab
    # the members an instance was written without: spelling one after is late
    membersLeftOut: IdSet u64
    # the units the rows belong to, each once, in the order the table first
    # names them: where a fragment's plain type-name hole is looked up after
    # the system unit (stemTid). The system unit itself is not listed
    fragUnitDecls: ListVal ztypes.declid
    # the type ids those rows gate, and the ones the program actually built
    demandGatedTids: IdSet ztypes.tid
    # the types something actually referenced, which is what decides emission
    usedTypeIds: IdSet ztypes.tid
    # implementation rows whose helper set is already in the buffer, by row id
    emittedImplementation: IdSet ztypes.confid
    # implementation rows written C makes a value of -- an impl boxed as its
    # protocol or facet (noteBoxUse): only these rows' helpers are written
    boxedImplementation: IdSet ztypes.confid
    # each (impl, protocol) pair written C boxes as an OWNED protocol value
    # (noteOwnedBoxUse): only these get `_create_owned` and `_owned_destroy`
    ownedBoxUses: IdSet u64
    # each (impl, protocol or facet) pair written C boxes as a BORROWED value,
    # or copies into a facet (noteBorrowBoxUse): only these get `_create`
    borrowBoxUses: IdSet u64
    # the static aggregate rows written C spells `_zag<row>` of (noteAggUse),
    # those written, each one's text and its row in the order written
    # (writeDemandedAggs), and whether the written set is fixed
    aggUses: IdSet u64
    aggWritten: IdSet u64
    aggsOut: List WrittenAgg
    aggsFixed: bool
    # the static list rows whose reader `_zag<row>_at` written C calls
    # (noteAggReaderUse)
    aggReaderUses: IdSet u64
    # each marker protocol (one with no members) asked about, to whether the
    # program makes a value of it (markerValueMade)
    markerValues: (IdMapV ztypes.tid v: bool)
    # ListIter monos whose cursor is already in the buffer. A List and a view
    # of it resolve `iterate` to ONE mono, so both reach the same typedef
    emittedListIters: IdSet ztypes.tid
    # the units the table orders, in that order. A unit with rows that is not
    # named here runs after those that are.
    unitOrder: List String
    # the statement temporaries awaiting declaration
    argHoists: List ArgHoist
    # statements the statement being built runs ahead of itself, among the
    # argument hoists in the order they were recorded
    argHoistRaw: List RawHoist
    # the next `_ah` number
    argHoistCtr: u64
    # the parts of the calls being built, in the order they are evaluated: the
    # assignments that run ahead of each call (orderPieces), and, per call, the
    # part last read that is not constant and not yet given a temp -- its text,
    # the slot it fills, and the function, parameter type and parameter name
    # its temp's C type is spelled from. A call keeps the stretch above the
    # marks it took.
    orderPieces: List OrderPiece
    # the counter every part and piece is numbered from, in the order built;
    # settleAhead touches only those at or above the floor
    orderSeq: u64
    orderSeqFloor: u64
    # how many in-place regions that run only on some paths, or at every loop
    # test, enclose the text being built (openInPlace with `guarded`)
    guardDepth: u64
    # the worklist condHoldsControlValue walks a condition with, kept so that
    # asking about every condition allocates nothing
    condScan: ListVal zast.nodeid
    # each open call's argument texts by parameter slot, "" for a slot no
    # argument fills, and a method call's parameter positions: where each
    # argument is written, the positional cursor it is read with, and whether it
    # has been built
    orderVals: List String
    # the facts of each slot's text
    orderValFacts: ListVal cfacts
    orderWrit: ListVal u64
    orderPosAt: ListVal u64
    orderDone: ListVal bool
    # the open calls' parts still waiting on what follows them
    orderPends: List OrderPend
    # the next `_o` number, the function's own
    orderCtr: u64
    # whether the argument just built was passed by pointer
    lastArgByPtr: bool
    # the lowest temp number the function being emitted has not handed out,
    # across every counter a statement expression in it keeps. A temp declared
    # inside a statement expression counts on from it, so it never shadows a
    # temp the code around it still reads through an alias
    tmpHigh: u64
    # how many argument hoists were pending when the innermost statement
    # expression began: they belong to the statement around it, which declares
    # them, so a statement inside flushes only the hoists it added
    argHoistFloor: u64
    argHoistRawFloor: u64
    # inside a control value emitted as a reference (emitControlPtrExpr): one
    # more than the number of the `_cv` pointer its arms assign, 0 outside one
    armRefCv: u64
    # the reference control values being built as statements, innermost last:
    # a temporary an arm parks its value in waits here until the outermost one
    # is done, since the statement around it declares and releases it
    armRefDepth: u64
    armParks: List ArgHoist
    # the temporaries the statement being emitted declares live as long as the
    # binding it builds, not as long as the statement
    hoistsToBlock: bool
    # the next `_wc` number: the guard a suspending `when` condition computes
    # into, since its value has to outlive the `if` that computes it
    whenGuardCtr: u64
    # the enclosing loops and do-blocks, innermost last
    loops: List LoopFrame
    # which continue labels were actually jumped to, so an unused one is not
    # emitted
    contLabelUsed: (IdMapV u64 v: bool)
    # the next label number
    breakLabelCtr: u64
    # which break labels were actually used
    breakLabelUsed: (IdMapV u64 v: bool)
    # variables that borrow rather than own, so scope exit frees nothing for
    # them
    borrowedVars: (IdMapV ztypes.vid v: bool)
    # String's type id
    strTid: ztypes.tid
    # StringView's type id
    svTid: ztypes.tid
    # text's type id: laid out as a StringView, and spelled with its C name
    textTid: ztypes.tid
    # converror's canonical id. The numeric-conversion rule is ABOUT converror --
    # the conversion rows name its arms -- so the emitter has to know
    # which type that is to spell the error assignment for its representation.
    converrorTid: ztypes.tid
    # bool's type id: an interpolated bool prints its arm's name
    boolTid: ztypes.tid
    # the well-known generic origins -- Option, Result, List and the rest --
    # looked up once and compared by id after
    origins: ListVal ztypes.tid
}


# canonTypeId -- the type a stamped id stands for: itself when it is a generic
# instance, has a declaration, or is a user family's type; 0 for a shell that is
# none of these (a generic parameter, a list). Never looked up by name: a
# name names a different type in another unit.
canonTypeId: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
} out ztypes.tid is {
    if (originTidOf :reg :tid).notZero then return tid
    if (typing.declIdOfType typeId: tid).notZero then return tid
    if (reg.typetypeOf typeId: tid).isUserFamily then return tid
    return ztypes.tid.zero
}

# dropPtrVid -- forget that `vid` arrives by pointer, for the scope in which a
# narrowing has shadowed it with its payload VALUE; the caller re-appends it
# when that scope closes.
dropPtrVid: function {ctx: Ctx vid: ztypes.vid} is {
    kept: ListVal ztypes.vid
    for each v: ctx.ptrVids loop {
        if v != vid then kept.append from: v
    }
    ctx.ptrVids = kept.take
}

# isPtrVid -- true when variable `vid` is a pointer-receiver param of the
# current class method body (so field reads emit `->` instead of `.`). The
# id-addressed form; a vid of 0 means the site had no variable to name and is
# never a pointer receiver. A NARROWED variable reads as its payload's alias,
# an lvalue of the payload itself, so it is no pointer while the narrowing
# lasts.
isPtrVid: function {ctx: Ctx.view vid: ztypes.vid} out bool is {
    if vid.isZero then return false
    if (ctx.staticVids.has item: vid) then return true
    # narrowed to a data value: the payload is a handle
    nt: (vtGet xs: ctx.narrowTid :vid).or d: ztypes.tid.zero
    if nt.notZero when (ctx.staticTids.has item: nt) then return true
    if (ctx.ptrVids.contains item: vid).not then return false
    return (vvHas xs: ctx.narrowBox :vid).not
}

# needsValueDeref -- a pointer-valued expression standing where a VALUE is
# wanted: a return, a binding's initialiser, a match subject. An as-block
# method's receiver is a C pointer in EVERY family, so a read of it in one of
# those positions has to load the pointee; ~50 other sites ask pathIsPointer to
# choose `->` over `.` or to drop an `&`, and none of them wants the load.
# A user CLASS is the exception and the gate is not caution: it is the one
# family passed BY REFERENCE, so its pointer already IS the value, and loading
# one would copy a struct whose destructor the source still owns -- a double
# free, where leaving it alone is a C type error the compiler still catches. A
# Set, a Map or a box is not loaded either: its value is its pointer
# (valueIsItsPointer).
needsValueDeref: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    tid: ztypes.tid
} out bool is {
    if (nodeIsBareAtom :n).not then return false
    if (pathIsPointer :ast :reg :typing :ctx :n).not then return false
    if (valueIsItsPointer :reg :typing :ctx :tid) then return false
    return (isReftypeParam :reg :typing :ctx :tid).not
}

# valueExprC -- an expression standing where a VALUE is wanted: a binop
# operand, an argument to a by-value parameter, a payload, a condition, an
# interpolation part, the right side of a reassignment. A pointer-held valtype
# atom (a `.view` parameter, a pointer receiver) and a reference-returning
# call's valtype result (`xs.getMut i: 0` over a ListVal) are loaded here;
# every other expression is emitExpr's text unchanged. The positions that want the POINTER
# -- a receiver, a dotted base, an argument to a pointer parameter -- keep
# asking emitExpr and pathIsPointer. The cheap tests come first so the common
# case pays no stamp read.
valueExprC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    facts: cfacts.borrow
} out String is {
    eF: cfacts
    e: emitExprWith :ast :reg :typing :ctx :n facts: eF
    if (ptrHeldValtype :ast :reg :typing :ctx :n) then {
        return (stating :facts from: (operandFacts e: eF place: true) text: "(*\{e})")
    }
    if (refValtypeResult :ast :reg :typing :ctx :n) then {
        return (stating :facts from: (operandFacts e: eF place: true) text: "(*\{e})")
    }
    return (stating :facts from: eF text: e)
}

# ptrHeldValtype -- a bare atom that is a C pointer to a value of a BY-VALUE
# family (passesByValue): a `.view` valtype parameter, a receiver. A String,
# StringView or container view is a pointer its own legs already spell for,
# and a class is passed by reference, so its pointer IS the value.
# The family is the VARIABLE's declared type, not the node's stamp: a union
# parameter narrowed by a guard is stamped with its payload record while the
# C still holds the union pointer. The cheap tests come first so the common
# case pays no registry read.
ptrHeldValtype: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out bool is {
    nid: valueAtomNid :n
    if nid.isZero then return false
    # the variable first: most atoms are not pointers, and the pointer table is
    # the one short scan; the alias walk pathIsPointer adds runs only for one
    vid: atomVid :typing :nid
    if (isPtrVid :ctx :vid).not then return false
    if (pathIsPointer :ast :reg :typing :ctx :n).not then return false
    vt: chaseAggregateTypedef :reg :typing :ctx tid: (reg.variableTypeOf id: vid)
    # a data value's pointer is the value itself, never loaded: a variable of a
    # data type, or a sum's data payload the node is narrowed to
    if (isStaticHandle :reg :typing tid: vt) then return false
    if (isStaticHandle :reg :typing tid: (stampIdOf :typing :nid)) then return false
    return (passesByValue :reg :ctx tid: vt)
}

# passesByValue -- an unmarked parameter of tid takes its argument BY VALUE: a
# valtype, a protocol, whose fat pointer is a pure handle on a boxed implementer,
# and a view union (OptionView), whose payload is a pointer to what it views.
# A class, a String, an owning union (Option, Result) and the collections pass
# by pointer (unionBorrowsByPtr).
passesByValue: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    if (reg.isValtypeOf :tid) then return true
    tt: reg.typetypeOf typeId: tid
    if tt == ztypes.ztypetype.unionType then return (isViewUnionOriginOf :reg :ctx :tid)
    return tt == ztypes.ztypetype.protocolType
}

# valueAtomNid -- the node id of a bare local read, through any parentheses:
# an atom, or the `:name` argument shorthand, which is the same read spelled
# as a label. 0 for anything else.
valueAtomNid: function {n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case atomid then {
        return n.nodeid
    } case labelvalue then {
        return n.nodeid
    } else {
        return zast.nodeid
    }
}

# whether a node is a bare atom, which is what decides whether a name can be
# used directly or needs an expression
nodeIsBareAtom: function {n: astnode.view} out bool is {
    match (
        n
    ) case atomid then {
        return true
    } else {
        return false
    }
}

# pathIsPointer -- does the expression evaluate to a C pointer? A pointer variable
# (pointer receiver / borrow param) or a dotted read of a borrowed field both do,
# so field access on them chains with `->`.
pathIsPointer: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out bool is {
    # a data value is a handle, however it is reached
    nStamp: stampIdOf :typing nid: (zast.nodeIdOf :n)
    if (isStaticHandle :reg :typing tid: nStamp) then return true
    match (
        n
    ) case atomid then {
        anP: ast.names.texts.get i: n.name
        nameVid: atomVid :typing nid: n.nodeid
        rnv: ztypes.vid
        selfA: (
            aliasResolvesToSelfAt
            :reg
            :typing
            :ctx
            nid: n.nodeid
            name: anP.stringView
            vid: nameVid
        )
        if selfA then rnv = nameVid
        return (isPtrVid :ctx vid: rnv)
    } case labelvalue then {
        lnP: ast.names.texts.get i: n.name
        leafVid: atomVid :typing nid: n.nodeid
        rlv: ztypes.vid
        selfL: (
            aliasResolvesToSelfAt
            :reg
            :typing
            :ctx
            nid: n.nodeid
            name: lnP.stringView
            vid: leafVid
        )
        if selfL then rlv = leafVid
        return (isPtrVid :ctx vid: rlv)
    } case call then {
        # a reference-returning call yields `T*`. The arm narrows `n` to
        # callrow, so the astnode is re-fetched by its own id.
        cnd: ast.nodes.get i: n.nodeid
        return (nodeIsRefBorrowResult :ast :reg :typing :ctx n: cnd)
    } case dottedpath then {
        # a ZERO-ARG auto-call reads as a dotted path, so a reference-returning
        # one is itself a `T*` and a read off it is `->`. The arm narrows `n`, so
        # the astnode is re-fetched by its own id.
        dnd: ast.nodes.get i: n.nodeid
        if (nodeIsRefBorrowResult :ast :reg :typing :ctx n: dnd) then return true
        # an access or borrow marker contributes no C text: `b.private` and
        # `b.borrow` ARE `b`, a pointer exactly when `b` is one
        if (markerEmitsBase id: (aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child)
        ) then {
            return (pathIsPointer :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent))
        }
        return (borrowedFieldPath :ast :reg :typing :ctx :n)
    } else {
        return false
    }
}

# markerEmitsBase -- a path leaf that is an access or borrow marker, which
# emits as the path's base unchanged.
markerEmitsBase: function {id: zast.nameid} out bool is {
    if id == zast.wellKnown.slot.wkPrivate then return true
    if id == zast.wellKnown.slot.wkPublic then return true
    if id == zast.wellKnown.slot.wkBorrow then return true
    return id == zast.wellKnown.slot.wkView
}

# borrowedFieldPath -- the dotted path reads a NON-OWNED field (`c.l` on
# `l: (ListVal t: i64).borrow`) off storage a variable names, so its text is the
# pointer the C holds the field by. The field is asked of the parent's stamp
# whatever its shape: a borrowed field reached through a nested owned field
# (`p.left.s`) is a pointer too. Read off a value a call computes, the text is
# the place the pointer reaches instead (emitDottedRead).
borrowedFieldPath: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
} out bool is {
    if (borrowedPointerField :ast :reg :typing :ctx :n).not then return false
    return (fieldBaseIsPlace :ast :typing n: (ast.nodes.get i: n.parent))
}

# fieldBaseIsPlace -- a field read off `n` reads storage a variable names: `n`
# is that variable, or a field or marker path down to it. A call, a zero-arg
# method that auto-calls and a type name all yield a value of their own.
fieldBaseIsPlace: function {
    ast: Ast.view typing: ztyping.ZTyping.view n: astnode.view
} out bool is {
    match (
        n
    ) case atomid then {
        return (atomVid :typing nid: n.nodeid).notZero
    } case dottedpath then {
        cid: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        if (memberDeclIsField :typing nid: n.nodeid).not when (markerEmitsBase id: cid).not then {
            return false
        }
        return (fieldBaseIsPlace :ast :typing n: (ast.nodes.get i: n.parent))
    } else {
        return false
    }
}

# borrowedPointerField -- the dotted path reads a NON-OWNED field the C holds
# by pointer, whatever it is read off.
borrowedPointerField: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
} out bool is {
    pnid: zast.nodeIdOf n: (ast.nodes.get i: n.parent)
    pstamp: stampIdOf :typing nid: pnid
    prid: canonTypeId :reg :typing tid: pstamp
    ptid: pstamp
    if prid.notZero then ptid = prid
    if (
        typing.declIsBorrowedFieldId
        parentTypeId: ptid
        nameId: (aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child)
    ).not then return false
    ft: stampIdOf :typing nid: (zast.nodeIdOf n: (ast.nodes.get i: n.nodeid))
    return (borrowedFieldHeldByPointer :reg :typing :ctx fid: ft)
}

# refValtypeResult -- the node is a reference-returning call whose result is a
# VALTYPE: a `T*` in the C, where a by-value position wants the `T`.
refValtypeResult: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out bool is {
    if (nodeIsRefBorrowResult :ast :reg :typing :ctx :n).not then return false
    return (reg.isValtypeOf tid: (stampIdOf :typing nid: (interpPartNodeId :n)))
}

# nodeIsRefBorrowResult -- the node evaluates to a reference-returning call's
# result, i.e. a `T*` in the emitted C. A String or List reference is not one:
# emitExpr spells it loaded (valueStructRefNode).
nodeIsRefBorrowResult: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out bool is {
    f: refBorrowCalleeFid :ast :reg :typing :ctx :n
    if f.isZero then return false
    r: stampIdOf :typing nid: (interpPartNodeId :n)
    ft: f
    if (fnReturnsRefBorrow :reg :typing :ctx fid: ft retTid: r).not then return false
    if (reg.isNativeOf tid: ft) then return true
    return (returnsValueStructRef :reg :typing :ctx fid: ft retTid: r).not
}

# spillkind -- how a value a suspension saved to a state field is put back
# into its C local after the resume label.
spillkind: variant {
    # a plain copy both ways: a counted-for counter, a value payload
    copy: null
    # an owned payload: the field owns it only while suspended, so the reload
    # zeroes the field and the local owns it again
    owned: null
    # a borrowed view copied by value: the saved wrapper's data pointer is
    # dereferenced into the local
    viewCopy: null
    # a borrowed view bound by pointer: the saved wrapper's data pointer IS
    # the local
    viewPtr: null
}

# ForSpill -- one loop counter, loop payload or `with` value open around the
# statement being emitted, and the state field it is saved to across a
# suspension. Keyed by C NAME rather than variable id because a `for` label
# has neither: it is a nameid on the header's namedoperation, and the checker
# binds it with `define` rather than `defineVar`, so no node carries a
# variable id to look up. The C name is the right key anyway -- the spill and
# the reload are both plain C assignments, written in the loop's own scope.
ForSpill: class {
    # the state field, as the C lvalue genFieldC spells (`this->f3`)
    field: String
    # the C expression saved before the return: the local, or the `_iterN`
    # wrapper a borrowed view is re-derived from
    saved: String
    # the C lvalue restored after the resume label
    restored: String
    # which reload shape
    kind: spillkind
    # the payload C type the view kinds cast through; "" for a plain copy
    payC: String
    # what the owned kind leaves the field holding once the local has the
    # payload back (movedZeroC); "" when the payload owns nothing
    payZero: String
}

# ComprehendTo -- a for-EXPRESSION's append target: the C list its body's value
# is appended to, and the BODY NODE that may take it. THE NODE IS THE KEY. A
# construct in the loop's HEADER emits a body of its own through emitBodyNode,
# and only the loop's own body may take the target; a bare flag would be spent
# on the first of them.
ComprehendTo: class {
    # the loop body this target belongs to
    body: zast.nodeid
    # the list mono's C name base
    cb: String
    # the C variable holding the list
    lvar: String
}

# VidVal / VidTid -- assoc-list entries for the per-function narrowing and alias
# state, keyed by VARIABLE ID. A name conflates two bindings that happen to share
# it, and it is not a key a declaration site and a use site can both produce -- a
# variable id is both. A vid of 0 means "no variable here" and never keys an
# entry. A handful of entries at most, so a linear probe beats a map's per-probe
# owned-key allocation and hash.
VidVal: class {
    # the variable
    vid: ztypes.vid
    # the text recorded for it
    val: String
    # the text's facts, stated by whoever recorded it
    facts: cfacts
    # the pointer a borrow alias reads through (bindBorrowAlias), "" for any other
    # entry
    ptr: String
}

# AliasHeld -- a type an arm alias spells, recorded only when the alias is read:
# the narrowing an arm opens is built whether or not the arm reads it
# (heldArmPayloadC, holdForAlias, noteAliasRead).
AliasHeld: class {
    # the alias text, as narrowBox holds it
    val: String
    # a type the text spells
    tid: ztypes.tid
}

# a variable paired with a type, for the side lists that record what a
# variable was narrowed or excluded to. A pair rather than a map: the lists
# are short and scanned, never indexed
VidTid: class {
    # the variable
    vid: ztypes.vid
    # the type recorded for it
    tid: ztypes.tid
}

# a variable paired with the arms recorded for it, by name: the arms an `if`
# clause's conjuncts ruled out for it
VidArms: class {
    # the variable
    vid: ztypes.vid
    # the arms, by name
    arms: ListVal zast.nameid
}

# ExclSave -- what the exclusion tables held for one variable before an `if`
# clause's conjunct layered an exclusion on it (pushExclusion), which
# restoreCondExclusions puts back.
ExclSave: class {
    vid: ztypes.vid
    # the arms excluded for it, empty for none
    arms: ListVal zast.nameid
    # the type those arms belong to, 0 for none
    owner: ztypes.tid
}

# vaGet -- the arms recorded for `vid`, none when absent.
vaGet: function {xs: (List VidArms).view vid: ztypes.vid} out ListVal zast.nameid is {
    f: vidFind :xs :vid
    if f > 0 then return (xs.get i: f - 1).arms.copy
    none: ListVal zast.nameid
    return none
}

# vaSet -- replace-or-append: one entry per variable.
vaSet: function {xs: List VidArms vid: ztypes.vid arms: (ListVal zast.nameid).view} is {
    if vid.isZero then return
    f: vidFind :xs :vid
    if f > 0 then {
        xs.set i: f - 1 val: (VidArms :vid arms: arms.copy)
    } else {
        xs.append (VidArms :vid arms: arms.copy)
    }
}

# idListHas -- whether name id `id` is in `xs`.
idListHas: function {xs: (ListVal zast.nameid).view id: zast.nameid} out bool is {
    for each x: xs loop {
        if x == id then return true
    }
    return false
}

# vidFind -- the 1-based index of `vid`'s entry in `xs`, an assoc list keyed by
# variable id (VidVal, VidTid, VidArms), 0 when absent. The
# value is copied only on a hit, so a miss allocates nothing at all. vvGet's
# empty-String sentinel cost 277,711 one-byte allocations on a self-compile
# (2.9% of every allocation the compiler makes) because the miss is the common
# case: read through this, not vvGet, on any hot path.
vidFind: function as { T: AnyRef.generic } in {xs: (List T).view vid: ztypes.vid} out u64 is {
    if vid.isZero then return 0
    i: u64
    n: xs.length
    for i < n loop {
        if (xs.get :i).vid == vid then return i + 1
        i = i + 1
    }
    return 0
}

# vvGet -- the value recorded for `vid`, "" when absent (values never empty).
vvGet: function {xs: (List VidVal).view vid: ztypes.vid} out String is {
    f: vidFind :xs :vid
    if f == 0 then return "".string
    return (xs.get i: f - 1).val.copy
}

# true when list `xs` has an entry for `vid`.
vvHas: function {xs: (List VidVal).view vid: ztypes.vid} out bool is {
    return (vidFind :xs :vid) > 0
}

# vvFactsOf -- the facts recorded for `vid`'s value; none stated when absent.
vvFactsOf: function {xs: (List VidVal).view vid: ztypes.vid} out cfacts is {
    f: vidFind :xs :vid
    if f == 0 then return cfacts
    return (xs.get i: f - 1).facts
}

# vvSet -- replace-or-append: one entry per variable (map.set semantics).
vvSet: function {xs: List VidVal vid: ztypes.vid val: StringView facts: cfacts} is {
    vvPut :xs :vid :val :facts ptr: String
}

# vvPut -- vvSet for an entry that records the pointer `ptr` it reads through.
vvPut: function {
    xs: List VidVal vid: ztypes.vid val: StringView facts: cfacts ptr: String.take
} is {
    if vid.isZero then return
    f: vidFind :xs :vid
    if f > 0 then {
        xs.set i: f - 1 val: (VidVal :vid val: val.string :facts :ptr)
    } else {
        xs.append (VidVal :vid val: val.string :facts :ptr)
    }
}

# vvHasPtr -- `vid`'s entry reads through a pointer (a borrow alias).
vvHasPtr: function {xs: (List VidVal).view vid: ztypes.vid} out bool is {
    f: vidFind :xs :vid
    if f == 0 then return false
    return (xs.get i: f - 1).ptr.length > 0
}

# vvPtrOf -- the pointer `vid`'s entry reads through, "" when it has none.
vvPtrOf: function {xs: (List VidVal).view vid: ztypes.vid} out String is {
    f: vidFind :xs :vid
    if f == 0 then return "".string
    return (xs.get i: f - 1).ptr.copy
}

# bindBorrowAlias -- read `nm`, a borrow the C holds as the pointer
# `__borrow_<nm>`, as the place it points at: its alias is the pointer's deref, a
# place read twice at no cost, and records the pointer a re-point assigns.
bindBorrowAlias: function {ctx: Ctx vid: ztypes.vid nm: StringView} is {
    p: "__borrow_\{nm}"
    bal: "(*\{p})"
    vvPut xs: ctx.aliases :vid val: bal.stringView facts: derefFacts ptr: p.take
}

# vidRemove -- drop `vid`'s entry from an assoc list keyed by variable id
# (swap-with-last; vids are unique).
vidRemove: function as { T: AnyRef.generic } in {xs: List T vid: ztypes.vid} is {
    f: vidFind :xs :vid
    if f == 0 then return
    last: xs.pop
    if f <= xs.length then xs.set i: f - 1 val: last
}

# the type id bound to `vid` in `xs`, or none.
vtGet: function {xs: (List VidTid).view vid: ztypes.vid} out optionval ztypes.tid is {
    f: vidFind :xs :vid
    if f == 0 then return (optionval.none ztypes.tid)
    return (optionval.some (xs.get i: f - 1).tid)
}

# restoreNarrow -- put back the narrowing a scope shadowed: the value and the
# type the name carried before it, or nothing at all where it carried none. A
# scope that narrows a name saves this pair on the way in and hands it back on
# the way out, so no arm's narrowing outlives the arm.
restoreNarrow: function {
    ctx: Ctx
    vid: ztypes.vid
    prevVal: StringView
    prevFacts: cfacts
    prevTid: ztypes.tid
} is {
    if prevVal.length > 0 then {
        vvSet xs: ctx.narrowBox :vid val: prevVal facts: prevFacts
    } else {
        vidRemove xs: ctx.narrowBox :vid
    }
    if prevTid.notZero then {
        vtSet xs: ctx.narrowTid :vid tid: prevTid
    } else {
        vidRemove xs: ctx.narrowTid :vid
    }
}

# pushNarrow -- point `vid` at the narrowed value `val` of type `tid`, saving
# what the narrow tables held so restoreNarrowSeeds can put it back. The saved
# pair is appended newest last, one per seeded vid.
pushNarrow: function {
    ctx: Ctx
    vid: ztypes.vid
    val: StringView
    valF: cfacts
    tid: ztypes.tid
    prevV: List String
    prevF: ListVal cfacts
    prevT: ListVal ztypes.tid
} is {
    pv: vvGet xs: ctx.narrowBox :vid
    prevV.append pv
    prevF.append (vvFactsOf xs: ctx.narrowBox :vid)
    prevT.append ((vtGet xs: ctx.narrowTid :vid).or d: ztypes.tid.zero)
    vvSet xs: ctx.narrowBox :vid :val facts: valF
    vtSet xs: ctx.narrowTid :vid :tid
}

# restoreNarrowSeeds -- put back every narrowing a scope's seeds displaced, one
# restoreNarrow per saved pair.
restoreNarrowSeeds: function {
    ctx: Ctx
    svids: (ListVal ztypes.vid).view
    prevV: (List String).view
    prevF: (ListVal cfacts).view
    prevT: (ListVal ztypes.tid).view
} is {
    ri: u64
    for ri < svids.length loop {
        rv: prevV.get i: ri
        rt: prevT.get i: ri
        (
            restoreNarrow
            :ctx
            vid: (svids.get i: ri)
            prevFacts: (prevF.get i: ri)
            prevVal: rv.stringView
            prevTid: rt
        )
        ri = ri + 1
    }
}

# bind `vid` to type id `tid` in `xs`.
vtSet: function {xs: List VidTid vid: ztypes.vid tid: ztypes.tid} is {
    if vid.isZero then return
    f: vidFind :xs :vid
    if f > 0 then {
        xs.set i: f - 1 val: (VidTid :vid :tid)
    } else {
        xs.append (VidTid :vid :tid)
    }
}

# aliasResolvesToSelf -- does `vid` stand for its own name, rather than for a
# narrowing box or a take alias? The question aliasResolve is asked when the
# caller wants no text, only the answer; asking it this way copies nothing.
aliasResolvesToSelf: function {ctx: Ctx.view name: StringView vid: ztypes.vid} out bool is {
    nb: vidFind xs: ctx.narrowBox :vid
    if nb > 0 then {
        eNb: ctx.narrowBox.get i: nb - 1
        return eNb.val.stringView == name
    }
    al: vidFind xs: ctx.aliases :vid
    if al > 0 then {
        eAl: ctx.aliases.get i: al - 1
        return eAl.val.stringView == name
    }
    return true
}

# aliasResolveWith -- aliasResolve, the entry's facts stated into `facts`; none
# stated when no table has an entry for the variable.
aliasResolveWith: function {
    ctx: Ctx name: StringView vid: ztypes.vid facts: cfacts.borrow
} out String is {
    nb: vidFind xs: ctx.narrowBox :vid
    if nb > 0 then {
        noteAliasRead :ctx :vid
        return (entryText xs: ctx.narrowBox at: nb - 1 :facts)
    }
    al: vidFind xs: ctx.aliases :vid
    if al > 0 then return (entryText xs: ctx.aliases at: al - 1 :facts)
    return name.string
}

# aliasResolve -- a `.take` alias's base C name, or the name itself if none.
aliasResolve: function {ctx: Ctx name: StringView vid: ztypes.vid} out String is {
    # A match-arm narrowing (narrowBox) takes priority: inside the arm the
    # variable resolves to the narrowed union payload cast, not the un-narrowed
    # binding or a stale for-loop/borrow/take alias -- mirrors emitLocalAtomName.
    # `name` is only what comes back when neither table has an entry.
    nb: vidFind xs: ctx.narrowBox :vid
    if nb > 0 then {
        noteAliasRead :ctx :vid
        return (ctx.narrowBox.get i: nb - 1).val.copy
    }
    al: vidFind xs: ctx.aliases :vid
    if al > 0 then return (ctx.aliases.get i: al - 1).val.copy
    return name.string
}

# takeAliasBaseNid -- the base atom's node of a `<x>.take` over a user record,
# class, union or protocol (an ownership-transfer alias: the binding reuses the
# source storage), 0 otherwise. A variant and a facet are values that own
# nothing; any family that owns something must be here, or a narrowed payload
# taken out of its arm stays in the box the subject's destroy frees.
takeAliasBaseNid: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    n: astnode.view
} out zast.nodeid is {
    match (
        n
    ) case statementline then {
        return (takeAliasBaseNid :ctx :ast :reg :typing n: (ast.nodes.get i: n.statementline))
    } case dottedpath then {
        if (leafMoves :ast leaf: n.child).not then return zast.nodeid
        bnid: atomNodeId n: (ast.nodes.get i: n.parent)
        bt: stampIdOf :typing nid: bnid
        bo: originTidOf :reg tid: bt
        if bo.notZero then return zast.nodeid
        btt: reg.typetypeOf typeId: bt
        isUC: (
            (btt == ztypes.ztypetype.recordType) or
            (btt == ztypes.ztypetype.classType) or
            (btt == ztypes.ztypetype.unionType) or
            (btt == ztypes.ztypetype.protocolType)
        )
        if isUC then return bnid
        return zast.nodeid
    } else {
        return zast.nodeid
    }
}

# baseAtomText -- the text of the base atom node `nid` (takeAliasBaseNid,
# stringviewOfBaseNid), "" for none
baseAtomText: function {ast: Ast.view nid: zast.nodeid} outx StringView is {
    if nid.isZero then return ""
    return (atomTextOf :ast n: (ast.nodes.get i: nid))
}

# takeStringSource -- if `n` is a `<atom>.take` that moves a heap value
# (moveMarkerMovesBase), the resolved C name of the source local to zero after
# the move (the receiver now owns the heap), else "". A function value moves
# too, but its source may be the function itself, which has nothing to zero.
# Used at the statement level to suppress a double free.
takeStringSource: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out String is {
    match (
        n
    ) case statementline then {
        return (takeStringSource :ast :reg :typing :ctx n: (ast.nodes.get i: n.statementline))
    } case dottedpath then {
        if (leafMoves :ast leaf: n.child).not then return "".string
        if (moveMarkerMovesBase :ast :reg :typing :ctx pnid: n.parent).not then return "".string
        bnid: atomNodeId n: (ast.nodes.get i: n.parent)
        bt: stampIdOf :typing nid: bnid
        if (reg.typetypeOf typeId: bt) == ztypes.ztypetype.functionType then return "".string
        baseName: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: (ast.nodes.get i: n.parent))
        return (
            emitLocalAtomName
            :ast
            :reg
            :ctx
            name: baseName.stringView
            vid: (atomVid :typing nid: bnid)
        )
    } else {
        return "".string
    }
}

# isFieldTake -- true iff `n` reduces to a `<obj>.field.take` whose parent is
# itself a dotted path (a field, not a bare atom). The field lvalue is zeroed
# after the move (a bare `<x>.take` is handled by takeStringSource). The checker
# lets such a take move only a field that owns nothing -- a number, a record, a
# view -- and a move out of a field leaves it empty (takeMarkerOnField).
isFieldTake: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case statementline then {
        return (isFieldTake :ast n: (ast.nodes.get i: n.statementline))
    } case dottedpath then {
        if (leafMoves :ast leaf: n.child).not then return false
        return (ast.nodes.get i: n.parent).dottedpath
    } else {
        return false
    }
}

# fieldMoveEmpties -- a `<obj>.field.take` / `.hold` (isFieldTake) leaves the
# field empty when the field is a reftype: its move takes the single owner. A
# valtype's `.take` or `.hold` copies its bytes and leaves the field as it is.
fieldMoveEmpties: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    n: astnode.view
    # the moved field's type: a reftype is emptied, a valtype is not
    tid: ztypes.tid
} out bool is {
    if (isFieldTake :ast :n).not then return false
    return (reg.isReftypeOf :tid)
}

# isLocalTake -- true iff `n` reduces to `<local>.take`: a move out of a variable,
# which a binding of a collection must zero as it does a bare move.
isLocalTake: function {ast: Ast.view typing: ztyping.ZTyping.view n: astnode.view} out bool is {
    match (
        n
    ) case statementline then {
        return (isLocalTake :ast :typing n: (ast.nodes.get i: n.statementline))
    } case dottedpath then {
        if (leafMoves :ast leaf: n.child).not then return false
        pn: ast.nodes.get i: n.parent
        if pn.atomid.not then return false
        return (typing.atomVariableId.get key: pn.nodeid).some
    } else {
        return false
    }
}

# armTakeLeaf -- the node an if or match arm yields when its value moves out of
# its source: an explicit take of a local or of a field, or a bare local the
# value's destination takes; looking through a one-line block and a statement
# line; 0 for any other value.
armTakeLeaf: function {
    ast: Ast.view typing: ztyping.ZTyping.view n: astnode.view
} out zast.nodeid is {
    match (
        n
    ) case statement then {
        if n.statements.count.u64 == 1 then {
            s0Id: zast.kidAt kids: ast.kids span: n.statements i: 0
            return (armTakeLeaf :ast :typing n: (ast.nodes.get i: s0Id))
        }
        return zast.nodeid
    } case statementline then {
        return (armTakeLeaf :ast :typing n: (ast.nodes.get i: n.statementline))
    } else {
        leaf: zast.nodeIdOf :n
        if (isFieldTake :ast :n) or (isLocalTake :ast :typing :n) then return leaf
        # a bare local the checker moved into where the value lands
        if (typing.armLeafMoves.has item: leaf) then return leaf
        return zast.nodeid
    }
}

# armValueExpr -- an if arm's value as one C expression. An arm that takes a
# local or a field moves the value out of its source, and only when that arm
# runs: the source is zeroed inside the expression, so its scope-exit destroy
# no-ops after this arm and still frees the value after an arm that did not.
armValueExpr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    facts: cfacts.borrow
} out String is {
    vxF: cfacts
    vx: emitExprWith :ast :reg :typing :ctx :n facts: vxF
    tn: armTakeLeaf :ast :typing :n
    if tn.isZero then return (stating :facts from: vxF text: vx)
    if (
        movedSourceNeedsZero
        :ast
        :typing
        n: (ast.nodes.get i: tn)
    ).not then return (stating :facts from: vxF text: vx)
    tt: stampIdOf :typing nid: tn
    tz: movedZeroC :reg :typing :ctx tid: tt
    if tz.length == 0 then return (stating :facts from: vxF text: vx)
    tc: typeRefC :ast :reg :typing :ctx tid: tt
    if (isHeapPtrCollection :reg :typing :ctx tid: tt) then tc = "\{tc}*"
    # the value is read into its temp, then its source zeroed
    pre: String
    partF: vxF
    partF.once = true
    t: (
        orderOnePart
        :ast
        :reg
        :typing
        :ctx
        mark: (pendingHoistMark :ctx)
        text: vx.copy
        tf: partF
        nid: zast.nodeid
        ctype: tc.stringView
        constant: false
        twice: true
        prefix: pre
    )
    mv: "\{vx} = \{tz}, \{t}"
    return (stating :facts from: callFacts text: (orderWrap prefix: pre call: mv))
}

# emitArmTakeZero -- after an arm assigned its value `rv` to the target: an arm
# that took a local or a field zeroes the source, as armValueExpr does inside an
# expression.
emitArmTakeZero: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    rv: StringView
    ind: StringView
    buf: String.borrow
} is {
    tn: armTakeLeaf :ast :typing :n
    if tn.isZero then return
    if (movedSourceNeedsZero :ast :typing n: (ast.nodes.get i: tn)).not then return
    tz: movedZeroC :reg :typing :ctx tid: (stampIdOf :typing nid: tn)
    if tz.length == 0 then return
    zl: "\{ind}\{rv} = \{tz};\n"
    buf.append zl
}

# emitNarrowedTakeZero -- before a return's scope cleanup, zero the payload box of
# every narrowed-subject `.take` reachable in the return value (a bare take, or a take
# passed as a construction/call arg). The un-shadowed narrowed subject is freed by the
# return cleanup; its `.take` moved the payload out as a shallow struct copy sharing the
# heap buffer, so the box must read {0} when the destructor walks it, else that buffer is
# double-freed. Non-narrowed takes are not touched here.
emitNarrowedTakeZero: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    buf: String.borrow
} is {
    match (
        n
    ) case statementline then {
        sln: ast.nodes.get i: n.statementline
        emitNarrowedTakeZero :ast :reg :typing :ctx n: sln :ind :buf
    } case dottedpath then {
        if (leafMoves :ast leaf: n.child) then {
            baseVid: atomVid :typing nid: (atomNodeId n: (ast.nodes.get i: n.parent))
            if (vvHas xs: ctx.narrowBox vid: baseVid) then {
                bn: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: (ast.nodes.get i: n.parent))
                box: emitLocalAtomName :ast :reg :ctx name: bn.stringView vid: baseVid
                tido: vtGet xs: ctx.narrowTid vid: baseVid
                if tido.some then {
                    zc: movedZeroC :reg :typing :ctx tid: tido
                    if zc.length > 0 then buf.append "\{ind}\{box} = \{zc};\n"
                }
            }
        }
    } case call then {
        for each argId: (zast.kidsOf :ast span: n.arguments) loop {
            a: ast.nodes.get i: argId
            if a.namedoperation then {
                (
                    emitNarrowedTakeZero
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: (ast.nodes.get i: a.operation)
                    :ind
                    :buf
                )
            }
        }
    } else null
}

# implicitTakeSourceAtom -- the C move-source lvalue of a bare atom, decided by
# the typechecker's stamps ALONE (the emitter never re-resolves a name; a local
# may legitimately shadow a type). A local variable (atomVariableId) is a move
# source; a def/type/fn reference (refDecl) is not; an atom the checker
# stamped as neither (a loop payload, which binds a name and no variable) is a
# plain value and IS a move source.
implicitTakeSourceAtom: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nid: zast.nodeid
    nm: StringView
} out String is {
    avo: typing.atomVariableId.get key: nid
    if avo.some then {
        return (emitLocalAtomName :ast :reg :ctx name: nm vid: avo)
    }
    udo: typing.refDecl.get key: nid
    if udo.some then {
        return "".string
    }
    return (emitLocalAtomName :ast :reg :ctx name: nm vid: ztypes.vid.zero)
}

# moveMarkerBase -- the base node id of an explicit `<x>.take` / `<x>.hold`; 0
# when the node is not a move marker.
moveMarkerBase: function {ast: Ast.view n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case dottedpath then {
        if (leafMoves :ast leaf: n.child).not then return zast.nodeid
        return n.parent
    } else {
        return zast.nodeid
    }
}

# isBareNameValue -- the value is a BARE name.
# The binding legs test this before asking implicitTakeSource for a move source:
# that answer costs a String, and only a bare name can move an owned local.
isBareNameValue: function {n: astnode.view} out bool is {
    match (
        n
    ) case atomid then {
        return true
    } case labelvalue then {
        return true
    } else {
        return false
    }
}

# the source path an implicit `.take` moves from, if any.
implicitTakeSource: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out String is {
    match (
        n
    ) case atomid then {
        itA: ast.names.texts.get i: n.name
        return (implicitTakeSourceAtom :ast :reg :typing :ctx nid: n.nodeid nm: itA.stringView)
    } case labelvalue then {
        itL: ast.names.texts.get i: n.name
        return (implicitTakeSourceAtom :ast :reg :typing :ctx nid: n.nodeid nm: itL.stringView)
    } else {
        return "".string
    }
}

# moveNeedsZero -- whether moving out of the local `vid` zeroes it: a path
# still destroys it (the checker recorded it maybe at a destroy point, or the
# destroy is the emitter's own and the checker said so when it minted the
# variable -- zeroOnMove either way), it is a generator's local, whose field
# the instance's destructor frees, or it is no variable of the checker's at
# all. A local moved on every path that reaches a destroy of it needs
# nothing.
moveNeedsZero: function {typing: ztyping.ZTyping.view vid: ztypes.vid} out bool is {
    if vid.isZero then return true
    if (typing.zeroOnMove.has item: vid) then return true
    return (typing.genLocalFieldOf.get key: vid).some
}

# movedSourceNeedsZero -- moveNeedsZero for the local the value `n` moves out
# of: the base of a `.take` / `.hold`, or a bare name. Any other source -- a
# field -- is zeroed as ever.
movedSourceNeedsZero: function {
    ast: Ast.view typing: ztyping.ZTyping.view n: astnode.view
} out bool is {
    src: zast.nodeid
    mb: moveMarkerBase :ast :n
    if mb.notZero then {
        src = atomNodeId n: (ast.nodes.get i: mb)
    } else if (isBareNameValue :n) then {
        src = interpPartNodeId :n
    }
    if src.isZero then return true
    return (moveNeedsZero :typing vid: (atomVid :typing nid: src))
}

# emitDroppedZero -- a `<local>.drop`, or a `<local>.take` nothing receives,
# at `n` has destroyed what the local held, of type `tid`: the local, whose C
# text is `rcv`, is zeroed where a later destroy of it still runs
# (moveNeedsZero). Any other receiver -- a field -- names no variable, and is
# zeroed as ever.
emitDroppedZero: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    tid: ztypes.tid
    rcv: StringView
    ind: StringView
    buf: String.borrow
} is {
    base: ast.nodes.get i: (dottedParentNodeId :n)
    if (moveNeedsZero :typing vid: (atomVid :typing nid: (atomNodeId n: base))).not then return
    zero: movedZeroC :reg :typing :ctx :tid
    if zero.length > 0 then buf.append "\{ind}\{rcv} = \{zero};\n"
}

# emitExplicitTakeZero -- an explicit `<atom>.take` argument: the source is
# zeroed (movedZeroC) so its scope-exit destructor no-ops, the move having
# transferred ownership -- when a destroy of it still runs (movedSourceNeedsZero).
emitExplicitTakeZero: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    a: zast.namedoperationrow.view
    ts: StringView
    ind: StringView
    buf: String.borrow
} is {
    emitTakenSourceZero :ast :reg :typing :ctx n: (ast.nodes.get i: a.operation) :ts :ind :buf
}

# emitTakenSourceZero -- the value `n` is a `<local>.take`, whose C text is
# `ts`: the local is zeroed where a destroy of it still runs
# (movedSourceNeedsZero).
emitTakenSourceZero: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ts: StringView
    ind: StringView
    buf: String.borrow
} is {
    if (movedSourceNeedsZero :ast :typing :n).not then return
    etid: stampIdOf :typing nid: (interpPartNodeId :n)
    ez: movedZeroC :reg :typing :ctx tid: etid
    if ez.length > 0 then buf.append "\{ind}\{ts} = \{ez};\n"
}

# emitMovedSourceZero -- a bare owning local moved into a taking slot: the
# source is zeroed (movedZeroC) so its scope-exit destructor no-ops. A type
# with no destructor carries nothing to free and needs no zero at all, which
# is also what makes this safe to ask of a COPYING slot -- a valtype element
# has no destructor, so it emits nothing.
# Anything that is not a bare name reads back "" and is the emitter's own
# temporary, not a local something else still destroys.
emitMovedSourceZero: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    buf: String.borrow
} is {
    if (movedSourceNeedsZero :ast :typing :n).not then return
    isrc: implicitTakeSource :ast :reg :typing :ctx :n
    if isrc.length == 0 then return
    iz: movedZeroC :reg :typing :ctx tid: (stampIdOf :typing nid: (interpPartNodeId :n))
    if iz.length > 0 then buf.append "\{ind}\{isrc} = \{iz};\n"
}

# emitImplicitMoveZero -- emitMovedSourceZero for a call argument's value.
emitImplicitMoveZero: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    a: zast.namedoperationrow.view
    ind: StringView
    buf: String.borrow
} is {
    emitMovedSourceZero :ast :reg :typing :ctx n: (ast.nodes.get i: a.operation) :ind :buf
}

# emitCallTakeInvalidations -- zero the source local of each ownership-moved arg
# of a call so its scope-exit destructor is a no-op (the move transferred
# ownership). Which arguments move is the CHECKER's answer, read off the
# argDisposition stamp: an explicit `<atom>.take` is zeroed unless the
# parameter holds it (passed by pointer, never destroyed by the callee), and a
# bare owning local is zeroed when the stamp says the call takes it -- a take
# parameter, an owned constructor field, a collection element.
emitCallTakeInvalidations: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    ind: StringView
    buf: String.borrow
} is {
    for each argId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: argId
        if a.namedoperation.not then continue
        opNode: ast.nodes.get i: a.operation
        isHold: false
        isTake: false
        {
            disp: typing.argDisposition.get key: (ztypecheck.nodeId n: opNode)
            if disp.some then {
                if disp == ztypes.zparamownership.holdMode then isHold = true
                if disp == ztypes.zparamownership.takeMode then isTake = true
            }
        }
        ts: takeStringSource :ast :reg :typing :ctx n: opNode
        if ts.length > 0 then {
            emitExplicitTakeZero :ast :reg :typing :ctx :a ts: ts.stringView :ind :buf
        } else if isTake or isHold then {
            emitImplicitMoveZero :ast :reg :typing :ctx :a :ind :buf
        }
        emitValueTakeInvalidations :ast :reg :typing :ctx n: opNode :ind :buf
    }
    # a moving call can sit under the callable: `(f xs: a).not` calls `not`
    # on the value `f` moved `a` into
    callableNode: ast.nodes.get i: call.callable
    emitValueTakeInvalidations :ast :reg :typing :ctx n: callableNode :ind :buf
}

# emitValueTakeInvalidations -- statement-level source zeroing for a value node
# that reduces to a call: through expression, statementline and labelled
# wrappers, and through a dotted path's receiver, since `(f xs: a).not` moved
# `a` in the call under the dot, not in an argument of the outer one.
emitValueTakeInvalidations: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    buf: String.borrow
} is {
    match (
        n
    ) case statementline then {
        statementlineNode: ast.nodes.get i: n.statementline
        emitValueTakeInvalidations :ast :reg :typing :ctx n: statementlineNode :ind :buf
    } case call then {
        emitCallTakeInvalidations :ast :reg :typing :ctx call: n :ind :buf
    } case namedoperation then {
        operationNode: ast.nodes.get i: n.operation
        emitValueTakeInvalidations :ast :reg :typing :ctx n: operationNode :ind :buf
    } case dottedpath then {
        if n.parent.notZero then {
            parentNode: ast.nodes.get i: n.parent
            emitValueTakeInvalidations :ast :reg :typing :ctx n: parentNode :ind :buf
        }
    } else null
}

# needsAddM -- record that written C demands `memb` of unit `uname` in every
# configuration
needsAddM: function {ctx: Ctx uname: StringView memb: StringView} is {
    needsAddKey :ctx key: (ctx.demands.keyOf owner: uname name: memb)
}

# needsAddKey -- needsAddM by the demand's key
needsAddKey: function {ctx: Ctx key: zemitrows.demandkey} is {
    i: ctx.demands.at :key
    if i > 0 when (ctx.demands.always.get i: i - 1) then return
    if i > 0 then {
        needsAddKeyCond :ctx :key cond: condAlways
        return
    }
    ctx.demands.add :key always: true
    needsAddPullsOf :ctx :key cond: condAlways
}

# needsAddMCond -- needsAddM in the configurations `cond` holds in: a demand
# met in fewer than every one is written inside `#if` (Cond), and one met again
# under another condition holds under either
needsAddMCond: function {ctx: Ctx uname: StringView memb: StringView cond: Cond.view} is {
    needsAddKeyCond :ctx key: (ctx.demands.keyOf owner: uname name: memb) :cond
}

# needsAddKeyCond -- needsAddMCond by the demand's key
needsAddKeyCond: function {ctx: Ctx key: zemitrows.demandkey cond: Cond.view} is {
    i: ctx.demands.at :key
    if i == 0 then {
        ctx.demands.add :key always: cond.always
        if cond.always.not then {
            for each t: cond.terms loop {
                ctx.demands.termDemand.append ctx.demands.keys.length - 1
                ctx.demands.termMask.append t
            }
            ctx.condEpoch = ctx.condEpoch + 1
        }
    } else {
        if (ctx.demands.always.get i: i - 1) then return
        cur: demandCond :ctx at: i - 1
        if (condMerge dst: cur src: cond).not then return
        setDemandCond :ctx at: i - 1 c: cur
        ctx.condEpoch = ctx.condEpoch + 1
    }
    needsAddPullsOf :ctx :key :cond
}

# needsAddPullsOf -- the demands the rows answering demand `key` pull along with
# it (their `pulls`), under `cond`: the helpers another unit's C supplies to
# theirs. os.env builds a C string out of a StringView and os.cwd maps errno to
# an IoError: that C is io's, so the demand is io's. Recorded where the demand
# is met, rather than recomputed at emission by reading its unit's demands back
# -- which is what let io's runtime gate on a predicate no row could state.
needsAddPullsOf: function {ctx: Ctx key: zemitrows.demandkey cond: Cond.view} is {
    # copied out: each pulled demand writes the tables the rows are read from
    pl: String
    {
        pg: ctx.pullsByDemand.get :key
        if pg.some then {
            pl = pg.copy
        }
    }
    if pl.length > 0 then needsAddPullsIn :ctx pulls: pl.stringView :cond
}

# recordRowPulls -- the pulls of fragment row `row`, filed under each demand
# that fires it: a method's row answers its demand word
# (`file_pollReadable`), a helper its `@name`, not its key
recordRowPulls: function {ctx: Ctx row: u64 pulls: StringView} is {
    r: ctx.rows.rows.get i: row
    k: r.demandFrom
    for k < r.demandTo loop {
        key: ctx.rows.demandKeys.get i: k
        cur: String
        {
            got: ctx.pullsByDemand.get :key
            if got.some then {
                cur = got.copy
            }
        }
        if cur.length > 0 then cur.append ","
        cur.append pulls
        ctx.pullsByDemand.set :key value: cur.take
        k = k + 1
    }
}

# needsAddPullsIn -- each `<unit>.<member>` of a row's `pulls=` list, demanded
# under the condition of the member that pulls it
needsAddPullsIn: function {ctx: Ctx pulls: StringView cond: Cond.view} is {
    for each one: (pulls.split sep: ",") loop {
        # `<unit>.<member>?NAME`: pulled where the member is AND NAME holds
        if (one.contains needle: "?") then {
            rowNeedAddCond :ctx uname: "" need: one :cond
            continue
        }
        qd: one.indexOf needle: "."
        if qd.some then {
            (
                needsAddMCond
                :ctx
                uname: (one.substring from: 0 to: qd)
                memb: (one.substring from: qd + 1 to: one.length)
                :cond
            )
        }
    }
}

# preludeNeed -- record that written C calls the prelude piece `memb`
# (loadPieces): the piece is written only where something did.
preludeNeed: function {ctx: Ctx memb: StringView} is {
    needsAddM :ctx uname: "prelude" :memb
}

# typeUseAdd -- record that the program constructed this type.
typeUseAdd: function {ctx: Ctx tid: ztypes.tid} is {
    ctx.usedTypeIds.add item: tid
}

# typeStructEmitted -- this emitter wrote the type's struct, which is the
# reachability signal the implementation helpers need: they forward to the impl's
# methods, so emitting them for a type the program never reached names natives
# that were never loaded.
typeStructEmitted: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    return (ctx.emittedUserTypes.has item: tid)
}

# implementationRowMark / implementationRowEmitted -- an implementation row is one
# (impl, spec, label) triple and produces one set of wrappers, a vtable and the
# two create helpers. Emitted once, keyed by the row's confid.
implementationRowMark: function {ctx: Ctx row: ztypes.confid} is {
    ctx.emittedImplementation.add item: row
}

# whether an implementation's row is already out, so a second demand does not
# repeat it
implementationRowEmitted: function {ctx: Ctx.view row: ztypes.confid} out bool is {
    return (ctx.emittedImplementation.has item: row)
}

# listIterMark / listIterEmitted -- the cursor for one ListIter mono, keyed by
# that mono's tid. `List T` and `ListView T` resolve `iterate` to the SAME
# ListIter mono, so the second container to be emitted must not repeat the
# typedef and the `call` definition.
listIterMark: function {ctx: Ctx tid: ztypes.tid} is {
    ctx.emittedListIters.add item: tid
}

# whether that mono's cursor is already out, so a second container reaching it
# writes only its own constructors
listIterEmitted: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    return (ctx.emittedListIters.has item: tid)
}

# typeIsUsed -- the program constructed this type, so the rows its
# construction reaches have fired.
typeIsUsed: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    return (ctx.usedTypeIds.has item: tid)
}

# typeDemandMet -- may this type's body be emitted? A type no fragment row
# gates is unconditional; one that IS gated waits until written C spells it or
# constructs it, because its struct exists to be dereferenced by a fragment
# that is itself demand-loaded (typeRowDemanded). The gating set comes from
# the rows, not from a list here.
typeDemandMet: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    if (ctx.demandGatedTids.has item: tid).not then return true
    return (typeRowDemanded :ctx :tid)
}

# typeRowDemanded -- a `uses_<Type>` row's demand: written C spells or reaches
# the type (ctx.typeUses, ctx.reachedTypes), or constructs it.
typeRowDemanded: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    if (ctx.typeUses.has item: tid) or (ctx.reachedTypes.has item: tid) then return true
    return (typeIsUsed :ctx :tid)
}

# isStringyTid -- tid is canonical String or StringView.
isStringyTid: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    if tid == ctx.strTid then return true
    return tid == ctx.svTid
}

# unaliasedVid -- `vid`, the variable atom `nid` (spelled `name`) reads, when
# no alias stands in for it here; 0 when one does, since the base binding is
# then not what is being read and the substituted text is.
unaliasedVid: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    nid: zast.nodeid
    name: StringView
    vid: ztypes.vid
} out ztypes.vid is {
    if (aliasResolvesToSelfAt :reg :typing :ctx :nid :name :vid).not then return ztypes.vid
    return vid
}

# viewLaidNative -- member `mnId` read off a `tid` laid out as a StringView is
# the view native of the name: text's own members are methods instead
viewLaidNative: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
    mnId: zast.nameid
} out bool is {
    if (isViewLaid :ctx :tid).not then return false
    return (textOwnMember :reg :typing :ctx owner: tid nameId: mnId).not
}

# textOwnMember -- member `nameId` of `owner` is one of text's own: written in
# zerolang (stripPrefix, split, lines, ...) rather than a native, which text
# reads as StringView's of the name
textOwnMember: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    owner: ztypes.tid
    nameId: zast.nameid
} out bool is {
    if owner != ctx.textTid then return false
    md: typing.declMemberIdOf parentTypeId: owner :nameId
    if md.isZero then return false
    return (reg.isNativeOf tid: (typing.decls.get i: md).typeId).not
}

# textViewNativeByPtr -- member `mnId` read off variable `vid` is a view native
# on a text the C holds through a pointer (textHeldByPtr)
textViewNativeByPtr: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    vid: ztypes.vid
    mnId: zast.nameid
} out bool is {
    if (textHeldByPtr :reg :ctx :vid).not then return false
    return (viewLaidNative :reg :typing :ctx tid: ctx.textTid :mnId)
}

# textHeldByPtr -- variable `vid` is a text the C holds through a pointer: a
# `.view` parameter or a receiver, since text is a record. The view legs read a
# receiver as a StringView value and take its address themselves, so they are
# handed the pointee (a StringView is a class, passed as itself).
textHeldByPtr: function {reg: ztypes.ZTypeRegistry.view ctx: Ctx.view vid: ztypes.vid} out bool is {
    if (isPtrVid :ctx :vid).not then return false
    return (reg.variableTypeOf id: vid) == ctx.textTid
}

# isStringOrViewLaid -- tid is String, or laid out as a StringView (isViewLaid):
# a receiver the view natives take.
isStringOrViewLaid: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    return (isStringyTid :ctx :tid) or (isViewLaid :ctx :tid)
}

# readOnce -- `text`, which its caller spells more than once, as it may be
# spelled: bound to a temp first when reading it twice would repeat work (its
# facts say `once`). A place -- a load of a call's result, `(*get(..))`, or a
# member read off one -- is storage something else owns, so its temp owns
# nothing; a value's temp owns what the checker's temporary for `nid` owns.
readOnce: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    text: StringView
    textF: cfacts
    tid: ztypes.tid
    # the value's node, 0 for none
    nid: zast.nodeid
} out String is {
    if textF.once.not then return text.string
    if textF.place then return (
        hoistForAddress
        :ast
        :reg
        :typing
        :ctx
        av: text
        :tid
        argNid: zast.nodeid
    )
    return (hoistForAddress :ast :reg :typing :ctx av: text :tid argNid: nid)
}

# svValueForm -- a String/StringView operand as a by-value StringView C
# expression (a String operand view-converts via a compound literal). The
# literal reads a String operand twice, for its data and its size: a place that
# is not free to read twice -- a load of a call's result, `(*get(..))`, or a
# field read off one -- is bound to a temp first, which owns nothing, so the
# call runs once.
svValueForm: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    expr: StringView
    isStr: bool
    vid: ztypes.vid
    # holds `expr`'s facts when known, and is left holding the result's
    facts: cfacts.borrow
} out String is {
    if isStr then {
        # callers hand this a bare atom name, so resolve it: a borrowed element
        # get binds the name to a deref projection, and the raw name has no
        # declaration. The pointer question is asked of `vid`, not of that text
        # -- but only when no alias intervened, since an alias means the value
        # being read is the projection and not the binding.
        rf: cfacts
        rex: aliasResolveWith :ctx name: expr :vid facts: rf
        valueVid: vid
        if rex.stringView != expr then valueVid = ztypes.vid.zero
        # no entry: the operand as the caller handed it, with the caller's facts
        if rf.stated.not then stateFacts facts: rf from: facts
        if rf.stated.not then (
            emitFail
            :ctx
            what: "internal: svValueForm was handed no facts".string
            line: 0
        )
        if rf.once when rf.place then {
            rex = (
                readOnce
                :ast
                :reg
                :typing
                :ctx
                text: rex.stringView
                textF: rf
                tid: ctx.strTid
                nid: zast.nodeid
            )
            valueVid = ztypes.vid.zero
        }
        if (isPtrVid :ctx vid: valueVid) then return (
            stating
            :facts
            from: literalFacts
            text: (svValueFormPtr :ctx expr: rex.stringView)
        )
        svT: svTypeC :ctx
        v1: "((\{svT}){ .data = \{rex}.data, .size = \{rex}.size })"
        return (stating :facts from: literalFacts text: v1)
    } else {
        return (stating :facts from: facts text: expr.string)
    }
}

# svValueFormPtr -- svValueForm for a String operand the C holds through a
# POINTER: a borrowed String parameter, or a String read through a borrowed
# field.
svValueFormPtr: function {ctx: Ctx expr: StringView} out String is {
    svT: svTypeC :ctx
    v: "((\{svT}){ .data = \{expr}->data, .size = \{expr}->size })"
    return v
}

# svValueFormAt -- svValueForm asked of the operand's NODE rather than of a
# variable: a String read through a borrowed field (`c.s`) is a pointer with
# no variable behind it, which the vid question answers with `.`.
svValueFormAt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    expr: StringView
    isStr: bool
    vid: ztypes.vid
    # holds `expr`'s facts when known, and is left holding the result's
    facts: cfacts.borrow
} out String is {
    # a view is its own value form, as it stands
    if isStr.not then return (svValueForm :ast :reg :typing :ctx :expr :isStr :vid :facts)
    if (pathIsPointer :ast :reg :typing :ctx :n) then return (
        stating
        :facts
        from: literalFacts
        text: (svValueFormPtr :ctx :expr)
    )
    ef: facts
    if ef.stated.not then (
        emitFail
        :ctx
        what: "internal: svValueFormAt was handed no facts".string
        line: 0
    )
    # the view reads a String operand twice, for its data and its size: one that
    # is not an lvalue -- a call's result -- is bound to a temp first, so the
    # call runs once, and an owned result is released
    if ef.place.not then {
        hv: (
            hoistBorrowValArgWith
            :ast
            :reg
            :typing
            :ctx
            argNid: (zast.nodeIdOf :n)
            av: expr
            avF: ef
            pid: ctx.strTid
            paramTake: false
        )
        if hv.length > 0 then {
            stateFacts :facts from: pathFacts
            return (
                svValueForm
                :ast
                :reg
                :typing
                :ctx
                expr: hv.stringView
                :isStr
                vid: ztypes.vid
                :facts
            )
        }
    }
    # a place read once -- a load of a call's result, a reference control
    # value's `(*p)` -- svValueForm binds itself
    stateFacts :facts from: ef
    return (svValueForm :ast :reg :typing :ctx :expr :isStr :vid :facts)
}

# the base atom of a dotted path, which is the sanctioned discriminator the
# shadow guard allows
dottedBaseAtom: function {ast: Ast.view n: astnode.view} outx StringView is {
    match (
        n
    ) case dottedpath then {
        return (atomTextOf :ast n: (ast.nodes.get i: n.parent))
    } else {
        return ""
    }
}

# atomOrBaseText -- the atom's own text, or a dotted path's base atom's text:
# the two shapes a receiver or a `.take` source is spelt in ("" otherwise).
atomOrBaseText: function {ast: Ast.view n: astnode.view} outx StringView is {
    t: atomTextOf :ast :n
    if t.length > 0 then return t
    return (dottedBaseAtom :ast :n)
}

# aliasOrChild / aliasChildName -- the internal member name a dotted-path node
# resolved to through a public-interface alias (typecheck stamp keyed on the
# dotted-path nodeid), else the plain AST child text. Centralizes rename-aware
# member-name emission so a renamed member emits its internal (declared) C name.
aliasOrChild: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    aliasId: zast.nodeid
    childId: zast.nodeid
} outx StringView is {
    return (zast.nameTextAt :ast ref: (aliasOrChildId :ast :typing :aliasId :childId)).stringView
}

# the emitted (internal) name of a possibly-renamed member access.
aliasChildName: function {
    # the tree the member name is read from
    ast: Ast.view
    # the symbol table holding the rename stamps
    typing: ztyping.ZTyping.view
    # the dotted-path node
    n: astnode.view
} outx StringView is {
    match (
        n
    ) case dottedpath then {
        return (aliasOrChild :ast :typing aliasId: n.nodeid childId: n.child)
    } else {
        return ""
    }
}

# stmtFormNameId -- the statement form a DOTTED callee resolves to ("print",
# "panic", "error", "return"), else "". Those four are core aliases onto natives
# in `io` and `system`, and the dispatch below reads the ATOM, so a program that
# spelled one qualified reached the generic native path instead: `io.print`
# failed at emit for want of a fragment it does not have, and `system.panic`
# emitted the mono's own cname as a function. Asking the resolved declaration
# routes both spellings to one emitter, and is what keeps a user unit's own
# `print` out of it.
stmtFormNameId: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out zast.nameid is {
    # the child's name as an ID: this runs for every dotted callee in statement
    # position, and four compares against the four forms need no text at all
    cid: aliasChildNameId :ast :typing :n
    zid: zast.nameid
    if cid.isZero then return zid
    isSf: (
        (cid == zast.wellKnown.slot.wkPrint) or
        (cid == zast.wellKnown.slot.wkPanic) or
        (cid == zast.wellKnown.slot.wkError) or
        (cid == zast.wellKnown.slot.wkReturn)
    )
    if isSf.not then return zid
    # the unit the checker resolved the base to: a declaration spelled like
    # the unit, or a nested unit, is not it
    ud0x: baseFileUnitDecl :reg :typing baseId: (dottedParentNodeId :n)
    if ud0x.isZero then return zid
    fo: (
        ztypecheck.resolvedByIdsRo
        :ast
        :typing
        unitDecl: ud0x
        name: (aliasChildNameId :ast :typing :n)
    )
    if fo.some then {
        calleeTid: fo
        tt: reg.typetypeOf typeId: calleeTid
        if tt != ztypes.ztypetype.functionType then return zid
        if (reg.isNativeOf tid: calleeTid).not then return zid
        return cid
    }
    return zid
}

# aliasChildName's pool id: the internal (renamed) member id when a rename
# stamp exists, else the child atom's own name id.
aliasChildNameId: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out zast.nameid is {
    match (
        n
    ) case dottedpath then {
        return (aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child)
    } else {
        return zast.nameid.zero
    }
}

# clauseArmId -- the arm a match clause names: the internal arm a public
# alias resolved to (the checker stamps the clause), else the written one.
clauseArmId: function {
    typing: ztyping.ZTyping.view
    nid: zast.nodeid
    written: zast.nameid
} out zast.nameid is {
    ai: typing.aliasInternalIdOf nodeid: nid
    if ai.notZero then return ai
    return written
}

# aliasOrChildId -- aliasOrChild's id twin: the same answer as a pool id, for
# the sites that only need to know WHICH member this is.
aliasOrChildId: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    aliasId: zast.nodeid
    childId: zast.nodeid
} out zast.nameid is {
    if typing.renameSeen then {
        ai: typing.aliasInternalIdOf nodeid: aliasId
        if ai.notZero then return ai
    }
    return (zast.atomNameIdOf n: (ast.nodes.get i: childId))
}

# dottedParentNodeId -- the node a dotted path `n` reads its member of -- its
# BASE, the key the checker records a value read through the path under
# (dottedBaseTid), so the key a hoist of that value asks `tempOf` with. 0 when
# `n` is not a dotted path.
dottedParentNodeId: function {n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case dottedpath then {
        return n.parent
    } else {
        return zast.nodeid
    }
}

# the base node id of dotted-path node `n`.
dottedBaseNodeId: function {ast: Ast.view n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case dottedpath then {
        return (atomNodeId n: (ast.nodes.get i: n.parent))
    } else {
        return zast.nodeid
    }
}

# svNativeCall -- `<svC>_<m>(&recv, args)` for an sv-native method. `&` needs an
# LVALUE, and a receiver that is itself a CALL is not one: `a.trim.concat other:
# b` would spell `&z_t_trim(...)`. Such a receiver is read into its temp first,
# ahead of the arguments (orderAddressOf). A StringView owns nothing, so the
# temp frees nothing; a compound literal is already an lvalue and is spelled
# directly.
svNativeCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: StringView
    recv: StringView
    recvF: cfacts
    args: StringView
} out String is {
    pre: String
    addr: "&\{recv}"
    if (canTakeAddress f: recvF).not then {
        svT: svTypeC :ctx
        addr = (
            orderAddressOf
            :ast
            :reg
            :typing
            :ctx
            text: recv.string
            tf: recvF
            ctype: svT.stringView
            prefix: pre
        )
    }
    c: "\{ctx.svC}_\{m}(\{addr}\{args})"
    return (orderWrap prefix: pre call: c)
}

# svArgAddr -- the &-form of a StringView native argument (pooled
# literal or local view); "" when unsupported.
svArgAddr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    facts: cfacts.borrow
} out String is {
    match (
        n
    ) case atomstring then {
        li: litIndexOf :ctx nid: n.nodeid
        if li > 0 then {
            lv: litView :ctx :li
            a1: "&\{lv}"
            return a1
        } else {
            return "".string
        }
    } case atomid then {
        anSA: ast.names.texts.get i: n.name
        an: anSA.stringView
        # scalar args pass BY VALUE (only string-like args are pointer-
        # passed): a numeric literal has no address at all, and a stamped
        # scalar variable must not be &-wrapped either
        b0d: an.byteAt 0
        if b0d.some when b0d >= 48 when b0d <= 57 then return "".string
        if (
            ztypecheck.numKindOfTid
            :typing
            tid: (stampIdOf :typing nid: n.nodeid)
        ).has then return "".string
        # a bare name that names no VARIABLE is not a place. A zero-argument
        # function read in value position is one of these: it is a CALL, and
        # addressing it handed the native `&fn`, which the C has no object for.
        if (atomVid :typing nid: n.nodeid).isZero then return "".string
        # an ordinal pair is a C scalar, and passes like one
        if (
            isOrdinalVariant
            :typing
            tid: (stampIdOf :typing nid: n.nodeid)
        ) then return "".string
        # A String arg to a StringLike param projects to a by-value view.
        anV: atomVid :typing nid: n.nodeid
        anEF: cfacts
        anE: emitLocalAtomNameAt :ast :reg :typing :ctx nid: n.nodeid name: an vid: anV facts: anEF
        if (stampIsStr :typing :ctx nid: n.nodeid) then {
            svs: (
                svValueForm
                :ast
                :reg
                :typing
                :ctx
                expr: anE.stringView
                isStr: true
                vid: anV
                facts: anEF
            )
            return (stating :facts from: (addrFacts e: anEF) text: "&\{svs}")
        }
        return (stating :facts from: (addrFacts e: anEF) text: "&\{anE}")
    } case labelvalue then {
        anlC: ast.names.texts.get i: n.name
        anl: anlC.stringView
        if (
            ztypecheck.numKindOfTid
            :typing
            tid: (stampIdOf :typing nid: n.nodeid)
        ).has then return "".string
        # an ordinal pair is a C scalar, and passes like one
        if (
            isOrdinalVariant
            :typing
            tid: (stampIdOf :typing nid: n.nodeid)
        ) then return "".string
        anlV: atomVid :typing nid: n.nodeid
        anlEF: cfacts
        anlE: (
            emitLocalAtomNameAt
            :ast
            :reg
            :typing
            :ctx
            nid: n.nodeid
            name: anl
            vid: anlV
            facts: anlEF
        )
        if (stampIsStr :typing :ctx nid: n.nodeid) then {
            svl: (
                svValueForm
                :ast
                :reg
                :typing
                :ctx
                expr: anlE.stringView
                isStr: true
                vid: anlV
                facts: anlEF
            )
            return (stating :facts from: (addrFacts e: anlEF) text: "&\{svl}")
        }
        return (stating :facts from: (addrFacts e: anlEF) text: "&\{anlE}")
    } case dottedpath then {
        dpm: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        if (ztypecheck.isStringViewMember nameId: dpm) then {
            peF: cfacts
            pe: emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent) facts: peF
            pIsStr: stampIsStr :typing :ctx nid: (interpPartNodeId n: (ast.nodes.get i: n.parent))
            pev: (
                atomVidIfPlain
                :ast
                :reg
                :typing
                :ctx
                n: (ast.nodes.get i: n.parent)
                text: pe.stringView
            )
            sv: (
                svValueFormAt
                :ast
                :reg
                :typing
                :ctx
                n: (ast.nodes.get i: n.parent)
                expr: pe.stringView
                isStr: pIsStr
                vid: pev
                facts: peF
            )
            return (stating :facts from: (addrFacts e: peF) text: "&\{sv}")
        }
        return "".string
    } else {
        return "".string
    }
}

# emitSvCompareCall -- `a.compare b` on a stamped String/StringView base:
# the by-value cmp in the base fragment, both sides projected to a view.
emitSvCompareCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    bnv: StringView
    bnvF: cfacts
    mnId: zast.nameid
    btid: ztypes.tid
    btIsStr: bool
    dcbV: ztypes.vid
    facts: cfacts.borrow
} out String is {
    if (isStringyTid :ctx tid: btid) when mnId == zast.wellKnown.slot.wkCompare then {
        # compare maps to the by-value cmp in the base fragment
        argFacts: bnvF
        bf: svValueForm :ast :reg :typing :ctx expr: bnv isStr: btIsStr vid: dcbV facts: argFacts
        cargs: String
        for each caId: (zast.kidsOf :ast span: call.arguments) loop {
            ca: ast.nodes.get i: caId
            if ca.namedoperation then {
                argF: cfacts
                cae: (
                    emitExprWith
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: (ast.nodes.get i: ca.operation)
                    facts: argF
                )
                caIsStr: operandIsStr :reg :typing :ctx n: (ast.nodes.get i: ca.operation)
                cav: (
                    atomVidIfPlain
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: (ast.nodes.get i: ca.operation)
                    text: cae.stringView
                )
                caf: (
                    svValueFormAt
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: (ast.nodes.get i: ca.operation)
                    expr: cae.stringView
                    isStr: caIsStr
                    vid: cav
                    facts: argF
                )
                if cargs.length == 0 then cargs.append caf
            }
        }
        preludeNeed :ctx memb: "@StringView_cmp"
        ce: "\{ctx.svC}_cmp(\{bf}, \{cargs})"
        return (stating :facts from: callFacts text: ce)
    }
    return "".string
}

# emitSvSubstringCall -- `s.substring from: F to: T`. Declines (and falls to the
# arg-native leg) unless BOTH labels are present.
emitSvSubstringCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    bnv: StringView
    bnvF: cfacts
    mnId: zast.nameid
    btid: ztypes.tid
    btIsStr: bool
    dcbV: ztypes.vid
    facts: cfacts.borrow
} out String is {
    if mnId == zast.wellKnown.slot.wkSubstring then {
        recvp: String
        recvpF: bnvF
        if btid == ctx.svTid then {
            recvp = bnv.string
        } else {
            if btIsStr then {
                bfs: (
                    svValueForm
                    :ast
                    :reg
                    :typing
                    :ctx
                    expr: bnv
                    isStr: true
                    vid: dcbV
                    facts: recvpF
                )
                recvp = bfs.copy
            } else {
                recvpF = literalFacts
                sacc: ".".string
                if (isPtrVid :ctx vid: dcbV) then sacc = "->".string
                svT: svTypeC :ctx
                recvp = "((\{svT}){ .data = \{bnv}\{sacc}data, .size = \{bnv}\{sacc}len })"
            }
        }
        if recvp.length > 0 then {
            demandSvMember :reg :typing :ctx nameId: zast.wellKnown.slot.wkSubstring
            # a receiver that is a call is read into its temp first, as
            # svNativeCall reads it
            pre: String
            svT: svTypeC :ctx
            lead: (
                orderAddressOf
                :ast
                :reg
                :typing
                :ctx
                text: recvp
                tf: recvpF
                ctype: svT.stringView
                prefix: pre
            )
            svc: ctx.svC.copy
            esb: (
                emitOrderedPair
                :ast
                :reg
                :typing
                :ctx
                :call
                mono: ztypes.tid.zero
                cb: svc.stringView
                m: "substring"
                lead: lead.stringView
                a: zast.wellKnown.slot.wkFrom
                aForm: argform.labelled
                b: zast.wellKnown.slot.wkTo
                bForm: argform.labelled
            )
            return (stating :facts from: callFacts text: (orderWrap prefix: pre call: esb))
        }
    }
    return "".string
}

# svNativeArgFrag -- one argument of a view native, as the C text that passes it.
# An atom whose address can be taken passes as that address; a String-stamped
# expression projects to a view value and passes by address; anything else
# passes as the expression. `split` addresses its separator even in that last
# case, and that is the only thing `addrAlways` selects.
svNativeArgFrag: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    addrAlways: bool
    facts: cfacts.borrow
} out String is {
    sav: svArgAddr :ast :reg :typing :ctx :n :facts
    if sav.length > 0 then return sav
    sxF: cfacts
    sx: emitExprWith :ast :reg :typing :ctx :n facts: sxF
    stampTid: stampIdOf :typing nid: (interpPartNodeId :n)
    if stampTid == ctx.strTid then {
        sxh: (
            hoistBorrowValArgWith
            :ast
            :reg
            :typing
            :ctx
            argNid: (zast.nodeIdOf :n)
            av: sx.stringView
            avF: sxF
            pid: ctx.strTid
            paramTake: false
        )
        if sxh.length > 0 then {
            sx = sxh.take
            sxF = pathFacts
        }
        sxq: atomVidIfPlain :ast :reg :typing :ctx :n text: sx.stringView
        svx: svValueForm :ast :reg :typing :ctx expr: sx.stringView isStr: true vid: sxq facts: sxF
        return (stating :facts from: (addrFacts e: sxF) text: "&\{svx}")
    }
    if addrAlways then {
        return (stating :facts from: (addrFacts e: sxF) text: "&\{sx}")
    }
    # a VIEW-typed value reaching here is not a plain place -- a call's result,
    # a projection -- and these natives take their argument by pointer, so it
    # binds to a temp whose address the call can take. Passing it by value was
    # an argument of the wrong C type.
    if stampTid == ctx.svTid then {
        if sxF.place.not then {
            # the view owns nothing: the temp only gives it an address
            svb: (
                hoistForAddress
                :ast
                :reg
                :typing
                :ctx
                av: sx.stringView
                tid: ctx.svTid
                argNid: zast.nodeid
            )
            return (stating :facts from: (addrFacts e: pathFacts) text: "&\{svb}")
        }
        return (stating :facts from: (addrFacts e: sxF) text: "&\{sx}")
    }
    return (stating :facts from: sxF text: sx)
}


# viewRecvAddr -- the address a native view method takes its receiver by.
viewRecvAddr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    recv: StringView
    recvF: cfacts
    tid: ztypes.tid
} out String is {
    raF: cfacts
    return "&\{addressableText :ast :reg :typing :ctx e: recv eF: recvF :tid facts: raF}"
}

# emitSvSplitCall -- `s.split sep`, the separator passed by address.
emitSvSplitCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    bnv: StringView
    bnvF: cfacts
    mnId: zast.nameid
    btid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    if (isStringyTid :ctx tid: btid) when mnId == zast.wellKnown.slot.wkSplit then {
        needsAddM :ctx uname: "sviter" memb: "sv_split"
        sepx: String
        for each argId: (zast.kidsOf :ast span: call.arguments) loop {
            sa: ast.nodes.get i: argId
            if sa.namedoperation then {
                saOpNode: ast.nodes.get i: sa.operation
                if sepx.length == 0 then {
                    argFacts: cfacts
                    sfrag: (
                        svNativeArgFrag
                        :ast
                        :reg
                        :typing
                        :ctx
                        n: saOpNode
                        addrAlways: true
                        facts: argFacts
                    )
                    sepx.append sfrag
                }
            }
        }
        es: "\{ctx.svC}_split(\{(viewRecvAddr
            :ast
            :reg :typing
            :ctx
            recv: bnv
            recvF: bnvF
            tid: btid
        )}, \{sepx})"
        return (stating :facts from: callFacts text: es)
    }
    return "".string
}

# emitSvLinesCall -- `s.lines`, the no-argument view iterator.
emitSvLinesCall: function {
    ctx: Ctx
    bnv: StringView
    mnId: zast.nameid
    btid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    if (isStringyTid :ctx tid: btid) when mnId == zast.wellKnown.slot.wkLines then {
        needsAddM :ctx uname: "sviter" memb: "sv_lines"
        el: "\{ctx.svC}_lines(&\{bnv})"
        return (stating :facts from: callFacts text: el)
    }
    return "".string
}

# emitSvArgNativeCall -- the one-argument view natives (`startsWith`, `indexOf`,
# ...), plus `byteAt`, whose argument is an index and not a view.
emitSvArgNativeCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    bnv: StringView
    bnvF: cfacts
    mnv: StringView
    mnId: zast.nameid
    btid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    if (isStringyTid :ctx tid: btid) when (svCallOf :reg :typing :ctx nameId: mnId).arg then {
        demandSvMember :reg :typing :ctx nameId: mnId
        # the argument is built once, as the native takes it
        if mnId == zast.wellKnown.slot.wkByteAt then {
            barg: String
            for each baId: (zast.kidsOf :ast span: call.arguments) loop {
                ba: ast.nodes.get i: baId
                if ba.namedoperation when barg.length == 0 then {
                    bx: emitExpr :ast :reg :typing :ctx n: (ast.nodes.get i: ba.operation)
                    barg.append bx
                }
            }
            bargs: ", \{barg}"
            eb: (
                svNativeCall
                :ast
                :reg
                :typing
                :ctx
                m: "byteAt"
                recv: bnv
                recvF: bnvF
                args: bargs.stringView
            )
            return (stating :facts from: callFacts text: eb)
        }
        argx: String
        for each argId: (zast.kidsOf :ast span: call.arguments) loop {
            a: ast.nodes.get i: argId
            if a.namedoperation then {
                aOpNode: ast.nodes.get i: a.operation
                if argx.length == 0 then {
                    argFacts: cfacts
                    afrag: (
                        svNativeArgFrag
                        :ast
                        :reg
                        :typing
                        :ctx
                        n: aOpNode
                        addrAlways: false
                        facts: argFacts
                    )
                    argx.append afrag
                }
            }
        }
        aargs: ", \{argx}"
        ea: svNativeCall :ast :reg :typing :ctx m: mnv recv: bnv recvF: bnvF args: aargs.stringView
        return (stating :facts from: callFacts text: ea)
    }
    return "".string
}

# emitSvSimpleCall -- the remaining view natives on a String or StringView
# receiver: every argument that is a String projects to a view address.
emitSvSimpleCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    bnv: StringView
    bnvF: cfacts
    mnv: StringView
    mnId: zast.nameid
    btid: ztypes.tid
    btIsStr: bool
    dcbV: ztypes.vid
    facts: cfacts.borrow
} out String is {
    svRecvOk: (btid == ctx.svTid) or btIsStr
    if svRecvOk when (svCallOf :reg :typing :ctx nameId: mnId).simple then {
        demandSvMember :reg :typing :ctx nameId: mnId
        # a String receiver projects to a view value, like the
        # substring/parse legs (a StringView receiver is one already)
        recvS: bnv.string
        recvSF: bnvF
        if btIsStr then {
            baseForm: (
                svValueForm
                :ast
                :reg
                :typing
                :ctx
                expr: bnv
                isStr: true
                vid: dcbV
                facts: recvSF
            )
            recvS = baseForm.copy
        }
        args: String
        for each aId: (zast.kidsOf :ast span: call.arguments) loop {
            a: ast.nodes.get i: aId
            if a.namedoperation then {
                aOpNode: ast.nodes.get i: a.operation
                args.append ", "
                argFacts: cfacts
                cfrag: (
                    svNativeArgFrag
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: aOpNode
                    addrAlways: false
                    facts: argFacts
                )
                args.append cfrag
            }
        }
        e1: (
            svNativeCall
            :ast
            :reg
            :typing
            :ctx
            m: mnv
            recv: recvS.stringView
            recvF: recvSF
            args: args.stringView
        )
        return (stating :facts from: callFacts text: e1)
    }
    return "".string
}


# emitDottedCall -- a method call on a stamped String/StringView base:
# the simple native set emits {svC}_{member}(&base, &args...).
emitDottedCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    bn0: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable)
    # a base atom that names a FUNCTION auto-calls, and a string constant is its
    # static: either value is the receiver, emitted as an expression like any
    # other call base
    baseIsCall: false
    dcn: ast.nodes.get i: call.callable
    if dcn.dottedpath then {
        baseIsCall = baseAtomReadsAsValue :reg :typing n: (ast.nodes.get i: dcn.parent)
    }
    mn: aliasChildName :ast :typing n: (ast.nodes.get i: call.callable)
    mnId: aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable)
    btid: ztypes.tid
    dcbV: ztypes.vid
    # the receiver's C text: the expression's, or the base atom's local name
    bn: String
    bnF: cfacts
    if (bn0.length == 0) or baseIsCall then {
        # nested/projected base (`(x.y).stripPrefix`): no base atom, but
        # the base is a stamped String/StringView -- emit it as an expression (a
        # compound-literal lvalue, so the `&base` SV-native legs stay valid C).
        # a typedef over String or StringView (`Path`) is its base here: it
        # shares the base's struct and methods
        rsid: (
            chaseStrTypedef
            :typing
            :ctx
            tid: (dottedReceiverStampId :ast :typing callable: (ast.nodes.get i: call.callable))
        )
        if (isStringOrViewLaid :ctx tid: rsid) then {
            callableNode: ast.nodes.get i: call.callable
            bn = emitDottedReceiver :ast :reg :typing :ctx callable: callableNode facts: bnF
            btid = rsid
        } else {
            return "".string
        }
    } else {
        bnid: dottedBaseNodeId :ast n: (ast.nodes.get i: call.callable)
        btid = chaseStrTypedef :typing :ctx tid: (stampIdOf :typing nid: bnid)
        # the simple-atom receiver becomes its own identifier (the bn.length==0
        # leg already routes through emitDottedReceiver). An alias or narrowing
        # in scope substitutes for it, and then no variable is being read -- so
        # the pointer question below has nothing to ask about.
        baseVid: atomVid :typing nid: bnid
        bnA: aliasResolveAt :reg :typing :ctx nid: bnid name: bn0 vid: baseVid
        if bnA.stringView == bn0 then dcbV = atomVid :typing nid: bnid
        bn = emitLocalAtomNameAt :ast :reg :typing :ctx nid: bnid name: bn0 vid: baseVid facts: bnF
        if bnA.stringView == bn0 when (textHeldByPtr :reg :ctx vid: baseVid) then {
            bn = "(*\{bn})"
            bnF = derefFacts
        }
    }
    btIsStr: btid == ctx.strTid
    # the view legs read a String receiver more than once, for its data and its
    # size: one that is a call's result is bound once, and dropped again when no
    # leg takes the call
    rmark: pendingHoistMark :ctx
    if btIsStr when dcbV.isZero when bnF.place.not then {
        bn = (
            receiverOnce
            :ast
            :reg
            :typing
            :ctx
            callable: (ast.nodes.get i: call.callable)
            text: bn.stringView
            textF: bnF
            tid: btid
        )
    }
    sv: (
        emitSvCallLegs
        :ast
        :reg
        :typing
        :ctx
        :call
        bnv: bn.stringView
        bnvF: bnF
        mnv: mn
        :mnId
        :btid
        :btIsStr
        :dcbV
        :facts
    )
    if sv.length == 0 then dropHoistsTo :ctx mark: rmark
    return sv
}

# emitSvCallLegs -- the view-native legs of a method call on a String,
# StringView or text receiver, tried in turn; "" when none takes it.
emitSvCallLegs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    # the receiver's C text
    bnv: StringView
    bnvF: cfacts
    mnv: StringView
    mnId: zast.nameid
    btid: ztypes.tid
    btIsStr: bool
    dcbV: ztypes.vid
    facts: cfacts.borrow
} out String is {
    # text is laid out as a StringView, and its view members are StringView's
    if btid == ctx.textTid then btid = ctx.svTid
    eCmp: (
        emitSvCompareCall
        :ast
        :reg
        :typing
        :ctx
        :call
        :bnv
        :bnvF
        :mnId
        :btid
        :btIsStr
        :dcbV
        :facts
    )
    if eCmp.length > 0 then return eCmp
    eSub: (
        emitSvSubstringCall
        :ast
        :reg
        :typing
        :ctx
        :call
        :bnv
        :bnvF
        :mnId
        :btid
        :btIsStr
        :dcbV
        :facts
    )
    if eSub.length > 0 then return eSub
    eSpl: emitSvSplitCall :ast :reg :typing :ctx :call :bnv :bnvF :mnId :btid :facts
    if eSpl.length > 0 then return eSpl
    eLin: emitSvLinesCall :ctx :bnv :mnId :btid :facts
    if eLin.length > 0 then return eLin
    eArg: emitSvArgNativeCall :ast :reg :typing :ctx :call :bnv :bnvF :mnv :mnId :btid :facts
    if eArg.length > 0 then return eArg
    return (
        emitSvSimpleCall
        :ast
        :reg
        :typing
        :ctx
        :call
        :bnv
        :bnvF
        :mnv
        :mnId
        :btid
        :btIsStr
        :dcbV
        :facts
    )
}

# argumentsAreCreates -- a construction's arguments are its `create`'s rather than
# its type's: after a parenthesised type application, and in an explicit
# `T.create`.
argumentsAreCreates: function {
    ast: Ast.view typing: ztyping.ZTyping.view callable: astnode.view
} out bool is {
    if callable.call then return true
    match (
        callable
    ) case dottedpath then {
        return (
            (aliasOrChildId :ast :typing aliasId: callable.nodeid childId: callable.child) ==
            zast.wellKnown.slot.wkCreate
        )
    } else {
        return false
    }
}

# listCapArg -- the capacity: argument of a container construction value, or
# "0" when absent. After a parenthesised type, and in an explicit `T.create`, the
# arguments are `create`'s, whose first parameter is `capacity`, so the call's
# one unlabelled argument -- which binds the first declared parameter -- is the
# capacity as much as a labelled one is. In a bare type application the
# unlabelled argument is the type's.
listCapArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out String is {
    match (
        n
    ) case call then {
        afterType: argumentsAreCreates :ast :typing callable: (ast.nodes.get i: n.callable)
        i: u64
        for i < n.arguments.count loop {
            aId: zast.kidAt kids: ast.kids span: n.arguments :i
            a: ast.nodes.get i: aId
            if a.namedoperation then {
                an: zast.nameTextAt :ast ref: a.name
                isCap: a.name == zast.wellKnown.slot.wkCapacity
                if afterType when i == 0 when an.length == 0 then isCap = true
                if isCap then return (
                    emitExpr
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: (ast.nodes.get i: a.operation)
                )
            }
            i = i + 1
        }
        return "0".string
    } else {
        return "0".string
    }
}

# emitDottedReceiver -- the C expression for the receiver of a dotted method
# call (call.callable = recv.method). Uses emitExpr on the base node so a nested
# receiver (this.field.method, obj.a.b.method) works, not just a bare atom. ""
# when the callable is not a dotted path.
emitDottedReceiver: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    callable: astnode.view
    facts: cfacts.borrow
} out String is {
    match (
        callable
    ) case dottedpath then {
        return (emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: callable.parent) :facts)
    } else {
        return "".string
    }
}

# dottedReceiverStampId -- the stamped type id of a dotted method call's
# receiver (the base node, via interpPartNodeId which handles a nested dottedpath base).
# 0 when not a dotted path.
dottedReceiverStampId: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    callable: astnode.view
} out ztypes.tid is {
    match (
        callable
    ) case dottedpath then {
        return (stampIdOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: callable.parent)))
    } else {
        return ztypes.tid.zero
    }
}

# dottedReceiverIsPtr -- true when a dotted method call's receiver is already
# the C pointer a receiver takes (argAlreadyPointer), so the call passes it
# directly rather than taking its address.
dottedReceiverIsPtr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    callable: astnode.view
} out bool is {
    match (
        callable
    ) case dottedpath then {
        return (receiverNodeIsPtr :ast :reg :typing :ctx n: (ast.nodes.get i: callable.parent))
    } else {
        return false
    }
}

# receiverNodeIsPtr -- argAlreadyPointer for a receiver known by its node
receiverNodeIsPtr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out bool is {
    return (
        argAlreadyPointer
        :ast
        :reg
        :typing
        :ctx
        :n
        vid: (atomVid :typing nid: (valueAtomNid :n))
    )
}

# emitNativeArgMethod -- a native method that takes ARGUMENTS, emitted from its
# own row. The receiver-only rows reach `emitNumericCast`, which
# binds one hole and knows nothing of arguments; the operator rows reach
# `emitOperatorAt`, which binds two and is spelled for an operator. A row that
# names an argument hole had no way in at all, and every bodied row on a scalar
# was a conversion, `bits` or `not` because of it.
#
# @V@ is the receiver and @A1@, @A2@, ... the arguments -- 1-BASED WITH THE
# RECEIVER EXCLUDED, the same numbering `const=` uses, so one convention
# answers for both. A hole is named by its parameter's DECLARED position:
# argSlotList maps the labels the way every other call form does. The receiver
# and then the arguments are evaluated in the order they are written, ahead of
# the body, which may spell a hole anywhere.
#
# The row is the authority. Nothing here compares a member name, so a native
# gaining an argument is a declaration and a row, as it should be.
emitNativeArgMethod: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    ownerTid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    if call.arguments.count.u64 == 0 then return "".string
    # the member name decides whether to look at all, and it is read through a
    # BORROWED view: an owned copy here is one allocation per call in the
    # program, paid to discover that almost none of them are this
    mnId: aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable)
    if (ctx.rows.memberBodies.has item: mnId).not then return "".string
    # a str instance's members are declared on its template
    srcT: ownerTid
    if (originIsTid :reg tid: ownerTid originTid: (ctx.origins.get i: family.slot.str)) then {
        srcT = originTidOf :reg tid: ownerTid
    }
    rowKey: rowNameOfMember :reg :typing :ctx owner: srcT name: mnId
    row: ctx.rows.ofName n: rowKey
    if row == 0 then return "".string
    body: rowBody :ctx :row
    if body.isZero then return "".string
    if (rtHas :ctx id: body slot: rtHole.slot.holeA1).not then return "".string
    rowNeedsAdd :ctx :row cond: condAlways
    key: rowLabel :ctx :ast n: rowKey
    mk: pendingHoistMark :ctx
    recvF: cfacts
    recv: (
        emitDottedReceiver
        :ast
        :reg
        :typing
        :ctx
        callable: (ast.nodes.get i: call.callable)
        facts: recvF
    )
    if recv.length == 0 then return "".string
    if (dottedReceiverIsPtr :ast :reg :typing :ctx callable: (ast.nodes.get i: call.callable)
    ) then {
        rd: "(*\{recv})"
        recv = rd.copy
        recvF = operandFacts e: recvF place: true
    }
    mtid: (
        (typing.declChildOfId parentTypeId: ownerTid nameId: mnId).or
        d: ztypes.tid.zero
    )
    if mtid.isZero then return "".string
    pNames: List String
    pIds: ListVal ztypes.tid
    pNameIds: ListVal zast.nameid
    recFieldLists :ast :reg :typing tid: mtid names: pNames ids: pIds nameIds: pNameIds
    if pNames.length < 2 then return "".string
    # the receiver is evaluated first, then the arguments as written
    ord: orderBegin :ctx slots: pNames.length
    orderNamesTwiceArgs :ctx st: ord :body count: pNames.length firstHole: 0
    recvNid: dottedParentNodeId n: (ast.nodes.get i: call.callable)
    (
        orderArgAtWith
        :ast
        :reg
        :typing
        :ctx
        st: ord
        mark: mk
        text: recv
        tf: recvF
        nid: recvNid
        byPtr: true
        slot: 0
        valueNid: recvNid
    )
    orderNativeArgs :ast :reg :typing :ctx :call fpNameIds: pNameIds :ord
    oprefix: orderFinish :ctx st: ord
    rn: ListVal zast.nameid
    rv: List String
    filledAll: nativeHoleValues t: ctx st: ord count: pNames.length firstHole: 0 names: rn vals: rv
    orderEnd :ctx st: ord
    # a slot no argument fills leaves the caller on its ordinary path rather than
    # emitting a body with a hole still in it
    if filledAll.not then return "".string
    filled: (
        nativeBodyFill
        :ast
        :reg
        :typing
        :ctx
        :call
        :body
        key: key.stringView
        argIds: rn
        argVals: rv
    )
    # a call's facts even for a value row: the arguments' own are not kept
    # here, and call facts cost at most a temp
    return (stating :facts from: callFacts text: (orderWrap prefix: oprefix call: filled))
}

# nativeBodyFill -- a native row's body `body` (keyed `key`) filled for `call`:
# the operand holes from `argIds`/`argVals`, a record built by the row as @RT@
# (the call's own type) and text's view type as @StringView@. One fill for a
# method's row and a free function's.
nativeBodyFill: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    body: rtid
    key: StringView
    argIds: ListVal zast.nameid
    argVals: List String
} out String is {
    bn: ListVal zast.nameid
    bv: List String
    if (rtHas :ctx id: body slot: rtHole.slot.holeRT) then {
        bn.append (rtHoleId slot: rtHole.slot.holeRT)
        bv.append from: (
            spelledCname
            :ctx
            tid: (
                chaseAggregateTypedef
                :reg
                :typing
                :ctx
                tid: (stampIdOf :typing nid: call.nodeid)
            )
        )
    }
    if (rtHas :ctx id: body slot: rtHole.slot.holeStringView) then {
        bn.append (rtHoleId slot: rtHole.slot.holeStringView)
        preludeNeed :ctx memb: "@StringView_t"
        bv.append from: ctx.svC.copy
    }
    return (
        rtFillForCtx
        :ast
        :reg
        :typing
        :ctx
        id: body
        path: key
        bindIds: bn
        bindVals: bv
        rawIds: argIds
        rawVals: argVals
    )
}

# nativeHoleValues -- the holes of the slots of the call `st` opened and the
# texts that fill them: slot i fills hole `firstHole + i`, where hole 0 is @V@
# (a method's receiver) and hole k is @Ak@; false when a slot is empty.
nativeHoleValues: function {
    t: Ctx.view
    st: orderstate
    count: u64
    firstHole: u64
    names: ListVal zast.nameid
    vals: List String
} out bool is {
    filledAll: true
    hi: u64
    for hi < count loop {
        hv: orderSlotText :t :st slot: hi
        if hv.length == 0 then filledAll = false
        names.append (rtArgHole ctx: t hi: firstHole + hi)
        vals.append hv.string
        hi = hi + 1
    }
    return filledAll
}

# orderNativeArgs -- a native row's arguments, built in the order they are
# written into the slots of the parameters they bind. The receiver is the first
# parameter, so a parameter's slot index IS its hole number: slot 1 fills @A1@.
orderNativeArgs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    fpNameIds: (ListVal zast.nameid).view
    ord: orderstate.borrow
} is {
    # the dot supplies the receiver, so the arguments bind the parameters
    # after it: an unlabelled one takes the first of those still free, not the
    # receiver's slot
    rest: ListVal zast.nameid
    ri: 1.u64
    for ri < fpNameIds.length loop {
        rest.append (fpNameIds.get i: ri)
        ri = ri + 1
    }
    slots: argSlotList :ast :call fpNameIds: rest
    ai: u64
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation then {
            slot: (slots.get i: ai) + 1
            if slot < fpNameIds.length then {
                mk: pendingHoistMark :ctx
                avF: cfacts
                av: valueExprC :ast :reg :typing :ctx n: (ast.nodes.get i: a.operation) facts: avF
                (
                    orderArgAtWith
                    :ast
                    :reg
                    :typing
                    :ctx
                    st: ord
                    mark: mk
                    text: av
                    tf: avF
                    nid: a.operation
                    byPtr: false
                    :slot
                    valueNid: a.operation
                )
            }
        }
        ai = ai + 1
    }
}

# emitStringArgMethod -- a String mutating method WITH an arg (appendByte /
# reserve): emit \{ctx.strC}_<native>(&recv, arg). The native cname is
# snake_case (append_byte). "" when the receiver is not a String or the method
# is not one of these. String is a value-native, so the cname is always ctx.strC.
emitStringArgMethod: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    mnId: aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable)
    nativeM: String
    if mnId == zast.wellKnown.slot.wkAppendByte then nativeM = "append_byte".string
    if mnId == zast.wellKnown.slot.wkReserve then nativeM = "reserve".string
    if mnId == zast.wellKnown.slot.wkAppend then nativeM = "append".string
    if nativeM.length == 0 then return "".string
    callableNode: ast.nodes.get i: call.callable
    recvF: cfacts
    recvExpr: emitDottedReceiver :ast :reg :typing :ctx callable: callableNode facts: recvF
    if recvExpr.length == 0 then return "".string
    recvTid: dottedReceiverStampId :ast :typing callable: (ast.nodes.get i: call.callable)
    rtid: chaseAggregateTypedef :reg :typing :ctx tid: recvTid
    rtid = chaseStrTypedef :typing :ctx tid: rtid
    if rtid != ctx.strTid then return "".string
    rptr: dottedReceiverIsPtr :ast :reg :typing :ctx callable: (ast.nodes.get i: call.callable)
    recvAddr: "&\{recvExpr}"
    if rptr then recvAddr = "\{recvExpr}"
    argval: String
    argvalF: cfacts
    argTid: ztypes.tid
    argPtr: false
    # the argument's node, 0 until the loop finds it
    argNode: zast.nodeid
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation when argval.length == 0 then {
            # an interpolated-literal arg builds a multi-statement String:
            # hoist it to an _ah temp (freed at the statement flush, the
            # receiver only borrows), exactly like collection/user-fn args
            iv: (
                emitColInterpArg
                :ast
                :reg
                :typing
                :ctx
                n: (ast.nodes.get i: a.operation)
                consumes: false
            )
            if iv.length > 0 then {
                argval = iv.take
                argvalF = pathFacts
                argTid = ctx.strTid
            } else {
                av: (
                    emitExprWith
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: (ast.nodes.get i: a.operation)
                    facts: argvalF
                )
                argval = av.take
                argNode = a.operation
                argOpNode: ast.nodes.get i: a.operation
                argTid = stampIdOf :typing nid: (interpPartNodeId n: argOpNode)
                argPtr = pathIsPointer :ast :reg :typing :ctx n: argOpNode
            }
        }
    }
    if mnId == zast.wellKnown.slot.wkAppend then {
        # The StringLike arg lowers to (data, length) by its concrete type:
        # an owned String reads .data/.size (through the pointer for a
        # borrowed param); a StringView reads .data/.length.
        if argTid == ctx.strTid then {
            aph: (
                hoistBorrowValArgWith
                :ast
                :reg
                :typing
                :ctx
                av: argval.stringView
                avF: argvalF
                pid: ctx.strTid
                paramTake: false
                argNid: argNode
            )
            if aph.length > 0 then {
                argval = aph.take
            } else if argPtr.not when argvalF.once when argvalF.place then {
                # a load of a call's result is read for its data and its size:
                # bound once, into a temp that owns nothing
                argval = (
                    readOnce
                    :ast
                    :reg
                    :typing
                    :ctx
                    text: argval.stringView
                    textF: argvalF
                    tid: ctx.strTid
                    nid: zast.nodeid
                )
            }
            aacc: "."
            if argPtr then aacc = "->"
            preludeNeed :ctx memb: "@String_append"
            rapps: "\{ctx.strC}_append(\{recvAddr}, (\{argval})\{aacc}data, (\{argval})\{aacc}size)"
            return (stating :facts from: callFacts text: rapps)
        }
        return (
            stringAppendViewText
            :ast
            :reg
            :typing
            :ctx
            recvAddr: recvAddr.stringView
            argval: argval.stringView
            :argvalF
            :argTid
            :facts
        )
    }
    # append_byte and reserve are pieces of the String fragment
    pm: "@String_\{nativeM}"
    preludeNeed :ctx memb: pm.stringView
    r: "\{ctx.strC}_\{nativeM}(\{recvAddr}, \{argval})"
    return (stating :facts from: callFacts text: r)
}

# cfacts -- what the producer of an expression's C text knows about it, so a
# reader decides from facts rather than from the text's shape. A producer
# states them into its caller's slot (`facts: cfacts.borrow`) as it returns.
# Every producer states them; an expression emitted with none stated is an
# internal error (emitExprWith), never a guess from the text. Beside a text `x`,
# `xF` holds its facts.
cfacts: record {
    # `&` may be taken of it as it stands: a name, a field path, a deref
    place: false
    # a compound literal `((T){..})`: an lvalue as well, which place does not
    # yet say
    literal: false
    # reading it twice would repeat work or effects: it is bound to a temp
    # before a reader spells it twice
    once: false
    # evaluating it only reads: no call, no write, no statement expression
    pure: false
    # a plain place path: a name and `.` / `->` member reads off it, reading
    # nothing through a pointer a call could replace
    path: false
    # the address of a plain place path, `&p`: nothing evaluated around it can
    # move it
    fixedAddr: false
    # a constant: a number, a cast of one, a macro, a tag -- nothing evaluated
    constant: false
    # the expression could not be spelled: the text is a marker, and the failure
    # was reported where the marker was made
    failed: false
    # the facts were filled in; a fresh slot holds none, and no reader acts on
    # a slot nobody filled
    stated: false
}

# pathFacts -- a plain place path: an identifier, and `.` / `->` member reads off
# it. A place that only reads, read twice at no cost. A function's name is one
# too: a designator, fixed.
pathFacts: function {} out cfacts is {
    return (cfacts place: true literal: false once: false pure: true path: true stated: true)
}

# literalFacts -- a compound literal `((T){ .. })`: an lvalue, though no name, and
# nothing to repeat when read twice. Not counted pure: the evaluation-order scan
# has always kept a temp for one.
literalFacts: function {} out cfacts is {
    return (cfacts place: false literal: true once: false pure: false path: false stated: true)
}

# callFacts -- a call's result: a value, no storage, and work (and effects) a
# second spelling would repeat.
callFacts: function {} out cfacts is {
    return (cfacts place: false literal: false once: true pure: false path: false stated: true)
}

# derefFacts -- a pointer read through, `(*p)`: a place, read twice at no cost,
# and no path: what it reads sits behind a pointer.
derefFacts: function {} out cfacts is {
    return (cfacts place: true literal: false once: false pure: true path: false stated: true)
}


# operandFacts -- a text computed from one operand whose facts are `e`,
# evaluated exactly as the operand is, and no path: a load `(*e)` is a place,
# read twice at no cost exactly when `e` is; a value computed from an operand --
# a comparison, a negation, an arm test -- is not a place.
operandFacts: function {e: cfacts place: bool} out cfacts is {
    return (cfacts :place literal: false once: e.once pure: e.pure path: false stated: true)
}

# valueFacts -- a value computed from two operands whose facts are `a` and `b`,
# by a value row (`form: c.form.value`): no storage, evaluated exactly as the
# operands are -- repeated work where either repeats it, only reading where
# both only read.
valueFacts: function {a: cfacts b: cfacts} out cfacts is {
    return (
        cfacts
        place: false
        literal: false
        once: a.once or b.once
        pure: a.pure and b.pure
        path: false
        stated: true
    )
}

# memberFacts -- `base.f` or `base->f`, read off a base whose facts are `b`: a
# place wherever the base is one or is a compound literal, and a path, pure or
# repeated work exactly as the base is.
memberFacts: function {b: cfacts} out cfacts is {
    return (
        cfacts
        place: b.place or b.literal
        literal: false
        once: b.once
        pure: b.pure
        path: b.path
        stated: true
    )
}

# stateFacts -- fill the caller's slot. A slot is a reference parameter, written
# through its fields, never replaced whole.
stateFacts: function {facts: cfacts.borrow from: cfacts} is {
    facts.place = from.place
    facts.literal = from.literal
    facts.once = from.once
    facts.pure = from.pure
    facts.path = from.path
    facts.fixedAddr = from.fixedAddr
    facts.constant = from.constant
    facts.failed = from.failed
    facts.stated = from.stated
}

# constFacts -- a constant's value: a number, a cast of one, a macro, a tag. No
# storage, nothing evaluated, nothing repeated when read twice.
constFacts: function {} out cfacts is {
    return (
        cfacts
        place: false
        literal: false
        once: false
        pure: true
        path: false
        constant: true
        stated: true
    )
}

# failedFacts -- an expression the emitter could not spell: its marker, a
# constant 0 behind a comment, with the failure recorded where it was made.
failedFacts: function {} out cfacts is {
    return (
        cfacts
        place: false
        literal: false
        once: false
        pure: true
        path: false
        constant: true
        failed: true
        stated: true
    )
}

# addrFacts -- `&e`, the address of an operand whose facts are `e`: a value, no
# place, evaluated exactly as the operand is, and fixed when the operand is a
# path.
addrFacts: function {e: cfacts} out cfacts is {
    return (
        cfacts
        place: false
        literal: false
        once: e.once
        pure: e.pure
        path: false
        fixedAddr: e.path
        stated: true
    )
}

# stating -- `text`, with its facts stated into the caller's slot: a producer's
# return in one line. Nothing ("") -- a probe that declines -- states nothing,
# so the slot never holds facts for text its caller did not take.
stating: function {facts: cfacts.borrow from: cfacts text: String.take} out String is {
    if text.length > 0 then stateFacts :facts :from
    return text
}

# canTakeAddress -- whether `&` applies to the text as it stands: a place, or a
# compound literal, which is an lvalue too.
canTakeAddress: function {f: cfacts} out bool is {
    return f.place or f.literal
}

# addressableText -- `e` as text `&` applies to: itself when it is a place or a
# compound literal, otherwise a statement temporary it is bound to, since C
# takes no address of a call (`&f(x)`). The temporary frees nothing: a value
# that owns its storage is bound where it is made (ownedReceiverHoist), so what
# arrives here is a view or a borrow.
addressableText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    e: StringView
    eF: cfacts
    tid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    if (canTakeAddress f: eF) then return (stating :facts from: eF text: e.string)
    t: hoistForAddress :ast :reg :typing :ctx av: e :tid argNid: zast.nodeid
    return (stating :facts from: pathFacts text: t)
}

# stringAppendViewText -- `recv.append arg` for an argument that is not an owned
# String: a StringView, read twice for its data and its size, so a call is bound
# to a temp the statement flush declares and runs once.
stringAppendViewText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    recvAddr: StringView
    argval: StringView
    argvalF: cfacts
    argTid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    if argTid == ctx.svTid when argvalF.once then {
        # a view read twice is bound once, and frees nothing
        ah: hoistForAddress :ast :reg :typing :ctx av: argval tid: argTid argNid: zast.nodeid
        preludeNeed :ctx memb: "@String_append"
        rh: "\{ctx.strC}_append(\{recvAddr}, (\{ah}).data, (\{ah}).size)"
        return (stating :facts from: callFacts text: rh)
    }
    preludeNeed :ctx memb: "@String_append"
    r: "\{ctx.strC}_append(\{recvAddr}, (\{argval}).data, (\{argval}).size)"
    return (stating :facts from: callFacts text: r)
}

# orderstate -- where one call's parts began in the evaluation-order lists,
# whether a part that is not constant has been seen, and where the parts still
# waiting to learn whether they need a temp begin.
orderstate: record {
    pieceMark: u64
    # where the call's slots begin in orderVals
    valBase: u64
    live: bool
    # where the call's waiting parts begin in the orderPend lists
    pendMark: u64
    # the slots whose hole the row's body names more than once, a bit per
    # slot (orderNamesTwice)
    twice: u64
}

# orderBegin -- a call's parts are about to be built, in written order, into
# `slots` empty argument slots.
orderBegin: function {ctx: Ctx slots: u64} out orderstate is {
    base: ctx.orderVals.length
    for ctx.orderVals.length < (base + slots) loop ctx.orderVals.append String
    for ctx.orderValFacts.length < (base + slots) loop ctx.orderValFacts.append cfacts
    return (
        orderstate
        pieceMark: ctx.orderPieces.length
        valBase: base
        live: false
        pendMark: ctx.orderPends.length
        twice: 0
    )
}

# orderNamesTwice -- the row the call `st` opened names the hole of slot `slot`
# more than once: the part that fills it is read once, into its temp, unless
# reading it twice costs nothing (orderPartWith).
orderNamesTwice: function {st: orderstate.borrow slot: u64} is {
    if slot < 64 then st.twice = st.twice | (1.u64 << slot)
}

# rtArgHole -- the hole an argument row's slot `hi` fills: @V@ for slot 0, @A1@
# for slot 1, and so on; zero when no row spells it
rtArgHole: function {ctx: Ctx.view hi: u64} out zast.nameid is {
    if hi == 0 then return (rtHoleId slot: rtHole.slot.holeV)
    an: "A\{hi}"
    return (ctx.rt.holeNamed name: an.stringView)
}

# orderNamesTwiceArgs -- orderNamesTwice for each of an argument row's `count`
# slots that `body` names more than once: slot i fills hole `firstHole + i`
# (nativeHoleValues), so a method's @V@ fills slot 0, @A1@ slot 1, and a free
# function's @A1@ slot 0.
orderNamesTwiceArgs: function {
    ctx: Ctx.view st: orderstate.borrow body: rtid count: u64 firstHole: u64
} is {
    i: u64
    for i < count loop {
        if (rtTwice :ctx id: body hole: (rtArgHole :ctx hi: firstHole + i)) then (
            orderNamesTwice
            :st
            slot: i
        )
        i = i + 1
    }
}

# orderOnePart -- `text`, whose facts are `tf` and whose value is node `nid`,
# placed in evaluation order as the one part of C that reads it, more than
# once when `twice`: it is read into its temp, typed `ctype` (or from `nid`
# where that is ""), unless it is `constant` or reading it twice costs
# nothing. `mark` is where the pending hoists stood before `text` was built.
# The answer is the text the reader spells; `prefix` is left holding the
# opening of the comma expression that reads it into its temp (orderFinish),
# "" when it is read in place.
orderOnePart: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    text: String.take
    ctype: StringView
    prefix: String.borrow
    # where the pending hoists stood before `text` was built
    mark: hoistmark
    # unstated facts read the part into its temp
    tf: cfacts
    nid: zast.nodeid.zero
    constant: false
    twice: true
} out String is {
    ord: orderBegin :ctx slots: 1
    if twice then orderNamesTwice st: ord slot: 0
    (
        orderPartWith
        :ast
        :reg
        :typing
        :ctx
        st: ord
        :mark
        :text
        :tf
        :constant
        fid: ztypes.tid
        pid: ztypes.tid.zero
        pname: zast.nameid
        :ctype
        slot: 0
        valueNid: nid
    )
    prefix.append (orderFinish :ctx st: ord)
    spelled: (orderSlotText t: ctx st: ord slot: 0).string
    orderEnd :ctx st: ord
    return spelled
}

# orderAddressOf -- the address of `text`, whose facts are `tf`: `&text` when
# `&` applies to it as it stands, otherwise the address of the temp, typed
# `ctype`, it is read into in evaluation order. `prefix` is left holding that
# read's opening (orderOnePart), "" when there is none.
orderAddressOf: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    text: String.take
    tf: cfacts
    ctype: StringView
    prefix: String.borrow
} out String is {
    if (canTakeAddress f: tf) then return "&\{text}"
    # a value with no storage is read into its temp however cheap it is
    partF: tf
    partF.once = true
    t: (
        orderOnePart
        :ast
        :reg
        :typing
        :ctx
        mark: (pendingHoistMark :ctx)
        :text
        tf: partF
        nid: zast.nodeid
        :ctype
        constant: false
        twice: true
        :prefix
    )
    return "&\{t}"
}

# orderSlotTwice -- whether the row the call `st` opened names the hole of slot
# `slot` more than once.
orderSlotTwice: function {st: orderstate.view slot: u64} out bool is {
    if slot >= 64 then return false
    return (st.twice & (1.u64 << slot)) != 0
}

# orderEnd -- a call's argument slots are read: release them.
orderEnd: function {ctx: Ctx st: orderstate} is {
    for ctx.orderVals.length > st.valBase loop ctx.orderVals.pop
    for ctx.orderValFacts.length > st.valBase loop ctx.orderValFacts.pop
}

# orderSlotText -- the argument text in slot `slot` of the call `st` opened, ""
# when no argument fills it.
orderSlotText: function {t: Ctx.view st: orderstate slot: u64} outx StringView is {
    if (st.valBase + slot) >= t.orderVals.length then return ""
    got: t.orderVals.get i: st.valBase + slot
    return got.stringView
}

# orderSlotFacts -- the facts of the text in slot `slot` of the call `st`
# opened; none stated when no argument fills it.
orderSlotFacts: function {t: Ctx.view st: orderstate slot: u64} out cfacts is {
    if (st.valBase + slot) >= t.orderValFacts.length then return cfacts
    return (t.orderValFacts.get i: st.valBase + slot)
}

# orderSetSlot -- fill slot `slot` of the call `st` opened with `text`, whose
# facts are `tf`.
orderSetSlot: function {ctx: Ctx st: orderstate slot: u64 text: String.take tf: cfacts} is {
    orderSetSlotAt :ctx base: st.valBase :slot :text :tf
}

# orderSetSlotAt -- orderSetSlot for the call whose slots begin at `base`.
orderSetSlotAt: function {ctx: Ctx base: u64 slot: u64 text: String.take tf: cfacts} is {
    for ctx.orderVals.length <= (base + slot) loop ctx.orderVals.append String
    for ctx.orderValFacts.length <= (base + slot) loop ctx.orderValFacts.append cfacts
    ctx.orderVals.set i: base + slot val: text
    ctx.orderValFacts.set i: base + slot val: tf
}

# orderPartWith -- one part of a call, whose facts are `tf`, just built from `mark`, placed in evaluation
# order. Parts are evaluated in the order they are written. C leaves a call's
# arguments and an operator's operands unsequenced, so a part that is not
# constant is read into an ordered temp first when something evaluated after it
# could change what it reads or see what it does: a later part that may write,
# or a later part's hoists. A part that only READS (its facts say so) needs no temp
# when every part after it only reads too -- nothing can change what it read --
# and a part that may write needs one only when anything not constant follows
# it. So a part waits until what follows decides: the last one stays in the
# call, and so does every reading part after the last writing one. The first
# such part's hoists stay where the statement declares them: nothing is
# evaluated before them. A part whose hole the row names more than once is read
# into its temp at once when reading it twice would repeat work or effects (its
# facts say `once`): it is evaluated where it is written either way, and the
# body then spells the temp.
orderPartWith: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    st: orderstate.borrow
    # where the pending hoists stood before the part was built
    mark: hoistmark
    text: String.take
    tf: cfacts
    # a literal, a folded constant, or an address no part can move
    constant: bool
    # the function and parameter a temp's C type is spelled from
    fid: ztypes.tid
    pid: ztypes.tid
    pname: zast.nameid
    # the temp's C type when the caller spells it, "" to spell it from the above
    ctype: StringView
    # the parameter slot the part fills
    slot: u64
    # the node whose value the text is, which types a scalar's temp; 0 for none
    valueNid: zast.nodeid.zero
} is {
    pure: constant.not and tf.pure
    if st.live then {
        if (hoistsWithValues :ctx :mark) or (constant.not and pure.not) then {
            orderSettleWaiting :ast :reg :typing :ctx :st all: true
        } else if constant.not then {
            orderSettleWaiting :ast :reg :typing :ctx :st all: false
        }
        i: mark.names
        for i < ctx.argHoists.length loop {
            pv: String
            pn: String
            {
                ph: ctx.argHoists.getMut :i
                if ph.val.length > 0 then {
                    pv swap ph.val
                    pn.append ph.name
                }
            }
            if pv.length > 0 then {
                orderAddPiece :ctx name: pn temp: 0 val: pv seq: (orderNextSeq :ctx)
            }
            i = i + 1
        }
    }
    if constant then {
        orderSetSlot :ctx :st :slot :text :tf
        return
    }
    st.live = true
    ctx.orderPends.append (
        OrderPend
        :text
        ctype: ctype.string
        :slot
        :fid
        :pid
        :pname
        nid: valueNid
        :pure
        facts: tf
        valBase: st.valBase
        seq: (orderNextSeq :ctx)
        done: false
    )
    if (orderSlotTwice :st :slot) when tf.once or tf.stated.not then {
        orderSettle :ast :reg :typing :ctx i: ctx.orderPends.length - 1
        ctx.orderPends.pop
    }
}

# orderSettleWaiting -- a part follows the call's waiting parts that decides
# them. One that may write, or brings hoists, settles every waiting part into
# its temp, in written order. One that only reads settles only a waiting part
# that may write; reading parts keep waiting. A waiting part that may write is
# always the only one waiting: what follows it settles it either way.
orderSettleWaiting: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    st: orderstate.view
    all: bool
} is {
    n: ctx.orderPends.length
    # a part settleAhead already settled waits for nothing
    fw: st.pendMark
    for fw < n loop {
        if (ctx.orderPends.get i: fw).done.not then break
        fw = fw + 1
    }
    if fw == n then return
    if all.not when (ctx.orderPends.get i: fw).pure then return
    i: fw
    for i < n loop {
        if (ctx.orderPends.get :i).done.not then orderSettle :ast :reg :typing :ctx :i
        i = i + 1
    }
    orderDropWaiting :ctx :st
}

# orderDropWaiting -- the call's waiting parts, decided: off orderPends.
orderDropWaiting: function {ctx: Ctx st: orderstate.view} is {
    for ctx.orderPends.length > st.pendMark loop ctx.orderPends.pop
}

# hoistsWithValues -- whether a part built from `mark` recorded a hoist that is
# still initialised where the statement declares it.
hoistsWithValues: function {ctx: Ctx.view mark: hoistmark} out bool is {
    i: mark.names
    for i < ctx.argHoists.length loop {
        if (ctx.argHoists.get :i).val.length > 0 then return true
        i = i + 1
    }
    return false
}

# orderSettle -- something is evaluated after waiting part `i`: read it into its
# ordered temp here, declared zero by the statement. A part whose type has no C
# spelling stays in the call. orderDropWaiting takes the entry off afterwards.
orderSettle: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    i: u64
} is {
    text: String
    given: String
    slot: u64
    fid: ztypes.tid
    pid: ztypes.tid
    pnm: zast.nameid
    vnid: zast.nodeid
    pf: cfacts
    vb: u64
    sq: u64
    {
        op: ctx.orderPends.getMut :i
        text swap op.text
        given swap op.ctype
        slot = op.slot
        fid = op.fid
        pid = op.pid
        pnm = op.pname
        vnid = op.nid
        pf = op.facts
        vb = op.valBase
        sq = op.seq
        op.done = true
    }
    # a part no declared parameter types is typed as its own expression's
    # value, unqualified so a `const` source still gives an assignable temp. A
    # scalar is spelled with its C type: typed as its own expression, the
    # operand of a chain would repeat the whole chain before it
    # the type the caller gave wins, then the declared parameter's, then the
    # part's own; each is spelled only when nothing above it answered
    ct: String
    if given.length > 0 then {
        ct = given.take
    } else if fid.notZero then {
        ct = paramCType :ast :reg :typing :ctx :fid pnameId: pnm :pid
    } else {
        if vnid.notZero then ct = operandScalarC :reg :typing n: (ast.nodes.get i: vnid)
        if ct.length == 0 then {
            preludeNeed :ctx memb: "@value_typeof"
            ct = "Z_VALUE_TYPEOF(\{text})"
        }
    }
    if ct.length == 0 then {
        orderSetSlotAt :ctx base: vb :slot :text tf: pf
        return
    }
    tnum: ctx.orderCtr
    ctx.orderCtr = ctx.orderCtr + 1
    tn: "_o\{tnum}"
    # an evaluation-order temp holds the part's value for the call, which owns
    # it: it is no address hoist and owes no destroy
    orderAddPiece :ctx name: String temp: tnum + 1 val: text seq: sq
    ctx.argHoists.append (ArgHoist name: tn.copy val: String ctype: ct dtor: String)
    # the ordered temp's name
    orderSetSlotAt :ctx base: vb :slot text: tn tf: pathFacts
}

# orderAddPiece -- an assignment that runs ahead of its call: to ordered temp
# `temp` - 1, or to the hoist `name` when `temp` is 0. `seq` is when its part
# was built.
orderAddPiece: function {ctx: Ctx name: String.take temp: u64 val: String.take seq: u64} is {
    ctx.orderPieces.append (OrderPiece :name :temp :val :seq done: false)
}

# OrderPiece -- one assignment that runs ahead of the call it belongs to
# (orderAddPiece).
OrderPiece: class {
    # the hoist it assigns, when `temp` is 0
    name: String
    # the ordered temp it assigns, plus one; 0 for a hoist
    temp: u64
    # the value's C text; empty once settleAhead made the piece a statement
    val: String
    # when its part was built
    seq: u64
    # settleAhead already made it a statement
    done: bool
}

# orderNextSeq -- the next number on the order counter.
orderNextSeq: function {ctx: Ctx} out u64 is {
    s: ctx.orderSeq
    ctx.orderSeq = s + 1
    return s
}

# settleAhead -- a control value is about to run as statements ahead of the
# statement being built (a raw hoist), so whatever that statement evaluates
# before it has to run before it too: every piece still waiting in an open
# call's comma prefix, and every part still waiting to learn whether it needs
# a temp, is made a statement now -- `_oN = text;` -- in the order it was
# built, which is the order it is written. Only the parts built since the
# innermost control value began are touched (orderSeqFloor): an arm's
# statements are its own. Inside a region that runs only on some paths
# (guardDepth) nothing is: that region is built as statements around it, or
# keeps its control value in place.
settleAhead: function {
    ast: Ast.view reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx
} is {
    if ctx.guardDepth > 0 then return
    for true loop {
        # the earliest part not yet made a statement, then the earliest piece
        pe: earliestUnsettled :ctx
        if pe.found.not then return
        if pe.isPend then {
            # settled into its temp, the part is a piece at the end of the list
            # -- or, with no C type for a temp, stays in its call
            np: ctx.orderPieces.length
            orderSettle :ast :reg :typing :ctx i: pe.at
            if ctx.orderPieces.length > np then settlePieceAhead :ctx i: np
        } else {
            settlePieceAhead :ctx i: pe.at
        }
    }
}

# unsettled -- the earliest part or piece settleAhead has still to make a
# statement: whether there is one, whether it is a waiting part (else a
# piece), its index in its list, and when it was built.
unsettled: record {
    found: bool
    isPend: bool
    at: u64
    seq: u64
}

# earliestUnsettled -- the part or piece at or above the order floor, not yet
# made a statement, that was built first.
earliestUnsettled: function {ctx: Ctx.view} out unsettled is {
    r: unsettled found: false isPend: false at: 0 seq: 0
    fl: ctx.orderSeqFloor
    pi: u64
    for pi < ctx.orderPends.length loop {
        pd: ctx.orderPends.get i: pi
        if pd.done.not when pd.seq >= fl when (seqBeats :r seq: pd.seq) then {
            r = unsettled found: true isPend: true at: pi seq: pd.seq
        }
        pi = pi + 1
    }
    ci: u64
    for ci < ctx.orderPieces.length loop {
        cp: ctx.orderPieces.get i: ci
        if cp.done.not when cp.seq >= fl when (seqBeats :r seq: cp.seq) then {
            r = unsettled found: true isPend: false at: ci seq: cp.seq
        }
        ci = ci + 1
    }
    return r
}

# seqBeats -- whether something built at `seq` was built before the best so far.
seqBeats: function {r: unsettled seq: u64} out bool is {
    if r.found.not then return true
    return seq < r.seq
}

# settlePieceAhead -- piece `i`'s assignment as a statement ahead of the one
# being built, and off its call's comma prefix.
settlePieceAhead: function {ctx: Ctx i: u64} is {
    p: ctx.orderPieces.getMut :i
    lhs: String
    if p.temp > 0 then {
        lhs.append "_o"
        appendDecimal buf: lhs n: p.temp - 1
    } else {
        lhs.append p.name
    }
    v: String
    v.append p.val
    p.val = String
    p.done = true
    ctx.argHoistRaw.append (
        RawHoist
        text: "\{lhs} = \{v};\n"
        at: ctx.argHoists.length
        settles: true
    )
}

# orderFinish -- a call's parts are built: the opening of the comma expression
# whose assignments run ahead of it -- `(a = x, b = y, ` -- or "" when there are
# none (orderClose completes it). The parts still waiting need no temp: the last
# one evaluated, and the reading parts after the last one that may write, stay
# in the call.
orderFinish: function {ctx: Ctx st: orderstate} out String is {
    wi: st.pendMark
    for wi < ctx.orderPends.length loop {
        # a part settleAhead settled has its slot filled already
        if (ctx.orderPends.get i: wi).done.not then {
            wtext: String
            wslot: u64
            wf: cfacts
            {
                wp: ctx.orderPends.getMut i: wi
                wtext swap wp.text
                wslot = wp.slot
                wf = wp.facts
            }
            orderSetSlot :ctx :st slot: wslot text: wtext tf: wf
        }
        wi = wi + 1
    }
    orderDropWaiting :ctx :st
    prefix: String
    i: st.pieceMark
    for i < ctx.orderPieces.length loop {
        p: ctx.orderPieces.get :i
        # a piece settleAhead made a statement has run already
        if p.done.not then {
            if prefix.length == 0 then prefix.append "("
            if p.temp > 0 then {
                prefix.append "_o"
                appendDecimal buf: prefix n: p.temp - 1
            } else {
                prefix.append p.name
            }
            prefix.append " = "
            prefix.append p.val
            prefix.append ", "
        }
        i = i + 1
    }
    for ctx.orderPieces.length > st.pieceMark loop ctx.orderPieces.pop
    return prefix
}

# appendDecimal -- `n` in decimal digits, written onto `buf` without a string of
# its own.
appendDecimal: function {buf: String.borrow n: u64} is {
    p: 1.u64
    for (n / p) >= 10 loop p = p * 10
    for p > 0 loop {
        dig: n / p % 10
        buf.appendByte b: ((48.u64 + dig).u8.or d: 48)
        p = p / 10
    }
}

# orderClose -- a call's C text, `callee(args)`, after the assignments orderFinish
# opened ahead of it.
orderClose: function {prefix: String.take callee: StringView args: StringView} out String is {
    opened: prefix.length > 0
    r: prefix.take
    r.append callee
    r.append "("
    r.append args
    r.append ")"
    if opened then r.append ")"
    return r
}

# orderConstantWith -- a part, whose facts are `tf`, whose evaluation no other part can observe or affect:
# a literal or a folded constant, an address of a plain place, or a pointer a
# pointer parameter is handed on.
orderConstantWith: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    tf: cfacts
    # the parameter takes the part by pointer
    byPtr: bool
} out bool is {
    cv: typing.nodeConstAt nid: (interpPartNodeId :n)
    if cv.isConst then return true
    # a constant a unit or a list names reaches the C as its literal
    if tf.constant then return true
    if n.atomstring when (litIndexOf :ctx nid: n.nodeid) > 0 then return true
    if n.dottedpath then {
        # an arm without a payload named on its type, and a literal's own String
        if (dottedTaggedTid :typing nid: n.nodeid).notZero then return true
        mid: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        if mid == zast.wellKnown.slot.wkString then {
            return (bindLitIndex :ast :ctx n: (ast.nodes.get i: n.parent)) > 0
        }
    }
    if tf.fixedAddr then return true
    if byPtr.not then return false
    return tf.path
}

# flushArgHoists -- emit the `String_t _ahN = <rvalue>;` declarations recorded by
# emitInstanceMethodCall for borrow-String args that needed `&` on a non-lvalue.
# Called at statement level (which holds ind/tmp/buf) right after the call
# expression is built; registers each temp for scope-exit free.
# `floor`/`rawFloor` mark pending hoists that belong to an ENCLOSING scope: a
# string interpolation used as a value emits into its own `({ ... })` buffer, and
# declaring a sibling argument's temp in there produces C that gcc rejects with
# `_ahN undeclared`. Everything below the floor stays pending for the outer flush.
flushArgHoists: function {
    ctx: Ctx
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    floor: 0.u64
    rawFloor: 0.u64
} is {
    # a statement expression being built keeps the hoists pending around it
    fl: floor
    if ctx.argHoistFloor > fl then fl = ctx.argHoistFloor
    rfl: rawFloor
    if ctx.argHoistRawFloor > rfl then rfl = ctx.argHoistRawFloor
    lf0: tmp.listFrees.length
    i: fl
    n: ctx.argHoists.length
    ri: rfl
    rn: ctx.argHoistRaw.length
    for i < n loop {
        # the statements recorded before this hoist run before it
        ri = appendRawHoistsTo :ctx from: ri to: rn upto: i :ind :buf
        ah: ctx.argHoists.get :i
        appendArgHoistDecl :ah :ind :buf
        dto: ah.dtor.stringView
        if dto.length > 0 when ctx.hoistsToBlock then {
            tmp.oweList stmt: ah.dtor.copy name: ah.name.copy
        } else if dto.length > 0 then {
            tmp.oweTemp stmt: ah.dtor.copy name: ah.name.copy
        }
        i = i + 1
    }
    tagOwedTemps :ctx :tmp from: lf0
    for ri < rn loop {
        appendRawHoist :ctx i: ri :ind :buf
        ri = ri + 1
    }
    # drop what was just emitted, back to the floor -- not to empty
    for ctx.argHoists.length > fl loop ctx.argHoists.pop
    for ctx.argHoistRaw.length > rfl loop ctx.argHoistRaw.pop
}

# appendArgHoistDecl -- one argument hoist's declaration. A hoist assigned where
# its part runs has no initialiser: it starts zero.
appendArgHoistDecl: function {ah: ArgHoist.view ind: StringView buf: String.borrow} is {
    buf.append ind
    buf.append ah.ctype
    buf.append " "
    buf.append ah.name
    buf.append " = "
    if ah.val.length == 0 then {
        buf.append "{0}"
    } else {
        buf.append ah.val
    }
    buf.append ";\n"
}

# appendRawHoistsTo -- the raw hoists from `from` (below `to`) recorded before
# argument hoist `upto`, in order; the answer is the first one not written.
appendRawHoistsTo: function {
    ctx: Ctx.view
    from: u64
    to: u64
    upto: u64
    ind: StringView
    buf: String.borrow
} out u64 is {
    ri: from
    for ri < to loop {
        if (ctx.argHoistRaw.get i: ri).at > upto then return ri
        appendRawHoist :ctx i: ri :ind :buf
        ri = ri + 1
    }
    return ri
}

# appendRawHoist -- raw hoist `i`'s statements, each line at `ind`.
appendRawHoist: function {ctx: Ctx.view i: u64 ind: StringView buf: String.borrow} is {
    rh: ctx.argHoistRaw.get :i
    for each ln: rh.text.stringView.lines loop {
        buf.append ind
        buf.append ln
        buf.append "\n"
    }
}

# recordRawHoist -- statements the statement being built runs ahead of itself,
# after the argument hoists recorded so far.
recordRawHoist: function {ctx: Ctx text: String.take} is {
    ctx.argHoistRaw.append (RawHoist :text at: ctx.argHoists.length settles: false)
}

# hoistmark -- where the pending argument hoists and their floors stood when a
# condition began building its text in place.
hoistmark: record {
    names: u64
    raw: u64
    floor: u64
    rawFloor: u64
    # the region runs only on some paths, or at every loop test (guardDepth)
    guarded: bool
}

# pendingHoistMark -- where the pending hoists and their floors stand now.
pendingHoistMark: function {ctx: Ctx.view} out hoistmark is {
    return (
        hoistmark
        names: ctx.argHoists.length
        raw: ctx.argHoistRaw.length
        floor: ctx.argHoistFloor
        rawFloor: ctx.argHoistRawFloor
        guarded: false
    )
}

# openInPlace -- begin a condition evaluated where it is written: a `when`
# conjunct past the first, a loop's test, a do-while's trailing test. The
# hoists pending around it stay pending; the ones its text records are its own,
# and closeInPlace or wrapInPlace ends it. `guarded` says it runs only on some
# paths, or at every loop test, so nothing evaluated before it may be moved
# into it (settleAhead).
openInPlace: function {ctx: Ctx guarded: bool} out hoistmark is {
    mk: pendingHoistMark :ctx
    mk.guarded = guarded
    ctx.argHoistFloor = mk.names
    ctx.argHoistRawFloor = mk.raw
    if guarded then ctx.guardDepth = ctx.guardDepth + 1
    return mk
}

# hoistsGrew -- whether the condition begun at `mark` recorded a hoist of its own.
hoistsGrew: function {ctx: Ctx.view mark: hoistmark} out bool is {
    if ctx.argHoists.length > mark.names then return true
    return ctx.argHoistRaw.length > mark.raw
}

# closeInPlace -- end what openInPlace began, for a condition that recorded no
# hoist of its own: the pending hoists around it are the enclosing statement's.
closeInPlace: function {ctx: Ctx mark: hoistmark} is {
    ctx.argHoistFloor = mark.floor
    ctx.argHoistRawFloor = mark.rawFloor
    if mark.guarded then ctx.guardDepth = ctx.guardDepth - 1
}

# appendInPlaceCond -- end the condition begun at `mark` and append it: its
# text, or that text assigning and releasing its own hoists (assignInPlaceTest).
# Every caller declares the pending hoists ahead of its construct: a loop's
# header or its arm break, a do-while ahead of `do {`, an `if` clause's head.
appendInPlaceCond: function {
    ctx: Ctx
    mark: hoistmark
    text: StringView
    dst: String.borrow
} is {
    if (hoistsGrew :ctx :mark) then {
        dst.append (assignInPlaceTest :ctx :mark cond: text)
        return
    }
    closeInPlace :ctx :mark
    dst.append text
}

# assignInPlace -- end what openInPlace began, for a part of a C expression that
# runs only on some paths (an arm of a ternary, a condition past the first) and
# recorded hoists: each is still declared by the enclosing statement, zeroed, and
# assigned where the part is evaluated -- `(_ahN = v, part)` -- so a path that
# skips the part leaves it zero, which its release ignores. A raw hoist is a
# statement no expression can hold; the answer is then "" and the caller builds
# the whole construct as statements instead.
assignInPlace: function {ctx: Ctx mark: hoistmark text: StringView} out String is {
    if ctx.argHoistRaw.length > mark.raw then {
        closeInPlace :ctx :mark
        return "".string
    }
    r: "(".string
    i: mark.names
    for i < ctx.argHoists.length loop {
        # an inner part already assigns its own hoists where it runs, and left
        # no initialiser
        ph: ctx.argHoists.getMut :i
        if ph.val.length > 0 then {
            vl: String
            vl swap ph.val
            r.append "\{ph.name} = \{vl}, "
        }
        i = i + 1
    }
    closeInPlace :ctx :mark
    if r.length == 1 then return text.string
    r.append text
    r.append ")"
    return r
}

# assignInPlaceTest -- end what openInPlace began, for a condition evaluated at
# every test whose hoists the caller declares ahead of its construct: each is
# assigned where the test runs and released once the test has its value --
# `(_ahN = v, _ccN = (cond), destroy(&_ahN), _ccN)` -- so the statement
# declaring it owes it nothing. A hoist an inner part assigns only on some paths
# is zeroed first, so a path that skips it releases nothing. A raw hoist is a
# statement no expression can hold, and takes wrapInPlace.
assignInPlaceTest: function {ctx: Ctx mark: hoistmark cond: StringView} out String is {
    if ctx.argHoistRaw.length > mark.raw then return (wrapInPlace :ctx :mark :cond)
    r: "(".string
    rel: String
    i: mark.names
    for i < ctx.argHoists.length loop {
        ph: ctx.argHoists.getMut :i
        owes: ph.dtor.length > 0
        if ph.val.length > 0 then {
            vl: String
            vl swap ph.val
            r.append "\{ph.name} = \{vl}, "
        } else if owes then {
            r.append "\{ph.name} = (\{ph.ctype}){0}, "
        }
        if owes then {
            # the statement declaring the hoist owes it nothing
            dl: String
            dl swap ph.dtor
            dt: dl.stringView.trim
            rel.append ", "
            if dt.endsWith ";" then {
                rel.append (dt.substring from: 0 to: dt.length - 1)
            } else {
                rel.append dt
            }
        }
        i = i + 1
    }
    if rel.length == 0 then {
        closeInPlace :ctx :mark
        r.append cond
        r.append ")"
        return r
    }
    ltmp: TmpCtr n: 0 listFrees: List OwedFree
    cc: "_cc\{tmpNext :ctx tmp: ltmp}"
    ctx.argHoists.append (ArgHoist name: cc.copy val: String ctype: "bool".string dtor: String)
    closeInPlace :ctx :mark
    r.append "\{cc} = \{condInParens :cond}\{rel}, \{cc})"
    return r
}

# wrapInPlace -- end what openInPlace began, for a condition that recorded a
# raw hoist (a statement no expression can hold): the hoists run where the
# condition is evaluated -- past a short circuit, at every loop test -- as a
# statement expression that declares them, computes the test, releases what
# they owed and yields the test.
wrapInPlace: function {ctx: Ctx mark: hoistmark cond: StringView} out String is {
    ltmp: TmpCtr n: 0 listFrees: List OwedFree
    ccN: tmpNext :ctx tmp: ltmp
    lbuf: String
    flushArgHoists :ctx ind: " " tmp: ltmp buf: lbuf
    cw: condInParens :cond
    lbuf.append " bool _cc\{ccN} = \{cw};"
    flushBlockFrees tmp: ltmp lL: 0 diverged: false buf: lbuf
    closeInPlace :ctx :mark
    return "({\{lbuf} _cc\{ccN}; })"
}

# tmpNext -- the next temp number of the function being emitted, from `tmp` or
# from a statement expression's own counter, whichever has counted further.
tmpNext: function {ctx: Ctx tmp: TmpCtr} out u64 is {
    if ctx.tmpHigh > tmp.n then tmp.n = ctx.tmpHigh
    v: tmp.next
    ctx.tmpHigh = tmp.n
    return v
}

# pushLoopLabel -- allocate a unique break-target label for a loop and push it.
# A zerolang `break` inside the loop emits `goto __zbrk_<id>`: a bare C `break`
# would only leave an enclosing match->switch, not the loop. The label is
# emitted after the loop by popLoopLabel, but only if a break referenced it.
pushLoopLabel: function {ctx: Ctx tmp: TmpCtr.view isDo: bool postTest: bool} out u64 is {
    id: ctx.breakLabelCtr
    ctx.breakLabelCtr = id + 1
    ctx.loops.append (
        LoopFrame
        :id
        :isDo
        :postTest
        listMark: tmp.listFrees.length
        leftEarly: false
    )
    return id
}

# noteFrameLeft -- a `break` or `continue` of the frame at `idx` is being emitted.
noteFrameLeft: function {ctx: Ctx idx: u64} is {
    lf: ctx.loops.getMut i: idx
    lf.leftEarly = true
}

# anyFrameLeft -- an open loop or block has already been left by a `break` or
# `continue`, so what comes later in it does not run on every path.
anyFrameLeft: function {ctx: Ctx.view} out bool is {
    for each lf: ctx.loops loop {
        if lf.leftEarly then return true
    }
    return false
}

# emitContLabel -- the loop-body continue target: a `continue` inside a
# do{}while(0) wrapper jumps here (past the wrapper, before the loop's
# closing brace so the increment/condition re-evaluates). Emitted only
# when a continue referenced it.
emitContLabel: function {ctx: Ctx.view id: u64 ind: StringView buf: String.borrow} is {
    uo: ctx.contLabelUsed.get key: id
    if uo.some then {
        lbl: "\{ind}__zcont_\{id}: ;\n"
        buf.append lbl
    }
}

# emit the C label that closes loop `id`.
popLoopLabel: function {ctx: Ctx id: u64 ind: StringView buf: String.borrow} is {
    if ctx.loops.length > 0 then ctx.loops.pop
    uo: ctx.breakLabelUsed.get key: id
    if uo.some then {
        lbl: "\{ind}__zbrk_\{id}: ;\n"
        buf.append lbl
    }
}


# noteCreateUse -- written C builds a `tid` field by field (`_create`, or
# `_meta_create` from its own `create`), so the constructor emitOneRecord
# writes beside the type is written. One built after its type was written
# names a function that is never written; a runtime-owned class's is written
# with its struct.
noteCreateUse: function {ctx: Ctx tid: ztypes.tid} is {
    if (ctx.createUsed.has item: tid) then return
    if (ctx.emittedUserTypes.has item: tid) when (ctx.classRowTids.contains item: tid).not then {
        cn: ctxCname :ctx :tid
        emitFail :ctx what: "\{cn} built after its type was written" line: 0
        return
    }
    ctx.createUsed.add item: tid
}

# noteCreateAliasUse -- written C builds a `tid` through its `<rc>_create`
# name, the `#define` written with its `_meta_create` (emitMetaCreate)
noteCreateAliasUse: function {ctx: Ctx tid: ztypes.tid} is {
    noteCreateUse :ctx :tid
    ctx.createAliasUsed.add item: tid
}

# noteDestroyUse -- written C calls the destructor of `tid`, a destroy target
# (destroyTargetTid), so a record's or a class's is written; and so is each
# part's its body frees (destroyParts), demanded now so the set is whole
# before the first type is written. A record's destructor called after its
# type was written names a function that is never written.
noteDestroyUse: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx tid: ztypes.tid
} is {
    if (ctx.destroyUsed.has item: tid) then return
    if (destroyGated :reg :ctx :tid) when (ctx.emittedUserTypes.has item: tid) then {
        cn: ctxCname :ctx :tid
        emitFail :ctx what: "the destructor of \{cn} called after its type was written" line: 0
        return
    }
    ctx.destroyUsed.add item: tid
    # an instance's destructor is a member of its template
    noteMemberUse :ctx mono: tid member: memberWord.slot.destroy
    parts: ListVal ztypes.tid
    destroyParts :reg :typing :ctx :tid acc: parts
    for each p: parts loop {
        dt: destroyTargetTid :reg :typing :ctx tid: p
        if dt.notZero when dt != ctx.strTid then noteDestroyUse :reg :typing :ctx tid: dt
    }
}

# destroyParts -- the types whose values a destructor of `tid` frees: an
# instance's elements, keys, values, payloads or fields (monoElemIdsOf), a
# record's or a class's fields but the borrowed ones (a Box field is the Box),
# a variant's or a union's arm payloads.
destroyParts: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
    acc: ListVal ztypes.tid
} is {
    names: ListVal zast.nameid
    tt: reg.typetypeOf typeId: tid
    # a templated class's destructor frees what its destroy section's holes
    # spell, recorded with the sections the instance keeps (closeTmplDestroys)
    if (tmplClassRowOf :reg :ctx :tid) != 0 then return
    if (originTidOf :reg :tid).notZero then {
        monoElemIdsOf :reg :typing :ctx monoId: tid :acc
    } else if tt.isFieldwise then {
        fids: ListVal ztypes.tid
        recFieldIds :reg :typing :tid ids: fids nameIds: names
        i: u64
        for i < fids.length loop {
            f: fids.get :i
            fn: names.get :i
            i = i + 1
            if (typing.declIsBorrowedFieldId parentTypeId: tid nameId: fn) then continue
            bx: fieldIsBox :reg fid: f
            if bx.notZero then f = bx
            acc.append f
        }
    } else if (tt == ztypes.ztypetype.variantType) or (tt == ztypes.ztypetype.unionType) then {
        variantArmIds :reg :typing :tid ids: acc nameIds: names
    }
}

# destroyGated -- `tid`'s destructor is one zc writes only when written C calls
# it: a record's or a class's (emitOneRecord), a runtime-owned class's
# `destroy` fragment (emitClassRowStructs), a templated class's `destroy`
# section (rtSectionPlan), a union's -- Option, Result, a user's
# (emitUnionMono) --, a view option's (emitOptionViewMono) or a protocol's
# (emitOneProtocol); but not an instance of a runtime container template
# (List, Box), whose destructor is written with it.
destroyGated: function {reg: ztypes.ZTypeRegistry.view ctx: Ctx.view tid: ztypes.tid} out bool is {
    tt: reg.typetypeOf typeId: tid
    if tt == ztypes.ztypetype.unionType then return true
    if tt == ztypes.ztypetype.protocolType then return true
    if (isViewUnionOriginOf :reg :ctx :tid) then return true
    if tt.isFieldwise.not then return false
    o: originTidOf :reg :tid
    return o.isZero or (ctx.origins.contains item: o).not
}

# destroyWritten -- a gated destructor (destroyGated) is written only when
# written C calls it (noteDestroyUse); any other is written with its type.
destroyWritten: function {
    reg: ztypes.ZTypeRegistry.view ctx: Ctx.view tid: ztypes.tid
} out bool is {
    if (destroyGated :reg :ctx :tid).not then return true
    return (ctx.destroyUsed.has item: tid)
}

# destroyTargetTid -- the type whose cleanup frees a value of tid, zero when the
# value owns nothing. A typedef emits no cleanup of its own: it shares its end's
# struct and cleanup, an aggregate's (chaseAggregateTypedef) or a String's
# (chaseStrTypedef), so every destroy of a typedef's value names the end's.
destroyTargetTid: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
} out ztypes.tid is {
    dt: chaseStrTypedef :typing :ctx tid: (chaseAggregateTypedef :reg :typing :ctx :tid)
    if (dt == ctx.strTid) or (ownsResources :reg :ctx tid: dt) then return dt
    if (isHeapPtrCollection :reg :typing :ctx tid: dt) then return dt
    return ztypes.tid
}

# ownsResources -- a value of `tid` owns something its destructor releases: the
# checker's verdict from its fields and implementations, or a runtime-owned class
# (a ClassRow) whose destructor the runtime supplies -- an fd, a database
# handle -- which no field of its declaration shows, in a program that has
# the class (live or used, as emitClassRowStructs writes it), or an instance
# of a templated class. Every question of whether the C must destroy a value
# asks this.
ownsResources: function {reg: ztypes.ZTypeRegistry.view ctx: Ctx.view tid: ztypes.tid} out bool is {
    if (reg.needsDestructor typeId: tid) then return true
    # an instance of a templated class: its template supplies the destructor
    if (tmplClassRowOf :reg :ctx :tid) > 0 then return true
    if (ctx.classRowTids.contains item: tid).not then return false
    return (ctx.liveClasses.has item: tid) or (typeIsUsed :ctx :tid)
}

# destroyFnC -- the C function that frees a value of tid, handed destroyOperand's
# form of it: a String's free, else its destroy target's destructor; "" when the
# value owns nothing.
destroyFnC: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} out String is {
    dt: destroyTargetTid :reg :typing :ctx :tid
    if dt.isZero then return String
    noteDestroyUse :reg :typing :ctx tid: dt
    if dt == ctx.strTid then {
        preludeNeed :ctx memb: "@String_free"
        return "\{ctx.strC}_free"
    }
    return "\{ctxCnameView :ctx tid: dt}_destroy"
}

# destroyLineC -- the statement, indented by `ind`, that frees the value `nm` of
# type tid: destroyFnC handed destroyOperand's form of nm; "" when it owns
# nothing.
destroyLineC: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    nm: StringView
    ind: StringView
} out String is {
    dt: destroyTargetTid :reg :typing :ctx :tid
    if dt.isZero then return String
    noteDestroyUse :reg :typing :ctx tid: dt
    if dt == ctx.strTid then {
        preludeNeed :ctx memb: "@String_free"
        return "\{ind}\{ctx.strC}_free(&\{nm});\n"
    }
    addr: "&"
    if (valueIsItsPointer :reg :typing :ctx tid: dt) then addr = ""
    return "\{ind}\{ctxCnameView :ctx tid: dt}_destroy(\{addr}\{nm});\n"
}

# hoistDestroyLine -- the scope-exit line that destroys a hoisted `_ah` temp
# of type `tid`, "" when the type owns nothing.
hoistDestroyLine: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    nm: StringView
} out String is {
    return (destroyLineC :reg :typing :ctx :tid :nm ind: "    ")
}

# hoistBorrowValArgWith -- a by-value call argument whose facts are `avF` that is
# an owned, destructible, non-lvalue temporary (e.g. a `Map.get` Option result)
# handed to a borrow param (not paramTake) is freed by neither side: it is
# hoisted (hoistForAddress) and the temp's name returned; "" when no hoist is
# needed. `av` is borrowed -- the caller keeps ownership.
hoistBorrowValArgWith: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    av: StringView
    avF: cfacts
    pid: ztypes.tid
    paramTake: bool
    argNid: zast.nodeid
} out String is {
    # an lvalue needs no temp -- unless it is a typedef built from a consumed
    # local (`(Path s)`), spelled as that local, whose own free the consumption
    # dropped: the checker's temporary owns it
    if avF.place when (ownedTypedefArg :typing :argNid).not then return "".string
    if paramTake then return "".string
    # a value whose type frees nothing needs no temp to free it
    if (destroyTargetTid :reg :typing :ctx tid: pid).isZero then return "".string
    return (hoistForAddress :ast :reg :typing :ctx :av tid: pid :argNid)
}

# receiverOnce -- a receiver a call spells more than once: a vtable call reads
# both its table and its data through it, a function field is read through it
# and passed it. One that is not an lvalue -- a call's result -- is bound to a
# temp first, so it runs once; an owned result is released with the temp.
receiverOnce: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the call's dotted callable, whose parent is the receiver
    callable: astnode.view
    text: StringView
    textF: cfacts
    tid: ztypes.tid
} out String is {
    return (
        receiverOnceAt
        :ast
        :reg
        :typing
        :ctx
        baseNid: (dottedParentNodeId n: callable)
        :text
        :textF
        :tid
    )
}

# receiverOnceAt -- receiverOnce for a receiver known by its own node: a
# member read that auto-calls through a vtable has no call node.
receiverOnceAt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the receiver's node
    baseNid: zast.nodeid
    text: StringView
    textF: cfacts
    tid: ztypes.tid
} out String is {
    if textF.place then return text.string
    return (hoistForAddress :ast :reg :typing :ctx av: text :tid argNid: baseNid)
}

# hoistOwes -- whether a hoisted temporary owes a destroy: exactly when the
# checker's temporary for the value node `argNid` still owns what it holds where
# it dies (scopeOwnsTemp), whatever was hoisted. A `ptr` temporary is a `T*` into
# storage someone else owns, and owes none.
hoistOwes: function {typing: ztyping.ZTyping.view argNid: zast.nodeid ptr: bool} out bool is {
    if ptr then return false
    return (scopeOwnsTemp :typing :argNid)
}

# hoistCtype -- a hoisted temporary's C type: the value's, held through its heap
# pointer for a Map or Set, and a pointer to it for a `ptr` value.
hoistCtype: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    ptr: bool
} out String is {
    ct: typeRefC :ast :reg :typing :ctx :tid
    if ptr or (isHeapPtrCollection :reg :typing :ctx :tid) then ct.append "*"
    return ct
}

# hoistedBorrowDeref -- a reference-returning base bound to a temporary first,
# read back through its deref: the temporary holds a `T*` into storage the
# container owns and owns nothing itself, so no node's value is its to own.
hoistedBorrowDeref: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    av: StringView
    tid: ztypes.tid
} out String is {
    brp: hoistForAddress :ast :reg :typing :ctx :av :tid argNid: zast.nodeid ptr: true
    return "(*\{brp})"
}

# hoistForAddress -- bind a value to a statement temporary so its ADDRESS can be
# taken: C rejects `&f(x)`. The temporary owes a destroy exactly when the
# checker's temporary for the value node `argNid` still owns what it holds where
# it dies (scopeOwnsTemp) -- the one answer every hoist gives, whatever it
# hoists. `argNid` is 0 only where the caller has no node, and each such caller
# says why its value owns nothing. A `ptr` value is a `T*` into storage someone
# else owns: the temporary owns nothing and the caller derefs it. The caller
# decides addressability; a compound literal already is one and must not come
# here (it would cost a temp for nothing). Answers the temporary's name.
hoistForAddress: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    av: StringView
    tid: ztypes.tid
    # the value's node: what the checker's temporary for it owns
    argNid: zast.nodeid
    # the value is a `T*` into storage the temp does not own
    ptr: false
    # the checker's unnamed local this temp realises, 0 for none
    tag: zast.nameid.zero
} out String is {
    nm: argHoistName :ast :reg :typing :ctx :argNid fallback: "_ah"
    owes: hoistOwes :typing :argNid :ptr
    if tag.notZero when owes then ctx.hoistTags.set key: nm.copy value: tag
    dt: String
    if owes then dt = hoistDestroyLine :reg :typing :ctx :tid nm: nm.stringView
    ctx.argHoists.append (
        ArgHoist
        name: nm.copy
        val: av.string
        ctype: (hoistCtype :ast :reg :typing :ctx :tid :ptr)
        dtor: dt
    )
    return nm
}

# tagOwedTemps -- the statement temporaries just owed from `from` on that
# realise one of the checker's unnamed locals carry its name id, and the
# statement that zeroes them once destroyed early.
tagOwedTemps: function {ctx: Ctx tmp: TmpCtr from: u64} is {
    k: from
    for k < tmp.listFrees.length loop {
        o: tmp.listFrees.getMut i: k
        k = k + 1
        if o.temp then {
            tg: (ctx.hoistTags.remove key: o.name).or d: zast.nameid.zero
            if tg.notZero then {
                o.tag = tg
                o.zero = "memset(&\{o.name}, 0, sizeof(\{o.name}));"
            }
        }
    }
}

# stringViewBinopOperand -- the `&view` form of one string operand of `+`. A plain
# atom or a pooled literal addresses directly. An operand that is not an lvalue
# must HOIST first: `&` needs one, and svValueForm reads an owned String's
# expression twice, once for `.data` and once for `.size`, so a concat spelled
# twice allocates twice and leaks both. A StringView call (`sv + "!"`) binds to
# a temp the statement flush declares.
stringViewBinopOperand: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    expr: StringView
    exprF: cfacts
    facts: cfacts.borrow
} out String is {
    src: expr.string
    srcF: exprF
    if exprF.place.not then {
        operandTid: stampIdDeep :reg :typing :n
        hv: (
            hoistBorrowValArgWith
            :ast
            :reg
            :typing
            :ctx
            argNid: (zast.nodeIdOf :n)
            av: expr
            avF: exprF
            pid: operandTid
            paramTake: false
        )
        if hv.length > 0 then {
            src = hv.copy
            srcF = pathFacts
        }
    }
    isStrT: operandIsStr :reg :typing :ctx :n
    if isStrT.not when srcF.once then {
        # the operand is a view: bound so it is read once; it frees nothing
        src = hoistForAddress :ast :reg :typing :ctx av: expr tid: ctx.svTid argNid: zast.nodeid
        srcF = pathFacts
    }
    valueVid: atomVidIfPlain :ast :reg :typing :ctx :n text: src.stringView
    vf: String
    if src.stringView == expr then {
        vfa: (
            svValueFormAt
            :ast
            :reg
            :typing
            :ctx
            :n
            expr: src.stringView
            isStr: isStrT
            vid: valueVid
            facts: srcF
        )
        vf = vfa.take
    } else {
        # a hoisted operand is the temp, not the node
        vfh: (
            svValueForm
            :ast
            :reg
            :typing
            :ctx
            expr: src.stringView
            isStr: isStrT
            vid: valueVid
            facts: srcF
        )
        vf = vfh.take
    }
    return (stating :facts from: (addrFacts e: srcF) text: "&\{vf}")
}

# instargval -- what resolving one argument's VALUE answers. The text itself is
# appended to the caller's buffer; these four ride back beside it, `posIdx`
# because a positional argument advances a cursor the next parameter reads.
instargval: record {
    # the argument used an interpolation, which had to be built before the call
    usedInterp: bool
    # its position, for the natives that map labels onto a positional C
    # signature
    posIdx: u64
    # the argument's value node, 0 for an interpolated argument -- what a
    # pointer parameter re-reads when the value text loaded a pointer
    avNd: zast.nodeid
}

# instargptr -- how a declared parameter takes its argument: by pointer, as a
# borrowed String, moved in, and whether THIS argument needs an `&`.
instargptr: record {
    # the argument is passed by pointer
    ptra: bool
    # the parameter takes ownership
    pTake: bool
    # the parameter is by-reference, so a non-lvalue has to be hoisted to have
    # an address
    byref: bool
}

# instanceMethodArgValue -- the argument text for one declared parameter: an
# interpolated literal hoisted to a temp, else the labelled argument, else the
# next positional one. Advances the positional cursor exactly when it consumes
# a positional slot.
instanceMethodArgValue: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    mco: ztypes.tid
    posParamNameId: zast.nameid
    posParamId: ztypes.tid
    posIdx: u64
    av: String.borrow
    # the facts of what is appended to `av`
    avF: cfacts.borrow
} out instargval is {
    positionalIdx: posIdx
    ca: ctorArgFor :ast :call label: posParamNameId posIdx: positionalIdx
    isLabelled: ca.labelled
    iiF: cfacts
    iiVal: (
        ctorInterpArgAt
        :ast
        :reg
        :typing
        :ctx
        aid: ca.nid
        fid: mco
        pnameId: posParamNameId
        pid: posParamId
        facts: iiF
    )
    atomVarId: String
    usedInterp: false
    # the argument's value node, so the pointer check below asks
    # about the variable rather than the emitted text. An
    # interpolated argument is a statement expression, never a
    # variable, so it leaves this 0.
    avNd: zast.nodeid
    if iiVal.length > 0 then {
        atomVarId = iiVal.take
        stateFacts facts: avF from: iiF
        usedInterp = true
        if isLabelled.not then positionalIdx = positionalIdx + 1
    } else {
        avNd = ctorArgNodeByLabel :ast :call label: posParamNameId
        if avNd.isZero then {
            atomVarId = stating facts: avF from: constFacts text: "0".string
        } else {
            atomVarId = ctorArgTextAt :ast :reg :typing :ctx aid: avNd facts: avF
        }
        if isLabelled.not then {
            pF: cfacts
            pv: ctorArgByPosition :ast :reg :typing :ctx :call idx: positionalIdx facts: pF
            if pv.length > 0 then {
                atomVarId = pv.take
                stateFacts facts: avF from: pF
                avNd = ctorArgNodeByPosition :ast :call idx: positionalIdx
            }
            positionalIdx = positionalIdx + 1
        }
    }
    av.append atomVarId
    return (instargval :usedInterp posIdx: positionalIdx :avNd)
}

# instanceMethodArgPtr -- how one argument of a user-object method is passed:
# by pointer when the parameter takes one (paramTakesPointer), addressed unless
# the argument already is one (argAlreadyPointer), which asks the variable the
# value text `av` names. An interpolated argument is a statement expression,
# never an lvalue, so it never is.
instanceMethodArgPtr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    mco: ztypes.tid
    posParamNameId: zast.nameid
    posParamId: ztypes.tid
    usedInterp: bool
    av: StringView
    # the argument's node, 0 for an interpolated one
    avNd: zast.nodeid
} out instargptr is {
    pTake: paramTakesArg :typing fid: mco pnameId: posParamNameId
    ptra: (
        paramTakesPointer
        :reg
        :typing
        :ctx
        fid: mco
        pnameId: posParamNameId
        pid: posParamId
        takesArg: pTake
    )
    if usedInterp then ptra = false
    byref: false
    if ptra then {
        byref = true
        if avNd.notZero then {
            avn: ast.nodes.get i: avNd
            avq: atomVidIfPlain :ast :reg :typing :ctx n: avn text: av
            if (argAlreadyPointer :ast :reg :typing :ctx n: avn vid: avq) then byref = false
        }
    }
    return (instargptr :ptra :pTake :byref)
}

# instanceMethodArg -- one declared parameter of a user-object method, from its
# name to the C text that passes it. Answers the positional cursor for the next.
instanceMethodArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    mco: ztypes.tid
    posParamNameId: zast.nameid
    posParamId: ztypes.tid
    posIdx: u64
    args: String.borrow
    facts: cfacts.borrow
} out u64 is {
    atomVarId: String
    avF: cfacts
    avr: (
        instanceMethodArgValue
        :ast
        :reg
        :typing
        :ctx
        :call
        :mco
        :posParamNameId
        :posParamId
        :posIdx
        av: atomVarId
        :avF
    )
    ptr: (
        instanceMethodArgPtr
        :ast
        :reg
        :typing
        :ctx
        :mco
        :posParamNameId
        :posParamId
        usedInterp: avr.usedInterp
        av: atomVarId.stringView
        avNd: avr.avNd
    )
    (
        passMethodArg
        :ast
        :reg
        :typing
        :ctx
        :ptr
        avNd: avr.avNd
        usedInterp: avr.usedInterp
        :posParamId
        av: atomVarId
        :avF
        :args
        :facts
    )
    return avr.posIdx
}

# passMethodArg -- a method argument's C text, appended to `args`, once its
# value text `av` is built and how it is passed decided (instanceMethodArgPtr):
# the method call's and a declared operator's right operand's one rule.
passMethodArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    ptr: instargptr
    # the argument's node, 0 for an interpolated one
    avNd: zast.nodeid
    usedInterp: bool
    posParamId: ztypes.tid
    av: String.take
    avF: cfacts
    args: String.borrow
    facts: cfacts.borrow
} is {
    ctx.lastArgByPtr = ptr.byref
    # the value text LOADED a pointer-held valtype or a reference-returning
    # call's valtype result (valueExprC); a parameter that takes the pointer
    # reads the argument as written instead
    if ptr.ptra when ptr.byref.not when avNd.notZero then {
        avn: ast.nodes.get i: avNd
        if (
            (ptrHeldValtype :ast :reg :typing :ctx n: avn) or
            (refValtypeResult :ast :reg :typing :ctx n: avn)
        ) then {
            av = emitExprWith :ast :reg :typing :ctx n: avn facts: avF
        }
    }
    # an implementer standing in for a spec parameter is passed as its box: its
    # source's own temporary is spelled inside it, so it takes no other hoist,
    # and the box owns nothing here -- it holds its source by pointer, or the
    # parameter that owns it takes it
    if avNd.notZero when (typing.standInOf.has key: avNd) then {
        avn: ast.nodes.get i: avNd
        bx: (
            implementationArgText
            :ast
            :reg
            :typing
            :ctx
            argOpNode: avn
            av: av.stringView
            :avF
            avVid: (atomVidIfPlain :ast :reg :typing :ctx n: avn text: av.stringView)
        )
        if bx.length > 0 then {
            if ptr.byref then {
                args.append (
                    emitByrefArgWith
                    :ast
                    :reg
                    :typing
                    :ctx
                    av: bx.stringView
                    avF: callFacts
                    pid: posParamId
                    argNid: zast.nodeid
                    :facts
                )
            } else args.append (stating :facts from: callFacts text: bx.take)
            return
        }
    }
    if ptr.byref then {
        args.append (
            emitByrefArgWith
            :ast
            :reg
            :typing
            :ctx
            av: av.stringView
            :avF
            pid: posParamId
            argNid: avNd
            :facts
        )
    } else {
        (
            appendArgValue
            :ast
            :reg
            :typing
            :ctx
            :ptr
            :usedInterp
            :posParamId
            av: av.stringView
            :avF
            argNid: avNd
            :args
            :facts
        )
    }
}

# appendArgValue -- a method argument passed as its value (not addressed),
# hoisted when a borrow of the value has to be.
appendArgValue: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    ptr: instargptr
    usedInterp: bool
    posParamId: ztypes.tid
    av: StringView
    avF: cfacts
    argNid: zast.nodeid
    args: String.borrow
    facts: cfacts.borrow
} is {
    if ptr.ptra.not when usedInterp.not then {
        vbhm: (
            hoistBorrowValArgWith
            :ast
            :reg
            :typing
            :ctx
            :av
            :avF
            :argNid
            pid: posParamId
            paramTake: ptr.pTake
        )
        if vbhm.length > 0 then {
            stateFacts :facts from: pathFacts
            args.append vbhm
            return
        }
    }
    stateFacts :facts from: avF
    args.append av
}

# emitInstanceMethodBody -- the call text for a resolved user-object method:
# the receiver in the slot its definition names, then one argument per declared
# parameter, each passed the way that parameter is declared to take it.
emitInstanceMethodBody: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    mco: ztypes.tid
    recvExpr: StringView
    recvF: cfacts
    # whether recvExpr is ALREADY a C pointer, so the receiver slot takes it as
    # it stands rather than through emitByrefArgWith. The two call forms read this
    # from different places -- a dotted base from the path it was reached by, a
    # receiver passed as an argument from the expression it was written as -- so
    # the caller answers it and this stays one emission for both
    recvIsPtr: bool
    # where the positional cursor starts for the NON-receiver parameters. A
    # dotted receiver consumes no argument and leaves it at 0; a receiver
    # supplied as the call's one unlabelled argument has already taken slot 0
    posStart: u64
    facts: cfacts.borrow
} out String is {
    pids: ListVal ztypes.tid
    pidsNm: ListVal zast.nameid
    recFieldIds :reg :typing tid: mco ids: pids nameIds: pidsNm
    # The receiver slot is identified by the method's receiver param name
    # (`this` for the `:this` shorthand, or the spelled name for a
    # `b: this.borrow` receiver) -- matching how the definition site names
    # it. Matching the literal "this" alone drops a renamed receiver.
    recvNm: reg.thisParamNameIdOf tid: mco
    if recvNm.isZero then recvNm = zast.wellKnown.slot.wkThis
    pn: pidsNm.length
    # where each parameter's argument is written, and the positional cursor it
    # is read with: the arguments are built in the order they are written
    wbase: ctx.orderWrit.length
    (
        methodArgPositions
        :ast
        :call
        :pidsNm
        :recvNm
        :posStart
        writ: ctx.orderWrit
        posAt: ctx.orderPosAt
    )
    for ctx.orderDone.length < (wbase + pn) loop ctx.orderDone.append false
    ord: orderBegin :ctx slots: pn
    k: u64
    pi: u64
    for k < pn loop {
        pi = orderNextParam :ctx base: wbase
        k = k + 1
        isR: (pidsNm.get i: pi) == recvNm
        (
            orderMethodParam
            :ast
            :reg
            :typing
            :ctx
            :call
            :mco
            pname: (pidsNm.get i: pi)
            pid: (pids.get i: pi)
            isRecv: isR
            :recvExpr
            :recvF
            :recvIsPtr
            posIdx: (ctx.orderPosAt.get i: wbase + pi)
            written: (ctx.orderWrit.get i: wbase + pi)
            slot: pi
            :ord
        )
    }
    orderDropPositions :ctx base: wbase
    oprefix: orderFinish :ctx st: ord
    args: orderJoinSlots :ctx st: ord count: pn
    orderEnd :ctx st: ord
    noteFnUse :ctx tid: mco
    return (stating :facts from: callFacts text: (
        orderClose
        prefix: oprefix
        callee: (ctxCnameView :ctx tid: mco)
        args: args.stringView
    )
    )
}

# methodArgPositions -- for each declared parameter of a method, where its
# argument is written (from 1, 0 for none -- the receiver's) and the positional
# cursor its value is read with, walking the parameters as the value lookup does.
methodArgPositions: function {
    ast: Ast.view
    call: zast.callrow.view
    pidsNm: (ListVal zast.nameid).view
    # the receiver parameter's name
    # the receiver parameter's name, which no argument fills
    recvNm: zast.nameid
    posStart: u64
    writ: ListVal u64
    posAt: ListVal u64
} is {
    positionalIdx: posStart
    for each pnB: pidsNm loop {
        posAt.append positionalIdx
        if pnB == recvNm then {
            writ.append 0
        } else {
            ca: ctorArgFor :ast :call label: pnB posIdx: positionalIdx
            writ.append (writtenArgPosition :ast :call nid: ca.nid)
            if ca.labelled.not then positionalIdx = positionalIdx + 1
        }
    }
}

# orderMethodParam -- one declared parameter of a method call, its argument
# built in evaluation order into the parameter's slot: the receiver as the
# receiver slot takes it, anything else as instanceMethodArg passes it.
orderMethodParam: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    mco: ztypes.tid
    pname: zast.nameid
    pid: ztypes.tid
    isRecv: bool
    recvExpr: StringView
    recvF: cfacts
    recvIsPtr: bool
    # the positional cursor the parameter's value is read with
    posIdx: u64
    # where its argument is written, from 1; 0 for none
    written: u64
    slot: u64
    ord: orderstate.borrow
} is {
    mk: pendingHoistMark :ctx
    one: String
    oneF: cfacts
    constant: true
    if isRecv then {
        if recvIsPtr then {
            one.append recvExpr
            stateFacts facts: oneF from: recvF
        } else {
            # same rule as the auto-call base: a receiver that IS a call has no
            # address, so emitByrefArgWith hoists it into a temp -- the checker's
            # temp for the receiver node, freed when the checker says it owns
            one.append (
                emitByrefArgWith
                :ast
                :reg
                :typing
                :ctx
                av: recvExpr
                avF: recvF
                :pid
                argNid: (dottedParentNodeId n: (ast.nodes.get i: call.callable))
                facts: oneF
            )
        }
    } else if written == 0 when (typing.declHasDefaultId parentTypeId: mco nameId: pname) then {
        # a parameter the call leaves out is its declared default
        one.append (paramDefaultText :ast :reg :typing :ctx cco: mco nameId: pname :pid facts: oneF)
    } else {
        (
            instanceMethodArg
            :ast
            :reg
            :typing
            :ctx
            :call
            :mco
            posParamNameId: pname
            posParamId: pid
            :posIdx
            args: one
            facts: oneF
        )
        if written > 0 then {
            constant = (
                orderConstantWith
                :ast
                :typing
                :ctx
                n: (ast.nodes.get i: (writtenArgNode :ast :call pos: written - 1))
                tf: oneF
                byPtr: ctx.lastArgByPtr
            )
        }
    }
    tf: oneF
    (
        orderPartWith
        :ast
        :reg
        :typing
        :ctx
        st: ord
        mark: mk
        text: one
        :tf
        :constant
        fid: mco
        :pid
        :pname
        ctype: ""
        :slot
    )
}

# writtenArgPosition -- where the argument whose value is node `nid` is written
# in the call, counted from 1; 0 when no argument is.
writtenArgPosition: function {ast: Ast.view call: zast.callrow.view nid: zast.nodeid} out u64 is {
    if nid.isZero then return 0
    w: u64
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation then {
            w = w + 1
            if a.operation == nid then return w
        }
    }
    return 0
}

# writtenArgNode -- the value node of the argument written at `pos` (from 0).
writtenArgNode: function {ast: Ast.view call: zast.callrow.view pos: u64} out zast.nodeid is {
    w: u64
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation then {
            if w == pos then return a.operation
            w = w + 1
        }
    }
    return zast.nodeid
}

# nextWrittenParam -- the parameter not yet built whose argument is written
# first; one with no written argument (the receiver, a default) comes before
# them, since nothing is evaluated for it.
nextWrittenParam: function {
    writ: (ListVal u64).view done: (ListVal bool).view base: u64
} out u64 is {
    n: writ.length - base
    best: n
    bestW: u64
    i: u64
    for i < n loop {
        if (done.get i: base + i).not then {
            w: writ.get i: base + i
            if (best == n) or (w < bestW) then {
                best = i
                bestW = w
            }
        }
        i = i + 1
    }
    return best
}


# wordOperatorRowBinds -- whether a WORD-named one-argument member (`bool.or`)
# is an operator in call form: it resolves to a NATIVE method whose row
# binds the operator holes. THE ROW IS THE AUTHORITY -- a bodyless row
# (`optionval.or`) or a user method with a word name is not an operator.
wordOperatorRowBinds: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    method: ztypes.tid
    owner: ztypes.tid
    mnId: zast.nameid
} out bool is {
    if (reg.isNativeOf tid: method).not then return false
    row: ctx.rows.ofName n: (rowNameOfMember :reg :typing :ctx :owner name: mnId)
    if row == 0 then return false
    return (rtHas :ctx id: (rowBody :ctx :row) slot: rtHole.slot.holeL)
}

# opPairPartnerId -- the OTHER half of the comparison pair, 0 for any other
# operator. `==` and `!=` are ONE pair: a type that writes only one of them
# answers for both, through the derived-comparison leg that negates the one it
# has. Asked by NAME ID, never by spelling.
opPairPartnerId: function {nameId: zast.nameid} out zast.nameid is {
    if nameId == zast.wellKnown.slot.wkOpEq then return zast.wellKnown.slot.wkOpNe
    if nameId == zast.wellKnown.slot.wkOpNe then return zast.wellKnown.slot.wkOpEq
    return zast.nameid
}

# derivedComparisonHere -- `mnId` is one half of the comparison pair and `owner`
# DECLARES the other half, so this operator is that one negated. No lookup past
# `owner` may answer for it: a typedef base's raw comparison would silently
# replace the equality the author defined.
derivedComparisonHere: function {
    typing: ztyping.ZTyping.view
    owner: ztypes.tid
    mnId: zast.nameid
} out bool is {
    partnerId: opPairPartnerId nameId: mnId
    if partnerId.isZero then return false
    oo9: typing.declChildOfId parentTypeId: owner nameId: partnerId
    return oo9.some
}

# operatorReceiverTid -- the type an operator call DISPATCHES on. Three rules,
# each one the checker also makes, so the emitter reaches the type the operator
# was resolved against: the receiver's own stamp; the MONO's where the call
# sits inside a template instance, because the flat stamp still names the type
# parameter and a parameter declares no operator; and the boxed ELEMENT where
# the receiver is a Box, which is a heap pointer around one valtype and
# declares no operators of its own.
operatorReceiverTid: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
} out ztypes.tid is {
    rt0: dottedReceiverStampId :ast :typing callable: (ast.nodes.get i: call.callable)
    rtc: chaseAggregateTypedef :reg :typing :ctx tid: rt0
    boxTid: rtc
    if (reg.isBoxOf tid: boxTid) when (reg.genericArgCount specId: boxTid) == 1 then {
        boxElem: reg.genericTypeArgAt specId: boxTid ordinal: 0
        if boxElem.notZero then rtc = boxElem
    }
    return rtc
}


# emitOperatorCallForm -- `a.+ rhs: b` through the same emitter the infix form
# uses. "" when this is not a one-argument operator call, which leaves the
# caller on its ordinary legs. Both forms hand on their operand nodes, because
# from here down they are one call. A word-named member (`a.or rhs: b`) is an operator call
# when it resolves to a NATIVE method whose row binds the operator
# holes -- the row is the authority, not the spelling.
emitOperatorCallForm: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    mnO: aliasChildName :ast :typing n: (ast.nodes.get i: call.callable)
    if mnO.length == 0 then return "".string
    if call.arguments.count.u64 != 1 then return "".string
    opNameId: aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable)
    owner: ztypes.tid
    method: ztypes.tid
    # THE CHECKER ALREADY RESOLVED THIS ONE. Re-deriving the receiver type, the
    # declaring type and the method from the decl tree for EVERY operator in the
    # program is what this path would otherwise cost, and it is millions of
    # allocations. The call path stamps the resolved declaration against the
    # callable, so read that, and derive only when it says nothing.
    {
        refDeclOpt: typing.refDecl.get key: call.callable
        if refDeclOpt.some then {
            rd9: typing.decls.get i: refDeclOpt
            # `==` and `!=` included: a pair operator's own half resolves to
            # the type that declares it, as any operator does, except that `==`
            # on a native container is declared by the TEMPLATE and the instance
            # is what has the C -- the generic test below sends that one on to
            # the derivation. A DERIVED `!=` is taken too: the checker resolved
            # it to the `==` it negates, whose owner is the type that declares it.
            sameName: rd9.name == opNameId
            isPartner: (opPairPartnerId nameId: opNameId) == rd9.name
            if rd9.parent.notZero when sameName then {
                # a TEMPLATE's operator has no C: the instance the receiver
                # names does, and the derivation below reaches it. Nor has a
                # literal type's: the operation is the type the literal landed
                # in, which the checker stamped on the receiver
                pt9: (typing.decls.get i: rd9.parent).typeId
                if pt9.notZero when (reg.isGenericOf tid: pt9).not when (
                    isLiteralType
                    :reg
                    tid: pt9
                ).not then {
                    owner = pt9
                    method = rd9.typeId
                }
            } else if rd9.parent.notZero when isPartner then {
                # the checker resolved this half of the pair to the other half,
                # which it does only for a WRITTEN `==`: the owner is the type
                # that declares it and emitOperatorAt's derived leg negates. A
                # native's or a template's half is reached through its instance,
                # which the derivation below resolves.
                ownerTid: (typing.decls.get i: rd9.parent).typeId
                hasOwner: ownerTid.notZero
                if hasOwner when (reg.isGenericOf tid: ownerTid) then {
                    hasOwner = false
                }
                if hasOwner when (reg.isNativeOf tid: rd9.typeId) then hasOwner = false
                if hasOwner then owner = ownerTid
            }
        }
    }
    if owner.isZero then {
        owner = operatorReceiverTid :ast :reg :typing :ctx :call
        if owner.isZero then return "".string
        mo9: typing.declChildOfId parentTypeId: owner nameId: opNameId
        if mo9.some then {
            method = mo9
        }
    }
    # A TYPEDEF MEMBER THAT ISN'T ON THE WRAPPER DELEGATES TO THE BASE -- the
    # same chase checkDotted makes, so the emitter reaches what the checker
    # resolved. `declid` declares `==` and inherits `!=`, `<` and `>=` from
    # the u64 it wraps.
    if method.isZero then {
        # A DERIVED COMPARISON STOPS THE CHASE: `parity` calls 1 and 3 equal
        # and the u64 it wraps does not, so reading the base's raw comparison
        # would discard the equality the author defined.
        baseOwner: ztypes.tid
        if (derivedComparisonHere :typing :owner mnId: opNameId).not then {
            baseOwner = typing.typedefBaseTidOf tid: owner
        }
        if baseOwner.notZero then {
            mb9: typing.declChildOfId parentTypeId: baseOwner nameId: opNameId
            if mb9.some then {
                method = mb9
                owner = baseOwner
            }
        }
    }
    # A DERIVED COMPARISON HAS NO METHOD OF ITS OWN. `!=` on a type declaring
    # only `==` resolves no member here, and emitOperatorAt's derived leg is
    # what answers it -- that leg reads `call.isZero` explicitly. Every other
    # operator still needs a method before there is anything to emit.
    if method.isZero when (opPairPartnerId nameId: opNameId).isZero then return "".string
    if (ztypecheck.isOperatorName name: mnO).not when (
        wordOperatorRowBinds
        :reg
        :typing
        :ctx
        :method
        :owner
        mnId: opNameId
    ).not then return "".string
    lhsNid: zast.nodeid
    cb: ast.nodes.get i: call.callable
    if cb.dottedpath then lhsNid = cb.parent
    if lhsNid.isZero then return "".string
    rhsNid: zast.nodeid
    a0: ast.nodes.get i: (zast.kidAt kids: ast.kids span: call.arguments i: 0)
    if a0.namedoperation then rhsNid = a0.operation
    if rhsNid.isZero then return "".string
    opId: opNameId
    return (
        emitOperatorAt
        :ast
        :reg
        :typing
        :ctx
        lineno: call.lineno
        :opId
        :owner
        :method
        :lhsNid
        :rhsNid
        op: mnO
        :facts
    )
}

# emitSynthOperatorCallForm -- the call form of a SYNTHESISED operator.
#
# A synth `==`/`!=` is a real member with a real signature, which is what makes
# `a.== rhs: b` type-check at all -- but it has no BODY, and no C function is
# ever written for it. The structural comparison is emitted per TYPE
# (`<cname>_eq`) and reached through the structural `record.==` / `variant.==`
# rows, which only the operator emitter consults. Left to the ordinary by-decl
# leg, the call form emitted a call to a symbol nobody defines.
#
# A DECLARED operator is deliberately NOT routed here: it has a body, and the
# by-decl leg is what emits the call to it.
emitSynthOperatorCallForm: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    mnS: aliasChildName :ast :typing n: (ast.nodes.get i: call.callable)
    if mnS.length == 0 then return "".string
    if (ztypecheck.isOperatorName name: mnS).not then return "".string
    if call.arguments.count.u64 != 1 then return "".string
    rt0S: dottedReceiverStampId :ast :typing callable: (ast.nodes.get i: call.callable)
    rtcS: (
        typedefMethodOwner
        :reg
        :typing
        :ctx
        tid: rt0S
        mnId: (aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable))
    )
    ownerS: rtcS
    if ownerS.isZero then return "".string
    nidS: aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable)
    if nidS.isZero then return "".string
    if (
        typing.declMemberIsSynth
        parentTypeId: ownerS
        nameId: nidS
    ).not then return "".string
    return (emitOperatorCallForm :ast :reg :typing :ctx :call :facts)
}

# callableBoxElem -- boxMemberElem of a dotted callable: the element type a
# method called off a Box belongs to, 0 for any other callable.
callableBoxElem: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    callable: astnode.view
} out ztypes.tid is {
    match (
        callable
    ) case dottedpath then {
        return (boxMemberElem :ast :reg :typing n: callable)
    } else {
        return ztypes.tid.zero
    }
}

# emitInstanceMethodCall -- `recv.method args` on a user CLASS instance (not a
# Type qualifier, not a collection / system native): emit
# {methodCname}(&recv, posArgs) with the receiver mapped to the :this param and
# the explicit args reordered by the method's param labels. "" when the receiver
# is not a user class or the method is unresolved.
emitInstanceMethodCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    mn: aliasChildName :ast :typing n: (ast.nodes.get i: call.callable)
    if mn.length == 0 then return "".string
    callableNode: ast.nodes.get i: call.callable
    # THE RECEIVER IS EMITTED ONLY ONCE THIS LEG HAS COMMITTED. Emitting it to
    # decide whether to answer left the emission behind on every decline: an
    # orphaned hoist the C compiler warns about, and -- because the leg that
    # DID answer emitted it again -- a receiver expression EVALUATED TWICE.
    # `a.or rhs: b` with a call for a receiver called that call twice. What the
    # emission stood in for is the shape test below, which costs nothing.
    cbShape: ast.nodes.get i: call.callable
    if cbShape.dottedpath.not then return "".string
    # the other side of the same stamp: a receiver the checker said comes from
    # the arguments is not reached through the dot, whatever the base emits to
    if (typing.callBaseNamesType.has item: call.nodeid) then return "".string
    recvTid: dottedReceiverStampId :ast :typing callable: (ast.nodes.get i: call.callable)
    # a Box's methods are its element's, called through the cell: the box IS
    # the pointer to the element a method takes its receiver by
    bxEl: callableBoxElem :ast :reg :typing callable: callableNode
    if bxEl.notZero then recvTid = bxEl
    rtidc: (
        typedefMethodOwner
        :reg
        :typing
        :ctx
        tid: recvTid
        mnId: (aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable))
    )
    rtid: rtidc
    if rtid.isZero then return "".string
    # Both families reach here: a user record's methods take their receiver by
    # pointer too, so they need the same receiver-addressing logic below. The
    # stdlib units are still excluded further down -- they have dedicated
    # dispatchers.
    rttK: reg.typetypeOf typeId: rtid
    isUserObj: isUserStructType tt: rttK
    if isUserObj.not then return "".string
    monoOrigin: originTidOf :reg tid: rtid
    if monoOrigin.notZero when (
        isUserGenericMonoTid
        :reg
        :ctx
        tid: rtid
    ).not then return "".string
    mco: (
        typing.declChildOfId
        parentTypeId: rtid
        nameId: (aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable))
    )
    # a NATIVE member is the native dispatchers' to emit -- the String and
    # StringView emitters, the collection ones, a class's row -- and there is
    # no body here to call. The method's own nativeness decides, never the unit
    # that declares its receiver, so a user unit spelled `cli` or `os` keeps its
    # bodied methods.
    if mco.some when (reg.isNativeOf tid: mco) then return "".string
    if mco.some when (reg.typetypeOf typeId: mco) == ztypes.ztypetype.functionType then {
        mci: methodInstanceOf :reg :typing mid: mco callable: call.callable
        recvF: cfacts
        recvExpr: emitDottedReceiver :ast :reg :typing :ctx callable: callableNode facts: recvF
        if recvExpr.length == 0 then return "".string
        rIsPtr: dottedReceiverIsPtr :ast :reg :typing :ctx callable: callableNode
        if bxEl.notZero then {
            rIsPtr = true
            # a box a call hands back is owned by nothing else: bound to a
            # temp the scope frees, as a read off it is
            bxBase: zast.nodeid
            cbx: ast.nodes.get i: call.callable
            if cbx.dottedpath then bxBase = cbx.parent
            bxRh: (
                ownedReceiverHoist
                :ast
                :reg
                :typing
                :ctx
                exprF: recvF
                expr: recvExpr.stringView
                n: (ast.nodes.get i: bxBase)
            )
            if bxRh.length > 0 then {
                recvExpr = bxRh.take
                recvF = pathFacts
            }
        }
        return (
            emitInstanceMethodBody
            :ast
            :reg
            :typing
            :ctx
            :call
            mco: mci
            recvExpr: recvExpr.stringView
            :recvF
            recvIsPtr: rIsPtr
            posStart: 0
            :facts
        )
    }
    return "".string
}

# methodInstanceOf -- the method a call reaches: a method with type parameters
# of its own is a template, and the call reaches the instance the checker
# minted for it and stamped on the callee
methodInstanceOf: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    mid: ztypes.tid
    callable: zast.nodeid
} out ztypes.tid is {
    if (isGenericFnTid :reg tid: mid).not then return mid
    inst: stampIdOf :typing nid: callable
    if (reg.genericOriginOf tid: inst) == mid then return inst
    return mid
}

# collectionValueCallRhs -- the binding RHS is a value-producing expression
# returning a collection (a call to a user function/method, or a bare dotted-path
# no-arg method auto-call / field access), as opposed to a collection construction
# (`(List of: T)` / `(Set ...)` / `(Map ...)` calls, or a bare typedef-collection
# atom like `Bytes` / `ByteView`). A value call must be emitted as the call;
# constructions emit the binding's mono create. Used by the List/Set/Map binding
# branches to choose between emitting the RHS expression and an empty create.
# A construction is recognised by its stamped callKind, not the written head
# name, so a re-export alias of a container constructs like its target.
collectionValueCallRhs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case statementline then {
        return (collectionValueCallRhs :ast :reg :typing n: (ast.nodes.get i: n.statementline))
    } case dottedpath then {
        # a bare dotted path returning a collection (e.g. `st.allNames`) is a
        # no-arg method auto-call or field access -- a value, never a construction.
        atc: (
            zast.nameTextAt
            :ast
            ref: (aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child)
        )
        return atc.length > 0
    } case atomid then {
        # a bare name resolving to a VARIABLE is that container's value -- a
        # move -- and one naming a FUNCTION is the call it auto-makes. A bare
        # TYPE atom (`Bytes`, `ByteView`) is a construction, so the variable
        # stamp and the function name are what separate them.
        cav: typing.atomVariableId.get key: n.nodeid
        if cav.some then {
            return true
        }
        return (baseAtomNamesFunction :reg :typing n: (ast.nodes.get i: n.nodeid))
    } case call then {
        cko: typing.callKind.get key: n.nodeid
        if cko.some then {
            if cko == zast.callkind.classCreate then return false
            # a typedef construction FROM a value is that value, re-typed; only
            # the argument-less one (`b: Bytes`) builds an empty collection
            if cko == zast.callkind.typedefCreate then return n.arguments.count > 0
        }
        cn: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: (ast.nodes.get i: n.callable))
        if cn.length == 0 then {
            # a dotted-path method callable (e.g. `p.operationPaths lex: lx`)
            # returning a List is a value-producing call, not a construction --
            # emit the call rather than falling to the empty-collection default.
            dct: aliasChildName :ast :typing n: (ast.nodes.get i: n.callable)
            return dct.length > 0
        }
        return true
    } else {
        return false
    }
}

# refPtrC -- the C spelling of a reference a function hands back, or of the
# local that binds one: a pointer to `base`, `const` when the callee's result
# is a `.view`, which is read through and never written through.
refPtrC: function {typing: ztyping.ZTyping.view tid: ztypes.tid base: StringView} out String is {
    if (typing.returnMarkerOf :tid) == ztypes.zparamownership.viewMode then return "const \{base}*"
    return "\{base}*"
}

# isColGetMutRef -- `fid` is a List/ListView mono's `getMut` whose element is a
# COMPOUND VALTYPE, i.e. the one case where emitColGet's generated `getMut`
# returns a pointer that `get` does not.
isColGetMutRef: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
} out bool is {
    ownG: reg.ownerTidOf tid: fid
    if ownG.isZero then return false
    isLG: (isListOriginOf :reg :ctx tid: ownG) or (isListViewOriginOf :reg :ctx tid: ownG)
    if isLG.not then return false
    if (
        (typing.declNameOf declId: (ztypecheck.templateDeclOf :reg :typing tid: fid)) !=
        zast.wellKnown.slot.wkGetMut
    ) then return false
    eG: listElemType :reg :typing monoId: ownG
    if (elemBorrowsByPtr :reg :typing :ctx tid: eG) then return false
    return (elemRefByPtr :reg :typing :ctx tid: eG)
}

# returnsValueStructRef -- a user function's `.borrow` return of a String or a
# List-family container: types held BY VALUE whose struct is only a header over
# a buffer. A copy of the header shares the buffer until a write through it
# reallocates, and a List header copy never sees the appends made through it,
# so the reference is a pointer. A `.view` return is only read through, and its
# copy stays a valid window for as long as the checker pins the source.
returnsValueStructRef: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    fid: ztypes.tid
    retTid: ztypes.tid
} out bool is {
    if (typing.returnMarkerOf tid: fid) == ztypes.zparamownership.viewMode then return false
    return (isValueStructTid :reg :typing :ctx tid: retTid)
}

# isValueStructTid -- a String, or a List-family container: a by-value header
# over a buffer.
isValueStructTid: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx.view tid: ztypes.tid
} out bool is {
    if tid.isZero then return false
    if (chaseStrTypedef :typing :ctx :tid) == ctx.strTid then return true
    cm: chaseAggregateTypedef :reg :typing :ctx :tid
    if (isListOriginOf :reg :ctx tid: cm) then return true
    return (isIdCollectionOriginOf :reg :ctx tid: cm)
}

# fnReturnsRefBorrow -- the function hands back a REFERENCE to a user reftype:
# its declared return carries `.borrow`/`.view` and names a reftype. Such a
# return is a `T*` in C -- returning the struct by value hands the caller a COPY,
# so a write through it is silently lost.
#
# Natives are excluded deliberately. `String` is a reftype and `is native`
# (lib/system/system.z:590), and `out String.borrow` already works: the struct
# copy shares the buffer and the borrow legs suppress the free. Natives hand back
# interior pointers by their own rules -- `List.get`'s `_r.data = &...` -- so
# starring them would ripple through every caller for no correctness gain.
# `retTid` is the caller's already-resolved return type: the registry's
# returnTypeOf is 0 for a user method, so both signature emitters fall back to
fnReturnsRefBorrow: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
    retTid: ztypes.tid
} out bool is {
    if fid.isZero then return false
    if retTid.isZero then return false
    if (typing.returnsReference tid: fid).not then return false
    # A container's `getMut` is native BY DECLARATION but its C is generated
    # HERE (emitColGet), not hand-written, so the exclusion below does not
    # reach it: for a compound valtype element it really does return a pointer
    # into the storage, and binding that by value is the write loss `getMut`
    # exists to prevent.
    if (isColGetMutRef :reg :typing :ctx :fid) then return true
    # a templated class's method answering a reference returns a pointer into
    # what the class holds: its template writes it so (a guard's `value`)
    if (tmplRowOfClass :ctx cls: (fnDeclScopeTid :reg :typing :fid)) > 0 then return true
    # a NATIVE callee's ABI is fixed by its hand-written `.inc` fragment, which
    # returns its struct by value (`List.iterate` -> ListIter). This emitter only
    # rewrites the bodies it generates itself.
    if (reg.isNativeOf tid: fid) then return false
    if (returnsValueStructRef :reg :typing :ctx :fid :retTid) then return true
    # String/StringView and the collections are reftypes with hand-written C and
    # their own borrow legs; `isStringyTid` is asked rather than isNativeOf
    # because a String return arrives as a TYPEDEF id whose isNative is unset.
    if (isStringyTid :ctx tid: retTid) then return false
    if (isHeapPtrCollection :reg :typing :ctx tid: retTid) then return false
    if (isCollectionOriginTid :ctx originTid: (originTidOf :reg tid: retTid)) then return false
    if (reg.isNativeOf tid: retTid) then return false
    # The question is the C ABI, NOT the ownership family: a CLASS and an owning
    # UNION are passed and returned by reference, a protocol and a view union
    # by value. `isReftypeParam` is the emitter's answer to exactly this and is
    # what the param side uses.
    return (isReftypeParam :reg :typing :ctx tid: retTid)
}

# callRhsIsBorrow -- a call whose result is a reference: the callee's
# declared return carries the `.borrow` marker (funcReturnMarker, recorded
# from the signature). Dotted method calls whose callable stamp missed probe
# the receiver mono's method child -- fully signature-driven (List/ListView
# element gets arrive here through their declared `out of.borrow`).
callRhsIsBorrow: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    call: zast.callrow.view
} out bool is {
    cstid: stampIdOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: call.callable))
    if (typing.returnsReference tid: cstid) then return true
    # a bare callee's own declaration (refDecl), when its stamp missed
    cnid: interpPartNodeId n: (ast.nodes.get i: call.callable)
    crd: (typing.refDecl.get key: cnid).or d: ztypes.declid
    if crd.notZero when (
        typing.returnsReference
        tid: (typing.declTypeOf declId: crd)
    ) then return true
    chId: aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable)
    if chId.isZero then return false
    rid: dottedReceiverStampId :ast :typing callable: (ast.nodes.get i: call.callable)
    ridT: rid
    rid = typedefMethodOwner :reg :typing :ctx tid: ridT mnId: chId
    mfid: (
        (typing.declChildOfId parentTypeId: rid nameId: chId).or
        d: ztypes.tid.zero
    )
    return (typing.returnsReference tid: mfid)
}

# isSvAsStringNode -- the node is `sv.asString` on a StringView-typed base:
# the result is a `const String*` cast of the view's address, so a binding or
# hoist of it is a POINTER local (a 24-byte value copy would read `capacity`
# past the end of the view).
isSvAsStringNode: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case dottedpath then {
        cnId: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        if cnId != zast.wellKnown.slot.wkAsString then return false
        bnidA: interpPartNodeId n: (ast.nodes.get i: n.parent)
        btA: chaseStrTypedef :typing :ctx tid: (stampIdOf :typing nid: bnidA)
        return btA == ctx.svTid
    } else {
        return false
    }
}

# svBaseExprOfAsString -- the rendered VIEW expression under `sv.asString`
# (the container probes pass the view itself, never a materialised String).
svBaseExprOfAsString: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out String is {
    match (
        n
    ) case dottedpath then {
        return (emitExpr :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent))
    } else {
        return "".string
    }
}

# colArgAsStringViewExpr -- when the labelled argument is `sv.asString`, the
# rendered view expression for the C `_getv`/`_hasv`/`_deletev` probe; "".
colArgAsStringViewExpr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    label: zast.nameid
} out String is {
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation when a.name == label then {
            opn: ast.nodes.get i: a.operation
            if (isSvAsStringNode :ast :typing :ctx n: opn) then {
                return (svBaseExprOfAsString :ast :reg :typing :ctx n: opn)
            }
            return "".string
        }
    }
    return "".string
}

# refBorrowCalleeFid -- the CALLEE behind a borrow-returning binding RHS, or 0.
# Only a declared `.borrow`/`.view` RETURN makes the binding a reference; a
# plain field read answers 0 and keeps its shallow-copy leg.
refBorrowCalleeFid: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    n: astnode.view
} out ztypes.tid is {
    match (
        n
    ) case statementline then {
        return (refBorrowCalleeFid :ast :reg :typing :ctx n: (ast.nodes.get i: n.statementline))
    } case call then {
        cid: stampIdOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: n.callable))
        if (typing.returnsReference tid: cid) then return cid
        ch8: aliasChildName :ast :typing n: (ast.nodes.get i: n.callable)
        if ch8.length == 0 then return ztypes.tid.zero
        recvTid: dottedReceiverStampId :ast :typing callable: (ast.nodes.get i: n.callable)
        recvTid = (
            typedefMethodOwner
            :reg
            :typing
            :ctx
            tid: recvTid
            mnId: (aliasChildNameId :ast :typing n: (ast.nodes.get i: n.callable))
        )
        mf8: (
            (
                typing.declChildOfId
                parentTypeId: recvTid
                nameId: (aliasChildNameId :ast :typing n: (ast.nodes.get i: n.callable))
            ).or
            d: ztypes.tid.zero
        )
        if (typing.returnsReference tid: mf8) then return mf8
        return ztypes.tid.zero
    } case dottedpath then {
        # a zero-arg method auto-call reads as a dotted path
        ch7: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        pt7: stampIdOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: n.parent))
        cc7: typing.declChildOfId parentTypeId: pt7 nameId: ch7
        match (
            cc7
        ) case some then {
            if (reg.typetypeOf typeId: cc7) == ztypes.ztypetype.functionType when (
                typing.returnsReference
                tid: cc7
            ) then return cc7
            return ztypes.tid.zero
        } case none then {
            return ztypes.tid.zero
        }
    } else {
        return ztypes.tid.zero
    }
}

# rhsBorrowMarkerBase -- the binding RHS is `<path>.borrow` over a reftype
# VALUE: the node of the path under the marker, 0 otherwise. A protocol or
# facet `.borrow` is a projection call and answers 0 (its stamp is not the
# base's).
rhsBorrowMarkerBase: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out zast.nodeid is {
    match (
        n
    ) case dottedpath then {
        if (
            (aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child) !=
            zast.wellKnown.slot.wkBorrow
        ) then return zast.nodeid
        pidB: interpPartNodeId n: (ast.nodes.get i: n.parent)
        bst: stampIdOf :typing nid: pidB
        if bst.isZero then return zast.nodeid
        if (reg.isReftypeOf tid: bst).not then return zast.nodeid
        if (stampIdOf :typing nid: n.nodeid) != bst then return zast.nodeid
        return n.parent
    } else {
        return zast.nodeid
    }
}

# aliasbase -- the node a borrowing binding is a second name for, and whether
# that node names a PLACE (storage whose own pointer type the alias must take).
aliasbase: record {
    node: zast.nodeid
    place: bool
}

# aliasBaseOf -- which node's storage this binding aliases, 0 for none. Four
# shapes name one and they are asked in this order: a `.borrow` marker (the path
# UNDER it), a borrow-returning element get, a member read off a value, and a
# bare name the CHECKER made a borrow. The last two are PLACES -- the binding is
# a second name for storage that already exists, and the alias takes its pointer
# type from that storage. The bare-name rule is the checker's and is read off the
# binding's own variable, never re-derived here, so the two halves cannot
# disagree about what a binding is.
aliasBaseOf: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.assignmentrow.view
    avn: astnode.view
} out aliasbase is {
    bmb: rhsBorrowMarkerBase :ast :reg :typing n: avn
    if bmb.notZero then return (aliasbase node: bmb place: false)
    tbs: typedefBorrowSource :ast :typing n: avn
    if tbs.notZero then return (aliasbase node: tbs place: true)
    if (rhsIsBorrowGet :ast :reg :typing :ctx n: avn) then {
        return (aliasbase node: n.value place: false)
    }
    if (rhsIsBorrowedFieldRead :ast :reg :typing :ctx abind: n n: avn) then {
        return (aliasbase node: n.value place: true)
    }
    vsr: valueStructRefNode :ast :reg :typing :ctx n: avn
    if vsr.notZero then return (aliasbase node: vsr place: false)
    if (tmplRefResult :ast :reg :typing :ctx n: avn) then return (
        aliasbase
        node: n.value
        place: false
    )
    if (nodeIsBareAtom n: avn) when (bindingVarIsBorrowed :reg :typing :n) then {
        return (aliasbase node: n.value place: true)
    }
    return (aliasbase node: zast.nodeid place: false)
}

# tmplRefResult -- the value is a templated class's method answering a
# reference (a guard's `value`): its C is a pointer the expression reads
# through, so a binding of it is a second name for what it points at
tmplRefResult: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out bool is {
    fid: refBorrowCalleeFid :ast :reg :typing :ctx :n
    if fid.isZero then return false
    if (tmplRowOfClass :ctx cls: (fnDeclScopeTid :reg :typing :fid)) == 0 then return false
    return (nodeIsRefBorrowResult :ast :reg :typing :ctx :n)
}

# typedefBorrowSource -- the source node of a borrowed typedef (`Bytes xs.borrow`,
# `Bytes.create from: xs.borrow`), the path under its `.borrow`; 0 for any other
# value.
# The binding is a second name for that source.
typedefBorrowSource: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out zast.nodeid is {
    match (
        n
    ) case statementline then {
        return (typedefBorrowSource :ast :typing n: (ast.nodes.get i: n.statementline))
    } case call then {
        ck: typing.callKind.get key: n.nodeid
        if ck.none then return zast.nodeid
        if ck != zast.callkind.typedefBorrow then return zast.nodeid
        return (underBorrowMarker :ast :typing nid: (castSourceArg :ast call: n))
    } else {
        return zast.nodeid
    }
}

# castSourceArg -- the value a cast is built from: its `from:` argument, or its
# one unlabelled argument; 0 when it has neither.
castSourceArg: function {ast: Ast.view call: zast.callrow.view} out zast.nodeid is {
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation when (
            a.name.isZero or (a.name == zast.wellKnown.slot.wkFrom)
        ) then return a.operation
    }
    return zast.nodeid
}

# underBorrowMarker -- the path a `.borrow` marker is written on (`xs` of
# `xs.borrow`), else the node itself.
underBorrowMarker: function {
    ast: Ast.view typing: ztyping.ZTyping.view nid: zast.nodeid
} out zast.nodeid is {
    if nid.isZero then return zast.nodeid
    src: ast.nodes.get i: nid
    if src.dottedpath.not then return nid
    if (
        (aliasOrChildId :ast :typing aliasId: src.nodeid childId: src.child) !=
        zast.wellKnown.slot.wkBorrow
    ) then return nid
    return src.parent
}

# valueStructRefNode -- the node of a value that calls a user function
# returning a String or List-family reference (returnsValueStructRef), looked
# for through a statement line; 0 for any other value. emitExpr spells such a
# call LOADED (loadValueStructRef): an lvalue of the struct, like an alias
# projection, so a receiver takes its address, a read copies its header and a
# binding is a second name for the storage the callee hands back.
valueStructRefNode: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out zast.nodeid is {
    match (
        n
    ) case statementline then {
        return (valueStructRefNode :ast :reg :typing :ctx n: (ast.nodes.get i: n.statementline))
    } case call then null case dottedpath then null else {
        return zast.nodeid
    }
    # the result's type first: it is one stamp read, and most calls fail it
    rt: stampIdOf :typing nid: (interpPartNodeId :n)
    if (isValueStructTid :reg :typing :ctx tid: rt).not then return zast.nodeid
    fid: refBorrowCalleeFid :ast :reg :typing :ctx :n
    if fid.isZero then return zast.nodeid
    # a native reference (`getMut`) keeps its own pointer spelling
    if (reg.isNativeOf tid: fid) then return zast.nodeid
    if (fnReturnsRefBorrow :reg :typing :ctx :fid retTid: rt).not then return zast.nodeid
    return (zast.nodeIdOf :n)
}

# emitBorrowAliasBind -- a borrowing binding of a BY-VALUE reftype -- a
# `.borrow` value, a borrowed element get, or a plain field read -- bound to a
# name: the name is a POINTER to the source, aliased to its deref so every use
# stays a value-shaped lvalue and a write through the name reaches the source.
# No destructor and no take-invalidation: the source owns the value, the
# container its element. A Set or a Map answers false -- its local already IS
# the pointer, so emitCollectionBind's copy of it is the reference already.
# Answers whether the binding was one.
emitBorrowAliasBind: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the binding
    n: zast.assignmentrow.view
    # the binding's C name
    nm: StringView
    # the binding's variable
    nameVid: ztypes.vid
    # the value's C type
    ct: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    avn: ast.nodes.get i: n.value
    ab: aliasBaseOf :ast :reg :typing :ctx :n :avn
    # the type questions come AFTER the shape one: a binding that borrows
    # nothing is the common case, and it leaves here without paying for them
    if ab.node.isZero then return false
    placeLeg: ab.place
    btid: bindChasedTid :reg :typing :ctx :n :avn
    # a Set and a Map live on the heap and their local IS the pointer, so the
    # pointer copy emitCollectionBind writes is the reference already
    if (isSetOriginOf :reg :ctx tid: btid) then return false
    if (isMapOriginOf :reg :ctx tid: btid) then return false
    # a VALTYPE place read is a real copy -- the binding is its own value, and
    # aliasing it would make a write through it reach the source
    if placeLeg when (reg.isReftypeOf tid: btid).not then return false
    base: ast.nodes.get i: ab.node
    hmk: pendingHoistMark :ctx
    rvmF: cfacts
    rvm: emitExprWith :ast :reg :typing :ctx n: base facts: rvmF
    # a member read that lowers to a CALL names no storage: a protocol or facet
    # field builds a fat pointer out of its base rather than reading a place, so
    # there is no address to alias and the binding owns what it gets. Only the
    # field leg can reach one -- the other two shapes are a marker on a value and
    # an element the container hands back by pointer, both already lvalues.
    if placeLeg when rvmF.place.not then {
        dropHoistsTo :ctx mark: hmk
        return false
    }
    flushArgHoists :ctx :ind :tmp :buf
    bct: ct.string
    if bct.length == 0 then bct = "int64_t".string
    # a base the C already holds through a pointer (a borrowed parameter, a
    # borrowed field) is the pointer itself
    addr: "&"
    if (pathIsPointer :ast :reg :typing :ctx n: base) then addr = ""
    # a binding that names a PLACE takes its pointer type from the storage
    # rather than from its declared type: a field or a name reached through a
    # `.view` root is `const` in the C (paramCType says so, so that a writer
    # through a view is refused), and the declared type does not carry that. The
    # marker and element shapes keep the declared type -- their bases are a
    # marker on a value and an element the container hands back, neither of
    # which a view qualifies.
    if placeLeg then {
        preludeNeed :ctx memb: "@typeof"
        lbF: "\{ind}Z_TYPEOF(\{addr}\{rvm}) __borrow_\{nm} = \{addr}\{rvm};\n"
        buf.append lbF
    } else {
        lb0: "\{ind}\{bct}* __borrow_\{nm} = \{addr}\{rvm};\n"
        buf.append lb0
    }
    lb1: "\{ind}/* alias: \{nm} => (*__borrow_\{nm}) */\n"
    buf.append lb1
    bindBorrowAlias :ctx vid: nameVid :nm
    return true
}

# rhsIsBorrowGet -- the binding RHS is a List/ListView `get` or `getMut` lowered
# by pointer, so the local must ALIAS the element storage rather than snapshot
# it. Shares callRhsIsBorrow's receiver derivation, so the receiver text cannot
# diverge.
rhsIsBorrowGet: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out bool is {
    match (
        n
    ) case statementline then {
        return (rhsIsBorrowGet :ast :reg :typing :ctx n: (ast.nodes.get i: n.statementline))
    } case call then {
        cbl: ast.nodes.get i: n.callable
        chId: aliasChildNameId :ast :typing n: cbl
        isMut: chId == zast.wellKnown.slot.wkGetMut
        if isMut.not when (chId == zast.wellKnown.slot.wkGet).not then return false
        rst: dottedReceiverStampId :ast :typing callable: cbl
        bt: chaseAggregateTypedef :reg :typing :ctx tid: rst
        isC: (isListOriginOf :reg :ctx tid: bt) or (isListViewOriginOf :reg :ctx tid: bt)
        if isC.not then return false
        if isMut then {
            return (elemRefByPtr :reg :typing :ctx tid: (listElemType :reg :typing monoId: bt))
        }
        return (listGetIsPtr :reg :typing :ctx monoId: bt)
    } else {
        return false
    }
}

# bindChasedTid -- the type a binding holds, collection typedefs chased (Bytes
# reads as its ListVal): the statement's own stamp, or the value's when the
# statement carries none. Every leg that asks what storage class a binding is
# asks here, so the three cannot drift apart.
bindChasedTid: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    n: zast.assignmentrow.view
    avn: astnode.view
} out ztypes.tid is {
    bt: stampIdOf :typing nid: n.nodeid
    if bt.isZero then bt = stampIdOf :typing nid: (interpPartNodeId n: avn)
    return (chaseAggregateTypedef :reg :typing :ctx tid: bt)
}

# pathRootsAtVariable -- the dotted path bottoms out in a name that resolves to
# a VARIABLE, so every step of it names storage whose address the C can take. A
# type name (`Value.nul` constructs), a unit constant, a literal and a call all
# answer false: what each yields is a value with no place of its own, and the
# binding owns it rather than aliasing it.
pathRootsAtVariable: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case atomid then {
        return (atomVid :typing nid: n.nodeid).notZero
    } case labelvalue then {
        return (atomVid :typing nid: n.nodeid).notZero
    } case dottedpath then {
        return (pathRootsAtVariable :ast :typing n: (ast.nodes.get i: n.parent))
    } else {
        return false
    }
}

# varOwnsHere -- the checker made `vid` a variable that OWNS what it holds, so
# the binding of it registers a cleanup and the value moves into it. The
# inverse of `bindingVarIsBorrowed`, for the legs that hold the variable
# rather than the binding row it came from.
varOwnsHere: function {reg: ztypes.ZTypeRegistry.view vid: ztypes.vid} out bool is {
    if vid.isZero then return false
    return (reg.variableOwnershipOf id: vid) == ztypes.zownership.owned
}

# bindingVarIsBorrowed -- the CHECKER made this binding a borrow. Read off the
# binding's own variable, which is where the rule was decided: a bare name, a
# field read and a marker all land here, and none of them is re-judged.
bindingVarIsBorrowed: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    n: zast.assignmentrow.view
} out bool is {
    bv: defVid :typing nid: n.nodeid
    if bv.isZero then return false
    return (reg.variableOwnershipOf id: bv) == ztypes.zownership.borrowed
}

# rhsIsBorrowedFieldRead -- the binding RHS is a plain member READ off a value
# (`h.items`): the storage belongs to the base, so the binding is a second name
# for it and must alias rather than snapshot it -- a snapshot of a reftype
# shares the source's buffer and both grow and free it independently. A zero-arg
# method auto-call reads as a dotted path too and answers FALSE: it returns a
# value of its own. The borrow decision is the CHECKER's, read off the binding's
# own VARIABLE like the bare-name shape beside it, so the two cannot disagree.
# A borrowed field the C holds by pointer is aliased whatever it is read off --
# a call's result included: the binding is a second name for what it points at.
rhsIsBorrowedFieldRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the binding, whose variable says whether it borrows
    abind: zast.assignmentrow.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case statementline then {
        sfr: ast.nodes.get i: n.statementline
        return (rhsIsBorrowedFieldRead :ast :reg :typing :ctx :abind n: sfr)
    } case dottedpath then {
        dn: ast.nodes.get i: n.nodeid
        rtn: ast.nodes.get i: n.parent
        if (pathRootsAtVariable :ast :typing n: rtn).not when (
            borrowedPointerField
            :ast
            :reg
            :typing
            :ctx
            :n
        ).not then return false
        if (bindingVarIsBorrowed :reg :typing n: abind).not then return false
        fpid: interpPartNodeId n: (ast.nodes.get i: n.parent)
        fco: (
            typing.declChildOfId
            parentTypeId: (stampIdOf :typing nid: fpid)
            nameId: (aliasChildNameId :ast :typing n: dn)
        )
        match (
            fco
        ) case some then {
            return (reg.typetypeOf typeId: fco) != ztypes.ztypetype.functionType
        } case none then {
            return false
        }
    } else {
        return false
    }
}

# emitStrConvCall -- the `.str` sized-conversion method on a String / StringView
# / str parent: `<parent>.str to: N` -> z_String_to_<name>(data, len). "" when
# not a .str-to-str conversion. The capacity rides the result mono type.
emitStrConvCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    mnId: aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable)
    if mnId != zast.wellKnown.slot.tyStr then return "".string
    callTid: stampIdOf :typing nid: call.nodeid
    rid: chaseAggregateTypedef :reg :typing :ctx tid: callTid
    if (
        originIsTid
        :reg
        tid: rid
        originTid: (ctx.origins.get i: family.slot.str)
    ).not then return "".string
    rnm: cbaseNoPrefix :ctx tid: rid
    pvF: cfacts
    pv: (
        emitDottedReceiver
        :ast
        :reg
        :typing
        :ctx
        callable: (ast.nodes.get i: call.callable)
        facts: pvF
    )
    ptid: dottedReceiverStampId :ast :typing callable: (ast.nodes.get i: call.callable)
    # the receiver is read twice, for data and length. An owned String call is
    # bound to a temp the statement flush frees, a view call to a plain one
    if ptid == ctx.strTid when pvF.place.not then {
        sh: (
            hoistBorrowValArgWith
            :ast
            :reg
            :typing
            :ctx
            argNid: (dottedParentNodeId n: (ast.nodes.get i: call.callable))
            av: pv.stringView
            avF: pvF
            pid: ptid
            paramTake: false
        )
        if sh.length > 0 then {
            pv = sh.copy
            pvF = pathFacts
        }
    }
    if ptid == ctx.svTid when pvF.once then {
        # a view, bound so the call runs once; there is nothing to free
        pv = hoistForAddress :ast :reg :typing :ctx av: pv.stringView tid: ptid argNid: zast.nodeid
    }
    lenAcc: "len".string
    if ptid == ctx.strTid then lenAcc = "size".string
    if ptid == ctx.svTid then lenAcc = "size".string
    noteMemberUse :ctx mono: rid member: memberWord.slot.toStr
    return (
        stating
        :facts
        from: callFacts
        text: "\{ctx.strC}_to_\{rnm}(\{pv}.data, \{pv}.\{lenAcc})"
    )
}

# allDigits -- true when s is non-empty and every byte is an ASCII digit 0-9.
# Distinguishes a numeric array index member (`a.0`) from a named member.
allDigits: function {s: StringView} out bool is {
    if s.length == 0 then return false
    i: u64
    n: s.length
    for i < n loop {
        bo: s.byteAt :i
        match (
            bo
        ) case some then {
            if bo < 48 then return false
            if bo > 57 then return false
        } case none then {
            return false
        }
        i = i + 1
    }
    return true
}

# emitBoxCreate -- `Box from: x`: heap-alloc a cell for the element and store x.
# Gated on the BOX_CREATE callKind stamp. The cell is assigned where the box is
# built, `(_BoxN = alloc, *_BoxN = x, _BoxN)`, so it runs in order with what is
# around it; the value is not an lvalue, so a parameter that only borrows it
# binds it to a temporary that releases the box, and a binding or a taking
# parameter owns it as any owned value.
emitBoxCreate: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    cko: typing.callKind.get key: call.nodeid
    isBoxC: false
    if cko.some when cko == zast.callkind.boxCreate then isBoxC = true
    if isBoxC.not then return "".string
    bmid: stampIdOf :typing nid: call.nodeid
    beid: reg.genericTypeArgAt specId: bmid ordinal: 0
    binner: typeRefC :ast :reg :typing :ctx tid: beid
    bval: ctorArgByLabel :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkFrom
    bN: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    bnm: "_Box\{bN}"
    # declared zero by the enclosing statement, assigned here; the box moves
    # into the value it builds, so it is no address hoist and owes no destroy
    ctx.argHoists.append (ArgHoist name: bnm.copy val: String ctype: "\{binner}*" dtor: String)
    preludeNeed :ctx memb: "@xmalloc"
    return (
        stating
        :facts
        from: callFacts
        text: "(\{bnm} = (\{binner}*)z_xmalloc(sizeof(\{binner})), *\{bnm} = \{bval}, \{bnm})"
    )
}

# emitEmptyColCreate -- an empty collection construction `(List of: T)` /
# `(Set of: T)` / `(Map ...)` as a value: emit the collection mono's create with
# capacity 0, resolved from the call-node stamp. "" when not such a construction.
emitEmptyColCreate: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    # a sized array or str: the callable's stamp is the instance, whatever
    # name -- the family's own or an alias of it -- spelled it
    {
        zmid0: (
            bindingStampOf
            :typing
            nid: (interpPartNodeId n: (ast.nodes.get i: call.callable))
        )
        zmid: chaseAggregateTypedef :reg :typing :ctx tid: zmid0
        zo: originTidOf :reg tid: zmid
        isSized: (
            (zo == (ctx.origins.get i: family.slot.fixedArray)) or
            (zo == (ctx.origins.get i: family.slot.str))
        )
        if isSized when zo.notZero then {
            zcb: spelledCname :ctx tid: zmid
            noteMemberUse :ctx mono: zmid member: memberWord.slot.create
            return (stating :facts from: callFacts text: "\{zcb}_create()")
        }
    }
    # the container leg is keyed on the stamped construction kind and the
    # mono's origin family, not the written head name, so a re-export alias
    # of a container constructs like its target.
    ckc: typing.callKind.get key: call.nodeid
    isCr: false
    if ckc.some when ckc == zast.callkind.classCreate then isCr = true
    if isCr.not then return "".string
    mid: stampIdOf :typing nid: call.nodeid
    mid = chaseAggregateTypedef :reg :typing :ctx tid: mid
    monoOrigin: originTidOf :reg tid: mid
    if monoOrigin.isZero then return "".string
    isCol: (
        (isListOriginOf :reg :ctx tid: mid) or
        (isSetOriginOf :reg :ctx tid: mid) or
        (isMapOriginOf :reg :ctx tid: mid) or
        (isIdCollectionOriginOf :reg :ctx tid: mid)
    )
    if isCol.not then return "".string
    cb: spelledCname :ctx tid: mid
    ccap: listCapArg :ast :reg :typing :ctx n: (ast.nodes.get i: call.nodeid)
    noteMemberUse :ctx mono: mid member: memberWord.slot.create
    return (stating :facts from: callFacts text: "\{cb}_create((uint64_t)\{ccap})")
}

# colRecvRef -- a collection (List) receiver as a C lvalue for a method call: a
# by-pointer List (a by-pointer param) is already a pointer and passes directly; a
# value List passes its address.
colRecvRef: function {ctx: Ctx.view bn: StringView vid: ztypes.vid} out String is {
    if (isPtrVid :ctx :vid) then return bn.string
    return "&\{bn}"
}

# emitCollectionMethodCall -- the collection method handlers behind ONE
# receiver computation: the receiver expression and its chased mono id are
# computed once, then the origin tid picks the array/List/Set/Map handler.
# "" when the receiver is not a collection mono (or the call is not dotted).
emitCollectionMethodCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    bnF: cfacts
    bn: (
        emitDottedReceiver
        :ast
        :reg
        :typing
        :ctx
        callable: (ast.nodes.get i: call.callable)
        facts: bnF
    )
    if bn.length == 0 then return "".string
    bvid: (
        atomVidIfPlain
        :ast
        :reg
        :typing
        :ctx
        n: (ast.nodes.get i: call.callable)
        text: bn.stringView
    )
    mnId: aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable)
    brid: dottedReceiverStampId :ast :typing callable: (ast.nodes.get i: call.callable)
    bt: chaseAggregateTypedef :reg :typing :ctx tid: brid
    # the leg is chosen by the receiver's FAMILY, the template its mono was
    # minted from compared by id, so a user type spelled like a container is
    # never dispatched as one.
    # every leg below passes the receiver BY ADDRESS (colRecvRef), and a
    # receiver that is itself a call has no address: `&f(x)` is not C. Bind it
    # once here, where the mono's type is in hand, so each leg addresses a place.
    # A compound literal is addressable, which is the carve-out
    # svRecvAddressable already draws; and a CONSTRUCTION used as a receiver is
    # built and bound by the leg below, so hoisting it here would construct a
    # second container and leak it.
    rcvIsCreate: false
    {
        recvCallKind: typing.callKind.get key: (
            dottedParentNodeId
            n: (ast.nodes.get i: call.callable)
        )
        if recvCallKind.some when recvCallKind == zast.callkind.classCreate then rcvIsCreate = true
    }
    # a reference-returning receiver (`getMut` over a compound element) is a
    # pointer into storage the container owns: bound first like any other call
    # receiver, so it still runs before the arguments, and addressed through
    # its deref
    recvNode: ast.nodes.get i: (dottedParentNodeId n: (ast.nodes.get i: call.callable))
    if (nodeIsRefBorrowResult :ast :reg :typing :ctx n: recvNode) then {
        bp9: (
            hoistForAddress
            :ast
            :reg
            :typing
            :ctx
            av: bn.stringView
            tid: bt
            argNid: zast.nodeid
            ptr: true
        )
        bn = "(*\{bp9})"
        bnF = derefFacts
    } else if recvNode.dottedpath when (borrowedFieldPath :ast :reg :typing :ctx n: recvNode) then {
        # a borrowed field (`c.l` on `l: (ListVal t: i64).borrow`) holds its
        # container by pointer and has no variable for colRecvRef to ask
        bn = "(*\{bn})"
        bnF = derefFacts
    }
    # the temp owns the receiver only when the call handed over a new value; an
    # element or other borrow still belongs to its container. A Set or a Map is
    # held as its pointer.
    if rcvIsCreate.not when (canTakeAddress f: bnF).not then {
        bh9: (
            hoistForAddress
            :ast
            :reg
            :typing
            :ctx
            av: bn.stringView
            tid: bt
            tag: (
                (typing.unnamedLocalOfNode.get key: (zast.nodeIdOf n: recvNode)).or
                d: zast.nameid.zero
            )
            argNid: (zast.nodeIdOf n: recvNode)
        )
        bn = bh9.copy
    }
    return (emitFamilyMethodCall :ast :reg :typing :ctx :call :mnId :bn :bt :bvid :facts)
}

# emitFamilyMethodCall -- a collection method call, dispatched on the receiver's
# FAMILY: the template its mono was minted from, compared by id, so a user type
# spelled like a container is never dispatched as one. "" when no family's leg
# answers.
emitFamilyMethodCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    mnId: zast.nameid
    bn: String
    bt: ztypes.tid
    bvid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    fam: monoFamilyOf :reg :ctx tid: bt
    isArr: fam == family.slot.fixedArray
    if isArr then return (
        emitArrayMethodCall
        :ast
        :reg
        :typing
        :ctx
        :call
        :mnId
        :bn
        :bt
        :bvid
        :facts
    )
    if (staticListValueFamilyOf :reg :ctx tid: bt).notZero then {
        return (emitStaticListValueMethodCall :ast :reg :typing :ctx :call :mnId :bn :bt :facts)
    }
    isSpan: fam == family.slot.spanVal
    if isSpan then return (
        emitSpanMethodCall
        :ast
        :reg
        :typing
        :ctx
        :call
        :mnId
        :bn
        :bt
        :bvid
        :facts
    )
    if fam == family.slot.listVal then {
        lend: emitListValLendCall :ast :reg :typing :ctx :call :mnId :bn :bt :bvid :facts
        if lend.length > 0 then return lend
    }
    isList: (
        (fam == family.slot.listRef) or
        (fam == family.slot.listVal) or
        (fam == family.slot.listView) or
        (fam == family.slot.listViewVal)
    )
    if isList then return (
        emitListMethodCall
        :ast
        :reg
        :typing
        :ctx
        :call
        :mnId
        :bn
        :bt
        :bvid
        :facts
    )
    isSet: (fam == family.slot.set) or (fam == family.slot.setVal)
    if isSet then return (emitSetMethodCall :ast :reg :typing :ctx :call :mnId :bn :bt :facts)
    if (isMapOriginOf :reg :ctx tid: bt) then return (
        emitMapMethodCall
        :ast
        :reg
        :typing
        :ctx
        :call
        :mnId
        :bn
        :bt
        :facts
    )
    isIdMap: (fam == family.slot.idMapR) or (fam == family.slot.idMapV)
    if isIdMap then return (
        emitIdMapMethodCall
        :ast
        :reg
        :typing
        :ctx
        :call
        :mnId
        :bn
        :bt
        :bvid
        :facts
    )
    isIdSet: fam == family.slot.idSet
    if isIdSet then return (
        emitIdSetMethodCall
        :ast
        :reg
        :typing
        :ctx
        :call
        :mnId
        :bn
        :bt
        :bvid
        :facts
    )
    return "".string
}

# emitListValLendCall -- the ListVal members that lend or resize its storage:
# `spanSlice`, a window over part of it, and `resize`. "" for any other member.
emitListValLendCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    mnId: zast.nameid
    bn: String
    bt: ztypes.tid
    bvid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    isResize: mnId == zast.wellKnown.slot.wkResize
    isSpanSlice: mnId == zast.wellKnown.slot.wkSpanSlice
    if isResize.not when isSpanSlice.not then return "".string
    cb: spelledCname :ctx tid: bt
    recvR: colRecvRef :ctx bn: bn.stringView vid: bvid
    if isResize then {
        vr: listArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkTo
        noteMemberUse :ctx mono: bt member: memberWord.slot.resize
        er: "\{cb}_resize(\{recvR}, \{vr})"
        return (stating :facts from: callFacts text: er)
    }
    recvT: "\{cb}_t*"
    demandMemberNeeds :reg :typing :ctx mono: bt :mnId
    return (stating :facts from: callFacts text: (
        emitWindowSlice
        :ast
        :reg
        :typing
        :ctx
        :call
        recvR: recvR.stringView
        recvT: recvT.stringView
        len: "@@R@@->length"
        what: "ListVal spanSlice"
        inline: false
    )
    )
}

# narrowListIndex -- a list answers an index as its u64 position; a list
# indexed by a narrower id space (`ListVal astnode i: nodeid`) gets it in that
# type, and a position past the type's range panics rather than wraps. The
# bound is the integer conversion's (convRangeCond).
narrowListIndex: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    pos: String.take
} out String is {
    idx: stampIdOf :typing nid: call.nodeid
    nk: (
        ztypecheck.numKindOfTid
        :typing
        tid: (ztypecheck.typedefChaseTid :typing tid: idx)
    )
    if nk.has.not then return pos
    dbits: ztypes.intKindBits k: nk.kind
    dsig: ztypes.isSignedIntKind k: nk.kind
    if dbits == 0 then return pos
    if (ztypes.convNeedsHi ssig: false :dsig sbits: 64 :dbits).not then return pos
    ct: typeRefC :ast :reg :typing :ctx tid: idx
    # the position is read for the bound test and then the conversion
    pre: String
    v: (
        orderOnePart
        :ast
        :reg
        :typing
        :ctx
        mark: (pendingHoistMark :ctx)
        text: pos
        tf: cfacts
        nid: zast.nodeid
        ctype: "uint64_t"
        constant: false
        twice: true
        prefix: pre
    )
    cond: (
        substituteAll
        text: (convRangeCond dstK: nk.kind needsLo: false needsHi: true)
        needle: "@V@"
        repl: v.stringView
    )
    preludeNeed :ctx memb: "@panic"
    pnc: "z_panic(\"List append: index past the range of the list's index type\")"
    r: "((\{cond}) ? \{pnc} : (void)0, (\{ct})\{v})"
    return (orderWrap prefix: pre call: r)
}

# emitListMethodCall -- a method call on a List-mono receiver. Maps the
# labeled arguments to the runtime method's positional C signature.
emitListMethodCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    mnId: zast.nameid
    bn: String
    bt: ztypes.tid
    bvid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    cb: spelledCname :ctx tid: bt
    recvR: colRecvRef :ctx bn: bn.stringView vid: bvid
    if mnId == zast.wellKnown.slot.wkAppend then {
        v: colArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkFrom consumes: true
        noteMemberUse :ctx mono: bt member: memberWord.slot.append
        e0: "\{cb}_append(\{recvR}, \{v})"
        return (
            stating
            :facts
            from: callFacts
            text: (narrowListIndex :ast :reg :typing :ctx :call pos: e0)
        )
    }
    if mnId == zast.wellKnown.slot.wkGet then {
        v: listArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkI
        noteMemberUse :ctx mono: bt member: memberWord.slot.getOne
        e1: "\{cb}_get(\{recvR}, \{v})"
        if (
            listGetIsPtr
            :reg
            :typing
            :ctx
            monoId: bt
        ) then return (stating :facts from: (operandFacts e: callFacts place: true) text: "(*\{e1})"
        )
        return (stating :facts from: callFacts text: e1)
    }
    if mnId == zast.wellKnown.slot.wkGetMut then {
        vm: listArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkI
        noteMemberUse :ctx mono: bt member: memberWord.slot.getMut
        e1m: "\{cb}_getMut(\{recvR}, \{vm})"
        if (listGetIsPtr :reg :typing :ctx monoId: bt) then return (
            stating
            :facts
            from: (operandFacts e: callFacts place: true)
            text: "(*\{e1m})"
        )
        return (stating :facts from: callFacts text: e1m)
    }
    if mnId == zast.wellKnown.slot.wkSlice then {
        return (stating :facts from: callFacts text: (
            emitOrderedPair
            :ast
            :reg
            :typing
            :ctx
            :call
            mono: bt
            cb: cb.stringView
            m: "slice"
            lead: recvR.stringView
            a: zast.wellKnown.slot.wkFrom
            aForm: argform.value
            b: zast.wellKnown.slot.wkTo
            bForm: argform.value
        )
        )
    }
    if mnId == zast.wellKnown.slot.wkExtendView then {
        vw9: listArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkFrom
        noteMemberUse :ctx mono: bt member: memberWord.slot.extendView
        e1e: "\{cb}_extendView(\{recvR}, \{vw9})"
        return (stating :facts from: callFacts text: e1e)
    }
    if mnId == zast.wellKnown.slot.wkSet then {
        return (stating :facts from: callFacts text: (
            emitOrderedPair
            :ast
            :reg
            :typing
            :ctx
            :call
            mono: bt
            cb: cb.stringView
            m: "set"
            lead: recvR.stringView
            a: zast.wellKnown.slot.wkI
            aForm: argform.value
            b: zast.wellKnown.slot.wkVal
            bForm: argform.moved
        )
        )
    }
    if mnId == zast.wellKnown.slot.wkPop then {
        noteMemberUse :ctx mono: bt member: memberWord.slot.pop
        e3: "\{cb}_pop(\{recvR})"
        return (stating :facts from: callFacts text: e3)
    }
    if mnId == zast.wellKnown.slot.wkInsert then {
        return (stating :facts from: callFacts text: (
            emitOrderedPair
            :ast
            :reg
            :typing
            :ctx
            :call
            mono: bt
            cb: cb.stringView
            m: "insert"
            lead: recvR.stringView
            a: zast.wellKnown.slot.wkFrom
            aForm: argform.moved
            b: zast.wellKnown.slot.wkAt
            bForm: argform.value
        )
        )
    }
    if mnId == zast.wellKnown.slot.wkExtend then {
        eaa: listTakeArgBase :ast :call label: zast.wellKnown.slot.wkFrom
        eaV: atomVid :typing nid: (listTakeArgBaseNid :ast :call label: zast.wellKnown.slot.wkFrom)
        ea: emitLocalAtomName :ast :reg :ctx name: eaa vid: eaV
        noteMemberUse :ctx mono: bt member: memberWord.slot.extend
        e5: "\{cb}_extend(\{recvR}, &\{ea})"
        return (stating :facts from: callFacts text: e5)
    }
    if mnId == zast.wellKnown.slot.wkContains then {
        vc: containsNeedleC :ast :reg :typing :ctx :call
        noteMemberUse :ctx mono: bt member: memberWord.slot.contains
        e6: "\{cb}_contains(\{recvR}, \{vc})"
        return (stating :facts from: callFacts text: e6)
    }
    if mnId == zast.wellKnown.slot.wkSort then {
        noteMemberUse :ctx mono: bt member: memberWord.slot.sort
        e7: "\{cb}_sort(\{recvR})"
        return (stating :facts from: callFacts text: e7)
    }
    return "".string
}

# containsNeedleC -- the needle a list's `contains` takes by value: a String
# or a class held by pointer -- a parameter -- is read through it.
containsNeedleC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
} out String is {
    vc: colArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkItem consumes: false
    if (colArgHeldByPtr :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkItem
    ) then return "(*\{vc})"
    return vc
}

# colArgHeldByPtr -- the collection argument named `label` (or the first
# positional one) is a reference held by pointer, which colArg spells as the
# pointer itself; a valtype one colArg already reads through.
colArgHeldByPtr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    label: zast.nameid
} out bool is {
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation when (a.name == label) or a.name.isZero then {
            op: ast.nodes.get i: a.operation
            if (pathIsPointer :ast :reg :typing :ctx n: op).not then return false
            return (ptrHeldValtype :ast :reg :typing :ctx n: op).not
        }
    }
    return false
}

# emitArrayMethodCall -- `.get i:` / `.set i: item:` on a fixed-size array mono
# receiver (a value type). get takes the receiver by value; set by address (it
# returns the previous element). "" when the receiver isn't an array mono.
# The value label is `item`, not List's `val` -- the two handlers are otherwise
# identical here, and reading the wrong label silently stored a zero.
#
# THOSE ARE THE ONLY TWO. It carried a `getMut` leg for a member `array` does
# not declare and template `array` does not define, so the leg was unreachable
# AND would have called a C function nothing writes. `set` is the array's one
# writing member by design -- see its declaration.
emitArrayMethodCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    mnId: zast.nameid
    bn: String
    bt: ztypes.tid
    bvid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    cb: spelledCname :ctx tid: bt
    if mnId == zast.wellKnown.slot.wkGet then {
        vi: listArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkI
        noteMemberUse :ctx mono: bt member: memberWord.slot.getOne
        return (stating :facts from: callFacts text: "\{cb}_get(\{bn}, \{vi})")
    }
    if mnId == zast.wellKnown.slot.wkSet then {
        recvR: colRecvRef :ctx bn: bn.stringView vid: bvid
        return (stating :facts from: callFacts text: (
            emitOrderedPair
            :ast
            :reg
            :typing
            :ctx
            :call
            mono: bt
            cb: cb.stringView
            m: "set"
            lead: recvR.stringView
            a: zast.wellKnown.slot.wkI
            aForm: argform.value
            b: zast.wellKnown.slot.wkItem
            bForm: argform.value
        )
        )
    }
    isSlice: (mnId == zast.wellKnown.slot.wkSlice) or (mnId == zast.wellKnown.slot.wkSpanSlice)
    if isSlice then {
        recvA: colRecvRef :ctx bn: bn.stringView vid: bvid
        recvTa: "const \{cb}_t*"
        noteMemberUse :ctx mono: bt member: memberWord.slot.lengthOf
        lenA: "\{cb}_length"
        whatA: "array slice"
        if (
            mnId == zast.wellKnown.slot.wkSlice
        ) then whatA = "array slice" else whatA = "array spanSlice"
        demandMemberNeeds :reg :typing :ctx mono: bt :mnId
        return (stating :facts from: callFacts text: (
            emitWindowSlice
            :ast
            :reg
            :typing
            :ctx
            :call
            recvR: recvA.stringView
            recvT: recvTa.stringView
            len: lenA.stringView
            what: whatA
            inline: true
        )
        )
    }
    return "".string
}

# emitStaticListValueMethodCall -- `v.get i: k` on a list value: the mono's own
# bounds-checked reader, handed the view by value -- or, on a list reached by a
# compile-time path (`codes.get i: k`), its array's own reader,
# `_zag<row>_at`.
emitStaticListValueMethodCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    mnId: zast.nameid
    bn: String
    bt: ztypes.tid
    facts: cfacts.borrow
} out String is {
    if mnId != zast.wellKnown.slot.wkGet then return "".string
    vi: listArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkI
    row: u64
    {
        cn: ast.nodes.get i: call.callable
        if cn.dottedpath then row = (
            listRowOf
            :typing
            nid: (interpPartNodeId n: (ast.nodes.get i: cn.parent))
        )
    }
    if row != 0 then {
        noteAggReaderUse :ctx :row
        return (stating :facts from: callFacts text: "_zag\{row}_at(\{vi})")
    }
    cb: spelledCname :ctx tid: bt
    noteMemberUse :ctx mono: bt member: memberWord.slot.getOne
    return (stating :facts from: callFacts text: "\{cb}_index(\{bn}, \{vi})")
}

# emitSpanMethodCall -- a window's members that take arguments. get, set and
# slice are the mono's own functions; split and copyFrom are written here, at
# the call, since each builds or reads another type's value.
emitSpanMethodCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    mnId: zast.nameid
    bn: String
    bt: ztypes.tid
    bvid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    cb: spelledCname :ctx tid: bt
    recvR: colRecvRef :ctx bn: bn.stringView vid: bvid
    if mnId == zast.wellKnown.slot.wkGet then {
        v: listArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkI
        noteMemberUse :ctx mono: bt member: memberWord.slot.getOne
        e1: "\{cb}_get(\{recvR}, \{v})"
        if (
            listGetIsPtr
            :reg
            :typing
            :ctx
            monoId: bt
        ) then return (stating :facts from: (operandFacts e: callFacts place: true) text: "(*\{e1})"
        )
        return (stating :facts from: callFacts text: e1)
    }
    if mnId == zast.wellKnown.slot.wkSet then {
        return (stating :facts from: callFacts text: (
            emitOrderedPair
            :ast
            :reg
            :typing
            :ctx
            :call
            mono: bt
            cb: cb.stringView
            m: "set"
            lead: recvR.stringView
            a: zast.wellKnown.slot.wkI
            aForm: argform.value
            b: zast.wellKnown.slot.wkItem
            bForm: argform.value
        )
        )
    }
    if mnId == zast.wellKnown.slot.wkSlice then {
        return (stating :facts from: callFacts text: (
            emitOrderedPair
            :ast
            :reg
            :typing
            :ctx
            :call
            mono: bt
            cb: cb.stringView
            m: "slice"
            lead: recvR.stringView
            a: zast.wellKnown.slot.wkFrom
            aForm: argform.value
            b: zast.wellKnown.slot.wkTo
            bForm: argform.value
        )
        )
    }
    if mnId == zast.wellKnown.slot.wkFill then {
        vf: listArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkItem
        noteMemberUse :ctx mono: bt member: memberWord.slot.fill
        ef: "\{cb}_fill(\{recvR}, \{vf})"
        return (stating :facts from: callFacts text: ef)
    }
    if mnId == zast.wellKnown.slot.wkSplit then {
        demandMemberNeeds :reg :typing :ctx mono: bt :mnId
        return (
            emitSpanSplit
            :ast
            :reg
            :typing
            :ctx
            :call
            cb: cb.stringView
            recvR: recvR.stringView
            :facts
        )
    }
    if mnId == zast.wellKnown.slot.wkCopyFrom then {
        demandMemberNeeds :reg :typing :ctx mono: bt :mnId
        return (
            emitSpanCopyFrom
            :ast
            :reg
            :typing
            :ctx
            :call
            cb: cb.stringView
            recvR: recvR.stringView
            :facts
        )
    }
    return "".string
}

# emitSpanSplit -- `w.split at: i` on a window `recvR` of mono `cb`: the pair
# of windows below and from `i`, each a view of the same storage. The window
# and then the position are evaluated once each.
emitSpanSplit: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    cb: StringView
    recvR: StringView
    facts: cfacts.borrow
} out String is {
    va: listArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkAt
    pairTid: chaseAggregateTypedef :reg :typing :ctx tid: (stampIdOf :typing nid: call.nodeid)
    pc: spelledCname :ctx tid: pairTid
    loC: (
        memberC
        :ast
        :reg
        :typing
        :ctx
        owner: pairTid
        kind: memberkind.field
        nameId: zast.wellKnown.slot.wkLo
    )
    hiC: (
        memberC
        :ast
        :reg
        :typing
        :ctx
        owner: pairTid
        kind: memberkind.field
        nameId: zast.wellKnown.slot.wkHi
    )
    # the window, then the position, each read more than once
    spT: "\{cb}_t*"
    rpre: String
    r: (
        orderOnePart
        :ast
        :reg
        :typing
        :ctx
        text: recvR.string
        ctype: spT.stringView
        prefix: rpre
        mark: (pendingHoistMark :ctx)
        tf: cfacts
    )
    apre: String
    at: (
        orderOnePart
        :ast
        :reg
        :typing
        :ctx
        text: va
        ctype: "uint64_t"
        prefix: apre
        mark: (pendingHoistMark :ctx)
        tf: cfacts
    )
    es: String
    es.append "(z_coll_window_check(0, \{at}, \{r}->length, \"SpanVal split\"), "
    es.append "(\{pc}_t){ .\{loC} = { .length = \{at}, .data = \{r}->data }, "
    es.append ".\{hiC} = { .length = \{r}->length - \{at}, .data = \{r}->data + \{at} } })"
    return (
        stating
        :facts
        from: callFacts
        text: (orderWrap prefix: rpre call: (orderWrap prefix: apre call: es))
    )
}

# emitSpanCopyFrom -- `w.copyFrom from: src` on a window `recvR` of mono `cb`:
# the source's elements copied over the window's first ones. The window and then
# the source are evaluated once each.
emitSpanCopyFrom: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    cb: StringView
    recvR: StringView
    facts: cfacts.borrow
} out String is {
    vc: listArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkFrom
    vn: labelArgNode :ast :call label: zast.wellKnown.slot.wkFrom form: argform.value
    lc: (
        spelledCname
        :ctx
        tid: (chaseAggregateTypedef :reg :typing :ctx tid: (stampIdOf :typing nid: vn))
    )
    # the window, then the source, each read more than once
    spT: "\{cb}_t*"
    rpre: String
    r: (
        orderOnePart
        :ast
        :reg
        :typing
        :ctx
        text: recvR.string
        ctype: spT.stringView
        prefix: rpre
        mark: (pendingHoistMark :ctx)
        tf: cfacts
    )
    srcT: "\{lc}_t"
    fpre: String
    f: (
        orderOnePart
        :ast
        :reg
        :typing
        :ctx
        text: vc
        ctype: srcT.stringView
        prefix: fpre
        mark: (pendingHoistMark :ctx)
        tf: cfacts
    )
    ec: String
    ec.append "(z_coll_window_check(0, \{f}.length, \{r}->length, \"SpanVal copyFrom\"), "
    ec.append "\{f}.length > 0 ? (void)memmove(\{r}->data, \{f}.data, \{f}.length * sizeof(*\{r}->data)) : (void)0)"
    return (
        stating
        :facts
        from: callFacts
        text: (orderWrap prefix: rpre call: (orderWrap prefix: fpre call: ec))
    )
}

# emitWindowSlice -- a window over [from, to) of a list's or an array's storage,
# written at the call: the receiver's address `recvR` read into a temp of C
# type `recvT`, its length as `len` spells it -- `@@R@@->length` for that temp,
# or an array's constant -- and the bounds check that names `what` in its
# panic. The receiver and then the bounds are evaluated once each, as written. An array's
# storage is inline, so a receiver read through a view holds it const; `inline`
# says so, and the window takes the address without the qualifier, its own type
# deciding whether it writes.
emitWindowSlice: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    recvR: StringView
    recvT: StringView
    len: StringView
    what: StringView
    inline: bool
} out String is {
    wc: (
        spelledCname
        :ctx
        tid: (chaseAggregateTypedef :reg :typing :ctx tid: (stampIdOf :typing nid: call.nodeid))
    )
    rpre: String
    r: (
        orderOnePart
        :ast
        :reg
        :typing
        :ctx
        mark: (pendingHoistMark :ctx)
        text: recvR.string
        tf: cfacts
        nid: zast.nodeid
        ctype: recvT
        constant: false
        twice: true
        prefix: rpre
    )
    tmpl: String
    tmpl.append "(z_coll_window_check(@@A@@, @@B@@, "
    tmpl.append len
    tmpl.append ", \""
    tmpl.append what
    tmpl.append "\"), "
    if inline then {
        tmpl.append "(\{wc}_t){ .length = @@B@@ - @@A@@, .data = (void*)(@@R@@->data + @@A@@) })"
    } else {
        tmpl.append "(\{wc}_t){ .length = @@B@@ - @@A@@, .data = @@R@@->data + @@A@@ })"
    }
    w: (
        emitOrderedPairInto
        :ast
        :reg
        :typing
        :ctx
        :call
        lead: r.stringView
        a: zast.wellKnown.slot.wkFrom
        aForm: argform.value
        b: zast.wellKnown.slot.wkTo
        bForm: argform.value
        tmpl: tmpl.stringView
    )
    return (orderWrap prefix: rpre call: w)
}

# keyIsString -- a map's key or a set's element, of type `tid`, is a String: its
# view-mode probe params are `const String*` in the template C, and it decides
# the hash and the compare the mono gets.
keyIsString: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx.view tid: ztypes.tid
} out bool is {
    return (keyHashKind :reg :typing :ctx :tid) == 1
}

# stringKeyArgPointer -- a String-keyed mono's view-mode key/item argument as a C
# POINTER: the expression itself when it already is one, else `&lvalue`, else a
# hoisted temp (owned by the statement, freed at its flush -- a probe never
# retains its key).
stringKeyArgPointer: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    label: zast.nameid
    expr: StringView
    exprF: cfacts
} out String is {
    # a String `.view`/`.borrow` PARAMETER, or a borrowed field, arrives as a
    # pointer already; addressing it again hands the runtime a `String_t**`,
    # which the C compiler rejects
    if (argIsPointerByLabel :ast :reg :typing :ctx :call :label) then return expr.string
    if exprF.place.not then {
        nmK: (
            hoistForAddress
            :ast
            :reg
            :typing
            :ctx
            av: expr
            tid: ctx.strTid
            argNid: (ctorArgNodeByLabel :ast :call :label)
        )
        return "&\{nmK}"
    }
    return "&\{expr}"
}

# ownedReceiverHoist -- a member read whose RECEIVER is a temporary that owns
# heap: `(mk n: 1).length` emits the call inline, reads `.size` off the result
# and drops the only reference to it. Hoist the receiver into a statement temp
# (declared by flushArgHoists, freed with the scope) and read the member off
# that instead. "" when the receiver is already an lvalue, when its type frees
# nothing, and when the CHECKER says the temporary holding it owns nothing --
# which is the same question "is this a borrow-returning call" was asking, and
# is the answer the free below already comes from.
ownedReceiverHoist: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    expr: StringView
    exprF: cfacts
    n: astnode.view
} out String is {
    if exprF.place then return "".string
    rtid: stampIdOf :typing nid: (interpPartNodeId :n)
    if rtid.isZero then return "".string
    if (ownsResources :reg :ctx tid: rtid).not then return "".string
    rnid: zast.nodeIdOf :n
    if (scopeOwnsTemp :typing argNid: rnid).not then return "".string
    if (typeRefC :ast :reg :typing :ctx tid: rtid).length == 0 then return "".string
    return (hoistForAddress :ast :reg :typing :ctx av: expr tid: rtid argNid: rnid)
}

# emitKeyedProbe -- a Set's or Map's keyed probe, `fnC(recv, key)`: the
# view-keyed form `fnCv` for a key that arrives as a view (viewForm, where the
# family has one), a String key by pointer (stringKeyArgPointer), any other key
# as it stands. A probe only reads its key.
emitKeyedProbe: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    # the instance probed, and the probe's member and view-keyed member
    # (memberWord slots)
    mono: ztypes.tid
    member: u64
    memberV: u64
    # the probe's C function: the collection's C name and the member
    fnC: String.view
    bn: StringView
    label: zast.nameid
    viewForm: bool
    stringKey: bool
    facts: cfacts.borrow
} out String is {
    if viewForm then {
        kv: colArgAsStringViewExpr :ast :reg :typing :ctx :call :label
        if kv.length > 0 then {
            noteMemberUse :ctx :mono member: memberV
            fnV: "\{fnC}v"
            vargs: "\{bn}, \{kv}"
            return (
                stating
                :facts
                from: callFacts
                text: (orderClose prefix: String callee: fnV.stringView args: vargs.stringView)
            )
        }
    }
    noteMemberUse :ctx :mono :member
    kF: cfacts
    k: colArgWith :ast :reg :typing :ctx :call facts: kF :label consumes: false
    if stringKey then k = (
        stringKeyArgPointer
        :ast
        :reg
        :typing
        :ctx
        :call
        :label
        expr: k.stringView
        exprF: kF
    )
    args: "\{bn}, \{k}"
    return (
        stating
        :facts
        from: callFacts
        text: (orderClose prefix: String callee: fnC.stringView args: args.stringView)
    )
}

# emitSetMethodCall -- an arg-taking method on a Set-mono receiver (a heap
# pointer, so the receiver passes directly without `&`). "" when not a Set
# call; the no-arg `.length`/`.iterate` reads ride the dottedpath leg.
emitSetMethodCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    mnId: zast.nameid
    bn: String
    bt: ztypes.tid
    facts: cfacts.borrow
} out String is {
    cb: spelledCname :ctx tid: bt
    if mnId == zast.wellKnown.slot.wkAdd then {
        vF: cfacts
        v: (
            colArgWith
            :ast
            :reg
            :typing
            :ctx
            :call
            facts: vF
            label: zast.wellKnown.slot.wkItem
            consumes: true
        )
        noteMemberUse :ctx mono: bt member: memberWord.slot.add
        e0: "\{cb}_add(\{bn}, \{v})"
        return (stating :facts from: callFacts text: e0)
    }
    if mnId == zast.wellKnown.slot.wkHas then return (
        emitKeyedProbe
        :ast
        :reg
        :typing
        :ctx
        :call
        mono: bt
        member: memberWord.slot.has
        memberV: memberWord.slot.hasv
        fnC: "\{cb}_has"
        bn: bn.stringView
        label: zast.wellKnown.slot.wkItem
        viewForm: true
        stringKey: (keyIsString :reg :typing :ctx tid: (setElemType :typing monoId: bt))
        :facts
    )
    if mnId == zast.wellKnown.slot.wkDelete then return (
        emitKeyedProbe
        :ast
        :reg
        :typing
        :ctx
        :call
        mono: bt
        member: memberWord.slot.delete
        memberV: memberWord.slot.deletev
        fnC: "\{cb}_delete"
        bn: bn.stringView
        label: zast.wellKnown.slot.wkItem
        viewForm: true
        stringKey: (keyIsString :reg :typing :ctx tid: (setElemType :typing monoId: bt))
        :facts
    )
    return "".string
}

# emitMapMethodCall -- an arg-taking method on a Map-mono receiver (a heap
# pointer). set/get/has/delete pass the pointer directly; "" otherwise. The
# no-arg `.length`/`.capacity` reads ride the dottedpath leg.
emitMapMethodCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    mnId: zast.nameid
    bn: String
    bt: ztypes.tid
    facts: cfacts.borrow
} out String is {
    cb: spelledCname :ctx tid: bt
    if mnId == zast.wellKnown.slot.wkSet then {
        return (stating :facts from: callFacts text: (
            emitOrderedPair
            :ast
            :reg
            :typing
            :ctx
            :call
            mono: bt
            cb: cb.stringView
            m: "set"
            lead: bn.stringView
            a: zast.wellKnown.slot.wkKey
            aForm: argform.moved
            b: zast.wellKnown.slot.wkValue
            bForm: argform.moved
        )
        )
    }
    if mnId == zast.wellKnown.slot.wkGet then return (
        emitKeyedProbe
        :ast
        :reg
        :typing
        :ctx
        :call
        mono: bt
        member: memberWord.slot.getOne
        memberV: memberWord.slot.getv
        fnC: "\{cb}_get"
        bn: bn.stringView
        label: zast.wellKnown.slot.wkKey
        viewForm: true
        stringKey: (keyIsString :reg :typing :ctx tid: (mapKeyType :typing monoId: bt))
        :facts
    )
    if mnId == zast.wellKnown.slot.wkGetMut then return (
        emitKeyedProbe
        :ast
        :reg
        :typing
        :ctx
        :call
        mono: bt
        member: memberWord.slot.getMut
        memberV: memberWord.slot.getMut
        fnC: "\{cb}_getMut"
        bn: bn.stringView
        label: zast.wellKnown.slot.wkKey
        viewForm: false
        stringKey: (keyIsString :reg :typing :ctx tid: (mapKeyType :typing monoId: bt))
        :facts
    )
    if mnId == zast.wellKnown.slot.wkHas then return (
        emitKeyedProbe
        :ast
        :reg
        :typing
        :ctx
        :call
        mono: bt
        member: memberWord.slot.has
        memberV: memberWord.slot.hasv
        fnC: "\{cb}_has"
        bn: bn.stringView
        label: zast.wellKnown.slot.wkKey
        viewForm: true
        stringKey: (keyIsString :reg :typing :ctx tid: (mapKeyType :typing monoId: bt))
        :facts
    )
    if mnId == zast.wellKnown.slot.wkRemove then return (
        emitKeyedProbe
        :ast
        :reg
        :typing
        :ctx
        :call
        mono: bt
        member: memberWord.slot.remove
        memberV: memberWord.slot.remove
        fnC: "\{cb}_remove"
        bn: bn.stringView
        label: zast.wellKnown.slot.wkKey
        viewForm: false
        stringKey: (keyIsString :reg :typing :ctx tid: (mapKeyType :typing monoId: bt))
        :facts
    )
    return "".string
}

# emitIdMapMethodCall -- an arg-taking method on an IdMap-mono receiver. The
# receiver is a STACK struct, as a List is, so it goes through colRecvRef and
# arrives by address; a Map's receiver is already a pointer and does not. The
# key is a scalar by construction of the `idkey` bound, so none of the Map
# family's String-key detours apply here.
emitIdMapMethodCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    mnId: zast.nameid
    bn: String
    bt: ztypes.tid
    bvid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    cb: spelledCname :ctx tid: bt
    recvR: colRecvRef :ctx bn: bn.stringView vid: bvid
    if mnId == zast.wellKnown.slot.wkSet then {
        return (stating :facts from: callFacts text: (
            emitOrderedPair
            :ast
            :reg
            :typing
            :ctx
            :call
            mono: bt
            cb: cb.stringView
            m: "set"
            lead: recvR.stringView
            a: zast.wellKnown.slot.wkKey
            aForm: argform.read
            b: zast.wellKnown.slot.wkValue
            bForm: argform.moved
        )
        )
    }
    if mnId == zast.wellKnown.slot.wkGet then {
        vk: colArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkKey consumes: false
        noteMemberUse :ctx mono: bt member: memberWord.slot.getOne
        e1: "\{cb}_get(\{recvR}, \{vk})"
        return (stating :facts from: callFacts text: e1)
    }
    if mnId == zast.wellKnown.slot.wkGetMut then {
        vkm: colArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkKey consumes: false
        noteMemberUse :ctx mono: bt member: memberWord.slot.getMut
        e1m: "\{cb}_getMut(\{recvR}, \{vkm})"
        return (stating :facts from: callFacts text: e1m)
    }
    if mnId == zast.wellKnown.slot.wkHas then {
        vk: colArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkKey consumes: false
        noteMemberUse :ctx mono: bt member: memberWord.slot.has
        e2: "\{cb}_has(\{recvR}, \{vk})"
        return (stating :facts from: callFacts text: e2)
    }
    if mnId == zast.wellKnown.slot.wkKeyAt then {
        vi: colArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkI consumes: false
        noteMemberUse :ctx mono: bt member: memberWord.slot.keyAt
        e3: "\{cb}_keyAt(\{recvR}, \{vi})"
        return (stating :facts from: callFacts text: e3)
    }
    if mnId == zast.wellKnown.slot.wkValueAt then {
        vi2: colArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkI consumes: false
        noteMemberUse :ctx mono: bt member: memberWord.slot.valueAt
        e4: "\{cb}_valueAt(\{recvR}, \{vi2})"
        return (stating :facts from: callFacts text: e4)
    }
    return "".string
}

# emitIdSetMethodCall -- the IdSet half of the above.
emitIdSetMethodCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    mnId: zast.nameid
    bn: String
    bt: ztypes.tid
    bvid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    cb: spelledCname :ctx tid: bt
    recvR: colRecvRef :ctx bn: bn.stringView vid: bvid
    if mnId == zast.wellKnown.slot.wkAdd then {
        v: colArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkItem consumes: false
        noteMemberUse :ctx mono: bt member: memberWord.slot.add
        e0: "\{cb}_add(\{recvR}, \{v})"
        return (stating :facts from: callFacts text: e0)
    }
    if mnId == zast.wellKnown.slot.wkHas then {
        v: colArg :ast :reg :typing :ctx :call label: zast.wellKnown.slot.wkItem consumes: false
        noteMemberUse :ctx mono: bt member: memberWord.slot.has
        e1: "\{cb}_has(\{recvR}, \{v})"
        return (stating :facts from: callFacts text: e1)
    }
    return "".string
}

# emitInterpArgExpr -- if n is (or wraps/projects via .string/.stringView) an
# interpolated string literal, return a self-contained statement expression that
# builds and yields the owned String; "" otherwise. Used for inline argument
# positions, where the pure emitExpr cannot emit the multi-statement interp build.
emitInterpArgExpr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out String is {
    match (
        n
    ) case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            # the build runs where the value is read: its locals are declared by
            # the enclosing statement, and what its parts hoisted is assigned and
            # released inside it, so the statement owes none of them
            ltmp: TmpCtr n: 0 listFrees: List OwedFree
            unused: String
            ops: String
            sM: (
                emitInterpBuild
                :ast
                :reg
                :typing
                :ctx
                parts: n.stringparts
                ind: ""
                tmp: ltmp
                buf: unused
                expr: true
                :ops
            )
            r: "(\{ops}\{sM})"
            return r
        }
        return "".string
    } case dottedpath then {
        cm: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        if cm == zast.wellKnown.slot.wkString then {
            dpp: ast.nodes.get i: n.parent
            return (emitInterpArgExpr :ast :reg :typing :ctx n: dpp)
        }
        if (ztypecheck.isStringViewMember nameId: cm) then return (
            emitInterpArgExpr
            :ast
            :reg
            :typing
            :ctx
            n: (ast.nodes.get i: n.parent)
        )
        return "".string
    } else {
        return "".string
    }
}

# interpStorageNid -- the node whose temporary owns the String an interpolated
# argument builds (emitInterpArgExpr). An argument that views the interpolation
# (`"x=\{n}".stringView`) is a view: the String is its receiver's, which the
# checker holds in a temporary of the receiver's own (tempOf), and that
# temporary says whether, and how long, the String is owned. Any other argument
# is the String itself.
interpStorageNid: function {
    ast: Ast.view typing: ztyping.ZTyping.view n: astnode.view
} out zast.nodeid is {
    match (
        n
    ) case dottedpath then {
        cm: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        held: (typing.tempOf.get key: n.parent).some
        if (ztypecheck.isStringViewMember nameId: cm) when held then return n.parent
    } else null
    return (zast.nodeIdOf :n)
}

# emitInterpStmtValue -- like emitInterpArgExpr, but emits the interp build chain
# as PRIOR statements into buf (so a referenced local is read at THIS point) and
# returns the owned-String temp's name; "" otherwise. Used where the build
# must precede the statement -- a reassignment drop-old, so `s = "\{s}x"` reads
# old s before the old value is freed (as emitStringBindValue does).
# emitInterpBuild does NOT register that buffer for free, so the assignment
# `nm2 = <buffer>` moves the storage into the lvalue with no double-free.
emitInterpStmtValue: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    facts: cfacts.borrow
} out String is {
    match (
        n
    ) case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            unusedOps: String
            sB: (
                emitInterpBuild
                :ast
                :reg
                :typing
                :ctx
                parts: n.stringparts
                :ind
                :tmp
                :buf
                strNid: n.nodeid
                ops: unusedOps
            )
            # the built String's temp
            return (stating :facts from: pathFacts text: sB)
        }
        return "".string
    } case dottedpath then {
        cm: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        if cm == zast.wellKnown.slot.wkString then {
            dpr: ast.nodes.get i: n.parent
            return (emitInterpStmtValue :ast :reg :typing :ctx n: dpr :ind :tmp :buf :facts)
        }
        if (ztypecheck.isStringViewMember nameId: cm) then {
            dpr: ast.nodes.get i: n.parent
            return (emitInterpStmtValue :ast :reg :typing :ctx n: dpr :ind :tmp :buf :facts)
        }
        return "".string
    } else {
        return "".string
    }
}

# argHoistName -- what an argument hoist's temporary is CALLED. A value the
# checker holds a temporary for is spelled by that temporary's variable, so the
# name the emitter prints and the name the checker reasons about are one name;
# anything else gets the emitter's own `_ahN`. WHEN it dies is the hoist list's
# business.
argHoistName: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    argNid: zast.nodeid
    # what the emitter's own name is called when it has to invent one
    fallback: StringView
} out String is {
    if argNid.notZero then {
        tv: typing.tempOf.get key: argNid
        if tv.some then return (varCName :ctx :ast :reg vid: tv)
    }
    hn: ctx.argHoistCtr
    ctx.argHoistCtr = ctx.argHoistCtr + 1
    return "\{fallback}\{hn}"
}

# ownedTypedefArg -- the argument `argNid` is a typedef built from a value
# (`(Path s)`) whose temporary the checker says owns it. A typedef emits as its
# source, so the text is an lvalue that still needs the temporary's free.
ownedTypedefArg: function {typing: ztyping.ZTyping.view argNid: zast.nodeid} out bool is {
    if argNid.isZero then return false
    ck: typing.callKind.get key: argNid
    match (
        ck
    ) case some then {
        if ck != zast.callkind.typedefCreate then return false
    } case none then return false
    return (scopeOwnsTemp :typing :argNid)
}

# scopeOwnsTemp -- whether the temporary holding the value node `argNid` still
# owns what it holds where it dies: what the checker listed for the scope that
# binds the temporary (scopeTempDestroy), in the state that scope's end left it.
# False when no temporary holds the value, when the temporary owns nothing -- a
# hoist that only borrows -- and when the value moved out of it. The scope
# is the one `tempScopeOf` recorded as the temporary was bound, which is the key
# its list is under.
scopeOwnsTemp: function {typing: ztyping.ZTyping.view argNid: zast.nodeid} out bool is {
    if argNid.isZero then return false
    tv: typing.tempOf.get key: argNid
    if tv.none then return false
    so: typing.tempScopeOf.get key: tv
    if so.none then return false
    rg: typing.scopeTempDestroy.get key: so
    if rg.none then return false
    k: u64
    for k < rg.len loop {
        it: typing.destroyItems.get i: rg.start.u64 + k
        k = k + 1
        if it.vid == tv then return it.state == 0
    }
    return false
}

# emitColInterpArg -- an interpolated-string collection-method argument hoisted to
# an owned String temp via the argHoist mechanism (flushed at the statement). The
# free is registered when the CHECKER says the temporary still owns what it holds
# where it dies: a consuming method (add/set) moves it in, and a hoist that only
# borrows owns nothing, so neither leaves one to register. The hoist list still
# says WHEN the free runs. "" when n is not an interpolated string.
emitColInterpArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    consumes: bool
} out String is {
    sx: emitInterpArgExpr :ast :reg :typing :ctx :n
    if sx.length == 0 then {
        if consumes then return "".string
        if ((stampIdDeep :reg :typing :n) == ctx.strTid).not then return "".string
        # the argument is spelled again by the caller when this declines, so
        # what this spelling hoisted is dropped with it
        hmk: pendingHoistMark :ctx
        exF: cfacts
        ex: emitExprWith :ast :reg :typing :ctx :n facts: exF
        if exF.place then {
            dropHoistsTo :ctx mark: hmk
            return "".string
        }
        sx = ex.take
    }
    return (
        hoistForAddress
        :ast
        :reg
        :typing
        :ctx
        av: sx.stringView
        tid: ctx.strTid
        argNid: (interpStorageNid :ast :typing :n)
    )
}

# emitInterpArgForParam -- an interpolated-string-literal argument built into a
# hoisted temp `_ah<N>` and coerced to the parameter's C form: a String.take
# param moves the temp in; a String borrow takes it by pointer; a StringView
# param gets a by-value view. Which form the parameter takes is the signature's
# to say and stays `paramTakesArg`'s; whether the temporary is freed is the
# CHECKER's, and a temporary moved into a take param owns nothing where it dies.
# Returns "" when the argument is not an interpolated literal (the caller emits
# it normally). Mirrors emitColInterpArg's hoist but generalises the returned
# form across param kinds.
emitInterpArgForParam: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    fid: ztypes.tid
    pnameId: zast.nameid
    pid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    sx: emitInterpArgExpr :ast :reg :typing :ctx :n
    if sx.length == 0 then return "".string
    isTake: false
    if pid == ctx.strTid when (paramTakesArg :typing :fid :pnameId) then isTake = true
    nmH: (
        hoistForAddress
        :ast
        :reg
        :typing
        :ctx
        av: sx.stringView
        tid: ctx.strTid
        argNid: (interpStorageNid :ast :typing :n)
    )
    retx: String
    retF: pathFacts
    if pid == ctx.strTid then {
        if isTake then {
            retx = nmH.copy
        } else {
            retx = "&\{nmH}"
            retF = addrFacts e: pathFacts
        }
    } else if (typing.standInOf.has key: (zast.nodeIdOf :n)) then {
        # the String stands in for a spec the parameter is typed as (`StringViewable`):
        # the temporary itself, which implementationArgText boxes
        retx = nmH.copy
    } else {
        retx = (
            svValueForm
            :ast
            :reg
            :typing
            :ctx
            expr: nmH.stringView
            isStr: true
            vid: ztypes.vid.zero
            facts: retF
        )
    }
    return (stating :facts from: retF text: retx)
}

# colArg -- a collection-method argument: the interp-string hoist when the arg is
# an interpolated literal, else the plain expression (mirrors listArg). consumes
# distinguishes take params (add/set) from borrow params (has/delete/get).
colArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    label: zast.nameid
    consumes: bool
} out String is {
    facts: cfacts
    return (colArgWith :ast :reg :typing :ctx :call :label :consumes :facts)
}

# colArgWith -- colArg, its facts stated into `facts`.
colArgWith: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    label: zast.nameid
    consumes: bool
    facts: cfacts.borrow
} out String is {
    posFirst: String
    posF: cfacts
    havePos: false
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation then {
            if a.name == label then {
                ic: (
                    emitColInterpArg
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: (ast.nodes.get i: a.operation)
                    :consumes
                )
                # an interpolation, hoisted to its temp
                if ic.length > 0 then return (stating :facts from: pathFacts text: ic)
                return (
                    standInText
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: (ast.nodes.get i: a.operation)
                    text: (
                        valueExprC
                        :ast
                        :reg
                        :typing
                        :ctx
                        n: (ast.nodes.get i: a.operation)
                        :facts
                    )
                    :facts
                )
            }
            if a.name.isZero when havePos.not then {
                havePos = true
                icp: (
                    emitColInterpArg
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: (ast.nodes.get i: a.operation)
                    :consumes
                )
                if icp.length > 0 then {
                    posFirst = icp.take
                    posF = pathFacts
                } else {
                    aOpNode: ast.nodes.get i: a.operation
                    posFirst = (
                        standInText
                        :ast
                        :reg
                        :typing
                        :ctx
                        n: aOpNode
                        text: (valueExprC :ast :reg :typing :ctx n: aOpNode facts: posF)
                        facts: posF
                    )
                }
            }
        }
    }
    if havePos then return (stating :facts from: posF text: posFirst)
    return (stating :facts from: constFacts text: "0".string)
}

# listArg -- the C expression for a labeled list-method argument ("0" if
# absent).
listArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    label: zast.nameid
} out String is {
    facts: cfacts
    return (listArgWith :ast :reg :typing :ctx :call :label :facts)
}

# listArgWith -- listArg, its facts stated into `facts`.
listArgWith: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    label: zast.nameid
    facts: cfacts.borrow
} out String is {
    posFirst: String
    posF: cfacts
    havePos: false
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation then {
            if a.name == label then {
                return (
                    standInText
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: (ast.nodes.get i: a.operation)
                    text: (
                        valueExprC
                        :ast
                        :reg
                        :typing
                        :ctx
                        n: (ast.nodes.get i: a.operation)
                        :facts
                    )
                    :facts
                )
            }
            if a.name.isZero when havePos.not then {
                havePos = true
                aOpNode: ast.nodes.get i: a.operation
                posFirst = (
                    standInText
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: aOpNode
                    text: (valueExprC :ast :reg :typing :ctx n: aOpNode facts: posF)
                    facts: posF
                )
            }
        }
    }
    # a single positional arg binds to the (sole) labelless call site, e.g.
    # `xs.get i2` -> the `i` param.
    if havePos then return (stating :facts from: posF text: posFirst)
    return (stating :facts from: constFacts text: "0".string)
}

# argform -- how a native leg spells one of its labelled arguments.
argform: variant {
    # the value, bound by its label or else by the first unlabelled argument
    value: null
    # a collection argument the method takes over: an interpolation is built
    # into a temp the call moves in
    moved: null
    # a collection argument the method reads: an interpolation's temp is freed
    # with the statement
    read: null
    # the value, bound by its label only
    labelled: null
    # the address of the argument bound by its label, unless it is a pointer
    # already
    addressed: null
    # a value view bound by its label, BY VALUE: a 16-byte {size, data} view is
    # two registers, and a String is projected to its view (viewArgCoerce)
    viewed: null
}

# emitOrderedPair -- `<cb>_<m>(lead, a, b)`: a native leg whose two labelled
# arguments are built in the order they are written, after the assignments that
# run ahead of the call.
emitOrderedPair: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    # the instance whose member `m` is called (0 for a runtime one)
    mono: ztypes.tid
    cb: StringView
    m: StringView
    lead: StringView
    a: zast.nameid
    aForm: argform
    b: zast.nameid
    bForm: argform
} out String is {
    ord: orderPairArgs :ast :reg :typing :ctx :call :a :aForm :b :bForm
    if mono.notZero then noteMemberUse :ctx :mono member: (ctx.memberWords.slotOf text: m)
    r: orderFinish :ctx st: ord
    opened: r.length > 0
    r.append cb
    r.append "_"
    r.append m
    r.append "("
    r.append lead
    r.append ", "
    r.append (orderSlotText t: ctx st: ord slot: 0)
    r.append ", "
    r.append (orderSlotText t: ctx st: ord slot: 1)
    r.append ")"
    if opened then r.append ")"
    orderEnd :ctx st: ord
    return r
}

# emitOrderedPairInto -- emitOrderedPair's evaluation order for a leg whose C is
# not a call: `tmpl` with @@R@@ the leading receiver text and @@A@@ / @@B@@ the
# two labelled arguments in their slots, which `tmpl` may name more than once.
emitOrderedPairInto: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    lead: StringView
    a: zast.nameid
    aForm: argform
    b: zast.nameid
    bForm: argform
    tmpl: StringView
} out String is {
    ord: orderPairArgs :ast :reg :typing :ctx :call :a :aForm :b :bForm twice: true
    r: orderFinish :ctx st: ord
    opened: r.length > 0
    t1: applyTmpl text: tmpl.string key: "R" val: lead
    t2: applyTmpl text: t1 key: "A" val: (orderSlotText t: ctx st: ord slot: 0)
    t3: applyTmpl text: t2 key: "B" val: (orderSlotText t: ctx st: ord slot: 1)
    r.append t3
    if opened then r.append ")"
    orderEnd :ctx st: ord
    return r
}

# orderPairArgs -- the two labelled arguments of a native leg, placed into slots
# 0 and 1 in the order they are written.
orderPairArgs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    a: zast.nameid
    aForm: argform
    b: zast.nameid
    bForm: argform
    # the C reading the two names each more than once
    twice: false
} out orderstate is {
    na: labelArgNode :ast :call label: a form: aForm
    nb: labelArgNode :ast :call label: b form: bForm
    bFirst: (writtenArgPosition :ast :call nid: nb) < (writtenArgPosition :ast :call nid: na)
    ord: orderBegin :ctx slots: 2
    if twice then {
        orderNamesTwice st: ord slot: 0
        orderNamesTwice st: ord slot: 1
    }
    if bFirst then (
        orderLabelArg
        :ast
        :reg
        :typing
        :ctx
        :call
        label: b
        form: bForm
        nid: nb
        slot: 1
        :ord
    )
    orderLabelArg :ast :reg :typing :ctx :call label: a form: aForm nid: na slot: 0 :ord
    if bFirst.not then (
        orderLabelArg
        :ast
        :reg
        :typing
        :ctx
        :call
        label: b
        form: bForm
        nid: nb
        slot: 1
        :ord
    )
    return ord
}

# orderLabelArg -- one labelled argument of a native leg, spelled as `form` says
# and placed in evaluation order into `slot`.
orderLabelArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    label: zast.nameid
    form: argform
    # the argument's value node, 0 when the call writes none
    nid: zast.nodeid
    slot: u64
    ord: orderstate.borrow
} is {
    mk: pendingHoistMark :ctx
    tF: cfacts
    text: labelArgText :ast :reg :typing :ctx :call :label :form facts: tF
    orderArgAtWith :ast :reg :typing :ctx st: ord mark: mk :text tf: tF :nid byPtr: false :slot
}

# labelArgText -- a native leg's labelled argument, spelled as `form` says.
labelArgText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    label: zast.nameid
    form: argform
    facts: cfacts.borrow
} out String is {
    match (
        form
    ) case value then {
        return (listArgWith :ast :reg :typing :ctx :call :label :facts)
    } case moved then {
        return (colArgWith :ast :reg :typing :ctx :call :label consumes: true :facts)
    } case read then {
        return (colArgWith :ast :reg :typing :ctx :call :label consumes: false :facts)
    } case labelled then {
        return (ctorArgByLabelWith :ast :reg :typing :ctx :call :label :facts)
    } case addressed then {
        avF: cfacts
        av: ctorArgByLabelWith :ast :reg :typing :ctx :call :label facts: avF
        if (argIsPointerByLabel :ast :reg :typing :ctx :call :label) then return (
            stating
            :facts
            from: avF
            text: av
        )
        return (stating :facts from: (addrFacts e: avF) text: "&\{av}")
    } case viewed then {
        vF: cfacts
        v: ctorArgByLabelWith :ast :reg :typing :ctx :call :label facts: vF
        return (viewArgCoerce :ast :reg :typing :ctx :call :label av: v.stringView avF: vF :facts)
    }
}

# labelArgNode -- the value node of the argument `form` binds to `label`, 0 when
# the call writes none.
labelArgNode: function {
    ast: Ast.view call: zast.callrow.view label: zast.nameid form: argform
} out zast.nodeid is {
    byLabel: ctorArgNodeByLabel :ast :call :label
    if byLabel.notZero then return byLabel
    match (
        form
    ) case labelled then return zast.nodeid case addressed then return zast.nodeid case viewed then return zast.nodeid case value then null case moved then null case read then null
    return (ctorArgNodeByPosition :ast :call idx: 0)
}

# listTakeArgBaseNid -- listTakeArgBase as an interned name id, for a caller
# that compares the base rather than printing it.
listTakeArgBaseNid: function {
    ast: Ast.view
    call: zast.callrow.view
    label: zast.nameid
} out zast.nodeid is {
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation when a.name == label then return (
            takeArgBaseNid
            :ast
            n: (ast.nodes.get i: a.operation)
        )
    }
    return zast.nodeid
}

# listTakeArgBase -- the base atom of a `x.take` list argument (the
# extend source); the bare atom text otherwise.
listTakeArgBase: function {
    ast: Ast.view
    call: zast.callrow.view
    label: zast.nameid
} outx StringView is {
    lid: listTakeArgBaseNid :ast :call :label
    if lid.isZero then return "0"
    return (atomTextOf :ast n: (ast.nodes.get i: lid))
}

# the base path of a `.take` argument `n`.
takeArgBaseNid: function {ast: Ast.view n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case dottedpath then {
        return (atomNodeId n: (ast.nodes.get i: n.parent))
    } case atomid then {
        return n.nodeid
    } else {
        return zast.nodeid
    }
}

# emitTypedefCreateCall -- `meters.create from: 42` / `meters 42`: a
# zero-overhead cast; emit the single argument expression.
emitTypedefCreateCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    # the call's stamped return IS the typedef (covers the unit-qualified
    # head, whose base atom is the unit name). Gated on the stamped callKind --
    # any ORDINARY call may return a typedef and must not lose itself here.
    ckS: typing.callKind.get key: call.nodeid
    isTdCk: false
    if ckS.some then {
        if ckS == zast.callkind.typedefCreate then isTdCk = true
        if ckS == zast.callkind.typedefBorrow then isTdCk = true
    }
    tidS: stampIdOf :typing nid: call.nodeid
    if isTdCk when (isTypedefType :typing tid: tidS) then {
        for each aIdS: (zast.kidsOf :ast span: call.arguments) loop {
            aS: ast.nodes.get i: aIdS
            if aS.namedoperation then {
                return (
                    emitExprWith
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: (ast.nodes.get i: aS.operation)
                    :facts
                )
            }
        }
        return (stating :facts from: constFacts text: "0".string)
    }
    return "".string
}

# emitInlineVariantCtor -- a value (inline-payload) variant/optionval/resultval
# constructor as a compound literal: some-arm carries the first arg in .data.arm,
# none-arm just the tag. tid is the concrete VARIANT/mono type.
emitInlineVariantCtor: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    tid: ztypes.tid
    arm: zast.nameid
    facts: cfacts.borrow
} out String is {
    pc: armPayloadC :ast :reg :typing :ctx :tid :arm
    if pc.length > 0 then {
        tg: spelledTagConst :ast :ctx :reg :typing :tid armId: arm
        vc: spelledCname :ctx :tid
        av: "0".string
        got: false
        for each aId: (zast.kidsOf :ast span: call.arguments) loop {
            a: ast.nodes.get i: aId
            if a.namedoperation when got.not then {
                got = true
                aOpNode: ast.nodes.get i: a.operation
                avF: cfacts
                av = valueExprC :ast :reg :typing :ctx n: aOpNode facts: avF
            }
        }
        armCiC: memberC :ast :reg :typing :ctx owner: tid kind: memberkind.arm nameId: arm
        return (
            stating
            :facts
            from: literalFacts
            text: "((\{vc}_t){ .tag = \{tg}, .data.\{armCiC} = (\{av}) })"
        )
    } else {
        # a scalar arm (`true`) spells only its tag constant, never the type
        armValue: armValueC :ast :ctx :reg :typing :tid :arm
        if armValue.length > 0 then return (stating :facts from: constFacts text: armValue)
        tg: spelledTagConst :ast :ctx :reg :typing :tid armId: arm
        vc: spelledCname :ctx :tid
        return (stating :facts from: literalFacts text: "((\{vc}_t){ .tag = \{tg} })")
    }
}

# emitArmCtorCall -- a sum ARM built by a call: `T.arm payload`, an alias of an
# instance, or the instance written in place (`(Option T: String).some s`). The
# call node's stamp is the sum type being built, so nothing is read off how the
# type was spelled. A variant -- optionval and resultval included -- is a value
# and builds as a compound literal; a union -- Option and Result included --
# boxes its payload on the heap, and a payload-less union arm carries no box.
emitArmCtorCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    arm: aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable)
    if arm.isZero then return "".string
    stid: stampIdOf :typing nid: call.nodeid
    if stid.isZero then return "".string
    tt: reg.typetypeOf typeId: stid
    if tt == ztypes.ztypetype.variantType then {
        return (emitInlineVariantCtor :ast :reg :typing :ctx :call tid: stid :arm :facts)
    }
    if tt != ztypes.ztypetype.unionType then return "".string
    vc: spelledCname :ctx tid: stid
    tg: spelledTagConst :ast :ctx :reg :typing tid: stid armId: arm
    payC: armPayloadC :ast :reg :typing :ctx tid: stid :arm
    if payC.length == 0 then {
        return (stating :facts from: literalFacts text: "((\{vc}_t){ .tag = \{tg}, .data = NULL })")
    }
    av: "0".string
    got: false
    payNid: zast.nodeid
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation when got.not then {
            got = true
            payNid = a.operation
            av = emitExpr :ast :reg :typing :ctx n: (ast.nodes.get i: a.operation)
        }
    }
    inl: armIsInlineC :typing tid: stid :arm
    # the slot's designator: `.data`, or the inline arm's member
    slot: armSlotC :ast :reg :typing :ctx tid: stid recv: "" acc: "." :arm inline: inl
    held: av.copy
    if inl.not then held = (
        armHeldC
        :ast
        :reg
        :typing
        :ctx
        :stid
        :arm
        :payNid
        payC: payC.stringView
        av: av.stringView
    )
    return (
        stating
        :facts
        from: callFacts
        text: "((\{vc}_t){ .tag = \{tg}, \{slot} = \{held} })"
    )
}

# armHeldC -- what a union's boxed arm `arm` holds for the payload `av`, the
# value of node `payNid`, as C: a non-owned arm (`some: T.borrow`) points at
# its pinned source, which the checker pinned rather than moved, and frees
# nothing; any other arm points at a new cell holding the payload. An inline
# arm holds the payload itself.
armHeldC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    stid: ztypes.tid
    arm: zast.nameid
    payNid: zast.nodeid
    payC: StringView
    av: StringView
} out String is {
    if (armPayloadNamesStorage :ast :typing tid: stid :arm :payNid).not then {
        return (armCellNew :ctx pc: payC value: av)
    }
    pn: ast.nodes.get i: payNid
    avq: atomVidIfPlain :ast :reg :typing :ctx n: pn text: av
    if (argAlreadyPointer :ast :reg :typing :ctx n: pn vid: avq) then return av.string
    return "&(\{av})"
}

# armPayloadNamesStorage -- the arm is non-owned and the call's payload is a
# name or a path, storage the checker pinned for the value built: the payload
# is that storage's address, not a copy.
armPayloadNamesStorage: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    arm: zast.nameid
    # the payload's value node, 0 when there is none
    payNid: zast.nodeid
} out bool is {
    if payNid.isZero then return false
    if (typing.declIsBorrowedFieldId parentTypeId: tid nameId: arm).not then return false
    op: ast.nodes.get i: payNid
    return op.atomid or op.dottedpath
}

# userCreateCallC -- a user `create` (one with a body, so an emitted function)
# called by its OWN parameter labels. The create's parameters decide how each
# argument is passed, as they do for any other call of it: a non-`take` user
# class is a `T*`, so a bare local has to be addressed.
userCreateCallC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    fid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    pnames: List String
    pids: ListVal ztypes.tid
    pidsNm: ListVal zast.nameid
    recFieldLists :ast :reg :typing tid: fid names: pnames ids: pids nameIds: pidsNm
    pn: pnames.length
    wbase: orderPositions :ast :ctx :call nameIds: pidsNm labelsOnly: true
    ord: orderBegin :ctx slots: pn
    k: u64
    for k < pn loop {
        pi: orderNextParam :ctx base: wbase
        k = k + 1
        aNid: ctorArgNodeByLabel :ast :call label: (pidsNm.get i: pi)
        if aNid.notZero then {
            (
                orderUserFnArg
                :ast
                :reg
                :typing
                :ctx
                :fid
                pinId: (pids.get i: pi)
                pinNmId: (pidsNm.get i: pi)
                pname: (pidsNm.get i: pi)
                argOpNode: (ast.nodes.get i: aNid)
                slot: pi
                :ord
            )
        } else {
            dvF: cfacts
            dv: (
                paramDefaultText
                :ast
                :reg
                :typing
                :ctx
                cco: fid
                nameId: (pidsNm.get i: pi)
                pid: (pids.get i: pi)
                facts: dvF
            )
            orderSetSlot :ctx st: ord slot: pi text: dv tf: dvF
        }
    }
    orderDropPositions :ctx base: wbase
    oprefix: orderFinish :ctx st: ord
    args: orderJoinSlots :ctx st: ord count: pn
    orderEnd :ctx st: ord
    mc3: spelledCname :ctx tid: fid
    return (
        stating
        :facts
        from: callFacts
        text: (orderClose prefix: oprefix callee: mc3.stringView args: args.stringView)
    )
}

# emitQualRecvMethodCall -- the ordinary method emission for a type-qualified
# call, whose RECEIVER is among the ARGUMENTS rather than reached through a
# dot: it is the call's one unlabelled argument, or it carries the receiver
# parameter's own declared name. Both call forms then share ONE
# argument-placement rule and a label binds by name in either; walking the
# call's arguments in WRITTEN order would silently swap a pair of reordered
# labels.
#
# THE CHECKER ANSWERED WHERE THE RECEIVER COMES FROM, and this reads the
# answer. A call reaches here only when the walk stamped its receiver as coming
# from the arguments; otherwise the dot supplies it and the call is
# emitInstanceMethodCall's. Deriving it a second time -- off the base atom's
# variable id, or off the name -- is what let the two sides disagree and emit a
# call with the receiver slot never filled.
emitQualRecvMethodCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    mtid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    if (typing.callBaseNamesType.has item: call.nodeid).not then return "".string
    recvNmQ: reg.thisParamNameIdOf tid: mtid
    if recvNmQ.isZero then recvNmQ = zast.wellKnown.slot.wkThis
    recvExQ: String
    recvQF: cfacts
    recvPtrQ: false
    posStartQ: u64
    if (fnTypeTakesThis :reg :typing tid: mtid) then {
        recvNdQ: zast.nodeid
        if (ctorHasLabel :ast :call label: recvNmQ) then {
            recvExQ = ctorArgByLabelWith :ast :reg :typing :ctx :call label: recvNmQ facts: recvQF
            recvNdQ = ctorArgNodeByLabel :ast :call label: recvNmQ
        } else {
            recvExQ = ctorArgByPosition :ast :reg :typing :ctx :call idx: 0 facts: recvQF
            recvNdQ = ctorArgNodeByPosition :ast :call idx: 0
            posStartQ = 1
        }
        # a receiver already held as a pointer passes as it stands -- as
        # WRITTEN, since the construction-argument text loads a pointer-held
        # valtype and the receiver slot wants the pointer
        if recvNdQ.notZero then {
            recvPtrQ = receiverNodeIsPtr :ast :reg :typing :ctx n: (ast.nodes.get i: recvNdQ)
            if recvPtrQ when (ptrHeldValtype :ast :reg :typing :ctx n: (ast.nodes.get i: recvNdQ)
            ) then {
                recvExQ = (
                    emitExprWith
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: (ast.nodes.get i: recvNdQ)
                    facts: recvQF
                )
            }
        }
        # no receiver supplied at all: the checker reports the missing
        # argument, and the stamp keeps the dotted leg from claiming this call,
        # so declining reports an unhandled callee rather than hoisting a
        # zeroed temp nobody passed
        if recvExQ.length == 0 then return "".string
    }
    return (
        emitInstanceMethodBody
        :ast
        :reg
        :typing
        :ctx
        :call
        mco: mtid
        recvExpr: recvExQ.stringView
        recvF: recvQF
        recvIsPtr: recvPtrQ
        posStart: posStartQ
        :facts
    )
}

# callKindIsCreate -- the checker stamped call `nid` as the construction of a
# user record or class.
callKindIsCreate: function {typing: ztyping.ZTyping.view nid: zast.nodeid} out bool is {
    ck: typing.callKind.get key: nid
    if ck.some then {
        return (ck == zast.callkind.recordCreate) or (ck == zast.callkind.classCreate)
    }
    return false
}

# emitTypeQualCall -- `point.add a: x b: y`: a dotted callee whose base
# resolves to a record type and whose member is a FUNCTION child; args
# reorder to the method's param order by label.
emitTypeQualCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    # the checker decided whether the base names a type (callBaseNamesType); the
    # type is the base's stamp -- an instance's own, inside a generic body
    if (typing.callBaseNamesType.has item: call.nodeid).not then return "".string
    mnId: aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable)
    btid: ztypes.tid
    {
        cq: ast.nodes.get i: call.callable
        if cq.dottedpath then {
            bnid: interpPartNodeId n: (ast.nodes.get i: cq.parent)
            btid = stampIdOf :typing nid: bnid
        }
    }
    # a type written as an application (`(Pair t: u64).create`) is stamped on
    # the construction, with the instance
    isCreate: mnId == zast.wellKnown.slot.wkCreate
    if btid.isZero when isCreate when (callKindIsCreate :typing nid: call.nodeid) then {
        btid = stampIdOf :typing nid: call.nodeid
    }
    if btid.isZero then return "".string
    bttq: reg.typetypeOf typeId: btid
    # a receiver's family decides how it is CARRIED, never how the call is
    # written, so every family that can declare a method is claimed here. A
    # variant or union left out reached emitInstanceMethodCall instead, which
    # takes its receiver from the dotted base -- and that base is the type name,
    # so the emitted C named a variable that does not exist.
    if (isUserStructType tt: bttq).not then return "".string
    mco: typing.declChildOfId parentTypeId: btid nameId: mnId
    mtid: ztypes.tid
    if mco.some then {
        mtid = methodInstanceOf :reg :typing mid: mco callable: call.callable
    }
    if mtid.isZero then return "".string
    if ((reg.typetypeOf typeId: mtid) == ztypes.ztypetype.functionType).not then {
        return "".string
    }
    # a synthesized `create` (no body) has field-shaped params but no emitted
    # create fn -- route it to the type's field-wise ctor, the path bare-name
    # construction uses; a user create (a body) is called.
    if isCreate when (typing.funcReturnNode.has key: mtid).not then {
        return (emitRecordCtor :ast :reg :typing :ctx :call tid: btid :facts)
    }
    if isCreate then {
        return (userCreateCallC :ast :reg :typing :ctx :call fid: mtid :facts)
    }
    return (emitQualRecvMethodCall :ast :reg :typing :ctx :call :mtid :facts)
}

# literalC -- a numeric literal lexeme as C text. `0b`, `0o` and `0c` are
# zerolang spellings with no C token behind them, so they are decoded to their
# value; decimal, hex and float lexemes are C as written. Empty when the lexeme
# does not parse, which each caller reports in its own terms.
literalC: function {lex: StringView} out String is {
    decode: (lex.startsWith "0b") or (lex.startsWith "0o") or (lex.startsWith "0c")
    if decode.not then return lex.string
    pnl: ztypes.parseNumber numstr: lex
    if pnl.err.length > 0 then return "".string
    vl: "\{pnl.ival}"
    return vl
}

# renderDefault -- a member's recorded default as a C expression. A literal
# re-renders from its expression node; a constant renders the member's folded
# value, a string as its `_zcsN`; a function default is the target
# FUNCTION type's symbol (the parameter IS that function); an arm default is a
# tag-only struct literal of the target.
renderDefault: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    dv: ztyping.defaultval
    targetTid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    dl: dv
    if dl.literal then {
        if dl.isZero then return "".string
        lt: ztypecheck.rootNameOf :ast n: (ast.nodes.get i: dl)
        # a float literal is the target type's value nearest it, as a body
        # literal is
        if (ztypes.isFloatLexeme numstr: lt.stringView) then {
            fk: constScalarKindForTid :typing tid: targetTid
            k: ztypes.numkind.f64Type
            if fk.has when (ztypes.isFloatKind k: fk.kind) then k = fk.kind
            return (
                stating
                :facts
                from: constFacts
                text: (floatBitsC bits: (ztypecheck.floatLexemeBits lex: lt.stringView :k) :k)
            )
        }
        wlD: (
            wideLiteralOf
            :ctx
            lex: lt.stringView
            k: (constScalarKindForTid :typing tid: targetTid)
        )
        if wlD.length > 0 then return (stating :facts from: constFacts text: wlD)
        return (stating :facts from: constFacts text: (literalDefaultC lex: lt.stringView :ctx))
    }
    {
        dk: dv
        if dk.constant then {
            # a named or computed scalar: the member's own folded value
            kName: zast.nameid
            kOwner: ztypes.declid
            ko: typing.decls.get i: dk
            kName = ko.name
            kOwner = ko.parent
            kUnit: typing.declTypeOf declId: kOwner
            # a string default is the `_zcsN` view of its static bytes
            ks: memberConstStringText :typing :ctx unitTid: kUnit nameId: kName :facts
            if ks.length > 0 then return ks
            return (memberConstText :ast :reg :typing :ctx unitTid: kUnit nameId: kName :facts)
        }
    }
    {
        df: dv
        if df.func then {
            cf: targetTid
            if cf.notZero then return (
                stating
                :facts
                from: pathFacts
                text: (spelledCname :ctx tid: cf)
            )
            return (stating :facts from: pathFacts text: (spelledCname :ctx tid: targetTid))
        }
    }
    {
        da: dv
        if da.arm then {
            armId: zast.nameid
            ao: typing.decls.get i: da
            armId = ao.name
            cv: targetTid
            vtarget: targetTid
            if cv.notZero then vtarget = cv
            avd: armValueC :ast :ctx :reg :typing tid: vtarget arm: armId
            if avd.length > 0 then return (stating :facts from: constFacts text: avd)
            tg: spelledTagConst :ast :ctx :reg :typing tid: vtarget :armId
            tc: typeRefC :ast :reg :typing :ctx tid: vtarget
            return (stating :facts from: literalFacts text: "(\{tc}){ .tag = \{tg} }")
        }
    }
    return "".string
}

# fnTypeTakesThis -- a FUNCTION type whose signature carries a `this` receiver
# (a method-ref slot auto-calls through itself with the receiver).
#
# TWO SPELLINGS, ONE QUESTION. The long form (`self: this`) records the
# receiver's NAME, which hasThisParamName answers; the elided form (`:this`)
# declares a member literally named `this` and records no param name, so
# hasThisParamName answers false for a method that plainly has a receiver.
# Asking only the second half made `point.add.take` emit a call for `:this`
# methods and a reference for `self: this` ones -- the same declaration
# spelled two ways, emitting two different things. This mirrors the checker's
# methodHasThisReceiver, which has always asked both.
fnTypeTakesThis: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view tid: ztypes.tid
} out bool is {
    if (typing.declHasMemberId parentTypeId: tid nameId: zast.wellKnown.slot.wkThis
    ) then return true
    return (reg.hasThisParamName :tid)
}

# emitAllDefaultedCall -- a bare reference to a function whose params are ALL
# defaulted is a no-arg auto-call: `describe` -> `z_..._describe(<defaults>)`.
# "" when the function has no params or any param lacks a default.
emitAllDefaultedCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fnTid: ztypes.tid
    fcn: StringView
} out String is {
    pidl: ListVal ztypes.tid
    pidlNm: ListVal zast.nameid
    recFieldIds :reg :typing tid: fnTid ids: pidl nameIds: pidlNm
    m: pidl.length
    if m == 0 then return "".string
    j: u64
    allDef: true
    for j < m loop {
        pnjId: pidlNm.get i: j
        hd: typing.declHasDefaultId parentTypeId: fnTid nameId: pnjId
        if hd.not then allDef = false
        j = j + 1
    }
    if allDef.not then return "".string
    args: String
    k: u64
    for k < m loop {
        pik: pidl.get i: k
        pnkId: pidlNm.get i: k
        dt: typing.declDefaultOfId parentTypeId: fnTid nameId: pnkId
        facts: cfacts
        rv: renderDefault :ast :reg :typing :ctx dv: dt targetTid: pik :facts
        if k > 0 then args.append ", "
        args.append rv
        k = k + 1
    }
    r: "\{fcn}(\{args})"
    return r
}

# renderedMethodDefaultArgs -- the comma-joined rendered defaults for every
# non-receiver parameter of a method, when ALL of them carry defaults; ""
# when any is required or there are none (the caller keeps its emission).
renderedMethodDefaultArgs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fnTid: ztypes.tid
} out String is {
    pn: List String
    pidl: ListVal ztypes.tid
    pidlNm: ListVal zast.nameid
    recFieldLists :ast :reg :typing tid: fnTid names: pn ids: pidl nameIds: pidlNm
    thisPn: zast.poolTextAt pool: ast.names ref: (reg.thisParamNameIdOf tid: fnTid)
    args: String
    userSeen: false
    j: u64
    m: pn.length
    for j < m loop {
        pnj: pn.get i: j
        pij: pidl.get i: j
        pnjId: pidlNm.get i: j
        j = j + 1
        isRecv: (
            (pnjId == zast.wellKnown.slot.wkThis) or
            ((thisPn.length > 0) and (thisPn.stringView == pnj))
        )
        if isRecv.not then {
            userSeen = true
            hd: typing.declHasDefaultId parentTypeId: fnTid nameId: pnjId
            if hd.not then return "".string
            dt: typing.declDefaultOfId parentTypeId: fnTid nameId: pnjId
            facts: cfacts
            rv: renderDefault :ast :reg :typing :ctx dv: dt targetTid: pij :facts
            if args.length > 0 then args.append ", "
            args.append rv
        }
    }
    if userSeen.not then return "".string
    return args
}

# emitExprStrZero -- the empty owned String value: the zero struct needs
# no allocation and no free.
emitExprStrZero: function {ctx: Ctx facts: cfacts.borrow} out String is {
    strT: strTypeC :ctx
    return (stating :facts from: literalFacts text: "((\{strT}){0})")
}

# userCreateFn -- the user-written `create` that overrides a type's field-wise
# constructor: a function-typed `create` member with a body (a return node).
# Zero when the type has none, and construction is field-wise.
userCreateFn: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view tid: ztypes.tid
} out ztypes.tid is {
    cco: typing.declChildOfId parentTypeId: tid nameId: zast.wellKnown.slot.wkCreate
    if cco.none then return ztypes.tid
    ct: cco
    if ((reg.typetypeOf typeId: ct) == ztypes.ztypetype.functionType).not then {
        return ztypes.tid
    }
    if (typing.funcReturnNode.get key: cco).none then return ztypes.tid
    return ct
}

# paramDefaultText -- a parameter the call left unsupplied: its registered
# default, else the "0" fallback.
paramDefaultText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the function, whose parameters own their defaults
    cco: ztypes.tid
    # the parameter's name id (a raw pool index)
    nameId: zast.nameid
    # the parameter's type
    pid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    nm: nameId
    if (typing.declHasDefaultId parentTypeId: cco nameId: nm).not then return (
        stating
        :facts
        from: constFacts
        text: "0".string
    )
    cdt: typing.declDefaultOfId parentTypeId: cco nameId: nm
    return (renderDefault :ast :reg :typing :ctx dv: cdt targetTid: pid :facts)
}

# fieldDefaultText -- a field the construction left unsupplied: its registered
# default, else an fnptr slot's method address, else the "0" fallback.
fieldDefaultText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    # the field's name id (a raw pool index)
    nameId: zast.nameid
    # the field's type
    fid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    nm: nameId
    if (typing.declHasDefaultId parentTypeId: tid nameId: nm) then {
        cdt: typing.declDefaultOfId parentTypeId: tid nameId: nm
        return (renderDefault :ast :reg :typing :ctx dv: cdt targetTid: fid :facts)
    }
    if (typing.declIsFnptrFieldId parentTypeId: tid nameId: nm) then {
        # the method's name, a designator
        return (stating :facts from: pathFacts text: (spelledCname :ctx tid: fid))
    }
    return (stating :facts from: constFacts text: "0".string)
}

# emitCtorDefaultsFill -- the zero-argument construction of a record/class
# tid: a body-carrying user create called with its param defaults, else the
# generated field-wise create with each field's default (fnptr fields pass
# the method symbol). The typechecker's implicitCreate stamp guarantees no
# required argument remains.
emitCtorDefaultsFill: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    cco: userCreateFn :reg :typing :tid
    if cco.notZero then {
        cpi: ListVal ztypes.tid
        cpiNm: ListVal zast.nameid
        recFieldIds :reg :typing tid: cco ids: cpi nameIds: cpiNm
        cargs: String
        ci: u64
        ccn: cpi.length
        for ci < ccn loop {
            argFacts: cfacts
            cav: (
                paramDefaultText
                :ast
                :reg
                :typing
                :ctx
                :cco
                nameId: (cpiNm.get i: ci)
                pid: (cpi.get i: ci)
                facts: argFacts
            )
            ci = ci + 1
            if cargs.length > 0 then cargs.append ", "
            cargs.append cav
        }
        ccb: spelledCname :ctx tid: cco
        # a templated class creates through its template's function
        if (tmplClassRowOf :reg :ctx :tid) > 0 then {
            noteMemberUse :ctx mono: tid member: memberWord.slot.create
            ccb = "\{spelledCname :ctx :tid}_create"
        }
        return (stating :facts from: callFacts text: "\{ccb}(\{cargs})")
    }
    fids: ListVal ztypes.tid
    fidsNm: ListVal zast.nameid
    recFieldIds :reg :typing :tid ids: fids nameIds: fidsNm
    args: String
    fi: u64
    fn0: fids.length
    for fi < fn0 loop {
        argFacts: cfacts
        av: (
            fieldDefaultText
            :ast
            :reg
            :typing
            :ctx
            :tid
            nameId: (fidsNm.get i: fi)
            fid: (fids.get i: fi)
            facts: argFacts
        )
        fi = fi + 1
        if args.length > 0 then args.append ", "
        args.append av
    }
    noteCreateAliasUse :ctx :tid
    rcb: spelledCname :ctx :tid
    noteMemberUse :ctx mono: tid member: memberWord.slot.create
    return (stating :facts from: callFacts text: "\{rcb}_create(\{args})")
}

# createArgText -- one argument of a construction routed through a user
# `create`. The create's own parameters decide how each argument is passed,
# exactly as they do for any other call of it: a non-`take` user class is a
# `T*`, so a bare local has to be addressed. userFnArgTextWith is the same answer
# the direct-call path uses -- asking it here is what keeps a `create` reached
# by construction agreeing with one reached by name. An unsupplied parameter
# takes its default.
createArgText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the user create
    cco: ztypes.tid
    # the argument the parameter binds
    ca: ctorarg
    # the parameter's name id (a raw pool index)
    nameId: zast.nameid
    # the parameter's type
    pid: ztypes.tid
    pnameId: zast.nameid
    facts: cfacts.borrow
} out String is {
    if ca.nid.isZero then return (paramDefaultText :ast :reg :typing :ctx :cco :nameId :pid :facts)
    return (
        userFnArgTextWith
        :ast
        :reg
        :typing
        :ctx
        fid: cco
        pinId: pid
        pinNmId: pnameId
        argOpNode: (ast.nodes.get i: ca.nid)
        :facts
    )
}

# fieldArgText -- one argument of a field-wise construction: the labelled
# argument's text as written; an absent label binds the next positional
# (unlabeled) argument, then the field's default, then an fnptr slot's method
# address, else the "0" fallback.
fieldArgText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    # the argument the field binds
    ca: ctorarg
    # the field's name id (a raw pool index)
    nameId: zast.nameid
    # the field's type
    fid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    if ca.nid.notZero then {
        t: ctorArgTextAt :ast :reg :typing :ctx aid: ca.nid :facts
        if ca.labelled or (t.length > 0) then {
            return (
                standInText
                :ast
                :reg
                :typing
                :ctx
                n: (ast.nodes.get i: ca.nid)
                text: t.take
                :facts
            )
        }
    }
    if ca.labelled then return (stating :facts from: constFacts text: "0".string)
    return (fieldDefaultText :ast :reg :typing :ctx :tid :nameId :fid :facts)
}

# userCreateCtor -- a construction routed through the user `create` `cco`:
# args by the create's own labels, in its parameter order.
userCreateCtor: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    cco: ztypes.tid
    facts: cfacts.borrow
    # the callee's C name when it is not cco's own: an instance of a templated
    # class creates through its template's function (emitTmplClassMono)
    named: ""
} out String is {
    cpn: List String
    cpi: ListVal ztypes.tid
    cpiNm: ListVal zast.nameid
    recFieldLists :ast :reg :typing tid: cco names: cpn ids: cpi nameIds: cpiNm
    ccn: cpn.length
    wbase: orderPositions :ast :ctx :call nameIds: cpiNm labelsOnly: false
    ord: orderBegin :ctx slots: ccn
    k: u64
    for k < ccn loop {
        ci: orderNextParam :ctx base: wbase
        k = k + 1
        mk: pendingHoistMark :ctx
        ca: (
            ctorArgFor
            :ast
            :call
            label: (cpiNm.get i: ci)
            posIdx: (ctx.orderPosAt.get i: wbase + ci)
        )
        cavF: cfacts
        cav: (
            createArgText
            :ast
            :reg
            :typing
            :ctx
            :cco
            :ca
            nameId: (cpiNm.get i: ci)
            pid: (cpi.get i: ci)
            pnameId: (cpiNm.get i: ci)
            facts: cavF
        )
        # the parameter takes the argument by pointer; an unsupplied default never
        cavPtr: ca.nid.notZero and ctx.lastArgByPtr
        wr: ctx.orderWrit.get i: wbase + ci
        constant: true
        if wr > 0 then {
            constant = (
                orderConstantWith
                :ast
                :typing
                :ctx
                n: (ast.nodes.get i: (writtenArgNode :ast :call pos: wr - 1))
                tf: cavF
                byPtr: cavPtr
            )
        }
        (
            orderPartWith
            :ast
            :reg
            :typing
            :ctx
            st: ord
            mark: mk
            text: cav
            tf: cavF
            :constant
            fid: cco
            pid: (cpi.get i: ci)
            pname: (cpiNm.get i: ci)
            ctype: ""
            slot: ci
        )
    }
    orderDropPositions :ctx base: wbase
    oprefix: orderFinish :ctx st: ord
    cargs: orderJoinSlots :ctx st: ord count: ccn
    orderEnd :ctx st: ord
    ccb: named.string
    if ccb.length == 0 then ccb = spelledCname :ctx tid: cco
    return (
        stating
        :facts
        from: callFacts
        text: (orderClose prefix: oprefix callee: ccb.stringView args: cargs.stringView)
    )
}

# emitRecordCtor -- a record construction call: args reordered to field
# order by label, emitted through the create alias. A user-defined `create`
# (non-empty params) overrides the field-wise ctor: bare-name construction
# routes through it, args by the create's own labels.
emitRecordCtor: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    tid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    cco: userCreateFn :reg :typing :tid
    if cco.notZero then {
        # a native create is its row's fragment, written under the class's name
        named: String
        if (reg.isNativeOf tid: cco) then {
            noteMemberUse :ctx mono: tid member: memberWord.slot.create
            demandMethodRow :reg :typing :ctx mfid: cco
            named = "\{spelledCname :ctx :tid}_create"
        }
        return (userCreateCtor :ast :reg :typing :ctx :call :cco :facts named: named.stringView)
    }
    fnames: List String
    fids: ListVal ztypes.tid
    fidsNm: ListVal zast.nameid
    recFieldLists :ast :reg :typing :tid names: fnames ids: fids nameIds: fidsNm
    fn0: fnames.length
    # a field of a numeric parameter's singleton type takes no argument: the
    # arguments bind to the other fields, and it holds its default, the type's
    # one value
    fixed: false
    for each fft: fids loop {
        if (typing.isSingletonType tid: fft) then fixed = true
    }
    argAt: ListVal u64
    argNm: ListVal zast.nameid
    if fixed then singletonFreeFields :typing :fids :fidsNm at: argAt nameIds: argNm
    # the fields' arguments are built in the order they are written
    wbase: u64
    na: fn0
    if fixed then {
        wbase = orderPositions :ast :ctx :call nameIds: argNm labelsOnly: false
        na = argNm.length
    } else {
        wbase = orderPositions :ast :ctx :call nameIds: fidsNm labelsOnly: false
    }
    ord: orderBegin :ctx slots: fn0
    k: u64
    for k < na loop {
        ai: orderNextParam :ctx base: wbase
        k = k + 1
        fi: ai
        if fixed then fi = argAt.get i: ai
        (
            orderRecordField
            :ast
            :reg
            :typing
            :ctx
            :call
            :tid
            ffid: (fids.get i: fi)
            fnameId: (fidsNm.get i: fi)
            posIdx: (ctx.orderPosAt.get i: wbase + ai)
            written: (ctx.orderWrit.get i: wbase + ai)
            slot: fi
            :ord
        )
    }
    fj: u64
    for fixed and (fj < fn0) loop {
        if (typing.isSingletonType tid: (fids.get i: fj)) then (
            orderSingletonField
            :ast
            :reg
            :typing
            :ctx
            :tid
            ffid: (fids.get i: fj)
            fnameId: (fidsNm.get i: fj)
            slot: fj
            :ord
        )
        fj = fj + 1
    }
    orderDropPositions :ctx base: wbase
    oprefix: orderFinish :ctx st: ord
    args: orderJoinSlots :ctx st: ord count: fn0
    orderEnd :ctx st: ord
    noteCreateAliasUse :ctx :tid
    rc: spelledCname :ctx :tid
    rc.append "_create"
    return (
        stating
        :facts
        from: callFacts
        text: (orderClose prefix: oprefix callee: rc.stringView args: args.stringView)
    )
}

# singletonFreeFields -- the fields of `fids` (names `fidsNm`) that take an
# argument, those not typed by a numeric parameter's singleton type: each one's
# index into the fields, and its name.
singletonFreeFields: function {
    typing: ztyping.ZTyping.view
    fids: (ListVal ztypes.tid).view
    fidsNm: (ListVal zast.nameid).view
    at: ListVal u64
    nameIds: ListVal zast.nameid
} is {
    fj: u64
    for fj < fids.length loop {
        if (typing.isSingletonType tid: (fids.get i: fj)).not then {
            at.append fj
            nameIds.append (fidsNm.get i: fj)
        }
        fj = fj + 1
    }
}

# orderSingletonField -- a field of a numeric parameter's singleton type in a
# field-wise construction: no argument names it, and its slot holds its
# default, the type's one value, a constant.
orderSingletonField: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    ffid: ztypes.tid
    fnameId: zast.nameid
    slot: u64
    ord: orderstate.borrow
} is {
    mk: pendingHoistMark :ctx
    avF: cfacts
    av: fieldDefaultText :ast :reg :typing :ctx :tid nameId: fnameId fid: ffid facts: avF
    (
        orderPartWith
        :ast
        :reg
        :typing
        :ctx
        st: ord
        mark: mk
        text: av
        tf: avF
        constant: true
        fid: ztypes.tid
        pid: ztypes.tid.zero
        pname: zast.nameid
        ctype: ""
        :slot
    )
}

# orderRecordField -- one field of a field-wise construction, its argument built
# in evaluation order into the field's slot: a borrowed reftype field takes the
# source's address.
orderRecordField: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    tid: ztypes.tid
    # the field's type and name id
    ffid: ztypes.tid
    fnameId: zast.nameid
    # the positional cursor the field's argument is read with
    posIdx: u64
    # where its argument is written, from 1; 0 for none
    written: u64
    slot: u64
    ord: orderstate.borrow
} is {
    mk: pendingHoistMark :ctx
    ca: ctorArgFor :ast :call label: fnameId :posIdx
    avF: cfacts
    av: fieldArgText :ast :reg :typing :ctx :tid :ca nameId: fnameId fid: ffid facts: avF
    # a borrowed reftype field is a pointer; a source stored INLINE (the
    # receiver's own field, a field of a parameter) is passed by address
    # the field is a pointer: whatever passes it hands on an address
    byref: fieldIsReftypePtr :reg :typing :ctx owner: tid :fnameId :ffid
    if byref when ca.labelled when (argIsPointerByLabel :ast :reg :typing :ctx :call label: fnameId
    ).not then {
        bF: cfacts
        av = (
            emitByrefArgWith
            :ast
            :reg
            :typing
            :ctx
            av: av.stringView
            :avF
            pid: ffid
            argNid: ca.nid
            facts: bF
        )
        avF = bF
    }
    constant: true
    if written > 0 then {
        constant = (
            orderConstantWith
            :ast
            :typing
            :ctx
            n: (ast.nodes.get i: (writtenArgNode :ast :call pos: written - 1))
            tf: avF
            byPtr: byref
        )
    }
    ct: String
    if constant.not then {
        ct = typeRefC :ast :reg :typing :ctx tid: ffid
        heap: isHeapPtrCollection :reg :typing :ctx tid: ffid
        if byref or heap when ct.length > 0 then ct.append "*"
    }
    (
        orderPartWith
        :ast
        :reg
        :typing
        :ctx
        st: ord
        mark: mk
        text: av
        tf: avF
        :constant
        fid: ztypes.tid
        pid: ztypes.tid.zero
        pname: zast.nameid
        ctype: ct.stringView
        :slot
    )
}

# fieldIsReftypePtr -- a borrowed field of a reftype, which the C holds as a
# pointer.
fieldIsReftypePtr: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    owner: ztypes.tid
    fnameId: zast.nameid
    ffid: ztypes.tid
} out bool is {
    if (
        typing.declIsBorrowedFieldId
        parentTypeId: owner
        nameId: fnameId
    ).not then return false
    return (borrowedFieldHeldByPointer :reg :typing :ctx fid: ffid)
}

# ctorArgPositions -- for each parameter of a construction, in declaration
# order: where its argument is written (from 1, 0 for none) and the positional
# cursor it is read with. With `labelsOnly` only a label binds an argument.
ctorArgPositions: function {
    ast: Ast.view
    call: zast.callrow.view
    nameIds: (ListVal zast.nameid).view
    labelsOnly: bool
    writ: ListVal u64
    posAt: ListVal u64
} is {
    positionalIdx: u64
    for each nm: nameIds loop {
        posAt.append positionalIdx
        if labelsOnly then {
            writ.append (
                writtenArgPosition
                :ast
                :call
                nid: (ctorArgNodeByLabel :ast :call label: nm)
            )
        } else {
            ca: ctorArgFor :ast :call label: nm posIdx: positionalIdx
            writ.append (writtenArgPosition :ast :call nid: ca.nid)
            if ca.labelled.not then positionalIdx = positionalIdx + 1
        }
    }
}

# orderPositions -- a call's parameters, `names` in declared order, are about to
# be built in the order their arguments are written: where each argument is
# written and the positional cursor it is read with, recorded from the returned
# base.
orderPositions: function {
    ast: Ast.view
    ctx: Ctx
    call: zast.callrow.view
    nameIds: (ListVal zast.nameid).view
    labelsOnly: bool
} out u64 is {
    wbase: ctx.orderWrit.length
    ctorArgPositions :ast :call :nameIds :labelsOnly writ: ctx.orderWrit posAt: ctx.orderPosAt
    for ctx.orderDone.length < (wbase + nameIds.length) loop ctx.orderDone.append false
    return wbase
}

# orderNextParam -- the parameter to build next, marked built.
orderNextParam: function {ctx: Ctx base: u64} out u64 is {
    i: nextWrittenParam writ: ctx.orderWrit done: ctx.orderDone :base
    ctx.orderDone.set i: base + i val: true
    return i
}

# orderJoinSlots -- the first `count` argument slots of the call `st` opened,
# comma separated.
orderJoinSlots: function {ctx: Ctx.view st: orderstate count: u64} out String is {
    args: String
    i: u64
    for i < count loop {
        if i > 0 then args.append ", "
        args.append (orderSlotText t: ctx :st slot: i)
        i = i + 1
    }
    return args
}

# orderArgAtWith -- an argument whose facts are `tf` and whose value is node `nid` (0 for none), just built
# from `mark`, placed in evaluation order into `slot`. A temp is typed as its own
# expression, or as the scalar `valueNid` holds.
orderArgAtWith: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    st: orderstate.borrow
    mark: hoistmark
    text: String.take
    tf: cfacts
    nid: zast.nodeid
    # the parameter takes the argument by pointer
    byPtr: bool
    slot: u64
    # the node whose value the text is, which types a scalar's temp; 0 to type
    # the temp as its own expression -- a by-pointer argument's text is an
    # address, not the node's value
    valueNid: zast.nodeid.zero
} is {
    constant: true
    if nid.notZero then constant = (
        orderConstantWith
        :ast
        :typing
        :ctx
        n: (ast.nodes.get i: nid)
        :tf
        :byPtr
    )
    (
        orderPartWith
        :ast
        :reg
        :typing
        :ctx
        :st
        :mark
        :text
        :tf
        :constant
        fid: ztypes.tid
        pid: ztypes.tid.zero
        pname: zast.nameid
        ctype: ""
        :slot
        :valueNid
    )
}

# orderDropPositions -- a call's parameter positions are read: release them.
orderDropPositions: function {ctx: Ctx base: u64} is {
    for ctx.orderWrit.length > base loop {
        ctx.orderWrit.pop
        ctx.orderPosAt.pop
        ctx.orderDone.pop
    }
}

# ctorarg -- the argument node a constructor parameter binds.
ctorarg: record {
    # the argument node; 0 when the call supplies none
    nid: zast.nodeid
    # whether the call spelled the parameter's label; otherwise the node came
    # from the positional cursor, which the caller then advances
    labelled: bool
}

# ctorArgFor -- the argument a constructor parameter binds: the labelled
# argument when the call spells the label, else the positional argument at
# `posIdx`.
ctorArgFor: function {
    ast: Ast.view
    call: zast.callrow.view
    label: zast.nameid
    posIdx: u64
} out ctorarg is {
    if (ctorHasLabel :ast :call :label) then {
        return (ctorarg nid: (ctorArgNodeByLabel :ast :call :label) labelled: true)
    }
    return (ctorarg nid: (ctorArgNodeByPosition :ast :call idx: posIdx) labelled: false)
}

# the constructor-argument node matching a field label.
ctorArgNodeByLabel: function {
    ast: Ast.view call: zast.callrow.view label: zast.nameid
} out zast.nodeid is {
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation when a.name == label then return a.operation
    }
    return zast.nodeid
}

# ctorArgByLabel -- that argument's emitted text. Selected through the node
# above so a caller can ask about the same argument by node.
ctorArgByLabel: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    label: zast.nameid
} out String is {
    facts: cfacts
    return (ctorArgByLabelWith :ast :reg :typing :ctx :call :label :facts)
}

# ctorArgByLabelWith -- ctorArgByLabel, its facts stated into `facts`.
ctorArgByLabelWith: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    label: zast.nameid
    facts: cfacts.borrow
} out String is {
    aid: ctorArgNodeByLabel :ast :call :label
    if aid.isZero then return (stating :facts from: constFacts text: "0".string)
    return (ctorArgTextAt :ast :reg :typing :ctx :aid :facts)
}

# ctorArgTextAt -- one argument node's emitted text. An interpolated argument
# builds through a self-contained statement expression, which emitExpr cannot
# emit as a chain, so it is asked for first.
ctorArgTextAt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    aid: zast.nodeid
    facts: cfacts.borrow
} out String is {
    n: ast.nodes.get i: aid
    # a VIEW of an interpolation is no String: it is read off the string's
    # temporary as any view of a value is (valueExprC)
    if (interpStorageNid :ast :typing :n) == aid then {
        iv: emitInterpArgExpr :ast :reg :typing :ctx :n
        if iv.length > 0 then return (stating :facts from: callFacts text: iv)
    }
    return (valueExprC :ast :reg :typing :ctx :n :facts)
}

# argAlreadyPointer -- does this argument expression already evaluate to the C
# pointer a pointer parameter takes, so that addressing it again would hand the
# callee a `T**`? Three ways it can be one, and a site that asks only one is
# wrong: a bare local holding a reference answers through its VID (isPtrVid,
# which a narrowing turns off: the name then reads as its payload); a Set or a
# Map lives on the heap and is always its pointer; a path -- a non-owned
# reftype field, a reference-returning call -- has no vid of its own and only
# `pathIsPointer` sees it. Every byref decision, a receiver's included, asks
# this, not one part of it.
argAlreadyPointer: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    vid: ztypes.vid
} out bool is {
    if (isPtrVid :ctx :vid) then return true
    if (
        isHeapPtrCollection
        :reg
        :typing
        :ctx
        tid: (stampIdOf :typing nid: (interpPartNodeId :n))
    ) then return true
    return (pathIsPointer :ast :reg :typing :ctx :n)
}

# argIsPointerByLabel -- true when the arg at `label` already evaluates to a C
# pointer (a reftype/List param or a borrowed field), so a native by-pointer
# parameter must pass it directly rather than re-addressing it with `&`.
argIsPointerByLabel: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    label: zast.nameid
} out bool is {
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation when a.name == label then return (
            pathIsPointer
            :ast
            :reg
            :typing
            :ctx
            n: (ast.nodes.get i: a.operation)
        )
    }
    return false
}

# ctorArgNodeByPosition -- ctorArgByPosition's node id rather than its C text,
# for a caller that must look the argument up again instead of printing it.
# 0 when there is no positional argument at that index.
ctorArgNodeByPosition: function {
    ast: Ast.view call: zast.callrow.view idx: u64
} out zast.nodeid is {
    seen: u64
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.length == 0 then {
                if seen == idx then return a.operation
                seen = seen + 1
            }
        }
    }
    return zast.nodeid
}

# ctorArgByPosition -- the idx-th POSITIONAL (unlabeled) argument's C text, for a
# method call passing args positionally (`this.formatLockHolder holder`) rather
# than by label; "" when there is no such arg.
# ctorArgByPosition -- that argument's emitted text, selected through the node
# above so a caller can ask about the same argument by node.
ctorArgByPosition: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    idx: u64
    facts: cfacts.borrow
} out String is {
    posParamId: ctorArgNodeByPosition :ast :call :idx
    if posParamId.isZero then return "".string
    return (ctorArgTextAt :ast :reg :typing :ctx aid: posParamId :facts)
}

# ctorInterpArgAt -- the interp-arg form (emitInterpArgForParam) for one
# argument node, or "" when there is none or it is not an interpolated
# literal. Lets a method or constructor call pass an interpolated literal
# directly: build, coerce, free. The caller finds the node, by label or by
# position, through the finders above.
ctorInterpArgAt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    aid: zast.nodeid
    fid: ztypes.tid
    pnameId: zast.nameid
    pid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    if aid.isZero then return "".string
    return (
        emitInterpArgForParam
        :ast
        :reg
        :typing
        :ctx
        n: (ast.nodes.get i: aid)
        :fid
        :pnameId
        :pid
        :facts
    )
}

# argSlotList -- per call-argument (in call order), the index of the parameter
# slot it binds in `fpNames` (declaration order): a named arg binds by name, an
# unlabelled arg binds the next free slot via a positional cursor (first-arg
# elision). Returns `fpNames.length` (an out-of-range sentinel) for an argument
# that binds no value slot (e.g. a generic type-arg, whose name is not a value
# param). Lets a call's named args be emitted to C in PARAMETER order.
argSlotList: function {
    ast: Ast.view
    call: zast.callrow.view
    fpNameIds: (ListVal zast.nameid).view
} out ListVal u64 is {
    result: ListVal u64
    cn: fpNameIds.length
    consumed: ListVal bool
    ci: u64
    for ci < cn loop {
        consumed.append false
        ci = ci + 1
    }
    cursor: u64
    for each argId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: argId
        match (
            a
        ) case namedoperation then {
            # the label and the parameter names are both pool ids already, so
            # the match is an id compare. An UNLABELLED argument carries no name;
            # the empty spelling has an id of its own, so both are excluded
            hasLbl: a.name.notZero
            if hasLbl when a.name == zast.wellKnown.slot.wkEmpty then hasLbl = false
            slot: fpNameIds.length
            if hasLbl then {
                fi: u64
                for fi < cn loop {
                    if (fpNameIds.get i: fi) == a.name then slot = fi
                    fi = fi + 1
                }
            } else {
                adv: true
                for adv loop {
                    if cursor >= cn then {
                        adv = false
                    } else {
                        if (consumed.get i: cursor) then {
                            cursor = cursor + 1
                        } else {
                            adv = false
                        }
                    }
                }
                if cursor < cn then {
                    slot = cursor
                    cursor = cursor + 1
                }
            }
            if slot < cn then consumed.set i: slot val: true
            result.append slot
        } else {
            result.append fpNameIds.length
        }
    }
    return result
}

# constScalarKindForTid -- the scalar kind a folded constant of type `tid` is
# rendered in: the type's own, or the builtin a scalar TYPEDEF chases to
# (`nameid` -> u64), keyed by tid so the answer does not depend on which unit the
# read happens in. `has` false when the type is no scalar at all -- a program's
# own type spelled like one included.
constScalarKindForTid: function {
    typing: ztyping.ZTyping.view tid: ztypes.tid
} out ztypes.suffixinfo is {
    return (
        ztypecheck.numKindOfTid
        :typing
        tid: (ztypecheck.typedefChaseTid :typing :tid)
    )
}

# narrowConstToKind -- a folded i64 reduced to what integer kind `k` can actually
# hold, the way the runtime operator does it. The evaluator holds an i64 whatever
# the width, and an inline use (an interpolation, a nested operator) has no
# assignment to truncate it the way a binding's C initializer does, so the
# rendering keeps to the node's type itself.
narrowConstToKind: function {v: i64 k: ztypes.numkind} out i64 is {
    b: ztypes.intKindBits :k
    if (b == 0) or (b >= 64) then return v
    span: 1 << (b.i64.or d: 0)
    t: v & (span - 1)
    if (ztypes.isSignedIntKind :k) when t >= (span / 2) then return t - span
    return t
}

# floatValueC -- the C literal for float kind `k`'s value nearest the number
# constant `v`: its IEEE 754 bits, rounded once by the checker, spelled
# exactly in hexadecimal at the format's own width -- `f` for an f32, `Q` for
# an f128 (inside `__extension__`, as the suffix is not ISO C), a cast for an
# f16 (whose every value a double spells), nothing for an f64 -- so every C
# compiler reads the same value. "" for an infinity,
# which the checker refuses before it gets here.
floatValueC: function {
    typing: ztyping.ZTyping.view v: ztypes.cval k: ztypes.numkind
} out String is {
    return (floatBitsC bits: (ztypecheck.constFloatBits :typing :v :k) :k)
}

# floatBitsC -- floatValueC for the bits themselves
floatBitsC: function {bits: math.BigInt.view k: ztypes.numkind} out String is {
    mb: (ztypes.mantissaOf :k) - 1
    eb: ztypes.floatExpBits :k
    one: math.BigInt from: 1
    field: ((bits >> mb) & ((one << eb) - one)).i64.orPanic
    frac: bits & ((one << mb) - one)
    if field == ((1 << eb.i64.orPanic) - 1) then return "".string
    bias: (1 << (eb - 1).i64.orPanic) - 1
    r: String
    if k.f16Type then r.append "Z_F16_C("
    if k.f128Type then r.append "(__extension__ "
    if (bits.bit i: mb + eb) == 1 then r.append "-"
    # the fraction's bits, padded to whole hex digits
    pad: 4.u64 - (mb % 4) % 4
    digits: (frac << pad).text base: 16
    width: mb + pad / 4
    lead: "1"
    e: field - bias
    if field == 0 then {
        lead = "0"
        e = 1 - bias
        if frac.sign == 0 then e = 0
    }
    r.append "0x\{lead}."
    for each z: (width - digits.length).times loop {
        z.drop
        r.append "0"
    }
    r.append digits
    r.append "p\{e}"
    if k.f32Type then r.append "f"
    if k.f128Type then r.append "Q)"
    if k.f16Type then {
        # and its bits, which is the value where the C compiler has no _Float16
        hb: bits.text base: 16
        r.append ", 0x\{hb})"
    }
    return r
}

# cvalText -- the C literal for a compile-time value the typechecker folded.
# "" for a kind this emitter cannot render yet, which leaves the caller on its
# ordinary path rather than emitting something wrong.
cvalText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    v: ztypes.cval
    facts: cfacts.borrow
} out String is {
    if v.kind.ivalKind then return (
        stating
        :facts
        from: constFacts
        text: (intCvalText :typing :ctx :tid :v)
    )
    if v.kind.fvalKind then {
        return (stating :facts from: constFacts text: (floatCvalText :typing :tid :v))
    }
    if v.kind.armKind then return (armCvalText :ast :reg :typing :ctx :v :facts)
    if v.kind.aggKind then return (aggCvalText :typing :ctx :v :facts)
    return "".string
}

# armCvalText -- cvalText for an arm with no payload. A variant that maps onto a
# scalar C type (bool) renders as that scalar; anything else is the
# payload-less compound literal emitInlineVariantCtor builds for the same arm
# written as a call. Either spells a tag constant its enum declares.
armCvalText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    v: ztypes.cval
    facts: cfacts.borrow
} out String is {
    if v.armTid.isZero then return "".string
    if v.armName.isZero then return "".string
    # a scalar arm (`true`) spells only its tag constant, never the type
    atomVarId: armValueC :ast :ctx :reg :typing tid: v.armTid arm: v.armName
    if atomVarId.length > 0 then return (stating :facts from: constFacts text: atomVarId)
    tg: spelledTagConst :ast :ctx :reg :typing tid: v.armTid armId: v.armName
    if tg.length == 0 then return "".string
    vc: spelledCname :ctx tid: v.armTid
    if vc.length == 0 then return "".string
    return (stating :facts from: literalFacts text: "((\{vc}_t){ .tag = \{tg} })")
}

# aggCvalText -- cvalText for an aggregate: a data value is the address of its
# static object (writeDemandedAggs), a choice value that object itself, a list
# the view of its array.
aggCvalText: function {
    typing: ztyping.ZTyping.view ctx: Ctx v: ztypes.cval facts: cfacts.borrow
} out String is {
    if (typing.constAggs.get i: v.aggId.u64).kind.staticList then return (
        stating
        :facts
        from: literalFacts
        text: (listValueC :typing :ctx row: v.aggId)
    )
    noteAggUse :ctx row: v.aggId
    # a choice value is held by value: its static object, read whole
    if (typing.constAggs.get i: v.aggId.u64).kind.staticChoice then return (
        stating
        :facts
        from: constFacts
        text: "_zag\{v.aggId}"
    )
    return (stating :facts from: constFacts text: "(&_zag\{v.aggId})")
}

# intCvalText -- cvalText for a folded integer: inline in the type it is
# narrowed to, or a value outside i64 spelled whole.
intCvalText: function {
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    v: ztypes.cval
} out String is {
    nk: constScalarKindForTid :typing :tid
    if nk.has when (ztypes.intKindBits k: nk.kind) == 128 then {
        sg: ztypes.isSignedIntKind k: nk.kind
        if v.bigId != 0 then return (
            int128WordsC
            :ctx
            b: (ztypecheck.constBigOf :typing :v)
            signed: sg
        )
        return (int128WordsC :ctx b: (math.BigInt from: v.ival) signed: sg)
    }
    if v.bigId != 0 then return (bigConstC :typing :ctx :v)
    iv: v.ival
    if nk.has then iv = narrowConstToKind v: v.ival k: nk.kind
    # C HAS NO NEGATIVE LITERALS. A leading `-` is an operator applied to a
    # POSITIVE constant, and the magnitude of the most negative i64 is one
    # past what a signed constant can hold -- so `-9223372036854775808`
    # reads as unsigned and the value arrives with the wrong type. It is
    # the one value that cannot be written directly; C spells it by
    # subtracting from the one below it, and so does this.
    if iv == (0 - 9223372036854775807 - 1) then return "(-9223372036854775807LL - 1)".string
    r: "\{iv}"
    sfx: ""
    if nk.has then sfx = kindLitSuffix k: nk.kind
    # a signed magnitude past 2^31 - 1 is a long long: said, because a C
    # compiler with a 32-bit long that reads such a decimal as unsigned long
    # (MSVC does) would otherwise negate it as unsigned
    if sfx.length == 0 when (iv > 2147483647) or (iv < (0 - 2147483647)) then sfx = "LL"
    r.append sfx
    return r
}

# bigConstC -- an integer constant outside i64 as C, spelled by its value: the
# checker settled it in a type that holds it, and C converts it there.
bigConstC: function {typing: ztyping.ZTyping.view ctx: Ctx v: ztypes.cval} out String is {
    b: ztypecheck.constBigOf :typing :v
    return (bigValueC :ctx :b)
}

# bigValueC -- an integer outside i64 as C. A u64 is its digits, unsigned;
# anything wider is built from two 64-bit halves of its 128-bit two's
# complement form, since C has no 128-bit literal -- signed when the value is
# negative. "" past 128 bits, which no type holds.
bigValueC: function {ctx: Ctx b: math.BigInt.view} out String is {
    if b.sign > 0 when b.bitLength <= 64 then return "\{b.string}ULL"
    if b.bitLength > 128 then return "".string
    if b.sign < 0 then return (int128WordsC :ctx :b signed: true)
    return (int128WordsC :ctx :b signed: false)
}

# floatCvalText -- cvalText for a folded float: the value the float type it is
# written as holds nearest it, an f64 where the type is no float one.
floatCvalText: function {
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    v: ztypes.cval
} out String is {
    fk: constScalarKindForTid :typing :tid
    k: ztypes.numkind.f64Type
    if fk.has when (ztypes.isFloatKind k: fk.kind) then k = fk.kind
    return (floatValueC :typing :v :k)
}

# cvalStrText -- the C text for a folded STRING value: a `_zcsN` static minted
# in ctx.constLits. "" for any other kind, which leaves the caller on its
# ordinary path exactly as cvalText's "" does.
#
# Deduplicated by TEXT, not by origin: two constants that fold to the same bytes
# are one static, and a folded value has no node identity to key on anyway.
cvalStrText: function {
    typing: ztyping.ZTyping.view ctx: Ctx v: ztypes.cval facts: cfacts.borrow
} out String is {
    if v.kind.svalKind.not then return "".string
    if v.strId == 0 then return "".string
    t: typing.constStrings.get i: v.strId
    i: u64
    n: ctx.constLits.length
    hit: u64
    for i < n loop {
        if hit == 0 then {
            e: ctx.constLits.get :i
            if e.stringView == t then hit = i + 1
        }
        i = i + 1
    }
    if hit > 0 then {
        return (stating :facts from: pathFacts text: (constLitView :ctx ci: hit))
    }
    ctx.constLits.append t.copy
    return (stating :facts from: pathFacts text: (constLitView :ctx ci: ctx.constLits.length))
}

# foldedBranchOf -- the clause the typechecker's constant fold selected for an
# `if` or a `match`. `known` false means the conditions did not all fold, so a
# runtime branch must be emitted; `known` true with a zero stmt means nothing
# was selected and nothing is emitted at all.
foldedBranchOf: function {
    typing: ztyping.ZTyping.view
    nid: zast.nodeid
} out ztyping.foldedbranch is {
    return (typing.foldedBranchAt :nid)
}

# condFoldsTrue -- the checker's fold read this loop condition as true, so it
# writes no test.
condFoldsTrue: function {typing: ztyping.ZTyping.view nid: zast.nodeid} out bool is {
    return (typing.condFoldsTrueAt :nid)
}

# foldedLoopOf -- what the typechecker's constant fold read of a loop's
# conditions, and whether that leaves the loop any normal way out.
foldedLoopOf: function {
    typing: ztyping.ZTyping.view
    nid: zast.nodeid
} out ztyping.foldedloop is {
    return (typing.foldedLoopAt :nid)
}

# nodeConstText -- the C literal for a node carrying a compile-time const
# stamp; "" otherwise, which leaves the caller on its ordinary emit path.
#
# A FLOAT renders as the value its node's type holds nearest it, rounded once
# from the exact value the checker folded -- the node's type being where the
# value landed -- as the integer, string and arm domains render exactly.
#
# A STRING VALUE ON A `String` NODE IS REFUSED TOO. The `_zcsN` static is a
# StringView of program memory, and a `String` node -- `"ab" + "cd"` in a body
# -- is an owned buffer its binding frees. The ordinary path builds that buffer,
# and its operands still render as their statics.
nodeConstText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nid: zast.nodeid
    facts: cfacts.borrow
} out String is {
    if nid.isZero then return "".string
    g: typing.nodeConstAt :nid
    if g.kind.none then return "".string
    tv: stampIdOf :typing :nid
    # an untyped constant landing in an i128, u128 or f16 is spelled as that
    # type
    wt: typing.helperScalarTarget.get key: nid
    if wt.some then {
        tv = wt
    }
    if g.kind.svalKind when (chaseStrTypedef :typing :ctx tid: tv) == ctx.strTid then {
        return "".string
    }
    sc: cvalText :ast :reg :typing :ctx tid: tv v: g :facts
    if sc.length > 0 then return sc
    # a folded string is its pooled static, `_zcsN`
    return (cvalStrText :typing :ctx v: g :facts)
}

# memberConstTid -- the declared type of a unit constant, 0 when it has none.
memberConstTid: function {
    typing: ztyping.ZTyping.view
    unitTid: ztypes.tid
    nameId: zast.nameid
} out ztypes.tid is {
    co: typing.declChildOfId parentTypeId: unitTid :nameId
    match (
        co
    ) case some then {
        return co
    } case none then {
        return ztypes.tid
    }
}

# memberConstText -- the C text for a unit constant, rendered from its VALUE
# and carrying the literal suffix its declared type asks for. "" when the
# member has no compile-time value, which is what leaves the caller on its
# ordinary path. SCALARS ONLY: a folded string is memberConstStringText's.
memberConstText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    unitTid: ztypes.tid
    nameId: zast.nameid
    facts: cfacts.borrow
} out String is {
    if unitTid.isZero then return "".string
    if nameId.isZero then return "".string
    mv: typing.memberConstOf parentTypeId: unitTid :nameId
    if mv.kind.none then return "".string
    mt: memberConstTid :typing :unitTid :nameId
    return (cvalText :ast :reg :typing :ctx tid: mt v: mv :facts)
}

# memberConstStringText -- the `_zcsN` a STRING constant renders as: the string
# half of memberConstText, split off because minting needs a mutable Ctx.
memberConstStringText: function {
    typing: ztyping.ZTyping.view
    ctx: Ctx
    unitTid: ztypes.tid
    nameId: zast.nameid
    facts: cfacts.borrow
} out String is {
    if unitTid.isZero then return "".string
    if nameId.isZero then return "".string
    mv: typing.memberConstOf parentTypeId: unitTid :nameId
    return (cvalStrText :typing :ctx v: mv :facts)
}

# mainUnitTid -- the type id of the unit being emitted: its declaration's type,
# never a name looked up at the program root.
mainUnitTid: function {typing: ztyping.ZTyping.view ctx: Ctx.view} out ztypes.tid is {
    return (typing.declTypeOf declId: ctx.mainUnitId)
}

# ctorHasLabel -- whether a call carries a named argument with this label.
ctorHasLabel: function {ast: Ast.view call: zast.callrow.view label: zast.nameid} out bool is {
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation when a.name == label then return true
    }
    return false
}

# emitMetaCreateCall -- `meta.create field: val ...`, the enclosing type's raw
# allocator (its field children as params). The typecheck stamps the call node
# with that type; emit `{type}_meta_create(args)` (never `_create`, which the
# user's own create may override -> recursion). "" when not a meta.create.
emitMetaCreateCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    mcb: ztypecheck.metaCreateBaseId :ast n: (ast.nodes.get i: call.callable)
    match (
        mcb
    ) case some then {
        et: stampIdOf :typing nid: call.nodeid
        if et.isZero then return "".string
        fnames: List String
        fids: ListVal ztypes.tid
        fidsNm: ListVal zast.nameid
        recFieldLists :ast :reg :typing tid: et names: fnames ids: fids nameIds: fidsNm
        fn0: fnames.length
        # the fields' arguments are built in the order they are written
        wbase: orderPositions :ast :ctx :call nameIds: fidsNm labelsOnly: true
        ord: orderBegin :ctx slots: fn0
        k: u64
        for k < fn0 loop {
            fi: orderNextParam :ctx base: wbase
            k = k + 1
            wr: ctx.orderWrit.get i: wbase + fi
            mk: pendingHoistMark :ctx
            avF: cfacts
            av: (
                metaCreateFieldText
                :ast
                :reg
                :typing
                :ctx
                :call
                :et
                fnameId: (fidsNm.get i: fi)
                :fids
                :fi
                facts: avF
            )
            ptrField: (
                fieldIsReftypePtr
                :reg
                :typing
                :ctx
                owner: et
                fnameId: (fidsNm.get i: fi)
                ffid: (fids.get i: fi)
            )
            constant: true
            ct: String
            if wr > 0 then {
                constant = (
                    orderConstantWith
                    :ast
                    :typing
                    :ctx
                    n: (ast.nodes.get i: (writtenArgNode :ast :call pos: wr - 1))
                    tf: avF
                    byPtr: ptrField
                )
                if constant.not then {
                    ct = typeRefC :ast :reg :typing :ctx tid: (fids.get i: fi)
                    heapM: isHeapPtrCollection :reg :typing :ctx tid: (fids.get i: fi)
                    if ptrField or heapM when ct.length > 0 then ct.append "*"
                }
            }
            (
                orderPartWith
                :ast
                :reg
                :typing
                :ctx
                st: ord
                mark: mk
                text: av
                tf: avF
                :constant
                fid: ztypes.tid
                pid: ztypes.tid.zero
                pname: zast.nameid
                ctype: ct.stringView
                slot: fi
            )
        }
        orderDropPositions :ctx base: wbase
        oprefix: orderFinish :ctx st: ord
        args: orderJoinSlots :ctx st: ord count: fn0
        orderEnd :ctx st: ord
        noteCreateUse :ctx tid: et
        ecb: spelledCname :ctx tid: et
        ecb.append "_meta_create"
        return (
            stating
            :facts
            from: callFacts
            text: (orderClose prefix: oprefix callee: ecb.stringView args: args.stringView)
        )
    } case none then {
        return "".string
    }
}

# metaCreateFieldText -- one field of a `meta.create`: its labelled argument, a
# borrowed reftype field taking the source's address, or the typed zero of a
# field the call leaves out.
metaCreateFieldText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    et: ztypes.tid
    # the field's name, interned
    fnameId: zast.nameid
    fids: (ListVal ztypes.tid).view
    fi: u64
    facts: cfacts.borrow
} out String is {
    av: String
    avF: cfacts
    if (ctorHasLabel :ast :call label: fnameId) then {
        av = ctorArgByLabelWith :ast :reg :typing :ctx :call label: fnameId facts: avF
        # a borrowed reftype field is a pointer; a source stored INLINE
        # (the receiver's own field, a field of a parameter) is passed
        # by address
        ffidL: fids.get i: fi
        if (typing.declIsBorrowedFieldId parentTypeId: et nameId: fnameId) when (
            borrowedFieldHeldByPointer
            :reg
            :typing
            :ctx
            fid: ffidL
        ) when (argIsPointerByLabel :ast :reg :typing :ctx :call label: fnameId).not then {
            avMF: cfacts
            avM: (
                emitByrefArgWith
                :ast
                :reg
                :typing
                :ctx
                av: av.stringView
                :avF
                pid: ffidL
                argNid: (ctorArgNodeByLabel :ast :call label: fnameId)
                facts: avMF
            )
            av = avM.take
            avF = avMF
        }
    } else if (typing.isSingletonType tid: (fids.get i: fi)) then {
        # a field of a numeric parameter's singleton type takes no argument:
        # it holds its default, the type's one value
        av = (
            fieldDefaultText
            :ast
            :reg
            :typing
            :ctx
            tid: et
            nameId: fnameId
            fid: (fids.get i: fi)
            facts: avF
        )
    } else {
        # a field absent from the meta.create args (a generator's state: a
        # local the body keeps, an inner iterator struct or a loop counter) is
        # value-initialized; a typed zero compiles for both scalars and structs.
        ffid: fids.get i: fi
        ffct: typeRefC :ast :reg :typing :ctx tid: ffid
        if ffct.length == 0 then {
            failMsg: "zemitterc: unspellable field type id \{ffid}"
            panic failMsg
        }
        if (typing.declIsBorrowedFieldId parentTypeId: et nameId: fnameId) when (
            borrowedFieldHeldByPointer
            :reg
            :typing
            :ctx
            fid: ffid
        ) then {
            ffctP: storedFieldPtrC :typing ownerTid: et :fnameId fct: ffct.stringView
            ffct = ffctP.take
        }
        av = "(\{ffct}){0}"
        avF = literalFacts
    }
    return (stating :facts from: avF text: av)
}

# emitByrefArgWith -- an argument whose facts are `avF`, passed BY REFERENCE. A
# non-lvalue has no address to take, so it is hoisted (hoistForAddress) into a
# temp of the parameter's own C type and the temp's address goes to the call
# instead.
emitByrefArgWith: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    av: StringView
    avF: cfacts
    pid: ztypes.tid
    argNid: zast.nodeid
    # the facts of the address handed back
    facts: cfacts.borrow
} out String is {
    # as for a by-value argument: a typedef built inline from a consumed local
    # is hoisted, so the temporary's free runs
    if avF.place when (ownedTypedefArg :typing :argNid).not then {
        return (stating :facts from: (addrFacts e: avF) text: "&\{av}")
    }
    nmH: hoistForAddress :ast :reg :typing :ctx :av tid: pid :argNid
    return (stating :facts from: (addrFacts e: pathFacts) text: "&\{nmH}")
}

# appendSlotOrDefault -- one parameter slot of a call, appended to `args`: the
# argument written into it, else the parameter's declared default; a slot with
# neither is left out.
appendSlotOrDefault: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
    ord: orderstate
    slot: u64
    # the parameter's name id (a raw pool index) and type
    nameId: zast.nameid
    pid: ztypes.tid
    args: String.borrow
} is {
    vo: orderSlotText t: ctx st: ord :slot
    if vo.length > 0 then {
        if args.length > 0 then args.append ", "
        args.append vo
        return
    }
    vo.drop
    nm: nameId
    if (typing.declHasDefaultId parentTypeId: fid nameId: nm).not then return
    if args.length > 0 then args.append ", "
    facts: cfacts
    args.append (paramDefaultText :ast :reg :typing :ctx cco: fid :nameId :pid :facts)
}

# receiverCallText -- `callee(recv)` for a method called with its receiver
# alone, its other parameters filled with their declared defaults. An empty
# `recv` is a member that takes no receiver: its defaults alone.
receiverCallText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    callee: StringView
    recv: StringView
    fnTid: ztypes.tid
} out String is {
    r: callee.string
    r.append "("
    r.append recv
    da: renderedMethodDefaultArgs :ast :reg :typing :ctx :fnTid
    if da.length > 0 then {
        if recv.length > 0 then r.append ", "
        r.append da
    }
    r.append ")"
    return r
}

# emitFnCallWithFid -- the argument work a call shares once its callee is
# known: the parameter lists, the slot each written argument fills, and per
# argument the pointer / byref / borrow-hoist question the parameter's own
# ownership answers. What differs between a generic function, a generic unit's
# method and a cross-unit function is only HOW the callee is found, which is
# each caller's guard.
emitFnCallWithFid: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    fid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    fc: spelledCname :ctx tid: fid
    fpNames: List String
    fpIds: ListVal ztypes.tid
    paramNameIds: ListVal zast.nameid
    recFieldLists :ast :reg :typing tid: fid names: fpNames ids: fpIds nameIds: paramNameIds
    argSlots: argSlotList :ast :call fpNameIds: paramNameIds
    ord: orderBegin :ctx slots: fpNames.length
    ai: u64
    for each argId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: argId
        if a.namedoperation then {
            argSlot: argSlots.get i: ai
            if argSlot < fpNames.length then {
                (
                    orderUserFnArg
                    :ast
                    :reg
                    :typing
                    :ctx
                    :fid
                    pinId: (fpIds.get i: argSlot)
                    pinNmId: (paramNameIds.get i: argSlot)
                    pname: (paramNameIds.get i: argSlot)
                    argOpNode: (ast.nodes.get i: a.operation)
                    slot: argSlot
                    :ord
                )
            }
            ai = ai + 1
        }
    }
    orderPrefix: orderFinish :ctx st: ord
    argTids: String
    pi: u64
    paramCount: fpNames.length
    for pi < paramCount loop {
        (
            appendSlotOrDefault
            :ast
            :reg
            :typing
            :ctx
            :fid
            :ord
            slot: pi
            nameId: (paramNameIds.get i: pi)
            pid: (fpIds.get i: pi)
            args: argTids
        )
        pi = pi + 1
    }
    orderEnd :ctx st: ord
    return (
        stating
        :facts
        from: callFacts
        text: (orderClose prefix: orderPrefix callee: fc.stringView args: argTids.stringView)
    )
}

# emitGenericFnCall -- a generic free-function call (identity 42): the callable
# atom is stamped to the mono FUNCTION id by checkGenericCall. Emit that mono's
# cname applied to the args. "" when the callable does not resolve to a mono fn,
# or when the mono's template is NATIVE (no emitted body -- its C is the
# runtime's, as collections.stringJoin's is).
emitGenericFnCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    gdc: aliasChildName :ast :typing n: (ast.nodes.get i: call.callable)
    if gdc.length > 0 then return "".string
    gmf: stampIdOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: call.callable))
    if gmf.isZero then return "".string
    if (reg.typetypeOf typeId: gmf) != ztypes.ztypetype.functionType then return "".string
    gmo: originTidOf :reg tid: gmf
    if gmo.isZero then return "".string
    if (reg.isNativeOf tid: gmf) then return "".string
    return (emitFnCallWithFid :ast :reg :typing :ctx :call fid: gmf :facts)
}

# dottedMemberTidOf -- the type id a dotted callable's `base.child` names when
# its base names a unit: the type the checker stamped the callable with. 0 when
# the base names no unit.
dottedMemberTidOf: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    callableId: zast.nodeid
} out ztypes.tid is {
    pb: dottedParentNodeId n: (ast.nodes.get i: callableId)
    if (pathUnitTidOf :reg :typing baseId: pb).isZero then return ztypes.tid
    return (stampIdOf :typing nid: callableId)
}

# calledInstanceOf -- the function a call to `fid` runs. The checker stamps
# the callable of a generic template's call with the instance it runs, so the
# template is answered by that instance; a native template has no emitted
# instance, and any other call runs `fid` itself.
calledInstanceOf: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    call: zast.callrow.view
    fid: ztypes.tid
} out ztypes.tid is {
    sf: stampIdOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: call.callable))
    if (originIsTid :reg tid: sf originTid: fid).not then return fid
    if (reg.isNativeOf tid: sf) then return fid
    return sf
}

# emitCrossUnitFnCall -- a cross-unit free-function call `unit.fn args`
# (e.g. zparser calling a zast/zlexer helper). The callee is a dottedpath whose
# base is a unit name; the function's shared id lives in resolved["{unit}.{fn}"],
# so emit z_t{id}_{fn}(args) with the same reftype-by-ref arg handling as a bare
# free-function call. "" when the callee is not a cross-unit function.
emitCrossUnitFnCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    fid: dottedMemberTidOf :ast :reg :typing callableId: call.callable
    if fid.isZero then return "".string
    if (reg.typetypeOf typeId: fid) != ztypes.ztypetype.functionType then return "".string
    return (
        emitFnCallWithFid
        :ast
        :reg
        :typing
        :ctx
        :call
        fid: (calledInstanceOf :ast :reg :typing :call :fid)
        :facts
    )
}


# emitCrossUnitBareCreate -- a bare (no-arg) cross-unit construction
# `unit.Type.create` written as a dotted path (not a call): emit `<Type>_create()`
# (the user create, no receiver). "" when not such a 3-segment bare create.
emitCrossUnitBareCreate: function {
    ctx: Ctx
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    parent: astnode.view
    childId: zast.nameid
    facts: cfacts.borrow
} out String is {
    if childId != zast.wellKnown.slot.wkCreate then return "".string
    ptId: aliasChildNameId :ast :typing n: parent
    if ptId.isZero then return "".string
    ud2x: baseFileUnitDecl :reg :typing baseId: (dottedParentNodeId n: parent)
    if ud2x.isZero then return "".string
    go: ztypecheck.resolvedByIdsRo :ast :typing unitDecl: ud2x name: ptId
    tid: ztypes.tid
    if go.some then {
        tid = go
    }
    if tid.isZero then return "".string
    cco: typing.declChildOfId parentTypeId: tid nameId: zast.wellKnown.slot.wkCreate
    if cco.some when (reg.typetypeOf typeId: cco) == ztypes.ztypetype.functionType then {
        noteFnUse :ctx tid: cco
        ccb: ctxCname :ctx tid: cco
        return (stating :facts from: callFacts text: "\{ccb}()")
    }
    return "".string
}


# emitCrossUnitCtor -- construction of a cross-unit record/class
# `unit.TypeName field: val ...` (e.g. a astnode arm's zast.ErrorData payload):
# resolve the type via the shared cross-unit identity and route to the field-wise
# (or user-create) constructor. "" when not such a construction.
emitCrossUnitCtor: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    tid: dottedMemberTidOf :ast :reg :typing callableId: call.callable
    if tid.isZero then return "".string
    # a generic type's construction built the instance the call is stamped with
    if (reg.isGenericOf :tid) then {
        inst: stampIdOf :typing nid: call.nodeid
        if (reg.genericOriginOf tid: inst) == tid then tid = inst
    }
    tt: reg.typetypeOf typeId: tid
    isRc: tt.isFieldwise
    if isRc.not then return "".string
    return (emitRecordCtor :ast :reg :typing :ctx :call :tid :facts)
}

# emitCrossUnitTag -- a 3-segment cross-unit variant/enum tag value
# `unit.Type.arm` (zlexer.toktype.dotTok, zast.err.badReference): pbase=unit, ptype=Type,
# arm=arm. Resolve the variant via the shared cross-unit identity and emit the
# no-payload tag value. "" when not such a reference.
emitCrossUnitTag: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the node of the unit segment
    pbase: zast.nodeid
    ptype: zast.nameid
    arm: zast.nameid
    facts: cfacts.borrow
} out String is {
    if ptype.isZero or arm.isZero then return "".string
    ud5x: baseFileUnitDecl :reg :typing baseId: pbase
    if ud5x.isZero then return "".string
    go: ztypecheck.resolvedByIdsRo :ast :typing unitDecl: ud5x name: ptype
    vtid: ztypes.tid
    if go.some then {
        vtid = go
    }
    if vtid.isZero then return "".string
    vtt: reg.typetypeOf typeId: vtid
    isTagged: vtt.isSum
    if isTagged.not then return "".string
    pc: armPayloadC :ast :reg :typing :ctx tid: vtid :arm
    if pc.length == 0 then {
        avx: armValueC :ast :ctx :reg :typing tid: vtid :arm
        if avx.length > 0 then return (stating :facts from: constFacts text: avx)
        tg: spelledTagConst :ast :ctx :reg :typing tid: vtid armId: arm
        vc: spelledCname :ctx tid: vtid
        return (stating :facts from: literalFacts text: "((\{vc}_t){ .tag = \{tg} })")
    }
    return "".string
}

# foldedFnRefC -- the C function a data value's function field holds when the
# value folded: the dotted callable's base is a constant data value, and its
# field `mnId` a function reference. "" otherwise.
foldedFnRefC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    callable: astnode.view
    mnId: zast.nameid
} out String is {
    if callable.dottedpath.not then return "".string
    bv: typing.nodeConstAt nid: callable.parent
    if bv.kind.aggKind.not then return "".string
    tid: ztypes.tid
    start: u64
    {
        g: typing.constAggs.get i: bv.aggId.u64
        if g.kind.staticData.not then return "".string
        tid = g.tid
        start = g.itemStart
    }
    fnames: List String
    fids: ListVal ztypes.tid
    fnIds: ListVal zast.nameid
    recFieldLists :ast :reg :typing :tid names: fnames ids: fids nameIds: fnIds
    k: u64
    for k < fnIds.length loop {
        if (fnIds.get i: k) == mnId then {
            v: typing.constAggItems.get i: start + k
            if v.kind.fnKind.not then return "".string
            return (spelledCname :ctx tid: (typing.decls.get i: v.fnDecl).typeId)
        }
        k = k + 1
    }
    return "".string
}

# emitFnptrFieldCall -- a call through a record/class fnptr field
# (`c.op a: 100 b: 200` -> `c.op(100, 200)`). "" when the callee member is not
# a flagged fnptr field. A slot that declares a receiver is handed the instance
# the dot reached it through (`p.plus n: 1` -> `p.plus(&p, 1)`), exactly as the
# no-argument read `p.first` is.
emitFnptrFieldCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    mnId: aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable)
    if mnId.isZero then return "".string
    recvTid: dottedReceiverStampId :ast :typing callable: (ast.nodes.get i: call.callable)
    rtid: chaseAggregateTypedef :reg :typing :ctx tid: recvTid
    if rtid.isZero then return "".string
    if (typing.declIsFnptrFieldId parentTypeId: rtid nameId: mnId).not then return "".string
    callableNode: ast.nodes.get i: call.callable
    # a function a folded data value holds is known, and called by its name: the
    # value itself is never read
    direct: foldedFnRefC :ast :reg :typing :ctx callable: callableNode :mnId
    recvExpr: String
    if direct.length == 0 then {
        recvF: cfacts
        recvText: emitDottedReceiver :ast :reg :typing :ctx callable: callableNode facts: recvF
        if recvText.length == 0 then return "".string
        # the slot is read through the receiver and the receiver is passed to it
        recvExpr = (
            receiverOnce
            :ast
            :reg
            :typing
            :ctx
            callable: callableNode
            text: recvText.stringView
            textF: recvF
            tid: rtid
        )
    }
    rptr: dottedReceiverIsPtr :ast :reg :typing :ctx callable: (ast.nodes.get i: call.callable)
    acc: ".".string
    if rptr then acc = "->".string
    # the slot's own parameter list decides how each argument is passed:
    # fnptrParamTypeC pointerizes a param exactly when paramTypeIsPointer does,
    # and a receiver-typed param (`r: this` on a record) is one of those.
    fnTid: (
        (typing.declChildOfId parentTypeId: rtid nameId: mnId).or
        d: ztypes.tid.zero
    )
    pNames: List String
    pIds: ListVal ztypes.tid
    pNmIds: ListVal zast.nameid
    if fnTid.notZero then {
        recFieldLists :ast :reg :typing tid: fnTid names: pNames ids: pIds nameIds: pNmIds
    }
    # the slot's parameters other than the receiver, which the call supplies
    argIds: ListVal ztypes.tid
    argNmIds: ListVal zast.nameid
    {
        thisNm: reg.thisParamNameIdOf tid: fnTid
        takesThis: false
        if fnTid.notZero then takesThis = fnTypeTakesThis :reg :typing tid: fnTid
        pk: u64
        for pk < pNmIds.length loop {
            pnk: pNmIds.get i: pk
            isRecv: false
            if takesThis then {
                if pnk == zast.wellKnown.slot.wkThis then isRecv = true
                if thisNm.notZero when pnk == thisNm then isRecv = true
            }
            if isRecv.not then {
                argIds.append (pIds.get i: pk)
                argNmIds.append pnk
            }
            pk = pk + 1
        }
    }
    # each written argument fills the parameter its label names, and is built in
    # the order it is written
    slots: argSlotList :ast :call fpNameIds: argNmIds
    ord: orderBegin :ctx slots: argIds.length
    ai: u64
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation then {
            slot: slots.get i: ai
            if slot >= argIds.length then slot = ai
            ai = ai + 1
            (
                orderFnptrArg
                :ast
                :reg
                :typing
                :ctx
                :fnTid
                :argIds
                :argNmIds
                :slot
                op: (ast.nodes.get i: a.operation)
                :ord
            )
        }
    }
    oprefix: orderFinish :ctx st: ord
    args: String
    va: u64
    nslots: argIds.length
    if ai > nslots then nslots = ai
    for va < nslots loop {
        vo: orderSlotText t: ctx st: ord slot: va
        if vo.length > 0 then {
            if args.length > 0 then args.append ", "
            args.append vo
        }
        va = va + 1
    }
    orderEnd :ctx st: ord
    callArgs: args.copy
    if direct.length > 0 then {
        dcall: direct.take
        dcall.append "("
        dcall.append args
        dcall.append ")"
        return (stating :facts from: callFacts text: (orderWrap prefix: oprefix call: dcall))
    }
    if fnTid.notZero when (fnTypeTakesThis :reg :typing tid: fnTid) then {
        callArgs = "&".string
        if rptr then callArgs = "".string
        callArgs.append recvExpr
        if args.length > 0 then {
            callArgs.append ", "
            callArgs.append args
        }
    }
    return (stating :facts from: callFacts text: (
        orderWrap
        prefix: oprefix
        call: (
            fnptrSlotCallC
            :ast
            :reg
            :typing
            :ctx
            owner: rtid
            base: recvExpr.stringView
            acc: acc.stringView
            :mnId
            recv: callArgs.stringView
        )
    )
    )
}

# orderFnptrArg -- one written argument of a call through a function value (a
# local or a field), built in evaluation order into the slot of the parameter
# it binds. The slot's function type declares its parameters as a function
# does, so the argument is built exactly as a direct call's is
# (orderUserFnArg): projected onto a spec slot, addressed for a by-pointer one,
# an owned inline value held in the temp that releases it. An argument past the
# slot's parameters -- which the checker has refused -- is its bare value.
orderFnptrArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fnTid: ztypes.tid
    # the slot's non-receiver parameters: types and names
    argIds: (ListVal ztypes.tid).view
    argNmIds: (ListVal zast.nameid).view
    slot: u64
    op: astnode.view
    ord: orderstate.borrow
} is {
    if slot < argIds.length then {
        pnm: argNmIds.get i: slot
        (
            orderUserFnArg
            :ast
            :reg
            :typing
            :ctx
            fid: fnTid
            pinId: (argIds.get i: slot)
            pinNmId: pnm
            pname: pnm
            argOpNode: op
            :slot
            :ord
        )
        return
    }
    mk: pendingHoistMark :ctx
    avF: cfacts
    av: emitExprWith :ast :reg :typing :ctx n: op facts: avF
    constant: orderConstantWith :ast :typing :ctx n: op tf: avF byPtr: false
    (
        orderPartWith
        :ast
        :reg
        :typing
        :ctx
        st: ord
        mark: mk
        text: av
        tf: avF
        :constant
        fid: fnTid
        pid: ztypes.tid.zero
        pname: zast.nameid
        ctype: ""
        :slot
    )
}

# orderWrap -- a call's prebuilt C text after the assignments orderFinish opened
# ahead of it.
orderWrap: function {prefix: String.take call: String.take} out String is {
    if prefix.length == 0 then return call
    r: prefix.take
    r.append call
    r.append ")"
    return r
}

# emitFnptrLocalCall -- a call through a bare local/param of FUNCTION type
# (`cb a: 5 b: 7` -> `cb(5, 7)`, `f a: a b: b` -> `f(a, b)`). "" unless the
# callee is a bare atom whose stamped type is a FUNCTION (and not a top-level fn).
emitFnptrLocalCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    fid: ztypes.tid
    cn0: StringView
    cnVid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    if fid.notZero then return "".string
    dct: aliasChildName :ast :typing n: (ast.nodes.get i: call.callable)
    if dct.length > 0 then return "".string
    cnid: interpPartNodeId n: (ast.nodes.get i: call.callable)
    cTid: stampIdOf :typing nid: cnid
    if cTid.isZero then return "".string
    if (reg.typetypeOf typeId: cTid) != ztypes.ztypetype.functionType then return "".string
    # a bare atom that is no variable names a top-level function, called as one
    if cnVid.isZero then return "".string
    fcmF: cfacts
    fcm: wholeLocalName :ast :reg :ctx vid: cnVid name: cn0 facts: fcmF
    # a name narrowed to an arm that carries a function calls that function
    nbx: vvGet xs: ctx.narrowBox vid: cnVid
    if nbx.length > 0 then {
        noteAliasRead :ctx vid: cnVid
        fcm = nbx.take
    }
    # THE SLOT'S OWN PARAMETER LIST DECIDES HOW EACH ARGUMENT IS PASSED, the
    # same question emitFnptrFieldCall asks of a fn-pointer FIELD. It matters
    # here as soon as an unbound METHOD reference can reach a local: a receiver
    # parameter is a pointer in both type families, so `f this: a rhs: 5`
    # emitted `z_v4(z_v3, 5)` and passed the receiver by value into a `z_t12_t*`.
    pNames: List String
    pIds: ListVal ztypes.tid
    pNmIds: ListVal zast.nameid
    recFieldLists :ast :reg :typing tid: cTid names: pNames ids: pIds nameIds: pNmIds
    # each written argument fills the parameter its label names, and is built in
    # the order it is written
    slots: argSlotList :ast :call fpNameIds: pNmIds
    ord: orderBegin :ctx slots: pIds.length
    ai: u64
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation then {
            slot: slots.get i: ai
            if slot >= pIds.length then slot = ai
            ai = ai + 1
            (
                orderFnptrArg
                :ast
                :reg
                :typing
                :ctx
                fnTid: cTid
                argIds: pIds
                argNmIds: pNmIds
                :slot
                op: (ast.nodes.get i: a.operation)
                :ord
            )
        }
    }
    oprefix: orderFinish :ctx st: ord
    args: String
    va: u64
    nslots: pIds.length
    if ai > nslots then nslots = ai
    for va < nslots loop {
        vo: orderSlotText t: ctx st: ord slot: va
        if vo.length > 0 then {
            if args.length > 0 then args.append ", "
            args.append vo
        }
        va = va + 1
    }
    orderEnd :ctx st: ord
    return (
        stating
        :facts
        from: callFacts
        text: (orderClose prefix: oprefix callee: fcm.stringView args: args.stringView)
    )
}

# emit a call used as a value (its result expression).

# implementationArgText -- the value at `argOpNode` boxed as the spec it stands in
# for, when the checker recorded it as a stand-in (standInOf): what a
# `P.create from: x` or `P x` of the same value emits -- `_create_owned` where
# the place owns a protocol value, `_create` otherwise (a facet box copies).
# Every slot that spells a value asks it; "" when the value stands in for
# nothing.
implementationArgText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    argOpNode: astnode.view
    av: StringView
    avF: cfacts
    avVid: ztypes.vid
} out String is {
    nid: zast.nodeIdOf n: argOpNode
    so: typing.standInOf.get key: nid
    if so.none then return "".string
    su: so
    pLbl: boxLabelFor :reg :typing :ctx implTid: su.value protoTid: su.spec
    if pLbl.length == 0 then return "".string
    suffix: "create".string
    if su.owning when (reg.typetypeOf typeId: su.spec) == ztypes.ztypetype.protocolType then {
        suffix = "create_owned".string
        noteOwnedBoxUse :ctx implTid: su.value protoTid: su.spec
    } else {
        noteBorrowBoxUse :ctx implTid: su.value protoTid: su.spec
    }
    aIb: spelledCname :ctx tid: su.value
    aRcv: "&\{av}"
    # a data value is already the pointer the create takes (isStaticHandle)
    if (isPtrVid :ctx vid: avVid) or (isStaticHandle :reg :typing tid: su.value) then {
        aRcv = "\{av}"
    } else if avF.place.not then {
        # AN INLINE CONSTRUCTION IS NOT AN LVALUE: C rejects `&z_t109_create(40)`,
        # so it is bound to a temp first, as a `P.create from: (Cat k: 40)` source is
        ahv: hoistForAddress :ast :reg :typing :ctx :av tid: su.value argNid: nid
        aRcv = "&\{ahv}"
    }
    return "\{aIb}_\{pLbl}_\{suffix}(\{aRcv})"
}

# standInText -- a slot's text for the value at `n`: boxed as the spec it stands
# in for (implementationArgText), or `text` as written.
standInText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    text: String.take
    # holds `text`'s facts, and is left holding the result's
    facts: cfacts.borrow
} out String is {
    if (typing.standInOf.has key: (zast.nodeIdOf :n)).not then return text
    bx: (
        implementationArgText
        :ast
        :reg
        :typing
        :ctx
        argOpNode: n
        av: text.stringView
        avF: facts
        avVid: (atomVidIfPlain :ast :reg :typing :ctx :n text: text.stringView)
    )
    if bx.length > 0 then return (stating :facts from: callFacts text: bx)
    return text
}

# paramTakesPointer -- a parameter of the user function or method fid takes
# its argument by pointer: the receiver (in both families), a value type marked
# `.view` or `.borrow`, an unowned class or union (Option, Result), a borrowed
# String, a List. Every other parameter takes its argument by value -- a
# protocol or a view union as the handle it is (passesByValue), a Set or a Map
# as the heap pointer it already is.
paramTakesPointer: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
    pnameId: zast.nameid
    pid: ztypes.tid
    takesArg: bool
} out bool is {
    # The receiver is a pointer in both families, so a value-typed one still
    # needs `&`. Only this leg is added, not the whole definition-side
    # predicate: a Map/Set argument is already a pointer here and must not
    # be addressed again.
    if (paramIsReceiverName :reg :fid :pnameId) then return true
    if (markedValtypeRefParam :reg :typing :fid :pnameId :pid) then return true
    if takesArg.not when (isReftypeParam :reg :typing :ctx tid: pid) then return true
    if (isBorrowStringParam :typing :ctx :fid :pnameId :pid) then return true
    return (isListPtrParam :reg :typing :ctx :fid :pnameId tid: pid)
}

# boxAddressArg -- an implementation box handed to a facet parameter marked
# `.view` or `.borrow`, which takes a pointer: the box is a value, so it is
# bound to a temp of its own and the temp is addressed. Not the argument's
# temp: an inline construction's box is made FROM that one. A facet box holds
# a copy of a valtype and owns nothing to destroy.
boxAddressArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    box: StringView
    tid: ztypes.tid
} out String is {
    # a facet box holds a copy of a valtype and owns nothing to destroy
    bx: hoistForAddress :ast :reg :typing :ctx av: box :tid argNid: zast.nodeid
    return "&\{bx}"
}

# userFnArgTextWith -- the C text of one argument of a user-function call, for
# the parameter it binds, its facts stated into `facts`: the interpolation /
# implementation projections, then the by-reference or borrow hoist the
# parameter's mode asks for.
userFnArgTextWith: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
    pinId: ztypes.tid
    pinNmId: zast.nameid
    argOpNode: astnode.view
    facts: cfacts.borrow
} out String is {
    ctx.lastArgByPtr = false
    projF: cfacts
    iavb: (
        emitInterpArgForParam
        :ast
        :reg
        :typing
        :ctx
        n: argOpNode
        :fid
        pnameId: pinNmId
        pid: pinId
        facts: projF
    )
    atomVarId: String
    # the facts of atomVarId while it is the argument's own expression
    avF: cfacts
    projd: false
    if iavb.length > 0 then {
        atomVarId = iavb.take
        projd = true
    } else {
        atomVarId = emitExprWith :ast :reg :typing :ctx n: argOpNode facts: avF
    }
    avq: atomVidIfPlain :ast :reg :typing :ctx n: argOpNode text: atomVarId.stringView
    ppid: pinId
    {
        spec: (
            implementationArgText
            :ast
            :reg
            :typing
            :ctx
            :argOpNode
            av: atomVarId.stringView
            avF: (if projd then projF else avF)
            avVid: avq
        )
        if spec.length > 0 then {
            atomVarId = spec.take
            projd = true
            # an implementation box is built by a call
            projF = callFacts
            if (markedValtypeRefParam :reg :typing :fid pnameId: pinNmId pid: ppid) then {
                atomVarId = boxAddressArg :ast :reg :typing :ctx box: atomVarId.stringView tid: ppid
                # the address of the box's own temp
                projF = addrFacts e: pathFacts
                ctx.lastArgByPtr = true
            }
        }
    }
    if projd then return (stating :facts from: projF text: atomVarId)
    # the parameter's mode: by pointer (addressed unless already one), or a
    # borrow hoist of the value
    paramTakes: paramTakesArg :typing :fid pnameId: pinNmId
    ctx.lastArgByPtr = (
        paramTakesPointer
        :reg
        :typing
        :ctx
        :fid
        pnameId: pinNmId
        pid: pinId
        takesArg: paramTakes
    )
    if ctx.lastArgByPtr then {
        if (argAlreadyPointer :ast :reg :typing :ctx n: argOpNode vid: avq) then {
            return (stating :facts from: avF text: atomVarId)
        }
        return (
            emitByrefArgWith
            :ast
            :reg
            :typing
            :ctx
            av: atomVarId.stringView
            :avF
            pid: pinId
            argNid: (zast.nodeIdOf n: argOpNode)
            :facts
        )
    }
    # a pointer-held valtype handed to a BY-VALUE parameter is loaded, and so
    # is a reference-returning call's valtype result; every parameter that
    # wants the pointer has answered above
    if (ptrHeldValtype :ast :reg :typing :ctx n: argOpNode) then {
        return (stating :facts from: (operandFacts e: avF place: true) text: "(*\{atomVarId})")
    }
    if (refValtypeResult :ast :reg :typing :ctx n: argOpNode) then {
        return (stating :facts from: (operandFacts e: avF place: true) text: "(*\{atomVarId})")
    }
    borrowHoist: (
        hoistBorrowValArgWith
        :ast
        :reg
        :typing
        :ctx
        argNid: (zast.nodeIdOf n: argOpNode)
        av: atomVarId.stringView
        :avF
        pid: pinId
        paramTake: paramTakes
    )
    if borrowHoist.length > 0 then return (stating :facts from: pathFacts text: borrowHoist)
    return (stating :facts from: avF text: atomVarId)
}

# emitUserFnCall -- a call of a user-declared function `fid` (a free function
# or a static method reached by its own id): its C name applied to the
# arguments in parameter order, defaults rendered for the omitted ones.
emitUserFnCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    fid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    fpIds: ListVal ztypes.tid
    fpIdsNm: ListVal zast.nameid
    recFieldIds :reg :typing tid: fid ids: fpIds nameIds: fpIdsNm
    slots: argSlotList :ast :call fpNameIds: fpIdsNm
    ord: orderBegin :ctx slots: fpIdsNm.length
    ai8: u64
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation then {
            argOpNode: ast.nodes.get i: a.operation
            argSlot: slots.get i: ai8
            if argSlot < fpIdsNm.length then {
                (
                    orderUserFnArg
                    :ast
                    :reg
                    :typing
                    :ctx
                    :fid
                    pinId: (fpIds.get i: argSlot)
                    pinNmId: (fpIdsNm.get i: argSlot)
                    pname: (fpIdsNm.get i: argSlot)
                    :argOpNode
                    slot: argSlot
                    :ord
                )
            }
            ai8 = ai8 + 1
        }
    }
    oprefix: orderFinish :ctx st: ord
    args: String
    emitted: u64
    pp: u64
    ppn: fpIdsNm.length
    for pp < ppn loop {
        filled: false
        {
            vo: orderSlotText t: ctx st: ord slot: pp
            if vo.length > 0 then {
                if emitted > 0 then args.append ", "
                args.append vo
                emitted = emitted + 1
                filled = true
            }
        }
        if filled.not then {
            paramNameId: fpIdsNm.get i: pp
            if (typing.declHasDefaultId parentTypeId: fid nameId: paramNameId) then {
                pddt: typing.declDefaultOfId parentTypeId: fid nameId: paramNameId
                pdpid: fpIds.get i: pp
                argFacts: cfacts
                pdrv: renderDefault :ast :reg :typing :ctx dv: pddt targetTid: pdpid facts: argFacts
                if emitted > 0 then args.append ", "
                args.append pdrv
                emitted = emitted + 1
            }
        }
        pp = pp + 1
    }
    orderEnd :ctx st: ord
    noteFnUse :ctx tid: fid
    return (
        stating
        :facts
        from: callFacts
        text: (orderClose prefix: oprefix callee: (ctxCnameView :ctx tid: fid) args: args.stringView
        )
    )
}

# orderUserFnArg -- one written argument of a user-function call, built and
# placed in evaluation order, its text filling its parameter's slot.
orderUserFnArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
    pinId: ztypes.tid
    pinNmId: zast.nameid
    # the parameter's name id, which a temp's C type is spelled from
    pname: zast.nameid
    argOpNode: astnode.view
    slot: u64
    ord: orderstate.borrow
} is {
    mk: pendingHoistMark :ctx
    txtF: cfacts
    txt: userFnArgTextWith :ast :reg :typing :ctx :fid :pinId :pinNmId :argOpNode facts: txtF
    constant: orderConstantWith :ast :typing :ctx n: argOpNode tf: txtF byPtr: ctx.lastArgByPtr
    (
        orderPartWith
        :ast
        :reg
        :typing
        :ctx
        st: ord
        mark: mk
        text: txt
        tf: txtF
        :constant
        :fid
        pid: pinId
        :pname
        ctype: ""
        :slot
    )
}

# isFieldwiseCtorTid -- the id names a type a bare call CONSTRUCTS field-wise:
# a record or a class. 0 is neither, which is what the callers ask about.
isFieldwiseCtorTid: function {reg: ztypes.ZTypeRegistry.view tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    tt: reg.typetypeOf typeId: tid
    return tt.isFieldwise
}

# namedCalleeFnId -- the resolved function id a named callee stands for, 0 when
# none. THE CALLEE'S IDENTITY COMES FROM THE CHECKER'S STAMPS, never from
# re-resolving the name: a fn-typed LOCAL may legitimately shadow a function of
# the same name (`addit: mulit.take` inside a unit that also declares `addit`),
# and the name route would then emit a direct call to the function the local
# shadows -- silently, with the wrong answer. A variable id stamped on the
# callable atom says "this is a local", which is the fnptr leg's business, and
# it is the same precedence implicitTakeSourceAtom keeps for the same reason.
# A callee the checker resolved in the scope the call was WRITTEN in -- a
# namespace's sibling function included -- is reached through the id the
# callable atom carries. A NATIVE fn (or generic native template) answers 0: it never takes the
# resolved-cname route, and the zero sends it to the name interceptions.
namedCalleeFnId: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    call: zast.callrow.view
} out ztypes.tid is {
    calleeNode: atomNodeId n: (ast.nodes.get i: call.callable)
    fid: ztypes.tid
    if calleeNode.notZero then {
        clv: typing.atomVariableId.get key: calleeNode
        match (
            clv
        ) case some then null case none then {
            cst: stampIdOf :typing nid: calleeNode
            if cst.notZero when (
                (reg.typetypeOf typeId: cst) == ztypes.ztypetype.functionType
            ) then fid = cst
        }
    }
    if fid.notZero when (reg.isNativeOf tid: fid) then return ztypes.tid.zero
    return fid
}

# namedCalleeCtorTid -- the type a named callee CONSTRUCTS, 0 when it
# constructs nothing. A generic function id resolves to the mono the call was
# stamped with; a path to a type's alias, to the target it was stamped with. A parenthesized generic-type application
# (`(sized t: i64 size: 10) val: 42`) leaves the callable a stamped Call with
# no name and no function id at all, so its mono comes off the callable node's
# own stamp.
namedCalleeCtorTid: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    call: zast.callrow.view
    fid: ztypes.tid
} out ztypes.tid is {
    if fid.notZero then {
        if (reg.isGenericOf tid: fid).not then return fid
        gmid: stampIdOf :typing nid: call.nodeid
        if gmid.notZero then return gmid
        return fid
    }
    cstid: stampIdOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: call.callable))
    if cstid.isZero then return fid
    # a type's alias reached through it (`Tree.Node x: 1`) constructs its target
    crd: (typing.refDecl.get key: call.callable).or d: ztypes.declid
    if (ztypecheck.asAliasKnownAt :typing md: crd) when (
        isFieldwiseCtorTid
        :reg
        tid: cstid
    ) then return cstid
    if (originTidOf :reg tid: cstid).isZero then return fid
    if (isFieldwiseCtorTid :reg tid: cstid) then return cstid
    return fid
}

# emitUndeclaredCall -- a call the declaration route did not take: its callee
# has no declaration of its own -- `meta.create`, a construction by a bare type
# name or by a type written as an application (`(sized t: i64 size: 4) val:
# 1`, `(Pair t: u64).create a: 1`), a sized conversion (`"hi".str to: 8`), a
# function reached through a template instance's or a generic call's stamp, a
# yield -- or is a LOCAL holding a function. Each is told by what the checker
# stamped. One that is none of these is an emitter defect, reported where it is
# found.
emitUndeclaredCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    callableNode: ast.nodes.get i: call.callable
    mcb: ztypecheck.metaCreateBaseId :ast n: callableNode
    if mcb.some then {
        return (emitMetaCreateCall :ast :reg :typing :ctx :call :facts)
    }
    fid: namedCalleeFnId :ast :reg :typing :call
    ck: typing.callKind.get key: call.nodeid
    isCtor: false
    if ck.some then {
        isCtor = (ck == zast.callkind.recordCreate) or (ck == zast.callkind.classCreate)
    }
    if isCtor then {
        # a construction by bare type name: the call's type is the type built
        if callableNode.atomid when (typing.refDecl.has key: call.callable).not then {
            ctid: stampIdOf :typing nid: call.nodeid
            cec: emitEmptyColCreate :ast :reg :typing :ctx :call :facts
            if cec.length > 0 then return cec
            # a generic typedef's instance applied to its type arguments
            # alone (`Label n: 4`) is its base's empty value
            if (isTypedefType :typing tid: ctid) then {
                return (implicitZeroValue :ast :reg :typing :ctx tid: ctid :facts)
            }
            ctt: reg.typetypeOf typeId: ctid
            if (ctt == ztypes.ztypetype.recordType) or (ctt == ztypes.ztypetype.classType) then {
                return (emitRecordCtor :ast :reg :typing :ctx :call tid: ctid :facts)
            }
        }
        # a sized conversion (`.str to: 8`) is the conversion leg's to recognise
        scv: emitStrConvCall :ast :reg :typing :ctx :call :facts
        if scv.length > 0 then return scv
        mnId: aliasChildNameId :ast :typing n: callableNode
        if mnId == zast.wellKnown.slot.wkCreate then return (
            emitTypeQualCall
            :ast
            :reg
            :typing
            :ctx
            :call
            :facts
        )
        ecc: emitEmptyColCreate :ast :reg :typing :ctx :call :facts
        if ecc.length > 0 then return ecc
        ctorTid: namedCalleeCtorTid :ast :reg :typing :call :fid
        if (isFieldwiseCtorTid :reg tid: ctorTid) then {
            return (emitRecordCtor :ast :reg :typing :ctx :call tid: ctorTid :facts)
        }
    }
    gfc: emitGenericFnCall :ast :reg :typing :ctx :call :facts
    if gfc.length > 0 then return gfc
    if fid.notZero then return (emitUserFnCall :ast :reg :typing :ctx :call :fid :facts)
    cn0: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: callableNode)
    cnV: atomVid :typing nid: (atomNodeId n: callableNode)
    if cnV.notZero then {
        fplc: (
            emitFnptrLocalCall
            :ast
            :reg
            :typing
            :ctx
            :call
            :fid
            cn0: cn0.stringView
            cnVid: cnV
            :facts
        )
        if fplc.length > 0 then return fplc
    }
    # a yield hoisted out of expression position: the suspension has already
    # run as its own statement and left the resume value in a temp, so what is
    # left here is a plain read
    yk: ctx.yieldTempK.get key: call.nodeid
    if yk.some then {
        yvN: genSynthField :typing :ctx which: gensynth.yieldSlot k: yk
        # the resume value's field of the instance, read through its pointer
        return (
            stating
            :facts
            from: (memberFacts b: pathFacts)
            text: (genFieldC :ast :reg :typing :ctx nameId: yvN)
        )
    }
    # a yield the hoist declined -- a second one in the same expression, or one
    # inside a condition, where lifting the suspension would either lose the
    # temp across a return or run it on a path not taken. It is the same
    # fallback leg, so it says which construct rather than blaming the callee.
    what: "unhandled callee \{cn0}"
    if (zast.isYieldCalleeAt :ast callableId: call.callable) then {
        what = "this `yield` is not split out of its expression; bind it first (`v: yield e`) and use `v`".string
    }
    emitFail :ctx :what line: call.lineno
    return (stating :facts from: failedFacts text: "0".string)
}

# ownerIsCollectionFamily -- is `fam` one of the native container families?
# A mono's methods are the TEMPLATE's, so the family asked here is the
# template's own id.
ownerIsCollectionFamily: function {ctx: Ctx.view fam: ztypes.tid} out bool is {
    return (
        (fam == (ctx.origins.get i: family.slot.listRef)) or
        (fam == (ctx.origins.get i: family.slot.listVal)) or
        (fam == (ctx.origins.get i: family.slot.listView)) or
        (fam == (ctx.origins.get i: family.slot.listViewVal)) or
        (fam == (ctx.origins.get i: family.slot.spanVal)) or
        (fam == (ctx.origins.get i: family.slot.set)) or
        (fam == (ctx.origins.get i: family.slot.setVal)) or
        (fam == (ctx.origins.get i: family.slot.map)) or
        (fam == (ctx.origins.get i: family.slot.mapRV)) or
        (fam == (ctx.origins.get i: family.slot.mapVR)) or
        (fam == (ctx.origins.get i: family.slot.mapVV)) or
        (fam == (ctx.origins.get i: family.slot.idMapR)) or
        (fam == (ctx.origins.get i: family.slot.idMapV)) or
        (fam == (ctx.origins.get i: family.slot.idSet)) or
        (fam == (ctx.origins.get i: family.slot.fixedArray)) or
        (isStaticListValueFamily :ctx :fam)
    )
}

# isStaticListValueFamily -- is `fam` the template of a static list's value?
isStaticListValueFamily: function {ctx: Ctx.view fam: ztypes.tid} out bool is {
    if fam.isZero then return false
    return fam == (ctx.origins.get i: family.slot.staticList)
}

# staticListValueFamilyOf -- the list value family type `tid` belongs to: its origin,
# for an instance of one; 0 for any other type. A family's template is no
# value -- every one has an element or index parameter -- so it is not one of
# its own family, and nothing emits it.
staticListValueFamilyOf: function {
    reg: ztypes.ZTypeRegistry.view ctx: Ctx.view tid: ztypes.tid
} out ztypes.tid is {
    og: originTidOf :reg :tid
    if (isStaticListValueFamily :ctx fam: og) then return og
    return ztypes.tid.zero
}

# emitStringFamilyCall -- a method whose owner is String, StringView or text: the
# String-argument form first, then the dotted form both share. "" declines, as
# every leg here does.
emitStringFamilyCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    ownerTid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    if ownerTid == ctx.strTid then {
        rsa: emitStringArgMethod :ast :reg :typing :ctx :call :facts
        if rsa.length > 0 then return rsa
        return (emitDottedCall :ast :reg :typing :ctx :call :facts)
    }
    # text is laid out as a StringView, and its view members are StringView's;
    # its own, written in zerolang, are called as any method is
    if (isViewLaid :ctx tid: ownerTid).not then return "".string
    if (
        textOwnMember
        :reg
        :typing
        :ctx
        owner: ownerTid
        nameId: (aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable))
    ) then return "".string
    return (emitDottedCall :ast :reg :typing :ctx :call :facts)
}

# emitUserMethodLeg -- a method on a type the compiler emits itself: the
# iterate shim, a type-qualified call, a call through a function-pointer field,
# and otherwise the ordinary instance method.
emitUserMethodLeg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    fnptrField: bool
    facts: cfacts.borrow
} out String is {
    ruic: emitUserIterCall :ast :reg :typing :ctx :call :facts
    if ruic.length > 0 then return ruic
    rtq: emitTypeQualCall :ast :reg :typing :ctx :call :facts
    if rtq.length > 0 then return rtq
    if fnptrField then {
        rfp: emitFnptrFieldCall :ast :reg :typing :ctx :call :facts
        if rfp.length > 0 then return rfp
    }
    return (emitInstanceMethodCall :ast :reg :typing :ctx :call :facts)
}

# tmplInstCreate -- `(C T).create ...` of a templated class: the instance's
# template function, `z_<instance>_create`, its arguments as a create's; "" when
# the call constructs anything else
tmplInstCreate: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    # the call is a `create`
    isCreate: bool
    facts: cfacts.borrow
} out String is {
    if isCreate.not then return "".string
    ct: stampIdOf :typing nid: call.nodeid
    if (tmplClassRowOf :reg :ctx tid: ct) == 0 then return "".string
    cco: userCreateFn :reg :typing tid: ct
    if cco.isZero then return "".string
    noteMemberUse :ctx mono: ct member: memberWord.slot.create
    named: "\{spelledCname :ctx tid: ct}_create"
    return (userCreateCtor :ast :reg :typing :ctx :call :cco :facts named: named.stringView)
}

# emitNativeMemberCall -- a NATIVE method: it has no body to call, so its
# owner's family lowers it -- the result and option combinators, a list's
# element read, a str's substring, a native collection's empty `create`, a
# class's row (its create, or a method by its fragment), and otherwise its
# operator row (`a.or rhs: b`). "" when the family's leg declines.
emitNativeMemberCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    ownerTid: ztypes.tid
    ownerFam: ztypes.tid
    isCreate: bool
    facts: cfacts.borrow
} out String is {
    isComb: (
        (ownerFam == (ctx.origins.get i: family.slot.resultval)) or
        (ownerFam == (ctx.origins.get i: family.slot.optionval))
    )
    if isComb then return (emitResultCombinator :ast :reg :typing :ctx :call :facts)
    # a list value's `get` is a collection leg's (emitStaticListValueMethodCall)
    if (isStaticListValueFamily :ctx fam: ownerFam) then return "".string
    if ownerFam == (ctx.origins.get i: family.slot.str) then return (
        emitDottedCall
        :ast
        :reg
        :typing
        :ctx
        :call
        :facts
    )
    if isCreate when (ownerIsCollectionFamily :ctx fam: ownerFam) then return (
        emitEmptyColCreate
        :ast
        :reg
        :typing
        :ctx
        :call
        :facts
    )
    tc: tmplInstCreate :ast :reg :typing :ctx :call :isCreate :facts
    if tc.length > 0 then return tc
    if (reg.typetypeOf typeId: ownerTid) == ztypes.ztypetype.classType then {
        if isCreate then return (emitNativeCreate :ast :reg :typing :ctx :call cid: ownerTid :facts)
        return (emitClassNativeCall :ast :reg :typing :ctx :call :ownerTid :facts)
    }
    return (emitOperatorCallForm :ast :reg :typing :ctx :call :facts)
}

# emitMethodDeclCall -- a callee declared as a METHOD, routed by its owner's
# family: a native collection, the two string types, a native that takes
# arguments, a protocol or facet, any other native member, a bodied `create`
# (called through its type), and otherwise the compiler's own emission.
emitMethodDeclCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    ownerTid: ztypes.tid
    # the method's own type: whether it is native
    method: ztypes.tid
    fnptrField: bool
    isCreate: bool
    facts: cfacts.borrow
} out String is {
    # the owner is the TEMPLATE for a native collection's method (the mono's
    # methods are the template's); its family is its own id
    ownerFam: originTidOf :reg tid: ownerTid
    if ownerFam.isZero then ownerFam = ownerTid
    if (ownerIsCollectionFamily :ctx fam: ownerFam) then {
        rcol: emitCollectionMethodCall :ast :reg :typing :ctx :call :facts
        if rcol.length > 0 then return rcol
    }
    rstr: emitStringFamilyCall :ast :reg :typing :ctx :call :ownerTid :facts
    if rstr.length > 0 then return rstr
    # a native that takes arguments answers from its own row, before the
    # receiver-only and operator legs get a chance to not know it
    rnam: emitNativeArgMethod :ast :reg :typing :ctx :call :ownerTid :facts
    if rnam.length > 0 then return rnam
    ott: reg.typetypeOf typeId: ownerTid
    isSpec: ott.isInterface
    if isSpec then return (emitProtocolDispatch :ast :reg :typing :ctx :call :facts)
    # A NATIVE OWNER MAY DECLARE A BODIED MEMBER, and its body is emitted like
    # any other -- `u8.upto` is one. It is the METHOD's nativeness that sends a
    # call to its family's lowering, not the owner's.
    if (reg.isNativeOf tid: method) then return (
        emitNativeMemberCall
        :ast
        :reg
        :typing
        :ctx
        :call
        :ownerTid
        :ownerFam
        :isCreate
        :facts
    )
    # a `create` with a body is the type's own function, called through the type
    if isCreate then return (emitTypeQualCall :ast :reg :typing :ctx :call :facts)
    return (emitUserMethodLeg :ast :reg :typing :ctx :call :fnptrField :facts)
}

# emitSiblingFnCall -- a bare call of a function declared in the unit at hand.
# A fn-typed LOCAL's atom carries its variable id and calls through the pointer
# instead, so an atom that has one is not this. Inside an instance's copy of a
# body the callee's stamp is the instance's own function.
emitSiblingFnCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    rtid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    rcal: ast.nodes.get i: call.callable
    if rcal.atomid.not then return "".string
    if (typing.atomVariableId.get key: call.callable).some then return "".string
    return (emitUserFnCall :ast :reg :typing :ctx :call fid: rtid :facts)
}

# emitFuncDeclCall -- a callee declared as a free FUNCTION: a native, a generic
# instantiation, a cross-unit call, or a sibling in the unit at hand. A native
# answers alone: nothing follows it when its own row declines.
emitFuncDeclCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    rtid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    if rtid.notZero when (reg.isNativeOf tid: rtid) then {
        return (emitNativeFreeFnCall :ast :reg :typing :ctx :call fid: rtid :facts)
    }
    if rtid.notZero when (reg.isGenericOf tid: rtid) then {
        rgf: emitGenericFnCall :ast :reg :typing :ctx :call :facts
        if rgf.length > 0 then return rgf
    }
    rcu: emitCrossUnitFnCall :ast :reg :typing :ctx :call :facts
    if rcu.length > 0 then return rcu
    if rtid.notZero when (reg.isGenericOf tid: rtid).not then {
        return (emitSiblingFnCall :ast :reg :typing :ctx :call :rtid :facts)
    }
    return "".string
}

# emitCtorDeclCall -- a callee declared as a variant ARM or as a TYPE: a
# variant or union constructor, or a cross-unit one.
emitCtorDeclCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    isArm: bool
    facts: cfacts.borrow
} out String is {
    if isArm then return (emitArmCtorCall :ast :reg :typing :ctx :call :facts)
    return (emitCrossUnitCtor :ast :reg :typing :ctx :call :facts)
}

# emitAliasCall -- a callee reached through another name: a re-export
# (`math.BigInt v: 3`, a name a unit's `public:` block re-exports) or a unit
# constant naming a type instance (`F2: (fx n: 2)`). The call is stamped with
# the TARGET, so a function is called as one and a type constructed.
emitAliasCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    rxT: dottedMemberTidOf :ast :reg :typing callableId: call.callable
    if (reg.typetypeOf typeId: rxT) == ztypes.ztypetype.functionType then {
        return (emitCrossUnitFnCall :ast :reg :typing :ctx :call :facts)
    }
    return (emitCrossUnitCtor :ast :reg :typing :ctx :call :facts)
}

# emitCallByDecl -- route by the callee's DECLARATION: its kind and its owner's
# family name the handler outright, with no name lookup and no probe. A
# declaration has ONE kind, so the legs below are alternatives and the
# first that matches is the answer, "" when it declines.
emitCallByDecl: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    rdo: typing.refDecl.get key: call.callable
    if rdo.none then return "".string
    rdecl: typing.decls.get i: rdo
    rkind: rdecl.kind
    rtid: rdecl.typeId
    ownerTid: ztypes.tid
    if rdecl.parent.notZero then {
        ownerDecl: typing.decls.get i: rdecl.parent
        ownerTid = ownerDecl.typeId
    }
    # A LITERAL TYPE'S METHOD IS EMITTED AS THE METHOD OF THAT NAME ON THE TYPE
    # ITS RECEIVER LANDED IN: the checker reads a literal receiver as the type
    # the method runs in (`5.times` an i64) and stamps it there. The lookup and
    # the signature stay the literal's; only the C is that type's.
    if rkind.methodDecl when (isLiteralType :reg tid: ownerTid) then {
        lt: literalReceiverLanding :ast :typing :call
        mt: typing.declChildOfId parentTypeId: lt nameId: rdecl.name
        if mt.some then {
            ownerTid = lt
            rtid = mt
        }
    }
    if rkind.methodDecl when ownerTid.notZero then {
        return (
            emitMethodDeclCall
            :ast
            :reg
            :typing
            :ctx
            :call
            :ownerTid
            method: rtid
            fnptrField: rdecl.fnptrField
            isCreate: rdecl.name == zast.wellKnown.slot.wkCreate
            :facts
        )
    }
    if rkind.funcDecl then return (emitFuncDeclCall :ast :reg :typing :ctx :call :rtid :facts)
    if rkind.armDecl then return (emitCtorDeclCall :ast :reg :typing :ctx :call isArm: true :facts)
    if rkind.typeDecl then return (emitCtorDeclCall :ast :reg :typing :ctx :call isArm: false :facts
    )
    if rkind.reexportDecl or rkind.constDecl then return (
        emitAliasCall
        :ast
        :reg
        :typing
        :ctx
        :call
        :facts
    )
    # a function-pointer FIELD, called through the record that holds it
    if rkind.fieldDecl then return (emitFnptrFieldCall :ast :reg :typing :ctx :call :facts)
    return "".string
}

# isLiteralType -- the type is intliteral, floatliteral or textliteral, which
# no value has at run time: their operators and methods are emitted as the
# type the literal landed in.
isLiteralType: function {reg: ztypes.ZTypeRegistry.view tid: ztypes.tid} out bool is {
    return (tid == reg.literalIntTid) or (tid == reg.literalFloatTid) or (tid == reg.literalTextTid)
}

# literalReceiverLanding -- the type the checker stamped on the receiver of the
# dotted call `call`: where a literal receiver landed. 0 when the callee is not
# dotted.
literalReceiverLanding: function {
    ast: Ast.view typing: ztyping.ZTyping.view call: zast.callrow.view
} out ztypes.tid is {
    return (dottedReceiverStampId :ast :typing callable: (ast.nodes.get i: call.callable))
}

# emitCallValue -- the C expression for a call: the construction kinds the
# checker stamped (typedef, box, protocol and facet), the operator forms, the
# callee's declaration (emitCallByDecl), and what that leaves
# (emitUndeclaredCall).
# Shared by emitExpr's call arm and the statement-position call leg
# so neither clones the node (clones lose the type stamps).
emitCallValue: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    # stamped-kind dispatch head: a call whose kind names its owning handler
    # routes there directly; an empty result or an unstamped / chain-owned
    # kind falls through to the probe chain below.
    ckh: typing.callKind.get key: call.nodeid
    if ckh.some then {
        isTdk: (ckh == zast.callkind.typedefCreate) or (ckh == zast.callkind.typedefBorrow)
        if isTdk then {
            tdh: emitTypedefCreateCall :ast :reg :typing :ctx :call :facts
            if tdh.length > 0 then return tdh
        }
        if ckh == zast.callkind.boxCreate then {
            bxh: emitBoxCreate :ast :reg :typing :ctx :call :facts
            if bxh.length > 0 then return bxh
        }
        isPjk: (
            (ckh == zast.callkind.protocolCreate) or
            (ckh == zast.callkind.protocolBorrow) or
            (ckh == zast.callkind.facetCreate) or
            (ckh == zast.callkind.facetBorrow)
        )
        if isPjk then {
            pch: emitProtocolCreateCall :ast :reg :typing :ctx :call :facts
            if pch.length > 0 then return pch
        }
    }
    # A SYNTHESISED OPERATOR HAS NO BODY TO CALL, so it must reach the
    # structural emitter before the by-decl leg claims it as an ordinary method.
    # AN OPERATOR CALL REACHES THE OPERATOR EMITTER WHATEVER ELSE IT PASSES.
    # Asked here, first: the infix form IS a call, so at the end of the
    # named-callee chain every operator in the program would walk every probe
    # -- each building names, keys and receiver text -- to discover what its
    # own shape already says. Both spellings reach one emitter, and a call this
    # declines falls through to the rest of the chain.
    calleeName: aliasChildName :ast :typing n: (ast.nodes.get i: call.callable)
    isOp: ztypecheck.isOperatorName name: calleeName
    if call.arguments.count.u64 == 1 when isOp then {
        eopc: emitOperatorCallForm :ast :reg :typing :ctx :call :facts
        if eopc.length > 0 then return eopc
    }
    sopc: emitSynthOperatorCallForm :ast :reg :typing :ctx :call :facts
    if sopc.length > 0 then return sopc
    cbd: emitCallByDecl :ast :reg :typing :ctx :call :facts
    if cbd.length > 0 then return cbd
    return (emitUndeclaredCall :ast :reg :typing :ctx :call :facts)
}

# emitStringMethod -- a String value-context method call. String is a native
# singleton whose struct + methods emit once under ctx.strC; dispatch by name so
# the cname is canonical (not a per-shell receiver id). `recv` is the receiver C
# expression; recvIsPtr picks `->`/no-`&`. "" for an unrecognized method.
emitStringMethod: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    recv: StringView
    recvF: cfacts
    recvIsPtr: bool
    # the method's name id, which picks the String member it emits
    mnId: zast.nameid
    recvVid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    if mnId == zast.wellKnown.slot.wkCopy then {
        if recvIsPtr then {
            preludeNeed :ctx memb: "@String_copy"
            return (stating :facts from: callFacts text: "\{ctx.strC}_copy(\{recv})")
        }
        rhF: cfacts
        rh: addressableText :ast :reg :typing :ctx e: recv eF: recvF tid: ctx.strTid facts: rhF
        preludeNeed :ctx memb: "@String_copy"
        return (stating :facts from: callFacts text: "\{ctx.strC}_copy(&\{rh})")
    }
    if mnId == zast.wellKnown.slot.wkLength then {
        if recvIsPtr then return (stating :facts from: (memberFacts b: recvF) text: "\{recv}->size")
        return (stating :facts from: (memberFacts b: recvF) text: "\{recv}.size")
    }
    if mnId == zast.wellKnown.slot.wkCapacity then {
        if recvIsPtr then return (
            stating
            :facts
            from: (memberFacts b: recvF)
            text: "\{recv}->capacity"
        )
        return (stating :facts from: (memberFacts b: recvF) text: "\{recv}.capacity")
    }
    if (ztypecheck.isStringViewMember nameId: mnId) then {
        if recvIsPtr then return (
            stating
            :facts
            from: literalFacts
            text: (svValueFormPtr :ctx expr: recv)
        )
        stateFacts :facts from: recvF
        return (svValueForm :ast :reg :typing :ctx expr: recv isStr: true vid: recvVid :facts)
    }
    if mnId == zast.wellKnown.slot.wkShrink then {
        preludeNeed :ctx memb: "@String_shrink"
        if recvIsPtr then return (stating :facts from: callFacts text: "\{ctx.strC}_shrink(\{recv})"
        )
        return (stating :facts from: callFacts text: "\{ctx.strC}_shrink(&\{recv})")
    }
    return "".string
}

# varCName -- the C identifier of the local behind variable `vid`: `z_v<id>`.
# The id names it uniquely, so no C keyword can collide. --readable-names puts
# the name the variable is bound to in front of the id (`n_5`): the id keeps two
# bindings of one name apart when a bare block is flattened into its enclosing
# C block, and keeps a local clear of every macro a system header defines
# (`near`, `FAR`, `stdin`, `errno`), which no list could enumerate.
varCName: function {
    ctx: Ctx.view
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    vid: ztypes.vid
} out String is {
    if ctx.readableNames.not then return "z_v\{vid}"
    rn: String
    nm: reg.variableNameOf id: vid
    if nm.notZero then rn = zast.nameTextCopy :ast ref: nm
    rn.append "_\{vid}"
    return rn
}

# nameCName -- the C identifier of a name no variable stands behind: the source
# name, kept clear of the C keywords.
nameCName: function {ctx: Ctx.view name: StringView} out String is {
    return (mangleVarName :name cw: ctx.cWords)
}

# varCNameIs -- whether `text` is exactly the spelling of the local `vid`, or of
# `name` when no variable stands behind it, decided without composing it in the
# default scheme: `z_v` and the id's decimal digits, with no leading zero, as
# varCName writes them.
varCNameIs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    vid: ztypes.vid
    name: StringView
    text: StringView
} out bool is {
    if vid.isZero then return (nameCName :ctx :name).stringView == text
    if ctx.readableNames then return (varCName :ctx :ast :reg :vid).stringView == text
    if (text.length < 4) or (text.startsWith prefix: "z_v").not then return false
    digits: text.substring from: 3 to: text.length
    if ((digits.byteAt 0).or d: 0) == 48 then return false
    parsed: digits.parseU64
    match (
        parsed
    ) case ok then {
        return parsed == vid.u64
    } case err then {
        return false
    }
}

# memberkind -- the family a member of a compiler-generated struct is counted
# in: a record's or class's field, a variant's arm in `data`, a union's inline
# arm slot, an interface's vtable slot, or a meta_create parameter (a field's,
# counted as the fields are).
memberkind: variant {
    # a record's or class's field
    field: null
    # a variant's arm in its `data` union
    arm: null
    # a union's inline arm slot
    inlineArm: null
    # an interface's vtable slot
    slot: null
    # a meta_create parameter, or a vtable wrapper's
    param: null
}

# memberC -- the C name of the member of `owner` named `nameId`, counted in
# `kind`: its family's letter and its ordinal (memberLetter, memberOrdinal) --
# `f2`, `a0` -- from ids alone, as a type's own C name is. A source name is never
# part of it, so no member can collide with a C keyword, a macro (`errno`,
# `st_mtime`), the emitter's own locals (`_this`) or another member. Under
# --readable-names the source name is appended (`f2_default`); nothing about
# uniqueness rests on it. Every spelling of a member of a struct this emitter
# generates -- its declaration, the reads and writes, the constructor's
# parameters, the destructor, the generated `_eq` and `hash`, the vtable rows
# and the dispatch through them, and the runtime fragments' `@MEMBER_` holes --
# is this. Asking for a member the owner does not declare is an emitter defect.
memberC: function {
    # the member names
    ast: Ast.view
    # the checked program
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the emission context; its field lists are read through it
    ctx: Ctx
    # the type that declares the member
    owner: ztypes.tid
    # the list the member is counted in
    kind: memberkind
    # the member's name, interned
    nameId: zast.nameid
} out String is {
    o: memberOrdinal :reg :typing :ctx :owner :kind :nameId
    nm: zast.nameTextAt :ast ref: nameId
    if o.none then {
        tn: reg.nameViewOf tid: owner
        panic msg: "zemitterc: a C name for member '\{nm}', which '\{tn}' does not declare"
    }
    r: "\{memberLetter :kind}\{o}"
    if ctx.readableNames then {
        r.append "_"
        if kind.slot then {
            r.append (slotReadableName name: nm.stringView ow: ctx.opWords)
        } else {
            # a generator's synthesized field is `#`-prefixed: only the
            # identifier bytes are C
            nmv: nm.stringView
            bi: u64
            for bi < nmv.length loop {
                b: (nmv.byteAt i: bi).or d: 0
                bi = bi + 1
                if (isIdChar :b) then r.appendByte :b
            }
        }
    }
    return r
}

# memberLetter -- the letter a member's C name starts with, by its family: a
# field `f`, a variant arm `a`, a union's inline arm slot `i`, a vtable slot
# `s`, a parameter `p`.
memberLetter: function {kind: memberkind} out StringView is {
    match (
        kind
    ) case field then {
        return "f"
    } case arm then {
        return "a"
    } case inlineArm then {
        return "i"
    } case slot then {
        return "s"
    } case param then {
        return "p"
    }
}

# memberOrdinal -- the position of the member named `nameId` among `owner`'s
# members of `kind`, in declaration order: a field among the data fields the
# struct lays down (ztypecheck.dataFieldIds, through any typedef to the
# aggregate it aliases), an arm among the sum's arms (armOrdinalOf, the
# ordinal its tag constant carries), a slot among the interface's spec
# methods. none when the owner declares no such member.
memberOrdinal: function {
    # the checked program
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the emission context holding the field-list cache
    ctx: Ctx
    # the struct or interface type
    owner: ztypes.tid
    # which of the owner's lists to count in
    kind: memberkind
    # the member's name, interned
    nameId: zast.nameid
} out optionval u64 is {
    t: chaseAggregateTypedef :reg :typing :ctx tid: owner
    match (
        kind
    ) case arm then {
        return (armOrdinalOf :reg :typing tid: t armId: nameId)
    } case inlineArm then {
        return (armOrdinalOf :reg :typing tid: t armId: nameId)
    } case slot then {
        return (slotOrdinalOf :reg :typing tid: t :nameId)
    } else {
        return (fieldOrdinalOf :reg :typing :ctx tid: t :nameId)
    }
}

# fieldOrdinalOf -- the position of the data field named `nameId` among
# `tid`'s (ztypecheck.dataFieldIds' order); none when it declares no such
# field. Each type's list is read once per emit into ctx.fieldNameIds.
fieldOrdinalOf: function {
    # the checked program
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the emission context, whose cache keeps each list once read
    ctx: Ctx
    # the record or class
    tid: ztypes.tid
    # the field's name, interned
    nameId: zast.nameid
} out optionval u64 is {
    start: u64
    so: ctx.fieldListAt.get key: tid
    match (
        so
    ) case some then {
        start = so
    } case none then {
        start = ctx.fieldNameIds.length
        ids: ListVal ztypes.tid
        nms: ListVal zast.nameid
        ztypecheck.dataFieldIds :reg :typing :tid :ids nameIds: nms
        for each fnm: nms loop ctx.fieldNameIds.append fnm
        ctx.fieldNameIds.append zast.nameid.zero
        ctx.fieldListAt.set key: tid value: start
    }
    k: u64
    i: start
    for true loop {
        f: ctx.fieldNameIds.get :i
        if f.isZero then break
        if f == nameId then return (optionval.some k)
        k = k + 1
        i = i + 1
    }
    return (optionval.none u64)
}

# slotOrdinalOf -- the position of the spec method named `nameId` among
# interface `tid`'s (protoChildMethods' order); none when it declares no such
# method.
slotOrdinalOf: function {
    # the checked program
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the facet or protocol
    tid: ztypes.tid
    # the method's name, interned
    nameId: zast.nameid
} out optionval u64 is {
    k: u64
    i: u64
    n: typing.declRowSlots ownerTid: tid
    for i < n loop {
        rw: typing.declRowAt ownerTid: tid membersOnly: true slot: i
        i = i + 1
        if rw.keep when (reg.typetypeOf typeId: rw.tid) == ztypes.ztypetype.functionType when (
            rw.name != zast.wellKnown.slot.wkCreate
        ) then {
            if rw.name == nameId then return (optionval.some k)
            k = k + 1
        }
    }
    return (optionval.none u64)
}

# emitLocalAtomName -- a local variable's C spelling: the alias or narrowing
# cast in scope for it, else its own identifier. Shared by the atomid and
# labelvalue (:name shorthand) value legs.
emitLocalAtomName: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx
    name: StringView
    vid: ztypes.vid
} out String is {
    facts: cfacts
    return (emitLocalAtomNameWith :ast :reg :ctx :name :vid :facts)
}

# emitLocalAtomNameWith -- emitLocalAtomName, its facts stated into `facts`.
emitLocalAtomNameWith: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx
    name: StringView
    vid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    # Probed directly rather than through aliasResolve: that would synthesize a
    # copy of `name` for the no-alias case, which is the common one, only for the
    # comparison below to discard it.
    nb: vidFind xs: ctx.narrowBox :vid
    if nb > 0 then {
        noteAliasRead :ctx :vid
        return (entryText xs: ctx.narrowBox at: nb - 1 :facts)
    }
    al: vidFind xs: ctx.aliases :vid
    if al > 0 then return (entryText xs: ctx.aliases at: al - 1 :facts)
    return (localNameText :ast :reg :ctx :vid :name :facts)
}

# localNameText -- a local's own C spelling, and its facts: a variable's name is
# a path. With no variable behind it (vid 0) the spelling is the text the
# caller handed in -- a literal, a definition's name, or nothing.
localNameText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    vid: ztypes.vid
    name: StringView
    facts: cfacts.borrow
} out String is {
    if vid.notZero then return (
        stating
        :facts
        from: pathFacts
        text: (varCName :ctx :ast :reg :vid)
    )
    t: nameCName :ctx :name
    if vid.isZero then {
        # a number literal is a constant; any other name with no variable behind
        # it is a definition's -- a unit, a function, a type -- a designator
        if ((t.stringView.byteAt i: 0).or d: 0) <= 57 then return (
            stating
            :facts
            from: constFacts
            text: t
        )
        return (stating :facts from: pathFacts text: t)
    }
    return (stating :facts from: pathFacts text: t)
}

# entryText -- the text an alias or narrowing entry records for a variable, and
# its facts.
entryText: function {xs: (List VidVal).view at: u64 facts: cfacts.borrow} out String is {
    e: xs.get i: at
    return (stating :facts from: e.facts text: e.val.copy)
}

# narrowingEndedAt -- whether the read at `nid` sees the WHOLE local although a
# narrowing aliases its name to a payload: a write ended the narrowing before
# this read -- in this block, in a scope nested before it, in the loop around
# it -- and the checker stamped the read with the local's declared type. The
# alias stays for the reads the narrowing still covers, and each read is told
# apart by its own stamp, so the emitter never has to re-derive where a
# narrowing ends.
narrowingEndedAt: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    nid: zast.nodeid
    vid: ztypes.vid
} out bool is {
    if (vvHas xs: ctx.narrowBox :vid).not then return false
    stamped: stampIdOf :typing :nid
    if stamped.isZero then return false
    return stamped == (reg.variableTypeOf id: vid)
}

# wholeLocalName -- the local's own storage: a take alias where one stands,
# never the payload a narrowing aliased it to; its facts are stated into `facts`.
wholeLocalName: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    name: StringView
    vid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    al: vidFind xs: ctx.aliases :vid
    if al > 0 then return (entryText xs: ctx.aliases at: al - 1 :facts)
    return (localNameText :ast :reg :ctx :vid :name :facts)
}

# emitLocalAtomNameAt -- emitLocalAtomNameWith for the read at `nid`, which sees
# the whole local once a write ended its narrowing.
emitLocalAtomNameAt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nid: zast.nodeid
    name: StringView
    vid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    if (narrowingEndedAt :reg :typing :ctx :nid :vid) then {
        return (wholeLocalName :ast :reg :ctx :name :vid :facts)
    }
    return (emitLocalAtomNameWith :ast :reg :ctx :name :vid :facts)
}

# localAtomNameIsAt -- whether `text` is exactly emitLocalAtomNameAt's spelling
# for the read at `nid`, asked without spelling it: the same three answers in
# the same order -- the narrowing's alias unless a write ended it, the take
# alias, the variable's own name -- each compared where it stands.
localAtomNameIsAt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    nid: zast.nodeid
    name: StringView
    vid: ztypes.vid
    text: StringView
} out bool is {
    if (narrowingEndedAt :reg :typing :ctx :nid :vid).not then {
        nb: vidFind xs: ctx.narrowBox :vid
        if nb > 0 then return (ctx.narrowBox.get i: nb - 1).val.stringView == text
    }
    al: vidFind xs: ctx.aliases :vid
    if al > 0 then return (ctx.aliases.get i: al - 1).val.stringView == text
    return (varCNameIs :ast :reg :ctx :vid :name :text)
}

# aliasResolveAt -- aliasResolve for the read at `nid`: past a narrowing a
# write ended, only a take alias substitutes for the name.
aliasResolveAt: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nid: zast.nodeid
    name: StringView
    vid: ztypes.vid
} out String is {
    if (narrowingEndedAt :reg :typing :ctx :nid :vid).not then return (aliasResolve :ctx :name :vid)
    al: vidFind xs: ctx.aliases :vid
    if al > 0 then return (ctx.aliases.get i: al - 1).val.copy
    return name.string
}

# aliasResolvesToSelfAt -- aliasResolvesToSelf for the read at `nid`.
aliasResolvesToSelfAt: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    nid: zast.nodeid
    name: StringView
    vid: ztypes.vid
} out bool is {
    if (narrowingEndedAt :reg :typing :ctx :nid :vid).not then {
        return (aliasResolvesToSelf :ctx :name :vid)
    }
    al: vidFind xs: ctx.aliases :vid
    if al == 0 then return true
    return (ctx.aliases.get i: al - 1).val.stringView == name
}

# emitStaticListMember -- a list's member read through `n`, whose base is the
# list row `row`: a label (`codes.ht`), an ordinal (`primes.0`), `.length`, or
# `.array` (the whole list copied into an array temp). A read the checker
# folded is its node constant already; this spells the ones it does not fold,
# an element of a typedef type. "" for any other member.
emitStaticListMember: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    row: u64
    mnId: zast.nameid
    facts: cfacts.borrow
} out String is {
    if mnId == zast.wellKnown.slot.tyArray then {
        listTid: stampIdOf :typing nid: n.nodeid
        daid: chaseAggregateTypedef :reg :typing :ctx tid: listTid
        daCt: typeRefC :ast :reg :typing :ctx tid: daid
        daLen: monoLengthText :reg monoId: daid
        daN: ctx.argHoistCtr
        ctx.argHoistCtr = ctx.argHoistCtr + 1
        daNm: "_da\{daN}"
        noteAggUse :ctx :row
        daRaw: "\{daCt} \{daNm};\nfor (int64_t _i = 0; _i < \{daLen.stringView}; _i++) { \{daNm}.data[_i] = _zag\{row}[_i]; }\n"
        recordRawHoist :ctx text: daRaw
        return (stating :facts from: pathFacts text: daNm)
    }
    g: typing.constAggs.get i: row
    # `primes.first` and `codes.4` reach a LABELLED element by its name, an
    # integer label included; `primes.0` an unlabelled one by its ordinal
    pos: typing.aggLabelPos id: row.u32.orPanic label: mnId
    match (
        pos
    ) case some then return (
        stating
        :facts
        from: constFacts
        text: (listItemText :ast :reg :typing :ctx :row slot: pos)
    ) case none then null
    if mnId == zast.wellKnown.slot.wkLength then return (
        stating
        :facts
        from: constFacts
        text: "\{g.itemCount}"
    )
    dcIdx: (zast.nameTextAt :ast ref: mnId).stringView.parseU64
    match (
        dcIdx
    ) case ok then {
        if dcIdx < g.itemCount then return (
            stating
            :facts
            from: constFacts
            text: (listItemText :ast :reg :typing :ctx :row slot: dcIdx)
        )
    } else null
    return "".string
}

# emitListSlotRead -- `P.slot.label` through `n`, whose base `P.slot` hangs off
# the list row: the label's position as a constant of the list's `slot` type.
# "" when the base is no list's `slot`.
emitListSlotRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    mnId: zast.nameid
    facts: cfacts.borrow
} out String is {
    st0: typing.listSlotTid
    if st0.isZero then return "".string
    pid: interpPartNodeId n: (ast.nodes.get i: n.parent)
    if (stampIdOf :typing nid: pid) != st0 then return "".string
    lp: zast.nodeid
    {
        pn: ast.nodes.get i: pid
        if pn.dottedpath then lp = pn.parent
    }
    row: listRowOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: lp))
    if row == 0 then return "".string
    pos: typing.aggLabelPos id: row.u32.orPanic label: mnId
    if pos.some then {
        cf: cfacts
        t: (
            cvalText
            :ast
            :reg
            :typing
            :ctx
            tid: (typing.constAggs.get i: row).slot
            v: ztypes.makeIntConst pos.i64.orPanic
            facts: cf
        )
        return (stating :facts from: constFacts text: t)
    }
    return "".string
}

# nativeNoArgCallC -- the call of `fnTid` when it is a native function taking
# no parameters, reached by a name of its own or by an alias (`stdin`,
# `pidOf: os.pid`): the unit's symbol, as the qualified read spells it
# (emitDottedNativeMarker). A native has no C function under its type's name.
# "" for any other function.
nativeNoArgCallC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fnTid: ztypes.tid
} out String is {
    if (reg.isNativeOf tid: fnTid).not then return "".string
    pi: ListVal ztypes.tid
    pnm: ListVal zast.nameid
    recFieldIds :reg :typing tid: fnTid ids: pi nameIds: pnm
    if pi.length > 0 then return "".string
    un: definedInUnitName :reg :typing tid: fnTid
    if un.length == 0 then return "".string
    fd: typing.declIdOfType typeId: fnTid
    if fd.isZero then return "".string
    mn: zast.nameTextAt :ast ref: (typing.decls.get i: fd).name
    return (nativeUnitCallC :ctx uname: un member: mn.stringView)
}

# nativeUnitCallC -- the call of the unit `uname`'s native `member` that takes
# no parameters, by the unit's symbol, with what it needs noted.
nativeUnitCallC: function {ctx: Ctx uname: StringView member: StringView} out String is {
    needsAddM :ctx :uname memb: "@unit"
    needsAddM :ctx :uname memb: member
    return "z_\{uname}_\{member}()"
}

# fnRefOrCallC -- the C text for a resolved function a bare atom or a dotted
# path names: a node still stamped FUNCTION is a REFERENCE (a `.take` peel
# delegates here) and keeps the bare cname; anything else is the zero-argument
# CALL typecheck coerced, which fills an all-defaulted signature or spells
# `name()`. `requireNoParams` is the atom leg's extra condition -- a function
# with required parameters reaching it means a local binding shadows the name,
# and the empty answer is what sends the caller to emit that local instead.
fnRefOrCallC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nid: zast.nodeid
    fnTid: ztypes.tid
    cname: StringView
    requireNoParams: bool
    facts: cfacts.borrow
} out String is {
    fst: stampIdOf :typing :nid
    if fst.notZero when (reg.typetypeOf typeId: fst) == ztypes.ztypetype.functionType then return (
        stating
        :facts
        from: pathFacts
        text: cname.string
    )
    fad: emitAllDefaultedCall :ast :reg :typing :ctx :fnTid fcn: cname
    if fad.length > 0 then return (stating :facts from: callFacts text: fad)
    nat: nativeNoArgCallC :ast :reg :typing :ctx :fnTid
    if nat.length > 0 then return (stating :facts from: callFacts text: nat)
    if requireNoParams then {
        fpi: ListVal ztypes.tid
        fpiNm: ListVal zast.nameid
        recFieldIds :reg :typing tid: fnTid ids: fpi nameIds: fpiNm
        if fpi.length > 0 then return "".string
    }
    return (stating :facts from: callFacts text: "\{cname}()")
}

# tagAliasArmC -- the C text for a VALUE alias naming one arm of a tagged type
# (`NO: bool.false`). Its Decl carries the ROOT's tid, so without this the atom
# falls through to the raw-name fallback and the C references the alias name.
# Empty when the atom is not one, which is every other bare definition.
tagAliasArmC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    brid: ztypes.tid
    bdec: ztypes.declid
    facts: cfacts.borrow
} out String is {
    if brid.isZero then return "".string
    if bdec.isZero then return "".string
    btt: reg.typetypeOf typeId: brid
    isTag: btt.isSum
    if isTag.not then return "".string
    atk: ztypecheck.reexportTargetIdsOf :typing :ast declId: bdec
    if atk.unitName.u32 == 0 then return "".string
    ctorArmName: atk.defName
    if ctorArmName.isZero then return "".string
    ava: armValueC :ast :ctx :reg :typing tid: brid arm: ctorArmName
    if ava.length > 0 then return (stating :facts from: constFacts text: ava)
    atg: spelledTagConst :ast :ctx :reg :typing tid: brid armId: ctorArmName
    if atg.length == 0 then return "".string
    avc: spelledCname :ctx tid: brid
    return (stating :facts from: literalFacts text: "((\{avc}_t){ .tag = \{atg} })")
}

# implicitZeroValue -- the C text a stamped implicit zero-create builds for the
# stamped type: a scalar's zero, String's empty value, a typedef's base's zero,
# a collection instantiation's empty create, and otherwise the type's own
# create with its field defaults filled. The tid is the STAMP's value, which is
# what the checker decided to construct.
implicitZeroValue: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    zc: scalarCTypeFor :typing :tid
    if zc.length > 0 then return (scalarZeroC :typing cType: zc.stringView :tid :facts)
    if tid == ctx.strTid then return (emitExprStrZero :ctx :facts)
    # a typedef is its base's zero: a scalar base's cast zero (meters -> i64),
    # and otherwise whatever the base builds -- the String struct for Path, a
    # record's create with its defaults
    zb: ztypecheck.typedefChaseTid :typing :tid
    if zb != tid then {
        zt: scalarCTypeFor :typing tid: zb
        if zt.length > 0 then return (scalarZeroC :typing cType: zt.stringView :tid :facts)
        return (implicitZeroValue :ast :reg :typing :ctx tid: zb :facts)
    }
    # The collection is asked BEFORE the scalar chase, and the order is not a
    # preference: a typedef over a collection names its base `ListVal`, which
    # is a template rather than a C scalar or a user function, and the chase
    # panics on it. Asked in this order the chase never sees one.
    zm: chaseAggregateTypedef :reg :typing :ctx :tid
    # a sized str or array is built by its parameterless runtime create
    {
        zso: originTidOf :reg tid: zm
        strO: ctx.origins.get i: family.slot.str
        arrO: ctx.origins.get i: family.slot.fixedArray
        isSized: (zso == strO) or (zso == arrO)
        if isSized when zso.notZero then {
            zsc: spelledCname :ctx tid: zm
            noteMemberUse :ctx mono: zm member: memberWord.slot.create
            return (stating :facts from: callFacts text: "\{zsc}_create()")
        }
    }
    if (isCollectionOriginTid :ctx originTid: (originTidOf :reg tid: zm)) then {
        zmc: spelledCname :ctx tid: zm
        zmt: zm
        # every family whose `create` takes a capacity is built with none
        takesCap: (
            (isListOriginOf :reg :ctx tid: zmt) or
            (isSetOriginOf :reg :ctx tid: zmt) or
            (isMapOriginOf :reg :ctx tid: zmt) or
            (isIdCollectionOriginOf :reg :ctx tid: zmt)
        )
        if takesCap then {
            noteMemberUse :ctx mono: zm member: memberWord.slot.create
            return (stating :facts from: callFacts text: "\{zmc}_create((uint64_t)0)")
        }
        noteMemberUse :ctx mono: zm member: memberWord.slot.create
        return (stating :facts from: callFacts text: "\{zmc}_create()")
    }
    return (emitCtorDefaultsFill :ast :reg :typing :ctx :tid :facts)
}

# scalarZeroC -- the zero of a scalar whose C type is `cType`. A 128-bit
# integer's or an f16's is a braced zero, which C accepts for the C compiler's
# own type and for the struct that stands in for it alike; every other scalar's
# is a cast 0.
scalarZeroC: function {
    typing: ztyping.ZTyping.view
    cType: StringView
    tid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    if (partIsHelperScalar :typing :tid) then {
        return (stating :facts from: literalFacts text: "((\{cType}){0})")
    }
    return (stating :facts from: constFacts text: "((\{cType})0)")
}

# partIsHelperScalar -- the type is i128, u128 or f16, or a scalar typedef over
# one: a value no C operator may touch, since where the C compiler lacks the
# type it is a struct (z_head.inc).
partIsHelperScalar: function {typing: ztyping.ZTyping.view tid: ztypes.tid} out bool is {
    nk: constScalarKindForTid :typing :tid
    if nk.has.not then return false
    return ((ztypes.intKindBits k: nk.kind) == 128) or (nk.kind == ztypes.numkind.f16Type)
}

# emitDefRefAtom -- a bare atom that names a DEFINITION rather than a local: a
# value alias for one arm of a tagged type (`NO: bool.false`), or a bare record /
# class construction, or a function reference. Empty when the atom names none of
# them.
emitDefRefAtom: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.atomidrow.view
    brid: ztypes.tid
    bdec: ztypes.declid
    facts: cfacts.borrow
} out String is {
    taa: tagAliasArmC :ast :reg :typing :ctx :brid :bdec :facts
    if taa.length > 0 then return taa
    if brid.notZero when (reg.typetypeOf typeId: brid) == ztypes.ztypetype.recordType then {
        izr: typing.implicitCreate.get key: n.nodeid
        if izr.some then {
            return (implicitZeroValue :ast :reg :typing :ctx tid: izr :facts)
        }
        # unstamped: a scalar is its zero, any other record its zero struct
        if (scalarCTypeFor :typing tid: brid).length > 0 then return (
            implicitZeroValue
            :ast
            :reg
            :typing
            :ctx
            tid: brid
            :facts
        )
        brc: spelledCname :ctx tid: brid
        return (stating :facts from: literalFacts text: "((\{brc}_t){0})")
    }
    if brid.notZero when (reg.typetypeOf typeId: brid) == ztypes.ztypetype.classType then {
        # no name is written for a class atom that the scalar leg could use:
        # a class typedef over a scalar reaches its zero through the chase
        izc: typing.implicitCreate.get key: n.nodeid
        if izc.some then {
            return (implicitZeroValue :ast :reg :typing :ctx tid: izc :facts)
        }
    }
    if brid.notZero when (reg.typetypeOf typeId: brid) == ztypes.ztypetype.functionType then {
        fbcn: spelledCname :ctx tid: brid
        return (
            fnRefOrCallC
            :ast
            :reg
            :typing
            :ctx
            nid: n.nodeid
            fnTid: brid
            cname: fbcn.stringView
            requireNoParams: true
            :facts
        )
    }
    return "".string
}

# staticListValueText -- a list reached by a compile-time path, read as a
# value: the view of its static array (listValueC). "" when the node folded to
# no list.
staticListValueText: function {
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nid: zast.nodeid
} out String is {
    row: listRowOf :typing :nid
    if row == 0 then return "".string
    return (listValueC :typing :ctx :row)
}

# listValueC -- list row `row` as a value: the view of its static array,
# `((z_M_t){ .length = N, .data = _zagN })` -- NULL for an empty list, which
# has none.
listValueC: function {typing: ztyping.ZTyping.view ctx: Ctx row: u64} out String is {
    g: typing.constAggs.get i: row
    vc: ctxCname :ctx tid: g.tid
    if g.itemCount == 0 then return "((\{vc}_t){ .length = 0, .data = NULL })"
    noteAggUse :ctx :row
    return "((\{vc}_t){ .length = \{g.itemCount}, .data = _zag\{row} })"
}

# namespaceConstText -- a constant named `nameId` written inside a namespace:
# resolved against that namespace first -- the chain spec.pdoc gives an inline
# unit -- and then each unit enclosing it, innermost outward. A generic unit's
# mono method is written in the TEMPLATE, whose Decl the mono's id points at, so
# its chain starts there. "" when no enclosing namespace declares it.
namespaceConstText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nameId: zast.nameid
    facts: cfacts.borrow
} out String is {
    nsAt: ctx.nsTid
    if nsAt.isZero when ctx.curThisTid.notZero when (
        (reg.typetypeOf typeId: ctx.curThisTid) == ztypes.ztypetype.unitType
    ) then nsAt = ctx.curThisTid
    if nsAt.isZero then return "".string
    nsCur: ztypecheck.templateDeclOf :reg :typing tid: nsAt
    for nsCur.notZero loop {
        nsFt: typing.declTypeOf declId: nsCur
        if nsFt.notZero then {
            nsca: memberConstText :ast :reg :typing :ctx unitTid: nsFt :nameId :facts
            if nsca.length > 0 then return nsca
            nscs: memberConstStringText :typing :ctx unitTid: nsFt :nameId :facts
            if nscs.length > 0 then return nscs
        }
        nsNx: typing.declParentOf declId: nsCur
        nsCur = ztypes.declid
        if nsNx.notZero when (ztypecheck.declDeclaresUnit :typing :ast declId: nsNx
        ) then nsCur = nsNx
    }
    return "".string
}

# emitAtom -- the C text of a bare identifier. A STAMPED atom is a local and is
# answered first (the module-constant probe below costs an owned key and a hash);
# then a name written inside a namespace, then a stamped unit-def reference, and
# only then the name probe an unstamped template re-emission needs.
emitAtom: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.atomidrow.view
    # its facts, where a leg knows them; a leg that does not leaves the slot
    # unfilled for its caller to read off the text
    facts: cfacts.borrow
} out String is {
    avC: ast.names.texts.get i: n.name
    av: avC.stringView
    # a unit constant a match arm narrowed reads the payload it holds there
    if (typing.narrowedConstReads.has key: n.nodeid) then {
        nw: nodeConstText :ast :reg :typing :ctx nid: n.nodeid :facts
        if nw.length > 0 then return nw
    }
    dv: staticListValueText :typing :ctx nid: n.nodeid
    if dv.length > 0 then return (stating :facts from: literalFacts text: dv)
    # a literal landing in an i128, u128 or f16 is that type's value
    if (typing.helperScalarTarget.has key: n.nodeid) then {
        wa: nodeConstText :ast :reg :typing :ctx nid: n.nodeid :facts
        if wa.length > 0 then return wa
    }
    # an integer literal outside i64 is spelled by its value, which the checker
    # settled in the type it landed in: C has no token for one past u64, and
    # none in binary or octal at all
    if av.length >= 19 when ((av.byteAt i: 0).or d: 0) <= 57 then {
        wc: nodeConstText :ast :reg :typing :ctx nid: n.nodeid :facts
        if wc.length > 0 then return wc
    }
    # a `0b` / `0o` / `0c` literal has no C token behind it, so decode it here
    # (decimal, hex and float lexemes are C text as written; identifiers never
    # start with a digit)
    if av.startsWith "0" then {
        cl: literalC lex: av
        if cl.length > 0 when cl.stringView != av then return (
            stating
            :facts
            from: constFacts
            text: cl
        )
        if cl.length == 0 then {
            emitFail :ctx what: "invalid numeric literal \{av}" line: n.lineno
            return (
                stating
                :facts
                from: failedFacts
                text: "0".string
            )
        }
    }
    wl: wideLiteralC :ctx lex: av
    if wl.length > 0 then return wl
    # stamped variable use first: the local, alias-resolved and C-mangled
    # -- a stamped atom is a LOCAL, so the module-constant probe (an owned
    # key alloc + hash) never runs for it
    avo: typing.atomVariableId.get key: n.nodeid
    if avo.some then {
        if (narrowingEndedAt :reg :typing :ctx nid: n.nodeid vid: avo) then {
            return (wholeLocalName :ast :reg :ctx name: av vid: avo :facts)
        }
        return (emitLocalAtomNameWith :ast :reg :ctx name: av vid: avo :facts)
    }
    nsc: namespaceConstText :ast :reg :typing :ctx nameId: n.name :facts
    if nsc.length > 0 then return nsc
    mutd: mainUnitTid :typing :ctx
    mca: memberConstText :ast :reg :typing :ctx unitTid: mutd nameId: n.name :facts
    if mca.length > 0 then return mca
    mcsa: memberConstStringText :typing :ctx unitTid: mutd nameId: n.name :facts
    if mcsa.length > 0 then return mcsa
    # stamped unit-def reference: the RECORD / FUNCTION legs run off the
    # stamped declaration; an atom with none names no definition
    brid: ztypes.tid
    bdec: ztypes.declid
    {
        audo: typing.refDecl.get key: n.nodeid
        if audo.some then {
            d0x: typing.decls.get i: audo
            brid = d0x.typeId
            bdec = audo
        }
    }
    # a generic parameter read as a value -- itself, or through an alias of
    # it -- is the zero value of the instance's argument, which the instance
    # walk stamped
    if brid.notZero when (reg.typetypeOf typeId: brid) == ztypes.ztypetype.genericParam then {
        pzt: stampIdOf :typing nid: n.nodeid
        if pzt.notZero when pzt != brid then return (
            implicitZeroValue
            :ast
            :reg
            :typing
            :ctx
            tid: pzt
            :facts
        )
    }
    dra: emitDefRefAtom :ast :reg :typing :ctx :n :brid :bdec :facts
    if dra.length > 0 then return dra
    # a stamped implicit zero-create on a String atom is the empty
    # owned string: the zero struct needs no allocation and no free
    iso: typing.implicitCreate.get key: n.nodeid
    if iso.some when iso == ctx.strTid then return (emitExprStrZero :ctx :facts)
    # a numeric lexeme no leg above respelled is C text as written: identifiers
    # never start with a digit
    if ((av.byteAt i: 0).or d: 0) <= 57 then return (stating :facts from: constFacts text: av.string
    )
    return (
        emitLocalAtomNameAt
        :ast
        :reg
        :typing
        :ctx
        nid: n.nodeid
        name: av
        vid: (atomVid :typing nid: n.nodeid)
        :facts
    )
}

# emitNestedStringViewBase -- `.stringView` on a nested String/StringView base
# projects an inline VIEW rather than reading a field, matching what the simple
# base does through svValueForm.
emitNestedStringViewBase: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    mnId: zast.nameid
    facts: cfacts.borrow
} out String is {
    if (ztypecheck.isStringViewMember nameId: mnId) then {
        ppid: interpPartNodeId n: (ast.nodes.get i: n.parent)
        parentStampTid: stampIdOf :typing nid: ppid
        if parentStampTid == ctx.strTid then {
            pbvF: cfacts
            pbv: emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent) facts: pbvF
            pbq: (
                atomVidIfPlain
                :ast
                :reg
                :typing
                :ctx
                n: (ast.nodes.get i: n.parent)
                text: pbv.stringView
            )
            sv: (
                svValueFormAt
                :ast
                :reg
                :typing
                :ctx
                n: (ast.nodes.get i: n.parent)
                expr: pbv.stringView
                isStr: true
                vid: pbq
                facts: pbvF
            )
            return (stating :facts from: pbvF text: sv)
        }
        if parentStampTid == ctx.svTid then {
            return (emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent) :facts)
        }
    }
    return "".string
}

# nestedCounterRead -- a container's `length` or `capacity` reached through a
# FIELD. The counters are METHODS that read a field of the runtime's struct, so
# they lower to that read wherever the receiver came from, as the atom legs do.
# An array's length is its size parameter, which the struct does not store: the
# mono's `_length` constant spells it. "" for any other member.
nestedCounterRead: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx
    mnId: zast.nameid
    nlid: ztypes.tid
    baseAtom: StringView
    baseAtomF: cfacts
    recvIsPtr: bool
    facts: cfacts.borrow
} out String is {
    isLength: mnId == zast.wellKnown.slot.wkLength
    arrO: ctx.origins.get i: family.slot.fixedArray
    if isLength when (originIsTid :reg tid: nlid originTid: arrO) then {
        acnb: ctxCname :ctx tid: nlid
        noteMemberUse :ctx mono: nlid member: memberWord.slot.lengthOf
        return (stating :facts from: constFacts text: "\{acnb}_length")
    }
    isCounted: (
        (isListOriginOf :reg :ctx tid: nlid) or
        (isListViewOriginOf :reg :ctx tid: nlid) or
        (staticListValueFamilyOf :reg :ctx tid: nlid).notZero or
        (isSetOriginOf :reg :ctx tid: nlid) or
        (isMapOriginOf :reg :ctx tid: nlid) or
        (isIdCollectionOriginOf :reg :ctx tid: nlid)
    )
    if isCounted.not then return "".string
    accN: ".".string
    if recvIsPtr then accN = "->".string
    if isLength then return (
        stating
        :facts
        from: (memberFacts b: baseAtomF)
        text: "\{baseAtom}\{accN}length"
    )
    if mnId == zast.wellKnown.slot.wkCapacity then return (
        stating
        :facts
        from: (memberFacts b: baseAtomF)
        text: "\{baseAtom}\{accN}capacity"
    )
    return "".string
}

# stackCollectionTid -- a List or an id container: a stack struct whose methods
# take its address.
stackCollectionTid: function {
    reg: ztypes.ZTypeRegistry.view ctx: Ctx.view tid: ztypes.tid
} out bool is {
    if (isListOriginOf :reg :ctx :tid) then return true
    return (isIdCollectionOriginOf :reg :ctx :tid)
}

# callBaseTemp -- the temporary a stack collection, view or templated class base
# that is a call's result is bound to, "" when the base needs none. Every
# collection leg and every templated method takes the base's address, and a
# call's result has none: `(ls.get i: 0).listView` wrote `&z_get(...)`, which C
# rejects. Bound as a method call's receiver is
callBaseTemp: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nlid: ztypes.tid
    base: StringView
    baseF: cfacts
    nstPtr: bool
    baseNid: zast.nodeid
} out String is {
    if nstPtr then return "".string
    # a view -- a static list's, a List's -- is a stack struct its walks take by
    # address too
    isView: isListViewOriginOf :reg :ctx tid: nlid
    if (staticListValueFamilyOf :reg :ctx tid: nlid).notZero then isView = true
    if (tmplClassRowOf :reg :ctx tid: nlid) > 0 then isView = true
    if (stackCollectionTid :reg :ctx tid: nlid).not when isView.not then return "".string
    if (canTakeAddress f: baseF) then return "".string
    return (
        hoistForAddress
        :ast
        :reg
        :typing
        :ctx
        av: base
        tid: nlid
        tag: ((typing.unnamedLocalOfNode.get key: baseNid).or d: zast.nameid.zero)
        argNid: baseNid
    )
}

# nestedStrMember -- a sized str's member read through a field: its length, its
# size constant, its String, and its view, which reads the base twice. "" for
# any other member.
nestedStrMember: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    mnId: zast.nameid
    nlid: ztypes.tid
    baseAtom: StringView
    baseAtomF: cfacts
    baseNid: zast.nodeid
    facts: cfacts.borrow
} out String is {
    nstrcb: spelledCname :ctx tid: nlid
    if mnId == zast.wellKnown.slot.wkLength then return (
        stating
        :facts
        from: (memberFacts b: baseAtomF)
        text: "\{baseAtom}.len"
    )
    if mnId == zast.wellKnown.slot.wkSize then {
        noteMemberUse :ctx mono: nlid member: memberWord.slot.size
        return (stating :facts from: constFacts text: "\{nstrcb}_size")
    }
    if mnId == zast.wellKnown.slot.wkString then {
        noteMemberUse :ctx mono: nlid member: memberWord.slot.string
        return (stating :facts from: callFacts text: "\{nstrcb}_string(\{baseAtom})")
    }
    if (ztypecheck.isStringViewMember nameId: mnId) then {
        bound: String
        if baseAtomF.once then bound = (
            readOnce
            :ast
            :reg
            :typing
            :ctx
            text: baseAtom
            textF: baseAtomF
            tid: nlid
            nid: baseNid
        )
        sb: baseAtom
        if bound.length > 0 then sb = bound.stringView
        svT: svTypeC :ctx
        return (
            stating
            :facts
            from: literalFacts
            text: "(\{svT}){ .data = \{sb}.data, .size = \{sb}.len }"
        )
    }
    return "".string
}

# emitNestedCollectionBase -- a str or collection mono reached through a FIELD.
# Set and Map are heap pointers and pass directly; the id-keyed pair are stack
# structs and go by address. `recvIsPtr` is whether the base expression is
# already a pointer, which picks the accessor a counter reads through.
emitNestedCollectionBase: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    mn2: StringView
    mnId: zast.nameid
    nlid: ztypes.tid
    baseAtom: StringView
    baseAtomF: cfacts
    baseNid: zast.nodeid
    baseVid: ztypes.vid
    recvIsPtr: bool
    facts: cfacts.borrow
} out String is {
    eCt: nestedCounterRead :reg :ctx :mnId :nlid :baseAtom :baseAtomF :recvIsPtr :facts
    if eCt.length > 0 then return eCt
    wmn: (
        windowMemberRead
        :ast
        :reg
        :typing
        :ctx
        :mnId
        tid: nlid
        base: baseAtom
        baseF: baseAtomF
        :baseNid
        :recvIsPtr
        vid: baseVid
        :facts
    )
    if wmn.length > 0 then return wmn
    if mnId == zast.wellKnown.slot.wkCopy then {
        fam: copyFamilyOf :reg :ctx tid: nlid
        if fam > 0 then {
            crv: colRecvRef :ctx bn: baseAtom vid: baseVid
            return (
                containerCopyText
                :ctx
                tid: nlid
                :fam
                stackRecv: crv.stringView
                heapRecv: baseAtom
                :facts
            )
        }
    }
    if (originIsTid :reg tid: nlid originTid: (ctx.origins.get i: family.slot.str)) then {
        nsm: nestedStrMember :ast :reg :typing :ctx :mnId :nlid :baseAtom :baseAtomF :baseNid :facts
        if nsm.length > 0 then return nsm
    }
    if (isListOriginOf :reg :ctx tid: nlid) then {
        nlcb: spelledCname :ctx tid: nlid
        recvB: colRecvRef :ctx bn: baseAtom vid: baseVid
        if mnId == zast.wellKnown.slot.wkPop then {
            noteMemberUse :ctx mono: nlid member: memberWord.slot.pop
            return (stating :facts from: callFacts text: "\{nlcb}_pop(\{recvB})")
        }
        if mnId == zast.wellKnown.slot.wkSort then {
            noteMemberUse :ctx mono: nlid member: memberWord.slot.sort
            return (stating :facts from: callFacts text: "\{nlcb}_sort(\{recvB})")
        }
        if (ztypecheck.isListViewMember nameId: mnId) then {
            noteMemberUse :ctx mono: nlid member: memberWord.slot.listView
            return (stating :facts from: callFacts text: "\{nlcb}_listView(\{recvB})")
        }
        if (isListWalkMember name: mn2) then {
            noteMemberUse :ctx mono: nlid member: (ctx.memberWords.slotOf text: mn2)
            w9: "_\{mn2}("
            return (stating :facts from: callFacts text: "\{nlcb}\{w9}\{recvB})")
        }
    }
    if (staticListValueFamilyOf :reg :ctx tid: nlid).notZero when (
        mnId == zast.wellKnown.slot.wkIterate
    ) then {
        ndcb: spelledCname :ctx tid: nlid
        recvD: colRecvRef :ctx bn: baseAtom vid: baseVid
        noteMemberUse :ctx mono: nlid member: memberWord.slot.iterateAll
        return (stating :facts from: callFacts text: "\{ndcb}_iterate(\{recvD})")
    }
    # a view walks too: its read walks reached through a field or off a call's
    # result (`l.listView.iterate`, the iterable of `for each w: l.listView`)
    if (isListViewOriginOf :reg :ctx tid: nlid) when (isListReadWalkMember name: mn2) then {
        nvcb: spelledCname :ctx tid: nlid
        recvV: colRecvRef :ctx bn: baseAtom vid: baseVid
        noteMemberUse :ctx mono: nlid member: (ctx.memberWords.slotOf text: mn2)
        wv9: "_\{mn2}("
        return (stating :facts from: callFacts text: "\{nvcb}\{wv9}\{recvV})")
    }
    # Set/Map are heap-pointer collections; their methods are emitted by the
    # collection template, not as registry children a CLASS dispatch would
    # find. The receiver field is already a pointer, so it is passed directly
    # (no `&`).
    if (isSetOriginOf :reg :ctx tid: nlid) then {
        nscb: spelledCname :ctx tid: nlid
        if mnId == zast.wellKnown.slot.wkIterate then {
            noteMemberUse :ctx mono: nlid member: memberWord.slot.iterateAll
            return (stating :facts from: callFacts text: "\{nscb}_iterate(\{baseAtom})")
        }
    }
    if (isMapOriginOf :reg :ctx tid: nlid) then {
        nmpcb: spelledCname :ctx tid: nlid
        if mnId == zast.wellKnown.slot.wkIterate then {
            noteMemberUse :ctx mono: nlid member: memberWord.slot.iterateAll
            return (stating :facts from: callFacts text: "\{nmpcb}_iterate(\{baseAtom})")
        }
        if mnId == zast.wellKnown.slot.wkIterateItems then {
            noteMemberUse :ctx mono: nlid member: memberWord.slot.iterateItems
            return (stating :facts from: callFacts text: "\{nmpcb}_iterateItems(\{baseAtom})")
        }
    }
    # the id-keyed pair reached through a FIELD. They are stack structs, so
    # the receiver goes by address where a Map's field is already a pointer.
    if (isIdCollectionOriginOf :reg :ctx tid: nlid) then {
        nidcb: spelledCname :ctx tid: nlid
        nidrv: colRecvRef :ctx bn: baseAtom vid: baseVid
        if mnId == zast.wellKnown.slot.wkIterate then {
            noteMemberUse :ctx mono: nlid member: memberWord.slot.iterateAll
            return (stating :facts from: callFacts text: "\{nidcb}_iterate(\{nidrv})")
        }
        if mnId == zast.wellKnown.slot.wkIterateItems then {
            noteMemberUse :ctx mono: nlid member: memberWord.slot.iterateItems
            return (stating :facts from: callFacts text: "\{nidcb}_iterateItems(\{nidrv})")
        }
    }
    return "".string
}

# emitNestedMonoMethodBase -- a no-argument METHOD on a nested receiver whose
# type is a registered mono: protocol dispatch, the view natives, then the
# owner's own method, taking the receiver by address where its signature says.
emitNestedMonoMethodBase: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    mn2: StringView
    mnId: zast.nameid
    nlid: ztypes.tid
    baseAtom: StringView
    baseAtomF: cfacts
    baseVid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    readIsRef: (
        (reg.typetypeOf typeId: (stampIdOf :typing nid: n.nodeid)) == ztypes.ztypetype.functionType
    )
    if nlid.notZero then {
        nrtt: reg.typetypeOf typeId: nlid
        # a protocol/facet-typed base reached through a FIELD dispatches
        # exactly as a bare one does; without this the member read falls
        # through to the struct-field leg below and gcc rejects it
        viaVtable: vtableAutoCallName :ast leaf: n.child nameId: mnId
        if (isDispatchableTid :reg tid: nlid) when viaVtable then {
            nacc: ".".string
            if (
                pathIsPointer
                :ast
                :reg
                :typing
                :ctx
                n: (ast.nodes.get i: n.parent)
            ) then nacc = "->".string
            nrecv: (
                receiverOnceAt
                :ast
                :reg
                :typing
                :ctx
                baseNid: n.parent
                text: baseAtom
                textF: baseAtomF
                tid: nlid
            )
            return (stating :facts from: callFacts text: (
                vtableAutoCallC
                :ast
                :reg
                :typing
                :ctx
                owner: nlid
                recv: nrecv.stringView
                acc: nacc.stringView
                :mnId
                isFacet: nrtt == ztypes.ztypetype.facetType
            )
            )
        }
        nDisp: nrtt.isFieldwise
        if nDisp when (typing.declIsFnptrFieldId parentTypeId: nlid nameId: mnId) then {
            if readIsRef then return "".string
            return (
                stating
                :facts
                from: callFacts
                text: (
                    nestedFnptrFieldRead
                    :ast
                    :reg
                    :typing
                    :ctx
                    :n
                    :mnId
                    :nlid
                    :baseAtom
                    :baseAtomF
                )
            )
        }
        if nDisp then {
            return (
                nestedOwnMethodCall
                :ast
                :reg
                :typing
                :ctx
                :n
                :mn2
                :mnId
                :nlid
                :baseAtom
                :baseAtomF
                :baseVid
                :facts
            )
        }
    }
    return "".string
}

# nestedOwnMethodCall -- the owner's own no-argument method `mnId` on a nested
# base of a fieldwise type `nlid`: a view native on a stringy base by its native
# symbol, a member without a receiver through its type's path, else the call
# with the receiver by address where its signature says. "" when the owner has
# no such method.
nestedOwnMethodCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    mn2: StringView
    mnId: zast.nameid
    nlid: ztypes.tid
    baseAtom: StringView
    baseAtomF: cfacts
    baseVid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    nmco: typing.declChildOfId parentTypeId: nlid nameId: mnId
    if nmco.some when (reg.typetypeOf typeId: nmco) == ztypes.ztypetype.functionType then {
        # no-arg SV natives on a nested stringy base: the
        # canonical native symbol, not the method-id cname
        if (svCallOf :reg :typing :ctx nameId: mnId).noarg when (
            isStringyTid
            :ctx
            tid: nlid
        ) then {
            demandSvMember :reg :typing :ctx nameId: mnId
            svfnF: baseAtomF
            svfn: (
                svValueForm
                :ast
                :reg
                :typing
                :ctx
                expr: baseAtom
                isStr: nlid == ctx.strTid
                vid: baseVid
                facts: svfnF
            )
            return (stating :facts from: callFacts text: "\{ctx.svC}_\{mn2}(&\{svfn})")
        }
        nmc: autoCallCname :reg :typing :ctx owner: nlid method: nmco
        # a member without a receiver is reached only through its
        # type's path (`unit.Type.make`), which is no argument
        if (fnTypeTakesThis :reg :typing tid: nmco).not then {
            return (stating :facts from: callFacts text: (
                receiverCallText
                :ast
                :reg
                :typing
                :ctx
                callee: nmc.stringView
                recv: ""
                fnTid: nmco
            )
            )
        }
        # a receiver-taking method takes it by pointer in both
        # families, so address it unless it already is one
        nmrecv: "\{baseAtom}"
        if (calleeTakesReceiverByPtr :ast :reg :typing fid: nmco) then {
            dpu: ast.nodes.get i: n.parent
            if (pathIsPointer :ast :reg :typing :ctx n: dpu).not then {
                # the receiver is passed by address, and a base
                # that IS a call is not an lvalue -- `&f(x)` is C
                # the compiler rejects. emitByrefArgWith hoists such a
                # value into the `_ahN` temp an argument gets; a
                # plain name still emits as `&name`.
                nmrF: cfacts
                nmrecv = (
                    emitByrefArgWith
                    :ast
                    :reg
                    :typing
                    :ctx
                    av: baseAtom
                    avF: baseAtomF
                    pid: nlid
                    argNid: n.parent
                    facts: nmrF
                )
            }
        }
        return (stating :facts from: callFacts text: (
            receiverCallText
            :ast
            :reg
            :typing
            :ctx
            callee: nmc.stringView
            recv: nmrecv.stringView
            fnTid: nmco
        )
        )
    }
    return "".string
}

# nestedFnptrFieldRead -- a FUNCTION FIELD read off a nested base: the field is
# the instance's own slot, so the read calls through it, never the function the
# declaration wrote as its default. A read stamped as the field's function is
# the field itself, and never reaches here.
nestedFnptrFieldRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the read
    n: zast.dottedpathrow.view
    # the field's name
    mnId: zast.nameid
    # the record or class it is read off
    nlid: ztypes.tid
    # the base's C expression
    baseAtom: StringView
    baseAtomF: cfacts
} out String is {
    nfbase: baseAtom.string
    nfacc: ".".string
    nfrcv: "&\{baseAtom}"
    if (pathIsPointer :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent)) then {
        nfacc = "->".string
        nfrcv = baseAtom.string
    } else if baseAtomF.place.not then {
        # a call's result is read through ONE hoisted temporary: the
        # slot and the receiver it is handed are the same value
        nfF: cfacts
        nfrcv = (
            emitByrefArgWith
            :ast
            :reg
            :typing
            :ctx
            av: baseAtom
            avF: baseAtomF
            pid: nlid
            argNid: n.parent
            facts: nfF
        )
        nfbase = "(\{nfrcv})"
        nfacc = "->".string
    }
    nfco: (
        (typing.declChildOfId parentTypeId: nlid nameId: mnId).or
        d: ztypes.tid.zero
    )
    if (fnTypeTakesThis :reg :typing tid: nfco).not then nfrcv = "".string
    return (
        fnptrSlotCallC
        :ast
        :reg
        :typing
        :ctx
        owner: nlid
        base: nfbase.stringView
        acc: nfacc.stringView
        :mnId
        recv: nfrcv.stringView
    )
}

# unitInstanceMemberRead -- a zero-argument function of a unit applied in place
# (`(sized n: 4).cap`): the instance's own function, called. A unit has no
# runtime value, so its base is not emitted; a read naming the function (a
# `.take` of it) is its C name. "" when the base is no unit instance.
unitInstanceMemberRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    facts: cfacts.borrow
} out String is {
    bst: stampIdOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: n.parent))
    if (reg.typetypeOf typeId: bst) != ztypes.ztypetype.unitType then return "".string
    if (originTidOf :reg tid: bst).isZero then return "".string
    cid: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
    fid: (
        ztypes.tid.create
        from: ((typing.declChildOfId parentTypeId: bst nameId: cid).or d: ztypes.tid.zero)
    )
    if (reg.typetypeOf typeId: fid) != ztypes.ztypetype.functionType then return "".string
    cn: spelledCname :ctx tid: fid
    if (
        (reg.typetypeOf typeId: (stampIdOf :typing nid: n.nodeid)) == ztypes.ztypetype.functionType
    ) then {
        return (stating :facts from: pathFacts text: cn)
    }
    cn.append "("
    cn.append (renderedMethodDefaultArgs :ast :reg :typing :ctx fnTid: fid)
    cn.append ")"
    return (stating :facts from: callFacts text: cn)
}

# nestedStringMember -- a String or StringView member read through a FIELD: a
# String method on the receiver, or a view parse native. A typedef over either
# (`Path`, `PathView`) shares its base's struct and methods and answers the
# same. "" when the receiver is neither, or the member is none of these.
nestedStringMember: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    parent: astnode.view
    base: StringView
    baseF: cfacts
    mnId: zast.nameid
    baseVid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    nptT: chaseStrTypedef :typing :ctx tid: (stampIdDeep :reg :typing n: parent)
    if nptT == ctx.strTid then {
        nsm: (
            emitStringMethod
            :ast
            :reg
            :typing
            :ctx
            recv: base
            recvF: baseF
            recvIsPtr: (pathIsPointer :ast :reg :typing :ctx n: parent)
            :mnId
            recvVid: baseVid
            :facts
        )
        if nsm.length > 0 then return nsm
    }
    return "".string
}

# nestedBaseText -- a nested read's base expression, and its facts: read off the
# checker's temporary when it is a call's owning result, which the temporary
# frees.
nestedBaseText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    facts: cfacts.borrow
} out String is {
    b: emitExprWith :ast :reg :typing :ctx :n :facts
    bh: ownedReceiverHoist :ast :reg :typing :ctx expr: b.stringView exprF: facts :n
    if bh.length > 0 then return (stating :facts from: pathFacts text: bh)
    return b
}

# typePathMemberCall -- a member without a receiver read off a nested base
# (`(vec n: 3).ones`): the base is the type's path, which is no argument, so it
# is never built -- building it would write, and record, C nothing spells. ""
# for a member that takes one, or that another leg serves (a collection's, a
# protocol's, a native, a function field).
typePathMemberCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    mnId: zast.nameid
    facts: cfacts.borrow
} out String is {
    pnid: interpPartNodeId n: (ast.nodes.get i: n.parent)
    nlid: stampIdOf :typing nid: pnid
    nlid = typedefMethodOwner :reg :typing :ctx tid: nlid :mnId
    if nlid.isZero then return "".string
    if (reg.typetypeOf typeId: nlid).isFieldwise.not then return "".string
    if (isCollectionOriginTid :ctx originTid: (originTidOf :reg tid: nlid)) then return "".string
    if (isDispatchableTid :reg tid: nlid) then return "".string
    if (isStringyTid :ctx tid: nlid) then return "".string
    if (typing.declIsFnptrFieldId parentTypeId: nlid nameId: mnId) then return "".string
    mo: typing.declChildOfId parentTypeId: nlid nameId: mnId
    match (
        mo
    ) case some then {
        if (reg.typetypeOf typeId: mo) != ztypes.ztypetype.functionType then return "".string
        if (reg.isNativeOf tid: mo) or (fnTypeTakesThis :reg :typing tid: mo) then return "".string
        nmc: autoCallCname :reg :typing :ctx owner: nlid method: mo
        return (stating :facts from: callFacts text: (
            receiverCallText
            :ast
            :reg
            :typing
            :ctx
            callee: nmc.stringView
            recv: ""
            fnTid: mo
        )
        )
    } case none then return "".string
}

# emitDottedNestedBase -- a read whose base is itself a path (`it.target.a`,
# `this.field.pop`): emit the base expression, then chain `.` or `->` by whether
# the base resolves to a pointer. The collection legs repeat here because the
# atom-base ones key off a stamped ATOM, which a nested path does not have.
emitDottedNestedBase: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    mn2: StringView
    mnId: zast.nameid
    facts: cfacts.borrow
} out String is {
    # `.stringView` on a String/StringView projects an inline view, not a
    # field access (matches the simple-base svValueForm path).
    eSv: emitNestedStringViewBase :ast :reg :typing :ctx :n :mnId :facts
    if eSv.length > 0 then return eSv
    eUi: unitInstanceMemberRead :ast :reg :typing :ctx :n :facts
    if eUi.length > 0 then return eUi
    eTl: typePathMemberCall :ast :reg :typing :ctx :n :mnId :facts
    if eTl.length > 0 then return eTl
    # a nested base (e.g. it.target.a): emit the base expression, then chain
    # `.`/`->` by whether the base resolves to a pointer (a pointer variable or a lock field).
    baseAtomF: cfacts
    baseAtom: nestedBaseText :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent) facts: baseAtomF
    baseVid: (
        atomVidIfPlain
        :ast
        :reg
        :typing
        :ctx
        n: (ast.nodes.get i: n.parent)
        text: baseAtom.stringView
    )
    if baseAtomF.failed then {
        emitFail :ctx what: "unhandled dotted".string line: n.lineno
        return (stating :facts from: failedFacts text: "0".string)
    }
    nsm: (
        nestedStringMember
        :ast
        :reg
        :typing
        :ctx
        parent: (ast.nodes.get i: n.parent)
        base: baseAtom.stringView
        baseF: baseAtomF
        :mnId
        :baseVid
        :facts
    )
    if nsm.length > 0 then return nsm
    # a no-arg List method on a nested receiver (this.field.pop): the bsmn
    # leg above missed it (bstamp keys off an atom base, 0 for a nested
    # path). Resolve the List mono from the base node and emit the call. A
    # CLASS receiver reaches the nested leg rather than the atom one.
    baseNid: interpPartNodeId n: (ast.nodes.get i: n.parent)
    nlid: stampIdOf :typing nid: baseNid
    nlid = typedefMethodOwner :reg :typing :ctx tid: nlid :mnId
    # a Map/Set-typed base is a heap pointer regardless of how it was
    # reached (a field path fails pathIsPointer's lock-field test)
    nbPar: ast.nodes.get i: n.parent
    nbPtr: pathIsPointer :ast :reg :typing :ctx n: nbPar
    nstPtr: nbPtr
    if nstPtr.not then nstPtr = isHeapPtrCollection :reg :typing :ctx tid: nlid
    # a borrowed field (`c.l` on `l: (ListVal t: i64).borrow`) holds a stack
    # collection by pointer: read through it once, and every leg below sees the
    # container itself. A Map or a Set is its own heap pointer and a borrowed
    # field holds just that (borrowedFieldHeldByPointer)
    if nbPtr when nbPar.dottedpath when (borrowedFieldPath :ast :reg :typing :ctx n: nbPar) when (
        stackCollectionTid
        :reg
        :ctx
        tid: nlid
    ) then {
        baseAtom = "(*\{baseAtom})"
        baseAtomF = operandFacts e: baseAtomF place: true
        baseVid = ztypes.vid
        nstPtr = false
    }
    # a Box's fields and methods are its element's, read through the cell
    nbxE: boxMemberElem :ast :reg :typing :n
    if nbxE.notZero then {
        baseAtom = "(*\{baseAtom})"
        baseAtomF = operandFacts e: baseAtomF place: true
        nlid = nbxE
        baseVid = ztypes.vid
        nstPtr = false
    }
    # a reference-returning base (`getMut` over a compound element) is a pointer
    # into storage the container owns, and a stack collection's legs take the
    # receiver's address: it is bound first -- still running before anything
    # after it -- and read through its deref, as a method call's receiver is
    if (stackCollectionTid :reg :ctx tid: nlid) when (
        nodeIsRefBorrowResult
        :ast
        :reg
        :typing
        :ctx
        n: (ast.nodes.get i: n.parent)
    ) then {
        baseAtom = hoistedBorrowDeref :ast :reg :typing :ctx av: baseAtom.stringView tid: nlid
        baseAtomF = derefFacts
        baseVid = ztypes.vid
        nstPtr = false
    }
    cbt: (
        callBaseTemp
        :ast
        :reg
        :typing
        :ctx
        :nlid
        base: baseAtom.stringView
        baseF: baseAtomF
        :nstPtr
        baseNid: n.parent
    )
    if cbt.length > 0 then {
        baseAtom = cbt.take
        baseAtomF = pathFacts
        baseVid = ztypes.vid
    }
    tnr: tmplNestedRead :ast :reg :typing :ctx :nlid :mnId base: baseAtom.stringView :nstPtr :facts
    if tnr.length > 0 then return tnr
    cnr: classNestedRead :ast :reg :typing :ctx :nlid :mnId base: baseAtom.stringView :nstPtr :facts
    if cnr.length > 0 then return cnr
    return (
        nestedBaseMember
        :ast
        :reg
        :typing
        :ctx
        :n
        :mn2
        :mnId
        :nlid
        base: baseAtom.stringView
        :baseAtomF
        :baseVid
        :nstPtr
        :facts
    )
}

# classNestedRead -- a class's native method read off a nested or computed
# base (`(files.getMut i: k).close`) that a fragment row implements: the row's
# call, taking the place the base names (emitClassNativeRead); "" for any other
# member
classNestedRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nlid: ztypes.tid
    mnId: zast.nameid
    base: StringView
    # the base is a pointer to the place
    nstPtr: bool
    facts: cfacts.borrow
} out String is {
    mo: typing.declChildOfId parentTypeId: nlid nameId: mnId
    match (
        mo
    ) case some then {
        if (reg.isNativeOf tid: mo).not then return "".string
        tb: base.string
        if nstPtr then tb = "(*\{base})"
        return (
            emitClassNativeRead
            :ast
            :reg
            :typing
            :ctx
            cid: nlid
            :mnId
            mfid: mo
            recv: tb.stringView
            recvVid: ztypes.vid
            :facts
        )
    } case none then return "".string
}

# tmplNestedRead -- a templated class's native method read off a nested base
# (`this.m.lock`): its template's function, taking the place the base names;
# "" for any other member
tmplNestedRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nlid: ztypes.tid
    mnId: zast.nameid
    base: StringView
    # the base is a pointer to the place
    nstPtr: bool
    facts: cfacts.borrow
} out String is {
    if (tmplClassRowOf :reg :ctx tid: nlid) == 0 then return "".string
    tb: base.string
    if nstPtr then tb = "(*\{base})"
    return (
        tmplInstMemberRead
        :ast
        :reg
        :typing
        :ctx
        inst: nlid
        :mnId
        bn2: tb.stringView
        bn2v: ztypes.vid
        :facts
    )
}

# nestedBaseMember -- member `mnId` read off a nested read's base `base`, of type
# `nlid` (a pointer when `nstPtr`): a collection's or a mono's method, a sum's
# method, else the field, with its facts; "" when the owner has none.
nestedBaseMember: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    mn2: StringView
    mnId: zast.nameid
    nlid: ztypes.tid
    base: StringView
    baseAtomF: cfacts
    baseVid: ztypes.vid
    nstPtr: bool
    facts: cfacts.borrow
} out String is {
    eCo: (
        emitNestedCollectionBase
        :ast
        :reg
        :typing
        :ctx
        :mn2
        :mnId
        :nlid
        baseAtom: base
        :baseAtomF
        baseNid: n.parent
        :baseVid
        recvIsPtr: nstPtr
        :facts
    )
    if eCo.length > 0 then return eCo
    eMo: (
        emitNestedMonoMethodBase
        :ast
        :reg
        :typing
        :ctx
        :n
        :mn2
        :mnId
        :nlid
        baseAtom: base
        :baseAtomF
        :baseVid
        :facts
    )
    if eMo.length > 0 then return eMo
    if (reg.typetypeOf typeId: nlid).isSum then {
        eSmN: (
            sumMemberMethodRead
            :ast
            :reg
            :typing
            :ctx
            baseNid: n.parent
            :mn2
            :mnId
            bn2: base
            bn2F: baseAtomF
            bn2v: baseVid
            bstamp: nlid
            :facts
        )
        if eSmN.length > 0 then return eSmN
    }
    if (memberOrdinal :reg :typing :ctx owner: nlid kind: memberkind.field nameId: mnId
    ).none then return "".string
    mnNbC: memberC :ast :reg :typing :ctx owner: nlid kind: memberkind.field nameId: mnId
    acc: "."
    if nstPtr then acc = "->"
    return (stating :facts from: (memberFacts b: baseAtomF) text: "\{base}\{acc}\{mnNbC}")
}

# protocolProjectionRead -- a borrowed implementation projection: f.myreader ->
# {Impl}_{label}_create(&f) (a borrowed fat pointer; for a facet, the copy its
# one create makes). Only an as-block implementation LABEL materializes; a stored
# protocol or facet field (p: SomeProto) is a by-value value accessed directly,
# so the read is gated on the implementation row. Empty when the member is not the
# label.
protocolProjectionRead: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    mn2: StringView
    bn2: StringView
    bn2v: ztypes.vid
    bstamp: ztypes.tid
    # the protocol
    mco: ztypes.tid
} out String is {
    clab: boxLabelFor :reg :typing :ctx implTid: bstamp protoTid: mco
    if (clab.stringView == mn2).not then return String
    noteBorrowBoxUse :ctx implTid: bstamp protoTid: mco
    ib: ctxCnameView :ctx tid: bstamp
    # a data value is already the pointer the create takes (isStaticHandle)
    if (
        (isPtrVid :ctx vid: bn2v) or (isStaticHandle :reg :typing tid: bstamp)
    ) then return "\{ib}_\{mn2}_create(\{bn2})"
    return "\{ib}_\{mn2}_create(&\{bn2})"
}

# typeNameCreateZero -- `Type.create` off a native scalar or String type name:
# the zero value is the construction (those creates have no C symbol). Empty
# for every other type.
typeNameCreateZero: function {
    typing: ztyping.ZTyping.view
    ctx: Ctx
    bstamp: ztypes.tid
    facts: cfacts.borrow
} out String is {
    zsc: scalarCTypeFor :typing tid: bstamp
    if zsc.length > 0 then return (scalarZeroC :typing cType: zsc.stringView tid: bstamp :facts)
    if bstamp == ctx.strTid then {
        strT: strTypeC :ctx
        return (stating :facts from: literalFacts text: "((\{strT}){0})")
    }
    return String
}

# autoCallCname -- the C name a no-argument method read calls. An iterator's
# `call` is spelled as the loop that drives it spells it (objIterCallC): a
# native one is its template's `{type}_call`, the only C that defines it.
# Every other method is its own cname.
autoCallCname: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the type the method was found on
    owner: ztypes.tid
    method: ztypes.tid
} out String is {
    oc: (
        (typing.declChildOfId parentTypeId: owner nameId: zast.wellKnown.slot.wkCall).or
        d: ztypes.tid.zero
    )
    if oc == method then return (objIterCallC :reg :ctx cco: method itid: owner)
    noteFnUse :ctx tid: method
    return (ctxCname :ctx tid: method)
}

# methodAutoCallRead -- a member read that auto-calls a method. A no-arg SV
# native (count/hash/codepoints/lines) has no per-method C symbol and emits
# the canonical native over the projected view. `Type.create` off the type
# name is a constructor/static call with no receiver. A RECEIVER-TAKING
# METHOD READ OFF THE TYPE NAME IS A REFERENCE, and there is nothing else it
# can be: calling it needs a receiver this leg has not got, and the call form
# (`T.f self: t rhs: 2`) never arrives here -- so `point.add.take` is the bare
# cname, the unbound function pointer, whose `_ft` typedef already pointerizes
# the receiver; a true zero-arg static declares no receiver and keeps its
# call. Static-or-not is decided by the base being the TYPE NAME with no vid,
# never by the text alone (--readable-names keeps source names). Otherwise a
# receiver-taking method takes its receiver by pointer in both families.
methodAutoCallRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    baseNid: zast.nodeid
    mnId: zast.nameid
    bn2: StringView
    bn2F: cfacts
    bn2v: ztypes.vid
    bstamp: ztypes.tid
    # the method
    mco: ztypes.tid
    # the base names the TYPE itself (the checker said so), not a value of it
    baseIsType: bool
    # the read names the method itself, a `.take` of it, rather than its call
    readIsRef: bool
    facts: cfacts.borrow
} out String is {
    viewNative: (
        (isStringyTid :ctx tid: bstamp) or (viewLaidNative :reg :typing :ctx tid: bstamp :mnId)
    )
    if (svCallOf :reg :typing :ctx nameId: mnId).noarg when viewNative then {
        demandSvMember :reg :typing :ctx nameId: mnId
        svfaF: bn2F
        svfa: (
            svValueForm
            :ast
            :reg
            :typing
            :ctx
            expr: bn2
            isStr: bstamp == ctx.strTid
            vid: bn2v
            facts: svfaF
        )
        mn: zast.nameTextAt :ast ref: mnId
        return (stating :facts from: callFacts text: "\{ctx.svC}_\{mn}(&\{svfa})")
    }
    mt: mco
    mc2: autoCallCname :reg :typing :ctx owner: bstamp method: mt
    if baseIsType when mnId == zast.wellKnown.slot.wkCreate then {
        z: typeNameCreateZero :typing :ctx :bstamp :facts
        if z.length > 0 then return z
    }
    if baseIsType then {
        if readIsRef or (fnTypeTakesThis :reg :typing tid: mt) then return (
            stating
            :facts
            from: pathFacts
            text: mc2
        )
        sda: renderedMethodDefaultArgs :ast :reg :typing :ctx fnTid: mt
        if sda.length > 0 then return (stating :facts from: callFacts text: "\{mc2}(\{sda})")
        return (stating :facts from: callFacts text: "\{mc2}()")
    }
    methodRecv: "\{bn2}"
    if (calleeTakesReceiverByPtr :ast :reg :typing fid: mt) when (
        argAlreadyPointer
        :ast
        :reg
        :typing
        :ctx
        n: (ast.nodes.get i: baseNid)
        vid: bn2v
    ).not then {
        # a base that is not an lvalue -- an arm constant (`Dir.up`), a call's
        # result -- has no address: it is hoisted into the `_ah` temp an
        # argument gets, and a name still emits as `&name`
        mrF: cfacts
        methodRecv = (
            emitByrefArgWith
            :ast
            :reg
            :typing
            :ctx
            av: bn2
            avF: bn2F
            pid: bstamp
            argNid: baseNid
            facts: mrF
        )
    }
    ida: renderedMethodDefaultArgs :ast :reg :typing :ctx fnTid: mt
    if ida.length > 0 then return (
        stating
        :facts
        from: callFacts
        text: "\{mc2}(\{methodRecv}, \{ida})"
    )
    return (stating :facts from: callFacts text: "\{mc2}(\{methodRecv})")
}

# fnptrFieldRead -- a read of a function-pointer field: off the type name it
# is the field's function itself; otherwise the read is a CALL through the
# field -- with the base as its receiver when the field declares one -- unless
# the checker stamped the read as the field's function (`.take` of it), which
# is the field itself.
fnptrFieldRead: function {
    # the field names
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    mnId: zast.nameid
    bn2: StringView
    bn2v: ztypes.vid
    # the record or class the field is read off
    bstamp: ztypes.tid
    mco: ztypes.tid
    baseIsType: bool
    # the checker stamped this read as the field's function, so it is not called
    readIsRef: bool
    facts: cfacts.borrow
} out String is {
    mcFp: spelledCname :ctx tid: mco
    if baseIsType then return (stating :facts from: pathFacts text: mcFp)
    takesThis: fnTypeTakesThis :reg :typing tid: mco
    if readIsRef when takesThis.not then return String
    accFp: ".".string
    rcvFp: "&\{bn2}"
    # a data value is a handle, whether a variable holds it or it folded
    if (isPtrVid :ctx vid: bn2v) or (isStaticHandle :reg :typing tid: bstamp) then {
        accFp = "->".string
        rcvFp = "\{bn2}"
    }
    if takesThis.not then rcvFp = "".string
    return (stating :facts from: callFacts text: (
        fnptrSlotCallC
        :ast
        :reg
        :typing
        :ctx
        owner: bstamp
        base: bn2
        acc: accFp.stringView
        :mnId
        recv: rcvFp.stringView
    )
    )
}

# fnptrSlotCallC -- the C call through a function field: the field of `base`
# called with its receiver `recv`, or with no argument when `recv` is empty.
fnptrSlotCallC: function {
    # the field names
    ast: Ast.view
    # the checked program
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the emission context the field is spelled through
    ctx: Ctx
    # the record or class that declares the field
    owner: ztypes.tid
    # the instance the field is read from
    base: StringView
    # `.` or `->`, as the base is a value or a pointer
    acc: StringView
    # the field's name
    mnId: zast.nameid
    # the receiver argument, empty for a field that takes none
    recv: StringView
} out String is {
    fc: memberC :ast :reg :typing :ctx :owner kind: memberkind.field nameId: mnId
    return "\{base}\{acc}\{fc}(\{recv})"
}

# staticListValueMemberRead -- `length` and `iterate` read off a list value: the view's
# own length, and the mono's walk over it. A block's name as the base is its
# value, the view of its array. "" for any other read.
staticListValueMemberRead: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    baseNid: zast.nodeid
    mnId: zast.nameid
    bn2: StringView
    bn2F: cfacts
    bn2v: ztypes.vid
    bstamp: ztypes.tid
    facts: cfacts.borrow
} out String is {
    if (staticListValueFamilyOf :reg :ctx tid: bstamp).isZero then return "".string
    isLen: mnId == zast.wellKnown.slot.wkLength
    if isLen.not when mnId != zast.wellKnown.slot.wkIterate then return "".string
    base: staticListValueText :typing :ctx nid: baseNid
    baseF: literalFacts
    if base.length == 0 then {
        base = bn2.string
        baseF = bn2F
    }
    acc: "."
    if (isPtrVid :ctx vid: bn2v) then acc = "->"
    if isLen then return (stating :facts from: (memberFacts b: baseF) text: "\{base}\{acc}length")
    dvc: spelledCname :ctx tid: bstamp
    if (isPtrVid :ctx vid: bn2v) then return (
        stating
        :facts
        from: callFacts
        text: "\{dvc}_iterate(\{base})"
    )
    noteMemberUse :ctx mono: bstamp member: memberWord.slot.iterateAll
    return (stating :facts from: callFacts text: "\{dvc}_iterate(&\{base})")
}

# emitResolvedMemberRead -- the member resolved on the receiver's type: a protocol
# implementation field, an fn-pointer field, a plain field, or a no-arg method that
# auto-calls. The receiver goes by address or by value as its variable dictates.
emitResolvedMemberRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    baseNid: zast.nodeid
    mn2: StringView
    mnId: zast.nameid
    bn2: StringView
    bn2F: cfacts
    bn2v: ztypes.vid
    bstamp: ztypes.tid
    mco: ztypes.tid
    baseIsType: bool
    # the read is the member's own function (a `.take` of it), not a call
    readIsRef: bool
    facts: cfacts.borrow
} out String is {
    dvr: staticListValueMemberRead :reg :typing :ctx :baseNid :mnId :bn2 :bn2F :bn2v :bstamp :facts
    if dvr.length > 0 then return dvr
    mtt: reg.typetypeOf typeId: mco
    if mtt.isInterface then {
        pj: protocolProjectionRead :reg :typing :ctx :mn2 :bn2 :bn2v :bstamp :mco
        if pj.length > 0 then return (stating :facts from: callFacts text: pj)
    }
    if (mtt == ztypes.ztypetype.functionType).not then return "".string
    if (typing.declIsFnptrFieldId parentTypeId: bstamp nameId: mnId) then {
        return (
            fnptrFieldRead
            :ast
            :reg
            :typing
            :ctx
            :mnId
            :bn2
            :bn2v
            :bstamp
            :mco
            :baseIsType
            :readIsRef
            :facts
        )
    }
    sh: synthHashRead :ast :reg :typing :ctx :bn2 :bn2v :bstamp :mco :baseIsType :readIsRef :facts
    if sh.length > 0 then return sh
    return (
        methodAutoCallRead
        :ast
        :reg
        :typing
        :ctx
        :baseNid
        :mnId
        :bn2
        :bn2F
        :bn2v
        :bstamp
        :mco
        :baseIsType
        :readIsRef
        :facts
    )
}

# synthHashRead -- a read of a generated `hash` off a value: its type's hash of
# the VALUE, since a literal receiver has no address to hand a method. "" for
# any other read.
synthHashRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    bn2: StringView
    bn2v: ztypes.vid
    bstamp: ztypes.tid
    mco: ztypes.tid
    baseIsType: bool
    readIsRef: bool
    facts: cfacts.borrow
} out String is {
    if readIsRef then return String
    if baseIsType then return String
    if (synthHashOf :typing owner: bstamp :mco).not then return String
    hv: "(\{bn2})"
    if (isPtrVid :ctx vid: bn2v) then hv = "(*\{bn2})"
    return (
        stating
        :facts
        from: callFacts
        text: (hashExprC :ast :reg :typing :ctx tid: bstamp v: hv.stringView)
    )
}

# sumMemberMethodRead -- a sum type's dotted read where the member is a declared
# METHOD or implementation label rather than an arm. An arm and a method can never
# share a name (E0003 rejects it), so the DECLARATION answers which one a bare
# read is; the payload read below applies only when it answers nothing, or
# names something with no body to read. The declared arms are children too,
# hence the FUNCTION test.
# The base is read as a value (baseIsType: false): a base that names the TYPE is
# answered by the earlier legs, which read the checker's stamps.
sumMemberMethodRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    baseNid: zast.nodeid
    mn2: StringView
    mnId: zast.nameid
    bn2: StringView
    bn2F: cfacts
    bn2v: ztypes.vid
    bstamp: ztypes.tid
    facts: cfacts.borrow
} out String is {
    mco: typing.declChildOfId parentTypeId: bstamp nameId: mnId
    if mco.some then {
        # an implementation label reads as its projection; emitResolvedMemberRead
        # answers only for the label, so an arm holding a spec value stays one
        mtt: reg.typetypeOf typeId: mco
        if (
            (mtt == ztypes.ztypetype.functionType) or
            (mtt == ztypes.ztypetype.protocolType) or
            (mtt == ztypes.ztypetype.facetType)
        ).not then return "".string
        return (
            emitResolvedMemberRead
            :ast
            :reg
            :typing
            :ctx
            :baseNid
            :mn2
            :mnId
            :bn2
            :bn2F
            :bn2v
            :bstamp
            :mco
            baseIsType: false
            readIsRef: false
            :facts
        )
    }
    return "".string
}

# emitUserTypeMemberRead -- a field or no-arg method read on a user record or
# class receiver: the field access itself, an auto-called no-arg method, and the
# defaults a method's unwritten parameters carry.
emitUserTypeMemberRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    baseNid: zast.nodeid
    mn2: StringView
    mnId: zast.nameid
    bn2: StringView
    bn2F: cfacts
    bn2v: ztypes.vid
    bstamp: ztypes.tid
    # handed to emitResolvedMemberRead: the read names the function, not its call
    readIsRef: bool
    facts: cfacts.borrow
} out String is {
    baseIsType: false
    if bn2v.isZero when (typing.dpTypeBase.has item: baseNid) then baseIsType = true
    if bstamp == ctx.strTid then {
        sptr: isPtrVid :ctx vid: bn2v
        sm: (
            emitStringMethod
            :ast
            :reg
            :typing
            :ctx
            recv: bn2
            recvF: bn2F
            recvIsPtr: sptr
            :mnId
            recvVid: bn2v
            :facts
        )
        if sm.length > 0 then return sm
    }
    mco: typing.declChildOfId parentTypeId: bstamp nameId: mnId
    if mco.some then {
        # a native method taking only its receiver, read as a member: the
        # member's OWN DECLARATION decides, since a native member has no body to
        # emit, and its fragment row is the call (emitClassNativeRead)
        if (reg.isNativeOf tid: mco) then {
            nr: (
                emitClassNativeRead
                :ast
                :reg
                :typing
                :ctx
                cid: bstamp
                :mnId
                mfid: mco
                recv: bn2
                recvVid: bn2v
                :facts
            )
            if nr.length > 0 then return nr
        }
        rmr: (
            emitResolvedMemberRead
            :ast
            :reg
            :typing
            :ctx
            :baseNid
            :mn2
            :mnId
            :bn2
            :bn2F
            :bn2v
            :bstamp
            :mco
            :baseIsType
            :readIsRef
            :facts
        )
        if rmr.length > 0 then return rmr
    }
    # a unit's member (a list, a constant) is no field of a struct
    if (memberOrdinal :reg :typing :ctx owner: bstamp kind: memberkind.field nameId: mnId
    ).none then return "".string
    mnUtC: memberC :ast :reg :typing :ctx owner: bstamp kind: memberkind.field nameId: mnId
    # a data value is a handle whatever spells it: a variable, or a narrowed
    # sum's payload read in place
    if (isPtrVid :ctx vid: bn2v) or (isStaticHandle :reg :typing tid: bstamp) then {
        return (stating :facts from: (memberFacts b: bn2F) text: "\{bn2}->\{mnUtC}")
    }
    return (stating :facts from: (memberFacts b: bn2F) text: "\{bn2}.\{mnUtC}")
}

# emitIdCollectionMemberRead -- a counter or no-arg method on the id-keyed pair,
# on a Set or Map, or on a map ENTRY. A Set/Map is a heap pointer and reads
# through `->`; the id-keyed pair and the entries are stack structs and read
# through `acc`, exactly as a List does.
emitIdCollectionMemberRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    mnId: zast.nameid
    bn2: StringView
    bn2F: cfacts
    bstamp: ztypes.tid
    acc: StringView
    recv: StringView
    facts: cfacts.borrow
} out String is {
    if (isIdCollectionOriginOf :reg :ctx tid: bstamp) then {
        if mnId == zast.wellKnown.slot.wkLength then {
            return (stating :facts from: (memberFacts b: bn2F) text: "\{bn2}\{acc}length")
        }
        if mnId == zast.wellKnown.slot.wkCapacity then {
            return (stating :facts from: (memberFacts b: bn2F) text: "\{bn2}\{acc}capacity")
        }
        if mnId == zast.wellKnown.slot.wkIterate then {
            idcb: spelledCname :ctx tid: bstamp
            noteMemberUse :ctx mono: bstamp member: memberWord.slot.iterateAll
            return (stating :facts from: callFacts text: "\{idcb}_iterate(\{recv})")
        }
        if mnId == zast.wellKnown.slot.wkIterateItems then {
            idBaseC: spelledCname :ctx tid: bstamp
            noteMemberUse :ctx mono: bstamp member: memberWord.slot.iterateItems
            return (stating :facts from: callFacts text: "\{idBaseC}_iterateItems(\{recv})")
        }
    }
    if (isSetOriginOf :reg :ctx tid: bstamp) then {
        if mnId == zast.wellKnown.slot.wkLength then {
            return (stating :facts from: (memberFacts b: bn2F) text: "\{bn2}->length")
        }
        if mnId == zast.wellKnown.slot.wkCapacity then {
            return (stating :facts from: (memberFacts b: bn2F) text: "\{bn2}->capacity")
        }
        setBaseC: spelledCname :ctx tid: bstamp
        if mnId == zast.wellKnown.slot.wkIterate then {
            noteMemberUse :ctx mono: bstamp member: memberWord.slot.iterateAll
            return (stating :facts from: callFacts text: "\{setBaseC}_iterate(\{bn2})")
        }
    }
    if (isMapOriginOf :reg :ctx tid: bstamp) then {
        if mnId == zast.wellKnown.slot.wkLength then {
            return (stating :facts from: (memberFacts b: bn2F) text: "\{bn2}->length")
        }
        if mnId == zast.wellKnown.slot.wkCapacity then {
            return (stating :facts from: (memberFacts b: bn2F) text: "\{bn2}->capacity")
        }
        mapBaseC: spelledCname :ctx tid: bstamp
        if mnId == zast.wellKnown.slot.wkIterate then {
            noteMemberUse :ctx mono: bstamp member: memberWord.slot.iterateAll
            return (stating :facts from: callFacts text: "\{mapBaseC}_iterate(\{bn2})")
        }
        if mnId == zast.wellKnown.slot.wkIterateItems then {
            noteMemberUse :ctx mono: bstamp member: memberWord.slot.iterateItems
            return (stating :facts from: callFacts text: "\{mapBaseC}_iterateItems(\{bn2})")
        }
    }
    isAnyEntry: isMapEntryOriginOf :reg :ctx tid: bstamp
    if (isIdMapEntryOriginOf :reg :ctx tid: bstamp) then isAnyEntry = true
    if isAnyEntry then {
        # a borrowed entry yielded by iterateItems: key/value project
        # the entry struct's fields. The loop var binds a deref alias
        # (`(*__borrow_e)`, a value), so access uses `.`; a genuine
        # entry pointer base keeps `->`.
        entryAcc: ".".string
        dpt: ast.nodes.get i: n.parent
        if (pathIsPointer :ast :reg :typing :ctx n: dpt) then entryAcc = "->".string
        if mnId == zast.wellKnown.slot.wkKey then {
            return (stating :facts from: (memberFacts b: bn2F) text: "\{bn2}\{entryAcc}key")
        }
        if mnId == zast.wellKnown.slot.wkValue then {
            return (stating :facts from: (memberFacts b: bn2F) text: "\{bn2}\{entryAcc}value")
        }
    }
    lrow: listRowOf :typing nid: (atomNodeId n: (ast.nodes.get i: n.parent))
    if lrow != 0 then {
        dres: emitStaticListMember :ast :reg :typing :ctx :n row: lrow :mnId :facts
        if dres.length > 0 then return dres
    }
    return "".string
}

# windowMemberRead -- a no-argument member that lends a window or a view -- a
# list's or an array's `span`, an array's or a window's `listView` -- written
# as the window's {length, data}, and a window's `length` and `clear`. `base`
# is the receiver as a value, a pointer when `recvIsPtr`, held by `vid`. ""
# when `mnId` is none of those on `tid`.
windowMemberRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    mnId: zast.nameid
    tid: ztypes.tid
    base: StringView
    baseF: cfacts
    baseNid: zast.nodeid
    recvIsPtr: bool
    vid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    fam: monoFamilyOf :reg :ctx :tid
    isArr: fam == family.slot.fixedArray
    isSpan: fam == family.slot.spanVal
    if (isArr or isSpan or (fam == family.slot.listVal)).not then return "".string
    acc: "."
    if recvIsPtr then acc = "->"
    if isSpan when mnId == zast.wellKnown.slot.wkLength then return (
        stating
        :facts
        from: (memberFacts b: baseF)
        text: "\{base}\{acc}length"
    )
    if isSpan when mnId == zast.wellKnown.slot.wkClear then {
        sc: spelledCname :ctx :tid
        rr: colRecvRef :ctx bn: base :vid
        noteMemberUse :ctx mono: tid member: memberWord.slot.clear
        return (stating :facts from: callFacts text: "\{sc}_clear(\{rr})")
    }
    lendsView: isArr or isSpan and (mnId == zast.wellKnown.slot.wkListView)
    lendsWindow: (
        isArr or (fam == family.slot.listVal) and (mnId == zast.wellKnown.slot.wkSpan)
    )
    if (lendsView or lendsWindow).not then return "".string
    co: typing.declChildOfId parentTypeId: tid nameId: mnId
    rt: ztypes.tid.zero
    if co.some then {
        rt = fnReturnTidOf :reg tid: co
    }
    if rt.isZero then return "".string
    wc: spelledCname :ctx tid: rt
    rc: spelledCname :ctx :tid
    # the length and the data both read the base: bound first when that repeats
    # work
    bound: String
    if isArr.not when baseF.once then bound = (
        readOnce
        :ast
        :reg
        :typing
        :ctx
        text: base
        textF: baseF
        :tid
        nid: baseNid
    )
    wb: base
    if bound.length > 0 then wb = bound.stringView
    len: "\{wb}\{acc}length"
    if isArr then {
        noteMemberUse :ctx mono: tid member: memberWord.slot.lengthOf
        len = "\{rc}_length"
    }
    # an array's storage is inline, const through a view receiver: the window
    # takes it without the qualifier, as emitWindowSlice says
    if isArr then return (
        stating
        :facts
        from: literalFacts
        text: "((\{wc}_t){ .length = \{len}, .data = (void*)\{wb}\{acc}data })"
    )
    return (
        stating
        :facts
        from: literalFacts
        text: "((\{wc}_t){ .length = \{len}, .data = \{wb}\{acc}data })"
    )
}

# emitCollectionMemberRead -- a counter or no-arg method on a builtin collection
# receiver, keyed on the template the receiver's mono came from. The id-keyed
# pair are STACK structs, so their counters are read through `.` or `->` exactly
# as a List's are, not through the unconditional `->` a heap Map uses.
emitCollectionMemberRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    mn2: StringView
    mnId: zast.nameid
    bn2: StringView
    bn2F: cfacts
    bn2v: ztypes.vid
    bstamp: ztypes.tid
    facts: cfacts.borrow
} out String is {
    acc: ".".string
    if (isPtrVid :ctx vid: bn2v) then acc = "->".string
    recv: colRecvRef :ctx bn: bn2 vid: bn2v
    # `.copy` is declared on the five ALL-VALTYPE containers only, so each
    # family is named precisely here rather than through the ref/val-conflating
    # predicates the legs below use: a checker regression then surfaces as a
    # missing leg, never as a wrong emission on a reference family whose
    # elements would get two owners.
    #
    # THE RECEIVER IS SPELLED TWO WAYS because the families are held two ways.
    # A dict is heap-held and its local already IS the pointer the body wants;
    # a list or an id container is a stack struct, so the local's ADDRESS is.
    wmr: (
        windowMemberRead
        :ast
        :reg
        :typing
        :ctx
        :mnId
        tid: bstamp
        base: bn2
        baseF: bn2F
        baseNid: n.parent
        recvIsPtr: (isPtrVid :ctx vid: bn2v)
        vid: bn2v
        :facts
    )
    if wmr.length > 0 then return wmr
    if mnId == zast.wellKnown.slot.wkCopy then {
        copyFamily: copyFamilyOf :reg :ctx tid: bstamp
        if copyFamily > 0 then return (
            containerCopyText
            :ctx
            tid: bstamp
            fam: copyFamily
            stackRecv: recv.stringView
            heapRecv: bn2
            :facts
        )
    }
    if (originIsTid :reg tid: bstamp originTid: (ctx.origins.get i: family.slot.fixedArray)) then {
        acba: spelledCname :ctx tid: bstamp
        if mnId == zast.wellKnown.slot.wkLength then {
            noteMemberUse :ctx mono: bstamp member: memberWord.slot.lengthOf
            return (stating :facts from: constFacts text: "\{acba}_length")
        }
        if (allDigits s: mn2) then {
            return (
                stating
                :facts
                from: (operandFacts e: bn2F place: true)
                text: "\{bn2}\{acc}data[\{mn2}]"
            )
        }
    }
    if (originIsTid :reg tid: bstamp originTid: (ctx.origins.get i: family.slot.str)) then {
        scba: spelledCname :ctx tid: bstamp
        if mnId == zast.wellKnown.slot.wkLength then {
            return (stating :facts from: (memberFacts b: bn2F) text: "\{bn2}\{acc}len")
        }
        if mnId == zast.wellKnown.slot.wkSize then {
            noteMemberUse :ctx mono: bstamp member: memberWord.slot.size
            return (stating :facts from: constFacts text: "\{scba}_size")
        }
        if mnId == zast.wellKnown.slot.wkString then {
            noteMemberUse :ctx mono: bstamp member: memberWord.slot.string
            return (stating :facts from: callFacts text: "\{scba}_string(\{bn2})")
        }
        if (ztypecheck.isStringViewMember nameId: mnId) then {
            svT: svTypeC :ctx
            return (
                stating
                :facts
                from: literalFacts
                text: "(\{svT}){ .data = \{bn2}\{acc}data, .size = \{bn2}\{acc}len }"
            )
        }
    }
    # a List and a window into one answer these the same way: the window IS
    # the first two fields of the list struct, and the cursor holds the window
    # either way, so one leg says so once for both
    isListy: (isListOriginOf :reg :ctx tid: bstamp) or (isListViewOriginOf :reg :ctx tid: bstamp)
    if isListy then {
        if mnId == zast.wellKnown.slot.wkLength then {
            return (stating :facts from: (memberFacts b: bn2F) text: "\{bn2}\{acc}length")
        }
        if (isListReadWalkMember name: mn2) then {
            monoC: spelledCname :ctx tid: bstamp
            noteMemberUse :ctx mono: bstamp member: (ctx.memberWords.slotOf text: mn2)
            w8: "_\{mn2}("
            return (stating :facts from: callFacts text: "\{monoC}\{w8}\{recv})")
        }
    }
    if (isListOriginOf :reg :ctx tid: bstamp) then {
        if mnId == zast.wellKnown.slot.wkCapacity then {
            return (stating :facts from: (memberFacts b: bn2F) text: "\{bn2}\{acc}capacity")
        }
        baseC: spelledCname :ctx tid: bstamp
        if mnId == zast.wellKnown.slot.wkPop then {
            noteMemberUse :ctx mono: bstamp member: memberWord.slot.pop
            return (stating :facts from: callFacts text: "\{baseC}_pop(\{recv})")
        }
        if mnId == zast.wellKnown.slot.wkSort then {
            noteMemberUse :ctx mono: bstamp member: memberWord.slot.sort
            return (stating :facts from: callFacts text: "\{baseC}_sort(\{recv})")
        }
        if (ztypecheck.isListViewMember nameId: mnId) then {
            noteMemberUse :ctx mono: bstamp member: memberWord.slot.listView
            return (stating :facts from: callFacts text: "\{baseC}_listView(\{recv})")
        }
        if mnId == zast.wellKnown.slot.wkIterateMut then {
            noteMemberUse :ctx mono: bstamp member: memberWord.slot.iterateMut
            return (stating :facts from: callFacts text: "\{baseC}_iterateMut(\{recv})")
        }
    }
    # the id-keyed pair are STACK structs, so their counters are read
    # through `acc` (`.` or `->`) exactly as a List's are, not through
    # the unconditional `->` a heap Map uses
    icm: (
        emitIdCollectionMemberRead
        :ast
        :reg
        :typing
        :ctx
        :n
        :mnId
        :bn2
        :bn2F
        :bstamp
        acc: acc.stringView
        recv: recv.stringView
        :facts
    )
    if icm.length > 0 then return icm
    return "".string
}

# dottedAtomNumericBase -- `3.u64`: a typed numeric literal, whose "member" is
# the suffix and whose base text is the C literal. `0cA` is decoded first --
# the 0c lexeme is not a C token.
dottedAtomNumericBase: function {
    bn2: StringView
    mn2: StringView
    ctx: Ctx
} out String is {
    b1: bn2.byteAt i: 0
    if b1.some when b1 >= 48 when b1 <= 57 then {
        # A LITERAL SUFFIX NAMES A BUILTIN SCALAR, always: it is a
        # conversion the literal type declares, and the literal types
        # declare only the sixteen. Chasing a scalar typedef to its base
        # as well would make `1.nameid` mean "u32". The suffix is the
        # literal's own text, read as the lexer reads one (numkindByName).
        nk3: ztypes.numkindByName name: mn2
        wl3: wideLiteralOf :ctx lex: bn2 k: nk3
        if wl3.length > 0 then return wl3
        if nk3.has then {
            bc1: bn2.string
            # `0cA.u8`: the 0c lexeme is not a C token; decode
            if bn2.startsWith "0c" then {
                pn1: ztypes.parseNumber numstr: bn2
                if pn1.err.length == 0 then bc1 = "\{pn1.ival}"
            }
            bc1.append (kindLitSuffix k: nk3.kind)
            return bc1
        }
    }
    return "".string
}

# dottedTypeConstRead -- `Type.CONST` or `unit.Type.CONST` naming one of the
# type's `as` constants: the read is the constant's value. An integer, a string
# or an arm is already the node's own folded value; a float is rendered here,
# from the member's declared type, which a folded value cannot say.
dottedTypeConstRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    facts: cfacts.borrow
} out String is {
    bt: stampIdOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: n.parent))
    if bt.isZero then return "".string
    cid: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
    # a list's `slot.label` is the label's position, a constant of the
    # list's index type
    if bt == typing.listSlotTid then return (
        emitListSlotRead
        :ast
        :reg
        :typing
        :ctx
        :n
        mnId: cid
        :facts
    )
    if (
        typing.isAsConstDecl
        declId: (typing.declMemberIdOf parentTypeId: bt nameId: cid)
    ).not then return "".string
    ct: memberConstText :ast :reg :typing :ctx unitTid: bt nameId: cid :facts
    if ct.length > 0 then return ct
    return (memberConstStringText :typing :ctx unitTid: bt nameId: cid :facts)
}

# emitSvAtomBase -- a StringView base: `.length`, the pointer/one-past ends, the
# parse members, and the simple view natives, each a direct field or call on the
# view value rather than a dispatch.
emitSvAtomBase: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    bn2: StringView
    bn2F: cfacts
    mn2: StringView
    mnId: zast.nameid
    bn2v: ztypes.vid
    bareSv: bool
    facts: cfacts.borrow
} out String is {
    if bareSv then {
        if mnId == zast.wellKnown.slot.wkLength then {
            return (stating :facts from: (memberFacts b: bn2F) text: "\{bn2}.size")
        }
        if mnId == zast.wellKnown.slot.wkAsString then {
            # the cast IS the emission: {size, data} is a prefix of
            # String, so the view's address is a readonly String
            accA: "&".string
            if (isPtrVid :ctx vid: bn2v) then accA = "".string
            avsF: operandFacts e: bn2F place: false
            if accA.length > 0 then avsF = addrFacts e: bn2F
            strT: strTypeC :ctx
            cast: "(const \{strT}*)"
            return (stating :facts from: avsF text: "(\{cast}\{accA}\{bn2})")
        }
        if mnId == zast.wellKnown.slot.wkCount then {
            demandSvMember :reg :typing :ctx nameId: zast.wellKnown.slot.wkCount
            return (stating :facts from: callFacts text: "\{ctx.svC}_count(&\{bn2})")
        }
        if mnId == zast.wellKnown.slot.wkCodepoints then {
            demandSvMember :reg :typing :ctx nameId: zast.wellKnown.slot.wkCodepoints
            return (stating :facts from: callFacts text: "\{ctx.svC}_codepoints(&\{bn2})")
        }
        if mnId == zast.wellKnown.slot.wkParseI64 then {
            demandSvMember :reg :typing :ctx nameId: zast.wellKnown.slot.wkParseI64
            return (stating :facts from: callFacts text: "\{ctx.svC}_parseI64(&\{bn2})")
        }
        if mnId == zast.wellKnown.slot.wkParseU64 then {
            demandSvMember :reg :typing :ctx nameId: zast.wellKnown.slot.wkParseU64
            return (stating :facts from: callFacts text: "\{ctx.svC}_parseU64(&\{bn2})")
        }
        if mnId == zast.wellKnown.slot.wkParseF64 then {
            demandSvMember :reg :typing :ctx nameId: zast.wellKnown.slot.wkParseF64
            return (stating :facts from: callFacts text: "\{ctx.svC}_parseF64(&\{bn2})")
        }
        if mnId == zast.wellKnown.slot.wkParseF16 then {
            demandSvMember :reg :typing :ctx nameId: zast.wellKnown.slot.wkParseF16
            return (stating :facts from: callFacts text: "\{ctx.svC}_parseF16(&\{bn2})")
        }
        if mnId == zast.wellKnown.slot.wkParseF128 then {
            demandSvMember :reg :typing :ctx nameId: zast.wellKnown.slot.wkParseF128
            return (stating :facts from: callFacts text: "\{ctx.svC}_parseF128(&\{bn2})")
        }
        if (svCallOf :reg :typing :ctx nameId: mnId).simple then {
            # a no-paren method reference auto-calls
            demandSvMember :reg :typing :ctx nameId: mnId
            return (stating :facts from: callFacts text: "\{ctx.svC}_\{mn2}(&\{bn2})")
        }
        if mnId == zast.wellKnown.slot.wkLines then {
            needsAddM :ctx uname: "sviter" memb: "sv_lines"
            return (stating :facts from: callFacts text: "\{ctx.svC}_lines(&\{bn2})")
        }
    }
    return "".string
}

# dottedAtomRecClsBase -- a user record or class base. Array and str monos are
# RECORD typetype and collection monos are CLASS typetype, but both keep their
# own legs, so both are excluded by origin here.
dottedAtomRecClsBase: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    baseNid: zast.nodeid
    bn2: StringView
    bn2F: cfacts
    mn2: StringView
    mnId: zast.nameid
    bn2v: ztypes.vid
    bstamp: ztypes.tid
    rtt: ztypes.ztypetype
    # handed to emitUserTypeMemberRead: whether the read is a function reference
    readIsRef: bool
    facts: cfacts.borrow
} out String is {
    isRecOrCls: false
    # array/str monos are RECORD typetype but keep their own legs
    # below (a.0 -> a.data[0]; str .length -> .len etc.).
    if rtt == ztypes.ztypetype.recordType when (
        originIsTid
        :reg
        tid: bstamp
        originTid: (ctx.origins.get i: family.slot.fixedArray)
    ).not when (originIsTid :reg tid: bstamp originTid: (ctx.origins.get i: family.slot.str)
    ).not then isRecOrCls = true
    if rtt == ztypes.ztypetype.classType then {
        # user classes only -- collection monos (List/Set/Map, with a
        # generic origin) keep their own dottedpath legs below. An instance
        # of a generic implementer reads its implementation label as a projection.
        baseStampOrigin: originTidOf :reg tid: bstamp
        if baseStampOrigin.isZero then {
            isRecOrCls = true
        } else {
            isRecOrCls = (
                zenv.isImplementationLabelOf
                ty: typing
                :reg
                tid: bstamp
                nameId: mnId
            )
        }
    }
    if isRecOrCls then {
        utm: (
            emitUserTypeMemberRead
            :ast
            :reg
            :typing
            :ctx
            :baseNid
            :mn2
            :mnId
            :bn2
            :bn2F
            :bn2v
            :bstamp
            :readIsRef
            :facts
        )
        if utm.length > 0 then return utm
    }
    return "".string
}

# emitDottedAtomBase -- a read whose base is a bare ATOM with a stamped type: the
# native families (String / StringView / the collections / the id-keyed pair),
# then the user-type field and method legs. A base that is itself a path has no
# stamped atom and goes to emitDottedNestedBase instead.
emitDottedAtomBase: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    mn2: StringView
    mnId: zast.nameid
    bn2: StringView
    bn2F: cfacts
    bn2v: ztypes.vid
    # the base is a Box and the member is its element's: the element's type,
    # read through the dereferenced cell `bn2` already spells
    boxElem: ztypes.tid.zero
    # its facts, where a leg knows them
    facts: cfacts.borrow
} out String is {
    eNum: dottedAtomNumericBase :bn2 :mn2 :ctx
    if eNum.length > 0 then return eNum
    baseNid: interpPartNodeId n: (ast.nodes.get i: n.parent)
    bareTid: chaseStrTypedef :typing :ctx tid: (stampIdOf :typing nid: baseNid)
    bareSv: viewLaidNative :reg :typing :ctx tid: bareTid :mnId
    # `.stringView` of a view is the view: a generic body wrote it for a type
    # parameter a StringView fills
    childNameId: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
    if bareSv when childNameId == zast.wellKnown.slot.wkStringView then {
        return (stating :facts from: bn2F text: bn2.string)
    }
    eSv: emitSvAtomBase :reg :typing :ctx :bn2 :bn2F :mn2 :mnId :bn2v :bareSv :facts
    if eSv.length > 0 then return eSv
    if bareTid == ctx.strTid when mnId == zast.wellKnown.slot.wkLength then {
        acc: ".".string
        if (isPtrVid :ctx vid: bn2v) then acc = "->".string
        return (stating :facts from: (memberFacts b: bn2F) text: "\{bn2}\{acc}size")
    }
    bstamp: atomBaseOwner :reg :typing :ctx :baseNid :boxElem :mnId
    rtt: reg.typetypeOf typeId: bstamp
    viaVtable: vtableAutoCallName :ast leaf: n.child nameId: mnId
    if (isDispatchableTid :reg tid: bstamp) when viaVtable then {
        pacc: ".".string
        if (isPtrVid :ctx vid: bn2v) then pacc = "->".string
        precv: (
            receiverOnceAt
            :ast
            :reg
            :typing
            :ctx
            baseNid: n.parent
            text: bn2
            textF: bn2F
            tid: bstamp
        )
        return (
            stating
            :facts
            from: callFacts
            text: (
                vtableAutoCallC
                :ast
                :reg
                :typing
                :ctx
                owner: bstamp
                recv: precv.stringView
                acc: pacc.stringView
                :mnId
                isFacet: rtt == ztypes.ztypetype.facetType
            )
        )
    }
    readIsRef: (
        (reg.typetypeOf typeId: (stampIdOf :typing nid: n.nodeid)) == ztypes.ztypetype.functionType
    )
    tnr: tmplInstMemberRead :ast :reg :typing :ctx inst: bstamp :mnId :bn2 :bn2v :facts
    if tnr.length > 0 then return tnr
    eRc: (
        dottedAtomRecClsBase
        :ast
        :reg
        :typing
        :ctx
        baseNid: n.parent
        :bn2
        :bn2F
        :mn2
        :mnId
        :bn2v
        :bstamp
        :rtt
        :readIsRef
        :facts
    )
    if eRc.length > 0 then return eRc
    # a sum's member may be a METHOD; a UNION reads its payload through legs
    # further down, a variant's arm is its payload
    if (rtt == ztypes.ztypetype.unionType) or (rtt == ztypes.ztypetype.variantType) then {
        eSm: (
            sumMemberMethodRead
            :ast
            :reg
            :typing
            :ctx
            baseNid: n.parent
            :mn2
            :mnId
            :bn2
            :bn2F
            :bn2v
            :bstamp
            :facts
        )
        if eSm.length > 0 then return eSm
    }
    if rtt == ztypes.ztypetype.variantType then {
        armDaC: memberC :ast :reg :typing :ctx owner: bstamp kind: memberkind.arm nameId: mnId
        return (stating :facts from: (memberFacts b: bn2F) text: "\{bn2}.data.\{armDaC}")
    }
    cmr: (
        emitCollectionMemberRead
        :ast
        :reg
        :typing
        :ctx
        :n
        :mn2
        :mnId
        :bn2
        :bn2F
        :bn2v
        :bstamp
        :facts
    )
    if cmr.length > 0 then return cmr
    return "".string
}

# atomBaseOwner -- the type a member read on the bare atom `baseNid` resolves
# against: the instance's own stamp while one is emitting, else the shared one;
# a Box's element where the member is the element's; then the owner whose
# methods a typedef reaches.
atomBaseOwner: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    baseNid: zast.nodeid
    # the base is a Box and the member is its element's: the element's type
    boxElem: ztypes.tid
    mnId: zast.nameid
} out ztypes.tid is {
    # a zero-argument method auto-call arrives HERE, through the member-read
    # path, not through emitInstanceMethodCall
    baseStamp: stampIdOf :typing nid: baseNid
    if boxElem.notZero then baseStamp = boxElem
    return (typedefMethodOwner :reg :typing :ctx tid: baseStamp :mnId)
}

# unitFnMemberC -- `unit.fn` where the base names a FILE unit: the C text for a
# zero-argument function member of it, which reads as a dotted path rather than
# a call. Empty when the name is no emittable function of that unit.
unitFnMemberC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    # the file unit the base resolved to
    ud6x: ztypes.declid
    facts: cfacts.borrow
} out String is {
    dpUfo: (
        ztypecheck.resolvedByIdsRo
        :ast
        :typing
        unitDecl: ud6x
        name: (aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child)
    )
    fid: ztypes.tid
    if dpUfo.some then {
        fid = dpUfo
    }
    if fid.isZero then return "".string
    # only a bodied + demanded non-native fn earns the id-cname reference /
    # auto-call route here, whichever unit declares it
    if (stdFnRefEmittable :ast :reg :typing :fid).not then return "".string
    if ((reg.typetypeOf typeId: fid) == ztypes.ztypetype.functionType).not then {
        return "".string
    }
    dpUfc: spelledCname :ctx tid: fid
    return (
        fnRefOrCallC
        :ast
        :reg
        :typing
        :ctx
        nid: n.nodeid
        fnTid: fid
        cname: dpUfc.stringView
        requireNoParams: false
        :facts
    )
}

# nsFnMemberC -- the same read where the base names a NAMESPACE rather than a
# file unit: its own zero-argument function member, reached by id. Empty when
# the name is no function of that namespace.
nsFnMemberC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    nsTid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    nfo: (
        typing.declChildOfId
        parentTypeId: nsTid
        nameId: (aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child)
    )
    nftid: ztypes.tid
    if nfo.some then {
        nftid = nfo
    }
    if nftid.isZero then return "".string
    if ((reg.typetypeOf typeId: nftid) == ztypes.ztypetype.functionType).not then {
        return "".string
    }
    nfcn: spelledCname :ctx tid: nftid
    return (
        fnRefOrCallC
        :ast
        :reg
        :typing
        :ctx
        nid: n.nodeid
        fnTid: nftid
        cname: nfcn.stringView
        requireNoParams: false
        :facts
    )
}

# emitDottedUnitRead -- a read whose BASE names a unit: another unit's constant
# inlines its rendered C text, and a zero-argument function member of a unit or
# namespace auto-calls. The unit is
# the one the checker resolved the base to (pathUnitTidOf).
emitDottedUnitRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    facts: cfacts.borrow
} out String is {
    # `unit.CONST` -- a constant of another unit inlines its rendered C
    # text, exactly as a bare reference to a constant of this unit does
    ucv: unitConstTextOf :ast :reg :typing :ctx :n :facts
    if ucv.length > 0 then return ucv
    # `unit.block` -- another unit's list reads as its value
    udv: staticListValueText :typing :ctx nid: n.nodeid
    if udv.length > 0 then return (stating :facts from: literalFacts text: udv)
    # the unit the checker resolved the base to: a file unit's zero-argument
    # function member, or a namespace's own -- a zero-argument function member
    # reads as a dotted path, not a call
    dpFile: baseFileUnitDecl :reg :typing baseId: n.parent
    if dpFile.notZero then {
        ufm: unitFnMemberC :ast :reg :typing :ctx :n ud6x: dpFile :facts
        if ufm.length > 0 then return ufm
        return "".string
    }
    dpNsTid: pathUnitTidOf :reg :typing baseId: n.parent
    if dpNsTid.notZero then {
        return (nsFnMemberC :ast :reg :typing :ctx :n nsTid: dpNsTid :facts)
    }
    return "".string
}

# emitValtypeCopy -- a CONCRETE valtype receiver's `.copy` is the value itself,
# copied by the assignment or the argument it feeds. An as-block `copy`
# OVERRIDES the default, so the default may only be claimed where the type
# declares none -- otherwise the author's method is silently skipped. Empty
# when the receiver is not a plain valtype, declares its own copy, or owns
# heap.
emitValtypeCopy: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    tid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    cvvt: reg.typetypeOf typeId: tid
    cvval: cvvt.isValueFamily
    if cvval.not then return "".string
    cvown: typing.declChildOfId parentTypeId: tid nameId: zast.wellKnown.slot.wkCopy
    if cvown.some then {
        return "".string
    }
    if (ownsResources :reg :ctx :tid) then return "".string
    # the value itself -- but a POINTER receiver is not one yet. Asked BEFORE
    # the expression is built so the common path keeps handing emitExpr's
    # result straight back: binding it to a local first costs a String on every
    # `.copy` in the program.
    if (needsValueDeref :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent) :tid) then {
        cvlF: cfacts
        cvl: emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent) facts: cvlF
        return (stating :facts from: (operandFacts e: cvlF place: true) text: "(*\{cvl})")
    }
    return (emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent) :facts)
}

# copyFamilyOf -- how a container that declares `.copy` is held, which decides
# how its copy is called: 1 for a stack struct (a list, an id container), 2 for
# a heap-held dict, 0 for any other type. Only the five ALL-VALTYPE containers
# declare a copy, and they are named precisely: a checker regression then shows
# up as a missing call, never as a wrong emission on a reference family whose
# elements would get two owners.
copyFamilyOf: function {reg: ztypes.ZTypeRegistry.view ctx: Ctx.view tid: ztypes.tid} out u64 is {
    if (originIsTid :reg :tid originTid: (ctx.origins.get i: family.slot.listVal)) then return 1
    if (originIsTid :reg :tid originTid: (ctx.origins.get i: family.slot.idMapV)) then return 1
    if (originIsTid :reg :tid originTid: (ctx.origins.get i: family.slot.idSet)) then return 1
    if (originIsTid :reg :tid originTid: (ctx.origins.get i: family.slot.setVal)) then return 2
    if (originIsTid :reg :tid originTid: (ctx.origins.get i: family.slot.mapVV)) then return 2
    return 0
}

# containerCopyText -- the `_copy` call of a container of copy family `fam`: a
# stack struct is copied from its ADDRESS, `stackRecv`; a dict is heap-held,
# and its local already IS the pointer, `heapRecv`.
containerCopyText: function {
    ctx: Ctx
    tid: ztypes.tid
    fam: u64
    stackRecv: StringView
    heapRecv: StringView
    facts: cfacts.borrow
} out String is {
    cb: ctxCname :ctx :tid
    noteMemberUse :ctx mono: tid member: memberWord.slot.copy
    if fam == 2 then return (stating :facts from: callFacts text: "\{cb}_copy(\{heapRecv})")
    return (stating :facts from: callFacts text: "\{cb}_copy(\{stackRecv})")
}

# emitCopyConversion -- `.copy`, whose shape depends on the receiver family. A
# function's copy is another reference to it, and emits the base. Empty when
# the conversion is not `.copy` at all.
emitCopyConversion: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    facts: cfacts.borrow
} out String is {
    cvp: stampIdOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: n.parent))
    # `.copy` of a function is another reference to it: the base, which the
    # checker stamped as the function and not as a call of it
    if cvp.notZero when (reg.typetypeOf typeId: cvp) == ztypes.ztypetype.functionType then {
        # a function a folded data value holds is known: it is named, and the
        # value is not read
        bn: ast.nodes.get i: n.parent
        direct: (
            foldedFnRefC
            :ast
            :reg
            :typing
            :ctx
            callable: bn
            mnId: (aliasChildNameId :ast :typing n: bn)
        )
        if direct.length > 0 then return (stating :facts from: constFacts text: direct)
        return (emitExprWith :ast :reg :typing :ctx n: bn :facts)
    }
    cvgen: cvp.isZero
    if (reg.typetypeOf typeId: cvp) == ztypes.ztypetype.genericParam then cvgen = true
    if cvgen.not when cvp.notZero then {
        return (emitValtypeCopy :ast :reg :typing :ctx :n tid: cvp :facts)
    }
    if cvgen.not then return "".string
    if ctx.curThisTid.notZero then {
        (
            emitFail
            :ctx
            what: "unresolved .copy receiver in a generic body".string
            line: n.lineno
        )
        return (stating :facts from: failedFacts text: "0".string)
    }
    return "".string
}

# emitDottedStringConversion -- `.string` on a receiver that is already a view:
# a pooled literal and a StringView both become an owned String over the same
# bytes. Empty when the receiver is neither.
emitDottedStringConversion: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    facts: cfacts.borrow
} out String is {
    scl: bindLitIndex :ast :ctx n: (ast.nodes.get i: n.parent)
    if scl > 0 then {
        sclv: litView :ctx li: scl
        preludeNeed :ctx memb: "@String_from_view"
        return (stating :facts from: callFacts text: "\{ctx.strC}_from_view(\{sclv})")
    }
    if (stampIsSv :typing :ctx nid: n.parent).not then return "".string
    baseValue: emitExpr :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent)
    preludeNeed :ctx memb: "@String_from_view"
    return (stating :facts from: callFacts text: "\{ctx.strC}_from_view(\{baseValue})")
}

# emitDottedConversionRead -- a cross-unit bare construction, and the two deep
# conversions `.copy` and `.string`, whose shape depends on the receiver family:
# a String clones its buffer, an all-valtype container duplicates its storage
# through its own declared copy, a valtype is a bitwise copy, and a generic
# parameter's copy is chosen per instance.
emitDottedConversionRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    facts: cfacts.borrow
} out String is {
    mnc0Id: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
    dps: ast.nodes.get i: n.parent
    ccbc: emitCrossUnitBareCreate :ctx :ast :reg :typing parent: dps childId: mnc0Id :facts
    if ccbc.length > 0 then return ccbc
    if mnc0Id == zast.wellKnown.slot.wkCopy then {
        cpc: emitCopyConversion :ast :reg :typing :ctx :n :facts
        if cpc.length > 0 then return cpc
    }
    if mnc0Id == zast.wellKnown.slot.wkString then {
        stc: emitDottedStringConversion :ast :reg :typing :ctx :n :facts
        if stc.length > 0 then return stc
    }
    # an arm PREDICATE on a unit's constant (`u.k.a`, `k: kind.a`) has the
    # three segments of a cross-unit tag; the checker said it tests the arm
    if (dottedArmPredicateTid :typing nid: n.nodeid).notZero then return "".string
    xpb: dottedParentNodeId n: (ast.nodes.get i: n.parent)
    xpt: aliasChildNameId :ast :typing n: (ast.nodes.get i: n.parent)
    xar: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
    xtag: emitCrossUnitTag :ast :reg :typing :ctx pbase: xpb ptype: xpt arm: xar :facts
    if xtag.length > 0 then return xtag
    return "".string
}

# taggedArmValueC -- a tagged-construction read `Type.arm` of a null-payload
# arm of a non-generic variant or union: the arm's value, or the tag struct.
# Empty for a payload arm or a generic template (construction calls and
# inference are handled by later legs).
taggedArmValueC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the type the path was stamped with
    dtp: ztypes.tid
    # the arm's name id
    mnc0Id: zast.nameid
    facts: cfacts.borrow
} out String is {
    tt: reg.typetypeOf typeId: dtp
    dtg: tt.isSum
    if dtg.not then return String
    if (reg.isGenericOf tid: dtp) then return String
    if (ctxCnameView :ctx tid: dtp).length == 0 then return String
    if (armPayloadC :ast :reg :typing :ctx tid: dtp arm: mnc0Id).length > 0 then return String
    avh: armValueC :ast :ctx :reg :typing tid: dtp arm: mnc0Id
    if avh.length > 0 then return (stating :facts from: constFacts text: avh)
    vcH: spelledCname :ctx tid: dtp
    tgH: spelledTagConst :ast :ctx :reg :typing tid: dtp armId: mnc0Id
    return (stating :facts from: literalFacts text: "((\{vcH}_t){ .tag = \{tgH} })")
}

# receiverTagAccess -- how a receiver's `tag` field is reached: `->` through a
# pointer (a pointer-held variable, a borrowed field), `.` otherwise.
receiverTagAccess: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the receiver node
    pn: astnode.view
} out String is {
    if (pathIsPointer :ast :reg :typing :ctx n: pn) then return "->".string
    return ".".string
}

# armPredicateC -- an arm predicate on a VALUE receiver (the typechecker
# stamped dpArmPredicate): a tag test. An ordinal's discriminator IS its
# value, so a receiver reached through a pointer is LOADED before it is
# tested; the struct-shaped families read a `tag` FIELD instead. A bool
# receiver is a C bool: identity for `.true`, negation for `.false`.
armPredicateC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    # the receiver's type
    dap: ztypes.tid
    mnc0Id: zast.nameid
    facts: cfacts.borrow
} out String is {
    pn: ast.nodes.get i: n.parent
    recvPF: cfacts
    recvP: emitExprWith :ast :reg :typing :ctx n: pn facts: recvPF
    valP: recvP.copy
    # a Box receiver is the pointer to the variant it holds
    bxP: (boxMemberElem :ast :reg :typing :n).notZero
    if bxP or (pathIsPointer :ast :reg :typing :ctx n: pn) then valP = "(*\{recvP})"
    if (isOrdinalPair :typing tid: dap) then {
        fa: ordinalPairFirstArmId :typing tid: dap
        # the arm NAME resolved through any alias, as an id
        if fa.notZero when mnc0Id == fa then return (
            stating
            :facts
            from: (operandFacts e: recvPF place: false)
            text: "(!(\{valP}))"
        )
        return (stating :facts from: (operandFacts e: recvPF place: false) text: "(\{valP})")
    }
    tgP: spelledTagConst :ast :ctx :reg :typing tid: dap armId: mnc0Id
    # an ordinal IS its discriminator: compare the value, not a field
    if (isOrdinalVariant :typing tid: dap) then return (
        stating
        :facts
        from: (operandFacts e: recvPF place: false)
        text: "((\{valP}) == \{tgP})"
    )
    accP: receiverTagAccess :ast :reg :typing :ctx :pn
    if bxP then accP = "->".string
    # a receiver that is a call's owning result is read off the checker's
    # temporary, which frees it
    recvO: ownedReceiverHoist :ast :reg :typing :ctx expr: recvP.stringView exprF: recvPF n: pn
    if recvO.length > 0 then {
        recvP = recvO.take
        recvPF = pathFacts
    }
    return (
        stating
        :facts
        from: (operandFacts e: recvPF place: false)
        text: "((\{recvP})\{accP}tag == \{tgP})"
    )
}

# tagAccessorReadC -- an explicit tag-accessor read: the discriminator cast to
# the declared numeric type. A bool receiver is a C bool with no tag field
# -- the bool VALUE is its discriminator.
tagAccessorReadC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    # the receiver's type
    dtr: ztypes.tid
    facts: cfacts.borrow
} out String is {
    pn: ast.nodes.get i: n.parent
    recvTF: cfacts
    recvT: emitExprWith :ast :reg :typing :ctx n: pn facts: recvTF
    tatE: ztypes.tid
    tacc: typing.tagAccessor.get key: (ztypecheck.tagAccessorOwner :reg :typing tid: dtr)
    if tacc.some then tatE = tacc.tid
    castT: typeRefC :ast :reg :typing :ctx tid: tatE
    # a Box receiver is the pointer to the variant it holds
    bxT: (boxMemberElem :ast :reg :typing :n).notZero
    if (isOrdinalVariant :typing tid: dtr) then {
        if bxT or (pathIsPointer :ast :reg :typing :ctx n: pn) then return (
            stating
            :facts
            from: (operandFacts e: recvTF place: false)
            text: "((\{castT})(*\{recvT}))"
        )
        return (
            stating
            :facts
            from: (operandFacts e: recvTF place: false)
            text: "((\{castT})(\{recvT}))"
        )
    }
    accT: receiverTagAccess :ast :reg :typing :ctx :pn
    if bxT then accT = "->".string
    recvO: ownedReceiverHoist :ast :reg :typing :ctx expr: recvT.stringView exprF: recvTF n: pn
    if recvO.length > 0 then {
        recvT = recvO.take
        recvTF = pathFacts
    }
    return (
        stating
        :facts
        from: (operandFacts e: recvTF place: false)
        text: "((\{castT})(\{recvT})\{accT}tag)"
    )
}

# emitDottedTagRead -- the three tagged-type stamps the checker leaves on a dotted
# path: a construction reference (`Type.arm`), an arm PREDICATE on a value
# receiver (a tag test), and an explicit tag-accessor read. A bool receiver is a
# C bool with no tag field, so its VALUE is its discriminator.
emitDottedTagRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    # the member, as an id: the two legs that SPELL an arm name copy it there,
    # and the common path -- a dotted read that is neither a tagged
    # construction nor an arm predicate -- copies nothing
    mnc0Id: zast.nameid
    facts: cfacts.borrow
} out String is {
    # tagged-construction stamp: the typechecker resolved this path as
    # `Type.arm`, so member emission wins over the name-matched legs
    # below (io/os bases, ownership markers, numeric casts)
    dtp: dottedTaggedTid :typing nid: n.nodeid
    if dtp.notZero then {
        r: taggedArmValueC :ast :reg :typing :ctx :dtp :mnc0Id :facts
        if r.length > 0 then return r
    }
    dap: dottedArmPredicateTid :typing nid: n.nodeid
    if dap.notZero then return (armPredicateC :ast :reg :typing :ctx :n :dap :mnc0Id :facts)
    dtr: dottedTagReadTid :typing nid: n.nodeid
    if dtr.notZero then return (tagAccessorReadC :ast :reg :typing :ctx :n :dtr :facts)
    return "".string
}

# moveMarkerMovesBase -- whether `.take`/`.hold` on this base moves a heap
# value: a String, a union, a protocol value (it owns its box), a by-value
# class (a borrowed pointer-param class is not a move source), or a function
# value.
moveMarkerMovesBase: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    # the marker's base node id
    pnid: zast.nodeid
} out bool is {
    tknid: atomNodeId n: (ast.nodes.get i: pnid)
    if tknid.isZero then tknid = pnid
    tkt: stampIdOf :typing nid: tknid
    if tkt == ctx.strTid then return true
    tt: reg.typetypeOf typeId: tkt
    if (tt == ztypes.ztypetype.unionType) or (tt == ztypes.ztypetype.protocolType) then return true
    if tt == ztypes.ztypetype.functionType then return true
    if tt == ztypes.ztypetype.classType then {
        return (isPtrVid :ctx vid: (atomVid :typing nid: tknid)).not
    }
    return false
}

# markerReadsFieldValue -- the base of a move marker is a field path whose
# value is not a function: what the marker hands on is the field's value.
markerReadsFieldValue: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    pnid: zast.nodeid
} out bool is {
    isPath: false
    pn: ast.nodes.get i: pnid
    isPath = pn.dottedpath
    if isPath.not then return false
    pt: stampIdOf :typing nid: pnid
    if pt.isZero then return false
    return (reg.typetypeOf typeId: pt) != ztypes.ztypetype.functionType
}

# markerHandsOnBase -- a move marker on this base emits the base itself.
# - `.take` on a heap reftype is an ownership MOVE: the statement-level emitter
#   zeroes the source after the call so its scope-exit free is a no-op (the
#   callee now owns the heap).
# - `.take` / `.hold` on a FIELD holding a value -- a number, a record -- moves
#   nothing off the heap: the value is the field's own, read in place (the
#   binding zeroes the field after it).
# - on any other value that owns nothing -- a number, a truth value, a record of
#   such, in a local or computed -- the move is a copy.
# Spelling the marker instead reads a member the value does not have.
markerHandsOnBase: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the marker's base node id
    pnid: zast.nodeid
} out bool is {
    if (moveMarkerMovesBase :ast :reg :typing :ctx :pnid) then return true
    if (markerReadsFieldValue :ast :reg :typing :pnid) then return true
    return (markerCopiesValue :reg :typing :ctx :pnid)
}

# markerCopiesValue -- the base of a move marker is a value whose type owns
# nothing to hand over: not a function, nothing to destroy, not a heap
# collection. Moving it is copying it.
markerCopiesValue: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx pnid: zast.nodeid
} out bool is {
    pt: stampIdOf :typing nid: pnid
    if pt.isZero then return false
    if (reg.typetypeOf typeId: pt) == ztypes.ztypetype.functionType then return false
    if (ownsResources :reg :ctx tid: pt) then return false
    return (isHeapPtrCollection :reg :typing :ctx tid: pt).not
}

# convRowNameOf -- the key of the row of the runtime numeric conversion a
# dotted marker `<expr>.<numtype>` names; no file (impl 0) when it names none.
# The member's name is asked first: a name no type's row gives a body is what
# nearly every dotted marker carries. A member the RECEIVER'S OWN type
# declares with a body the author wrote wins over any conversion its typedef
# chain end would offer: a typedef converts as its chain end, which is where
# the conversions themselves (`is native`) are declared, but a typedef over
# `i64` that declares its own `u32` declared a method. A conversion's row has
# a body naming no argument: a bodyless row of the same member name
# (String's `length` beside text's) is the runtime's function, and a row
# taking an argument is a call's. Folded literal conversions return earlier
# via nodeConstText.
convRowNameOf: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    # the conversion member's name id (`.u8`, `.i64` ...)
    mn2Id: zast.nameid
} out zemitrows.rowname is {
    none: zemitrows.rowname impl: 0 typeName: zast.nameid.zero name: zast.nameid.zero
    if (ctx.rows.memberBodies.has item: mn2Id).not then return none
    ownerTid: stampIdOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: n.parent))
    mo9: typing.declChildOfId parentTypeId: ownerTid nameId: mn2Id
    if mo9.some when (reg.isNativeOf tid: mo9).not then return none
    srcTid: ztypecheck.typedefChaseTid :typing tid: ownerTid
    rk: rowNameOfMember :reg :typing :ctx owner: srcTid name: mn2Id
    row: ctx.rows.ofName n: rk
    if row == 0 then return none
    body: rowBody :ctx :row
    if body.isZero then return none
    if (rtHas :ctx id: body slot: rtHole.slot.holeA1) then return none
    if (rtHas :ctx id: body slot: rtHole.slot.holeL) then return none
    return rk
}

# emitDottedNativeMarker -- a list's element read, a zero-parameter native
# that auto-calls (io.stdout, os.pid), the compile-time markers `.private` /
# `.borrow` / `.take`, and a runtime numeric conversion. The conversion is whichever
# member resolves to a row on the SOURCE type, so a user field merely NAMED `u32`
# finds nothing and takes the member legs instead.
emitDottedNativeMarker: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    facts: cfacts.borrow
} out String is {
    mn2Id: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
    # a list's member read (`codes.ht`, `consts.codes.ht`, `primes.0`,
    # `codes.slot.lf`): the list is the base's row, whatever shape the base
    # takes; no base is emitted
    listRow: listRowOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: n.parent))
    if listRow != 0 then {
        memberText: emitStaticListMember :ast :reg :typing :ctx :n row: listRow mnId: mn2Id :facts
        if memberText.length > 0 then return memberText
    }
    lsr: emitListSlotRead :ast :reg :typing :ctx :n mnId: mn2Id :facts
    if lsr.length > 0 then return lsr
    # a zero-parameter native read without parens auto-calls: the member's
    # DECLARATION says so, so io.stdout and os.pid take one leg and no
    # name is listed
    nnu: (
        nativeNoArgOf
        :ast
        :reg
        :typing
        baseId: n.parent
        membId: (aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child)
    )
    if nnu.length > 0 then {
        mn2n: zast.nameTextAt :ast ref: mn2Id
        return (
            stating
            :facts
            from: callFacts
            text: (nativeUnitCallC :ctx uname: nnu.stringView member: mn2n.stringView)
        )
    }
    # `.private` is a compile-time friend marker -- it emits the receiver itself.
    if (zast.markerKindOfName id: mn2Id).privateMarker then {
        return (emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent) :facts)
    }
    # `.borrow` on a value is the ownership marker, and the checker accepts it
    # as one; it emits the receiver itself.
    if (zast.markerKindOfName id: mn2Id).borrowMarker then {
        return (emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent) :facts)
    }
    # `.take` / `.hold` hands on the base itself (markerHandsOnBase)
    if (ztypecheck.isMoveMarkerId nameId: mn2Id) when (
        markerHandsOnBase
        :ast
        :reg
        :typing
        :ctx
        pnid: n.parent
    ) then {
        return (emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent) :facts)
    }
    # a runtime numeric conversion `<expr>.<numtype>`
    ncKey: convRowNameOf :ast :reg :typing :ctx :n :mn2Id
    if ncKey.impl > 0 then {
        ncMk: pendingHoistMark :ctx
        ncValF: cfacts
        ncVal: emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent) facts: ncValF
        if (pathIsPointer :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent)) then {
            ncDeref: "(*\{ncVal})"
            ncVal = ncDeref.copy
            ncValF = operandFacts e: ncValF place: true
        }
        ncRet: stampIdOf :typing nid: n.nodeid
        ncRetM: chaseAggregateTypedef :reg :typing :ctx tid: ncRet
        return (
            emitNumericCast
            :ast
            :ctx
            val: ncVal
            valF: ncValF
            valNid: n.parent
            mark: ncMk
            :reg
            :typing
            retTid: ncRetM
            rowKey: ncKey
            :facts
        )
    }
    return "".string
}


# baseAtomNamesFunction -- a bare atom that is not a local and whose reference
# resolves to a FUNCTION definition: in value position it is a call.
baseAtomNamesFunction: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view n: astnode.view
} out bool is {
    anid: atomNodeId :n
    if anid.isZero then return false
    avo: typing.atomVariableId.get key: anid
    if avo.some then {
        return false
    }
    rdo: typing.refDecl.get key: anid
    match (
        rdo
    ) case some then {
        rd: typing.decls.get i: rdo
        rdt: rd.typeId
        return (reg.typetypeOf typeId: rdt) == ztypes.ztypetype.functionType
    } case none then {
        return false
    }
}

# baseAtomIsFoldedString -- a bare atom that is not a local and that the
# checker folded to a STRING value: a string constant. It names no storage, so
# as a receiver it is its `_zcsN` static, emitted as an expression the way a
# call base is -- spelling the constant's own name would read a variable no
# program declares.
baseAtomIsFoldedString: function {typing: ztyping.ZTyping.view n: astnode.view} out bool is {
    anid: atomNodeId :n
    if anid.isZero then return false
    if (typing.atomVariableId.get key: anid).some then return false
    g: typing.nodeConst.get key: anid
    match (
        g
    ) case some then {
        return g.kind.svalKind
    } case none then {
        return false
    }
}

# baseAtomReadsAsValue -- a bare atom whose receiver is a VALUE with no storage
# of its own: a function it calls, or a string constant's static.
baseAtomReadsAsValue: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view n: astnode.view
} out bool is {
    if (baseAtomNamesFunction :reg :typing :n) then return true
    return (baseAtomIsFoldedString :typing :n)
}

# boxMemberElem -- the element type a member read off a Box reaches: a Box's
# fields and methods are its element's, the ownership markers and `.copy` its
# own (ztypecheck.boxMemberDelegates). 0 when the base is not a Box or the
# member is the box's. A parameter's stamp is a shell named after the Box, so
# it is canonicalised as nodeIsAtomBox does.
boxMemberElem: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    n: zast.dottedpathrow.view
} out ztypes.tid is {
    mnId: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
    if (ztypecheck.boxMemberDelegates nameId: mnId).not then return ztypes.tid.zero
    bnid: interpPartNodeId n: (ast.nodes.get i: n.parent)
    bt: stampIdOf :typing nid: bnid
    if bt.isZero then return ztypes.tid.zero
    if (reg.isBoxOf tid: bt).not then {
        bxc: canonTypeId :reg :typing tid: bt
        if bxc.isZero then return ztypes.tid.zero
        bt = bxc
        if (reg.isBoxOf tid: bt).not then return ztypes.tid.zero
    }
    if (reg.genericArgCount specId: bt) != 1 then return ztypes.tid.zero
    return (reg.genericTypeArgAt specId: bt ordinal: 0)
}

# orPanicExprC -- `r.orPanic` on a resultval `tid`: the ok payload, or a panic
# when `r` holds err. `recv` is r's C expression, whose facts are `recvF` and
# whose value is node `recvNid`: it is read for its tag and then its payload,
# so it is evaluated once, into its temp, unless reading it twice costs nothing.
orPanicExprC: function {
    # the arm names
    ast: Ast.view
    # the checked program
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the resultval instance
    tid: ztypes.tid
    recv: String.take
    recvF: cfacts
    recvNid: zast.nodeid
    facts: cfacts.borrow
} out String is {
    rcT: spelledCname :ctx :tid
    okTag: spelledTagConst :ast :ctx :reg :typing :tid armId: zast.wellKnown.slot.wkOk
    okC: (
        memberC
        :ast
        :reg
        :typing
        :ctx
        owner: tid
        kind: memberkind.arm
        nameId: zast.wellKnown.slot.wkOk
    )
    rcCType: "\{rcT}_t"
    pre: String
    spelled: (
        orderOnePart
        :ast
        :reg
        :typing
        :ctx
        mark: (pendingHoistMark :ctx)
        text: recv
        tf: recvF
        nid: recvNid
        ctype: rcCType.stringView
        constant: false
        twice: true
        prefix: pre
    )
    r: spelled.stringView
    preludeNeed :ctx memb: "@panic"
    pnc: "z_panic(\"orPanic: result is err\")"
    body: "((\{r}.tag != \{okTag} ? \{pnc} : (void)0), \{r}.data.\{okC})"
    return (stating :facts from: callFacts text: (orderWrap prefix: pre call: body))
}

# emitDottedRead -- the C text of a dotted PATH read (the call form is
# emitDottedCall). The legs run in the order the checker's stamps settle them:
# the built-in `.orPanic`, the tagged-type stamps, then -- unless the member is
# a field -- unit-qualified reads, the conversions and type constants, and
# last the member read itself.
emitDottedRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    # its facts, where a leg knows them
    facts: cfacts.borrow
} out String is {
    # built-in `.orPanic` on a resultval/Result receiver -- any base
    # (a bound var, or a chained call/conversion), emitted via emitExpr so
    # the receiver value is materialized once. `.or d:` is a call node and
    # is handled by emitResultCombinator in the call dispatch instead.
    # the member is asked by ID: the legs below lend ast, and an id is a scalar
    dcMnId: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
    if dcMnId == zast.wellKnown.slot.wkOrPanic then {
        pStamp: stampIdOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: n.parent))
        pMono: chaseAggregateTypedef :reg :typing :ctx tid: pStamp
        isRcc: originIsTid :reg tid: pMono originTid: (ctx.origins.get i: family.slot.resultval)
        if isRcc then {
            rcRecvF: cfacts
            rcRecv: valueExprC :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent) facts: rcRecvF
            return (
                orPanicExprC
                :ast
                :reg
                :typing
                :ctx
                tid: pMono
                recv: rcRecv
                recvF: rcRecvF
                recvNid: n.parent
                :facts
            )
        }
    }
    dtg: (
        emitDottedTagRead
        :ast
        :reg
        :typing
        :ctx
        :n
        mnc0Id: (aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child)
        :facts
    )
    if dtg.length > 0 then return dtg
    # a path that names a type, read as a value (`unit.Conf`, `p.Inner`),
    # constructs like the bare-atom legs; an `as` alias is declared as a member,
    # so this comes before the field gate
    izd: typing.implicitCreate.get key: n.nodeid
    if izd.some then return (implicitZeroValue :ast :reg :typing :ctx tid: izd :facts)
    # a FIELD is read off its base: the unit, conversion and constant legs
    # read none, so it goes straight to the member legs
    if (memberDeclIsField :typing nid: n.nodeid).not then {
        dur: emitDottedUnitRead :ast :reg :typing :ctx :n :facts
        if dur.length > 0 then return dur
        dcr: emitDottedConversionRead :ast :reg :typing :ctx :n :facts
        if dcr.length > 0 then return dcr
        dtc: dottedTypeConstRead :ast :reg :typing :ctx :n :facts
        if dtc.length > 0 then return dtc
    }
    dmr: emitDottedMemberRead :ast :reg :typing :ctx :n :facts
    # a borrowed field read off a value a call computes is the place its pointer
    # reaches: no variable stands for the pointer for a reader to go through
    if dmr.length > 0 when (borrowedPointerField :ast :reg :typing :ctx :n) when (
        fieldBaseIsPlace
        :ast
        :typing
        n: (ast.nodes.get i: n.parent)
    ).not then {
        return (stating :facts from: (operandFacts e: facts place: true) text: "(*\{dmr})")
    }
    return dmr
}

# memberDeclIsField -- the member a dotted path names is declared as a FIELD.
memberDeclIsField: function {typing: ztyping.ZTyping.view nid: zast.nodeid} out bool is {
    mdo: typing.refDecl.get key: nid
    if mdo.none then return false
    return (typing.decls.get i: mdo).kind.fieldDecl
}

# emitDottedMemberRead -- a dotted read of a MEMBER of its base's value: the
# base is emitted (or its alias, or a view's temporary), then the markers and
# native no-argument reads, and the families' member legs by whether the base
# is an atom or itself a path.
emitDottedMemberRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    facts: cfacts.borrow
} out String is {
    bn2r: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: (ast.nodes.get i: n.parent))
    baseAtomNid: atomNodeId n: (ast.nodes.get i: n.parent)
    baseAtomVid: atomVid :typing nid: baseAtomNid
    # the receiver's variable, for the pointer-access checks below
    bn2v: unaliasedVid :reg :typing :ctx nid: baseAtomNid name: bn2r.stringView vid: baseAtomVid
    bn2F: cfacts
    bn2: (
        emitLocalAtomNameAt
        :ast
        :reg
        :typing
        :ctx
        nid: baseAtomNid
        name: bn2r.stringView
        vid: baseAtomVid
        facts: bn2F
    )
    # a base atom that names a FUNCTION auto-calls, so the receiver is what the
    # call returns (`mkList.length`), and a string constant is its static: neither
    # is a local to address, so each takes the legs a call base takes, exactly as
    # the parenthesised `(mkList).length` does
    if (baseAtomReadsAsValue :reg :typing n: (ast.nodes.get i: n.parent)) then bn2 = "".string
    # a data value's name is the address of its static object, and a number
    # no variable holds -- a numeric generic parameter's value -- is its value
    bk: (typing.nodeConstAt nid: baseAtomNid).kind
    if bk.aggKind or (baseAtomVid.isZero and (bk.ivalKind or bk.fvalKind)) then {
        bn2F = cfacts
        bn2 = nodeConstText :ast :reg :typing :ctx nid: baseAtomNid facts: bn2F
    }
    # a base with no atom NAME still has a stamped type. Every native leg
    # below sits behind `bn2.length > 0`, so a projection (`(x.y).stringView`)
    # or a call (s.trim, (mk s: s)) skipped the lot and fell through to the
    # user-method path, which renders the callee as the method's
    # function-type id -- a symbol nothing defines. emitDottedCall already
    # carries this leg for the CALL form; the READ form never got it.
    if bn2.length == 0 then {
        nbId: interpPartNodeId n: (ast.nodes.get i: n.parent)
        nbT: chaseStrTypedef :typing :ctx tid: (stampIdOf :typing nid: nbId)
        # StringView only: svValueForm reads a String receiver's expression
        # twice, once for .data and once for .size, and twice is a second
        # evaluation when the expression is a call.
        if nbT == ctx.svTid then {
            nbXF: cfacts
            nbX: emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent) facts: nbXF
            if nbX.length > 0 then {
                bn2 = (
                    addressableText
                    :ast
                    :reg
                    :typing
                    :ctx
                    e: nbX.stringView
                    eF: nbXF
                    tid: nbT
                    facts: bn2F
                )
            }
        }
    }
    dnm: emitDottedNativeMarker :ast :reg :typing :ctx :n :facts
    if dnm.length > 0 then return dnm
    mn2: aliasOrChild :ast :typing aliasId: n.nodeid childId: n.child
    mnId: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
    if bn2.length > 0 then {
        # a Box's fields and methods are its element's, read through the cell;
        # a text held by pointer is read through its pointee by the view natives
        bxE: boxMemberElem :ast :reg :typing :n
        if bxE.notZero or (textViewNativeByPtr :reg :typing :ctx vid: bn2v :mnId) then {
            bn2 = "(*\{bn2})"
            bn2F = derefFacts
            bn2v = ztypes.vid
        }
        aba: (
            emitDottedAtomBase
            :ast
            :reg
            :typing
            :ctx
            :n
            :mn2
            :mnId
            bn2: bn2.stringView
            :bn2F
            :bn2v
            boxElem: bxE
            :facts
        )
        if aba.length > 0 then return aba
    }
    return (emitDottedNestedBase :ast :reg :typing :ctx :n :mn2 :mnId :facts)
}

# loadValueStructRef -- a call's text `e`, loaded when the call hands back a
# String or List reference (valueStructRefNode): the pointer is bound to a temp
# where the call is spelled, so the call runs once and before whatever the
# statement spells after it, and the text is that temp's deref.
loadValueStructRef: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    e: String.take
    # the facts `e`'s producer stated, kept when `e` is handed back as it is
    facts: cfacts.borrow
} out String is {
    if (valueStructRefNode :ast :reg :typing :ctx :n).isZero then return e
    rt: stampIdOf :typing nid: (interpPartNodeId :n)
    ph: (
        hoistForAddress
        :ast
        :reg
        :typing
        :ctx
        av: e.stringView
        tid: rt
        argNid: zast.nodeid
        ptr: true
    )
    return (stating :facts from: derefFacts text: "(*\{ph})")
}

# unloadValueStructRef -- the pointer behind a loaded reference call's text:
# the address of `e` when loadValueStructRef loaded it, `e` otherwise.
unloadValueStructRef: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    e: StringView
} out String is {
    if (valueStructRefNode :ast :reg :typing :ctx :n).isZero then return e.string
    return "&\{e}"
}

# emitExpr -- the C expression text for a node (calls inline; the scalar
# examples carry no order-sensitive multi-call arguments).
emitExpr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out String is {
    facts: cfacts
    return (emitExprArms :ast :reg :typing :ctx :n :facts)
}

# emitExprWith -- emitExpr, the facts its arm states written into `facts`.
emitExprWith: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    facts: cfacts.borrow
} out String is {
    stateFacts :facts from: cfacts
    t: emitExprArms :ast :reg :typing :ctx :n :facts
    if t.length > 0 when facts.stated.not then (
        emitFail
        :ctx
        what: "internal: an expression emitted with no facts stated".string
        line: 0
    )
    return t
}

# emitExprArms -- emitExpr's legs, by node kind; an arm that knows its text's
# facts states them into `facts`.
emitExprArms: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    facts: cfacts.borrow
} out String is {
    cv: nodeConstText :ast :reg :typing :ctx nid: (interpPartNodeId :n) :facts
    if cv.length > 0 then return cv
    match (
        n
    ) case statementline then {
        return (emitExprArms :ast :reg :typing :ctx n: (ast.nodes.get i: n.statementline) :facts)
    } case statement then {
        if n.statements.count.u64 == 1 then {
            s0Id: zast.kidAt kids: ast.kids span: n.statements i: 0
            return (emitExprArms :ast :reg :typing :ctx n: (ast.nodes.get i: s0Id) :facts)
        }
        emitFail :ctx what: "unhandled expr (multi-statement)".string line: n.lineno
        return (stating :facts from: failedFacts text: "0".string)
    } case atomid then {
        return (emitAtom :ast :reg :typing :ctx :n :facts)
    } case labelvalue then {
        lvC: ast.names.texts.get i: n.name
        lvv: atomVid :typing nid: n.nodeid
        return (
            emitLocalAtomNameAt
            :ast
            :reg
            :typing
            :ctx
            nid: n.nodeid
            name: lvC.stringView
            vid: lvv
            :facts
        )
    } case dottedpath then {
        dre: emitDottedRead :ast :reg :typing :ctx :n :facts
        return (
            loadValueStructRef
            :ast
            :reg
            :typing
            :ctx
            n: (ast.nodes.get i: n.nodeid)
            e: dre.take
            :facts
        )
    } case atomstring then {
        li: litIndexOf :ctx nid: n.nodeid
        if li > 0 then return (stating :facts from: pathFacts text: (litView :ctx :li))
        # an interpolation is an owned String rvalue, built where it is
        # evaluated -- the same shape as a call returning one
        ie: emitInterpArgExpr :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid)
        if ie.length > 0 then return (stating :facts from: callFacts text: ie)
        emitFail :ctx what: "unhandled atomstring expr".string line: n.lineno
        return (
            stating
            :facts
            from: failedFacts
            text: "0".string
        )
    } case ifexpr then {
        # a chain whose every condition folds has ONE live branch: emit its
        # value alone. spec.pdoc, Conditional Compilation, promises the false
        # branch is not emitted, and that promise is not limited to statement
        # position.
        vfb: foldedBranchOf :typing nid: n.nodeid
        if vfb.known when vfb.stmt.notZero then {
            return (armValueExpr :ast :reg :typing :ctx n: (ast.nodes.get i: vfb.stmt) :facts)
        }
        if (controlValueIsReference :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid)) then {
            return (emitControlRef :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid) :facts)
        }
        if (ifIsTernary :ast n: (ast.nodes.get i: n.nodeid)).not then {
            icx: emitControlExpr :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid)
            if icx.length > 0 then return (stating :facts from: callFacts text: icx)
            return (stating :facts from: failedFacts text: (unhandledExpr :ctx line: n.lineno))
        }
        return (emitTernaryChain :ast :reg :typing :ctx :n :facts)
    } case call then {
        cve: emitCallValue :ast :reg :typing :ctx call: n :facts
        return (
            loadValueStructRef
            :ast
            :reg
            :typing
            :ctx
            n: (ast.nodes.get i: n.nodeid)
            e: cve.take
            :facts
        )
    } case caseexpr then {
        if (controlValueIsReference :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid)) then {
            return (emitControlRef :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid) :facts)
        }
        mcx: emitControlExpr :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid)
        if mcx.length > 0 then return (stating :facts from: callFacts text: mcx)
        return (stating :facts from: failedFacts text: (unhandledExpr :ctx line: n.lineno))
    } case withexpr then {
        # grammar.pdoc: "`with` can be used as an expression. The result will be
        # the value of the `do` expression." It reaches C the way an `if` or a
        # `match` does -- no C expression spells a scope with a binding in it
        if (controlValueIsReference :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid)) then {
            return (emitControlRef :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid) :facts)
        }
        wcx: emitControlExpr :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid)
        if wcx.length > 0 then return (stating :facts from: callFacts text: wcx)
        return (stating :facts from: failedFacts text: (unhandledExpr :ctx line: n.lineno))
    } case doexpr then {
        # a block used as a value: its statements run ahead, as a `with`'s do
        if (controlValueIsReference :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid)) then {
            return (emitControlRef :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid) :facts)
        }
        dcx: emitControlExpr :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid)
        if dcx.length > 0 then return (stating :facts from: callFacts text: dcx)
        return (stating :facts from: failedFacts text: (unhandledExpr :ctx line: n.lineno))
    } else {
        return (
            stating
            :facts
            from: failedFacts
            text: (unhandledExpr :ctx line: (ztypecheck.nodeLine :n))
        )
    }
}

# unhandledExpr -- the backstop for an expression no leg emits.
unhandledExpr: function {ctx: Ctx line: u32} out String is {
    emitFail :ctx what: "unhandled expr".string :line
    return "0".string
}

# ifIsTernary -- an `if` a C ternary spells: every arm is one value that stays
# inside the expression.
ifIsTernary: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case ifexpr then {
        for each clId: (zast.kidsOf :ast span: n.clauses) loop {
            cl: ast.nodes.get i: clId
            if cl.ifclause when (isSimpleValueNode :ast n: (ast.nodes.get i: cl.statement)
            ).not then return false
        }
        if n.elseclause.notZero when (
            isSimpleValueNode
            :ast
            n: (ast.nodes.get i: n.elseclause)
        ).not then return false
    } else null
    return (ztypecheck.armLeaves :ast :n inLoop: false).not
}

# controlValueIsReference -- an `if`, a `match`, a block or a `with` used as a
# value whose type owns something and one of whose arms (a block's or a `with`'s
# one body) is a place (armLeafIsPlace): what it yields is storage something
# else owns on that arm's path, so it is emitted as a reference to the arm's
# value (emitControlRef) rather than as a value of its own, which every use
# would free.
controlValueIsReference: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    n: astnode.view
} out bool is {
    isCtl: n.ifexpr or n.caseexpr or n.doexpr or n.withexpr
    if isCtl.not then return false
    nid: zast.nodeIdOf :n
    vt: bindingStampOf :typing nid: (controlValueStampNid :ast :reg :typing :n)
    if vt.isZero then return false
    owns: vt == ctx.strTid
    if owns.not then owns = isHeapPtrCollection :reg :typing :ctx tid: vt
    if owns.not then owns = ownsResources :reg :ctx tid: vt
    if owns.not then return false
    blocks: ListVal zast.nodeid
    ztypecheck.controlArmBlocks :ast :nid into: blocks
    place: false
    for each blk: blocks loop {
        lf: armLeafNode :ast :reg :typing blockId: blk
        if lf.notZero when (
            armLeafIsPlace
            :ast
            :reg
            :typing
            :ctx
            n: (ast.nodes.get i: lf)
        ) then place = true
    }
    return place
}

# armLeafNode -- the node the arm body `blockId` yields: its last line's value, or
# the body itself when it is an expression; 0 for an arm that yields nothing.
armLeafNode: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the arm body
    blockId: zast.nodeid
} out zast.nodeid is {
    isBlock: false
    bn: ast.nodes.get i: blockId
    isBlock = bn.statement
    if isBlock.not then return blockId
    lineId: ztypecheck.lastStmtLineIdAt :ast oId: blockId
    if lineId.isZero then return zast.nodeid
    return (
        ztypecheck.implicitReturnValue
        :reg
        :typing
        :ast
        :lineId
        lineType: (stampIdOf :typing nid: lineId)
    )
}

# armLeafIsPlace -- an arm's value reads storage something else owns: a local or a
# parameter the arm does not move, a field, an element a call hands back, or a
# nested control value that is itself a reference.
armLeafIsPlace: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case statementline then {
        return (armLeafIsPlace :ast :reg :typing :ctx n: (ast.nodes.get i: n.statementline))
    } case statement then {
        if n.statements.count.u64 != 1 then return false
        s0Id: zast.kidAt kids: ast.kids span: n.statements i: 0
        return (armLeafIsPlace :ast :reg :typing :ctx n: (ast.nodes.get i: s0Id))
    } case atomid then {
        # a local the checker moved into where the value lands is the arm's own
        if (typing.armLeafMoves.has item: n.nodeid) then return false
        return (typing.armLeafPlaces.has item: n.nodeid)
    } case ifexpr then {
        return (controlValueIsReference :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid))
    } case caseexpr then {
        return (controlValueIsReference :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid))
    } case doexpr then {
        return (controlValueIsReference :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid))
    } case withexpr then {
        return (controlValueIsReference :ast :reg :typing :ctx n: (ast.nodes.get i: n.nodeid))
    } else {
        if (armTakeLeaf :ast :typing :n).notZero then return false
        if (typing.armLeafMoves.has item: (zast.nodeIdOf :n)) then return false
        return (typing.armLeafPlaces.has item: (zast.nodeIdOf :n))
    }
}

# armValueNode -- the value node an arm written as a one-line block or a statement
# line holds; the node itself otherwise.
armValueNode: function {ast: Ast.view n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case statementline then {
        return (armValueNode :ast n: (ast.nodes.get i: n.statementline))
    } case statement then {
        if n.statements.count.u64 != 1 then return n.nodeid
        s0Id: zast.kidAt kids: ast.kids span: n.statements i: 0
        return (armValueNode :ast n: (ast.nodes.get i: s0Id))
    } else {
        return (zast.nodeIdOf :n)
    }
}

# emitControlRef -- a reference control value (controlValueIsReference): `(*p)`,
# where `p` is the address of the value the arm that ran yields -- a chain of
# ternaries when every arm is one value, a statement expression otherwise.
emitControlRef: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    facts: cfacts.borrow
} out String is {
    ptr: String
    ptrF: callFacts
    match (
        n
    ) case ifexpr then {
        if (ifIsTernary :ast n: (ast.nodes.get i: n.nodeid)) then {
            ptr = emitTernaryChain :ast :reg :typing :ctx :n ref: true facts: ptrF
        }
    } else null
    if ptr.length == 0 then {
        # a statement expression
        ptr = emitControlPtrExpr :ast :reg :typing :ctx :n
        ptrF = callFacts
    }
    if ptr.length == 0 then return (
        stating
        :facts
        from: failedFacts
        text: (unhandledExpr :ctx line: (ztypecheck.nodeLine :n))
    )
    # a Set or Map value already is the pointer to what it holds
    vt: bindingStampOf :typing nid: (controlValueStampNid :ast :reg :typing :n)
    if (isHeapPtrCollection :reg :typing :ctx tid: vt) then return (
        stating
        :facts
        from: ptrF
        text: ptr
    )
    return (stating :facts from: (operandFacts e: ptrF place: true) text: "(*\{ptr})")
}

# armRefLeaf -- an arm of a reference control value, as the address its pointer
# takes: a place arm's own address (a pointer local already is one), or a zeroed
# temporary the statement releases, assigned the arm's value, and its address.
# The address is cast to the value's plain pointer type, so a place read through a
# readonly pointer and a temporary meet in one type.
armRefLeaf: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    text: StringView
    textF: cfacts
    facts: cfacts.borrow
} out String is {
    lf: armValueNode :ast :n
    lt: bindingStampOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: lf))
    ct: typeRefC :ast :reg :typing :ctx tid: lt
    # a Set or Map value is its own reference: a place arm yields the pointer, an
    # owned one parks it
    heap: isHeapPtrCollection :reg :typing :ctx tid: lt
    if heap when (armLeafIsPlace :ast :reg :typing :ctx :n) then return (
        stating
        :facts
        from: textF
        text: text.string
    )
    if (armLeafIsPlace :ast :reg :typing :ctx :n) then {
        # a `.borrow` of a name reads that name's storage, as the bare name does
        under: rhsBorrowMarkerBase :ast :reg :typing n: (ast.nodes.get i: lf)
        baseN: if under.isZero then lf else under
        pv: atomVid :typing nid: (atomNodeId n: (ast.nodes.get i: baseN))
        if pv.notZero when (isPtrVid :ctx vid: pv) then {
            return (
                stating
                :facts
                from: (operandFacts e: textF place: false)
                text: "((\{ct}*)(\{text}))"
            )
        }
        return (stating :facts from: (addrFacts e: textF) text: "((\{ct}*)&(\{text}))")
    }
    # declared zero by the statement and assigned where the arm runs
    nm: argHoistName :ast :reg :typing :ctx argNid: lf fallback: "_ah"
    dt: String
    if (hoistOwes :typing argNid: lf ptr: false) then dt = (
        hoistDestroyLine
        :reg
        :typing
        :ctx
        tid: lt
        nm: nm.stringView
    )
    ph: (
        ArgHoist
        name: nm.copy
        val: String
        ctype: (hoistCtype :ast :reg :typing :ctx tid: lt ptr: false)
        dtor: dt
    )
    if ctx.armRefDepth > 0 then {
        ctx.armParks.append ph
    } else {
        ctx.argHoists.append ph
    }
    if heap then {
        return (stating :facts from: callFacts text: "(\{nm} = \{text}, \{nm})")
    }
    return (stating :facts from: callFacts text: "(\{nm} = \{text}, &\{nm})")
}

# appendArmAssign -- an arm's value assigned to the local its control value binds,
# `target = v;` -- or, when the target is the pointer a reference control value
# builds (emitControlPtrExpr), the arm's address (armRefLeaf).
appendArmAssign: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    target: StringView
    vx: StringView
    vxF: cfacts
    ind: StringView
    buf: String.borrow
} is {
    if ctx.armRefCv > 0 then {
        rn: "_cv\{ctx.armRefCv - 1}"
        if target == rn then {
            raF: cfacts
            ra: armRefLeaf :ast :reg :typing :ctx :n text: vx textF: vxF facts: raF
            buf.append "\{ind}\{target} = \{ra};\n"
            return
        }
    }
    buf.append "\{ind}\{target} = \{vx};\n"
}

# emitControlPtrExpr -- a reference control value run as statements ahead of the
# statement it is in (emitControlExpr): a pointer local its arms assign with
# addresses (appendArmAssign), read where the value is. The temporaries its arms
# park values in are declared by the statement around the outermost one, ahead
# of the arms that assign them, and released at its end.
emitControlPtrExpr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out String is {
    nid: zast.nodeIdOf :n
    vt: bindingStampOf :typing nid: (controlValueStampNid :ast :reg :typing :n)
    ct: typeRefC :ast :reg :typing :ctx tid: vt
    if (ct.length == 0) or (ztypecheck.armLeaves :ast :n inLoop: false) then return "".string
    settleAhead :ast :reg :typing :ctx
    ltmp: TmpCtr n: 0 listFrees: List OwedFree
    cvN: tmpNext :ctx tmp: ltmp
    cv: "_cv\{cvN}"
    pct: "\{ct}*"
    lbuf: String
    outer: openControlArms :ctx
    outerCv: ctx.armRefCv
    ctx.armRefCv = cvN + 1
    ctx.armRefDepth = ctx.armRefDepth + 1
    (
        emitControlBindValue
        :ast
        :reg
        :typing
        :ctx
        vid: nid
        rtid: vt
        nm: cv.stringView
        ct: pct.stringView
        ind: ""
        tmp: ltmp
        buf: lbuf
    )
    flushBlockFrees tmp: ltmp lL: 0 diverged: false buf: lbuf
    ctx.armRefDepth = ctx.armRefDepth - 1
    ctx.armRefCv = outerCv
    closeControlArms :ctx :outer
    if ctx.armRefDepth == 0 then {
        for ctx.armParks.length > 0 loop ctx.argHoists.append ctx.armParks.pop
    }
    recordRawHoist :ctx text: lbuf
    return cv
}

# armsmark -- what a control value's arms set aside while they are built: the
# hoist floors, the guard depth and the order floor of the statement around it.
armsmark: record {
    floor: u64
    rawFloor: u64
    guards: u64
    seqFloor: u64
}

# openControlArms -- a control value's arms are about to be built: they are
# statements of their own, so the hoists they record are theirs, they run on
# every path through them, and settleAhead inside them reaches only the parts
# they build.
openControlArms: function {ctx: Ctx} out armsmark is {
    m: (
        armsmark
        floor: ctx.argHoistFloor
        rawFloor: ctx.argHoistRawFloor
        guards: ctx.guardDepth
        seqFloor: ctx.orderSeqFloor
    )
    ctx.argHoistFloor = ctx.argHoists.length
    ctx.argHoistRawFloor = ctx.argHoistRaw.length
    ctx.guardDepth = 0
    ctx.orderSeqFloor = ctx.orderSeq
    return m
}

# closeControlArms -- end what openControlArms began.
closeControlArms: function {ctx: Ctx outer: armsmark} is {
    ctx.argHoistFloor = outer.floor
    ctx.argHoistRawFloor = outer.rawFloor
    ctx.guardDepth = outer.guards
    ctx.orderSeqFloor = outer.seqFloor
}

# emitControlExpr -- an `if`, a `match` or a `with` used inside an expression (an
# argument, an operand, an interpolation part, a condition, a returned value)
# that no C expression spells: a match, or an if whose arms are blocks. ISO C
# has no statements inside an expression, so it runs as statements AHEAD of the
# statement it is in -- a raw hoist that declares the value, runs the if or the
# match assigning it and releases what that owed -- and the expression reads
# the value. What the statement evaluates before it is made statements first
# (settleAhead). A condition holding one is stepped (condsNeedSteps), and a
# ternary holding one becomes one, so it never sits where it would run only on
# some paths. Its temps count on from the function's, and the argument hoists
# already pending around it stay pending for the statement that declares them.
emitControlExpr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out String is {
    nid: zast.nodeIdOf :n
    # a generic body's value is typed by the instance being emitted
    vt: bindingStampOf :typing nid: (controlValueStampNid :ast :reg :typing :n)
    ct: typeRefC :ast :reg :typing :ctx tid: vt
    if ct.length > 0 when (isHeapPtrCollection :reg :typing :ctx tid: vt) then ct = "\{ct}*"
    # "" when there is no C type, or when an arm leaves from here, which the
    # checker refuses: its cleanup could not reach the values the enclosing
    # statement is building
    if (ct.length == 0) or (ztypecheck.armLeaves :ast :n inLoop: false) then return "".string
    settleAhead :ast :reg :typing :ctx
    ltmp: TmpCtr n: 0 listFrees: List OwedFree
    cvN: tmpNext :ctx tmp: ltmp
    cv: "_cv\{cvN}"
    lbuf: String
    outer: openControlArms :ctx
    (
        emitControlBindValue
        :ast
        :reg
        :typing
        :ctx
        vid: nid
        rtid: vt
        nm: cv.stringView
        ct: ct.stringView
        ind: ""
        tmp: ltmp
        buf: lbuf
    )
    flushBlockFrees tmp: ltmp lL: 0 diverged: false buf: lbuf
    closeControlArms :ctx :outer
    recordRawHoist :ctx text: lbuf
    return cv
}

# emitOperatorAt -- emit a binary operator by asking what it RESOLVED to,
# never what it was spelled. The type checker recorded the type that declares
# the operator and the method it found; from those the operator is one of
# three things, and the operator's text is a lookup key rather than a branch:
#
#   the author wrote it   -- an ordinary method call, negated for an inequality
#                            derived from a declared equality
#   the runtime owns it   -- a row, keyed by qualified path
#   nobody declared it    -- the synthesised structural compare, keyed by the
#                            shape the emitter would otherwise have built
#
# The receiver-shape derivations stay here because they choose WHICH row
# applies and what its operands look like; the C itself lives in the table.
# The infix form and the call form (`a.+ rhs: b`) are the SAME one-argument
# method, so they emit through here alike; only the node ids differ. The leg
# that answers builds the operands, because it decides their form, and builds
# them in the order they are written.
emitOperatorAt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    lineno: u32
    opId: zast.nameid
    owner: ztypes.tid
    method: ztypes.tid
    lhsNid: zast.nodeid
    rhsNid: zast.nodeid
    op: StringView
    facts: cfacts.borrow
} out String is {
    if owner.isZero then {
        emitFail :ctx what: "operator '\{op}' resolved no declaring type" line: lineno
        return (
            stating
            :facts
            from: failedFacts
            text: "0".string
        )
    }
    # a local: the derived-comparison leg below reassigns it
    call: method
    callName: opId
    neg: false
    # A DECLARED COMPARISON BEATS A SYNTHESISED ONE, IN EITHER DIRECTION. The
    # pair is generated per name now, so a type writing only `==` HAS a synth
    # `!=` member -- and taking it would silently give the STRUCTURAL answer
    # while `==` said something else. `!=` therefore prefers a declared `==`
    # and negates it, `==` prefers a declared `!=` and negates that, and only
    # when neither is written does the structural row answer. This also covers
    # `call.isZero`, the case where the member does not exist at all.
    mineSyn: true
    if call.notZero then {
        mineSyn = typing.declMemberIsSynth parentTypeId: owner nameId: opId
    }
    if mineSyn then {
        otherId: zast.wellKnown.slot.wkOpEq
        if opId == zast.wellKnown.slot.wkOpEq then otherId = zast.wellKnown.slot.wkOpNe
        oo9: typing.declChildOfId parentTypeId: owner nameId: otherId
        if oo9.some when (typing.declMemberIsSynth parentTypeId: owner nameId: otherId).not then {
            call = oo9
            callName = otherId
            neg = true
        }
    }
    isNat: false
    isSyn: false
    if call.notZero then {
        isNat = reg.isNativeOf tid: call
        isSyn = typing.declMemberIsSynth parentTypeId: owner nameId: callName
    }
    if (isListCompare :reg :ctx :owner :opId) then {
        return (
            emitListEqOperator
            :ast
            :reg
            :typing
            :ctx
            :owner
            :lhsNid
            :rhsNid
            neg: opId == zast.wellKnown.slot.wkOpNe
            :facts
        )
    }
    if call.notZero when isNat.not when isSyn.not then {
        return (
            emitDeclaredOperator
            :ast
            :reg
            :typing
            :ctx
            :owner
            :call
            :callName
            :lhsNid
            :rhsNid
            :neg
            :facts
        )
    }
    return (
        emitOperatorByRow
        :ast
        :reg
        :typing
        :ctx
        :lineno
        :opId
        :owner
        :isNat
        :lhsNid
        :rhsNid
        :facts
    )
}

# emitOperatorByRow -- operator `opId` on `owner` through its row: the native
# operator's row keyed by the operator as written (a derived comparison's
# declared partner is not the row's), else the structural row of the type's
# shape; its constant-operand variant when the right operand is a constant the
# variant takes
emitOperatorByRow: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    lineno: u32
    opId: zast.nameid
    owner: ztypes.tid
    # the operator's declaration is native
    isNat: bool
    lhsNid: zast.nodeid
    rhsNid: zast.nodeid
    facts: cfacts.borrow
} out String is {
    row: u64
    rowKey: zemitrows.rowname impl: 0 typeName: zast.nameid.zero name: zast.nameid.zero
    label: String
    if isNat then {
        rowKey = rowNameOfMember :reg :typing :ctx :owner name: opId
        row = ctx.rows.ofName n: rowKey
        label = rowLabel :ctx :ast n: rowKey
    } else {
        sk: zemitrows.shapekey shape: (rowShapeOf :ast :reg :typing :ctx :owner) op: opId
        row = ctx.rows.ofShape k: sk
        label = shapeLabel :ast k: sk
    }
    body: rtid
    if row > 0 then body = rowBody :ctx :row
    if body.isZero then {
        emitFail :ctx what: "no native implementation for '\{label}'" line: lineno
        return (
            stating
            :facts
            from: failedFacts
            text: "0".string
        )
    }
    # A CONSTANT ARGUMENT MAY SELECT A DIFFERENT ROW. The table says which
    # positions a variant needs to be constant and the checker's value channel
    # says whether they are; neither the operator's spelling nor its meaning is
    # consulted here, so the C stays in the table where f34ecd07 put it.
    # the stamp is asked FIRST: it is a plain id lookup, where reaching the
    # table means building a key from a view. Most operands are not constants,
    # and those never touch the table at all.
    constRow: false
    rhsConst: typing.nodeConstAt nid: rhsNid
    if rhsConst.isConst then {
        ieee: zeroDivisionC :typing :owner :opId :lhsNid rhs: rhsConst
        if ieee.length > 0 then return (stating :facts from: constFacts text: ieee)
        crow: ctx.rows.constOfName n: rowKey
        # a binop HAS only argument 1, so a variant asking for any other
        # position cannot be satisfied by one and is not selected
        if crow > 0 when (ctx.rows.rows.get i: crow).constMask == 1 then {
            body = rowBody :ctx row: crow
            constRow = true
        }
    }
    return (
        emitOperatorRow
        :ast
        :reg
        :typing
        :ctx
        :owner
        :row
        :label
        :body
        :constRow
        :lhsNid
        :rhsNid
        :facts
    )
}

# zeroDivisionC -- an f32 or f64 division whose operands are both constants and
# whose divisor is zero. The checker leaves it unfolded -- neither an infinity
# nor a NaN has a literal -- and IEEE answers it where it runs. But a C compiler
# folds a division of two constants itself, and MSVC refuses one by zero
# (C2124), so the answer is spelled instead: for a zero dividend the NaN an
# x86-64 division gives (sign set, quiet), by its bits -- math.h's NAN has the
# sign clear under glibc and set under MSVC -- else math.h's INFINITY, negative
# when exactly one operand is. "" for any other operation.
zeroDivisionC: function {
    typing: ztyping.ZTyping.view
    # the operator's declaring type
    owner: ztypes.tid
    # the operator's name
    opId: zast.nameid
    lhsNid: zast.nodeid
    # the divisor's constant, known to be one
    rhs: ztypes.cval
} out String is {
    if opId != zast.wellKnown.slot.wkOpDiv then return "".string
    nk: (
        ztypecheck.numKindOfTid
        :typing
        tid: (ztypecheck.typedefChaseTid :typing tid: owner)
    )
    if nk.has.not then return "".string
    ct: ""
    nan: ""
    if nk.kind.f64Type then {
        ct = "double"
        nan = "(((union { uint64_t u; double f; }){ .u = 0xFFF8000000000000ULL }).f)"
    } else if nk.kind.f32Type then {
        ct = "float"
        nan = "(((union { uint32_t u; float f; }){ .u = 0xFFC00000u }).f)"
    } else {
        return "".string
    }
    if (typing.constIsZero v: rhs).not then return "".string
    lhs: typing.nodeConstAt nid: lhsNid
    if lhs.kind.none then return "".string
    if (typing.constIsZero v: lhs) then return nan.string
    if (constIsNegative v: lhs) != (constIsNegative v: rhs) then return "(-(\{ct})INFINITY)"
    return "((\{ct})INFINITY)"
}

# constIsNegative -- a numeric constant whose sign bit is set: -0.0 counts, as
# IEEE's division by zero reads it.
constIsNegative: function {v: ztypes.cval} out bool is {
    if v.kind.ivalKind then return v.ival < 0
    if v.kind.fvalKind then return (v.fval.bits >> 63) == 1
    return false
}

# emitOperatorRow -- a native operator's row `body`, keyed `key`:
# its two operands built in written order, in the form the row takes them, its
# holes filled, and its facts stated -- a value row's from its operands, any
# other row's a call's. The plain row's needs are fired unless `body` is its
# constant-operand variant's, which calls nothing they supply.
emitOperatorRow: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    owner: ztypes.tid
    # the plain row, whose flags hold for its constant-operand variant too
    row: u64
    # the row as a failure names it
    label: String
    body: rtid
    constRow: bool
    lhsNid: zast.nodeid
    rhsNid: zast.nodeid
    facts: cfacts.borrow
} out String is {
    r: ctx.rows.rows.get i: row
    if constRow.not then rowNeedsAdd :ctx :row cond: condAlways
    ord: orderBegin :ctx slots: 2
    lh: rtHoleId slot: rtHole.slot.holeL
    rh: rtHoleId slot: rtHole.slot.holeR
    if (rtTwice :ctx id: body hole: lh) then orderNamesTwice st: ord slot: 0
    if (rtTwice :ctx id: body hole: rh) then orderNamesTwice st: ord slot: 1
    lhsF: cfacts
    (
        orderRowOperand
        :ast
        :reg
        :typing
        :ctx
        :owner
        byPtr: r.byPointer
        nid: lhsNid
        slot: 0
        :ord
        opF: lhsF
    )
    rhsF: cfacts
    (
        orderRowOperand
        :ast
        :reg
        :typing
        :ctx
        :owner
        byPtr: r.byPointer
        nid: rhsNid
        slot: 1
        :ord
        opF: rhsF
    )
    oprefix: orderFinish :ctx st: ord
    # a typedef emits no helper of its own: the chain end owns it
    tcnTid: owner
    if (typedefChaseHasBaseName :typing tid: owner) then {
        tcnTid = ztypecheck.typedefChaseTid :typing tid: owner
    }
    if r.callsEquals then noteEqUse :ast :reg :typing :ctx tid: tcnTid
    filled: fillOperatorRow :ast :reg :typing :ctx :ord :body :label :tcnTid
    # a value row with no temps ahead of it reads as its operands do
    if oprefix.length == 0 when r.value then {
        return (stating :facts from: (valueFacts a: lhsF b: rhsF) text: filled)
    }
    return (stating :facts from: callFacts text: (orderWrap prefix: oprefix call: filled))
}

# fillOperatorRow -- a native operator row's C: its holes filled from the
# owner's cname and the two operands built in `ord`, through the four binding
# lists borrowed from the context. The names are fixed, the owner's cname and
# the operands move in, and nothing is copied.
fillOperatorRow: function {
    # the arm names
    ast: Ast.view
    # the checked program the row's canons resolve in
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    ord: orderstate
    body: rtid
    # the row as a failure names it
    label: String
    tcnTid: ztypes.tid
} out String is {
    bn: ListVal zast.nameid
    bv: List String
    rn: ListVal zast.nameid
    rv: List String
    bn swap ctx.opBindIds
    bv swap ctx.opBindVals
    rn swap ctx.opRawIds
    rv swap ctx.opRawVals
    if bn.length == 0 then {
        bn.append (rtHoleId slot: rtHole.slot.holeStringView)
        bn.append (rtHoleId slot: rtHole.slot.holeT)
        bv.append from: ctx.svC.copy
        bv.append from: String
        rn.append (rtHoleId slot: rtHole.slot.holeL)
        rn.append (rtHoleId slot: rtHole.slot.holeR)
        rv.append from: String
        rv.append from: String
    }
    # every row is offered both bindings; only a hole its body holds spells the
    # type, so only that records it (a `bool ==` row spells neither)
    if (rtHas :ctx id: body slot: rtHole.slot.holeStringView) then {
        preludeNeed :ctx memb: "@StringView_t"
    }
    tcnC: String
    if (rtHas :ctx id: body slot: rtHole.slot.holeT) then {
        tcnC = spelledCname :ctx tid: tcnTid
    }
    bv.set i: 1 val: tcnC
    rv.set i: 0 val: (ctx.orderVals.set i: ord.valBase val: String)
    rv.set i: 1 val: (ctx.orderVals.set i: ord.valBase + 1 val: String)
    orderEnd :ctx st: ord
    filled: (
        rtFillForCtx
        :ast
        :reg
        :typing
        :ctx
        id: body
        path: label.stringView
        bindIds: bn
        bindVals: bv
        rawIds: rn
        rawVals: rv
    )
    bn swap ctx.opBindIds
    bv swap ctx.opBindVals
    rn swap ctx.opRawIds
    rv swap ctx.opRawVals
    return filled
}

# operandValueC -- an operator's operand as a VALUE, which is what valueExprC
# gives and emitExpr does not: a Box is loaded, and so is a pointer-held valtype.
# With plain emitExpr a `.view` valtype parameter reaches the C as its POINTER and
# `z_v2 + 1ULL` adds one to an address.
operandValueC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nid: zast.nodeid
    facts: cfacts.borrow
} out String is {
    n: ast.nodes.get i: nid
    vF: cfacts
    v: valueExprC :ast :reg :typing :ctx :n facts: vF
    if (nodeIsAtomBox :reg :typing :n) then {
        # a by-pointer PARAMETER holds the box through a second pointer, so its
        # value is two derefs away: one for the parameter, one for the box. With
        # one, `b + 0` added to an address and `b == 7` compared one.
        if (isPtrVid :ctx vid: (atomVid :typing :nid)) then {
            return (stating :facts from: (operandFacts e: vF place: true) text: "(*(*\{v}))")
        }
        return (stating :facts from: (operandFacts e: vF place: true) text: "(*\{v})")
    }
    return (stating :facts from: vF text: v)
}

# orderRowOperand -- one operand of an operator's row, in the form
# the row takes it, placed in evaluation order into `slot`. String and
# StringView reach one native: both project to a view, by value for the
# compares and as an lvalue for the row that takes pointers.
orderRowOperand: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    owner: ztypes.tid
    # the row takes its operands by pointer
    byPtr: bool
    nid: zast.nodeid
    slot: u64
    ord: orderstate.borrow
    # the operand's facts as the slot holds it: a string operand's projection
    # is taken for a call's result
    opF: cfacts.borrow
} is {
    mk: pendingHoistMark :ctx
    vF: cfacts
    v: operandValueC :ast :reg :typing :ctx :nid facts: vF
    n: ast.nodes.get i: nid
    if (isStringOrViewLaid :ctx tid: owner).not then {
        stateFacts facts: opF from: vF
        constant: orderConstantWith :ast :typing :ctx :n tf: vF byPtr: false
        (
            orderPartWith
            :ast
            :reg
            :typing
            :ctx
            st: ord
            mark: mk
            text: v
            tf: vF
            :constant
            fid: ztypes.tid
            pid: ztypes.tid.zero
            pname: zast.nameid
            ctype: ""
            :slot
            valueNid: nid
        )
        return
    }
    if byPtr then {
        pfF: cfacts
        pf: stringViewBinopOperand :ast :reg :typing :ctx :n expr: v.stringView exprF: vF facts: pfF
        stateFacts facts: opF from: callFacts
        (
            orderArgAtWith
            :ast
            :reg
            :typing
            :ctx
            st: ord
            mark: mk
            text: pf
            tf: pfF
            :nid
            byPtr: false
            :slot
        )
        return
    } else {
        q: atomVidIfPlain :ast :reg :typing :ctx :n text: v.stringView
        vf: (
            svValueFormAt
            :ast
            :reg
            :typing
            :ctx
            :n
            expr: v.stringView
            isStr: (operandIsStr :reg :typing :ctx :n)
            vid: q
            facts: vF
        )
        stateFacts facts: opF from: callFacts
        (
            orderArgAtWith
            :ast
            :reg
            :typing
            :ctx
            st: ord
            mark: mk
            text: vf
            tf: vF
            :nid
            byPtr: false
            :slot
        )
        return
    }
}

# operandIsStr -- a string operand is a String, not a view: a String typedef
# (Path) included, since it shares the String struct and its projection to a
# view (chaseStrTypedef). `tname` is the operand's deep stamp name, which
# answers where the id route has none (a shell method's result).
operandIsStr: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out bool is {
    return (chaseStrTypedef :typing :ctx tid: (stampIdDeep :reg :typing :n)) == ctx.strTid
}

# operandScalarC -- the C type of an operand whose stamp is a builtin scalar or
# an ordinal variant; "" for anything else, a Box or a generic parameter among
# them.
operandScalarC: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view n: astnode.view
} out String is {
    st: stampIdDeep :reg :typing :n
    if st.isZero then return "".string
    return (scalarCTypeFor :typing tid: st)
}

# emitDeclaredOperator -- an operator whose body the author wrote: the method
# called on the lhs, which it takes by pointer like every other method, negated
# when the method is the comparison partner. AN INTERFACE RECEIVER DISPATCHES:
# the C name of the method resolved for an interface names the SPEC member, a
# declaration with no body, so the call goes through the vtable the named call
# form uses. The lhs is built before the rhs and handed on by address, so the
# body sees it as it is once the rhs has run.
emitDeclaredOperator: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    owner: ztypes.tid
    call: ztypes.tid
    callName: zast.nameid
    lhsNid: zast.nodeid
    rhsNid: zast.nodeid
    neg: bool
    facts: cfacts.borrow
} out String is {
    ord: orderBegin :ctx slots: 2
    mk: pendingHoistMark :ctx
    recv: String
    recvF: cfacts
    # the place `recv` addresses, "" when the receiver is a pointer already
    recvPlace: String
    if (pathIsPointer :ast :reg :typing :ctx n: (ast.nodes.get i: lhsNid)) then {
        recv = emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: lhsNid) facts: recvF
    } else {
        # `&` needs an LVALUE, and a receiver that is itself a call is not one --
        # `&f(x)` is rejected by C. It is bound to a temp as a method call's
        # receiver is (receiverOnceAt), so an OWNED result is released with it;
        # a compound literal already is an lvalue.
        lvF: cfacts
        lv: operandValueC :ast :reg :typing :ctx nid: lhsNid facts: lvF
        if lvF.literal then {
            recv = "&\{lv}"
            recvF = addrFacts e: lvF
            recvPlace = lv.take
        } else {
            lf: (
                receiverOnceAt
                :ast
                :reg
                :typing
                :ctx
                baseNid: lhsNid
                text: lv.stringView
                textF: lvF
                tid: owner
            )
            recv = "&\{lf}"
            recvF = addrFacts e: (if lvF.place then lvF else pathFacts)
            recvPlace = lf.take
        }
    }
    (
        orderArgAtWith
        :ast
        :reg
        :typing
        :ctx
        st: ord
        mark: mk
        text: recv
        tf: recvF
        nid: lhsNid
        byPtr: true
        slot: 0
    )
    mkR: pendingHoistMark :ctx
    rvF: cfacts
    rv: operatorOperandText :ast :reg :typing :ctx :call :rhsNid facts: rvF
    (
        orderArgAtWith
        :ast
        :reg
        :typing
        :ctx
        st: ord
        mark: mkR
        text: rv
        tf: rvF
        nid: rhsNid
        byPtr: ctx.lastArgByPtr
        slot: 1
    )
    r: orderFinish :ctx st: ord
    opened: r.length > 0
    if neg then r.append "!"
    if (isDispatchableTid :reg tid: owner) then {
        isFacet: (reg.typetypeOf typeId: owner) == ztypes.ztypetype.facetType
        sl: memberC :ast :reg :typing :ctx :owner kind: memberkind.slot nameId: callName
        # the ordering pass kept the address as written, or read it into a temp,
        # whose name is a place
        rs0: orderSlotText t: ctx st: ord slot: 0
        if (orderSlotFacts t: ctx st: ord slot: 0).place then recvPlace = "".string
        (
            appendVtableOperator
            buf: r
            recv: rs0
            place: recvPlace.stringView
            arg: (orderSlotText t: ctx st: ord slot: 1)
            slot: sl.stringView
            :isFacet
        )
    } else {
        cn: spelledCname :ctx tid: call
        r.append cn
        r.append "("
        r.append (orderSlotText t: ctx st: ord slot: 0)
        r.append ", "
        r.append (orderSlotText t: ctx st: ord slot: 1)
        r.append ")"
    }
    if opened then r.append ")"
    orderEnd :ctx st: ord
    return (stating :facts from: callFacts text: r)
}

# operatorOperandText -- a declared operator's right operand, passed as its
# parameter -- the operator's one besides the receiver -- takes it, by the rule
# a method argument is passed by (passMethodArg). Sets ctx.lastArgByPtr.
operatorOperandText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: ztypes.tid
    rhsNid: zast.nodeid
    facts: cfacts.borrow
} out String is {
    avF: cfacts
    av: operandValueC :ast :reg :typing :ctx nid: rhsNid facts: avF
    ctx.lastArgByPtr = false
    # the receiver by its name id, `this` for the `:this` shorthand; every other
    # row of a function type is a parameter
    recvId: reg.thisParamNameIdOf tid: call
    if recvId.isZero then recvId = zast.wellKnown.slot.wkThis
    ri: u64
    nRows: typing.declRowSlots ownerTid: call
    for ri < nRows loop {
        rw: typing.declRowAt ownerTid: call membersOnly: true slot: ri
        ri = ri + 1
        if rw.keep.not or (rw.name == recvId) then continue
        ptr: (
            instanceMethodArgPtr
            :ast
            :reg
            :typing
            :ctx
            mco: call
            posParamNameId: rw.name
            posParamId: rw.tid
            usedInterp: false
            av: av.stringView
            avNd: rhsNid
        )
        txt: String
        txtF: cfacts
        (
            passMethodArg
            :ast
            :reg
            :typing
            :ctx
            :ptr
            avNd: rhsNid
            usedInterp: false
            posParamId: rw.tid
            :av
            :avF
            args: txt
            facts: txtF
        )
        return (stating :facts from: txtF text: txt)
    }
    return (stating :facts from: avF text: av)
}

# isListCompare -- `==` or `!=` on a ListVal, which its mono's generated
# comparator answers.
isListCompare: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx
    owner: ztypes.tid
    opId: zast.nameid
} out bool is {
    isCmp: (opId == zast.wellKnown.slot.wkOpEq) or (opId == zast.wellKnown.slot.wkOpNe)
    if isCmp.not then return false
    return (originIsTid :reg tid: owner originTid: (ctx.origins.get i: family.slot.listVal))
}

# emitListEqOperator -- a ListVal `==` (or its negation): the mono's `_eq`
# over the two lists' addresses.
emitListEqOperator: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    owner: ztypes.tid
    lhsNid: zast.nodeid
    rhsNid: zast.nodeid
    neg: bool
    facts: cfacts.borrow
} out String is {
    ord: orderBegin :ctx slots: 2
    mk: pendingHoistMark :ctx
    laF: cfacts
    la: listOperandAddr :ast :reg :typing :ctx nid: lhsNid tid: owner facts: laF
    (
        orderArgAtWith
        :ast
        :reg
        :typing
        :ctx
        st: ord
        mark: mk
        text: la
        tf: laF
        nid: lhsNid
        byPtr: true
        slot: 0
    )
    mkR: pendingHoistMark :ctx
    raF: cfacts
    ra: listOperandAddr :ast :reg :typing :ctx nid: rhsNid tid: owner facts: raF
    (
        orderArgAtWith
        :ast
        :reg
        :typing
        :ctx
        st: ord
        mark: mkR
        text: ra
        tf: raF
        nid: rhsNid
        byPtr: true
        slot: 1
    )
    r: orderFinish :ctx st: ord
    opened: r.length > 0
    if neg then r.append "!"
    noteMemberUse :ctx mono: owner member: memberWord.slot.eq
    r.append (spelledCname :ctx tid: owner)
    r.append "_eq("
    r.append (orderSlotText t: ctx st: ord slot: 0)
    r.append ", "
    r.append (orderSlotText t: ctx st: ord slot: 1)
    r.append ")"
    if opened then r.append ")"
    orderEnd :ctx st: ord
    return (stating :facts from: callFacts text: r)
}

# listOperandAddr -- the address of a list operand; a list already held by
# pointer is its own. One that is a call's result is bound to a temp as a
# receiver is (receiverOnceAt), so an owned list is released with it.
listOperandAddr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nid: zast.nodeid
    tid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    if (pathIsPointer :ast :reg :typing :ctx n: (ast.nodes.get i: nid)) then {
        return (emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: nid) :facts)
    }
    lvF: cfacts
    lv: operandValueC :ast :reg :typing :ctx :nid facts: lvF
    if lvF.literal then return (stating :facts from: (addrFacts e: lvF) text: "&\{lv}")
    lf: receiverOnceAt :ast :reg :typing :ctx baseNid: nid text: lv.stringView textF: lvF :tid
    # the operand's own place, or the temp a value was bound to
    return (
        stating
        :facts
        from: (addrFacts e: (if lvF.place then lvF else pathFacts))
        text: "&\{lf}"
    )
}

# appendVtableOperator -- an operator dispatched through an interface's vtable,
# whose receiver arrives as an address: the address of `place`, when the caller
# names it, is read through the place, any other pointer through `->`. The slot is named by the member that resolved, not
# by the operator as written: a derived `!=` dispatches `==`.
appendVtableOperator: function {
    buf: String.borrow
    recv: StringView
    # the place `recv` is the address of, "" when it is a pointer
    place: StringView
    arg: StringView
    # the slot's C name (memberC)
    slot: StringView
    isFacet: bool
} is {
    rp: String
    acc: "->"
    if place.length > 0 then {
        rp.append place
        acc = "."
    } else {
        rp.append "("
        rp.append recv
        rp.append ")"
    }
    tail: ", \{arg}"
    buf.append (vtableCallC recv: rp.stringView :acc :slot :isFacet argTail: tail.stringView)
}

# emitInterpPrint -- the interpolated-print temp chain: create, per-part
# append (literal bytes or snprintf-formatted scalar), print, free.
emitInterpPrint: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    parts: zast.kidspan
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    # the interpolated literal's own node, 0 when unknown here
    strNid: zast.nodeid.zero
} is {
    unusedOps: String
    sNm: emitInterpBuild :ast :reg :typing :ctx :parts :ind :tmp :buf :strNid ops: unusedOps
    preludeNeed :ctx memb: "@String_print"
    l1: "\{ind}\{ctx.strC}_print(&\{sNm});\n"
    buf.append l1
    if (scopeOwnsTemp :typing argNid: strNid) then {
        preludeNeed :ctx memb: "@String_free"
        l2: "\{ind}\{ctx.strC}_free(&\{sNm});\n"
        buf.append l2
    }
}

# emitInterpBuild -- the create/append chain for an interpolated literal;
# answers the buffer's C NAME, which the caller prints, frees or binds. The
# name is the checker's temporary for the literal (`tempOf` keyed by the
# atomstring node), so the string the emitter assembles and the value the
# checker reasons about are one variable.
emitInterpBuild: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    parts: zast.kidspan
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    # the interpolated literal's own node when the buffer IS the value the
    # checker holds a temporary for -- a print's argument. 0 when the buffer is
    # an inner detail: a statement expression assigns it to a hoist outside the
    # block, and that hoist is what carries the checker's name
    strNid: zast.nodeid.zero
    # the build is used as a value: its steps are operands on `ops`
    expr: false
    ops: String.borrow
} out String is {
    est: u64
    for each pId: (zast.kidsOf :ast span: parts) loop {
        p: ast.nodes.get i: pId
        isC: false
        if p.stringchunk then {
            isC = true
            tl: (zast.literalTextAt :ast ref: p.text).length
            est = est + tl
        }
        if isC.not then est = est + 16
    }
    # `_s<n>` is this buffer's own prefix and nothing else mints one now, but it
    # numbers from `ctx.argHoistCtr` here rather than from the TmpCtr
    sNm: (
        argHoistName
        :ast
        :reg
        :typing
        :ctx
        argNid: strNid
        fallback: "_s"
    )
    strT: strTypeC :ctx
    preludeNeed :ctx memb: "@String_create"
    cr: "\{ctx.strC}_create((uint64_t)\{est})"
    (
        interpLocal
        :ctx
        :expr
        ctype: strT.stringView
        name: sNm.stringView
        init: cr.stringView
        :ind
        :buf
        :ops
    )
    for each qId: (zast.kidsOf :ast span: parts) loop {
        (
            emitInterpPart
            :ast
            :reg
            :typing
            :ctx
            n: (ast.nodes.get i: qId)
            sNm: sNm.stringView
            :expr
            :ind
            :tmp
            :buf
            :ops
        )
    }
    return sNm
}

# interpBaseIsMapEntry -- true when an interp part is `<entry>.key`/`.value`
# off a borrowed MapEntry: the projected String views the bucket, so it must
# be appended inline (freeing the hoisted copy would double-free the bucket
# key). All four entry forms project the same way.
interpBaseIsMapEntry: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case statementline then {
        return (interpBaseIsMapEntry :ctx :ast :reg :typing n: (ast.nodes.get i: n.statementline))
    } case dottedpath then {
        bnid: atomNodeId n: (ast.nodes.get i: n.parent)
        bt: stampIdOf :typing nid: bnid
        meT: ztypecheck.stdTidPeek :ast :typing wk: zast.wellKnown.slot.tyMapEntry
        if (originIsTid :reg tid: bt originTid: meT) then return true
        meRV: ztypecheck.stdTidPeek :ast :typing wk: zast.wellKnown.slot.tyMapEntryRV
        if (originIsTid :reg tid: bt originTid: meRV) then return true
        ideR: ztypecheck.stdTidPeek :ast :typing wk: zast.wellKnown.slot.tyIdMapEntryR
        if (originIsTid :reg tid: bt originTid: ideR) then return true
        ideV: ztypecheck.stdTidPeek :ast :typing wk: zast.wellKnown.slot.tyIdMapEntryV
        if (originIsTid :reg tid: bt originTid: ideV) then return true
        meVR: ztypecheck.stdTidPeek :ast :typing wk: zast.wellKnown.slot.tyMapEntryVR
        if (originIsTid :reg tid: bt originTid: meVR) then return true
        meVV: ztypecheck.stdTidPeek :ast :typing wk: zast.wellKnown.slot.tyMapEntryVV
        if (originIsTid :reg tid: bt originTid: meVV) then return true
        return false
    } else {
        return false
    }
}

# interpBaseIsOwnedStructField -- a `<inst>.field` read off a user record/class:
# the projected String VIEWS the owner's field (freed by the owner's destructor),
# so it appends inline -- freeing a hoisted copy would double-free the field.
interpBaseIsOwnedStructField: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case statementline then {
        sln: ast.nodes.get i: n.statementline
        return (interpBaseIsOwnedStructField :ast :reg :typing :ctx n: sln)
    } case dottedpath then {
        pnd: ast.nodes.get i: n.parent
        bnid: atomNodeId n: pnd
        # A NESTED base (`b.it.name`) is itself a dotted path, not an atom, so
        # the atom lookup answers 0; its own stamp names the owner just as
        # well. Without this the read falls
        # through to the owned-call-result leg, which FREES the field's String
        # out from under its owner.
        if bnid.isZero then bnid = interpPartNodeId n: pnd
        bt: stampIdOf :typing nid: bnid
        bo: originTidOf :reg tid: bt
        # a user-generic mono owns its fields once it carries a destructor;
        # other monos (views, collections) keep the owned-call-result legs
        if bo.notZero when (ownsResources :reg :ctx tid: bt).not then return false
        btt: reg.typetypeOf typeId: bt
        isUC: btt.isFieldwise
        if isUC.not then return false
        cn: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        co: typing.declChildOfId parentTypeId: bt nameId: cn
        match (
            co
        ) case some then {
            if (reg.typetypeOf typeId: co) == ztypes.ztypetype.functionType then {
                return false
            } else {
                return true
            }
        } case none then {
            return false
        }
    } else {
        return false
    }
}

# interpPartTid -- the type an interpolated part formats as: the deep stamp,
# with a typedef read as the type its chain ends at.
interpPartTid: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view n: astnode.view
} out ztypes.tid is {
    t: stampIdDeep :reg :typing :n
    return (ztypecheck.typedefChaseTid :typing tid: t)
}

# interpStep -- one step of an interpolation build: a statement on `buf` at
# `ind`, or, for a build used as a value (`expr`), an operand of its comma
# expression on `ops`.
interpStep: function {
    expr: bool
    text: StringView
    ind: StringView
    buf: String.borrow
    ops: String.borrow
} is {
    if expr then {
        ops.append text
        ops.append ", "
        return
    }
    buf.append ind
    buf.append text
    buf.append ";\n"
}

# interpLocal -- a local of C type `ctype` an interpolation build sets to
# `init`: declared on its line in a statement build; in a build used as a
# value, declared by the enclosing statement and assigned where the build
# runs. It owns nothing the build does not release.
interpLocal: function {
    ctx: Ctx
    expr: bool
    ctype: StringView
    name: StringView
    init: StringView
    ind: StringView
    buf: String.borrow
    ops: String.borrow
} is {
    if expr then {
        ctx.argHoists.append (
            ArgHoist
            name: name.string
            val: String
            ctype: ctype.string
            dtor: String
        )
        ops.append name
        ops.append " = "
        ops.append init
        ops.append ", "
        return
    }
    buf.append ind
    buf.append ctype
    buf.append " "
    buf.append name
    buf.append " = "
    buf.append init
    buf.append ";\n"
}

# interpBuffer -- the `size`-byte char buffer `_b<bN>` a number is formatted
# into, declared as interpLocal declares a local.
interpBuffer: function {
    ctx: Ctx
    expr: bool
    bN: u64
    size: u64
    ind: StringView
    buf: String.borrow
} is {
    arr: "_b\{bN}"
    arr.append "["
    appendDecimal buf: arr n: size
    arr.append "]"
    if expr then {
        ctx.argHoists.append (ArgHoist name: arr val: String ctype: "char".string dtor: String)
        return
    }
    buf.append "\{ind}char \{arr};\n"
}

# interpHoistsInPlace -- the hoists a part of a build used as a value recorded
# since `mark`: each is assigned where the part runs, ahead of its append, and
# a value it owns is released after the append (`rel`), so the statement
# declaring it owes it nothing. A raw hoist copies a constant list, which
# no order can change, and stays the statement's.
interpHoistsInPlace: function {ctx: Ctx mark: hoistmark ops: String.borrow rel: String.borrow} is {
    i: mark.names
    for i < ctx.argHoists.length loop {
        ph: ctx.argHoists.getMut :i
        if ph.val.length > 0 then {
            vl: String
            vl swap ph.val
            ops.append "\{ph.name} = \{vl}, "
        }
        if ph.dtor.length > 0 then {
            dl: String
            dl swap ph.dtor
            appendLinesAsOps ops: rel lines: dl.stringView
        }
        i = i + 1
    }
}

# appendLinesAsOps -- statement lines, each one call or assignment, as comma
# operands appended to `ops`, each followed by ", ".
appendLinesAsOps: function {ops: String.borrow lines: StringView} is {
    for each ln: (lines.split sep: "\n") loop {
        t: ln.trim
        if t.length > 0 then {
            if t.endsWith ";" then {
                ops.append (t.substring from: 0 to: t.length - 1)
            } else {
                ops.append t
            }
            ops.append ", "
        }
    }
}

# appendFormattedNum -- format a number into a stack buffer and append it: the
# `size`-byte buffer, `_b<bN>_n` set to `call`'s formatted length, then the
# append.
appendFormattedNum: function {
    ctx: Ctx
    # the string being built, and the temp counter value for the scalar buffer
    sNm: StringView
    bN: u64
    size: u64
    # the formatting call, which answers the length it wrote
    call: String
    expr: bool
    ind: StringView
    buf: String.borrow
    ops: String.borrow
} is {
    if expr then {
        interpBuffer :ctx :expr :bN :size :ind :buf
        nn: "_b\{bN}_n"
        interpLocal :ctx :expr ctype: "int" name: nn.stringView init: call.stringView :ind :buf :ops
        preludeNeed :ctx memb: "@String_append"
        st: "\{ctx.strC}_append(&\{sNm}, _b\{bN}, (uint64_t)_b\{bN}_n)"
        interpStep :expr text: st.stringView :ind :buf :ops
        return
    }
    # the statement form, written in place: the commonest part of all
    preludeNeed :ctx memb: "@String_append"
    buf.append ind
    buf.append "char _b"
    appendDecimal :buf n: bN
    buf.append "["
    appendDecimal :buf n: size
    buf.append "]; int _b"
    appendDecimal :buf n: bN
    buf.append "_n = "
    buf.append call
    buf.append ";\n"
    buf.append ind
    buf.append ctx.strC
    buf.append "_append(&"
    buf.append sNm
    buf.append ", _b"
    appendDecimal :buf n: bN
    buf.append ", (uint64_t)_b"
    appendDecimal :buf n: bN
    buf.append "_n);\n"
}

# appendViewPart -- append a StringView-typed part, a by-value operand (a
# pointer-passed view would need the String leg's accessor treatment). The
# value is read twice, for its data and its size, so one whose facts say a
# second read repeats work is bound to a temp first and read once.
appendViewPart: function {
    ctx: Ctx
    # the part's C text
    val: StringView
    valF: cfacts
    sNm: StringView
    expr: bool
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    ops: String.borrow
} is {
    rd: val.string
    if valF.once then {
        rd = "_h\{tmpNext :ctx :tmp}"
        svT: svTypeC :ctx
        interpLocal :ctx :expr ctype: svT.stringView name: rd.stringView init: val :ind :buf :ops
    }
    preludeNeed :ctx memb: "@String_append"
    st: "\{ctx.strC}_append(&\{sNm}, \{rd}.data, \{rd}.size)"
    interpStep :expr text: st.stringView :ind :buf :ops
}

# appendStrPart -- append a sized str part, read for its data and its length:
# bound to a temp first when a second read repeats work (a call's result).
appendStrPart: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    val: StringView
    valF: cfacts
    sNm: StringView
    expr: bool
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    ops: String.borrow
} is {
    rd: val.string
    if valF.once then {
        rd = "_h\{tmpNext :ctx :tmp}"
        stT: (
            chaseAggregateTypedef
            :reg
            :typing
            :ctx
            tid: (stampIdOf :typing nid: (interpPartNodeId :n))
        )
        stC: typeRefC :ast :reg :typing :ctx tid: stT
        interpLocal :ctx :expr ctype: stC.stringView name: rd.stringView init: val :ind :buf :ops
    }
    preludeNeed :ctx memb: "@String_append"
    st: "\{ctx.strC}_append(&\{sNm}, \{rd}.data, \{rd}.len)"
    interpStep :expr text: st.stringView :ind :buf :ops
}

# appendStringPart -- append a String-typed part. An atom (a borrowed String
# param is a pointer, so isBorrowStringParam's raw name reads through `->`),
# a map-entry deref or an owned struct field appends in place, unless reading it
# twice repeats work -- a field read off a load of a call's result; a
# borrow-returning call result (a shared element view) is hoisted for single
# evaluation and appended, the container owning the storage (the MapEntry
# exemption, generalized by the declared signature); an owned call result is
# hoisted, appended and freed.
appendStringPart: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    # the part's C text
    val: StringView
    valF: cfacts
    sNm: StringView
    expr: bool
    ind: StringView
    buf: String.borrow
    ops: String.borrow
} is {
    an0: atomTextOf :ast :n
    # an atom naming a FUNCTION is a call, whose String is a temporary
    localAtom: an0.length > 0
    if localAtom when (baseAtomNamesFunction :reg :typing :n) then localAtom = false
    isAtomP: (
        localAtom or
        (interpBaseIsMapEntry :ctx :ast :reg :typing :n) or
        (interpBaseIsOwnedStructField :ast :reg :typing :ctx :n)
    )
    if isAtomP when valF.once.not then {
        sAcc: ".".string
        if an0.length > 0 when (isPtrVid :ctx vid: (atomVid :typing nid: (atomNodeId :n))) then {
            sAcc = "->".string
        }
        # a String read through a borrowed field is a pointer with no variable
        # behind it
        if an0.length == 0 when (pathIsPointer :ast :reg :typing :ctx :n) then sAcc = "->".string
        preludeNeed :ctx memb: "@String_append"
        sa: "\{ctx.strC}_append(&\{sNm}, \{val}\{sAcc}data, \{val}\{sAcc}size)"
        interpStep :expr text: sa.stringView :ind :buf :ops
        return
    }
    # a fallback here may NOT be spelled `_h<n>`: that prefix is the TmpCtr's,
    # and this name comes from `ctx.argHoistCtr`, so two counters would collide
    hNm: argHoistName :ast :reg :typing :ctx argNid: (interpPartNodeId :n) fallback: "_hp"
    strT: strTypeC :ctx
    interpLocal :ctx :expr ctype: strT.stringView name: hNm.stringView init: val :ind :buf :ops
    preludeNeed :ctx memb: "@String_append"
    sh: "\{ctx.strC}_append(&\{sNm}, \{hNm}.data, \{hNm}.size)"
    interpStep :expr text: sh.stringView :ind :buf :ops
    if (scopeOwnsTemp :typing argNid: (interpPartNodeId :n)) then {
        preludeNeed :ctx memb: "@String_free"
        sf: "\{ctx.strC}_free(&\{hNm})"
        interpStep :expr text: sf.stringView :ind :buf :ops
    }
}

# interpPartIsInt -- an interpolated part that prints as an integer: an integer
# kind, or a tag, which prints as its number. A bool is not one: it prints its
# arm's name (interpBoolPart).
interpPartIsInt: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    nk: ztypes.suffixinfo
} out bool is {
    if nk.has then return (ztypes.isFloatKind k: nk.kind).not
    if tid.isZero then return false
    if (isOrdinalVariant :typing :tid) then return true
    return (reg.typetypeOf typeId: tid) == ztypes.ztypetype.tagType
}

# interpBoolPart -- an interpolated bool, appended as the name of the arm it holds
# (`true` or `false`, read off bool's declaration). The value is bound once:
# each interpolation part is evaluated exactly once.
interpBoolPart: function {
    # the arm names
    ast: Ast.view
    # the checked program declaring bool
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the emission context holding bool's tid
    ctx: Ctx
    # the bool's C expression
    val: StringView
    # the string being built
    sNm: StringView
    # the temp number for the part's locals
    bN: u64
    # the build is used as a value: its steps are operands on `ops`
    expr: bool
    # the statements' indent
    ind: StringView
    # the function body being written
    buf: String.borrow
    ops: String.borrow
} is {
    f: zast.nameTextAt :ast ref: (armIdAt :reg :typing tid: ctx.boolTid armOrd: 0)
    t: zast.nameTextAt :ast ref: (armIdAt :reg :typing tid: ctx.boolTid armOrd: 1)
    fl: f.length
    tl: t.length
    fq: "\"\{f}\""
    tq: "\"\{t}\""
    vn: "_v\{bN}"
    interpLocal :ctx :expr ctype: "bool" name: vn.stringView init: val :ind :buf :ops
    bn: "_b\{bN}"
    bi: "\{vn} ? \{tq} : \{fq}"
    (
        interpLocal
        :ctx
        :expr
        ctype: "const char*"
        name: bn.stringView
        init: bi.stringView
        :ind
        :buf
        :ops
    )
    nn: "_b\{bN}_n"
    ni: "\{vn} ? \{tl} : \{fl}"
    interpLocal :ctx :expr ctype: "int" name: nn.stringView init: ni.stringView :ind :buf :ops
    preludeNeed :ctx memb: "@String_append"
    st: "\{ctx.strC}_append(&\{sNm}, \{bn}, (uint64_t)\{nn})"
    interpStep :expr text: st.stringView :ind :buf :ops
}

# interpScalarPart -- an interpolated number or bool, formatted and appended
# to `sNm`: false when the part's type `pt` (with its numeric kind `nk`) is
# neither, and nothing is written.
interpScalarPart: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    pt: ztypes.tid
    nk: ztypes.suffixinfo
    val: StringView
    sNm: StringView
    expr: bool
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    ops: String.borrow
} out bool is {
    bN: tmpNext :ctx :tmp
    if nk.has when nk.kind == ztypes.numkind.i128Type then {
        needsAddM :ctx uname: "prelude" memb: "int128"
        preludeNeed :ctx memb: "@fmt_i128"
        (
            appendFormattedNum
            :ctx
            :sNm
            :bN
            size: 48
            call: "z_fmt_i128(_b\{bN}, \{val})"
            :expr
            :ind
            :buf
            :ops
        )
    } else if nk.has when nk.kind == ztypes.numkind.u128Type then {
        needsAddM :ctx uname: "prelude" memb: "int128"
        preludeNeed :ctx memb: "@fmt_u128"
        (
            appendFormattedNum
            :ctx
            :sNm
            :bN
            size: 48
            call: "z_fmt_u128(_b\{bN}, \{val})"
            :expr
            :ind
            :buf
            :ops
        )
    } else if pt.notZero when ctx.boolTid.notZero when (
        (ztypecheck.typedefChaseTid :typing tid: pt) == ctx.boolTid
    ) then {
        interpBoolPart :ast :reg :typing :ctx :val :sNm :bN :expr :ind :buf :ops
    } else if (interpPartIsInt :reg :typing tid: pt :nk) then {
        # u64 is the one integer width whose range does not fit in
        # int64_t, so it is formatted unsigned -- signed, u64 max would print
        # as -1. The kind answers this: unsigned and 64 bits wide is the case,
        # and i128 / u128 have already taken their own branches above. A tag
        # prints as its number. The digits come from z_fmt_i64 / z_fmt_u64,
        # not snprintf, whose format parse costs more than the digits.
        needsAddM :ctx uname: "prelude" memb: "fmt64"
        fmtFn: "z_fmt_i64"
        cast: "int64_t"
        if nk.has when (ztypes.isSignedIntKind k: nk.kind).not when (
            (ztypes.intKindBits k: nk.kind) == 64
        ) then {
            fmtFn = "z_fmt_u64"
            cast = "uint64_t"
            preludeNeed :ctx memb: "@fmt_u64"
        } else {
            preludeNeed :ctx memb: "@fmt_i64"
        }
        (
            appendFormattedNum
            :ctx
            :sNm
            :bN
            size: 32
            call: "\{fmtFn}(_b\{bN}, (\{cast})\{val})"
            :expr
            :ind
            :buf
            :ops
        )
    } else if nk.has when nk.kind == ztypes.numkind.f128Type then {
        preludeNeed :ctx memb: "@quadmath"
        preludeNeed :ctx memb: "@quadmath_snprintf"
        (
            appendFormattedNum
            :ctx
            :sNm
            :bN
            size: 64
            call: "quadmath_snprintf(_b\{bN}, 64, \"%Qg\", \{val})"
            :expr
            :ind
            :buf
            :ops
        )
    } else if nk.has when (ztypes.isFloatKind k: nk.kind) then {
        # an f16 is read as the float it widens to: its value need be no C
        # arithmetic type
        fv: val.string
        if nk.kind == ztypes.numkind.f16Type then {
            needsAddM :ctx uname: "prelude" memb: "f16"
            preludeNeed :ctx memb: "@f16_to_f32"
            fv = "z_f16_to_f32(\{val})"
        }
        (
            appendFormattedNum
            :ctx
            :sNm
            :bN
            size: 64
            call: "snprintf(_b\{bN}, 64, \"%g\", (double)\{fv})"
            :expr
            :ind
            :buf
            :ops
        )
    } else {
        return false
    }
    return true
}

# emitInterpPart -- one part of a string interpolation, appended to the String
# `sNm` being built: as statements on `buf`, or, for a build used as a value
# (`expr`), as operands of its comma expression on `ops`.
emitInterpPart: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    sNm: StringView
    expr: bool
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    ops: String.borrow
} is {
    if n.stringchunk then {
        tv: zast.literalTextAt :ast ref: n.text
        esc: cEscape text: tv
        preludeNeed :ctx memb: "@String_append"
        sc: "\{ctx.strC}_append(&\{sNm}, \"\{esc}\", sizeof(\"\{esc}\")-1)"
        interpStep :expr text: sc.stringView :ind :buf :ops
        return
    }
    pt: interpPartTid :reg :typing :n
    nk: ztypecheck.numKindOfTid :typing tid: pt
    pmk: pendingHoistMark :ctx
    valF: cfacts
    val: valueExprC :ast :reg :typing :ctx :n facts: valF
    # a call fragment may have hoisted non-lvalue args to _ah temps: declare
    # them before the fragment uses them (mirrors the direct print path's flush
    # after emitCallValue); a build used as a value assigns them where it runs
    rel: String
    if expr then {
        interpHoistsInPlace :ctx mark: pmk :ops :rel
    } else {
        flushArgHoists :ctx :ind :tmp :buf
    }
    if (
        interpScalarPart
        :ast
        :reg
        :typing
        :ctx
        :pt
        :nk
        val: val.stringView
        :sNm
        :expr
        :ind
        :tmp
        :buf
        :ops
    ) then {
        null
    } else if pt.notZero when (pt == ctx.svTid) or (pt == ctx.textTid) then {
        appendViewPart :ctx val: val.stringView :valF :sNm :expr :ind :tmp :buf :ops
    } else if pt.notZero when pt == ctx.strTid then {
        (
            appendStringPart
            :ast
            :reg
            :typing
            :ctx
            :n
            val: val.stringView
            :valF
            :sNm
            :expr
            :ind
            :buf
            :ops
        )
    } else if (
        originIsTid
        :reg
        tid: (stampIdOf :typing nid: (interpPartNodeId :n))
        originTid: (ctx.origins.get i: family.slot.str)
    ) then {
        (
            appendStrPart
            :ast
            :reg
            :typing
            :ctx
            :n
            val: val.stringView
            :valF
            :sNm
            :expr
            :ind
            :tmp
            :buf
            :ops
        )
    } else {
        tn: reg.nameViewOf tid: pt
        emitFail :ctx what: "unhandled interp part type \{tn}" line: (ztypecheck.nodeLine :n)
    }
    # the part's value has been appended, so a `.take` argument inside it
    # has been consumed: zero its source here, as the statement paths do.
    # Without this the callee frees the moved value and the caller frees it
    # again at scope end.
    if expr.not then {
        emitValueTakeInvalidations :ast :reg :typing :ctx :n :ind :buf
        return
    }
    inv: String
    emitValueTakeInvalidations :ast :reg :typing :ctx :n ind: "" buf: inv
    appendLinesAsOps :ops lines: inv.stringView
    ops.append rel
}

# interpPartNodeId -- the nodeid of a value shape, the id its stamp is keyed on:
# a path, a call, a literal, or a control-flow value held in place (an `if`
# written as an interpolation hole). 0 for a node that is not a value.
interpPartNodeId: function {n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case atomid then {
        return n.nodeid
    } case labelvalue then {
        return n.nodeid
    } case call then {
        return n.nodeid
    } case dottedpath then {
        return n.nodeid
    } case atomstring then {
        return n.nodeid
    } else {
        return (controlValueNodeId :n)
    }
}

# controlValueNodeId -- the nodeid of a control-flow or block value (if, match,
# for, with, a bare block, a list), 0 for any other shape. These are
# values wherever an operand may be parenthesised, and a parenthesis leaves no
# row of its own to carry the stamp.
controlValueNodeId: function {n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case ifexpr then {
        return n.nodeid
    } case caseexpr then {
        return n.nodeid
    } case forexpr then {
        return n.nodeid
    } case withexpr then {
        return n.nodeid
    } case statement then {
        return n.nodeid
    } case listblock then {
        return n.nodeid
    } else {
        return zast.nodeid
    }
}

# stampIdDeep -- node `n`'s stamped type id, unwrapping a value-position FUNCTION
# stamp to its return tid; 0 when it carries none.
stampIdDeep: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out ztypes.tid is {
    nid: interpPartNodeId :n
    sid: stampIdOf :typing :nid
    if sid.notZero then {
        if (reg.typetypeOf typeId: sid) == ztypes.ztypetype.functionType then {
            return (fnReturnTidOf :reg tid: sid)
        }
        return sid
    }
    return ztypes.tid.zero
}

# tidDeep -- a stamp id with a value-position FUNCTION unwrapped to its return
# type. The id the readers that owe scalarCTypeFor a canonical id ask for, since
# a spelling cannot tell a user type shadowing a scalar from the scalar:
# `xs.length` in a for-header auto-calls, so the node's own stamp is the METHOD
# and its width is the method's return.
tidDeep: function {
    reg: ztypes.ZTypeRegistry.view
    sid: ztypes.tid
} out ztypes.tid is {
    if sid.isZero then return ztypes.tid
    # a value-position FUNCTION stamp is an auto-call; its value type is the
    # method's return.
    if (reg.typetypeOf typeId: sid) == ztypes.ztypetype.functionType then {
        rto: fnReturnTidOf :reg tid: sid
        if rto.notZero then return rto
    }
    return sid
}

# stampTidDeep -- tidDeep of a NODE's own stamp.
stampTidDeep: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out ztypes.tid is {
    return (tidDeep :reg sid: (stampIdOf :typing nid: (interpPartNodeId :n)))
}

# emitPrintStmt -- a statement-position print call.
emitPrintStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    emitted: false
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation when emitted.not then {
            emitted = true
            emitPrintArg :ast :reg :typing :ctx n: (ast.nodes.get i: a.operation) :ind :tmp :buf
        }
    }
    if emitted.not then {
        emitFail :ctx what: "print with no argument".string line: call.lineno
    }
}

# plainStringLiteral -- the text of a single-chunk string literal; "" for
# interpolated or non-literal expressions.
plainStringLiteral: function {ast: Ast.view n: astnode.view} out String is {
    match (
        n
    ) case atomstring then {
        if n.stringparts.count.u64 == 1 then {
            p: ast.nodes.get i: (zast.kidAt kids: ast.kids span: n.stringparts i: 0)
            if p.stringchunk then {
                pt: zast.literalTextAt :ast ref: p.text
                pc: pt.string
                return pc
            }
        }
        return "".string
    } else {
        return "".string
    }
}

# emitErrorStmt -- an `error` call the fold pass could not eliminate. Behind
# a runtime guard it traps via z_panic (reachability is not provable); in
# unconditional position the spec says compilation fails: the message is
# recorded for the driver and the trap emitted as a placeholder.
emitErrorStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    av: String
    avF: cfacts
    lit: String
    got: false
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation when got.not then {
            got = true
            opn: ast.nodes.get i: a.operation
            av = emitExprWith :ast :reg :typing :ctx n: opn facts: avF
            lit = plainStringLiteral :ast n: opn
        }
    }
    okArg: false
    if got when avF.failed.not then okArg = true
    if okArg then {
        flushArgHoists :ctx :ind :tmp :buf
        preludeNeed :ctx memb: "@panic"
        el: "\{ind}z_panic((const char*)\{av}.data);\n"
        buf.append el
    } else {
        preludeNeed :ctx memb: "@panic"
        ef: "\{ind}z_panic(\"(compile-time error)\");\n"
        buf.append ef
    }
    # proved: every path through the function reaches it, assuming each loop
    # ends. An early exit before it can skip it, so it stays a run-time trap
    if ctx.condDepth == 0 when ctx.genActive.not when ctx.returnEmitted.not when (
        anyFrameLeft
        :ctx
    ).not then {
        em: lit.copy
        if em.length == 0 then em = "compile-time error".string
        cn: ast.nodes.get i: call.callable
        ctx.emitErrors.append (
            ztypecheck.reachedErrorData
            nodeid: call.callable
            lineno: (ztypecheck.nodeLine n: cn)
            colno: (zast.posOf n: cn).col
            width: 5
            msg: em.stringView
        )
    }
}

# emitPanicStmt -- `panic "msg"` routes through the shared z_panic runtime
# helper. msg is a StringLike (String/StringView); both expose `.data` as a
# char pointer. A non-string or unhandled arg falls back to a bare marker.
emitPanicStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    av: String
    avF: cfacts
    got: false
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation when got.not then {
            got = true
            aOpNode: ast.nodes.get i: a.operation
            av = emitExprWith :ast :reg :typing :ctx n: aOpNode facts: avF
        }
    }
    okArg: false
    if got when avF.failed.not then okArg = true
    if okArg then {
        flushArgHoists :ctx :ind :tmp :buf
        preludeNeed :ctx memb: "@panic"
        pl: "\{ind}z_panic((const char*)\{av}.data);\n"
        buf.append pl
    } else {
        preludeNeed :ctx memb: "@panic"
        pf: "\{ind}z_panic(\"(panic)\");\n"
        buf.append pf
    }
}

# emitPrintStringLiteral -- a string literal argument of `print`: an
# interpolation builds its parts, a plain literal prints the pooled StringView
# it was interned as.
emitPrintStringLiteral: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.atomstringrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    if (isInterp :ast parts: n.stringparts) then {
        emitInterpPrint :ast :reg :typing :ctx parts: n.stringparts :ind :tmp :buf strNid: n.nodeid
        return
    }
    li: litIndexOf :ctx nid: n.nodeid
    if li == 0 then {
        emitFail :ctx what: "unpooled literal".string line: n.lineno
        return
    }
    lv: litView :ctx :li
    preludeNeed :ctx memb: "@StringView_print"
    l: "\{ind}\{ctx.svC}_print(\{lv});\n"
    buf.append l
}

# emitPrintViaStringView -- an atom printed through its type's own `stringView`
# projection: the projection is called on the value and its result printed. A
# class held BY VALUE is addressed for that call; a pointer, a mono or a
# valtype passes as it stands. A type declaring no such projection cannot be
# printed, and says so where the program can see it.
emitPrintViaStringView: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    argTid: ztypes.tid
    name: StringView
    vid: ztypes.vid
    line: u32
    ind: StringView
    buf: String.borrow
} is {
    svco: typing.declChildOfId parentTypeId: argTid nameId: zast.wellKnown.slot.wkStringView
    match (
        svco
    ) case some then {
        mcb: spelledCname :ctx tid: svco
        argOrig: originTidOf :reg tid: argTid
        usesAmp: false
        if (reg.typetypeOf typeId: argTid) == ztypes.ztypetype.classType when argOrig.isZero when (
            isPtrVid
            :ctx
            :vid
        ).not then usesAmp = true
        if usesAmp then {
            preludeNeed :ctx memb: "@StringView_print"
            lpt: "\{ind}\{ctx.svC}_print(\{mcb}(&\{name}));\n"
            buf.append lpt
        } else {
            preludeNeed :ctx memb: "@StringView_print"
            printLine: "\{ind}\{ctx.svC}_print(\{mcb}(\{name}));\n"
            buf.append printLine
        }
    } case none then {
        tn: reg.nameViewOf tid: argTid
        emitFail :ctx what: "unhandled print of \{name} type \{tn}" :line
    }
}

# emitPrintAtom -- a bare name argument of `print`, printed by what its stamp
# says it holds: an owned String, a StringView, a str mono, or any other type
# through its own stringView projection.
emitPrintAtom: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.atomidrow.view
    ind: StringView
    buf: String.borrow
} is {
    anC: zast.nameTextAt :ast ref: n.name
    an: anC.stringView
    nameVid: atomVid :typing nid: n.nodeid
    anm: aliasResolveAt :reg :typing :ctx nid: n.nodeid name: an vid: nameVid
    anv: ztypes.vid
    if anm.stringView == an then anv = nameVid
    # anm stays the SOURCE name (the alias/narrow lookups key on it); anmE
    # is what reaches the C
    anmF: cfacts
    anmE: (
        emitLocalAtomNameAt
        :ast
        :reg
        :typing
        :ctx
        nid: n.nodeid
        name: an
        vid: nameVid
        facts: anmF
    )
    # a unit string CONSTANT reaching print by name. emitExpr answers for a
    # constant on its own first line; print resolves atoms itself and never
    # goes through it, so without this the NAME reaches the C undeclared.
    # A stamped local is not a constant, so the probe is skipped for one --
    # the same order emitExpr's atomid arm uses.
    {
        alo: typing.atomVariableId.get key: n.nodeid
        if alo.none then {
            mainUnit: mainUnitTid :typing :ctx
            facts: cfacts
            cst: memberConstStringText :typing :ctx unitTid: mainUnit nameId: n.name :facts
            if cst.length > 0 then anmE = cst.copy
        }
    }
    if (stampIsStr :typing :ctx nid: n.nodeid) then {
        if (isPtrVid :ctx vid: anv) then {
            preludeNeed :ctx memb: "@String_print"
            lps: "\{ind}\{ctx.strC}_print(\{anmE});\n"
            buf.append lps
        } else {
            preludeNeed :ctx memb: "@String_print"
            printLine: "\{ind}\{ctx.strC}_print(&\{anmE});\n"
            buf.append printLine
        }
        return
    }
    argTid: stampIdOf :typing nid: n.nodeid
    if ctx.svTid == argTid then {
        preludeNeed :ctx memb: "@StringView_print"
        lpv: "\{ind}\{ctx.svC}_print(\{anmE});\n"
        buf.append lpv
        return
    }
    if (originIsTid :reg tid: argTid originTid: (ctx.origins.get i: family.slot.str)) then {
        preludeNeed :ctx memb: "@StringView_print"
        svT: svTypeC :ctx
        lpstr: "\{ind}\{ctx.svC}_print((\{svT}){ .data = \{anmE}.data, .size = \{anmE}.len });\n"
        buf.append lpstr
        return
    }
    (
        emitPrintViaStringView
        :reg
        :typing
        :ctx
        :argTid
        name: anmE.stringView
        vid: anv
        line: n.lineno
        :ind
        :buf
    )
}

# emitPrintValueExpr -- any other print argument: the expression is emitted and
# printed by what its stamp holds. An owned String that is not an lvalue is
# hoisted so it can be addressed and freed.
emitPrintValueExpr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    eid: interpPartNodeId :n
    if (stampIsSv :typing :ctx nid: eid) then {
        ev: emitExpr :ast :reg :typing :ctx :n
        flushArgHoists :ctx :ind :tmp :buf
        preludeNeed :ctx memb: "@StringView_print"
        lpe: "\{ind}\{ctx.svC}_print(\{ev});\n"
        buf.append lpe
        return
    }
    if ctx.strTid != (stampIdOf :typing nid: eid) then {
        emitFail :ctx what: "unhandled print argument".string line: (ztypecheck.nodeLine :n)
        return
    }
    esF: cfacts
    es: emitExprWith :ast :reg :typing :ctx :n facts: esF
    flushArgHoists :ctx :ind :tmp :buf
    if esF.place.not then {
        hps: tmpNext :ctx :tmp
        strT: strTypeC :ctx
        lsa: "\{ind}\{strT} _h\{hps} = \{es};\n"
        buf.append lsa
        preludeNeed :ctx memb: "@String_print"
        lsb: "\{ind}\{ctx.strC}_print(&_h\{hps});\n"
        buf.append lsb
        preludeNeed :ctx memb: "@String_free"
        lsf: "\{ind}\{ctx.strC}_free(&_h\{hps});\n"
        buf.append lsf
        return
    }
    # a String read through a borrowed field is already a pointer
    if (pathIsPointer :ast :reg :typing :ctx :n) then {
        preludeNeed :ctx memb: "@String_print"
        lsp: "\{ind}\{ctx.strC}_print(\{es});\n"
        buf.append lsp
        return
    }
    preludeNeed :ctx memb: "@String_print"
    lsl: "\{ind}\{ctx.strC}_print(&\{es});\n"
    buf.append lsl
}

# emitPrintCallValue -- a call argument of `print`: a StringView result prints
# directly, a String is hoisted so it can be addressed and printed, and freed
# when the call hands it over.
emitPrintCallValue: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    ceF: cfacts
    # a call the compiler computed (`"-".repeated n: 6`) prints its value
    value: nodeConstText :ast :reg :typing :ctx nid: call.nodeid facts: ceF
    if value.length == 0 then value = emitCallValue :ast :reg :typing :ctx :call facts: ceF
    ce: (
        loadValueStructRef
        :ast
        :reg
        :typing
        :ctx
        n: (ast.nodes.get i: call.nodeid)
        e: value
        facts: ceF
    )
    flushArgHoists :ctx :ind :tmp :buf
    if (stampIsSv :typing :ctx nid: call.nodeid) then {
        preludeNeed :ctx memb: "@StringView_print"
        lpcv: "\{ind}\{ctx.svC}_print(\{ce});\n"
        buf.append lpcv
        return
    }
    hpc: tmpNext :ctx :tmp
    strT: strTypeC :ctx
    lpa: "\{ind}\{strT} _h\{hpc} = \{ce};\n"
    buf.append lpa
    preludeNeed :ctx memb: "@String_print"
    lpb: "\{ind}\{ctx.strC}_print(&_h\{hpc});\n"
    buf.append lpb
    # a borrow-returning call (an element view) hands back storage its container
    # still owns
    if (callRhsIsBorrow :ast :reg :typing :ctx :call) then return
    preludeNeed :ctx memb: "@String_free"
    lpf: "\{ind}\{ctx.strC}_free(&_h\{hpc});\n"
    buf.append lpf
}

# emit one argument of a `print` call.
emitPrintArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    # a name that calls a function prints what the call returns
    if (baseAtomNamesFunction :reg :typing :n) then {
        emitPrintValueExpr :ast :reg :typing :ctx :n :ind :tmp :buf
        return
    }
    match (
        n
    ) case atomstring then {
        emitPrintStringLiteral :ast :reg :typing :ctx :n :ind :tmp :buf
    } case atomid then {
        emitPrintAtom :ast :reg :typing :ctx :n :ind :buf
    } case call then {
        emitPrintCallValue :ast :reg :typing :ctx call: n :ind :tmp :buf
    } else {
        emitPrintValueExpr :ast :reg :typing :ctx :n :ind :tmp :buf
    }
}

# bindLitIndex -- the pool index of a plain-literal value node (0 = none).
bindLitIndex: function {
    ast: Ast.view
    ctx: Ctx
    n: astnode.view
} out u64 is {
    match (
        n
    ) case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            return 0
        } else {
            return (litIndexOf :ctx nid: n.nodeid)
        }
    } else {
        return 0
    }
}

# stringviewOfBaseNid -- the base atom's node of `X.stringView` over a String
# local, 0 otherwise.
stringviewOfBaseNid: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out zast.nodeid is {
    match (
        n
    ) case dottedpath then {
        mn: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        if (ztypecheck.isStringViewMember nameId: mn) then {
            # a base atom naming a FUNCTION is a call, whose String has no name
            if (baseAtomNamesFunction :reg :typing n: (ast.nodes.get i: n.parent)
            ) then return zast.nodeid
            bnid: atomNodeId n: (ast.nodes.get i: n.parent)
            sid: stampIdOf :typing nid: bnid
            if (
                sid == (ztypecheck.stdTidPeek :ast :typing wk: zast.wellKnown.slot.tyString)
            ) then return bnid
        }
        return zast.nodeid
    } else {
        return zast.nodeid
    }
}

# stringCopyLitIndex -- the pool index of `\"lit\".string` (0 otherwise).
stringCopyLitIndex: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out u64 is {
    match (
        n
    ) case dottedpath then {
        mnId: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        if mnId == zast.wellKnown.slot.wkString then {
            return (bindLitIndex :ast :ctx n: (ast.nodes.get i: n.parent))
        } else {
            return 0
        }
    } else {
        return 0
    }
}

# copyReceiverTemp -- the temp a `.copy` of a String rvalue `pv` (node `n`)
# reads: a hoist after the ones spelling `pv` registered, freed with the
# statement when the CHECKER says the temporary owns what it holds -- a borrow
# its owner keeps (`list.get`) owns nothing and is not freed here.
copyReceiverTemp: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the `.copy` receiver's value node
    argNid: zast.nodeid
    pv: StringView
} out String is {
    return (hoistForAddress :ast :reg :typing :ctx av: pv tid: ctx.strTid :argNid)
}

# copyRvalueHoist -- `<rvalue>.copy` over a String (e.g. `(list.get i: n).copy`):
# the receiver is a non-lvalue, so hoist it to a temp (copyReceiverTemp) and
# return `String_copy(&temp)`. "" otherwise.
copyRvalueHoist: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    facts: cfacts.borrow
} out String is {
    match (
        n
    ) case dottedpath then {
        cnId: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        if cnId != zast.wellKnown.slot.wkCopy then return "".string
        if (
            (stampIdDeep :reg :typing n: (ast.nodes.get i: n.parent)) != ctx.strTid
        ) then return "".string
        # the receiver is spelled again by the caller when this declines, so
        # what this spelling hoisted is dropped with it
        hmk: pendingHoistMark :ctx
        pvF: cfacts
        pv: emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent) facts: pvF
        if pvF.place then {
            dropHoistsTo :ctx mark: hmk
            return "".string
        }
        tnm: (
            copyReceiverTemp
            :ast
            :reg
            :typing
            :ctx
            argNid: (zast.nodeIdOf n: (ast.nodes.get i: n.parent))
            pv: pv.stringView
        )
        preludeNeed :ctx memb: "@String_copy"
        return (stating :facts from: callFacts text: "\{ctx.strC}_copy(&\{tnm})")
    } else {
        return "".string
    }
}

# emitStringBindValue -- bind an interpolated-literal value to a String
# local (build chain + binding + scope-end free); false when the value
# is not an interpolated literal.
emitStringBindValue: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    nm: StringView
    nmVid: ztypes.vid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    match (
        n
    ) case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            unusedOps: String
            sB: (
                emitInterpBuild
                :ast
                :reg
                :typing
                :ctx
                parts: n.stringparts
                :ind
                :tmp
                :buf
                strNid: n.nodeid
                ops: unusedOps
            )
            strT: strTypeC :ctx
            lst: "\{ind}\{strT} \{nm} = \{sB};\n"
            buf.append lst
            return true
        } else {
            return false
        }
    } case dottedpath then {
        cndId: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        if cndId == zast.wellKnown.slot.wkString then {
            dpv: ast.nodes.get i: n.parent
            return (emitStringBindValue :ast :reg :typing :ctx n: dpv :nm :nmVid :ind :tmp :buf)
        }
        if cndId == zast.wellKnown.slot.wkCopy then {
            # `<rvalue>.copy` over a String (e.g. `(list.get i: n).copy`): the
            # receiver is a non-lvalue, so hoist it to a borrowed temp (List.get
            # returns a shallow view -- never freed) before String_copy(&temp).
            if (stampIdDeep :reg :typing n: (ast.nodes.get i: n.parent)) == ctx.strTid then {
                # the value is spelled again by the caller when this declines,
                # so what this spelling hoisted is dropped with it
                hmk: pendingHoistMark :ctx
                pvF: cfacts
                pv: emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent) facts: pvF
                if pvF.place then dropHoistsTo :ctx mark: hmk
                if pvF.place.not then {
                    tnm: (
                        copyReceiverTemp
                        :ast
                        :reg
                        :typing
                        :ctx
                        argNid: (zast.nodeIdOf n: (ast.nodes.get i: n.parent))
                        pv: pv.stringView
                    )
                    flushArgHoists :ctx :ind :tmp :buf
                    preludeNeed :ctx memb: "@String_copy"
                    strT: strTypeC :ctx
                    lc: "\{ind}\{strT} \{nm} = \{ctx.strC}_copy(&\{tnm});\n"
                    buf.append lc
                    return true
                }
            }
            return false
        }
        return false
    } else {
        return false
    }
}

# emitOptionBoxHoist -- `Option.some <val>`: a heap-boxed union ctor, emitted as
# statements (the box can't be an expression). Returns the `_cN` temp name, or ""
# when n is not an Option.some (so the caller falls back to the expression path).
emitOptionBoxHoist: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out String is {
    match (
        n
    ) case statementline then {
        sln: ast.nodes.get i: n.statementline
        return (emitOptionBoxHoist :ast :reg :typing :ctx n: sln :ind :tmp :buf)
    } case call then {
        cnId: aliasChildNameId :ast :typing n: (ast.nodes.get i: n.callable)
        if cnId != zast.wellKnown.slot.wkSome then return "".string
        mid: stampIdOf :typing nid: n.nodeid
        if (originIsTid :reg tid: mid originTid: (ctx.origins.get i: family.slot.option)).not then {
            return "".string
        }
        av: "0".string
        avNid: zast.nodeid
        got: false
        for each argId: (zast.kidsOf :ast span: n.arguments) loop {
            a: ast.nodes.get i: argId
            if a.namedoperation when got.not then {
                got = true
                aOpNode: ast.nodes.get i: a.operation
                avNid = a.operation
                av = emitExpr :ast :reg :typing :ctx n: aOpNode
            }
        }
        vc: spelledCname :ctx tid: mid
        payC: armPayloadC :ast :reg :typing :ctx tid: mid arm: zast.wellKnown.slot.wkSome
        tg: spelledTagConst :ast :ctx :reg :typing tid: mid armId: zast.wellKnown.slot.wkSome
        # what the payload hoisted is declared ahead of the box
        flushArgHoists :ctx :ind :tmp :buf
        bN: tmpNext :ctx :tmp
        b0: "\{ind}\{vc}_t _c\{bN} = {0};\n"
        buf.append b0
        b1: "\{ind}_c\{bN}.tag = \{tg};\n"
        buf.append b1
        b2: "\{ind}\{payC} _t\{bN} = \{av};\n"
        buf.append b2
        bx: "_Box\{bN}"
        tv: "_t\{bN}"
        b3: armCellAlloc :ctx pc: payC.stringView box: bx.stringView
        buf.append "\{ind}\{b3}\n"
        b4: armCellFill box: bx.stringView value: tv.stringView
        buf.append "\{ind}\{b4}\n"
        if (boxedLocalNeedsZero :ast :typing nid: avNid) then {
            payT: (
                (typing.declChildOfId parentTypeId: mid nameId: zast.wellKnown.slot.wkSome).or
                d: ztypes.tid.zero
            )
            bz: movedZeroC :reg :typing :ctx tid: payT
            if bz.length > 0 then buf.append "\{ind}\{av} = \{bz};\n"
        }
        dl: "_c\{bN}.data"
        b5: armCellAttach slot: dl.stringView box: bx.stringView
        buf.append "\{ind}\{b5}\n"
        return "_c\{bN}"
    } else {
        return "".string
    }
}

# emitStringReturnValue -- a `return "\{...}".string` whose value is an
# interpolated-String literal: build it (emitInterpBuild) then return the owned
# temp. Mirrors emitStringBindValue but the built String is the return value
# (ownership transfers to the caller -> no free registered). false when the
# value is not an interp-String-literal (caller falls back to emitExpr).
emitStringReturnValue: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    match (
        n
    ) case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            unusedOps: String
            sB: (
                emitInterpBuild
                :ast
                :reg
                :typing
                :ctx
                parts: n.stringparts
                :ind
                :tmp
                :buf
                strNid: n.nodeid
                ops: unusedOps
            )
            emitReturnCleanup :ast :reg :typing :ctx :tmp :ind :buf
            lst: "\{ind}return \{sB};\n"
            buf.append lst
            return true
        } else {
            return false
        }
    } case dottedpath then {
        cndId: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        if cndId == zast.wellKnown.slot.wkString then {
            dpw: ast.nodes.get i: n.parent
            return (emitStringReturnValue :ast :reg :typing :ctx n: dpw :ind :tmp :buf)
        } else {
            return false
        }
    } else {
        return false
    }
}

# emitDiscardedResult -- a statement-position call (explicit, dotted auto-call,
# or bare-atom auto-call) whose result is discarded: the fresh owned result the
# checker holds in a temporary of its own (discardTemp, keyed by the value's
# node `nid`) is bound to it and destroyed as the statement ends; any other
# result is evaluated for its effect alone.
emitDiscardedResult: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nid: zast.nodeid
    ce: StringView
    rtid: ztypes.tid
    ind: StringView
    buf: String.borrow
} is {
    dv: typing.discardTemp.get key: nid
    if dv.none then {
        buf.append "\{ind}(void)(\{ce});\n"
        return
    }
    dnm: varCName :ctx :ast :reg vid: dv
    strT: strTypeC :ctx
    dct: if rtid == ctx.strTid then strT.copy else typeRefC :ast :reg :typing :ctx tid: rtid
    buf.append "\{ind}\{dct} \{dnm} = \{ce};\n"
    buf.append (destroyLineC :reg :typing :ctx tid: rtid nm: dnm.stringView :ind)
}

# emitCallStmt -- one call-shaped statement: return / print / a plain call.
emitCallStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    # an operation the compiler computed (`100 - 250`) has nothing left to run
    folded: (typing.nodeConstAt nid: call.nodeid).kind
    if folded.ivalKind or folded.fvalKind or folded.svalKind then return
    relmnId: aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable)
    if (zast.markerKindOfName id: relmnId).dropMarker then {
        relbnid: dottedBaseNodeId :ast n: (ast.nodes.get i: call.callable)
        reltid: stampIdOf :typing nid: relbnid
        if (reg.typetypeOf typeId: reltid) == ztypes.ztypetype.protocolType then return
    }
    cn0Id: zast.atomNameIdOf n: (ast.nodes.get i: call.callable)
    # a statement form arrives either as its core alias (an atom) or spelled
    # qualified (a dotted path, whose atom carries no name)
    sfnId: cn0Id
    if cn0Id.isZero then {
        sfnId = stmtFormNameId :ast :reg :typing n: (ast.nodes.get i: call.callable)
    }
    if sfnId == zast.wellKnown.slot.wkPrint then {
        emitPrintStmt :ast :reg :typing :ctx :call :ind :tmp :buf
        return
    }
    if sfnId == zast.wellKnown.slot.wkPanic then {
        emitPanicStmt :ast :reg :typing :ctx :call :ind :tmp :buf
        return
    }
    if sfnId == zast.wellKnown.slot.wkError then {
        emitErrorStmt :ast :reg :typing :ctx :call :ind :tmp :buf
        return
    }
    if sfnId == zast.wellKnown.slot.wkReturn then {
        ctx.returnEmitted = true
        outerExit: ctx.exitNode
        ctx.exitNode = call.nodeid
        hasArg: false
        for each aId: (zast.kidsOf :ast span: call.arguments) loop {
            a: ast.nodes.get i: aId
            if a.namedoperation when hasArg.not then {
                hasArg = true
                emitReturnOfNode :ast :reg :typing :ctx vid: a.operation :ind :tmp :buf
            }
        }
        if hasArg.not then {
            if ctx.genActive then {
                emitExitDestroy :ast :reg :typing :ctx :ind :buf
                lgd: "\{ind}goto L_done;\n"
                buf.append lgd
            } else {
                emitReturnCleanup :ast :reg :typing :ctx :tmp :ind :buf
                lr2: "\{ind}return;\n"
                buf.append lr2
            }
        }
        ctx.exitNode = outerExit
        return
    }
    facts: cfacts
    ce: emitCallValue :ast :reg :typing :ctx :call :facts
    flushArgHoists :ctx :ind :tmp :buf
    dcrtid: stampIdOf :typing nid: call.nodeid
    (
        emitDiscardedResult
        :ast
        :reg
        :typing
        :ctx
        nid: call.nodeid
        ce: ce.stringView
        rtid: dcrtid
        :ind
        :buf
    )
    emitCallTakeInvalidations :ast :reg :typing :ctx :call :ind :buf
}

# emitCollectionBind -- binding a List, Set or Map: the mono's own create, the
# capacity the construction asked for, and the cleanup entry the local earns.
# The cleanup entry is what `nbrw` gates, in each leg: a field read ALIASES the
# holder's heap -- the struct copy shares its buffer -- so the holder alone owns
# it, and registering a destructor here freed that buffer twice.
emitCollectionBind: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.assignmentrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    nm: StringView
} out bool is {
    avn: ast.nodes.get i: n.value
    nbrw: bindingVarIsBorrowed :reg :typing :n
    ltid: bindChasedTid :reg :typing :ctx :n :avn
    isList: isListOriginOf :reg :ctx tid: ltid
    isHeap: isSetOriginOf :reg :ctx tid: ltid
    if (isMapOriginOf :reg :ctx tid: ltid) then isHeap = true
    if isList or isHeap when (controlValueOwnsArms :ast :reg :typing :ctx n: avn) then {
        (
            emitControlCollectionBind
            :ast
            :reg
            :typing
            :ctx
            :avn
            :ind
            :tmp
            :buf
            :nm
            :ltid
            :isHeap
        )
        return true
    }
    if isList then {
        emitListBind :ast :reg :typing :ctx :avn :ind :tmp :buf :nm :ltid :nbrw
        return true
    }
    if isHeap then {
        hcb: spelledCname :ctx tid: ltid
        (
            emitHeapColBind
            :ast
            :reg
            :typing
            :ctx
            :avn
            :ind
            :tmp
            :buf
            :nm
            cb: hcb.stringView
            :ltid
            :nbrw
        )
        return true
    }
    return false
}

# emitControlCollectionBind -- a List, Set or Map bound from an `if`, a `match` or
# a do block whose arms own their values: the arms assign the local as any
# control binding does, and the local earns the cleanup entry a construction
# would.
emitControlCollectionBind: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    avn: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    nm: StringView
    ltid: ztypes.tid
    # a Set or Map, held and destroyed through its pointer
    isHeap: bool
} is {
    cb: spelledCname :ctx tid: ltid
    ct: "\{cb}_t"
    if isHeap then ct = "\{cb}_t*"
    isDo: false
    match (
        avn
    ) case doexpr then {
        isDo = true
        (
            emitDoBindValue
            :ast
            :reg
            :typing
            :ctx
            n: (ast.nodes.get i: avn.nodeid)
            :nm
            ct: ct.stringView
            tid: ltid
            :ind
            :tmp
            :buf
        )
    } else null
    if isDo then return
    (
        emitControlBindValue
        :ast
        :reg
        :typing
        :ctx
        vid: (zast.nodeIdOf n: avn)
        rtid: ltid
        :nm
        ct: ct.stringView
        :ind
        :tmp
        :buf
    )
}

# controlValueOwnsArms -- an `if`, a `match`, a `with` or a breakless do block
# used as a value, none of whose arms yields a borrowed read (a field, an
# element view): every arm hands over a value of its own. False for any other
# node. A `with` has ONE arm, its body.
controlValueOwnsArms: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case doexpr then {
        if (ztypecheck.blockHasBreak :ast n: (ast.nodes.get i: n.statement)) then return false
        return (armValueOwned :ast :reg :typing :ctx blockId: n.statement)
    } case withexpr then {
        return (armValueOwned :ast :reg :typing :ctx blockId: n.body)
    } case ifexpr then null case caseexpr then null else {
        return false
    }
    blocks: ListVal zast.nodeid
    ztypecheck.controlArmBlocks :ast nid: (zast.nodeIdOf :n) into: blocks
    owned: true
    for each blk: blocks loop {
        armOwned: armValueOwned :ast :reg :typing :ctx blockId: blk
        if armOwned.not then owned = false
    }
    return owned
}

# armValueOwned -- the value the arm body `blockId` yields is not a place the
# checker recorded (armLeafIsPlace): its last line's value, or the body itself
# when it is an expression. An arm that yields nothing (it leaves) hands over
# nothing to borrow.
armValueOwned: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    blockId: zast.nodeid
} out bool is {
    valId: blockId
    isBlock: false
    bn: ast.nodes.get i: blockId
    isBlock = bn.statement
    if isBlock then {
        lineId: ztypecheck.lastStmtLineIdAt :ast oId: blockId
        if lineId.isZero then return true
        valId = (
            ztypecheck.implicitReturnValue
            :reg
            :typing
            :ast
            :lineId
            lineType: (stampIdOf :typing nid: lineId)
        )
        if valId.isZero then return true
    }
    vn: ast.nodes.get i: valId
    nested: vn.ifexpr or vn.caseexpr or vn.doexpr or vn.withexpr
    if nested then return (controlValueOwnsArms :ast :reg :typing :ctx n: vn)
    return (armLeafIsPlace :ast :reg :typing :ctx n: vn).not
}

# emitListBind -- the List leg of emitCollectionBind: a no-argument native's
# owned result, a comprehension, a call result moved in, or a fresh list at the
# capacity asked for; then the cleanup entry unless the binding borrows
emitListBind: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    avn: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    nm: StringView
    ltid: ztypes.tid
    nbrw: bool
} is {
    lcb: spelledCname :ctx tid: ltid
    if (noArgNativeRhs :ctx :ast :reg :typing unitName: ctx.mainName.stringView n: avn) then {
        # owned List returned by os.args / os.envNames: emit the call.
        losr: emitExpr :ast :reg :typing :ctx n: avn
        flushArgHoists :ctx :ind :tmp :buf
        losb: "\{ind}\{lcb}_t \{nm} = \{losr};\n"
        buf.append losb
    } else {
        if (forexprValue n: avn) then {
            # list comprehension: `xs: for ... loop { expr }` create + populate
            noteMemberUse :ctx mono: ltid member: memberWord.slot.create
            lc0: "\{ind}\{lcb}_t \{nm} = \{lcb}_create((uint64_t)0);\n"
            buf.append lc0
            (
                emitListComprehension
                :ast
                :reg
                :typing
                :ctx
                listTid: ltid
                forNode: avn
                listCb: lcb.stringView
                listVar: nm
                :ind
                :tmp
                :buf
            )
        } else {
            if (collectionValueCallRhs :ast :reg :typing n: avn) then {
                valueC: emitExpr :ast :reg :typing :ctx n: avn
                flushArgHoists :ctx :ind :tmp :buf
                lb0: "\{ind}\{lcb}_t \{nm} = \{valueC};\n"
                buf.append lb0
                emitValueTakeInvalidations :ast :reg :typing :ctx n: avn :ind :buf
                # a binding from a bare owned local, or from a take out of
                # one, is a MOVE: the source is zeroed where a destroy of it
                # still runs. A BORROW takes the alias leg before reaching
                # here, and must never zero its source.
                if nbrw.not then emitMovedSourceZero :ast :reg :typing :ctx n: avn :ind :buf
                if (isLocalTake :ast :typing n: avn) then (
                    emitTakenSourceZero
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: avn
                    ts: valueC.stringView
                    :ind
                    :buf
                )
            } else {
                # THE LAST LEG IS A CONSTRUCTION, and it accepts anything: a
                # `withexpr` RHS reaches it and builds an EMPTY LIST, so
                # `ys: with it: xs.iterate do for each e: it loop e * 2` answers
                # `len 0` and says nothing. Binding a `with` expression's value
                # is unsupported for ANY value (`n: with it: xs.iterate do
                # it.call.some` is E0500), so the fix is to make it BIND, not
                # to add a fallback here -- the emitter cannot render it, and a
                # fallback leg is what fallback-guard exists to keep shrinking.
                lcap: listCapArg :ast :reg :typing :ctx n: avn
                flushArgHoists :ctx :ind :tmp :buf
                noteMemberUse :ctx mono: ltid member: memberWord.slot.create
                lb1: "\{ind}\{lcb}_t \{nm} = \{lcb}_create((uint64_t)\{lcap});\n"
                buf.append lb1
            }
        }
    }
}

# emitHeapColBind -- the Set and Map leg of emitCollectionBind, one body for
# both since only the mono's cname differs: a call result moved in, or a fresh
# collection at the capacity asked for; then the cleanup entry unless the
# binding borrows
emitHeapColBind: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    avn: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    nm: StringView
    cb: StringView
    # the collection's type
    ltid: ztypes.tid
    nbrw: bool
} is {
    if (collectionValueCallRhs :ast :reg :typing n: avn) then {
        hvr: emitExpr :ast :reg :typing :ctx n: avn
        flushArgHoists :ctx :ind :tmp :buf
        hbc: "\{ind}\{cb}_t* \{nm} = \{hvr};\n"
        buf.append hbc
        emitValueTakeInvalidations :ast :reg :typing :ctx n: avn :ind :buf
        # a heap collection binding from a bare owned local, or from a take
        # out of one, is a MOVE: the source is cleared where a destroy of it
        # still runs. A BORROW of one is a second pointer to the same
        # allocation and must leave the source standing.
        if nbrw.not then emitMovedSourceZero :ast :reg :typing :ctx n: avn :ind :buf
        if (isLocalTake :ast :typing n: avn) then (
            emitTakenSourceZero
            :ast
            :reg
            :typing
            :ctx
            n: avn
            ts: hvr.stringView
            :ind
            :buf
        )
    } else {
        hcap: listCapArg :ast :reg :typing :ctx n: avn
        flushArgHoists :ctx :ind :tmp :buf
        noteMemberUse :ctx mono: ltid member: memberWord.slot.create
        hb0: "\{ind}\{cb}_t* \{nm} = \{cb}_create((uint64_t)\{hcap});\n"
        buf.append hb0
    }
}

# emitStringLikeBind -- a String or StringView binding: a `match` value, then
# every other value.
emitStringLikeBind: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.assignmentrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    nm: StringView
    nameVid: ztypes.vid
    btid: ztypes.tid
} out bool is {
    if (emitStringMatchBind :ast :reg :typing :ctx :n :ind :tmp :buf :nm :btid) then return true
    return (emitStringBind :ast :reg :typing :ctx :n :ind :tmp :buf :nm :nameVid :btid)
}

# emitStringMatchBind -- a String or StringView binding whose value is a `match`:
# declared, then assigned per arm as a binding of any other type is. An owned
# String joins the scope's cleanup list.
emitStringMatchBind: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.assignmentrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    nm: StringView
    btid: ztypes.tid
} out bool is {
    isStr: btid == ctx.strTid
    if isStr.not when btid != ctx.svTid then return false
    isMatch: false
    isIf: false
    vn: ast.nodes.get i: n.value
    isMatch = vn.caseexpr
    isIf = vn.ifexpr
    # an if a ternary spells stays on the expression path
    if isIf then isIf = (ifIsTernary :ast n: (ast.nodes.get i: n.value)).not
    if isMatch.not when isIf.not then return false
    avn: ast.nodes.get i: n.value
    smT: svTypeC :ctx
    if isStr then {
        smT = strTypeC :ctx
    }
    bound: false
    if isIf then {
        bound = emitIfBindValue :ast :reg :typing :ctx n: avn :nm ct: smT.stringView :ind :tmp :buf
    } else {
        bound = (
            emitMatchBindValue
            :ast
            :reg
            :typing
            :ctx
            n: avn
            :nm
            ct: smT.stringView
            :ind
            :tmp
            :buf
        )
    }
    return bound
}

# emitStringBind -- binding a StringView or a String. A view aliases its source and
# frees nothing; an owned String joins the scope's cleanup list unless the binding
# is a borrow.
emitStringBind: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.assignmentrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    nm: StringView
    nameVid: ztypes.vid
    btid: ztypes.tid
} out bool is {
    handled: false
    avn: ast.nodes.get i: n.value
    # a block value is bound as a collection's is: the local declared, the block
    # assigning its last value
    if avn.doexpr when (btid == ctx.svTid) or (btid == ctx.strTid) then {
        dct: svTypeC :ctx
        if btid == ctx.strTid then {
            dct = strTypeC :ctx
        }
        return (
            emitDoBindValue
            :ast
            :reg
            :typing
            :ctx
            n: (ast.nodes.get i: n.value)
            :nm
            ct: dct.stringView
            tid: btid
            :ind
            :tmp
            :buf
        )
    }
    if btid == ctx.svTid then {
        lvN: bindLitIndex :ast :ctx n: avn
        if lvN > 0 then {
            lvv: litView :ctx li: lvN
            svT: svTypeC :ctx
            bindLine: "\{ind}\{svT} \{nm} = \{lvv};\n"
            buf.append bindLine
            return true
        }
        # owned: the base's name outlives the ctx writes below
        svb: (baseAtomText :ast nid: (stringviewOfBaseNid :ast :reg :typing n: avn)).string
        if svb.length > 0 then {
            acc: ".".string
            svbV: atomVid :typing nid: (stringviewOfBaseNid :ast :reg :typing n: avn)
            if (isPtrVid :ctx vid: svbV) then acc = "->".string
            svbC: emitLocalAtomName :ast :reg :ctx name: svb.stringView vid: svbV
            svT: svTypeC :ctx
            literalLine: "\{ind}\{svT} \{nm} = (\{svT}){ .data = \{svbC}\{acc}data, .size = \{svbC}\{acc}size };\n"
            buf.append literalLine
            return true
        }
        vxF: cfacts
        vx: emitExprWith :ast :reg :typing :ctx n: avn facts: vxF
        flushArgHoists :ctx :ind :tmp :buf
        if vxF.failed then {
            emitFail :ctx what: "unhandled StringView binding \{nm}" line: n.lineno
        } else {
            svT: svTypeC :ctx
            valueLine: "\{ind}\{svT} \{nm} = \{vx};\n"
            buf.append valueLine
        }
        return true
    }
    if btid == ctx.strTid then {
        fvN: stringCopyLitIndex :ast :typing :ctx n: avn
        if fvN > 0 then {
            fvv: litView :ctx li: fvN
            preludeNeed :ctx memb: "@String_from_view"
            strT: strTypeC :ctx
            lsc: "\{ind}\{strT} \{nm} = \{ctx.strC}_from_view(\{fvv});\n"
            buf.append lsc
            return true
        }
        did: emitStringBindValue :ast :reg :typing :ctx n: avn :nm nmVid: nameVid :ind :tmp :buf
        if did then return true
        sxF: cfacts
        sx: emitExprWith :ast :reg :typing :ctx n: avn facts: sxF
        flushArgHoists :ctx :ind :tmp :buf
        if sxF.failed then {
            emitFail :ctx what: "unhandled String binding \{nm}" line: n.lineno
        } else {
            strT: strTypeC :ctx
            stringLine: "\{ind}\{strT} \{nm} = \{sx};\n"
            buf.append stringLine
            # the value may be a call that took ownership of an argument;
            # the caller zeroes that source here, as every other binding
            # branch does
            emitValueTakeInvalidations :ast :reg :typing :ctx n: avn :ind :buf
            if (varOwnsHere :reg vid: nameVid) then {
                # a binding from a bare owned local, or from an explicit
                # `<local>.take`, is a MOVE, exactly as a reassignment from
                # one is: zero the source so its scope-exit free no-ops now
                # that this binding owns the buffer.
                szs: takeStringSource :ast :reg :typing :ctx n: avn
                if szs.length == 0 when (isBareNameValue n: avn) then {
                    szs = implicitTakeSource :ast :reg :typing :ctx n: avn
                }
                if szs.length > 0 when (movedSourceNeedsZero :ast :typing n: avn) then {
                    szz: movedZeroC :reg :typing :ctx tid: btid
                    buf.append "\{ind}\{szs} = \{szz};\n"
                }
            }
        }
        return true
    }
    return handled
}

# bindAliasCType -- the C type a binding is declared with once ALIASING is
# accounted for. A reference-returning callee hands back `T*`: the binding
# aliases the source, so it is declared as a pointer and its vid registered,
# which is what makes every later use emit `->`. Binding it by value would copy
# the struct and silently lose writes through it. A StringView read as a String
# is the same shape. Both are asked, in that order, because either may apply.
bindAliasCType: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    avn: astnode.view
    ct: StringView
    ltid: ztypes.tid
    nameVid: ztypes.vid
} out String is {
    ctText: "\{ct}"
    rbf8: refBorrowCalleeFid :ast :reg :typing :ctx n: avn
    if rbf8.notZero when (fnReturnsRefBorrow :reg :typing :ctx fid: rbf8 retTid: ltid) then {
        ctText = refPtrC :typing tid: rbf8 base: ct
        ctx.ptrVids.append nameVid
    }
    if (isSvAsStringNode :ast :typing :ctx n: avn) then {
        ctText = "const \{ct}*"
        ctx.ptrVids.append nameVid
    }
    return ctText
}

# emitBindSourceZero -- the binding MOVED its value, so the source is zeroed:
# its scope-exit free has to no-op now that the binding owns the heap. A field
# take, a String take and a bare owned local each spell the zero differently. A
# BORROW binding owns nothing, so its source keeps its value -- asked of the
# binding's own VARIABLE, which is where the checker decided it, not of the
# RHS's shape. Ownership is decided from the TYPE before the source text is
# composed: a scalar binding moves nothing, and asking for the source costs a
# String.
emitBindSourceZero: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the binding, whose variable says whether it borrows
    abind: zast.assignmentrow.view
    avn: astnode.view
    rv: StringView
    ind: StringView
    buf: String.borrow
} is {
    if (movedSourceNeedsZero :ast :typing n: avn).not then return
    bzt: stampIdOf :typing nid: (interpPartNodeId n: avn)
    # a reftype field that moves owns nothing, and reads as empty once moved
    # out; a valtype's take copies its bytes and leaves the field as it is
    if (fieldMoveEmpties :ast :reg n: avn tid: bzt) then {
        buf.append "\{ind}\{rv} = \{zeroValueC :ast :reg :typing :ctx tid: bzt};\n"
        return
    }
    bts: takeStringSource :ast :reg :typing :ctx n: avn
    if bts.length > 0 then {
        bzz: movedZeroC :reg :typing :ctx tid: bzt
        if bzz.length > 0 then buf.append "\{ind}\{rv} = \{bzz};\n"
        return
    }
    if (isBareNameValue n: avn).not then return
    if (destroyTargetTid :reg :typing :ctx tid: bzt).isZero then return
    if (bindingVarIsBorrowed :reg :typing n: abind) then return
    bzs: implicitTakeSource :ast :reg :typing :ctx n: avn
    if bzs.length == 0 then return
    buf.append "\{ind}\{bzs} = \{movedZeroC :reg :typing :ctx tid: bzt};\n"
}

# emitTypedBind -- the general binding: a declared C type and a value, plus the
# cleanup entry the local earns. A union or a heap-owning class registers its
# destructor; a borrow registers nothing, since the source still owns the heap.
emitTypedBind: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.assignmentrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    nm: StringView
    nameVid: ztypes.vid
    ct: StringView
    ltid: ztypes.tid
} is {
    avn: ast.nodes.get i: n.value
    rv: emitExpr :ast :reg :typing :ctx n: avn
    flushArgHoists :ctx :ind :tmp :buf
    if ct.length == 0 then {
        tn: reg.nameViewOf tid: ltid
        emitFail :ctx what: "unhandled binding type \{tn} for \{nm}" line: n.lineno
        return
    }
    ctText: bindAliasCType :ast :reg :typing :ctx :avn :ct :ltid :nameVid
    rvText: "\{rv}"
    if ctText.stringView == ct when (
        needsValueDeref
        :ast
        :reg
        :typing
        :ctx
        n: avn
        tid: ltid
    ) then rvText = "(*\{rv})"
    la: "\{ind}\{ctText} \{nm} = \{rvText};\n"
    buf.append la
    emitValueTakeInvalidations :ast :reg :typing :ctx n: avn :ind :buf
    emitBindSourceZero :ast :reg :typing :ctx abind: n :avn rv: rv.stringView :ind :buf
}

# emitNarrowedTakeBind -- `x: <subject>.take` over a match subject narrowed to
# an arm MOVES the payload out of the arm's box: real storage from the
# narrowed cast, the payload zeroed, so the subject's destroy frees only the
# box. False for any other value, which binds as a move like any other (the
# source zeroed, so a path that did not move it still destroys it).
emitNarrowedTakeBind: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.assignmentrow.view
    ind: StringView
    buf: String.borrow
    nm: StringView
} out bool is {
    avn: ast.nodes.get i: n.value
    # owned: the base's name outlives the ctx writes below
    tabA: (baseAtomText :ast nid: (takeAliasBaseNid :ctx :ast :reg :typing n: avn)).string
    tabAV: atomVid :typing nid: (takeAliasBaseNid :ctx :ast :reg :typing n: avn)
    # a narrowed-subject `.take` binding MOVES the payload out of
    # the match arm's box: real storage from the narrowed cast plus
    # payload zeroing, so the subject's destroy frees only the box
    if tabA.length > 0 when (vvHas xs: ctx.narrowBox vid: tabAV) then {
        ntO: vtGet xs: ctx.narrowTid vid: tabAV
        if ntO.some then {
            ctB: typeRefC :ast :reg :typing :ctx tid: ntO
            valB: emitLocalAtomName :ast :reg :ctx name: tabA.stringView vid: tabAV
            bindLine: "\{ind}\{ctB} \{nm} = \{valB};\n"
            buf.append bindLine
            zcB: movedZeroC :reg :typing :ctx tid: ntO
            if zcB.length > 0 then buf.append "\{ind}\{valB} = \{zcB};\n"
            return true
        }
    }
    return false
}

# dropStaleBorrowAlias -- a binding statement introduces a FRESH local, so a
# borrow alias left by an earlier binding of the same name points at a C
# variable that is out of scope here. Drop it before the binding legs
# re-establish one; anything that is not a borrow alias is left alone.
dropStaleBorrowAlias: function {ctx: Ctx vid: ztypes.vid} is {
    if (vvHasPtr xs: ctx.aliases :vid) then vidRemove xs: ctx.aliases :vid
}

# bindingStampOf -- the type a binding was stamped with, as the body being
# emitted sees it: a generic body is walked once per instantiation, and the
# instance's own stamp is the binding's type there.
bindingStampOf: function {typing: ztyping.ZTyping.view nid: zast.nodeid} out ztypes.tid is {
    return (stampIdOf :typing :nid)
}

# bindDeclaredCType -- the C type a binding declares: the C scalar of a scalar
# the system declares, else its type's struct. An unnamed binding takes the
# stamped type of the statement, or of the value when the statement carries none.
bindDeclaredCType: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.assignmentrow.view
    btid: ztypes.tid
} out String is {
    # a scalar the system declares keeps its C scalar; anything else, a type
    # spelled like a scalar included, is spelled from its id below
    avn: ast.nodes.get i: n.value
    ct: String
    if btid.notZero then ct = scalarCTypeFor :typing tid: btid
    if ct.length == 0 then {
        tgo: stampIdOf :typing nid: n.nodeid
        # the binding's own stamp as the body being emitted sees it comes first:
        # an instance's differs from the shared one
        if btid.notZero then tgo = btid
        if tgo.notZero then {
            ct = typeRefC :ast :reg :typing :ctx tid: tgo
        } else {
            vgo: stampIdOf :typing nid: (interpPartNodeId n: avn)
            if vgo.notZero then {
                ct = typeRefC :ast :reg :typing :ctx tid: vgo
            }
        }
    }
    return ct
}

# emitAssignment -- a binding statement (`x: <value>`): the declaration, the value,
# and the ownership bookkeeping the binding takes on -- a move zeroes its source,
# a borrow records its origin, and an owned local joins the scope's cleanup list.
emitAssignment: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.assignmentrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    avn: ast.nodes.get i: n.value
    btid: bindingStampOf :typing nid: n.nodeid
    ct: bindDeclaredCType :ast :reg :typing :ctx :n :btid
    nameVid: defVid :typing nid: n.nodeid
    nm: varCName :ctx :ast :reg vid: nameVid
    dropStaleBorrowAlias :ctx vid: nameVid
    nbrw: bindingVarIsBorrowed :reg :typing :n
    ctx.borrowedVars.set key: (defVid :typing nid: n.nodeid) value: nbrw
    if ctx.genActive when (isYieldNode :ast n: avn) then {
        (
            emitExprFormYield
            :ast
            :reg
            :typing
            :ctx
            value: avn
            aid: n.nodeid
            nm: nm.stringView
            nmVid: nameVid
            :ind
            :buf
        )
        return
    }
    gfO: typing.genLocalFieldOf.get key: nameVid
    if gfO.some then {
        emitGenLocalBind :ast :reg :typing :ctx :n :nameVid field: gfO :ind :tmp :buf
        return
    }
    if (
        emitReferenceBind
        :ast
        :reg
        :typing
        :ctx
        :avn
        :ind
        :tmp
        :buf
        nm: nm.stringView
        ct: ct.stringView
        :nameVid
    ) then return
    if (
        emitNarrowedTakeBind
        :ast
        :reg
        :typing
        :ctx
        :n
        :ind
        :buf
        nm: nm.stringView
    ) then return
    if (
        emitBorrowAliasBind
        :ast
        :reg
        :typing
        :ctx
        :n
        nm: nm.stringView
        :nameVid
        ct: ct.stringView
        :ind
        :tmp
        :buf
    ) then return
    if (
        emitCollectionBind
        :ast
        :reg
        :typing
        :ctx
        :n
        :ind
        :tmp
        :buf
        nm: nm.stringView
    ) then return
    ltid: bindChasedTid :reg :typing :ctx :n :avn
    if (
        emitStringLikeBind
        :ast
        :reg
        :typing
        :ctx
        :n
        :ind
        :tmp
        :buf
        nm: nm.stringView
        :nameVid
        :btid
    ) then return
    if (
        emitControlBind
        :ast
        :reg
        :typing
        :ctx
        :avn
        nm: nm.stringView
        ct: ct.stringView
        :ltid
        :ind
        :tmp
        :buf
    ) then return
    (
        emitTypedBind
        :ast
        :reg
        :typing
        :ctx
        :n
        :ind
        :tmp
        :buf
        nm: nm.stringView
        :nameVid
        ct: ct.stringView
        :ltid
    )
}

# emitControlBind -- a local bound from an `if`, a `match` or a do block: the arms
# assign it, and it earns the cleanup its type's binding owes
# (oweControlBinding); the do block's own leg registers its. True when it handled
# the binding.
emitControlBind: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    avn: astnode.view
    nm: StringView
    ct: StringView
    ltid: ztypes.tid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    if ct.length == 0 then return false
    dm: emitMatchBindValue :ast :reg :typing :ctx n: avn :nm :ct :ind :tmp :buf
    if dm.not then dm = emitIfBindValue :ast :reg :typing :ctx n: avn :nm :ct :ind :tmp :buf
    if dm then return true
    return (
        emitDoBindValue
        :ast
        :reg
        :typing
        :ctx
        n: avn
        :nm
        :ct
        tid: ltid
        :ind
        :tmp
        :buf
    )
}

# emitReferenceBind -- a local bound from an `if` or a `match` with a place arm
# (controlValueIsReference): the binding is a second name for the storage the arm
# that ran yields, as `r: h.p` is, so it is a POINTER to that storage, aliased to
# its deref, and frees nothing -- a copy would share the owner's heap and leave
# the owner stale when a write through the copy grew it. A heap collection's
# local is its pointer already, and is copied. An arm that yields a value of its
# own parks it in a temporary that lives as long as the binding, not as long as
# the statement. True when it handled the binding.
emitReferenceBind: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    avn: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    nm: StringView
    ct: StringView
    # the binding's variable, which the alias is recorded under
    nameVid: ztypes.vid
} out bool is {
    if ct.length == 0 then return false
    if (controlValueIsReference :ast :reg :typing :ctx n: avn).not then return false
    prevBlock: ctx.hoistsToBlock
    ctx.hoistsToBlock = true
    rv: emitExpr :ast :reg :typing :ctx n: avn
    flushArgHoists :ctx :ind :tmp :buf
    ctx.hoistsToBlock = prevBlock
    vt: bindingStampOf :typing nid: (controlValueStampNid :ast :reg :typing n: avn)
    if (isHeapPtrCollection :reg :typing :ctx tid: vt) then {
        buf.append "\{ind}\{ct}* \{nm} = \{rv};\n"
        return true
    }
    buf.append "\{ind}\{ct}* __borrow_\{nm} = &\{rv};\n"
    buf.append "\{ind}/* alias: \{nm} => (*__borrow_\{nm}) */\n"
    bindBorrowAlias :ctx vid: nameVid :nm
    return true
}

# readsNullField -- the statement reads a field its instance types `null`
# (`v: T` with T = null): the field carries nothing and has no storage, so the
# read is nothing to emit.
readsNullField: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out bool is {
    rt: dottedReceiverStampId :ast :typing callable: n
    if rt.isZero then return false
    ct: (
        (typing.declChildOfId parentTypeId: rt nameId: (aliasChildNameId :ast :typing :n)).or
        d: ztypes.tid.zero
    )
    if ct.isZero then return false
    return (ztypecheck.isNullTid :reg tid: ct)
}

# emitDottedAutoCallStmt -- a no-argument METHOD auto-call in statement position
# (`this.accept`, `this.statepop`) parses as a dotted path. Emits the call as a
# statement. A `.drop` transfer marker emits its destroy when the name owes
# one, and otherwise only a `(void)` read of the name. ALWAYS handles the statement -- the four legs
# inside it were `return`s out of emitReturnStmt, so the caller returns too.
emitDottedAutoCallStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    # `.drop` on a protocol is a transfer marker (scope-exit destroy
    # covers it) -- emit nothing, like emitCallStmt. A `.take` whose value
    # nothing receives ends the local here as `.drop` does.
    mk: zast.markerKindOf :ast :n
    isDrop: mk.dropMarker
    if isDrop or mk.takeMarker or mk.holdMarker then {
        rrid: dottedReceiverStampId :ast :typing callable: n
        rtt: reg.typetypeOf typeId: rrid
        if rtt == ztypes.ztypetype.protocolType then return
        # a name that owns nothing -- a borrow, a parameter the caller still
        # owns -- ends with its drop, and what it named is left to its owner:
        # the checker recorded no destroy there. A `.take` nothing receives
        # ends an owned local, which the checker let it move.
        dropNid: zast.nodeIdOf :n
        if isDrop when (namedDestroyOwes :typing nid: dropNid).not then {
            # read once, so a name whose only use is its drop is still used
            # in the C
            callFacts: cfacts
            drv: emitDottedReceiver :ast :reg :typing :ctx callable: n facts: callFacts
            buf.append "\{ind}(void)(\{drv});\n"
            emitDropReleasedTemps :typing :tmp :dropNid :ind :buf
            return
        }
        facts: cfacts
        rcvV: emitDottedReceiver :ast :reg :typing :ctx callable: n :facts
        dsl: destroyLineC :reg :typing :ctx tid: rrid nm: rcvV.stringView :ind
        # a type with nothing to destroy still reads the name once
        if dsl.length == 0 when isDrop then buf.append "\{ind}(void)(\{rcvV});\n"
        buf.append dsl
        emitDroppedZero :ast :reg :typing :ctx :n tid: rrid rcv: rcvV.stringView :ind :buf
        return
    }
    if (readsNullField :ast :reg :typing :n) then return
    deF: cfacts
    de: emitExprWith :ast :reg :typing :ctx :n facts: deF
    flushArgHoists :ctx :ind :tmp :buf
    if deF.failed then {
        emitFail :ctx what: "unhandled statement".string line: (ztypecheck.nodeLine :n)
    } else {
        drtid: stampIdOf :typing nid: (interpPartNodeId :n)
        (
            emitDiscardedResult
            :ast
            :reg
            :typing
            :ctx
            nid: (zast.nodeIdOf :n)
            ce: de.stringView
            rtid: drtid
            :ind
            :buf
        )
    }
    return
}

# emitBreakStmt -- `break`: the destroys it owes (emitBreakFrees), then the
# goto.
emitBreakStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    emitBreakFrees :ast :reg :typing :ctx :tmp :ind :buf
    if ctx.loops.length > 0 then {
        noteFrameLeft :ctx idx: ctx.loops.length - 1
        bid: (ctx.loops.get i: ctx.loops.length - 1).id
        lbkg: "\{ind}goto __zbrk_\{bid};\n"
        buf.append lbkg
        ubk: true
        ctx.breakLabelUsed.set key: bid value: ubk
    } else {
        lbk: "\{ind}break;\n"
        buf.append lbk
    }
}

# emitContinueStmt -- `continue`, and the bare atom that is neither `break` nor
# `continue` and so is a statement whose value is discarded.
emitContinueStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    # the keyword's name id
    bkwId: zast.nameid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    if bkwId == zast.wellKnown.slot.wkContinue then {
        # inside a do{}while(0) block wrapper a C continue exits
        # the wrapper, not the loop: jump to the nearest LOOP
        # entry's __zcont label instead (frees since that loop).
        inDo: false
        loopIdx: u64
        hasLoop: false
        li: ctx.loops.length
        if li > 0 then {
            if (ctx.loops.get i: li - 1).isDo then inDo = true
            sj: li
            for sj > 0 loop {
                sj = sj - 1
                if (ctx.loops.get i: sj).isDo.not when hasLoop.not then {
                    loopIdx = sj
                    hasLoop = true
                }
            }
        }
        if hasLoop then noteFrameLeft :ctx idx: loopIdx
        if inDo when hasLoop then {
            emitContinueFrees :ast :reg :typing :ctx :tmp idx: loopIdx :ind :buf
            cid: (ctx.loops.get i: loopIdx).id
            lcg: "\{ind}goto __zcont_\{cid};\n"
            buf.append lcg
            ucn: true
            ctx.contLabelUsed.set key: cid value: ucn
        } else {
            emitBreakFrees :ast :reg :typing :ctx :tmp :ind :buf
            postId: u64
            post: false
            if ctx.loops.length > 0 then {
                pf0: ctx.loops.get i: ctx.loops.length - 1
                post = pf0.postTest
                postId = pf0.id
            }
            # a C `continue` would skip the postconditions' test
            if post then {
                buf.append "\{ind}goto __zcont_\{postId};\n"
                ctx.contLabelUsed.set key: postId value: true
            } else {
                lct: "\{ind}continue;\n"
                buf.append lct
            }
        }
    } else {
        ueF: cfacts
        ue: emitExprWith :ast :reg :typing :ctx :n facts: ueF
        flushArgHoists :ctx :ind :tmp :buf
        if ueF.failed then {
            (
                emitFail
                :ctx
                what: "unhandled statement".string
                line: (ztypecheck.nodeLine :n)
            )
        } else {
            urtid: stampIdOf :typing nid: (interpPartNodeId :n)
            (
                emitDiscardedResult
                :ast
                :reg
                :typing
                :ctx
                nid: (zast.nodeIdOf :n)
                ce: ue.stringView
                rtid: urtid
                :ind
                :buf
            )
        }
    }
}

# isNullValueAtom -- a bare name the checker stamped with the null type: the null
# value written as a statement, which does nothing. A record that a program names
# `null` is no null type, and its bare name is emitted like any other.
isNullValueAtom: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view n: astnode.view
} out bool is {
    match (
        n
    ) case atomid then {
        return (stampIsNullType :reg :typing nid: n.nodeid)
    } else {
        return false
    }
}

# stampIsNullType -- the checker stamped the bare name `nid` with the null type
# as its value: the null value itself, not a call of an out-less function, whose
# result wears the same stamp (autoCallNodes)
stampIsNullType: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view nid: zast.nodeid
} out bool is {
    if (typing.autoCallNodes.has item: nid) then return false
    t: stampIdOf :typing :nid
    if t.isZero then return false
    return (reg.typetypeOf typeId: t) == ztypes.ztypetype.nullType
}

# emitReturnStmt -- the statement shapes that are not one of the named node arms:
# a `return` with its scope cleanup, `break` / `continue` with theirs, and a bare
# expression statement.
emitReturnStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    # the null value as a statement (`then null`, a bare `null` line) does nothing
    if (isNullValueAtom :reg :typing :n) then return
    # a no-arg method auto-call in statement position (this.accept,
    # this.statepop) is a dotted path: emit the call expression as a statement.
    # Tested through a binding, so `n` stays the whole node the call takes.
    isPath: n.dottedpath
    if isPath then {
        emitDottedAutoCallStmt :ast :reg :typing :ctx :n :ind :tmp :buf
        return
    }
    # a bare no-arg function call as a statement (`check_mode`): the checker
    # marked the atom auto-called (autoCallNodes) and its declaration is the
    # function; emit the call expression as a statement. A native one is a
    # builtin the legs below spell (`return`, `break`, `continue`).
    ffid: ztypes.tid
    {
        anid: interpPartNodeId :n
        if (typing.autoCallNodes.has item: anid) then {
            ard: (typing.refDecl.get key: anid).or d: ztypes.declid
            if ard.notZero then ffid = typing.declTypeOf declId: ard
        }
    }
    if ffid.notZero when (reg.typetypeOf typeId: ffid) == ztypes.ztypetype.functionType when (
        reg.isNativeOf
        tid: ffid
    ).not then {
        fceF: cfacts
        fce: emitExprWith :ast :reg :typing :ctx :n facts: fceF
        flushArgHoists :ctx :ind :tmp :buf
        if fceF.failed.not then {
            artid: stampIdOf :typing nid: (interpPartNodeId :n)
            (
                emitDiscardedResult
                :ast
                :reg
                :typing
                :ctx
                nid: (zast.nodeIdOf :n)
                ce: fce.stringView
                rtid: artid
                :ind
                :buf
            )
            return
        }
    }
    # bare control keywords parse as an AtomId reference (no value): a
    # no-value `return` (goto L_done inside a generator), `break`, `continue`.
    bkwId: zast.atomNameIdOf :n
    outerExit: ctx.exitNode
    ctx.exitNode = interpPartNodeId :n
    if bkwId == zast.wellKnown.slot.wkReturn then {
        ctx.returnEmitted = true
        if ctx.genActive then {
            emitExitDestroy :ast :reg :typing :ctx :ind :buf
            lgd: "\{ind}goto L_done;\n"
            buf.append lgd
        } else {
            emitReturnCleanup :ast :reg :typing :ctx :tmp :ind :buf
            lrt: "\{ind}return;\n"
            buf.append lrt
        }
    } else {
        if bkwId == zast.wellKnown.slot.wkBreak then {
            emitBreakStmt :ast :reg :typing :ctx :ind :tmp :buf
        } else {
            emitContinueStmt :ast :reg :typing :ctx :n :bkwId :ind :tmp :buf
        }
    }
    ctx.exitNode = outerExit
}

# reassignRhsText -- the C text of a reassignment's value: a copy hoist, an
# interpolation statement value, else the loaded expression.
reassignRhsText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    valueNode: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    facts: cfacts.borrow
} out String is {
    rcph: copyRvalueHoist :ast :reg :typing :ctx n: valueNode :facts
    if rcph.length > 0 then return rcph
    rvi: emitInterpStmtValue :ast :reg :typing :ctx n: valueNode :ind :tmp :buf :facts
    if rvi.length > 0 then return rvi
    return (valueExprC :ast :reg :typing :ctx n: valueNode :facts)
}

# reassignTargetC -- the C type a reassignment target is held as: the String
# struct for a String, else the type's reference, a pointer for a heap
# collection.
reassignTargetC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the target's node and (chased) type
    rtnid: zast.nodeid
    rtsid: ztypes.tid
} out String is {
    if (stampIsStr :typing :ctx nid: rtnid) then {
        return (strTypeC :ctx)
    }
    rrt: typeRefC :ast :reg :typing :ctx tid: rtsid
    if (isHeapPtrCollection :reg :typing :ctx tid: rtsid) then return "\{rrt}*"
    return rrt
}

# emitReassignDestroy -- free what the target held before it is overwritten:
# a String's buffer, a heap collection or a box through its pointer, any other
# destructor-bearing value by address. Nothing for a value that owns no heap.
emitReassignDestroy: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the target's C lvalue
    nm2: StringView
    rtnid: zast.nodeid
    rtsid: ztypes.tid
    ind: StringView
    buf: String.borrow
} is {
    if (stampIsStr :typing :ctx nid: rtnid) then {
        preludeNeed :ctx memb: "@String_free"
        buf.append "\{ind}\{ctx.strC}_free(&\{nm2});\n"
        return
    }
    buf.append (destroyLineC :reg :typing :ctx tid: rtsid nm: nm2 :ind)
}

# movedZeroC -- what a value of type tid that was moved out or destroyed is
# overwritten with so its own scope-exit destroy no-ops: NULL where the value
# is the pointer its destroy frees (valueIsItsPointer), else the zeroed struct
# of its destroy target, which a typedef shares; empty when it owns nothing.
movedZeroC: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} out String is {
    dt: destroyTargetTid :reg :typing :ctx :tid
    if dt.isZero then return String
    if (valueIsItsPointer :reg :typing :ctx tid: dt) then return "NULL".string
    if dt == ctx.strTid then {
        strT: strTypeC :ctx
        return "(\{strT}){0}"
    }
    return "(\{ctxCnameView :ctx tid: dt}_t){0}"
}

# zeroValueC -- the empty value of type tid in C, whether or not it owns
# anything: movedZeroC's for a value with a destroy, the zeroed value of its C
# type for one without. What a moved-out field reads as, and what a slot
# starts from.
zeroValueC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} out String is {
    mz: movedZeroC :reg :typing :ctx :tid
    if mz.length > 0 then return mz
    zct: typeRefC :ast :reg :typing :ctx :tid
    return "(\{zct}){0}"
}

# reassignMoveSource -- the local a stored value MOVES out of, empty when it is
# not a move: an explicit `<local>.take` / `.hold` (a dotted path, which
# implicitTakeSource -- bare names only -- does not see; without this the
# source keeps its buffer and frees it again at scope exit, after the target
# has), or the bare owned local a generator local's binding stores. A
# reassignment's bare local is a borrow the checker refused.
reassignMoveSource: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    valueNode: astnode.view
} out String is {
    zsrc: implicitTakeSource :ast :reg :typing :ctx n: valueNode
    if zsrc.length > 0 then return zsrc
    mmb: moveMarkerBase :ast n: valueNode
    if mmb.isZero then return zsrc
    return (implicitTakeSource :ast :reg :typing :ctx n: (ast.nodes.get i: mmb))
}

# emitMovedArgZeroing -- args moved into a construction/call RHS (e.g.
# `v.f = Option.some bo`) are consumed by it: each moved source is invalidated
# so its scope-exit free no-ops (mirrors the binding case; disjoint from the
# bare-local move, which a construction RHS never matches).
emitMovedArgZeroing: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    buf: String.borrow
} is {
    emitValueTakeInvalidations :ast :reg :typing :ctx :n :ind :buf
    emitNarrowedTakeZero :ast :reg :typing :ctx :n :ind :buf
}

# emitReassignStmt -- `x = <value>`: the old value is freed where the binding owns
# heap, the new one is stored, and a move source is zeroed so its scope-exit free
# becomes a no-op.
emitReassignStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.reassignmentrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    if (typing.repoints.has item: n.nodeid) then {
        emitRepointStmt :ast :reg :typing :ctx :n :ind :tmp :buf
        return
    }
    topathNode: ast.nodes.get i: n.topath
    nm2: emitReassignLvalue :ast :reg :typing :ctx n: topathNode
    rtnid: interpPartNodeId n: topathNode
    # a collection-typedef lvalue (Bytes) stores and destroys as its
    # chased underlying mono, exactly like the binding path
    rtsid: (
        chaseAggregateTypedef
        :reg
        :typing
        :ctx
        tid: (reassignDestroyTid :ast :reg :typing n: topathNode nid: rtnid)
    )
    # a local's old value dies as the checker recorded it: not when it was
    # moved away, nor when the local owns nothing; a field's always does, and
    # so does that of a name a loop's header binds, which is no variable of
    # the checker's
    destroyOld: true
    if topathNode.atomid when (atomVid :typing nid: rtnid).notZero then {
        destroyOld = namedDestroyOwes :typing nid: n.nodeid
    }
    (
        emitStoreTo
        :ast
        :reg
        :typing
        :ctx
        nm2: nm2.stringView
        :rtnid
        :rtsid
        valueNode: (ast.nodes.get i: n.value)
        :destroyOld
        :ind
        :tmp
        :buf
    )
}

# emitRepointCompanion -- the companion of the borrow `vid` (the checker's
# repointCompanion), when it has one: declared empty beside it, and destroyed
# where the checker records its scope's end, as an owned local's binding
# registers its destroy. Empty, its destroy frees nothing.
emitRepointCompanion: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    vid: ztypes.vid
    ind: StringView
    buf: String.borrow
} is {
    if vid.isZero then return
    co: typing.repointCompanion.get key: vid
    if co.none then return
    cv: co
    tid: chaseAggregateTypedef :reg :typing :ctx tid: (reg.variableTypeOf id: cv)
    nm: companionCName :ctx :ast :reg :cv
    ct: companionCType :ast :reg :typing :ctx :tid
    buf.append "\{ind}\{ct} \{nm} = \{zeroValueC :ast :reg :typing :ctx :tid};\n"
}

# companionCType -- the C type a companion of type `tid` is held as: the String
# struct, a heap collection's pointer, any other type's value.
companionCType: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} out String is {
    if tid == ctx.strTid then {
        return (strTypeC :ctx)
    }
    ct: typeRefC :ast :reg :typing :ctx :tid
    if (isHeapPtrCollection :reg :typing :ctx :tid) then ct.append "*"
    return ct
}

# emitRepointStmt -- `x = v` re-pointing the borrowed `x` (the checker's
# repoints). A borrow the C holds as a pointer -- an alias `(*__borrow_x)`, a
# pointer parameter -- is given the address of the storage `v` names (a
# `.borrow` marker names the path under it); any other borrow -- a view, a
# borrowed box, a collection's own pointer -- is its value, stored whole.
# Nothing is freed and no source is zeroed: `x` owns nothing.
emitRepointStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.reassignmentrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    topathNode: ast.nodes.get i: n.topath
    tgt: emitReassignLvalue :ast :reg :typing :ctx n: topathNode
    xv: atomVid :typing nid: (atomNodeId n: topathNode)
    ptr: String
    tv: tgt.stringView
    # a borrow alias re-points the pointer it reads through
    ap: vvPtrOf xs: ctx.aliases vid: xv
    if ap.length > 0 then {
        ptr.append ap
    } else if (isPtrVid :ctx vid: xv) then {
        ptr.append tv
    }
    if (typing.ownedRepoints.has item: n.nodeid) then {
        (
            emitOwnedRepoint
            :ast
            :reg
            :typing
            :ctx
            :n
            :xv
            ptr: ptr.stringView
            tgt: tgt.stringView
            :ind
            :tmp
            :buf
        )
        return
    }
    base: ast.nodes.get i: (underBorrowMarker :ast :typing nid: n.value)
    rvm: emitExpr :ast :reg :typing :ctx n: base
    flushArgHoists :ctx :ind :tmp :buf
    if ptr.length > 0 then {
        addr: "&"
        if (pathIsPointer :ast :reg :typing :ctx n: base) then addr = ""
        buf.append "\{ind}\{ptr} = \{addr}\{rvm};\n"
        return
    }
    buf.append "\{ind}\{tgt} = \{rvm};\n"
}

# companionCName -- the C name of a borrow's re-point companion: one per
# borrow, so a function with two holds two, and the readable scheme spells
# each with its own id
companionCName: function {
    ctx: Ctx.view
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    cv: ztypes.vid
} out String is {
    return (varCName :ctx :ast :reg vid: cv)
}

# emitOwnedRepoint -- `x = v` re-pointing the borrowed `x` at an owned value
# (the checker's ownedRepoints): the value runs first, into a temporary -- it
# may read `x`, which may still refer to the companion -- then `x`'s companion
# frees what it held and takes the value, the sources the value moved out of
# are zeroed, and `x` refers to it: a pointer `x` takes its address, a borrow
# held by value copies it.
emitOwnedRepoint: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.reassignmentrow.view
    # the borrow, and the pointer the C holds it as ("" when it is held by value)
    xv: ztypes.vid
    ptr: StringView
    # the borrow's lvalue
    tgt: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    co: typing.repointCompanion.get key: xv
    if co.none then return
    cv: co
    tid: chaseAggregateTypedef :reg :typing :ctx tid: (reg.variableTypeOf id: cv)
    cn: companionCName :ctx :ast :reg :cv
    valueNode: ast.nodes.get i: n.value
    facts: cfacts
    rv: reassignRhsText :ast :reg :typing :ctx :valueNode :ind :tmp :buf :facts
    flushArgHoists :ctx :ind :tmp :buf
    rrn: tmpNext :ctx :tmp
    ct: companionCType :ast :reg :typing :ctx :tid
    buf.append "\{ind}\{ct} _rr\{rrn} = \{rv};\n"
    buf.append (destroyLineC :reg :typing :ctx :tid nm: cn.stringView :ind)
    buf.append "\{ind}\{cn} = _rr\{rrn};\n"
    emitMovedArgZeroing :ast :reg :typing :ctx n: valueNode :ind :buf
    if ptr.length > 0 then {
        addr: "&"
        if (isHeapPtrCollection :reg :typing :ctx :tid) then addr = ""
        buf.append "\{ind}\{ptr} = \{addr}\{cn};\n"
        return
    }
    buf.append "\{ind}\{tgt} = \{cn};\n"
}

# namedDestroyOwes -- whether the `.drop` or the reassignment at `nid` destroys
# the value its local holds: the checker recorded one there (exitDestroy) for
# a local that owns what it holds, and the local was not moved away first.
namedDestroyOwes: function {typing: ztyping.ZTyping.view nid: zast.nodeid} out bool is {
    rg: typing.exitDestroy.get key: nid
    if rg.none then return false
    return (typing.destroyItems.get i: rg.start).state != 1
}

# emitStoreTo -- store a value into the C lvalue `nm2`, replacing what it held:
# the value runs first (into a temporary when it is no lvalue and the target
# owns heap), the old value is freed when it is owed (`destroyOld`), the new
# one written, and every source the value moved out of is zeroed so its own
# free no-ops. `rtnid` and `rtsid` are the target's stamped node and chased
# type.
emitStoreTo: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nm2: StringView
    rtnid: zast.nodeid
    rtsid: ztypes.tid
    valueNode: astnode.view
    destroyOld: bool
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    rv2F: cfacts
    rv2: (
        standInText
        :ast
        :reg
        :typing
        :ctx
        n: valueNode
        text: (reassignRhsText :ast :reg :typing :ctx :valueNode :ind :tmp :buf facts: rv2F)
        facts: rv2F
    )
    # the RHS walk may have recorded _ah arg hoists: declare them HERE,
    # before the assignment line that uses them (they would otherwise
    # flush at a later statement, after -- and outside -- this scope)
    flushArgHoists :ctx :ind :tmp :buf
    rdrop: (stampIsStr :typing :ctx nid: rtnid) or (ownsResources :reg :ctx tid: rtsid)
    ran: false
    if rdrop when rv2F.place.not then {
        rrt: reassignTargetC :ast :reg :typing :ctx :rtnid :rtsid
        rrn: tmpNext :ctx :tmp
        buf.append "\{ind}\{rrt} _rr\{rrn} = \{rv2};\n"
        rv2 = "_rr\{rrn}"
        # the value has run: the sources it moved out of are zeroed now, before
        # the target's old value is freed -- a source may BE the target
        # (`a = (wrap s: a.take)`), whose buffer the value now holds
        emitMovedArgZeroing :ast :reg :typing :ctx n: valueNode :ind :buf
        ran = true
    }
    if destroyOld then emitReassignDestroy :reg :typing :ctx :nm2 :rtnid :rtsid :ind :buf
    buf.append "\{ind}\{nm2} = \{rv2};\n"
    # a `<obj>.field.take` RHS of a reftype that owns nothing -- the one field
    # that moves -- leaves the field empty (mirrors the binding case). A
    # valtype's take, a function reference's among them, copies its bytes and
    # leaves the field as it is.
    rftnid: interpPartNodeId n: valueNode
    if (fieldMoveEmpties :ast :reg n: valueNode tid: rtsid) then {
        buf.append "\{ind}\{rv2} = \{zeroValueC :ast :reg :typing :ctx tid: rtsid};\n"
    }
    if ran.not then emitMovedArgZeroing :ast :reg :typing :ctx n: valueNode :ind :buf
    # a value that moves an owned local -- its `.take`, or the bare local a
    # generator local's binding stores -- leaves it empty: zero the source so
    # its scope-exit free no-ops (the lvalue -- a local or a struct field
    # appended into a container -- now owns the heap). Scalars/valtypes have
    # no destructor and are left untouched.
    zsrc: reassignMoveSource :ast :reg :typing :ctx :valueNode
    if zsrc.length > 0 when (movedSourceNeedsZero :ast :typing n: valueNode) then {
        zid: stampIdOf :typing nid: rftnid
        zt: movedZeroC :reg :typing :ctx tid: zid
        if zt.length > 0 then buf.append "\{ind}\{zsrc} = \{zt};\n"
    }
}

# emitForStmt -- a `for` in statement position: the iteration form comes from what
# the checker resolved its condition to -- an iterator object, a bare boolean
# while, or a counted range.
emitForStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.forrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    # a precondition the fold proved false: the loop never runs, and its body
    # was not walked
    entry: (foldedLoopOf :typing nid: n.nodeid).entry
    if entry == ztyping.loopentry.never then return
    # a loop no precondition can stop runs its body as surely as a winning
    # branch does, so an `error` in its first iteration is reached
    condBump: 1.u64
    if entry == ztyping.loopentry.always then condBump = 0
    ctx.condDepth = ctx.condDepth + condBump
    # a plain binding is evaluated at every iteration; everything below is an
    # `each` binding's walk or a loop with no binding
    if (emitPlainBindingFor :ast :reg :typing :ctx m: n :ind :tmp :buf) then {
        ctx.condDepth = ctx.condDepth - condBump
        return
    }
    # THE COUNTED RANGE IS ASKED FIRST. An integer range is an ordinary
    # iterator -- it has a `call` returning an optionval like any other -- so
    # the object path matches it too, and asked first it would construct a
    # cursor and step it where the compiler can just count. Both emit the same
    # loop; only one of them emits no object.
    #
    # It cannot capture a container: emitIntRangeFor bails unless rangeCType
    # answers, and that is the RECEIVER's integer width, which a List or a Map
    # does not have.
    #
    # A loop the fold stops after one iteration skips it: a C `for` whose body
    # always breaks has a step no path reaches.
    runsOnce: (foldedLoopOf :typing nid: n.nodeid).end == ztyping.loopend.once
    if runsOnce.not when (emitIntRangeFor :ast :reg :typing :ctx m: n :ind :tmp :buf) then {
        ctx.condDepth = ctx.condDepth - condBump
        return
    }
    if (emitObjIterFor :ast :reg :typing :ctx m: n :ind :tmp :buf) then {
        ctx.condDepth = ctx.condDepth - condBump
        return
    }
    # do-while: no pre-conditions, a post-condition (`for loop {...} while C`).
    if n.conditions.count.u64 == 0 when n.postconditions.count.u64 > 0 then {
        emitDoWhileFor :ast :reg :typing :ctx :n :ind :tmp :buf
        ctx.condDepth = ctx.condDepth - condBump
        return
    }
    # a condition that SUSPENDS, or that MOVES an owned local, cannot be
    # written in the `while (...)` header: the suspension and the zeroing have
    # to land on statements, and they have to run once per iteration, not once
    # before the loop. `while (1) { <steps>; if (!c) break; ... }` is the same
    # loop with the condition moved to where both hold -- which is exactly how
    # the condition would be hand-written to make this work, and it is why a
    # `goto` back into the loop body still lands correctly on resume.
    suspends: forCondSuspends :ast :ctx :n
    stepped: condsNeedSteps :ast :reg :typing :ctx :suspends conds: n.conditions
    # the HEADER's scope owns what its conditions register: the marks are
    # taken before them and closed after the loop, so those rows are the
    # header scope's to emit and to pop, not the enclosing block's
    lLh: tmp.listFrees.length
    lidW: pushLoopLabel :ctx :tmp isDo: false postTest: n.postconditions.count.u64 > 0
    bodyInd: "\{ind}    "
    if stepped then {
        emitSteppedWhileHead :ast :reg :typing :ctx :n :ind bodyInd: bodyInd.stringView :tmp :buf
    } else {
        emitPlainWhileHead :ast :reg :typing :ctx :n :ind :tmp :buf
    }
    lLw: tmp.listFrees.length
    dvG: false
    if n.body.notZero then {
        fbw: ast.nodes.get i: n.body
        emitBodyNode :ast :reg :typing :ctx n: fbw ind: bodyInd.stringView :tmp :buf
        dvG = blockDiverges :ast :reg :typing :ctx n: fbw
    }
    closeScopeBlock :ast :reg :typing :ctx :tmp lL: lLw diverged: dvG node: n.body :buf
    (
        emitIterationEnd
        :ast
        :reg
        :typing
        :ctx
        m: n
        id: lidW
        diverged: dvG
        ind: bodyInd.stringView
        :tmp
        :buf
    )
    lwc: "\{ind}}\n"
    buf.append lwc
    popLoopLabel :ctx id: lidW :ind :buf
    # the temporaries the conditions registered are released where the loop
    # ends, AFTER the break label: both the path that falls out and the path
    # that jumps reach it there
    flushBlockFrees :tmp lL: lLh diverged: false :buf
    ctx.condDepth = ctx.condDepth - condBump
}

# emitDoWhileFor -- `for loop { .. } while C`: no pre-conditions and at
# least one post-condition, which is a do-while.
emitDoWhileFor: function {
    # the tree the body and conditions are read from
    ast: Ast.view
    # the stamps the condition text is built against
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the emit context, which carries the loop labels
    ctx: Ctx
    # the for node being emitted
    n: zast.forrow.view
    # the indent the loop is written at
    ind: StringView
    # the temp counter the body's frees are registered against
    tmp: TmpCtr
    # the do-while opening, its body and its trailing test all append here
    buf: String.borrow
} is {
    lidDW: pushLoopLabel :ctx :tmp isDo: false postTest: false
    # a postcondition that moves, or holds a control value, computes into a
    # guard the trailing test reads, declared where that test can see it. One
    # the fold settled writes a constant test instead, and runs none of them
    stepped: (
        ((foldedLoopOf :typing nid: n.nodeid).end == ztyping.loopend.runtime) and
        (condsNeedSteps :ast :reg :typing :ctx suspends: false conds: n.postconditions)
    )
    gvD: String
    if stepped then gvD = newCondGuard :ctx :ind :buf
    # the body is written into its own buffer: the trailing test is built after
    # it, and the temporaries the test records are declared ahead of `do {`, as
    # a while loop's are ahead of `while`
    body: String
    ind2d: "\{ind}    "
    lLd: tmp.listFrees.length
    dvG: false
    if n.body.notZero then {
        fbd: ast.nodes.get i: n.body
        emitBodyNode :ast :reg :typing :ctx n: fbd ind: ind2d.stringView :tmp buf: body
        dvG = blockDiverges :ast :reg :typing :ctx n: fbd
    }
    closeScopeBlock :ast :reg :typing :ctx :tmp lL: lLd diverged: dvG node: n.body buf: body
    emitContLabel :ctx id: lidDW ind: ind2d.stringView buf: body
    tail: String
    if stepped then {
        (
            emitSteppedCond
            :ast
            :reg
            :typing
            :ctx
            conds: n.postconditions
            gvar: gvD.stringView
            inLoop: true
            ind: ind2d.stringView
            :tmp
            buf: body
        )
        tail.append "\{ind}} while (\{gvD});\n"
    } else {
        pcond: doWhileCondText :ast :reg :typing :ctx :n
        cwP: condInParens cond: pcond.stringView
        tail.append "\{ind}} while \{cwP};\n"
        # the test assigns and releases them itself, so the loop owes nothing
        flushArgHoists :ctx :ind :tmp :buf
    }
    buf.append "\{ind}do {\n"
    buf.append body
    buf.append tail
    popLoopLabel :ctx id: lidDW :ind :buf
}

# doWhileCondText -- a do-while's trailing test as one `&&` chain, a condition
# that folds true writing nothing. A constant when the fold settled the test.
doWhileCondText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.forrow.view
} out String is {
    pcond: String
    end: (foldedLoopOf :typing nid: n.nodeid).end
    if end == ztyping.loopend.always then return "1".string
    if end == ztyping.loopend.once then return "0".string
    for each pk: (zast.kidsOf :ast span: n.postconditions) loop {
        if (condFoldsTrue :typing nid: pk).not then {
            pkn: ast.nodes.get i: pk
            # the checker stamps the OPERATION node, so unwrap the same way
            pkop: pk
            if pkn.namedoperation then pkop = pkn.operation
            # the trailing test runs at every iteration, so it is evaluated in place
            mk8: openInPlace :ctx guarded: true
            pcvF: cfacts
            pcv: valueExprC :ast :reg :typing :ctx n: pkn facts: pcvF
            tw8: (
                truthyCondText
                :ast
                :reg
                :typing
                :ctx
                n: (ast.nodes.get i: pkop)
                raw: pcv.stringView
            )
            if tw8.length > 0 then pcv = tw8.take
            if pcond.length > 0 then pcond.append " && "
            appendInPlaceCond :ctx mark: mk8 text: pcv.stringView dst: pcond
        }
    }
    if pcond.length == 0 then pcond.append "0"
    return pcond
}

# emitIterationEnd -- where one iteration of the loop `m` ends: what the checker
# recorded the `for` scope's end destroys (scopeDestroy) -- the element an
# owning binding holds -- and the continue label `id`. A loop without
# postconditions destroys first, on the path that falls out of its body
# (`diverged` says there is none): its `continue` destroyed what it listed and
# jumps past. A loop with postconditions tests them at the label, which every
# `continue` of it jumps to, and destroys after the test on both of its ways
# out, since the test may read the element.
emitIterationEnd: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: zast.forrow.view
    id: u64
    diverged: bool
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    if m.postconditions.count.u64 == 0 then {
        if diverged.not then emitScopeDestroy :ast :reg :typing :ctx node: m.nodeid :ind :buf
        emitContLabel :ctx :id :ind :buf
        return
    }
    emitContLabel :ctx :id :ind :buf
    owed: String
    emitScopeDestroy :ast :reg :typing :ctx node: m.nodeid :ind buf: owed
    end: (foldedLoopOf :typing nid: m.nodeid).end
    if end == ztyping.loopend.always then {
        buf.append owed
        return
    }
    if end == ztyping.loopend.once then {
        buf.append owed
        buf.append "\{ind}break;\n"
        return
    }
    test: String
    if (condsNeedSteps :ast :reg :typing :ctx suspends: false conds: m.postconditions) then {
        gv: newCondGuard :ctx :ind :buf
        (
            emitSteppedCond
            :ast
            :reg
            :typing
            :ctx
            conds: m.postconditions
            gvar: gv.stringView
            inLoop: true
            :ind
            :tmp
            :buf
        )
        test = gv.take
    } else {
        pcond: doWhileCondText :ast :reg :typing :ctx n: m
        # the test assigns and releases its hoists itself
        flushArgHoists :ctx :ind :tmp :buf
        test = condInParens cond: pcond.stringView
    }
    if owed.length == 0 then {
        buf.append "\{ind}if (!\{test}) break;\n"
        return
    }
    inner: "\{ind}    "
    buf.append "\{ind}if (!\{test}) {\n"
    emitScopeDestroy :ast :reg :typing :ctx node: m.nodeid ind: inner.stringView :buf
    buf.append "\{inner}break;\n\{ind}}\n"
    buf.append owed
}

# forArmCond -- the text of a loop's `while:` arms: every condition that is
# NOT the named binding, joined. "" when there are none.
#
# A named binding drives the loop by itself -- an iterator answers `none`, a
# counted range runs out -- so the arms are a second way to leave, tested per
# iteration inside the loop rather than in a C header the binding already owns.
#
# The binding is condition ZERO whenever there is one: the parser accepts a
# name only in the first, so the callers that read `i: 0` to find it are
# reading what the grammar guarantees.
forArmCond: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.forrow.view
} out String is {
    cond: String
    for each kId: (zast.kidsOf :ast span: n.conditions) loop {
        if (forCondIsNamed :ast :kId).not then {
            emitForCond :ast :reg :typing :ctx n: (ast.nodes.get i: kId) :cond
        }
    }
    return cond
}

# emitForArmBreak -- the arms' test `armc` of the loop `node`, as the loop's
# first statement after its binding: `if (!(c)) break;`, the break after what
# the checker recorded a failing arm destroys (exitDestroy of the loop): the
# element the binding answered. Nothing when the loop has no arms.
emitForArmBreak: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    node: zast.nodeid
    armc: StringView
    ind: StringView
    buf: String.borrow
} is {
    if armc.length == 0 then return
    inner: "\{ind}    "
    owed: String
    outerExit: ctx.exitNode
    ctx.exitNode = node
    emitExitDestroy :ast :reg :typing :ctx ind: inner.stringView buf: owed
    ctx.exitNode = outerExit
    if owed.length == 0 then {
        buf.append "\{ind}if (!(\{armc})) break;\n"
        return
    }
    buf.append "\{ind}if (!(\{armc})) {\n\{owed}\{inner}break;\n\{ind}}\n"
}

# emitPlainWhileHead -- the ordinary `while (c) {` opening, where no condition
# suspends and the test can stay in the header.
emitPlainWhileHead: function {
    # the tree this loop's conditions are read from
    ast: Ast.view
    # the stamps the header text is built against
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the emit context the condition text is built in
    ctx: Ctx
    # the for node whose conditions these are
    n: zast.forrow.view
    # the indent the loop is written at
    ind: StringView
    # the frees of the hoists the header declares
    tmp: TmpCtr
    # the `while (c) {` line appends here
    buf: String.borrow
} is {
    cond: String
    for each kId: (zast.kidsOf :ast span: n.conditions) loop {
        if (forCondIsNamed :ast :kId).not then {
            emitForCond :ast :reg :typing :ctx n: (ast.nodes.get i: kId) :cond
        }
    }
    # `for loop { ... }` -- no conditions, no postconditions: an unconditional
    # loop that exits via break/return.
    if cond.length == 0 then cond.append "1"
    # the test's hoists are declared ahead of the loop and assigned at each test
    flushArgHoists :ctx :ind :tmp :buf
    cwW: condInParens cond: cond.stringView
    lw: "\{ind}while \{cwW} {\n"
    buf.append lw
}

# forCondSuspends -- one of a loop's conditions holds a suspension point, so
# the header has to be written as a body test instead.
forCondSuspends: function {ast: Ast.view ctx: Ctx.view n: zast.forrow.view} out bool is {
    if ctx.genActive.not then return false
    for each kyId: (zast.kidsOf :ast span: n.conditions) loop {
        if (zast.yieldCountIn :ast nid: kyId) > 0 then return true
    }
    return false
}

# emitSteppedWhileHead -- the opening of a loop whose CONDITION cannot be
# written in the `while (...)` header: `while (1) {`, the conditions as
# statements, then `if (!g) break;`.
#
# A suspension has to land on a statement, and a move's zeroing is one; and
# both have to run once per iteration, so neither can be hoisted above the
# loop either. Moving the test into the body satisfies both, and is the same
# loop -- it is what the condition would be hand-written as to make this
# work. A named condition is an initialiser: declared once, before the loop,
# as the plain header declares it.
emitSteppedWhileHead: function {
    # the tree this loop's conditions are read from
    ast: Ast.view
    # read for the resume type of each suspension in the condition
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # carries the state-machine cursor and the resume slots
    ctx: Ctx
    # the for node whose conditions these are
    n: zast.forrow.view
    # the indent the loop itself is written at
    ind: StringView
    # the indent inside it, where the conditions and the test go
    bodyInd: StringView
    # the free list the conditions' temps ride
    tmp: TmpCtr
    # the loop opening, the conditions and the break test all append here
    buf: String.borrow
} is {
    buf.append "\{ind}while (1) {\n"
    gv: newCondGuard :ctx ind: bodyInd :buf
    (
        emitSteppedCond
        :ast
        :reg
        :typing
        :ctx
        conds: n.conditions
        gvar: gv.stringView
        inLoop: true
        ind: bodyInd
        :tmp
        :buf
    )
    buf.append "\{bodyInd}if (!\{gv}) break;\n"
}

# emitIfStmt -- an `if` in statement position. A chain whose conditions all fold
# emits only the live branch: spec.pdoc promises the false branch is not emitted,
# and that promise is not limited to expression position.
emitIfStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.ifrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    # constant guards: when every clause folds at emit time, only the
    # winning body is emitted -- provably-dead branches (including dead
    # `error` arms) are eliminated from the C.
    efb: foldedBranchOf :typing nid: n.nodeid
    if efb.known then {
        ewb: efb.stmt
        if ewb.notZero then {
            lfo: "\{ind}{\n"
            buf.append lfo
            indE: "\{ind}    "
            lLE: tmp.listFrees.length
            ewn: ast.nodes.get i: ewb
            emitBodyNode :ast :reg :typing :ctx n: ewn ind: indE.stringView :tmp :buf
            dvF: blockDiverges :ast :reg :typing :ctx n: ewn
            (
                closeScopeBlock
                :ast
                :reg
                :typing
                :ctx
                :tmp
                lL: lLE
                diverged: dvF
                node: (branchScopeOf :ast clauses: n.clauses elseclause: n.elseclause stmt: ewb)
                :buf
            )
            lfc: "\{ind}}\n"
            buf.append lfc
        }
        return
    }
    ctx.condDepth = ctx.condDepth + 1
    ifAssign: String
    first: true
    opened: u64
    for each cId: (zast.kidsOf :ast span: n.clauses) loop {
        isFirst: first
        first = false
        c: ast.nodes.get i: cId
        opened = (
            opened +
            (
                emitIfClause
                :ast
                :reg
                :typing
                :ctx
                n: c
                :isFirst
                assignTo: ifAssign.stringView
                :ind
                :tmp
                :buf
            )
        )
    }
    chS: List String
    chV: ListVal ztypes.vid
    chA: ListVal zast.nameid
    chT: ListVal ztypes.tid
    chN: ListVal bool
    chR: List String
    chRF: ListVal cfacts
    (
        chainFactsOfClauses
        :ast
        :reg
        :typing
        :ctx
        clauses: n.clauses
        subjects: chS
        svids: chV
        arms: chA
        tids: chT
        negs: chN
        recvs: chR
        recvFs: chRF
    )
    (
        emitElse
        :ast
        :reg
        :typing
        :ctx
        oId: n.elseclause
        assignTo: ifAssign.stringView
        :ind
        :tmp
        chSubjects: chS
        chSubjectVids: chV
        chArms: chA
        chTids: chT
        chNegs: chN
        chRecvs: chR
        chRecvFs: chRF
        :buf
    )
    le: "\{ind}}\n"
    buf.append le
    # the `} else {` blocks stepped later clauses opened around themselves
    for opened > 0 loop {
        opened = opened - 1
        buf.append le
    }
    ctx.condDepth = ctx.condDepth - 1
}

# withValueCType -- the C type of a `with` binding's value, as a binding's is:
# a builtin scalar by its C name, anything else by its stamped id `wsid`. A
# value with no stamp has no type the emitter can name, and is reported.
withValueCType: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    wsid: ztypes.tid
} out String is {
    tid: wsid
    if wsid.isZero then {
        (
            emitFail
            :ctx
            what: "a `with` value the checker gave no type".string
            line: (zast.posOf :n).line
        )
        return "".string
    }
    # a builtin scalar keeps its C name, as a binding's does (bindDeclaredCType);
    # a Set or a Map is held as its pointer (slotCType)
    sc: scalarCTypeFor :typing :tid
    if sc.length > 0 then return sc
    return (slotCType :ast :reg :typing :ctx :tid)
}

# withBorrowsPlace -- a `with` binding the checker made a borrow (the unmarked
# default for a new name) of a reftype, whose value is a place: a bare name, or
# an element a List hands back by pointer (rhsIsBorrowGet) -- the binding is a
# second name for that storage, as a plain binding's is. The decision is the
# checker's, read off the binding's own variable.
withBorrowsPlace: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.withrow.view
    vid: ztypes.vid
} out bool is {
    if vid.isZero then return false
    wv: ast.nodes.get i: n.value
    if (nodeIsBareAtom n: wv).not when (rhsIsBorrowGet :ast :reg :typing :ctx n: wv
    ).not then return false
    if (reg.variableOwnershipOf id: vid) != ztypes.zownership.borrowed then return false
    return (reg.isReftypeOf tid: (reg.variableTypeOf id: vid))
}

# emitWithLocal -- the header's C local for a `with` value that lives in the
# block. A reference-returning callee hands back `T*`, so the binding ALIASES
# its source exactly as a plain binding does; anything else is the value.
emitWithLocal: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.withrow.view
    wsid: ztypes.tid
    wnm: StringView
    wct: StringView
    wv: StringView
    ind: StringView
    buf: String.borrow
} is {
    wc: wct.string
    # `with v: src.borrow`: the alias is a pointer to its source
    bmbW: rhsBorrowMarkerBase :ast :reg :typing n: (ast.nodes.get i: n.value)
    if bmbW.notZero then {
        addrW: "&"
        if (
            pathIsPointer
            :ast
            :reg
            :typing
            :ctx
            n: (ast.nodes.get i: bmbW)
        ) then addrW = ""
        lw0: "\{ind}\{wc}* __borrow_\{wnm} = \{addrW}\{wv};\n"
        buf.append lw0
        lw1: "\{ind}/* alias: \{wnm} => (*__borrow_\{wnm}) */\n"
        buf.append lw1
        bindBorrowAlias :ctx vid: (defVid :typing nid: n.nodeid) nm: wnm
        return
    }
    # `with v: src` over a name the checker made a borrow: a second name for the
    # place, as a binding's is (emitBorrowAliasBind). A struct copy shared the
    # source's buffers and lost every write through `v`.
    wvid: defVid :typing nid: n.nodeid
    if (withBorrowsPlace :ast :reg :typing :ctx :n vid: wvid) then {
        addrP: "&"
        if (pathIsPointer :ast :reg :typing :ctx n: (ast.nodes.get i: n.value)) then addrP = ""
        preludeNeed :ctx memb: "@typeof"
        lp0: "\{ind}Z_TYPEOF(\{addrP}\{wv}) __borrow_\{wnm} = \{addrP}\{wv};\n"
        buf.append lp0
        lp1: "\{ind}/* alias: \{wnm} => (*__borrow_\{wnm}) */\n"
        buf.append lp1
        bindBorrowAlias :ctx vid: wvid nm: wnm
        return
    }
    wvC: wv.string
    wrb: refBorrowCalleeFid :ast :reg :typing :ctx n: (ast.nodes.get i: n.value)
    if wrb.notZero when (fnReturnsRefBorrow :reg :typing :ctx fid: wrb retTid: wsid) then {
        wctP: refPtrC :typing tid: wrb base: wc.stringView
        wc = wctP.take
        ctx.ptrVids.append (defVid :typing nid: n.nodeid)
        wvC = (
            unloadValueStructRef
            :ast
            :reg
            :typing
            :ctx
            n: (ast.nodes.get i: n.value)
            e: wvC.stringView
        )
    }
    if wc.length > 0 then {
        lwv: "\{ind}\{wc} \{wnm} = \{wvC};\n"
        buf.append lwv
    } else {
        bindLine: "\{ind}int64_t \{wnm} = \{wvC};\n"
        buf.append bindLine
    }
}

# emitWithField -- a `with` value that lives in the state class (the checker
# minted the field for a value that crosses a suspension, genLocalFieldOf):
# assigned where the header's local was and aliased to the binding's name for
# the body. It is destroyed where the checker lists it, as any generator local
# is, and its field left empty.
emitWithField: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.withrow.view
    wf: zast.nameid
    wv: StringView
    ind: StringView
    buf: String.borrow
} is {
    fld: genFieldC :ast :reg :typing :ctx nameId: wf
    la: "\{ind}\{fld} = \{wv};\n"
    buf.append la
    (
        vvSet
        xs: ctx.aliases
        vid: (defVid :typing nid: n.nodeid)
        val: fld.stringView
        facts: (memberFacts b: pathFacts)
    )
}

# genSubjectFieldC -- the instance field a generator body's match subject is
# held in when no variable holds it (genSubjectField), with the alias that makes
# the temporary's destroy free the field; "" for any other subject.
genSubjectFieldC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nid: zast.nodeid
} out String is {
    tv: typing.tempOf.get key: nid
    if tv.none then return "".string
    gf: typing.genLocalFieldOf.get key: tv
    if gf.none then return "".string
    fld: genFieldC :ast :reg :typing :ctx nameId: gf
    vvSet xs: ctx.aliases vid: tv val: fld.stringView facts: (memberFacts b: pathFacts)
    return fld
}

# emitGenLocalBind -- a generator body's local, bound. The checker keeps it in a
# field of the instance (genLocalFieldOf), so the binding stores into that field
# as a reassignment of it would -- freeing the old value, which a loop body left
# on its previous pass -- and every later spelling of the local is the field.
# The instance's destructor frees what the field holds last.
emitGenLocalBind: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.assignmentrow.view
    nameVid: ztypes.vid
    field: zast.nameid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    fld: genFieldC :ast :reg :typing :ctx nameId: field
    rtsid: chaseAggregateTypedef :reg :typing :ctx tid: (reg.variableTypeOf id: nameVid)
    # a comprehension is built where the local lives, in the field: a loop, not
    # an expression, so there is no value to store
    vn: ast.nodes.get i: n.value
    if (forexprValue n: vn) then {
        buf.append (destroyLineC :reg :typing :ctx tid: rtsid nm: fld.stringView :ind)
        lcb: spelledCname :ctx tid: rtsid
        noteMemberUse :ctx mono: rtsid member: memberWord.slot.create
        buf.append "\{ind}\{fld} = \{lcb}_create((uint64_t)0);\n"
        (
            emitListComprehension
            :ast
            :reg
            :typing
            :ctx
            listTid: rtsid
            forNode: vn
            listCb: lcb.stringView
            listVar: fld.stringView
            :ind
            :tmp
            :buf
        )
        vvSet xs: ctx.aliases vid: nameVid val: fld.stringView facts: (memberFacts b: pathFacts)
        return
    }
    (
        emitStoreTo
        :ast
        :reg
        :typing
        :ctx
        nm2: fld.stringView
        rtnid: n.nodeid
        :rtsid
        valueNode: (ast.nodes.get i: n.value)
        # what an earlier walk of this binding left in the field
        destroyOld: true
        :ind
        :tmp
        :buf
    )
    vvSet xs: ctx.aliases vid: nameVid val: fld.stringView facts: (memberFacts b: pathFacts)
}

# emitWithStmt -- `with x: <value> do <body>` as a statement.
emitWithStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.withrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    wnoTid: ztypes.tid
    emitWithBody :ast :reg :typing :ctx :n bindTo: "" bindCt: "" bindTid: wnoTid :ind :tmp :buf
}

# withValueBlock -- the node a `with` body yields its value from. A BRACED body
# is a `do` block, not a bare statement block, so the value is its statement
# block's last line; an unbraced one is the value itself.
withValueBlock: function {n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case doexpr then {
        return n.statement
    } else {
        return (zast.nodeIdOf :n)
    }
}

# withValueNodeId -- the node whose stamp types a `with` used as an EXPRESSION.
# THE WITH NODE CARRIES THE BOUND VALUE'S TYPE, not the expression's: checkWith
# stamps it there because the binding needs it, and says so. So the expression's
# own type is its body's value -- which differs whenever the body computes
# something else, `with v: (xs.get i: 0) do "n=\{v}"` being i64 bound and String
# yielded.
withValueNodeId: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    n: zast.withrow.view
} out zast.nodeid is {
    vb: withValueBlock n: (ast.nodes.get i: n.body)
    isBlk: false
    bn: ast.nodes.get i: vb
    isBlk = bn.statement
    if isBlk.not then return vb
    lineId: ztypecheck.lastStmtLineIdAt :ast oId: vb
    if lineId.isZero then return vb
    vId: (
        ztypecheck.implicitReturnValue
        :reg
        :typing
        :ast
        :lineId
        lineType: (stampIdOf :typing nid: lineId)
    )
    if vId.isZero then return vb
    return vId
}

# controlValueStampNid -- the node whose stamp types a control value. An `if` or
# a `match` carries its own; a `with` carries the bound value's instead
# (withValueNodeId).
controlValueStampNid: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out zast.nodeid is {
    match (
        n
    ) case withexpr then {
        return (withValueNodeId :ast :reg :typing :n)
    } else {
        return (zast.nodeIdOf :n)
    }
}

# emitWithBindValue -- `s: with x: <value> do <expr>`: run the `with` with its
# body binding the local instead of being dropped. Its value IS the body's
# value, which is what makes the statement and the expression one emission with
# one difference.
emitWithBindValue: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    rtid: ztypes.tid
    nm: StringView
    ct: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    match (
        n
    ) case withexpr then {
        emitWithBody :ast :reg :typing :ctx :n bindTo: nm bindCt: ct bindTid: rtid :ind :tmp :buf
        return true
    } else {
        return false
    }
}

# emitWithBody -- `with x: <value> do <body>`: the value is bound for the body's
# duration and destroyed with the block it was bound in, whatever exit the body
# takes. The binding is emitted into the ENCLOSING C block rather than braces of
# its own, so that block's flush is where its cleanup belongs -- and inside a
# loop body that flush runs per iteration. `bindTo` names the local the body's
# value assigns to, "" when the `with` is a statement and the value is dropped.
emitWithBody: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.withrow.view
    bindTo: StringView
    # the target's C type and stamped type; unused when bindTo is ""
    bindCt: StringView
    bindTid: ztypes.tid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    wnm: varCName :ctx :ast :reg vid: (defVid :typing nid: n.nodeid)
    wsid: stampIdDeep :reg :typing n: (ast.nodes.get i: n.value)
    wct: withValueCType :ast :reg :typing :ctx n: (ast.nodes.get i: n.value) :wsid
    wv: emitExpr :ast :reg :typing :ctx n: (ast.nodes.get i: n.value)
    # a non-lvalue receiver (`with x: (mk).iterate do`) hoisted an _ahN temp
    # while that expression was built; declare it before the line that reads
    # it, as the plain-binding path does
    flushArgHoists :ctx :ind :tmp :buf
    wfO: typing.genLocalFieldOf.get key: (defVid :typing nid: n.nodeid)
    match (
        wfO
    ) case some then {
        emitWithField :ast :reg :typing :ctx :n wf: wfO wv: wv.stringView :ind :buf
    } case none then {
        (
            emitWithLocal
            :ast
            :reg
            :typing
            :ctx
            :n
            :wsid
            wnm: wnm.stringView
            wct: wct.stringView
            wv: wv.stringView
            :ind
            :buf
        )
    }
    # a `with` binds a value as an ordinary binding does: the value may be a
    # call that took ownership of an argument, so that source is zeroed here.
    # What the `with` owns is destroyed where the checker lists it, at the
    # `with`'s end (emitScopeDestroy).
    emitValueTakeInvalidations :ast :reg :typing :ctx n: (ast.nodes.get i: n.value) :ind :buf
    wbody: ast.nodes.get i: n.body
    if bindTo.length > 0 then {
        wvb: withValueBlock n: wbody
        # THE BODY MAY BE A CONTROL VALUE of its own -- an `if`, a `match` or a
        # comprehension -- and each of those binds a local its own way, so the
        # body's value asks the same dispatcher a binding of it would. Only a
        # plain value falls through to a declaration and an assignment.
        if (
            emitControlBindValue
            :ast
            :reg
            :typing
            :ctx
            vid: wvb
            rtid: bindTid
            nm: bindTo
            ct: bindCt
            :ind
            :tmp
            :buf
        ).not then {
            wbd: "\{ind}\{bindCt} \{bindTo};\n"
            buf.append wbd
            # the scope is the `with`'s own and its end is printed below, after
            # the body, exactly where the statement form prints it -- so the
            # branch closes only the temporaries it registered itself
            (
                emitBranchAssign
                :ast
                :reg
                :typing
                :ctx
                n: (ast.nodes.get i: wvb)
                target: bindTo
                scope: zast.nodeid
                :ind
                :tmp
                :buf
            )
        }
    } else {
        emitBodyNode :ast :reg :typing :ctx n: wbody :ind :tmp :buf
    }
    # the value ends with the `with`, though its line joined the enclosing C
    # block: what the checker recorded the `with`'s end destroys is spent here
    if (blockDiverges :ast :reg :typing :ctx n: wbody).not then (
        emitScopeDestroy
        :ast
        :reg
        :typing
        :ctx
        node: n.nodeid
        :ind
        :buf
    )
}

# emitCaseStmt -- a `match` in statement position, delegated to the shared arm
# emitter.
emitCaseStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.caserow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    # constant subject over literal arms: emit only the matching arm, as
    # the typechecker resolved it.
    mfb: foldedBranchOf :typing nid: n.nodeid
    if mfb.known then {
        mwb: mfb.stmt
        if mwb.notZero then {
            lmo: "\{ind}{\n"
            buf.append lmo
            indM: "\{ind}    "
            lLM: tmp.listFrees.length
            mwn: ast.nodes.get i: mwb
            emitBodyNode :ast :reg :typing :ctx n: mwn ind: indM.stringView :tmp :buf
            dvF: blockDiverges :ast :reg :typing :ctx n: mwn
            (
                closeScopeBlock
                :ast
                :reg
                :typing
                :ctx
                :tmp
                lL: lLM
                diverged: dvF
                node: (branchScopeOf :ast clauses: n.clauses elseclause: n.elseclause stmt: mwb)
                :buf
            )
            lmc: "\{ind}}\n"
            buf.append lmc
        }
        return
    }
    ctx.condDepth = ctx.condDepth + 1
    emitMatchStmt :ast :reg :typing :ctx m: n assignTo: "" :ind :tmp :buf
    ctx.condDepth = ctx.condDepth - 1
}

# emitSwapStmt -- `a >< b`: a three-step exchange through one temporary, so both
# sides keep whatever ownership they held.
emitSwapStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.swapstmtrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    lhn: ast.nodes.get i: n.lhs
    rhn: ast.nodes.get i: n.rhs
    lx: emitExpr :ast :reg :typing :ctx n: lhn
    rx: emitExpr :ast :reg :typing :ctx n: rhn
    lnid: interpPartNodeId n: lhn
    lsid: stampIdOf :typing nid: lnid
    # the temporary holds what either slot holds: a heap collection is its pointer
    lct: slotCType :ast :reg :typing :ctx tid: lsid
    if lct.length == 0 then {
        failMsg: "zemitterc: unspellable swap operand type id \{lsid}"
        panic failMsg
    }
    sN: tmpNext :ctx :tmp
    s0: "\{ind}{\n"
    buf.append s0
    s1: "\{ind}    \{lct} _sw\{sN} = \{lx};\n"
    buf.append s1
    s2: "\{ind}    \{lx} = \{rx};\n"
    buf.append s2
    s3: "\{ind}    \{rx} = _sw\{sN};\n"
    buf.append s3
    s4: "\{ind}}\n"
    buf.append s4
}

# emitDoStmt -- a `do` block in statement position: its own C scope, so the locals
# it binds are freed at its end.
emitDoStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dorow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    if (ztypecheck.blockHasBreak :ast n: (ast.nodes.get i: n.statement)) then {
        ldo: "\{ind}do {\n"
        buf.append ldo
        indd: "\{ind}    "
        # the block is its own break target: a break inside frees the
        # block's owned temps (since these marks) and lands after the
        # block, not on an enclosing loop's label
        sdoId: pushLoopLabel :ctx :tmp isDo: true postTest: false
        slL: tmp.listFrees.length
        dst: ast.nodes.get i: n.statement
        emitBodyNode :ast :reg :typing :ctx n: dst ind: indd.stringView :tmp :buf
        dvF: blockDiverges :ast :reg :typing :ctx n: dst
        closeScopeBlock :ast :reg :typing :ctx :tmp lL: slL diverged: dvF node: n.nodeid :buf
        lwh: "\{ind}} while (0);\n"
        buf.append lwh
        popLoopLabel :ctx id: sdoId :ind :buf
    } else {
        # the block's lines join the enclosing C block, but its locals end with
        # it: what the checker recorded its end destroys is spent here -- not
        # when its last line returned the body's value (a `with` block in
        # return position), whose return freed them
        body: ast.nodes.get i: n.statement
        emitBodyNode :ast :reg :typing :ctx n: body :ind :tmp :buf
        if (blockDiverges :ast :reg :typing :ctx n: body).not when ctx.tailReturned.not then (
            emitScopeDestroy
            :ast
            :reg
            :typing
            :ctx
            node: n.nodeid
            :ind
            :buf
        )
    }
}


# emitStmt -- one statement of a function body.
emitStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    tL: tmp.listFrees.length
    emitStmtParts :ast :reg :typing :ctx :n :ind :tmp :buf
    releaseStatementTemps :ast :reg :typing :ctx :n :tmp from: tL :buf
}

# releaseStatementTemps -- the temporaries a statement line's arguments needed
# end with the statement: their releases are emitted after it, and dropped from
# the block's. A line the checker records as holding one -- a binding still
# locks it -- keeps them to the end of the block, and a line that diverges has
# released them already, on its way out.
releaseStatementTemps: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    n: astnode.view
    tmp: TmpCtr
    # the block's releases owed before the statement began
    from: u64
    buf: String.borrow
} is {
    if tmp.listFrees.length <= from then return
    anyTemp: false
    i: from
    for i < tmp.listFrees.length loop {
        if (tmp.listFrees.get :i).temp then anyTemp = true
        i = i + 1
    }
    if anyTemp.not then return
    lineId: zast.nodeid
    match (
        n
    ) case statementline then {
        lineId = n.nodeid
    } else {
        return
    }
    if (typing.tempHoldingLines.has item: lineId) then {
        releaseUnheldTemps :typing :tmp :from :buf
        return
    }
    live: (stmtDiverges :ast :reg :typing :ctx sid: lineId).not
    kept: List OwedFree
    for tmp.listFrees.length > from loop {
        o: tmp.listFrees.pop
        if o.temp then {
            if live then buf.append o.stmt
        } else {
            kept.append o
        }
    }
    for kept.length > 0 loop tmp.listFrees.append kept.pop
}

# releaseUnheldTemps -- a line a binding holds keeps its temporaries past the
# statement, but only the ones something holds: a temporary the checker
# recorded as unheld still ends with its statement. An untagged one is
# kept.
releaseUnheldTemps: function {
    typing: ztyping.ZTyping.view
    tmp: TmpCtr
    from: u64
    buf: String.borrow
} is {
    kept: List OwedFree
    for tmp.listFrees.length > from loop {
        o: tmp.listFrees.pop
        if o.temp when o.tag.notZero when (typing.unheldTemps.has item: o.tag) then {
            buf.append o.stmt
        } else {
            kept.append o
        }
    }
    for kept.length > 0 loop tmp.listFrees.append kept.pop
}

# emitDropReleasedTemps -- a `.drop` of a binding that released the last borrow
# of a temporary destroys it there, and leaves it zero so the block's own
# destroy of it does nothing.
emitDropReleasedTemps: function {
    typing: ztyping.ZTyping.view
    tmp: TmpCtr
    dropNid: zast.nodeid
    ind: StringView
    buf: String.borrow
} is {
    for each dt: typing.dropTemps loop {
        if dt.dropNid == dropNid then {
            for each o: tmp.listFrees loop {
                if o.tag == dt.temp when o.zero.length > 0 then {
                    buf.append o.stmt
                    zl: "\{ind}\{o.zero}\n"
                    buf.append zl
                }
            }
        }
    }
}

# emitStmtParts -- one statement, whatever its shape.
emitStmtParts: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    # a suspension point is a CALL now, so it is intercepted before the match
    # rather than owning an arm -- adding a `call` arm here would re-route
    # every ordinary call away from the tail leg that handles them.
    if ctx.genActive when (isYieldNode :ast :n) then {
        ycs: zast.yieldCallIdAt :ast nid: (zast.nodeIdOf :n)
        # this yield's OPERAND may itself contain yields, and they evaluate
        # before it does -- so they suspend first
        (
            hoistExprYields
            :ast
            :reg
            :typing
            :ctx
            nid: (zast.yieldCallOperandAt :ast nid: ycs)
            :ind
            :buf
        )
        emitYieldStmt :ast :reg :typing :ctx callId: ycs :ind :buf
        return
    }
    # a yield written in EXPRESSION position suspends the function, so it
    # cannot stay inside the C expression: hoist each one to its own statement
    # first and leave a temp behind for the expression emitter to read.
    if ctx.genActive then {
        hnid: zast.nodeIdOf :n
        hoistExprYields :ast :reg :typing :ctx nid: hnid :ind :buf
    }
    match (
        n
    ) case statementline then {
        sln: ast.nodes.get i: n.statementline
        emitStmt :ast :reg :typing :ctx n: sln :ind :tmp :buf
    } case statement then {
        for each stmtId: (zast.kidsOf :ast span: n.statements) loop {
            emitStmt :ast :reg :typing :ctx n: (ast.nodes.get i: stmtId) :ind :tmp :buf
        }
    } case doexpr then {
        emitDoStmt :ast :reg :typing :ctx :n :ind :tmp :buf
    } case call then {
        emitCallStmt :ast :reg :typing :ctx call: n :ind :tmp :buf
    } case assignment then {
        emitAssignment :ast :reg :typing :ctx :n :ind :tmp :buf
        (
            emitRepointCompanion
            :ast
            :reg
            :typing
            :ctx
            vid: (defVid :typing nid: n.nodeid)
            :ind
            :buf
        )
    } case reassignment then {
        emitReassignStmt :ast :reg :typing :ctx :n :ind :tmp :buf
    } case swapstmt then {
        emitSwapStmt :ast :reg :typing :ctx :n :ind :tmp :buf
    } case ifexpr then {
        emitIfStmt :ast :reg :typing :ctx :n :ind :tmp :buf
    } case caseexpr then {
        emitCaseStmt :ast :reg :typing :ctx :n :ind :tmp :buf
    } case withexpr then {
        emitWithStmt :ast :reg :typing :ctx :n :ind :tmp :buf
    } case forexpr then {
        emitForStmt :ast :reg :typing :ctx :n :ind :tmp :buf
    } else {
        emitReturnStmt :ast :reg :typing :ctx :n :ind :tmp :buf
    }
}

# fnReturnTidOf -- the registry-recorded return tid for a FUNCTION id, 0 when
# absent. Scopes the typeById view so no lock outlives the read.
fnReturnTidOf: function {reg: ztypes.ZTypeRegistry.view tid: ztypes.tid} out ztypes.tid is {
    r: ztypes.tid
    rt: reg.returnTypeOf :tid
    if rt.notZero then r = rt
    return r
}

# genericOriginTid -- the registry-recorded generic origin for `tid`, 0 when
# absent. Scopes the typeById view like fnReturnTidOf.
genericOriginTid: function {reg: ztypes.ZTypeRegistry.view tid: ztypes.tid} out ztypes.tid is {
    g: ztypes.tid
    go: reg.genericOriginOf :tid
    if go.notZero then g = go
    return g
}

# definedInUnitName -- the defining unit's name for `tid`, BORROWED, and "" when
# the type has none (a shell, a builtin, a mono minted outside any unit). The
# door to unitNameViewOfTid: `typing` is already a view everywhere in the
# emitter, so the pin sits beside the ones already held. definedInUnitTid is the
# id form for a caller that only asks whether there is a unit at all.
definedInUnitName: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
} outx StringView is {
    return (ztypecheck.unitNameViewOfTid :reg :typing :tid)
}

# definedInUnitTid -- the id of the unit a type is DEFINED in, 0 when none (a
# shell, a builtin, a mono minted outside any unit). The same question
# definedInUnitName answers, without the name: asking whether a type has a
# defining unit at all is what most callers want, and it is the cheaper half --
# the name form has a registry read behind it and this does not.
definedInUnitTid: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
} out ztypes.tid is {
    ud: ztypecheck.unitDeclOfTid :reg :typing :tid
    if ud.isZero then return ztypes.tid
    r: ztypes.tid
    decl: typing.decls.get i: ud
    r = decl.typeId
    return r
}

# reassignDestroyTid -- the type an assignment's old value is destroyed as. A
# REBIND of a bare name replaces the whole variable, so that is the variable's
# DECLARED type: under a narrowing the occurrence is stamped with the arm's
# payload type instead, whose destructor answers for the payload and not for
# the union holding it, and the arm the variable still held would leak. Every
# other target answers with its own stamp.
reassignDestroyTid: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    n: astnode.view
    nid: zast.nodeid
} out ztypes.tid is {
    stamped: stampIdOf :typing :nid
    rbn: atomTextOf :ast :n
    if rbn.length == 0 then return stamped
    rbv: atomVid :typing nid: (atomNodeId :n)
    if rbv.isZero then return stamped
    declared: reg.variableTypeOf id: rbv
    if declared.isZero then return stamped
    return declared
}

# emitReassignLvalue -- the C lvalue for a reassignment target. A `got.field`
# whose base atom is a narrowed match-arm binding over a borrowed reftype view
# (seeded in narrowBox) writes THROUGH the box into the live entry; the local
# read-copy is not the backing storage. Other targets emit normally.
emitReassignLvalue: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out String is {
    # a REBIND names the VARIABLE, never the payload a narrowing aliased it to:
    # `s = Sum.two` inside an arm that narrowed `s` replaces the whole union,
    # and writing through the arm's payload view would assign a union to a
    # payload. A write THROUGH the subject (the dotted leg below) does take the
    # alias, which is what the narrowing is for.
    {
        rbNm: atomTextOf :ast :n
        if rbNm.length > 0 then {
            rbVid: atomVid :typing nid: (atomNodeId :n)
            if rbVid.notZero when (vvGet xs: ctx.narrowBox vid: rbVid).length > 0 then {
                rbF: cfacts
                return (wholeLocalName :ast :reg :ctx vid: rbVid name: rbNm facts: rbF)
            }
        }
    }
    if n.dottedpath then {
        ba: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: (ast.nodes.get i: n.parent))
        if ba.length > 0 then {
            baseVid: atomVid :typing nid: (atomNodeId n: (ast.nodes.get i: n.parent))
            nbo: vvGet xs: ctx.narrowBox vid: baseVid
            if nbo.length > 0 then {
                memC: (
                    memberC
                    :ast
                    :reg
                    :typing
                    :ctx
                    owner: ((vtGet xs: ctx.narrowTid vid: baseVid).or d: ztypes.tid.zero)
                    kind: memberkind.field
                    nameId: (aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child)
                )
                lvx: "\{nbo}.\{memC}"
                return lvx
            }
        }
        memFpId: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        rpnid: interpPartNodeId n: (ast.nodes.get i: n.parent)
        stampTid: stampIdOf :typing nid: rpnid
        rsc: stampTid
        rsFp: stampTid
        if rsc.notZero then rsFp = rsc
        rsFpc: chaseAggregateTypedef :reg :typing :ctx tid: rsFp
        if (typing.declIsFnptrFieldId parentTypeId: rsFpc nameId: memFpId) then {
            recvFp: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: (ast.nodes.get i: n.parent))
            accFpL: ".".string
            recvFpC: String
            if recvFp.length > 0 then {
                rfn: atomNodeId n: (ast.nodes.get i: n.parent)
                rfv: atomVid :typing nid: rfn
                if (isPtrVid :ctx vid: rfv) then accFpL = "->".string
                rfF: cfacts
                recvFpC = (
                    emitLocalAtomNameAt
                    :ast
                    :reg
                    :typing
                    :ctx
                    nid: rfn
                    name: recvFp.stringView
                    vid: rfv
                    facts: rfF
                )
            } else {
                # a field reached through a path (`this.inner.zero`): the path
                # itself, through `->` when it resolves to a pointer
                recvFpC = emitExpr :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent)
                if (pathIsPointer :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent)
                ) then accFpL = "->".string
            }
            memFpC: (
                memberC
                :ast
                :reg
                :typing
                :ctx
                owner: rsFpc
                kind: memberkind.field
                nameId: (aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child)
            )
            return "\{recvFpC}\{accFpL}\{memFpC}"
        }
    }
    return (emitExpr :ast :reg :typing :ctx :n)
}

# genericOwnerKey -- the declaration of a generic's ORIGIN template, keyed from
# any of its instantiations, so every mono of one template answers the same id.
# 0 when the type is not a generic instance.
genericOwnerKey: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ownerTid: ztypes.tid
} out ztypes.declid is {
    orig: genericOriginTid :reg tid: ownerTid
    if orig.isZero then return ztypes.declid.zero
    return (typing.declIdOfType typeId: orig)
}

# emitGenericDissect -- compile-time `match` on a generic parameter. The arm
# the current instance (ctx.curThisTid) selects is emitted inline and every
# other arm is dropped (no runtime switch); a value match assigns the arm's
# value to `assignTo`. No matching arm and no `else` is a compile error.
emitGenericDissect: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: zast.caserow.view
    ownerTid: ztypes.tid
    paramName: zast.nameid
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    darg: ztypecheck.dissectedArgOf :reg :typing :ownerTid :paramName
    win: ztypecheck.dissectedArmOf :reg :typing :ast :m :ownerTid :darg
    if win.notZero then {
        buf.append ind
        buf.append "{\n"
        if assignTo.length > 0 then {
            (
                emitBranchAssign
                :ast
                :reg
                :typing
                :ctx
                n: (ast.nodes.get i: win)
                target: assignTo
                scope: win
                :ind
                :tmp
                :buf
            )
        } else {
            # a local the arm declares is freed at the arm's end, where it is
            # still in C scope
            lL: tmp.listFrees.length
            wst: ast.nodes.get i: win
            emitBodyNode :ast :reg :typing :ctx n: wst :ind :tmp :buf
            dv: blockDiverges :ast :reg :typing :ctx n: wst
            closeScopeBlock :ast :reg :typing :ctx :tmp :lL diverged: dv node: win :buf
        }
        buf.append ind
        buf.append "}\n"
    } else {
        subjDesc: ztypecheck.dissectedArgText :reg :typing :ownerTid :paramName :darg
        pnmT: zast.poolTextAt pool: ast.names ref: paramName
        cnm: "generic match on '\{pnmT}' has no case for '\{subjDesc}' and no else"
        ctx.emitErrors.append (emitterFailure what: cnm.copy line: 0)
        preludeNeed :ctx memb: "@panic"
        ef: "\{ind}z_panic(\"(compile-time error)\");\n"
        buf.append ef
    }
}

# pairSubjectCType -- the C type an ordinal-pair subject is held in: the
# scalar's own where it has one (`bool`), else the pair's typedef.
pairSubjectCType: function {
    ctx: Ctx
    typing: ztyping.ZTyping.view
    # the subject's stamped type name
    # the subject's type
    tid: ztypes.tid
} out String is {
    sct: scalarCTypeFor :typing :tid
    if sct.length > 0 then return sct
    return "\{spelledCname :ctx :tid}_t"
}

# matchOrdinalPairRoute -- an ordinal-pair subject (two ordinal variants matched
# together) has its own emitter. True when it took the match. That emitter
# writes the subject into every arm's test (`if (s) ... else if (!s)`), so a
# subject that is a CALL is evaluated into a temp first: it runs once, and
# what it moved is zeroed once. A subject held through a pointer -- a `this`
# or `.view` parameter -- is loaded, as the tag switch loads it: the test is of
# the value, and a pointer tested is never null.
matchOrdinalPairRoute: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: zast.caserow.view
    subj: StringView
    # the subject's stamped type name
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    sTid: stampIdDeep :reg :typing n: (ast.nodes.get i: m.subject)
    if (isOrdinalPair :typing tid: sTid) then {
        # the temp's name, built only for a call subject
        subjOnce: String
        core: ast.nodes.get i: m.subject
        if core.call then {
            ct: pairSubjectCType :ctx :typing tid: sTid
            mp: tmpNext :ctx :tmp
            buf.append "\{ind}\{ct} _mp\{mp} = \{subj};\n"
            emitCallTakeInvalidations :ast :reg :typing :ctx call: core :ind :buf
            subjOnce = "_mp\{mp}"
        } else if (needsValueDeref :ast :reg :typing :ctx n: core tid: sTid) then {
            subjOnce = "(*\{subj})"
        }
        # the temp stands in for the subject exactly when one was built
        subjV: if subjOnce.length > 0 then subjOnce.stringView else subj
        (
            emitOrdinalPairMatch
            :ast
            :reg
            :typing
            :ctx
            :m
            subj: subjV
            tid: sTid
            :assignTo
            :ind
            :tmp
            :buf
        )
        return true
    }
    return false
}

# matchGenericRoute -- a subject whose type is a GENERIC PARAMETER, named either
# bare or through a dotted path, dissects instead of switching: there is no
# tag to switch on until the parameter is bound. True when it took the match.
matchGenericRoute: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: zast.caserow.view
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    # the SHARED stamp says the subject is a generic parameter; an instance's
    # own stamp is the type it was bound to, which is what dissection selects on
    subjSid: (
        ztyping.nodeTypeAt
        tbl: typing.nodeType
        nid: (interpPartNodeId n: (ast.nodes.get i: m.subject))
    )
    if subjSid.notZero when (reg.isTypeParamOf tid: subjSid) then {
        # the parameter's name, from its declaration in the owner's template
        paramName: (
            reg.genericParamNameOfTid
            tdecl: (typing.declIdOfType typeId: (genericOriginTid :reg tid: ctx.curThisTid))
            ptid: subjSid
        )
        (
            emitGenericDissect
            :ast
            :reg
            :typing
            :ctx
            :m
            ownerTid: ctx.curThisTid
            :paramName
            :assignTo
            :ind
            :tmp
            :buf
        )
        return true
    }
    dcore: m.subject
    dcn: ast.nodes.get i: dcore
    if dcn.dottedpath then {
        dleafId: aliasChildNameId :ast :typing n: (ast.nodes.get i: dcore)
        dbnid: dottedBaseNodeId :ast n: (ast.nodes.get i: dcore)
        dbst: stampIdOf :typing nid: dbnid
        downer: ctx.curThisTid
        if (reg.genericArgCount specId: dbst) > 0 then downer = dbst
        if downer.notZero when dleafId.notZero then {
            dkey: genericOwnerKey :reg :typing ownerTid: downer
            if dkey.notZero when (reg.isGenericParamOf tdecl: dkey name: dleafId) then {
                (
                    emitGenericDissect
                    :ast
                    :reg
                    :typing
                    :ctx
                    :m
                    ownerTid: downer
                    paramName: dleafId
                    :assignTo
                    :ind
                    :tmp
                    :buf
                )
                return true
            }
        }
    }
    return false
}

# matchelse -- the residual narrowing an else arm inherits: when exactly ONE arm
# is uncovered, the else branch KNOWS the subject is that arm.
matchelse: record {
    # the else arm's type
    meT: ztypes.tid
    # whether that type was seeded rather than inferred
    meSeed: bool
}

# matchElseNarrowing -- work out that residual arm and the alias text for it.
# Answers seeded=false when the else covers more than one arm, when the subject
# has no name to narrow, or when the else body reassigns it.
matchElseNarrowing: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: zast.caserow.view
    vtid: ztypes.tid
    sname: StringView
    covA: (ListVal zast.nameid).view
    # the subject's storage, and the access its fields are read with
    recv: StringView
    recvF: cfacts
    acc: StringView
    meV: String.borrow
    # left holding the alias's facts
    meVF: cfacts.borrow
} out matchelse is {
    meT: ztypes.tid
    meSeed: false
    if m.elseclause.isZero then return (matchelse :meT :meSeed)
    if sname.length == 0 then return (matchelse :meT :meSeed)
    allME: ListVal zast.nameid
    zenv.sumArmNameIds ty: typing :reg tid: vtid ids: allME
    remME: u64
    armME: zast.nameid
    for each ma: allME loop {
        maId: ma
        cov: false
        for each cv: covA loop {
            if cv == maId then cov = true
        }
        if cov.not then {
            remME = remME + 1
            armME = maId
        }
    }
    if remME == 1 then {
        {
            aliasText: (
                armAliasText
                :ast
                :reg
                :typing
                :ctx
                tid: vtid
                arm: armME
                :recv
                :recvF
                :acc
                facts: meVF
            )
            if aliasText.length > 0 then {
                meV.append aliasText
                meT = (
                    (typing.declChildOfId parentTypeId: vtid nameId: armME).or
                    d: ztypes.tid.zero
                )
                meSeed = true
            }
        }
    }
    return (matchelse :meT :meSeed)
}


# emitMatchSubjectTemp -- the `_mN` temporary a match reads a subject no arm
# can name through, or a variant subject. A call's owning result is held in
# the checker's temporary, which frees it -- in a generator, a field of the
# instance -- and a borrowed field or a reference-returning call is loaded
# through its pointer.
emitMatchSubjectTemp: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: zast.caserow.view
    sx: StringView
    sxF: cfacts
    vtid: ztypes.tid
    isUni: bool
    vc: StringView
    mN: u64
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    subjT: ast.nodes.get i: m.subject
    sxM: "\{sx}"
    if (needsValueDeref :ast :reg :typing :ctx n: subjT tid: vtid) then {
        sxM = "(*\{sx})"
    }
    if isUni when (pathIsPointer :ast :reg :typing :ctx n: subjT) then sxM = "(*\{sx})"
    gfM: genSubjectFieldC :ast :reg :typing :ctx nid: m.subject
    if gfM.length > 0 then {
        mtv: (typing.tempOf.get key: m.subject).or d: ztypes.vid.zero
        mtid: reg.variableTypeOf id: mtv
        buf.append (destroyLineC :reg :typing :ctx tid: mtid nm: gfM.stringView :ind)
        buf.append "\{ind}\{gfM} = \{sxM};\n"
        sxM = gfM.take
    } else {
        hoM: ownedReceiverHoist :ast :reg :typing :ctx expr: sx exprF: sxF n: subjT
        if hoM.length > 0 then sxM = hoM.take
    }
    flushArgHoists :ctx :ind :tmp :buf
    buf.append "\{ind}\{vc}_t _m\{mN} = \{sxM};\n"
}

# emitMatchStmt -- a variant-subject match as a tag switch over a temp;
# payload arms shadow the subject name with the payload value.
emitMatchStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: zast.caserow.view
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    # a match on a unit constant runs the one arm the constant holds
    mfb: foldedBranchOf :typing nid: m.nodeid
    if mfb.known then {
        mwn: ast.nodes.get i: mfb.stmt
        mscope: branchScopeOf :ast clauses: m.clauses elseclause: m.elseclause stmt: mfb.stmt
        buf.append "\{ind}{\n"
        indM: "\{ind}    "
        lLM: tmp.listFrees.length
        if assignTo.length > 0 then {
            (
                emitBranchAssign
                :ast
                :reg
                :typing
                :ctx
                n: mwn
                target: assignTo
                scope: mscope
                ind: indM.stringView
                :tmp
                :buf
            )
            flushBlockFrees :tmp lL: lLM diverged: false :buf
        } else {
            emitBodyNode :ast :reg :typing :ctx n: mwn ind: indM.stringView :tmp :buf
            (
                closeScopeBlock
                :ast
                :reg
                :typing
                :ctx
                :tmp
                lL: lLM
                diverged: (blockDiverges :ast :reg :typing :ctx n: mwn)
                node: mscope
                :buf
            )
        }
        buf.append "\{ind}}\n"
        return
    }
    sxF: cfacts
    sx: emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: m.subject) facts: sxF
    if (
        matchOrdinalPairRoute
        :ast
        :reg
        :typing
        :ctx
        :m
        subj: sx.stringView
        :assignTo
        :ind
        :tmp
        :buf
    ) then return
    subjStamp: stampIdDeep :reg :typing n: (ast.nodes.get i: m.subject)
    vtid: canonTypeId :reg :typing tid: subjStamp
    if (matchGenericRoute :ast :reg :typing :ctx :m :assignTo :ind :tmp :buf) then return
    # a typedef over a union or variant is matched on its base's tag
    vend: ztypecheck.typedefChaseTid :typing tid: vtid
    vett: reg.typetypeOf typeId: vend
    if vett.isSum then {
        vtid = vend
    }
    isVar: false
    isUni: false
    if vtid.notZero then {
        subjectKind: reg.typetypeOf typeId: vtid
        if subjectKind == ztypes.ztypetype.variantType then isVar = true
        if subjectKind == ztypes.ztypetype.unionType then isUni = true
    }
    # the checker refuses a match on any other subject (a scalar's included)
    if isVar.not when isUni.not then {
        stn: reg.nameViewOf tid: vtid
        emitFail :ctx what: "unhandled match subject type \{stn}" line: m.lineno
        return
    }
    vc: spelledCname :ctx tid: vtid
    mN: tmpNext :ctx :tmp
    sname: atomTextOf :ast n: (ast.nodes.get i: m.subject)
    # the subject's variable: inside an arm the bound name IS the subject,
    # narrowed, so its declaration must carry the same identifier the body's
    # references resolve to
    snameV: atomVid :typing nid: (atomNodeId n: (ast.nodes.get i: m.subject))
    # the subject's storage, as the receiver its tag and payload are read off:
    # the `_mN` temporary, or -- for a union subject that is a variable -- the
    # variable itself, as an `if` narrowing reads it. A payload write in an arm
    # then reaches the variable, and in a generator the variable is a state
    # field that a suspension inside the arm does not lose.
    mRecv: String
    mRecvF: cfacts
    mAcc: "."
    subjM: ast.nodes.get i: m.subject
    if isUni when (nodeIsBareAtom n: subjM) when snameV.notZero then {
        mRecv = sx.take
        mRecvF = sxF
        if (pathIsPointer :ast :reg :typing :ctx n: subjM) then mAcc = "->"
    } else {
        (
            emitMatchSubjectTemp
            :ast
            :reg
            :typing
            :ctx
            :m
            sx: sx.stringView
            :sxF
            :vtid
            :isUni
            vc: vc.stringView
            :mN
            :ind
            :tmp
            :buf
        )
        mRecv = "_m\{mN}"
        mRecvF = pathFacts
    }
    if (isOrdinalVariant :typing tid: vtid) then {
        buf.append "\{ind}switch (\{mRecv}) {\n"
    } else {
        buf.append "\{ind}switch (\{mRecv}\{mAcc}tag) {\n"
    }
    bodyInd: "\{ind}    "
    for each cId: (zast.kidsOf :ast span: m.clauses) loop {
        c: ast.nodes.get i: cId
        (
            emitMatchClause
            :ast
            :reg
            :typing
            :ctx
            :c
            :vtid
            :isUni
            :mN
            slotRecv: mRecv.stringView
            slotRecvF: mRecvF
            slotAcc: mAcc
            :sname
            snameVid: snameV
            :assignTo
            ind: bodyInd.stringView
            :tmp
            :buf
        )
    }
    covA: ListVal zast.nameid
    for each c3Id: (zast.kidsOf :ast span: m.clauses) loop {
        c3: ast.nodes.get i: c3Id
        if c3.caseclause then {
            cnm: clauseArmId :typing nid: c3.nodeid written: c3.name
            covA.append cnm
        }
    }
    meV: String
    meVF: cfacts
    men: (
        matchElseNarrowing
        :ast
        :reg
        :typing
        :ctx
        :m
        :vtid
        :sname
        :covA
        recv: mRecv.stringView
        recvF: mRecvF
        acc: mAcc
        :meV
        :meVF
    )
    meT: men.meT
    meSeed: men.meSeed
    mePrevV: String
    mePrevF: cfacts
    mePrevT: ztypes.tid
    if meSeed then {
        pv: vvGet xs: ctx.narrowBox vid: snameV
        mePrevV = pv.take
        mePrevF = vvFactsOf xs: ctx.narrowBox vid: snameV
        mePrevT = (
            (vtGet xs: ctx.narrowTid vid: snameV).or
            d: ztypes.tid.zero
        )
        vvSet xs: ctx.narrowBox vid: snameV val: meV.stringView facts: meVF
        vtSet xs: ctx.narrowTid vid: snameV tid: meT
    }
    mdvg: matchDiverges :reg :typing nid: m.nodeid
    (
        emitMatchElse
        :ast
        :reg
        :typing
        :ctx
        oId: m.elseclause
        :assignTo
        ind: bodyInd.stringView
        :tmp
        diverges: mdvg
        :buf
    )
    if meSeed then {
        (
            restoreNarrow
            :ctx
            vid: snameV
            prevVal: mePrevV.stringView
            prevFacts: mePrevF
            prevTid: mePrevT
        )
    }
    l: "\{ind}}\n"
    buf.append l
}

# emitOrdinalPairMatch -- a match over a TWO-ARM ORDINAL sum, emitted as an
# if (subj) / else if (!subj) chain on the subject itself rather than a tag
# switch, with the optional else arm a trailing `else`. The arm whose
# DISCRIMINATOR is 0 takes the negated condition, which is what makes a bool
# subject an instance of this rather than a form of its own. assignTo writes the
# arm value in each branch.
emitOrdinalPairMatch: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: zast.caserow.view
    subj: StringView
    tid: ztypes.tid
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    falseArm: ordinalPairFirstArmId :typing :tid
    firstB: true
    for each cId: (zast.kidsOf :ast span: m.clauses) loop {
        c: ast.nodes.get i: cId
        if c.caseclause then {
            condB: subj.string
            if falseArm.notZero when (
                (clauseArmId :typing nid: c.nodeid written: c.name) == falseArm
            ) then condB = "!\{subj}"
            kwB: "if"
            if firstB.not then kwB = "else if"
            firstB = false
            lhB: "\{ind}\{kwB} (\{condB}) {\n"
            buf.append lhB
            indB: "\{ind}    "
            if assignTo.length > 0 then {
                armInd: "\{ind}    "
                (
                    emitBranchAssign
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: (ast.nodes.get i: c.statement)
                    target: assignTo
                    scope: c.nodeid
                    ind: armInd.stringView
                    :tmp
                    :buf
                )
            } else {
                lLB: tmp.listFrees.length
                cstB: ast.nodes.get i: c.statement
                emitBodyNode :ast :reg :typing :ctx n: cstB ind: indB.stringView :tmp :buf
                dvF: blockDiverges :ast :reg :typing :ctx n: cstB
                (
                    closeScopeBlock
                    :ast
                    :reg
                    :typing
                    :ctx
                    :tmp
                    lL: lLB
                    diverged: dvF
                    node: c.nodeid
                    :buf
                )
            }
            lcB: "\{ind}}\n"
            buf.append lcB
        }
    }
    bdvg: matchDiverges :reg :typing nid: m.nodeid
    emitBoolElse :ast :reg :typing :ctx oId: m.elseclause :assignTo :ind :tmp diverges: bdvg :buf
}

# emitBoolElse -- the trailing `else { ... }` of a bool match (none = nothing).
emitBoolElse: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    oId: zast.nodeid
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    diverges: bool
    buf: String.borrow
} is {
    if oId.notZero then {
        o: ast.nodes.get i: oId
        leB: "\{ind}else {\n"
        buf.append leB
        indE: "\{ind}    "
        if assignTo.length > 0 then {
            armInd: "\{ind}    "
            (
                emitBranchAssign
                :ast
                :reg
                :typing
                :ctx
                n: o
                target: assignTo
                scope: oId
                ind: armInd.stringView
                :tmp
                :buf
            )
        } else {
            lLE: tmp.listFrees.length
            emitBodyNode :ast :reg :typing :ctx n: o ind: indE.stringView :tmp :buf
            dvF: blockDiverges :ast :reg :typing :ctx n: o
            closeScopeBlock :ast :reg :typing :ctx :tmp lL: lLE diverged: dvF node: oId :buf
        }
        lceB: "\{ind}}\n"
        buf.append lceB
    } else {
        if diverges then {
            leD: "\{ind}else {\n"
            buf.append leD
            preludeNeed :ctx memb: "@unreachable"
            lzD: "\{ind}    z_unreachable();\n"
            buf.append lzD
            lcD: "\{ind}}\n"
            buf.append lcD
        }
    }
}

# flushBlockFrees -- the destroys owed the emitter's own temporaries registered
# since `lL`, newest first, each leaving the list: a temporary declared inside a
# block is released at the block's end, where it is still in C scope. A block
# that diverges on every path released them at its exits (emitReturnCleanup,
# emitBreakFrees): they leave the list and nothing is written, or the destroys
# would land after the diverging statement as unreachable code.
flushBlockFrees: function {
    tmp: TmpCtr
    lL: u64
    diverged: bool
    buf: String.borrow
} is {
    for tmp.listFrees.length > lL loop {
        lvo: tmp.listFrees.pop
        if diverged.not then buf.append lvo.stmt
    }
}

# closeScopeBlock -- the destroys owed where the C block of checker scope `node`
# closes: the emitter's own temporaries registered since `lL`, newest first -- a
# local may be what one of them walks -- then the locals the checker recorded
# the scope's end destroys (emitScopeDestroy). A block that diverges on every
# path writes nothing, its exits having freed what it held.
closeScopeBlock: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tmp: TmpCtr
    lL: u64
    diverged: bool
    node: zast.nodeid
    buf: String.borrow
} is {
    flushBlockFrees :tmp :lL :diverged :buf
    if diverged.not then emitScopeDestroy :ast :reg :typing :ctx :node ind: "    " :buf
}


# branchScopeOf -- the checker scope of the `if` or `match` branch whose body
# is `stmt`: the clause among `clauses` it belongs to, or the else body itself.
branchScopeOf: function {
    ast: Ast.view clauses: zast.kidspan elseclause: zast.nodeid stmt: zast.nodeid
} out zast.nodeid is {
    if elseclause == stmt then return stmt
    for each cId: (zast.kidsOf :ast span: clauses) loop {
        c: ast.nodes.get i: cId
        body: zast.nodeid
        match (
            c
        ) case ifclause then {
            body = c.statement
        } case caseclause then {
            body = c.statement
        } else null
        if body == stmt then return cId
    }
    return zast.nodeid
}

# emitScopeDestroy -- what the checker recorded the end of scope `node` destroys
# (scopeDestroy), in its order, each local by its variable (emitLocalDestroy). A
# local moved on every path here holds nothing and is skipped; one moved on
# some was zeroed where it moved, and its destroy frees nothing there.
emitScopeDestroy: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    node: zast.nodeid
    ind: StringView
    buf: String.borrow
} is {
    rg: typing.scopeDestroy.get key: node
    if rg.none then return
    k: u64
    for k < rg.len loop {
        it: typing.destroyItems.get i: rg.start.u64 + k
        k = k + 1
        if it.state == 1 then continue
        emitLocalDestroy :ast :reg :typing :ctx vid: it.vid :ind :buf
    }
}

# emitLocalDestroy -- the destroy of the local `vid`, where the checker lists
# it: by the variable's type, of the variable's own C name. A generator's local
# lives in a field of the instance (genLocalFieldOf): it is freed there and the
# field zeroed, so the instance's own destructor finds it empty. Nothing for a
# type that frees nothing.
emitLocalDestroy: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    vid: ztypes.vid
    ind: StringView
    buf: String.borrow
} is {
    tid: reg.variableTypeOf id: vid
    gf: typing.genLocalFieldOf.get key: vid
    if gf.some then {
        al: vidFind xs: ctx.aliases :vid
        if al == 0 then return
        fld: (ctx.aliases.get i: al - 1).val.copy
        dc: destroyLineC :reg :typing :ctx :tid nm: fld.stringView :ind
        if dc.length == 0 then return
        buf.append dc
        buf.append "\{ind}\{fld} = \{movedZeroC :reg :typing :ctx :tid};\n"
        return
    }
    # storage another owner frees: what a borrow aliases
    if (vvHas xs: ctx.aliases :vid) then return
    nm: varCName :ctx :ast :reg :vid
    buf.append (destroyLineC :reg :typing :ctx :tid nm: nm.stringView :ind)
}

# emitBreakFrees -- the destroys a `break`, or a `continue` that jumps no
# `do` block, owes: those of the innermost loop or `do` entry's scopes
# (emitContinueFrees).
emitBreakFrees: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tmp: TmpCtr.view
    ind: StringView
    buf: String.borrow
} is {
    if ctx.loops.length == 0 then return
    emitContinueFrees :ast :reg :typing :ctx :tmp idx: ctx.loops.length - 1 :ind :buf
}

# emitContinueFrees -- the destroys owed where an exit leaves the scopes since
# the mark-stack entry at `idx` (the loop or `do` it leaves): the emitter's own
# temporaries registered since, newest first, then the locals the checker
# recorded the exit destroys (emitExitDestroy). Non-destructive: the path that
# does not take the exit still owes them. An exit the checker recorded nothing
# for (ctx.exitNode 0) is refused.
emitContinueFrees: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tmp: TmpCtr.view
    idx: u64
    ind: StringView
    buf: String.borrow
} is {
    allRows: ctx.exitNode.isZero
    if allRows then (
        emitFail
        :ctx
        what: "an exit whose destroys the checker did not record".string
        line: 0
    )
    lMark: (ctx.loops.get i: idx).listMark
    i: tmp.listFrees.length
    for i > lMark loop {
        i = i - 1
        buf.append (tmp.listFrees.get :i).stmt
    }
    if allRows.not then emitExitDestroy :ast :reg :typing :ctx :ind :buf
}

# emitExitDestroy -- what the checker recorded the exit being emitted
# (ctx.exitNode) destroys (exitDestroy), in its order, each local by its
# variable (emitLocalDestroy); the path that does not take the exit destroys
# it too. A local moved on every path here is skipped.
emitExitDestroy: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    ind: StringView
    buf: String.borrow
} is {
    rg: typing.exitDestroy.get key: ctx.exitNode
    if rg.none then return
    k: u64
    for k < rg.len loop {
        it: typing.destroyItems.get i: rg.start.u64 + k
        k = k + 1
        if it.state == 1 then continue
        emitLocalDestroy :ast :reg :typing :ctx vid: it.vid :ind :buf
    }
}

# seedUnionArmAlias -- narrow match subject `sname` to union `vtid`'s arm `arm`:
# reads of it inside the arm read the payload's cell, cast to `pc`, whose types
# (`pcHeld`) are recorded where that alias is read.
seedUnionArmAlias: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    vtid: ztypes.tid
    arm: zast.nameid
    pc: StringView
    pcHeld: ListVal ztypes.tid
    slotRecv: StringView
    slotRecvF: cfacts
    slotAcc: StringView
    sname: StringView
    snameVid: ztypes.vid
    ind: StringView
    buf: String.borrow
} is {
    inl: armIsInlineC :typing tid: vtid :arm
    msl: armSlotC :ast :reg :typing :ctx tid: vtid recv: slotRecv acc: slotAcc :arm inline: inl
    nbv: armCellRef :pc slot: msl.stringView inline: inl
    holdForAlias :ctx val: nbv.stringView held: pcHeld
    cmt: "\{ind}    /* alias: \{sname} => \{nbv} */\n"
    buf.append cmt
    (
        vvSet
        xs: ctx.narrowBox
        vid: snameVid
        val: nbv.stringView
        facts: (armCellFacts recvF: slotRecvF inline: inl)
    )
    co: typing.declChildOfId parentTypeId: vtid nameId: arm
    if co.some then {
        vtSet xs: ctx.narrowTid vid: snameVid tid: co
    }
}

# emit one arm of a match over a tagged sum.
emitMatchClause: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    c: astnode.view
    vtid: ztypes.tid
    isUni: bool
    mN: u64
    # a union subject's storage and the access its slot is read with
    slotRecv: StringView
    slotRecvF: cfacts
    slotAcc: StringView
    sname: StringView
    snameVid: ztypes.vid
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    if c.caseclause then {
        arm: clauseArmId :typing nid: c.nodeid written: c.name
        tg: spelledTagConst :ast :ctx :reg :typing tid: vtid armId: arm
        l2: "\{ind}case \{tg}: {\n"
        buf.append l2
        # held: a union arm's cast is recorded where its alias is read
        pcHeld: ListVal ztypes.tid
        pc: heldArmPayloadC :ast :reg :typing :ctx tid: vtid :arm held: pcHeld
        bodyInd: "\{ind}    "
        didSeed: false
        unptr: false
        staticArm: false
        # the narrowing an enclosing scope gave the subject, put back when the
        # arm ends: a match on a name an `if` narrowed must not end that `if`'s
        # narrowing for the statements after the match
        prevV: vvGet xs: ctx.narrowBox vid: snameVid
        prevF: vvFactsOf xs: ctx.narrowBox vid: snameVid
        prevT: (vtGet xs: ctx.narrowTid vid: snameVid).or d: ztypes.tid.zero
        if pc.length > 0 when sname.length > 0 then {
            if isUni then {
                (
                    seedUnionArmAlias
                    :ast
                    :reg
                    :typing
                    :ctx
                    :vtid
                    :arm
                    pc: pc.stringView
                    :pcHeld
                    :slotRecv
                    :slotRecvF
                    :slotAcc
                    :sname
                    :snameVid
                    :ind
                    :buf
                )
                didSeed = true
            } else if (bodyReassigns :ast n: (ast.nodes.get i: c.statement) name: sname) then {
                # a body that WRITES the subject must reach the variable, which a
                # shadowing local of the same C name would hide: the payload is
                # aliased instead, and each read picks the alias or the variable
                # by its stamp
                armMV: memberC :ast :reg :typing :ctx owner: vtid kind: memberkind.arm nameId: arm
                nbvV: "_m\{mN}.data.\{armMV}"
                vvSet xs: ctx.narrowBox vid: snameVid val: nbvV.stringView facts: pathFacts
                cov: typing.declChildOfId parentTypeId: vtid nameId: arm
                if cov.some then {
                    vtSet xs: ctx.narrowTid vid: snameVid tid: cov
                }
                didSeed = true
            } else {
                snE: varCName :ctx :ast :reg vid: snameVid
                armMP: memberC :ast :reg :typing :ctx owner: vtid kind: memberkind.arm nameId: arm
                l3: "\{ind}    \{pc} \{snE} = _m\{mN}.data.\{armMP};\n"
                buf.append l3
                l4: "\{ind}    (void)\{snE};\n"
                buf.append l4
                # the shadow IS the payload: a narrowing an enclosing guard gave
                # the subject would spell the arm's reads through the old value
                if prevV.length > 0 then {
                    vidRemove xs: ctx.narrowBox vid: snameVid
                    vidRemove xs: ctx.narrowTid vid: snameVid
                    didSeed = true
                }
                # a subject that arrives by pointer (a method's `this`) is
                # shadowed by a VALUE here, so the arm must read it as one
                if (isPtrVid :ctx vid: snameVid) then {
                    dropPtrVid :ctx vid: snameVid
                    unptr = true
                }
                # a data payload is a handle: the shadow reads through it
                pyo: typing.declChildOfId parentTypeId: vtid nameId: arm
                if pyo.some when (isStaticHandle :reg :typing tid: pyo) then {
                    ctx.ptrVids.append from: snameVid
                    staticArm = true
                }
            }
        }
        # what no alias took is spelled by the clause's own text (the shadow)
        releaseHeld :ctx held: pcHeld
        dv: false
        if assignTo.length > 0 then {
            armInd: "\{ind}    "
            (
                emitBranchAssign
                :ast
                :reg
                :typing
                :ctx
                n: (ast.nodes.get i: c.statement)
                target: assignTo
                scope: c.nodeid
                ind: armInd.stringView
                :tmp
                :buf
            )
        } else {
            lL: tmp.listFrees.length
            cst: ast.nodes.get i: c.statement
            emitBodyNode :ast :reg :typing :ctx n: cst ind: bodyInd.stringView :tmp :buf
            dv = blockDiverges :ast :reg :typing :ctx n: cst
            closeScopeBlock :ast :reg :typing :ctx :tmp :lL diverged: dv node: c.nodeid :buf
        }
        if didSeed then {
            (
                restoreNarrow
                :ctx
                vid: snameVid
                prevVal: prevV.stringView
                prevFacts: prevF
                prevTid: prevT
            )
        }
        if unptr then ctx.ptrVids.append from: snameVid
        if staticArm then dropPtrVid :ctx vid: snameVid
        if dv.not then {
            l5: "\{ind}    break;\n"
            buf.append l5
        }
        l6: "\{ind}}\n"
        buf.append l6
    }
}

# emit a match's else arm.
emitMatchElse: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    oId: zast.nodeid
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    diverges: bool
    buf: String.borrow
} is {
    if oId.notZero then {
        o: ast.nodes.get i: oId
        l7: "\{ind}default: {\n"
        buf.append l7
        bodyInd: "\{ind}    "
        dv8: false
        if assignTo.length > 0 then {
            armInd: "\{ind}    "
            (
                emitBranchAssign
                :ast
                :reg
                :typing
                :ctx
                n: o
                target: assignTo
                scope: oId
                ind: armInd.stringView
                :tmp
                :buf
            )
        } else {
            lLe: tmp.listFrees.length
            emitBodyNode :ast :reg :typing :ctx n: o ind: bodyInd.stringView :tmp :buf
            dv8 = blockDiverges :ast :reg :typing :ctx n: o
            closeScopeBlock :ast :reg :typing :ctx :tmp lL: lLe diverged: dv8 node: oId :buf
        }
        if dv8.not then {
            l8: "\{ind}    break;\n"
            buf.append l8
        }
        l: "\{ind}}\n"
        buf.append l
    } else {
        if diverges then {
            preludeNeed :ctx memb: "@unreachable"
            ld0: "\{ind}default: z_unreachable();\n"
            buf.append ld0
        } else {
            ld1: "\{ind}default: break;\n"
            buf.append ld1
        }
    }
}

# emitOptionalAssign -- the some-arm assignment for a break-carrying do value:
# inline for a valtype optionval (payC ""), a malloc'd box for a reftype
# Option payload.
emitOptionalAssign: function {
    ctx: Ctx
    target: StringView
    someTag: StringView
    # the some arm's C member name (memberC)
    someC: StringView
    payC: StringView
    vx: StringView
    ind: StringView
    buf: String.borrow
} is {
    if payC.length > 0 then {
        tsl: "\{target}.data"
        st: armCellStore :ctx pc: payC box: "_zb" value: vx slot: tsl.stringView
        lb: "\{ind}\{target}.tag = \{someTag};\n\{ind}{ \{st} }\n"
        buf.append lb
    } else {
        la: "\{ind}\{target}.tag = \{someTag};\n\{ind}\{target}.data.\{someC} = \{vx};\n"
        buf.append la
    }
}

# emitBranchAssignOptional -- emit a do-block-with-break body, wrapping the final
# value in the optional's `some` arm (tag + data.some); a `break` reached first
# leaves the result at its pre-set `none` tag.
emitBranchAssignOptional: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    target: StringView
    someTag: StringView
    # the some arm's C member name (memberC)
    someC: StringView
    payC: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    match (
        n
    ) case statement then {
        cnt: n.statements.count.u64
        si: u64
        for si < cnt loop {
            sxId: zast.kidAt kids: ast.kids span: n.statements i: si
            sx: ast.nodes.get i: sxId
            if (si + 1) == cnt then {
                vx: emitExpr :ast :reg :typing :ctx n: sx
                flushArgHoists :ctx :ind :tmp :buf
                emitOptionalAssign :ctx :target :someTag :someC :payC vx: vx.stringView :ind :buf
                emitValueTakeInvalidations :ast :reg :typing :ctx n: sx :ind :buf
            } else {
                emitStmt :ast :reg :typing :ctx n: sx :ind :tmp :buf
                # a diverging statement -- typically an `if` the emitter folded
                # to an unconditional break -- ends the block, so the value
                # assignment below it can never run. The optional stays none,
                # which is what the break path yields anyway.
                if (stmtDiverges :ast :reg :typing :ctx sid: sxId) then si = cnt
            }
            si = si + 1
        }
    } else {
        vx2: emitExpr :ast :reg :typing :ctx :n
        flushArgHoists :ctx :ind :tmp :buf
        emitOptionalAssign :ctx :target :someTag :someC :payC vx: vx2.stringView :ind :buf
        emitValueTakeInvalidations :ast :reg :typing :ctx :n :ind :buf
    }
}

# emitDoBindValue -- `x: { ... }` (a do block): declare the local and emit the
# block. A do block whose own body breaks yields an optionval (default `none`,
# `some(last)` on normal completion, in a do/while(0) so a break exits to none);
# a breakless do block is a plain scoped block assigning the last value. A
# binding's local `owes` its destroy at scope exit; a block inside an expression
# owes nothing here, as an `if`'s or a `match`'s value does not.
emitDoBindValue: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    nm: StringView
    ct: StringView
    tid: ztypes.tid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    match (
        n
    ) case doexpr then {
        ld: "\{ind}\{ct} \{nm};\n"
        buf.append ld
        if (ztypecheck.blockHasBreak :ast n: (ast.nodes.get i: n.statement)) then {
            noneTag: spelledTagConst :ast :ctx :reg :typing :tid armId: zast.wellKnown.slot.wkNone
            someTag: spelledTagConst :ast :ctx :reg :typing :tid armId: zast.wellKnown.slot.wkSome
            someC: (
                memberC
                :ast
                :reg
                :typing
                :ctx
                owner: tid
                kind: memberkind.arm
                nameId: zast.wellKnown.slot.wkSome
            )
            # a reftype value wraps in Option: the payload lives in a
            # malloc'd box, none carries NULL data, and the local owns the
            # box (scope-exit destroy).
            boxedC: String
            if (originIsTid :reg :tid originTid: (ctx.origins.get i: family.slot.option)) then {
                boxedC = armPayloadC :ast :reg :typing :ctx :tid arm: zast.wellKnown.slot.wkSome
            }
            l0: "\{ind}\{nm}.tag = \{noneTag};\n"
            buf.append l0
            if boxedC.length > 0 then {
                l0b: "\{ind}\{nm}.data = NULL;\n"
                buf.append l0b
            }
            l1: "\{ind}do {\n"
            buf.append l1
            bodyInd: "\{ind}    "
            # the block is its own break target: a break inside frees the
            # block's owned temps (since these marks) and lands after the
            # block, not on an enclosing loop's label
            doId: pushLoopLabel :ctx :tmp isDo: true postTest: false
            lLd: tmp.listFrees.length
            (
                emitBranchAssignOptional
                :ast
                :reg
                :typing
                :ctx
                n: (ast.nodes.get i: n.statement)
                target: nm
                someTag: someTag.stringView
                someC: someC.stringView
                payC: boxedC.stringView
                ind: bodyInd.stringView
                :tmp
                :buf
            )
            dvO: blockDiverges :ast :reg :typing :ctx n: (ast.nodes.get i: n.statement)
            closeScopeBlock :ast :reg :typing :ctx :tmp lL: lLd diverged: dvO node: n.nodeid :buf
            l2: "\{ind}} while (0);\n"
            buf.append l2
            popLoopLabel :ctx id: doId :ind :buf
        } else {
            l3: "\{ind}{\n"
            buf.append l3
            innerInd: "\{ind}    "
            lLe: tmp.listFrees.length
            (
                emitBranchAssign
                :ast
                :reg
                :typing
                :ctx
                n: (ast.nodes.get i: n.statement)
                target: nm
                scope: n.nodeid
                ind: innerInd.stringView
                :tmp
                :buf
            )
            flushBlockFrees :tmp lL: lLe diverged: false :buf
            l4: "\{ind}}\n"
            buf.append l4
        }
        return true
    } else {
        return false
    }
}

# emitMatchBindValue -- `x: (match c case ok then 1 ...)`: declare the
# local and assign per arm; false when the value is not a match.
emitMatchBindValue: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    nm: StringView
    ct: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    match (
        n
    ) case caseexpr then {
        ld: "\{ind}\{ct} \{nm};\n"
        buf.append ld
        # each arm runs only when selected, as a statement match's arms do
        ctx.condDepth = ctx.condDepth + 1
        emitMatchStmt :ast :reg :typing :ctx m: n assignTo: nm :ind :tmp :buf
        ctx.condDepth = ctx.condDepth - 1
        return true
    } else {
        return false
    }
}

# isSimpleValueNode -- the node is a value expression, not a multi-statement
# block. A folded if-bind can only shortcut to emitExpr when its live branch is
# one; a block branch stays on the clause path, which knows how to assign from
# a body.
isSimpleValueNode: function {ast: Ast.view n: astnode.view} out bool is {
    ast.drop
    match (
        n
    ) case statement then {
        # emitExpr copes with a one-statement block; a longer body needs the
        # clause path, which assigns from a walked body
        return n.statements.count.u64 <= 1
    } else {
        return true
    }
}

# emitIfBindValue -- `s: if c then a else b`: declare the local and emit
# an if-statement assigning the branch value to it; false otherwise.
emitIfBindValue: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    nm: StringView
    ct: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    match (
        n
    ) case ifexpr then {
        # every condition folds to one live branch that is one value: declare
        # the local with that value, rather than emitting a runtime if whose
        # other arms are dead
        bfb: foldedBranchOf :typing nid: n.nodeid
        if bfb.known when bfb.stmt.notZero then {
            bwn: ast.nodes.get i: bfb.stmt
            if (isSimpleValueNode :ast n: bwn) then {
                bvx: emitExpr :ast :reg :typing :ctx n: bwn
                flushArgHoists :ctx :ind :tmp :buf
                lbf: "\{ind}\{ct} \{nm} = \{bvx};\n"
                buf.append lbf
                emitArmTakeZero :ast :reg :typing :ctx n: bwn rv: bvx.stringView :ind :buf
                return true
            }
        }
        ld: "\{ind}\{ct} \{nm};\n"
        buf.append ld
        emitIfAssign :ast :reg :typing :ctx :n target: nm :ind :tmp :buf
        return true
    } else {
        return false
    }
}

# emitIfAssign -- assign `target`, already declared, from an `if`'s value in
# statements: the live branch alone, in a bare block, when every condition
# folds; otherwise an if-statement each of whose branches assigns it. A branch
# that leaves (`return`, `break`, `continue`) runs as the statement it is and
# assigns nothing.
emitIfAssign: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.ifrow.view
    target: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    bfb: foldedBranchOf :typing nid: n.nodeid
    if bfb.known when bfb.stmt.notZero then {
        lbo: "\{ind}{\n"
        buf.append lbo
        indB: "\{ind}    "
        (
            emitBranchAssign
            :ast
            :reg
            :typing
            :ctx
            n: (ast.nodes.get i: bfb.stmt)
            :target
            scope: (
                branchScopeOf
                :ast
                clauses: n.clauses
                elseclause: n.elseclause
                stmt: bfb.stmt
            )
            ind: indB.stringView
            :tmp
            :buf
        )
        lbc: "\{ind}}\n"
        buf.append lbc
        return
    }
    # each branch runs only when selected, as a statement if's branches do
    ctx.condDepth = ctx.condDepth + 1
    first: true
    opened: u64
    for each cId: (zast.kidsOf :ast span: n.clauses) loop {
        isFirst: first
        first = false
        opened = (
            opened +
            (
                emitIfClause
                :ast
                :reg
                :typing
                :ctx
                n: (ast.nodes.get i: cId)
                :isFirst
                assignTo: target
                :ind
                :tmp
                :buf
            )
        )
    }
    chS: List String
    chV: ListVal ztypes.vid
    chA: ListVal zast.nameid
    chT: ListVal ztypes.tid
    chN: ListVal bool
    chR: List String
    chRF: ListVal cfacts
    (
        chainFactsOfClauses
        :ast
        :reg
        :typing
        :ctx
        clauses: n.clauses
        subjects: chS
        svids: chV
        arms: chA
        tids: chT
        negs: chN
        recvs: chR
        recvFs: chRF
    )
    (
        emitElse
        :ast
        :reg
        :typing
        :ctx
        oId: n.elseclause
        assignTo: target
        :ind
        :tmp
        chSubjects: chS
        chSubjectVids: chV
        chArms: chA
        chTids: chT
        chNegs: chN
        chRecvs: chR
        chRecvFs: chRF
        :buf
    )
    le: "\{ind}}\n"
    buf.append le
    for opened > 0 loop {
        opened = opened - 1
        buf.append le
    }
    ctx.condDepth = ctx.condDepth - 1
}

# iterableNodeId -- the stamped node id of a for-loop iterable: peel expression
# wrappers, then take the inner atom / dotted-field / call node (the expression
# wrapper itself may be unstamped for a `this._iterN` field iterator).
iterableNodeId: function {n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case atomid then {
        return n.nodeid
    } case dottedpath then {
        return n.nodeid
    } case call then {
        return n.nodeid
    } else {
        return zast.nodeid
    }
}

# isForIterCall -- the for-loop iterable is a call expression (an rvalue that
# must be hoisted to a temp before `&recv`); a bare atom / dotted field is an
# lvalue used directly.
isForIterCall: function {ast: Ast.view typing: ztyping.ZTyping.view n: astnode.view} out bool is {
    match (
        n
    ) case call then {
        return true
    } case dottedpath then {
        cn: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        if (
            (cn == zast.wellKnown.slot.wkIterate) or (cn == zast.wellKnown.slot.wkIterateMut)
        ) then return true
        return cn == zast.wellKnown.slot.wkIterateReverse
    } else {
        return false
    }
}

# objitertids -- what the iterable resolves to: the iterator class, and the
# generator function to call for it when the iterable was a bare fn name.
# A zero itid means the iterable names no iterator at all.
objitertids: record {
    # the iterator's type
    itid: ztypes.tid
    # the bare `.call` function behind it
    bareFnId: ztypes.tid
}

# objIterIterableTid -- the iterator class behind `for each x: <iterable> loop`: the
# iterable's stamp, or, for a bare generator fn, its return type, auto-called.
objIterIterableTid: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    cOp: zast.nodeid
} out objitertids is {
    oeid: iterableNodeId n: (ast.nodes.get i: cOp)
    iterableTid: stampIdOf :typing nid: oeid
    if iterableTid.isZero then {
        oeidF: interpPartNodeId n: (ast.nodes.get i: cOp)
        iterableTid = stampIdOf :typing nid: oeidF
    }
    itid: iterableTid
    # bare generator-fn iterable (`for each x: counter loop`): itid0 is the
    # generator function itself; resolve via its return type (the iterator
    # class) and auto-call it below.
    bareFnId: ztypes.tid
    if (reg.typetypeOf typeId: iterableTid) == ztypes.ztypetype.functionType then {
        brt: ztypes.tid
        brt = fnReturnTidOf :reg tid: iterableTid
        if brt.isZero then {
            mro: ztypecheck.methodReturnOf :reg :typing mid: iterableTid
            if mro.some then {
                brt = mro
            }
        }
        hasCall: typing.declHasMemberId parentTypeId: brt nameId: zast.wellKnown.slot.wkCall
        if brt.notZero when hasCall then {
            itid = brt
            bareFnId = iterableTid
        }
    }
    return (objitertids :itid :bareFnId)
}

# objIterYieldTid -- the type the iterator YIELDS. The registry knows it for a
# native iterator; a user-class one leaves returnTypeId unset and carries the
# stamp on the `.call` return node instead. A templated native's `call` is its
# template's, so its answer is read through the instance `itid`. Zero when
# neither names one.
objIterYieldTid: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    cco: ztypes.tid
} out ztypes.tid is {
    ovid: ztypes.tid
    rto: reg.returnTypeOf tid: cco
    if rto.notZero then ovid = rto
    if ovid.isZero then {
        # a user-class iterator whose `call` type records no return
        mro: ztypecheck.methodReturnOf :reg :typing mid: cco
        if mro.some then {
            ovid = mro
        }
    }
    return (ownSignatureTid :reg tid: ovid)
}

# objIterCallC -- the C name of the iterator's `.call`. An iterator whose `call`
# has a BODY, declared in whatever unit and of whatever family, is emitted by
# emitOneMethod under its own cname id; native and collection iterators keep the
# template's `{type}_call`.
objIterCallC: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx
    cco: ztypes.tid
    itid: ztypes.tid
} out String is {
    # the iterator is asked by its ids: a name looked up in the main unit
    # misses a class another unit declares, and wrote a `{type}_call` nothing
    # defines. WHO WROTE THE BODY is the whole question. A `call` with a body is
    # the author's (a generator's is) and emitOneMethod names it by its own
    # cname id; a native one (CpIter's, TextReader's, every collection cursor's)
    # is the runtime's, written out of a template as `{type}_call`.
    #
    # Neither the FAMILY nor the GENERIC ORIGIN decides it. emitOneMethod names
    # a record's method exactly as it names a class's, and an instance's exactly
    # as it names a non-generic one; asking either question spelled
    # `{type}_call` for an iterator nothing defines under that name -- C the
    # compiler emitted and the C compiler refused. `is native` already excludes
    # the templates, which is what the origin test was reaching for.
    callC: String
    isUserWritten: (reg.isNativeOf tid: cco).not
    if isUserWritten then {
        noteFnUse :ctx tid: cco
        callC = ctxCname :ctx tid: cco
    } else {
        itc: ctxCname :ctx tid: itid
        # a templated class's `call` is a section of its template
        if (tmplClassRowOf :reg :ctx tid: itid) > 0 then (
            noteMemberUse
            :ctx
            mono: itid
            member: memberWord.slot.call
        )
        callC = "\{itc}_call"
    }
    return callC
}

# emitObjIterRecv -- the iterator instance the loop calls into. A bare generator
# fn and an explicit `.iterate` call both produce a temporary the loop OWNS, so
# its destroy is registered for the enclosing block BEFORE the loop label --
# break and continue inside the loop must not free the live instance.
emitObjIterRecv: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    cNid: zast.nodeid
    cOp: zast.nodeid
    itid: ztypes.tid
    bareFnId: ztypes.tid
    itCb: StringView
    mN: u64
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out String is {
    giO: typing.forIterableField.get key: cNid
    if giO.some then {
        return (
            emitObjIterField
            :ast
            :reg
            :typing
            :ctx
            :cOp
            :itid
            :bareFnId
            :itCb
            gi: giO
            :ind
            :tmp
            :buf
        )
    }
    iterRecv: String
    ownGit: false
    if bareFnId.notZero then {
        bcn: spelledCname :ctx tid: bareFnId
        lgh: "\{ind}\{itCb}_t _git\{mN} = \{bcn}();\n"
        buf.append lgh
        iterRecv = "_git\{mN}"
        ownGit = true
    } else {
        ivexF: cfacts
        ivex: emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: cOp) facts: ivexF
        # A construction written as a bare TYPE NAME is an atom in the AST and a
        # call in the emitted C: the shape test reads `Counter` as an lvalue,
        # while what it becomes is `<T>_create(...)`, and the loop then asks for
        # `&` of it. The TEXT settles it -- anything an address cannot be taken
        # of is hoisted to the same owned temp a call already gets.
        # what the iterable's own arguments hoisted is declared ahead of it,
        # before the loop label like the instance
        flushArgHoists :ctx :ind :tmp :buf
        hoistIt: isForIterCall :ast :typing n: (ast.nodes.get i: cOp)
        if hoistIt.not then hoistIt = ivexF.place.not
        if hoistIt then {
            lgi: "\{ind}\{itCb}_t _git\{mN} = \{ivex};\n"
            buf.append lgi
            iterRecv = "_git\{mN}"
            ownGit = true
        } else {
            iterRecv = ivex.take
        }
    }
    # An ownership-moved argument must be zeroed in the CALLER, exactly as a
    # binding-position call does it. This position skipped that, so
    # `for each r: (g s: src) loop` with a `.take` param left `src` live: the
    # enclosing scope freed it and the iterator's destructor freed it again --
    # `free(): double free detected`. A non-call iterable reduces to a no-op.
    emitValueTakeInvalidations :ast :reg :typing :ctx n: (ast.nodes.get i: cOp) :ind :buf
    # the loop owns the iterator instance: register its destroy for the
    # enclosing block's flush (and the return path), freeing owned
    # captured params. Registered BEFORE the loop label so break /
    # continue inside the loop never free the live instance.
    # gated on structDestroyNontrivial: whether the destructor frees anything
    if ownGit when (structDestroyNontrivial :reg :typing :ctx tid: itid) then {
        noteDestroyUse :reg :typing :ctx tid: itid
        gdt: "    \{itCb}_destroy(&_git\{mN});\n"
        gdn: "_git\{mN}"
        tmp.oweList stmt: gdt name: gdn
    }
    return iterRecv
}

# emitObjIterField -- the iterator instance of a loop whose body suspends
# lives in the state class (the checker minted the field): assigned where the
# C local was, destroyed by the instance, and destroyed first when an outer
# loop re-enters the header with the previous instance still in it.
emitObjIterField: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    cOp: zast.nodeid
    itid: ztypes.tid
    bareFnId: ztypes.tid
    itCb: StringView
    gi: zast.nameid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out String is {
    recv: genFieldC :ast :reg :typing :ctx nameId: gi
    if (structDestroyNontrivial :reg :typing :ctx tid: itid) then {
        noteDestroyUse :reg :typing :ctx tid: itid
        ld: "\{ind}\{itCb}_destroy(&\{recv});\n"
        buf.append ld
    }
    ivex: String
    if bareFnId.notZero then {
        bcn: spelledCname :ctx tid: bareFnId
        ivex = "\{bcn}()"
    } else {
        ivex = emitExpr :ast :reg :typing :ctx n: (ast.nodes.get i: cOp)
    }
    flushArgHoists :ctx :ind :tmp :buf
    la: "\{ind}\{recv} = \{ivex};\n"
    buf.append la
    emitValueTakeInvalidations :ast :reg :typing :ctx n: (ast.nodes.get i: cOp) :ind :buf
    return recv
}

# emitObjIterPayload -- binding the yielded payload to the loop variable, in the
# three shapes a yield takes: a borrowed view (scalars copy, aggregates alias),
# an owned heap box (move the payload out, free the box), and a plain value.
emitObjIterPayload: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    ovid: ztypes.tid
    payC: StringView
    lbl: StringView
    lblV: ztypes.vid
    mN: u64
    ind: StringView
    buf: String.borrow
} out spillkind is {
    if (isViewUnionOriginOf :reg :ctx tid: ovid) then {
        # borrowed-view yield: a readonly view of a scalar or valtype copies
        # by value; everything else binds a borrowed pointer (no copy -> the
        # shared fields are never double-freed).
        payElemTid: (
            (typing.declChildOfId parentTypeId: ovid nameId: zast.wellKnown.slot.wkSome).or
            d: ztypes.tid.zero
        )
        payScalarC: cTypeForNameTid :ast :reg :typing :ctx tid: payElemTid
        # A REFTYPE payload must alias. Copying its struct duplicates
        # a pointer the container still owns, so a write through the
        # copy reallocs and frees under the container -- silently for a
        # valtype field, as a use-after-free for a reftype one. A
        # valtype or scalar payload is self-contained and copies safely.
        payRef: false
        if payElemTid.notZero then payRef = reg.isReftypeOf tid: payElemTid
        # An OptionMut yield (`iterateMut`) is written through, so even a
        # valtype payload aliases: a copy would take the writes. A StaticView
        # element is static storage, owned by the loop var, so it copies
        # whatever its family.
        payFam: monoFamilyOf :reg :ctx tid: ovid
        payWrites: (payFam == family.slot.optionMut) or (payFam == family.slot.optionMutVal)
        copyOut: payRef.not and payWrites.not
        if payFam == family.slot.staticView then copyOut = true
        if payScalarC.length > 0 when copyOut then {
            vsl: "_iter\{mN}.data"
            dv: armCellDeref pc: payC slot: vsl.stringView
            l3v: "\{ind}    \{payC} \{lbl} = \{dv};\n"
            buf.append l3v
            # a static element is the loop var's own value: it is saved as one
            if payFam == family.slot.staticView then return spillkind.copy
            return spillkind.viewCopy
        } else {
            psl: "_iter\{mN}.data"
            dp: armCellPtr pc: payC slot: psl.stringView
            l3p: "\{ind}    \{payC}* __borrow_\{lbl} = \{dp};\n"
            buf.append l3p
            l3pa: "\{ind}    /* alias: \{lbl} => (*__borrow_\{lbl}) */\n"
            buf.append l3pa
            bindBorrowAlias :ctx vid: lblV nm: lbl
            return spillkind.viewPtr
        }
    } else if (
        originIsTid
        :reg
        tid: ovid
        originTid: (ctx.origins.get i: family.slot.option)
    ) then {
        # owned heap yield: move the payload out, free just the box; the
        # loop var owns it and is freed at the end of each iteration.
        idl: "_iter\{mN}.data"
        dop: armCellDeref pc: payC slot: idl.stringView
        l3op: "\{ind}    \{payC} \{lbl} = \{dop};\n"
        buf.append l3op
        fr: armCellFree slot: idl.stringView
        buf.append "\{ind}    \{fr}\n"
        return spillkind.owned
    } else {
        isC: (
            memberC
            :ast
            :reg
            :typing
            :ctx
            owner: ovid
            kind: memberkind.arm
            nameId: zast.wellKnown.slot.wkSome
        )
        l3: "\{ind}    \{payC} \{lbl} = _iter\{mN}.data.\{isC};\n"
        buf.append l3
        return spillkind.copy
    }
}

# pushPayloadSpill -- a suspending loop's payload is saved to the field the
# checker minted for it at every yield inside the loop and reloaded at the
# label: the local for an owned or value payload, the `_iterN` wrapper for a
# borrowed view, whose pointer or copy the reload re-derives. True when a
# spill was pushed, so the loop's end can pop it.
pushPayloadSpill: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    cNid: zast.nodeid
    pk: spillkind
    lbl: StringView
    mN: u64
    payC: StringView
    # the payload's type
    payTid: ztypes.tid
} out bool is {
    if ctx.genActive.not then return false
    pfO: typing.forPayloadField.get key: cNid
    match (
        pfO
    ) case some then {
        savedO: lbl.string
        restoredO: lbl.string
        if pk.viewPtr then {
            savedO = "_iter\{mN}"
            restoredO = "__borrow_\{lbl}"
        }
        if pk.viewCopy then savedO = "_iter\{mN}"
        fldS: genFieldC :ast :reg :typing :ctx nameId: pfO
        ctx.genForSpills.append (
            ForSpill
            field: fldS
            saved: savedO
            restored: restoredO
            kind: pk
            payC: payC.string
            payZero: (movedZeroC :reg :typing :ctx tid: payTid)
        )
        return true
    } case none then {
        return false
    }
}

# emitObjIterLoop -- the `while (1) { T _iter = C_call(&recv); ... }` an object
# iterator becomes: the yield type, the receiver, its destroy registration, the
# per-iteration payload bind, the body, and the loop labels.
emitObjIterLoop: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: zast.forrow.view
    cNid: zast.nodeid
    cOp: zast.nodeid
    cco: ztypes.tid
    itid: ztypes.tid
    bareFnId: ztypes.tid
    lbl: StringView
    lblV: ztypes.vid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    ovid: objIterYieldTid :reg :typing :cco
    # neither the registered return nor the .call stamp names a yield
    # type: there is no iterator to emit against.
    if ovid.isZero then return false
    callC: objIterCallC :reg :ctx :cco :itid
    ovc: spelledCname :ctx tid: ovid
    mN: tmpNext :ctx :tmp
    itCb: spelledCname :ctx tid: itid
    iterRecv: (
        emitObjIterRecv
        :ast
        :reg
        :typing
        :ctx
        :cNid
        :cOp
        :itid
        :bareFnId
        itCb: itCb.stringView
        :mN
        :ind
        :tmp
        :buf
    )
    lidO: pushLoopLabel :ctx :tmp isDo: false postTest: m.postconditions.count.u64 > 0
    l0: "\{ind}while (1) {\n"
    buf.append l0
    l1: "\{ind}    \{ovc}_t _iter\{mN} = \{callC}(&\{iterRecv});\n"
    buf.append l1
    (
        emitOptionLoopTail
        :ast
        :reg
        :typing
        :ctx
        :m
        :cNid
        :ovid
        ovc: ovc.stringView
        :lbl
        :lblV
        :mN
        :lidO
        :ind
        :tmp
        :buf
    )
    return true
}

# emitOptionLoopTail -- the rest of a loop whose binding answers an option into
# `_iterN` at the top of every iteration: the `none` break, the payload bind
# and its spill, the `while:` arms, the body, the iteration's end and the
# loop's close. The caller has opened `while (1) {`, written the `_iterN` line
# and pushed the loop label.
emitOptionLoopTail: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: zast.forrow.view
    cNid: zast.nodeid
    # the option type `_iterN` holds, and its C name
    ovid: ztypes.tid
    ovc: StringView
    lbl: StringView
    lblV: ztypes.vid
    mN: u64
    lidO: u64
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    ovNone: spelledTagConst :ast :ctx :reg :typing tid: ovid armId: zast.wellKnown.slot.wkNone
    payC: armPayloadC :ast :reg :typing :ctx tid: ovid arm: zast.wellKnown.slot.wkSome
    if (originIsTid :reg tid: ovid originTid: (ctx.origins.get i: family.slot.option)) then {
        # owned heap-payload union: destroy the box on the NONE arm too.
        noteDestroyUse :reg :typing :ctx tid: ovid
        l2o: "\{ind}    if (_iter\{mN}.tag == \{ovNone}) { \{ovc}_destroy(&_iter\{mN}); break; }\n"
        buf.append l2o
    } else {
        l2: "\{ind}    if (_iter\{mN}.tag == \{ovNone}) break;\n"
        buf.append l2
    }
    pk: (
        emitObjIterPayload
        :ast
        :reg
        :typing
        :ctx
        :ovid
        payC: payC.stringView
        :lbl
        :lblV
        :mN
        :ind
        :buf
    )
    payTid: (
        (typing.declChildOfId parentTypeId: ovid nameId: zast.wellKnown.slot.wkSome).or
        d: ztypes.tid.zero
    )
    pushedO: (
        pushPayloadSpill
        :ast
        :reg
        :typing
        :ctx
        :cNid
        :pk
        :lbl
        :mN
        payC: payC.stringView
        :payTid
    )
    bodyInd: "\{ind}    "
    lLO: tmp.listFrees.length
    # the arms are tested AFTER the payload binds, so one may read the loop
    # variable; the iterator has already advanced, which is the order the
    # conditions are written in
    armO: forArmCond :ast :reg :typing :ctx n: m
    flushArgHoists :ctx ind: bodyInd.stringView :tmp :buf
    (
        emitForArmBreak
        :ast
        :reg
        :typing
        :ctx
        node: m.nodeid
        armc: armO.stringView
        ind: bodyInd.stringView
        :buf
    )
    dvG: false
    if m.body.notZero then {
        mb: ast.nodes.get i: m.body
        emitBodyNode :ast :reg :typing :ctx n: mb ind: bodyInd.stringView :tmp :buf
        dvG = blockDiverges :ast :reg :typing :ctx n: mb
    }
    closeScopeBlock :ast :reg :typing :ctx :tmp lL: lLO diverged: dvG node: m.body :buf
    (
        emitIterationEnd
        :ast
        :reg
        :typing
        :ctx
        :m
        id: lidO
        diverged: dvG
        ind: bodyInd.stringView
        :tmp
        :buf
    )
    l: "\{ind}}\n"
    buf.append l
    popLoopLabel :ctx id: lidO :ind :buf
    # the payload leaves C scope with the loop, so a suspension after it must
    # not spill it
    if pushedO then ctx.genForSpills.pop
}

# objIterForNamed -- the single `name: iterable` condition of an object-iterator
# for-loop. False when the iterable resolves to no iterator, so the caller can
# try the other for-loop shapes.
objIterForNamed: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: zast.forrow.view
    cNid: zast.nodeid
    cName: zast.nameid
    cOp: zast.nodeid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    lblR: zast.nameTextAt :ast ref: cName
    if lblR.length == 0 then return false
    # an `each` binding the checker walked through an implied `.iterate` is
    # emitted from the `E.iterate` node it minted, as the written call would be
    cOp = (typing.forImplicitIterate.get key: cNid).or d: cOp
    lblV: defVid :typing nid: (interpPartNodeId n: (ast.nodes.get i: cOp))
    lbl: varCName :ctx :ast :reg vid: lblV
    tids: objIterIterableTid :ast :reg :typing :cOp
    if tids.itid.isZero then return false
    itid: tids.itid
    bareFnId: tids.bareFnId
    cco: typing.declChildOfId parentTypeId: itid nameId: zast.wellKnown.slot.wkCall
    match (
        cco
    ) case some then {
        return (
            emitObjIterLoop
            :ast
            :reg
            :typing
            :ctx
            :m
            :cNid
            :cOp
            :cco
            :itid
            :bareFnId
            lbl: lbl.stringView
            :lblV
            :ind
            :tmp
            :buf
        )
    } case none then {
        return false
    }
}


# emitPlainBindingFor -- `for x: E loop`, a binding written without `each`: E is
# evaluated at the top of EVERY iteration into `_iterN`, and the loop ends at
# the first `none`. What E's own arguments hoisted is freed as soon as its
# value is in hand; the rest is the loop an iterator's `call` drives. False
# when the header has no plain binding.
emitPlainBindingFor: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: zast.forrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    if m.isEach then return false
    if m.conditions.count.u64 == 0 then return false
    c0Id: zast.kidAt kids: ast.kids span: m.conditions i: 0
    c0: ast.nodes.get i: c0Id
    if c0.namedoperation.not then return false
    lblR: zast.nameTextAt :ast ref: c0.name
    if lblR.length == 0 then return false
    opN: ast.nodes.get i: c0.operation
    lblV: defVid :typing nid: (interpPartNodeId n: opN)
    lbl: varCName :ctx :ast :reg vid: lblV
    ovid: stampTidDeep :reg :typing n: opN
    if ovid.isZero then return false
    ovc: spelledCname :ctx tid: ovid
    mN: tmpNext :ctx :tmp
    lidO: pushLoopLabel :ctx :tmp isDo: false postTest: m.postconditions.count.u64 > 0
    buf.append "\{ind}while (1) {\n"
    bodyInd: "\{ind}    "
    lL: tmp.listFrees.length
    ev: emitExpr :ast :reg :typing :ctx n: opN
    flushArgHoists :ctx ind: bodyInd.stringView :tmp :buf
    buf.append "\{bodyInd}\{ovc}_t _iter\{mN} = \{ev};\n"
    flushBlockFrees :tmp :lL diverged: false :buf
    emitValueTakeInvalidations :ast :reg :typing :ctx n: opN ind: bodyInd.stringView :buf
    (
        emitOptionLoopTail
        :ast
        :reg
        :typing
        :ctx
        :m
        cNid: c0Id
        :ovid
        ovc: ovc.stringView
        lbl: lbl.stringView
        :lblV
        :mN
        :lidO
        :ind
        :tmp
        :buf
    )
    return true
}

# emitObjIterFor -- `for each x: <iter> loop` where <iter> is an iterator value
# (a type with a `.call` child returning optionval/Option). Emits the
# while(1) / call / tag==NONE break / payload-extract pattern. Value
# payloads (optionval) extract `.data.some`; reftype payloads (Option)
# wait on the heap-extract slice. Returns false when not an iterator loop.
emitObjIterFor: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: zast.forrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    if m.conditions.count.u64 == 0 then return false
    c0Id: zast.kidAt kids: ast.kids span: m.conditions i: 0
    c0: ast.nodes.get i: c0Id
    match (
        c0
    ) case namedoperation then {
        return (
            objIterForNamed
            :ast
            :reg
            :typing
            :ctx
            :m
            cNid: c0Id
            cName: c0.name
            cOp: c0.operation
            :ind
            :tmp
            :buf
        )
    } else {
        return false
    }
}

# emitIntRangeFor -- `for each x: <integer range> loop`: the header's shared
# preamble, then whichever family the range belongs to. Returns false when the
# header is not a single integer-range binding.
#
# The two families are emitted separately because they read their header
# differently -- a half-open range's receiver is its BOUND, a closed one's is
# its START -- while the label and the bail above them are the same question
# asked once.
emitIntRangeFor: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: zast.forrow.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    if m.conditions.count.u64 == 0 then return false
    c0Id: zast.kidAt kids: ast.kids span: m.conditions i: 0
    c0: ast.nodes.get i: c0Id
    match (
        c0
    ) case namedoperation then {
        labelText: zast.nameTextAt :ast ref: c0.name
        if labelText.length == 0 then return false
        labelVid: defVid :typing nid: (interpPartNodeId n: (ast.nodes.get i: c0.operation))
        lbl: if labelVid.isZero then nameCName :ctx name: labelText.stringView else (
            varCName
            :ctx
            :ast
            :reg
            vid: labelVid
        )
        # THE CLOSED FAMILY FIRST, because rangeBoundExpr answers "" for it: a
        # closed range's receiver is its start, not its bound, so it has no
        # bound to read and the half-open leg would decline the header and hand
        # it to the object path to build a cursor.
        crM: closedRangeMemberOf :ast :typing n: (ast.nodes.get i: c0.operation)
        if crM.notZero then return (
            emitClosedRangeFor
            :ast
            :reg
            :typing
            :ctx
            :m
            n: (ast.nodes.get i: c0.operation)
            lbl: lbl.stringView
            down: crM == zast.wellKnown.slot.wkDownto
            :ind
            :tmp
            :buf
        )
        return (
            emitCountedRangeFor
            :ast
            :reg
            :typing
            :ctx
            :m
            n: (ast.nodes.get i: c0.operation)
            lbl: lbl.stringView
            :ind
            :tmp
            :buf
        )
    } else {
        return false
    }
}

# emitCountedRangeFor -- `for each x: N.times loop`: the HALF-OPEN range, walked by
# the same trip count the closed forms use. A count starts at 0 -- `times` takes
# no argument to start it anywhere else. False when the operand drives no
# counted range.
#
# THE COUNT IS READ ONCE, which is the whole of the difference from
# `x < (N)`: that re-read N at every test, so a body that assigned to N drove
# the loop -- `for each i: n.times loop { n = n + 100 }` never terminated, while the
# same range held as a value ran n times, because `intrange` captures its count
# at construction. One spelling of one loop cannot mean two things.
emitCountedRangeFor: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: zast.forrow.view
    n: astnode.view
    lbl: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    bound: rangeBoundExpr :ast :reg :typing :ctx :n
    if bound.length == 0 then return false
    rtR: rangeTid :ast :reg :typing :n
    ctR: intScalarCTypeOf :typing tid: rtR
    if ctR.length == 0 then return false
    mN: tmpNext :ctx :tmp
    fn: "_fn\{mN}"
    rk: ztypecheck.numKindOfTid :typing tid: rtR
    cnt: (
        countRangeCountExpr
        signed: rk.has and (ztypes.isSignedIntKind k: rk.kind)
        bound: bound.stringView
    )
    # the temporaries the count's expression recorded are declared ahead of it
    flushArgHoists :ctx :ind :tmp :buf
    d0: "\{ind}uint64_t \{fn} = \{cnt};\n"
    buf.append d0
    lidR: pushLoopLabel :ctx :tmp isDo: false postTest: m.postconditions.count.u64 > 0
    # A suspension inside the body RETURNS from `.call`, and the resume `goto`
    # lands inside the loop, PAST the C for-init -- so the counter and the
    # count, which live only in the header, are indeterminate on the next call
    # and the loop yields once and reports itself exhausted. Neither is a local
    # the checker keeps in the instance: a `for` label is a nameid on the
    # header's namedoperation and carries no variable id to alias a field to.
    # Both keep their C locals -- so the header, `continue` and the step are
    # untouched -- and are SPILLED to state fields across each suspension.
    pushed: false
    if ctx.genActive when (zast.yieldCountIn :ast nid: m.body) > 0 then {
        ctx.genForNext = ctx.genForNext + 1
        fcF: genSynthField :typing :ctx which: gensynth.forCounter k: ctx.genForNext
        fcC: genFieldC :ast :reg :typing :ctx nameId: fcF
        ctx.genForSpills.append (
            ForSpill
            field: fcC
            saved: lbl.string
            restored: lbl.string
            kind: spillkind.copy
            payC: String
            payZero: String
        )
        fnF: genSynthField :typing :ctx which: gensynth.forCount k: ctx.genForNext
        fnC: genFieldC :ast :reg :typing :ctx nameId: fnF
        ctx.genForSpills.append (
            ForSpill
            field: fnC
            saved: fn.copy
            restored: fn.copy
            kind: spillkind.copy
            payC: String
            payZero: String
        )
        pushed = true
    }
    st1: "\{fn} = \{fn} - 1"
    st2: "\{lbl} = (\{ctR})((uint64_t)\{lbl} + 1ULL)"
    lh: "\{ind}for (\{ctR} \{lbl} = 0; \{fn} > 0; \{st1}, \{st2}) {\n"
    buf.append lh
    bodyInd: "\{ind}    "
    armC: forArmCond :ast :reg :typing :ctx n: m
    flushArgHoists :ctx ind: bodyInd.stringView :tmp :buf
    (
        emitForArmBreak
        :ast
        :reg
        :typing
        :ctx
        node: m.nodeid
        armc: armC.stringView
        ind: bodyInd.stringView
        :buf
    )
    # the body is a BLOCK: whatever it registers -- an argument hoisted to an
    # `_ah` temp, an owned local -- is declared per iteration and has to be
    # freed per iteration. Without the mark those frees stayed pending and
    # landed after the loop, naming a temp that had left C scope.
    lLR: tmp.listFrees.length
    dvR: false
    if m.body.notZero then {
        bodyNode: ast.nodes.get i: m.body
        emitBodyNode :ast :reg :typing :ctx n: bodyNode ind: bodyInd.stringView :tmp :buf
        dvR = blockDiverges :ast :reg :typing :ctx n: bodyNode
    }
    closeScopeBlock :ast :reg :typing :ctx :tmp lL: lLR diverged: dvR node: m.body :buf
    (
        emitIterationEnd
        :ast
        :reg
        :typing
        :ctx
        :m
        id: lidR
        diverged: dvR
        ind: bodyInd.stringView
        :tmp
        :buf
    )
    lc: "\{ind}}\n"
    buf.append lc
    popLoopLabel :ctx id: lidR :ind :buf
    # both leave C scope with the loop, so a suspension after it must not
    # spill either
    if pushed then {
        ctx.genForSpills.pop
        ctx.genForSpills.pop
    }
    return true
}

# closedRangeCmp -- the guard a closed range is entered under: an ASCENDING
# range whose start is already past its end walks nothing, and a descending one
# whose start is already below it does the same. One compare, outside the loop.
closedRangeCmp: function {down: bool} out StringView is {
    if down then return ">="
    return "<="
}

# closedRangeStepOp -- which way the loop variable moves.
closedRangeStepOp: function {down: bool} out StringView is {
    if down then return "-"
    return "+"
}

# emitClosedRangeFor -- `for each x: (F.upto to: T) loop` and its `downto` twin: the
# CLOSED range lowered to a counted C loop, with no range object constructed.
#
# A closed range cannot be driven by an endpoint comparison. `i >= 0` on an
# unsigned type is true forever and the step wraps at zero, and a range whose
# last value is its type's MAXIMUM has no value past it to stop at -- the two
# shapes the closed forms exist to serve. So the loop counts down a trip count,
# exactly as `intrange` does.
#
# The loop variable stays in the for-INIT, where the half-open form keeps it,
# and steps in the THIRD clause so `continue` reaches the step. It steps through
# u64, which is defined at every width and sign; its final step is dead and may
# wrap (`3.u8.downto to: 0` leaves it at 255), because the count has already
# reached zero and the loop has left.
#
# Both ends are bound to locals first: each is read twice, once by the guard and
# once by the count or the init, and re-emitting the expression would evaluate
# it twice. Each binding is its own statement, built and written in the order
# the ends are written -- the start, then the end -- with the temporaries its
# expression recorded declared just ahead of it: those run when declared, so a
# temporary of the end declared ahead of the start would run first.
emitClosedRangeFor: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    m: zast.forrow.view
    n: astnode.view
    lbl: StringView
    down: bool
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    # asked of the WHOLE node, before the match below narrows it to the call
    # row: both readers take the node the header binds, as rangeBoundExpr's
    # arms do
    ctR: rangeCType :ast :reg :typing :n
    if ctR.length == 0 then return false
    # both ends' shapes are checked before either is built: nothing may be
    # written once the first is
    toNid: rangeToNode :ast :n
    if toNid.isZero then return false
    match (
        n
    ) case call then {
        startNid: dottedParentNodeId n: (ast.nodes.get i: n.callable)
        if startNid.isZero then return false
        mN: tmpNext :ctx :tmp
        rs: "_rs\{mN}"
        re: "_re\{mN}"
        fn: "_fn\{mN}"
        cnt: closedRangeCountExpr from: rs.stringView to: re.stringView :down
        lidR: pushLoopLabel :ctx :tmp isDo: false postTest: m.postconditions.count.u64 > 0
        startx: emitExpr :ast :reg :typing :ctx n: (ast.nodes.get i: startNid)
        flushArgHoists :ctx :ind :tmp :buf
        d0: "\{ind}\{ctR} \{rs} = \{startx};\n"
        buf.append d0
        tox: emitExpr :ast :reg :typing :ctx n: (ast.nodes.get i: toNid)
        flushArgHoists :ctx :ind :tmp :buf
        d1: "\{ind}\{ctR} \{re} = \{tox};\n"
        buf.append d1
        d2: "\{ind}uint64_t \{fn} = 0;\n"
        buf.append d2
        gd: closedRangeCmp :down
        d3: "\{ind}if (\{rs} \{gd} \{re}) \{fn} = \{cnt};\n"
        buf.append d3
        # TWO values cross a suspension here where the half-open form spills
        # one: the resume `goto` lands past the C for-init, and the count is no
        # more recomputable than the variable -- the ends it was taken from
        # left C scope with the declarations above.
        pushed: false
        if ctx.genActive when (zast.yieldCountIn :ast nid: m.body) > 0 then {
            ctx.genForNext = ctx.genForNext + 1
            fcF: genSynthField :typing :ctx which: gensynth.forCounter k: ctx.genForNext
            fcC: genFieldC :ast :reg :typing :ctx nameId: fcF
            ctx.genForSpills.append (
                ForSpill
                field: fcC
                saved: lbl.string
                restored: lbl.string
                kind: spillkind.copy
                payC: String
                payZero: String
            )
            fnF: genSynthField :typing :ctx which: gensynth.forCount k: ctx.genForNext
            fnC: genFieldC :ast :reg :typing :ctx nameId: fnF
            ctx.genForSpills.append (
                ForSpill
                field: fnC
                saved: fn.copy
                restored: fn.copy
                kind: spillkind.copy
                payC: String
                payZero: String
            )
            pushed = true
        }
        sp: closedRangeStepOp :down
        st1: "\{fn} = \{fn} - 1"
        st2: "\{lbl} = (\{ctR})((uint64_t)\{lbl} \{sp} 1ULL)"
        lh: "\{ind}for (\{ctR} \{lbl} = \{rs}; \{fn} > 0; \{st1}, \{st2}) {\n"
        buf.append lh
        bodyInd: "\{ind}    "
        armX: forArmCond :ast :reg :typing :ctx n: m
        flushArgHoists :ctx ind: bodyInd.stringView :tmp :buf
        (
            emitForArmBreak
            :ast
            :reg
            :typing
            :ctx
            node: m.nodeid
            armc: armX.stringView
            ind: bodyInd.stringView
            :buf
        )
        lLR: tmp.listFrees.length
        dvR: false
        if m.body.notZero then {
            bodyNode: ast.nodes.get i: m.body
            emitBodyNode :ast :reg :typing :ctx n: bodyNode ind: bodyInd.stringView :tmp :buf
            dvR = blockDiverges :ast :reg :typing :ctx n: bodyNode
        }
        closeScopeBlock :ast :reg :typing :ctx :tmp lL: lLR diverged: dvR node: m.body :buf
        (
            emitIterationEnd
            :ast
            :reg
            :typing
            :ctx
            :m
            id: lidR
            diverged: dvR
            ind: bodyInd.stringView
            :tmp
            :buf
        )
        lc: "\{ind}}\n"
        buf.append lc
        popLoopLabel :ctx id: lidR :ind :buf
        if pushed then {
            ctx.genForSpills.pop
            ctx.genForSpills.pop
        }
        return true
    } else {
        return false
    }
}

# isListWalkMember -- `iterate`, `iterateReverse` or `iterateMut`: the three
# walks a list-family receiver hands back a cursor for. Each emits the C
# function of its own name, so they are ONE leg rather than three compares --
# which is the shape A001 exists to discourage.
isListWalkMember: function {name: StringView} out bool is {
    if name.length == 0 then return false
    known: " iterate iterateReverse iterateMut "
    probe: " \{name} "
    return (known.contains needle: probe)
}

# isListReadWalkMember -- the two READONLY walks, which a view declares too.
# `iterateMut` is the owner's alone.
isListReadWalkMember: function {name: StringView} out bool is {
    if name.length == 0 then return false
    known: " iterate iterateReverse "
    probe: " \{name} "
    return (known.contains needle: probe)
}


# isCountRangeMemberId -- `times`, by INTERNED ID: the COUNT family, whose
# receiver is the range's BOUND and whose walk is half-open. Both legs of the
# count emit ask through here, and they must agree: a recogniser that accepts
# the member while the bound reader does not sends `for each x: N.times loop` past
# the counted-loop path into the iterator protocol, where it never advances --
# a loop that prints the receiver forever.
isCountRangeMemberId: function {id: zast.nameid} out bool is {
    return id == zast.wellKnown.slot.wkTimes
}

# isClosedRangeMemberId -- `upto` or `downto`, by INTERNED ID. SEPARATE from
# isCountRangeMemberId deliberately: that one's callers read the receiver as the
# range's BOUND, and a closed range's receiver is its START. Teaching the two
# names to it would emit `for (T i = 0; i < start; i++)` and walk the wrong
# values with no diagnostic -- the mirror of the failure recorded above, where
# one of two recognisers knows the member and the other does not. rangeCType asks
# both, because the width is the receiver's whichever family it is.
isClosedRangeMemberId: function {id: zast.nameid} out bool is {
    return (id == zast.wellKnown.slot.wkUpto) or (id == zast.wellKnown.slot.wkDownto)
}

# closedRangeMemberOf -- the closed-range member a `for` header's operation
# calls, or 0 for anything else. Only the CALL shape can name one: the endpoint
# arrives as a `to:` argument, so there is no bare dotted-path spelling to test.
closedRangeMemberOf: function {
    ast: Ast.view typing: ztyping.ZTyping.view n: astnode.view
} out zast.nameid is {
    match (
        n
    ) case call then {
        mnId: aliasChildNameId :ast :typing n: (ast.nodes.get i: n.callable)
        if (isClosedRangeMemberId id: mnId) then return mnId
        return zast.nameid
    } else {
        return zast.nameid
    }
}

# rangeToNode -- the node of a closed range's `to:` endpoint, 0 when the call
# has no such argument. The argument is taken by POSITION rather than by its
# label: `upto` and `downto` declare one parameter each, and the member has
# already been identified by interned id before this is asked, so the single
# argument present is that endpoint.
rangeToNode: function {ast: Ast.view n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case call then {
        if n.arguments.count.u64 != 1 then return zast.nodeid
        aId: zast.kidAt kids: ast.kids span: n.arguments i: 0
        a: ast.nodes.get i: aId
        if a.namedoperation then return a.operation
        return zast.nodeid
    } else {
        return zast.nodeid
    }
}

# countRangeCountExpr -- the trip count `times` walks: the receiver itself,
# which IS the count, read once into u64.
#
# A SIGNED receiver clamps at zero, as the stdlib body does with
# `(v.u64.or d: 0)`: a negative count walks nothing, and reinterpreting one as
# u64 would walk 1.8e19. An unsigned receiver needs no test, and emitting one
# would be a comparison the C compiler is right to warn about.
countRangeCountExpr: function {signed: bool bound: StringView} out String is {
    if signed.not then {
        cu: "(uint64_t)(\{bound})"
        return cu
    }
    cs: "(\{bound}) < 0 ? 0 : (uint64_t)(\{bound})"
    return cs
}

# closedRangeCountExpr -- the trip count a closed range walks: the number of
# values in `[lo, hi]`, which is `hi - lo + 1` taken in the UNSIGNED domain.
#
# One expression serves all eight integer types and both directions. Each end is
# reinterpreted through u64 first -- the two's complement `.bits` names in the
# stdlib -- so a signed range spanning zero does not overflow the way `to - from`
# would, and an unsigned one is simply zero-extended. The stdlib writes the
# unsigned case as `(to - v).u64 + 1`, subtracting at the receiver's own width;
# that truncation is a no-op here because the caller has already guarded
# `lo <= hi`, so the difference cannot exceed what the receiver's width holds.
# The two spellings therefore agree on every value, which is what must not drift.
#
# The full span is the one count this cannot express: `hi - lo` is then u64's
# maximum and the `+ 1` wraps to zero, so the loop walks nothing. `intrange`
# has the same hole, and closing it is not a lowering question.
closedRangeCountExpr: function {from: StringView to: StringView down: bool} out String is {
    if down then {
        cd: "((uint64_t)\{from} - (uint64_t)\{to}) + 1ULL"
        return cd
    }
    cu: "((uint64_t)\{to} - (uint64_t)\{from}) + 1ULL"
    return cu
}

# rangeBoundExpr -- the upper bound of an `N.times` range: the dotted receiver
# N, which the half-open walk stops below. "" for anything else.
#
# There is no other shape to read. Integers are not iterable, so no bare
# `for each x: N loop` makes an operand its own bound, and `times` takes no arguments,
# so it is never a call. A CLOSED range is read by closedRangeMemberOf/rangeToNode
# instead -- its receiver is the range's start, not its bound.
rangeBoundExpr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
} out String is {
    match (
        n
    ) case dottedpath then {
        cmnId: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        if (isCountRangeMemberId id: cmnId) then {
            # the receiver may be a dotted path itself (squares.length.times) --
            # stampTidDeep resolves its scalar type either way
            bct: (
                intScalarCTypeOf
                :typing
                tid: (stampTidDeep :reg :typing n: (ast.nodes.get i: n.parent))
            )
            if bct.length > 0 then {
                return (emitExpr :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent))
            }
        }
        return "".string
    } else {
        return "".string
    }
}

# intScalarCTypeOf -- the C scalar an INTEGER tid spells, "" for anything else.
# Asked by canonical id: a user type shadowing a scalar name emits its own
# struct, and a float or bool receiver is no counter at all -- counted in an
# integer a float bound would truncate silently.
intScalarCTypeOf: function {
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
} out String is {
    if tid.isZero then return "".string
    nk: ztypecheck.numKindOfTid :typing :tid
    if nk.has.not then return "".string
    if (ztypes.isFloatKind k: nk.kind) then return "".string
    return (scalarCTypeFor :typing :tid)
}

# rangeTid -- the type a counted range's induction variable takes: its
# RECEIVER's, the numeric type the range yields. 0 for a node that is no
# counted range.
rangeTid: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out ztypes.tid is {
    match (
        n
    ) case call then {
        # the CLOSED family: only it takes an argument, so only it is a call
        callableNode: ast.nodes.get i: n.callable
        if (isClosedRangeMemberId id: (aliasChildNameId :ast :typing n: callableNode)) then {
            rsid: dottedReceiverStampId :ast :typing callable: callableNode
            return (tidDeep :reg sid: rsid)
        }
        return ztypes.tid.zero
    } case dottedpath then {
        # the COUNT family, whose receiver rangeBoundExpr reads as the bound
        cmnId: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        if (isCountRangeMemberId id: cmnId) then {
            rt2: stampTidDeep :reg :typing n: (ast.nodes.get i: n.parent)
            return rt2
        }
        return ztypes.tid.zero
    } else {
        return ztypes.tid.zero
    }
}

# rangeCType -- the C type a counted range's induction variable takes: the
# RECEIVER's, which is what the range yields and so what the loop name binds.
# "" when the operand drives no counted range, and the arms are
# rangeBoundExpr's own -- the bound and the width are the same receiver read
# two ways, so they must agree about which node that is.
#
# Written `int64_t` the counter was signed whatever the width, so a u64 bound
# above i64's maximum compared as a negative number and the loop ran once or
# not at all. A u8 range counted in 64 bits and the loop name, typed u8, was
# assigned from a wider counter at every step.
rangeCType: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out String is {
    return (intScalarCTypeOf :typing tid: (rangeTid :ast :reg :typing :n))
}

# emitForCond -- one `while:` arm of a for-header, joined into the loop
# condition. A NAMED arm is not one: it binds what the loop walks, and the
# range and iterator emitters drive it. Every caller skips it.
emitForCond: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    cond: String.borrow
} is {
    if n.namedoperation then {
        if (zast.nameTextAt :ast ref: n.name).length > 0 then return
        if (condFoldsTrue :typing nid: n.nodeid) then return
        # a loop's test runs at every iteration, so it is evaluated in place
        mk7: openInPlace :ctx guarded: true
        cvF: cfacts
        cv: valueExprC :ast :reg :typing :ctx n: (ast.nodes.get i: n.operation) facts: cvF
        tw7: (
            truthyCondText
            :ast
            :reg
            :typing
            :ctx
            n: (ast.nodes.get i: n.operation)
            raw: cv.stringView
        )
        if tw7.length > 0 then cv = tw7.take
        if cond.length > 0 then cond.append " && "
        appendInPlaceCond :ctx mark: mk7 text: cv.stringView dst: cond
    }
}

# armCellFacts -- the facts of an arm's payload read off a subject whose facts
# are `recvF`: an inline payload is a member of it, a boxed one is loaded
# through the pointer a member of it holds.
armCellFacts: function {recvF: cfacts inline: bool} out cfacts is {
    if inline then return (memberFacts b: recvF)
    return (operandFacts e: (memberFacts b: recvF) place: true)
}

# armAliasText -- the C lvalue for `recv`'s payload of `arm` on sum type
# `tid`: the inline union member for variants, the heap cast for unions.
# "" when the arm carries no payload.
armAliasText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    arm: zast.nameid
    recv: StringView
    recvF: cfacts
    acc: StringView
    facts: cfacts.borrow
} out String is {
    # the payload type is recorded where the alias is read: an arm that never
    # reads it spells no cast
    held: ListVal ztypes.tid
    pc: heldArmPayloadC :ast :reg :typing :ctx :tid :arm :held
    if pc.length == 0 then return "".string
    if (reg.typetypeOf typeId: tid) == ztypes.ztypetype.unionType then {
        inl: armIsInlineC :typing :tid :arm
        rsl: armSlotC :ast :reg :typing :ctx :tid :recv :acc :arm inline: inl
        ut: (
            stating
            :facts
            from: (armCellFacts :recvF inline: inl)
            text: (armCellRef pc: pc.stringView slot: rsl.stringView inline: inl)
        )
        holdForAlias :ctx val: ut.stringView :held
        return ut
    }
    armC: memberC :ast :reg :typing :ctx owner: tid kind: memberkind.arm nameId: arm
    vt: stating :facts from: (memberFacts b: recvF) text: "\{recv}\{acc}data.\{armC}"
    holdForAlias :ctx val: vt.stringView :held
    return vt
}

# A union arm's payload lives in a heap cell that the union's `data` slot
# points at -- or, for an INLINE arm (a bare value-type payload that fits the
# slot, checkUnionArmSlots), in the slot itself, as the arm's own member of the
# union that overlays `data`. The functions below are the one place that spells
# either: every read, store and free of a union payload goes through them. `pc`
# is the payload's C type as the arm stores it (armPayloadC), `slot` the C
# expression of the slot (armSlotC) and `inline` whether the arm is inline.

# armIsInlineC -- arm `arm` of union `tid` keeps its payload in the slot.
armIsInlineC: function {
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    arm: zast.nameid
} out bool is {
    if arm.isZero then return false
    return (typing.armIsInline parentTypeId: tid nameId: arm)
}

# armSlotC -- the slot arm `arm` of union `tid` keeps its payload in, reached
# from `recv` with `acc`: the union's `data`, or the inline arm's member.
armSlotC: function {
    # the arm names
    ast: Ast.view
    # the checked program
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the emission context the inline member is spelled through
    ctx: Ctx
    # the union
    tid: ztypes.tid
    # the C expression of the union value
    recv: StringView
    # `.` or `->`, as recv is a value or a pointer
    acc: StringView
    # the arm's name
    arm: zast.nameid
    # whether the arm keeps its payload in the slot itself
    inline: bool
} out String is {
    if inline then {
        im: memberC :ast :reg :typing :ctx owner: tid kind: memberkind.inlineArm nameId: arm
        return "\{recv}\{acc}\{im}"
    }
    return "\{recv}\{acc}data"
}

# armCellRef -- the payload as a parenthesised lvalue; an inline arm's is the
# member access itself, unparenthesised: it binds tighter than any operator
# around it, and the emitter's lvalue test reads it as the place it is.
armCellRef: function {pc: StringView slot: StringView inline: false} out String is {
    if inline then return slot.string
    p: armCellPtr :pc :slot
    return "(*\{p})"
}

# armCellDeref -- the payload as an initializer's whole right-hand side.
armCellDeref: function {pc: StringView slot: StringView inline: false} out String is {
    if inline then return slot.string
    p: armCellPtr :pc :slot
    return "*\{p}"
}

# armCellPtr -- the payload's address.
armCellPtr: function {pc: StringView slot: StringView inline: false} out String is {
    if inline then return "&\{slot}"
    return "(\{pc}*)\{slot}"
}

# armCellAlloc -- declare `box`, a fresh cell for a payload.
armCellAlloc: function {ctx: Ctx pc: StringView box: StringView} out String is {
    preludeNeed :ctx memb: "@xmalloc"
    return "\{pc}* \{box} = (\{pc}*)z_xmalloc(sizeof(\{pc}));"
}

# armCellFill -- copy `value` into the cell `box`.
armCellFill: function {box: StringView value: StringView} out String is {
    return "*\{box} = \{value};"
}

# armCellAttach -- point the slot at the cell `box`.
armCellAttach: function {slot: StringView box: StringView} out String is {
    return "\{slot} = \{box};"
}

# armCellStore -- a payload stored into the slot, as one run of statements:
# the cell `box` allocated, filled with `value`, and attached; an inline arm's
# payload is the slot's own store.
armCellStore: function {
    ctx: Ctx
    pc: StringView
    box: StringView
    value: StringView
    slot: StringView
    inline: false
} out String is {
    if inline then return "\{slot} = \{value};"
    al: armCellAlloc :ctx :pc :box
    fl: armCellFill :box :value
    at: armCellAttach :slot :box
    return "\{al} \{fl} \{at}"
}

# armCellNew -- a new cell holding `value`, as an expression: the value is
# copied out of a one-element array literal, which is how C takes the
# address of any value, a call's result included.
armCellNew: function {ctx: Ctx pc: StringView value: StringView} out String is {
    preludeNeed :ctx memb: "@xmemdup"
    return "z_xmemdup((\{pc}[1]){ \{value} }, sizeof(\{pc}))"
}

# armCellFree -- free the cell the slot points at, its payload already
# destroyed or moved out.
armCellFree: function {slot: StringView} out String is {
    return "free(\{slot});"
}

# armCellAbsent -- the condition that the slot holds no cell: a null arm, or
# a union whose payload was moved out.
armCellAbsent: function {slot: StringView} out String is {
    return "!\{slot}"
}

# armMemberTid -- the payload type `arm` names on sum type `owner`, 0 when the
# arm is not a member of it.
armMemberTid: function {
    typing: ztyping.ZTyping.view
    owner: ztypes.tid
    arm: zast.nameid
} out ztypes.tid is {
    pt: (
        (typing.declChildOfId parentTypeId: owner nameId: arm).or
        d: ztypes.tid.zero
    )
    return pt
}

# remainingArm -- the single arm of `tid` left after removing the
# ambient exclusions recorded for variable `subjVid` (ctx.exclArms) plus the
# `extra` space-joined arms; "" when zero or more than one remain.
remainingArm: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    subjVid: ztypes.vid
    tid: ztypes.tid
    extra: zast.nameid
} out zast.nameid is {
    exv: vaGet xs: ctx.exclArms vid: subjVid
    all: ListVal zast.nameid
    zenv.sumArmNameIds ty: typing :reg :tid ids: all
    remN: u64
    rem: zast.nameid
    for each a: all loop {
        if a != extra when (idListHas xs: exv id: a).not then {
            remN = remN + 1
            rem = a
        }
    }
    if remN != 1 then return zast.nameid
    return rem
}

# bodyReassigns -- true when `n` rebinds the bare name `name` anywhere in it,
# by a reassignment or a swap, which would stale a narrowBox alias for it. The
# whole subtree counts: a rebind in a binding's value, a condition or a call's
# argument writes the variable as surely as one in a statement. A write
# THROUGH the name (`s.field = x`) goes through the alias and leaves it standing.
bodyReassigns: function {ast: Ast.view n: astnode.view name: StringView} out bool is {
    match (
        n
    ) case reassignment then {
        if (atomTextOf :ast n: (ast.nodes.get i: n.topath)) == name then return true
    } case swapstmt then {
        sl: atomTextOf :ast n: (ast.nodes.get i: n.lhs)
        sr: atomTextOf :ast n: (ast.nodes.get i: n.rhs)
        if (sl == name) or (sr == name) then return true
    } else null
    nk: zast.childCount :ast :n
    i: u64
    for i < nk loop {
        k: zast.childAt :ast :n :i
        i = i + 1
        if (bodyReassigns :ast n: (ast.nodes.get i: k) :name) then return true
    }
    return false
}

# seedFromPredicate -- one POSITIVE bare arm predicate dotted node: admit a
# non-bool receiver variable whose arm carries a payload and whose
# subject the body does not reassign; append its narrowBox seed
# (subject, alias text, payload tid). The condition-form dispatch
# (trailing .true/.false, == true/false) lives in seedCondOp.
seedFromPredicate: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    valFs: ListVal cfacts
    tids: ListVal ztypes.tid
} is {
    match (
        n
    ) case dottedpath then {
        armId: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        armTid: dottedArmPredicateTid :typing nid: n.nodeid
        (
            seedPositiveCore
            :ast
            :reg
            :typing
            :ctx
            tid: armTid
            parent: (ast.nodes.get i: n.parent)
            childName: armId
            :names
            :svids
            :vals
            :valFs
            :tids
        )
    } else null
}

# seedPositiveCore -- the positive-seed core: the subject named by `parent` is
# known to hold `childName` of `tid`.
seedPositiveCore: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    parent: astnode.view
    childName: zast.nameid
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    valFs: ListVal cfacts
    tids: ListVal ztypes.tid
} is {
    if tid.isZero then return
    if (isOrdinalVariant :typing :tid) then return
    subj: atomTextOf :ast n: parent
    if subj.length == 0 then return
    recvF: cfacts
    recvText: emitExprWith :ast :reg :typing :ctx n: parent facts: recvF
    accessOp: ".".string
    if (
        isPtrVid
        :ctx
        vid: (atomVid :typing nid: (atomNodeId n: parent))
    ) then accessOp = "->".string
    aliasF: cfacts
    aliasText: (
        armAliasText
        :ast
        :reg
        :typing
        :ctx
        :tid
        arm: childName
        recv: recvText.stringView
        :recvF
        acc: accessOp.stringView
        facts: aliasF
    )
    if aliasText.length == 0 then return
    names.append subj.string
    svids.append (atomVid :typing nid: (atomNodeId n: parent))
    vals.append aliasText
    valFs.append aliasF
    pt: (
        (typing.declChildOfId parentTypeId: tid nameId: childName).or
        d: ztypes.tid.zero
    )
    tids.append pt
}

# seedNegatedFromPredicate -- a NEGATED bare arm predicate: the branch knows the
# subject does NOT hold `arm`. When exactly one payload arm remains, seed
# its alias (exclusion collapse, mirroring the checker).
seedNegatedFromPredicate: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    valFs: ListVal cfacts
    tids: ListVal ztypes.tid
} is {
    match (
        n
    ) case dottedpath then {
        dap: dottedArmPredicateTid :typing nid: n.nodeid
        if dap.isZero then return
        if (isOrdinalVariant :typing tid: dap) then return
        subj: atomTextOf :ast n: (ast.nodes.get i: n.parent)
        if subj.length == 0 then return
        snv: atomVid :typing nid: (atomNodeId n: (ast.nodes.get i: n.parent))
        ctorArmName: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        rem: remainingArm :reg :typing :ctx subjVid: snv tid: dap extra: ctorArmName
        if rem.isZero then return
        recvF: cfacts
        recvText: emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: n.parent) facts: recvF
        accessOp: ".".string
        if (isPtrVid :ctx vid: snv) then accessOp = "->".string
        aliasF: cfacts
        aliasText: (
            armAliasText
            :ast
            :reg
            :typing
            :ctx
            tid: dap
            arm: rem
            recv: recvText.stringView
            :recvF
            acc: accessOp.stringView
            facts: aliasF
        )
        if aliasText.length == 0 then return
        names.append subj.string
        svids.append snv
        vals.append aliasText
        valFs.append aliasF
        pt: (
            (typing.declChildOfId parentTypeId: dap nameId: rem).or
            d: ztypes.tid.zero
        )
        tids.append pt
    } else null
}

# armSideAtNode -- which arm of ITS OWN stamped type the name `nameId` is, for
# the value at node `nid`. `true` and `false` are arms of bool, so a `== true`
# operand answers `truthy` and a `== false` one `falsy` -- from bool's arm
# ORDER, which is the whole content of the spelling test. Asking the node's own
# stamp rather than looking `bool` up by name costs nothing and is exact under
# a user type that shadows bool.
armSideAtNode: function {
    typing: ztyping.ZTyping.view
    nid: zast.nodeid
    nameId: zast.nameid
} out ztyping.armside is {
    if nameId.isZero then return ztyping.armside.none
    st: stampIdOf :typing :nid
    return (ztyping.armSideOfName ty: typing typeId: st :nameId)
}

# boolArmSideOf -- armSideAtNode for a bare atom operand.
boolArmSideOf: function {
    typing: ztyping.ZTyping.view
    n: astnode.view
} out ztyping.armside is {
    match (
        n
    ) case atomid then {
        return (armSideAtNode :typing nid: n.nodeid nameId: n.name)
    } else {
        return ztyping.armside.none
    }
}

# truthyCondText -- the C for a condition whose type is a 2-arm sum rather
# than a bool: it holds when the value holds the arm the checker stamped. ""
# when the condition needs no wrapping at all -- a bool, and every other
# ordinal PAIR, already IS its discriminator in C, so the emitted expression is
# the answer.
#
# The arm comes off the stamp rather than a lookup here: a generic mono keeps
# its arm record on the template it was minted from.
truthyCondText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    raw: StringView
} out String is {
    fa: (typing.truthyCondArm.get key: (interpPartNodeId :n)).or d: zast.nameid
    if fa.isZero then return "".string
    tid: stampIdOf :typing nid: (interpPartNodeId :n)
    if tid.isZero then return "".string
    if (isOrdinalPair :typing :tid) then return "".string
    tg: spelledTagConst :ast :ctx :reg :typing :tid armId: fa
    if tg.length == 0 then return "".string
    accessOp: ".".string
    rn: atomNodeId :n
    if rn.notZero when (isPtrVid :ctx vid: (atomVid :typing nid: rn)) then accessOp = "->".string
    return "((\{raw})\{accessOp}tag == \{tg})"
}

# seed a condition's operator so the branch emit can read it without re-
# resolving
# seedEqualityCond -- `== true` / `== false` seeds exactly what the ARM it
# names seeds, and answers whether it did. The comparison is an infix call, so
# its operands are read through the one seam that knows that layout; which side
# is which comes from bool's arm ORDER, never from the spelling of the operand.
seedEqualityCond: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    valFs: ListVal cfacts
    tids: ListVal ztypes.tid
} out bool is {
    ipS: zast.infixPartsOf :ast :n
    if ipS.found.not then return false
    # the operator node is read ONCE: as a repeated subexpression it is emitted
    # per use, and the hoisted temporaries the uses it loses leave behind are a
    # warn-check failure
    opNS: ast.nodes.get i: ipS.operator
    if (zast.atomNameIdOf n: opNS) != zast.wellKnown.slot.wkOpEq then return false
    lsdS: boolArmSideOf :typing n: (ast.nodes.get i: ipS.lhs)
    rsdS: boolArmSideOf :typing n: (ast.nodes.get i: ipS.rhs)
    if rsdS.truthy then {
        blS: ast.nodes.get i: ipS.lhs
        seedFromPredicate :ast :reg :typing :ctx n: blS :names :svids :vals :valFs :tids
        return true
    }
    if rsdS.falsy then {
        lnS: ast.nodes.get i: ipS.lhs
        seedNegatedFromPredicate :ast :reg :typing :ctx n: lnS :names :svids :vals :valFs :tids
        return true
    }
    if lsdS.truthy then {
        brS: ast.nodes.get i: ipS.rhs
        seedFromPredicate :ast :reg :typing :ctx n: brS :names :svids :vals :valFs :tids
        return true
    }
    if lsdS.falsy then {
        rnS: ast.nodes.get i: ipS.rhs
        seedNegatedFromPredicate :ast :reg :typing :ctx n: rnS :names :svids :vals :valFs :tids
        return true
    }
    return false
}

# seed a condition's operator so the branch emit can read it without re-
# resolving
seedCondOp: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    valFs: ListVal cfacts
    tids: ListVal ztypes.tid
} is {
    # a bare 2-arm sum condition IS `x.<arm>` with the arm left implicit, so
    # it seeds the alias that form seeds.
    {
        ta0: ztypecheck.truthyCondArmOf :typing nid: (interpPartNodeId :n)
        if ta0.notZero then {
            condTid: stampIdOf :typing nid: (interpPartNodeId :n)
            (
                seedPositiveCore
                :ast
                :reg
                :typing
                :ctx
                tid: condTid
                parent: n
                childName: ta0
                :names
                :svids
                :vals
                :valFs
                :tids
            )
            return
        }
    }
    if (seedEqualityCond :ast :reg :typing :ctx :n :names :svids :vals :valFs :tids) then return
    match (
        n
    ) case dottedpath then {
        cn: aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child
        # `.true` / `.false` on a predicate: which side it is comes from the
        # stamped type's arm ORDER, never from the spelling of the segment.
        sd: (
            ztypecheck.armSuffixSide
            :ast
            :typing
            nid: n.nodeid
            parent: (ast.nodes.get i: n.parent)
            child: (ast.nodes.get i: n.child)
        )
        if sd.truthy then {
            dpp: ast.nodes.get i: n.parent
            seedFromPredicate :ast :reg :typing :ctx n: dpp :names :svids :vals :valFs :tids
            return
        }
        if sd.falsy then {
            dpq: ast.nodes.get i: n.parent
            seedNegatedFromPredicate :ast :reg :typing :ctx n: dpq :names :svids :vals :valFs :tids
            return
        }
        armTid: dottedArmPredicateTid :typing nid: n.nodeid
        (
            seedPositiveCore
            :ast
            :reg
            :typing
            :ctx
            tid: armTid
            parent: (ast.nodes.get i: n.parent)
            childName: cn
            :names
            :svids
            :vals
            :valFs
            :tids
        )
    } else null
}

# seedCondOne -- the narrowBox seeds one condition contributes, appended to the
# parallel lists. Seeding a conjunct as it is emitted is what lets the conjunct
# after it read the payload this one narrowed.
seedCondOne: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    condId: zast.nodeid
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    valFs: ListVal cfacts
    tids: ListVal ztypes.tid
} is {
    k: ast.nodes.get i: condId
    if k.namedoperation then {
        (
            seedCondOp
            :ast
            :reg
            :typing
            :ctx
            n: (ast.nodes.get i: k.operation)
            :names
            :svids
            :vals
            :valFs
            :tids
        )
    }
}

# seedAndLayerCond -- everything one conjunct owes the conjuncts after it and
# the clause body: the alias for what it narrowed, and the exclusion for what it
# ruled out. Both are installed before the next conjunct renders, because `when`
# short-circuits and a later conjunct is reached only where this one held.
seedAndLayerCond: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    condId: zast.nodeid
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    valFs: ListVal cfacts
    tids: ListVal ztypes.tid
    prevV: List String
    prevF: ListVal cfacts
    prevT: ListVal ztypes.tid
} is {
    had: svids.length
    seedCondOne :ast :reg :typing :ctx :condId :names :svids :vals :valFs :tids
    installNarrowSeeds :ctx :svids :vals :valFs :tids :prevV :prevF :prevT from: had
    layerCondExclusion :ast :typing :ctx :condId
}

# layerCondExclusion -- record that a conjunct's NEGATED arm predicate excludes
# its arm, for everything after it: the conjuncts that follow and the clause
# body. `remainingArm` reads ctx.exclArms, so two exclusions that leave one arm
# collapse the subject to that arm's payload -- the rule the checker applies,
# on both sides of the clause.
#
# Classification is the chain facts' own, so this cannot disagree with them, and
# it allocates nothing at all unless the conjunct really does exclude an arm.
layerCondExclusion: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    condId: zast.nodeid
} is {
    k: ast.nodes.get i: condId
    if k.namedoperation.not then return
    f: classifyCondFact :ast :typing n: (ast.nodes.get i: k.operation)
    if f.ok.not then return
    if f.neg.not then return
    pushExclusion :ctx vid: f.svid arm: f.armRef owner: f.owner
}

# pushExclusion -- add `arm` to the arms already excluded for `vid`, saving what
# the exclusion tables held on ctx's stack so restoreCondExclusions can put it
# back. The arms accumulate space-joined, which is how remainingArm reads them.
pushExclusion: function {
    ctx: Ctx
    vid: ztypes.vid
    arm: zast.nameid
    owner: ztypes.tid
} is {
    pv0: vaGet xs: ctx.exclArms :vid
    nx: pv0.copy
    nx.append arm
    ctx.exSaves.append (
        ExclSave
        :vid
        arms: pv0
        owner: ((vtGet xs: ctx.exclTids :vid).or d: ztypes.tid.zero)
    )
    vaSet xs: ctx.exclArms :vid arms: nx
    vtSet xs: ctx.exclTids :vid tid: owner
}

# restoreCondExclusions -- put back what each vid this clause layered held
# before it, newest first, and drop those entries so the enclosing clause's mark
# still points where it did.
restoreCondExclusions: function {ctx: Ctx mark: u64} is {
    for ctx.exSaves.length > mark loop {
        sv: ctx.exSaves.pop
        if sv.arms.length > 0 then {
            vaSet xs: ctx.exclArms vid: sv.vid arms: sv.arms
        } else {
            vidRemove xs: ctx.exclArms vid: sv.vid
        }
        if sv.owner.notZero then {
            vtSet xs: ctx.exclTids vid: sv.vid tid: sv.owner
        } else {
            vidRemove xs: ctx.exclTids vid: sv.vid
        }
    }
}

# installNarrowSeeds -- install the aliases at index `from` and after, recording
# what each vid held so the clause can put it back. The saved value is the one
# in place BEFORE this clause touched it, so installing in stages still
# restores in one pass.
installNarrowSeeds: function {
    ctx: Ctx
    svids: (ListVal ztypes.vid).view
    vals: (List String).view
    valFs: (ListVal cfacts).view
    tids: (ListVal ztypes.tid).view
    prevV: List String
    prevF: ListVal cfacts
    prevT: ListVal ztypes.tid
    from: u64
} is {
    si: from
    for si < svids.length loop {
        svv: vals.get i: si
        stt: tids.get i: si
        (
            pushNarrow
            :ctx
            vid: (svids.get i: si)
            val: svv.stringView
            valF: (valFs.get i: si)
            tid: stt
            :prevV
            :prevF
            :prevT
        )
        si = si + 1
    }
}

# ifPredicateSeeds -- collect the narrowBox seeds for a clause's bare
# arm-predicate conjuncts, all condition forms (parallel lists).
ifPredicateSeeds: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    conds: zast.kidspan
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    valFs: ListVal cfacts
    tids: ListVal ztypes.tid
} is {
    for each condId: (zast.kidsOf :ast span: conds) loop {
        k: ast.nodes.get i: condId
        if k.namedoperation then {
            (
                seedCondOp
                :ast
                :reg
                :typing
                :ctx
                n: (ast.nodes.get i: k.operation)
                :names
                :svids
                :vals
                :valFs
                :tids
            )
        }
    }
}

# chainFactsOfClauses -- the accumulated single-bare-conjunct facts of an
# if chain (subject/arm/tid/negated parallel lists), by the checker's
# accumulation rule exactly.
chainFactsOfClauses: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    clauses: zast.kidspan
    subjects: List String
    svids: ListVal ztypes.vid
    arms: ListVal zast.nameid
    tids: ListVal ztypes.tid
    negs: ListVal bool
    recvs: List String
    recvFs: ListVal cfacts
} is {
    for each clauseId: (zast.kidsOf :ast span: clauses) loop {
        c: ast.nodes.get i: clauseId
        # a clause of ONE condition: the fact it records, if any, is the
        # clause's
        if c.ifclause when c.conditions.count.u64 == 1 then {
            k: ast.nodes.get i: (zast.kidAt kids: ast.kids span: c.conditions i: 0)
            if k.namedoperation then (
                chainCondFact
                :ast
                :reg
                :typing
                :ctx
                n: (ast.nodes.get i: k.operation)
                :subjects
                :svids
                :arms
                :tids
                :negs
                :recvs
                :recvFs
            )
        }
    }
}

# condarmfact -- one condition's arm-predicate classification, carrying no built
# text: which sum type the subject has, which node it is, which arm the
# predicate names, and whether the predicate is the falsy side. `ok` is false
# when the condition is not an arm predicate at all.
#
# Classification is split from recording so the two callers cannot drift: the
# else emission classifies and then builds its strings, while the exclusion
# layering classifies and stops. A separate probe that mirrored these legs could
# silently disagree, and a missed exclusion puts invalid C back.
condarmfact: record {
    ok: bool
    owner: ztypes.tid
    parentNid: zast.nodeid
    svid: ztypes.vid
    armRef: zast.nameid
    neg: bool
}

# noArmFact -- the "not an arm predicate" answer.
noArmFact: function out condarmfact is {
    return (
        condarmfact
        ok: false
        owner: ztypes.tid.zero
        parentNid: zast.nodeid
        svid: ztypes.vid.zero
        armRef: zast.nameid.zero
        neg: false
    )
}

# classifyFactCore -- the guards every arm-predicate fact must pass, answered
# without allocating: a real sum owner, not an ordinal variant, and a subject
# that is a bare atom.
classifyFactCore: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    owner: ztypes.tid
    parentNid: zast.nodeid
    armRef: zast.nameid
    neg: bool
} out condarmfact is {
    noFact: noArmFact
    if owner.isZero then return noFact
    if (isOrdinalVariant :typing tid: owner) then return noFact
    parent: ast.nodes.get i: parentNid
    subj: atomTextOf :ast n: parent
    if subj.length == 0 then return noFact
    return (
        condarmfact
        ok: true
        :owner
        :parentNid
        svid: (atomVid :typing nid: (atomNodeId n: parent))
        :armRef
        :neg
    )
}

# classifyInnerFact -- the stamped bare-predicate core, as a classification.
classifyInnerFact: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    n: astnode.view
    neg: bool
} out condarmfact is {
    match (
        n
    ) case dottedpath then {
        return (
            classifyFactCore
            :ast
            :typing
            owner: (dottedArmPredicateTid :typing nid: n.nodeid)
            parentNid: n.parent
            armRef: (aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child)
            :neg
        )
    } else {
        noFact: noArmFact
        return noFact
    }
}

# eqcondfact -- classifyEqualityCond's answer: whether the condition WAS an
# equality against a bool arm, and the fact it classifies to if so.
eqcondfact: record {
    # true when the condition is `== true` / `== false` and `fact` is its answer
    handled: bool
    # the arm fact, which may itself be `ok: false` when the operand names none
    fact: condarmfact
}

# classifyEqualityCond -- `== true` / `== false` classifies as the ARM it names.
# The comparison is an infix call, so its operands are read through the one seam
# that knows that layout; which side is which comes from bool's arm ORDER.
classifyEqualityCond: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out eqcondfact is {
    miss: eqcondfact handled: false fact: noArmFact
    ipC: zast.infixPartsOf :ast :n
    if ipC.found.not then return miss
    # read ONCE, as in seedEqualityCond
    opNC: ast.nodes.get i: ipC.operator
    if (zast.atomNameIdOf n: opNC) != zast.wellKnown.slot.wkOpEq then return miss
    lsdC: boolArmSideOf :typing n: (ast.nodes.get i: ipC.lhs)
    rsdC: boolArmSideOf :typing n: (ast.nodes.get i: ipC.rhs)
    if rsdC.truthy then return (
        eqcondfact
        handled: true
        fact: (classifyInnerFact :ast :typing n: (ast.nodes.get i: ipC.lhs) neg: false)
    )
    if rsdC.falsy then return (
        eqcondfact
        handled: true
        fact: (classifyInnerFact :ast :typing n: (ast.nodes.get i: ipC.lhs) neg: true)
    )
    if lsdC.truthy then return (
        eqcondfact
        handled: true
        fact: (classifyInnerFact :ast :typing n: (ast.nodes.get i: ipC.rhs) neg: false)
    )
    if lsdC.falsy then return (
        eqcondfact
        handled: true
        fact: (classifyInnerFact :ast :typing n: (ast.nodes.get i: ipC.rhs) neg: true)
    )
    return (eqcondfact handled: true fact: noArmFact)
}

# classifyCondFact -- one condition operation as an arm predicate, by the same
# legs the chain facts have always used: the bare stamped form, a `.true` /
# `.false` suffix whose side comes from the arm ORDER, and `== true` / `== false`
# against bool. Answers without building any text.
classifyCondFact: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out condarmfact is {
    noFact: noArmFact
    {
        ta1: ztypecheck.truthyCondArmOf :typing nid: (interpPartNodeId :n)
        if ta1.notZero then {
            return (
                classifyFactCore
                :ast
                :typing
                owner: (stampIdOf :typing nid: (interpPartNodeId :n))
                # the subject here is `n` itself. classifyFactCore answers ok
                # only when that node is an atomid (atomTextOf names nothing
                # else), and interpPartNodeId of an atomid IS its own id, so
                # carrying the id is exactly carrying the node.
                parentNid: (interpPartNodeId :n)
                armRef: ta1
                neg: false
            )
        }
    }
    eqC: classifyEqualityCond :ast :typing :n
    if eqC.handled then return eqC.fact
    match (
        n
    ) case dottedpath then {
        sd: (
            ztypecheck.armSuffixSide
            :ast
            :typing
            nid: n.nodeid
            parent: (ast.nodes.get i: n.parent)
            child: (ast.nodes.get i: n.child)
        )
        if sd.truthy then {
            return (classifyInnerFact :ast :typing n: (ast.nodes.get i: n.parent) neg: false)
        }
        if sd.falsy then {
            return (classifyInnerFact :ast :typing n: (ast.nodes.get i: n.parent) neg: true)
        }
        return (
            classifyFactCore
            :ast
            :typing
            owner: (dottedArmPredicateTid :typing nid: n.nodeid)
            parentNid: n.parent
            armRef: (aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child)
            neg: false
        )
    } else {
        return noFact
    }
}

# chainCondFact -- one condition operation as a bare arm predicate, recorded
# into the parallel chain-fact lists. Classification is classifyCondFact's; this
# adds only the text the else emission reuses rather than re-deriving -- the
# subject spelling and the emitted receiver.
chainCondFact: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    subjects: List String
    svids: ListVal ztypes.vid
    arms: ListVal zast.nameid
    tids: ListVal ztypes.tid
    negs: ListVal bool
    recvs: List String
    recvFs: ListVal cfacts
} is {
    f: classifyCondFact :ast :typing :n
    if f.ok.not then return
    parent: ast.nodes.get i: f.parentNid
    subj: atomTextOf :ast n: parent
    rvF: cfacts
    rv: emitExprWith :ast :reg :typing :ctx n: parent facts: rvF
    subjects.append subj.string
    svids.append f.svid
    arms.append f.armRef
    tids.append f.owner
    negs.append f.neg
    recvs.append rv
    recvFs.append rvF
}

# wrappedInOneParen -- whether the text is one parenthesised group: it opens
# with `(` and that paren closes only at the very end.
wrappedInOneParen: function {cond: StringView} out bool is {
    n: cond.length
    if ((cond.byteAt 0.u64).or d: 0) != 40 then return false
    depth: u64
    i: u64
    for i < n loop {
        bo: (cond.byteAt i).or d: 0
        if bo == 40 then depth = depth + 1
        if bo == 41 then {
            depth = depth - 1
            if depth == 0 when i < (n - 1) then return false
        }
        i = i + 1
    }
    return depth == 0
}

# emit one clause of an if-expression.
# condInParens -- a C `if`/`while` condition, wrapped in parens exactly once.
# An emitted expression is usually already fully parenthesized (`(a == b)`);
# wrapping it again makes clang warn (-Wparentheses-equality). A condition
# containing a string literal keeps the extra wrap rather than depth-counting
# through quoted parens. A STATEMENT EXPRESSION (`({ ... })`, what the result
# and option combinators lower to) opens with a paren the `if (` would swallow,
# leaving a block where C wants an expression, so it always takes the wrap.
condInParens: function {cond: StringView} out String is {
    n: cond.length
    isStmtExpr: cond.startsWith "({"
    if n >= 2 when (cond.contains "\"").not when isStmtExpr.not when (wrappedInOneParen :cond
    ) then {
        return cond.string
    }
    return "(\{cond})"
}

# appendCondText -- render one condition into the `&&` chain being built. An
# `if` or `while` condition arrives as a labelled operation; a do-while
# postcondition is the bare expression.
appendCondText: function {
    # the tree this one condition is read from
    ast: Ast.view
    # the stamps this condition's truthiness is judged against
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the emit context the condition text is built in
    ctx: Ctx
    # the condition's node id
    kId: zast.nodeid
    # the chain so far; a `&&` is inserted when it is not empty
    cond: String.borrow
} is {
    k: ast.nodes.get i: kId
    opId: kId
    if k.namedoperation then opId = k.operation
    # a conjunct past the first runs only when the ones before it held
    guarded: cond.length > 0
    mk: openInPlace :ctx :guarded
    {
        cvF: cfacts
        cv: valueExprC :ast :reg :typing :ctx n: (ast.nodes.get i: opId) facts: cvF
        tw: truthyCondText :ast :reg :typing :ctx n: (ast.nodes.get i: opId) raw: cv.stringView
        if tw.length > 0 then cv = tw.take
        if guarded then {
            cond.append " && "
            appendInPlaceCond :ctx mark: mk text: cv.stringView dst: cond
        } else {
            closeInPlace :ctx mark: mk
            cond.append cv
        }
    }
}

# whenCondSuspends -- a `when` condition of this clause holds a suspension.
#
# The FIRST condition is not asked about: it runs unconditionally, so the
# ordinary statement-level hoist already reaches it. Every condition after it
# is guarded by the ones before -- `when` short-circuits -- so its suspension
# cannot be lifted above the `if` without running on a path never taken.
whenCondSuspends: function {ast: Ast.view ctx: Ctx.view n: zast.ifclauserow} out bool is {
    if ctx.genActive.not then return false
    wi: 1.u64
    for wi < n.conditions.count loop {
        cwi: zast.kidAt kids: ast.kids span: n.conditions i: wi
        wi = wi + 1
        if (zast.yieldCountIn :ast nid: cwi) > 0 then return true
    }
    return false
}

# condMovesLocal -- one of these conditions holds a call that moves an owned
# local. The zeroing a move owes is a statement, and it may run only on the
# path where the call ran, so the header cannot carry the condition. The
# answer is the invalidation walker's own: whatever it would write for these
# nodes, written into a probe instead of the body.
condMovesLocal: function {
    # the tree the conditions are read from
    ast: Ast.view
    # the stamps the walker decides "moved" from
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the emit context the walker names sources through
    ctx: Ctx
    # the clause's condition nodes
    conds: zast.kidspan
} out bool is {
    probe: String
    for each cId: (zast.kidsOf :ast span: conds) loop {
        condNode: ast.nodes.get i: cId
        emitValueTakeInvalidations :ast :reg :typing :ctx n: condNode ind: "" buf: probe
    }
    return probe.length > 0
}

# condsNeedSteps -- these conditions cannot stay in their header: one
# suspends, one moves an owned local, or one holds a control value that runs
# as statements. Each of those has to land on a statement, so they are written
# as statements first and the header tests the guard they leave.
condsNeedSteps: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # a condition holds a suspension, as the clause's or loop's own query says
    suspends: bool
    # the condition nodes
    conds: zast.kidspan
} out bool is {
    if suspends then return true
    if (condHoldsControlValue :ast :ctx :conds) then return true
    return (condMovesLocal :ast :reg :typing :ctx :conds)
}

# condHoldsControlValue -- one of these conditions holds an `if`, a `match` or a
# `with` used as a value that runs as statements ahead of its statement
# (emitControlExpr). A ternary-shaped `if` stays an expression and is looked
# through.
condHoldsControlValue: function {ast: Ast.view ctx: Ctx conds: zast.kidspan} out bool is {
    for ctx.condScan.length > 0 loop ctx.condScan.pop
    ci: u64
    for ci < conds.count loop {
        ctx.condScan.append (zast.kidAt kids: ast.kids span: conds i: ci)
        ci = ci + 1
    }
    wi: u64
    for wi < ctx.condScan.length loop {
        wid: ctx.condScan.get i: wi
        wi = wi + 1
        if wid.notZero then {
            wn: ast.nodes.get i: wid
            if (isControlValueNode :ast nid: wid) then return true
            if wn.functiondef.not then zast.childIdsInto :ast n: wn acc: ctx.condScan
        }
    }
    return false
}

# isControlValueNode -- a `match`, a `with`, or an `if` that is not
# ternary-shaped: what emitControlExpr builds when it is used as a value.
isControlValueNode: function {ast: Ast.view nid: zast.nodeid} out bool is {
    n: ast.nodes.get i: nid
    if n.caseexpr or n.withexpr then return true
    if n.ifexpr.not then return false
    return (ifIsTernary :ast n: (ast.nodes.get i: nid)).not
}

# emitSteppedConjunct -- one condition of a stepped clause: its text computed
# into the guard, then the zeroing its moves owe. A later conjunct's line sits
# inside the nesting the caller opened. A `_ah` temp the text needed is
# declared just before the line and freed just after it -- the callee borrowed
# it for the call alone.
emitSteppedConjunct: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the condition node, a labelled operation
    kId: zast.nodeid
    # the guard's C name, declared by the caller
    gvar: StringView
    # the indent of this conjunct's nesting level
    ind: StringView
    # the free list a hoisted temp is registered on and released from
    tmp: TmpCtr
    # the statements append here
    buf: String.borrow
} is {
    ct: String
    appendCondText :ast :reg :typing :ctx :kId cond: ct
    if ct.length == 0 then ct.append "1"
    lL: tmp.listFrees.length
    flushArgHoists :ctx :ind :tmp :buf
    cw: condInParens cond: ct.stringView
    buf.append "\{ind}\{gvar} = \{cw} ? 1 : 0;\n"
    flushBlockFrees :tmp :lL diverged: false :buf
    condNode: ast.nodes.get i: kId
    emitValueTakeInvalidations :ast :reg :typing :ctx n: condNode :ind :buf
}

# closeSteppedNesting -- the closing braces of a stepped clause's conditions,
# one per condition after the first, innermost first.
closeSteppedNesting: function {
    # how many levels were opened
    depth: u64
    # the indent of the outermost level
    ind: StringView
    # the braces append here
    buf: String.borrow
} is {
    lvl: depth
    for lvl > 0 loop {
        lvl = lvl - 1
        indC: ind.string
        pi: u64
        for pi < lvl loop {
            indC.append "    "
            pi = pi + 1
        }
        buf.append "\{indC}}\n"
    }
}

# newCondGuard -- declare the guard a stepped condition computes into, and
# answer its name. It starts at 1: a loop whose every condition is an
# initialiser has no test left to compute, and loops unconditionally.
newCondGuard: function {
    # carries the guard counter
    ctx: Ctx
    # the indent the declaration is written at
    ind: StringView
    # the declaration appends here
    buf: String.borrow
} out String is {
    gnum: ctx.whenGuardCtr
    ctx.whenGuardCtr = gnum + 1
    gvar: "_wc\{gnum}"
    buf.append "\{ind}uint8_t \{gvar} = 1;\n"
    return gvar
}

# forCondIsNamed -- a `for` condition that binds a name (`i: 0`) is an
# initialiser, not a test.
forCondIsNamed: function {ast: Ast.view kId: zast.nodeid} out bool is {
    k: ast.nodes.get i: kId
    if k.namedoperation.not then return false
    lbl: zast.nameTextAt :ast ref: k.name
    return lbl.length > 0
}

# hoistCondYields -- a condition's suspensions, lifted to statements at the
# level the condition is computed at. Nothing outside a generator.
hoistCondYields: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the condition node
    kId: zast.nodeid
    # the indent of the condition's nesting level
    ind: StringView
    # the hoisted statements append here
    buf: String.borrow
} is {
    if ctx.genActive.not then return
    hoistExprYields :ast :reg :typing :ctx nid: kId :ind :buf
}

# emitSteppedCond -- conditions as statements computing into a declared guard.
# Each condition after the first runs inside the `if (g)` of the ones before
# it -- C's own short-circuit written out -- so a suspension lands on a
# statement, and a move's zeroing follows the call on exactly the path where
# it ran:
#
#     _wc0 = (a) ? 1 : 0;
#     <a's moves zeroed>
#     if (_wc0) {
#         <b's suspensions>
#         _wc0 = (b) ? 1 : 0;
#         <b's moves zeroed>
#     }
#
# An `if` clause's first condition runs unconditionally and once, so the
# statement-level hoist already carried its suspensions; a loop's runs once
# per iteration, so it is hoisted here like the rest. A loop's named
# conditions are initialisers the loop head declared before it, and are
# skipped.
emitSteppedCond: function {
    # the tree the conditions are read from
    ast: Ast.view
    # read for the resume type of each suspension
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # carries the resume slots
    ctx: Ctx
    # the condition nodes
    conds: zast.kidspan
    # the guard's C name, already declared where the header can test it
    gvar: StringView
    # the conditions are a loop's test
    inLoop: bool
    # the indent the first condition is written at
    ind: StringView
    # the free list the conjuncts' temps ride
    tmp: TmpCtr
    # the statements append here
    buf: String.borrow
} is {
    indK: ind.string
    opened: u64
    seen: u64
    for each cId: (zast.kidsOf :ast span: conds) loop {
        if inLoop when (forCondIsNamed :ast kId: cId) then continue
        if inLoop when (condFoldsTrue :typing nid: cId) then continue
        if seen > 0 then {
            buf.append "\{indK}if (\{gvar}) {\n"
            indK.append "    "
            opened = opened + 1
        }
        if inLoop then {
            hoistCondYields :ast :reg :typing :ctx kId: cId ind: indK.stringView :buf
        } else if seen > 0 then {
            hoistCondYields :ast :reg :typing :ctx kId: cId ind: indK.stringView :buf
        }
        emitSteppedConjunct :ast :reg :typing :ctx kId: cId :gvar ind: indK.stringView :tmp :buf
        seen = seen + 1
    }
    closeSteppedNesting depth: opened :ind :buf
}

# openSteppedHead -- a stepped clause's conditions, and the header line that
# tests their guard. A first clause writes both at the clause's indent. A later
# clause has no `} else if` header to hold statements, so it opens `} else {`,
# writes them one level in, and answers 1: the block its caller closes after
# the chain, whose body it indents one level further.
openSteppedHead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.ifclauserow
    # a later clause nests inside `} else {`
    isFirst: bool
    # the clause's own indent
    ind: StringView
    tmp: TmpCtr
    # the statements and the header append here
    buf: String.borrow
} out u64 is {
    # the nested indent, built only when a block is opened
    indN: String
    opened: u64
    if isFirst.not then {
        buf.append "\{ind}} else {\n"
        indN.append ind
        indN.append "    "
        opened = 1
    }
    indH: if opened > 0 then indN.stringView else ind
    gv: newCondGuard :ctx ind: indH :buf
    (
        emitSteppedCond
        :ast
        :reg
        :typing
        :ctx
        conds: n.conditions
        gvar: gv.stringView
        inLoop: false
        ind: indH
        :tmp
        :buf
    )
    cw: condInParens cond: gv.stringView
    buf.append "\{indH}if \{cw} {\n"
    return opened
}

# clauseBodyIndent -- the indent a clause's body is written at: one level in
# from the clause, and one more when the clause opened a block around itself.
clauseBodyIndent: function {
    # the clause's own indent
    ind: StringView
    # the blocks the clause opened around itself
    nested: u64
} out String is {
    bodyInd: "\{ind}    "
    if nested > 0 then bodyInd.append "    "
    return bodyInd
}

# emitPlainIfHead -- the `if (c) {` or `} else if (c) {` line of a clause whose
# conditions stayed in the header. A first clause flushes the argument hoists
# its condition text recorded. A later clause's `} else if` header has nowhere
# to put them, so a later clause that recorded any opens `} else {` and, one
# level in, computes its conditions into a guard -- declared, tested, released,
# as a stepped clause does (openSteppedHead) -- and tests that: they run only on
# the path where every earlier clause failed, and like any condition past the
# first they owe nothing to the body. The answer is the blocks the clause
# opened around itself (0 or 1), which the caller closes after the chain.
emitPlainIfHead: function {
    ctx: Ctx
    isFirst: bool
    # the header's condition text
    cond: StringView
    ind: StringView
    tmp: TmpCtr
    # the header line appends here
    buf: String.borrow
} out u64 is {
    cw: condInParens :cond
    if isFirst then {
        flushArgHoists :ctx :ind :tmp :buf
        buf.append "\{ind}if \{cw} {\n"
        return 0
    }
    if (hoistsPending :ctx).not then {
        buf.append "\{ind}} else if \{cw} {\n"
        return 0
    }
    buf.append "\{ind}} else {\n"
    indN: "\{ind}    "
    gv: newCondGuard :ctx ind: indN.stringView :buf
    lL: tmp.listFrees.length
    flushArgHoists :ctx ind: indN.stringView :tmp :buf
    buf.append "\{indN}\{gv} = \{cw} ? 1 : 0;\n"
    flushBlockFrees :tmp :lL diverged: false :buf
    buf.append "\{indN}if (\{gv}) {\n"
    return 1
}

# hoistsPending -- whether argument hoists above the current floors wait to be
# declared by the statement being built.
hoistsPending: function {ctx: Ctx.view} out bool is {
    if ctx.argHoists.length > ctx.argHoistFloor then return true
    return ctx.argHoistRaw.length > ctx.argHoistRawFloor
}

# emit one if or else-if clause: its conditions, then the body they guard. The
# answer is the number of blocks the clause opened around itself (0 or 1),
# which the caller closes after the whole chain.
emitIfClause: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    isFirst: bool
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out u64 is {
    if n.ifclause then {
        # a suspending `when`, or a condition that moves an owned local, cannot
        # be built into the header text: a suspension has to land on a
        # statement, and a move's zeroing is one. Such a clause computes its
        # conditions into a guard first and lets the header test that.
        sN: List String
        sVid: ListVal ztypes.vid
        sV: List String
        sVF: ListVal cfacts
        sT: ListVal ztypes.tid
        sPrevV: List String
        sPrevF: ListVal cfacts
        sPrevT: ListVal ztypes.tid
        xMark: ctx.exSaves.length
        suspends: whenCondSuspends :ast :ctx :n
        guarded: condsNeedSteps :ast :reg :typing :ctx :suspends conds: n.conditions
        opened: u64
        cond: String
        if guarded then {
            opened = openSteppedHead :ast :reg :typing :ctx :n :isFirst :ind :tmp :buf
            (
                ifPredicateSeeds
                :ast
                :reg
                :typing
                :ctx
                conds: n.conditions
                names: sN
                svids: sVid
                vals: sV
                valFs: sVF
                tids: sT
            )
            (
                installNarrowSeeds
                :ctx
                svids: sVid
                vals: sV
                valFs: sVF
                tids: sT
                prevV: sPrevV
                prevF: sPrevF
                prevT: sPrevT
                from: 0
            )
        } else {
            for each kId: (zast.kidsOf :ast span: n.conditions) loop {
                appendCondText :ast :reg :typing :ctx :kId :cond
                # the checker's twin of this ordering is checkClauseConditions
                (
                    seedAndLayerCond
                    :ast
                    :reg
                    :typing
                    :ctx
                    condId: kId
                    names: sN
                    svids: sVid
                    vals: sV
                    valFs: sVF
                    tids: sT
                    prevV: sPrevV
                    prevF: sPrevF
                    prevT: sPrevT
                )
            }
        }
        if guarded.not then {
            opened = emitPlainIfHead :ctx :isFirst cond: cond.stringView :ind :tmp :buf
        }
        bodyInd: clauseBodyIndent :ind nested: opened
        si: u64
        for si < sN.length loop {
            snm: sN.get i: si
            svv: sV.get i: si
            cmtS: "\{ind}    /* alias: \{snm} => \{svv} */\n"
            buf.append cmtS
            si = si + 1
        }
        cst: ast.nodes.get i: n.statement
        if assignTo.length > 0 then {
            (
                emitBranchAssign
                :ast
                :reg
                :typing
                :ctx
                n: cst
                target: assignTo
                scope: n.nodeid
                ind: bodyInd.stringView
                :tmp
                :buf
            )
        } else {
            lLi: tmp.listFrees.length
            emitBodyNode :ast :reg :typing :ctx n: cst ind: bodyInd.stringView :tmp :buf
            dvF: blockDiverges :ast :reg :typing :ctx n: cst
            closeScopeBlock :ast :reg :typing :ctx :tmp lL: lLi diverged: dvF node: n.nodeid :buf
        }
        restoreNarrowSeeds :ctx svids: sVid prevV: sPrevV prevF: sPrevF prevT: sPrevT
        restoreCondExclusions :ctx mark: xMark
        return opened
    }
    return 0
}

# layerChainExclusions -- on the else side every positive chain fact failed, so
# each one's arm is excluded for the else body. A negated fact names the arm the
# subject has instead, and is seeded rather than excluded.
layerChainExclusions: function {
    ctx: Ctx
    svids: (ListVal ztypes.vid).view
    arms: (ListVal zast.nameid).view
    tids: (ListVal ztypes.tid).view
    negs: (ListVal bool).view
} is {
    fi: u64
    for fi < negs.length loop {
        if (negs.get i: fi).not then {
            (
                pushExclusion
                :ctx
                vid: (svids.get i: fi)
                arm: (arms.get i: fi)
                owner: (tids.get i: fi)
            )
        }
        fi = fi + 1
    }
}

# negatedChainArm -- the arm a negated chain fact names for this subject, "" when
# the chain never negated it. The last such fact wins, as the chain's own
# accumulation does.
negatedChainArm: function {
    svids: (ListVal ztypes.vid).view
    arms: (ListVal zast.nameid).view
    negs: (ListVal bool).view
    subj: ztypes.vid
} out zast.nameid is {
    negArm: zast.nameid
    hj: u64
    for hj < negs.length loop {
        h2v: svids.get i: hj
        if h2v == subj when (negs.get i: hj) then {
            negArm = arms.get i: hj
        }
        hj = hj + 1
    }
    return negArm
}

# seedElseSubject -- alias one chain subject to the arm the else side leaves it
# with: the arm a negated fact named, or the single arm the exclusions leave.
# Seeds nothing when the arm carries no payload to alias.
seedElseSubject: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    subj: StringView
    subjVid: ztypes.vid
    owner: ztypes.tid
    recv: StringView
    recvF: cfacts
    negArm: zast.nameid
    ind: StringView
    svids: ListVal ztypes.vid
    prevV: List String
    prevF: ListVal cfacts
    prevT: ListVal ztypes.tid
    buf: String.borrow
} is {
    fArm: negArm
    if fArm.isZero then fArm = remainingArm :reg :typing :ctx :subjVid tid: owner extra: zast.nameid
    if fArm.isZero then return
    acc: ".".string
    if (isPtrVid :ctx vid: subjVid) then acc = "->".string
    aliasF: cfacts
    aliasText: (
        armAliasText
        :ast
        :reg
        :typing
        :ctx
        tid: owner
        arm: fArm
        :recv
        :recvF
        acc: acc.stringView
        facts: aliasF
    )
    if aliasText.length == 0 then return
    (
        pushNarrow
        :ctx
        vid: subjVid
        val: aliasText.stringView
        valF: aliasF
        tid: (armMemberTid :typing :owner arm: fArm)
        :prevV
        :prevF
        :prevT
    )
    svids.append subjVid
    cmt: "\{ind}    /* alias: \{subj} => \{aliasText} */\n"
    buf.append cmt
}

# seedElseNarrows -- narrow every distinct chain subject for the else body. A
# subject that several clauses tested is seeded once, from its first fact.
seedElseNarrows: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    subjects: (List String).view
    chVids: (ListVal ztypes.vid).view
    arms: (ListVal zast.nameid).view
    tids: (ListVal ztypes.tid).view
    negs: (ListVal bool).view
    recvs: (List String).view
    recvFs: (ListVal cfacts).view
    ind: StringView
    svids: ListVal ztypes.vid
    prevV: List String
    prevF: ListVal cfacts
    prevT: ListVal ztypes.tid
    buf: String.borrow
} is {
    done: IdSet ztypes.vid
    gi: u64
    for gi < chVids.length loop {
        gv: chVids.get i: gi
        if (done.has item: gv).not then {
            done.add item: gv
            gs: subjects.get i: gi
            grecv: recvs.get i: gi
            na: negatedChainArm svids: chVids :arms :negs subj: gv
            (
                seedElseSubject
                :ast
                :reg
                :typing
                :ctx
                subj: gs.stringView
                subjVid: gv
                owner: (tids.get i: gi)
                recv: grecv.stringView
                recvF: (recvFs.get i: gi)
                negArm: na
                :ind
                :svids
                :prevV
                :prevF
                :prevT
                :buf
            )
        }
        gi = gi + 1
    }
}

# emit an if/match else branch.
emitElse: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    oId: zast.nodeid
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    chSubjects: (List String).view
    chSubjectVids: (ListVal ztypes.vid).view
    chArms: (ListVal zast.nameid).view
    chTids: (ListVal ztypes.tid).view
    chNegs: (ListVal bool).view
    chRecvs: (List String).view
    chRecvFs: (ListVal cfacts).view
    buf: String.borrow
} is {
    if oId.isZero then return
    o: ast.nodes.get i: oId
    lh: "\{ind}} else {\n"
    buf.append lh
    bodyInd: "\{ind}    "
    xMark: ctx.exSaves.length
    layerChainExclusions :ctx svids: chSubjectVids arms: chArms tids: chTids negs: chNegs
    sVid: ListVal ztypes.vid
    sPrevV: List String
    sPrevF: ListVal cfacts
    sPrevT: ListVal ztypes.tid
    (
        seedElseNarrows
        :ast
        :reg
        :typing
        :ctx
        subjects: chSubjects
        chVids: chSubjectVids
        arms: chArms
        tids: chTids
        negs: chNegs
        recvs: chRecvs
        recvFs: chRecvFs
        :ind
        svids: sVid
        prevV: sPrevV
        prevF: sPrevF
        prevT: sPrevT
        :buf
    )
    if assignTo.length > 0 then {
        (
            emitBranchAssign
            :ast
            :reg
            :typing
            :ctx
            n: o
            target: assignTo
            scope: oId
            ind: bodyInd.stringView
            :tmp
            :buf
        )
    } else {
        lLe: tmp.listFrees.length
        emitBodyNode :ast :reg :typing :ctx n: o ind: bodyInd.stringView :tmp :buf
        dvF: blockDiverges :ast :reg :typing :ctx n: o
        closeScopeBlock :ast :reg :typing :ctx :tmp lL: lLe diverged: dvF node: oId :buf
    }
    restoreNarrowSeeds :ctx svids: sVid prevV: sPrevV prevF: sPrevF prevT: sPrevT
    restoreCondExclusions :ctx mark: xMark
}

# emitHoistedReturn -- a return whose value is materialised into a temp
# FIRST, then the sources it moved out of are zeroed, then the owned locals are
# freed (`cleanup`), then the temp is returned: a local the value read is
# reclaimed, and a moved-in local's free is a no-op.
emitHoistedReturn: function {
    ctx: Ctx
    # the value's C text and C type
    rv: StringView
    retCt: StringView
    # the zeroing of the sources the value moved out of
    moved: StringView
    cleanup: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    rtmpN: tmpNext :ctx :tmp
    retNm: "_ret\{rtmpN}"
    buf.append "\{ind}\{retCt} \{retNm} = \{rv};\n"
    buf.append moved
    buf.append cleanup
    buf.append "\{ind}return \{retNm};\n"
}

# refReturnText -- the address a reference-returning function hands back for
# the value `rv`: the value's own text when the C already holds it through a
# pointer (a borrowed parameter, a borrowed field, another reference call), its
# address otherwise.
refReturnText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    vid: zast.nodeid
    rv: StringView
} out String is {
    if (pathIsPointer :ast :reg :typing :ctx n: (ast.nodes.get i: vid)) then return rv.string
    return "&\{rv}"
}

# emitDirectReturn -- a return of the value as it stands, after the cleanup.
# A reference return hands back the address,
# not a copy of the struct (without the `&` the caller writes through a
# temporary); a pointer-held valtype is loaded.
emitDirectReturn: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    vid: zast.nodeid
    rv: StringView
    cleanup: StringView
    ind: StringView
    buf: String.borrow
} is {
    buf.append cleanup
    rvOut: "\{rv}"
    if ctx.refBorrowRet then rvOut = refReturnText :ast :reg :typing :ctx :vid :rv
    if ctx.refBorrowRet.not when (
        needsValueDeref
        :ast
        :reg
        :typing
        :ctx
        n: (ast.nodes.get i: vid)
        tid: (stampIdOf :typing nid: vid)
    ) then rvOut = "(*\{rv})"
    buf.append "\{ind}return \{rvOut};\n"
}

# emitPlainReturn -- a return that is neither an Option box nor a String
# value. A non-trivial value-type return may read an owned local the cleanup
# would free -- a borrowed element or view (e.g. `container.get idx`, or a
# StringView into a local String) -- so it is hoisted into a temp before the
# frees. Pointer returns (protocol / Map / Set / by-ref class) arrive as bare
# temps and are returned as they stand: the checker's exit list does not hold
# what the return hands over.
emitPlainReturn: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    vid: zast.nodeid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    rvF: cfacts
    rv: (
        standInText
        :ast
        :reg
        :typing
        :ctx
        n: (ast.nodes.get i: vid)
        text: (emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: vid) facts: rvF)
        facts: rvF
    )
    flushArgHoists :ctx :ind :tmp :buf
    cleanup: String
    emitReturnCleanup :ast :reg :typing :ctx :tmp :ind buf: cleanup
    rtid: stampIdOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: vid))
    # an implementer returned as the spec is its box, of the spec's type
    so: typing.standInOf.get key: vid
    if so.some then {
        rtid = so.spec
    }
    retCt: typeRefC :ast :reg :typing :ctx tid: rtid
    isPtr: (
        (ctEndsWithStar ct: retCt.stringView) or (isHeapPtrCollection :reg :typing :ctx tid: rtid)
    )
    trivial: isBareCName s: rv.stringView
    # the sources the value moves out of -- a taken argument, a narrowed
    # payload's box -- zeroed once the value is in its temp
    moved: String
    emitValueTakeInvalidations :ast :reg :typing :ctx n: (ast.nodes.get i: vid) :ind buf: moved
    emitNarrowedTakeZero :ast :reg :typing :ctx n: (ast.nodes.get i: vid) :ind buf: moved
    hoist: (
        trivial.not and
        isPtr.not and
        (retCt.length > 0) and
        ((cleanup.length > 0) or (moved.length > 0))
    )
    # a heap collection the return MOVES out of a source -- a `.take`, a
    # narrowed payload -- or that an `if` or `match` yields from arms that own
    # their values: the pointer is bound first, the source zeroed, and every
    # owned local is freed after -- the source's owner, and the local on a path
    # whose arm did not take it, included
    if retCt.length > 0 when (isHeapPtrCollection :reg :typing :ctx tid: rtid) when (
        (moved.length > 0) or
        (controlValueOwnsArms :ast :reg :typing :ctx n: (ast.nodes.get i: vid))
    ) then {
        hpc: "\{retCt}*"
        (
            emitHoistedReturn
            :ctx
            rv: rv.stringView
            retCt: hpc.stringView
            moved: moved.stringView
            cleanup: cleanup.stringView
            :ind
            :tmp
            :buf
        )
        return
    }
    if hoist when ctx.refBorrowRet then {
        # a reference return holds the ADDRESS across the frees, not a copy
        rr: refReturnText :ast :reg :typing :ctx :vid rv: rv.stringView
        preludeNeed :ctx memb: "@typeof"
        rrCt: "Z_TYPEOF(\{rr})"
        (
            emitHoistedReturn
            :ctx
            rv: rr.stringView
            retCt: rrCt.stringView
            moved: moved.stringView
            cleanup: cleanup.stringView
            :ind
            :tmp
            :buf
        )
    } else if hoist then {
        (
            emitHoistedReturn
            :ctx
            rv: rv.stringView
            retCt: retCt.stringView
            moved: moved.stringView
            cleanup: cleanup.stringView
            :ind
            :tmp
            :buf
        )
    } else {
        (
            emitDirectReturn
            :ast
            :reg
            :typing
            :ctx
            :vid
            rv: rv.stringView
            cleanup: cleanup.stringView
            :ind
            :buf
        )
    }
}

# emitReturnOfNode -- `return <value of node vid>;` with the explicit-return
# machinery: option-box hoist, string-return fast path, and the leak-safe
# temp-materialization + cleanup ordering. Shared by the `return` call arm
# and tail-position value yields.
emitReturnOfNode: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    vid: zast.nodeid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    # a value typed `null` -- `null` itself, a call answering nothing -- is
    # handed back by a function answering nothing: run, then a bare return
    if (stampIsNullType :reg :typing nid: (interpPartNodeId n: (ast.nodes.get i: vid))) then {
        if (isNullValueAtom :reg :typing n: (ast.nodes.get i: vid)).not then {
            nre: emitExpr :ast :reg :typing :ctx n: (ast.nodes.get i: vid)
            flushArgHoists :ctx :ind :tmp :buf
            buf.append "\{ind}(void)(\{nre});\n"
        }
        emitReturnCleanup :ast :reg :typing :ctx :tmp :ind :buf
        buf.append "\{ind}return;\n"
        return
    }
    bx: emitOptionBoxHoist :ast :reg :typing :ctx n: (ast.nodes.get i: vid) :ind :tmp :buf
    if bx.length > 0 then {
        emitValueTakeInvalidations :ast :reg :typing :ctx n: (ast.nodes.get i: vid) :ind :buf
        emitReturnCleanup :ast :reg :typing :ctx :tmp :ind :buf
        buf.append "\{ind}return \{bx};\n"
        return
    }
    if (emitStringReturnValue :ast :reg :typing :ctx n: (ast.nodes.get i: vid) :ind :tmp :buf
    ) then return
    emitPlainReturn :ast :reg :typing :ctx :vid :ind :tmp :buf
}

# emitTailValue -- a tail value the atom, string and block arms leave, in return
# position: the value ztypecheck.implicitReturnValue answers for the line, the
# one the checker checked as a return. A call, a path or an operator returns
# through the explicit-return machinery; an `if`, a `match` or a list
# comprehension, which `return` cannot take, binds a return local the way a
# binding of it does, and that local is returned. False when the line yields no
# value.
emitTailValue: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    lineId: zast.nodeid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    vid: (
        ztypecheck.implicitReturnValue
        :reg
        :typing
        :ast
        :lineId
        lineType: (stampIdOf :typing nid: lineId)
    )
    if vid.isZero then return false
    isBlock: false
    isCtl: false
    {
        vn: ast.nodes.get i: vid
        isBlock = vn.doexpr
        # A `with` THAT YIELDS A VALUE binds a return local like any other
        # control value. emitTailStmt would emit the binding and then the body
        # as a statement, so the function would return the value the `with`
        # BOUND rather than the one its body yields: `with a: (xs.get i: 0) do
        # a * 3` would answer a, silently. A
        # `with` whose body RETURNS yields nothing, so implicitReturnValue
        # answers 0 above and that leg still has it.
        isCtl = vn.ifexpr or vn.caseexpr or vn.forexpr or vn.withexpr
    }
    if isBlock then return false
    ctx.tailReturned = true
    if isCtl.not then {
        emitReturnOfNode :ast :reg :typing :ctx :vid :ind :tmp :buf
        return true
    }
    rtid: (
        stampIdOf
        :typing
        nid: (controlValueStampNid :ast :reg :typing n: (ast.nodes.get i: vid))
    )
    ct: typeRefC :ast :reg :typing :ctx tid: rtid
    if (isHeapPtrCollection :reg :typing :ctx tid: rtid) then ct = "\{ct}*"
    trn: tmpNext :ctx :tmp
    nm: "_tr\{trn}"
    bound: (
        emitControlBindValue
        :ast
        :reg
        :typing
        :ctx
        :vid
        :rtid
        nm: nm.stringView
        ct: ct.stringView
        :ind
        :tmp
        :buf
    )
    if bound.not then return false
    cl: String
    emitReturnCleanup :ast :reg :typing :ctx :tmp :ind buf: cl
    buf.append cl
    buf.append "\{ind}return \{nm};\n"
    return true
}

# emitControlBindValue -- bind the value of an `if`, a `match`, a `with` or a
# list comprehension to the local `nm`, as a binding of it is emitted.
emitControlBindValue: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    vid: zast.nodeid
    rtid: ztypes.tid
    nm: StringView
    ct: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    vn: ast.nodes.get i: vid
    if (emitIfBindValue :ast :reg :typing :ctx n: vn :nm :ct :ind :tmp :buf) then return true
    if (emitMatchBindValue :ast :reg :typing :ctx n: vn :nm :ct :ind :tmp :buf) then return true
    if (emitWithBindValue :ast :reg :typing :ctx n: vn :rtid :nm :ct :ind :tmp :buf
    ) then return true
    if (
        emitDoBindValue
        :ast
        :reg
        :typing
        :ctx
        n: vn
        :nm
        :ct
        tid: rtid
        :ind
        :tmp
        :buf
    ) then return true
    if (forexprValue n: vn).not then return false
    lcb: spelledCname :ctx tid: rtid
    noteMemberUse :ctx mono: rtid member: memberWord.slot.create
    lc0: "\{ind}\{lcb}_t \{nm} = \{lcb}_create((uint64_t)0);\n"
    buf.append lc0
    (
        emitListComprehension
        :ast
        :reg
        :typing
        :ctx
        listTid: rtid
        forNode: vn
        listCb: lcb.stringView
        listVar: nm
        :ind
        :tmp
        :buf
    )
    return true
}

# emitTailStmt -- the last statement of an `out`-typed function body sits in
# return position: a bare value expression becomes `return <expr>;`, and a
# with/do block forwards return position into its own final statement. False
# when the statement is not a tail-value shape (the caller emits it normally).
emitTailStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    match (
        n
    ) case statementline then {
        # a tail the checker recorded is an exit: its return frees what the
        # checker listed for the line (exitDestroy)
        outerExit: ctx.exitNode
        ctx.exitNode = zast.nodeid
        if (typing.tailExits.has item: n.nodeid) then ctx.exitNode = n.nodeid
        done: (
            emitTailStmt
            :ast
            :reg
            :typing
            :ctx
            n: (ast.nodes.get i: n.statementline)
            :ind
            :tmp
            :buf
        )
        if done.not then done = emitTailValue :ast :reg :typing :ctx lineId: n.nodeid :ind :tmp :buf
        ctx.exitNode = outerExit
        return done
    } case atomid then {
        if n.name == zast.wellKnown.slot.wkReturn then return false
        if n.name == zast.wellKnown.slot.wkBreak then return false
        if n.name == zast.wellKnown.slot.wkContinue then return false
        if (stampIsNullType :reg :typing nid: n.nodeid) then return false
        emitReturnOfNode :ast :reg :typing :ctx vid: n.nodeid :ind :tmp :buf
        ctx.tailReturned = true
        return true
    } case atomstring then {
        emitReturnOfNode :ast :reg :typing :ctx vid: n.nodeid :ind :tmp :buf
        ctx.tailReturned = true
        return true
    } case withexpr then {
        # return position passes inward only when the checker said it does
        # (withForwardsTail); otherwise the `with` IS the tail value, and
        # emitTailValue binds and returns it
        if (ztypecheck.withForwardsTail :ast n: (ast.nodes.get i: n.nodeid)).not then return false
        # an owned copy: the with-binding's emission below lends ast
        wnmT: varCName :ctx :ast :reg vid: (defVid :typing nid: n.nodeid)
        wsidT: stampIdDeep :reg :typing n: (ast.nodes.get i: n.value)
        wctT: withValueCType :ast :reg :typing :ctx n: (ast.nodes.get i: n.value) wsid: wsidT
        wvT: emitExpr :ast :reg :typing :ctx n: (ast.nodes.get i: n.value)
        # a reference-returning callee hands back `T*`, so a `with` binding
        # ALIASES its source exactly as a plain binding does
        {
            wrbT: refBorrowCalleeFid :ast :reg :typing :ctx n: (ast.nodes.get i: n.value)
            if wrbT.notZero when (fnReturnsRefBorrow :reg :typing :ctx fid: wrbT retTid: wsidT
            ) then {
                wctTP: refPtrC :typing tid: wrbT base: wctT.stringView
                wctT = wctTP.take
                ctx.ptrVids.append (defVid :typing nid: n.nodeid)
                wvT = (
                    unloadValueStructRef
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: (ast.nodes.get i: n.value)
                    e: wvT.stringView
                )
            }
        }
        if wctT.length > 0 then {
            lwT: "\{ind}\{wctT} \{wnmT} = \{wvT};\n"
            buf.append lwT
        } else {
            withLine: "\{ind}int64_t \{wnmT} = \{wvT};\n"
            buf.append withLine
        }
        ctx.tailRetActive = true
        emitBodyNode :ast :reg :typing :ctx n: (ast.nodes.get i: n.body) :ind :tmp :buf
        return true
    } case doexpr then {
        dstT: ast.nodes.get i: n.statement
        if (ztypecheck.blockHasBreak :ast n: dstT) then return false
        ctx.tailRetActive = true
        emitBodyNode :ast :reg :typing :ctx n: dstT :ind :tmp :buf
        return true
    } else {
        return false
    }
}

# emitBranchAssign -- emit an if/match branch whose final value assigns
# to a target: a block emits all but its last statement normally, the
# last as `target = <value>`; a single node assigns directly. A branch that
# ends by leaving assigns nothing.
emitBranchAssign: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    target: StringView
    # the checker scope the branch is, whose recorded list its end prints
    scope: zast.nodeid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    match (
        n
    ) case statement then {
        # a local the branch declares is freed at the branch's end, where it is
        # still in C scope
        lL: tmp.listFrees.length
        cnt: n.statements.count.u64
        si: u64
        for (si + 1) < cnt loop {
            sxId: zast.kidAt kids: ast.kids span: n.statements i: si
            emitStmt :ast :reg :typing :ctx n: (ast.nodes.get i: sxId) :ind :tmp :buf
            si = si + 1
        }
        dv: false
        if cnt > 0 then {
            lastId: zast.kidAt kids: ast.kids span: n.statements i: cnt - 1
            dv = (
                emitBranchLastAssign
                :ast
                :reg
                :typing
                :ctx
                lineId: lastId
                :target
                :ind
                :tmp
                :buf
            )
        }
        closeScopeBlock :ast :reg :typing :ctx :tmp :lL diverged: dv node: scope :buf
    } else {
        if (matchDiverges :reg :typing nid: (zast.nodeIdOf :n)) then {
            emitStmt :ast :reg :typing :ctx :n :ind :tmp :buf
            return
        }
        vx2F: cfacts
        vx2: emitExprWith :ast :reg :typing :ctx :n facts: vx2F
        # an argument the value hoisted is declared in the arm, which runs it
        # only when selected, and freed at the arm's end
        listFreesMark: tmp.listFrees.length
        flushArgHoists :ctx :ind :tmp :buf
        appendArmAssign :ast :reg :typing :ctx :n :target vx: vx2.stringView vxF: vx2F :ind :buf
        emitArmTakeZero :ast :reg :typing :ctx :n rv: vx2.stringView :ind :buf
        emitValueTakeInvalidations :ast :reg :typing :ctx :n :ind :buf
        flushBlockFrees :tmp lL: listFreesMark diverged: false :buf
    }
}

# emitBranchLastAssign -- a branch block's last line: assigned to the target when
# it yields, run as the statement it is when it leaves -- a return, a panic, a
# reached `error`, a break or a continue. True when it leaves.
emitBranchLastAssign: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    lineId: zast.nodeid
    target: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    sx: ast.nodes.get i: lineId
    if (stmtDiverges :ast :reg :typing :ctx sid: lineId) then {
        emitStmt :ast :reg :typing :ctx n: sx :ind :tmp :buf
        return true
    }
    if (emitNestedControlAssign :ast :reg :typing :ctx line: sx :target :ind :tmp :buf
    ) then return false
    vxF: cfacts
    vx: emitExprWith :ast :reg :typing :ctx n: sx facts: vxF
    # an argument the value hoisted is declared here, inside the branch; the
    # block's flush frees it
    flushArgHoists :ctx :ind :tmp :buf
    appendArmAssign :ast :reg :typing :ctx n: sx :target vx: vx.stringView :vxF :ind :buf
    emitArmTakeZero :ast :reg :typing :ctx n: sx rv: vx.stringView :ind :buf
    emitValueTakeInvalidations :ast :reg :typing :ctx n: sx :ind :buf
    return false
}

# emitNestedControlAssign -- a branch whose value is itself a `match`, or an
# `if` one of whose arms leaves, assigns the target from that construct's arms
# in statements, since no single C expression can spell it; false for any other
# value.
emitNestedControlAssign: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    line: astnode.view
    target: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    if line.statementline.not then return false
    mn: ast.nodes.get i: line.statementline
    match (
        mn
    ) case caseexpr then {
        ctx.condDepth = ctx.condDepth + 1
        emitMatchStmt :ast :reg :typing :ctx m: mn assignTo: target :ind :tmp :buf
        ctx.condDepth = ctx.condDepth - 1
        return true
    } case ifexpr then {
        if (ztypecheck.armLeaves :ast n: (ast.nodes.get i: mn.nodeid) inLoop: false).not then {
            return false
        }
        emitIfAssign :ast :reg :typing :ctx n: mn :target :ind :tmp :buf
        return true
    } else {
        return false
    }
}

# postGuardStmtId -- the node id of a guarding if/match statement that
# recorded a post-guard narrowing; 0 otherwise.
postGuardStmtId: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out zast.nodeid is {
    match (
        n
    ) case statementline then {
        return (postGuardStmtId :ast :typing n: (ast.nodes.get i: n.statementline))
    } case ifexpr then {
        po: typing.postGuardName.get key: n.nodeid
        match (
            po
        ) case some then {
            return n.nodeid
        } case none then {
            return zast.nodeid
        }
    } case caseexpr then {
        po: typing.postGuardName.get key: n.nodeid
        match (
            po
        ) case some then {
            return n.nodeid
        } case none then {
            return zast.nodeid
        }
    } else {
        return zast.nodeid
    }
}

# seedPostGuardAlias -- a guard statement that returns on the failing arm leaves
# its subject narrowed for everything after it, so alias the subject to that
# arm's payload for the rest of the block. The alias text is emitted C, so the
# receiver is the subject's identifier and the narrowing tables key on its
# variable. Seeds nothing when the checker recorded no complete guard.
seedPostGuardAlias: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    names: List String
    svids: ListVal ztypes.vid
    prevV: List String
    prevF: ListVal cfacts
    prevT: ListVal ztypes.tid
    buf: String.borrow
} is {
    pgid: postGuardStmtId :ast :typing :n
    if pgid.isZero then return
    pgRawId: (typing.postGuardName.get key: pgid).or d: zast.nameid
    pgRawN: zast.poolTextAt pool: ast.names ref: pgRawId
    if pgRawN.length == 0 then return
    pgrv: (
        (typing.postGuardVarId.get key: pgid).or
        d: ztypes.vid.zero
    )
    if pgrv.isZero then return
    owner: (typing.postGuardTid.get key: pgid).or d: ztypes.tid.zero
    if owner.isZero then return
    armId: (typing.postGuardArm.get key: pgid).or d: zast.nameid
    if armId.isZero then return
    pgRecvF: cfacts
    pgRecv: wholeLocalName :ast :reg :ctx vid: pgrv name: pgRawN.stringView facts: pgRecvF
    acc: ".".string
    if (isPtrVid :ctx vid: pgrv) then acc = "->".string
    # a subject an enclosing narrowing still holds at the guard's type -- an
    # option narrowed to `some`, then guarded on its payload's arm -- is read
    # through that narrowing: the arm is the payload's, not the local's. The
    # narrowed value is the payload itself, read with `.`
    if ((vtGet xs: ctx.narrowTid vid: pgrv).or d: ztypes.tid.zero) == owner then {
        nb: vvGet xs: ctx.narrowBox vid: pgrv
        if nb.length > 0 then {
            pgRecv = nb.take
            pgRecvF = vvFactsOf xs: ctx.narrowBox vid: pgrv
            acc = ".".string
        }
    }
    if pgRecv.length == 0 then return
    aliasF: cfacts
    aliasText: (
        armAliasText
        :ast
        :reg
        :typing
        :ctx
        tid: owner
        arm: armId
        recv: pgRecv.stringView
        recvF: pgRecvF
        acc: acc.stringView
        facts: aliasF
    )
    if aliasText.length == 0 then return
    (
        pushNarrow
        :ctx
        vid: pgrv
        val: aliasText.stringView
        valF: aliasF
        tid: (armMemberTid :typing :owner arm: armId)
        :prevV
        :prevF
        :prevT
    )
    cmt: "\{ind}/* post-guard alias: \{pgRawN} => \{aliasText} */\n"
    buf.append cmt
    pgrn: pgRawN.copy
    names.append pgrn
    svids.append pgrv
}

# restoreBlockAliases -- put back the narrowings the block's post-guard seeds
# displaced, newest first. A write inside the block does not end a seed early:
# each read after it is told apart by its own stamp.
restoreBlockAliases: function {
    ctx: Ctx
    svids: (ListVal ztypes.vid).view
    prevV: (List String).view
    prevF: (ListVal cfacts).view
    prevT: (ListVal ztypes.tid).view
} is {
    zi: svids.length
    for zi > 0 loop {
        zi = zi - 1
        zv: prevV.get i: zi
        zt: prevT.get i: zi
        (
            restoreNarrow
            :ctx
            vid: (svids.get i: zi)
            prevFacts: (prevF.get i: zi)
            prevVal: zv.stringView
            prevTid: zt
        )
    }
}

# emitStatementBlock -- emit a block's statements in order. The tail-return flag
# reaches the LAST statement only, a diverging statement ends the block because
# what follows it is unreachable, and the post-guard aliases each statement
# seeds hold for the rest of the block and no longer.
emitStatementBlock: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    stmts: zast.kidspan
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    trTail: ctx.tailRetActive
    ctx.tailRetActive = false
    pgN: List String
    pgVid: ListVal ztypes.vid
    pgPrevV: List String
    pgPrevF: ListVal cfacts
    pgPrevT: ListVal ztypes.tid
    i: u64
    nst: stmts.count.u64
    for i < nst loop {
        stmtId: zast.kidAt kids: ast.kids span: stmts :i
        s: ast.nodes.get i: stmtId
        tailNow: false
        if trTail when (i + 1) == nst then tailNow = true
        handled: false
        if tailNow then {
            handled = emitTailStmt :ast :reg :typing :ctx n: s :ind :tmp :buf
        }
        if handled.not then emitStmt :ast :reg :typing :ctx n: s :ind :tmp :buf
        trunc: false
        if (stmtDiverges :ast :reg :typing :ctx sid: stmtId) then trunc = true
        (
            seedPostGuardAlias
            :ast
            :reg
            :typing
            :ctx
            n: s
            :ind
            names: pgN
            svids: pgVid
            prevV: pgPrevV
            prevF: pgPrevF
            prevT: pgPrevT
            :buf
        )
        i = i + 1
        if trunc then i = nst
    }
    restoreBlockAliases :ctx svids: pgVid prevV: pgPrevV prevF: pgPrevF prevT: pgPrevT
}

# emit one statement or expression node of a body.
emitBodyNode: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    # A FOR-EXPRESSION'S BODY APPENDS ITS VALUE, and this is the one point all
    # five loop shapes emit their body through, so it is the one place that has
    # to know. The target is matched by NODE, so a body emitted from inside the
    # loop's header cannot take it.
    depth: ctx.comprehendTo.length
    if depth > 0 then {
        hit: false
        top: ctx.comprehendTo.get i: depth - 1
        hit = top.body == (zast.nodeIdOf :n)
        top.drop
        if hit then {
            target: ctx.comprehendTo.pop
            (
                emitComprehensionNode
                :ast
                :reg
                :typing
                :ctx
                :n
                listCb: target.cb.stringView
                listVar: target.lvar.stringView
                :ind
                :tmp
                :buf
            )
            return
        }
    }
    match (
        n
    ) case statement then {
        emitStatementBlock :ast :reg :typing :ctx stmts: n.statements :ind :tmp :buf
    } else {
        emitStmt :ast :reg :typing :ctx :n :ind :tmp :buf
    }
}

# forexprValue -- the value being bound is a for-loop (a list comprehension).
forexprValue: function {n: astnode.view} out bool is {
    match (
        n
    ) case forexpr then {
        return true
    } else {
        return false
    }
}

# emitAppendedValueMoves -- THE APPEND IS A MOVE, so what it consumed is zeroed
# where a statement's would be: the local a bare owned value came out of, when
# a destroy still reaches it (emitMovedSourceZero), and the sources any taking
# call inside it moved from.
emitAppendedValueMoves: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    buf: String.borrow
} is {
    match (
        n
    ) case statementline then {
        (
            emitAppendedValueMoves
            :ast
            :reg
            :typing
            :ctx
            n: (ast.nodes.get i: n.statementline)
            :ind
            :buf
        )
    } else {
        emitMovedSourceZero :ast :reg :typing :ctx :n :ind :buf
        emitValueTakeInvalidations :ast :reg :typing :ctx :n :ind :buf
    }
}

# emitComprehensionNode -- the body's statements: each but the last emits
# normally; the last is the value expression, appended to the list.
emitComprehensionNode: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    listCb: StringView
    listVar: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    match (
        n
    ) case statement then {
        cnt: n.statements.count.u64
        si: u64
        for si < cnt loop {
            stId: zast.kidAt kids: ast.kids span: n.statements i: si
            st: ast.nodes.get i: stId
            if si == (cnt - 1) then {
                av: emitExpr :ast :reg :typing :ctx n: st
                flushArgHoists :ctx :ind :tmp :buf
                la: "\{ind}\{listCb}_append(&\{listVar}, (\{av}));\n"
                buf.append la
                emitAppendedValueMoves :ast :reg :typing :ctx n: st :ind :buf
            } else {
                emitStmt :ast :reg :typing :ctx n: st :ind :tmp :buf
            }
            si = si + 1
        }
    } else {
        av2: emitExpr :ast :reg :typing :ctx :n
        flushArgHoists :ctx :ind :tmp :buf
        la2: "\{ind}\{listCb}_append(&\{listVar}, (\{av2}));\n"
        buf.append la2
        emitAppendedValueMoves :ast :reg :typing :ctx :n :ind :buf
    }
}

# emitListComprehension -- populate listVar from a `for` used as an expression.
#
# IT WALKS WHATEVER THE STATEMENT FORM WALKS. The append target is recorded
# against the loop's body node and emitForStmt is asked for the loop, so the
# counted range, the closed range, an object iterator, a do-while and a plain
# condition all reach the emitters they already reach as statements -- and
# bring the loop labels, the `while:` arms, the scope destroys, the break and
# continue cleanup and the generator spills with them. A shape of its own would
# have to be kept beside each of those, and a source it did not know would
# answer an empty list with no diagnostic.
emitListComprehension: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    forNode: astnode.view
    # the list instance the comprehension appends to
    listTid: ztypes.tid
    listCb: StringView
    listVar: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    match (
        forNode
    ) case forexpr then {
        # a precondition the fold proved false: the list stays empty
        if (foldedLoopOf :typing nid: forNode.nodeid).entry == ztyping.loopentry.never then return
        noteMemberUse :ctx mono: listTid member: memberWord.slot.append
        ctx.comprehendTo.append (
            ComprehendTo
            body: forNode.body
            cb: listCb.string
            lvar: listVar.string
        )
        depth: ctx.comprehendTo.length
        emitForStmt :ast :reg :typing :ctx n: forNode :ind :tmp :buf
        # the body always emits, so the target always goes; one left standing
        # means the list would be silently empty, which is the defect this
        # replaced and is not a thing to fall back to
        if ctx.comprehendTo.length == depth then {
            target: ctx.comprehendTo.pop
            f6: "for-expression body emitted no append (list \{target.lvar})"
            emitFail :ctx what: f6 line: forNode.lineno
        }
    } else null
}


# isUserGenericMonoTid -- a specialization of a non-native USER generic type, as
# opposed to a collection mono or a runtime-owned one. Every family whose method
# bodies this emitter writes qualifies: a record, a variant and a facet carry
# the same method surface as a class, only by value. A protocol's instance has
# no bodies of its own -- its implementers carry them -- so it is not one.
isUserGenericMonoTid: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    og4: genericOriginTid :reg :tid
    if og4.isZero then return false
    if (isCollectionOriginTid :ctx originTid: og4) then return false
    if (reg.isNativeOf tid: og4) then return false
    return (isUserStructType tt: (reg.typetypeOf typeId: og4))
}

# isUserClassMonoTid -- the CLASS subset of the above. Its instances behave like
# ordinary classes -- pointer receivers -- which a valtype mono does not, so the
# by-reference parameter rule asks this one and the method emitter asks the
# family-wide one.
isUserClassMonoTid: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    if (isUserGenericMonoTid :reg :ctx :tid).not then return false
    originKind: reg.typetypeOf typeId: (genericOriginTid :reg :tid)
    if originKind == ztypes.ztypetype.classType then return true
    return false
}

# isReftypeParam -- a user reftype (class/union) param, passed BY REFERENCE: a
# function param that is a CLASS or an owning UNION (unionBorrowsByPtr), not a
# collection mono (List/Map/Set), and not a value-native (String/StringView live
# in the system/collections units). A templated class (a sync type, an atomic)
# is a class the runtime lays out, and passes as a class does: a copy of an
# atomic is another atomic. Records/variants/facets (valtypes), protocols and
# the other natives stay by value. A typedef passes as the end of its chain
# does: a typedef over a class is that class.
isReftypeParam: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} out bool is {
    cid: chaseStrTypedef :typing :ctx tid: (chaseAggregateTypedef :reg :typing :ctx :tid)
    duT: definedInUnitTid :reg :typing :tid
    isShell: duT.isZero
    if isShell then {
        canonTid: canonTypeId :reg :typing :tid
        if canonTid.notZero then cid = canonTid
    }
    tt: reg.typetypeOf typeId: cid
    if tt == ztypes.ztypetype.unionType then return (unionBorrowsByPtr :reg :ctx tid: cid)
    if tt != ztypes.ztypetype.classType then return false
    if (tmplClassRowOf :reg :ctx tid: cid) > 0 then return true
    origin: originTidOf :reg tid: cid
    if origin.notZero when (isUserClassMonoTid :reg :ctx tid: cid).not then return false
    # the types with their own family rule answer through it, not the
    # user-class one: containers via isListPtrParam/isSetMapPtrParam, String
    # via isBorrowStringParam (pointer when non-owned), StringView by value (a
    # 16-byte fat pointer with no owned interior). Each is asked by what it IS
    # -- the two well-known ids, a runtime-owned layout -- and the collection
    # monos left above already. Asking which unit declared it answered for a
    # user class of the same name too, which no id does.
    return ((cid == ctx.strTid) or (cid == ctx.svTid) or (reg.isNativeOf tid: cid)).not
}

# unionBorrowsByPtr -- a union borrowed is a POINTER to the caller's slot, as a
# borrowed String is: a payload may live in the header itself, so a copy of the
# header is not a borrow -- a write through the copy's payload would be lost.
# A view union (OptionView, OptionMut, and their valtype twins) holds only a
# pointer to what it refers to, and passes by value as the other native views do.
unionBorrowsByPtr: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    if (reg.typetypeOf typeId: tid) != ztypes.ztypetype.unionType then return false
    return (isViewUnionOriginOf :reg :ctx :tid).not
}

# elemBorrowsByPtr -- a List/ListView element type whose `get` lowers to a
# POINTER into the element storage, honouring the declared `out of.borrow`.
# Mirrors the parameter-passing classification: user CLASSES, owning UNIONS
# and String carry heap fields, inline container headers or a payload in the
# header, so a copy is NOT a borrow (a field write is dropped, and an append
# through an inline container field reallocs the copy's buffer and strands the
# stored element on a freed pointer). A valtype has no interior -- the copy IS
# the borrow.
elemBorrowsByPtr: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} out bool is {
    if tid.isZero then return false
    if tid == ctx.strTid then return true
    chasedStrTid: chaseStrTypedef :typing :ctx :tid
    if chasedStrTid == ctx.strTid then return true
    return (isReftypeParam :reg :typing :ctx :tid)
}

# elemRefByPtr -- a List/ListView element type whose MUTABLE reference is a
# pointer into the storage. Everything `elemBorrowsByPtr` covers, plus a
# COMPOUND valtype: a record or variant has children, and mutating them in
# place is exactly what `getMut` is for, so handing back a copy loses the
# write. A collection element is one too: a copy of its header shares the
# buffer, so a write through the copy is lost and a growing append frees the
# stored element's buffer. It is deliberately NOT the same question as
# `elemBorrowsByPtr`, which also answers "what calling convention does this type
# use" for the declared hash/`==` dispatch, where a record is still passed BY
# VALUE.
elemRefByPtr: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} out bool is {
    if (elemBorrowsByPtr :reg :typing :ctx :tid) then return true
    # a Set or a Map element is already a pointer, so a copy of it IS the reference
    if (isHeapPtrCollection :reg :typing :ctx :tid) then return false
    ce: chaseAggregateTypedef :reg :typing :ctx :tid
    if (isCollectionOriginTid :ctx originTid: (originTidOf :reg tid: ce)) then return true
    tt: reg.typetypeOf typeId: tid
    if tt == ztypes.ztypetype.recordType then return true
    return tt == ztypes.ztypetype.variantType
}

# listGetIsPtr -- the `get` of this List/ListView mono returns a pointer: its
# element borrows by pointer (emitColGet writes it so).
listGetIsPtr: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
} out bool is {
    return (elemBorrowsByPtr :reg :typing :ctx tid: (listElemType :reg :typing :monoId))
}

# isBorrowStringParam -- a non-owned String param (BORROW/LOCK or VIEW), passed
# BY REFERENCE: String is 24 bytes with a heap interior, so a copy is never a
# borrow -- `.borrow` needs the pointer for mutation (append/reserve), `.view`
# for cost and so a view-projected String (StringView.asString) can alias one.
# A `.take` String param is moved by value instead. StringView stays BY VALUE
# for a stated reason: a 16-byte fat pointer with no owned interior -- two
# registers on SysV, and copying it carries nothing that can dangle.
isBorrowStringParam: function {
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    fid: ztypes.tid
    pnameId: zast.nameid
    pid: ztypes.tid
} out bool is {
    if pid != ctx.strTid then return false
    if (
        typing.declOwnershipIs
        parentTypeId: fid
        nameId: pnameId
        own: ztypes.zparamownership.borrowMode
    ) then return true
    if (
        typing.declOwnershipIs
        parentTypeId: fid
        nameId: pnameId
        own: ztypes.zparamownership.viewMode
    ) then return true
    return false
}

# isSetMapPtrParam -- a Set/Map param, WHATEVER its ownership. Set/Map live on
# the heap and the value IS the pointer, so the param is passed BY POINTER
# (Set_t*) and its arg (a Set/Map local or field, also a pointer) is passed
# directly -- unlike a by-value List param which needs &.
#
# `.take` is not an exception: what it takes is the POINTER, and there is no
# by-value form of one of these to move. Excluding it declared the parameter as
# a struct while the body still read it with `->`, which gcc rejected.
isSetMapPtrParam: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    fid: ztypes.tid
    pnameId: zast.nameid
    tid: ztypes.tid
} out bool is {
    ast.drop
    fid.drop
    pnameId.drop
    # the param's own origin (a typedef wrapper chases to its base mono)
    # against the cached Set/Map template ids
    bt: chaseAggregateTypedef :reg :typing :ctx :tid
    return (isSetOriginOf :reg :ctx tid: bt) or (isMapOriginOf :reg :ctx tid: bt)
}

# isListPtrParam -- a non-TAKE List param (a value-struct collection) passes BY
# POINTER so the callee's append/pop/set persist to the caller. A `.take` List is
# moved by value; Set/Map monos are already heap pointers (no extra `*`).
isListPtrParam: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    fid: ztypes.tid
    pnameId: zast.nameid
    tid: ztypes.tid
} out bool is {
    if (paramTakesArg :typing :fid :pnameId) then return false
    bt: chaseAggregateTypedef :reg :typing :ctx :tid
    if (isIdCollectionOriginOf :reg :ctx tid: bt) then return true
    return (isListOriginOf :reg :ctx tid: bt)
}

# resetFnEmitState -- clear the per-FUNCTION emission state before a body is
# written. Every one of these tables is keyed by variable id and every id space
# restarts at the function boundary, so carrying one across would let a previous
# body's alias, narrowing or exclusion answer for a name in this one.
resetFnEmitState: function {ctx: Ctx} is {
    ctx.ptrVids = ListVal ztypes.vid
    ctx.aliases = List VidVal
    ctx.narrowBox = List VidVal
    ctx.aliasHeld = List AliasHeld
    ctx.narrowTid = List VidTid
    ctx.exclArms = List VidArms
    ctx.exclTids = List VidTid
}

# registerReftypeParams -- add a top-level function's reftype (class/union)
# params to ctx.ptrVids, so the body reads them as `param->field` and method
# calls pass them directly (they arrive as pointers). Caller resets ptrVids.
registerReftypeParams: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
    op: astnode.view
} is {
    pIds: ListVal ztypes.tid
    pNmIds: ListVal zast.nameid
    recFieldIds :reg :typing tid: fid ids: pIds nameIds: pNmIds
    ri: u64
    rn: pNmIds.length
    for ri < rn loop {
        rpid: pIds.get i: ri
        regp: paramTypeIsPointer :ast :reg :typing :ctx :fid pnameId: (pNmIds.get i: ri) pid: rpid
        if regp then {
            rvd: paramVidByNameId :ast :typing :op nameId: (pNmIds.get i: ri)
            ctx.ptrVids.append rvd
        }
        ri = ri + 1
    }
}

# paramIsReceiverName -- is `pname` the method's receiver slot? `this` for the
# `:this` shorthand, or the spelled name for `{a: this}`. The receiver is a
# pointer in BOTH families, so a call passing a value-typed one must address it.
# Call sites add this leg ALONE, never the whole definition-side predicate: a
# Map or Set argument is already a pointer and must not be addressed again.
paramIsReceiverName: function {
    reg: ztypes.ZTypeRegistry.view
    fid: ztypes.tid
    pnameId: zast.nameid
} out bool is {
    # by id, and only fall back to the spelling when the type records no
    # receiver name of its own -- `this` is the implicit one
    pid: pnameId
    if (reg.thisParamNameIs tid: fid nameId: pid) then return true
    if (reg.thisParamNameIdOf tid: fid).isZero then return pid == zast.wellKnown.slot.wkThis
    return false
}

# calleeTakesReceiverByPtr -- does this method's FIRST parameter occupy the
# receiver slot? Only then does a call address the base. A valtype method whose
# first parameter is an ordinary one of the same type (`double: function
# {self: meters}`) still takes it by value.
calleeTakesReceiverByPtr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    fid: ztypes.tid
} out bool is {
    fpN: List String
    fpI: ListVal ztypes.tid
    fpNm: ListVal zast.nameid
    recFieldLists :ast :reg :typing tid: fid names: fpN ids: fpI nameIds: fpNm
    if fpN.length == 0 then return false
    return (paramIsReceiverName :reg :fid pnameId: (fpNm.get i: 0))
}

# markedValtypeRefParam -- an explicitly marked VALTYPE parameter, which is a
# REFERENCE: `.borrow` so a write through it reaches the caller (passed by
# value the write was silently LOST), `.view` so a large value is not copied.
# An UNMARKED valtype parameter stays a copy: the marker is how a reference is
# asked for, and that is what holds this to the declarations that opt in.
#
# NATIVES are excluded -- their C is hand-written and takes the value by value.
# `Map.get key: key.view`, `Set.delete item: of.view` and `List.contains
# item: of.view` monomorphise that marker onto a valtype key, and the runtime
# templates would stop matching their own prototypes.
markedValtypeRefParam: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    fid: ztypes.tid
    pnameId: zast.nameid
    pid: ztypes.tid
} out bool is {
    if (reg.isNativeOf tid: fid) then return false
    if (reg.isValtypeOf tid: pid).not then return false
    if (
        typing.declOwnershipIs
        parentTypeId: fid
        nameId: pnameId
        own: ztypes.zparamownership.viewMode
    ) then return true
    if (
        typing.declOwnershipIs
        parentTypeId: fid
        nameId: pnameId
        own: ztypes.zparamownership.borrowMode
    ) then return true
    return false
}

# paramTakesArg -- whether the parameter `pname` of `fid` takes ownership of
# its argument: a `.take`, or a `.hold`, which is moved in as `.take` is and
# then frozen. Readonly is the checker's to enforce, so the two pass, and are
# destroyed, alike.
paramTakesArg: function {
    typing: ztyping.ZTyping.view
    fid: ztypes.tid
    pnameId: zast.nameid
} out bool is {
    if (
        typing.declOwnershipIs
        parentTypeId: fid
        nameId: pnameId
        own: ztypes.zparamownership.takeMode
    ) then return true
    return (
        typing.declOwnershipIs
        parentTypeId: fid
        nameId: pnameId
        own: ztypes.zparamownership.holdMode
    )
}

# paramTypeIsPointer -- is a parameter's C type `T*`? A non-owning user class
# passes by reference, and the stdlib families answer separately because
# isReftypeParam deliberately covers user classes only.
#
# This is the DEFINITION-side question. Whether a CALL must write `&arg` is a
# DIFFERENT one and has its own answer at each call site: a Map or Set local
# already holds a pointer (their create returns one), so taking its address
# would build a `T**`, while a List local is a value and does need the `&`.
paramTypeIsPointer: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
    pnameId: zast.nameid
    pid: ztypes.tid
} out bool is {
    # a data value is a pointer already, and is passed as one
    if (isStaticHandle :reg :typing tid: pid) then return false
    owns: paramTakesArg :typing :fid :pnameId
    # The receiver is a reference in BOTH families -- its default is `borrow`,
    # not `take`, so a record method acts on the caller's instance rather than
    # on a copy of it.
    if owns.not then {
        rnid: pnameId
        if rnid == zast.wellKnown.slot.wkThis then return true
        if rnid.notZero when (reg.thisParamNameIs tid: fid nameId: rnid) then return true
    }
    if owns.not when (markedValtypeRefParam :reg :typing :fid :pnameId :pid) then return true
    if owns.not when (isReftypeParam :reg :typing :ctx tid: pid) then return true
    if (isBorrowStringParam :typing :ctx :fid :pnameId :pid) then return true
    if (isListPtrParam :reg :typing :ctx :fid :pnameId tid: pid) then return true
    if (isSetMapPtrParam :ast :reg :typing :ctx :fid :pnameId tid: pid) then return true
    return false
}

# fnReturnPointerC -- how a non-void return is passed back: a heap collection by
# pointer, a ref-borrow by the borrow's pointer form.
fnReturnPointerC: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
    ret: StringView
} out String is {
    retColId: fnReturnTidOf :reg tid: fid
    retC: ret.string
    if retColId.notZero when (
        isHeapPtrCollection
        :reg
        :typing
        :ctx
        tid: retColId
    ) then retC = "\{ret}*"
    if (fnReturnsRefBorrow :reg :typing :ctx :fid retTid: retColId) then {
        retP: refPtrC :typing tid: fid base: retC.stringView
        retC = retP.take
    }
    return retC
}

# fnReturnC -- a user function's C return type: what its type records it
# returns, `void` when it returns nothing. The pointer forms apply last.
fnReturnC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
} out String is {
    rt: fnReturnTidOf :reg tid: fid
    if rt.isZero then return "void".string
    ret: typeRefC :ast :reg :typing :ctx tid: rt
    if ret.length == 0 then return "void".string
    return (fnReturnPointerC :reg :typing :ctx :fid ret: ret.stringView)
}

# paramReadsOnly -- a parameter passed by reference that the function only
# reads: a view, or a choice value, which nothing changes.
paramReadsOnly: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    fid: ztypes.tid
    pnameId: zast.nameid
    pid: ztypes.tid
} out bool is {
    if (reg.isStaticOf tid: (canonTypeId :reg :typing tid: pid)) then return true
    return (
        typing.declOwnershipIs
        parentTypeId: fid
        nameId: pnameId
        own: ztypes.zparamownership.viewMode
    )
}

# paramCType -- one parameter's C type: the pointer form where the parameter is
# passed by reference, const-qualified when it is a view, because a view is read
# through and never written through and the C has to say so -- the runtime
# readers it reaches take const too, so a writer reached through a view is
# refused by the C compiler.
paramCType: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
    pnameId: zast.nameid
    pid: ztypes.tid
} out String is {
    ct: typeRefC :ast :reg :typing :ctx tid: pid
    if (paramTypeIsPointer :ast :reg :typing :ctx :fid :pnameId :pid).not then return ct
    if ct.length == 0 then return ct
    if (paramReadsOnly :reg :typing :fid :pnameId :pid) then return "const \{ct}*"
    return "\{ct}*"
}

# fnParamsC -- a user function's C parameter list, "void" when it takes none.
fnParamsC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
    op: astnode.view
} out String is {
    params: String
    cIds: ListVal ztypes.tid
    cNmIds: ListVal zast.nameid
    recFieldIds :reg :typing tid: fid ids: cIds nameIds: cNmIds
    pi: u64
    pn: cNmIds.length
    for pi < pn loop {
        pnmId: cNmIds.get i: pi
        ct: paramCType :ast :reg :typing :ctx :fid pnameId: pnmId pid: (cIds.get i: pi)
        if pi > 0 then params.append ", "
        if ct.length > 0 then {
            params.append ct
        } else {
            params.append "int64_t"
        }
        params.append " "
        pmnV: paramVidByNameId :ast :typing :op nameId: pnmId
        pmnDecl: varCName :ctx :ast :reg vid: pmnV
        params.append pmnDecl
        pi = pi + 1
    }
    if pn == 0 then params.append "void"
    return params
}

# fnSignature -- "RET cname(PARAMS)" for a user function from its
# resolved type's children and return stamp (z_main for main).
fnSignature: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
    op: astnode.view
} out String is {
    if (isEntryMain :typing :ctx :fid) then return "void z_main(void)".string
    ret: fnReturnC :ast :reg :typing :ctx :fid
    params: fnParamsC :ast :reg :typing :ctx :fid :op
    fc: ctxCnameView :ctx tid: fid
    sig: "\{ret} \{fc}(\{params})"
    return sig
}

# isEntryMain -- `fid` is the program's entry point: the `main` the main unit
# itself declares. A function of that name anywhere else -- a namespace's, a
# type's -- is an ordinary function and keeps its own signature.
isEntryMain: function {typing: ztyping.ZTyping.view ctx: Ctx.view fid: ztypes.tid} out bool is {
    em: entryMainTid :typing :ctx
    if em.isZero then return false
    return em == fid
}

# appendFnSignature -- fnSignature's text appended to `buf`, then `tail` (";\n"
# for a declaration, " {\n" for a definition). Built once per function: every
# function's forward declaration and its definition ask for the same text.
appendFnSignature: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
    op: astnode.view
    buf: String.borrow
    tail: StringView
} is {
    hit: false
    {
        got: ctx.fnSigs.get key: fid
        if got.some then {
            buf.append got
            hit = true
        }
    }
    if hit.not then {
        sig: fnSignature :ast :reg :typing :ctx :fid :op
        buf.append sig
        ctx.fnSigs.set key: fid value: sig.take
    }
    buf.append tail
}

# typedefChaseBaseName -- the chain-end base NAME of a typedef, "" when tid
# is not one.
typedefChaseBaseName: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
} out String is {
    cur: tid
    nmId: zast.nameid
    for true loop {
        b: typing.typedefBase.get key: cur
        if b.none then break
        if b.name.notZero then nmId = b.name
        if b.tid.isZero then break
        cur = b.tid
    }
    nm: String
    if nmId.notZero then nm = zast.poolTextCopy pool: ast.names ref: nmId
    return nm
}

# typedefChaseHasBaseName -- whether typedefChaseBaseName would name anything,
# asked without copying the name.
typedefChaseHasBaseName: function {typing: ztyping.ZTyping.view tid: ztypes.tid} out bool is {
    cur: tid
    for true loop {
        b: typing.typedefBase.get key: cur
        if b.none then return false
        if b.name.notZero then return true
        if b.tid.isZero then return false
        cur = b.tid
    }
    return false
}

# typedefChaseC -- the underlying C scalar of a typedef record, chasing
# the typedef-base chain (meters -> i64, height -> meters -> i64); ""
# when the type is not a typedef.
typedefChaseC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} out String is {
    bid: ztypecheck.typedefChaseTid :typing :tid
    if bid == tid then return "".string
    bc: scalarCTypeFor :typing tid: bid
    if bc.length > 0 then return bc
    return (typeRefC :ast :reg :typing :ctx tid: bid)
}

# isTypedefType -- the type id carries a typedef base.
isTypedefType: function {typing: ztyping.ZTyping.view tid: ztypes.tid} out bool is {
    return (typing.typedefBase.has key: tid)
}

# destroyOperand -- what a value's destroy is handed: its address, or the value
# itself where it already IS the pointer the destroy frees (valueIsItsPointer).
destroyOperand: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
    nm: StringView
} out String is {
    if (valueIsItsPointer :reg :typing :ctx :tid) then return nm.string
    return "&\{nm}"
}

# valueIsItsPointer -- a value of tid is held as a pointer: a box, and a Set or
# Map, which live on the heap and are freed through it, and a data value, a
# handle to static storage that nothing frees.
valueIsItsPointer: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    if (isStaticHandle :reg :typing :tid) then return true
    return (reg.isBoxOf :tid) or (isHeapPtrCollection :reg :typing :ctx :tid)
}

# isStaticHandle -- a value of tid is a data value: a `const` pointer to the
# static object the compiler built, copied as the pointer and read through it.
# A choice is static too, but held by value, as a variant is.
isStaticHandle: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
} out bool is {
    if tid.isZero then return false
    ct: canonTypeId :reg :typing :tid
    if (reg.isStaticOf :tid).not when (reg.isStaticOf tid: ct).not then return false
    return (reg.typetypeOf typeId: ct) == ztypes.ztypetype.recordType
}

# nodeIsAtomBox -- n is a bare atom whose type is a builtin Box (a heap pointer),
# so an arithmetic/compare operand must auto-deref (`b` -> `(*b)`).
#
# The stamp is asked first and then CANONICALISED, because a PARAMETER's type is
# a fresh shell id named after the real one: a Box local answered here and a Box
# parameter did not, so `b + 0` added one to an address and `b == 7` compared
# the address. typeRefC canonicalises before the same question for the same
# reason.
nodeIsAtomBox: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    n: astnode.view
} out bool is {
    match (
        n
    ) case atomid then {
        bxt: stampIdOf :typing nid: n.nodeid
        if (reg.isBoxOf tid: bxt) then return true
        if bxt.isZero then return false
        bxc: ztypes.tid
        bxc = canonTypeId :reg :typing tid: bxt
        if bxc.isZero then return false
        return (reg.isBoxOf tid: bxc)
    } else {
        return false
    }
}

# originFamilyOf -- the origins table read backwards: which `family` element an
# ORIGIN tid names, or noFamily. Zero is no family -- a builtin the program never
# registers leaves its row 0, and matching that would make every origin-less
# type a List.
originFamilyOf: function {ctx: Ctx.view originTid: ztypes.tid} out u64 is {
    if originTid.isZero then return noFamily
    i: u64
    for i < noFamily loop {
        if originTid == (ctx.origins.get :i) then return i
        i = i + 1
    }
    return noFamily
}

# monoFamilyOf -- the family a MONO was minted from, or noFamily. Every predicate
# below asks exactly this and differs only in which answers it accepts.
monoFamilyOf: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
} out u64 is {
    ot: originTidOf :reg :tid
    return (originFamilyOf :ctx originTid: ot)
}

# isListOriginOf -- the type is a List of EITHER family. The two templates
# differ in what they DECLARE (a valtype element copies out, a reftype element
# hands back a view) and not at all in the C the emitter builds from them, so
# every site that just means "is this a List" asks this rather than naming one.
isListOriginOf: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :reg :ctx :tid
    return (f == family.slot.listRef) or (f == family.slot.listVal)
}

# isSetOriginOf -- the type is a Set of EITHER family. The two templates differ
# in what they DECLARE (a valtype element is passed and returned by value, a
# reftype element is taken and viewed) and not at all in the C the emitter
# builds from them, so every site that just means "is this a Set" asks this
# rather than naming one.
isSetOriginOf: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :reg :ctx :tid
    return (f == family.slot.set) or (f == family.slot.setVal)
}

# isMapOriginOf -- the type is a Map of ANY of the four key/value families.
isMapOriginOf: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :reg :ctx :tid
    return (
        (f == family.slot.map) or
        (f == family.slot.mapRV) or
        (f == family.slot.mapVR) or
        (f == family.slot.mapVV)
    )
}

# isIdMapOriginOf -- the type is an IdMap of either value family.
isIdMapOriginOf: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :reg :ctx :tid
    return (f == family.slot.idMapR) or (f == family.slot.idMapV)
}

# isIdSetOriginOf -- the type is an IdSet.
isIdSetOriginOf: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :reg :ctx :tid
    return f == family.slot.idSet
}

# isIdCollectionOriginOf -- the type is an IdMap or an IdSet: the id-keyed
# containers, which share a representation the general ones do not.
isIdCollectionOriginOf: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :reg :ctx :tid
    return (f == family.slot.idMapR) or (f == family.slot.idMapV) or (f == family.slot.idSet)
}

# isViewUnionOriginOf -- the type is a view union: an OptionView or an
# OptionMut, of either element family, or a StaticView. The five templates
# differ only in their bound and in what their arm lets the holder do, and share
# one C layout. Their five rows are ADJACENT in `family`, optionView first and
# staticView last, so the test is the span between them.
isViewUnionOriginOf: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :reg :ctx :tid
    if f < family.slot.optionView then return false
    return f <= family.slot.staticView
}

# isListViewOriginOf -- the type is a ListView of either element family.
isListViewOriginOf: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :reg :ctx :tid
    return (f == family.slot.listView) or (f == family.slot.listViewVal)
}

# isMapEntryOriginOf -- the type is a MapEntry of any of the four families.
isMapEntryOriginOf: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :reg :ctx :tid
    if (f == family.slot.mapEntry) or (f == family.slot.mapEntryRV) then return true
    return (f == family.slot.mapEntryVR) or (f == family.slot.mapEntryVV)
}

# isIdMapEntryOriginOf -- the type is an IdMapEntry of either value family.
isIdMapEntryOriginOf: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    f: monoFamilyOf :reg :ctx :tid
    return (f == family.slot.idMapEntryR) or (f == family.slot.idMapEntryV)
}

# isCollectionOriginTid -- originTid (a genericOriginId) is one of the cached
# collection/iterator origins, i.e. a template that mints a C struct type
# (List/ListView/Set/Map/MapEntry and the iterators).
#
# The table has three zones and this is the MIDDLE one: family.slot.str and family.slot.fixedArray
# precede it, the option/result families follow it. Moving a row across either
# bound changes what counts as a collection, silently -- which is why the two
# bounds are named here rather than a membership list being written out again.
isCollectionOriginTid: function {ctx: Ctx.view originTid: ztypes.tid} out bool is {
    f: originFamilyOf :ctx :originTid
    if f == noFamily then return false
    if f < family.slot.listRef then return false
    return f < family.slot.option
}

# cTypeForNameTid -- the C type a collection mono's element or key slot spells: a
# builtin scalar spells as its C scalar (scalarCTypeFor, which also asks the
# declaration, so a user type wearing a scalar's name is not one); everything
# else -- a user type, a mono, a stdlib class -- spells from its id. A native
# collection instance is native but no scalar, and its composed name resolves
# to nothing. For collection-mono VAL_T/KEY_T/ELEM_T where the
# element/key/value tid is known.
cTypeForNameTid: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} out String is {
    sc: scalarCTypeFor :typing :tid
    if sc.length > 0 then return sc
    return (slotCType :ast :reg :typing :ctx :tid)
}

# slotCType -- the C type a container stores a `tid` value as: its C type, and a
# pointer for a heap collection (a Set or a Map), whose value IS that pointer
# wherever it is held -- a local, a field, a parameter, an element.
slotCType: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} out String is {
    ct: typeRefC :ast :reg :typing :ctx :tid
    if (isHeapPtrCollection :reg :typing :ctx :tid) then ct.append "*"
    return ct
}

# chaseAggregateTypedef -- the end of tid's typedef chain when that end is an
# aggregate: a collection mono (Bytes -> List_u8, ByteView -> ListView_u8) or
# a user record, class, union, variant or protocol (BoxAlias -> Box). The
# emitter treats such a typedef as a zero-overhead alias: it shares the end's
# struct, methods and cleanup. tid itself for no typedef, or a chain ending
# in a scalar (emitted as that scalar) or a String (chaseStrTypedef's).
chaseAggregateTypedef: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
} out ztypes.tid is {
    if (typing.typedefBase.has key: tid).not then return tid
    e: ztypecheck.typedefChaseTid :typing :tid
    if (e == ctx.strTid) or (e == ctx.svTid) then return tid
    # a scalar is a native record, and an ordinal variant emits as one; a
    # sized str or array is a native record too, and an aggregate
    isRec: (reg.typetypeOf typeId: e) == ztypes.ztypetype.recordType
    if isRec when (reg.isNativeOf tid: e) then {
        eo: originTidOf :reg tid: e
        strO: ctx.origins.get i: family.slot.str
        arrO: ctx.origins.get i: family.slot.fixedArray
        isSized: (eo == strO) or (eo == arrO)
        if isSized.not or eo.isZero then return tid
    }
    if (isOrdinalVariant :typing tid: e) then return tid
    return e
}

# typedefMethodOwner -- the type a call of method `mn` on a value of `tid`
# resolves on: the first link of tid's typedef chain that declares the method
# with a body -- a typedef's own method -- else the chain's end, an aggregate
# (chaseAggregateTypedef) or a String (chaseStrTypedef), which the typedef
# shares every other member with. A typedef's NATIVE member (Bytes.byteView)
# has no C of its own: the runtime serves it as the end's.
typedefMethodOwner: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
    # the method's name
    mnId: zast.nameid
} out ztypes.tid is {
    if (typing.typedefBase.has key: tid).not then return tid
    t: tid
    for t.notZero loop {
        mo: typing.declChildOfId parentTypeId: t nameId: mnId
        if mo.some when (reg.isNativeOf tid: mo).not then return t
        bo: typing.typedefBaseTidOf tid: t
        if bo.isZero then break
        t = bo
    }
    return (chaseStrTypedef :typing :ctx tid: (chaseAggregateTypedef :reg :typing :ctx :tid))
}

# chaseStrTypedef -- a typedef over String/StringView (Path, PathView),
# through any number of typedefs, canonicalizes to the base tid: the wrapper
# shares the base's struct, methods, and cleanup.
chaseStrTypedef: function {
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
} out ztypes.tid is {
    if (typing.typedefBase.has key: tid).not then return tid
    e: ztypecheck.typedefChaseTid :typing :tid
    if (e == ctx.strTid) or (e == ctx.svTid) then return e
    return tid
}

# literalTypeC -- the C type a literal's pseudo-type is held as at run time,
# in a data value's field: an untyped number is an i64 or an f64, and a string
# the view it reads as. "" for any other type.
literalTypeC: function {reg: ztypes.ZTypeRegistry.view ctx: Ctx tid: ztypes.tid} out String is {
    if tid == reg.literalIntTid then return "int64_t".string
    if tid == reg.literalFloatTid then return "double".string
    if tid == reg.literalTextTid then return (svTypeC :ctx)
    return "".string
}

# svTypeC -- StringView's C type, spelled where C is written: the spelling
# records the typedef piece it names, so no spelling goes without it.
svTypeC: function {ctx: Ctx} out String is {
    preludeNeed :ctx memb: "@StringView_t"
    return "\{ctx.svC}_t"
}

# strTypeC -- String's C type, spelled as svTypeC spells StringView's.
strTypeC: function {ctx: Ctx} out String is {
    preludeNeed :ctx memb: "@String_t"
    return "\{ctx.strC}_t"
}

# typeRefC -- the C spelling for a type id: scalars by name, records by
# their id-based cname ("" when unsupported).
typeRefC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} out String is {
    # canonicalize shells: a param/field child may be a fresh shell id
    # named after the real type; this-typed params take the receiver.
    cid: tid
    # the name is compared twice and kept by nobody, so it is borrowed. The
    # binding is scoped: the pin must not outlive the two questions it answers
    {
        # A user type shadowing a builtin scalar carries the scalar NAME but not
        # the `is native` declaration -- emit its struct, not the C scalar.
        # scalarCTypeFor is that gate, and the sixteen scalars, `bool` and the
        # shells all come back through it with their C type intact.
        ct: scalarTypeRefC :typing :ctx :tid
        if ct.length > 0 then return ct
    }
    lc: literalTypeC :reg :ctx :tid
    if lc.length > 0 then return lc
    cmid: chaseAggregateTypedef :reg :typing :ctx tid: cid
    if cmid != cid then {
        noteTypeUse :ctx tid: cmid
        cmc: spelledCname :ctx tid: cmid
        return "\{cmc}_t"
    }
    cid = chaseStrTypedef :typing :ctx tid: cid
    tdc: typedefChaseC :ast :reg :typing :ctx tid: cid
    if tdc.length > 0 then return tdc
    if cid == ctx.strTid then return (strTypeC :ctx)
    # text is one C type with StringView (isViewLaid), and its typedef is
    # the same piece
    if (isViewLaid :ctx tid: cid) then return (svTypeC :ctx)
    if (reg.isBoxOf tid: cid) then {
        # spelled as its element's pointer, and destroyed through its own
        noteTypeUse :ctx tid: cid
        bxeid: reg.genericTypeArgAt specId: cid ordinal: 0
        bxinner: typeRefC :ast :reg :typing :ctx tid: bxeid
        return "\{bxinner}*"
    }
    if (isCollectionOriginTid :ctx originTid: (originTidOf :reg tid: cid)) then {
        noteTypeUse :ctx tid: cid
        cc: ctxCnameView :ctx tid: cid
        cTypeText: "\{cc}_t"
        return cTypeText
    }
    if (originIsTid :reg tid: cid originTid: (ctx.origins.get i: family.slot.fixedArray)) then {
        noteTypeUse :ctx tid: cid
        aca: ctxCnameView :ctx tid: cid
        act: "\{aca}_t"
        return act
    }
    ctt: reg.typetypeOf typeId: cid
    # every user type family spells its C type the same way -- the struct tag
    # the emitter minted for it -- so the kind decides only whether there is a
    # struct at all. A function type is the one that spells a different suffix,
    # because what it names is a function-pointer typedef and not a struct.
    isUserStruct: ctt.isUserFamily
    if isUserStruct then {
        noteTypeUse :ctx tid: cid
        rc: ctxCnameView :ctx tid: cid
        # a data value is a handle to its static object
        if (isStaticHandle :reg :typing tid: cid) then return "const \{rc}_t*"
        rt: "\{rc}_t"
        return rt
    }
    if ctt == ztypes.ztypetype.functionType then {
        noteFnptrUse :ctx tid: cid
        rcf: ctxCnameView :ctx tid: cid
        rtf: "\{rcf}_ft"
        return rtf
    }
    return "".string
}

# noteFnptrUse -- a C spelling of the function type `tid` (its `_ft` typedef):
# before the typedef pass it is a demand the pass answers; after it, the
# typedef must be one the pass wrote, or the C names a type that does not exist.
noteFnptrUse: function {ctx: Ctx tid: ztypes.tid} is {
    if ctx.fnptrPassDone.not then {
        ctx.fnptrDemand.add item: tid
        return
    }
    if (ctx.fnptrWritten.has item: tid) then return
    (
        emitFail
        :ctx
        what: "a function type spelled after its typedefs were written, and not among them".string
        line: 0
    )
}

# scalarTypeRefC -- the C scalar a type is held as, "" for one held otherwise.
# An ordinal variant is held as a scalar: spelling it names neither its enum
# nor its type (a value of it spells a tag constant, spelledTagConst).
scalarTypeRefC: function {typing: ztyping.ZTyping.view ctx: Ctx tid: ztypes.tid} out String is {
    ct: scalarCTypeFor :typing :tid
    if ct.length > 0 then noteScalarTypeUse :typing :ctx :tid
    return ct
}

# noteScalarTypeUse -- a C spelling of the scalar `tid`: the 128-bit integers'
# and f16's C types are prelude pieces, written where something spells them
noteScalarTypeUse: function {typing: ztyping.ZTyping.view ctx: Ctx tid: ztypes.tid} is {
    nk: ztypecheck.numKindOfTid :typing :tid
    if nk.has.not then return
    if nk.kind == ztypes.numkind.i128Type then preludeNeed :ctx memb: "@i128_t"
    if nk.kind == ztypes.numkind.u128Type then preludeNeed :ctx memb: "@u128_t"
    if nk.kind == ztypes.numkind.f16Type then preludeNeed :ctx memb: "@f16_t"
}

# noteTypeUse -- a C spelling of the struct type `tid`: before the reached set is
# closed it is a use the set starts from; after, the type must be one the set
# holds, or the C names a struct that is never written.
noteTypeUse: function {ctx: Ctx tid: ztypes.tid} is {
    if ctx.reachFixed.not then {
        if ctx.typeUseHold then {
            ctx.heldTypeUses.append tid
            return
        }
        ctx.typeUses.add item: tid
        return
    }
    if (ctx.reachedTypes.has item: tid) then return
    cn: ctxCname :ctx :tid
    (
        emitFail
        :ctx
        what: "type \{cn} spelled after the reached types were fixed, and not among them"
        line: 0
    )
}

# closeReachedTypes -- fix the struct types the program's C needs: each one
# the generated code spelled, and what each of those spells in turn. It runs
# once, after every function, method body and runtime fragment is generated and
# before the first type is written; a type outside the set is not written.
closeReachedTypes: function {
    ast: Ast.view reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx
} is {
    todo: ListVal ztypes.tid
    for each u: ctx.typeUses loop todo.append u
    drainReach :reg :typing :ctx :todo
    # an ordinal variant reached only through its tag constants is written as
    # its enum alone
    for each o: ctx.ordinalTagUses loop {
        if (ctx.reachedTypes.has item: o).not then {
            ctx.reachedTypes.add item: o
            ctx.tagOnlyTypes.add item: o
        }
    }
    ctx.reachFixed = true
    demandTemplateEqs :ast :reg :typing :ctx
    demandWrittenDestroys :reg :typing :ctx
}

# closeTmplDestroys -- what each templated class instance's kept sections free:
# a destroy hole a section spells is a destroy use -- `@@P<k>_DESTROY@@` or
# `@@<P>_DESTROY@@` of the k-th type argument, `z_@@ARG.<m>.<p>@@_destroy` or
# `z_@@OUT.<m>@@_destroy` of the type the hole names (tmplHoleType). A use may
# keep another instance's destroy section, so the walk repeats until no member
# use is added. It runs before any type is written: the instances' text is
# written later, when a destructor first called there names one never written.
closeTmplDestroys: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
} is {
    seen: ctx.memberUses.length + 1
    for seen != ctx.memberUses.length loop {
        seen = ctx.memberUses.length
        monos: ListVal ztypes.tid
        for each r: ctx.reachedTypes loop {
            if (tmplClassRowOf :reg :ctx tid: r) != 0 then monos.append r
        }
        for each m: monos loop tmplSectionDestroys :ast :reg :typing :ctx mono: m
    }
}

# tmplSectionDestroys -- closeTmplDestroys for one instance `mono`: its
# template's text as rtSectionPlan keeps it -- what is outside every section,
# and each kept section -- its destroy holes noted.
tmplSectionDestroys: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    mono: ztypes.tid
} is {
    row: tmplClassRowOf :reg :ctx tid: mono
    tf: (ctx.classRows.get i: row - 1).tmpl.copy
    p: tmplKey :ctx name: tf.stringView
    ti: tmplTextOf :ctx key: p
    if (rtEmpty :ctx id: ti) then return
    pNames: List String
    pTids: ListVal ztypes.tid
    (
        templateParamArgs
        :ast
        :reg
        :typing
        template: (originTidOf :reg tid: mono)
        :mono
        names: pNames
        tids: pTids
    )
    plan: rtKeptPlan :ctx :mono id: ti
    hits: ListVal ztypes.tid
    destroyKeyTypes :ast :reg :typing :ctx inst: mono :plan :pNames :pTids acc: hits
    for each t: hits loop {
        dt: destroyTargetTid :reg :typing :ctx tid: t
        if dt.notZero when dt != ctx.strTid then noteDestroyUse :reg :typing :ctx tid: dt
    }
}

# destroyKeyTypes -- the types whose destructor the text plan `plan` writes
# names through a key: `@@P_DESTROY@@` a parameter's, `@@X@@_destroy` the type
# the key X names (tmplHoleType)
destroyKeyTypes: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    inst: ztypes.tid
    plan: RtPlan.view
    pNames: (List String).view
    pTids: (ListVal ztypes.tid).view
    acc: ListVal ztypes.tid
} is {
    rt: ctx.rt
    t: rt.texts.get i: plan.id
    tv: t.stringView
    inf: rt.infos.get i: plan.id
    k: inf.segFrom
    for k < inf.segTo loop {
        sg: rt.segs.get i: k
        k = k + 1
        if sg.kind.key.not or (rtPlanWrites :ctx :plan at: sg.from).not then continue
        hole: tv.substring from: sg.from + 2 to: sg.to - 2
        if (hole.endsWith suffix: "_DESTROY") then {
            pa: holeParamArg :pNames :pTids name: (hole.substring from: 0 to: hole.length - 8)
            if pa.notZero then acc.append pa
        } else if k < inf.segTo when (rtStartsLiteral :ctx :plan at: k prefix: "_destroy") then {
            ht: tmplHoleType :ast :reg :typing :ctx :inst :hole
            if ht.notZero then acc.append ht
        }
    }
}

# rtStartsLiteral -- stretch `at` of plan `plan`'s text is a written literal
# starting with `prefix`
rtStartsLiteral: function {ctx: Ctx.view plan: RtPlan.view at: u64 prefix: StringView} out bool is {
    sg: ctx.rt.segs.get i: at
    if sg.kind.literal.not or (rtPlanWrites :ctx :plan at: sg.from).not then return false
    t: ctx.rt.texts.get i: plan.id
    return ((t.stringView.substring from: sg.from to: sg.to).startsWith :prefix)
}

# holeParamArg -- the argument bound to the type parameter a hole names, by its
# name or by position (`P<k>`); 0 for a name no parameter has
holeParamArg: function {
    pNames: (List String).view
    pTids: (ListVal ztypes.tid).view
    name: StringView
} out ztypes.tid is {
    k: u64
    for k < pNames.length loop {
        byPos: "P\{k}"
        if ((pNames.get i: k).stringView == name) or (byPos.stringView == name) then return (
            pTids.get
            i: k
        )
        k = k + 1
    }
    return ztypes.tid.zero
}

# demandWrittenDestroys -- the destructors written whatever calls them call
# their parts': every reached type's that is not gated (destroyGated: an
# instance of List, Box or a templated class), and the impl of each owned
# protocol box written C makes (emitImplementationImpl's `_owned_destroy`).
demandWrittenDestroys: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx
} is {
    rs: ListVal ztypes.tid
    for each r: ctx.reachedTypes loop rs.append r
    for each m: rs loop {
        if (destroyGated :reg :ctx tid: m).not when (destroyTargetTid :reg :typing :ctx tid: m
        ).notZero then {
            noteDestroyUse :reg :typing :ctx tid: m
        }
    }
    impls: ListVal ztypes.tid
    ri: ztypes.confid
    for ri.next < typing.nextConf loop {
        ri = ri.next
        row: typing.implementation.get i: ri
        k: ownedBoxKey implTid: row.implTypeId protoTid: row.specTypeId
        if (ctx.ownedBoxUses.has item: k) then impls.append row.implTypeId
    }
    for each nb: ctx.nativeBoxes loop {
        k: ownedBoxKey implTid: nb.impl protoTid: nb.proto
        if (ctx.ownedBoxUses.has item: k) then impls.append nb.impl
    }
    for each impl: impls loop {
        dt: destroyTargetTid :reg :typing :ctx tid: impl
        if dt.notZero when dt != ctx.strTid then noteDestroyUse :reg :typing :ctx tid: dt
    }
}

# demandTemplateEqs -- the generated `==` each reached container's template
# calls on its elements (templateEqElem), written into the container after
# the element's own struct.
demandTemplateEqs: function {
    ast: Ast.view reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx
} is {
    rs: ListVal ztypes.tid
    for each r: ctx.reachedTypes loop rs.append r
    for each m: rs loop {
        el: templateEqElem :reg :typing :ctx tid: m
        if el.notZero when (reg.isValtypeOf tid: el) when (
            partEqCallsGenerated
            :ast
            :reg
            :typing
            tid: el
        ) then noteEqUse :ast :reg :typing :ctx tid: el
    }
}

# templateEqElem -- the element a container's template compares with the
# element's own `==`: a Set's or Map's value-type key (valKeyEqBody), and a
# list's element when its `contains`, `==` or `!=` is used; 0 for any other
# type.
templateEqElem: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx tid: ztypes.tid
} out ztypes.tid is {
    if (isListOriginOf :reg :ctx :tid) then {
        compares: (
            (memberUsed :ctx mono: tid member: memberWord.slot.contains) or
            (memberUsed :ctx mono: tid member: memberWord.slot.eq)
        )
        if compares then return (listElemType :reg :typing monoId: tid)
        return ztypes.tid.zero
    }
    el: ztypes.tid
    if (isSetOriginOf :reg :ctx :tid) then el = setElemType :typing monoId: tid
    if (isMapOriginOf :reg :ctx :tid) then el = mapKeyType :typing monoId: tid
    if el.isZero then return el
    if (isValKey :reg key: el kind: (keyHashKind :reg :typing :ctx tid: el)
    ).not then return ztypes.tid.zero
    if (keyEqSpelled :reg :ctx :tid).not then return ztypes.tid.zero
    return el
}

# keyEqSpelled -- the Set or Map instance `tid` compares its keys in the text
# it is written with: a member whose section does (a lookup) is used, so the
# key's `==` is called
keyEqSpelled: function {reg: ztypes.ZTypeRegistry.view ctx: Ctx tid: ztypes.tid} out bool is {
    if (ctx.keyEqKept.has item: tid) then return true
    if ((ctx.keyEqNoAt.get key: tid).or d: 0) == (ctx.memberUses.length + 1) then return false
    sp: false
    if (isSetOriginOf :reg :ctx :tid) then sp = (
        tmplKeptSpells
        :ctx
        mono: tid
        file: "Set"
        key: "EQ_BODY"
    )
    if (isMapOriginOf :reg :ctx :tid) then {
        sp = tmplKeptSpells :ctx mono: tid file: "Map" key: "KEYS_EQUAL_BODY"
    }
    if sp then {
        ctx.keyEqKept.add item: tid
    } else {
        ctx.keyEqNoAt.set key: tid value: ctx.memberUses.length + 1
    }
    return sp
}

# keyHashSpelled -- keyEqSpelled for the key's `hash`
keyHashSpelled: function {reg: ztypes.ZTypeRegistry.view ctx: Ctx tid: ztypes.tid} out bool is {
    if (ctx.keyHashKept.has item: tid) then return true
    if ((ctx.keyHashNoAt.get key: tid).or d: 0) == (ctx.memberUses.length + 1) then return false
    sp: false
    if (isSetOriginOf :reg :ctx :tid) then sp = (
        tmplKeptSpells
        :ctx
        mono: tid
        file: "Set"
        key: "HASH_BODY"
    )
    if (isMapOriginOf :reg :ctx :tid) then {
        sp = tmplKeptSpells :ctx mono: tid file: "Map" key: "HASH_KEY_BODY"
    }
    if sp then {
        ctx.keyHashKept.add item: tid
    } else {
        ctx.keyHashNoAt.set key: tid value: ctx.memberUses.length + 1
    }
    return sp
}

# tmplKeptSpells -- instance `mono`'s template `file`, as rtSectionPlan keeps it
# for the member uses so far, spells the key `key`: in the text outside every
# section, or in a kept one
tmplKeptSpells: function {ctx: Ctx mono: ztypes.tid file: StringView key: StringView} out bool is {
    p: tmplKey :ctx name: file
    plan: rtKeptPlan :ctx :mono id: (tmplParsed :ctx key: p)
    return (rtPlanSpells :ctx :plan name: key)
}

# reachSoFar -- the reached set closed over what has been spelled so far,
# without fixing it.
reachSoFar: function {reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx} is {
    todo: ListVal ztypes.tid
    for each u: ctx.typeUses loop todo.append u
    drainReach :reg :typing :ctx :todo
}

# drainReach -- add each type on `todo` to the reached set, and what it spells.
drainReach: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx todo: ListVal ztypes.tid
} is {
    for todo.length > 0 loop {
        t: todo.pop
        if (ctx.reachedTypes.has item: t) then continue
        ctx.reachedTypes.add item: t
        at: todo.length
        typeReachEdges :reg :typing :ctx tid: t acc: todo
        keepReachEdges :typing reached: ctx.reachedTypes :todo from: at
    }
}

# keepReachEdges -- drop from `todo`, past `from`, the edges a closure does not
# follow: none, one already reached, and an ordinal variant, which is spelled as
# its C scalar wherever another type holds one: it is reached only by its own
# name or its tag constants.
keepReachEdges: function {
    typing: ztyping.ZTyping.view
    reached: (IdSet ztypes.tid).view
    todo: ListVal ztypes.tid
    from: u64
} is {
    w: from
    k: from
    for k < todo.length loop {
        n: todo.get i: k
        k = k + 1
        if n.isZero or (reached.has item: n) or (isOrdinalVariant :typing tid: n) then continue
        todo.set i: w val: n
        w = w + 1
    }
    for todo.length > w loop todo.pop
}

# typeReached -- the type is one the program's C spells, so it is written.
typeReached: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    return (ctx.reachedTypes.has item: tid)
}

# typeReachEdges -- the types one written type's C spells: a mono's elements,
# keys, values and arm payloads, a declared type's fields or arm payloads, the
# signatures of the members written beside it, and what a container's
# templates spell.
typeReachEdges: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
    acc: ListVal ztypes.tid
} is {
    names: ListVal zast.nameid
    tt: reg.typetypeOf typeId: tid
    if tt == ztypes.ztypetype.unionType then {
        unionReachEdges :reg :typing :ctx :tid :acc
    } else if (originTidOf :reg :tid).notZero then {
        monoElemIdsOf :reg :typing :ctx monoId: tid :acc
    } else if tt == ztypes.ztypetype.variantType then {
        variantArmIds :reg :typing :tid ids: acc nameIds: names
    } else {
        recFieldIds :reg :typing :tid ids: acc nameIds: names
    }
    # a typedef of an aggregate is spelled as the aggregate (typeRefC)
    ch: chaseAggregateTypedef :reg :typing :ctx :tid
    if ch != tid then acc.append ch
    memberSigReachEdges :reg :typing :ctx :tid :acc
    containerReachEdges :reg :typing :ctx :tid :acc
}

# unionReachEdges -- the arm payloads a union's own C spells (emitUnionMono): an
# inline arm's, a member of its slot, and a heap arm's whose destructor the
# union's destructor calls through a cast. A heap arm's payload is otherwise
# spelled where written C builds the arm or reads it (noteAliasRead).
unionReachEdges: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
    acc: ListVal ztypes.tid
} is {
    ids: ListVal ztypes.tid
    names: ListVal zast.nameid
    recFieldIds :reg :typing :tid :ids nameIds: names
    dw: destroyWritten :reg :ctx :tid
    i: u64
    for i < ids.length loop {
        p: ids.get :i
        nm: names.get :i
        i = i + 1
        if (armIsInlineC :typing :tid arm: nm) then {
            acc.append p
        } else if dw when (destroyTargetTid :reg :typing :ctx tid: p).notZero then {
            acc.append p
        }
    }
}

# memberSigReachEdges -- the signature of each member written beside a type
# that no call spells: a native iterator's `call`, which its cursor is written
# with, and every member of a protocol or facet, whose vtable lists them all.
# Any other member's signature is spelled where written C calls it -- a method
# with a body by its own job, an iterator's `call` with a body included, and a
# native by its call.
memberSigReachEdges: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
    acc: ListVal ztypes.tid
} is {
    names: ListVal zast.nameid
    allMembers: (reg.typetypeOf typeId: tid).isInterface
    slot: u64
    for slot < (typing.declRowSlots ownerTid: tid) loop {
        rw: typing.declRowAt ownerTid: tid membersOnly: true :slot
        slot = slot + 1
        if rw.keep.not then continue
        if (reg.typetypeOf typeId: rw.tid) != ztypes.ztypetype.functionType then continue
        if (ctx.fnJobAt.get key: rw.tid).some then continue
        if allMembers.not when rw.name != zast.wellKnown.slot.wkCall then continue
        if allMembers.not when (reg.isNativeOf tid: rw.tid).not then continue
        at: acc.length
        acc.append (reg.returnTypeOf tid: rw.tid)
        # the return a vtable slot or a wrapper is written with (methodRetCtype)
        acc.append (
            (ztypecheck.methodReturnOf :reg :typing mid: rw.tid).or
            d: ztypes.tid.zero
        )
        recFieldIds :reg :typing tid: rw.tid ids: acc nameIds: names
        for at < acc.length loop {
            acc.set i: at val: (ownSignatureTid :reg tid: (acc.get i: at))
            at = at + 1
        }
    }
}

# containerReachEdges -- what a container's templates spell beyond its used
# members.
containerReachEdges: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
    acc: ListVal ztypes.tid
} is {
    # what a container's member sections spell, for the members written C
    # calls (memberUses): a set's iterator, a map's `get` answer (`getv`
    # forwards to `get`) and a hashed map's `remove`
    isSet: (isSetOriginOf :reg :ctx :tid) or (isIdSetOriginOf :reg :ctx :tid)
    isMap: (isMapOriginOf :reg :ctx :tid) or (isIdMapOriginOf :reg :ctx :tid)
    walksSet: memberUsed :ctx mono: tid member: memberWord.slot.iterateAll
    usesGet: (
        (memberUsed :ctx mono: tid member: memberWord.slot.getOne) or
        (memberUsed :ctx mono: tid member: memberWord.slot.getv)
    )
    usesRemove: memberUsed :ctx mono: tid member: memberWord.slot.remove
    if isSet when walksSet then {
        acc.append (monoMethodReturn :reg :typing monoId: tid nameId: zast.wellKnown.slot.wkIterate)
    }
    if isMap when usesGet then {
        acc.append (monoMethodReturn :reg :typing monoId: tid nameId: zast.wellKnown.slot.wkGet)
    }
    if (isMapOriginOf :reg :ctx :tid) when usesRemove then {
        acc.append (monoMethodReturn :reg :typing monoId: tid nameId: zast.wellKnown.slot.wkRemove)
    }
    # a map's walks: each one's cursor, where written C calls it
    if isMap when (memberUsed :ctx mono: tid member: memberWord.slot.iterateAll) then {
        acc.append (monoMethodReturn :reg :typing monoId: tid nameId: zast.wellKnown.slot.wkIterate)
    }
    if isMap when (memberUsed :ctx mono: tid member: memberWord.slot.iterateItems) then {
        acc.append (
            monoMethodReturn
            :reg
            :typing
            monoId: tid
            nameId: zast.wellKnown.slot.wkIterateItems
        )
    }
    # a list's view, which its `listView`, `extendView` (the window it takes)
    # and `slice` sections spell (listviewMethods, emitListSliceOnDemand): a
    # view passed straight from one call to another is spelled nowhere else
    spellsView: (
        (memberUsed :ctx mono: tid member: memberWord.slot.listView) or
        (memberUsed :ctx mono: tid member: memberWord.slot.extendView)
    )
    if spellsView then {
        acc.append (monoMethodReturn :reg :typing monoId: tid nameId: zast.wellKnown.slot.wkListView
        )
    }
    if (memberUsed :ctx mono: tid member: memberWord.slot.slice) then {
        acc.append (monoMethodReturn :reg :typing monoId: tid nameId: zast.wellKnown.slot.wkSlice)
    }
}

# variantArmIds -- a variant's arm payload ids and arm name ids, for the callers
# that never spell an arm.
variantArmIds: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    ids: ListVal ztypes.tid
    nameIds: ListVal zast.nameid
} is {
    ownerTid: tid
    vi1: u64
    vn1: typing.declRowSlots :ownerTid
    for vi1 < vn1 loop {
        armRow: typing.declRowAt :ownerTid membersOnly: true slot: vi1
        vi1 = vi1 + 1
        if armRow.keep when (
            isArmRow
            :reg
            :typing
            tid: ownerTid
            nameId: armRow.name
            rowTid: armRow.tid
        ) then {
            armTid: armRow.tid
            ids.append armTid
            armName: armRow.name
            nameIds.append armName
        }
    }
}

# isArmRow -- a member row of sum `tid` is one of its arms: not a method, not
# the tag accessor's slot and not an implementation label.
isArmRow: function {
    # the checked program
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the sum type
    tid: ztypes.tid
    # the row's name, interned
    nameId: zast.nameid
    # the row's type
    rowTid: ztypes.tid
} out bool is {
    # a function member is a method, unless it is declared as an arm that
    # carries a function
    isFn: (reg.typetypeOf typeId: rowTid) == ztypes.ztypetype.functionType
    if isFn when (ztypecheck.sumArmDeclared :typing sumTid: tid :nameId).not then return false
    if nameId == zast.wellKnown.slot.wkTag then return false
    return (zenv.isImplementationLabelOf ty: typing :reg :tid :nameId).not
}

# tagConstC -- the C constant naming the tag of sum `tid`'s arm at ordinal
# `armOrd` (declaration order, as variantArmIds lists the arms):
# `Z_T<tid>_TAG_<ordinal>`, from ids alone, as the type's own C name is. Every
# tag constant the emitter writes is spelled here. Under --readable-names the
# type's readable name and the arm's are appended, as they are to the type's C
# name; nothing about uniqueness rests on them.
tagConstC: function {
    # the arm names
    ast: Ast.view
    # the C names, and whether they are readable
    ctx: Ctx.view
    # the checked program
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the sum type
    tid: ztypes.tid
    # the arm's position among the sum's arms
    armOrd: u64
} out String is {
    t: "Z_T\{tid}_TAG_\{armOrd}"
    if ctx.readableNames then {
        cn: ctxCnameView :ctx :tid
        pre: cnameById :tid
        if cn.length > pre.length then t.append (cn.substring from: pre.length to: cn.length)
        t.append "_"
        t.append (zast.nameTextAt :ast ref: (armIdAt :reg :typing :tid :armOrd))
    }
    return t
}

# tagConstOf -- tagConstC for the arm of sum `tid` named `armId`. A name the sum
# does not declare as an arm has no tag, and asking for one is an emitter defect.
tagConstOf: function {
    # the arm names
    ast: Ast.view
    # the C names
    ctx: Ctx.view
    # the checked program
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the sum type
    tid: ztypes.tid
    # the arm's name, interned
    armId: zast.nameid
} out String is {
    o: armOrdinalOf :reg :typing :tid :armId
    match (
        o
    ) case some then {
        return (tagConstC :ast :ctx :reg :typing :tid armOrd: o)
    } case none then {
        an: zast.nameTextAt :ast ref: armId
        tn: reg.nameViewOf :tid
        panic msg: "zemitterc: a tag constant for '\{an}', which '\{tn}' does not declare as an arm"
    }
}

# noteTagConstUse -- a tag constant of `tid` spelled in C being written: it is
# declared by its type's enum, so until the reached types are fixed it is a use
# of that type (closeReachedTypes) -- of an ordinal variant's enum alone, whose
# type name is a use of its own -- and of the enum (noteTagEnumUse).
noteTagConstUse: function {
    ctx: Ctx reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view tid: ztypes.tid
} is {
    if (isOrdinalVariant :typing :tid) then {
        if ctx.reachFixed.not then ctx.ordinalTagUses.add item: tid
        return
    }
    if ctx.reachFixed.not then ctx.typeUses.add item: tid
    noteTagEnumUse :ctx :reg :tid
}

# noteTagEnumUse -- C being written spells the tag enum of the non-ordinal sum
# `tid`, a constant of it or its `_tag_t`: before the reached types are fixed
# the enum is a use; after, it must be one already used, or the C names an enum
# that is never written. A union's enum is written with its struct: the
# collection templates spell their options' tags after the types are fixed.
noteTagEnumUse: function {ctx: Ctx reg: ztypes.ZTypeRegistry.view tid: ztypes.tid} is {
    if (reg.typetypeOf typeId: tid) != ztypes.ztypetype.variantType then return
    if ctx.reachFixed.not then {
        ctx.tagEnumUses.add item: tid
        return
    }
    if (ctx.tagEnumUses.has item: tid) then return
    # a type that is not written is spelled only by template text its writer
    # drops (a stand-in's options)
    if (ctx.reachedTypes.has item: tid).not then return
    cn: ctxCname :ctx :tid
    (
        emitFail
        :ctx
        what: "the tag enum of \{cn} spelled after the reached types were fixed, and not among them"
        line: 0
    )
}

# tagEnumWritten -- whether the non-ordinal variant `tid`'s tag enum is written:
# where C spells it, where its struct stores the tag as the enum (`tsc`, its
# tagStorageCType, empty), or where its generated `==` is written beside it and
# switches on the constants. Those two are the type's own uses of it.
tagEnumWritten: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    tsc: StringView
} out bool is {
    if tsc.length == 0 then ctx.tagEnumUses.add item: tid
    if (ctx.eqUsed.has item: tid) when (eqGenerated :ast :reg :typing :ctx :tid) then {
        ctx.tagEnumUses.add item: tid
    }
    return (ctx.tagEnumUses.has item: tid)
}

# spelledTagConst -- tagConstOf for C being written (noteTagConstUse).
spelledTagConst: function {
    ast: Ast.view
    ctx: Ctx
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    armId: zast.nameid
} out String is {
    noteTagConstUse :ctx :reg :typing :tid
    return (tagConstOf :ast :ctx :reg :typing :tid :armId)
}

# armOrdinalOf -- the position of the arm named `armId` among sum `tid`'s arms
# (variantArmIds' order); none when the sum declares no such arm.
armOrdinalOf: function {
    # the checked program
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the sum type
    tid: ztypes.tid
    # the arm's name, interned
    armId: zast.nameid
} out optionval u64 is {
    k: u64
    i: u64
    n: typing.declRowSlots ownerTid: tid
    for i < n loop {
        rw: typing.declRowAt ownerTid: tid membersOnly: true slot: i
        i = i + 1
        if rw.keep when (isArmRow :reg :typing :tid nameId: rw.name rowTid: rw.tid) then {
            if rw.name == armId then return (optionval.some k)
            k = k + 1
        }
    }
    return (optionval.none u64)
}

# armIdAt -- the name of sum `tid`'s arm at ordinal `armOrd`; 0 past the last.
armIdAt: function {
    # the checked program
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the sum type
    tid: ztypes.tid
    # the arm's position among the sum's arms
    armOrd: u64
} out zast.nameid is {
    k: u64
    i: u64
    n: typing.declRowSlots ownerTid: tid
    for i < n loop {
        rw: typing.declRowAt ownerTid: tid membersOnly: true slot: i
        i = i + 1
        if rw.keep when (isArmRow :reg :typing :tid nameId: rw.name rowTid: rw.tid) then {
            if k == armOrd then return rw.name
            k = k + 1
        }
    }
    return zast.nameid
}

# armValueC -- a no-payload arm's VALUE when the tagged type's C form is a
# SCALAR: `bool` lowers to C `bool`, not to a tag struct, so the struct literal
# every caller composes is invalid there. The tag enum is emitted for such
# types and its constants are the arm ordinals, so the value is the constant
# cast to that C form. Returns "" when the type carries a real tag struct --
# callers keep composing it, byte for byte.
armValueC: function {
    # the arm names
    ast: Ast.view
    # the C names
    ctx: Ctx
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    # the arm's name
    arm: zast.nameid
} out String is {
    avs: ordinalVariantCType :typing :tid
    if avs.length == 0 then return "".string
    avt: spelledTagConst :ast :ctx :reg :typing :tid armId: arm
    avr: "((\{avs})\{avt})"
    return avr
}

# emitArmPayloadDestroy -- the destructor call for a union arm's boxed payload,
# nothing when the payload owns nothing. The box holds the payload as it is
# stored (armPayloadC), and a Set or a Map payload is stored as its pointer, so
# that one is destroyed through what the box holds.
emitArmPayloadDestroy: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    arm: zast.nameid
    buf: String.borrow
} is {
    pdtr: payloadDestructor :reg :typing :ctx :tid :arm
    if pdtr.length == 0 then return
    # the cast is spelled only here, the payload a reach edge of the union
    # (unionReachEdges)
    pc: armPayloadC :ast :reg :typing :ctx :tid :arm
    co: typing.declChildOfId parentTypeId: tid nameId: arm
    if (isHeapPtrCollection :reg :typing :ctx tid: (co.or d: ztypes.tid.zero)) then {
        dh: armCellDeref pc: pc.stringView slot: "u->data"
        buf.append "            \{pdtr}(\{dh});\n"
    } else {
        dd: armCellPtr pc: pc.stringView slot: "u->data"
        buf.append "            \{pdtr}(\{dd});\n"
    }
}

# armHasPayload -- arm `arm` of sum `tid` carries a payload: armPayloadC is
# not "", asked without spelling the payload's type.
armHasPayload: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view tid: ztypes.tid arm: zast.nameid
} out bool is {
    co: typing.declChildOfId parentTypeId: tid nameId: arm
    match (
        co
    ) case some then {
        return (reg.typetypeOf typeId: co) != ztypes.ztypetype.nullType
    } case none then {
        return false
    }
}

# armPayloadC -- an arm's payload C type ("" for null arms), as the arm stores
# it: a heap collection is its pointer (slotCType).
armPayloadC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    arm: zast.nameid
} out String is {
    co: typing.declChildOfId parentTypeId: tid nameId: arm
    match (
        co
    ) case some then {
        if (reg.typetypeOf typeId: co) == ztypes.ztypetype.nullType then return "".string
        return (slotCType :ast :reg :typing :ctx tid: co)
    } case none then {
        return "".string
    }
}

# heldArmPayloadC -- armPayloadC with the types it spells held in `held`, not
# recorded: the caller records them where the text is written (releaseHeld), or
# where an alias spelling it is read (holdForAlias).
heldArmPayloadC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    arm: zast.nameid
    held: ListVal ztypes.tid
} out String is {
    ctx.typeUseHold = true
    pc: armPayloadC :ast :reg :typing :ctx :tid :arm
    ctx.typeUseHold = false
    for each t: ctx.heldTypeUses loop held.append t
    ctx.heldTypeUses = ListVal ztypes.tid
    return pc
}

# releaseHeld -- record the types `held` still holds: their text is written.
releaseHeld: function {ctx: Ctx held: ListVal ztypes.tid} is {
    for held.length > 0 loop noteTypeUse :ctx tid: held.pop
}

# holdForAlias -- the types `held` holds are spelled by alias `val`: recorded
# when narrowBox's text is read (noteAliasRead), not before.
holdForAlias: function {ctx: Ctx val: StringView held: ListVal ztypes.tid} is {
    for held.length > 0 loop ctx.aliasHeld.append (AliasHeld val: val.string tid: held.pop)
}

# noteAliasRead -- C being written reads `vid`'s narrowBox text: the types the
# text spells are recorded, once.
noteAliasRead: function {ctx: Ctx vid: ztypes.vid} is {
    if ctx.aliasHeld.length == 0 then return
    nb: vidFind xs: ctx.narrowBox :vid
    if nb == 0 then return
    hits: ListVal u64
    {
        v: (ctx.narrowBox.get i: nb - 1).val.stringView
        i: u64
        for i < ctx.aliasHeld.length loop {
            e: ctx.aliasHeld.get :i
            if e.tid.notZero when e.val.stringView == v then hits.append i
            i = i + 1
        }
    }
    for each h: hits loop {
        t: (ctx.aliasHeld.get i: h).tid
        noteTypeUse :ctx tid: t
        ctx.aliasHeld.set i: h val: (AliasHeld val: "".string tid: ztypes.tid.zero)
    }
}

# recFieldIds -- recFieldLists without the names: the same fields, for the
# callers that walk the type ids and the name ids and never spell a field.
recFieldIds: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    ids: ListVal ztypes.tid
    nameIds: ListVal zast.nameid
} is {
    ztypecheck.dataFieldIds :reg :typing :tid :ids :nameIds
}

# recFieldLists -- a record type's field names and type ids in order
# (non-FUNCTION children, implementation markers excluded). The filter lives in
# ztypecheck: the C struct layout the emitter lays down and the data-field
# list the checker validates against must agree field for field.
recFieldLists: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    names: List String
    ids: ListVal ztypes.tid
    nameIds: ListVal zast.nameid
} is {
    ztypecheck.dataFieldNames :ast :reg :typing :tid :names :ids :nameIds
}

# unitDeclByName -- the file unit spelled `name`, asked of the ENVIRONMENT:
# the program root's own children, which IS the list of units in scope. A name
# reaches this only from a source literal, a unit segment of a row's path, or
# the main-unit binding -- identity itself
# travels as a declid. Answering from the declaration tree rather than a side
# index means there is nothing to go stale and nothing silently overwritten
# when two files declare the same unit name.
unitDeclByName: function {
    typing: ztyping.ZTyping.view
    ast: Ast.view
    name: StringView
} out ztypes.declid is {
    return (
        ztypecheck.unitDeclOfName
        :typing
        nameId: (zast.poolFind pool: ast.names text: name)
    )
}

# pathUnitTidOf -- the type id of the unit a dotted path's BASE names, or 0
# when the base names no unit. The checker stamps a base that names a unit with
# that unit's type, so this is the unit the checker chose -- the nearest scope,
# a nested unit sharing a file unit's spelling -- and a value, a type or a
# nested unit spelled like a unit is never taken for it.
pathUnitTidOf: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view baseId: zast.nodeid
} out ztypes.tid is {
    if baseId.isZero then return ztypes.tid
    t: stampIdOf :typing nid: baseId
    if t.isZero then return t
    if (reg.typetypeOf typeId: t) != ztypes.ztypetype.unitType then return ztypes.tid
    return t
}

# baseFileUnitDecl -- the FILE unit (a child of the program root) the dotted
# path base `baseId` resolved to, 0 for any other base: a nested unit, an
# instance of a generic file unit, or a value, type or nested unit that shares
# a file unit's spelling.
baseFileUnitDecl: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view baseId: zast.nodeid
} out ztypes.declid is {
    t: pathUnitTidOf :reg :typing :baseId
    if t.isZero then return ztypes.declid.zero
    d: ztypecheck.templateDeclOf :reg :typing tid: t
    if (typing.declParentOf declId: d) != typing.programRoot then {
        return ztypes.declid.zero
    }
    # an instance of a generic file unit is not the file unit: templateDeclOf
    # answers an instance with its template's declaration
    if (typing.declTypeOf declId: d) != t then return ztypes.declid.zero
    return d
}

# unitConstTextOf -- the rendered C text of a `unit.CONST` dotted path, or ""
# when the path names no constant of a known unit. Emission, the constant-shape
# test and the integer fold all ask this one question: a constant that folds
# under a bare name has to fold under this spelling too, and the difference was
# the spelling alone -- the same unit's own constant did not fold either.
unitConstTextOf: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: zast.dottedpathrow.view
    facts: cfacts.borrow
} out String is {
    cn8: zast.nameid
    ca8: ast.nodes.get i: n.child
    if ca8.atomid then cn8 = ca8.name
    if cn8.notZero then {
        unitTid: pathUnitTidOf :reg :typing baseId: n.parent
        if unitTid.notZero then {
            # the VALUE is the only source: a constant is never rendered to
            # text ahead of time and re-read.
            memberConst: memberConstText :ast :reg :typing :ctx :unitTid nameId: cn8 :facts
            if memberConst.length > 0 then return memberConst
            memberText: memberConstStringText :typing :ctx :unitTid nameId: cn8 :facts
            if memberText.length > 0 then return memberText
            # a constant the unit's `public:` block DEFINES is on the unit's
            # surface, keyed on the block (a nested unit named `public`)
            publicDecl: ztypecheck.publicNsOf :reg :typing tid: unitTid
            publicTid: typing.declTypeOf declId: publicDecl
            if publicTid.notZero then {
                publicConst: (
                    memberConstText
                    :ast
                    :reg
                    :typing
                    :ctx
                    unitTid: publicTid
                    nameId: cn8
                    :facts
                )
                if publicConst.length > 0 then return publicConst
                publicText: memberConstStringText :typing :ctx unitTid: publicTid nameId: cn8 :facts
                if publicText.length > 0 then return publicText
            }
        }
    }
    return "".string
}

# checkLoadedNatives -- drive checkNativesResolve over EVERY loaded unit. This
# rode inside fillMethodReturns until that table turned out to be unreadable;
# the CHECK was never part of the table's job and stays.
#
# The unit's own file is found PER UNIT and not hoisted, because the rows are
# looked up in it. Hoisting it -- which is what the main-unit filter left behind
# -- resolves every unit's natives in the main unit's file, so every row misses
# and every declaration in the program reads as unimplemented at once.
checkLoadedNatives: function {program: Ast.view typing: ztyping.ZTyping.view ctx: Ctx} is {
    {
        for each uId: program.units loop {
            opId: zast.nodeid
            unitName: String
            impl: u64
            u: program.nodes.get i: uId
            if u.namedoperation then {
                un: zast.poolTextAt pool: program.names ref: u.name
                opId = u.operation
                unitName = un.copy
                impl = (
                    ctx.rows.fileOfUnit
                    ud: (ztypecheck.unitDeclOfName :typing nameId: u.name)
                )
            }
            if opId.notZero then {
                (
                    checkNativesResolve
                    ast: program
                    :ctx
                    unitOpId: opId
                    unitName: unitName.stringView
                    :impl
                )
            }
        }
    }
}

# checkNativeMembers -- the `is native` members of one of a type's two blocks
# must each name a row. Split out because both blocks are read and the walk is
# the same for either.
checkNativeMembers: function {
    ast: Ast.view
    ctx: Ctx
    items: zast.kidspan
    unitName: StringView
    # the file implementing the unit (RowTable.fileUnits), 0 for none
    impl: u64
    typeName: zast.nameid
} is {
    for each am: (zast.kidsOf :ast span: items) loop {
        amn: ast.nodes.get i: am
        if amn.namedoperation then {
            mo: ast.nodes.get i: amn.operation
            rk: zemitrows.rowname :impl :typeName name: amn.name
            if mo.functiondef when mo.isNative when (ctx.rows.hasRowNamed n: rk).not then {
                tn: zast.nameTextAt :ast ref: typeName
                mn: zast.nameTextAt :ast ref: amn.name
                tk: rowAddress owner: tn.stringView key: mn.stringView
                ctx.emitErrors.append (
                    noNativeImplFailure
                    :ast
                    :ctx
                    nid: am
                    key: (rowAddress owner: unitName key: tk.stringView).stringView
                    :unitName
                )
            }
        }
    }
}

# noNativeImplFailure -- E0501 at the declaration `nid` names: it says
# `is native` and its unit's C implementation has no row `key`. The program's
# error, not an emitter gap, so it is shown where it was written. A unit outside
# the standard library with no implementation file at all is told which file
# it lacks.
noNativeImplFailure: function {
    ast: Ast.view
    ctx: Ctx.view
    # the declaration's labelled row
    nid: zast.nodeid
    # the row's key
    key: StringView
    # the unit the declaration is keyed under
    unitName: StringView
} out zast.ErrorData is {
    dn: ast.nodes.get i: nid
    pos: zast.posOf n: dn
    # the declared name is what the caret marks
    width: u32
    if dn.namedoperation then width = (zast.nameTextAt :ast ref: dn.name).length.u32.orPanic
    note: String
    hint: "`is native` promises a body from the unit's C implementation: write the body, or add the row".string
    if (isServedUnit name: unitName).not when (ctx.implementedUnits.has item: unitName.string
    ).not then {
        note = "unit '\{unitName}' has no C implementation file: \{unitName}/nativec.zd beside \{unitName}.z"
        hint = "write its rows in \{unitName}/nativec.zd (a runtime.nativec value), or write the body"
    }
    return (
        zast.ErrorData
        nodeid: nid
        lineno: pos.line
        colno: pos.col
        :width
        err: zast.err.noNativeImpl
        msg: "no native implementation for '\{key}'"
        fsno: zvfs.fsno
        :note
        :hint
    )
}

# checkNativesResolve -- every `is native` declaration in a loaded unit that the
# checker does not answer must name a row of its unit. `is native` says a
# backend supplies the body, and this is where that claim is checked: at the
# declaration, whether or not anyone calls it. Without it an uncalled one is
# accepted in silence and a called one is only found at the call, as an emitter
# gap rather than as the missing implementation it is.
#
# EVERY loaded unit, not only the program's own. A program that loads
# collections.z sees its native declarations exactly as it sees the ones it
# wrote, so a standard library with a hole in it breaks the build that USES it
# and not only the build that ships it.
checkNativesResolve: function {
    ast: Ast.view
    ctx: Ctx
    unitOpId: zast.nodeid
    unitName: StringView
    # the file implementing the unit (RowTable.fileUnits), 0 for none
    impl: u64
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitOpId
    for each bm: (zast.kidsOf :ast span: bodyIds) loop {
        bn: ast.nodes.get i: bm
        if bn.namedoperation then {
            nm: zast.nameTextAt :ast ref: bn.name
            op: ast.nodes.get i: bn.operation
            match (
                op
            ) case functiondef then {
                rk: zemitrows.rowname :impl typeName: zast.nameid.zero name: bn.name
                if op.isNative when (ctx.rows.hasRowNamed n: rk).not then {
                    ctx.emitErrors.append (
                        noNativeImplFailure
                        :ast
                        :ctx
                        nid: bm
                        key: (rowAddress owner: unitName key: nm.stringView).stringView
                        :unitName
                    )
                }
            } case objectdef then {
                # BOTH blocks. A native method may be written in either, and
                # which one carries it is a fact about the type rather than
                # about the method: the containers declare theirs in `as`,
                # io.File declares its five in the class body and keeps `as`
                # for the protocols it implements. Reading only `as` left
                # File.read and its four siblings checked by nothing.
                checkNativeMembers :ast :ctx items: op.isItems :unitName :impl typeName: bn.name
                checkNativeMembers :ast :ctx items: op.asItems :unitName :impl typeName: bn.name
            } case unitdef then {
                # a SUBUNIT -- lib/system/system/wideint.z and its siblings are
                # this shape. Its declarations are not in the program's unit
                # table, so nothing above reaches them, and they are keyed under
                # the PARENT unit's name: i128's operators are `system.i128.+`,
                # declared in wideint.z. So the name does NOT change on the way
                # down, and the path a call site builds is the path checked here.
                checkNativesResolve :ast :ctx unitOpId: bn.operation :unitName :impl
            } else null
        }
    }
}

# noteStaticVids -- every data type into ctx.staticTids, and every variable
# whose type is one into ctx.staticVids: such a variable holds a handle, so
# isPtrVid answers for it in every function, as for a pointer receiver.
noteStaticVids: function {reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx} is {
    if typing.staticTypesSeen.not then return
    t: ztypes.tid 1
    for t < reg.nextTid loop {
        if (isStaticHandle :reg :typing tid: t) then ctx.staticTids.add item: t
        t = t.next
    }
    v: ztypes.vid 1
    for v < reg.nextVid loop {
        if (isStaticHandle :reg :typing tid: (reg.variableTypeOf id: v)) then (
            ctx.staticVids.add
            item: v
        )
        v = v.next
    }
}

# demandTmplClassNeeds -- a templated class's row's `needs=`, demanded once the
# program has an instance of it: the template calls what the row names, and no
# method row is demanded on its behalf (their calls go to the template)
demandTmplClassNeeds: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx
} is {
    ri: u64
    for ri < ctx.classRows.length loop {
        un: String
        nd: String
        {
            r: ctx.classRows.get i: ri
            tpl: ctx.classRowTids.get i: ri
            if r.tmpl.length > 0 when tpl.notZero when (tmplClassInProgram :reg :typing :tpl) then {
                un = r.uname.copy
                nd = r.need.copy
            }
        }
        for each n1: (nd.stringView.split sep: ",") loop {
            if n1.length > 0 then rowNeedAddOne :ctx uname: un.stringView need: n1
        }
        ri = ri + 1
    }
}

# tmplClassInProgram -- the templated class `tpl` is written into this
# program: a generic one has an instance, a non-generic one is made -- its
# `create` is demanded. Naming the class (a parameter type of another's
# method) makes none, so it is not enough.
tmplClassInProgram: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view tpl: ztypes.tid
} out bool is {
    if (reg.isGenericOf tid: tpl) then return (classHasInstance :reg :tpl)
    # `--eager` reaches every definition but resolves no native create: the
    # class is written when it is
    if typing.eagerAll then return (
        typing.declIsResolved
        declId: (typing.declIdOfType typeId: tpl)
    )
    cd: typing.declMemberIdOf parentTypeId: tpl nameId: zast.wellKnown.slot.wkCreate
    if cd.isZero then return false
    return (typing.declIsResolved declId: cd)
}

# classHasInstance -- some type is an instance of the template `tpl`
classHasInstance: function {reg: ztypes.ZTypeRegistry.view tpl: ztypes.tid} out bool is {
    tm: ztypes.tid
    last: reg.nextTid
    for tm < last loop {
        if (originTidOf :reg tid: tm) == tpl then return true
        tm = tm.next
    }
    return false
}


# fnUndemanded -- a bodied free fn the program never referenced: its def was
# not resolved, so its body carries no stamps and emitting it renders the
# signature as `z_t0(void)` over unbound parameter names. Skip it everywhere
# (definition, literal pooling). Whether the fn resolved is a
# fact about the DEFINITION, not about which unit declares it: a demand-gated
# unit and an emittable one both leave an unreferenced body unresolved, and
# only the eager pass hid that for the second. ownerTid names the enclosing
# namespace / subunit type for a nested fn -- its members are children of IT,
# so the unit-root key below misses them and would drop a fn that IS used.
fnUndemanded: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    # the file unit that declares the function (the nested case: ownerTid)
    unitDecl: ztypes.declid
    # the function's name, interned
    nameId: zast.nameid
    ownerTid: ztypes.tid
    # ask whether the body was WALKED, not merely resolved. Only the definition
    # pass may: the literal pool has to cover everything that might be emitted,
    # including a generic template unit's monos, whose template is never walked
    # under its own name.
    wantWalked: bool
} out bool is {
    if ownerTid.notZero then {
        if (typing.declChildOfId parentTypeId: ownerTid :nameId).none then return true
        if wantWalked.not then return false
        md: typing.declMemberIdOf parentTypeId: ownerTid :nameId
        return (typing.declIsWalked declId: md).not
    }
    if (ztypecheck.resolvedByIdsRo :ast :typing :unitDecl name: nameId).none then return true
    # resolved is not enough: emitting a body that was never WALKED emits code
    # whose types were never minted -- a resolved but unwalked json.at emitted
    # a call whose return spec nothing ever created, `z_t0_t`. The walk is what
    # stamps a body, so being walked is the honest question, for the main unit
    # as for any other: its definitions are walked on demand too, and one that
    # only a folded-away branch names (`if z.build.os == ...` for another
    # system) is resolved but never walked.
    if wantWalked.not then return false
    wd: ztypecheck.declOfUnitDefIds :typing :unitDecl :nameId
    return (typing.declIsWalked declId: wd).not
}

# isGenericTemplateUnitOp -- a file unit that is a generic template (declares a
# bare `t: anyval.generic` member). Its raw functions reference the unbound type
# param, so they are not emitted directly; planUnitMonoInstances plans one
# concrete C function per (instantiation, method) instead.
isGenericTemplateUnitOp: function {ast: Ast.view opId: zast.nodeid} out bool is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: opId
    for each m: (zast.kidsOf :ast span: bodyIds) loop {
        member: ast.nodes.get i: m
        if member.namedoperation when (
            ztypecheck.isGenericParam
            :ast
            op: (ast.nodes.get i: member.operation)
        ) then return true
    }
    return false
}


# planUnitNestedMethods -- the methods of the unit mono `t`'s own copy of a type
# its template declares, or of each of its instances of one with parameters of
# its own.
planUnitNestedMethods: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    member: astnode.view
    t: ztypes.tid
} is {
    if member.namedoperation.not then return
    op: ast.nodes.get i: member.operation
    if op.objectdef.not then return
    io: typing.declChildOfId parentTypeId: t nameId: member.name
    inst: io.or d: ztypes.tid.zero
    if inst.isZero then return
    if (reg.genericOriginOf tid: inst).notZero then {
        planMonoMethods :ast :reg :typing :ctx span: op.isItems monoId: inst withMethods: false
        planMonoMethods :ast :reg :typing :ctx span: op.asItems monoId: inst withMethods: false
        return
    }
    if (reg.isGenericOf tid: inst).not then return
    # a type with parameters of its own: each instance of it `t` has
    for each ci: (ztypecheck.instancesWithin :reg :typing owner: t tplId: inst) loop {
        planMonoMethods :ast :reg :typing :ctx span: op.isItems monoId: ci withMethods: false
        planMonoMethods :ast :reg :typing :ctx span: op.asItems monoId: ci withMethods: false
    }
}

# planMonoMethods -- planMethodAt over every member of `span`. The is block
# and the as block of a template are asked the same question: a generator keeps
# its methods in the one a class keeps its fields in, and that difference
# reaches no emitted byte.
planMonoMethods: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    span: zast.kidspan
    monoId: ztypes.tid
    withMethods: bool
} is {
    for each amId: (zast.kidsOf :ast :span) loop {
        planMethodAt :ast :reg :typing :ctx nid: amId :monoId :withMethods
    }
}

# planMethodAt -- the job of the member `nid` of a template, as the mono
# `monoId`'s method, when it is a method with a body. An instance's method is
# written when its instance walk took it, which is where the program uses it; a
# method with type parameters of its own is written per instance of it.
planMethodAt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nid: zast.nodeid
    monoId: ztypes.tid
    withMethods: bool
} is {
    site: zast.namedSiteAt :ast :nid
    if site.operation.isZero then return
    if (ztypecheck.isFunctionDefWithBody o: (ast.nodes.get i: site.operation)).not then return
    co: typing.declChildOfId parentTypeId: monoId nameId: site.name
    fid: co.or d: ztypes.tid.zero
    if fid.isZero then return
    if (reg.typetypeOf typeId: fid) != ztypes.ztypetype.functionType then return
    imd: typing.declMemberIdOf parentTypeId: monoId nameId: site.name
    took: imd.isZero or (typing.declIsWalked declId: imd)
    if took.not when (isGenericFnTid :reg tid: fid).not then return
    planMethodOrInstances :reg :typing :ctx mid: fid owner: monoId opId: site.operation :withMethods
}

# planMethodOrInstances -- the job of a method, or, for a method with type
# parameters of its own, of each of its instances: the template itself is never
# written, an instance is, from its own copy of the body.
planMethodOrInstances: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    mid: ztypes.tid
    owner: ztypes.tid
    opId: zast.nodeid
    withMethods: bool
} is {
    if (isGenericFnTid :reg tid: mid).not then {
        planMethodJob :ctx fid: mid nid: opId :owner mono: ztypes.tid.zero :withMethods
        return
    }
    for each t: (reg.instancesOf origin: mid) loop {
        (
            planMethodJob
            :ctx
            fid: t
            nid: (instanceOpAt :typing mono: t op: opId)
            :owner
            mono: t
            :withMethods
        )
    }
}

# planRecordMethods -- the job of every method a unit body declares on a type
# of its own, in the order the C writes them: per file unit, its body's types,
# then each unit nested in it. A file unit that is itself a template has none
# of its own: its instances carry their copies of its types.
planRecordMethods: function {
    program: Ast.view reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx
} is {
    for each uId: program.units loop {
        u: program.nodes.get i: uId
        if u.namedoperation.not then continue
        opId: u.operation
        if opId.isZero or (isGenericTemplateUnitOp ast: program :opId) then continue
        un: zast.nameTextCopy ast: program ref: u.name
        sm: ctx.mainName.copy
        smD: ctx.mainUnitId
        (
            ctxBindMain
            :ctx
            name: un.stringView
            unitDecl: (ztypecheck.unitDeclOfName :typing nameId: u.name)
        )
        (
            planBodyMethods
            ast: program
            :reg
            :typing
            :ctx
            bodyIds: (zast.unitBodyIdsAt ast: program unitId: opId)
            ownerTid: ztypes.tid
        )
        ctxBindMain :ctx name: sm.stringView unitDecl: smD
    }
}

# planBodyMethods -- the methods of each type one unit body declares, then of
# each unit nested in it. `ownerTid` is the nested unit whose body this is, 0
# for a file unit.
planBodyMethods: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    bodyIds: zast.kidspan
    ownerTid: ztypes.tid
} is {
    for each bmId: (zast.kidsOf :ast span: bodyIds) loop {
        bm: ast.nodes.get i: bmId
        if bm.namedoperation.not then continue
        opn: ast.nodes.get i: bm.operation
        # every family declaring methods takes its receiver and is written alike
        hasMethods: (
            (isRecordDef n: opn) or
            (isClassDef n: opn) or
            (isVariantDef n: opn) or
            (isUnionDef n: opn) or
            (isTypedefDef n: opn)
        )
        if hasMethods.not then continue
        rid: unitMemberTid :typing :ctx :ownerTid nameId: bm.name
        if rid.notZero then planTypeMethods :ast :reg :typing :ctx tid: rid op: opn
    }
    planNestedUnitMethods :ast :reg :typing :ctx :bodyIds :ownerTid
}

# planNestedUnitMethods -- planBodyMethods over each non-generic unit nested in
# one unit body, with ctx.nsTid set to it while its body is planned (a generic
# unit's instances are planned per mono).
planNestedUnitMethods: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    bodyIds: zast.kidspan
    ownerTid: ztypes.tid
} is {
    for each nmId: (zast.kidsOf :ast span: bodyIds) loop {
        nm: ast.nodes.get i: nmId
        if nm.namedoperation.not then continue
        nOp: nm.operation
        if (isGenericTemplateUnitOp :ast opId: nOp) then continue
        if (zast.unitOpDeclaresUnit :ast opId: nOp).not then continue
        nsTid: unitMemberTid :typing :ctx :ownerTid nameId: nm.name
        if nsTid.isZero then continue
        sns: ctx.nsTid
        ctx.nsTid = nsTid
        (
            planBodyMethods
            :ast
            :reg
            :typing
            :ctx
            bodyIds: (zast.unitBodyIdsAt :ast unitId: nOp)
            ownerTid: nsTid
        )
        ctx.nsTid = sns
    }
}

# planTypeMethods -- the jobs of the type `tid`'s as-block and is-block methods
# with bodies. A generic type's are its monos': each mono carries its own
# declaration of each of the template's methods.
planTypeMethods: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    op: astnode.view
} is {
    if op.objectdef.not then return
    if (reg.isGenericOf :tid) then {
        last: reg.nextTid
        t: ztypes.tid
        for t < last loop {
            go: originTidOf :reg tid: t
            if go.notZero when go == tid then {
                planMonoMethods :ast :reg :typing :ctx span: op.isItems monoId: t withMethods: true
                planMonoMethods :ast :reg :typing :ctx span: op.asItems monoId: t withMethods: true
            }
            t = t.next
        }
        return
    }
    planOwnMethods :ast :reg :typing :ctx :tid span: op.asItems
    planOwnMethods :ast :reg :typing :ctx :tid span: op.isItems
}

# planOwnMethods -- the job of each member of `span` that is a method of the
# non-generic type `tid` with a body the checker walked (methodBodyWalked).
planOwnMethods: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    span: zast.kidspan
} is {
    for each amId: (zast.kidsOf :ast :span) loop {
        am: ast.nodes.get i: amId
        if am.namedoperation.not then continue
        if (ztypecheck.isFunctionDefWithBody o: (ast.nodes.get i: am.operation)).not then continue
        mo: (typing.declChildOfId parentTypeId: tid nameId: am.name).or d: ztypes.tid.zero
        if mo.isZero then continue
        if (methodBodyWalked :reg :typing ownerTid: tid mid: mo nameId: am.name).not then continue
        (
            planMethodOrInstances
            :reg
            :typing
            :ctx
            mid: mo
            owner: tid
            opId: am.operation
            withMethods: true
        )
    }
}

# planUnitMonoMembers -- every body-carrying function the template declares,
# as the mono `t` substituted it.
planUnitMonoMembers: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the template's body items
    bodyIds: zast.kidspan
    t: ztypes.tid
} is {
    for each fm: (zast.kidsOf :ast span: bodyIds) loop {
        memberNode: ast.nodes.get i: fm
        planUnitNestedMethods :ast :reg :typing :ctx member: memberNode :t
        planNestedUnitMonoMembers :ast :reg :typing :ctx member: memberNode :t
        if memberNode.namedoperation when (
            ztypecheck.isFunctionDefWithBody
            o: (ast.nodes.get i: memberNode.operation)
        ) then {
            cfo: typing.declChildOfId parentTypeId: t nameId: memberNode.name
            # a function with type parameters of its own is each instance of it
            cgo: cfo.or d: ztypes.tid.zero
            if cgo.notZero when (reg.isGenericOf tid: cgo) then {
                (
                    planFnMonoInstances
                    :reg
                    :typing
                    :ctx
                    templateFnId: cgo
                    templateFnOpId: memberNode.operation
                )
                continue
            }
            # planned when the instance walk took it, which is where the
            # program uses it
            cmd: typing.declMemberIdOf parentTypeId: t nameId: memberNode.name
            took: cmd.isZero or (typing.declIsWalked declId: cmd)
            if took when cfo.some when (
                (reg.typetypeOf typeId: cfo) == ztypes.ztypetype.functionType
            ) then {
                (
                    planFnJob
                    :ctx
                    fid: cfo
                    nid: (instanceOpAt :typing mono: t op: memberNode.operation)
                    mono: t
                )
            }
        }
    }
}

# unitMonoNestedInstance -- the instance `mono` owns of the `unit { ... }` its
# template's body member declares; 0 when the member declares no unit.
unitMonoNestedInstance: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the member's name and its definition
    nameId: zast.nameid
    opId: zast.nodeid
    mono: ztypes.tid
} out ztypes.tid is {
    if opId.isZero or (zast.unitOpDeclaresUnit :ast :opId).not then return ztypes.tid.zero
    ni: (typing.declChildOfId parentTypeId: mono :nameId).or d: ztypes.tid.zero
    if ni.isZero or (originTidOf :reg tid: ni).isZero then return ztypes.tid.zero
    return ni
}

# nestedUnitTemplate -- the unit template the instance `mono` reaches through its
# template's body member, when that member declares a unit with parameters of
# its own; 0 otherwise.
nestedUnitTemplate: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    nameId: zast.nameid
    opId: zast.nodeid
    mono: ztypes.tid
} out ztypes.tid is {
    if opId.isZero or (zast.unitOpHasBody :ast :opId).not then return ztypes.tid.zero
    nt: (typing.declChildOfId parentTypeId: mono :nameId).or d: ztypes.tid.zero
    if nt.isZero or (originTidOf :reg tid: nt).notZero then return ztypes.tid.zero
    if (reg.isGenericOf tid: nt).not then return ztypes.tid.zero
    return nt
}

# planNestedUnitMonoMembers -- the functions of the instance `t` owns of a unit
# its template's body member `member` declares: planUnitMonoMembers over the
# nested unit's body, at any depth. Nothing for a member that declares none.
planNestedUnitMonoMembers: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    member: astnode.view
    t: ztypes.tid
} is {
    match (
        member
    ) case namedoperation then {
        nbody: zast.unitBodyIdsAt :ast unitId: member.operation
        nui: (
            unitMonoNestedInstance
            :ast
            :reg
            :typing
            nameId: member.name
            opId: member.operation
            mono: t
        )
        if nui.notZero then {
            planUnitMonoMembers :ast :reg :typing :ctx bodyIds: nbody t: nui
            return
        }
        # a template with parameters of its own: each instance of it `t` owns
        ntpl: (
            nestedUnitTemplate
            :ast
            :reg
            :typing
            nameId: member.name
            opId: member.operation
            mono: t
        )
        if ntpl.isZero then return
        for each oi: (ztypecheck.instancesWithin :reg :typing owner: t tplId: ntpl) loop {
            planUnitMonoMembers :ast :reg :typing :ctx bodyIds: nbody t: oi
        }
    } else null
}

# planUnitMonoInstances -- the monomorphized functions of a generic file unit
# (genmath instantiated as intmath: i64, i32math: i32). For each registry UNIT
# type whose generic origin is this template, one C function per template
# function, keyed by the mono's concrete FUNCTION child id (so the signature
# carries the substituted types).
planUnitMonoInstances: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the template, and its definition node
    tplId: ztypes.tid
    templateUnitOpId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: templateUnitOpId
    if tplId.isZero then return
    last: reg.nextTid
    t: ztypes.tid
    for t < last loop {
        tt: t
        if (reg.typetypeOf typeId: tt) == ztypes.ztypetype.unitType then {
            origin: originTidOf :reg tid: tt
            if origin.notZero when origin == tplId then {
                planUnitMonoMembers :ast :reg :typing :ctx :bodyIds :t
            }
        }
        t = t.next
    }
}

# planFnsPass -- one sweep over EVERY unit, routing generic template units to
# their mono instances and plain units to planFnsIn. It asks no unit-level
# question: what a runtime-backed unit supplies is dropped per DEFINITION, by
# fnUndemanded and the native filters collectFnDecls applies. ctx.mainName is
# rebound to each unit for the duration.
planFnsPass: function {
    program: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
} is {
    for each uId: program.units loop {
        opId: zast.nodeid
        unitNameText: String
        unitNameId: zast.nameid
        {
            u: program.nodes.get i: uId
            if u.namedoperation then {
                un: zast.poolTextAt pool: program.names ref: u.name
                opId = u.operation
                unitNameText = un.copy
                unitNameId = u.name
            }
        }
        if opId.notZero then {
            sm: ctx.mainName.copy
            smD: ctx.mainUnitId
            (
                ctxBindMain
                :ctx
                name: unitNameText.stringView
                unitDecl: (ztypecheck.unitDeclOfName :typing nameId: unitNameId)
            )
            if (isGenericTemplateUnitOp ast: program :opId) then {
                (
                    planUnitMonoInstances
                    :reg
                    :typing
                    ast: program
                    :ctx
                    tplId: (typing.declTypeOf declId: ctx.mainUnitId)
                    templateUnitOpId: opId
                )
            } else {
                planFnsIn :reg :typing :ctx ast: program mainOpId: opId ownerTid: ztypes.tid
            }
            ctxBindMain :ctx name: sm.stringView unitDecl: smD
        }
    }
}

# planFns -- every function the program's units could write, as jobs in the
# order the C writes them (planFnJob); then the job of the main unit's `main`
# is queued, the root every written function is reached from. A function is
# written only once written C spells it (noteFnUse, drainFnJobs): the checker
# demands what the source names, and the emitter's lowering may call none of
# it -- a counted loop over `0.upto to: 12` calls neither `upto` nor the
# range's `call`.
planFns: function {
    program: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
} is {
    planFnsPass :program :reg :typing :ctx
    em: entryMainTid :typing :ctx
    if em.notZero then noteFnUse :ctx tid: em
}

# fnjob -- one C function the program's units could write, as planFns met it:
# what writing it needs, captured where the walk met it, so the worklist can
# write it whenever written C first spells it (noteFnUse).
fnjob: record {
    # the function's type id: an instance's own for an instance
    fid: ztypes.tid
    # the node it is written from: an instance's own copy of a template
    # function, or a method's member
    nid: zast.nodeid
    # the file unit it belongs to, bound while it is written (ctxBindMain)
    unitDecl: ztypes.declid
    # ctx.nsTid while it is written: the namespace unit it belongs to, 0 for the
    # file unit's own
    nsTid: ztypes.tid
    # the mono it is an instance of (ctx.curThisTid);
    # for a method, the instance of a method with type parameters of its own it
    # is; 0 for a plain function or method
    mono: ztypes.tid
    # a method, written as its owner's (emitOneMethod)
    method: bool
    # the type a method belongs to; 0 for a function
    owner: ztypes.tid
    # a method a unit body declares on a type of its own: its text goes with
    # the types' methods, ahead of the functions' (emitC)
    withMethods: bool
    # once written, where its forward declaration and its definition lie in the
    # text the jobs are written into (drainFnJobs)
    protoAt: u64
    protoEnd: u64
    bodyAt: u64
    bodyEnd: u64
    # written C spells it (noteFnUse)
    queued: bool
    # it is written, or being written (writeFnJob)
    written: bool
}

# planFnJob -- record one function the walk met, under the unit binding and
# namespace ctx holds now.
planFnJob: function {ctx: Ctx fid: ztypes.tid nid: zast.nodeid mono: ztypes.tid} is {
    addFnJob :ctx :fid :nid :mono method: false owner: ztypes.tid.zero withMethods: false
}

# planMethodJob -- record one method of `owner` the walk met, as planFnJob
# does a function.
planMethodJob: function {
    ctx: Ctx
    fid: ztypes.tid
    nid: zast.nodeid
    owner: ztypes.tid
    mono: ztypes.tid
    withMethods: bool
} is {
    addFnJob :ctx :fid :nid :mono method: true :owner :withMethods
}

# addFnJob -- one job, under the unit binding and namespace ctx holds now,
# found by its type id; queued only when written C spells it (noteFnUse).
addFnJob: function {
    ctx: Ctx
    fid: ztypes.tid
    nid: zast.nodeid
    mono: ztypes.tid
    method: bool
    owner: ztypes.tid
    withMethods: bool
} is {
    k: ctx.fnJobs.length
    ctx.fnJobs.append (
        fnjob
        :fid
        :nid
        unitDecl: ctx.mainUnitId
        nsTid: ctx.nsTid
        :mono
        :method
        :owner
        :withMethods
        protoAt: 0
        protoEnd: 0
        bodyAt: 0
        bodyEnd: 0
        queued: false
        written: false
    )
    if fid.notZero then ctx.fnJobAt.set key: fid value: k
}

# noteFnUse -- written C spells the function `tid`: queue its job, if it has
# one. Once the written functions are fixed it must be one of them, or the C
# names a function that is never written.
noteFnUse: function {ctx: Ctx tid: ztypes.tid} is {
    ctx.fnSpelled.add item: tid
    at: ctx.fnJobAt.get key: tid
    if at.none then return
    j: ctx.fnJobs.get i: at
    if j.queued then return
    if ctx.fnClosed then {
        cn: ctxCname :ctx :tid
        (
            emitFail
            :ctx
            what: "function \{cn} spelled after the written functions were fixed, and not among them"
            line: 0
        )
        return
    }
    j.queued = true
    ctx.fnJobs.set i: at val: j
}

# drainFnJobs -- write every queued job not yet written, lowest first, until a
# round queues nothing new: what one job's C spells is queued as it is written.
# The forward declarations go into `protos` and the definitions into `bodies`,
# which keep every job's text, in the order written.
drainFnJobs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    protos: String.borrow
    bodies: String.borrow
} is {
    sm: ctx.mainName.copy
    smD: ctx.mainUnitId
    sns: ctx.nsTid
    more: true
    for more loop {
        more = false
        k: u64
        for k < ctx.fnJobs.length loop {
            jk: ctx.fnJobs.get i: k
            if jk.queued when jk.written.not then {
                writeFnJob :ast :reg :typing :ctx :k :protos :bodies
                more = true
            }
            k = k + 1
        }
    }
    ctxBindMain :ctx name: sm.stringView unitDecl: smD
    ctx.nsTid = sns
}

# writeFnJob -- write job `k`, its forward declaration onto `protos` and its
# definition onto `bodies`, with ctx bound as the walk had it. An instance --
# of a generic function or of a unit template -- is written whole from its own
# copy of the template function, which its instance walk checked.
writeFnJob: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    k: u64
    protos: String.borrow
    bodies: String.borrow
} is {
    j: ctx.fnJobs.get i: k
    j.written = true
    ctx.fnJobs.set i: k val: j
    if j.unitDecl != ctx.mainUnitId then {
        un: zast.poolTextAt pool: ast.names ref: (typing.declNameOf declId: j.unitDecl)
        ctxBindMain :ctx name: un.stringView unitDecl: j.unitDecl
    }
    ctx.nsTid = j.nsTid
    pa: protos.length
    ba: bodies.length
    if j.method then {
        mop: ast.nodes.get i: j.nid
        (
            emitOneMethod
            :ast
            :reg
            :typing
            :ctx
            mid: j.fid
            thisTid: j.owner
            op: mop
            declOnly: true
            buf: protos
            mono: j.mono
        )
        (
            emitOneMethod
            :ast
            :reg
            :typing
            :ctx
            mid: j.fid
            thisTid: j.owner
            op: mop
            declOnly: false
            buf: bodies
            mono: j.mono
        )
    } else {
        op: ast.nodes.get i: j.nid
        appendFnSignature :ast :reg :typing :ctx fid: j.fid :op buf: protos tail: ";\n"
        appendFnSignature :ast :reg :typing :ctx fid: j.fid :op buf: bodies tail: " {\n"
        resetFnEmitState :ctx
        registerReftypeParams :ast :reg :typing :ctx fid: j.fid :op
        ctx.curThisTid = j.mono
        emitFnBody :ast :reg :typing :ctx :op fid: j.fid buf: bodies
        ctx.curThisTid = ztypes.tid.zero
        bodies.append "}\n\n"
    }
    j.protoAt = pa
    j.protoEnd = protos.length
    j.bodyAt = ba
    j.bodyEnd = bodies.length
    ctx.fnJobs.set i: k val: j
}

# writeDemanded -- write every function, method and static value written C
# spells, starting from `main`'s job (planFns), until a round spells nothing
# new: the jobs (drainFnJobs), the static values, whose items may spell
# functions (writeDemandedAggs), and the methods only the types' helpers call
# (demandHelperCalls). After it the written functions and static values are
# fixed.
writeDemanded: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    protos: String.borrow
    bodies: String.borrow
} is {
    drainFnJobs :ast :reg :typing :ctx :protos :bodies
    preview: IdSet ztypes.tid
    more: true
    for more loop {
        aggs: writeDemandedAggs :ast :reg :typing :ctx
        helpers: demandHelperCalls :ast :reg :typing :ctx :preview
        more = aggs or helpers
        if more then drainFnJobs :ast :reg :typing :ctx :protos :bodies
    }
    ctx.fnClosed = true
    ctx.aggsFixed = true
}

# appendWrittenFns -- the forward declarations, or the definitions, of the
# written jobs from `text` (drainFnJobs' `protos` or `bodies`), in the order
# planFns met them: the units' type methods, or the rest.
appendWrittenFns: function {
    ctx: Ctx.view
    protos: bool
    withMethods: bool
    text: StringView
    buf: String.borrow
} is {
    for each j: ctx.fnJobs loop {
        if j.withMethods != withMethods then continue
        if protos then {
            buf.append (text.substring from: j.protoAt to: j.protoEnd)
        } else {
            buf.append (text.substring from: j.bodyAt to: j.bodyEnd)
        }
    }
}

# demandHelperCalls -- queue the methods the author wrote that only generated
# C written after the functions are fixed calls: a container's element and key
# methods (demandContainerCalls), the `==` and `hash` of a part a generated
# `_eq` or `_hash` compares, and the impl methods a boxed implementation's
# wrappers call (emitImplementationImpl). Asked of the types reached so far, which
# `preview` keeps from one call to the next (reachPreview); true when it queued
# a job, whose C may reach more.
demandHelperCalls: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    preview: IdSet ztypes.tid
} out bool is {
    before: queuedFnCount :ctx
    seen: IdSet ztypes.tid
    seenHash: IdSet ztypes.tid
    for each r: (reachPreview :reg :typing :ctx seen: preview) loop {
        demandContainerCalls :ast :reg :typing :ctx tid: r :seen :seenHash
    }
    es: ListVal ztypes.tid
    for each e: ctx.eqUsed loop es.append e
    for each e: es loop demandEqCalls :ast :reg :typing :ctx tid: e :seen
    hs: ListVal ztypes.tid
    for each h: ctx.hashAsked loop hs.append h
    for each h: hs loop demandHashCalls :ast :reg :typing :ctx tid: h seen: seenHash
    ri: ztypes.confid
    for ri.next < typing.nextConf loop {
        ri = ri.next
        if (ctx.boxedImplementation.has item: ri).not then continue
        row: typing.implementation.get i: ri
        demandImplCalls :ast :reg :typing :ctx implTid: row.implTypeId specTid: row.specTypeId
    }
    return (queuedFnCount :ctx) != before
}

# demandContainerCalls -- the element and key methods the author wrote that a
# container mono `tid` calls: the element `==` its template compares with
# (templateEqElem), a List's (demandListElemCalls), and a Set's or Map's key
# `hash` and `==` (emitSetMono, emitMapMono).
demandContainerCalls: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    seen: IdSet ztypes.tid
    seenHash: IdSet ztypes.tid
} is {
    el: templateEqElem :reg :typing :ctx :tid
    if el.notZero then demandEqCalls :ast :reg :typing :ctx tid: el :seen
    if (isListOriginOf :reg :ctx :tid) then demandListElemCalls :ast :reg :typing :ctx monoId: tid
    k: ztypes.tid
    if (isSetOriginOf :reg :ctx :tid) then k = setElemType :typing monoId: tid
    if (isMapOriginOf :reg :ctx :tid) then k = mapKeyType :typing monoId: tid
    if k.notZero then demandKeyCalls :ast :reg :typing :ctx :tid key: k :seen :seenHash
}

# demandKeyCalls -- the `==` and `hash` of the key `key` a Set or Map instance
# `tid` calls: only a member that looks a key up spells them
demandKeyCalls: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    key: ztypes.tid
    seen: IdSet ztypes.tid
    seenHash: IdSet ztypes.tid
} is {
    k: key
    kind: keyHashKind :reg :typing :ctx tid: k
    eqK: keyEqSpelled :reg :ctx :tid
    hashK: keyHashSpelled :reg :ctx :tid
    if (isValKey :reg key: k :kind) then {
        if eqK then demandEqCalls :ast :reg :typing :ctx tid: k :seen
        if hashK then demandHashCalls :ast :reg :typing :ctx tid: k seen: seenHash
        return
    }
    if kind != 0 then return
    dh: declaredKeyFnId :reg :typing :ctx keyTid: k nid: zast.wellKnown.slot.wkHash
    de: declaredKeyFnId :reg :typing :ctx keyTid: k nid: zast.wellKnown.slot.wkOpEq
    if dh.notZero when de.notZero then {
        if hashK then noteFnUse :ctx tid: dh
        if eqK then noteFnUse :ctx tid: de
    }
}

# demandListElemCalls -- the element methods the author wrote that a List
# mono's written members call: a reference element's `==` in `contains`
# (emitListContains), and the `compare` its `sort` orders by (sortLessC).
demandListElemCalls: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
} is {
    elem: listElemType :reg :typing :monoId
    if elem.isZero then return
    if (reg.isValtypeOf tid: elem).not when (
        memberUsed
        :ctx
        mono: monoId
        member: memberWord.slot.contains
    ) then noteFnUse :ctx tid: (refElemEqFid :typing :elem)
    if (memberUsed :ctx mono: monoId member: memberWord.slot.sort) when (
        sortCallsWritten
        :ast
        :reg
        :typing
        :elem
    ) then noteFnUse :ctx tid: (sortCompareFid :reg :typing :elem)
}

# fnJobUnwritten -- `tid` is a function the program's units could write and
# written C never called, so none of it is in the C.
fnJobUnwritten: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    at: ctx.fnJobAt.get key: tid
    if at.none then return false
    return (ctx.fnJobs.get i: at).written.not
}

# queuedFnCount -- the function jobs written C has spelled so far.
queuedFnCount: function {ctx: Ctx.view} out u64 is {
    n: u64
    for each j: ctx.fnJobs loop {
        if j.queued then n = n + 1
    }
    return n
}

# reachPreview -- the types written C reaches so far that `seen` lacks, added to
# it: what it spelled, closed over what each one's C spells (drainReach),
# without touching the reached set.
reachPreview: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx.view seen: IdSet ztypes.tid
} out ListVal ztypes.tid is {
    added: ListVal ztypes.tid
    todo: ListVal ztypes.tid
    for each u: ctx.typeUses loop {
        if (seen.has item: u).not then todo.append u
    }
    for todo.length > 0 loop {
        t: todo.pop
        if (seen.has item: t) then continue
        seen.add item: t
        added.append t
        at: todo.length
        typeReachEdges :reg :typing :ctx tid: t acc: todo
        keepReachEdges :typing reached: seen :todo from: at
    }
    return added
}

# demandEqCalls -- comparing a `tid` with its own `==` calls the author's
# method when the author wrote one (partEqC), and each part's otherwise.
demandEqCalls: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    seen: IdSet ztypes.tid
} is {
    if (seen.has item: tid) then return
    seen.add item: tid
    src: (
        ztypecheck.valOpSource
        :ast
        :reg
        :typing
        :tid
        nameId: zast.wellKnown.slot.wkOpEq
    )
    if src.written or src.negated then {
        opId: zast.wellKnown.slot.wkOpEq
        if src.negated then opId = zast.wellKnown.slot.wkOpNe
        owner: ztypecheck.valOpOwner :typing :tid nameId: zast.wellKnown.slot.wkOpEq
        fo: typing.declChildOfId parentTypeId: owner nameId: opId
        noteFnUse :ctx tid: (fo.or d: ztypes.tid.zero)
        return
    }
    if src.generated.not then return
    parts: ListVal ztypes.tid
    ztypecheck.valPartTids :reg :typing :tid :parts
    for each p: parts loop demandEqCalls :ast :reg :typing :ctx tid: p :seen
}

# demandHashCalls -- hashing a `tid` calls the author's `hash` when the author
# wrote one (partHashWords), and each part's otherwise.
demandHashCalls: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    seen: IdSet ztypes.tid
} is {
    if (seen.has item: tid) then return
    seen.add item: tid
    src: (
        ztypecheck.valOpSource
        :ast
        :reg
        :typing
        :tid
        nameId: zast.wellKnown.slot.wkHash
    )
    if src.written then {
        owner: ztypecheck.valOpOwner :typing :tid nameId: zast.wellKnown.slot.wkHash
        fo: typing.declChildOfId parentTypeId: owner nameId: zast.wellKnown.slot.wkHash
        noteFnUse :ctx tid: (fo.or d: ztypes.tid.zero)
        return
    }
    if src.generated.not then return
    parts: ListVal ztypes.tid
    ztypecheck.valPartTids :reg :typing :tid :parts
    for each p: parts loop demandHashCalls :ast :reg :typing :ctx tid: p :seen
}

# demandImplCalls -- the impl methods an implementation row's wrappers call: one
# per spec method the vtable has a slot for (emitImplementationImpl).
demandImplCalls: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    implTid: ztypes.tid
    specTid: ztypes.tid
} is {
    mnames: List String
    mids: ListVal ztypes.tid
    midsNm: ListVal zast.nameid
    protoChildMethods :ast :reg :typing tid: specTid names: mnames ids: mids nameIds: midsNm
    i: u64
    for i < mids.length loop {
        smid: mids.get :i
        mnameId: midsNm.get :i
        i = i + 1
        if (specMemberIsSelfTyped :ast :reg :typing ifaceTid: specTid :smid) then continue
        owner: ztypecheck.valOpOwner :typing tid: implTid nameId: mnameId
        imo: typing.declChildOfId parentTypeId: owner nameId: mnameId
        noteFnUse :ctx tid: (imo.or d: ztypes.tid.zero)
    }
}

# entryMainTid -- the function the unit ctx is bound to declares as `main`; 0
# when it declares none.
entryMainTid: function {typing: ztyping.ZTyping.view ctx: Ctx.view} out ztypes.tid is {
    if ctx.mainUnitId.isZero then return ztypes.tid.zero
    md: typing.declFindChild parentDeclId: ctx.mainUnitId nameId: zast.wellKnown.slot.wkMain
    if md.isZero then return ztypes.tid.zero
    return (typing.declTypeOf declId: md)
}


# instanceOpAt -- the function node instance `mono` is emitted from: its own
# copy of the template function `op`, which its instance walk checked
# (instanceBody); `op` itself when the instance has none.
instanceOpAt: function {
    typing: ztyping.ZTyping.view mono: ztypes.tid op: zast.nodeid
} out zast.nodeid is {
    return ((typing.instanceBody.get key: (ztyping.monostamp :mono node: op)).or d: op)
}

# planFnMonoInstances -- the monomorphized instances of a generic free function
# (identity_i64, identity_f64, first_i64_f64, ...). Each instance was minted by
# the typechecker (mintMono, params already substituted): one job per registry
# FUNCTION whose generic origin is this template, keyed by the mono FUNCTION id
# (concrete signature), written from the instance's own copy of the template
# body (instanceOpAt).
planFnMonoInstances: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    templateFnId: ztypes.tid
    templateFnOpId: zast.nodeid
} is {
    last: reg.nextTid
    t: ztypes.tid
    for t < last loop {
        isMono: false
        if (reg.typetypeOf typeId: t) == ztypes.ztypetype.functionType then {
            origin: originTidOf :reg tid: t
            if origin == templateFnId when origin.notZero then isMono = true
        }
        if isMono then {
            planFnJob :ctx fid: t nid: (instanceOpAt :typing mono: t op: templateFnOpId) mono: t
        }
        t = t.next
    }
}

# planNestedUnitFns -- a nested unit's own functions and mono instances, which
# are children of IT rather than of the file unit, so they are planned by
# recursing with the nested namespace as the owner.
planNestedUnitFns: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    bodyIds: zast.kidspan
    ownerTid: ztypes.tid
} is {
    for each itemId: (zast.kidsOf :ast span: bodyIds) loop {
        ium: ast.nodes.get i: itemId
        if ium.namedoperation then {
            iuOpId: ium.operation
            if (isGenericTemplateUnitOp :ast opId: iuOpId) then {
                (
                    planUnitMonoInstances
                    :reg
                    :typing
                    :ast
                    :ctx
                    tplId: (stampIdOf :typing nid: iuOpId)
                    templateUnitOpId: iuOpId
                )
            }
            isNs: false
            if (zast.unitOpDeclaresUnit :ast opId: iuOpId) then isNs = true
            # a `public:` block that DEFINES no function of its own has
            # nothing to plan here (its entries name the unit's siblings)
            if isNs when (zast.unitOpKindIs :ast opId: iuOpId k: zast.unitkind.publicNs) when (
                unitOpHasBodiedFn
                :ast
                opId: iuOpId
            ).not then isNs = false
            if isNs then {
                nsTid: ztypes.tid
                {
                    ownr: ownerTid
                    if ownr.isZero then {
                        ownr = mainUnitTid :typing :ctx
                    }
                    no: typing.declChildOfId parentTypeId: ownr nameId: ium.name
                    if no.some then {
                        nsTid = no
                    }
                }
                if nsTid.notZero then {
                    sns: ctx.nsTid
                    ctx.nsTid = nsTid
                    planFnsIn :ast :reg :typing :ctx mainOpId: iuOpId ownerTid: nsTid
                    ctx.nsTid = sns
                }
            }
        }
    }
}

# collectFnDecls -- the bodied, demanded function declarations of this unit, in
# source order, as their body-list indices.
collectFnDecls: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    bodyIds: zast.kidspan
    ownerTid: ztypes.tid
    idxs: ListVal u64
} is {
    di: u64
    for each bmId: (zast.kidsOf :ast span: bodyIds) loop {
        bm: ast.nodes.get i: bmId
        if bm.namedoperation when (
            ztypecheck.isFunctionDefWithBody
            o: (ast.nodes.get i: bm.operation)
        ) then {
            # a runtime-backed unit's bodied fn only emits when the
            # program referenced it (undemanded bodies carry no stamps)
            skipDepMain: (
                (
                    fnUndemanded
                    :ast
                    :typing
                    unitDecl: ctx.mainUnitId
                    nameId: bm.name
                    :ownerTid
                    wantWalked: true
                ) or
                (
                    (bm.name == zast.wellKnown.slot.wkMain) and
                    (ctx.mainName.stringView != ctx.realMain)
                )
            )
            if skipDepMain.not then {
                dv: di
                idxs.append dv
            }
        }
        di = di + 1
    }
}

# planFnDecls -- one job per collected declaration, or one per instance of a
# generic one.
planFnDecls: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    bodyIds: zast.kidspan
    ownerTid: ztypes.tid
    idxs: (ListVal u64).view
} is {
    for each didx: idxs loop {
        dm2Id: zast.kidAt kids: ast.kids span: bodyIds i: didx
        dm2: ast.nodes.get i: dm2Id
        if dm2.namedoperation.not then continue
        fid: unitMemberTid :typing :ctx :ownerTid nameId: dm2.name
        if (isGenericFnTid :reg tid: fid) then {
            planFnMonoInstances :reg :typing :ctx templateFnId: fid templateFnOpId: dm2.operation
        } else {
            planFnJob :ctx :fid nid: dm2.operation mono: ztypes.tid.zero
        }
    }
}


# planFnsIn -- a unit's functions: those of the units nested in it first, then
# its own.
planFnsIn: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    mainOpId: zast.nodeid
    # the unit whose functions these are: 0 for the file unit ctx is bound to,
    # whose children the name-keyed lookup below already answers for, and the
    # namespace's own type id for a nested unit -- whose functions are children
    # of IT, so resolving them against the file unit misses and hands the
    # signature a tid of 0, which renders as `z_t0(void)`.
    ownerTid: ztypes.tid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: mainOpId
    planNestedUnitFns :ast :reg :typing :ctx :bodyIds :ownerTid
    idxs: ListVal u64
    collectFnDecls :ast :typing :ctx :bodyIds :ownerTid :idxs
    planFnDecls :ast :reg :typing :ctx :bodyIds :ownerTid :idxs
}

# unitOpHasBodiedFn -- does the unit body at `opId` define a function with a
# body among its own entries?
unitOpHasBodiedFn: function {ast: Ast.view opId: zast.nodeid} out bool is {
    ids: zast.unitBodyIdsAt :ast unitId: opId
    for each mId: (zast.kidsOf :ast span: ids) loop {
        m: ast.nodes.get i: mId
        if m.namedoperation when (
            ztypecheck.isFunctionDefWithBody
            o: (ast.nodes.get i: m.operation)
        ) then return true
    }
    return false
}

# isBareCName -- true if s is a plain C identifier (only [A-Za-z0-9_]); such a
# return value is a bare local whose scope cleanup can safely run before the
# return. A compound expression (call / deref / field / cast) must be hoisted
# into a temp first, handled separately.
isBareCName: function {s: StringView} out bool is {
    if s.length == 0 then return false
    i: u64
    for i < s.length loop {
        bo: s.byteAt i
        match (
            bo
        ) case some then {
            ok: (
                (bo >= 48) and
                (bo <= 57) or
                ((bo >= 65) and (bo <= 90)) or
                ((bo >= 97) and (bo <= 122)) or
                (bo == 95)
            )
            if ok.not then return false
        } case none then {
            return false
        }
        i = i + 1
    }
    return true
}

# slotReadableName -- a vtable slot's member name as C identifier text, for the
# readable suffix of its C name (memberC under --readable-names). An OPERATOR
# member (`==`, `<=`, ...) is not a C identifier; its spelling comes from
# opCnameOf, the table the implementation's own C name is built from, and any
# operator the table misses falls back to its bytes, which stays unique.
slotReadableName: function {name: StringView ow: zast.Vocab.view} out String is {
    if (isBareCName s: name) then return name.string
    op: opCnameOf :ow :name
    if op.length > 0 then return op
    result: "op".string
    i: u64
    for i < name.length loop {
        bo: name.byteAt i
        if bo.some then {
            seg: "_\{bo}"
            result.append seg
        }
        i = i + 1
    }
    return result
}

# ctEndsWithStar -- true if the C type string ends in '*' (a pointer return:
# union, protocol, Map/Set, or a user reftype passed by reference). Takes a `ct`
# param so `.length`/`.byteAt` emit as field/method ops (a chained `.stringView`
# receiver mis-emits a free function call).
ctEndsWithStar: function {ct: StringView} out bool is {
    if ct.length == 0 then return false
    lb: (ct.byteAt ct.length - 1).or d: 0
    if lb == 42 then return true
    return false
}

# isIdChar -- a C-identifier byte [A-Za-z0-9_].
isIdChar: function {b: u8} out bool is {
    return (
        (b >= 48) and
        (b <= 57) or
        ((b >= 65) and (b <= 90)) or
        ((b >= 97) and (b <= 122)) or
        (
            b == 95
        )
    )
}

# boxedLocalNeedsZero -- the value at `nid`, moved into an option's box, is a
# bare local of the checker's that a destroy still reaches
# (movedSourceNeedsZero): it is zeroed, so that destroy frees nothing.
boxedLocalNeedsZero: function {
    ast: Ast.view typing: ztyping.ZTyping.view nid: zast.nodeid
} out bool is {
    if nid.isZero then return false
    n: ast.nodes.get i: nid
    if (isBareNameValue :n).not then return false
    if (atomVid :typing nid: (interpPartNodeId :n)).isZero then return false
    return (movedSourceNeedsZero :ast :typing :n)
}

# emitReturnCleanup -- the destroys owed BEFORE a return, on the diverging path
# the function-end destroys never reach: the emitter's own temporaries
# registered in the function, then the locals the checker recorded the return
# destroys (emitExitDestroy). Does NOT pop
# (other returns and the end still owe them). A return the checker recorded
# nothing for (ctx.exitNode 0) is refused: a local it moved is zeroed only
# where the checker says a path still destroys it.
emitReturnCleanup: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tmp: TmpCtr.view
    ind: StringView
    buf: String.borrow
} is {
    allRows: ctx.exitNode.isZero
    if allRows then (
        emitFail
        :ctx
        what: "a return whose destroys the checker did not record".string
        line: 0
    )
    for each owed: tmp.listFrees loop buf.append owed.stmt
    if allRows.not then emitExitDestroy :ast :reg :typing :ctx :ind :buf
}

# emit a function's body.
emitFnBody: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    op: astnode.view
    fid: ztypes.tid
    buf: String.borrow
} is {
    rbt: fnReturnTidOf :reg tid: fid
    ctx.refBorrowRet = fnReturnsRefBorrow :reg :typing :ctx :fid retTid: rbt
    if op.functiondef.not then return
    tmp: TmpCtr n: 0 listFrees: List OwedFree
    # temp numbers are the function's: a body emitted while another is under
    # way counts from zero and hands the outer one's count back
    outerTmpHigh: ctx.tmpHigh
    ctx.tmpHigh = 0
    outerOrderCtr: ctx.orderCtr
    ctx.orderCtr = 0
    outerReturned: ctx.returnEmitted
    ctx.returnEmitted = false
    for each pcmId: (zast.kidsOf :ast span: op.parameters) loop {
        pcm: ast.nodes.get i: pcmId
        if pcm.namedoperation then (
            emitRepointCompanion
            :ast
            :reg
            :typing
            :ctx
            vid: (paramVidIn :ast :typing params: op.parameters nameId: pcm.name)
            ind: "    "
            :buf
        )
    }
    endsRet: false
    if op.body.notZero then {
        opb: ast.nodes.get i: op.body
        # a declared result puts the last statement in return position, whatever
        # form the type is written in -- `u8` and `(ListVal u64)` alike
        if op.returntype.notZero when ctx.genActive.not then ctx.tailRetActive = true
        ctx.tailReturned = false
        emitBodyNode :ast :reg :typing :ctx n: opb ind: "    " :tmp :buf
        ctx.tailRetActive = false
        endsRet = ctx.tailReturned or (blockDiverges :ast :reg :typing :ctx n: opb)
    }
    ctx.tmpHigh = outerTmpHigh
    ctx.orderCtr = outerOrderCtr
    ctx.returnEmitted = outerReturned
    # a body that diverges on every path never reaches this flush; the
    # return/break cleanups already freed the same locals on those paths
    if endsRet then return
    emitBodyEndFrees :ast :reg :typing :ctx :tmp node: op.nodeid :buf
}

# emitBodyEndFrees -- what a function body's fall-through end frees: the
# emitter's own temporaries, then the locals the checker recorded the body's end
# destroys (emitScopeDestroy).
emitBodyEndFrees: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tmp: TmpCtr
    node: zast.nodeid
    buf: String.borrow
} is {
    for each owed: tmp.listFrees loop buf.append owed.stmt
    emitScopeDestroy :ast :reg :typing :ctx :node ind: "    " :buf
}

# collectUnitLiterals -- pool the plain literals of every main-unit
# function body.
collectUnitLiterals: function {
    program: Ast.view
    typing: ztyping.ZTyping.view
    ids: ListVal zast.nodeid
    texts: List String
} is {
    {
        for each uId: program.units loop {
            opId: zast.nodeid
            uNameId: zast.nameid
            u: program.nodes.get i: uId
            if u.namedoperation then {
                opId = u.operation
                uNameId = u.name
            }
            if opId.notZero then {
                (
                    collectUnitLiteralsIn
                    ast: program
                    mainOpId: opId
                    :typing
                    unitDecl: (ztypecheck.unitDeclOfName :typing nameId: uNameId)
                    :ids
                    :texts
                )
            }
        }
    }
    # every generic instance's own copy of a body, in the order they were made
    for each fnRow: typing.instanceFunctions loop {
        fnv: program.nodes.get i: fnRow
        if fnv.functiondef when fnv.body.notZero then (
            collectLiterals
            ast: program
            n: (program.nodes.get i: fnv.body)
            :ids
            :texts
        )
    }
}

# collect a unit's string literals for the literal pool.
collectUnitLiteralsIn: function {
    ast: Ast.view
    mainOpId: zast.nodeid
    typing: ztyping.ZTyping.view
    # the unit's declaration
    unitDecl: ztypes.declid
    ids: ListVal zast.nodeid
    texts: List String
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: mainOpId
    for each bm: (zast.kidsOf :ast span: bodyIds) loop {
        bmNode: ast.nodes.get i: bm
        if bmNode.namedoperation then {
            skipU: (
                fnUndemanded
                :ast
                :typing
                :unitDecl
                nameId: bmNode.name
                ownerTid: ztypes.tid
                wantWalked: false
            )
            if skipU.not then (
                collectFnLiterals
                :ast
                n: (ast.nodes.get i: bmNode.operation)
                :ids
                :texts
            )
        }
    }
}

# collect a function's string literals for the literal pool.
collectFnLiterals: function {
    ast: Ast.view
    n: astnode.view
    ids: ListVal zast.nodeid
    texts: List String
} is {
    match (
        n
    ) case functiondef then {
        if n.body.notZero then collectLiterals :ast n: (ast.nodes.get i: n.body) :ids :texts
    } case objectdef then {
        for each imId: (zast.kidsOf :ast span: n.isItems) loop {
            im: ast.nodes.get i: imId
            if im.namedoperation then {
                collectFnLiterals :ast n: (ast.nodes.get i: im.operation) :ids :texts
            }
        }
        for each amId: (zast.kidsOf :ast span: n.asItems) loop {
            am: ast.nodes.get i: amId
            if am.namedoperation then {
                collectFnLiterals :ast n: (ast.nodes.get i: am.operation) :ids :texts
            }
        }
    } case unitdef then {
        for each ubm: (zast.kidsOf :ast span: n.body) loop {
            ubn: ast.nodes.get i: ubm
            if ubn.namedoperation then {
                collectFnLiterals :ast n: (ast.nodes.get i: ubn.operation) :ids :texts
            }
        }
    } else null
}

# litView -- pooled source literal `li` (1-based in litIds) as a C value: a
# view built in place over the pooled bytes, its length a constant, so no
# descriptor object is emitted beside them
litView: function {ctx: Ctx li: u64} out String is {
    sz: ctx.litSizes.get i: li - 1
    svT: svTypeC :ctx
    return "((\{svT}){ .data = _zs\{li}_d, .size = \{sz} })"
}

# constLitView -- folded-string pool entry `ci` (1-based) as a C value, built in
# place as litView builds a source literal
constLitView: function {ctx: Ctx ci: u64} out String is {
    sz: (ctx.constLits.get i: ci - 1).length
    svT: svTypeC :ctx
    return "((\{svT}){ .data = _zcs\{ci}_d, .size = \{sz} })"
}

# emitLiteralPools -- the two string pools, written ahead of the code they serve:
# the source literals, filtered to the ones an emission actually referenced, and
# the folded-constant pool, whose every entry was minted BY an emission and so
# has nothing unused to skip.
emitLiteralPools: function {
    ctx: Ctx.view
    litTexts: (List String).view
    poolBuf: String.borrow
} is {
    pi: u64
    pn: ctx.litIds.length
    for pi < pn loop {
        plid: ctx.litIds.get i: pi
        if (ctx.usedLits.has item: plid) then {
            pt: litTexts.get i: pi
            ptv: pt.stringView
            pesc: cEscape text: ptv
            pidx: pi + 1
            poolDataDecl: "static const char _zs\{pidx}_d[] = \"\{pesc}\";\n"
            poolBuf.append poolDataDecl
        }
        pi = pi + 1
    }
    # the folded-string pool, written after the literal one and into the same
    # buffer, so both precede the code. Every entry here was minted BY an
    # emission that asked for it, so there is nothing unused to skip.
    ci: u64
    constCount: ctx.constLits.length
    for ci < constCount loop {
        cTypeText: ctx.constLits.get i: ci
        ctv: cTypeText.stringView
        cesc: cEscape text: ctv
        cidx: ci + 1
        constDataDecl: "static const char _zcs\{cidx}_d[] = \"\{cesc}\";\n"
        poolBuf.append constDataDecl
        ci = ci + 1
    }
}

# assembleEmitOutput -- the file's final order: the prelude fragment (a unit of its
# own precisely because a need registered inside a type method is still in time
# for it, and no codeBuf walk may claim it), then the literal pools, the code, the
# function bodies, the process start (z_start.inc) and C's `main`.
assembleEmitOutput: function {
    program: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    buf: String.borrow
    poolBuf: StringView
    codeBuf: StringView
    fnsBuf: StringView
} is {
    # the hash functions are the last C generated, so the runtime they call is
    # demanded ahead of the prelude below
    hashDefs: String
    emitHashDefs ast: program :reg :typing :ctx buf: hashDefs
    # every body has emitted by now, so a need registered inside a type
    # method -- which emits after the runtime pass -- is still in time. This is
    # why `prelude` is a unit of its own: it goes into the header, ahead of the
    # literal pool, and no codeBuf walk may claim it.
    {
        (
            emitRuntimeUnit
            ast: program
            :reg
            :typing
            :ctx
            uname: "prelude"
            :buf
        )
    }
    (
        buf.reserve
        n: (
            poolBuf.length +
            codeBuf.length +
            fnsBuf.length +
            ctx.lateDefs.length +
            hashDefs.length +
            4096
        )
    )
    buf.append poolBuf
    buf.append "\n"
    buf.append codeBuf
    buf.append fnsBuf
    buf.append ctx.lateDefs
    buf.append hashDefs
    ps: fileKey :ctx name: "start"
    buf.append (loadFixedFile :ctx key: ps)
    buf.append "int main(int argc, char* argv[]) {\n"
    if (
        stdDeclDemanded
        ast: program
        :reg
        :typing
        :ctx
        stdUnit: zast.wellKnown.slot.unOs
        member: zast.wellKnown.slot.wkArgs
    ) then {
        buf.append "    z_os_args_init(argc, argv);\n"
    }
    buf.append "    z_start();\n"
    buf.append "    z_main();\n"
    preludeNeed :ctx memb: "@end"
    buf.append "    z_end();\n"
    buf.append "    return 0;\n"
    buf.append "}\n"
}

# emitCHeader -- the file's fixed header: the link libraries the reached units
# declared (so whatever drives the compiler reads them off the artifact instead
# of being told separately), then the prelude -- the feature macros and the
# includes (z_head.inc), z_panic, and the allocator wrappers everything else is
# built on (z_alloc.inc). The prelude is the same bytes in every program but
# for z_panic, which is the `@prelude.panic` row's fragment: a threaded
# program's differs, and for the pieces each program's C calls (loadPieces).
emitCHeader: function {
    libs: (List String).view
    # the C sources to build and link, one `zcsrc:` line each (applyUnitReqs)
    csrcs: (List String).view
    # the fragment z_panic is written from
    panicFrag: StringView
    ctx: Ctx
    buf: String.borrow
} is {
    # the link libraries the reached units declared, so whatever drives the C
    # compiler -- zc itself, the corpus runner, a hand-run cc -- reads them off
    # the artifact instead of being told separately. Fixed line, always present.
    buf.append "/* zlink:"
    for each lib: libs loop {
        buf.append " "
        buf.append lib
    }
    buf.append " */\n"
    # the C sources the reached units need built and linked, one line each,
    # only when there are any. The line names the SOURCE and its defines, not an
    # object: the object depends on the compiler that links, which emitting C
    # does not know (zc cobj resolves it)
    for each cs: csrcs loop {
        buf.append "/* zcsrc: "
        buf.append cs
        buf.append " */\n"
    }
    buf.append "\n"
    p0: fileKey :ctx name: "head"
    buf.append (loadFixedFile :ctx key: p0)
    p1: fragKey :ctx name: panicFrag
    buf.append (loadFixedFile :ctx key: p1)
    p2: fileKey :ctx name: "alloc"
    buf.append (loadFixedFile :ctx key: p2)
}

# placePanicRow -- the row of z_panic's fragment, the one the table chose (a
# threaded program's differs), is written by the header, in its slot: no unit
# walk writes it. Every other piece row was placed as its reader read it.
placePanicRow: function {ctx: Ctx} is {
    pr: panicRow :ctx
    if pr > 0 then ctx.rowsInPlace.add item: pr
}

# panicRow -- the prelude's `@panic` row, whose fragment is z_panic's; 0 when
# the prelude has none
panicRow: function {ctx: Ctx.view} out u64 is {
    p: ctx.demands.names.find s: "prelude"
    n: ctx.demands.names.find s: "@panic"
    if p.isZero or n.isZero then return 0
    return (ctx.rows.helperOf k: (zemitrows.demandkey owner: p name: n))
}

# memberKey -- the key a template member is recorded by: its instance, and its
# slot in memberWord (fewer than 128 words)
memberKey: function {mono: ztypes.tid member: u64} out u64 is {
    return mono.u64 * 128 + member
}

# memberUsed -- written C calls template member `member` of instance `mono`
memberUsed: function {ctx: Ctx.view mono: ztypes.tid member: u64} out bool is {
    return (ctx.memberUses.has item: (memberKey :mono :member))
}

# noteMemberUse -- written C calls template member `member` (a memberWord
# slot) of instance `mono`: the instance writes its section. A member its
# instance was already written without names a function the C never defines.
noteMemberUse: function {ctx: Ctx mono: ztypes.tid member: u64} is {
    k: memberKey :mono :member
    if (ctx.memberUses.has item: k) then {
        if (memberHasCond :ctx key: k) then ctx.memberAlways.add item: k
        return
    }
    addMemberUse :ctx :mono :k
}

# addMemberUse -- record member key `k` of instance `mono` as used. A member its
# instance was already written without names a function the C never defines.
addMemberUse: function {ctx: Ctx mono: ztypes.tid k: u64} is {
    if (ctx.membersLeftOut.has item: k) then {
        cn: ctxCname :ctx tid: mono
        (
            emitFail
            :ctx
            what: "a template member of \{cn} called after its instance was written"
            line: 0
        )
        return
    }
    ctx.memberUses.add item: k
}

# noteMemberUseCond -- noteMemberUse under `cond`: the section is written inside
# `#if` while every use of the member holds in fewer than every configuration
noteMemberUseCond: function {ctx: Ctx mono: ztypes.tid member: u64 cond: Cond.view} is {
    if cond.always then {
        noteMemberUse :ctx :mono :member
        return
    }
    k: memberKey :mono :member
    if (ctx.memberUses.has item: k) when (memberCondOf :ctx key: k).always then return
    cur: memberCondOf :ctx key: k
    if (ctx.memberUses.has item: k).not then cur = Cond always: false terms: ListVal u64
    if (condMerge dst: cur src: cond).not when (ctx.memberUses.has item: k) then return
    w: u64
    j: u64
    for j < ctx.memberConds.length loop {
        mc: ctx.memberConds.get i: j
        j = j + 1
        if mc.key == k then continue
        ctx.memberConds.set i: w val: mc
        w = w + 1
    }
    for ctx.memberConds.length > w loop ctx.memberConds.pop
    for each t: cur.terms loop ctx.memberConds.append (membercond key: k mask: t)
    if (ctx.memberUses.has item: k).not then addMemberUse :ctx :mono :k
}

# memberCondOf -- the condition member key `key` is used under
memberCondOf: function {ctx: Ctx.view key: u64} out Cond is {
    if (ctx.memberAlways.has item: key) then return condAlways
    c: Cond always: false terms: ListVal u64
    for each mc: ctx.memberConds loop {
        if mc.key == key then c.terms.append mc.mask
    }
    if c.terms.length == 0 then return condAlways
    return c
}

# memberHasCond -- member key `key` has a term: some use of it holds under a
# condition.
memberHasCond: function {ctx: Ctx.view key: u64} out bool is {
    for each mc: ctx.memberConds loop {
        if mc.key == key then return true
    }
    return false
}

# RtPlan -- which member sections of an instance's parsed template are written,
# and under what condition (rtSectionPlan), for rtRender to write
RtPlan: class {
    # the template
    id: rtid
    # per section, in text order: written
    kept: ListVal bool
    # per section, the condition it is written under, where some member of the
    # instance is used under one
    conds: List Cond
}

# rtSectionPlan -- the sections of template `id` instance `mono` writes: each one
# whose member written C calls, and those they need (closeSectionNeeds), each
# written one's needs registered and each left out recorded (membersLeftOut), in
# text order. Names and needs are read from the template: a fill changes no head.
rtSectionPlan: function {ctx: Ctx mono: ztypes.tid id: rtid} out RtPlan is {
    plan: RtPlan :id kept: ListVal bool conds: List Cond
    inf: ctx.rt.infos.get i: id
    if inf.pieceFrom == inf.pieceTo then return plan
    marks: ListVal u64
    rtKept :ctx :mono :id :marks kept: plan.kept
    # the sections' names and needs, not the C
    tt: (ctx.rt.heads.get i: id).copy
    text: tt.stringView
    # a section kept only for a call some configurations make is written
    # inside `#if`, and so is each section only it needs
    if (monoCondMembers :ctx :mono) then (
        sectionConds
        :ctx
        :mono
        :text
        :marks
        kept: plan.kept
        conds: plan.conds
    )
    planNeeds :ctx :mono :text :marks :plan
    return plan
}

# rtKept -- per member section of template `id`, in text order, whether instance
# `mono` writes it: written C calls its member, or a written section needs it
# (closeSectionNeeds), or it has no member (a section kept only where a type is
# reached, rtKeepReached); each section's name and needs as offsets in `marks`
rtKept: function {
    ctx: Ctx.view
    mono: ztypes.tid
    id: rtid
    # per section: name from, name to, needs from, needs to
    marks: ListVal u64
    kept: ListVal bool
} is {
    t: ctx.rt.heads.get i: id
    text: t.stringView
    inf: ctx.rt.infos.get i: id
    j: inf.pieceFrom
    for j < inf.pieceTo loop {
        pc: ctx.rt.pieces.get i: j
        j = j + 1
        marks.append pc.headFrom
        marks.append pc.nameTo
        marks.append pc.needsFrom
        marks.append pc.needsTo
        if pc.nameTo == pc.headFrom then {
            kept.append true
        } else {
            slot: ctx.memberWords.slotOf text: (text.substring from: pc.headFrom to: pc.nameTo)
            kept.append (ctx.memberUses.has item: (memberKey :mono member: slot))
        }
    }
    closeSectionNeeds :text :marks :kept
}

# rtKeepReached -- plan `plan` with each section whose `reached` key is `key`
# left out unless the program reaches the type the key names (`reached`). Asked
# after the plan, so a section its member keeps is not recorded as its member
# left out (planNeeds).
rtKeepReached: function {ctx: Ctx.view plan: RtPlan key: StringView reached: bool} is {
    if reached then return
    t: ctx.rt.heads.get i: plan.id
    hd: t.stringView
    inf: ctx.rt.infos.get i: plan.id
    j: inf.pieceFrom
    for j < inf.pieceTo loop {
        pc: ctx.rt.pieces.get i: j
        i: j - inf.pieceFrom
        j = j + 1
        if (hd.substring from: pc.reachedFrom to: pc.reachedTo) == key then (
            plan.kept.set
            :i
            val: false
        )
    }
}

# rtKeptPlan -- rtKept as a plan, for a question about the text instance `mono`
# writes (rtPlanSpells) that decides nothing
rtKeptPlan: function {ctx: Ctx.view mono: ztypes.tid id: rtid} out RtPlan is {
    plan: RtPlan :id kept: ListVal bool conds: List Cond
    marks: ListVal u64
    rtKept :ctx :mono :id :marks kept: plan.kept
    return plan
}

# rtRowPlan -- the pieces of fixed file `id` this program writes: a piece where
# its row fired, inside `#if` where the row holds under a condition
rtRowPlan: function {ctx: Ctx.view id: rtid} out RtPlan is {
    plan: RtPlan :id kept: ListVal bool conds: List Cond
    inf: ctx.rt.infos.get i: id
    j: inf.pieceFrom
    for j < inf.pieceTo loop {
        pc: ctx.rt.pieces.get i: j
        j = j + 1
        row: pc.row
        fired: false
        if row > 0 when (rowDemandFired :ctx :row) then fired = true
        plan.kept.append fired
        if fired when (rowAlways :ctx :row).not then {
            plan.conds.append (rowCond :ctx :row)
        } else {
            plan.conds.append condAlways
        }
    }
    return plan
}

# planNeeds -- for each section of `plan`, in text order, the runtime a written
# one needs (sectionRowNeeds), under its condition, or the member a section left
# out names (membersLeftOut)
planNeeds: function {
    ctx: Ctx
    mono: ztypes.tid
    # the template
    text: StringView
    # each section's offsets (rtKept)
    marks: (ListVal u64).view
    plan: RtPlan.view
} is {
    i: u64
    for i < plan.kept.length loop {
        if (plan.kept.get :i) then {
            sc: Cond always: true terms: ListVal u64
            if i < plan.conds.length then {
                so: plan.conds.get :i
                sc.always = so.always
                for each t: so.terms loop sc.terms.append t
            }
            (
                sectionRowNeeds
                :ctx
                :text
                from: (marks.get i: i * 4 + 2)
                to: (marks.get i: i * 4 + 3)
                cond: sc
            )
        } else {
            slot: (
                ctx.memberWords.slotOf
                text: (text.substring from: (marks.get i: i * 4) to: (marks.get i: i * 4 + 1))
            )
            ctx.membersLeftOut.add item: (memberKey :mono member: slot)
        }
        i = i + 1
    }
}

# rtRender -- plan `plan`'s template as the instance writes it: the text outside
# its sections and each written section, inside `#if` where it is written under
# a condition, with the keys `keys` binds filled (rtRenderWith)
rtRender: function {ctx: Ctx.view plan: RtPlan.view keys: RtKeys.view} out String is {
    fails: List String
    return (
        rtRenderWith
        :ctx
        :plan
        :keys
        bindIds: ListVal zast.nameid
        bindVals: List String
        rawIds: ListVal zast.nameid
        rawVals: List String
        holes: false
        key: noText
        :fails
    )
}

# rtRenderWith -- rtRender, filling the holes from the bindings too when `holes`
# (fillSpan)
rtRenderWith: function {
    ctx: Ctx.view
    plan: RtPlan.view
    keys: RtKeys.view
    bindIds: (ListVal zast.nameid).view
    bindVals: (List String).view
    rawIds: (ListVal zast.nameid).view
    rawVals: (List String).view
    holes: bool
    # the text written, for its mark and the messages; noText for a row's body
    key: textkey
    fails: List String
} out String is {
    res: String
    path: textLabel :ctx :key
    rt: ctx.rt
    id: plan.id
    inf: rt.infos.get i: id
    total: (rt.texts.get i: id).length
    mk: openMark :ctx :key buf: res
    # a piece's mark was written last: the text's own is written again before
    # more of it
    pieceMarked: false
    pos: u64
    i: u64
    j: inf.pieceFrom
    for j < inf.pieceTo loop {
        pc: rt.pieces.get i: j
        j = j + 1
        pieceMarked = remarkText :ctx :mk :id from: pos to: pc.at after: pieceMarked buf: res
        (
            rt.fillSpan
            :id
            from: pos
            to: pc.at
            :keys
            :bindIds
            :bindVals
            :rawIds
            :rawVals
            :holes
            path: path.stringView
            :fails
            buf: res
        )
        if (plan.kept.get :i) then {
            pieceMarked = markPiece :ctx :mk :id :pc buf: res
            # a section written under a condition is filled apart, to wrap it
            wrapped: false
            if i < plan.conds.length then wrapped = (condAlwaysHolds c: (plan.conds.get :i)).not
            body: String
            if wrapped.not then body swap res
            (
                rt.fillSpan
                :id
                from: pc.bodyFrom
                to: pc.bodyTo
                :keys
                :bindIds
                :bindVals
                :rawIds
                :rawVals
                :holes
                path: path.stringView
                :fails
                buf: body
            )
            if wrapped then {
                wrapCond :ctx c: (plan.conds.get :i) body: body.stringView buf: res
            } else {
                body swap res
            }
        }
        i = i + 1
        pos = pc.next
    }
    remarkText :ctx :mk :id from: pos to: total after: pieceMarked buf: res
    (
        rt.fillSpan
        :id
        from: pos
        to: total
        :keys
        :bindIds
        :bindVals
        :rawIds
        :rawVals
        :holes
        path: path.stringView
        :fails
        buf: res
    )
    return res
}

# appendNativeMark -- the mark of native text `mk` (NativeMark) as a C comment
# line: the piece's or section's named `name`, the text's own for ""
appendNativeMark: function {ctx: Ctx.view mk: u64 name: StringView buf: String.borrow} is {
    m: ctx.marks.get i: mk
    if name.length > 0 then {
        pm: m.parts.get key: name.asString
        if pm.some then {
            buf.append "/* nativec: \{pm} */\n"
            return
        }
    }
    buf.append "/* nativec: \{m.mark} */\n"
}

# openMark -- the mark of native text `key`, written first (zc emit
# --mark-natives): its row in Ctx.marks, 0 for none
openMark: function {ctx: Ctx.view key: textkey buf: String.borrow} out u64 is {
    if ctx.markNatives.not then return 0
    mk: (ctx.nativeMarks.get :key).or d: 0
    if mk > 0 then appendNativeMark :ctx :mk name: "" :buf
    return mk
}

# markPiece -- the mark of piece `pc` of text `id`, when the text has a mark
# `mk`; whether it had
markPiece: function {ctx: Ctx.view mk: u64 id: rtid pc: rtpiece buf: String.borrow} out bool is {
    if mk == 0 then return false
    tv: (ctx.rt.heads.get i: id).stringView
    appendNativeMark :ctx :mk name: (tv.substring from: pc.headFrom to: pc.nameTo) :buf
    return true
}

# remarkText -- the mark of text `id` again, after a piece's (`after`), before
# more of the text (bytes `from` to `to`) that is not blank; whether a piece's
# mark is still the last written
remarkText: function {
    ctx: Ctx.view mk: u64 id: rtid from: u64 to: u64 after: bool buf: String.borrow
} out bool is {
    if after.not then return false
    if ((ctx.rt.texts.get i: id).stringView.substring :from :to).trim.length == 0 then return true
    appendNativeMark :ctx :mk name: "" :buf
    return false
}

# condAlwaysHolds -- `c` holds in every configuration: wrapCond writes a body
# under it as it stands
condAlwaysHolds: function {c: Cond.view} out bool is {
    return c.always or (c.terms.length == 0)
}

# rtPlanSpells -- the text plan `plan` writes spells the key `name`: outside
# every section, or in a written one
rtPlanSpells: function {ctx: Ctx.view plan: RtPlan.view name: StringView} out bool is {
    kid: ctx.rt.keys.find s: name
    if kid.isZero then return false
    rt: ctx.rt
    inf: rt.infos.get i: plan.id
    k: inf.segFrom
    for k < inf.segTo loop {
        sg: rt.segs.get i: k
        k = k + 1
        if sg.kind.key when sg.name == kid when (rtPlanWrites :ctx :plan at: sg.from
        ) then return true
    }
    return false
}

# rtPlanWrites -- plan `plan` writes the template byte at `at`: it lies outside
# every section, or in the body of a written one
rtPlanWrites: function {ctx: Ctx.view plan: RtPlan.view at: u64} out bool is {
    inf: ctx.rt.infos.get i: plan.id
    i: u64
    j: inf.pieceFrom
    for j < inf.pieceTo loop {
        pc: ctx.rt.pieces.get i: j
        j = j + 1
        if at < pc.at then return true
        if at < pc.next then {
            if (plan.kept.get :i).not then return false
            return (at >= pc.bodyFrom) and (at < pc.bodyTo)
        }
        i = i + 1
    }
    return true
}

# rtOptionKeys -- bind option type `tid`'s two tag constants to the keys
# `<key>_SOME` and `<key>_NONE`, where the text `plan` writes spells either
rtOptionKeys: function {
    # the arm names
    ast: Ast.view
    ctx: Ctx
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    plan: RtPlan.view
    keys: RtKeys
    # the key both names extend
    key: StringView
    # the option type
    tid: ztypes.tid
} is {
    sk: "\{key}_SOME"
    nk: "\{key}_NONE"
    if (rtPlanSpells :ctx :plan name: sk.stringView).not when (
        rtPlanSpells
        :ctx
        :plan
        name: nk.stringView
    ).not then return
    # an option view's enum is written with its struct (emitOptionViewMono), so
    # spelling its constants is no use of it to record
    sv: tagConstOf :ast :ctx :reg :typing :tid armId: zast.wellKnown.slot.wkSome
    nv: tagConstOf :ast :ctx :reg :typing :tid armId: zast.wellKnown.slot.wkNone
    rtKey :ctx :keys name: sk.stringView val: sv.stringView
    rtKey :ctx :keys name: nk.stringView val: nv.stringView
}

# monoCondMembers -- some member of instance `mono` is used only under a
# condition
monoCondMembers: function {ctx: Ctx.view mono: ztypes.tid} out bool is {
    for each mc: ctx.memberConds loop {
        if (mc.key / 128) == mono.u64 when (ctx.memberAlways.has item: mc.key).not then return true
    }
    return false
}

# sectionConds -- the condition each section of `mono`'s text is written under:
# a kept one's member's, ORed into each section it needs, until none grows; a
# section kept for no member of its own holds only where those that need it do
sectionConds: function {
    ctx: Ctx.view
    mono: ztypes.tid
    text: StringView
    marks: (ListVal u64).view
    kept: (ListVal bool).view
    conds: List Cond
} is {
    k: u64
    for k < kept.length loop {
        c: Cond always: false terms: ListVal u64
        slot: (
            ctx.memberWords.slotOf
            text: (text.substring from: (marks.get i: k * 4) to: (marks.get i: k * 4 + 1))
        )
        mk: memberKey :mono member: slot
        if (kept.get i: k) when (ctx.memberUses.has item: mk) then c = memberCondOf :ctx key: mk
        conds.append c
        k = k + 1
    }
    grew: true
    for grew loop {
        grew = false
        j: u64
        for j < kept.length loop {
            if (kept.get i: j) when (sectionNeedsUnder :text :marks :conds from: j) then grew = true
            j = j + 1
        }
    }
}

# sectionNeedsUnder -- OR section `from`'s condition into each section it needs:
# true when one grew
sectionNeedsUnder: function {
    text: StringView marks: (ListVal u64).view conds: List Cond from: u64
} out bool is {
    grew: false
    src: Cond always: false terms: ListVal u64
    {
        sc: conds.get i: from
        src.always = sc.always
        for each t: sc.terms loop src.terms.append t
    }
    at: marks.get i: from * 4 + 2
    to: marks.get i: from * 4 + 3
    for at < to loop {
        cm: ((text.substring from: at :to).indexOf needle: ",").or d: to - at
        nm: text.substring from: at to: at + cm
        j: u64
        for j < conds.length loop {
            if (text.substring from: (marks.get i: j * 4) to: (marks.get i: j * 4 + 1)) == nm then {
                dst: conds.getMut i: j
                if (condMerge :dst :src) then grew = true
            }
            j = j + 1
        }
        at = at + cm + 1
    }
    return grew
}

# closeSectionNeeds -- keep every section a kept one needs, until none is added
closeSectionNeeds: function {text: StringView marks: (ListVal u64).view kept: ListVal bool} is {
    grew: true
    for grew loop {
        grew = false
        k: u64
        for k < kept.length loop {
            if (kept.get i: k) when (keepNeedsOf :text :marks :kept :k) then grew = true
            k = k + 1
        }
    }
}

# keepNeedsOf -- keep each section kept section `k` needs: true when one was
# not kept already. The needs are walked by offset: a view of the text held
# across keepSection would lock it.
keepNeedsOf: function {
    text: StringView marks: (ListVal u64).view kept: ListVal bool k: u64
} out bool is {
    grew: false
    at: marks.get i: k * 4 + 2
    to: marks.get i: k * 4 + 3
    for at < to loop {
        cm: ((text.substring from: at :to).indexOf needle: ",").or d: to - at
        if cm > 0 when (keepSection :text :marks :kept from: at to: at + cm) then grew = true
        at = at + cm + 1
    }
    return grew
}

# keepSection -- keep the section named by the text from `from` to `to`: true
# when it was not kept already
keepSection: function {
    text: StringView marks: (ListVal u64).view kept: ListVal bool from: u64 to: u64
} out bool is {
    name: text.substring :from :to
    j: u64
    for j < kept.length loop {
        if (text.substring from: (marks.get i: j * 4) to: (marks.get i: j * 4 + 1)) == name then {
            if (kept.get i: j) then return false
            kept.set i: j val: true
            return true
        }
        j = j + 1
    }
    return false
}

# sectionRowNeeds -- the runtime rows a kept section needs: each need that names
# a row (`prelude.@panic`, never a sibling section, whose name has no dot)
sectionRowNeeds: function {ctx: Ctx text: StringView from: u64 to: u64 cond: Cond.view} is {
    at: from
    for at < to loop {
        cm: ((text.substring from: at :to).indexOf needle: ",").or d: to - at
        nd: text.substring from: at to: at + cm
        if (nd.contains needle: ".") then rowNeedAddCond :ctx uname: "" need: nd :cond
        at = at + cm + 1
    }
}

# loadFixedFile -- one of the runtime's fixed files as this program writes it:
# its pieces decided (rtRowPlan), its String and StringView holes filled
loadFixedFile: function {ctx: Ctx key: textkey} out String is {
    plan: rtRowPlan :ctx id: (tmplParsed :ctx :key)
    bn: ListVal zast.nameid
    bv: List String
    bn.append (rtHoleId slot: rtHole.slot.holeStringView)
    bv.append from: ctx.svC.copy
    bn.append (rtHoleId slot: rtHole.slot.holeString)
    bv.append from: ctx.strC.copy
    ferr: List String
    res: (
        rtRenderWith
        :ctx
        :plan
        keys: ctx.rt.noKeys
        bindIds: bn
        bindVals: bv
        rawIds: ListVal zast.nameid
        rawVals: List String
        holes: true
        :key
        fails: ferr
    )
    if (ctx.rt.infos.get i: plan.id).open then {
        ferr.append from: "\{textLabel :ctx :key}: unterminated hole"
    }
    for each m: ferr loop ctx.emitErrors.append (emitterFailure what: m.copy line: 0)
    return res
}

# the runtime types the emitter must name before anything else: String,
# StringView, the C-error record and bool. They are resolved by ID out of the
# system unit, never by the C names the fragments use.
runtimetids: record {
    # String's type id
    str: ztypes.tid
    # StringView's type id
    sv: ztypes.tid
    # converror's type id. They are fetched together because every emit path
    # needs at least one
    cerr: ztypes.tid
    # bool's type id
    bool: ztypes.tid
    # text's type id
    text: ztypes.tid
}

# resolveRuntimeTids -- resolve those, or leave a tid 0 where the program
# registers none (a unit with no main and no strings registers neither).
resolveRuntimeTids: function {
    program: Ast.view
    typing: ztyping.ZTyping.view
} out runtimetids is {
    sysU: typing.systemUnitRoot
    return (
        runtimetids
        str: (systemTypeTid :program :typing :sysU nameId: zast.wellKnown.slot.tyString)
        sv: (systemTypeTid :program :typing :sysU nameId: zast.wellKnown.slot.tyStringView)
        cerr: (systemTypeTid :program :typing :sysU nameId: zast.wellKnown.slot.tyConverror)
        bool: (systemTypeTid :program :typing :sysU nameId: zast.wellKnown.slot.wkBool)
        text: (systemTypeTid :program :typing :sysU nameId: zast.wellKnown.slot.tyText)
    )
}

# systemTypeTid -- the type the system unit declares as `nameId`, 0 when the
# program registered none.
systemTypeTid: function {
    # the program's names
    program: Ast.view
    # the checked program the system unit is in
    typing: ztyping.ZTyping.view
    # the system unit's declaration
    sysU: ztypes.declid
    # the type's well-known name
    nameId: zast.nameid
} out ztypes.tid is {
    return (
        (ztypecheck.resolvedByIdsRo ast: program :typing unitDecl: sysU name: nameId).or
        d: ztypes.tid.zero
    )
}

# buildTypeCnames -- the C name of every registered type, indexed by tid, built
# once so no later emission has to ask the registry by name.
buildTypeCnames: function {
    reg: ztypes.ZTypeRegistry.view
    readableNames: bool
    typeCnames: List String
} is {
    ow: zast.Vocab.create block: opSpelling
    ctb: ztypes.tid
    ctlast: reg.nextTid
    for ctb < ctlast loop {
        cn: String
        if (reg.typeValid tid: ctb) then {
            if readableNames then {
                onm: String
                oti: reg.ownerTidOf tid: ctb
                if oti.notZero then onm = reg.nameOf tid: oti
                tnm: reg.nameOf tid: ctb
                cn = cnameOf tid: ctb ownerName: onm.stringView name: tnm.stringView :ow
            } else {
                cn = cnameById tid: ctb
            }
        }
        typeCnames.append cn
        ctb = ctb.next
    }
}

# emitStringFragments -- the String, StringView and hash runtime fragments. A
# String typedef (Path) shares the String struct and its free (destroyFnC).
emitStringFragments: function {ctx: Ctx buf: String.borrow} is {
    p1: fileKey :ctx name: "String"
    buf.append (loadFixedFile :ctx key: p1)
    p2: fileKey :ctx name: "StringView"
    buf.append (loadFixedFile :ctx key: p2)
    ph: fileKey :ctx name: "hash"
    buf.append (loadFixedFile :ctx key: ph)
}

# emitCodeBody -- everything that references a `_zsN` literal goes into codeBuf
# FIRST (each reference marks ctx.usedLits through litIndexOf), so the pool that
# precedes it in the file can be written with only the entries an emission asked
# for. The monos come before the runtime fragments: a fragment dereferences the
# layouts of the types it serves, so those must already be complete.
emitCodeBody: function {
    program: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nodeEstE: u64
    codeBuf: String.borrow
} out u64 is {
    codeBuf.reserve n: nodeEstE * 8
    # every body is written: the boxes the fired rows make, and the natives
    # each boxed runtime class's vtable takes, are known before the rows are
    demandRowBoxes ast: program :reg :typing :ctx
    demandBoxedNatives ast: program :reg :typing :ctx
    # what the written code reaches so far, so a `uses_<Type>` row fires for a
    # type reached only through another's field or arm (a Result's payload);
    # closeReachedTypes goes on from here once the runtime has spelled its own
    reachSoFar :reg :typing :ctx
    # the runtime units are generated before the types, which they follow in
    # the output: their holes name types, and a type is written only once
    # something has spelled it. The split / lines iterator types go ahead of
    # the typedefs of the function types that spell them; they reach nothing
    # the passes below write
    svBuf: String
    (
        emitRuntimeUnit
        ast: program
        :reg
        :typing
        :ctx
        uname: "sviter"
        buf: svBuf
    )
    rtBuf: String
    emitRuntimeUnits ast: program :reg :typing :ctx buf: rtBuf
    needsAt: ctx.demands.keys.length
    closeReachedTypes ast: program :reg :typing :ctx
    closeTmplDestroys ast: program :reg :typing :ctx
    emitMonos ast: program :reg :typing :ctx buf: codeBuf
    codeBuf.append svBuf
    # ahead of the runtime fragments: those dereference the layouts of the
    # types they serve, so anything a fragment touches must already be
    # complete, and this is the pass that orders by-value embedding in both
    # directions (a user struct inside a mono, a mono inside a user struct)
    emitFnptrTypedefs ast: program :reg :typing :ctx buf: codeBuf
    emitUserStructsOrdered ast: program :reg :typing :ctx buf: codeBuf
    codeBuf.append rtBuf
    # the count of needs the runtime pass answered: one asked after it is late
    return needsAt
}

# emitRuntimeUnits -- every unit's runtime, in the order the table gives, then
# the units it does not name. Run again LATE, it loads the rows whose demand
# fired while a type method's body was written, after the first walk: a row
# already written is skipped.
emitRuntimeUnits: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    buf: String.borrow
} is {
    # the unit order is copied first: the runtime emitters below lend ctx
    uos: List String
    for each uo0: ctx.unitOrder loop uos.append uo0.copy
    for each uo: uos loop emitRuntimeUnit :ast :reg :typing :ctx uname: uo.stringView :buf
    emitUnorderedUnits :ast :reg :typing :ctx :buf
}


# emitC -- emit the C translation unit for a typechecked program.
emitC: function {
    program: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the user units' C implementation files, checked (UserImplementation)
    users: (List UserImplementation).view
    # the standard library's rows are the ones zc carries; false when its own
    # files are among `users` instead (zc --nativec-files)
    servedRows: true
    # mark each native text written with where it is written (NativeMark);
    # only the rows read off their files carry a place
    markNatives: false
    fastHash: bool
    readableNames: bool
    errs: List zast.ErrorData
    # the family of the C compiler the output is for: a unit the program
    # reaches may need something only some have
    ccFamily: zcc.ccfamily
    # the architecture the build is for (an archkind arm name), which a unit
    # the program reaches may require
    targetArch: StringView
    # the operating system the build is for (an oskind arm name), which decides
    # the units' per-OS rows
    targetOs: StringView
} out String is {
    buf: String
    rtids: resolveRuntimeTids :program :typing
    strId: rtids.str
    svId: rtids.sv
    cerrId: rtids.cerr
    boolId: rtids.bool
    typeCnames: List String
    buildTypeCnames :reg :readableNames :typeCnames
    strC: listCname cnames: typeCnames tid: strId
    svC: listCname cnames: typeCnames tid: svId
    # tid 0 is the "no type" sentinel, so a unit that registers neither String
    # nor StringView -- one with no main and no strings -- would hand both
    # runtime structs the same cname and emit two conflicting typedefs. The
    # fragments' own names are unique and already in the text.
    if strId.isZero then strC = "z_String".string
    if svId.isZero then svC = "z_StringView".string
    # text is laid out as a StringView and is one C type with it: a text is
    # passed where a view is, and its `stringView` is the value itself
    if rtids.text.notZero then typeCnames.set i: rtids.text.u64 val: svC.copy
    origins: ListVal ztypes.tid
    buildOriginTids :program :typing acc: origins
    mn: mainCName :program
    litIds: ListVal zast.nodeid
    litTexts: List String
    collectUnitLiterals :program :typing ids: litIds texts: litTexts
    litIndex: literalIndex ids: litIds
    litSizes: ListVal u64
    for each lt: litTexts loop litSizes.append lt.length
    rm: mn.copy
    ctx: (
        Ctx
        mainName: mn
        nsTid: ztypes.tid
        realMain: rm
        :fastHash
        :readableNames
        :strC
        :svC
        cnames: typeCnames
        :litIds
        :litIndex
        :litSizes
        usedLits: IdSet zast.nodeid
        constLits: List String
        tailRetActive: false
        tailReturned: false
        defUnitId: (IdMapV ztypes.tid v: ztypes.declid)
        classRows: List ClassRow
        classRowTids: ListVal ztypes.tid
        liveClasses: IdSet ztypes.tid
        fieldListAt: (IdMapV ztypes.tid v: u64)
        fieldNameIds: ListVal zast.nameid
        mainUnitId: ztypes.declid
        condDepth: 0
        returnEmitted: false
        emitErrors: List zast.ErrorData
        demands: zemitrows.DemandSet.create
        condEpoch: 0
        rowCondEpochAt: 0
        rowCondKey: (IdMapR u64 V: String)
        conds: List CondDecl
        keyEqKept: IdSet ztypes.tid
        keyHashKept: IdSet ztypes.tid
        keyEqNoAt: (IdMapV ztypes.tid v: u64)
        keyHashNoAt: (IdMapV ztypes.tid v: u64)
        fnSigs: (IdMapR ztypes.tid V: String)
        opBindIds: ListVal zast.nameid
        opBindVals: List String
        opRawIds: ListVal zast.nameid
        opRawVals: List String
        ptrVids: ListVal ztypes.vid
        staticVids: IdSet ztypes.vid
        staticTids: IdSet ztypes.tid
        refBorrowRet: false
        aliases: List VidVal
        narrowBox: List VidVal
        aliasHeld: List AliasHeld
        narrowTid: List VidTid
        exclArms: List VidArms
        exclTids: List VidTid
        exSaves: List ExclSave
        genActive: false
        genTid: ztypes.tid.zero
        genFieldsRow: 0
        exitNode: zast.nodeid
        genRecvC: "this".string
        genValC: "value".string
        genYieldCount: 0
        genYieldNext: 0
        genForNext: 0
        genForSpills: List ForSpill
        comprehendTo: List ComprehendTo
        yieldTempK: (IdMapV zast.nodeid v: u64)
        genWrap: "".string
        genSomeTag: "".string
        genSomeC: "".string
        genNoneTag: "".string
        genPayC: "".string
        genHasValue: false
        curThisTid: ztypes.tid
        emittedUserTypes: IdSet ztypes.tid
        eqAsked: IdSet ztypes.tid
        eqHasBody: IdSet ztypes.tid
        eqUsed: IdSet ztypes.tid
        destroyUsed: IdSet ztypes.tid
        createUsed: IdSet ztypes.tid
        createAliasUsed: IdSet ztypes.tid
        hashAsked: IdSet ztypes.tid
        hashOrder: ListVal ztypes.tid
        lateDefs: String
        fwdDeclaredTypes: IdSet ztypes.tid
        fnptrDemand: IdSet ztypes.tid
        fnptrWritten: IdSet ztypes.tid
        fnptrPassDone: false
        typeUses: IdSet ztypes.tid
        typeUseHold: false
        heldTypeUses: ListVal ztypes.tid
        ordinalTagUses: IdSet ztypes.tid
        tagOnlyTypes: IdSet ztypes.tid
        tagEnumUses: IdSet ztypes.tid
        reachedTypes: IdSet ztypes.tid
        reachFixed: false
        fnJobs: ListVal fnjob
        fnJobAt: (IdMapV ztypes.tid v: u64)
        fnClosed: false
        fnSpelled: IdSet ztypes.tid
        nativeBoxes: ListVal nativebox
        texts: (MapVR textkey V: String)
        textIds: (MapRV String v: u32)
        textNames: List String
        stemCnames: (Map String V: String)
        canonSpecs: (Map String V: String)
        unitReqs: List UnitReq
        rt: RtTexts.create
        tmplTexts: (MapVV textkey v: rtid)
        tmplNeeds: (MapVR textkey V: String)
        piecedTexts: (MapVR textkey V: PiecedText)
        pullsByDemand: (MapVR zemitrows.demandkey V: String)
        cWords: (zast.Vocab.create block: cReserved)
        opWords: (zast.Vocab.create block: opSpelling)
        nativeWords: (zast.Vocab.create block: nativeWord)
        implementedUnits: Set String
        :markNatives
        nativeMarks: (MapVV textkey v: u64)
        marks: List NativeMark
        rows: zemitrows.RowTable.create
        hoistTags: (MapRV String v: zast.nameid)
        rowsWritten: IdSet u64
        rowsClosed: IdSet u64
        rowsAlwaysClosed: IdSet u64
        rowNeedsAt: 0
        rowsInPlace: IdSet u64
        piecedFrags: Set String
        memberUses: IdSet u64
        memberConds: ListVal membercond
        memberAlways: IdSet u64
        memberWords: (zast.Vocab.create block: memberWord)
        membersLeftOut: IdSet u64
        fragUnitDecls: ListVal ztypes.declid
        demandGatedTids: IdSet ztypes.tid
        usedTypeIds: IdSet ztypes.tid
        emittedImplementation: IdSet ztypes.confid
        boxedImplementation: IdSet ztypes.confid
        ownedBoxUses: IdSet u64
        borrowBoxUses: IdSet u64
        aggUses: IdSet u64
        aggWritten: IdSet u64
        aggsOut: List WrittenAgg
        aggsFixed: false
        aggReaderUses: IdSet u64
        markerValues: (IdMapV ztypes.tid v: bool)
        emittedListIters: IdSet ztypes.tid
        unitOrder: List String
        argHoists: List ArgHoist
        argHoistRaw: List RawHoist
        argHoistCtr: 0
        orderPieces: List OrderPiece
        orderSeq: 0
        orderSeqFloor: 0
        guardDepth: 0
        condScan: ListVal zast.nodeid
        orderVals: List String
        orderValFacts: ListVal cfacts
        orderWrit: ListVal u64
        orderPosAt: ListVal u64
        orderDone: ListVal bool
        orderPends: List OrderPend
        orderCtr: 0
        lastArgByPtr: false
        tmpHigh: 0
        argHoistFloor: 0
        argHoistRawFloor: 0
        armRefCv: 0
        armRefDepth: 0
        armParks: List ArgHoist
        hoistsToBlock: false
        whenGuardCtr: 0
        loops: List LoopFrame
        contLabelUsed: (IdMapV u64 v: bool)
        breakLabelCtr: 0
        breakLabelUsed: (IdMapV u64 v: bool)
        borrowedVars: (IdMapV ztypes.vid v: bool)
        strTid: strId
        svTid: svId
        textTid: rtids.text
        converrorTid: cerrId
        boolTid: boolId
        :origins
    )
    recordImplementedUnits :ctx :users
    if servedRows then {
        registerImplementations :ctx ast: program :typing :users
    } else {
        registerFromFiles :ctx ast: program :typing :users
    }
    placePanicRow :ctx
    linkLibs: List String
    csrcs: List String
    (
        applyUnitReqs
        ast: program
        :typing
        :ctx
        :ccFamily
        libs: linkLibs
        :csrcs
        arch: targetArch
        os: targetOs
    )
    {
        buildDefUnitIndex :reg :typing :ctx
        bindFragTypeTids :typing :ctx ast: program
        bindFragUnitDecls :typing :ctx ast: program
        bindClassRows :typing :ctx ast: program
        rmn: ctx.realMain.copy
        ctxBindMain :ctx name: rmn.stringView unitDecl: typing.mainUnitRoot
    }
    checkLoadedNatives :program :typing :ctx
    noteStaticVids :reg :typing :ctx
    demandTmplClassNeeds :reg :typing :ctx
    # A runtime-owned class's methods are demanded by the class being LIVE
    # rather than by a call: a DECLARED Reader/Writer implementation needs the
    # native's address whether or not anything calls it, and net's `Conn`
    # declares one that nothing in the tree constructs. This runs ahead of
    # every consultation: a function body asks it (ownsResources) of each value it
    # destroys or moves out -- a Listener a function returns by `r.take` must
    # leave its Result releasing nothing -- and emitMonos asks it for the
    # structs the fragments dereference.
    markLiveClasses ast: program :reg :typing :ctx
    nodeEstE: u64
    nodeEstE = program.nodes.length
    planFns :program :reg :typing :ctx
    planRecordMethods :program :reg :typing :ctx
    # the static aggregates, the functions and the methods are generated ahead
    # of the types, which they follow in the output: a type is written only
    # once something has spelled it
    protosBuf: String
    fnProtoText: String
    fnBodyText: String
    fnBodyText.reserve n: nodeEstE * 24
    writeDemanded ast: program :reg :typing :ctx protos: fnProtoText bodies: fnBodyText
    appendWrittenAggs :typing :ctx buf: protosBuf
    emitStaticListReaders ast: program :reg :typing :ctx buf: protosBuf
    appendWrittenFns :ctx protos: true withMethods: true text: fnProtoText.stringView buf: protosBuf
    bodiesBuf: String
    appendWrittenFns :ctx protos: false withMethods: true text: fnBodyText.stringView buf: bodiesBuf
    fnsBuf: String
    fnsBuf.reserve n: fnBodyText.length + 64
    appendWrittenFns :ctx protos: false withMethods: false text: fnBodyText.stringView buf: fnsBuf
    if (programHasMain :program).not then {
        fnsBuf.append "void z_main(void) {\n"
        fnsBuf.append "}\n\n"
    }
    # the functions' forward declarations go after the types, with the
    # methods': a method body may call a function, and a generator function
    # returns its iterator class
    fnProtosBuf: String
    fnProtosBuf.reserve n: fnProtoText.length + 1
    (
        appendWrittenFns
        :ctx
        protos: true
        withMethods: false
        text: fnProtoText.stringView
        buf: fnProtosBuf
    )
    fnProtosBuf.append "\n"
    codeBuf: String
    needsAt: emitCodeBody :program :reg :typing :ctx :nodeEstE :codeBuf
    # what is asked for after the runtime pass has run -- while a type or a
    # implementation helper is written -- goes in where that pass ended: ahead of
    # every method body, behind every struct and runtime unit it reads. That is
    # a native implementer's helpers, and the fragment rows whose demand fired
    # only there -- an operator or a native method's `needs=`
    natAt: codeBuf.length
    codeBuf.append protosBuf
    codeBuf.append fnProtosBuf
    emitRecordDefs :program :reg :typing :ctx buf: codeBuf
    codeBuf.append bodiesBuf
    lateBuf: String
    if (needsOutsidePrelude :ctx from: needsAt) then {
        emitRuntimeUnits ast: program :reg :typing :ctx buf: lateBuf
    }
    if ctx.nativeBoxes.length > 0 then {
        emitNativeImplementationImpls ast: program :reg :typing :ctx buf: lateBuf
    }
    if lateBuf.length > 0 then {
        spliced: String
        spliced.append (codeBuf.substring from: 0 to: natAt)
        spliced.append lateBuf
        spliced.append (codeBuf.substring from: natAt to: codeBuf.length)
        codeBuf = spliced.take
    }
    poolBuf: String
    emitLiteralPools :ctx :litTexts :poolBuf
    (
        assembleEmitOutput
        :program
        :reg
        :typing
        :ctx
        :buf
        poolBuf: poolBuf.stringView
        codeBuf: codeBuf.stringView
        fnsBuf: fnsBuf.stringView
    )
    # z_panic's fragment, chosen by the table (a threaded program's differs)
    pr: panicRow :ctx
    pf: String
    if pr > 0 then pf = rowFragText :ctx row: pr
    if pf.length == 0 then {
        (
            emitFail
            :ctx
            what: "nativec: the prelude has no @panic row, so the panic function has nothing to be written from".string
            line: 0
        )
        pf = "_Z_PANIC".string
    }
    # the fixed files are decided last, when every demand is in: the header,
    # then the String, StringView and hash fragments the code follows
    closeRowNeeds :ctx
    head: String
    emitCHeader libs: linkLibs :csrcs panicFrag: pf.stringView :ctx buf: head
    emitStringFragments :ctx buf: head
    # the Ctx's failures follow assembly's own, in the order recorded: popped
    # twice, so each is moved rather than copied
    rev: List zast.ErrorData
    for ctx.emitErrors.length > 0 loop rev.append from: ctx.emitErrors.pop
    for rev.length > 0 loop errs.append from: rev.pop
    # the header goes in front last: its link line holds what the reached
    # units need, which the table had to be read to know
    whole: String
    whole.append "/* Generated by zerolang compiler */\n"
    whole.append head
    whole.append buf
    return whole
}

# applyUnitReqs -- what the reached units need from the C toolchain
# (each unit's links, sources and refusals): each one the program reaches adds its link
# library and the C source it needs built, and refuses a C compiler or a target
# architecture that cannot build it, by name, before any C is compiled. A unit
# nothing reaches asks nothing, and a row whose `os=` does not name the target
# operating system speaks for another build.
applyUnitReqs: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    ccFamily: zcc.ccfamily
    libs: List String
    # the C sources the reached units need compiled and linked, each one line
    # of the emitted `zcsrc:` header: the source, then its defines
    csrcs: List String
    # the architecture the build is for, as an archkind arm name
    arch: StringView
    # the operating system the build is for, as an oskind arm name
    os: StringView
} is {
    if ctx.unitReqs.length == 0 then return
    fam: zcc.ccFamilyName f: ccFamily
    # collected, and reported once the walk over the rows is done: a report
    # writes the context the rows live in
    refusals: List String
    for each r: ctx.unitReqs loop {
        if (unitPathReached :ast :typing path: r.path.stringView).not then continue
        if (rowSpeaksForOs :r :os).not then continue
        why: unitReqRefusal :r :fam :arch
        if why.length > 0 then {
            refusals.append why.take
        } else {
            appendLinkOnce :libs lib: r.link.stringView
            if r.csrc.length > 0 then appendLinkOnce libs: csrcs lib: (csrcLineOf :r).stringView
        }
    }
    for each m: refusals loop emitFail :ctx what: m.copy line: 0
}

# rowSpeaksForOs -- whether a unit row applies to a build for `os`: it names
# no operating system, or names that one
rowSpeaksForOs: function {r: UnitReq.view os: StringView} out bool is {
    if r.os.length == 0 then return true
    for each osn: (r.os.stringView.split sep: ",") loop {
        if osn == os then return true
    }
    return false
}

# csrcLineOf -- the `zcsrc:` header line a unit's `csrc=` row makes: the
# source, then each of its defines, space-separated
csrcLineOf: function {r: UnitReq.view} out String is {
    line: r.csrc.copy
    for each d: (r.cdefs.stringView.split sep: ",") loop {
        if d.length > 0 then {
            line.append " "
            line.append d
        }
    }
    return line
}

# unitReqRefusal -- why a reached unit cannot be built with this toolchain,
# "" when it can: the compiler family is one its row names, or the target
# architecture is not the one it names.
unitReqRefusal: function {r: UnitReq.view fam: StringView arch: StringView} out String is {
    for each ncc: (r.nocc.stringView.split sep: ",") loop {
        if ncc == fam then {
            m1: "'\{r.path}' needs \{r.feature} from the C compiler, and \{fam} has none; build with another compiler"
            return m1
        }
    }
    if r.arch.length > 0 when r.arch.stringView != arch then {
        m2: "'\{r.path}' needs \{r.feature}, which only \{r.arch} targets have; this build targets \{arch}"
        return m2
    }
    return String
}

# appendLinkOnce -- add a library to the link list unless it is there already;
# "" adds nothing.
appendLinkOnce: function {libs: List String lib: StringView} is {
    if lib.length == 0 then return
    for each l: libs loop {
        if l.stringView == lib then return
    }
    libs.append from: lib.string
}

# unitPathReached -- the program reaches the unit a dotted path names: some
# declaration in it was demanded (ZTyping.unitsReached), and it declares
# something native, as the unit the row was written for does and a user unit of
# the same name does not
unitPathReached: function {
    ast: Ast.view typing: ztyping.ZTyping.view path: StringView
} out bool is {
    cur: pathDeclOf :ast :typing :path
    if cur.isZero then return false
    if (typing.unitsReached.has item: cur).not then return false
    return (declaresNative :ast :typing did: cur)
}

# factPathReached -- the program reaches what a fact's `reach=` path names: a
# free function or a type (`thread.spawn`) that was demanded -- a generic one
# when any instance of it was -- in a unit that declares something native, so a
# user unit of the same name does not make the fact hold. A method is not
# marked on its own, so a path names the function or the type.
factPathReached: function {
    ast: Ast.view typing: ztyping.ZTyping.view path: StringView
} out bool is {
    cur: pathDeclOf :ast :typing :path
    if cur.isZero then return false
    if (typing.declIsResolved declId: cur).not then return false
    uo: path.indexOf needle: "."
    if uo.none then return false
    ud: pathDeclOf :ast :typing path: (path.substring from: 0 to: uo)
    if ud.isZero then return false
    return (declaresNative :ast :typing did: ud)
}

# pathDeclOf -- the declaration a dotted path names, when every segment
# resolves; 0 otherwise
pathDeclOf: function {
    ast: Ast.view typing: ztyping.ZTyping.view path: StringView
} out ztypes.declid is {
    cur: ztypes.declid
    first: true
    for each seg: (path.split sep: ".") loop {
        nid: zast.poolFind pool: ast.names text: seg
        if nid.isZero then return ztypes.declid
        if first then {
            cur = ztypecheck.unitDeclOfName :typing nameId: nid
            first = false
        } else {
            cur = typing.declFindChild parentDeclId: cur nameId: nid
        }
        if cur.isZero then return cur
    }
    return cur
}

# true when the program defines a `main`.
programHasMain: function {program: Ast.view} out bool is {
    mainName: program.mainUnitName.stringView
    for each uId: program.units loop {
        opId: zast.nodeid
        u: program.nodes.get i: uId
        if u.namedoperation then {
            un: zast.poolTextAt pool: program.names ref: u.name
            if un.stringView == mainName then opId = u.operation
        }
        if opId.notZero when (unitHasMain ast: program mainOpId: opId) then return true
    }
    return false
}

# true when a unit defines a `main`.
unitHasMain: function {ast: Ast.view mainOpId: zast.nodeid} out bool is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: mainOpId
    for each bm: (zast.kidsOf :ast span: bodyIds) loop {
        bmNode: ast.nodes.get i: bm
        if bmNode.namedoperation when bmNode.name == zast.wellKnown.slot.wkMain then return true
    }
    return false
}

# cbaseNoPrefix -- the id-based cname without the leading "z_" (the runtime
# templates spell z_@@NAME@@, so NAME omits the prefix).
cbaseNoPrefix: function {ctx: Ctx.view tid: ztypes.tid} out String is {
    full: ctxCname :ctx :tid
    fl: full.length
    rest: full.substring from: 2 to: fl
    return rest.string
}

# applyTmpl -- substitute one @@KEY@@ placeholder in template text.
applyTmpl: function {text: String key: StringView val: StringView} out String is {
    needle: "@@\{key}@@"
    return (substituteAll :text needle: needle.stringView repl: val)
}

# listElemType -- a List/ListView mono's element type id (the get-child
# return), 0 when absent.
listElemType: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view monoId: ztypes.tid
} out ztypes.tid is {
    go: typing.declChildOfId parentTypeId: monoId nameId: zast.wellKnown.slot.wkGet
    if go.some then {
        return (reg.returnTypeOf tid: go)
    }
    return ztypes.tid.zero
}

# ctypeOrI64 -- the given C type name as an owned String, or int64_t
# when empty.
ctypeOrI64: function {s: StringView} out String is {
    if s.length > 0 then {
        return s.string
    } else {
        return "int64_t".string
    }
}

# emitArrayMono -- the array instance's runtime substitution, emitListMono's
# twin: the element mono supplies both the C element type and the `==` companion
# (arrayEqBody).
emitArrayMono: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    eid: listElemType :reg :typing :monoId
    elemC: typeRefC :ast :reg :typing :ctx tid: eid
    ect: ctypeOrI64 s: elemC.stringView
    lenStr: monoLengthText :reg :monoId
    createBody: "    z_\{nm}_t _this = {0};"
    eqBody: String
    if (ctx.eqUsed.has item: monoId) when (eqGenerated :ast :reg :typing :ctx tid: monoId) then (
        arrayEqBody
        :ast
        :reg
        :typing
        :ctx
        :monoId
        elemId: eid
        :lenStr
        dest: eqBody
    )
    p: tmplKey :ctx name: "array"
    ti: tmplTextOf :ctx key: p
    if (rtEmpty :ctx id: ti).not then {
        kt: RtKeys.create
        rtKey :ctx keys: kt name: "NAME" val: nm.stringView
        rtKey :ctx keys: kt name: "ELEM_T" val: ect.stringView
        rtKey :ctx keys: kt name: "LEN" val: lenStr.stringView
        rtKey :ctx keys: kt name: "CREATE_BODY" val: createBody.stringView
        rtKey :ctx keys: kt name: "EQ_BODY" val: eqBody.stringView
        plan: rtSectionPlan :ctx mono: monoId id: ti
        buf.append (rtRender :ctx :plan keys: kt)
        buf.append "\n"
    }
}

# arrayEqBody -- an array's generated `==`: its elements one at a time, each
# with the element's own `==`, or one memcmp over an integer, char or bool
# element, whose `==` answers exactly what its bytes do. A float's does not
# (NaN, the two zeros), so a float element is compared one at a time too. A
# body that calls a written method goes after the method prototypes, leaving
# its prototype in the template's place.
arrayEqBody: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    elemId: ztypes.tid
    lenStr: String.view
    dest: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    body: "static bool z_\{nm}_eq(z_\{nm}_t a, z_\{nm}_t b) {\n"
    if (elemEqIsBytes :ast :reg :typing tid: elemId) then {
        body.append "    return memcmp(a.data, b.data, sizeof(a.data)) == 0;\n}\n"
    } else {
        body.append "    for (int _i = 0; _i < \{lenStr}; _i++) { if (!("
        partEqC :ast :reg :typing :ctx tid: elemId lhs: "a" rhs: "b" sel: ".data[_i]" dest: body
        body.append ")) return false; }\n"
        body.append "    return true;\n}\n"
    }
    if (partCallsWritten :ast :reg :typing tid: elemId).not then {
        dest.append body
        return
    }
    zn: "z_\{nm}"
    emitEqLate :ctx cname: zn.stringView :body buf: dest
}

# elemEqIsBytes -- the runtime's `==` for this element is a compare of its
# bytes: an integer, a char, a bool, a function pointer. Not a float.
elemEqIsBytes: function {
    ast: Ast.view reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view tid: ztypes.tid
} out bool is {
    src: (
        ztypecheck.valOpSource
        :ast
        :reg
        :typing
        :tid
        nameId: zast.wellKnown.slot.wkOpEq
    )
    if src.builtin.not then return false
    if (partIsCScalar :reg :typing :tid).not then return false
    nk: constScalarKindForTid :typing :tid
    return (nk.has and (ztypes.isFloatKind k: nk.kind)).not
}

# capLenT -- the C length-field type for a str mono of the given capacity:
# uint8/16/32 by capacity, keeping small str monos compact.
capLenT: function {cap: u64} out String is {
    if cap <= 255 then return "uint8_t".string
    if cap <= 65535 then return "uint16_t".string
    return "uint32_t".string
}

# monoLengthValue / monoLengthText -- a sized mono's element count or byte
# capacity (array/str `to`): the value its numeric generic argument recorded,
# never a spelling read back out of its name.
monoLengthValue: function {reg: ztypes.ZTypeRegistry.view monoId: ztypes.tid} out u64 is {
    return (reg.sizedLength specId: monoId)
}

# the same count as C text.
monoLengthText: function {reg: ztypes.ZTypeRegistry.view monoId: ztypes.tid} out String is {
    return "\{monoLengthValue :reg :monoId}"
}

# emitStrMono -- a str valtype mono (fixed-capacity inline string). Substitutes
# template str (struct + create + .string + String_to_<name>). Its String and
# StringView holes are filled (fillStringHoles) with ctx.strC / ctx.svC.
# Capacity is the mono's recorded `to` argument.
emitStrMono: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    capV: monoLengthValue :reg :monoId
    capStr: "\{capV}"
    lenT: capLenT cap: capV
    eqBody: String
    eqo: typing.declChildOfId parentTypeId: monoId nameId: zast.wellKnown.slot.wkOpEq
    # written where written C compares two of them (noteEqUse)
    if eqo.some when (ctx.eqUsed.has item: monoId) then {
        eqBody = "static bool z_\{nm}_eq(z_\{nm}_t a, z_\{nm}_t b) {\n    return a.len == b.len && memcmp(a.data, b.data, a.len) == 0;\n}\n"
    }
    p: tmplKey :ctx name: "str"
    ti: tmplTextOf :ctx key: p
    # the template's String holes spell that type
    preludeNeed :ctx memb: "@String_t"
    kt: RtKeys.create
    rtKey :ctx keys: kt name: "NAME" val: nm.stringView
    rtKey :ctx keys: kt name: "CAP" val: capStr.stringView
    rtKey :ctx keys: kt name: "LEN_T" val: lenT.stringView
    rtKey :ctx keys: kt name: "EQ_BODY" val: eqBody.stringView
    bn: ListVal zast.nameid
    bv: List String
    bn.append (rtHoleId slot: rtHole.slot.holeStringView)
    bv.append from: ctx.svC.copy
    bn.append (rtHoleId slot: rtHole.slot.holeString)
    bv.append from: ctx.strC.copy
    plan: rtSectionPlan :ctx mono: monoId id: ti
    ferr: List String
    buf.append (
        rtRenderWith
        :ctx
        :plan
        keys: kt
        bindIds: bn
        bindVals: bv
        rawIds: ListVal zast.nameid
        rawVals: List String
        holes: true
        key: p
        fails: ferr
    )
    for each m: ferr loop ctx.emitErrors.append (emitterFailure what: m.copy line: 0)
    buf.append "\n"
}

# emitBoxMono -- a builtin Box mono (heap pointer). No struct (the type is
# <inner>*); emit only the destructor: free the inner (String/destructor) then
# the cell.
emitBoxMono: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    beid: reg.genericTypeArgAt specId: monoId ordinal: 0
    # the parameter is void*: a Box leaf's destroy may precede its element's
    # struct definition (a Box over a late-emitted system record), and the
    # body never needs the type -- a boxed element is a valtype, so the only
    # live action is freeing the cell (the String/dtor legs below are
    # bound-impossible today and convert implicitly if ever reached).
    bdecl: "static void z_\{nm}_destroy(void* v);\n"
    buf.append bdecl
    bsig: "static void z_\{nm}_destroy(void* v) {\n"
    buf.append bsig
    buf.append "    if (!v) return;\n"
    bfn: destroyFnC :reg :typing :ctx tid: beid
    if bfn.length > 0 then buf.append "    \{bfn}(v);\n"
    buf.append "    free(v);\n"
    buf.append "}\n\n"
}


# emitColMethodOnDemand -- write one container template method, but only where
# written C calls it on THIS instance (memberUsed). A method nothing calls is a
# dead C function in every program that names the collection at all.
emitColMethodOnDemand: function {
    ctx: Ctx
    monoId: ztypes.tid
    # the member, a memberWord slot
    member: u64
    file: StringView
    nm: StringView
    # the ONE hole a template needs beyond NAME, and what fills it: `ELEM_T`
    # for a list, `ITEM_T` for an IdSet. The dict and IdMap copies name their
    # entry type from NAME alone, so they pass "" and the substitution is
    # skipped rather than filled with nothing
    hole: StringView
    holeVal: StringView
    buf: String.borrow
} is {
    if (memberUsed :ctx mono: monoId :member).not then return
    fp: tmplKey :ctx name: file
    ti: tmplTextOf :ctx key: fp
    if (rtEmpty :ctx id: ti) then return
    kt: RtKeys.create
    rtKey :ctx keys: kt name: "NAME" val: nm
    if hole.length > 0 then rtKey :ctx keys: kt name: hole val: holeVal
    buf.append (rtFillKeys :ctx id: ti keys: kt)
    buf.append "\n"
}

# listElemsDestroyC -- the loop a List's destructor runs over its elements, empty
# when they own nothing. A String frees its buffer, a Set or a Map element is
# destroyed through the pointer it is, and anything else with a destructor
# through its address. A collection typedef (Bytes) is destroyed as the
# collection it wraps, which is the only one with a destructor of its own.
listElemsDestroyC: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    eid: ztypes.tid
} out String is {
    ecid: eid
    if (destroyTargetTid :reg :typing :ctx tid: eid).isZero then {
        rbn: canonTypeId :reg :typing tid: eid
        if rbn.notZero then ecid = rbn
    }
    edc: destroyLineC :reg :typing :ctx tid: ecid nm: "p->data[_di]" ind: "        "
    if edc.length == 0 then return edc
    return "    for (uint64_t _di = 0; _di < p->length; _di++) {\n\{edc}    }\n"
}

# listAddOnsGrow -- the List members written after the instance's own text
# (insert, extend, resize: their own fragments) call its grow
listAddOnsGrow: function {ctx: Ctx monoId: ztypes.tid} is {
    callsGrow: (
        (memberUsed :ctx mono: monoId member: memberWord.slot.insert) or
        (memberUsed :ctx mono: monoId member: memberWord.slot.extend) or
        (memberUsed :ctx mono: monoId member: memberWord.slot.resize)
    )
    if callsGrow then noteMemberUse :ctx mono: monoId member: memberWord.slot.grow
}

# emitListMono -- substitute template List for a List instance + the
# linear-scan contains companion (scalar element equality).
emitListMono: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    eid: listElemType :reg :typing :monoId
    isStrEl: false
    if eid == ctx.strTid then isStrEl = true
    isSvEl: isViewLaid :ctx tid: eid
    elemC: slotCType :ast :reg :typing :ctx tid: eid
    ect: ctypeOrI64 s: elemC.stringView
    p: tmplKey :ctx name: "List"
    ti: tmplTextOf :ctx key: p
    if (rtEmpty :ctx id: ti) then return
    {
        kt: RtKeys.create
        rtKey :ctx keys: kt name: "NAME" val: nm.stringView
        rtKey :ctx keys: kt name: "ELEM_T" val: ect.stringView
        delems: listElemsDestroyC :reg :typing :ctx :eid
        rtKey :ctx keys: kt name: "DESTROY_ELEMS" val: delems.stringView
        lvm: listviewMethods :ctx :reg :typing :monoId nm: nm.stringView ect: ect.stringView
        rtKey :ctx keys: kt name: "LISTVIEW_METHODS" val: lvm.stringView
        # insert, extend and resize, written after the instance, call its grow
        listAddOnsGrow :ctx :monoId
        plan: rtSectionPlan :ctx mono: monoId id: ti
        buf.append (rtRender :ctx :plan keys: kt)
    }
    emitListMembersOnDemand :ctx :monoId nm: nm.stringView ect: ect.stringView :buf
    useGet: memberUsed :ctx mono: monoId member: memberWord.slot.getOne
    useMut: memberUsed :ctx mono: monoId member: memberWord.slot.getMut
    if useGet or useMut then {
        (
            emitColGet
            :ctx
            nm: nm.stringView
            ect: ect.stringView
            kind: "List"
            ptr: (elemBorrowsByPtr :reg :typing :ctx tid: eid)
            mutPtr: (elemRefByPtr :reg :typing :ctx tid: eid)
            hasGet: useGet
            hasMut: useMut
            :buf
        )
    }
    elemT: eid
    if (memberUsed :ctx mono: monoId member: memberWord.slot.contains) then {
        (
            emitListContains
            :ast
            :reg
            :typing
            :ctx
            nm: nm.stringView
            ect: ect.stringView
            elem: elemT
            strLike: isStrEl or isSvEl
            :buf
        )
    }
    # called by written C, or a part of a generated `==` written C calls
    eqUsed: (
        (memberUsed :ctx mono: monoId member: memberWord.slot.eq) or (ctx.eqUsed.has item: monoId)
    )
    if eqUsed then (
        emitListEq
        :ast
        :reg
        :typing
        :ctx
        nm: nm.stringView
        ect: ect.stringView
        elem: elemT
        :buf
    )
    if (memberUsed :ctx mono: monoId member: memberWord.slot.sort) then {
        (
            emitListSort
            :ast
            :reg
            :typing
            :ctx
            nm: nm.stringView
            ect: ect.stringView
            elem: elemT
            isStr: isStrEl
            isSv: isSvEl
            :buf
        )
    }
    (
        emitListSliceOnDemand
        :reg
        :typing
        :ctx
        :monoId
        nm: nm.stringView
        kind: "List"
        :buf
    )
    emitListIter :ast :ctx :reg :typing :monoId nm: nm.stringView ect: ect.stringView :buf
}

# emitListMembersOnDemand -- the List members written as fragments of their
# own, each only for an instance that calls it.
emitListMembersOnDemand: function {
    ctx: Ctx monoId: ztypes.tid nm: StringView ect: StringView buf: String.borrow
} is {
    # insert and extend are their own fragments, written only for an instance
    # that calls them, so an instance that calls neither carries neither
    (
        emitColMethodOnDemand
        :ctx
        :monoId
        member: memberWord.slot.insert
        file: "List_insert"
        :nm
        hole: "ELEM_T"
        holeVal: ect
        :buf
    )
    (
        emitColMethodOnDemand
        :ctx
        :monoId
        member: memberWord.slot.extend
        file: "List_extend"
        :nm
        hole: "ELEM_T"
        holeVal: ect
        :buf
    )
    # `resize` is declared on ListVal alone, as `.copy` is below
    (
        emitColMethodOnDemand
        :ctx
        :monoId
        member: memberWord.slot.resize
        file: "List_resize"
        :nm
        hole: "ELEM_T"
        holeVal: ect
        :buf
    )
    # `.copy` is declared on ListVal and not on ListRef, so a ListRef mono has
    # no member here for declMemberIdOf to find and nothing is written. The
    # family needs no test of its own
    (
        emitColMethodOnDemand
        :ctx
        :monoId
        member: memberWord.slot.copy
        file: "List_copy"
        :nm
        hole: "ELEM_T"
        holeVal: ect
        :buf
    )
}

# emitListContains -- a list's linear `contains`, comparing each element with
# the needle by the element's own `==`: a String's or StringView's bytes, a
# scalar's C `==`, the author's method, a generated `_eq`. A definition that
# calls a written method comes after every method prototype.
emitListContains: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nm: StringView
    ect: StringView
    elem: ztypes.tid
    strLike: bool
    buf: String.borrow
} is {
    proto: "static bool z_\{nm}_contains(const z_\{nm}_t* _this, \{ect} _needle)"
    body: "\{proto} {\n"
    body.append "    for (uint64_t i = 0; i < _this->length; i++) {\n"
    late: false
    if strLike then {
        body.append "        if (_this->data[i].size == _needle.size && memcmp(_this->data[i].data, _needle.data, _needle.size) == 0) return true;\n"
    } else if (reg.isValtypeOf tid: elem).not then {
        # a reference element compares with the `==` its type declares, by
        # address, as a Set's element does
        late = true
        body.append "        { \{ect} _e = _this->data[i]; if ("
        body.append (spelledCname :ctx tid: (refElemEqFid :typing :elem))
        body.append "(&_e, "
        if (elemBorrowsByPtr :reg :typing :ctx tid: elem) then body.append "&"
        body.append "_needle)) return true; }\n"
    } else if (partIsCScalar :reg :typing tid: elem) when (
        partCallsWritten
        :ast
        :reg
        :typing
        tid: elem
    ).not then {
        body.append "        if (_this->data[i] == _needle) return true;\n"
    } else {
        late = partCallsWritten :ast :reg :typing tid: elem
        body.append "        { \{ect} _e = _this->data[i]; if ("
        partEqC :ast :reg :typing :ctx tid: elem lhs: "_e" rhs: "_needle" sel: "" dest: body
        body.append ") return true; }\n"
    }
    body.append "    }\n"
    body.append "    return false;\n"
    body.append "}\n\n"
    buf.append "\{proto};\n"
    if late then {
        ctx.lateDefs.append body
    } else {
        buf.append body
    }
}

# refElemEqFid -- the `==` a reference element's type declares, which a list's
# `contains` compares it with.
refElemEqFid: function {typing: ztyping.ZTyping.view elem: ztypes.tid} out ztypes.tid is {
    fo: (
        typing.declChildOfId
        parentTypeId: (ztypecheck.typedefChaseTid :typing tid: elem)
        nameId: zast.wellKnown.slot.wkOpEq
    )
    return (fo.or d: ztypes.tid.zero)
}

# emitListEq -- a ListVal's `==`: the same length, and each element equal to
# its counterpart by the element's own `==` -- one memcmp when that `==` is
# the element's bytes.
emitListEq: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nm: StringView
    ect: StringView
    elem: ztypes.tid
    buf: String.borrow
} is {
    proto: "static bool z_\{nm}_eq(const z_\{nm}_t* a, const z_\{nm}_t* b)"
    body: "\{proto} {\n"
    body.append "    if (a->length != b->length) return false;\n"
    if (elemEqIsBytes :ast :reg :typing tid: elem) then {
        body.append "    return a->length == 0 || memcmp(a->data, b->data, a->length * sizeof(*a->data)) == 0;\n"
    } else {
        body.append "    for (uint64_t _i = 0; _i < a->length; _i++) {\n"
        body.append "        \{ect} _x = a->data[_i];\n"
        body.append "        \{ect} _y = b->data[_i];\n"
        body.append "        if (!("
        partEqC :ast :reg :typing :ctx tid: elem lhs: "_x" rhs: "_y" sel: "" dest: body
        body.append ")) return false;\n"
        body.append "    }\n"
        body.append "    return true;\n"
    }
    body.append "}\n\n"
    buf.append "\{proto};\n"
    if (partCallsWritten :ast :reg :typing tid: elem) then {
        ctx.lateDefs.append body
    } else {
        buf.append body
    }
}

# sortCallsWritten -- ordering `elem` calls a `compare` the author wrote.
sortCallsWritten: function {
    ast: Ast.view reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view elem: ztypes.tid
} out bool is {
    if (reg.isValtypeOf tid: elem).not then return true
    return (
        ztypecheck.valOpSource
        :ast
        :reg
        :typing
        tid: elem
        nameId: zast.wellKnown.slot.wkCompare
    ).written
}

# sortLessC -- `_a` sorts before `_b`, by the element's own `compare`: a
# scalar's C `<`, a str's bytes up to the shorter length and then the
# lengths, and otherwise the author's `compare` below zero. The checker has
# refused a `sort` whose element has none.
sortLessC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    elem: ztypes.tid
} out String is {
    if (sortCallsWritten :ast :reg :typing :elem).not then {
        if (
            ztypecheck.valIsMonoOf
            :reg
            :typing
            tid: elem
            wk: zast.wellKnown.slot.tyStr
        ) then {
            return "memcmp(_a.data, _b.data, _a.len < _b.len ? _a.len : _b.len) < 0 || (memcmp(_a.data, _b.data, _a.len < _b.len ? _a.len : _b.len) == 0 && _a.len < _b.len)".string
        }
        return "_a < _b".string
    }
    rhs: "_b"
    if (reg.isValtypeOf tid: elem).not when (elemBorrowsByPtr :reg :typing :ctx tid: elem) then {
        rhs = "&_b"
    }
    fc: spelledCname :ctx tid: (sortCompareFid :reg :typing :elem)
    return "\{fc}(&_a, \{rhs}) < 0"
}

# sortCompareFid -- the `compare` the author wrote that orders `elem`
# (sortCallsWritten): a value type's own or its typedef chain's, a reference's
# declared one.
sortCompareFid: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view elem: ztypes.tid
} out ztypes.tid is {
    owner: ztypecheck.typedefChaseTid :typing tid: elem
    if (reg.isValtypeOf tid: elem) then {
        owner = (
            ztypecheck.valOpOwner
            :typing
            tid: elem
            nameId: zast.wellKnown.slot.wkCompare
        )
    }
    fo: typing.declChildOfId parentTypeId: owner nameId: zast.wellKnown.slot.wkCompare
    return (fo.or d: ztypes.tid.zero)
}

# emitColGet -- the element `get` for a List / ListView mono. The declared
# signature is `out of.borrow`: for an element kind whose copy is not a borrow
# the C function returns a POINTER into the storage and the call site derefs,
# so every value context stays value-shaped. `kind` only spells the panic
# message. One emitter for both templates, so List.listView cannot hand out a
# view that disagrees with its source. The return type and its forward
# declaration come from one string and cannot diverge. `hasGet` and `hasMut`
# say which of `get` and `getMut` a use site resolved on this mono; each is
# written on its own demand, and the readonly view templates never ask for
# `getMut`.
emitColGet: function {
    ctx: Ctx
    nm: StringView
    ect: StringView
    kind: StringView
    ptr: bool
    mutPtr: bool
    hasGet: bool
    hasMut: bool
    buf: String.borrow
} is {
    rt: ect.string
    rv: "    return _this->data[_idx];\n".string
    if ptr then {
        rt = "\{ect}*"
        rv = "    return (\{rt})&_this->data[_idx];\n"
    }
    # Both names are spelled LITERALLY -- view-guard reads these string literals
    # to learn which declaration each emitted function backs, and cannot see
    # through an interpolated method name.
    guard: String
    guard.append "    if (_idx >= _this->length) {\n"
    guard.append "        char _zp_buf[96];\n"
    b2: "        snprintf(_zp_buf, sizeof(_zp_buf), \"\{kind} get: index %llu out of bounds (length %llu)\", (unsigned long long)_idx, (unsigned long long)_this->length);\n"
    guard.append b2
    preludeNeed :ctx memb: "@panic"
    guard.append "        z_panic(_zp_buf);\n"
    guard.append "    }\n"
    if hasGet then {
        s0: "static \{rt} z_\{nm}_get(const z_\{nm}_t* _this, uint64_t _idx);\n"
        buf.append s0
        s1: "static \{rt} z_\{nm}_get(const z_\{nm}_t* _this, uint64_t _idx) {\n"
        buf.append s1
        buf.append guard
        buf.append rv
        buf.append "}\n\n"
    }
    # `getMut` answers a DIFFERENT question from `get`: a valtype element copies
    # out of `get` (cheap, cannot alias) but must come back BY REFERENCE from
    # `getMut`, or a write to the referenced element's children lands on the
    # copy and is silently lost.
    if hasMut then {
        mrt: ect.string
        mrv: "    return _this->data[_idx];\n".string
        if mutPtr then {
            mrt = "\{ect}*"
            mrv = "    return &_this->data[_idx];\n".string
        }
        m0: "static \{mrt} z_\{nm}_getMut(z_\{nm}_t* _this, uint64_t _idx);\n"
        buf.append m0
        m1: "static \{mrt} z_\{nm}_getMut(z_\{nm}_t* _this, uint64_t _idx) {\n"
        buf.append m1
        buf.append guard
        buf.append mrv
        buf.append "}\n\n"
    }
}

# emitColSlice -- the sub-range `slice` for a List / ListView mono: the window
# [from, to) over the same storage. The result is a ListView struct built by
# compound literal, so the whole operation is a length and a pointer advance --
# no allocation and no cast, where `listView` casts the source struct whole.
# `lvc` is the C base of the view it returns: another mono for a List, the mono
# itself for a ListView. `kind` only spells the panic message. The signature is
# written out at both the prototype and the definition rather than composed
# once: view-guard reads these string literals to learn which declaration the
# emitted function backs, and a name behind a local is a name it cannot see.
emitColSlice: function {
    ctx: Ctx
    nm: StringView
    lvc: StringView
    kind: StringView
    buf: String.borrow
} is {
    s0: "static \{lvc}_t z_\{nm}_slice(const z_\{nm}_t* _this, uint64_t _from, uint64_t _to);\n"
    buf.append s0
    s1: "static \{lvc}_t z_\{nm}_slice(const z_\{nm}_t* _this, uint64_t _from, uint64_t _to) {\n"
    buf.append s1
    buf.append "    if (_from > _to || _to > _this->length) {\n"
    buf.append "        char _zp_buf[128];\n"
    b2: "        snprintf(_zp_buf, sizeof(_zp_buf), \"\{kind} slice: [%llu, %llu) out of bounds (length %llu)\", (unsigned long long)_from, (unsigned long long)_to, (unsigned long long)_this->length);\n"
    buf.append b2
    preludeNeed :ctx memb: "@panic"
    buf.append "        z_panic(_zp_buf);\n"
    buf.append "    }\n"
    s3: "    return (\{lvc}_t){ .length = _to - _from, .data = _this->data + _from };\n"
    buf.append s3
    buf.append "}\n\n"
}

# emitListSliceOnDemand -- emitColSlice for one mono, written only where written
# C calls THIS instance's `slice` (memberUsed). The view it slices to comes from
# the member's declared return, which is another mono for a List and the mono
# itself for a ListView, so one path serves both templates.
emitListSliceOnDemand: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    nm: StringView
    kind: StringView
    buf: String.borrow
} is {
    if (memberUsed :ctx mono: monoId member: memberWord.slot.slice).not then return
    co: typing.declChildOfId parentTypeId: monoId nameId: zast.wellKnown.slot.wkSlice
    if co.some then {
        rt: fnReturnTidOf :reg tid: co
        # a view's slice is a view of the same instance: the member returns
        # `type`, and an instance minted while the library is still being read
        # carries the template's member, which records no return id for it
        if rt.isZero when (isListViewOriginOf :reg :ctx tid: monoId) then rt = monoId
        if rt.notZero then {
            lvc: ctxCname :ctx tid: rt
            emitColSlice :ctx :nm lvc: lvc.stringView :kind :buf
        }
    }
}

# emitListIterCursor -- the cursor struct and its `call`, written ONCE per
# ListIter mono. The cursor holds the WINDOW it walks -- `{data, length, idx}`
# -- not the container, which is what lets a List and a view of it share it: the
# two resolve `iterate` to the same ListIter mono, and a cursor naming its
# container would put two different bodies under that one typedef name (which
# typechecks and then fails at gcc with `invalid initializer` -- the reason
# ListIterVal was split off in the first place). Holding the window also drops
# one pointer indirection per step.
#
# The walk therefore reads `{data, length}` as they were at `iterate` time
# rather than re-reading the container. Unreachable in a valid program: the lock
# model already excludes a writer for the iterator's lifetime.
#
# `idx` is a COUNT of the elements yielded, not a position, which is what lets
# `down` reverse the walk without a second cursor: the exhaustion test is the
# same at either end, and a reverse walk over an empty window ends before it
# subtracts anything. Counting down a position is the alternative, and it is
# the underflow `iterateReverse` exists to remove.
emitListIterCursor: function {
    ctx: Ctx
    liId: ztypes.tid
    ovId: ztypes.tid
    # the yielded option's `none` tag constant
    ovNone: StringView
    # the yielded option's `some` tag constant
    ovSome: StringView
    ect: StringView
    buf: String.borrow
} is {
    if (listIterEmitted :ctx tid: liId) then return
    listIterMark :ctx tid: liId
    li: cbaseNoPrefix :ctx tid: liId
    ov: cbaseNoPrefix :ctx tid: ovId
    s0: "typedef struct {\n    \{ect}* data;\n    uint64_t length;\n    uint64_t idx;\n    bool down;\n} z_\{li}_t;\n"
    buf.append s0
    s1: "static z_\{ov}_t z_\{li}_call(z_\{li}_t* _it);\n"
    buf.append s1
    s2: "static z_\{ov}_t z_\{li}_call(z_\{li}_t* _it) {\n"
    buf.append s2
    s3: "    z_\{ov}_t _out = {0};\n"
    buf.append s3
    s4: "    if (_it->idx >= _it->length) { _out.tag = \{ovNone}; return _out; }\n"
    buf.append s4
    s5: "    _out.tag = \{ovSome};\n"
    buf.append s5
    s6: "    _out.data = &_it->data[_it->down ? (_it->length - 1 - _it->idx) : _it->idx];\n"
    buf.append s6
    s7: "    _it->idx++;\n    return _out;\n}\n"
    buf.append s7
}

# emitIterCursorOf -- the list cursor `liId` and the view union its `call`
# yields, emitted once. False when either was never minted, or the cursor is
# spelled by nothing the program writes, which leaves the walk with nothing to
# emit.
emitIterCursorOf: function {
    # the arm names
    ast: Ast.view
    ctx: Ctx
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    liId: ztypes.tid
    ect: StringView
    buf: String.borrow
} out bool is {
    if liId.isZero then return false
    if (typeReached :ctx tid: liId).not then return false
    ovId: monoMethodReturn :reg :typing monoId: liId nameId: zast.wellKnown.slot.wkCall
    if ovId.isZero then return false
    if (listIterEmitted :ctx tid: liId) then return true
    ovNone: spelledTagConst :ast :ctx :reg :typing tid: ovId armId: zast.wellKnown.slot.wkNone
    ovSome: spelledTagConst :ast :ctx :reg :typing tid: ovId armId: zast.wellKnown.slot.wkSome
    (
        emitListIterCursor
        :ctx
        :liId
        :ovId
        ovNone: ovNone.stringView
        ovSome: ovSome.stringView
        :ect
        :buf
    )
    return true
}

# emitListIter -- the borrowed-view iterators over a List or ListView mono: the
# shared cursors (above) plus this container's constructors, each emitted only
# when its walk resolved (the iterator and view union monos were minted). The
# readonly walks yield an OptionView through ListIter, `iterateMut` an OptionMut
# through ListIterMut; the two cursors are the same shape under two names. The
# view union monos are emitted by the earlier pass, so this can reference them.
emitListIter: function {
    # the arm names
    ast: Ast.view
    ctx: Ctx
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    monoId: ztypes.tid
    nm: StringView
    ect: StringView
    buf: String.borrow
} is {
    liId: monoMethodReturn :reg :typing :monoId nameId: zast.wellKnown.slot.wkIterate
    # a mono that walks only BACKWARDS mints its cursor through the reverse
    # member, so the forward one answers nothing and the cursor would go
    # unemitted under a name the reverse constructor then names
    if liId.isZero then {
        liId = monoMethodReturn :reg :typing :monoId nameId: zast.wellKnown.slot.wkIterateReverse
    }
    if (emitIterCursorOf :ast :ctx :reg :typing :liId :ect :buf) then {
        emitListIterReadonly :ctx :monoId :liId :nm :buf
    }
    # iterateMut -- the mutable walk, for a mono that declares one: its own
    # cursor type, since what it yields may be written. The C bodies are the
    # same as the readonly walk's; the two differ only in what the typechecker
    # lets the caller do with the elements. A view declares none: it is
    # readonly, and an ungated one would be a writable walk over storage the
    # view may not write.
    if (memberUsed :ctx mono: monoId member: memberWord.slot.iterateMut).not then return
    lmId: monoMethodReturn :reg :typing :monoId nameId: zast.wellKnown.slot.wkIterateMut
    if (emitIterCursorOf :ast :ctx :reg :typing liId: lmId :ect :buf).not then return
    lm: cbaseNoPrefix :ctx tid: lmId
    (
        appendCursorCtor
        head: "static z_\{lm}_t z_\{nm}_iterateMut(z_\{nm}_t* _this)"
        cursor: lm.stringView
        down: false
        :buf
    )
}

# appendCursorCtor -- the prototype and body of a List mono's cursor constructor
# whose signature is `head`: a `cursor` over the receiver's whole window, walked
# from the far end when `down`.
appendCursorCtor: function {
    head: String
    cursor: StringView
    down: bool
    buf: String.borrow
} is {
    dn: if down then "true" else "false"
    buf.append head
    buf.append ";\n"
    buf.append head
    body: " {\n    z_\{cursor}_t _it = {0};\n    _it.data = _this->data;\n    _it.length = _this->length;\n    _it.idx = 0;\n    _it.down = \{dn};\n    return _it;\n}\n\n"
    buf.append body
}

# emitListIterReadonly -- `iterate` and `iterateReverse` over the ListIter
# cursor `liId`, each when used.
emitListIterReadonly: function {
    ctx: Ctx
    monoId: ztypes.tid
    liId: ztypes.tid
    nm: StringView
    buf: String.borrow
} is {
    li: cbaseNoPrefix :ctx tid: liId
    # `iterate` is the READONLY walk, so its receiver is const and view-guard
    # checks it. No cast is needed to read the window out of it -- a const
    # struct makes its members `T* const` and the top-level const drops on read
    # -- but the cursor's own `data` is a plain T*, and OptionView's payload is
    # one void* shared with the readers that hand out a mutable interior
    # pointer on purpose (List.get's write-back). So the laundering is at that
    # field. That the ELEMENTS are readonly is a typecheck-level guarantee --
    # the element inherits the strength of the lock its holder has on the
    # container.
    if (memberUsed :ctx mono: monoId member: memberWord.slot.iterateAll) then {
        (
            appendCursorCtor
            head: "static z_\{li}_t z_\{nm}_iterate(const z_\{nm}_t* _this)"
            cursor: li.stringView
            down: false
            :buf
        )
    }
    # iterateReverse -- the same cursor over the same window, walked from the
    # far end. Readonly like `iterate`, and there is no mutable twin: writing
    # through a walk is `iterateMut`, in either direction it is the same lock.
    if (memberUsed :ctx mono: monoId member: memberWord.slot.iterateReverse) then {
        (
            appendCursorCtor
            head: "static z_\{li}_t z_\{nm}_iterateReverse(const z_\{nm}_t* _this)"
            cursor: li.stringView
            down: true
            :buf
        )
    }
}

# emitListSort -- stable in-place mergesort companion (scalar `<`).
emitListSort: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    nm: StringView
    ect: StringView
    # the element type, whose `compare` orders the list
    elem: ztypes.tid
    isStr: bool
    isSv: bool
    buf: String.borrow
} is {
    s0: "static int z_\{nm}_sort_lt(\{ect} _a, \{ect} _b)"
    lt: String
    if isStr.not when isSv.not then lt = sortLessC :ast :reg :typing :ctx :elem
    if isStr then {
        preludeNeed :ctx memb: "@String_cmp"
        buf.append "\{s0} { return \{ctx.strC}_cmp(&_a, &_b) < 0; }\n"
    } else if isSv then {
        preludeNeed :ctx memb: "@StringView_cmp"
        buf.append "\{s0} { return \{ctx.svC}_cmp(_a, _b) < 0; }\n"
    } else if (sortCallsWritten :ast :reg :typing :elem) then {
        buf.append "\{s0};\n"
        ctx.lateDefs.append "\{s0} { return \{lt}; }\n\n"
    } else {
        buf.append "\{s0} { return \{lt}; }\n"
    }
    s1: "static void z_\{nm}_sort_merge(\{ect}* data, \{ect}* scratch, uint64_t lo, uint64_t mid, uint64_t hi) {\n"
    buf.append s1
    buf.append "    uint64_t i = lo, j = mid, k = lo;\n"
    buf.append "    while (i < mid && j < hi) {\n"
    sm: "        if (!z_\{nm}_sort_lt(data[j], data[i])) scratch[k++] = data[i++];\n"
    buf.append sm
    buf.append "        else scratch[k++] = data[j++];\n"
    buf.append "    }\n"
    buf.append "    while (i < mid) scratch[k++] = data[i++];\n"
    buf.append "    while (j < hi) scratch[k++] = data[j++];\n"
    buf.append "    memcpy(&data[lo], &scratch[lo], (hi - lo) * sizeof(*data));\n"
    buf.append "}\n"
    s2: "static void z_\{nm}_sort_rec(\{ect}* data, \{ect}* scratch, uint64_t lo, uint64_t hi) {\n"
    buf.append s2
    buf.append "    if (hi - lo <= 1) return;\n"
    buf.append "    uint64_t mid = lo + (hi - lo) / 2;\n"
    sr1: "    z_\{nm}_sort_rec(data, scratch, lo, mid);\n"
    buf.append sr1
    sr2: "    z_\{nm}_sort_rec(data, scratch, mid, hi);\n"
    buf.append sr2
    sr3: "    z_\{nm}_sort_merge(data, scratch, lo, mid, hi);\n"
    buf.append sr3
    buf.append "}\n"
    s3: "static void z_\{nm}_sort(z_\{nm}_t* _this) {\n"
    buf.append s3
    buf.append "    if (_this->length < 2) return;\n"
    preludeNeed :ctx memb: "@xmalloc"
    sa: "    \{ect}* scratch = (\{ect}*)z_xmalloc(_this->length * sizeof(\{ect}));\n"
    buf.append sa
    sd: "    z_\{nm}_sort_rec(_this->data, scratch, 0, _this->length);\n"
    buf.append sd
    buf.append "    free(scratch);\n"
    buf.append "}\n\n"
}

# emitListViewMono -- substitute template ListView for a ListView mono.
emitListViewMono: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    eid: listElemType :reg :typing :monoId
    elemC: slotCType :ast :reg :typing :ctx tid: eid
    ect: ctypeOrI64 s: elemC.stringView
    p: tmplKey :ctx name: "ListView"
    ti: tmplTextOf :ctx key: p
    if (rtEmpty :ctx id: ti).not then {
        kt: RtKeys.create
        rtKey :ctx keys: kt name: "NAME" val: nm.stringView
        rtKey :ctx keys: kt name: "ELEM_T" val: ect.stringView
        buf.append (rtFillKeys :ctx id: ti keys: kt)
        buf.append "\n"
    }
    if (memberUsed :ctx mono: monoId member: memberWord.slot.getOne) then {
        (
            emitColGet
            :ctx
            nm: nm.stringView
            ect: ect.stringView
            kind: "ListView"
            ptr: (elemBorrowsByPtr :reg :typing :ctx tid: eid)
            mutPtr: (elemRefByPtr :reg :typing :ctx tid: eid)
            hasGet: true
            hasMut: false
            :buf
        )
    }
    (
        emitListSliceOnDemand
        :reg
        :typing
        :ctx
        :monoId
        nm: nm.stringView
        kind: "ListView"
        :buf
    )
    emitListIter :ast :ctx :reg :typing :monoId nm: nm.stringView ect: ect.stringView :buf
}

# emitStaticListMono -- a static list's value mono (`staticlist u8`): template data's view
# struct -- a length and a pointer at the list's static const array -- and each
# member a use site reached: `index`, the bounds-checked read, and `iterate`,
# which hands the window to the cursor. The cursor's `data` is a plain pointer
# shared with walks that write, so the const is dropped there; the typechecker
# is what keeps a list walk readonly.
emitStaticListMono: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    eid: reg.genericTypeArgAt specId: monoId ordinal: 0
    elemC: slotCType :ast :reg :typing :ctx tid: eid
    ect: ctypeOrI64 s: elemC.stringView
    est: staticListStoredC ect: ect.stringView
    p: tmplKey :ctx name: "data"
    ti: tmplTextOf :ctx key: p
    if (rtEmpty :ctx id: ti).not then {
        kt: RtKeys.create
        rtKey :ctx keys: kt name: "NAME" val: nm.stringView
        rtKey :ctx keys: kt name: "ELEM_T" val: est.stringView
        buf.append (rtFillKeys :ctx id: ti keys: kt)
        buf.append "\n"
    }
    if (memberUsed :ctx mono: monoId member: memberWord.slot.getOne) then {
        buf.append "static \{ect} z_\{nm}_index(z_\{nm}_t _this, uint64_t _idx);\n"
        buf.append "static \{ect} z_\{nm}_index(z_\{nm}_t _this, uint64_t _idx) {\n"
        buf.append "    if (_idx >= _this.length) {\n"
        buf.append "        char _zp_buf[96];\n"
        b2: "        snprintf(_zp_buf, sizeof(_zp_buf), \"list index: index %llu out of bounds (length %llu)\", (unsigned long long)_idx, (unsigned long long)_this.length);\n"
        buf.append b2
        preludeNeed :ctx memb: "@panic"
        buf.append "        z_panic(_zp_buf);\n"
        buf.append "    }\n"
        buf.append "    return _this.data[_idx];\n"
        buf.append "}\n\n"
    }
    if (memberUsed :ctx mono: monoId member: memberWord.slot.iterateAll).not then return
    liId: monoMethodReturn :reg :typing :monoId nameId: zast.wellKnown.slot.wkIterate
    if (emitIterCursorOf :ast :ctx :reg :typing :liId ect: ect.stringView :buf).not then return
    li: cbaseNoPrefix :ctx tid: liId
    buf.append "static z_\{li}_t z_\{nm}_iterate(const z_\{nm}_t* _this);\n"
    buf.append "static z_\{li}_t z_\{nm}_iterate(const z_\{nm}_t* _this) {\n"
    buf.append "    z_\{li}_t _it = {0};\n"
    buf.append "    _it.data = (\{ect}*)_this->data;\n"
    buf.append "    _it.length = _this->length;\n"
    buf.append "    return _it;\n"
    buf.append "}\n\n"
}

# emitSpanMono -- a SpanVal mono: the window struct, which is a ListView's -- a
# length and a data pointer -- and each member a use site resolved on this
# instance, written on its own demand. split, listView and copyFrom build or
# take another type's value, so they are written at the call instead, where
# every struct is complete.
emitSpanMono: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    eid: listElemType :reg :typing :monoId
    elemC: slotCType :ast :reg :typing :ctx tid: eid
    ect: ctypeOrI64 s: elemC.stringView
    p: tmplKey :ctx name: "ListView"
    ti: tmplTextOf :ctx key: p
    if (rtEmpty :ctx id: ti).not then {
        kt: RtKeys.create
        rtKey :ctx keys: kt name: "NAME" val: nm.stringView
        rtKey :ctx keys: kt name: "ELEM_T" val: ect.stringView
        buf.append (rtFillKeys :ctx id: ti keys: kt)
        buf.append "\n"
    }
    if (memberUsed :ctx mono: monoId member: memberWord.slot.getOne) then (
        emitColGet
        :ctx
        nm: nm.stringView
        ect: ect.stringView
        kind: "SpanVal"
        ptr: (elemBorrowsByPtr :reg :typing :ctx tid: eid)
        mutPtr: false
        hasGet: true
        hasMut: false
        :buf
    )
    (
        emitSpanMemberOnDemand
        :ctx
        :monoId
        member: memberWord.slot.set
        file: "SpanVal_set"
        nm: nm.stringView
        ect: ect.stringView
        :buf
    )
    (
        emitSpanMemberOnDemand
        :ctx
        :monoId
        member: memberWord.slot.slice
        file: "SpanVal_slice"
        nm: nm.stringView
        ect: ect.stringView
        :buf
    )
    (
        emitSpanMemberOnDemand
        :ctx
        :monoId
        member: memberWord.slot.fill
        file: "SpanVal_fill"
        nm: nm.stringView
        ect: ect.stringView
        :buf
    )
    (
        emitSpanMemberOnDemand
        :ctx
        :monoId
        member: memberWord.slot.clear
        file: "SpanVal_clear"
        nm: nm.stringView
        ect: ect.stringView
        :buf
    )
}

# emitSpanMemberOnDemand -- emitColMethodOnDemand for a window, whose one hole
# beyond NAME is the element type.
emitSpanMemberOnDemand: function {
    ctx: Ctx
    monoId: ztypes.tid
    # the member, a memberWord slot
    member: u64
    file: StringView
    nm: StringView
    ect: StringView
    buf: String.borrow
} is {
    (
        emitColMethodOnDemand
        :ctx
        :monoId
        :member
        :file
        :nm
        hole: "ELEM_T"
        holeVal: ect
        :buf
    )
}

# listviewMethods -- the _listView cast and the _extendView companion of a List
# mono, each where written C calls it (memberUsed); "" otherwise.
listviewMethods: function {
    ctx: Ctx
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    monoId: ztypes.tid
    nm: StringView
    ect: StringView
} out String is {
    lo: typing.declChildOfId parentTypeId: monoId nameId: zast.wellKnown.slot.wkListView
    if lo.some then {
        rt: fnReturnTidOf :reg tid: lo
        if rt.notZero then {
            {
                lvc: ctxCname :ctx tid: rt
                buf: String
                if (memberUsed :ctx mono: monoId member: memberWord.slot.listView) then {
                    m0: "static \{lvc}_t z_\{nm}_listView(const z_\{nm}_t* _this) { return *(\{lvc}_t*)_this; }\n"
                    buf.append m0
                }
                if (memberUsed :ctx mono: monoId member: memberWord.slot.extendView) then {
                    m1: "static void z_\{nm}_extendView(z_\{nm}_t* _this, \{lvc}_t _from) {\n"
                    buf.append m1
                    # an empty window carries a null data pointer, and memcpy is
                    # undefined on one even for zero bytes -- as is indexing
                    # _this->data before grow has allocated anything
                    buf.append "    if (_from.length == 0) { return; }\n"
                    noteMemberUse :ctx mono: monoId member: memberWord.slot.grow
                    m2: "    z_\{nm}_grow(_this, _this->length + _from.length);\n"
                    buf.append m2
                    m3: "    memcpy(&_this->data[_this->length], _from.data, _from.length * sizeof(\{ect}));\n"
                    buf.append m3
                    buf.append "    _this->length += _from.length;\n"
                    buf.append "}\n\n"
                }
                return buf
            }
        }
    }
    return "".string
}


# buildDefUnitIndex -- snapshot tid -> defining-unit DECLARATION once per
# emission (the Decl chain is immutable during emission); zero-alloc id
# lookups then serve the hot definedInNonMain path. Interning a fresh integer
# per unit NAME collapsed two units that share a spelling into one id.
buildDefUnitIndex: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx
} is {
    t: ztypes.tid
    n: reg.nextTid
    for t < n loop {
        udd: ztypecheck.unitDeclOfTid :reg :typing tid: t
        if udd.notZero then {
            ctx.defUnitId.set key: t value: udd
        }
        t = t.next
    }
}

# ctxBindMain -- rebind the emission main unit: mainName plus its unit
# DECLARATION, which the CALLER supplies. Every caller already holds the unit
# by id -- off the type it is emitting, off the unit node it is walking, or
# saved from the bind it is restoring -- so nothing here asks which unit is
# spelled a given way. Every mainName assignment must route through here so
# mainUnitId never goes stale (definedInNonMain compares against it).
ctxBindMain: function {ctx: Ctx name: StringView unitDecl: ztypes.declid} is {
    nm: name.string
    ctx.mainName = nm.take
    ctx.mainUnitId = unitDecl
}

# typeHasNativeCreate -- the type's own `create` is declared native, so the
# runtime supplies that symbol and the field-wise meta_create alias would
# redeclare it with a different signature.
typeHasNativeCreate: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view tid: ztypes.tid
} out bool is {
    co: typing.declChildOfId parentTypeId: tid nameId: zast.wellKnown.slot.wkCreate
    match (
        co
    ) case some then {
        return (reg.isNativeOf tid: co)
    } case none then {
        return false
    }
}

# definedInNonMain -- the type is defined in a non-main (system/io/...)
# unit (a reachable library type to emit alongside the main closure).
definedInNonMain: function {
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    dgo: ctx.defUnitId.get key: tid
    match (
        dgo
    ) case some then {
        return dgo != ctx.mainUnitId
    } case none then {
        return false
    }
}

# emitUnionMono -- a UNION (a user union, an Option/Result mono): tag enum +
# { tag; slot } struct, the slot a `void* data` overlaid by each inline arm's
# member (emitUnionSlot), + destroy (free a cell arm's payload, recursing into
# an aggregate payload's destructor first; an inline arm frees nothing).
emitUnionMono: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    if (ctx.emittedUserTypes.has item: tid) then return
    ctx.emittedUserTypes.add item: tid
    aids: ListVal ztypes.tid
    aidsNm: ListVal zast.nameid
    variantArmIds :reg :typing :tid ids: aids nameIds: aidsNm
    # an arm-less union is a constraint-only bound (`AnyRef`): no
    # runtime form, and an empty C enum does not compile. See emitOneVariant.
    if aidsNm.length == 0 then return
    # an inline arm holds its payload by value, so the payload's struct comes
    # first
    inlTids: ListVal ztypes.tid
    unionInlineArmTids :reg :typing :tid acc: inlTids
    preEmitEmbeddedTypes :ast :reg :typing :ctx ids: inlTids :buf
    vc: spelledCname :ctx :tid
    buf.append "typedef enum {\n"
    ai: u64
    an: aidsNm.length
    for ai < an loop {
        aname: aidsNm.get i: ai
        tg: spelledTagConst :ast :ctx :reg :typing :tid armId: aname
        tv: armTagValueText :typing :tid armNameId: aname
        lt: "    \{tg}\{tv},\n"
        buf.append lt
        ai = ai + 1
    }
    le: "} \{vc}_tag_t;\n"
    buf.append le
    if (isFwdDeclared :ctx :tid) then {
        lopenU: "struct \{vc}_t {\n"
        buf.append lopenU
    } else {
        buf.append "typedef struct {\n"
    }
    tsc: tagStorageCType :reg :typing :tid
    if tsc.length == 0 then {
        lfE: "    \{vc}_tag_t tag;\n"
        buf.append lfE
    } else {
        lfD: "    \{tsc} tag;\n"
        buf.append lfD
    }
    inlineAsserts: emitUnionSlot :ast :reg :typing :ctx :tid arms: aidsNm :buf
    if (isFwdDeclared :ctx :tid) then {
        buf.append "};\n"
    } else {
        lg: "} \{vc}_t;\n"
        buf.append lg
    }
    buf.append inlineAsserts
    if (destroyWritten :reg :ctx :tid).not then return
    ld: "static void \{vc}_destroy(\{vc}_t* u) {\n"
    buf.append ld
    buf.append "    if (!u) return;\n"
    ab: armCellAbsent slot: "u->data"
    buf.append "    if (\{ab}) return;\n"
    buf.append "    switch (u->tag) {\n"
    pj: u64
    for pj < an loop {
        pname: aidsNm.get i: pj
        # an inline payload is a value in the slot, and a non-owned arm's
        # points at its pinned source: nothing to destroy or free in either
        owned: (typing.declIsBorrowedFieldId parentTypeId: tid nameId: pname).not
        hasP: armHasPayload :reg :typing :tid arm: pname
        if hasP when owned when (armIsInlineC :typing :tid arm: pname).not then {
            ptg: spelledTagConst :ast :ctx :reg :typing :tid armId: pname
            lcase: "        case \{ptg}:\n"
            buf.append lcase
            emitArmPayloadDestroy :ast :reg :typing :ctx :tid arm: pname :buf
            uf: armCellFree slot: "u->data"
            buf.append "            \{uf}\n"
            buf.append "            break;\n"
        }
        pj = pj + 1
    }
    buf.append "        default: break;\n"
    buf.append "    }\n"
    buf.append "}\n\n"
}

# emitUnionSlot -- a union's payload slot: `void* data`, overlaid -- when any arm
# is inline -- by each inline arm's own member, in an anonymous union so `data`
# keeps its name. Answers the assertions, one per inline arm, that its payload
# fits the language's 8-byte slot as the checker measured it
# (checkUnionArmSlots): the C compiler holds the checker to the layout.
emitUnionSlot: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    # the union's arms, by name
    arms: (ListVal zast.nameid).view
    buf: String.borrow
} out String is {
    members: String
    asserts: String
    for each an: arms loop {
        if (armIsInlineC :typing :tid arm: an) then {
            pc: armPayloadC :ast :reg :typing :ctx :tid arm: an
            im: memberC :ast :reg :typing :ctx owner: tid kind: memberkind.inlineArm nameId: an
            members.append "        \{pc} \{im};\n"
            asserts.append "_Static_assert(sizeof(\{pc}) <= 8 && _Alignof(\{pc}) <= 8, \"union arm payload wider than its 8-byte slot\");\n"
        }
    }
    if members.length == 0 then {
        buf.append "    void* data;\n"
        return asserts
    }
    buf.append "    union {\n        void* data;\n"
    buf.append members
    buf.append "    };\n"
    return asserts
}

# payloadDestructor -- the destructor cname for an arm whose payload is an
# aggregate with a destructor ("" for scalar/view payloads).
payloadDestructor: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    arm: zast.nameid
} out String is {
    co: typing.declChildOfId parentTypeId: tid nameId: arm
    if co.some then {
        if (reg.typetypeOf typeId: co) == ztypes.ztypetype.nullType then return "".string
        # childOf already resolves the arm to its concrete (possibly cross-unit)
        # payload id; canonicalize a destructor-less shell (canonTypeId), the same
        # way the List-element destructor does
        pfn: destroyFnC :reg :typing :ctx tid: co
        if pfn.length > 0 then return pfn
        rbn: canonTypeId :reg :typing tid: co
        if rbn.notZero then return (destroyFnC :reg :typing :ctx tid: rbn)
    }
    return "".string
}

# monoMethodReturn -- a mono method child's registered return id (0 when the
# method or its return is absent). The id-first way to reach a collection's
# iterator/view/wrapper companions.
monoMethodReturn: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    monoId: ztypes.tid
    nameId: zast.nameid
} out ztypes.tid is {
    co: typing.declChildOfId parentTypeId: monoId :nameId
    if co.some then {
        mro: ztypecheck.methodReturnOf :reg :typing mid: co
        if mro.some then {
            return mro
        }
    }
    return ztypes.tid.zero
}


# setHashBody / setEqBody / setDestroyItems -- the element-kind-specific
# fragments of a Set mono: the keyed byte hash (SipHash by default,
# z_fasthash_* under --fast-hash) + memcmp + per-item free for String keys,
# the integer hash + `==` + no item cleanup otherwise.
# declaredKeyFnId -- the fn id of a `hash` or `==` the KEY TYPE declared, or
# zero when it declares none. A reftype key has no byte representation to hash --
# its contents live behind a pointer -- so RefHashable makes it declare both,
# and the container must then CALL them instead of casting the aggregate. A
# typedef over an aggregate keys by the first link of its chain that declares
# each, as the checker admitted it; a scalar typedef hashes as its scalar.
declaredKeyFnId: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    keyTid: ztypes.tid
    # the member, `hash` or `==`
    nid: zast.nameid
} out ztypes.tid is {
    if nid.isZero then return ztypes.tid
    tid: keyTid
    if (chaseAggregateTypedef :reg :typing :ctx tid: keyTid) != keyTid then {
        tid = ztypecheck.valOpOwner :typing tid: keyTid nameId: nid
    }
    if (typing.declIsMethodId parentTypeId: tid nameId: nid).not then return ztypes.tid
    if (typing.declMemberIsSynth parentTypeId: tid nameId: nid) then return ztypes.tid
    mo: typing.declChildOfId parentTypeId: tid nameId: nid
    match (
        mo
    ) case some then {
        return mo
    } case none then {
        return ztypes.tid
    }
}

# declaredKeyFnC -- the C name of a declared key `hash` or `==`, "" when the
# key declares none.
#
# The member's receiver is a pointer like any other method's, and the template
# holds the key BY VALUE, so the caller addresses it.
declaredKeyFnC: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    memberId: zast.nameid
} out String is {
    fid: declaredKeyFnId :reg :typing :ctx keyTid: tid nid: memberId
    if fid.isZero then return "".string
    noteFnUse :ctx tid: fid
    return (ctxCname :ctx tid: fid)
}

# keyFnParamConstC -- "const " when the declared key method's parameter at
# `index` is a view (its pointer is written `const` in the definition), ""
# otherwise or when there is no such method.
keyFnParamConstC: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    fid: ztypes.tid
    index: u64
} out String is {
    if fid.isZero then return "".string
    pIds: ListVal ztypes.tid
    pIdsNm: ListVal zast.nameid
    recFieldIds :reg :typing tid: fid ids: pIds nameIds: pIdsNm
    if index >= pIdsNm.length then return "".string
    if (
        typing.declOwnershipIs
        parentTypeId: fid
        nameId: (pIdsNm.get i: index)
        own: ztypes.zparamownership.viewMode
    ) then return "const ".string
    return "".string
}

# keyFnProtosC -- the prototypes of a key's declared `hash` and `==`: the mono
# is emitted before user method bodies, so it declares the two it calls, and
# each must agree with its definition, which says `const` on a view pointer.
# The receiver is the first parameter; `==`'s `rhs` is the second, a pointer
# when the key's calling convention is.
keyFnProtosC: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
    dh: StringView
    de: StringView
    keyT: StringView
    rhsT: StringView
    rhsByPtr: bool
} out String is {
    hfid: declaredKeyFnId :reg :typing :ctx keyTid: tid nid: zast.wellKnown.slot.wkHash
    efid: declaredKeyFnId :reg :typing :ctx keyTid: tid nid: zast.wellKnown.slot.wkOpEq
    hq: keyFnParamConstC :reg :typing fid: hfid index: 0
    eq: keyFnParamConstC :reg :typing fid: efid index: 0
    rq: String
    if rhsByPtr then rq = keyFnParamConstC :reg :typing fid: efid index: 1
    return "static uint64_t \{dh}(\{hq}\{keyT}*);\nstatic bool \{de}(\{eq}\{keyT}*, \{rq}\{rhsT});\n"
}

# keyHashKind -- classify a Set element / Map key by canonical id (never by
# name, so a user shadow is handled by its nature): 1 native String, 2
# StringView, 3 by-value struct (record/variant -> byte hash over contents), 0
# scalar or pointer (cast hash + C `==`). A builtin numeric/bool/char is a
# record whose C type is a scalar, so it classifies 0 with the pointers --
# scalarCTypeFor is the shadow-safe gate (a user type shadowing a scalar name
# stays a struct). A record holds value data only, so a struct's `_eq` is
# total: the typechecker refuses a reftype member at the declaration.
keyHashKind: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx.view tid: ztypes.tid
} out u64 is {
    ktid: ztypecheck.typedefChaseTid :typing :tid
    if ktid == ctx.strTid then return 1
    if (isViewLaid :ctx tid: ktid) then return 2
    tt: reg.typetypeOf typeId: ktid
    isRv: tt == ztypes.ztypetype.recordType
    if isRv.not then isRv = tt == ztypes.ztypetype.variantType
    if isRv then {
        sc: scalarCTypeFor :typing tid: ktid
        if sc.length > 0 then return 0
        return 3
    }
    return 0
}

# the C body of a Set's hash function.
setHashBody: function {ctx: Ctx kind: u64} out String is {
    # a String key arrives BY POINTER (the probe never copies the header)
    if kind == 1 then return "\{hashBytesFn :ctx}(_key->data, _key->size)"
    if kind == 2 then return "\{hashViewFn :ctx}(_key)"
    if kind == 3 then return "\{hashBytesFn :ctx}(&_key, sizeof(_key))"
    return (hashU64C :ctx v: "(uint64_t)_key")
}

# hashBytesFn -- the C function hashing a run of bytes: SipHash, or the fast
# hash under --fast-hash. Written C calls it through here, so it is written.
hashBytesFn: function {ctx: Ctx} out String is {
    if ctx.fastHash then {
        preludeNeed :ctx memb: "@fasthash_bytes"
        return "z_fasthash_bytes".string
    }
    preludeNeed :ctx memb: "@siphash_bytes"
    return "z_siphash_bytes".string
}

# hashViewFn -- hashBytesFn for the bytes a StringView views
hashViewFn: function {ctx: Ctx} out String is {
    if ctx.fastHash then {
        preludeNeed :ctx memb: "@fasthash_stringview"
        return "z_fasthash_stringview".string
    }
    preludeNeed :ctx memb: "@siphash_stringview"
    return "z_siphash_stringview".string
}

# hashU64C -- the C mixing the 64-bit word `v` into a hash
hashU64C: function {ctx: Ctx v: StringView} out String is {
    preludeNeed :ctx memb: "@hash_u64"
    return "z_hash_u64(\{v})"
}

# the C body of a Set's element-equality function.
setEqBody: function {kind: u64} out String is {
    if (
        kind == 1
    ) then return "_a->size == _b->size && (_a->size == 0 || memcmp(_a->data, _b->data, _a->size) == 0)".string
    if (
        kind == 2
    ) then return "_a.size == _b.size && (_a.size == 0 || memcmp(_a.data, _b.data, _a.size) == 0)".string
    if kind == 3 then return "memcmp(&_a, &_b, sizeof(_a)) == 0".string
    return "_a == _b".string
}

# the C body that destroys a Set's items, handed the item's free statement
# (mapValFreeStmt), empty for an item that owns nothing.
setDestroyItems: function {itemFree: StringView} out String is {
    if itemFree.length > 0 then {
        return "    for (uint64_t i = 0; i < p->entries_len; i++) {\n        if (p->entries[i].alive) {\n            \{itemFree}\n        }\n    }\n"
    }
    return "".string
}

# the C snippet duplicating a Set item.
setFreeItemDup: function {itemFree: StringView} out String is {
    if itemFree.length > 0 then return "        \{itemFree}\n"
    return "".string
}

# the C snippet deleting a Set item.
setFreeItemDel: function {itemFree: StringView} out String is {
    if itemFree.length > 0 then return "    \{itemFree}\n"
    return "".string
}

# emitOptionViewMono -- the borrowed-view option a collection iterator yields:
# a {tag; void* data} struct with a no-op destroy (the view owns nothing).
emitOptionViewMono: function {
    # the arm names
    ast: Ast.view
    ctx: Ctx.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    buf.append "typedef enum {\n"
    l1: "    \{tagConstOf :ast :ctx :reg :typing tid: monoId armId: zast.wellKnown.slot.wkNone},\n"
    buf.append l1
    l2: "    \{tagConstOf :ast :ctx :reg :typing tid: monoId armId: zast.wellKnown.slot.wkSome},\n"
    buf.append l2
    l3: "} z_\{nm}_tag_t;\n"
    buf.append l3
    buf.append "typedef struct {\n"
    tscO: tagStorageCType :reg :typing tid: monoId
    if tscO.length == 0 then {
        l4: "    z_\{nm}_tag_t tag;\n"
        buf.append l4
    } else {
        l4d: "    \{tscO} tag;\n"
        buf.append l4d
    }
    buf.append "    void* data;\n"
    l5: "} z_\{nm}_t;\n"
    buf.append l5
    if (destroyWritten :reg :ctx tid: monoId).not then {
        buf.append "\n"
        return
    }
    l6: "static void z_\{nm}_destroy(z_\{nm}_t* u) { (void)u; }\n\n"
    buf.append l6
}

# setViewProbes -- a String-keyed Set's view-keyed probes, each written where
# written C calls it (hasv, deletev). The view's bytes are wrapped in a String
# header that aliases them: has and delete only hash and compare the probe,
# never store or free it (delete frees the STORED item only). Each records the
# member it forwards to, so the instance written after keeps it.
setViewProbes: function {ctx: Ctx monoId: ztypes.tid nm: StringView buf: String.borrow} is {
    if (memberUsed :ctx mono: monoId member: memberWord.slot.hasv) then {
        noteMemberUse :ctx mono: monoId member: memberWord.slot.has
        svT: svTypeC :ctx
        sv0: "static int z_\{nm}_hasv(const z_\{nm}_t* _this, \{svT} _item) {\n"
        buf.append sv0
        strT: strTypeC :ctx
        sv1: "    \{strT} _k = { _item.size, (char*)_item.data, _item.size };\n"
        buf.append sv1
        sv2: "    return z_\{nm}_has(_this, &_k);\n}\n\n"
        buf.append sv2
    }
    if (memberUsed :ctx mono: monoId member: memberWord.slot.deletev) then {
        noteMemberUse :ctx mono: monoId member: memberWord.slot.delete
        svT: svTypeC :ctx
        sd0: "static int z_\{nm}_deletev(z_\{nm}_t* _this, \{svT} _item) {\n"
        buf.append sd0
        strT: strTypeC :ctx
        sd1: "    \{strT} _k = { _item.size, (char*)_item.data, _item.size };\n"
        buf.append sd1
        sd2: "    return z_\{nm}_delete(_this, &_k);\n}\n\n"
        buf.append sd2
    }
}

# mapViewProbes -- a String-keyed Map's view-keyed probes, each written where
# written C calls it (getv, hasv), as a Set's are (setViewProbes)
mapViewProbes: function {
    ctx: Ctx monoId: ztypes.tid nm: StringView ov: StringView buf: String.borrow
} is {
    if (memberUsed :ctx mono: monoId member: memberWord.slot.getv) then {
        noteMemberUse :ctx mono: monoId member: memberWord.slot.getOne
        svT: svTypeC :ctx
        gv0: "static z_\{ov}_t z_\{nm}_getv(const z_\{nm}_t* _this, \{svT} _key) {\n"
        buf.append gv0
        strT: strTypeC :ctx
        gv1: "    \{strT} _k = { _key.size, (char*)_key.data, _key.size };\n"
        buf.append gv1
        gv2: "    return z_\{nm}_get(_this, &_k);\n}\n\n"
        buf.append gv2
    }
    if (memberUsed :ctx mono: monoId member: memberWord.slot.hasv) then {
        noteMemberUse :ctx mono: monoId member: memberWord.slot.has
        svT: svTypeC :ctx
        hv0: "static int z_\{nm}_hasv(const z_\{nm}_t* _this, \{svT} _key) {\n"
        buf.append hv0
        strT: strTypeC :ctx
        hv1: "    \{strT} _k = { _key.size, (char*)_key.data, _key.size };\n"
        buf.append hv1
        hv2: "    return z_\{nm}_has(_this, &_k);\n}\n\n"
        buf.append hv2
    }
}

# emitSetMono -- substitute template Set for a Set instance (compact-dict
# struct + add/has/delete/iterate + the SetIter companion). Depends on the
# element's OptionView mono being emitted first (the iterator yields it).
emitSetMono: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    mcr: cUpperOf text: nm.stringView
    elemTid: setElemType :typing :monoId
    itemT: cTypeForNameTid :ast :reg :typing :ctx tid: elemTid
    ekind: keyHashKind :reg :typing :ctx tid: elemTid
    isStr: ekind == 1
    siId: monoMethodReturn :reg :typing :monoId nameId: zast.wellKnown.slot.wkIterate
    if siId.isZero then return
    ovId: monoMethodReturn :reg :typing monoId: siId nameId: zast.wellKnown.slot.wkCall
    if ovId.isZero then return
    ov: cbaseNoPrefix :ctx tid: ovId
    si: cbaseNoPrefix :ctx tid: siId
    # the view-keyed probes, written after the instance, call its members:
    # they are decided before the instance's text is
    vp: String
    if isStr then setViewProbes :ctx :monoId nm: nm.stringView buf: vp
    # the instance's text as this program writes it (rtSectionPlan), so the
    # item hash and `==` are spelled only where a written section holds them
    p: tmplKey :ctx name: "Set"
    ti: tmplTextOf :ctx key: p
    if (rtEmpty :ctx id: ti) then return
    plan: rtSectionPlan :ctx mono: monoId id: ti
    needHash: rtPlanSpells :ctx :plan name: "HASH_BODY"
    needEq: rtPlanSpells :ctx :plan name: "EQ_BODY"
    # the key's own `hash` and `==` where it has them, the kind's otherwise
    hashBody: String
    eqBody: String
    (
        setKeyBodies
        :ast
        :reg
        :typing
        :ctx
        :elemTid
        :ekind
        itemT: itemT.stringView
        :needHash
        :needEq
        :hashBody
        :eqBody
        :buf
    )
    et: elemTid
    ifDestroy: mapValFreeStmt :reg :typing :ctx valTid: et slot: "p->entries[i].item"
    destroyItems: setDestroyItems itemFree: ifDestroy.stringView
    ifDup: mapValFreeStmt :reg :typing :ctx valTid: et slot: "_item"
    freeItemDup: setFreeItemDup itemFree: ifDup.stringView
    ifDel: mapValFreeStmt :reg :typing :ctx valTid: et slot: "_this->entries[idx].item"
    freeItemDel: setFreeItemDel itemFree: ifDel.stringView
    {
        kt: RtKeys.create
        rtKey :ctx keys: kt name: "NAME" val: nm.stringView
        rtKey :ctx keys: kt name: "MACRO" val: mcr.stringView
        rtKey :ctx keys: kt name: "ITEM_T" val: itemT.stringView
        setItemArgKeys :ctx keys: kt itemT: itemT.stringView :isStr
        rtKey :ctx keys: kt name: "HASH_BODY" val: hashBody.stringView
        rtKey :ctx keys: kt name: "EQ_BODY" val: eqBody.stringView
        rtKey :ctx keys: kt name: "DESTROY_ITEMS" val: destroyItems.stringView
        rtKey :ctx keys: kt name: "FREE_ITEM_DUP" val: freeItemDup.stringView
        rtKey :ctx keys: kt name: "FREE_ITEM_DEL" val: freeItemDel.stringView
        rtKey :ctx keys: kt name: "OPTIONVIEW" val: ov.stringView
        rtOptionKeys :ast :ctx :reg :typing :plan keys: kt key: "OPTIONVIEW" tid: ovId
        rtKey :ctx keys: kt name: "SETITER" val: si.stringView
        buf.append (rtRender :ctx :plan keys: kt)
        buf.append vp
    }
    # `.copy` is declared on SetVal and not on SetRef, so a SetRef mono has no
    # member here to find and nothing is written
    (
        emitColMethodOnDemand
        :ctx
        :monoId
        member: memberWord.slot.copy
        file: "dict_copy"
        nm: nm.stringView
        hole: ""
        holeVal: ""
        :buf
    )
}

# setKeyBodies -- a Set item's hash and `==` bodies, each only when its
# section is written (`needHash`, `needEq`): a value type's own (valKeyHashBody,
# valKeyEqBody), a reference's declared pair (declaring both ahead of the mono),
# or the kind's.
setKeyBodies: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    elemTid: ztypes.tid
    ekind: u64
    itemT: StringView
    needHash: bool
    needEq: bool
    hashBody: String.borrow
    eqBody: String.borrow
    buf: String.borrow
} is {
    valElem: isValKey :reg key: elemTid kind: ekind
    if valElem then {
        if needHash then hashBody.append (
            valKeyHashBody
            :ast
            :reg
            :typing
            :ctx
            key: elemTid
            keyT: itemT
            :buf
        )
        if needEq then eqBody.append (
            valKeyEqBody
            :ast
            :reg
            :typing
            :ctx
            key: elemTid
            keyT: itemT
            :buf
        )
    }
    {
        dh: String
        de: String
        if ekind == 0 when valElem.not when needHash or needEq then {
            dh = declaredKeyFnC :reg :typing :ctx tid: elemTid memberId: zast.wellKnown.slot.wkHash
            de = declaredKeyFnC :reg :typing :ctx tid: elemTid memberId: zast.wellKnown.slot.wkOpEq
        }
        if dh.length > 0 when de.length > 0 then {
            hb: "\{dh}(&_key)"
            hashBody.append hb
            rhsPs: elemBorrowsByPtr :reg :typing :ctx tid: elemTid
            rhsAs: "_b".string
            rhsTs: itemT.string
            if rhsPs then {
                rhsAs = "&_b".string
                rhsTsp: "\{itemT}*"
                rhsTs = rhsTsp.take
            }
            eb: "\{de}(&_a, \{rhsAs})"
            eqBody.append eb
            fd: (
                keyFnProtosC
                :reg
                :typing
                :ctx
                tid: elemTid
                dh: dh.stringView
                de: de.stringView
                keyT: itemT
                rhsT: rhsTs.stringView
                rhsByPtr: rhsPs
            )
            buf.append fd
        }
    }
    if needHash when hashBody.length == 0 then hashBody.append (setHashBody :ctx kind: ekind)
    if needEq when eqBody.length == 0 then eqBody.append (setEqBody kind: ekind)
}

# setItemArgKeys -- a Set template's ITEM_ARG_T and ITEM_REF: a String item
# is passed by pointer (the probe never copies the header), any other by value.
setItemArgKeys: function {ctx: Ctx keys: RtKeys itemT: StringView isStr: bool} is {
    if isStr.not then {
        rtKey :ctx :keys name: "ITEM_ARG_T" val: itemT
        rtKey :ctx :keys name: "ITEM_REF" val: ""
        return
    }
    argT: "const \{itemT}*"
    rtKey :ctx :keys name: "ITEM_ARG_T" val: argT.stringView
    rtKey :ctx :keys name: "ITEM_REF" val: "&"
}

# mapDestroyEntries / mapFreeKeyDup / mapFreeKeyDel -- the key cleanup
# fragments: per-entry key free on destroy, incoming-key free when a set hits
# an existing key, stored-key free on delete. Each is handed the key's free
# statement for its slot (mapValFreeStmt), empty for a key that owns nothing.
mapDestroyEntries: function {keyFree: StringView valFree: StringView} out String is {
    keyLine: String
    if keyFree.length > 0 then keyLine = "            \{keyFree}\n"
    valLine: String
    if valFree.length > 0 then valLine = "            \{valFree}\n"
    if (keyLine.length + valLine.length) == 0 then return "".string
    return "    for (uint64_t i = 0; i < p->entries_len; i++) {\n        if (p->entries[i].alive) {\n\{keyLine}\{valLine}        }\n    }\n"
}

# the C snippet duplicating a Map key.
mapFreeKeyDup: function {keyFree: StringView} out String is {
    if keyFree.length > 0 then return "        \{keyFree}\n"
    return "".string
}

# the C snippet deleting a Map key (and its value).
mapFreeKeyDel: function {keyFree: StringView valFree: StringView} out String is {
    res: String
    if keyFree.length > 0 then res = "    \{keyFree}\n"
    if valFree.length > 0 then res = "\{res}    \{valFree}\n"
    return res
}

# mapValFreeStmt -- the value-free statement for a Map value slot: String value
# via the String free, reftype / heap-collection value via its destructor, empty
# for scalars. Mirrors emitStructDestructor's per-field cleanup.
mapValFreeStmt: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    valTid: ztypes.tid
    slot: StringView
} out String is {
    if valTid.isZero then return "".string
    vfs: destroyFnC :reg :typing :ctx tid: valTid
    if vfs.length == 0 then return vfs
    vfs.append "("
    vfs.append (
        destroyOperand
        :reg
        :typing
        :ctx
        tid: (destroyTargetTid :reg :typing :ctx tid: valTid)
        nm: slot
    )
    vfs.append ");"
    return vfs
}

# emitMapIters -- the MapKeyIter/MapItemIter/MapEntry block for a Map mono,
# emitted only when those iterator monos were minted. Their OptionView returns
# (OptionView_<K>, OptionView_MapEntry_<K>_<V>) are defined by the earlier
# OptionView leg.
emitMapIters: function {
    # the arm names
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    nm: StringView
    keyT: StringView
    valT: StringView
    buf: String.borrow
} is {
    # each walk is a section, written where written C calls it (memberUsed);
    # the reached set holds the cursors of the walks called (typeReachEdges)
    walksKeys: memberUsed :ctx mono: monoId member: memberWord.slot.iterateAll
    walksItems: memberUsed :ctx mono: monoId member: memberWord.slot.iterateItems
    if walksKeys.not when walksItems.not then return
    miiId: monoMethodReturn :reg :typing :monoId nameId: zast.wellKnown.slot.wkIterateItems
    if miiId.isZero then return
    mkiId: monoMethodReturn :reg :typing :monoId nameId: zast.wellKnown.slot.wkIterate
    if mkiId.isZero then return
    ovkId: monoMethodReturn :reg :typing monoId: mkiId nameId: zast.wellKnown.slot.wkCall
    if ovkId.isZero then return
    oveId: monoMethodReturn :reg :typing monoId: miiId nameId: zast.wellKnown.slot.wkCall
    if oveId.isZero then return
    meId: ztypes.tid
    meo: typing.declChildOfId parentTypeId: oveId nameId: zast.wellKnown.slot.wkSome
    if meo.some then {
        meId = meo
    }
    if meId.isZero then return
    mki: cbaseNoPrefix :ctx tid: mkiId
    mii: cbaseNoPrefix :ctx tid: miiId
    me: cbaseNoPrefix :ctx tid: meId
    ovk: cbaseNoPrefix :ctx tid: ovkId
    ove: cbaseNoPrefix :ctx tid: oveId
    pi: tmplKey :ctx name: "MapIter"
    ti: tmplTextOf :ctx key: pi
    if (rtEmpty :ctx id: ti).not then {
        plan: rtSectionPlan :ctx mono: monoId id: ti
        rtKeepReached :ctx :plan key: "MAPENTRY" reached: (typeReached :ctx tid: meId)
        kt: RtKeys.create
        rtKey :ctx keys: kt name: "NAME" val: nm
        rtKey :ctx keys: kt name: "KEY_T" val: keyT
        rtKey :ctx keys: kt name: "VAL_T" val: valT
        rtKey :ctx keys: kt name: "MAPKEYITER" val: mki.stringView
        rtKey :ctx keys: kt name: "OPTIONVIEW_K" val: ovk.stringView
        rtOptionKeys :ast :ctx :reg :typing :plan keys: kt key: "OPTIONVIEW_K" tid: ovkId
        rtKey :ctx keys: kt name: "MAPENTRY" val: me.stringView
        rtKey :ctx keys: kt name: "MAPITEMITER" val: mii.stringView
        rtKey :ctx keys: kt name: "OPTIONVIEW_ENTRY" val: ove.stringView
        rtOptionKeys :ast :ctx :reg :typing :plan keys: kt key: "OPTIONVIEW_ENTRY" tid: oveId
        filled: rtRender :ctx :plan keys: kt
        buf.append filled
        buf.append "\n"
    }
}

# mapKeyType -- a Map mono's KEY type, read off its `set` member's `key`
# parameter rather than off the mono's name: the name is composed text, the
# parameter is the declaration.
mapKeyType: function {typing: ztyping.ZTyping.view monoId: ztypes.tid} out ztypes.tid is {
    return (
        memberOfMemberType
        :typing
        :monoId
        outer: zast.wellKnown.slot.wkSet
        inner: zast.wellKnown.slot.wkKey
    )
}

# the element type id of Set instantiation `monoId`.
setElemType: function {typing: ztyping.ZTyping.view monoId: ztypes.tid} out ztypes.tid is {
    return (
        memberOfMemberType
        :typing
        :monoId
        outer: zast.wellKnown.slot.wkAdd
        inner: zast.wellKnown.slot.wkItem
    )
}

# memberOfMemberType -- the type of `inner` on the type of `outer` on `monoId`:
# how a container instance names its key or element, through the method that
# takes one. 0 when either step has no such member.
memberOfMemberType: function {
    typing: ztyping.ZTyping.view
    monoId: ztypes.tid
    outer: zast.nameid
    inner: zast.nameid
} out ztypes.tid is {
    oo: typing.declChildOfId parentTypeId: monoId nameId: outer
    if oo.some.not then return ztypes.tid.zero
    io: typing.declChildOfId parentTypeId: oo nameId: inner
    return (io.or d: ztypes.tid.zero)
}

# the value type id of Map instantiation `monoId`.
mapValType: function {typing: ztyping.ZTyping.view monoId: ztypes.tid} out ztypes.tid is {
    so: typing.declChildOfId parentTypeId: monoId nameId: zast.wellKnown.slot.wkSet
    if so.some then {
        vo: typing.declChildOfId parentTypeId: so nameId: zast.wellKnown.slot.wkValue
        if vo.some then {
            return vo
        }
    }
    return ztypes.tid.zero
}

# optionDeclC / optionNoneC / optionSomeC -- C that builds `_r`, an owned
# option of `opt` (either family), one way for every native that answers
# one: the declaration, the statements that make it none, and those that make
# it some over `value` (C type `valT`) -- an optionval holds the payload in its
# arm, an Option in a heap cell.
optionDeclC: function {reg: ztypes.ZTypeRegistry.view ctx: Ctx.view opt: ztypes.tid} out String is {
    if (optionIsValFamily :reg :ctx :opt) then return "z_\{cbaseNoPrefix :ctx tid: opt}_t _r;"
    return "z_\{cbaseNoPrefix :ctx tid: opt}_t _r = {0};"
}

# optionNoneC -- the statements making `_r` none, each indented by `ind`
optionNoneC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    opt: ztypes.tid
    ind: StringView
} out String is {
    nt: spelledTagConst :ast :ctx :reg :typing tid: opt armId: zast.wellKnown.slot.wkNone
    if (optionIsValFamily :reg :ctx :opt) then return "\{ind}_r.tag = \{nt};\n"
    return "\{ind}_r.tag = \{nt};\n\{ind}_r.data = NULL;\n"
}

# optionSomeC -- the statements making `_r` some over `value`, each indented
# by `ind`
optionSomeC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    opt: ztypes.tid
    valT: StringView
    value: StringView
    ind: StringView
} out String is {
    st: spelledTagConst :ast :ctx :reg :typing tid: opt armId: zast.wellKnown.slot.wkSome
    if (optionIsValFamily :reg :ctx :opt) then {
        rsC: (
            memberC
            :ast
            :reg
            :typing
            :ctx
            owner: opt
            kind: memberkind.arm
            nameId: zast.wellKnown.slot.wkSome
        )
        return "\{ind}_r.tag = \{st};\n\{ind}_r.data.\{rsC} = \{value};\n"
    }
    ral: armCellAlloc :ctx pc: valT box: "_box"
    rfl: armCellFill box: "_box" :value
    rat: armCellAttach slot: "_r.data" box: "_box"
    return "\{ind}_r.tag = \{st};\n\{ind}\{ral}\n\{ind}\{rfl}\n\{ind}\{rat}\n"
}

# optionIsValFamily -- `opt` is an optionval, its payload held in its arm
optionIsValFamily: function {
    reg: ztypes.ZTypeRegistry.view ctx: Ctx.view opt: ztypes.tid
} out bool is {
    return (originIsTid :reg tid: opt originTid: (ctx.origins.get i: family.slot.optionval))
}

# emitMapMono -- substitute template Map for a Map instance (compact-dict +
# set/get/has/delete). The value's optionval mono (get's return) supplies the
# value type and the OPTIONVAL placeholders; the key name is the remainder.
# mapValType -- the canonical Map value type id, off the "set" method's "value"
# param (mirrors listElemType). 0 when absent.
emitMapMono: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    mcr: cUpperOf text: nm.stringView
    ovId: ztypes.tid
    go: typing.declChildOfId parentTypeId: monoId nameId: zast.wellKnown.slot.wkGet
    if go.some then {
        ovId = reg.returnTypeOf tid: go
    }
    if ovId.isZero then return
    valTid: mapValType :typing :monoId
    valT: cTypeForNameTid :ast :reg :typing :ctx tid: valTid
    ov: cbaseNoPrefix :ctx tid: ovId
    ovSome: spelledTagConst :ast :ctx :reg :typing tid: ovId armId: zast.wellKnown.slot.wkSome
    ovNone: spelledTagConst :ast :ctx :reg :typing tid: ovId armId: zast.wellKnown.slot.wkNone
    keyTid: mapKeyType :typing :monoId
    keyT: cTypeForNameTid :ast :reg :typing :ctx tid: keyTid
    kkind: keyHashKind :reg :typing :ctx tid: keyTid
    keyIsStr: kkind == 1
    keyArgT: keyT.copy
    keyRef: String
    if keyIsStr then {
        keyArgT = "const \{keyT}*"
        keyRef = "&".string
    }
    # getMut and the view-keyed probes, written after the instance, call its
    # members: they are decided before the instance's text is
    gm: String
    (
        emitMapGetMut
        :ast
        :reg
        :typing
        :ctx
        :monoId
        file: "MapMut"
        nm: nm.stringView
        keyHole: "KEY_ARG_T"
        keyT: keyArgT.stringView
        buf: gm
    )
    vp: String
    if kkind == 1 then mapViewProbes :ctx :monoId nm: nm.stringView ov: ov.stringView buf: vp
    # the instance's text as this program writes it (rtSectionPlan), so the
    # key hash and `==` are spelled only where a written section holds them
    p: tmplKey :ctx name: "Map"
    ti: tmplTextOf :ctx key: p
    if (rtEmpty :ctx id: ti) then return
    plan: rtSectionPlan :ctx mono: monoId id: ti
    needHash: rtPlanSpells :ctx :plan name: "HASH_KEY_BODY"
    needEq: rtPlanSpells :ctx :plan name: "KEYS_EQUAL_BODY"
    # the key's own `hash` and `==` where it has them, the kind's otherwise
    hashKeyBody: String
    keysEqBody: String
    kk: keyTid
    valKey: isValKey :reg key: kk kind: kkind
    if valKey then {
        if needHash then hashKeyBody = (
            valKeyHashBody
            :ast
            :reg
            :typing
            :ctx
            key: kk
            keyT: keyT.stringView
            :buf
        )
        if needEq then keysEqBody = (
            valKeyEqBody
            :ast
            :reg
            :typing
            :ctx
            key: kk
            keyT: keyT.stringView
            :buf
        )
    }
    {
        # Only the FALLTHROUGH kind. String (1), StringView (2) and the
        # by-value structs (3) already have their own bodies, and String's
        # `hash`/`==` are NATIVES whose C is fixed by their .inc -- calling
        # them by emitted name links to nothing.
        dhm: String
        dem: String
        if kkind == 0 when valKey.not when needHash or needEq then {
            dhm = declaredKeyFnC :reg :typing :ctx tid: keyTid memberId: zast.wellKnown.slot.wkHash
            dem = declaredKeyFnC :reg :typing :ctx tid: keyTid memberId: zast.wellKnown.slot.wkOpEq
        }
        if dhm.length > 0 when dem.length > 0 then {
            hbm: "\{dhm}(&_key)"
            hashKeyBody = hbm.take
            # the receiver is a pointer either way; the `rhs` PARAMETER follows
            # the key's own calling convention, which is a pointer for a class
            # and a value for a record
            rhsP: elemBorrowsByPtr :reg :typing :ctx tid: keyTid
            rhsA: "_b".string
            rhsT: keyT.copy
            if rhsP then {
                rhsA = "&_b".string
                rhsTp: "\{keyT}*"
                rhsT = rhsTp.take
            }
            ebm: "\{dem}(&_a, \{rhsA})"
            keysEqBody = ebm.take
            fdm: (
                keyFnProtosC
                :reg
                :typing
                :ctx
                tid: keyTid
                dh: dhm.stringView
                de: dem.stringView
                keyT: keyT.stringView
                rhsT: rhsT.stringView
                rhsByPtr: rhsP
            )
            buf.append fdm
        }
    }
    if needHash when hashKeyBody.length == 0 then hashKeyBody = setHashBody :ctx kind: kkind
    if needEq when keysEqBody.length == 0 then keysEqBody = setEqBody kind: kkind
    vfDestroy: (
        mapValFreeStmt
        :reg
        :typing
        :ctx
        :valTid
        slot: "p->entries[i].value"
    )
    vfDup: (
        mapValFreeStmt
        :reg
        :typing
        :ctx
        :valTid
        slot: "_this->entries[existing].value"
    )
    freeValDup: String
    if vfDup.length > 0 then freeValDup = "        \{vfDup}\n"
    kfDestroy: mapValFreeStmt :reg :typing :ctx valTid: kk slot: "p->entries[i].key"
    destroyEntries: mapDestroyEntries keyFree: kfDestroy.stringView valFree: vfDestroy.stringView
    kfDup: mapValFreeStmt :reg :typing :ctx valTid: kk slot: "_key"
    freeKeyDup: mapFreeKeyDup keyFree: kfDup.stringView
    getBody: String
    if (originIsTid :reg tid: ovId originTid: (ctx.origins.get i: family.slot.optionval)) then {
        gsC: (
            memberC
            :ast
            :reg
            :typing
            :ctx
            owner: ovId
            kind: memberkind.arm
            nameId: zast.wellKnown.slot.wkSome
        )
        gbV: "    z_\{ov}_t _r;\n    if (idx >= 0) {\n        _r.tag = \{ovSome};\n        _r.data.\{gsC} = _this->entries[idx].value;\n    } else {\n        _r.tag = \{ovNone};\n    }\n    return _r;"
        getBody = gbV.take
    } else {
        # every OptionView-producing value kind (class, String, union,
        # protocol, ...) borrows a pointer into the entry storage: the
        # view's SHARED lock pins the map, and OptionView destroy is a
        # no-op, so a malloc'd box here would leak (the audited get
        # contract is "no deep-copy on get")
        gbR: "    z_\{ov}_t _r = {0};\n    if (idx >= 0) {\n        _r.tag = \{ovSome};\n        _r.data = &_this->entries[idx].value;\n    } else {\n        _r.tag = \{ovNone};\n        _r.data = NULL;\n    }\n    return _r;"
        getBody = gbR.take
    }
    rmWrapId: ztypes.tid
    roMm: typing.declChildOfId parentTypeId: monoId nameId: zast.wellKnown.slot.wkRemove
    if roMm.some then {
        rmWrapId = reg.returnTypeOf tid: roMm
    }
    rmWrap: cbaseNoPrefix :ctx tid: rmWrapId
    kfDel: mapValFreeStmt :reg :typing :ctx valTid: kk slot: "_this->entries[idx].key"
    keyOnlyFree: mapFreeKeyDel keyFree: kfDel.stringView valFree: ""
    delTail: "\{keyOnlyFree}    _this->entries[idx].alive = 0;\n    _this->indices[slot] = Z_\{mcr}_INDEX_DELETED;\n    _this->length--;\n"
    rmDecl: optionDeclC :reg :ctx opt: rmWrapId
    rmNoneC: optionNoneC :ast :reg :typing :ctx opt: rmWrapId ind: "        "
    rmSomeC: (
        optionSomeC
        :ast
        :reg
        :typing
        :ctx
        opt: rmWrapId
        valT: valT.stringView
        value: "_this->entries[idx].value"
        ind: "    "
    )
    removeBody: "    \{rmDecl}\n    if (idx < 0) {\n\{rmNoneC}        return _r;\n    }\n\{rmSomeC}\{delTail}    return _r;"
    {
        kt: RtKeys.create
        rtKey :ctx keys: kt name: "NAME" val: nm.stringView
        rtKey :ctx keys: kt name: "MACRO" val: mcr.stringView
        rtKey :ctx keys: kt name: "KEY_T" val: keyT.stringView
        rtKey :ctx keys: kt name: "KEY_ARG_T" val: keyArgT.stringView
        rtKey :ctx keys: kt name: "KEY_REF" val: keyRef.stringView
        rtKey :ctx keys: kt name: "VAL_T" val: valT.stringView
        rtKey :ctx keys: kt name: "HASH_KEY_BODY" val: hashKeyBody.stringView
        rtKey :ctx keys: kt name: "KEYS_EQUAL_BODY" val: keysEqBody.stringView
        rtKey :ctx keys: kt name: "DESTROY_ENTRIES" val: destroyEntries.stringView
        rtKey :ctx keys: kt name: "FREE_KEY_DUP" val: freeKeyDup.stringView
        rtKey :ctx keys: kt name: "OPTIONVAL" val: ov.stringView
        rtKey :ctx keys: kt name: "GET_BODY" val: getBody.stringView
        rtKey :ctx keys: kt name: "FREE_VAL_DUP" val: freeValDup.stringView
        rtKey :ctx keys: kt name: "REMOVE_WRAP" val: rmWrap.stringView
        rtKey :ctx keys: kt name: "REMOVE_BODY" val: removeBody.stringView
        buf.append (rtRender :ctx :plan keys: kt)
        buf.append vp
        buf.append gm
    }
    (
        emitMapIters
        :ast
        :reg
        :typing
        :ctx
        :monoId
        nm: nm.stringView
        keyT: keyT.stringView
        valT: valT.stringView
        :buf
    )
    # `.copy` is declared on MapVV alone, so the other three Map families have
    # no member here to find and nothing is written
    (
        emitColMethodOnDemand
        :ctx
        :monoId
        member: memberWord.slot.copy
        file: "dict_copy"
        nm: nm.stringView
        hole: ""
        holeVal: ""
        :buf
    )
}

# idMapDestroyEntries -- the per-entry free loop for an IdMap. There is no
# `alive` test and no key line: entries are dense (nothing is ever removed) and
# an id key is a scalar that owns nothing.
idMapDestroyEntries: function {valFree: StringView} out String is {
    if valFree.length == 0 then return "".string
    return "    for (uint32_t i = 0; i < p->length; i++) {\n        \{valFree}\n    }\n"
}

# emitIdMapMono -- substitute template IdMap for an IdMap instance. Far fewer
# holes than emitMapMono: the bound guarantees a scalar key, so there is no
# hash body to choose, no key-equality body (C `==` is it), and no key to free.
emitIdMapMono: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    mcr: cUpperOf text: nm.stringView
    ovId: ztypes.tid
    go: typing.declChildOfId parentTypeId: monoId nameId: zast.wellKnown.slot.wkGet
    if go.some then {
        ovId = reg.returnTypeOf tid: go
    }
    if ovId.isZero then return
    ov: cbaseNoPrefix :ctx tid: ovId
    ovSome: spelledTagConst :ast :ctx :reg :typing tid: ovId armId: zast.wellKnown.slot.wkSome
    ovNone: spelledTagConst :ast :ctx :reg :typing tid: ovId armId: zast.wellKnown.slot.wkNone
    valTid: mapValType :typing :monoId
    valT: cTypeForNameTid :ast :reg :typing :ctx tid: valTid
    keyTid: mapKeyType :typing :monoId
    keyT: cTypeForNameTid :ast :reg :typing :ctx tid: keyTid
    vfDestroy: mapValFreeStmt :reg :typing :ctx :valTid slot: "p->entries[i].value"
    vfDup: (
        mapValFreeStmt
        :reg
        :typing
        :ctx
        :valTid
        slot: "_this->entries[existing].value"
    )
    freeValDup: String
    if vfDup.length > 0 then freeValDup = "        \{vfDup}\n"
    destroyEntries: idMapDestroyEntries valFree: vfDestroy.stringView
    getBody: String
    if (originIsTid :reg tid: ovId originTid: (ctx.origins.get i: family.slot.optionval)) then {
        gsC: (
            memberC
            :ast
            :reg
            :typing
            :ctx
            owner: ovId
            kind: memberkind.arm
            nameId: zast.wellKnown.slot.wkSome
        )
        getBody = "    z_\{ov}_t _r;\n    if (idx >= 0) {\n        _r.tag = \{ovSome};\n        _r.data.\{gsC} = _this->entries[idx].value;\n    } else {\n        _r.tag = \{ovNone};\n    }\n    return _r;"
    } else {
        # same borrowed-pointer contract as Map.get: the OptionView pins the
        # container with a SHARED lock and its destroy is a no-op, so nothing
        # is copied out of the entry storage
        getBody = "    z_\{ov}_t _r = {0};\n    if (idx >= 0) {\n        _r.tag = \{ovSome};\n        _r.data = (void*)&_this->entries[idx].value;\n    } else {\n        _r.tag = \{ovNone};\n        _r.data = NULL;\n    }\n    return _r;"
    }
    p: tmplKey :ctx name: "IdMap"
    ti: tmplTextOf :ctx key: p
    if (rtEmpty :ctx id: ti) then return
    kt: RtKeys.create
    rtKey :ctx keys: kt name: "NAME" val: nm.stringView
    rtKey :ctx keys: kt name: "MACRO" val: mcr.stringView
    rtKey :ctx keys: kt name: "KEY_T" val: keyT.stringView
    rtKey :ctx keys: kt name: "VAL_T" val: valT.stringView
    rtKey :ctx keys: kt name: "DESTROY_ENTRIES" val: destroyEntries.stringView
    rtKey :ctx keys: kt name: "FREE_VAL_DUP" val: freeValDup.stringView
    rtKey :ctx keys: kt name: "OPTIONVAL" val: ov.stringView
    rtKey :ctx keys: kt name: "GET_BODY" val: getBody.stringView

    # getMut and copy, written after the instance, call its members: they are
    # decided first
    gm: String
    (
        emitMapGetMut
        :ast
        :reg
        :typing
        :ctx
        :monoId
        file: "IdMapMut"
        nm: nm.stringView
        keyHole: "KEY_T"
        keyT: keyT.stringView
        buf: gm
    )
    if (memberUsed :ctx mono: monoId member: memberWord.slot.copy) then (
        noteMemberUse
        :ctx
        mono: monoId
        member: memberWord.slot.entriesCap
    )
    plan: rtSectionPlan :ctx mono: monoId id: ti
    buf.append (rtRender :ctx :plan keys: kt)
    buf.append gm
    (
        emitIdMapIters
        :ast
        :reg
        :typing
        :ctx
        :monoId
        nm: nm.stringView
        keyT: keyT.stringView
        valT: valT.stringView
        :buf
    )
    # `.copy` is declared on IdMapV and not on IdMapR
    (
        emitColMethodOnDemand
        :ctx
        :monoId
        member: memberWord.slot.copy
        file: "IdMap_copy"
        nm: nm.stringView
        hole: ""
        holeVal: ""
        :buf
    )
}

# emitMapGetMut -- a map's in-place value reference, from its own template
# (`file`, z_MapMut or z_IdMapMut): emitted only when `getMut` resolved and
# what it returns is reached. Its
# declared return -- an OptionMut over the VALUE in both value families, where
# `get`'s differs between them -- names the C type; `keyHole` is the template's
# key placeholder, filled with `keyT`.
emitMapGetMut: function {
    # the arm names
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    file: StringView
    nm: StringView
    keyHole: StringView
    keyT: StringView
    buf: String.borrow
} is {
    # written where written C calls this instance's getMut: its answer type is
    # shared by every map of the same value type
    if (memberUsed :ctx mono: monoId member: memberWord.slot.getMut).not then return
    gmId: monoMethodReturn :reg :typing :monoId nameId: zast.wellKnown.slot.wkGetMut
    if (typeReached :ctx tid: gmId).not then return
    gmv: cbaseNoPrefix :ctx tid: gmId
    pm: tmplKey :ctx name: file
    # getMut probes through the instance's find (and a Map's hash_key)
    noteMemberUse :ctx mono: monoId member: memberWord.slot.find
    noteMemberUse :ctx mono: monoId member: memberWord.slot.hashKey
    ti: tmplTextOf :ctx key: pm
    if (rtEmpty :ctx id: ti) then return
    plan: rtSectionPlan :ctx mono: monoId id: ti
    kt: RtKeys.create
    rtKey :ctx keys: kt name: "NAME" val: nm
    rtKey :ctx keys: kt name: keyHole val: keyT
    rtKey :ctx keys: kt name: "OPTIONMUT_V" val: gmv.stringView
    rtOptionKeys :ast :ctx :reg :typing :plan keys: kt key: "OPTIONMUT_V" tid: gmId
    buf.append (rtRender :ctx :plan keys: kt)
    buf.append "\n"
}

# emitIdMapIters -- the entry projection and the item iterator, from their own
# template. Separate from template IdMap for the reason emitMapIters is separate
# from template Map: a mono whose `iterateItems` never resolved must still emit
# its container, so the part that needs the iterator types is the part that can
# be skipped.
emitIdMapIters: function {
    # the arm names
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    nm: StringView
    keyT: StringView
    valT: StringView
    buf: String.borrow
} is {
    miiId: monoMethodReturn :reg :typing :monoId nameId: zast.wellKnown.slot.wkIterateItems
    if (typeReached :ctx tid: miiId).not then return
    oveId: monoMethodReturn :reg :typing monoId: miiId nameId: zast.wellKnown.slot.wkCall
    if oveId.isZero then return
    meId: ztypes.tid
    {
        meo: typing.declChildOfId parentTypeId: oveId nameId: zast.wellKnown.slot.wkSome
        if meo.some then {
            meId = meo
        }
    }
    if meId.isZero then return
    mii: cbaseNoPrefix :ctx tid: miiId
    me: cbaseNoPrefix :ctx tid: meId
    ove: cbaseNoPrefix :ctx tid: oveId
    pi: tmplKey :ctx name: "IdMapIter"
    ti: tmplTextOf :ctx key: pi
    if (rtEmpty :ctx id: ti) then return
    plan: rtSectionPlan :ctx mono: monoId id: ti
    rtKeepReached :ctx :plan key: "IDMAPENTRY" reached: (typeReached :ctx tid: meId)
    kt: RtKeys.create
    rtKey :ctx keys: kt name: "NAME" val: nm
    rtKey :ctx keys: kt name: "KEY_T" val: keyT
    rtKey :ctx keys: kt name: "VAL_T" val: valT
    rtKey :ctx keys: kt name: "IDMAPITEMITER" val: mii.stringView
    rtKey :ctx keys: kt name: "IDMAPENTRY" val: me.stringView
    rtKey :ctx keys: kt name: "OPTIONVIEW_ENTRY" val: ove.stringView
    rtOptionKeys :ast :ctx :reg :typing :plan keys: kt key: "OPTIONVIEW_ENTRY" tid: oveId
    filled: rtRender :ctx :plan keys: kt
    buf.append filled
    buf.append "\n"
}

# emitIdSetMono -- substitute template IdSet for an IdSet instance. Three
# holes: an id item is a scalar, so it has no hash body, no equality body and
# no destructor.
emitIdSetMono: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    mcr: cUpperOf text: nm.stringView
    elemTid: setElemType :typing :monoId
    itemT: cTypeForNameTid :ast :reg :typing :ctx tid: elemTid
    siId: monoMethodReturn :reg :typing :monoId nameId: zast.wellKnown.slot.wkIterate
    if siId.isZero then return
    ovId: monoMethodReturn :reg :typing monoId: siId nameId: zast.wellKnown.slot.wkCall
    if ovId.isZero then return
    ov: cbaseNoPrefix :ctx tid: ovId
    si: cbaseNoPrefix :ctx tid: siId
    p: tmplKey :ctx name: "IdSet"
    ti: tmplTextOf :ctx key: p
    if (rtEmpty :ctx id: ti) then return
    kt: RtKeys.create
    rtKey :ctx keys: kt name: "NAME" val: nm.stringView
    rtKey :ctx keys: kt name: "MACRO" val: mcr.stringView
    rtKey :ctx keys: kt name: "ITEM_T" val: itemT.stringView
    rtKey :ctx keys: kt name: "IDSETITER" val: si.stringView
    rtKey :ctx keys: kt name: "OPTIONVIEW" val: ov.stringView

    # copy, written after the instance, calls its items_cap
    if (memberUsed :ctx mono: monoId member: memberWord.slot.copy) then (
        noteMemberUse
        :ctx
        mono: monoId
        member: memberWord.slot.itemsCap
    )
    plan: rtSectionPlan :ctx mono: monoId id: ti
    rtOptionKeys :ast :ctx :reg :typing :plan keys: kt key: "OPTIONVIEW" tid: ovId
    buf.append (rtRender :ctx :plan keys: kt)
    # IdSet is one form only, so this writes for every instance that calls it
    (
        emitColMethodOnDemand
        :ctx
        :monoId
        member: memberWord.slot.copy
        file: "IdSet_copy"
        nm: nm.stringView
        hole: "ITEM_T"
        holeVal: itemT.stringView
        :buf
    )
}

# stemInstanceTid -- the type id behind a fragment's canonical stem, for the
# GENERIC INSTANCES only: the stem's canon names the template and its
# type arguments, resolved through the spec trie from SOURCE-named parts (Result
# over filestat and IoError), never from the mangled spelling. 0 for a plain
# source-name stem (File, IoError, Reader), which keeps the by-name path, and 0
# when the instance was never demanded.
stemInstanceTid: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    canon: StringView
} out ztypes.tid is {
    spec: String
    {
        g: ctx.canonSpecs.get key: canon.asString
        if g.some then {
            spec = g.copy
        }
    }
    if spec.length == 0 then return ztypes.tid.zero
    parts: ListVal ztypes.tid
    for each pt: (spec.stringView.split sep: ",") loop {
        parts.append (canonPartTid :ast :reg :typing :ctx part: pt)
    }
    if parts.length < 2 then return ztypes.tid.zero
    a2: ztypes.tid.zero
    if parts.length > 2 then a2 = parts.get i: 2
    return (specTidArgs :reg :typing templateTid: (parts.get i: 0) a1: (parts.get i: 1) :a2)
}

# canonPartTid -- one part of a canonical-stem row: `@stem` is another row's
# instance, `unit.name` a type that unit declares (the unqualified lookup does
# not reach the cli or io units), and anything else a builtin type name.
canonPartTid: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    part: StringView
} out ztypes.tid is {
    if (part.startsWith prefix: "@") then {
        return (
            stemInstanceTid
            :ast
            :reg
            :typing
            :ctx
            canon: (part.substring from: 1 to: part.length)
        )
    }
    dot: part.indexOf needle: "."
    if dot.some then {
        return (
            builtinTidInU
            :ast
            :typing
            unitName: (part.substring from: 0 to: dot)
            base: (part.substring from: dot + 1 to: part.length)
        )
    }
    return (builtinTid :ast :typing nameId: (zast.poolFind pool: ast.names text: part))
}

# stemCname -- the id-based cname for a canonical stem (the part after `z_` in a
# fragment): a mono (Result_*/List_u8/...) via its spec trie, else a named type
# (IoError/File/filestat/Reader/...) by registry name, and "" when the type is
# not in the (demand-driven) registry for this program. The stem->cname map is
# emit-stable and fragments name the same stems again and again, so each
# result (the "" miss included) is cached per program: the O(type count)
# registry scan runs once per stem.
stemCname: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    canon: StringView
} out String is {
    found: false
    cached: String
    {
        h: ctx.stemCnames.get key: canon.asString
        if h.some then {
            found = true
            cached = h.copy
        }
    }
    if found then return cached
    # a hole names the type it is filled with, as a spelling does
    t: stemTid :ast :reg :typing :ctx :canon
    if t.notZero when ctx.reachFixed.not then ctx.typeUses.add item: t
    r: String
    if t.notZero then r = ctxCname :ctx tid: t
    ctx.stemCnames.set key: canon.string value: r.copy
    return r
}

# stemTid -- the type behind a canonical stem, whatever kind it turns out to be
stemTid: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    canon: StringView
} out ztypes.tid is {
    st: stemInstanceTid :ast :reg :typing :ctx :canon
    if st.notZero then return st
    # a plain source-name stem (File, IoError, Reader): the system unit first,
    # then each unit the table's rows belong to, in table order, by id. A
    # generic instance's stem is a canon, resolved above, and
    # native-guard holds every other stem to one declaring unit, so the order
    # never decides between two.
    canonId: zast.poolFind pool: ast.names text: canon
    mo: (
        ztypecheck.resolveUnitChildRo
        :ast
        :typing
        unitDecl: typing.systemUnitRoot
        nameId: canonId
    )
    if mo.some then {
        return mo
    }
    for each ud: ctx.fragUnitDecls loop {
        found: fragUnitChild :ast :typing unitDecl: ud nameId: canonId
        if found.notZero then return found
    }
    return ztypes.tid.zero
}

# fragUnitChild -- the type `nameId` a runtime-fragment unit declares, 0 when the
# unit is absent or declares none.
fragUnitChild: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out ztypes.tid is {
    if unitDecl.isZero then return ztypes.tid.zero
    uo: ztypecheck.resolveUnitChildRo :ast :typing :unitDecl :nameId
    return (uo.or d: ztypes.tid.zero)
}

# loadFragment -- the fragment `key` with its holes filled (rtFragmentText).
loadFragment: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    key: textkey
} out String is {
    txt: textOf :ctx :key
    if txt.length == 0 then return "".string
    id: ctx.rt.parse text: txt.stringView
    plan: RtPlan :id kept: ListVal bool conds: List Cond
    return (rtFragmentText :ast :reg :typing :ctx :plan all: true :key)
}

# isHeapPtrCollection -- a Map/Set mono is stored as a heap pointer (List is
# embedded by value); a struct field of one is a pointer, freed without `&`.
isHeapPtrCollection: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    cm: chaseAggregateTypedef :reg :typing :ctx :tid
    return (isMapOriginOf :reg :ctx tid: cm) or (isSetOriginOf :reg :ctx tid: cm)
}

# rowTypeTid -- the type a row names by its unit and its name,
# asked of that unit by id; 0 when the program has no such type, or when the
# type declares nothing native: a user type that shadows a stdlib one by name
# is not the type the row implements
rowTypeTid: function {
    ast: Ast.view typing: ztyping.ZTyping.view uname: StringView tname: StringView
} out ztypes.tid is {
    uid: unitDeclByName :typing :ast name: uname
    if uid.isZero then return ztypes.tid.zero
    nid: poolIdOf :ast text: tname
    did: typing.declFindChild parentDeclId: uid nameId: nid
    if (declaresNative :ast :typing :did).not then return ztypes.tid.zero
    found: ztypecheck.resolveUnitChildRo :ast :typing unitDecl: uid nameId: nid
    return (found.or d: ztypes.tid.zero)
}

# declaresNative -- declaration `did` is an `is native` function, or a unit or
# type with one among its members, however deep: what a row naming
# it by spelling is written for
declaresNative: function {
    ast: Ast.view typing: ztyping.ZTyping.view did: ztypes.declid
} out bool is {
    if did.isZero then return false
    d: typing.decls.get i: did
    if d.kind.funcDecl or d.kind.methodDecl then {
        nn: ast.nodes.get i: d.node
        if nn.namedoperation then {
            op: ast.nodes.get i: nn.operation
            if op.functiondef when op.isNative then return true
        }
        return false
    }
    if (d.kind.unitDecl or d.kind.typeDecl).not then return false
    k: u64
    for k < d.children.length loop {
        child: typing.declChildAt declId: did index: k
        if (declaresNative :ast :typing did: child) then return true
        k = k + 1
    }
    return false
}

# bindFragTypeTids -- resolve each fragment row's `uses_<Type>` /
# `destroys_<Type>` demand to a type id. Runs after buildDefUnitIndex so the
# defining unit is an id question too; a name that resolves to nothing leaves
# 0, and the row keeps its member demands. The registry scan is the house
# pattern and runs once over the handful of rows the table demand-types.
bindFragTypeTids: function {typing: ztyping.ZTyping.view ctx: Ctx ast: Ast.view} is {
    for each row: ctx.rows.fragRows loop {
        r: ctx.rows.rows.get i: row
        if r.typeName.notZero then {
            r.typeTid = (
                rowTypeTid
                :ast
                :typing
                uname: (ctx.demands.nameText id: r.owner)
                tname: (ctx.demands.nameText id: r.typeName)
            )
            ctx.rows.rows.set i: row val: r
            # a destructor's row gates no type: the type is written when reached
            if r.typeTid.notZero when r.destroys.not then ctx.demandGatedTids.add item: r.typeTid
        }
    }
}

# bindFragUnitDecls -- the units the table's fragment rows belong to, each
# once, in the order the table first names them (ctx.fragUnitDecls). A row's
# unit that names no unit in scope (`sviter`, a unit the program does not
# reach) lists nothing.
bindFragUnitDecls: function {typing: ztyping.ZTyping.view ctx: Ctx ast: Ast.view} is {
    sysU: typing.systemUnitRoot
    for each row: ctx.rows.fragRows loop {
        uid: (
            unitDeclByName
            :typing
            :ast
            name: (ctx.demands.nameText id: (ctx.rows.rows.get i: row).owner)
        )
        seen: uid.isZero or (uid == sysU)
        for each d: ctx.fragUnitDecls loop {
            if d == uid then seen = true
        }
        if seen.not then ctx.fragUnitDecls.append uid
    }
}

# Cond -- the configurations C holds in: every one (`always`), or the OR of
# `terms`, each the AND of the foundation's conditions
# whose bits it sets. A demand, a fired row and a template member each hold
# one: a need `X?NAME` holds where its row does AND NAME does, and C reached
# in fewer than every configuration is written inside `#if` (wrapCond), so no
# configuration compiles C it never calls.
Cond: class {
    always: bool
    terms: ListVal u64
}

# condAlways -- the condition that holds in every configuration
condAlways: function out Cond is {
    return (Cond always: true terms: ListVal u64)
}

# condWith -- `c` AND the condition whose bit is `bit`
condWith: function {c: Cond.view bit: u64} out Cond is {
    r: Cond always: false terms: ListVal u64
    if c.always then {
        r.terms.append bit
        return r
    }
    for each t: c.terms loop condAddTerm terms: r.terms term: t | bit
    return r
}

# condAddTerm -- OR the term `term` into `terms`: nothing when a term there
# already holds wherever it does, and the terms it holds wherever they do
# dropped. True when `terms` changed.
condAddTerm: function {terms: ListVal u64 term: u64} out bool is {
    for each t: terms loop {
        if (t & term) == t then return false
    }
    w: u64
    k: u64
    for k < terms.length loop {
        t: terms.get i: k
        k = k + 1
        if (t & term) == term then continue
        terms.set i: w val: t
        w = w + 1
    }
    for terms.length > w loop terms.pop
    terms.append term
    return true
}

# condMerge -- OR `src` into `dst`: true when `dst` changed
condMerge: function {dst: Cond src: Cond.view} out bool is {
    if dst.always then return false
    if src.always then {
        dst.always = true
        for dst.terms.length > 0 loop dst.terms.pop
        return true
    }
    grew: false
    for each t: src.terms loop {
        if (condAddTerm terms: dst.terms term: t) then grew = true
    }
    return grew
}

# condKey -- a condition as text, equal for equal conditions
condKey: function {c: Cond.view} out String is {
    if c.always then return "*".string
    k: String
    for each t: c.terms loop k.append "\{t},"
    return k
}

# condExprC -- the C preprocessor test a condition is: its terms ORed, each the
# AND of its conditions' expressions
condExprC: function {ctx: Ctx.view c: Cond.view} out String is {
    e: String
    for each t: c.terms loop {
        if e.length > 0 then e.append " || "
        e.append "("
        first: true
        k: u64
        for k < ctx.conds.length loop {
            if (t & (1.u64 << k)) != 0 then {
                if first.not then e.append " && "
                first = false
                e.append "("
                e.append (ctx.conds.get i: k).expr
                e.append ")"
            }
            k = k + 1
        }
        e.append ")"
    }
    return e
}

# wrapCond -- `body` into `buf`, inside `#if` where `c` holds in fewer than
# every configuration
wrapCond: function {ctx: Ctx.view c: Cond.view body: StringView buf: String.borrow} is {
    if c.always or (c.terms.length == 0) then {
        buf.append body
        return
    }
    buf.append "#if "
    buf.append (condExprC :ctx :c)
    buf.append "\n"
    buf.append body
    if (body.endsWith suffix: "\n").not then buf.append "\n"
    buf.append "#endif\n"
}

# demandCond -- the condition demand `at` holds under
demandCond: function {ctx: Ctx.view at: u64} out Cond is {
    if (ctx.demands.always.get i: at) then return condAlways
    c: Cond always: false terms: ListVal u64
    k: u64
    for k < ctx.demands.termDemand.length loop {
        if (ctx.demands.termDemand.get i: k) == at then c.terms.append (
            ctx.demands.termMask.get
            i: k
        )
        k = k + 1
    }
    return c
}

# setDemandCond -- demand `at` holds under `c` now
setDemandCond: function {ctx: Ctx at: u64 c: Cond.view} is {
    w: u64
    k: u64
    for k < ctx.demands.termDemand.length loop {
        d: ctx.demands.termDemand.get i: k
        m: ctx.demands.termMask.get i: k
        k = k + 1
        if d == at then continue
        ctx.demands.termDemand.set i: w val: d
        ctx.demands.termMask.set i: w val: m
        w = w + 1
    }
    for ctx.demands.termDemand.length > w loop {
        ctx.demands.termDemand.pop
        ctx.demands.termMask.pop
    }
    ctx.demands.always.set i: at val: c.always
    if c.always then return
    for each t: c.terms loop {
        ctx.demands.termDemand.append at
        ctx.demands.termMask.append t
    }
}

# rowAlways -- fired fragment row `row` holds in every configuration: a demand
# it answers does, or written C spelled its type
rowAlways: function {ctx: Ctx.view row: u64} out bool is {
    r: ctx.rows.rows.get i: row
    if r.typeTid.notZero then return true
    k: r.demandFrom
    for k < r.demandTo loop {
        x: ctx.demands.at key: (ctx.rows.demandKeys.get i: k)
        if x > 0 when (ctx.demands.always.get i: x - 1) then return true
        k = k + 1
    }
    return false
}

# rowCond -- the condition fired fragment row `row` holds under: the OR of the
# demands it answers
rowCond: function {ctx: Ctx.view row: u64} out Cond is {
    if (rowAlways :ctx :row) then return condAlways
    c: Cond always: false terms: ListVal u64
    r: ctx.rows.rows.get i: row
    k: r.demandFrom
    for k < r.demandTo loop {
        x: ctx.demands.at key: (ctx.rows.demandKeys.get i: k)
        if x > 0 then condMerge dst: c src: (demandCond :ctx at: x - 1)
        k = k + 1
    }
    return c
}

# rowDemandFired -- true when ANY demand fragment row `row` names was demanded
# of that row's unit. A demand list `a,b,c` means ANY OF: a helper several
# members share is one row naming the members that reach it, so it loads once
# however many fired. A `uses_<Type>` row fires too when written C spells the
# type (typeRowDemanded), and a `destroys_<Type>` row when written C calls the
# type's destructor.
rowDemandFired: function {ctx: Ctx.view row: u64} out bool is {
    r: ctx.rows.rows.get i: row
    if r.typeTid.notZero then {
        if r.destroys then {
            if (ctx.destroyUsed.has item: r.typeTid) then return true
        } else if (typeRowDemanded :ctx tid: r.typeTid) then return true
    }
    k: r.demandFrom
    for k < r.demandTo loop {
        if (ctx.demands.at key: (ctx.rows.demandKeys.get i: k)) > 0 then return true
        k = k + 1
    }
    return false
}

# emitRuntimeUnit -- one unit's runtime: every fragment row it owns, in TABLE
# ORDER, loaded when its demands fired. This is the whole of what
# emitRuntimeIo, emitRuntimeCli, emitRuntimeOs, emitRuntimeNet, emitRuntimeTcc,
# emitNeededNatives and emitRuntimeSvIter did by hand. The order they spelled
# is the order the rows are written in -- including the alphabetical
# convention runs, because a subset of an alphabetically ordered list, taken in
# order, is already sorted. The per-unit skip lists are gone with them: a
# member the runtime does not supply has no row to walk.
emitRuntimeUnit: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    uname: StringView
    buf: String.borrow
} is {
    closeRowNeeds :ctx
    uid: ctx.demands.names.find s: uname
    if uid.isZero then return
    i: u64
    n: ctx.rows.fragRows.length
    for i < n loop {
        row: ctx.rows.fragRows.get :i
        i = i + 1
        if (ctx.rows.rows.get i: row).owner != uid then continue
        # a piece is written in place by its file (loadPieces)
        if (ctx.rowsInPlace.has item: row) then continue
        if (ctx.rowsWritten.has item: row).not when (rowDemandFired :ctx :row) then {
            writeRuntimeRow :ast :reg :typing :ctx :row :buf
        }
    }
}

# writeRuntimeRow -- a fired row's fragments, inside `#if` where the row holds
# in fewer than every configuration (rowCond)
writeRuntimeRow: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    row: u64
    buf: String.borrow
} is {
    ctx.rowsWritten.add item: row
    closeRowNeeds :ctx
    rowMemberUses :ast :reg :typing :ctx :row
    fl: rowFragText :ctx :row
    if (rowAlways :ctx :row) then {
        for each fr: (fl.stringView.split sep: ",") loop {
            if fr.length > 0 then writeFragment :ast :reg :typing :ctx frag: fr :buf
        }
        return
    }
    rb: String
    for each fr: (fl.stringView.split sep: ",") loop {
        if fr.length > 0 then writeFragment :ast :reg :typing :ctx frag: fr buf: rb
    }
    wrapCond :ctx c: (rowCond :ctx :row) body: rb.stringView :buf
}

# rowFragText -- fragment row `row`'s fragment names, comma-separated, as an
# owned copy (the fragment emitter lends ctx); "" for a piece
rowFragText: function {ctx: Ctx.view row: u64} out String is {
    ft: (ctx.rows.rows.get i: row).fragText
    if ft == 0 then return String
    return (ctx.rows.fragTexts.get i: ft - 1).copy
}

# needsOutsidePrelude -- whether a need registered from position `from` on is
# another unit's than the prelude's: the prelude is decided at assembly, so a
# need of its own asks no late runtime walk
needsOutsidePrelude: function {ctx: Ctx.view from: u64} out bool is {
    i: from
    for i < ctx.demands.keys.length loop {
        u: ctx.demands.nameText id: (ctx.demands.keys.get :i).owner
        if (ctx.nativeWords.slotOf text: u) != nativeWord.slot.unitPrelude then return true
        i = i + 1
    }
    return false
}

# rowMemberUses -- the template members row `row`'s fragments call (its
# `members`): each `<canon>.<member>` is recorded by the C name the canon's
# instance has
rowMemberUses: function {
    ast: Ast.view reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx row: u64
} is {
    mt: (ctx.rows.rows.get i: row).members
    if mt == 0 then return
    ml: (ctx.rows.memberTexts.get i: mt - 1).copy
    for each one: (ml.stringView.split sep: ",") loop rowMemberUse :ast :reg :typing :ctx :row :one
}

# rowMemberUse -- one `<canon>.<member>` entry of row `row`'s `members=`, its
# `?NAME` the condition the fragment calls it under
rowMemberUse: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    row: u64
    one: StringView
} is {
    qm: (one.indexOf needle: "?").or d: one.length
    ent: one.substring from: 0 to: qm
    dot: (ent.lastIndexOf needle: ".").or d: ent.length
    if dot == ent.length then return
    mt: stemTid :ast :reg :typing :ctx canon: (ent.substring from: 0 to: dot)
    if mt.isZero then return
    sl: ctx.memberWords.slotOf text: (ent.substring from: dot + 1 to: ent.length)
    # a destructor called is a destroy use, whatever the type (noteDestroyUse)
    if sl == memberWord.slot.destroy then {
        noteDestroyUse :reg :typing :ctx tid: mt
        return
    }
    cb: u64
    if qm < one.length then cb = condBitOf :ctx name: (one.substring from: qm + 1 to: one.length)
    if cb == 0 when (rowAlways :ctx :row) then {
        noteMemberUse :ctx mono: mt member: sl
        return
    }
    rc: rowCond :ctx :row
    if cb != 0 then rc = condWith c: rc bit: cb
    noteMemberUseCond :ctx mono: mt member: sl cond: rc
}

# closeRowNeeds -- register the needs of every fired row, until a round fires
# no row it has not seen: made whole before a row is written, so a row a later
# one needs -- in a unit the walk has already passed -- is written in the same
# walk, ahead of the C that calls it. Nothing to do while no demand has been
# added since the last time.
closeRowNeeds: function {ctx: Ctx} is {
    for (ctx.demands.keys.length != ctx.rowNeedsAt) or (ctx.condEpoch != ctx.rowCondEpochAt) loop {
        ctx.rowNeedsAt = ctx.demands.keys.length
        # a demand's condition grew: a fired row it fires holds in more
        # configurations, and so do its needs
        recond: ctx.condEpoch != ctx.rowCondEpochAt
        ctx.rowCondEpochAt = ctx.condEpoch
        i: u64
        for i < ctx.rows.fragRows.length loop {
            row: ctx.rows.fragRows.get :i
            if (rowDemandFired :ctx :row) then closeRow :ctx :row :recond
            i = i + 1
        }
    }
}

# closeRow -- register fired row `row`'s needs the first time the walk meets it,
# and again when a demand's condition grew (`recond`) and the row's may have
# with it; a row holding everywhere can hold in no more places
closeRow: function {ctx: Ctx row: u64 recond: bool} is {
    if (ctx.rowsClosed.has item: row) then {
        if recond when (ctx.rowsAlwaysClosed.has item: row).not then rowNeedsUnder :ctx :row
        return
    }
    ctx.rowsClosed.add item: row
    if (rowAlways :ctx :row).not then {
        rowNeedsUnder :ctx :row
        return
    }
    ctx.rowsAlwaysClosed.add item: row
    rowNeedsAdd :ctx :row cond: condAlways
}

# rowNeedsUnder -- rowNeedsAdd for fired row `row` under the condition it holds
# in, once per condition: a row the walk revisits under the same one adds nothing
rowNeedsUnder: function {ctx: Ctx row: u64} is {
    c: rowCond :ctx :row
    k: condKey :c
    seen: false
    {
        ko: ctx.rowCondKey.get key: row
        if ko.some then {
            seen = ko.stringView == k
        }
    }
    if seen then return
    ctx.rowCondKey.set key: row value: k.copy
    rowNeedsAdd :ctx :row cond: c
}

# emitUnorderedUnits -- the units with rows the order directive does not name,
# each once, in the order the table first mentions them. A unit shipping its own
# rows is not in the compiler's list, and this is the slot it gets.
# `prelude` is not one of them: emitC emits it into the header itself.
emitUnorderedUnits: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    buf: String.borrow
} is {
    done: List String
    i: u64
    n: ctx.rows.fragRows.length
    for i < n loop {
        # an owned copy: the runtime emitter below lends ctx
        u: (ctx.demands.nameText id: (ctx.rows.rows.get i: (ctx.rows.fragRows.get :i)).owner).string
        i = i + 1
        skip: false
        if (
            (ctx.nativeWords.slotOf text: u.stringView) == nativeWord.slot.unitPrelude
        ) then skip = true
        for each o: ctx.unitOrder loop {
            if o.stringView == u then skip = true
        }
        for each d: done loop {
            if d.stringView == u then skip = true
        }
        if skip.not then {
            done.append from: u.copy
            emitRuntimeUnit :ast :reg :typing :ctx uname: u.stringView :buf
        }
    }
}

# writeFragment -- a fired row's fragment `frag`, its holes filled, onto `buf`.
writeFragment: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    frag: StringView
    buf: String.borrow
} is {
    p: fragKey :ctx name: frag
    if (ctx.piecedFrags.has item: frag.string) then {
        plan: rtRowPlan :ctx id: (tmplParsed :ctx key: p)
        buf.append (rtFragmentText :ast :reg :typing :ctx :plan all: false key: p)
        return
    }
    f: loadFragment :ast :reg :typing :ctx key: p
    buf.append f
}

# demandRowBoxes -- the boxes each fired row's fragments spell (the
# @BOX_<type>.<protocol>@ holes, spelledBoxes): noted once every body is
# written, so their helpers are written and the natives their vtables take are
# demanded (demandBoxedNatives) before the rows are.
demandRowBoxes: function {
    ast: Ast.view reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx
} is {
    rows: ListVal u64
    for each r0: ctx.rows.fragRows loop rows.append r0
    for each row: rows loop {
        bt: (ctx.rows.rows.get i: row).boxes
        if bt == 0 then continue
        if (rowDemandFired :ctx :row).not then continue
        bl: (ctx.rows.boxTexts.get i: bt - 1).copy
        for each one: (bl.stringView.split sep: ",") loop {
            it: boxTidOf :ast :reg :typing :ctx :one wantProtocol: false
            pt: boxTidOf :ast :reg :typing :ctx :one wantProtocol: true
            if it.notZero when pt.notZero then {
                noteBoxUse :typing :ctx implTid: it protoTid: pt
                noteBorrowBoxUse :ctx implTid: it protoTid: pt
            }
        }
    }
}

# spelledBoxes -- each `@BOX_<type>.<protocol>@` hole `text` spells onto
# `into`, comma-separated, as `<type>.<protocol>`
spelledBoxes: function {text: StringView into: String.borrow} is {
    at: u64
    for at < text.length loop {
        o: (text.substring from: at to: text.length).indexOf needle: "@BOX_"
        if o.none then return
        s: at + o + 5
        e: ((text.substring from: s to: text.length).indexOf needle: "@").or d: text.length - s
        if into.length > 0 then into.append ","
        into.append (text.substring from: s to: s + e)
        at = s + e + 1
    }
}

# boxTidOf -- one half of a box `<type>.<protocol>` (a @BOX_...@ hole): the protocol when `wantProtocol`, else the type; 0 when it names
# no type
boxTidOf: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    one: StringView
    wantProtocol: bool
} out ztypes.tid is {
    dot: (one.lastIndexOf needle: ".").or d: one.length
    if dot == one.length then return ztypes.tid.zero
    if wantProtocol then return (
        stemTid
        :ast
        :reg
        :typing
        :ctx
        canon: (one.substring from: dot + 1 to: one.length)
    )
    return (stemTid :ast :reg :typing :ctx canon: (one.substring from: 0 to: dot))
}

# demandBoxedNatives -- for each boxed row of a runtime-owned class, the
# natives its protocol names, which the row's vtable takes the addresses of
# (demandSpecNatives): demanded before the runtime pass writes the rows.
demandBoxedNatives: function {
    ast: Ast.view reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx
} is {
    rows: ListVal ztypes.confid
    for each b: ctx.boxedImplementation loop rows.append b
    for each ri: rows loop {
        cid: ztypes.tid
        spec: ztypes.tid
        {
            row: typing.implementation.get i: ri
            cid = row.implTypeId
            spec = row.specTypeId
        }
        if (ctx.classRowTids.contains item: cid) then (
            demandSpecNatives
            :ast
            :reg
            :typing
            :ctx
            :cid
            :spec
        )
    }
}

# bindClassRows -- each ClassRow's class, by id (ctx.classRowTids, parallel
# to ctx.classRows); 0 when the program has no such class (rowTypeTid)
bindClassRows: function {typing: ztyping.ZTyping.view ctx: Ctx ast: Ast.view} is {
    for each r: ctx.classRows loop {
        cid: rowTypeTid :ast :typing uname: r.uname.stringView tname: r.cls.stringView
        ctx.classRowTids.append cid
    }
}

# markLiveClasses -- each row's class is LIVE once every canon its `live=`
# names exists: the instances its constructor hands back or its methods take,
# which only a program that makes one mints. A live class is used, and the
# native methods its declared implementations name are demanded, since their
# vtables take those addresses whether or not anything calls them. The gate is
# order-independent: it is true exactly when what the fragments reference has
# been demanded, so the C always compiles.
markLiveClasses: function {
    ast: Ast.view reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx
} is {
    i: u64
    n: ctx.classRows.length
    for i < n loop {
        cid: ctx.classRowTids.get :i
        if cid.notZero then {
            lv: (ctx.classRows.get :i).live.copy
            live: true
            for each c: (lv.stringView.split sep: ",") loop {
                if c.length > 0 when (stemTid :ast :reg :typing :ctx canon: c
                ).isZero then live = false
            }
            if live then ctx.liveClasses.add item: cid
        }
        i = i + 1
    }
}


# demandSpecNatives -- each method protocol `spec` names, as class `cid`
# implements it, demanded through its fragment row when one implements it
demandSpecNatives: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    cid: ztypes.tid
    spec: ztypes.tid
} is {
    mnames: List String
    mids: ListVal ztypes.tid
    midsNm: ListVal zast.nameid
    protoChildMethods :ast :reg :typing tid: spec names: mnames ids: mids nameIds: midsNm
    for each mnId: midsNm loop {
        mo: typing.declChildOfId parentTypeId: cid nameId: mnId
        if mo.some then {
            demandMethodRow :reg :typing :ctx mfid: mo
        }
    }
}

# emitClassRowStructs -- each ClassRow's struct and destructor, in table
# order, when the C written spells the class (typeReached). The struct is laid
# out from the declaration as a record's is (emitRecordStructBody); the
# destructor is the class's `destroy` fragment. The type is marked in
# ctx.emittedUserTypes so every other path skips it -- a by-value use would
# otherwise emit a second struct with a generic destructor -- and it is written
# here, ahead of the fragments that dereference its fields.
emitClassRowStructs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    buf: String.borrow
} is {
    i: u64
    n: ctx.classRows.length
    for i < n loop {
        cid: ctx.classRowTids.get :i
        # a class with a template is written from it (emitTmplClassMono)
        emit: cid.notZero and ((ctx.classRows.get :i).tmpl.length == 0)
        if emit when (ctx.emittedUserTypes.has item: cid) then emit = false
        if emit when (typeReached :ctx tid: cid).not then emit = false
        if emit then {
            ctx.emittedUserTypes.add item: cid
            emitClassRowStruct :ast :reg :typing :ctx :cid :buf
            dfr: (ctx.classRows.get :i).destroy.copy
            if dfr.length > 0 when (destroyWritten :reg :ctx tid: cid) then {
                writeFragment :ast :reg :typing :ctx frag: dfr.stringView :buf
            }
        }
        i = i + 1
    }
}

# recordCreateAlias -- a record's `<rc>_create` is written beside its
# `_meta_create`: written C calls it (noteCreateAliasUse), and the record is
# the main unit's and constructed by its fields, not by a native create.
recordCreateAlias: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx.view tid: ztypes.tid
} out bool is {
    if (ctx.createAliasUsed.has item: tid).not then return false
    if (definedInNonMain :ctx :tid) then return false
    return (typeHasNativeCreate :reg :typing :tid).not
}

# emitMetaCreate -- a struct's field-wise constructor, `<rc>_meta_create`, and
# when `alias` the `<rc>_create` name a construction calls
emitMetaCreate: function {
    buf: String.borrow
    rc: StringView
    params: StringView
    inits: StringView
    alias: bool
} is {
    l3: "static \{rc}_t \{rc}_meta_create(\{params}) {\n"
    buf.append l3
    l4: "    \{rc}_t _this = { \{inits} };\n"
    buf.append l4
    buf.append "    return _this;\n"
    buf.append "}\n"
    if alias then {
        l5: "#define \{rc}_create \{rc}_meta_create\n"
        buf.append l5
    }
}

# emitClassRowStruct -- a runtime-owned class's struct, laid out from its
# declaration as a record's is, and the field-wise constructor a program
# building one by its fields (`io.File fd: 0 open: false`) calls, unless the
# class's own `create` is native
emitClassRowStruct: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    cid: ztypes.tid
    buf: String.borrow
} is {
    fc: spelledCname :ctx tid: cid
    fnames: List String
    fids: ListVal ztypes.tid
    fidsNm: ListVal zast.nameid
    recFieldLists :ast :reg :typing tid: cid names: fnames ids: fids nameIds: fidsNm
    fwd: isFwdDeclared :ctx tid: cid
    if fwd then {
        lo: "struct \{fc}_t {\n"
        buf.append lo
    } else {
        buf.append "typedef struct {\n"
    }
    (
        emitRecordStructBody
        :ast
        :reg
        :typing
        :ctx
        tid: cid
        names: fnames
        ids: fids
        nameIds: fidsNm
        :buf
    )
    if fwd then {
        buf.append "};\n"
    } else {
        lc: "} \{fc}_t;\n"
        buf.append lc
    }
    if (typeHasNativeCreate :reg :typing tid: cid) then return
    # the constructor is written where written C builds one (noteCreateUse)
    if (ctx.createUsed.has item: cid).not then return
    params: String
    inits: String
    (
        recordCreateArgs
        :ast
        :reg
        :typing
        :ctx
        tid: cid
        names: fnames
        ids: fids
        nameIds: fidsNm
        :params
        :inits
    )
    (
        emitMetaCreate
        :buf
        rc: fc.stringView
        params: params.stringView
        inits: inits.stringView
        alias: (ctx.createAliasUsed.has item: cid)
    )
}

# maybePreEmitElem -- a user type (variant/record/class/union) used as a
# collection element is embedded BY VALUE by the List/ListView mono, so its
# struct must precede the mono. Emit it here (guarded by ctx.emittedUserTypes);
# its methods still emit later in emitRecordDefsIn. Covers main-unit AND dep
# file-unit element types (the cross-unit astnode union returned by value from a
# ListView_Node mono); monos / generics / typedefs and system-unit types (which
# have their own dedicated sweeps above) are skipped.
maybePreEmitElem: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    eid: ztypes.tid
    buf: String.borrow
} is {
    if eid.isZero then return
    elemTid: eid
    elemName: reg.nameOf tid: eid
    if (definedInUnitTid :reg :typing tid: eid).isZero when elemName.length > 0 then {
        srid: canonTypeId :reg :typing tid: eid
        if srid.notZero then elemTid = srid
    }
    cid: chaseAggregateTypedef :reg :typing :ctx tid: elemTid
    # a type written C never reaches is not written: an ordinal field is its
    # scalar, so its enum is reached only where a tag constant is spelled
    if (typeReached :ctx tid: cid).not then return
    # an instance is emitted by its own sweep, but a user's spec instance is
    # emitted as a user spec is
    origin: originTidOf :reg tid: cid
    if origin.notZero when (userSpecInstance :reg :typing tid: cid).not then return
    if (reg.isGenericOf tid: cid) then return
    duoPe: definedInUnitName :reg :typing tid: cid
    peUnit: ctx.mainName.copy
    if duoPe.length > 0 then {
        if (reg.isNativeOf tid: cid) then return
        peUnit = duoPe.string
    }
    if (reg.typeValid tid: cid).not then return
    tt: reg.typetypeOf typeId: cid
    smPe: ctx.mainName.copy
    smPeD: ctx.mainUnitId
    (
        ctxBindMain
        :ctx
        name: peUnit.stringView
        unitDecl: (ztypecheck.unitDeclOfTid :reg :typing tid: cid)
    )
    if tt == ztypes.ztypetype.variantType then {
        emitOneVariant :ast :reg :typing :ctx tid: cid :buf
    }
    if tt == ztypes.ztypetype.recordType then {
        emitOneRecord :ast :reg :typing :ctx tid: cid :buf
    }
    if tt == ztypes.ztypetype.classType then {
        emitOneRecord :ast :reg :typing :ctx tid: cid :buf
    }
    if tt == ztypes.ztypetype.protocolType then {
        emitOneProtocol :ast :reg :typing :ctx tid: cid :buf
    }
    if tt == ztypes.ztypetype.facetType then {
        emitOneFacet :ast :reg :typing :ctx tid: cid :buf
    }
    if tt == ztypes.ztypetype.unionType then {
        emitUnionMono :ast :reg :typing :ctx tid: cid :buf
    }
    ctxBindMain :ctx name: smPe.stringView unitDecl: smPeD
}

# preEmitEmbeddedTypes -- emit the main-unit user types a variant/record/class
# embeds BY VALUE (arm payloads, field types) before its own struct, so they are
# declared first. Idempotent via ctx.emittedUserTypes, which also breaks cycles.
preEmitEmbeddedTypes: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    ids: (ListVal ztypes.tid).view
    buf: String.borrow
} is {
    for each eidv: ids loop {
        maybePreEmitElem :ast :reg :typing :ctx eid: eidv :buf
    }
}

# isFwdDeclared -- the type was forward-declared by emitMainFwdDecls, so its
# body must be emitted as a named `struct X_t { ... };` (the typedef is already
# in the forward-decl block).
isFwdDeclared: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    return (ctx.fwdDeclaredTypes.has item: tid)
}

# isStructTypetype -- the three typetypes whose C is a struct the emitter writes,
# and so the three this pass forward-declares.
isStructTypetype: function {tt: ztypes.ztypetype} out bool is {
    if tt == ztypes.ztypetype.recordType then return true
    if tt == ztypes.ztypetype.unionType then return true
    return tt == ztypes.ztypetype.classType
}

# emitDeclaredFwdDecl -- forward-declare a type a unit DECLARED. A native type
# is skipped because the runtime owns its layout, a typedef because it is an
# alias, and a Box because its C is its element's.
emitDeclaredFwdDecl: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    if (definedInUnitTid :reg :typing :tid).isZero then return
    if (reg.isNativeOf :tid) then return
    if (isTypedefType :typing :tid) then return
    if (reg.isBoxOf :tid) then return
    cn: spelledCname :ctx :tid
    ctx.fwdDeclaredTypes.add item: tid
    l0: "typedef struct \{cn}_t \{cn}_t;\n"
    buf.append l0
    # a destructor is declared where one is written: a union's whenever written
    # C destroys one, anything else's when it owns resources too
    needDtor: (reg.typetypeOf typeId: tid) == ztypes.ztypetype.unionType
    if (ownsResources :reg :ctx :tid) then needDtor = true
    if needDtor when (destroyWritten :reg :ctx :tid) then {
        l1: "static void \{cn}_destroy(\{cn}_t* p);\n"
        buf.append l1
    }
}

# monoNeedsFwdDecl -- a mono is forward-declared when its own C names a struct:
# it owns a destructor, or it is an array or one of the four collection
# families. An array over a user type is emitted after the user structs, and a
# function signature naming it can come first.
monoNeedsFwdDecl: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    if (ownsResources :reg :ctx :tid) then return true
    if (originIsTid :reg :tid originTid: (ctx.origins.get i: family.slot.fixedArray)
    ) then return true
    if (isListOriginOf :reg :ctx :tid) then return true
    if (isListViewOriginOf :reg :ctx :tid) then return true
    if (isSetOriginOf :reg :ctx :tid) then return true
    return (isMapOriginOf :reg :ctx :tid)
}

# emitMonoFwdDecl -- forward-declare an instantiated type. A generic TEMPLATE
# has no C of its own and reaches here with no origin, so it declares nothing;
# nor does an instance of a typedef, which C spells as the type it wraps.
emitMonoFwdDecl: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    origin: ztypes.tid
    buf: String.borrow
} is {
    if origin.isZero then return
    if (isTypedefType :typing :tid) then return
    if (reg.isBoxOf :tid) then return
    if (monoNeedsFwdDecl :reg :ctx :tid).not then return
    cnX: spelledCname :ctx :tid
    ctx.fwdDeclaredTypes.add item: tid
    lx0: "typedef struct \{cnX}_t \{cnX}_t;\n"
    buf.append lx0
    fwdDtor: (
        (ownsResources :reg :ctx :tid) and
        (destroyWritten :reg :ctx :tid) or
        (isMapOriginOf :reg :ctx :tid) or
        (isSetOriginOf :reg :ctx :tid)
    )
    if fwdDtor then {
        lx1: "static void \{cnX}_destroy(\{cnX}_t* p);\n"
        buf.append lx1
    }
}

# emitTypeFwdDecl -- one struct type's forward declaration, by which of the two
# kinds it is: declared by a unit, or instantiated from a template.
emitTypeFwdDecl: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    origin: originTidOf :reg :tid
    if origin.isZero when (reg.isGenericOf :tid).not then {
        emitDeclaredFwdDecl :reg :typing :ctx :tid :buf
        return
    }
    emitMonoFwdDecl :reg :typing :ctx :tid :origin :buf
}

# emitMainFwdDecls -- forward-declare every RECORD + UNION + CLASS type whose
# body this emitter writes (named-struct typedef + a destructor prototype)
# before the monos. The AST is a self-referential astnode union: Node_destroy +
# the Option/List monos + the print functions reference astnode and the arm *Data
# structs by pointer (or call their destroys) ahead of the bodies, so without
# forward declarations they are undeclared. The bodies then emit as plain
# `struct X_t { ... };` via isFwdDeclared.
#
# Which types those are is a question for the DECLARATION, not for the unit's
# name. `is native` on a class or record means the RUNTIME owns the layout: the
# sixteen scalars, String and StringView, and the sviter iterators all get their
# C from a fragment, and a forward declaration of one is a conflicting typedef
# -- LinesIter's fragment is `typedef z_Splitter_t z_LinesIter_t;`, an ALIAS
# that no `typedef struct X_t X_t;` can ever be made compatible with. Everything
# else this pass reaches is a struct the emitter writes, whichever unit declared
# it, so io's File and cli's Spec are forward-declared on the same terms as a
# user record -- and a USER type shadowing a builtin name carries no marker, so
# it keeps its forward declaration and its own layout.
emitMainFwdDecls: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx buf: String.borrow
} is {
    last: reg.nextTid
    t: ztypes.tid
    for t < last loop {
        if (isStructTypetype tt: (reg.typetypeOf typeId: t)) when (typeReached :ctx tid: t) then {
            emitTypeFwdDecl :reg :typing :ctx tid: t :buf
        }
        t = t.next
    }
}

# monoMapKV -- a Map/MapEntry mono's value + key type ids. A mono carries no
# concrete generic-argument row of its own, so resolve the value via the
# get-return OptionView's element name and the key via the mangled-name
# remainder, mirroring emitMapMono.
monoMapKV: function {typing: ztyping.ZTyping.view monoId: ztypes.tid acc: ListVal ztypes.tid} is {
    go: typing.declChildOfId parentTypeId: monoId nameId: zast.wellKnown.slot.wkGet
    if go.some then {
        vid: mapValType :typing :monoId
        if vid.notZero then acc.append vid
        kid: mapKeyType :typing :monoId
        if kid.notZero then acc.append kid
    }
}

# tmplInstArgIds -- a templated class's instance may hold any of its type
# arguments by value (a JoinHandle's task), and answers other instances by
# value (a Mutex's guard): each is an ordering edge
tmplInstArgIds: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    monoId: ztypes.tid
    acc: ListVal ztypes.tid
} is {
    td: typing.declIdOfType typeId: (originTidOf :reg tid: monoId)
    if td.notZero then {
        k: u64
        for k < (reg.genericParamNamesOf tdecl: td).length loop {
            acc.append (reg.genericTypeArgAt specId: monoId ordinal: k)
            k = k + 1
        }
    }
    # and each templated class or mono its methods answer or take (@@OUT.<m>@@,
    # @@ARG.<m>.<p>@@): a prototype names it
    slot: u64
    for slot < (typing.declRowSlots ownerTid: monoId) loop {
        rw: typing.declRowAt ownerTid: monoId membersOnly: true :slot
        slot = slot + 1
        if rw.keep when (reg.typetypeOf typeId: rw.tid) == ztypes.ztypetype.functionType then {
            sig: ListVal ztypes.tid
            sig.append (reg.returnTypeOf tid: rw.tid)
            names: ListVal zast.nameid
            recFieldIds :reg :typing tid: rw.tid ids: sig nameIds: names
            for each st: sig loop {
                it: ownSignatureTid :reg tid: st
                if it != monoId when (tmplSigEdge :reg :typing :ctx tid: it) then acc.append it
            }
        }
    }
}

# tmplSigEdge -- a type a templated class's signature names that orders the
# class after it: a mono, or a templated class the program has
tmplSigEdge: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx.view tid: ztypes.tid
} out bool is {
    if (tmplTypeMade :reg :typing :ctx :tid).not then return false
    if (originTidOf :reg :tid).notZero then return true
    return (tmplClassRowOf :reg :ctx :tid) > 0
}

# isArmWrapMono -- a mono whose elements are its arms' payloads: an option or
# result of either family, a view union, a variant
isArmWrapMono: function {reg: ztypes.ZTypeRegistry.view ctx: Ctx.view tid: ztypes.tid} out bool is {
    return (
        (originIsTid :reg :tid originTid: (ctx.origins.get i: family.slot.optionval)) or
        (originIsTid :reg :tid originTid: (ctx.origins.get i: family.slot.resultval)) or
        (originIsTid :reg :tid originTid: (ctx.origins.get i: family.slot.option)) or
        (originIsTid :reg :tid originTid: (ctx.origins.get i: family.slot.result)) or
        (isViewUnionOriginOf :reg :ctx :tid) or
        ((reg.typetypeOf typeId: tid) == ztypes.ztypetype.variantType)
    )
}

# staticListElemOf -- the element type a static list or its iterator mono holds
# a pointer to, which a variant -- written whole, with no forward declaration
# -- must precede; 0 for any other mono.
staticListElemOf: function {
    reg: ztypes.ZTypeRegistry.view ctx: Ctx.view monoId: ztypes.tid
} out ztypes.tid is {
    stl: (
        (originIsTid :reg tid: monoId originTid: (ctx.origins.get i: family.slot.staticList)) or
        (originIsTid :reg tid: monoId originTid: (ctx.origins.get i: family.slot.staticIter))
    )
    if stl.not then return ztypes.tid.zero
    return (reg.genericTypeArgAt specId: monoId ordinal: 0)
}

# monoElemIdsOf -- the type ids a collection/wrapper mono references by its
# element/key/value (array/List/ListView/Set/Map) or arm payloads (optionval/
# resultval/Option/Result/OptionView), or its fields for a user-generic
# record/class mono. Used by the early/late split to find which monos embed a
# user type. An array declares no data field, so its element is read through
# `get` like a list's.
monoElemIdsOf: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    monoId: ztypes.tid
    acc: ListVal ztypes.tid
} is {
    byGet: (
        (isListOriginOf :reg :ctx tid: monoId) or
        (isListViewOriginOf :reg :ctx tid: monoId) or
        (originIsTid :reg tid: monoId originTid: (ctx.origins.get i: family.slot.fixedArray)) or
        (originIsTid :reg tid: monoId originTid: (ctx.origins.get i: family.slot.spanVal))
    )
    if byGet then {
        e: listElemType :reg :typing :monoId
        if e.notZero then acc.append e
        return
    }
    ste: staticListElemOf :reg :ctx :monoId
    if ste.notZero then {
        acc.append ste
        return
    }
    if (isSetOriginOf :reg :ctx tid: monoId) then {
        eid: setElemType :typing :monoId
        if eid.notZero then acc.append eid
        return
    }
    if (isMapOriginOf :reg :ctx tid: monoId) then {
        monoMapKV :typing :monoId :acc
        return
    }
    # the id-keyed pair read their element types the same way their hashed
    # siblings do. They need an arm of their own because, unlike a Map, they
    # are STACK structs: an IdMap embedding a user type by value is a real
    # ordering edge, and without this it looks like it embeds nothing and is
    # emitted ahead of the optionval its `get` returns.
    if (isIdSetOriginOf :reg :ctx tid: monoId) then {
        ideid: setElemType :typing :monoId
        if ideid.notZero then acc.append ideid
        return
    }
    if (isIdMapOriginOf :reg :ctx tid: monoId) then {
        monoMapKV :typing :monoId :acc
        return
    }
    if (tmplClassRowOf :reg :ctx tid: monoId) > 0 then {
        tmplInstArgIds :reg :typing :ctx :monoId :acc
        return
    }
    # both append to `acc`
    names: ListVal zast.nameid
    if (isArmWrapMono :reg :ctx tid: monoId) then {
        variantArmIds :reg :typing tid: monoId ids: acc nameIds: names
        return
    }
    recFieldIds :reg :typing tid: monoId ids: acc nameIds: names
}

# buildUserTypeList -- every struct type whose C body this emitter writes:
# RECORD / CLASS / UNION / VARIANT / FACET that is not a mono, not a generic
# template, and whose layout the runtime does not own. A mono embedding one of
# these by value must be emitted after it. Types a fragment row demand-gates
# join only once the program constructs them, on the same terms the sweep's
# own drain applies -- without that the list would emit an io wrapper class
# into every program that merely imports io.
buildUserTypeList: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    acc: ListVal ztypes.tid
} is {
    last: reg.nextTid
    t: ztypes.tid
    for t < last loop {
        tt: reg.typetypeOf typeId: t
        isStruct: isUserStructType :tt
        if isStruct then {
            mo: originTidOf :reg tid: t
            gen: reg.isGenericOf tid: t
            own: (
                mo.isZero and gen.not and (definedInUnitTid :reg :typing tid: t).notZero
            )
            if own or (userSpecInstance :reg :typing tid: t) then {
                emOk: (reg.isNativeOf tid: t).not
                if emOk when (
                    typeDemandMet
                    :ctx
                    tid: t
                ) when (typeReached :ctx tid: t) then acc.append t
            }
        }
        t = t.next
    }
}

# monoDependsOnUser -- does the mono's layout reference a user type, directly or
# through a nested mono? The seen list breaks cycles through boxed monos.
monoDependsOnUser: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    monoId: ztypes.tid
    userList: (ListVal ztypes.tid).view
    seen: ListVal ztypes.tid
} out bool is {
    if (seen.contains item: monoId) then return false
    seen.append monoId
    elems: ListVal ztypes.tid
    monoElemIdsOf :reg :typing :ctx :monoId acc: elems
    for each eid: elems loop {
        ceid: chaseAggregateTypedef :reg :typing :ctx tid: eid
        if (userList.contains item: ceid) then return true
        emo: originTidOf :reg tid: ceid
        if emo.notZero when (
            monoDependsOnUser
            :ast
            :reg
            :typing
            :ctx
            monoId: ceid
            :userList
            :seen
        ) then return true
    }
    return false
}

# monoIsLate -- the mono embeds a user type by value (a fresh seen per query),
# holds a mono the collection pass writes, holds a function in a field, or
# holds a templated class, which the late group writes.
monoIsLate: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    monoId: ztypes.tid
    userList: (ListVal ztypes.tid).view
} out bool is {
    seen: ListVal ztypes.tid
    if (monoDependsOnUser :ast :reg :typing :ctx :monoId :userList :seen) then return true
    if (monoHoldsTmplClass :reg :typing :ctx :monoId) then return true
    if (monoHoldsFunctionField :typing :monoId) then return true
    return (monoHoldsCollectionPassMono :reg :typing :ctx :monoId)
}

# monoHoldsFunctionField -- the instance holds a function in a field: its
# struct names the function's type, whose typedef is written after the
# collection pass and before the late group.
monoHoldsFunctionField: function {typing: ztyping.ZTyping.view monoId: ztypes.tid} out bool is {
    i: u64
    n: typing.declRowSlots ownerTid: monoId
    for i < n loop {
        row: typing.declRowAt ownerTid: monoId membersOnly: true slot: i
        i = i + 1
        if row.keep when (typing.declIsFnptrFieldId parentTypeId: monoId nameId: row.name) then {
            return true
        }
    }
    return false
}

# monoHoldsTmplClass -- an element, key or value of the mono is a templated
# class (tmplClassRowOf), or a value sum over one
monoHoldsTmplClass: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx.view monoId: ztypes.tid
} out bool is {
    elems: ListVal ztypes.tid
    monoElemIdsOf :reg :typing :ctx :monoId acc: elems
    for each e: elems loop {
        ce: chaseAggregateTypedef :reg :typing :ctx tid: e
        if (tmplClassRowOf :reg :ctx tid: ce) > 0 then return true
        if (isValueSumMono :reg :ctx tid: ce) when (monoHoldsTmplClass :reg :typing :ctx monoId: ce
        ) then return true
    }
    return false
}

# monoHoldsCollectionPassMono -- an element, key or value of the mono is written
# by the collection pass. That pass writes one family at a time, so the element
# can come after the container bodies that index it (a ListView's iterator is
# written before the List family, a user generic instance after every
# collection); the late group orders the pair instead.
monoHoldsCollectionPassMono: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx.view monoId: ztypes.tid
} out bool is {
    elems: ListVal ztypes.tid
    monoElemIdsOf :reg :typing :ctx :monoId acc: elems
    ei: u64
    for ei < elems.length loop {
        ce: chaseAggregateTypedef :reg :typing :ctx tid: (elems.get i: ei)
        if (isCollectionPassMono :reg :ctx tid: ce) then return true
        # a value sum embeds its payload, so one over such a mono is ordered
        # with it (a sum cannot hold itself by value, so this ends)
        if (isValueSumMono :reg :ctx tid: ce) when (
            monoHoldsCollectionPassMono
            :reg
            :typing
            :ctx
            monoId: ce
        ) then return true
        ei = ei + 1
    }
    return false
}

# unionInlineArmTids -- the payload types a union holds BY VALUE: its inline
# arms'. A cell arm is behind the slot's pointer and orders nothing.
unionInlineArmTids: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    acc: ListVal ztypes.tid
} is {
    ids: ListVal ztypes.tid
    nameIds: ListVal zast.nameid
    variantArmIds :reg :typing :tid :ids :nameIds
    k: u64
    for k < ids.length loop {
        nm: nameIds.get i: k
        if (typing.armIsInline parentTypeId: tid nameId: nm) then acc.append (ids.get i: k)
        k = k + 1
    }
}

# isValueSumMono -- an optionval or resultval instance.
isValueSumMono: function {
    reg: ztypes.ZTypeRegistry.view ctx: Ctx.view tid: ztypes.tid
} out bool is {
    if (originIsTid :reg :tid originTid: (ctx.origins.get i: family.slot.optionval)
    ) then return true
    return (originIsTid :reg :tid originTid: (ctx.origins.get i: family.slot.resultval))
}

# isCollectionPassMono -- a mono whose C the collection pass writes: a collection,
# an array (the pass writes those first), or a user generic record or variant
# instance.
isCollectionPassMono: function {
    reg: ztypes.ZTypeRegistry.view ctx: Ctx.view tid: ztypes.tid
} out bool is {
    co: originTidOf :reg :tid
    if co.isZero then return false
    if (isCollectionOriginTid :ctx originTid: co) then return true
    if (originFamilyOf :ctx originTid: co) == family.slot.fixedArray then return true
    tt: reg.typetypeOf typeId: tid
    if (isUserGenericRecordMono :reg :ctx tcl: tid :tt) then return true
    isValMono: (
        (originIsTid :reg :tid originTid: (ctx.origins.get i: family.slot.optionval)) or
        (originIsTid :reg :tid originTid: (ctx.origins.get i: family.slot.resultval))
    )
    return (isUserGenericVariantMono :reg :ctx tcl: tid :tt :isValMono)
}

# userDefnRefsUnemitted -- does the user type have a by-value field whose type is
# in `group` but not yet in `emitted`? Map/Set fields are heap pointers in the
# port (fwd-decl suffices) so they impose no ordering edge; a UNION's cell arms
# are behind its pointer, and only its inline arms (unionInlineArmTids) are held
# by value. Passing an empty `emitted` answers the plain "references any group
# member" question used by the late-type closure.
userDefnRefsUnemitted: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    typeId: ztypes.tid
    group: (IdSet ztypes.tid).view
    emitted: (IdSet ztypes.tid).view
} out bool is {
    tt: reg.typetypeOf :typeId
    fids: ListVal ztypes.tid
    if tt == ztypes.ztypetype.unionType then {
        unionInlineArmTids :reg :typing tid: typeId acc: fids
    } else if tt == ztypes.ztypetype.variantType then {
        fidsNm: ListVal zast.nameid
        variantArmIds :reg :typing tid: typeId ids: fids nameIds: fidsNm
    } else if tt == ztypes.ztypetype.facetType then {
        # a facet's ordering edges are its implementing impls (embedded by
        # value in the data union), not record fields
        facetImplTids :reg :typing tid: typeId acc: fids
    } else {
        fidsNm: ListVal zast.nameid
        recFieldIds :reg :typing tid: typeId ids: fids nameIds: fidsNm
    }
    for each fid: fids loop {
        cfid: chaseAggregateTypedef :reg :typing :ctx tid: fid
        skip: isHeapPtrCollection :reg :typing :ctx tid: fid
        if skip.not when (group.has item: cfid) when (emitted.has item: cfid).not then return true
    }
    return false
}

# monoLateDepsMet -- every late-group member the mono references by value is
# already emitted (so the mono can be emitted now).
monoLateDepsMet: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    monoId: ztypes.tid
    group: IdSet ztypes.tid
    emitted: IdSet ztypes.tid
    seen: ListVal ztypes.tid
} out bool is {
    if (seen.contains item: monoId) then return true
    seen.append monoId
    elems: ListVal ztypes.tid
    monoElemIdsOf :reg :typing :ctx :monoId acc: elems
    for each eid: elems loop {
        ceid: chaseAggregateTypedef :reg :typing :ctx tid: eid
        if (group.has item: ceid) when (emitted.has item: ceid).not then return false
        emo: originTidOf :reg tid: ceid
        if emo.notZero when (
            monoLateDepsMet
            :ast
            :reg
            :typing
            :ctx
            monoId: ceid
            :group
            :emitted
            :seen
        ).not then return false
    }
    return true
}

# emitUserTypeById -- emit one user RECORD/CLASS/UNION/VARIANT/PROTOCOL struct by
# id, with ctx.mainName set to its defining unit (cross-unit create macros and
# resolution read it). Idempotent via ctx.emittedUserTypes inside each emitter.
emitUserTypeById: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    if (reg.typeValid :tid).not then return
    duo: definedInUnitName :reg :typing :tid
    sm: ctx.mainName.copy
    smD: ctx.mainUnitId
    if duo.length > 0 then (
        ctxBindMain
        :ctx
        name: duo
        unitDecl: (ztypecheck.unitDeclOfTid :reg :typing :tid)
    )
    tt: reg.typetypeOf typeId: tid
    if tt == ztypes.ztypetype.variantType then emitOneVariant :ast :reg :typing :ctx :tid :buf
    if tt == ztypes.ztypetype.recordType then emitOneRecord :ast :reg :typing :ctx :tid :buf
    if tt == ztypes.ztypetype.classType then emitOneRecord :ast :reg :typing :ctx :tid :buf
    if tt == ztypes.ztypetype.unionType then emitUnionMono :ast :reg :typing :ctx :tid :buf
    if tt == ztypes.ztypetype.protocolType then {
        emitOneProtocol :ast :reg :typing :ctx :tid :buf
    }
    if tt == ztypes.ztypetype.facetType then {
        emitOneFacet :ast :reg :typing :ctx :tid :buf
    }
    ctxBindMain :ctx name: sm.stringView unitDecl: smD
}

# emitMonoById -- emit one late collection/variant mono by id (dispatch on origin).
emitMonoById: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    buf: String.borrow
} is {
    if (originIsTid :reg tid: monoId originTid: (ctx.origins.get i: family.slot.optionval)) then {
        emitOneVariant :ast :reg :typing :ctx tid: monoId :buf
        return
    }
    if (originIsTid :reg tid: monoId originTid: (ctx.origins.get i: family.slot.resultval)) then {
        emitOneVariant :ast :reg :typing :ctx tid: monoId :buf
        return
    }
    if (isListViewOriginOf :reg :ctx tid: monoId) then {
        emitListViewMono :ast :reg :typing :ctx :monoId :buf
        return
    }
    if (originIsTid :reg tid: monoId originTid: (ctx.origins.get i: family.slot.spanVal)) then {
        emitSpanMono :ast :reg :typing :ctx :monoId :buf
        return
    }
    if (originIsTid :reg tid: monoId originTid: (ctx.origins.get i: family.slot.fixedArray)) then {
        emitArrayMono :ast :reg :typing :ctx :monoId :buf
        return
    }
    if (isListOriginOf :reg :ctx tid: monoId) then {
        emitListMono :ast :reg :typing :ctx :monoId :buf
        return
    }
    if (staticListValueFamilyOf :reg :ctx tid: monoId).notZero then {
        emitStaticListMono :ast :reg :typing :ctx :monoId :buf
        return
    }
    if (isSetOriginOf :reg :ctx tid: monoId) then {
        emitSetMono :ast :reg :typing :ctx :monoId :buf
        return
    }
    if (isMapOriginOf :reg :ctx tid: monoId) then {
        emitMapMono :ast :reg :typing :ctx :monoId :buf
        return
    }
    if (isIdSetOriginOf :reg :ctx tid: monoId) then {
        emitIdSetMono :ast :reg :typing :ctx :monoId :buf
        return
    }
    if (isIdMapOriginOf :reg :ctx tid: monoId) then {
        emitIdMapMono :ast :reg :typing :ctx :monoId :buf
        return
    }
    tr: tmplClassRowOf :reg :ctx tid: monoId
    if tr > 0 then emitTmplClassMono :ast :reg :typing :ctx :monoId row: tr - 1 :buf
}

# tmplClassRowOf -- the ClassRow whose template writes `tid`: an instance
# of a generic templated class, or a non-generic class with a template of its
# own; as its index plus one, 0 when `tid` is neither
tmplClassRowOf: function {reg: ztypes.ZTypeRegistry.view ctx: Ctx.view tid: ztypes.tid} out u64 is {
    if tid.isZero then return 0
    o: originTidOf :reg :tid
    if o.isZero then {
        if (reg.isGenericOf :tid) then return 0
        o = tid
    }
    return (tmplRowOfClass :ctx cls: o)
}

# tmplRowOfClass -- the ClassRow with a template that the class `cls` (a
# generic template, or a class of its own) declares, as its index plus one; 0
# when it has none
tmplRowOfClass: function {ctx: Ctx.view cls: ztypes.tid} out u64 is {
    if cls.isZero then return 0
    ri: u64
    for ri < ctx.classRows.length loop {
        if (ctx.classRowTids.get i: ri) == cls when (
            (ctx.classRows.get i: ri).tmpl.length > 0
        ) then return ri + 1
        ri = ri + 1
    }
    return 0
}

# tmplAnswerOf -- the type method `mnId` of the templated instance `inst`
# answers, as the instance sees it (ownSignatureTid): 0 when nothing uses the
# method on the instance
tmplAnswerOf: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    inst: ztypes.tid
    mnId: zast.nameid
} out ztypes.tid is {
    mt: (typing.declChildOfId parentTypeId: inst nameId: mnId).or d: ztypes.tid.zero
    if mt.isZero then return mt
    return (ownSignatureTid :reg tid: (reg.returnTypeOf tid: mt))
}

# tmplArgOf -- the type parameter `pid` of the templated instance `inst`'s
# method `mnId` takes, as the instance sees it (ownSignatureTid)
tmplArgOf: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    inst: ztypes.tid
    mnId: zast.nameid
    pid: zast.nameid
} out ztypes.tid is {
    mt: (typing.declChildOfId parentTypeId: inst nameId: mnId).or d: ztypes.tid.zero
    if mt.isZero then return mt
    pt: (typing.declChildOfId parentTypeId: mt nameId: pid).or d: ztypes.tid.zero
    return (ownSignatureTid :reg tid: pt)
}

# ownSignatureTid -- a type a method's signature names, as the instance that
# owns the method sees it: the type itself. 0 for one still spelled over a
# template's parameters: the method is the template's own, and nothing has
# used it on the instance (the checker gives an instance its own function for a
# native method at the method's first use, and for `create` from the start).
ownSignatureTid: function {reg: ztypes.ZTypeRegistry.view tid: ztypes.tid} out ztypes.tid is {
    if tid.isZero then return tid
    if (reg.typetypeOf typeId: tid) == ztypes.ztypetype.genericParam then return ztypes.tid.zero
    return tid
}

# answerKeys -- bind each `@@OUT.<method>@@` and `@@ARG.<method>.<param>@@`
# in a class template: the C name of the type the instance's method answers
# (tmplAnswerOf) or takes as that parameter (tmplArgOf), which a template needs
# to build an answer of another templated class or a mono, or to read an
# argument of one; `@@SOME.<method>@@` / `@@NONE.<method>@@` name a function
# building the option the method answers (optionHelper). A hole whose type the program does not have is left in
# place, and the function spelling it is dropped (dropUnmadeFns): nothing
# calls it.
answerKeys: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the template
    id: rtid
    # the keys bound so far, added to
    keys: RtKeys
    inst: ztypes.tid
    # the instance's C name
    nm: StringView
    # where an option helper is written, ahead of the template
    buf: String.borrow
} is {
    names: List String
    ctx.rt.keyNames :id :names
    for each hole: names loop {
        if (rtKeyBound :ctx :keys name: hole.stringView) then continue
        ht: holeText :ast :reg :typing :ctx :inst :nm hole: hole.stringView :buf
        if ht.length > 0 then rtKey :ctx :keys name: hole.stringView val: ht.stringView
    }
}

# holeText -- what an answer hole (answerKeys) becomes: an option
# helper's name, or the C name of the type it names; "" when the program does
# not have the type
holeText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    inst: ztypes.tid
    nm: StringView
    hole: StringView
    buf: String.borrow
} out String is {
    oh: optionHelper :ast :reg :typing :ctx :inst :nm :hole :buf
    if oh.length > 0 then return oh
    sl: slotHole :ast :reg :typing :ctx :inst :hole
    if sl.length > 0 then return sl
    ht: tmplHoleType :ast :reg :typing :ctx :inst :hole
    if ht.isZero then return "".string
    return (cbaseNoPrefix :ctx tid: ht)
}

# slotHole -- a `SLOT.<method>.<param>.<member>` hole: the vtable slot through
# which a value of the protocol type the instance's method `<method>` takes as
# `<param>` calls its member `<member>` (`b->task.vtable->@@SLOT.create.task.call@@`);
# "" for any other hole
slotHole: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    inst: ztypes.tid
    hole: StringView
} out String is {
    so: hole.stripPrefix p: "SLOT."
    match (
        so
    ) case some then {
        parts: List String
        for each w: (so.split sep: ".") loop parts.append w.string
        if parts.length != 3 then return "".string
        mid: tmplHoleNameId :ast text: (parts.get i: 0).stringView
        pid: tmplHoleNameId :ast text: (parts.get i: 1).stringView
        memb: tmplHoleNameId :ast text: (parts.get i: 2).stringView
        if mid.isZero or pid.isZero or memb.isZero then return "".string
        pt: tmplArgOf :reg :typing :inst mnId: mid :pid
        if (tmplTypeMade :reg :typing :ctx tid: pt).not then return "".string
        return (memberC :ast :reg :typing :ctx owner: pt kind: memberkind.slot nameId: memb)
    } case none then {
        return "".string
    }
}

# optionHelper -- a `SOME.<method>` or `NONE.<method>` hole: the name of a
# function building the option `<method>` answers, some over its one argument
# or none, written to `buf` the first time it is named. "" for any other hole,
# and when the program never made the option (the function naming it is
# dropped).
optionHelper: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    inst: ztypes.tid
    nm: StringView
    hole: StringView
    buf: String.borrow
} out String is {
    isSome: hole.startsWith prefix: "SOME."
    if isSome.not when (hole.startsWith prefix: "NONE.").not then return "".string
    mn: hole.substring from: 5 to: hole.length
    mid: tmplHoleNameId :ast text: mn
    if mid.isZero then return "".string
    opt: tmplAnswerOf :reg :typing :inst mnId: mid
    if (tmplTypeMade :reg :typing :ctx tid: opt).not then return "".string
    oc: cbaseNoPrefix :ctx tid: opt
    decl: optionDeclC :reg :ctx :opt
    if isSome.not then {
        fnn: "z_\{nm}_none_\{mn}"
        if (buf.contains needle: "\{fnn}(void)").not then {
            body: optionNoneC :ast :reg :typing :ctx :opt ind: "    "
            buf.append "static z_\{oc}_t \{fnn}(void) {\n    \{decl}\n\{body}    return _r;\n}\n"
        }
        return fnn
    }
    fns: "z_\{nm}_some_\{mn}"
    if (buf.contains needle: "\{fns}(").not then {
        pt0: (
            cTypeForNameTid
            :ast
            :reg
            :typing
            :ctx
            tid: (reg.genericTypeArgAt specId: opt ordinal: 0)
        )
        body: optionSomeC :ast :reg :typing :ctx :opt valT: pt0.stringView value: "v" ind: "    "
        buf.append "static z_\{oc}_t \{fns}(\{pt0} v) {\n    \{decl}\n\{body}    return _r;\n}\n"
    }
    return fns
}

# tmplHoleType -- the type an `OUT.<method>` or `ARG.<method>.<param>` hole
# names for the instance `inst`; 0 for another hole, and for a type the
# program does not have (tmplTypeMade)
tmplHoleType: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    inst: ztypes.tid
    hole: StringView
} out ztypes.tid is {
    isOut: hole.startsWith prefix: "OUT."
    if isOut.not when (hole.startsWith prefix: "ARG.").not then return ztypes.tid.zero
    rest: hole.substring from: 4 to: hole.length
    d2: (rest.indexOf needle: ".").or d: rest.length
    mid: tmplHoleNameId :ast text: (rest.substring from: 0 to: d2)
    if mid.isZero then return ztypes.tid.zero
    t: ztypes.tid
    if isOut when d2 == rest.length then t = tmplAnswerOf :reg :typing :inst mnId: mid
    if isOut.not when d2 < rest.length then {
        pid: tmplHoleNameId :ast text: (rest.substring from: d2 + 1 to: rest.length)
        if pid.notZero then t = tmplArgOf :reg :typing :inst mnId: mid :pid
    }
    if (tmplTypeMade :reg :typing :ctx tid: t).not then return ztypes.tid.zero
    return t
}

# tmplHoleNameId -- a name a template hole spells, as the program interned
# it; 0 when no declaration uses it
tmplHoleNameId: function {ast: Ast.view text: StringView} out zast.nameid is {
    return (zast.poolFind pool: ast.names :text)
}

# tmplTypeMade -- the program has the type `tid`: a non-generic templated
# class only when the program makes one (tmplClassInProgram); any other type
# once it exists
tmplTypeMade: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx.view tid: ztypes.tid
} out bool is {
    if tid.isZero then return false
    if (originTidOf :reg :tid).notZero then return true
    if (tmplClassRowOf :reg :ctx :tid) == 0 then return true
    return (tmplClassInProgram :reg :typing tpl: tid)
}

# rtFillPieced -- a class template's text `id` with the keys `keys` binds
# filled and its unmade functions dropped (dropUnmadeFns), its member sections
# kept as sections: each stretch between and in them is filled apart
rtFillPieced: function {ctx: Ctx.view id: rtid keys: RtKeys.view} out PiecedText is {
    x: newPiecedText
    hd: (ctx.rt.heads.get i: id).copy
    total: (ctx.rt.texts.get i: id).length
    inf: ctx.rt.infos.get i: id
    pos: u64
    j: inf.pieceFrom
    for j < inf.pieceTo loop {
        pc: ctx.rt.pieces.get i: j
        j = j + 1
        (
            x.plainLines
            text: (
                dropUnmadeFns
                text: (rtFillKeysSpan :ctx :id :keys from: pos to: pc.at).stringView
            ).stringView
        )
        (
            x.namedLines
            name: (hd.stringView.substring from: pc.headFrom to: pc.nameTo)
            needs: (hd.stringView.substring from: pc.needsFrom to: pc.needsTo)
            row: pc.row
            reached: (hd.stringView.substring from: pc.reachedFrom to: pc.reachedTo)
            text: (
                dropUnmadeFns
                text: (rtFillKeysSpan :ctx :id :keys from: pc.bodyFrom to: pc.bodyTo).stringView
            ).stringView
        )
        pos = pc.next
    }
    (
        x.plainLines
        text: (dropUnmadeFns text: (rtFillKeysSpan :ctx :id :keys from: pos to: total).stringView
        ).stringView
    )
    return x
}

# rtFillKeysSpan -- rtFillKeys for bytes `from` to `to` of text `id`
rtFillKeysSpan: function {
    ctx: Ctx.view id: rtid keys: RtKeys.view from: u64 to: u64
} out String is {
    buf: String
    fails: List String
    (
        ctx.rt.fillSpan
        :id
        :from
        :to
        :keys
        bindIds: ListVal zast.nameid
        bindVals: List String
        rawIds: ListVal zast.nameid
        rawVals: List String
        holes: false
        path: ""
        :fails
        :buf
    )
    return buf
}

# dropUnmadeFns -- a class template without the functions that still spell a
# hole (answerKeys leaves those whose type the program does not have):
# each runs from its `static ...) {` line to the `}` closing it at the start of
# a line
dropUnmadeFns: function {text: StringView} out String is {
    res: String
    fn: String
    inFn: false
    for each ln: text.lines loop {
        if (
            (ln.startsWith prefix: "static ") and (ln.trimEnd.endsWith suffix: ") {")
        ) then inFn = true
        if inFn then {
            fn.append ln
            fn.append "\n"
            if (ln.startsWith prefix: "}") then {
                if (fn.contains needle: "@@").not then res.append fn
                fn = "".string
                inFn = false
            }
        } else {
            res.append ln
            res.append "\n"
        }
    }
    res.append fn
    return res
}

# memberKeys -- bind each `@@<param>.<member>@@` in a class template to the C
# name of the function the argument type `arg` declares as `member`, which the
# template calls with the receiver by pointer (`@@T.call@@(&b->task)`). A
# template only names members its parameter's bound requires, and implementation
# to a bound is declared, so the function is emitted. A member `arg` lacks is
# reported, not left as a hole.
memberKeys: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the template
    id: rtid
    # the keys bound so far, added to
    keys: RtKeys
    param: StringView
    arg: ztypes.tid
} is {
    open: "\{param}."
    names: List String
    ctx.rt.keyNames :id :names
    for each key: names loop {
        kv: key.stringView
        if (kv.startsWith prefix: open).not then continue
        if (rtKeyBound :ctx :keys name: kv) then continue
        mname: (kv.substring from: open.length to: kv.length).string
        mid: zast.poolFind pool: ast.names text: mname.stringView
        fid: ztypes.tid
        if mid.notZero then fid = (
            (typing.declChildOfId parentTypeId: arg nameId: mid).or
            d: ztypes.tid.zero
        )
        fc: spelledCname :ctx tid: fid
        if fid.isZero or (fc.length == 0) then {
            m: "a class template calls the member '\{mname}' of its parameter, which the argument does not declare"
            emitFail :ctx what: m line: 0
            fc = "0".string
        }
        rtKey :ctx :keys name: kv val: fc.stringView
    }
}

# templateParamArgs -- each type parameter of `template` by name, beside the
# type argument `mono` bound it to, in declaration order (the order arguments
# bind in)
templateParamArgs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    template: ztypes.tid
    mono: ztypes.tid
    names: List String
    tids: ListVal ztypes.tid
} is {
    td: typing.declIdOfType typeId: template
    if td.isZero then return
    pns: reg.genericParamNamesOf tdecl: td
    k: u64
    for k < pns.length loop {
        names.append (zast.nameTextCopy :ast ref: (pns.get i: k))
        tids.append (reg.genericTypeArgAt specId: mono ordinal: k)
        k = k + 1
    }
}

# emitTmplClassMono -- an instance of a generic native class, or a non-generic
# native class, from the C template its row names: @@NAME@@ is the C name, and
# for each type parameter P, @@P@@ is the C type of the argument as a slot holds
# it and @@P_DESTROY@@ the name of a function `void (P* x)` destroying one in
# place, written ahead of the template where a kept section names it; @@P0@@ / @@P0_DESTROY@@ name the same
# by position. A runtime fragment's own `@Name@` holes
# fill as a fragment's do.
emitTmplClassMono: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    monoId: ztypes.tid
    # the class row, by index
    row: u64
    buf: String.borrow
} is {
    tf: (ctx.classRows.get i: row).tmpl.copy
    p: tmplKey :ctx name: tf.stringView
    ti: tmplTextOf :ctx key: p
    if (rtEmpty :ctx id: ti) then return
    nm: cbaseNoPrefix :ctx tid: monoId
    kt: RtKeys.create
    rtKey :ctx keys: kt name: "NAME" val: nm.stringView
    if (rtSpellsKey :ctx id: ti name: "String") then preludeNeed :ctx memb: "@String_t"
    if (rtSpellsKey :ctx id: ti name: "StringView") then preludeNeed :ctx memb: "@StringView_t"
    strC: ctx.strC.copy
    svC: ctx.svC.copy
    rtKey :ctx keys: kt name: "String" val: strC.stringView
    rtKey :ctx keys: kt name: "StringView" val: svC.stringView
    tpl: originTidOf :reg tid: monoId
    pNames: List String
    pTids: ListVal ztypes.tid
    templateParamArgs :ast :reg :typing template: tpl mono: monoId names: pNames tids: pTids
    # each parameter's in-place destructor, written only where a kept section
    # names it (below)
    dfns: List String
    dts: ListVal ztypes.tid
    k: u64
    for k < pNames.length loop {
        pn: (pNames.get i: k).copy
        at: pTids.get i: k
        sc0: slotCType :ast :reg :typing :ctx tid: at
        sc: ctypeOrI64 s: sc0.stringView
        rtKey :ctx keys: kt name: pn.stringView val: sc.stringView
        dfn: "z_\{nm}_destroy_\{pn}"
        dfns.append dfn.copy
        dts.append at
        dk: "\{pn}_DESTROY"
        rtKey :ctx keys: kt name: dk.stringView val: dfn.stringView
        # by position too, so one template serves classes that name their
        # parameter differently (Channel's T, ChannelVal's t)
        pk: "P\{k}"
        rtKey :ctx keys: kt name: pk.stringView val: sc.stringView
        pdk: "P\{k}_DESTROY"
        rtKey :ctx keys: kt name: pdk.stringView val: dfn.stringView
        # 1 when the argument is `null`, which a slot holds as a placeholder:
        # a template must not store what a call answering nothing gives
        isNull: "0"
        if (reg.typetypeOf typeId: at) == ztypes.ztypetype.nullType then isNull = "1"
        nk: "\{pn}_NULL"
        rtKey :ctx keys: kt name: nk.stringView val: isNull
        pnk: "P\{k}_NULL"
        rtKey :ctx keys: kt name: pnk.stringView val: isNull
        memberKeys :ast :typing :ctx id: ti keys: kt param: pn.stringView arg: at
        k = k + 1
    }
    # the option builders its answer holes name, kept apart until the sections
    # the program writes are known
    ab: String
    answerKeys :ast :reg :typing :ctx id: ti keys: kt inst: monoId nm: nm.stringView buf: ab
    made: rtFillPieced :ctx id: ti keys: kt
    # the members written C calls, and those they need (rtSectionPlan), in this
    # instance's own text, parsed once; what is left in it is a runtime
    # fragment's own holes, every one bound: a type by canon, a tag constant, a
    # member
    plan: rtSectionPlan :ctx mono: monoId id: (ctx.rt.parsePieced x: made.take)
    kept: rtFragmentText :ast :reg :typing :ctx :plan all: true key: p
    di: u64
    for di < dfns.length loop {
        dn: (dfns.get i: di).copy
        dat: dts.get i: di
        di = di + 1
        if (kept.stringView.contains needle: dn).not then continue
        dataC: slotCType :ast :reg :typing :ctx tid: dat
        dsc: ctypeOrI64 s: dataC.stringView
        dl: destroyLineC :reg :typing :ctx tid: dat nm: "(*x)" ind: "    "
        buf.append "static void \{dn}("
        buf.append "\{dsc}* x) {\n"
        buf.append dl
        buf.append "    (void)x;\n}\n"
    }
    keepNamedHelpers helpers: ab.stringView kept: kept.stringView :buf
    splitTmplText :ctx text: kept.stringView :buf
}

# keepNamedHelpers -- of `helpers`, functions an instance's holes made (each
# `static <type> <name>(...) {` up to its closing `}` line), those `kept` --
# the instance's text as written -- names.
keepNamedHelpers: function {helpers: StringView kept: StringView buf: String.borrow} is {
    pos: u64
    for pos < helpers.length loop {
        rest: helpers.substring from: pos to: helpers.length
        e: pos + ((rest.indexOf needle: "\n}\n").or d: rest.length - 3) + 3
        fn: helpers.substring from: pos to: e
        pos = e
        op: (fn.indexOf needle: "(").or d: 0
        sp: (fn.substring from: 0 to: op).lastIndexOf needle: " "
        nm: fn.substring from: (sp.or d: 0) + 1 to: op
        if nm.length > 0 when (kept.contains needle: nm) then buf.append fn
    }
}

# splitTmplText -- an instantiated class template, placed so its functions may
# call anything the program defines: the types ahead of its first function are
# written here, then a prototype of each function (a `static ...` line ending in
# ` {`), and the function bodies go after every function's prototype
# (ctx.lateDefs) -- a body calls the element's methods (@@T.call@@), whose
# prototypes come with the program's functions.
splitTmplText: function {ctx: Ctx text: StringView buf: String.borrow} is {
    inFns: false
    for each ln: text.lines loop {
        isFn: (ln.startsWith prefix: "static ") and (ln.trimEnd.endsWith suffix: ") {")
        if isFn then inFns = true
        if inFns then {
            ctx.lateDefs.append ln
            ctx.lateDefs.append "\n"
            if isFn then {
                sig: ln.trimEnd
                buf.append (sig.substring from: 0 to: sig.length - 2)
                buf.append ";\n"
            }
        } else {
            buf.append ln
            buf.append "\n"
        }
    }
    ctx.lateDefs.append "\n"
}

# collectLateMonosKind -- append late monos of one origin to acc. Called in
# kind-priority order so a mono returned by value by another (List.listView ->
# ListView, Map.get -> optionval) is collected, and thus emitted, before it.
collectLateMonosKind: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    originTid: ztypes.tid
    userList: (ListVal ztypes.tid).view
    acc: ListVal ztypes.tid
    last: ztypes.tid
} is {
    tm: ztypes.tid
    for tm < last loop {
        if (originIsTid :reg tid: tm :originTid) when (typeReached :ctx tid: tm) when (
            monoIsLate
            :ast
            :reg
            :typing
            :ctx
            monoId: tm
            :userList
        ) then acc.append tm
        tm = tm.next
    }
}

# fnDeclScopeTid -- the scope a FUNCTION is declared in, as a type id: the
# owning object type for a method, the namespace / subunit type for a nested
# fn, and 0 for a free function at file-unit scope, whose demand is recorded
# under the unit-root key instead. Read from the FUNCTION's own declaration
# parent, never from a member row: a fn-pointer FIELD's type IS the free
# function's type, so a member-row map answers "owned by the struct holding the
# field", which is not where that function's demand lives.
fnDeclScopeTid: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view fid: ztypes.tid
} out ztypes.tid is {
    d: ztypecheck.templateDeclOf :reg :typing tid: fid
    if d.isZero then return ztypes.tid
    p: typing.declParentOf declId: d
    if p.isZero then return ztypes.tid
    ur: ztypecheck.unitDeclOfTid :reg :typing tid: fid
    if p == ur then return ztypes.tid
    return (typing.declTypeOf declId: p)
}

# stdFnRefEmittable -- a FUNCTION worth a reference cname / _ft typedef: one
# this emitter DEFINES. A native routes through the declaration-driven call
# emitter and has no id-cname definition, and an undemanded body carries no
# stamps. Both are facts about the DECLARATION. Answering `true` outright when
# the declaring unit is not on a six-name list makes an ordinary user record's C
# depend on whether its file is called `cli.z`.
stdFnRefEmittable: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    fid: ztypes.tid
} out bool is {
    ud: ztypecheck.unitDeclOfTid :reg :typing tid: fid
    if ud.isZero then return false
    if (reg.isNativeOf tid: fid) then return false
    fd: typing.declIdOfType typeId: fid
    if fd.isZero then return false
    return (
        fnUndemanded
        :ast
        :typing
        unitDecl: ud
        nameId: (typing.decls.get i: fd).name
        ownerTid: (fnDeclScopeTid :reg :typing :fid)
        wantWalked: false
    ).not
}

# fnptrTypedefEligible -- a FUNCTION type worth a `_ft` typedef: a real spec /
# free function / method whose C this emitter writes. Synthetic create/==/!=
# carry no declaration; generic templates are skipped, and an instance's
# function unless the instance holds it in a field.
fnptrTypedefEligible: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
} out bool is {
    if (reg.isGenericOf :tid) then return false
    mo: originTidOf :reg :tid
    if mo.notZero then return (instanceFnField :reg :typing :tid)
    if (signatureNamesTemplate :reg :typing :tid) then return false
    return (stdFnRefEmittable :ast :reg :typing fid: tid)
}

# instanceFnField -- `tid` is the function a generic type's instance holds in
# a field: the instance's own copy of a function its template writes in the
# `is` section. Its struct names the function's type, so it needs the typedef.
instanceFnField: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view tid: ztypes.tid
} out bool is {
    owner: reg.ownerTidOf :tid
    if owner.isZero or (reg.isPartialOf tid: owner) then return false
    fd: typing.declIdOfType typeId: tid
    if fd.isZero then return false
    return (typing.declIsFnptrFieldId parentTypeId: owner nameId: (typing.decls.get i: fd).name)
}

# signatureNamesTemplate -- a function whose return or a parameter is a generic
# TEMPLATE (a generic unit's function over a type the unit declares) is the
# template's own; its instances carry the concrete signature.
signatureNamesTemplate: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view tid: ztypes.tid
} out bool is {
    rt: reg.returnTypeOf :tid
    if rt.notZero when (reg.isGenericOf tid: rt) then return true
    pi: u64
    pn: typing.declRowSlots ownerTid: tid
    for pi < pn loop {
        pr: typing.declRowAt ownerTid: tid membersOnly: true slot: pi
        pi = pi + 1
        if pr.keep when (reg.isGenericOf tid: pr.tid) then return true
    }
    return false
}

# fnptrRetTypeC -- the C return type of function `tid`'s `_ft` typedef; `void`
# when it returns nothing.
fnptrRetTypeC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} out String is {
    rtid: reg.returnTypeOf :tid
    if rtid.isZero then return "void".string
    baseC: String
    if rtid == ctx.strTid then {
        baseC = strTypeC :ctx
    }
    if baseC.length == 0 when rtid == ctx.svTid then {
        baseC = svTypeC :ctx
    }
    if baseC.length == 0 then {
        rc: scalarCTypeFor :typing tid: rtid
        if rc.length > 0 then baseC = rc.take
    }
    if baseC.length == 0 then {
        rr: typeRefC :ast :reg :typing :ctx tid: rtid
        if rr.length > 0 then baseC = rr.take
    }
    if baseC.length == 0 then baseC = "int64_t".string
    # the typedef names the SIGNATURE, so it takes the same two promotions
    # fnSignature applies: a Map/Set return is a heap pointer, and a
    # reference-returning one hands back an address. They are mutually
    # exclusive -- fnReturnsRefBorrow declines a heap-pointer collection.
    if (isHeapPtrCollection :reg :typing :ctx tid: rtid) then {
        bs9: "\{baseC}*"
        baseC = bs9.take
    }
    if (fnReturnsRefBorrow :reg :typing :ctx fid: tid retTid: rtid) then {
        basePtr: refPtrC :typing :tid base: baseC.stringView
        baseC = basePtr.take
    }
    return baseC
}

# fnptrParamTypeC -- C type for one param of a FUNCTION's `_ft` typedef, applying
# the same pointer promotions as fnSignature so the typedef matches the emitted
# signature.
fnptrParamTypeC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
    pnameId: zast.nameid
    pid: ztypes.tid
} out String is {
    ct: typeRefC :ast :reg :typing :ctx tid: pid
    ptrp: paramTypeIsPointer :ast :reg :typing :ctx :fid :pnameId :pid
    if ptrp when ct.length > 0 then {
        ctp: "\{ct}*"
        # the same rule as fnSignature: a view is read through, and a
        # function value must match the signatures it is assigned
        if (paramReadsOnly :reg :typing :fid :pnameId :pid) then ctp = "const \{ct}*"
        ct = ctp.take
    }
    if ct.length == 0 then return "int64_t".string
    return ct
}

# ensureFwdStruct -- forward-declare a user record/class referenced by a fnptr
# typedef (a pointer-to-incomplete or uncalled by-value return typedef is legal
# C). Guarded so emitUserStructsOrdered later emits the named struct body.
ensureFwdStruct: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    # the body is already out, so nothing needs declaring ahead of it -- and a
    # forward would CONTRADICT it: a type reaches its body through
    # fwdDeclaredTypes, and one that was not in that set was written as an
    # anonymous `typedef struct { ... } X_t;` with no tag for
    # `typedef struct X_t X_t;` to name. The monos emit before this pass runs.
    if (typeStructEmitted :ctx :tid) then return
    scalarCType: scalarCTypeFor :typing :tid
    if scalarCType.length > 0 then return
    if (definedInUnitTid :reg :typing :tid).notZero when (reg.isNativeOf :tid) then return
    # a typedef wrapper (Path over String) has no struct of its own -- its C
    # spelling is the wrapped type, so a forward struct tag would name nothing
    if (isTypedefType :typing :tid) then return
    tt: reg.typetypeOf typeId: tid
    isStruct: tt.isFieldwise
    if isStruct then {
        strO: ctx.origins.get i: family.slot.str
        arrO: ctx.origins.get i: family.slot.fixedArray
        if (originIsTid :reg :tid originTid: strO) then isStruct = false
        if (originIsTid :reg :tid originTid: arrO) then isStruct = false
    }
    if isStruct when (ctx.fwdDeclaredTypes.has item: tid).not then {
        # a mono is declared on the terms its own pass declares it: an iterator
        # cursor is an anonymous typedef no forward declaration can name, and a
        # Box is a pointer. An instance of a user's own generic type is declared
        # as a type a unit declares is: its body is written after this pass
        mo: originTidOf :reg :tid
        if mo.notZero when (isUserInstance :reg :ctx tcl: tid).not then {
            emitMonoFwdDecl :reg :typing :ctx :tid origin: mo :buf
            return
        }
        cn: spelledCname :ctx :tid
        ctx.fwdDeclaredTypes.add item: tid
        l0: "typedef struct \{cn}_t \{cn}_t;\n"
        buf.append l0
    }
}

# fwdTaggedSpec -- a protocol, a facet or a non-ordinal variant: a struct the
# emitter writes as an anonymous typedef unless the type was forward-declared,
# in which case the body is the tagged `struct X_t { ... };` a forward
# declaration can name. An ORDINAL variant is its own discriminator, a plain
# scalar with nothing to declare.
fwdTaggedSpec: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view tid: ztypes.tid
} out bool is {
    tt: reg.typetypeOf typeId: tid
    if tt.isInterface then return true
    if tt != ztypes.ztypetype.variantType then return false
    return (isOrdinalVariant :typing :tid).not
}

# fwdDeclareSpec -- a protocol, facet or variant in a fnptr signature, not yet
# written: `typedef struct X_t X_t;`, once, so its emitter writes the tagged
# body the declaration names. A native type's C is the runtime's.
fwdDeclareSpec: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    if (fwdTaggedSpec :reg :typing :tid).not then return
    if (typeStructEmitted :ctx :tid) then return
    if (ctx.fwdDeclaredTypes.has item: tid) then return
    if (reg.isNativeOf :tid) then return
    cn: spelledCname :ctx :tid
    ctx.fwdDeclaredTypes.add item: tid
    l0: "typedef struct \{cn}_t \{cn}_t;\n"
    buf.append l0
}

# isComplexFnptrParam -- a PROTOCOL/FACET/UNION/VARIANT type a by-value fnptr
# param or return cannot name: one that is neither written yet nor declared
# ahead. ensureFwdStruct declares the specs and variants and the main forward
# pass the unions, so this is the guard for a type neither reached.
#
# An ORDINAL variant is the exception, and `bool` is one: the value IS its own
# discriminator, so it reaches the C as a plain scalar with nothing to forward
# declare. Without this leg every signature mentioning a bool -- as a parameter
# OR as the return -- lost its `_ft` typedef while the struct field kept using
# the name, and the C had no such type.
isComplexFnptrParam: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    ct: tid
    can: tid
    if can.notZero then ct = can
    if (isOrdinalVariant :typing tid: ct) then return false
    tt: reg.typetypeOf typeId: ct
    isAgg: tt.isInterface or tt.isSum
    if isAgg.not then return false
    if (typeStructEmitted :ctx tid: ct) then return false
    return (isFwdDeclared :ctx tid: ct).not
}

# emitOneFnptrTypedef -- emit one `typedef RET (*<cname>_ft)(PARAMS);`,
# dependency-first (fnptr-typed params emitted before this one) with referenced
# structs forward-declared. `seen` dedupes by tid.
emitOneFnptrTypedef: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    seen: ListVal ztypes.tid
    fnOwner: (IdMapV ztypes.tid v: ztypes.tid)
    buf: String.borrow
} is {
    if (seen.contains item: tid) then return
    seen.append tid
    pIds: ListVal ztypes.tid
    pIdsNm: ListVal zast.nameid
    recFieldIds :reg :typing :tid ids: pIds nameIds: pIdsNm
    # A method's `this` receiver is the owner: the typedef takes the owner's id
    # so it matches the method's emitted signature. Never matched by name, which
    # can land on an unrelated same-named type (a stdlib generic template).
    ownT: ztypes.tid
    fno: fnOwner.get key: tid
    if fno.some then {
        ownT = fno
    }
    rIds: ListVal ztypes.tid
    ri: u64
    rn: pIds.length
    for ri < rn loop {
        rpv: pIds.get i: ri
        if ownT.notZero then {
            isRecv: ((pIdsNm.get i: ri) == zast.wellKnown.slot.wkThis) or (rpv == ownT)
            if isRecv then rpv = ownT
        }
        rIds.append rpv
        ri = ri + 1
    }
    srt: reg.returnTypeOf :tid
    # a spec or a variant in the signature is declared by its tag before the
    # test below asks whether the typedef can name it
    fj: u64
    for fj < rIds.length loop {
        fwdDeclareSpec :reg :typing :ctx tid: (rIds.get i: fj) :buf
        fj = fj + 1
    }
    if srt.notZero then fwdDeclareSpec :reg :typing :ctx tid: srt :buf
    skipIt: false
    sj: u64
    sn: pIds.length
    for sj < sn loop {
        spid: rIds.get i: sj
        if (isComplexFnptrParam :reg :typing :ctx tid: spid) then skipIt = true
        sj = sj + 1
    }
    if srt.notZero when (isComplexFnptrParam :reg :typing :ctx tid: srt) then skipIt = true
    if skipIt then return
    di: u64
    dn: pIds.length
    for di < dn loop {
        pidd: rIds.get i: di
        if (reg.typetypeOf typeId: pidd) == ztypes.ztypetype.functionType then {
            emitOneFnptrTypedef :ast :reg :typing :ctx tid: pidd :seen :fnOwner :buf
        }
        ensureFwdStruct :reg :typing :ctx tid: pidd :buf
        di = di + 1
    }
    rtid: reg.returnTypeOf :tid
    if rtid.notZero when (reg.typetypeOf typeId: rtid) == ztypes.ztypetype.functionType then {
        emitOneFnptrTypedef :ast :reg :typing :ctx tid: rtid :seen :fnOwner :buf
    }
    if rtid.notZero then ensureFwdStruct :reg :typing :ctx tid: rtid :buf
    params: String
    pi: u64
    pn: pIdsNm.length
    for pi < pn loop {
        pidp: rIds.get i: pi
        pct: fnptrParamTypeC :ast :reg :typing :ctx fid: tid pnameId: (pIdsNm.get i: pi) pid: pidp
        if pi > 0 then params.append ", "
        params.append pct
        pi = pi + 1
    }
    if pn == 0 then params.append "void"
    retc: fnptrRetTypeC :ast :reg :typing :ctx :tid
    ctx.fnptrWritten.add item: tid
    cb: ctxCnameView :ctx :tid
    line: "typedef \{retc} (*\{cb}_ft)(\{params});\n"
    buf.append line
}

# emitFnptrTypedefs -- one `_ft` typedef per eligible user FUNCTION value-type so
# typeRefC's FUNCTION case (`<cname>_ft`) resolves at struct fields, params,
# locals, and signatures. Emitted before the user structs that embed them.
emitFnptrTypedefs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    buf: String.borrow
} is {
    last: reg.nextTid
    seen: ListVal ztypes.tid
    # method FUNCTION tid -> owning object tid, for receiver-param resolution
    fnOwner: IdMapV ztypes.tid v: ztypes.tid
    {
        rowOwners: ListVal ztypes.tid
        rowNames: ListVal zast.nameid
        rowTids: ListVal ztypes.tid
        (
            typing.declAllMemberRows
            lastTid: reg.nextTid
            owners: rowOwners
            names: rowNames
            tids: rowTids
        )
        fk0: u64
        fn0: rowOwners.length
        for fk0 < fn0 loop {
            fp0: rowOwners.get i: fk0
            fco: rowTids.get i: fk0
            fk0 = fk0 + 1
            if (reg.typetypeOf typeId: fco) == ztypes.ztypetype.functionType then {
                fnKind: reg.typetypeOf typeId: fp0
                isObj: fnKind.isUserFamily
                if isObj then fnOwner.set key: fco value: fp0
                (
                    seedDeclaredFnptr
                    :ast
                    :reg
                    :typing
                    :ctx
                    owner: fp0
                    name: (rowNames.get i: fk0 - 1)
                    tid: fco
                )
            }
        }
    }
    t0: ztypes.tid
    for t0 < last loop {
        if (reg.typetypeOf typeId: t0) == ztypes.ztypetype.functionType when (
            ctx.fnptrDemand.has
            item: t0
        ) when (fnptrTypedefEligible :ast :reg :typing tid: t0) then {
            emitOneFnptrTypedef :ast :reg :typing :ctx tid: t0 :seen :fnOwner :buf
        }
        t0 = t0.next
    }
    emitHashMemberFnptrs :ast :reg :typing :ctx :buf
    ctx.fnptrPassDone = true
}

# emitHashMemberFnptrs -- the `_ft` typedef of each generated `hash` member
# written C names as a value (hashMemberRead): it has no declaration for the
# pass above to read, and emitHashDefs writes it taking its type by pointer.
emitHashMemberFnptrs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    buf: String.borrow
} is {
    for each ru: typing.hashUsed loop {
        r: ru
        fid: hashMemberRead :ast :reg :typing :ctx tid: r
        if fid.isZero or (ctx.fnptrDemand.has item: fid).not then continue
        if (ctx.fnptrWritten.has item: fid) then continue
        ctx.fnptrWritten.add item: fid
        rt: cTypeForNameTid :ast :reg :typing :ctx tid: r
        cb: ctxCnameView :ctx tid: fid
        buf.append "typedef uint64_t (*\{cb}_ft)(const \{rt}*);\n"
    }
}

# seedDeclaredFnptr -- a type's fn-pointer field demands its type's typedef
# where the type is written. A method row is the type's own function, not a
# value it holds, and a method the program never writes is in no C at all
# (fnJobUnwritten), whichever block declares it. A function's parameter seeds
# nothing: a function job's signature is written before the pass and spells its
# parameters, and a written typedef writes its parameters' typedefs first
# (emitOneFnptrTypedef). The type is spelled through typeRefC, which records the
# demand under the id it names.
seedDeclaredFnptr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    owner: ztypes.tid
    name: zast.nameid
    tid: ztypes.tid
} is {
    if (fnJobUnwritten :ctx :tid) then return
    if (reg.typetypeOf typeId: owner) == ztypes.ztypetype.functionType then return
    if (typeReached :ctx tid: owner).not then return
    if (typing.declIsFnptrFieldId parentTypeId: owner nameId: name).not then return
    typeRefC :ast :reg :typing :ctx :tid
}


# userSpecInstance -- an instance of a user's generic protocol or facet: its
# struct and vtable are the program's to write, where the template's
# non-generic siblings are written. A partial names a parameter and is no type
# the C has.
userSpecInstance: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view tid: ztypes.tid
} out bool is {
    tt: reg.typetypeOf typeId: tid
    if tt != ztypes.ztypetype.protocolType when tt != ztypes.ztypetype.facetType then return false
    mo: originTidOf :reg :tid
    if mo.isZero then return false
    if (reg.isPartialOf :tid) then return false
    if (definedInUnitTid :reg :typing tid: mo).isZero then return false
    return (reg.isNativeOf tid: mo).not
}

# emitUserProtocols -- user PROTOCOLs upfront: a protocol value is a fat pointer,
# so nothing embeds one by value and it can precede every struct that names it.
emitUserProtocols: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    last: ztypes.tid
    buf: String.borrow
} is {
    tp: ztypes.tid
    for tp < last loop {
        if (reg.typetypeOf typeId: tp) == ztypes.ztypetype.protocolType then {
            pgen: reg.isGenericOf tid: tp
            pmo: originTidOf :reg tid: tp
            pown: (
                pmo.isZero and
                pgen.not and
                (definedInUnitTid :reg :typing tid: tp).notZero and
                (reg.isNativeOf tid: tp).not
            )
            if pown or (userSpecInstance :reg :typing tid: tp) when (typeReached :ctx tid: tp
            ) then {
                emitUserTypeById :ast :reg :typing :ctx tid: tp :buf
            }
        }
        tp = tp.next
    }
}

# collectLateGroup -- the late collection/variant monos: the by-value kinds that
# embed a user type, and so must follow the user structs. One pass per family.
# The LIST ORDER is the emission order of the group.
collectLateGroup: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    userList: (ListVal ztypes.tid).view
    acc: ListVal ztypes.tid
    last: ztypes.tid
} is {
    fams: ListVal ztypes.tid
    fams.append (ctx.origins.get i: family.slot.fixedArray)
    fams.append (ctx.origins.get i: family.slot.optionval)
    fams.append (ctx.origins.get i: family.slot.resultval)
    fams.append (ctx.origins.get i: family.slot.listView)
    fams.append (ctx.origins.get i: family.slot.listViewVal)
    fams.append (ctx.origins.get i: family.slot.spanVal)
    fams.append (ctx.origins.get i: family.slot.staticList)
    fams.append (ctx.origins.get i: family.slot.listRef)
    fams.append (ctx.origins.get i: family.slot.listVal)
    fams.append (ctx.origins.get i: family.slot.set)
    fams.append (ctx.origins.get i: family.slot.setVal)
    fams.append (ctx.origins.get i: family.slot.map)
    fams.append (ctx.origins.get i: family.slot.mapRV)
    fams.append (ctx.origins.get i: family.slot.idSet)
    fams.append (ctx.origins.get i: family.slot.idMapR)
    fams.append (ctx.origins.get i: family.slot.idMapV)
    fams.append (ctx.origins.get i: family.slot.mapVR)
    fams.append (ctx.origins.get i: family.slot.mapVV)
    fi: u64
    fn: fams.length
    for fi < fn loop {
        collectLateMonosKind :ast :reg :typing :ctx originTid: (fams.get i: fi) :userList :acc :last
        fi = fi + 1
    }
}

# collectTmplClassInstances -- every instance of a templated class, and every
# non-generic templated class the program makes (tmplClassRowOf), in type-id
# order: emitted with the late group, after the user structs an instance may
# hold, whether or not it holds one
collectTmplClassInstances: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    acc: ListVal ztypes.tid
    last: ztypes.tid
} is {
    tm: ztypes.tid
    for tm < last loop {
        if (tmplClassRowOf :reg :ctx tid: tm) > 0 then {
            own: (originTidOf :reg tid: tm).isZero
            if own.not or (tmplClassInProgram :reg :typing tpl: tm) when (typeReached :ctx tid: tm
            ) then {
                acc.append tm
            }
        }
        tm = tm.next
    }
}

# collectLateInstances -- the user instances the late group places, in type-id
# order.
collectLateInstances: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    userList: (ListVal ztypes.tid).view
    acc: ListVal ztypes.tid
    last: ztypes.tid
} is {
    tm: ztypes.tid
    for tm < last loop {
        if (isLateUserInstance :ast :reg :typing :ctx tcl: tm :userList) then acc.append tm
        tm = tm.next
    }
}

# closeLateGroup -- the membership id-set mirroring lateGroup (the list keeps
# emission order), then the closure: a user struct embedding a late-group
# member by value is late too, to a fixpoint.
closeLateGroup: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    userList: (ListVal ztypes.tid).view
    lateGroup: ListVal ztypes.tid
    lateSet: IdSet ztypes.tid
} is {
    for each lv0: lateGroup loop {
        lateSet.add item: lv0
    }
    # closure: a user struct embedding a late-group member by value is late too
    emptySet: IdSet ztypes.tid
    changed: true
    for changed loop {
        changed = false
        for each uid: userList loop {
            if (lateSet.has item: uid).not when (
                userDefnRefsUnemitted
                :reg
                :typing
                :ctx
                typeId: uid
                group: lateSet
                emitted: emptySet
            ) then {
                lateGroup.append uid
                lateSet.add item: uid
                changed = true
            }
        }
    }
}

# emitEarlyUserStructs -- users not in the late group, in type-id order
# (preEmitEmbeddedTypes inside each emitter fixes intra-pass user->user order).
emitEarlyUserStructs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    userList: (ListVal ztypes.tid).view
    lateSet: (IdSet ztypes.tid).view
    buf: String.borrow
} is {
    for each userTid: userList loop {
        if (lateSet.has item: userTid).not then (
            emitUserTypeById
            :ast
            :reg
            :typing
            :ctx
            tid: userTid
            :buf
        )
    }
}

# lateMemberIsMono -- a late-group member its mono family writes: a mono that is
# not a user instance.
lateMemberIsMono: function {
    reg: ztypes.ZTypeRegistry.view ctx: Ctx.view tid: ztypes.tid
} out bool is {
    # a templated class -- an instance of a generic one or a class of its own
    # -- is written from its template as the runtime's monos are
    if (tmplClassRowOf :reg :ctx :tid) > 0 then return true
    if (originTidOf :reg :tid).isZero then return false
    # a static list is the runtime's mono, whatever its element
    if (staticListValueFamilyOf :reg :ctx :tid).notZero then return true
    return (isUserInstance :reg :ctx tcl: tid).not
}

# lateMemberReady -- a late-group member can be written once every member it
# holds by value is: a mono through its elements, a user type or a user
# instance through its fields or arms.
lateMemberReady: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
    group: IdSet ztypes.tid
    emitted: IdSet ztypes.tid
} out bool is {
    if (lateMemberIsMono :reg :ctx :tid) then {
        seen: ListVal ztypes.tid
        return (monoLateDepsMet :ast :reg :typing :ctx monoId: tid :group :emitted :seen)
    }
    return (userDefnRefsUnemitted :reg :typing :ctx typeId: tid :group :emitted).not
}

# emitLateMember -- write one late-group member by its kind.
emitLateMember: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    if (lateMemberIsMono :reg :ctx :tid) then {
        emitMonoById :ast :reg :typing :ctx monoId: tid :buf
        return
    }
    if (isUserInstance :reg :ctx tcl: tid) then {
        emitUserGenericInstance :ast :reg :typing :ctx :tid :buf
        return
    }
    emitUserTypeById :ast :reg :typing :ctx :tid :buf
}

# emitLateGroupOrdered -- the late monos and late-user structs in dependency
# order, by fixpoint. A cycle stops it: two classes that hold Lists of each
# other each wait for the other's List, and each List's bodies wait for its
# element. A List or ListView holds its element only by pointer, so its struct
# and prototypes can come first and its bodies after the element: the stuck
# containers are split that way and the fixpoint runs again. Whatever it still
# cannot place is emitted in list order rather than dropped.
emitLateGroupOrdered: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    lateGroup: (ListVal ztypes.tid).view
    lateSet: IdSet ztypes.tid
    buf: String.borrow
} is {
    emittedSet: IdSet ztypes.tid
    allOut: emitLateFixpoint :ast :reg :typing :ctx :lateGroup :lateSet :emittedSet :buf
    if allOut then return
    bodies: String
    emitStuckContainerHeads :ast :reg :typing :ctx :lateGroup :emittedSet :buf :bodies
    allOut = emitLateFixpoint :ast :reg :typing :ctx :lateGroup :lateSet :emittedSet :buf
    if allOut.not then {
        for each x2: lateGroup loop {
            if (emittedSet.has item: x2).not then {
                emitLateMember :ast :reg :typing :ctx tid: x2 :buf
                emittedSet.add item: x2
            }
        }
    }
    buf.append bodies
}

# emitLateFixpoint -- emit every late member whose dependencies are out, until a
# pass places nothing. True when the whole group is out.
emitLateFixpoint: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    lateGroup: (ListVal ztypes.tid).view
    lateSet: IdSet ztypes.tid
    emittedSet: IdSet ztypes.tid
    buf: String.borrow
} out bool is {
    for true loop {
        progressed: false
        pending: false
        for each x: lateGroup loop {
            if (emittedSet.has item: x) then continue
            if (lateMemberReady :ast :reg :typing :ctx tid: x group: lateSet emitted: emittedSet
            ) then {
                emitLateMember :ast :reg :typing :ctx tid: x :buf
                emittedSet.add item: x
                progressed = true
            } else {
                pending = true
            }
        }
        if pending.not then return true
        if progressed.not then return false
    }
    return false
}

# emitStuckContainerHeads -- each List or ListView mono the fixpoint could not
# place: its struct and prototypes now, which is all a holder needs, and its
# bodies into `bodies`, written once every element is out. It counts as out.
emitStuckContainerHeads: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    lateGroup: (ListVal ztypes.tid).view
    emittedSet: IdSet ztypes.tid
    buf: String.borrow
    bodies: String.borrow
} is {
    for each x: lateGroup loop {
        if (emittedSet.has item: x) then continue
        xt: x
        isList: isListOriginOf :reg :ctx tid: xt
        if isList.not when (isListViewOriginOf :reg :ctx tid: xt).not then continue
        whole: String
        emitMonoById :ast :reg :typing :ctx monoId: xt buf: whole
        splitContainerText text: whole.stringView head: buf rest: bodies
        emittedSet.add item: x
    }
}

# splitContainerText -- a List or ListView mono's C divided at what a holder
# needs: its struct blocks and every one-line prototype go to `head`,
# everything but the struct blocks to `rest`. The struct holds the element by
# pointer, so the head needs it declared only; the bodies index it.
splitContainerText: function {text: StringView head: String.borrow rest: String.borrow} is {
    inStruct: false
    for each ln: text.lines loop {
        opens: (ln.startsWith prefix: "typedef struct ") and (ln.endsWith suffix: "{")
        if opens then inStruct = true
        if inStruct then {
            head.append ln
            head.append "\n"
            if (ln.startsWith prefix: "} ") when (ln.endsWith suffix: ";") then inStruct = false
        } else {
            if (ln.startsWith prefix: "static ") when (ln.endsWith suffix: ");") then {
                head.append ln
                head.append "\n"
            }
            rest.append ln
            rest.append "\n"
        }
    }
}


# emitUserStructsOrdered -- emit user struct defs and the collection monos that
# embed them by value in dependency order, resolving the bidirectional
# constraint: a user record embeds an early (system-element) mono, while a late
# mono embeds a user type. Order: protocols -> early-user structs -> a fixpoint
# interleaving late monos and late-user structs. The early collection monos and
# the system scaffolding are already emitted by emitMonos; this owns user struct
# layout.
emitUserStructsOrdered: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    buf: String.borrow
} is {
    last: reg.nextTid
    userList: ListVal ztypes.tid
    buildUserTypeList :reg :typing :ctx acc: userList
    emitUserProtocols :ast :reg :typing :ctx :last :buf
    lateGroup: ListVal ztypes.tid
    collectLateGroup :ast :reg :typing :ctx :userList acc: lateGroup :last
    collectTmplClassInstances :reg :typing :ctx acc: lateGroup :last
    collectLateInstances :ast :reg :typing :ctx :userList acc: lateGroup :last
    lateSet: IdSet ztypes.tid
    closeLateGroup :reg :typing :ctx :userList :lateGroup :lateSet
    emitEarlyUserStructs :ast :reg :typing :ctx :userList :lateSet :buf
    emitLateGroupOrdered :ast :reg :typing :ctx :lateGroup :lateSet :buf
}

# MonoWork -- the mono worklists that one classification sweep fills and the
# emitters drain. The categories stay NAMED rather than becoming rows of an
# indexed table: the emission order is made of them, and a nested generic
# container is not available anyway.
MonoWork: class {
    # the strings still owed emission
    wStr: ListVal ztypes.tid
    # the boxes still owed emission
    wBox: ListVal ztypes.tid
    # the system variants still owed emission
    wSysVar: ListVal ztypes.tid
    # the valtype monos still owed emission
    wValMono: ListVal ztypes.tid
    # the Option and Result instances still owed emission
    wOptRes: ListVal ztypes.tid
    # the user generic unions still owed emission
    wUgUnion: ListVal ztypes.tid
    # the OptionView instances still owed emission
    wOptView: ListVal ztypes.tid
    # the arrays still owed emission
    wArr: ListVal ztypes.tid
    # the list views still owed emission
    wListView: ListVal ztypes.tid
    # the windows still owed emission
    wSpan: ListVal ztypes.tid
    # the list values still owed emission
    wStaticList: ListVal ztypes.tid
    # the lists still owed emission
    wList: ListVal ztypes.tid
    # the sets still owed emission
    wSet: ListVal ztypes.tid
    # the maps still owed emission
    wMap: ListVal ztypes.tid
    # the IdSets still owed emission
    wIdSet: ListVal ztypes.tid
    # the IdMaps still owed emission
    wIdMap: ListVal ztypes.tid
    # the protocols still owed emission
    wProto: ListVal ztypes.tid
    # the user generic variants still owed emission
    wUgVar: ListVal ztypes.tid
    # the user generic records still owed emission
    wUgRec: ListVal ztypes.tid
}

# classifyCollectionMono -- the option / result / view families and the seven
# collection families, each keyed on the ORIGIN tid its mono was minted from. An
# id compare is what makes this shadow-proof: a user type spelled `ListRef` is not
# this ListRef.
classifyCollectionMono: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    userListM: (ListVal ztypes.tid).view
    tcl: ztypes.tid
    tv: ztypes.tid
    tt: ztypes.ztypetype
    isMono: bool
    isValMono: bool
    work: MonoWork
} out bool is {
    isColKind: false
    isOptRes: (
        (originIsTid :reg tid: tcl originTid: (ctx.origins.get i: family.slot.option)) or
        (originIsTid :reg tid: tcl originTid: (ctx.origins.get i: family.slot.result))
    )
    if isOptRes then work.wOptRes.append tv
    if isMono when tt == ztypes.ztypetype.unionType then {
        ugu: (isOptRes or isValMono).not
        if ugu when (isViewUnionOriginOf :reg :ctx tid: tcl) then ugu = false
        if ugu when (
            isCollectionOriginTid
            :ctx
            originTid: (originTidOf :reg tid: tcl)
        ) then ugu = false
        if ugu then work.wUgUnion.append tv
    }
    if (isViewUnionOriginOf :reg :ctx tid: tcl) then {
        isSv: originIsTid :reg tid: tcl originTid: (ctx.origins.get i: family.slot.staticView)
        if isSv.not or (staticViewReached :reg :typing :ctx tid: tv) then work.wOptView.append tv
    }
    colDst: u64
    if (originIsTid :reg tid: tcl originTid: (ctx.origins.get i: family.slot.fixedArray)) then {
        isColKind = true
        colDst = 1
    }
    if (isListViewOriginOf :reg :ctx tid: tcl) then {
        isColKind = true
        colDst = 2
    }
    if (isListOriginOf :reg :ctx tid: tcl) then {
        isColKind = true
        colDst = 3
    }
    if (isSetOriginOf :reg :ctx tid: tcl) then {
        isColKind = true
        colDst = 4
    }
    if (isMapOriginOf :reg :ctx tid: tcl) then {
        isColKind = true
        colDst = 5
    }
    if (isIdSetOriginOf :reg :ctx tid: tcl) then {
        isColKind = true
        colDst = 6
    }
    if (isIdMapOriginOf :reg :ctx tid: tcl) then {
        isColKind = true
        colDst = 7
    }
    if (originIsTid :reg tid: tcl originTid: (ctx.origins.get i: family.slot.spanVal)) then {
        isColKind = true
        colDst = 8
    }
    if (staticListValueFamilyOf :reg :ctx tid: tcl).notZero then {
        isColKind = true
        colDst = 9
        # a list read only at compile time has its value type minted all the
        # same: its view struct is written only for a list run time reads
        if (staticListReached :typing tid: tv).not then colDst = 0
    }
    if isColKind when (monoIsLate :ast :reg :typing :ctx monoId: tcl userList: userListM).not then {
        if colDst == 1 then work.wArr.append tv
        if colDst == 2 then work.wListView.append tv
        if colDst == 3 then work.wList.append tv
        if colDst == 4 then work.wSet.append tv
        if colDst == 5 then work.wMap.append tv
        if colDst == 6 then work.wIdSet.append tv
        if colDst == 7 then work.wIdMap.append tv
        if colDst == 8 then work.wSpan.append tv
        if colDst == 9 then work.wStaticList.append tv
    }
    return isColKind
}

# staticListReached -- the C names the list type `tid`: run time reads a list
# value of it (a reached list row, constagg.reached), or a parameter, a field
# or an arm is declared with it. The type a list constant is declared with is
# minted for the constant alone, and a list read only at compile time names it
# nowhere else.
staticListReached: function {typing: ztyping.ZTyping.view tid: ztypes.tid} out bool is {
    for each g: typing.constAggs loop {
        if g.reached when g.kind.staticList when g.tid == tid then return true
    }
    d: u64
    for d < typing.decls.length loop {
        dd: typing.decls.get i: (ztypes.declid.create from: d)
        d = d + 1
        if dd.typeId == tid then {
            k: dd.kind
            if k.fieldDecl or k.armDecl then return true
            # the instance's own methods take it as `this`: no other use
            if k.paramDecl when (declOwnerTid :typing declId: dd.parent) != tid then return true
        }
    }
    return false
}

# declOwnerTid -- the type the declaration `declId` is a member of: its
# parent's type, 0 for a top-level one.
declOwnerTid: function {typing: ztyping.ZTyping.view declId: ztypes.declid} out ztypes.tid is {
    if declId.isZero then return ztypes.tid.zero
    par: (typing.decls.get i: declId).parent
    if par.isZero then return ztypes.tid.zero
    return (typing.decls.get i: par).typeId
}

# staticViewReached -- the StaticView instance `tid` answers a walk run time
# makes: a reached list of its element type has its `iterate` used.
staticViewReached: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx.view tid: ztypes.tid
} out bool is {
    elem: reg.genericTypeArgAt specId: tid ordinal: 0
    for each g: typing.constAggs loop {
        if g.reached when g.kind.staticList when (
            (reg.genericTypeArgAt specId: g.tid ordinal: 0) == elem
        ) when (memberUsed :ctx mono: g.tid member: memberWord.slot.iterateAll) then return true
    }
    return false
}

# isSystemVariantTid -- a variant a system unit DECLARED: not an instantiation
# and not a template, so its C is written once with the system types.
isSystemVariantTid: function {
    ctx: Ctx.view
    tcl: ztypes.tid
    tt: ztypes.ztypetype
    isMono: bool
    gen: bool
} out bool is {
    if tt != ztypes.ztypetype.variantType then return false
    if isMono then return false
    if gen then return false
    return (definedInNonMain :ctx tid: tcl)
}

# isUserGenericRecordMono -- a user generic record/class instantiation. The
# collection, array, str and Box monos share those typetypes and drain from
# their own lists, which is what the exclusions here keep out.
isUserGenericRecordMono: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tcl: ztypes.tid
    tt: ztypes.ztypetype
} out bool is {
    isRec: tt.isFieldwise
    if isRec.not then return false
    if (isCollectionOriginTid :ctx originTid: (originTidOf :reg tid: tcl)) then return false
    if (
        originIsTid
        :reg
        tid: tcl
        originTid: (ctx.origins.get i: family.slot.fixedArray)
    ) then return false
    if (
        originIsTid
        :reg
        tid: tcl
        originTid: (ctx.origins.get i: family.slot.str)
    ) then return false
    return (reg.isBoxOf tid: tcl).not
}

# isUserGenericVariantMono -- a user generic variant instantiation.
# optionval/resultval monos are variantType and mono too and drain from wValMono
# in their own dependency position, so isValMono is what separates the families.
isUserGenericVariantMono: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tcl: ztypes.tid
    tt: ztypes.ztypetype
    isValMono: bool
} out bool is {
    if tt != ztypes.ztypetype.variantType then return false
    if isValMono then return false
    return (isCollectionOriginTid :ctx originTid: (originTidOf :reg tid: tcl)).not
}

# classifyValueMono -- an optionval/resultval mono emits with the early monos
# unless it embeds a user type, which puts it in the late pass instead.
classifyValueMono: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    userListM: (ListVal ztypes.tid).view
    tcl: ztypes.tid
    tv: ztypes.tid
    work: MonoWork
} is {
    if (monoIsLate :ast :reg :typing :ctx monoId: tcl userList: userListM) then return
    work.wValMono.append tv
}

# classifyMonoAt -- which worklists one registry type belongs on. A type can be
# on several: the families are asked independently and each answers for itself.
classifyMonoAt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    userListM: (ListVal ztypes.tid).view
    tcl: ztypes.tid
    work: MonoWork
} is {
    if (typeReached :ctx tid: tcl).not then return
    tv: tcl
    tt: reg.typetypeOf typeId: tcl
    gen: reg.isGenericOf tid: tcl
    isMono: (originTidOf :reg tid: tcl).notZero
    if (
        originIsTid
        :reg
        tid: tcl
        originTid: (ctx.origins.get i: family.slot.str)
    ) then work.wStr.append tv
    if (reg.isBoxOf tid: tcl) then work.wBox.append tv
    if (isSystemVariantTid :ctx :tcl :tt :isMono :gen) then work.wSysVar.append tv
    isValMono: (
        (originIsTid :reg tid: tcl originTid: (ctx.origins.get i: family.slot.optionval)) or
        (originIsTid :reg tid: tcl originTid: (ctx.origins.get i: family.slot.resultval))
    )
    if isValMono then classifyValueMono :ast :reg :typing :ctx :userListM :tcl :tv :work
    classifyCollectionMono :ast :reg :typing :ctx :userListM :tcl :tv :tt :isMono :isValMono :work
    if tt == ztypes.ztypetype.protocolType when gen.not when (
        definedInNonMain
        :ctx
        tid: tcl
    ) then work.wProto.append tv
    if isMono.not then return
    if (isLateUserInstance :ast :reg :typing :ctx :tcl userList: userListM) then return
    if (isUserGenericRecordMono :reg :ctx :tcl :tt) then work.wUgRec.append tv
    if (isUserGenericVariantMono :reg :ctx :tcl :tt :isValMono) then work.wUgVar.append tv
}

# isUserInstance -- a user generic record, class or variant instance: the
# instances the collection pass or the late group writes through
# emitUserGenericInstance.
isUserInstance: function {
    reg: ztypes.ZTypeRegistry.view ctx: Ctx.view tcl: ztypes.tid
} out bool is {
    if (originTidOf :reg tid: tcl).isZero then return false
    tt: reg.typetypeOf typeId: tcl
    if (isUserGenericRecordMono :reg :ctx :tcl :tt) then return true
    isValMono: (
        (originIsTid :reg tid: tcl originTid: (ctx.origins.get i: family.slot.optionval)) or
        (originIsTid :reg tid: tcl originTid: (ctx.origins.get i: family.slot.resultval))
    )
    return (isUserGenericVariantMono :reg :ctx :tcl :tt :isValMono)
}

# isLateUserInstance -- a user instance that holds a user type or a mono the
# collection pass writes: it is placed in the late group, after what it holds,
# as a late mono is, rather than at the tail of the collection pass.
isLateUserInstance: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tcl: ztypes.tid
    userList: (ListVal ztypes.tid).view
} out bool is {
    if (isUserInstance :reg :ctx :tcl).not then return false
    if (typeReached :ctx tid: tcl).not then return false
    return (monoIsLate :ast :reg :typing :ctx monoId: tcl :userList)
}

# classifyMonos -- ONE sweep over the registry fills the per-category worklists the
# emission loops then walk in the original sequence. Every predicate here reads
# only registry and typing state, which is immutable during emission; the
# io-wrapper demand gate is the one that must stay at emission time.
classifyMonos: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    userListM: (ListVal ztypes.tid).view
    work: MonoWork
} is {
    last: reg.nextTid
    tcl: ztypes.tid
    for tcl < last loop {
        classifyMonoAt :ast :reg :typing :ctx :userListM :tcl :work
        tcl = tcl.next
    }
}

# emitCollectionMonos -- the collection families and what follows them, in the one
# order that works: array and ListView structs before the Lists whose listView
# companion embeds them; Set and Map after the OptionView their `get` returns;
# the id-keyed pair after the hashed ones for the same reason; protocols after
# the monos their vtable signatures reference; user generic monos last.
emitCollectionMonos: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    buf: String.borrow
    work: MonoWork.view
} is {
    # ListView structs next -- a List's listView companion references
    # the ListView struct by value.
    # list values first: each is a scalar view, and nothing it names comes later
    tdat: u64
    for tdat < work.wStaticList.length loop {
        emitStaticListMono :ast :reg :typing :ctx monoId: (work.wStaticList.get i: tdat) :buf
        tdat = tdat + 1
    }
    for each arrId: work.wArr loop {
        emitArrayMono :ast :reg :typing :ctx monoId: arrId :buf
    }
    for each lvId: work.wListView loop {
        emitListViewMono :ast :reg :typing :ctx monoId: lvId :buf
    }
    # windows next: a window is a list view's layout, and a list's span
    # companion builds one by value
    for each spId: work.wSpan loop {
        emitSpanMono :ast :reg :typing :ctx monoId: spId :buf
    }
    for each liId: work.wList loop {
        emitListMono :ast :reg :typing :ctx monoId: liId :buf
    }
    # Set monos last -- the compact-dict + SetIter; needs its element's
    # OptionView (above) already defined.
    for each seId: work.wSet loop {
        emitSetMono :ast :reg :typing :ctx monoId: seId :buf
    }
    # Map monos -- the compact-dict over key+value; get's return optionval
    # (emitted above) supplies the value type.
    for each maId: work.wMap loop {
        emitMapMono :ast :reg :typing :ctx monoId: maId :buf
    }
    # the id-keyed pair, after the hashed ones for the same reason: an IdMap's
    # `get` returns an optionval / OptionView emitted above.
    for each isId: work.wIdSet loop {
        emitIdSetMono :ast :reg :typing :ctx monoId: isId :buf
    }
    for each imId: work.wIdMap loop {
        emitIdMapMono :ast :reg :typing :ctx monoId: imId :buf
    }
    # reachable system PROTOCOLs (Reader/Writer/Closer/Seeker) -- emitted after
    # the collection monos their vtable function-pointer signatures reference.
    for each spId: work.wProto loop {
        emitOneProtocol :ast :reg :typing :ctx tid: spId :buf
    }
    emitUserGenericInstances :ast :reg :typing :ctx :work :buf
}

# emitUserGenericInstances -- user generic VARIANT monos (e.g. slot_i64, through
# emitOneVariant as the system variant monos are) and RECORD/CLASS monos (e.g.
# Box_i64, through emitOneRecord), each after the instances it embeds by value:
# `Box: record { inner: (Cell t: t) }` holds a Cell_i64, which the type-id order
# can put second. A cycle -- which only a boxed member could close -- falls back
# to the listed order.
emitUserGenericInstances: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    work: MonoWork.view
    buf: String.borrow
} is {
    order: ListVal ztypes.tid
    pending: IdSet ztypes.tid
    for each vv: work.wUgVar loop {
        order.append from: vv
        pending.add item: vv
    }
    for each rv: work.wUgRec loop {
        order.append from: rv
        pending.add item: rv
    }
    emitted: IdSet ztypes.tid
    left: order.length
    for left > 0 loop {
        done: emitReadyInstances :ast :reg :typing :ctx :order :pending :emitted :buf
        if done == 0 then {
            # a cycle: the first still pending goes as listed
            fb: firstNotIn :order set: emitted
            emitUserGenericInstance :ast :reg :typing :ctx tid: fb :buf
            emitted.add item: fb
            done = 1
        }
        left = left - done
    }
}

# emitReadyInstances -- one pass of emitUserGenericInstances: every instance of
# `order` not yet emitted that embeds nothing still pending. Answers how many.
emitReadyInstances: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    order: (ListVal ztypes.tid).view
    pending: (IdSet ztypes.tid).view
    emitted: IdSet ztypes.tid
    buf: String.borrow
} out u64 is {
    done: u64
    for each ov: order loop {
        if (emitted.has item: ov).not when (
            ugEmbedsPending
            :reg
            :typing
            tid: ov
            :pending
            :emitted
        ).not then {
            emitUserGenericInstance :ast :reg :typing :ctx tid: ov :buf
            emitted.add item: ov
            done = done + 1
        }
    }
    return done
}

# firstNotIn -- the first id of `order` that `set` lacks, 0 when none.
firstNotIn: function {
    order: (ListVal ztypes.tid).view set: (IdSet ztypes.tid).view
} out ztypes.tid is {
    for each fv: order loop {
        if (set.has item: fv).not then return fv
    }
    return ztypes.tid.zero
}

# emitUserGenericInstance -- one user generic instance, by its family.
emitUserGenericInstance: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    if (reg.typetypeOf typeId: tid) == ztypes.ztypetype.variantType then {
        emitOneVariant :ast :reg :typing :ctx :tid :buf
        return
    }
    emitOneRecord :ast :reg :typing :ctx :tid :buf
}

# ugEmbedsPending -- the user generic instance `tid` holds, as a field or an arm,
# an instance of `pending` not yet `emitted`.
ugEmbedsPending: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    pending: (IdSet ztypes.tid).view
    emitted: (IdSet ztypes.tid).view
} out bool is {
    ids: ListVal ztypes.tid
    nms: ListVal zast.nameid
    if (reg.typetypeOf typeId: tid) == ztypes.ztypetype.variantType then {
        variantArmIds :reg :typing :tid :ids nameIds: nms
    } else {
        recFieldIds :reg :typing :tid :ids nameIds: nms
    }
    for each iv: ids loop {
        if iv != tid when (pending.has item: iv) when (emitted.has item: iv).not then return true
    }
    return false
}

# emitOptionMonos -- the option and result families, before the collections whose
# `get` returns one: the by-value variant monos, the heap-payload union monos,
# a user generic union, and the borrowed-view option every iterator yields.
emitOptionMonos: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    buf: String.borrow
    work: MonoWork.view
} is {
    # optionval + resultval variant monos -- iterators/collection-gets /
    # parsers return them by value (payloads now resolvable).
    for each vmId: work.wValMono loop {
        emitOneVariant :ast :reg :typing :ctx tid: vmId :buf
    }
    # Option union monos (tag + void* data heap payload) -- reftype
    # option returns (string strip/split, map get over reftype).
    for each orId: work.wOptRes loop {
        emitUnionMono :ast :reg :typing :ctx tid: orId :buf
    }
    # user generic UNION monos (e.g. MyOption<i64>): struct + tags via
    # emitUnionMono. The work.wUgRec list handles only RECORD/CLASS; system
    # option/result monos are handled above.
    for each uguId: work.wUgUnion loop {
        emitUnionMono :ast :reg :typing :ctx tid: uguId :buf
    }
    # view union structs (OptionView, OptionMut) -- the borrowed option every
    # collection iterator yields; emitted before the collections that reference
    # them.
    for each ovId: work.wOptView loop {
        emitOptionViewMono :ast :ctx :reg :typing monoId: ovId :buf
    }
}


# emitMonos -- emit every collection-mono instance in the registry (List
# today; Map/Set/iterators land with their slices).
emitMonos: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    buf: String.borrow
} is {
    userListM: ListVal ztypes.tid
    buildUserTypeList :reg :typing :ctx acc: userListM
    emitMainFwdDecls :reg :typing :ctx :buf
    # one classification sweep over the registry fills the per-category
    # worklists; the category loops below emit in the original sequence.
    # Every predicate reads only registry/typing state (immutable during
    # emission); the io-wrapper demand gate stays at emission time.
    work: (
        MonoWork
        wStr: ListVal ztypes.tid
        wBox: ListVal ztypes.tid
        wSysVar: ListVal ztypes.tid
        wValMono: ListVal ztypes.tid
        wOptRes: ListVal ztypes.tid
        wUgUnion: ListVal ztypes.tid
        wOptView: ListVal ztypes.tid
        wArr: ListVal ztypes.tid
        wListView: ListVal ztypes.tid
        wSpan: ListVal ztypes.tid
        wStaticList: ListVal ztypes.tid
        wList: ListVal ztypes.tid
        wSet: ListVal ztypes.tid
        wMap: ListVal ztypes.tid
        wIdSet: ListVal ztypes.tid
        wIdMap: ListVal ztypes.tid
        wProto: ListVal ztypes.tid
        wUgVar: ListVal ztypes.tid
        wUgRec: ListVal ztypes.tid
    )
    classifyMonos :ast :reg :typing :ctx :userListM :work
    # str valtype monos are leaf PODs that user records embed by value, so emit
    # them first (before any user struct / collection mono that references them).
    for each strId: work.wStr loop {
        emitStrMono :reg :typing :ctx monoId: strId :buf
    }
    # builtin Box monos (heap pointers): destructor-only, leaf -- emit early.
    for each boxId: work.wBox loop {
        emitBoxMono :reg :typing :ctx monoId: boxId :buf
    }
    emitClassRowStructs :ast :reg :typing :ctx :buf
    # reachable non-mono system VARIANTs (parseerror, seekorigin, ...) --
    # payloads of the variant monos / used directly.
    for each svId: work.wSysVar loop {
        emitOneVariant :ast :reg :typing :ctx tid: svId :buf
    }
    preEmitProtocolElems :ast :reg :typing :ctx :work :buf
    emitOptionMonos :ast :reg :typing :ctx :work :buf
    emitCollectionMonos :ast :reg :typing :ctx :work :buf
}

# preEmitProtocolElems -- a container of PROTOCOL values holds each value by
# value and destroys it through the protocol's destroy, so the protocol's
# struct, vtable and destroy are declared before any mono that stores one.
# They were emitted with the user types, after every mono, and `List Shape`
# named a struct the C compiler had not seen.
preEmitProtocolElems: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    work: MonoWork.view
    buf: String.borrow
} is {
    monos: ListVal ztypes.tid
    for each m: work.wOptRes loop monos.append from: m
    for each m: work.wOptView loop monos.append from: m
    for each m: work.wArr loop monos.append from: m
    for each m: work.wListView loop monos.append from: m
    for each m: work.wList loop monos.append from: m
    for each m: work.wSet loop monos.append from: m
    for each m: work.wMap loop monos.append from: m
    for each mono: monos loop {
        preEmitProtocolArgs :ast :reg :typing :ctx :mono :buf
    }
}

# preEmitProtocolArgs -- each protocol among one mono's type arguments.
preEmitProtocolArgs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    mono: ztypes.tid
    buf: String.borrow
} is {
    n: reg.genericArgCount specId: mono
    i: u64
    for i < n loop {
        at: reg.genericTypeArgAt specId: mono ordinal: i
        if at.notZero when (reg.typetypeOf typeId: at) == ztypes.ztypetype.protocolType then {
            maybePreEmitElem :ast :reg :typing :ctx eid: at :buf
        }
        i = i + 1
    }
}

# writeDemandedAggs -- each static value run time reaches (constagg.reached)
# that written C spells (noteAggUse) and is not yet written, as the static
# storage its handles point at: a data value as `static const <type>_t
# _zag<row> = { ... };`, fields in declared order, a choice value the same way
# (staticChoiceInit), read whole, and a list as its array (emitStaticListArray).
# Each row's text is kept apart (appendWrittenAggs writes them in row order: a
# value it holds is emitted before it, as an aggregate is interned after the
# ones it holds). True when it wrote one, whose items may spell more.
writeDemandedAggs: function {
    ast: Ast.view reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx
} out bool is {
    wrote: false
    i: 1.u64
    for i < typing.constAggs.length loop {
        id: i
        i = i + 1
        if (ctx.aggUses.has item: id).not or (ctx.aggWritten.has item: id) then continue
        tid: ztypes.tid
        start: u64
        count: u64
        isList: false
        isChoice: false
        {
            g: typing.constAggs.get i: id
            if g.reached.not then continue
            isList = g.kind.staticList
            isChoice = g.kind.staticChoice
            tid = g.tid
            start = g.itemStart
            count = g.itemCount
        }
        ctx.aggWritten.add item: id
        wrote = true
        buf: String
        emitStaticFnProtos :ast :reg :typing :ctx row: id :buf
        if isList then {
            emitStaticListArray :ast :reg :typing :ctx :id :count :buf
        } else if isChoice then {
            ci: staticChoiceInit :ast :reg :typing :ctx row: id
            buf.append "static const \{spelledCname :ctx :tid}_t _zag\{id} = \{ci};\n"
        } else {
            emitStaticRecord :ast :reg :typing :ctx :id :tid :start :count :buf
        }
        ctx.aggsOut.append (WrittenAgg row: id text: buf.take)
    }
    return wrote
}

# emitStaticRecord -- data row `id`, a `tid` record of the `count` folded
# values from `start`: its static const object.
emitStaticRecord: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    id: u64
    tid: ztypes.tid
    start: u64
    count: u64
    buf: String.borrow
} is {
    fnames: List String
    fids: ListVal ztypes.tid
    fidsNm: ListVal zast.nameid
    recFieldLists :ast :reg :typing :tid names: fnames ids: fids nameIds: fidsNm
    rc: spelledCname :ctx :tid
    buf.append "static const \{rc}_t _zag\{id} = { "
    k: u64
    for k < count loop {
        if k > 0 then buf.append ", "
        buf.append (
            staticAggItemText
            :ast
            :reg
            :typing
            :ctx
            tid: (fids.get i: k)
            v: (typing.constAggItems.get i: start + k)
        )
        k = k + 1
    }
    buf.append " };\n"
}

# WrittenAgg -- a static aggregate row whose C is written, and that text.
WrittenAgg: class {
    row: u64
    text: String
}

# nativebox -- an (implementer, protocol) pair a native implementer is boxed
# as.
nativebox: record {
    impl: ztypes.tid
    proto: ztypes.tid
}

# membercond -- one term of the condition a template member is used under: the
# member's key (memberKey) and the term's mask of condition bits.
membercond: record {
    key: u64
    mask: u64
}

# appendWrittenAggs -- the written static aggregates' text, in row order.
appendWrittenAggs: function {typing: ztyping.ZTyping.view ctx: Ctx.view buf: String.borrow} is {
    i: 1.u64
    for i < typing.constAggs.length loop {
        if (ctx.aggWritten.has item: i) then {
            for each wa: ctx.aggsOut loop {
                if wa.row == i then buf.append wa.text
            }
        }
        i = i + 1
    }
}

# emitStaticFnProtos -- the prototype of each function static row `row` holds
# a reference to: the static objects are written ahead of the functions, and a
# function's address is a constant only once it is declared. C takes the same
# declaration again where the function is written.
emitStaticFnProtos: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    row: u64
    buf: String.borrow
} is {
    start: u64
    count: u64
    {
        g: typing.constAggs.get i: row
        start = g.itemStart
        count = g.itemCount
    }
    k: u64
    for k < count loop {
        v: typing.constAggItems.get i: start + k
        k = k + 1
        if v.kind.fnKind.not then continue
        fid: (typing.decls.get i: v.fnDecl).typeId
        fnode: zast.nodeid
        {
            dn: ast.nodes.get i: (typing.decls.get i: v.fnDecl).node
            if dn.namedoperation then fnode = dn.operation
        }
        if fnode.isZero then continue
        appendFnSignature :ast :reg :typing :ctx :fid op: (ast.nodes.get i: fnode) :buf tail: ";\n"
    }
}

# emitStaticListArray -- the reached list row `id`: the static const array
# `_zag<row>[]` of its `count` elements, at the element C type its view reads
# (staticListElemCType). An empty list has no array -- C has no empty
# initializer. Its reader is written apart, where called (emitStaticListReaders).
emitStaticListArray: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    id: u64
    count: u64
    buf: String.borrow
} is {
    ect: staticListElemCType :ast :reg :typing :ctx row: id
    est: staticListStoredC ect: ect.stringView
    elems: String
    k: u64
    for k < count loop {
        if k > 0 then elems.append ", "
        elems.append (listItemText :ast :reg :typing :ctx row: id slot: k)
        k = k + 1
    }
    if count > 0 then buf.append "static const \{est} _zag\{id}[] = {\{elems}};\n\n"
}

# noteAggUse -- written C spells static aggregate row `row` (`_zag<row>`): it
# is written (writeDemandedAggs). One spelled after the written rows are fixed
# is never written.
noteAggUse: function {ctx: Ctx row: u64} is {
    if (ctx.aggUses.has item: row) then return
    if ctx.aggsFixed then {
        (
            emitFail
            :ctx
            what: "a static aggregate spelled after the aggregates were written".string
            line: 0
        )
        return
    }
    ctx.aggUses.add item: row
}

# noteAggReaderUse -- written C calls static list row `row`'s reader
# `_zag<row>_at`: it is written with the row it reads, which are fixed together.
noteAggReaderUse: function {ctx: Ctx row: u64} is {
    noteAggUse :ctx :row
    if ctx.aggsFixed.not then ctx.aggReaderUses.add item: row
}

# emitStaticListReaders -- the reader `_zag<row>_at` of each reached list row
# written C calls (noteAggReaderUse), in row order, after every function body.
emitStaticListReaders: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    buf: String.borrow
} is {
    i: 1.u64
    for i < typing.constAggs.length loop {
        id: i
        i = i + 1
        if (ctx.aggReaderUses.has item: id).not then continue
        count: (typing.constAggs.get i: id).itemCount
        emitStaticListReader :ast :reg :typing :ctx :id :count :buf
    }
}

# emitStaticListReader -- list row `id`'s reader `_zag<row>_at`, which panics
# on an index past the end of its `count` elements (a negative i64 converts to
# a huge u64): for an empty list, on every index.
emitStaticListReader: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    id: u64
    count: u64
    buf: String.borrow
} is {
    ect: staticListElemCType :ast :reg :typing :ctx row: id
    dsym: "_zag\{id}"
    buf.append "static \{ect} \{dsym}_at(uint64_t _idx);\n"
    buf.append "static \{ect} \{dsym}_at(uint64_t _idx) {\n"
    b2: "snprintf(_zp_buf, sizeof(_zp_buf), \"list index: index %llu out of bounds (length \{count})\", (unsigned long long)_idx);\n"
    # an empty list's every index is past its end: the reader only panics
    if count == 0 then {
        preludeNeed :ctx memb: "@panic"
        buf.append "    char _zp_buf[96];\n    \{b2}    z_panic(_zp_buf);\n}\n\n"
        return
    }
    buf.append "    if (_idx >= \{count}) {\n"
    buf.append "        char _zp_buf[96];\n"
    buf.append "        \{b2}"
    preludeNeed :ctx memb: "@panic"
    buf.append "        z_panic(_zp_buf);\n"
    buf.append "    }\n"
    buf.append "    return \{dsym}[_idx];\n"
    buf.append "}\n\n"
}

# staticListElemCType -- the C type of the elements of list row `row`: the C
# type its value type's element has (slotCType), so the array is exactly what
# the list's view points at -- an untyped list's i64 or f64, a typedef's own
# base.
staticListElemCType: function {
    ast: Ast.view reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx row: u64
} out String is {
    vt: (typing.constAggs.get i: row).tid
    elemC: slotCType :ast :reg :typing :ctx tid: (reg.genericTypeArgAt specId: vt ordinal: 0)
    return (ctypeOrI64 s: elemC.stringView)
}

# staticListStoredC -- element C type `ect` as a list's storage spells it after
# a `const`: a data value's handle `const z_T_t*` is `z_T_t* const`, so `const`
# in front of it reads `const z_T_t* const`, never `const const`; any other
# type is itself.
staticListStoredC: function {ect: StringView} out String is {
    if (
        (ect.startsWith prefix: "const ").not or (ect.endsWith suffix: "*").not
    ) then return ect.string
    r: (ect.substring from: 6 to: ect.length).string
    r.append " const"
    return r
}

# listItemText -- the C constant for element `slot` of list row `row`, rendered
# from the value the checker recorded, at the list's element type, as a static
# initializer (staticAggItemText).
listItemText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    row: u64
    slot: u64
} out String is {
    g: typing.constAggs.get i: row
    if slot >= g.itemCount then return "".string
    return (
        staticAggItemText
        :ast
        :reg
        :typing
        :ctx
        tid: g.elem
        v: (typing.constAggItems.get i: g.itemStart.u64 + slot)
    )
}

# staticStringInit -- a folded string as a static initializer of its view: the
# bytes themselves, since the pool's `_zcsN` view is no constant expression.
staticStringInit: function {typing: ztyping.ZTyping.view v: ztypes.cval} out String is {
    sv: typing.constStrings.get i: v.strId
    r: "{ .data = \"".string
    r.append (cEscape text: sv.stringView)
    r.append "\", .size = "
    r.append "\{sv.length}"
    r.append " }"
    return r
}

# staticListInit -- list row `row` as a static initializer of its view: the
# braces alone, since a compound literal is no constant expression.
staticListInit: function {typing: ztyping.ZTyping.view ctx: Ctx row: u64} out String is {
    n: (typing.constAggs.get i: row).itemCount
    if n == 0 then return "{ .length = 0, .data = NULL }".string
    noteAggUse :ctx :row
    return "{ .length = \{n}, .data = _zag\{row} }"
}

# staticChoiceInit -- choice row `row` as a constant initializer: its tag and
# the value its arm carries, in the arm's member of the payload union, spelled
# as a field of a static object is (staticAggItemText). A choice is held by
# value, so this is the value itself wherever it lands.
staticChoiceInit: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    row: u64
} out String is {
    tid: ztypes.tid
    arm: zast.nameid
    item: ztypes.noConst
    {
        g: typing.constAggs.get i: row
        tid = g.tid
        arm = g.arm
        item = typing.constAggItems.get i: g.itemStart.u64
    }
    tg: spelledTagConst :ast :ctx :reg :typing :tid armId: arm
    mc: memberC :ast :reg :typing :ctx owner: tid kind: memberkind.arm nameId: arm
    pt: ztypes.tid
    ad: typing.declMemberIdOf parentTypeId: tid nameId: arm
    if ad.notZero then pt = (typing.decls.get i: ad).typeId
    it: staticAggItemText :ast :reg :typing :ctx tid: pt v: item
    return "{ .tag = \{tg}, .data = { .\{mc} = \{it} } }"
}

# staticAggItemText -- one field of a static object as a constant initializer:
# a string as the bytes themselves (the pool's `_zcsN` view is no constant
# expression), a data value as its object's address, a choice value as its
# braces (staticChoiceInit), a function reference as the function, an arm as
# its bool or its tag alone, and a number as cvalText spells it at the field's
# type.
staticAggItemText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    v: ztypes.cval
} out String is {
    if v.kind.svalKind then return (staticStringInit :typing :v)
    if v.kind.aggKind when (typing.constAggs.get i: v.aggId.u64).kind.staticList then {
        return (staticListInit :typing :ctx row: v.aggId)
    }
    if v.kind.aggKind when (typing.constAggs.get i: v.aggId.u64).kind.staticChoice then {
        return (staticChoiceInit :ast :reg :typing :ctx row: v.aggId)
    }
    # a function reference is the function itself, whose address is a constant
    if v.kind.fnKind then return (
        spelledCname
        :ctx
        tid: (typing.decls.get i: v.fnDecl).typeId
    )
    if v.kind.armKind then {
        av: armValueC :ast :ctx :reg :typing tid: v.armTid arm: v.armName
        if av.length > 0 then return av
        tg: spelledTagConst :ast :ctx :reg :typing tid: v.armTid armId: v.armName
        return "{ .tag = \{tg} }"
    }
    facts: cfacts
    return (cvalText :ast :reg :typing :ctx :tid :v :facts)
}

# emitRecordDefs -- the implementation helpers and the hash prototypes, which are
# written after the types they serve and so are generated after them: every
# file unit's, then each generic instance's. The units' methods are function
# jobs (planRecordMethods).
emitRecordDefs: function {
    program: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    buf: String.borrow
} is {
    for each uId: program.units loop {
        opId: zast.nodeid
        unitNameText: String
        unitNameId: zast.nameid
        {
            u: program.nodes.get i: uId
            if u.namedoperation then {
                un: zast.poolTextAt pool: program.names ref: u.name
                opId = u.operation
                unitNameText = un.copy
                unitNameId = u.name
            }
        }
        if opId.notZero then {
            sm: ctx.mainName.copy
            smD: ctx.mainUnitId
            (
                ctxBindMain
                :ctx
                name: unitNameText.stringView
                unitDecl: (ztypecheck.unitDeclOfName :typing nameId: unitNameId)
            )
            emitRecordDefsIn :reg :typing :ctx ast: program mainOpId: opId :buf
            ctxBindMain :ctx name: sm.stringView unitDecl: smD
        }
    }
    emitInstanceImplementationImpls ast: program :reg :typing :ctx :buf
    # the generated hashes every method body may call are declared once
    # every struct they take is
    emitHashPrototypes ast: program :reg :typing :ctx :buf
}

# emitInstanceImplementationImpls -- the implementation helpers of each generic
# instance that carries rows of its own: an instance of a generic implementer,
# checked against the spec at the end of typecheck, and an instance of a
# generic typedef, which inherited its base's. No unit body declares an
# instance, so the per-unit pass never reaches either. A native instance (str)
# is boxed per use instead (boxLabelFor).
emitInstanceImplementationImpls: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    buf: String.borrow
} is {
    insts: ListVal ztypes.tid
    cfId: ztypes.confid
    for cfId.next < typing.nextConf loop {
        cfId = cfId.next
        row: typing.implementation.get i: cfId
        it: row.implTypeId
        isMono: (reg.genericOriginOf tid: it).notZero
        natRow: nativeImplementerRow :reg tid: it
        if isMono when natRow.isZero when (insts.contains item: it).not then insts.append it
    }
    for each it: insts loop {
        implT: it
        emitImplementationImplsForType :ast :reg :typing :ctx implTid: implT isFacet: false :buf
        emitImplementationImplsForType :ast :reg :typing :ctx implTid: implT isFacet: true :buf
    }
}


# protoChildMethods -- a protocol's spec-method children (FUNCTION children,
# excluding the synth create/borrow), names + ids in registration order.
protoChildMethods: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    names: List String
    ids: ListVal ztypes.tid
    nameIds: ListVal zast.nameid
} is {
    ownerTid: tid
    pi4: u64
    pn4: typing.declRowSlots :ownerTid
    for pi4 < pn4 loop {
        row: typing.declRowAt :ownerTid membersOnly: true slot: pi4
        pi4 = pi4 + 1
        if row.keep then {
            memberName: row.name
            memberTid: row.tid
            if (reg.typetypeOf typeId: memberTid) == ztypes.ztypetype.functionType then {
                isSynth: memberName == zast.wellKnown.slot.wkCreate
                if isSynth.not then {
                    memberText: ast.names.texts.get i: memberName
                    cn0: memberText.copy
                    names.append cn0
                    ids.append memberTid
                    nameId: memberName
                    nameIds.append nameId
                }
            }
        }
    }
}

# cReturnText -- a C return type as written: `void` for the empty text the
# return builders leave when there is no value
cReturnText: function {ret: String.take} out String is {
    if ret.length == 0 then return "void".string
    return ret
}

# methodRetCtype -- a method's C return type via the registry returnTypeId
# (scalars/records/classes resolve through typeRefC); empty when it returns
# nothing, which the caller spells `void`.
methodRetCtype: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    mid: ztypes.tid
} out String is {
    mro: ztypecheck.methodReturnOf :reg :typing :mid
    if mro.some then {
        rr: typeRefC :ast :reg :typing :ctx tid: mro
        if rr.length > 0 then return rr
    }
    # no value: the callers spell it, `void`, where they write the C
    return "".string
}

# protoParamCtype -- a protocol spec-method param's C type: typeRefC, with a
# `*` for an owned collection param (List/Map and the Bytes typedef), which the
# vtable function pointers and wrappers pass by pointer. A value view
# (ListView, the ByteView typedef) goes by value, as everywhere else.
protoParamCtype: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    pid: ztypes.tid
} out String is {
    # The spec param is usually a SHELL named after the system type; canonicalize
    # it (canonTypeId) so typeRefC resolves it (and chases ByteView/Bytes to their
    # collection mono). A param already resolved to a CANONICAL id (a linked
    # declaration, e.g. system i64) is trusted as-is. Mirrors typeRefC's shell
    # gate.
    cpid: pid
    pidShell: (definedInUnitTid :reg :typing tid: pid).isZero
    if pidShell then {
        rcid: canonTypeId :reg :typing tid: pid
        if rcid.notZero then cpid = rcid
    }
    pct: typeRefC :ast :reg :typing :ctx tid: cpid
    if pct.length == 0 then {
        (
            emitFail
            :ctx
            what: "an interface slot's parameter type the C backend cannot spell".string
            line: 0
        )
        return "".string
    }
    isCol: false
    ccm: chaseAggregateTypedef :reg :typing :ctx tid: cpid
    if (ccm == cpid).not then isCol = true
    if (isCollectionOriginTid :ctx originTid: (originTidOf :reg tid: cpid)) then isCol = true
    if isCol when (isValueViewTid :reg :typing :ctx tid: cpid).not then return "\{pct}*"
    return pct
}

# facetImplTids -- the deduplicated impl type ids implementing to facet `tid`,
# in implementation-row (declaration) order: each instance of a generic implementer
# by its own row, never the template, whose struct is never emitted.
facetImplTids: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    acc: ListVal ztypes.tid
} is {
    cfId: ztypes.confid
    for cfId.next < typing.nextConf loop {
        cfId = cfId.next
        row: typing.implementation.get i: cfId
        if row.specTypeId == tid when (acc.contains item: row.implTypeId).not when (
            reg.isGenericOf
            tid: row.implTypeId
        ).not then acc.append row.implTypeId
    }
}

# specMemberIsSelfTyped -- a spec member with a parameter of the INTERFACE's
# OWN type, the receiver excluded. `type` inside an interface means the
# interface, so `near: function {:this rhs: type}` asks for a
# implementer-to-implementer call, and a vtable cannot type one: the slot would
# have to name a single implementation's argument and there may be many. Such a
# member is NOT part of the dispatchable surface -- no slot, no wrapper -- and
# calling it through the interface is refused where the call is written.
#
# It is the same test as "this parameter IS the receiver", read the other way
# round; read that way, a self-typed argument is silently swallowed.
specMemberIsSelfTyped: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ifaceTid: ztypes.tid
    smid: ztypes.tid
} out bool is {
    pnames: List String
    pids: ListVal ztypes.tid
    pidsNm: ListVal zast.nameid
    recFieldLists :ast :reg :typing tid: smid names: pnames ids: pids nameIds: pidsNm
    rpn: reg.thisParamNameIdOf tid: smid
    found: false
    pi: u64
    for pi < pnames.length loop {
        isRecv: (
            ((pidsNm.get i: pi) == zast.wellKnown.slot.wkThis) or
            (rpn.notZero and ((pidsNm.get i: pi) == rpn))
        )
        if isRecv.not when (pids.get i: pi) == ifaceTid then found = true
        pi = pi + 1
    }
    return found
}

# emitOneFacet -- the facet value representation: a vtable typedef (one fn
# pointer per spec, void* receiver), an inline data union over the implementing
# impls (copied by value -- facets are valtype existentials), and the
# {vtable*, data} struct. No destroy helper: impls are valtypes. The impl
# structs are pre-emitted first because the union embeds them by value.
emitOneFacet: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    if (ctx.emittedUserTypes.has item: tid) then return
    ctx.emittedUserTypes.add item: tid
    pbase: spelledCname :ctx :tid
    impls: ListVal ztypes.tid
    facetImplTids :reg :typing :tid acc: impls
    preEmitEmbeddedTypes :ast :reg :typing :ctx ids: impls :buf
    mnames: List String
    mids: ListVal ztypes.tid
    midsNm: ListVal zast.nameid
    protoChildMethods :ast :reg :typing :tid names: mnames ids: mids nameIds: midsNm
    vfuncs: String
    mi: u64
    mn: mnames.length
    for mi < mn loop {
        smid: mids.get i: mi
        # a member whose signature mentions the interface's own type is not
        # dispatchable: no slot, and no wrapper below either
        if (specMemberIsSelfTyped :ast :reg :typing ifaceTid: tid :smid) then {
            mi = mi + 1
            continue
        }
        mroP: ztypecheck.methodReturnOf :reg :typing mid: smid
        if mroP.some then {
            maybePreEmitElem :ast :reg :typing :ctx eid: mroP :buf
        }
        ret: cReturnText ret: (methodRetCtype :ast :reg :typing :ctx mid: smid)
        vparams: "void*".string
        pnames: List String
        pids: ListVal ztypes.tid
        pidsNm: ListVal zast.nameid
        recFieldLists :ast :reg :typing tid: smid names: pnames ids: pids nameIds: pidsNm
        preEmitEmbeddedTypes :ast :reg :typing :ctx ids: pids :buf
        pi: u64
        pn: pnames.length
        for pi < pn loop {
            pid: pids.get i: pi
            # spec receivers are dropped when the spec resolves; a MARKED one is
            # found by the registry below. A parameter of the interface's OWN
            # type is not the receiver -- reading it as one is what dropped it
            # from the slot while the wrapper still passed it.
            isThis: false
            if (pidsNm.get i: pi) == zast.wellKnown.slot.wkThis then isThis = true
            # a marked receiver is an alias, so ask the registry which
            # parameter IS the receiver rather than matching on `this`
            rpnV: reg.thisParamNameIdOf tid: smid
            if rpnV.notZero when (pidsNm.get i: pi) == rpnV then isThis = true
            if isThis.not then {
                pct: protoParamCtype :ast :reg :typing :ctx :pid
                vparams.append ", "
                vparams.append pct
            }
            pi = pi + 1
        }
        vslot: (
            memberC
            :ast
            :reg
            :typing
            :ctx
            owner: tid
            kind: memberkind.slot
            nameId: (midsNm.get i: mi)
        )
        vline: "    \{ret} (*\{vslot})(\{vparams});\n"
        vfuncs.append vline
        mi = mi + 1
    }
    buf.append (vtableTypedefC slots: vfuncs.stringView base: pbase.stringView)
    du: String
    for each itid: impls loop {
        icn: implStructC :reg :typing :ctx tid: itid
        drow: "    \{icn} _i\{itid};\n"
        du.append drow
    }
    if du.length == 0 then du.append "    char _none;\n"
    l1: "typedef union {\n\{du}} \{pbase}_data_u;\n\n"
    buf.append l1
    openStructBody :ctx :tid cn: pbase.stringView :buf
    buf.append "    "
    buf.append pbase
    buf.append "_vtable_t* vtable;\n    "
    buf.append pbase
    buf.append "_data_u data;\n"
    closeStructBody :ctx :tid cn: pbase.stringView :buf
    buf.append "\n"
}

# vtableTypedefC -- a protocol's or facet's vtable struct over its `slots`. A
# marker has no slots, and a C17 struct needs a member, so it holds a
# placeholder.
vtableTypedefC: function {slots: StringView base: StringView} out String is {
    if slots.length == 0 then return "typedef struct {\n    char none;\n} \{base}_vtable_t;\n\n"
    return "typedef struct {\n\{slots}} \{base}_vtable_t;\n\n"
}

# protocolEmitted -- the protocol `tid` needs no representation now: it is in
# the buffer already, or it is a marker no value is made of (markerValueMade)
protocolEmitted: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} out bool is {
    if (ctx.emittedUserTypes.has item: tid) then return true
    return (markerValueMade :ast :reg :typing :ctx spec: tid).not
}

# emitOneProtocol -- the protocol value representation: vtable typedef (one
# function pointer per spec method, `this` dropped for a leading void*),
# the fat-pointer struct {data, vtable, destroy}, and the destroy helper.
emitOneProtocol: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    # a marker no value is made of has nothing in the program's C to name it
    if (protocolEmitted :ast :reg :typing :ctx :tid) then return
    ctx.emittedUserTypes.add item: tid
    pbase: spelledCname :ctx :tid
    mnames: List String
    mids: ListVal ztypes.tid
    midsNm: ListVal zast.nameid
    protoChildMethods :ast :reg :typing :tid names: mnames ids: mids nameIds: midsNm
    vfuncs: String
    mi: u64
    mn: mnames.length
    for mi < mn loop {
        smid: mids.get i: mi
        # a member whose signature mentions the interface's own type is not
        # dispatchable: no slot, and no wrapper below either
        if (specMemberIsSelfTyped :ast :reg :typing ifaceTid: tid :smid) then {
            mi = mi + 1
            continue
        }
        mroP: ztypecheck.methodReturnOf :reg :typing mid: smid
        if mroP.some then {
            maybePreEmitElem :ast :reg :typing :ctx eid: mroP :buf
        }
        ret: cReturnText ret: (methodRetCtype :ast :reg :typing :ctx mid: smid)
        vparams: "void*".string
        pnames: List String
        pids: ListVal ztypes.tid
        pidsNm: ListVal zast.nameid
        recFieldLists :ast :reg :typing tid: smid names: pnames ids: pids nameIds: pidsNm
        preEmitEmbeddedTypes :ast :reg :typing :ctx ids: pids :buf
        pi: u64
        pn: pnames.length
        for pi < pn loop {
            pid: pids.get i: pi
            isThis: (pidsNm.get i: pi) == zast.wellKnown.slot.wkThis
            # a marked receiver is an alias, so ask the registry which
            # parameter IS the receiver rather than matching on `this`
            rpnV: reg.thisParamNameIdOf tid: smid
            if rpnV.notZero when (pidsNm.get i: pi) == rpnV then isThis = true
            if isThis.not then {
                pct: protoParamCtype :ast :reg :typing :ctx :pid
                vparams.append ", "
                vparams.append pct
            }
            pi = pi + 1
        }
        vslot: (
            memberC
            :ast
            :reg
            :typing
            :ctx
            owner: tid
            kind: memberkind.slot
            nameId: (midsNm.get i: mi)
        )
        vline: "    \{ret} (*\{vslot})(\{vparams});\n"
        vfuncs.append vline
        mi = mi + 1
    }
    buf.append (vtableTypedefC slots: vfuncs.stringView base: pbase.stringView)
    openStructBody :ctx :tid cn: pbase.stringView :buf
    buf.append "    void* data;\n    "
    buf.append pbase
    buf.append "_vtable_t* vtable;\n    void (*destroy)(void*);\n"
    closeStructBody :ctx :tid cn: pbase.stringView :buf
    buf.append "\n"
    emitProtocolDestroy :reg :ctx :tid pbase: pbase.stringView :buf
}

# emitProtocolDestroy -- a protocol value's destructor, where written C calls
# it (destroyWritten): it runs the destroy an owned value carries (a borrowed
# one carries none) and clears it.
emitProtocolDestroy: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx.view
    tid: ztypes.tid
    pbase: StringView
    buf: String.borrow
} is {
    if (destroyWritten :reg :ctx :tid).not then return
    l2: "static void \{pbase}_destroy(\{pbase}_t* proto) {\n    if (!proto) return;\n    if (proto->destroy) proto->destroy(proto->data);\n    proto->destroy = NULL;\n}\n\n"
    buf.append l2
}

# implStructC -- the C struct an implementer's value is: a typedef over an
# aggregate or a String is its chain end's struct, anything else its own.
implStructC: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx.view tid: ztypes.tid
} out String is {
    e: chaseStrTypedef :typing :ctx tid: (chaseAggregateTypedef :reg :typing :ctx :tid)
    ecn: ctxCnameView :ctx tid: e
    return "\{ecn}_t"
}

# implMethodCname -- the C name an implementation wrapper calls for the impl's
# `mname`. A NATIVE member's symbol is the canon-named one a fragment defines,
# whichever unit is being emitted; the per-unit emission pass rebinds mainName,
# so the nonmain test below cannot answer that half on its own. A typedef's
# method is its chain's first declarer: its own, or its base's.
implMethodCname: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    implTid: ztypes.tid
    mnameId: zast.nameid
    mname: StringView
} out String is {
    owner: ztypecheck.valOpOwner :typing tid: implTid nameId: mnameId
    implMid: ztypes.tid
    imo: typing.declChildOfId parentTypeId: owner nameId: mnameId
    if imo.some then {
        implMid = imo
    }
    noteFnUse :ctx tid: implMid
    implBase: ctxCnameView :ctx tid: owner
    if (reg.isNativeOf tid: implMid) then return "\{implBase}_\{mname}"
    if (definedInNonMain :ctx tid: owner) then return "\{implBase}_\{mname}"
    return (ctxCname :ctx tid: implMid)
}


# emitImplementationImplsForType -- the implementation helpers one impl type owes a
# family: every row of the implementation table naming it, each emitted once.
# The families differ in which impls they accept and which helper they emit,
# and in nothing else.
emitImplementationImplsForType: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    implTid: ztypes.tid
    # which family to emit for: a facet's helpers, or a protocol's
    isFacet: bool
    buf: String.borrow
} is {
    # a reftype impl is skipped for a facet: one copied into an inline union
    # would break the valtype guarantee, and catching that is front-end work
    implTT: reg.typetypeOf typeId: implTid
    if isFacet when implTT.isValueData.not then return
    # a protocol implements only to markers, and its value stands in for its own
    # protocol only, so its rows need no helpers
    if implTT == ztypes.ztypetype.protocolType then return
    want: ztypes.ztypetype.protocolType
    if isFacet then want = ztypes.ztypetype.facetType
    ri: ztypes.confid
    for ri.next < typing.nextConf loop {
        ri = ri.next
        hit: false
        tid: ztypes.tid
        label: String
        {
            row: typing.implementation.get i: ri
            if row.implTypeId == implTid then {
                hit = true
                tid = row.specTypeId
                label = row.label.copy
            }
        }
        if hit.not then continue
        # a row's helpers are written once written C makes a value of it
        if (ctx.boxedImplementation.has item: ri).not then continue
        if (reg.typetypeOf typeId: tid) == want when (
            implementationRowEmitted
            :ctx
            row: ri
        ).not then {
            implementationRowMark :ctx row: ri
            (
                emitImplementationImpl
                :ast
                :reg
                :typing
                :ctx
                :implTid
                specTid: tid
                label: label.stringView
                :isFacet
                :buf
            )
        }
    }
}

# markerValueMade -- false only for a marker protocol (one with no members)
# that no value of is made: no call or label read is typed by it
# (makesMarkerValue) and nothing stands in for it. An implementation to such a marker says something about the type and
# needs no helpers. Answered once per protocol.
markerValueMade: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    spec: ztypes.tid
} out bool is {
    if (reg.typetypeOf typeId: spec) != ztypes.ztypetype.protocolType then return true
    known: ctx.markerValues.get key: spec
    match (
        known
    ) case some then return known case none then null
    names: List String
    ids: ListVal ztypes.tid
    nameIds: ListVal zast.nameid
    protoChildMethods :ast :reg :typing tid: spec :names :ids :nameIds
    made: ids.length > 0
    nid: zast.nodeid
    nn: typing.nodeType.length
    for nid.u32.u64 < nn loop {
        nid = nid.next
        if made.not when (ztyping.nodeTypeAt tbl: typing.nodeType :nid) == spec then {
            made = makesMarkerValue :ast :reg :typing :nid
        }
    }
    if made.not then {
        for each su: typing.standInOf.iterateItems loop {
            if su.value.spec == spec then made = true
        }
    }
    ctx.markerValues.set key: spec value: made
    return made
}

# makesMarkerValue -- the node, typed by a marker protocol, makes a value of
# it: a call (`Pinned.create from: g`) or an implementation label read (`g.pinned`).
# A type written in a signature or an `as` block is typed by the marker too, and
# makes nothing.
makesMarkerValue: function {
    ast: Ast.view reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view nid: zast.nodeid
} out bool is {
    n: ast.nodes.get i: nid
    if n.call then return true
    if n.dottedpath.not then return false
    pt: ztyping.nodeTypeAt tbl: typing.nodeType nid: n.parent
    cn: zast.atomNameIdOf n: (ast.nodes.get i: n.child)
    return (zenv.isImplementationLabelOf ty: typing :reg tid: pt nameId: cn)
}

# emitImplementationImpl -- one implementation row's helper set: a wrapper per spec
# method (casts the `void*` data to the impl and calls the impl's method), the
# static vtable, and the creates. A protocol's are a borrowed create (the data
# is the value, no destroy) and an owned create/destroy (the value heap-boxed,
# freed with the impl's destroy on drop). A facet's is one copy-create, serving
# `.create` and `.borrow` alike: a facet copies its source, and its impls are
# valtypes, so it has no heap and no destroy.
emitImplementationImpl: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    implTid: ztypes.tid
    specTid: ztypes.tid
    label: StringView
    isFacet: bool
    buf: String.borrow
} is {
    # a native mono (str) is boxed per instance, on demand (boxLabelFor); any
    # other instance implements by a row of its own (emitInstanceImplementationImpls).
    # A facet has no native implementer: only a type declaring it implements.
    isNat: (nativeImplementerRow :reg tid: implTid).notZero
    if isFacet then {
        if (reg.isGenericOf tid: implTid) then return
    } else if (originTidOf :reg tid: implTid).notZero when isNat.not then {
        ownLbl: implementationLabelFor :typing :implTid protoTid: specTid
        if ownLbl.length == 0 then return
    }
    implBase: spelledCname :ctx tid: implTid
    implCtype: implStructC :reg :typing :ctx tid: implTid
    specBase: spelledCname :ctx tid: specTid
    specCtype: "\{specBase}_t"
    vtableCtype: "\{specBase}_vtable_t"
    wbase: "\{implBase}_\{label}"
    mnames: List String
    mids: ListVal ztypes.tid
    midsNm: ListVal zast.nameid
    protoChildMethods :ast :reg :typing tid: specTid names: mnames ids: mids nameIds: midsNm
    mi: u64
    mn: mnames.length
    for mi < mn loop {
        mname: mnames.get i: mi
        mnameId: midsNm.get i: mi
        smid: mids.get i: mi
        # the slot this wrapper would fill was omitted: a member naming the
        # interface's own type is not dispatchable
        if (specMemberIsSelfTyped :ast :reg :typing ifaceTid: specTid :smid) then {
            mi = mi + 1
            continue
        }
        ret: methodRetCtype :ast :reg :typing :ctx mid: smid
        wparams: "void* _data".string
        # every method takes its receiver by pointer now, in both families
        cargs: "_self".string
        pnames: List String
        pids: ListVal ztypes.tid
        pidsNm: ListVal zast.nameid
        recFieldLists :ast :reg :typing tid: smid names: pnames ids: pids nameIds: pidsNm
        pi: u64
        pn: pnames.length
        for pi < pn loop {
            pid: pids.get i: pi
            isThis: (pidsNm.get i: pi) == zast.wellKnown.slot.wkThis
            # A marked receiver is an ALIAS (`{t: this.view}`), so neither its
            # name nor its type says `this`. The registry records which
            # parameter IS the receiver; that is the question to ask, and it is
            # the same one methodReceiverIsView asks.
            rpnW: reg.thisParamNameIdOf tid: smid
            if rpnW.notZero when (pidsNm.get i: pi) == rpnW then isThis = true
            if isThis.not then {
                pct: protoParamCtype :ast :reg :typing :ctx :pid
                pnmP: (
                    memberC
                    :ast
                    :reg
                    :typing
                    :ctx
                    owner: smid
                    kind: memberkind.param
                    nameId: (pidsNm.get i: pi)
                )
                wparams.append ", "
                wparams.append pct
                wparams.append " "
                wparams.append pnmP
                cargs.append ", "
                cargs.append pnmP
            }
            pi = pi + 1
        }
        implMc: implMethodCname :reg :typing :ctx :implTid :mnameId mname: mname.stringView
        retkw: "return ".string
        if ret.length == 0 then {
            retkw = "".string
            ret = "void".string
        }
        wslot: memberC :ast :reg :typing :ctx owner: specTid kind: memberkind.slot nameId: mnameId
        w0: "static \{ret} \{wbase}_\{wslot}_wrapper(\{wparams}) {\n"
        buf.append w0
        w1: "    \{implCtype}* _self = (\{implCtype}*)_data;\n"
        buf.append w1
        w2: "    \{retkw}\{implMc}(\{cargs});\n"
        # a typedef's slot served by a NATIVE implementer at the end of its
        # chain (a typedef over str) is spelled as that implementer's: the
        # typedef shares its struct, and the runtime has no function for it
        natOwner: implTid
        viaNat: isNat
        if isNat.not then {
            natOwner = ztypecheck.valOpOwner :typing tid: implTid nameId: mnameId
            natRow: nativeImplementerRow :reg tid: natOwner
            if natOwner != implTid when natRow.notZero then viaNat = true
        }
        if viaNat then {
            nbc: nativeBoxCall :reg :ctx implTid: natOwner mname: mname.stringView :mnameId
            w2 = "    \{retkw}\{nbc};\n"
        }
        buf.append w2
        buf.append "}\n\n"
        mi = mi + 1
    }
    vi0: "static \{vtableCtype} \{wbase}_vtable = {\n"
    buf.append vi0
    # a marker's vtable is its one placeholder member, initialised as C17 asks
    if mn == 0 then buf.append "    0\n"
    mj: u64
    for mj < mn loop {
        # the row for a member with no slot: there is nothing to point at
        if (specMemberIsSelfTyped :ast :reg :typing ifaceTid: specTid smid: (mids.get i: mj)) then {
            mj = mj + 1
            continue
        }
        rslot: (
            memberC
            :ast
            :reg
            :typing
            :ctx
            owner: specTid
            kind: memberkind.slot
            nameId: (midsNm.get i: mj)
        )
        vrow: "    .\{rslot} = \{wbase}_\{rslot}_wrapper,\n"
        buf.append vrow
        mj = mj + 1
    }
    buf.append "};\n\n"
    borrows: ctx.borrowBoxUses.has item: (ownedBoxKey :implTid protoTid: specTid)
    if isFacet then {
        if borrows.not then return
        fc0: "static \{specCtype} \{wbase}_create(const \{implCtype}* val) {\n    \{specCtype} facet = {0};\n    facet.vtable = &\{wbase}_vtable;\n    facet.data._i\{implTid} = *val;\n    return facet;\n}\n\n"
        buf.append fc0
        return
    }
    bc0: "static \{specCtype} \{wbase}_create(const \{implCtype}* val) {\n    \{specCtype} proto = {0};\n    proto.data = (void*)val;\n    proto.vtable = &\{wbase}_vtable;\n    proto.destroy = NULL;\n    return proto;\n}\n\n"
    if borrows then buf.append bc0
    if (ctx.ownedBoxUses.has item: (ownedBoxKey :implTid protoTid: specTid)).not then return
    od0: "static void \{wbase}_owned_destroy(void* p) {\n"
    buf.append od0
    ofn: destroyFnC :reg :typing :ctx tid: implTid
    if ofn.length > 0 then {
        buf.append "    "
        buf.append ofn
        buf.append "((\{implCtype}*)p);\n"
    }
    buf.append "    free(p);\n}\n\n"
    preludeNeed :ctx memb: "@xmalloc"
    oc0: "static \{specCtype} \{wbase}_create_owned(\{implCtype}* val) {\n    \{specCtype} proto = {0};\n    \{implCtype}* boxed = (\{implCtype}*)z_xmalloc(sizeof(\{implCtype}));\n    *boxed = *val;\n    proto.data = boxed;\n    proto.vtable = &\{wbase}_vtable;\n    proto.destroy = \{wbase}_owned_destroy;\n    return proto;\n}\n\n"
    buf.append oc0
}

# nativeImplementerRow -- the type a NATIVE implementer's implementation rows name:
# the type itself (String), or the generic origin a mono was instantiated from
# (str), whose rows its instances share. 0 for every implementer the program
# declares, whose helpers its unit pass writes.
nativeImplementerRow: function {reg: ztypes.ZTypeRegistry.view tid: ztypes.tid} out ztypes.tid is {
    rowTid: tid
    og: originTidOf :reg :tid
    if og.notZero then rowTid = og
    if (reg.isNativeOf tid: rowTid) then return rowTid
    return ztypes.tid.zero
}

# noteBoxUse -- written C makes a `protoTid` value of an `implTid`: its
# implementation row's helpers are written (emitImplementationImplsForType), and both
# types are spelled.
noteBoxUse: function {
    typing: ztyping.ZTyping.view ctx: Ctx implTid: ztypes.tid protoTid: ztypes.tid
} is {
    ri: ztypes.confid
    for ri.next < typing.nextConf loop {
        ri = ri.next
        hit: false
        {
            row: typing.implementation.get i: ri
            hit = (row.implTypeId == implTid) and (row.specTypeId == protoTid)
        }
        if hit.not then continue
        if (ctx.boxedImplementation.has item: ri) then return
        ctx.boxedImplementation.add item: ri
        if ctx.reachFixed.not then {
            ctx.typeUses.add item: implTid
            ctx.typeUses.add item: protoTid
        }
        return
    }
}

# noteOwnedBoxUse -- written C boxes an `implTid` as an OWNED `protoTid` value
# (`_create_owned`): the pair's owned create and destroy are written, and the
# impl's destructor with them (demandWrittenDestroys)
noteOwnedBoxUse: function {ctx: Ctx implTid: ztypes.tid protoTid: ztypes.tid} is {
    ctx.ownedBoxUses.add item: (ownedBoxKey :implTid :protoTid)
}

# noteBorrowBoxUse -- written C boxes an `implTid` as a borrowed `protoTid`
# value, or copies it into a `protoTid` facet (`_create`): the pair's create is
# written (emitImplementationImpl)
noteBorrowBoxUse: function {ctx: Ctx implTid: ztypes.tid protoTid: ztypes.tid} is {
    ctx.borrowBoxUses.add item: (ownedBoxKey :implTid :protoTid)
}

# ownedBoxKey -- the (impl, protocol) pair as one ownedBoxUses key
ownedBoxKey: function {implTid: ztypes.tid protoTid: ztypes.tid} out u64 is {
    return implTid.u64 * 4294967296 + protoTid.u64
}

# boxLabelFor -- implementationLabelFor at a site that boxes `implTid` as
# `protoTid`. A native implementer is looked up through the row its origin
# carries, and the pair is recorded: nothing else would ever write its helpers.
boxLabelFor: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    implTid: ztypes.tid
    protoTid: ztypes.tid
} out String is {
    nrow: nativeImplementerRow :reg tid: implTid
    if nrow.isZero then {
        noteBoxUse :typing :ctx :implTid :protoTid
        return (implementationLabelFor :typing :implTid :protoTid)
    }
    lbl: implementationLabelFor :typing implTid: nrow :protoTid
    if lbl.length == 0 then return lbl
    if ctx.reachFixed.not then {
        ctx.typeUses.add item: implTid
        ctx.typeUses.add item: protoTid
    }
    seen: false
    for each nb: ctx.nativeBoxes loop {
        if nb.impl == implTid when nb.proto == protoTid then seen = true
    }
    if seen.not then ctx.nativeBoxes.append (nativebox impl: implTid proto: protoTid)
    return lbl
}

# nativeBoxCall -- a wrapper's call of a NATIVE implementer's method, spelled the
# way a call site spells it: the runtime has no function behind the method for
# a vtable slot to point at. `stringView`, StringViewable's one member, is the only one a
# native implementer declares; any other is refused rather than emitted as a
# call to nothing.
nativeBoxCall: function {
    reg: ztypes.ZTypeRegistry.view
    ctx: Ctx
    implTid: ztypes.tid
    mname: StringView
    # the member's name id, `stringView` being the one a native box answers
    mnameId: zast.nameid
} out String is {
    if mnameId == zast.wellKnown.slot.wkStringView then {
        if implTid == ctx.strTid then return (svValueFormPtr :ctx expr: "_self")
        if (originIsTid :reg tid: implTid originTid: (ctx.origins.get i: family.slot.str)) then {
            svT: svTypeC :ctx
            return "((\{svT}){ .data = _self->data, .size = _self->len })"
        }
    }
    (
        emitFail
        :ctx
        what: "a native implementer boxed as a protocol whose member '\{mname}' it has no C spelling for"
        line: 0
    )
    return "".string
}

# emitNativeImplementationImpls -- the helpers of every native implementer a box
# site asked for (boxLabelFor), one set per (impl, protocol) pair.
emitNativeImplementationImpls: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    buf: String.borrow
} is {
    ni: u64
    for ni < ctx.nativeBoxes.length loop {
        implT: (ctx.nativeBoxes.get i: ni).impl
        protoT: (ctx.nativeBoxes.get i: ni).proto
        ni = ni + 1
        nrow: nativeImplementerRow :reg tid: implT
        lbl: implementationLabelFor :typing implTid: nrow protoTid: protoT
        (
            emitImplementationImpl
            :ast
            :reg
            :typing
            :ctx
            implTid: implT
            specTid: protoT
            label: lbl.stringView
            isFacet: false
            :buf
        )
    }
}

# implementationLabelFor -- the as-block label under which implTid satisfies
# protoTid (e.g. "myreader"); "" when not found.
implementationLabelFor: function {
    typing: ztyping.ZTyping.view
    implTid: ztypes.tid
    protoTid: ztypes.tid
} out String is {
    res: String
    cfId: ztypes.confid
    for cfId.next < typing.nextConf loop {
        cfId = cfId.next
        row: typing.implementation.get i: cfId
        if row.implTypeId == implTid when row.specTypeId == protoTid when (
            res.length == 0
        ) then res.append row.label
    }
    return res
}

# nativeMethodOwnerOf -- the class type id `nid` stamps to when that class
# supplies `mname` as a NATIVE member, else 0. A native member has no body to
# emit, which is what makes the call a fragment call. The member's own
# declaration decides, never the defining unit's name: that would admit every
# type the unit declares, and call a user unit spelled `cli` or `os`'s bodied
# methods as fragments.
nativeMethodOwnerOf: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    nid: zast.nodeid
    mnId: zast.nameid
} out ztypes.tid is {
    return (nativeMethodOwnerOfTid :reg :typing tid: (stampIdOf :typing :nid) :mnId)
}

# nativeMethodOwnerOfTid -- `tid` when it is a non-generic class whose member
# `mnId` is native; 0 otherwise
nativeMethodOwnerOfTid: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    mnId: zast.nameid
} out ztypes.tid is {
    if tid.isZero then return ztypes.tid.zero
    if (reg.typetypeOf typeId: tid) != ztypes.ztypetype.classType then return ztypes.tid.zero
    fileOrig: originTidOf :reg :tid
    if fileOrig.notZero then return ztypes.tid.zero
    mo: typing.declChildOfId parentTypeId: tid nameId: mnId
    if mo.some when (reg.isNativeOf tid: mo) then return tid
    return ztypes.tid.zero
}

# poolIdOf -- the interned id of `text` in the program's name pool, 0 when the
# program spells no such name
poolIdOf: function {ast: Ast.view text: StringView} out zast.nameid is {
    return (zast.poolFind pool: ast.names :text)
}

# rowOfFn -- the row implementing native function `fid` (rowNameOfFn); 0 when
# no row does
rowOfFn: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx.view fid: ztypes.tid
} out u64 is {
    return (ctx.rows.ofName n: (rowNameOfFn :reg :typing :ctx :fid))
}

# rowNameOfFn -- the key of the row implementing native function `fid`, an
# instance of a generic one by its template's: in the file implementing the
# unit that declares it (a hidden subunit's or an inline unit's members are
# their file unit's, ztypecheck.unitDeclOfTid), its name and, for a member of a
# type, the type's. No file (impl 0) when the program reaches none for it.
rowNameOfFn: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx.view fid: ztypes.tid
} out zemitrows.rowname is {
    none: zemitrows.rowname impl: 0 typeName: zast.nameid.zero name: zast.nameid.zero
    d: originTidOf :reg tid: fid
    if d.isZero then d = fid
    if (reg.isNativeOf tid: d).not then return none
    did: typing.declIdOfType typeId: d
    if did.isZero then return none
    impl: (
        ctx.rows.fileOfUnit
        ud: (ztypecheck.unitDeclOfTid :reg :typing tid: d)
    )
    if impl == 0 then return none
    dc: typing.decls.get i: did
    tn: zast.nameid
    if dc.parent.notZero then {
        pd: typing.decls.get i: dc.parent
        if pd.kind.unitDecl.not then tn = pd.name
    }
    return (zemitrows.rowname :impl typeName: tn name: dc.name)
}

# rowNameOfMember -- the key of the row implementing member `name` of type
# `owner` (an operator, a conversion, a native method): in the file
# implementing the unit that declares the type, the type's name and the
# member's. No file (impl 0) when the program reaches none for it.
rowNameOfMember: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    owner: ztypes.tid
    name: zast.nameid
} out zemitrows.rowname is {
    none: zemitrows.rowname impl: 0 typeName: zast.nameid.zero name: zast.nameid.zero
    did: typing.declIdOfType typeId: owner
    if did.isZero then return none
    impl: (
        ctx.rows.fileOfUnit
        ud: (ztypecheck.unitDeclOfTid :reg :typing tid: owner)
    )
    if impl == 0 then return none
    return (zemitrows.rowname :impl typeName: (typing.decls.get i: did).name :name)
}

# rowLabel -- row key `n` as `zc natives show` addresses it, `<unit>.<key>`,
# written in one allocation
rowLabel: function {ctx: Ctx.view ast: Ast.view n: zemitrows.rowname} out String is {
    owner: ctx.demands.nameText id: (ctx.rows.unitOfFile impl: n.impl)
    nm: zast.nameTextAt :ast ref: n.name
    tl: u64
    if n.typeName.notZero then tl = (zast.nameTextAt :ast ref: n.typeName).length + 1
    r: String
    r.reserve n: owner.length + tl + nm.length + 1
    r.append owner
    r.append "."
    if n.typeName.notZero then {
        r.append (zast.nameTextAt :ast ref: n.typeName)
        r.append "."
    }
    r.append nm
    return r
}

# methodFragRow -- the row implementing native method `mfid` when a fragment
# implements it, its C the fragment's function; 0 otherwise
methodFragRow: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx.view mfid: ztypes.tid
} out u64 is {
    row: rowOfFn :reg :typing :ctx fid: mfid
    if row == 0 then return 0
    if (ctx.rows.rows.get i: row).fragment.not then return 0
    return row
}

# noteTmplMemberUse -- written C calls member `mnId` of templated class instance
# `cid`: that section of its template is written (rtSectionPlan)
noteTmplMemberUse: function {ast: Ast.view ctx: Ctx cid: ztypes.tid mnId: zast.nameid} is {
    mn: zast.nameTextAt :ast ref: mnId
    noteMemberUse :ctx mono: cid member: (ctx.memberWords.slotOf text: mn.stringView)
}

# nativeMethodCallOpen -- `<class>_<method>(<receiver>`, the open call of a
# native method's fragment function, which the caller closes after its
# arguments
nativeMethodCallOpen: function {fc: StringView mn: StringView recv: StringView} out String is {
    return "\{fc}_\{mn}(\{recv}"
}

# demandNativeRow -- what calling the method fragment row `row` implements
# demands: its unit's runtime, and the row's own demands -- none for a
# `uses_<Type>` or `destroys_<Type>` row, which loads with its type's use or
# destructor -- plus the runtime its body needs
demandNativeRow: function {ctx: Ctx row: u64} is {
    r: ctx.rows.rows.get i: row
    needsAddKey :ctx key: (ctx.demands.unitOf owner: r.owner)
    if r.typeTid.isZero then demandRowKeys :ctx :row
    rowNeedsAdd :ctx :row cond: condAlways
}

# demandRowKeys -- fragment row `row`'s own demands, each met in every
# configuration
demandRowKeys: function {ctx: Ctx row: u64} is {
    r: ctx.rows.rows.get i: row
    k: r.demandFrom
    for k < r.demandTo loop {
        needsAddKey :ctx key: (ctx.rows.demandKeys.get i: k)
        k = k + 1
    }
}

# demandMemberNeeds -- written C, a lowering by hand of member `mnId` of
# instance `mono`, calls what the member's row needs: the row of the member's
# declaration on the instance's template
demandMemberNeeds: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    mono: ztypes.tid
    mnId: zast.nameid
} is {
    o: originTidOf :reg tid: mono
    if o.isZero then o = mono
    row: ctx.rows.ofName n: (rowNameOfMember :reg :typing :ctx owner: o name: mnId)
    if row > 0 then rowNeedsAdd :ctx :row cond: condAlways
}

# stdDeclDemanded -- written C calls the standard declaration `member` of
# unit `stdUnit` (well-known name ids; ztypecheck.stdDeclRo), which the emitter
# lowers by hand: its demand, by its declaring unit and its name, was met
stdDeclDemanded: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    stdUnit: zast.nameid
    member: zast.nameid
} out bool is {
    fid: ztypecheck.stdDeclRo :ast :typing :stdUnit :member
    if fid.isZero then return false
    did: typing.declIdOfType typeId: fid
    if did.isZero then return false
    nm: zast.poolTextAt pool: ast.names ref: (typing.decls.get i: did).name
    return (
        (ctx.demands.atNamed owner: (definedInUnitName :reg :typing tid: fid) name: nm.stringView) >
        0
    )
}

# demandSvMember -- written C calls the C of StringView member `nameId` (a
# view native reached on a String, StringView or text receiver): the demands
# of the member's row, found by its declaration on the StringView type
demandSvMember: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx nameId: zast.nameid
} is {
    row: ctx.rows.ofName n: (rowNameOfMember :reg :typing :ctx owner: ctx.svTid name: nameId)
    if row > 0 then demandRowKeys :ctx :row
}

# demandMethodRow -- what calling native method `mfid` demands, through the
# fragment row that implements it (demandNativeRow); nothing when none does
demandMethodRow: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx mfid: ztypes.tid
} is {
    row: methodFragRow :reg :typing :ctx :mfid
    if row > 0 then demandNativeRow :ctx :row
}

# nativeMethodArgForm -- how a native method's fragment takes a parameter of type
# `pid`. ONE C RULE, decided by the type: a value view (a StringView, a
# StringLike generic's view, a ByteView or ListView) BY VALUE, as a free
# function's and a protocol slot's are -- `.view` is an ownership marker, not a
# C convention; an owned collection by address; anything else by value
nativeMethodArgForm: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx pid: ztypes.tid
} out argform is {
    if pid == ctx.svTid then return argform.viewed
    if (reg.typetypeOf typeId: pid) == ztypes.ztypetype.genericParam then return argform.viewed
    if (isValueViewTid :reg :typing :ctx tid: pid) then return argform.viewed
    if (
        isCollectionOriginTid
        :ctx
        originTid: (originTidOf :reg tid: (chaseAggregateTypedef :reg :typing :ctx tid: pid))
    ) then {
        return argform.addressed
    }
    return argform.labelled
}

# isValueViewTid -- `tid`, through a typedef (ByteView), is a ListView: a
# 16-byte {length, data} view of storage something else owns, which C takes by
# value wherever it is passed
isValueViewTid: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view ctx: Ctx.view tid: ztypes.tid
} out bool is {
    # a spec or core alias param is a SHELL named after the system type, which
    # canonicalises before it chases (protoParamCtype)
    c: tid
    if (definedInUnitTid :reg :typing :tid).isZero then {
        rc: canonTypeId :reg :typing :tid
        if rc.notZero then c = rc
    }
    return (isListViewOriginOf :reg :ctx tid: (chaseAggregateTypedef :reg :typing :ctx tid: c))
}

# nativeCallRecvNode -- the node of a native method call's receiver: a variable
# (`f.close`) or a field path (`this.c.load`); 0 for any other receiver, which
# has no address to pass
nativeCallRecvNode: function {ast: Ast.view calr: astnode.view} out zast.nodeid is {
    if (dottedBaseAtom :ast n: calr).length > 0 then return (dottedBaseNodeId :ast n: calr)
    rn: dottedParentNodeId n: calr
    if rn.isZero or (ast.nodes.get i: rn).dottedpath.not then return zast.nodeid
    return rn
}

# nativeCallRecvExpr -- the receiver a native method takes by pointer: the
# variable `bn` (its C name, through an alias), or the field path's place
nativeCallRecvExpr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    calr: astnode.view
    bn: StringView
    bnid: zast.nodeid
} out String is {
    if bn.length == 0 then {
        rF: cfacts
        rt: emitDottedReceiver :ast :reg :typing :ctx callable: calr facts: rF
        if (dottedReceiverIsPtr :ast :reg :typing :ctx callable: calr) then return rt
        return "&(\{rt})"
    }
    recvVid: atomVid :typing nid: bnid
    recv: aliasResolveAt :reg :typing :ctx nid: bnid name: bn vid: recvVid
    recvV: ztypes.vid
    if recv.stringView == bn then recvV = recvVid
    recvF: cfacts
    recvC: (
        emitLocalAtomNameAt
        :ast
        :reg
        :typing
        :ctx
        nid: bnid
        name: bn
        vid: recvVid
        facts: recvF
    )
    if (isPtrVid :ctx vid: recvV) then return recvC
    return "&\{recvC}"
}

# nativeValueRecvNode -- the receiver of a native method call that a call
# computes -- `(xs.getMut i: k).close`, a templated class's value -- when the
# call has no variable or field path receiver (`bnid` 0); 0 otherwise. Whether
# the method is native is the caller's question (nativeMethodOwnerOf), as for
# every other receiver.
nativeValueRecvNode: function {calr: astnode.view bnid: zast.nodeid} out zast.nodeid is {
    if bnid.notZero then return zast.nodeid
    return (dottedParentNodeId n: calr)
}

# nativeValueRecvExpr -- the address a native method takes a receiver a call
# computes by: the value bound to a temporary first (callBaseTemp); "" for no
# such receiver (`recvNid` 0)
nativeValueRecvExpr: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the receiver's class
    cid: ztypes.tid
    recvNid: zast.nodeid
} out String is {
    if recvNid.isZero then return "".string
    rvF: cfacts
    rv: emitExprWith :ast :reg :typing :ctx n: (ast.nodes.get i: recvNid) facts: rvF
    rvt: (
        callBaseTemp
        :ast
        :reg
        :typing
        :ctx
        nlid: cid
        base: rv.stringView
        baseF: rvF
        nstPtr: false
        baseNid: recvNid
    )
    if rvt.length > 0 then rv = rvt.take
    return "&(\{rv})"
}

# nativeCallOwner -- the class whose native method a call on receiver `bnid`
# names: the receiver's own class; a templated class's instance, whose template
# defines every method; or, for a receiver a call computes (`valRecv`), the
# class that declares the method. 0 when the method is not a class's native.
nativeCallOwner: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    bnid: zast.nodeid
    valRecv: zast.nodeid
    mnId: zast.nameid
    # the class that declares the method
    ownerTid: ztypes.tid
} out ztypes.tid is {
    cid: nativeMethodOwnerOf :reg :typing nid: bnid :mnId
    if cid.notZero then return cid
    it: stampIdOf :typing nid: bnid
    if (tmplClassRowOf :reg :ctx tid: it) > 0 then return it
    if valRecv.isZero then return ztypes.tid.zero
    return (nativeMethodOwnerOfTid :reg :typing tid: ownerTid :mnId)
}

# emitClassNativeCall -- a call of a class's NATIVE method that a
# fragment row implements: `<class>_<method>(&recv, args...)`, the receiver by
# pointer and each argument as its parameter's type says (nativeMethodArgForm),
# built in the order the arguments are written. The row decides, not the
# member's name: a unit gaining a native method is a declaration, a row and a
# fragment. "" for any other callee.
emitClassNativeCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    # the class that declares the method, for a receiver whose own stamp does
    # not name it (a computed one: a borrow of an element)
    ownerTid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    calr: ast.nodes.get i: call.callable
    bn: dottedBaseAtom :ast n: calr
    bnid: nativeCallRecvNode :ast :calr
    valRecv: nativeValueRecvNode :calr :bnid
    if bnid.isZero then bnid = valRecv
    if bnid.isZero then return "".string
    mnId: aliasChildNameId :ast :typing n: calr
    cid: nativeCallOwner :reg :typing :ctx :bnid :valRecv :mnId :ownerTid
    if cid.isZero then return "".string
    # a templated class's methods are its template's (emitTmplClassMono), under
    # the instance's own name, with no row of their own
    tmplInst: (tmplClassRowOf :reg :ctx tid: cid) > 0
    mtid: (typing.declChildOfId parentTypeId: cid nameId: mnId).or d: ztypes.tid.zero
    if mtid.isZero then return "".string
    if tmplInst.not then {
        row: methodFragRow :reg :typing :ctx mfid: mtid
        if row == 0 then return "".string
        demandNativeRow :ctx :row
    }
    if tmplInst then noteTmplMemberUse :ast :ctx :cid :mnId
    fc: spelledCname :ctx tid: cid
    recvExpr: nativeValueRecvExpr :ast :reg :typing :ctx :cid recvNid: valRecv
    if valRecv.isZero then recvExpr = nativeCallRecvExpr :ast :reg :typing :ctx :calr :bn :bnid
    pNames: List String
    pIds: ListVal ztypes.tid
    pNameIds: ListVal zast.nameid
    recFieldLists :ast :reg :typing tid: mtid names: pNames ids: pIds nameIds: pNameIds
    mn: zast.nameTextAt :ast ref: mnId
    # the receiver is parameter 0; a method taking nothing else is a plain call
    np: pNames.length
    if np < 2 then {
        c0: nativeMethodCallOpen fc: fc.stringView mn: mn.stringView recv: recvExpr.stringView
        c0.append ")"
        return (stating :facts from: callFacts text: c0)
    }
    # each argument into its parameter's slot, in the order they are written
    na: np - 1
    argNameIds: ListVal zast.nameid
    k: u64
    for k < na loop {
        argNameIds.append (pNameIds.get i: k + 1)
        k = k + 1
    }
    wbase: orderPositions :ast :ctx :call nameIds: argNameIds labelsOnly: true
    ord: orderBegin :ctx slots: na
    done: u64
    for done < na loop {
        best: orderNextParam :ctx base: wbase
        pnb: argNameIds.get i: best
        lnid: ctorArgNodeByLabel :ast :call label: pnb
        if lnid.isZero when (
            typing.declHasDefaultId
            parentTypeId: mtid
            nameId: pnb
        ) then {
            # an argument the call leaves out is its declared default
            dmk: pendingHoistMark :ctx
            dF: cfacts
            dt: (
                paramDefaultText
                :ast
                :reg
                :typing
                :ctx
                cco: mtid
                nameId: pnb
                pid: (pIds.get i: best + 1)
                facts: dF
            )
            (
                orderArgAtWith
                :ast
                :reg
                :typing
                :ctx
                st: ord
                mark: dmk
                text: dt
                tf: dF
                nid: zast.nodeid
                byPtr: false
                slot: best
            )
        } else {
            fm: (
                nativeMethodArgForm
                :reg
                :typing
                :ctx
                pid: (pIds.get i: best + 1)
            )
            # a template's function takes every argument by value, as a slot holds
            # it (@@T@@), a collection included
            if tmplInst when fm == argform.addressed then fm = argform.labelled
            (
                orderLabelArg
                :ast
                :reg
                :typing
                :ctx
                :call
                label: pnb
                form: fm
                nid: lnid
                slot: best
                :ord
            )
        }
        done = done + 1
    }
    orderDropPositions :ctx base: wbase
    r: orderFinish :ctx st: ord
    opened: r.length > 0
    r.append (nativeMethodCallOpen fc: fc.stringView mn: mn.stringView recv: recvExpr.stringView)
    r.append ", "
    r.append (orderJoinSlots :ctx st: ord count: na)
    r.append ")"
    if opened then r.append ")"
    orderEnd :ctx st: ord
    return (stating :facts from: callFacts text: r)
}

# tmplInstMemberRead -- a templated class's native method read as a member of
# an instance: its template's function (emitClassNativeRead), ahead of the
# class leg, which would name the template's member; "" for anything else
tmplInstMemberRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    inst: ztypes.tid
    mnId: zast.nameid
    bn2: StringView
    bn2v: ztypes.vid
    facts: cfacts.borrow
} out String is {
    if (tmplClassRowOf :reg :ctx tid: inst) == 0 then return "".string
    tmo: typing.declChildOfId parentTypeId: inst nameId: mnId
    if tmo.none then return "".string
    if (reg.isNativeOf tid: tmo).not then return "".string
    return (
        emitClassNativeRead
        :ast
        :reg
        :typing
        :ctx
        cid: inst
        :mnId
        mfid: tmo
        recv: bn2
        recvVid: bn2v
        :facts
    )
}

# emitClassNativeRead -- a native method written as a member read (`f.close`,
# `db.transaction`) that a fragment row implements: `<class>_<method>(&recv)`,
# each parameter past the receiver its declared default. cli's classes keep
# their own legs. "" otherwise.
emitClassNativeRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    cid: ztypes.tid
    mnId: zast.nameid
    # the method's own type
    mfid: ztypes.tid
    recv: StringView
    recvVid: ztypes.vid
    facts: cfacts.borrow
} out String is {
    if (reg.typetypeOf typeId: cid) != ztypes.ztypetype.classType then return "".string
    # an instance of a templated class reads through its template's function,
    # which no row of its own implements
    tmplInst: (tmplClassRowOf :reg :ctx tid: cid) > 0
    if tmplInst.not when (originTidOf :reg tid: cid).notZero then return "".string
    row: u64
    if tmplInst.not then {
        row = methodFragRow :reg :typing :ctx :mfid
        if row == 0 then return "".string
    }
    pNames: List String
    pIds: ListVal ztypes.tid
    pNameIds: ListVal zast.nameid
    recFieldLists :ast :reg :typing tid: mfid names: pNames ids: pIds nameIds: pNameIds
    # every parameter past the receiver must have a default, which the read
    # passes: `db.transaction` begins in transaction's default mode
    k: 1.u64
    for k < pNames.length loop {
        if (typing.declHasDefaultId parentTypeId: mfid nameId: (pNameIds.get i: k)
        ).not then return "".string
        k = k + 1
    }
    if tmplInst.not then demandNativeRow :ctx :row
    # a templated class's member is a section of its template (noteMemberUse)
    if tmplInst then noteTmplMemberUse :ast :ctx :cid :mnId
    fc: spelledCname :ctx tid: cid
    rexp: "&\{recv}"
    if (isPtrVid :ctx vid: recvVid) then rexp = recv.string
    c1: (
        nativeMethodCallOpen
        fc: fc.stringView
        mn: (zast.nameTextAt :ast ref: mnId).stringView
        recv: rexp.stringView
    )
    k = 1
    for k < pNames.length loop {
        dF: cfacts
        c1.append ", "
        c1.append (
            paramDefaultText
            :ast
            :reg
            :typing
            :ctx
            cco: mfid
            nameId: (pNameIds.get i: k)
            pid: (pIds.get i: k)
            facts: dF
        )
        k = k + 1
    }
    c1.append ")"
    return (stating :facts from: callFacts text: c1)
}

# viewArgCoerce -- the emitted value-view argument bound by `label`, projected
# to a by-value view when the arg is an owned String (TextWriter's StringLike
# param; ByteView args pass through unchanged). A non-lvalue
# String temp hoists for scope-exit free.
viewArgCoerce: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    label: zast.nameid
    av: StringView
    avF: cfacts
    facts: cfacts.borrow
} out String is {
    for each argId: (zast.kidsOf :ast span: call.arguments) loop {
        fa: ast.nodes.get i: argId
        if fa.namedoperation then {
            faOpNode: ast.nodes.get i: fa.operation
            if fa.name == label then {
                stampTid: (
                    stampIdOf
                    :typing
                    nid: (interpPartNodeId n: (ast.nodes.get i: fa.operation))
                )
                if stampTid == ctx.strTid then {
                    fh: (
                        hoistBorrowValArgWith
                        :ast
                        :reg
                        :typing
                        :ctx
                        argNid: (zast.nodeIdOf n: faOpNode)
                        :av
                        :avF
                        pid: ctx.strTid
                        paramTake: false
                    )
                    fb: av.string
                    stateFacts :facts from: avF
                    if fh.length > 0 then {
                        fb = fh.take
                        stateFacts :facts from: pathFacts
                    }
                    fbq: atomVidIfPlain :ast :reg :typing :ctx n: faOpNode text: fb.stringView
                    return (
                        svValueForm
                        :ast
                        :reg
                        :typing
                        :ctx
                        expr: fb.stringView
                        isStr: true
                        vid: fbq
                        :facts
                    )
                }
            }
        }
    }
    return (stating :facts from: avF text: av.string)
}

# argBaseAtom / argBaseNodeId -- the base of a native create's argument. The
# dotted extractors take the base of a PATH, as a `.borrow`-suffixed argument
# is; a `borrow` parameter needs no suffix, so the argument can arrive as a
# BARE atom, which is its own base. Without the fallback the emitter
# builds `z_t0__create(&)` -- an unresolved type and an empty expression -- which
# typechecks clean and dies at gcc.
argBaseAtom: function {ast: Ast.view n: astnode.view} outx StringView is {
    b: dottedBaseAtom :ast :n
    if b.length > 0 then return b
    t: atomTextOf :ast :n
    if t.length > 0 then return t
    # the `:name` shorthand is a THIRD shape, and the one `zl fmt` writes
    # whenever the label and the variable agree -- so a hand-written
    # `bag: bag` becomes `:bag` on the next format and the base disappeared
    # with it. The label IS the value's name here.
    if n.labelvalue then return (zast.nameTextAt :ast ref: n.name).stringView
    return ""
}

# the node an argument's value ultimately comes from, unwrapping the
# wrappers between
argBaseNodeId: function {ast: Ast.view n: astnode.view} out zast.nodeid is {
    i: dottedBaseNodeId :ast :n
    if i.notZero then return i
    a: atomNodeId :n
    if a.notZero then return a
    # the `:name` shorthand carries its own stamp on its own row
    if n.labelvalue then return n.nodeid
    return zast.nodeid
}

# argBoundTo -- the position in the call of the argument that binds parameter
# slot `slot` (argSlotList's answer per argument); the list's length when none
# does.
argBoundTo: function {slots: (ListVal u64).view slot: u64} out u64 is {
    i: u64
    for i < slots.length loop {
        if (slots.get :i) == slot then return i
        i = i + 1
    }
    return slots.length
}

# callArgOperationAt -- the value node of the call's argument at position `i`;
# 0 past the end.
callArgOperationAt: function {ast: Ast.view call: zast.callrow.view i: u64} out zast.nodeid is {
    if i >= call.arguments.count then return zast.nodeid
    a: ast.nodes.get i: (zast.kidAt kids: ast.kids span: call.arguments :i)
    if a.namedoperation then return a.operation
    return zast.nodeid
}

# nativeCreateArg -- one argument of a native create, by its parameter's type: a
# protocol parameter takes the argument boxed as that protocol; a borrowed
# class parameter takes the argument's address; any other takes it as written
# (a `.take` String by value).
nativeCreateArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    # the create function, whose parameter `label` is
    create: ztypes.tid
    label: zast.nameid
    # the call argument that binds the parameter, by its position in the call
    # (argBoundTo): its label's, or an unlabelled one's by its place
    argAt: u64
    ptid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    prtid: canonTypeId :reg :typing tid: ptid
    i: u64
    for i < call.arguments.count loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments :i
        i = i + 1
        a: ast.nodes.get i: aId
        if a.namedoperation when (i - 1) == argAt then {
            if (reg.typetypeOf typeId: prtid) == ztypes.ztypetype.protocolType then {
                # an implementer is boxed as the protocol it stands in for, as at
                # any other slot (standInText); a value that already is the
                # protocol passes as it stands, a header by value
                aF: cfacts
                sit: (
                    standInText
                    :ast
                    :reg
                    :typing
                    :ctx
                    n: (ast.nodes.get i: a.operation)
                    text: (
                        emitExprWith
                        :ast
                        :reg
                        :typing
                        :ctx
                        n: (ast.nodes.get i: a.operation)
                        facts: aF
                    )
                    facts: aF
                )
                return (stating :facts from: aF text: sit)
            }
            if (reg.typetypeOf typeId: prtid) == ztypes.ztypetype.classType when (
                typing.declIsBorrowedFieldId
                parentTypeId: create
                nameId: label
            ) then {
                a2op: ast.nodes.get i: a.operation
                ab2: argBaseAtom :ast n: a2op
                argBaseNode: argBaseNodeId :ast n: a2op
                argBaseVid: atomVid :typing nid: argBaseNode
                argBaseC: (
                    aliasResolveAt
                    :reg
                    :typing
                    :ctx
                    nid: argBaseNode
                    name: ab2
                    vid: argBaseVid
                )
                ab2v: ztypes.vid
                if argBaseC.stringView == ab2 then ab2v = argBaseVid
                abr2F: cfacts
                abr2C: (
                    emitLocalAtomNameAt
                    :ast
                    :reg
                    :typing
                    :ctx
                    nid: argBaseNode
                    name: ab2
                    vid: argBaseVid
                    facts: abr2F
                )
                if (isPtrVid :ctx vid: ab2v) then return (stating :facts from: abr2F text: abr2C)
                return (stating :facts from: (addrFacts e: abr2F) text: "&\{abr2C}")
            }
            return (ctorArgTextAt :ast :reg :typing :ctx aid: a.operation :facts)
        }
    }
    return (stating :facts from: constFacts text: "0".string)
}

# emitNativeCreate -- `X.create ...` of a class whose native `create` its row
# writes as `<X>_create`: `io.BufWriter.create to: w capacity: 16` ->
# z_t{id}_create(<args in parameter order>). "" when X declares no create.
emitNativeCreate: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    # the class whose `create` is called
    cid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    crid: (
        (typing.declChildOfId parentTypeId: cid nameId: zast.wellKnown.slot.wkCreate).or
        d: ztypes.tid.zero
    )
    if crid.isZero then return "".string
    demandMethodRow :reg :typing :ctx mfid: crid
    pnames: List String
    pids: ListVal ztypes.tid
    pidsNm: ListVal zast.nameid
    recFieldLists :ast :reg :typing tid: crid names: pnames ids: pids nameIds: pidsNm
    pn: pnames.length
    wbase: orderPositions :ast :ctx :call nameIds: pidsNm labelsOnly: true
    slots: argSlotList :ast :call fpNameIds: pidsNm
    ord: orderBegin :ctx slots: pn
    k: u64
    for k < pn loop {
        pi: orderNextParam :ctx base: wbase
        k = k + 1
        mk: pendingHoistMark :ctx
        astrF: cfacts
        argAt: argBoundTo :slots slot: pi
        astr: (
            nativeCreateArg
            :ast
            :reg
            :typing
            :ctx
            :call
            create: crid
            label: (pidsNm.get i: pi)
            :argAt
            ptid: (pids.get i: pi)
            facts: astrF
        )
        anid: callArgOperationAt :ast :call i: argAt
        (
            orderArgAtWith
            :ast
            :reg
            :typing
            :ctx
            st: ord
            mark: mk
            text: astr
            tf: astrF
            nid: anid
            byPtr: false
            slot: pi
        )
    }
    orderDropPositions :ctx base: wbase
    oprefix: orderFinish :ctx st: ord
    args: orderJoinSlots :ctx st: ord count: pn
    orderEnd :ctx st: ord
    wcn: spelledCname :ctx tid: cid
    typeUseAdd :ctx tid: cid
    wcn.append "_create"
    return (
        stating
        :facts
        from: callFacts
        text: (orderClose prefix: oprefix callee: wcn.stringView args: args.stringView)
    )
}

# nativeNoArgOf -- the unit that DECLARES `base.memb` when the member is a
# native taking no parameters, so a no-paren read auto-calls it (os.pid,
# io.stdout). "" otherwise. The gates run cheapest first: nearly every dotted
# path has a non-unit base and stops at the registry lookup, and the shadow
# check -- a declaration of the base name in `unitName` displaces the unit,
# since name ids are pooled program-wide -- runs only once a native is in
# hand.
nativeNoArgOf: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the path's base node
    baseId: zast.nodeid
    membId: zast.nameid
} out String is {
    ud14x: baseFileUnitDecl :reg :typing :baseId
    if ud14x.isZero then return "".string
    fo: ztypecheck.resolvedByIdsRo :ast :typing unitDecl: ud14x name: membId
    calleeTid: ztypes.tid
    match (
        fo
    ) case some then {
        calleeTid = fo
    } case none then {
        return "".string
    }
    if (reg.typetypeOf typeId: calleeTid) != ztypes.ztypetype.functionType then return "".string
    if (reg.isNativeOf tid: calleeTid).not then return "".string
    pi: ListVal ztypes.tid
    pnm: ListVal zast.nameid
    recFieldIds :reg :typing tid: calleeTid ids: pi nameIds: pnm
    if pi.length > 0 then return "".string
    duo: definedInUnitName :reg :typing tid: calleeTid
    if duo.length == 0 then return "".string
    return duo.string
}

# noArgNativeRhs -- a binding RHS that is a bare zero-parameter native
# auto-call (os.args / os.envNames return an owned List, so the binding's List
# branch must emit the call, not a fresh empty list).
noArgNativeRhs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    unitName: StringView
    n: astnode.view
} out bool is {
    match (
        n
    ) case statementline then {
        return (
            noArgNativeRhs
            :ctx
            :ast
            :reg
            :typing
            :unitName
            n: (ast.nodes.get i: n.statementline)
        )
    } case dottedpath then {
        nu: (
            nativeNoArgOf
            :ast
            :reg
            :typing
            baseId: n.parent
            membId: (aliasOrChildId :ast :typing aliasId: n.nodeid childId: n.child)
        )
        return nu.length > 0
    } else {
        return false
    }
}

# lowerNativeArg -- lower one native-call argument from the DECLARED
# parameter: StringView / StringLike-generic params take a by-value view
# (String args project, interpolations hoist to a view); class and
# borrowed-List params pass by pointer; take params pass the owned value;
# scalars pass verbatim.
lowerNativeArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
    pnameId: zast.nameid
    pid: ztypes.tid
    op: astnode.view
    facts: cfacts.borrow
} out String is {
    isViewP: (pid == ctx.svTid) or ((reg.typetypeOf typeId: pid) == ztypes.ztypetype.genericParam)
    if isViewP then {
        avh: emitColInterpArg :ast :reg :typing :ctx n: op consumes: false
        if avh.length > 0 then {
            # the interpolation's hoisted temp, viewed
            stateFacts :facts from: pathFacts
            return (
                svValueForm
                :ast
                :reg
                :typing
                :ctx
                expr: avh.stringView
                isStr: true
                vid: ztypes.vid.zero
                :facts
            )
        }
        av0F: cfacts
        av0: emitExprWith :ast :reg :typing :ctx n: op facts: av0F
        if (stampIsStr :typing :ctx nid: (interpPartNodeId n: op)) then {
            hb: (
                hoistBorrowValArgWith
                :ast
                :reg
                :typing
                :ctx
                argNid: (zast.nodeIdOf n: op)
                av: av0.stringView
                avF: av0F
                pid: ctx.strTid
                paramTake: false
            )
            if hb.length > 0 then {
                av0 = hb.take
                av0F = pathFacts
            }
            av0q: atomVidIfPlain :ast :reg :typing :ctx n: op text: av0.stringView
            stateFacts :facts from: av0F
            return (
                svValueForm
                :ast
                :reg
                :typing
                :ctx
                expr: av0.stringView
                isStr: true
                vid: av0q
                :facts
            )
        }
        # a view held through a pointer -- a method's receiver handed on -- is
        # passed as the view it points at
        if (pathIsPointer :ast :reg :typing :ctx n: op) then return (
            stating
            :facts
            from: av0F
            text: "(*\{av0})"
        )
        return (stating :facts from: av0F text: av0)
    }
    iv: emitInterpArgExpr :ast :reg :typing :ctx n: op
    # an interpolation built where it is evaluated, as a call's result is
    if iv.length > 0 then return (stating :facts from: callFacts text: iv)
    isTake: paramTakesArg :typing :fid :pnameId
    needAmp: false
    if isTake.not then {
        if (isReftypeParam :reg :typing :ctx tid: pid) then needAmp = true
        if (isListPtrParam :reg :typing :ctx :fid :pnameId tid: pid) then needAmp = true
        if (markedValtypeRefParam :reg :typing :fid :pnameId :pid) then needAmp = true
    }
    av1F: cfacts
    av1: emitExprWith :ast :reg :typing :ctx n: op facts: av1F
    # by value: a path that is a pointer -- a method's receiver handed on
    # (`viewBytes s: t`) -- passes the value it points at
    if needAmp.not when (pathIsPointer :ast :reg :typing :ctx n: op) then {
        return (stating :facts from: av1F text: "(*\{av1})")
    }
    # by reference: a value with no address (`outbuf.byteView`) is hoisted first,
    # as every by-reference argument is (emitByrefArgWith)
    if needAmp when (pathIsPointer :ast :reg :typing :ctx n: op).not then {
        return (
            emitByrefArgWith
            :ast
            :reg
            :typing
            :ctx
            av: av1.stringView
            avF: av1F
            :pid
            argNid: (zast.nodeIdOf n: op)
            :facts
        )
    }
    return (stating :facts from: av1F text: av1)
}

# emitNativeArg -- find one native-call argument by label, else by the
# positional cursor, and lower it (lowerNativeArg).
emitNativeArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    fid: ztypes.tid
    pnameId: zast.nameid
    pid: ztypes.tid
    usePos: bool
    posIdx: u64
    facts: cfacts.borrow
} out String is {
    seen: u64
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation then {
            al: zast.nameTextAt :ast ref: a.name
            if usePos then {
                if al.length == 0 then {
                    if seen == posIdx then {
                        return (
                            lowerNativeArg
                            :ast
                            :reg
                            :typing
                            :ctx
                            :fid
                            :pnameId
                            :pid
                            op: (ast.nodes.get i: a.operation)
                            :facts
                        )
                    }
                    seen = seen + 1
                }
            } else {
                if a.name == pnameId then {
                    return (
                        lowerNativeArg
                        :ast
                        :reg
                        :typing
                        :ctx
                        :fid
                        :pnameId
                        :pid
                        op: (ast.nodes.get i: a.operation)
                        :facts
                    )
                }
            }
        }
    }
    # an argument the call leaves out is its declared default
    if (typing.declHasDefaultId parentTypeId: fid nameId: pnameId) then {
        return (paramDefaultText :ast :reg :typing :ctx cco: fid nameId: pnameId :pid :facts)
    }
    return (stating :facts from: constFacts text: "0".string)
}

# emitNativeFreeFnCall -- ANY call (dotted `io.remove ...`, a bare sibling
# `remove ...` inside the unit, or a call through a hidden subunit's name
# `arith.addVV ...`) whose callee `fid` RESOLVED to an `is native` FREE function
# that a fragment implements emits `z_<unit>_<name>(<args>)`, each argument
# lowered from the declared parameter (emitNativeArg). The unit is the one that
# DECLARES the callee, never the spelled base: a hidden subunit's members belong
# to their parent, which is the key the rows and checkNativesResolve use.
# A generic native (collections.stringJoin) arrives as its instance and is
# called by the template's name. A row with a body and no fragment is the body,
# filled as a method's row is (nativeBodyFill) with @A1@, @A2@, ... the
# arguments in declared order. "" for anything else: bodied siblings fall
# through to the id-cname route, methods to their own legs, natives with no
# row of their own (print, panic) to theirs.
emitNativeFreeFnCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    fid: ztypes.tid
    facts: cfacts.borrow
} out String is {
    calr: ast.nodes.get i: call.callable
    mn: ""
    if (dottedBaseAtom :ast n: calr).length > 0 then {
        mn = aliasChildName :ast :typing n: calr
    } else {
        mn = atomTextOf :ast n: calr
    }
    if mn.length == 0 then return "".string
    if (reg.typetypeOf typeId: fid) != ztypes.ztypetype.functionType then return "".string
    if (reg.isNativeOf tid: fid).not then return "".string
    duo: definedInUnitName :reg :typing tid: fid
    if duo.length == 0 then return "".string
    rowKey: rowNameOfFn :reg :typing :ctx :fid
    row: ctx.rows.ofName n: rowKey
    if row == 0 then return "".string
    r: ctx.rows.rows.get i: row
    un: duo.string
    # a function a templated class implements is the template function of the
    # instance it answers
    callee: "z_\{un}_\{mn}"
    viaMember: rowVia :ctx :r
    # the row's body, when the row is one rather than a fragment's function
    body: rtid
    if viaMember.length > 0 then {
        viaInst: stampIdOf :typing nid: call.nodeid
        noteMemberUse :ctx mono: viaInst member: (ctx.memberWords.slotOf text: viaMember.stringView)
        callee = "\{spelledCname :ctx tid: viaInst}_\{viaMember}"
    } else if r.fragment.not then {
        body = r.body
        if body.isZero then return "".string
        ctx.rt.ready id: body
    }
    needsAddM :ctx uname: un.stringView memb: "@unit"
    if body.isZero then needsAddM :ctx uname: un.stringView memb: mn
    rowNeedsAdd :ctx :row cond: condAlways
    pn: List String
    pidl: ListVal ztypes.tid
    pidlNm: ListVal zast.nameid
    recFieldLists :ast :reg :typing tid: fid names: pn ids: pidl nameIds: pidlNm
    # a via function's parameter types, which an argument is lowered to
    viaTids: ListVal ztypes.tid
    if viaMember.length > 0 then {
        (
            viaParams
            :ast
            :reg
            :typing
            :call
            member: viaMember.stringView
            names: pidlNm
            tids: viaTids
        )
    }
    m: pn.length
    wbase: orderPositions :ast :ctx :call nameIds: pidlNm labelsOnly: false
    ord: orderBegin :ctx slots: m
    # an argument a body names twice is read into a temporary first; a free
    # function has no receiver, so its slot 0 is @A1@
    if body.notZero then orderNamesTwiceArgs :ctx st: ord :body count: m firstHole: 1
    (
        orderNativeFreeArgs
        :ast
        :reg
        :typing
        :ctx
        :call
        :fid
        :ord
        :wbase
        count: m
        :pidl
        :pidlNm
        :viaTids
    )
    orderDropPositions :ctx base: wbase
    oprefix: orderFinish :ctx st: ord
    if body.notZero then {
        rn: ListVal zast.nameid
        rv: List String
        nativeHoleValues t: ctx st: ord count: m firstHole: 1 names: rn vals: rv
        orderEnd :ctx st: ord
        adr: rowLabel :ctx :ast n: rowKey
        filled: (
            nativeBodyFill
            :ast
            :reg
            :typing
            :ctx
            :call
            :body
            key: adr.stringView
            argIds: rn
            argVals: rv
        )
        return (stating :facts from: callFacts text: (orderWrap prefix: oprefix call: filled))
    }
    args: orderJoinSlots :ctx st: ord count: m
    orderEnd :ctx st: ord
    return (
        stating
        :facts
        from: callFacts
        text: (orderClose prefix: oprefix callee: callee.stringView args: args.stringView)
    )
}

# orderNativeFreeArgs -- a native free function's `count` arguments lowered from
# their declared parameters (emitNativeArg), in written order, into the slots of
# the call `ord` opened; a via function's argument converted to the template
# function's parameter type (viaArgText).
orderNativeFreeArgs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    fid: ztypes.tid
    ord: orderstate.borrow
    wbase: u64
    count: u64
    pidl: (ListVal ztypes.tid).view
    pidlNm: (ListVal zast.nameid).view
    viaTids: (ListVal ztypes.tid).view
} is {
    k: u64
    for k < count loop {
        j: orderNextParam :ctx base: wbase
        k = k + 1
        mk: pendingHoistMark :ctx
        avF: cfacts
        av: (
            emitNativeArg
            :ast
            :reg
            :typing
            :ctx
            :call
            :fid
            pnameId: (pidlNm.get i: j)
            pid: (pidl.get i: j)
            usePos: (ctorHasLabel :ast :call label: (pidlNm.get i: j)).not
            posIdx: (ctx.orderPosAt.get i: wbase + j)
            facts: avF
        )
        wr: ctx.orderWrit.get i: wbase + j
        anid: zast.nodeid
        if wr > 0 then anid = writtenArgNode :ast :call pos: wr - 1
        vbx: viaArgText :ast :reg :typing :ctx :viaTids :pidl :j :anid av: av.stringView :avF
        if vbx.length > 0 then {
            av = vbx.take
            avF = callFacts
        }
        (
            orderArgAtWith
            :ast
            :reg
            :typing
            :ctx
            st: ord
            mark: mk
            text: av
            tf: avF
            nid: anid
            byPtr: false
            slot: j
        )
    }
}

# rowVia -- the member row `r` (a native free function's) names `via`; ""
# when it names none
rowVia: function {ctx: Ctx.view r: zemitrows.nativerow} out String is {
    if r.via.isZero then return String
    return (ctx.demands.nameText id: r.via).string
}

# viaArgText -- argument `j`, of a call whose template function takes the types
# `viaTids`, boxed where that function takes a protocol (viaBoxArg); "" when it
# passes as it stands
viaArgText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    viaTids: (ListVal ztypes.tid).view
    pidl: (ListVal ztypes.tid).view
    j: u64
    anid: zast.nodeid
    av: StringView
    avF: cfacts
} out String is {
    if j >= viaTids.length then return "".string
    # the argument's own type: a generic native arrives as its template
    vat: pidl.get i: j
    if anid.notZero then vat = stampIdOf :typing nid: anid
    return (
        viaBoxArg
        :ast
        :reg
        :typing
        :ctx
        paramTid: vat
        targetTid: (viaTids.get i: j)
        :av
        :avF
        argNid: anid
    )
}

# viaParams -- the types the template function a `via=` native call runs takes
# for the call's parameters `names`, as an `ARG.` hole names them: the member
# `member` of the instance the call answers
viaParams: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    call: zast.callrow.view
    member: StringView
    names: (ListVal zast.nameid).view
    tids: ListVal ztypes.tid
} is {
    mid: tmplHoleNameId :ast text: member
    if mid.isZero then return
    inst: stampIdOf :typing nid: call.nodeid
    for each pn: names loop tids.append (tmplArgOf :reg :typing :inst mnId: mid pid: pn)
}

# viaBoxArg -- an argument of type `paramTid` a `via=` native passes where its
# template function takes the protocol `targetTid`: boxed, owned, through the
# argument's implementation (`spawn`'s task, which the handle's `create` takes as a
# Task value). "" when the two types are one, or the target is no protocol.
viaBoxArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    paramTid: ztypes.tid
    targetTid: ztypes.tid
    av: StringView
    avF: cfacts
    argNid: zast.nodeid
} out String is {
    if paramTid == targetTid then return "".string
    if (reg.typetypeOf typeId: targetTid) != ztypes.ztypetype.protocolType then return "".string
    lbl: boxLabelFor :reg :typing :ctx implTid: paramTid protoTid: targetTid
    if lbl.length == 0 then return "".string
    addr: "&\{av}"
    if avF.place.not then {
        tmpNm: hoistForAddress :ast :reg :typing :ctx :av tid: paramTid :argNid
        addr = "&\{tmpNm}"
    }
    noteOwnedBoxUse :ctx implTid: paramTid protoTid: targetTid
    return "\{spelledCname :ctx tid: paramTid}_\{lbl}_create_owned(\{addr})"
}

# emitResultCombinator -- inline lowering of the built-in combinators `.orPanic`
# (unwrap the ok payload or abort) and `.or d:` (unwrap or default) on a
# `resultval` receiver, and `.or d:` on an `optionval` one (the variants are
# the only types declaring them; the `Result` and `Option` unions' C shapes
# have no tagged arm to project). Branchless statement-expression, no result
# struct call. "" when the call is not one of these.
emitResultCombinator: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    mnId: aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable)
    isP: false
    if mnId == zast.wellKnown.slot.wkOrPanic then isP = true
    isO: false
    if mnId == zast.wellKnown.slot.wkOr then isO = true
    bothMiss: isP.not
    if bothMiss when isO.not then return "".string
    bnid: zast.nodeid
    cnDp: ast.nodes.get i: call.callable
    if cnDp.dottedpath then bnid = cnDp.parent
    if bnid.isZero then return "".string
    baseTid: stampIdOf :typing nid: (interpPartNodeId n: (ast.nodes.get i: bnid))
    rtid: chaseAggregateTypedef :reg :typing :ctx tid: baseTid
    if rtid.isZero then return "".string
    isRes: originIsTid :reg tid: rtid originTid: (ctx.origins.get i: family.slot.resultval)
    isOpt: originIsTid :reg tid: rtid originTid: (ctx.origins.get i: family.slot.optionval)
    if isRes.not when isOpt.not then return "".string
    # `orPanic` is resultval's alone
    if isP when isRes.not then return "".string
    payArmId: zast.wellKnown.slot.wkOk
    if isOpt then payArmId = zast.wellKnown.slot.wkSome
    recvExprF: cfacts
    recvExpr: valueExprC :ast :reg :typing :ctx n: (ast.nodes.get i: bnid) facts: recvExprF
    if recvExpr.length == 0 then return "".string
    okTag: spelledTagConst :ast :ctx :reg :typing tid: rtid armId: payArmId
    rcT: spelledCname :ctx tid: rtid
    if isP then return (
        orPanicExprC
        :ast
        :reg
        :typing
        :ctx
        tid: rtid
        recv: recvExpr
        recvF: recvExprF
        recvNid: bnid
        :facts
    )
    argN: call.arguments.count.u64
    if argN == 0 then return "".string
    firstArgId: zast.kidAt kids: ast.kids span: call.arguments i: 0
    opId: zast.nodeid
    a: ast.nodes.get i: firstArgId
    if a.namedoperation then opId = a.operation
    if opId.isZero then return "".string
    dExprF: cfacts
    dExpr: valueExprC :ast :reg :typing :ctx n: (ast.nodes.get i: opId) facts: dExprF
    if dExpr.length == 0 then return "".string
    payC: memberC :ast :reg :typing :ctx owner: rtid kind: memberkind.arm nameId: payArmId
    # the receiver is read for its tag and then its payload
    rcCType: "\{rcT}_t"
    pre: String
    spelled: (
        orderOnePart
        :ast
        :reg
        :typing
        :ctx
        mark: (pendingHoistMark :ctx)
        text: recvExpr
        tf: recvExprF
        nid: bnid
        ctype: rcCType.stringView
        constant: false
        twice: true
        prefix: pre
    )
    r: spelled.stringView
    ro: "(\{r}.tag == \{okTag.stringView} ? \{r}.data.\{payC} : (\{dExpr.stringView}))"
    return (stating :facts from: callFacts text: (orderWrap prefix: pre call: ro))
}

# iterCallValueArg -- the C text of `.call`'s one argument, the per-call
# input. The resume value goes by REFERENCE when it is a reftype -- the
# synthesised `.call` declares that parameter as a pointer. Decided by the
# TYPE, never by the argument's spelling (a `borrow` parameter's bare-name
# argument needs its `&` too); a `.borrow`-suffixed argument reaches the same
# answer through argBaseAtom.
iterCallValueArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the argument's value node
    vop: astnode.view
} out String is {
    ve: emitExpr :ast :reg :typing :ctx n: vop
    vbase: argBaseAtom :ast n: vop
    if vbase.length == 0 then return ve
    vbnid: argBaseNodeId :ast n: vop
    if (isReftypeParam :reg :typing :ctx tid: (stampIdOf :typing nid: vbnid)).not then return ve
    valueBaseVid: atomVid :typing nid: vbnid
    vbr: aliasResolveAt :reg :typing :ctx nid: vbnid name: vbase vid: valueBaseVid
    vbv: ztypes.vid
    if vbr.stringView == vbase then vbv = valueBaseVid
    if (isPtrVid :ctx vid: vbv) then return ve
    return "&\{ve}"
}

# emitUserIterCall -- a manual `g.call value: X` on a user iterator class (a
# generator's iter): `z_t{id}_{Fn}_iter_call(&g, X)`; a `.borrow` value
# passes by address. "" for any non-user-iter `.call`.
emitUserIterCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable)
    if bn.length == 0 then return "".string
    mnId: aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable)
    if mnId != zast.wellKnown.slot.wkCall then return "".string
    bnid: dottedBaseNodeId :ast n: (ast.nodes.get i: call.callable)
    recvTid: stampIdOf :typing nid: bnid
    if recvTid.isZero then return "".string
    iterId: recvTid
    if (reg.typetypeOf typeId: iterId) != ztypes.ztypetype.classType then return "".string
    if (originTidOf :reg tid: iterId).notZero then return "".string
    if iterId.isZero then return "".string
    cco: typing.declChildOfId parentTypeId: iterId nameId: zast.wellKnown.slot.wkCall
    if cco.none then return "".string
    # an iterator's `call` is a METHOD; a function FIELD named `call` is a value
    # the class stores, called as any other field is
    if (typing.declIsFnptrFieldId parentTypeId: iterId nameId: zast.wellKnown.slot.wkCall) then {
        return "".string
    }
    callC: spelledCname :ctx tid: cco
    recvVid: atomVid :typing nid: bnid
    recvText: aliasResolveAt :reg :typing :ctx nid: bnid name: bn vid: recvVid
    recvV: ztypes.vid
    if recvText.stringView == bn then recvV = recvVid
    recvF: cfacts
    recvC: (
        emitLocalAtomNameAt
        :ast
        :reg
        :typing
        :ctx
        nid: bnid
        name: bn
        vid: recvVid
        facts: recvF
    )
    recvExpr: "&\{recvC}"
    if (isPtrVid :ctx vid: recvV) then recvExpr = recvC.take
    # `.call` takes at most ONE argument -- the per-call input -- so the first
    # one IS it, whatever the author labelled it.
    for each argId: (zast.kidsOf :ast span: call.arguments) loop {
        atomVarId: ast.nodes.get i: argId
        if atomVarId.namedoperation then {
            valArg: (
                iterCallValueArg
                :ast
                :reg
                :typing
                :ctx
                vop: (ast.nodes.get i: atomVarId.operation)
            )
            return (stating :facts from: callFacts text: "\{callC}(\{recvExpr}, \{valArg})")
        }
    }
    return (stating :facts from: callFacts text: "\{callC}(\{recvExpr})")
}

# isDispatchableTid -- a vtable-dispatch receiver type: protocol or facet.
isDispatchableTid: function {reg: ztypes.ZTypeRegistry.view tid: ztypes.tid} out bool is {
    tt: reg.typetypeOf typeId: tid
    if tt == ztypes.ztypetype.protocolType then return true
    return tt == ztypes.ztypetype.facetType
}

# vtableDataArg -- the receiver argument a vtable slot takes. A protocol's
# `data` is already a pointer to the boxed impl; a facet stores the impl INLINE
# in a union, so the slot takes its address -- cast, since a facet reached
# through a `.view` pointer is const and the slot takes `void*` (the checker
# refuses a writing method there).
vtableDataArg: function {recv: StringView acc: StringView isFacet: bool} out String is {
    if isFacet then return "(void*)&\{recv}\{acc}data"
    return "\{recv}\{acc}data"
}

# leafMoves -- a path's leaf is `.take` or `.hold`, the markers that move their
# source.
leafMoves: function {ast: Ast.view leaf: zast.nodeid} out bool is {
    k: zast.markerKindOfLeaf :ast :leaf
    return k.takeMarker or k.holdMarker
}

# vtableAutoCallName -- a member that dispatches through the vtable. `create`
# and every ownership marker (`.take`, `.hold`, `.borrow`, `.drop`, ...) are
# emitted by their own legs and name no vtable slot -- a marker is a reserved
# word, so no spec declares a method by its name.
vtableAutoCallName: function {ast: Ast.view leaf: zast.nodeid nameId: zast.nameid} out bool is {
    if nameId == zast.wellKnown.slot.wkCreate then return false
    return (zast.markerKindOfLeaf :ast :leaf).unmarked
}

# vtableAutoCallC -- a ZERO-ARG method auto-call on a protocol/facet receiver.
# A zero-arg method is not a Call node, so it never reaches
# emitProtocolDispatch; this is the same dispatch spelled for the dotted-path
# legs.
vtableAutoCallC: function {
    # the member names
    ast: Ast.view
    # the checked program
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the emission context the slot is spelled through
    ctx: Ctx
    # the interface whose slot is called
    owner: ztypes.tid
    recv: StringView
    acc: StringView
    # the slot's name
    mnId: zast.nameid
    isFacet: bool
} out String is {
    sl: memberC :ast :reg :typing :ctx :owner kind: memberkind.slot nameId: mnId
    return (vtableCallC :recv :acc slot: sl.stringView :isFacet argTail: "")
}

# vtableCallC -- the dispatch itself: `recv.vtable->slot(dataArg, args...)`.
# Four plain values and a ready-made argument tail, so every call form can
# reach it. emitProtocolDispatch builds a tail out of a callrow's arguments; an
# operator's one operand is already emitted by the time emitOperatorAt runs, so
# it passes that. An operator IS the call form for a one-argument method, and
# it dispatches through the same three spellings the slot, the wrapper and the
# vtable row come from.
vtableCallC: function {
    recv: StringView
    acc: StringView
    # the slot's C name (memberC)
    slot: StringView
    isFacet: bool
    argTail: StringView
} out String is {
    dargs: vtableDataArg :recv :acc :isFacet
    return "\{recv}\{acc}vtable->\{slot}(\{dargs}\{argTail})"
}

# dispatchReceiverTid -- the dispatchable type a protocol receiver stands for
# when method `mn` is called on it: its own stamp when that dispatches -- a
# typedef's through the link that owns `mn` (typedefMethodOwner), so its own
# method stays its own and every other member dispatches as its end's -- else
# the canonical type behind it.
dispatchReceiverTid: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    callable: astnode.view
    mnId: zast.nameid
} out ztypes.tid is {
    rtid: dottedReceiverStampId :ast :typing :callable
    own: typedefMethodOwner :reg :typing :ctx tid: rtid :mnId
    if (isDispatchableTid :reg tid: own) then return own
    ownerName: reg.nameOf tid: own
    if ownerName.length == 0 then return own
    brid: canonTypeId :reg :typing tid: own
    base: brid
    if (isDispatchableTid :reg tid: base) then return base
    return own
}

# dispatchSlotNames -- the vtable method's parameter name ids. The receiver is
# implicit at the call site, so it is not a slot an argument can land in;
# filtered by id, like the match itself.
dispatchSlotNames: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    rtid: ztypes.tid
    mnId: zast.nameid
} out ListVal zast.nameid is {
    mtid: (
        (typing.declChildOfId parentTypeId: rtid nameId: mnId).or
        d: ztypes.tid.zero
    )
    mpNames: List String
    mpIds: ListVal ztypes.tid
    paramNameIds: ListVal zast.nameid
    if mtid.notZero then (
        recFieldLists
        :ast
        :reg
        :typing
        tid: mtid
        names: mpNames
        ids: mpIds
        nameIds: paramNameIds
    )
    vpn: ListVal zast.nameid
    for each nmId: paramNameIds loop {
        if nmId != zast.wellKnown.slot.wkThis then vpn.append nmId
    }
    return vpn
}

# dispatchArgText -- one dispatched argument's C text. An owned collection
# argument is passed by address, unless the path already yields a pointer, and
# a value view by value; a call's value is
# bound to a temp so it has one. Sets ctx.lastArgByPtr: whether the slot takes
# the argument by pointer.
dispatchArgText: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    facts: cfacts.borrow
} out String is {
    ctx.lastArgByPtr = false
    avF: cfacts
    av: emitExprWith :ast :reg :typing :ctx :n facts: avF
    if (typing.standInOf.has key: (zast.nodeIdOf :n)) then {
        sit: standInText :ast :reg :typing :ctx :n text: av.take facts: avF
        return (stating :facts from: avF text: sit)
    }
    atid: stampIdOf :typing nid: (interpPartNodeId :n)
    apfx: String
    chasedColTid: chaseAggregateTypedef :reg :typing :ctx tid: atid
    if (chasedColTid == atid).not then apfx = "&".string
    if (
        isCollectionOriginTid
        :ctx
        originTid: (originTidOf :reg tid: atid)
    ) then apfx = "&".string
    # a value view goes by value, as the slot takes it (protoParamCtype)
    if (isValueViewTid :reg :typing :ctx tid: atid) then apfx = "".string
    ctx.lastArgByPtr = apfx.length > 0
    if (pathIsPointer :ast :reg :typing :ctx :n) then apfx = "".string
    # a value a call returns has no address: it is bound to a temp first, freed
    # when the checker's temporary owns it (a view it does not)
    if apfx.length > 0 when avF.place.not then {
        hv: (
            hoistForAddress
            :ast
            :reg
            :typing
            :ctx
            av: av.stringView
            tid: atid
            argNid: (zast.nodeIdOf :n)
        )
        return (stating :facts from: (addrFacts e: pathFacts) text: "&\{hv}")
    }
    if apfx.length > 0 then return (stating :facts from: (addrFacts e: avF) text: "&\{av}")
    return (stating :facts from: avF text: av)
}

# appendSlottedDispatchArgs -- the arguments in the vtable method's PARAMETER
# order, which is what the C function expects; a label may name a later slot.
appendSlottedDispatchArgs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    vpn: (ListVal zast.nameid).view
    dargs: String
} out String is {
    argSlots: argSlotList :ast :call fpNameIds: vpn
    ord: orderBegin :ctx slots: vpn.length
    slotIdx: u64
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation then {
            argSlot: argSlots.get i: slotIdx
            if argSlot < vpn.length then {
                (
                    orderDispatchArg
                    :ast
                    :reg
                    :typing
                    :ctx
                    op: (ast.nodes.get i: a.operation)
                    slot: argSlot
                    :ord
                )
            }
            slotIdx = slotIdx + 1
        }
    }
    orderPrefix: orderFinish :ctx st: ord
    pi: u64
    paramCount: vpn.length
    for pi < paramCount loop {
        slotText: orderSlotText t: ctx st: ord slot: pi
        if slotText.length > 0 then {
            dargs.append ", "
            dargs.append slotText
        }
        pi = pi + 1
    }
    orderEnd :ctx st: ord
    return orderPrefix
}

# appendPlainDispatchArgs -- the arguments in written order, for a method whose
# only parameter is the implicit receiver.
appendPlainDispatchArgs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    dargs: String
} out String is {
    ord: orderBegin :ctx slots: call.arguments.count
    i: u64
    w: u64
    for i < call.arguments.count loop {
        aId: zast.kidAt kids: ast.kids span: call.arguments :i
        i = i + 1
        a: ast.nodes.get i: aId
        if a.namedoperation then {
            orderDispatchArg :ast :reg :typing :ctx op: (ast.nodes.get i: a.operation) slot: w :ord
            w = w + 1
        }
    }
    prefix: orderFinish :ctx st: ord
    wi: u64
    for wi < w loop {
        vo: orderSlotText t: ctx st: ord slot: wi
        if vo.length > 0 then {
            dargs.append ", "
            dargs.append vo
        }
        wi = wi + 1
    }
    orderEnd :ctx st: ord
    return prefix
}

# orderDispatchArg -- one written argument of a vtable call, built in evaluation
# order into its slot.
orderDispatchArg: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    op: astnode.view
    slot: u64
    ord: orderstate.borrow
} is {
    mk: pendingHoistMark :ctx
    txtF: cfacts
    txt: dispatchArgText :ast :reg :typing :ctx n: op facts: txtF
    constant: orderConstantWith :ast :typing :ctx n: op tf: txtF byPtr: ctx.lastArgByPtr
    (
        orderPartWith
        :ast
        :reg
        :typing
        :ctx
        st: ord
        mark: mk
        text: txt
        tf: txtF
        :constant
        fid: ztypes.tid
        pid: ztypes.tid.zero
        pname: zast.nameid
        ctype: ""
        :slot
    )
}

# emitProtocolDispatch -- a method call on a protocol-typed receiver routes
# through the vtable: `r.read b: 5` -> `r.vtable->read(r.data, 5)`.
emitProtocolDispatch: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    mn: aliasChildName :ast :typing n: (ast.nodes.get i: call.callable)
    mnId: aliasChildNameId :ast :typing n: (ast.nodes.get i: call.callable)
    if mn.length == 0 then return "".string
    if mnId == zast.wellKnown.slot.wkCreate then return "".string
    mk: zast.markerKindOf :ast n: (ast.nodes.get i: call.callable)
    if mk.borrowMarker or mk.dropMarker then return "".string
    callableNode: ast.nodes.get i: call.callable
    rtid: dispatchReceiverTid :ast :reg :typing :ctx callable: callableNode :mnId
    if (isDispatchableTid :reg tid: rtid).not then return "".string
    recvF: cfacts
    recvText: emitDottedReceiver :ast :reg :typing :ctx callable: callableNode facts: recvF
    if recvText.length == 0 then return "".string
    # the table and the data are both read through the receiver
    recv: (
        receiverOnce
        :ast
        :reg
        :typing
        :ctx
        callable: callableNode
        text: recvText.stringView
        textF: recvF
        tid: rtid
    )
    acc: ".".string
    if (dottedReceiverIsPtr :ast :reg :typing :ctx callable: callableNode) then acc = "->".string
    dargs: (
        vtableDataArg
        recv: recv.stringView
        acc: acc.stringView
        isFacet: (reg.typetypeOf typeId: rtid) == ztypes.ztypetype.facetType
    )
    vpn: dispatchSlotNames :ast :reg :typing :rtid :mnId
    prefix: String
    if vpn.length > 0 then {
        prefix = appendSlottedDispatchArgs :ast :reg :typing :ctx :call :vpn :dargs
    } else {
        prefix = appendPlainDispatchArgs :ast :reg :typing :ctx :call :dargs
    }
    dslot: memberC :ast :reg :typing :ctx owner: rtid kind: memberkind.slot nameId: mnId
    return (
        stating
        :facts
        from: callFacts
        text: (orderWrap :prefix call: "\{recv}\{acc}vtable->\{dslot}(\{dargs})")
    )
}

# emitProtocolCreateCall -- `Reader g.take` / `Reader.create from: g.take`
# (owned, heap-box + source invalidation) or `Provider m.borrow` / `Provider m`
# (borrowed, shares the source). Both route to the impl's implementation helper for
# the protocol.
emitProtocolCreateCall: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    call: zast.callrow.view
    facts: cfacts.borrow
} out String is {
    # the projection and whether it borrows are the checker's: the call's
    # stamp is the protocol or facet, its kind whether the source borrows --
    # however it was spelled, `P.create from: d.take` or bare `P d`
    protoTid: stampIdOf :typing nid: call.nodeid
    ptt: reg.typetypeOf typeId: protoTid
    isFct: ptt == ztypes.ztypetype.facetType
    if ptt != ztypes.ztypetype.protocolType when isFct.not then return "".string
    ckP: typing.callKind.get key: call.nodeid
    borrowsP: false
    match (
        ckP
    ) case some then {
        borrowsP = ckP == zast.callkind.protocolBorrow
    } case none then return "".string
    suffix: "create_owned".string
    if borrowsP then suffix = "create".string
    # a facet copies its source either way: one helper serves both verbs
    if isFct then suffix = "create".string
    for each aId: (zast.kidsOf :ast span: call.arguments) loop {
        a: ast.nodes.get i: aId
        # the source is the `from:` argument, or the one unlabelled argument
        if a.namedoperation when a.name.isZero or (a.name == zast.wellKnown.slot.wkFrom) then {
            fop: ast.nodes.get i: a.operation
            fromBase: atomOrBaseText :ast n: fop
            # the source's type is what the checker recorded it standing in
            # as (standInOf), as every implicit box reads it -- a union a
            # subunit declares included, which the name route drops
            fromTid: ztypes.tid
            sio: typing.standInOf.get key: a.operation
            match (
                sio
            ) case some then {
                fromTid = sio.value
            } case none then {
                fromTid = (
                    canonTypeId
                    :reg
                    :typing
                    tid: (stampIdDeep :reg :typing n: (ast.nodes.get i: a.operation))
                )
            }
            if fromTid.isZero then return "".string
            implBase: spelledCname :ctx tid: fromTid
            label: boxLabelFor :reg :typing :ctx implTid: fromTid :protoTid
            if label.length == 0 then return "".string
            if borrowsP or isFct then {
                noteBorrowBoxUse :ctx implTid: fromTid :protoTid
            } else {
                noteOwnedBoxUse :ctx implTid: fromTid :protoTid
            }
            valueVid: atomVid :typing nid: (dottedBaseNodeId :ast n: fop)
            if valueVid.isZero then valueVid = atomVid :typing nid: (atomNodeId n: fop)
            valVar: aliasResolve :ctx name: fromBase vid: valueVid
            vvv: ztypes.vid
            if valVar.stringView == fromBase then vvv = valueVid
            valVarC: emitLocalAtomName :ast :reg :ctx name: fromBase vid: valueVid
            refPfx: "&".string
            if (isPtrVid :ctx vid: vvv) then refPfx = "".string
            # the source is a NAME of a VARIABLE in every spelling the
            # extractor above knows. A call with arguments has no name at
            # all -- it arrived as the empty text and the projection emitted
            # `create(&)` -- and a zero-argument one has a name that denotes
            # no variable, which emitted `&fn`. Both are calls: emit the
            # value, and bind it where its address cannot be taken.
            if (fromBase.length == 0) or valueVid.isZero then {
                fvxF: cfacts
                fvx: emitExprWith :ast :reg :typing :ctx n: fop facts: fvxF
                valVarC = fvx.copy
                refPfx = "&".string
                if fvxF.place.not then valVarC = (
                    hoistForAddress
                    :ast
                    :reg
                    :typing
                    :ctx
                    av: fvx.stringView
                    tid: fromTid
                    argNid: (zast.nodeIdOf n: fop)
                )
            }
            ce: "\{implBase}_\{label}_\{suffix}(\{refPfx}\{valVarC})"
            return (stating :facts from: callFacts text: ce)
        }
    }
    return "".string
}

# isGenericFnTid -- the id names a generic FUNCTION template, whose instances
# are emitted once per mono rather than once from the template. A generic type
# that is not a function declares itself normally, which is why the two halves
# are asked together.
isGenericFnTid: function {reg: ztypes.ZTypeRegistry.view tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    if (reg.isGenericOf :tid).not then return false
    return (reg.typetypeOf typeId: tid) == ztypes.ztypetype.functionType
}


# emitUnitImplementationImpls -- one unit body's implementation implementations, the
# protocol family then the facet one, for every type it declares that may
# implement: a class, record, union, variant or typedef.
# The name is wanted for nothing but the lookup, so it is asked by id.
emitUnitImplementationImpls: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    bodyIds: zast.kidspan
    ownerTid: ztypes.tid
    buf: String.borrow
} is {
    for each biId: (zast.kidsOf :ast span: bodyIds) loop {
        bi: ast.nodes.get i: biId
        if bi.namedoperation.not then continue
        biOp: ast.nodes.get i: bi.operation
        if (
            (isClassDef n: biOp) or
            (isRecordDef n: biOp) or
            (isUnionDef n: biOp) or
            (isVariantDef n: biOp) or
            (isTypedefDef n: biOp)
        ).not then continue
        implT: unitMemberTid :typing :ctx :ownerTid nameId: bi.name
        if implT.isZero then continue
        emitImplementationImplsForType :ast :reg :typing :ctx implTid: implT isFacet: false :buf
        emitImplementationImplsForType :ast :reg :typing :ctx implTid: implT isFacet: true :buf
    }
}


# emitRecordDefsIn -- one file unit's implementation helpers. Struct layout is NOT
# emitted here: emitUserStructsOrdered owns it, and resolves the by-value
# ordering between user types and the monos that embed them, which a per-unit
# walk in declaration order cannot.
emitRecordDefsIn: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    mainOpId: zast.nodeid
    buf: String.borrow
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: mainOpId
    # a file unit that is itself a template has nothing of its own to emit,
    # as a nested template has not (emitNestedRecordDefs): its instances carry
    # their functions and their copies of its types
    isTpl: isGenericTemplateUnitOp :ast opId: mainOpId
    if isTpl.not then {
        emitUnitImplementationImpls :ast :reg :typing :ctx :bodyIds ownerTid: ztypes.tid :buf
        emitNestedRecordDefs :ast :reg :typing :ctx :bodyIds ownerTid: ztypes.tid :buf
    }
}


# emitNestedRecordDefs -- each non-generic unit nested in one unit body, with
# ctx.nsTid set to it while its body is emitted (a generic unit's instances are
# emitted per mono).
emitNestedRecordDefs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    bodyIds: zast.kidspan
    ownerTid: ztypes.tid
    buf: String.borrow
} is {
    for each nmId: (zast.kidsOf :ast span: bodyIds) loop {
        nm: ast.nodes.get i: nmId
        if nm.namedoperation.not then continue
        nOp: nm.operation
        if (isGenericTemplateUnitOp :ast opId: nOp) then continue
        if (zast.unitOpDeclaresUnit :ast opId: nOp).not then continue
        nsTid: unitMemberTid :typing :ctx :ownerTid nameId: nm.name
        if nsTid.isZero then continue
        nb: zast.unitBodyIdsAt :ast unitId: nOp
        sns: ctx.nsTid
        ctx.nsTid = nsTid
        emitUnitImplementationImpls :ast :reg :typing :ctx bodyIds: nb ownerTid: nsTid :buf
        emitNestedRecordDefs :ast :reg :typing :ctx bodyIds: nb ownerTid: nsTid :buf
        ctx.nsTid = sns
    }
}

# unitMemberTid -- the type id a unit body's definition `nameId` names: a child of
# the nested unit `ownerTid`, or of the file unit ctx is bound to when it is 0.
unitMemberTid: function {
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    ownerTid: ztypes.tid
    nameId: zast.nameid
} out ztypes.tid is {
    owner: ownerTid
    if owner.isZero then owner = typing.declTypeOf declId: ctx.mainUnitId
    return ((typing.declChildOfId parentTypeId: owner :nameId).or d: ztypes.tid.zero)
}

# armTagValueText -- the declared discriminator of the arm named `armNameId`
# on the tagged type `tid`, as a C enumerator initialiser (" = 10"), or "" when
# the type's tag names no value for it.
#
# A list-sourced tag names its own values and the enum must carry them, or
# the declaration means nothing past the front end. The tag the compiler
# synthesizes when the author declares none names no values, so its enum keeps
# C's own numbering -- which IS the arm ordinals, the thing every other part of
# the backend already assumes.
armTagValueText: function {
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    armNameId: zast.nameid
} out String is {
    if armNameId.isZero then return "".string
    dt: (
        (typing.declChildOfId parentTypeId: tid nameId: zast.wellKnown.slot.wkTag).or
        d: ztypes.tid.zero
    )
    if dt.isZero then return "".string
    c: typing.tagArmValue tagTid: dt armName: armNameId
    if c.kind.ivalKind.not then return "".string
    iv: c.ival
    return " = \{iv}"
}


# emitVariantEq -- the variant's generated comparator: tags first, then the
# payload of the arm both carry, with that payload's own `==`; a payload-less
# variant is its tag.
emitVariantEq: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    # the variant's C name
    vc: StringView
    # the variant's arms, by name
    arms: (ListVal zast.nameid).view
    # the arms' payload ids, parallel to `arms`
    aids: (ListVal ztypes.tid).view
    # whether any arm carries a payload
    haveP: bool
    buf: String.borrow
} is {
    if (partsCallWritten :ast :reg :typing ids: aids).not then {
        writeVariantEq :ast :reg :typing :ctx :tid :vc :arms :haveP dest: buf
        return
    }
    body: String
    writeVariantEq :ast :reg :typing :ctx :tid :vc :arms :haveP dest: body
    emitEqLate :ctx cname: vc :body :buf
}

# writeVariantEq -- emitVariantEq's definition, written to `dest`.
writeVariantEq: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    vc: StringView
    # the variant's arms, by name
    arms: (ListVal zast.nameid).view
    haveP: bool
    dest: String.borrow
} is {
    dest.append "static bool \{vc}_eq(\{vc}_t a, \{vc}_t b) {\n"
    if haveP.not then {
        dest.append "    return a.tag == b.tag;\n"
        dest.append "}\n\n"
        return
    }
    dest.append "    if (a.tag != b.tag) return false;\n"
    dest.append "    switch (a.tag) {\n"
    for each qname: arms loop {
        qco: typing.declChildOfId parentTypeId: tid nameId: qname
        qc: armPayloadC :ast :reg :typing :ctx :tid arm: qname
        if qc.length > 0 when qco.some then {
            qtg: spelledTagConst :ast :ctx :reg :typing :tid armId: qname
            qnameC: memberC :ast :reg :typing :ctx owner: tid kind: memberkind.arm nameId: qname
            qsel: ".data.\{qnameC}"
            dest.append "        case \{qtg}: return "
            (
                partEqC
                :ast
                :reg
                :typing
                :ctx
                tid: qco
                lhs: "a"
                rhs: "b"
                sel: qsel.stringView
                :dest
            )
            dest.append ";\n"
        }
    }
    dest.append "        default: return true;\n"
    dest.append "    }\n"
    dest.append "}\n\n"
}

# openStructBody -- open a struct the emitter writes as an anonymous typedef,
# or as the tagged `struct X_t { ... };` a forward declaration named.
openStructBody: function {ctx: Ctx.view tid: ztypes.tid cn: StringView buf: String.borrow} is {
    if (isFwdDeclared :ctx :tid) then {
        lo: "struct \{cn}_t {\n"
        buf.append lo
    } else {
        buf.append "typedef struct {\n"
    }
}

# closeStructBody -- close what openStructBody opened: the typedef's name, or
# just the brace when the tag already named it.
closeStructBody: function {ctx: Ctx.view tid: ztypes.tid cn: StringView buf: String.borrow} is {
    if (isFwdDeclared :ctx :tid) then {
        buf.append "};\n"
    } else {
        lc: "} \{cn}_t;\n"
        buf.append lc
    }
}

# emitVariantEnum -- a variant's enum of arm tag constants: its tag type, written
# where C spells it (tagEnumWritten), or for an ordinal (`ctype` its C scalar)
# an enum that names no type -- its tag type is never spelled -- and the
# ordinal's own type where written C spells it
emitVariantEnum: function {
    ast: Ast.view
    ctx: Ctx
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    aidsNm: (ListVal zast.nameid).view
    ctype: StringView
    cn: StringView
    buf: String.borrow
} is {
    if ctype.length == 0 then {
        tsc: tagStorageCType :reg :typing :tid
        if (tagEnumWritten :ast :reg :typing :ctx :tid tsc: tsc.stringView).not then return
    }
    if ctype.length > 0 then buf.append "enum {\n" else buf.append "typedef enum {\n"
    for each aname: aidsNm loop {
        tg: spelledTagConst :ast :ctx :reg :typing :tid armId: aname
        tv: armTagValueText :typing :tid armNameId: aname
        lt: "    \{tg}\{tv},\n"
        buf.append lt
    }
    if ctype.length == 0 then {
        le: "} \{cn}_tag_t;\n"
        buf.append le
        return
    }
    buf.append "};\n"
    if (ctx.tagOnlyTypes.has item: tid).not then {
        lo: "typedef \{ctype} \{cn}_t;\n"
        buf.append lo
    }
}

# emitOneVariant -- tag enum + tagged struct (+ payload union when any
# arm carries one) + the by-tag/value eq helper.
emitOneVariant: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    if (ctx.emittedUserTypes.has item: tid) then return
    ctx.emittedUserTypes.add item: tid
    aids: ListVal ztypes.tid
    aidsNm: ListVal zast.nameid
    variantArmIds :reg :typing :tid ids: aids nameIds: aidsNm
    # An ARMLESS variant is a constraint-only marker (`anyval`): nothing can
    # ever hold one, and an empty C enum does not compile. emitUnionMono
    # carries the same guard for the union bound `AnyRef`. It did
    # not when this comment first claimed it did, and under `--eager` -- the
    # one mode that reaches a definition nothing references -- that cost every
    # program in the corpus its C.
    if aidsNm.length == 0 then return
    preEmitEmbeddedTypes :ast :reg :typing :ctx ids: aids :buf
    vc: spelledCname :ctx :tid
    # An ORDINAL is its own discriminator. The struct would hold the tag and
    # nothing else, so the type IS the tag's storage -- the enum stays for the
    # constants, which are the arm ordinals, and names no type: its tag type is
    # never spelled. The type is named only where written C spells it.
    # Comparison is `==` (rowShapeOf keys it as a scalar), so there is no
    # comparator to emit either.
    ovc: ordinalVariantCType :typing :tid
    emitVariantEnum :ast :ctx :reg :typing :tid :aidsNm ctype: ovc.stringView cn: vc.stringView :buf
    if ovc.length > 0 then return
    an: aidsNm.length
    openStructBody :ctx :tid cn: vc.stringView :buf
    tsc: tagStorageCType :reg :typing :tid
    if tsc.length == 0 then {
        lfE: "    \{vc}_tag_t tag;\n"
        buf.append lfE
    } else {
        lfD: "    \{tsc} tag;\n"
        buf.append lfD
    }
    haveP: false
    pj: u64
    for pj < an loop {
        pname: aidsNm.get i: pj
        pc: armPayloadC :ast :reg :typing :ctx :tid arm: pname
        if pc.length > 0 then {
            if haveP.not then {
                haveP = true
                buf.append "    union {\n"
            }
            pnameC: memberC :ast :reg :typing :ctx owner: tid kind: memberkind.arm nameId: pname
            lp: "        \{pc} \{pnameC};\n"
            buf.append lp
        }
        pj = pj + 1
    }
    if haveP then buf.append "    } data;\n"
    closeStructBody :ctx :tid cn: vc.stringView :buf
    if (ctx.eqUsed.has item: tid) when (eqGenerated :ast :reg :typing :ctx :tid) then {
        emitVariantEq :ast :reg :typing :ctx :tid vc: vc.stringView arms: aidsNm :aids :haveP :buf
    }
}

# objectDefIsKind -- the node defines an object of that kind. The five
# predicates below differ in the kind alone.
objectDefIsKind: function {n: astnode.view kind: zast.objectkind} out bool is {
    if n.objectdef then return n.kind == kind
    return false
}

# true when `n` is a class definition. A generator is one: its `is` fields are
# a class's fields and its `call` is a method, so it emits through the same path.
isClassDef: function {n: astnode.view} out bool is {
    if (objectDefIsKind :n kind: zast.objectkind.classDef) then return true
    return (objectDefIsKind :n kind: zast.objectkind.generatorDef)
}

# true when `n` is a record definition. A data type is one: its fields are a
# record's fields and its methods emit through the same path.
isRecordDef: function {n: astnode.view} out bool is {
    if (objectDefIsKind :n kind: zast.objectkind.recordDef) then return true
    return (objectDefIsKind :n kind: zast.objectkind.dataDef)
}

# true when `n` is a variant definition. A choice is one: its arms are a
# variant's arms, and its values are laid out as a variant's are.
isVariantDef: function {n: astnode.view} out bool is {
    if (objectDefIsKind :n kind: zast.objectkind.variantDef) then return true
    return (objectDefIsKind :n kind: zast.objectkind.choiceDef)
}

# whether a node defines a union, which decides whether its arms may carry
# reftypes
isUnionDef: function {n: astnode.view} out bool is {
    return (objectDefIsKind :n kind: zast.objectkind.unionDef)
}

# true when `n` is a `typedef` declarator, whose family is its base's.
isTypedefDef: function {n: astnode.view} out bool is {
    return (objectDefIsKind :n kind: zast.objectkind.typedefDef)
}

# structDestroyNontrivial -- the type's destructor frees at least one field.
# Mirrors emitStructDestructor's per-field tests (String, destructible
# aggregate, heap-ptr collection; borrowed fields never free). Gates call-site
# destroys for loop-owned iterator instances: an all-borrowed iterator has
# nothing to free and keeps its emission unchanged.
structDestroyNontrivial: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    fids: ListVal ztypes.tid
    fidsNm: ListVal zast.nameid
    recFieldIds :reg :typing :tid ids: fids nameIds: fidsNm
    fi: u64
    fn0: fids.length
    for fi < fn0 loop {
        fid: fids.get i: fi
        fnameId: fidsNm.get i: fi
        if (typing.declIsBorrowedFieldId parentTypeId: tid nameId: fnameId).not then {
            if fid == ctx.strTid then return true
            if (fieldIsBox :reg :fid).notZero then return true
            fmid: chaseAggregateTypedef :reg :typing :ctx tid: fid
            if (ownsResources :reg :ctx tid: fmid) then return true
            if (isHeapPtrCollection :reg :typing :ctx tid: fid) then return true
        }
        fi = fi + 1
    }
    return false
}

# fieldIsBox -- a field's type is a builtin Box: its mono id, else 0. A field's
# type is the mono its declaration minted, flagged as a box where it was minted.
fieldIsBox: function {reg: ztypes.ZTypeRegistry.view fid: ztypes.tid} out ztypes.tid is {
    if fid.isZero then return ztypes.tid.zero
    if (reg.isBoxOf tid: fid) then return fid
    return ztypes.tid.zero
}

# emitStructDestructor -- a record/class destructor freeing each heap-owning
# field: String fields via the String free, aggregate fields with a destructor
# recursively; scalars are skipped. Emitted only when the type has a destructor.
# structDestroyNontrivial mirrors the per-field tests below -- keep them in sync.
emitStructDestructor: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    fnames: (List String).view
    fids: (ListVal ztypes.tid).view
    # the fields' name ids, in step with fnames
    fnameIds: (ListVal zast.nameid).view
    buf: String.borrow
} is {
    rc: spelledCname :ctx :tid
    d0: "static void \{rc}_destroy(\{rc}_t* p);\n"
    buf.append d0
    d1: "static void \{rc}_destroy(\{rc}_t* p) {\n"
    buf.append d1
    buf.append "    if (!p) return;\n"
    fi: u64
    fn0: fnames.length
    for fi < fn0 loop {
        fid: fids.get i: fi
        # a borrowed field is a borrowed pointer -- never freed by the destructor.
        if (
            typing.declIsBorrowedFieldId
            parentTypeId: tid
            nameId: (fnameIds.get i: fi)
        ).not then {
            bxF: fieldIsBox :reg :fid
            fC: (
                memberC
                :ast
                :reg
                :typing
                :ctx
                owner: tid
                kind: memberkind.field
                nameId: (fnameIds.get i: fi)
            )
            if fid == ctx.strTid then {
                preludeNeed :ctx memb: "@String_free"
                ds: "    \{ctx.strC}_free(&p->\{fC});\n"
                buf.append ds
            } else if bxF.notZero then {
                # a Box field IS the cell's pointer: its destroy takes the value
                bxC: spelledCname :ctx tid: bxF
                dbx: "    \{bxC}_destroy(p->\{fC});\n"
                buf.append dbx
            } else {
                fslot: "p->\{fC}"
                buf.append (
                    destroyLineC
                    :reg
                    :typing
                    :ctx
                    tid: fid
                    nm: fslot.stringView
                    ind: "    "
                )
            }
        }
        fi = fi + 1
    }
    buf.append "}\n\n"
}

# storedFieldPtrC -- the C type of a non-owned reftype field, and of the
# meta_create parameter that fills it: a pointer to the container, `const`
# when the field is a `.view`, since what it reaches is only ever read.
storedFieldPtrC: function {
    typing: ztyping.ZTyping.view
    ownerTid: ztypes.tid
    fnameId: zast.nameid
    fct: StringView
} out String is {
    if (
        typing.declOwnershipIs
        parentTypeId: ownerTid
        nameId: fnameId
        own: ztypes.zparamownership.viewMode
    ) then return "const \{fct}*"
    return "\{fct}*"
}

# borrowedFieldHeldByPointer -- a borrowed field of type `fid` is stored as a
# pointer to its source: what a parameter of the type passes by pointer (a class,
# an owning union, a String, a List). A Map or a Set is its own heap pointer and
# holds that. A protocol and a view union pass BY VALUE, and a borrowed field of
# one holds that value, as the parameter does (passesByValue); a value type's
# borrowed field is refused before emission.
borrowedFieldHeldByPointer: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    fid: ztypes.tid
} out bool is {
    ftid: canonTypeId :reg :typing tid: fid
    if ftid.isZero then ftid = fid
    # a Map or a Set IS its heap pointer, and a borrowed field holds that
    if (isHeapPtrCollection :reg :typing :ctx tid: ftid) then return false
    return (passesByValue :reg :ctx tid: ftid).not
}

# storedFieldC -- the C type a field is STORED as: its own type, with a borrowed
# reftype field lowered to a pointer into its container (a protocol-typed one
# stays a fat pointer by value) and a heap collection to a pointer. "int64_t"
# stands in for a type with no C spelling of its own.
storedFieldC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    ownerTid: ztypes.tid
    fid: ztypes.tid
    fnameId: zast.nameid
} out String is {
    fct: typeRefC :ast :reg :typing :ctx tid: fid
    if fct.length == 0 then fct = "int64_t".string
    if (
        typing.declIsBorrowedFieldId
        parentTypeId: ownerTid
        nameId: fnameId
    ) when (borrowedFieldHeldByPointer :reg :typing :ctx :fid) then {
        fctP: storedFieldPtrC :typing :ownerTid :fnameId fct: fct.stringView
        fct = fctP.take
    }
    if (isHeapPtrCollection :reg :typing :ctx tid: fid) then fct = "\{fct}*"
    return fct
}

# emitRecordStructBody -- the struct's fields, in declaration order.
emitRecordStructBody: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    names: (List String).view
    ids: (ListVal ztypes.tid).view
    nameIds: (ListVal zast.nameid).view
    buf: String.borrow
} is {
    fi: u64
    for fi < names.length loop {
        fct: (
            storedFieldC
            :ast
            :reg
            :typing
            :ctx
            ownerTid: tid
            fid: (ids.get i: fi)
            fnameId: (nameIds.get i: fi)
        )
        fnameC: (
            memberC
            :ast
            :reg
            :typing
            :ctx
            owner: tid
            kind: memberkind.field
            nameId: (nameIds.get i: fi)
        )
        l1: "    \{fct} \{fnameC};\n"
        buf.append l1
        fi = fi + 1
    }
}

# recordCreateArgs -- the meta_create parameter list and the initialiser list it
# fills, in field order and comma-separated in step.
recordCreateArgs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    names: (List String).view
    ids: (ListVal ztypes.tid).view
    nameIds: (ListVal zast.nameid).view
    params: String
    inits: String
} is {
    fj: u64
    for fj < names.length loop {
        fieldC: (
            storedFieldC
            :ast
            :reg
            :typing
            :ctx
            ownerTid: tid
            fid: (ids.get i: fj)
            fnameId: (nameIds.get i: fj)
        )
        if fj > 0 then {
            params.append ", "
            inits.append ", "
        }
        pC: (
            memberC
            :ast
            :reg
            :typing
            :ctx
            owner: tid
            kind: memberkind.param
            nameId: (nameIds.get i: fj)
        )
        params.append fieldC
        params.append " "
        params.append pC
        inits.append pC
        fj = fj + 1
    }
}

# eqGenerated -- `tid` has a generated `==` and so a C `_eq`: its own `==` is
# generated and every part has an `==` of its own. The checker refused every
# comparison of a type this answers false for. Answered once per type.
eqGenerated: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} out bool is {
    if (ctx.eqAsked.has item: tid) then return (ctx.eqHasBody.has item: tid)
    # a valtype cannot hold itself; asking first keeps a malformed chain finite
    ctx.eqAsked.add item: tid
    src: (
        ztypecheck.valOpSource
        :ast
        :reg
        :typing
        :tid
        nameId: zast.wellKnown.slot.wkOpEq
    )
    if src.generated.not then return false
    parts: ListVal ztypes.tid
    ztypecheck.valPartTids :reg :typing :tid :parts
    ok: true
    i: u64
    for i < parts.length while ok loop {
        ok = partHasEq :ast :reg :typing :ctx tid: (parts.get :i)
        i = i + 1
    }
    if ok then ctx.eqHasBody.add item: tid
    return ok
}

# noteEqUse -- written C calls the generated `==` of `tid` (its `_eq`), so it
# is written, and so is each part's its body calls (partEqC): demanded now, so
# the set is whole before the first type is written. A call that arrives after
# its type was written names a function that is never written.
noteEqUse: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} is {
    t: ztypecheck.typedefChaseTid :typing :tid
    # String's and StringView's `==` are pieces of their runtime fragments
    if t == ctx.strTid then preludeNeed :ctx memb: "@String_eq"
    if (isViewLaid :ctx tid: t) then preludeNeed :ctx memb: "@StringView_eq"
    if (ctx.eqUsed.has item: t) then return
    if (ctx.emittedUserTypes.has item: t) then {
        cn: ctxCname :ctx tid: t
        emitFail :ctx what: "the `==` of \{cn} called after its type was written" line: 0
        return
    }
    ctx.eqUsed.add item: t
    parts: ListVal ztypes.tid
    ztypecheck.valPartTids :reg :typing tid: t :parts
    for each p: parts loop {
        if (partEqCallsGenerated :ast :reg :typing tid: p) then (
            noteEqUse
            :ast
            :reg
            :typing
            :ctx
            tid: p
        )
    }
}

# partEqCallsGenerated -- comparing a `tid` part calls its generated `_eq`
# (partEqC's last leg): neither the author's `==` nor a scalar's.
partEqCallsGenerated: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
} out bool is {
    if (ztypecheck.isLiteralTypeId :reg :tid) then return false
    src: (
        ztypecheck.valOpSource
        :ast
        :reg
        :typing
        :tid
        nameId: zast.wellKnown.slot.wkOpEq
    )
    if src.written or src.negated then return false
    if (partIsHelperScalar :typing :tid) then return false
    return (partIsCScalar :reg :typing :tid).not
}

# partHasEq -- a part a generated `==` can compare: its own `==` is the
# runtime's or the author's, or generated with a body of its own.
partHasEq: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} out bool is {
    # an untyped number compares as the i64 or f64 it is held as
    if (ztypecheck.isLiteralTypeId :reg :tid) then return true
    src: (
        ztypecheck.valOpSource
        :ast
        :reg
        :typing
        :tid
        nameId: zast.wellKnown.slot.wkOpEq
    )
    if src.none then return false
    if src.generated.not then return true
    return (
        eqGenerated
        :ast
        :reg
        :typing
        :ctx
        tid: (ztypecheck.typedefChaseTid :typing :tid)
    )
}

# partEqC -- appends the C comparison of one part, `lhs` against `rhs`, each
# reached through `sel` (`.x`, `.data.arm`, `.data[_i]`, or nothing), made with
# that part's own `==`: the author's method (negated when only `!=` is written),
# C `==` for a scalar or a function pointer, and the `_eq` of a str or of a
# generated `==` otherwise. A method takes its receiver's address, so `lhs` +
# `sel` is an lvalue.
partEqC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    lhs: StringView
    rhs: StringView
    sel: StringView
    dest: String.borrow
} is {
    src: (
        ztypecheck.valOpSource
        :ast
        :reg
        :typing
        :tid
        nameId: zast.wellKnown.slot.wkOpEq
    )
    if src.written or src.negated then {
        opId: zast.wellKnown.slot.wkOpEq
        if src.negated then {
            opId = zast.wellKnown.slot.wkOpNe
            dest.append "!"
        }
        owner: ztypecheck.valOpOwner :typing :tid nameId: zast.wellKnown.slot.wkOpEq
        fo: typing.declChildOfId parentTypeId: owner nameId: opId
        dest.append (spelledCname :ctx tid: (fo.or d: ztypes.tid.zero))
        dest.append "(&"
        dest.append lhs
        dest.append sel
        dest.append ", "
        dest.append rhs
        dest.append sel
        dest.append ")"
        return
    }
    if (partIsHelperScalar :typing :tid) then {
        hk: (constScalarKindForTid :typing :tid).kind
        if hk == ztypes.numkind.f16Type then {
            needsAddM :ctx uname: "prelude" memb: "f16"
            preludeNeed :ctx memb: "@f16_eq"
            dest.append "z_f16_eq("
        } else if (ztypes.isSignedIntKind k: hk) then {
            needsAddM :ctx uname: "prelude" memb: "int128"
            preludeNeed :ctx memb: "@i128_eq"
            dest.append "z_i128_eq("
        } else {
            needsAddM :ctx uname: "prelude" memb: "int128"
            preludeNeed :ctx memb: "@u128_eq"
            dest.append "z_u128_eq("
        }
        dest.append lhs
        dest.append sel
        dest.append ", "
        dest.append rhs
        dest.append sel
        dest.append ")"
        return
    }
    if (partIsCScalar :reg :typing :tid) then {
        dest.append lhs
        dest.append sel
        dest.append " == "
        dest.append rhs
        dest.append sel
        return
    }
    noteEqUse :ast :reg :typing :ctx :tid
    dest.append (spelledCname :ctx tid: (ztypecheck.typedefChaseTid :typing :tid))
    dest.append "_eq("
    dest.append lhs
    dest.append sel
    dest.append ", "
    dest.append rhs
    dest.append sel
    dest.append ")"
}

# partHashWords -- the 64-bit words one part contributes to a generated hash,
# `v` being the part's C value: the author's `hash` of it; for a scalar, its
# value itself (two words for a 128-bit one) -- the words are hashed together
# afterwards, so equal values give equal words; for a function pointer, its
# address; and the generated `_hash` of a str or an aggregate otherwise.
partHashWords: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    v: StringView
    words: List String
} is {
    src: (
        ztypecheck.valOpSource
        :ast
        :reg
        :typing
        :tid
        nameId: zast.wellKnown.slot.wkHash
    )
    if src.written then {
        owner: ztypecheck.valOpOwner :typing :tid nameId: zast.wellKnown.slot.wkHash
        fo: typing.declChildOfId parentTypeId: owner nameId: zast.wellKnown.slot.wkHash
        fc: spelledCname :ctx tid: (fo.or d: ztypes.tid.zero)
        wr: String
        wr.append fc
        wr.append "(&"
        wr.append v
        wr.append ")"
        words.append wr
        return
    }
    base: ztypecheck.typedefChaseTid :typing :tid
    if (reg.typetypeOf typeId: base) == ztypes.ztypetype.functionType then {
        wf: "(uint64_t)(uintptr_t)\{v}"
        words.append wf
        return
    }
    if (partIsCScalar :reg :typing tid: base) then {
        hbk: ztypecheck.numKindOfTid :typing tid: base
        if hbk.has when (ztypes.intKindBits k: hbk.kind) == 128 then {
            # its two words, through the int128 helpers: the value is no C
            # arithmetic type where the C compiler has no 128-bit integer
            needsAddM :ctx uname: "prelude" memb: "int128"
            hbits: v.string
            if (ztypes.isSignedIntKind k: hbk.kind) then {
                preludeNeed :ctx memb: "@i128_bits"
                hbits = "z_i128_bits(\{v})"
            }
            preludeNeed :ctx memb: "@u128_lo"
            wl: "z_u128_lo(\{hbits})"
            words.append wl
            preludeNeed :ctx memb: "@u128_hi"
            wh: "z_u128_hi(\{hbits})"
            words.append wh
            return
        }
        ws: "(uint64_t)\{v}"
        words.append ws
        return
    }
    # a text part hashes its bytes, as a str does
    if (isViewLaid :ctx tid: base) then {
        wt: "\{hashBytesFn :ctx}((const uint8_t*)(\{v}).data, (\{v}).size)"
        words.append wt
        return
    }
    hashFnDemand :ast :reg :typing :ctx tid: base
    wg: "\{spelledCname :ctx tid: base}_hash(\{v})"
    words.append wg
}

# hashExprC -- the `u64` hash of a value `v` of type `tid`: the author's `hash`,
# the integer mixer over a scalar's words, or the generated `_hash`.
hashExprC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    v: StringView
} out String is {
    words: List String
    partHashWords :ast :reg :typing :ctx :tid :v :words
    if words.length == 0 then return "0".string
    w0: words.get i: 0
    if words.length == 2 then {
        w1: words.get i: 1
        inner: hashU64C :ctx v: w1.stringView
        both: "\{w0} ^ \{inner}"
        return (hashU64C :ctx v: both.stringView)
    }
    src: (
        ztypecheck.valOpSource
        :ast
        :reg
        :typing
        :tid
        nameId: zast.wellKnown.slot.wkHash
    )
    base: ztypecheck.typedefChaseTid :typing :tid
    if src.written.not when (partIsCScalar :reg :typing tid: base) then return (
        hashU64C
        :ctx
        v: w0.stringView
    )
    if (reg.typetypeOf typeId: base) == ztypes.ztypetype.functionType then {
        return (hashU64C :ctx v: w0.stringView)
    }
    return w0.copy
}

# hashFnDemand -- `tid` needs its generated `_hash` written: a str, or an
# aggregate whose `hash` is generated. Its parts' are demanded with it.
hashFnDemand: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
} is {
    if (ctx.hashAsked.has item: tid) then return
    tt: reg.typetypeOf typeId: tid
    isAgg: tt.isValueData
    if isAgg.not then return
    if (partIsCScalar :reg :typing :tid) then return
    # text hashes as the view it is laid out as: the runtime's, not a generated one
    if (isViewLaid :ctx :tid) then return
    ctx.hashAsked.add item: tid
    ctx.hashOrder.append tid
    if (
        ztypecheck.valOpSource
        :ast
        :reg
        :typing
        :tid
        nameId: zast.wellKnown.slot.wkHash
    ).generated.not then return
    parts: ListVal ztypes.tid
    ztypecheck.valPartTids :reg :typing :tid :parts
    for each p: parts loop {
        if (
            ztypecheck.valOpSource
            :ast
            :reg
            :typing
            tid: p
            nameId: zast.wellKnown.slot.wkHash
        ).written.not then {
            (
                hashFnDemand
                :ast
                :reg
                :typing
                :ctx
                tid: (ztypecheck.typedefChaseTid :typing tid: p)
            )
        }
    }
}

# appendHashSig -- the signature of `tid`'s generated `_hash`, onto `dest`: it
# takes the value, or for a data type the handle the value is held as.
appendHashSig: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    dest: String.borrow
} is {
    cn: spelledCname :ctx :tid
    if (isStaticHandle :reg :typing :tid) then {
        dest.append "static uint64_t \{cn}_hash(const \{cn}_t* a)"
    } else {
        dest.append "static uint64_t \{cn}_hash(\{cn}_t a)"
    }
}

# hashDefC -- the definition of `tid`'s generated `_hash`. A record's and a
# variant's part words are gathered and hashed together, a variant's led by
# its tag; a str hashes its bytes up to its length; an array of integers hashes
# its bytes, any other array folds its elements' hashes in order.
hashDefC: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    dest: String.borrow
} is {
    appendHashSig :reg :typing :ctx :tid :dest
    dest.append " {\n"
    if (
        ztypecheck.valIsMonoOf
        :reg
        :typing
        :tid
        wk: zast.wellKnown.slot.tyStr
    ) then {
        dest.append "    return \{hashBytesFn :ctx}(a.data, a.len);\n}\n\n"
        return
    }
    if (
        ztypecheck.valIsMonoOf
        :reg
        :typing
        :tid
        wk: zast.wellKnown.slot.tyArray
    ) then {
        arrayHashBody :ast :reg :typing :ctx :tid :dest
        return
    }
    if (reg.typetypeOf typeId: tid) == ztypes.ztypetype.variantType then {
        variantHashBody :ast :reg :typing :ctx :tid :dest
        return
    }
    words: List String
    names: List String
    ids: ListVal ztypes.tid
    nameIds: ListVal zast.nameid
    recFieldLists :ast :reg :typing :tid :names :ids :nameIds
    fk: u64
    for fk < names.length loop {
        fknC: (
            memberC
            :ast
            :reg
            :typing
            :ctx
            owner: tid
            kind: memberkind.field
            nameId: (nameIds.get i: fk)
        )
        fv: "a.\{fknC}"
        # a data value is hashed through its handle
        if (isStaticHandle :reg :typing :tid) then fv = "a->\{fknC}"
        partHashWords :ast :reg :typing :ctx tid: (ids.get i: fk) v: fv.stringView :words
        fk = fk + 1
    }
    dest.append "    uint64_t _h[] = { "
    if words.length == 0 then dest.append "0"
    wi: u64
    for wi < words.length loop {
        if wi > 0 then dest.append ", "
        dest.append (words.get i: wi)
        wi = wi + 1
    }
    dest.append " };\n"
    dest.append "    return \{hashBytesFn :ctx}(_h, sizeof(_h));\n}\n\n"
}

# variantHashBody -- a variant's generated `_hash`: its tag, then the words of
# the payload of the arm it holds, and zero for the words it does not use.
variantHashBody: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    dest: String.borrow
} is {
    aids: ListVal ztypes.tid
    aidsNm: ListVal zast.nameid
    variantArmIds :reg :typing :tid ids: aids nameIds: aidsNm
    cases: String
    width: u64
    for each qname: aidsNm loop {
        qco: typing.declChildOfId parentTypeId: tid nameId: qname
        qc: armPayloadC :ast :reg :typing :ctx :tid arm: qname
        if qc.length > 0 when qco.some then {
            qnameC: memberC :ast :reg :typing :ctx owner: tid kind: memberkind.arm nameId: qname
            qv: "a.data.\{qnameC}"
            words: List String
            partHashWords :ast :reg :typing :ctx tid: qco v: qv.stringView :words
            if words.length > width then width = words.length
            cases.append "        case \{spelledTagConst :ast :ctx :reg :typing :tid armId: qname}:"
            wi: u64
            for wi < words.length loop {
                cases.append " _h[\{wi + 1}] = \{words.get i: wi};"
                wi = wi + 1
            }
            cases.append " break;\n"
        }
    }
    dest.append "    uint64_t _h[\{width + 1}] = { 0 };\n"
    dest.append "    _h[0] = (uint64_t)a.tag;\n"
    if cases.length > 0 then {
        dest.append "    switch (a.tag) {\n"
        dest.append cases
        dest.append "        default: break;\n    }\n"
    }
    dest.append "    return \{hashBytesFn :ctx}(_h, sizeof(_h));\n}\n\n"
}

# arrayHashBody -- an array's generated `_hash`: its bytes when the element's
# `==` is its bytes, otherwise its elements' hashes folded in order.
arrayHashBody: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    dest: String.borrow
} is {
    elem: ztypecheck.arrayElemTid :reg :tid
    if (elemEqIsBytes :ast :reg :typing tid: elem) then {
        dest.append "    return \{hashBytesFn :ctx}(a.data, sizeof(a.data));\n}\n\n"
        return
    }
    len: monoLengthText :reg monoId: tid
    eh: hashExprC :ast :reg :typing :ctx tid: elem v: "a.data[_i]"
    dest.append "    uint64_t _h = \{len};\n"
    preludeNeed :ctx memb: "@hash_combine"
    dest.append "    for (int _i = 0; _i < \{len}; _i++) _h = z_hash_combine(_h, \{eh});\n"
    dest.append "    return _h;\n}\n\n"
}

# synthHashOf -- `mco` is the generated `hash` member of `owner`.
synthHashOf: function {typing: ztyping.ZTyping.view owner: ztypes.tid mco: ztypes.tid} out bool is {
    fo: typing.declChildOfId parentTypeId: owner nameId: zast.wellKnown.slot.wkHash
    if (fo.or d: ztypes.tid.zero) != mco then return false
    return (typing.declMemberIsSynth parentTypeId: owner nameId: zast.wellKnown.slot.wkHash)
}

# hashMemberRead -- the generated `hash` member of `tid` that a program reads,
# which the emitter then writes as a call of the type's `_hash`; zero when
# there is none to write.
hashMemberRead: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx.view
    tid: ztypes.tid
} out ztypes.tid is {
    if (
        ztypecheck.valOpSource
        :ast
        :reg
        :typing
        :tid
        nameId: zast.wellKnown.slot.wkHash
    ).generated.not then {
        return ztypes.tid
    }
    fo: typing.declChildOfId parentTypeId: tid nameId: zast.wellKnown.slot.wkHash
    fid: fo.or d: ztypes.tid.zero
    if fid.isZero then return fid
    # a read of it is its type's hash of the value (synthHashRead); only C
    # naming the member itself, a reference to it, calls this function
    if (ctx.fnSpelled.has item: fid).not then return ztypes.tid
    return fid
}

# valKeyHashBody -- a value-type key's hash for a Set or Map mono, `_key`
# being the key: the key's own `hash`, whatever wrote it. The functions it
# calls are declared here, ahead of the mono that calls them.
valKeyHashBody: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    key: ztypes.tid
    keyT: StringView
    buf: String.borrow
} out String is {
    src: (
        ztypecheck.valOpSource
        :ast
        :reg
        :typing
        tid: key
        nameId: zast.wellKnown.slot.wkHash
    )
    if src.written then {
        owner: (
            ztypecheck.valOpOwner
            :typing
            tid: key
            nameId: zast.wellKnown.slot.wkHash
        )
        fo: typing.declChildOfId parentTypeId: owner nameId: zast.wellKnown.slot.wkHash
        fid: fo.or d: ztypes.tid.zero
        buf.append "static uint64_t "
        buf.append (spelledCname :ctx tid: fid)
        buf.append "("
        buf.append (keyFnParamConstC :reg :typing :fid index: 0)
        buf.append keyT
        buf.append "*);\n"
    }
    base: ztypecheck.typedefChaseTid :typing tid: key
    if src.written.not when (partIsCScalar :reg :typing tid: base).not then {
        appendHashSig :reg :typing :ctx tid: base dest: buf
        buf.append ";\n"
    }
    return (hashExprC :ast :reg :typing :ctx tid: key v: "_key")
}

# valKeyEqBody -- a value-type key's equality for a Set or Map mono, `_a` and
# `_b` being the keys: the key's own `==`, whatever wrote it.
valKeyEqBody: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    key: ztypes.tid
    keyT: StringView
    buf: String.borrow
} out String is {
    src: (
        ztypecheck.valOpSource
        :ast
        :reg
        :typing
        tid: key
        nameId: zast.wellKnown.slot.wkOpEq
    )
    if src.written or src.negated then {
        opId: zast.wellKnown.slot.wkOpEq
        if src.negated then opId = zast.wellKnown.slot.wkOpNe
        owner: (
            ztypecheck.valOpOwner
            :typing
            tid: key
            nameId: zast.wellKnown.slot.wkOpEq
        )
        fo: typing.declChildOfId parentTypeId: owner nameId: opId
        fid: fo.or d: ztypes.tid.zero
        buf.append "static bool "
        buf.append (spelledCname :ctx tid: fid)
        buf.append "("
        buf.append (keyFnParamConstC :reg :typing :fid index: 0)
        buf.append keyT
        buf.append "*, "
        buf.append keyT
        buf.append ");\n"
    }
    body: String
    partEqC :ast :reg :typing :ctx tid: key lhs: "_a" rhs: "_b" sel: "" dest: body
    return body
}

# isValKey -- a Set element or Map key hashed and compared with its own
# members (valKeyHashBody, valKeyEqBody): a value type. A String and a
# StringView keep their native pair, a reference its declared one.
isValKey: function {reg: ztypes.ZTypeRegistry.view key: ztypes.tid kind: u64} out bool is {
    if (kind == 1) or (kind == 2) then return false
    return (reg.isValtypeOf tid: key)
}

# emitHashPrototypes -- the prototypes of every generated `_hash` the program
# needs, and of the member each `hash` read calls: written ahead of the method
# bodies that call them, their definitions after everything (emitHashDefs).
emitHashPrototypes: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    buf: String.borrow
} is {
    oi: u64
    for oi < ctx.hashOrder.length loop {
        appendHashSig :reg :typing :ctx tid: (ctx.hashOrder.get i: oi) dest: buf
        buf.append ";\n"
        oi = oi + 1
    }
    for each ru: typing.hashUsed loop {
        r: ru
        fid: hashMemberRead :ast :reg :typing :ctx tid: r
        if fid.notZero then {
            rt: cTypeForNameTid :ast :reg :typing :ctx tid: r
            buf.append "static uint64_t \{spelledCname :ctx tid: fid}(const \{rt}* _t);\n"
        }
    }
}

# emitHashDefs -- the definitions emitHashPrototypes declared: each generated
# `_hash`, and each read `hash` member as a call of its type's.
emitHashDefs: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    buf: String.borrow
} is {
    for each ru: typing.hashUsed loop {
        r: ru
        fid: hashMemberRead :ast :reg :typing :ctx tid: r
        if fid.notZero then {
            rt: cTypeForNameTid :ast :reg :typing :ctx tid: r
            he: hashExprC :ast :reg :typing :ctx tid: r v: "(*_t)"
            buf.append "static uint64_t \{spelledCname :ctx tid: fid}(const \{rt}* _t) {\n"
            buf.append "    return \{he};\n}\n\n"
        }
    }
    oi: u64
    for oi < ctx.hashOrder.length loop {
        hashDefC :ast :reg :typing :ctx tid: (ctx.hashOrder.get i: oi) dest: buf
        oi = oi + 1
    }
}

# partCallsWritten -- comparing a `tid` part calls a method the author wrote,
# whose definition comes after every generated helper.
partCallsWritten: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
} out bool is {
    src: (
        ztypecheck.valOpSource
        :ast
        :reg
        :typing
        :tid
        nameId: zast.wellKnown.slot.wkOpEq
    )
    return src.written or src.negated
}

# partsCallWritten -- partCallsWritten for any of `ids`.
partsCallWritten: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ids: (ListVal ztypes.tid).view
} out bool is {
    for each p: ids loop {
        if (partCallsWritten :ast :reg :typing tid: p) then return true
    }
    return false
}

# partIsCScalar -- a part C compares with `==`: a scalar, or a function
# pointer. Asked after the author's own `==`, which always comes first.
partIsCScalar: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view tid: ztypes.tid
} out bool is {
    base: ztypecheck.typedefChaseTid :typing :tid
    if (reg.typetypeOf typeId: base) == ztypes.ztypetype.functionType then return true
    # an untyped number held at run time is the i64 or f64 typeRefC lays it out as
    if (ztypecheck.isLiteralTypeId :reg tid: base) then return true
    return (scalarCTypeFor :typing tid: base).length > 0
}

# emitEqLate -- a generated `_eq` that calls a method the author wrote: its
# prototype in place and its definition after every function prototype, since
# the generated helpers are written ahead of the methods they call.
emitEqLate: function {
    ctx: Ctx
    cname: StringView
    body: String.view
    buf: String.borrow
    # the two sides are data values' handles (writeRecordEq)
    handles: false
} is {
    if handles then {
        buf.append "static bool \{cname}_eq(const \{cname}_t* a, const \{cname}_t* b);\n"
    } else {
        buf.append "static bool \{cname}_eq(\{cname}_t a, \{cname}_t b);\n"
    }
    ctx.lateDefs.append body
}

# emitRecordEq -- a record's generated `==`: its fields one at a time, each with
# that field's own `==`.
emitRecordEq: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the record
    tid: ztypes.tid
    rc: String.view
    # its fields' name ids, in step with ids
    nameIds: (ListVal zast.nameid).view
    ids: (ListVal ztypes.tid).view
    buf: String.borrow
} is {
    if (partsCallWritten :ast :reg :typing :ids).not then {
        writeRecordEq :ast :reg :typing :ctx :tid :rc :nameIds :ids dest: buf
        return
    }
    body: String
    writeRecordEq :ast :reg :typing :ctx :tid :rc :nameIds :ids dest: body
    emitEqLate :ctx cname: rc.stringView :body :buf handles: (isStaticHandle :reg :typing :tid)
}

# writeRecordEq -- emitRecordEq's definition, written to `dest`.
writeRecordEq: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the record whose `_eq` is written
    tid: ztypes.tid
    rc: String.view
    # the field name ids, paired with ids
    nameIds: (ListVal zast.nameid).view
    ids: (ListVal ztypes.tid).view
    dest: String.borrow
} is {
    # a data value is compared through the handles it is held as
    handles: isStaticHandle :reg :typing :tid
    lq: "static bool \{rc}_eq(\{rc}_t a, \{rc}_t b) {\n"
    if handles then lq = "static bool \{rc}_eq(const \{rc}_t* a, const \{rc}_t* b) {\n"
    dest.append lq
    if nameIds.length == 0 then {
        dest.append "    (void)a; (void)b;\n"
        dest.append "    return true;\n"
        dest.append "}\n\n"
        return
    }
    dest.append "    return "
    fk: u64
    for fk < nameIds.length loop {
        if fk > 0 then dest.append " && "
        fknC: (
            memberC
            :ast
            :reg
            :typing
            :ctx
            owner: tid
            kind: memberkind.field
            nameId: (nameIds.get i: fk)
        )
        fsel: ".\{fknC}"
        if handles then fsel = "->\{fknC}"
        (
            partEqC
            :ast
            :reg
            :typing
            :ctx
            tid: (ids.get i: fk)
            lhs: "a"
            rhs: "b"
            sel: fsel.stringView
            :dest
        )
        fk = fk + 1
    }
    dest.append ";\n"
    dest.append "}\n\n"
}

# emit one record's C struct.
emitOneRecord: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    if (ctx.emittedUserTypes.has item: tid) then return
    ctx.emittedUserTypes.add item: tid
    if (isTypedefType :typing :tid) then return
    fnames: List String
    fids: ListVal ztypes.tid
    fidsNm: ListVal zast.nameid
    recFieldLists :ast :reg :typing :tid names: fnames ids: fids nameIds: fidsNm
    # A FIELDLESS record/class is a synthesized carrier -- a list's
    # `tag__{elem}`, a marker type declared `is native` -- and an empty struct
    # is not C. Same rule as the armless variant above, for the same reason:
    # nothing can hold one, so emit nothing rather than invalid C.
    if fnames.length == 0 then return
    preEmitEmbeddedTypes :ast :reg :typing :ctx ids: fids :buf
    rc: spelledCname :ctx :tid
    if (isFwdDeclared :ctx :tid) then {
        lopenR: "struct \{rc}_t {\n"
        buf.append lopenR
    } else {
        buf.append "typedef struct {\n"
    }
    emitRecordStructBody :ast :reg :typing :ctx :tid names: fnames ids: fids nameIds: fidsNm :buf
    if (isFwdDeclared :ctx :tid) then {
        buf.append "};\n"
    } else {
        l2: "} \{rc}_t;\n"
        buf.append l2
    }
    # a data value is built only by the compiler: no constructor at run time;
    # any other is written only when written C builds one
    if (isStaticHandle :reg :typing :tid).not when (ctx.createUsed.has item: tid) then {
        params: String
        inits: String
        (
            recordCreateArgs
            :ast
            :reg
            :typing
            :ctx
            :tid
            names: fnames
            ids: fids
            nameIds: fidsNm
            :params
            :inits
        )
        (
            emitMetaCreate
            :buf
            rc: rc.stringView
            params: params.stringView
            inits: inits.stringView
            alias: (recordCreateAlias :reg :typing :ctx :tid)
        )
    }
    if (ctx.eqUsed.has item: tid) when (eqGenerated :ast :reg :typing :ctx :tid) then (
        emitRecordEq
        :ast
        :reg
        :typing
        :ctx
        :tid
        :rc
        nameIds: fidsNm
        ids: fids
        :buf
    )
    if (destroyWritten :reg :ctx :tid) when (ownsResources :reg :ctx :tid) then {
        emitStructDestructor :ast :reg :typing :ctx :tid :fnames :fids fnameIds: fidsNm :buf
    }
}


# methodBodyWalked -- is this method's body emitted? A body is emitted when the
# checker walked it: the walk is what stamps a body, and the checker walks a
# method only where the program uses it, the members a spec names, and every
# member under `--eager`. A method with type parameters of its own is emitted per
# instance, and an instance exists only where a use minted it.
methodBodyWalked: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ownerTid: ztypes.tid
    mid: ztypes.tid
    nameId: zast.nameid
} out bool is {
    if (isGenericFnTid :reg tid: mid) then return true
    md: typing.declMemberIdOf parentTypeId: ownerTid :nameId
    if md.isZero then return true
    return (typing.declIsWalked declId: md)
}


# fnYieldCount -- yields in a functiondef body (0 for a non-generator).
fnYieldCount: function {ast: Ast.view op: astnode.view} out u64 is {
    match (
        op
    ) case functiondef then {
        if op.body.isZero then return 0
        return (zast.yieldCountOf :ast n: (ast.nodes.get i: op.body))
    } else {
        return 0
    }
}

# genFieldsRowOf -- the row of synthesized state fields (typing.genFields) the
# checker recorded for the generator whose `call` is `op`, or whose `call` an
# instance's copy `op` is. Every generator the transform prepared has one; a
# `call` without one is an emitter defect.
genFieldsRowOf: function {typing: ztyping.ZTyping.view op: astnode.view} out u64 is {
    gc: ztypecheck.generatorCallOf :typing nid: (zast.nodeIdOf n: op)
    gfr: typing.genFieldsOf.get key: gc
    if gfr.none then panic msg: "zemitterc: a generator call with no recorded state fields"
    return gfr
}

# setupGenCtx -- arm the generator state-machine context on ctx when `op` is a
# generator `call` (its body yields). Resolves the optionval wrapper from the
# method's return type. Returns false (and disarms) for a normal method.
setupGenCtx: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    mid: ztypes.tid
    op: astnode.view
    # the generator class `call` is a method of
    owner: ztypes.tid
} out bool is {
    gyc: fnYieldCount :ast :op
    if gyc == 0 then {
        ctx.genActive = false
        return false
    }
    rid: fnReturnTidOf :reg tid: mid
    if rid.isZero then {
        mro: ztypecheck.methodReturnOf :reg :typing :mid
        if mro.some then {
            rid = mro
        }
    }
    if rid.isZero then {
        ctx.genActive = false
        return false
    }
    rc: spelledCname :ctx tid: rid
    ctx.genFieldsRow = genFieldsRowOf :typing :op
    ctx.genActive = true
    ctx.genTid = owner
    ctx.genYieldCount = gyc
    ctx.genYieldNext = 1
    ctx.genForNext = 0
    for ctx.genForSpills.length > 0 loop ctx.genForSpills.pop
    ctx.genWrap = "\{rc}_t"
    ctx.genSomeTag = (
        spelledTagConst
        :ast
        :ctx
        :reg
        :typing
        tid: rid
        armId: zast.wellKnown.slot.wkSome
    )
    ctx.genSomeC = (
        memberC
        :ast
        :reg
        :typing
        :ctx
        owner: rid
        kind: memberkind.arm
        nameId: zast.wellKnown.slot.wkSome
    )
    ctx.genNoneTag = (
        spelledTagConst
        :ast
        :ctx
        :reg
        :typing
        tid: rid
        armId: zast.wellKnown.slot.wkNone
    )
    # a reftype element wraps in Option: the yield leg boxes the payload
    # (emitOptionalAssign's malloc'd-box shape); valtype wrappers stay inline.
    gp: String
    if (originIsTid :reg tid: rid originTid: (ctx.origins.get i: family.slot.option)) then {
        gp = armPayloadC :ast :reg :typing :ctx tid: rid arm: zast.wellKnown.slot.wkSome
    }
    ctx.genPayC = gp.take
    # a `.call` that receives a per-call input is one with a SECOND parameter --
    # the receiver is first. Asked by position rather than by the label, because
    # the label belongs to the author: the function form always spelled it
    # `value`, and a declared generator spells it whatever its call sites read.
    hasVal: false
    if op.functiondef then {
        pcnt: u64
        for each paramId: (zast.kidsOf :ast span: op.parameters) loop {
            pm: ast.nodes.get i: paramId
            if pm.namedoperation then pcnt = pcnt + 1
        }
        if pcnt > 1 then hasVal = true
    }
    ctx.genHasValue = hasVal
    # the C names the state machine reads the receiver and the input through
    gids: ListVal ztypes.tid
    gnm: ListVal zast.nameid
    recFieldIds :reg :typing tid: mid ids: gids nameIds: gnm
    gpi: u64
    for gpi < gnm.length loop {
        gv: paramVidByNameId :ast :typing :op nameId: (gnm.get i: gpi)
        gc: varCName :ctx :ast :reg vid: gv
        if gpi == 0 then ctx.genRecvC = gc.copy
        if gpi == 1 then ctx.genValC = gc.copy
        gpi = gpi + 1
    }
    return true
}

# emitGenPrologue -- the resume dispatch: switch on this->state to L_entry / the
# per-yield resume labels / L_done.
emitGenPrologue: function {
    # the state field names
    ast: Ast.view
    # the checked program the generator class is in
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the emission context the generator is armed on (setupGenCtx)
    ctx: Ctx
    # the function body being written
    buf: String.borrow
} is {
    if ctx.genHasValue then {
        riI: genSynthField :typing :ctx which: gensynth.resumeInput k: 0
        riC: genFieldC :ast :reg :typing :ctx nameId: riI
        lgv: "    \{riC} = \{ctx.genValC};\n"
        buf.append lgv
    }
    stI: genSynthField :typing :ctx which: gensynth.state k: 0
    stC: genFieldC :ast :reg :typing :ctx nameId: stI
    lgs: "    switch (\{stC}) {\n"
    buf.append lgs
    buf.append "        case 0: goto L_entry;\n"
    k: 1.u64
    for k <= ctx.genYieldCount loop {
        lk: "        case \{k}: goto L_resume_\{k};\n"
        buf.append lk
        k = k + 1
    }
    buf.append "        default: goto L_done;\n"
    buf.append "    }\n"
    buf.append "L_entry:;\n"
}

# emitGenEpilogue -- the terminal landing: mark done and return the NONE wrapper.
emitGenEpilogue: function {
    # the names of the state fields
    ast: Ast.view
    # the checked program holding the generator class
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the generator context setupGenCtx armed
    ctx: Ctx
    # the body the exhausted path is appended to
    buf: String.borrow
} is {
    # a yield the body counted but never emitted -- one made unreachable by a
    # bare `return` before it -- still has a `case` in the resume switch, and a
    # switch arm jumping to a label that was never written is C that does not
    # compile. Land those on the terminal state: an unreachable yield can never
    # be the state the machine suspended at, so resuming into it is done.
    kd: ctx.genYieldNext
    for kd <= ctx.genYieldCount loop {
        ld: "L_resume_\{kd}:;\n"
        buf.append ld
        kd = kd + 1
    }
    buf.append "L_done:;\n"
    stI: genSynthField :typing :ctx which: gensynth.state k: 0
    stC: genFieldC :ast :reg :typing :ctx nameId: stI
    lge: "    \{stC} = -1;\n"
    buf.append lge
    le: "    \{ctx.genWrap} _r_done = {0};\n"
    buf.append le
    lt: "    _r_done.tag = \{ctx.genNoneTag};\n"
    buf.append lt
    buf.append "    return _r_done;\n"
}

# isYieldNode -- the node is a yield expression.
isYieldNode: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case statementline then {
        return (isYieldNode :ast n: (ast.nodes.get i: n.statementline))
    } case call then {
        return (zast.isYieldCalleeAt :ast callableId: n.callable)
    } else {
        return false
    }
}

# emitYieldFromNode -- emit the suspension for a yield reached through expression
# wrappers (the expression-form `name: yield E`).
emitYieldFromNode: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    n: astnode.view
    ind: StringView
    buf: String.borrow
} is {
    match (
        n
    ) case call then {
        emitYieldStmt :ast :reg :typing :ctx callId: n.nodeid :ind :buf
    } else null
}

# emitExprFormYield -- `name: yield E` in a bidirectional generator: suspend
# (yield E), then bind name to the resume input the next `.call value:` provides.
# A valtype binds the value directly; a borrowed reftype binds a pointer alias.
emitExprFormYield: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    value: astnode.view
    aid: zast.nodeid
    nm: StringView
    nmVid: ztypes.vid
    ind: StringView
    buf: String.borrow
} is {
    # the hoist has already suspended this yield and left the resume value in
    # a temp; only a yield it declined (no resume type it could name) still
    # needs suspending here
    riS: genSynthField :typing :ctx which: gensynth.resumeInput k: 0
    srcC: genFieldC :ast :reg :typing :ctx nameId: riS
    {
        ycid: zast.yieldCallIdAt :ast nid: (zast.nodeIdOf n: value)
        ykq: ctx.yieldTempK.get key: ycid
        match (
            ykq
        ) case some then {
            yvQ: genSynthField :typing :ctx which: gensynth.yieldSlot k: ykq
            srcC = genFieldC :ast :reg :typing :ctx nameId: yvQ
        } case none then {
            emitYieldFromNode :ast :reg :typing :ctx n: value :ind :buf
        }
    }
    ltid: stampIdOf :typing nid: aid
    cTypeText: typeRefC :ast :reg :typing :ctx tid: ltid
    if cTypeText.length == 0 then cTypeText = "int64_t".string
    tt: reg.typetypeOf typeId: ltid
    isRef: tt.isReferenceData
    if isRef then {
        lp0: "\{ind}\{cTypeText}* __borrow_\{nm} = \{srcC};\n"
        buf.append lp0
        lp1: "\{ind}/* alias: \{nm} => (*__borrow_\{nm}) */\n"
        buf.append lp1
        bindBorrowAlias :ctx vid: nmVid :nm
    } else {
        # bind the name TO ITS SLOT rather than copying it into a C local.
        # `a: yield 1` used after a later suspension read a dead local before
        # this -- silently, and long before expression-position yield existed:
        # the checker keeps no `name: yield E` binding in the instance
        # (a REFTYPE resume value is an alias into the caller's storage and a
        # stored pointer would dangle), and for a valtype that left the value
        # in a local the next `return` threw away. The slot is a field, so it
        # survives, and the reftype path above is untouched.
        slotted: false
        yieldCallId: zast.yieldCallIdAt :ast nid: (zast.nodeIdOf n: value)
        if (ctx.yieldTempK.has key: yieldCallId) then slotted = true
        if slotted then {
            lp3: "\{ind}/* alias: \{nm} => \{srcC} */\n"
            buf.append lp3
            vvSet xs: ctx.aliases vid: nmVid val: srcC.stringView facts: (memberFacts b: pathFacts)
        } else {
            lp2: "\{ind}\{cTypeText} \{nm} = \{srcC};\n"
            buf.append lp2
        }
    }
}

# hoistStopsHere -- descent for the expression-yield hoist stops at anything
# whose evaluation is CONDITIONAL or REPEATED: a clause body, a loop, a `with`
# body, a nested definition. A yield there is a statement in its own right and
# emitStmt reaches it on that path; hoisting it would run the suspension
# whether or not the branch is taken.
hoistStopsHere: function {n: astnode.view} out bool is {
    match (
        n
    ) case statement then {
        return true
    } case ifexpr then {
        return true
    } case ifclause then {
        return true
    } case forexpr then {
        return true
    } case caseexpr then {
        return true
    } case caseclause then {
        return true
    } case withexpr then {
        return true
    } case doexpr then {
        return true
    } case functiondef then {
        return true
    } case objectdef then {
        return true
    } case unitdef then {
        return true
    } else {
        return false
    }
}

# hoistExprYields -- emit, as their own statements, the suspensions for every
# yield written in EXPRESSION position inside `nid`, binding each resume value
# to a temp the expression emitter then reads.
#
# A yield SUSPENDS the function: everything before it must already have run,
# and what follows resumes at a label. It cannot sit in the middle of a C
# expression, so the statement is split around it -- `b: (yield a) + 1` becomes
# the suspension, then `b = #yv_k + 1`.
#
# Operands are hoisted before the yield that contains them (post-order), which
# is the order they evaluate in, so `yield (yield a)` suspends innermost-first.
hoistExprYields: function {
    # the tree the statement's shape is walked from
    ast: Ast.view
    # read for each yield's resume TYPE, which the temp is declared with
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # carries the state-machine cursor, and takes the temp each hoist records
    ctx: Ctx
    # the statement, or the sub-expression of one, to lift yields out of
    nid: zast.nodeid
    # the indent the hoisted statements are written at
    ind: StringView
    # the function body being built; the suspensions append here, ahead of the
    # statement whose expression they were lifted from
    buf: String.borrow
} is {
    if nid.isZero then return
    {
        n: ast.nodes.get i: nid
        # an `if`'s FIRST clause's FIRST condition is the one part of it that
        # runs unconditionally and exactly once, so it hoists like any other
        # expression. Every later condition is guarded by the ones before it
        # (`when` short-circuits) and every body is guarded by all of them, so
        # the descent goes no further.
        if n.ifexpr then {
            if n.clauses.count.u64 > 0 then {
                c0: ast.nodes.get i: (zast.kidAt kids: ast.kids span: n.clauses i: 0)
                if c0.ifclause when c0.conditions.count.u64 > 0 then (
                    hoistExprYields
                    :ast
                    :reg
                    :typing
                    :ctx
                    nid: (zast.kidAt kids: ast.kids span: c0.conditions i: 0)
                    :ind
                    :buf
                )
            }
            return
        }
        if (hoistStopsHere :n) then return
        kids: zast.childIds :ast :n
        kiter: kids.iterate
        for k0: kiter loop {
            hoistExprYields :ast :reg :typing :ctx nid: k0 :ind :buf
        }
    }
    # canonicalise to the CALL's own id. The walk reaches a yield twice -- once
    # through the statement line holding it, once as the call -- and both must
    # answer the same key, or the suspension is emitted twice and every later
    # state number shifts.
    cid: zast.yieldCallIdAt :ast :nid
    if cid.isZero then return
    # already hoisted: emitStmt runs this over the statement and then over the
    # nodes inside it, so the walk has to be idempotent
    if (ctx.yieldTempK.has key: cid) then return
    # the resume type. An out-only generator binds no `value`, so its yields
    # carry nothing and stay on the statement leg
    ltid: stampIdOf :typing nid: cid
    if ltid.isZero then return
    # a REFTYPE resume value is held as a pointer into the caller's argument,
    # and a temp for it would have to carry the borrow alias the binding leg
    # sets up. That leg still owns those; reftype `accepts` is deferred polish
    # either way, so the hoist declines rather than guessing at the C.
    ttk: reg.typetypeOf typeId: ltid
    if ttk == ztypes.ztypetype.classType then return
    if ttk == ztypes.ztypetype.unionType then return
    kNum: ctx.genYieldNext
    emitYieldStmt :ast :reg :typing :ctx callId: cid :ind :buf
    # into the state object's slot, NOT a C local: the suspension above
    # returned, so a local declared here would be gone by the next one. The
    # lowering allocated one slot per suspension point for exactly this.
    yvK: genSynthField :typing :ctx which: gensynth.yieldSlot k: kNum
    yvC: genFieldC :ast :reg :typing :ctx nameId: yvK
    riK: genSynthField :typing :ctx which: gensynth.resumeInput k: 0
    riC: genFieldC :ast :reg :typing :ctx nameId: riK
    lrv: "\{ind}\{yvC} = \{riC};\n"
    buf.append lrv
    kv: kNum
    ctx.yieldTempK.set key: cid value: kv
}

# emitYieldStmt -- one `yield E` suspension: set the resume state, return the
# SOME-wrapped value, then drop a resume label at column 0 (goto-reachable into
# the enclosing block).
emitYieldStmt: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    # the yield CALL's node id. The suspension reads its one unlabelled
    # argument; the checker has already refused a labelled one
    callId: zast.nodeid
    ind: StringView
    buf: String.borrow
} is {
    k: ctx.genYieldNext
    ctx.genYieldNext = k + 1
    # an interpolated yield value builds via a self-contained statement
    # expression (emitExpr :ast cannot emit the chain)
    yopId: zast.yieldCallOperandAt :ast nid: callId
    yx: ast.nodes.get i: yopId
    veF: cfacts
    ve: emitInterpArgExpr :ast :reg :typing :ctx n: yx
    if ve.length == 0 then ve = emitExprWith :ast :reg :typing :ctx n: yx facts: veF
    # what the value hoisted is declared ahead of it and released once the value
    # is in the box, before the suspension
    ytmp: TmpCtr n: 0 listFrees: List OwedFree
    flushArgHoists :ctx :ind tmp: ytmp :buf
    stI: genSynthField :typing :ctx which: gensynth.state k: 0
    stC: genFieldC :ast :reg :typing :ctx nameId: stI
    ls: "\{ind}\{stC} = \{k};\n"
    buf.append ls
    lw: "\{ind}\{ctx.genWrap} _ry_\{k} = {0};\n"
    buf.append lw
    tgt: "_ry_\{k}"
    # copied out: the assignment records what it calls in the Ctx
    gst: ctx.genSomeTag.copy
    gsc: ctx.genSomeC.copy
    gpc: ctx.genPayC.copy
    (
        emitOptionalAssign
        :ctx
        target: tgt.stringView
        someTag: gst.stringView
        someC: gsc.stringView
        payC: gpc.stringView
        vx: ve.stringView
        :ind
        :buf
    )
    flushBlockFrees tmp: ytmp lL: 0 diverged: false :buf
    # what the value moved out of is zeroed before the suspension returns
    emitValueTakeInvalidations :ast :reg :typing :ctx n: yx :ind :buf
    # a yield of a bare local moves it into the box: the local is zeroed where
    # a destroy still reaches it -- the instance's destructor, for a local the
    # instance keeps
    emitMovedSourceZero :ast :reg :typing :ctx n: yx :ind :buf
    # a loop keeps its counter in the C for-header and its payload in a local
    # inside the loop, and a `with` its value in the header's local; this
    # `return` destroys them all and the resume `goto` re-enters past them.
    # Spill each open one to its state field here and reload it at the label
    emitSpillSaves :ctx :ind :buf
    lr: "\{ind}return _ry_\{k};\n"
    buf.append lr
    ll: "L_resume_\{k}:;\n"
    buf.append ll
    emitSpillReloads :ctx :ind :buf
}

# genFieldC -- a state field of the generator instance being emitted, as the
# C lvalue `<receiver>-><field>`.
genFieldC: function {
    # the field names
    ast: Ast.view
    # the checked program
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    # the emission context: the receiver and the generator class
    ctx: Ctx
    # the field's name, interned
    nameId: zast.nameid
} out String is {
    r: ctx.genRecvC.copy
    r.append "->"
    r.append (memberC :ast :reg :typing :ctx owner: ctx.genTid kind: memberkind.field :nameId)
    return r
}

# gensynth -- which of the state fields the generator transform adds: the resume
# cursor, the latest resumed input, a suspension's resume slot, a suspending
# `for`'s counter or its trip count.
gensynth: variant {
    # `#state`, the resume cursor
    state: null
    # `#resume_input`, the latest resumed input
    resumeInput: null
    # `#yv_<k>`, the k-th suspension's resume slot
    yieldSlot: null
    # `#fc_<k>`, the k-th suspending `for`'s counter
    forCounter: null
    # `#fn_<k>`, that loop's trip count
    forCount: null
}

# genSynthField -- the name of one of the state fields the generator transform
# added to the class whose `call` is being emitted (typing.genFields): `which`
# picks the family, `k` the 1-based suspension or loop number within it.
genSynthField: function {
    # the checked program holding typing.genFields
    typing: ztyping.ZTyping.view
    # the generator context: its row
    ctx: Ctx.view
    # the field's family
    which: gensynth
    # the suspension or loop number; unread for the cursor and the input
    k: u64
} out zast.nameid is {
    row: typing.genFields.get i: ctx.genFieldsRow
    match (
        which
    ) case state then {
        return row.state
    } case resumeInput then {
        return row.resumeInput
    } case yieldSlot then {
        return (row.yieldSlots.get i: k - 1)
    } case forCounter then {
        return (row.forCounters.get i: k - 1)
    } case forCount then {
        return (row.forCounts.get i: k - 1)
    }
}

# emitSpillSaves -- before a suspension's `return`: every open loop counter,
# loop payload and `with` value goes to its state field.
emitSpillSaves: function {ctx: Ctx.view ind: StringView buf: String.borrow} is {
    for each sp: ctx.genForSpills loop {
        lsv: "\{ind}\{sp.field} = \{sp.saved};\n"
        buf.append lsv
    }
}

# emitSpillReloads -- after a resume label: each saved value back into the C
# local the body reads, by kind -- a copy, an owned payload the field then
# lets go of, or a borrowed view re-derived from the saved wrapper. The
# wrapper local is restored too: a later yield in the same iteration saves
# it again, and the resume jumped past its declaration.
emitSpillReloads: function {ctx: Ctx.view ind: StringView buf: String.borrow} is {
    for each sp: ctx.genForSpills loop {
        f: sp.field.stringView
        match (
            sp.kind
        ) case copy then {
            lc: "\{ind}\{sp.restored} = \{f};\n"
            buf.append lc
        } case owned then {
            lo: "\{ind}\{sp.restored} = \{f};\n"
            buf.append lo
            if sp.payZero.length > 0 then buf.append "\{ind}\{f} = \{sp.payZero};\n"
        } case viewCopy then {
            lw: "\{ind}\{sp.saved} = \{f};\n"
            buf.append lw
            cv: "*(\{sp.payC}*)"
            lv: "\{ind}\{sp.restored} = \{cv}\{f}.data;\n"
            buf.append lv
        } case viewPtr then {
            lw2: "\{ind}\{sp.saved} = \{f};\n"
            buf.append lw2
            cp: "(\{sp.payC}*)"
            lp: "\{ind}\{sp.restored} = \{cp}\{f}.data;\n"
            buf.append lp
        }
    }
}

# emitOneMethod -- one method of a type or of a generic type's instance, as a
# static C function: the signature every function has (appendFnSignature, the
# receiver a pointer parameter), its body, and for a generator's `call` the
# state machine around it
emitOneMethod: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    ctx: Ctx
    mid: ztypes.tid
    thisTid: ztypes.tid
    op: astnode.view
    declOnly: bool
    buf: String.borrow
    # the instance of a generic method this is, whose walk and body copy it is
    # emitted from; 0 -- a method like any other
    mono: ztypes.tid
} is {
    if mono.isZero when (reg.genericOriginOf tid: thisTid).notZero then {
        # a method of an instance is the instance's whole (writeFnJob), and
        # it is emitted from the instance's own copy
        iopId: instanceOpAt :typing mono: thisTid op: (zast.nodeIdOf n: op)
        if iopId != (zast.nodeIdOf n: op) then {
            (
                emitOneMethod
                :ast
                :reg
                :typing
                :ctx
                :mid
                :thisTid
                op: (ast.nodes.get i: iopId)
                :declOnly
                :buf
                mono: ztypes.tid.zero
            )
            return
        }
    }
    resetFnEmitState :ctx
    buf.append "static "
    if declOnly then {
        appendFnSignature :ast :reg :typing :ctx fid: mid :op :buf tail: ";\n"
    } else {
        appendFnSignature :ast :reg :typing :ctx fid: mid :op :buf tail: " {\n"
        registerReftypeParams :ast :reg :typing :ctx fid: mid :op
        isGen: setupGenCtx :ast :reg :typing :ctx :mid :op owner: thisTid
        if isGen then emitGenPrologue :ast :reg :typing :ctx :buf
        ctx.curThisTid = thisTid
        emitFnBody :ast :reg :typing :ctx :op fid: mid :buf
        ctx.curThisTid = ztypes.tid.zero
        if isGen then {
            emitGenEpilogue :ast :reg :typing :ctx :buf
            ctx.genActive = false
        }
        buf.append "}\n\n"
    }
    resetFnEmitState :ctx
}

# the C name of the program's `main`.
mainCName: function {program: Ast.view} out String is {
    mv: program.mainUnitName.stringView
    mc: mv.string
    return mc
}
