        }
        ctx.condDepth = ctx.condDepth + 1
        emitMatchStmt :ast :symtab :ctx m: n assignTo: "" :ind :tmp :buf
        ctx.condDepth = ctx.condDepth - 1
    } case withexpr then {
        wnmR9: zast.nameTextAt :ast ref: n.name
        wnm: varCName :ctx vid: (defVid :symtab nid: n.nodeid.u64) name: wnmR9.stringview
        wsid9: stampIdDeep :ast :symtab n: (ast.nodes.get i: n.value.u64)
        wct: String
        if (originTidOf :symtab tid: (ztypes.tid.create from: wsid9.u64)) > 0 then {
            wct = (typeRefC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: wsid9.u64)
                thisTid: ztypes.tid
            )
        } else {
            wtn: stampNameDeep :ast :symtab n: (ast.nodes.get i: n.value.u64)
            wct = cTypeForName :ast :symtab :ctx name: wtn.stringview
        }
        wv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.value.u64)
        # a non-lvalue receiver (`with x: (mk).iterate do`) hoisted an _ahN temp
        # while that expression was built; declare it before the line that reads
        # it, as the plain-binding path does
        flushArgHoists :ctx :ind :tmp :buf
        # a reference-returning callee hands back `T*`, so a `with` binding
        # ALIASES its source exactly as a plain binding does
        {
            wrb: refBorrowCalleeFid9 :ast :symtab :ctx n: (ast.nodes.get i: n.value.u64)
            if wrb > 0 when (fnReturnsRefBorrow9
                :ast
                :symtab
                :ctx
                fid: (ztypes.tid.create from: wrb.u64)
                retTid: (ztypes.tid.create from: wsid9.u64)
            ) then {
                wct = "\{wct}*"
                ctx.ptrVids.append (defVid :symtab nid: n.nodeid.u64)
            }
        }
        if wct.length > 0 then {
            lwv: "\{ind}\{wct} \{wnm} = \{wv};\n"
            buf.append lwv
        } else {
            lwv2: "\{ind}int64_t \{wnm} = \{wv};\n"
            buf.append lwv2
        }
        emitBodyNode :ast :symtab :ctx n: (ast.nodes.get i: n.body.u64) :ind :tmp :buf
    } case forexpr then {
        ctx.condDepth = ctx.condDepth + 1
        if (emitObjIterFor :ast :symtab :ctx m: n :ind :tmp :buf) then {
            ctx.condDepth = ctx.condDepth - 1
            return
        }
        if (emitIntRangeFor :ast :symtab :ctx m: n :ind :tmp :buf) then {
            ctx.condDepth = ctx.condDepth - 1
            return
        }
        # do-while: no pre-conditions, a post-condition (`for loop {...} while C`).
        if n.conditions.length == 0 when n.postconditions.length > 0 then {
            lidDW: pushLoopLabel :ctx :tmp isDo: false
            ldw: "\{ind}do {\n"
            buf.append ldw
            ind2d: "\{ind}    "
            fLd9: tmp.frees.length
            lLd9: tmp.listFrees.length
            dvG9: false
            if n.body > 0 then {
                fbd9: ast.nodes.get i: n.body.u64
                emitBodyNode :ast :symtab :ctx n: fbd9 ind: ind2d.stringview :tmp :buf
                dvG9 = blockDiverges :ast :symtab :ctx n: fbd9
            }
            flushBlockFrees :ctx :tmp fL: fLd9 lL: lLd9 diverged: dvG9 :buf
            pcond: String
            pkiter: n.postconditions.iterate
            for pk: pkiter loop {
                pkn9: ast.nodes.get i: pk.u64
                # the checker stamps the OPERATION node, so unwrap the same way
                pkop9: pk
                match (
                    pkn9
                ) case namedoperation then {
                    pkop9 = pkn9.operation
                } else null
                pcv: emitExpr :ast :symtab :ctx n: pkn9
                tw8: (truthyCondText9
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: pkop9.u64)
                    raw: pcv.stringview
                )
                if pcond.length > 0 then pcond.append " && "
                if tw8.length > 0 then {
                    pcond.append tw8
                } else {
                    pcond.append pcv
                }
            }
            if pcond.length == 0 then pcond.append "0"
            emitContLabel :ctx id: lidDW ind: ind2d.stringview :buf
            cwP9: condParens9 cond: pcond.stringview
            lpw: "\{ind}} while \{cwP9};\n"
            buf.append lpw
            popLoopLabel :ctx id: lidDW :ind :buf
            ctx.condDepth = ctx.condDepth - 1
            return
        }
        cond: String
        kiter: n.conditions.iterate
        for kId9: kiter loop {
            k9r: ast.nodes.get i: kId9.u64
            emitForCond :ast :symtab :ctx n: k9r :cond :ind :buf
        }
        # `for loop { ... }` -- no conditions, no postconditions: an
        # unconditional loop that exits via break/return.
        if cond.length == 0 then cond.append "1"
        lidW: pushLoopLabel :ctx :tmp isDo: false
        cwW9: condParens9 cond: cond.stringview
        lw: "\{ind}while \{cwW9} {\n"
        buf.append lw
        ind2: "\{ind}    "
        fLw9: tmp.frees.length
        lLw9: tmp.listFrees.length
        dvG9: false
        if n.body > 0 then {
            fbw9: ast.nodes.get i: n.body.u64
            emitBodyNode :ast :symtab :ctx n: fbw9 ind: ind2.stringview :tmp :buf
            dvG9 = blockDiverges :ast :symtab :ctx n: fbw9
        }
        flushBlockFrees :ctx :tmp fL: fLw9 lL: lLw9 diverged: dvG9 :buf
        emitContLabel :ctx id: lidW ind: ind2.stringview :buf
        lwc: "\{ind}}\n"
        buf.append lwc
        popLoopLabel :ctx id: lidW :ind :buf
        ctx.condDepth = ctx.condDepth - 1
    } case yieldexpr then {
        emitYieldStmt :ast :symtab :ctx yd: n :ind :buf
    } else {
        # a no-arg method auto-call in statement position (this.accept,
        # this.statepop) is a dotted path: emit the call expression as a statement.
        if (nodeIsDotted9 :n) then {
            # `.release` on a protocol is a transfer marker (scope-exit destroy
            # covers it) -- emit nothing, like emitCallStmt.
            dct9: dottedChildText :ast :n
            if dct9.stringview == "release" then {
                rrid9: dottedReceiverStampId :ast :symtab callable: n
                rtt9: symtab.reg.typetypeOf typeId: rrid9
                if rtt9 == ztypes.ztypetype.protocolType then return
                rcvKey9: atomVid :symtab nid: (dottedBaseNodeId :ast :n)
                rbrw9: false
                bvg9: ctx.borrowedVars.get key: rcvKey9
                match (
                    bvg9
                ) case some then {
                    rbrw9 = bvg9
                } case none then null
                if rbrw9 then return
                rcvV9: emitDottedReceiver :ast :symtab :ctx callable: n
                if rrid9 == ctx.strTid then {
                    rdf9: "\{ind}\{ctx.strC}_free(&\{rcvV9});\n"
                    buf.append rdf9
                } else {
                    if (symtab.reg.hasDestructorName typeId: rrid9) then {
                        rdcb9: ctxCname :ctx tid: (ztypes.tid.create from: rrid9.u64)
                        rdref9: "&\{rcvV9}"
                        if (isBoxTid
                            :symtab
                            tid: (ztypes.tid.create from: rrid9.u64)
                        ) then rdref9 = "\{rcvV9}"
                        rdc9: "\{ind}\{rdcb9}_destroy(\{rdref9});\n"
                        buf.append rdc9
                    }
                }
                rinv9: false
                if rrid9 == ctx.strTid then rinv9 = true
                if rtt9 == ztypes.ztypetype.classType then rinv9 = true
                if rtt9 == ztypes.ztypetype.unionType then rinv9 = true
                if rinv9 then {
                    rci9: (typeRefC
                        :ast
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: rrid9.u64)
                        thisTid: ztypes.tid
                    )
                    riv9: "\{ind}\{rcvV9} = (\{rci9}){0};\n"
                    buf.append riv9
                }
                return
            }
            de9: emitExpr :ast :symtab :ctx :n
            if (de9.stringview.startsWith prefix: "/*") then {
                emitFail :ctx what: "unhandled statement".string line: (ztypecheck.nodeLine :n)
                lud9: "\{ind}/* zemitterc: unhandled statement */\n"
                buf.append lud9
            } else {
                drtid9: stampIdOf :symtab nid: (nodeIdOf9 :n)
                (emitDiscardedResult
                    :ast
                    :symtab
                    :ctx
                    isBorrow: (bindingRhsIsBorrow :ast :symtab :ctx :n)
                    ce: de9.stringview
                    rtid: drtid9
                    :ind
                    :tmp
                    :buf
                )
            }
            return
        }
        # a bare no-arg function call as a statement (`check_mode`): typecheck
        # coerced the atom to a call; emit the call expression as a statement.
        fcs9: atomTextOf :ast :n
        ffid9: userFnId :ast :symtab :ctx name: fcs9.stringview
        if ffid9 > 0 when (symtab.reg.typetypeOf typeId: ffid9) == ztypes.ztypetype.functionType then {
            fce9: emitExpr :ast :symtab :ctx :n
            if (fce9.stringview.startsWith prefix: "/*") == false then {
                artid9: stampIdOf :symtab nid: (nodeIdOf9 :n)
                (emitDiscardedResult
                    :ast
                    :symtab
                    :ctx
                    isBorrow: (bindingRhsIsBorrow :ast :symtab :ctx :n)
                    ce: fce9.stringview
                    rtid: artid9
                    :ind
                    :tmp
                    :buf
                )
                return
            }
        }
        # bare control keywords parse as an AtomId reference (no value): a
        # no-value `return` (goto L_done inside a generator), `break`, `continue`.
        bkw9: atomTextOf :ast :n
        if bkw9.stringview == "return" then {
            if ctx.genActive then {
                lgd9: "\{ind}goto L_done;\n"
                buf.append lgd9
            } else {
                emitReturnCleanup :ctx :tmp retExpr: "" keepRefd: true :ind :buf
                lrt9: "\{ind}return;\n"
                buf.append lrt9
            }
        } else {
            if bkw9.stringview == "break" then {
                emitBreakFrees :ctx :tmp :ind :buf
                if ctx.breakLabels.length > 0 then {
                    bid9: ctx.breakLabels.get i: (ctx.breakLabels.length - 1)
                    # an owned-payload loop's per-iteration dtor: the jump
                    # skips the fall-through line, so emit its copy here (a
                    # do-block entry carries an empty cleanup).
                    bcl9: ctx.breakLabelCleanup.get i: (ctx.breakLabels.length - 1)
                    if bcl9.length > 0 then {
                        lbc9: "\{ind}\{bcl9}"
                        buf.append lbc9
                    }
                    lbkg9: "\{ind}goto __zbrk_\{bid9};\n"
                    buf.append lbkg9
                    ubk9: true
                    ctx.breakLabelUsed.set key: bid9 value: ubk9
                } else {
                    lbk9: "\{ind}break;\n"
                    buf.append lbk9
                }
            } else {
                if bkw9.stringview == "continue" then {
                    # inside a do{}while(0) block wrapper a C continue exits
                    # the wrapper, not the loop: jump to the nearest LOOP
                    # entry's __zcont label instead (frees since that loop).
                    inDo9: false
                    loopIdx9: u64
                    hasLoop9: false
                    li9: ctx.breakLabelIsDo.length
                    if li9 > 0 then {
                        if (ctx.breakLabelIsDo.get i: (li9 - 1)) then inDo9 = true
                        sj9: li9
                        for sj9 > 0 loop {
                            sj9 = sj9 - 1
                            if (ctx.breakLabelIsDo.get i: sj9) == false when (hasLoop9) == false then {
                                loopIdx9 = sj9
                                hasLoop9 = true
                            }
                        }
                    }
                    if inDo9 when hasLoop9 then {
                        emitContinueFrees :ctx :tmp idx: loopIdx9 :ind :buf
                        ccl9: ctx.breakLabelCleanup.get i: loopIdx9
                        if ccl9.length > 0 then {
                            lcc9: "\{ind}\{ccl9}"
                            buf.append lcc9
                        }
                        cid9: ctx.breakLabels.get i: loopIdx9
                        lcg9: "\{ind}goto __zcont_\{cid9};\n"
                        buf.append lcg9
                        ucn9: true
                        ctx.contLabelUsed.set key: cid9 value: ucn9
                    } else {
                        emitBreakFrees :ctx :tmp :ind :buf
                        if ctx.breakLabelCleanup.length > 0 then {
                            pcl0: (ctx.breakLabelCleanup.get
                                i: (ctx.breakLabelCleanup.length - 1)
                            )
                            if pcl0.length > 0 then {
                                lpc9: "\{ind}\{pcl0}"
                                buf.append lpc9
                            }
                        }
                        lct9: "\{ind}continue;\n"
                        buf.append lct9
                    }
                } else {
                    ue9: emitExpr :ast :symtab :ctx :n
                    if (ue9.stringview.startsWith prefix: "/*") then {
                        (emitFail
                            :ctx
                            what: "unhandled statement".string
                            line: (ztypecheck.nodeLine :n)
                        )
                        lu: "\{ind}/* zemitterc: unhandled statement */\n"
                        buf.append lu
                    } else {
                        urtid9: stampIdOf :symtab nid: (nodeIdOf9 :n)
                        (emitDiscardedResult
                            :ast
                            :symtab
                            :ctx
                            isBorrow: (bindingRhsIsBorrow :ast :symtab :ctx :n)
                            ce: ue9.stringview
                            rtid: urtid9
                            :ind
                            :tmp
                            :buf
                        )
                    }
                }
            }
        }
    }
}

# ensureUnitCache -- build the emit-stable unit lists (tids for the id probe,
# keys for the composed-key fallback) once per Ctx. The program root's children
# are settled in typecheck and never mutated during emit, so the snapshot stays
# valid; this replaces the per-resolve List rebuild that walked them every call.
ensureUnitCache: function {ctx: Ctx pool: zast.StringPool.view ty: ztyping.ZTyping.view} is {
    if ctx.unitCacheBuilt then return
    puds9: ztypecheck.programUnitDecls :ty
    with uit: puds9.iterate do for ud9: uit loop {
        ud8: ztypes.declid.create from: ud9
        utd9: ztypecheck.declTypeIdOf :ty declId: ud8
        if (utd9.isZero) == false then {
            ukc9: (zast.poolTextCopy
                :pool
                ref: (ztypecheck.declNameIdOf :ty declId: ud8)
            )
            ctx.unitKeysC.append ukc9
            ctx.unitTidsC.append utd9
        }
    }
    ctx.unitCacheBuilt = true
}

# resolveTypeIdByNameId -- a type id for an already-interned name (Ast.names
# pool id): main-unit, then system, then the cross-unit lookup. 0 when
# unresolved (incl. a 0 id -- a name not in the pool matches no member).
# Every stage is id-keyed (declChildOfId); the name text is materialised only on
# the rare composed-key fallback.
resolveTypeIdByNameId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    nameId: zast.nameid
} out u64 is {
    if nameId.isZero then return 0
    mc9: ctx.resolveByNameC.get key: nameId.u64
    match (
        mc9
    ) case some then {
        return mc9
    } case none then null
    r9: typeIdByNameStages9 :ast :symtab :ctx :nameId
    ctx.resolveByNameC.set key: nameId.u64 value: r9
    return r9
}

# resolve a type id by name across the resolution stages.
typeIdByNameStages9: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    nameId: zast.nameid
} out u64 is {
    f: userFnIdById :ast :symtab :ctx :nameId
    if f > 0 then return f
    mo: ztypecheck.resolveSystemChildById :ast ty: symtab.typing reg: symtab.reg :nameId
    match (
        mo
    ) case some then {
        return mo
    } case none then null
    lr9: optU64Or9 o: (ztypecheck.walkLookupTyperefById
        :ast
        ty: symtab.typing
        reg: symtab.reg
        unitDecl: (ztypecheck.unitDeclOfName ty: symtab.typing :ast name: ctx.mainName.stringview)
        baseId: nameId
    )
    if lr9 > 0 then return lr9
    # cross-unit: the type may live in a dep unit (zlexer/zast/zvfs) outside
    # walkLookupTyperefById's search list. Pass 1 probes each unit scope by id
    # (no key composition); the composed-key resolvedByKey pass (which also
    # follows unit-level aliases) runs only when every direct probe missed.
    found2: u64
    ensureUnitCache :ctx pool: ast.names ty: symtab.typing
    uki9: u64
    ukn9: ctx.unitTidsC.length
    for uki9 < ukn9 loop {
        if found2 == 0 then {
            co9: (symtab.typing.declChildOfId
                parentTypeId: (ctx.unitTidsC.get i: uki9)
                :nameId
            )
            match (
                co9
            ) case some then {
                found2 = co9
            } case none then null
        }
        uki9 = uki9 + 1
    }
    if found2 == 0 then {
        uki8: u64
        ukn8: ctx.unitKeysC.length
        for uki8 < ukn8 loop {
            if found2 == 0 then {
                uk9: ctx.unitKeysC.get i: uki8
                ud7x9: (ztypecheck.unitDeclOfNameId
                    ty: symtab.typing
                    nameId: (zast.poolFind pool: ast.names text: uk9.stringview)
                )
                r2: (ztypecheck.resolvedByIds
                    :ast
                    ty: symtab.typing

                    unitDecl: ud7x9
                    name: nameId
                )
                match (
                    r2
                ) case some then {
                    found2 = r2
                } case none then null
            }
            uki8 = uki8 + 1
        }
    }
    return found2
}

# resolveTypeIdByName -- text entry point: intern-probe the name to a pool id
# (a name not in the pool matches no interned member, so 0 resolves to 0,
# preserving the old text behaviour) and resolve id-keyed. The per-stage
# StringPool.find the old body paid once per stage collapses to this single
# probe.
resolveTypeIdByName: function {
    ast: Ast
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    name: StringView
} out u64 is {
    nid9: (zast.poolFind pool: ast.names text: name)
    return (resolveTypeIdByNameId :ast :symtab :ctx nameId: nid9)
}

# fnReturnTidOf -- the registry-recorded return tid for a FUNCTION id, 0 when
# absent. Scopes the typeById view so no lock outlives the read.
fnReturnTidOf: function {symtab: zenv.ZSymbolTable tid: ztypes.tid} out u64 is {
    r9: u64
    {
        rt9: symtab.reg.returnTypeOf :tid
        if rt9 > 0 then r9 = rt9
    }
    return r9
}

# genericOriginOf9 -- the registry-recorded generic origin for `tid`, 0 when
# absent. Scopes the typeById view like fnReturnTidOf.
genericOriginOf9: function {symtab: zenv.ZSymbolTable tid: ztypes.tid} out ztypes.tid is {
    g9: u64
    {
        go9: symtab.reg.genericOriginOf :tid
        if go9 > 0 then g9 = go9
    }
    return (ztypes.tid.create from: g9)
}

# definedInUnitOf -- the defining unit recorded for `tid`, as an OWNED option.
# The map view lives only inside this body: a view bound at a call site would
# hold its shared lock across symtab-passing calls and conflict.
definedInUnitOf: function {symtab: zenv.ZSymbolTable tid: ztypes.tid} out (Option of: String) is {
    nm9: (ztypecheck.unitNameOfTid
        ty: symtab.typing
        reg: symtab.reg
        tid: (ztypes.tid.create from: tid.u64)
    )
    if nm9.length == 0 then return (Option.none String)
    return (Option.some nm9)
}

# emitReassignLvalue -- the C lvalue for a reassignment target. A `got.field`
# whose base atom is a narrowed match-arm binding over a borrowed reftype view
# (seeded in narrowBox) writes THROUGH the box into the live entry; the local
# read-copy is not the backing storage. Other targets emit normally.
emitReassignLvalue: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    n: Node.view
} out String is {
    match (
        n
    ) case dottedpath then {
        ba9: atomTextOf :ast n: (ast.nodes.get i: n.parent.u64)
        if ba9.length > 0 then {
            ba9V9: atomVid :symtab nid: (atomNodeId9 n: (ast.nodes.get i: n.parent.u64))
            nbo9: vvGet xs: ctx.narrowBox vid: ba9V9
            if nbo9.length > 0 then {
                mem9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
                lvx9: "\{nbo9}.\{mem9}"
                return lvx9
            }
        }
        memFp9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        rpnid9: nodeIdOf9 n: (ast.nodes.get i: n.parent.u64)
        rs09: stampIdOf :symtab nid: rpnid9
        rsn9: typeNameOfReg9 :symtab tid: rs09
        rsc9: canonFnId :ast :symtab :ctx tid: rs09 name: rsn9.stringview
        rsFp9: rs09
        if rsc9 > 0 then rsFp9 = ztypes.tid.create from: rsc9.u64
        rsFpc9: chaseColMono :symtab :ctx tid: rsFp9
        if (symtab.typing.declIsFnptrField
            pool: ast.names
            parentTypeId: rsFpc9
            name: memFp9.stringview
        ) then {
            recvFp9: atomTextOf :ast n: (ast.nodes.get i: n.parent.u64)
            rfv9: atomVid :symtab nid: (atomNodeId9 n: (ast.nodes.get i: n.parent.u64))
            accFpL9: ".".string
            if (isPtrVid :ctx vid: rfv9) then accFpL9 = "->".string
            recvFpC9: emitLocalAtomName :ctx name: recvFp9.stringview vid: rfv9
            return "\{recvFpC9}\{accFpL9}\{memFp9}"
        }
    } else null
    return (emitExpr :ast :symtab :ctx :n)
}

# emitMatchStmt -- a variant-subject match as a tag switch over a temp;
# payload arms shadow the subject name with the payload value.
# emitGenericDissect -- compile-time `match` on a generic parameter. The concrete
# type bound to the parameter for the current mono instance (ctx.curThisTid) is
# resolved via genericArgOf; the arm whose label names that type is emitted
# inline and every other arm is dropped (no runtime switch). No matching arm and
# no `else` emits nothing (the caller-level no-match check is a compile error).
genericOwnerKey9: function {
    symtab: zenv.ZSymbolTable.view
    ownerTid: ztypes.tid
} out ztypes.declid is {
    orig9: genericOriginOf9 :symtab tid: ownerTid
    if orig9.isZero then return (ztypes.declid.create from: 0)
    return (ztypecheck.declOfTypeId reg: symtab.reg tid: (ztypes.tid.create from: orig9.u64))
}

# emit the selected arm of a compile-time generic `match`.
emitGenericDissect: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    m: zast.CaseData.view
    ownerTid: ztypes.tid
    paramName: StringView
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    concrete9: ztypes.tid
    isVal9: false
    if ownerTid > 0 then {
        tk9: genericOwnerKey9 :symtab :ownerTid
        if (tk9.isZero) == false then {
            pnames9: symtab.reg.genericParamNamesOf tdecl: tk9
            found9: false
            ord9: u64
            k9: u64
            with pnit9: pnames9.iterate do for pn9: pnit9 loop {
                if (found9) == false then {
                    if pn9.stringview == paramName then {
                        found9 = true
                        ord9 = k9
                    } else {
                        k9 = k9 + 1
                    }
                }
            }
            if found9 then {
                concrete9 = ztypes.tid.create from: (symtab.reg.genericArgAt
                    specId: ownerTid
                    ordinal: ord9
                )
                isVal9 = symtab.reg.genericArgIsValueAt specId: ownerTid ordinal: ord9
            }
        }
    }
    win9: u32
    subjDesc9: String
    if isVal9 then {
        subjDesc9 = "\{concrete9}"
        with cit9: m.clauses.iterate do for cId9: cit9 loop {
            cnode9: ast.nodes.get i: cId9.u64
            match (
                cnode9
            ) case caseclause then {
                if win9 == 0 then {
                    if cnode9.name != 0 then {
                        cnt9: zast.poolTextAt pool: ast.names ref: cnode9.name
                        pu9: cnt9.stringview.parseU64
                        match (
                            pu9
                        ) case ok then {
                            if pu9 == concrete9 then win9 = cnode9.statement
                        } case err then null
                    }
                }
            } else null
        }
    } else {
        cn0: String
        if concrete9 > 0 then cn0 = (typeNameOfReg9
            :symtab
            tid: (ztypes.tid.create from: concrete9.u64)
        )
        cnid9: u32
        if cn0.length > 0 then cnid9 = zast.poolFind pool: ast.names text: cn0.stringview
        with cit9: m.clauses.iterate do for cId9: cit9 loop {
            cnode9: ast.nodes.get i: cId9.u64
            match (
                cnode9
            ) case caseclause then {
                if win9 == 0 then {
                    if cnid9 != 0 when cnode9.name.u32 == cnid9 then win9 = cnode9.statement
                }
            } else null
        }
        subjDesc9 = cn0
    }
    if win9 == 0 then win9 = m.elseclause
    if win9 > 0 then {
        buf.append ind
        buf.append "{\n"
        emitBodyNode :ast :symtab :ctx n: (ast.nodes.get i: win9.u64) :ind :tmp :buf
        buf.append ind
        buf.append "}\n"
    } else {
        cnm9: "generic match on '\{paramName}' has no case for '\{subjDesc9}' and no else"
        ctx.emitErrors.append from: cnm9.copy
        ef9: "\{ind}z_panic(\"(compile-time error)\");\n"
        buf.append ef9
    }
}

# the core (stripped) subject node id of a match.
matchSubjectCore9: function {ast: Ast.view nid: u64} out u64 is {
    n9: ast.nodes.get i: nid.u64
    match (
        n9
    ) case expression then {
        return (matchSubjectCore9 :ast nid: n9.expression.u64)
    } else {
        return nid
    }
}

# emit a match as a C switch.
emitMatchStmt: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    m: zast.CaseData.view
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    sx: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: m.subject.u64)
    stn: stampNameDeep :ast :symtab n: (ast.nodes.get i: m.subject.u64)
    {
        sTid9: stampIdDeep :ast :symtab n: (ast.nodes.get i: m.subject.u64)
        if (isOrdinalPair :symtab tid: (ztypes.tid.create from: sTid9.u64)) then {
            (emitOrdinalPairMatch
                :ast
                :symtab
                :ctx
                :m
                subj: sx.stringview
                tid: (ztypes.tid.create from: sTid9.u64)
                :assignTo
                :ind
                :tmp
                :buf
            )
            return
        }
    }
    vtid: (canonTypeId
        :ast
        :symtab
        :ctx
        tid: (stampIdDeep :ast :symtab n: (ast.nodes.get i: m.subject.u64))
        name: stn.stringview
    )
    subjSid9: stampIdOf :symtab nid: (nodeIdOf9 n: (ast.nodes.get i: m.subject.u64))
    if subjSid9 > 0 then {
        if (symtab.reg.typetypeOf typeId: subjSid9) == ztypes.ztypetype.genericParam then {
            (emitGenericDissect
                :ast
                :symtab
                :ctx
                :m
                ownerTid: ctx.curThisTid
                paramName: stn.stringview
                :ind
                :tmp
                :buf
            )
            return
        }
    }
    dcore9: matchSubjectCore9 :ast nid: m.subject.u64
    dcn9: ast.nodes.get i: dcore9.u64
    match (
        dcn9
    ) case dottedpath then {
        dleaf9: dottedChildText :ast n: (ast.nodes.get i: dcore9.u64)
        dbnid9: dottedBaseNodeId :ast n: (ast.nodes.get i: dcore9.u64)
        dbst9: stampIdOf :symtab nid: dbnid9
        downer9: ctx.curThisTid
        if (symtab.reg.genericArgCount specId: dbst9) > 0 then downer9 = dbst9
        if downer9 > 0 when dleaf9.length > 0 then {
            dkey9: genericOwnerKey9 :symtab ownerTid: downer9
            if dkey9 > 0 then {
                if (symtab.reg.isGenericParamOf tdecl: dkey9 name: dleaf9.stringview) then {
                    (emitGenericDissect
                        :ast
                        :symtab
                        :ctx
                        :m
                        ownerTid: downer9
                        paramName: dleaf9.stringview
                        :ind
                        :tmp
                        :buf
                    )
                    return
                }
            }
        }
    } else null
    isVar: false
    isUni: false
    if vtid > 0 then {
        vtt0: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: vtid.u64)
        if vtt0 == ztypes.ztypetype.variantType then isVar = true
        if vtt0 == ztypes.ztypetype.unionType then isUni = true
    }
    if (isVar) == false then {
        if (isUni) == false then {
            sct: (scalarCTypeFor
                :symtab
                name: stn.stringview
                tid: (ztypes.tid.create from: vtid.u64)
            )
            if sct.length > 0 then {
                emitScalarMatch :ast :symtab :ctx :m subj: sx.stringview :assignTo :ind :tmp :buf
                return
            }
            emitFail :ctx what: "unhandled match subject type \{stn}" line: m.lineno
            lu0: "\{ind}/* zemitterc: unhandled match subject type \{stn} */\n"
            buf.append lu0
            return
        }
    }
    vc: ctxCname :ctx tid: (ztypes.tid.create from: vtid.u64)
    mN: tmp.next
    l0: "\{ind}\{vc}_t _m\{mN} = \{sx};\n"
    buf.append l0
    accM9: ".tag".string
    if (isOrdinalVariant :symtab tid: (ztypes.tid.create from: vtid.u64)) then accM9 = "".string
    l1: "\{ind}switch (_m\{mN}\{accM9}) {\n"
    buf.append l1
    sname: atomTextDeep :ast n: (ast.nodes.get i: m.subject.u64)
    # the subject's variable: inside an arm the bound name IS the subject,
    # narrowed, so its declaration must carry the same identifier the body's
    # references resolve to
    snameV9: atomVid :symtab nid: (atomNodeIdDeep9 :ast n: (ast.nodes.get i: m.subject.u64))
    ind2: "\{ind}    "
    with citer: m.clauses.iterate do for cId9: citer loop {
        c: ast.nodes.get i: cId9.u64
        (emitMatchClause
            :ast
            :symtab
            :ctx
            :c
            vtid: (ztypes.tid.create from: vtid.u64)
            :isUni
            :mN
            sname: sname.stringview
            snameVid: snameV9
            :assignTo
            ind: ind2.stringview
            :tmp
            :buf
        )
    }
    covA9: (List String)
    with c3iter: m.clauses.iterate do for c3Id9: c3iter loop {
        c3: ast.nodes.get i: c3Id9.u64
        match (
            c3
        ) case caseclause then {
            cnm9: zast.poolTextCopy pool: ast.names ref: c3.name
            covA9.append cnm9
        } else null
    }
    meN9: String
    meV9: String
    meT9: ztypes.tid
    meSeed9: false
    if m.elseclause > 0 then {
        if sname.length > 0 then {
            allME9: (List String)
            sumArmNames9 :ast :symtab tid: (ztypes.tid.create from: vtid.u64) names: allME9
            remME9: u64
            armME9: String
            with mit9: allME9.iterate do for ma9: mit9 loop {
                cov9: false
                with cvi9: covA9.iterate do for cv9: cvi9 loop {
                    if cv9.stringview == ma9.stringview then cov9 = true
                }
                if (cov9) == false then {
                    remME9 = remME9 + 1
                    mv9: ma9.copy
                    armME9 = mv9
                }
            }
            if remME9 == 1 then {
                mre9: false
                if m.elseclause > 0 then {
                    mec9: ast.nodes.get i: m.elseclause.u64
                    mre9 = bodyReassigns9 :ast n: mec9 name: sname.stringview
                }
                if (mre9) == false then {
                    mrecv9: "_m\{mN}"
                    alias9: (armAliasText9
                        :ast
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: vtid.u64)
                        arm: armME9.stringview
                        recv: mrecv9.stringview
                        acc: "."
                    )
                    if alias9.length > 0 then {
                        msn9: sname.copy
                        meN9 = msn9
                        meV9 = alias9.copy
                        meT9 = ztypes.tid.create from: (optU64Or9
                            o: (symtab.typing.declChildOf
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: vtid.u64)
                                name: armME9.stringview
                            )
                        )
                        meSeed9 = true
                    }
                }
            }
        }
    }
    mePrevV9: String
    mePrevT9: ztypes.tid
    if meSeed9 then {
        pv9: vvGet xs: ctx.narrowBox vid: snameV9
        mePrevV9 = pv9
        mePrevT9 = ztypes.tid.create from: (optTidOr9 o: (vtGet xs: ctx.narrowTid vid: snameV9))
        vvSet xs: ctx.narrowBox vid: snameV9 val: meV9.stringview
        vtSet xs: ctx.narrowTid vid: snameV9 tid: (ztypes.tid.create from: meT9.u64)
    }
    mdvg: matchDiverges :symtab nid: m.nodeid.u64
    (emitMatchElse
        :ast
        :symtab
        :ctx
        oId: m.elseclause
        :assignTo
        ind: ind2.stringview
        :tmp
        diverges: mdvg
        :buf
    )
    if meSeed9 then {
        if mePrevV9.length > 0 then {
            vvSet xs: ctx.narrowBox vid: snameV9 val: mePrevV9.stringview
        } else {
            vvRemove xs: ctx.narrowBox vid: snameV9
        }
        if mePrevT9 > 0 then {
            vtSet xs: ctx.narrowTid vid: snameV9 tid: (ztypes.tid.create from: mePrevT9.u64)
        } else {
            vtRemove xs: ctx.narrowTid vid: snameV9
        }
    }
    l9: "\{ind}}\n"
    buf.append l9
}

# emitScalarMatch -- a value match over a scalar subject: a C switch with
# constant arm labels (arm names resolve through the constant pool).
emitScalarMatch: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    m: zast.CaseData.view
    subj: StringView
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    l0: "\{ind}switch (\{subj}) {\n"
    buf.append l0
    ind2: "\{ind}    "
    citer: m.clauses.iterate
    for cId9: citer loop (emitScalarClause
        :ast
        :symtab
        :ctx
        c: (ast.nodes.get i: cId9.u64)
        :assignTo
        ind: ind2.stringview
        :tmp
        :buf
    )
    mdvg: matchDiverges :symtab nid: m.nodeid.u64
    (emitMatchElse
        :ast
        :symtab
        :ctx
        oId: m.elseclause
        :assignTo
        ind: ind2.stringview
        :tmp
        diverges: mdvg
        :buf
    )
    l9: "\{ind}}\n"
    buf.append l9
}

# emitBoolMatch -- a match over a bool subject. `case true`/`case false` become
# an if (subj) / else if (!subj) chain (a bool is a primitive C bool, not a
# tagged variant), the optional else arm a trailing `else`. assignTo writes the
# arm value in each branch.
emitOrdinalPairMatch: function {
    ast: Ast
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    m: zast.CaseData.view
    subj: StringView
    tid: ztypes.tid
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    falseArm9: ordinalPairFirstArmId :symtab :tid
    firstB9: true
    citer: m.clauses.iterate
    for cId9: citer loop {
        c: ast.nodes.get i: cId9.u64
        match (
            c
        ) case caseclause then {
            condB9: subj.string
            if falseArm9 > 0 when c.name.u64 == falseArm9 then condB9 = "!\{subj}"
            kwB9: "if"
            if (firstB9) == false then kwB9 = "else if"
            firstB9 = false
            lhB9: "\{ind}\{kwB9} (\{condB9}) {\n"
            buf.append lhB9
            indB9: "\{ind}    "
            if assignTo.length > 0 then {
                vxB9: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: c.statement.u64)
                laB9: "\{ind}    \{assignTo} = \{vxB9};\n"
                buf.append laB9
            } else {
                fLB9: tmp.frees.length
                lLB9: tmp.listFrees.length
                cstB9: ast.nodes.get i: c.statement.u64
                emitBodyNode :ast :symtab :ctx n: cstB9 ind: indB9.stringview :tmp :buf
                dvF9: blockDiverges :ast :symtab :ctx n: cstB9
                flushBlockFrees :ctx :tmp fL: fLB9 lL: lLB9 diverged: dvF9 :buf
            }
            lcB9: "\{ind}}\n"
            buf.append lcB9
        } else null
    }
    bdvg: matchDiverges :symtab nid: m.nodeid.u64
    emitBoolElse :ast :symtab :ctx oId: m.elseclause :assignTo :ind :tmp diverges: bdvg :buf
}

# emitBoolElse -- the trailing `else { ... }` of a bool match (none = nothing).
emitBoolElse: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    oId: zast.nodeid
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr.view
    diverges: bool
    buf: String.borrow
} is {
    if oId > 0 then {
        o: ast.nodes.get i: oId.u64
        leB9: "\{ind}else {\n"
        buf.append leB9
        indE9: "\{ind}    "
        if assignTo.length > 0 then {
            veB9: emitExpr :ast :symtab :ctx n: o
            laE9: "\{ind}    \{assignTo} = \{veB9};\n"
            buf.append laE9
        } else {
            fLE9: tmp.frees.length
            lLE9: tmp.listFrees.length
            emitBodyNode :ast :symtab :ctx n: o ind: indE9.stringview :tmp :buf
            dvF9: blockDiverges :ast :symtab :ctx n: o
            flushBlockFrees :ctx :tmp fL: fLE9 lL: lLE9 diverged: dvF9 :buf
        }
        lceB9: "\{ind}}\n"
        buf.append lceB9
    } else {
        if diverges then {
            leD9: "\{ind}else {\n"
            buf.append leD9
            lzD9: "\{ind}    z_unreachable();\n"
            buf.append lzD9
            lcD9: "\{ind}}\n"
            buf.append lcD9
        }
    }
}

# scalarArmLabel -- the C case label for a scalar arm: the constant
# pool's rendering when the arm names a constant, else the name itself.
scalarArmLabel: function {
    ast: Ast
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    arm: StringView
} out String is {
    lv9: (memberConstTextOf9
        :ast
        :symtab
        :ctx
        unitTid: (unitTidOf9 :ast :symtab unitName: ctx.mainName.stringview)
        nameId: (zast.poolFind pool: ast.names text: arm)
    )
    if lv9.length > 0 then return lv9
    ac: arm.string
    return ac
}

# flushBlockFrees -- emit + reclaim the heap/collection destructors registered
# since (fL, lL) so a local declared inside a block (a match arm) is freed at
# block end, not function end (where it is out of C scope). LIFO order.
flushBlockFrees: function {
    ctx: Ctx.view
    tmp: TmpCtr
    fL: u64
    lL: u64
    diverged: bool
    buf: String.borrow
} is {
    # a block that diverges on every path already freed these -- through
    # emitReturnCleanup on a return, emitBreakFrees on a break -- so pop them
    # (the locals leave C scope either way) but emit nothing, or the frees land
    # after the diverging statement as unreachable code
    live9: diverged == false
    for tmp.listFrees.length > lL loop {
        lvo: tmp.listFrees.pop
        tmp.listFreeVars.pop
        if live9 then buf.append lvo
    }
    for tmp.frees.length > fL loop {
        fvo: tmp.frees.pop
        if live9 then {
            ff9: "    \{ctx.strC}_free(&\{fvo});\n"
            buf.append ff9
        }
    }
}

# emitBreakFrees -- free the loop-body owned locals (everything bound since the
# innermost loop entry) before a `break`/`continue`, which skips the loop body's
# end-of-block flushBlockFrees. Non-destructive (reads by index, no pop): the
# normal fall-through still flushes them at block close. Mirrors flushBlockFrees
# order (listFrees newest-first, then frees).
emitBreakFrees: function {ctx: Ctx.view tmp: TmpCtr.view ind: StringView buf: String.borrow} is {
    if ctx.breakFreesMarks.length == 0 then return
    fMark: ctx.breakFreesMarks.get i: (ctx.breakFreesMarks.length - 1)
    lMark: ctx.breakListMarks.get i: (ctx.breakListMarks.length - 1)
    i9: tmp.listFrees.length
    for i9 > lMark loop {
        i9 = i9 - 1
        st9: tmp.listFrees.get i: i9
        buf.append st9
    }
    j9: tmp.frees.length
    for j9 > fMark loop {
        j9 = j9 - 1
        nm9: tmp.frees.get i: j9
        ff0: "\{ind}\{ctx.strC}_free(&\{nm9});\n"
        buf.append ff0
    }
}

# emitContinueFrees -- free the owned locals bound since the mark-stack entry
# at `idx` (the targeted LOOP's entry) before a continue that jumps out of a
# do-block wrapper. Non-destructive, mirroring emitBreakFrees.
emitContinueFrees: function {
    ctx: Ctx.view
    tmp: TmpCtr.view
    idx: u64
    ind: StringView
    buf: String.borrow
} is {
    fMark: ctx.breakFreesMarks.get i: idx
    lMark: ctx.breakListMarks.get i: idx
    i9: tmp.listFrees.length
    for i9 > lMark loop {
        i9 = i9 - 1
        st9: tmp.listFrees.get i: i9
        buf.append st9
    }
    j9: tmp.frees.length
    for j9 > fMark loop {
        j9 = j9 - 1
        nm9: tmp.frees.get i: j9
        ff0: "\{ind}\{ctx.strC}_free(&\{nm9});\n"
        buf.append ff0
    }
}

# emit one arm of a match over a scalar subject.
emitScalarClause: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    c: Node.view
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    match (
        c
    ) case caseclause then {
        armC9: zast.nameTextAt :ast ref: c.name
        arm: armC9.stringview
    lbl: scalarArmLabel :ast :symtab :ctx :arm
        l2: "\{ind}case \{lbl}: {\n"
        buf.append l2
        ind3: "\{ind}    "
        dv9: false
        if assignTo.length > 0 then {
            vx9: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: c.statement.u64)
            la9: "\{ind}    \{assignTo} = \{vx9};\n"
            buf.append la9
        } else {
            fL9: tmp.frees.length
            lL9: tmp.listFrees.length
            cst9: ast.nodes.get i: c.statement.u64
            emitBodyNode :ast :symtab :ctx n: cst9 ind: ind3.stringview :tmp :buf
            dv9 = blockDiverges :ast :symtab :ctx n: cst9
            flushBlockFrees :ctx :tmp fL: fL9 lL: lL9 diverged: dv9 :buf
        }
        if dv9 == false then {
            l5: "\{ind}    break;\n"
            buf.append l5
        }
        l6: "\{ind}}\n"
        buf.append l6
    } else null
}

# emit one arm of a match over a tagged sum.
emitMatchClause: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    c: Node.view
    vtid: ztypes.tid
    isUni: bool
    mN: u64
    sname: StringView
    snameVid: ztypes.vid
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    match (
        c
    ) case caseclause then {
        armC9: zast.nameTextAt :ast ref: c.name
        arm: armC9.stringview
        tg: variantTag :symtab tid: (ztypes.tid.create from: vtid.u64) :arm
        l2: "\{ind}case \{tg}: {\n"
        buf.append l2
        pc: armPayloadC :ast :symtab :ctx tid: (ztypes.tid.create from: vtid.u64) :arm
        ind3: "\{ind}    "
        didSeed: false
        if pc.length > 0 when sname.length > 0 then {
            if isUni then {
                cmt9: "\{ind}    /* alias: \{sname} => (*(\{pc}*)_m\{mN}.data) */\n"
                buf.append cmt9
                nbv: "(*(\{pc}*)_m\{mN}.data)"
                vvSet xs: ctx.narrowBox vid: snameVid val: nbv.stringview
                co: symtab.typing.declChildOf pool: ast.names parentTypeId: vtid name: arm
                match (
                    co
                ) case some then {
                    vtSet xs: ctx.narrowTid vid: snameVid tid: (ztypes.tid.create from: co.u64)
                } case none then null
                didSeed = true
            } else {
                snE9: varCName :ctx vid: snameVid name: sname
                l3: "\{ind}    \{pc} \{snE9} = _m\{mN}.data.\{arm};\n"
                buf.append l3
                l4: "\{ind}    (void)\{snE9};\n"
                buf.append l4
            }
        }
        dv9: false
        if assignTo.length > 0 then {
            vx9: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: c.statement.u64)
            la9: "\{ind}    \{assignTo} = \{vx9};\n"
            buf.append la9
        } else {
            fL9: tmp.frees.length
            lL9: tmp.listFrees.length
            cst9: ast.nodes.get i: c.statement.u64
            emitBodyNode :ast :symtab :ctx n: cst9 ind: ind3.stringview :tmp :buf
            dv9 = blockDiverges :ast :symtab :ctx n: cst9
            flushBlockFrees :ctx :tmp fL: fL9 lL: lL9 diverged: dv9 :buf
        }
        if didSeed then {
            vvRemove xs: ctx.narrowBox vid: snameVid
            vtRemove xs: ctx.narrowTid vid: snameVid
        }
        if dv9 == false then {
            l5: "\{ind}    break;\n"
            buf.append l5
        }
        l6: "\{ind}}\n"
        buf.append l6
    } else null
}

# emit a match's else arm.
emitMatchElse: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    oId: zast.nodeid
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr.view
    diverges: bool
    buf: String.borrow
} is {
    if oId > 0 then {
        o: ast.nodes.get i: oId.u64
        l7: "\{ind}default: {\n"
        buf.append l7
        ind3: "\{ind}    "
        dv8: false
        if assignTo.length > 0 then {
            vx8: emitExpr :ast :symtab :ctx n: o
            la8: "\{ind}    \{assignTo} = \{vx8};\n"
            buf.append la8
        } else {
            fLe9: tmp.frees.length
            lLe9: tmp.listFrees.length
            emitBodyNode :ast :symtab :ctx n: o ind: ind3.stringview :tmp :buf
            dv8 = blockDiverges :ast :symtab :ctx n: o
            flushBlockFrees :ctx :tmp fL: fLe9 lL: lLe9 diverged: dv8 :buf
        }
        if dv8 == false then {
            l8: "\{ind}    break;\n"
            buf.append l8
        }
        l9: "\{ind}}\n"
        buf.append l9
    } else {
        if diverges then {
            ld0: "\{ind}default: z_unreachable();\n"
            buf.append ld0
        } else {
            ld1: "\{ind}default: break;\n"
            buf.append ld1
        }
    }
}

# emitBranchAssignOptional -- emit a do-block-with-break body, wrapping the final
# value in the optional's `some` arm (tag + data.some); a `break` reached first
# leaves the result at its pre-set `none` tag.
# emitOptionalAssign -- the some-arm assignment for a break-carrying do value:
# inline for a valtype optionval (payC ""), a malloc'd box for a reftype
# Option payload.
emitOptionalAssign: function {
    target: StringView
    someTag: StringView
    payC: StringView
    vx: StringView
    ind: StringView
    buf: String.borrow
} is {
    if payC.length > 0 then {
        lb: "\{ind}\{target}.tag = \{someTag};\n\{ind}{ \{payC}* _zb = (\{payC}*)z_xmalloc(sizeof(\{payC})); *_zb = \{vx}; \{target}.data = _zb; }\n"
        buf.append lb
    } else {
        la: "\{ind}\{target}.tag = \{someTag};\n\{ind}\{target}.data.some = \{vx};\n"
        buf.append la
    }
}

# emit an optional-valued assignment inside a branch.
emitBranchAssignOptional: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    target: StringView
    someTag: StringView
    payC: StringView
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    match (
        n
    ) case statement then {
        cnt: n.statements.length
        si: u64
        for si < cnt loop {
            sxId9: n.statements.get i: si
            sx: ast.nodes.get i: sxId9.u64
            if si + 1 == cnt then {
                vx: emitExpr :ast :symtab :ctx n: sx
                emitOptionalAssign :target :someTag :payC vx: vx.stringview :ind :buf
                emitValueTakeInvalidations :ast :symtab :ctx n: sx :ind :buf
            } else {
                emitStmt :ast :symtab :ctx n: sx :ind :tmp :buf
                # a diverging statement -- typically an `if` the emitter folded
                # to an unconditional break -- ends the block, so the value
                # assignment below it can never run. The optional stays none,
                # which is what the break path yields anyway.
                if (stmtDiverges9
                    :ast
                    :symtab
                    :ctx
                    sid: (zast.nodeid.create from: sxId9.u64)
                ) then si = cnt
            }
            si = si + 1
        }
    } else {
        vx2: emitExpr :ast :symtab :ctx :n
        emitOptionalAssign :target :someTag :payC vx: vx2.stringview :ind :buf
        emitValueTakeInvalidations :ast :symtab :ctx :n :ind :buf
    }
}

# emitDoBindValue -- `x: { ... }` (a do block): declare the local and emit the
# block. A do block whose own body breaks yields an optionval (default `none`,
# `some(last)` on normal completion, in a do/while(0) so a break exits to none);
# a breakless do block is a plain scoped block assigning the last value.
emitDoBindValue: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    n: Node.view
    nm: StringView
    nmVid: ztypes.vid
    ct: StringView
    tid: ztypes.tid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    match (
        n
    ) case expression then {
        iexK9: ast.nodes.get i: n.expression.u64
        return (emitDoBindValue :ast :symtab :ctx n: iexK9 :nm :nmVid :ct :tid :ind :tmp :buf)
    } case doexpr then {
        ld: "\{ind}\{ct} \{nm};\n"
        buf.append ld
        if (ztypecheck.blockHasBreak :ast n: (ast.nodes.get i: n.statement.u64)) then {
            noneTag: variantTag :symtab :tid arm: "none"
            someTag: variantTag :symtab :tid arm: "some"
            # a reftype value wraps in Option: the payload lives in a
            # malloc'd box, none carries NULL data, and the local owns the
            # box (scope-exit destroy).
            boxedC9: String
            if (originIsTid :symtab :tid originTid: ctx.optionOriginTid) then {
                boxedC9 = armPayloadC :ast :symtab :ctx :tid arm: "some"
            }
            l0: "\{ind}\{nm}.tag = \{noneTag};\n"
            buf.append l0
            if boxedC9.length > 0 then {
                l0b: "\{ind}\{nm}.data = NULL;\n"
                buf.append l0b
                dcb9: ctxCname :ctx :tid
                ldf9: "    \{dcb9}_destroy(&\{nm});\n"
                ldfs9: ldf9.copy
                tmp.listFrees.append ldfs9
                tmp.listFreeVars.append nm.string
                tmp.listFreeRaw.append nmVid
            }
            l1: "\{ind}do {\n"
            buf.append l1
            ind2: "\{ind}    "
            # the block is its own break target: a break inside frees the
            # block's owned temps (since these marks) and lands after the
            # block, not on an enclosing loop's label
            doId9: pushLoopLabel :ctx :tmp isDo: true
            fLd9: tmp.frees.length
            lLd9: tmp.listFrees.length
            (emitBranchAssignOptional
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: n.statement.u64)
                target: nm
                someTag: someTag.stringview
                payC: boxedC9.stringview
                ind: ind2.stringview
                :tmp
                :buf
            )
            dvO9: blockDiverges :ast :symtab :ctx n: (ast.nodes.get i: n.statement.u64)
            flushBlockFrees :ctx :tmp fL: fLd9 lL: lLd9 diverged: dvO9 :buf
            l2: "\{ind}} while (0);\n"
            buf.append l2
            popLoopLabel :ctx id: doId9 :ind :buf
        } else {
            # an owned destructible block value is destroyed at scope exit
            # (the binding path returns before its own registration).
            if (symtab.reg.hasDestructorName typeId: tid) then {
                pdcb9: ctxCname :ctx :tid
                pldf9: "    \{pdcb9}_destroy(&\{nm});\n"
                pldfs9: pldf9.copy
                tmp.listFrees.append pldfs9
                tmp.listFreeVars.append nm.string
                tmp.listFreeRaw.append nmVid
            }
            l3: "\{ind}{\n"
            buf.append l3
            ind3: "\{ind}    "
            fLe9: tmp.frees.length
            lLe9: tmp.listFrees.length
            (emitBranchAssign
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: n.statement.u64)
                target: nm
                ind: ind3.stringview
                :tmp
                :buf
            )
            flushBlockFrees :ctx :tmp fL: fLe9 lL: lLe9 diverged: false :buf
            l4: "\{ind}}\n"
            buf.append l4
        }
        return true
    } else {
        return false
    }
}

# emitMatchBindValue -- `x: (match c case ok then 1 ...)`: declare the
# local and assign per arm; false when the value is not a match.
emitMatchBindValue: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    nm: StringView
    ct: StringView
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} out bool is {
    match (
        n
    ) case expression then {
        iexJ9: ast.nodes.get i: n.expression.u64
        return (emitMatchBindValue :ast :symtab :ctx n: iexJ9 :nm :ct :ind :tmp :buf)
    } case caseexpr then {
        ld: "\{ind}\{ct} \{nm};\n"
        buf.append ld
        emitMatchStmt :ast :symtab :ctx m: n assignTo: nm :ind :tmp :buf
        return true
    } else {
        return false
    }
}

# simpleValueNode9 -- the node is a value expression, not a multi-statement
# block. A folded if-bind can only shortcut to emitExpr when its live branch is
# one; a block branch stays on the clause path, which knows how to assign from
# a body.
simpleValueNode9: function {ast: Ast.view n: Node.view} out bool is {
    ast
    match (
        n
    ) case statement then {
        # emitExpr copes with a one-statement block; a longer body needs the
        # clause path, which assigns from a walked body
        return n.statements.length <= 1
    } else {
        return true
    }
}

# emitIfBindValue -- `s: if c then a else b`: declare the local and emit
# an if-statement assigning the branch value to it; false otherwise.
emitIfBindValue: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    nm: StringView
    ct: StringView
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} out bool is {
    match (
        n
    ) case expression then {
        iexI9: ast.nodes.get i: n.expression.u64
        return (emitIfBindValue :ast :symtab :ctx n: iexI9 :nm :ct :ind :tmp :buf)
    } case ifexpr then {
        # every condition folds: declare the local and assign the one live
        # branch, rather than emitting a runtime if whose other arms are dead
        bfb9: foldedBranchOf9 :symtab nid: n.nodeid.u64
        if bfb9.known then {
            bwb9: bfb9.stmt
            if (bwb9.isZero) == false then {
                bwn9: ast.nodes.get i: bwb9.u64
                if (simpleValueNode9 :ast n: bwn9) then {
                    bvx9: emitExpr :ast :symtab :ctx n: bwn9
                    lbf9: "\{ind}\{ct} \{nm} = \{bvx9};\n"
                    buf.append lbf9
                    return true
                }
                # a multi-statement live branch: declare, then run the body
                # through the same assign helper the clause path uses, inside a
                # bare block rather than under a runtime `if`
                lbd9: "\{ind}\{ct} \{nm};\n"
                buf.append lbd9
                lbo9: "\{ind}{\n"
                buf.append lbo9
                indB9: "\{ind}    "
                (emitBranchAssign
                    :ast
                    :symtab
                    :ctx
                    n: bwn9
                    target: nm
                    ind: indB9.stringview
                    :tmp
                    :buf
                )
                lbc9: "\{ind}}\n"
                buf.append lbc9
                return true
            }
        }
        ld: "\{ind}\{ct} \{nm};\n"
        buf.append ld
        first: true
        with citer: n.clauses.iterate do for cId9: citer loop {
            isFirst: first
            first = false
            (emitIfClause
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: cId9.u64)
                :isFirst
                assignTo: nm
                :ind
                :tmp
                :buf
            )
        }
        chS9: (List String)
        chV9: (ListVal ztypes.vid)
        chA9: (List String)
        chT9: (ListVal u64)
        chN9: (ListVal bool)
        chR9: (List String)
        (chainFactsOfClauses9
            :ast
            :symtab
            :ctx
            clauses: n.clauses
            subjects: chS9
            svids: chV9
            arms: chA9
            tids: chT9
            negs: chN9
            recvs: chR9
        )
        (emitElse9
            :ast
            :symtab
            :ctx
            oId: n.elseclause
            assignTo: nm
            :ind
            :tmp
            chSubjects: chS9
            chSubjectVids: chV9
            chArms: chA9
            chTids: chT9
            chNegs: chN9
            chRecvs: chR9
            :buf
        )
        le: "\{ind}}\n"
        buf.append le
        return true
    } else {
        return false
    }
}

# emitObjIterFor -- `for x: <iter> loop` where <iter> is an iterator value
# (a type with a `.call` child returning optionval/Option). Emits the
# while(1) / call / tag==NONE break / payload-extract pattern. Value
# payloads (optionval) extract `.data.some`; reftype payloads (Option)
# wait on the heap-extract slice. Returns false when not an iterator loop.
# iterableNodeId -- the stamped node id of a for-loop iterable: peel expression
# wrappers, then take the inner atom / dotted-field / call node (the expression
# wrapper itself may be unstamped for a `this._iterN` field iterator).
iterableNodeId: function {ast: Ast.view n: Node.view} out u64 is {
    match (
        n
    ) case expression then {
        return (iterableNodeId :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return n.nodeid.u64
    } case dottedpath then {
        return n.nodeid.u64
    } case call then {
        return n.nodeid.u64
    } else {
        return 0
    }
}

# isForIterCall -- the for-loop iterable is a call expression (an rvalue that
# must be hoisted to a temp before `&recv`); a bare atom / dotted field is an
# lvalue used directly.
isForIterCall: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (isForIterCall :ast n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        return true
    } case dottedpath then {
        cn: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if cn.stringview == "iterateMut" then return true
        return cn.stringview == "iterate"
    } else {
        return false
    }
}

# emit a for-loop over an object iterator.
emitObjIterFor: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    m: zast.ForData.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    if m.conditions.length != 1 then return false
    c0Id9: m.conditions.get i: 0
    c0: ast.nodes.get i: c0Id9.u64
    match (
        c0
    ) case namedoperation then {
        lblR9: zast.nameTextAt :ast ref: c0.name
        if lblR9.length == 0 then return false
        lblV9: defVid :symtab nid: (nodeIdOf9 n: (ast.nodes.get i: c0.operation.u64))
        lbl: varCName :ctx vid: lblV9 name: lblR9.stringview
        oeid: iterableNodeId :ast n: (ast.nodes.get i: c0.operation.u64)
        itid0: stampIdOf :symtab nid: oeid
        if itid0.isZero then {
            oeidF: exprNodeId9 n: (ast.nodes.get i: c0.operation.u64)
            itid0 = stampIdOf :symtab nid: oeidF
        }
        itid: itid0
        # bare generator-fn iterable (`for x: counter loop`): itid0 is the
        # generator function itself; resolve via its return type (the iterator
        # class) and auto-call it below.
        bareFnId9: ztypes.tid
        if (symtab.reg.typetypeOf typeId: itid0) == ztypes.ztypetype.functionType then {
            brt9: u64
            brt9 = fnReturnTidOf :symtab tid: itid0
            if brt9 == 0 then {
                mro9: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: itid0.u64)
                match (
                    mro9
                ) case some then {
                    brt9 = mro9
                } case none then null
            }
            hasCall9: (symtab.typing.declHasMemberId
                parentTypeId: (ztypes.tid.create from: brt9.u64)
                nameId: zast.wkCall
            )
            if brt9 > 0 when hasCall9 then {
                itid = ztypes.tid.create from: (brt9)
                bareFnId9 = itid0
            }
        }
        if itid.isZero then return false
        if bareFnId9.isZero then {
            canoT9: u64
            if (originTidOf :symtab tid: itid0) > 0 then {
                canoT9 = itid0
            } else {
                itn0: typeNameOfReg9 :symtab tid: itid0
                cano: (ztypecheck.walkLookupTyperef
                    :ast
                    ty: symtab.typing
                    reg: symtab.reg
                    unitDecl: (ztypecheck.unitDeclOfName
                        ty: symtab.typing
                        :ast
                        name: ctx.mainName.stringview
                    )
                    base: itn0.stringview
                )
                match (
                    cano
                ) case some then {
                    canoT9 = cano
                } case none then null
            }
            hasCallC9: (symtab.typing.declHasMemberId
                parentTypeId: (ztypes.tid.create from: canoT9.u64)
                nameId: zast.wkCall
            )
            if canoT9 > 0 when hasCallC9 then itid = ztypes.tid.create from: canoT9.u64
        }
        cco: symtab.typing.declChildOfId parentTypeId: itid nameId: zast.wkCall
        match (
            cco
        ) case some then {
            ovid: ztypes.tid
            {
                rto: symtab.reg.returnTypeOf tid: (ztypes.tid.create from: cco.u64)
                if rto > 0 then ovid = rto
            }
            if ovid.isZero then {
                # user-class iterator: returnTypeId unset, but the .call return
                # node carries the mono stamp.
                mro: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: cco.u64)
                match (
                    mro
                ) case some then {
                    ovid = mro
                } case none then null
            }
            # neither the registered return nor the .call stamp names a yield
            # type: there is no iterator to emit against.
            if ovid.isZero then return false
            itn: typeNameOfReg9 :symtab tid: itid
            # a main-unit user-class iterator's .call is emitted by emitOneMethod
            # (its own cname id); native/collection iterators (CpIter, SetIter,
            # emitted with the type-id cname) keep the template's `{type}_call`.
            callC: String
            itUfn9: canonFnId :ast :symtab :ctx tid: itid name: itn.stringview
            isUserCls9: false
            if itUfn9 > 0 when (symtab.reg.typetypeOf typeId: itid) == ztypes.ztypetype.classType then {
                # exclude collection monos (SetIter etc., which have a generic origin)
                itorig9: originTidOf :symtab tid: itid
                if itorig9.isZero then isUserCls9 = true
            }
            if isUserCls9 then {
                callC = ctxCname :ctx tid: (ztypes.tid.create from: cco.u64)
            } else {
                itc9: ctxCname :ctx tid: itid
                callC = "\{itc9}_call"
            }
            ovn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: ovid.u64)
            ovc: ctxCname :ctx tid: (ztypes.tid.create from: ovid.u64)
            ovu: cUpperOf text: ovn.stringview
            payC: armPayloadC :ast :symtab :ctx tid: (ztypes.tid.create from: ovid.u64) arm: "some"
            oovorig: monoOriginName :symtab tid: (ztypes.tid.create from: ovid.u64)
            mN: tmp.next
            itCb9: ctxCname :ctx tid: itid
            iterRecv9: String
            ownGit9: false
            if bareFnId9 > 0 then {
                bcn9: ctxCname :ctx tid: (ztypes.tid.create from: bareFnId9.u64)
                lgh9: "\{ind}\{itCb9}_t _git\{mN} = \{bcn9}();\n"
                buf.append lgh9
                iterRecv9 = "_git\{mN}"
                ownGit9 = true
            } else {
                ivex9: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: c0.operation.u64)
                if (isForIterCall :ast n: (ast.nodes.get i: c0.operation.u64)) then {
                    lgi9: "\{ind}\{itCb9}_t _git\{mN} = \{ivex9};\n"
                    buf.append lgi9
                    iterRecv9 = "_git\{mN}"
                    ownGit9 = true
                } else {
                    iterRecv9 = ivex9
                }
            }
            # the loop owns the iterator instance: register its destroy for the
            # enclosing block's flush (and the return path), freeing owned
            # captured params. Registered BEFORE the loop label so break /
            # continue inside the loop never free the live instance.
            if ownGit9 then {
                if (symtab.reg.hasDestructorName typeId: itid) when (structDestroyNontrivial
                    :ast
                    :symtab
                    :ctx
                    tid: itid
                ) then {
                    gdt9: "    \{itCb9}_destroy(&_git\{mN});\n"
                    tmp.listFrees.append gdt9
                    gdn9: "_git\{mN}"
                    tmp.listFreeVars.append gdn9
                    tmp.listFreeRaw.append (ztypes.vid.create from: 0)
                }
            }
            lidO: pushLoopLabel :ctx :tmp isDo: false
            # owned payloads register a per-iteration cleanup line with the
            # loop entry: continue/break/return jump past the fall-through
            # dtor line below, so the jump sites emit this copy instead.
            payCleanup9: String
            if (originIsTid
                :symtab
                tid: (ztypes.tid.create from: ovid.u64)
                originTid: ctx.optionOriginTid
            ) then {
                pfree9: (payloadDestructor
                    :ast
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: ovid.u64)
                    arm: "some"
                )
                if pfree9.length > 0 then payCleanup9 = "\{pfree9}(&\{lbl});\n"
            }
            if payCleanup9.length > 0 then {
                ctx.breakLabelCleanup.pop
                pcl9: payCleanup9.copy
                ctx.breakLabelCleanup.append pcl9
                ctx.breakLabelCleanupVar.pop
                ctx.breakLabelCleanupRaw.pop
                pcv9: lbl.copy
                ctx.breakLabelCleanupVar.append pcv9
                ctx.breakLabelCleanupRaw.append lblV9
            }
            l0: "\{ind}while (1) {\n"
            buf.append l0
            l1: "\{ind}    \{ovc}_t _iter\{mN} = \{callC}(&\{iterRecv9});\n"
            buf.append l1
            if (originIsTid
                :symtab
                tid: (ztypes.tid.create from: ovid.u64)
                originTid: ctx.optionOriginTid
            ) then {
                # owned heap-payload union: destroy the box on the NONE arm too.
                l2o: "\{ind}    if (_iter\{mN}.tag == Z_\{ovu}_TAG_NONE) { \{ovc}_destroy(&_iter\{mN}); break; }\n"
                buf.append l2o
            } else {
                l2: "\{ind}    if (_iter\{mN}.tag == Z_\{ovu}_TAG_NONE) break;\n"
                buf.append l2
            }
            if (originIsTid
                :symtab
                tid: (ztypes.tid.create from: ovid.u64)
                originTid: ctx.optionViewOriginTid
            ) then {
                # borrowed-view yield: scalar payloads copy by value; aggregate
                # payloads bind a borrowed pointer (no copy -> the shared fields
                # are never double-freed).
                payElemPfx: oovorig.length + 1
                payElemName: monoElemName full: ovn prefixLen: payElemPfx
                payElemTid9: optU64Or9 o: (symtab.typing.declChildOfId
                    parentTypeId: ovid
                    nameId: zast.wkSome
                )
                payScalarC: (cTypeForNameTid
                    :ast
                    :symtab
                    :ctx
                    name: payElemName.stringview
                    tid: (ztypes.tid.create from: payElemTid9.u64)
                )
                # A REFTYPE payload must alias. Copying its struct duplicates
                # a pointer the container still owns, so a write through the
                # copy reallocs and frees under the container -- silently for a
                # valtype field, as a use-after-free for a reftype one. A
                # valtype or scalar payload is self-contained and copies safely.
                payRef9: false
                if payElemTid9 > 0 then payRef9 = symtab.reg.isReftypeOf tid: (ztypes.tid.create from: payElemTid9.u64)
                if payScalarC.length > 0 when (payRef9) == false then {
                    l3v: "\{ind}    \{payC} \{lbl} = *(\{payC}*)_iter\{mN}.data;\n"
                    buf.append l3v
                } else {
                    l3p: "\{ind}    \{payC}* __borrow_\{lbl} = (\{payC}*)_iter\{mN}.data;\n"
                    buf.append l3p
                    l3pa: "\{ind}    /* alias: \{lbl} => (*__borrow_\{lbl}) */\n"
                    buf.append l3pa
                    av3p: "(*__borrow_\{lbl})"
                    vvSet xs: ctx.aliases vid: lblV9 val: av3p.stringview
                }
            } else if (originIsTid
                :symtab
                tid: (ztypes.tid.create from: ovid.u64)
                originTid: ctx.optionOriginTid
            ) then {
                # owned heap yield: move the payload out, free just the box; the
                # loop var owns it and is freed at the end of each iteration.
                l3op: "\{ind}    \{payC} \{lbl} = *(\{payC}*)_iter\{mN}.data;\n"
                buf.append l3op
                l3of: "\{ind}    free(_iter\{mN}.data);\n"
                buf.append l3of
            } else {
                l3: "\{ind}    \{payC} \{lbl} = _iter\{mN}.data.some;\n"
                buf.append l3
            }
            ind2: "\{ind}    "
            fLO9: tmp.frees.length
            lLO9: tmp.listFrees.length
            dvG9: false
            if m.body > 0 then {
                mb9: ast.nodes.get i: m.body.u64
                emitBodyNode :ast :symtab :ctx n: mb9 ind: ind2.stringview :tmp :buf
                dvG9 = blockDiverges :ast :symtab :ctx n: mb9
            }
            if payCleanup9.length > 0 then {
                l3od: "\{ind}    \{payCleanup9}"
                buf.append l3od
            }
            flushBlockFrees :ctx :tmp fL: fLO9 lL: lLO9 diverged: dvG9 :buf
            indO9: "\{ind}    "
            emitContLabel :ctx id: lidO ind: indO9.stringview :buf
            l9: "\{ind}}\n"
            buf.append l9
            popLoopLabel :ctx id: lidO :ind :buf
            return true
        } case none then {
            return false
        }
    } else {
        return false
    }
}

# emitIntRangeFor -- `for x: N.iterate loop` / `for x: (N.iterate from: F)`:
# a counted C for-loop `for (T x = F; x < N; x++)`. Returns false when the
# header is not a single integer-range binding.
emitIntRangeFor: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    m: zast.ForData.view
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} out bool is {
    if m.conditions.length != 1 then return false
    c0Id9: m.conditions.get i: 0
    c0: ast.nodes.get i: c0Id9.u64
    match (
        c0
    ) case namedoperation then {
        lblR8: zast.nameTextAt :ast ref: c0.name
        if lblR8.length == 0 then return false
        lblV8: defVid :symtab nid: (nodeIdOf9 n: (ast.nodes.get i: c0.operation.u64))
        lbl: varCName :ctx vid: lblV8 name: lblR8.stringview
        bound: rangeBoundExpr :ast :symtab :ctx n: (ast.nodes.get i: c0.operation.u64)
        if bound.length == 0 then return false
        fromx: rangeFromExpr :ast :symtab :ctx n: (ast.nodes.get i: c0.operation.u64)
        lidR: pushLoopLabel :ctx :tmp isDo: false
        lh: "\{ind}for (int64_t \{lbl} = \{fromx}; \{lbl} < (int64_t)(\{bound}); \{lbl}++) {\n"
        buf.append lh
        ind2: "\{ind}    "
        if m.body > 0 then {
            mb29: ast.nodes.get i: m.body.u64
            emitBodyNode :ast :symtab :ctx n: mb29 ind: ind2.stringview :tmp :buf
        }
        emitContLabel :ctx id: lidR ind: ind2.stringview :buf
        lc: "\{ind}}\n"
        buf.append lc
        popLoopLabel :ctx id: lidR :ind :buf
        return true
    } else {
        return false
    }
}

# rangeBoundExpr -- the upper bound of an `N.iterate` range (the dotted
# receiver N); "" when the operation is not an iterate call.
rangeBoundExpr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
} out String is {
    match (
        n
    ) case expression then {
        return (rangeBoundExpr :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        mn: dottedChildText :ast n: (ast.nodes.get i: n.callable.u64)
        xq139: ast.nodes.get i: n.callable.u64
        if mn.stringview == "iterate" then return (rangeReceiver :ast :symtab :ctx n: xq139)
        return "".string
    } case dottedpath then {
        cmn: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if cmn.stringview == "iterate" then {
            # the receiver may be a dotted-path itself (squares.length.iterate)
            # -- stampNameDeep resolves its scalar type either way.
            btn: stampNameDeep :ast :symtab n: (ast.nodes.get i: n.parent.u64)
            cTypeLk1: cTypeOf name: btn.stringview
            if cTypeLk1.length > 0 then {
                return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
            }
        }
        return "".string
    } else {
        return "".string
    }
}

# rangeReceiver -- the C expression for the receiver of a `.iterate`
# dotted callable.
rangeReceiver: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
} out String is {
    match (
        n
    ) case dottedpath then {
        return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# rangeFromExpr -- the `from:` argument of an iterate range, or "0".
rangeFromExpr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
} out String is {
    match (
        n
    ) case expression then {
        return (rangeFromExpr :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        aiter: n.arguments.iterate
        for aId9: aiter loop {
            a: ast.nodes.get i: aId9.u64
            match (
                a
            ) case namedoperation then {
                an: zast.nameTextAt :ast ref: a.name
                if an.stringview == "from" then return (emitExpr
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                )
            } else null
        }
        return "0".string
    } else {
        return "0".string
    }
}

# emitForCond -- one for-header arm: a `while:` arm joins the loop
# condition; a named binding arm emits its init before the loop.
emitForCond: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    cond: String.borrow
    ind: StringView
    buf: String.borrow
} is {
    match (
        n
    ) case namedoperation then {
        lblR7: zast.nameTextAt :ast ref: n.name
        lblV7: defVid :symtab nid: (nodeIdOf9 n: (ast.nodes.get i: n.operation.u64))
        lbl: varCName :ctx vid: lblV7 name: lblR7.stringview
        if lblR7.length == 0 then {
            cv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.operation.u64)
            tw7: (truthyCondText9
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: n.operation.u64)
                raw: cv.stringview
            )
            if cond.length > 0 then cond.append " && "
            if tw7.length > 0 then {
                cond.append tw7
            } else {
                cond.append cv
            }
        } else {
            onid: exprNodeId9 n: (ast.nodes.get i: n.operation.u64)
            tn: stampNameOf :symtab nid: onid
            ftid9: stampIdOf :symtab nid: onid
            ct: scalarCTypeFor :symtab name: tn.stringview tid: ftid9
            iv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.operation.u64)
            if ct.length > 0 then {
                li: "\{ind}\{ct} \{lbl} = \{iv};\n"
                buf.append li
            } else {
                li2: "\{ind}int64_t \{lbl} = \{iv};\n"
                buf.append li2
            }
        }
    } else null
}

# the node id of expression `n`.
exprNodeId9: function {n: Node.view} out u64 is {
    match (
        n
    ) case expression then {
        return n.nodeid.u64
    } case atomid then {
        return n.nodeid.u64
    } else {
        return 0
    }
}

# sumArmNames9 -- the arm names of a sum type, in declaration order (the
# checker's exclusion universe).
sumArmNames9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    tid: ztypes.tid
    names: (List String).view
} is {
    zenv.sumArmNames ty: symtab.typing reg: symtab.reg pool: ast.names :tid :names
}

# armAliasText9 -- the C lvalue for `recv`'s payload of `arm` on sum type
# `tid`: the inline union member for variants, the heap cast for unions.
# "" when the arm carries no payload.
armAliasText9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    tid: ztypes.tid
    arm: StringView
    recv: StringView
    acc: StringView
} out String is {
    pc9: armPayloadC :ast :symtab :ctx :tid :arm
    if pc9.length == 0 then return "".string
    if (symtab.reg.typetypeOf typeId: tid) == ztypes.ztypetype.unionType then {
        return "(*(\{pc9}*)\{recv}\{acc}data)"
    }
    return "\{recv}\{acc}data.\{arm}"
}

# remainingArm9 -- the single arm of `tid` left after removing the
# ambient exclusions recorded for variable `subjVid` (ctx.exclArms) plus the
# `extra` space-joined arms; "" when zero or more than one remain.
remainingArm9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    subjVid: ztypes.vid
    tid: ztypes.tid
    extra: StringView
} out String is {
    exv9: vvGet xs: ctx.exclArms vid: subjVid
    all9: (List String)
    sumArmNames9 :ast :symtab :tid names: all9
    remN9: u64
    rem9: String
    with ait9: all9.iterate do for a9: ait9 loop {
        hit9: false
        if exv9.length > 0 then {
            if (svHasWord9 hay: exv9.stringview word: a9.stringview) then hit9 = true
        }
        if (hit9) == false when extra.length > 0 then {
            if (svHasWord9 hay: extra word: a9.stringview) then hit9 = true
        }
        if (hit9) == false then {
            remN9 = remN9 + 1
            rv9: a9.copy
            rem9 = rv9
        }
    }
    if remN9 != 1 then return "".string
    return rem9
}

# svHasWord9 -- space-delimited word membership.
svHasWord9: function {hay: StringView word: StringView} out bool is {
    with wit9: (hay.split sep: " ") do for w9: wit9 loop {
        if w9 == word then return true
    }
    return false
}

# bodyReassigns9 -- true when the body (at any depth through the common
# statement containers) reassigns `name`, which would stale a narrowBox
# alias for it.
bodyReassigns9: function {ast: Ast.view n: Node.view name: StringView} out bool is {
    match (
        n
    ) case statement then {
        hit9: false
        with sit9: n.statements.iterate do for s9Id9: sit9 loop {
            if (bodyReassigns9 :ast n: (ast.nodes.get i: s9Id9.u64) :name) then hit9 = true
        }
        return hit9
    } case statementline then {
        sln9: ast.nodes.get i: n.statementline.u64
        return (bodyReassigns9 :ast n: sln9 :name)
    } case expression then {
        return (bodyReassigns9 :ast n: (ast.nodes.get i: n.expression.u64) :name)
    } case reassignment then {
        tpn9: ast.nodes.get i: n.topath.u64
        rb9: atomTextOf :ast n: tpn9
        if rb9.length == 0 then rb9 = dottedBaseAtom :ast n: tpn9
        return rb9.stringview == name
    } case ifexpr then {
        hif9: false
        with cit9: n.clauses.iterate do for c9: cit9 loop {
            if (bodyReassigns9 :ast n: (ast.nodes.get i: c9.u64) :name) then hif9 = true
        }
        if hif9 then return true
        if n.elseclause.isZero then return false
        return (bodyReassigns9 :ast n: (ast.nodes.get i: n.elseclause.u64) :name)
    } case ifclause then {
        return (bodyReassigns9 :ast n: (ast.nodes.get i: n.statement.u64) :name)
    } case caseexpr then {
        hce9: false
        with kit9: n.clauses.iterate do for k9: kit9 loop {
            if (bodyReassigns9 :ast n: (ast.nodes.get i: k9.u64) :name) then hce9 = true
        }
        if hce9 then return true
        if n.elseclause.isZero then return false
        return (bodyReassigns9 :ast n: (ast.nodes.get i: n.elseclause.u64) :name)
    } case caseclause then {
        return (bodyReassigns9 :ast n: (ast.nodes.get i: n.statement.u64) :name)
    } case forexpr then {
        if n.body.isZero then return false
        return (bodyReassigns9 :ast n: (ast.nodes.get i: n.body.u64) :name)
    } case doexpr then {
        return (bodyReassigns9 :ast n: (ast.nodes.get i: n.statement.u64) :name)
    } case withexpr then {
        return (bodyReassigns9 :ast n: (ast.nodes.get i: n.body.u64) :name)
    } else {
        return false
    }
}

# seedFromPred9 -- one POSITIVE bare arm predicate dotted node: admit a
# non-bool receiver variable whose arm carries a payload and whose
# subject the body does not reassign; append its narrowBox seed
# (subject, alias text, payload tid). The condition-form dispatch
# (trailing .true/.false, == true/false) lives in seedCondOp9.
seedFromPred9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    body: Node.view
    names: (List String).view
    svids: (ListVal ztypes.vid).view
    vals: (List String).view
    tids: (ListVal u64).view
} is {
    match (
        n
    ) case expression then {
        iexA9: ast.nodes.get i: n.expression.u64
        seedFromPred9 :ast :symtab :ctx n: iexA9 :body :names :svids :vals :tids
    } case dottedpath then {
        arm0: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        (seedPosCore9
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: (dpArmPredicateOf9 :symtab nid: n.nodeid.u64))
            parent: (ast.nodes.get i: n.parent.u64)
            childName: arm0.stringview
            :body
            :names
            :svids
            :vals
            :tids
        )
    } else null
}

# seedPosCore9 -- the positive-seed core: the subject named by `parent` is
# known to hold `childName` of `tid`.
seedPosCore9: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    tid: ztypes.tid
    parent: Node.view
    childName: StringView
    body: Node.view
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    tids: ListVal u64
} is {
    if tid.isZero then return
    if (isOrdinalVariant :symtab :tid) then return
    subj9: atomTextOf :ast n: parent
    if subj9.length == 0 then return
    if (bodyReassigns9 :ast n: body name: subj9.stringview) then return
    recv9: emitExpr :ast :symtab :ctx n: parent
    acc9: ".".string
    if (isPtrVid :ctx vid: (atomVid :symtab nid: (atomNodeId9 n: parent))) then acc9 = "->".string
    alias9: (armAliasText9
        :ast
        :symtab
        :ctx
        :tid
        arm: childName
        recv: recv9.stringview
        acc: acc9.stringview
    )
    if alias9.length == 0 then return
    names.append subj9
    svids.append (atomVid :symtab nid: (atomNodeId9 n: parent))
    vals.append alias9
    pt9: optU64Or9 o: (symtab.typing.declChildOf
        pool: ast.names
        parentTypeId: tid
        name: childName
    )
    tids.append pt9
}

# seedNegFromPred9 -- a NEGATED bare arm predicate: the branch knows the
# subject does NOT hold `arm`. When exactly one payload arm remains, seed
# its alias (exclusion collapse, mirroring the checker).
seedNegFromPred9: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    n: Node.view
    body: Node.view
    names: List String
    svids: ListVal ztypes.vid
    vals: List String
    tids: ListVal u64
} is {
    match (
        n
    ) case expression then {
        iexB9: ast.nodes.get i: n.expression.u64
        seedNegFromPred9 :ast :symtab :ctx n: iexB9 :body :names :svids :vals :tids
    } case dottedpath then {
        dap9: dpArmPredicateOf9 :symtab nid: n.nodeid.u64
        if dap9 == 0 then return
        if (isOrdinalVariant :symtab tid: (ztypes.tid.create from: dap9.u64)) then return
        subj9: atomTextOf :ast n: (ast.nodes.get i: n.parent.u64)
        if subj9.length == 0 then return
        snv9: atomVid :symtab nid: (atomNodeId9 n: (ast.nodes.get i: n.parent.u64))
        arm9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        rem9: (remainingArm9
            :ast
            :symtab
            :ctx
            subjVid: snv9
            tid: (ztypes.tid.create from: dap9.u64)
            extra: arm9.stringview
        )
        if rem9.length == 0 then return
        if (bodyReassigns9 :ast n: body name: subj9.stringview) then return
        recv9: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
        acc9: ".".string
        if (isPtrVid :ctx vid: snv9) then acc9 = "->".string
        alias9: (armAliasText9
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: dap9.u64)
            arm: rem9.stringview
            recv: recv9.stringview
            acc: acc9.stringview
        )
        if alias9.length == 0 then return
        names.append subj9
        svids.append snv9
        vals.append alias9
        pt9: optU64Or9 o: (symtab.typing.declChildOf
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: dap9.u64)
            name: rem9.stringview
        )
        tids.append pt9
    } else null
}

# seedCondOp9 -- one if-condition operation, dispatched by form: bare
# `x.a` (positive), `x.a.true` (positive inner), `x.a.false` (negated
# inner), and the `(x.a) == true/false` comparisons.
# bareAtomNameId9 -- the interned name id of an expression-unwrapped bare atom,
# 0 for any other shape. The id twin of bareAtomText9.
bareAtomNameId9: function {ast: Ast.view n: Node.view} out zast.nameid is {
    match (
        n
    ) case expression then {
        return (bareAtomNameId9 :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return n.name
    } else {
        return (zast.nameid.create from: 0)
    }
}

# armSideAtNode9 -- which arm of ITS OWN stamped type the name `nameId` is, for
# the value at node `nid`. `true` and `false` are arms of bool, so a `== true`
# operand answers `truthy` and a `== false` one `falsy` -- from bool's arm
# ORDER, which is the whole content of the spelling test. Asking the node's own
# stamp rather than looking `bool` up by name costs nothing and is exact under
# a user type that shadows bool.
armSideAtNode9: function {
    symtab: zenv.ZSymbolTable.view
    nid: u64
    nameId: zast.nameid
} out ztyping.armside is {
    if nameId.isZero then return ztyping.armside.none
    st9: ztyping.nodeTypeAt tbl: symtab.typing.nodeType :nid
    return (ztyping.armSideOfName ty: symtab.typing typeId: st9.u64 nameId: nameId.u64)
}

# boolArmSideOf9 -- armSideAtNode9 for a bare atom operand, through any
# expression wrapper.
boolArmSideOf9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: Node.view
} out ztyping.armside is {
    match (
        n
    ) case expression then {
        return (boolArmSideOf9 :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return (armSideAtNode9 :symtab nid: n.nodeid.u64 nameId: n.name)
    } else {
        return ztyping.armside.none
    }
}

# truthyCondArmOf9 -- the arm a bare 2-arm-sum condition at `nid` holds, 0 when
# the node is not one.
truthyCondArmOf9: function {symtab: zenv.ZSymbolTable.view nid: u64} out u64 is {
    o9: symtab.typing.truthyCondArm.get key: nid
    match (
        o9
    ) case some then {
        return o9
    } case none then {
        return 0
    }
}

# truthyCondText9 -- the C for a condition whose type is a 2-arm sum rather
# than a bool: it holds when the value holds the arm the checker stamped. ""
# when the condition needs no wrapping at all -- a bool, and every other
# ordinal PAIR, already IS its discriminator in C, so the emitted expression is
# the answer.
#
# The arm comes off the stamp rather than a lookup here: a generic mono keeps
# its arm record on the template it was minted from.
truthyCondText9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    raw: StringView
} out String is {
    fa9: u64
    {
        fo9: symtab.typing.truthyCondArm.get key: (nodeIdOf9 :n)
        match (
            fo9
        ) case some then {
            fa9 = fo9
        } case none then null
    }
    if fa9 == 0 then return "".string
    tid9: ztyping.nodeTypeAt tbl: symtab.typing.nodeType nid: (nodeIdOf9 :n)
    if tid9.isZero then return "".string
    if (isOrdinalPair :symtab tid: tid9) then return "".string
    an9: zast.nameTextCopy :ast ref: (zast.nameid.create from: fa9.u32.orPanic)
    tg9: variantTag :symtab tid: tid9 arm: an9.stringview
    if tg9.length == 0 then return "".string
    acc9: ".".string
    {
        rn9: atomNodeId9 :n
        if rn9 > 0 then {
            if (isPtrVid :ctx vid: (atomVid :symtab nid: rn9)) then acc9 = "->".string
        }
    }
    return "((\{raw})\{acc9}tag == \{tg9})"
}

# armSuffixSide9 -- the `.true` / `.false` suffix on a dotted arm predicate,
# read by arm identity. See ztyping.armSuffixSideOf.
armSuffixSide9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    nid: u64
    parent: Node.view
    child: Node.view
} out ztyping.armside is {
    cid9: atomNameIdOf :ast n: child
    return (ztyping.armSuffixSideOf
        ty: symtab.typing
        :nid
        parentNid: (nodeIdOf9 n: parent)
        childNameId: cid9.u64
    )
}

seedCondOp9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    body: Node.view
    names: (List String).view
    svids: (ListVal ztypes.vid).view
    vals: (List String).view
    tids: (ListVal u64).view
} is {
    # a bare 2-arm sum condition IS `x.<arm>` with the arm left implicit, so
    # it seeds the alias that form seeds.
    {
        ta0: truthyCondArmOf9 :symtab nid: (nodeIdOf9 :n)
        if ta0 > 0 then {
            an0: zast.nameTextCopy :ast ref: (zast.nameid.create from: ta0.u32.orPanic)
            (seedPosCore9
                :ast
                :symtab
                :ctx
                tid: (ztyping.nodeTypeAt tbl: symtab.typing.nodeType nid: (nodeIdOf9 :n))
                parent: n
                childName: an0.stringview
                :body
                :names
                :svids
                :vals
                :tids
            )
            return
        }
    }
    match (
        n
    ) case expression then {
        iexC9: ast.nodes.get i: n.expression.u64
        seedCondOp9 :ast :symtab :ctx n: iexC9 :body :names :svids :vals :tids
    } case dottedpath then {
        cn9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        # `.true` / `.false` on a predicate: which side it is comes from the
        # stamped type's arm ORDER, never from the spelling of the segment.
        sd9: (armSuffixSide9
            :ast
            :symtab
            nid: n.nodeid.u64
            parent: (ast.nodes.get i: n.parent.u64)
            child: (ast.nodes.get i: n.child.u64)
        )
        if sd9.truthy then {
            dpp9: ast.nodes.get i: n.parent.u64
            seedFromPred9 :ast :symtab :ctx n: dpp9 :body :names :svids :vals :tids
            return
        }
        if sd9.falsy then {
            dpq9: ast.nodes.get i: n.parent.u64
            seedNegFromPred9 :ast :symtab :ctx n: dpq9 :body :names :svids :vals :tids
            return
        }
        (seedPosCore9
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: (dpArmPredicateOf9 :symtab nid: n.nodeid.u64))
            parent: (ast.nodes.get i: n.parent.u64)
            childName: cn9.stringview
            :body
            :names
            :svids
            :vals
            :tids
        )
    } case binop then {
        opn9: bareAtomText9 :ast n: (ast.nodes.get i: n.operator.u64)
        if opn9.stringview == "==" then {
            # `== true` / `== false`: the operand names one of bool's arms,
            # and which side it is comes from bool's arm ORDER.
            lsd9: boolArmSideOf9 :ast :symtab n: (ast.nodes.get i: n.lhs.u64)
            rsd9: boolArmSideOf9 :ast :symtab n: (ast.nodes.get i: n.rhs.u64)
            if rsd9.truthy then {
                bl9: ast.nodes.get i: n.lhs.u64
                seedFromPred9 :ast :symtab :ctx n: bl9 :body :names :svids :vals :tids
                return
            }
            if rsd9.falsy then {
                bl29: ast.nodes.get i: n.lhs.u64
                seedNegFromPred9 :ast :symtab :ctx n: bl29 :body :names :svids :vals :tids
                return
            }
            if lsd9.truthy then {
                br9: ast.nodes.get i: n.rhs.u64
                seedFromPred9 :ast :symtab :ctx n: br9 :body :names :svids :vals :tids
                return
            }
            if lsd9.falsy then {
                br29: ast.nodes.get i: n.rhs.u64
                seedNegFromPred9 :ast :symtab :ctx n: br29 :body :names :svids :vals :tids
            }
        }
    } else null
}

# bareAtomText9 -- the expression-unwrapped bare atom text of a node,
# "" for any other shape.
bareAtomText9: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (bareAtomText9 :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# ifPredSeeds9 -- collect the narrowBox seeds for a clause's bare
# arm-predicate conjuncts, all condition forms (parallel lists).
ifPredSeeds9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    conds: (ListVal u32).view
    bodyId: zast.nodeid
    names: (List String).view
    svids: (ListVal ztypes.vid).view
    vals: (List String).view
    tids: (ListVal u64).view
} is {
    body: ast.nodes.get i: bodyId.u64
    with kit9: conds.iterate do for k9Id9: kit9 loop {
        k9: ast.nodes.get i: k9Id9.u64
        match (
            k9
        ) case namedoperation then {
            (seedCondOp9
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: k9.operation.u64)
                :body
                :names
                :svids
                :vals
                :tids
            )
        } else null
    }
}

# chainFactsOfClauses9 -- the accumulated single-bare-conjunct facts of an
# if chain (subject/arm/tid/negated parallel lists), mirroring the
# checker's accumulation rule exactly.
chainFactsOfClauses9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    clauses: (ListVal u32).view
    subjects: List String
    svids: ListVal ztypes.vid
    arms: List String
    tids: ListVal u64
    negs: ListVal bool
    recvs: List String
} is {
    with cit9: clauses.iterate do for c9Id9: cit9 loop {
        c9: ast.nodes.get i: c9Id9.u64
        match (
            c9
        ) case ifclause then {
            if c9.conditions.length == 1 then {
                tS9: (List String)
                tV9: (ListVal ztypes.vid)
                tA9: (List String)
                tT9: (ListVal u64)
                tN9: (ListVal bool)
                tR9: (List String)
                with kit9: c9.conditions.iterate do for k9Id9: kit9 loop {
                    k9: ast.nodes.get i: k9Id9.u64
                    match (
                        k9
                    ) case namedoperation then {
                        (chainCondFact9
                            :ast
                            :symtab
                            :ctx
                            n: (ast.nodes.get i: k9.operation.u64)
                            subjects: tS9
                            svids: tV9
                            arms: tA9
                            tids: tT9
                            negs: tN9
                            recvs: tR9
                        )
                    } else null
                }
                if tS9.length == 1 then {
                    ms9: tS9.pop
                    subjects.append ms9
                    svids.append (tV9.get i: 0)
                    ma9: tA9.pop
                    arms.append ma9
                    tids.append (tT9.get i: 0)
                    negs.append (tN9.get i: 0)
                    mr9: tR9.pop
                    recvs.append mr9
                }
            }
        } else null
    }
}

# chainCondFact9 -- recognize one condition operation as a bare arm
# predicate for chain accumulation (all four forms).
chainCondFact9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    subjects: (List String).view
    svids: (ListVal ztypes.vid).view
    arms: (List String).view
    tids: (ListVal u64).view
    negs: (ListVal bool).view
    recvs: (List String).view
} is {
    # the bare form again -- same fact, recorded for the else emission
    {
        ta1: truthyCondArmOf9 :symtab nid: (nodeIdOf9 :n)
        if ta1 > 0 then {
            an1: zast.nameTextCopy :ast ref: (zast.nameid.create from: ta1.u32.orPanic)
            (chainFactCore9
                :ast
                :symtab
                :ctx
                owner: (ztyping.nodeTypeAt tbl: symtab.typing.nodeType nid: (nodeIdOf9 :n)).u64
                parent: n
                childName: an1.stringview
                neg: false
                :subjects
                :svids
                :arms
                :tids
                :negs
                :recvs
            )
            return
        }
    }
    match (
        n
    ) case expression then {
        iexD9: ast.nodes.get i: n.expression.u64
        chainCondFact9 :ast :symtab :ctx n: iexD9 :subjects :svids :arms :tids :negs :recvs
    } case dottedpath then {
        cn9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        # `.true` / `.false` on a predicate: which side it is comes from the
        # stamped type's arm ORDER, never from the spelling of the segment.
        sd9: (armSuffixSide9
            :ast
            :symtab
            nid: n.nodeid.u64
            parent: (ast.nodes.get i: n.parent.u64)
            child: (ast.nodes.get i: n.child.u64)
        )
        if sd9.truthy then {
            (chainInnerFact9
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: n.parent.u64)
                neg: false
                :subjects
                :svids
                :arms
                :tids
                :negs
                :recvs
            )
            return
        }
        if sd9.falsy then {
            (chainInnerFact9
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: n.parent.u64)
                neg: true
                :subjects
                :svids
                :arms
                :tids
                :negs
                :recvs
            )
            return
        }
        (chainFactCore9
            :ast
            :symtab
            :ctx
            owner: (dpArmPredicateOf9 :symtab nid: n.nodeid.u64)
            parent: (ast.nodes.get i: n.parent.u64)
            childName: cn9.stringview
            neg: false
            :subjects
            :svids
            :arms
            :tids
            :negs
            :recvs
        )
    } case binop then {
        opn9: bareAtomText9 :ast n: (ast.nodes.get i: n.operator.u64)
        if opn9.stringview == "==" then {
            # `== true` / `== false`: the operand names one of bool's arms,
            # and which side it is comes from bool's arm ORDER.
            lsd9: boolArmSideOf9 :ast :symtab n: (ast.nodes.get i: n.lhs.u64)
            rsd9: boolArmSideOf9 :ast :symtab n: (ast.nodes.get i: n.rhs.u64)
            if rsd9.truthy then {
                (chainInnerFact9
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: n.lhs.u64)
                    neg: false
                    :subjects
                    :svids
                    :arms
                    :tids
                    :negs
                    :recvs
                )
                return
            }
            if rsd9.falsy then {
                (chainInnerFact9
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: n.lhs.u64)
                    neg: true
                    :subjects
                    :svids
                    :arms
                    :tids
                    :negs
                    :recvs
                )
                return
            }
            if lsd9.truthy then {
                (chainInnerFact9
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: n.rhs.u64)
                    neg: false
                    :subjects
                    :svids
                    :arms
                    :tids
                    :negs
                    :recvs
                )
                return
            }
            if lsd9.falsy then {
                (chainInnerFact9
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: n.rhs.u64)
                    neg: true
                    :subjects
                    :svids
                    :arms
                    :tids
                    :negs
                    :recvs
                )
            }
        }
    } else null
}

# chainInnerFact9 -- the stamped bare-predicate core for chain facts.
chainInnerFact9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    neg: bool
    subjects: (List String).view
    svids: (ListVal ztypes.vid).view
    arms: (List String).view
    tids: (ListVal u64).view
    negs: (ListVal bool).view
    recvs: (List String).view
} is {
    match (
        n
    ) case expression then {
        iexE9: ast.nodes.get i: n.expression.u64
        chainInnerFact9 :ast :symtab :ctx n: iexE9 :neg :subjects :svids :arms :tids :negs :recvs
    } case dottedpath then {
        arm0: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        (chainFactCore9
            :ast
            :symtab
            :ctx
            owner: (dpArmPredicateOf9 :symtab nid: n.nodeid.u64)
            parent: (ast.nodes.get i: n.parent.u64)
            childName: arm0.stringview
            :neg
            :subjects
            :svids
            :arms
            :tids
            :negs
            :recvs
        )
    } else null
}

# chainFactCore9 -- the exploded chain-fact core (dotted node fields).
# Captures the emitted receiver text alongside the fact so the else
# emission never re-derives it from the name.
chainFactCore9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    owner: u64
    parent: Node.view
    childName: StringView
    neg: bool
    subjects: List String
    svids: ListVal ztypes.vid
    arms: List String
    tids: ListVal u64
    negs: ListVal bool
    recvs: List String
} is {
    if owner == 0 then return
    if (isOrdinalVariant :symtab tid: (ztypes.tid.create from: owner.u64)) then return
    subj9: atomTextOf :ast n: parent
    if subj9.length == 0 then return
    an9: childName.string
    rv9: emitExpr :ast :symtab :ctx n: parent
    subjects.append subj9
    svids.append (atomVid :symtab nid: (atomNodeId9 n: parent))
    arms.append an9
    tids.append owner
    negs.append neg
    recvs.append rv9
}

# emit one clause of an if-expression.
# condParens9 -- a C `if`/`while` condition, wrapped in parens exactly once.
# An emitted expression is usually already fully parenthesized (`(a == b)`);
# wrapping it again makes clang warn (-Wparentheses-equality). A condition
# containing a string literal keeps the extra wrap rather than depth-counting
# through quoted parens.
condParens9: function {cond: StringView} out String is {
    n9: cond.length
    wrapped9: false
    if n9 >= 2 when (cond.contains "\"") == false then {
        b0: cond.byteAt 0.u64
        match (
            b0
        ) case some then {
            if b0 == 40 then {
                depth9: u64
                i9: u64
                bal9: true
                for i9 < n9 loop {
                    bo9: cond.byteAt i9
                    match (
                        bo9
                    ) case some then {
                        if bo9 == 40 then depth9 = depth9 + 1
                        if bo9 == 41 then {
                            depth9 = depth9 - 1
                            if depth9 == 0 when i9 < (n9 - 1) then bal9 = false
                        }
                    } case none then null
                    i9 = i9 + 1
                }
                if bal9 when depth9 == 0 then wrapped9 = true
            }
        } case none then null
    }
    if wrapped9 then return cond.string
    return "(\{cond})"
}

emitIfClause: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: Node.view
    isFirst: bool
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    match (
        n
    ) case ifclause then {
        cond: String
        with kiter: n.conditions.iterate do for kId9: kiter loop {
            k: ast.nodes.get i: kId9.u64
            match (
                k
            ) case namedoperation then {
                cv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: k.operation.u64)
                tw9: (truthyCondText9
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: k.operation.u64)
                    raw: cv.stringview
                )
                if cond.length > 0 then cond.append " && "
                if tw9.length > 0 then {
                    cond.append tw9
                } else {
                    cond.append cv
                }
            } else null
        }
        if isFirst then {
            flushArgHoists :ctx :ind :tmp :buf
            cw9: condParens9 cond: cond.stringview
            lf: "\{ind}if \{cw9} {\n"
            buf.append lf
        } else {
            cw9x: condParens9 cond: cond.stringview
            lg: "\{ind}} else if \{cw9x} {\n"
            buf.append lg
        }
        ind2: "\{ind}    "
        sN9: (List String)
        sVid9: (ListVal ztypes.vid)
        sV9: (List String)
        sT9: (ListVal u64)
        (ifPredSeeds9
            :ast
            :symtab
            :ctx
            conds: n.conditions
            bodyId: n.statement
            names: sN9
            svids: sVid9
            vals: sV9
            tids: sT9
        )
        sPrevV9: (List String)
        sPrevT9: (ListVal u64)
        si9: u64
        for si9 < sN9.length loop {
            snm9: sN9.get i: si9
            snv0: sVid9.get i: si9
            pv9: vvGet xs: ctx.narrowBox vid: snv0
            sPrevV9.append pv9
            ptv9: optTidOr9 o: (vtGet xs: ctx.narrowTid vid: snv0)
            sPrevT9.append ptv9
            svv9: sV9.get i: si9
            vvSet xs: ctx.narrowBox vid: snv0 val: svv9.stringview
            stt9: sT9.get i: si9
            vtSet xs: ctx.narrowTid vid: snv0 tid: (ztypes.tid.create from: stt9.u64)
            cmtS9: "\{ind}    /* alias: \{snm9} => \{svv9} */\n"
            buf.append cmtS9
            si9 = si9 + 1
        }
        cst9: ast.nodes.get i: n.statement.u64
        if assignTo.length > 0 then {
            (emitBranchAssign
                :ast
                :symtab
                :ctx
                n: cst9
                target: assignTo
                ind: ind2.stringview
                :tmp
                :buf
            )
        } else {
            fLi9: tmp.frees.length
            lLi9: tmp.listFrees.length
            emitBodyNode :ast :symtab :ctx n: cst9 ind: ind2.stringview :tmp :buf
            dvF9: blockDiverges :ast :symtab :ctx n: cst9
            flushBlockFrees :ctx :tmp fL: fLi9 lL: lLi9 diverged: dvF9 :buf
        }
        ri9: u64
        for ri9 < sN9.length loop {
            rnv9: sVid9.get i: ri9
            rv9: sPrevV9.get i: ri9
            if rv9.length > 0 then {
                vvSet xs: ctx.narrowBox vid: rnv9 val: rv9.stringview
            } else {
                vvRemove xs: ctx.narrowBox vid: rnv9
            }
            rt9: sPrevT9.get i: ri9
            if rt9 > 0 then {
                vtSet xs: ctx.narrowTid vid: rnv9 tid: (ztypes.tid.create from: rt9.u64)
            } else {
                vtRemove xs: ctx.narrowTid vid: rnv9
            }
            ri9 = ri9 + 1
        }
    } else null
}

# emit an if/match else branch.
emitElse9: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    oId: zast.nodeid
    assignTo: StringView
    ind: StringView
    tmp: TmpCtr.view
    chSubjects: (List String).view
    chSubjectVids: (ListVal ztypes.vid).view
    chArms: (List String).view
    chTids: (ListVal u64).view
    chNegs: (ListVal bool).view
    chRecvs: (List String).view
    buf: String.borrow
} is {
    if oId > 0 then {
        o: ast.nodes.get i: oId.u64
        lh: "\{ind}} else {\n"
        buf.append lh
        ind2: "\{ind}    "
        # condition-false knowledge: each positive chain fact excludes its
        # arm for the else body (layered in ctx.exclArms so nested else-if
        # wraps compose); a negated fact IS the arm directly.
        exN9: (ListVal ztypes.vid)
        exPrevV9: (List String)
        exPrevT9: (ListVal u64)
        fi9: u64
        for fi9 < chSubjects.length loop {
            if (chNegs.get i: fi9) == false then {
                fv9: chSubjectVids.get i: fi9
                pv0: vvGet xs: ctx.exclArms vid: fv9
                exN9.append fv9
                pvc9: pv0.copy
                exPrevV9.append pvc9
                exPrevT9.append (optTidOr9 o: (vtGet xs: ctx.exclTids vid: fv9))
                fa9: chArms.get i: fi9
                nx9: String
                if pv0.length > 0 then {
                    nj9: "\{pv0} \{fa9}"
                    nx9 = nj9
                } else {
                    na0: fa9.copy
                    nx9 = na0
                }
                vvSet xs: ctx.exclArms vid: fv9 val: nx9.stringview
                vtSet xs: ctx.exclTids vid: fv9 tid: (ztypes.tid.create from: (chTids.get i: fi9))
            }
            fi9 = fi9 + 1
        }
        sN9: (List String)
        sVid9: (ListVal ztypes.vid)
        sPrevV9: (List String)
        sPrevT9: (ListVal u64)
        doneS9: (IdSet ztypes.vid)
        gi9: u64
        for gi9 < chSubjects.length loop {
            gs9: chSubjects.get i: gi9
            gv9: chSubjectVids.get i: gi9
            if (doneS9.has item: gv9) == false then {
                doneS9.add item: gv9
                gtid9: chTids.get i: gi9
                negArm9: String
                hj9: u64
                for hj9 < chSubjects.length loop {
                    h2v9: chSubjectVids.get i: hj9
                    if h2v9 == gv9 then {
                        if (chNegs.get i: hj9) then {
                            hav9: chArms.get i: hj9
                            hac9: hav9.copy
                            negArm9 = hac9
                        }
                    }
                    hj9 = hj9 + 1
                }
                fArm9: negArm9.copy
                if fArm9.length == 0 then {
                    rr9: (remainingArm9
                        :ast
                        :symtab
                        :ctx
                        subjVid: gv9
                        tid: (ztypes.tid.create from: gtid9.u64)
                        extra: ""
                    )
                    fArm9 = rr9
                }
                if fArm9.length > 0 then {
                    if (bodyReassigns9 :ast n: o name: gs9.stringview) == false then {
                        mrecv9: chRecvs.get i: gi9
                        macc9: ".".string
                        if (isPtrVid :ctx vid: gv9) then macc9 = "->".string
                        alias9: (armAliasText9
                            :ast
                            :symtab
                            :ctx
                            tid: (ztypes.tid.create from: gtid9.u64)
                            arm: fArm9.stringview
                            recv: mrecv9.stringview
                            acc: macc9.stringview
                        )
                        if alias9.length > 0 then {
                            pv9: vvGet xs: ctx.narrowBox vid: gv9
                            sPrevV9.append pv9
                            ptv9: (optTidOr9
                                o: (vtGet xs: ctx.narrowTid vid: gv9)
                            )
                            sPrevT9.append ptv9
                            gsv9: gs9.copy
                            sN9.append gsv9
                            sVid9.append gv9
                            vvSet xs: ctx.narrowBox vid: gv9 val: alias9.stringview
                            pt9: (optU64Or9
                                o: (symtab.typing.declChildOf
                                    pool: ast.names
                                    parentTypeId: (ztypes.tid.create from: gtid9.u64)
                                    name: fArm9.stringview
                                )
                            )
                            vtSet xs: ctx.narrowTid vid: gv9 tid: (ztypes.tid.create from: pt9.u64)
                            cmtS9: "\{ind}    /* alias: \{gs9} => \{alias9} */\n"
                            buf.append cmtS9
                        }
                    }
                }
            }
            gi9 = gi9 + 1
        }
        if assignTo.length > 0 then {
            (emitBranchAssign
                :ast
                :symtab
                :ctx
                n: o
                target: assignTo
                ind: ind2.stringview
                :tmp
                :buf
            )
        } else {
            fLe9: tmp.frees.length
            lLe9: tmp.listFrees.length
            emitBodyNode :ast :symtab :ctx n: o ind: ind2.stringview :tmp :buf
            dvF9: blockDiverges :ast :symtab :ctx n: o
            flushBlockFrees :ctx :tmp fL: fLe9 lL: lLe9 diverged: dvF9 :buf
        }
        ri9: u64
        for ri9 < sN9.length loop {
            rnv9: sVid9.get i: ri9
            rv9: sPrevV9.get i: ri9
            if rv9.length > 0 then {
                vvSet xs: ctx.narrowBox vid: rnv9 val: rv9.stringview
            } else {
                vvRemove xs: ctx.narrowBox vid: rnv9
            }
            rt9: sPrevT9.get i: ri9
            if rt9 > 0 then {
                vtSet xs: ctx.narrowTid vid: rnv9 tid: (ztypes.tid.create from: rt9.u64)
            } else {
                vtRemove xs: ctx.narrowTid vid: rnv9
            }
            ri9 = ri9 + 1
        }
        xi9: exN9.length
        for xi9 > 0 loop {
            xi9 = xi9 - 1
            xn9: exN9.get i: xi9
            xv9: exPrevV9.get i: xi9
            if xv9.length > 0 then {
                vvSet xs: ctx.exclArms vid: xn9 val: xv9.stringview
            } else {
                vvRemove xs: ctx.exclArms vid: xn9
            }
            xt9: exPrevT9.get i: xi9
            if xt9 > 0 then {
                vtSet xs: ctx.exclTids vid: xn9 tid: (ztypes.tid.create from: xt9.u64)
            } else {
                vtRemove xs: ctx.exclTids vid: xn9
            }
        }
    }
}

# emitBranchAssign -- emit an if/match branch whose final value assigns
# to a target: a block emits all but its last statement normally, the
# last as `target = <value>`; a single node assigns directly.
# emitReturnOfNode -- `return <value of node vid>;` with the explicit-return
# machinery: option-box hoist, string-return fast path, and the leak-safe
# temp-materialization + cleanup ordering. Shared by the `return` call arm
# and tail-position value yields.
emitReturnOfNode: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    vid: u32
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    bx: (emitOptionBoxHoist
        :ast
        :symtab
        :ctx
        n: (ast.nodes.get i: vid.u64)
        :ind
        :tmp
        :buf
    )
    if bx.length > 0 then {
        (emitValueTakeInvalidations
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: vid.u64)
            :ind
            :buf
        )
        emitReturnCleanup :ctx :tmp retExpr: bx.stringview keepRefd: true :ind :buf
        lrb: "\{ind}return \{bx};\n"
        buf.append lrb
    } else {
        sret: (emitStringReturnValue
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: vid.u64)
            :ind
            :tmp
            :buf
        )
        if (sret) == false then {
            rv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: vid.u64)
            flushArgHoists :ctx :ind :tmp :buf
            # A non-trivial value-type return may read an owned local the
            # cleanup would free -- a borrowed element or view (e.g.
            # `container.get idx`, or a StringView into a local String).
            # Materialize rv into a temp FIRST, then free. When an owned
            # local is named in rv (leakFix9), free ALL owned locals
            # (clFull9) after zeroing the moved-in call-arg sources
            # (emitValueTakeInvalidations): a read-from local is reclaimed
            # and a moved-in local's free is a no-op. Pointer returns
            # (protocol / Map / Set / by-ref class -- isPtr9) arrive as bare
            # temps; hoisting a shallow pointer copy then freeing it would
            # dangle, so they keep the refsLocal (clProbe9) cleanup inline.
            clProbe9: String
            (emitReturnCleanup
                :ctx
                :tmp
                retExpr: rv.stringview
                keepRefd: true
                :ind
                buf: clProbe9
            )
            clFull9: String
            (emitReturnCleanup
                :ctx
                :tmp
                retExpr: rv.stringview
                keepRefd: false
                :ind
                buf: clFull9
            )
            leakFix9: false
            if clFull9.length > clProbe9.length then leakFix9 = true
            rtid9: (stampIdOf
                :symtab
                nid: (nodeIdOf9 n: (ast.nodes.get i: vid.u64))
            )
            retCt9: typeRefC :ast :symtab :ctx tid: rtid9 thisTid: ztypes.tid
            isPtr9: ctEndsWithStar ct: retCt9.stringview
            if (isHeapPtrCollection :symtab :ctx tid: rtid9) then isPtr9 = true
            trivial9: isBareCName s: rv.stringview
            hoist9: false
            if (trivial9 == false) when (isPtr9 == false) when (retCt9.length > 0) then {
                if clProbe9.length > 0 then hoist9 = true
                if leakFix9 then hoist9 = true
            }
            if hoist9 then {
                rtmpN9: tmp.next
                retNm9: "_ret\{rtmpN9}"
                hdecl9: "\{ind}\{retCt9} \{retNm9} = \{rv};\n"
                buf.append hdecl9
                if leakFix9 then {
                    (emitValueTakeInvalidations
                        :ast
                        :symtab
                        :ctx
                        n: (ast.nodes.get i: vid.u64)
                        :ind
                        :buf
                    )
                }
                (emitNarrowedTakeZero
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: vid.u64)
                    :ind
                    :buf
                )
                if leakFix9 then {
                    buf.append clFull9
                } else {
                    buf.append clProbe9
                }
                hret9: "\{ind}return \{retNm9};\n"
                buf.append hret9
            } else {
                buf.append clProbe9
                # a reference return hands back the address, not a copy of the
                # struct; without the `&` the caller writes through a temporary
                rvOut9: "\{rv}"
                if ctx.refBorrowRet then rvOut9 = "&\{rv}"
                lr: "\{ind}return \{rvOut9};\n"
                buf.append lr
            }
        }
    }
}

# emitTailStmt -- the last statement of an `out`-typed function body sits in
# return position: a bare value expression becomes `return <expr>;`, and a
# with/do block forwards return position into its own final statement. False
# when the statement is not a tail-value shape (the caller emits it normally).
emitTailStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: Node.view
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} out bool is {
    match (
        n
    ) case statementline then {
        return (emitTailStmt
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.statementline.u64)
            :ind
            :tmp
            :buf
        )
    } case expression then {
        return (emitTailStmt
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.expression.u64)
            :ind
            :tmp
            :buf
        )
    } case atomid then {
        if n.name.u32 == zast.wkReturn then return false
        if n.name.u32 == zast.wkBreak then return false
        if n.name.u32 == zast.wkContinue then return false
        if (zast.nameTextEq :ast ref: n.name s: "null") then return false
        emitReturnOfNode :ast :symtab :ctx vid: n.nodeid :ind :tmp :buf
        return true
    } case binop then {
        emitReturnOfNode :ast :symtab :ctx vid: n.nodeid :ind :tmp :buf
        return true
    } case atomstring then {
        emitReturnOfNode :ast :symtab :ctx vid: n.nodeid :ind :tmp :buf
        return true
    } case withexpr then {
        wnmR8: zast.nameTextAt :ast ref: n.name
        wnmT9: varCName :ctx vid: (defVid :symtab nid: n.nodeid.u64) name: wnmR8.stringview
        wsidT9: stampIdDeep :ast :symtab n: (ast.nodes.get i: n.value.u64)
        wctT9: String
        if (originTidOf :symtab tid: (ztypes.tid.create from: wsidT9.u64)) > 0 then {
            wctT9 = (typeRefC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: wsidT9.u64)
                thisTid: ztypes.tid
            )
        } else {
            wtnT9: stampNameDeep :ast :symtab n: (ast.nodes.get i: n.value.u64)
            wctT9 = cTypeForName :ast :symtab :ctx name: wtnT9.stringview
        }
        wvT9: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.value.u64)
        # a reference-returning callee hands back `T*`, so a `with` binding
        # ALIASES its source exactly as a plain binding does
        {
            wrbT9: refBorrowCalleeFid9 :ast :symtab :ctx n: (ast.nodes.get i: n.value.u64)
            if wrbT9 > 0 when (fnReturnsRefBorrow9
                :ast
                :symtab
                :ctx
                fid: (ztypes.tid.create from: wrbT9.u64)
                retTid: (ztypes.tid.create from: wsidT9.u64)
            ) then {
                wctT9 = "\{wctT9}*"
                ctx.ptrVids.append (defVid :symtab nid: n.nodeid.u64)
            }
        }
        if wctT9.length > 0 then {
            lwT9: "\{ind}\{wctT9} \{wnmT9} = \{wvT9};\n"
            buf.append lwT9
        } else {
            lwT8: "\{ind}int64_t \{wnmT9} = \{wvT9};\n"
            buf.append lwT8
        }
        ctx.tailRetActive = true
        emitBodyNode :ast :symtab :ctx n: (ast.nodes.get i: n.body.u64) :ind :tmp :buf
        return true
    } case doexpr then {
        dstT9: ast.nodes.get i: n.statement.u64
        if (ztypecheck.blockHasBreak :ast n: dstT9) then return false
        ctx.tailRetActive = true
        emitBodyNode :ast :symtab :ctx n: dstT9 :ind :tmp :buf
        return true
    } else {
        return false
    }
}

# emit an assignment inside a branch.
emitBranchAssign: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    target: StringView
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    match (
        n
    ) case statement then {
        cnt: n.statements.length
        si: u64
        for si < cnt loop {
            sxId9: n.statements.get i: si
            sx: ast.nodes.get i: sxId9.u64
            if si + 1 == cnt then {
                vx: emitExpr :ast :symtab :ctx n: sx
                la: "\{ind}\{target} = \{vx};\n"
                buf.append la
                emitValueTakeInvalidations :ast :symtab :ctx n: sx :ind :buf
            } else {
                emitStmt :ast :symtab :ctx n: sx :ind :tmp :buf
            }
            si = si + 1
        }
    } else {
        vx2: emitExpr :ast :symtab :ctx :n
        la2: "\{ind}\{target} = \{vx2};\n"
        buf.append la2
        emitValueTakeInvalidations :ast :symtab :ctx :n :ind :buf
    }
}

# postGuardStmtId9 -- the node id of a guarding if/match statement that
# recorded a post-guard narrowing; 0 otherwise.
postGuardStmtId9: function {ast: Ast.view symtab: zenv.ZSymbolTable.view n: Node.view} out u64 is {
    match (
        n
    ) case statementline then {
        return (postGuardStmtId9 :ast :symtab n: (ast.nodes.get i: n.statementline.u64))
    } case expression then {
        return (postGuardStmtId9 :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } case ifexpr then {
        po9: symtab.typing.postGuardName.get key: n.nodeid.u64
        match (
            po9
        ) case some then {
            return n.nodeid.u64
        } case none then {
            return 0
        }
    } case caseexpr then {
        po9: symtab.typing.postGuardName.get key: n.nodeid.u64
        match (
            po9
        ) case some then {
            return n.nodeid.u64
        } case none then {
            return 0
        }
    } else {
        return 0
    }
}

# emit one statement or expression node of a body.
emitBodyNode: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: Node.view
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    match (
        n
    ) case statement then {
        trTail9: ctx.tailRetActive
        ctx.tailRetActive = false
        pgN9: (List String)
        pgVid9: (ListVal ztypes.vid)
        pgPrevV9: (List String)
        pgPrevT9: (ListVal u64)
        pgDead9: (IdSet ztypes.vid)
        i9: u64
        nst9: n.statements.length
        for i9 < nst9 loop {
            s9Id9: n.statements.get i: i9
            s9: ast.nodes.get i: s9Id9.u64
            # a reassignment of a seeded name ends its post-guard alias
            ri9: u64
            for ri9 < pgN9.length loop {
                rn9: pgN9.get i: ri9
                rnv0: pgVid9.get i: ri9
                if (pgDead9.has item: rnv0) == false then {
                    if (bodyReassigns9 :ast n: s9 name: rn9.stringview) then {
                        rv9: pgPrevV9.get i: ri9
                        if rv9.length > 0 then {
                            vvSet xs: ctx.narrowBox vid: rnv0 val: rv9.stringview
                        } else {
                            vvRemove xs: ctx.narrowBox vid: rnv0
                        }
                        rt9: pgPrevT9.get i: ri9
                        if rt9 > 0 then {
                            vtSet xs: ctx.narrowTid vid: rnv0 tid: (ztypes.tid.create from: rt9.u64)
                        } else {
                            vtRemove xs: ctx.narrowTid vid: rnv0
                        }
                        pgDead9.add item: rnv0
                    }
                }
                ri9 = ri9 + 1
            }
            tailNow9: false
            if trTail9 when i9 + 1 == nst9 then tailNow9 = true
            handled9: false
            if tailNow9 then {
                handled9 = emitTailStmt :ast :symtab :ctx n: s9 :ind :tmp :buf
            }
            if handled9 == false then emitStmt :ast :symtab :ctx n: s9 :ind :tmp :buf
            trunc9: false
            if (stmtDiverges9
                :ast
                :symtab
                :ctx
                sid: (zast.nodeid.create from: s9Id9.u64)
            ) then trunc9 = true
            pgid9: postGuardStmtId9 :ast :symtab n: s9
            if pgid9 > 0 then {
                pgRawN9: String
                {
                    pgnO9: symtab.typing.postGuardName.get key: pgid9
                    match (
                        pgnO9
                    ) case some then {
                        pgv0: pgnO9.copy
                        pgRawN9 = pgv0
                    } case none then null
                }
                pgRecv9: String
                {
                    pgrO9: symtab.typing.postGuardRecv.get key: pgid9
                    match (
                        pgrO9
                    ) case some then {
                        pgrc9: pgrO9.copy
                        pgRecv9 = pgrc9
                    } case none then null
                }
                # postGuardRecv is the subject's SOURCE name; the alias text it
                # builds is emitted C, so it has to be the subject's identifier --
                # and the narrowing tables below key on the subject's variable
                pgrv9: optVidOr9 o: (symtab.typing.postGuardVarId.get key: pgid9)
                if pgrv9 > 0 when pgRawN9.length > 0 then {
                    pgre9: varCName :ctx vid: pgrv9 name: pgRawN9.stringview
                    pgRecv9 = pgre9
                }
                pgTid0: ztypes.tid
                {
                    pgtO9: symtab.typing.postGuardTid.get key: pgid9
                    match (
                        pgtO9
                    ) case some then {
                        pgTid0 = ztypes.tid.create from: (pgtO9)
                    } case none then null
                }
                pgArm0: String
                {
                    pgaO9: symtab.typing.postGuardArm.get key: pgid9
                    match (
                        pgaO9
                    ) case some then {
                        pgav9: pgaO9.copy
                        pgArm0 = pgav9
                    } case none then null
                }
                {
                    if pgRawN9.length > 0 when pgRecv9.length > 0 when pgTid0 > 0 when pgArm0.length > 0 then {
                        acc9: ".".string
                        pgv9: (optVidOr9
                            o: (symtab.typing.postGuardVarId.get key: pgid9)
                        )
                        if (isPtrVid :ctx vid: pgv9) then acc9 = "->".string
                        alias9: (armAliasText9
                            :ast
                            :symtab
                            :ctx
                            tid: (ztypes.tid.create from: pgTid0.u64)
                            arm: pgArm0.stringview
                            recv: pgRecv9.stringview
                            acc: acc9.stringview
                        )
                        if alias9.length > 0 then {
                            pv9: vvGet xs: ctx.narrowBox vid: pgrv9
                            pgPrevV9.append pv9
                            ptv9: (optTidOr9
                                o: (vtGet xs: ctx.narrowTid vid: pgrv9)
                            )
                            pgPrevT9.append ptv9
                            vvSet xs: ctx.narrowBox vid: pgrv9 val: alias9.stringview
                            pt9: (optU64Or9
                                o: (symtab.typing.declChildOf
                                    pool: ast.names
                                    parentTypeId: pgTid0
                                    name: pgArm0.stringview
                                )
                            )
                            (vtSet
                                xs: ctx.narrowTid
                                vid: pgrv9
                                tid: (ztypes.tid.create from: pt9.u64)
                            )
                            cmt9: "\{ind}/* post-guard alias: \{pgRawN9} => \{alias9} */\n"
                            buf.append cmt9
                            pgrn9: pgRawN9.copy
                            pgN9.append pgrn9
                            pgVid9.append pgrv9
                        }
                    }
                }
            }
            i9 = i9 + 1
            if trunc9 then i9 = nst9
        }
        zi9: pgN9.length
        for zi9 > 0 loop {
            zi9 = zi9 - 1
            znv9: pgVid9.get i: zi9
            if (pgDead9.has item: znv9) == false then {
                zv9: pgPrevV9.get i: zi9
                if zv9.length > 0 then {
                    vvSet xs: ctx.narrowBox vid: znv9 val: zv9.stringview
                } else {
                    vvRemove xs: ctx.narrowBox vid: znv9
                }
                zt9: pgPrevT9.get i: zi9
                if zt9 > 0 then {
                    vtSet xs: ctx.narrowTid vid: znv9 tid: (ztypes.tid.create from: zt9.u64)
                } else {
                    vtRemove xs: ctx.narrowTid vid: znv9
                }
            }
        }
    } else {
        emitStmt :ast :symtab :ctx :n :ind :tmp :buf
    }
}

# forexprValue -- the value being bound is a for-loop (a list comprehension).
forexprValue: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (forexprValue :ast n: (ast.nodes.get i: n.expression.u64))
    } case forexpr then {
        return true
    } else {
        return false
    }
}

# emitComprehensionBody -- unwrap the body Option (borrowed via the param) and
# emit its statements, the last appended to the list.
emitComprehensionBody: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    body: Node.view
    listCb: StringView
    listVar: StringView
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    emitComprehensionNode :ast :symtab :ctx n: body :listCb :listVar :ind :tmp :buf
}

# emitComprehensionNode -- the body's statements: each but the last emits
# normally; the last is the value expression, appended to the list.
emitComprehensionNode: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    listCb: StringView
    listVar: StringView
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    match (
        n
    ) case statement then {
        cnt: n.statements.length
        si: u64
        for si < cnt loop {
            stId9: n.statements.get i: si
            st: ast.nodes.get i: stId9.u64
            if si == (cnt - 1) then {
                av: emitExpr :ast :symtab :ctx n: st
                la: "\{ind}\{listCb}_append(&\{listVar}, (\{av}));\n"
                buf.append la
            } else {
                emitStmt :ast :symtab :ctx n: st :ind :tmp :buf
            }
            si = si + 1
        }
    } else {
        av2: emitExpr :ast :symtab :ctx :n
        la2: "\{ind}\{listCb}_append(&\{listVar}, (\{av2}));\n"
        buf.append la2
    }
}

# emitListComprehension -- populate listVar from `for x: N.iterate loop { expr }`:
# a counted for-loop whose body appends the comprehension's value expression.
emitListComprehension: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    forNode: Node.view
    listCb: StringView
    listVar: StringView
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    match (
        forNode
    ) case expression then {
        (emitListComprehension
            :ast
            :symtab
            :ctx
            forNode: (ast.nodes.get i: forNode.expression.u64)
            :listCb
            :listVar
            :ind
            :tmp
            :buf
        )
    } case forexpr then {
        if forNode.conditions.length != 1 then return
        c0Id9: forNode.conditions.get i: 0
        c0: ast.nodes.get i: c0Id9.u64
        match (
            c0
        ) case namedoperation then {
            lblR6: zast.nameTextAt :ast ref: c0.name
            lblV6: defVid :symtab nid: (nodeIdOf9 n: (ast.nodes.get i: c0.operation.u64))
            lbl: varCName :ctx vid: lblV6 name: lblR6.stringview
            bound: rangeBoundExpr :ast :symtab :ctx n: (ast.nodes.get i: c0.operation.u64)
            from: rangeFromExpr :ast :symtab :ctx n: (ast.nodes.get i: c0.operation.u64)
            if bound.length == 0 then return
            fh: "\{ind}for (int64_t \{lbl} = \{from}; \{lbl} < \{bound}; \{lbl}++) {\n"
            buf.append fh
            ind2: "\{ind}    "
            (emitComprehensionBody
                :ast
                :symtab
                :ctx
                body: (ast.nodes.get i: forNode.body.u64)
                :listCb
                :listVar
                ind: ind2.stringview
                :tmp
                :buf
            )
            lcc9: "\{ind}}\n"
            buf.append lcc9
        } else null
    } else null
}


# fnSignature -- "RET cname(PARAMS)" for a user function from its
# resolved type's children and return stamp (z_main for main).
# fnReturnTypeId -- the stamped type id of a function's return-type node (the
# typecheck stamps `op.returntype`, even for concrete fns whose registry
# returnTypeId is unset). 0 when the fn has no return type.
fnReturnTypeId: function {ast: Ast.view symtab: zenv.ZSymbolTable.view op: Node.view} out u64 is {
    match (
        op
    ) case functiondef then {
        rtId9: op.returntype
        if rtId9 > 0 then {
            rt9: ast.nodes.get i: rtId9.u64
            return (stampIdOf :symtab nid: (nodeIdOf9 n: rt9))
        } else {
            return 0
        }
    } else {
        return 0
    }
}

# isReftypeParam -- a user reftype (class/union) param, passed BY REFERENCE: a
# function param that is a CLASS or UNION, not a collection mono (List/Map/Set),
# and not a value-native (String/StringView live in the system/collections
# units). Records/variants/facets (valtypes) and natives stay by value.
# isUserClassMonoTid -- a specialization of a non-native user CLASS template
# (its instances behave like ordinary classes: pointer receivers, method
# children cloned per spec).
isUserClassMonoTid: function {symtab: zenv.ZSymbolTable ctx: Ctx.view tid: ztypes.tid} out bool is {
    og4: genericOriginOf9 :symtab :tid
    if og4 > 0 then {
        if (symtab.reg.typetypeOf typeId: og4) == ztypes.ztypetype.classType then {
            if (isCollectionOriginTid :ctx originTid: og4) == false then {
                hit4: false
                nat4: false
                {
                    isNative9v: symtab.reg.isNativeOf tid: og4
                        hit4 = true
                        if isNative9v then nat4 = true
                }
                if hit4 then return (nat4 == false)
            }
        }
    }
    return false
}

# true when parameter type `tid` is a reftype (passed by reference).
isReftypeParam: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    cid: tid
    rduo0: definedInUnitOf :symtab :tid
    isShell0: true
    match (
        rduo0
    ) case some then {
        isShell0 = false
    } case none then null
    if isShell0 then {
        rtn0: typeNameOfReg9 :symtab :tid
        rrid0: canonTypeId :ast :symtab :ctx :tid name: rtn0.stringview
        if rrid0 > 0 then cid = ztypes.tid.create from: rrid0.u64
    }
    tt: symtab.reg.typetypeOf typeId: cid
    # Only CLASS params pass by reference. A UNION is a small value-stable
    # {tag, void* data} struct passed BY VALUE (the data pointer is shared with
    # the source; the borrow is tracked separately), matching the reference.
    if tt != ztypes.ztypetype.classType then return false
    monoLk4: originTidOf :symtab tid: cid
    if monoLk4 > 0 then {
        if (isUserClassMonoTid :symtab :ctx tid: cid) == false then return false
    }
    # system/collections classes answer through their own family rules, not
    # the user-class one: containers via isListPtrParam/isSetMapPtrParam,
    # String via isBorrowStringParam (pointer when non-owned), StringView by
    # value (16-byte fat pointer, no owned interior).
    duo: definedInUnitOf :symtab tid: cid
    match (
        duo
    ) case some then {
        if duo.stringview == "system" then return false
        if duo.stringview == "collections" then return false
    } case none then null
    return true
}

# elemBorrowsByPtr -- a List/ListView element type whose `get` lowers to a
# POINTER into the element storage, honouring the declared `out of.borrow`.
# Mirrors the parameter-passing classification: user CLASSES and String carry
# heap fields and inline container headers, so a copy is NOT a borrow (a field
# write is dropped, and an append through an inline container field reallocs
# the copy's buffer and strands the stored element on a freed pointer). A
# UNION is a value-stable {tag, void* data} whose payload pointer is already
# shared, and a valtype has no interior -- for both, the copy IS the borrow.
elemBorrowsByPtr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    if tid.isZero then return false
    if tid == ctx.strTid then return true
    chs09: chaseStrTypedef :symtab :ctx :tid
    if chs09 == ctx.strTid then return true
    return (isReftypeParam :ast :symtab :ctx :tid)
}

# elemRefByPtr -- a List/ListView element type whose MUTABLE reference is a
# pointer into the storage. Everything `elemBorrowsByPtr` covers, plus a
# COMPOUND valtype: a record or variant has children, and mutating them in
# place is exactly what `getMut` is for, so handing back a copy loses the
# write. It is deliberately NOT the same question as `elemBorrowsByPtr`, which
# also answers "what calling convention does this type use" for the declared
# hash/`==` dispatch, where a record is still passed BY VALUE.
elemRefByPtr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    if (elemBorrowsByPtr :ast :symtab :ctx :tid) then return true
    tt9: symtab.reg.typetypeOf typeId: tid
    if tt9 == ztypes.ztypetype.recordType then return true
    return tt9 == ztypes.ztypetype.variantType
}

# listGetIsPtr -- the `get` of this List/ListView mono returns a pointer. False
# while the runtime templates still carry their own by-value `get` (the
# emitted C must agree with whichever compiler read the template), so the
# lowering flips atomically when `get` moves into emitColGet.
listGetIsPtr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    monoId: ztypes.tid
} out bool is {
    if (ctx.colGetFromCode) == false then return false
    return (elemBorrowsByPtr :ast :symtab :ctx tid: (listElemType :symtab :monoId))
}

# isBorrowStringParam -- a non-owned String param (BORROW/LOCK or VIEW), passed
# BY REFERENCE: String is 24 bytes with a heap interior, so a copy is never a
# borrow -- `.borrow` needs the pointer for mutation (append/reserve), `.view`
# for cost and so a view-projected String (StringView.asString) can alias one.
# A `.take` String param is moved by value instead. StringView stays BY VALUE
# for a stated reason: a 16-byte fat pointer with no owned interior -- two
# registers on SysV, and copying it carries nothing that can dangle.
isBorrowStringParam: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    fid: ztypes.tid
    pname: StringView
    pid: ztypes.tid
} out bool is {
    ptn9: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: pid.u64)
    if ptn9.stringview != "String" then return false
    if (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.borrowMode
    ) then return true
    if (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.viewMode
    ) then return true
    return false
}

# registerReftypeParams -- add a top-level function's reftype (class/union)
# params to ctx.ptrVids, so the body reads them as `param->field` and method
# calls pass them directly (they arrive as pointers). Caller resets ptrVids.
# isSetMapPtrParam -- a non-TAKE Set/Map param. Set/Map are heap pointers, so the
# param is passed BY POINTER (Set_t*) and its arg (a Set/Map local/field, also a
# pointer) is passed directly -- unlike a by-value List param which needs &.
isSetMapPtrParam: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    fid: ztypes.tid
    pname: StringView
    tid: ztypes.tid
} out bool is {
    if (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.takeMode
    ) then return false
    # the param's own origin (a typedef wrapper chases to its base mono)
    # against the cached Set/Map template ids
    bt: chaseColMono :symtab :ctx :tid
    if (isSetOriginOf :symtab :ctx tid: (ztypes.tid.create from: bt.u64)) then return true
    if (isMapOriginOf :symtab :ctx tid: (ztypes.tid.create from: bt.u64)) then return true
    return false
}

# isListPtrParam -- a non-TAKE List param (a value-struct collection) passes BY
# POINTER so the callee's append/pop/set persist to the caller. A `.take` List is
# moved by value; Set/Map monos are already heap pointers (no extra `*`).
isListPtrParam: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    fid: ztypes.tid
    pname: StringView
    tid: ztypes.tid
} out bool is {
    if (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.takeMode
    ) then return false
    bt: chaseColMono :symtab :ctx :tid
    if (isIdCollectionOriginOf :symtab :ctx tid: (ztypes.tid.create from: bt.u64)) then return true
    return (isListOriginOf :symtab :ctx tid: (ztypes.tid.create from: bt.u64))
}

# record which of function `fid`'s parameters are reftypes.
registerReftypeParams: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    fid: ztypes.tid
    op: Node.view
} is {
    pNames: (List String)
    pIds: (ListVal u64)
    pNmIds: (ListVal u64)
    recFieldLists :ast :symtab tid: fid names: pNames ids: pIds nameIds: pNmIds
    ri: u64
    rn: pNames.length
    for ri < rn loop {
        rpid: pIds.get i: ri
        rpn: pNames.get i: ri
        regp9: (paramTypeIsPointer
            :ast
            :symtab
            :ctx
            :fid
            pname: rpn.stringview
            pid: (ztypes.tid.create from: rpid.u64)
        )
        if regp9 then {
            rvd9: (paramVidByNameId
                :ast
                :symtab
                :op
                nameId: (zast.nameid.create from: (pNmIds.get i: ri))
            )
            ctx.ptrVids.append rvd9
        }
        ri = ri + 1
    }
}

# paramIsReceiverName -- is `pname` the method's receiver slot? `this` for the
# `:this` shorthand, or the spelled name for `{a: this}`. The receiver is a
# pointer in BOTH families, so a call passing a value-typed one must address it.
# Call sites add this leg ALONE, never the whole definition-side predicate: a
# Map or Set argument is already a pointer and must not be addressed again.
paramIsReceiverName: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    fid: ztypes.tid
    pname: StringView
} out bool is {
    rnm9: "this".string
    {
        tpn9: (zast.poolTextCopy
            pool: ast.names
            ref: (symtab.reg.thisParamNameIdOf tid: fid)
        )
        if tpn9.length > 0 then rnm9 = tpn9
    }
    return (pname == rnm9.stringview)
}

# calleeTakesReceiverByPtr -- does this method's FIRST parameter occupy the
# receiver slot? Only then does a call address the base. A valtype method whose
# first parameter is an ordinary one of the same type (`double: function
# {self: meters}`) still takes it by value.
calleeTakesReceiverByPtr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    fid: ztypes.tid
} out bool is {
    fpN9: (List String)
    fpI9: (ListVal u64)
    fpNm9: (ListVal u64)
    recFieldLists :ast :symtab tid: fid names: fpN9 ids: fpI9 nameIds: fpNm9
    if fpN9.length == 0 then return false
    fp09: fpN9.get i: 0
    return (paramIsReceiverName :ast :symtab :fid pname: fp09.stringview)
}

# markedValtypeRefParam -- an explicitly marked VALTYPE parameter, which is a
# REFERENCE: `.borrow` so a write through it reaches the caller (passed by
# value the write was silently LOST), `.view` so a large value is not copied.
# An UNMARKED valtype parameter stays a copy: the marker is how a reference is
# asked for, and that is what holds this to the declarations that opt in.
#
# NATIVES are excluded -- their C is hand-written and takes the value by value.
# `Map.get key: key.view`, `Set.delete item: of.view` and `List.contains
# item: of.view` monomorphise that marker onto a valtype key, and the runtime
# templates would stop matching their own prototypes.
markedValtypeRefParam: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    fid: ztypes.tid
    pname: StringView
    pid: u64
} out bool is {
    if (symtab.reg.isNativeOf tid: fid) then return false
    if (symtab.reg.isValtypeOf tid: (ztypes.tid.create from: pid.u64)) == false then return false
    if (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.viewMode
    ) then return true
    if (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.borrowMode
    ) then return true
    return false
}

# paramTypeIsPointer -- is a parameter's C type `T*`? A non-`take` user class
# passes by reference, and the stdlib families answer separately because
# isReftypeParam deliberately covers user classes only.
#
# This is the DEFINITION-side question. Whether a CALL must write `&arg` is a
# DIFFERENT one and has its own answer at each call site: a Map or Set local
# already holds a pointer (their create returns one), so taking its address
# would build a `T**`, while a List local is a value and does need the `&`.
paramTypeIsPointer: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    fid: ztypes.tid
    pname: StringView
    pid: ztypes.tid
} out bool is {
    isTake9: (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.takeMode
    )
    isHold9: (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.holdMode
    )
    # The receiver is a reference in BOTH families -- its default is `borrow`,
    # not `take`, so a record method acts on the caller's instance rather than
    # on a copy of it.
    if (isTake9) == false when (isHold9) == false then {
        if pname == "this" then return true
        rnid9: zast.poolFind pool: ast.names text: pname
        if rnid9 > 0 then {
            if (symtab.reg.thisParamNameIs tid: fid nameId: rnid9) then return true
        }
    }
    if (isTake9) == false when (isHold9) == false then {
        if (markedValtypeRefParam :ast :symtab :fid :pname :pid) then return true
    }
    if (isTake9) == false when (isReftypeParam
        :ast
        :symtab
        :ctx
        tid: (ztypes.tid.create from: pid.u64)
    ) then return true
    if (isBorrowStringParam :ast :symtab :fid :pname :pid) then return true
    if (isListPtrParam
        :ast
        :symtab
        :ctx
        :fid
        :pname
        tid: (ztypes.tid.create from: pid.u64)
    ) then return true
    if (isSetMapPtrParam
        :ast
        :symtab
        :ctx
        :fid
        :pname
        tid: (ztypes.tid.create from: pid.u64)
    ) then return true
    return false
}

# emit a function's C signature.
fnSignature: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    name: StringView
    fid: ztypes.tid
    op: Node.view
} out String is {
    if name == "main" then return "void z_main(void)".string
    ret: "void".string
    rbn: ztypecheck.fnReturnBaseNameOf :ast :op
    if rbn.length > 0 then {
        rbc: cTypeOf name: rbn.stringview
        rtid0: fnReturnTypeId :ast :symtab :op
        if rtid0 == ctx.strTid then {
            rs0: "\{ctx.strC}_t"
            ret = rs0
        } else if rtid0 == ctx.svTid then {
            rs1: "\{ctx.svC}_t"
            ret = rs1
        } else if rbc.length > 0 then {
            if (scalarTidIsBuiltin
                :symtab
                tid: (ztypes.tid.create from: rtid0.u64)
            ) == false then {
                ret = (typeRefC
                    :ast
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: rtid0.u64)
                    thisTid: ztypes.tid
                )
            } else {
                ret = rbc
            }
        } else {
            rbi9: userFnId :ast :symtab :ctx name: rbn.stringview
            if rbi9 > 0 then {
                rr9: typeRefC :ast :symtab :ctx tid: rbi9 thisTid: ztypes.tid
                if rr9.length > 0 then ret = rr9
            }
        }
    }
    {
        rto: fnReturnTidOf :symtab tid: fid
        if rto > 0 then {
            {
                rn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: rto.u64)
                rc: cTypeOf name: rn.stringview
                if rc.length > 0 then {
                    if (scalarTidIsBuiltin
                        :symtab
                        tid: (ztypes.tid.create from: rto.u64)
                    ) == false then {
                        ret = (typeRefC
                            :ast
                            :symtab
                            :ctx
                            tid: (ztypes.tid.create from: rto.u64)
                            thisTid: ztypes.tid
                        )
                    } else {
                        ret = rc
                    }
                } else {
                    # a non-scalar return the rbn block didn't resolve -- e.g. an
                    # optionval/resultval (or other) mono. Use typeRefC, which
                    # gives the mono's C type. Only when ret is still void, so a
                    # resolution from rbn above is never overridden.
                    if ret.stringview == "void" then {
                        rr2: (typeRefC
                            :ast
                            :symtab
                            :ctx
                            tid: (ztypes.tid.create from: rto.u64)
                            thisTid: ztypes.tid
                        )
                        if rr2.length > 0 then ret = rr2
                    }
                }
            }
        }
    }
    if ret.stringview == "void" then {
        rtnid9: fnReturnTypeId :ast :symtab :op
        if rtnid9 > 0 then {
            rtr9: (typeRefC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: rtnid9.u64)
                thisTid: ztypes.tid
            )
            if rtr9.length > 0 then ret = rtr9
        }
    }
    if ret.stringview != "void" then {
        retColId9: fnReturnTidOf :symtab tid: fid
        if retColId9 == 0 then retColId9 = fnReturnTypeId :ast :symtab :op
        if retColId9 > 0 when (isHeapPtrCollection
            :symtab
            :ctx
            tid: (ztypes.tid.create from: retColId9.u64)
        ) then ret = "\{ret}*"
        if (fnReturnsRefBorrow9
            :ast
            :symtab
            :ctx
            :fid
            retTid: (ztypes.tid.create from: retColId9.u64)
        ) then ret = "\{ret}*"
    }
    params: String
    cNames: (List String)
    cIds: (ListVal u64)
    cNmIds: (ListVal u64)
    recFieldLists :ast :symtab tid: fid names: cNames ids: cIds nameIds: cNmIds
    pi: u64
    pn: cNames.length
    for pi < pn loop {
        pname: cNames.get i: pi
        pid: cIds.get i: pi
        ct: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: pid.u64) thisTid: ztypes.tid
        ptrp9: (paramTypeIsPointer
            :ast
            :symtab
            :ctx
            :fid
            pname: pname.stringview
            pid: (ztypes.tid.create from: pid.u64)
        )
        if ptrp9 then {
            if ct.length > 0 then {
                ctp9: "\{ct}*"
                ct = ctp9
            }
        }
        if pi > 0 then params.append ", "
        if ct.length > 0 then {
            params.append ct
        } else {
            params.append "int64_t"
        }
        params.append " "
        pmnV9: (paramVidByNameId
            :ast
            :symtab
            :op
            nameId: (zast.nameid.create from: (cNmIds.get i: pi))
        )
        pmnDecl9: varCName :ctx vid: pmnV9 name: pname.stringview
        params.append pmnDecl9
        pi = pi + 1
    }
    if pn == 0 then params.append "void"
    fc: ctxCname :ctx tid: fid
    sig: "\{ret} \{fc}(\{params})"
    return sig
}

# typedefChaseTid9 -- the chain-end base tid of a typedef (tid itself when it
# is not one). The equality, cast and key-classification legs ask this so a
# typedef behaves exactly as its base at the C level.
typedefChaseTid9: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out ztypes.tid is {
    cur9: tid
    for true loop {
        bo9: symtab.typing.typedefBaseTid.get key: cur9
        match (
            bo9
        ) case some then {
            cur9 = ztypes.tid.create from: (bo9)
        } case none then break
    }
    return (ztypes.tid.create from: cur9)
}

# typedefChaseBaseName9 -- the chain-end base NAME of a typedef, "" when tid
# is not one.
typedefChaseBaseName9: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out String is {
    cur9: tid
    nm9: String
    for true loop {
        bn9: symtab.typing.typedefBaseName.get key: cur9
        match (
            bn9
        ) case some then {
            nm9 = bn9.copy
        } case none then null
        bo9: symtab.typing.typedefBaseTid.get key: cur9
        match (
            bo9
        ) case some then {
            cur9 = ztypes.tid.create from: (bo9)
        } case none then break
    }
    return nm9
}

# typedefChaseC -- the underlying C scalar of a typedef record, chasing
# the typedef-base chain (meters -> i64, height -> meters -> i64); ""
# when the type is not a typedef.
typedefChaseC: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out String is {
    bnX9: String
    hitB9: false
    {
        bo: symtab.typing.typedefBaseName.get key: tid
        match (
            bo
        ) case some then {
            hitB9 = true
            bnX9 = bo.copy
        } case none then null
    }
    if hitB9 then {
        bc: cTypeOf name: bnX9.stringview
        if bc.length > 0 then return bc
        bid: userFnId :ast :symtab :ctx name: bnX9.stringview
        if bid > 0 then return (typeRefC :ast :symtab :ctx tid: bid thisTid: ztypes.tid)
        pmsg8: "zemitterc: unresolvable typedef base \{bnX9} for id \{tid}"
        panic pmsg8
    }
    return "".string
}

# isTypedefType -- the type id carries a typedef base.
isTypedefType: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    return (symtab.typing.typedefBaseName.has key: tid)
}

# isBoxTid -- the type is a builtin Box mono (heap pointer), as flagged by the
# typechecker (isBox). Distinguishes the builtin Box from a user class also
# named Box (e.g. linkedlist's generic Box).
isBoxTid: function {symtab: zenv.ZSymbolTable tid: ztypes.tid} out bool is {
    return (symtab.reg.isBoxOf :tid)
}

# nodeIsAtomBox -- n is a bare atom whose type is a builtin Box (a heap pointer),
# so an arithmetic/compare operand must auto-deref (`b` -> `(*b)`).
nodeIsAtomBox: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
} out bool is {
    match (
        n
    ) case expression then {
        return (nodeIsAtomBox :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        bxt9: stampIdOf :symtab nid: n.nodeid.u64
        return (isBoxTid :symtab tid: bxt9)
    } else {
        return false
    }
}

# isListOriginOf -- the type is a List of EITHER family. The two templates
# differ in what they DECLARE (a valtype element copies out, a reftype element
# hands back a view) and not at all in the C the emitter builds from them, so
# every site that just means "is this a List" asks this rather than naming one.
isListOriginOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    if (originIsTid :symtab :tid originTid: ctx.listOriginTid) then return true
    return (originIsTid :symtab :tid originTid: ctx.listValOriginTid)
}

# isSetOriginOf -- the type is a Set of EITHER family. The two templates differ
# in what they DECLARE (a valtype element is passed and returned by value, a
# reftype element is taken and viewed) and not at all in the C the emitter
# builds from them, so every site that just means "is this a Set" asks this
# rather than naming one.
isSetOriginOf: function {symtab: zenv.ZSymbolTable.view ctx: Ctx.view tid: ztypes.tid} out bool is {
    if (originIsTid :symtab :tid originTid: ctx.setOriginTid) then return true
    return (originIsTid :symtab :tid originTid: ctx.setValOriginTid)
}

# isMapOriginOf -- the type is a Map of ANY of the four key/value families.
# They differ in what they DECLARE (what is taken, what is viewed, and whether
# a lookup copies out or hands back a view) and not at all in the C the emitter
# builds from them, so every site that just means "is this a Map" asks this
# rather than naming one.
isMapOriginOf: function {symtab: zenv.ZSymbolTable.view ctx: Ctx.view tid: ztypes.tid} out bool is {
    if (originIsTid :symtab :tid originTid: ctx.mapOriginTid) then return true
    if (originIsTid :symtab :tid originTid: ctx.mapRVOriginTid) then return true
    if (originIsTid :symtab :tid originTid: ctx.mapVROriginTid) then return true
    return (originIsTid :symtab :tid originTid: ctx.mapVVOriginTid)
}

# isIdMapOriginOf -- the type is an IdMap of either value family. As with the
# Map forms they differ in what they DECLARE (a reftype value hands back a
# view, a valtype value copies out) and not in the C built from them.
isIdMapOriginOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    if (originIsTid :symtab :tid originTid: ctx.idMapROriginTid) then return true
    return (originIsTid :symtab :tid originTid: ctx.idMapVOriginTid)
}

# isIdSetOriginOf -- the type is an IdSet. One form only: an id is a valtype,
# so there is no reference/value split to make.
isIdSetOriginOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    return (originIsTid :symtab :tid originTid: ctx.idSetOriginTid)
}

# isIdCollectionOriginOf -- an IdMap or an IdSet. They share a struct shape
# (stack header, two counters, two heap arrays), and every site that means
# "is this one of the id-keyed containers" asks this rather than naming one.
isIdCollectionOriginOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    if (isIdMapOriginOf :symtab :ctx :tid) then return true
    return (isIdSetOriginOf :symtab :ctx :tid)
}

# isListViewOriginOf -- the type is a List window of EITHER family. The two
# templates differ in what `get` DECLARES (a valtype element copies out, a
# reference element hands back a view) and not at all in the C built from them.
isListViewOriginOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    if (originIsTid :symtab :tid originTid: ctx.listViewOriginTid) then return true
    return (originIsTid :symtab :tid originTid: ctx.listViewValOriginTid)
}

# isMapEntryOriginOf -- the type is the borrowed entry projection of any of
# the four Map forms. key/value project struct fields identically in all four.
isMapEntryOriginOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    if (originIsTid :symtab :tid originTid: ctx.mapEntryOriginTid) then return true
    if (originIsTid :symtab :tid originTid: ctx.mapEntryRVOriginTid) then return true
    if (originIsTid :symtab :tid originTid: ctx.mapEntryVROriginTid) then return true
    return (originIsTid :symtab :tid originTid: ctx.mapEntryVVOriginTid)
}

# isIdMapEntryOriginOf -- the borrowed entry projection of either IdMap form.
# key/value project the same struct fields in both.
isIdMapEntryOriginOf: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    if (originIsTid :symtab :tid originTid: ctx.idMapEntryROriginTid) then return true
    return (originIsTid :symtab :tid originTid: ctx.idMapEntryVOriginTid)
}

# isCollectionOriginTid -- originTid (a genericOriginId) is one of the
# cached collection/iterator origin ids, i.e. a template that mints a C struct
# type (List/ListView/Set/Map/MapEntry and the iterators).
isCollectionOriginTid: function {ctx: Ctx.view originTid: ztypes.tid} out bool is {
    if originTid.isZero then return false
    if originTid == ctx.listOriginTid then return true
    if originTid == ctx.listValOriginTid then return true
    if originTid == ctx.listViewOriginTid then return true
    if originTid == ctx.listViewValOriginTid then return true
    if originTid == ctx.setOriginTid then return true
    if originTid == ctx.setValOriginTid then return true
    if originTid == ctx.idMapROriginTid then return true
    if originTid == ctx.idMapVOriginTid then return true
    if originTid == ctx.idSetOriginTid then return true
    if originTid == ctx.idSetIterOriginTid then return true
    if originTid == ctx.idMapItemIterROriginTid then return true
    if originTid == ctx.idMapItemIterVOriginTid then return true
    if originTid == ctx.idMapEntryROriginTid then return true
    if originTid == ctx.idMapEntryVOriginTid then return true
    if originTid == ctx.mapOriginTid then return true
    if originTid == ctx.mapRVOriginTid then return true
    if originTid == ctx.mapVROriginTid then return true
    if originTid == ctx.mapVVOriginTid then return true
    if originTid == ctx.mapEntryOriginTid then return true
    if originTid == ctx.listIterOriginTid then return true
    if originTid == ctx.listIterValOriginTid then return true
    if originTid == ctx.setIterOriginTid then return true
    if originTid == ctx.setIterValOriginTid then return true
    if originTid == ctx.mapKeyIterOriginTid then return true
    if originTid == ctx.mapItemIterOriginTid then return true
    if originTid == ctx.mapKeyIterRVOriginTid then return true
    if originTid == ctx.mapKeyIterVROriginTid then return true
    if originTid == ctx.mapKeyIterVVOriginTid then return true
    if originTid == ctx.mapItemIterRVOriginTid then return true
    if originTid == ctx.mapItemIterVROriginTid then return true
    if originTid == ctx.mapItemIterVVOriginTid then return true
    if originTid == ctx.mapEntryRVOriginTid then return true
    if originTid == ctx.mapEntryVROriginTid then return true
    if originTid == ctx.mapEntryVVOriginTid then return true
    return false
}

# cTypeForNameTid -- like cTypeForName, for a site that holds the tid: a
# native scalar (the declaration's marker) or a shell spells by name, as
# cTypeOf does; everything else -- a user type shadowing a scalar, a mono, a
# stdlib class -- spells from its id. For collection-mono VAL_T/KEY_T/ELEM_T
# where the element/key/value tid is known.
cTypeForNameTid: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    name: StringView
    tid: ztypes.tid
} out String is {
    if (scalarTidIsBuiltin :symtab :tid) then return (cTypeForName :ast :symtab :ctx :name)
    return (typeRefC :ast :symtab :ctx :tid thisTid: ztypes.tid)
}

# cTypeForName -- the C type for a type NAME: scalar via cTypeOf, else
# resolve the type id (across units) and use typeRefC; "" when unknown.
cTypeForName: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    name: StringView
} out String is {
    sc: cTypeOf :name
    if sc.length > 0 then return sc
    to: (ztypecheck.walkLookupTyperef
        :ast
        ty: symtab.typing
        reg: symtab.reg
        unitDecl: (ztypecheck.unitDeclOfName ty: symtab.typing :ast name: ctx.mainName.stringview)
        base: name
    )
    match (
        to
    ) case some then {
        return (typeRefC
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: to.u64)
            thisTid: ztypes.tid
        )
    } case none then {
        # cross-unit: a dep-unit type (e.g. ztypes.zownership used as a ztyping
        # Map value) is outside walkLookupTyperef's search list; resolve via
        # the registry-wide cross-unit scan.
        xid9: resolveTypeIdByName :ast :symtab :ctx :name
        if xid9 > 0 then return (typeRefC
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: xid9.u64)
            thisTid: ztypes.tid
        )
        return "".string
    }
}

# typeRefC -- the C spelling for a type id: scalars by name, records by
# their id-based cname ("" when unsupported).
# chaseColMono -- if tid is a typedef-class over a collection mono (Bytes ->
# List_u8, ByteView -> ListView_u8), the underlying mono id; else tid. The
# emitter treats Bytes/ByteView as zero-overhead aliases of their collection.
chaseColMono: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out ztypes.tid is {
    bo: symtab.typing.typedefBaseTid.get key: tid
    match (
        bo
    ) case some then {
        if (isCollectionOriginTid
            :ctx
            originTid: (originTidOf :symtab tid: (ztypes.tid.create from: bo.u64))
        ) then return (ztypes.tid.create from: bo.u64)
    } case none then null
    return tid
}

# chaseStrTypedef -- a class typedef over String/StringView (Path, PathView)
# canonicalizes to the base tid: the wrapper shares the base's struct,
# methods, and cleanup. Single-level chase (stdlib typedefs are one level).
chaseStrTypedef: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out ztypes.tid is {
    bo: symtab.typing.typedefBaseTid.get key: tid
    match (
        bo
    ) case some then {
        if bo == ctx.strTid then return ctx.strTid
        if bo == ctx.svTid then return ctx.svTid
    } case none then null
    return tid
}

# the C type expression for a type reference.
typeRefC: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    tid: ztypes.tid
    thisTid: ztypes.tid
} out String is {
    tn: typeNameOfReg9 :symtab :tid
    # A user type shadowing a builtin scalar carries the scalar NAME but not the
    # `is native` declaration -- emit its struct, not the C scalar. scalarCTypeFor
    # is that gate, and the sixteen scalars, `bool` and the shells all come back
    # through it with their C type intact.
    ct: scalarCTypeFor :symtab name: tn.stringview :tid
    if ct.length > 0 then return ct
    # canonicalize shells: a param/field child may be a fresh shell id
    # named after the real type; this-typed params take the receiver.
    cid: tid
    if tn.stringview == "this" when thisTid > 0 then {
        cid = thisTid
        tn = typeNameOfReg9 :symtab tid: cid
    }
    cmid9: chaseColMono :symtab :ctx tid: cid
    if cmid9 != cid then {
        cmc9: ctxCname :ctx tid: (ztypes.tid.create from: cmid9.u64)
        return "\{cmc9}_t"
    }
    cid = ztypes.tid.create from: (chaseStrTypedef :symtab :ctx tid: cid)
    tdc: typedefChaseC :ast :symtab :ctx tid: cid
    if tdc.length > 0 then return tdc
    if cid == ctx.strTid then {
        ts0: "\{ctx.strC}_t"
        return ts0
    }
    if cid == ctx.svTid then {
        ts1: "\{ctx.svC}_t"
        return ts1
    }
    if (isBoxTid :symtab tid: cid) then {
        bxmn9: typeNameOfReg9 :symtab tid: cid
        bxen9: monoElemName full: bxmn9 prefixLen: 4
        bxeid9: resolveTypeIdByName :ast :symtab :ctx name: bxen9.stringview
        bxinner9: (typeRefC
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: bxeid9.u64)
            thisTid: ztypes.tid
        )
        return "\{bxinner9}*"
    }
    if (isCollectionOriginTid :ctx originTid: (originTidOf :symtab tid: cid)) then {
        cc9: ctxCname :ctx tid: cid
        ct9: "\{cc9}_t"
        return ct9
    }
    if (originIsTid :symtab tid: cid originTid: ctx.arrayOriginTid) then {
        aca9: ctxCname :ctx tid: cid
        act9: "\{aca9}_t"
        return act9
    }
    ctt: symtab.reg.typetypeOf typeId: cid
    if ctt == ztypes.ztypetype.recordType then {
        rc: ctxCname :ctx tid: cid
        rt9: "\{rc}_t"
        return rt9
    }
    if ctt == ztypes.ztypetype.variantType then {
        rc2: ctxCname :ctx tid: cid
        rt8: "\{rc2}_t"
        return rt8
    }
    if ctt == ztypes.ztypetype.classType then {
        rc3: ctxCname :ctx tid: cid
        rt7: "\{rc3}_t"
        return rt7
    }
    if ctt == ztypes.ztypetype.unionType then {
        rc4: ctxCname :ctx tid: cid
        rt6: "\{rc4}_t"
        return rt6
    }
    if ctt == ztypes.ztypetype.protocolType then {
        rc5: ctxCname :ctx tid: cid
        rt5: "\{rc5}_t"
        return rt5
    }
    if ctt == ztypes.ztypetype.facetType then {
        rc55: ctxCname :ctx tid: cid
        rt55: "\{rc55}_t"
        return rt55
    }
    if ctt == ztypes.ztypetype.functionType then {
        rcf: ctxCname :ctx tid: cid
        rtf: "\{rcf}_ft"
        return rtf
    }
    return "".string
}

# variantArms -- a variant's arm names and payload ids in order
# (non-FUNCTION children, the tag child excluded).
variantArms: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    tid: ztypes.tid
    names: List String
    ids: ListVal u64
    nameIds: ListVal u64
} is {
    mNms1: (ListVal u64)
    mTds1: (ListVal u64)
    symtab.typing.declMemberList ownerTid: tid names: mNms1 tids: mTds1
    vi1: u64
    vn1: mNms1.length
    for vi1 < vn1 loop {
        vnid1: mNms1.get i: vi1
        vtid1: mTds1.get i: vi1
        vi1 = vi1 + 1
        if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: vtid1.u64)) != ztypes.ztypetype.functionType then {
            if vnid1 != zast.wkTag.u64 then {
                cnBe1: ast.names.texts.get i: vnid1.u64
                cn0: cnBe1.copy
                names.append cn0
                cid0: vtid1
                ids.append cid0
                nid0: vnid1
                nameIds.append nid0
            }
        }
    }
}

# variantTag -- the C tag constant for an arm.
variantTag: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
    arm: StringView
} out String is {
    vn: typeNameOfReg9 :symtab :tid
    vu: cUpperOf text: vn.stringview
    au: cUpperOf text: arm
    t9: "Z_\{vu}_TAG_\{au}"
    return t9
}

# armValueC -- a no-payload arm's VALUE when the tagged type's C form is a
# SCALAR: `bool` lowers to C `bool`, not to a tag struct, so the struct literal
# every caller composes is invalid there. The tag enum is emitted for such
# types and its constants are the arm ordinals, so the value is the constant
# cast to that C form. Returns "" when the type carries a real tag struct --
# callers keep composing it, byte for byte.
armValueC: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
    arm: StringView
} out String is {
    avs9: ordinalVariantCType :symtab :tid
    if avs9.length == 0 then return "".string
    avt9: variantTag :symtab :tid :arm
    avr9: "((\{avs9})\{avt9})"
    return avr9
}

# armPayloadC -- an arm's payload C type ("" for null arms).
armPayloadC: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    tid: ztypes.tid
    arm: StringView
} out String is {
    co: symtab.typing.declChildOf pool: ast.names parentTypeId: tid name: arm
    match (
        co
    ) case some then {
        pn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: co.u64)
        if pn.stringview == "null" then return "".string
        return (typeRefC
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: co.u64)
            thisTid: ztypes.tid
        )
    } case none then {
        return "".string
    }
}

# recFieldLists -- a record type's field names and type ids in order
# (non-FUNCTION children, conformance markers excluded). The filter lives in
# ztypecheck: the C struct layout the emitter lays down and the data-field
# list the checker validates against must agree field for field.
recFieldLists: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    tid: ztypes.tid
    names: (List String).view
    ids: (ListVal u64).view
    nameIds: (ListVal u64).view
} is {
    (ztypecheck.dataFieldNames
        :ast
        st: symtab
        tid: (ztypes.tid.create from: tid.u64)
        :names
        :ids
        :nameIds
    )
}

# regNameIs -- compare a type's registry name without materializing it
# (borrowed typeById view, StringView compare). The none arm mirrors
# comparing against the empty string.
regNameIs: function {symtab: zenv.ZSymbolTable tid: ztypes.tid name: StringView} out bool is {
    return (symtab.reg.nameIs :tid :name)
}

# unitClassTid9 -- the CLASS a unit declares under `nameId`, asked of THAT
# unit's own declarations. Exactly one name is in scope inside a unit, so this
# is a lookup and not a search: it replaces a sweep over every id in the
# registry that text-compared each candidate and then asked which unit defined
# it. 0 when the unit declares no such class.
unitClassTid9: function {
    symtab: zenv.ZSymbolTable.view
    unitDecl: u64
    nameId: zast.nameid
} out ztypes.tid is {
    z9: ztypes.tid
    if unitDecl == 0 then return z9
    d9: (symtab.typing.declFindChild
        parentDeclId: (ztypes.declid.create from: unitDecl)
        :nameId
    )
    if d9.isZero then return z9
    t9: ztypecheck.declTypeIdOf ty: symtab.typing declId: d9
    if t9.isZero then return z9
    if (symtab.reg.typetypeOf typeId: t9) != ztypes.ztypetype.classType then return z9
    return t9
}

# unitDeclByName9 -- the file unit spelled `name`, asked of the ENVIRONMENT:
# the program root's own children, which IS the list of units in scope. A name
# reaches this only from a source literal, a unit segment loadNativeTbl parsed
# out of a natives.tbl path, or the main-unit binding -- identity itself
# travels as a declid. Answering from the declaration tree rather than a side
# index means there is nothing to go stale and nothing silently overwritten
# when two files declare the same unit name.
unitDeclByName9: function {
    symtab: zenv.ZSymbolTable.view
    ast: Ast.view
    name: StringView
} out u64 is {
    return (ztypecheck.unitDeclOfNameId
        ty: symtab.typing
        nameId: (zast.poolFind pool: ast.names text: name)
    ).u64
}

# defUnitIdOf9 -- the DECLARATION of the unit that defines tid (0 when none).
defUnitIdOf9: function {ctx: Ctx.view tid: ztypes.tid} out u64 is {
    g9: ctx.defUnitId.get key: tid
    match (
        g9
    ) case some then {
        return g9
    } case none then {
        return 0
    }
}

# the C type name for registry type `tid`.
typeNameOfReg9: function {symtab: zenv.ZSymbolTable tid: ztypes.tid} out String is {
    return (ztypecheck.regTypeNameOf reg: symtab.reg tid: (ztypes.tid.create from: tid.u64))
}

# pathUnitTidOf9 -- the type id of the unit a dotted path's BASE names, or 0
# when the base names no unit. A file unit answers from the unit-name index; a
# nested namespace is deliberately absent from it, so it is found as a member
# of the unit being emitted, and `outer.inner` by walking that chain by id.
pathUnitTidOf9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    baseId: u32
} out ztypes.tid is {
    if baseId == 0 then return ztypes.tid
    b9: ast.nodes.get i: baseId.u64
    match (
        b9
    ) case expression then {
        return (pathUnitTidOf9 :ast :symtab :ctx baseId: b9.expression)
    } case atomid then {
        # the enclosing unit answers first -- a name written inside a namespace
        # resolves against that namespace before anything wider, and a user
        # unit may shadow a top-level name
        encl9: ctx.nsTid
        if encl9.isZero then encl9 = unitTidOf9 :ast :symtab unitName: ctx.mainName.stringview
        # the nested frames, innermost outward: a path base written inside a
        # unit names that unit's children first, then those of each unit
        # enclosing it -- which is how a sibling inline unit is reached.
        pCur9: ztypecheck.declOfTypeId reg: symtab.reg tid: encl9
        for pCur9 > 0 loop {
            pFt9: ztypecheck.declTypeIdOf ty: symtab.typing declId: pCur9
            if (pFt9.isZero) == false then {
                ph9: unitChildTidOf9 :symtab parentTid: pFt9 nameId: b9.name
                if (ph9.isZero) == false then return ph9
            }
            pNx9: ztypecheck.declParentIdOf ty: symtab.typing declId: pCur9
            pCur9 = ztypes.declid
            if (pNx9.isZero) == false then {
                if (ztypecheck.declDeclaresUnit
                    ty: symtab.typing
                    :ast
                    declId: pNx9
                ) then pCur9 = pNx9
            }
        }
        ht9: unitChildTidOf9 :symtab parentTid: encl9 nameId: b9.name
        if (ht9.isZero) == false then return ht9
        uo9: (ztypecheck.declTypeIdOf
            ty: symtab.typing
            declId: (symtab.typing.declFindChild
                parentDeclId: symtab.typing.programRoot
                nameId: b9.name
            )
        )
        if (uo9.isZero) == false then return (ztypes.tid.create from: uo9)
        return ztypes.tid
    } case dottedpath then {
        pt9: pathUnitTidOf9 :ast :symtab :ctx baseId: b9.parent
        if pt9.isZero then return ztypes.tid
        cn9: zast.nameid
        {
            ca9: ast.nodes.get i: b9.child.u64
            if ca9.atomid then cn9 = ca9.name
        }
        return (unitChildTidOf9 :symtab parentTid: pt9 nameId: cn9)
    } else {
        return ztypes.tid
    }
}

# unitChildTidOf9 -- the id of a member of `parentTid` when that member is
# itself a UNIT, else 0. Both legs of the path walk above ask exactly this, of
# the enclosing unit and of the segment before them.
unitChildTidOf9: function {
    symtab: zenv.ZSymbolTable.view
    parentTid: ztypes.tid
    nameId: zast.nameid
} out ztypes.tid is {
    if nameId.isZero then return ztypes.tid
    co9: symtab.typing.declChildOfId parentTypeId: parentTid :nameId
    match (
        co9
    ) case some then {
        ct9: ztypes.tid.create from: co9.u64
        if (symtab.reg.typetypeOf typeId: ct9) == ztypes.ztypetype.unitType then return ct9
    } case none then null
    return ztypes.tid
}

# unitConstTextOf -- the rendered C text of a `unit.CONST` dotted path, or ""
# when the path names no constant of a known unit. Emission, the constant-shape
# test and the integer fold all ask this one question: a constant that folds
# under a bare name has to fold under this spelling too, and the difference was
# the spelling alone -- the same unit's own constant did not fold either.
unitConstTextOf: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: zast.DottedPathData.view
} out String is {
    cn8: zast.nameid
    {
        ca8: ast.nodes.get i: n.child.u64
        if ca8.atomid then cn8 = ca8.name
    }
    if cn8 > 0 then {
        utd8: pathUnitTidOf9 :ast :symtab :ctx baseId: n.parent
        if (utd8.isZero) == false then {
            # the VALUE is the only source: the emitter no longer renders a
            # constant to text ahead of time and then re-reads that text.
            mct8: (memberConstTextOf9
                :ast
                :symtab
                :ctx
                unitTid: utd8
                nameId: cn8
            )
            if mct8.length > 0 then return mct8
            mcs8: memberConstStrText9 :symtab :ctx unitTid: utd8 nameId: cn8
            if mcs8.length > 0 then return mcs8
            # a constant the unit's `public:` block DEFINES is on the unit's
            # surface, keyed on the block (a nested unit named `public`)
            pbd8: ztypecheck.publicNsOf ty: symtab.typing reg: symtab.reg tid: utd8
            pbt8: ztypecheck.declTypeIdOf ty: symtab.typing declId: pbd8
            if (pbt8.isZero) == false then {
                mcp8: (memberConstTextOf9
                    :ast
                    :symtab
                    :ctx
                    unitTid: pbt8
                    nameId: cn8
                )
                if mcp8.length > 0 then return mcp8
                mcq8: memberConstStrText9 :symtab :ctx unitTid: pbt8 nameId: cn8
                if mcq8.length > 0 then return mcq8
            }
        }
    }
    return "".string
}

# literalSuffixBase -- the builtin scalar name a numeric literal's suffix
# spells: the suffix itself when it already names a builtin scalar, or the
# base a scalar typedef chases to (`1.nameid` -> "u32"). "" when it names
# neither, which is what keeps a non-scalar suffix out of the constant fold.
# The suffix's type comes from the canonical child of the unit ctx is bound
# to -- a constant definition's own nodes carry no stamp to read, and the
# emitter must not re-resolve the name.
literalSuffixBase: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    name: StringView
} out String is {
    sc9: cTypeOf :name
    if sc9.length > 0 then return name.string
    ut9: (ztypecheck.declTypeIdOf
        ty: symtab.typing
        declId: (symtab.typing.declFindChild
            parentDeclId: symtab.typing.programRoot
            nameId: (zast.poolFind pool: ast.names text: ctx.mainName.stringview)
        )
    )
    if ut9.isZero then return "".string
    co9: (symtab.typing.declChildOfId
        parentTypeId: ut9
        nameId: (zast.poolFind pool: ast.names text: name)
    )
    st9: ztypes.tid
    match (
        co9
    ) case some then {
        st9 = (ztypes.tid.create from: co9)
    } case none then {
        return "".string
    }
    bo9: symtab.typing.typedefBaseName.get key: st9
    match (
        bo9
    ) case some then {
        bn9: bo9.copy
        bc9: cTypeOf name: bn9.stringview
        if bc9.length > 0 then return bn9
    } case none then null
    return "".string
}

# checkMainNatives -- drive checkNativesResolve over the main unit. This rode
# inside fillMethodReturns until that table turned out to be unreadable; the
# CHECK was never part of the table's job and stays.
checkMainNatives: function {program: Node ctx: Ctx} is {
    match (
        program
    ) case program then {
        mainName: program.mainUnitName.stringview
        unitName: mainName
        uCnt9c: program.ast.units.length
        uIdx9c: u64
        for uIdx9c < uCnt9c loop {
            uId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9c))
            uIdx9c = uIdx9c + 1
            opId9: zast.nodeid
            {
                u: program.ast.nodes.get i: uId9.u64
                if u.namedoperation then {
                    un: zast.poolTextAt pool: program.ast.names ref: u.name
                    if un.stringview == mainName then opId9 = u.operation
                }
            }
            if opId9 > 0 then {
                (checkNativesResolve
                    ast: program.ast
                    :ctx
                    mainOpId: opId9
                    :unitName
                )
            }
        }
    } else null
}

# checkNativesResolve -- every `is native` declaration in the MAIN unit must
# name a row in natives.tbl. `is native` says the compiler supplies the body, and
# this is where that claim is checked: at the declaration, whether or not anyone
# calls it. Without it an uncalled one is accepted in silence and a called one
# is only found at the call, as an emitter gap rather than as the missing
# implementation it is. The system units are checked whole by
# natives-tbl-guard, which can read every declaration at once; a program can
# only see its own.
checkNativesResolve: function {
    ast: Ast.view
    ctx: Ctx
    mainOpId: zast.nodeid
    unitName: StringView
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: mainOpId
    with biter9: bodyIds9.iterate do for bm9: biter9 loop {
        bn9: ast.nodes.get i: bm9.u64
        if bn9.namedoperation then {
            nm9: zast.nameTextAt :ast ref: bn9.name
            op9: ast.nodes.get i: bn9.operation.u64
            match (
                op9
            ) case functiondef then {
                if op9.isNative then {
                    pk9: "\{unitName}.\{nm9}"
                    if (nativeHasRow :ctx path: pk9.stringview) == false then {
                        (emitFail
                            :ctx
                            what: "no native implementation for '\{pk9}'"
                            line: op9.lineno
                        )
                    }
                }
            } case objectdef then {
                with aiter9: op9.asItems.iterate do for am9: aiter9 loop {
                    amn9: ast.nodes.get i: am9.u64
                    if amn9.namedoperation then {
                        mn9: zast.nameTextAt :ast ref: amn9.name
                        mo9: ast.nodes.get i: amn9.operation.u64
                        match (
                            mo9
                        ) case functiondef then {
                            if mo9.isNative then {
                                mk9: "\{unitName}.\{nm9}.\{mn9}"
                                if (nativeHasRow :ctx path: mk9.stringview) == false then {
                                    (emitFail
                                        :ctx
                                        what: "no native implementation for '\{mk9}'"
                                        line: mo9.lineno
                                    )
                                }
                            }
                        } else null
                    }
                }
            } else null
        }
    }
}

fillDataElems: function {program: Node symtab: zenv.ZSymbolTable.view ctx: Ctx.view} is {
    match (
        program
    ) case program then {
        uCnt9a: program.ast.units.length
        uIdx9a: u64
        for uIdx9a < uCnt9a loop {
            uId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9a))
            uIdx9a = uIdx9a + 1
            opId9: zast.nodeid
            {
                u: program.ast.nodes.get i: uId9.u64
                if u.namedoperation then opId9 = u.operation
            }
            if opId9 > 0 then {
                (fillDataElemsIn
                    :symtab
                    :ctx
                    ast: program.ast
                    mainOpId: opId9
                )
            }
        }
    } else null
}

# populate a data block's element table.
fillDataElemsIn: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    ast: Ast.view
    mainOpId: zast.nodeid
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: mainOpId
    with biter: bodyIds9.iterate do for bm: biter loop {
        bmNode9: ast.nodes.get i: bm.u64
        if bmNode9.namedoperation then {
            dnm: zast.nameTextAt :ast ref: bmNode9.name
            (fillOneDataElem
                :ast
                :symtab
                :ctx
                name: dnm.stringview
                op: (ast.nodes.get i: bmNode9.operation.u64)
            )
        }
    }
}

# populate one data-block element.
fillOneDataElem: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    name: StringView
    op: Node.view
} is {
    match (
        op
    ) case expression then {
        fillOneDataElem :ast :symtab :ctx :name op: (ast.nodes.get i: op.expression.u64)
    } case datablock then {
        ebn: dataElemBaseName :ast oId: op.outType
        dtid9: stampIdOf :symtab nid: op.nodeid.u64
        k9: dtid9
        if ebn.length > 0 then {
            ebv9: ebn.stringview
            ev9: ebv9.string
            ctx.dataElems.set key: k9 value: ev9
        } else {
            iv9: "i64".string
            ctx.dataElems.set key: k9 value: iv9
        }
        idx9: u64
        eiter9: op.elements.iterate
        for e9: eiter9 loop {
            vx9: emitDataElem :ast :symtab :ctx n: (ast.nodes.get i: e9.u64)
            ik9: (dataslotkey owner: dtid9.u64 slot: idx9)
            iv2: vx9.copy
            ctx.dataSlot.set key: ik9 value: iv2
            elbl: dataElemLabel :ast n: (ast.nodes.get i: e9.u64)
            if elbl.length > 0 then {
                lk9: (dataconstkey
                    owner: dtid9.u64
                    name: (zast.poolFind pool: ast.names text: elbl.stringview).u64
                )
                lv9: vx9.copy
                ctx.dataConst.set key: lk9 value: lv9
            }
            idx9 = idx9 + 1
        }
    } else null
}

# the label of data-block element `n`.
dataElemLabel: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case namedoperation then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# scan the program for the runtime helpers it needs.
fillNeeds: function {program: Node symtab: zenv.ZSymbolTable ctx: Ctx.view} is {
    match (
        program
    ) case program then {
        uCnt9b: program.ast.units.length
        uIdx9b: u64
        for uIdx9b < uCnt9b loop {
            uId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9b))
            uIdx9b = uIdx9b + 1
            opId9: zast.nodeid
            un9: String
            {
                u: program.ast.nodes.get i: uId9.u64
                if u.namedoperation then {
                    un: zast.poolTextAt pool: program.ast.names ref: u.name
                    opId9 = u.operation
                    un9 = un.copy
                }
            }
            if opId9 > 0 then {
                (fillNeedsIn
                    :symtab
                    :ctx
                    ast: program.ast
                    unitName: un9.stringview
                    mainOpId: opId9
                )
            }
        }
    } else null
}

# scan one unit for the runtime helpers it needs.
fillNeedsIn: function {
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    ast: Ast.view
    unitName: StringView
    mainOpId: zast.nodeid
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: mainOpId
    with biter: bodyIds9.iterate do for bm: biter loop {
        bmNode9: ast.nodes.get i: bm.u64
        if bmNode9.namedoperation then {
            # a body that will not be emitted must not register needs either:
            # a runtime fragment pulled in by dead code carries the signature
            # types that code named, and nothing minted them.
            fnn9: zast.nameTextAt :ast ref: bmNode9.name
            if (stdFnUndemanded
                :ast
                :symtab
                :unitName
                fnName: fnn9.stringview
                ownerTid: ztypes.tid
                wantWalked: true
            ) == false then {
                (scanNeeds
                    :ast
                    :symtab
                    :ctx
                    :unitName
                    n: (ast.nodes.get i: bmNode9.operation.u64)
                )
            }
        }
    }
}

# scanNativeNeed9 -- register the unit + `<unit>_<member>` needs behind a
# callee that RESOLVES to a native declaration. The discriminator is the
# resolved declaration and the unit that declares it, never the spelling of
# the base atom: a user unit named `os` declares bodied functions, so it
# resolves to nothing native and gates no fragment, while a native reached
# through any spelling is recorded under the unit that declares it.
scanNativeNeed9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    unitName: StringView
    baseId: zast.nameid
    base: StringView
    membId: zast.nameid
    memb: StringView
} is {
    fid9: ztypes.tid
    if baseId.isZero == false when memb.length > 0 then {
        # a qualified path names a unit only when the base IS one: a program
        # may declare a TYPE with a runtime unit's name (a variant `io` with a
        # `stdout` arm), and `io.stdout` there constructs an arm rather than
        # reaching the native. Name ids are pooled program-wide, so resolving
        # the child without this gate would find the stdlib declaration.
        if (ztypecheck.isUnitNameDecl
            ty: symtab.typing
            reg: symtab.reg
            nameId: baseId
        ) == false then return
        # ... but a DECLARATION of that name in the scanning unit shadows it:
        # a variant `io` with a `stdout` arm makes `io.stdout` an arm
        # construction, and the unit probe still answers because name ids are
        # pooled program-wide.
        uq3z9: ztypecheck.unitDeclOfName ty: symtab.typing :ast name: unitName
        sh9: (ztypecheck.resolveUnitChild
            :ast
            ty: symtab.typing
            reg: symtab.reg
            unitDecl: uq3z9
            name: base
        )
        match (
            sh9
        ) case some then {
            shT9: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: sh9)
            if shT9 != ztypes.ztypetype.unitType then return
        } case none then null
        ud8x9: ztypecheck.unitDeclOfNameId ty: symtab.typing nameId: baseId
        fo9: (ztypecheck.resolvedByIds
            :ast
            ty: symtab.typing

            unitDecl: ud8x9
            name: membId
        )
        match (
            fo9
        ) case some then {
            fid9 = ztypes.tid.create from: (fo9)
        } case none then return
    } else {
        if memb.length == 0 then return
        uq4z9: ztypecheck.unitDeclOfName ty: symtab.typing :ast name: unitName
        go9: (ztypecheck.resolveUnitChild
            :ast
            ty: symtab.typing
            reg: symtab.reg
            unitDecl: uq4z9
            name: memb
        )
        match (
            go9
        ) case some then {
            fid9 = ztypes.tid.create from: (go9)
        } case none then return
    }
    if fid9.isZero then return
    if (symtab.reg.typetypeOf typeId: fid9) != ztypes.ztypetype.functionType then return
    if (fnIsNativeId :symtab fid: fid9) == false then return
    duo9: definedInUnitOf :symtab tid: fid9
    match (
        duo9
    ) case some then {
        needsAddM :ctx uname: duo9.stringview memb: "@unit"
        needsAddM :ctx uname: duo9.stringview :memb
    } case none then null
}

# scanNeeds -- recursively register io/os native needs for every call in a
# def/body. Structurally mirrors collectLiterals; emitFns registers free-fn
# needs ahead of the runtime pass, but type-method bodies emit afterwards (via
# emitRecordDefs), so a native used only inside a method (e.g. io.stat in
# zvfs's providers) would never have its runtime body emitted. A callee that
# RESOLVES to a native declaration registers the unit that declares it plus
# `<unit>_<member>`; a callee that resolves to anything else registers
# nothing, so a user unit named io or os gates no fragment.
scanNeeds: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    unitName: StringView
    n: Node.view
} is {
    match (
        n
    ) case functiondef then {
        if n.body > 0 then (scanNeeds
            :ast
            :symtab
            :ctx
            :unitName
            n: (ast.nodes.get i: n.body.u64)
        )
    } case objectdef then {
        with aiter: n.asItems.iterate do for amId9: aiter loop {
            am: ast.nodes.get i: amId9.u64
            match (
                am
            ) case namedoperation then {
                scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: am.operation.u64)
            } else null
        }
        with iiter: n.isItems.iterate do for imId9: iiter loop {
            im: ast.nodes.get i: imId9.u64
            match (
                im
            ) case namedoperation then {
                scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: im.operation.u64)
            } else null
        }
    } case statement then {
        siter: n.statements.iterate
        for sId9: siter loop (scanNeeds
            :ast
            :symtab
            :ctx
            :unitName
            n: (ast.nodes.get i: sId9.u64)
        )
    } case statementline then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.statementline.u64)
    } case expression then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.expression.u64)
    } case namedoperation then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.operation.u64)
    } case call then {
        mn0: dottedChildText :ast n: (ast.nodes.get i: n.callable.u64)
        cbi0: dottedBaseAtomId :ast n: (ast.nodes.get i: n.callable.u64)
        cbt0: dottedBaseAtom :ast n: (ast.nodes.get i: n.callable.u64)
        cmb0: mn0.copy
        if cbi0.isZero then {
            cmb0 = atomTextOf :ast n: (ast.nodes.get i: n.callable.u64)
        }
        (scanNativeNeed9
            :ast
            :symtab
            :ctx
            :unitName
            baseId: cbi0
            base: cbt0.stringview
            membId: (dottedChildNameIdOf :ast n: (ast.nodes.get i: n.callable.u64))
            memb: cmb0.stringview
        )
        if (isSvArgNative name: mn0.stringview) then (needsAddM
            :ctx
            uname: "system"
            memb: mn0.stringview
        )
        if (isSvSimpleNative name: mn0.stringview) then (needsAddM
            :ctx
            uname: "system"
            memb: mn0.stringview
        )
        # substring emits through its own leg (recv/from/to), so the arg-native
        # table cannot carry it; the need still must pre-register for method
        # bodies, which emit after the runtime pass runs
        if mn0.stringview == "substring" then needsAddM :ctx uname: "system" memb: "substring"
        if (isSvParseNative name: mn0.stringview) then (needsAddM
            :ctx
            uname: "system"
            memb: mn0.stringview
        )
        if (isSvNoArgNative name: mn0.stringview) then (needsAddM
            :ctx
            uname: "system"
            memb: mn0.stringview
        )
        # split/lines emit through the iterator fragments (Splitter/LinesIter),
        # so the native tables cannot carry them; the sv_* needs still must
        # pre-register for method bodies, which emit after the runtime pass runs
        if mn0.stringview == "split" then needsAddM :ctx uname: "sviter" memb: "sv_split"
        if mn0.stringview == "lines" then needsAddM :ctx uname: "sviter" memb: "sv_lines"
        cjn0: atomTextOf :ast n: (ast.nodes.get i: n.callable.u64)
        if cjn0.stringview == "stringJoin" then (needsAddM
            :ctx
            uname: "collections"
            memb: "coll_join"
        )
        aiter2: n.arguments.iterate
        for a: aiter2 loop scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: a.u64)
    } case dottedpath then {
        pdm9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if pdm9.stringview == "parseF64" then needsAddM :ctx uname: "system" memb: "parseF64"
        if pdm9.stringview == "parseF16" then needsAddM :ctx uname: "system" memb: "parseF16"
        if pdm9.stringview == "parseF128" then needsAddM :ctx uname: "system" memb: "parseF128"
        if pdm9.stringview == "parseI64" then needsAddM :ctx uname: "system" memb: "parseI64"
        if pdm9.stringview == "parseU64" then needsAddM :ctx uname: "system" memb: "parseU64"
        if (isSvNoArgNative name: pdm9.stringview) then (needsAddM
            :ctx
            uname: "system"
            memb: pdm9.stringview
        )
        # a no-paren member read auto-calls, so the simple natives (trim,
        # isEmpty, ...) arrive as dottedpath too -- same parity the call arm has
        if (isSvSimpleNative name: pdm9.stringview) then (needsAddM
            :ctx
            uname: "system"
            memb: pdm9.stringview
        )
        if pdm9.stringview == "lines" then needsAddM :ctx uname: "sviter" memb: "sv_lines"
        # a no-paren member read auto-calls, so a zero-parameter native (os.pid,
        # io.stdout) arrives here rather than at the call arm
        pdb9: atomTextOf :ast n: (ast.nodes.get i: n.parent.u64)
        (scanNativeNeed9
            :ast
            :symtab
            :ctx
            :unitName
            baseId: (atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
            base: pdb9.stringview
            membId: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
            memb: pdm9.stringview
        )
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.parent.u64)
    } case binop then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.lhs.u64)
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.rhs.u64)
    } case assignment then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.value.u64)
    } case reassignment then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.value.u64)
    } case ifexpr then {
        citer: n.clauses.iterate
        for cId9: citer loop (scanNeeds
            :ast
            :symtab
            :ctx
            :unitName
            n: (ast.nodes.get i: cId9.u64)
        )
        if n.elseclause > 0 then (scanNeeds
            :ast
            :symtab
            :ctx
            :unitName
            n: (ast.nodes.get i: n.elseclause.u64)
        )
    } case caseexpr then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.subject.u64)
        miter9: n.clauses.iterate
        for mc9Id9: miter9 loop (scanNeeds
            :ast
            :symtab
            :ctx
            :unitName
            n: (ast.nodes.get i: mc9Id9.u64)
        )
        if n.elseclause > 0 then (scanNeeds
            :ast
            :symtab
            :ctx
            :unitName
            n: (ast.nodes.get i: n.elseclause.u64)
        )
    } case caseclause then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.statement.u64)
    } case ifclause then {
        kiter: n.conditions.iterate
        for kId9: kiter loop (scanNeeds
            :ast
            :symtab
            :ctx
            :unitName
            n: (ast.nodes.get i: kId9.u64)
        )
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.statement.u64)
    } case withexpr then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.value.u64)
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.body.u64)
    } case doexpr then {
        scanNeeds :ast :symtab :ctx :unitName n: (ast.nodes.get i: n.statement.u64)
    } case forexpr then {
        fiter: n.conditions.iterate
        for fId9: fiter loop (scanNeeds
            :ast
            :symtab
            :ctx
            :unitName
            n: (ast.nodes.get i: fId9.u64)
        )
        if n.body > 0 then (scanNeeds
            :ast
            :symtab
            :ctx
            :unitName
            n: (ast.nodes.get i: n.body.u64)
        )
    } else null
}


# emitFns -- the main unit's function declarations then definitions
# (two-phase index walk so the body list is free during emission).
# isEmittableFileUnit -- a user FILE unit (main or a dependency) whose defs are
# emitted as zerolang C; system library units (their types ride the registry
# sweeps, their fns are native fragments) are skipped.
isEmittableFileUnit: function {name: StringView} out bool is {
    if name == "system" then return false
    if name == "core" then return false
    if name == "collections" then return false
    if name == "io" then return false
    if name == "os" then return false
    if name == "cli" then return false
    return true
}

# isEmittableUnitFns -- every file unit's bodied FREE functions emit,
# including the runtime-backed stdlib units (their TYPES stay excluded
# via isEmittableFileUnit; the per-member body filter in emitFnsIn keeps
# native declarations and type members out).
isEmittableUnitFns: function {name: StringView} out bool is {
    if name.length == 0 then return false
    return true
}

# stdFnUndemanded -- a bodied free fn the program never referenced: its def was
# not resolved, so its body carries no stamps and emitting it renders the
# signature as `z_t0(void)` over unbound parameter names. Skip it everywhere
# (definition, needs pre-scan, literal pooling). Whether the fn resolved is a
# fact about the DEFINITION, not about which unit declares it: a demand-gated
# unit and an emittable one both leave an unreferenced body unresolved, and
# only the eager pass hid that for the second. ownerTid names the enclosing
# namespace / subunit type for a nested fn -- its members are children of IT,
# so the unit-root key below misses them and would drop a fn that IS used.
stdFnUndemanded: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    unitName: StringView
    fnName: StringView
    ownerTid: ztypes.tid
    # ask whether the body was WALKED, not merely resolved. Only the definition
    # pass may: the literal pool has to cover everything that might be emitted,
    # including a generic template unit's monos, whose template is never walked
    # under its own name.
    wantWalked: bool
} out bool is {
    if (ownerTid.isZero) == false then {
        co9: (symtab.typing.declChildOfId
            parentTypeId: ownerTid
            nameId: (zast.poolFind pool: ast.names text: fnName)
        )
        match (
            co9
        ) case some then {
            return false
        } case none then {
            return true
        }
    }
    ud9x9: (ztypecheck.unitDeclOfNameId
        ty: symtab.typing
        nameId: (zast.poolFind pool: ast.names text: unitName)
    )
    ro9: (ztypecheck.resolvedByIds
        :ast
        ty: symtab.typing

        unitDecl: ud9x9
        name: (zast.poolFind pool: ast.names text: fnName)
    )
    rres9: false
    match (
        ro9
    ) case some then {
        rres9 = true
    } case none then null
    if (rres9) == false then return true
    # resolved is not enough: emitting a body that was never WALKED emits code
    # whose types were never minted -- a resolved but unwalked json.at emitted
    # a call whose return spec nothing ever created, `z_t0_t`. The walk is what
    # stamps a body, so being walked is the honest question. The main unit is
    # walked in full and keeps no such mark.
    if (wantWalked) == false then return false
    if unitName == symtab.reg.regMainUnit.stringview then return false
    ud10x9: (ztypecheck.unitDeclOfNameId
        ty: symtab.typing
        nameId: (zast.poolFind pool: ast.names text: unitName)
    )
    wd9: (ztypecheck.declOfUnitDefIds
        ty: symtab.typing
        unitDecl: ud10x9
        nameId: (zast.poolFind pool: ast.names text: fnName)
    )
    return (symtab.typing.declIsWalked declId: wd9) == false
}

# isGenericTemplateUnitOp -- a file unit that is a generic template (declares a
# bare `t: Any.generic` member). Its raw functions reference the unbound type
# param, so they are not emitted directly; emitUnitMonoInstances emits one
# concrete C function per (instantiation, method) instead.
isGenericTemplateUnitOp: function {ast: Ast.view opId: u32} out bool is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: opId
    mit9: bodyIds9.iterate
    for m9: mit9 loop {
        m9Node9: ast.nodes.get i: m9.u64
        if m9Node9.namedoperation then {
            if (ztypecheck.isGenericParam
                :ast
                op: (ast.nodes.get i: m9Node9.operation.u64)
            ) then return true
        }
    }
    return false
}

# emitUnitMonoInstances -- emit the monomorphized methods of a generic file unit
# (genmath instantiated as intmath: i64, i32math: i32). For each registry UNIT
# type whose generic origin is this template, emit one C function per template
# method keyed by the mono's concrete FUNCTION child id (so the signature carries
# the substituted types); the body AST is the template method itself (lock-safe:
# its root is the program AST, not symtab, so emitFnBody can borrow symtab).
emitUnitMonoInstances: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    templateName: StringView
    templateUnitOpId: u32
    declOnly: bool
    buf: String.borrow
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: templateUnitOpId
    tplId9: u64
    tk9: templateName
    tgo9: (ztypecheck.declTypeIdOf
        ty: symtab.typing
        declId: (symtab.typing.declFindChild
            parentDeclId: symtab.typing.programRoot
            nameId: (zast.poolFind pool: ast.names text: tk9)
        )
    )
    if (tgo9.isZero) == false then tplId9 = tgo9
    if tplId9 == 0 then {
        sgo9: u64
        rid9: u32
        {
            tuo9: ast.nodes.get i: templateUnitOpId.u64
            if tuo9.unitdef then rid9 = tuo9.nodeid
        }
        if rid9 > 0 then sgo9 = stampIdOf :symtab nid: rid9.u64
        if sgo9 > 0 then tplId9 = sgo9
    }
    if tplId9 == 0 then return
    last9: symtab.reg.nextTypeId
    t9: u64
    for t9 < last9 loop {
        isMono9: false
        if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: t9.u64)) == ztypes.ztypetype.unitType then {
            go9opt: symtab.reg.genericOriginOf tid: (ztypes.tid.create from: t9.u64)
            if go9opt.u64 == tplId9 when go9opt > 0 then isMono9 = true
        }
        if isMono9 then {
            {
                fit9: bodyIds9.iterate
                for fm9: fit9 loop {
                    fm9Node9: ast.nodes.get i: fm9.u64
                    match (
                        fm9Node9
                    ) case namedoperation then {
                        if (isFunctionDefWithBody9 n: (ast.nodes.get i: fm9Node9.operation.u64)) then {
                            mname9: zast.nameTextAt :ast ref: fm9Node9.name
                            cfo9: (symtab.typing.declChildOf
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: t9.u64)
                                name: mname9.stringview
                            )
                            match (
                                cfo9
                            ) case some then {
                                cfid9: cfo9
                                if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: cfid9.u64)) == ztypes.ztypetype.functionType then {
                                    fnm9: (typeNameOfReg9
                                        :symtab
                                        tid: (ztypes.tid.create from: cfid9.u64)
                                    )
                                    sig9: (fnSignature
                                        :ast
                                        :symtab
                                        :ctx
                                        name: fnm9.stringview
                                        fid: (ztypes.tid.create from: cfid9.u64)
                                        op: (ast.nodes.get i: fm9Node9.operation.u64)
                                    )
                                    if declOnly then {
                                        ld9: "\{sig9};\n"
                                        buf.append ld9
                                    } else {
                                        lo9: "\{sig9} {\n"
                                        buf.append lo9
                                                                                ctx.ptrVids = (ListVal ztypes.vid)
                                        ctx.aliases = (List VidVal)
                                        ctx.narrowBox = (List VidVal)
                                        ctx.narrowTid = (List VidTid)
                                        ctx.exclArms = (List VidVal)
                                        ctx.exclTids = (List VidTid)
                                        (registerReftypeParams
                                            :ast
                                            :symtab
                                            :ctx
                                            fid: (ztypes.tid.create from: cfid9.u64)
                                            op: (ast.nodes.get i: fm9Node9.operation.u64)
                                        )
                                        ctx.curThisTid = ztypes.tid.create from: (t9)
                                        (emitFnBody
                                            :ast
                                            :symtab
                                            :ctx
                                            op: (ast.nodes.get i: fm9Node9.operation.u64)
                                            fid: (ztypes.tid.create from: cfid9.u64)
                                            :buf
                                        )
                                        ctx.curThisTid = ztypes.tid.create from: (0)
                                        buf.append "}\n\n"
                                    }
                                }
                            } case none then null
                        }
                    } else null
                }
            }
        }
        t9 = t9 + 1
    }
}

# emitFnsPass -- one declOnly-parameterized sweep over every emittable file
# unit, routing generic template units to their mono instances and plain units
# to emitFnsIn. ctx.mainName is rebound to each unit for the duration.
emitFnsPass: function {
    program: Node
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    declOnly: bool
    buf: String.borrow
} is {
    match (
        program
    ) case program then {
        uCnt9e: program.ast.units.length
        uIdx9e: u64
        for uIdx9e < uCnt9e loop {
            uId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9e))
            uIdx9e = uIdx9e + 1
            opId9: zast.nodeid
            un9: String
            un9Id: zast.nameid
            {
                u: program.ast.nodes.get i: uId9.u64
                if u.namedoperation then {
                    un: zast.poolTextAt pool: program.ast.names ref: u.name
                    if (isEmittableUnitFns name: un.stringview) then {
                        opId9 = u.operation
                        un9 = un.copy
                        un9Id = u.name
                    }
                }
            }
            if opId9 > 0 then {
                sm: ctx.mainName.copy
                smD9: ctx.mainUnitId
                (ctxBindMain
                    :ctx
                    name: un9.stringview
                    unitDecl: (ztypecheck.unitDeclOfNameId ty: symtab.typing nameId: un9Id).u64
                )
                isTpl9: isGenericTemplateUnitOp ast: program.ast opId: opId9
                if isTpl9 then {
                    (emitUnitMonoInstances
                        :symtab
                        ast: program.ast
                        :ctx
                        templateName: un9.stringview
                        templateUnitOpId: opId9
                        :declOnly
                        :buf
                    )
                } else {
                    (emitFnsIn
                        :symtab
                        :ctx
                        ast: program.ast
                        mainOpId: opId9
                        ownerTid: ztypes.tid
                        :declOnly
                        :buf
                    )
                }
                ctxBindMain :ctx name: sm.stringview unitDecl: smD9
            }
        }
    } else null
}

# emit every function definition in the program.
emitFns: function {
    program: Node.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    buf: String.borrow
} is {
    # every file unit's fn DECLARATIONS first, then every file unit's
    # DEFINITIONS -- a main-unit body may call a dep-unit fn declared
    # earlier (and vice versa).
    emitFnsPass :program :symtab :ctx declOnly: true :buf
    emitFnsPass :program :symtab :ctx declOnly: false :buf
}

# emitFnMonoInstances -- emit the monomorphized instances of a generic free
# function (identity_i64, identity_f64, first_i64_f64, ...). Each instance was
# minted by the typechecker (mintMono, params already substituted); emit one C
# function per registry FUNCTION whose generic origin is this template, keyed by
# the mono FUNCTION id (concrete signature) with the template body AST (lock-safe:
# the body AST root is the program, not symtab).
emitFnMonoInstances: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    templateFnId: u64
    templateFnOp: Node.view
    declOnly: bool
    buf: String.borrow
} is {
    last9: symtab.reg.nextTypeId
    t9: ztypes.tid
    for t9 < last9 loop {
        isMono9: false
        if (symtab.reg.typetypeOf typeId: t9) == ztypes.ztypetype.functionType then {
            go9opt: symtab.reg.genericOriginOf tid: t9
            if go9opt.u64 == templateFnId when go9opt > 0 then isMono9 = true
        }
        if isMono9 then {
            fnm9: typeNameOfReg9 :symtab tid: t9
            sig9: (fnSignature
                :ast
                :symtab
                :ctx
                name: fnm9.stringview
                fid: (ztypes.tid.create from: t9.u64)
                op: templateFnOp
            )
            if declOnly then {
                ld9: "\{sig9};\n"
                buf.append ld9
            } else {
                lo9: "\{sig9} {\n"
                buf.append lo9
                                ctx.ptrVids = (ListVal ztypes.vid)
                ctx.aliases = (List VidVal)
                ctx.narrowBox = (List VidVal)
                ctx.narrowTid = (List VidTid)
                ctx.exclArms = (List VidVal)
                ctx.exclTids = (List VidTid)
                (registerReftypeParams
                    :ast
                    :symtab
                    :ctx
                    fid: (ztypes.tid.create from: t9.u64)
                    op: templateFnOp
                )
                ctx.curThisTid = ztypes.tid.create from: t9.u64
                (emitFnBody
                    :ast
                    :symtab
                    :ctx
                    op: templateFnOp
                    fid: (ztypes.tid.create from: t9.u64)
                    :buf
                )
                ctx.curThisTid = ztypes.tid.create from: (0)
                buf.append "}\n\n"
            }
        }
        t9 = ztypes.tid.create from: (t9 + 1)
    }
}

# emit a unit's function definitions.
emitFnsIn: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    mainOpId: zast.nodeid
    # the unit whose functions these are: 0 for the file unit ctx is bound to,
    # whose children the name-keyed lookup below already answers for, and the
    # namespace's own type id for a nested unit -- whose functions are children
    # of IT, so resolving them against the file unit misses and hands the
    # signature a tid of 0, which renders as `z_t0(void)`.
    ownerTid: ztypes.tid
    declOnly: bool
    buf: String.borrow
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: mainOpId
    {
        with iuit9: bodyIds9.iterate do for ium9Id9: iuit9 loop {
            ium9: ast.nodes.get i: ium9Id9.u64
            if ium9.namedoperation then {
                iuOpId9: ium9.operation
                if (isGenericTemplateUnitOp :ast opId: iuOpId9) then {
                    iunm9: zast.nameTextAt :ast ref: ium9.name
                    (emitUnitMonoInstances
                        :symtab
                        :ast
                        :ctx
                        templateName: iunm9.stringview
                        templateUnitOpId: iuOpId9
                        :declOnly
                        :buf
                    )
                }
                isNs9: false
                if (zast.unitOpDeclaresUnit :ast opId: iuOpId9) then isNs9 = true
                # a `public:` block that DEFINES no function of its own has
                # nothing to emit here (its entries name the unit's siblings)
                if isNs9 when (zast.unitOpKindIs
                    :ast
                    opId: iuOpId9
                    k: zast.unitkind.publicNs
                ) then {
                    if (unitOpHasBodiedFn9 :ast opId: iuOpId9) == false then isNs9 = false
                }
                if isNs9 then {
                    nsTid9: ztypes.tid
                    {
                        ownr9: ownerTid
                        if ownr9.isZero then {
                            ownr9 = unitTidOf9 :ast :symtab unitName: ctx.mainName.stringview
                        }
                        no9: symtab.typing.declChildOfId parentTypeId: ownr9 nameId: ium9.name
                        match (
                            no9
                        ) case some then {
                            nsTid9 = ztypes.tid.create from: (no9)
                        } case none then null
                    }
                    if (nsTid9.isZero) == false then {
                        sns9: ctx.nsTid
                        ctx.nsTid = nsTid9
                        (emitFnsIn
                            :ast
                            :symtab
                            :ctx
                            mainOpId: (zast.nodeid.create from: iuOpId9)
                            ownerTid: nsTid9
                            :declOnly
                            :buf
                        )
                        ctx.nsTid = sns9
                    }
                }
            }
        }
        idxs: (ListVal u64)
        names: (List String)
        di: u64
        with biter: bodyIds9.iterate do for bmId9: biter loop {
            bm: ast.nodes.get i: bmId9.u64
            match (
                bm
            ) case namedoperation then {
                if (isFunctionDefWithBody9 n: (ast.nodes.get i: bm.operation.u64)) then {
                    nm: zast.nameTextCopy :ast ref: bm.name
                    skipDepMain: false
                    # a runtime-backed unit's bodied fn only emits when the
                    # program referenced it (undemanded bodies carry no stamps)
                    if (stdFnUndemanded
                        :ast
                        :symtab
                        unitName: ctx.mainName.stringview
                        fnName: nm.stringview
                        :ownerTid
                        wantWalked: true
                    ) then skipDepMain = true
                    if nm.stringview == "main" then {
                        if ctx.mainName.stringview != ctx.realMain.stringview then {
                            skipDepMain = true
                        }
                    }
                    if (skipDepMain) == false then {
                        dv: di
                        idxs.append dv
                        names.append nm
                    }
                }
            } else null
            di = di + 1
        }
        wn: idxs.length
        wi: u64
        for wi < wn loop {
            nm2: names.get i: wi
            didx: idxs.get i: wi
            dm2Id9: bodyIds9.get i: didx
            dm2: ast.nodes.get i: dm2Id9.u64
            match (
                dm2
            ) case namedoperation then {
                fid: ztypes.tid
                if ownerTid.isZero then {
                    fid = userFnId :ast :symtab :ctx name: nm2.stringview
                } else {
                    fo9: (symtab.typing.declChildOfId
                        parentTypeId: ownerTid
                        nameId: (zast.poolFind pool: ast.names text: nm2.stringview)
                    )
                    match (
                        fo9
                    ) case some then {
                        fid = ztypes.tid.create from: (fo9)
                    } case none then null
                }
                isGenFn9: false
                if fid > 0 then {
                    if (isGenericType :symtab tid: fid) then {
                        if (symtab.reg.typetypeOf typeId: fid) == ztypes.ztypetype.functionType then {
                            isGenFn9 = true
                        }
                    }
                }
                if isGenFn9 then {
                    (emitFnMonoInstances
                        :ast
                        :symtab
                        :ctx
                        templateFnId: fid
                        templateFnOp: (ast.nodes.get i: dm2.operation.u64)
                        :declOnly
                        :buf
                    )
                } else {
                    sig: (fnSignature
                        :ast
                        :symtab
                        :ctx
                        name: nm2.stringview
                        :fid
                        op: (ast.nodes.get i: dm2.operation.u64)
                    )
                    if declOnly then {
                        ld: "\{sig};\n"
                        buf.append ld
                    } else {
                        lo: "\{sig} {\n"
                        buf.append lo
                                                ctx.ptrVids = (ListVal ztypes.vid)
                        ctx.aliases = (List VidVal)
                        ctx.narrowBox = (List VidVal)
                        ctx.narrowTid = (List VidTid)
                        ctx.exclArms = (List VidVal)
                        ctx.exclTids = (List VidTid)
                        (registerReftypeParams
                            :ast
                            :symtab
                            :ctx
                            :fid
                            op: (ast.nodes.get i: dm2.operation.u64)
                        )
                        (emitFnBody
                            :ast
                            :symtab
                            :ctx
                            op: (ast.nodes.get i: dm2.operation.u64)
                            :fid
                            :buf
                        )
                        buf.append "}\n\n"
                    }
                }
            } else null
            wi = wi + 1
        }
        if declOnly then buf.append "\n"
    }
}

# unitOpHasBodiedFn9 -- does the unit body at `opId` define a function with a
# body among its own entries?
unitOpHasBodiedFn9: function {ast: Ast.view opId: u32} out bool is {
    ids9: zast.unitBodyIdsAt :ast unitId: opId
    with it9: ids9.iterate do for mId9: it9 loop {
        m9: ast.nodes.get i: mId9.u64
        if m9.namedoperation then {
            if (isFunctionDefWithBody9 n: (ast.nodes.get i: m9.operation.u64)) then return true
        }
    }
    return false
}

# true when `n` is a function definition that has a body.
isFunctionDefWithBody9: function {n: Node.view} out bool is {
    match (
        n
    ) case functiondef then {
        return n.body > 0
    } else {
        return false
    }
}

# strHasSub -- substring containment with a dynamic needle, routed through a
# StringView receiver: the emitter resolves .contains on a param, not on a
# for-loop iterate element used directly as a method-call receiver.
strHasSub: function {hay: StringView needle: StringView} out bool is {
    return (hay.contains :needle)
}

# isBareCName -- true if s is a plain C identifier (only [A-Za-z0-9_]); such a
# return value is a bare local whose scope cleanup can safely run before the
# return. A compound expression (call / deref / field / cast) must be hoisted
# into a temp first, handled separately.
isBareCName: function {s: StringView} out bool is {
    if s.length == 0 then return false
    i: u64
    for i < s.length loop {
        bo: s.byteAt i
        match (
            bo
        ) case some then {
            ok: false
            if bo >= 48 when bo <= 57 then ok = true
            if bo >= 65 when bo <= 90 then ok = true
            if bo >= 97 when bo <= 122 then ok = true
            if bo == 95 then ok = true
            if (ok) == false then return false
        } case none then {
            return false
        }
        i = i + 1
    }
    return true
}

# cSlotName -- a member name as a C identifier for an interface vtable slot.
# An OPERATOR member (`==`, `<=`, ...) is not a C identifier: a facet or
# protocol declaring `==` would emit `bool (*==)(void*, T);`, which gcc
# rejects. The operator spelling comes from opCnameOf, the same table the
# implementation's own C name is built from, so the struct field, the wrapper
# name, the vtable row and the dispatch site cannot drift apart -- they are
# four spellings of one slot, and one table is what makes that true.
#
# The fallback is byte-wise so any operator the table misses still yields a
# unique, deterministic identifier rather than colliding with another one.
cSlotName: function {name: StringView} out String is {
    if (isBareCName s: name) then return name.string
    op9: opCnameOf :name
    if op9.length > 0 then return op9
    out9: "op".string
    i9: u64
    for i9 < name.length loop {
        bo9: name.byteAt i9
        match (
            bo9
        ) case some then {
            seg9: "_\{bo9}"
            out9.append seg9
        } case none then null
        i9 = i9 + 1
    }
    return out9
}

# optU8Or -- an (optionval u8) to a plain u8 with a default.
optU8Or: function {o: optionval u8 d: u8} out u8 is {
    match (
        o
    ) case some then {
        return o
    } case none then {
        return d
    }
}

# ctEndsWithStar -- true if the C type string ends in '*' (a pointer return:
# union, protocol, Map/Set, or a user reftype passed by reference). Takes a `ct`
# param so `.length`/`.byteAt` emit as field/method ops (a chained `.stringview`
# receiver mis-emits a free function call).
ctEndsWithStar: function {ct: StringView} out bool is {
    if ct.length == 0 then return false
    lb: optU8Or o: (ct.byteAt (ct.length - 1)) d: 0
    if lb == 42 then return true
    return false
}

# isIdChar -- a C-identifier byte [A-Za-z0-9_].
isIdChar: function {b: u8} out bool is {
    if b >= 48 when b <= 57 then return true
    if b >= 65 when b <= 90 then return true
    if b >= 97 when b <= 122 then return true
    if b == 95 then return true
    return false
}

# refsLocal -- true if `name` occurs in `expr` as a maximal C identifier (bounded
# by non-identifier bytes). A local referenced in the return expression is part of
# (or borrowed by) the return value, so it must NOT be freed before the return.
refsLocal: function {expr: StringView name: StringView} out bool is {
    nl: name.length
    el: expr.length
    if nl == 0 then return false
    if nl > el then return false
    i: u64
    for i + nl <= el loop {
        eq: true
        k: u64
        for k < nl loop {
            ebv: optU8Or o: (expr.byteAt (i + k)) d: 0
            nbv: optU8Or o: (name.byteAt k) d: 1
            if ebv != nbv then eq = false
            k = k + 1
        }
        if eq then {
            beforeOk: true
            if i > 0 then {
                if (isIdChar b: (optU8Or o: (expr.byteAt (i - 1)) d: 0)) then beforeOk = false
            }
            afterOk: true
            ep: i + nl
            if ep < el then {
                if (isIdChar b: (optU8Or o: (expr.byteAt ep) d: 0)) then afterOk = false
            }
            if beforeOk when afterOk then return true
        }
        i = i + 1
    }
    return false
}

# isRegisteredOwned -- true if `name` is a registered owned local (a String in
# tmp.frees or a collection/class in tmp.listFreeVars). Decides whether a value
# moved into an inline construction must be zeroed so its scope-cleanup destructor
# becomes a no-op.
isRegisteredOwned: function {tmp: TmpCtr.view name: StringView} out bool is {
    fit: tmp.frees.iterate
    for fv: fit loop {
        if fv.stringview == name then return true
    }
    vit: tmp.listFreeVars.iterate
    for vv: vit loop {
        if vv.stringview == name then return true
    }
    return false
}

# emitReturnCleanup -- free the registered owned locals (tmp.frees + tmp.listFrees)
# BEFORE a return, reclaiming them on the diverging path the function-end flush
# never reaches. Does NOT pop (other returns + the end flush still need them).
# Skips any local REFERENCED in the return expression `retExpr` (it is part of, or
# borrowed by, the return value) and any non-owning alias (`ctx.aliases`). A
# match-arm-narrowed subject is NOT skipped -- the arm aliases it via narrowBox (no
# shadow), so it stays a normal owned local whose destructor is correctly typed here.
emitReturnCleanup: function {
    ctx: Ctx.view
    tmp: TmpCtr.view
    retExpr: StringView
    keepRefd: bool
    ind: StringView
    buf: String.borrow
} is {
    fRi9: u64
    for fRi9 < tmp.frees.length loop {
        fvR: tmp.frees.get i: fRi9
        fRaw9: tmp.freeRaw.get i: fRi9
        fRi9 = fRi9 + 1
        keepF: true
        if keepRefd then {
            if (refsLocal expr: retExpr name: fvR.stringview) then keepF = false
        }
        if (vvHas xs: ctx.aliases vid: fRaw9) then keepF = false
        if keepF then {
            lfR: "\{ind}\{ctx.strC}_free(&\{fvR});\n"
            buf.append lfR
        }
    }
    li9: u64
    nL9: tmp.listFrees.length
    for li9 < nL9 loop {
        stmt9: tmp.listFrees.get i: li9
        var9: tmp.listFreeVars.get i: li9
        lRaw9: tmp.listFreeRaw.get i: li9
        keepL: true
        if keepRefd then {
            if (refsLocal expr: retExpr name: var9.stringview) then keepL = false
        }
        if (vvHas xs: ctx.aliases vid: lRaw9) then keepL = false
        if keepL then buf.append stmt9
        li9 = li9 + 1
    }
    # a return exits every enclosing loop: emit each owned-payload loop's
    # per-iteration cleanup (empty for plain loops and do entries), unless
    # the payload is part of the return value or a non-owning alias.
    ci9: u64
    cn9: ctx.breakLabelCleanup.length
    for ci9 < cn9 loop {
        ccl0: ctx.breakLabelCleanup.get i: ci9
        ccv0: ctx.breakLabelCleanupVar.get i: ci9
        cRaw9: ctx.breakLabelCleanupRaw.get i: ci9
        if ccl0.length > 0 then {
            keepC: true
            if keepRefd then {
                if (refsLocal expr: retExpr name: ccv0.stringview) then keepC = false
            }
            if (vvHas xs: ctx.aliases vid: cRaw9) then keepC = false
            if keepC then {
                lcr9: "\{ind}\{ccl0}"
                buf.append lcr9
            }
        }
        ci9 = ci9 + 1
    }
}

# emit a function's body.
emitFnBody: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    op: Node.view
    fid: ztypes.tid
    buf: String.borrow
} is {
    {
        rbt9: fnReturnTidOf :symtab tid: fid
        if rbt9 == 0 then rbt9 = fnReturnTypeId :ast :symtab :op
        ctx.refBorrowRet = (fnReturnsRefBorrow9
            :ast
            :symtab
            :ctx
            :fid
            retTid: (ztypes.tid.create from: rbt9.u64)
        )
    }
    match (
        op
    ) case functiondef then {
        tmp: (TmpCtr
            n: 0
            frees: (List String)
            listFrees: (List String)
            listFreeVars: (List String)
            freeRaw: (ListVal ztypes.vid)
            listFreeRaw: (ListVal ztypes.vid)
        )
        pnames9: (List String)
        pids9: (ListVal u64)
        pids9Nm: (ListVal u64)
        recFieldLists :ast :symtab tid: fid names: pnames9 ids: pids9 nameIds: pids9Nm
        pj9: u64
        pn9: pnames9.length
        for pj9 < pn9 loop {
            ppn9: pnames9.get i: pj9
            ppid9: pids9.get i: pj9
            if (symtab.typing.declOwnershipIs
                pool: ast.names
                parentTypeId: fid
                name: ppn9.stringview
                own: ztypes.zparamownership.takeMode
            ) then {
                ptnm9: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: ppid9.u64)
                pmnB9: (paramVidIn
                    :ast
                    :symtab
                    params: op.parameters
                    nameId: (zast.nameid.create from: (pids9Nm.get i: pj9))
                )
                pmn9: varCName :ctx vid: pmnB9 name: ppn9.stringview
                if ppid9 == ctx.strTid then {
                    pms9: pmn9.copy
                    tmp.frees.append pms9
                    tmp.freeRaw.append pmnB9
                } else {
                    # owned .take Set/Map params are skipped: declared by value, but a
                    # Set/Map _destroy frees the container as a heap pointer (would need
                    # &name); none exist in the self-host.
                    if (isHeapPtrCollection
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: ppid9.u64)
                    ) == false then {
                        pcm9: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: ppid9.u64)
                        puse9: pcm9
                        if (symtab.reg.hasDestructorName typeId: pcm9) == false then {
                            prbn9: (canonTypeId
                                :ast
                                :symtab
                                :ctx
                                tid: (ztypes.tid.create from: ppid9.u64)
                                name: ptnm9.stringview
                            )
                            if prbn9 > 0 then puse9 = ztypes.tid.create from: prbn9.u64
                        }
                        if (symtab.reg.hasDestructorName typeId: puse9) then {
                            pcb9: ctxCname :ctx tid: (ztypes.tid.create from: puse9.u64)
                            pdf9: "    \{pcb9}_destroy(&\{pmn9});\n"
                            pdfs9: pdf9.copy
                            tmp.listFrees.append pdfs9
                            tmp.listFreeVars.append pmn9.copy
                            tmp.listFreeRaw.append pmnB9
                        }
                    }
                }
            }
            pj9 = pj9 + 1
        }
        endsRet9: false
        if op.body > 0 then {
            opb9: ast.nodes.get i: op.body.u64
            rbnT9: (ztypecheck.fnReturnBaseNameOf
                :ast
                op: (ast.nodes.get i: op.nodeid.u64)
            )
            if rbnT9.length > 0 when ctx.genActive == false then ctx.tailRetActive = true
            emitBodyNode :ast :symtab :ctx n: opb9 ind: "    " :tmp :buf
            ctx.tailRetActive = false
            endsRet9 = blockDiverges :ast :symtab :ctx n: opb9
        }
        # a body that diverges on every path never reaches this flush; the
        # return/break cleanups already freed the same locals on those paths
        if endsRet9 == false then {
            fiter9: tmp.frees.iterate
            for fv: fiter9 loop {
                lf9: "    \{ctx.strC}_free(&\{fv});\n"
                buf.append lf9
            }
            lfi9: tmp.listFrees.iterate
            for lfs: lfi9 loop buf.append lfs
        }
    } else null
}

# collectUnitLiterals -- pool the plain literals of every main-unit
# function body.
collectUnitLiterals: function {
    program: Node
    symtab: zenv.ZSymbolTable.view
    ids: (ListVal u64).view
    texts: (List String).view
} is {
    match (
        program
    ) case program then {
        uCnt9f: program.ast.units.length
        uIdx9f: u64
        for uIdx9f < uCnt9f loop {
            uId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9f))
            uIdx9f = uIdx9f + 1
            opId9: zast.nodeid
            un9: String
            un9Id: zast.nameid
            {
                u: program.ast.nodes.get i: uId9.u64
                if u.namedoperation then {
                    un: zast.poolTextAt pool: program.ast.names ref: u.name
                    if (isEmittableUnitFns name: un.stringview) then {
                        opId9 = u.operation
                        un9 = un.copy
                        un9Id = u.name
                    }
                }
            }
            if opId9 > 0 then {
                (collectUnitLiteralsIn
                    ast: program.ast
                    mainOpId: opId9
                    :symtab
                    unitName: un9.stringview
                    :ids
                    :texts
                )
            }
        }
    } else null
}

# collect a unit's string literals for the literal pool.
collectUnitLiteralsIn: function {
    ast: Ast.view
    mainOpId: zast.nodeid
    symtab: zenv.ZSymbolTable.view
    unitName: StringView
    ids: (ListVal u64).view
    texts: (List String).view
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: mainOpId
    biter: bodyIds9.iterate
    for bm: biter loop {
        bmNode9: ast.nodes.get i: bm.u64
        if bmNode9.namedoperation then {
            bn9: zast.nameTextAt :ast ref: bmNode9.name
            skipU9: (stdFnUndemanded
                :ast
                :symtab
                :unitName
                fnName: bn9.stringview
                ownerTid: ztypes.tid
                wantWalked: false
            )
            if (skipU9) == false then (collectFnLiterals
                :ast
                n: (ast.nodes.get i: bmNode9.operation.u64)
                :ids
                :texts
            )
        }
    }
}

# collect a function's string literals for the literal pool.
collectFnLiterals: function {
    ast: Ast.view
    n: Node.view
    ids: (ListVal u64).view
    texts: (List String).view
} is {
    match (
        n
    ) case functiondef then {
        if n.body > 0 then collectLiterals :ast n: (ast.nodes.get i: n.body.u64) :ids :texts
    } case objectdef then {
        with iiter9: n.isItems.iterate do for imId9: iiter9 loop {
            im9: ast.nodes.get i: imId9.u64
            match (
                im9
            ) case namedoperation then {
                collectFnLiterals :ast n: (ast.nodes.get i: im9.operation.u64) :ids :texts
            } else null
        }
        with aiter: n.asItems.iterate do for amId9: aiter loop {
            am: ast.nodes.get i: amId9.u64
            match (
                am
            ) case namedoperation then {
                collectFnLiterals :ast n: (ast.nodes.get i: am.operation.u64) :ids :texts
            } else null
        }
    } case unitdef then {
        with ubiter9: n.body.iterate do for ubm9: ubiter9 loop {
            ubn9: ast.nodes.get i: ubm9.u64
            match (
                ubn9
            ) case namedoperation then {
                collectFnLiterals :ast n: (ast.nodes.get i: ubn9.operation.u64) :ids :texts
            } else null
        }
    } else null
}

# emitC -- emit the C translation unit for a typechecked program.
emitC: function {
    program: Node
    symtab: zenv.ZSymbolTable
    runtimeDir: StringView
    fastHash: bool
    readableNames: bool
    errs: List String
    libs: (List String).view
} out String is {
    buf: String
    buf.append "/* Generated by zerolang compiler */\n"
    # the link libraries the reached units declared, so whatever drives the C
    # compiler -- zc itself, the corpus runner, a hand-run cc -- reads them off
    # the artifact instead of being told separately. Fixed line, always present.
    buf.append "/* zlink:"
    with lit9z: libs.iterate do for lb9z: lit9z loop {
        buf.append " "
        buf.append lb9z
    }
    buf.append " */\n"
    buf.append "\n"
    buf.append "#define _POSIX_C_SOURCE 200809L\n"
    buf.append "#define _DEFAULT_SOURCE\n"
    buf.append "\n"
    buf.append "#include <stdio.h>\n"
    buf.append "#include <stdint.h>\n"
    buf.append "#include <stdlib.h>\n"
    buf.append "#include <stdbool.h>\n"
    buf.append "#include <string.h>\n"
    buf.append "#include <math.h>\n"
    buf.append "#if defined(__SIZEOF_FLOAT128__) && !defined(__clang__)\n"
    buf.append "#include <quadmath.h>\n"
    buf.append "#elif defined(__SIZEOF_FLOAT128__)\n"
    buf.append "/* clang: __float128 without GCC's quadmath.h; declare the two\n"
    buf.append "   libquadmath symbols the runtime uses. */\n"
    buf.append "extern __float128 fmodq(__float128 x, __float128 y);\n"
    buf.append "extern __float128 strtoflt128(const char *s, char **sp);\n"
    buf.append "extern int quadmath_snprintf(char *s, size_t size, const char *format, ...);\n"
    buf.append "#endif\n"
    buf.append "#include <errno.h>\n"
    buf.append "#include <fcntl.h>\n"
    buf.append "#include <unistd.h>\n"
    buf.append "#include <sys/stat.h>\n"
    buf.append "#include <sys/types.h>\n"
    buf.append "#include <dirent.h>\n"
    buf.append "#include <pwd.h>\n"
    buf.append "#include <sys/wait.h>\n"
    buf.append "#include <signal.h>\n"
    buf.append "#include <sys/socket.h>\n"
    buf.append "#include <netinet/in.h>\n"
    buf.append "#include <arpa/inet.h>\n"
    buf.append "#include <poll.h>\n"
    buf.append "#include <sys/random.h>\n"
    buf.append "#include <sys/syscall.h>\n"
    buf.append "\n"
    buf.append "static _Noreturn void z_panic(const char* msg) {\n"
    buf.append "    fprintf(stderr, \"zpanic: %s\\n\", msg);\n"
    buf.append "    exit(1);\n"
    buf.append "}\n"
    buf.append "static _Noreturn void z_unreachable(void) { z_panic(\"unreachable\"); }\n"
    buf.append "static void* z_xmalloc(size_t n) {\n"
    buf.append "    void* p = malloc(n);\n"
    buf.append "    if (!p) z_panic(\"out of memory\");\n"
    buf.append "    return p;\n"
    buf.append "}\n"
    buf.append "static void* z_xcalloc(size_t count, size_t size) {\n"
    buf.append "    void* p = calloc(count, size);\n"
    buf.append "    if (!p) z_panic(\"out of memory\");\n"
    buf.append "    return p;\n"
    buf.append "}\n"
    buf.append "static void* z_xrealloc(void* p, size_t n) {\n"
    buf.append "    void* q = realloc(p, n);\n"
    buf.append "    if (!q) z_panic(\"out of memory\");\n"
    buf.append "    return q;\n"
    buf.append "}\n"
    buf.append "\n"
    strId: ztypes.tid
    svId: ztypes.tid
    sysId9: zast.nameid
    strNmId9: zast.nameid
    svNmId9: zast.nameid
    match (
        program
    ) case program then {
        sysId9 = zast.poolFind pool: program.ast.names text: "system"
        strNmId9 = zast.poolFind pool: program.ast.names text: "String"
        svNmId9 = zast.poolFind pool: program.ast.names text: "StringView"
    } else null
    sgo: (optionval.none u64)
    match (
        program
    ) case program then {
        ud11x9: ztypecheck.unitDeclOfNameId ty: symtab.typing nameId: sysId9
        sgo = (ztypecheck.resolvedByIds
            ast: program.ast
            ty: symtab.typing

            unitDecl: ud11x9
            name: strNmId9
        )
    } else null
    match (
        sgo
    ) case some then {
        strId = ztypes.tid.create from: (sgo)
    } case none then null
    vgo: (optionval.none u64)
    match (
        program
    ) case program then {
        ud12x9: ztypecheck.unitDeclOfNameId ty: symtab.typing nameId: sysId9
        vgo = (ztypecheck.resolvedByIds
            ast: program.ast
            ty: symtab.typing

            unitDecl: ud12x9
            name: svNmId9
        )
    } else null
    match (
        vgo
    ) case some then {
        svId = ztypes.tid.create from: (vgo)
    } case none then null
    cerrId: ztypes.tid
    cgo: (optionval.none u64)
    match (
        program
    ) case program then {
        ud13x9: ztypecheck.unitDeclOfNameId ty: symtab.typing nameId: sysId9
        cgo = (ztypecheck.resolvedByIds
            ast: program.ast
            ty: symtab.typing

            unitDecl: ud13x9
            name: (zast.poolFind pool: program.ast.names text: "converror")
        )
    } else null
    match (
        cgo
    ) case some then {
        cerrId = ztypes.tid.create from: (cgo)
    } case none then null
    cnames9: (List String)
    ctb9: ztypes.tid
    ctlast9: symtab.reg.nextTypeId
    for ctb9 < ctlast9 loop {
        cn9: String
        if (symtab.reg.typeValid tid: ctb9) then {
            if readableNames then {
                onm9: String
                oti9: symtab.reg.ownerTidOf tid: ctb9
                if oti9 > 0 then onm9 = symtab.reg.nameOf tid: oti9
                tnm9: symtab.reg.nameOf tid: ctb9
                cn9 = (cnameOf
                    tid: (ztypes.tid.create from: ctb9.u64)
                    ownerName: onm9.stringview
                    name: tnm9.stringview
                )
            } else {
                cn9 = cnameById tid: (ztypes.tid.create from: ctb9.u64)
            }
        }
        cnames9.append cn9
        ctb9 = ztypes.tid.create from: (ctb9 + 1)
    }
    strC: listCname cnames: cnames9 tid: strId
    svC: listCname cnames: cnames9 tid: svId
    # tid 0 is the "no type" sentinel, so a unit that registers neither String
    # nor StringView -- one with no main and no strings -- would hand both
    # runtime structs the same cname and emit two conflicting typedefs. The
    # fragments' own names are unique and already in the text.
    if strId.isZero then strC = "z_String".string
    if svId.isZero then svC = "z_StringView".string
    strOriginTid: ztypes.tid
    arrayOriginTid: ztypes.tid
    listOriginTid: ztypes.tid
    listValOriginTid: ztypes.tid
    listViewOriginTid: ztypes.tid
    listViewValOriginTid: ztypes.tid
    mapOriginTid: ztypes.tid
    mapRVOriginTid: ztypes.tid
    mapVROriginTid: ztypes.tid
    mapVVOriginTid: ztypes.tid
    setOriginTid: ztypes.tid
    setValOriginTid: ztypes.tid
    idMapROriginTid: ztypes.tid
    idMapVOriginTid: ztypes.tid
    idSetOriginTid: ztypes.tid
    idSetIterOriginTid: ztypes.tid
    idMapItemIterROriginTid: ztypes.tid
    idMapItemIterVOriginTid: ztypes.tid
    idMapEntryROriginTid: ztypes.tid
    idMapEntryVOriginTid: ztypes.tid
    mapEntryOriginTid: ztypes.tid
    listIterOriginTid: ztypes.tid
    listIterValOriginTid: ztypes.tid
    setIterOriginTid: ztypes.tid
    setIterValOriginTid: ztypes.tid
    mapKeyIterOriginTid: ztypes.tid
    mapItemIterOriginTid: ztypes.tid
    mapKeyIterRVOriginTid: ztypes.tid
    mapKeyIterVROriginTid: ztypes.tid
    mapKeyIterVVOriginTid: ztypes.tid
    mapItemIterRVOriginTid: ztypes.tid
    mapItemIterVROriginTid: ztypes.tid
    mapItemIterVVOriginTid: ztypes.tid
    mapEntryRVOriginTid: ztypes.tid
    mapEntryVROriginTid: ztypes.tid
    mapEntryVVOriginTid: ztypes.tid
    optionOriginTid: ztypes.tid
    optionViewOriginTid: ztypes.tid
    resultOriginTid: ztypes.tid
    optionvalOriginTid: ztypes.tid
    resultvalOriginTid: ztypes.tid
    match (
        program
    ) case program then {
        strOriginTid = ztypes.tid.create from: (builtinTid ast: program.ast :symtab base: "str")
        arrayOriginTid = ztypes.tid.create from: (builtinTid ast: program.ast :symtab base: "array")
        listOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "ListRef"
        )
        listValOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "ListVal"
        )
        listViewOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "ListView"
        )
        listViewValOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "ListViewVal"
        )
        mapOriginTid = ztypes.tid.create from: (builtinTid ast: program.ast :symtab base: "MapRR")
        mapRVOriginTid = ztypes.tid.create from: (builtinTid ast: program.ast :symtab base: "MapRV")
        mapVROriginTid = ztypes.tid.create from: (builtinTid ast: program.ast :symtab base: "MapVR")
        mapVVOriginTid = ztypes.tid.create from: (builtinTid ast: program.ast :symtab base: "MapVV")
        setOriginTid = ztypes.tid.create from: (builtinTid ast: program.ast :symtab base: "SetRef")
        setValOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "SetVal"
        )
        idMapROriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "IdMapR"
        )
        idMapVOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "IdMapV"
        )
        idSetOriginTid = ztypes.tid.create from: (builtinTid ast: program.ast :symtab base: "IdSet")
        idSetIterOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "IdSetIter"
        )
        idMapItemIterROriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "IdMapItemIterR"
        )
        idMapItemIterVOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "IdMapItemIterV"
        )
        idMapEntryROriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "IdMapEntryR"
        )
        idMapEntryVOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "IdMapEntryV"
        )
        mapEntryOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "MapEntry"
        )
        listIterOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "ListIter"
        )
        listIterValOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "ListIterVal"
        )
        setIterOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "SetIter"
        )
        setIterValOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "SetIterVal"
        )
        mapKeyIterOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "MapKeyIter"
        )
        mapItemIterOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "MapItemIter"
        )
        mapKeyIterRVOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "MapKeyIterRV"
        )
        mapKeyIterVROriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "MapKeyIterVR"
        )
        mapKeyIterVVOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "MapKeyIterVV"
        )
        mapItemIterRVOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "MapItemIterRV"
        )
        mapItemIterVROriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "MapItemIterVR"
        )
        mapItemIterVVOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "MapItemIterVV"
        )
        mapEntryRVOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "MapEntryRV"
        )
        mapEntryVROriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "MapEntryVR"
        )
        mapEntryVVOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "MapEntryVV"
        )
        optionOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "Option"
        )
        optionViewOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "OptionView"
        )
        resultOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "Result"
        )
        optionvalOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "optionval"
        )
        resultvalOriginTid = ztypes.tid.create from: (builtinTid
            ast: program.ast
            :symtab
            base: "resultval"
        )
    } else null
    p1: "\{runtimeDir}/z_String.inc"
    f1: loadFragment path: p1.stringview svC: svC.stringview strC: strC.stringview fails: errs
    buf.append f1
    # a String-typedef class (Path) shares the String struct: alias its
    # registered destructor to the String free so every generic destroy
    # site links (unused wrappers are fine: -Wno-unused-function)
    with sdit9: symtab.typing.typedefBaseTid.iterateItems do for sde9: sdit9 loop {
        if sde9.value == strId then {
            if (symtab.reg.hasDestructorName typeId: (ztypes.tid.create from: sde9.key)) then {
                sdc9: listCname cnames: cnames9 tid: (ztypes.tid.create from: sde9.key)
                sdw9: "static void \{sdc9}_destroy(\{strC}_t* p) { \{strC}_free(p); }\n"
                buf.append sdw9
            }
        }
    }
    p2: "\{runtimeDir}/z_StringView.inc"
    f2: loadFragment path: p2.stringview svC: svC.stringview strC: strC.stringview fails: errs
    buf.append f2
    ph: "\{runtimeDir}/z_hash.inc"
    fh: loadFragment path: ph.stringview svC: svC.stringview strC: strC.stringview fails: errs
    buf.append fh
    mn: mainNameOf9 :program
    litIds: (ListVal u64)
    litTexts: (List String)
    collectUnitLiterals :program :symtab ids: litIds texts: litTexts
    rm: mn.copy
    ctx: (Ctx
        mainName: mn
        nsTid: ztypes.tid
        realMain: rm
        :fastHash
        :readableNames
        :strC
        :svC
        cnames: cnames9
        :litIds
        usedLits: (MapVV u64 value: bool)
        constLits: (List String)
        tailRetActive: false
        defUnitId: (MapVV u64 value: u64)
        ioUnitDecl: 0
        osUnitDecl: 0
        cliUnitDecl: 0
        netUnitDecl: 0
        ioFileTid: 0
        netListenerTid: 0
        netConnTid: 0
        unitTidsC: (ListVal ztypes.tid)
        unitKeysC: (List String)
        unitCacheBuilt: false
        resolveByNameC: (MapVV u64 value: u64)
        mainUnitId: 0
        condDepth: 0
        emitErrors: (List String)
        needUnits: (List String)
        needMembs: (List String)
        dataElems: (MapVR ztypes.tid value: String)
        dataConst: (MapVR dataconstkey value: String)
        dataSlot: (MapVR dataslotkey value: String)
        ptrVids: (ListVal ztypes.vid)
        refBorrowRet: false
        aliases: (List VidVal)
        narrowBox: (List VidVal)
        narrowTid: (List VidTid)
        exclArms: (List VidVal)
        exclTids: (List VidTid)
        genActive: false
        genRecvC: "this".string
        genValC: "value".string
        genYieldCount: 0
        genYieldNext: 0
        genWrap: "".string
        genSomeTag: "".string
        genNoneTag: "".string
        genPayC: "".string
        genHasValue: false
        curThisTid: ztypes.tid
        emittedUserTypes: (MapVV u64 value: bool)
        tagStems: (MapRV String value: u64)
        fwdDeclaredTypes: (MapVV u64 value: bool)
        tmplCache: (Map String value: String)
        ioCanonC: (Map String value: String)
        nativeTbl: (Map String value: String)
        nativeNeed: (Map String value: String)
        nativePtrArgs: (MapRV String value: bool)
        nativeKeys: (MapRV String value: bool)
        nativeFragPaths: (MapRV String value: bool)
        nativeConvSrc: (MapRV String value: bool)
        nativeConvMemb: (MapRV String value: bool)
        fragUnits: (List String)
        fragMembs: (List String)
        fragNames: (List String)
        fragTypeNames: (List String)
        fragTypeTids: (ListVal u64)
        demandGatedTids: (MapVV u64 value: bool)
        usedTypeIds: (MapVV u64 value: bool)
        emittedConformance: (MapVV u64 value: bool)
        unitOrder: (List String)
        argHoistNames: (List String)
        argHoistVals: (List String)
        argHoistTypes: (List String)
        argHoistDtors: (List String)
        argHoistRaw: (List String)
        argHoistCtr: 0
        breakLabels: (ListVal u64)
        breakLabelIsDo: (ListVal bool)
        contLabelUsed: (MapVV u64 value: bool)
        breakLabelCtr: 0
        breakLabelUsed: (MapVV u64 value: bool)
        breakFreesMarks: (ListVal u64)
        breakListMarks: (ListVal u64)
        breakLabelCleanup: (List String)
        breakLabelCleanupVar: (List String)
        breakLabelCleanupRaw: (ListVal ztypes.vid)
        borrowedVars: (MapVV u64 value: bool)
        colGetFromCode: false
        strTid: (ztypes.tid.create from: strId.u64)
        svTid: (ztypes.tid.create from: svId.u64)
        converrorTid: (ztypes.tid.create from: cerrId.u64)
        :strOriginTid
        :arrayOriginTid
        :listOriginTid
        :listValOriginTid
        :listViewOriginTid
        :listViewValOriginTid
        :mapOriginTid
        :mapRVOriginTid
        :mapVROriginTid
        :mapVVOriginTid
        :setOriginTid
        :setValOriginTid
        :idMapROriginTid
        :idMapVOriginTid
        :idSetOriginTid
        :idSetIterOriginTid
        :idMapItemIterROriginTid
        :idMapItemIterVOriginTid
        :idMapEntryROriginTid
        :idMapEntryVOriginTid
        :mapEntryOriginTid
        :listIterOriginTid
        :listIterValOriginTid
        :setIterOriginTid
        :setIterValOriginTid
        :mapKeyIterOriginTid
        :mapItemIterOriginTid
        :mapKeyIterRVOriginTid
        :mapKeyIterVROriginTid
        :mapKeyIterVVOriginTid
        :mapItemIterRVOriginTid
        :mapItemIterVROriginTid
        :mapItemIterVVOriginTid
        :mapEntryRVOriginTid
        :mapEntryVROriginTid
        :mapEntryVVOriginTid
        :optionOriginTid
        :optionViewOriginTid
        :resultOriginTid
        :optionvalOriginTid
        :resultvalOriginTid
    )
    {
        lgp9: "\{runtimeDir}/z_List.c.tmpl"
        lgt9: readTemplateCached :ctx path: lgp9.stringview
        lgv9: lgt9.stringview
        if lgv9.length > 0 when (lgv9.contains needle: "_get(") == false then {
            ctx.colGetFromCode = true
        }
    }
    loadNativeTbl :ctx :runtimeDir
    match (
        program
    ) case program then {
        buildDefUnitIndex :symtab :ctx ast: program.ast
        bindFragTypeTids9 :symtab :ctx ast: program.ast
        rmn9: ctx.realMain.copy
        (ctxBindMain
            :ctx
            name: rmn9.stringview
            unitDecl: (unitDeclByName9 :symtab ast: program.ast name: rmn9.stringview)
        )
    } else null
    checkMainNatives :program :ctx
    fillDataElems :program :symtab :ctx
    fillNeeds :program :symtab :ctx
    nodeEstE9: u64
    match (
        program
    ) case program then {
        nodeEstE9 = program.ast.nodes.length
    } else null
    fnsBuf: String
    fnsBuf.reserve n: nodeEstE9 * 24
    emitFns :program :symtab :ctx buf: fnsBuf
    hasMain: programHasMain :program
    if (hasMain) == false then {
        fnsBuf.append "void z_main(void) {\n"
        fnsBuf.append "}\n\n"
    }
    # emit all _zsN-referencing code into codeBuf first (each reference marks
    # ctx.usedLits via litIndexOf), then write the literal pool with only the
    # referenced entries so unused literals never reach the output. The pool must
    # still precede the code in the file, so it is prepended below.
    codeBuf: String
    codeBuf.reserve n: nodeEstE9 * 8
    match (
        program
    ) case program then {
        emitMonos ast: program.ast :symtab :ctx :runtimeDir buf: codeBuf
        # ahead of the runtime fragments: those dereference the layouts of the
        # types they serve, so anything a fragment touches must already be
        # complete, and this is the pass that orders by-value embedding in both
        # directions (a user struct inside a mono, a mono inside a user struct)
        emitFnptrTypedefs ast: program.ast :symtab :ctx buf: codeBuf
        emitUserStructsOrdered ast: program.ast :symtab :ctx :runtimeDir buf: codeBuf
        # File's methods are demanded by the class being REACHABLE rather than
        # by a call, so the injection runs before any row is consulted
        if (ioFileLive ast: program.ast :symtab :ctx) then {
            needsAddM :ctx uname: "io" memb: "@unit"
            needsAddM :ctx uname: "io" memb: "file_close"
            needsAddM :ctx uname: "io" memb: "file_read"
            needsAddM :ctx uname: "io" memb: "file_write"
            needsAddM :ctx uname: "io" memb: "file_seek"
            needsAddM :ctx uname: "io" memb: "file_flush"
        }
        # every unit's runtime, in the order the table gives. The two io
        # emitters between io and cli generate C rather than load fragments, so
        # they stay named here -- they are the one seam the rows cannot state.
        with uoit9: ctx.unitOrder.iterate do for uo9: uoit9 loop {
            (emitRuntimeUnit9
                ast: program.ast
                :symtab
                :ctx
                :runtimeDir
                uname: uo9.stringview
                buf: codeBuf
            )
            if uo9.stringview == "io" then {
                emitIoFileConformance ast: program.ast :symtab :ctx buf: codeBuf
                emitIoStdStreams ast: program.ast :symtab :ctx buf: codeBuf
            }
        }
        (emitUnorderedUnits9
            ast: program.ast
            :symtab
            :ctx
            :runtimeDir
            buf: codeBuf
        )
    } else null
    emitRecordDefs :program :symtab :ctx buf: codeBuf
    poolBuf: String
    pi9: u64
    pn9: ctx.litIds.length
    for pi9 < pn9 loop {
        plid9: ctx.litIds.get i: pi9
        puo9: ctx.usedLits.get key: plid9
        match (
            puo9
        ) case some then {
            pt9: litTexts.get i: pi9
            ptv9: pt9.stringview
            pesc9: cEscape text: ptv9
            pblen9: ptv9.length
            pidx9: pi9 + 1
            pl19: "static const char _zs\{pidx9}_d[] = \"\{pesc9}\";\n"
            poolBuf.append pl19
            pl29: "static const \{ctx.svC}_t _zs\{pidx9} = { .data = _zs\{pidx9}_d, .size = \{pblen9} };\n"
            poolBuf.append pl29
        } case none then null
        pi9 = pi9 + 1
    }
    # the folded-string pool, written after the literal one and into the same
    # buffer, so both precede the code. Every entry here was minted BY an
    # emission that asked for it, so there is nothing unused to skip.
    ci9: u64
    cn9p: ctx.constLits.length
    for ci9 < cn9p loop {
        ct9: ctx.constLits.get i: ci9
        ctv9: ct9.stringview
        cesc9: cEscape text: ctv9
        cblen9: ctv9.length
        cidx9: ci9 + 1
        cl19: "static const char _zcs\{cidx9}_d[] = \"\{cesc9}\";\n"
        poolBuf.append cl19
        cl29: "static const \{ctx.svC}_t _zcs\{cidx9} = { .data = _zcs\{cidx9}_d, .size = \{cblen9} };\n"
        poolBuf.append cl29
        ci9 = ci9 + 1
    }
    # every body has emitted by now, so a need registered inside a type
    # method -- which emits after the runtime pass -- is still in time. This is
    # why `prelude` is a unit of its own: it goes into the header, ahead of the
    # literal pool, and no codeBuf walk may claim it.
    match (
        program
    ) case program then {
        (emitRuntimeUnit9
            ast: program.ast
            :symtab
            :ctx
            :runtimeDir
            uname: "prelude"
            :buf
        )
    } else null
    buf.reserve n: poolBuf.length + codeBuf.length + fnsBuf.length + 4096
    buf.append poolBuf
    buf.append "\n"
    buf.append codeBuf
    buf.append fnsBuf
    buf.append "int main(int argc, char* argv[]) {\n"
    if (needsHasM :ctx uname: "os" memb: "args") then {
        buf.append "    z_os_argc_g = argc;\n"
        buf.append "    z_os_argv_g = argv;\n"
    }
    buf.append "    z_siphash_init();\n"
    buf.append "    z_main();\n"
    buf.append "    return 0;\n"
    buf.append "}\n"
    with eeit: ctx.emitErrors.iterate do for ee: eeit loop errs.append from: ee.copy
    return buf
}

# true when the program defines a `main`.
programHasMain: function {program: Node} out bool is {
    match (
        program
    ) case program then {
        mainName: program.mainUnitName.stringview
        uCnt9g: program.ast.units.length
        uIdx9g: u64
        for uIdx9g < uCnt9g loop {
            uId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9g))
            uIdx9g = uIdx9g + 1
            opId9: zast.nodeid
            {
                u: program.ast.nodes.get i: uId9.u64
                if u.namedoperation then {
                    un: zast.poolTextAt pool: program.ast.names ref: u.name
                    if un.stringview == mainName then opId9 = u.operation
                }
            }
            if opId9 > 0 then {
                if (unitHasMain9 ast: program.ast mainOpId: opId9) then return true
            }
        }
        return false
    } else {
        return false
    }
}

# true when a unit defines a `main`.
unitHasMain9: function {ast: Ast.view mainOpId: zast.nodeid} out bool is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: mainOpId
    biter: bodyIds9.iterate
    for bm: biter loop {
        bmNode9: ast.nodes.get i: bm.u64
        if bmNode9.namedoperation then {
            bn: zast.nameTextAt :ast ref: bmNode9.name
            if bn.stringview == "main" then return true
        }
    }
    return false
}

# the path to a native runtime fragment under `runtimeDir`.
nativePath: function {runtimeDir: StringView frag: StringView} out String is {
    p: "\{runtimeDir}/natives/\{frag}.inc"
    return p
}

# cbaseNoPrefix -- the id-based cname without the leading "z_" (the runtime
# templates spell z_@@NAME@@, so NAME omits the prefix).
cbaseNoPrefix: function {ctx: Ctx.view tid: ztypes.tid} out String is {
    full: ctxCname :ctx :tid
    fl: full.length
    rest: (full.substring from: 2 to: fl)
    return rest.string
}

# applyTmpl -- substitute one @@KEY@@ placeholder in template text.
applyTmpl: function {text: String key: StringView val: StringView} out String is {
    needle: "@@\{key}@@"
    return (substituteAll :text needle: needle.stringview repl: val)
}

# monoOriginName -- the template name a mono derives from (List/Map/Set),
# "" when not a mono.
monoOriginName: function {symtab: zenv.ZSymbolTable tid: ztypes.tid} out String is {
    # partial specs (GENERIC_PARAM typetype) are trie bookkeeping, not monos
    if (symtab.reg.typetypeOf typeId: tid) == ztypes.ztypetype.genericParam then return "".string
    go: genericOriginOf9 :symtab :tid
    if go > 0 then return (typeNameOfReg9 :symtab tid: go)
    return "".string
}

# listElemType -- a List/ListView mono's element type id (the get-child
# return), 0 when absent.
listElemType: function {symtab: zenv.ZSymbolTable monoId: ztypes.tid} out ztypes.tid is {
    go: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.wkGet
    match (
        go
    ) case some then {
        return (symtab.reg.returnTypeOf tid: (ztypes.tid.create from: go.u64))
    } case none then null
    return (ztypes.tid.create from: 0)
}

# ctypeOrI64 -- the given C type name as an owned String, or int64_t
# when empty.
ctypeOrI64: function {s: StringView} out String is {
    if s.length > 0 then {
        return s.string
    } else {
        return "int64_t".string
    }
}

# emitListMono -- substitute z_List.c.tmpl for a List instance + the
# linear-scan contains companion (scalar element equality).
emitArrayMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    mn: typeNameOfReg9 :symtab tid: monoId
    nm: cbaseNoPrefix :ctx tid: monoId
    eid: listElemType :symtab :monoId
    eln9: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: eid.u64)
    ect0: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: eid.u64) thisTid: ztypes.tid
    ect: ctypeOrI64 s: ect0.stringview
    lenPfx: eln9.length + 7
    lenStr: monoElemName full: mn prefixLen: lenPfx
    createBody: "    z_\{nm}_t _this = {0};"
    eqBody: String
    eqo: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.wkOpEq
    match (
        eqo
    ) case some then {
        eqBody = "static bool z_\{nm}_eq(z_\{nm}_t a, z_\{nm}_t b) {\n    for (int _i = 0; _i < \{lenStr.stringview}; _i++) { if (a.data[_i] != b.data[_i]) return false; }\n    return true;\n}\n"
    } case none then null
    p: "\{runtimeDir}/z_array.c.tmpl"
    raw: readTemplateCached :ctx path: p.stringview
    if raw.length > 0 then {
        t1: applyTmpl text: raw key: "NAME" val: nm.stringview
        t2: applyTmpl text: t1 key: "ELEM_T" val: ect.stringview
        t3: applyTmpl text: t2 key: "LEN" val: lenStr.stringview
        t4: applyTmpl text: t3 key: "CREATE_BODY" val: createBody.stringview
        t5: applyTmpl text: t4 key: "EQ_BODY" val: eqBody.stringview
        buf.append t5
        buf.append "\n"
    }
}

# capLenT -- the C length-field type for a str mono of the given capacity:
# uint8/16/32 by capacity, keeping small str monos compact (mirrors the
# reference's len-type selection).
capLenT: function {cap: StringView} out String is {
    v: u64
    i: u64
    n: cap.length
    for i < n loop {
        bo: cap.byteAt :i
        match (
            bo
        ) case some then {
            v = (v * 10) + (bo - 48).u64
        } case none then null
        i = i + 1
    }
    if v <= 255 then return "uint8_t".string
    if v <= 65535 then return "uint16_t".string
    return "uint32_t".string
}

# emitStrMono -- a str valtype mono (fixed-capacity inline string). Substitutes
# z_str.c.tmpl (struct + create + .string + String_to_<name>). Read via
# loadFragment so the template's hardcoded z_String becomes the port's strC.
# Capacity is the trailing segment of the mono name (str_<cap>), prefix "str_"=4.
emitStrMono: function {
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    mn: typeNameOfReg9 :symtab tid: monoId
    nm: cbaseNoPrefix :ctx tid: monoId
    capStr: monoElemName full: mn prefixLen: 4
    lenT: capLenT cap: capStr.stringview
    eqBody: String
    eqo: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.wkOpEq
    match (
        eqo
    ) case some then {
        eqBody = "static bool z_\{nm}_eq(z_\{nm}_t a, z_\{nm}_t b) {\n    return a.len == b.len && memcmp(a.data, b.data, a.len) == 0;\n}\n"
    } case none then null
    p: "\{runtimeDir}/z_str.c.tmpl"
    svL9: ctx.svC
    strL9: ctx.strC
    raw: (loadFragment
        path: p.stringview
        svC: svL9.stringview
        strC: strL9.stringview
        fails: ctx.emitErrors
    )
    t1: applyTmpl text: raw key: "NAME" val: nm.stringview
    t2: applyTmpl text: t1 key: "CAP" val: capStr.stringview
    t3: applyTmpl text: t2 key: "LEN_T" val: lenT.stringview
    t4: applyTmpl text: t3 key: "EQ_BODY" val: eqBody.stringview
    buf.append t4
    buf.append "\n"
}

# emitBoxMono -- a builtin Box mono (heap pointer). No struct (the type is
# <inner>*); emit only the destructor: free the inner (String/destructor) then
# the cell. Mirrors the reference _emit_mono_box.
emitBoxMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    monoId: ztypes.tid
    buf: String.borrow
} is {
    mn: typeNameOfReg9 :symtab tid: monoId
    nm: cbaseNoPrefix :ctx tid: monoId
    beName9: monoElemName full: mn prefixLen: 4
    beid9: resolveTypeIdByName :ast :symtab :ctx name: beName9.stringview
    # the parameter is void*: a Box leaf's destroy may precede its element's
    # struct definition (a Box over a late-emitted system record), and the
    # body never needs the type -- a boxed element is a valtype, so the only
    # live action is freeing the cell (the String/dtor legs below are
    # bound-impossible today and convert implicitly if ever reached).
    bdecl9: "static void z_\{nm}_destroy(void* v);\n"
    buf.append bdecl9
    bsig9: "static void z_\{nm}_destroy(void* v) {\n"
    buf.append bsig9
    buf.append "    if (!v) return;\n"
    if beid9 == ctx.strTid then {
        bfree9: "    \{ctx.strC}_free(v);\n"
        buf.append bfree9
    } else {
        if (symtab.reg.hasDestructorName typeId: (ztypes.tid.create from: beid9.u64)) then {
            bicb9: ctxCname :ctx tid: (ztypes.tid.create from: beid9.u64)
            bidf9: "    \{bicb9}_destroy(v);\n"
            buf.append bidf9
        }
    }
    buf.append "    free(v);\n"
    buf.append "}\n\n"
}

# emit the monomorphised C for a List instantiation.
emitListMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    eid: listElemType :symtab :monoId
    eln9: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: eid.u64)
    isStrEl9: false
    if eid == ctx.strTid then isStrEl9 = true
    isSvEl9: false
    if eid == ctx.svTid then isSvEl9 = true
    ect0: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: eid.u64) thisTid: ztypes.tid
    ect: ctypeOrI64 s: ect0.stringview
    p: "\{runtimeDir}/z_List.c.tmpl"
    raw: readTemplateCached :ctx path: p.stringview
    if raw.length == 0 then return
    {
        t1: applyTmpl text: raw key: "NAME" val: nm.stringview
        t2: applyTmpl text: t1 key: "ELEM_T" val: ect.stringview
        delems9: String
        if isStrEl9 then {
            delems9 = "    for (uint64_t _di = 0; _di < p->length; _di++) {\n        \{ctx.strC}_free(&p->data[_di]);\n    }\n"
        } else {
            ecid9: eid
            if (symtab.reg.hasDestructorName typeId: ecid9) == false then {
                rbn9: (canonTypeId
                    :ast
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: eid.u64)
                    name: eln9.stringview
                )
                if rbn9 > 0 then ecid9 = ztypes.tid.create from: rbn9.u64
            }
            if (symtab.reg.hasDestructorName typeId: ecid9) then {
                ecb9: ctxCname :ctx tid: (ztypes.tid.create from: ecid9.u64)
                delems9 = "    for (uint64_t _di = 0; _di < p->length; _di++) {\n        \{ecb9}_destroy(&p->data[_di]);\n    }\n"
            }
        }
        t3: applyTmpl text: t2 key: "DESTROY_ELEMS" val: delems9.stringview
        lvm: listviewMethods :ctx :symtab :monoId nm: nm.stringview ect: ect.stringview
        t4: applyTmpl text: t3 key: "LISTVIEW_METHODS" val: lvm.stringview
        buf.append t4
        buf.append "\n"
    }
    if ctx.colGetFromCode then {
        (emitColGet
            nm: nm.stringview
            ect: ect.stringview
            kind: "List"
            ptr: (elemBorrowsByPtr :ast :symtab :ctx tid: (ztypes.tid.create from: eid.u64))
            mutPtr: (elemRefByPtr :ast :symtab :ctx tid: (ztypes.tid.create from: eid.u64))
            :buf
        )
    }
    co: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.wkContains
    match (
        co
    ) case some then {
        c0: "static bool z_\{nm}_contains(const z_\{nm}_t* _this, \{ect} _needle);\n"
        buf.append c0
        c1: "static bool z_\{nm}_contains(const z_\{nm}_t* _this, \{ect} _needle) {\n"
        buf.append c1
        buf.append "    for (uint64_t i = 0; i < _this->length; i++) {\n"
        if isStrEl9 then {
            buf.append "        if (_this->data[i].size == _needle.size && memcmp(_this->data[i].data, _needle.data, _needle.size) == 0) return true;\n"
        } else if isSvEl9 then {
            buf.append "        if (_this->data[i].size == _needle.size && memcmp(_this->data[i].data, _needle.data, _needle.size) == 0) return true;\n"
        } else if (keyHashKind :symtab :ctx tid: (ztypes.tid.create from: eid.u64)) == 3 then {
            # a by-value STRUCT element: C `==` does not apply to it. Same
            # byte comparison Set already uses for its elements.
            buf.append "        if (memcmp(&_this->data[i], &_needle, sizeof(_needle)) == 0) return true;\n"
        } else {
            buf.append "        if (_this->data[i] == _needle) return true;\n"
        }
        buf.append "    }\n"
        buf.append "    return false;\n"
        buf.append "}\n\n"
    } case none then null
    so: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.wkSort
    match (
        so
    ) case some then {
        (emitListSort
            nm: nm.stringview
            ect: ect.stringview
            isStr: isStrEl9
            isSv: isSvEl9
            isStruct: (keyHashKind :symtab :ctx tid: (ztypes.tid.create from: eid.u64)) == 3
            strC: ctx.strC.stringview
            svC: ctx.svC.stringview
            :buf
        )
    } case none then null
    emitListIter :ctx :symtab :monoId nm: nm.stringview :buf
}

# emitColGet -- the element `get` for a List / ListView mono. The declared
# signature is `out of.borrow`: for an element kind whose copy is not a borrow
# the C function returns a POINTER into the storage and the call site derefs,
# so every value context stays value-shaped. `kind` only spells the panic
# message. One emitter for both templates, so List.listview cannot hand out a
# view that disagrees with its source. The return type and its forward
# declaration come from one string and cannot diverge.
emitColGet: function {
    nm: StringView
    ect: StringView
    kind: StringView
    ptr: bool
    mutPtr: bool
    buf: String.borrow
} is {
    rt: ect.string
    rv: "    return _this->data[_idx];\n".string
    if ptr then {
        rt = "\{ect}*"
        rv = "    return &_this->data[_idx];\n".string
    }
    # `getMut` answers a DIFFERENT question from `get`: a valtype element copies
    # out of `get` (cheap, cannot alias) but must come back BY REFERENCE from
    # `getMut`, or a write to the referenced element's children lands on the
    # copy and is silently lost.
    mrt: ect.string
    mrv: "    return _this->data[_idx];\n".string
    if mutPtr then {
        mrt = "\{ect}*"
        mrv = "    return &_this->data[_idx];\n".string
    }
    # Both names are spelled LITERALLY -- view-guard reads these string literals
    # to learn which declaration each emitted function backs, and cannot see
    # through an interpolated method name.
    guard: String
    guard.append "    if (_idx >= _this->length) {\n"
    guard.append "        char _zp_buf[96];\n"
    b2: "        snprintf(_zp_buf, sizeof(_zp_buf), \"\{kind} get: index %lu out of bounds (length %lu)\", (unsigned long)_idx, (unsigned long)_this->length);\n"
    guard.append b2
    guard.append "        z_panic(_zp_buf);\n"
    guard.append "    }\n"
    s0: "static \{rt} z_\{nm}_get(z_\{nm}_t* _this, uint64_t _idx);\n"
    buf.append s0
    s1: "static \{rt} z_\{nm}_get(z_\{nm}_t* _this, uint64_t _idx) {\n"
    buf.append s1
    buf.append guard
    buf.append rv
    buf.append "}\n\n"
    m0: "static \{mrt} z_\{nm}_getMut(z_\{nm}_t* _this, uint64_t _idx);\n"
    buf.append m0
    m1: "static \{mrt} z_\{nm}_getMut(z_\{nm}_t* _this, uint64_t _idx) {\n"
    buf.append m1
    buf.append guard
    buf.append mrv
    buf.append "}\n\n"
}

# emitListIter -- the borrowed-view iterator over a List mono (a `{List*; idx}`
# cursor yielding OptionView<T> by reference), emitted only when List.iterate is
# used (the ListIter / OptionView monos were minted). The OptionView mono is
# emitted by the earlier OptionView pass, so this can reference it.
emitListIter: function {
    ctx: Ctx.view
    symtab: zenv.ZSymbolTable.view
    monoId: ztypes.tid
    nm: StringView
    buf: String.borrow
} is {
    liId: monoMethodReturn :symtab :monoId nameId: zast.wkIterate
    if liId == 0 then return
    ovId: (monoMethodReturn
        :symtab
        monoId: (ztypes.tid.create from: liId.u64)
        nameId: zast.wkCall
    )
    if ovId == 0 then return
    ovName: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: ovId.u64)
    li: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: liId.u64)
    ov: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: ovId.u64)
    ovu: cUpperOf text: ovName.stringview
    s0: "typedef struct {\n    z_\{nm}_t* list;\n    uint64_t idx;\n} z_\{li}_t;\n"
    buf.append s0
    s1: "static z_\{ov}_t z_\{li}_call(z_\{li}_t* _it);\n"
    buf.append s1
    s2: "static z_\{ov}_t z_\{li}_call(z_\{li}_t* _it) {\n"
    buf.append s2
    s3: "    z_\{ov}_t _out = {0};\n"
    buf.append s3
    s4: "    if (_it->idx >= _it->list->length) { _out.tag = Z_\{ovu}_TAG_NONE; return _out; }\n"
    buf.append s4
    s5: "    _out.tag = Z_\{ovu}_TAG_SOME;\n"
    buf.append s5
    s6: "    _out.data = &_it->list->data[_it->idx];\n"
    buf.append s6
    s7: "    _it->idx++;\n    return _out;\n}\n"
    buf.append s7
    # `iterate` is the READONLY walk, so its receiver is const and view-guard
    # checks it. The cursor keeps a plain T* and OptionView's payload is one
    # void* shared with the readers that hand out a mutable interior pointer on
    # purpose (List.get's write-back), so const stops at this ONE cast. That the
    # ELEMENTS are readonly is a typecheck-level guarantee -- the element
    # inherits the strength of the lock its holder has on the container.
    s8: "static z_\{li}_t z_\{nm}_iterate(const z_\{nm}_t* _this);\n"
    buf.append s8
    s9: "static z_\{li}_t z_\{nm}_iterate(const z_\{nm}_t* _this) {\n    z_\{li}_t _it = {0};\n    _it.list = (z_\{nm}_t*)_this;\n    _it.idx = 0;\n    return _it;\n}\n\n"
    buf.append s9
    # iterateMut -- the mutable walk. The same cursor over the same storage;
    # the two differ only in what the typechecker lets the caller do with the
    # elements, so the C bodies are identical.
    s10: "static z_\{li}_t z_\{nm}_iterateMut(z_\{nm}_t* _this);\n"
    buf.append s10
    s11: "static z_\{li}_t z_\{nm}_iterateMut(z_\{nm}_t* _this) {\n    z_\{li}_t _it = {0};\n    _it.list = _this;\n    _it.idx = 0;\n    return _it;\n}\n\n"
    buf.append s11
}

# emitListSort -- stable in-place mergesort companion (scalar `<`).
emitListSort: function {
    nm: StringView
    ect: StringView
    isStr: bool
    isSv: bool
    isStruct: bool
    strC: StringView
    svC: StringView
    buf: String.borrow
} is {
    if isStr then {
        s0s: "static int z_\{nm}_sort_lt(\{ect} _a, \{ect} _b) { return \{strC}_cmp(&_a, &_b) < 0; }\n"
        buf.append s0s
    } else if isSv then {
        s0v: "static int z_\{nm}_sort_lt(\{ect} _a, \{ect} _b) { return \{svC}_cmp(_a, _b) < 0; }\n"
        buf.append s0v
    } else if isStruct then {
        # a by-value STRUCT element has no C ordering. Byte order is a total
        # order and deterministic, which is what `sort` needs; an element that
        # wants a MEANINGFUL order declares `<`, and dispatching to it is the
        # same shape as the declared `==` the containers already honour.
        s0r: "static int z_\{nm}_sort_lt(\{ect} _a, \{ect} _b) { return memcmp(&_a, &_b, sizeof(_a)) < 0; }\n"
        buf.append s0r
    } else {
        s0: "static int z_\{nm}_sort_lt(\{ect} _a, \{ect} _b) { return _a < _b; }\n"
        buf.append s0
    }
    s1: "static void z_\{nm}_sort_merge(\{ect}* data, \{ect}* scratch, uint64_t lo, uint64_t mid, uint64_t hi) {\n"
    buf.append s1
    buf.append "    uint64_t i = lo, j = mid, k = lo;\n"
    buf.append "    while (i < mid && j < hi) {\n"
    sm: "        if (!z_\{nm}_sort_lt(data[j], data[i])) scratch[k++] = data[i++];\n"
    buf.append sm
    buf.append "        else scratch[k++] = data[j++];\n"
    buf.append "    }\n"
    buf.append "    while (i < mid) scratch[k++] = data[i++];\n"
    buf.append "    while (j < hi) scratch[k++] = data[j++];\n"
    buf.append "    memcpy(&data[lo], &scratch[lo], (hi - lo) * sizeof(*data));\n"
    buf.append "}\n"
    s2: "static void z_\{nm}_sort_rec(\{ect}* data, \{ect}* scratch, uint64_t lo, uint64_t hi) {\n"
    buf.append s2
    buf.append "    if (hi - lo <= 1) return;\n"
    buf.append "    uint64_t mid = lo + (hi - lo) / 2;\n"
    sr1: "    z_\{nm}_sort_rec(data, scratch, lo, mid);\n"
    buf.append sr1
    sr2: "    z_\{nm}_sort_rec(data, scratch, mid, hi);\n"
    buf.append sr2
    sr3: "    z_\{nm}_sort_merge(data, scratch, lo, mid, hi);\n"
    buf.append sr3
    buf.append "}\n"
    s3: "static void z_\{nm}_sort(z_\{nm}_t* _this) {\n"
    buf.append s3
    buf.append "    if (_this->length < 2) return;\n"
    sa: "    \{ect}* scratch = (\{ect}*)z_xmalloc(_this->length * sizeof(\{ect}));\n"
    buf.append sa
    sd: "    z_\{nm}_sort_rec(_this->data, scratch, 0, _this->length);\n"
    buf.append sd
    buf.append "    free(scratch);\n"
    buf.append "}\n\n"
}

# emitListViewMono -- substitute z_ListView.c.tmpl for a ListView mono.
emitListViewMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    eid: listElemType :symtab :monoId
    ect0: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: eid.u64) thisTid: ztypes.tid
    ect: ctypeOrI64 s: ect0.stringview
    p: "\{runtimeDir}/z_ListView.c.tmpl"
    raw: readTemplateCached :ctx path: p.stringview
    if raw.length > 0 then {
        t1: applyTmpl text: raw key: "NAME" val: nm.stringview
        t2: applyTmpl text: t1 key: "ELEM_T" val: ect.stringview
        buf.append t2
        buf.append "\n"
    }
    if ctx.colGetFromCode then {
        (emitColGet
            nm: nm.stringview
            ect: ect.stringview
            kind: "ListView"
            ptr: (elemBorrowsByPtr :ast :symtab :ctx tid: (ztypes.tid.create from: eid.u64))
            mutPtr: (elemRefByPtr :ast :symtab :ctx tid: (ztypes.tid.create from: eid.u64))
            :buf
        )
    }
}

# listviewMethods -- the _listview cast + _extendView companions when a
# List mono carries a listview child; "" otherwise.
listviewMethods: function {
    ctx: Ctx.view
    symtab: zenv.ZSymbolTable
    monoId: ztypes.tid
    nm: StringView
    ect: StringView
} out String is {
    lo: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.wkListview
    match (
        lo
    ) case some then {
        rt: fnReturnTidOf :symtab tid: (ztypes.tid.create from: lo.u64)
        if rt > 0 then {
            {
                lvc: ctxCname :ctx tid: (ztypes.tid.create from: rt.u64)
                buf: String
                m0: "static \{lvc}_t z_\{nm}_listview(z_\{nm}_t* _this) { return *(\{lvc}_t*)_this; }\n"
                buf.append m0
                m1: "static void z_\{nm}_extendView(z_\{nm}_t* _this, \{lvc}_t _from) {\n"
                buf.append m1
                m2: "    z_\{nm}_grow(_this, _this->length + _from.length);\n"
                buf.append m2
                m3: "    memcpy(&_this->data[_this->length], _from.data, _from.length * sizeof(\{ect}));\n"
                buf.append m3
                buf.append "    _this->length += _from.length;\n"
                buf.append "}\n\n"
                return buf
            }
        }
    } case none then null
    return "".string
}

# isGenericType -- the type is a generic template (arms typed by generic
# params; never emitted as a concrete struct).
isGenericType: function {symtab: zenv.ZSymbolTable tid: ztypes.tid} out bool is {
    return (symtab.reg.isGenericOf :tid)
}


# buildDefUnitIndex -- snapshot tid -> defining-unit DECLARATION once per
# emission (the Decl chain is immutable during emission); zero-alloc id
# lookups then serve the hot definedInNonMain path. Interning a fresh integer
# per unit NAME collapsed two units that share a spelling into one id.
buildDefUnitIndex: function {symtab: zenv.ZSymbolTable ctx: Ctx ast: Ast.view} is {
    t9: u64
    n9: symtab.reg.nextTypeId
    for t9 < n9 loop {
        udd9: (ztypecheck.unitDeclOfTid
            ty: symtab.typing
            reg: symtab.reg
            tid: (ztypes.tid.create from: t9.u64)
        )
        if (udd9.isZero) == false then {
            ctx.defUnitId.set key: t9 value: udd9.u64
        }
        t9 = t9 + 1
    }
    ctx.ioUnitDecl = unitDeclByName9 :symtab :ast name: "io"
    ctx.osUnitDecl = unitDeclByName9 :symtab :ast name: "os"
    ctx.cliUnitDecl = unitDeclByName9 :symtab :ast name: "cli"
    ctx.netUnitDecl = unitDeclByName9 :symtab :ast name: "net"
    ctx.ioFileTid = (unitClassTid9
        :symtab
        unitDecl: ctx.ioUnitDecl
        nameId: (zast.poolFind pool: ast.names text: "File")
    ).u64
    ctx.netListenerTid = (unitClassTid9
        :symtab
        unitDecl: ctx.netUnitDecl
        nameId: (zast.poolFind pool: ast.names text: "Listener")
    ).u64
    ctx.netConnTid = (unitClassTid9
        :symtab
        unitDecl: ctx.netUnitDecl
        nameId: (zast.poolFind pool: ast.names text: "Conn")
    ).u64
}

# ctxBindMain -- rebind the emission main unit: mainName plus its unit
# DECLARATION, which the CALLER supplies. Every caller already holds the unit
# by id -- off the type it is emitting, off the unit node it is walking, or
# saved from the bind it is restoring -- so nothing here asks which unit is
# spelled a given way. Every mainName assignment must route through here so
# mainUnitId never goes stale (definedInNonMain compares against it).
ctxBindMain: function {ctx: Ctx name: StringView unitDecl: u64} is {
    nm9: name.string
    ctx.mainName = nm9
    ctx.mainUnitId = unitDecl
}

# typeHasNativeCreate -- the type's own `create` is declared native, so the
# runtime supplies that symbol and the field-wise meta_create alias would
# redeclare it with a different signature.
typeHasNativeCreate: function {symtab: zenv.ZSymbolTable tid: ztypes.tid} out bool is {
    co9: symtab.typing.declChildOfId parentTypeId: tid nameId: zast.wkCreate
    match (
        co9
    ) case some then {
        return (symtab.reg.isNativeOf tid: (ztypes.tid.create from: co9))
    } case none then {
        return false
    }
}

# definedInNonMain -- the type is defined in a non-main (system/io/...)
# unit (a reachable library type to emit alongside the main closure).
definedInNonMain: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    symtab
    dgo: ctx.defUnitId.get key: tid
    match (
        dgo
    ) case some then {
        return dgo != ctx.mainUnitId
    } case none then {
        return false
    }
}

# emitUnionMono -- a UNION mono (Option/Result): tag enum + { tag; void*
# data } heap-payload struct + destroy (free the payload on non-null arms,
# recursing into an aggregate payload's destructor first).
emitUnionMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    egu9: ctx.emittedUserTypes.get key: tid
    match (
        egu9
    ) case some then {
        return
    } case none then null
    ctx.emittedUserTypes.set key: tid.u64 value: true
    anames: (List String)
    aids: (ListVal u64)
    aidsNm: (ListVal u64)
    variantArms :ast :symtab :tid names: anames ids: aids nameIds: aidsNm
    checkTagStem :symtab :ctx :tid
    vc: ctxCname :ctx :tid
    buf.append "typedef enum {\n"
    ai: u64
    an: anames.length
    for ai < an loop {
        aname: anames.get i: ai
        tg: variantTag :symtab :tid arm: aname.stringview
        tv: armTagValueText9 :symtab :tid armNameId: (aidsNm.get i: ai)
        lt: "    \{tg}\{tv},\n"
        buf.append lt
        ai = ai + 1
    }
    le: "} \{vc}_tag_t;\n"
    buf.append le
    if (isFwdDeclared :ctx :tid) then {
        lopenU: "struct \{vc}_t {\n"
        buf.append lopenU
    } else {
        buf.append "typedef struct {\n"
    }
    tsc9: tagStorageCType :symtab :tid
    if tsc9.length == 0 then {
        lfE9: "    \{vc}_tag_t tag;\n"
        buf.append lfE9
    } else {
        lfD9: "    \{tsc9} tag;\n"
        buf.append lfD9
    }
    buf.append "    void* data;\n"
    if (isFwdDeclared :ctx :tid) then {
        buf.append "};\n"
    } else {
        lg: "} \{vc}_t;\n"
        buf.append lg
    }
    ld: "static void \{vc}_destroy(\{vc}_t* u) {\n"
    buf.append ld
    buf.append "    if (!u) return;\n"
    buf.append "    if (!u->data) return;\n"
    buf.append "    switch (u->tag) {\n"
    pj: u64
    for pj < an loop {
        pname: anames.get i: pj
        pc: armPayloadC :ast :symtab :ctx :tid arm: pname.stringview
        if pc.length > 0 then {
            ptg: variantTag :symtab :tid arm: pname.stringview
            lcase: "        case \{ptg}:\n"
            buf.append lcase
            pdtr: payloadDestructor :ast :symtab :ctx :tid arm: pname.stringview
            if pdtr.length > 0 then {
                ldd: "            \{pdtr}((\{pc}*)u->data);\n"
                buf.append ldd
            }
            buf.append "            free(u->data);\n"
            buf.append "            break;\n"
        }
        pj = pj + 1
    }
    buf.append "        default: break;\n"
    buf.append "    }\n"
    buf.append "}\n\n"
}

# payloadDestructor -- the destructor cname for an arm whose payload is an
# aggregate with a destructor ("" for scalar/view payloads).
payloadDestructor: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    tid: ztypes.tid
    arm: StringView
} out String is {
    co: symtab.typing.declChildOf pool: ast.names parentTypeId: tid name: arm
    match (
        co
    ) case some then {
        pn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: co.u64)
        if pn.stringview == "null" then return "".string
        if co == ctx.strTid then return "\{ctx.strC}_free"
        # childOf already resolves the arm to its concrete (possibly cross-unit)
        # payload id; canonicalize a destructor-less shell via resolveTypeIdByName,
        # the same way the List-element destructor does. Build the cname with
        # cnameOf (a fresh String) -- never bind the borrowed destructorName, which
        # would move out of the registry borrow (scope-exit free -> UAF).
        rid: co
        if (symtab.reg.hasDestructorName typeId: (ztypes.tid.create from: co.u64)) == false then {
            rbn: (canonTypeId
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: co.u64)
                name: pn.stringview
            )
            if rbn > 0 then rid = rbn
        }
        if (symtab.reg.hasDestructorName typeId: (ztypes.tid.create from: rid.u64)) then {
            cb: ctxCname :ctx tid: (ztypes.tid.create from: rid.u64)
            return "\{cb}_destroy"
        }
    } case none then null
    return "".string
}

# monoMethodReturn -- a mono method child's registered return id (0 when the
# method or its return is absent). The id-first way to reach a collection's
# iterator/view/wrapper companions.
monoMethodReturn: function {
    symtab: zenv.ZSymbolTable
    monoId: ztypes.tid
    nameId: zast.nameid
} out u64 is {
    co: symtab.typing.declChildOfId parentTypeId: monoId :nameId
    match (
        co
    ) case some then {
        mro: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: co.u64)
        match (
            mro
        ) case some then {
            return mro
        } case none then null
    } case none then null
    return 0
}

# monoElemName -- a mono name's element segment, dropping a known prefix
# (e.g. "Set_i64" with prefixLen 4 -> "i64"). Substring rides String.stringview
# (a bare StringView receiver mis-resolves `from:/to:` to a .create).
monoElemName: function {full: String prefixLen: u64} out String is {
    fl: full.length
    rest: (full.substring from: prefixLen to: fl)
    return rest.string
}

# setHashBody / setEqBody / setDestroyItems -- the element-kind-specific
# fragments of a Set mono: the keyed byte hash (SipHash by default,
# z_fasthash_* under --fast-hash) + memcmp + per-item free for String keys,
# the integer hash + `==` + no item cleanup otherwise.
# declaredKeyFnC -- the C name of a `hash` or `==` the KEY TYPE declared, or
# "" when it declares none. A reftype key has no byte representation to hash --
# its contents live behind a pointer -- so RefHashable makes it declare both,
# and the container must then CALL them instead of casting the aggregate.
#
# The member's receiver is a pointer like any other method's, and the template
# holds the key BY VALUE, so the caller addresses it.
declaredKeyFnC: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
    member: StringView
} out String is {
    nid9: zast.poolFind pool: ast.names text: member
    if nid9.isZero then return "".string
    if (symtab.typing.declIsMethodId parentTypeId: tid nameId: nid9) == false then return "".string
    if (symtab.typing.declMemberIsSynth parentTypeId: tid nameId: nid9) then return "".string
    mo9: symtab.typing.declChildOfId parentTypeId: tid nameId: nid9
    match (
        mo9
    ) case some then {
        return (ctxCname :ctx tid: (ztypes.tid.create from: mo9.u64))
    } case none then {
        return "".string
    }
}

# keyHashKind -- classify a Set element / Map key by canonical id (never by
# name, so a user shadow is handled by its nature): 1 native String, 2
# StringView, 3 by-value struct (record/variant -> byte hash over contents), 0
# scalar or pointer (cast hash + C `==`). A builtin numeric/bool/char is a
# record whose C type is a scalar, so it classifies 0 with the pointers --
# scalarCTypeFor is the shadow-safe gate (a user type shadowing a scalar name
# stays a struct). A heap-owning struct lands in 3 and fails to build at its
# `_eq` until the typecheck rejection lands (Slice 3).
keyHashKind: function {symtab: zenv.ZSymbolTable ctx: Ctx.view tid: ztypes.tid} out u64 is {
    ktid9: typedefChaseTid9 :symtab :tid
    if ktid9 == ctx.strTid then return 1
    if ktid9 == ctx.svTid then return 2
    tt: symtab.reg.typetypeOf typeId: ktid9
    isRv9: tt == ztypes.ztypetype.recordType
    if isRv9 == false then isRv9 = tt == ztypes.ztypetype.variantType
    if isRv9 then {
        tn9: typeNameOfReg9 :symtab tid: ktid9
        sc9: scalarCTypeFor :symtab name: tn9.stringview tid: ktid9
        if sc9.length > 0 then return 0
        return 3
    }
    return 0
}

# the C body of a Set's hash function.
setHashBody: function {kind: u64 fast: bool} out String is {
    # a String key arrives BY POINTER (the probe never copies the header)
    if fast then {
        if kind == 1 then return "z_fasthash_bytes(_key->data, _key->size)".string
        if kind == 2 then return "z_fasthash_stringview(_key)".string
        if kind == 3 then return "z_fasthash_bytes(&_key, sizeof(_key))".string
    } else {
        if kind == 1 then return "z_siphash_bytes(_key->data, _key->size)".string
        if kind == 2 then return "z_siphash_stringview(_key)".string
        if kind == 3 then return "z_siphash_bytes(&_key, sizeof(_key))".string
    }
    return "z_hash_u64((uint64_t)_key)".string
}

# the C body of a Set's element-equality function.
setEqBody: function {kind: u64} out String is {
    if kind == 1 then return "_a->size == _b->size && memcmp(_a->data, _b->data, _a->size) == 0".string
    if kind == 2 then {
        return "_a.length == _b.length && memcmp(_a.data, _b.data, _a.length) == 0".string
    }
    if kind == 3 then return "memcmp(&_a, &_b, sizeof(_a)) == 0".string
    return "_a == _b".string
}

# the C body that destroys a Set's items.
setDestroyItems: function {isStr: bool strC: StringView} out String is {
    if isStr then {
        return "    for (uint64_t i = 0; i < p->entries_len; i++) {\n        if (p->entries[i].alive) {\n            \{strC}_free(&p->entries[i].item);\n        }\n    }\n"
    }
    return "".string
}

# the C snippet duplicating a Set item.
setFreeItemDup: function {isStr: bool strC: StringView} out String is {
    if isStr then return "        \{strC}_free(&_item);\n"
    return "".string
}

# the C snippet deleting a Set item.
setFreeItemDel: function {isStr: bool strC: StringView} out String is {
    if isStr then return "    \{strC}_free(&_this->entries[idx].item);\n"
    return "".string
}

# emitOptionViewMono -- the borrowed-view option a collection iterator yields:
# a {tag; void* data} struct with a no-op destroy (the view owns nothing).
emitOptionViewMono: function {
    ctx: Ctx.view
    symtab: zenv.ZSymbolTable.view
    monoId: ztypes.tid
    buf: String.borrow
} is {
    mn: typeNameOfReg9 :symtab tid: monoId
    nm: cbaseNoPrefix :ctx tid: monoId
    ovu: cUpperOf text: mn.stringview
    buf.append "typedef enum {\n"
    l1: "    Z_\{ovu}_TAG_NONE,\n"
    buf.append l1
    l2: "    Z_\{ovu}_TAG_SOME,\n"
    buf.append l2
    l3: "} z_\{nm}_tag_t;\n"
    buf.append l3
    buf.append "typedef struct {\n"
    tscO9: tagStorageCType :symtab tid: monoId
    if tscO9.length == 0 then {
        l4: "    z_\{nm}_tag_t tag;\n"
        buf.append l4
    } else {
        l4d: "    \{tscO9} tag;\n"
        buf.append l4d
    }
    buf.append "    void* data;\n"
    l5: "} z_\{nm}_t;\n"
    buf.append l5
    l6: "static void z_\{nm}_destroy(z_\{nm}_t* u) { (void)u; }\n\n"
    buf.append l6
}

# emitSetMono -- substitute z_Set.c.tmpl for a Set instance (compact-dict
# struct + add/has/delete/iterate + the SetIter companion). Depends on the
# element's OptionView mono being emitted first (the iterator yields it).
emitSetMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    mcr: cUpperOf text: nm.stringview
    elemTid: setElemType :symtab :monoId
    elemName: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: elemTid.u64)
    itemT: (cTypeForNameTid
        :ast
        :symtab
        :ctx
        name: elemName.stringview
        tid: (ztypes.tid.create from: elemTid.u64)
    )
    ekind: keyHashKind :symtab :ctx tid: (ztypes.tid.create from: elemTid.u64)
    isStr: ekind == 1
    siId: monoMethodReturn :symtab :monoId nameId: zast.wkIterate
    if siId == 0 then return
    ovId: (monoMethodReturn
        :symtab
        monoId: (ztypes.tid.create from: siId.u64)
        nameId: zast.wkCall
    )
    if ovId == 0 then return
    ovName: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: ovId.u64)
    ov: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: ovId.u64)
    ovu: cUpperOf text: ovName.stringview
    si: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: siId.u64)
    hashBody: setHashBody kind: ekind fast: ctx.fastHash
    eqBody: setEqBody kind: ekind
    {
        dh9: String
        de9: String
        if ekind == 0 then {
            dh9 = (declaredKeyFnC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: elemTid.u64)
                member: "hash"
            )
            de9 = (declaredKeyFnC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: elemTid.u64)
                member: "=="
            )
        }
        if dh9.length > 0 when de9.length > 0 then {
            hb9: "\{dh9}(&_key)"
            hashBody = hb9
            rhsPs9: elemBorrowsByPtr :ast :symtab :ctx tid: (ztypes.tid.create from: elemTid.u64)
            rhsAs9: "_b".string
            rhsTs9: itemT.copy
            if rhsPs9 then {
                rhsAs9 = "&_b".string
                rhsTsp9: "\{itemT}*"
                rhsTs9 = rhsTsp9
            }
            eb9: "\{de9}(&_a, \{rhsAs9})"
            eqBody = eb9
            fd9: "static uint64_t \{dh9}(\{itemT}*);\nstatic bool \{de9}(\{itemT}*, \{rhsTs9});\n"
            buf.append fd9
        }
    }
    destroyItems: setDestroyItems :isStr strC: ctx.strC.stringview
    freeItemDup: setFreeItemDup :isStr strC: ctx.strC.stringview
    freeItemDel: setFreeItemDel :isStr strC: ctx.strC.stringview
    p: "\{runtimeDir}/z_Set.c.tmpl"
    raw: readTemplateCached :ctx path: p.stringview
    if raw.length > 0 then {
        t1: applyTmpl text: raw key: "NAME" val: nm.stringview
        t2: applyTmpl text: t1 key: "MACRO" val: mcr.stringview
        t3: applyTmpl text: t2 key: "ITEM_T" val: itemT.stringview
        itemArgT9: itemT.copy
        itemRef9: String
        if isStr then {
            itemArgT9 = "const \{itemT}*"
            itemRef9 = "&".string
        }
        t3 = applyTmpl text: t3 key: "ITEM_ARG_T" val: itemArgT9.stringview
        t3 = applyTmpl text: t3 key: "ITEM_REF" val: itemRef9.stringview
        t4: applyTmpl text: t3 key: "HASH_BODY" val: hashBody.stringview
        t5: applyTmpl text: t4 key: "EQ_BODY" val: eqBody.stringview
        t6: applyTmpl text: t5 key: "DESTROY_ITEMS" val: destroyItems.stringview
        t6b: applyTmpl text: t6 key: "FREE_ITEM_DUP" val: freeItemDup.stringview
        t6c: applyTmpl text: t6b key: "FREE_ITEM_DEL" val: freeItemDel.stringview
        t7: applyTmpl text: t6c key: "OPTIONVIEW" val: ov.stringview
        t8: applyTmpl text: t7 key: "OPTIONVIEW_TAG" val: ovu.stringview
        t9: applyTmpl text: t8 key: "SETITER" val: si.stringview
        buf.append t9
        buf.append "\n"
    }
    if isStr then {
        # String sets: view-keyed probes. The temporary String header aliases
        # the view bytes; has/delete only hash and compare, never store or
        # free the probe (delete frees the STORED item only).
        sv0: "static int z_\{nm}_hasv(const z_\{nm}_t* _this, \{ctx.svC}_t _item) {\n"
        buf.append sv0
        sv1: "    \{ctx.strC}_t _k = { _item.size, (char*)_item.data, _item.size };\n"
        buf.append sv1
        sv2: "    return z_\{nm}_has(_this, &_k);\n}\n\n"
        buf.append sv2
        sd0: "static int z_\{nm}_deletev(z_\{nm}_t* _this, \{ctx.svC}_t _item) {\n"
        buf.append sd0
        sd1: "    \{ctx.strC}_t _k = { _item.size, (char*)_item.data, _item.size };\n"
        buf.append sd1
        sd2: "    return z_\{nm}_delete(_this, &_k);\n}\n\n"
        buf.append sd2
    }
}

# mapDestroyEntries / mapFreeKeyDup / mapFreeKeyDel -- String-key cleanup
# fragments: per-entry key free on destroy, incoming-key free when a set hits
# an existing key, stored-key free on delete. Empty for non-heap keys.
mapDestroyEntries: function {isStr: bool strC: StringView valFree: StringView} out String is {
    keyLine: String
    if isStr then keyLine = "            \{strC}_free(&p->entries[i].key);\n"
    valLine: String
    if valFree.length > 0 then valLine = "            \{valFree}\n"
    if (keyLine.length + valLine.length) == 0 then return "".string
    return "    for (uint64_t i = 0; i < p->entries_len; i++) {\n        if (p->entries[i].alive) {\n\{keyLine}\{valLine}        }\n    }\n"
}

# the C snippet duplicating a Map key.
mapFreeKeyDup: function {isStr: bool strC: StringView} out String is {
    if isStr then return "        \{strC}_free(&_key);\n"
    return "".string
}

# the C snippet deleting a Map key (and its value).
mapFreeKeyDel: function {isStr: bool strC: StringView valFree: StringView} out String is {
    res: String
    if isStr then res = "    \{strC}_free(&_this->entries[idx].key);\n"
    if valFree.length > 0 then res = "\{res}    \{valFree}\n"
    return res
}

# mapValFreeStmt -- the value-free statement for a Map value slot: String value
# via the String free, reftype / heap-collection value via its destructor, empty
# for scalars. Mirrors emitStructDestructor's per-field cleanup.
mapValFreeStmt: function {
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    valTid: ztypes.tid
    slot: StringView
} out String is {
    if valTid == ctx.strTid then return "\{ctx.strC}_free(&\{slot});"
    if valTid > 0 then {
        vmid: chaseColMono :symtab :ctx tid: valTid
        needs: false
        if (symtab.reg.hasDestructorName typeId: vmid) then needs = true
        if (isHeapPtrCollection :symtab :ctx tid: valTid) then needs = true
        if needs then {
            vcb: ctxCname :ctx tid: (ztypes.tid.create from: vmid.u64)
            if (isHeapPtrCollection
                :symtab
                :ctx
                tid: valTid
            ) then return "\{vcb}_destroy(\{slot});"
            return "\{vcb}_destroy(&\{slot});"
        }
    }
    return "".string
}

# emitMapIters -- the MapKeyIter/MapItemIter/MapEntry block for a Map mono,
# emitted only when those iterator monos were minted. Their OptionView returns
# (OptionView_<K>, OptionView_MapEntry_<K>_<V>) are defined by the earlier
# OptionView leg.
emitMapIters: function {
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    monoId: ztypes.tid
    runtimeDir: StringView
    nm: StringView
    keyT: StringView
    valT: StringView
    buf: String.borrow
} is {
    miiId: monoMethodReturn :symtab :monoId nameId: zast.wkIterateItems
    if miiId == 0 then return
    mkiId: monoMethodReturn :symtab :monoId nameId: zast.wkIterate
    if mkiId == 0 then return
    ovkId: (monoMethodReturn
        :symtab
        monoId: (ztypes.tid.create from: mkiId.u64)
        nameId: zast.wkCall
    )
    if ovkId == 0 then return
    ovkName: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: ovkId.u64)
    oveId: (monoMethodReturn
        :symtab
        monoId: (ztypes.tid.create from: miiId.u64)
        nameId: zast.wkCall
    )
    if oveId == 0 then return
    oveName: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: oveId.u64)
    meId: ztypes.tid
    meo: (symtab.typing.declChildOfId
        parentTypeId: (ztypes.tid.create from: oveId.u64)
        nameId: zast.wkSome
    )
    match (
        meo
    ) case some then {
        meId = ztypes.tid.create from: (meo)
    } case none then null
    if meId.isZero then return
    mki: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: mkiId.u64)
    mii: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: miiId.u64)
    me: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: meId.u64)
    ovk: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: ovkId.u64)
    ovku: cUpperOf text: ovkName.stringview
    ove: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: oveId.u64)
    oveu: cUpperOf text: oveName.stringview
    pi: "\{runtimeDir}/z_MapIter.c.tmpl"
    rawi: readTemplateCached :ctx path: pi.stringview
    if rawi.length > 0 then {
        i1: applyTmpl text: rawi key: "NAME" val: nm
        i2: applyTmpl text: i1 key: "KEY_T" val: keyT
        i3: applyTmpl text: i2 key: "VAL_T" val: valT
        i4: applyTmpl text: i3 key: "MAPKEYITER" val: mki.stringview
        i5: applyTmpl text: i4 key: "OPTIONVIEW_K" val: ovk.stringview
        i6: applyTmpl text: i5 key: "OPTIONVIEW_K_TAG" val: ovku.stringview
        i7: applyTmpl text: i6 key: "MAPENTRY" val: me.stringview
        i8: applyTmpl text: i7 key: "MAPITEMITER" val: mii.stringview
        i9: applyTmpl text: i8 key: "OPTIONVIEW_ENTRY" val: ove.stringview
        i10: applyTmpl text: i9 key: "OPTIONVIEW_ENTRY_TAG" val: oveu.stringview
        buf.append i10
        buf.append "\n"
    }
}

# emitMapMono -- substitute z_Map.c.tmpl for a Map instance (compact-dict +
# set/get/has/delete). The value's optionval mono (get's return) supplies the
# value type and the OPTIONVAL placeholders; the key name is the remainder.
# mapValType -- the canonical Map value type id, off the "set" method's "value"
# param (mirrors listElemType). 0 when absent.
mapKeyType: function {symtab: zenv.ZSymbolTable monoId: ztypes.tid} out u64 is {
    so: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.wkSet
    match (
        so
    ) case some then {
        ko: (symtab.typing.declChildOfId
            parentTypeId: (ztypes.tid.create from: so.u64)
            nameId: zast.wkKey
        )
        match (
            ko
        ) case some then {
            return ko
        } case none then null
    } case none then null
    return 0
}

# the element type id of Set instantiation `monoId`.
setElemType: function {symtab: zenv.ZSymbolTable monoId: ztypes.tid} out u64 is {
    ao: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.wkAdd
    match (
        ao
    ) case some then {
        io: (symtab.typing.declChildOfId
            parentTypeId: (ztypes.tid.create from: ao.u64)
            nameId: zast.wkItem
        )
        match (
            io
        ) case some then {
            return io
        } case none then null
    } case none then null
    return 0
}

# the value type id of Map instantiation `monoId`.
mapValType: function {symtab: zenv.ZSymbolTable monoId: ztypes.tid} out ztypes.tid is {
    so: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.wkSet
    match (
        so
    ) case some then {
        vo: (symtab.typing.declChildOfId
            parentTypeId: (ztypes.tid.create from: so.u64)
            nameId: zast.wkValue
        )
        match (
            vo
        ) case some then {
            return (ztypes.tid.create from: vo)
        } case none then null
    } case none then null
    return (ztypes.tid.create from: 0)
}

# emit the monomorphised C for a Map instantiation.
emitMapMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    mcr: cUpperOf text: nm.stringview
    ovId: ztypes.tid
    go: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.wkGet
    match (
        go
    ) case some then {
        ovId = symtab.reg.returnTypeOf tid: (ztypes.tid.create from: go.u64)
    } case none then null
    if ovId.isZero then return
    ovName: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: ovId.u64)
    valTid: mapValType :symtab monoId: (ztypes.tid.create from: monoId.u64)
    valName: typeNameOfReg9 :symtab tid: valTid
    valT: cTypeForNameTid :ast :symtab :ctx name: valName.stringview tid: valTid
    ov: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: ovId.u64)
    ovu: cUpperOf text: ovName.stringview
    keyTid: mapKeyType :symtab :monoId
    keyName: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: keyTid.u64)
    keyT: (cTypeForNameTid
        :ast
        :symtab
        :ctx
        name: keyName.stringview
        tid: (ztypes.tid.create from: keyTid.u64)
    )
    kkind: keyHashKind :symtab :ctx tid: (ztypes.tid.create from: keyTid.u64)
    keyIsStr: kkind == 1
    hashKeyBody: setHashBody kind: kkind fast: ctx.fastHash
    keysEqBody: setEqBody kind: kkind
    {
        # Only the FALLTHROUGH kind. String (1), StringView (2) and the
        # by-value structs (3) already have their own bodies, and String's
        # `hash`/`==` are NATIVES whose C is fixed by their .inc -- calling
        # them by emitted name links to nothing.
        dhm9: String
        dem9: String
        if kkind == 0 then {
            dhm9 = (declaredKeyFnC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: keyTid.u64)
                member: "hash"
            )
            dem9 = (declaredKeyFnC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: keyTid.u64)
                member: "=="
            )
        }
        if dhm9.length > 0 when dem9.length > 0 then {
            hbm9: "\{dhm9}(&_key)"
            hashKeyBody = hbm9
            # the receiver is a pointer either way; the `rhs` PARAMETER follows
            # the key's own calling convention, which is a pointer for a class
            # and a value for a record
            rhsP9: elemBorrowsByPtr :ast :symtab :ctx tid: (ztypes.tid.create from: keyTid.u64)
            rhsA9: "_b".string
            rhsT9: keyT.copy
            if rhsP9 then {
                rhsA9 = "&_b".string
                rhsTp9: "\{keyT}*"
                rhsT9 = rhsTp9
            }
            ebm9: "\{dem9}(&_a, \{rhsA9})"
            keysEqBody = ebm9
            # the mono is emitted before user method bodies, so declare the
            # two it now calls
            fdm9: "static uint64_t \{dhm9}(\{keyT}*);\nstatic bool \{dem9}(\{keyT}*, \{rhsT9});\n"
            buf.append fdm9
        }
    }
    vfDestroy: (mapValFreeStmt
        :symtab
        :ctx
        :valTid
        slot: "p->entries[i].value"
    )
    vfDup: (mapValFreeStmt
        :symtab
        :ctx
        :valTid
        slot: "_this->entries[existing].value"
    )
    freeValDup: String
    if vfDup.length > 0 then freeValDup = "        \{vfDup}\n"
    destroyEntries: (mapDestroyEntries
        isStr: keyIsStr
        strC: ctx.strC.stringview
        valFree: vfDestroy.stringview
    )
    freeKeyDup: mapFreeKeyDup isStr: keyIsStr strC: ctx.strC.stringview
    getBody: String
    if (originIsTid
        :symtab
        tid: (ztypes.tid.create from: ovId.u64)
        originTid: ctx.optionvalOriginTid
    ) then {
        gbV: "    z_\{ov}_t _r;\n    if (idx >= 0) {\n        _r.tag = Z_\{ovu}_TAG_SOME;\n        _r.data.some = _this->entries[idx].value;\n    } else {\n        _r.tag = Z_\{ovu}_TAG_NONE;\n    }\n    return _r;"
        getBody = gbV
    } else {
        # every OptionView-producing value kind (class, String, union,
        # protocol, ...) borrows a pointer into the entry storage: the
        # view's SHARED lock pins the map, and OptionView destroy is a
        # no-op, so a malloc'd box here would leak (the audited get
        # contract is "no deep-copy on get")
        gbR: "    z_\{ov}_t _r = {0};\n    if (idx >= 0) {\n        _r.tag = Z_\{ovu}_TAG_SOME;\n        _r.data = &_this->entries[idx].value;\n    } else {\n        _r.tag = Z_\{ovu}_TAG_NONE;\n        _r.data = NULL;\n    }\n    return _r;"
        getBody = gbR
    }
    rmWrapId9: ztypes.tid
    roMm9: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.wkRemove
    match (
        roMm9
    ) case some then {
        rmWrapId9 = symtab.reg.returnTypeOf tid: (ztypes.tid.create from: roMm9.u64)
    } case none then null
    rmWrapName9: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: rmWrapId9.u64)
    rmWrap9: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: rmWrapId9.u64)
    rmWrapU9: cUpperOf text: rmWrapName9.stringview
    keyOnlyFree9: mapFreeKeyDel isStr: keyIsStr strC: ctx.strC.stringview valFree: ""
    delTail9: "\{keyOnlyFree9}    _this->entries[idx].alive = 0;\n    _this->indices[slot] = Z_\{mcr}_INDEX_DELETED;\n    _this->length--;\n"
    removeBody9: String
    if (originIsTid
        :symtab
        tid: (ztypes.tid.create from: rmWrapId9.u64)
        originTid: ctx.optionvalOriginTid
    ) then {
        removeBody9 = "    z_\{rmWrap9}_t _r;\n    if (idx < 0) {\n        _r.tag = Z_\{rmWrapU9}_TAG_NONE;\n        return _r;\n    }\n    _r.tag = Z_\{rmWrapU9}_TAG_SOME;\n    _r.data.some = _this->entries[idx].value;\n\{delTail9}    return _r;"
    } else {
        removeBody9 = "    z_\{rmWrap9}_t _r = {0};\n    if (idx < 0) {\n        _r.tag = Z_\{rmWrapU9}_TAG_NONE;\n        _r.data = NULL;\n        return _r;\n    }\n    _r.tag = Z_\{rmWrapU9}_TAG_SOME;\n    \{valT}* _box = (\{valT}*)z_xmalloc(sizeof(\{valT}));\n    *_box = _this->entries[idx].value;\n    _r.data = _box;\n\{delTail9}    return _r;"
    }
    p: "\{runtimeDir}/z_Map.c.tmpl"
    raw: readTemplateCached :ctx path: p.stringview
    if raw.length == 0 then return
    {
        t1: applyTmpl text: raw key: "NAME" val: nm.stringview
        t2: applyTmpl text: t1 key: "MACRO" val: mcr.stringview
        t3: applyTmpl text: t2 key: "KEY_T" val: keyT.stringview
        keyArgT9: keyT.copy
        keyRef9: String
        if keyIsStr then {
            keyArgT9 = "const \{keyT}*"
            keyRef9 = "&".string
        }
        t3 = applyTmpl text: t3 key: "KEY_ARG_T" val: keyArgT9.stringview
        t3 = applyTmpl text: t3 key: "KEY_REF" val: keyRef9.stringview
        t4: applyTmpl text: t3 key: "VAL_T" val: valT.stringview
        t5: applyTmpl text: t4 key: "HASH_KEY_BODY" val: hashKeyBody.stringview
        t6: applyTmpl text: t5 key: "KEYS_EQUAL_BODY" val: keysEqBody.stringview
        t7: applyTmpl text: t6 key: "DESTROY_ENTRIES" val: destroyEntries.stringview
        t8: applyTmpl text: t7 key: "FREE_KEY_DUP" val: freeKeyDup.stringview
        t10: applyTmpl text: t8 key: "OPTIONVAL" val: ov.stringview
        t11: applyTmpl text: t10 key: "OPTIONVAL_TAG" val: ovu.stringview
        t12: applyTmpl text: t11 key: "GET_BODY" val: getBody.stringview
        t13: applyTmpl text: t12 key: "FREE_VAL_DUP" val: freeValDup.stringview
        t14: applyTmpl text: t13 key: "REMOVE_WRAP" val: rmWrap9.stringview
        t15: applyTmpl text: t14 key: "REMOVE_BODY" val: removeBody9.stringview
        buf.append t15
        buf.append "\n"
    }
    if kkind == 1 then {
        # String-keyed maps: a view-keyed get. The temporary String header
        # aliases the view bytes; get/find only hash and compare the key,
        # never store or free it.
        gv0: "static z_\{ov}_t z_\{nm}_getv(z_\{nm}_t* _this, \{ctx.svC}_t _key) {\n"
        buf.append gv0
        gv1: "    \{ctx.strC}_t _k = { _key.size, (char*)_key.data, _key.size };\n"
        buf.append gv1
        gv2: "    return z_\{nm}_get(_this, &_k);\n}\n\n"
        buf.append gv2
        hv0: "static int z_\{nm}_hasv(const z_\{nm}_t* _this, \{ctx.svC}_t _key) {\n"
        buf.append hv0
        hv1: "    \{ctx.strC}_t _k = { _key.size, (char*)_key.data, _key.size };\n"
        buf.append hv1
        hv2: "    return z_\{nm}_has(_this, &_k);\n}\n\n"
        buf.append hv2
    }
    (emitMapIters
        :symtab
        :ctx
        :monoId
        :runtimeDir
        nm: nm.stringview
        keyT: keyT.stringview
        valT: valT.stringview
        :buf
    )
}

# idMapDestroyEntries -- the per-entry free loop for an IdMap. There is no
# `alive` test and no key line: entries are dense (nothing is ever removed) and
# an id key is a scalar that owns nothing.
idMapDestroyEntries: function {valFree: StringView} out String is {
    if valFree.length == 0 then return "".string
    return "    for (uint32_t i = 0; i < p->length; i++) {\n        \{valFree}\n    }\n"
}

# emitIdMapMono -- substitute z_IdMap.c.tmpl for an IdMap instance. Far fewer
# holes than emitMapMono: the bound guarantees a scalar key, so there is no
# hash body to choose, no key-equality body (C `==` is it), and no key to free.
emitIdMapMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    mcr: cUpperOf text: nm.stringview
    ovId: ztypes.tid
    go: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.wkGet
    match (
        go
    ) case some then {
        ovId = symtab.reg.returnTypeOf tid: (ztypes.tid.create from: go.u64)
    } case none then null
    if ovId.isZero then return
    ovName: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: ovId.u64)
    ov: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: ovId.u64)
    ovu: cUpperOf text: ovName.stringview
    valTid: mapValType :symtab monoId: (ztypes.tid.create from: monoId.u64)
    valName: typeNameOfReg9 :symtab tid: valTid
    valT: cTypeForNameTid :ast :symtab :ctx name: valName.stringview tid: valTid
    keyTid: mapKeyType :symtab :monoId
    keyName: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: keyTid.u64)
    keyT: (cTypeForNameTid
        :ast
        :symtab
        :ctx
        name: keyName.stringview
        tid: (ztypes.tid.create from: keyTid.u64)
    )
    vfDestroy: (mapValFreeStmt :symtab :ctx :valTid slot: "p->entries[i].value")
    vfDup: (mapValFreeStmt
        :symtab
        :ctx
        :valTid
        slot: "_this->entries[existing].value"
    )
    freeValDup: String
    if vfDup.length > 0 then freeValDup = "        \{vfDup}\n"
    destroyEntries: idMapDestroyEntries valFree: vfDestroy.stringview
    getBody: String
    if (originIsTid
        :symtab
        tid: (ztypes.tid.create from: ovId.u64)
        originTid: ctx.optionvalOriginTid
    ) then {
        getBody = "    z_\{ov}_t _r;\n    if (idx >= 0) {\n        _r.tag = Z_\{ovu}_TAG_SOME;\n        _r.data.some = _this->entries[idx].value;\n    } else {\n        _r.tag = Z_\{ovu}_TAG_NONE;\n    }\n    return _r;"
    } else {
        # same borrowed-pointer contract as Map.get: the OptionView pins the
        # container with a SHARED lock and its destroy is a no-op, so nothing
        # is copied out of the entry storage
        getBody = "    z_\{ov}_t _r = {0};\n    if (idx >= 0) {\n        _r.tag = Z_\{ovu}_TAG_SOME;\n        _r.data = (void*)&_this->entries[idx].value;\n    } else {\n        _r.tag = Z_\{ovu}_TAG_NONE;\n        _r.data = NULL;\n    }\n    return _r;"
    }
    p: "\{runtimeDir}/z_IdMap.c.tmpl"
    raw: readTemplateCached :ctx path: p.stringview
    if raw.length == 0 then return
    t1: applyTmpl text: raw key: "NAME" val: nm.stringview
    t2: applyTmpl text: t1 key: "MACRO" val: mcr.stringview
    t3: applyTmpl text: t2 key: "KEY_T" val: keyT.stringview
    t4: applyTmpl text: t3 key: "VAL_T" val: valT.stringview
    t5: applyTmpl text: t4 key: "DESTROY_ENTRIES" val: destroyEntries.stringview
    t6: applyTmpl text: t5 key: "FREE_VAL_DUP" val: freeValDup.stringview
    t7: applyTmpl text: t6 key: "OPTIONVAL" val: ov.stringview
    t8: applyTmpl text: t7 key: "OPTIONVAL_TAG" val: ovu.stringview
    t9: applyTmpl text: t8 key: "GET_BODY" val: getBody.stringview
    buf.append t9
    buf.append "\n"
    (emitIdMapGetMut
        :ast
        :symtab
        :ctx
        :monoId
        :runtimeDir
        nm: nm.stringview
        keyT: keyT.stringview
        :buf
    )
    (emitIdMapIters
        :symtab
        :ctx
        :monoId
        :runtimeDir
        nm: nm.stringview
        keyT: keyT.stringview
        valT: valT.stringview
        :buf
    )
}

# emitIdMapGetMut -- the in-place value reference, from its own template.
# `getMut` has no well-known name id, so its declared return -- an OptionView
# over the VALUE in both families, where `get`'s differs between them -- is
# resolved through the interned name.
emitIdMapGetMut: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    monoId: ztypes.tid
    runtimeDir: StringView
    nm: StringView
    keyT: StringView
    buf: String.borrow
} is {
    gmId9: (monoMethodReturn
        :symtab
        :monoId
        nameId: (zast.poolFind pool: ast.names text: "getMut")
    )
    if gmId9 == 0 then return
    gmName9: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: gmId9.u64)
    gmv9: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: gmId9.u64)
    gmu9: cUpperOf text: gmName9.stringview
    pm9: "\{runtimeDir}/z_IdMapMut.c.tmpl"
    rawm9: readTemplateCached :ctx path: pm9.stringview
    if rawm9.length == 0 then return
    m1: applyTmpl text: rawm9 key: "NAME" val: nm
    m2: applyTmpl text: m1 key: "KEY_T" val: keyT
    m3: applyTmpl text: m2 key: "OPTIONVIEW_V" val: gmv9.stringview
    m4: applyTmpl text: m3 key: "OPTIONVIEW_V_TAG" val: gmu9.stringview
    buf.append m4
    buf.append "\n"
}

# emitIdMapIters -- the entry projection and the item iterator, from their own
# template. Separate from z_IdMap.c.tmpl for the reason emitMapIters is separate
# from z_Map.c.tmpl: a mono whose `iterateItems` never resolved must still emit
# its container, so the part that needs the iterator types is the part that can
# be skipped.
emitIdMapIters: function {
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    monoId: ztypes.tid
    runtimeDir: StringView
    nm: StringView
    keyT: StringView
    valT: StringView
    buf: String.borrow
} is {
    miiId9: monoMethodReturn :symtab :monoId nameId: zast.wkIterateItems
    if miiId9 == 0 then return
    oveId9: (monoMethodReturn
        :symtab
        monoId: (ztypes.tid.create from: miiId9.u64)
        nameId: zast.wkCall
    )
    if oveId9 == 0 then return
    oveName9: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: oveId9.u64)
    meId9: ztypes.tid
    {
        meo9: (symtab.typing.declChildOfId
            parentTypeId: (ztypes.tid.create from: oveId9.u64)
            nameId: zast.wkSome
        )
        match (
            meo9
        ) case some then {
            meId9 = ztypes.tid.create from: (meo9)
        } case none then null
    }
    if meId9.isZero then return
    mii9: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: miiId9.u64)
    me9: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: meId9.u64)
    ove9: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: oveId9.u64)
    oveu9: cUpperOf text: oveName9.stringview
    pi9: "\{runtimeDir}/z_IdMapIter.c.tmpl"
    rawi9: readTemplateCached :ctx path: pi9.stringview
    if rawi9.length == 0 then return
    j1: applyTmpl text: rawi9 key: "NAME" val: nm
    j2: applyTmpl text: j1 key: "KEY_T" val: keyT
    j3: applyTmpl text: j2 key: "VAL_T" val: valT
    j4: applyTmpl text: j3 key: "IDMAPITEMITER" val: mii9.stringview
    j5: applyTmpl text: j4 key: "IDMAPENTRY" val: me9.stringview
    j6: applyTmpl text: j5 key: "OPTIONVIEW_ENTRY" val: ove9.stringview
    j7: applyTmpl text: j6 key: "OPTIONVIEW_ENTRY_TAG" val: oveu9.stringview
    buf.append j7
    buf.append "\n"
}

# emitIdSetMono -- substitute z_IdSet.c.tmpl for an IdSet instance. Three
# holes: an id item is a scalar, so it has no hash body, no equality body and
# no destructor.
emitIdSetMono: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    nm: cbaseNoPrefix :ctx tid: monoId
    mcr: cUpperOf text: nm.stringview
    elemTid: setElemType :symtab :monoId
    elemName: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: elemTid.u64)
    itemT: (cTypeForNameTid
        :ast
        :symtab
        :ctx
        name: elemName.stringview
        tid: (ztypes.tid.create from: elemTid.u64)
    )
    siId: monoMethodReturn :symtab :monoId nameId: zast.wkIterate
    if siId == 0 then return
    ovId: (monoMethodReturn
        :symtab
        monoId: (ztypes.tid.create from: siId.u64)
        nameId: zast.wkCall
    )
    if ovId == 0 then return
    ovName: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: ovId.u64)
    ov: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: ovId.u64)
    ovu: cUpperOf text: ovName.stringview
    si: cbaseNoPrefix :ctx tid: (ztypes.tid.create from: siId.u64)
    p: "\{runtimeDir}/z_IdSet.c.tmpl"
    raw: readTemplateCached :ctx path: p.stringview
    if raw.length == 0 then return
    t1: applyTmpl text: raw key: "NAME" val: nm.stringview
    t2: applyTmpl text: t1 key: "MACRO" val: mcr.stringview
    t3: applyTmpl text: t2 key: "ITEM_T" val: itemT.stringview
    t4: applyTmpl text: t3 key: "IDSETITER" val: si.stringview
    t5: applyTmpl text: t4 key: "OPTIONVIEW" val: ov.stringview
    t6: applyTmpl text: t5 key: "OPTIONVIEW_TAG" val: ovu.stringview
    buf.append t6
    buf.append "\n"
}

# emitMonos -- emit every collection-mono instance in the registry (List
# today; Map/Set/iterators land with their slices).
# ioCanonTid -- the type id behind an io/cli runtime fragment's canonical stem,
# for the GENERIC INSTANCES only: resolved through the spec trie from
# SOURCE-named parts (Result over filestat and IoError), never by the mangled
# spelling. 0 for a plain source-name stem (File, IoError, Reader), which keeps
# the by-name path, and 0 when the instance was never demanded.
ioCanonTid: function {ast: Ast.view symtab: zenv.ZSymbolTable.view canon: StringView} out u64 is {
    if canon == "Option_StringView" then {
        return (specStemTid :ast :symtab base: "Option" arg1: "StringView" arg2: "")
    }
    if canon == "Option_String" then {
        return (specStemTid :ast :symtab base: "Option" arg1: "String" arg2: "")
    }
    if canon == "OptionView_String" then {
        return (specStemTid :ast :symtab base: "OptionView" arg1: "String" arg2: "")
    }
    if canon == "ListViewVal_u8" then {
        return (specStemTid :ast :symtab base: "ListViewVal" arg1: "u8" arg2: "")
    }
    if canon == "ListVal_u8" then {
        return (specStemTid :ast :symtab base: "ListVal" arg1: "u8" arg2: "")
    }
    if canon == "List_String" then {
        return (specStemTid :ast :symtab base: "ListRef" arg1: "String" arg2: "")
    }
    if canon == "List_PositionalDef" then {
        return (specStemTid :ast :symtab base: "ListRef" arg1: "PositionalDef" arg2: "")
    }
    if canon == "List_OptionDef" then {
        return (specStemTid :ast :symtab base: "ListRef" arg1: "OptionDef" arg2: "")
    }
    if canon == "List_FlagDef" then {
        return (specStemTid :ast :symtab base: "ListRef" arg1: "FlagDef" arg2: "")
    }
    if canon == "Map_String_String" then {
        return (specStemTid :ast :symtab base: "MapRR" arg1: "String" arg2: "String")
    }
    if canon == "Result_filestat_IoError" then {
        rbf9: (specTidArgs
            :symtab
            templateTid: (builtinTid :ast :symtab base: "Result")
            a1: (specTidArgs
                :symtab
                templateTid: (builtinTid :ast :symtab base: "Box")
                a1: (builtinTidInU :ast :symtab unitName: "io" base: "filestat")
                a2: 0)
            a2: (builtinTid :ast :symtab base: "IoError")
        )
        if rbf9 > 0 then return rbf9
        return (specStemTid :ast :symtab base: "Result" arg1: "filestat" arg2: "IoError")
    }
    if canon == "Result_String_IoError" then {
        return (specStemTid :ast :symtab base: "Result" arg1: "String" arg2: "IoError")
    }
    if canon == "Result_File_IoError" then {
        return (specStemTid :ast :symtab base: "Result" arg1: "File" arg2: "IoError")
    }
    if canon == "Result_null_IoError" then {
        return (specStemTid :ast :symtab base: "Result" arg1: "null" arg2: "IoError")
    }
    if canon == "Result_u64_IoError" then {
        rbu9: (specTidArgs
            :symtab
            templateTid: (builtinTid :ast :symtab base: "Result")
            a1: (specTidArgs
                :symtab
                templateTid: (builtinTid :ast :symtab base: "Box")
                a1: (builtinTid :ast :symtab base: "u64")
                a2: 0)
            a2: (builtinTid :ast :symtab base: "IoError")
        )
        if rbu9 > 0 then return rbu9
        return (specStemTid :ast :symtab base: "Result" arg1: "u64" arg2: "IoError")
    }
    if canon == "Result_Listener_IoError" then {
        return (specStemTid :ast :symtab base: "Result" arg1: "Listener" arg2: "IoError")
    }
    if canon == "Result_Conn_IoError" then {
        return (specStemTid :ast :symtab base: "Result" arg1: "Conn" arg2: "IoError")
    }
    if canon == "Result_bool_IoError" then {
        rbb9: (specTidArgs
            :symtab
            templateTid: (builtinTid :ast :symtab base: "Result")
            a1: (specTidArgs
                :symtab
                templateTid: (builtinTid :ast :symtab base: "Box")
                a1: (builtinTid :ast :symtab base: "bool")
                a2: 0)
            a2: (builtinTid :ast :symtab base: "IoError")
        )
        if rbb9 > 0 then return rbb9
        return (specStemTid :ast :symtab base: "Result" arg1: "bool" arg2: "IoError")
    }
    if canon == "Result_Parsed_CliError" then {
        return (specStemTid :ast :symtab base: "Result" arg1: "Parsed" arg2: "CliError")
    }
    if canon == "Result_List_String_IoError" then {
        return (specTidArgs
            :symtab
            templateTid: (builtinTid :ast :symtab base: "Result")
            a1: (specStemTid :ast :symtab base: "ListRef" arg1: "String" arg2: "")
            a2: (builtinTid :ast :symtab base: "IoError")
        )
    }
    # the value-side monos the StringView natives return. A fragment naming one
    # used to need its own loader, because the emitter had to know the stem to
    # bind; stated here, the hole resolves like every other name in a fragment.
    if canon == "optionval_u64" then {
        return (specStemTid :ast :symtab base: "optionval" arg1: "u64" arg2: "")
    }
    if canon == "optionval_u32" then {
        return (specStemTid :ast :symtab base: "optionval" arg1: "u32" arg2: "")
    }
    if canon == "optionval_u8" then {
        return (specStemTid :ast :symtab base: "optionval" arg1: "u8" arg2: "")
    }
    if canon == "resultval_i64_parseerror" then {
        return (specStemTid :ast :symtab base: "resultval" arg1: "i64" arg2: "parseerror")
    }
    if canon == "resultval_u64_parseerror" then {
        return (specStemTid :ast :symtab base: "resultval" arg1: "u64" arg2: "parseerror")
    }
    if canon == "resultval_f64_parseerror" then {
        return (specStemTid :ast :symtab base: "resultval" arg1: "f64" arg2: "parseerror")
    }
    if canon == "resultval_f16_parseerror" then {
        return (specStemTid :ast :symtab base: "resultval" arg1: "f16" arg2: "parseerror")
    }
    if canon == "resultval_f128_parseerror" then {
        return (specStemTid :ast :symtab base: "resultval" arg1: "f128" arg2: "parseerror")
    }
    return 0
}

# ioCanonCname -- memoized wrapper: the canon->cname map is emit-stable and io
# fragments reload the same canons once per unit, so cache each result (incl.
# the "" miss) per program, mirroring resolveByNameC. Avoids re-running the
# O(nextTypeId) registry scan in ioCanonCnameUncached ~30x per canon.
ioCanonCname: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    canon: StringView
} out String is {
    found9: false
    cached9: String
    {
        h9: ctx.ioCanonC.get key: canon.string
        match (
            h9
        ) case some then {
            found9 = true
            cached9 = h9.copy
        } case none then null
    }
    if found9 then return cached9
    r9: ioCanonCnameUncached :ast :symtab :ctx :canon
    ctx.ioCanonC.set key: canon.string value: r9.copy
    return r9
}

# ioCanonCnameUncached -- the id-based cname for an io canonical stem (the part
# after `z_` in a runtime fragment): a mono (Result_*/List_u8/...) via its spec
# trie, else a named system type (IoError/File/filestat/Reader/...) by registry
# name. "" when the type is not in the (demand-driven) registry for this program.
ioCanonTidAny: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    canon: StringView
} out ztypes.tid is {
    st9: ioCanonTid :ast :symtab :canon
    if st9 > 0 then return (ztypes.tid.create from: st9.u64)
    # a plain source-name stem (File, IoError, Reader): the system unit first,
    # then the registry scan below for the io/cli units it does not cover.
    mo: ztypecheck.resolveSystemChild :ast ty: symtab.typing reg: symtab.reg name: canon
    match (
        mo
    ) case some then {
        return (ztypes.tid.create from: mo.u64)
    } case none then null
    last: symtab.reg.nextTypeId
    found: ztypes.tid
    ti: 1.u64
    for ti < last loop {
        if found.isZero then {
            okc9: (definedInNonMain :symtab :ctx tid: (ztypes.tid.create from: ti.u64))
            if (okc9) == false when (originTidOf
                :symtab
                tid: (ztypes.tid.create from: ti.u64)
            ) > 0 then okc9 = true
            if okc9 then {
                if (regNameIs
                    :symtab
                    tid: (ztypes.tid.create from: ti.u64)
                    name: canon
                ) then found = ztypes.tid.create from: ti.u64
            }
        }
        ti = ti + 1
    }
    return found
}

ioCanonCnameUncached: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    canon: StringView
} out String is {
    t9: ioCanonTidAny :ast :symtab :ctx :canon
    if t9.isZero then return "".string
    return (ctxCname :ctx tid: (ztypes.tid.create from: t9.u64))
}

# loadIoFragment -- read an io/cli runtime `.inc` and fill the `z_@Name@`
# holes it spells. The holes found in the file ARE the demand: each name
# resolves through StringView/String or the canon path, and a name that
# resolves to nothing is fatal. Tags (Z_IOERROR_TAG_*) are name-based and
# already match.
loadIoFragment: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    path: StringView
} out String is {
    rd: io.readText :path
    match (
        rd
    ) case ok then {
        bn9: (List String)
        bv9: (List String)
        rwn9: (List String)
        rwv9: (List String)
        names9: holeNames9 text: rd.stringview
        ni9: u64
        nn9: names9.length
        for ni9 < nn9 loop {
            nm9: names9.get i: ni9
            nv9: nm9.stringview
            # `@TAG_<type>@` -- how to reach that type's discriminator. A tagged
            # struct is reached through `.tag`; a type the backend has unwrapped
            # IS its discriminator, and the hole fills with nothing. A fragment
            # spelling this stays correct across a change to the representation,
            # which matters because this file is read by the running compiler
            # AND by the committed seed, and they need not agree.
            if (nv9.startsWith prefix: "TAG_") then {
                tn9: nv9.substring from: 4 to: nv9.length
                tt9: ioCanonTidAny :ast :symtab :ctx canon: tn9
                rwn9.append from: nv9.string
                if (isOrdinalVariant :symtab tid: (ztypes.tid.create from: tt9.u64)) then {
                    rwv9.append from: "".string
                } else {
                    rwv9.append from: ".tag".string
                }
            } else {
                bn9.append from: nv9.string
                if nv9 == "StringView" then {
                    sv9: ctx.svC
                    bv9.append from: sv9.copy
                } else if nv9 == "String" then {
                    st9: ctx.strC
                    bv9.append from: st9.copy
                } else {
                    cc9: ioCanonCname :ast :symtab :ctx canon: nv9
                    bv9.append from: cc9
                }
            }
            ni9 = ni9 + 1
        }
        return (fillHolesCtx9
            :ctx
            text: rd
            :path
            bindNames: bn9
            bindVals: bv9
            rawNames: rwn9
            rawVals: rwv9
        )
    } case err then {
        emitFail :ctx what: "missing io fragment \{path}" line: 0
        return "/* zemitterc: missing io fragment \{path} */\n"
    }
}

# ioFileId -- the io File class type id (0 when File is not reachable).
ioFileId: function {symtab: zenv.ZSymbolTable ctx: Ctx.view} out u64 is {
    last: symtab.reg.nextTypeId
    ti: 1.u64
    for ti < last loop {
        if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: ti.u64)) == ztypes.ztypetype.classType then {
            if (regNameIs :symtab tid: (ztypes.tid.create from: ti.u64) name: "File") then {
                if (definedInNonMain
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: ti.u64)
                ) then return ti
            }
        }
        ti = ti + 1
    }
    return 0
}

# ioFileLive -- the File class is present AND its read/write param monos (the
# byte buffer's element mono / ListView_u8) exist, i.e. a File is actually live
# (constructed / io.open / a file method called). This is the order-independent
# gate for emitting File's natives + Reader/Writer conformance: it is true
# exactly when that emitted code's referenced monos have been demanded, so it
# always compiles.
ioFileLive: function {ast: Ast.view symtab: zenv.ZSymbolTable.view ctx: Ctx.view} out bool is {
    fid9: ioFileId :symtab :ctx
    if fid9 == 0 then return false
    sst186569: specStemTid :ast :symtab base: "ListVal" arg1: "u8" arg2: ""
    if sst186569.isZero then return false
    sst186579: specStemTid :ast :symtab base: "ListViewVal" arg1: "u8" arg2: ""
    if sst186579.isZero then return false
    return true
}

# cliClassTypeId -- the type id of a cli-unit CLASS named `name` (0 absent).
cliClassTypeId: function {
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    nameId: zast.nameid
} out u64 is {
    return (unitClassTid9 :symtab unitDecl: ctx.cliUnitDecl :nameId).u64
}

# isHeapPtrCollection -- a Map/Set mono is stored as a heap pointer (List is
# embedded by value); a struct field of one is a pointer, freed without `&`.
isHeapPtrCollection: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    cm: chaseColMono :symtab :ctx :tid
    if (isMapOriginOf :symtab :ctx tid: (ztypes.tid.create from: cm.u64)) then return true
    if (isSetOriginOf :symtab :ctx tid: (ztypes.tid.create from: cm.u64)) then return true
    return false
}

# cliClassIsComposite -- a cli class holding any List/Map/Set field; such a
# class must be emitted after the collection monos it embeds (Spec/Parsed),
# while leaf classes (FlagDef/OptionDef/PositionalDef) emit before them.
cliClassIsComposite: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    fnames: (List String)
    fids: (ListVal u64)
    fidsNm: (ListVal u64)
    recFieldLists :ast :symtab :tid names: fnames ids: fids nameIds: fidsNm
    fi: u64
    fn0: fnames.length
    for fi < fn0 loop {
        fid: fids.get i: fi
        cm: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: fid.u64)
        if (isListOriginOf :symtab :ctx tid: (ztypes.tid.create from: cm.u64)) then return true
        if (isMapOriginOf :symtab :ctx tid: (ztypes.tid.create from: cm.u64)) then return true
        if (isSetOriginOf :symtab :ctx tid: (ztypes.tid.create from: cm.u64)) then return true
        fi = fi + 1
    }
    return false
}

# bindFragTypeTids9 -- resolve each row's `uses_<Type>` demand to a type id.
# Runs after buildDefUnitIndex so the defining unit is an id question too; a
# name that resolves to nothing leaves 0, and the row keeps its member path.
# The registry scan is the house pattern and runs once over the handful of
# rows the table demand-types.
bindFragTypeTids9: function {symtab: zenv.ZSymbolTable.view ctx: Ctx ast: Ast.view} is {
    last9: symtab.reg.nextTypeId
    i9: u64
    n9: ctx.fragTypeNames.length
    for i9 < n9 loop {
        tn9: ctx.fragTypeNames.get i: i9
        found9: ztypes.tid
        if tn9.length > 0 then {
            un9: ctx.fragUnits.get i: i9
            uid9: unitDeclByName9 :symtab :ast name: un9.stringview
            if uid9 > 0 then {
                ti9: 1.u64
                for ti9 < last9 loop {
                    if found9.isZero then {
                        if (regNameIs
                            :symtab
                            tid: (ztypes.tid.create from: ti9.u64)
                            name: tn9.stringview
                        ) then {
                            du9: defUnitIdOf9 :ctx tid: (ztypes.tid.create from: ti9.u64)
                            if du9 == uid9 then found9 = ztypes.tid.create from: ti9.u64
                        }
                    }
                    ti9 = ti9 + 1
                }
            }
        }
        ctx.fragTypeTids.append found9.u64
        if found9 > 0 then ctx.demandGatedTids.set key: found9.u64 value: true
        i9 = i9 + 1
    }
}

# rowFires9 -- true when ANY demand the row at `i` names was demanded for that
# row's unit. `demand=a,b,c` means ANY OF: a helper several members share is one
# row naming the members that reach it, so it loads once however many fired.
rowFires9: function {ctx: Ctx.view i: u64} out bool is {
    tt9: ctx.fragTypeTids.get :i
    if tt9 > 0 then return (typeIsUsed :ctx tid: (ztypes.tid.create from: tt9.u64))
    u9: ctx.fragUnits.get :i
    d9: ctx.fragMembs.get :i
    fired9: false
    with dit9: (d9.stringview.split sep: ",") do for dm9: dit9 loop {
        if dm9.length > 0 then {
            if (needsHasM :ctx uname: u9.stringview memb: dm9) then fired9 = true
        }
    }
    return fired9
}

# emitRuntimeUnit9 -- one unit's runtime: every row it owns, in TABLE ORDER,
# loaded when its demands fired. This is the whole of what emitRuntimeIo,
# emitRuntimeCli, emitRuntimeOs, emitRuntimeNet, emitRuntimeTcc,
# emitNeededNatives and emitRuntimeSvIter did by hand. The order they spelled is
# the order the rows are written in -- including the alphabetical convention
# runs, because a subset of an alphabetically ordered list, taken in order, is
# already sorted. The per-unit skip lists are gone with them: a member the
# runtime does not supply has no row to walk.
emitRuntimeUnit9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    runtimeDir: StringView
    uname: StringView
    buf: String.borrow
} is {
    i9: u64
    n9: ctx.fragUnits.length
    for i9 < n9 loop {
        u9: ctx.fragUnits.get i: i9
        if u9.stringview == uname then {
            if (rowFires9 :ctx i: i9) then {
                fl9: ctx.fragNames.get i: i9
                with fit9: (fl9.stringview.split sep: ",") do for fr9: fit9 loop {
                    if fr9.length > 0 then {
                        ioFrag :ast :symtab :ctx :runtimeDir frag: fr9 :buf
                    }
                }
            }
        }
        i9 = i9 + 1
    }
}

# emitUnorderedUnits9 -- the units with rows the order directive does not name,
# each once, in the order the table first mentions them. A unit shipping its own
# natives.tbl rows is not in the compiler's list, and this is the slot it gets.
# `prelude` is not one of them: emitC emits it into the header itself.
emitUnorderedUnits9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    runtimeDir: StringView
    buf: String.borrow
} is {
    done9: (List String)
    i9: u64
    n9: ctx.fragUnits.length
    for i9 < n9 loop {
        u9: ctx.fragUnits.get i: i9
        skip9: false
        if u9.stringview == "prelude" then skip9 = true
        with oit9: ctx.unitOrder.iterate do for o9: oit9 loop {
            if o9.stringview == u9.stringview then skip9 = true
        }
        with dit9: done9.iterate do for d9: dit9 loop {
            if d9.stringview == u9.stringview then skip9 = true
        }
        if (skip9) == false then {
            done9.append from: u9.copy
            emitRuntimeUnit9 :ast :symtab :ctx :runtimeDir uname: u9.stringview :buf
        }
        i9 = i9 + 1
    }
}

# ioFrag -- load + append an io runtime fragment unconditionally.
ioFrag: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    runtimeDir: StringView
    frag: StringView
    buf: String.borrow
} is {
    p9: nativePath :runtimeDir :frag
    f9: loadIoFragment :ast :symtab :ctx path: p9.stringview
    buf.append f9
}

# emitIoFileConformance -- protocol conformance helpers for every reachable io
# class (File -> Reader/Writer/Closer/Seeker; BufWriter -> Writer; BufReader ->
# Reader), emitted after the io natives the wrappers forward to.
emitIoFileConformance: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    buf: String.borrow
} is {
    ioUid9: ctx.ioUnitDecl
    osUid9: ctx.osUnitDecl
    cliUid9: ctx.cliUnitDecl
    last: symtab.reg.nextTypeId
    ti: 1.u64
    for ti < last loop {
        if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: ti.u64)) == ztypes.ztypetype.classType then {
            cmo9: originTidOf :symtab tid: (ztypes.tid.create from: ti.u64)
            if cmo9.isZero then {
                duId9: defUnitIdOf9 :ctx tid: (ztypes.tid.create from: ti.u64)
                isIoC9: false
                if duId9 > 0 then {
                    if duId9 == ioUid9 then isIoC9 = true
                    if duId9 == osUid9 then isIoC9 = true
                    if duId9 == cliUid9 then isIoC9 = true
                }
                if isIoC9 then {
                    cn9: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: ti.u64)
                    okEmit9: false
                    if cn9.stringview == "File" then {
                        okEmit9 = ioFileLive :ast :symtab :ctx
                    } else {
                        okEmit9 = typeIsUsed :ctx tid: (ztypes.tid.create from: ti.u64)
                    }
                    if okEmit9 then {
                        (emitProtocolImplsForType
                            :ast
                            :symtab
                            :ctx
                            implTid: (ztypes.tid.create from: ti.u64)
                            :buf
                        )
                    }
                }
            }
        }
        ti = ti + 1
    }
}

# emitIoStdStreams -- io.stdin/stdout/stderr: a borrowed Reader/Writer over a
# static backing File on fd 0/1/2 (closed=true so RAII never closes it).
emitIoStdStreams: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    buf: String.borrow
} is {
    needAny: false
    if (needsHasM :ctx uname: "io" memb: "stdout") then needAny = true
    if (needsHasM :ctx uname: "io" memb: "stderr") then needAny = true
    if (needsHasM :ctx uname: "io" memb: "stdin") then needAny = true
    if (needAny) == false then return
    fid: ioFileId :symtab :ctx
    if fid == 0 then return
    fbase: ctxCname :ctx tid: (ztypes.tid.create from: fid.u64)
    wcn: ioCanonCname :ast :symtab :ctx canon: "Writer"
    rcn: ioCanonCname :ast :symtab :ctx canon: "Reader"
    if (needsHasM :ctx uname: "io" memb: "stdout") then {
        b0: "static \{fbase}_t z_io_stdout_File = { 1, true };\nstatic \{wcn}_t z_io_stdout(void) {\n    return \{fbase}_Writer_create(&z_io_stdout_File);\n}\n\n"
        buf.append b0
    }
    if (needsHasM :ctx uname: "io" memb: "stderr") then {
        b1: "static \{fbase}_t z_io_stderr_File = { 2, true };\nstatic \{wcn}_t z_io_stderr(void) {\n    return \{fbase}_Writer_create(&z_io_stderr_File);\n}\n\n"
        buf.append b1
    }
    if (needsHasM :ctx uname: "io" memb: "stdin") then {
        b2: "static \{fbase}_t z_io_stdin_File = { 0, true };\nstatic \{rcn}_t z_io_stdin(void) {\n    return \{fbase}_Reader_create(&z_io_stdin_File);\n}\n\n"
        buf.append b2
    }
}

# emitIoFileClass -- the io.File value rep: { int32_t fd; bool closed } + a
# destructor that closes the fd once (RAII). Emitted only when File is reachable
# (in the demand-driven registry). The generic record path can't produce the
# close-fd destructor, so File gets this dedicated emitter. The type is marked
# in ctx.emittedUserTypes so every other path skips it -- without that mark a
# by-value use of File would emit a second struct carrying a generic destructor
# that never closes the fd.
emitIoFileClass: function {ctx: Ctx buf: String.borrow} is {
    fid: ztypes.tid.create from: ctx.ioFileTid
    if fid.isZero then return
    ego9: ctx.emittedUserTypes.get key: fid
    match (
        ego9
    ) case some then {
        return
    } case none then null
    ctx.emittedUserTypes.set key: fid.u64 value: true
    fc: ctxCname :ctx tid: fid
    if (isFwdDeclared :ctx tid: fid) then {
        l0: "struct \{fc}_t {\n    int32_t fd;\n    bool closed;\n};\n"
        buf.append l0
    } else {
        l0: "typedef struct {\n    int32_t fd;\n    bool closed;\n} \{fc}_t;\n"
        buf.append l0
    }
    l1: "static void \{fc}_destroy(\{fc}_t* p) {\n    if (!p) return;\n    if (p->closed) return;\n    close(p->fd);\n    p->closed = true;\n}\n\n"
    buf.append l1
}

# emitNetFdClass -- one net fd-holder class ({ int32_t fd; bool closed } + a
# close-once destructor), the net analogue of emitIoFileClass. The net runtime
# fragments dereference the fields, so the body is pre-emitted here and the
# type marked in ctx.emittedUserTypes so the ordered user-struct pass skips it
# (that pass runs after the fragments -- too late).
emitNetFdClass: function {ctx: Ctx tid: u64 buf: String.borrow} is {
    fid: ztypes.tid.create from: tid
    if fid.isZero then return
    ego9: ctx.emittedUserTypes.get key: fid
    match (
        ego9
    ) case some then {
        return
    } case none then null
    ctx.emittedUserTypes.set key: fid.u64 value: true
    fc: ctxCname :ctx tid: fid
    if (isFwdDeclared :ctx tid: fid) then {
        l0: "struct \{fc}_t {\n    int32_t fd;\n    bool closed;\n};\n"
        buf.append l0
    } else {
        l0: "typedef struct {\n    int32_t fd;\n    bool closed;\n} \{fc}_t;\n"
        buf.append l0
    }
    l1: "static void \{fc}_destroy(\{fc}_t* p) {\n    if (!p) return;\n    if (p->closed) return;\n    close(p->fd);\n    p->closed = true;\n}\n\n"
    buf.append l1
}

# emitNetClasses -- the net fd-holder value reps (Listener/Conn), need-gated.
emitNetClasses: function {ctx: Ctx.view buf: String.borrow} is {
    if (needsHasM :ctx uname: "net" memb: "@unit") == false then return
    emitNetFdClass :ctx tid: ctx.netListenerTid :buf
    emitNetFdClass :ctx tid: ctx.netConnTid :buf
}

# maybePreEmitElem -- a user type (variant/record/class/union) used as a
# collection element is embedded BY VALUE by the List/ListView mono, so its
# struct must precede the mono. Emit it here (guarded by ctx.emittedUserTypes);
# its methods still emit later in emitRecordDefsIn. Covers main-unit AND dep
# file-unit element types (the cross-unit Node union returned by value from a
# ListView_Node mono); monos / generics / typedefs and system-unit types (which
# have their own dedicated sweeps above) are skipped.
maybePreEmitElem: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    eid: ztypes.tid
    buf: String.borrow
} is {
    if eid.isZero then return
    rid0: eid
    snm0: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: eid.u64)
    sduo: definedInUnitOf :symtab tid: (ztypes.tid.create from: eid.u64)
    match (
        sduo
    ) case some then null case none then {
        if snm0.length > 0 then {
            srid: (canonTypeId
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: eid.u64)
                name: snm0.stringview
            )
            if srid > 0 then rid0 = ztypes.tid.create from: srid.u64
        }
    }
    cid: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: rid0.u64)
    monoLk4: originTidOf :symtab tid: (ztypes.tid.create from: cid.u64)
    if monoLk4 > 0 then return
    if (isGenericType :symtab tid: (ztypes.tid.create from: cid.u64)) then return
    duoPe: definedInUnitOf :symtab tid: (ztypes.tid.create from: cid.u64)
    peUnit: ctx.mainName.copy
    match (
        duoPe
    ) case some then {
        if (symtab.reg.isNativeOf tid: (ztypes.tid.create from: cid.u64)) then return
        peUnit = duoPe.copy
    } case none then null
    nm: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: cid.u64)
    if nm.length == 0 then return
    tt: symtab.reg.typetypeOf typeId: cid
    smPe: ctx.mainName.copy
    smPeD9: ctx.mainUnitId
    (ctxBindMain
        :ctx
        name: peUnit.stringview
        unitDecl: (ztypecheck.unitDeclOfTid
            ty: symtab.typing
            reg: symtab.reg
            tid: (ztypes.tid.create from: cid.u64)
        ).u64
    )
    if tt == ztypes.ztypetype.variantType then {
        emitOneVariant :ast :symtab :ctx tid: (ztypes.tid.create from: cid.u64) :buf
    }
    if tt == ztypes.ztypetype.recordType then {
        emitOneRecord :ast :symtab :ctx tid: (ztypes.tid.create from: cid.u64) :buf
    }
    if tt == ztypes.ztypetype.classType then {
        emitOneRecord :ast :symtab :ctx tid: (ztypes.tid.create from: cid.u64) :buf
    }
    if tt == ztypes.ztypetype.protocolType then {
        (emitOneProtocol
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: cid.u64)
            name: nm.stringview
            :buf
        )
    }
    if tt == ztypes.ztypetype.facetType then {
        emitOneFacet :ast :symtab :ctx tid: (ztypes.tid.create from: cid.u64) :buf
    }
    if tt == ztypes.ztypetype.unionType then {
        emitUnionMono :ast :symtab :ctx tid: (ztypes.tid.create from: cid.u64) :buf
    }
    ctxBindMain :ctx name: smPe.stringview unitDecl: smPeD9
}

# preEmitEmbeddedTypes -- emit the main-unit user types a variant/record/class
# embeds BY VALUE (arm payloads, field types) before its own struct, so they are
# declared first. Idempotent via ctx.emittedUserTypes, which also breaks cycles.
preEmitEmbeddedTypes: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    ids: (ListVal u64).view
    buf: String.borrow
} is {
    pi: u64
    pn: ids.length
    for pi < pn loop {
        eidv: ids.get i: pi
        maybePreEmitElem :ast :symtab :ctx eid: (ztypes.tid.create from: eidv.u64) :buf
        pi = pi + 1
    }
}

# isFwdDeclared -- the type was forward-declared by emitMainFwdDecls, so its
# body must be emitted as a named `struct X_t { ... };` (the typedef is already
# in the forward-decl block).
isFwdDeclared: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    o: ctx.fwdDeclaredTypes.get key: tid
    match (
        o
    ) case some then {
        return o
    } case none then {
        return false
    }
}

# emitMainFwdDecls -- forward-declare every RECORD + UNION + CLASS type whose
# body this emitter writes (named-struct typedef + a destructor prototype)
# before the monos. The AST is a self-referential Node union: Node_destroy +
# the Option/List monos + the print functions reference Node and the arm *Data
# structs by pointer (or call their destroys) ahead of the bodies, so without
# forward declarations they are undeclared. The bodies then emit as plain
# `struct X_t { ... };` via isFwdDeclared.
#
# Which types those are is a question for the DECLARATION, not for the unit's
# name. `is native` on a class or record means the RUNTIME owns the layout: the
# sixteen scalars, String and StringView, and the sviter iterators all get their
# C from a fragment, and a forward declaration of one is a conflicting typedef
# -- LinesIter's fragment is `typedef z_Splitter_t z_LinesIter_t;`, an ALIAS
# that no `typedef struct X_t X_t;` can ever be made compatible with. Everything
# else this pass reaches is a struct the emitter writes, whichever unit declared
# it, so io's File and cli's Spec are forward-declared on the same terms as a
# user record -- and a USER type shadowing a builtin name carries no marker, so
# it keeps its forward declaration and its own layout.
#
# The two synthesized `tag__{elem}` carriers reach this pass and are forward-
# declared with it. Nothing names them in the C, so the declaration is dead but
# valid; measured, no structural property separates them from a real type here
# (their registry def is their own, not their unit root, which is what a
# synthesized type otherwise looks like).
emitMainFwdDecls: function {symtab: zenv.ZSymbolTable ctx: Ctx buf: String.borrow} is {
    last: symtab.reg.nextTypeId
    t: ztypes.tid
    for t < last loop {
        tt: symtab.reg.typetypeOf typeId: t
        isStructType: false
        isUnion: false
        if tt == ztypes.ztypetype.recordType then isStructType = true
        if tt == ztypes.ztypetype.unionType then {
            isStructType = true
            isUnion = true
        }
        if tt == ztypes.ztypetype.classType then isStructType = true
        if isStructType then {
            gen: isGenericType :symtab tid: (ztypes.tid.create from: t.u64)
            mo: originTidOf :symtab tid: (ztypes.tid.create from: t.u64)
            if mo.isZero when gen == false then {
                duo: definedInUnitOf :symtab tid: (ztypes.tid.create from: t.u64)
                match (
                    duo
                ) case some then {
                    if (symtab.reg.isNativeOf tid: (ztypes.tid.create from: t.u64)) == false then {
                        if (isTypedefType
                            :symtab
                            tid: (ztypes.tid.create from: t.u64)
                        ) == false when (isBoxTid :symtab tid: t) == false then {
                            cn: ctxCname :ctx tid: (ztypes.tid.create from: t.u64)
                            ctx.fwdDeclaredTypes.set key: t.u64 value: true
                            l0: "typedef struct \{cn}_t \{cn}_t;\n"
                            buf.append l0
                            needDtor: isUnion
                            if (symtab.reg.hasDestructorName typeId: t) then needDtor = true
                            if needDtor then {
                                l1: "static void \{cn}_destroy(\{cn}_t* p);\n"
                                buf.append l1
                            }
                        }
                    }
                } case none then null
            } else {
                fwdM9: false
                if mo > 0 then {
                    if (symtab.reg.hasDestructorName typeId: t) then fwdM9 = true
                    if (isListOriginOf
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: t.u64)
                    ) then fwdM9 = true
                    if (isListViewOriginOf
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: t.u64)
                    ) then fwdM9 = true
                    if (isSetOriginOf
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: t.u64)
                    ) then fwdM9 = true
                    if (isMapOriginOf
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: t.u64)
                    ) then fwdM9 = true
                }
                if (isBoxTid :symtab tid: (ztypes.tid.create from: t.u64)) then fwdM9 = false
                if fwdM9 then {
                    cnX: ctxCname :ctx tid: (ztypes.tid.create from: t.u64)
                    ctx.fwdDeclaredTypes.set key: t.u64 value: true
                    lx0: "typedef struct \{cnX}_t \{cnX}_t;\n"
                    buf.append lx0
                    fwdDtor9: false
                    if (symtab.reg.hasDestructorName typeId: t) then fwdDtor9 = true
                    if (isMapOriginOf
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: t.u64)
                    ) then fwdDtor9 = true
                    if (isSetOriginOf
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: t.u64)
                    ) then fwdDtor9 = true
                    if fwdDtor9 then {
                        lx1: "static void \{cnX}_destroy(\{cnX}_t* p);\n"
                        buf.append lx1
                    }
                }
            }
        }
        t = ztypes.tid.create from: (t + 1)
    }
}

# monoMapKV -- a Map/MapEntry mono's value + key type ids. The port has no
# concrete generic-arg rows on monos (setGenericArg stamps a 0 placeholder), so
# resolve the value via the get-return OptionView's element name and the key via
# the mangled-name remainder, mirroring emitMapMono.
monoMapKV: function {symtab: zenv.ZSymbolTable monoId: ztypes.tid acc: ListVal u64} is {
    go: symtab.typing.declChildOfId parentTypeId: monoId nameId: zast.wkGet
    match (
        go
    ) case some then {
        vid: mapValType :symtab monoId: (ztypes.tid.create from: monoId.u64)
        if vid > 0 then acc.append vid
        kid: mapKeyType :symtab :monoId
        if kid > 0 then acc.append kid
    } case none then null
}

# monoElemIdsOf -- the type ids a collection/wrapper mono references by its
# element/key/value (List/ListView/Set/Map) or arm payloads (optionval/resultval/
# Option/Result/OptionView), or its fields for a user-generic record/class mono.
# Used by the early/late split to find which monos embed a user type.
monoElemIdsOf: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    monoId: ztypes.tid
    acc: ListVal u64
} is {
    isLV: false
    if (isListOriginOf :symtab :ctx tid: monoId) then isLV = true
    if (isListViewOriginOf :symtab :ctx tid: monoId) then isLV = true
    if isLV then {
        e: listElemType :symtab :monoId
        if e > 0 then acc.append e
        return
    }
    if (isSetOriginOf :symtab :ctx tid: monoId) then {
        eid: setElemType :symtab :monoId
        if eid > 0 then acc.append eid
        return
    }
    if (isMapOriginOf :symtab :ctx tid: monoId) then {
        monoMapKV :symtab :monoId :acc
        return
    }
    # the id-keyed pair read their element types the same way their hashed
    # siblings do. They need an arm of their own because, unlike a Map, they
    # are STACK structs: an IdMap embedding a user type by value is a real
    # ordering edge, and without this it looks like it embeds nothing and is
    # emitted ahead of the optionval its `get` returns.
    if (isIdSetOriginOf :symtab :ctx tid: monoId) then {
        ideid9: setElemType :symtab :monoId
        if ideid9 > 0 then acc.append ideid9
        return
    }
    if (isIdMapOriginOf :symtab :ctx tid: monoId) then {
        monoMapKV :symtab :monoId :acc
        return
    }
    isWrap: false
    if (originIsTid :symtab tid: monoId originTid: ctx.optionvalOriginTid) then isWrap = true
    if (originIsTid :symtab tid: monoId originTid: ctx.resultvalOriginTid) then isWrap = true
    if (originIsTid :symtab tid: monoId originTid: ctx.optionOriginTid) then isWrap = true
    if (originIsTid :symtab tid: monoId originTid: ctx.resultOriginTid) then isWrap = true
    if (originIsTid :symtab tid: monoId originTid: ctx.optionViewOriginTid) then isWrap = true
    if isWrap then {
        anames: (List String)
        aids: (ListVal u64)
        aidsNm: (ListVal u64)
        variantArms :ast :symtab tid: monoId names: anames ids: aids nameIds: aidsNm
        ai: u64
        an: aids.length
        for ai < an loop {
            av: aids.get i: ai
            acc.append av
            ai = ai + 1
        }
        return
    }
    fnames: (List String)
    fids: (ListVal u64)
    fidsNm: (ListVal u64)
    recFieldLists :ast :symtab tid: monoId names: fnames ids: fids nameIds: fidsNm
    fi: u64
    fn: fids.length
    for fi < fn loop {
        fv: fids.get i: fi
        acc.append fv
        fi = fi + 1
    }
}

# buildUserTypeList -- every struct type whose C body this emitter writes:
# RECORD / CLASS / UNION / VARIANT / FACET that is not a mono, not a generic
# template, and whose layout the runtime does not own. A mono embedding one of
# these by value must be emitted after it. Types a fragment row demand-gates
# join only once the program constructs them, on the same terms the sweep's
# own drain applies -- without that the list would emit an io wrapper class
# into every program that merely imports io.
buildUserTypeList: function {symtab: zenv.ZSymbolTable ctx: Ctx.view acc: ListVal u64} is {
    last: symtab.reg.nextTypeId
    t: ztypes.tid
    for t < last loop {
        tt: symtab.reg.typetypeOf typeId: t
        isStruct: false
        if tt == ztypes.ztypetype.recordType then isStruct = true
        if tt == ztypes.ztypetype.classType then isStruct = true
        if tt == ztypes.ztypetype.unionType then isStruct = true
        if tt == ztypes.ztypetype.variantType then isStruct = true
        if tt == ztypes.ztypetype.facetType then isStruct = true
        if isStruct then {
            mo: originTidOf :symtab tid: (ztypes.tid.create from: t.u64)
            gen: isGenericType :symtab tid: (ztypes.tid.create from: t.u64)
            if mo.isZero when gen == false then {
                duo: definedInUnitOf :symtab tid: (ztypes.tid.create from: t.u64)
                match (
                    duo
                ) case some then {
                    emOk9: (symtab.reg.isNativeOf
                        tid: (ztypes.tid.create from: t.u64)
                    ) == false
                    if emOk9 when (typeDemandMet
                        :ctx
                        tid: (ztypes.tid.create from: t.u64)
                    ) then acc.append t.u64
                } case none then null
            }
        }
        t = ztypes.tid.create from: (t + 1)
    }
}

# monoDependsOnUser -- does the mono's layout reference a user type, directly or
# through a nested mono? Mirrors the reference _mono_depends_on_user; the seen
# list breaks cycles through boxed monos.
monoDependsOnUser: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    monoId: ztypes.tid
    userList: (ListVal u64).view
    seen: ListVal u64
} out bool is {
    if (seen.contains item: monoId) then return false
    seen.append monoId.u64
    elems: (ListVal u64)
    monoElemIdsOf :ast :symtab :ctx :monoId acc: elems
    ei: u64
    en: elems.length
    for ei < en loop {
        eid: elems.get i: ei
        ceid: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: eid.u64)
        if (userList.contains item: ceid) then return true
        emo: originTidOf :symtab tid: (ztypes.tid.create from: ceid.u64)
        if emo > 0 then {
            if (monoDependsOnUser
                :ast
                :symtab
                :ctx
                monoId: (ztypes.tid.create from: ceid.u64)
                :userList
                :seen
            ) then return true
        }
        ei = ei + 1
    }
    return false
}

# monoIsLate -- the mono embeds a user type by value (a fresh seen per query).
monoIsLate: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    monoId: ztypes.tid
    userList: (ListVal u64).view
} out bool is {
    seen: (ListVal u64)
    return (monoDependsOnUser :ast :symtab :ctx :monoId :userList :seen)
}

# idSetHas -- membership in a Map-u64-bool id set.
idSetHas: function {s: (MapVV u64 value: bool) id: u64} out bool is {
    got: s.get key: id
    match (
        got
    ) case some then {
        return got
    } case none then {
        return false
    }
}

# userDefnRefsUnemitted -- does the user type have a by-value field whose type is
# in groupList but not yet in emittedList? Map/Set fields are heap pointers in the
# port (fwd-decl suffices) so they impose no ordering edge; a UNION is boxed so it
# is never dragged by its own arms. Passing an empty emittedList answers the plain
# "references any group member" question used by the late-type closure.
userDefnRefsUnemitted: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    typeId: ztypes.tid
    group: (MapVV u64 value: bool)
    emitted: (MapVV u64 value: bool)
} out bool is {
    tt: symtab.reg.typetypeOf :typeId
    if tt == ztypes.ztypetype.unionType then return false
    fnames: (List String)
    fids: (ListVal u64)
    if tt == ztypes.ztypetype.variantType then {
        fidsNm: (ListVal u64)
        variantArms :ast :symtab tid: typeId names: fnames ids: fids nameIds: fidsNm
    } else if tt == ztypes.ztypetype.facetType then {
        # a facet's ordering edges are its conforming impls (embedded by
        # value in the data union), not record fields
        facetImplTids :symtab tid: typeId acc: fids
    } else {
        fidsNm: (ListVal u64)
        recFieldLists :ast :symtab tid: typeId names: fnames ids: fids nameIds: fidsNm
    }
    fi: u64
    fn: fids.length
    for fi < fn loop {
        fid: fids.get i: fi
        cfid: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: fid.u64)
        skip: isHeapPtrCollection :symtab :ctx tid: (ztypes.tid.create from: fid.u64)
        if skip == false then {
            if (idSetHas s: group id: cfid) then {
                if (idSetHas s: emitted id: cfid) == false then return true
            }
        }
        fi = fi + 1
    }
    return false
}

# monoLateDepsMet -- every late-group member the mono references by value is
# already emitted (so the mono can be emitted now).
monoLateDepsMet: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    monoId: ztypes.tid
    group: (MapVV u64 value: bool)
    emitted: (MapVV u64 value: bool)
    seen: ListVal u64
} out bool is {
    if (seen.contains item: monoId) then return true
    seen.append monoId.u64
    elems: (ListVal u64)
    monoElemIdsOf :ast :symtab :ctx :monoId acc: elems
    ei: u64
    en: elems.length
    for ei < en loop {
        eid: elems.get i: ei
        ceid: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: eid.u64)
        if (idSetHas s: group id: ceid) then {
            if (idSetHas s: emitted id: ceid) == false then return false
        }
        emo: originTidOf :symtab tid: (ztypes.tid.create from: ceid.u64)
        if emo > 0 then {
            if (monoLateDepsMet
                :ast
                :symtab
                :ctx
                monoId: (ztypes.tid.create from: ceid.u64)
                :group
                :emitted
                :seen
            ) == false then return false
        }
        ei = ei + 1
    }
    return true
}

# emitUserTypeById -- emit one user RECORD/CLASS/UNION/VARIANT/PROTOCOL struct by
# id, with ctx.mainName set to its defining unit (cross-unit create macros and
# resolution read it). Idempotent via ctx.emittedUserTypes inside each emitter.
emitUserTypeById: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    tid: ztypes.tid
    buf: String.borrow
} is {
    nm: typeNameOfReg9 :symtab :tid
    if nm.length == 0 then return
    duo: definedInUnitOf :symtab :tid
    sm: ctx.mainName.copy
    smD9: ctx.mainUnitId
    match (
        duo
    ) case some then {
        (ctxBindMain
            :ctx
            name: duo.stringview
            unitDecl: (ztypecheck.unitDeclOfTid ty: symtab.typing reg: symtab.reg :tid).u64
        )
    } case none then null
    tt: symtab.reg.typetypeOf typeId: tid
    if tt == ztypes.ztypetype.variantType then (emitOneVariant
        :ast
        :symtab
        :ctx
        :tid
        :buf
    )
    if tt == ztypes.ztypetype.recordType then (emitOneRecord
        :ast
        :symtab
        :ctx
        :tid
        :buf
    )
    if tt == ztypes.ztypetype.classType then (emitOneRecord
        :ast
        :symtab
        :ctx
        :tid
        :buf
    )
    if tt == ztypes.ztypetype.unionType then (emitUnionMono
        :ast
        :symtab
        :ctx
        :tid
        :buf
    )
    if tt == ztypes.ztypetype.protocolType then {
        emitOneProtocol :ast :symtab :ctx :tid name: nm.stringview :buf
    }
    if tt == ztypes.ztypetype.facetType then {
        emitOneFacet :ast :symtab :ctx :tid :buf
    }
    ctxBindMain :ctx name: sm.stringview unitDecl: smD9
}

# emitMonoById -- emit one late collection/variant mono by id (dispatch on origin).
emitMonoById: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    runtimeDir: StringView
    monoId: ztypes.tid
    buf: String.borrow
} is {
    if (originIsTid :symtab tid: monoId originTid: ctx.optionvalOriginTid) then {
        emitOneVariant :ast :symtab :ctx tid: monoId :buf
        return
    }
    if (originIsTid :symtab tid: monoId originTid: ctx.resultvalOriginTid) then {
        emitOneVariant :ast :symtab :ctx tid: monoId :buf
        return
    }
    if (isListViewOriginOf :symtab :ctx tid: monoId) then {
        emitListViewMono :ast :symtab :ctx :runtimeDir :monoId :buf
        return
    }
    if (originIsTid :symtab tid: monoId originTid: ctx.arrayOriginTid) then {
        emitArrayMono :ast :symtab :ctx :runtimeDir :monoId :buf
        return
    }
    if (isListOriginOf :symtab :ctx tid: monoId) then {
        emitListMono :ast :symtab :ctx :runtimeDir :monoId :buf
        return
    }
    if (isSetOriginOf :symtab :ctx tid: monoId) then {
        emitSetMono :ast :symtab :ctx :runtimeDir :monoId :buf
        return
    }
    if (isMapOriginOf :symtab :ctx tid: monoId) then {
        emitMapMono :ast :symtab :ctx :runtimeDir :monoId :buf
        return
    }
    if (isIdSetOriginOf :symtab :ctx tid: monoId) then {
        emitIdSetMono :ast :symtab :ctx :runtimeDir :monoId :buf
        return
    }
    if (isIdMapOriginOf :symtab :ctx tid: monoId) then {
        emitIdMapMono :ast :symtab :ctx :runtimeDir :monoId :buf
        return
    }
}

# emitUserStructsOrdered -- emit user struct defs and the collection monos that
# embed them by value in dependency order, resolving the bidirectional
# constraint: a user record embeds an early (system-element) mono, while a late
# mono embeds a user type. Order: protocols -> early-user structs -> a fixpoint
# interleaving late monos and late-user structs. Mirrors the reference emitter's
# early/late split + fixpoint (zemitterc.py). The early collection monos and the
# system scaffolding are already emitted by emitMonos; this owns user struct
# layout (emitRecordDefsIn phase 1 no longer emits structs).
# collectLateMonosKind -- append late monos of one origin to acc. Called in
# kind-priority order so a mono returned by value by another (List.listview ->
# ListView, Map.get -> optionval) is collected, and thus emitted, before it.
collectLateMonosKind: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    originTid: ztypes.tid
    userList: (ListVal u64).view
    acc: ListVal u64
    last: u64
} is {
    tm: ztypes.tid
    for tm < last loop {
        if (originIsTid :symtab tid: tm :originTid) then {
            if (monoIsLate
                :ast
                :symtab
                :ctx
                monoId: (ztypes.tid.create from: tm.u64)
                :userList
            ) then acc.append tm.u64
        }
        tm = ztypes.tid.create from: (tm + 1)
    }
}

# fnptrTypedefEligible -- a FUNCTION type worth a `_ft` typedef: a real spec /
# free function / method defined in an emittable unit. Synthetic create/==/!=
# carry no declaration; generic templates and monos are skipped.
# stdFnRefEmittable -- a FUNCTION worth a reference cname / _ft typedef:
# emittable-unit fns always; a runtime-backed unit's fn only when it is a
# BODIED (non-native), DEMANDED free fn (natives keep routing through the
# declaration-driven call emitter and have no id-cname definition).
stdFnRefEmittable: function {ast: Ast.view symtab: zenv.ZSymbolTable fid: ztypes.tid} out bool is {
    duo9: definedInUnitOf :symtab tid: fid
    match (
        duo9
    ) case some then {
        if (isEmittableFileUnit name: duo9.stringview) then return true
        if (fnIsNativeId :symtab :fid) then return false
        # demand is recorded under the composed "unit.fn" key; read the fn
        # name off the id-keyed registry entry to compose it
        fnm9: symtab.reg.nameOf tid: fid
        if fnm9.length == 0 then return false
        return (stdFnUndemanded
            :ast
            :symtab
            unitName: duo9.stringview
            fnName: fnm9.stringview
            ownerTid: ztypes.tid
            wantWalked: false
        ) == false
    } case none then {
        return false
    }
}

# true when type `tid` needs a function-pointer typedef.
fnptrTypedefEligible: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out bool is {
    if (isGenericType :symtab :tid) then return false
    mo: originTidOf :symtab :tid
    if mo > 0 then return false
    return (stdFnRefEmittable :ast :symtab fid: (ztypes.tid.create from: tid.u64))
}

# fnRegReturnId -- a FUNCTION type's registered return type id (0 when none).
fnRegReturnId: function {symtab: zenv.ZSymbolTable tid: ztypes.tid} out ztypes.tid is {
    return (symtab.reg.returnTypeOf :tid)
}

# fnptrRetTypeC -- C return type for a FUNCTION's `_ft` typedef. The return type
# is read from funcReturnNode (the registry returnTypeId is not populated for
# top-level functions) via the node stamp, mirroring fnReturnTypeId.
fnptrRetTypeC: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
} out String is {
    rtid: ztypes.tid
    rno: symtab.typing.funcReturnNode.get key: tid
    match (
        rno
    ) case some then {
        rtid = stampIdOf :symtab nid: rno
    } case none then null
    if rtid.isZero then rtid = fnRegReturnId :symtab :tid
    if rtid.isZero then return "void".string
    rn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: rtid.u64)
    if rtid == ctx.strTid then return "\{ctx.strC}_t"
    if rtid == ctx.svTid then return "\{ctx.svC}_t"
    rc: scalarCTypeFor :symtab name: rn.stringview tid: (ztypes.tid.create from: rtid.u64)
    if rc.length > 0 then return rc
    rr: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: rtid.u64) thisTid: ztypes.tid
    if rr.length > 0 then return rr
    return "int64_t".string
}

# fnptrParamTypeC -- C type for one param of a FUNCTION's `_ft` typedef, applying
# the same pointer promotions as fnSignature so the typedef matches the emitted
# signature.
fnptrParamTypeC: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    fid: ztypes.tid
    pname: StringView
    pid: ztypes.tid
} out String is {
    ct: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: pid.u64) thisTid: ztypes.tid
    ptrp: paramTypeIsPointer :ast :symtab :ctx :fid :pname :pid
    if ptrp then {
        if ct.length > 0 then {
            ctp: "\{ct}*"
            ct = ctp
        }
    }
    if ct.length == 0 then return "int64_t".string
    return ct
}

# ensureFwdStruct -- forward-declare a user record/class referenced by a fnptr
# typedef (a pointer-to-incomplete or uncalled by-value return typedef is legal
# C). Guarded so emitUserStructsOrdered later emits the named struct body.
ensureFwdStruct: function {
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    nmS: typeNameOfReg9 :symtab :tid
    cTypeLk5: scalarCTypeFor :symtab name: nmS.stringview :tid
    if cTypeLk5.length > 0 then return
    duo5: definedInUnitOf :symtab :tid
    match (
        duo5
    ) case some then {
        if (symtab.reg.isNativeOf tid: (ztypes.tid.create from: tid.u64)) then return
    } case none then null
    # a typedef wrapper (Path over String) has no struct of its own -- its C
    # spelling is the wrapped type, so a forward struct tag would name nothing
    if (isTypedefType :symtab tid: (ztypes.tid.create from: tid.u64)) then return
    tt: symtab.reg.typetypeOf typeId: tid
    isStruct: false
    if tt == ztypes.ztypetype.recordType then isStruct = true
    if tt == ztypes.ztypetype.classType then isStruct = true
    if isStruct then {
        if (originIsTid :symtab :tid originTid: ctx.strOriginTid) then isStruct = false
        if (originIsTid :symtab :tid originTid: ctx.arrayOriginTid) then isStruct = false
    }
    if isStruct then {
        o: ctx.fwdDeclaredTypes.get key: tid
        match (
            o
        ) case some then null case none then {
            cn: ctxCname :ctx :tid
            ctx.fwdDeclaredTypes.set key: tid.u64 value: true
            l0: "typedef struct \{cn}_t \{cn}_t;\n"
            buf.append l0
        }
    }
}

# emitOneFnptrTypedef -- emit one `typedef RET (*<cname>_ft)(PARAMS);`,
# dependency-first (fnptr-typed params emitted before this one) with referenced
# structs forward-declared. `seen` dedupes by tid.
# isComplexFnptrParam -- a PROTOCOL/FACET/UNION/VARIANT type is not cleanly
# forward-declarable as a by-value fnptr param/return (vtable fat pointers,
# anonymous tagged-union structs); a function using one is never an fnptr value.
isComplexFnptrParam: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    nm: typeNameOfReg9 :symtab :tid
    ct: tid
    can: canonFnId :ast :symtab :ctx :tid name: nm.stringview
    if can > 0 then ct = ztypes.tid.create from: can.u64
    tt: symtab.reg.typetypeOf typeId: ct
    if tt == ztypes.ztypetype.protocolType then return true
    if tt == ztypes.ztypetype.facetType then return true
    if tt == ztypes.ztypetype.unionType then return true
    if tt == ztypes.ztypetype.variantType then return true
    return false
}

# emit one function-pointer typedef.
emitOneFnptrTypedef: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    tid: ztypes.tid
    seen: ListVal u64
    fnOwner: (MapVV u64 value: u64)
    buf: String.borrow
} is {
    if (seen.contains item: tid) then return
    seen.append tid.u64
    pNames: (List String)
    pIds: (ListVal u64)
    pIdsNm: (ListVal u64)
    recFieldLists :ast :symtab :tid names: pNames ids: pIds nameIds: pIdsNm
    # A method's `this`/self-typed receiver child is a fresh shell named after
    # the owner; resolve it to the owner's canonical id so the typedef matches
    # the method's emitted signature (a by-name canonicalization can land on an
    # unrelated same-named type, e.g. a stdlib generic template).
    ownT9: ztypes.tid
    fno9: fnOwner.get key: tid
    match (
        fno9
    ) case some then {
        ownT9 = ztypes.tid.create from: (fno9)
    } case none then null
    ownNm9: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: ownT9.u64)
    rIds9: (ListVal u64)
    ri9: u64
    rn9: pIds.length
    for ri9 < rn9 loop {
        rpv9: pIds.get i: ri9
        if ownT9 > 0 then {
            rpn9: pNames.get i: ri9
            rtn9: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: rpv9.u64)
            isRecv9: false
            if rpn9.stringview == "this" then isRecv9 = true
            if rtn9.stringview == "this" then isRecv9 = true
            if rtn9.stringview == ownNm9.stringview then isRecv9 = true
            if rpv9 == ownT9 then isRecv9 = true
            if isRecv9 then rpv9 = ownT9
        }
        rIds9.append rpv9.u64
        ri9 = ri9 + 1
    }
    skipIt9: false
    sj9: u64
    sn9: pIds.length
    for sj9 < sn9 loop {
        spid9: rIds9.get i: sj9
        if (isComplexFnptrParam
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: spid9.u64)
        ) then skipIt9 = true
        sj9 = sj9 + 1
    }
    srt9: fnRegReturnId :symtab :tid
    if srt9.isZero then {
        srno9: symtab.typing.funcReturnNode.get key: tid
        match (
            srno9
        ) case some then {
            srt9 = stampIdOf :symtab nid: srno9
        } case none then null
    }
    if srt9 > 0 then {
        if (isComplexFnptrParam
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: srt9.u64)
        ) then skipIt9 = true
    }
    if skipIt9 then return
    di: u64
    dn: pIds.length
    for di < dn loop {
        pidd: rIds9.get i: di
        if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: pidd.u64)) == ztypes.ztypetype.functionType then {
            (emitOneFnptrTypedef
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: pidd.u64)
                :seen
                :fnOwner
                :buf
            )
        }
        ensureFwdStruct :symtab :ctx tid: (ztypes.tid.create from: pidd.u64) :buf
        di = di + 1
    }
    rtid: fnRegReturnId :symtab :tid
    if rtid > 0 then ensureFwdStruct :symtab :ctx tid: (ztypes.tid.create from: rtid.u64) :buf
    params: String
    pi: u64
    pn: pNames.length
    for pi < pn loop {
        pnm: pNames.get i: pi
        pidp: rIds9.get i: pi
        pct: (fnptrParamTypeC
            :ast
            :symtab
            :ctx
            fid: (ztypes.tid.create from: tid.u64)
            pname: pnm.stringview
            pid: (ztypes.tid.create from: pidp.u64)
        )
        if pi > 0 then params.append ", "
        params.append pct
        pi = pi + 1
    }
    if pn == 0 then params.append "void"
    retc: fnptrRetTypeC :ast :symtab :ctx :tid
    cb: ctxCname :ctx :tid
    line: "typedef \{retc} (*\{cb}_ft)(\{params});\n"
    buf.append line
}

# emitFnptrTypedefs -- one `_ft` typedef per eligible user FUNCTION value-type so
# typeRefC's FUNCTION case (`<cname>_ft`) resolves at struct fields, params,
# locals, and signatures. Emitted before the user structs that embed them.
emitFnptrTypedefs: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    buf: String.borrow
} is {
    last: symtab.reg.nextTypeId
    seen: (ListVal u64)
    # method FUNCTION tid -> owning object tid, for receiver-param resolution
    fnOwner: (MapVV u64 value: u64)
    {
        fowP0: (ListVal u64)
        fowN0: (ListVal u64)
        fowT0: (ListVal u64)
        (symtab.typing.declAllMemberRows
            lastTid: symtab.reg.nextTypeId
            owners: fowP0
            names: fowN0
            tids: fowT0
        )
        fk0: u64
        fn0: fowP0.length
        for fk0 < fn0 loop {
            fp0: fowP0.get i: fk0
            fco: fowT0.get i: fk0
            fk0 = fk0 + 1
            if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: fco.u64)) == ztypes.ztypetype.functionType then {
                fpt0: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: fp0.u64)
                isObj0: false
                if fpt0 == ztypes.ztypetype.recordType then isObj0 = true
                if fpt0 == ztypes.ztypetype.classType then isObj0 = true
                if fpt0 == ztypes.ztypetype.unionType then isObj0 = true
                if fpt0 == ztypes.ztypetype.variantType then isObj0 = true
                if fpt0 == ztypes.ztypetype.protocolType then isObj0 = true
                if fpt0 == ztypes.ztypetype.facetType then isObj0 = true
                if isObj0 then fnOwner.set key: fco value: fp0
            }
        }
    }
    t0: ztypes.tid
    for t0 < last loop {
        if (symtab.reg.typetypeOf typeId: t0) == ztypes.ztypetype.functionType then {
            if (fnptrTypedefEligible :ast :symtab tid: t0) then {
                (emitOneFnptrTypedef
                    :ast
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: t0.u64)
                    :seen
                    :fnOwner
                    :buf
                )
            }
        }
        t0 = ztypes.tid.create from: (t0 + 1)
    }
}

# emit the user struct definitions in dependency order.
emitUserStructsOrdered: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    runtimeDir: StringView
    buf: String.borrow
} is {
    last: symtab.reg.nextTypeId
    userList: (ListVal u64)
    buildUserTypeList :symtab :ctx acc: userList
    # user PROTOCOLs upfront (fat pointer; no by-value user embedding)
    tp: ztypes.tid
    for tp < last loop {
        if (symtab.reg.typetypeOf typeId: tp) == ztypes.ztypetype.protocolType then {
            pgen: isGenericType :symtab tid: tp
            pmo: originTidOf :symtab tid: tp
            if pmo.isZero when pgen == false then {
                pduo: definedInUnitOf :symtab tid: tp
                match (
                    pduo
                ) case some then {
                    if (symtab.reg.isNativeOf tid: tp) == false then {
                        (emitUserTypeById
                            :ast
                            :symtab
                            :ctx
                            tid: (ztypes.tid.create from: tp.u64)
                            :buf
                        )
                    }
                } case none then null
            }
        }
        tp = ztypes.tid.create from: (tp + 1)
    }
    # late collection/variant monos (the by-value kinds embedding a user type)
    lateGroup: (ListVal u64)
    (collectLateMonosKind
        :ast
        :symtab
        :ctx
        originTid: ctx.optionvalOriginTid
        :userList
        acc: lateGroup
        :last
    )
    (collectLateMonosKind
        :ast
        :symtab
        :ctx
        originTid: ctx.resultvalOriginTid
        :userList
        acc: lateGroup
        :last
    )
    (collectLateMonosKind
        :ast
        :symtab
        :ctx
        originTid: ctx.listViewOriginTid
        :userList
        acc: lateGroup
        :last
    )
    (collectLateMonosKind
        :ast
        :symtab
        :ctx
        originTid: ctx.listViewValOriginTid
        :userList
        acc: lateGroup
        :last
    )
    (collectLateMonosKind
        :ast
        :symtab
        :ctx
        originTid: ctx.listOriginTid
        :userList
        acc: lateGroup
        :last
    )
    (collectLateMonosKind
        :ast
        :symtab
        :ctx
        originTid: ctx.listValOriginTid
        :userList
        acc: lateGroup
        :last
    )
    (collectLateMonosKind
        :ast
        :symtab
        :ctx
        originTid: ctx.setOriginTid
        :userList
        acc: lateGroup
        :last
    )
    (collectLateMonosKind
        :ast
        :symtab
        :ctx
        originTid: ctx.setValOriginTid
        :userList
        acc: lateGroup
        :last
    )
    (collectLateMonosKind
        :ast
        :symtab
        :ctx
        originTid: ctx.mapOriginTid
        :userList
        acc: lateGroup
        :last
    )
    (collectLateMonosKind
        :ast
        :symtab
        :ctx
        originTid: ctx.mapRVOriginTid
        :userList
        acc: lateGroup
        :last
    )
    (collectLateMonosKind
        :ast
        :symtab
        :ctx
        originTid: ctx.idSetOriginTid
        :userList
        acc: lateGroup
        :last
    )
    (collectLateMonosKind
        :ast
        :symtab
        :ctx
        originTid: ctx.idMapROriginTid
        :userList
        acc: lateGroup
        :last
    )
    (collectLateMonosKind
        :ast
        :symtab
        :ctx
        originTid: ctx.idMapVOriginTid
        :userList
        acc: lateGroup
        :last
    )
    (collectLateMonosKind
        :ast
        :symtab
        :ctx
        originTid: ctx.mapVROriginTid
        :userList
        acc: lateGroup
        :last
    )
    (collectLateMonosKind
        :ast
        :symtab
        :ctx
        originTid: ctx.mapVVOriginTid
        :userList
        acc: lateGroup
        :last
    )
    # membership id-set mirroring lateGroup (the list keeps emission order)
    lateSet: (MapVV u64 value: bool)
    li0: u64
    ln0: lateGroup.length
    for li0 < ln0 loop {
        lv0: lateGroup.get i: li0
        lateSet.set key: lv0 value: true
        li0 = li0 + 1
    }
    # closure: a user struct embedding a late-group member by value is late too
    emptySet: (MapVV u64 value: bool)
    changed: true
    for changed loop {
        changed = false
        ui: u64
        un: userList.length
        for ui < un loop {
            uid: userList.get i: ui
            if (idSetHas s: lateSet id: uid) == false then {
                if (userDefnRefsUnemitted
                    :ast
                    :symtab
                    :ctx
                    typeId: (ztypes.tid.create from: uid.u64)
                    group: lateSet
                    emitted: emptySet
                ) then {
                    lateGroup.append uid.u64
                    lateSet.set key: uid value: true
                    changed = true
                }
            }
            ui = ui + 1
        }
    }
    # early-user structs: users not in the late group, in type-id order
    # (preEmitEmbeddedTypes inside each emitter fixes intra-pass user->user order)
    e0: u64
    n0: userList.length
    for e0 < n0 loop {
        uid0: userList.get i: e0
        if (idSetHas
            s: lateSet
            id: uid0
        ) == false then emitUserTypeById :ast :symtab :ctx tid: (ztypes.tid.create from: uid0) :buf
        e0 = e0 + 1
    }
    # fixpoint: emit late monos + late-user structs in dependency order
    emittedSet: (MapVV u64 value: bool)
    totalPend: lateGroup.length
    emittedCount: u64
    done: false
    stuck: false
    for done == false loop {
        progressed: false
        pi: u64
        pn: lateGroup.length
        for pi < pn loop {
            x: lateGroup.get i: pi
            if (idSetHas s: emittedSet id: x) == false then {
                xorigin: originTidOf :symtab tid: (ztypes.tid.create from: x.u64)
                if xorigin > 0 then {
                    seen: (ListVal u64)
                    if (monoLateDepsMet
                        :ast
                        :symtab
                        :ctx
                        monoId: (ztypes.tid.create from: x.u64)
                        group: lateSet
                        emitted: emittedSet
                        :seen
                    ) then {
                        (emitMonoById
                            :ast
                            :symtab
                            :ctx
                            :runtimeDir
                            monoId: (ztypes.tid.create from: x.u64)
                            :buf
                        )
                        emittedSet.set key: x value: true
                        emittedCount = emittedCount + 1
                        progressed = true
                    }
                } else {
                    if (userDefnRefsUnemitted
                        :ast
                        :symtab
                        :ctx
                        typeId: (ztypes.tid.create from: x.u64)
                        group: lateSet
                        emitted: emittedSet
                    ) == false then {
                        emitUserTypeById :ast :symtab :ctx tid: (ztypes.tid.create from: x.u64) :buf
                        emittedSet.set key: x value: true
                        emittedCount = emittedCount + 1
                        progressed = true
                    }
                }
            }
            pi = pi + 1
        }
        if emittedCount >= totalPend then {
            done = true
        } else {
            if progressed == false then {
                done = true
                stuck = true
            }
        }
    }
    if stuck then {
        f0: u64
        f1: lateGroup.length
        for f0 < f1 loop {
            x2: lateGroup.get i: f0
            if (idSetHas s: emittedSet id: x2) == false then {
                xo2: originTidOf :symtab tid: (ztypes.tid.create from: x2.u64)
                if xo2 > 0 then {
                    (emitMonoById
                        :ast
                        :symtab
                        :ctx
                        :runtimeDir
                        monoId: (ztypes.tid.create from: x2.u64)
                        :buf
                    )
                } else {
                    emitUserTypeById :ast :symtab :ctx tid: (ztypes.tid.create from: x2.u64) :buf
                }
                emittedSet.set key: x2 value: true
            }
            f0 = f0 + 1
        }
    }
}

# emit every monomorphised container instantiation.
emitMonos: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    runtimeDir: StringView
    buf: String.borrow
} is {
    last: symtab.reg.nextTypeId
    userListM: (ListVal u64)
    buildUserTypeList :symtab :ctx acc: userListM
    emitMainFwdDecls :symtab :ctx :buf
    # one classification sweep over the registry fills the per-category
    # worklists; the category loops below emit in the original sequence.
    # Every predicate reads only registry/typing state (immutable during
    # emission); the io-wrapper demand gate stays at emission time.
    wStr9: (ListVal u64)
    wBox9: (ListVal u64)
    wIoUnion9: (ListVal u64)
    wCliLeaf9: (ListVal u64)
    wSysVar9: (ListVal u64)
    wSysRec9: (ListVal u64)
    wValMono9: (ListVal u64)
    wOptRes9: (ListVal u64)
    wUgUnion9: (ListVal u64)
    wOptView9: (ListVal u64)
    wArr9: (ListVal u64)
    wListView9: (ListVal u64)
    wList9: (ListVal u64)
    wSet9: (ListVal u64)
    wMap9: (ListVal u64)
    wIdSet9: (ListVal u64)
    wIdMap9: (ListVal u64)
    wProto9: (ListVal u64)
    wUgRec9: (ListVal u64)
    tcl9: ztypes.tid
    for tcl9 < last loop {
        tv9: tcl9
        tt9: symtab.reg.typetypeOf typeId: tcl9
        oOrig9: originTidOf :symtab tid: tcl9
        gen9: isGenericType :symtab tid: tcl9
        isMono9: oOrig9 > 0
        inIo9: false
        inCli9: false
        {
            duo9: definedInUnitOf :symtab tid: tcl9
            match (
                duo9
            ) case some then {
                if duo9.stringview == "io" then inIo9 = true
                if duo9.stringview == "os" then inIo9 = true
                if duo9.stringview == "cli" then {
                    inIo9 = true
                    inCli9 = true
                }
            } case none then null
        }
        if (originIsTid :symtab tid: tcl9 originTid: ctx.strOriginTid) then wStr9.append tv9
        if (isBoxTid :symtab tid: tcl9) then wBox9.append tv9
        if tt9 == ztypes.ztypetype.unionType then {
            if isMono9 == false when gen9 == false when inIo9 then wIoUnion9.append tv9
        }
        if tt9 == ztypes.ztypetype.classType then {
            if isMono9 == false when gen9 == false then {
                if inCli9 when (cliClassIsComposite
                    :ast
                    :symtab
                    :ctx
                    tid: tcl9
                ) == false then wCliLeaf9.append tv9
            }
        }
        if tt9 == ztypes.ztypetype.variantType then {
            if isMono9 == false when gen9 == false then {
                if (definedInNonMain :symtab :ctx tid: tcl9) then wSysVar9.append tv9
            }
        }
        if tt9 == ztypes.ztypetype.recordType then {
            if isMono9 == false when gen9 == false when inIo9 then wSysRec9.append tv9
        }
        isValMono9: false
        if (originIsTid
            :symtab
            tid: tcl9
            originTid: ctx.optionvalOriginTid
        ) then isValMono9 = true
        if (originIsTid
            :symtab
            tid: tcl9
            originTid: ctx.resultvalOriginTid
        ) then isValMono9 = true
        if isValMono9 then {
            mil9: (monoIsLate
                :ast
                :symtab
                :ctx
                monoId: (ztypes.tid.create from: tcl9.u64)
                userList: userListM
            )
            if (mil9) == false then wValMono9.append tv9
        }
        isOptRes9: false
        if (originIsTid :symtab tid: tcl9 originTid: ctx.optionOriginTid) then isOptRes9 = true
        if (originIsTid :symtab tid: tcl9 originTid: ctx.resultOriginTid) then isOptRes9 = true
        if isOptRes9 then wOptRes9.append tv9
        if isMono9 when tt9 == ztypes.ztypetype.unionType then {
            ugu9: true
            if isOptRes9 then ugu9 = false
            if ugu9 when isValMono9 then ugu9 = false
            if ugu9 when (originIsTid
                :symtab
                tid: tcl9
                originTid: ctx.optionViewOriginTid
            ) then ugu9 = false
            if ugu9 when (isCollectionOriginTid
                :ctx
                originTid: (originTidOf :symtab tid: tcl9)
            ) then ugu9 = false
            if ugu9 then wUgUnion9.append tv9
        }
        if (originIsTid :symtab tid: tcl9 originTid: ctx.optionViewOriginTid) then {
            wOptView9.append tv9
        }
        isColKind9: false
        colDst9: u64
        if (originIsTid :symtab tid: tcl9 originTid: ctx.arrayOriginTid) then {
            isColKind9 = true
            colDst9 = 1
        }
        if (isListViewOriginOf :symtab :ctx tid: tcl9) then {
            isColKind9 = true
            colDst9 = 2
        }
        if (isListOriginOf :symtab :ctx tid: tcl9) then {
            isColKind9 = true
            colDst9 = 3
        }
        if (isSetOriginOf :symtab :ctx tid: tcl9) then {
            isColKind9 = true
            colDst9 = 4
        }
        if (isMapOriginOf :symtab :ctx tid: tcl9) then {
            isColKind9 = true
            colDst9 = 5
        }
        if (isIdSetOriginOf :symtab :ctx tid: tcl9) then {
            isColKind9 = true
            colDst9 = 6
        }
        if (isIdMapOriginOf :symtab :ctx tid: tcl9) then {
            isColKind9 = true
            colDst9 = 7
        }
        if isColKind9 then {
            if (monoIsLate
                :ast
                :symtab
                :ctx
                monoId: (ztypes.tid.create from: tcl9.u64)
                userList: userListM
            ) == false then {
                if colDst9 == 1 then wArr9.append tv9
                if colDst9 == 2 then wListView9.append tv9
                if colDst9 == 3 then wList9.append tv9
                if colDst9 == 4 then wSet9.append tv9
                if colDst9 == 5 then wMap9.append tv9
                if colDst9 == 6 then wIdSet9.append tv9
                if colDst9 == 7 then wIdMap9.append tv9
            }
        }
        if tt9 == ztypes.ztypetype.protocolType then {
            if gen9 == false then {
                if (definedInNonMain :symtab :ctx tid: tcl9) then wProto9.append tv9
            }
        }
        if isMono9 then {
            ugr9: false
            if tt9 == ztypes.ztypetype.recordType then ugr9 = true
            if tt9 == ztypes.ztypetype.classType then ugr9 = true
            if ugr9 when (isCollectionOriginTid
                :ctx
                originTid: (originTidOf :symtab tid: tcl9)
            ) then ugr9 = false
            if ugr9 when (originIsTid
                :symtab
                tid: tcl9
                originTid: ctx.arrayOriginTid
            ) then ugr9 = false
            if ugr9 when (originIsTid
                :symtab
                tid: tcl9
                originTid: ctx.strOriginTid
            ) then ugr9 = false
            if ugr9 when (isBoxTid :symtab tid: tcl9) then ugr9 = false
            if ugr9 then wUgRec9.append tv9
        }
        tcl9 = ztypes.tid.create from: (tcl9 + 1)
    }
    # str valtype monos are leaf PODs that user records embed by value, so emit
    # them first (before any user struct / collection mono that references them).
    tstr9: u64
    for tstr9 < wStr9.length loop {
        strId9: wStr9.get i: tstr9
        emitStrMono :symtab :ctx :runtimeDir monoId: (ztypes.tid.create from: strId9.u64) :buf
        tstr9 = tstr9 + 1
    }
    # builtin Box monos (heap pointers): destructor-only, leaf -- emit early.
    tbox9: u64
    for tbox9 < wBox9.length loop {
        boxId9: wBox9.get i: tbox9
        emitBoxMono :ast :symtab :ctx monoId: (ztypes.tid.create from: boxId9.u64) :buf
        tbox9 = tbox9 + 1
    }
    # reachable non-mono system UNIONs (IoError) -- the error payload of the
    # Result monos; emit before them so the mono destructors can call IoError's.
    tsu: u64
    for tsu < wIoUnion9.length loop {
        iuId9: wIoUnion9.get i: tsu
        emitUnionMono :ast :symtab :ctx tid: (ztypes.tid.create from: iuId9.u64) :buf
        tsu = tsu + 1
    }
    emitIoFileClass :ctx :buf
    emitNetClasses :ctx :buf
    # reachable cli LEAF classes (FlagDef/OptionDef/PositionalDef) -- pure-string
    # classes the List monos below embed; emitted before those monos.
    tclf: u64
    for tclf < wCliLeaf9.length loop {
        clfId9: wCliLeaf9.get i: tclf
        emitOneRecord :ast :symtab :ctx tid: (ztypes.tid.create from: clfId9.u64) :buf
        tclf = tclf + 1
    }
    # reachable non-mono system VARIANTs (parseerror, seekorigin, ...) --
    # payloads of the variant monos / used directly.
    tsv: u64
    for tsv < wSysVar9.length loop {
        svId9: wSysVar9.get i: tsv
        emitOneVariant :ast :symtab :ctx tid: (ztypes.tid.create from: svId9.u64) :buf
        tsv = tsv + 1
    }
    # reachable non-mono system RECORDs (filestat) -- the ok payload of a Result
    # mono; after its filekind variant, before the Result monos that box it.
    tsr: u64
    for tsr < wSysRec9.length loop {
        srId9: wSysRec9.get i: tsr
        emitOneRecord :ast :symtab :ctx tid: (ztypes.tid.create from: srId9.u64) :buf
        tsr = tsr + 1
    }
    # optionval + resultval variant monos -- iterators/collection-gets /
    # parsers return them by value (payloads now resolvable).
    tido: u64
    for tido < wValMono9.length loop {
        vmId9: wValMono9.get i: tido
        emitOneVariant :ast :symtab :ctx tid: (ztypes.tid.create from: vmId9.u64) :buf
        tido = tido + 1
    }
    # Option union monos (tag + void* data heap payload) -- reftype
    # option returns (string strip/split, map get over reftype).
    tiu: u64
    for tiu < wOptRes9.length loop {
        orId9: wOptRes9.get i: tiu
        emitUnionMono :ast :symtab :ctx tid: (ztypes.tid.create from: orId9.u64) :buf
        tiu = tiu + 1
    }
    # user generic UNION monos (e.g. MyOption<i64>): struct + tags via
    # emitUnionMono. The wUgRec9 list handles only RECORD/CLASS; system
    # option/result monos are handled above.
    tugu9: u64
    for tugu9 < wUgUnion9.length loop {
        uguId9: wUgUnion9.get i: tugu9
        emitUnionMono :ast :symtab :ctx tid: (ztypes.tid.create from: uguId9.u64) :buf
        tugu9 = tugu9 + 1
    }
    # OptionView structs -- the borrowed-view option every collection
    # iterator yields; emitted before the collections that reference it.
    tiov: u64
    for tiov < wOptView9.length loop {
        ovId9: wOptView9.get i: tiov
        emitOptionViewMono :ctx :symtab monoId: (ztypes.tid.create from: ovId9.u64) :buf
        tiov = tiov + 1
    }
    # ListView structs next -- a List's listview companion references
    # the ListView struct by value.
    tarr9: u64
    for tarr9 < wArr9.length loop {
        arrId9: wArr9.get i: tarr9
        (emitArrayMono
            :ast
            :symtab
            :ctx
            :runtimeDir
            monoId: (ztypes.tid.create from: arrId9.u64)
            :buf
        )
        tarr9 = tarr9 + 1
    }
    tid: ztypes.tid
    for tid < wListView9.length loop {
        lvId9: wListView9.get i: tid
        (emitListViewMono
            :ast
            :symtab
            :ctx
            :runtimeDir
            monoId: (ztypes.tid.create from: lvId9.u64)
            :buf
        )
        tid = ztypes.tid.create from: (tid + 1)
    }
    tid2: u64
    for tid2 < wList9.length loop {
        liId9: wList9.get i: tid2
        emitListMono :ast :symtab :ctx :runtimeDir monoId: (ztypes.tid.create from: liId9.u64) :buf
        tid2 = tid2 + 1
    }
    # Set monos last -- the compact-dict + SetIter; needs its element's
    # OptionView (above) already defined.
    tset: u64
    for tset < wSet9.length loop {
        seId9: wSet9.get i: tset
        emitSetMono :ast :symtab :ctx :runtimeDir monoId: (ztypes.tid.create from: seId9.u64) :buf
        tset = tset + 1
    }
    # Map monos -- the compact-dict over key+value; get's return optionval
    # (emitted above) supplies the value type.
    tmap: u64
    for tmap < wMap9.length loop {
        maId9: wMap9.get i: tmap
        emitMapMono :ast :symtab :ctx :runtimeDir monoId: (ztypes.tid.create from: maId9.u64) :buf
        tmap = tmap + 1
    }
    # the id-keyed pair, after the hashed ones for the same reason: an IdMap's
    # `get` returns an optionval / OptionView emitted above.
    tidset9: u64
    for tidset9 < wIdSet9.length loop {
        isId9: wIdSet9.get i: tidset9
        (emitIdSetMono
            :ast
            :symtab
            :ctx
            :runtimeDir
            monoId: (ztypes.tid.create from: isId9.u64)
            :buf
        )
        tidset9 = tidset9 + 1
    }
    tidmap9: u64
    for tidmap9 < wIdMap9.length loop {
        imId9: wIdMap9.get i: tidmap9
        (emitIdMapMono
            :ast
            :symtab
            :ctx
            :runtimeDir
            monoId: (ztypes.tid.create from: imId9.u64)
            :buf
        )
        tidmap9 = tidmap9 + 1
    }
    # reachable system PROTOCOLs (Reader/Writer/Closer/Seeker) -- emitted after
    # the collection monos their vtable function-pointer signatures reference.
    tsp: u64
    for tsp < wProto9.length loop {
        spId9: wProto9.get i: tsp
        spn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: spId9.u64)
        (emitOneProtocol
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: spId9.u64)
            name: spn.stringview
            :buf
        )
        tsp = tsp + 1
    }
    # user generic class/record monos (e.g. Box<i64>): RECORD/CLASS monos whose
    # origin is a user generic type. The collection / array / str / option / box
    # monos are handled by their own worklists; emit the rest via emitOneRecord.
    tug9: u64
    for tug9 < wUgRec9.length loop {
        ugId9: wUgRec9.get i: tug9
        emitOneRecord :ast :symtab :ctx tid: (ztypes.tid.create from: ugId9.u64) :buf
        tug9 = tug9 + 1
    }
}

# emitRecordDefs -- main-unit record structs + meta_create constructors
# (scalar/record fields; the create alias mirrors the reference).
emitRecordDefs: function {
    program: Node
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    buf: String.borrow
} is {
    match (
        program
    ) case program then {
        # 3 phases across ALL file units so cross-unit refs resolve: every unit's
        # structs, then every unit's fwd-decls, then every unit's method bodies.
        ph: 1.u64
        for ph <= 3 loop {
            uCnt9h: program.ast.units.length
            uIdx9h: u64
            for uIdx9h < uCnt9h loop {
                uId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9h))
                uIdx9h = uIdx9h + 1
                opId9: zast.nodeid
                un9: String
                un9Id: zast.nameid
                {
                    u: program.ast.nodes.get i: uId9.u64
                    if u.namedoperation then {
                        un: zast.poolTextAt pool: program.ast.names ref: u.name
                        opId9 = u.operation
                        un9 = un.copy
                        un9Id = u.name
                    }
                }
                if opId9 > 0 then {
                    sm: ctx.mainName.copy
                    smD9: ctx.mainUnitId
                    (ctxBindMain
                        :ctx
                        name: un9.stringview
                        unitDecl: (ztypecheck.unitDeclOfNameId ty: symtab.typing nameId: un9Id).u64
                    )
                    (emitRecordDefsIn
                        :symtab
                        :ctx
                        ast: program.ast
                        mainOpId: opId9
                        phase: ph
                        :buf
                    )
                    ctxBindMain :ctx name: sm.stringview unitDecl: smD9
                }
            }
            ph = ph + 1
        }
    } else null
}

# emitDefMethods -- emit a record/class def's as-block methods (forward decls
# when declOnly, bodies otherwise). Used by the method passes of emitRecordDefsIn.
emitDefMethods: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    bm: Node.view
    declOnly: bool
    buf: String.borrow
} is {
    match (
        bm
    ) case namedoperation then {
        if (isRecordDef9 n: (ast.nodes.get i: bm.operation.u64)) then {
            nm: zast.nameTextAt :ast ref: bm.name
            rid: userFnId :ast :symtab :ctx name: nm.stringview
            if rid > 0 then (emitRecordMethods
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: rid.u64)
                op: (ast.nodes.get i: bm.operation.u64)
                :declOnly
                :buf
            )
        }
        if (isClassDef9 n: (ast.nodes.get i: bm.operation.u64)) then {
            nmc: zast.nameTextAt :ast ref: bm.name
            cid9: userFnId :ast :symtab :ctx name: nmc.stringview
            if cid9 > 0 then {
                (emitRecordMethods
                    :ast
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: cid9.u64)
                    op: (ast.nodes.get i: bm.operation.u64)
                    :declOnly
                    :buf
                )
            }
        }
    } else null
}


# protoChildMethods -- a protocol's spec-method children (FUNCTION children,
# excluding the synth create/borrow), names + ids in registration order.
protoChildMethods: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    tid: ztypes.tid
    names: List String
    ids: ListVal u64
    nameIds: ListVal u64
} is {
    mNms4: (ListVal u64)
    mTds4: (ListVal u64)
    symtab.typing.declMemberList ownerTid: tid names: mNms4 tids: mTds4
    pi4: u64
    pn4: mNms4.length
    for pi4 < pn4 loop {
        pnid4: mNms4.get i: pi4
        ptid4: mTds4.get i: pi4
        pi4 = pi4 + 1
        if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: ptid4.u64)) == ztypes.ztypetype.functionType then {
            isSynth: false
            if pnid4 == zast.wkCreate.u64 then isSynth = true
            if pnid4 == zast.wkBorrow.u64 then isSynth = true
            if (isSynth) == false then {
                cnBe4: ast.names.texts.get i: pnid4.u64
                cn0: cnBe4.copy
                names.append cn0
                ids.append ptid4
                nid0: pnid4
                nameIds.append nid0
            }
        }
    }
}

# methodRetCtype -- a method's C return type via the registry returnTypeId
# (scalars/records/classes resolve through typeRefC); "void" when unset.
methodRetCtype: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    mid: ztypes.tid
    thisTid: ztypes.tid
} out String is {
    mro: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: mid.u64)
    match (
        mro
    ) case some then {
        rr: typeRefC :ast :symtab :ctx tid: mro :thisTid
        if rr.length > 0 then return rr
    } case none then null
    return "void".string
}

# protoParamCtype -- a protocol spec-method param's C type: typeRefC, with a
# `*` for collection params (List/ListView/Map and the Bytes/ByteView typedefs),
# which the vtable function pointers and wrappers pass by pointer.
protoParamCtype: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    pid: ztypes.tid
    thisTid: ztypes.tid
} out String is {
    # The spec param is usually a SHELL named after the system type; canonicalize
    # it by name (resolveTypeIdByName covers system types) so typeRefC resolves it
    # (and chases ByteView/Bytes to their collection mono). But a param already
    # resolved to a CANONICAL id (a linked declaration, e.g. system i64) is trusted
    # as-is -- re-resolving "i64" by name would wrongly pick up a user shadow of
    # the scalar in the main unit. Mirrors typeRefC's none-branch shell gate.
    cpid: pid
    pidDu9: definedInUnitOf :symtab tid: (ztypes.tid.create from: pid.u64)
    pidShell9: false
    match (
        pidDu9
    ) case some then null case none then {
        pidShell9 = true
    }
    if pidShell9 then {
        pn9: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: pid.u64)
        rcid: (canonTypeId
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: pid.u64)
            name: pn9.stringview
        )
        if rcid > 0 then cpid = ztypes.tid.create from: rcid.u64
    }
    pct: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: cpid.u64) :thisTid
    if pct.length == 0 then pct = "int64_t".string
    isCol: false
    ccm9: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: cpid.u64)
    if (ccm9.u64 == cpid) == false then isCol = true
    if (isCollectionOriginTid
        :ctx
        originTid: (originTidOf :symtab tid: (ztypes.tid.create from: cpid.u64))
    ) then isCol = true
    if isCol then return "\{pct}*"
    return pct
}

# emitOneProtocol -- the protocol value representation: vtable typedef (one
# function pointer per spec method, `this` dropped for a leading void*),
# the fat-pointer struct {data, vtable, destroy}, and the destroy helper.
# facetImplTids -- the deduplicated impl type ids conforming to facet `tid`,
# in conformance-row (declaration) order.
facetImplTids: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid acc: ListVal u64} is {
    with citer: symtab.typing.conformance.iterate do for row: citer loop {
        if row.specTypeId == tid then {
            if (acc.contains item: row.implTypeId) == false then acc.append row.implTypeId
        }
    }
}

# emitOneFacet -- the facet value representation: a vtable typedef (one fn
# pointer per spec, void* receiver), an inline data union over the conforming
# impls (copied by value -- facets are valtype existentials), and the
# {vtable*, data} struct. No destroy helper: impls are valtypes. The impl
# structs are pre-emitted first because the union embeds them by value.
emitOneFacet: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    egf9: ctx.emittedUserTypes.get key: tid
    match (
        egf9
    ) case some then {
        return
    } case none then null
    ctx.emittedUserTypes.set key: tid.u64 value: true
    pbase: ctxCname :ctx :tid
    impls9: (ListVal u64)
    facetImplTids :symtab :tid acc: impls9
    preEmitEmbeddedTypes :ast :symtab :ctx ids: impls9 :buf
    mnames: (List String)
    mids: (ListVal u64)
    midsNm: (ListVal u64)
    protoChildMethods :ast :symtab :tid names: mnames ids: mids nameIds: midsNm
    vfuncs: String
    mi: u64
    mn: mnames.length
    for mi < mn loop {
        mname: mnames.get i: mi
        smid: mids.get i: mi
        mroP: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: smid.u64)
        match (
            mroP
        ) case some then {
            maybePreEmitElem :ast :symtab :ctx eid: mroP :buf
        } case none then null
        ret: methodRetCtype :ast :symtab :ctx mid: (ztypes.tid.create from: smid.u64) thisTid: tid
        vparams: "void*".string
        pnames: (List String)
        pids: (ListVal u64)
        pidsNm: (ListVal u64)
        (recFieldLists
            :ast
            :symtab
            tid: (ztypes.tid.create from: smid.u64)
            names: pnames
            ids: pids
            nameIds: pidsNm
        )
        preEmitEmbeddedTypes :ast :symtab :ctx ids: pids :buf
        pi: u64
        pn: pnames.length
        for pi < pn loop {
            pnm: pnames.get i: pi
            pid: pids.get i: pi
            # spec receivers are dropped by resolveSpecFn; the name and id
            # legs cover a self-typed param without a by-name resolution
            isThis: false
            if pnm.stringview == "this" then isThis = true
            if pid == tid then isThis = true
            # a marked receiver is an alias, so ask the registry which
            # parameter IS the receiver rather than matching on `this`
            {
                rpnV9: symtab.reg.thisParamNameIdOf tid: (ztypes.tid.create from: smid.u64)
                if rpnV9 != 0 when (pidsNm.get i: pi) == rpnV9.u64 then isThis = true
            }
            if (isThis) == false then {
                pct: (protoParamCtype
                    :ast
                    :symtab
                    :ctx
                    pid: (ztypes.tid.create from: pid.u64)
                    thisTid: (ztypes.tid.create from: tid.u64)
                )
                vparams.append ", "
                vparams.append pct
            }
            pi = pi + 1
        }
        vslot9: cSlotName name: mname.stringview
        vline: "    \{ret} (*\{vslot9})(\{vparams});\n"
        vfuncs.append vline
        mi = mi + 1
    }
    l0: "typedef struct {\n\{vfuncs}} \{pbase}_vtable_t;\n\n"
    buf.append l0
    du9: String
    with iiter: impls9.iterate do for itid9: iiter loop {
        icn9: ctxCname :ctx tid: (ztypes.tid.create from: itid9.u64)
        drow9: "    \{icn9}_t _i\{itid9};\n"
        du9.append drow9
    }
    if du9.length == 0 then du9.append "    char _none;\n"
    l1: "typedef union {\n\{du9}} \{pbase}_data_u;\n\n"
    buf.append l1
    l2: "typedef struct {\n    \{pbase}_vtable_t* vtable;\n    \{pbase}_data_u data;\n} \{pbase}_t;\n\n"
    buf.append l2
}

# emit one protocol's dispatch table.
emitOneProtocol: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    tid: ztypes.tid
    name: StringView
    buf: String.borrow
} is {
    egp9: ctx.emittedUserTypes.get key: tid
    match (
        egp9
    ) case some then {
        return
    } case none then null
    ctx.emittedUserTypes.set key: tid.u64 value: true
    pbase: ctxCname :ctx :tid
    mnames: (List String)
    mids: (ListVal u64)
    midsNm: (ListVal u64)
    protoChildMethods :ast :symtab :tid names: mnames ids: mids nameIds: midsNm
    vfuncs: String
    mi: u64
    mn: mnames.length
    for mi < mn loop {
        mname: mnames.get i: mi
        smid: mids.get i: mi
        mroP: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: smid.u64)
        match (
            mroP
        ) case some then {
            maybePreEmitElem :ast :symtab :ctx eid: mroP :buf
        } case none then null
        ret: methodRetCtype :ast :symtab :ctx mid: (ztypes.tid.create from: smid.u64) thisTid: tid
        vparams: "void*".string
        pnames: (List String)
        pids: (ListVal u64)
        pidsNm: (ListVal u64)
        (recFieldLists
            :ast
            :symtab
            tid: (ztypes.tid.create from: smid.u64)
            names: pnames
            ids: pids
            nameIds: pidsNm
        )
        preEmitEmbeddedTypes :ast :symtab :ctx ids: pids :buf
        pi: u64
        pn: pnames.length
        for pi < pn loop {
            pnm: pnames.get i: pi
            pid: pids.get i: pi
            ptn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: pid.u64)
            isThis: false
            if pnm.stringview == "this" then isThis = true
            if ptn.stringview == "this" then isThis = true
            if ptn.stringview == name then isThis = true
            if pid == tid then isThis = true
            # a marked receiver is an alias, so ask the registry which
            # parameter IS the receiver rather than matching on `this`
            {
                rpnV9: symtab.reg.thisParamNameIdOf tid: (ztypes.tid.create from: smid.u64)
                if rpnV9 != 0 when (pidsNm.get i: pi) == rpnV9.u64 then isThis = true
            }
            if (isThis) == false then {
                pct: (protoParamCtype
                    :ast
                    :symtab
                    :ctx
                    pid: (ztypes.tid.create from: pid.u64)
                    thisTid: (ztypes.tid.create from: tid.u64)
                )
                vparams.append ", "
                vparams.append pct
            }
            pi = pi + 1
        }
        vslot9: cSlotName name: mname.stringview
        vline: "    \{ret} (*\{vslot9})(\{vparams});\n"
        vfuncs.append vline
        mi = mi + 1
    }
    l0: "typedef struct {\n\{vfuncs}} \{pbase}_vtable_t;\n\n"
    buf.append l0
    l1: "typedef struct {\n    void* data;\n    \{pbase}_vtable_t* vtable;\n    void (*destroy)(void*);\n} \{pbase}_t;\n\n"
    buf.append l1
    l2: "static void \{pbase}_destroy(\{pbase}_t* proto) {\n    if (!proto) return;\n    if (proto->destroy) proto->destroy(proto->data);\n    proto->destroy = NULL;\n}\n\n"
    buf.append l2
}

# emitProtocolImpl -- the per-(impl,label) conformance helpers: one wrapper per
# spec method (casts void* -> impl, calls the impl method), the static vtable
# instance, the borrowed create (data=val, no destroy), and the owned
# create/destroy (heap-box the value, free + impl-destroy on drop).
emitProtocolImpl: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    implTid: ztypes.tid
    protoTid: ztypes.tid
    protoName: StringView
    label: StringView
    buf: String.borrow
} is {
    implOrig9: originTidOf :symtab tid: (ztypes.tid.create from: implTid.u64)
    if implOrig9 > 0 then return
    implBase: ctxCname :ctx tid: (ztypes.tid.create from: implTid.u64)
    implCtype: "\{implBase}_t"
    protoBase: ctxCname :ctx tid: protoTid
    protoCtype: "\{protoBase}_t"
    vtableCtype: "\{protoBase}_vtable_t"
    wbase: "\{implBase}_\{label}"
    mnames: (List String)
    mids: (ListVal u64)
    midsNm: (ListVal u64)
    protoChildMethods :ast :symtab tid: protoTid names: mnames ids: mids nameIds: midsNm
    mi: u64
    mn: mnames.length
    for mi < mn loop {
        mname: mnames.get i: mi
        mnameId: (zast.nameid.create from: (midsNm.get i: mi))
        smid: mids.get i: mi
        ret: (methodRetCtype
            :ast
            :symtab
            :ctx
            mid: (ztypes.tid.create from: smid.u64)
            thisTid: protoTid
        )
        wparams: "void* _data".string
        # every method takes its receiver by pointer now, in both families
        cargs: "_self".string
        pnames: (List String)
        pids: (ListVal u64)
        pidsNm: (ListVal u64)
        (recFieldLists
            :ast
            :symtab
            tid: (ztypes.tid.create from: smid.u64)
            names: pnames
            ids: pids
            nameIds: pidsNm
        )
        pi: u64
        pn: pnames.length
        for pi < pn loop {
            pnm: pnames.get i: pi
            pid: pids.get i: pi
            ptn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: pid.u64)
            isThis: false
            if pnm.stringview == "this" then isThis = true
            if ptn.stringview == "this" then isThis = true
            if ptn.stringview == protoName then isThis = true
            if pid == protoTid then isThis = true
            # A marked receiver is an ALIAS (`{t: this.view}`), so neither its
            # name nor its type says `this`. The registry records which
            # parameter IS the receiver; that is the question to ask, and it is
            # the same one methodReceiverIsView asks.
            {
                rpnW9: symtab.reg.thisParamNameIdOf tid: (ztypes.tid.create from: smid.u64)
                if rpnW9 != 0 when (pidsNm.get i: pi) == rpnW9.u64 then isThis = true
            }
            if (isThis) == false then {
                pct: (protoParamCtype
                    :ast
                    :symtab
                    :ctx
                    pid: (ztypes.tid.create from: pid.u64)
                    thisTid: (ztypes.tid.create from: protoTid.u64)
                )
                wparams.append ", "
                wparams.append pct
                wparams.append " "
                wparams.append pnm
                cargs.append ", "
                cargs.append pnm
            }
            pi = pi + 1
        }
        implMid: ztypes.tid
        imo: symtab.typing.declChildOfId parentTypeId: implTid nameId: mnameId
        match (
            imo
        ) case some then {
            implMid = ztypes.tid.create from: (imo)
        } case none then null
        implMc: String
        # a fragment-backed stdlib impl's methods carry canon-named C
        # symbols regardless of which unit is being emitted (the per-unit
        # emission pass rebinds mainName, defeating the nonmain test)
        implFrag9: false
        {
            fduW9: definedInUnitOf :symtab tid: (ztypes.tid.create from: implTid.u64)
            match (
                fduW9
            ) case some then {
                if fduW9.stringview == "io" then implFrag9 = true
                if fduW9.stringview == "os" then implFrag9 = true
                if fduW9.stringview == "cli" then implFrag9 = true
                if fduW9.stringview == "net" then implFrag9 = true
            } case none then null
        }
        if implFrag9 then {
            implMc = "\{implBase}_\{mname}"
        } else {
            if (definedInNonMain :symtab :ctx tid: (ztypes.tid.create from: implTid.u64)) then {
                implMc = "\{implBase}_\{mname}"
            } else {
                implMc = (ctxCname :ctx tid: (ztypes.tid.create from: implMid.u64))
            }
        }
        retkw: "return ".string
        if ret.stringview == "void" then retkw = "".string
        wslot9: cSlotName name: mname.stringview
        w0: "static \{ret} \{wbase}_\{wslot9}_wrapper(\{wparams}) {\n"
        buf.append w0
        w1: "    \{implCtype}* _self = (\{implCtype}*)_data;\n"
        buf.append w1
        w2: "    \{retkw}\{implMc}(\{cargs});\n"
        buf.append w2
        buf.append "}\n\n"
        mi = mi + 1
    }
    vi0: "static \{vtableCtype} \{wbase}_vtable = {\n"
    buf.append vi0
    mj: u64
    for mj < mn loop {
        mname2: mnames.get i: mj
        rslot9: cSlotName name: mname2.stringview
        vrow: "    .\{rslot9} = \{wbase}_\{rslot9}_wrapper,\n"
        buf.append vrow
        mj = mj + 1
    }
    buf.append "};\n\n"
    bc0: "static \{protoCtype} \{wbase}_create(\{implCtype}* val) {\n    \{protoCtype} proto = {0};\n    proto.data = val;\n    proto.vtable = &\{wbase}_vtable;\n    proto.destroy = NULL;\n    return proto;\n}\n\n"
    buf.append bc0
    od0: "static void \{wbase}_owned_destroy(void* p) {\n"
    buf.append od0
    if (symtab.reg.hasDestructorName typeId: implTid) then {
        od1: "    \{implBase}_destroy((\{implCtype}*)p);\n"
        buf.append od1
    }
    buf.append "    free(p);\n}\n\n"
    oc0: "static \{protoCtype} \{wbase}_create_owned(\{implCtype}* val) {\n    \{protoCtype} proto = {0};\n    \{implCtype}* boxed = (\{implCtype}*)z_xmalloc(sizeof(\{implCtype}));\n    *boxed = *val;\n    proto.data = boxed;\n    proto.vtable = &\{wbase}_vtable;\n    proto.destroy = \{wbase}_owned_destroy;\n    return proto;\n}\n\n"
    buf.append oc0
}

# emitFacetImpl -- the per-(impl,label) facet conformance helpers: one
# wrapper per spec method (casts void* -> impl, calls the impl method), the
# static vtable instance, and a single copy-create (serves `.create` and
# `.borrow` -- a facet copies its source; borrow differs only at typecheck
# time). No owned variant, no heap, no destroy: impls are valtypes.
emitFacetImpl: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    implTid: ztypes.tid
    facetTid: ztypes.tid
    label: StringView
    buf: String.borrow
} is {
    if (isGenericType :symtab tid: (ztypes.tid.create from: implTid.u64)) then return
    implBase: ctxCname :ctx tid: (ztypes.tid.create from: implTid.u64)
    implCtype: "\{implBase}_t"
    facetBase: ctxCname :ctx tid: facetTid
    facetCtype: "\{facetBase}_t"
    vtableCtype: "\{facetBase}_vtable_t"
    wbase: "\{implBase}_\{label}"
    mnames: (List String)
    mids: (ListVal u64)
    midsNm: (ListVal u64)
    protoChildMethods :ast :symtab tid: facetTid names: mnames ids: mids nameIds: midsNm
    mi: u64
    mn: mnames.length
    for mi < mn loop {
        mname: mnames.get i: mi
        mnameId: (zast.nameid.create from: (midsNm.get i: mi))
        smid: mids.get i: mi
        ret: (methodRetCtype
            :ast
            :symtab
            :ctx
            mid: (ztypes.tid.create from: smid.u64)
            thisTid: facetTid
        )
        wparams: "void* _data".string
        cargs: "_self".string
        pnames: (List String)
        pids: (ListVal u64)
        pidsNm: (ListVal u64)
        (recFieldLists
            :ast
            :symtab
            tid: (ztypes.tid.create from: smid.u64)
            names: pnames
            ids: pids
            nameIds: pidsNm
        )
        pi: u64
        pn: pnames.length
        for pi < pn loop {
            pnm: pnames.get i: pi
            pid: pids.get i: pi
            isThis: false
            if pnm.stringview == "this" then isThis = true
            if pid == facetTid then isThis = true
            # A marked receiver is an ALIAS (`{t: this.view}`), so neither its
            # name nor its type says `this`. The registry records which
            # parameter IS the receiver; that is the question to ask, and it is
            # the same one methodReceiverIsView asks.
            {
                rpnW9: symtab.reg.thisParamNameIdOf tid: (ztypes.tid.create from: smid.u64)
                if rpnW9 != 0 when (pidsNm.get i: pi) == rpnW9.u64 then isThis = true
            }
            if (isThis) == false then {
                pct: (protoParamCtype
                    :ast
                    :symtab
                    :ctx
                    pid: (ztypes.tid.create from: pid.u64)
                    thisTid: (ztypes.tid.create from: facetTid.u64)
                )
                wparams.append ", "
                wparams.append pct
                wparams.append " "
                wparams.append pnm
                cargs.append ", "
                cargs.append pnm
            }
            pi = pi + 1
        }
        implMid: ztypes.tid
        imo: symtab.typing.declChildOfId parentTypeId: implTid nameId: mnameId
        match (
            imo
        ) case some then {
            implMid = ztypes.tid.create from: (imo)
        } case none then null
        implMc: String
        # a fragment-backed stdlib impl's methods carry canon-named C
        # symbols regardless of which unit is being emitted (the per-unit
        # emission pass rebinds mainName, defeating the nonmain test)
        implFrag9: false
        {
            fduW9: definedInUnitOf :symtab tid: (ztypes.tid.create from: implTid.u64)
            match (
                fduW9
            ) case some then {
                if fduW9.stringview == "io" then implFrag9 = true
                if fduW9.stringview == "os" then implFrag9 = true
                if fduW9.stringview == "cli" then implFrag9 = true
                if fduW9.stringview == "net" then implFrag9 = true
            } case none then null
        }
        if implFrag9 then {
            implMc = "\{implBase}_\{mname}"
        } else {
            if (definedInNonMain :symtab :ctx tid: (ztypes.tid.create from: implTid.u64)) then {
                implMc = "\{implBase}_\{mname}"
            } else {
                implMc = (ctxCname :ctx tid: (ztypes.tid.create from: implMid.u64))
            }
        }
        retkw: "return ".string
        if ret.stringview == "void" then retkw = "".string
        wslot9: cSlotName name: mname.stringview
        w0: "static \{ret} \{wbase}_\{wslot9}_wrapper(\{wparams}) {\n"
        buf.append w0
        w1: "    \{implCtype}* _self = (\{implCtype}*)_data;\n"
        buf.append w1
        w2: "    \{retkw}\{implMc}(\{cargs});\n"
        buf.append w2
        buf.append "}\n\n"
        mi = mi + 1
    }
    vi0: "static \{vtableCtype} \{wbase}_vtable = {\n"
    buf.append vi0
    mj: u64
    for mj < mn loop {
        mname2: mnames.get i: mj
        rslot9: cSlotName name: mname2.stringview
        vrow: "    .\{rslot9} = \{wbase}_\{rslot9}_wrapper,\n"
        buf.append vrow
        mj = mj + 1
    }
    buf.append "};\n\n"
    fc0: "static \{facetCtype} \{wbase}_create(\{implCtype}* val) {\n    \{facetCtype} facet = {0};\n    facet.vtable = &\{wbase}_vtable;\n    facet.data._i\{implTid} = *val;\n    return facet;\n}\n\n"
    buf.append fc0
}

# emitFacetImplsForType -- emit facet conformance helpers for every FACET the
# given impl type satisfies. Class impls are skipped (a class copied into an
# inline union would violate the valtype guarantee; the checker gap is
# front-end work).
emitFacetImplsForType: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    implTid: ztypes.tid
    buf: String.borrow
} is {
    if (symtab.reg.typetypeOf typeId: implTid) != ztypes.ztypetype.recordType then return
    if (typeStructEmitted9 :ctx tid: implTid) == false then return
    ftids: (ListVal u64)
    flabels: (List String)
    frows9: (ListVal u64)
    fri9: u64
    with citer: symtab.typing.conformance.iterate do for row: citer loop {
        if row.implTypeId == implTid then {
            ftids.append row.specTypeId
            flabels.append row.label.copy
            frows9.append fri9
        }
        fri9 = fri9 + 1
    }
    fi: u64
    fn: ftids.length
    for fi < fn loop {
        ftid: ftids.get i: fi
        flabel: flabels.get i: fi
        fdone9: conformanceRowEmitted9 :ctx row: (frows9.get i: fi)
        if (symtab.reg.typetypeOf
            typeId: (ztypes.tid.create from: ftid.u64)
        ) == ztypes.ztypetype.facetType when (fdone9) == false then {
            conformanceRowMark9 :ctx row: (frows9.get i: fi)
            (emitFacetImpl
                :ast
                :symtab
                :ctx
                :implTid
                facetTid: (ztypes.tid.create from: ftid.u64)
                label: flabel.stringview
                :buf
            )
        }
        fi = fi + 1
    }
}

# emitProtocolImplsForType -- emit conformance helpers for every PROTOCOL the
# given impl type satisfies (facet conformances emit via emitFacetImplsForType).
emitProtocolImplsForType: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    implTid: ztypes.tid
    buf: String.borrow
} is {
    if (typeStructEmitted9 :ctx tid: implTid) == false then return
    ptids: (ListVal u64)
    plabels: (List String)
    prows9: (ListVal u64)
    pri9: u64
    with citer: symtab.typing.conformance.iterate do for row: citer loop {
        if row.implTypeId == implTid then {
            ptids.append row.specTypeId
            plabels.append row.label.copy
            prows9.append pri9
        }
        pri9 = pri9 + 1
    }
    pi: u64
    pn: ptids.length
    for pi < pn loop {
        ptid: ptids.get i: pi
        plabel: plabels.get i: pi
        pdone9: conformanceRowEmitted9 :ctx row: (prows9.get i: pi)
        if (symtab.reg.typetypeOf
            typeId: (ztypes.tid.create from: ptid.u64)
        ) == ztypes.ztypetype.protocolType when (pdone9) == false then {
            conformanceRowMark9 :ctx row: (prows9.get i: pi)
            pname: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: ptid.u64)
            (emitProtocolImpl
                :ast
                :symtab
                :ctx
                :implTid
                protoTid: (ztypes.tid.create from: ptid.u64)
                protoName: pname.stringview
                label: plabel.stringview
                :buf
            )
        }
        pi = pi + 1
    }
}

# conformanceLabelFor -- the as-block label under which implTid satisfies
# protoTid (e.g. "myreader"); "" when not found.
conformanceLabelFor: function {
    symtab: zenv.ZSymbolTable.view
    implTid: u64
    protoTid: u64
} out String is {
    res: String
    with citer: symtab.typing.conformance.iterate do for row: citer loop {
        if row.implTypeId == implTid when row.specTypeId == protoTid then {
            if res.length == 0 then res.append row.label
        }
    }
    return res
}

# emitProtocolDispatch -- a method call on a protocol-typed receiver routes
# through the vtable: `r.read b: 5` -> `r.vtable->read(r.data, 5)`.
# fileTypeIdOf -- the io File class type id if `nid` stamps as File, else 0.
fileTypeIdOf: function {symtab: zenv.ZSymbolTable nid: u64} out u64 is {
    tid: stampIdOf :symtab :nid
    if tid.isZero then return 0
    if (symtab.reg.typetypeOf typeId: tid) != ztypes.ztypetype.classType then return 0
    fileOrig9: originTidOf :symtab :tid
    if fileOrig9 > 0 then return 0
    duo9: definedInUnitOf :symtab :tid
    isIoT9: false
    match (
        duo9
    ) case some then {
        if duo9.stringview == "io" then isIoT9 = true
        if duo9.stringview == "os" then isIoT9 = true
        if duo9.stringview == "cli" then isIoT9 = true
        if duo9.stringview == "net" then isIoT9 = true
    } case none then null
    if isIoT9 then return tid
    return 0
}

# fileFromArgCoerce -- the emitted `from:` argument of a file-method call,
# projected to a by-value view when the arg is an owned String (TextWriter's
# StringLike param; ByteView args pass through unchanged). A non-lvalue
# String temp hoists for scope-exit free.
fileFromArgCoerce: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    av: StringView
} out String is {
    with fiter9: call.arguments.iterate do for fa9Id9: fiter9 loop {
        fa9: ast.nodes.get i: fa9Id9.u64
        match (
            fa9
        ) case namedoperation then {
            opf2129: ast.nodes.get i: fa9.operation.u64
            fl9: zast.nameTextAt :ast ref: fa9.name
            if fl9.stringview == "from" then {
                sidm59: (stampIdOf
                    :symtab
                    nid: (nodeIdOf9 n: (ast.nodes.get i: fa9.operation.u64))
                )
                if sidm59 == ctx.strTid then {
                    fh9: (hoistBorrowValArg
                        :ast
                        :symtab
                        :ctx
                        :av
                        pid: ctx.strTid
                        paramTake: false
                        isBorrow: (hoistExprIsBorrowRooted :ast :symtab :ctx n: opf2129)
                    )
                    fb9: av.string
                    if fh9.length > 0 then fb9 = fh9
                    fbq9: atomVidIfPlain :ast :symtab :ctx n: opf2129 text: fb9.stringview
                    return (svValueForm :ctx expr: fb9.stringview isStr: true vid: fbq9)
                }
            }
        } else null
    }
    return av.string
}

# emitFileMethodCall -- a File method (close/read/write/seek/flush), native,
# taking the receiver by pointer and collection args (Bytes/ByteView) by
# pointer. "" for any non-File receiver.
emitFileMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    isFM: false
    if mn.stringview == "close" then isFM = true
    if mn.stringview == "read" then isFM = true
    if mn.stringview == "write" then isFM = true
    if mn.stringview == "seek" then isFM = true
    if mn.stringview == "flush" then isFM = true
    if mn.stringview == "writeLine" then isFM = true
    if mn.stringview == "accept" then isFM = true
    if (isFM) == false then return "".string
    bnid: dottedBaseNodeId :ast n: (ast.nodes.get i: call.callable.u64)
    fid: fileTypeIdOf :symtab nid: bnid
    if fid == 0 then return "".string
    fc: ctxCname :ctx tid: (ztypes.tid.create from: fid.u64)
    {
        fcn9: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: fid.u64)
        fcc9: ioCanonCname :ast :symtab :ctx canon: fcn9.stringview
        if fcc9.length > 0 then fc = fcc9
    }
    recvV0: atomVid :symtab nid: bnid
    recv: aliasResolve :ctx name: bn.stringview vid: recvV0
    recvV9: ztypes.vid
    if recv.stringview == bn.stringview then recvV9 = recvV0
    recvC: emitLocalAtomName :ctx name: bn.stringview vid: recvV0
    recvExpr: "&\{recvC}"
    if (isPtrVid :ctx vid: recvV9) then recvExpr = recvC
    isNet9: false
    {
        fduo9: definedInUnitOf :symtab tid: (ztypes.tid.create from: fid.u64)
        match (
            fduo9
        ) case some then {
            if fduo9.stringview == "net" then isNet9 = true
        } case none then null
    }
    if isNet9 then {
        needsAddM :ctx uname: "net" memb: "@unit"
    } else {
        needsAddM :ctx uname: "io" memb: "@unit"
        fmm: "file_\{mn}"
        needsAddM :ctx uname: "io" memb: fmm.stringview
    }
    if mn.stringview == "accept" then {
        if (isNet9) == false then return "".string
        return "\{fc}_accept(\{recvExpr})"
    }
    if mn.stringview == "close" then return "\{fc}_close(\{recvExpr})"
    if mn.stringview == "flush" then return "\{fc}_flush(\{recvExpr})"
    if mn.stringview == "write" then {
        fv: ctorArgByLabel :ast :symtab :ctx :call label: "from"
        fvc: fileFromArgCoerce :ast :symtab :ctx :call av: fv.stringview
        return "\{fc}_write(\{recvExpr}, &\{fvc})"
    }
    if mn.stringview == "read" then {
        iv: ctorArgByLabel :ast :symtab :ctx :call label: "into"
        mv: ctorArgByLabel :ast :symtab :ctx :call label: "max"
        ivptr9: argIsPointerByLabel :ast :symtab :ctx :call label: "into"
        if ivptr9 then return "\{fc}_read(\{recvExpr}, \{iv}, \{mv})"
        return "\{fc}_read(\{recvExpr}, &\{iv}, \{mv})"
    }
    if mn.stringview == "seek" then {
        tv: ctorArgByLabel :ast :symtab :ctx :call label: "to"
        ov: ctorArgByLabel :ast :symtab :ctx :call label: "from"
        return "\{fc}_seek(\{recvExpr}, \{tv}, \{ov})"
    }
    if mn.stringview == "writeLine" then {
        wlv: ctorArgByLabel :ast :symtab :ctx :call label: "from"
        wlc: fileFromArgCoerce :ast :symtab :ctx :call av: wlv.stringview
        return "\{fc}_writeLine(\{recvExpr}, &\{wlc})"
    }
    return "".string
}

# ioCreateWrapper -- the wrapper name X of an `io.X.create` callable, else "".
ioCreateWrapper: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case dottedpath then {
        ccn: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if ccn.stringview == "create" then {
            pb: dottedBaseAtom :ast n: (ast.nodes.get i: n.parent.u64)
            if pb.stringview == "io" then {
                return (dottedChildText :ast n: (ast.nodes.get i: n.parent.u64))
            }
        }
    } else null
    return "".string
}

# argBaseAtom9 / argBaseNodeId9 -- the base of a wrapper-create argument. The
# dotted extractors take the base of a PATH, which is what a `.lock`-suffixed
# argument always was; a `borrow` parameter needs no suffix, so the argument
# arrives as a BARE atom and is its own base. Without the fallback the emitter
# builds `z_t0__create(&)` -- an unresolved type and an empty expression -- which
# typechecks clean and dies at gcc.
argBaseAtom9: function {ast: Ast.view n: Node.view} out String is {
    b9: dottedBaseAtom :ast :n
    if b9.length > 0 then return b9
    return (atomTextOf :ast :n)
}

argBaseNodeId9: function {ast: Ast.view n: Node.view} out u32 is {
    i9: dottedBaseNodeId :ast :n
    if i9 > 0 then return i9.u32.orPanic
    return (atomNodeId9 :n).u32.orPanic
}

# wrapperCreateArg -- one io-wrapper create arg by the create-param type: a
# protocol-lock param projects the `.lock` base to that protocol; a class-lock
# param takes the base's address; a scalar param emits the arg directly.
wrapperCreateArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
    label: StringView
    ptid: ztypes.tid
} out String is {
    prtn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: ptid.u64)
    prtid: (canonTypeId
        :ast
        :symtab
        :ctx
        tid: (ztypes.tid.create from: ptid.u64)
        name: prtn.stringview
    )
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            al: zast.nameTextAt :ast ref: a.name
            if al.stringview == label then {
                if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: prtid.u64)) == ztypes.ztypetype.protocolType then {
                    ab: argBaseAtom9 :ast n: (ast.nodes.get i: a.operation.u64)
                    abnid: (argBaseNodeId9
                        :ast
                        n: (ast.nodes.get i: a.operation.u64)
                    ).u64
                    abrV0: atomVid :symtab nid: abnid
                    abr: aliasResolve :ctx name: ab.stringview vid: abrV0
                    abtid: stampIdOf :symtab nid: abnid
                    abcb: ctxCname :ctx tid: abtid
                    ablab: conformanceLabelFor :symtab implTid: abtid protoTid: prtid
                    abv9: ztypes.vid
                    if abr.stringview == ab.stringview then abv9 = (atomVid :symtab nid: abnid)
                    abrC: emitLocalAtomName :ctx name: ab.stringview vid: abrV0
                    abpfx9: "&".string
                    if (isPtrVid :ctx vid: abv9) then abpfx9 = "".string
                    return "\{abcb}_\{ablab}_create(\{abpfx9}\{abrC})"
                }
                if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: prtid.u64)) == ztypes.ztypetype.classType then {
                    a2op9: ast.nodes.get i: a.operation.u64
                    ab2: argBaseAtom9 :ast n: a2op9
                    abr2V0: atomVid :symtab nid: (argBaseNodeId9 :ast n: a2op9).u64
                    abr2: aliasResolve :ctx name: ab2.stringview vid: abr2V0
                    ab2v9: ztypes.vid
                    if abr2.stringview == ab2.stringview then ab2v9 = abr2V0
                    abr2C: emitLocalAtomName :ctx name: ab2.stringview vid: abr2V0
                    ab2pfx9: "&".string
                    if (isPtrVid :ctx vid: ab2v9) then ab2pfx9 = "".string
                    return "\{ab2pfx9}\{abr2C}"
                }
                return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64))
            }
        } else null
    }
    return "0".string
}

# emitIoWrapperCreate -- `io.BufWriter.create to: w.lock capacity: 16` ->
# z_t{id}_BufWriter_create(<projected/addressed args in param order>). "" for
# any non-io-wrapper-create callee.
emitIoWrapperCreate: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    wn: ioCreateWrapper :ast n: (ast.nodes.get i: call.callable.u64)
    if wn.length == 0 then return "".string
    wid: resolveTypeIdByName :ast :symtab :ctx name: wn.stringview
    if wid == 0 then return "".string
    if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: wid.u64)) != ztypes.ztypetype.classType then return "".string
    cco: (symtab.typing.declChildOfId
        parentTypeId: (ztypes.tid.create from: wid.u64)
        nameId: zast.wkCreate
    )
    cid: ztypes.tid
    match (
        cco
    ) case some then {
        cid = ztypes.tid.create from: (cco)
    } case none then null
    if cid.isZero then return "".string
    pnames: (List String)
    pids: (ListVal u64)
    pidsNm: (ListVal u64)
    (recFieldLists
        :ast
        :symtab
        tid: (ztypes.tid.create from: cid.u64)
        names: pnames
        ids: pids
        nameIds: pidsNm
    )
    args: String
    pi: u64
    pn: pnames.length
    for pi < pn loop {
        pnm: pnames.get i: pi
        ptid: pids.get i: pi
        astr: (wrapperCreateArg
            :ast
            :symtab
            :ctx
            :call
            label: pnm.stringview
            ptid: (ztypes.tid.create from: ptid.u64)
        )
        if pi > 0 then args.append ", "
        args.append astr
        pi = pi + 1
    }
    wcn: ctxCname :ctx tid: (ztypes.tid.create from: wid.u64)
    typeUseAdd :ctx tid: (ztypes.tid.create from: wid.u64)
    return "\{wcn}_create(\{args})"
}

# emitIoCall -- a free io.* native call (io.readText/writeText/appendText/
# eprintln/open/exists/mkdir/.../stat/listDir): `z_io_<name>(args...)` in the
# native's parameter order, setting the per-call need so the runtime pass emits
# the body. Returns "" for any non-io callee.
# nativeNoArgOf9 -- the unit that DECLARES `base.memb` when the member is a
# native taking no parameters, so a no-paren read auto-calls it (os.pid,
# io.stdout). "" otherwise. The gates run cheapest first: nearly every dotted
# path has a non-unit base and stops at the registry lookup, and the shadow
# check -- a declaration of the base name in `unitName` displaces the unit,
# since name ids are pooled program-wide -- runs only once a native is in
# hand.
nativeNoArgOf9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    unitName: StringView
    baseId: zast.nameid
    base: StringView
    membId: zast.nameid
} out String is {
    if baseId.isZero then return "".string
    if (ztypecheck.isUnitNameDecl
        ty: symtab.typing
        reg: symtab.reg
        nameId: baseId
    ) == false then return "".string
    ud14x9: ztypecheck.unitDeclOfNameId ty: symtab.typing nameId: baseId
    fo9: (ztypecheck.resolvedByIds
        :ast
        ty: symtab.typing

        unitDecl: ud14x9
        name: membId
    )
    fid9: ztypes.tid
    match (
        fo9
    ) case some then {
        fid9 = ztypes.tid.create from: (fo9)
    } case none then {
        return "".string
    }
    if (symtab.reg.typetypeOf typeId: fid9) != ztypes.ztypetype.functionType then return "".string
    if (fnIsNativeId :symtab fid: fid9) == false then return "".string
    pn9: (List String)
    pi9: (ListVal u64)
    pnm9: (ListVal u64)
    recFieldLists :ast :symtab tid: fid9 names: pn9 ids: pi9 nameIds: pnm9
    if pn9.length > 0 then return "".string
    uq5z9: ztypecheck.unitDeclOfName ty: symtab.typing :ast name: unitName
    sh9: (ztypecheck.resolveUnitChild
        :ast
        ty: symtab.typing
        reg: symtab.reg
        unitDecl: uq5z9
        name: base
    )
    match (
        sh9
    ) case some then {
        shT9: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: sh9)
        if shT9 != ztypes.ztypetype.unitType then return "".string
    } case none then null
    duo9: definedInUnitOf :symtab tid: fid9
    match (
        duo9
    ) case some then {
        return duo9.copy
    } case none then {
        return "".string
    }
}

# noArgNativeRhs -- a binding RHS that is a bare zero-parameter native
# auto-call (os.args / os.envNames return an owned List, so the binding's List
# branch must emit the call, not a fresh empty list).
noArgNativeRhs: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    unitName: StringView
    n: Node.view
} out bool is {
    match (
        n
    ) case expression then {
        return (noArgNativeRhs :ast :symtab :unitName n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (noArgNativeRhs
            :ast
            :symtab
            :unitName
            n: (ast.nodes.get i: n.statementline.u64)
        )
    } case dottedpath then {
        base9: atomTextOf :ast n: (ast.nodes.get i: n.parent.u64)
        nu9: (nativeNoArgOf9
            :ast
            :symtab
            :unitName
            baseId: (atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
            base: base9.stringview
            membId: (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
        )
        return nu9.length > 0
    } else {
        return false
    }
}

# lowerNativeArg -- lower one native-call argument from the DECLARED
# parameter: StringView / StringLike-generic params take a by-value view
# (String args project, interpolations hoist to a view); class and
# borrowed-List params pass by pointer; take params pass the owned value;
# scalars pass verbatim.
lowerNativeArg: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    fid: ztypes.tid
    pname: StringView
    pid: ztypes.tid
    op: Node.view
} out String is {
    isViewP9: false
    if pid == ctx.svTid then isViewP9 = true
    if (symtab.reg.typetypeOf typeId: pid) == ztypes.ztypetype.genericParam then isViewP9 = true
    if isViewP9 then {
        avh9: emitColInterpArg :ast :symtab :ctx n: op consumes: false
        if avh9.length > 0 then return (svValueForm
            :ctx
            expr: avh9.stringview
            isStr: true
            vid: (ztypes.vid.create from: 0)
        )
        av0: emitExpr :ast :symtab :ctx n: op
        sidx09: stampIdOf :symtab nid: (nodeIdOf9 n: op)
        if sidx09 == ctx.strTid then {
            hb9: (hoistBorrowValArg
                :ast
                :symtab
                :ctx
                av: av0.stringview
                pid: ctx.strTid
                paramTake: false
                isBorrow: (hoistExprIsBorrowRooted :ast :symtab :ctx n: op)
            )
            if hb9.length > 0 then av0 = hb9
            av0q9: atomVidIfPlain :ast :symtab :ctx n: op text: av0.stringview
            return (svValueForm :ctx expr: av0.stringview isStr: true vid: av0q9)
        }
        return av0
    }
    iv9: emitInterpArgExpr :ast :symtab :ctx n: op
    if iv9.length > 0 then return iv9
    isTake9: (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: fid
        name: pname
        own: ztypes.zparamownership.takeMode
    )
    needAmp9: false
    if (isTake9) == false then {
        if (isReftypeParam
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: pid.u64)
        ) then needAmp9 = true
        if (isListPtrParam
            :ast
            :symtab
            :ctx
            :fid
            :pname
            tid: (ztypes.tid.create from: pid.u64)
        ) then needAmp9 = true
        if (markedValtypeRefParam :ast :symtab :fid :pname :pid) then needAmp9 = true
    }
    av1: emitExpr :ast :symtab :ctx n: op
    if needAmp9 when (pathIsPointer :ast :symtab :ctx n: op) == false then return "&\{av1}"
    return av1
}

# emitNativeArg -- find one native-call argument by label, else by the
# positional cursor, and lower it (lowerNativeArg).
emitNativeArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    fid: ztypes.tid
    pname: StringView
    pid: ztypes.tid
    usePos: bool
    posIdx: u64
} out String is {
    seen9: u64
    with aiter: call.arguments.iterate do for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            al: zast.nameTextAt :ast ref: a.name
            if usePos then {
                if al.length == 0 then {
                    if seen9 == posIdx then {
                        return (lowerNativeArg
                            :ast
                            :symtab
                            :ctx
                            :fid
                            :pname
                            :pid
                            op: (ast.nodes.get i: a.operation.u64)
                        )
                    }
                    seen9 = seen9 + 1
                }
            } else {
                if al.stringview == pname then {
                    return (lowerNativeArg
                        :ast
                        :symtab
                        :ctx
                        :fid
                        :pname
                        :pid
                        op: (ast.nodes.get i: a.operation.u64)
                    )
                }
            }
        } else null
    }
    return "0".string
}

# emitNativeFreeFnCall -- ANY call (dotted `io.remove ...` or a bare sibling
# `remove ...` inside the unit) that resolves to an `is native` FREE function
# of a runtime-convention unit emits `z_<unit>_<name>(<args>)`, each argument
# lowered from the declared parameter (emitNativeArg). "" for anything else:
# bodied siblings fall through to the id-cname route, methods to their own
# legs, non-convention natives (stringJoin/print/panic) to theirs.
emitNativeFreeFnCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    un: String
    mn: String
    fidHint: u64
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    if bn.length > 0 then {
        calr9: ast.nodes.get i: call.callable.u64
        mn = dottedChildText :ast n: calr9
        dp9: "\{bn}.\{mn}"
        if (nativeIsFragBacked :ctx path: dp9.stringview) == false then return "".string
        un = bn
    } else {
        cn0: atomTextOf :ast n: (ast.nodes.get i: call.callable.u64)
        if cn0.length == 0 then return "".string
        fid0: userFnId :ast :symtab :ctx name: cn0.stringview
        if fid0.isZero then return "".string
        if (fnIsNativeId
            :symtab
            fid: (ztypes.tid.create from: fid0.u64)
        ) == false then return "".string
        duo0: definedInUnitOf :symtab tid: fid0
        match (
            duo0
        ) case some then {
            bp9: "\{duo0}.\{cn0}"
            if (nativeIsFragBacked :ctx path: bp9.stringview) == false then return "".string
            un = duo0.copy
        } case none then {
            return "".string
        }
        mn = cn0
        fidHint = fid0
    }
    if mn.length == 0 then return "".string
    fid: ztypes.tid
    if fidHint > 0 then {
        fid = ztypes.tid.create from: (fidHint)
    } else {
        ud15x9: (ztypecheck.unitDeclOfNameId
            ty: symtab.typing
            nameId: (zast.poolFind pool: ast.names text: un.stringview)
        )
        fo9: (ztypecheck.resolvedByIds
            :ast
            ty: symtab.typing

            unitDecl: ud15x9
            name: (zast.poolFind pool: ast.names text: mn.stringview)
        )
        match (
            fo9
        ) case some then {
            fid = ztypes.tid.create from: (fo9)
        } case none then {
            return "".string
        }
    }
    if (symtab.reg.typetypeOf typeId: fid) != ztypes.ztypetype.functionType then return "".string
    if (fnIsNativeId :symtab :fid) == false then return "".string
    needsAddM :ctx uname: un.stringview memb: "@unit"
    needsAddM :ctx uname: un.stringview memb: mn.stringview
    pn: (List String)
    pidl: (ListVal u64)
    pidlNm: (ListVal u64)
    recFieldLists :ast :symtab tid: fid names: pn ids: pidl nameIds: pidlNm
    args: String
    m: pn.length
    j: u64
    posIdx9: u64
    for j < m loop {
        pname: pn.get i: j
        pid: pidl.get i: j
        j = j + 1
        hasL9: ctorHasLabel :ast :call label: pname.stringview
        av: String
        if hasL9 then {
            av = (emitNativeArg
                :ast
                :symtab
                :ctx
                :call
                :fid
                pname: pname.stringview
                pid: (ztypes.tid.create from: pid.u64)
                usePos: false
                posIdx: 0
            )
        } else {
            av = (emitNativeArg
                :ast
                :symtab
                :ctx
                :call
                :fid
                pname: pname.stringview
                pid: (ztypes.tid.create from: pid.u64)
                usePos: true
                posIdx: posIdx9
            )
            posIdx9 = posIdx9 + 1
        }
        if args.length > 0 then args.append ", "
        args.append av
    }
    return "z_\{un}_\{mn}(\{args})"
}

# cliCreateClass -- the class name X of a `cli.X.create` callable, else "".
cliCreateClass: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case dottedpath then {
        ccn: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if ccn.stringview == "create" then {
            pb: dottedBaseAtom :ast n: (ast.nodes.get i: n.parent.u64)
            if pb.stringview == "cli" then {
                return (dottedChildText :ast n: (ast.nodes.get i: n.parent.u64))
            }
        }
    } else null
    return "".string
}

# emitCliSpecCreate -- `cli.Spec.create programName: ... summary: ...` ->
# z_t{id}_Spec_create(<args in param order>). "" for any non-cli-create callee.
emitCliSpecCreate: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    cn: cliCreateClass :ast n: (ast.nodes.get i: call.callable.u64)
    if cn.length == 0 then return "".string
    cid: (cliClassTypeId
        :symtab
        :ctx
        nameId: (zast.poolFind pool: ast.names text: cn.stringview)
    )
    if cid == 0 then return "".string
    cco: (symtab.typing.declChildOfId
        parentTypeId: (ztypes.tid.create from: cid.u64)
        nameId: zast.wkCreate
    )
    crid: ztypes.tid
    match (
        cco
    ) case some then {
        crid = ztypes.tid.create from: (cco)
    } case none then null
    if crid.isZero then return "".string
    pnames: (List String)
    pids: (ListVal u64)
    pidsNm: (ListVal u64)
    (recFieldLists
        :ast
        :symtab
        tid: (ztypes.tid.create from: crid.u64)
        names: pnames
        ids: pids
        nameIds: pidsNm
    )
    args: String
    pi: u64
    pn: pnames.length
    for pi < pn loop {
        pnm: pnames.get i: pi
        astr: ctorArgByLabel :ast :symtab :ctx :call label: pnm.stringview
        if pi > 0 then args.append ", "
        args.append astr
        pi = pi + 1
    }
    needsAddM :ctx uname: "cli" memb: "@unit"
    needsAddM :ctx uname: "cli" memb: "spec_create"
    ccb: ctxCname :ctx tid: (ztypes.tid.create from: cid.u64)
    return "\{ccb}_create(\{args})"
}

# emitParsedMethodCall -- a Parsed accessor (hasFlag/option/positional), native,
# receiver by pointer (incl. the narrowed Result ok-arm projection) and the
# StringView name by pointer. "" for any non-Parsed receiver.
# emitResultCombinator -- inline lowering of the built-in result combinators
# `.orPanic` (unwrap the ok payload or abort) and `.or d:` (unwrap or default)
# on a `resultval` receiver (the variant is the only type declaring them; the
# `Result` union's C shape has no tagged arm to project). Branchless
# statement-expression, no result struct call. "" when the call is not one of
# these.
emitResultCombinator: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    isP9: false
    if mn.stringview == "orPanic" then isP9 = true
    isO9: false
    if mn.stringview == "or" then isO9 = true
    bothMiss9: (isP9) == false
    if bothMiss9 when (isO9) == false then return "".string
    bnid: u32
    {
        cnDp9: ast.nodes.get i: call.callable.u64
        match (
            cnDp9
        ) case dottedpath then {
            bnid = cnDp9.parent
        } else null
    }
    if bnid == 0 then return "".string
    rtid0: stampIdOf :symtab nid: (nodeIdOf9 n: (ast.nodes.get i: bnid.u64))
    rtid: chaseColMono :symtab :ctx tid: rtid0
    if rtid.isZero then return "".string
    orig: monoOriginName :symtab tid: (ztypes.tid.create from: rtid.u64)
    if (orig.stringview == "resultval") == false then return "".string
    recvExpr: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: bnid.u64)
    if recvExpr.length == 0 then return "".string
    okTag: variantTag :symtab tid: (ztypes.tid.create from: rtid.u64) arm: "ok"
    rcT9: ctxCname :ctx tid: (ztypes.tid.create from: rtid.u64)
    if isP9 then {
        rp9: "({ \{rcT9}_t _rc = (\{recvExpr.stringview}); if (_rc.tag != \{okTag.stringview}) z_panic(\"orPanic: result is err\"); _rc.data.ok; })"
        return rp9
    }
    argN9: call.arguments.length
    if argN9 == 0 then return "".string
    argId0: call.arguments.get i: 0
    opId9: zast.nodeid
    {
        a9: ast.nodes.get i: argId0.u64
        match (
            a9
        ) case namedoperation then {
            opId9 = a9.operation
        } else null
    }
    if opId9.isZero then return "".string
    dExpr: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: opId9.u64)
    if dExpr.length == 0 then return "".string
    ro9: "({ \{rcT9}_t _rc = (\{recvExpr.stringview}); (_rc.tag == \{okTag.stringview}) ? _rc.data.ok : (\{dExpr.stringview}); })"
    return ro9
}

# emit a method call resolved at parse time.
emitParsedMethodCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    isPM: false
    if mn.stringview == "hasFlag" then isPM = true
    if mn.stringview == "option" then isPM = true
    if mn.stringview == "positional" then isPM = true
    if (isPM) == false then return "".string
    bnid: dottedBaseNodeId :ast n: (ast.nodes.get i: call.callable.u64)
    pid: fileTypeIdOf :symtab nid: bnid
    if pid == 0 then return "".string
    pcn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: pid.u64)
    if pcn.stringview != "Parsed" then return "".string
    pc: ctxCname :ctx tid: (ztypes.tid.create from: pid.u64)
    recvV0: atomVid :symtab nid: bnid
    recv: aliasResolve :ctx name: bn.stringview vid: recvV0
    recvV9: ztypes.vid
    if recv.stringview == bn.stringview then recvV9 = recvV0
    recvC: emitLocalAtomName :ctx name: bn.stringview vid: recvV0
    recvExpr: "&\{recvC}"
    if (isPtrVid :ctx vid: recvV9) then recvExpr = recvC
    needsAddM :ctx uname: "cli" memb: "@unit"
    needsAddM :ctx uname: "cli" memb: mn.stringview
    nameArg: ctorArgByLabel :ast :symtab :ctx :call label: "name"
    return "\{pc}_\{mn}(\{recvExpr}, &\{nameArg})"
}

# isLockArg -- the argument (through expression wrappers) is an `x.lock` borrow
# projection; such a value passes by address to a borrow param.
isLockArg: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (isLockArg :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        cn9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        return cn9.stringview == "lock"
    } else {
        return false
    }
}

# emitUserIterCall -- a manual `g.call value: X` on a user iterator class (a
# generator's iter): `z_t{id}_{Fn}_iter_call(&g, X)`; a `.lock` borrow value
# passes by address. "" for any non-user-iter `.call`.
emitUserIterCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if mn.stringview != "call" then return "".string
    bnid: dottedBaseNodeId :ast n: (ast.nodes.get i: call.callable.u64)
    rid0: stampIdOf :symtab nid: bnid
    if rid0.isZero then return "".string
    iterId: rid0
    ot0: originTidOf :symtab tid: rid0
    if ot0.isZero then {
        rtn9: typeNameOfReg9 :symtab tid: rid0
        cano9: (ztypecheck.walkLookupTyperef
            :ast
            ty: symtab.typing
            reg: symtab.reg
            unitDecl: (ztypecheck.unitDeclOfName
                ty: symtab.typing
                :ast
                name: ctx.mainName.stringview
            )
            base: rtn9.stringview
        )
        match (
            cano9
        ) case some then {
            hasCallI9: (symtab.typing.declHasMemberId
                parentTypeId: (ztypes.tid.create from: cano9.u64)
                nameId: zast.wkCall
            )
            if hasCallI9 then iterId = ztypes.tid.create from: cano9.u64
        } case none then null
    }
    if (symtab.reg.typetypeOf typeId: iterId) != ztypes.ztypetype.classType then return "".string
    itorig9: originTidOf :symtab tid: iterId
    if itorig9 > 0 then return "".string
    itn9: typeNameOfReg9 :symtab tid: iterId
    if (canonFnId :ast :symtab :ctx tid: iterId name: itn9.stringview) <= 0 then return "".string
    cco9: symtab.typing.declChildOfId parentTypeId: iterId nameId: zast.wkCall
    match (
        cco9
    ) case some then {
        callC9: ctxCname :ctx tid: (ztypes.tid.create from: cco9.u64)
        recv9V0: atomVid :symtab nid: bnid
        recv9: aliasResolve :ctx name: bn.stringview vid: recv9V0
        recvV9: ztypes.vid
        if recv9.stringview == bn.stringview then recvV9 = recv9V0
        recvC9: emitLocalAtomName :ctx name: bn.stringview vid: recv9V0
        recvExpr9: "&\{recvC9}"
        if (isPtrVid :ctx vid: recvV9) then recvExpr9 = recvC9
        valArg9: String
        hasVal9: false
        with aiter9: call.arguments.iterate do for av9Id9: aiter9 loop {
            av9: ast.nodes.get i: av9Id9.u64
            match (
                av9
            ) case namedoperation then {
                al9: zast.nameTextAt :ast ref: av9.name
                if al9.stringview == "value" then {
                    hasVal9 = true
                    ve9: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: av9.operation.u64)
                    # The resume value goes by REFERENCE when it is a reftype --
                    # the synthesised `.call` declares that parameter as a
                    # pointer. This used to key on `isLockArg`, i.e. on the
                    # argument's SPELLING, so a `borrow` parameter's bare-name
                    # argument silently lost its `&` and gcc got a value where a
                    # `T*` was declared. Ask the TYPE instead; a `.lock`-suffixed
                    # argument reaches the same answer through argBaseAtom9.
                    vop9: ast.nodes.get i: av9.operation.u64
                    vbase9: argBaseAtom9 :ast n: vop9
                    vbnid9: (argBaseNodeId9 :ast n: vop9).u64
                    vIsRef9: false
                    if vbase9.length > 0 then {
                        vIsRef9 = (isReftypeParam
                            :ast
                            :symtab
                            :ctx
                            tid: (stampIdOf :symtab nid: vbnid9)
                        )
                    }
                    if vIsRef9 then {
                        vbr9V0: atomVid :symtab nid: vbnid9
                        vbr9: aliasResolve :ctx name: vbase9.stringview vid: vbr9V0
                        vbv9: ztypes.vid
                        if vbr9.stringview == vbase9.stringview then vbv9 = vbr9V0
                        vpfx9: "&".string
                        if (isPtrVid :ctx vid: vbv9) then vpfx9 = "".string
                        valArg9 = "\{vpfx9}\{ve9}"
                    } else {
                        valArg9 = ve9
                    }
                }
            } else null
        }
        if hasVal9 then return "\{callC9}(\{recvExpr9}, \{valArg9})"
        return "\{callC9}(\{recvExpr9})"
    } case none then {
        return "".string
    }
}

# dispatchableTid9 -- a vtable-dispatch receiver type: protocol or facet.
dispatchableTid9: function {symtab: zenv.ZSymbolTable tid: ztypes.tid} out bool is {
    tt9: symtab.reg.typetypeOf typeId: tid
    if tt9 == ztypes.ztypetype.protocolType then return true
    return tt9 == ztypes.ztypetype.facetType
}

# vtableDataArg9 -- the receiver argument a vtable slot takes. A protocol's
# `data` is already a pointer to the boxed impl; a facet stores the impl INLINE
# in a union, so the slot takes its address.
vtableDataArg9: function {recv: StringView acc: StringView isFacet: bool} out String is {
    if isFacet then return "&\{recv}\{acc}data"
    return "\{recv}\{acc}data"
}

# vtableAutoCallName9 -- a member name that dispatches through the vtable. The
# three lifecycle verbs are emitted by their own legs (emitProtocolCreateCall
# and the destroy helper) and have no vtable slot.
vtableAutoCallName9: function {name: StringView} out bool is {
    if name == "create" then return false
    if name == "borrow" then return false
    if name == "release" then return false
    return true
}

# vtableAutoCallC9 -- a ZERO-ARG method auto-call on a protocol/facet receiver.
# A zero-arg method is not a Call node, so it never reaches
# emitProtocolDispatch; this is the same dispatch spelled for the dotted-path
# legs.
vtableAutoCallC9: function {
    recv: StringView
    acc: StringView
    mn: StringView
    isFacet: bool
} out String is {
    dargs9: vtableDataArg9 :recv :acc :isFacet
    return "\{recv}\{acc}vtable->\{(cSlotName name: mn)}(\{dargs9})"
}

# emit a protocol method dispatch.
emitProtocolDispatch: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if mn.length == 0 then return "".string
    if mn.stringview == "create" then return "".string
    if mn.stringview == "borrow" then return "".string
    if mn.stringview == "release" then return "".string
    rtid: dottedReceiverStampId :ast :symtab callable: (ast.nodes.get i: call.callable.u64)
    if (dispatchableTid9 :symtab tid: (ztypes.tid.create from: rtid.u64)) == false then {
        rtn0: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: rtid.u64)
        if rtn0.length > 0 then {
            brid: (canonTypeId
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: rtid.u64)
                name: rtn0.stringview
            )
            if (dispatchableTid9
                :symtab
                tid: (ztypes.tid.create from: brid.u64)
            ) then rtid = ztypes.tid.create from: brid.u64
        }
    }
    if (dispatchableTid9
        :symtab
        tid: (ztypes.tid.create from: rtid.u64)
    ) == false then return "".string
    isFacetR9: (symtab.reg.typetypeOf typeId: rtid) == ztypes.ztypetype.facetType
    recv: emitDottedReceiver :ast :symtab :ctx callable: (ast.nodes.get i: call.callable.u64)
    if recv.length == 0 then return "".string
    acc: ".".string
    xq129: ast.nodes.get i: call.callable.u64
    if (dottedReceiverIsPtr :ast :symtab :ctx callable: xq129) then acc = "->".string
    dargs: (vtableDataArg9
        recv: recv.stringview
        acc: acc.stringview
        isFacet: isFacetR9
    )
    mtid9: optU64Or9 o: (symtab.typing.declChildOf
        pool: ast.names
        parentTypeId: rtid
        name: mn.stringview
    )
    mpNames9: (List String)
    mpIds9: (ListVal u64)
    mpIds9Nm: (ListVal u64)
    if mtid9 > 0 then (recFieldLists
        :ast
        :symtab
        tid: (ztypes.tid.create from: mtid9.u64)
        names: mpNames9
        ids: mpIds9
        nameIds: mpIds9Nm
    )
    vpn9: (List String)
    vi9: u64
    for vi9 < mpNames9.length loop {
        nm9: mpNames9.get i: vi9
        if nm9.stringview != "this" then vpn9.append nm9.copy
        vi9 = vi9 + 1
    }
    if vpn9.length > 0 then {
        slots9p: argSlotList :ast :call fpNames: vpn9
        valBySlot9p: (IdMapR u64 value: String)
        ai9p: u64
        with aiter: call.arguments.iterate do for aId9: aiter loop {
            a: ast.nodes.get i: aId9.u64
            match (
                a
            ) case namedoperation then {
                slot9p: slots9p.get i: ai9p
                if slot9p < vpn9.length then {
                    av: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64)
                    atid9: (stampIdOf
                        :symtab
                        nid: (nodeIdOf9 n: (ast.nodes.get i: a.operation.u64))
                    )
                    apfx9: String
                    chs19: chaseColMono :symtab :ctx tid: atid9
                    if (chs19 == atid9) == false then apfx9 = "&".string
                    if (isCollectionOriginTid
                        :ctx
                        originTid: (originTidOf :symtab tid: atid9)
                    ) then apfx9 = "&".string
                    if (pathIsPointer
                        :ast
                        :symtab
                        :ctx
                        n: (ast.nodes.get i: a.operation.u64)
                    ) then apfx9 = "".string
                    fs9p: "\{apfx9}\{av}"
                    valBySlot9p.set key: slot9p value: fs9p
                }
                ai9p = ai9p + 1
            } else null
        }
        pp9p: u64
        ppn9p: vpn9.length
        for pp9p < ppn9p loop {
            vo9p: valBySlot9p.get key: pp9p
            match (
                vo9p
            ) case some then {
                dargs.append ", "
                dargs.append vo9p
            } case none then null
            pp9p = pp9p + 1
        }
    } else {
        with aiter: call.arguments.iterate do for aId9: aiter loop {
            a: ast.nodes.get i: aId9.u64
            match (
                a
            ) case namedoperation then {
                av: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: a.operation.u64)
                atid9: (stampIdOf
                    :symtab
                    nid: (nodeIdOf9 n: (ast.nodes.get i: a.operation.u64))
                )
                apfx9: String
                chs29: chaseColMono :symtab :ctx tid: atid9
                if (chs29 == atid9) == false then apfx9 = "&".string
                if (isCollectionOriginTid :ctx originTid: (originTidOf :symtab tid: atid9)) then {
                    apfx9 = "&".string
                }
                if (pathIsPointer
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                ) then apfx9 = "".string
                dargs.append ", "
                dargs.append apfx9
                dargs.append av
            } else null
        }
    }
    dslot9: cSlotName name: mn.stringview
    de: "\{recv}\{acc}vtable->\{dslot9}(\{dargs})"
    return de
}

# emitProtocolCreateCall -- `Reader.create from: g.take` (owned, heap-box +
# source invalidation) / `Provider.borrow from: m.lock` (borrowed, shares the
# source). Both route to the impl's conformance helper for the protocol.
emitProtocolCreateCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
} out String is {
    bn: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    if bn.length == 0 then return "".string
    mn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    isCreate: false
    if mn.stringview == "create" then isCreate = true
    if mn.stringview == "borrow" then isCreate = true
    if (isCreate) == false then return "".string
    protoTid: resolveTypeIdByName :ast :symtab :ctx name: bn.stringview
    ptt9: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: protoTid.u64)
    isFct9: ptt9 == ztypes.ztypetype.facetType
    if ptt9 != ztypes.ztypetype.protocolType when isFct9 == false then return "".string
    suffix: "create_owned".string
    if mn.stringview == "borrow" then suffix = "create".string
    # a facet copies its source either way: one helper serves both verbs
    if isFct9 then suffix = "create".string
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            an: zast.nameTextAt :ast ref: a.name
            if an.stringview == "from" then {
                fop9: ast.nodes.get i: a.operation.u64
                fromBase: dottedBaseAtom :ast n: fop9
                if fromBase.length == 0 then fromBase = (atomTextOf :ast n: fop9)
                fdn: stampNameDeep :ast :symtab n: (ast.nodes.get i: a.operation.u64)
                fromTid: (canonTypeId
                    :ast
                    :symtab
                    :ctx
                    tid: (stampIdDeep :ast :symtab n: (ast.nodes.get i: a.operation.u64))
                    name: fdn.stringview
                )
                if fromTid == 0 then return "".string
                implBase: ctxCname :ctx tid: (ztypes.tid.create from: fromTid.u64)
                label: conformanceLabelFor :symtab implTid: fromTid :protoTid
                if label.length == 0 then return "".string
                valVarV0: atomVid :symtab nid: (dottedBaseNodeId :ast n: fop9)
                if valVarV0.isZero then valVarV0 = (atomVid :symtab nid: (atomNodeId9 n: fop9))
                valVar: aliasResolve :ctx name: fromBase.stringview vid: valVarV0
                vvv9: ztypes.vid
                if valVar.stringview == fromBase.stringview then vvv9 = valVarV0
                valVarC: emitLocalAtomName :ctx name: fromBase.stringview vid: valVarV0
                refPfx9: "&".string
                if (isPtrVid :ctx vid: vvv9) then refPfx9 = "".string
                ce: "\{implBase}_\{label}_\{suffix}(\{refPfx9}\{valVarC})"
                return ce
            }
        } else null
    }
    return "".string
}

# emitRecordDefsIn -- three passes so cross-class references resolve: the
# as-block constants and data blocks, then all method forward decls, then all
# method bodies (a method may return/construct a class defined later in the
# unit). Struct layout is NOT emitted here: emitUserStructsOrdered owns it, and
# resolves the by-value ordering between user types and the monos that embed
# them, which a per-unit walk in declaration order cannot.
emitRecordDefsIn: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    mainOpId: zast.nodeid
    phase: u64
    buf: String.borrow
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: mainOpId
    {
        if phase == 1 then {
        with biterA: bodyIds9.iterate do for bmId9: biterA loop {
            bm: ast.nodes.get i: bmId9.u64
            match (
                bm
            ) case namedoperation then {
                if (isRecordDef9 n: (ast.nodes.get i: bm.operation.u64)) then {
                    nm: zast.nameTextAt :ast ref: bm.name
                    rid: userFnId :ast :symtab :ctx name: nm.stringview
                    if rid > 0 when (isGenericType :symtab tid: rid) == false then {
                        (emitAsConsts
                            :ast
                            :symtab
                            :ctx
                            tid: rid
                            name: nm.stringview
                            op: (ast.nodes.get i: bm.operation.u64)
                            :buf
                        )
                    }
                }
                if (isClassDef9 n: (ast.nodes.get i: bm.operation.u64)) then {
                    nmc: zast.nameTextAt :ast ref: bm.name
                    cid9: userFnId :ast :symtab :ctx name: nmc.stringview
                    if cid9 > 0 when (isGenericType :symtab tid: cid9) == false then {
                        (emitAsConsts
                            :ast
                            :symtab
                            :ctx
                            tid: cid9
                            name: nmc.stringview
                            op: (ast.nodes.get i: bm.operation.u64)
                            :buf
                        )
                    }
                }
                nm6: zast.nameTextAt :ast ref: bm.name
                (emitDataBlock
                    :ast
                    :symtab
                    :ctx
                    name: nm6.stringview
                    op: (ast.nodes.get i: bm.operation.u64)
                    :buf
                )
            } else null
        }
        }
        if phase == 2 then {
        with biterB: bodyIds9.iterate do for bmdId9: biterB loop {
            bmd: ast.nodes.get i: bmdId9.u64
            emitDefMethods :ast :symtab :ctx bm: bmd declOnly: true :buf
        }
        with biterI: bodyIds9.iterate do for biId9: biterI loop {
            bi: ast.nodes.get i: biId9.u64
            match (
                bi
            ) case namedoperation then {
                isImpl7: false
                if (isClassDef9 n: (ast.nodes.get i: bi.operation.u64)) then isImpl7 = true
                if (isRecordDef9 n: (ast.nodes.get i: bi.operation.u64)) then isImpl7 = true
                if isImpl7 then {
                    nmi7: zast.nameTextAt :ast ref: bi.name
                    iid7: userFnId :ast :symtab :ctx name: nmi7.stringview
                    if iid7 > 0 then {
                        (emitProtocolImplsForType
                            :ast
                            :symtab
                            :ctx
                            implTid: iid7
                            :buf
                        )
                        (emitFacetImplsForType
                            :ast
                            :symtab
                            :ctx
                            implTid: iid7
                            :buf
                        )
                    }
                }
            } else null
        }
        # main-unit function forward decls, after the struct defs (so a generator
        # function returning its synth iter class resolves) and before the method
        # bodies (a synth iterator's call body may call another generator's fn).
        with biterFD: bodyIds9.iterate do for bfdId9: biterFD loop {
            bfd: ast.nodes.get i: bfdId9.u64
            match (
                bfd
            ) case namedoperation then {
                if (isFunctionDefWithBody9 n: (ast.nodes.get i: bfd.operation.u64)) then {
                    fdn: zast.nameTextAt :ast ref: bfd.name
                    fdid: userFnId :ast :symtab :ctx name: fdn.stringview
                    isGenFnFD9: false
                    if fdid > 0 then {
                        if (isGenericType :symtab tid: fdid) then {
                            if (symtab.reg.typetypeOf typeId: fdid) == ztypes.ztypetype.functionType then {
                                isGenFnFD9 = true
                            }
                        }
                    }
                    # a definition that never resolved has no id, and its
                    # forward declaration renders as `z_t0(void)` over unbound
                    # parameter names -- two of them in one unit collide on
                    # return type, which is broken C rather than a diagnostic.
                    # Nothing can call what did not resolve, so there is nothing
                    # to declare.
                    if isGenFnFD9 == false when fdid > 0 then {
                        fdsig: (fnSignature
                            :ast
                            :symtab
                            :ctx
                            name: fdn.stringview
                            fid: (ztypes.tid.create from: fdid.u64)
                            op: (ast.nodes.get i: bfd.operation.u64)
                        )
                        fdl: "\{fdsig};\n"
                        buf.append fdl
                    }
                }
            } else null
        }
        }
        if phase == 3 then {
        with biterC: bodyIds9.iterate do for bmbId9: biterC loop {
            bmb: ast.nodes.get i: bmbId9.u64
            emitDefMethods :ast :symtab :ctx bm: bmb declOnly: false :buf
        }
        }
    }
}

# emitDataBlock -- `name: data { e0 e1 ... } out T`: a static const array
# z_{name}[] plus z_{name}_len, with the element C type from out T (i64
# default). The plain z_{name} cname matches the reference.
emitDataBlock: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    name: StringView
    op: Node.view
    buf: String.borrow
} is {
    match (
        op
    ) case expression then {
        emitDataBlock :ast :symtab :ctx :name op: (ast.nodes.get i: op.expression.u64) :buf
    } case datablock then {
        ridtid9: stampIdOf :symtab nid: op.nodeid.u64
        ri9: false
        {
            runtimeIndexed9v: symtab.reg.isRuntimeIndexedOf tid: ridtid9
                ri9 = runtimeIndexed9v
        }
        if ri9 then {
            ect: "int64_t".string
            rbn: dataElemBaseName :ast oId: op.outType
            if rbn.length > 0 then {
                rc: cTypeOf name: rbn.stringview
                if rc.length > 0 then ect = rc
            }
            elems: String
            cnt: u64
            eiter: op.elements.iterate
            for e: eiter loop {
                ev: emitDataElem :ast :symtab :ctx n: (ast.nodes.get i: e.u64)
                if cnt > 0 then elems.append ", "
                elems.append ev
                cnt = cnt + 1
            }
            dsym9: ctxCname :ctx tid: ridtid9
            l0: "static const \{ect} \{dsym9}[] = {\{elems}};\n\n"
            buf.append l0
        }
    } else null
}

# emitDataElem -- a data-block element (a NamedOperation wrapping the
# value atom); emit its inner expression.
emitDataElem: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
} out String is {
    match (
        n
    ) case namedoperation then {
        return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.operation.u64))
    } else {
        return (emitExpr :ast :symtab :ctx :n)
    }
}

# the base type name of data block `oId`.
dataElemBaseName: function {ast: Ast.view oId: zast.nodeid} out String is {
    if oId.isZero then return "".string
    return (atomTextDeep :ast n: (ast.nodes.get i: oId.u64))
}

# armTagValueText9 -- the declared discriminator of the arm named `armNameId`
# on the tagged type `tid`, as a C enumerator initialiser (" = 10"), or "" when
# the type's tag names no value for it.
#
# A `data`-sourced tag names its own values and the enum must carry them, or
# the declaration means nothing past the front end. The tag the compiler
# synthesizes when the author declares none names no values, so its enum keeps
# C's own numbering -- which IS the arm ordinals, the thing every other part of
# the backend already assumes.
armTagValueText9: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
    armNameId: u64
} out String is {
    if armNameId == 0 then return "".string
    dt9: u64
    {
        d0: symtab.typing.declChildOfId parentTypeId: tid nameId: zast.wkTag
        match (
            d0
        ) case some then {
            dt9 = d0
        } case none then null
    }
    if dt9 == 0 then return "".string
    c9: (symtab.typing.memberConstOf
        parentTypeId: (ztypes.tid.create from: dt9.u64)
        nameId: (zast.nameid.create from: armNameId.u32.orPanic)
    )
    if (c9.kind.ivalKind) == false then return "".string
    iv9: c9.ival
    return " = \{iv9}"
}

# checkTagStem -- a variant/union mono's tag ENUMERATORS are spelled from its
# canonical name (`Z_RESULTVAL_U8_CONVERROR_TAG_ERR`) while the type itself is
# spelled from its id, and deliberately so: hand-written runtime fragments name
# the tags literally, and under the default naming the id carries no name at
# all. The scheme therefore holds only while one canonical name means one
# emitted mono -- a typecheck invariant (the specialization trie) that the
# emitter cannot restore, so it says so here rather than handing gcc two
# declarations of one enumerator.
checkTagStem: function {symtab: zenv.ZSymbolTable.view ctx: Ctx tid: ztypes.tid} is {
    tsN9: typeNameOfReg9 :symtab :tid
    tsO9: ctx.tagStems.get key: tsN9
    match (
        tsO9
    ) case some then {
        c1s9: ctxCname :ctx tid: (ztypes.tid.create from: tsO9.u64)
        c2s9: ctxCname :ctx :tid
        mts9: "two monos share the name '\{tsN9}' (\{c1s9}, \{c2s9}); their tag enumerators collide"
        emitFail :ctx what: mts9 line: 0
    } case none then {
        ctx.tagStems.set key: tsN9.copy value: tid
    }
}

# emitOneVariant -- tag enum + tagged struct (+ payload union when any
# arm carries one) + the by-tag/value eq helper.
emitOneVariant: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    egv9: ctx.emittedUserTypes.get key: tid
    match (
        egv9
    ) case some then {
        return
    } case none then null
    ctx.emittedUserTypes.set key: tid.u64 value: true
    anames: (List String)
    aids: (ListVal u64)
    aidsNm: (ListVal u64)
    variantArms :ast :symtab :tid names: anames ids: aids nameIds: aidsNm
    # An ARMLESS variant is a constraint-only marker (`anyval`): nothing can
    # ever hold one, and an empty C enum does not compile. The union marker
    # `Any` was never emitted for the same reason -- this makes the variant
    # side agree rather than emitting invalid C.
    if anames.length == 0 then return
    checkTagStem :symtab :ctx :tid
    preEmitEmbeddedTypes :ast :symtab :ctx ids: aids :buf
    vc: ctxCname :ctx :tid
    buf.append "typedef enum {\n"
    ai: u64
    an: anames.length
    for ai < an loop {
        aname: anames.get i: ai
        tg: variantTag :symtab :tid arm: aname.stringview
        tv: armTagValueText9 :symtab :tid armNameId: (aidsNm.get i: ai)
        lt: "    \{tg}\{tv},\n"
        buf.append lt
        ai = ai + 1
    }
    le: "} \{vc}_tag_t;\n"
    buf.append le
    # An ORDINAL is its own discriminator. The struct would hold the tag and
    # nothing else, so the type IS the tag's storage -- the enum stays for the
    # constants, which are the arm ordinals. Comparison is `==` (binopKeyOf
    # routes it to @scalar), so there is no comparator to emit either.
    ovc9: ordinalVariantCType :symtab :tid
    if ovc9.length > 0 then {
        lo9: "typedef \{ovc9} \{vc}_t;\n"
        buf.append lo9
        return
    }
    buf.append "typedef struct {\n"
    tsc9: tagStorageCType :symtab :tid
    if tsc9.length == 0 then {
        lfE9: "    \{vc}_tag_t tag;\n"
        buf.append lfE9
    } else {
        lfD9: "    \{tsc9} tag;\n"
        buf.append lfD9
    }
    haveP: false
    pj: u64
    for pj < an loop {
        pname: anames.get i: pj
        pc: armPayloadC :ast :symtab :ctx :tid arm: pname.stringview
        if pc.length > 0 then {
            if (haveP) == false then {
                haveP = true
                buf.append "    union {\n"
            }
            lp: "        \{pc} \{pname};\n"
            buf.append lp
        }
        pj = pj + 1
    }
    if haveP then buf.append "    } data;\n"
    lg: "} \{vc}_t;\n"
    buf.append lg
    lq: "static bool \{vc}_eq(\{vc}_t a, \{vc}_t b) {\n"
    buf.append lq
    if haveP then {
        buf.append "    if (a.tag != b.tag) return false;\n"
        buf.append "    switch (a.tag) {\n"
        qk: u64
        for qk < an loop {
            qname: anames.get i: qk
            qnameId: (zast.nameid.create from: (aidsNm.get i: qk))
            qc: armPayloadC :ast :symtab :ctx :tid arm: qname.stringview
            if qc.length > 0 then {
                qtg: variantTag :symtab :tid arm: qname.stringview
                qco: symtab.typing.declChildOfId parentTypeId: tid nameId: qnameId
                qeq: String
                match (
                    qco
                ) case some then {
                    # a typedef arm compares as its chain-end base
                    qcoC9: typedefChaseTid9 :symtab tid: (ztypes.tid.create from: qco.u64)
                    qtn: typeNameOfReg9 :symtab tid: qcoC9
                    qsc: scalarCTypeFor :symtab name: qtn.stringview tid: qcoC9
                    if qsc.length == 0 then {
                        qrid: canonTypeId :ast :symtab :ctx tid: qcoC9 name: qtn.stringview
                        if qrid > 0 then {
                            qtt: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: qrid.u64)
                            isAgg: false
                            if qtt == ztypes.ztypetype.recordType then isAgg = true
                            if qtt == ztypes.ztypetype.variantType then isAgg = true
                            if isAgg then {
                                qrc: ctxCname :ctx tid: (ztypes.tid.create from: qrid.u64)
                                qe: "\{qrc}_eq(a.data.\{qname}, b.data.\{qname})"
                                qeq.append qe
                            }
                        }
                    }
                } case none then null
                if qeq.length == 0 then {
                    qe2: "a.data.\{qname} == b.data.\{qname}"
                    qeq.append qe2
                }
                lr: "        case \{qtg}: return \{qeq};\n"
                buf.append lr
            }
            qk = qk + 1
        }
        buf.append "        default: return true;\n"
        buf.append "    }\n"
    } else {
        buf.append "    return a.tag == b.tag;\n"
    }
    buf.append "}\n\n"
}

# true when `n` is a class definition.
isClassDef9: function {n: Node.view} out bool is {
    match (
        n
    ) case objectdef then {
        if n.kind == zast.nodetype.classDef then {
            return true
        } else {
            return false
        }
    } else {
        return false
    }
}

# true when `n` is a record definition.
isRecordDef9: function {n: Node.view} out bool is {
    match (
        n
    ) case objectdef then {
        if n.kind == zast.nodetype.recordDef then {
            return true
        } else {
            return false
        }
    } else {
        return false
    }
}

# structDestroyNontrivial -- the type's destructor frees at least one field.
# Mirrors emitStructDestructor's per-field tests (String, destructible
# aggregate, heap-ptr collection; `.lock` fields never free). Gates call-site
# destroys for loop-owned iterator instances: an all-borrowed iterator has
# nothing to free and keeps its emission unchanged.
structDestroyNontrivial: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    tid: ztypes.tid
} out bool is {
    fnames: (List String)
    fids: (ListVal u64)
    fidsNm: (ListVal u64)
    recFieldLists :ast :symtab :tid names: fnames ids: fids nameIds: fidsNm
    fi: u64
    fn0: fnames.length
    for fi < fn0 loop {
        fid: fids.get i: fi
        fnameId: fidsNm.get i: fi
        if (symtab.typing.declIsLockFieldId
            parentTypeId: tid
            nameId: (zast.nameid.create from: fnameId.u32.orPanic)
        ) == false then {
            if fid == ctx.strTid then return true
            fmid9: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: fid.u64)
            if (symtab.reg.hasDestructorName typeId: fmid9) then return true
            if (isHeapPtrCollection
                :symtab
                :ctx
                tid: (ztypes.tid.create from: fid.u64)
            ) then return true
        }
        fi = fi + 1
    }
    return false
}

# emitStructDestructor -- a record/class destructor freeing each heap-owning
# field: String fields via the String free, aggregate fields with a destructor
# recursively; scalars are skipped. Emitted only when the type has a destructor.
# structDestroyNontrivial mirrors the per-field tests below -- keep them in sync.
emitStructDestructor: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    tid: ztypes.tid
    fnames: (List String).view
    fids: (ListVal u64).view
    buf: String.borrow
} is {
    rc: ctxCname :ctx :tid
    d0: "static void \{rc}_destroy(\{rc}_t* p);\n"
    buf.append d0
    d1: "static void \{rc}_destroy(\{rc}_t* p) {\n"
    buf.append d1
    buf.append "    if (!p) return;\n"
    fi: u64
    fn0: fnames.length
    for fi < fn0 loop {
        fname: fnames.get i: fi
        fid: fids.get i: fi
        # a `.lock` field is a borrowed pointer -- never freed by the destructor.
        if (symtab.typing.declIsLockField
            pool: ast.names
            parentTypeId: tid
            name: fname.stringview
        ) == false then {
            if fid == ctx.strTid then {
                ds: "    \{ctx.strC}_free(&p->\{fname});\n"
                buf.append ds
            } else {
                fmid9: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: fid.u64)
                fneeds9: false
                if (symtab.reg.hasDestructorName typeId: fmid9) then fneeds9 = true
                if (isHeapPtrCollection
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: fid.u64)
                ) then fneeds9 = true
                if fneeds9 then {
                    fcb: ctxCname :ctx tid: (ztypes.tid.create from: fmid9.u64)
                    if (isHeapPtrCollection
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: fid.u64)
                    ) then {
                        df: "    \{fcb}_destroy(p->\{fname});\n"
                        buf.append df
                    } else {
                        df2: "    \{fcb}_destroy(&p->\{fname});\n"
                        buf.append df2
                    }
                }
            }
        }
        fi = fi + 1
    }
    buf.append "}\n\n"
}

# lockFieldIsReftypePtr -- a `.lock` field is stored as a pointer to its container
# only when that container is a reftype (class/union); a protocol lock is the fat
# pointer by value, and a valtype lock (a bidirectional generator's bool resume
# input) is stored by value.
lockFieldIsReftypePtr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    fid: ztypes.tid
} out bool is {
    ftn: typeNameOfReg9 :symtab tid: fid
    ftid: canonTypeId :ast :symtab :ctx tid: fid name: ftn.stringview
    if ftid == 0 then ftid = fid
    tt: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: ftid.u64)
    if tt == ztypes.ztypetype.classType then return true
    if tt == ztypes.ztypetype.unionType then return true
    return false
}

# emit one record's C struct.
emitOneRecord: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    tid: ztypes.tid
    buf: String.borrow
} is {
    egr9: ctx.emittedUserTypes.get key: tid
    match (
        egr9
    ) case some then {
        return
    } case none then null
    ctx.emittedUserTypes.set key: tid.u64 value: true
    if (isTypedefType :symtab :tid) then return
    fnames: (List String)
    fids: (ListVal u64)
    fidsNm: (ListVal u64)
    recFieldLists :ast :symtab :tid names: fnames ids: fids nameIds: fidsNm
    # A FIELDLESS record/class is a synthesized carrier -- the registry's
    # `literal_int` pseudo-type, a data block's `tag__{elem}` -- and an empty
    # struct is not C. Same rule as the armless variant above, for the same
    # reason: nothing can hold one, so emit nothing rather than invalid C.
    if fnames.length == 0 then return
    preEmitEmbeddedTypes :ast :symtab :ctx ids: fids :buf
    rc: ctxCname :ctx :tid
    if (isFwdDeclared :ctx :tid) then {
        lopenR: "struct \{rc}_t {\n"
        buf.append lopenR
    } else {
        buf.append "typedef struct {\n"
    }
    fi: u64
    fn0: fnames.length
    for fi < fn0 loop {
        fname: fnames.get i: fi
        fid: fids.get i: fi
        fnameId: fidsNm.get i: fi
        fct: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: fid.u64) thisTid: ztypes.tid
        if fct.length == 0 then fct = "int64_t".string
        # a `.lock` field borrows the container: protocol-typed -> fat pointer by
        # value; class-typed -> a pointer to the container.
        if (symtab.typing.declIsLockFieldId
            parentTypeId: tid
            nameId: (zast.nameid.create from: fnameId.u32.orPanic)
        ) then {
            if (lockFieldIsReftypePtr
                :ast
                :symtab
                :ctx
                fid: (ztypes.tid.create from: fid.u64)
            ) then fct = "\{fct}*"
        }
        if (isHeapPtrCollection
            :symtab
            :ctx
            tid: (ztypes.tid.create from: fid.u64)
        ) then fct = "\{fct}*"
        l1: "    \{fct} \{fname};\n"
        buf.append l1
        fi = fi + 1
    }
    if (isFwdDeclared :ctx :tid) then {
        buf.append "};\n"
    } else {
        l2: "} \{rc}_t;\n"
        buf.append l2
    }
    params: String
    inits: String
    fj: u64
    for fj < fn0 loop {
        fname2: fnames.get i: fj
        fid2: fids.get i: fj
        fname2Id: fidsNm.get i: fj
        fct2: typeRefC :ast :symtab :ctx tid: (ztypes.tid.create from: fid2.u64) thisTid: ztypes.tid
        if fct2.length == 0 then fct2 = "int64_t".string
        # a `.lock` field's meta_create param matches the field (protocol by value).
        if (symtab.typing.declIsLockFieldId
            parentTypeId: tid
            nameId: (zast.nameid.create from: fname2Id.u32.orPanic)
        ) then {
            if (lockFieldIsReftypePtr
                :ast
                :symtab
                :ctx
                fid: (ztypes.tid.create from: fid2.u64)
            ) then fct2 = "\{fct2}*"
        }
        if (isHeapPtrCollection
            :symtab
            :ctx
            tid: (ztypes.tid.create from: fid2.u64)
        ) then fct2 = "\{fct2}*"
        if fj > 0 then {
            params.append ", "
            inits.append ", "
        }
        params.append fct2
        params.append " "
        params.append fname2
        inits.append fname2
        fj = fj + 1
    }
    l3: "static \{rc}_t \{rc}_meta_create(\{params}) {\n"
    buf.append l3
    l4: "    \{rc}_t _this = { \{inits} };\n"
    buf.append l4
    buf.append "    return _this;\n"
    buf.append "}\n"
    aliasOk9: (definedInNonMain :symtab :ctx :tid) == false
    if aliasOk9 when (typeHasNativeCreate :symtab :tid) == false then {
        l5: "#define \{rc}_create \{rc}_meta_create\n"
        buf.append l5
    }
    skipEqR: false
    if (symtab.reg.typetypeOf typeId: tid) == ztypes.ztypetype.classType then skipEqR = true
    if (skipEqR) == false then {
    lq: "static bool \{rc}_eq(\{rc}_t a, \{rc}_t b) {\n"
    buf.append lq
    if fn0 == 0 then {
        buf.append "    (void)a; (void)b;\n"
        buf.append "    return true;\n"
    } else {
        eqx: String
        fk: u64
        for fk < fn0 loop {
            fkn: fnames.get i: fk
            fki: fids.get i: fk
            if fk > 0 then eqx.append " && "
            fkiC9: typedefChaseTid9 :symtab tid: (ztypes.tid.create from: fki.u64)
            ftn: typeNameOfReg9 :symtab tid: fkiC9
            fscalar: scalarCTypeFor :symtab name: ftn.stringview tid: fkiC9
            fdone: false
            if fscalar.length == 0 then {
                frid: canonTypeId :ast :symtab :ctx tid: fkiC9 name: ftn.stringview
                if frid > 0 then {
                    ftt: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: frid.u64)
                    isAggF: false
                    if ftt == ztypes.ztypetype.recordType then isAggF = true
                    if ftt == ztypes.ztypetype.variantType then isAggF = true
                    if isAggF then {
                        frc: ctxCname :ctx tid: (ztypes.tid.create from: frid.u64)
                        fe: "\{frc}_eq(a.\{fkn}, b.\{fkn})"
                        eqx.append fe
                        fdone = true
                    }
                }
            }
            if (fdone) == false then {
                fe2: "a.\{fkn} == b.\{fkn}"
                eqx.append fe2
            }
            fk = fk + 1
        }
        lr: "    return \{eqx};\n"
        buf.append lr
    }
    buf.append "}\n\n"
    }
    if (symtab.reg.hasDestructorName typeId: tid) then {
        emitStructDestructor :ast :symtab :ctx :tid :fnames :fids :buf
    }
}


# emitRecordMethods -- the record's as-block functions as free C
# functions taking the record by value (params from the method type's
# children; the AST return fallback covers unstamped returns).
# emitAsConsts -- a record/class `as`-block plain constant (`as { version: 1 }`)
# becomes a `static const` read as `Type.label` (see the Type.constlabel leg in
# emitExpr). Const items are the markAsConstClone children; methods/markers skip.
emitAsConsts: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    tid: ztypes.tid
    name: StringView
    op: Node.view
    buf: String.borrow
} is {
    match (
        op
    ) case objectdef then {
        with aiter: op.asItems.iterate do for amId9: aiter loop {
            am: ast.nodes.get i: amId9.u64
            match (
                am
            ) case namedoperation then {
                albl: zast.nameTextAt :ast ref: am.name
                cco: (symtab.typing.declChildOf
                    pool: ast.names
                    parentTypeId: tid
                    name: albl.stringview
                )
                match (
                    cco
                ) case some then {
                    if (symtab.typing.isAsConstClone typeId: (ztypes.tid.create from: cco.u64)) then {
                        cv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: am.operation.u64)
                        if cv.length > 0 then {
                            ctA: "int64_t".string
                            vtidA: (stampIdOf
                                :symtab
                                nid: (nodeIdOf9 n: (ast.nodes.get i: am.operation.u64))
                            )
                            if vtidA > 0 then {
                                vtnA: typeNameOfReg9 :symtab tid: vtidA
                                vtcA: (scalarCTypeFor
                                    :symtab
                                    name: vtnA.stringview
                                    tid: vtidA
                                )
                                if vtcA.length > 0 then ctA = vtcA
                            }
                            qnA: "\{name}.\{albl}"
                            csymA: cnameOf :tid ownerName: "" name: qnA.stringview
                            lA: "static const \{ctA} \{csymA} = \{cv};\n"
                            buf.append lA
                        }
                    }
                } case none then null
            } else null
        }
    } else null
}

# emitClassMonoMethods -- emit every specialization's bodied methods for a
# generic class template: the clone's FUNCTION id supplies the substituted
# signature and the template item supplies the body (the unit-mono pattern).
emitClassMonoMethods: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    tplId: ztypes.tid
    op: Node.view
    declOnly: bool
    buf: String.borrow
} is {
    match (
        op
    ) case objectdef then {
        last8: symtab.reg.nextTypeId
        t8: u64
        for t8 < last8 loop {
            isMono8: false
            go8opt: symtab.reg.genericOriginOf tid: (ztypes.tid.create from: t8.u64)
            if go8opt.u64 == tplId when go8opt > 0 then isMono8 = true
            if isMono8 then {
                ait8: op.isItems.iterate
                for am8Id9: ait8 loop {
                    am8: ast.nodes.get i: am8Id9.u64
                    match (
                        am8
                    ) case namedoperation then {
                        if (isFunctionDefWithBody9 n: (ast.nodes.get i: am8.operation.u64)) then {
                            mn8: zast.nameTextAt :ast ref: am8.name
                            co8: (symtab.typing.declChildOf
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: t8.u64)
                                name: mn8.stringview
                            )
                            match (
                                co8
                            ) case some then {
                                cf8: co8
                                if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: cf8.u64)) == ztypes.ztypetype.functionType then {
                                    fn8: (typeNameOfReg9
                                        :symtab
                                        tid: (ztypes.tid.create from: cf8.u64)
                                    )
                                    sg8: (fnSignature
                                        :ast
                                        :symtab
                                        :ctx
                                        name: fn8.stringview
                                        fid: (ztypes.tid.create from: cf8.u64)
                                        op: (ast.nodes.get i: am8.operation.u64)
                                    )
                                    if declOnly then {
                                        ld8: "\{sg8};\n"
                                        buf.append ld8
                                    } else {
                                        lo8: "\{sg8} {\n"
                                        buf.append lo8
                                                                                ctx.ptrVids = (ListVal ztypes.vid)
                                        ctx.aliases = (List VidVal)
                                        ctx.narrowBox = (List VidVal)
                                        ctx.narrowTid = (List VidTid)
                                        ctx.exclArms = (List VidVal)
                                        ctx.exclTids = (List VidTid)
                                        (registerReftypeParams
                                            :ast
                                            :symtab
                                            :ctx
                                            fid: (ztypes.tid.create from: cf8.u64)
                                            op: (ast.nodes.get i: am8.operation.u64)
                                        )
                                        ctx.curThisTid = ztypes.tid.create from: (t8)
                                        (emitFnBody
                                            :ast
                                            :symtab
                                            :ctx
                                            op: (ast.nodes.get i: am8.operation.u64)
                                            fid: (ztypes.tid.create from: cf8.u64)
                                            :buf
                                        )
                                        ctx.curThisTid = ztypes.tid.create from: (0)
                                        buf.append "}\n\n"
                                    }
                                }
                            } case none then null
                        }
                    } else null
                }
                ait8b: op.asItems.iterate
                for am8bId9: ait8b loop {
                    am8b: ast.nodes.get i: am8bId9.u64
                    match (
                        am8b
                    ) case namedoperation then {
                        if (isFunctionDefWithBody9 n: (ast.nodes.get i: am8b.operation.u64)) then {
                            mn8b: zast.nameTextAt :ast ref: am8b.name
                            co8b: (symtab.typing.declChildOf
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: t8.u64)
                                name: mn8b.stringview
                            )
                            match (
                                co8b
                            ) case some then {
                                cf8b: co8b
                                if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: cf8b.u64)) == ztypes.ztypetype.functionType then {
                                    fn8b: (typeNameOfReg9
                                        :symtab
                                        tid: (ztypes.tid.create from: cf8b.u64)
                                    )
                                    sg8b: (fnSignature
                                        :ast
                                        :symtab
                                        :ctx
                                        name: fn8b.stringview
                                        fid: (ztypes.tid.create from: cf8b.u64)
                                        op: (ast.nodes.get i: am8b.operation.u64)
                                    )
                                    if declOnly then {
                                        ld8b: "\{sg8b};\n"
                                        buf.append ld8b
                                    } else {
                                        lo8b: "\{sg8b} {\n"
                                        buf.append lo8b
                                                                                ctx.ptrVids = (ListVal ztypes.vid)
                                        ctx.aliases = (List VidVal)
                                        ctx.narrowBox = (List VidVal)
                                        ctx.narrowTid = (List VidTid)
                                        ctx.exclArms = (List VidVal)
                                        ctx.exclTids = (List VidTid)
                                        (registerReftypeParams
                                            :ast
                                            :symtab
                                            :ctx
                                            fid: (ztypes.tid.create from: cf8b.u64)
                                            op: (ast.nodes.get i: am8b.operation.u64)
                                        )
                                        ctx.curThisTid = ztypes.tid.create from: (t8)
                                        (emitFnBody
                                            :ast
                                            :symtab
                                            :ctx
                                            op: (ast.nodes.get i: am8b.operation.u64)
                                            fid: (ztypes.tid.create from: cf8b.u64)
                                            :buf
                                        )
                                        ctx.curThisTid = ztypes.tid.create from: (0)
                                        buf.append "}\n\n"
                                    }
                                }
                            } case none then null
                        }
                    } else null
                }
            }
            t8 = t8 + 1
        }
    } else null
}

# emit a record's methods.
emitRecordMethods: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    tid: ztypes.tid
    op: Node.view
    declOnly: bool
    buf: String.borrow
} is {
    if (isGenericType :symtab :tid) then {
        (emitClassMonoMethods
            :ast
            :symtab
            :ctx
            tplId: (ztypes.tid.create from: tid.u64)
            :op
            :declOnly
            :buf
        )
        return
    }
    match (
        op
    ) case objectdef then {
        idxs: (ListVal u64)
        names: (List String)
        ai: u64
        with aiter: op.asItems.iterate do for amId9: aiter loop {
            am: ast.nodes.get i: amId9.u64
            match (
                am
            ) case namedoperation then {
                if (isFunctionDefWithBody9 n: (ast.nodes.get i: am.operation.u64)) then {
                    av: ai
                    idxs.append av
                    an: zast.nameTextCopy :ast ref: am.name
                    names.append an
                }
            } else null
            ai = ai + 1
        }
        wi: u64
        wn: idxs.length
        for wi < wn loop {
            midx: idxs.get i: wi
            mname: names.get i: wi
            am2Id9: op.asItems.get i: midx
            am2: ast.nodes.get i: am2Id9.u64
            match (
                am2
            ) case namedoperation then {
                mo: (symtab.typing.declChildOf
                    pool: ast.names
                    parentTypeId: tid
                    name: mname.stringview
                )
                match (
                    mo
                ) case some then {
                    (emitOneMethod
                        :ast
                        :symtab
                        :ctx
                        mid: (ztypes.tid.create from: mo.u64)
                        thisTid9: tid
                        op: (ast.nodes.get i: am2.operation.u64)
                        :declOnly
                        :buf
                    )
                } case none then null
            } else null
            wi = wi + 1
        }
        iidxs9: (ListVal u64)
        inames9: (List String)
        iai9: u64
        with iiter9: op.isItems.iterate do for im9Id9: iiter9 loop {
            im9: ast.nodes.get i: im9Id9.u64
            match (
                im9
            ) case namedoperation then {
                if (isFunctionDefWithBody9 n: (ast.nodes.get i: im9.operation.u64)) then {
                    iav9: iai9
                    iidxs9.append iav9
                    ian9: zast.nameTextCopy :ast ref: im9.name
                    inames9.append ian9
                }
            } else null
            iai9 = iai9 + 1
        }
        iwi9: u64
        iwn9: iidxs9.length
        for iwi9 < iwn9 loop {
            imidx9: iidxs9.get i: iwi9
            imname9: inames9.get i: iwi9
            im2Id9: op.isItems.get i: imidx9
            im2: ast.nodes.get i: im2Id9.u64
            match (
                im2
            ) case namedoperation then {
                imo9: (symtab.typing.declChildOf
                    pool: ast.names
                    parentTypeId: tid
                    name: imname9.stringview
                )
                match (
                    imo9
                ) case some then {
                    (emitOneMethod
                        :ast
                        :symtab
                        :ctx
                        mid: (ztypes.tid.create from: imo9.u64)
                        thisTid9: tid
                        op: (ast.nodes.get i: im2.operation.u64)
                        :declOnly
                        :buf
                    )
                } case none then null
            } else null
            iwi9 = iwi9 + 1
        }
    } else null
}

# nodeYieldCount -- the number of `yield` expressions in a subtree (yields do
# not nest). Mirrors the typechecker's subtreeHasYield walk. Used to detect a
# generator `call` body and size its resume-state switch.
nodeYieldCount: function {ast: Ast.view n: Node.view} out u64 is {
    match (
        n
    ) case yieldexpr then {
        return 1
    } case statement then {
        c: u64
        siter: n.statements.iterate
        for stId9: siter loop {
            st: ast.nodes.get i: stId9.u64
            c = c + (nodeYieldCount :ast n: st)
        }
        return c
    } case statementline then {
        sln9: ast.nodes.get i: n.statementline.u64
        return (nodeYieldCount :ast n: sln9)
    } case expression then {
        return (nodeYieldCount :ast n: (ast.nodes.get i: n.expression.u64))
    } case assignment then {
        return (nodeYieldCount :ast n: (ast.nodes.get i: n.value.u64))
    } case forexpr then {
        if n.body.isZero then return 0
        return (nodeYieldCount :ast n: (ast.nodes.get i: n.body.u64))
    } case ifexpr then {
        c2: u64
        cliter: n.clauses.iterate
        for clId9: cliter loop {
            cl9r: ast.nodes.get i: clId9.u64
            c2 = c2 + (nodeYieldCount :ast n: cl9r)
        }
        if n.elseclause > 0 then {
            ec9: ast.nodes.get i: n.elseclause.u64
            c2 = c2 + (nodeYieldCount :ast n: ec9)
        }
        return c2
    } case ifclause then {
        return (nodeYieldCount :ast n: (ast.nodes.get i: n.statement.u64))
    } else {
        return 0
    }
}

# fnYieldCount -- yields in a functiondef body (0 for a non-generator).
fnYieldCount: function {ast: Ast.view op: Node.view} out u64 is {
    match (
        op
    ) case functiondef then {
        if op.body.isZero then return 0
        return (nodeYieldCount :ast n: (ast.nodes.get i: op.body.u64))
    } else {
        return 0
    }
}

# setupGenCtx -- arm the generator state-machine context on ctx when `op` is a
# generator `call` (its body yields). Resolves the optionval wrapper from the
# method's return type. Returns false (and disarms) for a normal method.
setupGenCtx: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    mid: ztypes.tid
    op: Node.view
} out bool is {
    gyc: fnYieldCount :ast :op
    if gyc == 0 then {
        ctx.genActive = false
        return false
    }
    rid: fnReturnTidOf :symtab tid: mid
    if rid == 0 then {
        mro: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: mid.u64)
        match (
            mro
        ) case some then {
            rid = mro
        } case none then null
    }
    if rid == 0 then {
        ctx.genActive = false
        return false
    }
    rn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: rid.u64)
    ru: cUpperOf text: rn.stringview
    rc: ctxCname :ctx tid: (ztypes.tid.create from: rid.u64)
    ctx.genActive = true
    ctx.genYieldCount = gyc
    ctx.genYieldNext = 1
    ctx.genWrap = "\{rc}_t"
    ctx.genSomeTag = "Z_\{ru}_TAG_SOME"
    ctx.genNoneTag = "Z_\{ru}_TAG_NONE"
    # a reftype element wraps in Option: the yield leg boxes the payload
    # (emitOptionalAssign's malloc'd-box shape); valtype wrappers stay inline.
    gp9: String
    if (originIsTid
        :symtab
        tid: (ztypes.tid.create from: rid.u64)
        originTid: ctx.optionOriginTid
    ) then {
        gp9 = armPayloadC :ast :symtab :ctx tid: (ztypes.tid.create from: rid.u64) arm: "some"
    }
    ctx.genPayC = gp9
    hasVal9: false
    match (
        op
    ) case functiondef then {
        with piter9: op.parameters.iterate do for pm9Id9: piter9 loop {
            pm9: ast.nodes.get i: pm9Id9.u64
            match (
                pm9
            ) case namedoperation then {
                pl9: zast.nameTextAt :ast ref: pm9.name
                if pl9.stringview == "value" then hasVal9 = true
            } else null
        }
    } else null
    ctx.genHasValue = hasVal9
    return true
}

# emitGenPrologue -- the resume dispatch: switch on this->state to L_entry / the
# per-yield resume labels / L_done.
emitGenPrologue: function {ctx: Ctx.view buf: String.borrow} is {
    if ctx.genHasValue then {
        lgv9: "    \{ctx.genRecvC}->_resume_input = \{ctx.genValC};\n"
        buf.append lgv9
    }
    lgs9: "    switch (\{ctx.genRecvC}->state) {\n"
    buf.append lgs9
    buf.append "        case 0: goto L_entry;\n"
    k: 1.u64
    for k <= ctx.genYieldCount loop {
        lk: "        case \{k}: goto L_resume_\{k};\n"
        buf.append lk
        k = k + 1
    }
    buf.append "        default: goto L_done;\n"
    buf.append "    }\n"
    buf.append "L_entry:;\n"
}

# emitGenEpilogue -- the terminal landing: mark done and return the NONE wrapper.
emitGenEpilogue: function {ctx: Ctx.view buf: String.borrow} is {
    buf.append "L_done:;\n"
    lge9: "    \{ctx.genRecvC}->state = -1;\n"
    buf.append lge9
    le: "    \{ctx.genWrap} _r_done = {0};\n"
    buf.append le
    lt: "    _r_done.tag = \{ctx.genNoneTag};\n"
    buf.append lt
    buf.append "    return _r_done;\n"
}

# isYieldNode -- the node (through expression wrappers) is a yield expression.
isYieldNode: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (isYieldNode :ast n: (ast.nodes.get i: n.expression.u64))
    } case yieldexpr then {
        return true
    } else {
        return false
    }
}

# emitYieldFromNode -- emit the suspension for a yield reached through expression
# wrappers (the expression-form `name: yield E`).
emitYieldFromNode: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    match (
        n
    ) case expression then {
        iexF9: ast.nodes.get i: n.expression.u64
        emitYieldFromNode :ast :symtab :ctx n: iexF9 :ind :tmp :buf
    } case yieldexpr then {
        emitYieldStmt :ast :symtab :ctx yd: n :ind :buf
    } else null
}

# emitExprFormYield -- `name: yield E` in a bidirectional generator: suspend
# (yield E), then bind name to the resume input the next `.call value:` provides.
# A valtype binds the value directly; a borrowed reftype binds a pointer alias.
emitExprFormYield: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    value: Node.view
    aid: u64
    nm: StringView
    nmVid: ztypes.vid
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    emitYieldFromNode :ast :symtab :ctx n: value :ind :tmp :buf
    ltid9: stampIdOf :symtab nid: aid
    ct9: typeRefC :ast :symtab :ctx tid: ltid9 thisTid: ztypes.tid
    if ct9.length == 0 then ct9 = "int64_t".string
    tt9: symtab.reg.typetypeOf typeId: ltid9
    isRef9: false
    if tt9 == ztypes.ztypetype.classType then isRef9 = true
    if tt9 == ztypes.ztypetype.unionType then isRef9 = true
    if isRef9 then {
        lp0: "\{ind}\{ct9}* __borrow_\{nm} = \{ctx.genRecvC}->_resume_input;\n"
        buf.append lp0
        lp1: "\{ind}/* alias: \{nm} => (*__borrow_\{nm}) */\n"
        buf.append lp1
        av9: "(*__borrow_\{nm})"
        vvSet xs: ctx.aliases vid: nmVid val: av9.stringview
    } else {
        lp2: "\{ind}\{ct9} \{nm} = \{ctx.genRecvC}->_resume_input;\n"
        buf.append lp2
    }
}

# emitYieldStmt -- one `yield E` suspension: set the resume state, return the
# SOME-wrapped value, then drop a resume label at column 0 (goto-reachable into
# the enclosing block).
emitYieldStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    yd: zast.YieldExprData.view
    ind: StringView
    buf: String.borrow
} is {
    k: ctx.genYieldNext
    ctx.genYieldNext = k + 1
    # an interpolated yield value builds via a self-contained statement
    # expression (emitExpr :ast cannot emit the chain)
    yx9: ast.nodes.get i: yd.expr.u64
    ve: emitInterpArgExpr :ast :symtab :ctx n: yx9
    if ve.length == 0 then ve = emitExpr :ast :symtab :ctx n: yx9
    ls: "\{ind}\{ctx.genRecvC}->state = \{k};\n"
    buf.append ls
    lw: "\{ind}\{ctx.genWrap} _ry_\{k} = {0};\n"
    buf.append lw
    tgt9: "_ry_\{k}"
    (emitOptionalAssign
        target: tgt9.stringview
        someTag: ctx.genSomeTag.stringview
        payC: ctx.genPayC.stringview
        vx: ve.stringview
        :ind
        :buf
    )
    # a boxed yield MOVES an lvalue operand (a promoted local `this->x`):
    # zero the source so the instance destructor does not double-free it
    if ctx.genPayC.length > 0 then {
        if (isNonLvalueArg s: ve.stringview) == false then {
            lzv9: "\{ind}\{ve} = (\{ctx.genPayC}){0};\n"
            buf.append lzv9
        }
    }
    lr: "\{ind}return _ry_\{k};\n"
    buf.append lr
    ll: "L_resume_\{k}:;\n"
    buf.append ll
}

# emit one method.
emitOneMethod: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    mid: ztypes.tid
    thisTid9: ztypes.tid
    op: Node.view
    declOnly: bool
    buf: String.borrow
} is {
    mc: ctxCname :ctx tid: mid
    ret: "void".string
    {
        rto: fnReturnTidOf :symtab tid: mid
        if rto > 0 then {
            rr: (typeRefC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: rto.u64)
                thisTid: (ztypes.tid.create from: thisTid9.u64)
            )
            if rr.length > 0 then ret = rr
        }
    }
    if ret.stringview == "void" then {
        # generic-mono returns (optionval/Option/resultval) carry no registry
        # returnTypeId; the return-type node stamp resolves the mono id.
        mro: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: mid.u64)
        match (
            mro
        ) case some then {
            mrr: typeRefC :ast :symtab :ctx tid: mro thisTid: (ztypes.tid.create from: thisTid9.u64)
            if mrr.length > 0 then ret = mrr
        } case none then null
    }
    if ret.stringview == "void" when thisTid9 > 0 then {
        rbn0: ztypecheck.fnReturnBaseNameOf :ast :op
        if rbn0.stringview == "this" then {
            tcb: ctxCname :ctx tid: thisTid9
            ret = "\{tcb}_t"
        }
    }
    if ret.stringview == "void" then {
        rbn: ztypecheck.fnReturnBaseNameOf :ast :op
        if rbn.length > 0 then {
            rbi: userFnId :ast :symtab :ctx name: rbn.stringview
            if rbi > 0 then {
                rr2: (typeRefC
                    :ast
                    :symtab
                    :ctx
                    tid: rbi
                    thisTid: (ztypes.tid.create from: thisTid9.u64)
                )
                if rr2.length > 0 then ret = rr2
            } else {
                rr3: cTypeOf name: rbn.stringview
                if rr3.length > 0 then ret = rr3
            }
        }
    }
    # a Set/Map return is a heap pointer (like a Set/Map param), so the
    # value-typed ret gets a `*`. Mirrors isSetMapPtrParam at the param sites.
    if ret.stringview != "void" then {
        retColId9: ztypes.tid
        {
            rtoR9: symtab.reg.returnTypeOf tid: mid
            if rtoR9 > 0 then retColId9 = rtoR9
        }
        if retColId9.isZero then {
            mroR9: ztypecheck.methodReturnOf st: symtab mid: (ztypes.tid.create from: mid.u64)
            match (
                mroR9
            ) case some then {
                retColId9 = mroR9
            } case none then null
        }
        if retColId9 > 0 when (isHeapPtrCollection
            :symtab
            :ctx
            tid: retColId9
        ) then ret = "\{ret}*"
        if (fnReturnsRefBorrow9
            :ast
            :symtab
            :ctx
            fid: mid
            retTid: (ztypes.tid.create from: retColId9.u64)
        ) then ret = "\{ret}*"
    }
    params: String
    pnames: (List String)
    pids: (ListVal u64)
    pidsNm: (ListVal u64)
    recFieldLists :ast :symtab tid: mid names: pnames ids: pids nameIds: pidsNm
    # a CLASS method takes its `this` receiver by pointer (reference semantics):
    # the receiver param gets a `*` and its name is recorded so the body emits
    # `c->field`. Reset for this method (names must not leak into other bodies).
        ctx.ptrVids = (ListVal ztypes.vid)
    ctx.aliases = (List VidVal)
    ctx.narrowBox = (List VidVal)
    ctx.narrowTid = (List VidTid)
    ctx.exclArms = (List VidVal)
    ctx.exclTids = (List VidTid)
    encIsClass: false
    if (symtab.reg.typetypeOf typeId: thisTid9) == ztypes.ztypetype.classType then encIsClass = true
    pi: u64
    pn: pnames.length
    for pi < pn loop {
        pname: pnames.get i: pi
        pid: pids.get i: pi
        pt: (typeRefC
            :ast
            :symtab
            :ctx
            tid: (ztypes.tid.create from: pid.u64)
            thisTid: (ztypes.tid.create from: thisTid9.u64)
        )
        if pt.length == 0 then pt = "int64_t".string
        # The receiver is identified by its PARAMETER name -- `this` for the
        # `:this` shorthand, or the spelled name for `{a: this}` -- exactly as
        # the call site names it. Keying on the parameter's TYPE instead would
        # also catch a same-typed sibling (`add: function {a: this b: point}`
        # takes two points), which classes hid by making both pointers anyway.
        recvNm9: "this".string
        {
            tpnR9: (zast.poolTextCopy
                pool: ast.names
                ref: (symtab.reg.thisParamNameIdOf tid: mid)
            )
            if tpnR9.length > 0 then recvNm9 = tpnR9
        }
        isRecv9: false
        if pname.stringview == recvNm9.stringview then isRecv9 = true
        # The receiver is a reference in BOTH families: a record method acts on
        # the caller's instance, not on a copy of it. The rest of the pointer
        # rule still applies to class methods only.
        if isRecv9 then {
            pt = "\{pt}*"
            pvd9: (paramVidByNameId
                :ast
                :symtab
                :op
                nameId: (zast.nameid.create from: (pidsNm.get i: pi))
            )
            ctx.ptrVids.append pvd9
        } else {
            if encIsClass then {
                # a non-TAKE class param borrows the container (LOCK/BORROW, or the
                # borrow-default whose ownership a cross-unit shell records as "none")
                # -> pass by pointer. A `.take` (owning) class param stays by value:
                # a create/meta_create moves it into the struct.
                giveptr9: false
                if (symtab.typing.declOwnershipIs
                    pool: ast.names
                    parentTypeId: mid
                    name: pname.stringview
                    own: ztypes.zparamownership.takeMode
                ) == false then {
                    if (isReftypeParam
                        :ast
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: pid.u64)
                    ) then giveptr9 = true
                }
                ibs9: (isBorrowStringParam
                    :ast
                    :symtab
                    fid: mid
                    pname: pname.stringview
                    pid: (ztypes.tid.create from: pid.u64)
                )
                if ibs9 then giveptr9 = true
                if (markedValtypeRefParam
                    :ast
                    :symtab
                    fid: mid
                    pname: pname.stringview
                    :pid
                ) then giveptr9 = true
                if (isListPtrParam
                    :ast
                    :symtab
                    :ctx
                    fid: mid
                    pname: pname.stringview
                    tid: (ztypes.tid.create from: pid.u64)
                ) then giveptr9 = true
                if (isSetMapPtrParam
                    :ast
                    :symtab
                    :ctx
                    fid: mid
                    pname: pname.stringview
                    tid: (ztypes.tid.create from: pid.u64)
                ) then giveptr9 = true
                if giveptr9 then {
                    pt = "\{pt}*"
                    pvd9b: (paramVidByNameId
                        :ast
                        :symtab
                        :op
                        nameId: (zast.nameid.create from: (pidsNm.get i: pi))
                    )
                    ctx.ptrVids.append pvd9b
                }
            }
        }
        if pi > 0 then params.append ", "
        params.append pt
        params.append " "
        pmnV9b: (paramVidByNameId
            :ast
            :symtab
            :op
            nameId: (zast.nameid.create from: (pidsNm.get i: pi))
        )
        pmnDecl9: varCName :ctx vid: pmnV9b name: pname.stringview
        if pi == 0 then ctx.genRecvC = pmnDecl9.copy
        if pi == 1 then ctx.genValC = pmnDecl9.copy
        params.append pmnDecl9
        pi = pi + 1
    }
    if pn == 0 then params.append "void"
    if declOnly then {
        ld: "static \{ret} \{mc}(\{params});\n"
        buf.append ld
    } else {
        lo: "static \{ret} \{mc}(\{params}) {\n"
        buf.append lo
        isGen9: setupGenCtx :ast :symtab :ctx :mid :op
        if isGen9 then emitGenPrologue :ctx :buf
        ctx.curThisTid = ztypes.tid.create from: (thisTid9)
        emitFnBody :ast :symtab :ctx :op fid: mid :buf
        ctx.curThisTid = ztypes.tid.create from: (0)
        if isGen9 then {
            emitGenEpilogue :ctx :buf
            ctx.genActive = false
        }
        buf.append "}\n\n"
    }
        ctx.ptrVids = (ListVal ztypes.vid)
    ctx.aliases = (List VidVal)
    ctx.narrowBox = (List VidVal)
    ctx.narrowTid = (List VidTid)
    ctx.exclArms = (List VidVal)
    ctx.exclTids = (List VidTid)
}

# the C name of the program's `main`.
mainNameOf9: function {program: Node.view} out String is {
    match (
        program
    ) case program then {
        mv: program.mainUnitName.stringview
        mc: mv.string
        return mc
    } else {
        return "".string
    }
}
