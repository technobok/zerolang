                    # a String-typedef class (Path) shares the String
                    # struct: the empty value is the zero struct
                    if ztb9.stringview == "String" then return (emitExprStrZero :ctx)
                } case none then null
                zmono9: chaseColMono :symtab :ctx tid: (ztypes.tid.create from: brid.u64)
                if zmono9 != brid then {
                    zmc9: ctxCname :ctx tid: (ztypes.tid.create from: zmono9.u64)
                    ilo9: (isListOriginOf
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: zmono9.u64)
                    )
                    if ilo9 then return "\{zmc9}_create((uint64_t)0)"
                    return "\{zmc9}_create()"
                }
                return (emitCtorDefaultsFill
                    :ast
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: brid.u64)
                )
            } case none then null
        }
        if brid > 0 when (symtab.reg.typetypeOf typeId: brid) == ztypes.ztypetype.functionType then {
            # a bare no-arg unit fn that typecheck coerced to a CALL (its atom
            # stamp is the RETURN type, not FUNCTION) is invoked here; a genuine
            # fn reference (stamped FUNCTION) keeps the bare cname.
            fbcn9: ctxCname :ctx tid: (ztypes.tid.create from: brid.u64)
            fastid9: stampIdOf :symtab nid: n.nodeid.u64
            if fastid9 > 0 when (symtab.reg.typetypeOf typeId: fastid9) == ztypes.ztypetype.functionType then {
                # a node still stamped FUNCTION is a genuine reference (a
