                    text: pbv9.stringview
                )
                sv9: svValueForm :ctx expr: pbv9.stringview isStr: true vid: pbq9
                return sv9
            }
            sid69: stampIdOf :symtab nid: ppid9
            if sid69 == ctx.svTid then {
                return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
            }
        }
        # a nested base (e.g. it.target.a): emit the base expression, then chain
        # `.`/`->` by whether the base resolves to a pointer (ptrVar / lock field).
        base9: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
        {
            bh9: (ownedRecvHoist9
                :ast
                :symtab
                :ctx
                expr: base9.stringview
                n: (ast.nodes.get i: n.parent.u64)
            )
            if bh9.length > 0 then base9 = bh9
        }
        bs9vid: (atomVidIfPlain
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.parent.u64)
            text: base9.stringview
        )
        if (base9.stringview.startsWith prefix: "/*") then {
            emitFail :ctx what: "unhandled dotted".string line: n.lineno
            return "/* zemitterc: unhandled dotted */0".string
        }
        nptn9: stampNameDeep :ast :symtab n: (ast.nodes.get i: n.parent.u64)
        if nptn9.stringview == "String" then {
            nptr9: pathIsPointer :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
            nsm9: (emitStringMethod
                :ctx
                recv: base9.stringview
                recvIsPtr: nptr9
                mn: mn2.stringview
                recvVid: bs9vid
            )
            if nsm9.length > 0 then return nsm9
        }
        if (isStringy name: nptn9.stringview) when (isSvParseNative name: mn2.stringview) then {
            needsAddM :ctx uname: "system" memb: mn2.stringview
            npIsStr9: nptn9.stringview == "String"
            pnv9: svValueForm :ctx expr: base9.stringview isStr: npIsStr9 vid: bs9vid
            epnv9: "\{ctx.svC}_\{mn2}(&\{pnv9})"
            return epnv9
        }
        # a no-arg List method on a nested receiver (this.field.pop): the bsmn
        # leg above missed it (bstamp keys off an atom base, 0 for a nested
        # path). Resolve the List mono from the base node and emit the call.
        nlid9: stampIdOf :symtab nid: (nodeIdOf9 n: (ast.nodes.get i: n.parent.u64))
        nlid9 = ztypes.tid.create from: (chaseColMono :symtab :ctx tid: nlid9)
        if (originIsTid :symtab tid: nlid9 originTid: ctx.strOriginTid) then {
            nstrcb9: ctxCname :ctx tid: nlid9
            if mn2.stringview == "length" then return "\{base9}.len"
            if mn2.stringview == "size" then return "\{nstrcb9}_size"
            if mn2.stringview == "string" then return "\{nstrcb9}_string(\{base9})"
            if mn2.stringview == "stringview" then {
                return "(\{ctx.svC}_t){ .data = \{base9}.data, .size = \{base9}.len }"
            }
        }
        if (isListOriginOf :symtab :ctx tid: nlid9) then {
            nlcb9: ctxCname :ctx tid: nlid9
            recvB9: colRecvRef :ctx bn: base9.stringview vid: bs9vid
            if mn2.stringview == "pop" then return "\{nlcb9}_pop(\{recvB9})"
            if mn2.stringview == "sort" then return "\{nlcb9}_sort(\{recvB9})"
            if mn2.stringview == "listview" then return "\{nlcb9}_listview(\{recvB9})"
            if mn2.stringview == "iterate" then return "\{nlcb9}_iterate(\{recvB9})"
            if mn2.stringview == "iterateMut" then return "\{nlcb9}_iterateMut(\{recvB9})"
        }
        # Set/Map are heap-pointer collections; their methods are emitted by the
        # collection template (not registry children), so a CLASS-dispatch
        # methodOwnerId scan would mis-resolve to a duplicate same-named mono. The
        # receiver field is already a pointer, so it is passed directly (no `&`).
        if (isSetOriginOf :symtab :ctx tid: nlid9) then {
            nscb9: ctxCname :ctx tid: nlid9
            if mn2.stringview == "iterate" then return "\{nscb9}_iterate(\{base9})"
        }
        if (isMapOriginOf :symtab :ctx tid: nlid9) then {
            nmpcb9: ctxCname :ctx tid: nlid9
            if mn2.stringview == "iterate" then return "\{nmpcb9}_iterate(\{base9})"
            if mn2.stringview == "iterateItems" then return "\{nmpcb9}_iterateItems(\{base9})"
        }
        # the id-keyed pair reached through a FIELD. They are stack structs, so
        # the receiver goes by address where a Map's field is already a pointer.
        if (isIdCollectionOriginOf :symtab :ctx tid: nlid9) then {
            nidcb9: ctxCname :ctx tid: nlid9
            nidrv9: colRecvRef :ctx bn: base9.stringview vid: bs9vid
            if mn2.stringview == "iterate" then return "\{nidcb9}_iterate(\{nidrv9})"
            if mn2.stringview == "iterateItems" then return "\{nidcb9}_iterateItems(\{nidrv9})"
        }
        if nlid9 > 0 then {
            nrtt9: symtab.reg.typetypeOf typeId: nlid9
            # a protocol/facet-typed base reached through a FIELD dispatches
            # exactly as a bare one does; without this the member read falls
            # through to the struct-field leg below and gcc rejects it
            if (dispatchableTid9 :symtab tid: nlid9) then {
                if (vtableAutoCallName9 name: mn2.stringview) then {
                    nacc9: ".".string
                    if (pathIsPointer
                        :ast
                        :symtab
                        :ctx
                        n: (ast.nodes.get i: n.parent.u64)
                    ) then nacc9 = "->".string
                    return (vtableAutoCallC9
                        recv: base9.stringview
                        acc: nacc9.stringview
                        mn: mn2.stringview
                        isFacet: nrtt9 == ztypes.ztypetype.facetType
                    )
                }
            }
            nDisp9: false
            if nrtt9 == ztypes.ztypetype.classType then nDisp9 = true
            if nrtt9 == ztypes.ztypetype.recordType then nDisp9 = true
            if nDisp9 then {
                nlidM9: methodOwnerId :ast :symtab rtid: nlid9 mn: mn2.stringview
                nmco9: (symtab.typing.declChildOf
                    pool: ast.names
                    parentTypeId: (ztypes.tid.create from: nlidM9.u64)
                    name: mn2.stringview
                )
                match (
                    nmco9
                ) case some then {
                    if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: nmco9.u64)) == ztypes.ztypetype.functionType then {
                        # no-arg SV natives on a nested stringy base: the
                        # canonical native symbol, not the method-id cname
                        if (isSvNoArgNative name: mn2.stringview) when (isStringyTid
                            :ctx
                            tid: nlid9
                        ) then {
                            needsAddM :ctx uname: "system" memb: mn2.stringview
                            svfn9: (svValueForm
                                :ctx
                                expr: base9.stringview
                                isStr: nlid9 == ctx.strTid
                                vid: bs9vid
                            )
                            return "\{ctx.svC}_\{mn2}(&\{svfn9})"
                        }
                        nmc9: ctxCname :ctx tid: (ztypes.tid.create from: nmco9.u64)
                        # a receiver-taking method takes it by pointer in both
                        # families, so address it unless it already is one
                        nmrecv9: "\{base9}"
                        if (calleeTakesReceiverByPtr
                            :ast
                            :symtab
                            fid: (ztypes.tid.create from: nmco9.u64)
                        ) then {
                            dpu9: ast.nodes.get i: n.parent.u64
                            if (pathIsPointer :ast :symtab :ctx n: dpu9) == false then {
                                nmrecv9 = "&\{base9}"
                            }
                        }
                        return "\{nmc9}(\{nmrecv9})"
                    }
                } case none then null
            }
        }
        # a Map/Set-typed base is a heap pointer regardless of how it was
        # reached (a field path fails pathIsPointer's lock-field test)
        nstPtr9: pathIsPointer :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
        if nstPtr9 == false then nstPtr9 = isHeapPtrCollection :symtab :ctx tid: nlid9
        if nstPtr9 then {
            ep9: "\{base9}->\{mn2}"
            return ep9
        } else {
            ed9: "\{base9}.\{mn2}"
            return ed9
        }
    } case atomstring then {
        li9: litIndexOf :ctx nid: n.nodeid.u64
        if li9 > 0 then {
            se9: "_zs\{li9}"
            return se9
        }
        emitFail :ctx what: "unhandled atomstring expr".string line: n.lineno
        return "/* zemitterc: unhandled atomstring expr */0".string
    } case ifexpr then {
        # a chain whose every condition folds has ONE live branch: emit its
        # value alone. spec.pdoc:5616 promises the false branch is not emitted,
        # and that promise is not limited to statement position.
        vfb9: foldedBranchOf9 :symtab nid: n.nodeid.u64
        if vfb9.known then {
            if (vfb9.stmt.isZero) == false then {
                return (emitExpr :ast :symtab :ctx n: (ast.nodes.get i: vfb9.stmt.u64))
            }
        }
        tx: String
        depth: u64
        citer: n.clauses.iterate
        for cId9: citer loop {
            c9r: ast.nodes.get i: cId9.u64
            cx: ternaryClause :ast :symtab :ctx c: c9r
            tx.append cx
            depth = depth + 1
        }
        ex9: ternaryElse :ast :symtab :ctx oId: n.elseclause
        tx.append ex9
        dk: u64
        for dk < depth loop {
            tx.append ")"
            dk = dk + 1
        }
        return tx
    } case binop then {
        l: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.lhs.u64)
        op: atomTextOf :ast n: (ast.nodes.get i: n.operator.u64)
        r: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.rhs.u64)
        if (nodeIsAtomBox
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.lhs.u64)
        ) then l = "(*\{l})"
        if (nodeIsAtomBox
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.rhs.u64)
        ) then r = "(*\{r})"
        return (emitBinop9 :ast :symtab :ctx binop: n :l :r op: op.stringview)
    } case call then {
        return (emitCallValue :ast :symtab :ctx call: n)
    } else {
        emitFail :ctx what: "unhandled expr".string line: (ztypecheck.nodeLine :n)
        return "/* zemitterc: unhandled expr */0".string
    }
}

# emitBinop9 -- emit a binary operator by asking what it RESOLVED to, never
# what it was spelled. The type checker recorded the type that declares the
# operator and the method it found; from those the operator is one of three
# things, and the operator's text is a lookup key rather than a branch:
#
#   the author wrote it   -- an ordinary method call, negated for an inequality
#                            derived from a declared equality
#   the runtime owns it   -- a natives.tbl row, keyed by qualified path
#   nobody declared it    -- the synthesised structural compare, keyed by the
#                            shape the emitter would otherwise have built
#
# The receiver-shape derivations stay here because they choose WHICH row
# applies and what its operands look like; the C itself lives in the table.
emitBinop9: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    binop: zast.BinOpData.view
    l: String
    r: String
    op: StringView
} out String is {
    owner9: binopOwnerAt :symtab :ctx nid: binop.nodeid.u64
    if owner9.isZero then {
        emitFail :ctx what: "operator '\{op}' resolved no declaring type" line: binop.lineno
        return "/* zemitterc: unresolved operator */0".string
    }
    opId9: atomNameIdOf :ast n: (ast.nodes.get i: binop.operator.u64)
    call9: binopMethodAt :symtab :ctx nid: binop.nodeid.u64
    callName9: opId9
    neg9: false
    if call9.isZero then {
        # an inequality the checker derived: the type declares equality and
        # says nothing about its negation, so the negation is emitted here
        eqo9: symtab.typing.declChildOfId parentTypeId: owner9 nameId: zast.wkOpEq
        match (
            eqo9
        ) case some then {
            call9 = ztypes.tid.create from: eqo9.u64
            callName9 = zast.wkOpEq
            neg9 = true
        } case none then null
    }
    isNat9: false
    isSyn9: false
    if call9 > 0 then {
        isNat9 = fnIsNativeId :symtab fid: call9
        isSyn9 = (symtab.typing.declMemberIsSynth
            parentTypeId: owner9
            nameId: callName9
        )
    }
    if call9 > 0 when (isNat9 == false) then {
        if (isSyn9) == false then {
            # a body the author wrote. Its receiver is a pointer like every
            # other method's, so address the lhs unless it already is one.
            cn9: ctxCname :ctx tid: call9
            recv9: l.copy
            if (pathIsPointer
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: binop.lhs.u64)
            ) == false then {
                amp9: "&\{l}"
                recv9 = amp9
            }
            if neg9 then {
                u1: "!\{cn9}(\{recv9}, \{r})"
                return u1
            }
            u2: "\{cn9}(\{recv9}, \{r})"
            return u2
        }
    }
    key9: binopKeyOf :symtab owner: owner9 isNative: isNat9 :op
    body9: nativeImplOf :ctx path: key9.stringview
    if body9.length == 0 then {
        emitFail :ctx what: "no native implementation for '\{key9}'" line: binop.lineno
        return "/* zemitterc: no native implementation */0".string
    }
    nd9: nativeNeedOf :ctx path: key9.stringview
    if nd9.length > 0 then needsAddM :ctx uname: "system" memb: nd9.stringview
    # String and StringView reach one native: both project to a view, by value
    # for the compares and as an lvalue for the row that takes pointers.
    lf9: l.copy
    rf9: r.copy
    if (isStringyTid :ctx tid: owner9) then {
        lt9: stampNameDeep :ast :symtab n: (ast.nodes.get i: binop.lhs.u64)
        rt9: stampNameDeep :ast :symtab n: (ast.nodes.get i: binop.rhs.u64)
        if (nativePtrArgsOf :ctx path: key9.stringview) then {
            lf9 = (svBinopOperand9
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: binop.lhs.u64)
                expr: l.stringview
                tname: lt9.stringview
            )
            rf9 = (svBinopOperand9
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: binop.rhs.u64)
                expr: r.stringview
                tname: rt9.stringview
            )
        } else {
            lq9: (atomVidIfPlain
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: binop.lhs.u64)
                text: l.stringview
            )
            rq9: (atomVidIfPlain
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: binop.rhs.u64)
                text: r.stringview
            )
            lf9 = svValueForm :ctx expr: l.stringview isStr: (lt9.stringview == "String") vid: lq9
            rf9 = svValueForm :ctx expr: r.stringview isStr: (rt9.stringview == "String") vid: rq9
        }
    }
    # a typedef emits no helper of its own: the chain end owns it
    tcn9: ctxCname :ctx tid: owner9
    tdb9: typedefChaseBaseName9 :symtab tid: owner9
    if tdb9.length > 0 then {
        tcn9 = ctxCname :ctx tid: (typedefChaseTid9 :symtab tid: owner9)
    }
    bn9: (List String)
    bv9: (List String)
    bn9.append from: "StringView".string
    bv9.append from: ctx.svC.copy
    bn9.append from: "T".string
    bv9.append from: tcn9.copy
    rn9: (List String)
    rv9: (List String)
    rn9.append from: "L".string
    rv9.append from: lf9.copy
    rn9.append from: "R".string
    rv9.append from: rf9.copy
    return (fillHolesCtx9
        :ctx
        text: body9
        path: key9.stringview
        bindNames: bn9
        bindVals: bv9
        rawNames: rn9
        rawVals: rv9
    )
}

# emitInterpPrint -- the interpolated-print temp chain: create, per-part
# append (literal bytes or snprintf-formatted scalar), print, free.
emitInterpPrint: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    parts: (ListVal u32).view
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    sN: emitInterpBuild :ast :symtab :ctx :parts :ind :tmp :buf
    l1: "\{ind}\{ctx.strC}_print(&_s\{sN});\n"
    buf.append l1
    l2: "\{ind}\{ctx.strC}_free(&_s\{sN});\n"
    buf.append l2
}

# emitInterpBuild -- the create/append chain for an interpolated literal;
# returns the _sN temp index (caller prints/frees or binds it).
emitInterpBuild: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    parts: (ListVal u32).view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
    hoistFloor: 0.u64
    hoistRawFloor: 0.u64
} out u64 is {
    est: u64
    with piter: parts.iterate do for pId9: piter loop {
        p: ast.nodes.get i: pId9.u64
        isC: false
        match (
            p
        ) case stringchunk then {
            isC = true
            tl: p.text.length
            est = est + tl
        } else null
        if (isC) == false then est = est + 16
    }
    sN: tmp.next
    l0: "\{ind}\{ctx.strC}_t _s\{sN} = \{ctx.strC}_create((uint64_t)\{est});\n"
    buf.append l0
    qiter: parts.iterate
    for qId9: qiter loop {
        (emitInterpPart
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: qId9.u64)
            :sN
            :ind
            :tmp
            :buf
            :hoistFloor
            :hoistRawFloor
        )
    }
    return sN
}

# the printf format specifier for a numeric type.
numericFormatName: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tn: StringView
} out String is {
    if (isIntName name: tn) then {
        r0: tn.string
        return r0
    }
    if (isFloatName name: tn) then {
        r1: tn.string
        return r1
    }
    tid: userFnId :ast :symtab :ctx name: tn
    if tid > 0 then {
        bc: typedefChaseC :ast :symtab :ctx :tid
        if bc.stringview == "double" then {
            return "f64".string
        } else if bc.stringview == "float" then {
            return "f32".string
        } else if bc.stringview == "_Float16" then {
            return "f16".string
        } else if bc.stringview == "__float128" then {
            return "f128".string
        } else if bc.length > 0 then return "i64".string
    }
    rr: tn.string
    return rr
}

# the element name for an indexed data-block access.
dataIndexElemName: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
} out String is {
    match (
        n
    ) case expression then {
        return (dataIndexElemName :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        mn: dottedChildText :ast n: (ast.nodes.get i: n.callable.u64)
        if mn.stringview == "index" then {
            dnid9: dottedBaseNodeId :ast n: (ast.nodes.get i: n.callable.u64)
            dk: dataBlockTid9 :symtab nid: dnid9
            go: ctx.dataElems.get key: dk
            match (
                go
            ) case some then {
                gv: go.stringview
                gc: gv.string
                return gc
            } case none then null
        }
        return "".string
    } else {
        return "".string
    }
}

# interpBaseIsMapEntry -- true when an interp part is `<entry>.key`/`.value`
# off a borrowed MapEntry: the projected String views the bucket, so it must
# be appended inline (freeing the hoisted copy would double-free the bucket
# key). All four entry forms project the same way.
interpBaseIsMapEntry: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: Node.view
} out bool is {
    match (
        n
    ) case expression then {
        return (interpBaseIsMapEntry :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (interpBaseIsMapEntry :ast :symtab n: (ast.nodes.get i: n.statementline.u64))
    } case dottedpath then {
        bnid: atomNodeId9 n: (ast.nodes.get i: n.parent.u64)
        bt: stampIdOf :symtab nid: bnid
        meT9: builtinTid :ast :symtab base: "MapEntry"
        if (originIsTid
            :symtab
            tid: bt
            originTid: (ztypes.tid.create from: meT9.u64)
        ) then return true
        meRV9: builtinTid :ast :symtab base: "MapEntryRV"
        if (originIsTid
            :symtab
            tid: bt
            originTid: (ztypes.tid.create from: meRV9.u64)
        ) then return true
        ideR9: builtinTid :ast :symtab base: "IdMapEntryR"
        if (originIsTid
            :symtab
            tid: bt
            originTid: (ztypes.tid.create from: ideR9.u64)
        ) then return true
        ideV9: builtinTid :ast :symtab base: "IdMapEntryV"
        if (originIsTid
            :symtab
            tid: bt
            originTid: (ztypes.tid.create from: ideV9.u64)
        ) then return true
        meVR9: builtinTid :ast :symtab base: "MapEntryVR"
        if (originIsTid
            :symtab
            tid: bt
            originTid: (ztypes.tid.create from: meVR9.u64)
        ) then return true
        meVV9: builtinTid :ast :symtab base: "MapEntryVV"
        if (originIsTid
            :symtab
            tid: bt
            originTid: (ztypes.tid.create from: meVV9.u64)
        ) then return true
        return false
    } else {
        return false
    }
}

# interpBaseIsOwnedStructField -- a `<inst>.field` read off a user record/class:
# the projected String VIEWS the owner's field (freed by the owner's destructor),
# so it appends inline -- freeing a hoisted copy would double-free the field.
interpBaseIsOwnedStructField: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    n: Node.view
} out bool is {
    match (
        n
    ) case expression then {
        iex39: ast.nodes.get i: n.expression.u64
        return (interpBaseIsOwnedStructField :ast :symtab n: iex39)
    } case statementline then {
        sln9: ast.nodes.get i: n.statementline.u64
        return (interpBaseIsOwnedStructField :ast :symtab n: sln9)
    } case dottedpath then {
        pnd9: ast.nodes.get i: n.parent.u64
        bnid: atomNodeId9 n: pnd9
        # A NESTED base (`b.it.name`) is itself a dotted path, not an atom, so
        # the atom lookup answers 0 and the whole predicate used to bail. Its
        # own stamp names the owner just as well. Without this the read falls
        # through to the owned-call-result leg, which FREES the field's String
        # out from under its owner.
        if bnid == 0 then bnid = nodeIdOf9 n: pnd9
        bt: stampIdOf :symtab nid: bnid
        bo: originTidOf :symtab tid: bt
        # a user-generic mono owns its fields once it carries a destructor;
        # other monos (views, collections) keep the owned-call-result legs
        if bo > 0 then {
            if (symtab.reg.hasDestructorName typeId: bt) == false then return false
        }
        btt: symtab.reg.typetypeOf typeId: bt
        isUC: false
        if btt == ztypes.ztypetype.recordType then isUC = true
        if btt == ztypes.ztypetype.classType then isUC = true
        if (isUC) == false then return false
        cn: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        co: symtab.typing.declChildOf pool: ast.names parentTypeId: bt name: cn.stringview
        match (
            co
        ) case some then {
            if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: co.u64)) == ztypes.ztypetype.functionType then {
                return false
            } else {
                return true
            }
        } case none then {
            return false
        }
    } else {
        return false
    }
}

# emit one part of a string interpolation.
emitInterpPart: function {
    hoistFloor: 0.u64
    hoistRawFloor: 0.u64
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    sN: u64
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    match (
        n
    ) case stringchunk then {
        tv: n.text.stringview
        esc: cEscape text: tv
        l3: "\{ind}\{ctx.strC}_append(&_s\{sN}, \"\{esc}\", sizeof(\"\{esc}\")-1);\n"
        buf.append l3
    } else {
        di0: dataIndexElemName :ast :symtab :ctx :n
        tn0: stampNameDeep :ast :symtab :n
        # the checker's per-mono instance walk side-stamps template nodes
        # the global table suppresses
        if tn0.length == 0 when ctx.curThisTid > 0 then {
            msid9: monoStampIdOf :symtab :ctx nid: (nodeIdOf9 :n)
            if msid9 > 0 then tn0 = typeNameOfReg9 :symtab tid: msid9
        }
        # a typedef part formats as its chain-end base
        tnTd0: typedefChaseBaseName9 :symtab tid: (stampIdDeep :ast :symtab :n)
        if tnTd0.length > 0 then tn0 = tnTd0.copy
        tn: numericFormatName :ast :symtab :ctx tn: tn0.stringview
        if di0.length > 0 then tn = di0
        val: emitExpr :ast :symtab :ctx :n
        # a call fragment may have hoisted non-lvalue args to _ah temps:
        # declare them before the fragment uses them (mirrors the direct
        # print path's flush after emitCallValue)
        flushArgHoists :ctx :ind :tmp :buf floor: hoistFloor rawFloor: hoistRawFloor
        bN: tmp.next
        if tn.stringview == "i128" then {
            needsAddM :ctx uname: "prelude" memb: "fmt_128"
            l4a: "\{ind}char _b\{bN}[48]; int _b\{bN}_n = z_fmt_i128(_b\{bN}, (__int128)\{val});\n"
            buf.append l4a
            l5a: "\{ind}\{ctx.strC}_append(&_s\{sN}, _b\{bN}, (uint64_t)_b\{bN}_n);\n"
            buf.append l5a
        } else if tn.stringview == "u128" then {
            needsAddM :ctx uname: "prelude" memb: "fmt_128"
            l4b: "\{ind}char _b\{bN}[48]; int _b\{bN}_n = z_fmt_u128(_b\{bN}, (unsigned __int128)\{val});\n"
            buf.append l4b
            l5b: "\{ind}\{ctx.strC}_append(&_s\{sN}, _b\{bN}, (uint64_t)_b\{bN}_n);\n"
            buf.append l5b
        } else if (isIntName name: tn.stringview) then {
            l4: "\{ind}char _b\{bN}[32]; int _b\{bN}_n = snprintf(_b\{bN}, 32, \"%ld\", (long)(int64_t)\{val});\n"
            buf.append l4
            l5: "\{ind}\{ctx.strC}_append(&_s\{sN}, _b\{bN}, (uint64_t)_b\{bN}_n);\n"
            buf.append l5
        } else if tn.stringview == "f128" then {
            l6q: "\{ind}char _b\{bN}[64]; int _b\{bN}_n = quadmath_snprintf(_b\{bN}, 64, \"%Qg\", \{val});\n"
            buf.append l6q
            l7q: "\{ind}\{ctx.strC}_append(&_s\{sN}, _b\{bN}, (uint64_t)_b\{bN}_n);\n"
            buf.append l7q
        } else if (isFloatName name: tn.stringview) then {
            l6: "\{ind}char _b\{bN}[64]; int _b\{bN}_n = snprintf(_b\{bN}, 64, \"%g\", (double)\{val});\n"
            buf.append l6
            l7: "\{ind}\{ctx.strC}_append(&_s\{sN}, _b\{bN}, (uint64_t)_b\{bN}_n);\n"
            buf.append l7
        } else if tn.stringview == "StringView" then {
            # by-value operand today; a pointer-passed SV would need the
            # String leg's accessor treatment below
            lsv: "\{ind}\{ctx.strC}_append(&_s\{sN}, \{val}.data, \{val}.size);\n"
            buf.append lsv
        } else if tn.stringview == "String" then {
            isAtomP: false
            an0: atomTextDeep :ast :n
            an0v9: atomVid :symtab nid: (atomNodeIdDeep9 :ast :n)
            if an0.length > 0 then isAtomP = true
            if (interpBaseIsMapEntry :ast :symtab :n) then isAtomP = true
            if (interpBaseIsOwnedStructField :ast :symtab :n) then isAtomP = true
            if isAtomP then {
                # a borrowed String param is a pointer (isBorrowStringParam
                # registers the raw name); compound bases (map-entry deref,
                # owned struct field) have an0 == "" and keep the value form
                sAcc9: ".".string
                if an0.length > 0 when (isPtrVid :ctx vid: an0v9) then sAcc9 = "->".string
                lss: "\{ind}\{ctx.strC}_append(&_s\{sN}, \{val}\{sAcc9}data, \{val}\{sAcc9}size);\n"
                buf.append lss
            } else if (hoistExprIsBorrowRooted :ast :symtab :ctx :n) then {
                # borrow-returning call result (a shared element view): hoist
                # for single evaluation and append -- the container owns the
                # storage, so no free (the MapEntry exemption, generalized by
                # the declared signature).
                hN: tmp.next
                lh0: "\{ind}\{ctx.strC}_t _h\{hN} = \{val};\n"
                buf.append lh0
                lh1: "\{ind}\{ctx.strC}_append(&_s\{sN}, _h\{hN}.data, _h\{hN}.size);\n"
                buf.append lh1
            } else {
                # owned call result: hoist, append, free
                hN: tmp.next
                lh0: "\{ind}\{ctx.strC}_t _h\{hN} = \{val};\n"
                buf.append lh0
                lh1: "\{ind}\{ctx.strC}_append(&_s\{sN}, _h\{hN}.data, _h\{hN}.size);\n"
                buf.append lh1
                lh2: "\{ind}\{ctx.strC}_free(&_h\{hN});\n"
                buf.append lh2
            }
        } else {
            pStrId9: stampIdOf :symtab nid: (nodeIdOf9 :n)
            if (originIsTid :symtab tid: pStrId9 originTid: ctx.strOriginTid) then {
                lstri9: "\{ind}\{ctx.strC}_append(&_s\{sN}, \{val}.data, \{val}.len);\n"
                buf.append lstri9
            } else {
                (emitFail
                    :ctx
                    what: "unhandled interp part type \{tn}"
                    line: (ztypecheck.nodeLine :n)
                )
                l8: "\{ind}/* zemitterc: unhandled interp part type \{tn} */\n"
                buf.append l8
            }
        }
        # the part's value has been appended, so a `.take` argument inside it
        # has been consumed: zero its source here, as the statement paths do.
        # Without this the callee frees the moved value and the caller frees it
        # again at scope end.
        emitValueTakeInvalidations :ast :symtab :ctx :n :ind :buf
    }
}

# nodeIdOf9 -- the nodeid of expression-ish shapes used by interp parts.
nodeIdOf9: function {n: Node.view} out u64 is {
    match (
        n
    ) case expression then {
        return n.nodeid.u64
    } case atomid then {
        return n.nodeid.u64
    } case labelvalue then {
        return n.nodeid.u64
    } case call then {
        return n.nodeid.u64
    } case binop then {
        return n.nodeid.u64
    } case dottedpath then {
        return n.nodeid.u64
    } case atomstring then {
        return n.nodeid.u64
    } else {
        return 0
    }
}

# stampNameDeep -- a node's stamped type name, peeling expression
# wrappers when the wrapper itself is unstamped.
# methodReturnByName -- given a "Base.member" method name, resolve the
# base type's member child and return its return-type name ("" if not).
methodReturnByName: function {ast: Ast symtab: zenv.ZSymbolTable dotted: StringView} out String is {
    base: String
    member: String
    seenDot: false
    di: u64
    dn: dotted.length
    for di < dn loop {
        bo0: dotted.byteAt i: di
        match (
            bo0
        ) case some then {
            if bo0 == 46 then {
                seenDot = true
            } else {
                if seenDot then {
                    member.appendByte b: bo0
                } else {
                    base.appendByte b: bo0
                }
            }
        } case none then null
        di = di + 1
    }
    if (seenDot) == false then return "".string
    # scan for a parent type named `base` that actually declares the
    # `member` child (a typedef has both a shell and a canonical id;
    # only the canonical bears children).
    mnid9: (zast.poolFind pool: ast.names text: member.stringview)
    found: ztypes.tid
    if mnid9 > 0 then {
        lastT9: symtab.reg.nextTypeId
        t9: ztypes.tid
        for t9 < lastT9 loop {
            if found.isZero then {
                pn: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: t9.u64)
                if pn.stringview == base.stringview then {
                    cto: symtab.typing.declChildOfId parentTypeId: t9 nameId: mnid9
                    match (
                        cto
                    ) case some then {
                        found = ztypes.tid.create from: (cto)
                    } case none then null
                }
            }
            t9 = ztypes.tid.create from: (t9 + 1)
        }
    }
    if found > 0 then {
        rt2: fnReturnTidOf :symtab tid: (ztypes.tid.create from: found.u64)
        if rt2 > 0 then return (typeNameOfReg9 :symtab tid: (ztypes.tid.create from: rt2.u64))
    }
    return "".string
}

# the fully-resolved emitted name for node `n`.
# stampIdDeep -- stampNameDeep's id form: the stamped type id, peeling
# expression wrappers and unwrapping a value-position FUNCTION stamp to its
# return tid. 0 where stampNameDeep would resolve a shell method by name (no
# clean id) or find nothing.
stampIdDeep: function {ast: Ast.view symtab: zenv.ZSymbolTable n: Node.view} out ztypes.tid is {
    nid: nodeIdOf9 :n
    sid: stampIdOf :symtab :nid
    if sid > 0 then {
        if (symtab.reg.typetypeOf typeId: sid) == ztypes.ztypetype.functionType then {
            rto: fnReturnTidOf :symtab tid: sid
            if rto > 0 then return (ztypes.tid.create from: rto.u64)
            rno9: symtab.typing.funcReturnNode.get key: sid
            match (
                rno9
            ) case some then {
                rrt9: stampIdOf :symtab nid: rno9
                if rrt9 > 0 then return rrt9
            } case none then null
            return (ztypes.tid.create from: 0)
        }
        return sid
    }
    match (
        n
    ) case expression then {
        return (stampIdDeep :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } else {
        return (ztypes.tid.create from: 0)
    }
}

stampNameDeep: function {ast: Ast.view symtab: zenv.ZSymbolTable n: Node.view} out String is {
    nid: nodeIdOf9 :n
    sid: stampIdOf :symtab :nid
    if sid > 0 then {
        # a value-position FUNCTION stamp is an auto-call; its value
        # type is the method's return.
        if (symtab.reg.typetypeOf typeId: sid) == ztypes.ztypetype.functionType then {
            rto: fnReturnTidOf :symtab tid: sid
            if rto > 0 then return (typeNameOfReg9 :symtab tid: (ztypes.tid.create from: rto.u64))
            rno9: symtab.typing.funcReturnNode.get key: sid
            match (
                rno9
            ) case some then {
                rrt9: stampIdOf :symtab nid: rno9
                if rrt9 > 0 then return (typeNameOfReg9 :symtab tid: rrt9)
            } case none then null
            # a shell FUNCTION named "Base.member": resolve the method
            # through the base type's child and read its return.
            fnm: typeNameOfReg9 :symtab tid: sid
            rmn: methodReturnByName :ast :symtab dotted: fnm.stringview
            if rmn.length > 0 then return rmn
        }
        return (typeNameOfReg9 :symtab tid: sid)
    }
    match (
        n
    ) case expression then {
        return (stampNameDeep :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } else {
        return "".string
    }
}

# emitPrintStmt -- a statement-position print call.
emitPrintStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    emitted: false
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            if (emitted) == false then {
                emitted = true
                (emitPrintArg
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a.operation.u64)
                    :ind
                    :tmp
                    :buf
                )
            }
        } else null
    }
    if (emitted) == false then buf.append "    /* zemitterc: print with no argument */\n"
}

# plainStringLiteral9 -- the text of a single-chunk string literal (through
# expression wrappers); "" for interpolated or non-literal expressions.
plainStringLiteral9: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (plainStringLiteral9 :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomstring then {
        if n.stringparts.length == 1 then {
            p9: ast.nodes.get i: (n.stringparts.get i: 0).u64
            match (
                p9
            ) case stringchunk then {
                pt9: p9.text.stringview
                pc9: pt9.string
                return pc9
            } else null
        }
        return "".string
    } else {
        return "".string
    }
}

# emitErrorStmt -- an `error` call the fold pass could not eliminate. Behind
# a runtime guard it traps via z_panic (reachability is not provable); in
# unconditional position the spec says compilation fails: the message is
# recorded for the driver and the trap emitted as a placeholder.
emitErrorStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    call: zast.CallData.view
    ind: StringView
    buf: String.borrow
} is {
    av: String
    lit: String
    got: false
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            if (got) == false then {
                got = true
                opn9: ast.nodes.get i: a.operation.u64
                av = emitExpr :ast :symtab :ctx n: opn9
                lit = plainStringLiteral9 :ast n: opn9
            }
        } else null
    }
    okArg: false
    if got then {
        if (av.stringview.startsWith prefix: "/*") == false then okArg = true
    }
    if okArg then {
        el9: "\{ind}z_panic((const char*)\{av}.data);\n"
        buf.append el9
    } else {
        ef9: "\{ind}z_panic(\"(compile-time error)\");\n"
        buf.append ef9
    }
    if ctx.condDepth == 0 when ctx.genActive == false then {
        em9: lit.copy
        if em9.length == 0 then em9 = "compile-time error reached".string
        ctx.emitErrors.append from: em9
    }
}

# emitPanicStmt -- `panic "msg"` routes through the shared z_panic runtime
# helper. msg is a StringLike (String/StringView); both expose `.data` as a
# char pointer. A non-string or unhandled arg falls back to a bare marker.
emitPanicStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    call: zast.CallData.view
    ind: StringView
    buf: String.borrow
} is {
    av: String
    got: false
    aiter: call.arguments.iterate
    for aId9: aiter loop {
        a: ast.nodes.get i: aId9.u64
        match (
            a
        ) case namedoperation then {
            if (got) == false then {
                got = true
                opf189: ast.nodes.get i: a.operation.u64
                av = emitExpr :ast :symtab :ctx n: opf189
            }
        } else null
    }
    okArg: false
    if got then {
        if (av.stringview.startsWith prefix: "/*") == false then okArg = true
    }
    if okArg then {
        pl: "\{ind}z_panic((const char*)\{av}.data);\n"
        buf.append pl
    } else {
        pf: "\{ind}z_panic(\"(panic)\");\n"
        buf.append pf
    }
}

# emit one argument of a `print` call.
emitPrintArg: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    n: Node.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    match (
        n
    ) case expression then {
        emitPrintArg :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64) :ind :tmp :buf
    } case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            emitInterpPrint :ast :symtab :ctx parts: n.stringparts :ind :tmp :buf
        } else {
            li: litIndexOf :ctx nid: n.nodeid.u64
            if li > 0 then {
                l9: "\{ind}\{ctx.svC}_print(_zs\{li});\n"
                buf.append l9
            } else {
                buf.append "    /* zemitterc: unpooled literal */\n"
            }
        }
    } case atomid then {
        tn9: stampNameOf :symtab nid: n.nodeid.u64
        anC9: zast.nameTextAt :ast ref: n.name
        an9: anC9.stringview
        anmV0: atomVid :symtab nid: n.nodeid.u64
        anm: aliasResolve :ctx name: an9 vid: anmV0
        anv9: ztypes.vid
        if anm.stringview == an9 then anv9 = anmV0
        # anm stays the SOURCE name (the alias/narrow lookups key on it); anmE
        # is what reaches the C
        anmE: emitLocalAtomName :ctx name: an9 vid: anmV0
        # a unit string CONSTANT reaching print by name. emitExpr answers for a
        # constant on its own first line; print resolves atoms itself and never
        # goes through it, so without this the NAME reaches the C undeclared.
        # A stamped local is not a constant, so the probe is skipped for one --
        # the same order emitExpr's atomid arm uses.
        {
            alo9: symtab.typing.atomVariableId.get key: n.nodeid.u64
            if alo9.none then {
                cst9: (memberConstStrText9
                    :symtab
                    :ctx
                    unitTid: (unitTidOf9 :ast :symtab unitName: ctx.mainName.stringview)
                    nameId: n.name
                )
                if cst9.length > 0 then anmE = cst9.copy
            }
        }
        sid79: stampIdOf :symtab nid: n.nodeid.u64
        if sid79 == ctx.strTid then {
            if (isPtrVid :ctx vid: anv9) then {
                lps: "\{ind}\{ctx.strC}_print(\{anmE});\n"
                buf.append lps
            } else {
                lps2: "\{ind}\{ctx.strC}_print(&\{anmE});\n"
                buf.append lps2
            }
        } else if ctx.svTid == (stampIdOf :symtab nid: n.nodeid.u64) then {
            lpv: "\{ind}\{ctx.svC}_print(\{anmE});\n"
            buf.append lpv
        } else {
            argTid: stampIdOf :symtab nid: n.nodeid.u64
            if (originIsTid :symtab tid: argTid originTid: ctx.strOriginTid) then {
                lpstr9: "\{ind}\{ctx.svC}_print((\{ctx.svC}_t){ .data = \{anmE}.data, .size = \{anmE}.len });\n"
                buf.append lpstr9
                return
            }
            svco: symtab.typing.declChildOfId parentTypeId: argTid nameId: zast.wkStringview
            match (
                svco
            ) case some then {
                mcb: ctxCname :ctx tid: (ztypes.tid.create from: svco.u64)
                argOrig9: originTidOf :symtab tid: argTid
                usesAmp: false
                if (symtab.reg.typetypeOf typeId: argTid) == ztypes.ztypetype.classType when argOrig9.isZero then {
                    if (isPtrVid :ctx vid: anv9) == false then usesAmp = true
                }
                if usesAmp then {
                    lpt: "\{ind}\{ctx.svC}_print(\{mcb}(&\{anmE}));\n"
                    buf.append lpt
                } else {
                    lpt2: "\{ind}\{ctx.svC}_print(\{mcb}(\{anmE}));\n"
                    buf.append lpt2
                }
            } case none then {
                emitFail :ctx what: "unhandled print of \{anmE} type \{tn9}" line: n.lineno
                lpu: "\{ind}/* zemitterc: unhandled print of \{anmE} type \{tn9} */\n"
                buf.append lpu
            }
        }
    } case call then {
        ce9: emitCallValue :ast :symtab :ctx call: n
        flushArgHoists :ctx :ind :tmp :buf
        sid99: stampIdOf :symtab nid: n.nodeid.u64
        if sid99 == ctx.svTid then {
            lpcv9: "\{ind}\{ctx.svC}_print(\{ce9});\n"
            buf.append lpcv9
        } else {
            hpc9: tmp.next
            lpa9: "\{ind}\{ctx.strC}_t _h\{hpc9} = \{ce9};\n"
            buf.append lpa9
            lpb9: "\{ind}\{ctx.strC}_print(&_h\{hpc9});\n"
            buf.append lpb9
            lpf9: "\{ind}\{ctx.strC}_free(&_h\{hpc9});\n"
            buf.append lpf9
        }
    } else {
        eid9: nodeIdOf9 :n
        sid109: stampIdOf :symtab nid: eid9
        if sid109 == ctx.svTid then {
            ev9: emitExpr :ast :symtab :ctx :n
            flushArgHoists :ctx :ind :tmp :buf
            lpe9: "\{ind}\{ctx.svC}_print(\{ev9});\n"
            buf.append lpe9
        } else if ctx.strTid == (stampIdOf :symtab nid: eid9) then {
            es9: emitExpr :ast :symtab :ctx :n
            flushArgHoists :ctx :ind :tmp :buf
            if (isNonLvalueArg s: es9.stringview) then {
                hps9: tmp.next
                lsa9: "\{ind}\{ctx.strC}_t _h\{hps9} = \{es9};\n"
                buf.append lsa9
                lsb9: "\{ind}\{ctx.strC}_print(&_h\{hps9});\n"
                buf.append lsb9
                lsf9: "\{ind}\{ctx.strC}_free(&_h\{hps9});\n"
                buf.append lsf9
            } else {
                lsl9: "\{ind}\{ctx.strC}_print(&\{es9});\n"
                buf.append lsl9
            }
        } else {
            emitFail :ctx what: "unhandled print argument".string line: (ztypecheck.nodeLine :n)
            buf.append "    /* zemitterc: unhandled print argument */\n"
        }
    }
}

# bindLitIndex -- the pool index of a plain-literal value node (0 = none).
bindLitIndex: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
} out u64 is {
    match (
        n
    ) case expression then {
        return (bindLitIndex :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            return 0
        } else {
            return (litIndexOf :ctx nid: n.nodeid.u64)
        }
    } else {
        return 0
    }
}

# stringviewOfBase -- the base name of `X.stringview` over a String local
# ("" otherwise).
stringviewOfBaseNid: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: Node.view
} out u64 is {
    match (
        n
    ) case expression then {
        return (stringviewOfBaseNid :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        mn: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if mn.stringview == "stringview" then {
            bnid: atomNodeId9 n: (ast.nodes.get i: n.parent.u64)
            sid9: stampIdOf :symtab nid: bnid
            if sid9.u64 == (builtinTid :ast :symtab base: "String") then return bnid
        }
        return 0
    } else {
        return 0
    }
}

# stringviewOfBase -- that base atom's text. Derived from the node above rather
# than re-walked, so the name and the id can never describe different atoms.
stringviewOfBase: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: Node.view
} out String is {
    sbn9: stringviewOfBaseNid :ast :symtab :n
    if sbn9 == 0 then return "".string
    return (atomTextOf :ast n: (ast.nodes.get i: sbn9))
}

# stringCopyLitIndex -- the pool index of `\"lit\".string` (0 otherwise).
stringCopyLitIndex: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
} out u64 is {
    match (
        n
    ) case expression then {
        return (stringCopyLitIndex :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        mn: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if mn.stringview == "string" then {
            return (bindLitIndex :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64))
        } else {
            return 0
        }
    } else {
        return 0
    }
}

# copyRvalueHoist -- `<rvalue>.copy` over a String (e.g. `(list.get i: n).copy`):
# the receiver is a non-lvalue, so hoist it to a borrowed temp (`list.get` returns
# a shallow view -- never freed) and return `String_copy(&temp)`. "" otherwise.
copyRvalueHoist: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: Node.view
    ind: StringView
    buf: String.borrow
} out String is {
    match (
        n
    ) case expression then {
        iex29: ast.nodes.get i: n.expression.u64
        return (copyRvalueHoist :ast :symtab :ctx n: iex29 :ind :buf)
    } case dottedpath then {
        cn9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if cn9.stringview != "copy" then return "".string
        pnm9: stampNameDeep :ast :symtab n: (ast.nodes.get i: n.parent.u64)
        if pnm9.stringview != "String" then return "".string
        pv9: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
        if (isNonLvalueArg s: pv9.stringview) == false then return "".string
        hn9: ctx.argHoistCtr
        ctx.argHoistCtr = ctx.argHoistCtr + 1
        tnm9: "_cpv\{hn9}"
        th9: "\{ind}\{ctx.strC}_t \{tnm9} = \{pv9};\n"
        buf.append th9
        return "\{ctx.strC}_copy(&\{tnm9})"
    } else {
        return "".string
    }
}

# emitStringBindValue -- bind an interpolated-literal value to a String
# local (build chain + binding + scope-end free); false when the value
# is not an interpolated literal.
emitStringBindValue: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx
    n: Node.view
    nm: StringView
    nmVid: ztypes.vid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out bool is {
    match (
        n
    ) case expression then {
        iex9: ast.nodes.get i: n.expression.u64
        return (emitStringBindValue :ast :symtab :ctx n: iex9 :nm :nmVid :ind :tmp :buf)
    } case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            sB: emitInterpBuild :ast :symtab :ctx parts: n.stringparts :ind :tmp :buf
            lst: "\{ind}\{ctx.strC}_t \{nm} = _s\{sB};\n"
            buf.append lst
            nmc: nm.string
            tmp.frees.append nmc
            tmp.freeRaw.append nmVid
            return true
        } else {
            return false
        }
    } case dottedpath then {
        cnd9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if cnd9.stringview == "string" then {
            dpv9: ast.nodes.get i: n.parent.u64
            return (emitStringBindValue :ast :symtab :ctx n: dpv9 :nm :nmVid :ind :tmp :buf)
        }
        if cnd9.stringview == "copy" then {
            # `<rvalue>.copy` over a String (e.g. `(list.get i: n).copy`): the
            # receiver is a non-lvalue, so hoist it to a borrowed temp (List.get
            # returns a shallow view -- never freed) before String_copy(&temp).
            pnm9: stampNameDeep :ast :symtab n: (ast.nodes.get i: n.parent.u64)
            if pnm9.stringview == "String" then {
                pv9: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: n.parent.u64)
                if (isNonLvalueArg s: pv9.stringview) then {
                    hn9: ctx.argHoistCtr
                    ctx.argHoistCtr = ctx.argHoistCtr + 1
                    tnm9: "_cpv\{hn9}"
                    th9: "\{ind}\{ctx.strC}_t \{tnm9} = \{pv9};\n"
                    buf.append th9
                    lc9: "\{ind}\{ctx.strC}_t \{nm} = \{ctx.strC}_copy(&\{tnm9});\n"
                    buf.append lc9
                    nmc9: nm.string
                    tmp.frees.append nmc9
                    tmp.freeRaw.append nmVid
                    return true
                }
            }
            return false
        }
        return false
    } else {
        return false
    }
}

# emitOptionBoxHoist -- `Option.some <val>`: a heap-boxed union ctor, emitted as
# statements (the box can't be an expression). Returns the `_cN` temp name, or ""
# when n is not an Option.some (so the caller falls back to the expression path).
emitOptionBoxHoist: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} out String is {
    match (
        n
    ) case expression then {
        iexG9: ast.nodes.get i: n.expression.u64
        return (emitOptionBoxHoist :ast :symtab :ctx n: iexG9 :ind :tmp :buf)
    } case statementline then {
        sln9: ast.nodes.get i: n.statementline.u64
        return (emitOptionBoxHoist :ast :symtab :ctx n: sln9 :ind :tmp :buf)
    } case call then {
        cn: dottedChildText :ast n: (ast.nodes.get i: n.callable.u64)
        if cn.stringview != "some" then return "".string
        mid: stampIdOf :symtab nid: n.nodeid.u64
        if (originIsTid :symtab tid: mid originTid: ctx.optionOriginTid) == false then {
            return "".string
        }
        av: "0".string
        got: false
        aiter9: n.arguments.iterate
        for a9Id9: aiter9 loop {
            a9: ast.nodes.get i: a9Id9.u64
            match (
                a9
            ) case namedoperation then {
                if (got) == false then {
                    got = true
                    opf199: ast.nodes.get i: a9.operation.u64
                    av = emitExpr :ast :symtab :ctx n: opf199
                }
            } else null
        }
        vc: ctxCname :ctx tid: mid
        payC: armPayloadC :ast :symtab :ctx tid: mid arm: "some"
        tg: variantTag :symtab tid: mid arm: "some"
        bN: tmp.next
        b0: "\{ind}\{vc}_t _c\{bN} = {0};\n"
        buf.append b0
        b1: "\{ind}_c\{bN}.tag = \{tg};\n"
        buf.append b1
        b2: "\{ind}\{payC} _t\{bN} = \{av};\n"
        buf.append b2
        b3: "\{ind}\{payC}* _Box\{bN} = (\{payC}*)z_xmalloc(sizeof(\{payC}));\n"
        buf.append b3
        b4: "\{ind}*_Box\{bN} = _t\{bN};\n"
        buf.append b4
        if (isBareCName s: av.stringview) when (isRegisteredOwned :tmp name: av.stringview) then {
            invB: "\{ind}\{av} = (\{payC}){0};\n"
            if (strHasSub hay: payC.stringview needle: "*") then invB = "\{ind}\{av} = NULL;\n"
            buf.append invB
        }
        b5: "\{ind}_c\{bN}.data = _Box\{bN};\n"
        buf.append b5
        return "_c\{bN}"
    } else {
        return "".string
    }
}

# emitStringReturnValue -- a `return "\{...}".string` whose value is an
# interpolated-String literal: build it (emitInterpBuild) then return the owned
# temp. Mirrors emitStringBindValue but the built String is the return value
# (ownership transfers to the caller -> no free registered). false when the
# value is not an interp-String-literal (caller falls back to emitExpr).
emitStringReturnValue: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} out bool is {
    match (
        n
    ) case expression then {
        iexH9: ast.nodes.get i: n.expression.u64
        return (emitStringReturnValue :ast :symtab :ctx n: iexH9 :ind :tmp :buf)
    } case atomstring then {
        if (isInterp :ast parts: n.stringparts) then {
            sB: emitInterpBuild :ast :symtab :ctx parts: n.stringparts :ind :tmp :buf
            rexp9: "_s\{sB}"
            emitReturnCleanup :ctx :tmp retExpr: rexp9.stringview keepRefd: true :ind :buf
            lst: "\{ind}return _s\{sB};\n"
            buf.append lst
            return true
        } else {
            return false
        }
    } case dottedpath then {
        cnd9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if cnd9.stringview == "string" then {
            dpw9: ast.nodes.get i: n.parent.u64
            return (emitStringReturnValue :ast :symtab :ctx n: dpw9 :ind :tmp :buf)
        } else {
            return false
        }
    } else {
        return false
    }
}

# emitCallStmt -- one call-shaped statement: return / print / a plain call.
# emitDiscardedResult -- a statement-position call (explicit, dotted auto-call,
# or bare-atom auto-call) whose result is discarded: when the stamped result
# type is an owned destructible value (String / class / union) and the RHS is
# not a borrow by the declared signature (bindingRhsIsBorrow: funcReturnsBorrow
# markers, container element views), bind the result to a temp and destroy it.
# Emits `expr;` alone otherwise.
emitDiscardedResult: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    isBorrow: bool
    ce: StringView
    rtid: ztypes.tid
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    dctt9: symtab.reg.typetypeOf typeId: rtid
    dcdrop9: false
    if (symtab.reg.hasDestructorName typeId: rtid) when isBorrow == false then {
        if rtid == ctx.strTid then dcdrop9 = true
        if dctt9 == ztypes.ztypetype.classType then dcdrop9 = true
        if dctt9 == ztypes.ztypetype.unionType then dcdrop9 = true
    }
    if dcdrop9 when (isNonLvalueArg s: ce) then {
        dctn9: tmp.next
        dctnm9: "_c\{dctn9}"
        dcct9: "\{ctx.strC}_t"
        dcfree9: "\{ind}\{ctx.strC}_free(&\{dctnm9});\n"
        if rtid != ctx.strTid then {
            dcct9 = (typeRefC
                :ast
                :symtab
                :ctx
                tid: (ztypes.tid.create from: rtid.u64)
                thisTid: ztypes.tid
            )
            dccb9: ctxCname :ctx tid: (ztypes.tid.create from: rtid.u64)
            dcref9: "&\{dctnm9}"
            if (ctEndsWithStar ct: dcct9.stringview) then dcref9 = "\{dctnm9}"
            dcfree9 = "\{ind}\{dccb9}_destroy(\{dcref9});\n"
        }
        dcdecl9: "\{ind}\{dcct9} \{dctnm9} = \{ce};\n"
        buf.append dcdecl9
        buf.append dcfree9
    } else {
        lc: "\{ind}(void)(\{ce});\n"
        buf.append lc
    }
}

# emit a call used as a statement.
emitCallStmt: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
    ind: StringView
    tmp: TmpCtr.view
    buf: String.borrow
} is {
    relmn: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if relmn.stringview == "release" then {
        relbnid: dottedBaseNodeId :ast n: (ast.nodes.get i: call.callable.u64)
        reltid: stampIdOf :symtab nid: relbnid
        if (symtab.reg.typetypeOf typeId: reltid) == ztypes.ztypetype.protocolType then return
    }
    cn0: atomTextOf :ast n: (ast.nodes.get i: call.callable.u64)
    # a statement form arrives either as its core alias (an atom) or spelled
    # qualified (a dotted path, whose atom text is empty)
    sfn9: cn0.copy
    if cn0.length == 0 then {
        sfn9 = (stmtFormName9
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: call.callable.u64)
        )
    }
    if sfn9.stringview == "print" then {
        emitPrintStmt :ast :symtab :ctx :call :ind :tmp :buf
        return
    }
    if sfn9.stringview == "panic" then {
        emitPanicStmt :ast :symtab :ctx :call :ind :buf
        return
    }
    if sfn9.stringview == "error" then {
        emitErrorStmt :ast :symtab :ctx :call :ind :buf
        return
    }
    if sfn9.stringview == "return" then {
        hasArg: false
        aiter: call.arguments.iterate
        for aId9: aiter loop {
            a: ast.nodes.get i: aId9.u64
            match (
                a
            ) case namedoperation then {
                if (hasArg) == false then {
                    hasArg = true
                    emitReturnOfNode :ast :symtab :ctx vid: a.operation :ind :tmp :buf
                }
            } else null
        }
        if (hasArg) == false then {
            if ctx.genActive then {
                lgd: "\{ind}goto L_done;\n"
                buf.append lgd
            } else {
                emitReturnCleanup :ctx :tmp retExpr: "" keepRefd: true :ind :buf
                lr2: "\{ind}return;\n"
                buf.append lr2
            }
        }
        return
    }
    ce: emitCallValue :ast :symtab :ctx :call
    flushArgHoists :ctx :ind :tmp :buf
    dcrtid9: stampIdOf :symtab nid: call.nodeid.u64
    (emitDiscardedResult
        :ast
        :symtab
        :ctx
        isBorrow: (callRhsIsBorrow :ast :symtab :ctx :call)
        ce: ce.stringview
        rtid: dcrtid9
        :ind
        :tmp
        :buf
    )
    emitCallTakeInvalidations :ast :symtab :ctx :call :ind :buf
}

# nodeIsDotted9 -- the node is a dotted-path auto-call (a no-arg method
# reference used in statement position).
nodeIsDotted9: function {n: Node.view} out bool is {
    match (
        n
    ) case dottedpath then {
        return true
    } else {
        return false
    }
}

# emitStmt -- one statement of a function body.
emitStmt: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx
    n: Node.view
    ind: StringView
    tmp: TmpCtr
    buf: String.borrow
} is {
    match (
        n
    ) case statementline then {
        sln9: ast.nodes.get i: n.statementline.u64
        emitStmt :ast :symtab :ctx n: sln9 :ind :tmp :buf
    } case expression then {
        emitStmt :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64) :ind :tmp :buf
    } case statement then {
        siter9: n.statements.iterate
        for s9Id9: siter9 loop {
            emitStmt :ast :symtab :ctx n: (ast.nodes.get i: s9Id9.u64) :ind :tmp :buf
        }
    } case doexpr then {
        if (ztypecheck.blockHasBreak :ast n: (ast.nodes.get i: n.statement.u64)) then {
            ldo9: "\{ind}do {\n"
            buf.append ldo9
            indd9: "\{ind}    "
            # the block is its own break target: a break inside frees the
            # block's owned temps (since these marks) and lands after the
            # block, not on an enclosing loop's label
            sdoId9: pushLoopLabel :ctx :tmp isDo: true
            sfL9: tmp.frees.length
            slL9: tmp.listFrees.length
            dst9: ast.nodes.get i: n.statement.u64
            emitBodyNode :ast :symtab :ctx n: dst9 ind: indd9.stringview :tmp :buf
            dvF9: blockDiverges :ast :symtab :ctx n: dst9
            flushBlockFrees :ctx :tmp fL: sfL9 lL: slL9 diverged: dvF9 :buf
            lwh9: "\{ind}} while (0);\n"
            buf.append lwh9
            popLoopLabel :ctx id: sdoId9 :ind :buf
        } else {
            (emitBodyNode
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: n.statement.u64)
                :ind
                :tmp
                :buf
            )
        }
    } case call then {
        emitCallStmt :ast :symtab :ctx call: n :ind :tmp :buf
    } case assignment then {
        avn9: ast.nodes.get i: n.value.u64
        tn: stampNameOf :symtab nid: n.nodeid.u64
        btid9: stampIdOf :symtab nid: n.nodeid.u64
        # the NAME says scalar; the tid says whether it is the builtin one. A
        # shadow keeps the name and loses the C scalar, so it emits its struct.
        ct: cTypeOf name: tn.stringview
        if ct.length > 0 when btid9 > 0 then {
            if (scalarTidIsBuiltin :symtab tid: btid9) == false then {
                ct = typeRefC :ast :symtab :ctx tid: btid9 thisTid: ztypes.tid
            }
        }
        if ct.length == 0 then {
            tgo: ztyping.nodeTypeAt tbl: symtab.typing.nodeType nid: n.nodeid.u64
            if tgo > 0 then {
                ct = (typeRefC
                    :ast
                    :symtab
                    :ctx
                    tid: (ztypes.tid.create from: tgo.u64)
                    thisTid: ztypes.tid
                )
            } else {
                vgo9: ztyping.nodeTypeAt tbl: symtab.typing.nodeType nid: (nodeIdOf9 n: avn9)
                if vgo9 > 0 then {
                    ct = (typeRefC
                        :ast
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: vgo9.u64)
                        thisTid: ztypes.tid
                    )
                }
            }
        }
        anmC9: zast.poolTextAt pool: ast.names ref: n.name
        nmVid9: defVid :symtab nid: n.nodeid.u64
        nm: varCName :ctx vid: nmVid9 name: anmC9.stringview
        # this statement introduces a fresh local: a borrow alias left by an
        # earlier binding of the same name names a C variable that is out of
        # scope here, so drop it before the legs below re-establish one.
        {
            sab9: vvGet xs: ctx.aliases vid: nmVid9
            if sab9.length > 0 when (sab9.stringview.startsWith prefix: "(*__borrow_") then {
                vvRemove xs: ctx.aliases vid: nmVid9
            }
        }
        nbrw9: bindingRhsIsBorrow :ast :symtab :ctx n: avn9
        ctx.borrowedVars.set key: (defVid :symtab nid: n.nodeid.u64) value: nbrw9
        if ctx.genActive when (isYieldNode :ast n: avn9) then {
            (emitExprFormYield
                :ast
                :symtab
                :ctx
                value: avn9
                aid: n.nodeid.u64
                nm: nm.stringview
                nmVid: nmVid9
                :ind
                :tmp
                :buf
            )
            return
        }
        # `x: <inst>.take` over a record/class is an ownership alias: record
        # `x => inst` and emit no storage (subsequent `x` resolves to `inst`).
        tabA: takeAliasBase :ast :symtab n: avn9
        tabAV9: atomVid :symtab nid: (takeAliasBaseNid :ast :symtab n: avn9)
        if tabA.length > 0 then {
            # a narrowed-subject `.take` binding MOVES the payload out of
            # the match arm's box: real storage from the narrowed cast plus
            # box zeroing, so the subject's post-match destroy no-ops (a
            # pure alias would re-resolve to the whole un-narrowed subject)
            if (vvHas xs: ctx.narrowBox vid: tabAV9) then {
                ntO9: vtGet xs: ctx.narrowTid vid: tabAV9
                match (
                    ntO9
                ) case some then {
                    ctB9: (typeRefC
                        :ast
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: ntO9.u64)
                        thisTid: ztypes.tid
                    )
                    valB9: takeSourceResolve :ctx name: tabA.stringview vid: tabAV9
                    lnB1: "\{ind}\{ctB9} \{nm} = \{valB9};\n"
                    buf.append lnB1
                    lnB2: "\{ind}\{valB9} = (\{ctB9}){0};\n"
                    buf.append lnB2
                    # a String payload is freed by the string runtime, which
                    # has no `_destroy`: it rides the scope's String free list
                    # like any other owned String local.
                    ldcbC9: ctxCname :ctx tid: (ztypes.tid.create from: ntO9.u64)
                    if ldcbC9.stringview == ctx.strC.stringview then {
                        nmcB9: nm.copy
                        tmp.frees.append nmcB9
                        tmp.freeRaw.append nmVid9
                    } else {
                        if (symtab.reg.hasDestructorName typeId: ntO9) then {
                            ldcbB: ctxCname :ctx tid: (ztypes.tid.create from: ntO9.u64)
                            ldfB: "    \{ldcbB}_destroy(&\{nm});\n"
                            ldfsB: ldfB.copy
                            tmp.listFrees.append ldfsB
                            tmp.listFreeVars.append nm.copy
                            tmp.listFreeRaw.append nmVid9
                        }
                    }
                    return
                } case none then null
            }
            # the alias VALUE is C text, so it must be the source's emitted
            # identifier -- its source name names nothing in the output
            tabAE9: emitLocalAtomName :ctx name: tabA.stringview vid: tabAV9
            lalA: "\{ind}/* alias: \{nm} => \{tabAE9} */\n"
            buf.append lalA
            vvSet xs: ctx.aliases vid: nmVid9 val: tabAE9.stringview
            return
        }
        ltid: stampIdOf :symtab nid: n.nodeid.u64
        if ltid.isZero then ltid = stampIdOf :symtab nid: (nodeIdOf9 n: avn9)
        ltid = ztypes.tid.create from: (chaseColMono :symtab :ctx tid: ltid)
        if (isListOriginOf :symtab :ctx tid: ltid) then {
            lcb: ctxCname :ctx tid: ltid
            if (noArgNativeRhs :ast :symtab unitName: ctx.mainName.stringview n: avn9) then {
                # owned List returned by os.args / os.envNames: emit the call.
                losr: emitExpr :ast :symtab :ctx n: avn9
                losb: "\{ind}\{lcb}_t \{nm} = \{losr};\n"
                buf.append losb
            } else {
                if (forexprValue :ast n: avn9) then {
                    # list comprehension: `xs: for ... loop { expr }` create + populate
                    lc0: "\{ind}\{lcb}_t \{nm} = \{lcb}_create((uint64_t)0);\n"
                    buf.append lc0
                    (emitListComprehension
                        :ast
                        :symtab
                        :ctx
                        forNode: avn9
                        listCb: lcb.stringview
                        listVar: nm.stringview
                        :ind
                        :tmp
                        :buf
                    )
                } else {
                    if (collectionValueCallRhs :ast :symtab n: avn9) then {
                        lvr0: emitExpr :ast :symtab :ctx n: avn9
                        lb0: "\{ind}\{lcb}_t \{nm} = \{lvr0};\n"
                        buf.append lb0
                        emitValueTakeInvalidations :ast :symtab :ctx n: avn9 :ind :buf
                        # a binding from a bare owned local is a MOVE: zero the
                        # source so its scope-exit free no-ops now that this
                        # binding owns the buffer
                        if (isBareNameValue :ast n: avn9) then {
                            lzs0: implicitTakeSource :ast :symtab :ctx n: avn9
                            if lzs0.length > 0 then {
                                lzi0: "\{ind}\{lzs0} = (\{lcb}_t){0};\n"
                                buf.append lzi0
                            }
                        }
                    } else {
                        lcap: listCapArg :ast :symtab :ctx n: avn9
