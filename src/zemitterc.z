# dottedMemberTidOf9 -- the type id a dotted callable's `base.child` names. A
# file-unit base answers through the unit-name index, which also follows
# re-exports; a namespace base is absent from that index by design, so it
# answers off its own type id. 0 when the base names no unit.
dottedMemberTidOf9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    callableId: u32
} out ztypes.tid is {
    baseId9: dottedBaseAtomId :ast n: (ast.nodes.get i: callableId.u64)
    childId9: aliasChildNameId :ast :symtab n: (ast.nodes.get i: callableId.u64)
    if childId9.isZero then return ztypes.tid
    if (baseId9.isZero) == false then {
        if (ztypecheck.isUnitNameDecl ty: symtab.typing reg: symtab.reg nameId: baseId9) then {
            ud1x9: ztypecheck.unitDeclOfNameId ty: symtab.typing nameId: baseId9
            go9: (ztypecheck.resolvedByIds
                :ast
                ty: symtab.typing

                unitDecl: ud1x9
                name: childId9
            )
            match (
                go9
            ) case some then {
                return (ztypes.tid.create from: (go9))
            } case none then null
            return ztypes.tid
        }
    }
    pb9: u32
    {
        cln9: ast.nodes.get i: callableId.u64
        if cln9.dottedpath then pb9 = cln9.parent
    }
    nst9: pathUnitTidOf9 :ast :symtab :ctx baseId: pb9
    if nst9.isZero then return ztypes.tid
    co9: symtab.typing.declChildOfId parentTypeId: nst9 nameId: childId9
    match (
        co9
    ) case some then {
        return (ztypes.tid.create from: (co9))
    } case none then null
    return ztypes.tid
}

