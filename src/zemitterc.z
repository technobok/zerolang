        # the raw-name fallback and the C referenced the alias name. Emit what
        # the dotted read emits.
        if brid > 0 when (bdec9.isZero) == false then {
            btt9: symtab.reg.typetypeOf typeId: brid
            isTag9: false
            if btt9 == ztypes.ztypetype.variantType then isTag9 = true
            if btt9 == ztypes.ztypetype.unionType then isTag9 = true
            if isTag9 then {
                atk9: (ztypecheck.reexportTargetIdsOf
                    ty: symtab.typing
                    :ast
                    declId: bdec9
                )
                if atk9.unitName.u32 > 0 then {
                    arm9: (zast.poolTextAt pool: ast.names ref: atk9.defName)
                    if arm9.length > 0 then {
                        ava9: armValueC :symtab tid: brid arm: arm9.stringview
                        if ava9.length > 0 then return ava9
                        atg9: variantTag :symtab tid: brid arm: arm9.stringview
                        if atg9.length > 0 then {
