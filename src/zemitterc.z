# zemitterc -- the C emitter (Phase C port of src/zemitterc.py).
#
# C1: preamble, String/StringView runtime fragments, string-literal pool,
# user-function emission, and a statement/expression walk covering the
# scalar core (locals, binops, if/for-while, return, recursion) plus
# print of plain and interpolated literals. Unhandled shapes emit marker
# comments AND record an emitFail: zc reports every failure and exits
# nonzero without writing output (no silent degradation).

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :emitC
    :nativeConvRows
}

Node: zast.Node
Ast: zast.Ast


# TmpCtr -- per-function temp name counter.
TmpCtr: class {
    n: u64
    frees: (List String)
    listFrees: (List String)
    listFreeVars: (List String)
    # the VARIABLE of each cleanup entry, beside its emitted identifier: the
    # alias table is keyed by variable, so only this can probe it. 0 for a
    # synthesized temp, which is never a binding and so never aliased.
    freeRaw: (ListVal ztypes.vid)
    listFreeRaw: (ListVal ztypes.vid)
} as {
    next: function {:this} out u64 is {
        v: this.n
        this.n = this.n + 1
        return v
    }
}

# optU64Or9 -- an (optionval t: u64) to a plain u64 (0 when none).
optVidOr9: function {o: optionval ztypes.vid} out ztypes.vid is {
    match (
        o
    ) case some then {
        return o
    } case none then {
        return (ztypes.vid.create from: 0)
    }
}

# optTidOr9 -- the same for an optional TYPE id. A sibling rather than a
# conversion at each call: an `optionval tid` is not an `optionval u64`,
# since a typedef stands in for its base as a whole value, not as a
# generic argument.
optTidOr9: function {o: optionval ztypes.tid} out ztypes.tid is {
    match (
        o
    ) case some then {
        return o
    } case none then {
        return (ztypes.tid.create from: 0)
    }
}

optU64Or9: function {o: optionval u64} out u64 is {
    match (
        o
    ) case some then {
        return o
    } case none then {
        return 0
    }
}

# cnameOf -- the id-based C name base for a type ("z_t{id}_{name}", dots
# joined with underscores). Mirrors the reference's _assign_cname scheme;
# ids differ between the two typecheckers by design.
# opCnameOf -- a C-identifier spelling for an operator method name (a
# typedef's shadowed `==`, a numeric `+`), "" for ordinary names.
opCnameOf: function {name: StringView} out String is {
    if name == "==" then return "op_eq".string
    if name == "!=" then return "op_ne".string
    if name == "<=" then return "op_le".string
    if name == ">=" then return "op_ge".string
    if name == "<" then return "op_lt".string
    if name == ">" then return "op_gt".string
    if name == "+" then return "op_add".string
    if name == "-" then return "op_sub".string
    if name == "*" then return "op_mul".string
    if name == "/" then return "op_div".string
    if name == "%" then return "op_mod".string
    if name == "&" then return "op_and".string
    return "".string
}

cnameOf: function {tid: ztypes.tid ownerName: StringView name: StringView} out String is {
    flat: opCnameOf :name
    if flat.length == 0 then {
        biter: u64
        n: name.length
        for biter < n loop {
            bo: name.byteAt i: biter
            match (
                bo
            ) case some then {
                if bo == 46 then {
                    flat.append "_"
                } else {
                    identB9: false
                    if bo >= 97 when bo <= 122 then identB9 = true
                    if bo >= 65 when bo <= 90 then identB9 = true
                    if bo >= 48 when bo <= 57 then identB9 = true
                    if bo == 95 then identB9 = true
                    if identB9 then {
                        flat.appendByte b: bo
                    } else {
                        flat.append "_"
                    }
                }
            } case none then null
            biter = biter + 1
        }
    }
    if ownerName.length == 0 then return "z_t\{tid}_\{flat}"
    oflat: ownerName.replace needle: "." replacement: "_"
    joined9: "\{oflat}_\{flat}"
    return "z_t\{tid}_\{joined9}"
}

# listCname -- a type's C name base from the table composed once at the start
# of emitC. "" when the id names no registered type.
listCname: function {cnames: (List String).view tid: ztypes.tid} out String is {
    if tid >= cnames.length then return "".string
    got: cnames.get i: tid
    return got.copy
}

# ctxCname -- listCname against the table the emission context carries.
ctxCname: function {ctx: Ctx.view tid: ztypes.tid} out String is {
    return (listCname cnames: ctx.cnames :tid)
}

# atomVid -- the variable a reference node resolves to, or 0.
atomVid: function {symtab: zenv.ZSymbolTable.view nid: u64} out ztypes.vid is {
    return (optVidOr9 o: (symtab.typing.atomVariableId.get key: nid))
}

# defVid -- the variable a binding node introduces, or 0.
defVid: function {symtab: zenv.ZSymbolTable.view nid: u64} out ztypes.vid is {
    return (optVidOr9 o: (symtab.typing.defVariableId.get key: nid))
}

# atomNodeIdDeep9 -- atomNodeId9 through `expression` wrappers, mirroring
# atomTextDeep so an id and a text always describe the same node.
atomNodeIdDeep9: function {ast: Ast.view n: Node.view} out u64 is {
    match (
        n
    ) case expression then {
        return (atomNodeIdDeep9 :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return n.nodeid.u64
    } else {
        return 0
    }
}

# atomVidIfPlain -- the variable an already-emitted value expression names, but
# only when the emitted text is that atom's own source name. An alias
# substitution, a C-keyword mangle or any compound expression makes the text
# something other than the binding, and then there is no variable to ask a
# pointer question about -- which is what a name compare answers by missing.
atomVidIfPlain: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    text: StringView
} out ztypes.vid is {
    match (
        n
    ) case expression then {
        nx9: ast.nodes.get i: n.expression.u64
        return (atomVidIfPlain :ast :symtab :ctx n: nx9 :text)
    } case atomid then {
        at9: zast.nameTextAt :ast ref: n.name
        av9: atomVid :symtab nid: n.nodeid.u64
        ae9: emitLocalAtomName :ctx name: at9.stringview vid: av9
        if ae9.stringview != text then return (ztypes.vid.create from: 0)
        return av9
    } case labelvalue then {
        # the `:name` shorthand names a binding just as a bare atom does
        lv9: zast.nameTextAt :ast ref: n.name
        lvv9: atomVid :symtab nid: n.nodeid.u64
        le9: emitLocalAtomName :ctx name: lv9.stringview vid: lvv9
        if le9.stringview != text then return (ztypes.vid.create from: 0)
        return lvv9
    } case dottedpath then {
        # a dotted path can still emit as its bare base -- a `.private` access
        # marker contributes no C text -- and then the base IS the value passed.
        dbn9: ast.nodes.get i: n.parent.u64
        db9: atomTextOf :ast n: dbn9
        if db9.length == 0 then return (ztypes.vid.create from: 0)
        dbv9: atomVid :symtab nid: (atomNodeId9 n: dbn9)
        de9: emitLocalAtomName :ctx name: db9.stringview vid: dbv9
        if de9.stringview != text then return (ztypes.vid.create from: 0)
        return dbv9
    } else {
        return (ztypes.vid.create from: 0)
    }
}

# paramVidByNameId -- the variable behind parameter `nameId` of the function
# node `op`, or 0. The type checker mints a parameter's variable while walking
# the AST parameter list and stamps it on the node the parameter WRAPS, so read
# it back the same way. The declaration tree cannot supply it: a generic clone
# shares its template's declaration, so a member lookup there answers with one
# node for every parameter alike.
paramVidIn: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    params: (ListVal u32).view
    nameId: zast.nameid
} out ztypes.vid is {
    if nameId.isZero then return (ztypes.vid.create from: 0)
    piter9: params.iterate
    for pmId9: piter9 loop {
        pm9: ast.nodes.get i: pmId9.u64
        match (
            pm9
        ) case namedoperation then {
            if pm9.name == nameId when pm9.operation > 0 then {
                on9: nodeIdOf9 n: (ast.nodes.get i: pm9.operation.u64)
                return (defVid :symtab nid: on9)
            }
        } else null
    }
    return (ztypes.vid.create from: 0)
}

# paramVidByNameId -- paramVidIn reached through the function node.
paramVidByNameId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    op: Node.view
    nameId: zast.nameid
} out ztypes.vid is {
    match (
        op
    ) case expression then {
        opx9: ast.nodes.get i: op.expression.u64
        return (paramVidByNameId :ast :symtab op: opx9 :nameId)
    } case functiondef then {
        return (paramVidIn :ast :symtab params: op.parameters :nameId)
    } else {
        return (ztypes.vid.create from: 0)
    }
}

# cnameById -- a type's default C name: its id alone. The emitted C is a
# build artifact rather than a reading surface, so the source name rides
# along only under --readable-names.
cnameById: function {tid: ztypes.tid} out String is {
    return "z_t\{tid}"
}

# cTypeOf -- the C spelling of a scalar type NAME ("" when not scalar). A NAME is
# not an identity, so this is never the answer on its own: a caller holding a tid
# must go through scalarCTypeFor, which asks the declaration whether the tid is
# the builtin behind the name. shadow-guard holds the count down.
#
# It cannot be retired, and the callers that remain say why. The C spelling has
# to be SOMEWHERE, and the one place it cannot live is the table it helps build:
# convBodyOf reads it to GENERATE the natives.tbl conversion rows, so moving the
# spelling into that table would have the generator reading its own output. The
# rest have no declaration to ask -- two want a scalar-NAME predicate rather than
# a C type, and the others start from a typedef base name or an AST type name,
# with no tid in hand. A caller that still needs a name is a caller with no
# declaration to ask; those are the ones left.
cTypeOf: function {name: StringView} out String is {
    if name == "i8" then return "int8_t".string
    if name == "i16" then return "int16_t".string
    if name == "i32" then return "int32_t".string
    if name == "i64" then return "int64_t".string
    if name == "u8" then return "uint8_t".string
    if name == "u16" then return "uint16_t".string
    if name == "u32" then return "uint32_t".string
    if name == "u64" then return "uint64_t".string
    if name == "i128" then return "__int128".string
    if name == "u128" then return "unsigned __int128".string
    if name == "f16" then return "_Float16".string
    if name == "f32" then return "float".string
    if name == "f64" then return "double".string
    if name == "f128" then return "__float128".string
    if name == "c8" then return "uint8_t".string
    if name == "c32" then return "uint32_t".string
    # A literal type reaches the emitter as the payload of a break-carrying
    # do-block's optionval; both widths need a scalar C spelling, and they
    # take the same defaults foldLiteralStamps folds surviving stamps to.
    if name == "literal_int" then return "int64_t".string
    if name == "literal_float" then return "double".string
    return "".string
}

# cFloatLitSuffix -- the C literal suffix that parses a float literal at
# the named width (single rounding): f (float), f16 (_Float16), Q
# (__float128); f64 literals stay bare (double).
cFloatLitSuffix: function {name: StringView} out String is {
    if name == "f32" then return "f".string
    if name == "f16" then return "f16".string
    if name == "f128" then return "Q".string
    return "".string
}

# isFloatLitText -- the expression text is a bare digit-led float literal
# (decimal point or exponent; no identifier characters).
isFloatLitText: function {s: StringView} out bool is {
    n: s.length
    if n == 0 then return false
    b0: s.byteAt 0
    match (
        b0
    ) case some then {
        if b0 < 48 then return false
        if b0 > 57 then return false
    } case none then {
        return false
    }
    hasDotE: false
    i: u64
    for i < n loop {
        bo: s.byteAt i
        match (
            bo
        ) case some then {
            ok: false
            if bo >= 48 when bo <= 57 then ok = true
            if bo == 46 then {
                ok = true
                hasDotE = true
            }
            if bo == 101 then {
                ok = true
                hasDotE = true
            }
            if bo == 69 then {
                ok = true
                hasDotE = true
            }
            if bo == 43 then ok = true
            if bo == 45 then ok = true
            if ok == false then return false
        } case none then {
            return false
        }
        i = i + 1
    }
    return hasDotE
}

# scalarTidIsBuiltin -- asked only where cTypeOf has already matched the NAME:
# is this tid the runtime-backed type behind that name, or a USER type wearing
# it? The DECLARATION answers it. The sixteen scalars are `record is native` and
# the two literal pseudo-types are minted by the registry itself, so the marker
# covers eighteen of cTypeOf's nineteen names; a user's `i64: record { hi: 0 }`
# carries no marker and is a shadow. `bool` carries it too: the grammar gives
# `is native`
# only to a type with no is-block -- and `bool` is a native VARIANT, which keeps
# its arms, so the marker covers all nineteen.
#
# A tid with no defining unit is a SHELL -- a fresh param/field child named
# after the real type -- not a user type wearing the name. There is no
# declaration there to shadow with, so it keeps the C scalar, which is what the
# unit-name predicate this replaced did with an empty name and what typeRefC
# has always said about shells. Asked of the declaration directly rather than
# through its unit's name, which is the same question one step earlier.
scalarTidIsBuiltin: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out bool is {
    if (symtab.reg.isNativeOf tid: (ztypes.tid.create from: tid.u64)) then return true
    dc9: symtab.typing.declIdOfType typeId: (ztypes.tid.create from: tid.u64)
    return dc9.isZero
}

# ordinalVariantCType -- the C scalar a VARIANT lowers to instead of a tag
# struct, "" when it needs one. A variant whose arms all carry no payload is an
# ordinal: nothing distinguishes one value from another but which arm it is, so
# a tagged struct carries nothing. TWO ordinals are exactly C `bool`. The
# checker records the shape, discriminator included, so this asks what the type
# IS rather than what it is called -- `bool` is the stdlib instance of the
# shape, and a user variant of the same shape gets the same C.
#
# Three-and-more-arm ordinals are the same argument and still get the struct;
# unwrapping those changes the C type every field, param and local of them is
# spelled with, which is its own change.
ordinalVariantCType: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out String is {
    ao9: symtab.typing.ordinalVariant.get key: tid.u64
    match (
        ao9
    ) case some then {
        if ao9 == 2 then return "bool".string
        # every recorded ordinal has a u8 discriminator BY CONSTRUCTION: the
        # checker only records one whose values are the arm ordinals, which is
        # the spec's default (u8, sequential from 0) or an explicit u8
        return "uint8_t".string
    } case none then {
        return "".string
    }
}

# tagStorageCType -- the C type a tagged type's DISCRIMINATOR is stored in, from
# what the declaration asked for (`tag: u8.tag`, or the spec's u8 default). The
# enum stays for the constants; it just stops being the storage, because a C
# enum is `int` and spelling the field with it ignores the declaration -- a
# `tag: u8.tag` was silently four bytes.
#
# "" when the type declares a `data`-sourced tag, whose constants set their own
# width, or when nothing was recorded: the enum remains the storage there.
tagStorageCType: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out String is {
    key9: tid.u64
    # a MONO carries no declaration of its own: the template it was minted from
    # is where the tag was declared, and the instance stores it the same way
    {
        go9: genericOriginOf9 :symtab :tid
        if go9 > 0 then {
            hasOwn9: false
            {
                o9: symtab.typing.variantTagBase.get key: tid.u64
                match (
                    o9
                ) case some then {
                    hasOwn9 = true
                } case none then null
            }
            if (hasOwn9) == false then key9 = go9.u64
        }
    }
    tb9: symtab.typing.variantTagBase.get key: key9
    match (
        tb9
    ) case some then {
        # 0 is a data-sourced tag: its constants set their own width, so the
        # enum stays the storage
        if tb9 == 0 then return "".string
        # BIND the name: typeNameOfReg9 hands back an OWNED copy, and taking a
        # view of it inline leaves the copy with no owner to free it.
        tn9: typeNameOfReg9 :symtab tid: (ztypes.tid.create from: tb9.u64)
        # scalarCTypeFor, not cTypeOf: the tid is in hand, so a user type
        # shadowing a numeric name must not pick up that numeric's C spelling
        return (scalarCTypeFor
            :symtab
            name: tn9.stringview
            tid: (ztypes.tid.create from: tb9.u64)
        )
    } case none then {
        # nothing declared: the spec's default, u8
        return "uint8_t".string
    }
}

# isOrdinalVariant -- the value IS its own discriminator: no tag field to read,
# no struct to compose, and `==` rather than a comparator.
#
# Reads the record rather than asking ordinalVariantCType and measuring what it
# says: this is a QUESTION, asked 11503 times in a self-compile, and building a
# string to answer it allocated once per ask.
isOrdinalVariant: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    ao9: symtab.typing.ordinalVariant.get key: tid.u64
    match (
        ao9
    ) case some then {
        return true
    } case none then {
        return false
    }
}

# isOrdinalPair -- an ordinal with exactly TWO arms, which is a C `bool` and so
# answers to truthiness: the second arm is the value, the first its negation.
# Distinct from isOrdinalVariant, which is about there being no tag field --
# every ordinal loses the field, only a pair gains `x` / `!x`.
isOrdinalPair: function {symtab: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    ao9: symtab.typing.ordinalVariant.get key: tid.u64
    match (
        ao9
    ) case some then {
        return ao9 == 2
    } case none then {
        return false
    }
}

# ordinalPairFirstArmId -- the name-pool id of an ordinal pair's FIRST arm:
# ordinal 0, and so the false side of the C `bool`. `bool` writes `false` first
# for exactly this reason, and a user variant decides it the same way -- by the
# order it writes its arms. 0 when `tid` is not an ordinal pair.
#
# An id rather than the text, because the callers ask an IDENTITY question --
# is this arm the false one -- and rendering the name to answer it allocated a
# String once per ask. Read from what the checker recorded, never walked: an
# arm walk is a member walk, and forcing one during emission demands members
# the program never asked for.
ordinalPairFirstArmId: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out u64 is {
    if (isOrdinalPair :symtab :tid) == false then return 0
    fa9: symtab.typing.sumPairFirstArm.get key: tid.u64
    match (
        fa9
    ) case some then {
        return fa9
    } case none then {
        return 0
    }
}

# scalarCTypeFor -- the C scalar type for a builtin-named tid, BUT empty when the
# tid is a user type SHADOWING the scalar. The caller then emits the user struct
# (typeRefC / cnameOf) instead of the C scalar. The single "trust the canonical
# id, not the name" gate for the by-name C-type sites.
scalarCTypeFor: function {
    symtab: zenv.ZSymbolTable.view
    name: StringView
    tid: ztypes.tid
} out String is {
    if (isOrdinalVariant :symtab tid: (ztypes.tid.create from: tid.u64)) then {
        return (ordinalVariantCType :symtab tid: (ztypes.tid.create from: tid.u64))
    }
    sc: cTypeOf :name
    if sc.length == 0 then return sc
    if (scalarTidIsBuiltin :symtab tid: (ztypes.tid.create from: tid.u64)) == false then {
        return "".string
    }
    return sc
}

# isIntName -- integer scalar family check (snprintf %ld path).
isIntName: function {name: StringView} out bool is {
    if name == "i8" then return true
    if name == "i16" then return true
    if name == "i32" then return true
    if name == "i64" then return true
    if name == "u8" then return true
    if name == "u16" then return true
    if name == "u32" then return true
    if name == "u64" then return true
    if name == "i128" then return true
    if name == "u128" then return true
    if name == "c8" then return true
    if name == "c32" then return true
    if name == "bool" then return true
    return false
}

# true when `name` is a floating-point type name.
isFloatName: function {name: StringView} out bool is {
    if name == "f16" then return true
    if name == "f32" then return true
    if name == "f64" then return true
    if name == "f128" then return true
    return false
}

# numBits -- integer numeric type bit width (0 if not an integer type).
numBits: function {name: StringView} out u64 is {
    if name == "i8" then return 8
    if name == "u8" then return 8
    if name == "c8" then return 8
    if name == "i16" then return 16
    if name == "u16" then return 16
    if name == "i32" then return 32
    if name == "u32" then return 32
    if name == "c32" then return 32
    if name == "i64" then return 64
    if name == "u64" then return 64
    if name == "i128" then return 128
    if name == "u128" then return 128
    return 0
}

# numSigned -- true for the signed integer family.
numSigned: function {name: StringView} out bool is {
    if name == "i8" then return true
    if name == "i16" then return true
    if name == "i32" then return true
    if name == "i64" then return true
    if name == "i128" then return true
    return false
}

# numLoStr / numHiStr -- decimal range bounds, the comparands of the
# overflow check emitted on a narrowing cast.
numLoStr: function {name: StringView} out String is {
    if name == "i8" then return "-128".string
    if name == "i16" then return "-32768".string
    if name == "i32" then return "-2147483648".string
    if name == "i64" then return "(-9223372036854775807LL - 1)".string
    if name == "i128" then return "(-(__int128)((((unsigned __int128)0x7FFFFFFFFFFFFFFFULL) << 64) | 0xFFFFFFFFFFFFFFFFULL) - 1)".string
    return "0".string
}
# the maximum-value literal (as C text) for numeric type `name`.
numHiStr: function {name: StringView} out String is {
    if name == "i8" then return "127".string
    if name == "i16" then return "32767".string
    if name == "i32" then return "2147483647".string
    if name == "i64" then return "9223372036854775807".string
    if name == "i128" then return "((__int128)((((unsigned __int128)0x7FFFFFFFFFFFFFFFULL) << 64) | 0xFFFFFFFFFFFFFFFFULL))".string
    if name == "u8" then return "255".string
    if name == "c8" then return "255".string
    if name == "u16" then return "65535".string
    if name == "u32" then return "4294967295U".string
    if name == "c32" then return "4294967295U".string
    if name == "u64" then return "18446744073709551615ULL".string
    if name == "u128" then return "(~(unsigned __int128)0)".string
    return "0".string
}

# numLitSuffix -- the C integer-literal suffix for an unsigned type, so a large
# decimal literal (e.g. u64 max) is unambiguously unsigned to the C compiler.
numLitSuffix: function {name: StringView} out String is {
    if name == "u64" then return "ULL".string
    if name == "u32" then return "U".string
    if name == "c32" then return "U".string
    return "".string
}

# castLitVal -- val with the unsigned C suffix appended when it is a bare decimal
# literal cast to an unsigned type, so large u64 constants don't warn as signed.
castLitVal: function {val: StringView dstName: StringView} out String is {
    r: val.string
    sfx: numLitSuffix name: dstName
    if sfx.length == 0 then return r
    if val.length == 0 then return r
    allDig: true
    i: u64
    n: val.length
    for i < n loop {
        bo: val.byteAt :i
        match (
            bo
        ) case some then {
            if bo < 48 then allDig = false
            if bo > 57 then allDig = false
        } case none then null
        i = i + 1
    }
    if allDig then r.append sfx
    return r
}

# numMantissa -- the significand width of a float type (0 if not one). A
# conversion INTO a float is exact only while the source's magnitude fits here.
numMantissa: function {name: StringView} out u64 is {
    if name == "f16" then return 11
    if name == "f32" then return 24
    if name == "f64" then return 53
    if name == "f128" then return 113
    return 0
}

# convIsLossy -- whether `<src>.<dst>` can lose information, which is exactly
# what decides the DECLARED return: the units give a lossy conversion a
# `resultval` and a provably-safe one the target type itself. Identity and
# widening within a signedness are safe; a signed source never fits an unsigned
# target; an unsigned one needs a strictly wider signed target; and a float
# target must have significand enough for the source's whole width.
# natives-tbl-guard checks this against the declarations, so the two encodings
# of the rule cannot drift apart.
convIsLossy: function {srcName: StringView dstName: StringView} out bool is {
    if srcName == dstName then return false
    sf9: isFloatName name: srcName
    df9: isFloatName name: dstName
    if sf9 then {
        if df9 then return (numMantissa name: srcName) > (numMantissa name: dstName)
        return true
    }
    if df9 then return (numBits name: srcName) > (numMantissa name: dstName)
    sb9: numBits name: srcName
    db9: numBits name: dstName
    ss9: numSigned name: srcName
    ds9: numSigned name: dstName
    if ss9 == ds9 then return sb9 > db9
    if ss9 then return true
    return sb9 >= db9
}

# convBodyOf -- the C natives.tbl gives for the conversion `<src>.<dst>`, as a
# row body. This is the SAME derivation emitNumericCast and emitNumericCastResult
# run -- numBits, numSigned, numLoStr, numHiStr -- so the checked-in rows cannot
# say anything the rule does not; natives-tbl-guard regenerates and diffs to keep
# it that way. `lossy` follows the DECLARATION: a conversion the units declare as
# returning `resultval` builds one, and one returning the type directly is a
# plain cast, so the table and the declaration agree by construction.
convBodyOf: function {srcName: StringView dstName: StringView lossy: bool} out String is {
    scT: cTypeOf name: srcName
    tcT: cTypeOf name: dstName
    if (lossy) == false then {
        d9: "((\{tcT})@V@)"
        return d9
    }
    okSet: "_r.tag = @OKTAG@; _r.data.ok = (\{tcT})_v;"
    sFloat: isFloatName name: srcName
    dFloat: isFloatName name: dstName
    body: String
    if sFloat then {
        if dFloat then {
            errInf: "_r.tag = @ERRTAG@; _r.data.err@TAG_converror@ = Z_CONVERROR_TAG_OUTOFRANGE;"
            errPrecF: "_r.tag = @ERRTAG@; _r.data.err@TAG_converror@ = Z_CONVERROR_TAG_PRECISIONLOSS;"
            okF: "_r.tag = @OKTAG@; _r.data.ok = _f;"
            body = "\{tcT} _f = (\{tcT})_v; if (isinf(_f) && !isinf(_v)) { \{errInf} } else if ((\{scT})_f != _v) { \{errPrecF} } else { \{okF} }"
        } else {
            b: numBits name: dstName
            dsig: numSigned name: dstName
            inRange: String
            if dsig then {
                bm1: b - 1
                inRange = "(_v >= -0x1p\{bm1} && _v < 0x1p\{bm1})"
            } else {
                inRange = "(_v >= 0.0 && _v < 0x1p\{b})"
            }
            errOor: "_r.tag = @ERRTAG@; _r.data.err@TAG_converror@ = Z_CONVERROR_TAG_OUTOFRANGE;"
            errPrecI: "_r.tag = @ERRTAG@; _r.data.err@TAG_converror@ = Z_CONVERROR_TAG_PRECISIONLOSS;"
            body = "if (!\{inRange}) { \{errOor} } else if ((double)(\{tcT})_v != (double)_v) { \{errPrecI} } else { \{okSet} }"
        }
    } else {
        if dFloat then {
            p9: 53
            if dstName == "f32" then p9 = 24
            if dstName == "f16" then p9 = 11
            if dstName == "f128" then p9 = 113
            rangeAnd9: ""
            if dstName == "f16" then rangeAnd9 = " && _mag <= 65504"
            ssig: numSigned name: srcName
            errPrecX: "_r.tag = @ERRTAG@; _r.data.err@TAG_converror@ = Z_CONVERROR_TAG_PRECISIONLOSS;"
            is128s9: false
            if srcName == "i128" then is128s9 = true
            if srcName == "u128" then is128s9 = true
            if is128s9 then {
                magExpr2: String
                if ssig then {
                    magExpr2 = "(_v < 0 ? (unsigned __int128)(0 - (unsigned __int128)_v) : (unsigned __int128)_v)".string
                } else {
                    magExpr2 = "(unsigned __int128)_v".string
                }
                body = "unsigned __int128 _mag = \{magExpr2}; uint64_t _mh = (uint64_t)(_mag >> 64); uint64_t _ml = (uint64_t)_mag; int _bl = _mh ? (128 - __builtin_clzll(_mh)) : (_ml ? 64 - __builtin_clzll(_ml) : 0); int _tz = _ml ? __builtin_ctzll(_ml) : (_mh ? 64 + __builtin_ctzll(_mh) : 0); if (_mag == 0 || ((_bl - _tz) <= \{p9}\{rangeAnd9})) { \{okSet} } else { \{errPrecX} }"
            } else {
                magExpr: String
                if ssig then {
                    magExpr = "(_v < 0 ? (uint64_t)(0 - (uint64_t)_v) : (uint64_t)_v)".string
                } else {
                    magExpr = "(uint64_t)_v".string
                }
                body = "uint64_t _mag = \{magExpr}; if (_v == 0 || ((64 - __builtin_clzll(_mag) - __builtin_ctzll(_mag)) <= \{p9}\{rangeAnd9})) { \{okSet} } else { \{errPrecX} }"
            }
        } else {
            needsLo: true
            needsHi: true
            sbits: numBits name: srcName
            dbits: numBits name: dstName
            ssig: numSigned name: srcName
            dsig: numSigned name: dstName
            if ssig then {
                if dsig then {
                    if sbits <= dbits then needsLo = false
                }
            } else {
                needsLo = false
            }
            if ssig == dsig then {
                if sbits <= dbits then needsHi = false
            } else {
                if ssig then {
                    if sbits <= dbits then needsHi = false
                } else {
                    if sbits < dbits then needsHi = false
                }
            }
            cond: String
            if needsLo then {
                if needsHi then {
                    lo: numLoStr name: dstName
                    hi: numHiStr name: dstName
                    cond = "_v < \{lo} || _v > \{hi}"
                } else {
                    lo2: numLoStr name: dstName
                    cond = "_v < \{lo2}"
                }
            } else {
                if needsHi then {
                    hi2: numHiStr name: dstName
                    cond = "_v > \{hi2}"
                } else {
                    cond = "0".string
                }
            }
            errOor2: "_r.tag = @ERRTAG@; _r.data.err@TAG_converror@ = Z_CONVERROR_TAG_OUTOFRANGE;"
            body = "if (\{cond}) { \{errOor2} } else { \{okSet} }"
        }
    }
    r: "({ \{scT} _v = @V@; z_@RT@_t _r = {0}; \{body} _r; })"
    return r
}

# nativeConvRows -- the conversions section of natives.tbl, generated from the
# rule rather than written by hand: 256 pairs, and a bound written wrong on a
# pair no program happens to use is not something the corpus can catch.
# natives-tbl-guard regenerates this and diffs it against the checked-in file,
# so the table is provably the rule's own output.
nativeConvRows: function out String is {
    order: (List String)
    order.append from: "u8".string
    order.append from: "c8".string
    order.append from: "c32".string
    order.append from: "i8".string
    order.append from: "i16".string
    order.append from: "i32".string
    order.append from: "i64".string
    order.append from: "u16".string
    order.append from: "u32".string
    order.append from: "u64".string
    order.append from: "f32".string
    order.append from: "f64".string
    order.append from: "i128".string
    order.append from: "u128".string
    order.append from: "f16".string
    order.append from: "f128".string
    buf: String
    si9: u64
    n9: order.length
    for si9 < n9 loop {
        s9: order.get i: si9
        si9 = si9 + 1
        hdr9: "\n# system.\{s9} conversions\n"
        buf.append hdr9
        di9: u64
        for di9 < n9 loop {
            d9: order.get i: di9
            di9 = di9 + 1
            lo9: convIsLossy srcName: s9.stringview dstName: d9.stringview
            bd9: (convBodyOf
                srcName: s9.stringview
                dstName: d9.stringview
                lossy: lo9
            )
            key9: "[system.\{s9}.\{d9}]"
            pad9: key9.copy
            for pad9.length < 30 loop pad9.append " "
            row9: "\{pad9} \{bd9}\n"
            buf.append row9
        }
    }
    # `print` supplies the final newline, so the last row must not carry one:
    # the guard diffs this output against the checked-in section byte for byte.
    if buf.length > 0 then {
        cut9: buf.stringview.substring from: 0 to: (buf.length - 1)
        return cut9.string
    }
    return buf
}

# emitNumericCast -- a runtime numeric conversion `<val>.<dstName>`, filled from
# the natives.tbl row its qualified path names. The row already IS the derivation
# -- it was generated by it -- so the C is read rather than rebuilt here, and the
# declaration's return type decides only which bindings the row needs: a lossy
# conversion's row spells the resultval mono and its two tags.
emitNumericCast: function {
    ctx: Ctx.view
    dstName: StringView
    val: StringView
    symtab: zenv.ZSymbolTable.view
    retTid: ztypes.tid
    key: StringView
} out String is {
    if (isFloatName name: dstName) then {
        # a bare float-literal operand re-parses at the destination width
        # via the C literal suffix (single rounding, full precision). A LITERAL
        # concern, not a conversion one: there is no value to convert yet.
        if (isFloatLitText s: val) then {
            fl9: cFloatLitSuffix name: dstName
            return "\{val}\{fl9}"
        }
    }
    body9: nativeImplOf :ctx path: key
    if body9.length == 0 then {
        emitFail :ctx what: "no native implementation for '\{key}'" line: 0
        return "/* zemitterc: no native implementation */0".string
    }
    # a lossy conversion builds a `resultval`; the row spells the tags and the
    # mono's name, and the DECLARATION is what decided which shape it is
    resOrig9: monoOriginName :symtab tid: retTid
    bn9: (List String)
    bv9: (List String)
    rn9: (List String)
    rv9: (List String)
    if resOrig9.stringview == "resultval" then {
        bn9.append from: "RT".string
        bv9.append from: (ctxCname :ctx tid: retTid)
        rn9.append from: "OKTAG".string
        rv9.append from: (variantTag :symtab tid: retTid arm: "ok")
        rn9.append from: "ERRTAG".string
        rv9.append from: (variantTag :symtab tid: retTid arm: "err")
        # the error slot's assignment, spelled for whatever `converror` IS
        if (ctx.converrorTid.isZero) == false then {
            rn9.append from: "TAG_converror".string
            if (isOrdinalVariant :symtab tid: ctx.converrorTid) then {
                rv9.append from: "".string
            } else {
                rv9.append from: ".tag".string
            }
        }
        rn9.append from: "V".string
        rv9.append from: val.string
    } else {
        sval9: castLitVal :val :dstName
        rn9.append from: "V".string
        rv9.append from: sval9.copy
    }
    return (fillHolesCtx9
        :ctx
        text: body9
        path: key
        bindNames: bn9
        bindVals: bv9
        rawNames: rn9
        rawVals: rv9
    )
}

# emitNumericCastDead9 -- unreachable remnant, deleted below
# cUpperOf -- ASCII upper-case for tag spellings.
cUpperOf: function {text: StringView} out String is {
    buf: String
    i: u64
    n: text.length
    for i < n loop {
        bo: text.byteAt :i
        match (
            bo
        ) case some then {
            if bo >= 97 then {
                if bo <= 122 then {
                    buf.appendByte b: bo - 32
                } else {
                    buf.appendByte b: bo
                }
            } else {
                buf.appendByte b: bo
            }
        } case none then null
        i = i + 1
    }
    return buf
}

# cEscape -- escape literal text for a C string body.
cEscape: function {text: StringView} out String is {
    buf: String
    i: u64
    n: text.length
    for i < n loop {
        bo: text.byteAt :i
        match (
            bo
        ) case some then {
            if bo == 92 then {
                buf.append "\\\\"
            } else if bo == 34 then {
                buf.append "\\\""
            } else if bo == 10 then {
                buf.append "\\n"
            } else if bo == 9 then {
                buf.append "\\t"
            } else {
                buf.appendByte b: bo
            }
        } case none then null
        i = i + 1
    }
    return buf
}

# substituteAll -- replace every occurrence of needle in text.
substituteAll: function {text: String needle: StringView repl: StringView} out String is {
    buf: String
    pos: u64
    total: text.length
    for pos < total loop {
        remv: (text.substring from: pos to: total)
        fo: remv.indexOf :needle
        match (
            fo
        ) case some then {
            pre: (remv.substring from: 0 to: fo)
            buf.append pre
            buf.append repl
            pos = pos + fo + needle.length
        } case none then {
            buf.append remv
            pos = total
        }
    }
    return buf
}

# holeNames9 -- every distinct `@Name@` hole in a fragment, in first-seen
# order: the holes a fragment spells ARE its demand. `@@KEY@@` template keys
# are opaque, so the mixed z_str.c.tmpl (which spells both) never reads the
# `@NAME@` inside a `@@NAME@@` as a hole.
holeNames9: function {text: StringView} out (List String) is {
    names: (List String)
    pos: u64
    total: text.length
    for pos < total loop {
        rem9: text.substring from: pos to: total
        ao9: rem9.indexOf needle: "@"
        match (
            ao9
        ) case some then {
            at9: pos + ao9
            dbl9: false
            {
                nx9: text.byteAt i: (at9 + 1)
                match (
                    nx9
                ) case some then {
                    if nx9 == 64 then dbl9 = true
                } case none then null
            }
            if dbl9 then {
                aft9: text.substring from: (at9 + 2) to: total
                cl9: aft9.indexOf needle: "@@"
                match (
                    cl9
                ) case some then {
                    pos = ((at9 + 2) + cl9) + 2
                } case none then {
                    pos = at9 + 2
                }
            } else {
                sub9: text.substring from: (at9 + 1) to: total
                ho9: sub9.indexOf needle: "@"
                match (
                    ho9
                ) case some then {
                    endn9: (at9 + 1) + ho9
                    nm9: text.substring from: (at9 + 1) to: endn9
                    seen9: false
                    si9: u64
                    sn9: names.length
                    for si9 < sn9 loop {
                        e9: names.get i: si9
                        if e9.stringview == nm9 then seen9 = true
                        si9 = si9 + 1
                    }
                    if seen9 == false then names.append from: nm9.string
                    pos = endn9 + 1
                } case none then {
                    pos = at9 + 1
                }
            }
        } case none then {
            pos = total
        }
    }
    return names
}

# hasHole9 -- true when an unfilled single-`@` hole survives. `@@KEY@@` keys
# are opaque here too, so a template key still awaiting applyTmpl does not
# read as a hole.
hasHole9: function {text: StringView} out bool is {
    pos: u64
    total: text.length
    for pos < total loop {
        rem9: text.substring from: pos to: total
        ao9: rem9.indexOf needle: "@"
        match (
            ao9
        ) case some then {
            at9: pos + ao9
            dbl9: false
            {
                nx9: text.byteAt i: (at9 + 1)
                match (
                    nx9
                ) case some then {
                    if nx9 == 64 then dbl9 = true
                } case none then null
            }
            if dbl9 then {
                aft9: text.substring from: (at9 + 2) to: total
                cl9: aft9.indexOf needle: "@@"
                match (
                    cl9
                ) case some then {
                    pos = ((at9 + 2) + cl9) + 2
                } case none then {
                    pos = at9 + 2
                }
            } else {
                return true
            }
        } case none then {
            pos = total
        }
    }
    return false
}

# bindLookup9 -- the text a hole fills with. A CNAME binding fills with the
# bound name minus its `z_` prefix, because the body spells that prefix itself
# (`z_@File@_t`), and a value carrying no `z_` is a canon that resolved to
# nothing -- reported as fatal at the fill site. A RAW binding fills verbatim:
# an emitted operand is an arbitrary C expression, not a type's name, so the
# prefix rule would be a lie about it. Cnames are consulted first; a name in
# neither list is fatal.
# bindHas9 -- is `name` bound at all? Separate from its VALUE, because a hole
# may legitimately fill with NOTHING: `@TAG_X@` is `.tag` while X is a tagged
# struct and empty once X is unwrapped, and "" from bindLookup9 alone cannot be
# told from a hole nobody bound.
bindHas9: function {
    name: StringView
    bindNames: (List String).view
    rawNames: (List String).view
} out bool is {
    with bit9: bindNames.iterate do for k9: bit9 loop {
        if k9.stringview == name then return true
    }
    with rit9: rawNames.iterate do for rk9: rit9 loop {
        if rk9.stringview == name then return true
    }
    return false
}

bindLookup9: function {
    name: StringView
    bindNames: (List String)
    bindVals: (List String)
    rawNames: (List String)
    rawVals: (List String)
} out String is {
    bi9: u64
    bn9: bindNames.length
    for bi9 < bn9 loop {
        k9: bindNames.get i: bi9
        if k9.stringview == name then {
            v9: bindVals.get i: bi9
            vv9: v9.stringview
            if (vv9.startsWith prefix: "z_") == false then return "".string
            rest9: vv9.substring from: 2 to: vv9.length
            return rest9.string
        }
        bi9 = bi9 + 1
    }
    ri9: u64
    rn9: rawNames.length
    for ri9 < rn9 loop {
        rk9: rawNames.get i: ri9
        if rk9.stringview == name then {
            rv9: rawVals.get i: ri9
            return rv9.copy
        }
        ri9 = ri9 + 1
    }
    return "".string
}

# fillHoles -- fill every `z_@Name@` hole in a runtime fragment from the
# caller's bindings. The single substitution pass for every fragment loader:
# it scans once, so no needle order can matter, and `@@KEY@@` template keys
# pass through untouched for applyTmpl. Every failure is fatal and names the
# fragment and the hole.
fillHoles: function {
    text: String
    path: StringView
    bindNames: (List String)
    bindVals: (List String)
    rawNames: (List String)
    rawVals: (List String)
    fails: List String
} out String is {
    buf: String
    tv9: text.stringview
    total: tv9.length
    pos: u64
    bad9: false
    for pos < total loop {
        rem9: tv9.substring from: pos to: total
        ao9: rem9.indexOf needle: "@"
        match (
            ao9
        ) case some then {
            pre9: rem9.substring from: 0 to: ao9
            buf.append pre9
            at9: pos + ao9
            dbl9: false
            {
                nx9: tv9.byteAt i: (at9 + 1)
                match (
                    nx9
                ) case some then {
                    if nx9 == 64 then dbl9 = true
                } case none then null
            }
            if dbl9 then {
                aft9: tv9.substring from: (at9 + 2) to: total
                cl9: aft9.indexOf needle: "@@"
                match (
                    cl9
                ) case some then {
                    ex9: ((at9 + 2) + cl9) + 2
                    run9: tv9.substring from: at9 to: ex9
                    buf.append run9
                    pos = ex9
                } case none then {
                    buf.append "@@"
                    pos = at9 + 2
                }
            } else {
                sub9: tv9.substring from: (at9 + 1) to: total
                ho9: sub9.indexOf needle: "@"
                match (
                    ho9
                ) case some then {
                    endn9: (at9 + 1) + ho9
                    nm9: tv9.substring from: (at9 + 1) to: endn9
                    val9: bindLookup9 name: nm9 :bindNames :bindVals :rawNames :rawVals
                    if (bindHas9 name: nm9 :bindNames :rawNames) then {
                        buf.append val9
                    } else {
                        fh9: "fragment \{path}: hole @\{nm9}@ is bound to nothing"
                        fails.append from: fh9
                        bad9 = true
                        buf.append "@"
                        buf.append nm9
                        buf.append "@"
                    }
                    pos = endn9 + 1
                } case none then {
                    fu9: "fragment \{path}: unterminated hole"
                    fails.append from: fu9
                    bad9 = true
                    buf.append "@"
                    pos = at9 + 1
                }
            }
        } case none then {
            buf.append rem9
            pos = total
        }
    }
    if bad9 == false then {
        if (hasHole9 text: buf.stringview) then {
            fr9: "fragment \{path}: a hole survived the fill"
            fails.append from: fr9
        }
    }
    return buf
}

# fillHolesCtx9 -- fillHoles for every loader that holds a Ctx: the fill's
# failures are reported through the emit-failure channel, so a bad fragment
# fails the run. The three unconditional loads in emitC run before Ctx exists
# and drain fillHoles' sink into their own fails list instead.
fillHolesCtx9: function {
    ctx: Ctx.view
    text: String
    path: StringView
    bindNames: (List String)
    bindVals: (List String)
    rawNames: (List String)
    rawVals: (List String)
} out String is {
    ferr9: (List String)
    cur9: (fillHoles
        :text
        :path
        :bindNames
        :bindVals
        :rawNames
        :rawVals
        fails: ferr9
    )
    fi9: u64
    fn9: ferr9.length
    for fi9 < fn9 loop {
        m9: ferr9.get i: fi9
        emitFail :ctx what: m9.copy line: 0
        fi9 = fi9 + 1
    }
    return cur9
}


# readTemplateCached -- the raw text of a runtime template file, read once
# per emit and cached by path. A missing file is fatal and reported once (the
# "" is cached so the read is not retried); no fragment on disk is empty, so a
# cached "" is unambiguously the missing-file path.
readTemplateCached: function {ctx: Ctx path: StringView} out String is {
    cached9: String
    hit9: false
    {
        got: ctx.tmplCache.get key: path.string
        match (
            got
        ) case some then {
            cached9 = got.copy
            hit9 = true
        } case none then null
    }
    if hit9 then return cached9
    txt: String
    rd: io.readText :path
    match (
        rd
    ) case ok then {
        txt = rd.take
    } case err then {
        emitFail :ctx what: "missing runtime template \{path}" line: 0
    }
    ctx.tmplCache.set key: path.string value: txt.copy
    return txt
}

# loadNativeTbl -- parse natives.tbl into the three row tables. A row is
# `[<path> attr=value ...] <body>`; `#` starts a comment and blank lines are
# skipped. Read through readTemplateCached, which caches it and reports a
# missing file as an emission failure -- the table is not optional, so a
# program that cannot find it fails rather than falling back to something.
loadNativeTbl: function {ctx: Ctx runtimeDir: StringView} is {
    p9: "\{runtimeDir}/natives.tbl"
    txt9: readTemplateCached :ctx path: p9.stringview
    if txt9.length == 0 then return
    with lit9: txt9.stringview.lines do for ln9: lit9 loop {
        t9: ln9.trim
        if t9.length > 0 when (t9.startsWith prefix: "#") == false then {
            if (t9.startsWith prefix: "[") then {
                co9: t9.indexOf needle: "]"
                match (
                    co9
                ) case some then {
                    head9: t9.substring from: 1 to: co9
                    rest9: t9.substring from: (co9 + 1) to: t9.length
                    body9: rest9.trim
                    key9: String
                    need9: String
                    frag9: String
                    dem9: String
                    ord9: String
                    ptr9: false
                    with fit9: (head9.split sep: " ") do for f9: fit9 loop {
                        if f9.length > 0 then {
                            if key9.length == 0 then {
                                key9 = f9.string
                            } else {
                                if f9 == "args=ptr" then ptr9 = true
                                fo9: f9.stripPrefix p: "frag="
                                match (
                                    fo9
                                ) case some then {
                                    frag9 = fo9.string
                                } case none then null
                                do9: f9.stripPrefix p: "demand="
                                match (
                                    do9
                                ) case some then {
                                    dem9 = do9.string
                                } case none then null
                                so9: f9.stripPrefix p: "needs="
                                match (
                                    so9
                                ) case some then {
                                    need9 = so9.string
                                } case none then null
                                oo9: f9.stripPrefix p: "order="
                                match (
                                    oo9
                                ) case some then {
                                    ord9 = oo9.string
                                } case none then null
                            }
                        }
                    }
                    if key9 == "@units" then {
                        # not a row: the order the units' runtimes run in
                        with oit9: (ord9.stringview.split sep: ",") do for ou9: oit9 loop {
                            if ou9.length > 0 then ctx.unitOrder.append from: ou9.string
                        }
                        key9 = "".string
                    }
                    if key9.length > 0 then {
                    kk9: key9.copy
                    ctx.nativeKeys.set key: kk9 value: true
                        # a conversion path is <unit>.<type>.<type>: three segments whose last
                        # is an identifier, AND it carries a body. A fragment-backed row has
                        # three segments too -- io.File.close -- and must not make `close` read
                        # as a conversion member, which is what routed a File close through the
                        # numeric cast.
                        if body9.length > 0 then {
                            d19: key9.stringview.indexOf needle: "."
                            match (
                                d19
                            ) case some then {
                                rest19: key9.stringview.substring from: (d19 + 1) to: key9.length
                                d29: rest19.indexOf needle: "."
                                match (
                                    d29
                                ) case some then {
                                    pre9: key9.stringview.substring from: 0 to: ((d19 + 1) + d29)
                                    mem9: rest19.substring from: (d29 + 1) to: rest19.length
                                    if (isBareCName s: mem9) then {
                                        pk9: pre9.string
                                        ctx.nativeConvSrc.set key: pk9 value: true
                                        mk9: mem9.string
                                        ctx.nativeConvMemb.set key: mk9 value: true
                                    }
                                } case none then null
                            } case none then null
                        }
                        if frag9.length > 0 then {
                            fp9: key9.copy
                            ctx.nativeFragPaths.set key: fp9 value: true
                            # the row's own halves, split here and nowhere else: the unit is the
                            # path's first segment, the demand is `demand=` or the last segment.
                            # Neither starts as a copy of the key: both are assigned on every
                            # path below, so a copy here is written and never read -- one per
                            # fragment row, which was the whole of `make perf-elision`'s pool.
                            du9: String
                            dm9: String
                            {
                                fd9: key9.stringview.indexOf needle: "."
                                match (
                                    fd9
                                ) case some then {
                                    hd9: key9.stringview.substring from: 0 to: fd9
                                    # the `@` marks a path outside the declaration
                                    # space; the unit it names is still the unit
                                    so9: hd9.stripPrefix p: "@"
                                    match (
                                        so9
                                    ) case some then {
                                        du9 = so9.string
                                    } case none then {
                                        du9 = hd9.string
                                    }
                                } case none then {
                                    # no `.` at all: the whole path is the unit
                                    du9 = key9.copy
                                }
                            }
                            if dem9.length == 0 then {
                                li9: u64
                                kn9: key9.length
                                cut9: u64
                                for li9 < kn9 loop {
                                    bo9: key9.stringview.byteAt i: li9
                                    match (
                                        bo9
                                    ) case some then {
                                        if bo9 == 46 then cut9 = li9 + 1
                                    } case none then null
                                    li9 = li9 + 1
                                }
                                dm9 = (key9.stringview.substring from: cut9 to: kn9).string
                            } else {
                                dm9 = dem9.copy
                            }
                            tn9: String
                            {
                                uo9: dm9.stringview.stripPrefix p: "uses_"
                                match (
                                    uo9
                                ) case some then {
                                    tn9 = uo9.string
                                } case none then null
                            }
                            ctx.fragUnits.append from: du9
                            ctx.fragMembs.append from: dm9
                            ctx.fragNames.append from: frag9.copy
                            ctx.fragTypeNames.append from: tn9
                        }
                        if body9.length > 0 then {
                            kb9: key9.copy
                            ctx.nativeTbl.set key: kb9 value: body9.string
                        }
                        if need9.length > 0 then {
                            kn9: key9.copy
                            ctx.nativeNeed.set key: kn9 value: need9.copy
                        }
                        if ptr9 then {
                            kp9: key9.copy
                            ctx.nativePtrArgs.set key: kp9 value: true
                        }
                    }
                } case none then null
            }
        }
    }
}

# nativeIsConvOf -- whether `<srcPath>.<memb>` is a numeric CONVERSION, asked
# of the table's shape rather than of the member's spelling: srcPath must be a
# type the table gives conversions for, and memb must be one every such type
# declares. Separating this from the body lookup is what lets a missing row be
# an error instead of quietly meaning "not a conversion".
nativeIsConvOf: function {ctx: Ctx.view srcPath: StringView memb: StringView} out bool is {
    s9: false
    {
        g9: ctx.nativeConvSrc.get key: srcPath.asString
        match (
            g9
        ) case some then {
            s9 = g9
        } case none then null
    }
    if (s9) == false then return false
    m9: false
    {
        h9: ctx.nativeConvMemb.get key: memb.asString
        match (
            h9
        ) case some then {
            m9 = h9
        } case none then null
    }
    return m9
}

# nativeIsFragBacked -- a fragment implements this path, so its C symbol is the
# convention one. This replaces a five-name list of units: the question was never
# which unit a native lives in, it is whether the runtime supplies its body, and
# a user unit that ships a fragment answers yes on the same terms as io does.
nativeIsFragBacked: function {ctx: Ctx.view path: StringView} out bool is {
    out9: false
    {
        g9: ctx.nativeFragPaths.get key: path.asString
        match (
            g9
        ) case some then {
            out9 = g9
        } case none then null
    }
    return out9
}

# nativeHasRow -- the table has a row for this path, whatever the row says. A
# row with no body and no fragment still answers the only question asked here:
# does the compiler claim to supply this native at all.
nativeHasRow: function {ctx: Ctx.view path: StringView} out bool is {
    out9: false
    {
        g9: ctx.nativeKeys.get key: path.asString
        match (
            g9
        ) case some then {
            out9 = g9
        } case none then null
    }
    return out9
}

# nativeImplOf -- the C body natives.tbl gives for a qualified path, "" when
# the table has no row for it. "" is the error case at every call site: the
# compiler supplies no implementation for that declaration.
nativeImplOf: function {ctx: Ctx.view path: StringView} out String is {
    out9: String
    {
        g9: ctx.nativeTbl.get key: path.asString
        match (
            g9
        ) case some then {
            out9 = g9.copy
        } case none then null
    }
    return out9
}

# nativeNeedOf -- the runtime fragment a row's body calls, "" when it calls
# none. Recorded as data because the demand has to be registered before the
# fragment pass runs, and only the row knows it is needed.
nativeNeedOf: function {ctx: Ctx.view path: StringView} out String is {
    out9: String
    {
        g9: ctx.nativeNeed.get key: path.asString
        match (
            g9
        ) case some then {
            out9 = g9.copy
        } case none then null
    }
    return out9
}

# nativePtrArgsOf -- true when a row's body takes its operands by pointer, so
# they must be projected as lvalues rather than values.
nativePtrArgsOf: function {ctx: Ctx.view path: StringView} out bool is {
    out9: false
    {
        g9: ctx.nativePtrArgs.get key: path.asString
        match (
            g9
        ) case some then {
            out9 = g9
        } case none then null
    }
    return out9
}

# emitFail -- record an emission failure for an unhandled construct. The
# marker comment still lands in the emitted C for context, but zc reports
# every recorded failure and exits nonzero without writing any output.
emitFail: function {ctx: Ctx what: String line: u32} is {
    msg9: String
    if line > 0 then {
        msg9 = "zemitterc: \{what} [line \{line}]"
    } else {
        msg9 = "zemitterc: \{what}"
    }
    ctx.emitErrors.append from: msg9
}

# loadFragment -- read a runtime fragment and fill its holes. Every fragment
# on this path spells only `z_@String@` / `z_@StringView@`, so the two
# bindings are the whole vocabulary and no registry lookup is needed -- which
# is what lets the three unconditional loads run before Ctx exists.
loadFragment: function {
    path: StringView
    svC: StringView
    strC: StringView
    fails: List String
} out String is {
    rd: io.readText :path
    match (
        rd
    ) case ok then {
        bn9: (List String)
        bv9: (List String)
        bn9.append from: "StringView".string
        bv9.append from: svC.string
        bn9.append from: "String".string
        bv9.append from: strC.string
        ferr9: (List String)
        rwn9: (List String)
        rwv9: (List String)
        cur9: (fillHoles
            text: rd
            :path
            bindNames: bn9
            bindVals: bv9
            rawNames: rwn9
            rawVals: rwv9
            fails: ferr9
        )
        fi9: u64
        fn9: ferr9.length
        for fi9 < fn9 loop {
            m9: ferr9.get i: fi9
            fm9: "zemitterc: \{m9}"
            fails.append from: fm9
            fi9 = fi9 + 1
        }
        return cur9
    } case err then {
        f9: "zemitterc: missing runtime fragment \{path}"
        fails.append from: f9
        m9: "/* zemitterc: missing runtime fragment \{path} */\n"
        return m9
    }
}

# chunkText -- a stringchunk's text ("" for any other shape).
chunkText9: function {n: Node.view} out String is {
    match (
        n
    ) case stringchunk then {
        pv: n.text.stringview
        tc: pv.string
        return tc
    } else {
        return "".string
    }
}

# isInterp -- true when a literal has any non-chunk part.
isInterp: function {ast: Ast.view parts: (ListVal u32).view} out bool is {
    piter: parts.iterate
    for pId9: piter loop {
        p: ast.nodes.get i: pId9.u64
        isC: false
        match (
            p
        ) case stringchunk then {
            isC = true
        } else null
        if (isC) == false then return true
    }
    return false
}

# wholeText -- a plain literal's joined chunk text.
wholeText: function {ast: Ast.view parts: (ListVal u32).view} out String is {
    buf: String
    piter: parts.iterate
    for pId9: piter loop {
        t: chunkText9 n: (ast.nodes.get i: pId9.u64)
        buf.append t
    }
    return buf
}

# collectLiterals -- pool every PLAIN string-literal atom in walk order:
# parallel lists of (nodeid, text). Interpolated literals build at the
# use site instead.
collectLiterals: function {ast: Ast.view n: Node.view ids: ListVal u64 texts: List String} is {
    match (
        n
    ) case statement then {
        siter: n.statements.iterate
        for sId9: siter loop collectLiterals :ast n: (ast.nodes.get i: sId9.u64) :ids :texts
    } case statementline then {
        collectLiterals :ast n: (ast.nodes.get i: n.statementline.u64) :ids :texts
    } case expression then {
        collectLiterals :ast n: (ast.nodes.get i: n.expression.u64) :ids :texts
    } case namedoperation then {
        collectLiterals :ast n: (ast.nodes.get i: n.operation.u64) :ids :texts
    } case call then {
        collectLiterals :ast n: (ast.nodes.get i: n.callable.u64) :ids :texts
        aiter: n.arguments.iterate
        for a: aiter loop collectLiterals :ast n: (ast.nodes.get i: a.u64) :ids :texts
    } case dottedpath then {
        collectLiterals :ast n: (ast.nodes.get i: n.parent.u64) :ids :texts
    } case binop then {
        collectLiterals :ast n: (ast.nodes.get i: n.lhs.u64) :ids :texts
        collectLiterals :ast n: (ast.nodes.get i: n.rhs.u64) :ids :texts
    } case assignment then {
        collectLiterals :ast n: (ast.nodes.get i: n.value.u64) :ids :texts
    } case reassignment then {
        collectLiterals :ast n: (ast.nodes.get i: n.value.u64) :ids :texts
    } case ifexpr then {
        citer: n.clauses.iterate
        for cId9: citer loop collectLiterals :ast n: (ast.nodes.get i: cId9.u64) :ids :texts
        if n.elseclause > 0 then {
            ec9: ast.nodes.get i: n.elseclause.u64
            collectLiterals :ast n: ec9 :ids :texts
        }
    } case caseexpr then {
        collectLiterals :ast n: (ast.nodes.get i: n.subject.u64) :ids :texts
        miter9: n.clauses.iterate
        for mc9: miter9 loop collectLiterals :ast n: (ast.nodes.get i: mc9.u64) :ids :texts
        if n.elseclause > 0 then {
            ecl9: ast.nodes.get i: n.elseclause.u64
            collectLiterals :ast n: ecl9 :ids :texts
        }
    } case caseclause then {
        collectLiterals :ast n: (ast.nodes.get i: n.statement.u64) :ids :texts
    } case ifclause then {
        kiter: n.conditions.iterate
        for kId9: kiter loop collectLiterals :ast n: (ast.nodes.get i: kId9.u64) :ids :texts
        collectLiterals :ast n: (ast.nodes.get i: n.statement.u64) :ids :texts
    } case withexpr then {
        collectLiterals :ast n: (ast.nodes.get i: n.value.u64) :ids :texts
        collectLiterals :ast n: (ast.nodes.get i: n.body.u64) :ids :texts
    } case doexpr then {
        collectLiterals :ast n: (ast.nodes.get i: n.statement.u64) :ids :texts
    } case yieldexpr then {
        collectLiterals :ast n: (ast.nodes.get i: n.expr.u64) :ids :texts
    } case forexpr then {
        fiter: n.conditions.iterate
        for f: fiter loop collectLiterals :ast n: (ast.nodes.get i: f.u64) :ids :texts
        if n.body > 0 then {
            fbl9: ast.nodes.get i: n.body.u64
            collectLiterals :ast n: fbl9 :ids :texts
        }
    } case atomstring then {
        if (isInterp :ast parts: n.stringparts) == false then {
            t: wholeText :ast parts: n.stringparts
            nid: n.nodeid.u64
            ids.append nid
            texts.append t
        } else {
            piter: n.stringparts.iterate
            for p: piter loop collectLiterals :ast n: (ast.nodes.get i: p.u64) :ids :texts
        }
    } else null
}

# litIndexOf -- the 1-based pool index for a literal's nodeid (0 = absent).
litIndexOf: function {ctx: Ctx nid: u64} out u64 is {
    i: u64
    n: ctx.litIds.length
    for i < n loop {
        v: ctx.litIds.get :i
        if v == nid then {
            ctx.usedLits.set key: nid value: true
            return i + 1
        }
        i = i + 1
    }
    return 0
}

# ternaryClause / ternaryElse -- if-expression rendering as nested C
# ternaries: each clause opens "(cond ? value : " and the else closes.
ternaryClause: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    c: Node.view
} out String is {
    match (
        c
    ) case ifclause then {
        cond: String
        kiter: c.conditions.iterate
        for kId9: kiter loop {
            k: ast.nodes.get i: kId9.u64
            match (
                k
            ) case namedoperation then {
                cv: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: k.operation.u64)
                tw9: (truthyCondText9
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: k.operation.u64)
                    raw: cv.stringview
                )
                if cond.length > 0 then cond.append " && "
                if tw9.length > 0 then {
                    cond.append tw9
                } else {
                    cond.append cv
                }
            } else null
        }
        vx: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: c.statement.u64)
        t0: "((\{cond}) ? (\{vx}) : "
        return t0
    } else {
        return "(0 ? 0 : ".string
    }
}

# emit the else-arm of a C ternary expression.
ternaryElse: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    oId: zast.nodeid
} out String is {
    if oId > 0 then {
        ev: emitExpr :ast :symtab :ctx n: (ast.nodes.get i: oId.u64)
        e0: "(\{ev})"
        return e0
    } else {
        return "(0)".string
    }
}

# atomTextOf -- an atomid node's name text ("" for any other shape).
# atomNameIdOf -- an atom's interned name id (0 when the node is not an atom;
# no pool id is 0, so a lookup by it misses).
atomNameIdOf: function {ast: Ast.view n: Node.view} out zast.nameid is {
    ast
    match (
        n
    ) case atomid then {
        return n.name
    } else {
        return (zast.nameid.create from: 0)
    }
}

atomTextOf: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# atomTextDeep -- atom text through expression wrappers.
atomTextDeep: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (atomTextDeep :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# atomNodeId9 -- an atomid node's id (0 for any other shape).
atomNodeId9: function {n: Node.view} out u64 is {
    match (
        n
    ) case atomid then {
        return n.nodeid.u64
    } else {
        return 0
    }
}

# the stamp id recorded for node `nid`.
stampIdOf: function {symtab: zenv.ZSymbolTable nid: u64} out ztypes.tid is {
    return (ztypes.tid.create from: (ztyping.nodeTypeAt tbl: symtab.typing.nodeType :nid))
}

# monoStampIdOf -- the per-mono side stamp for a template node: the
# checker's instance walk records (monoId << 32 | nodeid) -> tid; consulted
# during mono re-walks (ctx.curThisTid) before any fallback resolution.
monoStampIdOf: function {symtab: zenv.ZSymbolTable.view ctx: Ctx.view nid: u64} out ztypes.tid is {
    if ctx.curThisTid.isZero then return (ztypes.tid.create from: 0)
    mk9: (ztyping.monostamp mono: ctx.curThisTid.u64 node: nid)
    go9: symtab.typing.monoNodeType.get key: mk9
    match (
        go9
    ) case some then {
        return (ztypes.tid.create from: go9)
    } case none then {
        return (ztypes.tid.create from: 0)
    }
}

# binopOwnerAt / binopMethodAt -- the operator resolution the type checker
# recorded for a binop node: the type that DECLARES the operator, and the
# method it resolved to (0 where none was declared). The instance-walk answer
# comes first, because a monomorphised body re-walks the TEMPLATE's nodes --
# the flat table holds nothing for them, and one template node carries a
# different answer per instance. Both facts read through one accessor each so
# that no caller can consult one table and forget the other; consulting only
# the flat one is exactly what makes stampIdDeep blind inside a generic body.
binopOwnerAt: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    nid: u64
} out ztypes.tid is {
    if ctx.curThisTid > 0 then {
        mk9: (ztyping.monostamp mono: ctx.curThisTid.u64 node: nid)
        mo9: symtab.typing.monoBinopOwner.get key: mk9
        match (
            mo9
        ) case some then {
            return (ztypes.tid.create from: mo9)
        } case none then null
    }
    go9: symtab.typing.binopOwner.get key: nid
    match (
        go9
    ) case some then {
        return (ztypes.tid.create from: go9)
    } case none then {
        return (ztypes.tid.create from: 0)
    }
}

binopMethodAt: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    nid: u64
} out ztypes.tid is {
    if ctx.curThisTid > 0 then {
        mk9: (ztyping.monostamp mono: ctx.curThisTid.u64 node: nid)
        mo9: symtab.typing.monoBinopMethod.get key: mk9
        match (
            mo9
        ) case some then {
            return (ztypes.tid.create from: mo9)
        } case none then null
    }
    go9: symtab.typing.binopMethod.get key: nid
    match (
        go9
    ) case some then {
        return (ztypes.tid.create from: go9)
    } case none then {
        return (ztypes.tid.create from: 0)
    }
}

# convSrcPathOf -- the `<unit>.<type>` half of a conversion path, built from
# the SOURCE type's id. A conversion is declared on the type it converts FROM,
# so that type is the path's owner; a typedef converts as its chain end, which
# is where the declaration lives. "" when the source names no declaring unit,
# which is how a member that merely LOOKS like a type name -- a user record's
# field called `u32` -- fails to find a row and is not treated as a conversion.
convSrcPathOf: function {symtab: zenv.ZSymbolTable srcTid: ztypes.tid} out String is {
    if srcTid.isZero then return "".string
    uo9: definedInUnitOf :symtab tid: srcTid
    match (
        uo9
    ) case some then {
        tn9: typeNameOfReg9 :symtab tid: srcTid
        if tn9.length == 0 then return "".string
        k9: "\{uo9}.\{tn9}"
        return k9
    } case none then null
    return "".string
}

# binopKeyOf -- the natives.tbl path for an operator on `owner`. A declared
# native is three segments, `<declaring unit>.<type>.<operator>`, built from
# the owner's id rather than from anything the source spelled. The synthesised
# structural cases have no declaration, and their `@` prefix keeps them out of
# the declaration space: a free function's path is `<unit>.<name>`, two segments
# just like theirs. They key on the SHAPE
# the emitter would have built by hand -- a variant's tag compare, a record's
# byte compare, or the inline compare a record whose typedef chain ends at a
# scalar gets instead.
binopKeyOf: function {
    symtab: zenv.ZSymbolTable
    owner: ztypes.tid
    isNative: bool
    op: StringView
} out String is {
    if isNative then {
        uo9: definedInUnitOf :symtab tid: owner
        match (
            uo9
        ) case some then {
            tn9: typeNameOfReg9 :symtab tid: owner
            k9: "\{uo9}.\{tn9}.\{op}"
            return k9
        } case none then null
        return "".string
    }
    tt9: symtab.reg.typetypeOf typeId: owner
    # an ORDINAL PAIR is a C scalar, so it compares with `==` rather than
    # through the tagged-struct comparator it has no struct for
    if (isOrdinalVariant :symtab tid: owner) then {
        k0: "@scalar.\{op}"
        return k0
    }
    if tt9 == ztypes.ztypetype.variantType then {
        k1: "@variant.\{op}"
        return k1
    }
    if tt9 == ztypes.ztypetype.recordType then {
        bn9: typedefChaseBaseName9 :symtab tid: owner
        if bn9.length > 0 then {
            sc9: (scalarCTypeFor
                :symtab
                name: bn9.stringview
                tid: (typedefChaseTid9 :symtab tid: owner)
            )
            if sc9.length > 0 then {
                k2: "@scalar.\{op}"
                return k2
            }
        }
        k3: "@record.\{op}"
        return k3
    }
    return "".string
}

# dpTaggedOf9 -- the tagged-construction stamp for a dotted node: the
# variant/union type id when the path names a subtype member on the TYPE
# (`Type.arm`); 0 otherwise.
dpTaggedOf9: function {symtab: zenv.ZSymbolTable.view nid: u64} out u64 is {
    go: symtab.typing.dpTaggedParent.get key: nid
    match (
        go
    ) case some then {
        return go
    } case none then {
        return 0
    }
}

# dpArmPredicateOf9 -- the arm-predicate stamp for a dotted node: the
# variant/union type id when `value.arm` is a tag test; 0 otherwise.
dpArmPredicateOf9: function {symtab: zenv.ZSymbolTable.view nid: u64} out u64 is {
    go: symtab.typing.dpArmPredicate.get key: nid
    match (
        go
    ) case some then {
        return go
    } case none then {
        return 0
    }
}

# dpTagReadOf9 -- the tag-accessor stamp for a dotted node: the variant/
# union type id when `value.<accessor>` reads the discriminator; 0 otherwise.
dpTagReadOf9: function {symtab: zenv.ZSymbolTable.view nid: u64} out u64 is {
    go: symtab.typing.dpTagRead.get key: nid
    match (
        go
    ) case some then {
        return go
    } case none then {
        return 0
    }
}

# dataBlockTid9 -- the DATA type a data-block reference resolved to, read off
# the refDecl stamp on the access base. userFnId cannot serve here: it resolves
# against ctx.mainName, so it is main-relative and answers with the main unit's
# block for a dependency unit's reference.
dataBlockTid9: function {symtab: zenv.ZSymbolTable nid: u64} out ztypes.tid is {
    if nid == 0 then return (ztypes.tid.create from: 0)
    rd9: ztypes.declid
    {
        go9: symtab.typing.refDecl.get key: nid
        match (
            go9
        ) case some then {
            rd9 = go9
        } case none then null
    }
    if rd9.u64 == 0 then return (ztypes.tid.create from: 0)
    t9: u64
    {
        d9: symtab.typing.decls.get i: rd9.u64
        t9 = d9.typeId
    }
    if t9 == 0 then return (ztypes.tid.create from: 0)
    if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: t9.u64)) != ztypes.ztypetype.dataType then return (ztypes.tid.create from: 0)
    return (ztypes.tid.create from: t9)
}

# matchDiverges -- true when a match node is stamped `never` (the typechecker's
# exhaustive + all-arms-diverge result), so its `default:` is provably unreachable.
matchDiverges: function {symtab: zenv.ZSymbolTable nid: u64} out bool is {
    tid: stampIdOf :symtab :nid
    if tid.isZero then return false
    tt: symtab.reg.typetypeOf typeId: tid
    if tt == ztypes.ztypetype.neverType then return true
    return false
}

# blockDiverges -- the block's last statement leaves the block on every path: a
# `return`, or any statement the typechecker stamped `never` (panic, unreachable,
# break, continue, an exhaustive all-arms-diverge match). Whatever a caller would
# append after such a block is unreachable. Ask it about the block YOU emitted --
# an `if c then { break }` diverges as a block, its enclosing block does not.
blockDiverges: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    n: Node.view
} out bool is {
    if (ztypecheck.blockEndsInReturn :ast block: n) then return true
    match (
        n
    ) case statement then {
        # ANY diverging statement makes the rest of the block unreachable, so
        # the block diverges -- not just a diverging last statement
        with dit9: n.statements.iterate do for dsId9: dit9 loop {
            if (stmtDiverges9
                :ast
                :symtab
                :ctx
                sid: (zast.nodeid.create from: dsId9.u64)
            ) then return true
        }
        return false
    } else {
        return false
    }
}

# stmtDiverges9 -- one statement leaves its block on every path: a `never` stamp
# (panic, unreachable, break, continue, an all-arms-diverge match), a `return`
# valued or bare, an if/else chain whose every arm diverges, or a `for true loop`
# with no break.
stmtDiverges9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    sid: zast.nodeid
} out bool is {
    if sid.isZero then return false
    sn9: ast.nodes.get i: sid.u64
    match (
        sn9
    ) case statementline then {
        inn9: ast.nodes.get i: sn9.statementline.u64
        # the typechecker's `never` stamp IS the control-flow fact: checkCase
        # only stamps it on an exhaustive match whose every arm -- else included
        # -- diverges, and a panic or diverging call carries it because it does
        # not return. No shape-matching needed here.
        if (matchDiverges :symtab nid: sid.u64) then return true
        if (matchDiverges :symtab nid: sn9.statementline.u64) then return true
        if (bareReturn9 :ast n: inn9) then return true
        if (loopNeverExits9 :ast :symtab n: inn9) then return true
        return (ifDiverges :ast :symtab :ctx n: inn9)
    } else {
        return false
    }
}

# bareReturn9 -- a valueless `return`, which parses as an atom rather than the
# call shape ztypecheck.blockEndsInReturn looks for. Diverges all the same.
bareReturn9: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (bareReturn9 :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return n.name.u32 == zast.wkReturn
    } else {
        return false
    }
}

# loopNeverExits9 -- a `for true loop` with no break: its only exits are the
# return/panic statements inside it, so anything after the loop is unreachable.
# The condition is checked as the literal `true`; a computed condition, a
# postcondition, or any break leaves a normal exit and the answer is false.
loopNeverExits9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    n: Node.view
} out bool is {
    match (
        n
    ) case expression then {
        return (loopNeverExits9 :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } case forexpr then {
        if n.body.isZero then return false
        if n.postconditions.length > 0 then return false
        if n.conditions.length != 1 then return false
        c09: ast.nodes.get i: (n.conditions.get i: 0).u64
        alwaysT9: false
        match (
            c09
        ) case namedoperation then {
            if c09.name.isZero then {
                cop9: ast.nodes.get i: c09.operation.u64
                if (boolArmSideOf9 :ast :symtab n: cop9).truthy then alwaysT9 = true
                # `true` also arrives as the dotted tag bool.true
                match (
                    cop9
                ) case dottedpath then {
                    chn9: atomNameIdOf :ast n: (ast.nodes.get i: cop9.child.u64)
                    chs9: armSideAtNode9 :symtab nid: cop9.nodeid.u64 nameId: chn9
                    if chs9.truthy then alwaysT9 = true
                } else null
            }
        } else null
        if (alwaysT9) == false then return false
        return (ztypecheck.blockHasBreak
            :ast
            n: (ast.nodes.get i: n.body.u64)
        ) == false
    } else {
        return false
    }
}

# ifDiverges -- an if/else chain every arm of which diverges, else included. No
# else clause means the fall-through path is live, so the chain does not.
ifDiverges: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    n: Node.view
} out bool is {
    match (
        n
    ) case expression then {
        return (ifDiverges :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case ifexpr then {
        # a chain whose every condition folds emits ONE branch, so only that
        # branch decides -- the arms the emitter dropped cannot run. Mirrors the
        # fold in emitStmt's ifexpr case.
        ffb9: foldedBranchOf9 :symtab nid: n.nodeid.u64
        if ffb9.known then {
            # every branch folded away: nothing is emitted, so nothing diverges
            if ffb9.stmt.isZero then return false
            return (blockDiverges
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: ffb9.stmt.u64)
            )
        }
        if n.elseclause.isZero then return false
        with cit9: n.clauses.iterate do for cId9: cit9 loop {
            cl9: ast.nodes.get i: cId9.u64
            match (
                cl9
            ) case ifclause then {
                if cl9.statement.isZero then return false
                if (blockDiverges
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: cl9.statement.u64)
                ) == false then return false
            } else {
                return false
            }
        }
        return (blockDiverges
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.elseclause.u64)
        )
    } else {
        return false
    }
}

# stampNameOf -- the registry name of a node's stamped type ("" unstamped).
stampNameOf: function {symtab: zenv.ZSymbolTable nid: u64} out String is {
    go: ztyping.nodeTypeAt tbl: symtab.typing.nodeType :nid
    if go > 0 then return (symtab.reg.nameOf tid: (ztypes.tid.create from: go.u64))
    return "".string
}

# builtinTidInU -- builtinTid for a builtin DECLARED IN `unit`: currentUnit is
# walkLookupTyperef's first probe, so naming the unit resolves without leaning on
# the stdlib fallbacks. For the builtins `core` does not re-export.
# builtinTidInU -- the canonical registry id of a stdlib builtin DECLARED IN
# `unitName`: currentUnit is walkLookupTyperef's first probe, so naming the unit
# is the qualified lookup, for the builtins `core` does not re-export. Passing
# "" is the unqualified form and the only other caller is builtinTid.
builtinTidInU: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    unitName: StringView
    base: StringView
} out u64 is {
    # every caller names the declared family form directly (ListRef, MapRR,
    # ...); the memoized builtinTidT is not usable here -- its memo write
    # needs an exclusive typing, and the emitter holds a view.
    return (optU64Or9 o: (ztypecheck.walkLookupTyperef
        :ast
        ty: symtab.typing
        reg: symtab.reg
        unitDecl: (ztypecheck.unitDeclOfName ty: symtab.typing :ast name: unitName)
        :base)
    )
}

# builtinTid -- builtinTidInU with no unit named, so a user type of the same
# name never shadows it. 0 when absent from the program.
builtinTid: function {ast: Ast.view symtab: zenv.ZSymbolTable.view base: StringView} out u64 is {
    return (builtinTidInU :ast :symtab unitName: "" :base)
}

# specStemTid -- the minted instance of a system template over one or two
# concrete arguments, every part named by its SOURCE name (`optionval` over
# `u64`). A runtime fragment's text still carries the mangled spelling, but the
# identity comes off the spec trie. 0 when that instance was never demanded.
specStemTid: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    base: StringView
    arg1: StringView
    arg2: StringView
} out ztypes.tid is {
    a29: u64
    if arg2.length > 0 then a29 = builtinTid :ast :symtab base: arg2
    return (specTidArgs
        :symtab
        templateTid: (builtinTid :ast :symtab :base)
        a1: (builtinTid :ast :symtab base: arg1)
        a2: a29
    )
}

# specTidArgs -- specStemTid's core, taking the argument TYPE IDS directly so a
# nested instance (Result over List_String) can be composed one level at a time.
specTidArgs: function {
    symtab: zenv.ZSymbolTable
    templateTid: u64
    a1: u64
    a2: u64
} out ztypes.tid is {
    args9: (ListVal u64)
    args9.append a1
    if a2 > 0 then args9.append a2
    return (ztypecheck.specLookup
        reg: symtab.reg
        templateId: (ztypes.tid.create from: templateTid.u64)
        args: args9
    )
}

# originTidOf -- a type's genericOriginId (the template it monomorphized from), or
# 0 when it has none. The id form of monoOriginName.
originTidOf: function {symtab: zenv.ZSymbolTable tid: ztypes.tid} out ztypes.tid is {
    # a partial spec (GENERIC_PARAM typetype) is trie bookkeeping, never an
    # emittable mono; origin-keyed sweeps must not select it
    if (symtab.reg.typetypeOf typeId: tid) == ztypes.ztypetype.genericParam then return (ztypes.tid.create from: 0)
    return (symtab.reg.genericOriginOf :tid)
}

# originIsTid -- true when tid's generic origin equals the (nonzero) originTid.
# The 0-guard means an origin-less type never matches an unresolved (0) builtin.
originIsTid: function {
    symtab: zenv.ZSymbolTable.view
    tid: ztypes.tid
    originTid: ztypes.tid
} out bool is {
    if originTid.isZero then return false
    ot9: originTidOf :symtab :tid
    return ot9.u64 == originTid
}

# Ctx -- the per-program emission context (anchor cnames, main unit name,
# the literal pool, and the resolved-name map access).
# dataconstkey / dataslotkey -- which element of which data block. A data
# element is reached two ways -- `primes.first` by LABEL and `primes.0` by
# ORDINAL -- and a nameid and an ordinal are two id spaces, so they are two
# TABLES rather than one string that could spell either. Both fields are
# widened to u64 so the key has no padding for the container's byte hash to
# read (the callslot / constslot shape).
dataconstkey: record {
    owner: u64
    name: u64
}

dataslotkey: record {
    owner: u64
    slot: u64
}

Ctx: class {
    mainName: String
    # the namespace unit whose functions are being emitted, 0 while emitting
    # the file unit's own. A name written inside a namespace resolves against
    # IT first: `deep.mul` in mymod/helper.z names helper's subunit, not one of
    # mymod's, and ctx.mainName can only ever name the file.
    nsTid: ztypes.tid
    realMain: String
    strC: String
    svC: String
    # type id -> C name base, composed once at emit start; "" for a hole
    cnames: (List String)
    litIds: (ListVal u64)
    usedLits: (MapVV u64 value: bool)
    # the FOLDED-string pool, beside the AST-literal one. A folded value has no
    # literal to point at -- a concatenation and a selected branch were never
    # written anywhere -- so litIndexOf cannot serve it. Rendered `_zcsN` in the
    # same static z_StringView_t shape as `_zs`, and MINTING IS THE USE: an
    # entry exists only because something asked to emit it, so unlike usedLits
    # there is no separate mark.
    constLits: (List String)
    # every runtime demand, as the (unit, member) PAIRS they are: parallel
    # rows, never joined. Joining them would only have to be split apart again
    # to name the fragment -- which is why the per-unit skip lists already carry
    # the member half alone. A member of `@unit` is the unit ITSELF being
    # demanded, which is what the flat vocabulary used to say with no unit at
    # all: the bare name "io" was always the pair (io, the unit), and every
    # other flat name was a member of `system` or of `collections`.
    needUnits: (List String)
    needMembs: (List String)
    dataElems: (MapVR ztypes.tid value: String)
    dataConst: (MapVR dataconstkey value: String)
    dataSlot: (MapVR dataslotkey value: String)
    # the current class method body's pointer-receiver params, by variable id
    ptrVids: (ListVal ztypes.vid)
    # the enclosing function hands back a REFERENCE to a user reftype, so its
    # `return` yields an address. Per-function, set by emitFnBody like ptrVids.
    refBorrowRet: bool
    aliases: (List VidVal)
    narrowBox: (List VidVal)
    narrowTid: (List VidTid)
    exclArms: (List VidVal)
    exclTids: (List VidTid)
    genActive: bool
    # the emitted C name of the generator receiver, for the state-machine
    # prologue: it is a renamed parameter, not the literal `this`
    genRecvC: String
    # and the emitted name of its resume-value parameter
    genValC: String
    genYieldCount: u64
    genYieldNext: u64
    genWrap: String
    genSomeTag: String
    genNoneTag: String
    genPayC: String
    genHasValue: bool
    curThisTid: ztypes.tid
    fastHash: bool
    readableNames: bool
    tailRetActive: bool
    defUnitId: (MapVV u64 value: u64)
    # the four stdlib units the emitter names outright, resolved once
    ioUnitDecl: u64
    osUnitDecl: u64
    cliUnitDecl: u64
    netUnitDecl: u64
    # the three fixed (unit, class) hooks, resolved once through the unit
    ioFileTid: u64
    netListenerTid: u64
    netConnTid: u64
    unitTidsC: (ListVal ztypes.tid)
    unitKeysC: (List String)
    unitCacheBuilt: bool
    # name-id -> resolved tid (misses cached as 0): the typed model is
    # frozen during emission, so resolution per name id is emit-stable
    resolveByNameC: (MapVV u64 value: u64)
    mainUnitId: u64
    condDepth: u64
    emitErrors: (List String)
    emittedUserTypes: (MapVV u64 value: bool)
    tagStems: (MapRV String value: u64)
    fwdDeclaredTypes: (MapVV u64 value: bool)
    tmplCache: (Map String value: String)
    ioCanonC: (Map String value: String)
    # natives.tbl, read once at emit start: qualified path -> the C body, plus
    # the two row attributes. Parsed eagerly rather than on first lookup
    # because the lookup site is inside emitExpr, which holds a Ctx but not the
    # runtime dir; emitC has both.
    nativeTbl: (Map String value: String)
    nativeNeed: (Map String value: String)
    nativePtrArgs: (MapRV String value: bool)
    # the conversion rows, split so the two questions stay separate: is this
    # member a CONVERSION at all (a type that converts, and a member every
    # converting type declares), and if so what C does this pair emit. Asking
    # only the second would make a missing row read as "not a conversion" and
    # write the dotted path through to the C compiler.
    # every row's path, whatever the row carries: the check at the declaration
    # asks only whether one exists
    nativeKeys: (MapRV String value: bool)
    # the paths a FRAGMENT implements: a native whose C the runtime supplies
    # under the `z_<unit>_<name>` convention, whoever declares it
    nativeFragPaths: (MapRV String value: bool)
    nativeConvSrc: (MapRV String value: bool)
    nativeConvMemb: (MapRV String value: bool)
    # the fragment-backed rows, as the (unit, demand) PAIR each is reached by
    # plus the fragments it needs. Parallel lists because the demand is a pair
    # and stays one: nothing here joins the halves, and nothing splits them.
    fragUnits: (List String)
    fragMembs: (List String)
    fragNames: (List String)
    # a row whose demand is `uses_<Type>` is reached by that TYPE being
    # constructed rather than by a member being called. The name the table
    # spells, and the id it resolves to once the registry is built; 0 on every
    # member-demanded row, which is nearly all of them.
    fragTypeNames: (List String)
    fragTypeTids: (ListVal u64)
    # the type ids those rows gate, and the ones the program actually built
    demandGatedTids: (MapVV u64 value: bool)
    usedTypeIds: (MapVV u64 value: bool)
    # conformance rows whose helper set is already in the buffer, by row index
    emittedConformance: (MapVV u64 value: bool)
    # the units the table orders, in that order. A unit with rows that is not
    # named here runs after those that are.
    unitOrder: (List String)
    argHoistNames: (List String)
    argHoistVals: (List String)
    argHoistTypes: (List String)
    argHoistDtors: (List String)
    argHoistRaw: (List String)
    argHoistCtr: u64
    breakLabels: (ListVal u64)
    breakLabelIsDo: (ListVal bool)
    contLabelUsed: (MapVV u64 value: bool)
    breakLabelCtr: u64
    breakLabelUsed: (MapVV u64 value: bool)
    breakFreesMarks: (ListVal u64)
    breakListMarks: (ListVal u64)
    breakLabelCleanup: (List String)
    breakLabelCleanupVar: (List String)
    # variables for breakLabelCleanupVar, for the same reason as TmpCtr's
    breakLabelCleanupRaw: (ListVal ztypes.vid)
    borrowedVars: (MapVV u64 value: bool)
    colGetFromCode: bool
    strTid: ztypes.tid
    svTid: ztypes.tid
    # converror's canonical id. The numeric-conversion rule is ABOUT converror --
    # natives.tbl's conversion rows name its arms -- so the emitter has to know
    # which type that is to spell the error assignment for its representation.
    converrorTid: ztypes.tid
    strOriginTid: ztypes.tid
    arrayOriginTid: ztypes.tid
    listOriginTid: ztypes.tid
    listValOriginTid: ztypes.tid
    listViewOriginTid: ztypes.tid
    listViewValOriginTid: ztypes.tid
    mapOriginTid: ztypes.tid
    mapRVOriginTid: ztypes.tid
    mapVROriginTid: ztypes.tid
    mapVVOriginTid: ztypes.tid
    setOriginTid: ztypes.tid
    setValOriginTid: ztypes.tid
    idMapROriginTid: ztypes.tid
    idMapVOriginTid: ztypes.tid
    idSetOriginTid: ztypes.tid
    idSetIterOriginTid: ztypes.tid
    idMapItemIterROriginTid: ztypes.tid
    idMapItemIterVOriginTid: ztypes.tid
    idMapEntryROriginTid: ztypes.tid
    idMapEntryVOriginTid: ztypes.tid
    mapEntryOriginTid: ztypes.tid
    listIterOriginTid: ztypes.tid
    listIterValOriginTid: ztypes.tid
    setIterOriginTid: ztypes.tid
    setIterValOriginTid: ztypes.tid
    mapKeyIterOriginTid: ztypes.tid
    mapItemIterOriginTid: ztypes.tid
    mapKeyIterRVOriginTid: ztypes.tid
    mapKeyIterVROriginTid: ztypes.tid
    mapKeyIterVVOriginTid: ztypes.tid
    mapItemIterRVOriginTid: ztypes.tid
    mapItemIterVROriginTid: ztypes.tid
    mapItemIterVVOriginTid: ztypes.tid
    mapEntryRVOriginTid: ztypes.tid
    mapEntryVROriginTid: ztypes.tid
    mapEntryVVOriginTid: ztypes.tid
    optionOriginTid: ztypes.tid
    optionViewOriginTid: ztypes.tid
    resultOriginTid: ztypes.tid
    optionvalOriginTid: ztypes.tid
    resultvalOriginTid: ztypes.tid
}

# canonFnId -- userFnId, but a tid already carrying a generic origin is a
# registered mono and inherently canonical: skip the name round-trip and use it.
canonFnId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
    name: StringView
} out u64 is {
    if (originTidOf :symtab :tid) > 0 then return tid
    return (userFnId :ast :symtab :ctx :name)
}

# canonTypeId -- resolveTypeIdByName with the same mono short-circuit.
canonTypeId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    tid: ztypes.tid
    name: StringView
} out u64 is {
    if (originTidOf :symtab :tid) > 0 then return tid
    byName9: resolveTypeIdByName :ast :symtab :ctx :name
    if byName9 > 0 then return byName9
    # The name route cannot reach a type declared in a NESTED unit -- there is
    # no name-index entry to find it by -- but the id in hand is already that
    # type. Accept it when it names a real aggregate, so a field typed through
    # a subunit compares field-wise instead of falling through to a C `==` on
    # two structs.
    tt9: symtab.reg.typetypeOf typeId: tid
    if tt9 == ztypes.ztypetype.recordType then return tid
    if tt9 == ztypes.ztypetype.variantType then return tid
    return 0
}

# userFnId -- the resolved type id of a main-unit function name (0 absent).
userFnId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    name: StringView
} out ztypes.tid is {
    uq0z9: ztypecheck.unitDeclOfName ty: symtab.typing :ast name: ctx.mainName.stringview
    go: (ztypecheck.resolveUnitChild
        :ast
        ty: symtab.typing
        reg: symtab.reg
        unitDecl: uq0z9
        :name
    )
    match (
        go
    ) case some then {
        return (ztypes.tid.create from: go)
    } case none then {
        return (ztypes.tid.create from: 0)
    }
}

# userFnIdById -- id-keyed userFnId: the child name is already an Ast.names id.
userFnIdById: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    nameId: zast.nameid
} out u64 is {
    uq1z9: ztypecheck.unitDeclOfName ty: symtab.typing :ast name: ctx.mainName.stringview
    go: (ztypecheck.resolveUnitChildById
        :ast
        ty: symtab.typing
        reg: symtab.reg
        unitDecl: uq1z9
        :nameId
    )
    match (
        go
    ) case some then {
        return go
    } case none then {
        return 0
    }
}

# isPtrVid -- true when variable `vid` is a pointer-receiver param of the
# current class method body (so field reads emit `->` instead of `.`). The
# id-addressed form; a vid of 0 means the site had no variable to name and is
# never a pointer receiver.
isPtrVid: function {ctx: Ctx.view vid: ztypes.vid} out bool is {
    if vid.isZero then return false
    return (ctx.ptrVids.contains item: vid)
}

# pathIsPointer -- does the expression evaluate to a C pointer? A ptrVar atom
# (pointer receiver / lock param) or a dotted read of a `.lock` field both do,
# so field access on them chains with `->`.
pathIsPointer: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    n: Node.view
} out bool is {
    match (
        n
    ) case expression then {
        return (pathIsPointer :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        anP9: ast.names.texts.get i: n.name.u64
        rnV0: atomVid :symtab nid: n.nodeid.u64
        rn: aliasResolve :ctx name: anP9.stringview vid: rnV0
        rnv9: ztypes.vid
        if rn.stringview == anP9.stringview then rnv9 = rnV0
        return (isPtrVid :ctx vid: rnv9)
    } case labelvalue then {
        lnP9: ast.names.texts.get i: n.name.u64
        rlnV0: atomVid :symtab nid: n.nodeid.u64
        rln: aliasResolve :ctx name: lnP9.stringview vid: rlnV0
        rlv9: ztypes.vid
        if rln.stringview == lnP9.stringview then rlv9 = rlnV0
        return (isPtrVid :ctx vid: rlv9)
    } case call then {
        # a reference-returning call yields `T*`. The arm narrows `n` to
        # CallData, so the Node is re-fetched by its own id.
        cnd9: ast.nodes.get i: n.nodeid.u64
        return (nodeIsRefBorrowResult9 :ast :symtab :ctx n: cnd9)
    } case dottedpath then {
        # a ZERO-ARG auto-call reads as a dotted path, so a reference-returning
        # one is itself a `T*` and a read off it is `->`. The arm narrows `n`, so
        # the Node is re-fetched by its own id.
        dnd9: ast.nodes.get i: n.nodeid.u64
        if (nodeIsRefBorrowResult9 :ast :symtab :ctx n: dnd9) then return true
        cn: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        pnid: atomNodeId9 n: (ast.nodes.get i: n.parent.u64)
        pstamp: stampIdOf :symtab nid: pnid
        pstn: typeNameOfReg9 :symtab tid: pstamp
        prid: canonTypeId :ast :symtab :ctx tid: pstamp name: pstn.stringview
        ptid: pstamp
        if prid > 0 then ptid = ztypes.tid.create from: prid.u64
        return (symtab.typing.declIsLockField
            pool: ast.names
            parentTypeId: ptid
            name: cn.stringview
        )
    } else {
        return false
    }
}

# nodeIsRefBorrowResult9 -- the node evaluates to a reference-returning call's
# result, i.e. a `T*` in the emitted C.
nodeIsRefBorrowResult9: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    n: Node.view
} out bool is {
    f9: refBorrowCalleeFid9 :ast :symtab :ctx :n
    if f9 == 0 then return false
    r9: stampIdOf :symtab nid: (nodeIdOf9 :n)
    return (fnReturnsRefBorrow9 :ast :symtab :ctx fid: (ztypes.tid.create from: f9.u64) retTid: r9)
}

# VidVal / VidTid -- assoc-list entries for the per-function narrowing and alias
# state, keyed by VARIABLE ID. A name conflates two bindings that happen to share
# it, and it is not a key a declaration site and a use site can both produce -- a
# variable id is both. A vid of 0 means "no variable here" and never keys an
# entry. A handful of entries at most, so a linear probe beats a map's per-probe
# owned-key allocation and hash.
VidVal: class {
    vid: ztypes.vid
    val: String
}

VidTid: class {
    vid: ztypes.vid
    tid: ztypes.tid
}

# vvGet -- the value recorded for `vid`, "" when absent (values never empty).
# vvFind -- the 1-based index of `vid`'s entry in `xs`, 0 when absent. The
# value is copied only on a hit, so a miss allocates nothing at all. vvGet's
# empty-String sentinel cost 277,711 one-byte allocations on a self-compile
# (2.9% of every allocation the compiler makes) because the miss is the common
# case: read through this, not vvGet, on any hot path.
vvFind: function {xs: (List VidVal).view vid: ztypes.vid} out u64 is {
    if vid.isZero then return 0
    i9: u64
    n9: xs.length
    for i9 < n9 loop {
        if (xs.get i: i9).vid == vid then return i9 + 1
        i9 = i9 + 1
    }
    return 0
}

# vvGet -- the value recorded for `vid`, "" when absent (values never empty).
vvGet: function {xs: (List VidVal).view vid: ztypes.vid} out String is {
    f9: vvFind :xs :vid
    if f9 == 0 then return "".string
    return (xs.get i: f9 - 1).val.copy
}

# true when list `xs` has an entry for `vid`.
vvHas: function {xs: (List VidVal).view vid: ztypes.vid} out bool is {
    if vid.isZero then return false
    i9: u64
    n9: xs.length
    for i9 < n9 loop {
        if (xs.get i: i9).vid == vid then return true
        i9 = i9 + 1
    }
    return false
}

# vvSet -- replace-or-append: one entry per variable (map.set semantics).
vvSet: function {xs: List VidVal vid: ztypes.vid val: StringView} is {
    if vid.isZero then return
    i9: u64
    n9: xs.length
    for i9 < n9 loop {
        if (xs.get i: i9).vid == vid then {
            xs.set i: i9 val: (VidVal :vid val: val.string)
            return
        }
        i9 = i9 + 1
    }
    xs.append (VidVal :vid val: val.string)
}

# vvRemove -- drop `vid`'s entry (swap-with-last; vids are unique).
vvRemove: function {xs: List VidVal vid: ztypes.vid} is {
    if vid.isZero then return
    i9: u64
    n9: xs.length
    for i9 < n9 loop {
        if (xs.get i: i9).vid == vid then {
            last9: xs.pop
            if i9 + 1 < n9 then xs.set i: i9 val: last9
            return
        }
        i9 = i9 + 1
    }
}

# the type id bound to `vid` in `xs`, or none.
vtGet: function {xs: (List VidTid).view vid: ztypes.vid} out optionval ztypes.tid is {
    if vid.isZero then return (optionval.none ztypes.tid)
    i9: u64
    n9: xs.length
    for i9 < n9 loop {
        e9: xs.get i: i9
        if e9.vid == vid then return (optionval.some e9.tid)
        i9 = i9 + 1
    }
    return (optionval.none ztypes.tid)
}

# bind `vid` to type id `tid` in `xs`.
vtSet: function {xs: List VidTid vid: ztypes.vid tid: ztypes.tid} is {
    if vid.isZero then return
    i9: u64
    n9: xs.length
    for i9 < n9 loop {
        if (xs.get i: i9).vid == vid then {
            xs.set i: i9 val: (VidTid :vid :tid)
            return
        }
        i9 = i9 + 1
    }
    xs.append (VidTid :vid :tid)
}

# remove `vid`'s binding from `xs`.
vtRemove: function {xs: List VidTid vid: ztypes.vid} is {
    if vid.isZero then return
    i9: u64
    n9: xs.length
    for i9 < n9 loop {
        if (xs.get i: i9).vid == vid then {
            last9: xs.pop
            if i9 + 1 < n9 then xs.set i: i9 val: last9
            return
        }
        i9 = i9 + 1
    }
}

# aliasResolve -- a `.take` alias's base C name, or the name itself if none.
aliasResolve: function {ctx: Ctx.view name: StringView vid: ztypes.vid} out String is {
    # A match-arm narrowing (narrowBox) takes priority: inside the arm the
    # variable resolves to the narrowed union payload cast, not the un-narrowed
    # binding or a stale for-loop/borrow/take alias -- mirrors takeSourceResolve.
    # `name` is only what comes back when neither table has an entry.
    nb9: vvFind xs: ctx.narrowBox :vid
    if nb9 > 0 then return (ctx.narrowBox.get i: nb9 - 1).val.copy
    al9: vvFind xs: ctx.aliases :vid
    if al9 > 0 then return (ctx.aliases.get i: al9 - 1).val.copy
    return name.string
}

# takeSourceResolve -- the C lvalue to zero after a take of `name`: a match-arm
# narrowing's union box payload (narrowBox) takes priority over a plain `.take`
# alias, so the source zeroing invalidates the box, not just the narrowed copy.
takeSourceResolve: function {ctx: Ctx.view name: StringView vid: ztypes.vid} out String is {
    return (emitLocalAtomName :ctx :name :vid)
}

# isMoveMarker -- a value-position ownership-transfer marker. `.hold` is `.take`
# plus a compile-time freeze, so the two are indistinguishable to the emitter:
# both move the base value and leave the source to be zeroed.
isMoveMarker: function {name: StringView} out bool is {
    if name == "take" then return true
    if name == "hold" then return true
    return false
}

# takeAliasBase -- the base atom of a `<x>.take` over a user record/class (an
# ownership-transfer alias: the binding reuses the source storage), else "".
takeAliasBaseNid: function {ast: Ast.view symtab: zenv.ZSymbolTable n: Node.view} out u64 is {
    match (
        n
    ) case expression then {
        return (takeAliasBaseNid :ast :symtab n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (takeAliasBaseNid :ast :symtab n: (ast.nodes.get i: n.statementline.u64))
    } case dottedpath then {
        cn9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if (isMoveMarker name: cn9.stringview) == false then return 0
        bnid9: atomNodeId9 n: (ast.nodes.get i: n.parent.u64)
        bt9: stampIdOf :symtab nid: bnid9
        bo9: originTidOf :symtab tid: bt9
        if bo9 > 0 then return 0
        btt9: symtab.reg.typetypeOf typeId: bt9
        isUC9: false
        if btt9 == ztypes.ztypetype.recordType then isUC9 = true
        if btt9 == ztypes.ztypetype.classType then isUC9 = true
        if btt9 == ztypes.ztypetype.unionType then isUC9 = true
        if isUC9 then return bnid9
        return 0
    } else {
        return 0
    }
}

# takeAliasBase -- that base atom's text, derived from the node above so the
# name and the id can never describe different atoms.
takeAliasBase: function {ast: Ast.view symtab: zenv.ZSymbolTable.view n: Node.view} out String is {
    tbn9: takeAliasBaseNid :ast :symtab :n
    if tbn9 == 0 then return "".string
    return (atomTextOf :ast n: (ast.nodes.get i: tbn9))
}

# takeStringSource -- if `n` is a `<atom>.take` over a String value, the resolved
# C name of the source local to zero after the move (the callee now owns the
# heap buffer), else "". Used at the statement level to suppress a double free.
takeStringSource: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    n: Node.view
} out String is {
    match (
        n
    ) case expression then {
        return (takeStringSource :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (takeStringSource :ast :symtab :ctx n: (ast.nodes.get i: n.statementline.u64))
    } case dottedpath then {
        cn9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if (isMoveMarker name: cn9.stringview) == false then return "".string
        bnid9: atomNodeId9 n: (ast.nodes.get i: n.parent.u64)
        bid9: stampIdOf :symtab nid: bnid9
        isMv9: false
        sid09: stampIdOf :symtab nid: bnid9
        if sid09 == ctx.strTid then isMv9 = true
        if (symtab.reg.typetypeOf typeId: bid9) == ztypes.ztypetype.unionType then isMv9 = true
        if (symtab.reg.typetypeOf typeId: bid9) == ztypes.ztypetype.classType then {
            if (isPtrVid :ctx vid: (atomVid :symtab nid: bnid9)) == false then isMv9 = true
        }
        if (isMv9) == false then return "".string
        bn9r: atomTextOf :ast n: (ast.nodes.get i: n.parent.u64)
        return (takeSourceResolve :ctx name: bn9r.stringview vid: (atomVid :symtab nid: bnid9))
    } else {
        return "".string
    }
}

# takeMoveCtype -- the C type of a `<atom>.take` source (for the `(T){0}`
# zeroing), via typeRefC on the base's stamp (canonicalizes String to strC).
takeMoveCtype: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
} out String is {
    match (
        n
    ) case expression then {
        return (takeMoveCtype :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (takeMoveCtype :ast :symtab :ctx n: (ast.nodes.get i: n.statementline.u64))
    } case dottedpath then {
        bnid: atomNodeId9 n: (ast.nodes.get i: n.parent.u64)
        bid: stampIdOf :symtab nid: bnid
        return (typeRefC :ast :symtab :ctx tid: bid thisTid: ztypes.tid)
    } else {
        return "".string
    }
}

# isFieldTake -- true iff `n` reduces to a `<obj>.field.take` whose parent is
# itself a dotted path (a field, not a bare atom). The field lvalue is zeroed
# after the move so the owner's destructor does not double-free the payload the
# take aliased out (a bare `<x>.take` is handled by takeStringSource).
isFieldTake: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (isFieldTake :ast n: (ast.nodes.get i: n.expression.u64))
    } case statementline then {
        return (isFieldTake :ast n: (ast.nodes.get i: n.statementline.u64))
    } case dottedpath then {
        cn9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if (isMoveMarker name: cn9.stringview) == false then return false
        return (nodeIsDotted9 n: (ast.nodes.get i: n.parent.u64))
    } else {
        return false
    }
}

# emitNarrowedTakeZero -- before a return's scope cleanup, zero the payload box of
# every narrowed-subject `.take` reachable in the return value (a bare take, or a take
# passed as a construction/call arg). The un-shadowed narrowed subject is freed by the
# return cleanup; its `.take` moved the payload out as a shallow struct copy sharing the
# heap buffer, so the box must read {0} when the destructor walks it, else that buffer is
# double-freed. Non-narrowed takes are kept live by refsLocal and are not touched here.
# Mirrors the reference's implicit-take invalidation, flushed before scope cleanup.
emitNarrowedTakeZero: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    ind: StringView
    buf: String.borrow
} is {
    match (
        n
    ) case expression then {
        (emitNarrowedTakeZero
            :ast
            :symtab
            :ctx
            n: (ast.nodes.get i: n.expression.u64)
            :ind
            :buf
        )
    } case statementline then {
        sln9: ast.nodes.get i: n.statementline.u64
        emitNarrowedTakeZero :ast :symtab :ctx n: sln9 :ind :buf
    } case dottedpath then {
        cn9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if (isMoveMarker name: cn9.stringview) then {
            bn9: atomTextOf :ast n: (ast.nodes.get i: n.parent.u64)
            bn9v: atomVid :symtab nid: (atomNodeId9 n: (ast.nodes.get i: n.parent.u64))
            if (vvHas xs: ctx.narrowBox vid: bn9v) then {
                box9: takeSourceResolve :ctx name: bn9.stringview vid: bn9v
                tido9: vtGet xs: ctx.narrowTid vid: bn9v
                match (
                    tido9
                ) case some then {
                    ct9: (typeRefC
                        :ast
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: tido9.u64)
                        thisTid: ztypes.tid
                    )
                    inv9: "\{ind}\{box9} = (\{ct9}){0};\n"
                    buf.append inv9
                } case none then null
            }
        }
    } case call then {
        aiter9: n.arguments.iterate
        for a9Id9: aiter9 loop {
            a9: ast.nodes.get i: a9Id9.u64
            match (
                a9
            ) case namedoperation then {
                (emitNarrowedTakeZero
                    :ast
                    :symtab
                    :ctx
                    n: (ast.nodes.get i: a9.operation.u64)
                    :ind
                    :buf
                )
            } else null
        }
    } else null
}

# implicitTakeSourceAtom -- the C move-source lvalue of a bare atom, decided by
# the typechecker's stamps ALONE (the emitter never re-resolves a name; a local
# may legitimately shadow a type). A local variable (atomVariableId) is a move
# source; a def/type/fn reference (refDecl) is not; an atom the checker
# stamped as neither (e.g. a generator-promoted local, now instance state) is a
# plain value and IS a move source.
implicitTakeSourceAtom: function {
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    nid: u64
    nm: StringView
} out String is {
    avo9: symtab.typing.atomVariableId.get key: nid
    match (
        avo9
    ) case some then {
        return (takeSourceResolve :ctx name: nm vid: avo9)
    } case none then null
    udo9: symtab.typing.refDecl.get key: nid
    match (
        udo9
    ) case some then {
        return "".string
    } case none then null
    return (takeSourceResolve :ctx name: nm vid: (ztypes.vid.create from: 0))
}

# moveMarkerBase -- the base node id of an explicit `<x>.take` / `<x>.hold`,
# through any `expression` wrapper; 0 when the node is not a move marker.
moveMarkerBase: function {ast: Ast.view n: Node.view} out u64 is {
    match (
        n
    ) case expression then {
        return (moveMarkerBase :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        mbc9: atomTextOf :ast n: (ast.nodes.get i: n.child.u64)
        if (isMoveMarker name: mbc9.stringview) == false then return 0
        return n.parent.u64
    } else {
        return 0
    }
}

# isBareNameValue -- the value is a BARE name (through any expression wrapper).
# The binding legs test this before asking implicitTakeSource for a move source:
# that answer costs a String, and only a bare name can move an owned local.
isBareNameValue: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (isBareNameValue :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return true
    } case labelvalue then {
        return true
    } else {
        return false
    }
}

# the source path an implicit `.take` moves from, if any.
implicitTakeSource: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
} out String is {
    match (
        n
    ) case expression then {
        return (implicitTakeSource :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        itA9: ast.names.texts.get i: n.name.u64
        return (implicitTakeSourceAtom :symtab :ctx nid: n.nodeid.u64 nm: itA9.stringview)
    } case labelvalue then {
        itL9: ast.names.texts.get i: n.name.u64
        return (implicitTakeSourceAtom :symtab :ctx nid: n.nodeid.u64 nm: itL9.stringview)
    } else {
        return "".string
    }
}

# implicitTakeFnId -- the param-bearing type for a call's implicit-take check: a
# direct FUNCTION callable, else the constructed type's `create` child, else the
# type itself (a field-wise construction reads field ownership from the type).
implicitTakeFnId: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
} out u64 is {
    cn0: atomTextOf :ast n: (ast.nodes.get i: call.callable.u64)
    ct: userFnId :ast :symtab :ctx name: cn0.stringview
    if ct.isZero then {
        # A dotted method call resolves the method through the receiver's type,
        # not a bare-name lookup: a free function sharing the method's name
        # (zast.mkNamedOp vs the Parser.mkNamedOp method) otherwise wins below,
        # and its mismatched param names leave a moved-in owned arg un-zeroed.
        mdch0: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
        if mdch0.length > 0 then {
            xq229: ast.nodes.get i: call.callable.u64
            mrcv0: dottedReceiverStampId :ast :symtab callable: xq229
            if mrcv0 > 0 then {
                mmco0: (symtab.typing.declChildOf
                    pool: ast.names
                    parentTypeId: mrcv0
                    name: mdch0.stringview
                )
                match (
                    mmco0
                ) case some then {
                    if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: mmco0.u64)) == ztypes.ztypetype.functionType then {
                        ct = ztypes.tid.create from: (mmco0)
                    }
                } case none then null
            }
        }
    }
    if ct.isZero then {
        # a cross-unit construction's callable is a dotted path (e.g.
        # `zast.UnitData`); atomTextOf is empty, so resolve the type by its
        # child name to reach its consuming `create` below (the same-unit path
        # resolves via the bare-atom userFnId above). Without this the moved-in
        # owned arg is never zeroed -> double free at the owner's destructor.
        dn0: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
        if dn0.length > 0 then {
            rt0: resolveTypeIdByName :ast :symtab :ctx name: dn0.stringview
            if rt0 > 0 then ct = ztypes.tid.create from: rt0.u64
        }
    }
    xq219: ast.nodes.get i: call.callable.u64
    if ct.isZero then return (stampIdOf :symtab nid: (nodeIdOf9 n: xq219))
    if (symtab.reg.typetypeOf typeId: ct) == ztypes.ztypetype.functionType then return ct
    cco: symtab.typing.declChildOfId parentTypeId: ct nameId: zast.wkCreate
    match (
        cco
    ) case some then {
        if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: cco.u64)) == ztypes.ztypetype.functionType then return cco
    } case none then null
    return ct
}

# paramIsHold9 -- the LABELLED parameter this argument binds is declared `hold`.
# A hold param is passed by pointer and the callee never destroys it, so the
# caller keeps the storage and an explicit `.take` must NOT zero the source.
# Positional args keep the unconditional behaviour: the index-to-parameter walk
# misreads generic monos, and no positional case is known to need this.
paramIsHold9: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ftid: ztypes.tid
    label: StringView
} out bool is {
    if ftid.isZero then return false
    if label.length == 0 then return false
    return (symtab.typing.declOwnershipIs
        pool: ast.names
        parentTypeId: ftid
        name: label
        own: ztypes.zparamownership.holdMode
    )
}

# emitCallTakeInvalidations -- zero the source local of each ownership-moved arg
# of a call so its scope-exit destructor is a no-op (the move transferred
# ownership). An explicit `<atom>.take` uses takeStringSource; a bare owning-
# reftype local moved into a TAKE param is an implicit move (the hasDestructorName
# gate excludes borrow/lock views and scalars, which carry no destructor).
isCtorOwnerCall: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
} out bool is {
    smidO: stampIdOf :symtab nid: call.nodeid.u64
    bnO: dottedBaseAtom :ast n: (ast.nodes.get i: call.callable.u64)
    mcO9: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    if bnO.stringview == "meta" when mcO9.stringview == "create" then return true
    if (originIsTid
        :symtab
        tid: smidO
        originTid: ctx.optionOriginTid
    ) when bnO.stringview == "Option" then return true
    if (originIsTid
        :symtab
        tid: smidO
        originTid: ctx.resultOriginTid
    ) when bnO.stringview == "Result" then return true
    # user-defined union arm construction `MyUnion.arm <payload>`: the base atom
    # is the union TYPE (the child is the arm selector, not a type), so the
    # child-name resolution below misses it. The arm MOVES its payload into the
    # heap box, so the source must be zeroed.
    if bnO.length > 0 then {
        uctO: resolveTypeIdByName :ast :symtab :ctx name: bnO.stringview
        if uctO > 0 then {
            if (symtab.reg.typetypeOf typeId: (ztypes.tid.create from: uctO.u64)) == ztypes.ztypetype.unionType then {
                monoLk1: originTidOf :symtab tid: (ztypes.tid.create from: uctO.u64)
                if monoLk1.isZero then return true
            }
        }
    }
    cn0: atomTextOf :ast n: (ast.nodes.get i: call.callable.u64)
    ct: userFnId :ast :symtab :ctx name: cn0.stringview
    if ct.isZero then {
        # cross-unit construction (dotted callable, e.g. `zast.UnitData`):
        # resolve the constructed type by its child name so an owned arg moved
        # into a record/variant/class/union field is zeroed (else double free).
        dn0: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
        if dn0.length > 0 then {
            rt0: resolveTypeIdByName :ast :symtab :ctx name: dn0.stringview
            if rt0 > 0 then ct = ztypes.tid.create from: rt0.u64
        }
    }
    if ct.isZero then return false
    if (symtab.reg.typetypeOf typeId: ct) == ztypes.ztypetype.classType then return true
    if (symtab.reg.typetypeOf typeId: ct) == ztypes.ztypetype.unionType then return true
    if (symtab.reg.typetypeOf typeId: ct) == ztypes.ztypetype.recordType then return true
    if (symtab.reg.typetypeOf typeId: ct) == ztypes.ztypetype.variantType then return true
    return false
}

# emit the zeroing that invalidates arguments moved into a call.
emitCallTakeInvalidations: function {
    ast: Ast
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    call: zast.CallData.view
    ind: StringView
    buf: String.borrow
} is {
    ftid9: implicitTakeFnId :ast :symtab :ctx :call
    ctorOwner9: isCtorOwnerCall :ast :symtab :ctx :call
    mmn9: aliasChildName :ast :symtab n: (ast.nodes.get i: call.callable.u64)
    collMove9: false
    if mmn9.stringview == "append" then collMove9 = true
    if mmn9.stringview == "insert" then collMove9 = true
    if mmn9.stringview == "push" then collMove9 = true
    if collMove9 then {
        # The collection-move rule is for container elements; String.append
        # borrows its StringLike arg (byte copy), it never moves it.
        xr9: ast.nodes.get i: call.callable.u64
        rcm9: (chaseColMono
            :symtab
            :ctx
            tid: (dottedReceiverStampId :ast :symtab callable: xr9)
        )
        if rcm9 == ctx.strTid then collMove9 = false
    }
    posI9: u64
    aiter9: call.arguments.iterate
    for a9Id9: aiter9 loop {
        a9: ast.nodes.get i: a9Id9.u64
        match (
            a9
        ) case namedoperation then {
            ts9: takeStringSource :ast :symtab :ctx n: (ast.nodes.get i: a9.operation.u64)
            if ts9.length > 0 then {
                holdSkip9: false
                if (ctorOwner9) == false then holdSkip9 = (paramIsHold9
                    :ast
                    :symtab
                    ftid: (ztypes.tid.create from: ftid9.u64)
                    label: (zast.nameTextAt :ast ref: a9.name).stringview
                )
                if (holdSkip9) == false then {
                    tc9: (takeMoveCtype
                        :ast
                        :symtab
                        :ctx
                        n: (ast.nodes.get i: a9.operation.u64)
                    )
                    inv9: "\{ind}\{ts9} = (\{tc9}){0};\n"
                    buf.append inv9
                }
            } else {
                isTake9: ctorOwner9
                if collMove9 then isTake9 = true
                lbl9: zast.nameTextAt :ast ref: a9.name
                if lbl9.length > 0 then {
                    if (symtab.typing.declOwnershipIs
                        pool: ast.names
                        parentTypeId: (ztypes.tid.create from: ftid9.u64)
                        name: lbl9.stringview
                        own: ztypes.zparamownership.takeMode
                    ) then isTake9 = true
                    if (symtab.typing.declOwnershipIs
                        pool: ast.names
                        parentTypeId: (ztypes.tid.create from: ftid9.u64)
                        name: lbl9.stringview
                        own: ztypes.zparamownership.borrowMode
                    ) then isTake9 = false
                    # a hold param is passed by pointer and the CALLEE never
                    # destroys it, so the caller keeps the storage: zeroing its
                    # source here would strand the allocation
                    if (symtab.typing.declOwnershipIs
                        pool: ast.names
                        parentTypeId: (ztypes.tid.create from: ftid9.u64)
                        name: lbl9.stringview
                        own: ztypes.zparamownership.holdMode
                    ) then isTake9 = false
                } else {
                    pnames9: (List String)
                    pids9: (ListVal u64)
                    pids9Nm: (ListVal u64)
                    (recFieldLists
                        :ast
                        :symtab
                        tid: (ztypes.tid.create from: ftid9.u64)
                        names: pnames9
                        ids: pids9
                        nameIds: pids9Nm
                    )
                    off9: u64
                    if pnames9.length > 0 then {
                        p09: pnames9.get i: 0
                        if p09.stringview == "this" then off9 = 1
                    }
                    pidx9: posI9 + off9
                    if pidx9 < pnames9.length then {
                        pn9: pnames9.get i: pidx9
                        if (symtab.typing.declOwnershipIs
                            pool: ast.names
                            parentTypeId: (ztypes.tid.create from: ftid9.u64)
                            name: pn9.stringview
                            own: ztypes.zparamownership.takeMode
                        ) then isTake9 = true
                    }
                }
                if isTake9 then {
                    isrc9: (implicitTakeSource
                        :ast
                        :symtab
                        :ctx
                        n: (ast.nodes.get i: a9.operation.u64)
                    )
                    if isrc9.length > 0 then {
                        istid9: (stampIdOf
                            :symtab
                            nid: (nodeIdOf9 n: (ast.nodes.get i: a9.operation.u64))
                        )
                        if (isHeapPtrCollection :symtab :ctx tid: istid9) then {
                            iinvh9: "\{ind}\{isrc9} = NULL;\n"
                            buf.append iinvh9
                        } else {
                            if (symtab.reg.hasDestructorName typeId: istid9) then {
                                itc9: typeRefC :ast :symtab :ctx tid: istid9 thisTid: ztypes.tid
                                iinv9: "\{ind}\{isrc9} = (\{itc9}){0};\n"
                                buf.append iinv9
                            }
                        }
                    }
                }
            }
            (emitValueTakeInvalidations
                :ast
                :symtab
                :ctx
                n: (ast.nodes.get i: a9.operation.u64)
                :ind
                :buf
            )
            posI9 = posI9 + 1
        } else null
    }
}

# emitValueTakeInvalidations -- statement-level source zeroing for a value node
# that reduces to a call (unwraps expression/statementline wrappers).
emitValueTakeInvalidations: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
    ind: StringView
    buf: String.borrow
} is {
    match (
        n
    ) case expression then {
        iex69: ast.nodes.get i: n.expression.u64
        emitValueTakeInvalidations :ast :symtab :ctx n: iex69 :ind :buf
    } case statementline then {
        sln29: ast.nodes.get i: n.statementline.u64
        emitValueTakeInvalidations :ast :symtab :ctx n: sln29 :ind :buf
    } case call then {
        emitCallTakeInvalidations :ast :symtab :ctx call: n :ind :buf
    } else null
}

# needsAddM -- record a runtime demand as a (unit, member) pair. The fragment
# name is composed from the pair once, where the fragment is loaded; nothing
# else ever needs the two halves stuck together.
needsAddM: function {ctx: Ctx uname: StringView memb: StringView} is {
    if (needsHasM :ctx :uname :memb) then return
    ctx.needUnits.append from: uname.string
    ctx.needMembs.append from: memb.string
    if uname == "os" then osCrossNeeds9 :ctx :memb
}

# osCrossNeeds9 -- the io helpers an os native's body calls. os.env builds a C
# string out of a StringView and os.cwd maps errno to an IoError: that C is
# io's, so the demand is io's. Recorded HERE, where the os member is demanded,
# rather than recomputed at emission by reading os's demands back -- which is
# what let io's runtime gate on a predicate no row could state. Both names wear
# the `@` that marks a demand outside the member space: no declaration is
# called sv_cstr, and no fragment answers to the name alone.
osCrossNeeds9: function {ctx: Ctx memb: StringView} is {
    svc9: false
    if memb == "env" then svc9 = true
    if memb == "setEnv" then svc9 = true
    if memb == "unsetEnv" then svc9 = true
    if memb == "setCwd" then svc9 = true
    if memb == "spawn" then svc9 = true
    if svc9 then needsAddM :ctx uname: "io" memb: "@sv_cstr"
    er9: false
    if memb == "setEnv" then er9 = true
    if memb == "unsetEnv" then er9 = true
    if memb == "cwd" then er9 = true
    if memb == "setCwd" then er9 = true
    if memb == "userName" then er9 = true
    if memb == "homeDir" then er9 = true
    if memb == "hostname" then er9 = true
    if memb == "exePath" then er9 = true
    if er9 then needsAddM :ctx uname: "io" memb: "@errno"
}

# needsHasM -- true when the (unit, member) pair was demanded.
needsHasM: function {ctx: Ctx.view uname: StringView memb: StringView} out bool is {
    i9: u64
    n9: ctx.needUnits.length
    for i9 < n9 loop {
        u9: ctx.needUnits.get i: i9
        if u9.stringview == uname then {
            m9: ctx.needMembs.get i: i9
            if m9.stringview == memb then return true
        }
        i9 = i9 + 1
    }
    return false
}

# typeUseAdd -- record that the program constructed this type.
typeUseAdd: function {ctx: Ctx tid: ztypes.tid} is {
    ctx.usedTypeIds.set key: tid.u64 value: true
}

# typeStructEmitted9 -- this emitter wrote the type's struct, which is the
# reachability signal the conformance helpers need: they forward to the impl's
# methods, so emitting them for a type the program never reached names natives
# that were never loaded.
typeStructEmitted9: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    o9: ctx.emittedUserTypes.get key: tid
    match (
        o9
    ) case some then {
        return o9
    } case none then {
        return false
    }
}

# conformanceRowMark9 / conformanceRowEmitted9 -- a conformance row is one
# (impl, spec, label) triple and produces one set of wrappers, a vtable and the
# two create helpers. Emitted once, keyed by the row's index in the table.
conformanceRowMark9: function {ctx: Ctx row: u64} is {
    ctx.emittedConformance.set key: row value: true
}

conformanceRowEmitted9: function {ctx: Ctx.view row: u64} out bool is {
    o9: ctx.emittedConformance.get key: row
    match (
        o9
    ) case some then {
        return o9
    } case none then {
        return false
    }
}

# typeIsUsed -- the program constructed this type, so the rows its
# construction reaches have fired.
typeIsUsed: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    o9: ctx.usedTypeIds.get key: tid
    match (
        o9
    ) case some then {
        return o9
    } case none then {
        return false
    }
}

# typeDemandMet -- may this type's body be emitted? A type no fragment row
# gates is unconditional; one that IS gated waits until it is constructed,
# because its struct exists to be dereferenced by a fragment that is itself
# demand-loaded. The gating set comes from natives.tbl, not from a list here.
typeDemandMet: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    g9: ctx.demandGatedTids.get key: tid
    match (
        g9
    ) case some then {
        if (g9) == false then return true
    } case none then {
        return true
    }
    return (typeIsUsed :ctx :tid)
}

# true when `name` is a string-like type.
isStringy: function {name: StringView} out bool is {
    if name == "String" then return true
    if name == "StringView" then return true
    return false
}

# isStringyTid -- the id form of isStringy: tid is canonical String or StringView.
isStringyTid: function {ctx: Ctx.view tid: ztypes.tid} out bool is {
    if tid == ctx.strTid then return true
    return tid == ctx.svTid
}

# svValueForm -- a String/StringView operand as a by-value StringView C
# expression (a String operand view-converts via a compound literal).
svValueForm: function {ctx: Ctx.view expr: StringView isStr: bool vid: ztypes.vid} out String is {
    if isStr then {
        # callers hand this a bare atom name, so resolve it: a borrowed element
        # get binds the name to a deref projection, and the raw name has no
        # declaration. The pointer question is asked of `vid`, not of that text
        # -- but only when no alias intervened, since an alias means the value
        # being read is the projection and not the binding.
        rex9: aliasResolve :ctx name: expr :vid
        vid9: vid
        if rex9.stringview != expr then vid9 = ztypes.vid.create from: 0
        acc: ".".string
        if (isPtrVid :ctx vid: vid9) then acc = "->".string
        v1: "((\{ctx.svC}_t){ .data = \{rex9}\{acc}data, .size = \{rex9}\{acc}size })"
        return v1
    } else {
        v2: expr.string
        return v2
    }
}

# dottedBaseAtom / dottedChildText -- the parent atom and member name of
# a dotted path ("" when the shape is deeper than one segment).
# dottedBaseAtomId -- the base atom's interned name id (0 when absent). The
# id form of dottedBaseAtom, for callers that only need to identify the name.
dottedBaseAtomId: function {ast: Ast.view n: Node.view} out zast.nameid is {
    match (
        n
    ) case dottedpath then {
        return (atomNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}

dottedBaseAtom: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case dottedpath then {
        return (atomTextOf :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# the child member name of dotted-path node `n`.
dottedChildText: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case dottedpath then {
        return (atomTextOf :ast n: (ast.nodes.get i: n.child.u64))
    } else {
        return "".string
    }
}

# aliasOrChild / aliasChildName -- the internal member name a dotted-path node
# resolved to through a public-interface alias (typecheck stamp keyed on the
# dotted-path nodeid), else the plain AST child text. Centralizes rename-aware
# member-name emission so a renamed member emits its internal (declared) C name.
aliasOrChild: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    aliasId: zast.nodeid
    childId: u32
} out String is {
    if symtab.typing.renameSeen then {
        ai9: symtab.typing.aliasInternalNameOf nodeid: aliasId
        if ai9.length > 0 then return ai9
    }
    return (atomTextOf :ast n: (ast.nodes.get i: childId.u64))
}

# the emitted (internal) name of a possibly-renamed member access.
aliasChildName: function {ast: Ast.view symtab: zenv.ZSymbolTable.view n: Node.view} out String is {
    match (
        n
    ) case dottedpath then {
        return (aliasOrChild :ast :symtab aliasId: n.nodeid childId: n.child)
    } else {
        return "".string
    }
}

# stmtFormName9 -- the statement form a DOTTED callee resolves to ("print",
# "panic", "error", "return"), else "". Those four are core aliases onto natives
# in `io` and `system`, and the dispatch below reads the ATOM, so a program that
# spelled one qualified reached the generic native path instead: `io.print`
# failed at emit for want of a fragment it does not have, and `system.panic`
# emitted the mono's own cname as a function. Asking the resolved declaration
# routes both spellings to one emitter, and is what keeps a user unit's own
# `print` out of it.
stmtFormName9: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    ctx: Ctx.view
    n: Node.view
} out String is {
    # the child's pooled text, BORROWED: this runs for every dotted callee in
    # statement position, and four string compares do not need a copy of a name
    cid9: dottedChildNameIdOf :ast :n
    if cid9.isZero then return "".string
    mv9: zast.nameTextAt :ast ref: cid9
    isSf9: false
    if mv9.stringview == "print" then isSf9 = true
    if mv9.stringview == "panic" then isSf9 = true
    if mv9.stringview == "error" then isSf9 = true
    if mv9.stringview == "return" then isSf9 = true
    if (isSf9) == false then return "".string
    bid9: dottedBaseAtomId :ast :n
    if bid9.isZero then return "".string
    if (ztypecheck.isUnitNameDecl
        ty: symtab.typing
        reg: symtab.reg
        nameId: bid9
    ) == false then return "".string
    # ... and a DECLARATION of that name here shadows the unit: name ids are
    # pooled program-wide, so the unit probe answers either way
    base9: dottedBaseAtom :ast :n
    uq2z9: ztypecheck.unitDeclOfName ty: symtab.typing :ast name: ctx.mainName.stringview
    sh9: (ztypecheck.resolveUnitChild
        :ast
        ty: symtab.typing
        reg: symtab.reg
        unitDecl: uq2z9
        name: base9.stringview
    )
    match (
        sh9
    ) case some then {
        shT9: symtab.reg.typetypeOf typeId: (ztypes.tid.create from: sh9)
        if shT9 != ztypes.ztypetype.unitType then return "".string
    } case none then null
    ud0x9: ztypecheck.unitDeclOfNameId ty: symtab.typing nameId: bid9
    fo9: (ztypecheck.resolvedByIds
        :ast
        ty: symtab.typing

        unitDecl: ud0x9
        name: (dottedChildNameIdOf :ast :n)
    )
    match (
        fo9
    ) case some then {
        fid9: ztypes.tid.create from: (fo9)
        tt9: symtab.reg.typetypeOf typeId: fid9
        if tt9 != ztypes.ztypetype.functionType then return "".string
        if (fnIsNativeId :symtab fid: fid9) == false then return "".string
        return mv9.stringview.string
    } case none then null
    return "".string
}

# the child member name id of dotted-path node `n` (0 when not one).
dottedChildNameIdOf: function {ast: Ast.view n: Node.view} out zast.nameid is {
    match (
        n
    ) case dottedpath then {
        return (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}

# the middle segment's name id of a LEFT-nested `(a.B).c` path (0 otherwise).
dottedParentChildId: function {ast: Ast.view n: Node.view} out zast.nameid is {
    match (
        n
    ) case expression then {
        return (dottedParentChildId :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (dottedChildNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}

# aliasChildName's pool id: the internal (renamed) member id when a rename
# stamp exists, else the child atom's own name id.
aliasChildNameId: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable
    n: Node.view
} out zast.nameid is {
    match (
        n
    ) case dottedpath then {
        if symtab.typing.renameSeen then {
            ai9: symtab.typing.aliasInternalNameOf nodeid: n.nodeid
            if ai9.length > 0 then return (zast.poolFind pool: ast.names text: ai9.stringview)
        }
        return (atomNameIdOf :ast n: (ast.nodes.get i: n.child.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}

# the base node id of dotted-path node `n`.
dottedBaseNodeId: function {ast: Ast.view n: Node.view} out u64 is {
    match (
        n
    ) case dottedpath then {
        return (atomNodeId9 n: (ast.nodes.get i: n.parent.u64))
    } else {
        return 0
    }
}

# isSvParseNative -- a StringView parse native (parseF64/I64/U64) returning a
# resultval. Dispatched via ctx.svC so the canonical StringView cname is used
# (not a shell id stamped on a nested `.stringview` projection).
# isSvNoArgNative -- no-arg StringView natives whose fragments must be
# registered by the scanNeeds pre-pass: type-method bodies emit after
# the runtime pass, so an in-body demand comes too late to matter.
isSvNoArgNative: function {name: StringView} out bool is {
    if name == "count" then return true
    if name == "hash" then return true
    if name == "codepoints" then return true
    if name == "lines" then return true
    return false
}

# true when `name` is a native stringview-parse method.
isSvParseNative: function {name: StringView} out bool is {
    if name == "parseF64" then return true
    if name == "parseF16" then return true
    if name == "parseF128" then return true
    if name == "parseI64" then return true
    if name == "parseU64" then return true
    return false
}

# svNativeName -- the simple StringView-native set C2b supports (the
# pointer-arg predicates and trims; indexOf/byteAt wait on optionval
# struct emission).
isSvSimpleNative: function {name: StringView} out bool is {
    if name == "isEmpty" then return true
    if name == "isAscii" then return true
    if name == "startsWith" then return true
    if name == "endsWith" then return true
    if name == "contains" then return true
    if name == "trim" then return true
    if name == "trimStart" then return true
    if name == "trimEnd" then return true
    if name == "toLowerAscii" then return true
    if name == "toUpperAscii" then return true
    if name == "replace" then return true
    if name == "replaceFirst" then return true
    if name == "repeated" then return true
    if name == "concat" then return true
    return false
}

# isSvArgNative -- an arg-taking StringView native returning optionval/
# Option (indexOf/byteAt/lastIndexOf/stripPrefix/stripSuffix/splitOnce).
isSvArgNative: function {name: StringView} out bool is {
    if name == "indexOf" then return true
    if name == "lastIndexOf" then return true
    if name == "byteAt" then return true
    if name == "stripPrefix" then return true
    if name == "stripSuffix" then return true
    if name == "splitOnce" then return true
    return false
}

# svArgAddr -- the &-form of a StringView native argument (pooled
# literal or local view); "" when unsupported.
svArgAddr: function {
    ast: Ast.view
    symtab: zenv.ZSymbolTable.view
    ctx: Ctx.view
    n: Node.view
} out String is {
    match (
        n
    ) case expression then {
        return (svArgAddr :ast :symtab :ctx n: (ast.nodes.get i: n.expression.u64))
    } case atomstring then {
        li: litIndexOf :ctx nid: n.nodeid.u64
        if li > 0 then {
            a1: "&_zs\{li}"
            return a1
        } else {
            return "".string
        }
    } case atomid then {
        anSA9: ast.names.texts.get i: n.name.u64
        an: anSA9.stringview
        # scalar args pass BY VALUE (only string-like args are pointer-
        # passed): a numeric literal has no address at all, and a stamped
        # scalar variable must not be &-wrapped either
        b0d9: an.byteAt 0
        match (
            b0d9
        ) case some then {
            if b0d9 >= 48 when b0d9 <= 57 then return "".string
        } case none then null
        snm9: stampNameOf :symtab nid: n.nodeid.u64
        if (isIntName name: snm9.stringview) then return "".string
        if (isFloatName name: snm9.stringview) then return "".string
        # an ordinal pair is a C scalar, and passes like one
        if (isOrdinalVariant
            :symtab
            tid: (stampIdOf :symtab nid: n.nodeid.u64)
        ) then return "".string
        # A String arg to a StringLike param projects to a by-value view.
