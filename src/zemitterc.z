                    argRef9: String
                    ptra9: false
                    if (paramIsReceiverName
                        :ast
                        :symtab
                        fid: (ztypes.tid.create from: fid9.u64)
                        pname: fpnO9.stringview
                    ) then ptra9 = true
                    if (markedValtypeRefParam
                        :ast
                        :symtab
                        fid: (ztypes.tid.create from: fid9.u64)
                        pname: fpnO9.stringview
                        pid: fpid9
                    ) then ptra9 = true
                    if (symtab.typing.declOwnershipIs
                        pool: ast.names
                        parentTypeId: fid9
                        name: fpnO9.stringview
                        own: ztypes.zparamownership.takeMode
                    ) == false when (isReftypeParam
                        :ast
                        :symtab
                        :ctx
                        tid: (ztypes.tid.create from: fpid9.u64)
                    ) then {
                        ptra9 = true
                    } else {
