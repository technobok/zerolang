# zhash -- the 64-bit FNV-1a hash of a text's bytes, the same on every run.
# String.hash is seeded per process to keep a Map's buckets unguessable, so it
# differs from run to run; a cache folder's name, an object's cache key and the
# hash a served source is recorded with must be the same on each.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :stable
    :stableAfter
}

# fnv -- FNV-1a's 64-bit offset basis and prime
fnv: list {
    basis: 0xcbf29ce484222325
    prime: 0x100000001b3
} out staticlist u64

# stable -- the hash of `s`'s bytes
stable: function {s: StringView} out u64 is {
    return (fold h: fnv.basis :s)
}

# stableAfter -- the hash `h` continued over `s`'s bytes and then a 0 byte, so
# two splits of the same bytes hash apart
stableAfter: function {h: u64 s: StringView} out u64 is {
    return (fold :h :s) * fnv.prime
}

# fold -- the hash `h` continued over `s`'s bytes
fold: function {h: u64 s: StringView} out u64 is {
    r: h
    i: u64
    for i < s.length loop {
        r = (r ^ ((s.byteAt :i).or d: 0)) * fnv.prime
        i = i + 1
    }
    return r
}
