# zproject -- the project a driver runs in: the nearest project.zd at or above
# where it started, and the settings that file gives.
#
# A driver reads the settings before it builds anything, since they say where
# the source and the stdlib are. project.zd is a data file (docs/zdata.pdoc)
# whose `project` is a `toolchain.project` value: zdata checks it against that
# schema, found in the driver's own stdlib, and the settings are read off the
# value, every one its default where the file leaves it out. A flag the driver
# was given replaces the file's value outright. The build reads the settings
# through the generated unit `z.project` (projectText); project.zd itself is
# no unit of the program.
#
# No project.zd anywhere above is single-file mode: every setting is unset and
# each driver behaves as it does without one.

# Public interface -- the definitions other units may reference; all other
# top-level definitions are private to this unit.
public: unit {
    :BuildFacts
    :ProjectFile
    :discoverProject
    :initProject
    :inProject
    :writeLayer
    :zLayer
}

astnode: zast.astnode
Ast: zast.Ast

# projectFileName -- the file that marks a project's root and holds its
# settings
projectFileName: "project.zd"

# ProjectFile -- what a project.zd says, as read before the build. A string
# setting the file leaves out is "", a switch it leaves out is false: both mean
# "the driver's own default".
ProjectFile: class {
    # the directory holding project.zd, spelled from where the search began, so
    # relative when that was; "" when no project.zd was found
    dir: String
    # what is wrong with the file, each error rendered as a diagnostic; "" when
    # it read cleanly
    error: String
    # how many errors `error` holds
    errorCount: u64
    # the source roots, each relative to `dir` ("" for `dir` itself), the first
    # searched first
    sourceDirs: List String
    # whether the file gave `sourceDirs`: given and empty is no source root,
    # left out is `dir` itself
    sourceDirsGiven: bool
    # the stdlib directory, relative to `dir`
    systemDir: String
    # the project's programs, each a unit declaring `main`: what a build that
    # names no unit compiles, and what the language server searches
    programs: List String
    # the triple to build for
    target: String
    # where a build writes its executable, relative to `dir`
    outputDir: String
    # the C compiler to drive
    cCompiler: String
    # how the C compiler runs: spawn or inproc
    cCompilerMode: String
    # passed through to the C compile step
    cFlags: String
    # passed through to the link step
    linkFlags: String
    # the tcc runtime payload directory, relative to `dir`
    tccLibDir: String
    # build with optimisation
    release: bool
    # the emitter's cheaper name hash
    fastHash: bool
    # emit source names rather than numbered ones
    readableNames: bool
    # typecheck every definition, not only what main reaches
    eager: bool
} as {
    # create -- no project: every setting unset
    create: function out this is {
        return (
            meta.create
            dir: String
            error: String
            errorCount: 0
            sourceDirs: List String
            sourceDirsGiven: false
            systemDir: String
            programs: List String
            target: String
            outputDir: String
            cCompiler: String
            cCompilerMode: String
            cFlags: String
            linkFlags: String
            tccLibDir: String
            release: false
            fastHash: false
            readableNames: false
            eager: false
        )
    }

    # sourceRoots -- the source roots as a driver opens them, the first searched
    # first: each of `sourceDirs` under the project directory ("" is the
    # directory itself), or the project directory alone when the file gave none
    sourceRoots: function {t: this.view} out List String is {
        r: List String
        if t.sourceDirsGiven.not then {
            r.append from: t.dir.copy
            return r
        }
        for each d: t.sourceDirs loop r.append from: (t.rootAt rel: d.stringView)
        return r
    }

    # rootAt -- one source root, relative to the project directory, as a driver
    # opens it; "" is the project directory itself
    rootAt: function {t: this.view rel: StringView} out String is {
        if rel.length == 0 then return t.dir.copy
        return (inProject dir: t.dir.stringView :rel)
    }

    # rootHolding -- the source root the file at `path` lies under, "" when it
    # lies under none
    rootHolding: function {t: this.view path: StringView} out String is {
        for each sr: t.sourceRoots loop {
            if (relativeTo base: sr.stringView p: path).length > 0 then return sr.copy
        }
        return "".string
    }

    # sourceRootsFor -- the source roots, the one the file at `path` lies under
    # first: what a file is checked against, its own root being the one its
    # relpath is relative to
    sourceRootsFor: function {t: this.view path: StringView} out List String is {
        held: t.rootHolding :path
        r: List String
        if held.length > 0 then r.append from: held.copy
        for each sr: t.sourceRoots loop {
            if sr.stringView != held then r.append from: sr.copy
        }
        return r
    }

    # holdsSource -- whether the file at `path` lies under one of the project's
    # source roots
    holdsSource: function {t: this.view path: StringView} out bool is {
        return (t.rootHolding :path).length > 0
    }

    # found -- whether a project.zd was found at all
    found: function {t: this.view} out bool is {
        return t.dir.length > 0
    }
}

# dotsOnly -- whether path component `p` is exactly `n` dots: `.` or `..`
dotsOnly: function {p: StringView n: u64} out bool is {
    if p.length != n then return false
    i: u64
    for i < n loop {
        b: p.byteAt :i
        if b.some when b != 46 then return false
        i = i + 1
    }
    return true
}

# isRootPath -- whether `p` is a root and nothing more: `/`, and on Windows
# `C:\`, `\\server\share\` or `\`
isRootPath: function {p: StringView} out bool is {
    if p.length == 0 then return false
    return (path.rootLength :p) == p.length
}

# inProject -- a path project.zd gives, as the driver opens it: joined to the
# project directory unless it is absolute. "" stays "" (unset).
inProject: function {dir: StringView rel: StringView} out String is {
    if rel.length == 0 then return "".string
    if (path.rootLength p: rel) > 0 then return rel.string
    if (dotsOnly p: dir n: 1) then return rel.string
    return (path.join a: dir b: rel)
}

# discoverProject -- the project `start` (a directory) belongs to: the nearest
# project.zd at or above it, read against the schema in `systemdir`, the
# driver's own stdlib (the schema is the driver's: a project's own systemDir
# setting cannot name where the file that gives it is checked). No project.zd
# anywhere above is an empty ProjectFile, which is single-file mode. The
# check's parse shares the prelude through `prelude` (zparser.PreludeStore).
discoverProject: function {
    start: StringView systemdir: StringView prelude: zparser.PreludeStore
} out ProjectFile is {
    dir: findProjectDir :start
    if dir.length == 0 then return ProjectFile.create
    return (readProject dir: dir.stringView :systemdir :prelude)
}

# findProjectDir -- the nearest directory at or above `start` holding a
# project.zd, spelled by climbing from `start` (`src` climbs to `.`, then `..`),
# so a relative start answers a relative directory. "" when there is none up to
# the filesystem root.
findProjectDir: function {start: StringView} out String is {
    cand: trimSlash p: start
    if cand.length == 0 then cand = ".".string
    levels: depthOf p: (absoluteOf p: cand.stringView).stringView
    k: u64
    for k <= levels loop {
        pz: path.join a: cand.stringView b: projectFileName
        if (zcheck.pathKindIs path: pz.stringView want: io.filekind.file) then return cand
        cand = upOne p: cand.stringView
        k = k + 1
    }
    return "".string
}

# trimSlash -- `p` without trailing separators, its root kept
trimSlash: function {p: StringView} out String is {
    rl: path.rootLength :p
    e: p.length
    for e > rl while (path.isSeparator b: ((p.byteAt i: e - 1).or d: 0)) loop e = e - 1
    if e == 0 then return p.string
    return (p.substring from: 0 to: e).string
}

# absoluteOf -- `p` as an absolute path: itself when it is one, else under the
# working directory
absoluteOf: function {p: StringView} out String is {
    if (path.isAbsolute :p) then return p.string
    cw: os.cwd
    match (
        cw
    ) case ok then {
        return (path.join a: cw.stringView b: p)
    } case err then null
    return p.string
}

# depthOf -- how many directories an absolute path climbs through to reach the
# root: its non-empty components after the root, `..` included, which only
# over-counts
depthOf: function {p: StringView} out u64 is {
    n: u64
    inPiece: false
    i: path.rootLength :p
    for i < p.length loop {
        sep: path.isSeparator b: ((p.byteAt :i).or d: 0)
        if sep then inPiece = false
        if sep.not when inPiece.not then {
            n = n + 1
            inPiece = true
        }
        i = i + 1
    }
    return n
}

# upOne -- the directory holding `p`, spelled lexically: `src` -> `.`,
# `.` -> `..`, `..` -> `../..`, `/a` -> `/` (native separators on Windows)
upOne: function {p: StringView} out String is {
    if (dotsOnly :p n: 1) then return "..".string
    if (isRootPath :p) then return p.string
    last: path.baseName :p
    if (dotsOnly p: last.stringView n: 2) then return (path.join a: p b: "..")
    return (path.dirname :p)
}

# readProject -- the settings of `dir`/project.zd: its `project`, a
# `toolchain.project` value, checked by zdata against the schema in
# `systemdir`. What is wrong with the file is the result's `error`, every
# error rendered.
readProject: function {
    dir: StringView systemdir: StringView prelude: zparser.PreludeStore
} out ProjectFile is {
    pf: ProjectFile.create
    pf.dir = dir.string
    file: path.join a: dir b: projectFileName
    shown: displayOf path: file.stringView
    # with no stdlib there is no schema to read the file against, and nothing
    # the driver could build: its own report of the missing root is the one
    # that stops it
    if (zcheck.pathKindIs path: systemdir want: io.filekind.dir).not then return pf
    df: zdata.openShared file: file.stringView srcdirs: List String :systemdir :prelude
    if df.ok.not then {
        pf.error = zdata.errorsText f: df
        pf.errorCount = zdata.errorCount f: df
        return pf
    }
    v: zdata.definition f: df name: "project"
    if (zdata.isOfType f: df :v unitName: "toolchain" typeName: "project").not then {
        head: "error: \{shown} gives its settings as `project: (toolchain.project ...)`, and defines no such value"
        pf.error = diagnostic head: head.stringView shown: shown.stringView
        pf.errorCount = 1
        return pf
    }
    readFields :df :v into: pf
    twice: namedTwice items: pf.programs
    if twice.length > 0 then {
        twiceMsg: "error: 'programs' names '\{twice}' twice"
        pf.error = diagnostic head: twiceMsg.stringView shown: shown.stringView
        pf.errorCount = 1
    }
    return pf
}

# readFields -- each setting of `project` value `v` into `into`
readFields: function {df: zdata.DataFile.view v: ztypes.cval into: ProjectFile} is {
    into.sourceDirs = zdata.textsOf f: df v: (zdata.fieldOf f: df :v name: "sourceDirs")
    into.sourceDirsGiven = true
    into.programs = zdata.textsOf f: df v: (zdata.fieldOf f: df :v name: "programs")
    into.systemDir = zdata.textOf f: df v: (zdata.fieldOf f: df :v name: "systemDir")
    into.target = zdata.textOf f: df v: (zdata.fieldOf f: df :v name: "target")
    into.outputDir = zdata.textOf f: df v: (zdata.fieldOf f: df :v name: "outputDir")
    into.cCompiler = zdata.textOf f: df v: (zdata.fieldOf f: df :v name: "cCompiler")
    into.cCompilerMode = zdata.textOf f: df v: (zdata.fieldOf f: df :v name: "cCompilerMode")
    into.cFlags = zdata.textOf f: df v: (zdata.fieldOf f: df :v name: "cFlags")
    into.linkFlags = zdata.textOf f: df v: (zdata.fieldOf f: df :v name: "linkFlags")
    into.tccLibDir = zdata.textOf f: df v: (zdata.fieldOf f: df :v name: "tccLibDir")
    into.release = zdata.boolOf v: (zdata.fieldOf f: df :v name: "release")
    into.fastHash = zdata.boolOf v: (zdata.fieldOf f: df :v name: "fastHash")
    into.readableNames = zdata.boolOf v: (zdata.fieldOf f: df :v name: "readableNames")
    into.eager = zdata.boolOf v: (zdata.fieldOf f: df :v name: "eager")
}

# displayOf -- a path as a diagnostic names it: without a leading `./`
# (`.\` on Windows)
displayOf: function {path: StringView} out String is {
    rest: path.stripPrefix p: "./"
    if rest.some then {
        return rest.string
    }
    if z.build.os == z.build.oskind.windows then {
        rw: path.stripPrefix p: ".\\"
        match rw case some then return rw.string case none then null
    }
    return path.string
}

# namedTwice -- the first entry of `items` an earlier one repeats, "" when each
# is named once
namedTwice: function {items: (List String).view} out String is {
    i: u64
    for i < items.length loop {
        a: items.get :i
        j: u64
        for j < i loop {
            if (items.get i: j).stringView == a then return a.copy
            j = j + 1
        }
        i = i + 1
    }
    return "".string
}

# diagnostic -- `head` and the file it is about, as zc renders an error: the
# second line `--> path`
diagnostic: function {head: StringView shown: StringView} out String is {
    r: head.string
    r.append "\n --> "
    r.append shown
    return r
}

# BuildFacts -- the values one build uses, after every flag: what the generated
# z/build.z records. The C toolchain's settings are recorded only in its header
# comment: they are the backend's business, and no program reads them.
BuildFacts: class {
    # the --target triple as given, "" for the host
    triple: String
    # the src roots, the first searched first
    srcdirs: List String
    # the stdlib directory
    systemdir: String
    # the unit the build compiles
    main: String
    # the directory a build writes its executable to, as the driver spells
    # it; "" for the working directory
    outputDir: String
    # whether the build optimises, as --release asks
    release: bool
    # whether the emitter hashes names the cheaper way, as --fast-hash asks
    fastHash: bool
    # whether the C keeps source names, as --readable-names asks
    readableNames: bool
    # whether every definition is checked, not only what main reaches, as
    # --eager asks
    eager: bool
    # --cc as resolved, for the header comment only
    cCompiler: String
    # --cc-mode as resolved, for the header comment only
    cCompilerMode: String
    # --cflags, for the header comment only
    cFlags: String
    # --ldflags, for the header comment only
    linkFlags: String
    # --tcc-lib as resolved, for the header comment only
    tccLibDir: String
} as {
    # create -- the facts of a build that set nothing but its roots and its unit
    create: function {
        srcdirs: (List String).view
        systemdir: StringView
        main: StringView
    } out this is {
        r: (
            meta.create
            triple: String
            srcdirs: List String
            systemdir: systemdir.string
            main: main.string
            outputDir: String
            release: false
            fastHash: false
            readableNames: false
            eager: false
            cCompiler: String
            cCompilerMode: String
            cFlags: String
            linkFlags: String
            tccLibDir: String
        )
        for each d: srcdirs loop r.srcdirs.append from: d.copy
        return r
    }
}

# zLayer -- the generated `z` unit for one build: z.z, which publishes
# `build` and (in a project) `project`, z/build.z, the build's values, and in a
# project z/project.z, its settings (projectText). It lives in
# .zerolang/targets/<arch>-<os>/ beside the project's project.zd, or,
# with no project, in the user's cache directory, so nothing is written beside
# a lone source file. The build reads the text from memory and the copy on disk
# is for people and editors, so two builds running at once cannot read each
# other's values.
zLayer: function {pf: ProjectFile.view facts: BuildFacts.view} out zcheck.GenLayer is {
    osn: ztarget.targetOrHostOs triple: facts.triple.stringView
    arn: ztarget.targetOrHostArch triple: facts.triple.stringView
    key: arn.copy
    key.append "-"
    key.append osn
    base: layerBaseOf :pf :facts
    home: zerolangDirOf :pf :facts
    dir: String
    tsub: "targets/\{key}"
    if home.length > 0 then dir = path.join a: home.stringView b: tsub.stringView
    layer: (
        zcheck.GenLayer
        :dir
        paths: List String
        texts: List String
        served: facts.systemdir.copy
    )
    layer.paths.append from: "z.z".string
    layer.texts.append from: (zText hasProject: pf.found)
    layer.paths.append from: "z/build.z".string
    layer.texts.append from: (
        buildText
        :pf
        :facts
        base: base.stringView
        osName: osn.stringView
        archName: arn.stringView
        key: key.stringView
    )
    if pf.found then {
        layer.paths.append from: "z/project.z".string
        layer.texts.append from: (projectText :pf :facts)
    }
    return layer
}

# layerBaseOf -- the directory every path in z/build.z is relative to: the
# project's, or with no project the first src root, the main file's own
layerBaseOf: function {pf: ProjectFile.view facts: BuildFacts.view} out String is {
    if pf.found then return pf.dir.copy
    if facts.srcdirs.length == 0 then return ".".string
    return (facts.srcdirs.get i: 0).copy
}

# zerolangDirOf -- the compiler's own directory for this build: `.zerolang`
# beside project.zd, or with no project one under the user's cache directory
# keyed by the main file's directory -- the same key on every run, so each
# directory keeps one folder; "" when there is no cache directory
zerolangDirOf: function {pf: ProjectFile.view facts: BuildFacts.view} out String is {
    if pf.found then return (path.join a: pf.dir.stringView b: ".zerolang")
    cache: zcheck.cacheRoot
    if cache.length == 0 then return "".string
    base: layerBaseOf :pf :facts
    abs: cleanAbsolute p: base.stringView
    h: zcheck.stableHash s: abs.stringView
    sub: "zerolang/\{h}"
    return (path.join a: cache.stringView b: sub.stringView)
}

# writeLayer -- put the layer's files on disk, each only when its text
# changed, written whole to a name of its own and renamed into place, so a
# reader never sees half a file and a concurrent build's write is never torn.
# The compiler's directory gets a .gitignore of `*`: it is disposable. Silent
# when the directory cannot be written: the build reads the layer from memory.
writeLayer: function {layer: zcheck.GenLayer.view} is {
    if layer.dir.length == 0 then return
    zd: path.dirname p: (path.dirname p: layer.dir.stringView).stringView
    mk: io.mkdirp path: layer.dir
    if mk.err then return
    gi: path.join a: zd.stringView b: ".gitignore"
    writeIfChanged path: gi.stringView text: "*\n"
    i: u64
    for i < layer.paths.length loop {
        rel: layer.paths.get :i
        full: path.join a: layer.dir.stringView b: rel.stringView
        sub: path.dirname p: full.stringView
        io.mkdirp path: sub
        writeIfChanged path: full.stringView text: (layer.texts.get :i).stringView
        i = i + 1
    }
}

# writeIfChanged -- `text` into `path` unless it already holds exactly that:
# whole, under a name of its own, then renamed over the old file
writeIfChanged: function {path: StringView text: StringView} is {
    old: io.readText :path
    match (
        old
    ) case ok then {
        if old.stringView == text then return
    } case err then null
    pid: os.pid
    tmp: path.string
    tmp.append ".\{pid}.tmp"
    w: io.writeText path: tmp content: text
    if w.err then return
    mv: io.rename from: tmp to: path
    if mv.err then io.remove path: tmp
}

# projectText -- z/project.z: every setting of the project as a constant,
# each at its default where project.zd leaves it out, the switches as this
# build's flags left them
projectText: function {pf: ProjectFile.view facts: BuildFacts.view} out String is {
    t: String
    t.append "# project.z -- GENERATED by zc from project.zd for the build that wrote\n"
    t.append "# it; do not edit. Every setting of the project, at its default where\n"
    t.append "# project.zd leaves it out, and each switch as this build's flags left it.\n"
    t.append "# Read each as `z.project.<name>`.\n"
    t.append (textsLine name: "sourceDirs" items: pf.sourceDirs)
    t.append (textLine name: "systemDir" value: pf.systemDir.stringView)
    t.append (textsLine name: "programs" items: pf.programs)
    t.append (textLine name: "target" value: pf.target.stringView)
    t.append (textLine name: "outputDir" value: pf.outputDir.stringView)
    t.append (textLine name: "cCompiler" value: pf.cCompiler.stringView)
    t.append (textLine name: "cCompilerMode" value: pf.cCompilerMode.stringView)
    t.append (textLine name: "cFlags" value: pf.cFlags.stringView)
    t.append (textLine name: "linkFlags" value: pf.linkFlags.stringView)
    t.append (textLine name: "tccLibDir" value: pf.tccLibDir.stringView)
    t.append "release: \{facts.release}\n"
    t.append "fastHash: \{facts.fastHash}\n"
    t.append "readableNames: \{facts.readableNames}\n"
    t.append "eager: \{facts.eager}\n"
    return t
}

# textLine -- `name: "value"`, a string setting as z/project.z writes it
textLine: function {name: StringView value: StringView} out String is {
    t: name.string
    t.append ": "
    t.append (quoted s: value)
    t.append "\n"
    return t
}

# textsLine -- `name: list { "a" "b" } out staticlist StringView`, a list
# setting: its elements views of the program's static strings, as a string
# literal is
textsLine: function {name: StringView items: (List String).view} out String is {
    t: name.string
    t.append ": list {"
    for each it: items loop {
        t.append " "
        t.append (quoted s: it.stringView)
    }
    if items.length > 0 then t.append " "
    t.append "} out staticlist StringView\n"
    return t
}

# zText -- z.z: the unit a program names as `z`
zText: function {hasProject: bool} out String is {
    t: String
    t.append "# z.z -- GENERATED by zc for the build that wrote it; do not edit. zc\n"
    t.append "# rewrites it whenever a value changes, and the .zerolang directory\n"
    t.append "# holding it is safe to delete.\n"
    t.append "#\n"
    t.append "# `z.build` is what the build is: its target, its unit, its switches.\n"
    if hasProject then t.append "# `z.project` is the project's settings, as project.zd gives them.\n"
    t.append "public: unit {\n"
    t.append "    :build\n"
    if hasProject then t.append "    :project\n"
    t.append "}\n"
    return t
}

# buildText -- z/build.z: the build's values as constants, under a header
# that says where the build's units came from
buildText: function {
    pf: ProjectFile.view
    facts: BuildFacts.view
    base: StringView
    osName: StringView
    archName: StringView
    key: StringView
} out String is {
    t: buildHeader :pf :facts :base :key
    t.append kindsText
    t.append "\n# the operating system this build is for\n"
    t.append "os: oskind.\{osName}\n"
    t.append "\n# the architecture this build is for\n"
    t.append "arch: archkind.\{archName}\n"
    t.append "\n# the target triple: as --target or the project's target gave it, else the\n"
    t.append "# host's, as <arch>-<os>\n"
    tr: facts.triple.copy
    if tr.length == 0 then tr = key.string
    t.append "triple: \{quoted s: tr.stringView}\n"
    t.append "\n# the unit this build compiles\n"
    t.append "main: \{quoted s: facts.main.stringView}\n"
    t.append "\n# the source roots, the first searched first; \"\" for one outside the\n"
    t.append "# directory the paths here are relative to\n"
    t.append "sourceDirs: list {"
    for each sd: facts.srcdirs loop {
        rel: relativeTo :base p: sd.stringView
        t.append " \{quoted s: rel.stringView}"
    }
    t.append " } out staticlist StringView\n"
    odp: facts.outputDir.copy
    if odp.length == 0 then odp = ".".string
    od: relativeTo :base p: odp.stringView
    t.append "\n# where the build writes its executable when -o names no file; \"\" when it\n"
    t.append "# lies outside the directory the paths here are relative to\n"
    t.append "outputDir: \{quoted s: od.stringView}\n"
    t.append (
        switchLine
        doc: "built with optimisation (--release)"
        name: "release"
        value: facts.release
    )
    t.append (
        switchLine
        doc: "the emitter's cheaper name hash (--fast-hash)"
        name: "fastHash"
        value: facts.fastHash
    )
    t.append (
        switchLine
        doc: "source names in the C rather than numbered ones (--readable-names)"
        name: "readableNames"
        value: facts.readableNames
    )
    t.append (
        switchLine
        doc: "every definition typechecked, not only what main reaches (--eager)"
        name: "eager"
        value: facts.eager
    )
    t.append "\n# the version of zc that wrote this\n"
    ver: zversion.semver
    t.append "zcVersion: \{quoted s: ver.stringView}\n"
    return t
}

# buildHeader -- build.z's opening comment: what the file is, where each root
# of the build comes from, and the C toolchain, which no constant names
buildHeader: function {
    pf: ProjectFile.view
    facts: BuildFacts.view
    base: StringView
    key: StringView
} out String is {
    t: String
    t.append "# build.z -- GENERATED by zc: the values this build used, after every flag.\n"
    t.append "# Do not edit; zc rewrites it whenever a value changes. Read each as\n"
    t.append "# `z.build.<name>`. A path below is relative to "
    if pf.found then {
        t.append "the project directory, the\n# one holding project.zd.\n"
    } else {
        t.append "the main file's directory.\n"
    }
    t.append "#\n# Where the build's units come from, first searched first:\n"
    for each d: facts.srcdirs loop {
        t.append (layoutLine root: d.stringView :base what: "a source root")
    }
    if pf.found then {
        t.append "#   .zerolang/targets/\{key}  -- this unit and z.z (generated)\n"
    } else {
        t.append "#   (the user's cache directory)  -- this unit and z.z (generated)\n"
    }
    t.append (layoutLine root: facts.systemdir.stringView :base what: "the stdlib")
    t.append "#\n# The C toolchain: the backend's business, so no constant below names it.\n"
    t.append (commentPair name: "cCompiler" value: facts.cCompiler.stringView)
    t.append (commentPair name: "cCompilerMode" value: facts.cCompilerMode.stringView)
    t.append (commentPair name: "cFlags" value: facts.cFlags.stringView)
    t.append (commentPair name: "linkFlags" value: facts.linkFlags.stringView)
    tl: relativeTo :base p: facts.tccLibDir.stringView
    if tl.length == 0 then tl = "(outside this directory)".string
    t.append (commentPair name: "tccLibDir" value: tl.stringView)
    return t
}

# switchLine -- one switch of build.z, under its doc line
switchLine: function {doc: StringView name: StringView value: bool} out String is {
    v: "false"
    if value then v = "true"
    t: "\n# \{doc}\n"
    t.append name
    t.append ": "
    t.append v
    t.append "\n"
    return t
}

# kindsText -- the two kinds build.z's os and arch are values of
kindsText: function out String is {
    t: "\n".string
    t.append "# oskind -- operating-system family.\n"
    t.append "oskind: variant {\n"
    t.append "    # the Linux target: ELF objects and a glibc-shaped libc\n"
    t.append "    linux: null\n"
    t.append "    # macOS\n"
    t.append "    darwin: null\n"
    t.append "    # the Windows target: PE objects, and the one arm whose path separator\n"
    t.append "    # and executable suffix differ from the rest\n"
    t.append "    windows: null\n"
    t.append "    # an OS the build does not name; a guard on the OS should treat it as\n"
    t.append "    # unsupported rather than assume\n"
    t.append "    other: null\n"
    t.append "}\n"
    t.append "\n"
    t.append "# archkind -- CPU architecture family.\n"
    t.append "archkind: variant {\n"
    t.append "    # 64-bit x86\n"
    t.append "    x86_64: null\n"
    t.append "    # 64-bit ARM\n"
    t.append "    aarch64: null\n"
    t.append "    # an architecture the build does not name\n"
    t.append "    other: null\n"
    t.append "}\n"
    return t
}

# layoutLine -- one root of the layout comment: its path relative to `base`,
# or what it is when it lies outside
layoutLine: function {root: StringView base: StringView what: StringView} out String is {
    rel: relativeTo :base p: root
    if rel.length == 0 then return "#   (\{what}, outside this directory)\n"
    return "#   \{escapedText s: rel.stringView}  -- \{what}\n"
}

# commentPair -- `name: value` as a comment line
commentPair: function {name: StringView value: StringView} out String is {
    return "#   \{name}: \{escapedText s: value}\n"
}

# quoted -- `s` as a string literal (escapedText inside quotes)
quoted: function {s: StringView} out String is {
    r: "\"".string
    r.append (escapedText :s)
    r.append "\""
    return r
}

# escapedText -- `s` with every byte a literal or a comment line cannot hold as
# written escaped as the lexer reads it back: `"` and `\`, the line break and
# tab by name, and any other control byte (below 0x20, and 0x7F) as `\xHH`. A value of the build -- a path, a flag -- may hold any of
# them, and one written raw ends the comment line or the literal it sits in.
escapedText: function {s: StringView} out String is {
    r: String
    hex: "0123456789abcdef"
    i: u64
    for i < s.length loop {
        b: (s.byteAt :i).or d: 0
        i = i + 1
        if b == 34 then {
            r.append "\\\""
        } else if b == 92 then {
            r.append "\\\\"
        } else if b == 10 then {
            r.append "\\n"
        } else if b == 9 then {
            r.append "\\t"
        } else if (b < 32) or (b == 127) then {
            r.append "\\x"
            r.appendByte b: ((hex.byteAt i: b / 16).or d: 48)
            r.appendByte b: ((hex.byteAt i: b % 16).or d: 48)
        } else {
            r.appendByte :b
        }
    }
    return r
}

# relativeTo -- `p` relative to `base`, both as the driver spells them: "." for
# `base` itself, "" when `p` lies outside it (or is empty)
relativeTo: function {base: StringView p: StringView} out String is {
    if p.length == 0 then return "".string
    ab: cleanAbsolute p: base
    ap: cleanAbsolute :p
    if ap == ab then return ".".string
    pre: "\{ab}\{path.separator}"
    if (isRootPath p: ab.stringView) then pre = ab.copy
    rest: ap.stringView.stripPrefix p: pre
    if rest.some then {
        return rest.string
    }
    return "".string
}

# cleanAbsolute -- `p` as an absolute path with `.` and `..` resolved by name
# (path.clean, which climbs no higher than the root)
cleanAbsolute: function {p: StringView} out String is {
    abs: absoluteOf :p
    return (path.clean p: abs.stringView)
}

# initProject -- `zc init`: make `dir` a project. Writes project.zd with every
# setting present and commented out at its default, each under a line saying
# what it is, and the compiler's .zerolang directory. When `dir` holds no `.z`
# file it also writes main.z, a unit printing a greeting, and sets `main` to
# it, so `zc build` works at once. Refuses a directory that already holds a
# project.zd. Answers each path written, one per line, or the refusal.
initProject: function {dir: StringView} out InitResult is {
    pz: path.join a: dir b: projectFileName
    pzs: displayOf path: pz.stringView
    if (io.exists path: pz) then {
        return (InitResult ok: false text: "zc init: \{pzs} already exists")
    }
    fresh: (dirHoldsUnits :dir).not
    w: io.writeText path: pz content: (projectTemplate withMain: fresh)
    if w.err then return (InitResult ok: false text: "zc init: cannot write \{pzs}")
    done: "wrote \{pzs}\n"
    if fresh then {
        mz: path.join a: dir b: "main.z"
        mzs: displayOf path: mz.stringView
        wm: io.writeText path: mz content: mainTemplate
        if wm.err then return (InitResult ok: false text: "zc init: cannot write \{mzs}")
        done.append "wrote \{mzs}\n"
    }
    zd: path.join a: dir b: ".zerolang"
    io.mkdirp path: zd
    gi: path.join a: zd.stringView b: ".gitignore"
    writeIfChanged path: gi.stringView text: "*\n"
    gis: displayOf path: gi.stringView
    done.append "wrote \{gis}\n"
    return (InitResult ok: true text: done.take)
}

# InitResult -- what `zc init` did: each path it wrote, or why it refused
InitResult: class {
    # false when the directory was refused or a file could not be written
    ok: bool
    # the paths written, one per line, or the refusal
    text: String
}

# dirHoldsUnits -- whether directory `dir` holds a `.z` file
dirHoldsUnits: function {dir: StringView} out bool is {
    ls: io.listDir path: dir
    if ls.err then return false
    for each e: ls loop {
        if (e.stringView.endsWith suffix: ".z") then return true
    }
    return false
}

# projectTemplate -- the project.zd `zc init` writes: every setting, commented
# out at its default but the source roots, which make it a construction;
# `programs` set to main.z's unit when init wrote that too
projectTemplate: function {withMain: bool} out String is {
    t: String
    t.append "# project.zd -- this directory is a zerolang project. zc, zl and zls\n"
    t.append "# started anywhere below it read their settings here: `project`, a\n"
    t.append "# toolchain.project value (docs/zdata.pdoc). Every setting is optional and\n"
    t.append "# shown at its default; a flag given to zc replaces it outright. A path is\n"
    t.append "# relative to this directory.\n"
    t.append "project: (\n"
    t.append "    toolchain.project\n"
    t.append "    # the directories holding the project's units, the first searched first\n"
    t.append "    # (--src)\n"
    t.append "    sourceDirs: list { \".\" }\n"
    t.append "    # the project's programs, each a unit declaring `main`: `zc build` builds\n"
    t.append "    # them all when it names no unit, and `zc run` runs the one listed\n"
    if withMain then {
        t.append "    programs: list { \"main\" }\n"
    } else {
        t.append "    # programs: list { \"main\" }\n"
    }
    t.append "    # where `zc build` writes the executable (-o names a file instead)\n"
    t.append "    # outputDir: \".\"\n"
    t.append "    # the target triple to build for (--target); unset builds for the host\n"
    t.append "    # target: \"x86_64-linux\"\n"
    t.append "    # build with optimisation (--release)\n"
    t.append "    # release: false\n"
    t.append "    # the emitter's cheaper name hash (--fast-hash)\n"
    t.append "    # fastHash: false\n"
    t.append "    # source names in the C rather than numbered ones (--readable-names)\n"
    t.append "    # readableNames: false\n"
    t.append "    # typecheck every definition, not only what main reaches (--eager)\n"
    t.append "    # eager: false\n"
    t.append "    # the stdlib directory (--system); unset uses the one installed with zc\n"
    t.append "    # systemDir: \"lib/system\"\n"
    t.append "    # the C compiler (--cc); unset picks one for the target\n"
    t.append "    # cCompiler: \"cc\"\n"
    t.append "    # how the C compiler runs, spawn or inproc (--cc-mode)\n"
    t.append "    # cCompilerMode: \"spawn\"\n"
    t.append "    # passed through to the C compile step (--cflags)\n"
    t.append "    # cFlags: \"\"\n"
    t.append "    # passed through to the link step (--ldflags)\n"
    t.append "    # linkFlags: \"\"\n"
    t.append "    # the tcc runtime payload directory (--tcc-lib); unset uses the vendored one\n"
    t.append "    # tccLibDir: \"\"\n"
    t.append ")\n"
    return t
}

# mainTemplate -- the main.z `zc init` writes into an empty directory
mainTemplate: function out StringView is {
    return "# main.z -- the project's main unit: `zc run` builds and runs it\nmain: function is {\n    print \"Hello, world! (built for \\{z.build.triple})\"\n}\n"
}
