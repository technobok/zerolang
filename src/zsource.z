# zsource -- the analysis facade for zl. The fast tier reads and parses a
# single file (no VFS, no typecheck), builds a 1-based line table, and collects
# any embedded parse errors as ERROR diagnostics; the full tier (`--full`)
# builds the project VFS and typechecks for the type-dependent rules. The
# Analysis carries what the reporter and the fixer need.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :Analysis
    :analyzeFileTiered
    :analyzeSource
    :lintedUnitNamed
    :lintedUnitOf
    :lintopts
    :defaultOpts
    :complexityThreshold
    :lineDiffEdits
    :renderDiff
    :sourceParses
    :topUnitPathOf
    :unitAnchorFsno
    :unitNameOf
}

astnode: zast.astnode
Ast: zast.Ast

# lintopts -- which optional rules a lint run enables. One value threads from
# the command line to every rule, so a new rule is a field here, not a
# parameter added to every layer between them.
lintopts: record {
    # run the typecheck-tier rules too, which needs the project's src and system
    # directories
    full: bool
    # the column width to wrap at, and to report W005 against; 0 turns both off
    lineLength: u32
    # run L009, the variant/union member casing rule
    casing: bool
    # run L016, undocumented definitions
    docs: bool
    # run L017, undocumented parameters
    docParams: bool
    # run L018, undocumented members
    docFields: bool
    # measure a unit's WHOLE surface rather than only its `public:` block.
    # Without it a unit exporting a handful of names reports almost nothing
    docsPrivate: bool
    # run L024 and L025, which judge the docs that exist rather than counting
    # the ones missing
    docsQuality: bool
    # run the A-codes, which are advisory and ratcheted rather than gating
    arch: bool
    # the cognitive-complexity threshold A008 reports against; 0 turns the rule
    # off. `--arch` sets the default, `--complexity N` overrides it
    complexity: u32
}

# defaultOpts -- the fast tier with every optional rule off.
defaultOpts: function {} out lintopts is {
    return (lintopts
        full: false
        lineLength: 0
        casing: false
        docs: false
        docParams: false
        docFields: false
        docsPrivate: false
        docsQuality: false
        arch: false
        complexity: 0
    )
}

# ---- AST query helpers for the parse-tier rules ----

# The line count above which A005 reports a function. It counts RAW SOURCE SPAN from
# the definition to the deepest statement its body reaches, so a doc comment and an
# exploded parameter list both push a function toward it. A body that is one `match`
# is exempt: a dispatcher is as long as the arms it names.
longFunctionLines: 150.u32

# The body length from which A006 compares shapes: below it a match is a
# coincidence of small bodies, not a copy.
duplicateBodyLines: 8.u32

# The cognitive complexity above which A008 reports a function: SonarSource's
# default. `--complexity N` overrides it, and 0 turns the rule off.
complexityThreshold: 15.u32

# casingKindOf -- the kind an object definition's name is cased by: its own,
# or for a typedef its base's.
casingKindOf: function {ast: Ast.view opId: zast.nodeid} out zast.objectkind is {
    op: ast.nodes.get i: opId
    match (
        op
    ) case objectdef then {
        if op.kind == zast.objectkind.typedefDef then {
            b0: zast.kidAt kids: ast.kids span: op.isItems i: 0
            return (typedefCasingKind :ast baseId: b0)
        }
        return op.kind
    } else {
        return zast.objectkind.recordDef
    }
}

# typedefCasingKind -- the family a typedef's name is cased by: its base's,
# read off the base's own name, since that name is cased by its family too. A
# capitalised base is a reftype and makes the typedef read as a class; any
# other, a record. A parameterized base is read by its head, a dotted one by
# its last segment.
typedefCasingKind: function {ast: Ast.view baseId: zast.nodeid} out zast.objectkind is {
    hid: baseId
    bn: ast.nodes.get i: baseId
    match (
        bn
    ) case call then {
        hid = bn.callable
    } else null
    nm: zast.nameid
    {
        hn: ast.nodes.get i: hid
        match (
            hn
        ) case atomid then {
            nm = hn.name
        } case dottedpath then {
            cn: ast.nodes.get i: hn.child
            if cn.atomid then nm = cn.name
        } else null
    }
    if nm.isZero then return zast.objectkind.recordDef
    tx: zast.nameTextAt :ast ref: nm
    fb: tx.stringView.byteAt i: 0
    match (
        fb
    ) case some then {
        if fb >= 65 when fb <= 90 then return zast.objectkind.classDef
    } case none then null
    return zast.objectkind.recordDef
}

# sameFile -- whether two paths name one filesystem object: the same device
# and inode, whatever the spelling. False when either cannot be read.
sameFile: function {a: StringView b: StringView} out bool is {
    sa: io.stat path: a
    sb: io.stat path: b
    match (
        sa
    ) case ok then {
        match (
            sb
        ) case ok then {
            return (sa.device == sb.device) and (sa.inode == sb.inode)
        } case err then null
    } case err then null
    return false
}

# unitNamesIn -- the unit names of the `.z` files directly under `dir`.
unitNamesIn: function {dir: StringView} out List String is {
    names: List String
    ents: io.listDir path: dir
    match (
        ents
    ) case ok then {
        for each e: ents loop {
            ev: e.stringView
            if (ev.endsWith suffix: ".z") then names.append from: (ev.substring
                from: 0
                to: ev.length - 2
            ).string
        }
    } case err then null
    return names
}

# projectReadNames -- the member names dotted reads reach in every `.z` file
# directly under `dir`, as text: a parse per file, the reassignment targets
# excluded (a write is not a read).
projectReadNames: function {dir: StringView into: Set String} is {
    ents: io.listDir path: dir
    match (
        ents
    ) case ok then {
        for each e: ents loop {
            ev: e.stringView
            if (ev.endsWith suffix: ".z") then {
                fp: "\{dir}/\{ev}"
                rd: io.readText path: fp
                match (
                    rd
                ) case ok then {
                    fileReadNames root: (ast.parseSource source: rd.take) :into
                } case err then null
            }
        }
    } case err then null
}

# projectUnitReads -- the member names read as `<unit>.<name>` in every `.z` file
# directly under `dir` other than the unit's own, as text: a parse per file.
projectUnitReads: function {dir: StringView uname: StringView into: Set String} is {
    own: "\{uname}.z"
    ents: io.listDir path: dir
    match (
        ents
    ) case ok then {
        for each e: ents loop {
            ev: e.stringView
            if (ev.endsWith suffix: ".z") when ev != own then {
                fp: "\{dir}/\{ev}"
                rd: io.readText path: fp
                match (
                    rd
                ) case ok then {
                    fileUnitReads root: (ast.parseSource source: rd.take) :uname :into
                } case err then null
            }
        }
    } case err then null
}

# fileUnitReads -- the child names of every `<unit>.<child>` dotted path in one
# parsed file, into `into`. A deeper path `unit.a.b` reads `a`, the export.
fileUnitReads: function {root: Ast.view uname: StringView into: Set String} is {
    {
        uid: zast.poolFind pool: root.names text: uname
        if uid.isZero then return
        ni: zast.nodeid
        ni = ni.next
        nn: root.nodes.length
        for ni.u64 < nn loop {
            nd: root.nodes.get i: ni
            if nd.dottedpath then {
                pn: root.nodes.get i: nd.parent
                if pn.atomid when pn.name == uid then {
                    cn: root.nodes.get i: nd.child
                    if cn.atomid then {
                        into.add item: (zast.poolTextCopy pool: root.names ref: cn.name)
                    }
                }
            }
            ni = ni.next
        }
    }
}

# fileReadNames -- the dotted member reads of one parsed file, into `into`.
fileReadNames: function {root: Ast.view into: Set String} is {
    {
        topaths: IdSet zast.nodeid
        ni: zast.nodeid
        ni = ni.next
        nn: root.nodes.length
        for ni.u64 < nn loop {
            nd: root.nodes.get i: ni
            if nd.reassignment then {
                topaths.add item: nd.topath
            }
            ni = ni.next
        }
        nj: zast.nodeid
        nj = nj.next
        for nj.u64 < nn loop {
            nd2: root.nodes.get i: nj
            if nd2.dottedpath when (topaths.has item: nj).not then {
                cn: root.nodes.get i: nd2.child
                if cn.atomid then {
                    into.add item: (zast.poolTextCopy pool: root.names ref: cn.name)
                }
            }
            nj = nj.next
        }
    }
}

# plainLiteralText -- the text of a string literal with no interpolation
# (one literal chunk), none for any other node.
plainLiteralText: function {ast: Ast.view n: astnode.view} out Option String is {
    match (
        n
    ) case atomstring then {
        if n.stringparts.count.u64 != 1 then return (Option.none String)
        c: ast.nodes.get i: (zast.kidAt kids: ast.kids span: n.stringparts i: 0)
        match (
            c
        ) case stringchunk then {
            return (Option.some (zast.poolTextCopy pool: ast.names ref: c.text))
        } else {
            return (Option.none String)
        }
    } else {
        return (Option.none String)
    }
}

# lineLeavesBlock -- statement line `id` is a `return`, `break` or `continue`
# (bare, or a call of one), which leaves the block: nothing after it runs.
lineLeavesBlock: function {ast: Ast.view id: zast.nodeid} out bool is {
    cur: id
    depth: 0
    for depth < 4 loop {
        n: ast.nodes.get i: cur
        match (
            n
        ) case statementline then {
            cur = n.statementline
        } case call then {
            cur = n.callable
        } case atomid then {
            if n.name == zast.names.wkReturn then return true
            if n.name == zast.names.wkBreak then return true
            return n.name == zast.names.wkContinue
        } else return false
        depth = depth + 1
    }
    return false
}

# bodyKeyInto -- the shape of the subtree at `id`, appended to `buf`: every arm
# name, each binary operator and each literal chunk kept, every other name
# folded away. Two bodies with the same key differ only in what they call
# things -- the field they read, the map they probe, the helper they forward
# to -- which is what A006 exists to find.
bodyKeyInto: function {ast: Ast.view id: zast.nodeid buf: String.borrow} is {
    n: ast.nodes.get i: id
    buf.append s: (zast.armName :n)
    match (
        n
    ) case stringchunk then {
        buf.appendByte b: 34
        buf.append s: (zast.nameTextAt :ast ref: n.text)
    } else null
    buf.appendByte b: 40
    kids: zast.childIdsAt :ast :id
    for each k: kids loop {
        bodyKeyInto :ast id: k :buf
        buf.appendByte b: 44
    }
    buf.appendByte b: 41
}

# bodyIsOneMatch -- the body is a single statement and that statement is a
# `match` over TWO OR MORE arms: a dispatcher, whose length is the number of
# arms it names. A one-arm match is a guard that unwraps its subject, not a
# dispatcher, and the body it guards is as long as it reads.
bodyIsOneMatch: function {ast: Ast.view bodyId: zast.nodeid} out bool is {
    if (zast.stmtLineCount :ast nid: bodyId) != 1 then return false
    id: zast.stmtLineAt :ast nid: bodyId i: 0
    depth: 0
    for depth < 4 loop {
        n: ast.nodes.get i: id
        match (
            n
        ) case statementline then {
            id = n.statementline
        } case caseexpr then {
            return n.clauses.count.u64 > 1
        } else return false
        depth = depth + 1
    }
    return false
}

# CcState -- the running score of one function's complexity walk, a class so
# the recursion below adds to one value
CcState: class {
    # the score so far
    score: u32
}

# soleIfOf -- the `if` a body holds when it is exactly one `if` statement (an
# `else if`), 0 otherwise.
soleIfOf: function {ast: Ast.view bodyId: zast.nodeid} out zast.nodeid is {
    zero: zast.nodeid
    if bodyId.isZero then return zero
    if (zast.stmtLineCount :ast nid: bodyId) != 1 then return zero
    id: zast.stmtLineAt :ast nid: bodyId i: 0
    depth: 0
    for depth < 4 loop {
        n: ast.nodes.get i: id
        match (
            n
        ) case statementline then {
            id = n.statementline
        } case ifexpr then {
            return id
        } else return zero
        depth = depth + 1
    }
    return zero
}

# ccSelfRef -- whether `id` spells the function being scored: its bare name,
# or `this.` followed by it. A reference to a function calls it, so either is
# a recursive call.
ccSelfRef: function {ast: Ast.view id: zast.nodeid fnName: zast.nameid} out bool is {
    n: ast.nodes.get i: id
    match (
        n
    ) case atomid then {
        return n.name == fnName
    } case dottedpath then {
        p: ast.nodes.get i: n.parent
        isThis: false
        match (
            p
        ) case atomid then {
            if p.name == zast.names.wkThis then isThis = true
        } else null
        if isThis then {
            c: ast.nodes.get i: n.child
            match (
                c
            ) case atomid then {
                return c.name == fnName
            } else null
        }
    } else null
    return false
}

# ccVisitSpan -- ccVisit over every node of a span
ccVisitSpan: function {
    ast: Ast.view span: zast.kidspan nesting: u32 fnName: zast.nameid acc: CcState
} is {
    i: u64
    for i < span.count loop {
        kid: zast.kidAt kids: ast.kids :span :i
        i = i + 1
        ccVisit :ast id: kid :nesting :fnName :acc
    }
}

# ccArms -- ccVisit over each match arm's body, the arm names skipped: an arm
# named like the function is not a call
ccArms: function {
    ast: Ast.view span: zast.kidspan nesting: u32 fnName: zast.nameid acc: CcState
} is {
    i: u64
    for i < span.count loop {
        kid: zast.kidAt kids: ast.kids :span :i
        i = i + 1
        c: ast.nodes.get i: kid
        match (
            c
        ) case caseclause then {
            ccVisit :ast id: c.statement :nesting :fnName :acc
        } else null
    }
}

# ccIf -- an `if`: one plus its nesting for the first clause, unless it
# continues an `else if` chain whose `else` paid, one for each further clause,
# one for a `when` chain, the bodies one level deeper; then the `else`: one
# for an `else if`, walked as a chained if at the same nesting, one for a
# plain `else` with its body one level deeper
ccIf: function {
    ast: Ast.view
    clauses: zast.kidspan
    elseclause: zast.nodeid
    chained: bool
    nesting: u32
    fnName: zast.nameid
    acc: CcState
} is {
    ci: u64
    for ci < clauses.count loop {
        cid: zast.kidAt kids: ast.kids span: clauses i: ci
        ci = ci + 1
        c: ast.nodes.get i: cid
        match (
            c
        ) case ifclause then {
            if ci == 1 then {
                if chained.not then acc.score = acc.score + 1 + nesting
            } else {
                acc.score = acc.score + 1
            }
            if c.conditions.count > 1 then acc.score = acc.score + 1
            ccVisitSpan :ast span: c.conditions :nesting :fnName :acc
            ccVisit :ast id: c.statement nesting: nesting + 1 :fnName :acc
        } else null
    }
    if elseclause.isZero then return
    inner: soleIfOf :ast bodyId: elseclause
    acc.score = acc.score + 1
    if inner.isZero then {
        ccVisit :ast id: elseclause nesting: nesting + 1 :fnName :acc
    } else {
        m: ast.nodes.get i: inner
        match (
            m
        ) case ifexpr then {
            (ccIf
                :ast
                clauses: m.clauses
                elseclause: m.elseclause
                chained: true
                :nesting
                :fnName
                :acc
            )
        } else null
    }
}

# ccVisit -- add `id`'s contribution at `nesting` to `acc`, then its
# children's: an `if`, `for` or `match` costs one plus its nesting and nests
# its bodies, a chained header condition costs one, a recursive call costs
# one, a nested function literal nests its body and costs nothing, and
# everything else is walked through
ccVisit: function {ast: Ast.view id: zast.nodeid nesting: u32 fnName: zast.nameid acc: CcState} is {
    if id.isZero then return
    n: ast.nodes.get i: id
    match (
        n
    ) case ifexpr then {
        (ccIf
            :ast
            clauses: n.clauses
            elseclause: n.elseclause
            chained: false
            :nesting
            :fnName
            :acc
        )
    } case forexpr then {
        acc.score = acc.score + 1 + nesting
        if (n.conditions.count + n.postconditions.count) > 1 then acc.score = acc.score + 1
        ccVisitSpan :ast span: n.conditions :nesting :fnName :acc
        ccVisit :ast id: n.body nesting: nesting + 1 :fnName :acc
        ccVisitSpan :ast span: n.postconditions :nesting :fnName :acc
    } case caseexpr then {
        acc.score = acc.score + 1 + nesting
        ccVisit :ast id: n.subject :nesting :fnName :acc
        ccArms :ast span: n.clauses nesting: nesting + 1 :fnName :acc
        ccVisit :ast id: n.elseclause nesting: nesting + 1 :fnName :acc
    } case functiondef then {
        ccVisit :ast id: n.body nesting: nesting + 1 :fnName :acc
    } case call then {
        if (ccSelfRef :ast id: n.callable :fnName) then acc.score = acc.score + 1
        ccVisitSpan :ast span: n.arguments :nesting :fnName :acc
    } case atomid then {
        if n.name == fnName then acc.score = acc.score + 1
    } case dottedpath then {
        if (ccSelfRef :ast :id :fnName) then {
            acc.score = acc.score + 1
        } else {
            ccVisit :ast id: n.parent :nesting :fnName :acc
        }
    } else {
        kids: zast.childIds :ast :n
        for each k: kids loop {
            ccVisit :ast id: k :nesting :fnName :acc
        }
    }
}

# isComposedParts -- a string literal's parts shaped like a composed key: two
# or more interpolation holes joined by a short separator with no space
# (`"\{a}.\{b}"`, `"\{unit}_\{name}"`). A message with holes reads as prose
# between them and is not one.
isComposedParts: function {ast: Ast.view parts: zast.kidspan} out bool is {
    holes: u64
    sepSinceHole: false
    composed: false
    h10x9: u64
    for h10x9 < parts.count loop {
        pId: zast.kidAt kids: ast.kids span: parts i: h10x9
        h10x9 = h10x9 + 1
        part: ast.nodes.get i: pId
        match (
            part
        ) case stringchunk then {
            if holes > 0 when (isKeySeparator s: (zast.nameTextAt
                :ast
                ref: part.text
            ).stringView
            ) then sepSinceHole = true
        } else {
            if holes > 0 when sepSinceHole then composed = true
            holes = holes + 1
            sepSinceHole = false
        }
    }
    return composed
}

# isKeySeparator -- one or two bytes, neither a space nor a path separator:
# what joins the halves of a composed key (a path is composed too, and is not
# a key).
isKeySeparator: function {s: StringView} out bool is {
    return (
        (s.length > 0) and
        (s.length <= 2) and
        (s.contains needle: " ").not and
        (s.contains
            needle: "/"
        ).not
    )
}

# atomName -- the identifier name of an atomid node, else "".
atomName: function {ast: Ast.view n: astnode.view} out String is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return ""
    }
}

# isStatementArm -- the node is a braced `{ ... }` statement block.
isStatementArm: function {n: astnode.view} out bool is {
    match (
        n
    ) case statement then {
        return true
    } else {
        return false
    }
}

# isEmptyBlock -- a statement block with no statement lines (`{}`).
isEmptyBlock: function {n: astnode.view} out bool is {
    match (
        n
    ) case statement then {
        return n.statements.count.u64 == 0
    } else {
        return false
    }
}

# stmtPos -- the source position of a statement block.
stmtPos: function {n: astnode.view} out zast.nodepos is {
    match (
        n
    ) case statement then {
        return (zast.nodepos line: n.lineno col: n.colno)
    } else {
        return (zast.nodepos line: 0 col: 0)
    }
}

# isIfArm -- the node is an `if`.
isIfArm: function {n: astnode.view} out bool is {
    match (
        n
    ) case ifexpr then {
        return true
    } else {
        return false
    }
}

# slIsIf -- a statement line wrapping an `if`.
slIsIf: function {ast: Ast.view sl: astnode.view} out bool is {
    match (
        sl
    ) case statementline then {
        return (isIfArm n: (ast.nodes.get i: sl.statementline))
    } else {
        return false
    }
}

# flagbind -- a `name: true` / `name: false` statement line: the local and the
# literal it was bound to; both 0 for any other line.
flagbind: record {
    name: zast.nameid
    lit: zast.nameid
}

# innerNodeIdOf -- `id` with its statement line peeled: the node a statement
# line actually holds.
innerNodeIdOf: function {ast: Ast.view id: zast.nodeid} out zast.nodeid is {
    n: ast.nodes.get i: id
    match (
        n
    ) case statementline then {
        return (innerNodeIdOf :ast id: n.statementline)
    } else {
        return id
    }
}

# singleLineBodyOf -- the one statement an `if` clause's block holds, wrappers
# peeled; 0 when the block holds any other number of lines.
singleLineBodyOf: function {ast: Ast.view clauseId: zast.nodeid} out zast.nodeid is {
    c: ast.nodes.get i: clauseId
    match (
        c
    ) case ifclause then {
        b: ast.nodes.get i: c.statement
        match (
            b
        ) case statement then {
            if b.statements.count.u64 != 1 then return zast.nodeid
            first: zast.kidAt kids: ast.kids span: b.statements i: 0
            return (innerNodeIdOf :ast id: first)
        } else {
            return zast.nodeid
        }
    } else {
        return zast.nodeid
    }
}

# isElseIfWrap -- the else clause is the synthetic block an `else if` chain parses
# to (a single statement line wrapping an `if`), not a real braced `else { ... }`.
isElseIfWrap: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case statement then {
        if n.statements.count.u64 == 1 then {
            res: false
            stx769: u64
            for stx769 < n.statements.count loop {
                slId: zast.kidAt kids: ast.kids span: n.statements i: stx769
                stx769 = stx769 + 1
                sl: ast.nodes.get i: slId
                res = slIsIf :ast :sl
            }
            return res
        }
        return false
    } else {
        return false
    }
}

# primaryGenericParam -- the elidable first parameter name of a built-in template,
# or "" when `name` is not such a template. Index 0 only.
#
# The names are literals because this unit is the front end and has no symbol
# table to ask a template for its own. That makes the table the one place a
# parameter rename can go stale silently: a wrong entry stops L003 firing and
# nothing else here goes red. tests/fixtures/lsp_cases/lint_elidelabel pins one
# entry from each of the three groups so it cannot.
primaryGenericParam: function {name: StringView} out String is {
    if name == "List" then return "T"
    if name == "ListRef" then return "T"
    if name == "ListVal" then return "t"
    if name == "ListView" then return "T"
    if name == "ListViewVal" then return "t"
    if name == "Set" then return "K"
    if name == "SetRef" then return "K"
    if name == "SetVal" then return "k"
    if name == "array" then return "t"
    if name == "Map" then return "K"
    if name == "MapRR" then return "K"
    if name == "MapRV" then return "K"
    if name == "MapVR" then return "k"
    if name == "MapVV" then return "k"
    if name == "option" then return "t"
    if name == "optionval" then return "t"
    if name == "Option" then return "T"
    if name == "OptionView" then return "T"
    if name == "Result" then return "T"
    return ""
}


# casingSuggest -- the lowerCamelCase form of an ALL-CAPS / SCREAMING_SNAKE member name:
# split on `_`, lowercase each segment, and capitalise the first letter of every segment
# after the first. Compounds without underscores become run-together lowercase.
casingSuggest: function {name: StringView} out String is {
    buf: String
    n: name.length
    cap: false
    i: u64
    for i < n loop {
        bo: name.byteAt :i
        match (
            bo
        ) case some then {
            if bo == 95 then {
                cap = true
            } else {
                c: bo
                if c >= 65 when c <= 90 then c = c + 32
                if cap when buf.length > 0 when c >= 97 when c <= 122 then c = c - 32
                buf.appendByte b: c
                cap = false
            }
        } case none then null
        i = i + 1
    }
    return buf
}

# casingClash -- true when `s` (a proposed lowercase member name) collides with a language
# keyword or a future-reserved word, and so cannot be used as-is.
casingClash: function {s: StringView} out bool is {
    kr: zlexer.kwlookup sv: s
    if kr.found then return true
    return (zlexer.islookupReserved sv: s)
}

# ---- L024/L025 doc-quality helpers (parse tier) ----

# docByteAt -- the byte at `i`, 0 past the end. The rules below index bytes constantly
# and none of them can act on an absent one.
docByteAt: function {s: StringView i: u64} out u8 is {
    bo: s.byteAt :i
    match (
        bo
    ) case some then {
        c: bo
        return c
    } case none then null
    return 0
}

# simplePathFirstAtom -- the first atom of a plain name or a dotted path of
# names (`x`, `a.b.c`), or 0 when `id` is anything else.
simplePathFirstAtom: function {ast: Ast.view id: zast.nodeid} out zast.nodeid is {
    n: ast.nodes.get i: id
    match (
        n
    ) case atomid then {
        return id
    } case dottedpath then {
        if (atomNameIdOf n: (ast.nodes.get i: n.child)).isZero then return zast.nodeid
        return (simplePathFirstAtom :ast id: n.parent)
    } else {
        return zast.nodeid
    }
}

# simplePathLastAtom -- the last atom of a path simplePathFirstAtom accepts.
simplePathLastAtom: function {ast: Ast.view id: zast.nodeid} out zast.nodeid is {
    n: ast.nodes.get i: id
    match (
        n
    ) case dottedpath then {
        return n.child
    } else {
        return id
    }
}

# atomNameIdOf -- an atom's interned name id, 0 when the node is not an atom
# (no pool id is 0, so a compare against it misses).
atomNameIdOf: function {n: astnode.view} out zast.nameid is {
    match (
        n
    ) case atomid then {
        return n.name
    } else {
        return zast.nameid
    }
}

# trimBackWs -- `hi` moved back over the whitespace before it.
trimBackWs: function {s: StringView hi: u64} out u64 is {
    h: hi
    for h > 0 loop {
        if (byteIsWs b: (docByteAt :s i: h - 1)).not then return h
        h = h - 1
    }
    return h
}

# byteIsWs -- a space, tab or line-end byte.
byteIsWs: function {b: u8} out bool is {
    return (b == 32) or (b == 9) or (b == 10) or (b == 13)
}

# parenGroupStart -- the index of the `(` matching the `)` at `close - 1`; 0 when
# that byte is not a `)` or nothing matches it (no operand starts at byte 0).
parenGroupStart: function {s: StringView close: u64} out u64 is {
    if close == 0 then return 0
    if (docByteAt :s i: close - 1) != 41 then return 0
    depth: 0
    i: close
    for i > 0 loop {
        i = i - 1
        b: docByteAt :s :i
        if b == 41 then depth = depth + 1
        if b == 40 then {
            depth = depth - 1
            if depth == 0 then return i
        }
    }
    return 0
}

# onlyOpensBetween -- every byte in [lo, hi) is a `(` or whitespace: the gap
# between a paren group's `(` and the operand the tree positions inside it.
onlyOpensBetween: function {s: StringView lo: u64 hi: u64} out bool is {
    i: lo
    for i < hi loop {
        b: docByteAt :s :i
        if b != 40 when (byteIsWs :b).not then return false
        i = i + 1
    }
    return true
}

# docByteIsWord -- true for the ASCII letters and digits a word is made of. Everything
# else -- punctuation, backticks, the `--` dash, path separators -- is a boundary.
docByteIsWord: function {b: u8} out bool is {
    return (b >= 97) and (b <= 122) or ((b >= 65) and (b <= 90)) or ((b >= 48) and (b <= 57))
}

# docIsStopword -- true for a function word every doc shares, which therefore says
# nothing about what this one adds. One space-delimited string tested by substring
# rather than a compare chain: a table of literal compares is the shape A001 exists to
# discourage, and this needs no ids because a stopword IS its spelling.
docIsStopword: function {w: StringView} out bool is {
    if w.length == 0 then return true
    sw: " a an and any are as at be but by can for from has have if in into is it its may no not of on once one only or other over own same so than that the their them then there these they this those to up when where which while with without "
    probe: " \{w} "
    return (sw.contains needle: probe)
}

# docWordsInto -- append the lowercase alphanumeric runs of `s` to `into`.
docWordsInto: function {s: StringView into: List String} is {
    run: String
    i: u64
    n: s.length
    for i < n loop {
        c: docByteAt :s :i
        if (docByteIsWord b: c) then {
            if c >= 65 when c <= 90 then c = c + 32
            run.appendByte b: c
        } else {
            if run.length > 0 then {
                into.append from: run.copy
                run = ""
            }
        }
        i = i + 1
    }
    if run.length > 0 then into.append from: run.copy
}

# docAddRun -- one alphanumeric run of a declaration: the run lowercased, then each of
# its camel-case segments, so `ZSymbolTable` also offers `symbol` and `table` and a doc
# reading "the symbol table" is recognised as saying what the type already says.
docAddRun: function {run: StringView into: List String} is {
    whole: String
    seg: String
    i: u64
    n: run.length
    for i < n loop {
        c: docByteAt s: run :i
        isUp: false
        if c >= 65 when c <= 90 then isUp = true
        if isUp when seg.length > 0 then {
            into.append from: seg.copy
            seg = ""
        }
        if isUp then c = c + 32
        seg.appendByte b: c
        whole.appendByte b: c
        i = i + 1
    }
    if seg.length > 0 then into.append from: seg.copy
    if whole.length > 0 then into.append from: whole.copy
}

# docVocabInto -- the vocabulary a declaration line offers a reader: every alphanumeric
# run in it and every camel-case segment of those runs. A doc built only from these adds
# nothing the name and the type cannot, which is the bar a comment has to clear.
docVocabInto: function {s: StringView into: List String} is {
    run: String
    i: u64
    n: s.length
    for i < n loop {
        c: docByteAt :s :i
        if (docByteIsWord b: c) then {
            run.appendByte b: c
        } else {
            if run.length > 0 then {
                docAddRun run: run.stringView :into
                run = ""
            }
        }
        i = i + 1
    }
    if run.length > 0 then docAddRun run: run.stringView :into
}

# docHasWord -- membership by spelling. The list is a handful of words from one source
# line, so a scan beats building a set for it.
docHasWord: function {xs: (List String).view w: StringView} out bool is {
    found: false
    for each e: xs loop {
        if e.stringView == w then found = true
    }
    return found
}

# docFoldTemplate -- the words of a doc body with every word the declaration itself
# supplies, and every word carrying a digit (a width, a count), folded to `_`: a body
# written once per type or per bit-width reads as the one body it is.
docFoldTemplate: function {
    words: (List String).view
    vocab: (List String).view
} out List String is {
    folded: List String
    for each w: words loop {
        fold: docHasWord xs: vocab w: w.stringView
        if fold.not then fold = docHasDigit w: w.stringView
        if fold then {
            folded.append from: "_".string
        } else {
            folded.append from: w.copy
        }
    }
    return folded
}

# docHasDigit -- the word carries a decimal digit.
docHasDigit: function {w: StringView} out bool is {
    i: u64
    n: w.length
    for i < n loop {
        c: docByteAt s: w :i
        if c >= 48 when c <= 57 then return true
        i = i + 1
    }
    return false
}

# docJoinWords -- the words joined by single spaces: the normalised key two doc bodies
# are the same under. Case, punctuation and wrapping all wash out here, so a comment
# re-wrapped at a different width still matches its twin.
docJoinWords: function {xs: (List String).view} out String is {
    buf: String
    for each w: xs loop {
        if buf.length > 0 then buf.appendByte b: 32
        buf.append s: w
    }
    return buf
}

# docStripComment -- the declaration text of a source line, its trailing `#` comment
# removed. The comment is what is being judged, so it cannot also be the evidence.
docStripComment: function {ln: StringView} outx StringView is {
    i: u64
    n: ln.length
    for i < n loop {
        c: docByteAt s: ln :i
        if c == 35 then return (ln.substring from: 0 to: i)
        i = i + 1
    }
    return ln
}

# docTrailingComment -- the text after a line's `#`, "" when it has none. A member may
# be documented by a trailing comment instead of a block above, and both forms are read
# by hover, so both are judged.
docTrailingComment: function {ln: StringView} out String is {
    i: u64
    n: ln.length
    for i < n loop {
        c: docByteAt s: ln :i
        if c == 35 then {
            t: ln.substring from: i + 1 to: n
            return t.trim.string
        }
        i = i + 1
    }
    return ""
}

# docStartsLine -- true when column `col` is the first non-space character of its line,
# so the declaration standing there owns the doc block above it. A parameter sharing the
# function's head line does not: the block above is the FUNCTION's doc, and a trailing
# comment belongs to whichever declaration on the line comes last.
docStartsLine: function {ln: StringView col: u32} out bool is {
    if col < 1 then return false
    n: (col - 1).u64
    if n > ln.length then return false
    i: u64
    for i < n loop {
        c: docByteAt s: ln :i
        isSpace: (c == 32) or (c == 9)
        if isSpace.not then return false
        i = i + 1
    }
    return true
}

# docLineIsComment -- true when the line's first non-space character is `#`.
docLineIsComment: function {ln: StringView} out bool is {
    t: ln.trim
    return (t.startsWith "#")
}

# ---- L023 generic-param-casing helpers (parse tier) ----

# genericBoundBase -- the bound's base identifier as WRITTEN in a generic
# parameter declaration: `AnyRef` out of `AnyRef.generic`, and out of the
# parenthesised `(AnyRef.generic default: null)` form. "" when the leaf is
# `.valtype` or `.reftype`, which name a kind rather than a type and so carry
# no case to compare -- a shape the parser accepts and the typechecker rejects
# (`Unknown type 'reftype'`), so the arm is defensive, not reachable from a
# program that compiles. It unwraps the same call `zast.isGenericParamOp`
# does, and must keep doing so: a reader that unwrapped
# fewer would report the shapes it never looked at as conformant, and the
# parenthesised form is the one parameter in the tree that would go unseen.
genericBoundBase: function {ast: Ast.view opId: zast.nodeid} out String is {
    if opId.isZero then return ""
    n: ast.nodes.get i: opId
    match (
        n
    ) case call then {
        return (genericBoundBase :ast opId: n.callable)
    } case dottedpath then {
        if (zast.markerKindOfLeaf :ast leaf: n.child).genericBound.not then return ""
        return (atomName :ast n: (ast.nodes.get i: n.parent))
    } else {
        return ""
    }
}

# byteIsUpper -- true when an optional source byte is an ASCII capital.
byteIsUpper: function {b: optionval u8} out bool is {
    match (
        b
    ) case some then {
        if b >= 65 when b <= 90 then return true
        return false
    } case none then {
        return false
    }
}

# flipFirstCase -- `s` with its first ASCII letter's case inverted, which is the
# spelling the case rule asks for. A name that starts with neither case comes
# back unchanged.
flipFirstCase: function {s: StringView} out String is {
    buf: String
    n: s.length
    i: u64
    for i < n loop {
        bo: s.byteAt :i
        match (
            bo
        ) case some then {
            c: bo
            if i == 0 then {
                d: c
                if c >= 65 when c <= 90 then d = c + 32
                if c >= 97 when c <= 122 then d = c - 32
                c = d
            }
            buf.appendByte b: c
        } case none then null
        i = i + 1
    }
    return buf
}

# casingMessage -- the L009 diagnostic text: a direct rename when the lowerCamelCase form is
# usable, or a role-suffixed alternative when it clashes with a keyword/reserved word.
casingMessage: function {orig: StringView sug: StringView} out String is {
    if (casingClash s: sug) then {
        return "member '\{orig}' is not lowerCamelCase -- '\{sug}' is a keyword; use a role suffix, e.g. '\{sug}Kind' (type-kind) / '\{sug}Def' (AST node)"
    }
    return "member '\{orig}' is not lowerCamelCase -- rename to '\{sug}'"
}

# endsWithNewline -- true if `src` is empty or its last byte is a newline.
endsWithNewline: function {src: StringView} out bool is {
    n: src.length
    if n == 0 then return true
    bo: src.byteAt i: n - 1
    match (
        bo
    ) case some then {
        if bo == 10 then return true
        return false
    } case none then {
        return true
    }
}

# DiagSrc -- where a diagnostic found in ANOTHER file than the linted one is
# shown: that file's path, and its source line when it has one.
DiagSrc: class {
    # the file the diagnostic is in, as its root spells it
    path: String
    # the source line it points at
    line: String
    # whether `line` was read; false leaves the diagnostic without a snippet
    hasLine: bool
}

# the working state of one file's lint/format analysis: the source and
# its line table, the collected diagnostics and fix edits, and the raw
# token stream shared across the checks.
Analysis: class {
    # the file being analysed, for the diagnostics to name
    path: String
    # its full text, owned for the analysis's life
    source: String
    # the text split into lines, which the doc rules read directly rather than
    # through the tree
    lines: List String
    # each line's byte offset, so a token's position converts to an offset
    # without rescanning
    lineStart: ListVal u64
    # the findings, in the order they were made
    diags: List zdiag.Diagnostic
    # the byte-range replacements a fix would apply
    edits: List zfix.Edit
    # the token stream, for the rules that need tokens and not a tree
    fastToks: ListVal tokenize.token
    # how deep in nested functions the walk is
    funcDepth: u64
    # the pool ids of `true` and `false` in this file, 0 when absent, so the
    # boolean-literal rule compares ids and never spellings
    trueId: zast.nameid
    falseId: zast.nameid
    # each diagnostic found in another file, keyed by its index in `diags`: the
    # full tier places it while the project's file system is still there
    elsewhere: (IdMapR u32 V: DiagSrc)
    # which optional rules this run enables. One value threads from the command
    # line to every rule, so a new rule is a field here and not a parameter on
    # every layer between
    opts: lintopts
} as {
    # parseErrorCount -- how many collected diagnostics are hard (ERROR) -- i.e.
    # parse errors. The fmt parse gate refuses any file with a non-zero count.
    parseErrorCount: function {this: this.view} out u64 is {
        c: u64
        for each d: this.diags loop {
            match (
                d.sev
            ) case error then {
                c = c + 1
            } else null
        }
        return c
    }

    # failCount -- diagnostics that fail the gate: everything except advisory INFO. `zl lint` exits
    # non-zero on a non-zero count, so INFO rules (line-length) report without failing.
    failCount: function {this: this.view} out u64 is {
        c: u64
        for each d: this.diags loop {
            isInfo: false
            match (
                d.sev
            ) case info then {
                isInfo = true
            } else null
            if isInfo.not then c = c + 1
        }
        return c
    }

    # warnFix -- append a WARNING diagnostic AND its single safe fix edit (a
    # replacement of source[lo, hi) with `repl`). Used by the format rules.
    warnFix: function {
        :this
        code: StringView
        msg: String.take
        line: u32
        col: u32
        width: u32
        lo: u64
        hi: u64
        repl: String.take
    } is {
        this.warn :code :msg :line :col :width
        this.edits.append (zfix.Edit byteLo: lo byteHi: hi replacement: repl)
    }

    # walkOptAt -- the id-taking entry (0 = absent).
    walkOptAt: function {:this ast: Ast.view oId: zast.nodeid} is {
        if oId.isZero then return
        o: ast.nodes.get i: oId
        this.walk :ast n: o
    }

    # warn -- append a WARNING lint diagnostic (fast tier: no fsno; the single-file
    # reporter resolves the source line from the line table).
    warn: function {:this code: StringView msg: String.take line: u32 col: u32 width: u32} is {
        d: (zdiag.Diagnostic
            code: code.string
            sev: zdiag.severity.warning
            fsno: zvfs.fsno
            lineno: line
            colno: col
            :width
            :msg
            note: ""
            hint: ""
        )
        this.diags.append d
    }

    # info -- append an advisory INFO diagnostic (does not fail the gate; carries no fix).
    info: function {:this code: StringView msg: String.take line: u32 col: u32 width: u32} is {
        d: (zdiag.Diagnostic
            code: code.string
            sev: zdiag.severity.info
            fsno: zvfs.fsno
            lineno: line
            colno: col
            :width
            :msg
            note: ""
            hint: ""
        )
        this.diags.append d
    }

    # checkLineLength -- W005 (advisory): a line wider than `width` codepoints. INFO severity, so it
    # reports but never fails the gate; runs only when a width is set (--line-length). No fix.
    checkLineLength: function {:this width: u32} is {
        if width == 0 then return
        lls: linesOf src: this.source.stringView
        lno: 1.u32
        for each ln: lls loop {
            cl: codepointLen s: ln.stringView
            if cl > width then {
                (this.info
                    code: "W005"
                    msg: "line exceeds \{width} columns (\{cl})"
                    line: lno
                    col: width + 1
                    width: 1
                )
            }
            lno = lno + 1
        }
    }

    # checkEmpty -- L001 empty `else {}` and, for a backwards single-condition `if`,
    # the empty `then {}` (via checkEmptyThen). Receives an ifexpr's else + clauses.
    checkEmpty: function {:this ast: Ast.view elseclauseId: zast.nodeid clauses: zast.kidspan} is {
        if elseclauseId.isZero then return
        elseNode: ast.nodes.get i: elseclauseId
        if (isEmptyBlock n: elseNode) then {
            p: stmtPos n: elseNode
            (this.warn
                code: "L001"
                msg: "empty `else { }` clause"
                line: p.line
                col: p.col
                width: 2
            )
        } else if (isStatementArm n: elseNode) when clauses.count.u64 == 1 when (isElseIfWrap
            :ast
            n: elseNode
        ).not then {
            h13x9: u64
            for h13x9 < clauses.count loop {
                c0Id: zast.kidAt kids: ast.kids span: clauses i: h13x9
                h13x9 = h13x9 + 1
                this.checkEmptyThen :ast clause: (ast.nodes.get i: c0Id)
            }
        }
    }

    # checkEmptyThen -- L002 a single-condition clause whose `then {}` is empty.
    checkEmptyThen: function {:this ast: Ast.view clause: astnode.view} is {
        if clause.ifclause then {
            cst: ast.nodes.get i: clause.statement
            if (isEmptyBlock n: cst) when clause.conditions.count.u64 == 1 then {
                p: stmtPos n: (ast.nodes.get i: clause.statement)
                (this.warn
                    code: "L002"
                    msg: "empty `then { }` clause"
                    line: p.line
                    col: p.col
                    width: 2
                )
            }
        }
    }

    # checkElide -- L003 a built-in template call whose first argument carries its
    # primary parameter name. Receives the narrowed callable + argument list.
    checkElide: function {:this ast: Ast.view callable: astnode.view arguments: zast.kidspan} is {
        cn: atomName :ast n: callable
        if cn.length == 0 then return
        primary: primaryGenericParam name: cn.stringView
        if primary.length == 0 then return
        idx: u64
        h1x9: u64
        for h1x9 < arguments.count loop {
            aId: zast.kidAt kids: ast.kids span: arguments i: h1x9
            h1x9 = h1x9 + 1
            if idx == 0 then {
                (this.checkElideFirst
                    :ast
                    arg: (ast.nodes.get i: aId)
                    primary: primary.stringView
                )
            }
            idx = idx + 1
        }
    }

    # checkElideFirst -- flag the first generic argument when its label is the
    # template's primary parameter name.
    checkElideFirst: function {:this ast: Ast.view arg: astnode.view primary: StringView} is {
        if arg.namedoperation when (zast.nameTextEq :ast ref: arg.name s: primary) then {
            w: primary.length + 1
            (this.warn
                code: "L003"
                msg: "redundant `\{primary}:` label on a built-in template's first argument"
                line: arg.lineno
                col: arg.colno
                width: w.u32.orPanic
            )
        }
    }

    # checkCollapseName -- L006: a named argument `name: name` whose label equals its bare-atom
    # value collapses to the `:name` shorthand (same atomVariableId stamp -- codegen-neutral once
    # the emitter treats labelvalue == atomid). Fires on atomid values only, so it is idempotent:
    # a `:name` parses to a labelvalue and atomName returns "".
    checkCollapseName: function {:this ast: Ast.view arguments: zast.kidspan} is {
        if this.lineStart.length == 0 then return
        h2x9: u64
        for h2x9 < arguments.count loop {
            aId: zast.kidAt kids: ast.kids span: arguments i: h2x9
            h2x9 = h2x9 + 1
            a: ast.nodes.get i: aId
            if a.namedoperation then {
                label: zast.nameTextAt :ast ref: a.name
                val: atomName :ast n: (ast.nodes.get i: a.operation)
                lsv: label.stringView
                vsv: val.stringView
                if lsv.length > 0 when vsv.length > 0 when lsv == vsv then {
                    lo: (tokByteStart
                        lineStart: this.lineStart
                        srcLines: this.lines
                        lineno: a.lineno
                        colno: a.colno
                    )
                    vi: nodeInfoOf n: (ast.nodes.get i: a.operation)
                    hi: (tokByteStart
                        lineStart: this.lineStart
                        srcLines: this.lines
                        lineno: vi.line
                        colno: vi.col
                    )
                    (this.warnFix
                        code: "L006"
                        msg: "redundant label repeating its value; use the :name shorthand"
                        line: a.lineno
                        col: a.colno
                        width: lsv.length.u32.orPanic
                        :lo
                        :hi
                        repl: ":"
                    )
                }
            }
        }
    }

    # checkForWhile -- L004 token tier: a `for` immediately followed by `while`.
    # Re-tokenizes the source (parse-free; immune to strings and comments).
    checkForWhile: function {:this} is {
        srcOwned: this.source.copy
        sv: srcOwned.stringView
        scanPool: zast.StringPool.create
        toks: tokenize.scan source: srcOwned.copy pool: scanPool
        lineStart: lineStartIndex src: sv
        srcLines: linesOf src: sv
        m: toks.length
        prevFor: false
        i: u64
        for i < m loop {
            t: toks.get :i
            match (
                t.toktype
            ) case wsTok then null case eolTok then null case commentTok then null case forTok then {
                prevFor = true
            } case whileTok then {
                if prevFor then {
                    whileStart: tokByteStart :lineStart :srcLines lineno: t.lineno colno: t.colno
                    condStart: whileStart + t.width
                    foundCond: false
                    j: i + 1
                    scanning: true
                    for scanning loop {
                        if j >= m then {
                            scanning = false
                        } else {
                            tj: toks.get i: j
                            triv: false
                            match (
                                tj.toktype
                            ) case wsTok then {
                                triv = true
                            } case eolTok then {
                                triv = true
                            } case commentTok then {
                                triv = true
                            } else null
                            if triv then {
                                j = j + 1
                            } else {
                                condStart = (tokByteStart
                                    :lineStart
                                    :srcLines
                                    lineno: tj.lineno
                                    colno: tj.colno
                                )
                                foundCond = true
                                scanning = false
                            }
                        }
                    }
                    if foundCond then {
                        (this.warnFix
                            code: "L004"
                            msg: "redundant `while`: a for loop's leading condition omits `while`"
                            line: t.lineno
                            col: t.colno
                            width: t.width
                            lo: whileStart
                            hi: condStart
                            repl: ""
                        )
                    }
                }
                prevFor = false
            } else {
                prevFor = false
            }
            i = i + 1
        }
    }

    # walkProgram -- root entry of the parse-tier rule visitor: the table
    # rides inside the program node.
    walkProgram: function {:this prog: Ast.view} is {
        {
            uix9: u64
            for uix9 < prog.units.length loop {
                uId9: prog.units.get i: uix9
                uix9 = uix9 + 1
                this.walk ast: prog n: (prog.nodes.get i: uId9)
            }
        }
    }

    # reportDuplicateBodies -- A006: a function body, eight lines or longer,
    # whose shape (bodyKeyInto) another function in this file already has. The
    # first site is the original; each later one is reported against it.
    reportDuplicateBodies: function {:this prog: Ast.view} is {
        firstAt: MapRV String v: u64
        {
            ui: u64
            un: prog.units.length
            for ui < un loop {
                uid: prog.units.get i: ui
                this.dupBodyWalk ast: prog id: uid :firstAt
                ui = ui + 1
            }
        }
    }

    # dupBodyWalk -- one node of the duplicate-body pass: a function's body is
    # keyed and looked up; every child is visited.
    dupBodyWalk: function {:this ast: Ast.view id: zast.nodeid firstAt: (MapRV String v: u64)} is {
        n: ast.nodes.get i: id
        if n.functiondef when n.body.isZero.not then {
            span: (zast.spanEndLineAt :ast id: n.body) - n.lineno + 1
            if span >= duplicateBodyLines then {
                key: String
                bodyKeyInto :ast id: n.body buf: key
                seen: firstAt.get :key
                match (
                    seen
                ) case some then {
                    (this.info
                        code: "A006"
                        msg: "this body has the shape of the one at line \{seen}; one function, with the difference as an argument"
                        line: n.lineno
                        col: n.colno
                        width: 1
                    )
                } case none then {
                    firstAt.set key: key.copy value: n.lineno.u64
                }
            }
        }
        kids: zast.childIdsAt :ast :id
        for each k: kids loop this.dupBodyWalk :ast id: k :firstAt
    }

    # walkTypeCasingProgram / walkTypeCasingAt -- L021 (default-on): a type
    # definition's name casing follows its kind -- record/variant/facet
    # lowercase, class/union/protocol/generator PascalCase (styleguide Naming).
    walkTypeCasingProgram: function {:this prog: Ast.view} is {
        {
            tci: u64
            tcn: prog.units.length
            for tci < tcn loop {
                tcid: prog.units.get i: tci
                this.walkTypeCasingAt ast: prog nId: tcid
                tci = tci + 1
            }
        }
    }

    # the id-taking entry to the type-casing walk, so the caller can lend the
    # tree without holding a node view
    walkTypeCasingAt: function {:this ast: Ast.view nId: zast.nodeid} is {
        n: ast.nodes.get i: nId
        match (
            n
        ) case namedoperation then {
            this.walkTypeCasingAt :ast nId: n.operation
        } case unitdef then {
            box2089: u64
            for box2089 < n.body.count loop {
                bId: zast.kidAt kids: ast.kids span: n.body i: box2089
                box2089 = box2089 + 1
                bm: ast.nodes.get i: bId
                if bm.namedoperation then {
                    op: ast.nodes.get i: bm.operation
                    if op.objectdef then {
                        (this.checkTypeNameCasing
                            :ast
                            nameRef: bm.name
                            line: bm.lineno
                            col: bm.colno
                            kind: (casingKindOf :ast opId: bm.operation)
                        )
                    }
                }
            }
        } else null
    }

    # checkTypeNameCasing -- flag a valtype name carrying a capital, or a
    # reftype name that does not start with one.
    checkTypeNameCasing: function {
        :this ast: Ast.view nameRef: zast.nameid line: u32 col: u32 kind: zast.objectkind
    } is {
        isVal: (
            (kind == zast.objectkind.recordDef) or
            (kind == zast.objectkind.variantDef) or
            (kind == zast.objectkind.facetDef)
        )
        isRef: (
            (kind == zast.objectkind.classDef) or
            (kind == zast.objectkind.unionDef) or
            (kind == zast.objectkind.protocolDef) or
            (kind == zast.objectkind.generatorDef)
        )
        if isVal.not when isRef.not then return
        nm: zast.nameTextAt :ast ref: nameRef
        hasUpper: false
        ci: u64
        cln: nm.length
        for ci < cln loop {
            cb: nm.stringView.byteAt i: ci
            match (
                cb
            ) case some then {
                if cb >= 65 when cb <= 90 then hasUpper = true
            } case none then null
            ci = ci + 1
        }
        firstUpper: false
        fb: nm.stringView.byteAt i: 0
        match (
            fb
        ) case some then {
            if fb >= 65 when fb <= 90 then firstUpper = true
        } case none then null
        bad: false
        msg: String
        if isVal when hasUpper then {
            bad = true
            msg = "valtype '\{nm}' should be lowercase -- record/variant/facet names run their words together without capitals"
        }
        if isRef when firstUpper.not then {
            bad = true
            msg = "reftype '\{nm}' should be PascalCase -- class/union/protocol/generator names start with a capital"
        }
        if bad then {
            (this.warn
                code: "L021"
                :msg
                :line
                :col
                width: nm.length.u32.orPanic
            )
        }
    }

    # walkGenericParamCasingProgram -- L023 (default-on): a generic parameter's
    # case matches the case of its bound's name, so a reader sees the ownership
    # family at the point of use (styleguide Naming). A linear sweep of the node
    # table rather than a descent: a parameter sits in an objectdef's as-block,
    # a functiondef's as-block or a unit body, and a walk taught only some of
    # those carriers would pass the rest in silence.
    walkGenericParamCasingProgram: function {:this prog: Ast.view} is {
        {
            gi: zast.nodeid
            gn: prog.nodes.length
            for gi.u64 < gn loop {
                gm: prog.nodes.get i: gi
                if gm.namedoperation when (zast.isGenericParamOp ast: prog opId: gm.operation
                ) then {
                    (this.checkGenericParamCasing
                        ast: prog
                        nameRef: gm.name
                        opId: gm.operation
                        line: gm.lineno
                        col: gm.colno
                    )
                }
                gi = gi.next
            }
        }
    }

    # checkGenericParamCasing -- flag a generic parameter whose first character's
    # case differs from its bound's. A bound with no base name is skipped rather
    # than guessed at: answering for a shape the reader could not read would be
    # reporting a check that never ran.
    checkGenericParamCasing: function {
        :this ast: Ast.view nameRef: zast.nameid opId: zast.nodeid line: u32 col: u32
    } is {
        bnd: genericBoundBase :ast :opId
        if bnd.length == 0 then return
        nm: zast.nameTextAt :ast ref: nameRef
        if nm.length == 0 then return
        nUp: byteIsUpper b: (nm.stringView.byteAt i: 0)
        bUp: byteIsUpper b: (bnd.stringView.byteAt i: 0)
        if nUp == bUp then return
        want: flipFirstCase s: nm.stringView
        msg: "generic parameter '\{nm}' should be '\{want}' -- a parameter's case matches the case of its bound, and the bound is '\{bnd}'"
        (this.warn
            code: "L023"
            :msg
            :line
            :col
            width: nm.length.u32.orPanic
        )
    }

    # the root entry to the member-casing walk
    walkCasingProgram: function {:this prog: Ast.view} is {
        {
            wci: u64
            wcn: prog.units.length
            for wci < wcn loop {
                wcid: prog.units.get i: wci
                this.walkCasingAt ast: prog nId: wcid
                wci = wci + 1
            }
        }
    }

    # walk -- the parse-tier rule visitor: the arms a rule reads are spelled,
    # then every child is visited through zast.childIds.
    walk: function {:this ast: Ast.view n: astnode.view} is {
        # AN INFIX CALL IS THE OPERATOR SHAPE THESE RULES ARE WRITTEN FOR.
        # Read ahead of the match: an arm narrows `n` to its own row, and the
        # call arm cannot ask the node it came from.
        ipW: zast.infixPartsOf :ast :n
        if ipW.found then {
            this.checkMixedOperators :ast opId: ipW.operator lhsId: ipW.lhs
            this.checkBoolLiteralCompare :ast opId: ipW.operator lhsId: ipW.lhs rhsId: ipW.rhs
            if this.opts.arch then {
                this.checkLiteralCompare :ast opId: ipW.operator lhsId: ipW.lhs rhsId: ipW.rhs
            }
        }
        match (
            n
        ) case error then {
            d: (zdiag.errorDiag
                errv: n.err
                fsno: n.fsno
                lineno: n.lineno
                colno: n.colno
                width: n.width
                msg: (zast.poolTextCopy pool: ast.names ref: n.msg)
                note: (zast.poolTextCopy pool: ast.names ref: n.note)
                hint: (zast.poolTextCopy pool: ast.names ref: n.hint)
            )
            this.diags.append d
        } case call then {
            (this.checkElide
                :ast
                callable: (ast.nodes.get i: n.callable)
                arguments: n.arguments
            )
            this.checkCollapseName :ast arguments: n.arguments
        } case atomstring then {
            if this.opts.arch then (this.checkComposedKey
                :ast
                parts: n.stringparts
                line: n.lineno
                col: n.colno
            )
        } case namedoperation then {
            if this.opts.complexity > 0 when this.funcDepth == 0 then {
                this.checkComplexity :ast nameId: n.name opId: n.operation
            }
        } case assignment then {
            if this.funcDepth > 0 then (this.tryBareZeroInit
                :ast
                value: (ast.nodes.get i: n.value)
            )
        } case forexpr then {
            this.checkImpliedIterate :ast :n
        } case ifexpr then {
            this.checkEmpty :ast elseclauseId: n.elseclause clauses: n.clauses
            this.checkNestedIf :ast clauses: n.clauses elseclauseId: n.elseclause
        } case statement then {
            this.checkUnreachable :ast stmts: n.statements
            this.checkFlagAccumulator :ast stmts: n.statements
        } case functiondef then {
            if this.opts.arch then (this.checkLongFunction
                :ast
                bodyId: n.body
                line: n.lineno
                col: n.colno
            )
            # the body is walked one function deeper; the signature is not
            this.walkOptAt :ast oId: n.returntype
            this.walkIds :ast ids: n.parameters
            this.funcDepth = this.funcDepth + 1
            this.walkOptAt :ast oId: n.body
            this.funcDepth = this.funcDepth - 1
            this.walkIds :ast ids: n.asItems
            return
        } else null
        kl9: zast.childIds :ast :n
        for each c9: kl9 loop {
            this.walk :ast n: (ast.nodes.get i: c9)
        }
    }

    # walk a list of child nodes in order
    walkIds: function {:this ast: Ast.view ids: zast.kidspan} is {
        h10x9: u64
        for h10x9 < ids.count loop {
            c: zast.kidAt kids: ast.kids span: ids i: h10x9
            h10x9 = h10x9 + 1
            this.walk :ast n: (ast.nodes.get i: c)
        }
    }

    # checkBoolLiteralCompare -- L028: a comparison with a boolean literal.
    # `X == false` / `X != true` is `X.not`, and `X == true` / `X != false` is
    # `X` itself, with the literal on either side. Both operator and literal
    # are matched by pool id; when both operands are literals the right one is
    # the literal, as it is when only the right one is.
    checkBoolLiteralCompare: function {
        :this ast: Ast.view opId: zast.nodeid lhsId: zast.nodeid rhsId: zast.nodeid
    } is {
        opNm: atomNameIdOf n: (ast.nodes.get i: opId)
        isEq: opNm == zast.names.wkOpEq
        isNe: opNm == zast.names.wkOpNe
        if isEq.not when isNe.not then return
        litNm: atomNameIdOf n: (ast.nodes.get i: rhsId)
        reversed: false
        if (this.isBoolLiteralId nm: litNm).not then {
            litNm = atomNameIdOf n: (ast.nodes.get i: lhsId)
            if (this.isBoolLiteralId nm: litNm).not then return
            reversed = true
        }
        isTrue: litNm == this.trueId
        isFalse: litNm == this.falseId
        neg: isEq and isFalse or (isNe and isTrue)
        litLen: 4.u64
        if isFalse then litLen = 5
        if reversed then {
            this.reportBoolLiteralCompareReversed :ast litId: lhsId operandId: rhsId :neg
            return
        }
        this.reportBoolLiteralCompare :ast :lhsId :opId :rhsId :neg :litLen
    }

    # isBoolLiteralId -- the name id is `true` or `false`.
    isBoolLiteralId: function {t: this.view nm: zast.nameid} out bool is {
        if nm.isZero then return false
        return (nm == t.trueId) or (nm == t.falseId)
    }

    # reportBoolLiteralCompareReversed -- L028 with the literal written first
    # (`false == b`). The fix rewrites the comparison, from the literal to the
    # operand's last byte, as the operand with `.not` appended for a negation.
    # It is offered only for a plain name or a dotted path of names, whose
    # extent the tree gives exactly (its first atom's start to its last atom's
    # end); any other operand is reported without a fix.
    reportBoolLiteralCompareReversed: function {
        :this
        ast: Ast.view
        litId: zast.nodeid
        operandId: zast.nodeid
        neg: bool
    } is {
        lp: zast.posOf n: (ast.nodes.get i: litId)
        what: "`== true` / `!= false` is the value itself: drop the comparison".string
        if neg then what = "`== false` / `!= true` negates: write `.not`"
        firstId: simplePathFirstAtom :ast id: operandId
        if firstId.isZero then {
            this.warn code: "L028" msg: what line: lp.line col: lp.col width: 1
            return
        }
        lastN: ast.nodes.get i: (simplePathLastAtom :ast id: operandId)
        fp: zast.posOf n: (ast.nodes.get i: firstId)
        ep: zast.posOf n: lastN
        lastLen: (zast.poolTextAt pool: ast.names ref: (atomNameIdOf n: lastN)).length.u64
        srcOwned: this.source.copy
        srcv: srcOwned.stringView
        litLo: (tokByteStart
            lineStart: this.lineStart
            srcLines: this.lines
            lineno: lp.line
            colno: lp.col
        )
        xLo: (tokByteStart
            lineStart: this.lineStart
            srcLines: this.lines
            lineno: fp.line
            colno: fp.col
        )
        lastLo: (tokByteStart
            lineStart: this.lineStart
            srcLines: this.lines
            lineno: ep.line
            colno: ep.col
        )
        xHi: lastLo + lastLen
        if (xHi > srcv.length) or (xHi <= xLo) or (xLo <= litLo) then {
            this.warn code: "L028" msg: what line: lp.line col: lp.col width: 1
            return
        }
        xText: (srcv.substring from: xLo to: xHi).string
        suffix: ".not"
        if neg.not then suffix = ""
        (this.warnFix
            code: "L028"
            msg: what
            line: lp.line
            col: lp.col
            width: (xHi - litLo).u32.orPanic
            lo: litLo
            hi: xHi
            repl: "\{xText}\{suffix}"
        )
    }

    # reportBoolLiteralCompare -- the L028 finding and its fix: the whole
    # comparison, from the operand's first byte to the literal's last, becomes
    # the operand (parenthesised when it is itself an unparenthesised binop)
    # with `.not` appended for a negation. A paren group's bytes are checked
    # against the tree; when they do not delimit, the finding is reported
    # without a fix so the gate still names the site.
    reportBoolLiteralCompare: function {
        :this
        ast: Ast.view
        lhsId: zast.nodeid
        opId: zast.nodeid
        rhsId: zast.nodeid
        neg: bool
        litLen: u64
    } is {
        lhsN: ast.nodes.get i: lhsId
        lp: zast.posOf n: lhsN
        op: zast.posOf n: (ast.nodes.get i: opId)
        rp: zast.posOf n: (ast.nodes.get i: rhsId)
        srcOwned: this.source.copy
        srcv: srcOwned.stringView
        xStart: (tokByteStart
            lineStart: this.lineStart
            srcLines: this.lines
            lineno: lp.line
            colno: lp.col
        )
        opLo: (tokByteStart
            lineStart: this.lineStart
            srcLines: this.lines
            lineno: op.line
            colno: op.col
        )
        litLo: (tokByteStart
            lineStart: this.lineStart
            srcLines: this.lines
            lineno: rp.line
            colno: rp.col
        )
        litHi: litLo + litLen
        xHi: trimBackWs s: srcv hi: opLo
        xLo: xStart
        ok: litHi <= srcv.length
        if xHi <= xStart then ok = false
        # a parenthesised operand: the `)` ending it is partnered by a `(` at or
        # before where the tree positions the operand, with only openers between
        gs: parenGroupStart s: srcv close: xHi
        if gs > 0 when gs < xStart then {
            xLo = gs
            if (onlyOpensBetween s: srcv lo: gs + 1 hi: xStart).not then ok = false
        }
        what: "`== true` / `!= false` is the value itself: drop the comparison".string
        if neg then what = "`== false` / `!= true` negates: write `.not`"
        if ok.not then {
            this.warn code: "L028" msg: what line: lp.line col: lp.col width: 1
            return
        }
        xText: (srcv.substring from: xLo to: xHi).string
        # an unparenthesised operand keeps its grouping in the fix text
        ipF: zast.infixPartsOf :ast n: lhsN
        if ipF.found then xText = "(\{xText})"
        suffix: ".not"
        if neg.not then suffix = ""
        (this.warnFix
            code: "L028"
            msg: what
            line: lp.line
            col: lp.col
            width: (litHi - xLo).u32.orPanic
            lo: xLo
            hi: litHi
            repl: "\{xText}\{suffix}"
        )
    }

    # checkMixedOperators -- L032: `a op1 b op2 c` with op1 and op2 of different
    # kinds and no parentheses. Operators group left to right with no
    # precedence, so the left operand of op2 is `a op1 b` whatever the kinds;
    # the safe fix writes those parentheses. The tree does not record
    # parentheses, so the source says whether they are there: the operand is
    # grouped when the text before op2 ends in a `)` whose `(` opens just
    # before the operand.
    checkMixedOperators: function {:this ast: Ast.view opId: zast.nodeid lhsId: zast.nodeid} is {
        inner: zast.infixPartsOf :ast n: (ast.nodes.get i: lhsId)
        if inner.found.not then return
        outerK: operatorKind :ast nid: opId
        innerK: operatorKind :ast nid: inner.operator
        if (outerK == 0) or (innerK == 0) or (outerK == innerK) then return
        if this.lineStart.length == 0 then return
        op: zast.posOf n: (ast.nodes.get i: opId)
        lp: zast.posOf n: (ast.nodes.get i: lhsId)
        opB: (tokByteStart
            lineStart: this.lineStart
            srcLines: this.lines
            lineno: op.line
            colno: op.col
        )
        lhsB: (tokByteStart
            lineStart: this.lineStart
            srcLines: this.lines
            lineno: lp.line
            colno: lp.col
        )
        srcOwned: this.source.copy
        sv: srcOwned.stringView
        endB: opB
        for endB > lhsB while (isSpaceByte c: (docByteAt s: sv i: endB - 1)) loop endB = endB - 1
        if (groupedSpan :sv lo: lhsB hi: endB) then return
        outerNm: zast.nameTextAt :ast ref: (atomNameIdOf n: (ast.nodes.get i: opId))
        inn: zast.nameTextAt :ast ref: (atomNameIdOf n: (ast.nodes.get i: inner.operator))
        what: "`\{inn}` and `\{outerNm}` chained without parentheses: operators group left to right, so the `\{inn}` is taken first"
        this.warn code: "L032" msg: what line: op.line col: op.col width: outerNm.length.u32.orPanic
        this.edits.append (zfix.Edit byteLo: lhsB byteHi: lhsB replacement: "(")
        this.edits.append (zfix.Edit byteLo: endB byteHi: endB replacement: ")")
    }

    # checkImpliedIterate -- L029: `for each x: E.iterate` writes the call `each`
    # implies. The fix deletes `.iterate`: `each` asks a type's `iterate` before
    # anything else, so the header still walks the same member. When the byte
    # before the member is not its `.`, the finding is reported without a fix.
    checkImpliedIterate: function {:this ast: Ast.view n: zast.forrow.view} is {
        if n.isEach.not then return
        if n.conditions.count.u64 == 0 then return
        c0: ast.nodes.get i: (zast.kidAt kids: ast.kids span: n.conditions i: 0)
        opId: zast.nodeid
        match (
            c0
        ) case namedoperation then {
            opId = c0.operation
        } else {
            return
        }
        chId: zast.nodeid
        opN: ast.nodes.get i: opId
        match (
            opN
        ) case dottedpath then {
            chId = opN.child
        } else {
            return
        }
        ch: ast.nodes.get i: chId
        match (
            ch
        ) case atomid then {
            if ch.name != zast.names.wkIterate then return
        } else {
            return
        }
        cp: zast.posOf n: ch
        what: "`each` implies `.iterate`: drop it".string
        lo: (tokByteStart
            lineStart: this.lineStart
            srcLines: this.lines
            lineno: cp.line
            colno: cp.col
        )
        srcOwned: this.source.copy
        srcv: srcOwned.stringView
        hi: lo + 7
        # the tree matched the member by id; the bytes need only the `.` before
        # it, where the header's value ends and the call begins
        ok: false
        if lo > 0 when hi <= srcv.length then ok = (docByteAt s: srcv i: lo - 1) == 46
        if ok.not then {
            this.warn code: "L029" msg: what line: cp.line col: cp.col width: 7
            return
        }
        (this.warnFix
            code: "L029"
            msg: what
            line: cp.line
            col: cp.col
            width: 7
            lo: lo - 1
            :hi
            repl: String
        )
    }

    # ---- architecture rules (zl lint --arch) ----

    # checkFlagAccumulator -- A009: a bool local bound to a literal and then set
    # to the other literal by two or more consecutive single-clause `if`
    # statements: a disjunction (or, from `true`, a conjunction) written as a
    # flag. Reported at the binding.
    checkFlagAccumulator: function {:this ast: Ast.view stmts: zast.kidspan} is {
        if this.opts.arch.not then return
        n: stmts.count.u64
        i: u64
        for i < n loop {
            sid: zast.kidAt kids: ast.kids span: stmts :i
            i = i + 1
            fb: this.flagBindingAt :ast :sid
            if fb.name.isZero then continue
            other: this.trueId
            if fb.lit == this.trueId then other = this.falseId
            sets: u64
            j: i
            for j < n while (this.flagSetAt
                :ast
                sid: (zast.kidAt kids: ast.kids span: stmts i: j)
                name: fb.name
                lit: other
            ) loop {
                sets = sets + 1
                j = j + 1
            }
            if sets >= 2 then {
                p: zast.posOf n: (ast.nodes.get i: sid)
                fn: zast.nameTextAt :ast ref: fb.name
                (this.info
                    code: "A009"
                    msg: "flag accumulator: `\{fn}` is bound to a literal and then set by \{sets} `if` statements; bind the `or` chain instead"
                    line: p.line
                    col: p.col
                    width: 1
                )
            }
        }
    }

    # flagBindingAt -- the flag binding a statement line holds (`name: true` /
    # `name: false`), or zeros for any other line.
    flagBindingAt: function {this: this.view ast: Ast.view sid: zast.nodeid} out flagbind is {
        n: ast.nodes.get i: (innerNodeIdOf :ast id: sid)
        match (
            n
        ) case assignment then {
            lit: this.boolLiteralAt :ast id: n.value
            if lit.isZero then return (flagbind name: zast.nameid lit: zast.nameid)
            return (flagbind name: n.name :lit)
        } else {
            return (flagbind name: zast.nameid lit: zast.nameid)
        }
    }

    # boolLiteralAt -- the pool id of `true` / `false` when the node at `id`, its
    # statement line peeled, is that literal; 0 otherwise.
    boolLiteralAt: function {this: this.view ast: Ast.view id: zast.nodeid} out zast.nameid is {
        nm: atomNameIdOf n: (ast.nodes.get i: (innerNodeIdOf :ast :id))
        if nm.isZero then return nm
        if nm == this.trueId then return nm
        if nm == this.falseId then return nm
        return zast.nameid
    }

    # flagSetAt -- statement line `sid` is `if <cond> then <name> = <lit>`: one
    # clause, no else, a body of exactly that reassignment.
    flagSetAt: function {
        this: this.view ast: Ast.view sid: zast.nodeid name: zast.nameid lit: zast.nameid
    } out bool is {
        n: ast.nodes.get i: (innerNodeIdOf :ast id: sid)
        match (
            n
        ) case ifexpr then {
            if n.elseclause.isZero.not then return false
            if n.clauses.count.u64 != 1 then return false
            bodyId: singleLineBodyOf :ast clauseId: (zast.kidAt kids: ast.kids span: n.clauses i: 0)
            if bodyId.isZero then return false
            return (this.reassignsTo :ast id: bodyId :name :lit)
        } else {
            return false
        }
    }

    # reassignsTo -- the node at `id` is `name = <lit>`.
    reassignsTo: function {
        this: this.view ast: Ast.view id: zast.nodeid name: zast.nameid lit: zast.nameid
    } out bool is {
        n: ast.nodes.get i: id
        match (
            n
        ) case reassignment then {
            if (atomNameIdOf n: (ast.nodes.get i: n.topath)) != name then return false
            return (this.boolLiteralAt :ast id: n.value) == lit
        } else {
            return false
        }
    }

    # checkNestedIf -- A010: an `if` with one clause and no else whose body is a
    # block holding exactly one `if` with one clause and no else: the two
    # conditions are one `when` chain. Reported at the inner `if`.
    checkNestedIf: function {
        :this ast: Ast.view clauses: zast.kidspan elseclauseId: zast.nodeid
    } is {
        if this.opts.arch.not then return
        if elseclauseId.isZero.not then return
        if clauses.count.u64 != 1 then return
        innerId: singleLineBodyOf :ast clauseId: (zast.kidAt kids: ast.kids span: clauses i: 0)
        if innerId.isZero then return
        inner: ast.nodes.get i: innerId
        match (
            inner
        ) case ifexpr then {
            if inner.elseclause.isZero.not then return
            if inner.clauses.count.u64 != 1 then return
            (this.info
                code: "A010"
                msg: "nested `if` with nothing else in the outer body: chain the conditions with `when`"
                line: inner.lineno
                col: inner.colno
                width: 2
            )
        } else null
    }

    # checkLiteralCompare -- A001: `==` / `!=` against a string literal. The
    # compiler compares by id -- a name id, a declaration, a type id -- and a
    # literal here is a name the code resolves by spelling.
    checkLiteralCompare: function {
        :this ast: Ast.view opId: zast.nodeid lhsId: zast.nodeid rhsId: zast.nodeid
    } is {
        op: atomName :ast n: (ast.nodes.get i: opId)
        isCmp: op.stringView == "=="
        if op.stringView == "!=" then isCmp = true
        if isCmp.not then return
        this.literalCompareSide :ast id: lhsId
        this.literalCompareSide :ast id: rhsId
    }

    # one side of a comparison, answering whether it is a string literal --
    # which is what A001 reports
    literalCompareSide: function {:this ast: Ast.view id: zast.nodeid} is {
        n: ast.nodes.get i: id
        txt: plainLiteralText :ast :n
        match (
            txt
        ) case some then {
            p: zast.posOf :n
            (this.info
                code: "A001"
                msg: "string literal `\{txt}` compared by spelling; compare an id (name id, declaration, type id)"
                line: p.line
                col: p.col
                width: 1
            )
        } case none then null
    }

    # checkComposedKey -- A002: a string literal shaped like a composed key
    # (holes joined by a separator) -- a spelling that stands in for a tree
    # walk or a pair key.
    checkComposedKey: function {:this ast: Ast.view parts: zast.kidspan line: u32 col: u32} is {
        if (isComposedParts :ast :parts).not then return
        (this.info
            code: "A002"
            msg: "composed string :key the table by ids (a pair record, or walk the tree)"
            :line
            :col
            width: 1
        )
    }

    # checkUnreachable -- L026: a statement after one that leaves its block
    # (`return`, `break`, `continue`) can never run. Reported once per block,
    # at the first statement past the exit.
    checkUnreachable: function {:this ast: Ast.view stmts: zast.kidspan} is {
        i: u64
        n: stmts.count.u64
        for i < n loop {
            sid: zast.kidAt kids: ast.kids span: stmts :i
            i = i + 1
            if i < n when (lineLeavesBlock :ast id: sid) then {
                p: zast.posOf n: (ast.nodes.get i: (zast.kidAt kids: ast.kids span: stmts :i))
                (this.warn
                    code: "L026"
                    msg: "unreachable statement: the block has already returned or jumped"
                    line: p.line
                    col: p.col
                    width: 1
                )
                return
            }
        }
    }

    # checkLongFunction -- A005: a function whose body spans more than
    # longFunctionLines source lines, measured from the definition to the
    # deepest statement it reaches (one line above the closing brace). A body
    # that is one `match` is exempt: splitting a dispatcher hides the shape it
    # exists to show.
    checkLongFunction: function {:this ast: Ast.view bodyId: zast.nodeid line: u32 col: u32} is {
        if bodyId.isZero then return
        if (bodyIsOneMatch :ast :bodyId) then return
        lastLine: zast.spanEndLineAt :ast id: bodyId
        span: lastLine - line + 1
        if span > longFunctionLines then {
            (this.info
                code: "A005"
                msg: "function spans \{span} lines; split it into named helpers"
                :line
                :col
                width: 1
            )
        }
    }

    # checkComplexity -- A008: a function whose cognitive complexity exceeds
    # the threshold, scored over its whole body with nested literals folded
    # in. The definition names it: unit-level functions and methods, which the
    # walk reaches at function depth zero.
    checkComplexity: function {:this ast: Ast.view nameId: zast.nameid opId: zast.nodeid} is {
        if opId.isZero then return
        op: ast.nodes.get i: opId
        match (
            op
        ) case functiondef then {
            if op.body.isZero then return
            acc: CcState score: 0
            ccVisit :ast id: op.body nesting: 0 fnName: nameId :acc
            if acc.score > this.opts.complexity then {
                nm: zast.poolTextAt pool: ast.names ref: nameId
                sc: acc.score
                th: this.opts.complexity
                (this.warn
                    code: "A008"
                    msg: "function `\{nm}` has cognitive complexity \{sc} (threshold \{th})"
                    line: op.lineno
                    col: op.colno
                    width: 1
                )
            }
        } else null
    }

    # walkCasingAt -- the id-taking entry for the casing visitor.
    walkCasingAt: function {:this ast: Ast.view nId: zast.nodeid} is {
        n: ast.nodes.get i: nId
        this.walkCasing :ast :n
    }

    # walkCasing -- opt-in (L009): recurse to every type definition and check the member
    # casing of `variant` / `union` declarations. Runs only under `zl lint --casing`.
    walkCasing: function {:this ast: Ast.view n: astnode.view} is {
        match (
            n
        ) case program then {
            it: ast.units.iterate
            for uId: it loop (this.walkCasing
                :ast
                n: (ast.nodes.get i: uId)
            )
        } case unitdef then {
            box2099: u64
            for box2099 < n.body.count loop {
                bId: zast.kidAt kids: ast.kids span: n.body i: box2099
                box2099 = box2099 + 1
                this.walkCasing :ast n: (ast.nodes.get i: bId)
            }
        } case namedoperation then {
            this.walkCasing :ast n: (ast.nodes.get i: n.operation)
        } case objectdef then {
            this.checkMemberCasing :ast kind: n.kind items: n.isItems
        } else null
    }

    # checkMemberCasing -- flag each variant/union arm whose name starts with an uppercase
    # letter (not lowerCamelCase), with a suggested rename (see casingSuggest/casingMessage).
    checkMemberCasing: function {:this ast: Ast.view kind: zast.objectkind items: zast.kidspan} is {
        isVU: (kind == zast.objectkind.variantDef) or (kind == zast.objectkind.unionDef)
        if isVU.not then return
        h9x9: u64
        for h9x9 < items.count loop {
            itemId: zast.kidAt kids: ast.kids span: items i: h9x9
            h9x9 = h9x9 + 1
            item: ast.nodes.get i: itemId
            if item.namedoperation then {
                isTypeRef: false
                match (
                    ast.nodes.get i: item.operation
                ) case labelvalue then {
                    isTypeRef = true
                } else null
                nm: zast.nameTextAt :ast ref: item.name
                fb: nm.stringView.byteAt i: 0
                up: false
                match (
                    fb
                ) case some then {
                    if fb >= 65 when fb <= 90 then up = true
                } case none then null
                if up when isTypeRef.not then {
                    sug: casingSuggest name: nm.stringView
                    (this.warn
                        code: "L009"
                        msg: (casingMessage orig: nm.stringView sug: sug.stringView)
                        line: item.lineno
                        col: item.colno
                        width: nm.length.u32.orPanic
                    )
                }
            }
        }
    }

    # checkPublicPosProgram -- L019 entry: check every unit's `public:` block placement.
    checkPublicPosProgram: function {:this prog: Ast.view} is {
        {
            cui: u64
            cun: prog.units.length
            for cui < cun loop {
                cuid: prog.units.get i: cui
                this.checkPublicPosAt ast: prog nId: cuid
                cui = cui + 1
            }
        }
    }

    # checkPublicPosAt -- L019: a unit's `public:` block must sit at the top,
    # before any definition (only the file header comment may precede it).
    checkPublicPosAt: function {:this ast: Ast.view nId: zast.nodeid} is {
        wn: ast.nodes.get i: nId
        if wn.namedoperation then {
            ud: ast.nodes.get i: wn.operation
            if ud.unitdef then {
                sawDef: false
                box2109: u64
                for box2109 < ud.body.count loop {
                    cbId: zast.kidAt kids: ast.kids span: ud.body i: box2109
                    box2109 = box2109 + 1
                    mn: ast.nodes.get i: cbId
                    if mn.namedoperation then {
                        isPub: (zast.unitOpKindIs
                            :ast
                            opId: mn.operation
                            k: zast.unitkind.publicNs
                        )
                        # `require:` states what the unit needs from the host
                        # toolchain; it is not a definition in it.
                        isReq: (zast.unitOpKindIs
                            :ast
                            opId: mn.operation
                            k: zast.unitkind.requirement
                        )
                        if isPub when sawDef then {
                            (this.warn
                                code: "L019"
                                msg: "the public interface block must be at the top of the unit, before any definition"
                                line: mn.lineno
                                col: mn.colno
                                width: 6
                            )
                        }
                        if isPub.not when isReq.not then {
                            sawDef = true
                        }
                    }
                }
            }
        }
    }

    # hasDocAbove -- true when the source line directly above `line1` (1-based)
    # is a `#` comment line -- the start of a leading doc block.
    hasDocAbove: function {this: this.view line1: u32} out bool is {
        result: false
        if line1 < 2 then return result
        idx: (line1 - 2).u64
        if idx >= this.lines.length then return result
        ln: this.lines.get i: idx
        lv: ln.stringView
        lt: lv.trim
        if lt.startsWith "#" then result = true
        return result
    }

    # reportUndocDef -- warn L016 when a definition (type / function / method) has
    # no leading `#` doc block. `nameRef` gives the underline width.
    reportUndocDef: function {:this ast: Ast.view nameRef: zast.nameid line: u32 col: u32} is {
        if (this.hasDocAbove line1: line) then return
        nm: zast.nameTextAt :ast ref: nameRef
        (this.warn
            code: "L016"
            msg: "missing doc comment: add a `#` comment above this definition"
            :line
            :col
            width: nm.length.u32.orPanic
        )
    }

    # checkDocsMember -- a parameter or field counts as documented by a leading
    # `#` block or a trailing `#` on its own line; warn `code`/`kind` otherwise.
    checkDocsMember: function {
        :this ast: Ast.view member: astnode.view code: StringView kind: StringView
    } is {
        if member.namedoperation then {
            nm: zast.nameTextAt :ast ref: member.name
            skip: false
            if nm.stringView == "this" then skip = true
            if skip.not then {
                documented: false
                if (this.hasDocAbove line1: member.lineno) then documented = true
                if documented.not then {
                    li: (member.lineno - 1).u64
                    if li < this.lines.length then {
                        mline: this.lines.get i: li
                        if (hasHash line: mline.stringView) then documented = true
                    }
                }
                if documented.not then {
                    msg: "missing doc comment: add a `#` comment above this \{kind}"
                    (this.warn
                        :code
                        :msg
                        line: member.lineno
                        col: member.colno
                        width: nm.length.u32.orPanic
                    )
                }
                if documented when this.opts.docsQuality then {
                    (this.reportDocEcho
                        :ast
                        nameRef: member.name
                        line: member.lineno
                        col: member.colno
                    )
                }
            }
        }
    }

    # docBlockAbove -- the contiguous `#` block directly above `line1`, markers dropped
    # and lines joined by spaces; "" when there is none. This is the same block hover
    # renders, so a rule reading it judges what a reader actually sees.
    docBlockAbove: function {this: this.view line1: u32} out String is {
        buf: String
        if line1 < 2 then return buf
        lo: (line1 - 2).u64
        if lo >= this.lines.length then return buf
        last: this.lines.get i: lo
        if (docLineIsComment ln: last.stringView).not then return buf
        top: lo
        more: true
        for more loop {
            if top == 0 then {
                more = false
            } else {
                prev: this.lines.get i: top - 1
                if (docLineIsComment ln: prev.stringView) then {
                    top = top - 1
                } else more = false
            }
        }
        i: top
        for i <= lo loop {
            ln: this.lines.get :i
            t: ln.stringView.trim
            body: t.substring from: 1 to: t.length
            if buf.length > 0 then buf.appendByte b: 32
            buf.append s: body.trim
            i = i + 1
        }
        return buf
    }

    # reportDocEcho -- L024: every content word of the doc already appears in the
    # declaration it sits above, so the doc restates the name and the type instead of
    # saying why the thing exists. That is the bar a comment has to clear, made
    # mechanical, and it is also the cheapest way to satisfy a coverage ratchet -- the
    # corpus writes these without one, so the ratchet ships paired with this.
    reportDocEcho: function {:this ast: Ast.view nameRef: zast.nameid line: u32 col: u32} is {
        li: (line - 1).u64
        if li >= this.lines.length then return
        doc: this.docBlockAbove line1: line
        # own the line: a live view into this.lines would hold a shared lock across the
        # warn below, which needs the receiver exclusively.
        decl: (this.lines.get i: li).copy
        if (docStartsLine ln: decl.stringView :col).not then return
        if doc.length == 0 then doc = docTrailingComment ln: decl.stringView
        if doc.length == 0 then return
        vocab: List String
        docVocabInto s: (docStripComment ln: decl.stringView) into: vocab
        words: List String
        docWordsInto s: doc.stringView into: words
        novel: u64
        for each w: words loop {
            if (docIsStopword w: w.stringView).not when (docHasWord xs: vocab w: w.stringView
            ).not then novel = novel + 1
        }
        if novel > 0 then return
        nm: zast.nameTextAt :ast ref: nameRef
        (this.warn
            code: "L024"
            msg: "this doc only re-says the declaration below it; say why it exists, or rename it so no comment is needed"
            :line
            :col
            width: nm.length.u32.orPanic
        )
    }

    # docBlockBody -- the comment block starting at line `from`: each line's text
    # after its `#`, trimmed, joined by single spaces into `into`. Answers the
    # index of the first line after the block.
    docBlockBody: function {this: this.view from: u64 into: String.borrow} out u64 is {
        i: from
        n: this.lines.length
        for i < n loop {
            ln: this.lines.get :i
            t: ln.stringView.trim
            if (t.startsWith "#").not then return i
            body: t.substring from: 1 to: t.length
            if into.length > 0 then into.appendByte b: 32
            into.append s: body.trim
            i = i + 1
        }
        return i
    }

    # docBlockKey -- a doc body's comparison key: its words with the vocabulary
    # of the declaration at `declAt` (the line after the block) and every
    # width folded out, joined.
    docBlockKey: function {this: this.view ws: List String declAt: u64} out String is {
        vocab: List String
        if declAt < this.lines.length then {
            decl: (this.lines.get i: declAt).copy
            docVocabInto s: (docStripComment ln: decl.stringView) into: vocab
        }
        folded: docFoldTemplate words: ws :vocab
        return (docJoinWords xs: folded)
    }

    # reportDuplicateDocs -- L025: the same doc body on more than two definitions in one
    # file. A real invariant stated at forty sites is one invariant and thirty-nine
    # copies: state it once, in the unit header, and leave the sites bare. Blocks under
    # four words are section markers and separators, not docs, and are not counted.
    # Bodies are compared with the declaration's own words and every width folded
    # out, so "u8 to i16: every u8 fits i16" and its u16 twin are one body.
    reportDuplicateDocs: function {:this} is {
        keys: List String
        starts: ListVal u64
        counts: MapRV String v: u64
        i: u64
        n: this.lines.length
        for i < n loop {
            head: this.lines.get :i
            if (docLineIsComment ln: head.stringView) then {
                st: i
                buf: String
                i = this.docBlockBody from: i into: buf
                ws: List String
                docWordsInto s: buf.stringView into: ws
                if ws.length >= 4 then {
                    key: this.docBlockKey :ws declAt: i
                    counts.set key: key.copy value: ((counts.get :key).or d: 0) + 1
                    keys.append from: key.copy
                    starts.append from: st
                }
            } else i = i + 1
        }
        j: u64
        for j < keys.length loop {
            k: keys.get i: j
            c2: (counts.get key: k).or d: 0
            if c2 > 2 then {
                s2: starts.get i: j
                (this.warn
                    code: "L025"
                    msg: "this doc body appears \{c2} times in this file; state it once, in the unit header, and leave the sites bare"
                    line: (s2 + 1).u32.orPanic
                    col: 1
                    width: 1
                )
            }
            j = j + 1
        }
    }

    # walkDocsAsItem -- one as-block member. A generic parameter is a MEMBER a reader
    # hovers, so it reports L018 like a field or an arm; everything else in an as-block
    # is a nested definition to descend into. Both carriers of an as-block, a type's
    # and a function's, hand their members here.
    walkDocsAsItem: function {
        :this
        ast: Ast.view
        m: astnode.view
        docs: bool
        docParams: bool
        docFields: bool
    } is {
        isGP: false
        if m.namedoperation when (zast.isGenericParamOp :ast opId: m.operation) then isGP = true
        if isGP then {
            if docFields then (this.checkDocsMember
                :ast
                member: m
                code: "L018"
                kind: "generic parameter"
            )
            return
        }
        this.walkDocs :ast n: m :docs :docParams :docFields
    }

    # reportDefDocs -- a definition's own two doc judgements: L016 when it
    # carries no doc block, and L024 when the block it carries only re-says the
    # declaration.
    reportDefDocs: function {:this ast: Ast.view site: zast.namedsite docs: bool} is {
        if docs then this.reportUndocDef :ast nameRef: site.name line: site.line col: site.col
        if this.opts.docsQuality then (this.reportDocEcho
            :ast
            nameRef: site.name
            line: site.line
            col: site.col
        )
    }

    # checkDocsMembersIn -- checkDocsMember over every member of `span`, which
    # is the same walk for a parameter, a field and an arm; only the code and
    # the noun differ.
    checkDocsMembersIn: function {
        :this
        ast: Ast.view
        span: zast.kidspan
        code: StringView
        kind: StringView
    } is {
        ids: zast.kidIds :ast :span
        for each mId: ids loop {
            (this.checkDocsMember
                :ast
                member: (ast.nodes.get i: mId)
                :code
                :kind
            )
        }
    }

    # walkDocsAsItems -- walkDocsAsItem over every member of `span`.
    walkDocsAsItems: function {
        :this ast: Ast.view span: zast.kidspan docs: bool docParams: bool docFields: bool
    } is {
        ids: zast.kidIds :ast :span
        for each mId: ids loop {
            (this.walkDocsAsItem
                :ast
                m: (ast.nodes.get i: mId)
                :docs
                :docParams
                :docFields
            )
        }
    }

    # walkDocsIn -- descend into every member of `span` as a definition of its
    # own.
    walkDocsIn: function {
        :this ast: Ast.view span: zast.kidspan docs: bool docParams: bool docFields: bool
    } is {
        ids: zast.kidIds :ast :span
        for each mId: ids loop {
            (this.walkDocsAt
                :ast
                nId: mId
                :docs
                :docParams
                :docFields
            )
        }
    }

    # walkDocsFunction -- a function definition: its own docs, its parameters'
    # docs, and each member of its `as` block.
    walkDocsFunction: function {
        :this
        ast: Ast.view
        site: zast.namedsite
        params: zast.kidspan
        asItems: zast.kidspan
        docs: bool
        docParams: bool
        docFields: bool
    } is {
        this.reportDefDocs :ast :site :docs
        if docParams then (this.checkDocsMembersIn
            :ast
            span: params
            code: "L017"
            kind: "parameter"
        )
        this.walkDocsAsItems :ast span: asItems :docs :docParams :docFields
    }

    # walkDocsObject -- a type definition: its own docs, then its is-block read
    # according to what the kind keeps there, then each member of its `as`
    # block.
    walkDocsObject: function {
        :this
        ast: Ast.view
        site: zast.namedsite
        okind: zast.objectkind
        isItems: zast.kidspan
        asItems: zast.kidspan
        docs: bool
        docParams: bool
        docFields: bool
    } is {
        this.reportDefDocs :ast :site :docs
        isRC: (
            (okind == zast.objectkind.recordDef) or
            (okind == zast.objectkind.classDef) or
            (okind == zast.objectkind.generatorDef)
        )
        isVU: (okind == zast.objectkind.variantDef) or (okind == zast.objectkind.unionDef)
        isPF: (okind == zast.objectkind.protocolDef) or (okind == zast.objectkind.facetDef)
        if docFields when isRC then (this.checkDocsMembersIn
            :ast
            span: isItems
            code: "L018"
            kind: "field"
        )
        # an arm reaches a reader the same way a field does -- hovered, one line
        # of prose -- so it is the same code with its own noun.
        if docFields when isVU then (this.checkDocsMembersIn
            :ast
            span: isItems
            code: "L018"
            kind: "arm"
        )
        # a protocol's and a facet's members are METHOD DECLARATIONS, which sit
        # in the is-block where a record keeps its fields. They are definitions,
        # so they descend to L016 rather than reporting as members.
        if isPF then this.walkDocsIn :ast span: isItems :docs :docParams :docFields
        this.walkDocsAsItems :ast span: asItems :docs :docParams :docFields
    }

    # walkDocsNamed -- a named definition, dispatched on what the name labels: a
    # function, a type, or a nested unit.
    walkDocsNamed: function {
        :this ast: Ast.view site: zast.namedsite docs: bool docParams: bool docFields: bool
    } is {
        op: ast.nodes.get i: site.operation
        match (
            op
        ) case functiondef then {
            (this.walkDocsFunction
                :ast
                :site
                params: op.parameters
                asItems: op.asItems
                :docs
                :docParams
                :docFields
            )
        } case objectdef then {
            (this.walkDocsObject
                :ast
                :site
                okind: op.kind
                isItems: op.isItems
                asItems: op.asItems
                :docs
                :docParams
                :docFields
            )
        } case unitdef then {
            this.walkDocsUnit :ast body: op.body :docs :docParams :docFields
        } else null
    }

    # walkDocsUnit -- a unit definition: its public surface first, then every
    # member that surface admits.
    walkDocsUnit: function {
        :this ast: Ast.view body: zast.kidspan docs: bool docParams: bool docFields: bool
    } is {
        pubSet: IdSet zast.nameid
        hasPub: unitPublicNames :ast :body into: pubSet
        # --docs-private measures the whole unit: a unit with a `public:` block
        # has no public surface to filter BY, so every member is walked. The
        # compiler's units export a handful of names each -- zemitterc.z exports 2
        # of 741 -- so without this the pass reports 0 and means nothing.
        if this.opts.docsPrivate then hasPub = false
        ids: zast.kidIds :ast span: body
        for each bId: ids loop {
            bsite: zast.namedSiteAt :ast nid: bId
            if (unitMemberIsWalkable :ast site: bsite :pubSet :hasPub) then (this.walkDocsAt
                :ast
                nId: bId
                :docs
                :docParams
                :docFields
            )
        }
    }

    # walkDocs -- opt-in doc-coverage pass. L016 flags a type/function/method with
    # no leading `#` block; L017 an undocumented parameter; L018 an undocumented
    # record/class field. Each tier is gated by its own flag.
    walkDocs: function {
        :this ast: Ast.view n: astnode.view docs: bool docParams: bool docFields: bool
    } is {
        match (
            n
        ) case program then {
            wit: ast.units.iterate
            for uId: wit loop {
                (this.walkDocsAt
                    :ast
                    nId: uId
                    :docs
                    :docParams
                    :docFields
                )
            }
        } case unitdef then {
            this.walkDocsUnit :ast body: n.body :docs :docParams :docFields
        } case namedoperation then {
            (this.walkDocsNamed
                :ast
                site: (zast.namedsite
                    name: n.name
                    operation: n.operation
                    line: n.lineno
                    col: n.colno
                )
                :docs
                :docParams
                :docFields
            )
        } else null
    }

    # walkDocsAt -- the id-taking entry: the node view is this frame's, so the
    # program loop can lend prog without an outstanding view lock.
    walkDocsAt: function {
        :this ast: Ast.view nId: zast.nodeid docs: bool docParams: bool docFields: bool
    } is {
        n: ast.nodes.get i: nId
        this.walkDocs :ast :n :docs :docParams :docFields
    }

    # walkDocsProgram -- root entry for the doc-coverage pass.
    walkDocsProgram: function {:this prog: Ast.view docs: bool docParams: bool docFields: bool} is {
        {
            wdi: u64
            wdn: prog.units.length
            for wdi < wdn loop {
                wdid: prog.units.get i: wdi
                this.walkDocsAt ast: prog nId: wdid :docs :docParams :docFields
                wdi = wdi + 1
            }
        }
    }

    # tryBareZeroInit -- L011: a zero/empty binding initializer written as a
    # literal (`"".string`, `0.u64`) where the bare type name constructs the
    # same value. Function-body binding initializers only: record/class
    # fields and parameter defaults keep literal values (a bare type name
    # there is an annotation), and reassignment right-hand sides prefer the
    # coerced bare literal (`x = 0`). The replacement span is byte-verified
    # against the expected source spelling before any edit is recorded.
    tryBareZeroInit: function {:this ast: Ast.view value: astnode.view} is {
        match (
            value
        ) case statementline then {
            this.tryBareZeroInit :ast value: (ast.nodes.get i: value.statementline)
        } case statement then {
            if value.statements.count.u64 == 1 then {
                s0Id: zast.kidAt kids: ast.kids span: value.statements i: 0
                this.tryBareZeroInit :ast value: (ast.nodes.get i: s0Id)
            }
        } case dottedpath then {
            repl: bareZeroTypeName :ast n: (ast.nodes.get i: value.child)
            if repl.length == 0 then return
            ptext: bareZeroParentText :ast n: (ast.nodes.get i: value.parent)
            if ptext.length == 0 then return
            isStr: ptext.stringView == "\"\""
            isStrRepl: repl.stringView == "String"
            if isStr when isStrRepl.not then return
            if isStr.not when isStrRepl then return
            pin: nodeInfoOf n: (ast.nodes.get i: value.parent)
            cin: nodeInfoOf n: (ast.nodes.get i: value.child)
            if pin.line != cin.line then return
            srcOwned: this.source.copy
            srcv: srcOwned.stringView
            lo: (tokByteStart
                lineStart: this.lineStart
                srcLines: this.lines
                lineno: pin.line
                colno: pin.col
            )
            cs: (tokByteStart
                lineStart: this.lineStart
                srcLines: this.lines
                lineno: cin.line
                colno: cin.col
            )
            hi: cs + repl.length
            if hi > srcv.length then return
            ctext: repl.copy
            if isStr then ctext = "string"
            expect: "\{ptext}.\{ctext}"
            actual: srcv.substring from: lo to: hi
            if actual != expect then return
            wm: "zero/empty initializer: write the bare type name `\{repl}`"
            (this.warnFix
                code: "L011"
                msg: wm
                line: pin.line
                col: pin.col
                width: (hi - lo).u32.orPanic
                :lo
                :hi
                :repl
            )
        } else null
    }

    # runFastChecks -- the fast-tier passes: parse-error/AST rules over the tree,
    # then the token rules over the source.
    runFastChecks: function {:this n: Ast.view} is {
        this.lineStart = lineStartIndex src: this.source.stringView
        this.trueId = zast.poolFind pool: n.names text: "true"
        this.falseId = zast.poolFind pool: n.names text: "false"
        scanPool: zast.StringPool.create
        this.fastToks = tokenize.scan source: this.source.copy pool: scanPool
        this.walkProgram prog: n
        this.checkPublicPosProgram prog: n
        this.checkForWhile
    }

    # sortEditsInPlace -- reorder the collected edits by byteLo so the applier and the diff
    # renderer see sorted, overlap-resolvable input.
    sortEditsInPlace: function {:this} is {
        se: sortEdits edits: this.edits
        this.edits = se.take
    }

    # emitSuf -- L005: a redundant numeric suffix. The safe fix removes the `.` and the type
    # name (e.g. `5.i32` -> `5`); the context already pins the type.
    emitSuf: function {:this ln: u32 col: u32 tname: StringView} is {
        srcOwned: this.source.copy
        sv: srcOwned.stringView
        lineStart: lineStartIndex src: sv
        srcLines: linesOf src: sv
        byteStart: tokByteStart :lineStart :srcLines lineno: ln colno: col
        lo: byteStart
        if byteStart > 0 then lo = byteStart - 1
        hi: byteStart + tname.length
        (this.warnFix
            code: "L005"
            msg: "redundant numeric suffix `.\{tname}`"
            line: ln
            :col
            width: tname.length.u32.orPanic
            :lo
            :hi
            repl: ""
        )
    }

    # sufBinop -- a binop operand whose numeric suffix the other (non-literal, same-type)
    # operand makes redundant.
    sufBinop: function {
        ast: Ast.view
        :this
        lhs: astnode.view
        rhs: astnode.view
        isCmp: bool
        st: zenv.ZSymbolTable.view
    } is {
        # a LEADING literal's suffix is load-bearing at arithmetic ops (the
        # bare form defaults i64 and mismatches); only comparisons coerce a
        # literal from either side, so only there can the lhs suffix be
        # redundant
        if isCmp then {
            ls: operandSuffix :ast n: lhs
            if ls.tname.length > 0 when (isAnchor :ast n: rhs tname: ls.tname.stringView :st) then {
                this.emitSuf ln: ls.line col: ls.col tname: ls.tname.stringView
            }
        }
        rs: operandSuffix :ast n: rhs
        if rs.tname.length > 0 when (isAnchor :ast n: lhs tname: rs.tname.stringView :st) then {
            this.emitSuf ln: rs.line col: rs.col tname: rs.tname.stringView
        }
    }

    # sufReassign -- a reassignment value whose suffix the target's type fixes.
    sufReassign: function {
        ast: Ast.view
        :this
        topath: astnode.view
        value: astnode.view
        st: zenv.ZSymbolTable.view
    } is {
        vs: operandSuffix :ast n: value
        if vs.tname.length > 0 then {
            tn: typeNameOfNode n: topath :st
            if tn.length > 0 when tn.stringView == vs.tname then {
                this.emitSuf ln: vs.line col: vs.col tname: vs.tname.stringView
            }
        }
    }

    # emitConv -- L015 / L031 caret + safe fix: delete the `.member` conversion
    # span.
    emitConv: function {
        :this
        ln: u32
        col: u32
        mname: StringView
        msg: String.take
        code: StringView
    } is {
        srcOwned: this.source.copy
        sv: srcOwned.stringView
        lineStart: lineStartIndex src: sv
        srcLines: linesOf src: sv
        byteStart: tokByteStart :lineStart :srcLines lineno: ln colno: col
        lo: byteStart
        if byteStart > 0 then lo = byteStart - 1
        hi: byteStart + mname.length
        (this.warnFix
            :code
            :msg
            line: ln
            :col
            width: mname.length.u32.orPanic
            :lo
            :hi
            repl: ""
        )
    }

    # litStringRedundant -- L015: a written `"text".string` where the destination
    # is known to be a String. The checker makes the literal that String there by
    # itself (spec: String Literal Types), so the suffix only repeats it; the
    # safe fix deletes it. A `.string` the checker supplied sits at the literal's
    # own position, and is no one's to delete.
    litStringRedundant: function {
        :this
        ast: Ast.view
        opId: zast.nodeid
        destTid: ztypes.tid
        strTid: ztypes.tid
    } is {
        if destTid.isZero or (destTid != strTid) then return
        cln: u32
        ccl: u32
        isLitString: false
        {
            dpn: ast.nodes.get i: opId
            if dpn.dottedpath then {
                lit: ast.nodes.get i: dpn.parent
                chn: ast.nodes.get i: dpn.child
                ci: nodeInfoOf n: chn
                li: nodeInfoOf n: lit
                written: (ci.line != li.line) or (ci.col != li.col)
                if lit.atomstring when written when (
                    (atomNameIdOf n: chn).u32 == zast.names.wkString
                ) then {
                    isLitString = ztypecheck.stringLitIsPlain :ast parts: lit.stringparts
                    cln = ci.line
                    ccl = ci.col
                }
            }
        }
        if isLitString.not then return
        (this.emitConv
            ln: cln
            col: ccl
            mname: "string"
            msg: "redundant conversion: `.string` on a literal the String destination makes one of already"
            code: "L015"
        )
    }

    # wideningRedundant -- L031: `x.T` where `x` is a builtin numeric, the
    # conversion only widens, and the destination is a `T` already: the checker
    # widens a builtin numeric losslessly by itself there. A lossy conversion
    # types as a Result, so a conversion that types as plain `T` is the lossless
    # one. A typedef does not widen implicitly and is never reported; neither is
    # a suffixed literal (`5.u32`), which is a literal's type, not a conversion.
    wideningRedundant: function {
        :this
        ast: Ast.view
        opId: zast.nodeid
        destTid: ztypes.tid
        st: zenv.ZSymbolTable
    } is {
        if destTid.isZero then return
        cln: u32
        ccl: u32
        from: ztypes.tid
        mname: String
        {
            dpn: ast.nodes.get i: opId
            if dpn.dottedpath then {
                bn: ast.nodes.get i: dpn.parent
                chn: ast.nodes.get i: dpn.child
                if (isNumericLiteralNode :ast n: bn).not then {
                    from = ztyping.nodeTypeAt tbl: st.typing.nodeType nid: (nodeInfoOf n: bn).id
                    mname = atomName :ast n: chn
                    ci: nodeInfoOf n: chn
                    cln = ci.line
                    ccl = ci.col
                }
            }
        }
        if from.isZero or (from == destTid) or (mname.length == 0) then return
        if (ztyping.nodeTypeAt tbl: st.typing.nodeType nid: opId) != destTid then return
        if (builtinNumericTid :ast :st tid: from).not then return
        if (builtinNumericTid :ast :st tid: destTid).not then return
        # a conversion is named for the type it makes; any other member that
        # types as a numeric -- `.bits`, `.length` -- is not one
        if (st.reg.nameOf tid: destTid).stringView != mname then return
        (this.emitConv
            ln: cln
            col: ccl
            mname: mname.stringView
            msg: "redundant conversion: `.\{mname}` only widens, and the destination is a \{mname} already"
            code: "L031"
        )
    }

    # litStringReturned -- litStringRedundant for a `return`, against the
    # enclosing function's declared return type.
    litStringReturned: function {
        :this
        ast: Ast.view
        arguments: zast.kidspan
        st: zenv.ZSymbolTable
        funcretId: zast.nodeid
    } is {
        if (arguments.count.u64 != 1) or funcretId.isZero then return
        rarg: ast.nodes.get i: (zast.kidAt kids: ast.kids span: arguments i: 0)
        if rarg.namedoperation.not then return
        rt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: funcretId
        (this.litStringRedundant
            :ast
            opId: rarg.operation
            destTid: rt
            strTid: (ztypecheck.builtinTidTRo scope: ztypes.declid :ast :st base: "String")
        )
        this.wideningRedundant :ast opId: rarg.operation destTid: rt :st
    }

    # slConvArg -- one call argument: flag a redundant StringLike conversion.
    # Direction A: `x.stringView` on a String base (free but pointless).
    # Direction B: `sv.string` on a StringView base -- allocates an
    # owned String the callee only borrows. Both fire only when the parameter
    # is a generic constrained StringLike (either string form is accepted
    # directly); B is skipped for a `.take` parameter (it keeps the value).
    slConvArg: function {
        :this
        ast: Ast.view
        opId: zast.nodeid
        originTid: ztypes.tid
        pname: StringView
        ptid: ztypes.tid
        strTid: ztypes.tid
        svTid: ztypes.tid
        st: zenv.ZSymbolTable.view
    } is {
        if (st.reg.isTypeParamOf tid: ptid).not then return
        gpn: st.reg.nameOf tid: ptid
        tk: ztypecheck.declOfTypeId :st tid: originTid
        cd: (st.reg.genericParamConstraintOf
            tdecl: tk
            paramName: (zast.poolFind pool: ast.names text: gpn.stringView)
        )
        if (cd.kind == ztypes.constraintkind.stringLike).not then return
        cn: String
        cln: u32
        ccl: u32
        bnid: zast.nodeid
        {
            dpn: ast.nodes.get i: opId
            if dpn.dottedpath then {
                chn: ast.nodes.get i: dpn.child
                cn = atomName :ast n: chn
                ci: nodeInfoOf n: chn
                cln = ci.line
                ccl = ci.col
                pnn: ast.nodes.get i: dpn.parent
                bni: nodeInfoOf n: pnn
                bnid = bni.id
            }
        }
        if cn.length == 0 then return
        if bnid.isZero then return
        bt: ztypes.tid
        bto: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: bnid
        if bto.isZero.not then bt = bto
        if bt.isZero then return
        if (ztypecheck.isStringViewMember name: cn.stringView) when bt == strTid then {
            (this.emitConv
                ln: cln
                col: ccl
                mname: "stringView"
                msg: "redundant conversion: `.stringView` on a String argument (the parameter accepts StringLike)"
                code: "L015"
            )
            return
        }
        isOwned: false
        if cn.stringView == "string" then isOwned = true
        if isOwned when bt == svTid when (st.typing.declOwnershipIs
            pool: ast.names
            parentTypeId: originTid
            name: pname
            own: ztypes.zparamownership.takeMode
        ).not then {
            (this.emitConv
                ln: cln
                col: ccl
                mname: cn.stringView
                msg: "redundant conversion: `.\{cn}` allocates an owned String the call only borrows (the parameter accepts StringLike)"
                code: "L015"
            )
        }
    }

    # paramIndexByLabel -- the index of the parameter named `label` among
    # `names`, or none.
    paramIndexByLabel: function {
        this: this.view
        names: (List String).view
        label: StringView
    } out optionval u64 is {
        pi: u64
        for pi < names.length loop {
            if (names.get i: pi).stringView == label then return (optionval.some pi)
            pi = pi + 1
        }
        return (optionval.none u64)
    }

    # firstNonReceiverParam -- the index of the first parameter that is not the
    # receiver -- `this`, or the type's recorded receiver name -- or none: the
    # parameter an elided first label binds.
    firstNonReceiverParam: function {
        this: this.view
        names: (List String).view
        nameIds: (ListVal u64).view
        thisPn: StringView
    } out optionval u64 is {
        pj: u64
        for pj < names.length loop {
            isRecv: (
                ((nameIds.get i: pj) == zast.names.wkThis.u64) or
                ((thisPn.length > 0) and (thisPn == (names.get i: pj)))
            )
            if isRecv.not then return (optionval.some pj)
            pj = pj + 1
        }
        return (optionval.none u64)
    }

    # slConvCall -- L015 over one call: resolve the callee's template and
    # check each argument's conversion shape against its parameter.
    slConvCall: function {
        :this
        ast: Ast.view
        callNid: zast.nodeid
        callable: astnode.view
        arguments: zast.kidspan
        st: zenv.ZSymbolTable
        # the enclosing function's return type node, which a `return` answers to
        funcretId: zast.nodeid
    } is {
        ck: st.typing.callKind.get key: callNid
        if ck.some when ck.returnCall then {
            this.litStringReturned :ast :arguments :st :funcretId
            return
        }
        callee: ztypes.tid
        cInfo: nodeInfoOf n: callable
        co: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: cInfo.id
        if co.isZero.not then callee = co
        if callee.isZero then return
        # a construction's fields are its parameters
        if (takesArguments tt: (st.reg.typetypeOf typeId: callee)).not then return
        origin: callee
        go: st.reg.genericOriginOf tid: callee
        if go.isZero.not then origin = go
        thisPn: (zast.poolTextAt
            pool: ast.names
            ref: (st.reg.thisParamNameIdOf tid: origin)
        )
        names: List String
        ids: ListVal ztypes.tid
        nameIds: ListVal u64
        (ztypecheck.dataFieldNames
            :ast
            :st
            tid: origin
            :names
            :ids
            :nameIds
        )
        if names.length == 0 then return
        strTid: ztypecheck.builtinTidTRo scope: ztypes.declid :ast :st base: "String"
        svTid: ztypecheck.builtinTidTRo scope: ztypes.declid :ast :st base: "StringView"
        firstArg: true
        h5x9: u64
        for h5x9 < arguments.count loop {
            aId: zast.kidAt kids: ast.kids span: arguments i: h5x9
            h5x9 = h5x9 + 1
            arg: ast.nodes.get i: aId
            if arg.namedoperation.not then continue
            an: zast.nameTextAt :ast ref: arg.name
            pidx: optionval.none u64
            if an.length > 0 then {
                pidx = this.paramIndexByLabel :names label: an.stringView
            } else if firstArg then {
                # the elided first label binds the first non-receiver param
                pidx = this.firstNonReceiverParam :names :nameIds thisPn: thisPn.stringView
            }
            firstArg = false
            if pidx.none then continue
            pnmc: names.get i: pidx
            (this.litStringRedundant
                :ast
                opId: arg.operation
                destTid: (ids.get i: pidx)
                :strTid
            )
            (this.wideningRedundant
                :ast
                opId: arg.operation
                destTid: (ids.get i: pidx)
                :st
            )
            (this.slConvArg
                :ast
                opId: arg.operation
                originTid: origin
                pname: pnmc.stringView
                ptid: (ids.get i: pidx)
                :strTid
                :svTid
                :st
            )
        }
    }

    # sufNamedArg -- a named call/constructor argument whose suffix the parameter / field type
    # fixes.
    sufNamedArg: function {
        :this ast: Ast.view arg: astnode.view calleeType: ztypes.tid st: zenv.ZSymbolTable.view
    } is {
        if arg.namedoperation then {
            an: zast.nameTextAt :ast ref: arg.name
            if an.length > 0 then {
                s: operandSuffix :ast n: (ast.nodes.get i: arg.operation)
                if s.tname.length > 0 then {
                    # a generic-origin param never anchors a defix: the
                    # suffix is what SELECTS the instantiation (the mono's
                    # concrete param type was inferred from this argument)
                    gorig: calleeType
                    goS: st.reg.genericOriginOf tid: calleeType
                    if goS.isZero.not then gorig = goS
                    if gorig != calleeType then {
                        opto: (st.typing.declChildOf
                            pool: ast.names
                            parentTypeId: gorig
                            name: an.stringView
                        )
                        match (
                            opto
                        ) case some then {
                            if (st.reg.isTypeParamOf
                                tid: opto
                            ) then return
                        } case none then null
                    }
                    pto: (st.typing.declChildOf
                        pool: ast.names
                        parentTypeId: calleeType
                        name: an.stringView
                    )
                    match (
                        pto
                    ) case some then {
                        ptn: st.reg.nameOf tid: pto
                        if ptn.stringView == s.tname then {
                            this.emitSuf ln: s.line col: s.col tname: s.tname.stringView
                        }
                    } case none then null
                }
            }
        }
    }

    # sufNamedArgReturn -- a return value whose suffix the enclosing function's return type
    # fixes.
    sufNamedArgReturn: function {:this ast: Ast.view arg: astnode.view rtName: StringView} is {
        match (
            arg
        ) case namedoperation then {
            s: operandSuffix :ast n: (ast.nodes.get i: arg.operation)
            if s.tname.length > 0 when s.tname.stringView == rtName then {
                this.emitSuf ln: s.line col: s.col tname: s.tname.stringView
            }
        } else {
            s8: operandSuffix :ast n: arg
            if s8.tname.length > 0 when s8.tname.stringView == rtName then {
                this.emitSuf ln: s8.line col: s8.col tname: s8.tname.stringView
            }
        }
    }

    # sufCall -- redundant suffixes in a call: a `return` uses the enclosing function's return
    # type; otherwise each named argument's parameter type.
    sufCall: function {
        :this
        ast: Ast.view
        callNid: zast.nodeid
        callable: astnode.view
        arguments: zast.kidspan
        st: zenv.ZSymbolTable.view
        funcretId: zast.nodeid
    } is {
        ck: st.typing.callKind.get key: callNid
        isRet: false
        match (
            ck
        ) case some then {
            if ck.returnCall then isRet = true
        } case none then null
        if isRet then {
            rtName: typeNameOfOptAt :ast oId: funcretId :st
            if rtName.length > 0 then {
                h6x9: u64
                for h6x9 < arguments.count loop {
                    aId: zast.kidAt kids: ast.kids span: arguments i: h6x9
                    h6x9 = h6x9 + 1
                    (this.sufNamedArgReturn
                        :ast
                        arg: (ast.nodes.get i: aId)
                        rtName: rtName.stringView
                    )
                }
            }
        } else {
            cInfo: nodeInfoOf n: callable
            co: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: cInfo.id
            if co.isZero.not then {
                h7x9: u64
                for h7x9 < arguments.count loop {
                    aId: zast.kidAt kids: ast.kids span: arguments i: h7x9
                    h7x9 = h7x9 + 1
                    (this.sufNamedArg
                        :ast
                        arg: (ast.nodes.get i: aId)
                        calleeType: co
                        :st
                    )
                }
            }
        }
    }

    # walkSuf -- preorder over the subtree running the typecheck-based suffix check, threading
    # the enclosing function's return type for `return`s. The arms a check reads are spelled;
    # every child is visited through zast.childIds.
    walkSuf: function {
        :this
        ast: Ast.view
        n: astnode.view
        uname: StringView
        st: zenv.ZSymbolTable
        funcretId: zast.nodeid
    } is {
        if (hiddenSubunitAt :ast :n) then return
        {
            ipS: zast.infixPartsOf :ast :n
            if ipS.found then {
                blS: ast.nodes.get i: ipS.lhs
                brS: ast.nodes.get i: ipS.rhs
                bopS: atomName :ast n: (ast.nodes.get i: ipS.operator)
                (this.sufBinop
                    :ast
                    lhs: blS
                    rhs: brS
                    isCmp: (ztypecheck.isComparisonOp name: bopS.stringView)
                    :st
                )
            }
        }
        match (
            n
        ) case call then {
            (this.sufCall
                :ast
                callNid: n.nodeid
                callable: (ast.nodes.get i: n.callable)
                arguments: n.arguments
                :st
                :funcretId
            )
            (this.slConvCall
                :ast
                callNid: n.nodeid
                callable: (ast.nodes.get i: n.callable)
                arguments: n.arguments
                :st
                :funcretId
            )
        } case reassignment then {
            tpn: ast.nodes.get i: n.topath
            rvn: ast.nodes.get i: n.value
            this.sufReassign :ast topath: tpn value: rvn :st
            rtt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: n.topath
            (this.litStringRedundant
                :ast
                opId: n.value
                destTid: rtt
                strTid: (ztypecheck.builtinTidTRo scope: ztypes.declid :ast :st base: "String")
            )
            this.wideningRedundant :ast opId: n.value destTid: rtt :st
        } case functiondef then {
            # the function's own return type is the funcret for everything below it
            this.walkSufRet :ast retId: n.returntype :uname :st
            this.walkSufIds :ast ids: n.parameters :uname :st funcretId: n.returntype
            this.walkSufOptAt :ast oId: n.body :uname :st funcretId: n.returntype
            this.walkSufIds :ast ids: n.asItems :uname :st funcretId: n.returntype
            return
        } else null
        sl9: zast.childIds :ast :n
        for each s9: sl9 loop {
            (this.walkSuf
                :ast
                n: (ast.nodes.get i: s9)
                :uname
                :st
                :funcretId
            )
        }
    }

    # walk a list of children for the numeric-suffix rule
    walkSufIds: function {
        :this
        ast: Ast.view
        ids: zast.kidspan
        uname: StringView
        st: zenv.ZSymbolTable
        funcretId: zast.nodeid
    } is {
        h11x9: u64
        for h11x9 < ids.count loop {
            c: zast.kidAt kids: ast.kids span: ids i: h11x9
            h11x9 = h11x9 + 1
            this.walkSuf :ast n: (ast.nodes.get i: c) :uname :st :funcretId
        }
    }

    # walkSufOptAt -- the id-taking entry (0 = absent).
    walkSufOptAt: function {
        :this
        ast: Ast.view
        oId: zast.nodeid
        uname: StringView
        st: zenv.ZSymbolTable
        funcretId: zast.nodeid
    } is {
        if oId.isZero then return
        o: ast.nodes.get i: oId
        this.walkSuf :ast n: o :uname :st :funcretId
    }

    # a functiondef returntype doubles as its own funcret: this frame lets
    # the two arguments share one root without aliasing one source path
    walkSufRet: function {
        :this ast: Ast.view retId: zast.nodeid uname: StringView st: zenv.ZSymbolTable
    } is {
        if retId.isZero then return
        r: ast.nodes.get i: retId
        this.walkSuf :ast n: r :uname :st funcretId: retId
    }

    # lintSuffixUnit -- run the suffix check over the linted unit.
    lintSuffixUnit: function {:this prog: Ast.view lu: LintedUnit.view st: zenv.ZSymbolTable} is {
        (this.walkSuf
            ast: prog
            n: (prog.nodes.get i: lu.op)
            uname: lu.name.stringView
            :st
            funcretId: zast.nodeid
        )
    }

    # checkSuffix -- L005 (typecheck tier): build the project VFS, parse this file's unit in the
    # project, typecheck, and walk the typed tree for redundant numeric suffixes. A tier that
    # cannot run -- a root that is not a directory, a unit not found, a dependency that does not
    # parse -- is reported as an error naming why: `--full` never passes a file it did not check.
    checkSuffix: function {
        :this srcdirs: (List String).view systemdir: StringView uname: StringView
    } is {
        if (this.rootsReady :srcdirs :systemdir).not then return
        vfs: (zvfs.ZVfs
            providers: List zvfs.ProviderBox
            providerRoot: (IdMapR u32 V: String)
            entrytable: (zvfs.DentryTable entries: (ListVal zvfs.dentry i: zvfs.fsno))
            file_names: (List String i: zvfs.fsno)
            walk_cache: (MapRV String v: zvfs.fsno)
            rootid: zvfs.fsno
            shadow: (zvfs.shadowpair active: false top: zvfs.fsno base: zvfs.fsno)
        )
        vfs.registerNull
        systemid: vfs.registerFS rootpath: systemdir.string parentpath: ""
        vfs.bindRoot newid: systemid kind: zvfs.bindkind.instead
        # each `before` goes ahead of what is already bound, so binding back to
        # front leaves the first --src searched first, as zc resolves them
        rootid: zvfs.fsno
        si: srcdirs.length
        for si > 0 loop {
            si = si - 1
            sd: srcdirs.get i: si
            sid: vfs.registerFS rootpath: sd.copy parentpath: ""
            rootid = vfs.bindRoot newid: sid kind: zvfs.bindkind.before
        }
        p: zparser.Parser.create
        prog: p.parse :vfs :rootid mainUnitName: uname.string
        # a failed parse names its error as the tree's root row. The test is a
        # call so no lock outlives it: typecheck below takes the tree.
        if (zast.isErrorAt ast: prog id: prog.root) then {
            this.reportUnparsedProject :prog :vfs :srcdirs :uname
        } else {
            # the unit this FILE is, found by the file and never by name: a
            # subunit is found inside its parent, and a same-named unit another
            # root answers is not this file
            self: this.selfFsnoOf :vfs :prog
            lu: lintedUnitOf :prog :self
            if lu.op.isZero then {
                mw: "no unit the roots load for '\{uname}' comes from this file (a subunit loads only when its parent names it)"
                (this.reportTierSkipped
                    errv: zast.err.badReference
                    cause: mw.stringView
                    note: String
                    hint: projectHint
                )
                return
            }
            reg: ztypes.newRegistry
            ccPath9v: zcheck.pickCc ccFlag: "" targetTriple: ""
            ccMode9v: zcheck.pickCcMode modeFlag: ""
            # the fold paths by the same default resolution zc uses, so a
            # `require:` guard decides the same here as it does in a build
            foldPaths9: List String
            rtd9v: zcheck.resolveRuntimeDir flagVal: ""
            if (zcheck.foldNativePaths runtimeDir: rtd9v.stringView into: foldPaths9).not then {
                rw: zcheck.unreadableRuntimeCause runtimeDir: rtd9v.stringView
                (this.reportTierSkipped
                    errv: zast.err.ioError
                    cause: rw.stringView
                    note: String
                    hint: zcheck.runtimeHint
                )
                return
            }
            st: (ztypecheck.typecheck
                program: prog
                :reg
                eager: true
                requireMain: false
                dumpRows: false
                ccPath: ccPath9v.stringView
                ccMode: ccMode9v.stringView
                target: ""
                foldPaths: foldPaths9
            )
            this.reportTypeErrors :st :prog
            this.placeForeignDiags :vfs :self
            # the rules below read what the typecheck STAMPED. On a failed
            # typecheck that evidence is partial, so they would report from it
            # rather than about it
            if st.typing.errors.length == 0 then {
                this.lintSuffixUnit :prog :lu :st
                this.reportUnusedDefs :prog :lu :st
                this.reportUnusedVars :prog :lu :st
                this.reportViewableLocals :prog :lu :st
                if this.opts.arch then this.reportArch :prog :lu :st :srcdirs :systemdir
            }
        }
    }

    # rootsReady -- whether every root the typecheck tier registers is a
    # directory; a missing one is reported as the reason the tier did not run.
    rootsReady: function {:this srcdirs: (List String).view systemdir: StringView} out bool is {
        cause: zcheck.missingRootCause :systemdir :srcdirs
        if cause.length == 0 then return true
        (this.reportTierSkipped
            errv: zast.err.ioError
            cause: cause.stringView
            note: String
            hint: projectHint
        )
        return false
    }

    # reportUnparsedProject -- the project parse failed, so the typecheck tier
    # did not run: this unit is under no src root, or a unit it loads does not
    # parse. A parse error in the file itself is already the fast tier's report.
    reportUnparsedProject: function {
        :this
        prog: Ast.view
        vfs: zvfs.ZVfs
        srcdirs: (List String).view
        uname: StringView
    } is {
        if this.parseErrorCount > 0 then return
        progRoot: prog.nodes.get i: prog.root
        match (
            progRoot
        ) case error then {
            e: zast.errorDataOf ast: prog row: progRoot
            if e.lineno == 0 when e.err.badReference then {
                roots: String
                for each r: srcdirs loop {
                    if roots.length > 0 then roots.append ", "
                    roots.append r
                }
                mu: "unit '\{uname}' is under none of the src roots (\{roots})"
                (this.reportTierSkipped
                    errv: e.err
                    cause: mu.stringView
                    note: String
                    hint: projectHint
                )
                return
            }
            where: String
            if e.fsno.isZero.not then {
                path: vfs.displayPath dentryid: e.fsno
                at: "in \{path} at line \{e.lineno}: "
                where.append at
            }
            where.append (zast.errorLine :e)
            (this.reportTierSkipped
                errv: e.err
                cause: "a unit it loads does not parse"
                note: where.take
                hint: projectHint
            )
        } else null
    }

    # reportTierSkipped -- the typecheck tier did not run for this file: an
    # error naming why, and what names the piece it could not find.
    reportTierSkipped: function {
        :this
        errv: zast.err
        cause: StringView
        note: String.take
        # what names the missing piece
        hint: StringView
    } is {
        msg: "the typecheck tier (--full) did not run: \{cause}"
        d: (zdiag.errorDiag
            :errv
            fsno: zvfs.fsno
            lineno: 0
            colno: 0
            width: 0
            msg: msg.take
            :note
            hint: hint.string
        )
        this.diags.append d
    }

    # placeForeignDiags -- a diagnostic the typecheck found in another file than
    # this one names that file and shows its line. The project's file system
    # is gone once the tier returns, so each is placed now.
    placeForeignDiags: function {:this vfs: zvfs.ZVfs.view self: zvfs.fsno} is {
        n: this.diags.length
        i: u64
        for i < n loop {
            f: (this.diags.get :i).fsno
            ln: (this.diags.get :i).lineno
            if f.isZero.not when (f == self).not then {
                fp: vfs.displayPath dentryid: f
                srcLine: String
                hasLine: false
                if ln > 0 then {
                    got: vfs.getline dentryid: f lineno: ln.u64 - 1
                    match (
                        got
                    ) case some then {
                        srcLine = got.take
                        hasLine = true
                    } case none then null
                }
                at: DiagSrc path: fp.take line: srcLine.take :hasLine
                this.elsewhere.set key: i.u32.orPanic value: at.take
            }
            i = i + 1
        }
    }

    # selfFsnoOf -- the fsno the parse gave THIS file: the loaded file that is
    # the same filesystem object as its path, so two spellings of one path
    # agree. 0 when the parse did not load it.
    selfFsnoOf: function {this: this.view vfs: zvfs.ZVfs.view prog: Ast.view} out zvfs.fsno is {
        found: zvfs.fsno
        for each f: prog.files loop {
            if found.isZero then {
                fp: vfs.pathfromproviderNative dentryid: f
                if (sameFile a: fp.stringView b: this.path.stringView) then found = f
            }
        }
        return found
    }

    # reportTypeErrors -- the typecheck's own diagnostics. This tier already
    # runs a COMPLETE eager typecheck, because its rules read what that run
    # stamps; these are what the same run found, and they used to be discarded.
    # That mattered: compilation is demand-driven from `main`, so a definition
    # nothing demands is walked by no build, and until eager-lib-guard no gate
    # compiled a library unit under `--eager` either. `requireMain: false` is
    # why this works on a unit that is not a program.
    # A typecheck error stamps fsno 0, so its file is the one its node is in,
    # as zc reads it; 0 still (this file) when it names no node.
    reportTypeErrors: function {:this st: zenv.ZSymbolTable.view prog: Ast.view} is {
        for each er: st.typing.errors loop {
            ef: er.fsno
            if ef.isZero when er.nodeid.isZero.not then ef = prog.fsnoForNode nodeid: er.nodeid
            d: (zdiag.errorDiag
                errv: er.err
                fsno: ef
                lineno: er.lineno
                colno: er.colno
                width: er.width
                msg: er.msg.copy
                note: er.note.copy
                hint: er.hint.copy
            )
            this.diags.append d
        }
    }

    # reportArch -- the typecheck-tier architecture rules. A003: a `==` / `!=`
    # in this unit against a literal that spells a unit or type name of the
    # program -- routing by the name of a thing that has an id. A004: a record
    # or class field of this unit that no dotted read in the PROJECT reaches --
    # every `.z` under --src and --system is parsed for its member reads, so the
    # evidence does not depend on which program happens to be compiled here, and
    # a field is reported where it is declared. Units under --system are exempt
    # (a library's surface is not dead for being unread by one project), as are
    # native types (their fields are the runtime's to read). The read evidence
    # is by name: conservative, so a same-named field elsewhere hides a hit
    # rather than inventing one.
    reportArch: function {
        :this
        prog: Ast.view
        lu: LintedUnit.view
        st: zenv.ZSymbolTable.view
        srcdirs: (List String).view
        systemdir: StringView
    } is {
        {
            mainOp: lu.op
            uname: lu.name.stringView
            namedIds: IdSet zast.nameid
            {
                # row 0 is the no-declaration sentinel
                di: ztypes.declid.zero.next
                for di < st.typing.nextDecl loop {
                    d: st.typing.decls.get i: di
                    isNamed: d.kind.unitDecl
                    if d.kind.typeDecl then isNamed = true
                    if isNamed then namedIds.add item: (zast.nameid.create from: d.name)
                    di = di.next
                }
            }
            this.archWalk ast: prog nId: mainOp :namedIds
            # A007 speaks only for a top-level unit that lives under one of the
            # roots; a subunit exports nothing past its parent
            inSrc: false
            if lu.names.length > 1 then return
            for each d: srcdirs loop {
                du: unitNamesIn dir: d.stringView
                if (du.contains item: uname.string) then inSrc = true
            }
            if inSrc.not then return
            this.reportUnusedExports ast: prog unitId: mainOp :uname :srcdirs
            readNames: Set String
            for each d2: srcdirs loop {
                projectReadNames dir: d2.stringView into: readNames
            }
            projectReadNames dir: systemdir into: readNames
            bodyIds: zast.unitBodyIdsAt ast: prog unitId: mainOp
            vx379: u64
            for vx379 < bodyIds.count loop {
                mId: zast.kidAt kids: prog.kids span: bodyIds i: vx379
                vx379 = vx379 + 1
                m: prog.nodes.get i: mId
                if m.namedoperation then {
                    tn: zast.poolTextAt pool: prog.names ref: m.name
                    this.archFields ast: prog opId: m.operation :readNames typeName: tn.stringView
                }
            }
        }
    }

    # reportUnusedExports -- A007: a name this unit's `public:` block exports
    # that no other unit under --src reads as `<unit>.<name>`. An export with
    # no importer is a private definition wearing a public label, and L012
    # cannot judge it until the label goes. Units under --system are exempt:
    # their exports serve examples, tests and the runtime's fragments, none
    # of them under --src. The read evidence is by name: conservative, so a
    # same-named read elsewhere hides a hit rather than inventing one.
    reportUnusedExports: function {
        :this
        ast: Ast.view
        unitId: zast.nodeid
        uname: StringView
        srcdirs: (List String).view
    } is {
        reads: Set String
        for each d: srcdirs loop {
            projectUnitReads dir: d.stringView :uname into: reads
        }
        # the entry point is read by the loader, not by a unit
        mainId: zast.poolFind pool: ast.names text: "main"
        bodyIds: zast.unitBodyIdsAt :ast :unitId
        vx389: u64
        for vx389 < bodyIds.count loop {
            mId: zast.kidAt kids: ast.kids span: bodyIds i: vx389
            vx389 = vx389 + 1
            m: ast.nodes.get i: mId
            if m.namedoperation when (zast.unitOpKindIs
                :ast
                opId: m.operation
                k: zast.unitkind.publicNs
            ) then {
                this.reportUnreadExportsIn :ast opId: m.operation :reads :mainId
            }
        }
    }

    # reportUnreadExportsIn -- each `:name` of one public block that `reads` lacks;
    # the block's items are the labels' named operations.
    reportUnreadExportsIn: function {
        :this
        ast: Ast.view
        opId: zast.nodeid
        reads: (Set String).view
        mainId: zast.nameid
    } is {
        ud: ast.nodes.get i: opId
        if ud.unitdef then {
            box2149: u64
            for box2149 < ud.body.count loop {
                lid: zast.kidAt kids: ast.kids span: ud.body i: box2149
                box2149 = box2149 + 1
                lv: ast.nodes.get i: lid
                if lv.namedoperation then {
                    nm: zast.poolTextAt pool: ast.names ref: lv.name
                    if (reads.has item: nm).not when lv.name != mainId then {
                        (this.info
                            code: "A007"
                            msg: "export `\{nm}` is read by no other unit under --src; make it private and let L012 judge it"
                            line: lv.lineno
                            col: lv.colno
                            width: nm.length.u32.orPanic
                        )
                    }
                }
            }
        }
    }

    # archFields -- A004 over one record / class definition of this unit.
    archFields: function {
        :this ast: Ast.view opId: zast.nodeid readNames: (Set String).view typeName: StringView
    } is {
        n: ast.nodes.get i: opId
        if n.objectdef then {
            isData: n.kind.recordDef
            if n.kind.classDef then isData = true
            if n.kind.generatorDef then isData = true
            if isData.not then return
            if n.isNative then return
            isx1939: u64
            for isx1939 < n.isItems.count loop {
                mId: zast.kidAt kids: ast.kids span: n.isItems i: isx1939
                isx1939 = isx1939 + 1
                m: ast.nodes.get i: mId
                if m.namedoperation then {
                    mop: ast.nodes.get i: m.operation
                    fnm: zast.poolTextAt pool: ast.names ref: m.name
                    if mop.functiondef.not when (readNames.has item: fnm).not then {
                        (this.warn
                            code: "A004"
                            msg: "field `\{typeName}.\{fnm}` is written and never read anywhere in the project"
                            line: m.lineno
                            col: m.colno
                            width: 1
                        )
                    }
                }
            }
        }
    }

    # archWalk -- A003 at every literal compare of the unit's subtree.
    archWalk: function {
        :this ast: Ast.view nId: zast.nodeid namedIds: (IdSet zast.nameid).view
    } is {
        n: ast.nodes.get i: nId
        if (hiddenSubunitAt :ast :n) then return
        kids: zast.childIds :ast :n
        {
            ipA: zast.infixPartsOf :ast :n
            if ipA.found then {
                opA: atomName :ast n: (ast.nodes.get i: ipA.operator)
                isCmpA: opA.stringView == "=="
                if opA.stringView == "!=" then isCmpA = true
                if isCmpA then {
                    this.archNamedLiteral :ast id: ipA.lhs :namedIds
                    this.archNamedLiteral :ast id: ipA.rhs :namedIds
                }
            }
        }
        for each c: kids loop {
            this.archWalk :ast nId: c :namedIds
        }
    }

    # a named argument whose value is a literal, which the composed-key rule
    # reads
    archNamedLiteral: function {
        :this ast: Ast.view id: zast.nodeid namedIds: (IdSet zast.nameid).view
    } is {
        n: ast.nodes.get i: id
        txt: plainLiteralText :ast :n
        match (
            txt
        ) case some then {
            nid: ast.names.find s: txt.stringView
            if nid.isZero.not when (namedIds.has item: nid) then {
                p: zast.posOf :n
                (this.warn
                    code: "A003"
                    msg: "`\{txt}` names a unit or a type of the program; compare its declaration or type id, not its spelling"
                    line: p.line
                    col: p.col
                    width: 1
                )
            }
        } case none then null
    }

    # isBuiltinCarrierTid -- String, StringView or a container. `isReftypeOf`
    # says true for all of them, and `isNativeOf` splits them rather than naming
    # them: String and StringView are declared `class is native`, the containers
    # are plain classes. Compare against the builtin ids the way
    # isContainerReaderCall does.
    isBuiltinCarrierTid: function {
        this: this.view
        ast: Ast.view
        st: zenv.ZSymbolTable
        tid: ztypes.tid
    } out bool is {
        b: tid
        g: st.reg.genericOriginOf :tid
        if g.isZero.not then b = g
        if (
            b ==
            (ztypecheck.builtinTidTRo
                scope: ztypes.declid
                :ast
                :st
                base: "String"
            )
        ) then return true
        if (
            b ==
            (ztypecheck.builtinTidTRo
                scope: ztypes.declid
                :ast
                :st
                base: "StringView"
            )
        ) then return true
        if (
            b ==
            (ztypecheck.builtinTidTRo
                scope: ztypes.declid
                :ast
                :st
                base: "ListRef"
            )
        ) then return true
        if (
            b ==
            (ztypecheck.builtinTidTRo
                scope: ztypes.declid
                :ast
                :st
                base: "ListView"
            )
        ) then return true
        if (
            b ==
            (ztypecheck.builtinTidTRo
                scope: ztypes.declid
                :ast
                :st
                base: "MapRR"
            )
        ) then return true
        if (
            b ==
            (ztypecheck.builtinTidTRo
                scope: ztypes.declid
                :ast
                :st
                base: "MapRV"
            )
        ) then return true
        if (
            b ==
            (ztypecheck.builtinTidTRo
                scope: ztypes.declid
                :ast
                :st
                base: "MapVR"
            )
        ) then return true
        if (
            b ==
            (ztypecheck.builtinTidTRo
                scope: ztypes.declid
                :ast
                :st
                base: "MapVV"
            )
        ) then return true
        if (
            b ==
            (ztypecheck.builtinTidTRo
                scope: ztypes.declid
                :ast
                :st
                base: "SetRef"
            )
        ) then return true
        return b == (ztypecheck.builtinTidTRo scope: ztypes.declid :ast :st base: "Bytes")
    }

    # reportUnmutatedParam -- L020. A USER reftype parameter that is mutable by
    # default and never mutated should declare `.view`: the marker is what lets
    # a caller keep reading its argument across the call, and without it a
    # forgotten `.view` surfaces as a lock conflict at a DISTANT call site.
    #
    # "Mutated" is not re-derived. The typechecker records `variableMutated` at
    # the two places that already enforce the question -- `lockCallArg` whenever
    # it takes a non-shared lock (every mutating receiver and every mutable
    # argument) and `checkWriteLock` (assignment and swap targets) -- so this
    # agrees with the lock rules by construction.
    reportUnmutatedParam: function {
        :this
        ast: Ast.view
        st: zenv.ZSymbolTable
        fnOp: zast.nodeid
        vid: ztypes.vid
        nameRef: zast.nameid
        line: u32
        col: u32
    } is {
        if (st.reg.hasVariable id: vid).not then return
        vt: st.reg.variableTypeOf id: vid
        if vt.isZero then return
        if (st.reg.isReftypeOf tid: vt).not then return
        if (this.isBuiltinCarrierTid :ast :st tid: vt) then return
        ftid: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: fnOp
        if ftid.isZero then return
        own: (st.typing.declOwnershipOfId
            parentTypeId: ftid
            nameId: nameRef
        )
        mutable: true
        match (
            own
        ) case some then {
            if own != ztypes.zparamownership.borrowMode then mutable = false
        } case none then null
        if mutable.not then return
        pnm: zast.poolTextAt pool: ast.names ref: nameRef
        (this.info
            code: "L020"
            msg: "parameter '\{pnm}' is never mutated -- declare it `.view` so callers may keep reading the argument across the call"
            :line
            :col
            width: pnm.length.u32.orPanic
        )
    }

    # reportValtypeBorrowParam -- L030. An unmarked valtype parameter is a copy;
    # `.borrow` passes it by reference, so the callee can write the caller's
    # value (ownership.pdoc, Defaults). One the body never mutates pays for a
    # reference it does not use. Called only for a used, never-mutated
    # parameter: the evidence L020 reads, which records a pass to another
    # `.borrow` parameter too (markValtypeBorrowArg). A generic parameter is
    # not asked: its `.borrow` follows the type it is instantiated with.
    reportValtypeBorrowParam: function {
        :this
        ast: Ast.view
        st: zenv.ZSymbolTable.view
        fnOp: zast.nodeid
        vid: ztypes.vid
        nameRef: zast.nameid
        line: u32
        col: u32
    } is {
        if (st.reg.hasVariable id: vid).not then return
        vt: st.reg.variableTypeOf id: vid
        if vt.isZero then return
        if (st.reg.typetypeOf typeId: vt) == ztypes.ztypetype.genericParam then return
        if (st.reg.isValtypeOf tid: vt).not then return
        ftid: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: fnOp
        if ftid.isZero then return
        own: (st.typing.declOwnershipOfId
            parentTypeId: ftid
            nameId: nameRef
        )
        ownM: own.or d: ztypes.zparamownership.noneMode
        if ownM != ztypes.zparamownership.borrowMode then return
        pnm: zast.poolTextAt pool: ast.names ref: nameRef
        (this.warn
            code: "L030"
            msg: "parameter '\{pnm}' is a value type the body never mutates -- drop `.borrow` to take a copy, or write `.view`"
            :line
            :col
            width: pnm.length.u32.orPanic
        )
    }

    # reportUnmutatedReceiver -- L027. A receiver written `:this` is mutable by
    # default; one the body never mutates should declare `this: this.view`, for
    # the reason L020 gives a parameter. The receiver's variable and the
    # `variableMutated` stamp are the same evidence L020 reads, so a call through
    # `this` to a mutating method counts, in both families: a valtype receiver
    # is passed by reference and locks exactly as a class receiver does. The
    # spelled forms (`this: this.view`, `b: this.borrow`) are not asked, and
    # neither is a method implementing a spec member: its receiver is the
    # spec's.
    reportUnmutatedReceiver: function {
        :this
        ast: Ast.view
        st: zenv.ZSymbolTable.view
        fnOp: zast.nodeid
        opId: zast.nodeid
        line: u32
        col: u32
    } is {
        op: ast.nodes.get i: opId
        if op.labelvalue.not then return
        ftid: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: fnOp
        if ftid.isZero.not when (ztypecheck.methodImplementsSpec
            :st
            mid: ftid
        ) then return
        vo: st.typing.defVariableId.get key: opId
        match (
            vo
        ) case some then {
            if (st.typing.variableMutated.has item: vo) then return
            if (st.reg.hasVariable id: vo).not then return
            vt: (st.reg.variableTypeOf id: vo).u64
            if vt == 0 then return
            (this.warn
                code: "L027"
                msg: "receiver `this` is never mutated -- declare it `this: this.view` so callers may keep reading the object across the call"
                :line
                :col
                width: 4
            )
        } case none then null
    }

    # warnUnusedParam -- L014: a parameter no read reaches.
    warnUnusedParam: function {:this prog: Ast.view site: zast.namedsite} is {
        pnm: zast.poolTextAt pool: prog.names ref: site.name
        (this.warn
            code: "L014"
            msg: "parameter '\{pnm}' is never used (drop it with `\{pnm}.drop` if intentional)"
            line: site.line
            col: site.col
            width: pnm.length.u32.orPanic
        )
    }

    # reportParamAt -- one parameter. The receiver is exempt from the use test
    # and takes L027 instead, since what is judged of it is mutation rather than
    # use; every other parameter takes L020 when it is read but never written
    # and L014 when no read reaches it at all.
    reportParamAt: function {
        :this
        prog: Ast.view
        st: zenv.ZSymbolTable
        used: (IdSet ztypes.vid).view
        fop: zast.nodeid
        site: zast.namedsite
    } is {
        if site.operation.isZero then return
        pOpId: site.operation
        # the receiver is exempt: `:this` names it directly (zast.names.wkThis);
        # a spelled `b: this.borrow` is receiver-shaped
        isRecv: site.name == zast.names.wkThis
        if isRecv.not then isRecv = (ztypecheck.paramIsThisReceiverId
            ast: prog
            opId: pOpId
        )
        if isRecv then {
            (this.reportUnmutatedReceiver
                ast: prog
                :st
                fnOp: fop
                opId: pOpId
                line: site.line
                col: site.col
            )
            return
        }
        vo: st.typing.defVariableId.get key: pOpId
        match (
            vo
        ) case some then {
            umut: st.typing.variableMutated.has item: vo
            if (used.has item: vo) when umut.not then {
                (this.reportValtypeBorrowParam
                    ast: prog
                    :st
                    fnOp: fop
                    vid: vo
                    nameRef: site.name
                    line: site.line
                    col: site.col
                )
                (this.reportUnmutatedParam
                    ast: prog
                    :st
                    fnOp: fop
                    vid: vo
                    nameRef: site.name
                    line: site.line
                    col: site.col
                )
            }
            if (used.has item: vo).not then this.warnUnusedParam :prog :site
        } case none then null
    }

    # reportParamsOf -- every parameter of one function definition.
    reportParamsOf: function {
        :this
        prog: Ast.view
        st: zenv.ZSymbolTable
        used: (IdSet ztypes.vid).view
        fop: zast.nodeid
    } is {
        paramIds: fnParamIds :prog :fop
        for each pid: paramIds loop {
            (this.reportParamAt
                :prog
                :st
                :used
                :fop
                site: (zast.namedSiteAt ast: prog nid: pid)
            )
        }
    }

    # reportUnusedLocalAt -- L013: a local binding no read reaches. Only a
    # binding in the unit's OWN file is judged, which is what mainFsno says,
    # and only the template's: a generic instance's copy of the body reports
    # from its template's file and line, so it would repeat the template's.
    # This takes no symbol table on purpose: it runs with defVariableId pinned
    # by its own walk, and lending the table under that pin is the shape
    # usedDeclSet was rewritten to avoid.
    reportUnusedLocalAt: function {
        :this
        prog: Ast.view
        used: (IdSet ztypes.vid).view
        mainFsno: zvfs.fsno
        # the node ranges of every instance's copy of a body, start and end in turn
        copies: (ListVal ztyping.bodycopy).view
        # the bindings a `for` writes, which are locals as an assignment's are:
        # each keyed by the expression it binds, which is what defines it
        loopBinds: (IdMapV zast.nodeid v: zast.nodeid).view
        nid: zast.nodeid
        vid: ztypes.vid
    } is {
        if (used.has item: vid) then return
        # a loop binding is defined by the expression it binds, or by the
        # `.iterate` the checker writes over that expression for `for each`
        srcId: loopBoundExpr :prog :loopBinds :nid
        bindId: (loopBinds.get key: srcId).or d: zast.nodeid
        if bindId.isZero then srcId = nid
        if (prog.fsnoForNode nodeid: srcId) != mainFsno then return
        if (ztyping.nodeInCopies :copies nid: srcId) then return
        nm: String
        ln: u32
        cl: u32
        okL: false
        {
            nodeL: prog.nodes.get i: nid
            match (
                nodeL
            ) case assignment then {
                nm = zast.poolTextCopy pool: prog.names ref: nodeL.name
                ln = nodeL.lineno
                cl = nodeL.colno
                okL = true
            } else null
        }
        if bindId.isZero.not then {
            nodeB: prog.nodes.get i: bindId
            match (
                nodeB
            ) case namedoperation then {
                nm = zast.poolTextCopy pool: prog.names ref: nodeB.name
                ln = nodeB.lineno
                cl = nodeB.colno
                okL = true
            } else null
        }
        if okL.not then return
        (this.warn
            code: "L013"
            msg: "local '\{nm}' is never used (drop it with `\{nm}.drop` if intentional)"
            line: ln
            col: cl
            width: nm.length.u32.orPanic
        )
    }

    # reportUnusedVars -- L014 (unused parameter) + L013 (unused local). A binding whose
    # variableId never appears as a use (atomVariableId) is dead. Params are walked from the
    # main unit's function defs (precise name/position; the receiver is exempt). Locals are the
    # assignment bindings in this file and the bindings a `for` writes. The opt-out is to end the
    # variable with `x.drop` on its own line (a name that owns nothing lowers to `(void)(x);`),
    # which stamps a use.
    reportUnusedVars: function {:this prog: Ast.view lu: LintedUnit.view st: zenv.ZSymbolTable} is {
        used: usedVarSet :st wtgt: (writeTargetAtoms :prog)
        mainOp: lu.op
        fnOps: collectFnOps :prog :mainOp
        for each fop: fnOps loop {
            this.reportParamsOf :prog :st :used :fop
        }
        if fnOps.length == 0 then return
        mainFsno: prog.fsnoForNode nodeid: (fnOps.get i: 0)
        loopBinds: loopBindingIds :prog
        for each dv: st.typing.defVariableId.iterateItems loop {
            (this.reportUnusedLocalAt
                :prog
                :used
                :mainFsno
                copies: st.typing.instanceCopies
                :loopBinds
                nid: dv.key
                vid: dv.value
            )
        }
    }

    # srcIsFieldRead -- the conversion's source is a FIELD read (`ctx.mainName`)
    # rather than a local, a call, or a method chain. A field holds its bytes only
    # until something rebinds it, and any call in the local's live range may do
    # exactly that -- the save/restore idiom around a rebinding setter frees the
    # old String, so an alias of the field would dangle. The owned copy is
    # load-bearing there, and L022 leaves it alone.
    srcIsFieldRead: function {
        this: this.view
        ast: Ast.view
        st: zenv.ZSymbolTable
        n: astnode.view
    } out bool is {
        match (
            n
        ) case dottedpath then {
            fcn: atomName :ast n: (ast.nodes.get i: n.child)
            if fcn.length == 0 then return false
            fpn: ast.nodes.get i: n.parent
            fpi: nodeInfoOf n: fpn
            fpt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: fpi.id
            if fpt.isZero then return false
            fnid: zast.poolFind pool: ast.names text: fcn.stringView
            if fnid.isZero then return false
            fmo: (st.typing.declChildOfId
                parentTypeId: fpt
                nameId: fnid
            )
            match (
                fmo
            ) case some then {
                if (
                    (st.reg.typetypeOf
                        typeId: fmo
                    ) ==
                    ztypes.ztypetype.functionType
                ) then return false
                return true
            } case none then null
            return false
        } else {
            return false
        }
    }

    # owningConvKind -- the RHS is an OWNING String conversion: `.string` on a
    # StringView base, `.copy` on a String base, or a nameTextCopy/poolTextCopy
    # call. Returns the spelling for the message, "" otherwise.
    owningConvKind: function {
        this: this.view
        ast: Ast.view
        st: zenv.ZSymbolTable
        rhsId: zast.nodeid
    } out String is {
        if rhsId.isZero then return ""
        rn: ast.nodes.get i: rhsId
        match (
            rn
        ) case dottedpath then {
            chn: ast.nodes.get i: rn.child
            cn: atomName :ast n: chn
            if cn.length == 0 then return ""
            pnn: ast.nodes.get i: rn.parent
            if (this.srcIsFieldRead :ast :st n: pnn) then return ""
            pin: nodeInfoOf n: pnn
            bt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: pin.id
            if bt.isZero then return ""
            if cn.stringView == "string" when (
                bt == (ztypecheck.builtinTidTRo scope: ztypes.declid :ast :st base: "StringView")
            ) then return "`.string`"
            if cn.stringView == "copy" when (
                bt == (ztypecheck.builtinTidTRo scope: ztypes.declid :ast :st base: "String")
            ) then return "`.copy`"
            return ""
        } case call then {
            cbl: ast.nodes.get i: rn.callable
            match (
                cbl
            ) case dottedpath then {
                ccn: atomName :ast n: (ast.nodes.get i: cbl.child)
                if ccn.stringView == "nameTextCopy" then return "`nameTextCopy`"
                if ccn.stringView == "poolTextCopy" then return "`poolTextCopy`"
                return ""
            } else {
                return ""
            }
        } else {
            return ""
        }
    }

    # convSourceRootVid -- the variable id at the ROOT of an owning conversion's
    # source path (`ctx.mainName.copy` -> `ctx`), or the zero vid when the source
    # is not rooted at a name.
    convSourceRootVid: function {
        :this
        ast: Ast.view
        st: zenv.ZSymbolTable.view
        rhsId: zast.nodeid
    } out ztypes.vid is {
        zv: ztypes.vid
        if rhsId.isZero then return zv
        rn: ast.nodes.get i: rhsId
        match (
            rn
        ) case dottedpath then {
            return (this.convSourceRootVid :ast :st rhsId: rn.parent)
        } case call then {
            return (this.convSourceRootVid :ast :st rhsId: rn.callable)
        } case atomid then {
            avo: st.typing.atomVariableId.get key: rn.nodeid
            match (
                avo
            ) case some then {
                zv = avo
            } case none then null
            return zv
        } else {
            return zv
        }
    }

    # viewableLocalKind -- the owning conversion kind a String local was bound
    # from when a borrowed view would serve every use of it; empty when the
    # local is not such a case. Mutation evidence is `variableMutated` (the
    # lock rules) and `variableMoved` (the invalidate choke point) -- a local
    # moved into an owner needs its allocation. A view is only equivalent while
    # the SOURCE holds the same bytes: a root that is written -- directly, or
    # by a callee taking it as a mutable borrow -- rebinds or frees them, so
    # the copy is load-bearing (the save/restore idiom around a rebinding
    # setter, and a loop whose tail reassigns the source).
    viewableLocalKind: function {
        :this
        prog: Ast.view
        st: zenv.ZSymbolTable
        # every variable some atom reads
        used: (IdSet ztypes.vid).view
        # the binding node and its variable
        nid: zast.nodeid
        vid: ztypes.vid
        # the file the unit's body lives in
        mainFsno: zvfs.fsno
    } out String is {
        if (used.has item: vid).not then return String
        if (st.typing.variableMutated.has item: vid) then return String
        if (st.typing.variableMoved.has item: vid) then return String
        fs: prog.fsnoForNode nodeid: nid
        if (fs == mainFsno).not then return String
        nodeL: prog.nodes.get i: nid
        if nodeL.assignment.not then return String
        kind: this.owningConvKind ast: prog :st rhsId: nodeL.value
        rvid: this.convSourceRootVid ast: prog :st rhsId: nodeL.value
        if rvid.isZero.not when (st.typing.variableMutated.has item: rvid) then return String
        return kind
    }

    # reportViewableLocals -- L022. A String local bound from an OWNING
    # conversion that is never mutated: every use only reads it, so a borrowed
    # view serves and the allocation is avoidable (`.stringView` at the uses,
    # `asString` at a container probe).
    reportViewableLocals: function {
        :this prog: Ast.view lu: LintedUnit.view st: zenv.ZSymbolTable
    } is {
        mainOp: lu.op
        mainFsno: unitAnchorFsno :prog :mainOp
        zeroFs: zvfs.fsno
        if mainFsno == zeroFs then return
        used: IdSet ztypes.vid
        for each av: st.typing.atomVariableId.iterateItems loop (used.add
            item: av.value
        )
        # the (node, variable) pairs are collected first, side by side: the
        # conversion probes below lend st
        dvNodes: ListVal zast.nodeid
        dvVars: ListVal ztypes.vid
        # a generic instance's copy of a body reports from its template's line,
        # so only the template's own bindings are judged
        for each dv: st.typing.defVariableId.iterateItems loop {
            if (st.typing.nodeInInstanceBody nid: dv.key).not then {
                dvNodes.append from: dv.key
                dvVars.append from: dv.value
            }
        }
        dpi: u64
        for dpi < dvNodes.length loop {
            nid: dvNodes.get i: dpi
            vid: dvVars.get i: dpi
            dpi = dpi + 1
            kind: (this.viewableLocalKind
                :prog
                :st
                :used
                :nid
                :vid
                :mainFsno
            )
            nodeL: prog.nodes.get i: nid
            if kind.length > 0 when nodeL.assignment then {
                nm: zast.poolTextAt pool: prog.names ref: nodeL.name
                (this.info
                    code: "L022"
                    msg: "local '\{nm}' is an owned copy (\{kind}) that is never mutated -- a borrowed view serves every use (`.stringView`, or `asString` at a probe)"
                    line: nodeL.lineno
                    col: nodeL.colno
                    width: nm.length.u32.orPanic
                )
            }
        }
    }

    # reportUnusedDefs -- L012 (unused private definition). A private unit-level definition
    # (function, type, or alias excluded from a `public:` block) that is never referenced is
    # dead. Usage is declaration-based: a reference name resolved against the unit maps to the
    # member DeclId that carries the private flag. An alias declares no typed member of its
    # own and is not judged. The evidence is gathered once -- the recorded references and,
    # as a fallback, every atom name in the unit's own file segment -- then the unit's
    # members and each type's members are judged against it.
    reportUnusedDefs: function {
        :this prog: Ast.view lu: LintedUnit.view st: zenv.ZSymbolTable.view
    } is {
        mainTid: unitTidOf :prog names: lu.names :st
        if mainTid.isZero then return
        mainOp: lu.op
        memIds: unitMemberIds :prog unitOp: mainOp
        probe: zast.nodeid
        if memIds.length > 0 then probe = memIds.get i: 0
        # the unit's file is its first body member's: the unit's wrapper rows
        # are minted after its body is read, and report from no file
        file: prog.fsnoForNode nodeid: probe
        um: unitMembersOf :prog :st :mainTid :memIds :file
        usedE: usedDeclSet :prog :st :mainTid :file :um
        refNames: unitAtomNames :prog :file :um
        ev: UnusedEvidence :mainTid :usedE :refNames :memIds
        this.reportUnusedUnitDefs :prog :st :ev
        this.reportUnusedTypeMembers :prog :st :ev
    }

    # reportUnusedUnitDefs -- L012 over the unit's own members
    reportUnusedUnitDefs: function {
        :this prog: Ast.view st: zenv.ZSymbolTable.view ev: UnusedEvidence.view
    } is {
        mI: u64
        for mI < ev.memIds.length loop {
            mid: ev.memIds.get i: mI
            mI = mI + 1
            this.reportIfUnusedDef :prog :st :ev :mid
        }
    }

    # reportIfUnusedDef -- L012 for one unit-level member: private, reached by
    # no recorded reference, and named by no atom in the unit's own segment
    reportIfUnusedDef: function {
        :this prog: Ast.view st: zenv.ZSymbolTable.view ev: UnusedEvidence.view mid: zast.nodeid
    } is {
        m: zast.namedSiteAt ast: prog nid: mid
        if m.name.isZero then return
        dmD: (st.typing.declTypedMemberIdOf
            parentTypeId: ev.mainTid
            nameId: m.name
        )
        if dmD.isZero then return
        if (ev.usedE.has item: dmD) then return
        if (ev.refNames.has item: m.name.u64) then return
        if (ztypecheck.declMemberIsPrivate
            :st
            tid: ev.mainTid
            nameId: m.name
        ) then {
            dnm: zast.poolTextAt pool: prog.names ref: m.name
            (this.warn
                code: "L012"
                msg: "private definition '\{dnm}' is never used"
                line: m.line
                col: m.col
                width: dnm.length.u32.orPanic
            )
        }
    }

    # reportUnusedTypeMembers -- L012 over the `is`/`as` members of each type
    # the unit defines
    reportUnusedTypeMembers: function {
        :this prog: Ast.view st: zenv.ZSymbolTable.view ev: UnusedEvidence.view
    } is {
        tmI: u64
        for tmI < ev.memIds.length loop {
            tmid: ev.memIds.get i: tmI
            tmI = tmI + 1
            (this.reportUnusedMembersOf
                :prog
                :st
                :ev
                site: (zast.namedSiteAt ast: prog nid: tmid)
            )
        }
    }

    # reportUnusedMembersOf -- L012 for each private member of the type a unit
    # member defines, a private edge no recorded reference reaches; nothing
    # when the member defines no type
    reportUnusedMembersOf: function {
        :this prog: Ast.view st: zenv.ZSymbolTable.view ev: UnusedEvidence.view site: zast.namedsite
    } is {
        typeTid: definedTypeTidOf :prog :st mainTid: ev.mainTid :site
        if typeTid.isZero then return
        tnm: zast.poolTextAt pool: prog.names ref: site.name
        items: zast.objItemIds ast: prog nid: site.operation
        j: u64
        for j < items.length loop {
            member: zast.namedSiteAt ast: prog nid: (items.get i: j)
            j = j + 1
            if member.name.isZero.not then {
                tmdi: (st.typing.declTypedMemberIdOf
                    parentTypeId: typeTid
                    nameId: member.name
                )
                if tmdi.isZero.not when (ev.usedE.has item: tmdi
                ).not when (ztypecheck.declMemberIsPrivate
                    :st
                    tid: typeTid
                    nameId: member.name
                ) then {
                    tmnm: zast.poolTextAt pool: prog.names ref: member.name
                    (this.warn
                        code: "L012"
                        msg: "private member '\{tnm}.\{tmnm}' is never used"
                        line: member.line
                        col: member.col
                        width: tmnm.length.u32.orPanic
                    )
                }
            }
        }
    }
}

# ---- doc-coverage helpers ----

# addPublicName -- the name one `public:` entry exports: an entry spelled as a
# bare atom exports that atom's name, any other shape its own
addPublicName: function {ast: Ast.view site: zast.namedsite into: IdSet zast.nameid} is {
    eo: ast.nodes.get i: site.operation
    match (
        eo
    ) case atomid then {
        into.add item: eo.name
    } else {
        into.add item: site.name
    }
}

# addPublicNames -- every name one `public:` block spells, added to `into`
addPublicNames: function {ast: Ast.view opId: zast.nodeid into: IdSet zast.nameid} is {
    ids: ListVal zast.nodeid
    pu: ast.nodes.get i: opId
    if pu.unitdef then ids = zast.kidIds :ast span: pu.body
    for each eId: ids loop {
        esite: zast.namedSiteAt :ast nid: eId
        if esite.name.isZero.not then addPublicName :ast site: esite :into
    }
}

# unitPublicNames -- the names a unit's `public:` blocks export, into `into`;
# the result says whether the unit has such a block at all, which is what
# decides whether there is a surface to filter by
unitPublicNames: function {ast: Ast.view body: zast.kidspan into: IdSet zast.nameid} out bool is {
    hasPub: false
    ids: zast.kidIds :ast span: body
    for each pId: ids loop {
        psite: zast.namedSiteAt :ast nid: pId
        if psite.name.isZero.not when (zast.unitOpKindIs
            :ast
            opId: psite.operation
            k: zast.unitkind.publicNs
        ) then {
            hasPub = true
            addPublicNames :ast opId: psite.operation :into
        }
    }
    return hasPub
}

# unitMemberIsWalkable -- does the doc pass descend into this unit member? A
# `public:` or `require:` block is structure rather than a
# definition, and when the unit HAS a public surface only what it exports --
# plus `main`, which no unit exports and every program needs -- is judged
unitMemberIsWalkable: function {
    ast: Ast.view
    site: zast.namedsite
    pubSet: (IdSet zast.nameid).view
    hasPub: bool
} out bool is {
    if site.name.isZero then return true
    if (zast.unitOpKindIs :ast opId: site.operation k: zast.unitkind.publicNs) then return false
    if (zast.unitOpKindIs :ast opId: site.operation k: zast.unitkind.requirement) then return false
    if hasPub.not then return true
    if (pubSet.has item: site.name) then return true
    return (zast.nameTextEq :ast ref: site.name s: "main")
}

# ---- L013 / L014 unused-variable helpers ----

# writeTargetAtoms -- every BARE atom node that is a reassignment target. A
# reassignment's target atom carries an atomVariableId stamp exactly as a read
# does, so counting every stamp as a use makes a local that is only ever
# assigned look used; these are the ones to leave out. Only a BARE atom:
# reaching `a.b` to write it genuinely reads `a`, so a dotted target excludes
# nothing.
writeTargetAtoms: function {prog: Ast.view} out IdSet zast.nodeid is {
    wtgt: IdSet zast.nodeid
    ni: zast.nodeid
    nn: prog.nodes.length
    for ni.u64 < nn loop {
        tp: zast.nodeid
        wn: prog.nodes.get i: ni
        match wn case reassignment then tp = wn.topath else null
        if tp.isZero.not then {
            tn: prog.nodes.get i: tp
            match tn case atomid then wtgt.add item: tp else null
        }
        ni = ni.next
    }
    return wtgt
}

# usedVarSet -- every variable a READ reaches: the atom stamps, less the ones
# sitting on a reassignment target
usedVarSet: function {
    st: zenv.ZSymbolTable.view wtgt: (IdSet zast.nodeid).view
} out IdSet ztypes.vid is {
    used: IdSet ztypes.vid
    for each av: st.typing.atomVariableId.iterateItems loop {
        if (wtgt.has item: av.key).not then used.add item: av.value
    }
    return used
}

# loopBindingIds -- the binding each `for` writes (`for each x: xs`, `for x: f`):
# a labelled condition, where an unlabelled one is a `while` test
loopBindingIds: function {prog: Ast.view} out (IdMapV zast.nodeid v: zast.nodeid) is {
    ids: IdMapV zast.nodeid v: zast.nodeid
    i: zast.nodeid
    for i.u64 < prog.nodes.length loop {
        n: prog.nodes.get :i
        match (
            n
        ) case forexpr then {
            k: u64
            for k < n.conditions.count loop {
                cid: zast.kidAt kids: prog.kids span: n.conditions i: k
                c: prog.nodes.get i: cid
                match (
                    c
                ) case namedoperation then {
                    if c.name.isZero.not then ids.set key: c.operation value: cid
                } else null
                k = k + 1
            }
        } else null
        i = i.next
    }
    return ids
}

# loopBoundExpr -- the expression a `for` binds when the definition `nid` is
# a loop binding's: `nid` itself, or the parent of the implied `.iterate`
# dotted path the checker writes over it for `for each`. `nid` when it is
# neither, which the caller tells apart by asking loopBinds.
loopBoundExpr: function {
    prog: Ast.view loopBinds: (IdMapV zast.nodeid v: zast.nodeid).view nid: zast.nodeid
} out zast.nodeid is {
    if (loopBinds.has key: nid) then return nid
    n: prog.nodes.get i: nid
    match (
        n
    ) case dottedpath then {
        if (loopBinds.has key: n.parent) then return n.parent
    } else null
    return nid
}

# appendUserFnOp -- append `opId` when it defines a function written in a real
# file. Synth-lowered defs sit outside every file segment (fsno 0): they are not
# user source, so their parameters are exempt
appendUserFnOp: function {prog: Ast.view opId: zast.nodeid fnOps: ListVal zast.nodeid} is {
    isFn: false
    n: prog.nodes.get i: opId
    if n.functiondef then isFn = true
    if isFn.not then return
    if (prog.fsnoForNode nodeid: opId).isZero.not then fnOps.append from: opId
}

# appendFnOpsOf -- the function definitions one unit member contributes: itself
# when it defines a function, and the methods of its `as` block when it defines
# a type
appendFnOpsOf: function {prog: Ast.view opId: zast.nodeid fnOps: ListVal zast.nodeid} is {
    appendUserFnOp :prog :opId :fnOps
    # only the `as` half of a type carries methods; its `is` half declares
    # fields and arms, which have no parameters to judge
    asIds: ListVal zast.nodeid
    op: prog.nodes.get i: opId
    match op case objectdef then asIds = zast.kidIds ast: prog span: op.asItems else null
    for each amid: asIds loop {
        asite: zast.namedSiteAt ast: prog nid: amid
        if asite.operation.isZero.not then (appendUserFnOp
            :prog
            opId: asite.operation
            :fnOps
        )
    }
}

# hiddenSubunitAt -- the node defines a hidden subunit. Its definitions hang in
# the parent unit's tree once loaded, but it is a file of its own, linted when
# that file is; a walk of the parent that descended into it reported the
# subunit's findings at the parent's path, on the parent's lines.
hiddenSubunitAt: function {ast: Ast.view n: astnode.view} out bool is {
    if n.namedoperation.not then return false
    return (zast.unitOpKindIs :ast opId: n.operation k: zast.unitkind.subunit)
}

# collectFnOps -- every function definition the unit declares, in declaration
# order: its own members first, then the methods of each type it declares. The
# ORDER is load-bearing -- L013 anchors its file segment on the first entry
collectFnOps: function {prog: Ast.view mainOp: zast.nodeid} out ListVal zast.nodeid is {
    fnOps: ListVal zast.nodeid
    memIds: unitMemberIds :prog unitOp: mainOp
    for each mid: memIds loop {
        msite: zast.namedSiteAt ast: prog nid: mid
        if msite.operation.isZero.not then (appendFnOpsOf
            :prog
            opId: msite.operation
            :fnOps
        )
    }
    return fnOps
}

# fnParamIds -- a function definition's parameter nodes, in order
fnParamIds: function {prog: Ast.view fop: zast.nodeid} out ListVal zast.nodeid is {
    ids: ListVal zast.nodeid
    fd: prog.nodes.get i: fop
    match (
        fd
    ) case functiondef then {
        ids = zast.kidIds ast: prog span: fd.parameters
    } else null
    return ids
}

# ---- L012 unused-definition helpers ----

# UnusedEvidence -- what L012 judges a unit's members against: the unit's type
# id, the declarations its recorded references reach, the atom names of its
# own file segment, and its member nodes
UnusedEvidence: class {
    # the type id of the unit being linted
    mainTid: ztypes.tid
    # every declaration a recorded reference reaches from OUTSIDE itself
    usedE: IdSet ztypes.declid
    # every atom name in the unit's own file segment that is not a definition
    # naming itself, the syntactic fallback
    refNames: IdSet u64
    # the unit body's member nodes, in order
    memIds: ListVal zast.nodeid
}

# UnitMembers -- the unit's members as three parallel columns in declaration
# order: start line, name id, and the declaration id L012 judges. A reference
# belongs to the LAST member whose start line is at or before it, which is what
# lets both evidence passes tell a USE from a definition naming itself. Name
# and declaration id are 0 for a member that has neither, so nothing matches.
UnitMembers: class {
    # each member's start line, ascending
    lines: ListVal u32
    # each member's name id, 0 when it has none
    names: ListVal u64
    # each member's typed declaration id, 0 when it has none
    declIds: ListVal ztypes.declid
}

# unitMembersOf -- the three columns, one row per unit body member written in
# the unit's own file `file`. Every question asked of them is a line in that
# file, so a member another file holds -- a hidden subunit -- has no row: its
# line belongs to no extent here, and the search over the lines takes them as
# ascending.
unitMembersOf: function {
    prog: Ast.view
    st: zenv.ZSymbolTable.view
    mainTid: ztypes.tid
    memIds: (ListVal zast.nodeid).view
    file: zvfs.fsno
} out UnitMembers is {
    um: UnitMembers lines: ListVal u32 names: ListVal u64 declIds: ListVal ztypes.declid
    mI: u64
    for mI < memIds.length loop {
        mid: memIds.get i: mI
        mI = mI + 1
        if (prog.fsnoForNode nodeid: mid) != file then continue
        m: zast.namedSiteAt ast: prog nid: mid
        nm9: u64
        dc9: ztypes.declid
        if m.name.isZero.not then {
            nm9 = m.name.u64
            dc9 = st.typing.declTypedMemberIdOf parentTypeId: mainTid nameId: m.name
        }
        um.lines.append from: m.line
        um.names.append from: nm9
        um.declIds.append from: dc9
    }
    return um
}

# memberIndexAtLine -- the index of the last member starting at or before
# `line`; the column length when the line precedes every member.
memberIndexAtLine: function {um: UnitMembers.view line: u32} out u64 is {
    n: um.lines.length
    lo: u64
    hi: n
    for lo < hi loop {
        mid: lo + (hi - lo / 2)
        v: um.lines.get i: mid
        if v <= line then {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo == 0 then return n
    return lo - 1
}

# selfReferenceAt -- the reference at `siteNid` names the very member it sits
# inside. The site must be in this unit's own file: a use from another file
# shares no line numbering with these extents, and dropping one would report a
# member that IS used.
selfReferenceAt: function {
    prog: Ast.view file: zvfs.fsno um: UnitMembers.view siteNid: zast.nodeid declId: ztypes.declid
} out bool is {
    if declId.isZero then return false
    if file.isZero then return false
    if ((prog.fsnoForNode nodeid: siteNid) == file).not then return false
    ln: u32
    {
        ln = (zast.posOf n: (prog.nodes.get i: siteNid)).line
    }
    k: memberIndexAtLine :um line: ln
    if k >= um.declIds.length then return false
    return (um.declIds.get i: k) == declId
}

# unitTidOf -- the type id of the unit `names` spells from the top level down (a
# subunit is declared inside its parent), 0 when the program declares no such
# unit
unitTidOf: function {
    prog: Ast.view names: (List String).view st: zenv.ZSymbolTable.view
} out ztypes.tid is {
    decl: st.typing.programRoot
    for each nm: names loop {
        decl = (st.typing.declFindChild
            parentDeclId: decl
            nameId: (zast.poolFind pool: prog.names text: nm.stringView)
        )
    }
    uo: ztypecheck.declTypeIdOf :st declId: decl
    if uo.isZero then return ztypes.tid.zero
    return uo
}

# LintedUnit -- the unit a linted FILE is: its unitdef node (0 when the parse
# loaded no unit from that file), its name, and the unit names from the top
# level down to it.
LintedUnit: class {
    # the unit's unitdef node
    op: zast.nodeid
    # its own name, the last of `names`
    name: String
    # the names from the top-level unit down, which spell its declaration
    names: List String
}

# lintedUnitOf -- the unit whose body lives in the file `self`: the program's
# top-level units and, inside each, its subunits, searched by the FILE each
# body came from and never by name.
lintedUnitOf: function {prog: Ast.view self: zvfs.fsno} out LintedUnit is {
    lu: LintedUnit op: zast.nodeid name: String names: List String
    if self.isZero then return lu
    trail: List String
    for each uId: prog.units loop {
        if lu.op.isZero then (findUnitIn
            :prog
            :self
            namedOpId: uId
            :trail
            into: lu
        )
    }
    return lu
}

# lintedUnitNamed -- the top-level unit named `uname` as a LintedUnit, the
# last of several winning: for zls, whose compile pass roots the program at
# the open document's unit by that name.
lintedUnitNamed: function {prog: Ast.view uname: StringView} out LintedUnit is {
    lu: LintedUnit op: zast.nodeid name: uname.string names: List String
    for each uId: prog.units loop {
        un: prog.nodes.get i: uId
        if un.namedoperation then {
            unm: zast.poolTextAt pool: prog.names ref: un.name
            if unm.stringView == uname then lu.op = un.operation
        }
    }
    lu.names.append uname.string
    return lu
}

# findUnitIn -- lintedUnitOf's search below one named node: the unit itself when
# its body is the file, else each of its subunits. `trail` holds the names above.
findUnitIn: function {
    prog: Ast.view
    self: zvfs.fsno
    namedOpId: zast.nodeid
    trail: List String
    into: LintedUnit
} is {
    n: prog.nodes.get i: namedOpId
    if n.namedoperation.not then return
    op: n.operation
    if (prog.nodes.get i: op).unitdef.not then return
    trail.append (zast.nameTextCopy ast: prog ref: n.name)
    if (unitAnchorFsno :prog mainOp: op) == self then {
        into.op = op
        for each t: trail loop into.names.append t.copy
        into.name = (trail.get i: trail.length - 1).copy
    } else {
        for each mid: (unitMemberIds :prog unitOp: op) loop {
            if into.op.isZero then (findUnitIn
                :prog
                :self
                namedOpId: mid
                :trail
                :into
            )
        }
    }
    trail.pop
}

# unitAnchorFsno -- the file a unit's body lives in. The unit node itself is
# fsno-less, so the first member's operation node answers, like the L013
# walk does; zero when no member carries one.
unitAnchorFsno: function {prog: Ast.view mainOp: zast.nodeid} out zvfs.fsno is {
    zeroFs: zvfs.fsno
    bodyIds: zast.unitBodyIdsAt ast: prog unitId: mainOp
    vx: u64
    for vx < bodyIds.count loop {
        mid: zast.kidAt kids: prog.kids span: bodyIds i: vx
        vx = vx + 1
        m: prog.nodes.get i: mid
        if m.namedoperation when m.operation.isZero.not then {
            fs: prog.fsnoForNode nodeid: m.operation
            if (fs == zeroFs).not then return fs
        }
    }
    return zeroFs
}

# unitMemberIds -- the unit body's member nodes, in order
unitMemberIds: function {prog: Ast.view unitOp: zast.nodeid} out ListVal zast.nodeid is {
    return (zast.kidIds ast: prog span: (zast.unitBodyIdsAt ast: prog unitId: unitOp))
}

# usedDeclSet -- every declaration the recorded references reach: a use of a
# unit-level name marks that name under the linted unit, a member use marks
# the member under its owning type, and each public alias marks the name it
# stands for. The pairs are collected first and resolved after the walk, since
# a member lookup through the table cannot run while its table is iterated.
usedDeclSet: function {
    prog: Ast.view
    st: zenv.ZSymbolTable.view
    mainTid: ztypes.tid
    file: zvfs.fsno
    um: UnitMembers.view
} out IdSet ztypes.declid is {
    usedE: IdSet ztypes.declid
    owners: ListVal ztypes.tid
    names: ListVal u64
    for each e: st.typing.refDecl.iterateItems loop {
        dNm: u64
        dPar: ztypes.declid
        dlo: st.typing.decls.get i: e.value
        dNm = dlo.name
        dPar = dlo.parent
        if (selfReferenceAt
            :prog
            :file
            :um
            siteNid: e.key
            declId: e.value
        ) then {
            dPar = ztypes.declid
        }
        if dPar.isZero.not when dNm > 0 then {
            ownerTid: ztypes.tid
            plo: st.typing.decls.get i: dPar
            if plo.kind.unitDecl then ownerTid = mainTid
            if plo.kind.typeDecl then ownerTid = plo.typeId
            if ownerTid.isZero.not then {
                owners.append from: ownerTid
                names.append from: dNm
            }
        }
    }
    addUsedMembers :st tids: owners nms: names into: usedE
    addPublicAliasTargets :prog :st :mainTid into: usedE
    return usedE
}

# addUsedMembers -- each (owner type, member name) pair resolved to its
# declaration and added to `into`; a pair naming no member adds nothing
addUsedMembers: function {
    st: zenv.ZSymbolTable.view
    tids: (ListVal ztypes.tid).view
    nms: (ListVal u64).view
    into: IdSet ztypes.declid
} is {
    i: u64
    for i < tids.length loop {
        di: (st.typing.declTypedMemberIdOf
            parentTypeId: (tids.get :i)
            nameId: (zast.nameid.create from: (nms.get :i).u32.orPanic)
        )
        i = i + 1
        if di.isZero.not then into.add item: di
    }
}

# addPublicAliasTargets -- each name a public alias of the unit stands for
# counts as used: the alias is the public face, the target is what it names
addPublicAliasTargets: function {
    prog: Ast.view st: zenv.ZSymbolTable.view mainTid: ztypes.tid into: IdSet ztypes.declid
} is {
    tgtNames: (ztypecheck.publicAliasInternalNames
        :st
        pool: prog.names
        tid: mainTid
    )
    tI: u64
    for tI < tgtNames.length loop {
        tnm: tgtNames.get i: tI
        tI = tI + 1
        tpid: prog.names.find s: tnm.stringView
        if tpid.isZero.not then {
            tdi: (st.typing.declTypedMemberIdOf
                parentTypeId: mainTid
                nameId: tpid
            )
            if tdi.isZero.not then into.add item: tdi
        }
    }
}

# rootAtomNames -- every atom name among the rows that report from no file:
# the root parse's own, since only a unit file's body reports from its file
rootAtomNames: function {prog: Ast.view into: IdSet u64} is {
    totN: prog.nodes.length
    ndJ: zast.nodeid
    ndJ = ndJ.next
    for ndJ.u64 < totN loop {
        if (prog.fsnoForNode nodeid: ndJ).isZero then {
            ndB0: prog.nodes.get i: ndJ
            if ndB0.atomid then into.add item: ndB0.name.u64
        }
        ndJ = ndJ.next
    }
}

# unitAtomNames -- the syntactic fallback evidence: every atom name the
# unit's own file holds. Stamps exist only for the bodies the demand walk
# checked, so a private def used only inside an unchecked body (a construction
# in a never-demanded factory) would otherwise read as dead.
unitAtomNames: function {prog: Ast.view file: zvfs.fsno um: UnitMembers.view} out IdSet u64 is {
    names: IdSet u64
    if file.isZero.not then {
        atomNamesOutsideSelf :prog :file :um into: names
    } else {
        rootAtomNames :prog into: names
    }
    return names
}

# atomNamesOutsideSelf -- every atom name in the file `file` except where the
# atom names the member it sits inside. A self-recursive definition
# spells its own name, and counting that as a use is what kept L012 silent
# about two dead emitter helpers for three months.
atomNamesOutsideSelf: function {
    prog: Ast.view file: zvfs.fsno um: UnitMembers.view into: IdSet u64
} is {
    totN: prog.nodes.length
    ndI: zast.nodeid
    ndI = ndI.next
    for ndI.u64 < totN loop {
        nd0: prog.nodes.get i: ndI
        inFile: prog.fsnoForNode nodeid: ndI
        ndI = ndI.next
        if nd0.atomid when inFile == file then {
            k: memberIndexAtLine :um line: nd0.lineno
            isSelf: false
            if k < um.names.length when (um.names.get i: k) == nd0.name.u64 then isSelf = true
            if isSelf.not then into.add item: nd0.name.u64
        }
    }
}

# definedTypeTidOf -- the type id a unit member defines, 0 when the member is
# not an object definition or resolves to no type under the unit
definedTypeTidOf: function {
    prog: Ast.view st: zenv.ZSymbolTable.view mainTid: ztypes.tid site: zast.namedsite
} out ztypes.tid is {
    if site.name.isZero then return ztypes.tid.zero
    if site.operation.isZero then return ztypes.tid.zero
    to: prog.nodes.get i: site.operation
    if to.objectdef.not then return ztypes.tid.zero
    cto: (st.typing.declChildOfId
        parentTypeId: mainTid
        nameId: site.name
    )
    match (
        cto
    ) case some then {
        return cto
    } case none then null
    return ztypes.tid.zero
}

# ---- L005 redundant-suffix helpers (typecheck tier; run only under --full) ----

# nodeinfo -- a node's synthetic id and source position.
nodeinfo: record {
    # the node
    id: zast.nodeid
    # the source line, which is what a diagnostic reports rather than the
    # byte offset the wrap rules work in
    line: u32
    # the source column, paired with line
    col: u32
}

# nodeInfoOf -- the id and source position of any AST node.
nodeInfoOf: function {n: astnode.view} out nodeinfo is {
    p: zast.posOf :n
    return (nodeinfo id: (zast.nodeIdOf :n) line: p.line col: p.col)
}

# bareZeroTypeName -- the bare-type replacement when a dotted child atom is a
# zero-init suffix candidate: `string` maps to String, a concrete numeric
# type name maps to itself, anything else to "" (c8/c32 are not
# zero-suffix candidates).
bareZeroTypeName: function {ast: Ast.view n: astnode.view} out String is {
    if n.atomid then {
        znB: zast.nameTextAt :ast ref: n.name
        if znB.stringView == "string" then return "String"
        isNum: ztypecheck.isNumericTypeName name: znB.stringView
        if isNum when znB.stringView != "c8" when znB.stringView != "c32" then return znB.copy
    }
    return ""
}

# bareZeroParentText -- the source spelling of a zero-literal dotted parent:
# `""` for the empty string literal, `0` / `0.0` for the numeric zeros; ""
# when the parent is not a zero literal.
bareZeroParentText: function {ast: Ast.view n: astnode.view} out String is {
    match (
        n
    ) case atomstring then {
        if n.stringparts.count.u64 == 0 then return "\"\""
    } case atomid then {
        if (zast.nameTextEq :ast ref: n.name s: "0") then return "0"
        if (zast.nameTextEq :ast ref: n.name s: "0.0") then return "0.0"
    } else null
    return ""
}

# isNonDec -- a literal lexeme in hex / binary / octal form.
isNonDec: function {s: StringView} out bool is {
    if (s.startsWith prefix: "0x") then return true
    if (s.startsWith prefix: "0X") then return true
    if (s.startsWith prefix: "0b") then return true
    if (s.startsWith prefix: "0B") then return true
    if (s.startsWith prefix: "0o") then return true
    if (s.startsWith prefix: "0O") then return true
    return false
}

# literalFitsBase -- the literal value fits its base's default type (i64 for decimal, u64 for
# non-decimal). A literal that overflows the default keeps its suffix (load-bearing).
literalFitsBase: function {numstr: StringView} out bool is {
    pv: ztypes.parseLiteralValue :numstr
    if pv.ok.not then return false
    if pv.isFloat then return true
    if (isNonDec s: numstr) then return true
    iMax: 9223372036854775807.u64
    return pv.ival <= iMax
}

# SufRec -- a candidate suffix: the suffix type name ("" when not a candidate) and the
# position of the suffix's type token.
SufRec: class {
    # the type name the suffix spelled
    tname: String
    # the line the suffix is on
    line: u32
    # the column it starts at
    col: u32
}

# operandSuffix -- report whether the operand is a redundant-suffix dotted path,
# with the type token's position.
operandSuffix: function {ast: Ast.view n: astnode.view} out SufRec is {
    match (
        n
    ) case dottedpath then {
        cn: atomName :ast n: (ast.nodes.get i: n.child)
        if (ztypecheck.isNumericTypeName name: cn.stringView).not then {
            return (SufRec tname: "" line: 0 col: 0)
        }
        pn: atomName :ast n: (ast.nodes.get i: n.parent)
        if pn.length == 0 then return (SufRec tname: "" line: 0 col: 0)
        if (literalFitsBase numstr: pn.stringView).not then {
            return (SufRec tname: "" line: 0 col: 0)
        }
        ci: nodeInfoOf n: (ast.nodes.get i: n.child)
        return (SufRec tname: cn line: ci.line col: ci.col)
    } else {
        return (SufRec tname: "" line: 0 col: 0)
    }
}

# isNodeConst -- the node carries a compile-time const value.
isNodeConst: function {nid: zast.nodeid st: zenv.ZSymbolTable.view} out bool is {
    return (st.typing.nodeConst.has key: nid)
}

# typeNameOfNode -- the resolved type name of a node ("" when unresolved).
typeNameOfNode: function {n: astnode.view st: zenv.ZSymbolTable.view} out String is {
    info: nodeInfoOf :n
    to: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: info.id
    if to.isZero.not then {
        return (st.reg.nameOf tid: to)
    } else {
        return ""
    }
}

# typeNameOfOptAt -- the id-taking entry (0 = absent).
typeNameOfOptAt: function {
    ast: Ast.view
    oId: zast.nodeid
    st: zenv.ZSymbolTable.view
} out String is {
    if oId.isZero then return ""
    o: ast.nodes.get i: oId
    return (typeNameOfNode n: o :st)
}

# litShapedSuf -- the node is a numeric literal, bare or wearing a width
# conversion (`5`, `5.u32`, `(1.0e300).f128`): such an operand must never
# anchor a suffix strip -- removing the other side's suffix would leave
# default-typed literals and change the arithmetic width.
litShapedSuf: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case atomid then {
        an: zast.nameTextAt :ast ref: n.name
        d: false
        b: an.stringView.byteAt 0
        match (
            b
        ) case some then {
            if b >= 48 when b <= 57 then d = true
        } case none then null
        return d
    } case dottedpath then {
        return (litShapedSuf :ast n: (ast.nodes.get i: n.parent))
    } else {
        return false
    }
}

# isAnchor -- the node is a concrete non-literal value of numeric type `tname`, a genuine
# type anchor that makes a same-type literal suffix redundant.
isAnchor: function {
    ast: Ast.view
    n: astnode.view
    tname: StringView
    st: zenv.ZSymbolTable.view
} out bool is {
    if (litShapedSuf :ast :n) then return false
    info: nodeInfoOf :n
    nid: info.id
    to: ztyping.nodeTypeAt tbl: st.typing.nodeType :nid
    if to.isZero.not then {
        zhit: false
        znm: String
        name9v: st.reg.nameOf tid: to
        zhit = true
        znm = name9v.take
        if zhit.not then return false
        if (znm.stringView == tname).not then return false
        if (isNodeConst :nid :st) then return false
        return true
    } else {
        return false
    }
}

# topUnitPathOf -- the file of the topmost unit `path` belongs to. A file in a
# folder `<d>/<u>/` beside a unit file `<d>/<u>.z` is that unit's subunit, so
# the walk steps up to `<d>/<u>.z`, and on while its folder is a subunit folder
# too. The path as given when it is no subunit; a bare file name is looked up
# from the working directory.
topUnitPathOf: function {path: StringView} out String is {
    cur: path.string
    if (path.lastIndexOf needle: "/").none then {
        wd: os.cwd
        match (
            wd
        ) case ok then {
            cur = "\{wd}/\{path}"
        } case err then {
            return cur
        }
    }
    climbed: false
    stepping: true
    for stepping loop {
        stepping = false
        slashOpt: cur.stringView.lastIndexOf needle: "/"
        match (
            slashOpt
        ) case some then {
            if slashOpt > 0 then {
                parentFile: "\{cur.stringView.substring from: 0 to: slashOpt}.z"
                if (zcheck.pathKindIs path: parentFile.stringView want: io.filekind.file) then {
                    cur = parentFile.take
                    stepping = true
                    climbed = true
                }
            }
        } case none then null
    }
    # no subunit: the path as it was given
    if climbed.not then return path.string
    return cur
}

# unitNameOf -- a file path's unit name: the final path segment without the ".z" suffix.
unitNameOf: function {path: StringView} out String is {
    base: path.string
    slashOpt: path.lastIndexOf needle: "/"
    match (
        slashOpt
    ) case some then {
        r: String
        i: slashOpt + 1
        n: path.length
        for i < n loop {
            b: path.byteAt :i
            match (
                b
            ) case some then {
                r.appendByte :b
            } case none then null
            i = i + 1
        }
        base = r.take
    } case none then null
    sfx: base.stringView.stripSuffix s: ".z"
    match (
        sfx
    ) case some then {
        return sfx.string
    } case none then {
        return base.copy
    }
}

# linesOf -- split source into a 1-based-addressable list of lines (newlines stripped).
linesOf: function {src: StringView} out List String is {
    ls: List String
    for each ln: src.lines loop ls.append ln.string
    return ls
}

# lineStartIndex -- byte offset of each line's first byte, one entry per line (matching
# linesOf), an `off += len + 1` accumulator over the lines; converts token/edit positions
# to byte offsets and back without depending on the tokenizer's escape-decoded widths.
lineStartIndex: function {src: StringView} out ListVal u64 is {
    ls: ListVal u64
    off: u64
    lls: linesOf :src
    for each ln: lls loop {
        ls.append off
        off = off + ln.length + 1
    }
    return ls
}

# byteToLine -- the 0-based index of the line containing byte `off`: the largest i with
# lineStart[i] <= off. lineStart ascends, so the scan stops at the first line past off.
byteToLine: function {lineStart: (ListVal u64).view off: u64 nLines: u64} out u64 is {
    r: u64
    i: u64
    for i < nLines loop {
        v: lineStart.get :i
        if v <= off then {
            r = i
        } else {
            break
        }
        i = i + 1
    }
    return r
}

# colToByteInLine -- byte offset within `lineText` of the 1-based codepoint column `colno`.
# token columns are codepoint-based (multibyte-aware); this walks the line's bytes, consuming
# one codepoint (a lead byte plus its 0x80..0xBF continuations) per column. ASCII: colno - 1.
colToByteInLine: function {lineText: StringView colno: u32} out u64 is {
    if colno <= 1 then return 0
    target: (colno - 1).u64
    n: lineText.length
    b: u64
    cp: u64
    for cp < target loop {
        if b >= n then break
        b = b + 1
        cont: true
        for cont loop {
            if b >= n then {
                cont = false
            } else {
                nb: lineText.byteAt i: b
                isC: false
                match (
                    nb
                ) case some then {
                    if nb >= 128 when nb < 192 then isC = true
                } case none then null
                if isC then {
                    b = b + 1
                } else {
                    cont = false
                }
            }
        }
        cp = cp + 1
    }
    return b
}

# tokByteStart -- absolute byte offset of a token from its 1-based (lineno, colno): the line's
# start offset plus the codepoint-column converted to a byte column.
tokByteStart: function {
    lineStart: (ListVal u64).view
    srcLines: (List String).view
    lineno: u32
    colno: u32
} out u64 is {
    li: (lineno - 1).u64
    if li >= srcLines.length then return 0
    base: lineStart.get i: li
    lt: srcLines.get i: li
    return base + (colToByteInLine lineText: lt.stringView :colno)
}

# sortEdits -- a new edit list ordered by byteLo (ascending, stable for ties). applyEdits and
# renderDiff require sorted, non-overlapping input; each rule emits its own edits in order but
# they interleave across rules, so a global sort is run once all rules have contributed.
sortEdits: function {edits: (List zfix.Edit).borrow} out List zfix.Edit is {
    result: List zfix.Edit
    n: edits.length
    used: ListVal bool
    p: u64
    for p < n loop {
        used.append false
        p = p + 1
    }
    k: u64
    for k < n loop {
        best: n
        bestLo: u64
        bestHi: u64
        i: u64
        for i < n loop {
            u: used.get :i
            if u.not then {
                e: edits.get :i
                better: (
                    (best == n) or
                    (e.byteLo < bestLo) or
                    ((e.byteLo == bestLo) and (e.byteHi > bestHi))
                )
                if better then {
                    best = i
                    bestLo = e.byteLo
                    bestHi = e.byteHi
                }
            }
            i = i + 1
        }
        be: edits.get i: best
        result.append (zfix.Edit
            byteLo: be.byteLo
            byteHi: be.byteHi
            replacement: be.replacement.copy
        )
        used.set i: best val: true
        k = k + 1
    }
    return result
}

# emitDiffHunk -- append one zero-context unified-diff hunk to `buf` for the cluster of edits
# [cStart, cEnd) spanning old lines [clLo, clHi]. The new-side block is the old bytes with the
# cluster's edits applied, so the hunk exactly reflects the formatted output. Returns the
# running new-minus-old line delta for the next hunk's + start.
emitDiffHunk: function {
    buf: String
    source: StringView
    edits: (List zfix.Edit).view
    cStart: u64
    cEnd: u64
    clLo: u64
    clHi: u64
    lineStart: (ListVal u64).view
    srcLines: (List String).borrow
    newDelta: i64
} out i64 is {
    nLines: srcLines.length
    srcLen: source.length
    oldCount: clHi - clLo + 1
    aByte: lineStart.get i: clLo
    bByte: srcLen
    if (clHi + 1) < nLines then bByte = lineStart.get i: clHi + 1
    newBlock: String
    prev: aByte
    j: cStart
    for j < cEnd loop {
        e: edits.get i: j
        if e.byteLo >= prev when e.byteLo <= e.byteHi then {
            zfix.appendRange buf: newBlock src: source lo: prev hi: e.byteLo
            newBlock.append e.replacement
            prev = e.byteHi
        }
        j = j + 1
    }
    zfix.appendRange buf: newBlock src: source lo: prev hi: bByte
    newLines: List String
    if newBlock.length > 0 then newLines = linesOf src: newBlock.stringView
    newCount: newLines.length
    newStart: clLo.i64.orPanic + newDelta + 1
    hh: "@@ -\{clLo + 1},\{oldCount} +\{newStart},\{newCount} @@\n"
    buf.append hh
    oi: clLo
    for oi <= clHi loop {
        ol: srcLines.get i: oi
        dm: "-\{ol}\n"
        buf.append dm
        oi = oi + 1
    }
    if (clHi + 1) == nLines when (endsWithNewline src: source).not then {
        buf.append "\\ No newline at end of file\n"
    }
    for each nl: newLines loop {
        pm: "+\{nl}\n"
        buf.append pm
    }
    if newBlock.length > 0 when (endsWithNewline src: newBlock.stringView).not then {
        buf.append "\\ No newline at end of file\n"
    }
    return newDelta + newCount.i64.orPanic - oldCount.i64.orPanic
}

# byteAtLine -- byte offset of line `k`'s start, or `srcLen` when `k` is one past the last line.
byteAtLine: function {starts: (ListVal u64).view srcLen: u64 k: u64} out u64 is {
    if k >= starts.length then return srcLen
    return (starts.get i: k)
}

# bandpair -- where a resync landed: the next line on each side that is the same
# text. Past the band it is the window's far edge instead, which is what makes a
# block bounded rather than minimal.
bandpair: record {
    # the old side's line index
    oldAt: u64
    # the new side's line index
    newAt: u64
}

# linesEqualAt -- whether the two sides hold the same line at these positions.
# Past the end of either there is nothing to compare, so they do not.
linesEqualAt: function {
    oldLines: (List String).view
    newLines: (List String).view
    m: u64
    n: u64
    i: u64
    p: u64
} out bool is {
    if (i >= m) or (p >= n) then return false
    oi: oldLines.get :i
    pj: newLines.get i: p
    return oi.stringView == pj
}

# bandProbe -- the first matching pair on diagonal `t`, if the diagonal holds
# one. The diagonal is the offsets summing to t, so probing t in increasing order
# reaches the nearest resync first.
bandProbe: function {
    oldLines: (List String).view
    newLines: (List String).view
    m: u64
    n: u64
    i: u64
    p: u64
    t: u64
} out optionval bandpair is {
    a: u64
    for a <= t loop {
        b: t - a
        ii: i + a
        pp: p + b
        a = a + 1
        if ii < m when pp < n then {
            oa: oldLines.get i: ii
            pb: newLines.get i: pp
            if oa.stringView == pb then {
                return (optionval.some (bandpair oldAt: ii newAt: pp))
            }
        }
    }
    return (optionval.none bandpair)
}

# bandResync -- where the two sides line up again, searched by increasing
# diagonal so the changed block is the smallest the band can find. Nothing within
# the band means the block runs to the window's edge.
bandResync: function {
    oldLines: (List String).view
    newLines: (List String).view
    m: u64
    n: u64
    i: u64
    p: u64
} out bandpair is {
    t: 1.u64
    for t <= 256 loop {
        hit: bandProbe :oldLines :newLines :m :n :i :p :t
        if hit.some then return hit
        t = t + 1
    }
    we: i + 256
    if we > m then we = m
    wf: p + 256
    if wf > n then wf = n
    return (bandpair oldAt: we newAt: wf)
}

# lineDiffEdits -- edits transforming `old` into `new`, one per changed line-block, shaped for
# renderDiff. fmt + wrap never reorder lines, so an in-order two-pointer with a bounded diagonal-band
# resync finds correct (within the window, minimal) blocks; applyEdits(old, result) == new.
lineDiffEdits: function {old: StringView new: StringView} out List zfix.Edit is {
    oldLines: linesOf src: old
    newLines: linesOf src: new
    oldStarts: lineStartIndex src: old
    newStarts: lineStartIndex src: new
    m: oldLines.length
    n: newLines.length
    oldLen: old.length
    newLen: new.length
    edits: List zfix.Edit
    i: u64
    p: u64
    for (i < m) or (p < n) loop {
        if (linesEqualAt :oldLines :newLines :m :n :i :p) then {
            i = i + 1
            p = p + 1
            continue
        }
        at: bandResync :oldLines :newLines :m :n :i :p
        lo: byteAtLine starts: oldStarts srcLen: oldLen k: i
        hi: byteAtLine starts: oldStarts srcLen: oldLen k: at.oldAt
        nlo: byteAtLine starts: newStarts srcLen: newLen k: p
        nhi: byteAtLine starts: newStarts srcLen: newLen k: at.newAt
        repl: String
        zfix.appendRange buf: repl src: new lo: nlo hi: nhi
        doEmit: (hi > lo) or (nhi > nlo)
        if doEmit then edits.append (zfix.Edit byteLo: lo byteHi: hi replacement: repl)
        i = at.oldAt
        p = at.newAt
    }
    return edits
}

# renderDiff -- a git-style unified diff (zero context) of `source` -> the formatted result,
# driven by `edits` (assumed sorted by byteLo). Adjacent edits touching the same or
# neighbouring lines share a hunk. Empty when there are no edits.
renderDiff: function {
    path: StringView
    source: StringView
    edits: (List zfix.Edit).borrow
} out String is {
    buf: String
    m: edits.length
    if m == 0 then return buf
    lineStart: lineStartIndex src: source
    srcLines: linesOf src: source
    nLines: srcLines.length

    hdr: "--- \{path}\n+++ \{path}\n"
    buf.append hdr

    newDelta: i64
    cActive: false
    cStart: u64
    clLo: u64
    clHi: u64
    i: u64
    for i < m loop {
        e: edits.get :i
        lo: byteToLine :lineStart off: e.byteLo :nLines
        hi: lo
        if e.byteHi > e.byteLo then hi = byteToLine :lineStart off: e.byteHi - 1 :nLines
        if cActive.not then {
            cActive = true
            cStart = i
            clLo = lo
            clHi = hi
        } else if lo <= (clHi + 1) then {
            if hi > clHi then clHi = hi
        } else {
            newDelta = (emitDiffHunk
                :buf
                :source
                :edits
                :cStart
                cEnd: i
                :clLo
                :clHi
                :lineStart
                :srcLines
                :newDelta
            )
            cStart = i
            clLo = lo
            clHi = hi
        }
        i = i + 1
    }
    if cActive then {
        newDelta = (emitDiffHunk
            :buf
            :source
            :edits
            :cStart
            cEnd: m
            :clLo
            :clHi
            :lineStart
            :srcLines
            :newDelta
        )
    }
    return buf
}

# analyzeSource -- the fast-tier analysis over IN-MEMORY source: the
# read-then-analyze wrappers and zls's live editor buffers share it.
analyzeSource: function {source: String.take path: String.take opts: lintopts} out Analysis is {
    root: ast.parseSource source: source.copy
    lines: linesOf src: source.stringView
    a: (Analysis
        path: path.copy
        source: source.take
        :lines
        lineStart: ListVal u64
        diags: List zdiag.Diagnostic
        edits: List zfix.Edit
        fastToks: ListVal tokenize.token
        funcDepth: 0
        trueId: zast.nameid
        falseId: zast.nameid
        elsewhere: (IdMapR u32 V: DiagSrc)
        :opts
    )
    a.runFastChecks n: root
    if opts.arch then a.reportDuplicateBodies prog: root
    a.walkTypeCasingProgram prog: root
    a.walkGenericParamCasingProgram prog: root
    if opts.casing then a.walkCasingProgram prog: root
    anyDocs: opts.docs
    if opts.docParams then anyDocs = true
    if opts.docFields then anyDocs = true
    if opts.docsQuality then anyDocs = true
    if opts.docsQuality then a.reportDuplicateDocs
    if anyDocs then (a.walkDocsProgram
        prog: root
        docs: opts.docs
        docParams: opts.docParams
        docFields: opts.docFields
    )
    a.checkLineLength width: opts.lineLength
    a.sortEditsInPlace
    return a
}

# analyzeFile -- fast-tier analysis of one file: read, fast-parse (no VFS/typecheck),
# build the line table, and collect parse-error diagnostics.
analyzeFile: function {path: String.take opts: lintopts} out Analysis is {
    rd: io.readText :path
    match (
        rd
    ) case ok then {
        return (analyzeSource source: rd.take path: path.copy :opts)
    } case err then {
        a: (Analysis
            path: path.copy
            source: ""
            lines: List String
            lineStart: ListVal u64
            diags: List zdiag.Diagnostic
            edits: List zfix.Edit
            fastToks: ListVal tokenize.token
            funcDepth: 0
            trueId: zast.nameid
            falseId: zast.nameid
            elsewhere: (IdMapR u32 V: DiagSrc)
            :opts
        )
        d: (zdiag.errorDiag
            errv: zast.err.ioError
            fsno: zvfs.fsno
            lineno: 0
            colno: 0
            width: 0
            msg: "could not read file"
            note: ""
            hint: ""
        )
        a.diags.append d
        return a
    }
}

# analyzeFileFull -- fast-tier analysis plus the typecheck-tier suffix rule (L005). Builds the
# project VFS from `srcdir`/`systemdir` and typechecks this file's unit so the suffix check has
# resolved types. Slower than analyzeFile; only the --full path calls it.
analyzeFileFull: function {
    path: String.take
    # every --src root, searched in the order given
    srcdirs: (List String).view
    systemdir: StringView
    opts: lintopts
} out Analysis is {
    rd: io.readText :path
    match (
        rd
    ) case ok then {
        root: ast.parseSource source: rd.copy
        lines: linesOf src: rd.stringView
        a: (Analysis
            path: path.copy
            source: rd.take
            :lines
            lineStart: ListVal u64
            diags: List zdiag.Diagnostic
            edits: List zfix.Edit
            fastToks: ListVal tokenize.token
            funcDepth: 0
            trueId: zast.nameid
            falseId: zast.nameid
            elsewhere: (IdMapR u32 V: DiagSrc)
            :opts
        )
        a.runFastChecks n: root
        if opts.arch then a.reportDuplicateBodies prog: root
        a.walkTypeCasingProgram prog: root
        a.walkGenericParamCasingProgram prog: root
        anyDocs: opts.docs
        if opts.docParams then anyDocs = true
        if opts.docFields then anyDocs = true
        if opts.docsQuality then anyDocs = true
        if opts.docsQuality then a.reportDuplicateDocs
        if anyDocs then (a.walkDocsProgram
            prog: root
            docs: opts.docs
            docParams: opts.docParams
            docFields: opts.docFields
        )
        # a subunit file is parsed from its topmost unit, which names the parse
        top: topUnitPathOf path: a.path.stringView
        un: unitNameOf path: top.stringView
        a.checkSuffix :srcdirs :systemdir uname: un.stringView
        a.checkLineLength width: opts.lineLength
        a.sortEditsInPlace
        return a
    } case err then {
        a: (Analysis
            path: path.copy
            source: ""
            lines: List String
            lineStart: ListVal u64
            diags: List zdiag.Diagnostic
            edits: List zfix.Edit
            fastToks: ListVal tokenize.token
            funcDepth: 0
            trueId: zast.nameid
            falseId: zast.nameid
            elsewhere: (IdMapR u32 V: DiagSrc)
            :opts
        )
        d: (zdiag.errorDiag
            errv: zast.err.ioError
            fsno: zvfs.fsno
            lineno: 0
            colno: 0
            width: 0
            msg: "could not read file"
            note: ""
            hint: ""
        )
        a.diags.append d
        return a
    }
}

# projectHint -- what names a project's roots for the typecheck tier.
projectHint: "name the project with --src DIR and --system DIR"

# analyzeFileTiered -- analyze one file at the requested tier: the fast tier by default, or
# the full (typecheck) tier under --full (which also needs the project src/system dirs).
analyzeFileTiered: function {
    path: String.take
    # every --src root, searched in the order given
    srcdirs: (List String).view
    systemdir: StringView
    opts: lintopts
} out Analysis is {
    if opts.full then return (analyzeFileFull :path :srcdirs :systemdir :opts)
    return (analyzeFile :path :opts)
}

# codepointLen -- number of Unicode codepoints in `s` (UTF-8 continuation bytes 0x80..0xBF are not
# counted); the display "column" length for the line-length rule.
codepointLen: function {s: StringView} out u64 is {
    n: s.length
    c: u64
    b: u64
    for b < n loop {
        bo: s.byteAt i: b
        cont: false
        match (
            bo
        ) case some then {
            if bo >= 128 when bo < 192 then cont = true
        } case none then null
        if cont.not then c = c + 1
        b = b + 1
    }
    return c
}

# sourceParses -- true if `source` parses with no embedded parse errors. `zl fmt`
# uses it to confirm an edited buffer is still valid before writing it out.
sourceParses: function {source: String.take} out bool is {
    a: (Analysis
        path: ""
        source: ""
        lines: List String
        lineStart: ListVal u64
        diags: List zdiag.Diagnostic
        edits: List zfix.Edit
        fastToks: ListVal tokenize.token
        funcDepth: 0
        trueId: zast.nameid
        falseId: zast.nameid
        elsewhere: (IdMapR u32 V: DiagSrc)
        opts: defaultOpts
    )
    root: ast.parseSource :source
    a.walkProgram prog: root
    return a.parseErrorCount == 0
}

# hasHash -- true if the line contains a `#`, so a comment.
hasHash: function {line: StringView} out bool is {
    n: u64
    for n < line.length loop {
        bo: line.byteAt i: n
        match (
            bo
        ) case some then {
            if bo == 35 then return true
        } case none then null
        n = n + 1
    }
    return false
}

# takesArguments -- a callee whose arguments bind parameters by name: a
# function, or a user type, whose construction's fields are its parameters.
takesArguments: function {tt: ztypes.ztypetype} out bool is {
    return (tt == ztypes.ztypetype.functionType) or tt.isValueFamily or tt.isReferenceData
}

# builtinNumericTid -- `tid` is one of the builtin numeric scalars, asked without
# minting anything: a type named like one (a user type shadowing `u64`) or a
# typedef over one is not.
builtinNumericTid: function {ast: Ast.view st: zenv.ZSymbolTable tid: ztypes.tid} out bool is {
    tn: st.reg.nameOf :tid
    if (ztypes.numkindByName name: tn.stringView).has.not then return false
    return tid == (ztypecheck.builtinTidTRo scope: ztypes.declid :ast :st base: tn.stringView)
}

# isNumericLiteralNode -- an atom spelled as a number: `5`, `0x1f`, the `5` of
# `5.u32`.
isNumericLiteralNode: function {ast: Ast.view n: astnode.view} out bool is {
    if n.atomid.not then return false
    nm: zast.nameTextAt :ast ref: n.name
    return (ztypecheck.isNumericLiteralName name: nm.stringView)
}

# operatorKind -- ztypes.operatorKindOf for the operator atom at `nid`.
operatorKind: function {ast: Ast.view nid: zast.nodeid} out u8 is {
    nm: zast.nameTextAt :ast ref: (atomNameIdOf n: (ast.nodes.get i: nid))
    return (ztypes.operatorKindOf name: nm.stringView)
}

# isSpaceByte -- a space, a tab or a line end.
isSpaceByte: function {c: u8} out bool is {
    return (c == 32) or (c == 9) or (c == 10) or (c == 13)
}

# groupedSpan -- the source between `lo` and `hi` is one parenthesised group:
# it ends in a `)` whose matching `(` opens before `lo`, with nothing between
# them but space and the opening parentheses of the operand's own first term.
groupedSpan: function {sv: StringView lo: u64 hi: u64} out bool is {
    if (hi == 0) or ((docByteAt s: sv i: hi - 1) != 41) then return false
    op: matchingOpenParen :sv close: hi - 1
    if op == 0 then return false
    i: op - 1
    # the group must open before the operand does, `((a) == b) or c`
    if i >= lo then return false
    k: i + 1
    for k < lo while (
        (isSpaceByte c: (docByteAt s: sv i: k)) or ((docByteAt s: sv i: k) == 40)
    ) loop {
        k = k + 1
    }
    return k >= lo
}

# matchingOpenParen -- the `(` matching the `)` at `close`, as its index plus
# one; 0 when none matches.
matchingOpenParen: function {sv: StringView close: u64} out u64 is {
    depth: u64
    i: close + 1
    for i > 0 loop {
        i = i - 1
        c: docByteAt s: sv :i
        if c == 41 then depth = depth + 1
        if c == 40 then {
            depth = depth - 1
            if depth == 0 then return i + 1
        }
    }
    return 0
}
