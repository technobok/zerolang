# zsource -- the analysis facade for zl. The fast tier reads and parses a
# single file (no VFS, no typecheck), builds a 1-based line table, and collects
# any embedded parse errors as ERROR diagnostics; the full tier (`--full`)
# builds the project VFS and typechecks for the type-dependent rules. The
# Analysis carries what the reporter and the fixer need.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :Analysis
    :analyzeFileTiered
    :analyzeSource
    :lintedUnitNamed
    :lintedUnitOf
    :lintopts
    :defaultOpts
    :complexityThreshold
    :lineDiffEdits
    :renderDiff
    :sourceParses
    :topUnitPathOf
    :unitAnchorFsno
    :unitNameOf
    :isDataFile
}

astnode: zast.astnode
Ast: zast.Ast

# lintopts -- which optional rules a lint run enables. One value threads from
# the command line to every rule, so a new rule is a field here, not a
# parameter added to every layer between them.
lintopts: record {
    # run the typecheck-tier rules too, which needs the project's src and system
    # directories
    full: bool
    # the column width to wrap at, and to report W005 against; 0 turns both off
    lineLength: u32
    # run L009, the variant/union member casing rule
    casing: bool
    # run L016, undocumented definitions
    docs: bool
    # run L017, undocumented parameters
    docParams: bool
    # run L018, undocumented members
    docFields: bool
    # measure a unit's WHOLE surface rather than only its `public:` block.
    # Without it a unit exporting a handful of names reports almost nothing
    docsPrivate: bool
    # run L024 and L025, which judge the docs that exist rather than counting
    # the ones missing
    docsQuality: bool
    # run the A-codes, which are advisory and ratcheted rather than gating
    arch: bool
    # the cognitive-complexity threshold A008 reports against; 0 turns the rule
    # off. `--arch` sets the default, `--complexity N` overrides it
    complexity: u32
}

# defaultOpts -- the fast tier with every optional rule off.
defaultOpts: function {} out lintopts is {
    return (
        lintopts
        full: false
        lineLength: 0
        casing: false
        docs: false
        docParams: false
        docFields: false
        docsPrivate: false
        docsQuality: false
        arch: false
        complexity: 0
    )
}

# ---- AST query helpers for the parse-tier rules ----

# The line count above which A005 reports a function. It counts RAW SOURCE SPAN from
# the definition to the deepest statement its body reaches, so a doc comment and an
# exploded parameter list both push a function toward it. A body that is one `match`
# is exempt: a dispatcher is as long as the arms it names.
longFunctionLines: 150.u32

# The parameter count from which A014 reports a function head. Eight is where a
# reader stops holding the list in mind: the parameters that travel together are
# one value, and a head that stays this wide says why in its doc.
wideSignatureParams: 8.u32

# The body length from which A006 compares shapes: below it a match is a
# coincidence of small bodies, not a copy.
duplicateBodyLines: 8.u32

# The cognitive complexity above which A008 reports a function: SonarSource's
# default. `--complexity N` overrides it, and 0 turns the rule off.
complexityThreshold: 15.u32

# casingKindOf -- the kind an object definition's name is cased by: its own,
# or for a typedef its base's.
casingKindOf: function {ast: Ast.view opId: zast.nodeid} out zast.objectkind is {
    op: ast.nodes.get i: opId
    match (
        op
    ) case objectdef then {
        if op.kind == zast.objectkind.typedefDef then {
            b0: zast.kidAt kids: ast.kids span: op.isItems i: 0
            return (typedefCasingKind :ast baseId: b0)
        }
        return op.kind
    } else {
        return zast.objectkind.recordDef
    }
}

# typedefCasingKind -- the family a typedef's name is cased by: its base's,
# read off the base's own name, since that name is cased by its family too. A
# capitalised base is a reftype and makes the typedef read as a class; any
# other, a record. A parameterized base is read by its head, a dotted one by
# its last segment.
typedefCasingKind: function {ast: Ast.view baseId: zast.nodeid} out zast.objectkind is {
    hid: baseId
    bn: ast.nodes.get i: baseId
    match (
        bn
    ) case call then {
        hid = bn.callable
    } else null
    nm: zast.nameid
    {
        hn: ast.nodes.get i: hid
        match (
            hn
        ) case atomid then {
            nm = hn.name
        } case dottedpath then {
            cn: ast.nodes.get i: hn.child
            if cn.atomid then nm = cn.name
        } else null
    }
    if nm.isZero then return zast.objectkind.recordDef
    tx: zast.nameTextAt :ast ref: nm
    fb: tx.stringView.byteAt i: 0
    if fb.some when (ascii.isUpper b: fb) then return zast.objectkind.classDef
    return zast.objectkind.recordDef
}

# sameFile -- whether two paths name one filesystem object: the same device
# and inode, whatever the spelling. False when either cannot be read.
sameFile: function {a: StringView b: StringView} out bool is {
    sa: io.stat path: a
    sb: io.stat path: b
    match (
        sa
    ) case ok then {
        match (
            sb
        ) case ok then {
            return (sa.device == sb.device) and (sa.inode == sb.inode)
        } case err then null
    } case err then null
    return false
}

# unitNamesIn -- the unit names of the `.z` files directly under `dir`.
unitNamesIn: function {dir: StringView} out List String is {
    names: List String
    ents: io.listDir path: dir
    match (
        ents
    ) case ok then {
        for each e: ents loop {
            ev: e.stringView
            if (ev.endsWith suffix: ".z") then names.append from: (
                ev.substring
                from: 0
                to: ev.length - 2
            ).string
        }
    } case err then null
    return names
}

# sourceFilesUnder -- the `.z` files the source root `dir` holds, as paths:
# each file directly under it, followed by the files of the folder of its name
# (its subunits) and theirs. A rule that asks what the project reads asks
# every one of them: a subunit file is code of its unit.
sourceFilesUnder: function {dir: StringView} out List String is {
    files: List String
    names: unitNamesIn :dir
    names.sort
    for each nm: names loop {
        f: "\{dir}/\{nm}.z"
        appendFamilyFiles unitFile: f.stringView into: files
    }
    return files
}

# projectReadNames -- the member names dotted reads reach in every `.z` file
# of the source root `dir` (sourceFilesUnder), as text: a parse per file, the
# reassignment targets excluded (a write is not a read).
projectReadNames: function {dir: StringView into: Set String} is {
    for each fp: (sourceFilesUnder :dir) loop {
        rd: io.readText path: fp
        match (
            rd
        ) case ok then {
            fileReadNames root: (ast.parseSource source: rd.take) :into
        } case err then null
    }
}

# projectUnitReads -- the member names read as `<unit>.<name>` in every `.z` file
# of the source root `dir` (sourceFilesUnder) other than the unit's own, as
# text: a parse per file.
projectUnitReads: function {dir: StringView uname: StringView into: Set String} is {
    own: "\{dir}/\{uname}.z"
    for each fp: (sourceFilesUnder :dir) loop {
        if fp.stringView != own then {
            rd: io.readText path: fp
            match (
                rd
            ) case ok then {
                fileUnitReads root: (ast.parseSource source: rd.take) :uname :into
            } case err then null
        }
    }
}

# fileUnitReads -- the child names of every `<unit>.<child>` dotted path in one
# parsed file, into `into`. A deeper path `unit.a.b` reads `a`, the export.
fileUnitReads: function {root: Ast.view uname: StringView into: Set String} is {
    {
        uid: zast.poolFind pool: root.names text: uname
        if uid.isZero then return
        ni: zast.nodeid
        ni = ni.next
        nn: root.nodes.length
        for ni.u64 < nn loop {
            nd: root.nodes.get i: ni
            if nd.dottedpath then {
                pn: root.nodes.get i: nd.parent
                if pn.atomid when pn.name == uid then {
                    cn: root.nodes.get i: nd.child
                    if cn.atomid then {
                        into.add item: (zast.poolTextCopy pool: root.names ref: cn.name)
                    }
                }
            }
            ni = ni.next
        }
    }
}

# fileReadNames -- the dotted member reads of one parsed file, into `into`.
fileReadNames: function {root: Ast.view into: Set String} is {
    {
        topaths: IdSet zast.nodeid
        ni: zast.nodeid
        ni = ni.next
        nn: root.nodes.length
        for ni.u64 < nn loop {
            nd: root.nodes.get i: ni
            if nd.reassignment then {
                topaths.add item: nd.topath
            }
            ni = ni.next
        }
        nj: zast.nodeid
        nj = nj.next
        for nj.u64 < nn loop {
            nd2: root.nodes.get i: nj
            if nd2.dottedpath when (topaths.has item: nj).not then {
                cn: root.nodes.get i: nd2.child
                if cn.atomid then {
                    into.add item: (zast.poolTextCopy pool: root.names ref: cn.name)
                }
            }
            nj = nj.next
        }
    }
}

# plainLiteralText -- the text of a string literal with no interpolation
# (one literal chunk), none for any other node.
plainLiteralText: function {ast: Ast.view n: astnode.view} out Option String is {
    match (
        n
    ) case atomstring then {
        if n.stringparts.count.u64 != 1 then return (Option.none String)
        c: ast.nodes.get i: (zast.kidAt kids: ast.kids span: n.stringparts i: 0)
        match (
            c
        ) case stringchunk then {
            return (Option.some (zast.literalTextAt :ast ref: c.text).string)
        } else {
            return (Option.none String)
        }
    } else {
        return (Option.none String)
    }
}

# lineLeavesBlock -- statement line `id` is a `return`, `break` or `continue`
# (bare, or a call of one), which leaves the block: nothing after it runs.
lineLeavesBlock: function {ast: Ast.view id: zast.nodeid} out bool is {
    cur: id
    depth: 0
    for depth < 4 loop {
        n: ast.nodes.get i: cur
        match (
            n
        ) case statementline then {
            cur = n.statementline
        } case call then {
            cur = n.callable
        } case atomid then {
            if n.name == zast.wellKnown.slot.wkReturn then return true
            if n.name == zast.wellKnown.slot.wkBreak then return true
            return n.name == zast.wellKnown.slot.wkContinue
        } else return false
        depth = depth + 1
    }
    return false
}

# lineIsEndlessLoop -- the statement at `id` is a bare `for loop`: no condition,
# no postcondition and no `break` that leaves it, so it never finishes. A loop
# with a constant condition is the checker's to know; this tier reads syntax.
lineIsEndlessLoop: function {ast: Ast.view id: zast.nodeid} out bool is {
    loopId: id
    line: ast.nodes.get i: id
    if line.statementline then loopId = line.statementline
    n: ast.nodes.get i: loopId
    if n.forexpr.not then return false
    if (n.conditions.count.u64 > 0) or (n.postconditions.count.u64 > 0) then return false
    return (bodyBreaksOut :ast body: n.body).not
}

# bodyBreaksOut -- a `break` under `body` leaves the loop it is the body of,
# wherever it is written: one inside a nested loop or a block leaves that.
bodyBreaksOut: function {ast: Ast.view body: zast.nodeid} out bool is {
    work: ListVal zast.nodeid capacity: 32
    work.append body
    wi: u64
    for wi < work.length loop {
        wid: work.get i: wi
        wi = wi + 1
        if wid.notZero then {
            wn: ast.nodes.get i: wid
            if (zast.atomNameIdOf n: wn) == zast.wellKnown.slot.wkBreak then return true
            if (wn.forexpr or wn.doexpr or wn.functiondef).not then (
                zast.childIdsInto
                :ast
                n: wn
                acc: work
            )
        }
    }
    return false
}

# bodyKeyInto -- the shape of the subtree at `id`, appended to `buf`: every arm
# name, each binary operator and each literal chunk kept, every other name
# folded away. Two bodies with the same key differ only in what they call
# things -- the field they read, the map they probe, the helper they forward
# to -- which is what A006 exists to find.
bodyKeyInto: function {ast: Ast.view id: zast.nodeid buf: String.borrow} is {
    n: ast.nodes.get i: id
    buf.append s: (zast.armName :n)
    match (
        n
    ) case stringchunk then {
        buf.append "\""
        buf.append s: (zast.literalTextAt :ast ref: n.text)
    } else null
    buf.append "("
    kids: zast.childIdsAt :ast :id
    for each k: kids loop {
        bodyKeyInto :ast id: k :buf
        buf.append ","
    }
    buf.append ")"
}

# bodyIsOneMatch -- the body is a single statement and that statement is a
# `match` over TWO OR MORE arms: a dispatcher, whose length is the number of
# arms it names. A one-arm match is a guard that unwraps its subject, not a
# dispatcher, and the body it guards is as long as it reads.
bodyIsOneMatch: function {ast: Ast.view bodyId: zast.nodeid} out bool is {
    if (zast.stmtLineCount :ast nid: bodyId) != 1 then return false
    id: zast.stmtLineAt :ast nid: bodyId i: 0
    depth: 0
    for depth < 4 loop {
        n: ast.nodes.get i: id
        match (
            n
        ) case statementline then {
            id = n.statementline
        } case caseexpr then {
            return n.clauses.count.u64 > 1
        } else return false
        depth = depth + 1
    }
    return false
}

# CcState -- the running score of one function's complexity walk, a class so
# the recursion below adds to one value
CcState: class {
    # the score so far
    score: u32
}

# soleIfOf -- the `if` a body holds when it is exactly one `if` statement (an
# `else if`), 0 otherwise.
soleIfOf: function {ast: Ast.view bodyId: zast.nodeid} out zast.nodeid is {
    zero: zast.nodeid
    if bodyId.isZero then return zero
    if (zast.stmtLineCount :ast nid: bodyId) != 1 then return zero
    id: zast.stmtLineAt :ast nid: bodyId i: 0
    depth: 0
    for depth < 4 loop {
        n: ast.nodes.get i: id
        match (
            n
        ) case statementline then {
            id = n.statementline
        } case ifexpr then {
            return id
        } else return zero
        depth = depth + 1
    }
    return zero
}

# fnself -- the function a walk is scoring: its name and the name of its
# receiver, zero when it has none.
fnself: record {
    name: zast.nameid
    recv: zast.nameid
}

# ccSelfRef -- whether `id` spells the function being scored: its bare name,
# or its receiver, a dot and that name. A reference to a function calls it, so
# either is a recursive call.
ccSelfRef: function {ast: Ast.view id: zast.nodeid fn: fnself} out bool is {
    n: ast.nodes.get i: id
    match (
        n
    ) case atomid then {
        return n.name == fn.name
    } case dottedpath then {
        p: ast.nodes.get i: n.parent
        onRecv: false
        match (
            p
        ) case atomid then {
            if p.name == fn.recv then onRecv = true
        } else null
        if onRecv then {
            c: ast.nodes.get i: n.child
            match (
                c
            ) case atomid then {
                return c.name == fn.name
            } else null
        }
    } else null
    return false
}

# ccVisitSpan -- ccVisit over every node of a span
ccVisitSpan: function {ast: Ast.view span: zast.kidspan nesting: u32 fn: fnself acc: CcState} is {
    for each kid: (zast.kidsOf :ast :span) loop {
        ccVisit :ast id: kid :nesting :fn :acc
    }
}

# CcArms -- the arms of one match as ccArm scores them
CcArms: class {
    # every arm's score added up
    total: u32
    # the highest score one arm reached
    worst: u32
    # the locals an arm reassigns without declaring them, each once
    outer: ListVal zast.nameid
}

# ccWrites -- the names the subtree at `id` binds, into `declared`, and the
# bare names it reassigns, into `written`
ccWrites: function {
    ast: Ast.view id: zast.nodeid declared: ListVal zast.nameid written: ListVal zast.nameid
} is {
    if id.isZero then return
    n: ast.nodes.get i: id
    match (
        n
    ) case assignment then {
        declared.append n.name
    } case reassignment then {
        t: ast.nodes.get i: n.topath
        match (
            t
        ) case atomid then {
            written.append t.name
        } else null
    } else null
    kids: zast.childIds :ast :n
    for each k: kids loop {
        ccWrites :ast id: k :declared :written
    }
}

# ccArm -- score one arm's body on its own at `nesting` into `arms`, with the
# outer locals it reassigns
ccArm: function {ast: Ast.view bodyId: zast.nodeid nesting: u32 fn: fnself arms: CcArms} is {
    one: CcState score: 0
    ccVisit :ast id: bodyId :nesting :fn acc: one
    arms.total = arms.total + one.score
    if one.score > arms.worst then arms.worst = one.score
    declared: ListVal zast.nameid
    written: ListVal zast.nameid
    ccWrites :ast id: bodyId :declared :written
    for each w: written loop {
        if (declared.contains item: w).not when (arms.outer.contains item: w).not then {
            arms.outer.append w
        }
    }
}

# ccArms -- the arms' share of a match's score: the worst arm, plus one for
# each local an arm reassigns that the arm does not declare, never more than
# the arms' sum. A match runs one arm, so a reader follows one arm at a time;
# the locals the arms write are what the code after the match must keep in
# mind. The `else` is one more arm, and the arm names are skipped: an arm
# named like the function is not a call
ccArms: function {
    ast: Ast.view
    span: zast.kidspan
    elseclause: zast.nodeid
    nesting: u32
    fn: fnself
    acc: CcState
} is {
    arms: CcArms total: 0 worst: 0 outer: ListVal zast.nameid
    for each kid: (zast.kidsOf :ast :span) loop {
        c: ast.nodes.get i: kid
        match (
            c
        ) case caseclause then {
            ccArm :ast bodyId: c.statement :nesting :fn :arms
        } else null
    }
    if elseclause.notZero then ccArm :ast bodyId: elseclause :nesting :fn :arms
    share: arms.worst + arms.outer.length.u32.orPanic
    if share > arms.total then share = arms.total
    acc.score = acc.score + share
}

# ccIf -- an `if`: one plus its nesting for the first clause, unless it
# continues an `else if` chain whose `else` paid, one for each further clause,
# one for a `when` chain, the bodies one level deeper; then the `else`: one
# for an `else if`, walked as a chained if at the same nesting, one for a
# plain `else` with its body one level deeper
ccIf: function {
    ast: Ast.view
    clauses: zast.kidspan
    elseclause: zast.nodeid
    chained: bool
    nesting: u32
    fn: fnself
    acc: CcState
} is {
    ci: u64
    for ci < clauses.count loop {
        cid: zast.kidAt kids: ast.kids span: clauses i: ci
        ci = ci + 1
        c: ast.nodes.get i: cid
        match (
            c
        ) case ifclause then {
            if ci == 1 then {
                if chained.not then acc.score = acc.score + 1 + nesting
            } else {
                acc.score = acc.score + 1
            }
            if c.conditions.count > 1 then acc.score = acc.score + 1
            ccVisitSpan :ast span: c.conditions :nesting :fn :acc
            ccVisit :ast id: c.statement nesting: nesting + 1 :fn :acc
        } else null
    }
    if elseclause.isZero then return
    inner: soleIfOf :ast bodyId: elseclause
    acc.score = acc.score + 1
    if inner.isZero then {
        ccVisit :ast id: elseclause nesting: nesting + 1 :fn :acc
    } else {
        m: ast.nodes.get i: inner
        match (
            m
        ) case ifexpr then {
            (
                ccIf
                :ast
                clauses: m.clauses
                elseclause: m.elseclause
                chained: true
                :nesting
                :fn
                :acc
            )
        } else null
    }
}

# ccVisit -- add `id`'s contribution at `nesting` to `acc`, then its
# children's: an `if`, `for` or `match` costs one plus its nesting and nests
# its bodies (a match's arms add what ccArms says), a chained header
# condition costs one, a recursive call costs one, a nested function literal
# nests its body and costs nothing, and everything else is walked through
ccVisit: function {ast: Ast.view id: zast.nodeid nesting: u32 fn: fnself acc: CcState} is {
    if id.isZero then return
    n: ast.nodes.get i: id
    match (
        n
    ) case ifexpr then {
        ccIf :ast clauses: n.clauses elseclause: n.elseclause chained: false :nesting :fn :acc
    } case forexpr then {
        acc.score = acc.score + 1 + nesting
        if (n.conditions.count + n.postconditions.count) > 1 then acc.score = acc.score + 1
        ccVisitSpan :ast span: n.conditions :nesting :fn :acc
        ccVisit :ast id: n.body nesting: nesting + 1 :fn :acc
        ccVisitSpan :ast span: n.postconditions :nesting :fn :acc
    } case caseexpr then {
        acc.score = acc.score + 1 + nesting
        ccVisit :ast id: n.subject :nesting :fn :acc
        ccArms :ast span: n.clauses elseclause: n.elseclause nesting: nesting + 1 :fn :acc
    } case functiondef then {
        ccVisit :ast id: n.body nesting: nesting + 1 :fn :acc
    } case call then {
        if (ccSelfRef :ast id: n.callable :fn) then acc.score = acc.score + 1
        ccVisitSpan :ast span: n.arguments :nesting :fn :acc
    } case atomid then {
        if n.name == fn.name then acc.score = acc.score + 1
    } case dottedpath then {
        if (ccSelfRef :ast :id :fn) then {
            acc.score = acc.score + 1
        } else {
            ccVisit :ast id: n.parent :nesting :fn :acc
        }
    } else {
        kids: zast.childIds :ast :n
        for each k: kids loop {
            ccVisit :ast id: k :nesting :fn :acc
        }
    }
}

# The match arms that only recurse, from which A013 reports a function. Fewer
# can be a deliberate step into the one child that matters for a kind, not a
# walk written out by hand.
handWalkArms: 5.u64

# HwArm -- what hwStmt finds in one match arm
HwArm: class {
    # the arm calls its function again
    recurses: bool
    # a statement in the arm does work of its own: a call other than the
    # recursion, a write through a path, or a returned value that is not made
    # of recursions, names and literals
    own: bool
}

# hwPassedOn -- whether the call argument `a` passes on the caller's own value
# of that name, `:name`
hwPassedOn: function {ast: Ast.view a: astnode.view} out bool is {
    match (
        a
    ) case namedoperation then {
        v: ast.nodes.get i: a.operation
        match (
            v
        ) case labelvalue then {
            return v.name == a.name
        } else null
    } else null
    return false
}

# hwSelfCall -- whether the node at `id` is a call of the function `fn`,
# marking `arm` as recursing when it is. A recursion that changes more than one
# argument, where a walk changes only the part it walks into and passes the
# rest on (`:name`), does work of the arm's own: `inLoop: true`, `nesting + 1`
hwSelfCall: function {ast: Ast.view id: zast.nodeid fn: fnself arm: HwArm} out bool is {
    n: ast.nodes.get i: id
    match (
        n
    ) case call then {
        if (ccSelfRef :ast id: n.callable :fn).not then return false
        arm.recurses = true
        changed: u64
        for each aId: (zast.kidsOf :ast span: n.arguments) loop {
            a: ast.nodes.get i: aId
            if (hwPassedOn :ast :a).not then changed = changed + 1
        }
        if changed > 1 then arm.own = true
        return true
    } else return false
}

# hwRecurses -- mark `arm` as recursing when the expression at `id` calls the
# function `fn` anywhere in it
hwRecurses: function {ast: Ast.view id: zast.nodeid fn: fnself arm: HwArm} is {
    if id.isZero then return
    isCall: hwSelfCall :ast :id :fn :arm
    if isCall.not when (ccSelfRef :ast :id :fn) then arm.recurses = true
    n: ast.nodes.get i: id
    kids: zast.childIds :ast :n
    for each k: kids loop {
        hwRecurses :ast id: k :fn :arm
    }
}

# hwRecursesSpan -- hwRecurses over every node of a span
hwRecursesSpan: function {ast: Ast.view span: zast.kidspan fn: fnself arm: HwArm} is {
    for each kid: (zast.kidsOf :ast :span) loop {
        hwRecurses :ast id: kid :fn :arm
    }
}

# hwReturned -- whether the value a `return` hands back at `id` is made only of
# recursions, names and literals, joined by operators: what a walk returns is
# what its recursions found
hwReturned: function {ast: Ast.view id: zast.nodeid fn: fnself arm: HwArm} out bool is {
    n: ast.nodes.get i: id
    match (
        n
    ) case atomid then {
        return true
    } case atomstring then {
        return true
    } case namedoperation then {
        return (hwReturned :ast id: n.operation :fn :arm)
    } case call then {
        if (hwSelfCall :ast :id :fn :arm) then return true
        if n.infix.not then return false
        return (
            hwOperandsReturned
            :ast
            callable: n.callable
            arguments: n.arguments
            :fn
            :arm
        )
    } else return false
}

# hwOperandsReturned -- whether both sides of an operator, the left in the
# dotted `callable` and the right in `arguments`, are values hwReturned accepts
hwOperandsReturned: function {
    ast: Ast.view callable: zast.nodeid arguments: zast.kidspan fn: fnself arm: HwArm
} out bool is {
    c: ast.nodes.get i: callable
    if c.dottedpath.not then return false
    if (hwReturned :ast id: c.parent :fn :arm).not then return false
    for each a: (zast.kidsOf :ast span: arguments) loop {
        if (hwReturned :ast id: a :fn :arm).not then return false
    }
    return true
}

# hwQuietName -- whether a name alone as a statement does nothing of its own:
# `break`, `continue`, `null`, or a `return` with no value
hwQuietName: function {name: zast.nameid} out bool is {
    if name == zast.wellKnown.slot.wkBreak then return true
    if name == zast.wellKnown.slot.wkContinue then return true
    if name == zast.wellKnown.slot.tyNull then return true
    return name == zast.wellKnown.slot.wkReturn
}

# hwStmtSpan -- hwStmt over every node of a span
hwStmtSpan: function {ast: Ast.view span: zast.kidspan fn: fnself arm: HwArm} is {
    for each kid: (zast.kidsOf :ast :span) loop {
        hwStmt :ast id: kid :fn :arm
    }
}

# hwStmt -- read the statement at `id` into `arm`. A binding, a reassigned
# local, `break`, `continue`, `null` and a bare `return` do no work of their
# own; an `if`, `for` or `match` does what its bodies do; a call is the
# recursion, a `return` of a value hwReturned accepts, or work of its own.
# A recursion anywhere, a condition included, marks the arm as recursing
hwStmt: function {ast: Ast.view id: zast.nodeid fn: fnself arm: HwArm} is {
    if id.isZero then return
    n: ast.nodes.get i: id
    match (
        n
    ) case statement then {
        hwStmtSpan :ast span: n.statements :fn :arm
    } case statementline then {
        hwStmt :ast id: n.statementline :fn :arm
    } case assignment then {
        hwRecurses :ast id: n.value :fn :arm
    } case reassignment then {
        if (ast.nodes.get i: n.topath).atomid.not then arm.own = true
        hwRecurses :ast id: n.value :fn :arm
    } case ifexpr then {
        hwStmtSpan :ast span: n.clauses :fn :arm
        hwStmt :ast id: n.elseclause :fn :arm
    } case ifclause then {
        hwRecursesSpan :ast span: n.conditions :fn :arm
        hwStmt :ast id: n.statement :fn :arm
    } case forexpr then {
        hwRecursesSpan :ast span: n.conditions :fn :arm
        hwStmt :ast id: n.body :fn :arm
        hwRecursesSpan :ast span: n.postconditions :fn :arm
    } case caseexpr then {
        hwRecurses :ast id: n.subject :fn :arm
        hwStmtSpan :ast span: n.clauses :fn :arm
        hwStmt :ast id: n.elseclause :fn :arm
    } case caseclause then {
        hwStmt :ast id: n.statement :fn :arm
    } case atomid then {
        if n.name == fn.name then {
            arm.recurses = true
        } else if (hwQuietName name: n.name).not then {
            arm.own = true
        }
    } case call then {
        cl: ast.nodes.get i: n.callable
        isReturn: false
        if cl.atomid then isReturn = cl.name == zast.wellKnown.slot.wkReturn
        if (hwSelfCall :ast :id :fn :arm) then {
            null
        } else if isReturn then {
            for each a: (zast.kidsOf :ast span: n.arguments) loop {
                if (hwReturned :ast id: a :fn :arm).not then arm.own = true
            }
        } else {
            arm.own = true
        }
    } case dottedpath then {
        if (ccSelfRef :ast :id :fn) then {
            arm.recurses = true
        } else {
            arm.own = true
        }
    } else {
        arm.own = true
    }
}

# hwRecursingArms -- how many of a match's arms only recurse: each calls
# `fn` again and does no work of its own (hwStmt)
hwRecursingArms: function {ast: Ast.view clauses: zast.kidspan fn: fnself} out u64 is {
    count: u64
    for each cId: (zast.kidsOf :ast span: clauses) loop {
        c: ast.nodes.get i: cId
        match (
            c
        ) case caseclause then {
            arm: HwArm recurses: false own: false
            hwStmt :ast id: c.statement :fn :arm
            if arm.recurses when arm.own.not then count = count + 1
        } else null
    }
    return count
}

# hwMostArms -- the most arms of any one match in the subtree at `id` that
# only recurse: each calls `fn` again and does no work of its own. The
# `else` is not counted, since a walk over the children belongs there; a
# nested function literal is a function of its own and is not searched
hwMostArms: function {ast: Ast.view id: zast.nodeid fn: fnself} out u64 is {
    if id.isZero then return 0
    n: ast.nodes.get i: id
    most: u64
    match (
        n
    ) case functiondef then {
        return 0
    } case caseexpr then {
        most = hwRecursingArms :ast clauses: n.clauses :fn
    } else null
    kids: zast.childIds :ast :n
    for each kid: kids loop {
        m: hwMostArms :ast id: kid :fn
        if m > most then most = m
    }
    return most
}

# isComposedParts -- a string literal's parts shaped like a composed key: two
# or more interpolation holes joined by a short separator with no space
# (`"\{a}.\{b}"`, `"\{unit}_\{name}"`). A message with holes reads as prose
# between them and is not one.
isComposedParts: function {ast: Ast.view parts: zast.kidspan} out bool is {
    holes: u64
    sepSinceHole: false
    composed: false
    for each pId: (zast.kidsOf :ast span: parts) loop {
        part: ast.nodes.get i: pId
        match (
            part
        ) case stringchunk then {
            if holes > 0 when (isKeySeparator s: (
                zast.literalTextAt
                :ast
                ref: part.text
            )
            ) then sepSinceHole = true
        } else {
            if holes > 0 when sepSinceHole then composed = true
            holes = holes + 1
            sepSinceHole = false
        }
    }
    return composed
}

# isKeySeparator -- one or two bytes, neither a space nor a path separator:
# what joins the halves of a composed key (a path is composed too, and is not
# a key).
isKeySeparator: function {s: StringView} out bool is {
    return (
        (s.length > 0) and
        (s.length <= 2) and
        (s.contains needle: " ").not and
        (
            s.contains
            needle: "/"
        ).not
    )
}

# isStatementArm -- the node is a braced `{ ... }` statement block.
isStatementArm: function {n: astnode.view} out bool is {
    match (
        n
    ) case statement then {
        return true
    } else {
        return false
    }
}

# isEmptyBlock -- a statement block with no statement lines (`{}`).
isEmptyBlock: function {n: astnode.view} out bool is {
    match (
        n
    ) case statement then {
        return n.statements.count.u64 == 0
    } else {
        return false
    }
}

# stmtPos -- the source position of a statement block.
stmtPos: function {n: astnode.view} out zast.nodepos is {
    match (
        n
    ) case statement then {
        return (zast.nodepos line: n.lineno col: n.colno)
    } else {
        return (zast.nodepos line: 0 col: 0)
    }
}

# isIfArm -- the node is an `if`.
isIfArm: function {n: astnode.view} out bool is {
    match (
        n
    ) case ifexpr then {
        return true
    } else {
        return false
    }
}

# slIsIf -- a statement line wrapping an `if`.
slIsIf: function {ast: Ast.view sl: astnode.view} out bool is {
    match (
        sl
    ) case statementline then {
        return (isIfArm n: (ast.nodes.get i: sl.statementline))
    } else {
        return false
    }
}

# flagbind -- a `name: true` / `name: false` statement line: the local and the
# literal it was bound to; both 0 for any other line.
flagbind: record {
    name: zast.nameid
    lit: zast.nameid
}

# recvuse -- one method's receiver: the function, the parameter that declares
# it and the name it is declared with (`this` for the `:this` shorthand).
# `param` is zero for a function that has no receiver.
recvuse: record {
    fn: zast.nodeid
    param: zast.nodeid
    name: zast.nameid
    body: zast.nodeid
    # declared by the `:this` shorthand
    shorthand: bool
}

# typedThis -- whether a parameter's type is the enclosing type: `this`,
# `this` under an ownership marker, or the `:this` shorthand.
typedThis: function {ast: Ast.view opId: zast.nodeid} out bool is {
    wkThis: zast.wellKnown.slot.wkThis
    o: ast.nodes.get i: opId
    match (
        o
    ) case labelvalue then {
        return o.name == wkThis
    } case atomid then {
        return o.name == wkThis
    } case dottedpath then {
        mk: zast.markerKindOfName id: (zast.atomNameIdOf n: (ast.nodes.get i: o.child))
        owns: mk.viewMarker or mk.borrowMarker or (mk.takeMarker or mk.holdMarker)
        return owns and ((zast.atomNameIdOf n: (ast.nodes.get i: o.parent)) == wkThis)
    } else {
        return false
    }
}

# receiverOf -- the receiver of the function `fnId`: its first parameter typed
# `this`. A node that is no function, or a function with no such parameter,
# answers a recvuse whose `param` is zero.
receiverOf: function {ast: Ast.view fnId: zast.nodeid} out recvuse is {
    none: recvuse fn: fnId param: zast.nodeid name: zast.nameid body: zast.nodeid shorthand: false
    f: ast.nodes.get i: fnId
    match (
        f
    ) case functiondef then {
        for each pId: (zast.kidsOf :ast span: f.parameters) loop {
            p: ast.nodes.get i: pId
            if p.namedoperation when (typedThis :ast opId: p.operation) then {
                sh: (ast.nodes.get i: p.operation).labelvalue
                return (recvuse fn: fnId param: pId name: p.name body: f.body shorthand: sh)
            }
        }
        return none
    } else {
        return none
    }
}

# declaresName -- whether the function `fnId` declares `name` itself, as a
# parameter or as a member of its `as` clause.
declaresName: function {ast: Ast.view fnId: zast.nodeid name: zast.nameid} out bool is {
    f: ast.nodes.get i: fnId
    match (
        f
    ) case functiondef then {
        for each pId: (zast.kidsOf :ast span: f.parameters) loop {
            p: ast.nodes.get i: pId
            if p.namedoperation when p.name == name then return true
        }
        for each aId: (zast.kidsOf :ast span: f.asItems) loop {
            a: ast.nodes.get i: aId
            if a.namedoperation when a.name == name then return true
        }
        return false
    } else {
        return false
    }
}

# bindsEither -- whether the node `n` binds the name `a` or the name `b`: a
# definition, a `with`, or a `for` header's binding.
bindsEither: function {ast: Ast.view n: astnode.view a: zast.nameid b: zast.nameid} out bool is {
    match (
        n
    ) case assignment then {
        return (n.name == a) or (n.name == b)
    } case withexpr then {
        return (n.name == a) or (n.name == b)
    } case forexpr then {
        for each cId: (zast.kidsOf :ast span: n.conditions) loop {
            c: ast.nodes.get i: cId
            if c.namedoperation when (c.name == a) or (c.name == b) then return true
        }
        return false
    } else {
        return false
    }
}

# receiverScan -- gather into `uses` each atom under `id` that reads the name
# `old`, and answer whether the tree holds what makes renaming `old` to
# `target` unsafe: a read of `target`, a binding of either name, either name
# as a shorthand argument, or a function of its own. A member name and a
# `case` arm's name are not reads.
receiverScan: function {
    ast: Ast.view
    id: zast.nodeid
    old: zast.nameid
    target: zast.nameid
    uses: ListVal zast.nodeid
} out bool is {
    n: ast.nodes.get i: id
    if (bindsEither :ast :n a: old b: target) then return true
    match (
        n
    ) case atomid then {
        if n.name == old then uses.append id
        return n.name == target
    } case labelvalue then {
        return (n.name == old) or (n.name == target)
    } case functiondef then {
        return true
    } case dottedpath then {
        return (receiverScan :ast id: n.parent :old :target :uses)
    } case caseclause then {
        return (receiverScan :ast id: n.statement :old :target :uses)
    } else null
    for each c: (zast.childIds :ast :n) loop {
        if (receiverScan :ast id: c :old :target :uses) then return true
    }
    return false
}

# gatherReceivers -- append to `recvs` the receiver of each method among a
# type's `members`.
gatherReceivers: function {ast: Ast.view members: zast.kidspan recvs: ListVal recvuse} is {
    for each mId: (zast.kidsOf :ast span: members) loop {
        m: ast.nodes.get i: mId
        if m.namedoperation then {
            r: receiverOf :ast fnId: m.operation
            if r.param.notZero then recvs.append from: r
        }
    }
}

# receiverNameOf -- the name a type's methods give their receiver: the one
# most of `recvs` declare, `this` aside, and the first of them on a tie. Zero
# when every method writes `:this`.
receiverNameOf: function {recvs: (ListVal recvuse).view} out zast.nameid is {
    best: zast.nameid
    bestN: 0
    for each r: recvs loop {
        if r.name == zast.wellKnown.slot.wkThis then continue
        n: 0
        for each o: recvs loop {
            if o.name == r.name then n = n + 1
        }
        if n > bestN then {
            best = r.name
            bestN = n
        }
    }
    return best
}

# innerNodeIdOf -- `id` with its statement line peeled: the node a statement
# line actually holds.
innerNodeIdOf: function {ast: Ast.view id: zast.nodeid} out zast.nodeid is {
    n: ast.nodes.get i: id
    match (
        n
    ) case statementline then {
        return (innerNodeIdOf :ast id: n.statementline)
    } else {
        return id
    }
}

# singleLineBodyOf -- the one statement an `if` clause's block holds, wrappers
# peeled; 0 when the block holds any other number of lines.
singleLineBodyOf: function {ast: Ast.view clauseId: zast.nodeid} out zast.nodeid is {
    c: ast.nodes.get i: clauseId
    match (
        c
    ) case ifclause then {
        b: ast.nodes.get i: c.statement
        match (
            b
        ) case statement then {
            if b.statements.count.u64 != 1 then return zast.nodeid
            first: zast.kidAt kids: ast.kids span: b.statements i: 0
            return (innerNodeIdOf :ast id: first)
        } else {
            return zast.nodeid
        }
    } else {
        return zast.nodeid
    }
}

# isElseIfWrap -- the else clause is the synthetic block an `else if` chain parses
# to (a single statement line wrapping an `if`), not a real braced `else { ... }`.
isElseIfWrap: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case statement then {
        if n.statements.count.u64 == 1 then {
            res: false
            for each slId: (zast.kidsOf :ast span: n.statements) loop {
                sl: ast.nodes.get i: slId
                res = slIsIf :ast :sl
            }
            return res
        }
        return false
    } else {
        return false
    }
}

# casingSuggest -- the lowerCamelCase form of an ALL-CAPS / SCREAMING_SNAKE member name:
# split on `_`, lowercase each segment, and capitalise the first letter of every segment
# after the first. Compounds without underscores become run-together lowercase.
casingSuggest: function {name: StringView} out String is {
    buf: String
    cap: false
    for each bo: name.byteView loop {
        if bo == 0c_ then {
            cap = true
        } else {
            c: ascii.lower b: bo
            if cap when buf.length > 0 then c = ascii.upper b: c
            buf.appendByte b: c
            cap = false
        }
    }
    return buf
}

# casingClash -- true when `s` (a proposed lowercase member name) collides with a language
# keyword or a future-reserved word, and so cannot be used as-is.
casingClash: function {s: StringView} out bool is {
    # a proposed name is no word of any source: it is looked up in a pool of
    # its own, which holds every keyword from its creation
    pool: zast.StringPool.create
    id: zast.poolFind :pool text: s
    if id.isZero then return false
    if (zlexer.kwOfId :id).found then return true
    return (zlexer.isReservedId :id)
}

# ---- L024/L025 doc-quality helpers (parse tier) ----

# textAt -- whether the bytes of `s` from `at` on spell `text`.
textAt: function {s: StringView at: u64 text: StringView} out bool is {
    if (at + text.length) > s.length then return false
    return (s.substring from: at to: at + text.length) == text
}

# docByteAt -- the byte at `i`, 0 past the end. The rules below index bytes constantly
# and none of them can act on an absent one.
docByteAt: function {s: StringView i: u64} out u8 is {
    bo: s.byteAt :i
    if bo.some then {
        c: bo
        return c
    }
    return 0
}

# simplePathFirstAtom -- the first atom of a plain name or a dotted path of
# names (`x`, `a.b.c`), or 0 when `id` is anything else.
simplePathFirstAtom: function {ast: Ast.view id: zast.nodeid} out zast.nodeid is {
    n: ast.nodes.get i: id
    match (
        n
    ) case atomid then {
        return id
    } case dottedpath then {
        if (zast.atomNameIdOf n: (ast.nodes.get i: n.child)).isZero then return zast.nodeid
        return (simplePathFirstAtom :ast id: n.parent)
    } else {
        return zast.nodeid
    }
}

# simplePathLastAtom -- the last atom of a path simplePathFirstAtom accepts.
simplePathLastAtom: function {ast: Ast.view id: zast.nodeid} out zast.nodeid is {
    n: ast.nodes.get i: id
    match (
        n
    ) case dottedpath then {
        return n.child
    } else {
        return id
    }
}

# trimBackWs -- `hi` moved back over the whitespace before it.
trimBackWs: function {s: StringView hi: u64} out u64 is {
    h: hi
    for h > 0 loop {
        if (ascii.isSpace b: (docByteAt :s i: h - 1)).not then return h
        h = h - 1
    }
    return h
}

# parenGroupStart -- the index of the `(` matching the `)` at `close - 1`; 0 when
# that byte is not a `)` or nothing matches it (no operand starts at byte 0).
parenGroupStart: function {s: StringView close: u64} out u64 is {
    if close == 0 then return 0
    if (docByteAt :s i: close - 1) != ascii.parenClose then return 0
    depth: 0
    i: close
    for i > 0 loop {
        i = i - 1
        b: docByteAt :s :i
        if b == ascii.parenClose then depth = depth + 1
        if b == ascii.parenOpen then {
            depth = depth - 1
            if depth == 0 then return i
        }
    }
    return 0
}

# onlyOpensBetween -- every byte in [lo, hi) is a `(` or whitespace: the gap
# between a paren group's `(` and the operand the tree positions inside it.
onlyOpensBetween: function {s: StringView lo: u64 hi: u64} out bool is {
    i: lo
    for i < hi loop {
        b: docByteAt :s :i
        if b != ascii.parenOpen when (ascii.isSpace :b).not then return false
        i = i + 1
    }
    return true
}

# docByteIsWord -- true for the ASCII letters and digits a word is made of. Everything
# else -- punctuation, backticks, the `--` dash, path separators -- is a boundary.
docByteIsWord: function {b: u8} out bool is {
    return (ascii.isLetter :b) or (ascii.isDigit :b)
}

# docIsStopword -- true for a function word every doc shares, which therefore says
# nothing about what this one adds. One space-delimited string tested by substring
# rather than a compare chain: a table of literal compares is the shape A001 exists to
# discourage, and this needs no ids because a stopword IS its spelling.
docIsStopword: function {w: StringView} out bool is {
    if w.length == 0 then return true
    sw: " a an and any are as at be but by can for from has have if in into is it its may no not of on once one only or other over own same so than that the their them then there these they this those to up when where which while with without "
    probe: " \{w} "
    return (sw.contains needle: probe)
}

# docWordsInto -- append the lowercase alphanumeric runs of `s` to `into`.
docWordsInto: function {s: StringView into: List String} is {
    run: String
    i: u64
    n: s.length
    for i < n loop {
        c: docByteAt :s :i
        if (docByteIsWord b: c) then {
            run.appendByte b: (ascii.lower b: c)
        } else {
            if run.length > 0 then {
                into.append from: run.copy
                run = "".string
            }
        }
        i = i + 1
    }
    if run.length > 0 then into.append from: run.copy
}

# docAddRun -- one alphanumeric run of a declaration: the run lowercased, then each of
# its camel-case segments, so `ZSymbolTable` also offers `symbol` and `table` and a doc
# reading "the symbol table" is recognised as saying what the type already says.
docAddRun: function {run: StringView into: List String} is {
    whole: String
    seg: String
    i: u64
    n: run.length
    for i < n loop {
        c: docByteAt s: run :i
        isUp: false
        if (ascii.isUpper b: c) then isUp = true
        if isUp when seg.length > 0 then {
            into.append from: seg.copy
            seg = "".string
        }
        c = ascii.lower b: c
        seg.appendByte b: c
        whole.appendByte b: c
        i = i + 1
    }
    if seg.length > 0 then into.append from: seg.copy
    if whole.length > 0 then into.append from: whole.copy
}

# docVocabInto -- the vocabulary a declaration line offers a reader: every alphanumeric
# run in it and every camel-case segment of those runs. A doc built only from these adds
# nothing the name and the type cannot, which is the bar a comment has to clear.
docVocabInto: function {s: StringView into: List String} is {
    run: String
    i: u64
    n: s.length
    for i < n loop {
        c: docByteAt :s :i
        if (docByteIsWord b: c) then {
            run.appendByte b: c
        } else {
            if run.length > 0 then {
                docAddRun run: run.stringView :into
                run = "".string
            }
        }
        i = i + 1
    }
    if run.length > 0 then docAddRun run: run.stringView :into
}

# docHasWord -- membership by spelling. The list is a handful of words from one source
# line, so a scan beats building a set for it.
docHasWord: function {xs: (List String).view w: StringView} out bool is {
    found: false
    for each e: xs loop {
        if e.stringView == w then found = true
    }
    return found
}

# docFoldTemplate -- the words of a doc body with every word the declaration itself
# supplies, and every word carrying a digit (a width, a count), folded to `_`: a body
# written once per type or per bit-width reads as the one body it is.
docFoldTemplate: function {
    words: (List String).view
    vocab: (List String).view
} out List String is {
    folded: List String
    for each w: words loop {
        fold: docHasWord xs: vocab w: w.stringView
        if fold.not then fold = docHasDigit w: w.stringView
        if fold then {
            folded.append from: "_".string
        } else {
            folded.append from: w.copy
        }
    }
    return folded
}

# docHasDigit -- the word carries a decimal digit.
docHasDigit: function {w: StringView} out bool is {
    i: u64
    n: w.length
    for i < n loop {
        c: docByteAt s: w :i
        if (ascii.isDigit b: c) then return true
        i = i + 1
    }
    return false
}

# docJoinWords -- the words joined by single spaces: the normalised key two doc bodies
# are the same under. Case, punctuation and wrapping all wash out here, so a comment
# re-wrapped at a different width still matches its twin.
docJoinWords: function {xs: (List String).view} out String is {
    buf: String
    for each w: xs loop {
        if buf.length > 0 then buf.append " "
        buf.append s: w
    }
    return buf
}

# docStripComment -- the declaration text of a source line, its trailing `#` comment
# removed. The comment is what is being judged, so it cannot also be the evidence.
docStripComment: function {ln: StringView} outx StringView is {
    i: u64
    n: ln.length
    for i < n loop {
        c: docByteAt s: ln :i
        if c == ascii.hash then return (ln.substring from: 0 to: i)
        i = i + 1
    }
    return ln
}

# docTrailingComment -- the text after a line's `#`, "" when it has none. A member may
# be documented by a trailing comment instead of a block above, and both forms are read
# by hover, so both are judged.
docTrailingComment: function {ln: StringView} out String is {
    i: u64
    n: ln.length
    for i < n loop {
        c: docByteAt s: ln :i
        if c == ascii.hash then {
            t: ln.substring from: i + 1 to: n
            return t.trim.string
        }
        i = i + 1
    }
    return "".string
}

# docStartsLine -- true when column `col` is the first non-space character of its line,
# so the declaration standing there owns the doc block above it. A parameter sharing the
# function's head line does not: the block above is the FUNCTION's doc, and a trailing
# comment belongs to whichever declaration on the line comes last.
docStartsLine: function {ln: StringView col: u32} out bool is {
    if col < 1 then return false
    n: (col - 1).u64
    if n > ln.length then return false
    i: u64
    for i < n loop {
        c: docByteAt s: ln :i
        isSpace: (c == ascii.space) or (c == 0c\t)
        if isSpace.not then return false
        i = i + 1
    }
    return true
}

# docLineIsComment -- true when the line's first non-space character is `#`.
docLineIsComment: function {ln: StringView} out bool is {
    t: ln.trim
    return (t.startsWith "#")
}

# ---- L023 generic-param-casing helpers (parse tier) ----

# genericBoundBase -- the bound's base identifier as WRITTEN in a generic
# parameter declaration: `AnyRef` out of `AnyRef.generic`, and out of the
# parenthesised `(AnyRef.generic default: null)` form. "" when the leaf is
# `.valtype` or `.reftype`, which name a kind rather than a type and so carry
# no case to compare -- a shape the parser accepts and the typechecker rejects
# (`Unknown type 'reftype'`), so the arm is defensive, not reachable from a
# program that compiles. It unwraps the same call `zast.isGenericParamOp`
# does, and must keep doing so: a reader that unwrapped
# fewer would report the shapes it never looked at as implementant, and the
# parenthesised form is the one parameter in the tree that would go unseen.
genericBoundBase: function {ast: Ast.view opId: zast.nodeid} out String is {
    if opId.isZero then return "".string
    n: ast.nodes.get i: opId
    match (
        n
    ) case call then {
        return (genericBoundBase :ast opId: n.callable)
    } case dottedpath then {
        if (zast.markerKindOfLeaf :ast leaf: n.child).genericBound.not then return "".string
        return (zast.atomNameText :ast n: (ast.nodes.get i: n.parent))
    } else {
        return "".string
    }
}

# byteIsUpper -- true when an optional source byte is an ASCII capital.
byteIsUpper: function {b: optionval u8} out bool is {
    match (
        b
    ) case some then {
        if (ascii.isUpper :b) then return true
        return false
    } case none then {
        return false
    }
}

# flipFirstCase -- `s` with its first ASCII letter's case inverted, which is the
# spelling the case rule asks for. A name that starts with neither case comes
# back unchanged.
flipFirstCase: function {s: StringView} out String is {
    buf: String
    n: s.length
    i: u64
    for i < n loop {
        bo: s.byteAt :i
        if bo.some then {
            c: bo
            if i == 0 then {
                if (ascii.isUpper b: c) then c = ascii.lower b: c else c = ascii.upper b: c
            }
            buf.appendByte b: c
        }
        i = i + 1
    }
    return buf
}

# casingMessage -- the L009 diagnostic text: a direct rename when the lowerCamelCase form is
# usable, or a role-suffixed alternative when it clashes with a keyword/reserved word.
casingMessage: function {orig: StringView sug: StringView} out String is {
    if (casingClash s: sug) then {
        return "member '\{orig}' is not lowerCamelCase -- '\{sug}' is a keyword; use a role suffix, e.g. '\{sug}Kind' (type-kind) / '\{sug}Def' (AST node)"
    }
    return "member '\{orig}' is not lowerCamelCase -- rename to '\{sug}'"
}

# endsWithNewline -- true if `src` is empty or its last byte is a newline.
endsWithNewline: function {src: StringView} out bool is {
    n: src.length
    if n == 0 then return true
    bo: src.byteAt i: n - 1
    match (
        bo
    ) case some then {
        if bo == 0c\n then return true
        return false
    } case none then {
        return true
    }
}

# DiagSrc -- where a diagnostic found in ANOTHER file than the linted one is
# shown: that file's path, and its source line when it has one.
DiagSrc: class {
    # the file the diagnostic is in, as its root spells it
    path: String
    # the source line it points at
    line: String
    # whether `line` was read; false leaves the diagnostic without a snippet
    hasLine: bool
}

# lookupFn -- the compiler's functions that resolve a NAME of the program --
# intern or find it in a pool, walk a scope for a type, find a unit or a child
# declaration -- which A011 refuses a string literal: a name the compiler itself
# spells is a zast.wellKnown entry, read by id.
lookupFn: list {
    poolFind: "poolFind"
    nameIdOf: "nameIdOf"
    unitDeclByName: "unitDeclByName"
    walkLookupTyperef: "walkLookupTyperef"
    walkLookupTyperefRo: "walkLookupTyperefRo"
    nameTextEq: "nameTextEq"
    poolTextEq: "poolTextEq"
    nameIs: "nameIs"
    declChildOf: "declChildOf"
} out staticlist StringView

# ComplexityFinding -- one function A008 reports: the line it is defined at,
# its name and its cognitive complexity
ComplexityFinding: class {
    line: u32
    fn: String
    score: u32
}

# the working state of one file's lint/format analysis: the source and
# its line table, the collected diagnostics and fix edits, and the raw
# token stream shared across the checks.
Analysis: class {
    # the file being analysed, for the diagnostics to name
    path: String
    # its full text, owned for the analysis's life
    source: String
    # the text split into lines, which the doc rules read directly rather than
    # through the tree
    lines: List String
    # each line's byte offset, so a token's position converts to an offset
    # without rescanning
    lineStart: ListVal u64
    # the findings, in the order they were made
    diags: List zdiag.Diagnostic
    # the byte-range replacements a fix would apply
    edits: List zfix.Edit
    # the token stream, for the rules that need tokens and not a tree
    fastToks: ListVal tokenize.token
    # how deep in nested functions the walk is
    funcDepth: u64
    # the same, for the typecheck-tier walk (walkSuf)
    sufFnDepth: u64
    # the declaration of the unit the typecheck-tier walk is in: where a name a
    # fix would write is looked up
    sufSite: ztypes.declid
    # the pool ids of `true` and `false` in this file, 0 when absent, so the
    # boolean-literal rule compares ids and never spellings
    trueId: zast.nameid
    falseId: zast.nameid
    # each diagnostic found in another file, keyed by its index in `diags`: the
    # full tier places it while the project's file system is still there
    elsewhere: (IdMapR u32 V: DiagSrc)
    # which optional rules this run enables. One value threads from the command
    # line to every rule, so a new rule is a field here and not a parameter on
    # every layer between
    opts: lintopts
    # the name-lookup functions A011 watches (lookupFn)
    lookupWords: zast.Vocab
    # each A008 function's line, name and score, in the order found: what
    # `zl lint --complexity-table` writes
    complexities: List ComplexityFinding
} as {
    # parseErrorCount -- how many collected diagnostics are hard (ERROR) -- i.e.
    # parse errors. The fmt parse gate refuses any file with a non-zero count.
    parseErrorCount: function {t: this.view} out u64 is {
        c: u64
        for each d: t.diags loop {
            match (
                d.sev
            ) case error then {
                c = c + 1
            } else null
        }
        return c
    }

    # failCount -- diagnostics that fail the gate: everything except advisory INFO. `zl lint` exits
    # non-zero on a non-zero count, so INFO rules (line-length) report without failing.
    failCount: function {t: this.view} out u64 is {
        c: u64
        for each d: t.diags loop {
            isInfo: false
            match (
                d.sev
            ) case info then {
                isInfo = true
            } else null
            if isInfo.not then c = c + 1
        }
        return c
    }

    # warnFix -- append a WARNING diagnostic AND its single safe fix edit (a
    # replacement of source[lo, hi) with `repl`). Used by the format rules.
    warnFix: function {
        t: this
        code: StringView
        msg: String.take
        line: u32
        col: u32
        width: u64
        lo: u64
        hi: u64
        repl: String.take
    } is {
        t.warn :code :msg :line :col :width
        t.edits.append (zfix.Edit byteLo: lo byteHi: hi replacement: repl)
    }

    # walkOptAt -- the id-taking entry (0 = absent).
    walkOptAt: function {t: this ast: Ast.view oId: zast.nodeid} is {
        if oId.isZero then return
        o: ast.nodes.get i: oId
        t.walk :ast n: o
    }

    # addDiag -- append a lint diagnostic of severity `sev` (fast tier: no fsno;
    # the single-file reporter resolves the source line from the line table).
    # `weight` is what it adds to its rule's ratchet row (zdiag.Diagnostic).
    addDiag: function {
        t: this
        sev: zdiag.severity
        code: StringView
        msg: String.take
        line: u32
        col: u32
        width: u64
        weight: u32
    } is {
        d: (
            zdiag.Diagnostic
            code: code.string
            :sev
            fsno: zvfs.fsno
            lineno: line
            colno: col
            width: width.u32.orPanic
            :msg
            note: "".string
            hint: "".string
            :weight
        )
        t.diags.append d
    }

    # warn -- append a WARNING lint diagnostic, which fails the gate.
    warn: function {
        t: this code: StringView msg: String.take line: u32 col: u32 width: u64 weight: 1.u32
    } is {
        t.addDiag sev: zdiag.severity.warning :code :msg :line :col :width :weight
    }

    # info -- append an advisory INFO diagnostic (does not fail the gate; carries no fix).
    info: function {t: this code: StringView msg: String.take line: u32 col: u32 width: u64} is {
        t.addDiag sev: zdiag.severity.info :code :msg :line :col :width weight: 1
    }

    # checkLineLength -- W005 (advisory): a line wider than `width` codepoints. INFO severity, so it
    # reports but never fails the gate; runs only when a width is set (--line-length). No fix.
    checkLineLength: function {t: this width: u32} is {
        if width == 0 then return
        lls: linesOf src: t.source.stringView
        lno: 1.u32
        for each ln: lls loop {
            cl: codepointLen s: ln.stringView
            if cl > width then {
                (
                    t.info
                    code: "W005"
                    msg: "line exceeds \{width} columns (\{cl})"
                    line: lno
                    col: width + 1
                    width: 1
                )
            }
            lno = lno + 1
        }
    }

    # checkEmpty -- L001 empty `else {}` and, for a backwards single-condition `if`,
    # the empty `then {}` (via checkEmptyThen). Receives an ifexpr's else + clauses.
    checkEmpty: function {
        t: this ast: Ast.view elseclauseId: zast.nodeid clauses: zast.kidspan
    } is {
        if elseclauseId.isZero then return
        elseNode: ast.nodes.get i: elseclauseId
        if (isEmptyBlock n: elseNode) then {
            p: stmtPos n: elseNode
            (
                t.warn
                code: "L001"
                msg: "empty `else { }` clause".string
                line: p.line
                col: p.col
                width: 2
            )
        } else if (isStatementArm n: elseNode) when clauses.count.u64 == 1 when (
            isElseIfWrap
            :ast
            n: elseNode
        ).not then {
            for each c0Id: (zast.kidsOf :ast span: clauses) loop {
                t.checkEmptyThen :ast clause: (ast.nodes.get i: c0Id)
            }
        }
    }

    # checkEmptyThen -- L002 a single-condition clause whose `then {}` is empty.
    checkEmptyThen: function {t: this ast: Ast.view clause: astnode.view} is {
        if clause.ifclause then {
            cst: ast.nodes.get i: clause.statement
            if (isEmptyBlock n: cst) when clause.conditions.count.u64 == 1 then {
                p: stmtPos n: (ast.nodes.get i: clause.statement)
                (
                    t.warn
                    code: "L002"
                    msg: "empty `then { }` clause".string
                    line: p.line
                    col: p.col
                    width: 2
                )
            }
        }
    }

    # checkCollapseName -- L006: a named argument `name: name` whose label equals its bare-atom
    # value collapses to the `:name` shorthand (same atomVariableId stamp -- codegen-neutral once
    # the emitter treats labelvalue == atomid). Fires on atomid values only, so it is idempotent:
    # a `:name` parses to a labelvalue and zast.atomNameText returns "".
    checkCollapseName: function {t: this ast: Ast.view arguments: zast.kidspan} is {
        if t.lineStart.length == 0 then return
        for each aId: (zast.kidsOf :ast span: arguments) loop {
            a: ast.nodes.get i: aId
            if a.namedoperation then {
                label: zast.nameTextAt :ast ref: a.name
                val: zast.atomNameText :ast n: (ast.nodes.get i: a.operation)
                lsv: label.stringView
                vsv: val.stringView
                if lsv.length > 0 when vsv.length > 0 when lsv == vsv then {
                    lo: (
                        tokByteStart
                        lineStart: t.lineStart
                        srcLines: t.lines
                        lineno: a.lineno
                        colno: a.colno
                    )
                    vi: nodeInfoOf n: (ast.nodes.get i: a.operation)
                    hi: (
                        tokByteStart
                        lineStart: t.lineStart
                        srcLines: t.lines
                        lineno: vi.line
                        colno: vi.col
                    )
                    (
                        t.warnFix
                        code: "L006"
                        msg: "redundant label repeating its value; use the :name shorthand".string
                        line: a.lineno
                        col: a.colno
                        width: lsv.length
                        :lo
                        :hi
                        repl: ":".string
                    )
                }
            }
        }
    }

    # checkLeadingLabel -- L004 token tier: a construct word directly followed
    # by the label its first argument may leave out (isLeadingLabel).
    # `is native` is one spelling and is left alone. Re-tokenizes the source
    # (parse-free; immune to strings and comments).
    checkLeadingLabel: function {t: this} is {
        scanPool: zast.StringPool.create
        toks: tokenize.scan source: t.source.copy pool: scanPool
        # the last token that is not trivia, and before it the construct word
        # whose label that token is, when it is one. The scan ends in the EOF
        # token, so there is a first token to start both from.
        prev: toks.get i: 0
        word: prev
        pending: false
        for each tok: toks loop {
            trivia: tok.toktype.wsTok or tok.toktype.eolTok or tok.toktype.commentTok
            if trivia then continue
            if pending when (prev.toktype.isTok and tok.toktype.nativeTok).not then {
                em: String
                {
                    lt: zast.poolTextAt pool: scanPool ref: prev.text
                    wt: zast.poolTextAt pool: scanPool ref: word.text
                    em = "redundant `\{lt}`: the first argument of `\{wt}` leaves out its name"
                }
                (
                    t.warnFix
                    code: "L004"
                    msg: em
                    line: prev.lineno
                    col: prev.colno
                    width: prev.width
                    lo: prev.offset
                    hi: tok.offset
                    repl: "".string
                )
            }
            pending = isLeadingLabel word: prev.toktype label: tok.toktype
            word = prev
            prev = tok
        }
    }

    # walkProgram -- root entry of the parse-tier rule visitor: the table
    # rides inside the program node.
    walkProgram: function {t: this prog: Ast.view} is {
        {
            for each unitRoot: prog.units loop {
                t.walk ast: prog n: (prog.nodes.get i: unitRoot)
            }
        }
    }

    # reportDuplicateBodies -- A006: a function body, eight lines or longer,
    # whose shape (bodyKeyInto) another function of the unit family already
    # has. The first site in family order (familyFilesOf) is the original; each
    # later one is reported against it, in the file that holds it. So the
    # files before this one are read for their shapes, and this one is judged.
    reportDuplicateBodies: function {t: this prog: Ast.view} is {
        firstAt: MapRV String v: bodysite
        family: familyFilesOf file: t.path.stringView
        own: familyIndexOf :family file: t.path.stringView
        k: u64
        for k < own loop {
            rd: io.readText path: (family.get i: k)
            match (
                rd
            ) case ok then {
                earlier: ast.parseSource source: rd.take
                for each eid: earlier.units loop {
                    t.dupBodyWalk ast: earlier id: eid :firstAt file: k :family judged: false
                }
            } case err then null
            k = k + 1
        }
        {
            for each uid: prog.units loop {
                t.dupBodyWalk ast: prog id: uid :firstAt file: own :family judged: true
            }
        }
    }

    # reportDuplicateBody -- A006 at `line`, `col` of family file `file`: the
    # function there has the body shape first seen at `first`
    reportDuplicateBody: function {
        t: this first: bodysite file: u64 family: (List String).view line: u32 col: u32
    } is {
        at: "line \{first.line}"
        if first.file != file then at = "line \{first.line} of \{family.get i: first.file}"
        (
            t.info
            code: "A006"
            msg: "this body has the shape of the one at \{at}; one function, with the difference as an argument"
            :line
            :col
            width: 1
        )
    }

    # dupBodyWalk -- one node of the duplicate-body pass over family file
    # `file`: a function's body is keyed and looked up; every child is visited.
    # A file that is not `judged` only records its shapes.
    dupBodyWalk: function {
        t: this
        ast: Ast.view
        id: zast.nodeid
        firstAt: (MapRV String v: bodysite)
        file: u64
        family: (List String).view
        judged: bool
    } is {
        n: ast.nodes.get i: id
        if n.functiondef when n.body.notZero then {
            # the body's own lines: a documented parameter list is not body
            top: (zast.posOf n: (ast.nodes.get i: n.body)).line
            span: (zast.spanEndLineAt :ast id: n.body) - top + 1
            if span >= duplicateBodyLines then {
                key: String
                bodyKeyInto :ast id: n.body buf: key
                seen: firstAt.get :key
                match (
                    seen
                ) case some then {
                    if judged then (
                        t.reportDuplicateBody
                        first: seen
                        :file
                        :family
                        line: n.lineno
                        col: n.colno
                    )
                } case none then {
                    firstAt.set key: key.copy value: (bodysite :file line: n.lineno)
                }
            }
        }
        kids: zast.childIdsAt :ast :id
        for each k: kids loop t.dupBodyWalk :ast id: k :firstAt :file :family :judged
    }

    # walkTypeCasingProgram / walkTypeCasingAt -- L021 (default-on): a type
    # definition's name casing follows its kind -- record/variant/facet
    # lowercase, class/union/protocol/generator PascalCase (styleguide Naming).
    walkTypeCasingProgram: function {t: this prog: Ast.view} is {
        {
            for each tcid: prog.units loop {
                t.walkTypeCasingAt ast: prog nId: tcid
            }
        }
    }

    # the id-taking entry to the type-casing walk, so the caller can lend the
    # tree without holding a node view
    walkTypeCasingAt: function {t: this ast: Ast.view nId: zast.nodeid} is {
        n: ast.nodes.get i: nId
        match (
            n
        ) case namedoperation then {
            t.walkTypeCasingAt :ast nId: n.operation
        } case unitdef then {
            for each bId: (zast.kidsOf :ast span: n.body) loop {
                bm: ast.nodes.get i: bId
                if bm.namedoperation then {
                    op: ast.nodes.get i: bm.operation
                    if op.objectdef then {
                        (
                            t.checkTypeNameCasing
                            :ast
                            nameRef: bm.name
                            line: bm.lineno
                            col: bm.colno
                            kind: (casingKindOf :ast opId: bm.operation)
                        )
                    }
                }
            }
        } else null
    }

    # checkTypeNameCasing -- flag a valtype name carrying a capital, or a
    # reftype name that does not start with one.
    checkTypeNameCasing: function {
        t: this ast: Ast.view nameRef: zast.nameid line: u32 col: u32 kind: zast.objectkind
    } is {
        isVal: (
            (kind == zast.objectkind.recordDef) or
            (kind == zast.objectkind.variantDef) or
            (kind == zast.objectkind.facetDef) or
            (kind == zast.objectkind.dataDef) or
            (kind == zast.objectkind.choiceDef)
        )
        isRef: (
            (kind == zast.objectkind.classDef) or
            (kind == zast.objectkind.unionDef) or
            (kind == zast.objectkind.protocolDef) or
            (kind == zast.objectkind.generatorDef)
        )
        if isVal.not when isRef.not then return
        nm: zast.nameTextAt :ast ref: nameRef
        hasUpper: false
        for each cb: nm.byteView loop {
            if (ascii.isUpper b: cb) then hasUpper = true
        }
        firstUpper: false
        fb: nm.stringView.byteAt i: 0
        if fb.some when (ascii.isUpper b: fb) then firstUpper = true
        bad: false
        msg: String
        if isVal when hasUpper then {
            bad = true
            msg = "valtype '\{nm}' should be lowercase -- record/variant/facet/data names run their words together without capitals"
        }
        if isRef when firstUpper.not then {
            bad = true
            msg = "reftype '\{nm}' should be PascalCase -- class/union/protocol/generator names start with a capital"
        }
        if bad then {
            (
                t.warn
                code: "L021"
                :msg
                :line
                :col
                width: nm.length
            )
        }
    }

    # walkGenericParamCasingProgram -- L023 (default-on): a generic parameter's
    # case matches the case of its bound's name, so a reader sees the ownership
    # family at the point of use (styleguide Naming). A linear sweep of the node
    # table rather than a descent: a parameter sits in an objectdef's as-block,
    # a functiondef's as-block or a unit body, and a walk taught only some of
    # those carriers would pass the rest in silence.
    walkGenericParamCasingProgram: function {t: this prog: Ast.view} is {
        {
            gi: zast.nodeid
            gn: prog.nodes.length
            for gi.u64 < gn loop {
                gm: prog.nodes.get i: gi
                if gm.namedoperation when (zast.isGenericParamOp ast: prog opId: gm.operation
                ) then {
                    (
                        t.checkGenericParamCasing
                        ast: prog
                        nameRef: gm.name
                        opId: gm.operation
                        line: gm.lineno
                        col: gm.colno
                    )
                }
                gi = gi.next
            }
        }
    }

    # checkGenericParamCasing -- flag a generic parameter whose first character's
    # case differs from its bound's. A bound with no base name is skipped rather
    # than guessed at: answering for a shape the reader could not read would be
    # reporting a check that never ran.
    checkGenericParamCasing: function {
        t: this ast: Ast.view nameRef: zast.nameid opId: zast.nodeid line: u32 col: u32
    } is {
        bnd: genericBoundBase :ast :opId
        if bnd.length == 0 then return
        nm: zast.nameTextAt :ast ref: nameRef
        if nm.length == 0 then return
        nUp: byteIsUpper b: (nm.stringView.byteAt i: 0)
        bUp: byteIsUpper b: (bnd.stringView.byteAt i: 0)
        if nUp == bUp then return
        want: flipFirstCase s: nm.stringView
        msg: "generic parameter '\{nm}' should be '\{want}' -- a parameter's case matches the case of its bound, and the bound is '\{bnd}'"
        (
            t.warn
            code: "L023"
            :msg
            :line
            :col
            width: nm.length
        )
    }

    # the root entry to the member-casing walk
    walkCasingProgram: function {t: this prog: Ast.view} is {
        {
            for each wcid: prog.units loop {
                t.walkCasingAt ast: prog nId: wcid
            }
        }
    }

    # walk -- the parse-tier rule visitor: the arms a rule reads are spelled,
    # then every child is visited through zast.childIds.
    walk: function {t: this ast: Ast.view n: astnode.view} is {
        # AN INFIX CALL IS THE OPERATOR SHAPE THESE RULES ARE WRITTEN FOR.
        # Read ahead of the match: an arm narrows `n` to its own row, and the
        # call arm cannot ask the node it came from.
        ipW: zast.infixPartsOf :ast :n
        if ipW.found then {
            t.checkMixedOperators :ast opId: ipW.operator lhsId: ipW.lhs
            t.checkBoolLiteralCompare :ast opId: ipW.operator lhsId: ipW.lhs rhsId: ipW.rhs
            if t.opts.arch then {
                t.checkLiteralCompare :ast opId: ipW.operator lhsId: ipW.lhs rhsId: ipW.rhs
            }
        }
        match (
            n
        ) case error then {
            d: (
                zdiag.errorDiag
                errv: n.err
                fsno: n.fsno
                lineno: n.lineno
                colno: n.colno
                width: n.width
                msg: (zast.poolTextCopy pool: ast.names ref: n.msg)
                note: (zast.poolTextCopy pool: ast.names ref: n.note)
                hint: (zast.poolTextCopy pool: ast.names ref: n.hint)
            )
            t.diags.append d
        } case call then {
            t.checkCollapseName :ast arguments: n.arguments
            (
                t.checkLiteralLookup
                :ast
                callable: (ast.nodes.get i: n.callable)
                arguments: n.arguments
            )
        } case atomstring then {
            if t.opts.arch then (
                t.checkComposedKey
                :ast
                parts: n.stringparts
                line: n.lineno
                col: n.colno
            )
        } case namedoperation then {
            if t.opts.complexity > 0 when t.funcDepth == 0 then {
                t.checkComplexity :ast nameId: n.name opId: n.operation
            }
            if t.opts.arch when t.funcDepth == 0 then {
                t.checkHandWalk :ast nameId: n.name opId: n.operation
            }
        } case forexpr then {
            t.checkImpliedIterate :ast :n
        } case objectdef then {
            t.checkReceiverNames :ast :n
        } case ifexpr then {
            t.checkEmpty :ast elseclauseId: n.elseclause clauses: n.clauses
            t.checkNestedIf :ast clauses: n.clauses elseclauseId: n.elseclause
        } case statement then {
            t.checkUnreachable :ast stmts: n.statements
            t.checkFlagAccumulator :ast stmts: n.statements
        } case functiondef then {
            if t.opts.arch then {
                (
                    t.checkLongFunction
                    :ast
                    bodyId: n.body
                    line: n.lineno
                    col: n.colno
                )
                t.checkWideSignature params: n.parameters line: n.lineno col: n.colno
            }
            # the body is walked one function deeper; the signature is not
            t.walkOptAt :ast oId: n.returntype
            t.walkIds :ast ids: n.parameters
            t.funcDepth = t.funcDepth + 1
            t.walkOptAt :ast oId: n.body
            t.funcDepth = t.funcDepth - 1
            t.walkIds :ast ids: n.asItems
            return
        } else null
        kl9: zast.childIds :ast :n
        for each c9: kl9 loop {
            t.walk :ast n: (ast.nodes.get i: c9)
        }
    }

    # walk a list of child nodes in order
    walkIds: function {t: this ast: Ast.view ids: zast.kidspan} is {
        for each c: (zast.kidsOf :ast span: ids) loop {
            t.walk :ast n: (ast.nodes.get i: c)
        }
    }

    # checkBoolLiteralCompare -- L028: a comparison with a boolean literal.
    # `X == false` / `X != true` is `X.not`, and `X == true` / `X != false` is
    # `X` itself, with the literal on either side. Both operator and literal
    # are matched by pool id; when both operands are literals the right one is
    # the literal, as it is when only the right one is.
    checkBoolLiteralCompare: function {
        t: this ast: Ast.view opId: zast.nodeid lhsId: zast.nodeid rhsId: zast.nodeid
    } is {
        opNm: zast.atomNameIdOf n: (ast.nodes.get i: opId)
        isEq: opNm == zast.wellKnown.slot.wkOpEq
        isNe: opNm == zast.wellKnown.slot.wkOpNe
        if isEq.not when isNe.not then return
        litNm: zast.atomNameIdOf n: (ast.nodes.get i: rhsId)
        reversed: false
        if (t.isBoolLiteralId nm: litNm).not then {
            litNm = zast.atomNameIdOf n: (ast.nodes.get i: lhsId)
            if (t.isBoolLiteralId nm: litNm).not then return
            reversed = true
        }
        isTrue: litNm == t.trueId
        isFalse: litNm == t.falseId
        neg: isEq and isFalse or (isNe and isTrue)
        litLen: 4.u64
        if isFalse then litLen = 5
        if reversed then {
            t.reportBoolLiteralCompareReversed :ast litId: lhsId operandId: rhsId :neg
            return
        }
        t.reportBoolLiteralCompare :ast :lhsId :opId :rhsId :neg :litLen
    }

    # isBoolLiteralId -- the name id is `true` or `false`.
    isBoolLiteralId: function {t: this.view nm: zast.nameid} out bool is {
        if nm.isZero then return false
        return (nm == t.trueId) or (nm == t.falseId)
    }

    # reportBoolLiteralCompareReversed -- L028 with the literal written first
    # (`false == b`). The fix rewrites the comparison, from the literal to the
    # operand's last byte, as the operand with `.not` appended for a negation.
    # It is offered only for a plain name or a dotted path of names, whose
    # extent the tree gives exactly (its first atom's start to its last atom's
    # end); any other operand is reported without a fix.
    reportBoolLiteralCompareReversed: function {
        t: this
        ast: Ast.view
        litId: zast.nodeid
        operandId: zast.nodeid
        neg: bool
    } is {
        lp: zast.posOf n: (ast.nodes.get i: litId)
        what: "`== true` / `!= false` is the value itself: drop the comparison".string
        if neg then what = "`== false` / `!= true` negates: write `.not`".string
        firstId: simplePathFirstAtom :ast id: operandId
        if firstId.isZero then {
            t.warn code: "L028" msg: what line: lp.line col: lp.col width: 1
            return
        }
        lastN: ast.nodes.get i: (simplePathLastAtom :ast id: operandId)
        fp: zast.posOf n: (ast.nodes.get i: firstId)
        ep: zast.posOf n: lastN
        lastLen: (zast.poolTextAt pool: ast.names ref: (zast.atomNameIdOf n: lastN)).length.u64
        srcOwned: t.source.copy
        srcv: srcOwned.stringView
        litLo: (
            tokByteStart
            lineStart: t.lineStart
            srcLines: t.lines
            lineno: lp.line
            colno: lp.col
        )
        xLo: (
            tokByteStart
            lineStart: t.lineStart
            srcLines: t.lines
            lineno: fp.line
            colno: fp.col
        )
        lastLo: (
            tokByteStart
            lineStart: t.lineStart
            srcLines: t.lines
            lineno: ep.line
            colno: ep.col
        )
        xHi: lastLo + lastLen
        if (xHi > srcv.length) or (xHi <= xLo) or (xLo <= litLo) then {
            t.warn code: "L028" msg: what line: lp.line col: lp.col width: 1
            return
        }
        xText: (srcv.substring from: xLo to: xHi).string
        suffix: ".not"
        if neg.not then suffix = ""
        (
            t.warnFix
            code: "L028"
            msg: what
            line: lp.line
            col: lp.col
            width: xHi - litLo
            lo: litLo
            hi: xHi
            repl: "\{xText}\{suffix}"
        )
    }

    # reportBoolLiteralCompare -- the L028 finding and its fix: the whole
    # comparison, from the operand's first byte to the literal's last, becomes
    # the operand (parenthesised when it is itself an unparenthesised binop)
    # with `.not` appended for a negation. A paren group's bytes are checked
    # against the tree; when they do not delimit, the finding is reported
    # without a fix so the gate still names the site.
    reportBoolLiteralCompare: function {
        t: this
        ast: Ast.view
        lhsId: zast.nodeid
        opId: zast.nodeid
        rhsId: zast.nodeid
        neg: bool
        litLen: u64
    } is {
        lhsN: ast.nodes.get i: lhsId
        lp: zast.posOf n: lhsN
        op: zast.posOf n: (ast.nodes.get i: opId)
        rp: zast.posOf n: (ast.nodes.get i: rhsId)
        srcOwned: t.source.copy
        srcv: srcOwned.stringView
        xStart: (
            tokByteStart
            lineStart: t.lineStart
            srcLines: t.lines
            lineno: lp.line
            colno: lp.col
        )
        opLo: (
            tokByteStart
            lineStart: t.lineStart
            srcLines: t.lines
            lineno: op.line
            colno: op.col
        )
        litLo: (
            tokByteStart
            lineStart: t.lineStart
            srcLines: t.lines
            lineno: rp.line
            colno: rp.col
        )
        litHi: litLo + litLen
        xHi: trimBackWs s: srcv hi: opLo
        xLo: xStart
        ok: litHi <= srcv.length
        if xHi <= xStart then ok = false
        # a parenthesised operand: the `)` ending it is partnered by a `(` at or
        # before where the tree positions the operand, with only openers between
        gs: parenGroupStart s: srcv close: xHi
        if gs > 0 when gs < xStart then {
            xLo = gs
            if (onlyOpensBetween s: srcv lo: gs + 1 hi: xStart).not then ok = false
        }
        what: "`== true` / `!= false` is the value itself: drop the comparison".string
        if neg then what = "`== false` / `!= true` negates: write `.not`".string
        if ok.not then {
            t.warn code: "L028" msg: what line: lp.line col: lp.col width: 1
            return
        }
        xText: (srcv.substring from: xLo to: xHi).string
        # an unparenthesised operand keeps its grouping in the fix text
        ipF: zast.infixPartsOf :ast n: lhsN
        if ipF.found then xText = "(\{xText})"
        suffix: ".not"
        if neg.not then suffix = ""
        (
            t.warnFix
            code: "L028"
            msg: what
            line: lp.line
            col: lp.col
            width: litHi - xLo
            lo: xLo
            hi: litHi
            repl: "\{xText}\{suffix}"
        )
    }

    # checkMixedOperators -- L032: `a op1 b op2 c` with op1 and op2 of different
    # kinds and no parentheses. Operators group left to right with no
    # precedence, so the left operand of op2 is `a op1 b` whatever the kinds;
    # the safe fix writes those parentheses. The tree does not record
    # parentheses, so the source says whether they are there: the operand is
    # grouped when the text before op2 ends in a `)` whose `(` opens just
    # before the operand.
    checkMixedOperators: function {t: this ast: Ast.view opId: zast.nodeid lhsId: zast.nodeid} is {
        inner: zast.infixPartsOf :ast n: (ast.nodes.get i: lhsId)
        if inner.found.not then return
        outerK: operatorKind :ast nid: opId
        innerK: operatorKind :ast nid: inner.operator
        if (outerK == 0) or (innerK == 0) or (outerK == innerK) then return
        if t.lineStart.length == 0 then return
        op: zast.posOf n: (ast.nodes.get i: opId)
        lp: zast.posOf n: (ast.nodes.get i: lhsId)
        opB: (
            tokByteStart
            lineStart: t.lineStart
            srcLines: t.lines
            lineno: op.line
            colno: op.col
        )
        lhsB: (
            tokByteStart
            lineStart: t.lineStart
            srcLines: t.lines
            lineno: lp.line
            colno: lp.col
        )
        srcOwned: t.source.copy
        sv: srcOwned.stringView
        endB: opB
        for endB > lhsB while (ascii.isSpace b: (docByteAt s: sv i: endB - 1)) loop endB = endB - 1
        if (groupedSpan :sv lo: lhsB hi: endB) then return
        outerNm: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: (ast.nodes.get i: opId))
        inn: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: (ast.nodes.get i: inner.operator))
        what: "`\{inn}` and `\{outerNm}` chained without parentheses: operators group left to right, so the `\{inn}` is taken first"
        t.warn code: "L032" msg: what line: op.line col: op.col width: outerNm.length
        t.edits.append (zfix.Edit byteLo: lhsB byteHi: lhsB replacement: "(".string)
        t.edits.append (zfix.Edit byteLo: endB byteHi: endB replacement: ")".string)
    }

    # checkImpliedIterate -- L029: `for each x: E.iterate` writes the call `each`
    # implies. The fix deletes `.iterate`: `each` asks a type's `iterate` before
    # anything else, so the header still walks the same member. When the byte
    # before the member is not its `.`, the finding is reported without a fix.
    checkImpliedIterate: function {t: this ast: Ast.view n: zast.forrow.view} is {
        if n.isEach.not then return
        if n.conditions.count.u64 == 0 then return
        c0: ast.nodes.get i: (zast.kidAt kids: ast.kids span: n.conditions i: 0)
        opId: zast.nodeid
        match (
            c0
        ) case namedoperation then {
            opId = c0.operation
        } else {
            return
        }
        chId: zast.nodeid
        opN: ast.nodes.get i: opId
        match (
            opN
        ) case dottedpath then {
            chId = opN.child
        } else {
            return
        }
        ch: ast.nodes.get i: chId
        match (
            ch
        ) case atomid then {
            if ch.name != zast.wellKnown.slot.wkIterate then return
        } else {
            return
        }
        cp: zast.posOf n: ch
        what: "`each` implies `.iterate`: drop it".string
        lo: (
            tokByteStart
            lineStart: t.lineStart
            srcLines: t.lines
            lineno: cp.line
            colno: cp.col
        )
        srcOwned: t.source.copy
        srcv: srcOwned.stringView
        hi: lo + 7
        # the tree matched the member by id; the bytes need only the `.` before
        # it, where the header's value ends and the call begins
        ok: false
        if lo > 0 when hi <= srcv.length then ok = (docByteAt s: srcv i: lo - 1) == ascii.dot
        if ok.not then {
            t.warn code: "L029" msg: what line: cp.line col: cp.col width: 7
            return
        }
        (
            t.warnFix
            code: "L029"
            msg: what
            line: cp.line
            col: cp.col
            width: 7
            lo: lo - 1
            :hi
            repl: String
        )
    }

    # checkReceiverNames -- L034: the methods of one type name their receiver
    # alike. The type's name for it is the one most of them declare (`:this`
    # aside); a method that declares another is reported.
    checkReceiverNames: function {t: this ast: Ast.view n: zast.objectdefrow.view} is {
        recvs: ListVal recvuse
        gatherReceivers :ast members: n.isItems :recvs
        gatherReceivers :ast members: n.asItems :recvs
        target: receiverNameOf :recvs
        if target.isZero then return
        for each r: recvs loop {
            if r.name != target then t.reportReceiver :ast :r :target
        }
    }

    # reportReceiver -- L034 for one method, whose receiver is declared `r.name`
    # where its type's methods say `target`. The fix is for the `:this`
    # shorthand only: it writes `target: this` and renames every read of `this`
    # in the body. A receiver with a name of its own is left to its author,
    # since a call may pass it by that name. The fix is also left out when the
    # rename could change what a name means (receiverScan, declaresName), and
    # when the text at a position is not the name the tree holds there.
    reportReceiver: function {t: this ast: Ast.view r: recvuse target: zast.nameid} is {
        pp: zast.posOf n: (ast.nodes.get i: r.param)
        oldTxt: zast.nameTextCopy :ast ref: r.name
        newTxt: zast.nameTextCopy :ast ref: target
        msg: "receiver `\{oldTxt}`: the other methods of this type name it `\{newTxt}`"
        width: oldTxt.length
        uses: ListVal zast.nodeid
        fixable: r.shorthand and (declaresName :ast fnId: r.fn name: target).not
        if fixable when r.body.notZero then {
            fixable = (receiverScan :ast id: r.body old: r.name :target :uses).not
        }
        # the byte offset of each read, checked against the source
        spots: ListVal u64
        plo: tokByteStart lineStart: t.lineStart srcLines: t.lines lineno: pp.line colno: pp.col
        if fixable then {
            srcv: t.source.stringView
            fixable = textAt s: srcv at: plo text: oldTxt.stringView
            for each uId: uses loop {
                up: zast.posOf n: (ast.nodes.get i: uId)
                ulo: (
                    tokByteStart
                    lineStart: t.lineStart
                    srcLines: t.lines
                    lineno: up.line
                    colno: up.col
                )
                if (textAt s: srcv at: ulo text: oldTxt.stringView).not then fixable = false
                spots.append from: ulo
            }
        }
        if fixable.not then {
            t.warn code: "L034" :msg line: pp.line col: pp.col :width
            return
        }
        # the shorthand is rewritten from its colon: `:this` to `t: this`
        (
            t.warnFix
            code: "L034"
            :msg
            line: pp.line
            col: pp.col
            :width
            lo: plo - 1
            hi: plo + width
            repl: "\{newTxt}: \{oldTxt}"
        )
        for each at: spots loop {
            t.edits.append (
                zfix.Edit
                byteLo: at
                byteHi: at + oldTxt.length
                replacement: newTxt.copy
            )
        }
    }

    # ---- architecture rules (zl lint --arch) ----

    # checkFlagAccumulator -- A009: a bool local bound to a literal and then set
    # to the other literal by two or more consecutive single-clause `if`
    # statements: a disjunction (or, from `true`, a conjunction) written as a
    # flag. Reported at the binding.
    checkFlagAccumulator: function {t: this ast: Ast.view stmts: zast.kidspan} is {
        if t.opts.arch.not then return
        n: stmts.count.u64
        i: u64
        for i < n loop {
            sid: zast.kidAt kids: ast.kids span: stmts :i
            i = i + 1
            fb: t.flagBindingAt :ast :sid
            if fb.name.isZero then continue
            other: t.trueId
            if fb.lit == t.trueId then other = t.falseId
            sets: u64
            j: i
            for j < n while (
                t.flagSetAt
                :ast
                sid: (zast.kidAt kids: ast.kids span: stmts i: j)
                name: fb.name
                lit: other
            ) loop {
                sets = sets + 1
                j = j + 1
            }
            if sets >= 2 then {
                p: zast.posOf n: (ast.nodes.get i: sid)
                fn: zast.nameTextAt :ast ref: fb.name
                (
                    t.info
                    code: "A009"
                    msg: "flag accumulator: `\{fn}` is bound to a literal and then set by \{sets} `if` statements; bind the `or` chain instead"
                    line: p.line
                    col: p.col
                    width: 1
                )
            }
        }
    }

    # flagBindingAt -- the flag binding a statement line holds (`name: true` /
    # `name: false`), or zeros for any other line.
    flagBindingAt: function {t: this.view ast: Ast.view sid: zast.nodeid} out flagbind is {
        n: ast.nodes.get i: (innerNodeIdOf :ast id: sid)
        match (
            n
        ) case assignment then {
            lit: t.boolLiteralAt :ast id: n.value
            if lit.isZero then return (flagbind name: zast.nameid lit: zast.nameid)
            return (flagbind name: n.name :lit)
        } else {
            return (flagbind name: zast.nameid lit: zast.nameid)
        }
    }

    # boolLiteralAt -- the pool id of `true` / `false` when the node at `id`, its
    # statement line peeled, is that literal; 0 otherwise.
    boolLiteralAt: function {t: this.view ast: Ast.view id: zast.nodeid} out zast.nameid is {
        nm: zast.atomNameIdOf n: (ast.nodes.get i: (innerNodeIdOf :ast :id))
        if nm.isZero then return nm
        if nm == t.trueId then return nm
        if nm == t.falseId then return nm
        return zast.nameid
    }

    # flagSetAt -- statement line `sid` is `if <cond> then <name> = <lit>`: one
    # clause, no else, a body of exactly that reassignment.
    flagSetAt: function {
        t: this.view ast: Ast.view sid: zast.nodeid name: zast.nameid lit: zast.nameid
    } out bool is {
        n: ast.nodes.get i: (innerNodeIdOf :ast id: sid)
        match (
            n
        ) case ifexpr then {
            if n.elseclause.notZero then return false
            if n.clauses.count.u64 != 1 then return false
            bodyId: singleLineBodyOf :ast clauseId: (zast.kidAt kids: ast.kids span: n.clauses i: 0)
            if bodyId.isZero then return false
            return (t.reassignsTo :ast id: bodyId :name :lit)
        } else {
            return false
        }
    }

    # reassignsTo -- the node at `id` is `name = <lit>`.
    reassignsTo: function {
        t: this.view ast: Ast.view id: zast.nodeid name: zast.nameid lit: zast.nameid
    } out bool is {
        n: ast.nodes.get i: id
        match (
            n
        ) case reassignment then {
            if (zast.atomNameIdOf n: (ast.nodes.get i: n.topath)) != name then return false
            return (t.boolLiteralAt :ast id: n.value) == lit
        } else {
            return false
        }
    }

    # checkNestedIf -- A010: an `if` with one clause and no else whose body is a
    # block holding exactly one `if` with one clause and no else: the two
    # conditions are one `when` chain. Reported at the inner `if`.
    checkNestedIf: function {
        t: this ast: Ast.view clauses: zast.kidspan elseclauseId: zast.nodeid
    } is {
        if t.opts.arch.not then return
        if elseclauseId.notZero then return
        if clauses.count.u64 != 1 then return
        innerId: singleLineBodyOf :ast clauseId: (zast.kidAt kids: ast.kids span: clauses i: 0)
        if innerId.isZero then return
        inner: ast.nodes.get i: innerId
        match (
            inner
        ) case ifexpr then {
            if inner.elseclause.notZero then return
            if inner.clauses.count.u64 != 1 then return
            (
                t.info
                code: "A010"
                msg: "nested `if` with nothing else in the outer body: chain the conditions with `when`".string
                line: inner.lineno
                col: inner.colno
                width: 2
            )
        } else null
    }

    # checkLiteralCompare -- A001: `==` / `!=` against a string literal. The
    # compiler compares by id -- a name id, a declaration, a type id -- and a
    # literal here is a name the code resolves by spelling.
    checkLiteralCompare: function {
        t: this ast: Ast.view opId: zast.nodeid lhsId: zast.nodeid rhsId: zast.nodeid
    } is {
        op: zast.atomNameIdOf n: (ast.nodes.get i: opId)
        isCmp: (op == zast.wellKnown.slot.wkOpEq) or (op == zast.wellKnown.slot.wkOpNe)
        if isCmp.not then return
        t.literalCompareSide :ast id: lhsId
        t.literalCompareSide :ast id: rhsId
    }

    # one side of a comparison, answering whether it is a string literal --
    # which is what A001 reports
    literalCompareSide: function {t: this ast: Ast.view id: zast.nodeid} is {
        n: ast.nodes.get i: id
        txt: plainLiteralText :ast :n
        if txt.some then {
            p: zast.posOf :n
            (
                t.info
                code: "A001"
                msg: "string literal `\{txt}` compared by spelling; compare an id (name id, declaration, type id)"
                line: p.line
                col: p.col
                width: 1
            )
        }
    }

    # checkLiteralLookup -- A011, under --arch: a string literal handed to one
    # of the compiler's name-lookup functions (lookupFn): the name is looked up
    # by its spelling where the compiler should read a well-known id.
    checkLiteralLookup: function {
        t: this ast: Ast.view callable: astnode.view arguments: zast.kidspan
    } is {
        if t.opts.arch.not then return
        leaf: zast.atomNameIdOf n: callable
        if callable.dottedpath then leaf = zast.atomNameIdOf n: (ast.nodes.get i: callable.child)
        if leaf.isZero then return
        fw: t.lookupWords.slotOf text: (zast.nameTextAt :ast ref: leaf).stringView
        if fw == t.lookupWords.none then return
        for each aId: (zast.kidsOf :ast span: arguments) loop {
            t.literalLookupArg :ast :aId
        }
    }

    # literalLookupArg -- one argument of a name lookup: A011 when its value is a
    # string literal
    literalLookupArg: function {t: this ast: Ast.view aId: zast.nodeid} is {
        a: ast.nodes.get i: aId
        vId: aId
        if a.namedoperation then vId = a.operation
        v: ast.nodes.get i: vId
        txt: plainLiteralText :ast n: v
        if txt.some then {
            p: zast.posOf n: v
            (
                t.info
                code: "A011"
                msg: "string literal `\{txt}` looked up by spelling; read its well-known id (zast.wellKnown) or the declaration"
                line: p.line
                col: p.col
                width: 1
            )
        }
    }

    # checkComposedKey -- A002: a string literal shaped like a composed key
    # (holes joined by a separator) -- a spelling that stands in for a tree
    # walk or a pair key.
    checkComposedKey: function {t: this ast: Ast.view parts: zast.kidspan line: u32 col: u32} is {
        if (isComposedParts :ast :parts).not then return
        (
            t.info
            code: "A002"
            msg: "composed string :key the table by ids (a pair record, or walk the tree)".string
            :line
            :col
            width: 1
        )
    }

    # checkUnreachable -- L026: a statement after one that leaves its block
    # (`return`, `break`, `continue`), or after a bare `for loop` nothing breaks
    # out of, can never run. Reported once per block, at the first statement
    # past it.
    checkUnreachable: function {t: this ast: Ast.view stmts: zast.kidspan} is {
        i: u64
        n: stmts.count.u64
        for i < n loop {
            sid: zast.kidAt kids: ast.kids span: stmts :i
            i = i + 1
            if i < n then {
                msg: String
                if (lineLeavesBlock :ast id: sid) then {
                    msg = "unreachable statement: the block has already returned or jumped".string
                }
                if (lineIsEndlessLoop :ast id: sid) then {
                    msg = "unreachable statement: the loop before it never finishes".string
                }
                if msg.length > 0 then {
                    p: zast.posOf n: (ast.nodes.get i: (zast.kidAt kids: ast.kids span: stmts :i))
                    t.warn code: "L026" :msg line: p.line col: p.col width: 1
                    return
                }
            }
        }
    }

    # checkWideSignature -- A014: a function head that declares
    # wideSignatureParams parameters or more, the receiver among them.
    checkWideSignature: function {t: this params: zast.kidspan line: u32 col: u32} is {
        n: params.count
        if n < wideSignatureParams then return
        (
            t.info
            code: "A014"
            msg: "function declares \{n} parameters; pass the ones that travel together as one value"
            :line
            :col
            width: 1
        )
    }

    # checkLongFunction -- A005: a function whose body spans more than
    # longFunctionLines source lines, measured from the definition to the
    # deepest statement it reaches (one line above the closing brace). A body
    # that is one `match` is exempt: splitting a dispatcher hides the shape it
    # exists to show.
    checkLongFunction: function {t: this ast: Ast.view bodyId: zast.nodeid line: u32 col: u32} is {
        if bodyId.isZero then return
        if (bodyIsOneMatch :ast :bodyId) then return
        lastLine: zast.spanEndLineAt :ast id: bodyId
        span: lastLine - line + 1
        if span > longFunctionLines then {
            (
                t.info
                code: "A005"
                msg: "function spans \{span} lines; split it into named helpers"
                :line
                :col
                width: 1
            )
        }
    }

    # checkComplexity -- A008: a function whose cognitive complexity exceeds
    # the threshold, scored over its whole body with nested literals folded
    # in. The definition names it: unit-level functions and methods, which the
    # walk reaches at function depth zero.
    checkComplexity: function {t: this ast: Ast.view nameId: zast.nameid opId: zast.nodeid} is {
        if opId.isZero then return
        op: ast.nodes.get i: opId
        match (
            op
        ) case functiondef then {
            if op.body.isZero then return
            acc: CcState score: 0
            fn: fnself name: nameId recv: (receiverOf :ast fnId: opId).name
            ccVisit :ast id: op.body nesting: 0 :fn :acc
            if acc.score > t.opts.complexity then {
                nm: zast.poolTextAt pool: ast.names ref: nameId
                sc: acc.score
                th: t.opts.complexity
                (
                    t.warn
                    code: "A008"
                    msg: "function `\{nm}` has cognitive complexity \{sc} (threshold \{th})"
                    line: op.lineno
                    col: op.colno
                    width: 1
                    weight: sc - th
                )
                t.complexities.append (ComplexityFinding line: op.lineno fn: nm.copy score: sc)
            }
        } else null
    }

    # checkHandWalk -- A013: a function with a match of handWalkArms or more
    # arms that only recurse (hwMostArms). Such a function walks the children of
    # a value kind by kind, by hand, where one walk over the children serves
    # every kind with no work of its own. The definition names it, as for A008.
    checkHandWalk: function {t: this ast: Ast.view nameId: zast.nameid opId: zast.nodeid} is {
        if opId.isZero then return
        op: ast.nodes.get i: opId
        match (
            op
        ) case functiondef then {
            if op.body.isZero then return
            fn: fnself name: nameId recv: (receiverOf :ast fnId: opId).name
            most: hwMostArms :ast id: op.body :fn
            if most >= handWalkArms then {
                nm: zast.poolTextAt pool: ast.names ref: nameId
                (
                    t.info
                    code: "A013"
                    msg: "function `\{nm}` has \{most} match arms that only recurse into parts of the value; walk the children in one arm (zast.childCount and zast.childAt read a node's) and keep arms only for the kinds that do work of their own or skip a child"
                    line: op.lineno
                    col: op.colno
                    width: 1
                )
            }
        } else null
    }

    # walkCasingAt -- the id-taking entry for the casing visitor.
    walkCasingAt: function {t: this ast: Ast.view nId: zast.nodeid} is {
        n: ast.nodes.get i: nId
        t.walkCasing :ast :n
    }

    # walkCasing -- opt-in (L009): recurse to every type definition and check the member
    # casing of `variant` / `union` declarations. Runs only under `zl lint --casing`.
    walkCasing: function {t: this ast: Ast.view n: astnode.view} is {
        match (
            n
        ) case program then {
            it: ast.units.iterate
            for uId: it loop t.walkCasing :ast n: (ast.nodes.get i: uId)
        } case unitdef then {
            for each bId: (zast.kidsOf :ast span: n.body) loop {
                t.walkCasing :ast n: (ast.nodes.get i: bId)
            }
        } case namedoperation then {
            t.walkCasing :ast n: (ast.nodes.get i: n.operation)
        } case objectdef then {
            t.checkMemberCasing :ast kind: n.kind items: n.isItems
        } else null
    }

    # checkMemberCasing -- flag each variant/union arm whose name starts with an uppercase
    # letter (not lowerCamelCase), with a suggested rename (see casingSuggest/casingMessage).
    checkMemberCasing: function {
        t: this ast: Ast.view kind: zast.objectkind items: zast.kidspan
    } is {
        isVU: (
            (kind == zast.objectkind.variantDef) or
            (kind == zast.objectkind.unionDef) or
            (kind == zast.objectkind.choiceDef)
        )
        if isVU.not then return
        for each itemId: (zast.kidsOf :ast span: items) loop {
            item: ast.nodes.get i: itemId
            if item.namedoperation then {
                isTypeRef: false
                match (
                    ast.nodes.get i: item.operation
                ) case labelvalue then {
                    isTypeRef = true
                } else null
                nm: zast.nameTextAt :ast ref: item.name
                fb: nm.stringView.byteAt i: 0
                up: false
                if fb.some when (ascii.isUpper b: fb) then up = true
                if up when isTypeRef.not then {
                    sug: casingSuggest name: nm.stringView
                    (
                        t.warn
                        code: "L009"
                        msg: (casingMessage orig: nm.stringView sug: sug.stringView)
                        line: item.lineno
                        col: item.colno
                        width: nm.length
                    )
                }
            }
        }
    }

    # checkPublicPosProgram -- L019 entry: check every unit's `public:` block placement.
    checkPublicPosProgram: function {t: this prog: Ast.view} is {
        {
            for each cuid: prog.units loop {
                t.checkPublicPosAt ast: prog nId: cuid
            }
        }
    }

    # checkPublicPosAt -- L019: a unit's `public:` block must sit at the top,
    # before any definition (only the file header comment may precede it).
    checkPublicPosAt: function {t: this ast: Ast.view nId: zast.nodeid} is {
        wn: ast.nodes.get i: nId
        if wn.namedoperation then {
            ud: ast.nodes.get i: wn.operation
            if ud.unitdef then {
                sawDef: false
                for each cbId: (zast.kidsOf :ast span: ud.body) loop {
                    mn: ast.nodes.get i: cbId
                    if mn.namedoperation then {
                        isPub: zast.unitOpKindIs :ast opId: mn.operation k: zast.unitkind.publicNs
                        if isPub when sawDef then {
                            (
                                t.warn
                                code: "L019"
                                msg: "the public interface block must be at the top of the unit, before any definition".string
                                line: mn.lineno
                                col: mn.colno
                                width: 6
                            )
                        }
                        if isPub.not then sawDef = true
                    }
                }
            }
        }
    }

    # hasDocAbove -- true when the source line directly above `line1` (1-based)
    # is a `#` comment line -- the start of a leading doc block.
    hasDocAbove: function {t: this.view line1: u32} out bool is {
        result: false
        if line1 < 2 then return result
        idx: (line1 - 2).u64
        if idx >= t.lines.length then return result
        ln: t.lines.get i: idx
        lv: ln.stringView
        lt: lv.trim
        if lt.startsWith "#" then result = true
        return result
    }

    # reportUndocDef -- warn L016 when a definition (type / function / method) has
    # no leading `#` doc block. `nameRef` gives the underline width.
    reportUndocDef: function {t: this ast: Ast.view nameRef: zast.nameid line: u32 col: u32} is {
        if (t.hasDocAbove line1: line) then return
        nm: zast.nameTextAt :ast ref: nameRef
        (
            t.warn
            code: "L016"
            msg: "missing doc comment: add a `#` comment above this definition".string
            :line
            :col
            width: nm.length
        )
    }

    # checkDocsMember -- a parameter or field counts as documented by a leading
    # `#` block or a trailing `#` on its own line; warn `code`/`kind` otherwise.
    checkDocsMember: function {
        t: this ast: Ast.view member: astnode.view code: StringView kind: StringView
    } is {
        if member.namedoperation when member.name != zast.wellKnown.slot.wkThis then {
            documented: false
            if (t.hasDocAbove line1: member.lineno) then documented = true
            if documented.not then {
                li: (member.lineno - 1).u64
                if li < t.lines.length then {
                    mline: t.lines.get i: li
                    if (hasHash line: mline.stringView) then documented = true
                }
            }
            if documented.not then {
                msg: "missing doc comment: add a `#` comment above this \{kind}"
                (
                    t.warn
                    :code
                    :msg
                    line: member.lineno
                    col: member.colno
                    width: (zast.nameTextAt :ast ref: member.name).length
                )
            }
            if documented when t.opts.docsQuality then {
                t.reportDocEcho :ast nameRef: member.name line: member.lineno col: member.colno
            }
        }
    }

    # docBlockAbove -- the contiguous `#` block directly above `line1`, markers dropped
    # and lines joined by spaces; "" when there is none. This is the same block hover
    # renders, so a rule reading it judges what a reader actually sees.
    docBlockAbove: function {t: this.view line1: u32} out String is {
        buf: String
        if line1 < 2 then return buf
        lo: (line1 - 2).u64
        if lo >= t.lines.length then return buf
        last: t.lines.get i: lo
        if (docLineIsComment ln: last.stringView).not then return buf
        top: lo
        more: true
        for more loop {
            if top == 0 then {
                more = false
            } else {
                prev: t.lines.get i: top - 1
                if (docLineIsComment ln: prev.stringView) then {
                    top = top - 1
                } else more = false
            }
        }
        i: top
        for i <= lo loop {
            ln: t.lines.get :i
            trimmed: ln.stringView.trim
            body: trimmed.substring from: 1 to: trimmed.length
            if buf.length > 0 then buf.append " "
            buf.append s: body.trim
            i = i + 1
        }
        return buf
    }

    # reportDocEcho -- L024: every content word of the doc already appears in the
    # declaration it sits above, so the doc restates the name and the type instead of
    # saying why the thing exists. That is the bar a comment has to clear, made
    # mechanical, and it is also the cheapest way to satisfy a coverage ratchet -- the
    # corpus writes these without one, so the ratchet ships paired with this.
    reportDocEcho: function {t: this ast: Ast.view nameRef: zast.nameid line: u32 col: u32} is {
        li: (line - 1).u64
        if li >= t.lines.length then return
        doc: t.docBlockAbove line1: line
        # own the line: a live view into this.lines would hold a shared lock across the
        # warn below, which needs the receiver exclusively.
        decl: (t.lines.get i: li).copy
        if (docStartsLine ln: decl.stringView :col).not then return
        if doc.length == 0 then doc = docTrailingComment ln: decl.stringView
        if doc.length == 0 then return
        vocab: List String
        docVocabInto s: (docStripComment ln: decl.stringView) into: vocab
        words: List String
        docWordsInto s: doc.stringView into: words
        novel: u64
        for each w: words loop {
            if (docIsStopword w: w.stringView).not when (docHasWord xs: vocab w: w.stringView
            ).not then novel = novel + 1
        }
        if novel > 0 then return
        nm: zast.nameTextAt :ast ref: nameRef
        (
            t.warn
            code: "L024"
            msg: "this doc only re-says the declaration below it; say why it exists, or rename it so no comment is needed".string
            :line
            :col
            width: nm.length
        )
    }

    # reportDuplicateDocs -- L025: the same doc body on more than two definitions of
    # one unit family (familyFilesOf). A real invariant stated at forty sites is one
    # invariant and thirty-nine copies: state it once, in the unit header, and leave
    # the sites bare. Blocks under four words are section markers and separators, not
    # docs, and are not counted. Bodies are compared with the declaration's own words
    # and every width folded out, so "u8 to i16: every u8 fits i16" and its u16 twin
    # are one body. Each file reports the copies it holds.
    reportDuplicateDocs: function {t: this} is {
        keys: List String
        starts: ListVal u64
        docKeysOf lines: t.lines :keys :starts
        counts: MapRV String v: u64
        tallyDocKeys :keys into: counts
        family: familyFilesOf file: t.path.stringView
        own: familyIndexOf :family file: t.path.stringView
        fi: u64
        for fi < family.length loop {
            if fi != own then {
                rd: io.readText path: (family.get i: fi)
                match (
                    rd
                ) case ok then {
                    others: List String
                    otherStarts: ListVal u64
                    docKeysOf lines: (linesOf src: rd.stringView) keys: others starts: otherStarts
                    tallyDocKeys keys: others into: counts
                } case err then null
            }
            fi = fi + 1
        }
        where: "in this file".string
        if family.length > 1 then {
            topName: unitNameOf file: (family.get i: 0).stringView
            where = "in the files of unit `\{topName}`"
        }
        j: u64
        for j < keys.length loop {
            k: keys.get i: j
            c2: (counts.get key: k).or d: 0
            if c2 > 2 then {
                s2: starts.get i: j
                (
                    t.warn
                    code: "L025"
                    msg: "this doc body appears \{c2} times \{where}; state it once, in the unit header, and leave the sites bare"
                    line: (s2 + 1).u32.orPanic
                    col: 1
                    width: 1
                )
            }
            j = j + 1
        }
    }

    # walkDocsAsItem -- one as-block member. A generic parameter is a MEMBER a reader
    # hovers, so it reports L018 like a field or an arm; everything else in an as-block
    # is a nested definition to descend into. Both carriers of an as-block, a type's
    # and a function's, hand their members here.
    walkDocsAsItem: function {
        t: this
        ast: Ast.view
        m: astnode.view
        docs: bool
        docParams: bool
        docFields: bool
    } is {
        isGP: false
        if m.namedoperation when (zast.isGenericParamOp :ast opId: m.operation) then isGP = true
        if isGP then {
            if docFields then (
                t.checkDocsMember
                :ast
                member: m
                code: "L018"
                kind: "generic parameter"
            )
            return
        }
        t.walkDocs :ast n: m :docs :docParams :docFields
    }

    # reportDefDocs -- a definition's own two doc judgements: L016 when it
    # carries no doc block, and L024 when the block it carries only re-says the
    # declaration.
    reportDefDocs: function {t: this ast: Ast.view site: zast.namedsite docs: bool} is {
        if docs then t.reportUndocDef :ast nameRef: site.name line: site.line col: site.col
        if t.opts.docsQuality then (
            t.reportDocEcho
            :ast
            nameRef: site.name
            line: site.line
            col: site.col
        )
    }

    # checkDocsMembersIn -- checkDocsMember over every member of `span`, which
    # is the same walk for a parameter, a field and an arm; only the code and
    # the noun differ.
    checkDocsMembersIn: function {
        t: this
        ast: Ast.view
        span: zast.kidspan
        code: StringView
        kind: StringView
    } is {
        ids: zast.kidIds :ast :span
        for each mId: ids loop {
            t.checkDocsMember :ast member: (ast.nodes.get i: mId) :code :kind
        }
    }

    # walkDocsAsItems -- walkDocsAsItem over every member of `span`.
    walkDocsAsItems: function {
        t: this ast: Ast.view span: zast.kidspan docs: bool docParams: bool docFields: bool
    } is {
        ids: zast.kidIds :ast :span
        for each mId: ids loop {
            t.walkDocsAsItem :ast m: (ast.nodes.get i: mId) :docs :docParams :docFields
        }
    }

    # walkDocsIn -- descend into every member of `span` as a definition of its
    # own.
    walkDocsIn: function {
        t: this ast: Ast.view span: zast.kidspan docs: bool docParams: bool docFields: bool
    } is {
        ids: zast.kidIds :ast :span
        for each mId: ids loop {
            t.walkDocsAt :ast nId: mId :docs :docParams :docFields
        }
    }

    # walkDocsFunction -- a function definition: its own docs, its parameters'
    # docs, and each member of its `as` block.
    walkDocsFunction: function {
        t: this
        ast: Ast.view
        site: zast.namedsite
        params: zast.kidspan
        asItems: zast.kidspan
        docs: bool
        docParams: bool
        docFields: bool
    } is {
        t.reportDefDocs :ast :site :docs
        if docParams then (
            t.checkDocsMembersIn
            :ast
            span: params
            code: "L017"
            kind: "parameter"
        )
        t.walkDocsAsItems :ast span: asItems :docs :docParams :docFields
    }

    # walkDocsObject -- a type definition: its own docs, then its is-block read
    # according to what the kind keeps there, then each member of its `as`
    # block.
    walkDocsObject: function {
        t: this
        ast: Ast.view
        site: zast.namedsite
        okind: zast.objectkind
        isItems: zast.kidspan
        asItems: zast.kidspan
        docs: bool
        docParams: bool
        docFields: bool
    } is {
        t.reportDefDocs :ast :site :docs
        isRC: (
            (okind == zast.objectkind.recordDef) or
            (okind == zast.objectkind.classDef) or
            (okind == zast.objectkind.generatorDef)
        )
        isVU: (okind == zast.objectkind.variantDef) or (okind == zast.objectkind.unionDef)
        isPF: (okind == zast.objectkind.protocolDef) or (okind == zast.objectkind.facetDef)
        if docFields when isRC then (
            t.checkDocsMembersIn
            :ast
            span: isItems
            code: "L018"
            kind: "field"
        )
        # an arm reaches a reader the same way a field does -- hovered, one line
        # of prose -- so it is the same code with its own noun.
        if docFields when isVU then (
            t.checkDocsMembersIn
            :ast
            span: isItems
            code: "L018"
            kind: "arm"
        )
        # a protocol's and a facet's members are METHOD DECLARATIONS, which sit
        # in the is-block where a record keeps its fields. They are definitions,
        # so they descend to L016 rather than reporting as members.
        if isPF then t.walkDocsIn :ast span: isItems :docs :docParams :docFields
        t.walkDocsAsItems :ast span: asItems :docs :docParams :docFields
    }

    # walkDocsNamed -- a named definition, dispatched on what the name labels: a
    # function, a type, or a nested unit.
    walkDocsNamed: function {
        t: this ast: Ast.view site: zast.namedsite docs: bool docParams: bool docFields: bool
    } is {
        op: ast.nodes.get i: site.operation
        match (
            op
        ) case functiondef then {
            (
                t.walkDocsFunction
                :ast
                :site
                params: op.parameters
                asItems: op.asItems
                :docs
                :docParams
                :docFields
            )
        } case objectdef then {
            (
                t.walkDocsObject
                :ast
                :site
                okind: op.kind
                isItems: op.isItems
                asItems: op.asItems
                :docs
                :docParams
                :docFields
            )
        } case unitdef then {
            t.walkDocsUnit :ast body: op.body :docs :docParams :docFields
        } else null
    }

    # walkDocsUnit -- a unit definition: its public surface first, then every
    # member that surface admits.
    walkDocsUnit: function {
        t: this ast: Ast.view body: zast.kidspan docs: bool docParams: bool docFields: bool
    } is {
        pubSet: IdSet zast.nameid
        hasPub: unitPublicNames :ast :body into: pubSet
        # --docs-private measures the whole unit: a unit with a `public:` block
        # has no public surface to filter BY, so every member is walked. The
        # compiler's units export a handful of names each -- zemitterc exports 9
        # of 1,680 -- so without this the pass reports 0 and means nothing.
        if t.opts.docsPrivate then hasPub = false
        ids: zast.kidIds :ast span: body
        for each bId: ids loop {
            bsite: zast.namedSiteAt :ast nid: bId
            if (unitMemberIsWalkable :ast site: bsite :pubSet :hasPub) then (
                t.walkDocsAt
                :ast
                nId: bId
                :docs
                :docParams
                :docFields
            )
        }
    }

    # walkDocs -- opt-in doc-coverage pass. L016 flags a type/function/method with
    # no leading `#` block; L017 an undocumented parameter; L018 an undocumented
    # record/class field. Each tier is gated by its own flag.
    walkDocs: function {
        t: this ast: Ast.view n: astnode.view docs: bool docParams: bool docFields: bool
    } is {
        match (
            n
        ) case program then {
            wit: ast.units.iterate
            for uId: wit loop {
                t.walkDocsAt :ast nId: uId :docs :docParams :docFields
            }
        } case unitdef then {
            t.walkDocsUnit :ast body: n.body :docs :docParams :docFields
        } case namedoperation then {
            (
                t.walkDocsNamed
                :ast
                site: (
                    zast.namedsite
                    name: n.name
                    operation: n.operation
                    line: n.lineno
                    col: n.colno
                )
                :docs
                :docParams
                :docFields
            )
        } else null
    }

    # walkDocsAt -- the id-taking entry: the node view is this frame's, so the
    # program loop can lend prog without an outstanding view lock.
    walkDocsAt: function {
        t: this ast: Ast.view nId: zast.nodeid docs: bool docParams: bool docFields: bool
    } is {
        n: ast.nodes.get i: nId
        t.walkDocs :ast :n :docs :docParams :docFields
    }

    # walkDocsProgram -- root entry for the doc-coverage pass.
    walkDocsProgram: function {
        t: this prog: Ast.view docs: bool docParams: bool docFields: bool
    } is {
        {
            for each wdid: prog.units loop {
                t.walkDocsAt ast: prog nId: wdid :docs :docParams :docFields
            }
        }
    }

    # tryBareZeroInit -- L011 (typecheck tier): a zero/empty binding initializer
    # written as a literal (`"".string`, `0.u64`) where the bare type name
    # constructs the same value. Function-body binding initializers only:
    # record/class fields and parameter defaults keep literal values (a bare
    # type name there is an annotation), and reassignment right-hand sides
    # prefer the coerced bare literal (`x = 0`). The bare name is the system's
    # type only where, written in this unit, it reaches that type -- a unit's
    # own `String` or `u64` takes it -- so the rule says nothing elsewhere. The
    # replacement span is byte-verified against the expected source spelling
    # before any edit is recorded.
    tryBareZeroInit: function {t: this ast: Ast.view value: astnode.view st: zenv.ZSymbolTable} is {
        match (
            value
        ) case statementline then {
            t.tryBareZeroInit :ast value: (ast.nodes.get i: value.statementline) :st
        } case statement then {
            if value.statements.count.u64 == 1 then {
                s0Id: zast.kidAt kids: ast.kids span: value.statements i: 0
                t.tryBareZeroInit :ast value: (ast.nodes.get i: s0Id) :st
            }
        } case dottedpath then {
            repl: bareZeroTypeName :ast n: (ast.nodes.get i: value.child)
            if repl.length == 0 then return
            ptext: bareZeroParentText n: (ast.nodes.get i: value.parent)
            if ptext.length == 0 then return
            isStr: (ast.nodes.get i: value.parent).atomstring
            # `.string` is the one member whose bare type is not its own spelling
            childName: zast.atomNameIdOf n: (ast.nodes.get i: value.child)
            isStrRepl: childName == zast.wellKnown.slot.wkString
            if isStr when isStrRepl.not then return
            if isStr.not when isStrRepl then return
            sysId: zast.wellKnown.slot.tyString
            if isStrRepl.not then sysId = zast.atomNameIdOf n: (ast.nodes.get i: value.child)
            sysT: ztypecheck.stdTidRo :ast :st wk: sysId
            if sysT.isZero then return
            if (ztypecheck.bareNameReaches :st site: t.sufSite base: sysT).not then return
            pin: nodeInfoOf n: (ast.nodes.get i: value.parent)
            cin: nodeInfoOf n: (ast.nodes.get i: value.child)
            if pin.line != cin.line then return
            srcOwned: t.source.copy
            srcv: srcOwned.stringView
            lo: (
                tokByteStart
                lineStart: t.lineStart
                srcLines: t.lines
                lineno: pin.line
                colno: pin.col
            )
            cs: (
                tokByteStart
                lineStart: t.lineStart
                srcLines: t.lines
                lineno: cin.line
                colno: cin.col
            )
            hi: cs + repl.length
            if hi > srcv.length then return
            ctext: repl.copy
            if isStr then ctext = "string".string
            expect: "\{ptext}.\{ctext}"
            actual: srcv.substring from: lo to: hi
            if actual != expect then return
            wm: "zero/empty initializer: write the bare type name `\{repl}`"
            (
                t.warnFix
                code: "L011"
                msg: wm
                line: pin.line
                col: pin.col
                width: hi - lo
                :lo
                :hi
                :repl
            )
        } else null
    }

    # runFastChecks -- the fast-tier passes: parse-error/AST rules over the tree,
    # then the token rules over the source.
    runFastChecks: function {t: this n: Ast.view} is {
        t.lineStart = lineStartIndex src: t.source.stringView
        t.trueId = zast.wellKnown.slot.wkTrue
        t.falseId = zast.wellKnown.slot.wkFalse
        scanPool: zast.StringPool.create
        t.fastToks = tokenize.scan source: t.source.copy pool: scanPool
        t.walkProgram prog: n
        t.checkPublicPosProgram prog: n
        t.checkLeadingLabel
    }

    # sortEditsInPlace -- reorder the collected edits by byteLo so the applier and the diff
    # renderer see sorted, overlap-resolvable input.
    sortEditsInPlace: function {t: this} is {
        se: sortEdits edits: t.edits
        t.edits = se.take
    }

    # emitSuf -- L005: a redundant numeric suffix. The safe fix removes the `.` and the type
    # name (e.g. `5.i32` -> `5`); the context already pins the type.
    emitSuf: function {t: this ln: u32 col: u32 tname: StringView} is {
        srcOwned: t.source.copy
        sv: srcOwned.stringView
        lineStart: lineStartIndex src: sv
        srcLines: linesOf src: sv
        byteStart: tokByteStart :lineStart :srcLines lineno: ln colno: col
        lo: byteStart
        if byteStart > 0 then lo = byteStart - 1
        hi: byteStart + tname.length
        (
            t.warnFix
            code: "L005"
            msg: "redundant numeric suffix `.\{tname}`"
            line: ln
            :col
            width: tname.length
            :lo
            :hi
            repl: "".string
        )
    }

    # sufBinop -- a binop operand whose numeric suffix the other (non-literal, same-type)
    # operand makes redundant.
    sufBinop: function {
        ast: Ast.view
        t: this
        lhs: astnode.view
        rhs: astnode.view
        isCmp: bool
        st: zenv.ZSymbolTable.view
    } is {
        # a LEADING literal's suffix is load-bearing at arithmetic ops (the
        # bare form defaults i64 and mismatches); only comparisons coerce a
        # literal from either side, so only there can the lhs suffix be
        # redundant
        if isCmp then {
            ls: operandSuffix :ast n: lhs
            if ls.tname.length > 0 when (isAnchor :ast n: rhs tname: ls.tname.stringView :st) then {
                t.emitSuf ln: ls.line col: ls.col tname: ls.tname.stringView
            }
        }
        rs: operandSuffix :ast n: rhs
        if rs.tname.length > 0 when (isAnchor :ast n: lhs tname: rs.tname.stringView :st) then {
            t.emitSuf ln: rs.line col: rs.col tname: rs.tname.stringView
        }
    }

    # sufReassign -- a reassignment value whose suffix the target's type fixes.
    sufReassign: function {
        ast: Ast.view
        t: this
        topath: astnode.view
        value: astnode.view
        st: zenv.ZSymbolTable.view
    } is {
        vs: operandSuffix :ast n: value
        if vs.tname.length > 0 then {
            tn: typeNameOfNode n: topath :st
            if tn.length > 0 when tn.stringView == vs.tname then {
                t.emitSuf ln: vs.line col: vs.col tname: vs.tname.stringView
            }
        }
    }

    # emitConv -- L015 / L031 caret + safe fix: delete the `.member` conversion
    # span.
    emitConv: function {
        t: this
        ln: u32
        col: u32
        mname: StringView
        msg: String.take
        code: StringView
    } is {
        srcOwned: t.source.copy
        sv: srcOwned.stringView
        lineStart: lineStartIndex src: sv
        srcLines: linesOf src: sv
        byteStart: tokByteStart :lineStart :srcLines lineno: ln colno: col
        lo: byteStart
        if byteStart > 0 then lo = byteStart - 1
        hi: byteStart + mname.length
        (
            t.warnFix
            :code
            :msg
            line: ln
            :col
            width: mname.length
            :lo
            :hi
            repl: "".string
        )
    }

    # wideningRedundant -- L031: `x.T` where `x` is a builtin numeric, the
    # conversion only widens, and the destination is a `T` already: the checker
    # widens a builtin numeric losslessly by itself there. A lossy conversion
    # types as a Result, so a conversion that types as plain `T` is the lossless
    # one. A typedef does not widen implicitly and is never reported; neither is
    # a suffixed literal (`5.u32`), which is a literal's type, not a conversion.
    wideningRedundant: function {
        t: this
        ast: Ast.view
        opId: zast.nodeid
        destTid: ztypes.tid
        st: zenv.ZSymbolTable
    } is {
        if destTid.isZero then return
        cln: u32
        ccl: u32
        from: ztypes.tid
        mname: String
        {
            dpn: ast.nodes.get i: opId
            if dpn.dottedpath then {
                bn: ast.nodes.get i: dpn.parent
                chn: ast.nodes.get i: dpn.child
                if (isNumericLiteralNode :ast n: bn).not then {
                    from = ztyping.nodeTypeAt tbl: st.typing.nodeType nid: (nodeInfoOf n: bn).id
                    mname = zast.atomNameText :ast n: chn
                    ci: nodeInfoOf n: chn
                    cln = ci.line
                    ccl = ci.col
                }
            }
        }
        if from.isZero or (from == destTid) or (mname.length == 0) then return
        if (ztyping.nodeTypeAt tbl: st.typing.nodeType nid: opId) != destTid then return
        if (builtinNumericTid :ast :st tid: from).not then return
        if (builtinNumericTid :ast :st tid: destTid).not then return
        # a conversion is named for the type it makes; any other member that
        # types as a numeric -- `.bits`, `.length` -- is not one
        if (st.reg.nameOf tid: destTid).stringView != mname then return
        (
            t.emitConv
            ln: cln
            col: ccl
            mname: mname.stringView
            msg: "redundant conversion: `.\{mname}` only widens, and the destination is a \{mname} already"
            code: "L031"
        )
    }

    # convReturned -- wideningRedundant for a `return`, against the enclosing
    # function's declared return type.
    convReturned: function {
        t: this
        ast: Ast.view
        arguments: zast.kidspan
        st: zenv.ZSymbolTable
        funcretId: zast.nodeid
    } is {
        if (arguments.count.u64 != 1) or funcretId.isZero then return
        rarg: ast.nodes.get i: (zast.kidAt kids: ast.kids span: arguments i: 0)
        if rarg.namedoperation.not then return
        rt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: funcretId
        t.wideningRedundant :ast opId: rarg.operation destTid: rt :st
    }

    # slConvArg -- one call argument: flag a redundant StringLike conversion.
    # Direction A: `x.stringView` on a String base (free but pointless).
    # Direction B: `sv.string` on a StringView base -- allocates an
    # owned String the callee only borrows. Both fire only when the parameter
    # is a generic constrained StringLike (either string form is accepted
    # directly); B is skipped for a `.take` parameter (it keeps the value).
    slConvArg: function {
        t: this
        ast: Ast.view
        opId: zast.nodeid
        originTid: ztypes.tid
        pnameId: zast.nameid
        ptid: ztypes.tid
        strTid: ztypes.tid
        svTid: ztypes.tid
        st: zenv.ZSymbolTable.view
    } is {
        if (st.reg.isTypeParamOf tid: ptid).not then return
        gpn: st.reg.nameOf tid: ptid
        tk: st.typing.declIdOfType typeId: originTid
        cd: (
            st.reg.genericParamConstraintOf
            tdecl: tk
            paramName: (zast.poolFind pool: ast.names text: gpn.stringView)
        )
        if (cd.kind == ztypes.constraintkind.stringLike).not then return
        cn: String
        cnId: zast.nameid
        cln: u32
        ccl: u32
        bnid: zast.nodeid
        {
            dpn: ast.nodes.get i: opId
            if dpn.dottedpath then {
                chn: ast.nodes.get i: dpn.child
                cn = zast.atomNameText :ast n: chn
                cnId = zast.atomNameIdOf n: chn
                ci: nodeInfoOf n: chn
                cln = ci.line
                ccl = ci.col
                pnn: ast.nodes.get i: dpn.parent
                bni: nodeInfoOf n: pnn
                bnid = bni.id
            }
        }
        if cn.length == 0 then return
        if bnid.isZero then return
        bt: ztypes.tid
        bto: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: bnid
        if bto.notZero then bt = bto
        if bt.isZero then return
        if (ztypecheck.isStringViewMember nameId: cnId) when bt == strTid then {
            (
                t.emitConv
                ln: cln
                col: ccl
                mname: "stringView"
                msg: "redundant conversion: `.stringView` on a String argument (the parameter accepts StringLike)".string
                code: "L015"
            )
            return
        }
        isOwned: false
        if cnId == zast.wellKnown.slot.wkString then isOwned = true
        if isOwned when bt == svTid when (
            st.typing.declOwnershipIs
            parentTypeId: originTid
            nameId: pnameId
            own: ztypes.zparamownership.takeMode
        ).not then {
            (
                t.emitConv
                ln: cln
                col: ccl
                mname: cn.stringView
                msg: "redundant conversion: `.\{cn}` allocates an owned String the call only borrows (the parameter accepts StringLike)"
                code: "L015"
            )
        }
    }

    # paramIndexByLabel -- the index of the parameter named `label` among
    # `names`, or none.
    paramIndexByLabel: function {
        t: this.view
        names: (List String).view
        label: StringView
    } out optionval u64 is {
        pi: u64
        for pi < names.length loop {
            if (names.get i: pi).stringView == label then return (optionval.some pi)
            pi = pi + 1
        }
        return (optionval.none u64)
    }

    # firstNonReceiverParam -- the index of the first parameter that is not the
    # receiver -- `this`, or the type's recorded receiver name -- or none: the
    # parameter an elided first label binds.
    firstNonReceiverParam: function {
        t: this.view
        names: (List String).view
        nameIds: (ListVal zast.nameid).view
        thisPn: StringView
    } out optionval u64 is {
        pj: u64
        for pj < names.length loop {
            isRecv: (
                ((nameIds.get i: pj) == zast.wellKnown.slot.wkThis) or
                ((thisPn.length > 0) and (thisPn == (names.get i: pj)))
            )
            if isRecv.not then return (optionval.some pj)
            pj = pj + 1
        }
        return (optionval.none u64)
    }

    # slConvCall -- L015 over one call: resolve the callee's template and
    # check each argument's conversion shape against its parameter.
    slConvCall: function {
        t: this
        ast: Ast.view
        callNid: zast.nodeid
        callable: astnode.view
        arguments: zast.kidspan
        st: zenv.ZSymbolTable
        # the enclosing function's return type node, which a `return` answers to
        funcretId: zast.nodeid
    } is {
        ck: st.typing.callKind.get key: callNid
        if ck.some when ck.returnCall then {
            t.convReturned :ast :arguments :st :funcretId
            return
        }
        callee: ztypes.tid
        cInfo: nodeInfoOf n: callable
        co: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: cInfo.id
        if co.notZero then callee = co
        if callee.isZero then return
        # a construction's fields are its parameters
        if (takesArguments tt: (st.reg.typetypeOf typeId: callee)).not then return
        origin: callee
        go: st.reg.genericOriginOf tid: callee
        if go.notZero then origin = go
        thisPn: zast.poolTextAt pool: ast.names ref: (st.reg.thisParamNameIdOf tid: origin)
        names: List String
        ids: ListVal ztypes.tid
        nameIds: ListVal zast.nameid
        (
            ztypecheck.dataFieldNames
            :ast
            reg: st.reg
            typing: st.typing
            tid: origin
            :names
            :ids
            :nameIds
        )
        if names.length == 0 then return
        strTid: ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyString
        svTid: ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyStringView
        firstArg: true
        for each aId: (zast.kidsOf :ast span: arguments) loop {
            arg: ast.nodes.get i: aId
            if arg.namedoperation.not then continue
            an: zast.nameTextAt :ast ref: arg.name
            pidx: optionval.none u64
            if an.length > 0 then {
                pidx = t.paramIndexByLabel :names label: an.stringView
            } else if firstArg then {
                # the elided first label binds the first non-receiver param
                pidx = t.firstNonReceiverParam :names :nameIds thisPn: thisPn.stringView
            }
            firstArg = false
            if pidx.none then continue
            t.wideningRedundant :ast opId: arg.operation destTid: (ids.get i: pidx) :st
            (
                t.slConvArg
                :ast
                opId: arg.operation
                originTid: origin
                pnameId: (nameIds.get i: pidx)
                ptid: (ids.get i: pidx)
                :strTid
                :svTid
                :st
            )
        }
    }

    # sufNamedArg -- a named call/constructor argument whose suffix the parameter / field type
    # fixes.
    sufNamedArg: function {
        t: this ast: Ast.view arg: astnode.view calleeType: ztypes.tid st: zenv.ZSymbolTable.view
    } is {
        if arg.namedoperation then {
            an: zast.nameTextAt :ast ref: arg.name
            if an.length > 0 then {
                s: operandSuffix :ast n: (ast.nodes.get i: arg.operation)
                if s.tname.length > 0 then {
                    # a generic-origin param never anchors a defix: the
                    # suffix is what SELECTS the instantiation (the mono's
                    # concrete param type was inferred from this argument)
                    gorig: calleeType
                    goS: st.reg.genericOriginOf tid: calleeType
                    if goS.notZero then gorig = goS
                    if gorig != calleeType then {
                        opto: st.typing.declChildOfId parentTypeId: gorig nameId: arg.name
                        if opto.some when (st.reg.isTypeParamOf tid: opto) then return
                    }
                    pto: st.typing.declChildOfId parentTypeId: calleeType nameId: arg.name
                    if pto.some then {
                        ptn: st.reg.nameOf tid: pto
                        if ptn.stringView == s.tname then {
                            t.emitSuf ln: s.line col: s.col tname: s.tname.stringView
                        }
                    }
                }
            }
        }
    }

    # sufNamedArgReturn -- a return value whose suffix the enclosing function's return type
    # fixes.
    sufNamedArgReturn: function {t: this ast: Ast.view arg: astnode.view rtName: StringView} is {
        match (
            arg
        ) case namedoperation then {
            s: operandSuffix :ast n: (ast.nodes.get i: arg.operation)
            if s.tname.length > 0 when s.tname.stringView == rtName then {
                t.emitSuf ln: s.line col: s.col tname: s.tname.stringView
            }
        } else {
            s8: operandSuffix :ast n: arg
            if s8.tname.length > 0 when s8.tname.stringView == rtName then {
                t.emitSuf ln: s8.line col: s8.col tname: s8.tname.stringView
            }
        }
    }

    # sufCall -- redundant suffixes in a call: a `return` uses the enclosing function's return
    # type; otherwise each named argument's parameter type.
    sufCall: function {
        t: this
        ast: Ast.view
        callNid: zast.nodeid
        callable: astnode.view
        arguments: zast.kidspan
        st: zenv.ZSymbolTable.view
        funcretId: zast.nodeid
    } is {
        ck: st.typing.callKind.get key: callNid
        isRet: false
        if ck.some when ck.returnCall then isRet = true
        if isRet then {
            rtName: typeNameOfOptAt :ast oId: funcretId :st
            if rtName.length > 0 then {
                for each aId: (zast.kidsOf :ast span: arguments) loop {
                    (
                        t.sufNamedArgReturn
                        :ast
                        arg: (ast.nodes.get i: aId)
                        rtName: rtName.stringView
                    )
                }
            }
        } else {
            cInfo: nodeInfoOf n: callable
            co: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: cInfo.id
            if co.notZero then {
                for each aId: (zast.kidsOf :ast span: arguments) loop {
                    t.sufNamedArg :ast arg: (ast.nodes.get i: aId) calleeType: co :st
                }
            }
        }
    }

    # elideCall -- L003: a generic reference whose first argument carries its
    # template's first parameter name, a label the spec makes optional. The
    # template is the one the checker resolved -- a built-in or the program's
    # own -- and its first parameter is read from its declaration
    # (firstGenericParamId). A call whose callee is no type -- a function whose
    # result happens to be an instance -- is not a generic reference. The safe
    # fix deletes the label up to its value.
    elideCall: function {
        t: this
        # the project tree the linted unit was checked in
        ast: Ast.view
        # the call node, whose stamp is the instance the reference names
        callNid: zast.nodeid
        # the callee, stamped with the template or the instance
        callable: astnode.view
        # the reference's arguments, the first of which may carry the label
        arguments: zast.kidspan
        # the checked program whose stamps and templates the rule reads
        st: zenv.ZSymbolTable
    } is {
        if arguments.count == 0 then return
        inst: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: callNid
        if inst.isZero then return
        tmpl: st.reg.genericOriginOf tid: inst
        if tmpl.isZero then return
        ct: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: (zast.nodeIdOf n: callable)
        if ct != tmpl when ct != inst then return
        first: ztypecheck.firstGenericParamId :st templateId: tmpl
        if first.isZero then return
        arg: ast.nodes.get i: (zast.kidAt kids: ast.kids span: arguments i: 0)
        match (
            arg
        ) case namedoperation then {
            if arg.name != first then return
            if t.lineStart.length == 0 then t.lineStart = (
                lineStartIndex
                src: t.source.stringView
            )
            label: zast.nameTextAt :ast ref: arg.name
            # the edit is the label, its colon and the spaces after it, read
            # from the source: the value may open with a paren its node does
            # not start at
            srcOwned: t.source.copy
            sv: srcOwned.stringView
            lo: (
                tokByteStart
                lineStart: t.lineStart
                srcLines: t.lines
                lineno: arg.lineno
                colno: arg.colno
            )
            hi: lo + label.length + 1
            if hi > sv.length then return
            expect: "\{label}:"
            if (sv.substring from: lo to: hi) != expect then return
            for hi < sv.length while ((sv.byteAt i: hi).or d: 0) == ascii.space loop hi = hi + 1
            (
                t.warnFix
                code: "L003"
                msg: "redundant `\{label}:` label on a generic reference's first argument"
                line: arg.lineno
                col: arg.colno
                width: label.length + 1
                :lo
                :hi
                repl: "".string
            )
        } else null
    }

    # negatedTwin -- L033: a negated test whose type has the positive twin.
    # `x.isZero.not` where the type of `x` declares `notZero`, and `o.none.not`
    # on an option, whose other arm is `some`. The fix writes the twin over the
    # two names; it is offered only when one dot on one line joins them.
    negatedTwin: function {t: this ast: Ast.view n: zast.dottedpathrow st: zenv.ZSymbolTable} is {
        notAtom: ast.nodes.get i: n.child
        if (zast.atomNameIdOf n: notAtom) != zast.wellKnown.slot.wkNot then return
        inner: ast.nodes.get i: n.parent
        if inner.dottedpath.not then return
        testAtom: ast.nodes.get i: inner.child
        testId: zast.atomNameIdOf n: testAtom
        baseTid: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: inner.parent
        if baseTid.isZero then return
        twin: ""
        if testId == zast.wellKnown.slot.wkNone when (isOptionTid :ast :st tid: baseTid) then {
            twin = "some"
        }
        if testId == zast.wellKnown.slot.wkIsZero when (
            st.typing.declMemberIdOf
            parentTypeId: baseTid
            nameId: zast.wellKnown.slot.wkNotZero
        ).notZero then {
            twin = "notZero"
        }
        if twin.length == 0 then return
        testText: zast.poolTextAt pool: ast.names ref: testId
        testLen: testText.length.u32.orPanic
        tp: zast.posOf n: testAtom
        np: zast.posOf n: notAtom
        msg: "`\{testText}.not` has a positive twin: write `\{twin}`"
        if (np.line != tp.line) or (np.col != (tp.col + testLen + 1)) then {
            t.warn code: "L033" :msg line: tp.line col: tp.col width: testLen
            return
        }
        lo: (
            tokByteStart
            lineStart: t.lineStart
            srcLines: t.lines
            lineno: tp.line
            colno: tp.col
        )
        width: testLen + 4
        hi: lo + width
        t.warnFix code: "L033" :msg line: tp.line col: tp.col :width :lo :hi repl: twin.string
    }

    # walkSuf -- preorder over the subtree running the typecheck-based suffix check, threading
    # the enclosing function's return type for `return`s. The arms a check reads are spelled;
    # every child is visited through zast.childIds.
    walkSuf: function {
        t: this
        ast: Ast.view
        n: astnode.view
        uname: StringView
        st: zenv.ZSymbolTable
        funcretId: zast.nodeid
    } is {
        if (hiddenSubunitAt :ast :n) then return
        {
            ipS: zast.infixPartsOf :ast :n
            if ipS.found then {
                blS: ast.nodes.get i: ipS.lhs
                brS: ast.nodes.get i: ipS.rhs
                (
                    t.sufBinop
                    :ast
                    lhs: blS
                    rhs: brS
                    isCmp: (
                        ztypecheck.isComparisonOp
                        nameId: (zast.atomNameIdOf n: (ast.nodes.get i: ipS.operator))
                    )
                    :st
                )
            }
        }
        match (
            n
        ) case call then {
            (
                t.sufCall
                :ast
                callNid: n.nodeid
                callable: (ast.nodes.get i: n.callable)
                arguments: n.arguments
                :st
                :funcretId
            )
            (
                t.slConvCall
                :ast
                callNid: n.nodeid
                callable: (ast.nodes.get i: n.callable)
                arguments: n.arguments
                :st
                :funcretId
            )
            (
                t.elideCall
                :ast
                callNid: n.nodeid
                callable: (ast.nodes.get i: n.callable)
                arguments: n.arguments
                :st
            )
        } case reassignment then {
            tpn: ast.nodes.get i: n.topath
            rvn: ast.nodes.get i: n.value
            t.sufReassign :ast topath: tpn value: rvn :st
            rtt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: n.topath
            t.wideningRedundant :ast opId: n.value destTid: rtt :st
        } case assignment then {
            if t.sufFnDepth > 0 then (
                t.tryBareZeroInit
                :ast
                value: (ast.nodes.get i: n.value)
                :st
            )
        } case dottedpath then {
            t.negatedTwin :ast :n :st
        } case functiondef then {
            # the function's own return type is the funcret for everything below it
            t.walkSufRet :ast retId: n.returntype :uname :st
            t.walkSufIds :ast ids: n.parameters :uname :st funcretId: n.returntype
            t.sufFnDepth = t.sufFnDepth + 1
            t.walkSufOptAt :ast oId: n.body :uname :st funcretId: n.returntype
            t.sufFnDepth = t.sufFnDepth - 1
            t.walkSufIds :ast ids: n.asItems :uname :st funcretId: n.returntype
            return
        } else null
        sl9: zast.childIds :ast :n
        for each s9: sl9 loop {
            t.walkSuf :ast n: (ast.nodes.get i: s9) :uname :st :funcretId
        }
    }

    # walk a list of children for the numeric-suffix rule
    walkSufIds: function {
        t: this
        ast: Ast.view
        ids: zast.kidspan
        uname: StringView
        st: zenv.ZSymbolTable
        funcretId: zast.nodeid
    } is {
        for each c: (zast.kidsOf :ast span: ids) loop {
            t.walkSuf :ast n: (ast.nodes.get i: c) :uname :st :funcretId
        }
    }

    # walkSufOptAt -- the id-taking entry (0 = absent).
    walkSufOptAt: function {
        t: this
        ast: Ast.view
        oId: zast.nodeid
        uname: StringView
        st: zenv.ZSymbolTable
        funcretId: zast.nodeid
    } is {
        if oId.isZero then return
        o: ast.nodes.get i: oId
        t.walkSuf :ast n: o :uname :st :funcretId
    }

    # a functiondef returntype doubles as its own funcret: this frame lets
    # the two arguments share one root without aliasing one source path
    walkSufRet: function {
        t: this ast: Ast.view retId: zast.nodeid uname: StringView st: zenv.ZSymbolTable
    } is {
        if retId.isZero then return
        r: ast.nodes.get i: retId
        t.walkSuf :ast n: r :uname :st funcretId: retId
    }

    # lintSuffixUnit -- run the suffix check over the linted unit.
    lintSuffixUnit: function {t: this prog: Ast.view lu: LintedUnit.view st: zenv.ZSymbolTable} is {
        uk: ztypecheck.unitdefNodeId ast: prog nId: lu.op
        ut: (st.typing.unitTypesById.get key: uk).or d: ztypes.tid.zero
        t.sufSite = ztypes.declid
        if ut.notZero then t.sufSite = (
            ztypecheck.templateDeclOf
            reg: st.reg
            typing: st.typing
            tid: ut
        )
        (
            t.walkSuf
            ast: prog
            n: (prog.nodes.get i: lu.op)
            uname: lu.name.stringView
            :st
            funcretId: zast.nodeid
        )
    }

    # checkSuffix -- L005 (typecheck tier): build the project VFS, parse this file's unit in the
    # project, typecheck, and walk the typed tree for redundant numeric suffixes. A tier that
    # cannot run -- a root that is not a directory, a unit not found, a dependency that does not
    # parse -- is reported as an error naming why: `--full` never passes a file it did not check.
    checkSuffix: function {
        t: this
        srcdirs: (List String).view
        systemdir: StringView
        layer: zcheck.GenLayer.view
        uname: StringView
        # the file is a data file: its own directory is its first root, and
        # it is asked what a data file may not hold
        dataFile: bool
        # the prelude the parse shares (zparser.PreludeStore)
        prelude: zparser.PreludeStore
    } is {
        if (t.rootsReady :srcdirs :systemdir).not then return
        vfs: zcheck.newVfs
        # the roots as zc binds them, the first --src searched first
        own: suffixRoots :srcdirs file: t.path.stringView :dataFile
        roots: zcheck.buildRoots :vfs :systemdir srcdirs: own :layer
        rootid: roots.root
        p: zparser.Parser.create ext: (unitFileExt file: t.path.stringView)
        prog: p.parseShared :vfs :rootid mainUnitName: uname.string store: prelude
        # a failed parse names its error as the tree's root row. The test is a
        # call so no lock outlives it: typecheck below takes the tree.
        if (zast.isErrorAt ast: prog id: prog.root) then {
            t.reportUnparsedProject :prog :vfs :srcdirs :uname
        } else {
            # the unit this FILE is, found by the file and never by name: a
            # subunit is found inside its parent, and a same-named unit another
            # root answers is not this file
            self: t.selfFsnoOf :vfs :prog
            lu: lintedUnitOf :prog :self
            if lu.op.isZero then {
                mw: "no unit the roots load for '\{uname}' comes from this file (a subunit loads only when its parent names it)"
                (
                    t.reportTierSkipped
                    errv: zast.err.badReference
                    cause: mw.stringView
                    note: String
                    hint: projectHint
                )
                return
            }
            reg: ztypes.newRegistry
            st: (
                ztypecheck.typecheck
                program: prog
                :reg
                reach: ztypecheck.checkreach.mainUnit
                requireMain: false
                dumpRows: false
                filePaths: (ztypecheck.filePathsOf :vfs ast: prog)
            )
            if dataFile then zcheck.dataRefusals :prog :vfs :st
            t.reportTypeErrors :st :prog
            t.placeForeignDiags :vfs :self
            # the rules below read what the typecheck STAMPED. On a failed
            # typecheck that evidence is partial, so they would report from it
            # rather than about it. A data file's definitions are read by the
            # program that opens it, which no check here sees: none is unused
            if st.typing.errors.length == 0 then {
                t.lintSuffixUnit :prog :lu :st
                if dataFile.not then t.reportUnusedDefs :prog :lu :st
                t.reportUnusedVars :prog :lu :st
                t.reportViewableLocals :prog :lu :st
                if t.opts.arch then t.reportArch :prog :lu :st :srcdirs :systemdir
            }
        }
    }

    # rootsReady -- whether every root the typecheck tier registers is a
    # directory; a missing one is reported as the reason the tier did not run.
    rootsReady: function {t: this srcdirs: (List String).view systemdir: StringView} out bool is {
        cause: zcheck.missingRootCause :systemdir :srcdirs
        if cause.length == 0 then return true
        (
            t.reportTierSkipped
            errv: zast.err.ioError
            cause: cause.stringView
            note: String
            hint: projectHint
        )
        return false
    }

    # reportUnparsedProject -- the project parse failed, so the typecheck tier
    # did not run: this unit is under no src root, or a unit it loads does not
    # parse. A parse error in the file itself is already the fast tier's report.
    reportUnparsedProject: function {
        t: this
        prog: Ast.view
        vfs: zvfs.ZVfs
        srcdirs: (List String).view
        uname: StringView
    } is {
        if t.parseErrorCount > 0 then return
        progRoot: prog.nodes.get i: prog.root
        match (
            progRoot
        ) case error then {
            e: zast.errorDataOf ast: prog row: progRoot
            if e.lineno == 0 when e.err.badReference then {
                roots: String
                for each r: srcdirs loop {
                    if roots.length > 0 then roots.append ", "
                    roots.append r
                }
                mu: "unit '\{uname}' is under none of the src roots (\{roots})"
                (
                    t.reportTierSkipped
                    errv: e.err
                    cause: mu.stringView
                    note: String
                    hint: projectHint
                )
                return
            }
            where: String
            if e.fsno.notZero then {
                path: vfs.displayPath dentryid: e.fsno
                at: "in \{path} at line \{e.lineno}: "
                where.append at
            }
            where.append (zast.errorLine :e)
            (
                t.reportTierSkipped
                errv: e.err
                cause: "a unit it loads does not parse"
                note: where.take
                hint: projectHint
            )
        } else null
    }

    # reportTierSkipped -- the typecheck tier did not run for this file: an
    # error naming why, and what names the piece it could not find.
    reportTierSkipped: function {
        t: this
        errv: zast.err
        cause: StringView
        note: String.take
        # what names the missing piece
        hint: StringView
    } is {
        msg: "the typecheck tier (--full) did not run: \{cause}"
        d: (
            zdiag.errorDiag
            :errv
            fsno: zvfs.fsno
            lineno: 0
            colno: 0
            width: 0
            msg: msg.take
            :note
            hint: hint.string
        )
        t.diags.append d
    }

    # placeForeignDiags -- a diagnostic the typecheck found in another file than
    # this one names that file and shows its line. The project's file system
    # is gone once the tier returns, so each is placed now.
    placeForeignDiags: function {t: this vfs: zvfs.ZVfs.view self: zvfs.fsno} is {
        n: t.diags.length
        i: u64
        for i < n loop {
            f: (t.diags.get :i).fsno
            ln: (t.diags.get :i).lineno
            if f.notZero when (f == self).not then {
                fp: vfs.displayPath dentryid: f
                srcLine: String
                hasLine: false
                if ln > 0 then {
                    got: vfs.getline dentryid: f lineno: ln.u64 - 1
                    if got.some then {
                        srcLine = got.take
                        hasLine = true
                    }
                }
                at: DiagSrc path: fp.take line: srcLine.take :hasLine
                t.elsewhere.set key: i.u32.orPanic value: at.take
            }
            i = i + 1
        }
    }

    # selfFsnoOf -- the fsno the parse gave THIS file: the loaded file that is
    # the same filesystem object as its path, so two spellings of one path
    # agree. 0 when the parse did not load it.
    selfFsnoOf: function {t: this.view vfs: zvfs.ZVfs.view prog: Ast.view} out zvfs.fsno is {
        found: zvfs.fsno
        for each f: prog.files loop {
            if found.isZero then {
                fp: vfs.pathfromproviderNative dentryid: f
                if (sameFile a: fp.stringView b: t.path.stringView) then found = f
            }
        }
        return found
    }

    # reportTypeErrors -- the typecheck's own diagnostics. This tier already
    # runs a COMPLETE eager typecheck, because its rules read what that run
    # stamps; these are what the same run found. Compilation is demand-driven
    # from `main`, so a definition nothing demands is walked by no build: this
    # is where its errors are reported. `requireMain: false` is why this works
    # on a unit that is not a program.
    # A typecheck error stamps fsno 0, so its file is the one its node is in,
    # as zc reads it; 0 still (this file) when it names no node.
    reportTypeErrors: function {t: this st: zenv.ZSymbolTable.view prog: Ast.view} is {
        for each er: st.typing.errors loop {
            ef: er.fsno
            if ef.isZero when er.nodeid.notZero then ef = prog.fsnoForNode nodeid: er.nodeid
            d: (
                zdiag.errorDiag
                errv: er.err
                fsno: ef
                lineno: er.lineno
                colno: er.colno
                width: er.width
                msg: er.msg.copy
                note: er.note.copy
                hint: er.hint.copy
            )
            t.diags.append d
        }
    }

    # reportArch -- the typecheck-tier architecture rules. A003: a `==` / `!=`
    # in this unit against a literal that spells a unit or type name of the
    # program -- routing by the name of a thing that has an id. A004: a record
    # or class field of this unit that no dotted read in the PROJECT reaches --
    # every `.z` under --src and --system is parsed for its member reads, so the
    # evidence does not depend on which program happens to be compiled here, and
    # a field is reported where it is declared. Units under --system are exempt
    # (a library's surface is not dead for being unread by one project), as are
    # native types (their fields are the runtime's to read). The read evidence
    # is by name: conservative, so a same-named field elsewhere hides a hit
    # rather than inventing one.
    reportArch: function {
        t: this
        prog: Ast.view
        lu: LintedUnit.view
        st: zenv.ZSymbolTable.view
        srcdirs: (List String).view
        systemdir: StringView
    } is {
        t.reportMissingPublic ast: prog :lu
        {
            mainOp: lu.op
            uname: lu.name.stringView
            namedIds: IdSet zast.nameid
            {
                # row 0 is the no-declaration sentinel
                di: ztypes.declid.zero.next
                for di < st.typing.nextDecl loop {
                    d: st.typing.decls.get i: di
                    isNamed: d.kind.unitDecl
                    if d.kind.typeDecl then isNamed = true
                    if isNamed then namedIds.add item: d.name
                    di = di.next
                }
            }
            t.archWalk ast: prog nId: mainOp :namedIds
            # A007 speaks only for a top-level unit that lives under one of the
            # roots; a subunit exports nothing past its parent
            inSrc: false
            if lu.names.length > 1 then return
            for each d: srcdirs loop {
                du: unitNamesIn dir: d.stringView
                if (du.contains item: uname.string) then inSrc = true
            }
            if inSrc.not then return
            t.reportUnusedExports ast: prog unitId: mainOp :uname :srcdirs
            readNames: Set String
            for each d2: srcdirs loop {
                projectReadNames dir: d2.stringView into: readNames
            }
            projectReadNames dir: systemdir into: readNames
            bodyIds: zast.unitBodyIdsAt ast: prog unitId: mainOp
            for each mId: (zast.kidsOf ast: prog span: bodyIds) loop {
                m: prog.nodes.get i: mId
                if m.namedoperation then {
                    tn: zast.poolTextAt pool: prog.names ref: m.name
                    t.archFields ast: prog opId: m.operation :readNames typeName: tn.stringView
                }
            }
        }
    }

    # reportMissingPublic -- A012: a file unit with no `public:` block. Its
    # surface is then every top-level definition, so L012 can judge none of
    # them unused. A subunit, hidden or inline, exports nothing past its
    # parent and is not asked.
    reportMissingPublic: function {t: this ast: Ast.view lu: LintedUnit.view} is {
        if lu.names.length != 1 then return
        bodyIds: zast.unitBodyIdsAt :ast unitId: lu.op
        for each mId: (zast.kidsOf :ast span: bodyIds) loop {
            m: ast.nodes.get i: mId
            if m.namedoperation when m.name == zast.wellKnown.slot.wkPublic then return
        }
        (
            t.info
            code: "A012"
            msg: "unit `\{lu.name}` has no `public:` block, so every definition is public; list what other units read, and L012 judges the rest"
            line: 1
            col: 1
            width: 1
        )
    }

    # reportUnusedExports -- A007: a name this unit's `public:` block exports
    # that no other unit under --src reads as `<unit>.<name>`. An export with
    # no importer is a private definition wearing a public label, and L012
    # cannot judge it until the label goes. Units under --system are exempt:
    # their exports serve examples, tests and the runtime's fragments, none
    # of them under --src. The read evidence is by name: conservative, so a
    # same-named read elsewhere hides a hit rather than inventing one.
    reportUnusedExports: function {
        t: this
        ast: Ast.view
        unitId: zast.nodeid
        uname: StringView
        srcdirs: (List String).view
    } is {
        reads: Set String
        for each d: srcdirs loop {
            projectUnitReads dir: d.stringView :uname into: reads
        }
        # the entry point is read by the loader, not by a unit
        mainId: zast.wellKnown.slot.wkMain
        bodyIds: zast.unitBodyIdsAt :ast :unitId
        for each mId: (zast.kidsOf :ast span: bodyIds) loop {
            m: ast.nodes.get i: mId
            if m.namedoperation when (
                zast.unitOpKindIs
                :ast
                opId: m.operation
                k: zast.unitkind.publicNs
            ) then {
                t.reportUnreadExportsIn :ast opId: m.operation :reads :mainId
            }
        }
    }

    # reportUnreadExportsIn -- each `:name` of one public block that `reads` lacks;
    # the block's items are the labels' named operations.
    reportUnreadExportsIn: function {
        t: this
        ast: Ast.view
        opId: zast.nodeid
        reads: (Set String).view
        mainId: zast.nameid
    } is {
        ud: ast.nodes.get i: opId
        if ud.unitdef then {
            for each lid: (zast.kidsOf :ast span: ud.body) loop {
                lv: ast.nodes.get i: lid
                if lv.namedoperation then {
                    nm: zast.poolTextAt pool: ast.names ref: lv.name
                    if (reads.has item: nm).not when lv.name != mainId then {
                        (
                            t.info
                            code: "A007"
                            msg: "export `\{nm}` is read by no other unit under --src; make it private and let L012 judge it"
                            line: lv.lineno
                            col: lv.colno
                            width: nm.length
                        )
                    }
                }
            }
        }
    }

    # archFields -- A004 over one record / class definition of this unit.
    archFields: function {
        t: this ast: Ast.view opId: zast.nodeid readNames: (Set String).view typeName: StringView
    } is {
        n: ast.nodes.get i: opId
        if n.objectdef then {
            isData: n.kind.recordDef
            if n.kind.classDef then isData = true
            if n.kind.generatorDef then isData = true
            if isData.not then return
            if n.isNative then return
            for each mId: (zast.kidsOf :ast span: n.isItems) loop {
                m: ast.nodes.get i: mId
                if m.namedoperation then {
                    mop: ast.nodes.get i: m.operation
                    fnm: zast.poolTextAt pool: ast.names ref: m.name
                    if mop.functiondef.not when (readNames.has item: fnm).not then {
                        (
                            t.warn
                            code: "A004"
                            msg: "field `\{typeName}.\{fnm}` is written and never read anywhere in the project"
                            line: m.lineno
                            col: m.colno
                            width: 1
                        )
                    }
                }
            }
        }
    }

    # archWalk -- A003 at every literal compare of the unit's subtree.
    archWalk: function {
        t: this ast: Ast.view nId: zast.nodeid namedIds: (IdSet zast.nameid).view
    } is {
        n: ast.nodes.get i: nId
        if (hiddenSubunitAt :ast :n) then return
        kids: zast.childIds :ast :n
        {
            ipA: zast.infixPartsOf :ast :n
            if ipA.found then {
                opA: zast.atomNameIdOf n: (ast.nodes.get i: ipA.operator)
                if (opA == zast.wellKnown.slot.wkOpEq) or (opA == zast.wellKnown.slot.wkOpNe) then {
                    t.archNamedLiteral :ast id: ipA.lhs :namedIds
                    t.archNamedLiteral :ast id: ipA.rhs :namedIds
                }
            }
        }
        for each c: kids loop {
            t.archWalk :ast nId: c :namedIds
        }
    }

    # a named argument whose value is a literal, which the composed-key rule
    # reads
    archNamedLiteral: function {
        t: this ast: Ast.view id: zast.nodeid namedIds: (IdSet zast.nameid).view
    } is {
        n: ast.nodes.get i: id
        txt: plainLiteralText :ast :n
        if txt.some then {
            nid: ast.names.find s: txt.stringView
            if nid.notZero when (namedIds.has item: nid) then {
                p: zast.posOf :n
                (
                    t.warn
                    code: "A003"
                    msg: "`\{txt}` names a unit or a type of the program; compare its declaration or type id, not its spelling"
                    line: p.line
                    col: p.col
                    width: 1
                )
            }
        }
    }

    # isBuiltinCarrierTid -- String, StringView or a container. `isReftypeOf`
    # says true for all of them, and `isNativeOf` splits them rather than naming
    # them: String and StringView are declared `class is native`, the containers
    # are plain classes. Compare against the builtin ids the way
    # isContainerReaderCall does.
    isBuiltinCarrierTid: function {
        t: this.view
        ast: Ast.view
        st: zenv.ZSymbolTable
        tid: ztypes.tid
    } out bool is {
        b: tid
        g: st.reg.genericOriginOf :tid
        if g.notZero then b = g
        if (
            b == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyString)
        ) then return true
        if (
            b == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyStringView)
        ) then return true
        if (
            b == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyListRef)
        ) then return true
        if (
            b == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyListView)
        ) then return true
        if (
            b == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyMapRR)
        ) then return true
        if (
            b == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyMapRV)
        ) then return true
        if (
            b == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyMapVR)
        ) then return true
        if (
            b == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyMapVV)
        ) then return true
        if (
            b == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tySetRef)
        ) then return true
        return b == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyBytes)
    }

    # reportUnmutatedParam -- L020. A USER reftype parameter that is mutable by
    # default and never mutated should declare `.view`: the marker is what lets
    # a caller keep reading its argument across the call, and without it a
    # forgotten `.view` surfaces as a lock conflict at a DISTANT call site.
    #
    # "Mutated" is not re-derived. The typechecker records `variableMutated` at
    # the two places that already enforce the question -- `lockCallArg` whenever
    # it takes a non-shared lock (every mutating receiver and every mutable
    # argument) and `checkWriteLock` (assignment and swap targets) -- so this
    # agrees with the lock rules by construction.
    reportUnmutatedParam: function {
        t: this
        ast: Ast.view
        st: zenv.ZSymbolTable
        fnOp: zast.nodeid
        vid: ztypes.vid
        nameRef: zast.nameid
        line: u32
        col: u32
    } is {
        if (st.reg.hasVariable id: vid).not then return
        vt: st.reg.variableTypeOf id: vid
        if vt.isZero then return
        if (st.reg.isReftypeOf tid: vt).not then return
        if (t.isBuiltinCarrierTid :ast :st tid: vt) then return
        ftid: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: fnOp
        if ftid.isZero then return
        own: st.typing.declOwnershipOfId parentTypeId: ftid nameId: nameRef
        mutable: true
        if own.some when own != ztypes.zparamownership.borrowMode then mutable = false
        if mutable.not then return
        pnm: zast.poolTextAt pool: ast.names ref: nameRef
        (
            t.info
            code: "L020"
            msg: "parameter '\{pnm}' is never mutated -- declare it `.view` so callers may keep reading the argument across the call"
            :line
            :col
            width: pnm.length
        )
    }

    # reportValtypeBorrowParam -- L030. An unmarked valtype parameter is a copy;
    # `.borrow` passes it by reference, so the callee can write the caller's
    # value (ownership.pdoc, Defaults). One the body never mutates pays for a
    # reference it does not use. Called only for a used, never-mutated
    # parameter: the evidence L020 reads, which records a pass to another
    # `.borrow` parameter too (markValtypeBorrowArg). A generic parameter is
    # not asked: its `.borrow` follows the type it is instantiated with.
    reportValtypeBorrowParam: function {
        t: this
        ast: Ast.view
        st: zenv.ZSymbolTable.view
        fnOp: zast.nodeid
        vid: ztypes.vid
        nameRef: zast.nameid
        line: u32
        col: u32
    } is {
        if (st.reg.hasVariable id: vid).not then return
        vt: st.reg.variableTypeOf id: vid
        if vt.isZero then return
        if (st.reg.typetypeOf typeId: vt) == ztypes.ztypetype.genericParam then return
        if (st.reg.isValtypeOf tid: vt).not then return
        ftid: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: fnOp
        if ftid.isZero then return
        own: st.typing.declOwnershipOfId parentTypeId: ftid nameId: nameRef
        ownM: own.or d: ztypes.zparamownership.noneMode
        if ownM != ztypes.zparamownership.borrowMode then return
        pnm: zast.poolTextAt pool: ast.names ref: nameRef
        (
            t.warn
            code: "L030"
            msg: "parameter '\{pnm}' is a value type the body never mutates -- drop `.borrow` to take a copy, or write `.view`"
            :line
            :col
            width: pnm.length
        )
    }

    # reportUnmutatedReceiver -- L027. A receiver written `:this` is mutable by
    # default; one the body never mutates should declare `t: this.view`, for
    # the reason L020 gives a parameter. The receiver's variable and the
    # `variableMutated` stamp are the same evidence L020 reads, so a call through
    # `this` to a mutating method counts, in both families: a valtype receiver
    # is passed by reference and locks exactly as a class receiver does. The
    # spelled forms (`this: this.view`, `b: this.borrow`) are not asked, and
    # neither is a method implementing a spec member: its receiver is the
    # spec's.
    reportUnmutatedReceiver: function {
        t: this
        ast: Ast.view
        st: zenv.ZSymbolTable.view
        fnOp: zast.nodeid
        opId: zast.nodeid
        line: u32
        col: u32
    } is {
        op: ast.nodes.get i: opId
        if op.labelvalue.not then return
        ftid: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: fnOp
        if ftid.notZero when (ztypecheck.methodImplementsSpec :st mid: ftid) then return
        vo: st.typing.defVariableId.get key: opId
        if vo.some then {
            if (st.typing.variableMutated.has item: vo) then return
            if (st.reg.hasVariable id: vo).not then return
            vt: (st.reg.variableTypeOf id: vo).u64
            if vt == 0 then return
            (
                t.warn
                code: "L027"
                msg: "receiver `this` is never mutated -- declare it `t: this.view` so callers may keep reading the object across the call".string
                :line
                :col
                width: 4
            )
        }
    }

    # warnUnusedParam -- L014: a parameter no read reaches.
    warnUnusedParam: function {t: this prog: Ast.view site: zast.namedsite} is {
        pnm: zast.poolTextAt pool: prog.names ref: site.name
        (
            t.warn
            code: "L014"
            msg: "parameter '\{pnm}' is never used (drop it with `\{pnm}.drop` if intentional)"
            line: site.line
            col: site.col
            width: pnm.length
        )
    }

    # reportParamAt -- one parameter. The receiver is exempt from the use test
    # and takes L027 instead, since what is judged of it is mutation rather than
    # use; every other parameter takes L020 when it is read but never written
    # and L014 when no read reaches it at all. The receiver of a generator's
    # `call` is not judged: the compiler supplies it, the source cannot write
    # it, and each resume writes the object through it.
    reportParamAt: function {
        t: this
        prog: Ast.view
        st: zenv.ZSymbolTable
        used: (IdSet ztypes.vid).view
        fop: zast.nodeid
        site: zast.namedsite
    } is {
        if site.operation.isZero then return
        pOpId: site.operation
        # the receiver is exempt: `:this` names it directly (zast.wellKnown.slot.wkThis);
        # a spelled `b: this.borrow` is receiver-shaped
        isRecv: site.name == zast.wellKnown.slot.wkThis
        if isRecv.not then isRecv = ztypecheck.paramIsThisReceiverId ast: prog opId: pOpId
        if isRecv then {
            if (ztypecheck.generatorCallOf typing: st.typing nid: fop).notZero then return
            (
                t.reportUnmutatedReceiver
                ast: prog
                :st
                fnOp: fop
                opId: pOpId
                line: site.line
                col: site.col
            )
            return
        }
        vo: st.typing.defVariableId.get key: pOpId
        if vo.some then {
            umut: st.typing.variableMutated.has item: vo
            if (used.has item: vo) when umut.not then {
                (
                    t.reportValtypeBorrowParam
                    ast: prog
                    :st
                    fnOp: fop
                    vid: vo
                    nameRef: site.name
                    line: site.line
                    col: site.col
                )
                (
                    t.reportUnmutatedParam
                    ast: prog
                    :st
                    fnOp: fop
                    vid: vo
                    nameRef: site.name
                    line: site.line
                    col: site.col
                )
            }
            if (used.has item: vo).not then t.warnUnusedParam :prog :site
        }
    }

    # reportParamsOf -- every parameter of one function definition.
    reportParamsOf: function {
        t: this
        prog: Ast.view
        st: zenv.ZSymbolTable
        used: (IdSet ztypes.vid).view
        fop: zast.nodeid
    } is {
        paramIds: fnParamIds :prog :fop
        for each pid: paramIds loop {
            t.reportParamAt :prog :st :used :fop site: (zast.namedSiteAt ast: prog nid: pid)
        }
    }

    # reportUnusedLocalAt -- L013: a local binding no read reaches. Only a
    # binding in the unit's OWN file is judged, which is what mainFsno says,
    # and only the template's: a generic instance's copy of the body reports
    # from its template's file and line, so it would repeat the template's.
    # This takes no symbol table on purpose: it runs with defVariableId pinned
    # by its own walk, and lending the table under that pin is the shape
    # usedDeclSet was rewritten to avoid.
    reportUnusedLocalAt: function {
        t: this
        prog: Ast.view
        used: (IdSet ztypes.vid).view
        mainFsno: zvfs.fsno
        # the rows made in the walks of generic instances (ztyping instanceRows)
        instanceRows: (ListVal ztyping.rowspan).view
        # the bindings a `for` writes, which are locals as an assignment's are:
        # each keyed by the expression it binds, which is what defines it
        loopBinds: (IdMapV zast.nodeid v: zast.nodeid).view
        nid: zast.nodeid
        vid: ztypes.vid
    } is {
        if (used.has item: vid) then return
        # a loop binding is defined by the expression it binds, or by the
        # `.iterate` the checker writes over that expression for `for each`
        srcId: loopBoundExpr :prog :loopBinds :nid
        bindId: (loopBinds.get key: srcId).or d: zast.nodeid
        if bindId.isZero then srcId = nid
        if (prog.fsnoForNode nodeid: srcId) != mainFsno then return
        if (ztyping.rowIsInstanceOwn spans: instanceRows open: zast.nodeid nid: srcId) then return
        nm: String
        ln: u32
        cl: u32
        okL: false
        {
            nodeL: prog.nodes.get i: nid
            match (
                nodeL
            ) case assignment then {
                nm = zast.poolTextCopy pool: prog.names ref: nodeL.name
                ln = nodeL.lineno
                cl = nodeL.colno
                okL = true
            } else null
        }
        if bindId.notZero then {
            nodeB: prog.nodes.get i: bindId
            match (
                nodeB
            ) case namedoperation then {
                nm = zast.poolTextCopy pool: prog.names ref: nodeB.name
                ln = nodeB.lineno
                cl = nodeB.colno
                okL = true
            } else null
        }
        if okL.not then return
        (
            t.warn
            code: "L013"
            msg: "local '\{nm}' is never used (drop it with `\{nm}.drop` if intentional)"
            line: ln
            col: cl
            width: nm.length
        )
    }

    # reportUnusedVars -- L014 (unused parameter) + L013 (unused local). A binding whose
    # variableId never appears as a use (atomVariableId) is dead. Params are walked from the
    # main unit's function defs (precise name/position; the receiver is exempt). Locals are the
    # assignment bindings in this file and the bindings a `for` writes. The opt-out is to end the
    # variable with `x.drop` on its own line (a name that owns nothing lowers to `(void)(x);`),
    # which stamps a use.
    reportUnusedVars: function {
        t: this prog: Ast.view lu: LintedUnit.view st: zenv.ZSymbolTable
    } is {
        used: usedVarSet :st wtgt: (writeTargetAtoms :prog)
        mainOp: lu.op
        fnOps: collectFnOps :prog :mainOp
        for each fop: fnOps loop {
            t.reportParamsOf :prog :st :used :fop
        }
        if fnOps.length == 0 then return
        mainFsno: prog.fsnoForNode nodeid: (fnOps.get i: 0)
        loopBinds: loopBindingIds :prog
        for each dv: st.typing.defVariableId.iterateItems loop {
            (
                t.reportUnusedLocalAt
                :prog
                :used
                :mainFsno
                instanceRows: st.typing.instanceRows
                :loopBinds
                nid: dv.key
                vid: dv.value
            )
        }
    }

    # srcIsFieldRead -- the conversion's source is a FIELD read (`ctx.mainName`)
    # rather than a local, a call, or a method chain. A field holds its bytes only
    # until something rebinds it, and any call in the local's live range may do
    # exactly that -- the save/restore idiom around a rebinding setter frees the
    # old String, so an alias of the field would dangle. The owned copy is
    # load-bearing there, and L022 leaves it alone.
    srcIsFieldRead: function {
        t: this.view
        ast: Ast.view
        st: zenv.ZSymbolTable
        n: astnode.view
    } out bool is {
        match (
            n
        ) case dottedpath then {
            fcn: zast.atomNameText :ast n: (ast.nodes.get i: n.child)
            if fcn.length == 0 then return false
            fpn: ast.nodes.get i: n.parent
            fpi: nodeInfoOf n: fpn
            fpt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: fpi.id
            if fpt.isZero then return false
            fnid: zast.poolFind pool: ast.names text: fcn.stringView
            if fnid.isZero then return false
            fmo: st.typing.declChildOfId parentTypeId: fpt nameId: fnid
            if fmo.some then {
                if (
                    (st.reg.typetypeOf typeId: fmo) == ztypes.ztypetype.functionType
                ) then return false
                return true
            }
            return false
        } else {
            return false
        }
    }

    # owningConvKind -- the RHS is an OWNING String conversion: `.string` on a
    # StringView base, `.copy` on a String base, or a nameTextCopy/poolTextCopy
    # call. Returns the spelling for the message, "" otherwise.
    owningConvKind: function {
        t: this.view
        ast: Ast.view
        st: zenv.ZSymbolTable
        rhsId: zast.nodeid
    } out String is {
        if rhsId.isZero then return "".string
        rn: ast.nodes.get i: rhsId
        match (
            rn
        ) case dottedpath then {
            chn: ast.nodes.get i: rn.child
            cn: zast.atomNameIdOf n: chn
            if cn.isZero then return "".string
            pnn: ast.nodes.get i: rn.parent
            if (t.srcIsFieldRead :ast :st n: pnn) then return "".string
            pin: nodeInfoOf n: pnn
            bt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: pin.id
            if bt.isZero then return "".string
            if cn == zast.wellKnown.slot.wkString when (
                bt == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyStringView)
            ) then return "`.string`".string
            if cn == zast.wellKnown.slot.wkCopy when (
                bt == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyString)
            ) then return "`.copy`".string
            return "".string
        } case call then {
            cbl: ast.nodes.get i: rn.callable
            match (
                cbl
            ) case dottedpath then {
                ccn: zast.atomNameIdOf n: (ast.nodes.get i: cbl.child)
                if ccn == zast.wellKnown.slot.wkNameTextCopy then return "`nameTextCopy`".string
                if ccn == zast.wellKnown.slot.wkPoolTextCopy then return "`poolTextCopy`".string
                return "".string
            } else {
                return "".string
            }
        } else {
            return "".string
        }
    }

    # convSourceRootVid -- the variable id at the ROOT of an owning conversion's
    # source path (`ctx.mainName.copy` -> `ctx`), or the zero vid when the source
    # is not rooted at a name.
    convSourceRootVid: function {
        t: this
        ast: Ast.view
        st: zenv.ZSymbolTable.view
        rhsId: zast.nodeid
    } out ztypes.vid is {
        zv: ztypes.vid
        if rhsId.isZero then return zv
        rn: ast.nodes.get i: rhsId
        match (
            rn
        ) case dottedpath then {
            return (t.convSourceRootVid :ast :st rhsId: rn.parent)
        } case call then {
            return (t.convSourceRootVid :ast :st rhsId: rn.callable)
        } case atomid then {
            avo: st.typing.atomVariableId.get key: rn.nodeid
            if avo.some then {
                zv = avo
            }
            return zv
        } else {
            return zv
        }
    }

    # viewableLocalKind -- the owning conversion kind a String local was bound
    # from when a borrowed view would serve every use of it; empty when the
    # local is not such a case. Mutation evidence is `variableMutated` (the
    # lock rules) and `variableMoved` (the invalidate choke point) -- a local
    # moved into an owner needs its allocation. A view is only equivalent while
    # the SOURCE holds the same bytes: a root that is written -- directly, or
    # by a callee taking it as a mutable borrow -- rebinds or frees them, so
    # the copy is load-bearing (the save/restore idiom around a rebinding
    # setter, and a loop whose tail reassigns the source).
    viewableLocalKind: function {
        t: this
        prog: Ast.view
        st: zenv.ZSymbolTable
        # every variable some atom reads
        used: (IdSet ztypes.vid).view
        # the binding node and its variable
        nid: zast.nodeid
        vid: ztypes.vid
        # the file the unit's body lives in
        mainFsno: zvfs.fsno
    } out String is {
        if (used.has item: vid).not then return String
        if (st.typing.variableMutated.has item: vid) then return String
        if (st.typing.variableMoved.has item: vid) then return String
        fs: prog.fsnoForNode nodeid: nid
        if (fs == mainFsno).not then return String
        nodeL: prog.nodes.get i: nid
        if nodeL.assignment.not then return String
        kind: t.owningConvKind ast: prog :st rhsId: nodeL.value
        rvid: t.convSourceRootVid ast: prog :st rhsId: nodeL.value
        if rvid.notZero when (st.typing.variableMutated.has item: rvid) then return String
        return kind
    }

    # reportViewableLocals -- L022. A String local bound from an OWNING
    # conversion that is never mutated: every use only reads it, so a borrowed
    # view serves and the allocation is avoidable (`.stringView` at the uses,
    # `asString` at a container probe).
    reportViewableLocals: function {
        t: this prog: Ast.view lu: LintedUnit.view st: zenv.ZSymbolTable
    } is {
        mainOp: lu.op
        mainFsno: unitAnchorFsno :prog :mainOp
        zeroFs: zvfs.fsno
        if mainFsno == zeroFs then return
        used: IdSet ztypes.vid
        for each av: st.typing.atomVariableId.iterateItems loop used.add item: av.value
        # the (node, variable) pairs are collected first, side by side: the
        # conversion probes below lend st
        dvNodes: ListVal zast.nodeid
        dvVars: ListVal ztypes.vid
        # a generic instance's copy of a body reports from its template's line,
        # so only the template's own bindings are judged
        for each dv: st.typing.defVariableId.iterateItems loop {
            if (st.typing.isInstanceRow nid: dv.key).not then {
                dvNodes.append from: dv.key
                dvVars.append from: dv.value
            }
        }
        dpi: u64
        for dpi < dvNodes.length loop {
            nid: dvNodes.get i: dpi
            vid: dvVars.get i: dpi
            dpi = dpi + 1
            kind: t.viewableLocalKind :prog :st :used :nid :vid :mainFsno
            nodeL: prog.nodes.get i: nid
            if kind.length > 0 when nodeL.assignment then {
                nm: zast.poolTextAt pool: prog.names ref: nodeL.name
                (
                    t.info
                    code: "L022"
                    msg: "local '\{nm}' is an owned copy (\{kind}) that is never mutated -- a borrowed view serves every use (`.stringView`, or `asString` at a probe)"
                    line: nodeL.lineno
                    col: nodeL.colno
                    width: nm.length
                )
            }
        }
    }

    # reportUnusedDefs -- L012 (unused private definition). A private unit-level definition
    # (function, type, or alias excluded from a `public:` block) that is never referenced is
    # dead. Usage is declaration-based: a reference name resolved against the unit maps to the
    # member DeclId that carries the private flag. An alias declares no typed member of its
    # own and is not judged. The evidence is gathered once -- the recorded references and,
    # as a fallback, every atom name in the unit's own file segment -- then the unit's
    # members and each type's members are judged against it.
    reportUnusedDefs: function {
        t: this prog: Ast.view lu: LintedUnit.view st: zenv.ZSymbolTable.view
    } is {
        mainTid: unitTidOf :prog names: lu.names :st
        if mainTid.isZero then return
        mainOp: lu.op
        memIds: unitMemberIds :prog unitOp: mainOp
        probe: zast.nodeid
        if memIds.length > 0 then probe = memIds.get i: 0
        # the unit's file is its first body member's: the unit's wrapper rows
        # are minted after its body is read, and report from no file
        file: prog.fsnoForNode nodeid: probe
        um: unitMembersOf :prog :st :mainTid :memIds :file
        usedE: usedDeclSet :prog :st :mainTid :file :um
        family: ListVal zvfs.fsno
        if lu.top.notZero then appendFamilyFsnos :prog unitOp: lu.top into: family
        refNames: unitAtomNames :prog :file :family :um
        hidden: unitIsHidden :prog :lu :st
        ev: UnusedEvidence :mainTid :usedE :refNames :memIds :hidden
        t.reportUnusedUnitDefs :prog :st :ev
        t.reportUnusedTypeMembers :prog :st :ev
    }

    # reportUnusedUnitDefs -- L012 over the unit's own members
    reportUnusedUnitDefs: function {
        t: this prog: Ast.view st: zenv.ZSymbolTable.view ev: UnusedEvidence.view
    } is {
        for each mid: ev.memIds loop {
            t.reportIfUnusedDef :prog :st :ev :mid
        }
    }

    # reportIfUnusedDef -- L012 for one unit-level member: private, reached by
    # no recorded reference, and named by no atom of the unit family's files
    reportIfUnusedDef: function {
        t: this prog: Ast.view st: zenv.ZSymbolTable.view ev: UnusedEvidence.view mid: zast.nodeid
    } is {
        m: zast.namedSiteAt ast: prog nid: mid
        if m.name.isZero then return
        dmD: st.typing.declTypedMemberIdOf parentTypeId: ev.mainTid nameId: m.name
        if dmD.isZero then return
        if (ev.usedE.has item: dmD) then return
        if (ev.refNames.has item: m.name) then return
        if ev.hidden or (ztypecheck.declMemberIsPrivate :st tid: ev.mainTid nameId: m.name) then {
            dnm: zast.poolTextAt pool: prog.names ref: m.name
            (
                t.warn
                code: "L012"
                msg: "private definition '\{dnm}' is never used"
                line: m.line
                col: m.col
                width: dnm.length
            )
        }
    }

    # reportUnusedTypeMembers -- L012 over the `is`/`as` members of each type
    # the unit defines
    reportUnusedTypeMembers: function {
        t: this prog: Ast.view st: zenv.ZSymbolTable.view ev: UnusedEvidence.view
    } is {
        for each tmid: ev.memIds loop {
            t.reportUnusedMembersOf :prog :st :ev site: (zast.namedSiteAt ast: prog nid: tmid)
        }
    }

    # reportUnusedMembersOf -- L012 for each private member of the type a unit
    # member defines, a private edge no recorded reference reaches; nothing
    # when the member defines no type
    reportUnusedMembersOf: function {
        t: this
        prog: Ast.view
        st: zenv.ZSymbolTable.view
        ev: UnusedEvidence.view
        site: zast.namedsite
    } is {
        typeTid: definedTypeTidOf :prog :st mainTid: ev.mainTid :site
        if typeTid.isZero then return
        tnm: zast.poolTextAt pool: prog.names ref: site.name
        items: zast.objItemIds ast: prog nid: site.operation
        natRead: fieldsReadNatively :prog :st :typeTid :site
        j: u64
        for j < items.length loop {
            member: zast.namedSiteAt ast: prog nid: (items.get i: j)
            j = j + 1
            if member.name.notZero then {
                tmdi: st.typing.declTypedMemberIdOf parentTypeId: typeTid nameId: member.name
                natField: (
                    natRead and tmdi.notZero and (st.typing.decls.get i: tmdi).kind.fieldDecl
                )
                if tmdi.notZero when natField.not when (ev.usedE.has item: tmdi).not when (
                    ztypecheck.declMemberIsPrivate
                    :st
                    tid: typeTid
                    nameId: member.name
                ) then {
                    tmnm: zast.poolTextAt pool: prog.names ref: member.name
                    (
                        t.warn
                        code: "L012"
                        msg: "private member '\{tnm}.\{tmnm}' is never used"
                        line: member.line
                        col: member.col
                        width: tmnm.length
                    )
                }
            }
        }
    }
}

# ---- doc-coverage helpers ----

# addPublicName -- the name one `public:` entry exports: an entry spelled as a
# bare atom exports that atom's name, any other shape its own
addPublicName: function {ast: Ast.view site: zast.namedsite into: IdSet zast.nameid} is {
    eo: ast.nodes.get i: site.operation
    match (
        eo
    ) case atomid then {
        into.add item: eo.name
    } else {
        into.add item: site.name
    }
}

# addPublicNames -- every name one `public:` block spells, added to `into`
addPublicNames: function {ast: Ast.view opId: zast.nodeid into: IdSet zast.nameid} is {
    ids: ListVal zast.nodeid
    pu: ast.nodes.get i: opId
    if pu.unitdef then ids = zast.kidIds :ast span: pu.body
    for each eId: ids loop {
        esite: zast.namedSiteAt :ast nid: eId
        if esite.name.notZero then addPublicName :ast site: esite :into
    }
}

# unitPublicNames -- the names a unit's `public:` blocks export, into `into`;
# the result says whether the unit has such a block at all, which is what
# decides whether there is a surface to filter by
unitPublicNames: function {ast: Ast.view body: zast.kidspan into: IdSet zast.nameid} out bool is {
    hasPub: false
    ids: zast.kidIds :ast span: body
    for each pId: ids loop {
        psite: zast.namedSiteAt :ast nid: pId
        if psite.name.notZero when (
            zast.unitOpKindIs
            :ast
            opId: psite.operation
            k: zast.unitkind.publicNs
        ) then {
            hasPub = true
            addPublicNames :ast opId: psite.operation :into
        }
    }
    return hasPub
}

# unitMemberIsWalkable -- does the doc pass descend into this unit member? A
# `public:` block is structure rather than a
# definition, and when the unit HAS a public surface only what it exports --
# plus `main`, which no unit exports and every program needs -- is judged
unitMemberIsWalkable: function {
    ast: Ast.view
    site: zast.namedsite
    pubSet: (IdSet zast.nameid).view
    hasPub: bool
} out bool is {
    if site.name.isZero then return true
    if (zast.unitOpKindIs :ast opId: site.operation k: zast.unitkind.publicNs) then return false
    if hasPub.not then return true
    if (pubSet.has item: site.name) then return true
    return site.name == zast.wellKnown.slot.wkMain
}

# ---- L013 / L014 unused-variable helpers ----

# writeTargetAtoms -- every BARE atom node that is a reassignment target. A
# reassignment's target atom carries an atomVariableId stamp exactly as a read
# does, so counting every stamp as a use makes a local that is only ever
# assigned look used; these are the ones to leave out. Only a BARE atom:
# reaching `a.b` to write it genuinely reads `a`, so a dotted target excludes
# nothing.
writeTargetAtoms: function {prog: Ast.view} out IdSet zast.nodeid is {
    wtgt: IdSet zast.nodeid
    ni: zast.nodeid
    nn: prog.nodes.length
    for ni.u64 < nn loop {
        tp: zast.nodeid
        wn: prog.nodes.get i: ni
        match wn case reassignment then tp = wn.topath else null
        if tp.notZero then {
            tn: prog.nodes.get i: tp
            match tn case atomid then wtgt.add item: tp else null
        }
        ni = ni.next
    }
    return wtgt
}

# usedVarSet -- every variable a READ reaches: the atom stamps, less the ones
# sitting on a reassignment target
usedVarSet: function {
    st: zenv.ZSymbolTable.view wtgt: (IdSet zast.nodeid).view
} out IdSet ztypes.vid is {
    used: IdSet ztypes.vid
    for each av: st.typing.atomVariableId.iterateItems loop {
        if (wtgt.has item: av.key).not then used.add item: av.value
    }
    return used
}

# loopBindingIds -- the binding each `for` writes (`for each x: xs`, `for x: f`):
# a labelled condition, where an unlabelled one is a `while` test
loopBindingIds: function {prog: Ast.view} out (IdMapV zast.nodeid v: zast.nodeid) is {
    ids: IdMapV zast.nodeid v: zast.nodeid
    i: zast.nodeid
    for i.u64 < prog.nodes.length loop {
        n: prog.nodes.get :i
        match (
            n
        ) case forexpr then {
            for each cid: (zast.kidsOf ast: prog span: n.conditions) loop {
                c: prog.nodes.get i: cid
                match (
                    c
                ) case namedoperation then {
                    if c.name.notZero then ids.set key: c.operation value: cid
                } else null
            }
        } else null
        i = i.next
    }
    return ids
}

# loopBoundExpr -- the expression a `for` binds when the definition `nid` is
# a loop binding's: `nid` itself, or the parent of the implied `.iterate`
# dotted path the checker writes over it for `for each`. `nid` when it is
# neither, which the caller tells apart by asking loopBinds.
loopBoundExpr: function {
    prog: Ast.view loopBinds: (IdMapV zast.nodeid v: zast.nodeid).view nid: zast.nodeid
} out zast.nodeid is {
    if (loopBinds.has key: nid) then return nid
    n: prog.nodes.get i: nid
    match (
        n
    ) case dottedpath then {
        if (loopBinds.has key: n.parent) then return n.parent
    } else null
    return nid
}

# appendUserFnOp -- append `opId` when it defines a function written in a real
# file. Synth-lowered defs sit outside every file segment (fsno 0): they are not
# user source, so their parameters are exempt
appendUserFnOp: function {prog: Ast.view opId: zast.nodeid fnOps: ListVal zast.nodeid} is {
    isFn: false
    n: prog.nodes.get i: opId
    if n.functiondef then isFn = true
    if isFn.not then return
    if (prog.fsnoForNode nodeid: opId).notZero then fnOps.append from: opId
}

# appendFnOpsOf -- the function definitions one unit member contributes: itself
# when it defines a function, and the methods of its `as` block when it defines
# a type
appendFnOpsOf: function {prog: Ast.view opId: zast.nodeid fnOps: ListVal zast.nodeid} is {
    appendUserFnOp :prog :opId :fnOps
    # only the `as` half of a type carries methods; its `is` half declares
    # fields and arms, which have no parameters to judge
    asIds: ListVal zast.nodeid
    op: prog.nodes.get i: opId
    match op case objectdef then asIds = zast.kidIds ast: prog span: op.asItems else null
    for each amid: asIds loop {
        asite: zast.namedSiteAt ast: prog nid: amid
        if asite.operation.notZero then appendUserFnOp :prog opId: asite.operation :fnOps
    }
}

# hiddenSubunitAt -- the node defines a hidden subunit. Its definitions hang in
# the parent unit's tree once loaded, but it is a file of its own, linted when
# that file is; a walk of the parent that descended into it reported the
# subunit's findings at the parent's path, on the parent's lines.
hiddenSubunitAt: function {ast: Ast.view n: astnode.view} out bool is {
    if n.namedoperation.not then return false
    return (zast.unitOpKindIs :ast opId: n.operation k: zast.unitkind.subunit)
}

# collectFnOps -- every function definition the unit declares, in declaration
# order: its own members first, then the methods of each type it declares. The
# ORDER is load-bearing -- L013 anchors its file segment on the first entry
collectFnOps: function {prog: Ast.view mainOp: zast.nodeid} out ListVal zast.nodeid is {
    fnOps: ListVal zast.nodeid
    memIds: unitMemberIds :prog unitOp: mainOp
    for each mid: memIds loop {
        msite: zast.namedSiteAt ast: prog nid: mid
        if msite.operation.notZero then appendFnOpsOf :prog opId: msite.operation :fnOps
    }
    return fnOps
}

# fnParamIds -- a function definition's parameter nodes, in order
fnParamIds: function {prog: Ast.view fop: zast.nodeid} out ListVal zast.nodeid is {
    ids: ListVal zast.nodeid
    fd: prog.nodes.get i: fop
    match (
        fd
    ) case functiondef then {
        ids = zast.kidIds ast: prog span: fd.parameters
    } else null
    return ids
}

# ---- L012 unused-definition helpers ----

# UnusedEvidence -- what L012 judges a unit's members against: the unit's type
# id, the declarations its recorded references reach, the atom names of its
# own file segment, and its member nodes
UnusedEvidence: class {
    # the type id of the unit being linted
    mainTid: ztypes.tid
    # every declaration a recorded reference reaches from OUTSIDE itself
    usedE: IdSet ztypes.declid
    # every atom name in the files of the unit's family that is not a
    # definition naming itself, the syntactic fallback
    refNames: IdSet zast.nameid
    # the unit body's member nodes, in order
    memIds: ListVal zast.nodeid
    # the unit is a hidden subunit (unitIsHidden): every definition of it is
    # private to its family
    hidden: bool
}

# UnitMembers -- the unit's members as three parallel columns in declaration
# order: start line, name id, and the declaration id L012 judges. A reference
# belongs to the LAST member whose start line is at or before it, which is what
# lets both evidence passes tell a USE from a definition naming itself. Name
# and declaration id are 0 for a member that has neither, so nothing matches.
UnitMembers: class {
    # each member's start line, ascending
    lines: ListVal u32
    # each member's name id, 0 when it has none
    names: ListVal zast.nameid
    # each member's typed declaration id, 0 when it has none
    declIds: ListVal ztypes.declid
}

# unitMembersOf -- the three columns, one row per unit body member written in
# the unit's own file `file`. Every question asked of them is a line in that
# file, so a member another file holds -- a hidden subunit -- has no row: its
# line belongs to no extent here, and the search over the lines takes them as
# ascending.
unitMembersOf: function {
    prog: Ast.view
    st: zenv.ZSymbolTable.view
    mainTid: ztypes.tid
    memIds: (ListVal zast.nodeid).view
    file: zvfs.fsno
} out UnitMembers is {
    um: UnitMembers lines: ListVal u32 names: ListVal zast.nameid declIds: ListVal ztypes.declid
    for each mid: memIds loop {
        if (prog.fsnoForNode nodeid: mid) != file then continue
        m: zast.namedSiteAt ast: prog nid: mid
        nm9: zast.nameid
        dc9: ztypes.declid
        if m.name.notZero then {
            nm9 = m.name
            dc9 = st.typing.declTypedMemberIdOf parentTypeId: mainTid nameId: m.name
        }
        um.lines.append from: m.line
        um.names.append from: nm9
        um.declIds.append from: dc9
    }
    return um
}

# memberIndexAtLine -- the index of the last member starting at or before
# `line`; the column length when the line precedes every member.
memberIndexAtLine: function {um: UnitMembers.view line: u32} out u64 is {
    n: um.lines.length
    lo: u64
    hi: n
    for lo < hi loop {
        mid: lo + (hi - lo / 2)
        v: um.lines.get i: mid
        if v <= line then {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo == 0 then return n
    return lo - 1
}

# selfReferenceAt -- the reference at `siteNid` names the very member it sits
# inside. The site must be in this unit's own file: a use from another file
# shares no line numbering with these extents, and dropping one would report a
# member that IS used.
selfReferenceAt: function {
    prog: Ast.view file: zvfs.fsno um: UnitMembers.view siteNid: zast.nodeid declId: ztypes.declid
} out bool is {
    if declId.isZero then return false
    if file.isZero then return false
    if ((prog.fsnoForNode nodeid: siteNid) == file).not then return false
    ln: u32
    {
        ln = (zast.posOf n: (prog.nodes.get i: siteNid)).line
    }
    k: memberIndexAtLine :um line: ln
    if k >= um.declIds.length then return false
    return (um.declIds.get i: k) == declId
}

# unitTidOf -- the type id of the unit `names` spells from the top level down (a
# subunit is declared inside its parent), 0 when the program declares no such
# unit
unitTidOf: function {
    prog: Ast.view names: (List String).view st: zenv.ZSymbolTable.view
} out ztypes.tid is {
    decl: st.typing.programRoot
    for each nm: names loop {
        decl = (
            st.typing.declFindChild
            parentDeclId: decl
            nameId: (zast.poolFind pool: prog.names text: nm.stringView)
        )
    }
    uo: st.typing.declTypeOf declId: decl
    if uo.isZero then return ztypes.tid.zero
    return uo
}

# LintedUnit -- the unit a linted FILE is: its unitdef node (0 when the parse
# loaded no unit from that file), its name, and the unit names from the top
# level down to it.
LintedUnit: class {
    # the unit's unitdef node
    op: zast.nodeid
    # the unitdef node of the top-level unit it belongs to: itself, or the
    # unit whose folder holds its file
    top: zast.nodeid
    # its own name, the last of `names`
    name: String
    # the names from the top-level unit down, which spell its declaration
    names: List String
}

# lintedUnitOf -- the unit whose body lives in the file `self`: the program's
# top-level units and, inside each, its subunits, searched by the FILE each
# body came from and never by name.
lintedUnitOf: function {prog: Ast.view self: zvfs.fsno} out LintedUnit is {
    lu: LintedUnit op: zast.nodeid top: zast.nodeid name: String names: List String
    if self.isZero then return lu
    trail: List String
    for each uId: prog.units loop {
        if lu.op.isZero then {
            findUnitIn :prog :self namedOpId: uId :trail into: lu
            topNode: prog.nodes.get i: uId
            if lu.op.notZero when topNode.namedoperation then lu.top = topNode.operation
        }
    }
    return lu
}

# lintedUnitNamed -- the top-level unit named `uname` as a LintedUnit, the
# last of several winning: for zls, whose compile pass roots the program at
# the open document's unit by that name.
lintedUnitNamed: function {prog: Ast.view uname: StringView} out LintedUnit is {
    lu: LintedUnit op: zast.nodeid top: zast.nodeid name: uname.string names: List String
    for each uId: prog.units loop {
        un: prog.nodes.get i: uId
        if un.namedoperation then {
            unm: zast.poolTextAt pool: prog.names ref: un.name
            if unm.stringView == uname then lu.op = un.operation
        }
    }
    lu.top = lu.op
    lu.names.append uname.string
    return lu
}

# findUnitIn -- lintedUnitOf's search below one named node: the unit itself when
# its body is the file, else each of its subunits. `trail` holds the names above.
findUnitIn: function {
    prog: Ast.view
    self: zvfs.fsno
    namedOpId: zast.nodeid
    trail: List String
    into: LintedUnit
} is {
    n: prog.nodes.get i: namedOpId
    if n.namedoperation.not then return
    op: n.operation
    if (prog.nodes.get i: op).unitdef.not then return
    trail.append (zast.nameTextCopy ast: prog ref: n.name)
    if (unitAnchorFsno :prog mainOp: op) == self then {
        into.op = op
        for each t: trail loop into.names.append t.copy
        into.name = (trail.get i: trail.length - 1).copy
    } else {
        for each mid: (unitMemberIds :prog unitOp: op) loop {
            if into.op.isZero then findUnitIn :prog :self namedOpId: mid :trail :into
        }
    }
    trail.pop
}

# appendFamilyFsnos -- the file the unit `unitOp` is written in, then those of
# its hidden subunits and theirs: the files of a unit family, as the parse
# numbers them
appendFamilyFsnos: function {prog: Ast.view unitOp: zast.nodeid into: ListVal zvfs.fsno} is {
    into.append from: (unitAnchorFsno :prog mainOp: unitOp)
    for each mid: (unitMemberIds :prog :unitOp) loop {
        m: prog.nodes.get i: mid
        if m.namedoperation when (
            zast.unitOpKindIs
            ast: prog
            opId: m.operation
            k: zast.unitkind.subunit
        ) then appendFamilyFsnos :prog unitOp: m.operation :into
    }
}

# unitIsHidden -- the linted unit is a hidden subunit: a file of its parent's
# folder that the parent's `public:` block does not list. Nothing outside the
# family reaches a definition of it, so each one is private to the family.
unitIsHidden: function {prog: Ast.view lu: LintedUnit.view st: zenv.ZSymbolTable.view} out bool is {
    if lu.names.length < 2 then return false
    above: List String
    n: lu.names.length - 1
    i: u64
    for i < n loop {
        above.append from: (lu.names.get :i).copy
        i = i + 1
    }
    parentTid: unitTidOf :prog names: above :st
    if parentTid.isZero then return false
    if (ztypecheck.publicNsOf reg: st.reg typing: st.typing tid: parentTid).isZero then return true
    return (
        ztypecheck.declMemberIsPrivate
        :st
        tid: parentTid
        nameId: (zast.poolFind pool: prog.names text: lu.name.stringView)
    )
}

# unitAnchorFsno -- the file a unit's body lives in: the file its unitdef node
# reports from, zero for a unit no file holds.
unitAnchorFsno: function {prog: Ast.view mainOp: zast.nodeid} out zvfs.fsno is {
    return (prog.fsnoForNode nodeid: mainOp)
}

# unitMemberIds -- the unit body's member nodes, in order
unitMemberIds: function {prog: Ast.view unitOp: zast.nodeid} out ListVal zast.nodeid is {
    return (zast.kidIds ast: prog span: (zast.unitBodyIdsAt ast: prog unitId: unitOp))
}

# usedDeclSet -- every declaration the recorded references reach: a use of a
# unit-level name marks that name under the linted unit, a member use marks
# the member under its owning type, and each public alias marks the name it
# stands for. The pairs are collected first and resolved after the walk, since
# a member lookup through the table cannot run while its table is iterated.
usedDeclSet: function {
    prog: Ast.view
    st: zenv.ZSymbolTable.view
    mainTid: ztypes.tid
    file: zvfs.fsno
    um: UnitMembers.view
} out IdSet ztypes.declid is {
    usedE: IdSet ztypes.declid
    owners: ListVal ztypes.tid
    names: ListVal zast.nameid
    for each e: st.typing.refDecl.iterateItems loop {
        dNm: zast.nameid
        dPar: ztypes.declid
        dlo: st.typing.decls.get i: e.value
        dNm = dlo.name
        dPar = dlo.parent
        if (selfReferenceAt :prog :file :um siteNid: e.key declId: e.value) then {
            dPar = ztypes.declid
        }
        if dPar.notZero when dNm.notZero then {
            ownerTid: ztypes.tid
            plo: st.typing.decls.get i: dPar
            if plo.kind.unitDecl then ownerTid = mainTid
            if plo.kind.typeDecl then ownerTid = plo.typeId
            if ownerTid.notZero then {
                owners.append from: ownerTid
                names.append from: dNm
            }
        }
    }
    addUsedMembers :st tids: owners nms: names into: usedE
    addPublicAliasTargets :prog :st :mainTid into: usedE
    return usedE
}

# addUsedMembers -- each (owner type, member name) pair resolved to its
# declaration and added to `into`; a pair naming no member adds nothing
addUsedMembers: function {
    st: zenv.ZSymbolTable.view
    tids: (ListVal ztypes.tid).view
    nms: (ListVal zast.nameid).view
    into: IdSet ztypes.declid
} is {
    i: u64
    for i < tids.length loop {
        di: st.typing.declTypedMemberIdOf parentTypeId: (tids.get :i) nameId: (nms.get :i)
        i = i + 1
        if di.notZero then into.add item: di
    }
}

# addPublicAliasTargets -- each name a public alias of the unit stands for
# counts as used: the alias is the public face, the target is what it names
addPublicAliasTargets: function {
    prog: Ast.view st: zenv.ZSymbolTable.view mainTid: ztypes.tid into: IdSet ztypes.declid
} is {
    tgtNames: ztypecheck.publicAliasInternalNames :st pool: prog.names tid: mainTid
    for each tnm: tgtNames loop {
        tpid: prog.names.find s: tnm.stringView
        if tpid.notZero then {
            tdi: st.typing.declTypedMemberIdOf parentTypeId: mainTid nameId: tpid
            if tdi.notZero then into.add item: tdi
        }
    }
}

# rootAtomNames -- every atom name among the rows that report from no file:
# the root parse's own, since only a unit file's body reports from its file
rootAtomNames: function {prog: Ast.view into: IdSet zast.nameid} is {
    totN: prog.nodes.length
    ndJ: zast.nodeid
    ndJ = ndJ.next
    for ndJ.u64 < totN loop {
        if (prog.fsnoForNode nodeid: ndJ).isZero then {
            node: prog.nodes.get i: ndJ
            if node.atomid then into.add item: node.name
        }
        ndJ = ndJ.next
    }
}

# unitAtomNames -- the syntactic fallback evidence: every atom name the
# files of the unit's family (`family`, the unit's own `file` among them)
# hold. Stamps exist only for the bodies the demand walk checked, so a private
# def used only inside an unchecked body (a construction in a never-demanded
# factory) would otherwise read as dead.
unitAtomNames: function {
    prog: Ast.view
    file: zvfs.fsno
    family: (ListVal zvfs.fsno).view
    um: UnitMembers.view
} out IdSet zast.nameid is {
    names: IdSet zast.nameid
    if file.notZero then {
        atomNamesOutsideSelf :prog :file :family :um into: names
    } else {
        rootAtomNames :prog into: names
    }
    return names
}

# atomNamesOutsideSelf -- every atom name in the files `family` except, in the
# unit's own file `file`, where the atom names the member it sits inside. A
# self-recursive definition spells its own name, and counting that as a use is
# what kept L012 silent about two dead emitter helpers for three months.
atomNamesOutsideSelf: function {
    prog: Ast.view
    file: zvfs.fsno
    family: (ListVal zvfs.fsno).view
    um: UnitMembers.view
    into: IdSet zast.nameid
} is {
    totN: prog.nodes.length
    ndI: zast.nodeid
    ndI = ndI.next
    for ndI.u64 < totN loop {
        nd0: prog.nodes.get i: ndI
        inFile: prog.fsnoForNode nodeid: ndI
        ndI = ndI.next
        if nd0.atomid when inFile == file then {
            k: memberIndexAtLine :um line: nd0.lineno
            isSelf: false
            if k < um.names.length when (um.names.get i: k) == nd0.name then isSelf = true
            if isSelf.not then into.add item: nd0.name
        }
        if nd0.atomid when (inFile == file).not when (family.contains item: inFile) then {
            into.add item: nd0.name
        }
    }
}

# definedTypeTidOf -- the type id a unit member defines, 0 when the member is
# not an object definition or resolves to no type under the unit
definedTypeTidOf: function {
    prog: Ast.view st: zenv.ZSymbolTable.view mainTid: ztypes.tid site: zast.namedsite
} out ztypes.tid is {
    if site.name.isZero then return ztypes.tid.zero
    if site.operation.isZero then return ztypes.tid.zero
    to: prog.nodes.get i: site.operation
    if to.objectdef.not then return ztypes.tid.zero
    cto: st.typing.declChildOfId parentTypeId: mainTid nameId: site.name
    if cto.some then {
        return cto
    }
    return ztypes.tid.zero
}

# ---- L005 redundant-suffix helpers (typecheck tier; run only under --full) ----

# nodeinfo -- a node's synthetic id and source position.
nodeinfo: record {
    # the node
    id: zast.nodeid
    # the source line, which is what a diagnostic reports rather than the
    # byte offset the wrap rules work in
    line: u32
    # the source column, paired with line
    col: u32
}

# isOptionTid -- `tid` is an instance of one of the option templates, the sum
# types whose two arms are `none` and `some`.
isOptionTid: function {ast: Ast.view st: zenv.ZSymbolTable tid: ztypes.tid} out bool is {
    origin: st.reg.genericOriginOf :tid
    if origin.isZero then return false
    if origin == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyOptionval) then return true
    if origin == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyOption) then return true
    if (
        origin == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyOptionView)
    ) then return true
    if (
        origin == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyOptionViewVal)
    ) then return true
    if origin == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyOptionMut) then return true
    return origin == (ztypecheck.stdTidRo :ast :st wk: zast.wellKnown.slot.tyOptionMutVal)
}

# nodeInfoOf -- the id and source position of any AST node.
nodeInfoOf: function {n: astnode.view} out nodeinfo is {
    p: zast.posOf :n
    return (nodeinfo id: (zast.nodeIdOf :n) line: p.line col: p.col)
}

# bareZeroTypeName -- the bare-type replacement when a dotted child atom is a
# zero-init suffix candidate: `string` maps to String, a concrete numeric
# type name maps to itself, anything else to "" (c8/c32 are not
# zero-suffix candidates).
bareZeroTypeName: function {ast: Ast.view n: astnode.view} out String is {
    if n.atomid then {
        id: n.name
        if id == zast.wellKnown.slot.wkString then return "String".string
        if (
            (id == zast.wellKnown.slot.tyC8) or (id == zast.wellKnown.slot.tyC32)
        ) then return "".string
        if (ztypecheck.isScalarNameId :id) then return (zast.nameTextCopy :ast ref: id)
    }
    return "".string
}

# bareZeroParentText -- the source spelling of a zero-literal dotted parent:
# `""` for the empty string literal, `0` / `0.0` for the numeric zeros; ""
# when the parent is not a zero literal.
bareZeroParentText: function {n: astnode.view} out String is {
    match (
        n
    ) case atomstring then {
        if n.stringparts.count.u64 == 0 then return "\"\"".string
    } case atomid then {
        if n.name == zast.wellKnown.slot.wkLitZero then return "0".string
        if n.name == zast.wellKnown.slot.wkLitZeroFloat then return "0.0".string
    } else null
    return "".string
}

# isNonDec -- a literal lexeme in hex / binary / octal form.
isNonDec: function {s: StringView} out bool is {
    if (s.startsWith prefix: "0x") then return true
    if (s.startsWith prefix: "0X") then return true
    if (s.startsWith prefix: "0b") then return true
    if (s.startsWith prefix: "0B") then return true
    if (s.startsWith prefix: "0o") then return true
    if (s.startsWith prefix: "0O") then return true
    return false
}

# literalFitsBase -- the literal value fits its base's default type (i64 for decimal, u64 for
# non-decimal). A literal that overflows the default keeps its suffix (load-bearing).
literalFitsBase: function {numstr: StringView} out bool is {
    pv: ztypes.parseLiteralValue :numstr
    if pv.ok.not then return false
    if pv.isFloat then return true
    if (isNonDec s: numstr) then return true
    iMax: 9223372036854775807.u64
    return pv.ival <= iMax
}

# SufRec -- a candidate suffix: the suffix type name ("" when not a candidate) and the
# position of the suffix's type token.
SufRec: class {
    # the type name the suffix spelled
    tname: String
    # the line the suffix is on
    line: u32
    # the column it starts at
    col: u32
}

# operandSuffix -- report whether the operand is a redundant-suffix dotted path,
# with the type token's position.
operandSuffix: function {ast: Ast.view n: astnode.view} out SufRec is {
    match (
        n
    ) case dottedpath then {
        cn: zast.atomNameText :ast n: (ast.nodes.get i: n.child)
        if (ztypecheck.isNumericTypeName name: cn.stringView).not then {
            return (SufRec tname: "".string line: 0 col: 0)
        }
        pn: zast.atomNameText :ast n: (ast.nodes.get i: n.parent)
        if pn.length == 0 then return (SufRec tname: "".string line: 0 col: 0)
        if (literalFitsBase numstr: pn.stringView).not then {
            return (SufRec tname: "".string line: 0 col: 0)
        }
        ci: nodeInfoOf n: (ast.nodes.get i: n.child)
        return (SufRec tname: cn line: ci.line col: ci.col)
    } else {
        return (SufRec tname: "".string line: 0 col: 0)
    }
}

# isNodeConst -- the node carries a compile-time const value.
isNodeConst: function {nid: zast.nodeid st: zenv.ZSymbolTable.view} out bool is {
    return (st.typing.nodeConst.has key: nid)
}

# typeNameOfNode -- the resolved type name of a node ("" when unresolved).
typeNameOfNode: function {n: astnode.view st: zenv.ZSymbolTable.view} out String is {
    info: nodeInfoOf :n
    to: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: info.id
    if to.notZero then {
        return (st.reg.nameOf tid: to)
    } else {
        return "".string
    }
}

# typeNameOfOptAt -- the id-taking entry (0 = absent).
typeNameOfOptAt: function {
    ast: Ast.view
    oId: zast.nodeid
    st: zenv.ZSymbolTable.view
} out String is {
    if oId.isZero then return "".string
    o: ast.nodes.get i: oId
    return (typeNameOfNode n: o :st)
}

# litShapedSuf -- the node is a numeric literal, bare or wearing a width
# conversion (`5`, `5.u32`, `(1.0e300).f128`): such an operand must never
# anchor a suffix strip -- removing the other side's suffix would leave
# default-typed literals and change the arithmetic width.
litShapedSuf: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case atomid then {
        an: zast.nameTextAt :ast ref: n.name
        d: false
        b: an.stringView.byteAt 0
        if b.some when (ascii.isDigit :b) then d = true
        return d
    } case dottedpath then {
        return (litShapedSuf :ast n: (ast.nodes.get i: n.parent))
    } else {
        return false
    }
}

# isAnchor -- the node is a concrete non-literal value of numeric type `tname`, a genuine
# type anchor that makes a same-type literal suffix redundant.
isAnchor: function {
    ast: Ast.view
    n: astnode.view
    tname: StringView
    st: zenv.ZSymbolTable.view
} out bool is {
    if (litShapedSuf :ast :n) then return false
    info: nodeInfoOf :n
    nid: info.id
    to: ztyping.nodeTypeAt tbl: st.typing.nodeType :nid
    if to.notZero then {
        zhit: false
        znm: String
        name: st.reg.nameOf tid: to
        zhit = true
        znm = name.take
        if zhit.not then return false
        if (znm.stringView == tname).not then return false
        if (isNodeConst :nid :st) then return false
        return true
    } else {
        return false
    }
}

# bodysite -- where A006 first saw a body's shape
bodysite: record {
    # the file, as its place in the unit family (familyFilesOf)
    file: u64
    # the line of the function
    line: u64
}

# docBlockBody -- the comment block of `lines` starting at line `from`: each
# line's text after its `#`, trimmed, joined by single spaces into `into`.
# Answers the index of the first line after the block.
docBlockBody: function {lines: (List String).view from: u64 into: String.borrow} out u64 is {
    i: from
    n: lines.length
    for i < n loop {
        ln: lines.get :i
        trimmed: ln.stringView.trim
        if (trimmed.startsWith "#").not then return i
        body: trimmed.substring from: 1 to: trimmed.length
        if into.length > 0 then into.append " "
        into.append s: body.trim
        i = i + 1
    }
    return i
}

# docBlockKey -- a doc body's comparison key: its words with the vocabulary
# of the declaration at `declAt` (the line after the block) and every
# width folded out, joined.
docBlockKey: function {lines: (List String).view ws: List String declAt: u64} out String is {
    vocab: List String
    if declAt < lines.length then {
        decl: (lines.get i: declAt).copy
        docVocabInto s: (docStripComment ln: decl.stringView) into: vocab
    }
    folded: docFoldTemplate words: ws :vocab
    return (docJoinWords xs: folded)
}

# docKeysOf -- the doc bodies of a file's `lines` that L025 compares: the key
# of each comment block of four words or more into `keys`, and the index of
# its first line into `starts`.
docKeysOf: function {lines: (List String).view keys: List String starts: ListVal u64} is {
    i: u64
    n: lines.length
    for i < n loop {
        head: lines.get :i
        if (docLineIsComment ln: head.stringView) then {
            st: i
            buf: String
            i = docBlockBody :lines from: i into: buf
            ws: List String
            docWordsInto s: buf.stringView into: ws
            if ws.length >= 4 then {
                keys.append from: (docBlockKey :lines :ws declAt: i)
                starts.append from: st
            }
        } else i = i + 1
    }
}

# tallyDocKeys -- each of a file's doc keys (docKeysOf) counted into `into`,
# which holds how often a doc body stands in the unit family
tallyDocKeys: function {keys: (List String).view into: (MapRV String v: u64)} is {
    for each k: keys loop into.set key: k.copy value: ((into.get key: k).or d: 0) + 1
}

# familyFilesOf -- the files of the unit family `file` belongs to, in family
# order: the topmost unit's file, then the files of the folder of its name, by
# name, each followed by its own folder's. A unit with no folder, and a data
# file, is a family of one.
familyFilesOf: function {file: StringView} out List String is {
    files: List String
    if (isDataFile :file) then {
        files.append from: file.string
        return files
    }
    top: topUnitPathOf :file
    appendFamilyFiles unitFile: top.stringView into: files
    return files
}

# appendFamilyFiles -- `unitFile`, then each `.z` file of the folder of its
# name with that file's own folder, by name
appendFamilyFiles: function {unitFile: StringView into: List String} is {
    into.append from: unitFile.string
    dir: (unitFile.substring from: 0 to: unitFile.length - (unitFileExt file: unitFile).length
    ).string
    names: unitNamesIn dir: dir.stringView
    names.sort
    for each nm: names loop {
        sub: "\{dir}/\{nm}.z"
        appendFamilyFiles unitFile: sub.stringView :into
    }
}

# familyIndexOf -- the place of `file` in its family's list, by the file it
# names and not its spelling; 0 when the list does not hold it, which judges
# the file as a family of its own
familyIndexOf: function {family: (List String).view file: StringView} out u64 is {
    i: u64
    for i < family.length loop {
        if (sameFile a: (family.get :i).stringView b: file) then return i
        i = i + 1
    }
    return 0
}

# topUnitPathOf -- the file of the topmost unit `file` belongs to. A file in a
# folder `<d>/<u>/` beside a unit file `<d>/<u>.z` is that unit's subunit, so
# the walk steps up to `<d>/<u>.z`, and on while its folder is a subunit folder
# too. Either separator counts on Windows (the path unit). The path as given
# when it is no subunit; a bare file name is looked up from the working
# directory.
topUnitPathOf: function {file: StringView} out String is {
    cur: file.string
    if (path.baseName p: file).length == file.length then {
        wd: os.cwd
        match (
            wd
        ) case ok then {
            cur = path.join a: wd.stringView b: file
        } case err then {
            return cur
        }
    }
    climbed: false
    stepping: true
    for stepping loop {
        stepping = false
        dir: path.dirname p: cur.stringView
        # a root names no unit folder
        if (path.baseName p: dir.stringView).length > 0 then {
            parentFile: dir.copy
            parentFile.append (unitFileExt :file)
            if (zcheck.pathKindIs path: parentFile.stringView want: io.filekind.file) then {
                cur = parentFile.take
                stepping = true
                climbed = true
            }
        }
    }
    # no subunit: the path as it was given
    if climbed.not then return file.string
    return cur
}

# suffixRoots -- the src roots the typecheck tier parses `file` against: the
# project's, after the file's own directory for a data file, whose units its
# siblings and its hidden folder are first (zdata.open)
suffixRoots: function {
    srcdirs: (List String).view file: StringView dataFile: bool
} out List String is {
    own: List String
    if dataFile then own.append (path.dirname p: (topUnitPathOf :file).stringView)
    for each sd: srcdirs loop own.append from: sd.copy
    return own
}

# isDataFile -- the file is a data file (`.zd`, docs/zdata.pdoc) rather than
# a source file
isDataFile: function {file: StringView} out bool is {
    return (file.endsWith ".zd")
}

# unitFileExt -- the extension the units of `file`'s kind carry: `.zd` beside
# a data file, `.z` beside any other
unitFileExt: function {file: StringView} out StringView is {
    if (isDataFile :file) then return ".zd"
    return ".z"
}

# unitNameOf -- a file path's unit name: the final path segment without its
# unit extension (`.z`, or `.zd` for a data file).
unitNameOf: function {file: StringView} out String is {
    base: path.baseName p: file
    sfx: base.stringView.stripSuffix s: (unitFileExt :file)
    match (
        sfx
    ) case some then {
        return sfx.string
    } case none then {
        return base.copy
    }
}

# linesOf -- split source into a 1-based-addressable list of lines (newlines stripped).
linesOf: function {src: StringView} out List String is {
    ls: List String
    for each ln: src.lines loop ls.append ln.string
    return ls
}

# lineStartIndex -- byte offset of each line's first byte, one entry per line (matching
# linesOf), an `off += len + 1` accumulator over the lines; converts token/edit positions
# to byte offsets and back without depending on the tokenizer's escape-decoded widths.
lineStartIndex: function {src: StringView} out ListVal u64 is {
    ls: ListVal u64
    off: u64
    lls: linesOf :src
    for each ln: lls loop {
        ls.append off
        off = off + ln.length + 1
    }
    return ls
}

# byteToLine -- the 0-based index of the line containing byte `off`: the largest i with
# lineStart[i] <= off. lineStart ascends, so the scan stops at the first line past off.
byteToLine: function {lineStart: (ListVal u64).view off: u64 nLines: u64} out u64 is {
    r: u64
    i: u64
    for i < nLines loop {
        v: lineStart.get :i
        if v <= off then {
            r = i
        } else {
            break
        }
        i = i + 1
    }
    return r
}

# colToByteInLine -- byte offset within `lineText` of the 1-based codepoint column `colno`.
# token columns are codepoint-based (multibyte-aware); this walks the line's bytes, consuming
# one codepoint (a lead byte plus its 0x80..0xBF continuations) per column. ASCII: colno - 1.
colToByteInLine: function {lineText: StringView colno: u32} out u64 is {
    if colno <= 1 then return 0
    target: (colno - 1).u64
    n: lineText.length
    b: u64
    cp: u64
    for cp < target loop {
        if b >= n then break
        b = b + 1
        cont: true
        for cont loop {
            if b >= n then {
                cont = false
            } else {
                nb: lineText.byteAt i: b
                isC: false
                if nb.some when nb >= 128 when nb < 192 then isC = true
                if isC then {
                    b = b + 1
                } else {
                    cont = false
                }
            }
        }
        cp = cp + 1
    }
    return b
}

# isLeadingLabel -- whether `label` is the name the first argument of the
# construct `word` may leave out: `for while`, `match on`, `function in`,
# `unit as`, and `is` after a type declarator.
isLeadingLabel: function {word: zlexer.toktype label: zlexer.toktype} out bool is {
    match (
        word
    ) case forTok then {
        return label.whileTok
    } case matchTok then {
        return label.onTok
    } case functionTok then {
        return label.inTok
    } case unitTok then {
        return label.asTok
    } case recordTok then {
        return label.isTok
    } case classTok then {
        return label.isTok
    } case variantTok then {
        return label.isTok
    } case unionTok then {
        return label.isTok
    } case facetTok then {
        return label.isTok
    } case protocolTok then {
        return label.isTok
    } case dataTok then {
        return label.isTok
    } case choiceTok then {
        return label.isTok
    } case generatorTok then {
        return label.isTok
    } case typedefTok then {
        return label.isTok
    } else {
        return false
    }
}

# tokByteStart -- absolute byte offset of a token from its 1-based (lineno, colno): the line's
# start offset plus the codepoint-column converted to a byte column.
tokByteStart: function {
    lineStart: (ListVal u64).view
    srcLines: (List String).view
    lineno: u32
    colno: u32
} out u64 is {
    li: (lineno - 1).u64
    if li >= srcLines.length then return 0
    base: lineStart.get i: li
    lt: srcLines.get i: li
    return base + (colToByteInLine lineText: lt.stringView :colno)
}

# sortEdits -- a new edit list ordered by byteLo (ascending, stable for ties). applyEdits and
# renderDiff require sorted, non-overlapping input; each rule emits its own edits in order but
# they interleave across rules, so a global sort is run once all rules have contributed.
sortEdits: function {edits: (List zfix.Edit).borrow} out List zfix.Edit is {
    result: List zfix.Edit
    n: edits.length
    used: ListVal bool
    p: u64
    for p < n loop {
        used.append false
        p = p + 1
    }
    k: u64
    for k < n loop {
        best: n
        bestLo: u64
        bestHi: u64
        i: u64
        for i < n loop {
            u: used.get :i
            if u.not then {
                e: edits.get :i
                better: (
                    (best == n) or
                    (e.byteLo < bestLo) or
                    ((e.byteLo == bestLo) and (e.byteHi > bestHi))
                )
                if better then {
                    best = i
                    bestLo = e.byteLo
                    bestHi = e.byteHi
                }
            }
            i = i + 1
        }
        be: edits.get i: best
        result.append (
            zfix.Edit
            byteLo: be.byteLo
            byteHi: be.byteHi
            replacement: be.replacement.copy
        )
        used.set i: best val: true
        k = k + 1
    }
    return result
}

# emitDiffHunk -- append one zero-context unified-diff hunk to `buf` for the cluster of edits
# [cStart, cEnd) spanning old lines [clLo, clHi]. The new-side block is the old bytes with the
# cluster's edits applied, so the hunk exactly reflects the formatted output. Returns the
# running new-minus-old line delta for the next hunk's + start.
emitDiffHunk: function {
    buf: String
    source: StringView
    edits: (List zfix.Edit).view
    cStart: u64
    cEnd: u64
    clLo: u64
    clHi: u64
    lineStart: (ListVal u64).view
    srcLines: (List String).borrow
    newDelta: i64
} out i64 is {
    nLines: srcLines.length
    srcLen: source.length
    oldCount: clHi - clLo + 1
    aByte: lineStart.get i: clLo
    bByte: srcLen
    if (clHi + 1) < nLines then bByte = lineStart.get i: clHi + 1
    newBlock: String
    prev: aByte
    j: cStart
    for j < cEnd loop {
        e: edits.get i: j
        if e.byteLo >= prev when e.byteLo <= e.byteHi then {
            zfix.appendRange buf: newBlock src: source lo: prev hi: e.byteLo
            newBlock.append e.replacement
            prev = e.byteHi
        }
        j = j + 1
    }
    zfix.appendRange buf: newBlock src: source lo: prev hi: bByte
    newLines: List String
    if newBlock.length > 0 then newLines = linesOf src: newBlock.stringView
    newCount: newLines.length
    newStart: clLo.i64.orPanic + newDelta + 1
    hh: "@@ -\{clLo + 1},\{oldCount} +\{newStart},\{newCount} @@\n"
    buf.append hh
    oi: clLo
    for oi <= clHi loop {
        ol: srcLines.get i: oi
        dm: "-\{ol}\n"
        buf.append dm
        oi = oi + 1
    }
    if (clHi + 1) == nLines when (endsWithNewline src: source).not then {
        buf.append "\\ No newline at end of file\n"
    }
    for each nl: newLines loop {
        pm: "+\{nl}\n"
        buf.append pm
    }
    if newBlock.length > 0 when (endsWithNewline src: newBlock.stringView).not then {
        buf.append "\\ No newline at end of file\n"
    }
    return newDelta + newCount.i64.orPanic - oldCount.i64.orPanic
}

# byteAtLine -- byte offset of line `k`'s start, or `srcLen` when `k` is one past the last line.
byteAtLine: function {starts: (ListVal u64).view srcLen: u64 k: u64} out u64 is {
    if k >= starts.length then return srcLen
    return (starts.get i: k)
}

# bandpair -- where a resync landed: the next line on each side that is the same
# text. Past the band it is the window's far edge instead, which is what makes a
# block bounded rather than minimal.
bandpair: record {
    # the old side's line index
    oldAt: u64
    # the new side's line index
    newAt: u64
}

# linesEqualAt -- whether the two sides hold the same line at these positions.
# Past the end of either there is nothing to compare, so they do not.
linesEqualAt: function {
    oldLines: (List String).view
    newLines: (List String).view
    m: u64
    n: u64
    i: u64
    p: u64
} out bool is {
    if (i >= m) or (p >= n) then return false
    oi: oldLines.get :i
    pj: newLines.get i: p
    return oi.stringView == pj
}

# bandProbe -- the first matching pair on diagonal `t`, if the diagonal holds
# one. The diagonal is the offsets summing to t, so probing t in increasing order
# reaches the nearest resync first.
bandProbe: function {
    oldLines: (List String).view
    newLines: (List String).view
    m: u64
    n: u64
    i: u64
    p: u64
    t: u64
} out optionval bandpair is {
    a: u64
    for a <= t loop {
        b: t - a
        ii: i + a
        pp: p + b
        a = a + 1
        if ii < m when pp < n then {
            oa: oldLines.get i: ii
            pb: newLines.get i: pp
            if oa.stringView == pb then {
                return (optionval.some (bandpair oldAt: ii newAt: pp))
            }
        }
    }
    return (optionval.none bandpair)
}

# bandResync -- where the two sides line up again, searched by increasing
# diagonal so the changed block is the smallest the band can find. Nothing within
# the band means the block runs to the window's edge.
bandResync: function {
    oldLines: (List String).view
    newLines: (List String).view
    m: u64
    n: u64
    i: u64
    p: u64
} out bandpair is {
    t: 1.u64
    for t <= 256 loop {
        hit: bandProbe :oldLines :newLines :m :n :i :p :t
        if hit.some then return hit
        t = t + 1
    }
    we: i + 256
    if we > m then we = m
    wf: p + 256
    if wf > n then wf = n
    return (bandpair oldAt: we newAt: wf)
}

# lineDiffEdits -- edits transforming `old` into `new`, one per changed line-block, shaped for
# renderDiff. fmt + wrap never reorder lines, so an in-order two-pointer with a bounded diagonal-band
# resync finds correct (within the window, minimal) blocks; applyEdits(old, result) == new.
lineDiffEdits: function {old: StringView new: StringView} out List zfix.Edit is {
    oldLines: linesOf src: old
    newLines: linesOf src: new
    oldStarts: lineStartIndex src: old
    newStarts: lineStartIndex src: new
    m: oldLines.length
    n: newLines.length
    oldLen: old.length
    newLen: new.length
    edits: List zfix.Edit
    i: u64
    p: u64
    for (i < m) or (p < n) loop {
        if (linesEqualAt :oldLines :newLines :m :n :i :p) then {
            i = i + 1
            p = p + 1
            continue
        }
        at: bandResync :oldLines :newLines :m :n :i :p
        lo: byteAtLine starts: oldStarts srcLen: oldLen k: i
        hi: byteAtLine starts: oldStarts srcLen: oldLen k: at.oldAt
        nlo: byteAtLine starts: newStarts srcLen: newLen k: p
        nhi: byteAtLine starts: newStarts srcLen: newLen k: at.newAt
        repl: String
        zfix.appendRange buf: repl src: new lo: nlo hi: nhi
        doEmit: (hi > lo) or (nhi > nlo)
        if doEmit then edits.append (zfix.Edit byteLo: lo byteHi: hi replacement: repl)
        i = at.oldAt
        p = at.newAt
    }
    return edits
}

# renderDiff -- a git-style unified diff (zero context) of `source` -> the formatted result,
# driven by `edits` (assumed sorted by byteLo). Adjacent edits touching the same or
# neighbouring lines share a hunk. Empty when there are no edits.
renderDiff: function {
    path: StringView
    source: StringView
    edits: (List zfix.Edit).borrow
} out String is {
    buf: String
    m: edits.length
    if m == 0 then return buf
    lineStart: lineStartIndex src: source
    srcLines: linesOf src: source
    nLines: srcLines.length

    hdr: "--- \{path}\n+++ \{path}\n"
    buf.append hdr

    newDelta: i64
    cActive: false
    cStart: u64
    clLo: u64
    clHi: u64
    i: u64
    for i < m loop {
        e: edits.get :i
        lo: byteToLine :lineStart off: e.byteLo :nLines
        hi: lo
        if e.byteHi > e.byteLo then hi = byteToLine :lineStart off: e.byteHi - 1 :nLines
        if cActive.not then {
            cActive = true
            cStart = i
            clLo = lo
            clHi = hi
        } else if lo <= (clHi + 1) then {
            if hi > clHi then clHi = hi
        } else {
            newDelta = (
                emitDiffHunk
                :buf
                :source
                :edits
                :cStart
                cEnd: i
                :clLo
                :clHi
                :lineStart
                :srcLines
                :newDelta
            )
            cStart = i
            clLo = lo
            clHi = hi
        }
        i = i + 1
    }
    if cActive then {
        newDelta = (
            emitDiffHunk
            :buf
            :source
            :edits
            :cStart
            cEnd: m
            :clLo
            :clHi
            :lineStart
            :srcLines
            :newDelta
        )
    }
    return buf
}

# analyzeSource -- the fast-tier analysis over IN-MEMORY source: the
# read-then-analyze wrappers and zls's live editor buffers share it.
analyzeSource: function {source: String.take path: String.take opts: lintopts} out Analysis is {
    root: ast.parseSource source: source.copy
    lines: linesOf src: source.stringView
    a: (
        Analysis
        path: path.copy
        source: source.take
        :lines
        lineStart: ListVal u64
        diags: List zdiag.Diagnostic
        edits: List zfix.Edit
        fastToks: ListVal tokenize.token
        funcDepth: 0
        sufFnDepth: 0
        sufSite: ztypes.declid
        trueId: zast.nameid
        falseId: zast.nameid
        elsewhere: (IdMapR u32 V: DiagSrc)
        :opts
        lookupWords: (zast.Vocab.create block: lookupFn)
        complexities: List ComplexityFinding
    )
    a.runFastChecks n: root
    if opts.arch then a.reportDuplicateBodies prog: root
    a.walkTypeCasingProgram prog: root
    a.walkGenericParamCasingProgram prog: root
    if opts.casing then a.walkCasingProgram prog: root
    anyDocs: opts.docs
    if opts.docParams then anyDocs = true
    if opts.docFields then anyDocs = true
    if opts.docsQuality then anyDocs = true
    if opts.docsQuality then a.reportDuplicateDocs
    if anyDocs then (
        a.walkDocsProgram
        prog: root
        docs: opts.docs
        docParams: opts.docParams
        docFields: opts.docFields
    )
    a.checkLineLength width: opts.lineLength
    a.sortEditsInPlace
    return a
}

# analyzeFile -- fast-tier analysis of one file: read, fast-parse (no VFS/typecheck),
# build the line table, and collect parse-error diagnostics.
analyzeFile: function {path: String.take opts: lintopts} out Analysis is {
    rd: io.readText :path
    match (
        rd
    ) case ok then {
        return (analyzeSource source: rd.take path: path.copy :opts)
    } case err then {
        a: (
            Analysis
            path: path.copy
            source: "".string
            lines: List String
            lineStart: ListVal u64
            diags: List zdiag.Diagnostic
            edits: List zfix.Edit
            fastToks: ListVal tokenize.token
            funcDepth: 0
            sufFnDepth: 0
            sufSite: ztypes.declid
            trueId: zast.nameid
            falseId: zast.nameid
            elsewhere: (IdMapR u32 V: DiagSrc)
            :opts
            lookupWords: (zast.Vocab.create block: lookupFn)
            complexities: List ComplexityFinding
        )
        d: (
            zdiag.errorDiag
            errv: zast.err.ioError
            fsno: zvfs.fsno
            lineno: 0
            colno: 0
            width: 0
            msg: "could not read file".string
            note: "".string
            hint: "".string
        )
        a.diags.append d
        return a
    }
}

# analyzeFileFull -- fast-tier analysis plus the typecheck-tier suffix rule (L005). Builds the
# project VFS from `srcdir`/`systemdir` and typechecks this file's unit so the suffix check has
# resolved types. Slower than analyzeFile; only the --full path calls it.
analyzeFileFull: function {
    path: String.take
    # every --src root, searched in the order given
    srcdirs: (List String).view
    systemdir: StringView
    # the generated `z` unit the project mounts
    layer: zcheck.GenLayer.view
    opts: lintopts
    # the prelude the parse shares (zparser.PreludeStore)
    prelude: zparser.PreludeStore
} out Analysis is {
    rd: io.readText :path
    match (
        rd
    ) case ok then {
        root: ast.parseSource source: rd.copy
        lines: linesOf src: rd.stringView
        a: (
            Analysis
            path: path.copy
            source: rd.take
            :lines
            lineStart: ListVal u64
            diags: List zdiag.Diagnostic
            edits: List zfix.Edit
            fastToks: ListVal tokenize.token
            funcDepth: 0
            sufFnDepth: 0
            sufSite: ztypes.declid
            trueId: zast.nameid
            falseId: zast.nameid
            elsewhere: (IdMapR u32 V: DiagSrc)
            :opts
            lookupWords: (zast.Vocab.create block: lookupFn)
            complexities: List ComplexityFinding
        )
        a.runFastChecks n: root
        if opts.arch then a.reportDuplicateBodies prog: root
        a.walkTypeCasingProgram prog: root
        a.walkGenericParamCasingProgram prog: root
        anyDocs: opts.docs
        if opts.docParams then anyDocs = true
        if opts.docFields then anyDocs = true
        if opts.docsQuality then anyDocs = true
        if opts.docsQuality then a.reportDuplicateDocs
        if anyDocs then (
            a.walkDocsProgram
            prog: root
            docs: opts.docs
            docParams: opts.docParams
            docFields: opts.docFields
        )
        # a subunit file is parsed from its topmost unit, which names the parse
        top: topUnitPathOf file: a.path.stringView
        un: unitNameOf file: top.stringView
        (
            a.checkSuffix
            :srcdirs
            :systemdir
            :layer
            uname: un.stringView
            dataFile: (isDataFile file: a.path.stringView)
            :prelude
        )
        a.checkLineLength width: opts.lineLength
        a.sortEditsInPlace
        return a
    } case err then {
        a: (
            Analysis
            path: path.copy
            source: "".string
            lines: List String
            lineStart: ListVal u64
            diags: List zdiag.Diagnostic
            edits: List zfix.Edit
            fastToks: ListVal tokenize.token
            funcDepth: 0
            sufFnDepth: 0
            sufSite: ztypes.declid
            trueId: zast.nameid
            falseId: zast.nameid
            elsewhere: (IdMapR u32 V: DiagSrc)
            :opts
            lookupWords: (zast.Vocab.create block: lookupFn)
            complexities: List ComplexityFinding
        )
        d: (
            zdiag.errorDiag
            errv: zast.err.ioError
            fsno: zvfs.fsno
            lineno: 0
            colno: 0
            width: 0
            msg: "could not read file".string
            note: "".string
            hint: "".string
        )
        a.diags.append d
        return a
    }
}

# projectHint -- what names a project's roots for the typecheck tier.
projectHint: "name the project with --src DIR and --system DIR"

# analyzeFileTiered -- analyze one file at the requested tier: the fast tier by default, or
# the full (typecheck) tier under --full (which also needs the project src/system dirs).
analyzeFileTiered: function {
    path: String.take
    # every --src root, searched in the order given
    srcdirs: (List String).view
    systemdir: StringView
    # the generated `z` unit the project mounts, for the full tier
    layer: zcheck.GenLayer.view
    opts: lintopts
    # the prelude the full tier's parse shares (zparser.PreludeStore)
    prelude: zparser.PreludeStore
} out Analysis is {
    if opts.full then return (analyzeFileFull :path :srcdirs :systemdir :layer :opts :prelude)
    return (analyzeFile :path :opts)
}

# codepointLen -- number of Unicode codepoints in `s` (UTF-8 continuation bytes 0x80..0xBF are not
# counted); the display "column" length for the line-length rule.
codepointLen: function {s: StringView} out u64 is {
    n: s.length
    c: u64
    b: u64
    for b < n loop {
        bo: s.byteAt i: b
        cont: false
        if bo.some when bo >= 128 when bo < 192 then cont = true
        if cont.not then c = c + 1
        b = b + 1
    }
    return c
}

# sourceParses -- true if `source` parses with no embedded parse errors. `zl fmt`
# uses it to confirm an edited buffer is still valid before writing it out.
sourceParses: function {source: String.take} out bool is {
    a: (
        Analysis
        path: "".string
        source: "".string
        lines: List String
        lineStart: ListVal u64
        diags: List zdiag.Diagnostic
        edits: List zfix.Edit
        fastToks: ListVal tokenize.token
        funcDepth: 0
        sufFnDepth: 0
        sufSite: ztypes.declid
        trueId: zast.nameid
        falseId: zast.nameid
        elsewhere: (IdMapR u32 V: DiagSrc)
        opts: defaultOpts
        lookupWords: (zast.Vocab.create block: lookupFn)
        complexities: List ComplexityFinding
    )
    root: ast.parseSource :source
    a.walkProgram prog: root
    return a.parseErrorCount == 0
}

# hasHash -- true if the line contains a `#`, so a comment.
hasHash: function {line: StringView} out bool is {
    for each bo: line.byteView loop {
        if bo == ascii.hash then return true
    }
    return false
}

# takesArguments -- a callee whose arguments bind parameters by name: a
# function, or a user type, whose construction's fields are its parameters.
takesArguments: function {tt: ztypes.ztypetype} out bool is {
    return (tt == ztypes.ztypetype.functionType) or tt.isValueFamily or tt.isReferenceData
}

# builtinNumericTid -- `tid` is one of the builtin numeric scalars, asked without
# minting anything: a type named like one (a user type shadowing `u64`) or a
# typedef over one is not.
builtinNumericTid: function {ast: Ast.view st: zenv.ZSymbolTable tid: ztypes.tid} out bool is {
    ast.drop
    return (ztypecheck.numKindOfTid typing: st.typing :tid).has
}

# isNumericLiteralNode -- an atom spelled as a number: `5`, `0x1f`, the `5` of
# `5.u32`.
isNumericLiteralNode: function {ast: Ast.view n: astnode.view} out bool is {
    if n.atomid.not then return false
    nm: zast.nameTextAt :ast ref: n.name
    return (ztypecheck.isNumericLiteralName name: nm.stringView)
}

# operatorKind -- ztypes.operatorKindOf for the operator atom at `nid`.
operatorKind: function {ast: Ast.view nid: zast.nodeid} out u8 is {
    return (ztypes.operatorKindOf nameId: (zast.atomNameIdOf n: (ast.nodes.get i: nid)))
}

# groupedSpan -- the source between `lo` and `hi` is one parenthesised group:
# it ends in a `)` whose matching `(` opens before `lo`, with nothing between
# them but space and the opening parentheses of the operand's own first term.
groupedSpan: function {sv: StringView lo: u64 hi: u64} out bool is {
    if (hi == 0) or ((docByteAt s: sv i: hi - 1) != ascii.parenClose) then return false
    op: matchingOpenParen :sv close: hi - 1
    if op == 0 then return false
    i: op - 1
    # the group must open before the operand does, `((a) == b) or c`
    if i >= lo then return false
    k: i + 1
    for k < lo while (
        (ascii.isSpace b: (docByteAt s: sv i: k)) or ((docByteAt s: sv i: k) == ascii.parenOpen)
    ) loop {
        k = k + 1
    }
    return k >= lo
}

# matchingOpenParen -- the `(` matching the `)` at `close`, as its index plus
# one; 0 when none matches.
matchingOpenParen: function {sv: StringView close: u64} out u64 is {
    depth: u64
    i: close + 1
    for i > 0 loop {
        i = i - 1
        c: docByteAt s: sv :i
        if c == ascii.parenClose then depth = depth + 1
        if c == ascii.parenOpen then {
            depth = depth - 1
            if depth == 0 then return i + 1
        }
    }
    return 0
}

# fieldsReadNatively -- the type `site` defines declares a native method: its
# private fields are read by that method's C body, which no recorded reference
# can show, so none is unused for want of one (a handle only the runtime reads)
fieldsReadNatively: function {
    prog: Ast.view st: zenv.ZSymbolTable.view typeTid: ztypes.tid site: zast.namedsite
} out bool is {
    items: zast.objItemIds ast: prog nid: site.operation
    j: u64
    for j < items.length loop {
        member: zast.namedSiteAt ast: prog nid: (items.get i: j)
        j = j + 1
        if member.name.notZero then {
            md: st.typing.declTypedMemberIdOf parentTypeId: typeTid nameId: member.name
            if md.notZero then {
                mt: (st.typing.decls.get i: md).typeId
                isFn: (st.reg.typetypeOf typeId: mt) == ztypes.ztypetype.functionType
                if isFn when (st.reg.isNativeOf tid: mt) then return true
            }
        }
    }
    return false
}
