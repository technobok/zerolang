# zsource -- the analysis facade for zl. The fast tier reads and parses a
# single file (no VFS, no typecheck), builds a 1-based line table, and collects
# any embedded parse errors as ERROR diagnostics; the full tier (`--full`)
# builds the project VFS and typechecks for the type-dependent rules. The
# Analysis carries what the reporter and the fixer need.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :Analysis
    :analyzeFileTiered
    :analyzeSource
    :lintopts
    :defaultOpts
    :lineDiffEdits
    :renderDiff
    :sourceParses
    :unitNameOf
    :wrapSource
}

Node: zast.Node
Ast: zast.Ast

# lintopts -- which optional rules a lint run enables. One value threads from
# the command line to every rule, so a new rule is a field here, not a
# parameter added to every layer between them.
lintopts: record {
    # run the typecheck-tier rules too, which needs the project's src and system
    # directories
    full: bool
    # the column width to wrap at, and to report W005 against; 0 turns both off
    lineLength: u32
    # run L009, the variant/union member casing rule
    casing: bool
    # run L016, undocumented definitions
    docs: bool
    # run L017, undocumented parameters
    docParams: bool
    # run L018, undocumented members
    docFields: bool
    # measure a unit's WHOLE surface rather than only its `public:` block.
    # Without it a unit exporting a handful of names reports almost nothing
    docsPrivate: bool
    # run L024 and L025, which judge the docs that exist rather than counting
    # the ones missing
    docsQuality: bool
    # run the A-codes, which are advisory and ratcheted rather than gating
    arch: bool
}

# defaultOpts -- the fast tier with every optional rule off.
defaultOpts: function {} out lintopts is {
    return (lintopts
        full: false
        lineLength: 0
        casing: false
        docs: false
        docParams: false
        docFields: false
        docsPrivate: false
        docsQuality: false
        arch: false
    )
}

# ---- AST query helpers for the parse-tier rules ----

# The line count above which A005 reports a function. It counts RAW SOURCE SPAN from
# the definition to the deepest statement its body reaches, so a doc comment and an
# exploded parameter list both push a function toward it. A body that is one `match`
# is exempt: a dispatcher is as long as the arms it names.
longFunctionLines: 150.u32

# The body length from which A006 compares shapes: below it a match is a
# coincidence of small bodies, not a copy.
duplicateBodyLines: 8.u32

# unitOpOfName -- the unitdef node of the program's unit named `uname`, 0 when
# no unit has that name.
unitOpOfName: function {ast: Ast.view uname: StringView} out zast.nodeid is {
    with it: ast.units.iterate do for uId: it loop {
        u: ast.nodes.get i: uId.u64
        if u.namedoperation then {
            un: zast.nameTextAt :ast ref: u.name
            if un.stringView == uname then return u.operation
        }
    }
    return zast.nodeid
}

# unitNamesIn -- the unit names of the `.z` files directly under `dir`.
unitNamesIn: function {dir: StringView} out (List String) is {
    names: (List String)
    ents: io.listDir path: dir
    match (
        ents
    ) case ok then {
        with eit: ents.iterate do for e: eit loop {
            ev: e.stringView
            if (ev.endsWith suffix: ".z") then names.append from: (ev.substring
                from: 0
                to: (ev.length - 2)
            ).string
        }
    } case err then null
    return names
}

# projectReadNames -- the member names dotted reads reach in every `.z` file
# directly under `dir`, as text: a parse per file, the reassignment targets
# excluded (a write is not a read).
projectReadNames: function {dir: StringView into: Set String} is {
    ents: io.listDir path: dir
    match (
        ents
    ) case ok then {
        with eit: ents.iterate do for e: eit loop {
            ev: e.stringView
            if (ev.endsWith suffix: ".z") then {
                fp: "\{dir}/\{ev}"
                rd: io.readText path: fp
                match (
                    rd
                ) case ok then {
                    fileReadNames root: (ast.parseSource source: rd.take) :into
                } case err then null
            }
        }
    } case err then null
}

# projectUnitReads -- the member names read as `<unit>.<name>` in every `.z` file
# directly under `dir` other than the unit's own, as text: a parse per file.
projectUnitReads: function {dir: StringView uname: StringView into: Set String} is {
    own: "\{uname}.z"
    ents: io.listDir path: dir
    match (
        ents
    ) case ok then {
        with eit: ents.iterate do for e: eit loop {
            ev: e.stringView
            if (ev.endsWith suffix: ".z") when ev != own.stringView then {
                fp: "\{dir}/\{ev}"
                rd: io.readText path: fp
                match (
                    rd
                ) case ok then {
                    fileUnitReads root: (ast.parseSource source: rd.take) :uname :into
                } case err then null
            }
        }
    } case err then null
}

# fileUnitReads -- the child names of every `<unit>.<child>` dotted path in one
# parsed file, into `into`. A deeper path `unit.a.b` reads `a`, the export.
fileUnitReads: function {root: Node.view uname: StringView into: Set String} is {
    if root.program then {
        t: root.ast
        uid: zast.poolFind pool: t.names text: uname
        if uid.isZero then return
        ni: 1.u64
        nn: t.nodes.length
        for ni < nn loop {
            nd: t.nodes.get i: ni
            if nd.dottedpath then {
                pn: t.nodes.get i: nd.parent.u64
                if pn.atomid then {
                    if pn.name == uid then {
                        cn: t.nodes.get i: nd.child.u64
                        if cn.atomid then {
                            into.add item: (zast.poolTextCopy pool: t.names ref: cn.name)
                        }
                    }
                }
            }
            ni = ni + 1
        }
    }
}

# fileReadNames -- the dotted member reads of one parsed file, into `into`.
fileReadNames: function {root: Node.view into: Set String} is {
    if root.program then {
        t: root.ast
        topaths: (IdSet u64)
        ni: 1.u64
        nn: t.nodes.length
        for ni < nn loop {
            nd: t.nodes.get i: ni
            if nd.reassignment then {
                topaths.add item: nd.topath.u64
            }
            ni = ni + 1
        }
        nj: 1.u64
        for nj < nn loop {
            nd2: t.nodes.get i: nj
            if nd2.dottedpath then {
                if (topaths.has item: nj) == false then {
                    cn: t.nodes.get i: nd2.child.u64
                    if cn.atomid then {
                        into.add item: (zast.poolTextCopy pool: t.names ref: cn.name)
                    }
                }
            }
            nj = nj + 1
        }
    }
}

# plainLiteralText -- the text of a string literal with no interpolation
# (one literal chunk), none for any other node.
plainLiteralText: function {ast: Ast.view n: Node.view} out (Option String) is {
    match (
        n
    ) case atomstring then {
        if n.stringparts.length != 1 then return (Option.none String)
        c: ast.nodes.get i: (n.stringparts.get i: 0).u64
        match (
            c
        ) case stringchunk then {
            return (Option.some c.text.copy)
        } else {
            return (Option.none String)
        }
    } else {
        return (Option.none String)
    }
}

# lineLeavesBlock -- statement line `id` is a `return`, `break` or `continue`
# (bare, or a call of one), which leaves the block: nothing after it runs.
lineLeavesBlock: function {ast: Ast.view id: u32} out bool is {
    cur: id
    depth: 0
    for depth < 4 loop {
        n: ast.nodes.get i: cur.u64
        match (
            n
        ) case statementline then {
            cur = n.statementline.u32
        } case expression then {
            cur = n.expression.u32
        } case call then {
            cur = n.callable.u32
        } case atomid then {
            if n.name == zast.names.wkReturn then return true
            if n.name == zast.names.wkBreak then return true
            return n.name == zast.names.wkContinue
        } else return false
        depth = depth + 1
    }
    return false
}

# bodyKeyInto -- the shape of the subtree at `id`, appended to `buf`: every arm
# name, each binary operator and each literal chunk kept, every other name
# folded away. Two bodies with the same key differ only in what they call
# things -- the field they read, the map they probe, the helper they forward
# to -- which is what A006 exists to find.
bodyKeyInto: function {ast: Ast.view id: u32 buf: String.borrow} is {
    n: ast.nodes.get i: id.u64
    buf.append s: (zast.armName :n)
    match (
        n
    ) case binop then {
        op: ast.nodes.get i: n.operator.u64
        if op.atomid then {
            buf.appendByte b: 32
            buf.append s: (zast.nameTextAt :ast ref: op.name)
        }
    } case stringchunk then {
        buf.appendByte b: 34
        buf.append s: n.text
    } else null
    buf.appendByte b: 40
    kids: zast.childIdsAt :ast :id
    with it: kids.iterate do for k: it loop {
        bodyKeyInto :ast id: k :buf
        buf.appendByte b: 44
    }
    buf.appendByte b: 41
}

# bodyIsOneMatch -- the body is a single statement and that statement is a
# `match` over TWO OR MORE arms: a dispatcher, whose length is the number of
# arms it names. A one-arm match is a guard that unwraps its subject, not a
# dispatcher, and the body it guards is as long as it reads. The match sits
# under the line's expression wrapper, so the wrappers are peeled.
bodyIsOneMatch: function {ast: Ast.view bodyId: zast.nodeid} out bool is {
    if (zast.stmtLineCount :ast nid: bodyId) != 1 then return false
    id: zast.stmtLineAt :ast nid: bodyId i: 0
    depth: 0
    for depth < 4 loop {
        n: ast.nodes.get i: id.u64
        match (
            n
        ) case statementline then {
            id = n.statementline
        } case expression then {
            id = n.expression
        } case caseexpr then {
            return n.clauses.length > 1
        } else return false
        depth = depth + 1
    }
    return false
}

# isComposedParts -- a string literal's parts shaped like a composed key: two
# or more interpolation holes joined by a short separator with no space
# (`"\{a}.\{b}"`, `"\{unit}_\{name}"`). A message with holes reads as prose
# between them and is not one.
isComposedParts: function {ast: Ast.view parts: (ListVal u32).view} out bool is {
    holes: u64
    sepSinceHole: false
    composed: false
    with it: parts.iterate do for pId: it loop {
        part: ast.nodes.get i: pId.u64
        match (
            part
        ) case stringchunk then {
            if holes > 0 when (isKeySeparator s: part.text.stringView) then sepSinceHole = true
        } else {
            if holes > 0 when sepSinceHole then composed = true
            holes = holes + 1
            sepSinceHole = false
        }
    }
    return composed
}

# isKeySeparator -- one or two bytes, neither a space nor a path separator:
# what joins the halves of a composed key (a path is composed too, and is not
# a key).
isKeySeparator: function {s: StringView} out bool is {
    if s.length == 0 then return false
    if s.length > 2 then return false
    if (s.contains needle: " ") then return false
    if (s.contains needle: "/") then return false
    return true
}

# atomName -- the identifier name of an atomid node, else "".
atomName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# isStatementArm -- the node is a braced `{ ... }` statement block.
isStatementArm: function {n: Node.view} out bool is {
    match (
        n
    ) case statement then {
        return true
    } else {
        return false
    }
}

# isEmptyBlock -- a statement block with no statement lines (`{}`).
isEmptyBlock: function {n: Node.view} out bool is {
    match (
        n
    ) case statement then {
        return n.statements.length == 0
    } else {
        return false
    }
}

# stmtPos -- the source position of a statement block.
stmtPos: function {n: Node.view} out zast.nodepos is {
    match (
        n
    ) case statement then {
        return (zast.nodepos line: n.lineno col: n.colno)
    } else {
        return (zast.nodepos line: 0 col: 0)
    }
}

# isIfArm -- the node is an `if` (through an `expression` wrapper).
isIfArm: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case ifexpr then {
        return true
    } case expression then {
        return (isIfArm :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        return false
    }
}

# slIsIf -- a statement line wrapping an `if`.
slIsIf: function {ast: Ast.view sl: Node.view} out bool is {
    match (
        sl
    ) case statementline then {
        return (isIfArm :ast n: (ast.nodes.get i: sl.statementline.u64))
    } else {
        return false
    }
}

# isElseIfWrap -- the else clause is the synthetic block an `else if` chain parses
# to (a single statement line wrapping an `if`), not a real braced `else { ... }`.
isElseIfWrap: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case statement then {
        if n.statements.length == 1 then {
            res: false
            it: n.statements.iterate
            for slId: it loop {
                sl: ast.nodes.get i: slId.u64
                res = slIsIf :ast :sl
            }
            return res
        }
        return false
    } else {
        return false
    }
}

# debraceEligible -- the inner node of a single-statement clause body is a simple
# statement that de-braces safely: a call (including return/break/yield), a
# reassignment, a swap, a binop, a dotted path, or a bare atom -- never a binding
# `x: y`, a control-flow construct, or a data block.
debraceEligible: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (debraceEligible :ast n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        return true
    } case reassignment then {
        return true
    } case swapstmt then {
        return true
    } case binop then {
        return true
    } case dottedpath then {
        return true
    } case atomid then {
        return true
    } else {
        return false
    }
}

# clauseBodiesOnLine -- every then-body and the else-body of an `if` sit on the
# construct's start line `ln` (the whole `if ... else` is a one-liner).
clauseBodiesOnLine: function {
    ast: Ast.view
    clauses: (ListVal u32).view
    elseclauseId: zast.nodeid
    ln: u32
} out bool is {
    ok: true
    cit: clauses.iterate
    for clId: cit loop {
        cl: ast.nodes.get i: clId.u64
        if cl.ifclause then {
            p: stmtPos n: (ast.nodes.get i: cl.statement.u64)
            if p.line != ln then ok = false
        }
    }
    if elseclauseId > 0 then {
        pe: stmtPos n: (ast.nodes.get i: elseclauseId.u64)
        if pe.line != ln then ok = false
    }
    return ok
}

# caseBodiesOnLine -- every arm-body and the else-body of a `match` sit on the
# construct's start line `ln` (the whole `match` is a one-liner).
caseBodiesOnLine: function {
    ast: Ast.view
    clauses: (ListVal u32).view
    elseclauseId: zast.nodeid
    ln: u32
} out bool is {
    ok: true
    cit: clauses.iterate
    for clId: cit loop {
        cl: ast.nodes.get i: clId.u64
        if cl.caseclause then {
            p: stmtPos n: (ast.nodes.get i: cl.statement.u64)
            if p.line != ln then ok = false
        }
    }
    if elseclauseId > 0 then {
        pe: stmtPos n: (ast.nodes.get i: elseclauseId.u64)
        if pe.line != ln then ok = false
    }
    return ok
}

# primaryGenericParam -- the elidable first parameter name of a built-in template,
# or "" when `name` is not such a template. Index 0 only.
#
# The names are literals because this unit is the front end and has no symbol
# table to ask a template for its own. That makes the table the one place a
# parameter rename can go stale silently: a wrong entry stops L003 firing and
# nothing else here goes red. tests/fixtures/lsp_cases/lint_elidelabel pins one
# entry from each of the three groups so it cannot.
primaryGenericParam: function {name: StringView} out String is {
    if name == "List" then return "T".string
    if name == "ListRef" then return "T".string
    if name == "ListVal" then return "t".string
    if name == "ListView" then return "T".string
    if name == "ListViewVal" then return "t".string
    if name == "Set" then return "K".string
    if name == "SetRef" then return "K".string
    if name == "SetVal" then return "k".string
    if name == "array" then return "t".string
    if name == "Map" then return "K".string
    if name == "MapRR" then return "K".string
    if name == "MapRV" then return "K".string
    if name == "MapVR" then return "k".string
    if name == "MapVV" then return "k".string
    if name == "option" then return "t".string
    if name == "optionval" then return "t".string
    if name == "Option" then return "T".string
    if name == "OptionView" then return "T".string
    if name == "Result" then return "T".string
    return "".string
}


# casingSuggest -- the lowerCamelCase form of an ALL-CAPS / SCREAMING_SNAKE member name:
# split on `_`, lowercase each segment, and capitalise the first letter of every segment
# after the first. Compounds without underscores become run-together lowercase.
casingSuggest: function {name: StringView} out String is {
    buf: String
    n: name.length
    cap: false
    i: u64
    for i < n loop {
        bo: name.byteAt :i
        match (
            bo
        ) case some then {
            if bo == 95 then {
                cap = true
            } else {
                c: bo
                if c >= 65 when (c <= 90) then c = c + 32
                if cap when (buf.length > 0) then {
                    if c >= 97 when (c <= 122) then c = c - 32
                }
                buf.appendByte b: c
                cap = false
            }
        } case none then null
        i = i + 1
    }
    return buf
}

# casingClash -- true when `s` (a proposed lowercase member name) collides with a language
# keyword or a future-reserved word, and so cannot be used as-is.
casingClash: function {s: StringView} out bool is {
    kr: zlexer.kwlookup sv: s
    if kr.found then return true
    return (zlexer.islookupReserved sv: s)
}

# ---- L024/L025 doc-quality helpers (parse tier) ----

# docByteAt -- the byte at `i`, 0 past the end. The rules below index bytes constantly
# and none of them can act on an absent one.
docByteAt: function {s: StringView i: u64} out u8 is {
    bo: s.byteAt :i
    match (
        bo
    ) case some then {
        c: bo
        return c
    } case none then null
    return 0
}

# docByteIsWord -- true for the ASCII letters and digits a word is made of. Everything
# else -- punctuation, backticks, the `--` dash, path separators -- is a boundary.
docByteIsWord: function {b: u8} out bool is {
    if b >= 97 when (b <= 122) then return true
    if b >= 65 when (b <= 90) then return true
    if b >= 48 when (b <= 57) then return true
    return false
}

# docIsStopword -- true for a function word every doc shares, which therefore says
# nothing about what this one adds. One space-delimited string tested by substring
# rather than a compare chain: a table of literal compares is the shape A001 exists to
# discourage, and this needs no ids because a stopword IS its spelling.
docIsStopword: function {w: StringView} out bool is {
    if w.length == 0 then return true
    sw: " a an and any are as at be but by can for from has have if in into is it its may no not of on once one only or other over own same so than that the their them then there these they this those to up when where which while with without "
    probe: " \{w} "
    return (sw.contains needle: probe)
}

# docWordsInto -- append the lowercase alphanumeric runs of `s` to `into`.
docWordsInto: function {s: StringView into: (List String)} is {
    run: String
    i: u64
    n: s.length
    for i < n loop {
        c: docByteAt :s :i
        if (docByteIsWord b: c) then {
            if c >= 65 when (c <= 90) then c = c + 32
            run.appendByte b: c
        } else {
            if run.length > 0 then {
                into.append from: run.copy
                run = "".string
            }
        }
        i = i + 1
    }
    if run.length > 0 then into.append from: run.copy
}

# docAddRun -- one alphanumeric run of a declaration: the run lowercased, then each of
# its camel-case segments, so `ZSymbolTable` also offers `symbol` and `table` and a doc
# reading "the symbol table" is recognised as saying what the type already says.
docAddRun: function {run: StringView into: (List String)} is {
    whole: String
    seg: String
    i: u64
    n: run.length
    for i < n loop {
        c: docByteAt s: run :i
        isUp: false
        if c >= 65 when (c <= 90) then isUp = true
        if isUp when (seg.length > 0) then {
            into.append from: seg.copy
            seg = "".string
        }
        if isUp then c = c + 32
        seg.appendByte b: c
        whole.appendByte b: c
        i = i + 1
    }
    if seg.length > 0 then into.append from: seg.copy
    if whole.length > 0 then into.append from: whole.copy
}

# docVocabInto -- the vocabulary a declaration line offers a reader: every alphanumeric
# run in it and every camel-case segment of those runs. A doc built only from these adds
# nothing the name and the type cannot, which is the bar a comment has to clear.
docVocabInto: function {s: StringView into: (List String)} is {
    run: String
    i: u64
    n: s.length
    for i < n loop {
        c: docByteAt :s :i
        if (docByteIsWord b: c) then {
            run.appendByte b: c
        } else {
            if run.length > 0 then {
                docAddRun run: run.stringView :into
                run = "".string
            }
        }
        i = i + 1
    }
    if run.length > 0 then docAddRun run: run.stringView :into
}

# docHasWord -- membership by spelling. The list is a handful of words from one source
# line, so a scan beats building a set for it.
docHasWord: function {xs: (List String).view w: StringView} out bool is {
    found: false
    with it: xs.iterate do for e: it loop {
        if e.stringView == w then found = true
    }
    return found
}

# docFoldTemplate -- the words of a doc body with every word the declaration itself
# supplies, and every word carrying a digit (a width, a count), folded to `_`: a body
# written once per type or per bit-width reads as the one body it is.
docFoldTemplate: function {
    words: (List String).view
    vocab: (List String).view
} out (List String) is {
    folded: (List String)
    with it: words.iterate do for w: it loop {
        fold: docHasWord xs: vocab w: w.stringView
        if (fold) == false then fold = docHasDigit w: w.stringView
        if fold then {
            folded.append from: "_".string
        } else {
            folded.append from: w.copy
        }
    }
    return folded
}

# docHasDigit -- the word carries a decimal digit.
docHasDigit: function {w: StringView} out bool is {
    i: u64
    n: w.length
    for i < n loop {
        c: docByteAt s: w :i
        if c >= 48 when (c <= 57) then return true
        i = i + 1
    }
    return false
}

# docJoinWords -- the words joined by single spaces: the normalised key two doc bodies
# are the same under. Case, punctuation and wrapping all wash out here, so a comment
# re-wrapped at a different width still matches its twin.
docJoinWords: function {xs: (List String).view} out String is {
    buf: String
    with it: xs.iterate do for w: it loop {
        if buf.length > 0 then buf.appendByte b: 32
        buf.append s: w
    }
    return buf
}

# docStripComment -- the declaration text of a source line, its trailing `#` comment
# removed. The comment is what is being judged, so it cannot also be the evidence.
docStripComment: function {ln: StringView} out StringView is {
    i: u64
    n: ln.length
    for i < n loop {
        c: docByteAt s: ln :i
        if c == 35 then return (ln.substring from: 0 to: i)
        i = i + 1
    }
    return ln
}

# docTrailingComment -- the text after a line's `#`, "" when it has none. A member may
# be documented by a trailing comment instead of a block above, and both forms are read
# by hover, so both are judged.
docTrailingComment: function {ln: StringView} out String is {
    i: u64
    n: ln.length
    for i < n loop {
        c: docByteAt s: ln :i
        if c == 35 then {
            t: ln.substring from: (i + 1) to: n
            return t.trim.string
        }
        i = i + 1
    }
    return "".string
}

# docStartsLine -- true when column `col` is the first non-space character of its line,
# so the declaration standing there owns the doc block above it. A parameter sharing the
# function's head line does not: the block above is the FUNCTION's doc, and a trailing
# comment belongs to whichever declaration on the line comes last.
docStartsLine: function {ln: StringView col: u32} out bool is {
    if col < 1 then return false
    n: (col - 1).u64
    if n > ln.length then return false
    i: u64
    for i < n loop {
        c: docByteAt s: ln :i
        isSpace: false
        if c == 32 then isSpace = true
        if c == 9 then isSpace = true
        if isSpace == false then return false
        i = i + 1
    }
    return true
}

# docLineIsComment -- true when the line's first non-space character is `#`.
docLineIsComment: function {ln: StringView} out bool is {
    t: ln.trim
    return (t.startsWith "#")
}

# ---- L023 generic-param-casing helpers (parse tier) ----

# genericBoundBase -- the bound's base identifier as WRITTEN in a generic
# parameter declaration: `AnyRef` out of `AnyRef.generic`, and out of the
# parenthesised `(Any.generic default: null)` form. "" when the leaf is
# `.valtype` or `.reftype`, which name a kind rather than a type and so carry
# no case to compare -- a shape the parser accepts and the typechecker rejects
# (`Unknown type 'reftype'`), so the arm is defensive, not reachable from a
# program that compiles. It unwraps the same expression and call wrappers
# `zast.isGenericParamOp` does, and must keep doing so: a reader that unwrapped
# fewer would report the shapes it never looked at as conformant, and the
# parenthesised form is the one parameter in the tree that would go unseen.
genericBoundBase: function {ast: Ast.view opId: u32} out String is {
    if opId == 0 then return "".string
    n: ast.nodes.get i: opId.u64
    match (
        n
    ) case expression then {
        return (genericBoundBase :ast opId: n.expression)
    } case call then {
        return (genericBoundBase :ast opId: n.callable)
    } case dottedpath then {
        c: ast.nodes.get i: n.child.u64
        isGen: false
        match (
            c
        ) case atomid then {
            if (zast.nameTextEq :ast ref: c.name s: "generic") then isGen = true
        } case labelvalue then {
            if (zast.nameTextEq :ast ref: c.name s: "generic") then isGen = true
        } else null
        if (isGen) == false then return "".string
        return (atomName :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# byteIsUpper -- true when an optional source byte is an ASCII capital.
byteIsUpper: function {b: (optionval u8)} out bool is {
    match (
        b
    ) case some then {
        if b >= 65 when (b <= 90) then return true
        return false
    } case none then {
        return false
    }
}

# flipFirstCase -- `s` with its first ASCII letter's case inverted, which is the
# spelling the case rule asks for. A name that starts with neither case comes
# back unchanged.
flipFirstCase: function {s: StringView} out String is {
    buf: String
    n: s.length
    i: u64
    for i < n loop {
        bo: s.byteAt :i
        match (
            bo
        ) case some then {
            c: bo
            if i == 0 then {
                d: c
                if c >= 65 when (c <= 90) then d = c + 32
                if c >= 97 when (c <= 122) then d = c - 32
                c = d
            }
            buf.appendByte b: c
        } case none then null
        i = i + 1
    }
    return buf
}

# casingMessage -- the L009 diagnostic text: a direct rename when the lowerCamelCase form is
# usable, or a role-suffixed alternative when it clashes with a keyword/reserved word.
casingMessage: function {orig: StringView sug: StringView} out String is {
    if (casingClash s: sug) then {
        return "member '\{orig}' is not lowerCamelCase -- '\{sug}' is a keyword; use a role suffix, e.g. '\{sug}Kind' (type-kind) / '\{sug}Def' (AST node)"
    }
    return "member '\{orig}' is not lowerCamelCase -- rename to '\{sug}'"
}

# trailingWsLen -- number of trailing ASCII-whitespace bytes (space, tab, CR) in
# `ln`. Computed by hand (StringView.trimEnd's native is not emitted).
trailingWsLen: function {ln: StringView} out u64 is {
    n: ln.length
    k: u64
    keep: true
    for keep loop {
        if k >= n then {
            keep = false
        } else {
            bo: ln.byteAt i: (n - 1 - k)
            isws: false
            match (
                bo
            ) case some then {
                if bo == 32 then isws = true
                if bo == 9 then isws = true
                if bo == 13 then isws = true
            } case none then null
            if isws then {
                k = k + 1
            } else {
                keep = false
            }
        }
    }
    return k
}

# endsWithNewline -- true if `src` is empty or its last byte is a newline.
endsWithNewline: function {src: StringView} out bool is {
    n: src.length
    if n == 0 then return true
    bo: src.byteAt i: (n - 1)
    match (
        bo
    ) case some then {
        if bo == 10 then return true
        return false
    } case none then {
        return true
    }
}

# the working state of one file's lint/format analysis: the source and
# its line table, the collected diagnostics and fix edits, and the raw
# token stream shared across the checks.
Analysis: class {
    # the file being analysed, for the diagnostics to name
    path: String
    # its full text, owned for the analysis's life
    source: String
    # the text split into lines, which the doc and wrap rules read directly
    # rather than through the tree
    lines: (List String)
    # each line's byte offset, so a token's position converts to an offset
    # without rescanning
    lineStart: (ListVal u64)
    # the findings, in the order they were made
    diags: (List zdiag.Diagnostic)
    # the byte-range replacements a fix would apply
    edits: (List zfix.Edit)
    # the width wrapping targets; 0 disables it
    wrapWidth: u32
    # a byte offset before which nothing is wrapped
    wrapSkip: u64
    # whether this pass wrapped anything. Only the FIRST over-long construct per
    # pass is wrapped, and the fixpoint handles the rest
    wrapFound: bool
    # the line the current wrap began on, so the same one is not wrapped twice
    wrapStart: u64
    # each opening delimiter's matching close, so a signature's `}` is found by
    # the map rather than by line end
    delimClose: (IdMapV u64 v: u64)
    # the token stream, for the rules that need tokens and not a tree
    fastToks: (List tokenize.Token)
    # how deep in nested functions the walk is
    funcDepth: u64
    # the argument groups a wrap has already decided about
    wrapGroups: (ListVal u64)
    # which optional rules this run enables. One value threads from the command
    # line to every rule, so a new rule is a field here and not a parameter on
    # every layer between
    opts: lintopts
} as {
    # parseErrorCount -- how many collected diagnostics are hard (ERROR) -- i.e.
    # parse errors. The fmt parse gate refuses any file with a non-zero count.
    parseErrorCount: function {:this} out u64 is {
        c: u64
        with it: this.diags.iterate do for d: it loop {
            match (
                d.sev
            ) case error then {
                c = c + 1
            } else null
        }
        return c
    }

    # failCount -- diagnostics that fail the gate: everything except advisory INFO. `zl lint` exits
    # non-zero on a non-zero count, so INFO rules (line-length) report without failing.
    failCount: function {:this} out u64 is {
        c: u64
        with it: this.diags.iterate do for d: it loop {
            isInfo: false
            match (
                d.sev
            ) case info then {
                isInfo = true
            } else null
            if (isInfo) == false then c = c + 1
        }
        return c
    }

    # warnFix -- append a WARNING diagnostic AND its single safe fix edit (a
    # replacement of source[lo, hi) with `repl`). Used by the format rules.
    warnFix: function {:this code: StringView msg: String.take line: u32 col: u32 width: u32 lo: u64 hi: u64 repl: String.take} is {
        this.warn :code :msg :line :col :width
        this.edits.append (zfix.Edit byteLo: lo byteHi: hi replacement: repl)
    }

    # checkTrailingWs -- W001: trailing whitespace on a line. Byte-exact from line
    # byte-lengths (independent of the codepoint-based column).
    checkTrailingWs: function {:this} is {
        lls: linesOf src: this.source.stringView
        off: u64
        lno: 1.u32
        with it: lls.iterate do for ln: it loop {
            llen: ln.length
            twl: trailingWsLen ln: ln.stringView
            if twl > 0 then {
                keptLen: llen - twl
                (this.warnFix
                    code: "W001"
                    msg: "trailing whitespace".string
                    line: lno
                    col: (keptLen + 1).u32.orPanic
                    width: twl.u32.orPanic
                    lo: (off + keptLen)
                    hi: (off + llen)
                    repl: "".string
                )
            }
            off = off + llen + 1
            lno = lno + 1
        }
    }

    # checkFinalNewline -- W002: a non-empty file that does not end in a newline.
    checkFinalNewline: function {:this} is {
        n: this.source.length
        if n > 0 when ((endsWithNewline src: this.source.stringView) == false) then {
            (this.warnFix
                code: "W002"
                msg: "file does not end with a newline".string
                line: 0
                col: 0
                width: 0
                lo: n
                hi: n
                repl: "\n".string
            )
        }
    }

    # checkBlankLines -- W004: collapse a run of 3 or more consecutive blank lines (empty or
    # whitespace-only) to a single blank line, deleting the extras. Byte-exact from the line
    # start index; runs of two or fewer are left alone.
    checkBlankLines: function {:this} is {
        srcOwned: this.source
        sv: srcOwned.stringView
        lls: linesOf src: sv
        lineStart: lineStartIndex src: sv
        nLines: lls.length
        srcLen: sv.length
        i: u64
        for i < nLines loop {
            ln: lls.get :i
            blank: (trailingWsLen ln: ln.stringView) == ln.length
            if blank then {
                e: i + 1
                scanning: true
                for scanning loop {
                    if e >= nLines then {
                        scanning = false
                    } else {
                        le: lls.get i: e
                        lblank: (trailingWsLen ln: le.stringView) == le.length
                        if lblank then {
                            e = e + 1
                        } else {
                            scanning = false
                        }
                    }
                }
                runLen: e - i
                if runLen >= 3 then {
                    lo: lineStart.get i: (i + 1)
                    hi: srcLen
                    if e < nLines then hi = lineStart.get i: e
                    (this.warnFix
                        code: "W004"
                        msg: "too many consecutive blank lines".string
                        line: (i + 2).u32.orPanic
                        col: 1
                        width: 1
                        :lo
                        :hi
                        repl: "".string
                    )
                }
                i = e
            } else {
                i = i + 1
            }
        }
    }
    # walkOptAt -- the id-taking entry (0 = absent).
    walkOptAt: function {:this ast: Ast.view oId: zast.nodeid} is {
        if oId.isZero then return
        o: ast.nodes.get i: oId.u64
        this.walk :ast n: o
    }

    # warn -- append a WARNING lint diagnostic (fast tier: no fsno; the single-file
    # reporter resolves the source line from the line table).
    warn: function {:this code: StringView msg: String.take line: u32 col: u32 width: u32} is {
        d: (zdiag.Diagnostic
            code: code.string
            sev: zdiag.severity.warning
            fsno: zvfs.fsno
            lineno: line
            colno: col
            :width
            :msg
            note: "".string
            hint: "".string
        )
        this.diags.append d
    }

    # info -- append an advisory INFO diagnostic (does not fail the gate; carries no fix).
    info: function {:this code: StringView msg: String.take line: u32 col: u32 width: u32} is {
        d: (zdiag.Diagnostic
            code: code.string
            sev: zdiag.severity.info
            fsno: zvfs.fsno
            lineno: line
            colno: col
            :width
            :msg
            note: "".string
            hint: "".string
        )
        this.diags.append d
    }

    # checkLineLength -- W005 (advisory): a line wider than `width` codepoints. INFO severity, so it
    # reports but never fails the gate; runs only when a width is set (--line-length). No fix.
    checkLineLength: function {:this width: u32} is {
        if width == 0 then return
        lls: linesOf src: this.source.stringView
        lno: 1.u32
        with it: lls.iterate do for ln: it loop {
            cl: codepointLen s: ln.stringView
            if cl > width.u64 then {
                (this.info
                    code: "W005"
                    msg: "line exceeds \{width} columns (\{cl})"
                    line: lno
                    col: (width + 1)
                    width: 1
                )
            }
            lno = lno + 1
        }
    }

    # checkEmpty -- L001 empty `else {}` and, for a backwards single-condition `if`,
    # the empty `then {}` (via checkEmptyThen). Receives an ifexpr's else + clauses.
    checkEmpty: function {:this ast: Ast.view elseclauseId: zast.nodeid clauses: (ListVal u32).view} is {
        if elseclauseId.isZero then return
        elseNode: ast.nodes.get i: elseclauseId.u64
        if (isEmptyBlock n: elseNode) then {
            p: stmtPos n: elseNode
            (this.warn
                code: "L001"
                msg: "empty `else { }` clause".string
                line: p.line
                col: p.col
                width: 2
            )
        } else if (isStatementArm n: elseNode) when (clauses.length == 1) then {
            if (isElseIfWrap :ast n: elseNode) == false then {
                citer: clauses.iterate
                for c0Id: citer loop {
                    this.checkEmptyThen :ast clause: (ast.nodes.get i: c0Id.u64)
                }
            }
        }
    }

    # checkEmptyThen -- L002 a single-condition clause whose `then {}` is empty.
    checkEmptyThen: function {:this ast: Ast.view clause: Node.view} is {
        if clause.ifclause then {
            cst: ast.nodes.get i: clause.statement.u64
            if (isEmptyBlock n: cst) when (clause.conditions.length == 1) then {
                p: stmtPos n: (ast.nodes.get i: clause.statement.u64)
                (this.warn
                    code: "L002"
                    msg: "empty `then { }` clause".string
                    line: p.line
                    col: p.col
                    width: 2
                )
            }
        }
    }

    # checkElide -- L003 a built-in template call whose first argument carries its
    # primary parameter name. Receives the narrowed callable + argument list.
    checkElide: function {:this ast: Ast.view callable: Node.view arguments: (ListVal u32).view} is {
        cn: atomName :ast n: callable
        if cn.length == 0 then return
        primary: primaryGenericParam name: cn.stringView
        if primary.length == 0 then return
        idx: u64
        aiter: arguments.iterate
        for aId: aiter loop {
            if idx == 0 then {
                (this.checkElideFirst
                    :ast
                    arg: (ast.nodes.get i: aId.u64)
                    primary: primary.stringView
                )
            }
            idx = idx + 1
        }
    }

    # checkElideFirst -- flag the first generic argument when its label is the
    # template's primary parameter name.
    checkElideFirst: function {:this ast: Ast.view arg: Node.view primary: StringView} is {
        if arg.namedoperation then {
            if (zast.nameTextEq :ast ref: arg.name s: primary) then {
                w: primary.length + 1
                (this.warn
                    code: "L003"
                    msg: "redundant `\{primary}:` label on a built-in template's first argument"
                    line: arg.lineno
                    col: arg.colno
                    width: w.u32.orPanic
                )
            }
        }
    }

    # checkCollapseName -- L006: a named argument `name: name` whose label equals its bare-atom
    # value collapses to the `:name` shorthand (same atomVariableId stamp -- codegen-neutral once
    # the emitter treats labelvalue == atomid). Fires on atomid values only, so it is idempotent:
    # a `:name` parses to a labelvalue and atomName returns "".
    checkCollapseName: function {:this ast: Ast.view arguments: (ListVal u32).view} is {
        if this.lineStart.length == 0 then return
        aiter: arguments.iterate
        for aId: aiter loop {
            a: ast.nodes.get i: aId.u64
            if a.namedoperation then {
                label: zast.nameTextAt :ast ref: a.name
                val: atomName :ast n: (ast.nodes.get i: a.operation.u64)
                lsv: label.stringView
                vsv: val.stringView
                if lsv.length > 0 when vsv.length > 0 when lsv == vsv then {
                    lo: (tokByteStart
                        lineStart: this.lineStart
                        srcLines: this.lines
                        lineno: a.lineno
                        colno: a.colno
                    )
                    vi: nodeInfoOf n: (ast.nodes.get i: a.operation.u64)
                    hi: (tokByteStart
                        lineStart: this.lineStart
                        srcLines: this.lines
                        lineno: vi.line
                        colno: vi.col
                    )
                    (this.warnFix
                        code: "L006"
                        msg: "redundant label repeating its value; use the :name shorthand".string
                        line: a.lineno
                        col: a.colno
                        width: (lsv.length).u32.orPanic
                        :lo
                        :hi
                        repl: ":".string
                    )
                }
            }
        }
    }

    # tryWrapCall -- wrap mode (--line-length): if this over-long single-line call has >= 2 named
    # args and starts at/after wrapSkip, emit the wrap edits (one arg per line at base+4; a `(` is
    # added when the call is bare) and set wrapFound. Only the first such call per pass is wrapped;
    # wrapSource's re-parse gate + fixpoint handle discards and the rest.
    tryWrapCall: function {:this ast: Ast.view arguments: (ListVal u32).view line: u32 col: u32} is {
        if line.u64 == this.wrapStart then return
        ac: arguments.length
        if ac < 2 then return
        lidx: (line - 1).u64
        if lidx >= this.lines.length then return
        lnt: (this.lines.get i: lidx)
        cw: codepointLen s: lnt.stringView
        if cw <= this.wrapWidth.u64 then return
        if (hasHash line: lnt.stringView) then return
        cs: tokByteStart lineStart: this.lineStart srcLines: this.lines lineno: line colno: col
        ok: true
        with vit: arguments.iterate do for argId: vit loop {
            arg: ast.nodes.get i: argId.u64
            match (
                arg
            ) case namedoperation then {
                if arg.lineno != line then ok = false
                anm: zast.nameTextAt :ast ref: arg.name
                if anm.length == 0 then ok = false
            } else {
                ok = false
            }
        }
        if ok == false then return
        base: leadingSpaces line: lnt.stringView
        srcOwned: this.source
        srcv: srcOwned.stringView
        bare: true
        if cs > 0 then {
            pb: srcv.byteAt i: (cs - 1)
            match (
                pb
            ) case some then {
                if pb == 40 then bare = false
            } case none then null
        }
        lsb: this.lineStart.get i: lidx
        contentEnd: lsb + (rstripLen line: lnt.stringView)
        ind4: nlIndent n: (base + 4)
        ind0: nlIndent n: base
        closePos: contentEnd
        clo: "\{ind0})"
        if bare == false then {
            coff: this.delimClose.get key: (cs - 1)
            match (
                coff
            ) case some then {
                closePos = coff
                clo = ind0.copy
            } case none then {
                return
            }
        }
        this.wrapGroups.append this.edits.length
        if bare then this.edits.append (zfix.Edit byteLo: cs byteHi: cs replacement: "(".string)
        with ait: arguments.iterate do for argId: ait loop {
            arg: ast.nodes.get i: argId.u64
            if arg.namedoperation then {
                startByte: (tokByteStart
                    lineStart: this.lineStart
                    srcLines: this.lines
                    lineno: arg.lineno
                    colno: arg.colno
                )
                ap: startByte
                match (
                    (ast.nodes.get i: arg.operation.u64)
                ) case labelvalue then {
                    ap = startByte - 1
                } else null
                ws: wsRunStart src: srcv from: ap
                this.edits.append (zfix.Edit byteLo: ws byteHi: ap replacement: ind4.copy)
            }
        }
        this.edits.append (zfix.Edit byteLo: closePos byteHi: closePos replacement: clo)
        this.wrapFound = true
        this.wrapStart = line.u64
    }

    # tryWrapParams -- wrap mode: an over-long single-line function signature with >= 2 params breaks
    # its `{ }` param block onto one-param-per-line (the `{ }` already filters eol). Same batch/fixpoint
    # bookkeeping as tryWrapCall; the close `}` is located via the delimiter map, not line-end.
    tryWrapParams: function {:this ast: Ast.view parameters: (ListVal u32).view line: u32} is {
        if line.u64 == this.wrapStart then return
        pc: parameters.length
        if pc < 2 then return
        lidx: (line - 1).u64
        if lidx >= this.lines.length then return
        lnt: (this.lines.get i: lidx)
        cw: codepointLen s: lnt.stringView
        if cw <= this.wrapWidth.u64 then return
        if (hasHash line: lnt.stringView) then return
        ok: true
        with vit: parameters.iterate do for pmId: vit loop {
            pm: ast.nodes.get i: pmId.u64
            match (
                pm
            ) case namedoperation then {
                if pm.lineno != line then ok = false
            } else {
                ok = false
            }
        }
        if ok == false then return
        base: leadingSpaces line: lnt.stringView
        srcOwned: this.source
        srcv: srcOwned.stringView
        p0: u64
        haveParams: false
        {
            p0nodeId: parameters.get i: 0
            p0node: ast.nodes.get i: p0nodeId.u64
            if p0node.namedoperation then {
                p0 = (tokByteStart
                    lineStart: this.lineStart
                    srcLines: this.lines
                    lineno: p0node.lineno
                    colno: p0node.colno
                )
                haveParams = true
            }
        }
        if haveParams == false then return
        obrace: (wsRunStart src: srcv from: p0) - 1
        bchk: srcv.byteAt i: obrace
        isBrace: false
        match (
            bchk
        ) case some then {
            if bchk == 123 then isBrace = true
        } case none then null
        if isBrace == false then return
        coff: this.delimClose.get key: obrace
        closeB: u64
        match (
            coff
        ) case some then {
            closeB = coff
        } case none then {
            return
        }
        ind4: nlIndent n: (base + 4)
        ind0: nlIndent n: base
        this.wrapGroups.append this.edits.length
        with ait: parameters.iterate do for pmId: ait loop {
            pm: ast.nodes.get i: pmId.u64
            if pm.namedoperation then {
                ps: (tokByteStart
                    lineStart: this.lineStart
                    srcLines: this.lines
                    lineno: pm.lineno
                    colno: pm.colno
                )
                pp: ps
                match (
                    (ast.nodes.get i: pm.operation.u64)
                ) case labelvalue then {
                    pp = ps - 1
                } else null
                ws: wsRunStart src: srcv from: pp
                this.edits.append (zfix.Edit byteLo: ws byteHi: pp replacement: ind4.copy)
            }
        }
        wsC: wsRunStart src: srcv from: closeB
        this.edits.append (zfix.Edit byteLo: wsC byteHi: closeB replacement: ind0.copy)
        this.wrapFound = true
        this.wrapStart = line.u64
    }

    # checkForWhile -- L004 token tier: a `for` immediately followed by `while`.
    # Re-tokenizes the source (parse-free; immune to strings and comments).
    checkForWhile: function {:this} is {
        srcOwned: this.source
        sv: srcOwned.stringView
        scanPool: zast.StringPool.create
        toks: tokenize.scan source: srcOwned.copy pool: scanPool
        lineStart: lineStartIndex src: sv
        srcLines: linesOf src: sv
        m: toks.length
        prevFor: false
        i: u64
        for i < m loop {
            t: toks.get :i
            match (
                t.toktype
            ) case wsTok then null case eolTok then null case commentTok then null case forTok then {
                prevFor = true
            } case whileTok then {
                if prevFor then {
                    whileStart: tokByteStart :lineStart :srcLines lineno: t.lineno colno: t.colno
                    condStart: whileStart + t.width.u64
                    foundCond: false
                    j: i + 1
                    scanning: true
                    for scanning loop {
                        if j >= m then {
                            scanning = false
                        } else {
                            tj: toks.get i: j
                            triv: false
                            match (
                                tj.toktype
                            ) case wsTok then {
                                triv = true
                            } case eolTok then {
                                triv = true
                            } case commentTok then {
                                triv = true
                            } else null
                            if triv then {
                                j = j + 1
                            } else {
                                condStart = (tokByteStart
                                    :lineStart
                                    :srcLines
                                    lineno: tj.lineno
                                    colno: tj.colno
                                )
                                foundCond = true
                                scanning = false
                            }
                        }
                    }
                    if foundCond then {
                        (this.warnFix
                            code: "L004"
                            msg: "redundant `while`: a for loop's leading condition omits `while`".string
                            line: t.lineno
                            col: t.colno
                            width: t.width
                            lo: whileStart
                            hi: condStart
                            repl: "".string
                        )
                    }
                }
                prevFor = false
            } else {
                prevFor = false
            }
            i = i + 1
        }
    }

    # checkColonSpacing -- W003 token tier: exactly one space after a `:` when a value follows
    # on the same line. The `:label` shorthand (a colon immediately before a LABELPRE, e.g.
    # `:this`) and a colon at end of line (value continues below) are left alone. Walks the raw
    # token stream, so colons inside strings and comments are never touched.
    checkColonSpacing: function {:this} is {
        srcOwned: this.source
        sv: srcOwned.stringView
        scanPool: zast.StringPool.create
        toks: tokenize.scan source: srcOwned.copy pool: scanPool
        lineStart: lineStartIndex src: sv
        srcLines: linesOf src: sv
        m: toks.length
        i: u64
        for i < m loop {
            t: toks.get :i
            isColon: false
            match (
                t.toktype
            ) case colonTok then {
                isColon = true
            } else null
            if isColon then {
                cl: t.lineno
                cc: t.colno
                shorthand: false
                if (i + 1) < m then {
                    t1: toks.get i: (i + 1)
                    match (
                        t1.toktype
                    ) case labelPreTok then {
                        shorthand = true
                    } else null
                }
                if (shorthand) == false then {
                    j: i + 1
                    foundNxt: false
                    nxtContent: false
                    nl: u32
                    nc: u32
                    for j < m loop {
                        tj: toks.get i: j
                        isWs: false
                        isTerm: false
                        match (
                            tj.toktype
                        ) case wsTok then {
                            isWs = true
                        } case eolTok then {
                            isTerm = true
                        } case eofTok then {
                            isTerm = true
                        } case commentTok then {
                            isTerm = true
                        } case parenCloseTok then {
                            isTerm = true
                        } case braceCloseTok then {
                            isTerm = true
                        } case semicolonTok then {
                            isTerm = true
                        } else null
                        if isWs then {
                            j = j + 1
                        } else {
                            foundNxt = true
                            nl = tj.lineno
                            nc = tj.colno
                            nxtContent = (isTerm) == false
                            break
                        }
                    }
                    if foundNxt when nxtContent when (nl == cl) then {
                        colByteStart: tokByteStart :lineStart :srcLines lineno: cl colno: cc
                        colEnd: colByteStart + 1
                        valStart: tokByteStart :lineStart :srcLines lineno: nl colno: nc
                        doFix: false
                        if valStart == colEnd then {
                            doFix = true
                        } else if valStart == (colEnd + 1) then {
                            bo: sv.byteAt i: colEnd
                            issp: false
                            match (
                                bo
                            ) case some then {
                                if bo == 32 then issp = true
                            } case none then null
                            if (issp) == false then doFix = true
                        } else if valStart > colEnd then doFix = true
                        if doFix then {
                            (this.warnFix
                                code: "W003"
                                msg: "expected a single space after `:`".string
                                line: cl
                                col: cc
                                width: 1
                                lo: colEnd
                                hi: valStart
                                repl: " ".string
                            )
                        }
                    }
                }
            }
            i = i + 1
        }
    }

    # walkProgram -- root entry of the parse-tier rule visitor: the table
    # rides inside the program node.
    walkProgram: function {:this prog: Node.view} is {
        if prog.program then {
            this.walkIds ast: prog.ast ids: prog.ast.units
        }
    }

    # reportDuplicateBodies -- A006: a function body, eight lines or longer,
    # whose shape (bodyKeyInto) another function in this file already has. The
    # first site is the original; each later one is reported against it.
    reportDuplicateBodies: function {:this prog: Node.view} is {
        firstAt: (MapRV String v: u64)
        if prog.program then {
            ui: u64
            un: prog.ast.units.length
            for ui < un loop {
                uid: prog.ast.units.get i: ui
                this.dupBodyWalk ast: prog.ast id: uid :firstAt
                ui = ui + 1
            }
        }
    }

    # dupBodyWalk -- one node of the duplicate-body pass: a function's body is
    # keyed and looked up; every child is visited.
    dupBodyWalk: function {:this ast: Ast.view id: u32 firstAt: (MapRV String v: u64)} is {
        n: ast.nodes.get i: id.u64
        if n.functiondef then {
            if (n.body.isZero) == false then {
                span: ((zast.spanEndLineAt :ast id: n.body.u32) - n.lineno) + 1
                if span >= duplicateBodyLines then {
                    key: String
                    bodyKeyInto :ast id: n.body.u32 buf: key
                    seen: firstAt.get :key
                    match (
                        seen
                    ) case some then {
                        (this.info
                            code: "A006"
                            msg: "this body has the shape of the one at line \{seen}; one function, with the difference as an argument"
                            line: n.lineno
                            col: n.colno
                            width: 1
                        )
                    } case none then {
                        firstAt.set key: key.copy value: n.lineno.u64
                    }
                }
            }
        }
        kids: zast.childIdsAt :ast :id
        with it: kids.iterate do for k: it loop this.dupBodyWalk :ast id: k :firstAt
    }

    # walkTypeCasingProgram / walkTypeCasingAt -- L021 (default-on): a type
    # definition's name casing follows its kind -- record/variant/facet
    # lowercase, class/union/protocol/generator PascalCase (styleguide Naming).
    walkTypeCasingProgram: function {:this prog: Node.view} is {
        if prog.program then {
            tci: u64
            tcn: prog.ast.units.length
            for tci < tcn loop {
                tcid: (zast.nodeid.create from: (prog.ast.units.get i: tci))
                this.walkTypeCasingAt ast: prog.ast nId: tcid
                tci = tci + 1
            }
        }
    }

    # the id-taking entry to the type-casing walk, so the caller can lend the
    # tree without holding a node view
    walkTypeCasingAt: function {:this ast: Ast.view nId: zast.nodeid} is {
        n: ast.nodes.get i: nId.u64
        match (
            n
        ) case namedoperation then {
            this.walkTypeCasingAt :ast nId: n.operation
        } case unitdef then {
            it: n.body.iterate
            for bId: it loop {
                bm: ast.nodes.get i: bId.u64
                if bm.namedoperation then {
                    op: ast.nodes.get i: bm.operation.u64
                    if op.objectdef then {
                        (this.checkTypeNameCasing
                            :ast
                            nameRef: bm.name
                            line: bm.lineno
                            col: bm.colno
                            kind: op.kind
                        )
                    }
                }
            }
        } else null
    }

    # checkTypeNameCasing -- flag a valtype name carrying a capital, or a
    # reftype name that does not start with one.
    checkTypeNameCasing: function {:this ast: Ast.view nameRef: zast.nameid line: u32 col: u32 kind: zast.objectkind} is {
        isVal: false
        if kind == zast.objectkind.recordDef then isVal = true
        if kind == zast.objectkind.variantDef then isVal = true
        if kind == zast.objectkind.facetDef then isVal = true
        isRef: false
        if kind == zast.objectkind.classDef then isRef = true
        if kind == zast.objectkind.unionDef then isRef = true
        if kind == zast.objectkind.protocolDef then isRef = true
        if kind == zast.objectkind.generatorDef then isRef = true
        if isVal == false when isRef == false then return
        nm: zast.nameTextAt :ast ref: nameRef
        hasUpper: false
        ci: u64
        cln: nm.length
        for ci < cln loop {
            cb: nm.stringView.byteAt i: ci
            match (
                cb
            ) case some then {
                if cb >= 65 when cb <= 90 then hasUpper = true
            } case none then null
            ci = ci + 1
        }
        firstUpper: false
        fb: nm.stringView.byteAt i: 0
        match (
            fb
        ) case some then {
            if fb >= 65 when fb <= 90 then firstUpper = true
        } case none then null
        bad: false
        msg: String
        if isVal when hasUpper then {
            bad = true
            msg = "valtype '\{nm}' should be lowercase -- record/variant/facet names run their words together without capitals"
        }
        if isRef when firstUpper == false then {
            bad = true
            msg = "reftype '\{nm}' should be PascalCase -- class/union/protocol/generator names start with a capital"
        }
        if bad then {
            (this.warn
                code: "L021"
                :msg
                :line
                :col
                width: nm.length.u32.orPanic
            )
        }
    }

    # walkGenericParamCasingProgram -- L023 (default-on): a generic parameter's
    # case matches the case of its bound's name, so a reader sees the ownership
    # family at the point of use (styleguide Naming). A linear sweep of the node
    # table rather than a descent: a parameter sits in an objectdef's as-block,
    # a functiondef's as-block or a unit body, and a walk taught only some of
    # those carriers would pass the rest in silence.
    walkGenericParamCasingProgram: function {:this prog: Node.view} is {
        if prog.program then {
            gi: u64
            gn: prog.ast.nodes.length
            for gi < gn loop {
                gm: prog.ast.nodes.get i: gi
                if gm.namedoperation then {
                    if (zast.isGenericParamOp ast: prog.ast opId: gm.operation) then {
                        (this.checkGenericParamCasing
                            ast: prog.ast
                            nameRef: gm.name
                            opId: gm.operation
                            line: gm.lineno
                            col: gm.colno
                        )
                    }
                }
                gi = gi + 1
            }
        }
    }

    # checkGenericParamCasing -- flag a generic parameter whose first character's
    # case differs from its bound's. A bound with no base name is skipped rather
    # than guessed at: answering for a shape the reader could not read would be
    # reporting a check that never ran.
    checkGenericParamCasing: function {:this ast: Ast.view nameRef: zast.nameid opId: u32 line: u32 col: u32} is {
        bnd: genericBoundBase :ast :opId
        if bnd.length == 0 then return
        nm: zast.nameTextAt :ast ref: nameRef
        if nm.length == 0 then return
        nUp: byteIsUpper b: (nm.stringView.byteAt i: 0)
        bUp: byteIsUpper b: (bnd.stringView.byteAt i: 0)
        if nUp == bUp then return
        want: flipFirstCase s: nm.stringView
        msg: "generic parameter '\{nm}' should be '\{want}' -- a parameter's case matches the case of its bound, and the bound is '\{bnd}'"
        (this.warn
            code: "L023"
            :msg
            :line
            :col
            width: nm.length.u32.orPanic
        )
    }

    # the root entry to the member-casing walk
    walkCasingProgram: function {:this prog: Node.view} is {
        if prog.program then {
            wci: u64
            wcn: prog.ast.units.length
            for wci < wcn loop {
                wcid: (zast.nodeid.create from: (prog.ast.units.get i: wci))
                this.walkCasingAt ast: prog.ast nId: wcid
                wci = wci + 1
            }
        }
    }

    # walk -- the parse-tier rule visitor: the arms a rule reads are spelled,
    # then every child is visited through zast.childIds.
    walk: function {:this ast: Ast.view n: Node.view} is {
        match (
            n
        ) case error then {
            d: (zdiag.errorDiag
                errv: n.err
                fsno: n.fsno
                lineno: n.lineno
                colno: n.colno
                width: n.width
                msg: n.msg.copy
                note: n.note.copy
                hint: n.hint.copy
            )
            this.diags.append d
        } case binop then {
            if this.opts.arch then {
                this.checkLiteralCompare :ast opId: n.operator lhsId: n.lhs rhsId: n.rhs
            }
        } case call then {
            if this.wrapWidth > 0 then {
                this.tryWrapCall :ast arguments: n.arguments line: n.lineno col: n.colno
            } else {
                (this.checkElide
                    :ast
                    callable: (ast.nodes.get i: n.callable.u64)
                    arguments: n.arguments
                )
                this.checkCollapseName :ast arguments: n.arguments
            }
        } case atomstring then {
            if this.opts.arch then (this.checkComposedKey
                :ast
                parts: n.stringparts
                line: n.lineno
                col: n.colno
            )
        } case assignment then {
            if this.funcDepth > 0 then (this.tryBareZeroInit
                :ast
                value: (ast.nodes.get i: n.value.u64)
            )
        } case ifexpr then {
            this.checkEmpty :ast elseclauseId: n.elseclause clauses: n.clauses
            this.checkBracesIf :ast clauses: n.clauses elseclauseId: n.elseclause ln: n.lineno
            this.checkChainBodyBreak :ast clauses: n.clauses elseclauseId: n.elseclause
        } case forexpr then {
            this.checkBracesFor :ast bodyId: n.body
        } case caseexpr then {
            this.checkBracesMatch :ast clauses: n.clauses elseclauseId: n.elseclause ln: n.lineno
            this.checkChainBodyBreak :ast clauses: n.clauses elseclauseId: n.elseclause
            this.checkNullArms :ast clauses: n.clauses elseclauseId: n.elseclause
        } case statement then {
            this.checkUnreachable :ast stmts: n.statements
        } case functiondef then {
            if this.opts.arch then (this.checkLongFunction
                :ast
                bodyId: n.body
                line: n.lineno
                col: n.colno
            )
            # the body is walked one function deeper; the signature is not
            if this.wrapWidth > 0 then (this.tryWrapParams
                :ast
                parameters: n.parameters
                line: n.lineno
            )
            this.walkOptAt :ast oId: n.returntype
            this.walkIds :ast ids: n.parameters
            this.funcDepth = this.funcDepth + 1
            this.walkOptAt :ast oId: n.body
            this.funcDepth = this.funcDepth - 1
            this.walkIds :ast ids: n.asItems
            return
        } else null
        this.walkIds :ast ids: (zast.childIds :ast :n)
    }

    # walk a list of child nodes in order
    walkIds: function {:this ast: Ast.view ids: (ListVal u32).view} is {
        with it: ids.iterate do for c: it loop this.walk :ast n: (ast.nodes.get i: c.u64)
    }

    # ---- architecture rules (zl lint --arch) ----

    # checkLiteralCompare -- A001: `==` / `!=` against a string literal. The
    # compiler compares by id -- a name id, a declaration, a type id -- and a
    # literal here is a name the code resolves by spelling.
    checkLiteralCompare: function {:this ast: Ast.view opId: zast.nodeid lhsId: zast.nodeid rhsId: zast.nodeid} is {
        op: atomName :ast n: (ast.nodes.get i: opId.u64)
        isCmp: op.stringView == "=="
        if op.stringView == "!=" then isCmp = true
        if (isCmp) == false then return
        this.literalCompareSide :ast id: lhsId
        this.literalCompareSide :ast id: rhsId
    }

    # one side of a comparison, answering whether it is a string literal --
    # which is what A001 reports
    literalCompareSide: function {:this ast: Ast.view id: zast.nodeid} is {
        n: ast.nodes.get i: id.u64
        txt: plainLiteralText :ast :n
        match (
            txt
        ) case some then {
            p: zast.posOf :n
            (this.info
                code: "A001"
                msg: "string literal `\{txt}` compared by spelling; compare an id (name id, declaration, type id)"
                line: p.line
                col: p.col
                width: 1
            )
        } case none then null
    }

    # checkComposedKey -- A002: a string literal shaped like a composed key
    # (holes joined by a separator) -- a spelling that stands in for a tree
    # walk or a pair key.
    checkComposedKey: function {:this ast: Ast.view parts: (ListVal u32).view line: u32 col: u32} is {
        if (isComposedParts :ast :parts) == false then return
        (this.info
            code: "A002"
            msg: "composed string key: key the table by ids (a pair record, or walk the tree)".string
            :line
            :col
            width: 1
        )
    }

    # checkUnreachable -- L026: a statement after one that leaves its block
    # (`return`, `break`, `continue`) can never run. Reported once per block,
    # at the first statement past the exit.
    checkUnreachable: function {:this ast: Ast.view stmts: (ListVal u32).view} is {
        i: u64
        n: stmts.length
        for i < n loop {
            sid: stmts.get :i
            i = i + 1
            if i < n when (lineLeavesBlock :ast id: sid) then {
                p: zast.posOf n: (ast.nodes.get i: (stmts.get :i).u64)
                (this.warn
                    code: "L026"
                    msg: "unreachable statement: the block has already returned or jumped".string
                    line: p.line
                    col: p.col
                    width: 1
                )
                return
            }
        }
    }

    # checkLongFunction -- A005: a function whose body spans more than
    # longFunctionLines source lines, measured from the definition to the
    # deepest statement it reaches (one line above the closing brace). A body
    # that is one `match` is exempt: splitting a dispatcher hides the shape it
    # exists to show.
    checkLongFunction: function {:this ast: Ast.view bodyId: zast.nodeid line: u32 col: u32} is {
        if bodyId.isZero then return
        if (bodyIsOneMatch :ast :bodyId) then return
        lastLine: zast.spanEndLineAt :ast id: bodyId.u32
        span: (lastLine - line) + 1
        if span > longFunctionLines then {
            (this.info
                code: "A005"
                msg: "function spans \{span} lines; split it into named helpers"
                :line
                :col
                width: 1
            )
        }
    }

    # walkCasingAt -- the id-taking entry for the casing visitor.
    walkCasingAt: function {:this ast: Ast.view nId: zast.nodeid} is {
        n: ast.nodes.get i: nId.u64
        this.walkCasing :ast :n
    }

    # walkCasing -- opt-in (L009): recurse to every type definition and check the member
    # casing of `variant` / `union` declarations. Runs only under `zl lint --casing`.
    walkCasing: function {:this ast: Ast.view n: Node.view} is {
        match (
            n
        ) case program then {
            it: n.ast.units.iterate
            for uId: it loop this.walkCasing :ast n: (ast.nodes.get i: uId.u64)
        } case unitdef then {
            it: n.body.iterate
            for bId: it loop this.walkCasing :ast n: (ast.nodes.get i: bId.u64)
        } case namedoperation then {
            this.walkCasing :ast n: (ast.nodes.get i: n.operation.u64)
        } case objectdef then {
            this.checkMemberCasing :ast kind: n.kind items: n.isItems
        } else null
    }

    # checkMemberCasing -- flag each variant/union arm whose name starts with an uppercase
    # letter (not lowerCamelCase), with a suggested rename (see casingSuggest/casingMessage).
    checkMemberCasing: function {:this ast: Ast.view kind: zast.objectkind items: (ListVal u32).view} is {
        isVU: false
        if kind == zast.objectkind.variantDef then isVU = true
        if kind == zast.objectkind.unionDef then isVU = true
        if isVU == false then return
        it: items.iterate
        for itemId: it loop {
            item: ast.nodes.get i: itemId.u64
            if item.namedoperation then {
                isTypeRef: false
                match (
                    (ast.nodes.get i: item.operation.u64)
                ) case labelvalue then {
                    isTypeRef = true
                } else null
                nm: zast.nameTextAt :ast ref: item.name
                fb: nm.stringView.byteAt i: 0
                up: false
                match (
                    fb
                ) case some then {
                    if fb >= 65 when (fb <= 90) then up = true
                } case none then null
                if up when (isTypeRef == false) then {
                    sug: casingSuggest name: nm.stringView
                    (this.warn
                        code: "L009"
                        msg: (casingMessage orig: nm.stringView sug: sug.stringView)
                        line: item.lineno
                        col: item.colno
                        width: nm.length.u32.orPanic
                    )
                }
            }
        }
    }

    # checkPublicPosProgram -- L019 entry: check every unit's `public:` block placement.
    checkPublicPosProgram: function {:this prog: Node.view} is {
        if prog.program then {
            cui: u64
            cun: prog.ast.units.length
            for cui < cun loop {
                cuid: (zast.nodeid.create from: (prog.ast.units.get i: cui))
                this.checkPublicPosAt ast: prog.ast nId: cuid
                cui = cui + 1
            }
        }
    }

    # checkPublicPosAt -- L019: a unit's `public:` block must sit at the top,
    # before any definition (only the file header comment may precede it).
    checkPublicPosAt: function {:this ast: Ast.view nId: zast.nodeid} is {
        wn: ast.nodes.get i: nId.u64
        if wn.namedoperation then {
            ud: ast.nodes.get i: wn.operation.u64
            if ud.unitdef then {
                sawDef: false
                with cbit: ud.body.iterate do for cbId: cbit loop {
                    mn: ast.nodes.get i: cbId.u64
                    if mn.namedoperation then {
                        isPub: (zast.unitOpKindIs
                            :ast
                            opId: mn.operation
                            k: zast.unitkind.publicNs
                        )
                        isPriv: (zast.unitOpKindIs
                            :ast
                            opId: mn.operation
                            k: zast.unitkind.privateNs
                        )
                        # `require:` states what the unit needs from the host
                        # toolchain; it is not a definition in it.
                        isReq: (zast.unitOpKindIs
                            :ast
                            opId: mn.operation
                            k: zast.unitkind.requirement
                        )
                        if isPub when sawDef then {
                            (this.warn
                                code: "L019"
                                msg: "the public interface block must be at the top of the unit, before any definition".string
                                line: mn.lineno
                                col: mn.colno
                                width: 6
                            )
                        }
                        if (isPub == false) when (isPriv == false) when (isReq == false) then {
                            sawDef = true
                        }
                    }
                }
            }
        }
    }

    # hasDocAbove -- true when the source line directly above `line1` (1-based)
    # is a `#` comment line -- the start of a leading doc block.
    hasDocAbove: function {:this line1: u32} out bool is {
        result: false
        if line1 < 2 then return result
        idx: (line1 - 2).u64
        if idx >= this.lines.length then return result
        ln: this.lines.get i: idx
        lv: ln.stringView
        lt: lv.trim
        if lt.startsWith "#" then result = true
        return result
    }

    # reportUndocDef -- warn L016 when a definition (type / function / method) has
    # no leading `#` doc block. `nameRef` gives the underline width.
    reportUndocDef: function {:this ast: Ast.view nameRef: zast.nameid line: u32 col: u32} is {
        if (this.hasDocAbove line1: line) then return
        nm: zast.nameTextAt :ast ref: nameRef
        (this.warn
            code: "L016"
            msg: "missing doc comment: add a `#` comment above this definition".string
            :line
            :col
            width: nm.length.u32.orPanic
        )
    }

    # checkDocsMember -- a parameter or field counts as documented by a leading
    # `#` block or a trailing `#` on its own line; warn `code`/`kind` otherwise.
    checkDocsMember: function {:this ast: Ast.view member: Node.view code: StringView kind: StringView} is {
        if member.namedoperation then {
            nm: zast.nameTextAt :ast ref: member.name
            skip: false
            if nm.stringView == "this" then skip = true
            if skip == false then {
                documented: false
                if (this.hasDocAbove line1: member.lineno) then documented = true
                if documented == false then {
                    li: (member.lineno - 1).u64
                    if li < this.lines.length then {
                        mline: this.lines.get i: li
                        if (hasHash line: mline.stringView) then documented = true
                    }
                }
                if documented == false then {
                    msg: "missing doc comment: add a `#` comment above this \{kind}"
                    (this.warn
                        :code
                        :msg
                        line: member.lineno
                        col: member.colno
                        width: nm.length.u32.orPanic
                    )
                }
                if documented when this.opts.docsQuality then {
                    (this.reportDocEcho
                        :ast
                        nameRef: member.name
                        line: member.lineno
                        col: member.colno
                    )
                }
            }
        }
    }

    # docBlockAbove -- the contiguous `#` block directly above `line1`, markers dropped
    # and lines joined by spaces; "" when there is none. This is the same block hover
    # renders, so a rule reading it judges what a reader actually sees.
    docBlockAbove: function {:this line1: u32} out String is {
        buf: String
        if line1 < 2 then return buf
        lo: (line1 - 2).u64
        if lo >= this.lines.length then return buf
        last: this.lines.get i: lo
        if (docLineIsComment ln: last.stringView) == false then return buf
        top: lo
        more: true
        for more loop {
            if top == 0 then {
                more = false
            } else {
                prev: this.lines.get i: (top - 1)
                if (docLineIsComment ln: prev.stringView) then {
                    top = top - 1
                } else more = false
            }
        }
        i: top
        for i <= lo loop {
            ln: this.lines.get :i
            t: ln.stringView.trim
            body: t.substring from: 1 to: t.length
            if buf.length > 0 then buf.appendByte b: 32
            buf.append s: body.trim
            i = i + 1
        }
        return buf
    }

    # reportDocEcho -- L024: every content word of the doc already appears in the
    # declaration it sits above, so the doc restates the name and the type instead of
    # saying why the thing exists. That is the bar a comment has to clear, made
    # mechanical, and it is also the cheapest way to satisfy a coverage ratchet -- the
    # corpus writes these without one, so the ratchet ships paired with this.
    reportDocEcho: function {:this ast: Ast.view nameRef: zast.nameid line: u32 col: u32} is {
        li: (line - 1).u64
        if li >= this.lines.length then return
        doc: this.docBlockAbove line1: line
        # own the line: a live view into this.lines would hold a shared lock across the
        # warn below, which needs the receiver exclusively.
        decl: (this.lines.get i: li).copy
        if (docStartsLine ln: decl.stringView :col) == false then return
        if doc.length == 0 then doc = docTrailingComment ln: decl.stringView
        if doc.length == 0 then return
        vocab: (List String)
        docVocabInto s: (docStripComment ln: decl.stringView) into: vocab
        words: (List String)
        docWordsInto s: doc.stringView into: words
        novel: u64
        with wit: words.iterate do for w: wit loop {
            if (docIsStopword w: w.stringView) == false then {
                if (docHasWord xs: vocab w: w.stringView) == false then novel = novel + 1
            }
        }
        if novel > 0 then return
        nm: zast.nameTextAt :ast ref: nameRef
        (this.warn
            code: "L024"
            msg: "this doc only re-says the declaration below it; say why it exists, or rename it so no comment is needed".string
            :line
            :col
            width: nm.length.u32.orPanic
        )
    }

    # reportDuplicateDocs -- L025: the same doc body on more than two definitions in one
    # file. A real invariant stated at forty sites is one invariant and thirty-nine
    # copies: state it once, in the unit header, and leave the sites bare. Blocks under
    # four words are section markers and separators, not docs, and are not counted.
    # Bodies are compared with the declaration's own words and every width folded
    # out, so "u8 to i16: every u8 fits i16" and its u16 twin are one body.
    reportDuplicateDocs: function {:this} is {
        keys: (List String)
        starts: (ListVal u64)
        counts: (MapRV String v: u64)
        i: u64
        n: this.lines.length
        for i < n loop {
            head: this.lines.get :i
            if (docLineIsComment ln: head.stringView) == false then {
                i = i + 1
            } else {
                st: i
                buf: String
                more: true
                for more loop {
                    if i >= n then {
                        more = false
                    } else {
                        ln: this.lines.get :i
                        t: ln.stringView.trim
                        if t.startsWith "#" then {
                            body: t.substring from: 1 to: t.length
                            if buf.length > 0 then buf.appendByte b: 32
                            buf.append s: body.trim
                            i = i + 1
                        } else more = false
                    }
                }
                ws: (List String)
                docWordsInto s: buf.stringView into: ws
                if ws.length >= 4 then {
                    vocab: (List String)
                    if i < n then {
                        decl: (this.lines.get :i).copy
                        docVocabInto s: (docStripComment ln: decl.stringView) into: vocab
                    }
                    folded: docFoldTemplate words: ws :vocab
                    key: docJoinWords xs: folded
                    c: u64
                    cur: counts.get :key
                    match (
                        cur
                    ) case some then {
                        c = cur
                    } case none then null
                    counts.set key: key.copy value: (c + 1)
                    keys.append from: key.copy
                    starts.append from: st
                }
            }
        }
        j: u64
        for j < keys.length loop {
            k: keys.get i: j
            c2: u64
            cur2: counts.get key: k
            match (
                cur2
            ) case some then {
                c2 = cur2
            } case none then null
            if c2 > 2 then {
                s2: starts.get i: j
                (this.warn
                    code: "L025"
                    msg: "this doc body appears \{c2} times in this file; state it once, in the unit header, and leave the sites bare"
                    line: (s2 + 1).u32.orPanic
                    col: 1
                    width: 1
                )
            }
            j = j + 1
        }
    }

    # walkDocsAsItem -- one as-block member. A generic parameter is a MEMBER a reader
    # hovers, so it reports L018 like a field or an arm; everything else in an as-block
    # is a nested definition to descend into. Both carriers of an as-block, a type's
    # and a function's, hand their members here.
    walkDocsAsItem: function {
        :this
        ast: Ast.view
        m: Node.view
        docs: bool
        docParams: bool
        docFields: bool
    } is {
        isGP: false
        if m.namedoperation then {
            if (zast.isGenericParamOp :ast opId: m.operation) then isGP = true
        }
        if isGP then {
            if docFields then (this.checkDocsMember
                :ast
                member: m
                code: "L018"
                kind: "generic parameter"
            )
            return
        }
        this.walkDocs :ast n: m :docs :docParams :docFields
    }

    # walkDocs -- opt-in doc-coverage pass. L016 flags a type/function/method with
    # no leading `#` block; L017 an undocumented parameter; L018 an undocumented
    # record/class field. Each tier is gated by its own flag.
    walkDocs: function {:this ast: Ast.view n: Node.view docs: bool docParams: bool docFields: bool} is {
        match (
            n
        ) case program then {
            wit: n.ast.units.iterate
            for uId: wit loop {
                this.walkDocs :ast n: (ast.nodes.get i: uId.u64) :docs :docParams :docFields
            }
        } case unitdef then {
            pubSet: (IdSet u64)
            hasPub: false
            with pit: n.body.iterate do for pId: pit loop {
                pm: ast.nodes.get i: pId.u64
                if pm.namedoperation then {
                    if (zast.unitOpKindIs
                        :ast
                        opId: pm.operation
                        k: zast.unitkind.publicNs
                    ) then {
                        hasPub = true
                        pu: ast.nodes.get i: pm.operation.u64
                        if pu.unitdef then {
                            with eit: pu.body.iterate do for eId: eit loop {
                                en: ast.nodes.get i: eId.u64
                                if en.namedoperation then {
                                    eo: ast.nodes.get i: en.operation.u64
                                    match (
                                        eo
                                    ) case atomid then {
                                        pubSet.add item: eo.name.u64
                                    } else {
                                        pubSet.add item: en.name.u64
                                    }
                                }
                            }
                        }
                    }
                }
            }
            # --docs-private measures the whole unit: a unit with a `public:` block
            # has no public surface to filter BY, so every member is walked. The
            # compiler's units export a handful of names each -- zemitterc.z exports 2
            # of 741 -- so without this the pass reports 0 and means nothing.
            if this.opts.docsPrivate then hasPub = false
            with bit: n.body.iterate do for bId: bit loop {
                member: ast.nodes.get i: bId.u64
                keep: true
                if member.namedoperation then {
                    if (zast.unitOpKindIs
                        :ast
                        opId: member.operation
                        k: zast.unitkind.publicNs
                    ) then keep = false
                    if (zast.unitOpKindIs
                        :ast
                        opId: member.operation
                        k: zast.unitkind.privateNs
                    ) then keep = false
                    if (zast.unitOpKindIs
                        :ast
                        opId: member.operation
                        k: zast.unitkind.requirement
                    ) then keep = false
                    if hasPub when keep then {
                        inPub: pubSet.has item: member.name.u64
                        isMain: zast.nameTextEq :ast ref: member.name s: "main"
                        if (inPub == false) when (isMain == false) then keep = false
                    }
                }
                if keep then this.walkDocs :ast n: member :docs :docParams :docFields
            }
        } case namedoperation then {
            op: ast.nodes.get i: n.operation.u64
            match (
                op
            ) case functiondef then {
                if docs then this.reportUndocDef :ast nameRef: n.name line: n.lineno col: n.colno
                if this.opts.docsQuality then (this.reportDocEcho
                    :ast
                    nameRef: n.name
                    line: n.lineno
                    col: n.colno
                )
                if docParams then {
                    pit: op.parameters.iterate
                    for pmId: pit loop {
                        (this.checkDocsMember
                            :ast
                            member: (ast.nodes.get i: pmId.u64)
                            code: "L017"
                            kind: "parameter"
                        )
                    }
                }
                ait: op.asItems.iterate
                for amId: ait loop {
                    (this.walkDocsAsItem
                        :ast
                        m: (ast.nodes.get i: amId.u64)
                        :docs
                        :docParams
                        :docFields
                    )
                }
            } case objectdef then {
                if docs then this.reportUndocDef :ast nameRef: n.name line: n.lineno col: n.colno
                if this.opts.docsQuality then (this.reportDocEcho
                    :ast
                    nameRef: n.name
                    line: n.lineno
                    col: n.colno
                )
                isRC: false
                if op.kind == zast.objectkind.recordDef then isRC = true
                if op.kind == zast.objectkind.classDef then isRC = true
                if op.kind == zast.objectkind.generatorDef then isRC = true
                isVU: false
                if op.kind == zast.objectkind.variantDef then isVU = true
                if op.kind == zast.objectkind.unionDef then isVU = true
                isPF: false
                if op.kind == zast.objectkind.protocolDef then isPF = true
                if op.kind == zast.objectkind.facetDef then isPF = true
                if docFields when isRC then {
                    fit: op.isItems.iterate
                    for fId: fit loop {
                        (this.checkDocsMember
                            :ast
                            member: (ast.nodes.get i: fId.u64)
                            code: "L018"
                            kind: "field"
                        )
                    }
                }
                # an arm reaches a reader the same way a field does -- hovered, one line
                # of prose -- so it is the same code with its own noun.
                if docFields when isVU then {
                    vit: op.isItems.iterate
                    for vId: vit loop {
                        (this.checkDocsMember
                            :ast
                            member: (ast.nodes.get i: vId.u64)
                            code: "L018"
                            kind: "arm"
                        )
                    }
                }
                # a protocol's and a facet's members are METHOD DECLARATIONS, which sit
                # in the is-block where a record keeps its fields. They are definitions,
                # so they descend to L016 rather than reporting as members.
                if isPF then {
                    pit9: op.isItems.iterate
                    for pfId: pit9 loop {
                        (this.walkDocs
                            :ast
                            n: (ast.nodes.get i: pfId.u64)
                            :docs
                            :docParams
                            :docFields
                        )
                    }
                }
                amit: op.asItems.iterate
                for oamId: amit loop {
                    (this.walkDocsAsItem
                        :ast
                        m: (ast.nodes.get i: oamId.u64)
                        :docs
                        :docParams
                        :docFields
                    )
                }
            } case unitdef then {
                (this.walkDocs
                    :ast
                    n: (ast.nodes.get i: n.operation.u64)
                    :docs
                    :docParams
                    :docFields
                )
            } else null
        } else null
    }

    # walkDocsAt -- the id-taking entry: the node view is this frame's, so the
    # program loop can lend prog.ast without an outstanding view lock.
    walkDocsAt: function {:this ast: Ast.view nId: zast.nodeid docs: bool docParams: bool docFields: bool} is {
        n: ast.nodes.get i: nId.u64
        this.walkDocs :ast :n :docs :docParams :docFields
    }

    # walkDocsProgram -- root entry for the doc-coverage pass.
    walkDocsProgram: function {:this prog: Node.view docs: bool docParams: bool docFields: bool} is {
        if prog.program then {
            wdi: u64
            wdn: prog.ast.units.length
            for wdi < wdn loop {
                wdid: (zast.nodeid.create from: (prog.ast.units.get i: wdi))
                this.walkDocsAt ast: prog.ast nId: wdid :docs :docParams :docFields
                wdi = wdi + 1
            }
        }
    }

    # checkNullArms -- L010 over a match's arm and else bodies.
    checkNullArms: function {:this ast: Ast.view clauses: (ListVal u32).view elseclauseId: zast.nodeid} is {
        ccit: clauses.iterate
        for ccId: ccit loop {
            cc: ast.nodes.get i: ccId.u64
            if cc.caseclause then {
                this.tryNullBody body: (ast.nodes.get i: cc.statement.u64)
            }
        }
        if elseclauseId > 0 then {
            this.tryNullBody body: (ast.nodes.get i: elseclauseId.u64)
        }
    }

    # tryBareZeroInit -- L011: a zero/empty binding initializer written as a
    # literal (`"".string`, `0.u64`) where the bare type name constructs the
    # same value. Function-body binding initializers only: record/class
    # fields and parameter defaults keep literal values (a bare type name
    # there is an annotation), and reassignment right-hand sides prefer the
    # coerced bare literal (`x = 0`). The replacement span is byte-verified
    # against the expected source spelling before any edit is recorded.
    tryBareZeroInit: function {:this ast: Ast.view value: Node.view} is {
        match (
            value
        ) case expression then {
            this.tryBareZeroInit :ast value: (ast.nodes.get i: value.expression.u64)
        } case statementline then {
            this.tryBareZeroInit :ast value: (ast.nodes.get i: value.statementline.u64)
        } case statement then {
            if value.statements.length == 1 then {
                s0Id: value.statements.get i: 0
                this.tryBareZeroInit :ast value: (ast.nodes.get i: s0Id.u64)
            }
        } case dottedpath then {
            repl: bareZeroTypeName :ast n: (ast.nodes.get i: value.child.u64)
            if repl.length == 0 then return
            ptext: bareZeroParentText :ast n: (ast.nodes.get i: value.parent.u64)
            if ptext.length == 0 then return
            isStr: ptext.stringView == "\"\""
            isStrRepl: repl.stringView == "String"
            if isStr when (isStrRepl) == false then return
            if (isStr) == false when isStrRepl then return
            pin: nodeInfoOf n: (ast.nodes.get i: value.parent.u64)
            cin: nodeInfoOf n: (ast.nodes.get i: value.child.u64)
            if pin.line != cin.line then return
            srcOwned: this.source
            srcv: srcOwned.stringView
            lo: (tokByteStart
                lineStart: this.lineStart
                srcLines: this.lines
                lineno: pin.line
                colno: pin.col
            )
            cs: (tokByteStart
                lineStart: this.lineStart
                srcLines: this.lines
                lineno: cin.line
                colno: cin.col
            )
            hi: cs + repl.length
            if hi > srcv.length then return
            ctext: repl.copy
            if isStr then ctext = "string".string
            expect: "\{ptext}.\{ctext}"
            actual: srcv.substring from: lo to: hi
            if actual != expect.stringView then return
            wm: "zero/empty initializer: write the bare type name `\{repl}`"
            (this.warnFix
                code: "L011"
                msg: wm
                line: pin.line
                col: pin.col
                width: (hi - lo).u32.orPanic
                :lo
                :hi
                :repl
            )
        } else null
    }

    # tryNullBody -- L010: an empty `{ }` match arm/else body reads better as
    # the bare `null` body. Replaces the brace span (including any interior
    # newlines) with `null` when the merged line stays inside the wrap width;
    # commented empties are left alone. A body already written `null` starts
    # at the `n` byte, not `{`, so it never re-fires.
    tryNullBody: function {:this body: Node.view} is {
        if body.statement then {
            if body.statements.length != 0 then return
            srcOwned: this.source
            srcv: srcOwned.stringView
            openByte: (tokByteStart
                lineStart: this.lineStart
                srcLines: this.lines
                lineno: body.lineno
                colno: body.colno
            )
            ob: srcv.byteAt i: openByte
            isBrace: false
            match (
                ob
            ) case some then {
                if ob == 123 then isBrace = true
            } case none then null
            if isBrace == false then return
            coff: this.delimClose.get key: openByte
            closeByte: u64
            match (
                coff
            ) case some then {
                closeByte = coff
            } case none then {
                return
            }
            if (this.bracesBlocked :openByte :closeByte) then return
            closeLine: (byteToLine
                lineStart: this.lineStart
                off: closeByte
                nLines: this.lines.length
            )
            lineEndB: srcv.length
            if (closeLine + 1) < this.lineStart.length then {
                lineEndB = (this.lineStart.get i: (closeLine + 1)) - 1
            }
            tailLen: lineEndB - (closeByte + 1)
            limit: 100.u64
            if this.wrapWidth > 0 then limit = this.wrapWidth.u64
            resultLen: (body.colno.u64 - 1) + 4 + tailLen
            if resultLen > limit then return
            (this.warnFix
                code: "L010"
                msg: "empty match body: write `null`".string
                line: body.lineno
                col: body.colno
                width: 1
                lo: openByte
                hi: (closeByte + 1)
                repl: "null".string
            )
        }
    }

    # tryDebrace -- L008: strip the `{ }` around a single-statement clause `body`
    # when it de-braces safely and the result fits on one line. `collapse` is true
    # for a terminal single-clause body (for-loop, if-without-else), which may pull
    # a multi-line body onto the keyword line; false for a multi-clause construct
    # already proven to sit on one line, where stripping only shortens it.
    tryDebrace: function {:this ast: Ast.view body: Node.view collapse: bool} is {
        if body.statement then {
            if body.statements.length != 1 then return
            sl0Id: body.statements.get i: 0
            sl0: ast.nodes.get i: sl0Id.u64
            if sl0.statementline then {
                if (debraceEligible
                    :ast
                    n: (ast.nodes.get i: sl0.statementline.u64)
                ) == false then return
                srcOwned: this.source
                srcv: srcOwned.stringView
                openByte: (tokByteStart
                    lineStart: this.lineStart
                    srcLines: this.lines
                    lineno: body.lineno
                    colno: body.colno
                )
                ob: srcv.byteAt i: openByte
                isBrace: false
                match (
                    ob
                ) case some then {
                    if ob == 123 then isBrace = true
                } case none then null
                if isBrace == false then return
                coff: this.delimClose.get key: openByte
                closeByte: u64
                match (
                    coff
                ) case some then {
                    closeByte = coff
                } case none then {
                    return
                }
                if (this.bracesBlocked :openByte :closeByte) then return
                firstInner: (tokByteStart
                    lineStart: this.lineStart
                    srcLines: this.lines
                    lineno: sl0.lineno
                    colno: sl0.colno
                )
                tailStart: wsRunStartNL src: srcv from: closeByte
                cEndLine: (byteToLine
                    lineStart: this.lineStart
                    off: (tailStart - 1)
                    nLines: this.lines.length
                ) + 1
                if sl0.lineno.u64 != cEndLine then return
                closeLine: (byteToLine
                    lineStart: this.lineStart
                    off: closeByte
                    nLines: this.lines.length
                ) + 1
                sameLine: body.lineno.u64 == closeLine
                doStrip: false
                if collapse == false then {
                    doStrip = true
                } else if sameLine then {
                    doStrip = true
                } else {
                    limit: 100.u64
                    if this.wrapWidth > 0 then limit = this.wrapWidth.u64
                    resultLen: (body.colno.u64 - 1) + (tailStart - firstInner)
                    if resultLen <= limit then doStrip = true
                }
                if doStrip == false then return
                (this.warn
                    code: "L008"
                    msg: "redundant braces around a single-statement body".string
                    line: body.lineno
                    col: body.colno
                    width: 1
                )
                this.edits.append (zfix.Edit
                    byteLo: openByte
                    byteHi: firstInner
                    replacement: "".string
                )
                this.edits.append (zfix.Edit
                    byteLo: tailStart
                    byteHi: (closeByte + 1)
                    replacement: "".string
                )
            }
        }
    }

    # bracesBlocked -- true when the token span strictly between the open and close
    # brace bytes holds a top-level colon (a labelled call or binding, which cannot
    # lose its braces) or a comment (which a one-line collapse would swallow).
    bracesBlocked: function {:this openByte: u64 closeByte: u64} out bool is {
        m: this.fastToks.length
        depth: i64
        blocked: false
        i: u64
        for i < m loop {
            t: this.fastToks.get :i
            tb: (tokByteStart
                lineStart: this.lineStart
                srcLines: this.lines
                lineno: t.lineno
                colno: t.colno
            )
            if tb >= closeByte then break
            if tb > openByte then {
                match (
                    t.toktype
                ) case parenOpenTok then {
                    depth = depth + 1
                } case braceOpenTok then {
                    depth = depth + 1
                } case parenCloseTok then {
                    depth = depth - 1
                } case braceCloseTok then {
                    depth = depth - 1
                } case colonTok then {
                    if depth == 0 then blocked = true
                } case commentTok then {
                    blocked = true
                } else null
            }
            i = i + 1
        }
        return blocked
    }

    # checkBracesIf -- L008 entry for an `if`: a terminal single-clause `if ... then`
    # (no else) may collapse its then-body; an `if` with an else or extra clauses
    # de-braces only when the whole construct already sits on one line. Unit-level
    # `if`s (funcDepth == 0) keep their braces -- braceless branches are unsafe where
    # EOL filtering is on.
    checkBracesIf: function {:this ast: Ast.view clauses: (ListVal u32).view elseclauseId: zast.nodeid ln: u32} is {
        if this.funcDepth == 0 then return
        hasElse: elseclauseId > 0
        if (hasElse == false) when (clauses.length == 1) then {
            c0Id: clauses.get i: 0
            c0: ast.nodes.get i: c0Id.u64
            if c0.ifclause then {
                this.tryDebrace :ast body: (ast.nodes.get i: c0.statement.u64) collapse: true
            }
            return
        }
        if (clauseBodiesOnLine :ast :clauses :elseclauseId :ln) == false then return
        cit: clauses.iterate
        for clId: cit loop {
            cl: ast.nodes.get i: clId.u64
            if cl.ifclause then {
                this.tryDebrace :ast body: (ast.nodes.get i: cl.statement.u64) collapse: false
            }
        }
        if elseclauseId > 0 then {
            this.tryDebrace :ast body: (ast.nodes.get i: elseclauseId.u64) collapse: false
        }
    }

    # checkBracesMatch -- L008 entry for a `match`: always multi-clause, so its arm
    # and else braces are stripped only when the whole match already sits on one line.
    checkBracesMatch: function {:this ast: Ast.view clauses: (ListVal u32).view elseclauseId: zast.nodeid ln: u32} is {
        if this.funcDepth == 0 then return
        if (caseBodiesOnLine :ast :clauses :elseclauseId :ln) == false then return
        cit: clauses.iterate
        for clId: cit loop {
            cl: ast.nodes.get i: clId.u64
            if cl.caseclause then {
                this.tryDebrace :ast body: (ast.nodes.get i: cl.statement.u64) collapse: false
            }
        }
        if elseclauseId > 0 then {
            this.tryDebrace :ast body: (ast.nodes.get i: elseclauseId.u64) collapse: false
        }
    }

    # checkChainBodyBreak -- fmt: in a multi-line `match` or `if`, break any arm/clause
    # body whose first statement clings to the opening `{` onto its own line.
    checkChainBodyBreak: function {:this ast: Ast.view clauses: (ListVal u32).view elseclauseId: zast.nodeid} is {
        if this.funcDepth == 0 then return
        cit: clauses.iterate
        for clId: cit loop {
            cl: ast.nodes.get i: clId.u64
            match (
                cl
            ) case caseclause then {
                this.forceBodyBreak :ast body: (ast.nodes.get i: cl.statement.u64)
            } case ifclause then {
                this.forceBodyBreak :ast body: (ast.nodes.get i: cl.statement.u64)
            } else null
        }
        if elseclauseId > 0 then {
            this.forceBodyBreak :ast body: (ast.nodes.get i: elseclauseId.u64)
        }
    }

    # forceBodyBreak -- a braced body whose closing `}` is not on the opening `{` line (a
    # multi-line clause) starts its body on the next line at base+4; emit that edit when the
    # first statement still shares the `{` line AND is itself single-line. One-line bodies are
    # left to L008; a multi-line first statement is skipped (re-indenting it is out of scope).
    forceBodyBreak: function {:this ast: Ast.view body: Node.view} is {
        if body.statement then {
            if body.statements.length == 0 then return
            openByte: (tokByteStart
                lineStart: this.lineStart
                srcLines: this.lines
                lineno: body.lineno
                colno: body.colno
            )
            coff: this.delimClose.get key: openByte
            closeByte: u64
            match (
                coff
            ) case some then {
                closeByte = coff
            } case none then {
                return
            }
            closeLine: (byteToLine
                lineStart: this.lineStart
                off: closeByte
                nLines: this.lines.length
            ) + 1
            if body.lineno.u64 == closeLine then return
            sl0Id: body.statements.get i: 0
            sl0: ast.nodes.get i: sl0Id.u64
            if sl0.statementline then {
                if sl0.lineno != body.lineno then return
                firstEnd: (closeLine - 1)
                if body.statements.length > 1 then {
                    sl1Id: body.statements.get i: 1
                    sl1: ast.nodes.get i: sl1Id.u64
                    if sl1.statementline then firstEnd = (sl1.lineno.u64 - 1)
                }
                if firstEnd > body.lineno.u64 then return
                firstInner: (tokByteStart
                    lineStart: this.lineStart
                    srcLines: this.lines
                    lineno: sl0.lineno
                    colno: sl0.colno
                )
                oline: (byteToLine
                    lineStart: this.lineStart
                    off: openByte
                    nLines: this.lines.length
                )
                lt: this.lines.get i: oline
                base: (leadingSpaces line: lt.stringView)
                this.edits.append (zfix.Edit
                    byteLo: (openByte + 1)
                    byteHi: firstInner
                    replacement: (nlIndent n: (base + 4))
                )
            }
        }
    }

    # checkBracesFor -- L008 entry for a `for ... loop`: a terminal single-clause
    # body that may collapse onto the loop header.
    checkBracesFor: function {:this ast: Ast.view bodyId: zast.nodeid} is {
        if this.funcDepth == 0 then return
        if bodyId > 0 then {
            this.tryDebrace :ast body: (ast.nodes.get i: bodyId.u64) collapse: true
        }
    }

    # checkRedundantParens -- L007: a paren wrapping an ENTIRE `if` condition, when the condition
    # does not require it. A named-argument-call condition needs the parens (its args are greedy and
    # would swallow `then`), detected as a top-level colon inside the paren; those and sub-expression
    # precedence parens are left alone. Removes the `(` and `)`.
    checkRedundantParens: function {:this} is {
        srcOwned: this.source
        sv: srcOwned.stringView
        scanPool: zast.StringPool.create
        toks: tokenize.scan source: srcOwned.copy pool: scanPool
        lineStart: lineStartIndex src: sv
        srcLines: linesOf src: sv
        m: toks.length
        i: u64
        for i < m loop {
            t: toks.get :i
            isIf: false
            match (
                t.toktype
            ) case ifTok then {
                isIf = true
            } else null
            if isIf then {
                fs: i + 1
                fsScan: true
                for fsScan loop {
                    if fs >= m then {
                        fsScan = false
                    } else {
                        tf: toks.get i: fs
                        tv: false
                        match (
                            tf.toktype
                        ) case wsTok then {
                            tv = true
                        } case eolTok then {
                            tv = true
                        } case commentTok then {
                            tv = true
                        } else null
                        if tv then {
                            fs = fs + 1
                        } else {
                            fsScan = false
                        }
                    }
                }
                isOpen: false
                if fs < m then {
                    tf2: toks.get i: fs
                    match (
                        tf2.toktype
                    ) case parenOpenTok then {
                        isOpen = true
                    } else null
                }
                if isOpen then {
                    depth: 1.u64
                    j: fs + 1
                    matchIdx: m
                    hasColon: false
                    mScan: true
                    for mScan loop {
                        if j >= m then {
                            mScan = false
                        } else {
                            tj: toks.get i: j
                            kind: u32
                            match (
                                tj.toktype
                            ) case parenOpenTok then {
                                kind = 1
                            } case parenCloseTok then {
                                kind = 2
                            } case colonTok then {
                                kind = 3
                            } else null
                            if kind == 1 then {
                                depth = depth + 1
                            } else if kind == 2 then {
                                depth = depth - 1
                                if depth == 0 then {
                                    matchIdx = j
                                    mScan = false
                                }
                            } else if kind == 3 then {
                                if depth == 1 then hasColon = true
                            }
                            if mScan then j = j + 1
                        }
                    }
                    thenOk: false
                    if matchIdx < m then {
                        ns: matchIdx + 1
                        nScan: true
                        for nScan loop {
                            if ns >= m then {
                                nScan = false
                            } else {
                                tn: toks.get i: ns
                                tv2: false
                                match (
                                    tn.toktype
                                ) case wsTok then {
                                    tv2 = true
                                } case eolTok then {
                                    tv2 = true
                                } case commentTok then {
                                    tv2 = true
                                } else null
                                if tv2 then {
                                    ns = ns + 1
                                } else {
                                    nScan = false
                                }
                            }
                        }
                        if ns < m then {
                            tn2: toks.get i: ns
                            match (
                                tn2.toktype
                            ) case thenTok then {
                                thenOk = true
                            } else null
                        }
                    }
                    if thenOk when (hasColon == false) then {
                        to: toks.get i: fs
                        tc: toks.get i: matchIdx
                        oStart: tokByteStart :lineStart :srcLines lineno: to.lineno colno: to.colno
                        cStart: tokByteStart :lineStart :srcLines lineno: tc.lineno colno: tc.colno
                        (this.warn
                            code: "L007"
                            msg: "redundant parentheses around the condition".string
                            line: to.lineno
                            col: to.colno
                            width: 1
                        )
                        this.edits.append (zfix.Edit
                            byteLo: oStart
                            byteHi: (oStart + 1)
                            replacement: "".string
                        )
                        this.edits.append (zfix.Edit
                            byteLo: cStart
                            byteHi: (cStart + 1)
                            replacement: "".string
                        )
                    }
                }
            }
            i = i + 1
        }
    }

    # runFastChecks -- the fast-tier passes: parse-error/AST rules over `n`, then the token and
    # line rules over the source.
    runFastChecks: function {:this n: Node.view} is {
        this.lineStart = lineStartIndex src: this.source.stringView
        this.delimClose = (buildDelimMap
            src: this.source.stringView
            lineStart: this.lineStart
            srcLines: this.lines
        )
        scanPool: zast.StringPool.create
        this.fastToks = tokenize.scan source: this.source.copy pool: scanPool
        this.walkProgram prog: n
        this.checkPublicPosProgram prog: n
        this.checkForWhile
        this.checkTrailingWs
        this.checkFinalNewline
        this.checkColonSpacing
        this.checkBlankLines
        this.checkRedundantParens
    }

    # sortEditsInPlace -- reorder the collected edits by byteLo so the applier and the diff
    # renderer see sorted, overlap-resolvable input.
    sortEditsInPlace: function {:this} is {
        se: sortEdits edits: this.edits
        this.edits = se
    }

    # emitSuf -- L005: a redundant numeric suffix. The safe fix removes the `.` and the type
    # name (e.g. `5.i32` -> `5`); the context already pins the type.
  emitSuf: function {:this ln: u32 col: u32 tname: StringView} is {
        srcOwned: this.source
        sv: srcOwned.stringView
        lineStart: lineStartIndex src: sv
        srcLines: linesOf src: sv
        byteStart: tokByteStart :lineStart :srcLines lineno: ln colno: col
        lo: byteStart
        if byteStart > 0 then lo = byteStart - 1
        hi: byteStart + tname.length
        (this.warnFix
            code: "L005"
            msg: "redundant numeric suffix `.\{tname}`"
            line: ln
            :col
            width: tname.length.u32.orPanic
            :lo
            :hi
            repl: "".string
        )
    }

    # sufBinop -- a binop operand whose numeric suffix the other (non-literal, same-type)
    # operand makes redundant.
    sufBinop: function {
        ast: Ast.view
        :this
        lhs: Node.view
        rhs: Node.view
        isCmp: bool
        st: zenv.ZSymbolTable.view
    } is {
        # a LEADING literal's suffix is load-bearing at arithmetic ops (the
        # bare form defaults i64 and mismatches); only comparisons coerce a
        # literal from either side, so only there can the lhs suffix be
        # redundant
        if isCmp then {
            ls: operandSuffix :ast n: lhs
            if ls.tname.length > 0 when (isAnchor :ast n: rhs tname: ls.tname.stringView :st) then {
                this.emitSuf ln: ls.line col: ls.col tname: ls.tname.stringView
            }
        }
        rs: operandSuffix :ast n: rhs
        if rs.tname.length > 0 when (isAnchor :ast n: lhs tname: rs.tname.stringView :st) then {
            this.emitSuf ln: rs.line col: rs.col tname: rs.tname.stringView
        }
    }

    # sufReassign -- a reassignment value whose suffix the target's type fixes.
    sufReassign: function {
        ast: Ast.view
        :this
        topath: Node.view
        value: Node.view
        st: zenv.ZSymbolTable.view
    } is {
        vs: operandSuffix :ast n: value
        if vs.tname.length > 0 then {
            tn: typeNameOfNode n: topath :st
            if tn.length > 0 when (tn.stringView == vs.tname.stringView) then {
                this.emitSuf ln: vs.line col: vs.col tname: vs.tname.stringView
            }
        }
    }

    # emitConv -- L015 caret + safe fix: delete the `.member` conversion span.
    emitConv: function {:this ln: u32 col: u32 mname: StringView msg: String.take} is {
        srcOwned: this.source
        sv: srcOwned.stringView
        lineStart: lineStartIndex src: sv
        srcLines: linesOf src: sv
        byteStart: tokByteStart :lineStart :srcLines lineno: ln colno: col
        lo: byteStart
        if byteStart > 0 then lo = byteStart - 1
        hi: byteStart + mname.length
        (this.warnFix
            code: "L015"
            :msg
            line: ln
            :col
            width: mname.length.u32.orPanic
            :lo
            :hi
            repl: "".string
        )
    }

    # slConvArg -- one call argument: flag a redundant StringLike conversion.
    # Direction A: `x.stringView` on a String base (free but pointless).
    # Direction B: `sv.string` on a StringView base -- allocates an
    # owned String the callee only borrows. Both fire only when the parameter
    # is a generic constrained StringLike (either string form is accepted
    # directly); B is skipped for a `.take` parameter (it keeps the value).
    slConvArg: function {
        :this
        ast: Ast.view
        opId: u32
        originTid: ztypes.tid
        pname: StringView
        ptid: u64
        strTid: u64
        svTid: u64
        st: zenv.ZSymbolTable.view
    } is {
        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: ptid.u64)) != ztypes.ztypetype.genericParam then return
        gpn: st.reg.nameOf tid: (ztypes.tid.create from: ptid.u64)
        tk: ztypecheck.declOfTypeId :st tid: (ztypes.tid.create from: originTid.u64)
        cd: (st.reg.genericParamConstraintOf
            tdecl: tk
            paramName: (zast.poolFind pool: ast.names text: gpn.stringView)
        )
        if (cd.kind == ztypes.constraintkind.stringLike) == false then return
        dpId: opId
        {
            opn: ast.nodes.get i: dpId.u64
            if opn.expression then dpId = opn.expression
        }
        cn: String
        cln: u32
        ccl: u32
        bnid: u64
        {
            dpn: ast.nodes.get i: dpId.u64
            if dpn.dottedpath then {
                chn: ast.nodes.get i: dpn.child.u64
                cn = atomName :ast n: chn
                ci: nodeInfoOf n: chn
                cln = ci.line
                ccl = ci.col
                pnn: ast.nodes.get i: dpn.parent.u64
                bni: nodeInfoOf n: pnn
                bnid = bni.id.u64
            }
        }
        if cn.length == 0 then return
        if bnid == 0 then return
        bt: u64
        {
            bto: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: bnid
            if bto > 0 then bt = bto
        }
        if bt == 0 then return
        if (ztypecheck.isStringViewMember name: cn.stringView) when bt == strTid then {
            (this.emitConv
                ln: cln
                col: ccl
                mname: "stringView"
                msg: "redundant conversion: `.stringView` on a String argument (the parameter accepts StringLike)".string
            )
            return
        }
        isOwned: false
        if cn.stringView == "string" then isOwned = true
        if isOwned when bt == svTid then {
            if (st.typing.declOwnershipIs
                pool: ast.names
                parentTypeId: (ztypes.tid.create from: originTid.u64)
                name: pname
                own: ztypes.zparamownership.takeMode
            ) == false then {
                (this.emitConv
                    ln: cln
                    col: ccl
                    mname: cn.stringView
                    msg: "redundant conversion: `.\{cn}` allocates an owned String the call only borrows (the parameter accepts StringLike)"
                )
            }
        }
    }

    # slConvCall -- L015 over one call: resolve the callee's template and
    # check each argument's conversion shape against its parameter.
    slConvCall: function {
        :this
        ast: Ast.view
        callNid: u32
        callable: Node.view
        arguments: (ListVal u32).view
        st: zenv.ZSymbolTable
    } is {
        isRet: false
        {
            ck: st.typing.callKind.get key: callNid.u64
            match (
                ck
            ) case some then {
                if ck.returnCall then isRet = true
            } case none then null
        }
        if isRet then return
        callee: u64
        {
            cInfo: nodeInfoOf n: callable
            co: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: cInfo.id.u64
            if co > 0 then callee = co
        }
        if callee == 0 then return
        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: callee.u64)) != ztypes.ztypetype.functionType then return
        origin: callee
        thisPn: String
        {
            go: st.reg.genericOriginOf tid: (ztypes.tid.create from: callee.u64)
            if go > 0 then origin = go
        }
        thisPn = (zast.poolTextCopy
            pool: ast.names
            ref: (st.reg.thisParamNameIdOf tid: (ztypes.tid.create from: origin.u64))
        )
        names: (List String)
        ids: (ListVal u64)
        nameIds: (ListVal u64)
        (ztypecheck.dataFieldNames
            :ast
            :st
            tid: (ztypes.tid.create from: origin.u64)
            :names
            :ids
            :nameIds
        )
        if names.length == 0 then return
        strTid: ztypecheck.builtinTidTRo frame: ztypes.declid :ast :st base: "String"
        svTid: ztypecheck.builtinTidTRo frame: ztypes.declid :ast :st base: "StringView"
        firstArg: true
        aiter: arguments.iterate
        for aId: aiter loop {
            arg: ast.nodes.get i: aId.u64
            if arg.namedoperation then {
                an: zast.nameTextAt :ast ref: arg.name
                pidx: u64
                pfound: false
                if an.length > 0 then {
                    pi: u64
                    for pi < names.length loop {
                        if pfound == false then {
                            pnm: names.get i: pi
                            if pnm.stringView == an.stringView then {
                                pidx = pi
                                pfound = true
                            }
                        }
                        pi = pi + 1
                    }
                } else if firstArg then {
                    # the elided first label binds the first non-receiver param
                    pj: u64
                    for pj < names.length loop {
                        if pfound == false then {
                            pnm9b: names.get i: pj
                            isRecv: false
                            if (nameIds.get i: pj) == zast.names.wkThis.u64 then isRecv = true
                            if thisPn.length > 0 when thisPn.stringView == pnm9b.stringView then isRecv = true
                            if isRecv == false then {
                                pidx = pj
                                pfound = true
                            }
                        }
                        pj = pj + 1
                    }
                }
                if pfound then {
                    pnmc: (names.get i: pidx)
                    (this.slConvArg
                        :ast
                        opId: arg.operation
                        originTid: (ztypes.tid.create from: origin.u64)
                        pname: pnmc.stringView
                        ptid: (ids.get i: pidx)
                        :strTid
                        :svTid
                        :st
                    )
                }
                firstArg = false
            }
        }
    }

    # sufNamedArg -- a named call/constructor argument whose suffix the parameter / field type
    # fixes.
    sufNamedArg: function {:this ast: Ast.view arg: Node.view calleeType: u64 st: zenv.ZSymbolTable.view} is {
        if arg.namedoperation then {
            an: zast.nameTextAt :ast ref: arg.name
            if an.length > 0 then {
                s: operandSuffix :ast n: (ast.nodes.get i: arg.operation.u64)
                if s.tname.length > 0 then {
                    # a generic-origin param never anchors a defix: the
                    # suffix is what SELECTS the instantiation (the mono's
                    # concrete param type was inferred from this argument)
                    gorig: calleeType
                    {
                        goS: st.reg.genericOriginOf tid: (ztypes.tid.create from: calleeType.u64)
                        if goS > 0 then gorig = goS
                    }
                    if gorig != calleeType then {
                        opto: (st.typing.declChildOf
                            pool: ast.names
                            parentTypeId: (ztypes.tid.create from: gorig.u64)
                            name: an.stringView
                        )
                        match (
                            opto
                        ) case some then {
                            if (st.reg.typetypeOf typeId: (ztypes.tid.create from: opto.u64)) == ztypes.ztypetype.genericParam then return
                        } case none then null
                    }
                    pto: (st.typing.declChildOf
                        pool: ast.names
                        parentTypeId: (ztypes.tid.create from: calleeType.u64)
                        name: an.stringView
                    )
                    match (
                        pto
                    ) case some then {
                        ptn: (st.reg.nameOf tid: (ztypes.tid.create from: pto.u64))
                        if ptn.stringView == s.tname.stringView then {
                            this.emitSuf ln: s.line col: s.col tname: s.tname.stringView
                        }
                    } case none then null
                }
            }
        }
    }

    # sufNamedArgReturn -- a return value whose suffix the enclosing function's return type
    # fixes.
    sufNamedArgReturn: function {:this ast: Ast.view arg: Node.view rtName: StringView} is {
        match (
            arg
        ) case namedoperation then {
            s: operandSuffix :ast n: (ast.nodes.get i: arg.operation.u64)
            if s.tname.length > 0 when (s.tname.stringView == rtName) then {
                this.emitSuf ln: s.line col: s.col tname: s.tname.stringView
            }
        } else {
            s8: operandSuffix :ast n: arg
            if s8.tname.length > 0 when (s8.tname.stringView == rtName) then {
                this.emitSuf ln: s8.line col: s8.col tname: s8.tname.stringView
            }
        }
    }

    # sufCall -- redundant suffixes in a call: a `return` uses the enclosing function's return
    # type; otherwise each named argument's parameter type.
    sufCall: function {:this ast: Ast.view callNid: u32 callable: Node.view arguments: (ListVal u32).view st: zenv.ZSymbolTable.view funcretId: zast.nodeid} is {
        ck: st.typing.callKind.get key: callNid.u64
        isRet: false
        match (
            ck
        ) case some then {
            if ck.returnCall then isRet = true
        } case none then null
        if isRet then {
            rtName: typeNameOfOptAt :ast oId: funcretId :st
            if rtName.length > 0 then {
                ait: arguments.iterate
                for aId: ait loop (this.sufNamedArgReturn
                    :ast
                    arg: (ast.nodes.get i: aId.u64)
                    rtName: rtName.stringView
                )
            }
        } else {
            cInfo: nodeInfoOf n: callable
            co: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: cInfo.id.u64
            if co > 0 then {
                ait: arguments.iterate
                for aId: ait loop {
                    (this.sufNamedArg
                        :ast
                        arg: (ast.nodes.get i: aId.u64)
                        calleeType: co
                        :st
                    )
                }
            }
        }
    }

    # walkSuf -- preorder over the subtree running the typecheck-based suffix check, threading
    # the enclosing function's return type for `return`s. The arms a check reads are spelled;
    # every child is visited through zast.childIds.
    walkSuf: function {:this ast: Ast.view n: Node.view uname: StringView st: zenv.ZSymbolTable funcretId: zast.nodeid} is {
        match (
            n
        ) case binop then {
            bl: ast.nodes.get i: n.lhs.u64
            br: ast.nodes.get i: n.rhs.u64
            bop: atomName :ast n: (ast.nodes.get i: n.operator.u64)
            (this.sufBinop
                :ast
                lhs: bl
                rhs: br
                isCmp: (ztypecheck.isComparisonOp name: bop.stringView)
                :st
            )
        } case call then {
            (this.sufCall :ast
                callNid: n.nodeid
                callable: (ast.nodes.get i: n.callable.u64)
                arguments: n.arguments
                :st
                :funcretId
            )
            (this.slConvCall :ast
                callNid: n.nodeid
                callable: (ast.nodes.get i: n.callable.u64)
                arguments: n.arguments
                :st
            )
        } case reassignment then {
            tpn: ast.nodes.get i: n.topath.u64
            rvn: ast.nodes.get i: n.value.u64
            this.sufReassign :ast topath: tpn value: rvn :st
        } case functiondef then {
            # the function's own return type is the funcret for everything below it
            this.walkSufRet :ast retId: n.returntype :uname :st
            this.walkSufIds :ast ids: n.parameters :uname :st funcretId: n.returntype
            this.walkSufOptAt :ast oId: n.body :uname :st funcretId: n.returntype
            this.walkSufIds :ast ids: n.asItems :uname :st funcretId: n.returntype
            return
        } else null
        this.walkSufIds :ast ids: (zast.childIds :ast :n) :uname :st :funcretId
    }

    # walk a list of children for the numeric-suffix rule
    walkSufIds: function {:this ast: Ast.view ids: (ListVal u32).view uname: StringView st: zenv.ZSymbolTable funcretId: zast.nodeid} is {
        with it: ids.iterate do for c: it loop {
            this.walkSuf :ast n: (ast.nodes.get i: c.u64) :uname :st :funcretId
        }
    }

    # walkSufOptAt -- the id-taking entry (0 = absent).
    walkSufOptAt: function {:this ast: Ast.view oId: zast.nodeid uname: StringView st: zenv.ZSymbolTable funcretId: zast.nodeid} is {
        if oId.isZero then return
        o: ast.nodes.get i: oId.u64
        this.walkSuf :ast n: o :uname :st :funcretId
    }

    # a functiondef returntype doubles as its own funcret: this frame lets
    # the two arguments share one root without aliasing one source path
    walkSufRet: function {:this ast: Ast.view retId: zast.nodeid uname: StringView st: zenv.ZSymbolTable} is {
        if retId.isZero then return
        r: ast.nodes.get i: retId.u64
        this.walkSuf :ast n: r :uname :st funcretId: retId
    }

    # lintSuffixUnit -- run the suffix check over a typechecked program's main unit.
    lintSuffixUnit: function {:this prog: Node.view uname: StringView st: zenv.ZSymbolTable} is {
        mn: mainUnitNameOf program: prog
        if prog.program then {
            uCnt9a: prog.ast.units.length
            uIdx9a: u64
            for uIdx9a < uCnt9a loop {
                uId: (zast.nodeid.create from: (prog.ast.units.get i: uIdx9a))
                uIdx9a = uIdx9a + 1
                (this.lintSuffixNamedOp
                    ast: prog.ast
                    namedOpId: uId
                    mainName: mn.stringView
                    :uname
                    :st
                )
            }
        }
    }

    # lintSuffixNamedOp -- run the suffix check on the main unit only.
    lintSuffixNamedOp: function {:this ast: Ast.view namedOpId: u32 mainName: StringView uname: StringView st: zenv.ZSymbolTable} is {
        namedOp: ast.nodes.get i: namedOpId.u64
        if namedOp.namedoperation then {
            un: zast.nameTextAt :ast ref: namedOp.name
            if un.stringView == mainName then {
                (this.walkSuf
                    :ast
                    n: (ast.nodes.get i: namedOp.operation.u64)
                    :uname
                    :st
                    funcretId: (zast.nodeid.create from: 0)
                )
            }
        }
    }

    # checkSuffix -- L005 (typecheck tier): build the project VFS, parse this file's unit in the
    # project, typecheck, and walk the typed tree for redundant numeric suffixes. A missing
    # dependency (in-project parse error) skips the check silently.
    checkSuffix: function {:this srcdirs: (List String).view systemdir: StringView uname: StringView} is {
        vfs: (zvfs.ZVfs
            providers: (List zvfs.ProviderBox)
            providerRoot: (IdMapR u32 V: String)
            entrytable: (zvfs.DentryTable entries: (ListVal zvfs.dentry))
            file_names: (List String)
            walk_cache: (MapRV String v: zvfs.fsno)
            rootid: zvfs.fsno
        )
        vfs.registerNull
        systemid: vfs.registerFS rootpath: systemdir.string parentpath: "".string
        vfs.bindRoot newid: systemid kind: zvfs.bindkind.instead
        # each `before` goes ahead of what is already bound, so binding back to
        # front leaves the first --src searched first, as zc resolves them
        rootid: zvfs.fsno
        si: srcdirs.length
        for si > 0 loop {
            si = si - 1
            sd: srcdirs.get i: si
            sid: vfs.registerFS rootpath: sd.copy parentpath: "".string
            rootid = vfs.bindRoot newid: sid kind: zvfs.bindkind.before
        }
        p: zparser.Parser.create
        prog: p.parse :vfs :rootid mainUnitName: uname.string
        match (
            prog
        ) case error then null else {
            reg: ztypes.newRegistry
            ccPath9v: zcheck.pickCc ccFlag: "" targetTriple: ""
            ccMode9v: zcheck.pickCcMode modeFlag: ""
            # the fold paths by the same default resolution zc uses, so a
            # `require:` guard decides the same here as it does in a build
            foldPaths9: (List String)
            rtd9v: zcheck.resolveRuntimeDir flagVal: ""
            (zcheck.foldNativePaths runtimeDir: rtd9v.stringView into: foldPaths9)
            st: (ztypecheck.typecheck
                program: prog
                :reg
                eager: true
                requireMain: false
                dumpRows: false
                ccPath: ccPath9v.stringView
                ccMode: ccMode9v.stringView
                target: ""
                foldPaths: foldPaths9
            )
            this.lintSuffixUnit :prog :uname :st
            this.reportUnusedDefs :prog :uname :st
            this.reportUnusedVars :prog :uname :st
            this.reportViewableLocals :prog :uname :st
            if this.opts.arch then this.reportArch :prog :uname :st :srcdirs :systemdir
        }
    }

    # reportArch -- the typecheck-tier architecture rules. A003: a `==` / `!=`
    # in this unit against a literal that spells a unit or type name of the
    # program -- routing by the name of a thing that has an id. A004: a record
    # or class field of this unit that no dotted read in the PROJECT reaches --
    # every `.z` under --src and --system is parsed for its member reads, so the
    # evidence does not depend on which program happens to be compiled here, and
    # a field is reported where it is declared. Units under --system are exempt
    # (a library's surface is not dead for being unread by one project), as are
    # native types (their fields are the runtime's to read). The read evidence
    # is by name: conservative, so a same-named field elsewhere hides a hit
    # rather than inventing one.
    reportArch: function {:this prog: Node.view uname: StringView st: zenv.ZSymbolTable.view srcdirs: (List String).view systemdir: StringView} is {
        if prog.program then {
            ast9: prog.ast
            mainOp: unitOpOfName ast: ast9 :uname
            if mainOp.isZero then return
            namedIds: (IdSet u64)
            {
                di: 1.u64
                dn: st.typing.decls.length
                for di < dn loop {
                    d: st.typing.decls.get i: di
                    isNamed: d.kind.unitDecl
                    if d.kind.typeDecl then isNamed = true
                    if isNamed then namedIds.add item: d.name.u64
                    di = di + 1
                }
            }
            this.archWalk ast: ast9 nId: mainOp :namedIds
            # A007 speaks only for a unit that lives under one of the roots
            inSrc: false
            with sit: srcdirs.iterate do for d: sit loop {
                du: unitNamesIn dir: d.stringView
                if (du.contains item: uname.string) then inSrc = true
            }
            if (inSrc) == false then return
            this.reportUnusedExports ast: ast9 unitId: mainOp :uname :srcdirs
            readNames: (Set String)
            with rit: srcdirs.iterate do for d2: rit loop {
                projectReadNames dir: d2.stringView into: readNames
            }
            projectReadNames dir: systemdir into: readNames
            bodyIds: zast.unitBodyIdsAt ast: ast9 unitId: mainOp
            with bit: bodyIds.iterate do for mId: bit loop {
                m: ast9.nodes.get i: mId.u64
                if m.namedoperation then {
                    tn: zast.poolTextCopy pool: ast9.names ref: m.name
                    this.archFields ast: ast9 opId: m.operation :readNames typeName: tn.stringView
                }
            }
        }
    }

    # reportUnusedExports -- A007: a name this unit's `public:` block exports
    # that no other unit under --src reads as `<unit>.<name>`. An export with
    # no importer is a private definition wearing a public label, and L012
    # cannot judge it until the label goes. Units under --system are exempt:
    # their exports serve examples, tests and the runtime's fragments, none
    # of them under --src. The read evidence is by name: conservative, so a
    # same-named read elsewhere hides a hit rather than inventing one.
    reportUnusedExports: function {
        :this
        ast: Ast.view
        unitId: zast.nodeid
        uname: StringView
        srcdirs: (List String).view
    } is {
        reads: (Set String)
        with sit: srcdirs.iterate do for d: sit loop {
            projectUnitReads dir: d.stringView :uname into: reads
        }
        # the entry point is read by the loader, not by a unit
        mainId: zast.poolFind pool: ast.names text: "main"
        bodyIds: zast.unitBodyIdsAt :ast :unitId
        with bit: bodyIds.iterate do for mId: bit loop {
            m: ast.nodes.get i: mId.u64
            if m.namedoperation then {
                if (zast.unitOpKindIs :ast opId: m.operation k: zast.unitkind.publicNs) then {
                    this.reportUnreadExportsIn :ast opId: m.operation :reads :mainId
                }
            }
        }
    }

    # reportUnreadExportsIn -- each `:name` of one public block that `reads` lacks;
    # the block's items are the labels' named operations.
    reportUnreadExportsIn: function {
        :this
        ast: Ast.view
        opId: zast.nodeid
        reads: (Set String).view
        mainId: zast.nameid
    } is {
        ud: ast.nodes.get i: opId.u64
        if ud.unitdef then {
            with it: ud.body.iterate do for lid: it loop {
                lv: ast.nodes.get i: lid.u64
                if lv.namedoperation then {
                    nm: zast.poolTextCopy pool: ast.names ref: lv.name
                    if (reads.has item: nm) == false when lv.name != mainId then {
                        (this.info
                            code: "A007"
                            msg: "export `\{nm}` is read by no other unit under --src; make it private and let L012 judge it"
                            line: lv.lineno
                            col: lv.colno
                            width: nm.length.u32.orPanic
                        )
                    }
                }
            }
        }
    }

    # archFields -- A004 over one record / class definition of this unit.
    archFields: function {:this ast: Ast.view opId: zast.nodeid readNames: (Set String).view typeName: StringView} is {
        n: ast.nodes.get i: opId.u64
        if n.objectdef then {
            isData: n.kind.recordDef
            if n.kind.classDef then isData = true
            if n.kind.generatorDef then isData = true
            if isData == false then return
            if n.isNative then return
            with it: n.isItems.iterate do for mId: it loop {
                m: ast.nodes.get i: mId.u64
                if m.namedoperation then {
                    mop: ast.nodes.get i: m.operation.u64
                    fnm: zast.poolTextCopy pool: ast.names ref: m.name
                    if (mop.functiondef) == false when (readNames.has item: fnm) == false then {
                        (this.warn
                            code: "A004"
                            msg: "field `\{typeName}.\{fnm}` is written and never read anywhere in the project"
                            line: m.lineno
                            col: m.colno
                            width: 1
                        )
                    }
                }
            }
        }
    }

    # archWalk -- A003 at every literal compare of the unit's subtree.
    archWalk: function {:this ast: Ast.view nId: zast.nodeid namedIds: (IdSet u64).view} is {
        n: ast.nodes.get i: nId.u64
        kids: zast.childIds :ast :n
        if n.binop then {
            op: atomName :ast n: (ast.nodes.get i: n.operator.u64)
            isCmp: op.stringView == "=="
            if op.stringView == "!=" then isCmp = true
            if isCmp then {
                this.archNamedLiteral :ast id: n.lhs :namedIds
                this.archNamedLiteral :ast id: n.rhs :namedIds
            }
        }
        with kit: kids.iterate do for c: kit loop {
            this.archWalk :ast nId: (zast.nodeid.create from: c) :namedIds
        }
    }

    # a named argument whose value is a literal, which the composed-key rule
    # reads
    archNamedLiteral: function {:this ast: Ast.view id: zast.nodeid namedIds: (IdSet u64).view} is {
        n: ast.nodes.get i: id.u64
        txt: plainLiteralText :ast :n
        match (
            txt
        ) case some then {
            nid: ast.names.find s: txt.stringView
            if (nid.isZero) == false when (namedIds.has item: nid.u64) then {
                p: zast.posOf :n
                (this.warn
                    code: "A003"
                    msg: "`\{txt}` names a unit or a type of the program; compare its declaration or type id, not its spelling"
                    line: p.line
                    col: p.col
                    width: 1
                )
            }
        } case none then null
    }

    # isBuiltinCarrierTid -- String, StringView or a container. `isReftypeOf`
    # says true for all of them, and `isNativeOf` splits them rather than naming
    # them: String and StringView are declared `class is native`, the containers
    # are plain classes. Compare against the builtin ids the way
    # isContainerReaderCall does.
    isBuiltinCarrierTid: function {
        :this
        ast: Ast.view
        st: zenv.ZSymbolTable
        tid: ztypes.tid
    } out bool is {
        b: tid
        {
            g: st.reg.genericOriginOf tid: (ztypes.tid.create from: tid.u64)
            if g > 0 then b = g
        }
        if b == (ztypecheck.builtinTidTRo
        frame: ztypes.declid
            :ast
            :st
            base: "String"
) then return true
        if b == (ztypecheck.builtinTidTRo
        frame: ztypes.declid
            :ast
            :st
            base: "StringView"
) then return true
        if b == (ztypecheck.builtinTidTRo
        frame: ztypes.declid
            :ast
            :st
            base: "ListRef"
) then return true
        if b == (ztypecheck.builtinTidTRo
        frame: ztypes.declid
            :ast
            :st
            base: "ListView"
) then return true
        if b == (ztypecheck.builtinTidTRo
        frame: ztypes.declid
            :ast
            :st
            base: "MapRR"
) then return true
        if b == (ztypecheck.builtinTidTRo
        frame: ztypes.declid
            :ast
            :st
            base: "MapRV"
) then return true
        if b == (ztypecheck.builtinTidTRo
        frame: ztypes.declid
            :ast
            :st
            base: "MapVR"
) then return true
        if b == (ztypecheck.builtinTidTRo
        frame: ztypes.declid
            :ast
            :st
            base: "MapVV"
) then return true
        if b == (ztypecheck.builtinTidTRo
        frame: ztypes.declid
            :ast
            :st
            base: "SetRef"
) then return true
        return b == (ztypecheck.builtinTidTRo frame: ztypes.declid :ast :st base: "Bytes")
    }

    # reportUnmutatedParam -- L020. A USER reftype parameter that is mutable by
    # default and never mutated should declare `.view`: the marker is what lets
    # a caller keep reading its argument across the call, and without it a
    # forgotten `.view` surfaces as a lock conflict at a DISTANT call site.
    #
    # "Mutated" is not re-derived. The typechecker records `variableMutated` at
    # the two places that already enforce the question -- `lockCallArg` whenever
    # it takes a non-shared lock (every mutating receiver and every mutable
    # argument) and `checkWriteLock` (assignment and swap targets) -- so this
    # agrees with the lock rules by construction.
    reportUnmutatedParam: function {
        :this
        ast: Ast.view
        st: zenv.ZSymbolTable
        fnOp: u32
        vid: ztypes.vid
        nameRef: zast.nameid
        line: u32
        col: u32
    } is {
        if (st.reg.hasVariable id: vid) == false then return
        vt: (st.reg.variableTypeOf id: vid).u64
        if vt == 0 then return
        if (st.reg.isReftypeOf tid: (ztypes.tid.create from: vt.u64)) == false then return
        if (this.isBuiltinCarrierTid :ast :st tid: (ztypes.tid.create from: vt.u64)) then return
        ftid: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: fnOp.u64
        if ftid.isZero then return
        own: (st.typing.declOwnershipOfId
            parentTypeId: (ztypes.tid.create from: ftid.u64)
            nameId: nameRef
        )
        mutable: true
        match (
            own
        ) case some then {
            if own != ztypes.zparamownership.borrowMode then mutable = false
        } case none then null
        if (mutable) == false then return
        pnm: zast.poolTextAt pool: ast.names ref: nameRef
        (this.info
            code: "L020"
            msg: "parameter '\{pnm}' is never mutated -- declare it `.view` so callers may keep reading the argument across the call"
            :line
            :col
            width: pnm.length.u32.orPanic
        )
    }

    # reportUnusedVars -- L014 (unused parameter) + L013 (unused local). A binding whose
    # variableId never appears as a use (atomVariableId) is dead. Params are walked from the
    # main unit's function defs (precise name/position; the receiver is exempt). Locals are the
    # assignment bindings in this file. The opt-out is to `touch` the variable: write its name on
    # its own line (it lowers to `(void)(x);`), which stamps a use.
    reportUnusedVars: function {:this prog: Node.view uname: StringView st: zenv.ZSymbolTable} is {
        if prog.program then {
            # A reassignment's target atom carries an atomVariableId stamp
            # exactly as a read does, so counting every stamp as a use makes a
            # local that is only ever assigned look used. Collect the bare-atom
            # write targets and leave them out. Only a BARE atom: reaching
            # `a.b` to write it genuinely reads `a`, so a dotted target
            # excludes nothing.
            wtgt: (IdSet u64)
            ni: u64
            nn: prog.ast.nodes.length
            for ni < nn loop {
                tp: u64
                {
                    wn: prog.ast.nodes.get i: ni
                    match (wn) case reassignment then tp = wn.topath.u64 else null
                }
                if tp > 0 then {
                    tn: prog.ast.nodes.get i: tp
                    match (tn) case atomid then wtgt.add item: tp else null
                }
                ni = ni + 1
            }
            used: (IdSet u64)
            with uit: st.typing.atomVariableId.iterateItems do for av: uit loop {
                if (wtgt.has item: av.key) == false then used.add item: av.value
            }
            mainOp: zast.nodeid
            uN: prog.ast.units.length
            uI: u64
            for uI < uN loop {
                uid: (zast.nodeid.create from: (prog.ast.units.get i: uI))
                uI = uI + 1
                unm: String
                uop: zast.nodeid
                {
                    un: prog.ast.nodes.get i: uid.u64
                    if un.namedoperation then {
                        unm = (zast.poolTextCopy pool: prog.ast.names ref: un.name)
                        uop = un.operation
                    }
                }
                if unm.stringView == uname when uop > 0 then mainOp = uop
            }
            if mainOp > 0 then {
                fnOps: (ListVal u32)
                memIds: (ListVal u32)
                {
                    bodyIds: zast.unitBodyIdsAt ast: prog.ast unitId: mainOp
                    with bit: bodyIds.iterate do for mid: bit loop memIds.append from: mid
                }
                mN: memIds.length
                mI: u64
                for mI < mN loop {
                    mid: memIds.get i: mI
                    mI = mI + 1
                    mop: u32
                    { m: prog.ast.nodes.get i: mid.u64
                      if m.namedoperation then mop = m.operation }
                    if mop > 0 then {
                        isFn: false
                        isObj: false
                        { op: prog.ast.nodes.get i: mop.u64
                          if op.functiondef then isFn = true
                          if op.objectdef then isObj = true }
                        # synth-lowered defs sit outside every file segment
                        # (fsno 0): they are not user source, so their params
                        # are exempt
                        if isFn when (prog.ast.fsnoForNode nodeid: mop) > 0 then fnOps.append from: mop
                        if isObj then {
                            asIds: (ListVal u32)
                            { op9b: prog.ast.nodes.get i: mop.u64
                              match (op9b) case objectdef then {
                                  with ait: op9b.asItems.iterate do for aid: ait loop asIds.append from: aid
                              } else null }
                            aN: asIds.length
                            aI: u64
                            for aI < aN loop {
                                amid: asIds.get i: aI
                                aI = aI + 1
                                amop: u32
                                { am: prog.ast.nodes.get i: amid.u64
                                  if am.namedoperation then amop = am.operation }
                                if amop > 0 then {
                                    isFnA: false
                                    { aop: prog.ast.nodes.get i: amop.u64
                                      if aop.functiondef then isFnA = true }
                                    if isFnA when (prog.ast.fsnoForNode nodeid: amop) > 0 then fnOps.append from: amop
                                }
                            }
                        }
                    }
                }
                fN: fnOps.length
                fI: u64
                for fI < fN loop {
                    fop: fnOps.get i: fI
                    fI = fI + 1
                    paramIds: (ListVal u32)
                    { fd: prog.ast.nodes.get i: fop.u64
                      match (fd) case functiondef then {
                          with pit: fd.parameters.iterate do for pid: pit loop paramIds.append from: pid
                      } else null }
                    pN: paramIds.length
                    pI: u64
                    for pI < pN loop {
                        pid: paramIds.get i: pI
                        pI = pI + 1
                        pOpId: u32
                        pNameRef: zast.nameid
                        pLn: u32
                        pCl: u32
                        { pm: prog.ast.nodes.get i: pid.u64
                          match (pm) case namedoperation then {
                              pOpId = pm.operation
                              pNameRef = pm.name
                              pLn = pm.lineno
                              pCl = pm.colno
                          } else null }
                        if pOpId > 0 then {
                            # the receiver is exempt: `:this` names it directly
                            # (zast.names.wkThis); a spelled `b: this.borrow` is receiver-shaped
                            isRecv: false
                            if pNameRef == zast.names.wkThis then isRecv = true
                            if (isRecv) == false then {
                                isRecv = (ztypecheck.paramIsThisReceiverId
                                    ast: prog.ast
                                    opId: pOpId
                                )
                            }
                            if (isRecv) == false then {
                                vo: st.typing.defVariableId.get key: pOpId.u64
                                match (vo) case some then {
                                    umut: st.typing.variableMutated.has item: vo
                                    if (used.has item: vo) then {
                                        if (umut) == false then {
                                            (this.reportUnmutatedParam
                                                ast: prog.ast
                                                :st
                                                fnOp: fop
                                                vid: vo
                                                nameRef: pNameRef
                                                line: pLn
                                                col: pCl
                                            )
                                        }
                                    }
                                    if (used.has item: vo) == false then {
                                        pnm: (zast.poolTextAt
                                            pool: prog.ast.names
                                            ref: (zast.nameid.create from: pNameRef.u32)
                                        )
                                        (this.warn
                                            code: "L014"
                                            msg: "parameter '\{pnm}' is never used (touch it with a bare `\{pnm}` statement if intentional)"
                                            line: pLn
                                            col: pCl
                                            width: pnm.length.u32.orPanic
                                        )
                                    }
                                } case none then null
                            }
                        }
                    }
                }
                if fnOps.length > 0 then {
                    mainFsno: prog.ast.fsnoForNode nodeid: (fnOps.get i: 0)
                    with dit: st.typing.defVariableId.iterateItems do for dv: dit loop {
                        nid: dv.key
                        vid: dv.value
                        skip: false
                        if (skip) == false when (used.has item: vid) then skip = true
                        if (skip) == false then {
                            fs: prog.ast.fsnoForNode nodeid: nid.u32.orPanic
                            if fs == mainFsno then {
                                nm: String
                                ln: u32
                                cl: u32
                                okL: false
                                { nodeL: prog.ast.nodes.get i: nid.u64
                                  match (nodeL) case assignment then {
                                      nm = zast.poolTextCopy pool: prog.ast.names ref: nodeL.name
                                      ln = nodeL.lineno
                                      cl = nodeL.colno
                                      okL = true
                                  } else null }
                                if okL then {
                                    (this.warn
                                        code: "L013"
                                        msg: "local '\{nm}' is never used (touch it with a bare `\{nm}` statement if intentional)"
                                        line: ln
                                        col: cl
                                        width: nm.length.u32.orPanic
                                    )
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    # srcIsFieldRead -- the conversion's source is a FIELD read (`ctx.mainName`)
    # rather than a local, a call, or a method chain. A field holds its bytes only
    # until something rebinds it, and any call in the local's live range may do
    # exactly that -- the save/restore idiom around a rebinding setter frees the
    # old String, so an alias of the field would dangle. The owned copy is
    # load-bearing there, and L022 leaves it alone.
    srcIsFieldRead: function {
        :this
        ast: Ast.view
        st: zenv.ZSymbolTable
        n: Node.view
    } out bool is {
        match (
            n
        ) case expression then {
            return (this.srcIsFieldRead :ast :st n: (ast.nodes.get i: n.expression.u64))
        } case dottedpath then {
            fcn: atomName :ast n: (ast.nodes.get i: n.child.u64)
            if fcn.length == 0 then return false
            fpn: ast.nodes.get i: n.parent.u64
            fpi: nodeInfoOf n: fpn
            fpt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: fpi.id.u64
            if fpt.isZero then return false
            fnid: zast.poolFind pool: ast.names text: fcn.stringView
            if fnid.isZero then return false
            fmo: (st.typing.declChildOfId
                parentTypeId: fpt
                nameId: fnid
            )
            match (
                fmo
            ) case some then {
                if (st.reg.typetypeOf
                    typeId: (ztypes.tid.create from: fmo.u64)
                ) == ztypes.ztypetype.functionType then return false
                return true
            } case none then null
            return false
        } else {
            return false
        }
    }

    # owningConvKind -- the RHS is an OWNING String conversion: `.string` on a
    # StringView base, `.copy` on a String base, or a nameTextCopy/poolTextCopy
    # call. Returns the spelling for the message, "" otherwise.
    owningConvKind: function {
        :this
        ast: Ast.view
        st: zenv.ZSymbolTable
        rhsId: u32
    } out String is {
        if rhsId == 0 then return "".string
        rn: ast.nodes.get i: rhsId.u64
        match (
            rn
        ) case expression then {
            return (this.owningConvKind :ast :st rhsId: rn.expression)
        } case dottedpath then {
            chn: ast.nodes.get i: rn.child.u64
            cn: atomName :ast n: chn
            if cn.length == 0 then return "".string
            pnn: ast.nodes.get i: rn.parent.u64
            if (this.srcIsFieldRead :ast :st n: pnn) then return "".string
            pin: nodeInfoOf n: pnn
            bt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: pin.id.u64
            if bt.isZero then return "".string
            if cn.stringView == "string" then {
                if bt == (ztypecheck.builtinTidTRo
        frame: ztypes.declid
                    :ast
                    :st
                    base: "StringView"
) then return "`.string`".string
            }
            if cn.stringView == "copy" then {
                if bt == (ztypecheck.builtinTidTRo
        frame: ztypes.declid
                    :ast
                    :st
                    base: "String"
) then return "`.copy`".string
            }
            return "".string
        } case call then {
            cbl: ast.nodes.get i: rn.callable.u64
            match (
                cbl
            ) case dottedpath then {
                ccn: atomName :ast n: (ast.nodes.get i: cbl.child.u64)
                if ccn.stringView == "nameTextCopy" then return "`nameTextCopy`".string
                if ccn.stringView == "poolTextCopy" then return "`poolTextCopy`".string
                return "".string
            } else {
                return "".string
            }
        } else {
            return "".string
        }
    }

    # convSourceRootVid -- the variable id at the ROOT of an owning conversion's
    # source path (`ctx.mainName.copy` -> `ctx`), or the zero vid when the source
    # is not rooted at a name.
    convSourceRootVid: function {
        :this
        ast: Ast.view
        st: zenv.ZSymbolTable.view
        rhsId: u32
    } out ztypes.vid is {
        zv: ztypes.vid
        if rhsId == 0 then return zv
        rn: ast.nodes.get i: rhsId.u64
        match (
            rn
        ) case expression then {
            return (this.convSourceRootVid :ast :st rhsId: rn.expression)
        } case dottedpath then {
            return (this.convSourceRootVid :ast :st rhsId: rn.parent)
        } case call then {
            return (this.convSourceRootVid :ast :st rhsId: rn.callable)
        } case atomid then {
            avo: st.typing.atomVariableId.get key: rn.nodeid.u64
            match (
                avo
            ) case some then {
                zv = avo
            } case none then null
            return zv
        } else {
            return zv
        }
    }

    # reportViewableLocals -- L022. A String local bound from an OWNING
    # conversion that is never mutated: every use only reads it, so a borrowed
    # view serves and the allocation is avoidable (`.stringView` at the uses,
    # `asString` at a container probe). Mutation evidence is `variableMutated`
    # (the lock rules) and `variableMoved` (the invalidate choke point) -- a
    # local moved into an owner needs its allocation, so it is not flagged.
    reportViewableLocals: function {:this prog: Node.view uname: StringView st: zenv.ZSymbolTable} is {
        if prog.program then {
            mainOp: zast.nodeid
            uN: prog.ast.units.length
            uI: u64
            for uI < uN loop {
                uid: (zast.nodeid.create from: (prog.ast.units.get i: uI))
                uI = uI + 1
                { un: prog.ast.nodes.get i: uid.u64
                  match (un) case namedoperation then {
                      unm: zast.poolTextAt pool: prog.ast.names ref: un.name
                      if unm.stringView == uname then mainOp = un.operation
                  } else null }
            }
            if mainOp.isZero then return
            # the unit node itself is fsno-less; anchor on the first member's
            # operation node, like the L013 walk does
            mainFsno: zvfs.fsno
            zeroFs: zvfs.fsno
            {
                bodyIds: zast.unitBodyIdsAt ast: prog.ast unitId: mainOp
                with bit: bodyIds.iterate do for mid: bit loop {
                    if mainFsno == zeroFs then {
                        anch: u32
                        { m: prog.ast.nodes.get i: mid.u64
                          if m.namedoperation then anch = m.operation }
                        if anch > 0 then {
                            mainFsno = prog.ast.fsnoForNode nodeid: anch
                        }
                    }
                }
            }
            if mainFsno == zeroFs then return
            used: (IdSet u64)
            with uit: st.typing.atomVariableId.iterateItems do for av: uit loop used.add item: av.value
            # the (node, variable) pairs are collected first: the conversion
            # probes below lend st
            dvPairs: (ListVal u64)
            with dit: st.typing.defVariableId.iterateItems do for dv: dit loop {
                dvPairs.append from: dv.key
                dvPairs.append from: dv.value.u64
            }
            dpi: u64
            for dpi < dvPairs.length loop {
                nid: dvPairs.get i: dpi
                vid: ztypes.vid.create from: (dvPairs.get i: (dpi + 1))
                dpi = dpi + 2
                if (used.has item: vid) then {
                    mut: st.typing.variableMutated.has item: vid
                    if (mut) == false then mut = st.typing.variableMoved.has item: vid
                    if (mut) == false then {
                        fs: prog.ast.fsnoForNode nodeid: nid.u32.orPanic
                        if fs == mainFsno then {
                            nodeL: prog.ast.nodes.get i: nid.u64
                            if nodeL.assignment then {
                                kind: this.owningConvKind ast: prog.ast :st rhsId: nodeL.value
                                # a view is only equivalent while the SOURCE holds
                                # the same bytes: a root that is written -- directly,
                                # or by a callee taking it as a mutable borrow --
                                # rebinds or frees them, so the copy is load-bearing
                                # (the save/restore idiom around a rebinding setter,
                                # and a loop whose tail reassigns the source).
                                srcMut: false
                                {
                                    rvid: (this.convSourceRootVid
                                        ast: prog.ast
                                        :st
                                        rhsId: nodeL.value
                                    )
                                    if (rvid.isZero) == false then {
                                        srcMut = st.typing.variableMutated.has item: rvid
                                    }
                                }
                                if kind.length > 0 when (srcMut) == false then {
                                    nm: zast.poolTextAt pool: prog.ast.names ref: nodeL.name
                                    (this.info
                                        code: "L022"
                                        msg: "local '\{nm}' is an owned copy (\{kind}) that is never mutated -- a borrowed view serves every use (`.stringView`, or `asString` at a probe)"
                                        line: nodeL.lineno
                                        col: nodeL.colno
                                        width: nm.length.u32.orPanic
                                    )
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    # reportUnusedDefs -- L012 (unused private definition). A private unit-level definition
    # (function, type, or alias excluded from a `public:` block) that is never referenced is
    # dead. Usage is declaration-based: a reference name resolved against the unit maps to the
    # same member DeclId that carries the private flag, so an unused alias is flagged even when
    # its target is used directly elsewhere.
    reportUnusedDefs: function {:this prog: Node.view uname: StringView st: zenv.ZSymbolTable.view} is {
        if prog.program then {
            mainTid: u64
            {
                uo: (ztypecheck.declTypeIdOf
                    :st
                    declId: (st.typing.declFindChild
                        parentDeclId: st.typing.programRoot
                        nameId: (zast.poolFind pool: prog.ast.names text: uname)
                    )
)
                if (uo.isZero) == false then mainTid = uo.u64
            }
            if mainTid > 0 then {
                usedE: (IdSet u64)
                # reference evidence off refDecl: a use of a unit-level def
                # marks its declaration under the unit; a member use marks
                # the member declaration under the owning type's canonical tid
                uNames: (ListVal u64)
                mOwn: (ListVal u64)
                mNms: (ListVal u64)
                with a: st.typing.refDecl.iterateItems do for e: a loop {
                    dNm: u64
                    dPar: u64
                    {
                        dlo: st.typing.decls.get i: e.value.u64
                        dNm = dlo.name.u64
                        dPar = dlo.parent
                    }
                    if dPar > 0 when dNm > 0 then {
                        pKindU: false
                        pTid: u64
                        {
                            plo: st.typing.decls.get i: dPar
                            if plo.kind.unitDecl then pKindU = true
                            if plo.kind.typeDecl then pTid = plo.typeId
                        }
                        if pKindU then uNames.append from: dNm
                        if pTid > 0 then {
                            mOwn.append from: pTid
                            mNms.append from: dNm
                        }
                    }
                }
                unI: u64
                for unI < uNames.length loop {
                    un9b: uNames.get i: unI
                    unI = unI + 1
                    cdi: (st.typing.declTypedMemberIdOf
                        parentTypeId: (ztypes.tid.create from: mainTid.u64)
                        nameId: (zast.nameid.create from: un9b.u32.orPanic)
                    )
                    if cdi > 0 then usedE.add item: cdi
                }
                tgtNames: (ztypecheck.publicAliasInternalNames
                    :st
                    pool: prog.ast.names
                    tid: (ztypes.tid.create from: mainTid.u64)
)
                tI: u64
                for tI < tgtNames.length loop {
                    tnm: tgtNames.get i: tI
                    tI = tI + 1
                    tpid: (prog.ast.names.find s: tnm.stringView)
                    if tpid > 0 then {
                        tdi: (st.typing.declTypedMemberIdOf
                            parentTypeId: (ztypes.tid.create from: mainTid.u64)
                            nameId: tpid
                        )
                        if tdi > 0 then usedE.add item: tdi
                    }
                }
                moI: u64
                for moI < mOwn.length loop {
                    moTid: mOwn.get i: moI
                    moNm: mNms.get i: moI
                    moI = moI + 1
                    mdi: (st.typing.declTypedMemberIdOf
                        parentTypeId: (ztypes.tid.create from: moTid.u64)
                        nameId: (zast.nameid.create from: moNm.u32.orPanic)
                    )
                    if mdi > 0 then usedE.add item: mdi
                }
                mainOp: zast.nodeid
                uN: prog.ast.units.length
                uI: u64
                for uI < uN loop {
                    uid: (zast.nodeid.create from: (prog.ast.units.get i: uI))
                    uI = uI + 1
                    unm: String
                    uop: zast.nodeid
                    {
                        un: prog.ast.nodes.get i: uid.u64
                        if un.namedoperation then {
                            unm = (zast.poolTextCopy pool: prog.ast.names ref: un.name)
                            uop = un.operation
                        }
                    }
                    if unm.stringView == uname when uop > 0 then mainOp = uop
                }
                if mainOp > 0 then {
                    memIds: (ListVal u32)
                    {
                        bodyIds: zast.unitBodyIdsAt ast: prog.ast unitId: mainOp
                        with bit: bodyIds.iterate do for mid: bit loop memIds.append from: mid
                    }
                    # syntactic fallback evidence: stamps exist only for
                    # bodies the demand walk checked, so a private def used
                    # only inside an unchecked body (a construction in a
                    # never-demanded factory) would read as dead. Any atomid
                    # in the unit's own file segment is a reference. The
                    # unit's wrapper nodes are minted after its file segment
                    # closes, so the first body member -- not the unitdef --
                    # probes for the segment.
                    probe: u32
                    if memIds.length > 0 then probe = memIds.get i: 0
                    segStart: u32
                    segEnd: u32
                    sgN: prog.ast.fileSegs.length
                    {
                        sgI: u64
                        for sgI < sgN loop {
                            sg: prog.ast.fileSegs.get i: sgI
                            sgI = sgI + 1
                            if probe >= sg.startId when probe < sg.endId then {
                                narrower: segEnd == segStart
                                if (sg.endId - sg.startId) < (segEnd - segStart) then narrower = true
                                if narrower then {
                                    segStart = sg.startId
                                    segEnd = sg.endId
                                }
                            }
                        }
                    }
                    refNameSet: (IdSet u64)
                    if segEnd > segStart then {
                        ndI: segStart.u64
                        for ndI < segEnd.u64 loop {
                            nd0: prog.ast.nodes.get i: ndI.u64
                            if nd0.atomid then {
                                refNameSet.add item: nd0.name.u64
                            }
                            ndI = ndI + 1
                        }
                    } else {
                        # no segment covers the unit body: it is the root
                        # parse (only subunit loads append segments), so
                        # scan the nodes no segment covers.
                        totN: prog.ast.nodes.length
                        ndJ: 1.u64
                        for ndJ < totN loop {
                            covered: false
                            {
                                sgJ: u64
                                for sgJ < sgN loop {
                                    sgB: prog.ast.fileSegs.get i: sgJ
                                    sgJ = sgJ + 1
                                    if ndJ >= sgB.startId.u64 when ndJ < sgB.endId.u64 then covered = true
                                }
                            }
                            if covered == false then {
                                ndB0: prog.ast.nodes.get i: ndJ
                                if ndB0.atomid then {
                                    refNameSet.add item: ndB0.name.u64
                                }
                            }
                            ndJ = ndJ + 1
                        }
                    }
                    mN: memIds.length
                    mI: u64
                    for mI < mN loop {
                        mid: memIds.get i: mI
                        mI = mI + 1
                        mNameRef: u32
                        mLn: u32
                        mCl: u32
                        {
                            m: prog.ast.nodes.get i: mid.u64
                            if m.namedoperation then {
                                mNameRef = m.name
                                mLn = m.lineno
                                mCl = m.colno
                            }
                        }
                        if mNameRef > 0 then {
                            dmD: (st.typing.declTypedMemberIdOf
                                parentTypeId: (ztypes.tid.create from: mainTid.u64)
                                nameId: (zast.nameid.create from: mNameRef.u32)
                            )
                            if dmD > 0 then {
                                priv: (ztypecheck.declMemberIsPrivate
                                    :st
                                    tid: (ztypes.tid.create from: mainTid.u64)
                                    nameId: (zast.nameid.create from: mNameRef.u32)
)
                                unref: (usedE.has item: dmD) == false
                                if unref then unref = (refNameSet.has item: mNameRef.u64) == false
                                if priv when unref then {
                                    dnm: (zast.poolTextAt
                                        pool: prog.ast.names
                                        ref: (zast.nameid.create from: mNameRef.u32)
                                    )
                                    (this.warn
                                        code: "L012"
                                        msg: "private definition '\{dnm}' is never used"
                                        line: mLn
                                        col: mCl
                                        width: dnm.length.u32.orPanic
                                    )
                                }
                            }
                        }
                    }
                    # private type members: walk each type definition's is/as
                    # members and flag private edges with no recorded use
                    tmI: u64
                    for tmI < mN loop {
                        tmid: memIds.get i: tmI
                        tmI = tmI + 1
                        tNameRef: zast.nameid
                        tOp: u32
                        {
                            tm: prog.ast.nodes.get i: tmid.u64
                            if tm.namedoperation then {
                                tNameRef = tm.name
                                tOp = tm.operation
                            }
                        }
                        isObjT: false
                        if tOp > 0 then {
                            to: prog.ast.nodes.get i: tOp.u64
                            if to.objectdef then isObjT = true
                        }
                        if isObjT when tNameRef > 0 then {
                            typeTid: u64
                            {
                                cto: (st.typing.declChildOfId
                                    parentTypeId: (ztypes.tid.create from: mainTid.u64)
                                    nameId: tNameRef
                                )
                                match (
                                    cto
                                ) case some then {
                                    typeTid = cto
                                } case none then null
                            }
                            if typeTid > 0 then {
                                tmemIds: (ListVal u32)
                                {
                                    tod: prog.ast.nodes.get i: tOp.u64
                                    if tod.objectdef then {
                                        with iit: tod.isItems.iterate do for iid: iit loop tmemIds.append from: iid
                                        with ait: tod.asItems.iterate do for aid: ait loop tmemIds.append from: aid
                                    }
                                }
                                tnm: (zast.poolTextAt
                                    pool: prog.ast.names
                                    ref: (zast.nameid.create from: tNameRef.u32)
                                )
                                tmN: tmemIds.length
                                tmJ: u64
                                for tmJ < tmN loop {
                                    tmmid: tmemIds.get i: tmJ
                                    tmJ = tmJ + 1
                                    tmName: u32
                                    tmLn: u32
                                    tmCl: u32
                                    {
                                        tmm: prog.ast.nodes.get i: tmmid.u64
                                        if tmm.namedoperation then {
                                            tmName = tmm.name
                                            tmLn = tmm.lineno
                                            tmCl = tmm.colno
                                        }
                                    }
                                    if tmName > 0 then {
                                        tmdi: (st.typing.declTypedMemberIdOf
                                            parentTypeId: (ztypes.tid.create from: typeTid.u64)
                                            nameId: (zast.nameid.create from: tmName.u32)
                                        )
                                        if tmdi > 0 then {
                                            tpriv: (ztypecheck.declMemberIsPrivate
                                                :st
                                                tid: (ztypes.tid.create from: typeTid.u64)
                                                nameId: (zast.nameid.create from: tmName.u32)
)
                                            if tpriv when (usedE.has item: tmdi) == false then {
                                                tmnm: (zast.poolTextAt
                                                    pool: prog.ast.names
                                                    ref: (zast.nameid.create from: tmName.u32)
                                                )
                                                (this.warn
                                                    code: "L012"
                                                    msg: "private member '\{tnm}.\{tmnm}' is never used"
                                                    line: tmLn
                                                    col: tmCl
                                                    width: tmnm.length.u32.orPanic
                                                )
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

# ---- L005 redundant-suffix helpers (typecheck tier; run only under --full) ----

# nodeinfo -- a node's synthetic id and source position.
nodeinfo: record {
    # the node
    id: u32
    # the source line, which is what a diagnostic reports rather than the
    # byte offset the wrap rules work in
    line: u32
    # the source column, paired with line
    col: u32
}

# nodeInfoOf -- the id and source position of any AST node.
nodeInfoOf: function {n: Node.view} out nodeinfo is {
    p: zast.posOf :n
    return (nodeinfo id: (zast.nodeIdOf :n).u32 line: p.line col: p.col)
}

# bareZeroTypeName -- the bare-type replacement when a dotted child atom is a
# zero-init suffix candidate: `string` maps to String, a concrete numeric
# type name maps to itself, anything else to "" (c8/c32 are not
# zero-suffix candidates).
bareZeroTypeName: function {ast: Ast.view n: Node.view} out String is {
    if n.atomid then {
        znB: zast.nameTextAt :ast ref: n.name
        if znB.stringView == "string" then return "String".string
        isNum: ztypecheck.isNumericTypeName name: znB.stringView
        if isNum when znB.stringView != "c8" then {
            if znB.stringView != "c32" then return znB.copy
        }
    }
    return "".string
}

# bareZeroParentText -- the source spelling of a zero-literal dotted parent:
# `""` for the empty string literal, `0` / `0.0` for the numeric zeros; ""
# when the parent is not a zero literal.
bareZeroParentText: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case atomstring then {
        if n.stringparts.length == 0 then return "\"\"".string
    } case atomid then {
        if (zast.nameTextEq :ast ref: n.name s: "0") then return "0".string
        if (zast.nameTextEq :ast ref: n.name s: "0.0") then return "0.0".string
    } else null
    return "".string
}

# isNonDec -- a literal lexeme in hex / binary / octal form.
isNonDec: function {s: StringView} out bool is {
    if (s.startsWith prefix: "0x") then return true
    if (s.startsWith prefix: "0X") then return true
    if (s.startsWith prefix: "0b") then return true
    if (s.startsWith prefix: "0B") then return true
    if (s.startsWith prefix: "0o") then return true
    if (s.startsWith prefix: "0O") then return true
    return false
}

# literalFitsBase -- the literal value fits its base's default type (i64 for decimal, u64 for
# non-decimal). A literal that overflows the default keeps its suffix (load-bearing).
literalFitsBase: function {numstr: StringView} out bool is {
    pv: ztypes.parseLiteralValue :numstr
    if pv.ok == false then return false
    if pv.isFloat then return true
    if (isNonDec s: numstr) then return true
    iMax: 9223372036854775807.u64
    return pv.ival <= iMax
}

# SufRec -- a candidate suffix: the suffix type name ("" when not a candidate) and the
# position of the suffix's type token.
SufRec: class {
    # the type name the suffix spelled
    tname: String
    # the line the suffix is on
    line: u32
    # the column it starts at
    col: u32
}

# operandSuffix -- peel an `expression` wrapper and report whether the operand is a redundant
# -suffix dotted path, with the type token's position.
operandSuffix: function {ast: Ast.view n: Node.view} out SufRec is {
    match (
        n
    ) case expression then {
        return (operandSuffix :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        cn: atomName :ast n: (ast.nodes.get i: n.child.u64)
        if (ztypecheck.isNumericTypeName name: cn.stringView) == false then {
            return (SufRec tname: "".string line: 0 col: 0)
        }
        pn: atomName :ast n: (ast.nodes.get i: n.parent.u64)
        if pn.length == 0 then return (SufRec tname: "".string line: 0 col: 0)
        if (literalFitsBase numstr: pn.stringView) == false then {
            return (SufRec tname: "".string line: 0 col: 0)
        }
        ci: nodeInfoOf n: (ast.nodes.get i: n.child.u64)
        return (SufRec tname: cn line: ci.line col: ci.col)
    } else {
        return (SufRec tname: "".string line: 0 col: 0)
    }
}

# isNodeConst -- the node carries a compile-time const value.
isNodeConst: function {nid: zast.nodeid st: zenv.ZSymbolTable.view} out bool is {
    return (st.typing.nodeConst.has key: nid.u64)
}

# typeNameOfNode -- the resolved type name of a node ("" when unresolved).
typeNameOfNode: function {n: Node.view st: zenv.ZSymbolTable.view} out String is {
    info: nodeInfoOf :n
    to: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: info.id.u64
    if to > 0 then {
        return (st.reg.nameOf tid: (ztypes.tid.create from: to.u64))
    } else {
        return "".string
    }
}

# typeNameOfOptAt -- the id-taking entry (0 = absent).
typeNameOfOptAt: function {
    ast: Ast.view
    oId: zast.nodeid
    st: zenv.ZSymbolTable.view
} out String is {
    if oId.isZero then return "".string
    o: ast.nodes.get i: oId.u64
    return (typeNameOfNode n: o :st)
}

# litShapedSuf -- the node is a numeric literal, bare or wearing a width
# conversion (`5`, `5.u32`, `(1.0e300).f128`): such an operand must never
# anchor a suffix strip -- removing the other side's suffix would leave
# default-typed literals and change the arithmetic width.
litShapedSuf: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (litShapedSuf :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        an: zast.nameTextAt :ast ref: n.name
        d: false
        b: an.stringView.byteAt 0
        match (
            b
        ) case some then {
            if b >= 48 when b <= 57 then d = true
        } case none then null
        return d
    } case dottedpath then {
        return (litShapedSuf :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return false
    }
}

# isAnchor -- the node is a concrete non-literal value of numeric type `tname`, a genuine
# type anchor that makes a same-type literal suffix redundant.
isAnchor: function {
    ast: Ast.view
    n: Node.view
    tname: StringView
    st: zenv.ZSymbolTable.view
} out bool is {
    if (litShapedSuf :ast :n) then return false
    info: nodeInfoOf :n
    nid: info.id.u64
    to: ztyping.nodeTypeAt tbl: st.typing.nodeType :nid
    if to > 0 then {
        zhit: false
        znm: String
        {
            name9v: st.reg.nameOf tid: (ztypes.tid.create from: to.u64)
                zhit = true
                znm = name9v
        }
        if zhit == false then return false
        if (znm.stringView == tname) == false then return false
        if (isNodeConst nid: (zast.nodeid.create from: nid.u32.orPanic) :st) then return false
        return true
    } else {
        return false
    }
}

# mainUnitNameOf -- the program's main unit name.
mainUnitNameOf: function {program: Node.view} out String is {
    match (
        program
    ) case program then {
        return program.mainUnitName.copy
    } else {
        return "".string
    }
}

# unitNameOf -- a file path's unit name: the final path segment without the ".z" suffix.
unitNameOf: function {path: StringView} out String is {
    base: path.string
    slashOpt: path.lastIndexOf needle: "/"
    match (
        slashOpt
    ) case some then {
        r: String
        i: slashOpt + 1
        n: path.length
        for i < n loop {
            b: path.byteAt :i
            match (
                b
            ) case some then {
                r.appendByte :b
            } case none then null
            i = i + 1
        }
        base = r
    } case none then null
    sfx: base.stringView.stripSuffix s: ".z"
    match (
        sfx
    ) case some then {
        return sfx.string
    } case none then {
        return base.copy
    }
}

# linesOf -- split source into a 1-based-addressable list of lines (newlines stripped).
linesOf: function {src: StringView} out (List String) is {
    ls: (List String)
    with it: src.lines do for ln: it loop ls.append ln.string
    return ls
}

# lineStartIndex -- byte offset of each line's first byte, one entry per line (matching
# linesOf). Extends the W001 `off += len + 1` accumulator; converts token/edit positions to
# byte offsets and back without depending on the tokenizer's escape-decoded widths.
lineStartIndex: function {src: StringView} out (ListVal u64) is {
    ls: (ListVal u64)
    off: u64
    lls: linesOf :src
    with it: lls.iterate do for ln: it loop {
        ls.append off
        off = off + ln.length + 1
    }
    return ls
}

# byteToLine -- the 0-based index of the line containing byte `off`: the largest i with
# lineStart[i] <= off. lineStart ascends, so the scan stops at the first line past off.
byteToLine: function {lineStart: (ListVal u64).view off: u64 nLines: u64} out u64 is {
    r: u64
    i: u64
    for i < nLines loop {
        v: lineStart.get :i
        if v <= off then {
            r = i
        } else {
            break
        }
        i = i + 1
    }
    return r
}

# colToByteInLine -- byte offset within `lineText` of the 1-based codepoint column `colno`.
# Token columns are codepoint-based (multibyte-aware); this walks the line's bytes, consuming
# one codepoint (a lead byte plus its 0x80..0xBF continuations) per column. ASCII: colno - 1.
colToByteInLine: function {lineText: StringView colno: u32} out u64 is {
    if colno <= 1 then return 0
    target: (colno - 1).u64
    n: lineText.length
    b: u64
    cp: u64
    for cp < target loop {
        if b >= n then break
        b = b + 1
        cont: true
        for cont loop {
            if b >= n then {
                cont = false
            } else {
                nb: lineText.byteAt i: b
                isC: false
                match (
                    nb
                ) case some then {
                    if nb >= 128 when (nb < 192) then isC = true
                } case none then null
                if isC then {
                    b = b + 1
                } else {
                    cont = false
                }
            }
        }
        cp = cp + 1
    }
    return b
}

# tokByteStart -- absolute byte offset of a token from its 1-based (lineno, colno): the line's
# start offset plus the codepoint-column converted to a byte column.
tokByteStart: function {
    lineStart: (ListVal u64).view
    srcLines: (List String).view
    lineno: u32
    colno: u32
} out u64 is {
    li: (lineno - 1).u64
    if li >= srcLines.length then return 0
    base: lineStart.get i: li
    lt: srcLines.get i: li
    return base + (colToByteInLine lineText: lt.stringView :colno)
}

# sortEdits -- a new edit list ordered by byteLo (ascending, stable for ties). applyEdits and
# renderDiff require sorted, non-overlapping input; each rule emits its own edits in order but
# they interleave across rules, so a global sort is run once all rules have contributed.
sortEdits: function {edits: (List zfix.Edit).borrow} out (List zfix.Edit) is {
    result: (List zfix.Edit)
    n: edits.length
    used: (ListVal bool)
    p: u64
    for p < n loop {
        used.append false
        p = p + 1
    }
    k: u64
    for k < n loop {
        best: n
        bestLo: u64
        bestHi: u64
        i: u64
        for i < n loop {
            u: used.get :i
            if (u) == false then {
                e: edits.get :i
                take: false
                if best == n then {
                    take = true
                } else if e.byteLo < bestLo then {
                    take = true
                } else if e.byteLo == bestLo when (e.byteHi > bestHi) then take = true
                if take then {
                    best = i
                    bestLo = e.byteLo
                    bestHi = e.byteHi
                }
            }
            i = i + 1
        }
        be: edits.get i: best
        result.append (zfix.Edit
            byteLo: be.byteLo
            byteHi: be.byteHi
            replacement: be.replacement.copy
        )
        used.set i: best val: true
        k = k + 1
    }
    return result
}

# emitDiffHunk -- append one zero-context unified-diff hunk to `buf` for the cluster of edits
# [cStart, cEnd) spanning old lines [clLo, clHi]. The new-side block is the old bytes with the
# cluster's edits applied, so the hunk exactly reflects the formatted output. Returns the
# running new-minus-old line delta for the next hunk's + start.
emitDiffHunk: function {
    buf: String
    source: StringView
    edits: (List zfix.Edit).view
    cStart: u64
    cEnd: u64
    clLo: u64
    clHi: u64
    lineStart: (ListVal u64).view
    srcLines: (List String).borrow
    newDelta: i64
} out i64 is {
    nLines: srcLines.length
    srcLen: source.length
    oldCount: (clHi - clLo) + 1
    aByte: lineStart.get i: clLo
    bByte: srcLen
    if (clHi + 1) < nLines then bByte = lineStart.get i: (clHi + 1)
    newBlock: String
    prev: aByte
    j: cStart
    for j < cEnd loop {
        e: edits.get i: j
        if e.byteLo >= prev when (e.byteLo <= e.byteHi) then {
            zfix.appendRange buf: newBlock src: source lo: prev hi: e.byteLo
            newBlock.append e.replacement
            prev = e.byteHi
        }
        j = j + 1
    }
    zfix.appendRange buf: newBlock src: source lo: prev hi: bByte
    newLines: (List String)
    if newBlock.length > 0 then newLines = linesOf src: newBlock.stringView
    newCount: newLines.length
    newStart: (clLo.i64.orPanic + newDelta) + 1
    hh: "@@ -\{clLo + 1},\{oldCount} +\{newStart},\{newCount} @@\n"
    buf.append hh
    oi: clLo
    for oi <= clHi loop {
        ol: srcLines.get i: oi
        dm: "-\{ol}\n"
        buf.append dm
        oi = oi + 1
    }
    if (clHi + 1) == nLines when ((endsWithNewline src: source) == false) then {
        buf.append "\\ No newline at end of file\n"
    }
    with nit: newLines.iterate do for nl: nit loop {
        pm: "+\{nl}\n"
        buf.append pm
    }
    if newBlock.length > 0 when ((endsWithNewline src: newBlock.stringView) == false) then {
        buf.append "\\ No newline at end of file\n"
    }
    return (newDelta + newCount.i64.orPanic) - oldCount.i64.orPanic
}

# byteAtLine -- byte offset of line `k`'s start, or `srcLen` when `k` is one past the last line.
byteAtLine: function {starts: (ListVal u64).view srcLen: u64 k: u64} out u64 is {
    if k >= starts.length then return srcLen
    return (starts.get i: k)
}

# lineDiffEdits -- edits transforming `old` into `new`, one per changed line-block, shaped for
# renderDiff. fmt + wrap never reorder lines, so an in-order two-pointer with a bounded diagonal-band
# resync finds correct (within the window, minimal) blocks; applyEdits(old, result) == new.
lineDiffEdits: function {old: StringView new: StringView} out (List zfix.Edit) is {
    oldLines: linesOf src: old
    newLines: linesOf src: new
    oldStarts: lineStartIndex src: old
    newStarts: lineStartIndex src: new
    m: oldLines.length
    n: newLines.length
    oldLen: old.length
    newLen: new.length
    edits: (List zfix.Edit)
    i: u64
    p: u64
    for true loop {
        if i >= m when (p >= n) then break
        matched: false
        if i < m when (p < n) then {
            oi: oldLines.get :i
            pj: newLines.get i: p
            if oi.stringView == pj.stringView then matched = true
        }
        if matched then {
            i = i + 1
            p = p + 1
        } else {
            i2: m
            p2: n
            found: false
            t: 1.u64
            for t <= 256 loop {
                if found then break
                a: u64
                for a <= t loop {
                    if found then break
                    b: t - a
                    ii: i + a
                    pp: p + b
                    if ii < m when (pp < n) then {
                        oa: oldLines.get i: ii
                        pb: newLines.get i: pp
                        if oa.stringView == pb.stringView then {
                            i2 = ii
                            p2 = pp
                            found = true
                        }
                    }
                    a = a + 1
                }
                t = t + 1
            }
            if found == false then {
                we: i + 256
                if we > m then we = m
                wf: p + 256
                if wf > n then wf = n
                i2 = we
                p2 = wf
            }
            lo: byteAtLine starts: oldStarts srcLen: oldLen k: i
            hi: byteAtLine starts: oldStarts srcLen: oldLen k: i2
            nlo: byteAtLine starts: newStarts srcLen: newLen k: p
            nhi: byteAtLine starts: newStarts srcLen: newLen k: p2
            repl: String
            zfix.appendRange buf: repl src: new lo: nlo hi: nhi
            doEmit: false
            if hi > lo then doEmit = true
            if nhi > nlo then doEmit = true
            if doEmit then edits.append (zfix.Edit byteLo: lo byteHi: hi replacement: repl)
            i = i2
            p = p2
        }
    }
    return edits
}

# renderDiff -- a git-style unified diff (zero context) of `source` -> the formatted result,
# driven by `edits` (assumed sorted by byteLo). Adjacent edits touching the same or
# neighbouring lines share a hunk. Empty when there are no edits.
renderDiff: function {
    path: StringView
    source: StringView
    edits: (List zfix.Edit).borrow
} out String is {
    buf: String
    m: edits.length
    if m == 0 then return buf
    lineStart: lineStartIndex src: source
    srcLines: linesOf src: source
    nLines: srcLines.length

    hdr: "--- \{path}\n+++ \{path}\n"
    buf.append hdr

    newDelta: i64
    cActive: false
    cStart: u64
    clLo: u64
    clHi: u64
    i: u64
    for i < m loop {
        e: edits.get :i
        lo: byteToLine :lineStart off: e.byteLo :nLines
        hi: lo
        if e.byteHi > e.byteLo then hi = byteToLine :lineStart off: (e.byteHi - 1) :nLines
        if (cActive) == false then {
            cActive = true
            cStart = i
            clLo = lo
            clHi = hi
        } else if lo <= (clHi + 1) then {
            if hi > clHi then clHi = hi
        } else {
            newDelta = (emitDiffHunk
                :buf
                :source
                :edits
                :cStart
                cEnd: i
                :clLo
                :clHi
                :lineStart
                :srcLines
                :newDelta
            )
            cStart = i
            clLo = lo
            clHi = hi
        }
        i = i + 1
    }
    if cActive then {
        newDelta = (emitDiffHunk
            :buf
            :source
            :edits
            :cStart
            cEnd: m
            :clLo
            :clHi
            :lineStart
            :srcLines
            :newDelta
        )
    }
    return buf
}

# analyzeSource -- the fast-tier analysis over IN-MEMORY source: the
# read-then-analyze wrappers and zls's live editor buffers share it.
analyzeSource: function {source: String.take path: String.take opts: lintopts} out Analysis is {
    root: ast.parseSource source: source.copy
    lines: linesOf src: source.stringView
    a: (Analysis
        path: path.copy
        source: source.take
        :lines
        lineStart: (ListVal u64)
        diags: (List zdiag.Diagnostic)
        edits: (List zfix.Edit)
        wrapWidth: 0
        wrapSkip: 0
        wrapFound: false
        wrapStart: 0
        delimClose: (IdMapV u64 v: u64)
        fastToks: (List tokenize.Token)
        funcDepth: 0
        wrapGroups: (ListVal u64)
        :opts
    )
    a.runFastChecks n: root
    if opts.arch then a.reportDuplicateBodies prog: root
    a.walkTypeCasingProgram prog: root
    a.walkGenericParamCasingProgram prog: root
    if opts.casing then a.walkCasingProgram prog: root
    anyDocs: opts.docs
    if opts.docParams then anyDocs = true
    if opts.docFields then anyDocs = true
    if opts.docsQuality then anyDocs = true
    if opts.docsQuality then a.reportDuplicateDocs
    if anyDocs then (a.walkDocsProgram
        prog: root
        docs: opts.docs
        docParams: opts.docParams
        docFields: opts.docFields
    )
    a.checkLineLength width: opts.lineLength
    a.sortEditsInPlace
    return a
}

# analyzeFile -- fast-tier analysis of one file: read, fast-parse (no VFS/typecheck),
# build the line table, and collect parse-error diagnostics.
analyzeFile: function {path: String.take opts: lintopts} out Analysis is {
    rd: io.readText :path
    match (
        rd
    ) case ok then {
        return (analyzeSource source: rd.take path: path.copy :opts)
    } case err then {
        a: (Analysis
            path: path.copy
            source: "".string
            lines: (List String)
            lineStart: (ListVal u64)
            diags: (List zdiag.Diagnostic)
            edits: (List zfix.Edit)
            wrapWidth: 0
            wrapSkip: 0
            wrapFound: false
            wrapStart: 0
            delimClose: (IdMapV u64 v: u64)
            fastToks: (List tokenize.Token)
            funcDepth: 0
            wrapGroups: (ListVal u64)
            :opts
        )
        d: (zdiag.errorDiag
            errv: zast.err.ioError
            fsno: zvfs.fsno
            lineno: 0
            colno: 0
            width: 0
            msg: "could not read file".string
            note: "".string
            hint: "".string
        )
        a.diags.append d
        return a
    }
}

# analyzeFileFull -- fast-tier analysis plus the typecheck-tier suffix rule (L005). Builds the
# project VFS from `srcdir`/`systemdir` and typechecks this file's unit so the suffix check has
# resolved types. Slower than analyzeFile; only the --full path calls it.
analyzeFileFull: function {
    path: String.take
    # every --src root, searched in the order given
    srcdirs: (List String).view
    systemdir: StringView
    opts: lintopts
} out Analysis is {
    rd: io.readText :path
    match (
        rd
    ) case ok then {
        root: ast.parseSource source: rd.copy
        lines: linesOf src: rd.stringView
        a: (Analysis
            path: path.copy
            source: rd.take
            :lines
            lineStart: (ListVal u64)
            diags: (List zdiag.Diagnostic)
            edits: (List zfix.Edit)
            wrapWidth: 0
            wrapSkip: 0
            wrapFound: false
            wrapStart: 0
            delimClose: (IdMapV u64 v: u64)
            fastToks: (List tokenize.Token)
            funcDepth: 0
            wrapGroups: (ListVal u64)
            :opts
        )
        a.runFastChecks n: root
        if opts.arch then a.reportDuplicateBodies prog: root
        a.walkTypeCasingProgram prog: root
        a.walkGenericParamCasingProgram prog: root
        anyDocs: opts.docs
        if opts.docParams then anyDocs = true
        if opts.docFields then anyDocs = true
        if opts.docsQuality then anyDocs = true
        if opts.docsQuality then a.reportDuplicateDocs
        if anyDocs then (a.walkDocsProgram
            prog: root
            docs: opts.docs
            docParams: opts.docParams
            docFields: opts.docFields
        )
        un: unitNameOf path: a.path.stringView
        a.checkSuffix :srcdirs :systemdir uname: un.stringView
        a.checkLineLength width: opts.lineLength
        a.sortEditsInPlace
        return a
    } case err then {
        a: (Analysis
            path: path.copy
            source: "".string
            lines: (List String)
            lineStart: (ListVal u64)
            diags: (List zdiag.Diagnostic)
            edits: (List zfix.Edit)
            wrapWidth: 0
            wrapSkip: 0
            wrapFound: false
            wrapStart: 0
            delimClose: (IdMapV u64 v: u64)
            fastToks: (List tokenize.Token)
            funcDepth: 0
            wrapGroups: (ListVal u64)
            :opts
        )
        d: (zdiag.errorDiag
            errv: zast.err.ioError
            fsno: zvfs.fsno
            lineno: 0
            colno: 0
            width: 0
            msg: "could not read file".string
            note: "".string
            hint: "".string
        )
        a.diags.append d
        return a
    }
}

# analyzeFileTiered -- analyze one file at the requested tier: the fast tier by default, or
# the full (typecheck) tier under --full (which also needs the project src/system dirs).
analyzeFileTiered: function {
    path: String.take
    # every --src root, searched in the order given
    srcdirs: (List String).view
    systemdir: StringView
    opts: lintopts
} out Analysis is {
    if opts.full then return (analyzeFileFull :path :srcdirs :systemdir :opts)
    return (analyzeFile :path :opts)
}

# codepointLen -- number of Unicode codepoints in `s` (UTF-8 continuation bytes 0x80..0xBF are not
# counted); the display "column" length for the line-length rule.
codepointLen: function {s: StringView} out u64 is {
    n: s.length
    c: u64
    b: u64
    for b < n loop {
        bo: s.byteAt i: b
        cont: false
        match (
            bo
        ) case some then {
            if bo >= 128 when (bo < 192) then cont = true
        } case none then null
        if (cont) == false then c = c + 1
        b = b + 1
    }
    return c
}

# sourceParses -- true if `source` parses with no embedded parse errors. `zl fmt`
# uses it to confirm an edited buffer is still valid before writing it out.
sourceParses: function {source: String.take} out bool is {
    a: (Analysis
        path: "".string
        source: "".string
        lines: (List String)
        lineStart: (ListVal u64)
        diags: (List zdiag.Diagnostic)
        edits: (List zfix.Edit)
        wrapWidth: 0
        wrapSkip: 0
        wrapFound: false
        wrapStart: 0
        delimClose: (IdMapV u64 v: u64)
        fastToks: (List tokenize.Token)
        funcDepth: 0
        wrapGroups: (ListVal u64)
        opts: defaultOpts
    )
    root: ast.parseSource :source
    a.walkProgram prog: root
    return a.parseErrorCount == 0
}

# nlIndent -- a newline followed by `n` spaces (the wrap indent unit).
nlIndent: function {n: u64} out String is {
    s: "\n".string
    i: u64
    for i < n loop {
        s.appendByte b: 32
        i = i + 1
    }
    return s
}

# leadingSpaces -- count of leading space bytes on a line.
leadingSpaces: function {line: StringView} out u64 is {
    n: u64
    for n < line.length loop {
        bo: line.byteAt i: n
        sp: false
        match (
            bo
        ) case some then {
            if bo == 32 then sp = true
        } case none then null
        if sp == false then return n
        n = n + 1
    }
    return n
}

# rstripLen -- byte length of a line excluding trailing spaces and tabs.
rstripLen: function {line: StringView} out u64 is {
    n: line.length
    for n > 0 loop {
        bo: line.byteAt i: (n - 1)
        ws: false
        match (
            bo
        ) case some then {
            if bo == 32 then ws = true
            if bo == 9 then ws = true
        } case none then null
        if ws == false then return n
        n = n - 1
    }
    return 0
}

# wsRunStartNL -- like wsRunStart but also swallows newline bytes: the start of
# the whitespace-and-newline run ending at `from`. Collapses the indentation and
# line break between a single-statement body and its closing brace.
wsRunStartNL: function {src: StringView from: u64} out u64 is {
    n: from
    for n > 0 loop {
        bo: src.byteAt i: (n - 1)
        ws: false
        match (
            bo
        ) case some then {
            if bo == 32 then ws = true
            if bo == 9 then ws = true
            if bo == 10 then ws = true
            if bo == 13 then ws = true
        } case none then null
        if ws == false then return n
        n = n - 1
    }
    return n
}

# wsRunStart -- start byte of the whitespace run ending just before `from`.
wsRunStart: function {src: StringView from: u64} out u64 is {
    n: from
    for n > 0 loop {
        bo: src.byteAt i: (n - 1)
        ws: false
        match (
            bo
        ) case some then {
            if bo == 32 then ws = true
            if bo == 9 then ws = true
        } case none then null
        if ws == false then return n
        n = n - 1
    }
    return n
}

# hasHash -- true if the line contains a `#` (a comment; wrapping skips such lines).
hasHash: function {line: StringView} out bool is {
    n: u64
    for n < line.length loop {
        bo: line.byteAt i: n
        match (
            bo
        ) case some then {
            if bo == 35 then return true
        } case none then null
        n = n + 1
    }
    return false
}

# buildDelimMap -- build a map of open-byte -> matching close-byte for every () and {} pair, from
# the token stream. String-literal and interpolation delimiters are distinct token kinds, so they
# are never counted.
buildDelimMap: function {
    src: StringView
    lineStart: (ListVal u64).view
    srcLines: (List String).borrow
} out (IdMapV u64 v: u64) is {
    m: (IdMapV u64 v: u64)
    scanPool: zast.StringPool.create
    toks: tokenize.scan source: src.string pool: scanPool
    nt: toks.length
    stack: (ListVal u64)
    i: u64
    for i < nt loop {
        t: toks.get :i
        kind: u32
        match (
            t.toktype
        ) case parenOpenTok then {
            kind = 1
        } case braceOpenTok then {
            kind = 1
        } case parenCloseTok then {
            kind = 2
        } case braceCloseTok then {
            kind = 2
        } else null
        if kind == 1 then {
            b: tokByteStart :lineStart :srcLines lineno: t.lineno colno: t.colno
            stack.append b
        } else if kind == 2 then {
            if stack.length > 0 then {
                ob: stack.pop
                cb: tokByteStart :lineStart :srcLines lineno: t.lineno colno: t.colno
                m.set key: ob value: cb
            }
        }
        i = i + 1
    }
    return m
}

# wrapSource -- fixpoint auto-wrap of over-long named-arg calls under --line-length. Each pass wraps
# the first over-long single-line call (adding parens when bare), re-parses, and discards a wrap that
# would not parse (skipping past it); loops until no wrappable call remains.
wrapSource: function {source: StringView lineLength: u32} out String is {
    cur: source.string
    guard: u64
    for guard < 40 loop {
        guard = guard + 1
        rd: cur.copy
        a: (Analysis
            path: "".string
            source: rd.copy
            lines: (linesOf src: rd.stringView)
            lineStart: (lineStartIndex src: rd.stringView)
            diags: (List zdiag.Diagnostic)
            edits: (List zfix.Edit)
            wrapWidth: lineLength
            wrapSkip: 0
            wrapFound: false
            wrapStart: 0
            delimClose: (IdMapV u64 v: u64)
            fastToks: (List tokenize.Token)
            funcDepth: 0
            wrapGroups: (ListVal u64)
            opts: defaultOpts
        )
        root: ast.parseSource source: rd.copy
        a.delimClose = buildDelimMap src: rd.stringView lineStart: a.lineStart srcLines: a.lines
        # the wrap pass runs the full visitor: bracesBlocked (the comment
        # guard for L008/L010 debraces) reads fastToks, so the token scan
        # must be populated here too or commented bodies lose their
        # comments whenever a wrap edit lands in the same batch
        scanPool: zast.StringPool.create
        a.fastToks = tokenize.scan source: rd.copy pool: scanPool
        a.walkProgram prog: root
        if a.wrapFound == false then break
        se: sortEdits edits: a.edits
        cand: zfix.applyEdits source: cur.stringView edits: se
        cok: sourceParses source: cand.copy
        if cok then {
            cur = cand
        } else {
            good: (List zfix.Edit)
            ng: a.wrapGroups.length
            gi: u64
            for gi < ng loop {
                gstart: a.wrapGroups.get i: gi
                gend: a.edits.length
                if (gi + 1) < ng then gend = a.wrapGroups.get i: (gi + 1)
                added: u64
                k: gstart
                for k < gend loop {
                    e: a.edits.get i: k
                    good.append (zfix.Edit
                        byteLo: e.byteLo
                        byteHi: e.byteHi
                        replacement: e.replacement.copy
                    )
                    added = added + 1
                    k = k + 1
                }
                cnd2: zfix.applyEdits source: cur.stringView edits: good
                bad: (sourceParses source: cnd2.copy) == false
                if bad then {
                    j: u64
                    for j < added loop {
                        good.pop
                        j = j + 1
                    }
                }
                gi = gi + 1
            }
            if good.length == 0 then break
            cur = zfix.applyEdits source: cur.stringView edits: good
        }
    }
    return cur
}
