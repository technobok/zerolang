# zenv_smoke -- the zenv smoke harness: builds a registry and a typing, opens
# frames, defines and locks locals, narrows and takes, and prints what the walk
# state holds at each step. Compared against tests/fixtures/zenv_smoke_z/smoke.expected.

public: unit {
    :main
}

# a bool rendered as "true" or "false".
boolText: function {b: bool} out String is {
    match (
        b
    ) case true then {
        return "true".string
    } case false then {
        return "false".string
    }
}

# an optional u64 rendered as text ("none" when absent).
vidOrNoneText: function {o: optionval ztypes.vid} out String is {
    match (
        o
    ) case some then {
        ov: o + 0
        return "\{ov}"
    } case none then {
        return "none".string
    }
}

# optTidText -- the same for an optional TYPE id; an `optionval tid` is not
# an `optionval u64`, so the smoke needs its own reader.
optTidText: function {o: optionval ztypes.tid} out String is {
    match (
        o
    ) case some then {
        return "\{o.u64}"
    } case none then {
        return "none".string
    }
}

main: function is {
    reg: ztypes.newRegistry
    tResult: reg.newType name: "result" typetype: ztypes.ztypetype.unionType
    tOk: reg.newType name: "ok" typetype: ztypes.ztypetype.recordType
    tErr: reg.newType name: "err" typetype: ztypes.ztypetype.recordType
    tNone: reg.newType name: "none" typetype: ztypes.ztypetype.nullType
    tBuf: reg.newType name: "buf" typetype: ztypes.ztypetype.classType
    tI64: reg.newType name: "i64" typetype: ztypes.ztypetype.recordType
    pool: zast.StringPool.create
    reg.setNeedsDestructor typeId: tBuf

    ty: ztyping.newTyping
    ty.setMemberType parentTypeId: tResult nameId: (pool.set s: "ok") childTypeId: tOk
    ty.setMemberType parentTypeId: tResult nameId: (pool.set s: "err") childTypeId: tErr
    ty.setMemberType parentTypeId: tResult nameId: (pool.set s: "none") childTypeId: tNone

    ty.dumpRows = true
    st: zenv.newSymbolTable :reg typing: ty

    print "=== scopes ==="
    s0: st.push name: "func" parent: ztypes.declid
    print "push func -> frame=\{s0} open=\{st.open.length}"

    idX: pool.set s: "x"
    idY: pool.set s: "y"
    idMy: pool.set s: "MyType"
    idR: pool.set s: "r"

    vidX: st.reg.newVariable ztypeId: tBuf ownership: ztypes.zownership.owned
    st.defineVar nameId: idX vid: vidX
    vy: st.reg.newVariable ztypeId: tI64 ownership: ztypes.zownership.owned
    st.defineVar nameId: idY vid: vy
    st.define nameId: idMy ztypeId: tResult

    print "=== lookup ==="
    smokeLookup :st :pool name: "x"
    smokeLookup :st :pool name: "y"
    smokeLookup :st :pool name: "MyType"
    smokeLookup :st :pool name: "z"
    smokeVarId :st :pool name: "x"
    smokeVarId :st :pool name: "MyType"

    print "=== live owned vars ==="
    live: st.getLiveOwnedVars
    print "live has x -> \{boolText (live.has item: idX)}"
    print "live has y -> \{boolText (live.has item: idY)}"

    print "=== locks ==="
    px: (ListVal zast.nameid)
    px.append idX
    holderX: (ztypes.zlockholder kind: ztypes.zlockholderkind.varKind id: vidX)
    r1: (st.tryLock
        :pool
        path: px
        lockType: ztypes.zlockstate.exclusive
        lockScope: ztypes.zlockscope.target
        holder: holderX
    )
    print "lock x EXCLUSIVE -> \{smokeErr r1.stringView}"

    px2: (ListVal zast.nameid)
    px2.append idX
    holderC: (ztypes.zlockholder kind: ztypes.zlockholderkind.callKind id: 99)
    r2: (st.tryLock
        :pool
        path: px2
        lockType: ztypes.zlockstate.shared
        lockScope: ztypes.zlockscope.target
        holder: holderC
    )
    print "lock x SHARED -> \{smokeErr r2.stringView}"

    pxq: (ListVal zast.nameid)
    pxq.append idX
    print "isPathLocked x -> \{boolText (st.isPathLocked path: pxq)}"
    pyq: (ListVal zast.nameid)
    pyq.append idY
    print "isPathLocked y -> \{boolText (st.isPathLocked path: pyq)}"

    pxe: (ListVal zast.nameid)
    pxe.append idX
    exc: st.findExclusiveLock path: pxe
    match (
        exc
    ) case some then {
        print "exclusive holder of x -> \{st.formatLockHolder :pool holder: exc}"
    } case none then {
        print "exclusive holder of x -> none"
    }
    st.releaseHeldLocks holder: holderX
    pxr: (ListVal zast.nameid)
    pxr.append idX
    print "isPathLocked x after release -> \{boolText (st.isPathLocked path: pxr)}"
    print "findLock x after release -> \{smokeLockState (st.findLock nameId: idX)}"

    print "=== invalidate ==="
    loc: (optionval.some (ztypes.zsrcpos fsno: zvfs.fsno lineno: 12 colno: 4))
    inv: st.invalidate nameId: idY :loc
    print "invalidate y -> \{boolText inv}"
    smokeLookup :st :pool name: "y"
    tl: st.getTakenLocation nameId: idY
    match (
        tl
    ) case some then {
        print "taken y at line -> \{tl.lineno}"
    } case none then {
        print "taken y at line -> none"
    }
    st.setTakenLocation nameId: idY loc: (ztypes.zsrcpos fsno: zvfs.fsno lineno: 99 colno: 1)
    tl2: st.getTakenLocation nameId: idY
    match (
        tl2
    ) case some then {
        print "taken y relocated -> \{tl2.lineno}"
    } case none then {
        print "taken y relocated -> none"
    }
    st.clearTaken nameId: idY
    print "after clearTaken:"
    smokeLookup :st :pool name: "y"

    print "=== narrowing ==="
    vr: st.reg.newVariable ztypeId: tResult ownership: ztypes.zownership.owned
    st.defineVar nameId: idR vid: vr
    armOk: pool.set s: "ok"
    armNone: pool.set s: "none"
    armErr: pool.set s: "err"
    st.narrow nameId: idR toTypeId: tResult subtypeName: armOk shadow: true
    smokeLookup :st :pool name: "r"
    print "subtype r -> \{smokeSubtype :pool id: (st.getSubtypeName nameId: idR)}"
    st.resetNarrowing nameId: idR
    print "after reset subtype r -> \{smokeSubtype :pool id: (st.getSubtypeName nameId: idR)}"
    smokeLookup :st :pool name: "r"

    print "=== exclude ==="
    st.exclude nameId: idR subtypeName: armOk fullTypeId: tResult
    print "subtype r (excl ok) -> \{smokeSubtype :pool id: (st.getSubtypeName nameId: idR)}"
    print "isExcluded r.ok -> \{boolText (st.isExcluded nameId: idR subtypeName: armOk)}"
    print "isExcluded r.err -> \{boolText (st.isExcluded nameId: idR subtypeName: armErr)}"
    st.exclude nameId: idR subtypeName: armNone fullTypeId: tResult
    print "subtype r (excl ok,none) -> \{smokeSubtype :pool id: (st.getSubtypeName nameId: idR)}"
    print "unreachable -> \{boolText st.isUnreachable}"
    st.exclude nameId: idR subtypeName: armErr fullTypeId: tResult
    print "unreachable after excl all -> \{boolText st.isUnreachable}"

    print "=== all names ==="
    names: st.allNames
    dumpNames :pool :names

    print "=== frames + pop ==="
    s1: st.push name: "inner" parent: (ztypes.declid.create from: s0)
    print "push inner -> frame=\{s1} open=\{st.open.length}"
    st.pop
    print "after pop open=\{st.open.length}"
    st.pop
    print "after pop open=\{st.open.length}"
    dumpFrames :st
}

# smoke-test: a subtype name id rendered as text ("" for the zero id).
smokeSubtype: function {pool: zast.StringPool.view id: zast.nameid} out String is {
    if id.isZero then return "".string
    return (zast.poolTextCopy :pool ref: id)
}

# smoke-test: an optional lock state rendered as text.
smokeLockState: function {o: optionval ztypes.zlockstate} out String is {
    match (
        o
    ) case some then {
        return (ztypes.zlockstateName o)
    } case none then {
        return "none".string
    }
}

# smoke-test: print the lookup result for `name`.
smokeLookup: function {st: zenv.ZSymbolTable.view pool: zast.StringPool.view name: StringView} is {
    r: st.lookup nameId: (zast.poolFind :pool text: name)
    print "lookup \{name} -> \{optTidText r}"
}

# smoke-test: print the variable id bound to `name`.
smokeVarId: function {st: zenv.ZSymbolTable.view pool: zast.StringPool.view name: StringView} is {
    r: st.lookupVarId nameId: (zast.poolFind :pool text: name)
    print "varId \{name} -> \{vidOrNoneText r}"
}

# smoke-test: format an error string.
smokeErr: function {s: StringView} out String is {
    if s.length == 0 then return "ok".string
    return s.string
}

# smoke-test: print a list of names.
dumpNames: function {pool: zast.StringPool.view names: (ListVal u32).view} is {
    iter: names.iterate
    for nm: iter loop {
        nt: zast.poolTextAt :pool ref: (zast.nameid.create from: nm.u32)
        print "  name \{nt}"
    }
}

# smoke-test: print the frames the walk left behind and the dump rows.
dumpFrames: function {st: zenv.ZSymbolTable.view} is {
    n: st.typing.decls.length
    k: u64
    for k < n loop {
        d: ztypes.declid.create from: k
        k = k + 1
        if (st.typing.declIsFrame declId: d) then {
            lbl: copiedLabel :st frame: d
            print "  frame=\{d} parent=\{st.typing.declParentOf declId: d} label=\{lbl} locals=\{st.typing.declChildSlots declId: d}"
        }
    }
    with dit: st.entryDump.iterate do for row: dit loop {
        print "  row scope=\{row.scopeId} pos=\{row.position} name=\{row.name} def=\{boolText row.isDefinition} taken=\{boolText row.isTaken}"
    }
}

# smoke-test: a frame's dump label, "" when unlabelled.
copiedLabel: function {st: zenv.ZSymbolTable.view frame: ztypes.declid} out String is {
    o: st.frameLabel.get key: frame.u64
    match (
        o
    ) case some then {
        return o.copy
    } case none then {
        return "".string
    }
}
