# zcheck -- the shared check-only compile service and project-layout
# resolution. zc's build/emit pipeline resolves its directories through
# the helpers here; zls (the language server) additionally calls `check`
# per document change: it builds the project VFS -- with in-memory
# overlays shadowing the source dir, so live editor buffers win over
# disk -- parses the main unit, and typechecks every definition. The
# caller reads diagnostics and stamps from the result; nothing here
# prints or exits.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :CheckResult
    :check
    :diagrow
    :diagsOf
    :dirname
    :exeRoot
    :fsnoFor
    :joinPath
    :pickCc
    :pickCcMode
    :foldNativePaths
    :resolveRuntimeDir
    :resolveSystemDir
    :resolveTccDir
    :vendoredTcc
}

Node: zast.Node

# fsnoFor -- nodeid -> fsno through the snapshot: the program's carrier
# on a successful parse, the parser's partial carrier on a parse error.
fsnoFor: function {r: CheckResult.view nodeid: u32} out zvfs.fsno is {
    pg: r.prog
    match (
        pg
    ) case program then {
        return (pg.ast.fsnoForNode :nodeid)
    } else null
    return (r.parser.ast.fsnoForNode :nodeid)
}

# One check pass over one main unit. On a parse failure `prog` is the
# parser's error node and `st` is none; otherwise `prog` is the program
# root and `st` carries the symbol table whose `typing.errors` holds
# `errorCount` batch-collected diagnostics. `vfs` and `parser` stay
# alive so callers can map fsno -> path (provider `path:`) and
# nodeid -> fsno (`parser.meta` fileSegs).
CheckResult: class {
    parseOk: bool
    errorCount: u64
    prog: Node
    st: (Option zenv.ZSymbolTable)
    vfs: zvfs.ZVfs
    parser: zparser.Parser
}

# check -- parse + typecheck(full) `mainUnit` against `srcdir` layered
# over `systemdir`. `overlays` maps root-relative file names (e.g.
# "zparser.z") to live buffer text; when non-empty they are served by a
# StringProvider bound in front of the source dir, shadowing disk.
check: function {
    srcdir: StringView
    systemdir: StringView
    mainUnit: StringView
    overlays: (Map String V: String)
} out CheckResult is {
    vfs: (zvfs.ZVfs
        providers: (List zvfs.ProviderBox)
        providerRoot: (IdMapR u32 V: String)
        entrytable: (zvfs.DentryTable entries: (ListVal zvfs.dentry))
        file_names: (List String)
        walk_cache: (MapRV String v: zvfs.fsno)
        rootid: zvfs.fsno
    )
    vfs.registerNull
    systemid: vfs.registerFS rootpath: systemdir.string parentpath: "".string
    srcid: vfs.registerFS rootpath: srcdir.string parentpath: "".string
    vfs.bindRoot newid: systemid kind: zvfs.bindkind.instead
    rootid: vfs.bindRoot newid: srcid kind: zvfs.bindkind.before
    if overlays.length > 0 then {
        ovid: vfs.registerString
        {
            # scope the provider borrow: bindRoot below needs the vfs
            # exclusively
            pidx: vfs.providers.length - 1
            box: vfs.providers.getMut i: pidx
            with oit: overlays.iterateItems do for e: oit loop {
                fp: e.key.copy
                ct: e.value.copy
                box.p.addFile fpath: fp.take content: ct.take
            }
        }
        rootid = vfs.bindRoot newid: ovid kind: zvfs.bindkind.before
    }
    p: zparser.Parser.create
    prog: p.parse :vfs :rootid mainUnitName: mainUnit.string
    isErr: false
    match (
        prog
    ) case error then {
        isErr = true
    } else null
    if isErr then {
        return (CheckResult
            parseOk: false
            errorCount: 0
            :prog
            st: (Option.none zenv.ZSymbolTable)
            :vfs
            parser: p
        )
    }
    reg: ztypes.newRegistry
    # no --cc reaches the tooling front ends, so they resolve the DEFAULT the
    # same way a flagless build would: same answer, same folded guards.
    ccPath: pickCc ccFlag: "" targetTriple: ""
    ccMode: pickCcMode modeFlag: ""
    # and the fold paths by the same default resolution. An unreadable table
    # leaves the set empty, which is not silence: the checker answers a path
    # only when a row names it, so every compile-time value it knows becomes
    # an error naming itself, reported here as any other diagnostic is.
    foldPaths: (List String)
    rtd9: resolveRuntimeDir flagVal: ""
    (foldNativePaths runtimeDir: rtd9.stringview into: foldPaths)
    st: (ztypecheck.typecheck
        program: prog
        :reg
        eager: true
        requireMain: false
        dumpRows: false
        ccPath: ccPath.stringview
        ccMode: ccMode.stringview
        target: ""
        :foldPaths
    )
    nerr: st.typing.errors.length
    return (CheckResult
        parseOk: true
        errorCount: nerr
        :prog
        st: (Option.some st)
        :vfs
        parser: p
    )
}

# ---- diagnostics flattening ----------------------------------------

# diagrow -- one diagnostic's scalar fields. The rendered message text
# (msg with note/hint folded in) rides in a parallel list, records
# cannot hold reftypes.
diagrow: record {
    lineno: u32
    colno: u32
    width: u32
    code: u32
    fsno: zvfs.fsno
}

# diagsOf -- flatten a check's diagnostics into parallel lists: the
# fail-fast parse error (when parseOk is false) plus every batch-
# collected typecheck error. fsno 0 heals through the parser's
# node->file segments, matching zc's errorMessage.
diagsOf: function {r: CheckResult.view rows: (ListVal diagrow) msgs: (List String)} is {
    if r.parseOk == false then {
        appendParseError n: r.prog :rows :msgs
    }
    diagsOfSt :rows :msgs :r
}

# collect the embedded parse-error nodes under `n` into the diagnostic rows.
appendParseError: function {n: Node.view rows: (ListVal diagrow) msgs: (List String)} is {
    match (
        n
    ) case error then {
        m: n.msg.copy
        if n.note.length > 0 then {
            m.appendByte b: 10
            m.append "note: "
            m.append n.note
        }
        if n.hint.length > 0 then {
            m.appendByte b: 10
            m.append "hint: "
            m.append n.hint
        }
        rows.append (diagrow
            lineno: n.lineno
            colno: n.colno
            width: n.width
            code: (zast.errCode c: n.err)
            fsno: n.fsno
        )
        msgs.append m
    } else null
}

# gather all diagnostics recorded in a symbol table into row form.
diagsOfSt: function {
    rows: (ListVal diagrow)
    msgs: (List String)
    r: CheckResult.view
} is {
    o: r.st
    match (
        o
    ) case some then {
        with eit: o.typing.errors.iterate do for er: eit loop {
            fno: er.fsno
            if fno.u64 == 0 when er.nodeid > 0 then {
                sf: fsnoFor :r nodeid: er.nodeid
                if sf.u64 > 0 then fno = sf
            }
            m: er.msg.copy
            if er.note.length > 0 then {
                m.appendByte b: 10
                m.append "note: "
                m.append er.note
            }
            if er.hint.length > 0 then {
                m.appendByte b: 10
                m.append "hint: "
                m.append er.hint
            }
            rows.append (diagrow
                lineno: er.lineno
                colno: er.colno
                width: er.width
                code: (zast.errCode c: er.err)
                fsno: fno
            )
            msgs.append m
        }
    } case none then null
}

# ---- project-layout resolution (shared by zc and zls) --------------

# dirname -- the path up to (excluding) the final "/", "." when none.
dirname: function {p: StringView} out String is {
    idxOpt: p.lastIndexOf needle: "/"
    match (
        idxOpt
    ) case some then {
        r: String
        i: u64
        for i < idxOpt loop {
            b: p.byteAt :i
            match (
                b
            ) case some then {
                r.appendByte :b
            } case none then null
            i = i + 1
        }
        return r
    } case none then {
        return ".".string
    }
}

# joinPath -- a/b, or just b when a is empty.
joinPath: function {a: StringView b: StringView} out String is {
    r: String
    if a.length > 0 then {
        r.append a
        r.append "/"
    }
    r.append b
    return r
}

# exeRoot -- the install root inferred from the executable: the parent of
# the directory holding the binary.
exeRoot: function out String is {
    er: os.exePath
    match (
        er
    ) case ok then {
        d1: dirname p: er.stringview
        d2: dirname p: d1.stringview
        return d2
    } case err then {
        return "".string
    }
}

# pickRuntimeUnder -- <root>/lib/runtime if it exists (installed tree),
# else <root>/src/runtime (dev tree).
pickRuntimeUnder: function {root: StringView} out String is {
    libR: joinPath a: root b: "lib/runtime"
    if (io.exists path: libR) then return libR
    return (joinPath a: root b: "src/runtime")
}

# pickTccUnder -- <root>/bin/tcc if it exists, else "".
pickTccUnder: function {root: StringView} out String is {
    cand: joinPath a: root b: "bin/tcc"
    if (io.exists path: cand) then return cand
    return "".string
}

# vendoredTcc -- the tcc this tree ships, if it ships one: <root>/bin/tcc in an
# installed tree, out/tcc in the dev tree, "" when neither is there.
vendoredTcc: function out String is {
    root: exeRoot
    if root.length > 0 then {
        c: pickTccUnder root: root.stringview
        if c.length > 0 then return c
    }
    if (io.exists path: "out/tcc") then return "out/tcc".string
    return "".string
}

# pickCc -- the C compiler this build will use: --cc > <target>-gcc > $CC > cc.
# Shared, not zc-local, because every front end has to agree about it: the
# `platform` unit's `cc` constant is folded during TYPE CHECKING, so zls and
# zl must resolve it the same way zc does or a require: guard would decide
# differently in the editor than in the build.
pickCc: function {ccFlag: StringView targetTriple: StringView} out String is {
    if ccFlag.length > 0 then {
        # a bare `tcc` means the one this tree vendors, when it has one:
        # `install` symlinks zc/zl/zls onto PATH and nothing else, so a plain
        # PATH lookup would never find <root>/bin/tcc. Resolving it here does
        # not move any folded constant -- ccKindArm reads the BASENAME, and
        # `tcc` and `<root>/bin/tcc` classify the same.
        if ccFlag == "tcc" then {
            v: vendoredTcc
            if v.length > 0 then return v
        }
        return ccFlag.string
    }
    if targetTriple.length > 0 then {
        r: String
        r.append targetTriple
        r.append "-gcc"
        return r
    }
    ce: os.env key: "CC"
    match (
        ce
    ) case some then {
        if ce.length > 0 then return ce.copy
    } case none then null
    return "cc".string
}

# resolveSystemDir -- the stdlib dir by precedence: explicit flag >
# $ZEROLANG_SYSTEM > $ZEROLANG_ROOT-relative > exePath-relative > cwd.
# pickCcMode -- how zc reaches the C compiler: `spawn` unless `--cc-mode`
# says otherwise. Shared for exactly the reason pickCc is: `platform.ccmode`
# is folded during TYPE CHECKING, so zl and zls must answer this the way zc
# does or a require: guard would decide differently in the editor than in the
# build. An unrecognised value is `spawn` here -- zc rejects it at the flag,
# which is where a typo can still be reported against the argument that
# carried it.
pickCcMode: function {modeFlag: StringView} out String is {
    if modeFlag == "inproc" then return "inproc".string
    return "spawn".string
}

resolveSystemDir: function {flagVal: StringView} out String is {
    if flagVal.length > 0 then return flagVal.string
    ev: os.env key: "ZEROLANG_SYSTEM"
    match (
        ev
    ) case some then {
        return ev.copy
    } case none then null
    rv: os.env key: "ZEROLANG_ROOT"
    match (
        rv
    ) case some then {
        return (joinPath a: rv.stringview b: "lib/system")
    } case none then null
    root: exeRoot
    if root.length > 0 then {
        cand: joinPath a: root.stringview b: "lib/system"
        if (io.exists path: cand) then return cand
    }
    return "lib/system".string
}

# resolveRuntimeDir -- the runtime dir by the same precedence; the install
# and dev trees differ (lib/runtime vs src/runtime), handled by pickRuntimeUnder.
resolveRuntimeDir: function {flagVal: StringView} out String is {
    if flagVal.length > 0 then return flagVal.string
    ev: os.env key: "ZEROLANG_RUNTIME"
    match (
        ev
    ) case some then {
        return ev.copy
    } case none then null
    rv: os.env key: "ZEROLANG_ROOT"
    match (
        rv
    ) case some then {
        return (pickRuntimeUnder root: rv.stringview)
    } case none then null
    root: exeRoot
    if root.length > 0 then {
        rd: pickRuntimeUnder root: root.stringview
        if (io.exists path: rd) then return rd
    }
    return "src/runtime".string
}

# foldNativePaths -- the qualified paths natives.tbl marks `fold`: the values
# the compiler answers itself, at compile time. The type checker needs that
# SET -- it folds those paths and refuses to fold any other -- and the checker
# reads no files at all, by design: what it decides must not depend on what is
# on a machine beyond the program it was handed. So the read happens here,
# beside the rest of the project-layout resolution, and the paths are handed in.
#
# A minimal scan of the row HEADS. The emitter's loadNativeTbl parses the rest
# of every row and the two are separate readers, which they can afford to be:
# the checker errors on a `fold` row it cannot answer AND on an answer with no
# row, so a disagreement between the two is reported rather than silently
# splitting the difference.
#
# false when the table could not be READ. That is a broken install, not a table
# with no fold rows, and the two must not read the same to a caller.
foldNativePaths: function {runtimeDir: StringView into: (List String)} out bool is {
    tp: "\{runtimeDir}/natives.tbl"
    rd: io.readText path: tp
    txt: String
    match (
        rd
    ) case ok then {
        txt = rd.take
    } case err then {
        return false
    }
    with lit: txt.stringview.lines do for ln: lit loop {
        t: ln.trim
        # the whole table is read to find five rows, so ask the cheap question
        # first: a `fold` row spells the word, and 912 of the 917 do not. Without
        # this every row head is split and its path materialised, which cost
        # ~3,900 allocations on EVERY compile to answer no 912 times. A row that
        # merely contains the letters -- a fragment named for one -- still gets
        # the full parse below, which is what actually decides.
        if (t.startsWith prefix: "[") when (t.contains needle: "fold") then {
            cb: t.indexOf needle: "]"
            match (
                cb
            ) case some then {
                head: t.substring from: 1 to: cb
                key: String
                isFold: false
                with fit: (head.split sep: " ") do for f: fit loop {
                    if f.length > 0 then {
                        if key.length == 0 then {
                            key = f.string
                        } else {
                            fdo: f.stripPrefix p: "fold"
                            match (
                                fdo
                            ) case some then {
                                if fdo.length == 0 then isFold = true
                            } case none then null
                        }
                    }
                }
                if isFold when key.length > 0 then into.append from: key.copy
            } case none then null
        }
    }
    return true
}

# resolveTccDir -- tcc's runtime payload (libtcc1.a, include/, libtcc.so) by
# the same precedence. tcc cannot find this on its own: the directory is baked
# in at CONFIGURE time, so a relocated tree needs `-B <dir>` on the driver or
# `tcc_set_lib_path` on libtcc, and without it tcc cannot even resolve
# `stddef.h`. One directory holds all three so one answer serves both modes.
resolveTccDir: function {flagVal: StringView} out String is {
    if flagVal.length > 0 then return flagVal.string
    ev: os.env key: "ZEROLANG_TCC"
    match (
        ev
    ) case some then {
        return ev.copy
    } case none then null
    rv: os.env key: "ZEROLANG_ROOT"
    match (
        rv
    ) case some then {
        return (joinPath a: rv.stringview b: "lib/tcc")
    } case none then null
    root: exeRoot
    if root.length > 0 then {
        cand: joinPath a: root.stringview b: "lib/tcc"
        if (io.exists path: cand) then return cand
    }
    return "out/tcc-lib".string
}
