# zcheck -- the shared check-only compile service and project-layout
# resolution. zc's build/emit pipeline resolves its directories through
# the helpers here; zls (the language server) additionally calls `check`
# per document change: it builds the project VFS -- with in-memory
# overlays shadowing the source dir, so live editor buffers win over
# disk -- parses the main unit, and typechecks every definition. The
# caller reads diagnostics and stamps from the result; nothing here
# prints or exits.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :CheckResult
    :check
    :diagrow
    :diagsOf
    :exeRoot
    :libtccFile
    :fsnoFor
    :missingRootCause
    :pathKindIs
    :pickCc
    :pickCcMode
    :resolveRuntimeDir
    :resolveSystemDir
    :resolveTccDir
    :resolveVendorDir
    :cacheRoot
    :stableHash
    :vendoredTcc
    :newVfs
    :buildRoots
    :GenLayer
    :noLayer
    :addUnit
    :addSubunit
}

astnode: zast.astnode
Ast: zast.Ast

# pathKindIs -- whether `path` names an entry of the kind `want`, following
# links; false when it cannot be read.
pathKindIs: function {path: StringView want: io.filekind} out bool is {
    sr: io.stat :path
    match (
        sr
    ) case ok then {
        return sr.kind == want
    } case err then null
    return false
}

# missingRootCause -- why a project's roots cannot be read: the system directory
# or the first src root that is not a directory, named; "" when every one is.
# The VFS panics on a root that does not exist, and would mount a FILE as a root
# of one entry, so a front end asks this before it registers any.
missingRootCause: function {systemdir: StringView srcdirs: (List String).view} out String is {
    if (pathKindIs path: systemdir want: io.filekind.dir).not then {
        return "the system directory '\{systemdir}' does not exist"
    }
    for each d: srcdirs loop {
        if (pathKindIs path: d.stringView want: io.filekind.dir).not then {
            return "the src root '\{d}' does not exist"
        }
    }
    return ""
}

# fsnoFor -- nodeid -> fsno through the snapshot: the program's carrier
# on a successful parse, the parser's partial carrier on a parse error.
fsnoFor: function {r: CheckResult.view nodeid: zast.nodeid} out zvfs.fsno is {
    if r.parseOk then return (r.prog.fsnoForNode :nodeid)
    return (r.parser.ast.fsnoForNode :nodeid)
}

# One check pass over one main unit. On a parse failure `prog` is the
# parser's error node and `st` is none; otherwise `prog` is the program
# root and `st` carries the symbol table whose `typing.errors` holds
# `errorCount` batch-collected diagnostics. `vfs` and `parser` stay
# alive so callers can map fsno -> path (provider `path:`) and
# nodeid -> fsno (the tree's rowFile).
CheckResult: class {
    # whether the parse produced a usable tree. A false here means the rest is
    # not worth reading
    parseOk: bool
    # how many diagnostics were raised
    errorCount: u64
    # the tree, owned by the result
    prog: Ast
    # the symbol table, none when checking did not get that far
    st: Option zenv.ZSymbolTable
    # the filesystem the sources were read through, kept so a later lookup
    # resolves the same way
    vfs: zvfs.ZVfs
    # the parser, kept so zls can load a unit the program does not use into
    # the tree later (Parser.loadUnits / loadSubunit)
    parser: zparser.Parser
}

# newVfs -- an empty file system for a parse to bind its roots into.
newVfs: function {} out zvfs.ZVfs is {
    return (zvfs.ZVfs
        providers: List zvfs.ProviderBox
        providerRoot: (IdMapR u32 V: String)
        entrytable: (zvfs.DentryTable entries: (ListVal zvfs.dentry i: zvfs.fsno))
        file_names: (List String i: zvfs.fsno)
        walk_cache: (MapRV String v: zvfs.fsno)
        rootid: zvfs.fsno
        shadow: (zvfs.shadowpair active: false top: zvfs.fsno base: zvfs.fsno)
        bound: (IdMapR zvfs.fsno V: List String)
    )
}

# VfsRoots -- what binding a project's roots answers: where a parse starts, and
# each src root's own entry, which an overlay of its open buffers shadows.
VfsRoots: class {
    # the union every unit is looked up from
    root: zvfs.fsno
    # every --src root's directory entry, in srcdirs order
    srcIds: ListVal zvfs.fsno
}

# GenLayer -- the generated `z` unit as a build mounts it (zproject.zLayer
# makes it). Its files are served from memory, so a build reads the values it
# generated even while another build rewrites the copy on disk; the copy on
# disk names them, so a diagnostic or an editor opens the real file.
GenLayer: class {
    # where the files live on disk, the directory holding z.z; "" when they
    # have no copy on disk. An empty `paths` is no layer at all
    dir: String
    # each file's path under `dir`: z.z, z/build.z
    paths: List String
    # each file's text, parallel to `paths`
    texts: List String
    # the project's own project.z, mounted alone as z/project.z; "" for none
    projectFile: String
}

# noLayer -- no generated layer: a build that mounts no `z` unit
noLayer: function out GenLayer is {
    return (GenLayer dir: String paths: List String texts: List String projectFile: String)
}

# bindOverlay -- mount the open buffers of one src root ahead of what is bound:
# their files from memory, named by that root's directory, and one tree with the
# root to a subunit lookup. Answers the new root.
bindOverlay: function {
    vfs: zvfs.ZVfs
    files: (Map String V: String)
    dir: StringView
    base: zvfs.fsno
} out zvfs.fsno is {
    ovid: vfs.registerString
    pidx: vfs.providers.length - 1
    {
        # scope the provider borrow: bindRoot below needs the vfs exclusively
        box: vfs.providers.getMut i: pidx
        for each e: files.iterateItems loop {
            fp: e.key.copy
            ct: e.value.copy
            box.p.addFile fpath: fp.take content: ct.take
        }
    }
    vfs.providerRoot.set key: pidx.u32.orPanic value: dir.string
    root: vfs.bindRoot newid: ovid kind: zvfs.bindkind.before
    vfs.shadowOver top: ovid :base
    return root
}

# buildRoots -- the one root stack every driver parses through: the stdlib
# bound first, then the generated `z` unit, then each src root. Each `before`
# puts its root ahead of everything already bound, so binding back to front
# leaves the FIRST src root searched first. A unit name that two roots both
# answer resolves to the earlier root's copy, so a project's own z.z shadows
# the generated one as a user unit shadows the stdlib.
buildRoots: function {
    vfs: zvfs.ZVfs
    systemdir: StringView
    srcdirs: (List String).view
    layer: GenLayer.view
} out VfsRoots is {
    vfs.registerNull
    systemid: vfs.registerFS rootpath: systemdir.string parentpath: ""
    r: (VfsRoots
        root: (vfs.bindRoot newid: systemid kind: zvfs.bindkind.instead)
        srcIds: ListVal zvfs.fsno
    )
    if layer.paths.length > 0 then r.root = bindLayer :vfs :layer
    bound: ListVal zvfs.fsno
    si: srcdirs.length
    for si > 0 loop {
        si = si - 1
        sd: srcdirs.get i: si
        sid: vfs.registerFS rootpath: sd.copy parentpath: ""
        r.root = vfs.bindRoot newid: sid kind: zvfs.bindkind.before
        bound.append sid
    }
    # bound last root first: put them back in srcdirs order
    bi: bound.length
    for bi > 0 loop {
        bi = bi - 1
        r.srcIds.append (bound.get i: bi)
    }
    return r
}

# bindLayer -- mount the generated layer ahead of what is bound: its files from
# memory, named by their real directory, and the project's project.z, a real
# file, alone at z/project.z. Answers the new root.
bindLayer: function {vfs: zvfs.ZVfs layer: GenLayer.view} out zvfs.fsno is {
    gid: vfs.registerString
    pidx: vfs.providers.length - 1
    {
        # scope the provider borrow: the binds below need the vfs exclusively
        box: vfs.providers.getMut i: pidx
        i: u64
        for i < layer.paths.length loop {
            fp: (layer.paths.get :i).copy
            ct: (layer.texts.get :i).copy
            box.p.addFile fpath: fp.take content: ct.take
            i = i + 1
        }
    }
    if layer.dir.length > 0 then vfs.providerRoot.set key: pidx.u32.orPanic value: layer.dir.copy
    root: vfs.bindRoot newid: gid kind: zvfs.bindkind.before
    if layer.projectFile.length > 0 then {
        pz: vfs.registerFS rootpath: layer.projectFile.copy parentpath: ""
        zdir: vfs.walk parent: gid name: "z"
        vfs.bind parentid: zdir name: "project.z" newid: pz kind: zvfs.bindkind.instead
    }
    return root
}

# addUnit -- add the top-level unit `name`, which the check did not load, to
# the checked tree, with the units it names that the tree does not hold yet:
# parsed (Parser.loadUnits, the tree lent back to the parser for it) and
# indexed (ztypecheck.indexAddedUnits), nothing re-checked. False, the tree
# unchanged, when there is no such unit or it does not load.
addUnit: function {r: CheckResult name: StringView} out bool is {
    fileFrom: r.prog.files.length
    units: ListVal zast.nodeid
    r.parser.ast swap r.prog
    ok: r.parser.loadUnits vfs: r.vfs rootid: r.vfs.rootid :name outUnits: units
    r.parser.ast swap r.prog
    if ok then indexAdded :r :units owner: ztypes.declid members: ListVal zast.nodeid :fileFrom
    return ok
}

# addSubunit -- add `name`, a subunit file in the folder `dirid` that the check
# did not load, to the checked tree as a member of the unit `ownerOp` (declared
# by `ownerDecl`), as addUnit adds a top-level unit (Parser.loadSubunit).
addSubunit: function {
    r: CheckResult
    dirid: zvfs.fsno
    ownerOp: zast.nodeid
    ownerDecl: ztypes.declid
    name: StringView
} out bool is {
    fileFrom: r.prog.files.length
    units: ListVal zast.nodeid
    members: ListVal zast.nodeid
    r.parser.ast swap r.prog
    ok: (r.parser.loadSubunit
        vfs: r.vfs
        rootid: r.vfs.rootid
        :dirid
        :ownerOp
        unitname: name
        outMembers: members
        outUnits: units
    )
    r.parser.ast swap r.prog
    if ok then indexAdded :r :units owner: ownerDecl :members :fileFrom
    return ok
}

# indexAdded -- index what a load added to the checked tree
indexAdded: function {
    r: CheckResult
    units: (ListVal zast.nodeid).view
    owner: ztypes.declid
    members: (ListVal zast.nodeid).view
    fileFrom: u64
} is {
    o: r.st
    match (
        o
    ) case some then {
        (ztypecheck.indexAddedUnits
            st: o
            program: r.prog
            vfs: r.vfs
            :units
            ownerDecl: owner
            :members
            :fileFrom
        )
    } case none then null
}

# check -- parse + typecheck(full) `mainUnit` against `srcdirs` layered
# over `systemdir`. `overlays` holds, per src root, live buffer text by the
# name relative to that root (e.g. "zparser.z"); each root's buffers are served
# by a StringProvider bound in front of everything, shadowing disk.
check: function {
    # the src roots, the first searched first
    srcdirs: (List String).view
    systemdir: StringView
    mainUnit: StringView
    # the open buffers, one map per src root (in step with srcdirs), each by its
    # path relative to that root
    overlays: List (Map String V: String)
    layer: GenLayer.view
} out CheckResult is {
    vfs: newVfs
    roots: buildRoots :vfs :systemdir :srcdirs :layer
    rootid: roots.root
    # the last root's buffers first, so the first root's end up in front
    oi: overlays.length
    for oi > 0 loop {
        oi = oi - 1
        if oi < roots.srcIds.length then {
            ov: overlays.getMut i: oi
            if ov.length > 0 then {
                rootid = (bindOverlay
                    :vfs
                    files: ov
                    dir: (srcdirs.get i: oi).stringView
                    base: (roots.srcIds.get i: oi)
                )
            }
        }
    }
    p: zparser.Parser.create
    prog: p.parse :vfs :rootid mainUnitName: mainUnit.string
    # a failed parse names its error as the tree's root row
    isErr: zast.isErrorAt ast: prog id: prog.root
    if isErr then {
        return (CheckResult
            parseOk: false
            errorCount: 0
            :prog
            st: Option.none zenv.ZSymbolTable
            :vfs
            parser: p
        )
    }
    reg: ztypes.newRegistry
    st: (ztypecheck.typecheck
        program: prog
        :reg
        eager: true
        requireMain: false
        dumpRows: false
        filePaths: (ztypecheck.filePathsOf :vfs ast: prog)
    )
    nerr: st.typing.errors.length
    return (CheckResult
        parseOk: true
        errorCount: nerr
        :prog
        st: Option.some st
        :vfs
        parser: p
    )
}

# ---- diagnostics flattening ----------------------------------------

# diagrow -- one diagnostic's scalar fields. The rendered message text
# (msg with note/hint folded in) rides in a parallel list, records
# cannot hold reftypes.
diagrow: record {
    # the line
    lineno: u32
    # the column
    colno: u32
    # how many columns to underline
    width: u32
    # the code, interned
    code: u32
    # the file
    fsno: zvfs.fsno
}

# diagsOf -- flatten a check's diagnostics into parallel lists: the
# fail-fast parse error (when parseOk is false) plus every batch-
# collected typecheck error. fsno 0 heals through the parser's
# node->file segments, matching zc's errorMessage.
diagsOf: function {r: CheckResult.view rows: ListVal diagrow msgs: List String} is {
    if r.parseOk.not then {
        appendParseError ast: r.prog n: (r.prog.nodes.get i: r.prog.root) :rows :msgs
    }
    diagsOfSt :rows :msgs :r
}

# collect the embedded parse-error nodes under `n` into the diagnostic rows.
appendParseError: function {
    ast: Ast.view
    n: astnode.view
    rows: ListVal diagrow
    msgs: List String
} is {
    match (
        n
    ) case error then {
        # the row names its text; the reporter wants it owned and folded
        d9: zast.errorDataOf :ast row: n
        m: d9.msg.copy
        if d9.note.length > 0 then {
            m.appendByte b: 10
            m.append "note: "
            m.append d9.note
        }
        if d9.hint.length > 0 then {
            m.appendByte b: 10
            m.append "hint: "
            m.append d9.hint
        }
        rows.append (diagrow
            lineno: n.lineno
            colno: n.colno
            width: n.width
            code: (zast.errCode c: n.err)
            fsno: n.fsno
        )
        msgs.append m
    } else null
}

# gather all diagnostics recorded in a symbol table into row form.
diagsOfSt: function {
    rows: ListVal diagrow
    msgs: List String
    r: CheckResult.view
} is {
    o: r.st
    match (
        o
    ) case some then {
        for each er: o.typing.errors loop {
            fno: er.fsno
            if fno.isZero when er.nodeid.isZero.not then {
                sf: fsnoFor :r nodeid: er.nodeid
                if sf.isZero.not then fno = sf
            }
            m: er.msg.copy
            if er.note.length > 0 then {
                m.appendByte b: 10
                m.append "note: "
                m.append er.note
            }
            if er.hint.length > 0 then {
                m.appendByte b: 10
                m.append "hint: "
                m.append er.hint
            }
            rows.append (diagrow
                lineno: er.lineno
                colno: er.colno
                width: er.width
                code: (zast.errCode c: er.err)
                fsno: fno
            )
            msgs.append m
        }
    } case none then null
}

# ---- project-layout resolution (shared by zc and zls) --------------

# exeRoot -- the install root inferred from the executable: the parent of
# the directory holding the binary.
exeRoot: function out String is {
    er: os.exePath
    match (
        er
    ) case ok then {
        d1: path.dirname p: er.stringView
        return (path.dirname p: d1.stringView)
    } case err then {
        return ""
    }
}

# stableHash -- the 64-bit FNV-1a hash of `s`'s bytes. String.hash is seeded
# per process to keep a Map's buckets unguessable, so it names a different
# folder on every run; a cache key must be the same on each.
stableHash: function {s: StringView} out u64 is {
    # the FNV offset basis and prime
    h: 0xcbf29ce484222325
    i: u64
    for i < s.length loop {
        b: (s.byteAt :i).or d: 0
        h = (h ^ b) * 0x100000001b3
        i = i + 1
    }
    return h
}

# cacheRoot -- the user's cache directory: on Windows %LOCALAPPDATA%, as Go's
# os.UserCacheDir has it; elsewhere $XDG_CACHE_HOME, else ~/.cache. "" when
# there is none
cacheRoot: function out String is {
    if z.build.os == z.build.oskind.windows then {
        la: os.env key: "LOCALAPPDATA"
        match la case some then return la.copy case none then return ""
    }
    xc: os.env key: "XDG_CACHE_HOME"
    match (
        xc
    ) case some then {
        if xc.length > 0 then return xc.copy
    } case none then null
    hm: os.env key: "HOME"
    match (
        hm
    ) case some then {
        if hm.length > 0 then return (path.join a: hm.stringView b: ".cache")
    } case none then null
    return ""
}

# resolveVendorDir -- the vendored C sources a unit's `csrc=` row names a file
# under (sqlite/sqlite3.c): $ZEROLANG_VENDOR, else $ZEROLANG_ROOT/lib/vendor,
# else <exe root>/lib/vendor (an installed tree), else <exe root>/vendor (the
# development tree), else vendor
resolveVendorDir: function out String is {
    ev: os.env key: "ZEROLANG_VENDOR"
    match (
        ev
    ) case some then {
        if ev.length > 0 then return ev.copy
    } case none then null
    rv: os.env key: "ZEROLANG_ROOT"
    match (
        rv
    ) case some then {
        return (path.join a: rv.stringView b: "lib/vendor")
    } case none then null
    root: exeRoot
    if root.length > 0 then {
        libV: path.join a: root.stringView b: "lib/vendor"
        if (io.exists path: libV) then return libV
        devV: path.join a: root.stringView b: "vendor"
        if (io.exists path: devV) then return devV
    }
    return "vendor"
}

# pickRuntimeUnder -- <root>/lib/runtime if it exists (installed tree),
# else <root>/src/runtime (dev tree).
pickRuntimeUnder: function {root: StringView} out String is {
    libR: path.join a: root b: "lib/runtime"
    if (io.exists path: libR) then return libR
    return (path.join a: root b: "src/runtime")
}

# pickTccUnder -- <root>/bin/tcc (tcc.exe on Windows) if it exists, else "".
pickTccUnder: function {root: StringView} out String is {
    exe: ztarget.targetExeSuffix triple: ""
    rel: "bin/tcc\{exe}"
    cand: path.join a: root b: rel.stringView
    if (io.exists path: cand) then return cand
    return ""
}

# libtccFile -- the file libtcc is in a tcc payload directory: libtcc.dll on
# Windows, libtcc.so elsewhere
libtccFile: function out String is {
    if z.build.os == z.build.oskind.windows then return "libtcc.dll"
    return "libtcc.so"
}

# vendoredTcc -- the tcc this tree ships, if it ships one: <root>/bin/tcc in an
# installed tree, out/tcc in the dev tree, "" when neither is there.
vendoredTcc: function out String is {
    root: exeRoot
    if root.length > 0 then {
        c: pickTccUnder root: root.stringView
        if c.length > 0 then return c
    }
    exe: ztarget.targetExeSuffix triple: ""
    dev: "out/tcc\{exe}"
    if (io.exists path: dev) then return dev
    return ""
}

# ccWord -- the C toolchain words zc's flags name: the vendored compiler and the
# in-process mode, classified by slot (zast.Vocab)
ccWord: list {
    tcc: "tcc"
    inproc: "inproc"
} out staticlist StringView

# pickCc -- the C compiler this build will use: --cc > <target>-gcc > $CC > cc
# (gcc on Windows, which has no `cc`).
# A fact for the C backend and the build, which `zc env` reports too; no type
# checking reads it, so the editor and the linter never resolve it.
pickCc: function {ccFlag: StringView targetTriple: StringView} out String is {
    if ccFlag.length > 0 then {
        ccWords: zast.Vocab.create block: ccWord
        # a bare `tcc` means the one this tree vendors, when it has one:
        # `install` symlinks zc/zl/zls onto PATH and nothing else, so a plain
        # PATH lookup would never find <root>/bin/tcc. Resolving it here does
        # not change the family -- zcc.ccFamilyOf reads the BASENAME,
        # and `tcc` and `<root>/bin/tcc` classify the same.
        if (ccWords.slotOf text: ccFlag) == ccWord.slot.tcc then {
            v: vendoredTcc
            if v.length > 0 then return v
        }
        return ccFlag.string
    }
    if targetTriple.length > 0 then {
        r: String
        r.append targetTriple
        r.append "-gcc"
        return r
    }
    ce: os.env key: "CC"
    match (
        ce
    ) case some then {
        if ce.length > 0 then return ce.copy
    } case none then null
    if z.build.os == z.build.oskind.windows then return "gcc"
    return "cc"
}

# pickCcMode -- how zc reaches the C compiler: `spawn` unless `--cc-mode`
# says otherwise. An unrecognised value is `spawn` here -- zc rejects it at the
# flag, which is where a typo can still be reported against the argument that
# carried it.
pickCcMode: function {modeFlag: StringView} out String is {
    ccWords: zast.Vocab.create block: ccWord
    if (ccWords.slotOf text: modeFlag) == ccWord.slot.inproc then return "inproc"
    return "spawn"
}

# resolveSystemDir -- the stdlib dir by precedence: explicit flag >
# $ZEROLANG_SYSTEM > $ZEROLANG_ROOT-relative > exePath-relative > cwd.
resolveSystemDir: function {flagVal: StringView} out String is {
    if flagVal.length > 0 then return flagVal.string
    ev: os.env key: "ZEROLANG_SYSTEM"
    match (
        ev
    ) case some then {
        return ev.copy
    } case none then null
    rv: os.env key: "ZEROLANG_ROOT"
    match (
        rv
    ) case some then {
        return (path.join a: rv.stringView b: "lib/system")
    } case none then null
    root: exeRoot
    if root.length > 0 then {
        cand: path.join a: root.stringView b: "lib/system"
        if (io.exists path: cand) then return cand
    }
    return "lib/system"
}

# resolveRuntimeDir -- the runtime dir by the same precedence; the install
# and dev trees differ (lib/runtime vs src/runtime), handled by pickRuntimeUnder.
resolveRuntimeDir: function {flagVal: StringView} out String is {
    if flagVal.length > 0 then return flagVal.string
    ev: os.env key: "ZEROLANG_RUNTIME"
    match (
        ev
    ) case some then {
        return ev.copy
    } case none then null
    rv: os.env key: "ZEROLANG_ROOT"
    match (
        rv
    ) case some then {
        return (pickRuntimeUnder root: rv.stringView)
    } case none then null
    root: exeRoot
    if root.length > 0 then {
        rd: pickRuntimeUnder root: root.stringView
        if (io.exists path: rd) then return rd
    }
    return "src/runtime"
}

# resolveTccDir -- tcc's runtime payload (libtcc1.a, include/, libtcc.so) by
# the same precedence. tcc cannot find this on its own: the directory is baked
# in at CONFIGURE time, so a relocated tree needs `-B <dir>` on the driver or
# `tcc_set_lib_path` on libtcc, and without it tcc cannot even resolve
# `stddef.h`. One directory holds all three so one answer serves both modes.
resolveTccDir: function {flagVal: StringView} out String is {
    if flagVal.length > 0 then return flagVal.string
    ev: os.env key: "ZEROLANG_TCC"
    match (
        ev
    ) case some then {
        return ev.copy
    } case none then null
    rv: os.env key: "ZEROLANG_ROOT"
    match (
        rv
    ) case some then {
        return (path.join a: rv.stringView b: "lib/tcc")
    } case none then null
    root: exeRoot
    if root.length > 0 then {
        cand: path.join a: root.stringView b: "lib/tcc"
        if (io.exists path: cand) then return cand
    }
    return "out/tcc-lib"
}
