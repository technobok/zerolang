# zcheck -- the shared check-only compile service and project-layout
# resolution. zc's build/emit pipeline resolves its directories through
# the helpers here; zls (the language server) additionally calls `check`
# per document change: it builds the project VFS -- with in-memory
# overlays shadowing the source dir, so live editor buffers win over
# disk -- parses the main unit, and typechecks every definition. The
# caller reads diagnostics and stamps from the result; nothing here
# prints or exits.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :CheckResult
    :check
    :diagrow
    :diagsOf
    :dirname
    :exeRoot
    :fsnoFor
    :joinPath
    :missingRootCause
    :pathKindIs
    :pickCc
    :pickCcMode
    :resolveRuntimeDir
    :resolveSystemDir
    :resolveTccDir
    :vendoredTcc
    :newVfs
    :buildRoots
}

astnode: zast.astnode
Ast: zast.Ast

# pathKindIs -- whether `path` names an entry of the kind `want`, following
# links; false when it cannot be read.
pathKindIs: function {path: StringView want: io.filekind} out bool is {
    sr: io.stat :path
    match (
        sr
    ) case ok then {
        return sr.kind == want
    } case err then null
    return false
}

# missingRootCause -- why a project's roots cannot be read: the system directory
# or the first src root that is not a directory, named; "" when every one is.
# The VFS panics on a root that does not exist, and would mount a FILE as a root
# of one entry, so a front end asks this before it registers any.
missingRootCause: function {systemdir: StringView srcdirs: (List String).view} out String is {
    if (pathKindIs path: systemdir want: io.filekind.dir).not then {
        return "the system directory '\{systemdir}' does not exist"
    }
    for each d: srcdirs loop {
        if (pathKindIs path: d.stringView want: io.filekind.dir).not then {
            return "the src root '\{d}' does not exist"
        }
    }
    return ""
}

# fsnoFor -- nodeid -> fsno through the snapshot: the program's carrier
# on a successful parse, the parser's partial carrier on a parse error.
fsnoFor: function {r: CheckResult.view nodeid: zast.nodeid} out zvfs.fsno is {
    if r.parseOk then return (r.prog.fsnoForNode :nodeid)
    return (r.parser.ast.fsnoForNode :nodeid)
}

# One check pass over one main unit. On a parse failure `prog` is the
# parser's error node and `st` is none; otherwise `prog` is the program
# root and `st` carries the symbol table whose `typing.errors` holds
# `errorCount` batch-collected diagnostics. `vfs` and `parser` stay
# alive so callers can map fsno -> path (provider `path:`) and
# nodeid -> fsno (the tree's rowFile).
CheckResult: class {
    # whether the parse produced a usable tree. A false here means the rest is
    # not worth reading
    parseOk: bool
    # how many diagnostics were raised
    errorCount: u64
    # the tree, owned by the result
    prog: Ast
    # the symbol table, none when checking did not get that far
    st: Option zenv.ZSymbolTable
    # the filesystem the sources were read through, kept so a later lookup
    # resolves the same way
    vfs: zvfs.ZVfs
    # the parser, kept because the tree's name pool lives in it
    parser: zparser.Parser
}

# newVfs -- an empty file system for a parse to bind its roots into.
newVfs: function {} out zvfs.ZVfs is {
    return (zvfs.ZVfs
        providers: List zvfs.ProviderBox
        providerRoot: (IdMapR u32 V: String)
        entrytable: (zvfs.DentryTable entries: (ListVal zvfs.dentry i: zvfs.fsno))
        file_names: (List String i: zvfs.fsno)
        walk_cache: (MapRV String v: zvfs.fsno)
        rootid: zvfs.fsno
        shadow: (zvfs.shadowpair active: false top: zvfs.fsno base: zvfs.fsno)
    )
}

# vfsroots -- what binding a project's roots answers: where a parse starts, and
# the first src root's own entry, which an overlay of open buffers shadows.
vfsroots: record {
    # the union every unit is looked up from
    root: zvfs.fsno
    # the first --src root's directory entry; zero when there is no src root
    firstSrc: zvfs.fsno
}

# buildRoots -- the one root stack every driver parses through: the stdlib
# bound first, then each src root. Each `before` puts its root ahead of
# everything already bound, so binding back to front leaves the FIRST src root
# searched first. A unit name that two roots both answer resolves to the
# earlier root's copy.
buildRoots: function {
    vfs: zvfs.ZVfs
    systemdir: StringView
    srcdirs: (List String).view
} out vfsroots is {
    vfs.registerNull
    systemid: vfs.registerFS rootpath: systemdir.string parentpath: ""
    r: vfsroots root: (vfs.bindRoot newid: systemid kind: zvfs.bindkind.instead) firstSrc: zvfs.fsno
    si: srcdirs.length
    for si > 0 loop {
        si = si - 1
        sd: srcdirs.get i: si
        sid: vfs.registerFS rootpath: sd.copy parentpath: ""
        r.root = vfs.bindRoot newid: sid kind: zvfs.bindkind.before
        r.firstSrc = sid
    }
    return r
}

# check -- parse + typecheck(full) `mainUnit` against `srcdir` layered
# over `systemdir`. `overlays` maps root-relative file names (e.g.
# "zparser.z") to live buffer text; when non-empty they are served by a
# StringProvider bound in front of the source dir, shadowing disk.
check: function {
    srcdir: StringView
    systemdir: StringView
    mainUnit: StringView
    overlays: (Map String V: String)
} out CheckResult is {
    vfs: newVfs
    srcdirs: List String
    srcdirs.append from: srcdir.string
    roots: buildRoots :vfs :systemdir :srcdirs
    rootid: roots.root
    srcid: roots.firstSrc
    if overlays.length > 0 then {
        ovid: vfs.registerString
        {
            # scope the provider borrow: bindRoot below needs the vfs
            # exclusively
            pidx: vfs.providers.length - 1
            box: vfs.providers.getMut i: pidx
            for each e: overlays.iterateItems loop {
                fp: e.key.copy
                ct: e.value.copy
                box.p.addFile fpath: fp.take content: ct.take
            }
        }
        rootid = vfs.bindRoot newid: ovid kind: zvfs.bindkind.before
        # the open buffers and the src dir are one tree to a subunit lookup
        vfs.shadowOver top: ovid base: srcid
    }
    p: zparser.Parser.create
    prog: p.parse :vfs :rootid mainUnitName: mainUnit.string
    # a failed parse names its error as the tree's root row
    isErr: zast.isErrorAt ast: prog id: prog.root
    if isErr then {
        return (CheckResult
            parseOk: false
            errorCount: 0
            :prog
            st: Option.none zenv.ZSymbolTable
            :vfs
            parser: p
        )
    }
    reg: ztypes.newRegistry
    st: (ztypecheck.typecheck
        program: prog
        :reg
        eager: true
        requireMain: false
        dumpRows: false
        target: ""
        targetOs: (ztarget.targetOrHostOs triple: "").stringView
        targetArch: (ztarget.targetOrHostArch triple: "").stringView
    )
    nerr: st.typing.errors.length
    return (CheckResult
        parseOk: true
        errorCount: nerr
        :prog
        st: Option.some st
        :vfs
        parser: p
    )
}

# ---- diagnostics flattening ----------------------------------------

# diagrow -- one diagnostic's scalar fields. The rendered message text
# (msg with note/hint folded in) rides in a parallel list, records
# cannot hold reftypes.
diagrow: record {
    # the line
    lineno: u32
    # the column
    colno: u32
    # how many columns to underline
    width: u32
    # the code, interned
    code: u32
    # the file
    fsno: zvfs.fsno
}

# diagsOf -- flatten a check's diagnostics into parallel lists: the
# fail-fast parse error (when parseOk is false) plus every batch-
# collected typecheck error. fsno 0 heals through the parser's
# node->file segments, matching zc's errorMessage.
diagsOf: function {r: CheckResult.view rows: ListVal diagrow msgs: List String} is {
    if r.parseOk.not then {
        appendParseError ast: r.prog n: (r.prog.nodes.get i: r.prog.root) :rows :msgs
    }
    diagsOfSt :rows :msgs :r
}

# collect the embedded parse-error nodes under `n` into the diagnostic rows.
appendParseError: function {
    ast: Ast.view
    n: astnode.view
    rows: ListVal diagrow
    msgs: List String
} is {
    match (
        n
    ) case error then {
        # the row names its text; the reporter wants it owned and folded
        d9: zast.errorDataOf :ast row: n
        m: d9.msg.copy
        if d9.note.length > 0 then {
            m.appendByte b: 10
            m.append "note: "
            m.append d9.note
        }
        if d9.hint.length > 0 then {
            m.appendByte b: 10
            m.append "hint: "
            m.append d9.hint
        }
        rows.append (diagrow
            lineno: n.lineno
            colno: n.colno
            width: n.width
            code: (zast.errCode c: n.err)
            fsno: n.fsno
        )
        msgs.append m
    } else null
}

# gather all diagnostics recorded in a symbol table into row form.
diagsOfSt: function {
    rows: ListVal diagrow
    msgs: List String
    r: CheckResult.view
} is {
    o: r.st
    match (
        o
    ) case some then {
        for each er: o.typing.errors loop {
            fno: er.fsno
            if fno.isZero when er.nodeid.isZero.not then {
                sf: fsnoFor :r nodeid: er.nodeid
                if sf.isZero.not then fno = sf
            }
            m: er.msg.copy
            if er.note.length > 0 then {
                m.appendByte b: 10
                m.append "note: "
                m.append er.note
            }
            if er.hint.length > 0 then {
                m.appendByte b: 10
                m.append "hint: "
                m.append er.hint
            }
            rows.append (diagrow
                lineno: er.lineno
                colno: er.colno
                width: er.width
                code: (zast.errCode c: er.err)
                fsno: fno
            )
            msgs.append m
        }
    } case none then null
}

# ---- project-layout resolution (shared by zc and zls) --------------

# dirname -- the path up to (excluding) the final "/", "." when none.
dirname: function {p: StringView} out String is {
    idxOpt: p.lastIndexOf needle: "/"
    match (
        idxOpt
    ) case some then {
        r: String
        i: u64
        for i < idxOpt loop {
            b: p.byteAt :i
            match (
                b
            ) case some then {
                r.appendByte :b
            } case none then null
            i = i + 1
        }
        return r
    } case none then {
        return "."
    }
}

# joinPath -- a/b, or just b when a is empty.
joinPath: function {a: StringView b: StringView} out String is {
    r: String
    if a.length > 0 then {
        r.append a
        r.append "/"
    }
    r.append b
    return r
}

# exeRoot -- the install root inferred from the executable: the parent of
# the directory holding the binary.
exeRoot: function out String is {
    er: os.exePath
    match (
        er
    ) case ok then {
        d1: dirname p: er.stringView
        d2: dirname p: d1.stringView
        return d2
    } case err then {
        return ""
    }
}

# pickRuntimeUnder -- <root>/lib/runtime if it exists (installed tree),
# else <root>/src/runtime (dev tree).
pickRuntimeUnder: function {root: StringView} out String is {
    libR: joinPath a: root b: "lib/runtime"
    if (io.exists path: libR) then return libR
    return (joinPath a: root b: "src/runtime")
}

# pickTccUnder -- <root>/bin/tcc if it exists, else "".
pickTccUnder: function {root: StringView} out String is {
    cand: joinPath a: root b: "bin/tcc"
    if (io.exists path: cand) then return cand
    return ""
}

# vendoredTcc -- the tcc this tree ships, if it ships one: <root>/bin/tcc in an
# installed tree, out/tcc in the dev tree, "" when neither is there.
vendoredTcc: function out String is {
    root: exeRoot
    if root.length > 0 then {
        c: pickTccUnder root: root.stringView
        if c.length > 0 then return c
    }
    if (io.exists path: "out/tcc") then return "out/tcc"
    return ""
}

# pickCc -- the C compiler this build will use: --cc > <target>-gcc > $CC > cc.
# A fact for the C backend and the build, which `zc env` reports too; no type
# checking reads it, so the editor and the linter never resolve it.
pickCc: function {ccFlag: StringView targetTriple: StringView} out String is {
    if ccFlag.length > 0 then {
        # a bare `tcc` means the one this tree vendors, when it has one:
        # `install` symlinks zc/zl/zls onto PATH and nothing else, so a plain
        # PATH lookup would never find <root>/bin/tcc. Resolving it here does
        # not change the family -- zemitterc.ccFamilyOf reads the BASENAME,
        # and `tcc` and `<root>/bin/tcc` classify the same.
        if ccFlag == "tcc" then {
            v: vendoredTcc
            if v.length > 0 then return v
        }
        return ccFlag.string
    }
    if targetTriple.length > 0 then {
        r: String
        r.append targetTriple
        r.append "-gcc"
        return r
    }
    ce: os.env key: "CC"
    match (
        ce
    ) case some then {
        if ce.length > 0 then return ce.copy
    } case none then null
    return "cc"
}

# pickCcMode -- how zc reaches the C compiler: `spawn` unless `--cc-mode`
# says otherwise. An unrecognised value is `spawn` here -- zc rejects it at the
# flag, which is where a typo can still be reported against the argument that
# carried it.
pickCcMode: function {modeFlag: StringView} out String is {
    if modeFlag == "inproc" then return "inproc"
    return "spawn"
}

# resolveSystemDir -- the stdlib dir by precedence: explicit flag >
# $ZEROLANG_SYSTEM > $ZEROLANG_ROOT-relative > exePath-relative > cwd.
resolveSystemDir: function {flagVal: StringView} out String is {
    if flagVal.length > 0 then return flagVal.string
    ev: os.env key: "ZEROLANG_SYSTEM"
    match (
        ev
    ) case some then {
        return ev.copy
    } case none then null
    rv: os.env key: "ZEROLANG_ROOT"
    match (
        rv
    ) case some then {
        return (joinPath a: rv.stringView b: "lib/system")
    } case none then null
    root: exeRoot
    if root.length > 0 then {
        cand: joinPath a: root.stringView b: "lib/system"
        if (io.exists path: cand) then return cand
    }
    return "lib/system"
}

# resolveRuntimeDir -- the runtime dir by the same precedence; the install
# and dev trees differ (lib/runtime vs src/runtime), handled by pickRuntimeUnder.
resolveRuntimeDir: function {flagVal: StringView} out String is {
    if flagVal.length > 0 then return flagVal.string
    ev: os.env key: "ZEROLANG_RUNTIME"
    match (
        ev
    ) case some then {
        return ev.copy
    } case none then null
    rv: os.env key: "ZEROLANG_ROOT"
    match (
        rv
    ) case some then {
        return (pickRuntimeUnder root: rv.stringView)
    } case none then null
    root: exeRoot
    if root.length > 0 then {
        rd: pickRuntimeUnder root: root.stringView
        if (io.exists path: rd) then return rd
    }
    return "src/runtime"
}

# resolveTccDir -- tcc's runtime payload (libtcc1.a, include/, libtcc.so) by
# the same precedence. tcc cannot find this on its own: the directory is baked
# in at CONFIGURE time, so a relocated tree needs `-B <dir>` on the driver or
# `tcc_set_lib_path` on libtcc, and without it tcc cannot even resolve
# `stddef.h`. One directory holds all three so one answer serves both modes.
resolveTccDir: function {flagVal: StringView} out String is {
    if flagVal.length > 0 then return flagVal.string
    ev: os.env key: "ZEROLANG_TCC"
    match (
        ev
    ) case some then {
        return ev.copy
    } case none then null
    rv: os.env key: "ZEROLANG_ROOT"
    match (
        rv
    ) case some then {
        return (joinPath a: rv.stringView b: "lib/tcc")
    } case none then null
    root: exeRoot
    if root.length > 0 then {
        cand: joinPath a: root.stringView b: "lib/tcc"
        if (io.exists path: cand) then return cand
    }
    return "out/tcc-lib"
}
