# Type checker, ported from src/ztypecheck.py.
#
# Slice 4.5a: registers one UNIT type per unit (the `unit` table) and resolves
# the MAIN unit's top-level FUNCTION definition signatures into the type
# registry -- each function plus its parameter children, with referenced
# parameter types registered as shallow named shells. Mirrors the reference
# `resolve_only_main` capability (no body walk, no generics, no system-wide
# resolution); the SQL `types` / `type_children` tables read the result,
# filtered to the example's own unit. Data blocks, records, variants, classes,
# generics and body checking arrive in later slices.
#
# The registry is created by the caller and threaded in (not stored on the
# ZTyping container), mirroring the reference's module-level type table: the
# SQL dumper reads it as a separate argument.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :blockEndsInReturn
    :ccKindArm
    :blockHasBreak
    :bodyEndsInReturn
    :builtinTidIn
    :builtinTidT
    :dataFieldNames
    :descendNamed
    :fnReturnBaseNameOf
    :isBareGenericParam
    :isComparisonOp
    :isGenericParam
    :metaCreateBaseId
    :methodReturnOf
    :nodeId
    :nodeLine
    :optTidOr
    :optU64Or
    :paramIsThisReceiverId
    :regTypeNameOf
    :declOfTypeId
    :declTypeIdOf
    :publicNsOf
    :declParentIdOf
    :declDeclaresUnit
    :declOfUnitDefIds
    :unitDeclOfName
    :unitDeclOfNameId
    :isUnitNameDecl
    :programUnitDecls
    :declNameIdOf
    :declMemberIsPrivate
    :publicAliasInternalNames
    :unitNameOfTid
    :resolveSystemChild
    :resolveSystemChildById
    :resolveUnitChild
    :resolveUnitChildById
    :reexportTargetIdsOf
    :resolvedByIds
    :requiredLibs
    :rootNameOf
    :specLookup
    :sumSubtypeNames
    :typeNameOf
    :typecheck
    :walkLookupTyperef
    :walkLookupTyperefById
}

Node: zast.Node
Ast: zast.Ast
defaultval: ztyping.defaultval

# unitdefNodeId -- the nodeid of the unit row an id names (0 when the id does
# not name a unit). The row view is scoped to the fetch.
unitdefNodeId: function {ast: Ast.view nId: zast.nodeid} out zast.nodeid is {
    out9: zast.nodeid
    {
        n9: ast.nodes.get i: nId.u64
        if n9.unitdef then out9 = n9.nodeid
    }
    return out9
}

# nodeId -- the nodeid of an arbitrary type-ref / definition Node. Covers the
# kinds a type expression or method def can take (atom / labelvalue / dotted /
# expression / call / functiondef); 0 otherwise (the stamp is then a no-op row
# the typed_nodes JOIN drops).
nodeId: function {n: Node.view} out zast.nodeid is {
    match (
        n
    ) case atomid then {
        return n.nodeid
    } case labelvalue then {
        return n.nodeid
    } case binop then {
        return n.nodeid
    } case dottedpath then {
        return n.nodeid
    } case expression then {
        return n.nodeid
    } case call then {
        return n.nodeid
    } case functiondef then {
        return n.nodeid
    } case assignment then {
        return n.nodeid
    } case reassignment then {
        return n.nodeid
    } else {
        return (zast.nodeid.create from: 0)
    }
}

# nodeLine / nodeCol -- the source position of a value-expression Node. Covers
# the operation kinds a call argument can take; 0 otherwise.
nodeLine: function {n: Node.view} out u32 is {
    match (
        n
    ) case atomid then {
        return n.lineno
    } case labelvalue then {
        return n.lineno
    } case dottedpath then {
        return n.lineno
    } case expression then {
        return n.lineno
    } case call then {
        return n.lineno
    } case binop then {
        return n.lineno
    } case atomstring then {
        return n.lineno
    } else {
        return 0
    }
}

# the source column of node `n`.
nodeCol: function {n: Node.view} out u32 is {
    match (
        n
    ) case atomid then {
        return n.colno
    } case labelvalue then {
        return n.colno
    } case dottedpath then {
        return n.colno
    } case expression then {
        return n.colno
    } case call then {
        return n.colno
    } case binop then {
        return n.colno
    } case atomstring then {
        return n.colno
    } else {
        return 0
    }
}

# atomName -- the name of an atom Node (atomid / labelvalue) as an owned String,
# "" for anything else. Matching the Node param narrows it cleanly (the proven
# simple-param pattern), so callers pass a field/arg projection without worrying
# about path-subject narrowing.
atomName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } case labelvalue then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# atomNameId -- the Ast.names pool id of an atomid/labelvalue node's name
# (0 when the node is neither; no pool id is 0, so lookups by it miss).
atomNameId: function {ast: Ast.view n: Node.view} out zast.nameid is {
    ast
    match (
        n
    ) case atomid then {
        return n.name
    } case labelvalue then {
        return n.name
    } else {
        return (zast.nameid.create from: 0)
    }
}

# addError -- append a typecheck diagnostic to the typing's error list,
# deduped by node position so a spec resolved more than once reports once.
# addResolveError -- a diagnostic raised from the resolution core, which
# holds no source node: location-free, deduped by message.
addResolveError: function {ty: ztyping.ZTyping e: zast.err msg: String} is {
    dup9: false
    with eit9: ty.errors.iterate do for pe9: eit9 loop {
        if pe9.msg.stringview == msg.stringview then dup9 = true
    }
    if (dup9) == false then {
        en9: String
        eh9: String
        ty.errors.append (zast.ErrorData
            nodeid: (zast.nodeid.create from: 0)
            lineno: 0
            colno: 0
            width: 1
            err: e
            msg: msg.copy
            fsno: zvfs.fsno
            note: en9
            hint: eh9
        )
        ty.isError = true
    }
}

# stampGate -- a body-walk node stamp that suppresses GENERIC_PARAM values
# during a generic template walk: the emitter re-walks the shared template
# AST per instance and must not see template-time param stamps.
stampGate: function {st: zenv.ZSymbolTable nid: u64 tid: ztypes.tid} is {
    if st.typing.curMonoStamp > 0 then {
        mtid9: tid
        subo9: st.typing.monoParamSubst.get key: tid
        match (
            subo9
        ) case some then {
            mtid9 = ztypes.tid.create from: (subo9)
        } case none then null
        mk9: (ztyping.monostamp mono: st.typing.curMonoStamp node: nid)
        st.typing.monoNodeType.set key: mk9 value: mtid9
        return
    }
    if st.typing.suppressParamStamps then {
        if (st.reg.typetypeOf typeId: tid) == ztypes.ztypetype.genericParam then return
    }
    ztyping.nodeTypeSet tbl: st.typing.nodeType :nid :tid
}

# stampBinopOp -- record which type DECLARES a binop's operator and which method
# the operator resolved to, so emission asks the resolution rather than the
# operator's spelling. Routed exactly as stampGate routes a type stamp: an
# instance walk writes the mono pair, keyed (monoId << 32 | nodeid) and
# substituted through the instance's type args, and a template walk's own
# generic-param answer is dropped because no template body is emitted. A `method` of 0 is the truthful record for an
# operator no declaration was found for -- a comparison that fell back to
# structural equality -- and the owner still stands.
stampBinopOp: function {
    st: zenv.ZSymbolTable
    nid: u64
    owner: ztypes.tid
    method: ztypes.tid
} is {
    if owner.isZero then return
    if st.typing.curMonoStamp > 0 then {
        mow9: owner
        subo9: st.typing.monoParamSubst.get key: owner
        match (
            subo9
        ) case some then {
            mow9 = ztypes.tid.create from: (subo9)
        } case none then null
        mk9: (ztyping.monostamp mono: st.typing.curMonoStamp node: nid)
        st.typing.monoBinopOwner.set key: mk9 value: mow9
        st.typing.monoBinopMethod.set key: mk9 value: method
        return
    }
    if st.typing.suppressParamStamps then {
        if (st.reg.typetypeOf typeId: owner) == ztypes.ztypetype.genericParam then return
    }
    st.typing.binopOwner.set key: nid value: owner
    st.typing.binopMethod.set key: nid value: method
}

# record a diagnostic (with a note/hint) into the typing tables.
addErrorH: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    e: zast.err
    msg: String
    note: String
    hint: String
    width: u32
} is {
    dup: false
    with it: st.typing.errors.iterate do for prev: it loop {
        if prev.nodeid == nodeid when prev.lineno == lineno when prev.colno == colno when prev.msg.stringview == msg.stringview then {
            dup = true
        }
    }
    if (dup) == false then {
        st.typing.errors.append (zast.ErrorData
            :nodeid
            :lineno
            :colno
            :width
            err: e
            msg: msg.copy
            fsno: zvfs.fsno
            note: note.copy
            hint: hint.copy
        )
        st.typing.isError = true
    }
}

# addResolveErrorH -- addErrorH for resolution-time callers that hold the
# ZTyping directly (no symbol table yet); same dedup, so re-entrant
# resolution passes report once.
addResolveErrorH: function {
    ty: ztyping.ZTyping
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    e: zast.err
    msg: String
    width: u32
} is {
    dup: false
    with it: ty.errors.iterate do for prev: it loop {
        if prev.nodeid == nodeid when prev.lineno == lineno when prev.colno == colno when prev.msg.stringview == msg.stringview then {
            dup = true
        }
    }
    if (dup) == false then {
        ty.errors.append (zast.ErrorData
            :nodeid
            :lineno
            :colno
            :width
            err: e
            msg: msg.copy
            fsno: zvfs.fsno
            note: "".string
            hint: "".string
        )
        ty.isError = true
    }
}

# record a diagnostic into the typing tables.
addError: function {
    st: zenv.ZSymbolTable.view
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    e: zast.err
    msg: String
} is {
    en9: String
    eh9: String
    addErrorH :st :nodeid :lineno :colno :e :msg note: en9 hint: eh9 width: 1
}

# isBorrowedVar -- true when the variable id is bound BORROWED (a borrowed
# parameter or a genuine borrowed local). Reliable now that pendingBorrowPath
# no longer leaks a sub-expression's borrow into an owned binding.
isBorrowedVar: function {st: zenv.ZSymbolTable.view vid: ztypes.vid} out bool is {
    ow: st.typing.variableOwnership.get key: vid
    isB9: false
    match (
        ow
    ) case some then {
        if ow == ztypes.zownership.borrowed then isB9 = true
    } case none then null
    return isB9
}

# isNumericTid -- a concrete integer/float type id (literal-coercion target).
# Reads the id's own name and confirms it against the single builtin that name
# spells. A builtin lookup resolves, so asking for all sixteen would mint every
# numeric type -- and in most programs nothing else reaches f128's unit.
isNumericTid: function {
    ast: Ast.view
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    tid: ztypes.tid
} out bool is {
    if tid.isZero then return false
    if tid >= reg.typeById.length then return false
    tn9: String
    {
        row9: reg.typeById.get i: tid
        tn9 = row9.name.copy
    }
    si9: ztypes.numkindByName name: tn9.stringview
    if (si9.has) == false then return false
    return tid == (builtinTidT :ast :ty :reg base: tn9.stringview)
}

# isImplicitZeroCreateTid -- a bare type name in a runtime value position
# that constructs its zero/empty value with no arguments: the numeric
# scalars (zero) and String (empty). The stamp drives the emitter; the
# atom's nodeType stays the type id itself.
isImplicitZeroCreateTid: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    tid: ztypes.tid
} out bool is {
    if (isNumericTid :ast ty: st.typing reg: st.reg :tid) then return true
    if tid == (builtinTidT :ast ty: st.typing reg: st.reg base: "String") then return true
    return false
}

# bareCtorError -- one diagnostic for a bare type name in value position
# that cannot construct, with the shared teaching note.
bareCtorError: function {
    st: zenv.ZSymbolTable.view
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u32
    msg: String
    hint: String
} is {
    nt9: "a bare type name in value position is a zero-argument 'create' construction".string
    mc9: msg.copy
    hc9: hint.copy
    (addErrorH
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.callError
        msg: mc9
        note: nt9
        hint: hc9
        :width
    )
}

# checkBareTypeConstruction -- a bare type name in a runtime value position
# is a zero-argument create construction. Records/classes stamp for the
# emitter when no required field remains (defaults and a body-carrying user
# create both satisfy) and report the missing fields otherwise; a typedef
# class over String is the empty string value. Families that cannot
# construct -- views, generic templates, unions/variants (an arm must be
# selected), protocols/facets, source-produced iterators, create-disabled
# types -- each get a targeted diagnostic.
checkBareTypeConstruction: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    ast: Ast.view
    node: zast.AtomIdData.view
    tid: ztypes.tid
} is {
    cbW9: ast.names.texts.get i: node.name.u64
    (checkBareTypeValueAt
        :ast
        :st
        :unitDecl
        nodeid: node.nodeid
        lineno: node.lineno
        colno: node.colno
        width: cbW9.length.u32.orPanic
        :tid
    )
}

# checkBareTypeValueAt -- checkBareTypeConstruction's core against explicit
# source coordinates, shared by the bare-atom and unit-qualified dotted legs.
checkBareTypeValueAt: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u32
    tid: ztypes.tid
} is {
    tt9: st.reg.typetypeOf typeId: tid
    isFam9: false
    if tt9 == ztypes.ztypetype.recordType then isFam9 = true
    if tt9 == ztypes.ztypetype.classType then isFam9 = true
    if tt9 == ztypes.ztypetype.unionType then isFam9 = true
    if tt9 == ztypes.ztypetype.variantType then isFam9 = true
    if tt9 == ztypes.ztypetype.protocolType then isFam9 = true
    if tt9 == ztypes.ztypetype.facetType then isFam9 = true
    if (isFam9) == false then return
    tn9: typeNameOf :st :tid
    # borrowed views -- including a typedef class over a view (PathView) --
    # bind from an owner and cannot be constructed
    isVw9: isViewFamilyTid :ast :st :tid
    tdb9: ztypes.tid
    if (isVw9) == false then {
        tdb9 = typedefBaseOf :ast :st :unitDecl :tid
        if tdb9 > 0 when (isViewFamilyTid
            :ast
            :st
            tid: (ztypes.tid.create from: tdb9.u64)
        ) then isVw9 = true
    }
    if isVw9 then {
        mv9: "cannot construct '\{tn9}' from its bare name: a borrowed view binds from an owner"
        hv9: "project the view from its owner ('.stringview', '.listview', '.substring')".string
        bareCtorError :st :nodeid :lineno :colno :width msg: mv9 hint: hv9
        return
    }
    # a generic template has no concrete layout until its arguments apply
    isGen9: false
    {
        isgeneric9v: st.reg.isGenericOf :tid
            if isgeneric9v then isGen9 = true
    }
    if isGen9 then {
        mg9: "cannot construct '\{tn9}' from its bare name: a generic type needs type arguments"
        hg9: "apply type arguments first, e.g. '(ListVal of: u8)'".string
        bareCtorError :st :nodeid :lineno :colno :width msg: mg9 hint: hg9
        return
    }
    # unions and variants select an arm; bool's arms are its literals
    isUV9: false
    if tt9 == ztypes.ztypetype.unionType then isUV9 = true
    if tt9 == ztypes.ztypetype.variantType then isUV9 = true
    if isUV9 then {
        mu9: "cannot construct '\{tn9}' from its bare name: a union/variant selects an arm"
        hu9: "construct an arm: '\{tn9}.<arm> ...'"
        if tid == (builtinTidT :ast ty: st.typing reg: st.reg base: "bool") then {
            hu9 = "write 'false' (the zero arm) or 'true'".string
        }
        bareCtorError :st :nodeid :lineno :colno :width msg: mu9 hint: hu9
        return
    }
    isPF9: false
    if tt9 == ztypes.ztypetype.protocolType then isPF9 = true
    if tt9 == ztypes.ztypetype.facetType then isPF9 = true
    if isPF9 then {
        mp9: "cannot construct '\{tn9}' from its bare name: a protocol/facet projects a conforming value"
        hp9: "bind a value of a conforming type instead".string
        bareCtorError :st :nodeid :lineno :colno :width msg: mp9 hint: hp9
        return
    }
    # a typedef class over String (Path) is the empty string value
    if tdb9 > 0 when tdb9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "String") then {
        ics9: tid
        st.typing.implicitCreate.set key: nodeid.u64 value: ics9
        return
    }
    # source-produced iterators have no standalone construction
    isIt9: false
    if tid == (builtinTidIn
        :ast
        ty: st.typing
        reg: st.reg
        unitDecl: st.typing.systemUnitRoot
        base: "CpIter"
    ) then isIt9 = true
    if tid == (builtinTidIn
        :ast
        ty: st.typing
        reg: st.reg
        unitDecl: st.typing.systemUnitRoot
        base: "Splitter"
    ) then isIt9 = true
    if tid == (builtinTidIn
        :ast
        ty: st.typing
        reg: st.reg
        unitDecl: st.typing.systemUnitRoot
        base: "LinesIter"
    ) then isIt9 = true
    if isIt9 then {
        mi9: "cannot construct '\{tn9}' from its bare name: iterators are produced by their source"
        hi9: "call '.iterate' / '.split' / '.codepoints' / '.lines' on the source value".string
        bareCtorError :st :nodeid :lineno :colno :width msg: mi9 hint: hi9
        return
    }
    (forceMemberOf ty: st.typing reg: st.reg :ast parentTypeId: tid nameId: zast.wkCreate)
    crO9: st.typing.declChildOfId parentTypeId: tid nameId: zast.wkCreate
    hasCr9: false
    match (
        crO9
    ) case some then {
        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: crO9.u64)) == ztypes.ztypetype.functionType then hasCr9 = true
    } case none then null
    if (hasCr9) == false then {
        mn0: "cannot construct '\{tn9}' from its bare name: the type does not define construction (create: null)"
        hn0: "use the type's own factory functions".string
        bareCtorError :st :nodeid :lineno :colno :width msg: mn0 hint: hn0
        return
    }
    prov9: (List String)
    misN9: (List String)
    misI9: (ListVal u64)
    (missingCtorFields
        :ast
        :st
        funcId: (ztypes.tid.create from: tid.u64)
        isCtor: true
        provided: prov9
        posCount: 0
        missingNames: misN9
        missingIds: misI9
    )
    if misN9.length == 0 then {
        icr9: tid
        st.typing.implicitCreate.set key: nodeid.u64 value: icr9
        return
    }
    lst9: String
    li9: u64
    ln9: misN9.length
    for li9 < ln9 loop {
        mn9: misN9.get i: li9
        mid9: misI9.get i: li9
        li9 = li9 + 1
        mtn9: typeNameOf :st tid: (ztypes.tid.create from: mid9.u64)
        if lst9.length > 0 then lst9.append ", "
        ln1: "'\{mn9}' (type: \{mtn9})"
        lst9.append ln1
    }
    m9: "cannot construct '\{tn9}' from its bare name: missing required arguments \{lst9}"
    eh9: "provide each listed argument ('\{tn9} name: value ...') or add field defaults"
    bareCtorError :st :nodeid :lineno :colno :width msg: m9 hint: eh9
}

# isViewFamilyTid -- a borrowed-view type: OptionView/ListView/MapEntry monos
# (generic-origin keyed) or the non-generic StringView/ByteView views. A view
# result is a borrow into its parent container/string: the binding holds a
# SHARED lock on the parent and the payload cannot be moved out.
isViewFamilyTid: function {ast: Ast.view st: zenv.ZSymbolTable tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    if tid == (builtinTidT :ast ty: st.typing reg: st.reg base: "StringView") then return true
    if tid == (builtinTidT :ast ty: st.typing reg: st.reg base: "ByteView") then return true
    vog9: u64
    {
        vgo9: st.reg.genericOriginOf :tid
        if vgo9 > 0 then vog9 = vgo9
    }
    if vog9 == 0 then return false
    if vog9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "OptionView") then return true
    if vog9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "ListView") then return true
    if vog9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "ListViewVal") then return true
    if vog9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "MapEntry") then return true
    if vog9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "MapEntryRV") then return true
    if vog9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "MapEntryVR") then return true
    if vog9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "MapEntryVV") then return true
    return false
}

# methodReceiverIsView -- the method declares its receiver `.view`, so a call
# reads the receiver instead of writing it and the receiver lock is SHARED.
# Declared readonly-ness: unlike isContainerReaderCall it needs no name
# whitelist and works for user types.
methodReceiverIsView: function {st: zenv.ZSymbolTable mid: ztypes.tid} out bool is {
    rpn9: st.reg.thisParamNameIdOf tid: mid
    if rpn9.isZero then return false
    rpo9: st.typing.declOwnershipOfId parentTypeId: mid nameId: (zast.nameid.create from: rpn9.u32)
    match (
        rpo9
    ) case some then {
        return rpo9 == ztypes.zparamownership.viewMode
    } case none then {
        return false
    }
}

# isContainerReaderCall -- the container methods whose receiver lock is
# SHARED but which cannot say so themselves. Everything a `.view` receiver
# can express has moved to the declarations (methodReceiverIsView, ORed in at
# every call site); what is left is what a marker cannot cover:
#
#   get / listview hand out a mutable interior pointer, so their C
#   refuses a const receiver and `.view` would let a caller write through an
#   alias obtained from a readonly receiver;
#   MapEntry.key / .value are projections through the entry pointer with no
#   method declaration to mark;
#   copy is the universal `.copy` marker, which resolves to no method either.
#
# Writers and user methods (opaque bodies) stay EXCLUSIVE.
# isContainerReaderCall -- the irreducible core. Every entry left here is one a
# DECLARATION cannot express, and the reason differs per entry:
#
#   Map.get / List.get / List.listview  hand back a MUTABLE interior
#     pointer (`_r.data = &_this->entries[idx].value`), so their C refuses
#     `const` and `.view` would hand a caller a writable alias out of a readonly
#     receiver. List.get write-back is load-bearing at 28 sites.
#   MapEntry.key / MapEntry.value  are FIELDS, not methods -- there is no
#     declaration to mark.
#   Map.copy / Set.copy / List.copy  are the synthesised `.copy` marker; the
#     containers declare no `copy` member to mark.
#
# The String arm is gone: `String.copy` was already declared `{t: this.view}`,
# and `String.stringview` now is, so `methodReceiverIsView` answers for both.
isContainerReaderCall: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    recvTid: u64
    mname: StringView
} out bool is {
    if recvTid == 0 then return false
    base9: recvTid
    {
        rg9: st.reg.genericOriginOf tid: (ztypes.tid.create from: recvTid.u64)
        if rg9 > 0 then base9 = rg9
    }
    isMapB9: false
    if base9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "MapRR") then isMapB9 = true
    if base9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "MapRV") then isMapB9 = true
    if base9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "MapVR") then isMapB9 = true
    if base9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "MapVV") then isMapB9 = true
    if isMapB9 then {
        if mname == "get" then return true
        if mname == "copy" then return true
        return false
    }
    isSetB9: false
    if base9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "SetRef") then isSetB9 = true
    if base9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "SetVal") then isSetB9 = true
    if isSetB9 then {
        if mname == "copy" then return true
        return false
    }
    # BOTH List templates: they share one emitted `get`, so they share its
    # reason for being here -- a mutable interior pointer whose C refuses a
    # const receiver. Added before the valtype-element migration because the
    # SEED must know it: a migration that makes `src` uncompilable cannot then
    # build the compiler that would accept it.
    isListB9: false
    if base9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "ListRef") then isListB9 = true
    if base9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "ListVal") then isListB9 = true
    if isListB9 then {
        if mname == "get" then return true
        if mname == "listview" then return true
        if mname == "copy" then return true
        return false
    }
    isEntryB9: false
    if base9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "MapEntry") then isEntryB9 = true
    if base9 == (builtinTidT
        :ast
        ty: st.typing
        reg: st.reg
        base: "MapEntryRV"
    ) then isEntryB9 = true
    if base9 == (builtinTidT
        :ast
        ty: st.typing
        reg: st.reg
        base: "MapEntryVR"
    ) then isEntryB9 = true
    if base9 == (builtinTidT
        :ast
        ty: st.typing
        reg: st.reg
        base: "MapEntryVV"
    ) then isEntryB9 = true
    if isEntryB9 then {
        if mname == "key" then return true
        if mname == "value" then return true
        return false
    }
    return false
}

# typesCompatible -- compare two type ids: identity, never (divergent) actual,
# generic-param pairs, literal/numeric coercion (literal_int/float -> concrete
# numerics), and an asymmetric typedef-base walk on `a`.
typesCompatible: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    a: ztypes.tid
    b: ztypes.tid
} out bool is {
    if a == b then return true
    if (st.reg.typetypeOf typeId: a) == ztypes.ztypetype.neverType then return true
    if (st.reg.typetypeOf typeId: a) == ztypes.ztypetype.genericParam when (st.reg.typetypeOf typeId: b) == ztypes.ztypetype.genericParam then {
        # Any two type parameters are template-compatible: params resolve to
        # canonical per-(template,param) tids and the per-instance clone
        # checks are the concrete backstop.
        return true
    }
    aLit9: isLiteralTypeId :st tid: (ztypes.tid.create from: a.u64)
    bLit9: isLiteralTypeId :st tid: (ztypes.tid.create from: b.u64)
    if aLit9 when bLit9 then return true
    if aLit9 then {
        if (isNumericTid
            :ast
            ty: st.typing
            reg: st.reg
            tid: (ztypes.tid.create from: b.u64)
        ) then return true
    }
    if bLit9 then {
        if (isNumericTid
            :ast
            ty: st.typing
            reg: st.reg
            tid: (ztypes.tid.create from: a.u64)
        ) then return true
    }
    cur9: a
    for cur9 > 0 loop {
        nb9: typedefBaseOf :ast :st :unitDecl tid: (ztypes.tid.create from: cur9.u64)
        if nb9.isZero then {
            cur9 = ztypes.tid.create from: (0)
        } else {
            if nb9.u64 == b then return true
            cur9 = nb9
        }
    }
    return false
}

# byteOf -- the byte at index i (0 when out of range).
byteOf: function {s: StringView i: u64} out u8 is {
    bo: s.byteAt i
    match (
        bo
    ) case some then {
        return bo
    } case none then null
    return 0
}

# levenshtein -- byte-level edit distance (two-row DP), for did-you-mean.
levenshtein: function {a: StringView b: StringView} out u64 is {
    na: a.length
    nb: b.length
    if na == 0 then return nb
    if nb == 0 then return na
    prev: (ListVal u64)
    j0: u64
    for j0 <= nb loop {
        jv: j0
        prev.append jv
        j0 = j0 + 1
    }
    i: u64
    for i < na loop {
        cur: (ListVal u64)
        cur.append (i + 1)
        ab: byteOf s: a :i
        j: u64
        for j < nb loop {
            bb: byteOf s: b i: j
            cost: 1.u64
            if ab == bb then cost = 0
            delc: (prev.get i: (j + 1)) + 1
            insc: (cur.get i: j) + 1
            subc: (prev.get i: j) + cost
            best: delc
            if insc < best then best = insc
            if subc < best then best = subc
            cur.append best
            j = j + 1
        }
        prev = cur
        i = i + 1
    }
    return (prev.get i: nb)
}

# suggestSimilar -- the closest child name of parentTypeId to `name` (edit
# distance <= 2 and unique); "" if none. Powers the did-you-mean hint.
suggestSimilar: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    parentTypeId: ztypes.tid
    name: StringView
} out String is {
    best: String
    bestDist: 3.u64
    tied: false
    nms9: (ListVal u64)
    tds9: (ListVal u64)
    st.typing.declChildRows ownerTid: parentTypeId names: nms9 tids: tds9
    ci9: u64
    cn9: nms9.length
    for ci9 < cn9 loop {
        nid9: nms9.get i: ci9
        ci9 = ci9 + 1
        cnB9: ast.names.texts.get i: nid9.u64
        cn: cnB9.stringview
        if (cn == name) == false then {
            d: levenshtein a: name b: cn
            if d < bestDist then {
                best = cnB9.copy
                bestDist = d
                tied = false
            } else {
                if d == bestDist then tied = true
            }
        }
    }
    if bestDist <= 2 when (tied) == false when best.length > 0 then return best
    return "".string
}

# indexUnitDefs -- pre-scan every unit's top-level definitions into a
# (unit.name) -> typetype index BEFORE resolution, so a reference can declare the
# ONE canonical record id (declare-before-bind) instead of an anonymous shell. No
# ids minted here. Dotted-path aliases and the null/never empty types keep their
# existing post-demand handling (defTypetypeOf returns none for them).
indexUnitDefs: function {ty: ztyping.ZTyping reg: ztypes.ZTypeRegistry program: Node} is {
    match (
        program
    ) case program then {
        uCnt9b: program.ast.units.length
        uIdx9b: u64
        for uIdx9b < uCnt9b loop {
            ruId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9b))
            uIdx9b = uIdx9b + 1
            opId9: zast.nodeid
            unm9: String
            unmRef9: u32
            {
                ru: program.ast.nodes.get i: ruId9.u64
                if ru.namedoperation then {
                    unm: zast.poolTextAt pool: program.ast.names ref: ru.name
                    opId9 = ru.operation
                    unm9 = unm.copy
                    unmRef9 = ru.name
                }
            }
            if opId9 > 0 then {
                # a file unit is a NAMED child of the program root, which is
                # what makes declFindChild(programRoot, name) the unit-root
                # lookup. Last-wins there matches the name index it replaces, so
                # two files declaring the same unit name resolve as they did.
                # The root carries no unit-frame bit, so no bare-name walk
                # reaches these children -- unitFrameOf climbs through it.
                udid9: (ty.declNew
                    name: unmRef9
                    parent: ty.programRoot
                    kind: ztyping.declkind.unitDecl
                    node: ruId9
                )
                ty.declSetUnitFrame declId: udid9
                # registerUnitRoots minted the unit's TYPE and keyed it on the
                # unitdef node; the declaration binds to it here. Read by node,
                # not by name: the name lookup would find this very Decl, whose
                # type is what we are about to set.
                utl9: (ty.unitTypesById.get
                    key: (unitdefNodeId ast: program.ast nId: opId9).u64
                )
                match (
                    utl9
                ) case some then {
                    ty.declSetType declId: udid9 typeId: utl9
                    reg.setDef typeId: utl9 declId: udid9
                } case none then null
                (indexUnitBody
                    :ty
                    ast: program.ast
                    unitopId: opId9
                    unitDeclId: udid9
                )
            }
        }
        ty.defNodeIndexBuilt = true
        {
            cro9: (ty.declFindChild
                parentDeclId: ty.programRoot
                nameId: (nameIdOf ast: program.ast name: "core")
            )
            if (cro9.isZero) == false then ty.coreUnitRoot = cro9
        }
        {
            clo9: (ty.declFindChild
                parentDeclId: ty.programRoot
                nameId: (nameIdOf ast: program.ast name: "collections")
            )
            if (clo9.isZero) == false then ty.collectionsUnitRoot = clo9
            mro9: (ty.declFindChild
                parentDeclId: ty.programRoot
                nameId: (zast.nameid.create from: reg.regMainUnitId.u32.orPanic)
            )
            if (mro9.isZero) == false then ty.mainUnitRoot = mro9
            # the fourth anchor is established here with the rest: every unit
            # the checker names outright is an id from this point on, and a
            # spelling never decides which one it meant
            sro9: (ty.declFindChild
                parentDeclId: ty.programRoot
                nameId: (nameIdOf ast: program.ast name: "system")
            )
            if (sro9.isZero) == false then ty.systemUnitRoot = sro9
        }
        # canonical pre-index mints that pended their root proxy
        px9: u64
        pxn9: ty.declProxyTids.length
        for px9 < pxn9 loop {
            pxt9: ty.declProxyTids.get i: px9
            pxu9: (ty.declProxyUnits.get i: px9).copy
            px9 = px9 + 1
            pxr9: (ty.declFindChild
                parentDeclId: ty.programRoot
                nameId: (nameIdOf ast: program.ast name: pxu9.stringview)
            )
            if (pxr9.isZero) == false then {
                stillp9: false
                if (reg.defOf tid: (ztypes.tid.create from: pxt9.u64)).u64 == 0 then stillp9 = true
                if stillp9 then {
                    # the def index exists now, so try the real link first: a
                    # pre-index mint of a genuine source def (system.never,
                    # system.null) has a declaration to bind, and only a
                    # synthesized name needs the unit root as a proxy
                    pxnm9: regTypeNameOf :reg tid: (ztypes.tid.create from: pxt9.u64)
                    if pxnm9.length > 0 then {
                        (linkDeclType
                            :ty
                            :reg
                            ast: program.ast
                            unitDecl: (unitDeclOfName :ty ast: program.ast name: pxu9.stringview)
                            name: pxnm9.stringview
                            tid: (ztypes.tid.create from: pxt9.u64)
                        )
                    }
                    linked9: false
                    {
                        def9v: reg.defOf tid: (ztypes.tid.create from: pxt9.u64)
                            if def9v > 0 then linked9 = true
                    }
                    if linked9 == false then {
                        reg.setDef typeId: (ztypes.tid.create from: pxt9.u64) declId: pxr9
                    } else {
                        # the members were edged before this type had a
                        # declaration; the index has them now
                        pxd9: ty.declIdOfType typeId: (ztypes.tid.create from: pxt9.u64)
                        if pxd9 > 0 then {
                            (ty.declStampPreIndexMembers
                                parentTypeId: (ztypes.tid.create from: pxt9.u64)
                                declId: pxd9
                            )
                        }
                    }
                }
            }
        }
        # pre-index mints (lowerGenerators' system pre-resolves) predate
        # the def index; link any still-unlinked named system def now
        cu9: ztypes.tid
        cn9x: reg.nextTypeId
        for cu9 < cn9x loop {
            unl9: false
            if (reg.defOf tid: cu9).u64 == 0 then unl9 = true
            if unl9 then {
                cnm9: regTypeNameOf :reg tid: (ztypes.tid.create from: cu9.u64)
                if cnm9.length > 0 then {
                    (linkDeclType
                        :ty
                        :reg
                        ast: program.ast
                        unitDecl: ty.systemUnitRoot
                        name: cnm9.stringview
                        tid: (ztypes.tid.create from: cu9.u64)
                    )
                }
            }
            cu9 = ztypes.tid.create from: (cu9 + 1)
        }
    } else null
}

# indexUnitBody -- index one unit's top-level defs, in body order.
indexUnitBody: function {
    ty: ztyping.ZTyping.view
    ast: Ast.view
    unitopId: u32
    unitDeclId: ztypes.declid
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: unitopId
    {
        pubDeclId0: ztypes.declid
        pubOpId0: u32
        with bit: bodyIds9.iterate do for bmId9: bit loop {
            bm: ast.nodes.get i: bmId9.u64
            if bm.namedoperation then {
                ddid0: (indexDeclDef
                    :ty
                    :ast
                    parentDeclId: unitDeclId
                    nameRef: bm.name
                    nopNodeId: bm.nodeid
                    opNodeId: bm.operation
                )
                if (zast.unitOpKindIs :ast opId: bm.operation k: zast.unitkind.publicNs) then {
                    pubDeclId0 = ddid0
                    pubOpId0 = bm.operation
                }
            }
        }
        if (pubDeclId0.isZero) == false then {
            (indexDeclPublicEntries
                :ty
                :ast
                ownerDeclId: unitDeclId
                pubDeclId: pubDeclId0
                pubOpId: pubOpId0
            )
        }
    }
}

# indexDeclDef -- create the Decl for one definition (a namedoperation's
# name + operation) under parentDeclId, descending into the definition's
# own namespace (function params, object members, nested unit bodies).
# Returns the new DeclId.
indexDeclDef: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    parentDeclId: ztypes.declid
    nameRef: zast.nameid
    nopNodeId: u32
    opNodeId: u32
} out ztypes.declid is {
    op9: ast.nodes.get i: opNodeId.u64
    did0: ztypes.declid
    match (
        op9
    ) case expression then {
        # unwrap: dispatch on the inner node, keep this def's name/node
        return (indexDeclDef
            :ty
            :ast
            :parentDeclId
            :nameRef
            :nopNodeId
            opNodeId: op9.expression
        )
    } case functiondef then {
        did0 = (ty.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.funcDecl
            node: nopNodeId
        )
        indexDeclFnInner :ty :ast declId: did0 fnNodeId: opNodeId
    } case objectdef then {
        did0 = (ty.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.typeDecl
            node: nopNodeId
        )
        indexDeclObjInner :ty :ast declId: did0 objNodeId: opNodeId
    } case unitdef then {
        if op9.kind.publicNs then {
            # the exported-namespace block: entries become name -> sibling
            # edges, filled by indexDeclPublicEntries after the unit walk.
            # Any block anywhere -- a nested unit's, a hidden subunit's --
            # restricts a surface, so the visibility check is armed.
            did0 = (ty.declNew
                name: nameRef
                parent: parentDeclId
                kind: ztyping.declkind.publicNs
                node: nopNodeId
            )
            ty.privacySeen = true
        } else {
            did0 = (ty.declNew
                name: nameRef
                parent: parentDeclId
                kind: ztyping.declkind.unitDecl
                node: nopNodeId
            )
            # a namespace, subunit or template is a lookup frame; a
            # `require:` block is not (its schema check runs in its unit)
            if (zast.unitOpDeclaresUnit :ast opId: opNodeId) then ty.declSetUnitFrame declId: did0
            if (zast.unitOpKindIs
                :ast
                opId: opNodeId
                k: zast.unitkind.template
            ) then ty.declSetUnitFrame declId: did0
            npub9: ztypes.declid
            npubOp9: u32
            with nbit9: op9.body.iterate do for nmId9: nbit9 loop {
                nm9: ast.nodes.get i: nmId9.u64
                if nm9.namedoperation then {
                    nd9: (indexDeclDef
                        :ty
                        :ast
                        parentDeclId: did0
                        nameRef: nm9.name
                        nopNodeId: nm9.nodeid
                        opNodeId: nm9.operation
                    )
                    if (zast.unitOpKindIs :ast opId: nm9.operation k: zast.unitkind.publicNs) then {
                        npub9 = nd9
                        npubOp9 = nm9.operation
                    }
                }
            }
            # a nested unit's `public:` block fills its namespace after the
            # body walk, as a file unit's does (entries name later siblings)
            if (npub9.isZero) == false then {
                (indexDeclPublicEntries
                    :ty
                    :ast
                    ownerDeclId: did0
                    pubDeclId: npub9
                    pubOpId: npubOp9
                )
            }
        }
    } case datablock then {
        did0 = (ty.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.dataDecl
            node: nopNodeId
        )
        indexDeclDataInner :ty :ast declId: did0 dataNodeId: opNodeId
    } case dottedpath then {
        # a cross-unit re-export alias: its own Decl and node; shares the
        # target's type id once minting routes through the Decl layer
        did0 = (ty.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.reexportDecl
            node: nopNodeId
        )
    } case atomid then {
        # a bare name aliases too (`Same: Holder`), exactly as the dotted form
        # does -- the target just lives in THIS unit, so the alias-follow reads
        # the enclosing unit for the missing segment. A numeric literal is the
        # unit-constant shape and keeps its constDecl.
        anm9: zast.nameTextAt :ast ref: op9.name
        akind9: ztyping.declkind.reexportDecl
        if (isNumericLiteralName name: anm9.stringview) then akind9 = ztyping.declkind.constDecl
        did0 = (ty.declNew
            name: nameRef
            parent: parentDeclId
            kind: akind9
            node: nopNodeId
        )
    } else {
        did0 = (ty.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.constDecl
            node: nopNodeId
        )
    }
    return did0
}

# indexDeclFnInner -- parameter and as-member Decls under a function
# declaration (parameters are in the tree: a navigable signature).
indexDeclFnInner: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    declId: ztypes.declid
    fnNodeId: u32
} is {
    fn9: ast.nodes.get i: fnNodeId.u64
    match (
        fn9
    ) case functiondef then {
        with pit9: fn9.parameters.iterate do for pId9: pit9 loop {
            pn9: ast.nodes.get i: pId9.u64
            if pn9.namedoperation then {
                (ty.declNew
                    name: pn9.name
                    parent: declId
                    kind: ztyping.declkind.paramDecl
                    node: pn9.nodeid
                )
            }
        }
        with ait9: fn9.asItems.iterate do for aId9: ait9 loop {
            an9: ast.nodes.get i: aId9.u64
            if an9.namedoperation then {
                (indexDeclAsMember
                    :ty
                    :ast
                    parentDeclId: declId
                    nameRef: an9.name
                    nopNodeId: an9.nodeid
                    opNodeId: an9.operation
                )
            }
        }
    } else null
}

# indexDeclDataInner -- member Decls under a data (enum) declaration: one arm
# per element, named the way resolveData names it, so an unnamed element
# takes its ordinal.
indexDeclDataInner: function {
    ty: ztyping.ZTyping
    ast: Ast
    declId: ztypes.declid
    dataNodeId: u32
} is {
    nrefs9: (ListVal u32)
    nodes9: (ListVal u32)
    ords9: (ListVal u64)
    {
        dn9: ast.nodes.get i: dataNodeId.u64
        match (
            dn9
        ) case datablock then {
            ord9: u64
            with eit9: dn9.elements.iterate do for eId9: eit9 loop {
                en9: ast.nodes.get i: eId9.u64
                if en9.namedoperation then {
                    nrefs9.append en9.name
                    nodes9.append en9.nodeid
                    ords9.append ord9
                }
                ord9 = ord9 + 1
            }
        } else null
    }
    i9: u64
    n9: nrefs9.length
    for i9 < n9 loop {
        nr9: nrefs9.get i: i9
        nd9: nodes9.get i: i9
        od9: ords9.get i: i9
        i9 = i9 + 1
        if nr9 == 0 then {
            ots9: "\{od9}"
            nr9 = ast.internString text: ots9.stringview
        }
        (ty.declNew
            name: nr9
            parent: declId
            kind: ztyping.declkind.armDecl
            node: nd9
        )
    }
}

# indexDeclObjInner -- member Decls under a type declaration: is-block
# entries (fields; arms for variant/union kinds) and as-block members.
indexDeclObjInner: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    declId: ztypes.declid
    objNodeId: u32
} is {
    ob9: ast.nodes.get i: objNodeId.u64
    match (
        ob9
    ) case objectdef then {
        isArm9: false
        if ob9.kind.variantDef then isArm9 = true
        if ob9.kind.unionDef then isArm9 = true
        with iit9: ob9.isItems.iterate do for iId9: iit9 loop {
            in9: ast.nodes.get i: iId9.u64
            if in9.namedoperation then {
                if isArm9 then {
                    (ty.declNew
                        name: in9.name
                        parent: declId
                        kind: ztyping.declkind.armDecl
                        node: in9.nodeid
                    )
                } else {
                    (indexDeclAsMember
                        :ty
                        :ast
                        parentDeclId: declId
                        nameRef: in9.name
                        nopNodeId: in9.nodeid
                        opNodeId: in9.operation
                    )
                }
            }
        }
        pubDeclId0: ztypes.declid
        pubOpId0: u32
        with ait9: ob9.asItems.iterate do for aId9: ait9 loop {
            an9: ast.nodes.get i: aId9.u64
            if an9.namedoperation then {
                if (zast.unitOpKindIs :ast opId: an9.operation k: zast.unitkind.publicNs) then {
                    # the type's exported-namespace block: a publicNs Decl whose
                    # edges (public name -> internal member Decl) are filled after
                    # all members are indexed. Mirrors the unit `public:` block.
                    pubDeclId0 = (ty.declNew
                        name: an9.name
                        parent: declId
                        kind: ztyping.declkind.publicNs
                        node: an9.nodeid
                    )
                    pubOpId0 = an9.operation
                } else {
                    (indexDeclAsMember
                        :ty
                        :ast
                        parentDeclId: declId
                        nameRef: an9.name
                        nopNodeId: an9.nodeid
                        opNodeId: an9.operation
                    )
                }
            }
        }
        if (pubDeclId0.isZero) == false then {
            (indexDeclPublicEntries
                :ty
                :ast
                ownerDeclId: declId
                pubDeclId: pubDeclId0
                pubOpId: pubOpId0
            )
        }
    } else null
}

# indexDeclAsMember -- one as-block member Decl: a method when the member
# is a function (with its own parameter Decls), a field-like entry
# otherwise (generic parameters, tag specs, member constants).
indexDeclAsMember: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    parentDeclId: ztypes.declid
    nameRef: zast.nameid
    nopNodeId: u32
    opNodeId: u32
} is {
    op9: ast.nodes.get i: opNodeId.u64
    match (
        op9
    ) case expression then {
        (indexDeclAsMember
            :ty
            :ast
            :parentDeclId
            :nameRef
            :nopNodeId
            opNodeId: op9.expression
        )
    } case functiondef then {
        md9: (ty.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.methodDecl
            node: nopNodeId
        )
        indexDeclFnInner :ty :ast declId: md9 fnNodeId: opNodeId
    } else {
        (ty.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.fieldDecl
            node: nopNodeId
        )
    }
}

# indexDeclPublicEntries -- fill a publicNs Decl's namespace. A `public:`
# block is a unit body: an entry that REFERENCES a sibling of the enclosing
# unit -- `:member`, or `alias: member` naming one -- becomes an exposed
# name -> sibling-declaration edge (no fresh row); any other entry is a
# DEFINITION of the block (a constant, a function, a type, an alias to a
# name outside the unit) and is indexed under the block like a nested
# unit's member. Runs after the unit's body walk so entries naming later
# siblings bind.
indexDeclPublicEntries: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    ownerDeclId: ztypes.declid
    pubDeclId: ztypes.declid
    pubOpId: u32
} is {
    pop9: ast.nodes.get i: pubOpId.u64
    match (
        pop9
    ) case unitdef then {
        with bit9: pop9.body.iterate do for mId9: bit9 loop {
            m9: ast.nodes.get i: mId9.u64
            if m9.namedoperation then {
                iref9: m9.name
                mop9: ast.nodes.get i: m9.operation.u64
                isRef9: false
                if mop9.labelvalue then isRef9 = true
                if mop9.atomid then {
                    iref9 = mop9.name
                    isRef9 = true
                }
                tgt9: ztypes.declid
                if isRef9 then tgt9 = ty.declFindChild parentDeclId: ownerDeclId nameId: iref9
                if (tgt9.isZero) == false then {
                    ty.declAddChildEdge parentDeclId: pubDeclId nameId: m9.name childDeclId: tgt9
                    # the entry's value node (`:m` labelvalue / `alias: m`
                    # atom) is a navigable reference to the sibling def
                    stampRefDecl :ty nid: m9.operation.u64 declId: tgt9
                } else if (mop9.labelvalue) == false then {
                    (indexDeclDef
                        :ty
                        :ast
                        parentDeclId: pubDeclId
                        nameRef: m9.name
                        nopNodeId: m9.nodeid
                        opNodeId: m9.operation
                    )
                }
            }
        }
    } else null
}

# linkDeclType -- the Stage-1 bridge at the mint funnel: record the
# canonical id on the indexed "unitDecl.name" Decl and the Decl on the
# type. References that mint outside the def index (literal shells,
# forward names) find no Decl and no-op.
linkDeclType: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    name: StringView
    tid: ztypes.tid
} is {
    dko9: declOfUnitDef :ty :ast :unitDecl :name
    if dko9.u64 == 0 then return
    ty.declSetType declId: dko9 typeId: tid
    reg.setDef typeId: tid declId: dko9
}

# defTypetypeOf -- the typetype a top-level definition node declares, mirroring
# resolveDef's dispatch. None for nodes that mint no canonical type here (dotted-
# path aliases, the null/never empty types, enums/generics in later slices).
defTypetypeOf: function {
    ast: Ast.view
    defn: Node.view
    name: StringView
} out optionval ztypes.ztypetype is {
    match (
        defn
    ) case functiondef then {
        return (optionval.some ztypes.ztypetype.functionType)
    } case expression then {
        return (defTypetypeOf :ast defn: (ast.nodes.get i: defn.expression.u64) :name)
    } case datablock then {
        return (optionval.some ztypes.ztypetype.dataType)
    } case objectdef then {
        match (
            defn.kind
        ) case recordDef then {
            # `null` and `never` parse as empty records but ARE their own
            # typetypes, which resolveNamedType and resolveDef already know.
            # Reporting none here left them "unclassified" alongside dotted
            # aliases, and an unclassified def resolves to tid 0 -- which is
            # why core's `null:`/`never:` re-exports never resolved and the
            # lookup chain's system probe had to answer for them.
            if name == "null" then return (optionval.some ztypes.ztypetype.nullType)
            if name == "never" then return (optionval.some ztypes.ztypetype.neverType)
            return (optionval.some ztypes.ztypetype.recordType)
        } case variantDef then {
            return (optionval.some ztypes.ztypetype.variantType)
        } case unionDef then {
            return (optionval.some ztypes.ztypetype.unionType)
        } case classDef then {
            return (optionval.some ztypes.ztypetype.classType)
        } case facetDef then {
            return (optionval.some ztypes.ztypetype.facetType)
        } case protocolDef then {
            return (optionval.some ztypes.ztypetype.protocolType)
        } else {
            return (optionval.none ztypes.ztypetype)
        }
    } else {
        return (optionval.none ztypes.ztypetype)
    }
}

# definingUnitFor -- the unit that defines `name` for a reference in
# `unitDecl`: the environment walk over the unit's own frame, then the
# prelude, where a hit is a re-export and the defining unit is the one its
# dotted value names. "" when neither frame indexes it (generic params,
# this/numerics, forward refs to a nonexistent type) -- the caller then mints
# a shell exactly as before.
definingUnitFor: function {
    ty: ztyping.ZTyping.view
    ast: Ast.view
    unitDecl: ztypes.declid
    name: StringView
} out ztypes.declid is {
    hit9: (envLookup
        :ty
        frame: (frameFor :ty :unitDecl)
        nameId: (zast.poolFind pool: ast.names text: name)
    )
    if hit9.declId.isZero then return (ztypes.declid.create from: 0)
    if hit9.frame == unitDecl then return unitDecl
    ru9: reexportUnitOf :ty :ast declId: hit9.declId
    if ru9.isZero then return (ztypes.declid.create from: 0)
    return (unitDeclOfNameId :ty nameId: ru9)
}

# declareCanonicalType -- get-or-declare the ONE canonical id for `unit.name` as a
# childOf edge under its unit, linked to its Decl. The single convergence point for both a
# reference (resolveAtomType) and the definition (the resolveX resolvers): whoever
# runs first mints; the rest reuse the same id. Does NOT touch definedKeys (the
# body-resolved marker), so demanded bodies still resolve lazily.
declareCanonicalType: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    # the type that owns this one when it is a member (`Type.method`), by
    # interned name id; 0 for a free definition. `name` is always the
    # definition's OWN name -- no qualified name is built, and none is parsed.
    ownerNameId: zast.nameid
    name: StringView
    typetype: ztypes.ztypetype
} out u64 is {
    qowner9: u64
    # Inside a namespace unit, the enclosing type is a child of THAT unit, not
    # of the file unit -- the unit-name index only ever holds file units.
    nsF9: nsFrameOf :ty :unitDecl
    nsT9: declTypeIdOf :ty declId: nsF9
    if (ownerNameId.isZero) == false when (nsT9.isZero) == false then {
        nso9: ty.declChildOfId parentTypeId: nsT9 nameId: ownerNameId
        match (
            nso9
        ) case some then {
            qowner9 = nso9
        } case none then null
    }
    if (ownerNameId.isZero) == false when qowner9 == 0 then {
        cudq: (declTypeIdOf
            :ty
            declId: unitDecl
        )
        if (cudq.isZero) == false then {
            (forceMemberOf
                :ty
                :reg
                :ast
                parentTypeId: (ztypes.tid.create from: cudq.u64)
                nameId: ownerNameId
            )
            bo9: (ty.declChildOfId
                parentTypeId: (ztypes.tid.create from: cudq.u64)
                nameId: ownerNameId
            )
            match (
                bo9
            ) case some then {
                qowner9 = bo9
            } case none then null
        }
    }
    # a free definition that is a member of the namespace is declared under
    # the namespace, not the file unit
    if ownerNameId.isZero when (nsT9.isZero) == false then {
        nsm9: ty.declFindChild parentDeclId: nsF9 nameId: (zast.poolFind pool: ast.names text: name)
        if (nsm9.isZero) == false then qowner9 = nsT9.u64
    }
    if qowner9 > 0 then {
        exq: (ty.declChildOf
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: qowner9.u64)
            :name
        )
        match (
            exq
        ) case some then {
            return exq
        } case none then null
    }
    if ownerNameId.isZero when qowner9 == 0 then {
        cudm: (declTypeIdOf
            :ty
            declId: unitDecl
        )
        if (cudm.isZero) == false then {
            exm: (ty.declChildOf
                pool: ast.names
                parentTypeId: (ztypes.tid.create from: cudm.u64)
                :name
            )
            match (
                exm
            ) case some then {
                linkDeclType :ty :reg :ast :unitDecl :name tid: (ztypes.tid.create from: exm.u64)
                return exm
            } case none then null
        }
    }
    id: reg.newType :name ownerTid: qowner9 :typetype
    # valtype-ness is a property of the definition's KIND -- a record or a
    # variant is a valtype, a class or a union is not -- and is known here,
    # at declaration; a reference that reaches the declared id before its
    # definition resolves (a generic argument checked against `anyval`
    # while the target of a re-export is mid-resolution) must not read an
    # unset flag as "not a valtype". The definition's own resolution sets
    # the same value again.
    if typetype == ztypes.ztypetype.recordType then reg.setValtype typeId: id value: true
    if typetype == ztypes.ztypetype.variantType then reg.setValtype typeId: id value: true
    if qowner9 > 0 then {
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: qowner9.u64)
            nameId: (ast.internString text: name)
            childTypeId: id
        )
    } else {
        if ownerNameId.isZero then {
            cud0: (declTypeIdOf
                :ty
                declId: unitDecl
            )
            if (cud0.isZero) == false then {
                # declare the unit child before typing it. A synthesized name
                # (a mangled `Tmpl_fn`, a `tag__u8`) has no source def for
                # linkDeclType to find, so without this nothing declares it and
                # declChildOf cannot answer. declSynthMember no-ops when the
                # name is already declared.
                unid9: (ast.internString text: name)
                ukk9: ztyping.declkind.typeDecl
                if typetype == ztypes.ztypetype.functionType then ukk9 = ztyping.declkind.funcDecl
                (ty.declSynthMember
                    parentTypeId: (ztypes.tid.create from: cud0.u64)
                    nameId: unid9
                    kind: ukk9
                )
                (ty.setMemberType
                    parentTypeId: (ztypes.tid.create from: cud0.u64)
                    nameId: unid9
                    childTypeId: id
                )
            }
        }
    }
    if ownerNameId.isZero then linkDeclType :ty :reg :ast :unitDecl :name tid: id
    prxOk9: false
    if (reg.defOf tid: id).u64 == 0 then prxOk9 = true
    if prxOk9 then {
        # a canonically-declared name with no source Decl (a synthesized
        # type like tag__u8): attribute it to the unit's root Decl; a
        # pre-index mint pends until indexUnitDefs builds the roots
        prx9: unitDecl
        if (prx9.isZero) == false then {
            reg.setDef typeId: id declId: prx9
        } else {
            pxt9: id
            ty.declProxyTids.append pxt9
            pxu9: unitNameTextOf :ty :ast :unitDecl
            ty.declProxyUnits.append pxu9
        }
    }
    return id
}

# dottedDefTargetIds -- dottedDefTarget as an id pair: the parent atom's name
# id and the child's; an absent pair when the definition is not a dotted alias.
dottedDefTargetIds: function {ast: Ast.view n: Node.view} out ztypes.deftarget is {
    match (
        n
    ) case expression then {
        return (dottedDefTargetIds :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        pid9: atomNameId :ast n: (ast.nodes.get i: n.parent.u64)
        cid9: atomNameId :ast n: (ast.nodes.get i: n.child.u64)
        if pid9.isZero then return ztypes.noDefTarget
        if cid9.isZero then return ztypes.noDefTarget
        return (ztypes.deftarget unitName: pid9 defName: cid9)
    } else {
        return ztypes.noDefTarget
    }
}

# bareDefTargetNameId -- the name id a BARE alias value names (`Same: Holder`),
# through any expression wrapper; the zero id when the value is not a bare
# name. The dotted twin is dottedDefTargetIds.
bareDefTargetNameId: function {ast: Ast.view n: Node.view} out zast.nameid is {
    match (
        n
    ) case expression then {
        return (bareDefTargetNameId :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return n.name
    } else {
        return (zast.nameid.create from: 0)
    }
}

# resolveNamedType -- resolve a bare type NAME to its canonical id via the
# declare-before-bind index (definingUnitFor -> declareCanonicalType), minting a
# RECORD shell only for a numeric-literal default or an unresolved/forward name.
# `thisName` scopes the enclosing type's generic params. resolveAtomType aliases
# the self-type keywords `this`/`type` to the enclosing type name and calls here,
# so a native method's `:this` / `rhs: type` lands on the one canonical id, not a
# fresh shell.
resolveNamedType: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    name: StringView
    thisName: StringView
} out u64 is {
    if name == "null" then {
        return (declareCanonicalType
            :ast
            :ty
            :reg
            unitDecl: ty.systemUnitRoot
            ownerNameId: zast.nameid
            name: "null"
            typetype: ztypes.ztypetype.nullType
        )
    }
    if name == "never" then {
        return (declareCanonicalType
            :ast
            :ty
            :reg
            unitDecl: ty.systemUnitRoot
            ownerNameId: zast.nameid
            name: "never"
            typetype: ztypes.ztypetype.neverType
        )
    }
    b0: name.byteAt 0.u64
    isnum: false
    match (
        b0
    ) case some then {
        if b0 >= 48 when b0 <= 57 then isnum = true
    } case none then null
    if isnum then {
        # A numeric-literal name types as the literal's DEFAULT scalar (system
        # i64/f64) -- it is not a name reference, so a unit-local scalar shadow
        # must not capture it. Pre-index (defNodeIndexBuilt false) keeps the
        # named-shell fallback.
        dn7: "i64"
        if name.contains "." then dn7 = "f64"
        sid7: (descendNamed
            :ty
            :reg
            :ast
            unitDecl: ty.systemUnitRoot
            name: dn7
        )
        if sid7 > 0 then return sid7
        return (reg.newType name: dn7 typetype: ztypes.ztypetype.recordType)
    }
    if thisName.length > 0 then {
        etk7: declOfUnitDef :ty :ast :unitDecl name: thisName
        if (reg.isGenericParamOf tdecl: etk7 :name) then {
            pgo7: reg.genericParamTidOf tdecl: etk7 paramName: name
            match (
                pgo7
            ) case some then {
                return pgo7
            } case none then null
            ptid7: reg.newType :name typetype: ztypes.ztypetype.genericParam
            reg.setGenericParamTid tdecl: etk7 paramName: name tid: ptid7
            return ptid7
        }
    }
    duo7: definingUnitFor :ty :ast :unitDecl :name
    if (duo7.isZero) == false then {
        tto7: (optionval.none ztypes.ztypetype)
        dd7: declOfUnitDef :ty :ast unitDecl: duo7 :name
        if dd7 > 0 then tto7 = declDefTypetype :ty :ast declId: dd7
        match (
            tto7
        ) case some then {
            did7: descendNamed :ty :reg :ast unitDecl: duo7 :name
            if did7 > 0 then return did7
            return (declareCanonicalType
                :ast
                :ty
                :reg
                unitDecl: duo7
                ownerNameId: zast.nameid
                :name
                typetype: tto7
            )
        } case none then {
            ex7: (resolvedByIds
                :ast
                :ty
                unitDecl: duo7
                name: (zast.poolFind pool: ast.names text: name)
            )
            match (
                ex7
            ) case some then {
                return ex7
            } case none then null
            al7: resolveAliasKey :ty :reg :ast declId: dd7
            if al7 > 0 then return al7
            return (reg.newType :name typetype: ztypes.ztypetype.recordType)
        }
    } else {
        # the environment before a shell: a name no unit-name index places
        # but the cursor's frame chain reaches -- a template's generic
        # parameter in its own method signature (`v: t`), which is the
        # canonical GENERIC_PARAM id, not a forward record of that name
        e7: envTypeIdOf :ty nameId: (zast.poolFind pool: ast.names text: name)
        if e7 > 0 then return e7
        return (reg.newType :name typetype: ztypes.ztypetype.recordType)
    }
}

# resolveAtomType -- resolve a type-atom name in a method/param position. `this`
# and `type` alias the enclosing type (thisName); everything else is a plain name.
resolveAtomType: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    nm: StringView
    thisName: StringView
} out u64 is {
    if nm == "this" then return (resolveNamedType :ty :reg :ast :unitDecl name: thisName :thisName)
    if nm == "type" then {
        if thisName.length != 0 then {
            return (resolveNamedType :ty :reg :ast :unitDecl name: thisName :thisName)
        }
    }
    return (resolveNamedType :ty :reg :ast :unitDecl name: nm :thisName)
}

# parseDecimalU64 -- a decimal digit string as a u64 value; none when empty
# or any byte is not a digit (signs, radix prefixes, suffixed forms stay on
# the name-keyed path).
parseDecimalU64: function {text: StringView} out optionval u64 is {
    acc9: u64
    i9: u64
    any9: false
    run9: true
    for run9 loop {
        bo9: text.byteAt i9
        match (
            bo9
        ) case some then {
            if bo9 >= 48 when bo9 <= 57 then {
                d9: bo9 - 48
                acc9 = acc9 * 10 + d9.u64
                any9 = true
            } else {
                any9 = false
                run9 = false
            }
        } case none then {
            run9 = false
        }
        i9 = i9 + 1
    }
    if any9 then return (optionval.some acc9)
    return (optionval.none u64)
}

# isNumericLiteralName -- true when a name begins with a digit: a numeric-literal
# atom (an `as`-block static constant like `version: 1`), as opposed to a type-name
# atom (a conformance marker). 48..57 are the ASCII digits.
# isNumericTypeName -- the name of a builtin numeric scalar type.
isNumericTypeName: function {name: StringView} out bool is {
    if name == "i8" then return true
    if name == "i16" then return true
    if name == "i32" then return true
    if name == "i64" then return true
    if name == "i128" then return true
    if name == "u8" then return true
    if name == "u16" then return true
    if name == "u32" then return true
    if name == "u64" then return true
    if name == "u128" then return true
    if name == "f16" then return true
    if name == "f32" then return true
    if name == "f64" then return true
    if name == "f128" then return true
    if name == "c8" then return true
    if name == "c32" then return true
    return false
}

# true when `name` is a numeric-literal pseudo-type name.
isNumericLiteralName: function {name: StringView} out bool is {
    b0: name.byteAt 0.u64
    match (
        b0
    ) case some then {
        if b0 >= 48 when b0 <= 57 then return true
        if b0 == 45 then {
            b1: name.byteAt 1.u64
            match (
                b1
            ) case some then {
                if b1 >= 48 when b1 <= 57 then return true
            } case none then null
        }
    } case none then null
    return false
}

# markerText -- a field or parameter marker's source spelling, for diagnostics.
markerText: function {o: ztypes.zparamownership} out String is {
    match (
        o
    ) case noneMode then {
        return "".string
    } case takeMode then {
        return "take".string
    } case borrowMode then {
        return "borrow".string
    } case viewMode then {
        return "view".string
    } case holdMode then {
        return "hold".string
    } case takexMode then {
        return "takex".string
    }
}

# isMoveMarker -- a value-position ownership-transfer marker. `.hold` moves its
# source exactly as `.take` does; the two differ only in whether the destination
# is frozen afterwards.
isMoveMarker: function {name: StringView} out bool is {
    if name == "take" then return true
    if name == "hold" then return true
    return false
}

# valueIsHold -- true when a bound value carries the `.hold` marker, through any
# `expression` wrapper. `hold` is owned and readonly, so the binding both moves
# the source away and freezes itself.
valueIsHold: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (valueIsHold :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        cnh9: atomName :ast n: (ast.nodes.get i: n.child.u64)
        return (cnh9.stringview == "hold")
    } else {
        return false
    }
}

# isStripMarker -- true for a dotted-path leaf that is an ownership or access marker
# (`.lock`/`.borrow`/`.take`/`.private`/`.public`); a type reference peels these to
# reach the underlying base type.
isStripMarker: function {name: StringView} out bool is {
    if name == "lock" then return true
    if name == "borrow" then return true
    if name == "take" then return true
    if name == "view" then return true
    if name == "hold" then return true
    if name == "takex" then return true
    if name == "private" then return true
    if name == "public" then return true
    return false
}

# isLabelValue -- true when a node is a bare `:X` label-value (an anonymous
# conformance marker in an as-block parses as a namedoperation wrapping one).
isLabelValue: function {op: Node.view} out bool is {
    match (
        op
    ) case labelvalue then {
        return true
    } else {
        return false
    }
}

# nodeMentionsName -- whether a subtree references a bare name (atom reads,
# call callables, dotted bases). Drives the conformer-context gate: the
# reference's lazy resolution only reaches a conformer the main body names.
nodeMentionsName: function {ast: Ast.view n: Node.view name: StringView} out bool is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextEq :ast ref: n.name s: name)
    } case expression then {
        return (nodeMentionsName :ast n: (ast.nodes.get i: n.expression.u64) :name)
    } case dottedpath then {
        return (nodeMentionsName :ast n: (ast.nodes.get i: n.parent.u64) :name)
    } case call then {
        if (nodeMentionsName :ast n: (ast.nodes.get i: n.callable.u64) :name) then return true
        aiter: n.arguments.iterate
        for argId9: aiter loop {
            arg: ast.nodes.get i: argId9.u64
            match (
                arg
            ) case namedoperation then {
                if (nodeMentionsName
                    :ast
                    n: (ast.nodes.get i: arg.operation.u64)
                    :name
                ) then return true
            } else null
        }
        return false
    } case binop then {
        if (nodeMentionsName :ast n: (ast.nodes.get i: n.lhs.u64) :name) then return true
        return (nodeMentionsName :ast n: (ast.nodes.get i: n.rhs.u64) :name)
    } case statement then {
        siter: n.statements.iterate
        for smId9: siter loop {
            if (nodeMentionsName :ast n: (ast.nodes.get i: smId9.u64) :name) then return true
        }
        return false
    } case statementline then {
        sln9: ast.nodes.get i: n.statementline.u64
        return (nodeMentionsName :ast n: sln9 :name)
    } case assignment then {
        return (nodeMentionsName :ast n: (ast.nodes.get i: n.value.u64) :name)
    } case reassignment then {
        return (nodeMentionsName :ast n: (ast.nodes.get i: n.value.u64) :name)
    } case caseexpr then {
        if (nodeMentionsName :ast n: (ast.nodes.get i: n.subject.u64) :name) then return true
        citer: n.clauses.iterate
        for cm: citer loop {
            if (nodeMentionsName :ast n: (ast.nodes.get i: cm.u64) :name) then return true
        }
        return false
    } case caseclause then {
        return (nodeMentionsName :ast n: (ast.nodes.get i: n.statement.u64) :name)
    } case ifexpr then {
        citer2: n.clauses.iterate
        for cm2Id9: citer2 loop {
            if (nodeMentionsName :ast n: (ast.nodes.get i: cm2Id9.u64) :name) then return true
        }
        return false
    } case forexpr then {
        return (nodeMentionsNameOptAt :ast oId: n.body :name)
    } case withexpr then {
        if (nodeMentionsName :ast n: (ast.nodes.get i: n.value.u64) :name) then return true
        return (nodeMentionsName :ast n: (ast.nodes.get i: n.body.u64) :name)
    } case doexpr then {
        return (nodeMentionsName :ast n: (ast.nodes.get i: n.statement.u64) :name)
    } else {
        return false
    }
}

# nodeMentionsNameOptAt -- nodeMentionsName over a table id (0 = absent).
nodeMentionsNameOptAt: function {ast: Ast.view oId: zast.nodeid name: StringView} out bool is {
    if oId.isZero then return false
    return (nodeMentionsName :ast n: (ast.nodes.get i: oId.u64) :name)
}

# fnBodyMentions -- nodeMentionsName over a function definition's body.
fnBodyMentions: function {ast: Ast.view op: Node.view name: StringView} out bool is {
    match (
        op
    ) case functiondef then {
        return (nodeMentionsNameOptAt :ast oId: op.body :name)
    } else {
        return false
    }
}

# recordConformerContexts -- pre-record each as-block marker target's first
# conforming type (body order) so a demand-resolved protocol binds its spec
# receiver to the conformer (the reference resolves the protocol inside the
# conformer's resolution, inheriting its `this` context).
recordConformerContexts: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    unitDecl: ztypes.declid
    defName: StringView
    op: Node.view
} is {
    match (
        op
    ) case objectdef then {
        isRef: false
        if op.kind == zast.nodetype.classDef then isRef = true
        if op.kind == zast.nodetype.unionDef then isRef = true
        dk0: (zast.poolFind pool: ast.names text: defName).u64
        dv0: isRef
        ty.mainDefIsReftype.set key: dk0 value: dv0
        aiter: op.asItems.iterate
        for amId9: aiter loop {
            am: ast.nodes.get i: amId9.u64
            match (
                am
            ) case namedoperation then {
                cn: atomName :ast n: (ast.nodes.get i: am.operation.u64)
                skipIt: false
                if cn.length == 0 then skipIt = true
                if (isNumericLiteralName name: cn.stringview) then skipIt = true
                if (skipIt) == false then {
                    ro8: unitDecl
                    if (ro8.isZero) == false then {
                        md9: (ty.declFindChild
                            parentDeclId: ro8
                            nameId: (zast.poolFind pool: ast.names text: cn.stringview)
                        )
                        (ty.declSetConformer
                            declId: md9
                            nameId: dk0.u32.orPanic
                        )
                    }
                }
            } else null
        }
    } else null
}

# isBareGenericParam -- a generic-param definition in direct dotted form
# (`t: Any.generic`); wrapped shapes (a def whose payload merely contains a
# constraint) are not unit-level generic params.
isBareGenericParam: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case dottedpath then {
        leaf: atomName :ast n: (ast.nodes.get i: op.child.u64)
        if leaf.stringview == "generic" then return true
        if leaf.stringview == "valtype" then return true
        if leaf.stringview == "reftype" then return true
        return false
    } else {
        return false
    }
}

# isGenericParam -- true when a type-expr is a generic-parameter constraint
# (`Any.generic` / `u64.generic` / `anyval.generic`): a dottedpath whose leaf is
# `generic` or `valtype`, peeling an `expression` / parameterized `call` wrapper.
isGenericParam: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case expression then {
        return (isGenericParam :ast op: (ast.nodes.get i: op.expression.u64))
    } case call then {
        return (isGenericParam :ast op: (ast.nodes.get i: op.callable.u64))
    } case dottedpath then {
        leaf: atomName :ast n: (ast.nodes.get i: op.child.u64)
        if leaf.stringview == "generic" then return true
        if leaf.stringview == "valtype" then return true
        if leaf.stringview == "reftype" then return true
        return false
    } else {
        return false
    }
}

# declOfFnDef -- the Decl of a resolved function definition: a free
# function's unit child, or a method's member Decl under its owner (the
# defName arrives owner-composed -- "u8.+" -- and the owner may be the
# DECLARING protocol rather than thisName, so the owner splits at the
# composed name's last dot). 0 when unindexed (synthesized functions).
declOfFnDef: function {
    ty: ztyping.ZTyping
    ast: Ast
    unitDecl: ztypes.declid
    ownerNameId: zast.nameid
    defName: StringView
    thisName: StringView
} out ztypes.declid is {
    if thisName.length == 0 then return (declOfUnitDef :ty :ast :unitDecl name: defName)
    mown9: declOfUnitDef :ty :ast :unitDecl name: thisName
    mnm9: defName
    if (ownerNameId.isZero) == false then {
        if (zast.poolTextEq
            pool: ast.names
            ref: (zast.nameid.create from: ownerNameId.u32)
            s: thisName
        ) == false then {
            malt9: (declOfUnitDefId
                :ty
                :unitDecl
                nameId: (zast.nameid.create from: ownerNameId.u32)
            )
            if (malt9.isZero) == false then mown9 = malt9
        }
    }
    if mown9.u64 == 0 then return (ztypes.declid.create from: 0)
    return (ty.declFindChild parentDeclId: mown9 nameId: (zast.poolFind pool: ast.names text: mnm9))
}

# registerGenericParams -- record a type's generic-param names (keyed by
# the template's DeclId) so method-param resolution can drop params typed by them.
# registerGenericParamOne -- record one member's generic-param declaration.
registerGenericParamOne: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry
    tdecl: ztypes.declid
    m: Node.view
} is {
    match (
        m
    ) case namedoperation then {
        if (isGenericParam :ast op: (ast.nodes.get i: m.operation.u64)) then {
            pn: zast.nameTextAt :ast ref: m.name
            cb: genericConstraintBase :ast n: (ast.nodes.get i: m.operation.u64)
            ckx9: genericConstraintKind :ast n: (ast.nodes.get i: m.operation.u64)
            cf9x: cb.copy
            if ckx9.length > 0 then cf9x = "\{cb}.\{ckx9}"
            k9: constraintKindFor text: cf9x.stringview
            mx9: (optionval.none u64)
            if k9 == ztypes.constraintkind.numeric then {
                mx9 = constraintNumericMax cv: cf9x.stringview
            }
            reg.addGenericParam :tdecl paramName: pn.stringview kind: k9 numericMax: mx9
        }
    } else null
}

# genericConstraintKind -- the value-kind leaf of a constraint declaration
# (`Any.valtype` -> "valtype", `Any.reftype` -> "reftype"), "" for plain
# `.generic` bounds.
genericConstraintKind: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (genericConstraintKind :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        cn9: atomName :ast n: (ast.nodes.get i: n.child.u64)
        if cn9.stringview == "valtype" then return cn9
        if cn9.stringview == "reftype" then return cn9
        return "".string
    } else {
        return "".string
    }
}

# genericConstraintBase -- the constraint name of a `u64.generic`-style param
# declaration (the dotted parent), "" otherwise.
genericConstraintBase: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (genericConstraintBase :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (atomName :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# hasGenericParam -- true when any item in the block is a generic-param declaration.
# Takes the list by value so its iterator's lock is released on return (the scan is
# sequenced before any persistent iterator over the same list).
# hasGenericParam / registerGenericParams -- id-list flavors for
# converted unit bodies (declaration lists stay embedded until S4).
hasGenericParam: function {ast: Ast.view items: (ListVal u32).view} out bool is {
    return (zast.itemsHaveGenericParam :ast :items)
}

# register a template's generic parameters, classifying each constraint.
registerGenericParams: function {
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    tdecl: ztypes.declid
    items: (ListVal u32).view
} is {
    ri9: u64
    rn9: items.length
    for ri9 < rn9 loop {
        rid9: items.get i: ri9
        rm9: ast.nodes.get i: rid9.u64
        registerGenericParamOne :ast :reg :tdecl m: rm9
        ri9 = ri9 + 1
    }
}

# unitDefIsGeneric -- a unit definition is generic when its body declares a generic
# param. Mirrors objectdefIsGeneric; gates dep-signature-stamp suppression off generic
# units, whose template signatures resolve differently.
unitDefIsGeneric: function {ast: Ast.view oId: zast.nodeid} out bool is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: oId
    return (hasGenericParam :ast items: bodyIds9)
}

# pathOwnership -- the ownership a param/field/return type expr declares via a
# dotted-path marker leaf, or none. Fields take the non-owned markers (which make
# the slot static) or `take`/`hold`; params take any of the four grid markers;
# `takex` is a RETURN marker only.
pathOwnership: function {ast: Ast.view n: Node.view} out optionval ztypes.zparamownership is {
    match (
        n
    ) case dottedpath then {
        cn: atomName :ast n: (ast.nodes.get i: n.child.u64)
        # `.lock` is a retired SPELLING of `borrow`. The MODE is gone -- the grid
        # has one non-owned-and-mutable concept, not two -- but the word still
        # parses to it so existing sources keep their exact semantics instead of
        # silently changing meaning.
        if cn.stringview == "lock" then return (optionval.some ztypes.zparamownership.borrowMode)
        if cn.stringview == "borrow" then return (optionval.some ztypes.zparamownership.borrowMode)
        if cn.stringview == "take" then return (optionval.some ztypes.zparamownership.takeMode)
        if cn.stringview == "view" then return (optionval.some ztypes.zparamownership.viewMode)
        if cn.stringview == "hold" then return (optionval.some ztypes.zparamownership.holdMode)
        if cn.stringview == "takex" then return (optionval.some ztypes.zparamownership.takexMode)
        return (optionval.none ztypes.zparamownership)
    } else {
        return (optionval.none ztypes.zparamownership)
    }
}

# baseTypeName -- the underlying base type name of a type expr, peeling `.lock`/
# `.private`/etc. dotted-path markers (`Container.private.lock` -> `Container`,
# `this.lock` -> `this`); the atom name for a bare atom; "" otherwise.
baseTypeName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } case labelvalue then {
        return (zast.nameTextCopy :ast ref: n.name)
    } case dottedpath then {
        cn: atomName :ast n: (ast.nodes.get i: n.child.u64)
        if (isStripMarker name: cn.stringview) then {
            return (baseTypeName :ast n: (ast.nodes.get i: n.parent.u64))
        } else {
            return "".string
        }
    } else {
        return "".string
    }
}

# genericApplHead -- the head type name of a generic application `(List of: T)` /
# `(Option t: T)` (the callable's atom name); "" for a non-application expr.
genericApplHead: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (genericApplHead :ast n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        return (atomName :ast n: (ast.nodes.get i: n.callable.u64))
    } else {
        return "".string
    }
}

# fieldHeadName -- a field type's head name: baseTypeName, falling back to the
# generic-application head so a `(List of: Node)` / `(Option t: Node)` field is
# recognized (List/Option) for the destructor-cleanup decision.
fieldHeadName: function {ast: Ast.view n: Node.view} out String is {
    b: baseTypeName :ast :n
    if b.length > 0 then return b
    return (genericApplHead :ast :n)
}

# resolveTyperefShell -- register a SHALLOW named shell for a referenced type
# (e.g. the `i64` in `n: i64`), routing atom names through resolveAtomType so
# `this`/numeric-default atoms resolve correctly. A parenthesized parameterized
# type `(T arg: N)` (an expression wrapping a call) mangles to a `T_N` shell.
# Source-type rows never include these shells (they fall outside `defined_in_unit`),
# but a `type_children` row joins to the shell's name. Returns the shell's type id.
recordNodeName: function {
    ty: ztyping.ZTyping
    name: StringView
    nid: u64
    frame: ztypes.declid
} is {
    if name.length != 0 then {
        kc: nid
        ty.pendingTyperef.set key: kc value: name.string
        kc3: nid
        ty.pendingTyperefFrame.set key: kc3 value: frame
    }
}

# recordResolvedName -- record (nid -> name) for post-demand resolution; the `this` and
# `type` self-keywords record as the enclosing type (thisName).
# stampNestedTyperef -- a qualified type reference into a NESTED unit
# (`out sub.T`) names a member exactly as a cross-unit reference does, but it
# cannot be recorded as a pending typeref: that carries a (unit NAME, member
# name) pair, and a nested unit has no name-index entry to be found by. So it
# resolves here and stamps the node itself. Recorded by nothing, such a
# reference reached no resolver at all and its slot typed as null.
stampNestedTyperef: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    unitId: zast.nameid
    memberId: zast.nameid
    nid: zast.nodeid
} is {
    if unitId.isZero then return
    if memberId.isZero then return
    root9: ztypes.declid
    {
        ro9: unitDecl
        if (ro9.isZero) == false then root9 = ro9
    }
    if root9.isZero then return
    mt9: (nestedUnitMemberTid
        :ty
        :reg
        :ast
        ownerDeclId: root9
        nestedNameId: unitId
        defName: memberId
    )
    if mt9.isZero then return
    ztyping.nodeTypeSet tbl: ty.nodeType nid: nid.u64 tid: mt9
}

recordResolvedName: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    thisName: StringView
    name: StringView
    nid: u64
    frame: ztypes.declid
} is {
    if name == "this" then {
        recordNodeName :ty name: thisName :nid :frame
    } else {
        if name == "type" then {
            recordNodeName :ty name: thisName :nid :frame
        } else {
            if (isNumericLiteralName :name) then {
                if name.contains "." then {
                    recordNodeName :ty name: "f64" :nid :frame
                } else {
                    recordNodeName :ty name: "i64" :nid :frame
                }
            } else {
                # a template's own param name still RECORDS (the pending
                # map feeds mono substitution) but never name-resolves: mark
                # it no-stamp so resolution doesn't chase or report it
                gskip9: false
                if thisName.length > 0 then {
                    enclK9: declOfUnitDef :ty :ast :unitDecl name: thisName
                    if (reg.isGenericParamOf tdecl: enclK9 :name) then gskip9 = true
                }
                if gskip9 == false when ty.sigGenericDecl > 0 then {
                    if (reg.isGenericParamOf tdecl: ty.sigGenericDecl :name) then gskip9 = true
                }
                recordNodeName :ty :name :nid :frame
                if gskip9 then {
                    nsg9: nid
                    nsv9: true
                    ty.noStampNode.set key: nsg9 value: nsv9
                }
            }
        }
    }
}

# monoArgName -- a pending-instantiation argument's recorded name: `this` and
# `type` map to the enclosing type (the recordResolvedName mapping); "" when
# there is no enclosing type.
monoArgName: function {an: StringView thisName: StringView} out String is {
    if an == "this" then return thisName.string
    if an == "type" then return thisName.string
    return an.string
}

# resolveDottedArgTid -- a unit-qualified dotted generic argument
# (ztypes.zlockstate): descend the member in its defining unit. Marker /
# non-unit dotted shapes resolve 0 (the caller skips the record).
resolveDottedArgTid: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    dp: Node.view
} out u64 is {
    match (
        dp
    ) case dottedpath then {
        pq9: atomName :ast n: (ast.nodes.get i: dp.parent.u64)
        cq9: atomName :ast n: (ast.nodes.get i: dp.child.u64)
        if pq9.length > 0 when cq9.length > 0 then {
            if (nameDenotesUnit :ty :reg nameId: (atomNameId
                :ast
                n: (ast.nodes.get i: dp.parent.u64)
            )) then {
                return (descendNamed
                    :ty
                    :reg
                    :ast
                    unitDecl: (unitDeclOfName :ty :ast name: pq9.stringview)
                    name: cq9.stringview
                )
            }
        }
    } else null
    return 0
}

# ensureNativeLinkTargets -- descend the native templates the collection
# materializer links returns against by NAME (String / StringView, the
# option wrappers, the iterator/view families): inline specialization runs
# at resolve time, before the demand worklist would have pulled them.
# definedKeys makes every descent after the first a no-op.
#
# ListVal / SetVal / MapRV / MapVR / MapVV are absent DELIBERATELY: no
# native return or satellite retarget names a value-side container, so
# each is only ever reached from a source spelling, which resolves by
# ordinary descent. Seed a form here only when a native's declared
# return starts naming it.
ensureNativeLinkTargets: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
} is {
    if ty.nativeLinkTargetsDone then return
    ty.nativeLinkTargetsDone = true
    descendNamed :ty :reg :ast unitDecl: ty.systemUnitRoot name: "String"
    descendNamed :ty :reg :ast unitDecl: ty.systemUnitRoot name: "StringView"
    descendNamed :ty :reg :ast unitDecl: ty.systemUnitRoot name: "Option"
    descendNamed :ty :reg :ast unitDecl: ty.systemUnitRoot name: "OptionView"
    descendNamed :ty :reg :ast unitDecl: ty.systemUnitRoot name: "optionval"
    descendNamed :ty :reg :ast unitDecl: ty.systemUnitRoot name: "Result"
    descendNamed :ty :reg :ast unitDecl: ty.systemUnitRoot name: "resultval"
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "ListRef"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "ListIter"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "ListIterVal"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "ListView"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "ListViewVal"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "SetRef"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "SetIter"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "SetIterVal"
    )
    descendNamed :ty :reg :ast unitDecl: ty.collectionsUnitRoot name: "MapRR"
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "MapKeyIter"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "MapItemIter"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "MapEntry"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "MapKeyIterRV"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "MapKeyIterVR"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "MapKeyIterVV"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "MapItemIterRV"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "MapItemIterVR"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "MapItemIterVV"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "MapEntryRV"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "MapEntryVR"
    )
    (descendNamed
        :ty
        :reg
        :ast
        unitDecl: ty.collectionsUnitRoot
        name: "MapEntryVV"
    )
}

# resolveMonoRefInline -- resolve a call-shaped parameterized type ref at the
# point it is recorded: resolve the template and every argument now (nested
# parameterized args recurse; the descent pulls unresolved defs), then dedup /
# materialize through getOrMintSpec and stamp the wrapper node. Numeric size
# literals join the instance name only (const values, not type refs). Returns
# 0 -- recording nothing -- when the callable is empty or any argument is
# unresolvable (a template-internal generic-param name stays a shell).
resolveMonoRefInline: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    thisName: StringView
    enclDecl: ztypes.declid
    op: Node.view
    nid: u32
} out u64 is {
    match (
        op
    ) case expression then {
        return (resolveMonoRefInline
            :ty
            :reg
            :ast
            :unitDecl
            :thisName
            :enclDecl
            op: (ast.nodes.get i: op.expression.u64)
            :nid
        )
    } case call then {
        return (resolveMonoRefParts
            :ty
            :reg
            :ast
            :unitDecl
            :thisName
            :enclDecl
            callable: (ast.nodes.get i: op.callable.u64)
            arguments: op.arguments
            :nid
        )
    } else null
    return 0
}

# resolveMonoRefParts -- resolveMonoRefInline's call-shaped core, taking the
# callable and argument list directly so narrowed call subjects can feed it.
resolveMonoRefParts: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    thisName: StringView
    enclDecl: ztypes.declid
    callable: Node.view
    arguments: (ListVal u32).view
    nid: u32
} out u64 is {
    {
        tname9: atomName :ast n: callable
        if tname9.length == 0 then return 0
        sfx9: String
        subs9: (MapRV String value: u64)
        valSubsR9: (MapRV String value: u64)
        firstA9: ztypes.tid
        allOk9: true
        aiter9: arguments.iterate
        for arg9Id9: aiter9 loop {
            arg9: ast.nodes.get i: arg9Id9.u64
            match (
                arg9
            ) case namedoperation then {
                an9: atomName :ast n: (ast.nodes.get i: arg9.operation.u64)
                if (isNumericLiteralName name: an9.stringview) then {
                    sfx9.append s: "_"
                    sfx9.append s: an9
                    pdv9: parseDecimalU64 text: an9.stringview
                    match (
                        pdv9
                    ) case some then {
                        vpn9: zast.nameTextAt :ast ref: arg9.name
                        vsk9: vpn9.copy
                        vsv9: pdv9
                        valSubsR9.set key: vsk9 value: vsv9
                    } case none then null
                } else {
                    aid9: ztypes.tid
                    if an9.length == 0 then {
                        opf19: ast.nodes.get i: arg9.operation.u64
                        aid9 = ztypes.tid.create from: (resolveDottedArgTid :ty :reg :ast dp: opf19)
                        if aid9.isZero then {
                            inner9: (resolveMonoRefInline
                                :ty
                                :reg
                                :ast
                                :unitDecl
                                :thisName
                                :enclDecl
                                op: (ast.nodes.get i: arg9.operation.u64)
                                nid: 0
                            )
                            if inner9 > 0 then {
                                aid9 = ztypes.tid.create from: (inner9)
                            } else {
                                allOk9 = false
                            }
                        }
                    } else {
                        anc9: monoArgName an: an9.stringview :thisName
                        if anc9.length == 0 then {
                            allOk9 = false
                        } else {
                            if enclDecl > 0 when (reg.isGenericParamOf
                                tdecl: enclDecl
                                name: anc9.stringview
                            ) then {
                                epo9: (reg.genericParamTidOf
                                    tdecl: enclDecl
                                    paramName: anc9.stringview
                                )
                                match (
                                    epo9
                                ) case some then {
                                    aid9 = ztypes.tid.create from: (epo9)
                                } case none then {
                                    aid9 = (reg.newType
                                        name: anc9.stringview
                                        typetype: ztypes.ztypetype.genericParam
                                    )
                                    (reg.setGenericParamTid
                                        tdecl: enclDecl
                                        paramName: anc9.stringview
                                        tid: aid9
                                    )
                                }
                            }
                            # a name the CURRENT unit defines wins even when
                            # not yet declared -- the ladder walk sees only
                            # declared defs and would fall through to a
                            # same-named stdlib type (resolveAtomType's rule)
                            duo9: (definingUnitFor
                                :ty
                                :ast
                                :unitDecl
                                name: anc9.stringview
                            )
                            if aid9.isZero when duo9 == unitDecl then {
                                aid9 = (descendNamed
                                    :ty
                                    :reg
                                    :ast
                                    unitDecl: duo9
                                    name: anc9.stringview
                                )
                            }
                            if aid9.isZero then {
                                ao9: (walkLookupTyperef
                                    :ast
                                    :ty
                                    :reg
                                    :unitDecl
                                    base: anc9.stringview
                                )
                                aid9 = ztypes.tid.create from: (optU64Or o: ao9 d: 0)
                            }
                            if aid9.isZero then {
                                if (duo9.isZero) == false then {
                                    aid9 = (descendNamed
                                        :ty
                                        :reg
                                        :ast
                                        unitDecl: duo9
                                        name: anc9.stringview
                                    )
                                }
                            }
                            if aid9.isZero then allOk9 = false
                        }
                    }
                    if aid9 > 0 then {
                        sfx9.append s: "_"
                        vn9: monoValName :ast :ty :reg tid: (ztypes.tid.create from: aid9.u64)
                        sfx9.append s: vn9
                        if firstA9.isZero then firstA9 = aid9
                        pn9: zast.nameTextAt :ast ref: arg9.name
                        sk9: pn9.copy
                        sv9: aid9
                        subs9.set key: sk9 value: sv9
                    }
                }
            } else null
        }
        if allOk9 == false then return 0
        if sfx9.length == 0 then return 0
        tplId9: ztypes.tid
        tduo9: definingUnitFor :ty :ast :unitDecl name: tname9.stringview
        if tduo9 == unitDecl then {
            tplId9 = (descendNamed
                :ty
                :reg
                :ast
                unitDecl: tduo9
                name: tname9.stringview
            )
        }
        if tplId9.isZero then {
            tplO9: walkLookupTyperef :ast :ty :reg :unitDecl base: tname9.stringview
            tplId9 = ztypes.tid.create from: (optU64Or o: tplO9 d: 0)
        }
        if tplId9.isZero then {
            if (tduo9.isZero) == false then {
                tplId9 = (descendNamed
                    :ty
                    :reg
                    :ast
                    unitDecl: tduo9
                    name: tname9.stringview
                )
            }
        }
        if tplId9.isZero then return 0
        ensureNativeLinkTargets :ty :reg :ast
        # generator wrapper collapse: the synth `.call` return's Option over a
        # VALTYPE element is optionval (ownership is a physical no-op there);
        # a REFTYPE element is Option (the yielded value is owned — it must
        # outlive the `.call`, so the payload lives in a malloc'd box).
        tn9: tname9.copy
        gwv9: optBoolOr o: (ty.generatorWrapper.get key: nid.u64) d: false
        if gwv9 when firstA9 > 0 then {
            if (typeIsValtype :ty :reg tid: (ztypes.tid.create from: firstA9.u64)) then {
                ovd9: (descendNamed
                    :ty
                    :reg
                    :ast
                    unitDecl: ty.systemUnitRoot
                    name: "optionval"
                )
                if ovd9 > 0 then {
                    tplId9 = ztypes.tid.create from: (ovd9)
                    tn9 = "optionval".string
                }
            } else {
                obd9: (descendNamed
                    :ty
                    :reg
                    :ast
                    unitDecl: ty.systemUnitRoot
                    name: "Option"
                )
                if obd9 > 0 then {
                    tplId9 = ztypes.tid.create from: (obd9)
                    tn9 = "Option".string
                }
            }
        }
    mainName9: ty.mainUnitRoot
        mname9: "\{tn9}\{sfx9}"
        # firstA9 rides as the fallback: when a template's param name differs
        # from the call label (Option's `t` vs the conventional `of:`), the
        # clone fallback leg types native-union arms from it -- a spec first
        # minted from a TYPE-position ref must carry real arm payloads.
        mid9: (getOrMintSpec
            :ast
            :ty
            :reg
            unitDecl: mainName9
            name: mname9.stringview
            templateId: (ztypes.tid.create from: tplId9.u64)
            subs: subs9
            valSubs: valSubsR9
            fallbackArg: firstA9
        )
        if mid9.isZero then return 0
        # backstop for a sized record whose size literal did not parse as a
        # decimal (the value-keyed trie path arms sized specs centrally)
        isSized9: false
        if tn9.stringview == "str" then isSized9 = true
        if tn9.stringview == "array" then isSized9 = true
        if isSized9 then {
            (mintCollectionChildren
                :ast
                :ty
                :reg
                monoId: mid9
                templateId: (ztypes.tid.create from: tplId9.u64)
                elemArg: firstA9
                valArg: ztypes.tid
            )
        }
        if nid > 0 then {
            ztyping.nodeTypeSet tbl: ty.nodeType nid: nid.u64 tid: mid9
        }
        return mid9
    }
}

# recordTyperef -- record a signature type-ref node (param / field / arm / return) for
# post-demand stamping. resolveTyperefShell yields only a NULL-unit shell and the real
# type may be unresolved here (system / forward refs), so the base name is resolved to its
# real type later by stampTyperefs. Recurses parameterized args and strip-marker dotted
# paths; `this`/`type` record as the enclosing type (thisName).
recordTyperef: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    thisName: StringView
    node: Node.view
} is {
    match (
        node
    ) case expression then {
        (resolveMonoRefInline
            :ty
            :reg
            :ast
            :unitDecl
            :thisName
            enclDecl: ztypes.declid
            op: (ast.nodes.get i: node.expression.u64)
            nid: node.nodeid
        )
        iex9: ast.nodes.get i: node.expression.u64
        recordTyperef :ty :reg :ast :unitDecl :thisName node: iex9
    } case call then {
        # Parameterized type `(T arg: U ...)`: the outer node resolves to a NULL-defined
        # mono (filtered out); record each argument's inner TYPE-ref (e.g. the `u32` in
        # `(optionval t: u32)`), but skip numeric-literal size args (the `16` in
        # `(str to: 16)`) -- they are const values, not type references. The pending
        # instantiation is recorded by the enclosing expression arm (the wrapper node
        # carries the reference's instance stamp).
        aiter: node.arguments.iterate
        for argId9: aiter loop {
            arg: ast.nodes.get i: argId9.u64
            match (
                arg
            ) case namedoperation then {
                an: atomName :ast n: (ast.nodes.get i: arg.operation.u64)
                if (isNumericLiteralName name: an.stringview) == false then {
                    (recordTyperef
                        :ty
                        :reg
                        :ast
                        :unitDecl
                        :thisName
                        node: (ast.nodes.get i: arg.operation.u64)
                    )
                }
            } else {
                # a bare (label-less) type argument records directly, with
                # the same numeric-size-arg skip as the labeled form
                anB9: atomName :ast n: arg
                if (isNumericLiteralName name: anB9.stringview) == false then {
                    recordTyperef :ty :reg :ast :unitDecl :thisName node: arg
                }
            }
        }
        # the head atom is itself a type reference: record it so
        # go-to-definition / hover resolve the template (the wrapper
        # expression still carries the instance stamp)
        (recordTyperef
            :ty
            :reg
            :ast
            :unitDecl
            :thisName
            node: (ast.nodes.get i: node.callable.u64)
        )
    } case dottedpath then {
        # Ownership/access strip marker (this.lock / StringView.borrow / Container.private):
        # record the dotted node with its peeled base AND recurse on the parent so the
        # stripped inner atom is stamped too (the reference stamps both ppath + stripped).
        # A `.typedef` marker only recurses -- the dotted node itself resolves to a
        # NULL-defined typedef wrapper the dump filters out.
        cn: atomName :ast n: (ast.nodes.get i: node.child.u64)
        pn: atomName :ast n: (ast.nodes.get i: node.parent.u64)
        if (nameDenotesUnit :ty :reg nameId: (nameIdOf :ast name: pn.stringview)) then {
            # cross-unit qualified type ref (zlexer.Token): record the MEMBER under
            # its DEFINING unit (the parent) so stampTyperefs bridges this node.
            # The member resolves in the qualifier's frame, not the writer's.
            qfr9: ztypes.declid
            {
                qro9: (ty.declFindChild
                    parentDeclId: ty.programRoot
                    nameId: (nameIdOf :ast name: pn.stringview)
                )
                if (qro9.isZero) == false then qfr9 = qro9
            }
            (recordResolvedName
                :ty
                :reg
                :ast
                unitDecl: (unitDeclOfName :ty :ast name: pn.stringview)
                :thisName
                name: cn.stringview
                nid: node.nodeid.u64
                frame: qfr9
            )
        } else {
            if (isStripMarker name: cn.stringview) then {
                bn: baseTypeName :ast n: (ast.nodes.get i: node.parent.u64)
                (recordResolvedName
                    :ty
                    :reg
                    :ast
                    :unitDecl
                    :thisName
                    name: bn.stringview
                    nid: node.nodeid.u64
                    frame: ty.curFrame
                )
                # a parameterized parent ((List of: String).take) has no base
                # name; the marker dp wears the parent's mono stamp.
                if bn.length == 0 then {
                    (resolveMonoRefInline
                        :ty
                        :reg
                        :ast
                        :unitDecl
                        :thisName
                        enclDecl: ztypes.declid
                        op: (ast.nodes.get i: node.parent.u64)
                        nid: node.nodeid
                    )
                }
                # Ownership markers peel and stamp the inner ref; `.private` /
                # `.public` resolve the pair atomically (no base-atom stamp).
                if cn.stringview != "private" then {
                    if cn.stringview != "public" then {
                        dpp9: ast.nodes.get i: node.parent.u64
                        recordTyperef :ty :reg :ast :unitDecl :thisName node: dpp9
                    }
                }
            } else {
                if cn.stringview == "typedef" then {
                    dpp9: ast.nodes.get i: node.parent.u64
                    recordTyperef :ty :reg :ast :unitDecl :thisName node: dpp9
                } else {
                    (stampNestedTyperef
                        :ty
                        :reg
                        :ast
                        :unitDecl
                        unitId: (atomNameId :ast n: (ast.nodes.get i: node.parent.u64))
                        memberId: (atomNameId :ast n: (ast.nodes.get i: node.child.u64))
                        nid: node.nodeid
                    )
                }
            }
        }
    } case atomid then {
        rrA9: ast.names.texts.get i: node.name.u64
        (recordResolvedName
            :ty
            :reg
            :ast
            :unitDecl
            :thisName
            name: rrA9.stringview
            nid: node.nodeid.u64
            frame: ty.curFrame
        )
    } case labelvalue then {
        rrA9: ast.names.texts.get i: node.name.u64
        (recordResolvedName
            :ty
            :reg
            :ast
            :unitDecl
            :thisName
            name: rrA9.stringview
            nid: node.nodeid.u64
            frame: ty.curFrame
        )
    } else null
}

# returnParamTid -- when a return typeref names one of the enclosing
# template's generic parameters, its canonical parameter type id; else 0.
returnParamTid: function {
    reg: ztypes.ZTypeRegistry
    enclDecl: ztypes.declid
    ast: Ast.view
    oId: zast.nodeid
} out u64 is {
    if oId.isZero then return 0
    o: ast.nodes.get i: oId.u64
    bn: atomName :ast n: o
    # a marker-suffixed generic return (`of.take` / `of.borrow`) reads its
    # base name through the peeled parent.
    if bn.length == 0 then bn = markerPeeledBase :ast n: o
    if (reg.isGenericParamOf tdecl: enclDecl name: bn.stringview) then {
        po: reg.genericParamTidOf tdecl: enclDecl paramName: bn.stringview
        match (
            po
        ) case some then {
            return po
        } case none then null
        rpt7: reg.newType name: bn.stringview typetype: ztypes.ztypetype.genericParam
        reg.setGenericParamTid tdecl: enclDecl paramName: bn.stringview tid: rpt7
        return rpt7
    }

    return 0
}

# returnWrapperBaseNameId -- the Ast.names pool id of the base atom of a declared
# return typeref (`(Option of: value)` -> the id of `Option`), peeling expression
# wrappers and `.borrow`-style strip markers; 0 for any other shape. Reads the
# declaration only: it resolves nothing and mints nothing, unlike partialTyperefTid
# below.
returnWrapperBaseNameId: function {ast: Ast.view n: Node.view} out zast.nameid is {
    match (
        n
    ) case expression then {
        return (returnWrapperBaseNameId :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        dcn7: atomName :ast n: (ast.nodes.get i: n.child.u64)
        if (isStripMarker name: dcn7.stringview) then {
            return (returnWrapperBaseNameId :ast n: (ast.nodes.get i: n.parent.u64))
        }
        return (zast.nameid.create from: 0)
    } case call then {
        return (atomNameId :ast n: (ast.nodes.get i: n.callable.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}

# partialTyperefTid -- resolve a composite parameterized typeref inside a
# template method signature to a spec through the shared disassembly
# (resolveMonoRefParts with the template's enclKey). Returns the spec only
# when it is PARTIAL (an argument named a generic param); a fully-concrete
# composite stays 0, preserving the caller's eager-path behavior.
partialTyperefTid: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    enclDecl: ztypes.declid
    n: Node.view
} out u64 is {
    match (
        n
    ) case expression then {
        iexM9: ast.nodes.get i: n.expression.u64
        return (partialTyperefTid :ty :reg :ast :unitDecl :enclDecl n: iexM9)
    } case dottedpath then {
        dcn6: atomName :ast n: (ast.nodes.get i: n.child.u64)
        if (isStripMarker name: dcn6.stringview) then {
            dpq9: ast.nodes.get i: n.parent.u64
            return (partialTyperefTid :ty :reg :ast :unitDecl :enclDecl n: dpq9)
        }
        return 0
    } case call then {
        rmp6: (resolveMonoRefParts
            :ty
            :reg
            :ast
            :unitDecl
            thisName: ""
            :enclDecl
            callable: (ast.nodes.get i: n.callable.u64)
            arguments: n.arguments
            nid: 0
        )
        if rmp6 > 0 then {
            if (reg.typetypeOf typeId: (ztypes.tid.create from: rmp6.u64)) == ztypes.ztypetype.genericParam then return rmp6
        }
        return 0
    } else null
    return 0
}

# partialReturnTid -- partialTyperefTid over a function's return typeref.
partialReturnTid: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    enclDecl: ztypes.declid
    oId: zast.nodeid
} out u64 is {
    if oId.isZero then return 0
    o: ast.nodes.get i: oId.u64
    return (partialTyperefTid :ty :reg :ast :unitDecl :enclDecl n: o)

    return 0
}

# returnIsIteratorTid -- the resolved return type belongs to an iterator
# family (ListIter/SetIter/MapKeyIter/MapItemIter or a generator's synth
# iterator `.call`... the collection families by generic origin). Iterator
# borrows stay EXCLUSIVE (many SHARED views XOR one writer XOR one
# exclusive iterator); other returned borrows are read-views and lock
# SHARED.
returnIsIteratorTid: function {st: zenv.ZSymbolTable tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    org9: u64
    {
        go9: st.reg.genericOriginOf :tid
        if go9 > 0 then org9 = go9
    }
    probe9: tid
    if org9 > 0 then probe9 = ztypes.tid.create from: org9.u64
    pn9: typeNameOf :st tid: probe9
    if pn9.stringview == "ListIter" then return true
    if pn9.stringview == "ListIterVal" then return true
    if pn9.stringview == "SetIter" then return true
    if pn9.stringview == "SetIterVal" then return true
    if pn9.stringview == "MapKeyIter" then return true
    if pn9.stringview == "MapItemIter" then return true
    if pn9.stringview == "MapKeyIterRV" then return true
    if pn9.stringview == "MapKeyIterVR" then return true
    if pn9.stringview == "MapKeyIterVV" then return true
    if pn9.stringview == "MapItemIterRV" then return true
    if pn9.stringview == "MapItemIterVR" then return true
    if pn9.stringview == "MapItemIterVV" then return true
    return false
}

# markerPeeledBase -- the base atom name under a strip-marker dotted path
# (`of.take` -> "of"); "" for any other shape.
markerPeeledBase: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case dottedpath then {
        mcn3: atomName :ast n: (ast.nodes.get i: n.child.u64)
        if (isStripMarker name: mcn3.stringview) then {
            return (atomName :ast n: (ast.nodes.get i: n.parent.u64))
        }
        return "".string
    } else {
        return "".string
    }
}

# stampGenericParamRef -- a return typeref naming one of the enclosing
# template's generic params stamps the unit's generic-param type directly
# (generic params live outside the name-resolution table).
stampGenericParamRef: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    enclDecl: ztypes.declid
    ast: Ast.view oId: zast.nodeid
} is {
    if oId.isZero then return
    o: ast.nodes.get i: oId.u64
    bn: atomName :ast n: o
    # a marker-suffixed generic return (`of.take` / `of.borrow`) reads its
    # base name through the peeled parent; the marker dp wears the stamp,
    # matching recordTyperef's convention for concrete marked returns.
    if bn.length == 0 then bn = markerPeeledBase :ast n: o
    if (reg.isGenericParamOf tdecl: enclDecl name: bn.stringview) then {
        gpt3: u64
        gpo3: reg.genericParamTidOf tdecl: enclDecl paramName: bn.stringview
        match (
            gpo3
        ) case some then {
            gpt3 = gpo3
        } case none then {
            gpt3 = reg.newType name: bn.stringview typetype: ztypes.ztypetype.genericParam
            (reg.setGenericParamTid
                tdecl: enclDecl
                paramName: bn.stringview
                tid: (ztypes.tid.create from: gpt3.u64)
            )
        }
        gnid3: nodeId n: o
        ztyping.nodeTypeSet tbl: ty.nodeType nid: gnid3.u64 tid: (ztypes.tid.create from: gpt3.u64)
    }

}

# recordGenericMarkerReturn -- a marker-suffixed generic-param return
# (`out of.take` / `out of.borrow`) records its peeled base name at the
# dotted node (pendingTyperef) so the mono-return substitution finds it:
# the plain-atom leg records inside recordTyperef, while the marker leg
# only resolution-stamps.
recordGenericMarkerReturn: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    enclDecl: ztypes.declid
    ast: Ast.view oId: zast.nodeid
} is {
    if oId.isZero then return
    o: ast.nodes.get i: oId.u64
    mpb3: markerPeeledBase :ast n: o
    if mpb3.length > 0 when (reg.isGenericParamOf tdecl: enclDecl name: mpb3.stringview) then {
        mnid3: nodeId n: o
        recordNodeName :ty name: mpb3.stringview nid: mnid3.u64 frame: ty.curFrame
        # the entry feeds mono-return substitution (the pending MAP is the
        # consumer); it names a template param, so it never name-resolves
        nsk3: mnid3.u64
        nsv3: true
        ty.noStampNode.set key: nsk3 value: nsv3
    }

}

# recordFuncReturnNode -- map a function type id to its return type-ref's node id
# so a call site can read the resolved return type (node_type, post stampTyperefs).
recordFuncReturnNode: function {
    ty: ztyping.ZTyping
    fid: ztypes.tid
    ast: Ast.view
    oId: zast.nodeid
} is {
    if oId.isZero then return
    o: ast.nodes.get i: oId.u64
    rn: nodeId n: o
    fidc: fid
    ty.funcReturnNode.set key: fidc value: rn.u64

}

# recordReturnType -- record a function's `out T` return type-ref (mirrors
# demandReturnType's extraction). A parameterized return (out (Result ...)) yields no
# bare base name and is skipped (its mono is NULL-defined, filtered out anyway).
recordReturnType: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    thisName: StringView
    oId: zast.nodeid
} is {
    if oId.isZero then return
    o: ast.nodes.get i: oId.u64
    recordTyperef :ty :reg :ast :unitDecl :thisName node: o

}

# demandTyperefNames -- demand every name a type-expr references (the head
# and, transitively, parameter-arg names), so a signature's full closure
# resolves. Creates no types.
demandTyperefNames: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    typeExpr: Node.view
} is {
    match (
        typeExpr
    ) case atomid then {
        teN9: ast.names.texts.get i: typeExpr.name.u64
        if (isNumericLiteralName name: teN9.stringview) == false then {
            (demandDefinition
                :ty
                frame: (frameFor :ty :unitDecl)
                nameId: typeExpr.name
            )
        }
    } case expression then {
        (demandTyperefNames
            :ty
            :ast
            :reg
            :unitDecl
            typeExpr: (ast.nodes.get i: typeExpr.expression.u64)
        )
    } case call then {
        hn: atomName :ast n: (ast.nodes.get i: typeExpr.callable.u64)
        if hn.length > 0 then {
            (demandDefinition
                :ty
                frame: (frameFor :ty :unitDecl)
                nameId: (atomNameId :ast n: (ast.nodes.get i: typeExpr.callable.u64))
            )
        }
        aiter: typeExpr.arguments.iterate
        for argId9: aiter loop {
            arg: ast.nodes.get i: argId9.u64
            match (
                arg
            ) case namedoperation then {
                (demandTyperefNames
                    :ty
                    :ast
                    :reg
                    :unitDecl
                    typeExpr: (ast.nodes.get i: arg.operation.u64)
                )
            } else null
        }
    } case dottedpath then {
        (demandTyperefNames
            :ty
            :ast
            :reg
            :unitDecl
            typeExpr: (ast.nodes.get i: typeExpr.parent.u64)
        )
    } else null
}

# typeArgSuffixName -- the suffix component a collection type-arg contributes to a
# shell mono name. A bare atom gives its name; a cross-unit dotted ref gives its
# MEMBER name (ztypes.zparamownership -> zparamownership) so the shell's mono name
# matches the construction path's typeNameOf-based name. Without this the dotted
# arg's atomName is "" and the shell mints `Map_u64_` (empty value), a distinct id
# from the constructed `Map_u64_zparamownership` -- the emitter's fieldMonoId
# canonicalizes by name, so divergent names leave a field/create type mismatch.
typeArgSuffixName: function {
    ty: ztyping.ZTyping.view
    ast: Ast.view
    reg: ztypes.ZTypeRegistry
    op: Node.view
} out String is {
    match (
        op
    ) case expression then {
        return (typeArgSuffixName :ty :ast :reg op: (ast.nodes.get i: op.expression.u64))
    } case dottedpath then {
        if (nameDenotesUnit :ty :reg nameId: (atomNameId
            :ast
            n: (ast.nodes.get i: op.parent.u64)
        )) then {
            return (atomName :ast n: (ast.nodes.get i: op.child.u64))
        } else {
            return "".string
        }
    } else {
        return (atomName :ast n: op)
    }
}

# resolve a type reference to its shell type id, deferring member resolution.
resolveTyperefShell: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    typeExpr: Node.view
    thisName: StringView
} out u64 is {
    match (
        typeExpr
    ) case atomid then {
        teR9: ast.names.texts.get i: typeExpr.name.u64
        (demandDefinition
            :ty
            frame: (frameFor :ty :unitDecl)
            nameId: typeExpr.name
        )
        return (resolveAtomType
            :ty
            :reg
            :ast
            :unitDecl
            nm: teR9.stringview
            :thisName
        )
    } case labelvalue then {
        teL9: ast.names.texts.get i: typeExpr.name.u64
        return (resolveAtomType
            :ty
            :reg
            :ast
            :unitDecl
            nm: teL9.stringview
            :thisName
        )
    } case expression then {
        return (resolveTyperefShell
            :ty
            :reg
            :ast
            :unitDecl
            typeExpr: (ast.nodes.get i: typeExpr.expression.u64)
            :thisName
        )
    } case call then {
        imid8: (resolveMonoRefParts
            :ty
            :reg
            :ast
            :unitDecl
            :thisName
            enclDecl: ztypes.declid
            callable: (ast.nodes.get i: typeExpr.callable.u64)
            arguments: typeExpr.arguments
            nid: 0
        )
        if imid8 > 0 then return imid8
        suffix: atomName :ast n: (ast.nodes.get i: typeExpr.callable.u64)
        (demandDefinition
            :ty
            frame: (frameFor :ty :unitDecl)
            nameId: (atomNameId :ast n: (ast.nodes.get i: typeExpr.callable.u64))
        )
        aiter: typeExpr.arguments.iterate
        for argId9: aiter loop {
            arg: ast.nodes.get i: argId9.u64
            match (
                arg
            ) case namedoperation then {
                an: typeArgSuffixName :ty :ast :reg op: (ast.nodes.get i: arg.operation.u64)
                suffix.append "_"
                suffix.append an
                (demandTyperefNames
                    :ty
                    :ast
                    :reg
                    :unitDecl
                    typeExpr: (ast.nodes.get i: arg.operation.u64)
                )
            } else null
        }
        return (reg.newType name: suffix.stringview typetype: ztypes.ztypetype.recordType)
    } case dottedpath then {
        # A cross-unit qualified type ref (zlexer.Token) names the MEMBER in the
        # referenced unit -- resolve the child like a bare atom. Otherwise a dotted
        # type-expr peels to its parent: an ownership/access strip marker
        # (Container.private.lock) or a variant/union subtype default where the arm
        # is the default value and the type is the parent (direction.north).
        pNm: atomName :ast n: (ast.nodes.get i: typeExpr.parent.u64)
        if (nameDenotesUnit :ty :reg nameId: (atomNameId
            :ast
            n: (ast.nodes.get i: typeExpr.parent.u64)
        )) then {
            cNm: atomName :ast n: (ast.nodes.get i: typeExpr.child.u64)
            (demandUnitMember
                :ty
                unitNameId: (atomNameId :ast n: (ast.nodes.get i: typeExpr.parent.u64))
                nameId: (atomNameId :ast n: (ast.nodes.get i: typeExpr.child.u64))
            )
            did8: (descendNamed
                :ty
                :reg
                :ast
                unitDecl: (unitDeclOfName :ty :ast name: pNm.stringview)
                name: cNm.stringview
            )
            if did8 > 0 then return did8
            return (resolveAtomType :ty :reg :ast :unitDecl nm: cNm.stringview :thisName)
        } else {
            # a dotted numeric literal (4.u64, 2.5.f32) declares the SUFFIX
            # type: peeling to the numeric parent would collapse it to the
            # literal default (i64/f64), silently mistyping the slot
            nSfx9: atomName :ast n: (ast.nodes.get i: typeExpr.child.u64)
            isSfx9: isNumericTypeName name: nSfx9.stringview
            if (isNumericLiteralName name: pNm.stringview) when isSfx9 then {
                return (resolveAtomType
                    :ty
                    :reg
                    :ast
                    :unitDecl
                    nm: nSfx9.stringview
                    :thisName
                )
            }
            # A qualified ref into a NESTED unit names a MEMBER, the way a
            # cross-unit ref does -- the leg above cannot see it because a
            # nested unit is absent from the unit-name index. Peeling to the
            # parent instead handed the slot the UNIT's own type.
            nsRoot9: ztypes.declid
            {
                nsro9: unitDecl
                if (nsro9.isZero) == false then nsRoot9 = nsro9
            }
            nsTid9: (nestedUnitMemberTid
                :ty
                :reg
                :ast
                ownerDeclId: nsRoot9
                nestedNameId: (atomNameId :ast n: (ast.nodes.get i: typeExpr.parent.u64))
                defName: (atomNameId :ast n: (ast.nodes.get i: typeExpr.child.u64))
            )
            if (nsTid9.isZero) == false then return nsTid9.u64
            return (resolveTyperefShell
                :ty
                :reg
                :ast
                :unitDecl
                typeExpr: (ast.nodes.get i: typeExpr.parent.u64)
                :thisName
            )
        }
    } else {
        return (reg.newType name: "?" typetype: ztypes.ztypetype.recordType)
    }
}

# regTypeNameOf -- a type's name (owned copy) straight off the registry.
regTypeNameOf: function {reg: ztypes.ZTypeRegistry tid: ztypes.tid} out String is {
    return (reg.nameOf :tid)
}

# typeofSourceType -- resolve a typeof field's SOURCE without a body walk
# (the reference's resolution-time method walks run its placeholder swap
# even in resolve-only mode; our sources are signature-resolvable): a bare
# atom reads the owner's already-resolved field of that name (a generator
# parameter capture). 0 when the shape needs the body walk.
typeofSourceType: function {ast: Ast.view
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    unitDecl: ztypes.declid
    ownerId: u64
    n: Node.view
} out u64 is {
    match (
        n
    ) case expression then {
        return (typeofSourceType
            :ast
            :ty
            :reg
            :unitDecl
            :ownerId
            n: (ast.nodes.get i: n.expression.u64)
        )
    } case atomid then {
        if ownerId == 0 then return 0
        co: ty.declChildOfId parentTypeId: (ztypes.tid.create from: ownerId.u64) nameId: n.name
        match (
            co
        ) case some then {
            cn9: regTypeNameOf :reg tid: (ztypes.tid.create from: co.u64)
            if cn9.length > 0 then {
                ro9: walkLookupTyperef :ast :ty :reg :unitDecl base: cn9.stringview
                match (
                    ro9
                ) case some then {
                    return ro9
                } case none then {
                    return co
                }
            } else {
                return co
            }
        } case none then {
            return 0
        }
    } else {
        return 0
    }
}

# resolveTyperefShellMarked -- resolveTyperefShell plus the typeof handling:
# a generator-promoted local's field type is a `typeof <first-rhs>` node.
# When the source resolves from signatures alone the field types directly
# (and the typeof node stamps); otherwise the shell is marked and the
# body's first `this.<field> =` write swaps it (the reference's
# placeholder mechanism).
resolveTyperefShellMarked: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    ownerId: u64
    typeExpr: Node.view
    thisName: StringView
} out ztypes.tid is {
    isTof: false
    match (
        typeExpr
    ) case typeofexpr then {
        isTof = true
        tsx9: ast.nodes.get i: typeExpr.source.u64
        rid9: typeofSourceType :ast :ty :reg :unitDecl :ownerId n: tsx9
        if rid9 > 0 then {
            # the node's stamp defers to the post-demand pass so it lands
            # on the globally-resolved type, not an early shell
            tnm9: regTypeNameOf :reg tid: (ztypes.tid.create from: rid9.u64)
            if tnm9.length > 0 then {
                ty.pendingTyperef.set key: typeExpr.nodeid.u64 value: tnm9
                ty.pendingTyperefFrame.set key: typeExpr.nodeid.u64 value: ty.curFrame
            }
            return (ztypes.tid.create from: rid9)
        }
    } else null
    prevCE9: ty.inContainmentEdge
    ty.inContainmentEdge = true
    cid: resolveTyperefShell :ty :reg :ast :unitDecl :typeExpr :thisName
    ty.inContainmentEdge = prevCE9
    if isTof then {
        match (
            typeExpr
        ) case typeofexpr then {
            tk: cid
            tv: typeExpr.nodeid
            ty.typeofShell.set key: tk value: tv
        } else null
    }
    return (ztypes.tid.create from: cid)
}

# nameIsInUnitReftype -- true when a type name resolves to an in-unit reference type
# (class or union). Drives the reftype-param BORROW default and class field cleanup.
# Native heap params (String/List/Map) are pointer-typed already and get no BORROW
# default (mirrors the reference's `not is_heap_allocated` guard), so they are NOT
# matched here -- only user class/union types defined in this unit.
nameIsInUnitReftype: function {
    ast: Ast.view
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    name: StringView
} out bool is {
    rr: resolveUnitChild :ast :ty :reg :unitDecl :name
    match (
        rr
    ) case some then {
        tt: reg.typetypeOf typeId: (ztypes.tid.create from: rr.u64)
        match (
            tt
        ) case classType then {
            return true
        } case unionType then {
            return true
        } else {
            return false
        }
    } case none then {
        return false
    }
}

# paramTypeBaseName -- the base type name of a (possibly parameterized) param type
# expression: an atom name directly, or the callable of a parenthesized
# `(List of: i64)` form (an expression wrapping a call). "" for anything else.
# returnHasBorrowMarkerNode / returnHasBorrowMarker -- the function's return
# type carries a REFERENCE marker: `out T.borrow` hands back a mutable
# reference into the receiver, `out T.view` a readonly one. Both pin the
# receiver for the result binding's scope; they differ only in how strongly
# (returnHasViewMarker picks that apart).
returnHasBorrowMarkerNode: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (returnHasBorrowMarkerNode :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        rbo9: pathOwnership :ast :n
        match (
            rbo9
        ) case some then {
            if rbo9 == ztypes.zparamownership.borrowMode then return true
            return rbo9 == ztypes.zparamownership.viewMode
        } case none then {
            return false
        }
    }
}

# returnHasViewMarkerNode / returnHasViewMarker -- the reference the return
# hands back is READONLY (`out T.view`), so the pin it leaves on the receiver
# is shared: several such references may be live at once.
returnHasViewMarkerNode: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (returnHasViewMarkerNode :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        rvo9: pathOwnership :ast :n
        match (
            rvo9
        ) case some then {
            return rvo9 == ztypes.zparamownership.viewMode
        } case none then {
            return false
        }
    }
}

returnHasViewMarker: function {ast: Ast.view oId: zast.nodeid} out bool is {
    if oId.isZero then return false
    o: ast.nodes.get i: oId.u64
    return (returnHasViewMarkerNode :ast n: o)
}

# returnHasTakexMarkerNode / returnHasTakexMarker -- `out T.takex`: the result is
# OWNED, and the non-owned sources it was built from stay pinned for as long as
# it lives. It is not a reference return, so it is kept apart from
# returnHasBorrowMarker -- the binding keeps its destructor.
returnHasTakexMarkerNode: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (returnHasTakexMarkerNode :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        rxo9: pathOwnership :ast :n
        match (
            rxo9
        ) case some then {
            return rxo9 == ztypes.zparamownership.takexMode
        } case none then {
            return false
        }
    }
}

returnHasTakexMarker: function {ast: Ast.view oId: zast.nodeid} out bool is {
    if oId.isZero then return false
    o: ast.nodes.get i: oId.u64
    return (returnHasTakexMarkerNode :ast n: o)
}

# true when operation `oId`'s return type carries a `.borrow` marker.
returnHasBorrowMarker: function {ast: Ast.view oId: zast.nodeid} out bool is {
    if oId.isZero then return false
    o: ast.nodes.get i: oId.u64
    return (returnHasBorrowMarkerNode :ast n: o)

}

# paramIsThisReceiver -- the parameter's type names the receiver: bare `this`
# or a marker-suffixed `this.lock` / `this.borrow`.
paramIsThisReceiver: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case expression then {
        return (paramIsThisReceiver :ast op: (ast.nodes.get i: op.expression.u64))
    } case atomid then {
        return op.name.u32 == zast.wkThis
    } case dottedpath then {
        pn: atomName :ast n: (ast.nodes.get i: op.parent.u64)
        return pn.stringview == "this"
    } else {
        return false
    }
}

# paramIsThisReceiverId -- paramIsThisReceiver over a node id, for callers
# that hold no outstanding view into ast.nodes.
paramIsThisReceiverId: function {ast: Ast.view opId: u32} out bool is {
    return (paramIsThisReceiver :ast op: (ast.nodes.get i: opId.u64))
}

# the base type name of parameter operation `op`.
paramTypeBaseName: function {ast: Ast.view op: Node.view} out String is {
    match (
        op
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: op.name)
    } case labelvalue then {
        return (zast.nameTextCopy :ast ref: op.name)
    } case expression then {
        return (paramTypeBaseName :ast op: (ast.nodes.get i: op.expression.u64))
    } case call then {
        return (atomName :ast n: (ast.nodes.get i: op.callable.u64))
    } else {
        return "".string
    }
}

# isBorrowReftypeCollection -- true for a parameterized collection whose mono is a
# non-heap-allocated reftype, which takes the reftype-param BORROW default: List and
# ListView (stack struct + heap buffer). Set/Map monos are heap-allocated (no BORROW);
# the native iterator views have no destructor (no BORROW); str/array are valtypes.
# Mirrors the is_heap_allocated the reference stamps on collection monos.
isBorrowReftypeCollection: function {name: StringView} out bool is {
    if name == "List" then return true
    if name == "ListRef" then return true
    if name == "ListVal" then return true
    if name == "ListView" then return true
    if name == "ListViewVal" then return true
    return false
}

# isBorrowNativeReftype -- true for native heap-owning reftypes (currently String)
# that take the BORROW default as an unannotated param. Keyed by name, like the
# classifiers above: the oracle decides by metadata (a native CLASS that owns heap,
# not is_heap_allocated), but native types resolve AFTER the main unit, so that
# metadata is not yet populated when a param resolves.
isBorrowNativeReftype: function {name: StringView} out bool is {
    if name == "String" then return true
    return false
}

# isNativeValueView -- true for StringView, the native immutable string view (subtype
# STRINGVIEW): a param of this type stays unowned (a value-passed copy of a borrowed
# view), so it takes no BORROW default. Other reftypes -- String (native, owns heap),
# the mutable iterators (CpIter/Splitter/LinesIter), and non-native views (ListView/
# OptionView) -- take the normal reftype-param BORROW default.
isNativeValueView: function {name: StringView} out bool is {
    if name == "StringView" then return true
    return false
}

# demandReturnType -- demand a function's return-type names (`out (Result t:
# u64 e: IoError)` -> Result), so a type named only in a return position is
# resolved.
demandReturnType: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    unitDecl: ztypes.declid
    oId: zast.nodeid
} is {
    if oId.isZero then return
    o: ast.nodes.get i: oId.u64
    demandTyperefNames :ty :ast :reg :unitDecl typeExpr: o

}

# resolveFunction -- resolve a function definition signature into a FUNCTION
# type: a child per parameter (param name -> type-ref shell, `this` params bound
# to thisName), its defining unit (source-types filter), and a `{unit}.{name}`
# entry in the resolved name-view. Returns the FUNCTION type id (a record method
# binds it as a child; a free function discards it).
# fnHasLockParam -- does any parameter (including a marked receiver) carry a
# non-owned marker? A `.borrow` return must borrow from a non-owned parameter
# so the returned view has a pinned parent to live in (docs/ownership.pdoc).
fnHasLockParam: function {ast: Ast.view fnode: zast.FunctionData.view} out bool is {
    found9: false
    with pit9: fnode.parameters.iterate do for pmId9: pit9 loop {
        if (found9) == false then {
            pm9: ast.nodes.get i: pmId9.u64
            match (
                pm9
            ) case namedoperation then {
                po9: pathOwnership :ast n: (ast.nodes.get i: pm9.operation.u64)
                match (
                    po9
                ) case some then {
                    # Any NON-OWNED parameter is a valid source: the returned
                    # view's parent is pinned either way, readonly for `view`
                    # and exclusive for `lock`/`borrow`. This is L1 of the
                    # plan's liveness rules -- the source's identity stopped
                    # mattering once every non-owned parameter is pinned.
                    if po9 == ztypes.zparamownership.borrowMode then found9 = true
                    if po9 == ztypes.zparamownership.viewMode then found9 = true
                } case none then null
            } else null
        }
    }
    return found9
}

# typeHasNonOwnedField9 -- the type declares at least one field the instance does
# NOT own: a `borrow`/`view` slot, i.e. a reference into something else. Such an
# instance is only sound while whatever it points at outlives it.
typeHasNonOwnedField9: function {ty: ztyping.ZTyping tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    fn9: (ListVal u64)
    ft9: (ListVal u64)
    ty.declMemberList ownerTid: tid names: fn9 tids: ft9
    i9: u64
    n9: fn9.length
    found9: false
    for i9 < n9 loop {
        if (found9) == false then {
            nid9: (fn9.get i: i9).u32.orPanic
            if (ty.declIsLockFieldId
                parentTypeId: tid
                nameId: (zast.nameid.create from: nid9.u32)
            ) then found9 = true
        }
        i9 = i9 + 1
    }
    return found9
}

# returnNamesThis9 -- the return type is the enclosing type itself (`out this`,
# with or without a marker), which is what a constructor writes.
returnNamesThis9: function {ast: Ast.view oId: zast.nodeid} out bool is {
    if oId.isZero then return false
    rn9: rootNameOf :ast n: (ast.nodes.get i: oId.u64)
    return rn9.stringview == "this"
}

# checkTakexHonesty -- an OWNED `out this` whose type declares a non-owned field
# hands back a value holding a reference into something the callee was given.
# Unless the return says `takex`, nothing pins that source and the field dangles
# as soon as the caller drops it. This is the rule `.lock` on the parameter used
# to enforce by accident; `takex` states it on the signature, where a reader can
# see it.
checkTakexHonesty: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    fnode: zast.FunctionData.view
    thisTid: ztypes.tid
    defName: StringView
} is {
    if thisTid.isZero then return
    if (returnNamesThis9 :ast oId: fnode.returntype) == false then return
    # a reference return is a different contract, checked by checkBorrowReturnLock
    if (returnHasBorrowMarker :ast oId: fnode.returntype) then return
    if (returnHasTakexMarker :ast oId: fnode.returntype) then return
    if (typeHasNonOwnedField9 :ty tid: (ztypes.tid.create from: thisTid.u64)) == false then return
    (addResolveErrorH
        :ty
        nodeid: fnode.nodeid
        lineno: fnode.lineno
        colno: fnode.colno
        e: zast.err.ownerError
        msg: "an owned `out this` whose type declares a non-owned field must be `.takex` -- the result holds a reference into a parameter, and only `takex` pins that source for the result's lifetime".string
        width: defName.length.u32.orPanic
    )
}

# checkBorrowReturnLock -- a `.borrow`-returning function must borrow from a
# non-owned parameter (a marked receiver counts), so the returned view has a
# pinned parent (docs/ownership.pdoc). Runs at every function/method decl.
checkBorrowReturnLock: function {
    ast: Ast.view
    ty: ztyping.ZTyping.view
    fnode: zast.FunctionData.view
    defName: StringView
} is {
    if (returnHasBorrowMarker :ast oId: fnode.returntype) then {
        if (fnHasLockParam :ast :fnode) == false then {
            (addResolveErrorH
                :ty
                nodeid: fnode.nodeid
                lineno: fnode.lineno
                colno: fnode.colno
                e: zast.err.ownerError
                msg: "a `.borrow` return must borrow from a non-owned parameter -- mark the source `.view` (readonly) or `.borrow` (mutable), e.g. `t: this.view`, so the returned view has a pinned parent".string
                width: defName.length.u32.orPanic
            )
        }
    }
}

# resolve a function definition: its parameters, return type, and body.
resolveFunction: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    unitDecl: ztypes.declid
    # a method's owner, by interned name id; 0 for a free function
    ownerNameId: zast.nameid
    defName: StringView
    fnode: zast.FunctionData
    thisName: StringView
    skipThisType: bool
} out u64 is {
    # a METHOD's signature resolves in the frame of its declaration, under
    # its owner's; a free function's caller (resolveDef) has already entered
    # the function's own frame. A method the name index cannot place keeps
    # the caller's frame.
    prevFrame9: ty.curFrame
    if (ownerNameId.isZero) == false then {
        od9: (declOfUnitDef
            :ty
            :ast
            :unitDecl
            name: (zast.poolTextAt pool: ast.names ref: ownerNameId).stringview
        )
        if (od9.isZero) == false then {
            fd9: ty.declFindChild parentDeclId: od9 nameId: (nameIdOf :ast name: defName)
            if (fd9.isZero) == false then ty.curFrame = fd9
        }
    }
    r9: (resolveFunctionIn
        :ty
        :reg
        :ast
        :unitDecl
        :ownerNameId
        :defName
        :fnode
        :thisName
        :skipThisType
    )
    ty.curFrame = prevFrame9
    return r9
}

resolveFunctionIn: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    unitDecl: ztypes.declid
    ownerNameId: zast.nameid
    defName: StringView
    fnode: zast.FunctionData
    thisName: StringView
    skipThisType: bool
} out u64 is {
    fid: (declareCanonicalType
        :ast
        :ty
        :reg
        :unitDecl
        :ownerNameId
        name: defName
        typetype: ztypes.ztypetype.functionType
    )
    reg.setNative typeId: (ztypes.tid.create from: fid.u64) value: fnode.isNative
    {
        fhbV: fnode.body > 0
        fhbK: fid
        ty.fnHasBody.set key: fhbK value: fhbV
    }
    dfid: fid
    rfid: fid
    isgen: hasGenericParam :ast items: fnode.asItems
    fnDecl9: declOfFnDef :ty :ast :unitDecl :ownerNameId :defName :thisName
    # link the declaration to its type up front: the parameter loop below
    # records ownership and defaults on member declarations, which needs the
    # owner reachable from its type id.
    if (fnDecl9.isZero) == false then (ty.declSetType
        declId: fnDecl9
        typeId: (ztypes.tid.create from: dfid.u64)
    )
    if isgen then {
        reg.setGeneric typeId: (ztypes.tid.create from: fid.u64) value: true
        # Function templates register their param constraints like type
        # templates do (checkGenericCall checks satisfaction per call).
        registerGenericParams :ast :reg tdecl: fnDecl9 items: fnode.asItems
        aiter2: fnode.asItems.iterate
        for amId9: aiter2 loop {
            am: ast.nodes.get i: amId9.u64
            match (
                am
            ) case namedoperation then {
                if (isGenericParam :ast op: (ast.nodes.get i: am.operation.u64)) then {
                    apn: zast.nameTextAt :ast ref: am.name
                    (ty.setGenericArg
                        pool: ast.names
                        parentTypeId: (ztypes.tid.create from: fid.u64)
                        paramName: apn.stringview
                        argTypeId: 0
                    )
                }
            } else null
        }
        hasB: fnode.body > 0
        if hasB then {
            dvg: bodyEndsInReturn :ast bodyId: fnode.body
            fidd: fid
            ty.fnBodyDiverges.set key: fidd value: dvg
        }
    }
    enclDecl9: ztypes.declid
    if thisName.length != 0 then {
        enclDecl9 = declOfUnitDef :ty :ast :unitDecl name: thisName
    } else {
        ero9: unitDecl
        if (ero9.isZero) == false then enclDecl9 = ero9
    }
    sgkPrev9: ty.sigGenericDecl
    if isgen then ty.sigGenericDecl = fnDecl9
    piter: fnode.parameters.iterate
    for pmId9: piter loop {
        pm: ast.nodes.get i: pmId9.u64
        match (
            pm
        ) case namedoperation then {
            skipParam: false
            genParam: false
            fnParam9: false
            ptn: atomName :ast n: (ast.nodes.get i: pm.operation.u64)
            # A MARKED receiver is an alias, so its type is `this.view` rather
            # than the bare `this` an atom name reports. Ask the shared
            # predicate, which knows every marker form.
            isRecvP9: (paramIsThisReceiver
                :ast
                op: (ast.nodes.get i: pm.operation.u64)
            )
            if skipThisType then {
                # BOTH tests are load-bearing. The atom-name test catches the
                # bare `:this` shorthand, whose operation node does not carry
                # the well-known `this` name id that paramIsThisReceiver checks;
                # the predicate catches every MARKED form, whose type is a
                # dotted path and so has no atom name at all. Dropping either
                # leaves that family of receivers as ordinary parameters.
                if ptn.stringview == "this" then skipParam = true
                if isRecvP9 then skipParam = true
            }
            if skipParam == false when isgen then {
                if (reg.isGenericParamOf tdecl: fnDecl9 name: ptn.stringview) then {
                    skipParam = true
                    fnParam9 = true
                }
            }
            if skipParam == false when (reg.isGenericParamOf
                tdecl: enclDecl9
                name: ptn.stringview
            ) then {
                skipParam = true
                genParam = true
            }
            if skipParam then {
                # A dropped RECEIVER still records its alias: the vtable
                # emitters and methodReceiverIsView ask which parameter is the
                # receiver, and on a bodyless spec this is the only chance.
                if isRecvP9 then {
                    # BIND the copy: an owned `String` return consumed inline
                    # has no scope to die in and leaks on every dropped
                    # receiver. The keep branch below binds `pname` for the
                    # same reason.
                    rcvNm9: zast.nameTextAt :ast ref: pm.name
                    (reg.setThisParamName
                        typeId: (ztypes.tid.create from: fid.u64)
                        nameId: (zast.poolSet pool: ast.names text: rcvNm9.stringview)
                    )
                    # ... and its MARKER. The name alone tells a caller which
                    # parameter is the receiver; only the ownership row tells
                    # it whether the call reads or writes, which is what
                    # methodReceiverIsView asks. A bodyless spec has no other
                    # chance to record it.
                    rcvOw9: pathOwnership :ast n: (ast.nodes.get i: pm.operation.u64)
                    match (
                        rcvOw9
                    ) case some then {
                        (ty.setChildOwnership
                            pool: ast.names
                            parentTypeId: (ztypes.tid.create from: fid.u64)
                            name: rcvNm9.stringview
                            ownership: rcvOw9
                        )
                    } case none then null
                }
                if fnParam9 then {
                    # the template's own param: bind the canonical
                    # per-(template,param) tid as the child so holder
                    # inference and the idSubs clone substitution ride it.
                    # No node stamp (fn monos re-walk the SHARED template
                    # AST) and no typeref/demand recording (a user type
                    # coincidentally named like the param must not bind).
                    fpt9: u64
                    fpo9: reg.genericParamTidOf tdecl: fnDecl9 paramName: ptn.stringview
                    match (
                        fpo9
                    ) case some then {
                        fpt9 = fpo9
                    } case none then {
                        fpt9 = (reg.newType
                            name: ptn.stringview
                            typetype: ztypes.ztypetype.genericParam
                        )
                        (reg.setGenericParamTid
                            tdecl: fnDecl9
                            paramName: ptn.stringview
                            tid: (ztypes.tid.create from: fpt9.u64)
                        )
                    }
                    (ty.setMemberType
                        parentTypeId: (ztypes.tid.create from: fid.u64)
                        nameId: pm.name
                        childTypeId: fpt9
                    )
                }
                if genParam then {
                    # the unit's own param: stamp the param node with the
                    # canonical per-(enclosing,param) tid (get-or-mint). No
                    # member type -- unit template methods stay childless (emit
                    # `(void)`); unit bodies clone, so the stamp is per-clone.
                    gpt2: u64
                    gpo2: reg.genericParamTidOf tdecl: enclDecl9 paramName: ptn.stringview
                    match (
                        gpo2
                    ) case some then {
                        gpt2 = gpo2
                    } case none then {
                        gpt2 = (reg.newType
                            name: ptn.stringview
                            typetype: ztypes.ztypetype.genericParam
                        )
                        (reg.setGenericParamTid
                            tdecl: enclDecl9
                            paramName: ptn.stringview
                            tid: (ztypes.tid.create from: gpt2.u64)
                        )
                    }
                    pnid2: nodeId n: (ast.nodes.get i: pm.operation.u64)
                    (ztyping.nodeTypeSet
                        tbl: ty.nodeType
                        nid: pnid2.u64
                        tid: (ztypes.tid.create from: gpt2.u64)
                    )
                    if thisName.length != 0 then {
                        (ty.setMemberType
                            parentTypeId: (ztypes.tid.create from: fid.u64)
                            nameId: pm.name
                            childTypeId: gpt2
                        )
                    }
                }
            } else {
                pname: zast.nameTextAt :ast ref: pm.name
                cid: (resolveTyperefShell
                    :ty
                    :reg
                    :ast
                    :unitDecl
                    typeExpr: (ast.nodes.get i: pm.operation.u64)
                    :thisName
                )
                (ty.setMemberType
                    parentTypeId: (ztypes.tid.create from: fid.u64)
                    nameId: pm.name
                    childTypeId: cid
                )
                if (isNumericLiteralName name: ptn.stringview) then {
                    (ty.setDefaultLiteral
                        pool: ast.names
                        parentTypeId: (ztypes.tid.create from: fid.u64)
                        name: pname.stringview
                        node: pm.operation
                    )
                } else {
                    fnRefIsFn9: false
                    fnRefOpt9: (walkLookupTyperef
                        :ast
                        :ty
                        :reg
                        :unitDecl
                        base: ptn.stringview
                    )
                    fnRefTid9: ztypes.tid
                    match (
                        fnRefOpt9
                    ) case some then {
                        if (reg.typetypeOf typeId: (ztypes.tid.create from: fnRefOpt9.u64)) == ztypes.ztypetype.functionType then {
                            fnRefIsFn9 = true
                            fnRefTid9 = ztypes.tid.create from: (fnRefOpt9)
                        }
                    } case none then null
                    if fnRefIsFn9 then {
                        (ty.setDefaultFunction
                            pool: ast.names
                            parentTypeId: (ztypes.tid.create from: fid.u64)
                            name: pname.stringview
                            targetDecl: (declOfTypeId
                                :reg
                                tid: (ztypes.tid.create from: fnRefTid9.u64)
                            )
                        )
                    } else {
                        pdcn9: dottedChildName :ast n: (ast.nodes.get i: pm.operation.u64)
                        if pdcn9.length > 0 when (isStripMarker name: pdcn9.stringview) == false then {
                            prn9: rootNameOf :ast n: (ast.nodes.get i: pm.operation.u64)
                            # a dotted numeric literal (0.u64) is a typed numeric
                            # default, not a variant arm (mirrors the field
                            # classifiers' rootNameOf guard)
                            if (isNumericLiteralName name: prn9.stringview) then {
                                (ty.setDefaultLiteral
                                    pool: ast.names
                                    parentTypeId: (ztypes.tid.create from: fid.u64)
                                    name: pname.stringview
                                    node: pm.operation
                                )
                            } else if (nameDenotesUnit :ty :reg nameId: (nameIdOf
                                :ast
                                name: prn9.stringview
                            )) == false then {
                                pArmNid9: zast.poolFind pool: ast.names text: pdcn9.stringview
                                pArmDecl9: (ty.declMemberIdOf
                                    parentTypeId: (ztypes.tid.create from: cid.u64)
                                    nameId: pArmNid9
                                )
                                (ty.setDefaultVariantArm
                                    pool: ast.names
                                    parentTypeId: (ztypes.tid.create from: fid.u64)
                                    name: pname.stringview
                                    targetDecl: pArmDecl9
                                )
                            }
                        }
                    }
                }
                if (paramIsThisReceiver :ast op: (ast.nodes.get i: pm.operation.u64)) then {
                    (reg.setThisParamName
                        typeId: (ztypes.tid.create from: fid.u64)
                        nameId: (zast.poolSet pool: ast.names text: pname.stringview)
                    )
                }
                (recordTyperef
                    :ty
                    :reg
                    :ast
                    :unitDecl
                    :thisName
                    node: (ast.nodes.get i: pm.operation.u64)
                )
                pown: pathOwnership :ast n: (ast.nodes.get i: pm.operation.u64)
                match (
                    pown
                ) case some then {
                    (ty.setChildOwnership
                        pool: ast.names
                        parentTypeId: (ztypes.tid.create from: fid.u64)
                        name: pname.stringview
                        ownership: pown
                    )
                } case none then {
                    isref: (paramIsBorrowReftype
                        :ast
                        :ty
                        :reg
                        :unitDecl
                        :thisName
                        op: (ast.nodes.get i: pm.operation.u64)
                    )
                    if isref then {
                        (ty.setChildOwnership
                            pool: ast.names
                            parentTypeId: (ztypes.tid.create from: fid.u64)
                            name: pname.stringview
                            ownership: ztypes.zparamownership.borrowMode
                        )
                    }
                }
            }
        } else null
    }
    demandReturnType :ty :ast :reg :unitDecl oId: fnode.returntype
    (recordReturnType
        :ty
        :reg
        :ast
        :unitDecl
        :thisName
        oId: fnode.returntype
    )
    recordFuncReturnNode :ast :ty fid: (ztypes.tid.create from: fid.u64) oId: fnode.returntype
    (stampGenericParamRef
        :ty
        :reg
        :ast
        enclDecl: enclDecl9
        oId: fnode.returntype
    )
    (recordGenericMarkerReturn
        :ty
        :reg
        :ast
        enclDecl: enclDecl9
        oId: fnode.returntype
    )
    rpt4: u64
    frOpt9: fnode.returntype
    if isgen then {
        rpt4 = returnParamTid :ast :reg enclDecl: fnDecl9 oId: frOpt9
    }
    if rpt4 == 0 then {
        frOpt9b: fnode.returntype
        rpt4 = returnParamTid :ast :reg enclDecl: enclDecl9 oId: frOpt9b
    }
    if rpt4 > 0 then {
        reg.setReturnType typeId: (ztypes.tid.create from: fid.u64) value: rpt4
        # a method whose return is a generic param (its own OR the enclosing
        # type's) is a per-instance clone candidate: mintMono's clone loop
        # (gated on isgeneric) must substitute the return for each mono
        reg.setGeneric typeId: (ztypes.tid.create from: fid.u64) value: true
    }
    if rpt4 == 0 when unitDecl == ty.collectionsUnitRoot then {
        # collection template methods declare composite parameterized returns
        # ((ListIter of: of).borrow); they resolve to partial specs so clones
        # heal through respecialize.
        prt4: (partialReturnTid
            :ty
            :reg
            :ast
            :unitDecl
            enclDecl: enclDecl9
            oId: fnode.returntype
        )
        if prt4 > 0 then reg.setReturnType typeId: (ztypes.tid.create from: fid.u64) value: prt4
    }
    if (returnHasBorrowMarker :ast oId: fnode.returntype) then {
        fbk: fid
        fbv: true
        ty.funcReturnsBorrow.set key: fbk value: fbv
        if (returnHasViewMarker :ast oId: fnode.returntype) then {
            fvk: fid
            fvv: true
            ty.funcReturnsView.set key: fvk value: fvv
        }
    }
    if (returnHasTakexMarker :ast oId: fnode.returntype) then {
        fxk: fid
        fxv: true
        ty.funcReturnsTakex.set key: fxk value: fxv
    }
    checkBorrowReturnLock :ast :ty :fnode :defName
    if (fnDecl9.isZero) == false then {
        ty.declSetType declId: fnDecl9 typeId: (ztypes.tid.create from: dfid.u64)
        reg.setDef typeId: (ztypes.tid.create from: dfid.u64) declId: fnDecl9
    }
    dfp9: false
    if (reg.defOf tid: (ztypes.tid.create from: dfid.u64)).u64 == 0 then dfp9 = true
    if dfp9 then {
        # neither a free-fn Decl nor a member Decl (a synthesized function
        # like a generic-unit template's flattened method): attribute it
        # to the unit's root Decl
        dfr9: unitDecl
        if (dfr9.isZero) == false then {
            reg.setDef typeId: (ztypes.tid.create from: dfid.u64) declId: dfr9
        }
    }
    ty.sigGenericDecl = sgkPrev9
    return rfid
}

# paramIsBorrowReftype -- the default-ownership rule for a parameter with no
# explicit suffix: user reftypes (and the borrow-default native reftypes /
# collections) borrow; native value views do not.
paramIsBorrowReftype: function {ast: Ast.view
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    unitDecl: ztypes.declid
    thisName: StringView
    op: Node.view
} out bool is {
    tn: atomName :ast n: op
    isref: false
    if tn.stringview == "this" then {
        isref = nameIsInUnitReftype :ast :ty :reg :unitDecl name: thisName
        if (isref) == false then {
            tk0: (zast.poolFind pool: ast.names text: thisName).u64
            rgo: ty.mainDefIsReftype.get key: tk0
            match (
                rgo
            ) case some then {
                isref = rgo
            } case none then null
        }
        if (isNativeValueView name: thisName) then isref = false
    } else {
        if tn.length == 0 then {
            base: paramTypeBaseName :ast :op
            isref = isBorrowReftypeCollection name: base.stringview
        } else {
            isref = nameIsInUnitReftype :ast :ty :reg :unitDecl name: tn.stringview
            tdu: definingUnitFor :ty :ast :unitDecl name: tn.stringview
            if (isBorrowNativeReftype name: tn.stringview) when tdu == ty.systemUnitRoot then {
                isref = true
            }
            if (isNativeValueView name: tn.stringview) when tdu == ty.systemUnitRoot then {
                isref = false
            }
        }
    }
    return isref
}

# resolveMethodFn -- resolve one record-method as-item (a namedoperation whose
# operation is a functiondef) into a qualified `{record}.{method}` FUNCTION type,
# `this` params bound to thisName (the record). Returns its type id, or none for a
# non-function as-item (tag spec / generic param), which the caller skips.
resolveMethodFn: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    ownerNameId: zast.nameid
    mname: StringView
    thisName: StringView
    op: Node
} out optionval u64 is {
    match (
        op
    ) case functiondef then {
        mid: (resolveFunction
            :ty
            :reg
            :ast
            :unitDecl
            :ownerNameId
            defName: mname
            fnode: op
            :thisName
            skipThisType: false
        )
        (ztyping.nodeTypeSet
            tbl: ty.nodeType
            nid: op.nodeid.u64
            tid: (ztypes.tid.create from: mid.u64)
        )
        return (optionval.some mid)
    } else {
        return (optionval.none u64)
    }
}

# resolveMethodFnLazy -- resolveMethodFn under the member-demand mode. The item
# is still reported AS a method, carrying no type yet; forceMemberDecl mints the
# signature when a consumer first needs it. `lazyOk` is false where the caller
# READS the returned id rather than only recording it -- a generic class's
# methods feed reg.setGeneric, and a unit template's feed declLinkTemplateMethod.
resolveMethodFnLazy: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    ownerNameId: zast.nameid
    mname: StringView
    thisName: StringView
    op: Node
    lazyOk: bool
} out optionval u64 is {
    if lazyOk when (ty.eagerAll) == false when (isFunctionDefOp :op) then {
        return (optionval.some 0.u64)
    }
    return (resolveMethodFn :ty :reg :ast :unitDecl :ownerNameId :mname :thisName :op)
}

# stampMemberSignature -- stamp a member's return and parameter type-refs.
# paramTypeId and methodReturnOf both read the node stamp first, and
# stampTyperefs has already run by the time a member resolves on demand, so
# without this every parameter -- `this` included -- binds to nothing.
# Idempotent: stampForcedTyperef skips a node that already carries a type.
stampMemberSignature: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    thisName: StringView
    ownerTid: u64
    fnNodeId: u32
    mid: u64
} is {
    # the member's type-refs resolve in its owner's frame
    prevFrame9: ty.curFrame
    {
        od9: declOfTypeId :reg tid: (ztypes.tid.create from: ownerTid.u64)
        if (od9.isZero) == false then ty.curFrame = od9
    }
    stampMemberSignatureIn :ty :reg :ast :unitDecl :thisName :ownerTid :fnNodeId :mid
    ty.curFrame = prevFrame9
}

stampMemberSignatureIn: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    thisName: StringView
    ownerTid: u64
    fnNodeId: u32
    mid: u64
} is {
    rn9: optU64Or o: (ty.funcReturnNode.get key: (ztypes.tid.create from: mid.u64)) d: 0
    stampForcedTyperef :ty :reg :ast :unitDecl :thisName nid: rn9
    if fnNodeId == 0 then return
    fnN9: ast.nodes.get i: fnNodeId.u64
    match (
        fnN9
    ) case functiondef then {
        with pit9: fnN9.parameters.iterate do for pId9: pit9 loop {
            pn9: ast.nodes.get i: pId9.u64
            if pn9.namedoperation then {
                pRoot9: rootNameOf :ast n: (ast.nodes.get i: pn9.operation.u64)
                if pRoot9.stringview == "this" then {
                    (ztyping.nodeTypeSet
                        tbl: ty.nodeType
                        nid: pn9.operation.u64
                        tid: (ztypes.tid.create from: ownerTid.u64)
                    )
                } else {
                    (stampForcedTyperef
                        :ty
                        :reg
                        :ast
                        :unitDecl
                        :thisName
                        nid: pn9.operation.u64
                    )
                }
            }
        }
    } else null
}

# forceMemberDecl -- resolve one member's signature on demand: the rung below
# descendNamed. The grey / done marks are read off the MEMBER's own Decl rather
# than its type's, because the conversion lattice cycles through members --
# u8's `.i128` names i128, whose `.u8` names u8 -- and a member reached while its
# owner is still resolving is not the owner's back-edge.
forceMemberDecl: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    memberDeclId: ztypes.declid
} out optionval u64 is {
    isM9: false
    have9: u64
    mnm9: u32
    mnd9: u32
    par9: ztypes.declid
    {
        mo9: ty.decls.get i: memberDeclId.u64
        if mo9.kind.methodDecl then isM9 = true
        have9 = mo9.typeId
        mnm9 = mo9.name
        mnd9 = mo9.node
        par9 = mo9.parent
    }
    if have9 > 0 then return (optionval.some have9)
    if (ty.declIsDefined declId: memberDeclId) then return (optionval.none u64)
    if (ty.declIsResolving declId: memberDeclId) then return (optionval.none u64)
    if mnd9 == 0 then return (optionval.none u64)
    otid9: u64
    onm9: u32
    {
        po9: ty.decls.get i: par9.u64
        otid9 = po9.typeId
        onm9 = po9.name
    }
    if otid9 == 0 then return (optionval.none u64)
    opId9: u32
    {
        nn9: ast.nodes.get i: mnd9.u64
        if nn9.namedoperation then opId9 = nn9.operation
    }
    if opId9 == 0 then return (optionval.none u64)
    un9: unitNameOfTid :ty :reg tid: (ztypes.tid.create from: otid9.u64)
    if un9.length == 0 then return (optionval.none u64)
    tn9: zast.poolTextAt pool: ast.names ref: (zast.nameid.create from: onm9)
    mn9: zast.poolTextAt pool: ast.names ref: (zast.nameid.create from: mnm9)
    ty.declSetResolving declId: memberDeclId mark: true
    mid9: (optionval.none u64)
    if isM9 then {
        mid9 = (resolveMethodFn
            :ty
            :reg
            :ast
            unitDecl: (unitDeclOfName :ty :ast name: un9.stringview)
            ownerNameId: (zast.nameid.create from: onm9)
            mname: mn9.stringview
            thisName: tn9.stringview
            op: (ast.nodes.get i: opId9.u64)
        )
    } else {
        # an as-block MARKER designates a type rather than declaring a field
        mid9 = (markerTargetId
            :ty
            :reg
            unitDecl: (unitDeclOfName :ty :ast name: un9.stringview)
            :ast
            op: (ast.nodes.get i: opId9.u64)
        )
    }
    ty.declSetResolving declId: memberDeclId mark: false
    ty.declSetDefined declId: memberDeclId
    match (
        mid9
    ) case some then null case none then null
    match (
        mid9
    ) case some then {
        if isM9 then (stampMemberSignature
            :ty
            :reg
            :ast
            unitDecl: (unitDeclOfName :ty :ast name: un9.stringview)
            thisName: tn9.stringview
            ownerTid: otid9
            fnNodeId: opId9
            mid: mid9
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: otid9.u64)
            nameId: (zast.nameid.create from: mnm9)
            childTypeId: mid9
        )
        return (optionval.some mid9)
    } case none then null
    return (optionval.none u64)
}

# stampForcedTyperef -- stamp one type-ref node that resolved AFTER stampTyperefs
# ran. recordFuncReturnNode routes a call site's return type through the node
# stamp, and stampTyperefs fills those before the body walk -- so a member forced
# DURING the body walk records its return type-ref too late and reads back as
# null. Mirrors that pass's success leg for the one node.
stampForcedTyperef: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    thisName: StringView
    nid: u64
} is {
    if nid == 0 then return
    # an ownership marker (`zlexer.Token.view`) is not part of the type.
    # paramTypeId peels it and reads the PARENT's stamp, so that is the node
    # to stamp -- stamping the marker node leaves the parameter untyped.
    tnid9: nid
    peel9: u64
    for peel9 < 4 loop {
        peel9 = peel9 + 1
        stop9: true
        {
            pk9: ast.nodes.get i: tnid9
            match (
                pk9
            ) case dottedpath then {
                mcn9: atomName :ast n: (ast.nodes.get i: pk9.child.u64)
                if (isStripMarker name: mcn9.stringview) then {
                    tnid9 = pk9.parent.u64
                    stop9 = false
                }
            } else null
        }
        if stop9 then peel9 = 4
    }
    if tnid9 == 0 then return
    if (ztyping.nodeTypeAt tbl: ty.nodeType nid: tnid9) > 0 when (ztyping.nodeTypeAt
        tbl: ty.nodeType
        :nid
    ) > 0 then return
    # the real resolver first: it handles a PARAMETERIZED type-expr
    # (`out (resultval t: u32 e: converror)`), where a base name would name the
    # TEMPLATE and stamping that is worse than not stamping at all.
    {
        rs9: (resolveTyperefShell
            :ty
            :reg
            :ast
            :unitDecl
            typeExpr: (ast.nodes.get i: tnid9)
            :thisName
        )
        if rs9 > 0 then {
            ztyping.nodeTypeSet tbl: ty.nodeType nid: tnid9 tid: (ztypes.tid.create from: rs9.u64)
            ztyping.nodeTypeSet tbl: ty.nodeType :nid tid: (ztypes.tid.create from: rs9.u64)
            return
        }
    }
    # a DOTTED return (`out zast.nodeid`) names its type in another unit, which
    # no single base name reaches
    {
        rootN9: rootNameOf :ast n: (ast.nodes.get i: tnid9)
        childN9: dottedChildName :ast n: (ast.nodes.get i: tnid9)
        if childN9.length > 0 when rootN9.length > 0 then {
            dd9: (descendNamed
                :ty
                :reg
                :ast
                unitDecl: (unitDeclOfName :ty :ast name: rootN9.stringview)
                name: childN9.stringview
            )
            if dd9 > 0 then {
                ztyping.nodeTypeSet tbl: ty.nodeType nid: tnid9 tid: dd9
                ztyping.nodeTypeSet tbl: ty.nodeType :nid tid: dd9
                return
            }
        }
    }
    # the base name: from the pending record when the demand pass saw this
    # node, else off the type-expr itself -- a member resolved on demand never
    # went through a pass that records one
    base9: String
    {
        pv9: ty.pendingTyperef.get key: tnid9
        match (
            pv9
        ) case some then {
            base9 = pv9.copy
        } case none then null
    }
    if base9.length == 0 then base9 = (baseTypeName :ast n: (ast.nodes.get i: tnid9))
    if base9.length == 0 then return
    r9: walkLookupTyperef :ast :ty :reg :unitDecl base: base9.stringview
    match (
        r9
    ) case some then {
        ztyping.nodeTypeSet tbl: ty.nodeType nid: tnid9 tid: (ztypes.tid.create from: r9.u64)
        ztyping.nodeTypeSet tbl: ty.nodeType :nid tid: (ztypes.tid.create from: r9.u64)
        return
    } case none then null
    # the name resolves nowhere because nothing ever demanded it: a member
    # resolved on demand can be the FIRST reference to a type, and the demand
    # fixpoint finished before the body walk. Descend into it here.
    dn9: descendNamed :ty :reg :ast :unitDecl name: base9.stringview
    if dn9 > 0 then {
        ztyping.nodeTypeSet tbl: ty.nodeType nid: tnid9 tid: dn9
        ztyping.nodeTypeSet tbl: ty.nodeType :nid tid: dn9
        return
    }
    r9b: walkLookupTyperef :ast :ty :reg :unitDecl base: base9.stringview
    match (
        r9b
    ) case some then {
        ztyping.nodeTypeSet tbl: ty.nodeType nid: tnid9 tid: (ztypes.tid.create from: r9b.u64)
        ztyping.nodeTypeSet tbl: ty.nodeType :nid tid: (ztypes.tid.create from: r9b.u64)
    } case none then null
}

# forceMemberOf -- the member `nameId` of `parentTypeId`, resolved if it is not
# yet. The by-NAME demand point: declChildOfId is a readonly view holding no
# registry and no ast, so it can never resolve anything itself -- every force
# sits in front of a lookup, never inside one.
forceMemberOf: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    parentTypeId: ztypes.tid
    nameId: zast.nameid
} is {
    if ty.eagerAll then return
    if nameId.isZero then return
    md9: ty.declMemberIdOf :parentTypeId :nameId
    if md9.isZero then return
    forceMemberDecl :ty :reg :ast memberDeclId: md9
}

# forceUnitDefMember -- force `unit.def.member` from ids. Body checking reaches
# a method by NAME rather than through a receiver's type, so it is the one
# demand point that cannot go through a tid.
forceUnitDefMember: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    defId: zast.nameid
    memberId: zast.nameid
} is {
    if ty.eagerAll then return
    dd9: declOfUnitDefIds :ty :unitDecl nameId: defId
    if dd9.isZero then return
    md9: ty.declFindChild parentDeclId: dd9 nameId: memberId
    if md9.isZero then return
    forceMemberDecl :ty :reg :ast memberDeclId: md9
}

# forceUnitDef -- resolve ONE top-level TYPE definition of a unit now, and
# answer its type id (0 when it does not resolve). Every other `force*` resolves
# a MEMBER, and every resolver of a DEFINITION is a whole-unit loop, so a caller
# holding a single member node -- the method walk -- had no way to say "resolve
# this owner first". It walked the bodies regardless, with the owner's Decl
# still carrying typeId 0: `this` typed as notype, so a correct body was
# REJECTED and a wrong return type was ACCEPTED, one per body shape. The probe
# it used (resolveUnitChild) cannot mint -- a probe reads what resolution left.
forceUnitDef: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    unitDecl: ztypes.declid
    memId9: u32
} out u64 is {
    nmId9: zast.nameid
    opId9: zast.nodeid
    {
        mm9: ast.nodes.get i: memId9.u64
        if mm9.namedoperation then {
            nmId9 = mm9.name
            opId9 = mm9.operation
        }
    }
    if nmId9.isZero then return 0
    uId9: unitNameIdOf :ty :unitDecl
    {
        got9: resolvedByIds :ast :ty unitDecl: (unitDeclOfNameId :ty nameId: uId9) name: nmId9
        match (
            got9
        ) case some then {
            return got9.u64
        } case none then null
    }
    if opId9.isZero then return 0
    # a TYPE only: a namespace, a template and a function each reach their own
    # resolver, and none of them owns the method bodies this guards.
    isObj9: false
    {
        oo9: ast.nodes.get i: opId9.u64
        if oo9.objectdef then isObj9 = true
    }
    if (isObj9) == false then return 0
    if (defWasResolved :ty :unitDecl nameId: nmId9) then return 0
    # re-entry: a method that constructs its own type walks back through here
    # while the definition is mid-resolution.
    if (ty.declIsResolving declId: (declOfUnitDefIds
        :ty
        unitDecl: (unitDeclOfNameId :ty nameId: uId9)
        nameId: nmId9
    )) then return 0
    dn9: zast.poolTextAt pool: ast.names ref: nmId9
    (resolveDef
        :ty
        :reg
        :ast
        :unitDecl
        defName: dn9.stringview
        defn: (ast.nodes.get i: opId9.u64)
    )
    ro9: resolvedByIds :ast :ty unitDecl: (unitDeclOfNameId :ty nameId: uId9) name: nmId9
    match (
        ro9
    ) case some then {
        return ro9.u64
    } case none then null
    return 0
}

# forceAllMembers -- every member signature of `tid`, in declaration order. The
# WALK demand point: a caller reading a member LIST (the mono clone, the
# emitter's member tables) cannot name what it has not seen, and an unresolved
# member carries no type so declChildWalk skips it silently.
forceAllMembers: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    tid: ztypes.tid
} is {
    if ty.eagerAll then return
    od9: ty.declIdOfType typeId: tid
    if od9.isZero then return
    n9: ty.declChildSlots declId: od9
    i9: u64
    for i9 < n9 loop {
        did9: ztypes.declid
        {
            oo9: ty.decls.get i: od9.u64
            ce9: oo9.children.get i: i9
            did9 = ce9.declId
        }
        i9 = i9 + 1
        if (did9.isZero) == false then {
            forceMemberDecl :ty :reg :ast memberDeclId: did9
        }
    }
}

# forceAllFields -- every FIELD signature of `tid`, in declaration order: the
# members a field walk consumes. A methodDecl is skipped unless it holds a
# function-pointer slot (an is-block `function {..} out T` with no body), which
# a field filter counts as a field. `fnptrField` is a declaration flag written
# before any signature resolves, so the test forces nothing itself. A method's
# own signature stays unresolved, and that is not a hole: a field filter admits
# a member only to find a FUNCTION type and drop it, which is exactly what it
# does with the type 0 an unresolved member carries.
forceAllFields: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    tid: ztypes.tid
} is {
    if ty.eagerAll then return
    od9: ty.declIdOfType typeId: tid
    if od9.isZero then return
    n9: ty.declChildSlots declId: od9
    i9: u64
    for i9 < n9 loop {
        did9: ztypes.declid
        {
            oo9: ty.decls.get i: od9.u64
            ce9: oo9.children.get i: i9
            did9 = ce9.declId
        }
        i9 = i9 + 1
        if (did9.isZero) == false then {
            want9: true
            {
                mo9: ty.decls.get i: did9.u64
                if mo9.kind.methodDecl when (mo9.fnptrField) == false then want9 = false
            }
            if want9 then {
                forceMemberDecl :ty :reg :ast memberDeclId: did9
            }
        }
    }
}

# functiondefIsNative -- an is-block method marked `is native` (no body to
# check or emit; its members come from the native materializer).
functiondefIsNative: function {op: Node.view} out bool is {
    match (
        op
    ) case functiondef then {
        return op.isNative
    } else {
        return false
    }
}

# isFunctionDefOp -- true when an is-block item's operation is a functiondef (a
# method), false for a field type-ref. Gates generic-class method production without
# resolving the function -- mirrors the oracle's isgeneric gate, which never builds a
# method FUNCTION type for a generic class (so no spurious collections FUNCTION row).
isFunctionDefOp: function {op: Node.view} out bool is {
    match (
        op
    ) case functiondef then {
        return true
    } else {
        return false
    }
}

# isInterfaceDefOp -- a facet or protocol definition. These resolve EAGERLY
# because another definition's conformance marker (`m: sizer`) is resolved by
# markerTargetId, which requires its target to be registered already, and
# nothing else demands an interface: a program may conform to a facet and
# never construct one. Without this the marker reports "Unknown type".
isInterfaceDefOp: function {op: Node.view} out bool is {
    match (
        op
    ) case objectdef then {
        match (
            op.kind
        ) case facetDef then {
            return true
        } case protocolDef then {
            return true
        } else {
            return false
        }
    } else {
        return false
    }
}

# resolveSpecFn -- resolve one facet/protocol is-block spec method (a namedoperation
# whose operation is a functiondef) into a qualified `{type}.{spec}` FUNCTION. Like
# resolveMethodFn but drops the `:this` receiver: a facet/protocol `this` resolves to
# nothing (the reference returns no type), so the spec keeps only its real params.
resolveSpecFn: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    ownerNameId: zast.nameid
    mname: StringView
    thisName: StringView
    op: Node
    skipThis: bool
} out optionval u64 is {
    match (
        op
    ) case functiondef then {
        sid: (resolveFunction
            :ty
            :reg
            :ast
            :unitDecl
            :ownerNameId
            defName: mname
            fnode: op
            :thisName
            skipThisType: skipThis
        )
        (ztyping.nodeTypeSet
            tbl: ty.nodeType
            nid: op.nodeid.u64
            tid: (ztypes.tid.create from: sid.u64)
        )
        return (optionval.some sid)
    } else {
        return (optionval.none u64)
    }
}

# markerTargetId -- the FACET/PROTOCOL type a conformance as-item points at
# (`m: measurable` / `myreader: Reader`), or none for a method / `create: null` /
# any other as-item. A marker is a reference: its target resolves on discovery,
# depth-first, before anything is asked of it -- the conformer's destructor
# follows the target's, which exists only once the target's body resolved, so
# the order the two are written in cannot decide it.
markerTargetId: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    ast: Ast.view
    op: Node.view
} out optionval u64 is {
    nameId9: atomNameId :ast n: op
    if nameId9.isZero then return (optionval.none u64)
    {
        mnm9: zast.poolTextAt pool: ast.names ref: nameId9
        duo9: definingUnitFor :ty :ast :unitDecl name: mnm9.stringview
        if (duo9.isZero) == false then {
            descendNamed :ty :reg :ast unitDecl: duo9 name: mnm9.stringview
        }
    }
    rr: (resolvedByIds
        :ast
        :ty
        :unitDecl
        name: nameId9
    )
    match (
        rr
    ) case some then {
        tt: reg.typetypeOf typeId: (ztypes.tid.create from: rr.u64)
        match (
            tt
        ) case facetType then {
            return (optionval.some rr)
        } case protocolType then {
            return (optionval.some rr)
        } case recordType then {
            return (optionval.some rr)
        } else {
            return (optionval.none u64)
        }
    } case none then {
        return (optionval.none u64)
    }
}

# eqNullOptOut -- true when a type's `as {}` block opts out of equality by
# declaring `==: null` or `!=: null` (mirrors the `create: null` opt-out): the
# record / variant synthetic `==` / `!=` is then suppressed, so a comparison on
# the type resolves no method and is a hard error.
# memberNullOptOut -- true when a type's `as {}` block defines `member` as
# `null`, the language's way of striking a compiler-provided member off a type.
# asDeclaresMember -- the as-block declares `member` as a real definition (not
# the `member: null` opt-out shell). The synthesised valtype defaults must
# YIELD to it: `hasEqIs` is computed from the IS-block alone, so a record whose
# `==` lives in its `as` block used to get a synthesised `==` minted on top of
# the author's, and the emitter picked the synthesised one -- the author's
# method compiled, linked, and was never called.
asDeclaresMember: function {
    ast: Ast.view
    asItems: (ListVal u32).view
    member: StringView
} out bool is {
    result: false
    with aiter: asItems.iterate do for amId9: aiter loop {
        am: ast.nodes.get i: amId9.u64
        match (
            am
        ) case namedoperation then {
            mn9: zast.nameTextAt :ast ref: am.name
            if mn9.stringview == member then {
                vn9: atomName :ast n: (ast.nodes.get i: am.operation.u64)
                if vn9.stringview != "null" then result = true
            }
        } else null
    }
    return result
}

memberNullOptOut: function {
    ast: Ast.view
    asItems: (ListVal u32).view
    member: StringView
} out bool is {
    result: false
    with aiter: asItems.iterate do for amId9: aiter loop {
        am: ast.nodes.get i: amId9.u64
        match (
            am
        ) case namedoperation then {
            mn9: zast.nameTextAt :ast ref: am.name
            if mn9.stringview == member then {
                vn9: atomName :ast n: (ast.nodes.get i: am.operation.u64)
                if vn9.stringview == "null" then result = true
            }
        } else null
    }
    return result
}

eqNullOptOut: function {ast: Ast.view asItems: (ListVal u32).view} out bool is {
    result: false
    with aiter: asItems.iterate do for amId9: aiter loop {
        am: ast.nodes.get i: amId9.u64
        match (
            am
        ) case namedoperation then {
            mn9: zast.nameTextAt :ast ref: am.name
            isEqNe9: false
            if mn9.stringview == "==" then isEqNe9 = true
            if mn9.stringview == "!=" then isEqNe9 = true
            if isEqNe9 then {
                vn9: atomName :ast n: (ast.nodes.get i: am.operation.u64)
                if vn9.stringview == "null" then result = true
            }
        } else null
    }
    return result
}

# attachMethods -- resolve an as-block's method items (namedoperation -> functiondef)
# as children of `parentId`, returning whether one is named `create` (so the caller
# skips the synth create). Takes the item list by value so its iterator's lock is
# released on return -- letting attachMarkers re-scan the same list (cf. resolveUnion).
attachMethods: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    defName: StringView
    parentId: ztypes.tid
    asItems: (ListVal u32).view
} out bool is {
    hasCreate: false
    # a generic template's methods are cloned BY ID into every instance
    # (mintMono reads a member list), so a template's signatures resolve eagerly
    agen9: hasGenericParam :ast items: asItems
    aiter: asItems.iterate
    for amId9: aiter loop {
        am: ast.nodes.get i: amId9.u64
        match (
            am
        ) case namedoperation then {
            mname: zast.nameTextAt :ast ref: am.name
            if mname.stringview == "create" then hasCreate = true
            {
                mop9: ast.nodes.get i: am.operation.u64
                match (
                    mop9
                ) case functiondef then {
                    checkBorrowReturnLock :ast :ty fnode: mop9 defName: mname.stringview
                    (checkTakexHonesty
                        :ty
                        :ast
                        fnode: mop9
                        thisTid: (ztypes.tid.create from: parentId.u64)
                        defName: mname.stringview
                    )
                } else null
            }
            mido: (resolveMethodFnLazy
                :ty
                :reg
                :ast
                :unitDecl
                ownerNameId: (nameIdOf :ast name: defName)
                mname: mname.stringview
                thisName: defName
                op: (ast.nodes.get i: am.operation.u64)
                lazyOk: (agen9) == false
            )
            match (
                mido
            ) case some then {
                (ty.setMemberType
                    parentTypeId: parentId
                    nameId: am.name
                    childTypeId: mido
                )
            } case none then {
                cn: atomName :ast n: (ast.nodes.get i: am.operation.u64)
                if (isNumericLiteralName name: cn.stringview) then {
                    # A static constant's child is a per-constant NULL-unit
                    # clone of the literal's default type: named through the
                    # type_children join, filtered from typed_nodes.
                    clname: "i64"
                    if (isFloatLiteralName name: cn.stringview) then clname = "f64"
                    cid: reg.newType name: clname typetype: ztypes.ztypetype.recordType
                    (ty.setMemberType
                        parentTypeId: parentId
                        nameId: am.name
                        childTypeId: cid
                    )
                    ty.markAsConstClone typeId: cid
                    cnid3: nodeId n: (ast.nodes.get i: am.operation.u64)
                    ztyping.nodeTypeSet tbl: ty.nodeType nid: cnid3.u64 tid: cid
                }
            }
            gfn: "\{defName}_\{mname}"
            (synthGeneratorForMethod
                :ty
                :reg
                :ast
                :unitDecl
                fnName: gfn.stringview
                thisName: defName
                op: (ast.nodes.get i: am.operation.u64)
            )
        } else null
    }
    return hasCreate
}

# attachMarkers -- resolve an as-block's facet/protocol conformance markers
# (`m: measurable` / `myreader: Reader`) as children of `parentId`, run AFTER the
# methods so markers take later positions. Returns whether any marker target owns a
# destructor (a protocol), so a class holder keeps its own.
# recordConformance -- record an impl-satisfies-spec conformance, but only when the
# spec resolves to a FACET or PROTOCOL (a RECORD marker like a numeric's `tag: tag` is a
# discriminator child, NOT a conformance). Mirrors _record_conformance (ztypecheck.py:3516);
# the helper C names (vtable/create/destroy/wrapper) are emitter-set and stay empty here.
recordConformance: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    implTypeId: u64
    specTypeId: u64
    label: StringView
} is {
    tt: reg.typetypeOf typeId: (ztypes.tid.create from: specTypeId.u64)
    recordIt: false
    isFacetC: false
    match (
        tt
    ) case facetType then {
        recordIt = true
        isFacetC = true
    } case protocolType then {
        recordIt = true
    } else null
    if recordIt then {
        cf: reg.newConformance :implTypeId :specTypeId :label isFacet: isFacetC
        ty.conformance.append cf
        # the vtable wrapper names every member the spec names, and it is
        # emitted from the conformance row rather than from a use site, so
        # nothing else would ever demand the impl's signatures
        forceAllMembers :ty :reg :ast tid: (ztypes.tid.create from: implTypeId.u64)
    }
}

# attach the ownership/lock markers stamped during resolution to a definition.
attachMarkers: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    parentId: u64
    asItems: (ListVal u32).view
} out bool is {
    needsDtor: false
    miter: asItems.iterate
    for mmId9: miter loop {
        mm: ast.nodes.get i: mmId9.u64
        match (
            mm
        ) case namedoperation then {
            cnm: atomName :ast n: (ast.nodes.get i: mm.operation.u64)
            # `tag: tag` is not a field of the numeric record that carries it:
            # it designates the discriminator STORAGE type so a sum type can
            # spell `u8.tag`. A program declaring no sum type never names it,
            # so it resolves when something does -- forceMemberDecl.
            lazyTag9: false
            if (ty.eagerAll) == false when cnm.stringview == "tag" then {
                mlbT9: zast.nameTextAt :ast ref: mm.name
                if mlbT9.stringview == "tag" then lazyTag9 = true
            }
            if (isNumericLiteralName name: cnm.stringview) == false when (lazyTag9) == false then {
                (recordTyperef
                    :ty
                    :reg
                    :ast
                    :unitDecl
                    thisName: ""
                    node: (ast.nodes.get i: mm.operation.u64)
                )
            }
            mtid: (optionval.none u64)
            if (lazyTag9) == false then mtid = (markerTargetId
                :ty
                :reg
                :unitDecl
                :ast
                op: (ast.nodes.get i: mm.operation.u64)
            )
            match (
                mtid
            ) case some then {
                mlbl: zast.nameTextAt :ast ref: mm.name
                (ty.setMemberType
                    parentTypeId: (ztypes.tid.create from: parentId.u64)
                    nameId: mm.name
                    childTypeId: mtid
                )
                if (reg.hasDestructorName typeId: (ztypes.tid.create from: mtid.u64)) then needsDtor = true
                (recordConformance
                    :ty
                    :reg
                    :ast
                    implTypeId: parentId
                    specTypeId: mtid
                    label: mlbl.stringview
                )
            } case none then {
                if (isLabelValue op: (ast.nodes.get i: mm.operation.u64)) then {
                    amlbl: zast.nameTextAt :ast ref: mm.name
                    amlid: (resolveAtomType
                        :ty
                        :reg
                        :ast
                        :unitDecl
                        nm: amlbl.stringview
                        thisName: ""
                    )
                    (ty.setMemberType
                        parentTypeId: (ztypes.tid.create from: parentId.u64)
                        nameId: mm.name
                        childTypeId: amlid
                    )
                    acf: (reg.newConformance
                        implTypeId: parentId
                        specTypeId: amlid
                        label: amlbl.stringview
                        isFacet: false
                    )
                    ty.conformance.append acf
                    # a LABEL marker (`:Text`) conforms without naming a spec
                    # member, and the vtable wrapper is emitted from this row
                    (forceAllMembers
                        :ty
                        :reg
                        :ast
                        tid: (ztypes.tid.create from: parentId.u64)
                    )
                }
            }
        } else null
    }
    return needsDtor
}

# dataOutTypeName -- the element-type name from a data block's optional `out T`
# (an atom type-expr), or "" when absent. The Option is BORROWED (param), never
# bound to a local: a bare bind would move the Option out of the shared AST node
# and free its payload, corrupting the later dump walk.
dataOutTypeName: function {ast: Ast.view oId: zast.nodeid} out String is {
    if oId.isZero then return "".string
    return (atomName :ast n: (ast.nodes.get i: oId.u64))
}

# resolveData -- resolve a data-block definition into a DATA type: one `literal_int`
# child per element (the element's own label when present, else its ordinal) plus a
# `tag` child typed `tag__{element-type}` -- the `out T` width when declared, else
# i64 -- mark it a non-valtype, then record its defining unit + `{unit}.{name}` view.
# Elements stay literal_int (coerced per use); typed / float elements arrive with the
# examples that exercise them.
resolveData: function {ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    defName: StringView
    dnode: zast.DataBlockData.view
} is {
    did: (declareCanonicalType
        :ast
        :ty
        :reg
        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.dataType
    )
    reg.setValtype typeId: (ztypes.tid.create from: did.u64) value: false
    litId: reg.literalIntTid
    ordinal: u64
    eiter: dnode.elements.iterate
    for elId9: eiter loop {
        nmRef9: zast.nameid
        isNo9: false
        opRef9: u32
        {
            el: ast.nodes.get i: elId9.u64
            match (
                el
            ) case namedoperation then {
                nmRef9 = el.name
                opRef9 = el.operation
                isNo9 = true
            } else null
        }
        if isNo9 then {
            mid9: nmRef9
            if nmRef9.isZero then {
                ord: "\{ordinal}"
                mid9 = ast.internString text: ord.stringview
            }
            (ty.setMemberType
                parentTypeId: (ztypes.tid.create from: did.u64)
                nameId: mid9
                childTypeId: litId
            )
            # The element's VALUE, recorded here rather than folded on demand:
            # it is the discriminator a tagged type using this block will be
            # emitted with, and a backend reading it has no unit to fold under.
            # A non-literal element records nothing and keeps its position.
            if opRef9 > 0 then {
                lt9: atomName :ast n: (ast.nodes.get i: opRef9.u64)
                if lt9.length > 0 then {
                    cv9: constLiteralValue name: lt9.stringview
                    if cv9.kind.ivalKind then {
                        (ty.setMemberConst
                            parentTypeId: (ztypes.tid.create from: did.u64)
                            nameId: mid9
                            value: cv9
                        )
                    }
                }
            }
        }
        ordinal = ordinal + 1
    }
    etn: dataOutTypeName :ast oId: dnode.outType
    tagName: "tag__i64".string
    if etn.length != 0 then tagName = "tag__\{etn.stringview}"
    tagId: (declareCanonicalType
        :ast
        :ty
        :reg
        unitDecl: ty.systemUnitRoot
        ownerNameId: zast.nameid
        name: tagName.stringview
        typetype: ztypes.ztypetype.recordType
    )
    (ty.declSynthMember
        parentTypeId: (ztypes.tid.create from: did.u64)
        nameId: zast.wkTag
        kind: ztyping.declkind.fieldDecl
    )
    (ty.setMemberType
        parentTypeId: (ztypes.tid.create from: did.u64)
        nameId: zast.wkTag
        childTypeId: tagId
    )
}

# isTypedefField -- true when a type-expr Node is an `X.typedef` dottedpath (the
# marker that makes a record a zero-overhead typedef wrapper). Matching the Node
# param narrows it cleanly.
isTypedefField: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case dottedpath then {
        cn: atomName :ast n: (ast.nodes.get i: n.child.u64)
        return (cn.stringview == "typedef")
    } else {
        return false
    }
}

# recordIsTypedef -- true when a record's `is` body carries a single `X.typedef`
# field. Such a record gets no field child and synthesizes `create`+`borrow`
# instead of `create`/`==`/`!=`.
recordIsTypedef: function {ast: Ast.view rnode: zast.ObjectDefData.view} out bool is {
    fiter: rnode.isItems.iterate
    for fmId9: fiter loop {
        fm: ast.nodes.get i: fmId9.u64
        match (
            fm
        ) case namedoperation then {
            if (isTypedefField :ast n: (ast.nodes.get i: fm.operation.u64)) then return true
        } else null
    }
    return false
}

# typedefFieldBaseName -- the base type name of an `X.typedef` field's `X`
# (e.g. `(List of: u8).typedef` -> "List"). Borrows the Node, never binds it (a
# bare bind would move the type-expr out of the shared AST).
typedefFieldBaseName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case dottedpath then {
        return (paramTypeBaseName :ast op: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# objectTypedefBase -- the base type name of an objectdef's single `X.typedef`
# field (the typedef wrapper base), or "" when the object is not a typedef.
objectTypedefBase: function {ast: Ast.view onode: zast.ObjectDefData.view} out String is {
    fiter: onode.isItems.iterate
    for fmId9: fiter loop {
        fm: ast.nodes.get i: fmId9.u64
        match (
            fm
        ) case namedoperation then {
            if (isTypedefField
                :ast
                n: (ast.nodes.get i: fm.operation.u64)
            ) then return (typedefFieldBaseName
                :ast
                n: (ast.nodes.get i: fm.operation.u64)
            )
        } else null
    }
    return "".string
}

# typedefFieldBaseTid -- the type id of an `X.typedef` field's `X`. A
# parameterized base (`(List of: u8).typedef`) resolves through the spec trie,
# which materializes the instance; a bare atom (`String.typedef`) resolves
# through the unit ladder. 0 when the node is not a typedef field or the base
# does not resolve.
typedefFieldBaseTid: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    n: Node.view
} out u64 is {
    match (
        n
    ) case dottedpath then {
        bn9: ast.nodes.get i: n.parent.u64
        mid9: (resolveMonoRefInline
            :ty
            :reg
            :ast
            :unitDecl
            thisName: ""
            enclDecl: ztypes.declid
            op: bn9
            nid: 0
        )
        if mid9 > 0 then return mid9
        an9: paramTypeBaseName :ast op: bn9
        if an9.length == 0 then return 0
        return (resolveAtomType :ty :reg :ast :unitDecl nm: an9.stringview thisName: "")
    } else {
        return 0
    }
}

# objectTypedefBaseTid -- the base type id of an objectdef's single `X.typedef`
# field, or 0 when the object is not a typedef.
objectTypedefBaseTid: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    onode: zast.ObjectDefData.view
} out u64 is {
    fiter: onode.isItems.iterate
    for fmId9: fiter loop {
        fm: ast.nodes.get i: fmId9.u64
        match (
            fm
        ) case namedoperation then {
            if (isTypedefField :ast n: (ast.nodes.get i: fm.operation.u64)) then {
                return (typedefFieldBaseTid
                    :ty
                    :reg
                    :ast
                    :unitDecl
                    n: (ast.nodes.get i: fm.operation.u64)
                )
            }
        } else null
    }
    return 0
}

# resolveRecord -- resolve a record ObjectDef into a RECORD valtype. A normal
# record: a child per field (field name -> type-ref shell), a child per as-block
# method, then synthesized `create`/`==`/`!=`. A typedef record (single
# `X.typedef` field): no field child, the methods, then `create`+`borrow`. Synth
# children are shallow FUNCTION shells (JOIN-only). Generics arrive later.
# fnFieldFlaggableName -- an is-block FUNCTION member that should become a struct
# fnptr slot (a spec field / method / method-ref), excluding the constructor and
# comparison synthetics so they stay free functions / ctors.
fnFieldFlaggableName: function {name: StringView} out bool is {
    if name == "create" then return false
    if name == "==" then return false
    if name == "!=" then return false
    if name == "borrow" then return false
    return true
}

# typeExprHasPrivate -- does a field's type expression carry a `.private` marker
# (`Container.private.lock`), i.e. is it a friend handle? Walks the dotted path
# (markers nest outermost-last: `((Container.private).lock)`).
typeExprHasPrivate: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case dottedpath then {
        cn9: atomName :ast n: (ast.nodes.get i: n.child.u64)
        if cn9.stringview == "private" then return true
        return (typeExprHasPrivate :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return false
    }
}

# materializeCreateParams -- give a synthesized `.create` one parameter per
# the type's data field, in declaration order, so the create method carries the
# signature the construction sugar validates and dispatches against. Mirrors
# dataFieldNames' field filter (fnptr fields + non-FUNCTION fields, excluding
# as-block const clones and conformance markers), and resolves exactly what
# that filter reads. The synth create keeps no
# funcReturnNode, so emission still routes it field-wise.
materializeCreateParams: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    typeTid: u64
    createId: u64
} is {
    # the synthesized constructor's parameters are this type's FIELDS, so an
    # unresolved fn-ptr field -- an is-block `function {..} out T` with no
    # body -- would be silently absent from the signature. A METHOD is never a
    # parameter, and forcing one only to drop it resolved every signature in
    # the member block: `StringView` reached `parseF16`/`parseF128` that way,
    # and through them f16 and f128, in every program ever compiled.
    forceAllFields :ty :reg :ast tid: (ztypes.tid.create from: typeTid.u64)
    # every field edge is written by now -- only the synthesized borrow / == /
    # != follow this call -- so settle the type here rather than waiting for
    # resolveDef's settle, which lands after the parameter order is decided
    mkNames8: (List String)
    with cfit8: ty.conformance.iterate do for crow8: cfit8 loop {
        if crow8.implTypeId == typeTid then mkNames8.append crow8.label.copy
    }
    fnameIds: (ListVal u64)
    ftypeIds: (ListVal u64)
    rowNids9: (ListVal u64)
    rowCtos9: (ListVal u64)
    ty.declMemberList ownerTid: (ztypes.tid.create from: typeTid.u64) names: rowNids9 tids: rowCtos9
    {
        {
            ri9: u64
            for ri9 < rowNids9.length loop {
                tcNameId9: rowNids9.get i: ri9
                cto: rowCtos9.get i: ri9
                ri9 = ri9 + 1
                inc: false
                fptr: false
                fptr = (ty.declIsFnptrFieldId
                    parentTypeId: (ztypes.tid.create from: typeTid.u64)
                    nameId: (zast.nameid.create from: tcNameId9.u32.orPanic)
                )
                if fptr then {
                    inc = true
                } else {
                    if cto > 0 when (reg.typetypeOf typeId: (ztypes.tid.create from: cto.u64)) != ztypes.ztypetype.functionType then {
                        isC: false
                        aco: ty.asConstClone.get key: cto
                        match (
                            aco
                        ) case some then {
                            isC = aco
                        } case none then null
                        isMk8: false
                        cnBm8: ast.names.texts.get i: tcNameId9.u64
                        mi8: u64
                        mn8: mkNames8.length
                        for mi8 < mn8 loop {
                            mv8: mkNames8.get i: mi8
                            if mv8.stringview == cnBm8.stringview then isMk8 = true
                            mi8 = mi8 + 1
                        }
                        if isC == false when isMk8 == false then inc = true
                    }
                }
                if inc then {
                    fnameIds.append tcNameId9
                    ftypeIds.append cto
                }
            }
        }
    }
    i9: u64
    for i9 < fnameIds.length loop {
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: createId.u64)
            nameId: (zast.nameid.create from: (fnameIds.get i: i9))
            childTypeId: (ftypeIds.get i: i9)
        )
        i9 = i9 + 1
    }
}

# scanVisibility -- one AST-only pass over a type's `public:` block filling two
# out-lists (with-scoped iterators, no lock outlives the scan): `excl` = pool
# ids of USER-declared members NOT in the block (empty when there is no block --
# the all-public default; synthesized members are never listed); `grants` = pool
# ids of fields whose declared type is a `.private` handle (independent of any
# `public:` block). The resolver applies both once the members are registered.
scanVisibility: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    onode: zast.ObjectDefData.view
    excl: (ListVal u64)
    grants: (ListVal u64)
} is {
    pubIds: (SetVal u64)
    memberIds: (SetVal u64)
    aliasPubRef: (ListVal u32)
    aliasIntRef: (ListVal u32)
    aliasLine: (ListVal u32)
    aliasCol: (ListVal u32)
    aliasNode: (ListVal u32)
    pubFound: false
    with aiter: onode.asItems.iterate do for aId9: aiter loop {
        an9: ast.nodes.get i: aId9.u64
        match (
            an9
        ) case namedoperation then {
            if (zast.unitOpKindIs :ast opId: an9.operation k: zast.unitkind.privateNs) then {
                (addResolveErrorH
                    :ty
                    nodeid: an9.nodeid
                    lineno: an9.lineno
                    colno: an9.colno
                    e: zast.err.typeError
                    msg: "`private:` cannot be redefined -- `private` always includes every field and method of the type".string
                    width: 7
                )
            }
            if (zast.unitOpKindIs :ast opId: an9.operation k: zast.unitkind.publicNs) then {
                pubFound = true
                op9: ast.nodes.get i: an9.operation.u64
                match (
                    op9
                ) case unitdef then {
                    with biter: op9.body.iterate do for bId9: biter loop {
                        bn9: ast.nodes.get i: bId9.u64
                        match (
                            bn9
                        ) case namedoperation then {
                            pubIds.add item: bn9.name.u64
                            bop9: ast.nodes.get i: bn9.operation.u64
                            match (
                                bop9
                            ) case labelvalue then null case atomid then {
                                # `alias: internal` renames when the exposed
                                # name differs from the member being exposed
                                if bn9.name != bop9.name then {
                                    aliasPubRef.append from: bn9.name
                                    aliasIntRef.append from: bop9.name
                                    aliasLine.append from: bn9.lineno
                                    aliasCol.append from: bn9.colno
                                    aliasNode.append from: bn9.nodeid.u32
                                }
                            } else {
                                (addResolveErrorH
                                    :ty
                                    nodeid: bn9.nodeid
                                    lineno: bn9.lineno
                                    colno: bn9.colno
                                    e: zast.err.typeError
                                    msg: "a public interface entry must be ':member' or 'alias: member'".string
                                    width: 1
                                )
                            }
                        } else null
                    }
                } else null
            }
        } else null
    }
    with fiter: onode.isItems.iterate do for fId9: fiter loop {
        fm9: ast.nodes.get i: fId9.u64
        match (
            fm9
        ) case namedoperation then {
            memberIds.add item: fm9.name.u64
            if (typeExprHasPrivate
                :ast
                n: (ast.nodes.get i: fm9.operation.u64)
            ) then grants.append from: fm9.name.u64
            if pubFound then {
                hasF9: pubIds.has item: fm9.name.u64
                if (hasF9) == false then excl.append from: fm9.name.u64
            }
        } else null
    }
    if (pubFound) == false then return
    with a2iter: onode.asItems.iterate do for a2Id9: a2iter loop {
        am9: ast.nodes.get i: a2Id9.u64
        match (
            am9
        ) case namedoperation then {
            skip9: false
            if (zast.unitOpKindIs :ast opId: am9.operation k: zast.unitkind.publicNs) then {
                skip9 = true
            }
            if (zast.unitOpKindIs :ast opId: am9.operation k: zast.unitkind.privateNs) then {
                skip9 = true
            }
            if (skip9) == false then {
                memberIds.add item: am9.name.u64
                hasM9: pubIds.has item: am9.name.u64
                if (hasM9) == false then excl.append from: am9.name.u64
            }
        } else null
    }
    # validate the rename aliases against the now-known member set, then install
    ax9: u64
    for ax9 < aliasPubRef.length loop {
        pRef9: aliasPubRef.get i: ax9
        iRef9: aliasIntRef.get i: ax9
        okAlias9: true
        if (memberIds.has item: iRef9.u64) == false then {
            iTxt9: zast.nameTextAt :ast ref: (zast.nameid.create from: iRef9.u32)
            (addResolveErrorH
                :ty
                nodeid: (zast.nodeid.create from: (aliasNode.get i: ax9))
                lineno: (aliasLine.get i: ax9)
                colno: (aliasCol.get i: ax9)
                e: zast.err.typeError
                msg: "public interface exposes '\{iTxt9}', which is not a member of this type"
                width: 1
            )
            okAlias9 = false
        }
        if okAlias9 when (memberIds.has item: pRef9.u64) then {
            pTxt9: zast.nameTextAt :ast ref: (zast.nameid.create from: pRef9.u32)
            (addResolveErrorH
                :ty
                nodeid: (zast.nodeid.create from: (aliasNode.get i: ax9))
                lineno: (aliasLine.get i: ax9)
                colno: (aliasCol.get i: ax9)
                e: zast.err.typeError
                msg: "public alias '\{pTxt9}' collides with a member of the same name"
                width: 1
            )
            okAlias9 = false
        }
        if okAlias9 then ty.renameSeen = true
        ax9 = ax9 + 1
    }
}

# applyGrantsPrivate -- mark each `.private`-typed field as a friend handle.
applyGrantsPrivate: function {ty: ztyping.ZTyping parentId: u64 grants: (ListVal u64)} is {
    gi9: u64
    gn9: grants.length
    for gi9 < gn9 loop {
        (ty.setChildGrantsPrivateId
            parentTypeId: (ztypes.tid.create from: parentId.u64)
            nameId: (zast.nameid.create from: (grants.get i: gi9))
        )
        gi9 = gi9 + 1
    }
}

# scanUnitVisibility -- restrict a file unit's public interface. A `public:`
# block lists the exposed top-level definitions; unlisted defs become private
# (E0101 when referenced from another unit) and `alias: internal` entries
# expose a def under a different public name. A unit exposes its members
# through its publicNs declaration subtree, exactly as a type does.
scanUnitVisibility: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    unitdefId: zast.nodeid
} is {
    pubIds: (SetVal u64)
    memberIds: (SetVal u64)
    memberNameList: (ListVal u64)
    aliasPubRef: (ListVal u32)
    aliasIntRef: (ListVal u32)
    aliasLine: (ListVal u32)
    aliasCol: (ListVal u32)
    aliasNode: (ListVal u32)
    pubFound: false
    bodyIds9: zast.unitBodyIdsAt :ast unitId: unitdefId
    with uit9: bodyIds9.iterate do for umId9: uit9 loop {
        um9: ast.nodes.get i: umId9.u64
        match (
            um9
        ) case namedoperation then {
            isPubU9: zast.unitOpKindIs :ast opId: um9.operation k: zast.unitkind.publicNs
            isPrivU9: (zast.unitOpKindIs
                :ast
                opId: um9.operation
                k: zast.unitkind.privateNs
            )
            if isPrivU9 then {
                (addResolveErrorH
                    :ty
                    nodeid: um9.nodeid
                    lineno: um9.lineno
                    colno: um9.colno
                    e: zast.err.typeError
                    msg: "`private:` cannot be redefined -- `private` always includes every definition of the unit".string
                    width: 7
                )
            }
            if isPubU9 then {
                uop9: ast.nodes.get i: um9.operation.u64
                match (
                    uop9
                ) case unitdef then {
                    pubFound = true
                    with ubit9: uop9.body.iterate do for ubId9: ubit9 loop {
                        ubn9: ast.nodes.get i: ubId9.u64
                        match (
                            ubn9
                        ) case namedoperation then {
                            pubIds.add item: ubn9.name.u64
                            ubop9: ast.nodes.get i: ubn9.operation.u64
                            match (
                                ubop9
                            ) case labelvalue then null case atomid then {
                                # `alias: member` renames a sibling; an atom
                                # that names no sibling is a definition of the
                                # block (`MAX: 10`), like any other shape
                                if ubn9.name != ubop9.name then {
                                    aliasPubRef.append from: ubn9.name
                                    aliasIntRef.append from: ubop9.name
                                    aliasLine.append from: ubn9.lineno
                                    aliasCol.append from: ubn9.colno
                                    aliasNode.append from: ubn9.nodeid
                                }
                            } else null
                        } else null
                    }
                } else null
            }
            if (isPubU9) == false when (isPrivU9) == false then {
                memberIds.add item: um9.name.u64
                memberNameList.append from: um9.name.u64
            }
        } else null
    }
    if (pubFound) == false then return
    emiU9: u64
    for emiU9 < memberNameList.length loop {
        mnidU9: memberNameList.get i: emiU9
        if (pubIds.has item: mnidU9) == false then ty.privacySeen = true
        emiU9 = emiU9 + 1
    }
    axU9: u64
    for axU9 < aliasPubRef.length loop {
        pRefU9: aliasPubRef.get i: axU9
        iRefU9: aliasIntRef.get i: axU9
        okU9: true
        # an atom naming no sibling is not a rename but a definition of the
        # block, resolved in the block's frame like any alias
        if (memberIds.has item: iRefU9.u64) == false then okU9 = false
        if okU9 when (memberIds.has item: pRefU9.u64) then {
            pTxtU9: zast.nameTextAt :ast ref: (zast.nameid.create from: pRefU9.u32)
            (addResolveErrorH
                :ty
                nodeid: (zast.nodeid.create from: (aliasNode.get i: axU9))
                lineno: (aliasLine.get i: axU9)
                colno: (aliasCol.get i: axU9)
                e: zast.err.typeError
                msg: "public alias '\{pTxtU9}' collides with a definition of the same name"
                width: 1
            )
            okU9 = false
        }
        if okU9 then ty.renameSeen = true
        axU9 = axU9 + 1
    }
}
# checkOneRequireBlock -- the schema for one `require:` block: it introduces a
# unit, declares at least one requirement, and every entry is a key the
# compiler consumes -- today only `library:`, whose value is a compile-time
# string. A key nothing reads would be silently ignored, so it is rejected.
# The block is read as what it is -- a nested unit -- through its Decl children
# and the constant its resolution folded, never off the AST: an entry may be
# computed from other definitions in the block, and only the ordinary
# machinery resolves those in dependency order.
checkOneRequireBlock: function {
    ty: ztyping.ZTyping
    ast: Ast
    declId: ztypes.declid
    libNid: zast.nameid
} is {
    rnode9q: u32
    isUnit9q: false
    rtid9q: ztypes.tid
    {
        dr9q: ty.decls.get i: declId.u64
        rnode9q = dr9q.node
        if dr9q.kind.unitDecl then isUnit9q = true
        rtid9q = dr9q.typeId
    }
    if rnode9q == 0 then return
    rline9q: u32
    rcol9q: u32
    {
        rn9q: ast.nodes.get i: rnode9q.u64
        rline9q = nodeLine n: rn9q
        rcol9q = nodeCol n: rn9q
    }
    if (isUnit9q) == false then {
        (addResolveErrorH
            :ty
            nodeid: (zast.nodeid.create from: rnode9q)
            lineno: rline9q
            colno: rcol9q
            e: zast.err.requireBlock
            msg: "'require:' must introduce a unit definition, e.g. `require: unit { library: \"m\" }`".string
            width: 7
        )
        return
    }
    nmem9q: ty.declChildSlots :declId
    if nmem9q == 0 then {
        (addResolveErrorH
            :ty
            nodeid: (zast.nodeid.create from: rnode9q)
            lineno: rline9q
            colno: rcol9q
            e: zast.err.requireBlock
            msg: "a 'require:' block must declare at least one requirement".string
            width: 7
        )
        return
    }
    i9q: u64
    for i9q < nmem9q loop {
        c9q: ty.declChildAt :declId index: i9q
        i9q = i9q + 1
        if (c9q.isZero) == false then {
            cnm9q: ty.declNameOf declId: c9q
            cnode9q: u32
            {
                cd9q: ty.decls.get i: c9q.u64
                cnode9q = cd9q.node
            }
            eline9q: rline9q
            ecol9q: rcol9q
            enid9q: (zast.nodeid.create from: rnode9q)
            if cnode9q > 0 then {
                cn9q: ast.nodes.get i: cnode9q.u64
                eline9q = nodeLine n: cn9q
                ecol9q = nodeCol n: cn9q
                enid9q = nodeId n: cn9q
            }
            if cnm9q == libNid.u32 then {
                # the value the block's own resolution folded. An entry the
                # evaluator already reported on -- a reached `error`, an
                # interpolation -- has said what is wrong, and "must evaluate
                # to a string" on top of that is noise.
                lv9q: ty.memberConstOf parentTypeId: rtid9q nameId: libNid
                if (lv9q.kind.svalKind) == false when (ty.isError) == false then {
                    (addResolveErrorH
                        :ty
                        nodeid: enid9q
                        lineno: eline9q
                        colno: ecol9q
                        e: zast.err.requireBlock
                        msg: "'library:' must evaluate to a string at compile time".string
                        width: 7
                    )
                }
            } else {
                kt9q: (zast.poolTextAt
                    pool: ast.names
                    ref: (zast.nameid.create from: cnm9q)
                )
                (addResolveErrorH
                    :ty
                    nodeid: enid9q
                    lineno: eline9q
                    colno: ecol9q
                    e: zast.err.requireBlock
                    msg: "unknown 'require:' entry '\{kt9q}' -- the compiler consumes only 'library:'"
                    width: 1
                )
            }
        }
    }
}

# requireLibraryOf9 -- the link library one demanded `require:` block names, ""
# when it names none. A pure read of the constant its resolution folded.
requireLibraryOf9: function {
    ty: ztyping.ZTyping.view
    declId: ztypes.declid
    libNid: zast.nameid
} out String is {
    lib9w: String
    rtid9w: ztypes.tid
    {
        dr9w: ty.decls.get i: declId.u64
        rtid9w = dr9w.typeId
    }
    if rtid9w.isZero then return lib9w
    v9w: ty.memberConstOf parentTypeId: rtid9w nameId: libNid
    if v9w.kind.svalKind then lib9w = constStringAt :ty id: v9w.strId
    return lib9w
}

# requiredLibs -- the link libraries the program's reached units declare. A
# `require:` block applies only when the program reaches its unit, and
# ZTyping.requireDemanded IS that set: a block is demanded by the first
# declaration resolved from its unit and by nothing else, so it cannot light
# its own unit.
requiredLibs: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    program: Node
} out List String is {
    reg
    libs9w: (List String)
    match (
        program
    ) case program then {
        libNid9w: zast.poolFind pool: program.ast.names text: "library"
        if libNid9w.isZero then return libs9w
        with rit9w: ty.requireDemanded.iterate do for rq9w: rit9w loop {
            lib9x: requireLibraryOf9 :ty declId: rq9w libNid: libNid9w
            if lib9x.length > 0 then {
                dup9w: false
                with dit9w: libs9w.iterate do for e9w: dit9w loop {
                    if e9w.stringview == lib9x.stringview then dup9w = true
                }
                if (dup9w) == false then libs9w.append from: lib9x.copy
            }
        }
    } else null
    return libs9w
}

# checkRequireBlocks -- the schema check for every `require:` block the program
# demanded. A block in a unit nothing reached is never resolved and so has no
# claim to make about this program; the linter is what checks code a program
# does not use.
checkRequireBlocks: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    program: Node
} is {
    reg
    match (
        program
    ) case program then {
        libNid9q: zast.poolFind pool: program.ast.names text: "library"
        if libNid9q.isZero then return
        rqs9q: (ListVal ztypes.declid)
        with cit9q: ty.requireDemanded.iterate do for r9q: cit9q loop rqs9q.append from: r9q
        with qit9q: rqs9q.iterate do for rq9q: qit9q loop {
            prevFrame9: ty.curFrame
            ty.curFrame = declParentIdOf :ty declId: rq9q
            (checkOneRequireBlock
                :ty
                ast: program.ast
                declId: rq9q
                libNid: libNid9q
            )
            ty.curFrame = prevFrame9
        }
    } else null
}

# applyUnitVisibility -- run scanUnitVisibility for every file unit that
# declares a `public:` block, after all unit members are registered.
applyUnitVisibility: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    program: Node
} is {
    match (
        program
    ) case program then {
        uCntV9: program.ast.units.length
        uIdxV9: u64
        for uIdxV9 < uCntV9 loop {
            uIdV9: (zast.nodeid.create from: (program.ast.units.get i: uIdxV9))
            uIdxV9 = uIdxV9 + 1
            opIdV9: zast.nodeid
            nmV9: String
            {
                ruV9: program.ast.nodes.get i: uIdV9.u64
                if ruV9.namedoperation then {
                    nmt9: zast.poolTextAt pool: program.ast.names ref: ruV9.name
                    opIdV9 = ruV9.operation
                    nmV9 = nmt9.copy
                }
            }
            if opIdV9 > 0 then {
                utidV9: ztypes.tid
                {
                    uidoV9: (declTypeIdOf
                        :ty
                        declId: (ty.declFindChild
                            parentDeclId: ty.programRoot
                            nameId: (nameIdOf ast: program.ast name: nmV9.stringview)
                        )
                    )
                    if (uidoV9.isZero) == false then utidV9 = uidoV9
                }
                if utidV9 > 0 then {
                    (scanUnitVisibility
                        :ty
                        ast: program.ast
                        unitdefId: opIdV9
                    )
                    # the entry `main` of the primary unit must stay public:
                    # a `public:` block that omits it hides the entry point
                    if nmV9.stringview == program.mainUnitName.stringview then {
                        if (declMemberIsPrivate
                            :ty
                            :reg
                            tid: (ztypes.tid.create from: utidV9.u64)
                            nameId: (program.ast.names.find s: "main")
                        ) then {
                            mnid9: zast.nodeid
                            mnln9: u32
                            mncl9: u32
                            {
                                mIds9: zast.unitBodyIdsAt ast: program.ast unitId: opIdV9
                                mref9: program.ast.names.find s: "main"
                                with mit9: mIds9.iterate do for mid9: mit9 loop {
                                    mn9: program.ast.nodes.get i: mid9.u64
                                    match (
                                        mn9
                                    ) case namedoperation then {
                                        if mn9.name == mref9 when mref9 > 0 then {
                                            mnid9 = mn9.nodeid
                                            mnln9 = mn9.lineno
                                            mncl9 = mn9.colno
                                        }
                                    } else null
                                }
                            }
                            mmsg9: "the entry 'main' must be public".string
                            if mnid9 > 0 then {
                                (addResolveErrorH
                                    :ty
                                    nodeid: mnid9
                                    lineno: mnln9
                                    colno: mncl9
                                    e: zast.err.notPublic
                                    msg: mmsg9
                                    width: 4
                                )
                            } else {
                                addResolveError :ty e: zast.err.notPublic msg: mmsg9
                            }
                        }
                    }
                }
            }
        }
    } else null
}

# resolve a record definition: its fields and methods.
resolveRecord: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    rnode: zast.ObjectDefData
} is {
    rid: (declareCanonicalType
        :ast
        :ty
        :reg
        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.recordType
    )
    rrid: rid
    # `record is native` on the TYPE: the runtime supplies the layout, so
    # routing can ask the declaration whether a type is runtime-backed instead
    # of comparing its name. Mirrors resolveClass.
    reg.setNative typeId: (ztypes.tid.create from: rid.u64) value: rnode.isNative
    pvExcl_rrid: (ListVal u64)
    pvGrants_rrid: (ListVal u64)
    scanVisibility :ty :ast onode: rnode excl: pvExcl_rrid grants: pvGrants_rrid
    reg.setValtype typeId: (ztypes.tid.create from: rid.u64) value: true
    isgen: hasGenericParam :ast items: rnode.asItems
    eqOptR9: eqNullOptOut :ast asItems: rnode.asItems
    eqAsR9: asDeclaresMember :ast asItems: rnode.asItems member: "=="
    # `copy: null` strikes the default byte copy off this type. It is recorded
    # as a member carrying the null shell so the use site can tell it from a
    # type that simply never mentioned `copy`.
    if (memberNullOptOut :ast asItems: rnode.asItems member: "copy") then {
        ty.copyOptOut.add item: rid
    }
    if isgen then {
        reg.setGeneric typeId: (ztypes.tid.create from: rid.u64) value: true
        (registerGenericParams
            :ast
            :reg
            tdecl: (declOfUnitDef :ty :ast :unitDecl name: defName)
            items: rnode.asItems
        )
    }
    istd: recordIsTypedef :ast :rnode
    if istd then {
        tdb: objectTypedefBase :ast onode: rnode
        if tdb.length > 0 then {
            tdk: rid
            ty.typedefBaseName.set key: tdk value: tdb
        }
        tdt: objectTypedefBaseTid :ty :reg :ast :unitDecl onode: rnode
        if tdt > 0 then {
            tdk5: rid
            (ty.typedefBaseTid.set
                key: (ztypes.tid.create from: tdk5.u64)
                value: (ztypes.tid.create from: tdt.u64)
            )
        }
    }
    hasCreateIs: false
    hasEqIs: false
    if (istd) == false then {
        fiter: rnode.isItems.iterate
        for fmId9: fiter loop {
            fm: ast.nodes.get i: fmId9.u64
            match (
                fm
            ) case namedoperation then {
                fname: zast.nameTextAt :ast ref: fm.name
                mido: (resolveMethodFnLazy
                    :ty
                    :reg
                    :ast
                    :unitDecl
                    ownerNameId: (nameIdOf :ast name: defName)
                    mname: fname.stringview
                    thisName: defName
                    op: (ast.nodes.get i: fm.operation.u64)
                    lazyOk: (isgen) == false
                )
                match (
                    mido
                ) case some then {
                    if fname.stringview == "create" then hasCreateIs = true
                    if fname.stringview == "==" then hasEqIs = true
                    (ty.setMemberType
                        parentTypeId: (ztypes.tid.create from: rid.u64)
                        nameId: fm.name
                        childTypeId: mido
                    )
                    if (fnFieldFlaggableName name: fname.stringview) then {
                        (ty.setChildFnptrField
                            pool: ast.names
                            parentTypeId: (ztypes.tid.create from: rid.u64)
                            name: fname.stringview
                        )
                    }
                } case none then {
                    ftnR9: fieldHeadName :ast n: (ast.nodes.get i: fm.operation.u64)
                    # a field's type-ref can name a SIBLING method (an fn-ptr
                    # slot defaulting to it), which is a member like any other
                    (forceMemberOf
                        :ty
                        :reg
                        :ast
                        parentTypeId: (ztypes.tid.create from: rid.u64)
                        nameId: (zast.poolFind pool: ast.names text: ftnR9.stringview)
                    )
                    mrefR9: (resolvedByIdsMember
                        :ast
                        :ty
                        :unitDecl
                        defId: (zast.poolFind pool: ast.names text: defName)
                        memberId: (zast.poolFind pool: ast.names text: ftnR9.stringview)
                    )
                    handledR9: false
                    match (
                        mrefR9
                    ) case some then {
                        (ty.setMemberType
                            parentTypeId: (ztypes.tid.create from: rid.u64)
                            nameId: fm.name
                            childTypeId: mrefR9
                        )
                        if (reg.typetypeOf typeId: (ztypes.tid.create from: mrefR9.u64)) == ztypes.ztypetype.functionType then {
                            (ty.setChildFnptrField
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: rid.u64)
                                name: fname.stringview
                            )
                        }
                        pdkR9: nodeId n: (ast.nodes.get i: fm.operation.u64)
                        pdoR9: rid
                        ty.pendingDefaultOwner.set key: pdkR9.u64 value: pdoR9
                        pdk2R9: nodeId n: (ast.nodes.get i: fm.operation.u64)
                        pdiR9: mrefR9
                        ty.pendingDefaultId.set key: pdk2R9.u64 value: pdiR9
                        handledR9 = true
                    } case none then null
                    if (handledR9) == false then {
                        cid: (resolveTyperefShellMarked
                            :ty
                            :reg
                            :ast
                            :unitDecl
                            ownerId: 0
                            typeExpr: (ast.nodes.get i: fm.operation.u64)
                            thisName: defName
                        )
                        (ty.setMemberType
                            parentTypeId: (ztypes.tid.create from: rid.u64)
                            nameId: fm.name
                            childTypeId: cid
                        )
                        if (reg.typetypeOf typeId: cid) == ztypes.ztypetype.functionType then {
                            (ty.setChildFnptrField
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: rid.u64)
                                name: fname.stringview
                            )
                        }
                        (recordTyperef
                            :ty
                            :reg
                            :ast
                            :unitDecl
                            thisName: ""
                            node: (ast.nodes.get i: fm.operation.u64)
                        )
                        dcn1: dottedChildName :ast n: (ast.nodes.get i: fm.operation.u64)
                        rdnr: rootNameOf :ast n: (ast.nodes.get i: fm.operation.u64)
                        if (isNumericLiteralName name: rdnr.stringview) then {
                            (ty.setDefaultLiteral
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: rid.u64)
                                name: fname.stringview
                                node: fm.operation
                            )
                        } else {
                            if dcn1.length > 0 when (isStripMarker name: dcn1.stringview) == false when (nameDenotesUnit
                                :ty
                                :reg
                                nameId: (nameIdOf
                                :ast
                                name: rdnr.stringview
                            )
                            ) == false then {
                                rArmNid9: zast.poolFind pool: ast.names text: dcn1.stringview
                                rArmDecl9: ty.declMemberIdOf parentTypeId: cid nameId: rArmNid9
                                (ty.setDefaultVariantArm
                                    pool: ast.names
                                    parentTypeId: (ztypes.tid.create from: rid.u64)
                                    name: fname.stringview
                                    targetDecl: rArmDecl9
                                )
                            }
                        }
                        if dcn1.length > 0 when (isStripMarker name: dcn1.stringview) then {} else {
                            if dcn1.length > 0 then {
                                rdk3: nodeId n: (ast.nodes.get i: fm.operation.u64)
                                rdo3: rid
                                ty.pendingDefaultOwner.set key: rdk3.u64 value: rdo3
                                rdk4: nodeId n: (ast.nodes.get i: fm.operation.u64)
                                rdn4: rootNameOf :ast n: (ast.nodes.get i: fm.operation.u64)
                                ty.pendingDefaultName.set key: rdk4.u64 value: rdn4
                            }
                        }
                    }
                }
            } else null
        }
    }
    hasCreateAs: (attachMethods
        :ty
        :reg
        :ast
        :unitDecl
        :defName
        parentId: (ztypes.tid.create from: rid.u64)
        asItems: rnode.asItems
    )
    hasCreate: hasCreateIs
    if hasCreateAs then hasCreate = true
    attachMarkers :ty :reg :ast :unitDecl parentId: rid asItems: rnode.asItems
    if (hasCreate) == false then {
        createId: reg.newType name: "create" ownerTid: rid typetype: ztypes.ztypetype.functionType
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: rid.u64)
            nameId: zast.wkCreate
            kind: ztyping.declkind.methodDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: rid.u64)
            nameId: zast.wkCreate
            childTypeId: createId
        )
        materializeCreateParams :ty :reg :ast typeTid: rid :createId
    }
    if istd then {
        borrowId: reg.newType name: "borrow" ownerTid: rid typetype: ztypes.ztypetype.functionType
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: rid.u64)
            nameId: zast.wkBorrow
            kind: ztyping.declkind.methodDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: rid.u64)
            nameId: zast.wkBorrow
            childTypeId: borrowId
        )
    } else {
        if (isgen) == false then {
            if (hasEqIs) == false when (eqOptR9) == false when (eqAsR9) == false then {
                eqId: reg.newType name: "==" ownerTid: rid typetype: ztypes.ztypetype.functionType
                (ty.declSynthMember
                    parentTypeId: (ztypes.tid.create from: rid.u64)
                    nameId: zast.wkOpEq
                    kind: ztyping.declkind.methodDecl
                )
                (ty.setMemberType
                    parentTypeId: (ztypes.tid.create from: rid.u64)
                    nameId: zast.wkOpEq
                    childTypeId: eqId
                )
                neqId: reg.newType name: "!=" ownerTid: rid typetype: ztypes.ztypetype.functionType
                (ty.declSynthMember
                    parentTypeId: (ztypes.tid.create from: rid.u64)
                    nameId: zast.wkOpNe
                    kind: ztyping.declkind.methodDecl
                )
                (ty.setMemberType
                    parentTypeId: (ztypes.tid.create from: rid.u64)
                    nameId: zast.wkOpNe
                    childTypeId: neqId
                )
            }
        }
    }
    # `hash` is INDEPENDENT of whether `==` was synthesised -- a type that
    # declares its own `==` (every numeric does) still hashes by its bytes.
    # It exists unless the author struck it off with a null shell or wrote
    # their own, and a heap-owning value has no byte range to hash, so it gets
    # none and is simply not Hashable.
    hshOptR9: memberNullOptOut :ast asItems: rnode.asItems member: "hash"
    hshAsR9: asDeclaresMember :ast asItems: rnode.asItems member: "hash"
    if (isgen) == false when hshOptR9 == false when hshAsR9 == false then {
        hshR9: reg.newType name: "hash" ownerTid: rid typetype: ztypes.ztypetype.functionType
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: rid.u64)
            nameId: zast.wkHash
            kind: ztyping.declkind.methodDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: rid.u64)
            nameId: zast.wkHash
            childTypeId: hshR9
        )
    }
    if pvExcl_rrid.length > 0 then ty.privacySeen = true
    applyGrantsPrivate :ty parentId: rrid grants: pvGrants_rrid
}

# resolveVariant -- resolve a variant ObjectDef into a VARIANT valtype: a child per
# arm (arm name -> payload type-ref shell; a `null` arm -> the `null` shell), a
# synthesized `tag` child (the `{name}:tag:data` discriminator wrapper), any as-block
# methods, then synthesized `==`/`!=`. Variants have no `create` (bare construction is
# disabled). Custom-DATA tags + generics arrive later.
# detectTagAccessor -- a non-function variant/union as-item of the form
# `name: <numeric>.tag` declares the read-only tag accessor: instances
# expose the discriminator ordinal as the numeric type under that name.
detectTagAccessor: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    defName: StringView
    ownerId: u64
    armNames: Set String
    am: zast.NamedOperationData.view
} is {
    tp9: dottedParentName :ast n: (ast.nodes.get i: am.operation.u64)
    tc9: dottedChildName :ast n: (ast.nodes.get i: am.operation.u64)
    if tc9.stringview != "tag" then return
    if (isNumericTypeName name: tp9.stringview) == false then return
    mname9: zast.nameTextAt :ast ref: am.name
    nid9: (resolveTyperefShellMarked
        :ty
        :reg
        :ast
        :unitDecl
        ownerId: 0
        typeExpr: (ast.nodes.get i: am.operation.u64)
        thisName: defName
    )
    if nid9.isZero then return
    if (armNames.has item: mname9) then {
        mac9: "'\{mname9}' collides with the '\{defName}' arm of the same name"
        (addResolveErrorH
            :ty
            nodeid: am.nodeid
            lineno: am.lineno
            colno: am.colno
            e: zast.err.duplicateDef
            msg: mac9
            width: mname9.length.u32.orPanic
        )
        return
    }
    man9: mname9.copy
    ty.tagAccessorName.set key: ownerId value: man9
    ty.tagAccessorTid.set key: (ztypes.tid.create from: ownerId.u64) value: nid9
}

# resolve a variant definition: its arms and methods.
resolveVariant: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    defName: StringView
    vnode: zast.ObjectDefData
} is {
    vid: (declareCanonicalType
        :ast
        :ty
        :reg
        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.variantType
    )
    vvid: vid
    # `variant is native` on the TYPE: the runtime supplies the layout, so
    # routing can ask the declaration rather than compare a name. Mirrors
    # resolveRecord and resolveClass.
    reg.setNative typeId: (ztypes.tid.create from: vid.u64) value: vnode.isNative
    pvExcl_vvid: (ListVal u64)
    pvGrants_vvid: (ListVal u64)
    scanVisibility :ty :ast onode: vnode excl: pvExcl_vvid grants: pvGrants_vvid
    reg.setValtype typeId: (ztypes.tid.create from: vid.u64) value: true
    isgen: hasGenericParam :ast items: vnode.asItems
    eqOptV9: eqNullOptOut :ast asItems: vnode.asItems
    eqAsV9: asDeclaresMember :ast asItems: vnode.asItems member: "=="
    if (memberNullOptOut :ast asItems: vnode.asItems member: "copy") then {
        ty.copyOptOut.add item: vid
    }
    if isgen then {
        reg.setGeneric typeId: (ztypes.tid.create from: vid.u64) value: true
        (registerGenericParams
            :ast
            :reg
            tdecl: (declOfUnitDef :ty :ast :unitDecl name: defName)
            items: vnode.asItems
        )
    }
    armNames9: (Set String)
    # an ORDINAL variant: every arm written `null`, so nothing distinguishes one
    # value but which arm it is. Recorded for the backend at the end of the loop.
    allNullV9: true
    armCountV9: u64
    firstArmV9: u64
    secondArmV9: u64
    fiter: vnode.isItems.iterate
    for fmId9: fiter loop {
        fm: ast.nodes.get i: fmId9.u64
        match (
            fm
        ) case namedoperation then {
            aname: zast.nameTextAt :ast ref: fm.name
            armCountV9 = armCountV9 + 1
            if armCountV9 == 1 then firstArmV9 = fm.name.u64
            if armCountV9 == 2 then secondArmV9 = fm.name.u64
            {
                anV9: atomName :ast n: (ast.nodes.get i: fm.operation.u64)
                if anV9.stringview != "null" then allNullV9 = false
            }
            if aname.stringview == "tag" then {
                mt9: "'tag' is a reserved member name".string
                (addResolveErrorH
                    :ty
                    nodeid: fm.nodeid
                    lineno: fm.lineno
                    colno: fm.colno
                    e: zast.err.reservedMember
                    msg: mt9
                    width: 3
                )
            }
            armNames9.add item: aname.copy
            cid: (resolveTyperefShellMarked
                :ty
                :reg
                :ast
                :unitDecl
                ownerId: 0
                typeExpr: (ast.nodes.get i: fm.operation.u64)
                thisName: defName
            )
            (ty.setMemberType
                parentTypeId: (ztypes.tid.create from: vid.u64)
                nameId: fm.name
                childTypeId: cid
            )
            (recordTyperef
                :ty
                :reg
                :ast
                :unitDecl
                thisName: ""
                node: (ast.nodes.get i: fm.operation.u64)
            )
        } else null
    }
    # Both arm names of a 2-arm sum, whatever the arms carry and whether or not
    # the type is generic: a template's arms ARE its monos'.
    #
    # Positional: which of these is the FALSY arm is a separate question, asked
    # of the discriminator by ztyping.sumPairZeroArm.
    if armCountV9 == 2 then {
        ty.sumPairFirstArm.set key: vid.u64 value: firstArmV9
        ty.sumPairSecondArm.set key: vid.u64 value: secondArmV9
    }
    if (isgen) == false then {
        customTagV: unionCustomTagId :ast :ty :reg :unitDecl uid: vid asItems: vnode.asItems
        tagId: u64
        match (
            customTagV
        ) case some then {
            tagId = customTagV
        } case none then {
            tagName: "\{defName}:tag:data"
            tagId = reg.newType name: tagName.stringview typetype: ztypes.ztypetype.dataType
        }
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: vid.u64)
            nameId: zast.wkTag
            kind: ztyping.declkind.fieldDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: vid.u64)
            nameId: zast.wkTag
            childTypeId: tagId
        )
        # the discriminator's declared storage, so a backend can honour it
        {
            tbV9: (variantTagBaseTid
                :ast
                :ty
                :reg
                :unitDecl
                asItems: vnode.asItems
            )
            if tbV9 != 18446744073709551615.u64 then ty.variantTagBase.set key: vid.u64 value: tbV9
        }
        # the shape, for whatever backend reads it: every arm written `null`,
        # so the value is an ordinal and nothing needs a tagged struct -- and a
        # discriminator whose values ARE those ordinals.
        if allNullV9 when armCountV9 > 0 then {
            if (variantTagIsOrdinalPlain
                :ast
                :ty
                :reg
                :unitDecl
                asItems: vnode.asItems
            ) then {
                ty.ordinalVariant.set key: vid.u64 value: armCountV9
            }
        }
    }
    aiter: vnode.asItems.iterate
    for amId9: aiter loop {
        am: ast.nodes.get i: amId9.u64
        match (
            am
        ) case namedoperation then {
            mname: zast.nameTextAt :ast ref: am.name
            mido: (resolveMethodFnLazy
                :ty
                :reg
                :ast
                :unitDecl
                ownerNameId: (nameIdOf :ast name: defName)
                mname: mname.stringview
                thisName: defName
                op: (ast.nodes.get i: am.operation.u64)
                lazyOk: (isgen) == false
            )
            match (
                mido
            ) case some then {
                if (armNames9.has item: mname) then {
                    mc9: "'\{mname}' collides with the '\{defName}' arm of the same name"
                    (addResolveErrorH
                        :ty
                        nodeid: am.nodeid
                        lineno: am.lineno
                        colno: am.colno
                        e: zast.err.duplicateDef
                        msg: mc9
                        width: mname.length.u32.orPanic
                    )
                } else if mname.stringview == "tag" then {
                    mr9: "'tag' is a reserved member name".string
                    (addResolveErrorH
                        :ty
                        nodeid: am.nodeid
                        lineno: am.lineno
                        colno: am.colno
                        e: zast.err.reservedMember
                        msg: mr9
                        width: 3
                    )
                } else {
                    (ty.setMemberType
                        parentTypeId: (ztypes.tid.create from: vid.u64)
                        nameId: am.name
                        childTypeId: mido
                    )
                }
            } else {
                if (isgen) == false then {
                    (detectTagAccessor
                        :ty
                        :reg
                        :ast
                        :unitDecl
                        :defName
                        ownerId: vid
                        armNames: armNames9
                        :am
                    )
                }
            }
        } else null
    }
    # a variant that writes its own `==` keeps it: the synthesised pair is the
    # DEFAULT, and a default yields to a declaration, exactly as resolveRecord
    # yields through eqAsR9 and as `hash` yields three lines below. Without
    # this the synthesised marker overwrites the declared method's type, and
    # the registry then answers that `bool`'s native `==` is a structural
    # compare that no runtime supplies.
    if (isgen) == false when (eqOptV9) == false when (eqAsV9) == false then {
        eqId: reg.newType name: "==" ownerTid: vid typetype: ztypes.ztypetype.functionType
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: vid.u64)
            nameId: zast.wkOpEq
            kind: ztyping.declkind.methodDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: vid.u64)
            nameId: zast.wkOpEq
            childTypeId: eqId
        )
        neqId: reg.newType name: "!=" ownerTid: vid typetype: ztypes.ztypetype.functionType
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: vid.u64)
            nameId: zast.wkOpNe
            kind: ztyping.declkind.methodDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: vid.u64)
            nameId: zast.wkOpNe
            childTypeId: neqId
        )
    }
    # `hash` on the same terms as `==` above (see resolveRecord).
    hshOptV9: memberNullOptOut :ast asItems: vnode.asItems member: "hash"
    hshAsV9: asDeclaresMember :ast asItems: vnode.asItems member: "hash"
    if (isgen) == false when hshOptV9 == false when hshAsV9 == false then {
        hshV9: reg.newType name: "hash" ownerTid: vid typetype: ztypes.ztypetype.functionType
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: vid.u64)
            nameId: zast.wkHash
            kind: ztyping.declkind.methodDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: vid.u64)
            nameId: zast.wkHash
            childTypeId: hshV9
        )
    }
    if pvExcl_vvid.length > 0 then ty.privacySeen = true
    applyGrantsPrivate :ty parentId: vvid grants: pvGrants_vvid
}

# dottedParentName -- the parent atom name of a `parent.child` dottedpath Node, ""
# for anything else. Matching the Node param narrows it cleanly.
# variantTagIsOrdinalPlain -- the discriminator's VALUES are the arm ordinals
# 0, 1, 2 ... stored in a byte, which is what lets a backend treat the value as
# the ordinal itself. True when the type declares no tag -- the spec's default
# is u8, sequential from 0 -- or declares a numeric tag whose storage is u8.
#
# False for a `data`-sourced tag, whose constants are whatever the data block
# says: `data { LOW: 0  HIGH: 10 }` has two arms and is NOT two ordinals. False
# too for a wider declared numeric, where the author asked for that width. And
# false when the tag base does not resolve, because an unverified shape is not
# one to optimise on.
#
# Found by the `.tag` SUFFIX rather than the member's label: the spec makes the
# label convention only ("commonly tag, but any name is valid").
# variantTagBaseTid -- the NUMERIC type a tagged type's discriminator is stored
# in: the base of a declared `tag: X.tag`, or u8 when none is declared, which is
# the spec's default (§tag: "If no tag is specified, the compiler uses u8 by
# default with sequential values starting from 0"). 0 when the tag is
# `data`-sourced -- its constants are whatever the data block says, so its width
# is that block's business -- or when the base does not resolve.
#
# Recorded so a backend can honour what the declaration asked for. Emitting the
# discriminator as a C `enum` ignores it: an enum is `int`, so `tag: u8.tag`
# silently became four bytes.
variantTagBaseTid: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    asItems: (ListVal u32).view
} out u64 is {
    # the "no entry" signal, distinct from 0 (a data-sourced tag, whose
    # constants set their own width and whose enum must stay the storage)
    notRecorded9: 18446744073709551615.u64
    declared9: u64
    sawTag9: false
    with iter9: asItems.iterate do for amId9: iter9 loop {
        am9: ast.nodes.get i: amId9.u64
        match (
            am9
        ) case namedoperation then {
            op9: ast.nodes.get i: am9.operation.u64
            isTagRef9: false
            match (
                op9
            ) case dottedpath then {
                cn9: atomName :ast n: (ast.nodes.get i: op9.child.u64)
                if cn9.stringview == "tag" then isTagRef9 = true
            } else null
            if isTagRef9 then {
                sawTag9 = true
                bn9: dottedParentName :ast n: op9
                if bn9.length > 0 then {
                    rr9: (walkLookupTyperef
                        :ast
                        :ty
                        :reg
                        :unitDecl
                        base: bn9.stringview
                    )
                    match (
                        rr9
                    ) case some then {
                        if (reg.typetypeOf typeId: (ztypes.tid.create from: rr9.u64)) == ztypes.ztypetype.dataType then {
                            declared9 = 0
                        } else {
                            declared9 = rr9
                        }
                    } case none then null
                }
            }
        } else null
    }
    # NOT RECORDED when nothing is declared: the spec's default is u8, and the
    # backend can spell that without being told. Resolving u8's id here would be
    # a demand made during resolution, which need not be satisfiable yet -- and
    # when it was not, every tagged type silently fell back to the enum.
    if (sawTag9) == false then return notRecorded9
    return declared9
}

variantTagIsOrdinalPlain: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    asItems: (ListVal u32).view
} out bool is {
    result: true
    with iter9: asItems.iterate do for amId9: iter9 loop {
        am9: ast.nodes.get i: amId9.u64
        match (
            am9
        ) case namedoperation then {
            op9: ast.nodes.get i: am9.operation.u64
            isTagRef9: false
            match (
                op9
            ) case dottedpath then {
                cn9: atomName :ast n: (ast.nodes.get i: op9.child.u64)
                if cn9.stringview == "tag" then isTagRef9 = true
            } else null
            if isTagRef9 then {
                bn9: dottedParentName :ast n: op9
                if bn9.length == 0 then {
                    result = false
                } else {
                    rr9: (walkLookupTyperef
                        :ast
                        :ty
                        :reg
                        :unitDecl
                        base: bn9.stringview
                    )
                    match (
                        rr9
                    ) case some then {
                        if (reg.typetypeOf typeId: (ztypes.tid.create from: rr9.u64)) == ztypes.ztypetype.dataType then {
                            result = false
                        } else {
                            u8t9: builtinTidT :ast :ty :reg base: "u8"
                            if u8t9.isZero then result = false
                            if (u8t9.isZero) == false when rr9 != u8t9.u64 then result = false
                        }
                    } case none then {
                        result = false
                    }
                }
            }
        } else null
    }
    return result
}

dottedParentName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (dottedParentName :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (atomName :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# dottedTyperefId -- the type id of a cross-unit qualified type ref `unit.Type`
# (e.g. the `zvfs.ProviderBox` element of a `(List of: zvfs.ProviderBox)`),
# resolved through the defining unit's scope. Bare-name visibility covers only
# main+system, so a dep element misses there; this bridges via the unit probe
# plus resolved. 0 when not a dotted ref or unresolved.
dottedTyperefId: function {ast: Ast.view st: zenv.ZSymbolTable op: Node.view} out u64 is {
    match (
        op
    ) case expression then {
        return (dottedTyperefId :ast :st op: (ast.nodes.get i: op.expression.u64))
    } case dottedpath then {
        pnId9: atomNameId :ast n: (ast.nodes.get i: op.parent.u64)
        cnId9: atomNameId :ast n: (ast.nodes.get i: op.child.u64)
        if (nameDenotesUnit ty: st.typing reg: st.reg nameId: pnId9) then {
            uq0z9: unitDeclOfNameId ty: st.typing nameId: pnId9
            ro: (resolvedByIds
                :ast
                ty: st.typing

                unitDecl: uq0z9
                name: cnId9
            )
            return (optU64Or o: ro d: 0)
        } else {
            return 0
        }
    } else {
        return 0
    }
}

# unionCustomTagId -- a union's custom DATA tag, if any: an `as { tag: <data>.tag }`
# item whose `<data>` resolves to an in-unit DATA type. Returns that DATA's type id;
# none when absent or not a DATA (the union then synthesizes its own tag wrapper).
unionCustomTagId: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    uid: u64
    asItems: (ListVal u32).view
} out optionval u64 is {
    iter: asItems.iterate
    for amId9: iter loop {
        am: ast.nodes.get i: amId9.u64
        match (
            am
        ) case namedoperation then {
            nm: zast.nameTextAt :ast ref: am.name
            if nm.stringview == "tag" then {
                pn: dottedParentName :ast n: (ast.nodes.get i: am.operation.u64)
                if pn.length != 0 then {
                    rr: walkLookupTyperef :ast :ty :reg :unitDecl base: pn.stringview
                    match (
                        rr
                    ) case some then {
                        tt: reg.typetypeOf typeId: (ztypes.tid.create from: rr.u64)
                        isdata: false
                        match (
                            tt
                        ) case dataType then {
                            isdata = true
                        } else null
                        if isdata then {
                            return (optionval.some rr)
                        } else {
                            # the reference stamps only the main unit's
                            # custom-tag items (system variants resolve
                            # standalone, unstamped).
                            if unitDecl == ty.mainUnitRoot then {
                                tgo: (resolvedByIds
                                    :ast
                                    :ty
                                    unitDecl: (unitDeclOfNameId
                                        :ty
                                        nameId: (nameIdOf :ast name: "system")
                                    )
                                    name: (zast.poolFind pool: ast.names text: "tag")
                                )
                                match (
                                    tgo
                                ) case some then {
                                    tnid0: (innermostNodeId
                                        :ast
                                        n: (ast.nodes.get i: am.operation.u64)
                                    )
                                    (ztyping.nodeTypeSet
                                        tbl: ty.nodeType
                                        nid: tnid0.u64
                                        tid: (ztypes.tid.create from: tgo.u64)
                                    )
                                } case none then null
                            }
                        }
                    } case none then {
                        # the tag base resolves later (demand order): record
                        # the demand and a pending fixup for the tag child.
                        (demandDefinition
                            :ty
                            frame: (unitFrameOf :ty declId: ty.curFrame)
                            nameId: (zast.poolFind pool: ast.names text: pn.stringview)
                        )
                        uk: uid
                        pv: pn.copy
                        ty.pendingCustomTag.set key: uk value: pv
                        uk2: uid
                        pnid9: innermostNodeId :ast n: (ast.nodes.get i: am.operation.u64)
                        pnv9: pnid9.u64
                        ty.pendingCustomTagNode.set key: uk2 value: pnv9
                    }
                }
            }
        } else null
    }
    return (optionval.none u64)
}

# resolveUnion -- resolve a union ObjectDef into a UNION reference type: a child
# per arm (arm name -> payload type-ref shell; a `null` arm -> the `null` shell),
# a synthesized `tag` child (the `{name}:tag:data` discriminator wrapper), then any
# as-block methods. Unions are reference types (is_valtype false); they have no
# `create` (bare construction is disabled) and no `==`/`!=`. A union keeps a
# destructor unless every arm is `null` (Priority elides it; IntResult/Result/Typed
# keep it). A custom DATA tag (`as { tag: <data>.tag }`) becomes the `tag` child in
# place of the synth wrapper; generics arrive later.
resolveUnion: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    vnode: zast.ObjectDefData
} is {
    uid: (declareCanonicalType
        :ast
        :ty
        :reg
        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.unionType
    )
    uuid: uid
    pvExcl_uuid: (ListVal u64)
    pvGrants_uuid: (ListVal u64)
    scanVisibility :ty :ast onode: vnode excl: pvExcl_uuid grants: pvGrants_uuid
    reg.setValtype typeId: (ztypes.tid.create from: uid.u64) value: false
    isgen: hasGenericParam :ast items: vnode.asItems
    if isgen then {
        reg.setGeneric typeId: (ztypes.tid.create from: uid.u64) value: true
        (registerGenericParams
            :ast
            :reg
            tdecl: (declOfUnitDef :ty :ast :unitDecl name: defName)
            items: vnode.asItems
        )
    }
    allNull: true
    armCountU9: u64
    firstArmU9: u64
    secondArmU9: u64
    armNames9: (Set String)
    fiter: vnode.isItems.iterate
    for fmId9: fiter loop {
        fm: ast.nodes.get i: fmId9.u64
        match (
            fm
        ) case namedoperation then {
            aname: zast.nameTextAt :ast ref: fm.name
            if aname.stringview == "tag" then {
                mt9: "'tag' is a reserved member name".string
                (addResolveErrorH
                    :ty
                    nodeid: fm.nodeid
                    lineno: fm.lineno
                    colno: fm.colno
                    e: zast.err.reservedMember
                    msg: mt9
                    width: 3
                )
            }
            armNames9.add item: aname.copy
            armCountU9 = armCountU9 + 1
            if armCountU9 == 1 then firstArmU9 = fm.name.u64
            if armCountU9 == 2 then secondArmU9 = fm.name.u64
            an: atomName :ast n: (ast.nodes.get i: fm.operation.u64)
            if an.stringview != "null" then allNull = false
            # A `(Box T)` arm collapses to T: the arm child IS the boxed
            # valtype. A union arm is heap-celled whichever family it holds,
            # so the spelling changes no emitted C; it exists so the
            # declaration SAYS the arm boxes a valtype. Only the builtin Box
            # (empty generic class body) collapses; a user class named Box
            # resolves as an ordinary parameterized arm.
            armTe9: fm.operation
            armOpId9: fm.operation
            armW9: true
            for armW9 loop {
                armW9 = false
                {
                    awn9: ast.nodes.get i: armOpId9.u64
                    match (
                        awn9
                    ) case expression then {
                        armOpId9 = awn9.expression
                        armW9 = true
                    } else null
                }
            }
            {
                acn9: ast.nodes.get i: armOpId9.u64
                match (
                    acn9
                ) case call then {
                    bxh9: atomName :ast n: (ast.nodes.get i: acn9.callable.u64)
                    if bxh9.stringview == "Box" then {
                        bxt9: (optU64Or
                            o: (walkLookupTyperef :ast :ty :reg :unitDecl base: "Box")
                            d: 0)
                        isBx9: false
                        if bxt9 > 0 then {
                            if (reg.typetypeOf typeId: (ztypes.tid.create from: bxt9.u64)) == ztypes.ztypetype.classType then {
                                if (ty.declMemberCount ownerTid: (ztypes.tid.create from: bxt9.u64)) == 0 then isBx9 = true
                            }
                        }
                        if isBx9 then {
                            baiter9: acn9.arguments.iterate
                            for baId9: baiter9 loop {
                                ba9: ast.nodes.get i: baId9.u64
                                match (
                                    ba9
                                ) case namedoperation then {
                                    if armTe9 == fm.operation then armTe9 = ba9.operation
                                } else null
                            }
                        }
                    }
                } else null
            }
            cid: (resolveTyperefShellMarked
                :ty
                :reg
                :ast
                :unitDecl
                ownerId: 0
                typeExpr: (ast.nodes.get i: armTe9.u64)
                thisName: defName
            )
            if armTe9 != fm.operation then {
                if (typeIsValtype :ty :reg tid: cid) == false then {
                    bxw9: atomName :ast n: (ast.nodes.get i: armTe9.u64)
                    mbx9: "'\{bxw9}' is already a reftype; a union arm holds it directly -- drop the Box"
                    (addResolveErrorH
                        :ty
                        nodeid: fm.nodeid
                        lineno: fm.lineno
                        colno: fm.colno
                        e: zast.err.typeError
                        msg: mbx9
                        width: aname.length.u32.orPanic
                    )
                }
            }
            (ty.setMemberType
                parentTypeId: (ztypes.tid.create from: uid.u64)
                nameId: fm.name
                childTypeId: cid
            )
            # An arm's marker is the payload's, not the union's: the shell
            # resolve above strips it, so record it per member the way a class
            # field does. `view` / `hold` are what a match arm reads back.
            alk9: pathOwnership :ast n: (ast.nodes.get i: fm.operation.u64)
            armMk9: false
            match (
                alk9
            ) case some then {
                armMk9 = true
                (ty.setChildOwnership
                    pool: ast.names
                    parentTypeId: (ztypes.tid.create from: uid.u64)
                    name: aname.stringview
                    ownership: alk9
                )
            } case none then null
            # THE BOX RULE: a union holds reftypes. A null arm carries no
            # payload; a MARKED arm (view/borrow/hold) is reference-family
            # whatever it points at; a collapsed (Box T) arm was already
            # vetted valtype. What remains must be a reftype.
            if an.stringview != "null" when armTe9 == fm.operation then {
                if (armMk9) == false when (typeIsValtype :ty :reg tid: cid) then {
                    bxv9: atomName :ast n: (ast.nodes.get i: armTe9.u64)
                    mbv9: "a union arm holds reftypes; box the valtype: '\{aname}: (Box \{bxv9})'"
                    (addResolveErrorH
                        :ty
                        nodeid: fm.nodeid
                        lineno: fm.lineno
                        colno: fm.colno
                        e: zast.err.typeError
                        msg: mbv9
                        width: aname.length.u32.orPanic
                    )
                }
            }
            (recordTyperef
                :ty
                :reg
                :ast
                :unitDecl
                thisName: ""
                node: (ast.nodes.get i: armTe9.u64)
            )
        } else null
    }
    # both arm names of a 2-arm sum -- the union half of the same record the
    # variant resolver writes. Option and Result are the reason it exists.
    if armCountU9 == 2 then {
        ty.sumPairFirstArm.set key: uid.u64 value: firstArmU9
        ty.sumPairSecondArm.set key: uid.u64 value: secondArmU9
    }
    if (isgen) == false then {
        # the discriminator's declared storage, so a backend can honour it
        {
            tbU9: (variantTagBaseTid
                :ast
                :ty
                :reg
                :unitDecl
                asItems: vnode.asItems
            )
            if tbU9 != 18446744073709551615.u64 then ty.variantTagBase.set key: uid.u64 value: tbU9
        }
        customTag: unionCustomTagId :ast :ty :reg :unitDecl :uid asItems: vnode.asItems
        tagId: u64
        match (
            customTag
        ) case some then {
            tagId = customTag
        } case none then {
            tagName: "\{defName}:tag:data"
            tagId = reg.newType name: tagName.stringview typetype: ztypes.ztypetype.dataType
        }
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: uid.u64)
            nameId: zast.wkTag
            kind: ztyping.declkind.fieldDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: uid.u64)
            nameId: zast.wkTag
            childTypeId: tagId
        )
    }
    aiter: vnode.asItems.iterate
    for amId9: aiter loop {
        am: ast.nodes.get i: amId9.u64
        match (
            am
        ) case namedoperation then {
            mname: zast.nameTextAt :ast ref: am.name
            mido: (resolveMethodFnLazy
                :ty
                :reg
                :ast
                :unitDecl
                ownerNameId: (nameIdOf :ast name: defName)
                mname: mname.stringview
                thisName: defName
                op: (ast.nodes.get i: am.operation.u64)
                lazyOk: (isgen) == false
            )
            match (
                mido
            ) case some then {
                if (armNames9.has item: mname) then {
                    mc9: "'\{mname}' collides with the '\{defName}' arm of the same name"
                    (addResolveErrorH
                        :ty
                        nodeid: am.nodeid
                        lineno: am.lineno
                        colno: am.colno
                        e: zast.err.duplicateDef
                        msg: mc9
                        width: mname.length.u32.orPanic
                    )
                } else if mname.stringview == "tag" then {
                    mr9: "'tag' is a reserved member name".string
                    (addResolveErrorH
                        :ty
                        nodeid: am.nodeid
                        lineno: am.lineno
                        colno: am.colno
                        e: zast.err.reservedMember
                        msg: mr9
                        width: 3
                    )
                } else {
                    (ty.setMemberType
                        parentTypeId: (ztypes.tid.create from: uid.u64)
                        nameId: am.name
                        childTypeId: mido
                    )
                }
            } else {
                if (isgen) == false then {
                    (detectTagAccessor
                        :ty
                        :reg
                        :ast
                        :unitDecl
                        :defName
                        ownerId: uid
                        armNames: armNames9
                        :am
                    )
                }
            }
        } else null
    }
    if (allNull) == false then {
        dn: "\{defName}_destroy"
        (reg.setDestructorName
            typeId: (ztypes.tid.create from: uid.u64)
            nameId: (zast.poolSet pool: ast.names text: dn.stringview)
        )
    }
    if pvExcl_uuid.length > 0 then ty.privacySeen = true
    applyGrantsPrivate :ty parentId: uuid grants: pvGrants_uuid
}

# fieldTypeNeedsCleanup -- true when a class field needs cleanup (so the holder keeps
# a destructor): a `.lock` field (its borrow is released at scope exit), a native heap
# type (String/List/Map/Set), or an in-unit type that itself HAS a destructor
# (`reg.hasDestructorName`). A scalar field, or an owned class/union field whose type
# has no destructor, needs none. Name check for the natives is a scaffold-stage
# approximation (system types carry no real id under resolve-only-main).
fieldTypeNeedsCleanup: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    name: StringView
    isLock: bool
} out bool is {
    if isLock then return true
    if name == "String" then return true
    if name == "List" then return true
    if name == "ListRef" then return true
    if name == "ListVal" then return true
    if name == "Map" then return true
    if name == "MapRR" then return true
    if name == "MapRV" then return true
    if name == "MapVR" then return true
    if name == "MapVV" then return true
    if name == "Set" then return true
    if name == "SetRef" then return true
    if name == "SetVal" then return true
    if name == "Option" then return true
    if name == "Result" then return true
    duo8: definingUnitFor :ty :ast :unitDecl :name
    if (duo8.isZero) == false then {
        tto8: (optionval.none ztypes.ztypetype)
        {
            dd8: declOfUnitDef :ty :ast unitDecl: duo8 :name
            if dd8 > 0 then tto8 = declDefTypetype :ty :ast declId: dd8
        }
        match (
            tto8
        ) case some then {
            boxed8: false
            if tto8 == ztypes.ztypetype.classType then boxed8 = true
            if tto8 == ztypes.ztypetype.unionType then boxed8 = true
            if boxed8 then {
                if (ty.declIsResolving
                    declId: (declOfUnitDef :ty :ast unitDecl: duo8 :name)
                ) then return true
            }
        } case none then null
        descendNamed :ty :reg :ast unitDecl: duo8 :name
    }
    # key by the DEFINING unit: a bare cross-unit field type (Bytes from
    # collections) resolves under its own unit, not the class's
    ku8: unitNameIdOf :ty :unitDecl
    if (duo8.isZero) == false then ku8 = unitNameIdOf :ty unitDecl: duo8
    rr: (resolvedByIds
        :ast
        :ty
        unitDecl: (unitDeclOfNameId :ty nameId: ku8)
        name: (nameIdOf :ast :name)
    )
    match (
        rr
    ) case some then {
        return (reg.hasDestructorName typeId: (ztypes.tid.create from: rr.u64))
    } case none then {
        return false
    }
}

# resolveClass -- resolve a class ObjectDef into a CLASS reference type: a child per
# field (field name -> type-ref shell), a child per as-block method, then a synthesized
# `create` child (LAST). Classes are reference types (is_valtype false); they get
# `create` but NO `==`/`!=` (unlike records). A class keeps a destructor when any field
# owns heap data (fieldTypeNeedsCleanup), else none. A typedef class (single
# `X.typedef` field) gets no field child, synth `create`+`borrow`, and inherits
# needs_destructor from the wrapped base (List -> yes, ListView -> no). Custom /
# `null` create, generics + protocols come later.
resolveClass: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    cnode: zast.ObjectDefData
} is {
    cid: (declareCanonicalType
        :ast
        :ty
        :reg
        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.classType
    )
    ccid: cid
    # `class is native` on the TYPE: the runtime supplies the layout and every
    # method, so routing can ask the declaration whether a type is
    # runtime-backed instead of comparing its unit's name. Mirrors
    # resolveFunction, which has always written the function-path flag.
    reg.setNative typeId: (ztypes.tid.create from: cid.u64) value: cnode.isNative
    pvExcl_ccid: (ListVal u64)
    pvGrants_ccid: (ListVal u64)
    scanVisibility :ty :ast onode: cnode excl: pvExcl_ccid grants: pvGrants_ccid
    reg.setValtype typeId: (ztypes.tid.create from: cid.u64) value: false
    needsDtor: false
    isgen: hasGenericParam :ast items: cnode.asItems
    if isgen then {
        reg.setGeneric typeId: (ztypes.tid.create from: cid.u64) value: true
        (registerGenericParams
            :ast
            :reg
            tdecl: (declOfUnitDef :ty :ast :unitDecl name: defName)
            items: cnode.asItems
        )
    }
    istd: recordIsTypedef :ast rnode: cnode
    if istd then {
        tdbase: objectTypedefBase :ast onode: cnode
        if (fieldTypeNeedsCleanup
            :ty
            :reg
            :ast
            :unitDecl
            name: tdbase.stringview
            isLock: false
        ) then needsDtor = true
        if tdbase.length > 0 then {
            tdk3: cid
            ty.typedefBaseName.set key: tdk3 value: tdbase
        }
        tdt3: objectTypedefBaseTid :ty :reg :ast :unitDecl onode: cnode
        if tdt3 > 0 then {
            tdk6: cid
            (ty.typedefBaseTid.set
                key: (ztypes.tid.create from: tdk6.u64)
                value: (ztypes.tid.create from: tdt3.u64)
            )
        }
    }
    fiter: cnode.isItems.iterate
    for fmId9: fiter loop {
        fm: ast.nodes.get i: fmId9.u64
        match (
            fm
        ) case namedoperation then {
            if (isFunctionDefOp op: (ast.nodes.get i: fm.operation.u64)) then {
                fname: zast.nameTextAt :ast ref: fm.name
                prodM4: false
                if (isgen) == false then {
                    prodM4 = true
                } else {
                    if (functiondefIsNative op: (ast.nodes.get i: fm.operation.u64)) == false then {
                        prodM4 = true
                    } else {
                        # Flipped collection families resolve their native
                        # method decls like user template methods. create is
                        # special-cased; length/capacity stay field children
                        # (their C surface is a struct read, not a method).
                        famF3: false
                        if defName == "ListVal" then famF3 = true
                        if defName == "ListView" then famF3 = true
                        if defName == "ListViewVal" then famF3 = true
                        if defName == "SetVal" then famF3 = true
                        if defName == "ListRef" then famF3 = true
                        if defName == "SetRef" then famF3 = true
                        if defName == "MapRR" then famF3 = true
                        if defName == "MapRV" then famF3 = true
                        if defName == "MapVR" then famF3 = true
                        if defName == "MapVV" then famF3 = true
                        if unitDecl == ty.collectionsUnitRoot when famF3 then {
                            prodSkipL: false
                            if fname.stringview == "create" then prodSkipL = true
                            if fname.stringview == "length" then prodSkipL = true
                            if fname.stringview == "capacity" then prodSkipL = true
                            if (prodSkipL) == false then prodM4 = true
                        }
                    }
                }
                if prodM4 then {
                    mido: (resolveMethodFnLazy
                        :ty
                        :reg
                        :ast
                        :unitDecl
                        ownerNameId: (nameIdOf :ast name: defName)
                        mname: fname.stringview
                        thisName: defName
                        op: (ast.nodes.get i: fm.operation.u64)
                        lazyOk: (isgen) == false
                    )
                    match (
                        mido
                    ) case some then {
                        (ty.setMemberType
                            parentTypeId: (ztypes.tid.create from: cid.u64)
                            nameId: fm.name
                            childTypeId: mido
                        )
                        if isgen then (reg.setGeneric
                            typeId: (ztypes.tid.create from: mido.u64)
                            value: true
                        )
                        if (fnFieldFlaggableName name: fname.stringview) then {
                            (ty.setChildFnptrField
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: cid.u64)
                                name: fname.stringview
                            )
                        }
                    } case none then null
                }
            } else {
                fname: zast.nameTextAt :ast ref: fm.name
                ftn: fieldHeadName :ast n: (ast.nodes.get i: fm.operation.u64)
                # A NON-OWNED field marker (lock / borrow / view) makes the
                # slot static: it is set in the constructor, never reassigned,
                # the constructor locks the caller's argument rather than
                # taking it, and the field holds no destructor. An OWNED one
                # (take / hold) is an ordinary field on all three counts --
                # `hold` freezes the contents, not the slot.
                lockField: false
                flock0: pathOwnership :ast n: (ast.nodes.get i: fm.operation.u64)
                match (
                    flock0
                ) case some then {
                    # This test is INVERTED: anything not named here becomes a
                    # lock field, so a new owned mode must be listed or it is
                    # silently treated as non-owned.
                    fOwned9: false
                    if flock0 == ztypes.zparamownership.takeMode then fOwned9 = true
                    if flock0 == ztypes.zparamownership.holdMode then fOwned9 = true
                    if flock0 == ztypes.zparamownership.takexMode then fOwned9 = true
                    if fOwned9 == false then lockField = true
                } case none then null
                (forceMemberOf
                    :ty
                    :reg
                    :ast
                    parentTypeId: (ztypes.tid.create from: cid.u64)
                    nameId: (zast.poolFind pool: ast.names text: ftn.stringview)
                )
                mref: (resolvedByIdsMember
                    :ast
                    :ty
                    :unitDecl
                    defId: (zast.poolFind pool: ast.names text: defName)
                    memberId: (zast.poolFind pool: ast.names text: ftn.stringview)
                )
                match (
                    mref
                ) case some then {
                    (ty.setMemberType
                        parentTypeId: (ztypes.tid.create from: cid.u64)
                        nameId: fm.name
                        childTypeId: mref
                    )
                    if (reg.typetypeOf typeId: (ztypes.tid.create from: mref.u64)) == ztypes.ztypetype.functionType then {
                        (ty.setChildFnptrField
                            pool: ast.names
                            parentTypeId: (ztypes.tid.create from: cid.u64)
                            name: fname.stringview
                        )
                    }
                    if lockField then (ty.setChildLockField
                        pool: ast.names
                        parentTypeId: (ztypes.tid.create from: cid.u64)
                        name: fname.stringview
                    )
                    match (
                        flock0
                    ) case some then {
                        (ty.setChildOwnership
                            pool: ast.names
                            parentTypeId: (ztypes.tid.create from: cid.u64)
                            name: fname.stringview
                            ownership: flock0
                        )
                    } case none then null
                    # a sibling-member ref default: the construction fill
                    # stamps the default's node with the member's type.
                    pdk: nodeId n: (ast.nodes.get i: fm.operation.u64)
                    pdo: cid
                    ty.pendingDefaultOwner.set key: pdk.u64 value: pdo
                    pdk2: nodeId n: (ast.nodes.get i: fm.operation.u64)
                    pdi: mref
                    ty.pendingDefaultId.set key: pdk2.u64 value: pdi
                } case none then {
                    if (isTypedefField :ast n: (ast.nodes.get i: fm.operation.u64)) then {
                        # No field child for the wrapper, but the inner refs
                        # (the u8 in `(List of: u8).typedef`) still stamp.
                        (recordTyperef
                            :ty
                            :reg
                            :ast
                            :unitDecl
                            thisName: ""
                            node: (ast.nodes.get i: fm.operation.u64)
                        )
                    } else {
                        if fname.stringview != "_resume_input" then {
                            if (fieldTypeNeedsCleanup
                                :ty
                                :reg
                                :ast
                                :unitDecl
                                name: ftn.stringview
                                isLock: lockField
                            ) then needsDtor = true
                        }
                        cidf: (resolveTyperefShellMarked
                            :ty
                            :reg
                            :ast
                            :unitDecl
                            ownerId: cid
                            typeExpr: (ast.nodes.get i: fm.operation.u64)
                            thisName: defName
                        )
                        (ty.setMemberType
                            parentTypeId: (ztypes.tid.create from: cid.u64)
                            nameId: fm.name
                            childTypeId: cidf
                        )
                        if (reg.typetypeOf typeId: cidf) == ztypes.ztypetype.functionType then {
                            (ty.setChildFnptrField
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: cid.u64)
                                name: fname.stringview
                            )
                        }
                        if lockField then {
                            (ty.setChildLockField
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: cid.u64)
                                name: fname.stringview
                            )
                        }
                        match (
                            flock0
                        ) case some then {
                            (ty.setChildOwnership
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: cid.u64)
                                name: fname.stringview
                                ownership: flock0
                            )
                        } case none then null
                        (recordTyperef
                            :ty
                            :reg
                            :ast
                            :unitDecl
                            thisName: ""
                            node: (ast.nodes.get i: fm.operation.u64)
                        )
                        dcn0: dottedChildName :ast n: (ast.nodes.get i: fm.operation.u64)
                        rdnc: rootNameOf :ast n: (ast.nodes.get i: fm.operation.u64)
                        if (isNumericLiteralName name: rdnc.stringview) then {
                            (ty.setDefaultLiteral
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: cid.u64)
                                name: fname.stringview
                                node: fm.operation
                            )
                        } else {
                            if dcn0.length > 0 when (isStripMarker name: dcn0.stringview) == false when (nameDenotesUnit
                                :ty
                                :reg
                                nameId: (nameIdOf
                                :ast
                                name: rdnc.stringview
                            )
                            ) == false then {
                                cArmNid9: zast.poolFind pool: ast.names text: dcn0.stringview
                                cArmDecl9: ty.declMemberIdOf parentTypeId: cidf nameId: cArmNid9
                                (ty.setDefaultVariantArm
                                    pool: ast.names
                                    parentTypeId: (ztypes.tid.create from: cid.u64)
                                    name: fname.stringview
                                    targetDecl: cArmDecl9
                                )
                            }
                        }
                        if dcn0.length > 0 when (isStripMarker name: dcn0.stringview) then {} else {
                            if dcn0.length > 0 then {
                                rdk: nodeId n: (ast.nodes.get i: fm.operation.u64)
                                rdo: cid
                                ty.pendingDefaultOwner.set key: rdk.u64 value: rdo
                                rdk2: nodeId n: (ast.nodes.get i: fm.operation.u64)
                                rdn: rootNameOf :ast n: (ast.nodes.get i: fm.operation.u64)
                                ty.pendingDefaultName.set key: rdk2.u64 value: rdn
                            }
                        }
                    }
                }
            }
        } else null
    }
    # Flipped iterator families: their only method decl (`call`) lives in
    # the as-block; produce it like the isItems loop does. attachMethods
    # stays non-generic-only (it also handles const-clone members and
    # generator synthesis, which native decls never need).
    with aiterP4: cnode.asItems.iterate do for amP4Id9: aiterP4 loop {
        amP4: ast.nodes.get i: amP4Id9.u64
        match (
            amP4
        ) case namedoperation then {
            if (isFunctionDefOp op: (ast.nodes.get i: amP4.operation.u64)) then {
                afnP4: zast.nameTextAt :ast ref: amP4.name
                prodA4: false
                fnNativeP4: functiondefIsNative op: (ast.nodes.get i: amP4.operation.u64)
                if isgen then {
                    if fnNativeP4 then {
                        famA4: false
                        if defName == "ListIter" then famA4 = true
                        if defName == "ListIterVal" then famA4 = true
                        if defName == "SetIter" then famA4 = true
                        if defName == "SetIterVal" then famA4 = true
                        if defName == "MapKeyIter" then famA4 = true
                        if defName == "MapItemIter" then famA4 = true
                        if defName == "MapKeyIterRV" then famA4 = true
                        if defName == "MapKeyIterVR" then famA4 = true
                        if defName == "MapKeyIterVV" then famA4 = true
                        if defName == "MapItemIterRV" then famA4 = true
                        if defName == "MapItemIterVR" then famA4 = true
                        if defName == "MapItemIterVV" then famA4 = true
                        if unitDecl == ty.collectionsUnitRoot when famA4 then {
                            skipA4: false
                            if afnP4.stringview == "create" then skipA4 = true
                            if afnP4.stringview == "length" then skipA4 = true
                            if afnP4.stringview == "capacity" then skipA4 = true
                            if (skipA4) == false then prodA4 = true
                        }
                    } else {
                        prodA4 = true
                    }
                }
                if prodA4 then {
                    amidP4: (resolveMethodFn
                        :ty
                        :reg
                        :ast
                        :unitDecl
                        ownerNameId: (nameIdOf :ast name: defName)
                        mname: afnP4.stringview
                        thisName: defName
                        op: (ast.nodes.get i: amP4.operation.u64)
                    )
                    match (
                        amidP4
                    ) case some then {
                        (ty.setMemberType
                            parentTypeId: (ztypes.tid.create from: cid.u64)
                            nameId: amP4.name
                            childTypeId: amidP4
                        )
                        reg.setGeneric typeId: (ztypes.tid.create from: amidP4.u64) value: true
                        if (fnFieldFlaggableName name: afnP4.stringview) then {
                            (ty.setChildFnptrField
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: cid.u64)
                                name: afnP4.stringview
                            )
                        }
                    } case none then null
                }
            }
        } else null
    }
    hasCreate: false
    if (isgen) == false then {
        hcAs: (attachMethods
            :ty
            :reg
            :ast
            :unitDecl
            :defName
            parentId: (ztypes.tid.create from: cid.u64)
            asItems: cnode.asItems
        )
        if hcAs then hasCreate = true
        mNeedsDtor: (attachMarkers
            :ty
            :reg
            :ast
            :unitDecl
            parentId: cid
            asItems: cnode.asItems
        )
        if mNeedsDtor then needsDtor = true
    }
    if (hasCreate) == false then {
        if (isgen) == false then {
            createId: (reg.newType
                name: "create"
                ownerTid: cid
                typetype: ztypes.ztypetype.functionType
            )
            (ty.declSynthMember
                parentTypeId: (ztypes.tid.create from: cid.u64)
                nameId: zast.wkCreate
                kind: ztyping.declkind.methodDecl
            )
            (ty.setMemberType
                parentTypeId: (ztypes.tid.create from: cid.u64)
                nameId: zast.wkCreate
                childTypeId: createId
            )
            materializeCreateParams :ty :reg :ast typeTid: cid :createId
        }
    }
    if istd then {
        borrowId: reg.newType name: "borrow" ownerTid: cid typetype: ztypes.ztypetype.functionType
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: cid.u64)
            nameId: zast.wkBorrow
            kind: ztyping.declkind.methodDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: cid.u64)
            nameId: zast.wkBorrow
            childTypeId: borrowId
        )
    }
    if defName == "String" then needsDtor = true
    if needsDtor then {
        dn: "\{defName}_destroy"
        (reg.setDestructorName
            typeId: (ztypes.tid.create from: cid.u64)
            nameId: (zast.poolSet pool: ast.names text: dn.stringview)
        )
    }
    if pvExcl_ccid.length > 0 then ty.privacySeen = true
    applyGrantsPrivate :ty parentId: ccid grants: pvGrants_ccid
}

# resolveFacet -- resolve a facet ObjectDef into a FACET valtype: a child per
# is-block spec method (the `:this` receiver dropped), then synthesized `create` +
# `borrow` FUNCTION shells (JOIN-only, no own row). Facets are value types
# (is_valtype true), no destructor, no `==`/`!=`. Generic facets arrive later.
resolveFacet: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    defName: StringView
    fnode: zast.ObjectDefData
} is {
    fid: (declareCanonicalType
        :ast
        :ty
        :reg
        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.facetType
    )
    ffid: fid
    pvExcl_ffid: (ListVal u64)
    pvGrants_ffid: (ListVal u64)
    scanVisibility :ty :ast onode: fnode excl: pvExcl_ffid grants: pvGrants_ffid
    reg.setValtype typeId: (ztypes.tid.create from: fid.u64) value: true
    isgen: hasGenericParam :ast items: fnode.isItems
    if isgen then reg.setGeneric typeId: (ztypes.tid.create from: fid.u64) value: true
    specThisStr: defName.string
    dropThis: true
    {
        fcn9: (ty.declConformerOf
            declId: (declOfUnitDefId
                :ty
                :unitDecl
                nameId: (zast.poolFind pool: ast.names text: defName)
            )
        )
        if fcn9 > 0 then {
            specThisStr = (zast.nameTextCopy :ast ref: (zast.nameid.create from: fcn9))
            dropThis = false
        }
    }
    siter: fnode.isItems.iterate
    for smId9: siter loop {
        sm: ast.nodes.get i: smId9.u64
        match (
            sm
        ) case namedoperation then {
            mname: zast.nameTextAt :ast ref: sm.name
            sido: (resolveSpecFn
                :ty
                :reg
                :ast
                :unitDecl
                ownerNameId: (nameIdOf :ast name: defName)
                mname: mname.stringview
                thisName: specThisStr.stringview
                op: (ast.nodes.get i: sm.operation.u64)
                skipThis: dropThis
            )
            match (
                sido
            ) case some then {
                (ty.setMemberType
                    parentTypeId: (ztypes.tid.create from: fid.u64)
                    nameId: sm.name
                    childTypeId: sido
                )
            } else null
        } else null
    }
    if (isgen) == false then {
        createId: reg.newType name: "create" ownerTid: fid typetype: ztypes.ztypetype.functionType
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: fid.u64)
            nameId: zast.wkCreate
            kind: ztyping.declkind.methodDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: fid.u64)
            nameId: zast.wkCreate
            childTypeId: createId
        )
        borrowId: reg.newType name: "borrow" ownerTid: fid typetype: ztypes.ztypetype.functionType
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: fid.u64)
            nameId: zast.wkBorrow
            kind: ztyping.declkind.methodDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: fid.u64)
            nameId: zast.wkBorrow
            childTypeId: borrowId
        )
    }
    if pvExcl_ffid.length > 0 then ty.privacySeen = true
    applyGrantsPrivate :ty parentId: ffid grants: pvGrants_ffid
}

# resolveProtocol -- resolve a protocol ObjectDef into a PROTOCOL reftype: a child
# per is-block spec method (the `:this` receiver dropped), then synth `create` +
# `borrow` FUNCTION shells, then an unconditional destructor (a protocol wraps heap
# data). Reference type (is_valtype false), no `==`/`!=`. Generic protocols arrive later.
resolveProtocol: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    fnode: zast.ObjectDefData
} is {
    pid: (declareCanonicalType
        :ast
        :ty
        :reg
        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.protocolType
    )
    ppid: pid
    pvExcl_ppid: (ListVal u64)
    pvGrants_ppid: (ListVal u64)
    scanVisibility :ty :ast onode: fnode excl: pvExcl_ppid grants: pvGrants_ppid
    reg.setValtype typeId: (ztypes.tid.create from: pid.u64) value: false
    isgen: hasGenericParam :ast items: fnode.isItems
    if isgen then reg.setGeneric typeId: (ztypes.tid.create from: pid.u64) value: true
    # A protocol spec receiver is normally dropped (resolves to nothing). The reference
    # resolves Text NESTED inside String's `:Text` marker, so Text's spec `:this` binds
    # to the enclosing String -- mirror that for the system Text protocol.
    specThisStr: defName.string
    dropThis: true
    if unitDecl == ty.systemUnitRoot then {
        if defName == "Text" then {
            specThisStr = "String".string
            dropThis = false
        }
    }
    if dropThis then {
        cn9: (ty.declConformerOf
            declId: (declOfUnitDefId
                :ty
                :unitDecl
                nameId: (zast.poolFind pool: ast.names text: defName)
            )
        )
        if cn9 > 0 then {
            specThisStr = (zast.nameTextCopy :ast ref: (zast.nameid.create from: cn9))
            dropThis = false
        }
    }
    siter: fnode.isItems.iterate
    for smId9: siter loop {
        sm: ast.nodes.get i: smId9.u64
        match (
            sm
        ) case namedoperation then {
            mname: zast.nameTextAt :ast ref: sm.name
            sido: (resolveSpecFn
                :ty
                :reg
                :ast
                :unitDecl
                ownerNameId: (nameIdOf :ast name: defName)
                mname: mname.stringview
                thisName: specThisStr.stringview
                op: (ast.nodes.get i: sm.operation.u64)
                skipThis: dropThis
            )
            match (
                sido
            ) case some then {
                (ty.setMemberType
                    parentTypeId: (ztypes.tid.create from: pid.u64)
                    nameId: sm.name
                    childTypeId: sido
                )
            } else null
        } else null
    }
    if (isgen) == false then {
        createId: reg.newType name: "create" ownerTid: pid typetype: ztypes.ztypetype.functionType
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: pid.u64)
            nameId: zast.wkCreate
            kind: ztyping.declkind.methodDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: pid.u64)
            nameId: zast.wkCreate
            childTypeId: createId
        )
        borrowId: reg.newType name: "borrow" ownerTid: pid typetype: ztypes.ztypetype.functionType
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: pid.u64)
            nameId: zast.wkBorrow
            kind: ztyping.declkind.methodDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: pid.u64)
            nameId: zast.wkBorrow
            childTypeId: borrowId
        )
    }
    dn: "\{defName}_destroy"
    (reg.setDestructorName
        typeId: (ztypes.tid.create from: pid.u64)
        nameId: (zast.poolSet pool: ast.names text: dn.stringview)
    )
    if pvExcl_ppid.length > 0 then ty.privacySeen = true
    applyGrantsPrivate :ty parentId: ppid grants: pvGrants_ppid
}

# registerEmptyType -- register a native bottom type (null -> NULL, never -> NEVER) as a
# valtype with a single synth `create` child. The reference special-cases these: they are
# `record is native` in source but carry a distinct typetype and only a create child.
registerEmptyType: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    name: StringView
    tt: ztypes.ztypetype
} out u64 is {
    ex0: (resolvedByIds
        :ast
        :ty
        :unitDecl
        name: (zast.poolFind pool: ast.names text: name)
    )
    match (
        ex0
    ) case some then {
        reg.setValtype typeId: (ztypes.tid.create from: ex0.u64) value: true
        cci0: reg.newType name: "create" ownerTid: ex0 typetype: ztypes.ztypetype.functionType
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: ex0.u64)
            nameId: zast.wkCreate
            kind: ztyping.declkind.methodDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: ex0.u64)
            nameId: zast.wkCreate
            childTypeId: cci0
        )
        return ex0
    } case none then null
    nid: reg.newType :name typetype: tt
    reg.setValtype typeId: nid value: true
    ccid: reg.newType name: "create" ownerTid: nid typetype: ztypes.ztypetype.functionType
    (ty.declSynthMember
        parentTypeId: nid
        nameId: zast.wkCreate
        kind: ztyping.declkind.methodDecl
    )
    ty.setMemberType parentTypeId: nid nameId: zast.wkCreate childTypeId: ccid
    linkDeclType :ty :reg :ast :unitDecl :name tid: nid
    return nid
}

# descendNamed -- reference-level DFS entry: resolve a named top-level def's
# body by descending into its AST node (located via its Decl's node) so a
# reference's dependency resolves before the
# referrer continues. Returns the canonical forward-decl id; a grey
# (in-progress) or already-resolved target returns it without re-descending.
# Returns 0 when the name is not an indexed top-level def, so the caller keeps
# its shell behavior.

# declOfUnitDef -- the Decl of top-level def `name` in unit `unitDecl`
# (unit root by bare name -> child by pool id); 0 when not indexed.
declOfUnitDef: function {
    ty: ztyping.ZTyping.view
    ast: Ast
    unitDecl: ztypes.declid
    name: StringView
} out ztypes.declid is {
    return (declOfUnitDefId
        :ty
        :unitDecl
        nameId: (zast.poolFind pool: ast.names text: name)
    )
}

# defWasResolved -- has this definition's body already been resolved? The mark
# lives on its Decl, so a definition with no Decl of its own has not been.
defWasResolved: function {
    ty: ztyping.ZTyping
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out bool is {
    d9: declOfUnitDefId :ty :unitDecl :nameId
    if d9 > 0 then return (ty.declIsDefined declId: d9)
    return false
}

# declOfUnitDefId -- the same walk for a caller that already holds the
# definition's name id: unit root, then the child edge. No key is built.
declOfUnitDefId: function {
    ty: ztyping.ZTyping
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    if nameId.isZero then return (ztypes.declid.create from: 0)
    # A definition is looked up in the scope it is WRITTEN in: the cursor's
    # unit frame when it lies inside `unitDecl` (a nested unit's member is a
    # child of that unit), each enclosing unit frame outward, the unit's root
    # -- and no further: this names a DEFINITION of the unit, not a
    # reference, so the prelude is not consulted.
    cur9: frameFor :ty :unitDecl
    for cur9 > 0 loop {
        if cur9 == ty.coreUnitRoot then return (ztypes.declid.create from: 0)
        nd9: ty.declFindChild parentDeclId: cur9 :nameId
        if (nd9.isZero) == false then return nd9
        # a definition the unit's `public:` block makes -- the block's
        # contents are the unit's surface, spelled `unit.name` from outside
        pb9: publicNsChildOf :ty root: cur9
        if (pb9.isZero) == false then {
            pd9: ty.declFindChild parentDeclId: pb9 :nameId
            if (pd9.isZero) == false then return pd9
        }
        cur9 = unitFrameOf :ty declId: (declParentIdOf :ty declId: cur9)
    }
    return (ztypes.declid.create from: 0)
}

# declDefTypetype -- the typetype a declaration's def node declares
# (defTypetypeOf off the Decl's own namedoperation); none for defs that
# mint no canonical type (re-exports, constants, null/never).
declDefTypetype: function {
    ty: ztyping.ZTyping
    ast: Ast
    declId: ztypes.declid
} out optionval ztypes.ztypetype is {
    dnode9: u32
    dname9: u32
    {
        do9: ty.decls.get i: declId.u64
        dnode9 = do9.node
        dname9 = do9.name
    }
    if dnode9 == 0 then return (optionval.none ztypes.ztypetype)
    nop9: ast.nodes.get i: dnode9.u64
    if nop9.namedoperation then {
        nm9: zast.poolTextAt pool: ast.names ref: (zast.nameid.create from: dname9.u32)
        return (defTypetypeOf
            :ast
            defn: (ast.nodes.get i: nop9.operation.u64)
            name: nm9.stringview
        )
    }
    return (optionval.none ztypes.ztypetype)
}

# reexportTargetIdsOf -- reexportTargetOf as an id pair (root id, member id);
# an absent pair when the Decl is absent or not a re-export.
reexportTargetIdsOf: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    declId: ztypes.declid
} out ztypes.deftarget is {
    if declId.isZero then return ztypes.noDefTarget
    do9: ty.decls.get i: declId.u64
    if do9.kind.reexportDecl then {
        nop9: ast.nodes.get i: do9.node.u64
        if nop9.namedoperation then {
            vn9: ast.nodes.get i: nop9.operation.u64
            dk9: dottedDefTargetIds :ast n: vn9
            if dk9.unitName.u32 > 0 then return dk9
            # a BARE alias names a target in its OWN unit, so the missing
            # segment is the enclosing unit's name -- the Decl's parent.
            bid9: bareDefTargetNameId :ast n: vn9
            if (bid9.isZero) == false then {
                puid9: zast.nameid
                pdo9: ty.decls.get i: do9.parent.u64
                puid9 = zast.nameid.create from: pdo9.name
                if (puid9.isZero) == false then {
                    return (ztypes.deftarget unitName: puid9 defName: bid9)
                }
            }
        }
    }
    return ztypes.noDefTarget
}

# aliasIsBareForm -- the alias Decl's value is a BARE name (`Same: Holder`)
# rather than a dotted one. The target pair cannot say: a bare alias
# borrows its own unit for the missing segment, which a self-unit dotted alias
# (`Alpha: thisunit.Beta`) spells explicitly.
aliasIsBareForm: function {ty: ztyping.ZTyping ast: Ast.view declId: ztypes.declid} out bool is {
    if declId.isZero then return false
    bdo9: ty.decls.get i: declId.u64
    if bdo9.kind.reexportDecl then {
        bnp9: ast.nodes.get i: bdo9.node.u64
        if bnp9.namedoperation then {
            bvn9: ast.nodes.get i: bnp9.operation.u64
            bnid9: bareDefTargetNameId :ast n: bvn9
            return (bnid9.isZero) == false
        }
    }
    return false
}

# aliasNamesType -- the alias denotes a TYPE, not a value. A bare alias always
# does (`Same: Holder`); a dotted one does when its parent names a UNIT
# (`Node: zast.Node`) rather than a type, because a TYPE parent means the child
# is one arm and the alias denotes a VALUE of it (`false: bool.false`). This is
# the same split that decides how the alias registers.
aliasNamesType: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    if declId.isZero then return false
    if (aliasIsBareForm :ty :ast :declId) then return true
    ndo9: ty.decls.get i: declId.u64
    if ndo9.kind.reexportDecl then {
        nnp9: ast.nodes.get i: ndo9.node.u64
        if nnp9.namedoperation then {
            nvn9: ast.nodes.get i: nnp9.operation.u64
            ntk9: dottedDefTargetIds :ast n: nvn9
            if ntk9.unitName.u32 > 0 then return (nameDenotesUnit :ty :reg nameId: ntk9.unitName)
        }
    }
    return false
}

# nestedUnitTidOf -- the type id of the nested unit `nestedNameId` names inside the
# unit that owns `ownerDeclId`: descend one edge of the Decl tree, ask demand
# for it, and read the id off its declaration. 0 when the name is not a child
# unit, which is the caller's cue that the name means something else.
nestedUnitTidOf: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    ownerDeclId: ztypes.declid
    nestedNameId: zast.nameid
} out ztypes.tid is {
    if ownerDeclId.isZero then return (ztypes.tid.create from: 0)
    sub9: ty.declFindChild parentDeclId: ownerDeclId nameId: nestedNameId
    if (declDeclaresUnit :ty :ast declId: sub9) == false then return (ztypes.tid.create from: 0)
    resolveDemandedDecl :ty :reg :ast declId: sub9
    return (declTypeIdOf :ty declId: sub9)
}

# declDeclaresUnit -- does this declaration declare a unit? Read off the def
# node's kind, which the parser settled; nothing is resolved to answer. Says
# nothing about privacy -- `nestedUnitTidOf` calls it on a CHILD declaration,
# where being nested is a property of the descent, not of the arm.
declDeclaresUnit: function {
    ty: ztyping.ZTyping.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    dn9: u64
    {
        do9: ty.decls.get i: declId.u64
        dn9 = do9.node.u64
    }
    if dn9 == 0 then return false
    np9: ast.nodes.get i: dn9
    if (np9.namedoperation) == false then return false
    return (zast.unitOpDeclaresUnit :ast opId: np9.operation)
}

# nestedUnitMemberTid -- `sub.member` where `sub` is a nested unit of the unit
# that owns `ownerDeclId`: two edges of the Decl tree, each resolved on demand
# the way any definition is. 0 when either edge is missing.
nestedUnitMemberTid: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    ownerDeclId: ztypes.declid
    nestedNameId: zast.nameid
    defName: zast.nameid
} out ztypes.tid is {
    subTid9: nestedUnitTidOf :ty :reg :ast :ownerDeclId :nestedNameId
    if subTid9.isZero then return (ztypes.tid.create from: 0)
    sub9: ty.declFindChild parentDeclId: ownerDeclId nameId: nestedNameId
    mem9: ty.declFindChild parentDeclId: sub9 nameId: defName
    if mem9.isZero then return (ztypes.tid.create from: 0)
    # declare before bind, as descendNamed does for a file unit's member: a
    # TYPE member's canonical id is declared (in the member's own frame)
    # before its definition resolves, so a reference that reaches it while
    # it is grey -- a legal back-edge between two types' method signatures
    # -- gets the id, not the not-yet-linked declaration field
    declared9: u64
    tto9: declDefTypetype :ty :ast declId: mem9
    match (
        tto9
    ) case some then {
        prevFrame9: ty.curFrame
        ty.curFrame = sub9
        dnT9: zast.poolTextAt pool: ast.names ref: defName
        declared9 = (declareCanonicalType
            :ast
            :ty
            :reg
            unitDecl: (unitDeclOfNameIdHere :ty nameId: nestedNameId)
            ownerNameId: zast.nameid
            name: dnT9.stringview
            typetype: tto9
        )
        ty.curFrame = prevFrame9
    } case none then null
    resolveDemandedDecl :ty :reg :ast declId: mem9
    r9: declTypeIdOf :ty declId: mem9
    if r9.isZero when declared9 > 0 then return (ztypes.tid.create from: declared9)
    return r9
}

# aliasTargetMintedTid -- the canonical id an alias's target carries, or 0:
# a nested unit's member of the alias's own scope, else the named file
# unit's definition. The declaration's own field is set when its resolution
# COMPLETES; the canonical id is declared before bind (declareCanonicalType,
# idempotent), so a target mid-resolution -- a record whose members name the
# alias again -- answers with the id it already declared. It resolves
# nothing.
aliasTargetMintedTid: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    declId: ztypes.declid
    nestedNameId: zast.nameid
    defName: zast.nameid
} out u64 is {
    aParent9: declParentIdOf :ty :declId
    tgt9: ztypes.declid
    sub9: ty.declFindChild parentDeclId: aParent9 nameId: nestedNameId
    if (sub9.isZero) == false then tgt9 = ty.declFindChild parentDeclId: sub9 nameId: defName
    if tgt9.isZero then tgt9 = (declOfUnitDefIds
        :ty
        unitDecl: (unitDeclOfNameIdHere :ty nameId: nestedNameId)
        nameId: defName
    )
    if tgt9.isZero then return 0
    mt9: declTypeIdOf :ty declId: tgt9
    if (mt9.isZero) == false then return mt9.u64
    tto9: declDefTypetype :ty :ast declId: tgt9
    match (
        tto9
    ) case some then {
        tnT9: zast.poolTextAt pool: ast.names ref: defName
        # declared in the TARGET's frame -- its parent unit -- so the id is
        # the one the target's own resolution declares (keyed on that unit)
        prevFrame9: ty.curFrame
        ty.curFrame = declParentIdOf :ty declId: tgt9
        r9: (declareCanonicalType
            :ast
            :ty
            :reg
            unitDecl: (unitDeclOfNameIdHere :ty nameId: nestedNameId)
            ownerNameId: zast.nameid
            name: tnT9.stringview
            typetype: tto9
        )
        ty.curFrame = prevFrame9
        return r9
    } case none then {
        return 0
    }
}

# resolveAliasKey -- single-minting for a unit-level re-export alias
# (a reexportDecl in the Decl tree; target read off its def node): resolve the
# TARGET's canonical id and reuse it -- the alias never mints its own
# tid. Registers the unit member and the alias Decl's typeId so
# every later lookup (declChildOf, resolveUnitChild, the Decl tree) sees
# the one canonical id. Returns 0 when the key is not an alias, the
# alias is mid-follow (a cycle), or the target cannot resolve yet.
resolveAliasKey: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    declId: ztypes.declid
} out u64 is {
    # an alias resolves in the frame it is written in
    prevFrame9: ty.curFrame
    ty.curFrame = declParentIdOf :ty :declId
    r9: resolveAliasKeyIn :ty :reg :ast :declId
    ty.curFrame = prevFrame9
    # an alias to a CONSTANT carries a VALUE as well as a type, and that value
    # is a member of the unit the ALIAS is written in. Folded here rather than
    # at a lookup because the Decl caches the type: the second reader finds an
    # id and never asks again, so the value has to be materialised the once,
    # where the alias itself resolves.
    constFoldDecl :ast :ty :reg :declId
    return r9
}

resolveAliasKeyIn: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    declId: ztypes.declid
} out u64 is {
    adecl9: declId
    altK9: reexportTargetIdsOf :ty :ast declId: adecl9
    if altK9.unitName.u32 == 0 then return 0
    if (ty.declIsResolving declId: adecl9) then {
        # re-entered while its target resolves: an alias is a forwarding
        # edge, not a definition with a body. When the target's own id is
        # already minted (a record's shell mints before its members, whose
        # signatures may name the alias again), forward to it; only a target
        # with no id yet is a true cycle.
        return (aliasTargetMintedTid
            :ty
            :reg
            :ast
            declId: adecl9
            nestedNameId: altK9.unitName
            defName: altK9.defName
        )
    }
    tu9: zast.poolTextAt pool: ast.names ref: altK9.unitName
    tn9: zast.poolTextAt pool: ast.names ref: altK9.defName
    aParent9: ztypes.declid
    aNameId9: zast.nameid
    {
        ado9: ty.decls.get i: adecl9.u64
        aParent9 = ado9.parent
        aNameId9 = zast.nameid.create from: ado9.name
    }
    if aNameId9.isZero then return 0
    aName9: zast.poolTextAt pool: ast.names ref: aNameId9
    # the file unit the alias is written in, for the name walkers and the
    # diagnostics -- the alias's OWN scope is aParent9, which is that unit's
    # root for a top-level alias and the nested unit's Decl for a nested one
    aUnit9: (zast.poolTextAt
        pool: ast.names
        ref: (declNameIdOf
            :ty
            declId: (unitDeclOfNameIdHere
                :ty
                nameId: (declNameIdOf :ty declId: (unitRootOfDecl :ty declId: adecl9))
            )
        )
    )
    ty.declSetResolving declId: adecl9 mark: true
    # A subunit of THIS unit is the nearer scope, so it answers before the
    # file-unit index -- the same order a name written inside a namespace takes.
    atid9: (nestedUnitMemberTid
        :ty
        :reg
        :ast
        ownerDeclId: aParent9
        nestedNameId: altK9.unitName
        defName: altK9.defName
    )
    if atid9.isZero then atid9 = (descendNamed
        :ty
        :reg
        :ast
        unitDecl: (unitDeclOfNameIdHere :ty nameId: altK9.unitName)
        name: tn9.stringview
    )
    ty.declSetResolving declId: adecl9 mark: false
    typeRooted9: false
    if atid9.isZero then {
        # a type-rooted target (`true: bool.true`): the root names a tagged
        # type, the member one of its value arms -- the alias denotes a VALUE
        # of the root type, so the edge binds the ROOT's tid
        rto9: (walkLookupTyperef
            :ast
            :ty
            :reg
            unitDecl: (unitDeclOfNameIdHere
                :ty
                nameId: (declNameIdOf :ty declId: (unitRootOfDecl :ty declId: adecl9))
            )
            base: tu9.stringview
        )
        if rto9.none then {
            # a tagged type declared in THIS file is invisible to the typeref
            # walk while resolution runs, so `READY: mode.ready` never reached
            # the arm test below. resolveAtomType is the current-unit-relative
            # resolver that sees it.
            rtb9: (resolveAtomType
                :ty
                :reg
                :ast
                unitDecl: (unitDeclOfNameIdHere
                    :ty
                    nameId: (declNameIdOf :ty declId: (unitRootOfDecl :ty declId: adecl9))
                )
                nm: tu9.stringview
                thisName: ""
            )
            if rtb9 > 0 then rto9 = optionval.some rtb9.u64
        }
        match (
            rto9
        ) case some then {
            rtt9: reg.typetypeOf typeId: (ztypes.tid.create from: rto9.u64)
            isTag9: false
            if rtt9 == ztypes.ztypetype.variantType then isTag9 = true
            if rtt9 == ztypes.ztypetype.unionType then isTag9 = true
            if isTag9 then {
                mo9: (ty.declChildOf
                    pool: ast.names
                    parentTypeId: (ztypes.tid.create from: rto9.u64)
                    name: tn9.stringview
                )
                match (
                    mo9
                ) case some then {
                    mtt9: reg.typetypeOf typeId: (ztypes.tid.create from: mo9.u64)
                    isMem9: true
                    if mtt9 == ztypes.ztypetype.functionType then isMem9 = false
                    if mtt9 == ztypes.ztypetype.dataType then isMem9 = false
                    if isMem9 then {
                        atid9 = ztypes.tid.create from: (rto9)
                        typeRooted9 = true
                    }
                } case none then null
            }
        } case none then null
    }
    if atid9.isZero then {
        # a BARE alias (`Text: String`, `tally: u64`): its target resolves
        # current-unit-relative, so it may live in a stdlib unit rather than in
        # the alias's own -- the pair carries this unit only because a bare name
        # has no unit segment. resolveAtomType is that precedence walk.
        if (aliasIsBareForm :ty :ast declId: adecl9) then {
            # a ring of bare aliases (`Alpha: Beta` / `Beta: Alpha`) is cut by
            # the guard at the top of this function, which returns silently --
            # the caller then mints a forward shell and the C carries an
            # incomplete type. Report it the way the dotted leg does instead.
            btd9: ty.declFindChild parentDeclId: aParent9 nameId: altK9.defName
            if (ty.declIsResolving declId: btd9) then {
                bcm9: "alias cycle: '\{aUnit9}.\{aName9}' aliases '\{aUnit9}.\{tn9}' which is still resolving"
                addResolveError :ty e: zast.err.typeError msg: bcm9
                return 0
            }
            ty.declSetResolving declId: adecl9 mark: true
            bat9: (resolveAtomType
                :ty
                :reg
                :ast
                unitDecl: (unitDeclOfNameIdHere
                    :ty
                    nameId: (declNameIdOf :ty declId: (unitRootOfDecl :ty declId: adecl9))
                )
                nm: tn9.stringview
                thisName: ""
            )
            ty.declSetResolving declId: adecl9 mark: false
            if bat9 > 0 then atid9 = ztypes.tid.create from: (bat9.u64)
        }
    }
    if atid9.isZero then return 0
    # the alias is a member of the unit it is WRITTEN in, which is that unit's
    # own id whether it is a file unit or a nested one -- both carry it on the
    # Decl the alias hangs under.
    ownTid9: declTypeIdOf :ty declId: aParent9
    if (ownTid9.isZero) == false then {
        (ty.setMemberType
            parentTypeId: ownTid9
            nameId: aNameId9
            childTypeId: atid9
        )
    }
    ty.declSetType declId: adecl9 typeId: atid9
    if typeRooted9 then {
        # the value alias's own dotted node resolves as a typeref to the
        # root type post-demand (nav from the alias line into the tag type)
        dnid9: u64
        {
            do8: ty.decls.get i: adecl9.u64
            nop8: ast.nodes.get i: do8.node.u64
            if nop8.namedoperation then dnid9 = nop8.operation.u64
        }
        if dnid9 > 0 then {
            ptn9: tu9.copy
            ty.pendingTyperef.set key: dnid9 value: ptn9
            # the alias resolves in the frame it is written in
            ty.pendingTyperefFrame.set key: dnid9 value: aParent9
        }
    }
    return atid9
}

# ensureDefGenericParams -- register a generic type definition's parameter names
# against its Decl. `registerGenericParams` runs from the definition resolvers,
# but a def can be marked RESOLVED by a path that never reached one -- the
# descent then short-circuits, and `getOrMintSpec` reads an arity of zero for a
# template that plainly has parameters, which costs it the trie. `addGenericParam`
# already refuses a name it holds, so re-registering is a no-op.
ensureDefGenericParams: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    declId: ztypes.declid
} is {
    if declId.isZero then return
    dgG9: ty.decls.get i: declId.u64
    dnG9: dgG9.node.u64
    if dnG9 == 0 then return
    bmG9: ast.nodes.get i: dnG9
    if bmG9.namedoperation then {
        odG9: ast.nodes.get i: bmG9.operation.u64
        match (
            odG9
        ) case objectdef then {
            if (hasGenericParam :ast items: odG9.asItems) then {
                registerGenericParams :ast :reg tdecl: declId items: odG9.asItems
            }
        } else null
    }
}

descendNamed: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast
    unitDecl: ztypes.declid
    name: StringView
} out ztypes.tid is {
    # `unitDecl.name` resolves in unitDecl's frame, whatever asked for it
    prevFrame9: ty.curFrame
    {
        dd9: declOfUnitDef :ty :ast :unitDecl :name
        if (dd9.isZero) == false then ty.curFrame = declParentIdOf :ty declId: dd9
    }
    r9: descendNamedIn :ty :reg :ast :unitDecl :name
    ty.curFrame = prevFrame9
    return r9
}

descendNamedIn: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast
    unitDecl: ztypes.declid
    name: StringView
} out ztypes.tid is {
    if ty.defNodeIndexBuilt == false then return (ztypes.tid.create from: 0)
    if unitDecl == ty.coreUnitRoot then return (ztypes.tid.create from: 0)
    ddec9: declOfUnitDef :ty :ast :unitDecl :name
    # a CONSTANT declares itself when it is read: its type is the one its value
    # carries, so a target that has not folded yet has nothing to answer with
    if (ddec9.isZero) == false then {
        dcC9: false
        {
            ddo9: ty.decls.get i: ddec9.u64
            if ddo9.kind.constDecl when ddo9.typeId.isZero then dcC9 = true
        }
        if dcC9 then constFoldDecl :ast :ty :reg declId: ddec9
    }
    tto9: (optionval.none ztypes.ztypetype)
    if ddec9 > 0 then tto9 = declDefTypetype :ty :ast declId: ddec9
    ttv9: ztypes.ztypetype.nullType
    classified9: false
    match (
        tto9
    ) case some then {
        ttv9 = tto9
        classified9 = true
    } case none then null
    tid9: u64
    if classified9 then tid9 = (declareCanonicalType
        :ast
        :ty
        :reg
        :unitDecl
        ownerNameId: zast.nameid
        :name
        typetype: ttv9
    )
    if classified9 == false then {
        alo9: resolveAliasKey :ty :reg :ast declId: ddec9
        if alo9 > 0 then return (ztypes.tid.create from: alo9.u64)
    }
    ddecl9: declOfUnitDef :ty :ast :unitDecl :name
    if (defWasResolved
        :ty
        :unitDecl
        nameId: (zast.poolFind pool: ast.names text: name)
    ) then {
        # already resolved -- but not necessarily by a path that registered the
        # generic parameters, and the spec trie cannot key a template whose
        # arity reads as zero.
        ensureDefGenericParams :ty :reg :ast declId: ddecl9
        return (ztypes.tid.create from: tid9)
    }
    if (ty.declIsResolving declId: ddecl9) then {
        # A grey hit is a back-edge. Reference-kind targets (UNION/CLASS --
        # boxed) are legal forward declarations; a VALUE-kind target reached
        # through a containment edge cannot lay out.
        if ty.inContainmentEdge then {
            cycV9: false
            if ttv9 == ztypes.ztypetype.recordType then cycV9 = true
            if ttv9 == ztypes.ztypetype.variantType then cycV9 = true
            # a NATIVE record (a scalar: `u8: record is native`) lays out
            # nothing of its own and can hold nothing by value: reaching it
            # grey through a containment edge (a conversion of another scalar
            # returning `(resultval t: u8 ...)` while u8's own methods
            # resolve) is a back-edge to a leaf, not a layout cycle
            if cycV9 when (declDefIsNative :ty :ast declId: ddecl9) then cycV9 = false
            if cycV9 then {
                cem9: "containment cycle: value type '\{unitNameTextOf :ty :ast :unitDecl}.\{name}' contains itself by value; box the field behind a class, union, or Option"
                addResolveError :ty e: zast.err.typeError msg: cem9
            }
        }
        return (ztypes.tid.create from: tid9)
    }
    if ddec9.isZero then return (ztypes.tid.create from: tid9.u64)
    dnode9: u64
    {
        dgo9: ty.decls.get i: ddec9.u64
        dnode9 = dgo9.node.u64
    }
    if dnode9 == 0 then return (ztypes.tid.create from: tid9.u64)
    bm9: ast.nodes.get i: dnode9
    if bm9.namedoperation then {
        (resolveDef
            :ty
            :reg
            :ast
            :unitDecl
            defName: name
            defn: (ast.nodes.get i: bm9.operation.u64)
        )
    }
    if classified9 == false then {
        ro9: resolveUnitChild :ast :ty :reg :unitDecl :name
        return (ztypes.tid.create from: (optU64Or o: ro9 d: 0))
    }
    return (ztypes.tid.create from: tid9)
}

# resolveDef -- dispatch a main-unit definition by kind. Resolves functions, data
# blocks, records, variants, unions, classes, facets and protocols; a top-level data
# block parses as an `expression` wrapping a `datablock`, so unwrap one level and
# re-dispatch. Enums and generics arrive in later slices.
resolveDef: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    defn: Node
} is {
    # a definition resolves in the frame it is written in, whatever path
    # asked for it. A definition the name index cannot place keeps the
    # caller's frame (a nested unit's member reached from its own unit walk).
    rdecl0: declOfUnitDef :ty :ast :unitDecl name: defName
    # every resolver funnels through here, so this is where a unit's toolchain
    # requirement is owed: before its first definition resolves.
    {
        ehd9: rdecl0
        if ehd9.isZero then ehd9 = ty.curFrame
        ensureUnitRequire :ty :reg :ast declId: ehd9
    }
    prevFrame9: ty.curFrame
    if (rdecl0.isZero) == false then ty.curFrame = declParentIdOf :ty declId: rdecl0
    resolveDefIn :ty :reg :ast :unitDecl :defName :defn
    ty.curFrame = prevFrame9
}

resolveDefIn: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    defn: Node
} is {
    rdecl0: declOfUnitDef :ty :ast :unitDecl name: defName
    enterUnitOnce :ty :ast :unitDecl
    # a definition's BODY reaches names its signature does not: a type
    # constructed, or a sibling function called, only inside it must be demanded
    # or it never resolves -- and the body walk then reports a perfectly valid
    # reference as unknown. It goes HERE because every resolver funnels through
    # resolveDef: the demand drain, the descent, and the conformance pass. The
    # scan only queues declarations that are not yet pending, resolving or
    # resolved, so a repeat visit costs a walk and queues nothing.
    scanDefCalls :ty :ast :reg op: defn
    ty.declSetResolving declId: rdecl0 mark: true
    # A containment edge is ONE hop: this def's own resolution starts a
    # fresh context (its field/arm legs re-arm the flag), so an outer field
    # bracket never taints nested param/return resolution.
    prevCE0: ty.inContainmentEdge
    ty.inContainmentEdge = false
    match (
        defn
    ) case functiondef then {
        fid: (resolveFunction
            :ty
            :reg
            :ast
            :unitDecl
            ownerNameId: zast.nameid
            :defName
            fnode: defn
            thisName: ""
            skipThisType: false
        )
        (ztyping.nodeTypeSet
            tbl: ty.nodeType
            nid: defn.nodeid.u64
            tid: (ztypes.tid.create from: fid.u64)
        )
        if (isGeneratorReturn :ast oId: defn.returntype) then {
            (synthGeneratorIterClass
                :ty
                :reg
                :ast
                :unitDecl
                fnName: defName
                thisName: ""
                fnode: defn
            )
        }
    } case expression then {
        dfx9: ast.nodes.getMut i: defn.expression.u64
        resolveDef :ty :reg :ast :unitDecl :defName defn: dfx9
        exprid: (resolvedByIds
            :ast
            :ty
            :unitDecl
            name: (zast.poolFind pool: ast.names text: defName)
        )
        match (
            exprid
        ) case some then {
            (ztyping.nodeTypeSet
                tbl: ty.nodeType
                nid: defn.nodeid.u64
                tid: (ztypes.tid.create from: exprid.u64)
            )
        } case none then null
    } case datablock then {
        resolveData :ast :ty :reg :unitDecl :defName dnode: defn
        dbrid: (resolvedByIds
            :ast
            :ty
            :unitDecl
            name: (zast.poolFind pool: ast.names text: defName)
        )
        match (
            dbrid
        ) case some then {
            (ztyping.nodeTypeSet
                tbl: ty.nodeType
                nid: defn.nodeid.u64
                tid: (ztypes.tid.create from: dbrid.u64)
            )
        } case none then null
    } case objectdef then {
        match (
            defn.kind
        ) case recordDef then {
            if defName == "null" then {
                registerEmptyType :ast :ty :reg :unitDecl name: "null" tt: ztypes.ztypetype.nullType
            } else {
                if defName == "never" then {
                    nvid9: (registerEmptyType
                        :ast
                        :ty
                        :reg
                        :unitDecl
                        name: "never"
                        tt: ztypes.ztypetype.neverType
                    )
                    (ztyping.nodeTypeSet
                        tbl: ty.nodeType
                        nid: defn.nodeid.u64
                        tid: (ztypes.tid.create from: nvid9.u64)
                    )
                } else {
                    resolveRecord :ty :reg :ast :unitDecl :defName rnode: defn
                }
            }
        } case variantDef then {
            resolveVariant :ty :reg :ast :unitDecl :defName vnode: defn
        } case unionDef then {
            resolveUnion :ty :reg :ast :unitDecl :defName vnode: defn
        } case classDef then {
            resolveClass :ty :reg :ast :unitDecl :defName cnode: defn
        } case facetDef then {
            resolveFacet :ty :reg :ast :unitDecl :defName fnode: defn
        } case protocolDef then {
            resolveProtocol :ty :reg :ast :unitDecl :defName fnode: defn
        } else null
        objrid: (resolvedByIds
            :ast
            :ty
            :unitDecl
            name: (zast.poolFind pool: ast.names text: defName)
        )
        match (
            objrid
        ) case some then {
            (ztyping.nodeTypeSet
                tbl: ty.nodeType
                nid: defn.nodeid.u64
                tid: (ztypes.tid.create from: objrid.u64)
            )
        } case none then null
    } case dottedpath then {
        # A unit-level type alias (`Node: zast.Node`): resolve the cross-unit dotted
        # ref to a (shell) type id and register it under the unit's name, so bare-alias
        # return types and value uses resolve. Replicates resolveTyperefShell's
        # cross-unit leg; mirrors the reference's _type_of_definition dotted-path
        # fallback (ztypecheck.py:1184).
        apNm9: atomName :ast n: (ast.nodes.get i: defn.parent.u64)
        apId9: atomNameId :ast n: (ast.nodes.get i: defn.parent.u64)
        if (nameDenotesUnit :ty :reg nameId: apId9) then {
            acNm9: atomName :ast n: (ast.nodes.get i: defn.child.u64)
            acId9: atomNameId :ast n: (ast.nodes.get i: defn.child.u64)
            demandUnitMember :ty unitNameId: apId9 nameId: acId9
            # The alias target is read off the re-export Decl's node on demand
            # (reexportTargetIdsOf); resolution reuses the target's canonical id.
            if (ty.declIsResolving
                declId: (declOfUnitDef
                    :ty
                    :ast
                    unitDecl: (unitDeclOfName :ty :ast name: apNm9.stringview)
                    name: acNm9.stringview
                )
            ) then {
                aem9: "alias cycle: '\{unitNameTextOf :ty :ast :unitDecl}.\{defName}' aliases '\{apNm9}.\{acNm9}' which is still resolving"
                addResolveError :ty e: zast.err.typeError msg: aem9
            }
            (descendNamed
                :ty
                :reg
                :ast
                unitDecl: (unitDeclOfName :ty :ast name: apNm9.stringview)
                name: acNm9.stringview
            )
            tgo9: resolvedByIds :ast :ty unitDecl: (unitDeclOfNameId :ty nameId: apId9) name: acId9
            aid9: u64
            match (
                tgo9
            ) case some then {
                aid9 = tgo9
            } case none then {
                aid9 = (resolveAtomType
                    :ty
                    :reg
                    :ast
                    :unitDecl
                    nm: acNm9.stringview
                    thisName: ""
                )
            }
            sda9: aid9
            (ztyping.nodeTypeSet
                tbl: ty.nodeType
                nid: defn.nodeid.u64
                tid: (ztypes.tid.create from: sda9.u64)
            )
            # a cross-unit `unit.Type` alias records its target's declaration
            # for go-to-definition (dotted node; see the type-position stamp)
            (stampRefDecl
                :ty
                nid: defn.nodeid.u64
                declId: (declOfTypeId :reg tid: (ztypes.tid.create from: sda9.u64))
            )
        }
    } else null
    # Unit -> def childOf edges are built at mint (declareCanonicalType) for real
    # defs and on demand (resolvedByIds' alias-follow) for aliases; no tail pass.
    ty.inContainmentEdge = prevCE0
    rdecl1: declOfUnitDef :ty :ast :unitDecl name: defName
    ty.declSetResolving declId: rdecl1 mark: false
    if (rdecl1.isZero) == false then {
        ty.declSetDefined declId: rdecl1
    }
}

# registerUnitGenericParams -- a generic FILE unit's own parameters: registered
# against its root Decl, each with a canonical per-(unit, param) GENERIC_PARAM
# tid the definition's value node carries, so template signatures and bodies
# stamp it. Run for EVERY unit, not only an eagerly-resolved one: it is a
# property of the declaration, and a unit that is resolved on demand has the
# same parameters as one that is not.
registerUnitGenericParams: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    unitdefId: zast.nodeid
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: unitdefId
    if (hasGenericParam :ast items: bodyIds9) then {
        urd0: ztypes.declid
        {
            uro0: unitDecl
            if (uro0.isZero) == false then urd0 = uro0
        }
        registerGenericParams :reg :ast tdecl: urd0 items: bodyIds9
        # Each generic-param name gets a canonical per-(unit,param)
        # GENERIC_PARAM tid (get-or-mint), attributed to the unit; the
        # param definition's value node carries it so template signatures
        # and bodies stamp it.
        with gpiter: bodyIds9.iterate do for gmId9: gpiter loop {
            gm: ast.nodes.get i: gmId9.u64
            match (
                gm
            ) case namedoperation then {
                if (isBareGenericParam
                    :ast
                    op: (ast.nodes.get i: gm.operation.u64)
                ) then {
                    gpn0: zast.nameTextAt :ast ref: gm.name
                    gtid0: ztypes.tid
                    gpo0: reg.genericParamTidOf tdecl: urd0 paramName: gpn0.stringview
                    match (
                        gpo0
                    ) case some then {
                        gtid0 = ztypes.tid.create from: (gpo0)
                    } case none then {
                        gtid0 = (reg.newType
                            name: gpn0.stringview
                            typetype: ztypes.ztypetype.genericParam
                        )
                        reg.setGenericParamTid tdecl: urd0 paramName: gpn0.stringview tid: gtid0
                    }
                    (linkDeclType
                        :ty
                        :reg
                        :ast
                        :unitDecl
                        name: gpn0.stringview
                        tid: (ztypes.tid.create from: gtid0.u64)
                    )
                    gpnid: nodeId n: (ast.nodes.get i: gm.operation.u64)
                    ztyping.nodeTypeSet tbl: ty.nodeType nid: gpnid.u64 tid: gtid0
                }
            } else null
        }
    }
}


# recordUnitConformerContexts -- record, for each of this unit's definitions
# that its own `main` names, the conformer its as-block markers bind their spec
# `this` to. The reference binds a spec receiver only when the conformer's
# resolution triggers the protocol's; a main body that never names the conformer
# resolves the protocol context-free (e.g. through a function signature).
# A property of the unit's own declarations, not of whether its body is walked
# eagerly -- so it runs for every unit, at the point in unit order the eager
# walk used to run it. A unit with no `main` of its own has nothing to record,
# which today is every unit but one.
recordUnitConformerContexts: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    unitDecl: ztypes.declid
    unitdefId: zast.nodeid
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: unitdefId
    # collect member names first -- the body list cannot be passed while its
    # iterator is live.
    ccNames: (List String)
    with cmiter: bodyIds9.iterate do for cmmId9: cmiter loop {
        cmm: ast.nodes.get i: cmmId9.u64
        ccn0: String
        match (
            cmm
        ) case namedoperation then {
            ccn1: zast.nameTextCopy :ast ref: cmm.name
            ccn0 = ccn1
        } else null
        ccNames.append ccn0
    }
    mainOp9: zast.nodeid
    with cmit0: bodyIds9.iterate do for cmm0: cmit0 loop {
        if mainOp9.isZero then {
            cmn0: ast.nodes.get i: cmm0.u64
            match (
                cmn0
            ) case namedoperation then {
                if (zast.nameTextEq
                    :ast
                    ref: cmn0.name
                    s: "main"
                ) then mainOp9 = cmn0.operation
            } else null
        }
    }
    if mainOp9.isZero then return
    uid9: unitNameIdOf :ty :unitDecl
    cci: u64
    ccTotal: ccNames.length
    for cci < ccTotal loop {
        cnm2: ccNames.get i: cci
        if cnm2.length > 0 then {
            if (fnBodyMentions
                :ast
                op: (ast.nodes.get i: mainOp9.u64)
                name: cnm2.stringview
            ) then {
                mem2Id9: bodyIds9.get i: cci
                mem2: ast.nodes.get i: mem2Id9.u64
                match (
                    mem2
                ) case namedoperation then {
                    (recordConformerContexts
                        :ast
                        :ty
                        unitDecl: (unitDeclOfNameId :ty nameId: uid9)
                        defName: cnm2.stringview
                        op: (ast.nodes.get i: mem2.operation.u64)
                    )
                } else null
            }
        }
        cci = cci + 1
    }
}

# resolveUnitBody -- resolve every top-level definition signature in a unit.
# resolveUnitBody -- resolve a unit's definition signatures. Signature-only
# resolves every member; the full body-walk mode mirrors check()'s eager set
# (functions and units only -- other definitions resolve on demand, so unused
# main-unit records/classes/unions drop out of the full dump).
resolveUnitBody: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    unitDecl: ztypes.declid
    unitdefId: zast.nodeid
    rootOnly: bool
} is {
    # a FILE unit is the one unit whose owner is looked up by name: nothing
    # holds its Decl the way an enclosing walk holds a nested unit's.
    # registerUnitRoots and indexUnitDefs both ran already, so both are there.
    ubPt9: ztypes.tid
    ubPd9: ztypes.declid
    {
        uo9: (declTypeIdOf
            :ty
            declId: unitDecl
        )
        if (uo9.isZero) == false then {
            ubPt9 = ztypes.tid.create from: uo9
        }
    }
    {
        ro9: unitDecl
        if (ro9.isZero) == false then ubPd9 = ro9
    }
    (resolveUnitMembers
        :ty
        :reg
        :ast
        :unitDecl
        ownerDeclId: ubPd9
        ownerTid: ubPt9
        unitOpId: unitdefId
        speculative: true
        :rootOnly
    )
}

# typecheck -- entry point. Registers a UNIT type per unit (the `unit` table)
# and resolves the main unit's definition signatures into the registry. The
# registry is supplied by the caller and read by the SQL dumper.
# registerAndResolveMain -- register a UNIT type per unit, then resolve the main
# unit's definition signatures. Iterates program.ast.units transiently so the demand
# pass can re-iterate it without an overlapping exclusive lock.
# registerUnitRoots -- Stage D: register a UNIT type for EVERY unit up front,
# before lowerGenerators / indexUnitDefs / demand resolution, so childOf-at-mint
# (declareCanonicalType) always sees a populated unit root. indexUnitDefs binds
# each type to the unit's Decl, keyed on the unitdef NODE -- by then the name
# would find that very Decl. The main unit precedes its deps in unit order, so a
# cross-unit qualified type ref (zlexer.Token) sees the dep as a unit; a member
# path types its base as the UNIT type through the program root's child of that
# name -- never the resolution chain, where a main unit sharing a type's name
# (str.z, panic.z) would shadow it. Formerly registerAndResolveMain Pass 1.
registerUnitRoots: function {ty: ztyping.ZTyping reg: ztypes.ZTypeRegistry program: Node} is {
    match (
        program
    ) case program then {
        uCnt9c: program.ast.units.length
        uIdx9c: u64
        for uIdx9c < uCnt9c loop {
            ruId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9c))
            uIdx9c = uIdx9c + 1
            opId9: zast.nodeid
            nm9: String
            {
                ru: program.ast.nodes.get i: ruId9.u64
                if ru.namedoperation then {
                    nm: zast.poolTextAt pool: program.ast.names ref: ru.name
                    opId9 = ru.operation
                    nm9 = nm.copy
                }
            }
            if opId9 > 0 then {
                uid: reg.newType name: nm9.stringview typetype: ztypes.ztypetype.unitType
                opid: unitdefNodeId ast: program.ast nId: opId9
                ty.unitTypesById.set key: opid.u64 value: uid
            }
        }
    } else null
}

# demandAllUnitDefs -- demand every top-level definition of a unit (the
# eager mode: a definition nothing references is still resolved, so an error
# inside it is reported).
demandAllUnitDefs: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    unitNameId: zast.nameid
    unitdefId: zast.nodeid
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: unitdefId
    with dit9: bodyIds9.iterate do for bm9Id9: dit9 loop {
        bm9: ast.nodes.get i: bm9Id9.u64
        if bm9.namedoperation then {
            demandUnitMember :ty :unitNameId nameId: bm9.name
        }
    }
}

# demandAllDefs -- demand every top-level definition of EVERY unit. Without
# it a definition nothing references is never resolved, so an error inside
# it is reported by nothing.
demandAllDefs: function {ty: ztyping.ZTyping program: Node} is {
    if (ty.eagerAll) == false then return
    match (
        program
    ) case program then {
        duN9: program.ast.units.length
        duI9: u64
        for duI9 < duN9 loop {
            duId9: (zast.nodeid.create from: (program.ast.units.get i: duI9))
            duI9 = duI9 + 1
            duOp9: zast.nodeid
            duNm9: zast.nameid
            {
                dun9: program.ast.nodes.get i: duId9.u64
                if dun9.namedoperation then {
                    duOp9 = dun9.operation
                    duNm9 = dun9.name
                }
            }
            if duOp9 > 0 then {
                demandAllUnitDefs :ty ast: program.ast unitNameId: duNm9 unitdefId: duOp9
            }
        }
    } else null
}

# noMainError -- the target unit declares no `main`, so demand has no root.
# Positioned on the unit's own definition: there is no node to point at, the
# absence IS the error.
noMainError: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    unitDecl: ztypes.declid
    unitdefId: zast.nodeid
} is {
    unc9: unitNameTextOf :ty :ast :unitDecl
    em9: "unit '\{unc9}' declares no 'main': there is nothing to compile it from"
    en9: (
        "compilation is demand-driven -- `main` is the root, and what it reaches is what gets checked and emitted"
    ).string
    eh9: (
        "add `main: function is { ... }`, or compile the program that opens this unit instead"
    ).string
    un9: ast.nodes.get i: unitdefId.u64
    ty.errors.append (zast.ErrorData
        nodeid: (nodeId n: un9)
        lineno: (nodeLine n: un9)
        colno: (nodeCol n: un9)
        width: unc9.length.u32.orPanic
        err: zast.err.noMain
        msg: em9
        fsno: zvfs.fsno
        note: en9
        hint: eh9
    )
    ty.isError = true
}

# register and resolve the program's main unit.
registerAndResolveMain: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    program: Node
} is {
    match (
        program
    ) case program then {
        unitDecl: ty.mainUnitRoot
        # Pass 1 (unit-root minting) hoisted to registerUnitRoots, run before lowerGenerators.
        # Pass 2: resolve EVERY file unit's definition signatures (main + deps
        # like zlexer/zast/zvfs), so cross-unit type refs resolve to the dep's
        # own type and the dep's type/fn def nodes get stamped for emission.
        muN0: program.ast.units.length
        muI0: u64
        for muI0 < muN0 loop {
            muId9: (zast.nodeid.create from: (program.ast.units.get i: muI0))
            muI0 = muI0 + 1
            opId9: zast.nodeid
            nm9: String
            {
                mu: program.ast.nodes.get i: muId9.u64
                if mu.namedoperation then {
                    nm: zast.poolTextAt pool: program.ast.names ref: mu.name
                    opId9 = mu.operation
                    nm9 = nm.copy
                }
            }
            if opId9 > 0 then {
                # a unit's own generic parameters are a property of its
                # DECLARATION, not of whether its body is walked eagerly. Kept
                # at this point in the unit order so an eagerly-resolved unit
                # mints them exactly when it did before.
                (registerUnitGenericParams
                    :ty
                    :reg
                    ast: program.ast
                    unitDecl: (unitDeclOfName :ty ast: program.ast name: nm9.stringview)
                    unitdefId: opId9
                )
                # what a unit's own `main` names about its conformers is a
                # property of its declarations too, recorded for every unit:
                # only the main unit's body is eagerly resolved.
                (recordUnitConformerContexts
                    :ty
                    ast: program.ast
                    unitDecl: (unitDeclOfName :ty ast: program.ast name: nm9.stringview)
                    unitdefId: opId9
                )
                uc0z9: unitDeclOfName :ty ast: program.ast name: nm9.stringview
                eager9: uc0z9 == unitDecl
                if eager9 then {
                    (resolveUnitBody
                        :ty
                        :reg
                        ast: program.ast
                        unitDecl: (unitDeclOfName :ty ast: program.ast name: nm9.stringview)
                        unitdefId: opId9
                        rootOnly: (ty.eagerAll) == false
                    )
                }
            }
        }
    } else null
}

# isConformanceMarker -- true when an as-item operation is a bare type reference
# (atomid / labelvalue), i.e. a conformance marker like `:Text` or `m: Reader`.
isConformanceMarker: function {op: Node.view} out bool is {
    match (
        op
    ) case atomid then {
        return true
    } case labelvalue then {
        return true
    } else {
        return false
    }
}

# declaresConformance -- true when an objectdef declares conformance via an as-item
# (the oracle eager-resolves such collections types on first touch of the unit).
declaresConformance: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case objectdef then {
        citer: op.asItems.iterate
        for cmId9: citer loop {
            cm: ast.nodes.get i: cmId9.u64
            match (
                cm
            ) case namedoperation then {
                if (isConformanceMarker op: (ast.nodes.get i: cm.operation.u64)) then return true
            } else null
        }
        return false
    } else {
        return false
    }
}

# enterUnitOnce -- a dependency unit's one-time pass, the first time any of
# its definitions resolves, whoever resolves it: demand the conformance
# declarers reference-following cannot reach (zvfs FSProvider) and the return
# / never the walk of its bodies uses. Not a property of the unit's NAME: a
# conformer is as unreachable in a user dependency as it is in collections.
# Queued, not resolved here: this runs inside whatever resolution reached the
# unit first, and the drain resolves them at the top level.
enterUnitOnce: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    unitDecl: ztypes.declid
} is {
    if unitDecl == ty.coreUnitRoot then return
    if unitDecl.isZero then return
    if (ty.enteredUnits.has item: unitDecl.u64) then return
    ty.enteredUnits.add item: unitDecl.u64
    if unitDecl == ty.mainUnitRoot then return
    ro9: unitDecl
    if (ro9.isZero) == false then {
        uop9: zast.nodeid
        {
            rdo9: ty.decls.get i: ro9.u64
            unop9: ast.nodes.get i: rdo9.node.u64
            if unop9.namedoperation then uop9 = unop9.operation
        }
        if (uop9.isZero) == false then {
            bodyIds9: zast.unitBodyIdsAt :ast unitId: uop9
            with biter9: bodyIds9.iterate do for bm9: biter9 loop {
                bmNode9: ast.nodes.get i: bm9.u64
                if bmNode9.namedoperation then {
                    if (declaresConformance
                        :ast
                        op: (ast.nodes.get i: bmNode9.operation.u64)
                    ) then (demandDecl
                        :ty
                        declId: (ty.declFindChild parentDeclId: ro9 nameId: bmNode9.name)
                    )
                }
            }
        }
    }
    demandReturnNever :ty :ast
}

# stampCtorDefaults -- a construction fills unprovided defaulted fields: the
# default's node stamps its resolved member/parent type, once the owner has
# actually been constructed (during the body walk).
stampCtorDefaults: function {ast: Ast.view st: zenv.ZSymbolTable unitDecl: ztypes.declid} is {
    dnids9: (ListVal u64)
    owners: (ListVal u64)
    with diter: st.typing.pendingDefaultOwner.iterateItems do for de: diter loop {
        dk: de.key
        dnids9.append dk
        dv: de.value
        owners.append dv
    }
    di: u64
    dn: dnids9.length
    for di < dn loop {
        ow: owners.get i: di
        cgot: st.typing.constructedTypes.get key: ow
        isCon: optBoolOr o: cgot d: false
        if isCon then {
            nd: dnids9.get i: di
            ido: st.typing.pendingDefaultId.get key: nd
            idv: optU64Or o: ido d: 0
            if idv > 0 then {
                nd2: dnids9.get i: di
                (ztyping.nodeTypeSet
                    tbl: st.typing.nodeType
                    nid: nd2
                    tid: (ztypes.tid.create from: idv.u64)
                )
            } else {
                nd3: dnids9.get i: di
                ng9: copiedMapStr m: st.typing.pendingDefaultName key: nd3
                if ng9.length > 0 then {
                    nrt: (optU64Or
                        o: (walkLookupTyperef
                            :ast
                            ty: st.typing
                            reg: st.reg
                            :unitDecl
                            base: ng9.stringview
                        )
                        d: 0
                    )
                    if nrt > 0 then {
                        nd4: dnids9.get i: di
                        (ztyping.nodeTypeSet
                            tbl: st.typing.nodeType
                            nid: nd4
                            tid: (ztypes.tid.create from: nrt.u64)
                        )
                    }
                }
            }
        }
        di = di + 1
    }
}

# fixupCustomTags -- bind deferred custom union tags: a `tag: X.tag` as-item
# whose data block resolved after the union (demand order) overrides the
# synthesized tag child once both exist.
fixupCustomTags: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
} is {
    pend: (ListVal u64)
    pnames: (List String)
    with citer: ty.pendingCustomTag.iterateItems do for ce: citer loop {
        ck: ce.key
        pend.append ck
        cvv: ce.value.stringview
        cv: cvv.string
        pnames.append cv
    }
    ci: u64
    cn: pend.length
    for ci < cn loop {
        cuid: pend.get i: ci
        cnm: pnames.get i: ci
        co: walkLookupTyperef :ast :ty :reg :unitDecl base: cnm.stringview
        ctid: optU64Or o: co d: 0
        if ctid > 0 then {
            if (reg.typetypeOf typeId: (ztypes.tid.create from: ctid.u64)) == ztypes.ztypetype.dataType then {
                cuidc: cuid
                (ty.declSynthMember
                    parentTypeId: (ztypes.tid.create from: cuidc.u64)
                    nameId: zast.wkTag
                    kind: ztyping.declkind.fieldDecl
                )
                (ty.setMemberType
                    parentTypeId: (ztypes.tid.create from: cuidc.u64)
                    nameId: zast.wkTag
                    childTypeId: ctid
                )
            } else {
                cuidn: cuid
                cngo: ty.pendingCustomTagNode.get key: cuidn
                cnid9: optU64Or o: cngo d: 0
                if cnid9 > 0 then {
                    tgo2: (resolvedByIds
                        :ast
                        :ty
                        unitDecl: (unitDeclOfNameId :ty nameId: (nameIdOf :ast name: "system"))
                        name: (zast.poolFind pool: ast.names text: "tag")
                    )
                    match (
                        tgo2
                    ) case some then {
                        (ztyping.nodeTypeSet
                            tbl: ty.nodeType
                            nid: cnid9
                            tid: (ztypes.tid.create from: tgo2.u64)
                        )
                    } case none then null
                }
            }
        }
        ci = ci + 1
    }
}

# bodyEndsInReturn -- true when a function body's last statement is a
# bare `return ...` call (the syntactic divergence the clone-scope synthesis
# needs; no stamps are made).
bodyEndsInReturn: function {ast: Ast.view bodyId: zast.nodeid} out bool is {
    if bodyId.isZero then return false
    return (blockEndsInReturn :ast block: (ast.nodes.get i: bodyId.u64))
}

# true when `block`'s last statement is a return.
blockEndsInReturn: function {ast: Ast.view block: Node.view} out bool is {
    match (
        block
    ) case statement then {
        ne: block.statements.length
        if ne > 0 then {
            lastId9: block.statements.get i: (ne - 1)
            last: ast.nodes.get i: lastId9.u64
            match (
                last
            ) case statementline then {
                return (stmtExprIsReturn :ast op: (ast.nodes.get i: last.statementline.u64))
            } else {
                return false
            }
        } else {
            return false
        }
    } else {
        return false
    }
}

# stmtExprIsReturn -- an expression statement whose inner call's callable is
# the `return` builtin.
stmtExprIsReturn: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case expression then {
        return (exprCallIsReturn :ast op: (ast.nodes.get i: op.expression.u64))
    } else {
        return false
    }
}

# true when operation `op` is a call to the `return` builtin.
exprCallIsReturn: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case call then {
        cn: atomName :ast n: (ast.nodes.get i: op.callable.u64)
        return cn.stringview == "return"
    } else {
        return false
    }
}

# isFunctionDefWithBody -- true when a node is a functiondef carrying a non-empty body
# (a real method, not a facet/protocol spec signature whose body is none).
isFunctionDefWithBody: function {o: Node.view} out bool is {
    match (
        o
    ) case functiondef then {
        return o.body > 0
    } else {
        return false
    }
}

# objectHasMethodBody -- true when an objectdef holds at least one is/as-item method
# with a body. Scans both blocks (transient iterators over different lists).
objectHasMethodBody: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case objectdef then {
        iiter: op.isItems.iterate
        for imId9: iiter loop {
            im: ast.nodes.get i: imId9.u64
            match (
                im
            ) case namedoperation then {
                if (isFunctionDefWithBody o: (ast.nodes.get i: im.operation.u64)) then return true
            } else null
        }
        aiter: op.asItems.iterate
        for amId9: aiter loop {
            am: ast.nodes.get i: amId9.u64
            match (
                am
            ) case namedoperation then {
                if (isFunctionDefWithBody o: (ast.nodes.get i: am.operation.u64)) then return true
            } else null
        }
        return false
    } else {
        return false
    }
}

# unitHasObjectMethodBody -- true when a unit body holds an objectdef with a method-body.
unitHasObjectMethodBody: function {ast: Ast.view defId: u32} out bool is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: defId
    biter: bodyIds9.iterate
    for bm: biter loop {
        bmNode9: ast.nodes.get i: bm.u64
        if bmNode9.namedoperation then {
            if (objectHasMethodBody
                :ast
                op: (ast.nodes.get i: bmNode9.operation.u64)
            ) then return true
        }
    }
    return false
}

# demandDecl -- a reference found this declaration: queue it for resolution
# unless it is resolved, mid-resolution, already queued, or a prelude
# re-export already followed to its target. The mark lives on the
# declaration, so the walk that finds a definition also finds its state.
demandDecl: function {ty: ztyping.ZTyping declId: ztypes.declid} is {
    if (ty.declIsPending :declId) then return
    if (ty.declIsResolving :declId) then return
    if (ty.declIsDefined :declId) then return
    {
        do9: ty.decls.get i: declId.u64
        if do9.parent == ty.coreUnitRoot when do9.typeId > 0 then return
    }
    ty.declSetPending :declId mark: true
    ty.pendingDefs.append from: declId
}

# demandDefinition -- a bare name written in `frame` demands the definition
# the environment walk finds for it, if any: a local variable, a member, or
# an unknown name finds nothing and demands nothing.
demandDefinition: function {
    ty: ztyping.ZTyping
    frame: ztypes.declid
    nameId: zast.nameid
} is {
    hit9: envLookup :ty :frame :nameId
    if (hit9.declId.isZero) == false then demandDecl :ty declId: hit9.declId
}

# demandUnitMember -- a qualified `unit.member` demands exactly that unit's
# member; the chain is not walked. A name the unit does not define directly
# may be an exported alias (`perimeter: perimImpl`), whose edge hangs under
# the unit's public block.
demandUnitMember: function {ty: ztyping.ZTyping unitNameId: zast.nameid nameId: zast.nameid} is {
    ro9: ty.declFindChild parentDeclId: ty.programRoot nameId: unitNameId
    if (ro9.isZero) == false then {
        d9: ty.declFindChild parentDeclId: ro9 :nameId
        if (d9.isZero) == false then {
            demandDecl :ty declId: d9
            return
        }
        pub9: publicNsChildOf :ty root: ro9
        if (pub9.isZero) == false then {
            e9: ty.declFindChild parentDeclId: pub9 :nameId
            if (e9.isZero) == false then {
                # a definition the block itself makes resolves with the
                # block, a nested unit (its constants key on the block's
                # id); an edge names a sibling of the unit, demanded as such
                ep9: declParentIdOf :ty declId: e9
                if ep9 == pub9 then {
                    demandDecl :ty declId: pub9
                } else {
                    demandDecl :ty declId: e9
                }
            }
        }
    }
}

# publicNsChildOf -- a unit root's `public:` block Decl, or zero. Read one
# child slot at a time: a second decls probe cannot run under a live
# children borrow.
publicNsChildOf: function {ty: ztyping.ZTyping root: ztypes.declid} out ztypes.declid is {
    return (ty.declPublicNsOf owner: root)
}

# owningUnitDecl9 -- the unit a declaration is written in: the nearest
# enclosing unit-kind Decl, or the declaration itself when it is one. Not the
# file root -- a subunit owns its own `require:` block, and `wideint`'s is not
# `system`'s.
owningUnitDecl9: function {ty: ztyping.ZTyping.view declId: ztypes.declid} out ztypes.declid is {
    cur9: declId
    for cur9 > 0 loop {
        do9: ty.decls.get i: cur9.u64
        if do9.kind.unitDecl then return cur9
        cur9 = do9.parent
    }
    return (ztypes.declid.create from: 0)
}

# ensureUnitRequire -- a unit's `require:` block states what it needs from the
# host toolchain, which makes it a precondition on using the unit: the FIRST
# declaration demanded from a unit resolves the block first, through the
# ordinary unit machinery, so a block with definitions of its own folds them in
# dependency order. Marking before demanding is what stops the regress --
# folding `library:` demands `platform.cc`, a declaration in `platform`, which
# re-enters here.
ensureUnitRequire: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    declId: ztypes.declid
} is {
    own9: owningUnitDecl9 :ty :declId
    if own9.isZero then return
    if (ty.requireSeen.has item: own9.u64) then return
    ty.requireSeen.add item: own9.u64
    rqn9: zast.poolFind pool: ast.names text: "require"
    if rqn9.isZero then return
    rq9: ty.declFindChild parentDeclId: own9 nameId: rqn9
    if rq9.isZero then return
    ty.requireDemanded.append from: rq9
    # a block that is demanded is one this program reaches, so a reached
    # `error` in it -- quadfloat's under tcc -- is this program's to hear, and
    # hearing it HERE is the point of the block: at the moment the unit is
    # first used, not after its C has been written. The ambient pending
    # failure belongs to whatever resolution we interrupted; save it.
    # the block guards on the toolchain, so the platform facts have to be in
    # place before it folds -- earlier than the main pass seeds them. Once.
    if (ty.platformSeeded) == false then {
        ty.platformSeeded = true
        seedPlatformConsts :ast :ty :reg
    }
    prevFail9: ty.constFail
    constFailClear :ty
    resolveDemandedDecl :ty :reg :ast declId: rq9
    # the block resolved as the unit it is; now DEMAND the fold of each entry,
    # which is what a general compile-time expression needs -- the eager
    # namespace walk folds only the simple forms.
    {
        ecnt9: ty.declChildSlots declId: rq9
        ei9: u64
        for ei9 < ecnt9 loop {
            ec9: ty.declChildAt declId: rq9 index: ei9
            ei9 = ei9 + 1
            if (ec9.isZero) == false then {
                enm9: ty.declNameOf declId: ec9
                enode9: u32
                {
                    ed9: ty.decls.get i: ec9.u64
                    enode9 = ed9.node
                }
                etx9: (zast.poolTextAt
                    pool: ast.names
                    ref: (zast.nameid.create from: enm9)
                )
                (constValueOfMemberAt
                    :ast
                    :ty
                    :reg
                    unitDecl: (unitDeclOfNameId
                        :ty
                        nameId: (zast.nameid.create from: (ty.declNameOf declId: own9))
                    )
                    ownerDecl: rq9
                    nameId: (zast.nameid.create from: enm9)
                    defNodeId: enode9
                    defName: etx9.stringview
                )
            }
        }
    }
    reportPendingConstFail :ty
    ty.constFail = prevFail9
}

# resolveDemandedDecl -- resolve one demanded declaration now, unless it is
# already resolved or mid-resolution: a prelude re-export follows its alias
# to the target; otherwise the dispatch is the unit sweeps' -- a namespace
# or subunit through resolveNamespaceUnit, a template through
# resolveInlineGenericUnit, every other definition through resolveDef.
resolveDemandedDecl: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    declId: ztypes.declid
} is {
    ty.declSetPending :declId mark: false
    if (ty.declIsResolving :declId) then return
    if (ty.declIsDefined :declId) then return
    ensureUnitRequire :ty :reg :ast :declId
    # a demanded declaration resolves in the frame it is written in -- its
    # parent -- whatever frame the demand came from
    pf9: ty.curFrame
    ty.curFrame = declParentIdOf :ty :declId
    resolveDemandedDeclIn :ty :reg :ast :declId
    ty.curFrame = pf9
}

resolveDemandedDeclIn: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    declId: ztypes.declid
} is {
    dName9: u32
    dParent9: ztypes.declid
    dNode9: u64
    dTid9: ztypes.tid
    {
        do9: ty.decls.get i: declId.u64
        dName9 = do9.name
        dParent9 = do9.parent
        dNode9 = do9.node.u64
        dTid9 = do9.typeId
    }
    if (declAtProgramTop :ty parentDeclId: dParent9) then return
    puNm9: u32
    {
        pdo9: ty.decls.get i: dParent9.u64
        puNm9 = pdo9.name
    }
    defName9: zast.poolTextAt pool: ast.names ref: (zast.nameid.create from: dName9)
    # a TEMPLATE's member: the template's own resolution minted every method
    # (resolveInlineGenericUnit), and its constants resolve together, keyed on
    # the template and evaluated in its frame -- the parent's NAME is no
    # unit-index key, so neither leg below could place one.
    if (declDeclaresTemplate :ty :ast declId: dParent9) then {
        if dTid9.isZero then {
            resolveTemplateConstants :ty :reg :ast tmplDeclId: dParent9
        }
        ty.declSetDefined :declId
        return
    }
    if dParent9 == ty.coreUnitRoot then {
        if dTid9.isZero then {
            resolveAliasKey :ty :reg :ast :declId
        }
        return
    }
    if dNode9 == 0 then return
    opId9: zast.nodeid
    {
        nop9: ast.nodes.get i: dNode9
        if nop9.namedoperation then opId9 = nop9.operation
    }
    if opId9.isZero then return
    isNs9: zast.unitOpDeclaresUnit :ast opId: opId9
    isTmpl9: (zast.unitOpKindIs :ast opId: opId9 k: zast.unitkind.template)
    if isNs9 then {
        # A unit is RESOLVED when its unitdef node carries an id; the DEFINED
        # mark on its Decl answers a different question and can be laid by a
        # path that never resolved it as a unit. So the mark does not gate this
        # leg -- only the resolution itself is skipped when the unit is already
        # built, and the debts below are owed however it got there.
        alreadyU9: false
        {
            unid9: unitdefNodeId :ast nId: opId9
            if (unid9.isZero) == false then {
                if (ztyping.nodeTypeAt tbl: ty.nodeType nid: unid9.u64) > 0 then alreadyU9 = true
            }
        }
        if (alreadyU9) == false then {
            (resolveNamespaceUnit
                :ty
                :reg
                :ast
                unitDecl: (unitDeclOfNameIdHere :ty nameId: (zast.nameid.create from: puNm9))
                defName: defName9.stringview
                parentTid: (unitTidOfName9 :ty unitNameId: (zast.nameid.create from: puNm9))
                parentDeclId: dParent9
                unitOpId: opId9
            )
        }
        ty.declSetDefined :declId
        # Signatures are resolved; the member bodies are owed a walk, which the
        # top-level drain does.
        (ty.nsBodiesOwed.append
            (ztyping.nsbody
                unitName: (zast.nameid.create from: puNm9)
                unitOp: opId9
            )
        )
        # The members just resolved recorded their signature type-refs the way
        # every definition does, and a unit materialises at whatever point
        # something first asks for it -- which can be after the post-demand
        # stamp pass. Stamp them here, as the drain stamps what it resolved:
        # unstamped, a re-exported function's return type reads as nothing and
        # its call sites reach the emitter bare.
        (stampPendingTyperefs
            :ty
            :reg
            :ast
            unitDecl: ty.mainUnitRoot
        )
    } else if isTmpl9 then {
        (resolveInlineGenericUnit
            :ty
            :reg
            :ast
            unitDecl: (unitDeclOfNameIdHere :ty nameId: (zast.nameid.create from: puNm9))
            defName: defName9.stringview
            parentTid: (unitTidOfName9 :ty unitNameId: (zast.nameid.create from: puNm9))
            parentDeclId: dParent9
            unitOpId: opId9
        )
        ty.declSetDefined :declId
    } else if (isUnitOp op: (ast.nodes.get i: opId9.u64)) then {
        # an inline `unit { ... }` resolves as the namespace it is. The walk
        # reaches one when it walks the enclosing unit; a DEMAND for one --
        # a `require:` block owed before its unit's first definition -- has to
        # reach the same door, or the members never resolve and their
        # constants never fold.
        alreadyI9: false
        {
            uni9: unitdefNodeId :ast nId: opId9
            if (uni9.isZero) == false then {
                if (ztyping.nodeTypeAt tbl: ty.nodeType nid: uni9.u64) > 0 then alreadyI9 = true
            }
        }
        if (alreadyI9) == false then {
            (resolveNamespaceUnit
                :ty
                :reg
                :ast
                unitDecl: (unitDeclOfNameIdHere :ty nameId: (zast.nameid.create from: puNm9))
                defName: defName9.stringview
                parentTid: (unitTidOfName9 :ty unitNameId: (zast.nameid.create from: puNm9))
                parentDeclId: dParent9
                unitOpId: opId9
            )
        }
        ty.declSetDefined :declId
        return
    } else {
        # A re-export is a definition like any other, and resolving it means
        # following its target -- which is what resolveAliasKey does, from the
        # declaration. Without this a re-export of a re-export stops at the
        # first hop: the second alias is demanded, resolveDef has no leg for a
        # dotted target that names a NESTED unit, and the chain reads as a
        # member the parent does not have.
        isRx9: false
        {
            rdo9: ty.decls.get i: declId.u64
            if rdo9.kind.reexportDecl then isRx9 = true
        }
        if isRx9 then {
            resolveAliasKey :ty :reg :ast :declId
        } else {
            (resolveDef
                :ty
                :reg
                :ast
                unitDecl: (unitDeclOfNameIdHere :ty nameId: (zast.nameid.create from: puNm9))
                defName: defName9.stringview
                defn: (ast.nodes.get i: opId9.u64)
            )
        }
        # A unit-level CONSTANT is a definition like any other, and resolveDef
        # has no leg for the shapes one takes -- a bare literal, a suffixed
        # one, a constant expression. Its type and its value are registered
        # here, where the reference that demanded it is asking. The eager tier
        # walks every definition of every unit instead, so exactly one of the
        # two speaks.
        if ty.eagerAll then return
        (resolveConstantMember
            :ty
            :reg
            :ast
            unitDecl: (unitDeclOfNameIdHere :ty nameId: (zast.nameid.create from: puNm9))
            defName: defName9.stringview
            defn: (ast.nodes.get i: opId9.u64)
        )
    }
}

# unitTidOfName9 -- the unit type a unit name stands for, as the sweeps read
# it: the declared type of the program root's child of that name.
unitTidOfName9: function {
    ty: ztyping.ZTyping.view
    unitNameId: zast.nameid
} out ztypes.tid is {
    uo9: declTypeIdOf :ty declId: (ty.declFindChild parentDeclId: ty.programRoot nameId: unitNameId)
    if (uo9.isZero) == false then return (ztypes.tid.create from: uo9.u64)
    return (ztypes.tid.create from: 0)
}

# resolveDemandedDefs -- resolve every demanded declaration, in discovery
# order, including the ones each resolution demands in turn: a definition's
# body is scanned once its own resolution completes, so a callee is never
# resolved inside its caller's grey window. A drain that is already running
# resolves whatever a nested request queued, so the nested call returns.
resolveDemandedDefs: function {ty: ztyping.ZTyping reg: ztypes.ZTypeRegistry ast: Ast} is {
    if ty.drainingDefs then return
    if ty.pendingDefs.length == 0 then return
    ty.drainingDefs = true
    # a drain runs in a neutral resolution context: it may be requested from
    # inside a body walk, whose template / containment state belongs to that
    # body, not to the definitions resolved here (each of which sets the
    # cursor from its own declaration)
    pCf9: ty.curFrame
    pCe9: ty.inContainmentEdge
    pSup9: ty.suppressParamStamps
    pMs9: ty.curMonoStamp
    pMf9: ty.curMonoFnTid
    ty.inContainmentEdge = false
    ty.suppressParamStamps = false
    ty.curMonoStamp = 0
    ty.curMonoFnTid = ztypes.tid
    i9: u64
    for i9 < ty.pendingDefs.length loop {
        d9: ty.pendingDefs.get i: i9
        i9 = i9 + 1
        resolveDemandedDecl :ty :reg :ast declId: d9
    }
    ty.pendingDefs = (ListVal ztypes.declid)
    # after the post-demand stamp pass, a drain stamps what it recorded
    if ty.typerefPassRan then {
        (stampPendingTyperefs
            :ty
            :reg
            :ast
            unitDecl: ty.mainUnitRoot
        )
    }
    ty.curFrame = pCf9
    ty.inContainmentEdge = pCe9
    ty.suppressParamStamps = pSup9
    ty.curMonoStamp = pMs9
    ty.curMonoFnTid = pMf9
    ty.drainingDefs = false
}

# scanCallsInNode -- the body-walk pre-pass: every name a subtree references
# demands the definition the scanning unit's environment holds for it, so the
# callee is resolved before the walk runs. A bare callable or atom walks the
# unit's frames (unit, then prelude); a qualified unit.member goes straight to
# that unit's member; `return` pulls return and never. A local variable or a
# member finds no definition and demands nothing.
scanCallsInNode: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    reg: ztypes.ZTypeRegistry
    node: Node.view
} is {
    match (
        node
    ) case statement then {
        for stmId9: node.statements.iterate loop {
            scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: stmId9.u64)
        }
    } case statementline then {
        (scanCallsInNode
            :ty
            :ast
            :reg
            node: (ast.nodes.get i: node.statementline.u64)
        )
    } case expression then {
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.expression.u64)
    } case call then {
        cn: atomName :ast n: (ast.nodes.get i: node.callable.u64)
        if cn.stringview == "return" then {
            scFr9: unitFrameOf :ty declId: ty.curFrame
            demandDefinition :ty frame: scFr9 nameId: zast.wkReturn
            (demandDefinition
                :ty
                frame: scFr9
                nameId: (zast.poolFind pool: ast.names text: "never")
            )
        } else {
            if cn.length > 0 then (demandDefinition
                :ty
                frame: (unitFrameOf :ty declId: ty.curFrame)
                nameId: (atomNameId :ast n: (ast.nodes.get i: node.callable.u64))
            )
        }
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.callable.u64)
        for argId9: node.arguments.iterate loop {
            arg: ast.nodes.get i: argId9.u64
            match (
                arg
            ) case namedoperation then {
                (scanCallsInNode
                    :ty
                    :ast
                    :reg
                    node: (ast.nodes.get i: arg.operation.u64)
                )
            } else null
        }
    } case atomstring then {
        for spId9: node.stringparts.iterate loop {
            scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: spId9.u64)
        }
    } case atomid then {
        # bare body identifiers demand main-unit definitions (unit constants,
        # data blocks); non-definition names never match a demanded def.
        scN9: ast.names.texts.get i: node.name.u64
        if (isNumericLiteralName name: scN9.stringview) == false then {
            (demandDefinition
                :ty
                frame: (unitFrameOf :ty declId: ty.curFrame)
                nameId: node.name
            )
        }
    } case binop then {
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.lhs.u64)
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.rhs.u64)
    } case assignment then {
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.value.u64)
    } case reassignment then {
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.topath.u64)
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.value.u64)
    } case ifexpr then {
        # Deliberately branch-blind. This pass runs before resolveConstantDefs,
        # so no fold exists yet and a dead clause's names are demanded anyway.
        # Over-demanding is CONSERVATIVE, and the invariant it protects is that
        # the constant fold may only ever remove EMISSION -- never change which
        # names resolve, and never be the thing that reports an error from a
        # branch that cannot run. That is why a reached `error` is reported by
        # the evaluator, which visits only the winning branch, and not by a
        # walk like this one, which sees every arm.
        for clId9: node.clauses.iterate loop {
            scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: clId9.u64)
        }
        scanBodyAt :ty :ast :reg bodyId: node.elseclause
    } case forexpr then {
        (demandDefinition
            :ty
            frame: (unitFrameOf :ty declId: ty.curFrame)
            nameId: (zast.poolFind pool: ast.names text: "never")
        )
        for fcId9: node.conditions.iterate loop {
            fc: ast.nodes.get i: fcId9.u64
            match (
                fc
            ) case namedoperation then {
                (scanCallsInNode
                    :ty
                    :ast
                    :reg
                    node: (ast.nodes.get i: fc.operation.u64)
                )
            } else null
        }
        scanBodyAt :ty :ast :reg bodyId: node.body
        for fpId9: node.postconditions.iterate loop {
            fp: ast.nodes.get i: fpId9.u64
            match (
                fp
            ) case namedoperation then {
                (scanCallsInNode
                    :ty
                    :ast
                    :reg
                    node: (ast.nodes.get i: fp.operation.u64)
                )
            } else null
        }
    } case doexpr then {
        doFr9: unitFrameOf :ty declId: ty.curFrame
        (demandDefinition
            :ty
            frame: doFr9
            nameId: (zast.poolFind pool: ast.names text: "never")
        )
        if (blockHasBreak :ast n: (ast.nodes.get i: node.statement.u64)) then {
            (demandDefinition
                :ty
                frame: doFr9
                nameId: (zast.poolFind pool: ast.names text: "optionval")
            )
        }
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.statement.u64)
    } case withexpr then {
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.value.u64)
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.body.u64)
    } case yieldexpr then {
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.expr.u64)
    } case swapstmt then {
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.lhs.u64)
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.rhs.u64)
    } case typeofexpr then {
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.source.u64)
    } case dottedpath then {
        bn: atomName :ast n: (ast.nodes.get i: node.parent.u64)
        if bn.length > 0 then {
            (demandDefinition
                :ty
                frame: (unitFrameOf :ty declId: ty.curFrame)
                nameId: (atomNameId :ast n: (ast.nodes.get i: node.parent.u64))
            )
            # a unit-qualified member (io.stdout) demands exactly that member
            isUnitQ: nameDenotesUnit :ty :reg nameId: (atomNameId
                :ast
                n: (ast.nodes.get i: node.parent.u64)
            )
            if isUnitQ then {
                mn0: atomName :ast n: (ast.nodes.get i: node.child.u64)
                if mn0.length > 0 then (demandUnitMember
                    :ty
                    unitNameId: (atomNameId :ast n: (ast.nodes.get i: node.parent.u64))
                    nameId: (atomNameId :ast n: (ast.nodes.get i: node.child.u64))
                )
            }
        }
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.parent.u64)
    } case caseexpr then {
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.subject.u64)
        for clId9: node.clauses.iterate loop {
            scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: clId9.u64)
        }
        scanBodyAt :ty :ast :reg bodyId: node.elseclause
    } case caseclause then {
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.statement.u64)
    } case ifclause then {
        for cndId9: node.conditions.iterate loop {
            cnd: ast.nodes.get i: cndId9.u64
            match (
                cnd
            ) case namedoperation then {
                (scanCallsInNode
                    :ty
                    :ast
                    :reg
                    node: (ast.nodes.get i: cnd.operation.u64)
                )
            } else null
        }
        scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: node.statement.u64)
    } else null
}

# scanBodyAt -- scan a function body table id for call demands (0 = absent).
scanBodyAt: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    bodyId: zast.nodeid
} is {
    if bodyId > 0 then (scanCallsInNode
        :ty
        :ast
        :reg
        node: (ast.nodes.get i: bodyId.u64)
    )
}

# scanDefCalls -- scan a functiondef's body, or an objectdef's is/as method
# bodies, for call demands. A type constructed only inside a method body must be
# demanded here or it never resolves and the construction stamps type 0.
scanDefCalls: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    op: Node.view
} is {
    match (
        op
    ) case functiondef then {
        scanBodyAt :ty :ast :reg bodyId: op.body
    } case objectdef then {
        iiter: op.isItems.iterate
        for imId9: iiter loop {
            im: ast.nodes.get i: imId9.u64
            match (
                im
            ) case namedoperation then {
                if (isFunctionDefWithBody o: (ast.nodes.get i: im.operation.u64)) then (scanDefCalls
                    :ty
                    :ast
                    :reg
                    op: (ast.nodes.get i: im.operation.u64)
                )
            } else null
        }
        aiter: op.asItems.iterate
        for amId9: aiter loop {
            am: ast.nodes.get i: amId9.u64
            match (
                am
            ) case namedoperation then {
                if (isFunctionDefWithBody o: (ast.nodes.get i: am.operation.u64)) then (scanDefCalls
                    :ty
                    :ast
                    :reg
                    op: (ast.nodes.get i: am.operation.u64)
                )
            } else null
        }
    } else null
}

# scanMainBodyCalls -- record call-target demands for every function body in the
# main unit (the body walk reaches them; demand must precede the pass).
scanMainBodyCalls: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    program: Node
    rootOnly9: bool
} is {
    match (
        program
    ) case program then {
        unitDecl: ty.mainUnitRoot
        uCnt9f: program.ast.units.length
        uIdx9f: u64
        for uIdx9f < uCnt9f loop {
            uId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9f))
            uIdx9f = uIdx9f + 1
            opId9: zast.nodeid
            unId9f: zast.nameid
            eager9: false
            {
                u: program.ast.nodes.get i: uId9.u64
                if u.namedoperation then {
                    uc1z9: unitDeclOfNameIdHere :ty nameId: u.name
                    if uc1z9 == unitDecl then eager9 = true
                    opId9 = u.operation
                    unId9f = u.name
                }
            }
            if eager9 when opId9 > 0 then {
                (scanUnitCalls
                    :ty
                    :reg
                    ast: program.ast
                    unitdefId: opId9
                    rootOnly: rootOnly9
                )
            }
        }
    } else null
}

# scanUnitCalls -- scan each function definition's body in a unit for call demands.
scanUnitCalls: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitdefId: zast.nodeid
    rootOnly: bool
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: unitdefId
    for bmId9: bodyIds9.iterate loop {
        bm: ast.nodes.get i: bmId9.u64
        if bm.namedoperation then {
            scanIt9: true
            if rootOnly then {
                bnm9: zast.nameTextAt :ast ref: bm.name
                if bnm9.stringview != "main" then scanIt9 = false
            }
            if scanIt9 then {
                scanDefCalls :ty :ast :reg op: (ast.nodes.get i: bm.operation.u64)
            }
        }
    }
}

# demandReturnNever -- the builtins a walked or synthesized body uses without
# naming them in source: system's `return` and its `never` result.
demandReturnNever: function {ty: ztyping.ZTyping ast: Ast.view} is {
    sysId9: nameIdOf :ast name: "system"
    demandUnitMember :ty unitNameId: sysId9 nameId: zast.wkReturn
    demandUnitMember :ty unitNameId: sysId9 nameId: (zast.poolFind pool: ast.names text: "never")
}

seedBodyWalkDemands: function {ty: ztyping.ZTyping program: Node} is {
    match (
        program
    ) case program then {
        unitDecl: ty.mainUnitRoot
        found: false
        uiter: program.ast.units.iterate
        for uId9: uiter loop {
            u: program.ast.nodes.get i: uId9.u64
            match (
                u
            ) case namedoperation then {
                uc2z9: unitDeclOfNameIdHere :ty nameId: u.name
                if uc2z9 == unitDecl then {
                    if (unitHasObjectMethodBody
                        ast: program.ast
                        defId: u.operation
                    ) then found = true
                }
            } else null
        }
        if found then demandReturnNever :ty ast: program.ast
    } else null
}

# resolveDemands -- resolve everything the program has demanded so far, and
# everything those resolutions demand in turn: the body-walk seeds first, then
# the queue to exhaustion. Each unit's one-time conformance pass runs from the
# drain the first time one of its definitions resolves.
resolveDemands: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    program: Node
} is {
    seedBodyWalkDemands :ty :program
    match (
        program
    ) case program then {
        resolveDemandedDefs :ty :reg ast: program.ast
    } else null
}

# instCallablePath -- an instantiation callable's name path as pool ids,
# outermost first: `mathops` -> [mathops], `helperu.mathops` -> [helperu,
# mathops]. A segment that is not a plain name appends 0, which
# instTemplateDecl then rejects -- there is no name to look up.
instCallablePath: function {ast: Ast.view op: Node.view segs: (ListVal u64)} is {
    match (
        op
    ) case expression then {
        instCallablePath :ast op: (ast.nodes.get i: op.expression.u64) :segs
    } case dottedpath then {
        instCallablePath :ast op: (ast.nodes.get i: op.parent.u64) :segs
        segs.append (atomNameId :ast n: (ast.nodes.get i: op.child.u64)).u64
    } case atomid then {
        segs.append op.name.u64
    } else {
        segs.append 0
    }
}

# callableInstPath -- the path of a binding whose value is a (possibly
# expression-wrapped) call. Empty for anything else, which is what says a
# binding is not an instantiation. Replaces reading a single atom name: a
# dotted callable named another unit's template and yielded "" instead, so no
# request was built at all -- silently, not as an error.
callableInstPath: function {ast: Ast.view op: Node.view segs: (ListVal u64)} is {
    match (
        op
    ) case expression then {
        callableInstPath :ast op: (ast.nodes.get i: op.expression.u64) :segs
    } case call then {
        instCallablePath :ast op: (ast.nodes.get i: op.callable.u64) :segs
    } else null
}

# callableUnitName -- the callable's bare name when a binding value is a
# (possibly expression-wrapped) call, else "". A for-loop's inline generator
# iterable is named this way; a generic-unit instantiation is not -- it reads
# callableInstPath, which a dotted callable does not defeat.
callableUnitName: function {ast: Ast.view op: Node.view} out String is {
    match (
        op
    ) case expression then {
        return (callableUnitName :ast op: (ast.nodes.get i: op.expression.u64))
    } case call then {
        return (atomName :ast n: (ast.nodes.get i: op.callable.u64))
    } else {
        return "".string
    }
}


# declParentIdOf -- a declaration's enclosing declaration (0 at the program root).
# declNameIdOf -- a declaration's own name id, or 0.
declNameIdOf: function {ty: ztyping.ZTyping.view declId: ztypes.declid} out zast.nameid is {
    do9: ty.decls.get i: declId.u64
    return (zast.nameid.create from: do9.name)
}

# unitRootOfDecl -- the top-level unit root a declaration sits under: the
# parent chain to the program root's own child. A definition of a NESTED unit
# answers with the file unit that loaded it, which is the unit the name walkers
# and the diagnostics are keyed on.
unitRootOfDecl: function {ty: ztyping.ZTyping.view declId: ztypes.declid} out ztypes.declid is {
    cur9: declId
    for cur9 > 0 loop {
        par9: ztypes.declid
        {
            do9: ty.decls.get i: cur9.u64
            par9 = do9.parent
        }
        if (declAtProgramTop :ty parentDeclId: par9) then return cur9
        cur9 = par9
    }
    return (ztypes.declid.create from: 0)
}

declParentIdOf: function {ty: ztyping.ZTyping.view declId: ztypes.declid} out ztypes.declid is {
    r9: ztypes.declid
    do9: ty.decls.get i: declId.u64
    r9 = do9.parent
    return r9
}

# declAtProgramTop -- is this parent id the top of the declaration tree: no
# parent at all, or the program root whose children are the file units? The
# question every walk out of a file unit asks.
declAtProgramTop: function {ty: ztyping.ZTyping.view parentDeclId: ztypes.declid} out bool is {
    if parentDeclId.isZero then return true
    if parentDeclId == ty.programRoot then return true
    return false
}

# instTemplateDecl -- the DECLARATION an instantiation's callable path names,
# resolved through the scope the instantiation was WRITTEN in: this namespace,
# then each enclosing one out to the unit root, then a file unit of that name.
# Nothing reaches into another unit except by naming it -- a dependency unit
# cannot see the main unit's constants or namespaces, and an instantiation is
# no different. 0 when the path names no declaration.
instTemplateDecl: function {
    ty: ztyping.ZTyping.view
    scopeDeclId: ztypes.declid
    segs: (ListVal u64).view
} out ztypes.declid is {
    cur: ztypes.declid
    if segs.length == 0 then return cur
    s0v9: segs.get i: 0
    if s0v9 == 0 then return cur
    s0: zast.nameid.create from: s0v9.u32.orPanic
    probe: scopeDeclId
    for probe > 0 loop {
        c9: ty.declFindChild parentDeclId: probe nameId: s0
        if (c9.isZero) == false then cur = c9
        if (cur.isZero) == false then {
            probe = ztypes.declid.create from: 0
        } else {
            probe = declParentIdOf :ty declId: probe
        }
    }
    if cur.isZero then {
        ro9: ty.declFindChild parentDeclId: ty.programRoot nameId: s0
        if (ro9.isZero) == false then cur = ro9
    }
    if cur.isZero then return cur
    si9: u64
    si9 = 1
    for si9 < segs.length loop {
        sv9: segs.get i: si9
        if sv9 == 0 then return (ztypes.declid.create from: 0)
        cur = (ty.declFindChild
            parentDeclId: cur
            nameId: (zast.nameid.create from: sv9.u32.orPanic)
        )
        if cur.isZero then return cur
        si9 = si9 + 1
    }
    return cur
}

# instTemplateOpOf -- the unitdef node a template declaration introduces, and 0
# when the declaration is not a generic unit at all. Both spellings count: an
# inline `unit as {...}` parses as `template`, and a generic FILE unit's root
# keeps its own kind but declares a generic parameter.
instTemplateOpOf: function {
    ty: ztyping.ZTyping.view
    ast: Ast.view
    declId: ztypes.declid
} out zast.nodeid is {
    none9: zast.nodeid
    if declId.isZero then return none9
    dn9: u32
    {
        do9: ty.decls.get i: declId.u64
        dn9 = do9.node
    }
    if dn9 == 0 then return none9
    op9: zast.nodeid
    {
        nop9: ast.nodes.get i: dn9.u64
        if nop9.namedoperation then op9 = nop9.operation
    }
    if op9.isZero then return none9
    if (zast.unitOpKindIs :ast opId: op9 k: zast.unitkind.template) then return op9
    udn9: unitdefNodeId :ast nId: op9
    if udn9.isZero then return none9
    if (unitDefIsGeneric :ast oId: udn9) then return op9
    return none9
}


# declTypeIdOf -- the type a declaration carries (0 until one is bound).
declTypeIdOf: function {ty: ztyping.ZTyping.view declId: ztypes.declid} out ztypes.tid is {
    r9: ztypes.tid
    do9: ty.decls.get i: declId.u64
    r9 = do9.typeId
    return r9
}

# collectMainInstantiations -- scan a unit body for generic-unit instantiation bindings
# and append the mono name ({template}_{arg}) + template name to the parallel lists.
# InstReq -- one generic-unit instantiation binding (intmath: (mathops t: i64)):
# the names the mint needs plus the binding's node ids for the instantiation stamps.
InstReq: class {
    # the unit the instantiation was WRITTEN in. Every lookup a request drives
    # -- the template, the type arguments, the binding name -- is relative to
    # it, and reading them off the main unit is why a generic unit worked only
    # there.
    declUnit: ztypes.declid
    bind: String
    tmpl: String
    # the template's own id, the unitdef node that declares it, and the unit
    # whose AST that node lives in -- all resolved at COLLECTION, through the
    # scope the instantiation was written in. A name reached only a top-level
    # binding of the instantiating unit; an id reaches a dotted or
    # namespace-nested template too.
    tmplTid: ztypes.tid
    tmplDeclId: ztypes.declid
    tmplOpId: u64
    tmplUnit: ztypes.declid
    # the Decl the instantiation was written under: the unit root, or the
    # namespace when it is nested. Where the binding's own name belongs.
    scopeDeclId: ztypes.declid
    argLabels: (List String)
    argNames: (List String)
    argAtomIds: (ListVal u64)
    # every argument's operation node, whatever its shape: a bare atom names
    # its type (argNames); a call-shaped argument -- itself a specialisation,
    # `(Box t: i64)` -- has no name and resolves from this node
    argNodeIds: (ListVal u64)
    exprId: u64
    callId: u64
    calId: u64
}

# instFillIds -- record the instantiation's expression/call/callable/arg node
# ids on the request (the reference stamps all four at binding resolution).
instFillIds: function {ast: Ast.view r: InstReq op: Node.view} is {
    match (
        op
    ) case expression then {
        r.exprId = op.nodeid.u64
        instFillIds :ast :r op: (ast.nodes.get i: op.expression.u64)
    } case call then {
        r.callId = op.nodeid.u64
        instFillCallable :r op: (ast.nodes.get i: op.callable.u64)
    } else null
}

# fill an instantiation request's callable from operation `op`.
instFillCallable: function {r: InstReq op: Node.view} is {
    match (
        op
    ) case atomid then {
        r.calId = op.nodeid.u64
    } case dottedpath then {
        r.calId = op.nodeid.u64
    } else null
}

# the atom id of an instantiation-call argument.
instArgAtomId9: function {ast: Ast.view op: Node.view} out u64 is {
    match (
        op
    ) case expression then {
        return (instArgAtomId9 :ast op: (ast.nodes.get i: op.expression.u64))
    } case atomid then {
        return op.nodeid.u64
    } else {
        return 0
    }
}

# fillUnitArgs -- capture every instantiation argument (param label + type/value
# name + atom id) in declaration order, so a unit monomorphises over ALL its
# generic parameters, not just the first.
fillUnitArgs: function {ast: Ast.view r: InstReq op: Node.view} is {
    match (
        op
    ) case expression then {
        fillUnitArgs :ast :r op: (ast.nodes.get i: op.expression.u64)
    } case call then {
        aiter: op.arguments.iterate
        for a9Id9: aiter loop {
            a9: ast.nodes.get i: a9Id9.u64
            match (
                a9
            ) case namedoperation then {
                lbl9: zast.nameTextCopy :ast ref: a9.name
                anm9: atomName :ast n: (ast.nodes.get i: a9.operation.u64)
                aid9: instArgAtomId9 :ast op: (ast.nodes.get i: a9.operation.u64)
                r.argLabels.append lbl9
                r.argNames.append anm9
                r.argAtomIds.append aid9
                r.argNodeIds.append a9.operation.u64
            } else null
        }
    } else null
}

# collect the generic instantiation requests reachable from main.
collectMainInstantiations: function {
    ty: ztyping.ZTyping.view
    ast: Ast.view
    o: Node.view
    unitDecl: ztypes.declid
    scopeDeclId: ztypes.declid
    reqs: List InstReq
} is {
    match (
        o
    ) case unitdef then {
        biter: o.body.iterate
        for bm: biter loop {
            bmNode9: ast.nodes.get i: bm.u64
            match (
                bmNode9
            ) case namedoperation then {
                mop9: ast.nodes.get i: bmNode9.operation.u64
                # a namespace or subunit is a scope of its own: descend, so an
                # instantiation written one level in is collected too. A
                # template is not descended into -- it declares, it does not
                # instantiate.
                if (zast.unitOpDeclaresUnit :ast opId: bmNode9.operation) then {
                    (collectMainInstantiations
                        :ty
                        :ast
                        o: mop9
                        :unitDecl
                        scopeDeclId: (ty.declFindChild
                            parentDeclId: scopeDeclId
                            nameId: bmNode9.name
                        )
                        :reqs
                    )
                } else {
                    segs9: (ListVal u64)
                    callableInstPath :ast op: mop9 segs: segs9
                    tdecl9: instTemplateDecl :ty :scopeDeclId segs: segs9
                    topId9: instTemplateOpOf :ty :ast declId: tdecl9
                    tn: String
                    if segs9.length > 0 then {
                        lastv9: segs9.get i: (segs9.length - 1)
                        if lastv9 > 0 then {
                            tnt9: (zast.poolTextAt
                                pool: ast.names
                                ref: (zast.nameid.create from: lastv9.u32.orPanic)
                            )
                            tn = tnt9.copy
                        }
                    }
                    if tn.length != 0 then {
                        bindn: zast.nameTextCopy :ast ref: bmNode9.name
                        tuN9: unitRootOfDecl :ty declId: tdecl9
                        r9: (InstReq
                            declUnit: unitDecl
                            bind: bindn
                            tmpl: tn.copy
                            tmplTid: (declTypeIdOf :ty declId: tdecl9)
                            tmplDeclId: tdecl9
                            tmplOpId: topId9.u64
                            tmplUnit: tuN9
                            :scopeDeclId
                            argLabels: (List String)
                            argNames: (List String)
                            argAtomIds: (ListVal u64)
                            argNodeIds: (ListVal u64)
                            exprId: 0
                            callId: 0
                            calId: 0
                        )
                        fillUnitArgs :ast r: r9 op: mop9
                        instFillIds :ast r: r9 op: mop9
                        reqs.append r9
                    }
                }
            } else null
        }
    } else null
}

# scanMainForInstantiations -- collect every unit's instantiation requests.
# Its own function scope bounds the program.ast.units iterator so it releases before the
# mono-creation pass (which iterates program.ast.units again).
scanMainForInstantiations: function {
    ty: ztyping.ZTyping.view
    program: Node
    reqs: (List InstReq).view
} is {
    match (
        program
    ) case program then {
        uiter: program.ast.units.iterate
        for uId9: uiter loop {
            u: program.ast.nodes.get i: uId9.u64
            match (
                u
            ) case namedoperation then {
                rd9: ztypes.declid
                {
                    ro9: (ty.declFindChild
                        parentDeclId: ty.programRoot
                        nameId: (zast.nameid.create from: u.name)
                    )
                    if (ro9.isZero) == false then rd9 = ro9
                }
                (collectMainInstantiations
                    :ty
                    ast: program.ast
                    o: (program.ast.nodes.get i: u.operation.u64)
                    unitDecl: (unitDeclOfNameIdHere :ty nameId: u.name)
                    scopeDeclId: rd9
                    :reqs
                )
            } else null
        }
    } else null
}

# attachMonoUnitFuncs -- add a JOIN-only FUNCTION shell child per function
# in the template unit's body. The mono function rows are defined_in_unit=NULL (excluded
# from the filtered dump), so no params are resolved -- only the names matter for the JOIN.
attachMonoUnitFuncs: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast.view
    monoId: ztypes.tid
    templateOpId: zast.nodeid
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: templateOpId
    {
        fiter: bodyIds9.iterate
        for fm: fiter loop {
            fmNode9: ast.nodes.get i: fm.u64
            match (
                fmNode9
            ) case namedoperation then {
                if (isFunctionDefOp op: (ast.nodes.get i: fmNode9.operation.u64)) then {
                    fn: zast.nameTextAt :ast ref: fmNode9.name
                    shellId: (reg.newType
                        name: fn.stringview
                        ownerTid: monoId
                        typetype: ztypes.ztypetype.functionType
                    )
                    (ty.declSynthMember
                        parentTypeId: monoId
                        nameId: fmNode9.name
                        kind: ztyping.declkind.methodDecl
                    )
                    (ty.setMemberType
                        parentTypeId: monoId
                        nameId: fmNode9.name
                        childTypeId: shellId
                    )
                }
            } else null
        }
    }
}

# resolveUnitMono -- create a mono UNIT (mangled name, defined_in_unit=the instantiating
# unit) with JOIN-only function-shell children from the template's body, then seed
# return/never demand (the template functions have bodies). Skips when already resolved
# or the template unit is not found.
# isIteratorCall -- true when a type-expr is a call to `Iterator` (a generator's
# `out (Iterator gives: T)` return), peeling an expression wrapper.
isIteratorCall: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case expression then {
        return (isIteratorCall :ast op: (ast.nodes.get i: op.expression.u64))
    } case call then {
        cn: atomName :ast n: (ast.nodes.get i: op.callable.u64)
        return (cn.stringview == "Iterator")
    } else {
        return false
    }
}

# isGeneratorReturn -- true when a function's return type is the Iterator protocol
# (i.e. the function is a generator that lowers to a synth iterator class).
isGeneratorReturn: function {ast: Ast.view oId: zast.nodeid} out bool is {
    if oId.isZero then return false
    o: ast.nodes.get i: oId.u64
    return (isIteratorCall :ast op: o)

}

# subtreeHasYield -- true if a node subtree contains a yield expression.
subtreeHasYield: function {ast: Ast.view node: Node.view} out bool is {
    match (
        node
    ) case yieldexpr then {
        return true
    } case statement then {
        siter: node.statements.iterate
        for stId9: siter loop {
            if (subtreeHasYield :ast node: (ast.nodes.get i: stId9.u64)) then return true
        }
        return false
    } case statementline then {
        sln9: ast.nodes.get i: node.statementline.u64
        return (subtreeHasYield :ast node: sln9)
    } case expression then {
        return (subtreeHasYield :ast node: (ast.nodes.get i: node.expression.u64))
    } case forexpr then {
        if node.body.isZero then return false
        return (subtreeHasYield :ast node: (ast.nodes.get i: node.body.u64))
    } case ifexpr then {
        cliter: node.clauses.iterate
        for clId9: cliter loop {
            if (subtreeHasYield :ast node: (ast.nodes.get i: clId9.u64)) then return true
        }
        if node.elseclause.isZero then return false
        return (subtreeHasYield :ast node: (ast.nodes.get i: node.elseclause.u64))
    } case ifclause then {
        return (subtreeHasYield :ast node: (ast.nodes.get i: node.statement.u64))
    } else {
        return false
    }
}

# nodeIsYieldingLoop -- true when a statement (peeling statementline/expression) is a
# for-loop whose body contains a yield.
nodeIsYieldingLoop: function {ast: Ast.view node: Node.view} out bool is {
    match (
        node
    ) case statementline then {
        sln29: ast.nodes.get i: node.statementline.u64
        return (nodeIsYieldingLoop :ast node: sln29)
    } case expression then {
        return (nodeIsYieldingLoop :ast node: (ast.nodes.get i: node.expression.u64))
    } case forexpr then {
        if node.body.isZero then return false
        return (subtreeHasYield :ast node: (ast.nodes.get i: node.body.u64))
    } else {
        return false
    }
}

# bodyHasYieldingLoop -- true when a function body (a table id, 0 = absent) contains a
# yielding loop. Generators with one promote their straight-line locals to fields.
bodyHasYieldingLoop: function {ast: Ast.view bodyId: zast.nodeid} out bool is {
    if bodyId.isZero then return false
    return (blockHasYieldingLoop :ast blk: (ast.nodes.get i: bodyId.u64))
}
# true when `blk` contains a loop that yields (a generator body).
blockHasYieldingLoop: function {ast: Ast.view blk: Node.view} out bool is {
    match (
        blk
    ) case statement then {
        siter: blk.statements.iterate
        for stId9: siter loop {
            if (nodeIsYieldingLoop :ast node: (ast.nodes.get i: stId9.u64)) then return true
        }
        return false
    } else {
        return false
    }
}

# nameIdOf -- the pool id of an already-interned name. 0 (absent) is what
# every symbol-table query treats as a miss, so a name the pool never saw
# cannot resolve -- which is exactly right, since nothing declared it.
# nameIdOf -- nameIdOf widened for the u64-keyed unit-name table. A method
# on a CALL RESULT emits `&<call>`, which is not an lvalue, so the widening
# cannot ride the call site.
nameIdOf: function {ast: Ast.view name: StringView} out zast.nameid is {
    return (zast.poolFind pool: ast.names text: name)
}

# assignmentLocalName -- the pool id of the local a statement-line binds via
# `name: value`, or 0.
assignmentLocalName: function {ast: Ast.view line: Node.view} out zast.nameid is {
    match (
        line
    ) case statementline then {
        return (assignmentInnerName s: (ast.nodes.get i: line.statementline.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}
# the bound name of assignment statement `s`.
assignmentInnerName: function {s: Node.view} out zast.nameid is {
    match (
        s
    ) case assignment then {
        return s.name
    } else {
        return (zast.nameid.create from: 0)
    }
}

# addPromotedLocals -- add a field (i64) per top-level local binding in a generator body
# (the loop-carried counters promoted to iter-class fields).
addPromotedLocals: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    iterId: u64
    bodyId: zast.nodeid
} is {
    if bodyId > 0 then {
        addPromotedLocalsBlk :ty :reg :ast :iterId blk: (ast.nodes.get i: bodyId.u64)
    }
}
# add generator-promoted locals as fields of the synthesised iterator.
addPromotedLocalsBlk: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    iterId: u64
    blk: Node.view
} is {
    match (
        blk
    ) case statement then {
        siter: blk.statements.iterate
        for stId9: siter loop {
            nm: assignmentLocalName :ast line: (ast.nodes.get i: stId9.u64)
            if nm != 0 then {
                lf: (resolveAtomType
                    :ty
                    :reg
                    :ast
                    unitDecl: ztypes.declid
                    nm: "i64"
                    thisName: ""
                )
                (ty.setMemberType
                    parentTypeId: (ztypes.tid.create from: iterId.u64)
                    nameId: nm
                    childTypeId: lf
                )
            }
        }
    } else null
}

# synthGeneratorIterClass -- synthesize the `<fn>_iter` CLASS the oracle lowers a
# generator to: a `state: i64` field, a `create` method (param `state: i64`), and a
# `call` method (receiver `this`, BORROW). All defined_in_unit=the example; seed
# return/never demand (the lowered methods have bodies). No-param / no-promoted-local
# generators only (counter); captured params + promoted locals arrive later.
# addResumeInput -- for a bidirectional generator (`accepts: U` in the Iterator
# return), add the `_resume_input: U` field to the iter class and a `value: U` param
# (with the annotated ownership) to its `call` method.
addResumeInput: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    iterId: u64
    callId: u64
    returntypeId: zast.nodeid
} is {
    if returntypeId.isZero then return
    returntype: ast.nodes.get i: returntypeId.u64
    addResumeInputExpr :ty :reg :ast :iterId :callId rt: returntype

}
# add the resume-input expression to a generator's step body.
addResumeInputExpr: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    iterId: u64
    callId: u64
    rt: Node.view
} is {
    match (
        rt
    ) case expression then {
        rtx9: ast.nodes.get i: rt.expression.u64
        addResumeInputExpr :ty :reg :ast :iterId :callId rt: rtx9
    } case call then {
        aiter: rt.arguments.iterate
        for argId9: aiter loop {
            arg: ast.nodes.get i: argId9.u64
            match (
                arg
            ) case namedoperation then {
                an: zast.nameTextAt :ast ref: arg.name
                if an.stringview == "accepts" then {
                    tn: baseTypeName :ast n: (ast.nodes.get i: arg.operation.u64)
                    rf: (resolveAtomType
                        :ty
                        :reg
                        :ast
                        unitDecl: ztypes.declid
                        nm: tn.stringview
                        thisName: ""
                    )
                    (ty.setMemberType
                        parentTypeId: (ztypes.tid.create from: iterId.u64)
                        nameId: zast.wkResumeInput
                        childTypeId: rf
                    )
                    vf: (resolveAtomType
                        :ty
                        :reg
                        :ast
                        unitDecl: ztypes.declid
                        nm: tn.stringview
                        thisName: ""
                    )
                    (ty.setMemberType
                        parentTypeId: (ztypes.tid.create from: callId.u64)
                        nameId: zast.wkValue
                        childTypeId: vf
                    )
                    own: pathOwnership :ast n: (ast.nodes.get i: arg.operation.u64)
                    match (
                        own
                    ) case some then {
                        (ty.setChildOwnershipId
                            parentTypeId: (ztypes.tid.create from: callId.u64)
                            nameId: zast.wkValue
                            ownership: own
                        )
                    } case none then null
                }
            } else null
        }
    } else null
}

# condIterableCallable -- the callable name of a for-loop's inline iterable (a
# `binding: (gen ...)` condition), or "". A `while` condition (no binding) yields "".
condIterableCallable: function {ast: Ast.view conds: (ListVal u32).view} out String is {
    citer: conds.iterate
    for cId9: citer loop {
        c: ast.nodes.get i: cId9.u64
        match (
            c
        ) case namedoperation then {
            cb: callableUnitName :ast op: (ast.nodes.get i: c.operation.u64)
            if cb.length != 0 then return cb
        } else null
    }
    return "".string
}

# forIterableCallable -- for a yielding for-loop whose iterable is a generator call,
# the callable name; "" otherwise (peels statementline/expression).
forIterableCallable: function {ast: Ast.view e: Node.view} out String is {
    match (
        e
    ) case statementline then {
        sln9: ast.nodes.get i: e.statementline.u64
        return (forIterableCallable :ast e: sln9)
    } case expression then {
        return (forIterableCallable :ast e: (ast.nodes.get i: e.expression.u64))
    } case forexpr then {
        hy9: false
        if e.body > 0 then {
            eb9: ast.nodes.get i: e.body.u64
            hy9 = subtreeHasYield :ast node: eb9
        }
        if hy9 then {
            return (condIterableCallable :ast conds: e.conditions)
        } else {
            return "".string
        }
    } else {
        return "".string
    }
}

# addInlineIterFields -- add an `_iterN: <callable>_iter` field per yielding for-loop
# whose iterable is an inline generator call (chain/map_filter's nested pipeline). The
# field is typed by the nested generator's iter class; no create param (that lives on
# the excluded NULL-unit create).
addInlineIterFields: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    iterId: u64
    bodyId: zast.nodeid
} is {
    if bodyId > 0 then {
        addInlineIterFieldsBlk :ty :reg :ast :iterId blk: (ast.nodes.get i: bodyId.u64)
    }
}
# add inline iterator-state fields for a block.
addInlineIterFieldsBlk: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast
    iterId: u64
    blk: Node.view
} is {
    match (
        blk
    ) case statement then {
        n: u64
        siter: blk.statements.iterate
        for stId9: siter loop {
            cb: forIterableCallable :ast e: (ast.nodes.get i: stId9.u64)
            if cb.length != 0 then {
                fieldName: "_iter\{n}"
                fieldType: "\{cb.stringview}_iter"
                ft: (resolveAtomType
                    :ty
                    :reg
                    :ast
                    unitDecl: ztypes.declid
                    nm: fieldType.stringview
                    thisName: ""
                )
                (ty.setMemberType
                    parentTypeId: (ztypes.tid.create from: iterId.u64)
                    nameId: (ast.internString text: fieldName.stringview)
                    childTypeId: ft
                )
                n = n + 1
            }
        }
    } else null
}

# synthGeneratorForMethod -- synthesize the iter class for a generator METHOD (an
# as-block method whose return is the Iterator protocol). thisName is the enclosing
# type, so a `this`-typed captured param (b: this.private.lock) resolves to it.
synthGeneratorForMethod: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    fnName: StringView
    thisName: StringView
    op: Node.view
} is {
    match (
        op
    ) case functiondef then {
        if (isGeneratorReturn :ast oId: op.returntype) then {
            synthGeneratorIterClass :ty :reg :ast :unitDecl :fnName :thisName fnode: op
        }
    } else null
}

# synthesise the iterator class that lowers a generator function.
synthGeneratorIterClass: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    unitDecl: ztypes.declid
    fnName: StringView
    thisName: StringView
    fnode: zast.FunctionData.view
} is {
    iterName: "\{fnName}_iter"
    iterId: reg.newType name: iterName.stringview typetype: ztypes.ztypetype.classType
    reg.setValtype typeId: iterId value: false
    # the synthesized iter class has no Decl of its own; its closest
    # declaration is the generator function it was lowered from
    gfp9: declOfUnitDef :ty :ast :unitDecl name: fnName
    if gfp9 > 0 then reg.setDef typeId: iterId declId: gfp9
    needsDtor: false
    st1: resolveAtomType :ty :reg :ast :unitDecl nm: "i64" thisName: ""
    ty.setMemberType parentTypeId: iterId nameId: zast.wkState childTypeId: st1
    createId: reg.newType name: "create" ownerTid: iterId typetype: ztypes.ztypetype.functionType
    if gfp9 > 0 then reg.setDef typeId: createId declId: gfp9
    callId: reg.newType name: "call" ownerTid: iterId typetype: ztypes.ztypetype.functionType
    if gfp9 > 0 then reg.setDef typeId: callId declId: gfp9
    ty.setMemberType parentTypeId: callId nameId: zast.wkThis childTypeId: iterId
    (ty.setChildOwnershipId
        parentTypeId: callId
        nameId: zast.wkThis
        ownership: ztypes.zparamownership.borrowMode
    )
    piter: fnode.parameters.iterate
    for pmId9: piter loop {
        pm: ast.nodes.get i: pmId9.u64
        match (
            pm
        ) case namedoperation then {
            pn: zast.nameTextAt :ast ref: pm.name
            ptn: baseTypeName :ast n: (ast.nodes.get i: pm.operation.u64)
            f1: resolveAtomType :ty :reg :ast :unitDecl nm: ptn.stringview :thisName
            (ty.setMemberType
                parentTypeId: iterId
                nameId: pm.name
                childTypeId: f1
            )
            f2: resolveAtomType :ty :reg :ast :unitDecl nm: ptn.stringview :thisName
            (ty.setMemberType
                parentTypeId: createId
                nameId: pm.name
                childTypeId: f2
            )
            pown: pathOwnership :ast n: (ast.nodes.get i: pm.operation.u64)
            match (
                pown
            ) case some then {
                (ty.setChildOwnership
                    pool: ast.names
                    parentTypeId: createId
                    name: pn.stringview
                    ownership: pown
                )
                needsDtor = true
            } case none then null
        } else null
    }
    (addResumeInput
        :ty
        :reg
        :ast
        :iterId
        :callId
        returntypeId: fnode.returntype
    )
    if (bodyHasYieldingLoop :ast bodyId: fnode.body) then {
        addPromotedLocals :ty :reg :ast :iterId bodyId: fnode.body
    }
    addInlineIterFields :ty :reg :ast :iterId bodyId: fnode.body
    ty.setMemberType parentTypeId: iterId nameId: zast.wkCreate childTypeId: createId
    ty.setMemberType parentTypeId: iterId nameId: zast.wkCall childTypeId: callId
    if needsDtor then {
        dn: "\{iterName}_destroy"
        (reg.setDestructorName
            typeId: iterId
            nameId: (zast.poolSet pool: ast.names text: dn.stringview)
        )
    }
    demandReturnNever :ty :ast
}

# isUnitOp -- true when a binding's operation is an inline `unit as {...}` definition.
isUnitOp: function {op: Node.view} out bool is {
    match (
        op
    ) case unitdef then {
        return true
    } else {
        return false
    }
}

# resolveUnitMembers -- resolve the definition signatures in ONE unit's body,
# whatever kind of unit it is. A file unit, an inline `m: unit { }`, a hidden
# subunit and a `public:` block differ only in who supplies the owner, so the
# walk takes the owner's Decl and type id and never asks a name for them.
#
# `speculative` is the one fact the two entries differ on: a FILE unit's body is
# walked before anything asks for it, a nested unit's because something demanded
# the unit. Both of the file walk's peculiarities follow from it -- it resolves
# only what a declaration needs (a function, a unit or an interface), and it does
# not mark what it touched as DEFINED, having resolved it on nobody's behalf.
# `rootOnly` narrows the eager set once more for the main unit, where demand
# starts at `main` and everything else waits to be asked for.
resolveUnitMembers: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    unitDecl: ztypes.declid
    ownerDeclId: ztypes.declid
    ownerTid: ztypes.tid
    unitOpId: zast.nodeid
    speculative: bool
    rootOnly: bool
} is {
    # every member resolves in the unit's own frame
    prevFrame9: ty.curFrame
    ty.curFrame = ownerDeclId
    bodyIds9: zast.unitBodyIdsAt :ast unitId: unitOpId
    with biter9: bodyIds9.iterate do for bm9: biter9 loop {
        bmNode9: ast.nodes.get i: bm9.u64
        match (
            bmNode9
        ) case namedoperation then {
            mName9: zast.nameTextCopy :ast ref: bmNode9.name
            if mName9.length > 0 then {
                # dispatch by KIND. A unit body that declares a generic param
                # parses as `template`, and only resolveInlineGenericUnit marks
                # it generic, registers its params and stamps its def node.
                isTmpl9: (zast.unitOpKindIs
                    :ast
                    opId: bmNode9.operation
                    k: zast.unitkind.template
                )
                isUnit9: isUnitOp op: (ast.nodes.get i: bmNode9.operation.u64)
                isIface9: (isInterfaceDefOp
                    op: (ast.nodes.get i: bmNode9.operation.u64)
                )
                eager9: true
                # a scope declaration (a unit, a template) and an INTERFACE are
                # properties of the DECLARATION, not bodies: a constraint
                # facet's only reference may be the as-block marker naming it,
                # and a nested namespace's template is reached through the
                # scope or not at all. Both stay whatever the restriction.
                if speculative when (isUnit9) == false when (isIface9) == false then {
                    if (isFunctionDefOp
                        op: (ast.nodes.get i: bmNode9.operation.u64)
                    ) == false then eager9 = false
                }
                if rootOnly when mName9.stringview != "main" then {
                    if (isUnit9) == false when (isIface9) == false then eager9 = false
                }
                if ty.eagerAll then eager9 = true
                if eager9 then {
                    if isTmpl9 then {
                        # the template is a child of THIS unit: the mint funnel
                        # reaches the enclosing owner through the cursor
                        (resolveInlineGenericUnit
                            :ty
                            :reg
                            :ast
                            :unitDecl
                            defName: mName9.stringview
                            parentTid: ownerTid
                            parentDeclId: ownerDeclId
                            unitOpId: bmNode9.operation
                        )
                    } else if isUnit9 then {
                        (resolveNamespaceUnit
                            :ty
                            :reg
                            :ast
                            :unitDecl
                            defName: mName9.stringview
                            parentTid: ownerTid
                            parentDeclId: ownerDeclId
                            unitOpId: bmNode9.operation
                        )
                    } else {
                        md9: ty.declFindChild parentDeclId: ownerDeclId nameId: bmNode9.name
                        # a `public:` block's reference entry (`:x`, `alias: x`)
                        # is an edge to a sibling of the enclosing unit, which
                        # resolves as that unit's definition, not as a member here
                        mdp9: declParentIdOf :ty declId: md9
                        if (md9.isZero) == false when mdp9 != ownerDeclId then continue
                        isRx9: false
                        isDone9: false
                        {
                            mdo9: ty.decls.get i: md9.u64
                            if mdo9.kind.reexportDecl then isRx9 = true
                            if mdo9.defined then isDone9 = true
                        }
                        # A re-export whose target is a DOTTED path is resolved by
                        # following it, which is resolveAliasKey's job -- resolveDef
                        # has no leg for a dotted target naming a NESTED unit, and
                        # marking the alias DEFINED after it did nothing is what
                        # stopped a re-export of a re-export at its first hop. A bare
                        # target (`ECHO: LIB`) names a sibling of this same unit and
                        # is an ordinary definition: resolveDef is what FOLDS it, and
                        # following it instead leaves the constant unfolded.
                        if isRx9 when (isDottedValue
                            :ast
                            n: (ast.nodes.get i: bmNode9.operation.u64)
                        ) then {
                            resolveAliasKey :ty :reg :ast declId: md9
                        } else if (isDone9) == false then {
                            (resolveDef
                                :ty
                                :reg
                                :ast
                                :unitDecl
                                defName: mName9.stringview
                                defn: (ast.nodes.get i: bmNode9.operation.u64)
                            )
                        }
                        if (md9.isZero) == false when (speculative) == false then {
                            ty.declSetDefined declId: md9
                        }
                    }
                }
            }
        } else null
    }
    ty.curFrame = prevFrame9
}

# resolveNamespaceUnit -- resolve a namespace unit: an inline `m: unit { }` or a
# hidden subunit, which are the same node after parsing. Its members are
# children of ITS type id, not of the enclosing unit's, so two namespaces may
# each declare a `twice` without colliding. Members go through resolveDef, so a
# constant, a record, a class and a nested namespace all resolve the way a file
# unit's members do -- which is the whole point: a unit is one concept however
# it was written.
resolveNamespaceUnit: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    parentTid: ztypes.tid
    parentDeclId: ztypes.declid
    unitOpId: zast.nodeid
} is {
    nameRef9: zast.poolFind pool: ast.names text: defName
    if nameRef9.isZero then return
    udnid9: unitdefNodeId :ast nId: unitOpId
    if udnid9.isZero then return
    # reg.newType has no dedup and a namespace can be demanded again after it
    # resolved, so the node stamp is what makes a second visit a no-op.
    uid9: ztypes.tid
    {
        prev9: ztyping.nodeTypeAt tbl: ty.nodeType nid: udnid9.u64
        if prev9 > 0 then uid9 = ztypes.tid.create from: prev9
    }
    declId9: ty.declFindChild :parentDeclId nameId: nameRef9
    if uid9.isZero then {
        uid9 = reg.newType name: defName typetype: ztypes.ztypetype.unitType
        ztyping.nodeTypeSet tbl: ty.nodeType nid: udnid9.u64 tid: uid9
        if (parentTid.isZero) == false then {
            (ty.setMemberType
                parentTypeId: parentTid
                nameId: nameRef9
                childTypeId: uid9
            )
        }
        if (declId9.isZero) == false then {
            ty.declSetType declId: declId9 typeId: uid9
            reg.setDef typeId: uid9 declId: declId9
        }
    }
    (resolveUnitMembers
        :ty
        :reg
        :ast
        :unitDecl
        ownerDeclId: declId9
        ownerTid: uid9
        :unitOpId
        speculative: false
        rootOnly: false
    )
    # A namespace's constants are NOT folded here. Each one declares itself
    # when something reads it (probeFrameTyperef's constant leg), the way every
    # other definition of this unit waits to be demanded. Folding them up front
    # was the last eager tier left inside the lazy one.
}

# resolveInlineGenericUnit -- resolve an inline generic unit (mathops: unit as { t:
# Any.generic; add; double }) into a UNIT type (is_generic) whose functions are mangled
# {unit}_{fn} FUNCTION children (with their generic-param types KEPT -- unlike a generic
# FILE unit, an inline template's params are not suppressed).
resolveInlineGenericUnit: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    parentTid: ztypes.tid
    parentDeclId: ztypes.declid
    unitOpId: zast.nodeid
} is {
    # a template's members resolve in the template's own frame
    prevFrame9: ty.curFrame
    ty.curFrame = (ty.declFindChild
        :parentDeclId
        nameId: (zast.poolFind pool: ast.names text: defName)
    )
    if ty.curFrame.isZero then ty.curFrame = parentDeclId
    resolveInlineGenericUnitIn :ty :reg :ast :unitDecl :defName :parentTid :parentDeclId :unitOpId
    ty.curFrame = prevFrame9
}

resolveInlineGenericUnitIn: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    parentTid: ztypes.tid
    parentDeclId: ztypes.declid
    unitOpId: zast.nodeid
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: unitOpId
    # this template's own Decl, under the parent the CALLER names: the unit
    # root for a top-level template, the namespace's Decl for a nested one.
    # A (unit, name) walk reaches only the first.
    nRef5: zast.poolFind pool: ast.names text: defName
    tdl5: ty.declFindChild :parentDeclId nameId: nRef5
    # reg.newType has no dedup and a template can be demanded again after it
    # resolved, so a second visit must mint nothing at all. resolveNamespaceUnit
    # carries the equivalent node-stamp guard. The Decl below records
    # the id this minted, so it is the durable "already done" mark.
    if (declTypeIdOf :ty declId: tdl5) > 0 then return
    {
        uid: reg.newType name: defName typetype: ztypes.ztypetype.unitType
        did: uid
        rid: uid
        if (hasGenericParam :ast items: bodyIds9) then {
            reg.setGeneric typeId: uid value: true
            registerGenericParams :reg :ast tdecl: tdl5 items: bodyIds9
            # mirror the reference's inline-template touch: the unit node and
            # each bare generic-param def stamp, and the param name resolves so
            # signature t-refs stamp. Unconditional -- createUnitMono falls back
            # to this def-node stamp to find a template with no childOf edge, so
            # laying it is a property of resolving the template, not of which
            # walk got here. The guard this replaces asked ty.fullMainUnit,
            # which the first eager unit sets and nothing ever clears.
            udnid: unitdefNodeId :ast nId: unitOpId
            ztyping.nodeTypeSet tbl: ty.nodeType nid: udnid.u64 tid: uid
            with gpiter: bodyIds9.iterate do for gmId9: gpiter loop {
                gm: ast.nodes.get i: gmId9.u64
                match (
                    gm
                ) case namedoperation then {
                    if (isBareGenericParam
                        :ast
                        op: (ast.nodes.get i: gm.operation.u64)
                    ) then {
                        gpn5: zast.nameTextAt :ast ref: gm.name
                        gtid5: u64
                        gpo5: reg.genericParamTidOf tdecl: tdl5 paramName: gpn5.stringview
                        match (
                            gpo5
                        ) case some then {
                            gtid5 = gpo5
                        } case none then {
                            gtid5 = (reg.newType
                                name: gpn5.stringview
                                typetype: ztypes.ztypetype.genericParam
                            )
                            (reg.setGenericParamTid
                                tdecl: tdl5
                                paramName: gpn5.stringview
                                tid: (ztypes.tid.create from: gtid5.u64)
                            )
                        }
                        gpnid: nodeId n: (ast.nodes.get i: gm.operation.u64)
                        (ztyping.nodeTypeSet
                            tbl: ty.nodeType
                            nid: gpnid.u64
                            tid: (ztypes.tid.create from: gtid5.u64)
                        )
                        # the parameter's own declaration carries the
                        # GENERIC_PARAM id, as a generic file unit's does: the
                        # template's frame answers `t` with the parameter, not
                        # with the constraint its definition names
                        gpd5: ty.declFindChild parentDeclId: tdl5 nameId: gm.name
                        if (gpd5.isZero) == false then {
                            ty.declSetType declId: gpd5 typeId: (ztypes.tid.create from: gtid5.u64)
                        }
                    }
                } else null
            }
        }
        if (tdl5.isZero) == false then {
            ty.declSetType declId: tdl5 typeId: did
            reg.setDef typeId: did declId: tdl5
        }
        # A non-generic inline unit is a real type; lay its unit->def childOf edge
        # (a generic template must NOT get one -- its id is the pre-instantiation
        # template, which would shadow instance lookups).
        if (hasGenericParam :ast items: bodyIds9) == false then {
            if (parentTid.isZero) == false then {
                (ty.setMemberType
                    parentTypeId: parentTid
                    nameId: nRef5
                    childTypeId: rid
                )
            }
        }
        biter: bodyIds9.iterate
        for bm: biter loop {
            bmNode9: ast.nodes.get i: bm.u64
            match (
                bmNode9
            ) case namedoperation then {
                fn: zast.nameTextAt :ast ref: bmNode9.name
                mido: (resolveMethodFn
                    :ty
                    :reg
                    :ast
                    :unitDecl
                    ownerNameId: (nameIdOf :ast name: defName)
                    mname: fn.stringview
                    thisName: ""
                    op: (ast.nodes.get i: bmNode9.operation.u64)
                )
                match (
                    mido
                ) case some then {
                    (declLinkTemplateMethod
                        :ty
                        tmplDeclId: tdl5
                        memberNameId: bmNode9.name
                        fnTid: mido
                    )
                    (ty.setMemberType
                        parentTypeId: uid
                        nameId: bmNode9.name
                        childTypeId: mido
                    )
                } case none then null
            } else null
        }
    }
}

# createUnitMono -- mint a mono UNIT with JOIN-only function-shell children
# from a template unit body, then seed return/never demand. Identity is the
# caller's: the trie under the template, keyed on the resolved arguments
# (unitMonoOnTrie / unitMonoJoinTrie). `monoName` is the mono's LABEL --
# display only, registered nowhere.
createUnitMono: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    monoName: StringView
    tmplDeclId: ztypes.declid
    tplTid: ztypes.tid
    templateOpId: zast.nodeid
} out ztypes.tid is {
    monoId: reg.newType name: monoName typetype: ztypes.ztypetype.unitType
    # the mono's declaration is the TEMPLATE's (its origin), and its members
    # hang off a clone of it -- the request resolved the template's Decl at
    # collection through the instantiation's own scope. Nothing registers the
    # label: the mono is reached through the trie, or through the binding
    # names the completion pass registers.
    reg.setDef typeId: monoId declId: tmplDeclId
    mud9: ty.declCloneType templateDeclId: tmplDeclId
    if mud9 > 0 then ty.declSetType declId: mud9 typeId: monoId
    if (tplTid.isZero) == false then reg.setGenericOrigin typeId: monoId value: tplTid
    attachMonoUnitFuncs :ty :reg :ast :monoId :templateOpId
    demandReturnNever :ty :ast
    return monoId
}

# fnReturnBaseName -- the base type name of a function's return typeref
# ("" when absent), for completing substituted signatures whose template
# return was still unresolved at signature time.
fnReturnBaseName: function {ast: Ast.view oId: zast.nodeid} out String is {
    if oId.isZero then return "".string
    o: ast.nodes.get i: oId.u64
    return (baseTypeName :ast n: o)

}

# the base type name of function `op`'s declared return type -- the
# head of a form like `List X`.
fnReturnBaseNameOf: function {ast: Ast.view op: Node.view} out String is {
    match (
        op
    ) case functiondef then {
        return (fnReturnBaseName :ast oId: op.returntype)
    } else {
        return "".string
    }
}

# buildUnitMono -- unit-mono completion: substituted method
# children ({mono}.{fn} FUNCTION types whose generic-param-named child types
# and return are replaced by the instantiation arg). Bodies are walked once,
# per instance, over the template's AST (stampUnitMonoTemplates). One build
# per mono.
# registerMonoFnParams -- register a mono unit fn's generic-param-typed params
# (a: t -> a: argId) on the mono FUNCTION type, sourced from the template fn's
# AST. The template fn stays childless -- only the instance carries substituted
# param children, matching the reference (which carries them via the clone).
registerMonoFnParams: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    op: Node.view
    fnId: u64
    subs: (MapRV String value: u64)
} is {
    match (
        op
    ) case functiondef then {
        ppiter: op.parameters.iterate
        for ppmId9: ppiter loop {
            ppm: ast.nodes.get i: ppmId9.u64
            match (
                ppm
            ) case namedoperation then {
                pptn: atomName :ast n: (ast.nodes.get i: ppm.operation.u64)
                ppgo: subs.get key: pptn
                match (
                    ppgo
                ) case some then {
                    (ty.setMemberType
                        parentTypeId: (ztypes.tid.create from: fnId.u64)
                        nameId: ppm.name
                        childTypeId: ppgo
                    )
                } case none then null
            } else null
        }
    } else null
}

# build a monomorphised instance of a generic unit.
buildUnitMono: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    tmplUnitName: ztypes.declid
    tmplName: StringView
    monoId: ztypes.tid
    tplId: ztypes.tid
    subs: (MapRV String value: u64)
    templateOpId: zast.nodeid
} is {
    bgot9: ty.collectionChildrenBuilt.get key: monoId
    if (optBoolOr o: bgot9 d: false) then return
    bk0: monoId
    ty.collectionChildrenBuilt.set key: bk0 value: true
    # the template's members resolve in the template's frame
    prevFrame9: ty.curFrame
    {
        td9: declOfTypeId :reg tid: tplId
        if (td9.isZero) == false then ty.curFrame = td9
    }
    (buildUnitMonoIn
        :ty
        :reg
        :ast
        :tmplUnitName
        :tmplName
        :monoId
        :tplId
        :subs
        :templateOpId
    )
    ty.curFrame = prevFrame9
}

buildUnitMonoIn: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    tmplUnitName: ztypes.declid
    tmplName: StringView
    monoId: ztypes.tid
    tplId: ztypes.tid
    subs: (MapRV String value: u64)
    templateOpId: zast.nodeid
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: templateOpId
    gpNames: (MapRV String value: bool)
    {
        with giter: bodyIds9.iterate do for gmId9: giter loop {
            gm: ast.nodes.get i: gmId9.u64
            match (
                gm
            ) case namedoperation then {
                if (isGenericParam :ast op: (ast.nodes.get i: gm.operation.u64)) then {
                    gn: zast.nameTextCopy :ast ref: gm.name
                    gv: true
                    gpNames.set key: gn value: gv
                }
            } else null
        }
        fiter: bodyIds9.iterate
        for fm: fiter loop {
            fmNode9: ast.nodes.get i: fm.u64
            match (
                fmNode9
            ) case namedoperation then {
                if (isFunctionDefOp op: (ast.nodes.get i: fmNode9.operation.u64)) then {
                    fn: zast.nameTextAt :ast ref: fmNode9.name
                    srcId: u64
                    tfo: (ty.declChildOf
                        pool: ast.names
                        parentTypeId: (ztypes.tid.create from: tplId.u64)
                        name: fn.stringview
                    )
                    match (
                        tfo
                    ) case some then {
                        srcId = tfo
                    } case none then {
                        mo0: (resolveMethodFn
                            :ty
                            :reg
                            :ast
                            unitDecl: tmplUnitName
                            ownerNameId: (nameIdOf :ast name: tmplName)
                            mname: fn.stringview
                            thisName: ""
                            op: (ast.nodes.get i: fmNode9.operation.u64)
                        )
                        {
                            mo0v9: optU64Or o: mo0 d: 0
                            tdl0: (declOfUnitDef
                                :ty
                                :ast
                                unitDecl: tmplUnitName
                                name: tmplName
                            )
                            (declLinkTemplateMethod
                                :ty
                                tmplDeclId: tdl0
                                memberNameId: fmNode9.name
                                fnTid: mo0v9
                            )
                        }
                        match (
                            mo0
                        ) case some then {
                            srcId = mo0
                            (ty.setMemberType
                                parentTypeId: (ztypes.tid.create from: tplId.u64)
                                nameId: fmNode9.name
                                childTypeId: mo0
                            )
                        } case none then null
                    }
                    newFnId: (reg.newType
                        name: fn.stringview
                        ownerTid: monoId
                        typetype: ztypes.ztypetype.functionType
                    )
                    # declare and edge the method before filling its parameters:
                    # edging claims the method's own function type for its
                    # declaration, which is what the parameter writes below --
                    # here and in registerMonoFnParams -- reach through
                    (ty.declSynthMember
                        parentTypeId: monoId
                        nameId: fmNode9.name
                        kind: ztyping.declkind.methodDecl
                    )
                    (ty.setMemberType
                        parentTypeId: monoId
                        nameId: fmNode9.name
                        childTypeId: newFnId
                    )
                    if srcId > 0 then {
                        cNames: (List String)
                        cIds: (ListVal u64)
                        {
                            bmNms9: (ListVal u64)
                            (ty.declMemberList
                                ownerTid: (ztypes.tid.create from: srcId.u64)
                                names: bmNms9
                                tids: cIds
                            )
                            bmq9: u64
                            bmn9: bmNms9.length
                            for bmq9 < bmn9 loop {
                                cnB0: ast.names.texts.get i: ((bmNms9.get i: bmq9)).u64
                                cn0: cnB0.copy
                                cNames.append cn0
                                bmq9 = bmq9 + 1
                            }
                        }
                        ci: u64
                        cn3: cNames.length
                        for ci < cn3 loop {
                            chName: cNames.get i: ci
                            chId: cIds.get i: ci
                            target: chId
                            ctn: regTypeNameOf :reg tid: (ztypes.tid.create from: chId.u64)
                            cgo: gpNames.get key: ctn
                            match (
                                cgo
                            ) case some then {
                                cg9: subs.get key: ctn
                                match (
                                    cg9
                                ) case some then {
                                    target = cg9
                                } case none then null
                            } case none then null
                            (ty.setMemberType
                                parentTypeId: newFnId
                                nameId: (zast.poolFind pool: ast.names text: chName.stringview)
                                childTypeId: target
                            )
                            ci = ci + 1
                        }
                        rto9: reg.returnTypeOf tid: (ztypes.tid.create from: srcId.u64)
                        if rto9 > 0 then {
                            rtv: rto9
                            rtn: regTypeNameOf :reg tid: rtv
                            rgo: gpNames.get key: rtn
                            match (
                                rgo
                            ) case some then {
                                rg9: subs.get key: rtn
                                match (
                                    rg9
                                ) case some then {
                                    rtv = ztypes.tid.create from: rg9
                                } case none then null
                            } case none then null
                            reg.setReturnType typeId: newFnId value: rtv
                        } else {
                            # template return unresolved at signature time
                            # (out t): derive from the method's AST typeref.
                            rnm: (fnReturnBaseNameOf
                                :ast
                                op: (ast.nodes.get i: fmNode9.operation.u64)
                            )
                            if rnm.length > 0 then {
                                rgo2: gpNames.get key: rnm
                                rid2: u64
                                match (
                                    rgo2
                                ) case some then {
                                    sg2: subs.get key: rnm
                                    match (
                                        sg2
                                    ) case some then {
                                        rid2 = sg2
                                    } case none then null
                                } case none then {
                                    rlo2: (walkLookupTyperef
                                        :ast
                                        :ty
                                        :reg
                                        unitDecl: tmplUnitName
                                        base: rnm.stringview
                                    )
                                    match (
                                        rlo2
                                    ) case some then {
                                        rid2 = rlo2
                                    } case none then null
                                }
                                if rid2 > 0 then reg.setReturnType typeId: newFnId value: rid2
                            }
                        }
                    }
                    (registerMonoFnParams
                        :ast
                        :ty
                        op: (ast.nodes.get i: fmNode9.operation.u64)
                        fnId: newFnId
                        :subs
                    )
                }
            } else null
        }
    }
}

# completeInlineReq -- locate an inline template member by name in the main
# unit body and build its mono's completion.
completeInlineReq: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    monoId: ztypes.tid
    tmplName: StringView
    tplId: ztypes.tid
    subs: (MapRV String value: u64)
    mainOpId: zast.nodeid
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: mainOpId
    {
        biter: bodyIds9.iterate
        for bm: biter loop {
            bmNode9: ast.nodes.get i: bm.u64
            match (
                bmNode9
            ) case namedoperation then {
                bn: zast.nameTextAt :ast ref: bmNode9.name
                if bn.stringview == tmplName then {
                    if (isUnitOp op: (ast.nodes.get i: bmNode9.operation.u64)) then {
                        (buildUnitMono
                            :ty
                            :reg
                            :ast
                            tmplUnitName: unitDecl
                            :tmplName
                            :monoId
                            :tplId
                            :subs
                            templateOpId: bmNode9.operation
                        )
                    }
                }
            } else null
        }
    }
}

# inlineTemplateTid -- the canonical id of an inline generic-unit template
# (mathops: unit as {...} in the main body). A generic inline template has no
# unit->def childOf edge (it would shadow instance lookups) and is not a unit
# root, so the only durable record of its id is the def-node stamp
# laid by resolveInlineGenericUnit; 0 when no such binding is stamped.
inlineTemplateTid: function {
    ty: ztyping.ZTyping
    ast: Ast.view
    mainOpId: zast.nodeid
    tmplName: StringView
} out ztypes.tid is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: mainOpId
    found: u64
    {
        biter: bodyIds9.iterate
        for bm: biter loop {
            bmNode9: ast.nodes.get i: bm.u64
            match (
                bmNode9
            ) case namedoperation then {
                bn: zast.nameTextAt :ast ref: bmNode9.name
                if bn.stringview == tmplName then {
                    if (isUnitOp op: (ast.nodes.get i: bmNode9.operation.u64)) then {
                        tnid: unitdefNodeId :ast nId: bmNode9.operation
                        tso: ztyping.nodeTypeAt tbl: ty.nodeType nid: tnid.u64
                        if tso > 0 then found = tso
                    }
                }
            } else null
        }
    }
    return (ztypes.tid.create from: found.u64)
}

# completeUnitInstantiations -- post-demand pass: with system types
# resolved, finish each generic-unit instantiation (substituted children +
# clone stash), register the binding name, and stamp the instantiation's
# expression/call/callable/arg nodes (the reference stamps all four).
completeUnitInstantiations: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    program: Node
} is {
    reqs: (List InstReq)
    scanMainForInstantiations :ty :program :reqs
    i: u64
    for i < reqs.length loop {
        r: reqs.get :i
        rbv1: r.bind.stringview
        rb: rbv1
        rtv1: r.tmpl.stringview
        rt: rtv1
        ru: r.declUnit
        re: r.exprId
        rc: r.callId
        rl: r.calId
        rtu: r.tmplUnit
        rtop: r.tmplOpId
        rtid: r.tmplTid
        rtdecl: r.tmplDeclId
        rscope: r.scopeDeclId
        subs: (MapRV String value: u64)
        valSubs: (MapRV String value: u64)
        naR9: r.argLabels.length
        aiR9: u64
        # the arguments resolve where the instantiation is written
        prevFrameR9: ty.curFrame
        if (rscope.isZero) == false then ty.curFrame = rscope
        for aiR9 < naR9 loop {
            lblR9: (r.argLabels.get i: aiR9)
            anmR9: (r.argNames.get i: aiR9)
            aidR9: r.argAtomIds.get i: aiR9
            if (isNumericLiteralName name: anmR9.stringview) then {
                pvR9: parseDecimalU64 text: anmR9.stringview
                match (
                    pvR9
                ) case some then {
                    valSubs.set key: lblR9.copy value: pvR9
                } case none then null
            } else {
                aoR9: (optionval.none u64)
                match (
                    program
                ) case program then {
                    if anmR9.length > 0 then {
                        aoR9 = (walkLookupTyperef
                            ast: program.ast
                            :ty
                            :reg
                            unitDecl: ru
                            base: anmR9.stringview
                        )
                    } else {
                        # a call-shaped argument: the specialisation it names
                        atR9: instArgTypeOf :ty :reg ast: program.ast :r i: aiR9
                        if atR9 > 0 then aoR9 = (optionval.some atR9)
                    }
                } else null
                match (
                    aoR9
                ) case some then {
                    subs.set key: lblR9.copy value: aoR9
                    if aidR9 > 0 then {
                        (ztyping.nodeTypeSet
                            tbl: ty.nodeType
                            nid: aidR9
                            tid: (ztypes.tid.create from: aoR9.u64)
                        )
                    }
                } case none then null
            }
            aiR9 = aiR9 + 1
        }
        ty.curFrame = prevFrameR9
        # the mono is the one on the trie under the template, keyed on the
        # resolved arguments -- the identity the mint pass laid; the label is
        # not consulted
        mgo: (optionval.none u64)
        rbId9: zast.nameid
        tnId9: u32
        match (
            program
        ) case program then {
            if (rtdecl.isZero) == false then {
                keysC9: (ListVal u64)
                isValC9: (ListVal bool)
                if (instMonoKeys
                    :ty
                    :reg
                    ast: program.ast
                    :r
                    tdecl: rtdecl
                    keys: keysC9
                    isVal: isValC9
                ) then {
                    mgo = unitMonoOnTrie :reg tplTid: (declTypeIdOf :ty declId: rtdecl) keys: keysC9
                }
            }
            rbId9 = zast.poolSet pool: program.ast.names text: rb
            tnId9 = nameIdOf ast: program.ast name: rt
        } else null
        match (
            mgo
        ) case some then {
            mid9: mgo
            # the binding's own Decl carries the instantiated unit's type
            # WHEREVER the binding is written: that is what makes `intmath` a
            # unit to a reader, without asking a bare-name index.
            bDecl9: ty.declFindChild parentDeclId: rscope nameId: rbId9
            if (bDecl9.isZero) == false then {
                ty.declSetType declId: bDecl9 typeId: (ztypes.tid.create from: mid9.u64)
            }
            # A binding written inside a NAMESPACE is ALSO a member of that
            # namespace -- `outer.intmath` -- and a qualified read finds it on
            # the namespace's own type id. A top-level binding has no such
            # owner: the file unit's members are not indexed that way.
            rsp9: declParentIdOf :ty declId: rscope
            if (declAtProgramTop :ty parentDeclId: rsp9) == false then {
                sTid9: declTypeIdOf :ty declId: rscope
                if (sTid9.isZero) == false then {
                    (ty.setMemberType
                        parentTypeId: sTid9
                        nameId: rbId9
                        childTypeId: mid9
                    )
                }
            }
            tplId: ztypes.tid
            tgo: (optionval.none u64)
            tplDecl9: ztypes.declid
            match (
                program
            ) case program then {
                mnUid8: unitNameIdOf :ty unitDecl: ru
                rtNid9: nameIdOf ast: program.ast name: rt
                tgo = (resolvedByIds
                    ast: program.ast
                    :ty
                    unitDecl: (unitDeclOfNameId :ty nameId: mnUid8)
                    name: rtNid9
                )
                tplDecl9 = (declOfUnitDef
                    :ty
                    ast: program.ast
                    unitDecl: ru
                    name: rt
                )
                if tplDecl9.isZero then tplDecl9 = rtdecl
                if tplDecl9.isZero then {
                    # a generic FILE unit used as the template: its params
                    # live on its root Decl
                    tro9: (ty.declFindChild
                        parentDeclId: ty.programRoot
                        nameId: (nameIdOf ast: program.ast name: rt)
                    )
                    if (tro9.isZero) == false then tplDecl9 = tro9
                }
            } else null
            match (
                tgo
            ) case some then {
                tplId = ztypes.tid.create from: tgo.u64
            } case none then {
                ugo: (declTypeIdOf
                    :ty
                    declId: (ty.declFindChild
                        parentDeclId: ty.programRoot
                        nameId: (zast.nameid.create from: tnId9)
                    )
                )
                if (ugo.isZero) == false then {
                    tplId = ztypes.tid.create from: ugo.u64
                }
            }
            # neither probe reaches a template nested in a namespace or living
            # in another unit; the request resolved one at COLLECTION. Settled
            # HERE, before the arguments are keyed -- the trie join below needs
            # the template as its root.
            if tplId.isZero then tplId = rtid
            # the mono's arguments in DECLARATION order: what the generic_arg
            # rows record, and what keys its level of the id trie.
            mkeys9: (ListVal u64)
            mkval9: (ListVal bool)
            mkOk9: true
            {
                pnR9: reg.genericParamNamesOf tdecl: tplDecl9
                if pnR9.length == 0 then mkOk9 = false
                pnN9: pnR9.length
                pnI9: u64
                for pnI9 < pnN9 loop {
                    pnmR9: (pnR9.get i: pnI9)
                    tgoR9: subs.get key: pnmR9.copy
                    match (
                        tgoR9
                    ) case some then {
                        mkeys9.append tgoR9
                        mkval9.append false
                    } case none then {
                        vgoR9: valSubs.get key: pnmR9.copy
                        match (
                            vgoR9
                        ) case some then {
                            mkeys9.append vgoR9
                            mkval9.append true
                        } case none then {
                            mkeys9.append 0
                            mkval9.append false
                            mkOk9 = false
                        }
                    }
                    pnI9 = pnI9 + 1
                }
            }
            if (reg.genericArgCount specId: (ztypes.tid.create from: mid9.u64)) == 0 then {
                aiM9: u64
                anM9: mkeys9.length
                for aiM9 < anM9 loop {
                    kM9: mkeys9.get i: aiM9
                    if (mkval9.get i: aiM9) then {
                        (reg.appendGenericArgValue
                            specId: (ztypes.tid.create from: mid9.u64)
                            value: kM9
                        )
                    } else {
                        reg.appendGenericArg specId: (ztypes.tid.create from: mid9.u64) arg: kM9
                    }
                    aiM9 = aiM9 + 1
                }
            }
            # the request resolved its template at COLLECTION: its id, the
            # node that declares it, and the unit whose AST holds that node.
            # One call covers both shapes the scans below split -- a file unit
            # named by the template, and an inline binding of the instantiating
            # unit -- because neither is found by name any more.
            if rtop > 0 when tplId > 0 then {
                match (
                    program
                ) case program then {
                    (buildUnitMono
                        :ty
                        :reg
                        ast: program.ast
                        tmplUnitName: rtu
                        tmplName: rt
                        monoId: (ztypes.tid.create from: mid9.u64)
                        :tplId
                        :subs
                        templateOpId: (zast.nodeid.create from: rtop.u32.orPanic)
                    )
                } else null
            } else {
                if tplId.isZero then {
                    match (
                        program
                    ) case program then {
                        tuiter: program.ast.units.iterate
                        for tuId9: tuiter loop {
                            tu: program.ast.nodes.get i: tuId9.u64
                            match (
                                tu
                            ) case namedoperation then {
                                uc3z9: unitDeclOfNameIdHere :ty nameId: tu.name
                                if uc3z9 == ru then {
                                    tplId = (inlineTemplateTid
                                        :ty
                                        ast: program.ast
                                        mainOpId: tu.operation
                                        tmplName: rt
                                    )
                                }
                            } else null
                        }
                    } else null
                }
                if tplId > 0 then {
                    match (
                        program
                    ) case program then {
                        uN9: program.ast.units.length
                        uI9: u64
                        for uI9 < uN9 loop {
                            u9Id9: (zast.nodeid.create from: (program.ast.units.get i: uI9))
                            uI9 = uI9 + 1
                            # scope the element borrow: the calls below lock
                            # `program.ast` exclusively (they intern mono names)
                            uop29: zast.nodeid
                            un29: String
                            {
                                u9: program.ast.nodes.get i: u9Id9.u64
                                match (
                                    u9
                                ) case namedoperation then {
                                    un29 = zast.poolTextCopy pool: program.ast.names ref: u9.name
                                    uop29 = u9.operation
                                } else null
                            }
                            if un29 == rt then {
                                uq2z9: unitDeclOfName :ty ast: program.ast name: un29.stringview
                                (buildUnitMono
                                    :ty
                                    :reg
                                    ast: program.ast
                                    tmplUnitName: uq2z9
                                    tmplName: rt
                                    monoId: (ztypes.tid.create from: mid9.u64)
                                    :tplId
                                    :subs
                                    templateOpId: uop29
                                )
                            }
                            uc4z9: unitDeclOfName :ty ast: program.ast name: un29.stringview
                            if uc4z9 == ru then {
                                (completeInlineReq
                                    :ty
                                    :reg
                                    ast: program.ast
                                    unitDecl: ru
                                    monoId: (ztypes.tid.create from: mid9.u64)
                                    tmplName: rt
                                    :tplId
                                    :subs
                                    mainOpId: uop29
                                )
                            }
                        }
                    } else null
                }
            }
            if re > 0 then {
                ev: mid9
                ztyping.nodeTypeSet tbl: ty.nodeType nid: re tid: (ztypes.tid.create from: ev.u64)
            }
            if rc > 0 then {
                cv: mid9
                ztyping.nodeTypeSet tbl: ty.nodeType nid: rc tid: (ztypes.tid.create from: cv.u64)
            }
            if rl > 0 when tplId > 0 then {
                (ztyping.nodeTypeSet
                    tbl: ty.nodeType
                    nid: rl
                    tid: (ztypes.tid.create from: tplId.u64)
                )
            }
        } case none then null
        i = i + 1
    }
}

# demandInstArgs -- demand every definition an instantiation's arguments
# name, from the scope the instantiation is written in (a bare type name, a
# dotted one, a nested specialisation's parts), so the mint pass -- which runs
# before the demand drain -- can key the mono on resolved arguments. The
# caller drains.
demandInstArgs: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    r: InstReq
} is {
    prevFrame9: ty.curFrame
    if (r.scopeDeclId.isZero) == false then ty.curFrame = r.scopeDeclId
    n9: r.argNodeIds.length
    i9: u64
    for i9 < n9 loop {
        nid9: r.argNodeIds.get i: i9
        if nid9 > 0 then {
            scanCallsInNode :ty :ast :reg node: (ast.nodes.get i: nid9)
        }
        i9 = i9 + 1
    }
    ty.curFrame = prevFrame9
}

# instMonoKeys -- an instantiation's trie keys in the template's PARAMETER
# order: the argument's type id, or its numeric value (isVal). False when a
# parameter has no resolvable argument (its key stays 0).
instMonoKeys: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    r: InstReq
    tdecl: ztypes.declid
    keys: (ListVal u64)
    isVal: (ListVal bool)
} out bool is {
    ok9: true
    pn9: reg.genericParamNamesOf :tdecl
    if pn9.length == 0 then return false
    pi9: u64
    for pi9 < pn9.length loop {
        pnm9: pn9.get i: pi9
        pi9 = pi9 + 1
        k9: u64
        v9: false
        found9: false
        ai9: u64
        for ai9 < r.argLabels.length loop {
            lbl9: r.argLabels.get i: ai9
            if lbl9.stringview == pnm9.stringview then {
                an9: r.argNames.get i: ai9
                if (isNumericLiteralName name: an9.stringview) then {
                    pv9: parseDecimalU64 text: an9.stringview
                    match (
                        pv9
                    ) case some then {
                        # a value key may be 0 (`sized cap: 0`)
                        k9 = pv9
                        v9 = true
                        found9 = true
                    } case none then null
                } else {
                    k9 = instArgTypeOf :ty :reg :ast :r i: ai9
                    if k9 > 0 then found9 = true
                }
            }
            ai9 = ai9 + 1
        }
        if (found9) == false then ok9 = false
        keys.append k9
        isVal.append v9
    }
    return ok9
}

# unitMonoOnTrie -- the unit mono already minted for `keys` under the
# template, walking one trie level per parameter; none when any level is
# missing. A probe: it lays nothing.
unitMonoOnTrie: function {
    reg: ztypes.ZTypeRegistry
    tplTid: ztypes.tid
    keys: (ListVal u64).view
} out optionval u64 is {
    if tplTid.isZero then return (optionval.none u64)
    cur9: tplTid.u64
    i9: u64
    for i9 < keys.length loop {
        n9: reg.getGenericChild parentId: cur9 key: (keys.get i: i9)
        match (
            n9
        ) case some then {
            cur9 = n9
        } case none then {
            return (optionval.none u64)
        }
        i9 = i9 + 1
    }
    return (optionval.some cur9)
}

# unitMonoJoinTrie -- lay the mono's path under the template: one level per
# parameter, keyed on the argument (a type id or a numeric value; the kinds
# never share a level), interior nodes minted as `{template}__node`, the leaf
# the mono. getOrMintSpec keys a record specialisation the same way; a unit
# tid parents a trie node exactly as a record tid does.
unitMonoJoinTrie: function {
    reg: ztypes.ZTypeRegistry
    tplTid: ztypes.tid
    tplName: StringView
    keys: (ListVal u64).view
    monoId: ztypes.tid
} is {
    if tplTid.isZero then return
    cur9: tplTid.u64
    n9: keys.length
    i9: u64
    for i9 < n9 loop {
        k9: keys.get i: i9
        last9: false
        if i9 + 1 == n9 then last9 = true
        step9: u64
        got9: reg.getGenericChild parentId: cur9 key: k9
        match (
            got9
        ) case some then {
            step9 = got9
        } case none then {
            if last9 then {
                step9 = monoId.u64
            } else {
                inm9: "\{tplName}__node"
                step9 = (reg.newType
                    name: inm9.stringview
                    typetype: ztypes.ztypetype.genericParam
                )
            }
            reg.setGenericChild parentId: cur9 key: k9 child: step9
        }
        cur9 = step9
        i9 = i9 + 1
    }
}

# instArgTypeOf -- the type an instantiation argument names, resolved where
# the instantiation is written: a bare atom by name, a call-shaped argument
# (a specialisation of its own, `(Box t: i64)`) through the type-ref
# resolver, which mints or finds it on the trie. 0 for a numeric value
# argument or an unresolvable one.
instArgTypeOf: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    r: InstReq
    i: u64
} out u64 is {
    anm9: r.argNames.get :i
    if (isNumericLiteralName name: anm9.stringview) then return 0
    prevFrame9: ty.curFrame
    if (r.scopeDeclId.isZero) == false then ty.curFrame = r.scopeDeclId
    out9: u64
    if anm9.length > 0 then {
        ao9: (walkLookupTyperef
            :ast
            :ty
            :reg
            unitDecl: r.declUnit
            base: anm9.stringview
        )
        match (
            ao9
        ) case some then {
            out9 = ao9
        } case none then null
    } else {
        nid9: r.argNodeIds.get :i
        if nid9 > 0 then {
            out9 = (resolveTyperefShell
                :ty
                :reg
                :ast
                unitDecl: r.declUnit
                typeExpr: (ast.nodes.get i: nid9)
                thisName: ""
            )
        }
    }
    ty.curFrame = prevFrame9
    return out9
}

# instMonoLabel -- the mono's label: the template's name and one component per
# argument, a bare atom's own text or, for a call-shaped argument, the label of
# the specialisation it names. The same request derives the same label in
# every pass, which is what the two-pass mint relies on.
instMonoLabel: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    r: InstReq
} out String is {
    mn9: r.tmpl.copy
    na9: r.argNames.length
    i9: u64
    for i9 < na9 loop {
        mn9.append "_"
        an9: r.argNames.get i: i9
        if an9.length > 0 then {
            mn9.append an9
        } else {
            at9: instArgTypeOf :ty :reg :ast :r i: i9
            if at9 > 0 then mn9.append (monoValName
                :ast
                :ty
                :reg
                tid: (ztypes.tid.create from: at9)
            )
        }
        i9 = i9 + 1
    }
    return mn9
}

# resolveMainUnitInstantiations -- resolve generic-unit instantiation bindings
# (intmath: (genmath t: i64)) into mono UNIT types. Two passes avoid nested
# program.ast.units iteration: collect requests (separate fn), then create each mono.
# resolve every generic instantiation the program declares, in whichever unit
# it was written.
resolveMainUnitInstantiations: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    program: Node
} is {
    reqs: (List InstReq)
    scanMainForInstantiations :ty :program :reqs
    i: u64
    for i < reqs.length loop {
        r: reqs.get :i
        rmL0: String
        match (
            program
        ) case program then {
            rmL0 = instMonoLabel :ty :reg ast: program.ast :r
        } else null
        rm: rmL0.stringview
        rtv0: r.tmpl.stringview
        rt: rtv0
        # the template has to be RESOLVED before a mono is minted from it:
        # createUnitMono reads the template's id -- for an inline one, the stamp
        # resolveInlineGenericUnit lays on its def node -- to record the mono's
        # generic origin, and a template in a unit the eager pass did not walk
        # has none. The request already carries what it takes to resolve it:
        # instTemplateDecl found the template's Decl at COLLECTION, through the
        # scope the instantiation was written in. resolveInlineGenericUnit
        # self-guards on that Decl's type id, so this is a no-op whenever
        # anything already resolved the template -- which today is always.
        # A Decl parented straight to the program root is a file unit of the
        # template's name, not an inline template: registerUnitRoots has
        # already minted it.
        {
            tpd9: declParentIdOf :ty declId: r.tmplDeclId
            tu9: r.tmplUnit
            if (declAtProgramTop :ty parentDeclId: tpd9) == false when r.tmplOpId > 0 then {
                match (
                    program
                ) case program then {
                    (resolveInlineGenericUnit
                        :ty
                        :reg
                        ast: program.ast
                        unitDecl: tu9
                        defName: rt
                        parentTid: (declTypeIdOf :ty declId: tpd9)
                        parentDeclId: tpd9
                        unitOpId: (zast.nodeid.create from: r.tmplOpId.u32.orPanic)
                    )
                } else null
            }
        }
        # a request without a template Decl is no instantiation (a unit-level
        # constant CALL the collector also gathers); the template's Decl was
        # found at collection through the instantiation's own scope
        if (r.tmplDeclId.isZero) == false then {
            match (
                program
            ) case program then {
                mintUnitMonoOf :ty :reg ast: program.ast :r label: rm
                (scanTemplateBodyDemands
                    :ty
                    :reg
                    ast: program.ast
                    tmplDeclId: r.tmplDeclId
                    templateOpId: (zast.nodeid.create from: r.tmplOpId.u32.orPanic)
                )
            } else null
        }
        i = i + 1
    }
}

# mintUnitMonoOf -- one instantiation's mono: its arguments demanded and
# drained (the mint pass precedes the drain), keyed in the template's
# parameter order, found on the trie under the template or minted and
# joined there. The label is display only. An argument nothing resolves is
# reported here, where the request is -- it used to reach the emitter.
mintUnitMonoOf: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    r: InstReq
    label: StringView
} is {
    demandInstArgs :ty :reg :ast :r
    resolveDemandedDefs :ty :reg :ast
    tplTid9: declTypeIdOf :ty declId: r.tmplDeclId
    keys9: (ListVal u64)
    isVal9: (ListVal bool)
    ok9: instMonoKeys :ty :reg :ast :r tdecl: r.tmplDeclId keys: keys9 isVal: isVal9
    if (ok9) == false then {
        reportUnresolvedInstArgs :ty :ast :r
        return
    }
    got9: unitMonoOnTrie :reg tplTid: tplTid9 keys: keys9
    match (
        got9
    ) case some then {
        return
    } case none then null
    mono9: (createUnitMono
        :ty
        :reg
        :ast
        monoName: label
        tmplDeclId: r.tmplDeclId
        tplTid: tplTid9
        templateOpId: (zast.nodeid.create from: r.tmplOpId.u32.orPanic)
    )
    unitMonoJoinTrie :reg tplTid: tplTid9 tplName: r.tmpl.stringview keys: keys9 monoId: mono9
}

# reportUnresolvedInstArgs -- E0023 at every instantiation argument that names
# nothing (a numeric value always resolves).
reportUnresolvedInstArgs: function {ty: ztyping.ZTyping ast: Ast.view r: InstReq} is {
    n9: r.argLabels.length
    i9: u64
    for i9 < n9 loop {
        an9: r.argNames.get i: i9
        nid9: r.argNodeIds.get i: i9
        i9 = i9 + 1
        if (isNumericLiteralName name: an9.stringview) then continue
        if nid9 == 0 then continue
        rt9: u64
        {
            prevFrame9: ty.curFrame
            if (r.scopeDeclId.isZero) == false then ty.curFrame = r.scopeDeclId
            if an9.length > 0 then {
                eh9: (envLookup
                    :ty
                    frame: ty.curFrame
                    nameId: (nameIdOf :ast name: an9.stringview)
                )
                rt9 = (declTypeIdOf :ty declId: eh9.declId).u64
            }
            ty.curFrame = prevFrame9
        }
        if rt9 > 0 then continue
        an8: an9.copy
        if an8.length == 0 then an8 = "the argument".string
        n8: ast.nodes.get i: nid9
        (addResolveErrorH
            :ty
            nodeid: (nodeId n: n8)
            lineno: (nodeLine n: n8)
            colno: (nodeCol n: n8)
            e: zast.err.badReference
            msg: "Unknown reference '\{an8}'"
            width: an8.length.u32.orPanic
        )
    }
}

# resolveTemplateConstants -- a generic template's constant members resolve
# once, keyed on the template's type id and evaluated in the template's frame
# (the way a namespace's do under resolveConstantDefsIn); every instance of
# the template shares them. Idempotent through nsConstsWalked.
resolveTemplateConstants: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    tmplDeclId: ztypes.declid
} is {
    ttid9: declTypeIdOf :ty declId: tmplDeclId
    if ttid9.isZero then return
    top9: zast.nodeid
    {
        do9: ty.decls.get i: tmplDeclId.u64
        np9: ast.nodes.get i: do9.node.u64
        if np9.namedoperation then top9 = np9.operation
    }
    if top9.isZero then return
    fr9: unitRootOfDecl :ty declId: tmplDeclId
    if fr9.isZero then return
    (resolveConstantDefsIn
        :ast
        :ty
        :reg
        unitDecl: fr9
        unitdefId: top9
        ownerDeclId: tmplDeclId
    )
}

# scanTemplateBodyDemands -- a template's method bodies name definitions the
# way any body does -- a sibling constant, a sibling function, a core type --
# and they resolve in the TEMPLATE's frame, wherever the instantiation was
# written. Demand them from that frame before any instance walk asks; the
# instance walk itself does not scan. Once per template.
scanTemplateBodyDemands: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    tmplDeclId: ztypes.declid
    templateOpId: zast.nodeid
} is {
    if templateOpId.isZero then return
    if (ty.templateBodiesScanned.has item: templateOpId.u64) then return
    ty.templateBodiesScanned.add item: templateOpId.u64
    prevFrame9: ty.curFrame
    if (tmplDeclId.isZero) == false then ty.curFrame = tmplDeclId
    (scanUnitCalls
        :ty
        :reg
        :ast
        unitdefId: templateOpId
        rootOnly: false
    )
    ty.curFrame = prevFrame9
}

# typecheck -- entry point. Registers a UNIT type per unit and resolves the main
# unit's definition signatures, then demand-resolves the cross-unit types those
# signatures referenced. The registry is supplied by the caller, read by the dumper.
# builtinTidIn -- the canonical registry id of a stdlib builtin DECLARED IN
# `unit`: walkLookupTyperef probes unitDecl first, so naming the unit is the
# qualified lookup. For the builtins `core` does not re-export, which would
# otherwise reach only through the fallback probes. Unmemoized -- the callers
# are guards, not hot paths.
builtinTidIn: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    unitDecl: ztypes.declid
    base: StringView
} out ztypes.tid is {
    return (ztypes.tid.create from: (optU64Or
        o: (walkLookupTyperef :ast :ty :reg :unitDecl :base)
        d: 0
    ))
}

# builtinTidTc -- the canonical registry id of a stdlib builtin by base name
# (unitDecl "" so a user type of the same name never shadows it). 0 when absent.
builtinTidT: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    base: StringView
} out ztypes.tid is {
    bk: (zast.poolFind pool: ast.names text: base)
    if bk > 0 then {
        m: ty.builtinTidMemo.get key: bk.u64
        match (
            m
        ) case some then {
            return m
        } case none then null
    }
    r: (ztypes.tid.create from: (optU64Or
        o: (walkLookupTyperef :ast :ty :reg unitDecl: ztypes.declid :base)
        d: 0
    ))
    if r.isZero then {
        # an internal lookup may still say the aliased container name while
        # the declaration carries the family name (s7): retry the renamed
        # twin -- the alias and the declaration share one canonical tid.
        alt9: ""
        if base == "List" then alt9 = "ListRef"
        if base == "Set" then alt9 = "SetRef"
        if base == "Map" then alt9 = "MapRR"
        if alt9.length > 0 then {
            r = ztypes.tid.create from: (optU64Or
                o: (walkLookupTyperef
                    :ast
                    :ty
                    :reg
                    unitDecl: ztypes.declid
                    base: alt9
                )
                d: 0
            )
        }
    }
    if r.isZero then return r
    if bk > 0 then ty.builtinTidMemo.set key: bk.u64 value: r
    return r
}

# the type id of builtin type `base` (typecheck-side lookup).
builtinTidTc: function {ast: Ast.view st: zenv.ZSymbolTable base: StringView} out ztypes.tid is {
    return (builtinTidT :ast ty: st.typing reg: st.reg :base)
}

# stampTyperefs -- post-demand pass: stamp every recorded type-ref node with its real
# resolved type. Runs after the demand descent, so system + forward refs are present
# in childOf. pendingTyperef is a sibling field of nodeType (no lock
# conflict). The widened typed_nodes differential reads the resulting nodeType rows.
# nameClaimedByScope -- the probe core shared by the negative-proof chains
# (unknown-reference at value/callable sites, unknown-type at stampTyperefs):
# does a unit-level namespace claim the name -- the unit-name space, the
# current unit's resolved children, or system's children? Callers add their
# context legs (local variables, the typeref walk, the closure-wide unit
# scan) and their own exemptions.
nameClaimedByScope: function {
    ast: Ast.view
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    unitDecl: ztypes.declid
    name: StringView
} out bool is {
    if (nameDenotesUnit :ty :reg nameId: (nameIdOf :ast :name)) then return true
    # the current unit's own resolved members (its index), not its SURFACE:
    # a definition its `public:` block makes is reachable qualified, never
    # bare, and must not vouch for a bare name
    ncr9: (childOfWalkIds
        :ty
        :unitDecl
        name: (zast.poolFind pool: ast.names text: name)
    )
    match (
        ncr9
    ) case some then {
        return true
    } case none then null
    # `Any` is not user-reachable through the system probe: only a real
    # scope claim above (its own unit defining it) counts.
    if name == "Any" then return false
    ncs9: resolveSystemChild :ast :ty :reg :name
    match (
        ncs9
    ) case some then {
        # system's own nested units are private to it: a bare name that is
        # one of them is in scope nowhere else
        if (reg.typetypeOf typeId: (ztypes.tid.create from: ncs9)) != ztypes.ztypetype.unitType then return true
    } case none then null
    return false
}

# stamp resolved type ids onto every type reference in the program.
stampTyperefs: function {ty: ztyping.ZTyping reg: ztypes.ZTypeRegistry program: Node} is {
    match (
        program
    ) case program then {
        uq3z9: unitDeclOfName :ty ast: program.ast name: program.mainUnitName.stringview
        stampPendingTyperefs :ty :reg ast: program.ast unitDecl: uq3z9
        ty.typerefPassRan = true
    } else null
}

# stampPendingTyperefs -- stamp the type-ref nodes recorded since the last
# call (pendingTyperef is append-only and iterates in insertion order, so a
# count is the cursor). The first call is the post-demand pass; a definition
# resolved after it -- from a drain during the body walk -- records its
# type-refs the same way, and the drain re-runs this over the new tail.
stampPendingTyperefs: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ast: Ast
    unitDecl: ztypes.declid
} is {
    pkeys9: (ListVal u64)
    pvals9: (List String)
    # entries an earlier pass deferred (their declaration was still
    # unresolved) come first, then the entries recorded since the last pass
    ri9: u64
    rn9: ty.typerefRetry.length
    for ri9 < rn9 loop {
        rk9: ty.typerefRetry.get i: ri9
        ri9 = ri9 + 1
        rv9: ty.pendingTyperef.get key: rk9
        match (
            rv9
        ) case some then {
            pkeys9.append rk9
            pvals9.append rv9.copy
        } case none then null
    }
    ty.typerefRetry = (ListVal u64)
    seen9: u64
    with it: ty.pendingTyperef.iterateItems do for e: it loop {
        seen9 = seen9 + 1
        if seen9 > ty.typerefsStamped then {
            pk9: e.key
            pkeys9.append pk9
            pv9: e.value.copy
            pvals9.append pv9
        }
    }
    ty.typerefsStamped = seen9
    gpNames9: (Set String)
    gpiN9: 1.u64
    gpLast9: reg.nextTypeId
    for gpiN9 < gpLast9 loop {
        if (reg.typetypeOf typeId: (ztypes.tid.create from: gpiN9.u64)) == ztypes.ztypetype.genericParam then {
            gnm9: reg.nameOf tid: (ztypes.tid.create from: gpiN9.u64)
            if gnm9.length > 0 then gpNames9.add item: gnm9
        }
        gpiN9 = gpiN9 + 1
    }
    pi9: u64
    pcnt9: pkeys9.length
    for pi9 < pcnt9 loop {
        uk: pkeys9.get i: pi9
        pval9: pvals9.get i: pi9
        pi9 = pi9 + 1
        # the type-ref resolves in the frame it was written in
        prevFrame9: ty.curFrame
        ty.curFrame = ztypes.declid
        {
            fo9: ty.pendingTyperefFrame.get key: uk
            match (
                fo9
            ) case some then {
                ty.curFrame = fo9
            } case none then null
        }
        # the frame's unit, as the label the surface / claim probes take
        origin: unitDecl
        originOwn9: String
        {
            our9: unitRootOfDecl :ty declId: ty.curFrame
            if (our9.isZero) == false then {
                originOwn9 = zast.poolTextCopy pool: ast.names ref: (declNameIdOf :ty declId: our9)
            }
        }
        if originOwn9.length > 0 then origin = unitDeclOfName :ty :ast name: originOwn9.stringview
        skip0: false
        {
            sk0: ty.noStampNode.get key: uk
            match (
                sk0
            ) case some then {
                if sk0 then skip0 = true
            } case none then null
        }
        if (skip0) == false then {
            r: (walkLookupTyperefFrom
                :ast
                :ty
                :reg
                frame: ty.curFrame
                baseId: (zast.poolFind pool: ast.names text: pval9.stringview)
            )
            match (
                r
            ) case some then {
                nid: uk
                ztyping.nodeTypeSet tbl: ty.nodeType :nid tid: (ztypes.tid.create from: r.u64)
                # every resolved type reference records the declaration it
                # names (refDecl), for go-to-definition (bare + dotted);
                # codegen-inert -- a type-annotation atom is never emitted
                # as an expression.
                sfNmB9: zast.poolFind pool: ast.names text: pval9.stringview
                sfB9: (declSurfaceOfName
                    :ty
                    :reg
                    :ast
                    unitDecl: origin
                    nameId: sfNmB9
                    tid: (ztypes.tid.create from: r.u64)
                )
                stampRefDecl :ty :nid declId: sfB9
            } case none then {
                # a signature typeref that resolves NOWHERE after every
                # demand pass names a nonexistent type. Template param
                # names are exempt: their pendings feed mono substitution
                # and resolve per instantiation (a dead-signature typo
                # that collides with some template's param name is the
                # accepted blind spot).
                if (gpNames9.has item: pval9.copy) then {
                    ty.curFrame = prevFrame9
                    continue
                }
                # a name whose declaration the environment finds queued or
                # mid-resolution is not unknown: this pass may run in the
                # middle of a drain (a nested unit materialising stamps what
                # it recorded) before the declaration has resolved. The
                # reference stamps on a later pass, once it has.
                dh9: (envLookup
                    :ty
                    frame: ty.curFrame
                    nameId: (nameIdOf :ast name: pval9.stringview)
                )
                dhWait9: false
                if (dh9.declId.isZero) == false then {
                    if (ty.declIsPending declId: dh9.declId) then dhWait9 = true
                    if (ty.declIsResolving declId: dh9.declId) then dhWait9 = true
                }
                if dhWait9 then {
                    ty.typerefRetry.append from: uk
                    ty.curFrame = prevFrame9
                    continue
                }
                urHit9: (nameClaimedByScope
                    :ast
                    :ty
                    :reg
                    unitDecl: origin
                    name: pval9.stringview
                )
                if urHit9 == false when pval9.stringview == "Any" then {
                    # `Any` is not user-reachable through the closure:
                    # only a scope claim (its own unit defining it)
                    # resolves it, so an unclaimed `Any` reports.
                    urHit9 = false
                } else if urHit9 == false then {
                    # closure-wide: a bare name may resolve to a member
                    # of ANY loaded unit (the demand resolvers search
                    # the closure; the typeref walk does not)
                    pvId9: nameIdOf :ast name: pval9.stringview
                    puds9: programUnitDecls :ty
                    with uit9: puds9.iterate do for ud9: uit9 loop {
                        if urHit9 == false then {
                            uro2: (resolvedByIds
                                :ast
                                :ty
                                unitDecl: (ztypes.declid.create from: ud9)
                                name: pvId9
                            )
                            match (
                                uro2
                            ) case some then {
                                urHit9 = true
                            } case none then null
                        }
                    }
                }
                if urHit9 then {
                    ty.curFrame = prevFrame9
                    continue
                }
                un9: ast.nodes.get i: uk
                um9: "Unknown type '\{pval9}'"
                (addResolveErrorH
                    :ty
                    nodeid: (nodeId n: un9)
                    lineno: (nodeLine n: un9)
                    colno: (nodeCol n: un9)
                    e: zast.err.badReference
                    msg: um9
                    width: pval9.length.u32.orPanic
                )
            }
        }
        ty.curFrame = prevFrame9
    }
}

# ownershipOfParam -- a parameter's binding ownership from its path annotation:
# an explicit .take binds OWNED, everything else (.borrow / .lock / default)
# binds BORROWED (mirrors _check_function_body_inner's param-ownership mapping).
ownershipOfParam: function {o: optionval ztypes.zparamownership} out ztypes.zownership is {
    match (
        o
    ) case some then {
        po: o
        match (
            po
        ) case noneMode then {
            return ztypes.zownership.borrowed
        } case takeMode then {
            return ztypes.zownership.owned
        } case borrowMode then {
            return ztypes.zownership.borrowed
        } case viewMode then {
            return ztypes.zownership.borrowed
        } case holdMode then {
            return ztypes.zownership.owned
        } case takexMode then {
            # `takex` is a RETURN marker: the result is owned, and the pin on
            # its non-owned sources is what the marker adds. As an ownership
            # answer it is plain `owned`, exactly like `take`.
            return ztypes.zownership.owned
        }
    } case none then {
        return ztypes.zownership.borrowed
    }
}

# paramTypeId -- the resolved type id of a parameter's type-expr. Reads the
# post-demand node stamp (stampTyperefs), falling back to a cross-unit name
# lookup for a bare-atom base.
paramTypeId: function {ast: Ast.view
    typing: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    unitDecl: ztypes.declid
    op: Node.view
} out u64 is {
    # A parameter type carrying an ownership marker (ztypes.ZTypeRegistry.take)
    # resolves through its peeled base: the marker node is recorded under the
    # current unit and left unstamped, so read the inner cross-unit ref that
    # stampTyperefs resolved. Mirrors the reference's _strip_path_ownership.
    match (
        op
    ) case dottedpath then {
        ocn: atomName :ast n: (ast.nodes.get i: op.child.u64)
        if (isStripMarker name: ocn.stringview) then {
            dpr9: ast.nodes.get i: op.parent.u64
            return (paramTypeId :ast :typing :reg :unitDecl op: dpr9)
        }
    } else null
    onid: nodeId n: op
    r: ztyping.nodeTypeAt tbl: typing.nodeType nid: onid.u64
    if r > 0 then {
        return r
    } else {
        an: atomName :ast n: op
        ano: walkLookupTyperef :ast ty: typing :reg :unitDecl base: an.stringview
        anid: optU64Or o: ano d: 0
        if anid > 0 then return anid
        # a dotted typeref naming a variant/union ARM is an arm DEFAULT:
        # the parameter's type is the tagged parent.
        bn: rootNameOf :ast n: op
        if bn.length > 0 then {
            # a dotted numeric literal (0.u64) declares the SUFFIX type: the
            # body read must carry it, not fall to 0 (untyped/permissive)
            dcn9: dottedChildName :ast n: op
            isSfx9: isNumericTypeName name: dcn9.stringview
            if (isNumericLiteralName name: bn.stringview) when isSfx9 then {
                return (optU64Or
                    o: (walkLookupTyperef
                        :ast
                        ty: typing
                        :reg
                        :unitDecl
                        base: dcn9.stringview
                    )
                    d: 0
                )
            }
            return (optU64Or
                o: (walkLookupTyperef
                    :ast
                    ty: typing
                    :reg
                    :unitDecl
                    base: bn.stringview
                )
                d: 0
            )
        }
        return 0
    }
}

# isReturnCallKind -- true iff the stamped call-kind is a diverging control
# statement (return / panic / error); the statement walk marks the scope
# unreachable after one.
isReturnCallKind: function {o: optionval zast.callkind} out bool is {
    match (
        o
    ) case some then {
        ck: o
        match (
            ck
        ) case returnCall then {
            return true
        } case panicCall then {
            return true
        } case errorCall then {
            return true
        } else {
            return false
        }
    } case none then {
        return false
    }
}

# printableNumericName -- the numeric/bool scalar names the emitter's
# interp formatter accepts by name (shadow or spec-scoped instances carry
# these names with non-builtin ids).
printableNumericName: function {name: StringView} out bool is {
    if name == "i8" then return true
    if name == "i16" then return true
    if name == "i32" then return true
    if name == "i64" then return true
    if name == "i128" then return true
    if name == "u8" then return true
    if name == "u16" then return true
    if name == "u32" then return true
    if name == "u64" then return true
    if name == "u128" then return true
    if name == "f16" then return true
    if name == "f32" then return true
    if name == "f64" then return true
    if name == "f128" then return true
    if name == "c8" then return true
    if name == "c32" then return true
    if name == "bool" then return true
    return false
}

# printableInterpTid -- an interpolated part must be a value the string
# machinery can splice: a numeric scalar, bool, a declared tag, String or
# StringView (directly, via typedef, or a str-origin mono/port). Unstamped
# values and generic params pass -- the emitter's loud unhandled-construct
# backstop covers a bad instantiation.
printableInterpTid: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    tid: ztypes.tid
} out bool is {
    if tid.isZero then return true
    if tid == st.reg.literalIntTid then return true
    if tid == st.reg.literalFloatTid then return true
    t9: tid
    for true loop {
        b9: typedefBaseTidOf :st tid: t9
        if b9.isZero then break
        t9 = b9
    }
    if (isNumericTid :ast ty: st.typing reg: st.reg tid: t9) then return true
    if t9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "bool") then return true
    if t9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "String") then return true
    if t9 == (builtinTidT :ast ty: st.typing reg: st.reg base: "StringView") then return true
    tt9: st.reg.typetypeOf typeId: t9
    if tt9 == ztypes.ztypetype.genericParam then return true
    if tt9 == ztypes.ztypetype.tagType then return true
    if tt9 == ztypes.ztypetype.functionType then {
        ro9: methodReturnOf :st mid: (ztypes.tid.create from: t9.u64)
        match (
            ro9
        ) case some then {
            return (printableInterpTid :ast :st :unitDecl tid: ro9)
        } case none then null
        return true
    }
    tn9: typeNameOf :st tid: t9
    if (printableNumericName name: tn9.stringview) then return true
    if tn9.stringview == "String" then return true
    if tn9.stringview == "StringView" then return true
    strO9: builtinTidT :ast ty: st.typing reg: st.reg base: "str"
    go9: st.reg.genericOriginOf tid: t9
    if strO9 > 0 when go9.u64 == strO9 then return true
    return false
}

# checkString -- a non-interpolated string literal types as StringView; an
# interpolated one (any non-chunk part) types as String, since it must allocate
# to splice the values, and each interpolated sub-expression is walked + stamped.
checkString: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    ast: Ast.view
    node: zast.AtomStringData.view
} out ztypes.tid is {
    result: ztypes.tid
    hasInterp: false
    for partId9: node.stringparts.iterate loop {
        part: ast.nodes.get i: partId9.u64
        match (
            part
        ) case stringchunk then null else {
            hasInterp = true
            en0: st.typing.errors.length
            ptid9: checkValue :st :unitDecl :ast node: part
            if st.typing.errors.length == en0 when (printableInterpTid
                :ast
                :st
                :unitDecl
                tid: ptid9
            ) == false then {
                ptn9: typeNameOf :st tid: ptid9
                pm9: "type '\{ptn9}' is not printable in an interpolation"
                (addErrorH
                    :st
                    nodeid: (nodeId n: part)
                    lineno: (nodeLine n: part)
                    colno: (nodeCol n: part)
                    e: zast.err.typeError
                    msg: pm9
                    note: "an interpolated value must be numeric, bool, String or StringView".string
                    hint: "unwrap or format the value first: match on it or use an accessor that yields a printable type".string
                    width: 1
                )
            }
        }
    }
    # the runtime value is always the SYSTEM String/StringView (the interp
    # machinery and the literal pool build system strings), so the stamp is
    # canonical even in a unit that shadows the name
    tyOpt: (optionval.none u64)
    if hasInterp then {
        tyOpt = (walkLookupTyperef
            :ast
            ty: st.typing
            reg: st.reg
            unitDecl: ztypes.declid
            base: "String"
        )
    } else {
        tyOpt = (walkLookupTyperef
            :ast
            ty: st.typing
            reg: st.reg
            unitDecl: ztypes.declid
            base: "StringView"
        )
    }
    match (
        tyOpt
    ) case some then {
        result = ztypes.tid.create from: tyOpt.u64
        setk: result
        stampGate :st nid: node.nodeid.u64 tid: setk
    } case none then null
    drainPendingBorrow :st
    return result
}

# checkAtomid -- type a name-atom in value position: a local variable resolves
# via the symbol table. (Numeric literals + unit-def atoms land in later slices.)
# typeNameOf -- a registered type's name as an owned String ("" when absent).
typeNameOf: function {st: zenv.ZSymbolTable tid: ztypes.tid} out String is {
    return (regTypeNameOf reg: st.reg :tid)
}

# cloneMethodInto -- specialize one template method for an instance: a fresh
# FUNCTION type named {spec}.{m} whose param children and return substitute
# the template parameters (id-first, then re-specialization). genericOriginId
# points at the TEMPLATE METHOD so the emitter's mono-instance sweep emits the
# template body against this signature.
cloneMethodInto: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    specId: ztypes.tid
    tplClassId: ztypes.tid
    m: StringView
    tplFnId: u64
    idSubs: (MapVV u64 value: u64)
} is {
    fid5: reg.newType name: m ownerTid: specId typetype: ztypes.ztypetype.functionType
    reg.setGenericOrigin typeId: fid5 value: tplFnId
    # declare and type the method before filling its parameters: typing claims
    # the method's own function type for its declaration, which is what the
    # parameter writes below reach through. Doing it last leaves every parameter
    # of every cloned method with nowhere to land.
    mnid5: (zast.poolFind pool: ast.names text: m)
    (ty.declSynthMember
        parentTypeId: specId
        nameId: mnid5
        kind: ztyping.declkind.methodDecl
    )
    (ty.setMemberType parentTypeId: specId nameId: mnid5 childTypeId: fid5)
    # The clone answers call-site questions the same way the template does:
    # isNative gates arg validation, thisParamName drives receiver auto-fill
    # and the no-paren auto-call, funcReturnsBorrow carries the `.borrow`
    # return marker, and funcReturnNode backs methodReturnOf for concrete
    # (non-generic) returns.
    tpn0id: u32
    isNat0: false
    if tplFnId < reg.typeById.length then {
        tz0: reg.typeById.get i: tplFnId
        if tz0.isNative then isNat0 = true
        tpn0id = tz0.thisParamNameId
    }
    if isNat0 then reg.setNative typeId: fid5 value: true
    if tpn0id > 0 then (reg.setThisParamName
        typeId: fid5
        nameId: (zast.nameid.create from: tpn0id.u32)
    )
    tpn0: zast.poolTextAt pool: ast.names ref: (zast.nameid.create from: tpn0id.u32)
    if (optBoolOr o: (ty.funcReturnsView.get key: tplFnId) d: false) then {
        ty.funcReturnsView.set key: fid5 value: true
    }
    if (optBoolOr o: (ty.funcReturnsTakex.get key: tplFnId) d: false) then {
        ty.funcReturnsTakex.set key: fid5 value: true
    }
    if (optBoolOr o: (ty.funcReturnsBorrow.get key: tplFnId) d: false) then {
        ty.funcReturnsBorrow.set key: fid5 value: true
    }
    frn0: optU64Or o: (ty.funcReturnNode.get key: tplFnId) d: 0
    if frn0 > 0 then ty.funcReturnNode.set key: fid5 value: frn0
    cN5: (List String)
    cI5: (ListVal u64)
    cNid5: (ListVal u64)
    cOh5: (ListVal bool)
    cOv5: (ListVal ztypes.zparamownership)
    {
        ty.declMemberList ownerTid: (ztypes.tid.create from: tplFnId.u64) names: cNid5 tids: cI5
        cq5: u64
        cqn5: cNid5.length
        for cq5 < cqn5 loop {
            nmB5: ast.names.texts.get i: ((cNid5.get i: cq5)).u64
            nm5: nmB5.copy
            cN5.append nm5
            cq5 = cq5 + 1
        }
    }
    # the template's parameter ownership
    {
        oi5: u64
        for oi5 < cNid5.length loop {
            onid5: cNid5.get i: oi5
            oi5 = oi5 + 1
            oo5: (ty.declOwnershipOfId
                parentTypeId: (ztypes.tid.create from: tplFnId.u64)
                nameId: (zast.nameid.create from: onid5.u32.orPanic)
            )
            match (
                oo5
            ) case some then {
                cOh5.append true
                ov5c: oo5
                cOv5.append ov5c
            } case none then {
                cOh5.append false
                cOv5.append ztypes.zparamownership.borrowMode
            }
        }
    }
    tplNm5: regTypeNameOf :reg tid: (ztypes.tid.create from: tplClassId.u64)
    pi5: u64
    pn5: cN5.length
    for pi5 < pn5 loop {
        pnm5: cN5.get i: pi5
        ptid5: cI5.get i: pi5
        tgt5: ptid5
        if ptid5 == tplClassId then tgt5 = specId
        if pnm5.stringview == "this" then tgt5 = specId
        if tpn0.length > 0 when pnm5.stringview == tpn0.stringview then tgt5 = specId
        if tgt5 == ptid5 then {
            # `this`/`type`-typed params carry fresh shells named after the
            # class; shell-name identity marks the self type.
            ptn5: regTypeNameOf :reg tid: (ztypes.tid.create from: ptid5.u64)
            if ptn5.stringview == tplNm5.stringview then tgt5 = specId
        }
        if tgt5 == ptid5 then {
            ido5: idSubs.get key: ptid5
            match (
                ido5
            ) case some then {
                tgt5 = ido5
            } case none then {
                rs5: respecialize :ast :ty :reg :unitDecl specTid: ptid5 :idSubs
                if rs5 > 0 then tgt5 = rs5
            }
        }
        (ty.setMemberType
            parentTypeId: fid5
            nameId: (zast.poolFind pool: ast.names text: pnm5.stringview)
            childTypeId: tgt5
        )
        if (cOh5.get i: pi5) then {
            pov5: cOv5.get i: pi5
            (ty.setChildOwnership
                pool: ast.names
                parentTypeId: fid5
                name: pnm5.stringview
                ownership: pov5
            )
        }
        pi5 = pi5 + 1
    }
    rto5: ztypes.tid
    {
        ro5: reg.returnTypeOf tid: (ztypes.tid.create from: tplFnId.u64)
        if ro5 > 0 then rto5 = ro5
    }
    if rto5 > 0 then {
        rt5: rto5
        if rto5 == tplClassId then rt5 = specId
        if rt5 == rto5 then {
            rtn5: regTypeNameOf :reg tid: (ztypes.tid.create from: rto5.u64)
            if rtn5.stringview == tplNm5.stringview then rt5 = specId
        }
        rdo5: idSubs.get key: rto5
        match (
            rdo5
        ) case some then {
            rt5 = ztypes.tid.create from: (rdo5)
        } case none then {
            rr5: respecialize :ast :ty :reg :unitDecl specTid: rto5 :idSubs
            if rr5 > 0 then rt5 = ztypes.tid.create from: rr5.u64
        }
        # a return still GENERIC_PARAM-typed (a partial the subs could not
        # complete -- multi-param chains mint with empty subs) stays unset;
        # the name-keyed fixup arms heal it after minting
        if (reg.typetypeOf typeId: rt5) != ztypes.ztypetype.genericParam then {
            reg.setReturnType typeId: fid5 value: rt5
        }
    }
}

# respecialize -- a type that is itself a specialization (nonempty genericArgs)
# re-specializes when any of its arguments is substituted: the origin template
# specializes again with the mapped argument list. 0 when nothing changes.
respecialize: function {
    ast: Ast.view
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    specTid: u64
    idSubs: (MapVV u64 value: u64)
} out u64 is {
    an9: reg.genericArgCount specId: (ztypes.tid.create from: specTid.u64)
    if an9 == 0 then return 0
    origin9: ztypes.tid
    {
        og9: reg.genericOriginOf tid: (ztypes.tid.create from: specTid.u64)
        if og9 > 0 then origin9 = og9
    }
    if origin9.isZero then return 0
    changed9: false
    mapped9: (ListVal u64)
    ai9: u64
    for ai9 < an9 loop {
        av9: reg.genericArgAt specId: (ztypes.tid.create from: specTid.u64) ordinal: ai9
        if (reg.genericArgIsValueAt
            specId: (ztypes.tid.create from: specTid.u64)
            ordinal: ai9
        ) then {
            # a numeric VALUE ordinal has nothing to substitute
            av9v: av9
            mapped9.append av9v
        } else {
            mo9: idSubs.get key: av9
            match (
                mo9
            ) case some then {
                mapped9.append mo9
                changed9 = true
            } case none then {
                # an arg that is itself a spec may carry substitutable args one
                # level down (OptionView over a MapEntry partial) -- recurse
                rec9: respecialize :ast :ty :reg :unitDecl specTid: av9 :idSubs
                if rec9 > 0 then {
                    mapped9.append rec9
                    changed9 = true
                } else {
                    av9b: av9
                    mapped9.append av9b
                }
            }
        }
        ai9 = ai9 + 1
    }
    if changed9 == false then return 0
    tk9: declOfTypeId :reg tid: origin9
    pn9: reg.genericParamNamesOf tdecl: tk9
    if pn9.length != an9 then return 0
    subs9: (MapRV String value: u64)
    rvSubs9: (MapRV String value: u64)
    sfx9: String
    on9: regTypeNameOf :reg tid: origin9
    mi9: u64
    for mi9 < an9 loop {
        mp9: pn9.get i: mi9
        mv9: mapped9.get i: mi9
        sfx9.append s: "_"
        if (reg.genericArgIsValueAt
            specId: (ztypes.tid.create from: specTid.u64)
            ordinal: mi9
        ) then {
            vk9: mp9.copy
            vv9r: mv9
            rvSubs9.set key: vk9 value: vv9r
            nvs9: "\{mv9}"
            sfx9.append s: nvs9
        } else {
            sk9: mp9.copy
            sv9: mv9
            subs9.set key: sk9 value: sv9
            vn9: monoValName :ast :ty :reg tid: (ztypes.tid.create from: mv9.u64)
            sfx9.append s: vn9
        }
        mi9 = mi9 + 1
    }
    mn9: "\{on9}\{sfx9}"
    return (getOrMintSpec
        :ast
        :ty
        :reg
        :unitDecl
        name: mn9.stringview
        templateId: (ztypes.tid.create from: origin9.u64)
        subs: subs9
        valSubs: rvSubs9
        fallbackArg: 0
    )
}

# templateTypetypeOf -- the typetype a specialization of `templateId` takes. The
# spec front door allocates the instance id itself (so the trie path can be
# written before the children are built), and this is the one thing about the
# template it needs to do that.
templateTypetypeOf: function {
    reg: ztypes.ZTypeRegistry.view
    templateId: ztypes.tid
} out ztypes.ztypetype is {
    if templateId < reg.typeById.length then {
        tpl: reg.typeById.get i: templateId
        return tpl.typetype
    }
    return ztypes.ztypetype.recordType
}

# mintMono -- populate one generic-instance type: the template's typetype and
# valtype flag, genericOriginId linking back, and the instance's children -- the template's children with generic-param targets
# substituted (matched by arg name; fallbackArg substitutes every child, the
# single-type-param call-site inference) -- plus the synthesized members: a
# per-instance tag data type (variants and unions) and the autogen ==/!=
# functions (variants). Childless templates (the collection classes) produce
# no children; their cloned method children land with the class-mono slice.
mintMono: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    name: StringView
    templateId: ztypes.tid
    subs: (MapRV String value: u64)
    idSubs: (MapVV u64 value: u64)
    fallbackArg: u64
    monoTid: u64
} is {
    # a specialisation's members resolve in the TEMPLATE's frame, with the
    # argument substitution -- lexical scoping; the instantiating unit is
    # not where the template's names live
    prevFrame9: ty.curFrame
    {
        td9: declOfTypeId :reg tid: templateId
        if (td9.isZero) == false then ty.curFrame = td9
    }
    mintMonoIn :ast :ty :reg :unitDecl :name :templateId :subs :idSubs :fallbackArg :monoTid
    ty.curFrame = prevFrame9
}

mintMonoIn: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    name: StringView
    templateId: ztypes.tid
    subs: (MapRV String value: u64)
    idSubs: (MapVV u64 value: u64)
    fallbackArg: u64
    monoTid: u64
} is {
    # the template's names -- a child's type, a constraint's type -- resolve
    # in the TEMPLATE's unit (the cursor is at the template), not the
    # instantiating unit's, which may shadow them
    tplUnit9: unitNameOfTid :ty :reg tid: templateId
    if tplUnit9.length == 0 then tplUnit9 = unitNameTextOf :ty :ast :unitDecl
    tt: ztypes.ztypetype.recordType
    vto: (optionval.none bool)
    tplNative: false
    if templateId < reg.typeById.length then {
        tpl: reg.typeById.get i: templateId
        tt = tpl.typetype
        vto = tpl.isValtype
        tplNative = tpl.isNative
    }
    mid: monoTid
    match (
        vto
    ) case some then {
        reg.setValtype typeId: (ztypes.tid.create from: mid.u64) value: vto
    } case none then null
    reg.setGenericOrigin typeId: (ztypes.tid.create from: mid.u64) value: templateId
    declMonoType :ty :reg monoTid: mid :templateId
    reg.setNative typeId: (ztypes.tid.create from: mid.u64) value: tplNative
    if tt == ztypes.ztypetype.classType then reg.setIsHeapAllocated typeId: (ztypes.tid.create from: mid.u64)
    # A heap-owning generic instance carries a destructor (so a holder/local
    # frees it; the emitter builds the cname). Collections own native heap;
    # Option/Result own a heap box. A user generic whose template already has a
    # destructor inherits one. Map/Set own native heap too (freed via a `&`-less
    # heap-pointer destroy). Views (ListView/OptionView) own no heap -- excluded.
    needsDtorM: false
    if templateId == (builtinTidT :ast :ty :reg base: "ListRef") then needsDtorM = true
    if templateId == (builtinTidT :ast :ty :reg base: "ListVal") then needsDtorM = true
    if templateId == (builtinTidT :ast :ty :reg base: "Option") then needsDtorM = true
    if templateId == (builtinTidT :ast :ty :reg base: "Result") then needsDtorM = true
    if templateId == (builtinTidT :ast :ty :reg base: "MapRR") then needsDtorM = true
    if templateId == (builtinTidT :ast :ty :reg base: "MapRV") then needsDtorM = true
    if templateId == (builtinTidT :ast :ty :reg base: "MapVR") then needsDtorM = true
    if templateId == (builtinTidT :ast :ty :reg base: "MapVV") then needsDtorM = true
    if templateId == (builtinTidT :ast :ty :reg base: "SetRef") then needsDtorM = true
    if templateId == (builtinTidT :ast :ty :reg base: "SetVal") then needsDtorM = true
    if needsDtorM then {
        mdnM: "\{name}_destroy"
        (reg.setDestructorName
            typeId: (ztypes.tid.create from: mid.u64)
            nameId: (zast.poolSet pool: ast.names text: mdnM.stringview)
        )
    }
    # An elided leading type argument stages under the empty name; rebind it
    # to the template's primary generic parameter so the substituted children
    # resolve (`(List String)` == `(List of: String)`).
    {
        emptyKey: String
        ev: subs.get key: emptyKey
        match (
            ev
        ) case some then {
            prnm: firstGenericParamName :reg :templateId
            if prnm.length > 0 then subs.set key: prnm value: ev
        } case none then null
    }
    cNames: (List String)
    cIds: (ListVal u64)
    forceAllMembers :ty :reg :ast tid: templateId
    {
        mmNms9: (ListVal u64)
        ty.declMemberList ownerTid: templateId names: mmNms9 tids: cIds
        mmq9: u64
        mmn9: mmNms9.length
        for mmq9 < mmn9 loop {
            cnB1: ast.names.texts.get i: ((mmNms9.get i: mmq9)).u64
            cn: cnB1.copy
            cNames.append cn
            mmq9 = mmq9 + 1
        }
    }
    listTplT5: builtinTidT :ast :ty :reg base: "ListRef"
    monoNeedsDtor9: false
    ci: u64
    cn3: cNames.length
    for ci < cn3 loop {
        chName: cNames.get i: ci
        chId: cIds.get i: ci
        target: chId
        ido9: idSubs.get key: chId
        match (
            ido9
        ) case some then {
            target = ido9
        } case none then {
            rsp9: respecialize :ast :ty :reg :unitDecl specTid: chId :idSubs
            if rsp9 > 0 then target = rsp9
        }
        ctn: regTypeNameOf :reg tid: (ztypes.tid.create from: chId.u64)
        if target == chId then target = optU64Or o: (subs.get key: ctn) d: target
        # THE BOX RULE at instantiation: a union arm whose substituted type
        # is a builtin Box mono collapses to the ELEMENT, exactly as a
        # declared (Box T) arm does. Every union arm is a malloc'd cell on
        # the void* data slot, so the collapse keeps construction, match
        # narrowing, the destructor cast and the native io fragments'
        # layout on the element -- a Box value IS the cell pointer.
        if tt == ztypes.ztypetype.unionType then {
            bxg5: ztypes.tid
            {
                bxo5: reg.genericOriginOf tid: (ztypes.tid.create from: target.u64)
                if bxo5 > 0 then bxg5 = bxo5
            }
            # the builtin-Box discriminator mirrors checkBoxConstruction's
            # call gate (name + classType + empty body); comparing by name
            # avoids RESOLVING Box here, which would mint its tid earlier
            # than before and renumber every later type id.
            isBxT5: false
            if bxg5 > 0 then {
                bxn5: regTypeNameOf :reg tid: (ztypes.tid.create from: bxg5.u64)
                if bxn5.stringview == "Box" then {
                    if (reg.typetypeOf typeId: bxg5) == ztypes.ztypetype.classType then {
                        if (ty.declMemberCount ownerTid: bxg5) == 0 then isBxT5 = true
                    }
                }
            }
            if isBxT5 then {
                if (reg.genericArgCount specId: (ztypes.tid.create from: target.u64)) == 1 then {
                    target = (reg.genericArgAt
                        specId: (ztypes.tid.create from: target.u64)
                        ordinal: 0
                    )
                }
            }
        }
        # Generic FUNCTION children are clone candidates: the elided-arg
        # fallback must not swallow them (a method child's dotted name never
        # resolves, so the lookup-miss leg would replace the method with the
        # element type).
        chGen5: false
        if (reg.typetypeOf typeId: (ztypes.tid.create from: chId.u64)) == ztypes.ztypetype.functionType then {
            chGen5 = reg.isGenericOf tid: (ztypes.tid.create from: chId.u64)
        }
        if fallbackArg > 0 when (ctn.stringview == "null") == false when target == chId when (chGen5) == false then {
            cko: (walkLookupTyperef
                :ast
                :ty
                :reg
                unitDecl: (unitDeclOfName :ty :ast name: tplUnit9.stringview)
                base: ctn.stringview
            )
            match (
                cko
            ) case some then null case none then {
                target = fallbackArg
            }
        }
        deep5: false
        if target == chId when chGen5 then {
            isSynth5: false
            if chName.stringview == "create" then isSynth5 = true
            if chName.stringview == "borrow" then isSynth5 = true
            if chName.stringview == "==" then isSynth5 = true
            if chName.stringview == "!=" then isSynth5 = true
            if isSynth5 == false then {
                skip5: false
                # List's contains/sort exist only for eligible element
                # kinds (use-site parity with the materializer gate).
                if templateId == listTplT5 when listTplT5 > 0 then {
                    csM5: false
                    if chName.stringview == "contains" then csM5 = true
                    if chName.stringview == "sort" then csM5 = true
                    if csM5 then {
                        elemT5: optU64Or o: (subs.get key: ("of".string)) d: 0
                        if elemT5 == 0 then elemT5 = fallbackArg
                        ok5: false
                        if elemT5 > 0 then {
                            csel5: false
                            if chName.stringview == "contains" then {
                                csel5 = (isContainsEligibleTid
                                    :ast
                                    :ty
                                    :reg
                                    tid: (ztypes.tid.create from: elemT5.u64)
                                )
                            } else {
                                csel5 = (isSortEligibleTid
                                    :ast
                                    :ty
                                    :reg
                                    tid: (ztypes.tid.create from: elemT5.u64)
                                )
                            }
                            if csel5 then ok5 = true
                        }
                        if (ok5) == false then skip5 = true
                    }
                }
                if skip5 then {
                    deep5 = true
                } else {
                    (cloneMethodInto
                        :ast
                        :ty
                        :reg
                        :unitDecl
                        specId: (ztypes.tid.create from: mid.u64)
                        tplClassId: templateId
                        m: chName.stringview
                        tplFnId: chId
                        :idSubs
                    )
                    deep5 = true
                }
            }
        }
        if deep5 == false then {
            (ty.setMemberType
                parentTypeId: (ztypes.tid.create from: mid.u64)
                nameId: (zast.poolFind pool: ast.names text: chName.stringview)
                childTypeId: target
            )
        }
        if (reg.typetypeOf typeId: (ztypes.tid.create from: chId.u64)) != ztypes.ztypetype.functionType then {
            # A marker belongs to the MEMBER, and every use site asks the
            # INSTANCE type about it -- so it has to be copied onto the clone
            # or it is enforced on the template alone, which nothing checks.
            cho9: (ty.declOwnershipOfId
                parentTypeId: templateId
                nameId: (zast.poolFind pool: ast.names text: chName.stringview)
            )
            match (
                cho9
            ) case some then {
                (ty.setChildOwnership
                    pool: ast.names
                    parentTypeId: (ztypes.tid.create from: mid.u64)
                    name: chName.stringview
                    ownership: cho9
                )
            } case none then null
            if (ty.declIsLockField
                pool: ast.names
                parentTypeId: templateId
                name: chName.stringview
            ) then {
                (ty.setChildLockField
                    pool: ast.names
                    parentTypeId: (ztypes.tid.create from: mid.u64)
                    name: chName.stringview
                )
            } else {
                if (reg.hasDestructorName typeId: (ztypes.tid.create from: target.u64)) then monoNeedsDtor9 = true
            }
        }
        ci = ci + 1
    }
    # A user generic CLASS whose SUBSTITUTED fields are destructible carries
    # an auto-destructor, exactly like its non-generic counterpart (the
    # builtin-template list above cannot see through substitution; without
    # this, `class { val: t }` with t=String leaks its payload).
    if tt == ztypes.ztypetype.classType when monoNeedsDtor9 when (reg.hasDestructorName typeId: (ztypes.tid.create from: mid.u64)) == false then {
        mdnU9: "\{name}_destroy"
        (reg.setDestructorName
            typeId: (ztypes.tid.create from: mid.u64)
            nameId: (zast.poolSet pool: ast.names text: mdnU9.stringview)
        )
    }
    # RECORD instances: numeric-param fields synthesize from their declared
    # constraint (size: u64.generic -> a u64 child) when no field references
    # them; then the meta-create requalifies to the instance and ==/!=
    # synthesize -- except str/array, whose branches own those members
    # (their u64 `to` child comes from THIS synth; the branches add none).
    if tt == ztypes.ztypetype.recordType then {
        isSized9: false
        if templateId == (builtinTidT :ast :ty :reg base: "str") then isSized9 = true
        if templateId == (builtinTidT :ast :ty :reg base: "array") then isSized9 = true
        tk9: declOfTypeId :reg tid: templateId
        pNames9: reg.genericParamNamesOf tdecl: tk9
        pi9: u64
        pn0: pNames9.length
        for pi9 < pn0 loop {
            pname9: pNames9.get i: pi9
            cdx9: reg.genericParamConstraintOf tdecl: tk9 paramName: pname9.stringview
            # A NUMERIC bound is what synthesizes a field (`size: u64.generic`
            # becomes a real `size` field). Written as a denylist -- everything
            # except `any` and `none` -- this also claimed the FAMILY bounds and
            # StringLike, which are type constraints with nothing to store; it
            # only ever saw numeric/any/none because the family bounds were
            # spelled `Any.generic` until the val/ref rename. Ask the question
            # the comment above states.
            isNum9: cdx9.kind == ztypes.constraintkind.numeric
            if isNum9 then {
                exo9: (ty.declChildOf
                    pool: ast.names
                    parentTypeId: (ztypes.tid.create from: mid.u64)
                    name: pname9.stringview
                )
                match (
                    exo9
                ) case some then null case none then {
                    pcon9: constraintTextOf desc: cdx9
                    cno9: (walkLookupTyperef
                        :ast
                        :ty
                        :reg
                        unitDecl: (unitDeclOfName :ty :ast name: tplUnit9.stringview)
                        base: pcon9.stringview
                    )
                    match (
                        cno9
                    ) case some then {
                        (ty.setMemberType
                            parentTypeId: (ztypes.tid.create from: mid.u64)
                            nameId: (zast.poolFind pool: ast.names text: pname9.stringview)
                            childTypeId: cno9
                        )
                    } case none then null
                }
            }
            pi9 = pi9 + 1
        }
        if (isSized9) == false then {
            crId9: reg.newType name: "create" ownerTid: mid typetype: ztypes.ztypetype.functionType
            (ty.declSynthMember
                parentTypeId: (ztypes.tid.create from: mid.u64)
                nameId: zast.wkCreate
                kind: ztyping.declkind.methodDecl
            )
            (ty.setMemberType
                parentTypeId: (ztypes.tid.create from: mid.u64)
                nameId: zast.wkCreate
                childTypeId: crId9
            )
            (forceMemberOf
                :ty
                :reg
                :ast
                parentTypeId: (ztypes.tid.create from: mid.u64)
                nameId: zast.wkOpEq
            )
            eqo9: (ty.declChildOfId
                parentTypeId: (ztypes.tid.create from: mid.u64)
                nameId: zast.wkOpEq
            )
            match (
                eqo9
            ) case some then null case none then {
                reqId9: reg.newType name: "==" ownerTid: mid typetype: ztypes.ztypetype.functionType
                (ty.declSynthMember
                    parentTypeId: (ztypes.tid.create from: mid.u64)
                    nameId: zast.wkOpEq
                    kind: ztyping.declkind.methodDecl
                )
                (ty.setMemberType
                    parentTypeId: (ztypes.tid.create from: mid.u64)
                    nameId: zast.wkOpEq
                    childTypeId: reqId9
                )
                rneId9: reg.newType name: "!=" ownerTid: mid typetype: ztypes.ztypetype.functionType
                (ty.declSynthMember
                    parentTypeId: (ztypes.tid.create from: mid.u64)
                    nameId: zast.wkOpNe
                    kind: ztyping.declkind.methodDecl
                )
                (ty.setMemberType
                    parentTypeId: (ztypes.tid.create from: mid.u64)
                    nameId: zast.wkOpNe
                    childTypeId: rneId9
                )
            }
        }
    }
    wantTag: false
    if tt == ztypes.ztypetype.variantType then wantTag = true
    if tt == ztypes.ztypetype.unionType then wantTag = true
    if wantTag then {
        tagName: "\{name}:tag:data"
        tagId: reg.newType name: tagName.stringview typetype: ztypes.ztypetype.dataType
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: mid.u64)
            nameId: zast.wkTag
            kind: ztyping.declkind.fieldDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: mid.u64)
            nameId: zast.wkTag
            childTypeId: tagId
        )
    }
    if tt == ztypes.ztypetype.variantType then {
        eqId: reg.newType name: "==" ownerTid: mid typetype: ztypes.ztypetype.functionType
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: mid.u64)
            nameId: zast.wkOpEq
            kind: ztyping.declkind.methodDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: mid.u64)
            nameId: zast.wkOpEq
            childTypeId: eqId
        )
        neId: reg.newType name: "!=" ownerTid: mid typetype: ztypes.ztypetype.functionType
        (ty.declSynthMember
            parentTypeId: (ztypes.tid.create from: mid.u64)
            nameId: zast.wkOpNe
            kind: ztyping.declkind.methodDecl
        )
        (ty.setMemberType
            parentTypeId: (ztypes.tid.create from: mid.u64)
            nameId: zast.wkOpNe
            childTypeId: neId
        )
    }
}

# isContainsEligibleTid / isSortEligibleTid -- element types List.contains /
# List.sort support (the hardcoded equality / ordering dispatch): numerics +
# bool + the String/StringView/str family; sort excludes bool (no ordering).
isContainsEligibleTid: function {
    ast: Ast.view
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    tid: ztypes.tid
} out bool is {
    if tid == (builtinTidT :ast :ty :reg base: "bool") then return true
    return (isSortEligibleTid :ast :ty :reg :tid)
}

# true when type `tid` is eligible for the sort-support machinery.
isSortEligibleTid: function {
    ast: Ast.view
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    tid: ztypes.tid
} out bool is {
    if tid.isZero then return false
    if (isNumericTid :ast :ty :reg :tid) then return true
    if tid == (builtinTidT :ast :ty :reg base: "String") then return true
    if tid == (builtinTidT :ast :ty :reg base: "StringView") then return true
    if tid == (builtinTidT :ast :ty :reg base: "str") then return true
    return false
}

# mintCollectionMethod -- one synthesized `{mono}.{m}` FUNCTION child; returns
# the method's type id so callers can link its return type.
mintCollectionMethod: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    monoId: ztypes.tid
    m: StringView
} out u64 is {
    fid: reg.newType name: m ownerTid: monoId typetype: ztypes.ztypetype.functionType
    reg.setNative typeId: fid value: true
    mnid9: zast.poolFind pool: ast.names text: m
    # declare before typing: setMemberType claims the method's own function type
    # for its declaration, and the parameter writes that follow need it. Typing
    # first leaves the method undeclared, so nothing claims it and every
    # parameter has nowhere to land.
    (ty.declSynthMember
        parentTypeId: monoId
        nameId: mnid9
        kind: ztyping.declkind.methodDecl
    )
    (ty.setMemberType
        parentTypeId: monoId
        nameId: mnid9
        childTypeId: fid
    )
    return fid
}

# specLookup -- the existing specialization of `templateId` over the ordered
# concrete arguments `args`, read straight off the id trie getOrMintSpec builds.
# Lookup only: it never mints, so a caller can ask whether an instance was
# demanded. 0 when any argument is unset or the path is not in the trie.
specLookup: function {
    reg: ztypes.ZTypeRegistry
    templateId: ztypes.tid
    args: (ListVal u64).view
} out ztypes.tid is {
    if templateId.isZero then return (ztypes.tid.create from: 0)
    if args.length == 0 then return (ztypes.tid.create from: 0)
    cur9: templateId
    ok9: true
    with ait9: args.iterate do for a9: ait9 loop {
        if ok9 then {
            if a9 == 0 then {
                ok9 = false
            } else {
                n9: reg.getGenericChild parentId: cur9 key: a9
                match (
                    n9
                ) case some then {
                    cur9 = n9
                } case none then {
                    ok9 = false
                }
            }
        }
    }
    if ok9 == false then return (ztypes.tid.create from: 0)
    return cur9
}

# getOrMintSpec -- the id-keyed specialization tree front door: derive the
# definition-order argument keys from the name-keyed subs (fallbackArg fills a
# single missing parameter), walk the generic-child edges, and return the existing
# spec on a full-path hit. A parameter absent from subs with no fallback (a
# numeric value parameter -- str/array's `to`) skips the tree entirely, so
# nothing dedups it. On a miss the leaf materializes via mintMono; multi-level
# paths mint intermediate nodes (genericOriginId = template, genericArgs =
# the key prefix) that cache partial paths without being emitted.
# checkConstraintSat -- a specialization argument against its parameter's
# declared constraint. Any (and numeric bounds, which never reach the tree)
# pass; value-kind constraints check typeIsValtype/typeIsReftype; StringLike
# checks membership. GENERIC_PARAM args skip -- partial specs re-check on
# completion. Location-free (the spec front door holds no source node).
# constraintKindFor -- classify a constraint's declared text into a tag once,
# at registration; the checks then compare the tag, not the string.
constraintKindFor: function {text: StringView} out ztypes.constraintkind is {
    if text == "anyval" then return ztypes.constraintkind.valType
    if text == "AnyRef" then return ztypes.constraintkind.refType
    if text == "valhashable" then return ztypes.constraintkind.valHashable
    if text == "RefHashable" then return ztypes.constraintkind.refHashable
    # the pre-rename casings, mapped for the same reason as Any.valtype below
    if text == "AnyVal" then return ztypes.constraintkind.valType
    if text == "ValHashable" then return ztypes.constraintkind.valHashable
    # the pre-rename spellings. They still MAP rather than being removed:
    # an unmapped constraint falls through to `other`, which checkConstraintSat
    # treats as satisfied, so deleting these would silently unconstrain any
    # declaration still using them instead of rejecting it.
    if text == "Any.valtype" then return ztypes.constraintkind.valType
    if text == "Any.reftype" then return ztypes.constraintkind.refType
    if text == "StringLike" then return ztypes.constraintkind.stringLike
    if text == "Any" then return ztypes.constraintkind.any
    if text.length == 0 then return ztypes.constraintkind.none
    nm9: constraintNumericMax cv: text
    match (
        nm9
    ) case some then {
        return ztypes.constraintkind.numeric
    } case none then null
    return ztypes.constraintkind.other
}

# constraintNumericName -- the integer-scalar name for a numeric bound, for
# diagnostics; the exact inverse of constraintNumericMax.
constraintNumericName: function {max: u64} out String is {
    if max == 255 then return "u8".string
    if max == 65535 then return "u16".string
    if max == 4294967295 then return "u32".string
    if max == 18446744073709551615.u64 then return "u64".string
    if max == 127 then return "i8".string
    if max == 32767 then return "i16".string
    if max == 2147483647 then return "i32".string
    if max == 9223372036854775807 then return "i64".string
    return "".string
}

# constraintTextOf -- reconstruct a constraint's declared text from its tag
# for diagnostics; reads fields only, constructs nothing.
constraintTextOf: function {desc: ztypes.constraintdesc} out String is {
    if desc.kind == ztypes.constraintkind.valType then return "anyval".string
    if desc.kind == ztypes.constraintkind.refType then return "AnyRef".string
    if desc.kind == ztypes.constraintkind.valHashable then return "valhashable".string
    if desc.kind == ztypes.constraintkind.refHashable then return "RefHashable".string
    if desc.kind == ztypes.constraintkind.stringLike then return "StringLike".string
    if desc.kind == ztypes.constraintkind.any then return "Any".string
    if desc.kind == ztypes.constraintkind.numeric then {
        nmx7: desc.numericMax
        match (
            nmx7
        ) case some then {
            return (constraintNumericName max: nmx7)
        } case none then null
    }
    return "".string
}

# constraintNumericMax -- the largest value an integer-scalar generic-param
# constraint admits; none when the constraint is not an integer scalar (a
# numeric argument on such a parameter stays on the name-keyed path).
constraintNumericMax: function {cv: StringView} out optionval u64 is {
    if cv == "u8" then return (optionval.some 255.u64)
    if cv == "u16" then return (optionval.some 65535.u64)
    if cv == "u32" then return (optionval.some 4294967295.u64)
    if cv == "u64" then return (optionval.some 18446744073709551615.u64)
    if cv == "i8" then return (optionval.some 127.u64)
    if cv == "i16" then return (optionval.some 32767.u64)
    if cv == "i32" then return (optionval.some 2147483647.u64)
    if cv == "i64" then return (optionval.some 9223372036854775807.u64)
    return (optionval.none u64)
}

# check that a generic argument satisfies its parameter's constraint.
checkConstraintSat: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    tdecl: ztypes.declid
    paramName: StringView
    argTid: ztypes.tid
} is {
    if (reg.typetypeOf typeId: argTid) == ztypes.ztypetype.genericParam then return
    cd9: reg.genericParamConstraintOf :tdecl :paramName
    ck9: cd9.kind
    if ck9 == ztypes.constraintkind.none then return
    # `null` is the payload-less marker and satisfies either FAMILY bound --
    # a null arm carries no payload, so the family question does not arise
    # ((Result null e: IoError) stays the io idiom). Hashability bounds
    # still reject it: a null key has nothing to hash.
    isNul9: argTid.u64 == ty.nullTypeId
    if isNul9 == false then {
        nn9: regTypeNameOf :reg tid: (ztypes.tid.create from: argTid.u64)
        if nn9.stringview == "null" then isNul9 = true
    }
    if isNul9 when ck9 == ztypes.constraintkind.refType then return
    if isNul9 when ck9 == ztypes.constraintkind.valType then return
    ok9: true
    if ck9 == ztypes.constraintkind.valType then ok9 = (typeIsValtype
        :ty
        :reg
        tid: (ztypes.tid.create from: argTid.u64)
    )
    if ck9 == ztypes.constraintkind.refType then {
        ok9 = reg.isReftypeOf tid: argTid
    }
    # Hashability: one question, asked in one place (see typeIsHashable).
    if ck9 == ztypes.constraintkind.valHashable then {
        ok9 = false
        if (typeIsValtype :ty :reg tid: (ztypes.tid.create from: argTid.u64)) then {
            ok9 = typeIsHashable :ast :ty :reg tid: (ztypes.tid.create from: argTid.u64)
            # a heap-owning value has no byte range to hash, and the synthesis
            # cannot ask that during resolution -- a self-containing record
            # would recurse forever before the cycle check has run
            if ok9 when (heapOwningValtypeTid
                :ast
                :ty
                :reg
                tid: (ztypes.tid.create from: argTid.u64)
            ) then ok9 = false
        }
    }
    if ck9 == ztypes.constraintkind.refHashable then {
        ok9 = false
        if (reg.isReftypeOf tid: argTid) then {
            ok9 = typeIsHashable :ast :ty :reg tid: (ztypes.tid.create from: argTid.u64)
        }
    }
    if ck9 == ztypes.constraintkind.stringLike then {
        okSL9: false
        svT9: builtinTidT :ast :ty :reg base: "StringView"
        if svT9 > 0 when argTid == svT9 then okSL9 = true
        if okSL9 == false then {
            # conformance rows live on the declaring type; a mono (str_32)
            # conforms through its generic origin (the str template)
            probeT9: argTid
            {
                agoo9: reg.genericOriginOf tid: argTid
                if agoo9 > 0 then probeT9 = agoo9
            }
            txT9: builtinTidT :ast :ty :reg base: "Text"
            if txT9 > 0 then {
                with cit9: ty.conformance.iterate do for crow9: cit9 loop {
                    if crow9.specTypeId == txT9 then {
                        if crow9.implTypeId == argTid then okSL9 = true
                        if crow9.implTypeId == probeT9 then okSL9 = true
                    }
                }
            }
        }
        ok9 = okSL9
    }
    if (ok9) == false then {
        an9: regTypeNameOf :reg tid: (ztypes.tid.create from: argTid.u64)
        con9: constraintTextOf desc: cd9
        tdn9: String
        {
            tdo9: ty.decls.get i: tdecl.u64
            tdn9 = regTypeNameOf :reg tid: (ztypes.tid.create from: tdo9.typeId)
            un9x: unitNameOfTid :ty :reg tid: (ztypes.tid.create from: tdo9.typeId)
            if un9x.length > 0 then tdn9 = "\{un9x}.\{tdn9}"
        }
        m9: "generic argument '\{an9}' does not satisfy constraint '\{con9}' on parameter '\{paramName}' of '\{tdn9}'"
        addResolveError :ty e: zast.err.genericError msg: m9
    }
}

# checkAnyBounds -- `Any` is not a user-spellable bound: a generic parameter
# names the family it takes (AnyRef/anyval, a hashable bound, StringLike or a
# numeric width). The spelling still maps to constraintkind.any at
# registration, where the declaring unit is not known, so the gate runs once
# after resolution: a kind-`any` parameter whose declaring unit does not
# itself define `Any` reports the standard unknown-type error. system.z
# defines `Any`, so its residual bounds pass; a user unit passes only by
# defining its own `Any`.
checkAnyBounds: function {ast: Ast.view st: zenv.ZSymbolTable} is {
    anyNid9: zast.poolFind pool: ast.names text: "Any"
    if anyNid9.isZero then return
    with git9: st.reg.genericParams.iterateItems do for ge9: git9 loop {
        hasAny9: false
        with pit9: ge9.value.params.iterate do for pd9: pit9 loop {
            if pd9.constraint.kind == ztypes.constraintkind.any then hasAny9 = true
        }
        if hasAny9 then {
            tdecl9: ge9.key
            unitDecl9: ztypes.declid
            declNode9: u32
            d9: tdecl9
            for d9 > 0 loop {
                do9: st.typing.decls.get i: d9.u64
                if declNode9 == 0 then declNode9 = do9.node
                match (
                    do9.kind
                ) case unitDecl then {
                    unitDecl9 = d9
                    d9 = ztypes.declid
                } else {
                    d9 = do9.parent
                }
            }
            defined9: false
            if (unitDecl9.isZero) == false then {
                # declFindChild reads the pre-resolution def index, so a
                # defined-but-never-demanded `Any` still counts.
                if (st.typing.declFindChild parentDeclId: unitDecl9 nameId: anyNid9) > 0 then {
                    defined9 = true
                }
            } else {
                defined9 = true
            }
            if (defined9) == false then {
                if declNode9 > 0 then {
                    tn9: ast.nodes.get i: declNode9.u64
                    m9: "Unknown type 'Any'".string
                    (addResolveErrorH
                        ty: st.typing
                        nodeid: (nodeId n: tn9)
                        lineno: (nodeLine n: tn9)
                        colno: (nodeCol n: tn9)
                        e: zast.err.badReference
                        msg: m9
                        width: 3
                    )
                }
            }
        }
    }
}

# typeIsHashable -- the type has both `hash` and `==`, so it may key a Map or
# a Set. Read straight off the DECLARATIONS: `hash` and `==` are synthesised
# for a valtype and declared for a reftype, and a member the author struck off
# with a null shell is simply absent -- so the opt-out needs no flag to record
# it, and there is exactly one place that asks.
#
# The answer is DERIVED rather than written back as a conformance row.
# Materialising one makes the emitter treat it as a user-written `:valhashable`
# and emit a facet vtable plus a wrapper per conforming type -- for members
# that have no body, and which nothing ever dispatches through: the containers
# call `hash`/`==` directly. The row would be pure bloat on every record in
# every program.
typeIsHashable: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    tid: ztypes.tid
} out bool is {
    ast
    reg
    if tid.isZero then return false
    # a typedef synthesises no hash/== of its own: the question chases to
    # the chain-end base (a typedef over a hashable type is hashable)
    htd9: tid
    for true loop {
        bo9: ty.typedefBaseTid.get key: htd9
        match (
            bo9
        ) case some then {
            htd9 = ztypes.tid.create from: (bo9)
        } case none then break
    }
    if (ty.declIsMethodId
        parentTypeId: htd9
        nameId: (zast.nameid.create from: zast.wkHash)
    ) == false then return false
    return (ty.declIsMethodId parentTypeId: htd9 nameId: (zast.nameid.create from: zast.wkOpEq))
}

# heapOwningValtypeTid -- a RECORD/VARIANT that transitively owns heap
# members (a class/union box, a destructor-carrying mono, or another owning
# valtype): its byte-range hash and equality cannot cover them.
heapOwningValtypeTid: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    tid: ztypes.tid
} out bool is {
    tt9: reg.typetypeOf typeId: tid
    isVR9: false
    if tt9 == ztypes.ztypetype.recordType then isVR9 = true
    if tt9 == ztypes.ztypetype.variantType then isVR9 = true
    if isVR9 == false then return false
    hNms9: (ListVal u64)
    hTds9: (ListVal u64)
    ty.declMemberList ownerTid: tid names: hNms9 tids: hTds9
    hcn9: hNms9.length
    hci9: u64
    for hci9 < hcn9 loop {
        hnid9: hNms9.get i: hci9
        hcto9: hTds9.get i: hci9
        hci9 = hci9 + 1
        hctt9: reg.typetypeOf typeId: (ztypes.tid.create from: hcto9.u64)
        hnB9: ast.names.texts.get i: hnid9.u64
        if hctt9 != ztypes.ztypetype.functionType when hnB9.stringview != "tag" then {
            if hctt9 == ztypes.ztypetype.classType then return true
            if hctt9 == ztypes.ztypetype.unionType then return true
            if (reg.hasDestructorName typeId: (ztypes.tid.create from: hcto9.u64)) then return true
            if hctt9 == ztypes.ztypetype.recordType then {
                if (heapOwningValtypeTid
                    :ast
                    :ty
                    :reg
                    tid: (ztypes.tid.create from: hcto9.u64)
                ) then return true
            }
            if hctt9 == ztypes.ztypetype.variantType then {
                if (heapOwningValtypeTid
                    :ast
                    :ty
                    :reg
                    tid: (ztypes.tid.create from: hcto9.u64)
                ) then return true
            }
        }
    }
    return false
}

# get, or mint on first use, the specialisation for a generic instantiation.
getOrMintSpec: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    name: StringView
    templateId: ztypes.tid
    subs: (MapRV String value: u64)
    valSubs: (MapRV String value: u64)
    fallbackArg: u64
} out ztypes.tid is {
    tk8: declOfTypeId :reg tid: templateId
    pnames8: reg.genericParamNamesOf tdecl: tk8
    # An elided leading type argument stages under the empty name; rebind it
    # to the primary generic parameter before the trie keys and idSubs build
    # (mintMono's own rebind happens after both).
    {
        emptyKey8: String
        ev8: subs.get key: emptyKey8
        match (
            ev8
        ) case some then {
            prnm8: firstGenericParamName :reg :templateId
            if prnm8.length > 0 then subs.set key: prnm8 value: ev8
        } case none then null
        evv8: valSubs.get key: emptyKey8
        match (
            evv8
        ) case some then {
            prnmv8: firstGenericParamName :reg :templateId
            if prnmv8.length > 0 then valSubs.set key: prnmv8 value: evv8
        } case none then null
    }
    keys8: (ListVal u64)
    keyIsVal8: (ListVal bool)
    trieOk8: true
    if pnames8.length == 0 then {
        # The template's arity is unreadable here -- its parameters are keyed by
        # the DEFINITION's Decl, and a canonical mint made before the unit roots
        # existed links `def` at a proxy instead. The loop below is skipped in
        # that case, so NOTHING in subs/valSubs reaches the key and the fallback
        # can only stand in for a template taking ONE argument. Where the caller
        # supplies more, keying on the fallback alone would hand two different
        # instantiations the SAME spec -- a silent conflation. Refuse the trie
        # instead: that at worst duplicates, which `checkTagStem` reports.
        argc8: subs.length + valSubs.length
        if fallbackArg > 0 when argc8 <= 1 then {
            fb0: fallbackArg
            keys8.append fb0
            keyIsVal8.append false
        } else {
            trieOk8 = false
        }
    }
    with pit8: pnames8.iterate do for pn8: pit8 loop {
        pgot8: subs.get key: pn8.copy
        match (
            pgot8
        ) case some then {
            (checkConstraintSat
                :ast
                :ty
                :reg
                tdecl: tk8
                paramName: pn8.stringview
                argTid: (ztypes.tid.create from: pgot8.u64)
            )
            keys8.append pgot8
            keyIsVal8.append false
        } case none then {
            vgot8: valSubs.get key: pn8.copy
            match (
                vgot8
            ) case some then {
                # a numeric literal keys its trie level by VALUE; per-level
                # kind is fixed by the parameter, so values and type ids
                # cannot collide
                cd8: reg.genericParamConstraintOf tdecl: tk8 paramName: pn8.stringview
                nmx8: cd8.numericMax
                match (
                    nmx8
                ) case some then {
                    if vgot8 > nmx8 then {
                        cvn8: constraintTextOf desc: cd8
                        tkNum8: tk8 + 0
                        m8v: "numeric argument \{vgot8} exceeds constraint '\{cvn8}' on parameter '\{pn8}' of '\{tkNum8}'"
                        addResolveError :ty e: zast.err.genericError msg: m8v
                    }
                    keys8.append vgot8
                    keyIsVal8.append true
                } case none then {
                    trieOk8 = false
                }
            } case none then {
                if fallbackArg > 0 when pnames8.length == 1 then {
                    fb8: fallbackArg
                    keys8.append fb8
                    keyIsVal8.append false
                } else {
                    trieOk8 = false
                }
            }
        }
    }
    if trieOk8 then {
        cur8: templateId
        ki8: u64
        kn8: keys8.length
        hit8: true
        for ki8 < kn8 loop {
            k8: keys8.get i: ki8
            n8: reg.getGenericChild parentId: cur8 key: k8
            match (
                n8
            ) case some then {
                cur8 = n8
            } case none then {
                hit8 = false
                ki8 = kn8
            }
            ki8 = ki8 + 1
        }
        if hit8 then {
            reg.specWasFresh = false
            return (ztypes.tid.create from: cur8)
        }
    }
    idSubs8: (MapVV u64 value: u64)
    if trieOk8 then {
        pi8: u64
        pt8: pnames8.length
        for pi8 < pt8 loop {
            pnm8: pnames8.get i: pi8
            pto8: reg.genericParamTidOf tdecl: tk8 paramName: pnm8.stringview
            match (
                pto8
            ) case some then {
                if (keyIsVal8.get i: pi8) == false then {
                    kv8: keys8.get i: pi8
                    pk8: pto8
                    idSubs8.set key: pk8 value: kv8
                }
            } case none then null
            pi8 = pi8 + 1
        }
    }
    hasParamKey8: false
    if trieOk8 then {
        hk8: u64
        hn8: keys8.length
        for hk8 < hn8 loop {
            if (keyIsVal8.get i: hk8) == false then {
                hv8: keys8.get i: hk8
                if (reg.typetypeOf typeId: (ztypes.tid.create from: hv8.u64)) == ztypes.ztypetype.genericParam then {
                    hasParamKey8 = true
                }
            }
            hk8 = hk8 + 1
        }
    }
    mid8: ztypes.tid
    if hasParamKey8 then {
        # a generic-param arg makes the spec PARTIAL: a trie-only entry that
        # is never emitted or name-registered; the clone-side respecialize
        # completes it with concrete args per instance.
        pnmP8: "\{name}__partial"
        mid8 = reg.newType name: pnmP8.stringview typetype: ztypes.ztypetype.genericParam
        reg.setGenericOrigin typeId: mid8 value: templateId
    } else {
        mid8 = reg.newType :name typetype: (templateTypetypeOf :reg :templateId)
    }
    if trieOk8 when mid8 > 0 then {
        cur9: templateId
        ki9: u64
        kn9: keys8.length
        for ki9 < kn9 loop {
            k9: keys8.get i: ki9
            last9: false
            if ki9 + 1 == kn9 then last9 = true
            n9: reg.getGenericChild parentId: cur9 key: k9
            step9: u64
            match (
                n9
            ) case some then {
                step9 = n9
            } case none then {
                if last9 then {
                    step9 = mid8
                } else {
                    inm9: "\{name}__node"
                    step9 = (reg.newType
                        name: inm9.stringview
                        typetype: ztypes.ztypetype.genericParam
                    )
                    kj9: u64
                    for kj9 <= ki9 loop {
                        pk9: keys8.get i: kj9
                        if (keyIsVal8.get i: kj9) then {
                            (reg.appendGenericArgValue
                                specId: (ztypes.tid.create from: step9.u64)
                                value: pk9
                            )
                        } else {
                            (reg.appendGenericArg
                                specId: (ztypes.tid.create from: step9.u64)
                                arg: pk9
                            )
                        }
                        kj9 = kj9 + 1
                    }
                }
                reg.setGenericChild parentId: cur9 key: k9 child: step9
            }
            cur9 = ztypes.tid.create from: (step9)
            ki9 = ki9 + 1
        }
        ka9: u64
        for ka9 < kn9 loop {
            av9: keys8.get i: ka9
            if (keyIsVal8.get i: ka9) then {
                reg.appendGenericArgValue specId: mid8 value: av9
            } else {
                reg.appendGenericArg specId: mid8 arg: av9
            }
            ka9 = ka9 + 1
        }
    }
    # The children are built LAST, and the trie path above is why. Building
    # them respecializes, which re-enters this function for this very
    # instantiation; before the edge existed that re-entry found nothing and
    # minted a SECOND spec under the same name, which the emitter then emitted
    # beside the first.
    if (hasParamKey8) == false then {
        (mintMono
            :ast
            :ty
            :reg
            :unitDecl
            :name
            :templateId
            :subs
            idSubs: idSubs8
            :fallbackArg
            monoTid: mid8
        )
        # a Box spec minted from TYPE POSITION (a union's type argument)
        # registers the identity the construction path stamps: isBox drives
        # typeRefC's bare-pointer rendering and the destructor plumbing. The
        # member copy stays with construction -- nothing reads members off
        # an un-constructed Box.
        isBxM8: false
        bxmn8: regTypeNameOf :reg tid: templateId
        if bxmn8.stringview == "Box" then {
            if (reg.typetypeOf typeId: templateId) == ztypes.ztypetype.classType then {
                if (ty.declMemberCount ownerTid: templateId) == 0 then isBxM8 = true
            }
        }
        if isBxM8 then {
            reg.setIsBox typeId: mid8
            reg.setIsHeapAllocated typeId: mid8
        }
    }
    okC3: trieOk8
    if hasParamKey8 then okC3 = false
    if mid8.isZero then okC3 = false
    if okC3 then {
        # a trie-keyed concrete specialization mints its chain family and
        # collection children here with def-order args; name-keyed mints
        # (sized records, empty-subs chains) keep their caller-side
        # invocations, which carry the elem/val ids this path cannot derive
        tnC3: regTypeNameOf :reg tid: templateId
        tnl3: tnC3.length
        nmC3: name
        nml3: nmC3.length
        sfxC3: String
        if nml3 > tnl3 then {
            sfv3: (nmC3.substring from: tnl3 to: nml3)
            sfxC3 = sfv3.string
        }
        # elem = the first TYPE key (a sized record's leading value key is
        # not an element); val = the second key only when it is a type
        elemC3: u64
        ei3: u64
        en3: keys8.length
        for ei3 < en3 loop {
            if elemC3 == 0 then {
                if (keyIsVal8.get i: ei3) == false then elemC3 = keys8.get i: ei3
            }
            ei3 = ei3 + 1
        }
        valC3: ztypes.tid
        if keys8.length > 1 then {
            if (keyIsVal8.get i: 1) == false then valC3 = ztypes.tid.create from: (keys8.get i: 1)
        }
        # MapItemIter's iterator element is the derived MapEntry spec (its
        # call's OptionView some-arm), not a trie key
        skipC3: false
        itemIterC3: false
        if templateId == (builtinTidT :ast :ty :reg base: "MapItemIter") then itemIterC3 = true
        if templateId == (builtinTidT :ast :ty :reg base: "MapItemIterRV") then itemIterC3 = true
        if templateId == (builtinTidT :ast :ty :reg base: "MapItemIterVR") then itemIterC3 = true
        if templateId == (builtinTidT :ast :ty :reg base: "MapItemIterVV") then itemIterC3 = true
        if itemIterC3 then {
            skipC3 = true
            (forceMemberOf :ty :reg :ast parentTypeId: mid8 nameId: zast.wkCall)
            micoC4: ty.declChildOfId parentTypeId: mid8 nameId: zast.wkCall
            match (
                micoC4
            ) case some then {
                mrtoC4: reg.returnTypeOf tid: (ztypes.tid.create from: micoC4.u64)
                if mrtoC4 > 0 then {
                    (forceMemberOf :ty :reg :ast parentTypeId: mrtoC4 nameId: zast.wkSome)
                    mieoC4: ty.declChildOfId parentTypeId: mrtoC4 nameId: zast.wkSome
                    match (
                        mieoC4
                    ) case some then {
                        elemC3 = mieoC4
                        skipC3 = false
                    } case none then null
                }
            } case none then null
        }
        if skipC3 == false then {
            (mintCollectionChildren
                :ast
                :ty
                :reg
                monoId: (ztypes.tid.create from: mid8.u64)
                :templateId
                elemArg: elemC3
                valArg: (ztypes.tid.create from: valC3.u64)
            )
        }
    }
    reg.specWasFresh = true
    return (ztypes.tid.create from: mid8)
}
# mintCollectionChildren -- the per-instance collection children the
# produced templates cannot express: length/capacity u64 value children,
# the create child (except List and Map, which have their own create
# paths), the Map get/remove value-kind wrapper returns, MapEntry's
# key/value accessors, and the sized str/array member tables. Method
# signatures and composite returns come from the cloned template methods
# (healed by respecialize). No-op for other templates or when the
# instance already has children (re-mint dedup).
# monoValName -- the value-type name component of a get-wrapper mono name. A type
# SHADOWING a builtin -- its name resolves through the prelude to a DIFFERENT
# canonical id -- appends its own id, so its wrapper mono is distinct from the
# builtin's same-named wrapper (a user i64 -> "i64_7" vs system "i64"); otherwise
# the bare name. Without this the get-wrapper mono name (optionval_i64) collides
# under the shared system key and the shadow reuses the system instance (wrong
# `some`-arm type). Asked of the ids, from any unit: whoever defines it.
monoValName: function {
    ast: Ast.view
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    tid: ztypes.tid
} out String is {
    tn: regTypeNameOf :reg :tid
    bt9: builtinTidT :ast :ty :reg base: tn.stringview
    if bt9 > 0 when (bt9 == tid) == false then return ("\{tn}_\{tid}")
    return tn
}

# mint the per-instantiation member edges of a collection type.
mintCollectionChildren: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    monoId: ztypes.tid
    templateId: ztypes.tid
    elemArg: u64
    valArg: ztypes.tid
} is {
    # a specialisation's members resolve in the TEMPLATE's frame, with the
    # argument substitution -- lexical scoping; the instantiating unit is
    # not where the template's names live
    prevFrame9: ty.curFrame
    {
        td9: declOfTypeId :reg tid: templateId
        if (td9.isZero) == false then ty.curFrame = td9
    }
    mintCollectionChildrenIn :ast :ty :reg :monoId :templateId :elemArg :valArg
    ty.curFrame = prevFrame9
}

mintCollectionChildrenIn: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    monoId: ztypes.tid
    templateId: ztypes.tid
    elemArg: u64
    valArg: ztypes.tid
} is {
    listTid: builtinTidT :ast :ty :reg base: "ListRef"
    listValTid: builtinTidT :ast :ty :reg base: "ListVal"
    listViewTid: builtinTidT :ast :ty :reg base: "ListView"
    listViewValTid: builtinTidT :ast :ty :reg base: "ListViewVal"
    setTid: builtinTidT :ast :ty :reg base: "SetRef"
    setValTid: builtinTidT :ast :ty :reg base: "SetVal"
    mapTid: builtinTidT :ast :ty :reg base: "MapRR"
    mapRVTid: builtinTidT :ast :ty :reg base: "MapRV"
    mapVRTid: builtinTidT :ast :ty :reg base: "MapVR"
    mapVVTid: builtinTidT :ast :ty :reg base: "MapVV"
    mapEntryTid: builtinTidT :ast :ty :reg base: "MapEntry"
    strTid: builtinTidT :ast :ty :reg base: "str"
    arrayTid: builtinTidT :ast :ty :reg base: "array"
    listIterTid: builtinTidT :ast :ty :reg base: "ListIter"
    listIterValTid: builtinTidT :ast :ty :reg base: "ListIterVal"
    setIterTid: builtinTidT :ast :ty :reg base: "SetIter"
    setIterValTid: builtinTidT :ast :ty :reg base: "SetIterVal"
    mapKeyIterTid: builtinTidT :ast :ty :reg base: "MapKeyIter"
    mapItemIterTid: builtinTidT :ast :ty :reg base: "MapItemIter"
    mapKeyIterRVTid: builtinTidT :ast :ty :reg base: "MapKeyIterRV"
    mapKeyIterVRTid: builtinTidT :ast :ty :reg base: "MapKeyIterVR"
    mapKeyIterVVTid: builtinTidT :ast :ty :reg base: "MapKeyIterVV"
    mapItemIterRVTid: builtinTidT :ast :ty :reg base: "MapItemIterRV"
    mapItemIterVRTid: builtinTidT :ast :ty :reg base: "MapItemIterVR"
    mapItemIterVVTid: builtinTidT :ast :ty :reg base: "MapItemIterVV"
    mapEntryRVTid: builtinTidT :ast :ty :reg base: "MapEntryRV"
    mapEntryVRTid: builtinTidT :ast :ty :reg base: "MapEntryVR"
    mapEntryVVTid: builtinTidT :ast :ty :reg base: "MapEntryVV"
    isIter: false
    if templateId == listIterTid then isIter = true
    if templateId == listIterValTid then isIter = true
    if templateId == setIterTid then isIter = true
    if templateId == setIterValTid then isIter = true
    if templateId == mapKeyIterTid then isIter = true
    if templateId == mapItemIterTid then isIter = true
    if templateId == mapKeyIterRVTid then isIter = true
    if templateId == mapKeyIterVRTid then isIter = true
    if templateId == mapKeyIterVVTid then isIter = true
    if templateId == mapItemIterRVTid then isIter = true
    if templateId == mapItemIterVRTid then isIter = true
    if templateId == mapItemIterVVTid then isIter = true
    isColl: isIter
    if templateId == listTid then isColl = true
    if templateId == listValTid then isColl = true
    if templateId == listViewTid then isColl = true
    if templateId == listViewValTid then isColl = true
    if templateId == setTid then isColl = true
    if templateId == setValTid then isColl = true
    if templateId == mapTid then isColl = true
    if templateId == mapRVTid then isColl = true
    if templateId == mapVRTid then isColl = true
    if templateId == mapVVTid then isColl = true
    if templateId == mapEntryTid then isColl = true
    if templateId == mapEntryRVTid then isColl = true
    if templateId == mapEntryVRTid then isColl = true
    if templateId == mapEntryVVTid then isColl = true
    if templateId == strTid then isColl = true
    if templateId == arrayTid then isColl = true
    if (isColl) == false then return
    # List children come from the produced template methods cloned per
    # instance (composite returns healed by respecialize); only the
    # length/capacity u64 children materialize here. Runs on every naming.
    isListTpl9: false
    if templateId == listTid then isListTpl9 = true
    if templateId == listValTid then isListTpl9 = true
    if isListTpl9 then {
        # system's u64, whichever unit instantiates the collection: a user
        # unit may shadow the name
        u64L: (builtinTidT :ast :ty :reg base: "u64").u64
        if u64L > 0 then {
            ty.setMemberType parentTypeId: monoId nameId: zast.wkLength childTypeId: u64L
            ty.setMemberType parentTypeId: monoId nameId: zast.wkCapacity childTypeId: u64L
        }
        return
    }
    # One build per instance: a spec can reach this arm from several mint
    # paths, and the str/array rebuild below would mint fresh member types
    # per invocation (their instances copy template children at mint time,
    # so a member count cannot signal "already built").
    bgot: ty.collectionChildrenBuilt.get key: monoId
    if (optBoolOr o: bgot d: false) then return
    bk0: monoId
    ty.collectionChildrenBuilt.set key: bk0 value: true
    u64id: (declareCanonicalType
        :ast
        :ty
        :reg
        unitDecl: ty.systemUnitRoot
        ownerNameId: zast.nameid
        name: "u64"
        typetype: ztypes.ztypetype.recordType
    )
    # ListView children come from the produced template method (get); the
    # length field (the canonical u64) and the create child materialize here,
    # once per mono (post-memo: this arm mints).
    isLViewTpl9: false
    if templateId == listViewTid then isLViewTpl9 = true
    if templateId == listViewValTid then isLViewTpl9 = true
    if isLViewTpl9 then {
        ty.setMemberType parentTypeId: monoId nameId: zast.wkLength childTypeId: u64id
        mintCollectionMethod :ast :ty :reg :monoId m: "create"
        return
    }
    # Set children come from the produced template methods (returns healed
    # by respecialize); the length/capacity fields (the canonical u64) and
    # the create child materialize here, once per mono.
    isSetTpl9: false
    if templateId == setTid then isSetTpl9 = true
    if templateId == setValTid then isSetTpl9 = true
    if isSetTpl9 then {
        ty.setMemberType parentTypeId: monoId nameId: zast.wkLength childTypeId: u64id
        ty.setMemberType parentTypeId: monoId nameId: zast.wkCapacity childTypeId: u64id
        mintCollectionMethod :ast :ty :reg :monoId m: "create"
        return
    }
    # Iterator families: call is produced+cloned (its OptionView return
    # healed by respecialize); only the create child mints here, once per
    # mono.
    if isIter then {
        mintCollectionMethod :ast :ty :reg :monoId m: "create"
        return
    }
    # Every Map form declares its real returns -- an `optionval` for a valtype
    # value, an `OptionView`/`Option` for a reference one -- so the clone pass
    # heals get/remove like any other composite return and only the
    # length/capacity fields materialize here.
    isMapTpl9: false
    if templateId == mapTid then isMapTpl9 = true
    if templateId == mapRVTid then isMapTpl9 = true
    if templateId == mapVRTid then isMapTpl9 = true
    if templateId == mapVVTid then isMapTpl9 = true
    if isMapTpl9 when valArg > 0 then {
        ty.setMemberType parentTypeId: monoId nameId: zast.wkLength childTypeId: u64id
        ty.setMemberType parentTypeId: monoId nameId: zast.wkCapacity childTypeId: u64id
        return
    }
    isSized: false
    if templateId == strTid then isSized = true
    if templateId == arrayTid then isSized = true
    # str/array are PERMANENT materializer arms: sized RECORDs are keyed by
    # a numeric value parameter that rides the trie as a literal VALUE key
    # (genericArgIsValue marks the ordinal); it never enters idSubs, so
    # produce+clone has nothing to substitute. Their templates resolve from source (record
    # attachMethods runs regardless of genericity) and copy their children
    # at mint time; the branches below REPLACE the value-dependent members
    # in place (setMemberType keeps positions) -- fresh const-clone size fields,
    # element-typed get/set returns, String-returning string, and the ==/!=
    # that resolveRecord and mintMono both skip for sized records. The
    # emitter builds the structs from the z_str/z_array tmpls by name-parsed
    # size and reads only the == child's presence. The dedup guard below
    # applies only to the from-scratch families.
    if (isSized) == false then {
        if (ty.declMemberCount ownerTid: monoId) > 0 then return
    }
    boolid: u64
    boolT9: builtinTidT :ast :ty :reg base: "bool"
    bo9: (optionval.none u64)
    if (boolT9.isZero) == false then bo9 = (optionval.some boolT9.u64)
    match (
        bo9
    ) case some then {
        boolid = bo9
    } case none then null
    isEntryTpl9: false
    if templateId == mapEntryTid then isEntryTpl9 = true
    if templateId == mapEntryRVTid then isEntryTpl9 = true
    if templateId == mapEntryVRTid then isEntryTpl9 = true
    if templateId == mapEntryVVTid then isEntryTpl9 = true
    if isEntryTpl9 then {
        kyId: mintCollectionMethod :ast :ty :reg :monoId m: "key"
        reg.setReturnType typeId: (ztypes.tid.create from: kyId.u64) value: elemArg
        vlId: mintCollectionMethod :ast :ty :reg :monoId m: "value"
        if valArg > 0 then (reg.setReturnType
            typeId: (ztypes.tid.create from: vlId.u64)
            value: valArg
        )
        mintCollectionMethod :ast :ty :reg :monoId m: "create"
    }
    if templateId == arrayTid then {
        agId: mintCollectionMethod :ast :ty :reg :monoId m: "get"
        reg.setReturnType typeId: (ztypes.tid.create from: agId.u64) value: elemArg
        asId: mintCollectionMethod :ast :ty :reg :monoId m: "set"
        reg.setReturnType typeId: (ztypes.tid.create from: asId.u64) value: elemArg
        ty.setMemberType parentTypeId: monoId nameId: zast.wkLength childTypeId: u64id
        mintCollectionMethod :ast :ty :reg :monoId m: "create"
        aeqId: mintCollectionMethod :ast :ty :reg :monoId m: "=="
        reg.setReturnType typeId: (ztypes.tid.create from: aeqId.u64) value: boolid
        aneId: mintCollectionMethod :ast :ty :reg :monoId m: "!="
        reg.setReturnType typeId: (ztypes.tid.create from: aneId.u64) value: boolid
    }
    if templateId == strTid then {
        ty.setMemberType parentTypeId: monoId nameId: zast.wkLength childTypeId: u64id
        ty.setMemberType parentTypeId: monoId nameId: zast.wkSize childTypeId: u64id
        tstId: mintCollectionMethod :ast :ty :reg :monoId m: "string"
        sgid: (builtinTidT :ast :ty :reg base: "String").u64
        if sgid > 0 then reg.setReturnType typeId: (ztypes.tid.create from: tstId.u64) value: sgid
        mintCollectionMethod :ast :ty :reg :monoId m: "create"
        teqId: mintCollectionMethod :ast :ty :reg :monoId m: "=="
        reg.setReturnType typeId: (ztypes.tid.create from: teqId.u64) value: boolid
        tneId: mintCollectionMethod :ast :ty :reg :monoId m: "!="
        reg.setReturnType typeId: (ztypes.tid.create from: tneId.u64) value: boolid
    }
}

# firstGenericParamName -- the primary (first-declared) generic parameter
# name of a template, or empty when it has none. Binds an elided leading type
# argument (`(List String)` == `(List of: String)`) to its parameter.
firstGenericParamName: function {
    reg: ztypes.ZTypeRegistry
    templateId: ztypes.tid
} out String is {
    tk: declOfTypeId :reg tid: templateId
    names: reg.genericParamNamesOf tdecl: tk
    if names.length > 0 then {
        firstNm: names.get i: 0
        return firstNm.copy
    }
    return "".string
}

# inferGenericConstruction -- a generic class/record template called with
# field-bound value arguments: labels naming generic params resolve as
# explicit type args; other args walk as values and bind their field's
# param (literals materialise + restamp the bare node). The deduped
# instance mints with substituted fields plus a synthesized create.
# 0 when nothing infers.
inferGenericConstruction: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    call: zast.CallData.view
    tplId: ztypes.tid
    reportMissing: bool
} out ztypes.tid is {
    tname: typeNameOf :st tid: tplId
    if tname.length == 0 then return (ztypes.tid.create from: 0)
    tk: declOfTypeId reg: st.reg tid: tplId
    # Stage the template's children, then keep the ones whose TYPE NAME is a
    # registered generic param (field shells carry the param name, not a
    # GENERIC_PARAM typetype).
    cNames3: (List String)
    cIds3: (ListVal u64)
    {
        igNms9: (ListVal u64)
        igTds9: (ListVal u64)
        st.typing.declMemberList ownerTid: tplId names: igNms9 tids: igTds9
        igi9: u64
        ign9: igNms9.length
        for igi9 < ign9 loop {
            fnB9: ast.names.texts.get i: ((igNms9.get i: igi9)).u64
            fn1: fnB9.copy
            cNames3.append fn1
            cid1: igTds9.get i: igi9
            cIds3.append cid1
            igi9 = igi9 + 1
        }
    }
    fNames: (List String)
    fParams: (List String)
    ci3: u64
    cn3: cIds3.length
    for ci3 < cn3 loop {
        cid3: cIds3.get i: ci3
        pnm3: typeNameOf :st tid: (ztypes.tid.create from: cid3.u64)
        if (st.reg.isGenericParamOf tdecl: tk name: pnm3.stringview) then {
            nm3: cNames3.get i: ci3
            nv3: nm3.stringview
            n3: nv3.string
            fNames.append n3
            fParams.append pnm3
        }
        ci3 = ci3 + 1
    }
    sfx: String
    subs: (MapRV String value: u64)
    boundParams: (Set String)
    firstA: u64
    primaryName: firstGenericParamName reg: st.reg templateId: (ztypes.tid.create from: tplId.u64)
    # the value-arg walk below is a DRY RUN for type inference: bracket its
    # ownership effects (take overlays, borrow locks) in a frame that is
    # discarded whole, so the real ctor walk re-checks from a clean slate --
    # an explicit `.take` arg otherwise collides with its own inference pass.
    st.pushDryRun
    argIdx: u64
    with aiter: call.arguments.iterate do for argId9: aiter loop {
        arg: ast.nodes.get i: argId9.u64
        match (
            arg
        ) case namedoperation then {
            pk: zast.nameTextCopy :ast ref: arg.name
            # elided leading type arg: an unnamed first arg naming a type
            # binds the primary generic param (`(List String)`); a value
            # first arg (`(box 5)`) is left for value inference.
            if pk.length == 0 when argIdx == 0 then {
                anE: paramTypeBaseName :ast op: (ast.nodes.get i: arg.operation.u64)
                if (isNumericLiteralName name: anE.stringview) == false then {
                    teo: (walkLookupTyperef
                        :ast
                        ty: st.typing
                        reg: st.reg
                        :unitDecl
                        base: anE.stringview
                    )
                    match (
                        teo
                    ) case some then {
                        if primaryName.length > 0 then pk = primaryName.copy
                    } case none then null
                }
            }
            isP: false
            if pk.length > 0 then {
                isP = st.reg.isGenericParamOf tdecl: tk name: pk.stringview
            }
            if isP then {
                an: paramTypeBaseName :ast op: (ast.nodes.get i: arg.operation.u64)
                if (isNumericLiteralName name: an.stringview) then {
                    sfx.append s: "_"
                    sfx.append s: an
                    boundParams.add item: pk.copy
                } else {
                    ao: (walkLookupTyperef
                        :ast
                        ty: st.typing
                        reg: st.reg
                        :unitDecl
                        base: an.stringview
                    )
                    match (
                        ao
                    ) case some then {
                        atn: (monoValName
                            :ast
                            ty: st.typing
                            reg: st.reg
                            tid: (ztypes.tid.create from: ao.u64)
                        )
                        sfx.append s: "_"
                        sfx.append s: atn
                        pk2: pk.copy
                        pv2: ao
                        subs.set key: pk2 value: pv2
                        boundParams.add item: pk.copy
                        if firstA == 0 then firstA = ao
                    } case none then null
                }
            } else {
                vt0: (checkValue
                    :st
                    :unitDecl
                    :ast
                    node: (ast.nodes.get i: arg.operation.u64)
                )
                gidx: u64
                gfound: false
                fi: u64
                fn2: fNames.length
                for fi < fn2 loop {
                    f0: fNames.get i: fi
                    if f0.stringview == pk.stringview then {
                        if (gfound) == false then {
                            gidx = fi
                            gfound = true
                        }
                    }
                    fi = fi + 1
                }
                if gfound when vt0 > 0 then {
                    mv0: materialiseLiteral :ast :st :unitDecl t: vt0
                    if mv0 != vt0 then {
                        iid0: innermostNodeId :ast n: (ast.nodes.get i: arg.operation.u64)
                        if iid0 > 0 then {
                            setm0: mv0
                            stampGate :st nid: iid0.u64 tid: setm0
                        }
                    }
                    gp0: fParams.get i: gidx
                    already: optU64Or o: (subs.get key: gp0) d: 0
                    if already <= 0 then {
                        vtn: monoValName :ast ty: st.typing reg: st.reg tid: mv0
                        sfx.append s: "_"
                        sfx.append s: vtn
                        gpv0: gp0.stringview
                        gpc: gpv0.string
                        gpv: mv0
                        subs.set key: gpc value: gpv
                        boundParams.add item: gp0.copy
                        if firstA == 0 then firstA = mv0
                    }
                }
            }
        } else null
        argIdx = argIdx + 1
    }
    st.popDiscard
    paramsM: st.reg.genericParamNamesOf tdecl: tk
    firstMissing: String
    pmi: u64
    pmn: paramsM.length
    for pmi < pmn loop {
        pmName: paramsM.get i: pmi
        if (boundParams.has item: pmName.copy) == false then {
            if firstMissing.length == 0 then firstMissing = pmName.copy
        }
        pmi = pmi + 1
    }
    if firstMissing.length > 0 then {
        if reportMissing then {
            emn: String
            ehn: String
            if sfx.length == 0 then {
                mmsg: "cannot infer type arguments for generic type '\{tname}'"
                (addErrorH
                    :st
                    nodeid: call.nodeid
                    lineno: call.lineno
                    colno: call.colno
                    e: zast.err.genericError
                    msg: mmsg
                    note: emn
                    hint: ehn
                    width: 0
                )
            } else {
                mmsg2: "cannot infer generic parameter '\{firstMissing}' for '\{tname}'"
                (addErrorH
                    :st
                    nodeid: call.nodeid
                    lineno: call.lineno
                    colno: call.colno
                    e: zast.err.genericError
                    msg: mmsg2
                    note: emn
                    hint: ehn
                    width: 0
                )
            }
        }
        return (ztypes.tid.create from: 0)
    }
    if sfx.length == 0 then return (ztypes.tid.create from: 0)
    mname: "\{tname}\{sfx}"
    vsD9: (MapRV String value: u64)
    mid: (getOrMintSpec
        :ast
        ty: st.typing
        reg: st.reg
        :unitDecl
        name: mname.stringview
        templateId: (ztypes.tid.create from: tplId.u64)
        :subs
        valSubs: vsD9
        fallbackArg: 0
    )
    if mid.isZero then return (ztypes.tid.create from: 0)
    (forceMemberOf ty: st.typing reg: st.reg :ast parentTypeId: mid nameId: zast.wkCreate)
    cro: st.typing.declChildOfId parentTypeId: mid nameId: zast.wkCreate
    match (
        cro
    ) case some then null case none then {
        crId: st.reg.newType name: "create" ownerTid: mid typetype: ztypes.ztypetype.functionType
        (st.typing.declSynthMember
            parentTypeId: mid
            nameId: zast.wkCreate
            kind: ztyping.declkind.methodDecl
        )
        st.typing.setMemberType parentTypeId: mid nameId: zast.wkCreate childTypeId: crId
    }
    return mid
}

# genericTypeConstruction -- a generic TYPE template in callable position
# with type-name arguments constructs its mono in place (`(List of: String)`
# in value position): resolve each argument as a type, mint the deduped mono
# with its chains and children, and the call's
# value is the mono.
genericTypeConstruction: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    call: zast.CallData.view
    tplId: ztypes.tid
} out ztypes.tid is {
    tname: typeNameOf :st tid: tplId
    if tname.length == 0 then return (ztypes.tid.create from: 0)
    tk0: declOfTypeId reg: st.reg tid: tplId
    sfx: String
    subs: (MapRV String value: u64)
    valSubs2: (MapRV String value: u64)
    numParamNames9: (List String)
    numParamNodes9: (ListVal u32)
    firstA: u64
    anyMiss: false
    primaryName: firstGenericParamName reg: st.reg templateId: (ztypes.tid.create from: tplId.u64)
    argIdx: u64
    aiter: call.arguments.iterate
    for argId9: aiter loop {
        arg: ast.nodes.get i: argId9.u64
        match (
            arg
        ) case namedoperation then {
            # only generic-param labels construct here; a value arg means
            # the field-bound inference leg owns the call.
            pk0: zast.nameTextCopy :ast ref: arg.name
            # An elided leading type argument (`(List zvfs.ProviderBox)`) binds
            # the primary generic param: probe the unnamed first arg as a type
            # (atom via walkLookupTyperef, cross-unit dotted via dottedTyperefId).
            # Only a real type rebinds; a value first arg (`(box 5)`) keeps its
            # empty label so the field-bound inference leg owns the call.
            if pk0.length == 0 when argIdx == 0 then {
                if primaryName.length > 0 then {
                    anP: paramTypeBaseName :ast op: (ast.nodes.get i: arg.operation.u64)
                    pid0: u64
                    if (isNumericLiteralName name: anP.stringview) == false then {
                        pao0: (walkLookupTyperef
                            :ast
                            ty: st.typing
                            reg: st.reg
                            :unitDecl
                            base: anP.stringview
                        )
                        pid0 = optU64Or o: pao0 d: 0
                        if pid0 == 0 then {
                            dop9: ast.nodes.get i: arg.operation.u64
                            pid0 = dottedTyperefId :ast :st op: dop9
                        }
                    }
                    if pid0 > 0 then pk0 = primaryName.copy
                }
            }
            isP0: false
            if pk0.length > 0 then {
                isP0 = st.reg.isGenericParamOf tdecl: tk0 name: pk0.stringview
            }
            # `capacity:` on a builtin container is a create argument riding
            # the construction sugar: skip it here (it must not reach the
            # spec key or subs) instead of failing over to field inference
            skipCr9: false
            if (isP0) == false when pk0.stringview == "capacity" then {
                if tplId == (builtinTidT
                    :ast
                    ty: st.typing
                    reg: st.reg
                    base: "ListRef"
                ) then skipCr9 = true
                if tplId == (builtinTidT
                    :ast
                    ty: st.typing
                    reg: st.reg
                    base: "ListVal"
                ) then skipCr9 = true
                if tplId == (builtinTidT
                    :ast
                    ty: st.typing
                    reg: st.reg
                    base: "MapRR"
                ) then skipCr9 = true
                if tplId == (builtinTidT
                    :ast
                    ty: st.typing
                    reg: st.reg
                    base: "MapRV"
                ) then skipCr9 = true
                if tplId == (builtinTidT
                    :ast
                    ty: st.typing
                    reg: st.reg
                    base: "MapVR"
                ) then skipCr9 = true
                if tplId == (builtinTidT
                    :ast
                    ty: st.typing
                    reg: st.reg
                    base: "MapVV"
                ) then skipCr9 = true
                if tplId == (builtinTidT
                    :ast
                    ty: st.typing
                    reg: st.reg
                    base: "SetRef"
                ) then skipCr9 = true
                if tplId == (builtinTidT
                    :ast
                    ty: st.typing
                    reg: st.reg
                    base: "SetVal"
                ) then skipCr9 = true
            }
            # a skipped capacity: arg is still a value: check it so its
            # atoms stamp (atomVariableId / refDecl) like any arg
            if skipCr9 then {
                (checkValue
                    :st
                    :unitDecl
                    :ast
                    node: (ast.nodes.get i: arg.operation.u64)
                )
            }
            if (isP0) == false when skipCr9 == false then anyMiss = true
            an: paramTypeBaseName :ast op: (ast.nodes.get i: arg.operation.u64)
            if (anyMiss) == false when skipCr9 == false then { if (isNumericLiteralName name: an.stringview) then {
                nsfx2: "\{sfx}_\{an}"
                sfx = nsfx2
                if pk0.length > 0 then {
                    npn0: pk0.copy
                    numParamNames9.append npn0
                    numParamNodes9.append arg.operation
                    pdv0: parseDecimalU64 text: an.stringview
                    match (
                        pdv0
                    ) case some then {
                        vgk0: pk0.copy
                        vgv0: pdv0
                        valSubs2.set key: vgk0 value: vgv0
                    } case none then null
                }
            } else {
                ao: (walkLookupTyperef
                    :ast
                    ty: st.typing
                    reg: st.reg
                    :unitDecl
                    base: an.stringview
                )
                aid: optU64Or o: ao d: 0
                if aid == 0 then {
                    opf1059: ast.nodes.get i: arg.operation.u64
                    aid = dottedTyperefId :ast :st op: opf1059
                }
                if aid > 0 then {
                    atn: (monoValName
                        :ast
                        ty: st.typing
                        reg: st.reg
                        tid: (ztypes.tid.create from: aid.u64)
                    )
                    nsfx: "\{sfx}_\{atn}"
                    sfx = nsfx
                    if pk0.length > 0 then {
                        pv: aid
                        subs.set key: pk0.copy value: pv
                    }
                    if firstA == 0 then firstA = aid
                } else {
                    anyMiss = true
                }
            } }
        } else null
        argIdx = argIdx + 1
    }
    if anyMiss then return (ztypes.tid.create from: 0)
    if sfx.length == 0 then return (ztypes.tid.create from: 0)
    mname: "\{tname}\{sfx}"
    mid: (getOrMintSpec
        :ast
        ty: st.typing
        reg: st.reg
        :unitDecl
        name: mname.stringview
        templateId: (ztypes.tid.create from: tplId.u64)
        :subs
        valSubs: valSubs2
        fallbackArg: firstA
    )
    if mid.isZero then return (ztypes.tid.create from: 0)
    npi9: u64
    npn9: numParamNames9.length
    for npi9 < npn9 loop {
        npName9: numParamNames9.get i: npi9
        npNode9: numParamNodes9.get i: npi9
        (st.typing.setDefaultLiteral
            pool: ast.names
            parentTypeId: mid
            name: npName9.stringview
            node: npNode9
        )
        npi9 = npi9 + 1
    }
    isSized2: false
    if tname.stringview == "str" then isSized2 = true
    if tname.stringview == "array" then isSized2 = true
    if isSized2 then {
        (mintCollectionChildren
            :ast
            ty: st.typing
            reg: st.reg
            monoId: mid
            templateId: (ztypes.tid.create from: tplId.u64)
            elemArg: firstA
            valArg: ztypes.tid
        )
    }
    # Only a bare-atom callable restamps to the instance; a dotted callable
    # (the .str conversion form) leaves the path unstamped like the reference.
    gcb: bareAtomName :ast n: (ast.nodes.get i: call.callable.u64)
    gcal: nodeId n: (ast.nodes.get i: call.callable.u64)
    if gcal > 0 when gcb.length > 0 then {
        setga: mid
        stampGate :st nid: gcal.u64 tid: setga
    }
    setgt: mid
    stampGate :st nid: call.nodeid.u64 tid: setgt
    st.typing.callKind.set key: call.nodeid.u64 value: zast.callkind.classCreate
    return mid
}

# validateGenericTypeArgs -- reject unknown / duplicate generic TYPE arguments
# at a settled construction site. A named arg matching neither a declared
# generic param nor a declared field (child) is an unknown type argument; a
# generic param supplied twice (e.g. an elided leading arg plus an explicit
# label) is a duplicate. Returns false when an error was emitted.
validateGenericTypeArgs: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    call: zast.CallData.view
    tplId: ztypes.tid
    allowFrom: bool
} out bool is {
    tname: typeNameOf :st tid: tplId
    if tname.length == 0 then return true
    tk: declOfTypeId reg: st.reg tid: tplId
    childNames: (List String)
    {
        vgN9: (ListVal u64)
        vgT9: (ListVal u64)
        st.typing.declChildRows ownerTid: tplId names: vgN9 tids: vgT9
        vgi9: u64
        vgn9: vgN9.length
        for vgi9 < vgn9 loop {
            vgnid9: vgN9.get i: vgi9
            vgi9 = vgi9 + 1
            cnB2: ast.names.texts.get i: vgnid9.u64
            cn1: cnB2.copy
            childNames.append cn1
        }
    }
    primaryName: firstGenericParamName reg: st.reg templateId: (ztypes.tid.create from: tplId.u64)
    seen: (Set String)
    ok: true
    argIdx: u64
    aiter: call.arguments.iterate
    for argId9: aiter loop {
        arg: ast.nodes.get i: argId9.u64
        match (
            arg
        ) case namedoperation then {
            pk: zast.nameTextCopy :ast ref: arg.name
            if pk.length == 0 when argIdx == 0 then {
                if primaryName.length > 0 then {
                    anP: paramTypeBaseName :ast op: (ast.nodes.get i: arg.operation.u64)
                    pid0: u64
                    if (isNumericLiteralName name: anP.stringview) == false then {
                        pao0: (walkLookupTyperef
                            :ast
                            ty: st.typing
                            reg: st.reg
                            :unitDecl
                            base: anP.stringview
                        )
                        pid0 = optU64Or o: pao0 d: 0
                        if pid0 == 0 then {
                            dop9: ast.nodes.get i: arg.operation.u64
                            pid0 = dottedTyperefId :ast :st op: dop9
                        }
                    }
                    if pid0 > 0 then pk = primaryName.copy
                }
            }
            skipFrom: false
            if allowFrom when pk.stringview == "from" then skipFrom = true
            if pk.length > 0 when (skipFrom) == false then {
                isP: st.reg.isGenericParamOf tdecl: tk name: pk.stringview
                if isP then {
                    if (seen.has item: pk.copy) when (allowFrom) == false then {
                        m1: "duplicate type argument '\{pk}'"
                        en1: String
                        eh1: String
                        (addErrorH
                            :st
                            nodeid: arg.nodeid
                            lineno: arg.lineno
                            colno: arg.colno
                            e: zast.err.genericError
                            msg: m1
                            note: en1
                            hint: eh1
                            width: pk.length.u32.orPanic
                        )
                        ok = false
                    } else {
                        seen.add item: pk.copy
                    }
                } else {
                    isField: false
                    ci: u64
                    cn: childNames.length
                    for ci < cn loop {
                        cnm: childNames.get i: ci
                        if cnm.stringview == pk.stringview then isField = true
                        ci = ci + 1
                    }
                    if (isField) == false when pk.stringview == "capacity" then {
                        # `capacity:` on a builtin container construction is a
                        # create argument (`Type arg:` is `Type.create arg:`);
                        # native create params carry no modeled children, so
                        # the label is admitted by template identity.
                        if tplId == (builtinTidT
                            :ast
                            ty: st.typing
                            reg: st.reg
                            base: "ListRef"
                        ) then isField = true
                        if tplId == (builtinTidT
                            :ast
                            ty: st.typing
                            reg: st.reg
                            base: "ListVal"
                        ) then isField = true
                        if tplId == (builtinTidT
                            :ast
                            ty: st.typing
                            reg: st.reg
                            base: "MapRR"
                        ) then isField = true
                        if tplId == (builtinTidT
                            :ast
                            ty: st.typing
                            reg: st.reg
                            base: "MapRV"
                        ) then isField = true
                        if tplId == (builtinTidT
                            :ast
                            ty: st.typing
                            reg: st.reg
                            base: "MapVR"
                        ) then isField = true
                        if tplId == (builtinTidT
                            :ast
                            ty: st.typing
                            reg: st.reg
                            base: "MapVV"
                        ) then isField = true
                        if tplId == (builtinTidT
                            :ast
                            ty: st.typing
                            reg: st.reg
                            base: "SetRef"
                        ) then isField = true
                        if tplId == (builtinTidT
                            :ast
                            ty: st.typing
                            reg: st.reg
                            base: "SetVal"
                        ) then isField = true
                    }
                    if (isField) == false then {
                        m2: "unknown type argument '\{pk}' for generic type '\{tname}'"
                        plist: st.reg.genericParamNamesOf tdecl: tk
                        note2: "valid type parameters: ".string
                        pi: u64
                        pn2: plist.length
                        for pi < pn2 loop {
                            if pi > 0 then note2.append s: ", "
                            pnm: plist.get i: pi
                            note2.append s: pnm
                            pi = pi + 1
                        }
                        eh2: String
                        (addErrorH
                            :st
                            nodeid: arg.nodeid
                            lineno: arg.lineno
                            colno: arg.colno
                            e: zast.err.genericError
                            msg: m2
                            note: note2
                            hint: eh2
                            width: pk.length.u32.orPanic
                        )
                        ok = false
                    }
                }
            }
        } else null
        argIdx = argIdx + 1
    }
    return ok
}

# methodReturnOf -- a method FUNCTION type's return type id: the synthesized
# returnTypeId link when set, else the AST method's recorded `out T` ref node
# (funcReturnNode) read through the post-demand stamp.
methodReturnOf: function {st: zenv.ZSymbolTable mid: ztypes.tid} out optionval ztypes.tid is {
    rto: st.reg.returnTypeOf tid: mid
    if rto > 0 then return (optionval.some rto)
    rn: st.typing.funcReturnNode.get key: mid
    match (
        rn
    ) case some then {
        nt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: rn
        if nt > 0 then return (optionval.some (ztypes.tid.create from: nt))
    } case none then null
    return (optionval.none ztypes.tid)
}

# iterWrapperElem -- when a type is an Option / optionval / OptionView instance,
# its element (`some` child) type id.
iterWrapperElem: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    wid: ztypes.tid
} out optionval u64 is {
    origin: u64
    goo: st.reg.genericOriginOf tid: wid
    if goo > 0 then origin = goo
    if origin == 0 then return (optionval.none u64)
    isWrapper: false
    oo: walkLookupTyperef :ast ty: st.typing reg: st.reg :unitDecl base: "Option"
    match (
        oo
    ) case some then {
        if origin == oo then isWrapper = true
    } case none then null
    vo: walkLookupTyperef :ast ty: st.typing reg: st.reg :unitDecl base: "optionval"
    match (
        vo
    ) case some then {
        if origin == vo then isWrapper = true
    } case none then null
    wo: walkLookupTyperef :ast ty: st.typing reg: st.reg :unitDecl base: "OptionView"
    match (
        wo
    ) case some then {
        if origin == wo then isWrapper = true
    } case none then null
    (forceMemberOf ty: st.typing reg: st.reg :ast parentTypeId: wid nameId: zast.wkSome)
    if isWrapper then return (st.typing.declChildOfId parentTypeId: wid nameId: zast.wkSome)
    return (optionval.none u64)
}

# isOptionViewMono -- true when a type is an OptionView instance (its per-
# iteration values are borrowed views, so the loop var binds BORROWED).
isOptionViewMono: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    wid: ztypes.tid
} out bool is {
    origin: u64
    goo: st.reg.genericOriginOf tid: wid
    if goo > 0 then origin = goo
    if origin == 0 then return false
    wo: walkLookupTyperef :ast ty: st.typing reg: st.reg :unitDecl base: "OptionView"
    match (
        wo
    ) case some then {
        return origin == wo
    } case none then {
        return false
    }
}

# methodHasNoUserArgs -- true when a method type has no user-visible parameters
# beyond the implicit receiver: no children at all (synthesized collection
# methods), or a single child that IS the receiver -- `this`, or the long-form
# receiver recorded in thisParamName (`stringview: function {t: this.lock}`).

# optU64Or / optBoolOr -- the option's payload, or the given default. Collapse
# the some/none match at get-or-default sites (match narrowing needs a
# bare-name subject, so inline gets can't match directly).
optVidOr: function {o: optionval ztypes.vid} out ztypes.vid is {
    match (
        o
    ) case some then {
        return o
    } case none then {
        return (ztypes.vid.create from: 0)
    }
}

# optTidOr -- the value of optional TYPE id `o`, or `d` when none. A sibling
# of optU64Or rather than a conversion at each call: `optionval tid` is not an
# `optionval u64`, a typedef substitutes for its base as a whole value and not
# as a generic argument.
optTidOr: function {o: optionval ztypes.tid d: ztypes.tid} out ztypes.tid is {
    match (
        o
    ) case some then {
        return o
    } case none then {
        return d
    }
}

# the value of optional u64 `o`, or `d` when none.
optU64Or: function {o: optionval u64 d: u64} out u64 is {
    match (
        o
    ) case some then {
        return o
    } case none then {
        return d
    }
}

# the value of optional bool `o`, or `d` when none.
optBoolOr: function {o: optionval bool d: bool} out bool is {
    match (
        o
    ) case some then {
        return o
    } case none then {
        return d
    }
}

# createDottedBaseId -- the base atom's node id when a dotted path's child is
# `create` (explicit construction: `T.create` is bare-name construction).
createDottedBaseId: function {ast: Ast.view n: Node.view} out optionval u32 is {
    match (
        n
    ) case dottedpath then {
        ccn: atomName :ast n: (ast.nodes.get i: n.child.u64)
        if ccn.stringview == "create" then return (optionval.some n.parent.u32)
    } else null
    return (optionval.none u32)
}

# rootNameOf -- a value path's root atom name (unwrapping expressions and
# dotted segments), or "".
rootNameOf: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } case expression then {
        return (rootNameOf :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (rootNameOf :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# dottedChildName -- a dotted path's child atom name, or "".
dottedChildName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case dottedpath then {
        return (atomName :ast n: (ast.nodes.get i: n.child.u64))
    } else {
        return "".string
    }
}

# dottedChildNameId -- the pool id of a dotted path's child atom name
# (0 when the shape differs).
dottedChildNameId: function {ast: Ast.view n: Node.view} out zast.nameid is {
    match (
        n
    ) case dottedpath then {
        return (atomNameId :ast n: (ast.nodes.get i: n.child.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}

# unionCreateArmName -- the constructed arm's name when a value is a tagged
# subtype construction (a UNION_CREATE-stamped call's dotted child), or "".
unionCreateArmName: function {ast: Ast.view st: zenv.ZSymbolTable.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (unionCreateArmName :ast :st n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        dgot: st.typing.dpTaggedParent.get key: n.nodeid.u64
        match (
            dgot
        ) case some then {
            return (atomName :ast n: (ast.nodes.get i: n.child.u64))
        } case none then {
            return "".string
        }
    } case call then {
        kOpt: st.typing.callKind.get key: n.nodeid.u64
        isUC: false
        match (
            kOpt
        ) case some then {
            if kOpt == zast.callkind.unionCreate then isUC = true
        } case none then null
        if isUC then return (dottedChildName :ast n: (ast.nodes.get i: n.callable.u64))
        return "".string
    } else {
        return "".string
    }
}

# borrowDottedBaseId -- the base atom's node id when a dotted path's child is
# `borrow` (a protocol/facet borrow projection), or none.
borrowDottedBaseId: function {ast: Ast.view n: Node.view} out optionval u32 is {
    match (
        n
    ) case dottedpath then {
        bcn: atomName :ast n: (ast.nodes.get i: n.child.u64)
        if bcn.stringview == "borrow" then return (optionval.some n.parent.u32)
    } else null
    return (optionval.none u32)
}

# valueNoCoerce -- checkValue minus the value-position auto-call coercion
# (construction arguments take method REFERENCES for function-typed fields).
valueNoCoerce: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    ast: Ast.view
    n: Node.view
} out u64 is {
    match (
        n
    ) case expression then {
        ev: valueNoCoerce :st :unitDecl :ast n: (ast.nodes.get i: n.expression.u64)
        if ev > 0 then {
            sete: ev
            stampGate :st nid: n.nodeid.u64 tid: (ztypes.tid.create from: sete.u64)
        }
        return ev
    } case dottedpath then {
        return (checkDotted :st :unitDecl :ast dp: n coerce: false)
    } else {
        return (checkValue :st :unitDecl :ast node: n)
    }
}

# checkProjectionCreate -- `F.create from: expr` / `P.borrow from: expr` on a
# facet or protocol: a projection, not a call. No CALL scope; the from-argument
# walks in the current scope (a facet copies its source -- nothing is consumed);
# the value is the facet/protocol type.
checkProjectionCreate: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    call: zast.CallData.view
    pjId: u64
    consumes: bool
    borrows: bool
} out ztypes.tid is {
    found: false
    aiter: call.arguments.iterate
    for argId9: aiter loop {
        arg: ast.nodes.get i: argId9.u64
        match (
            arg
        ) case namedoperation then {
            if (found) == false then {
                an: zast.nameTextAt :ast ref: arg.name
                isFrom: false
                if an.length == 0 then {
                    isFrom = true
                } else {
                    if an.stringview == "from" then isFrom = true
                }
                if isFrom then {
                    found = true
                    pvt: (checkValue
                        :st
                        :unitDecl
                        :ast
                        node: (ast.nodes.get i: arg.operation.u64)
                    )
                    if pvt > 0 then {
                        if borrows then {
                            # The from-path's root is the borrow origin (a
                            # bare name or a `.lock`/`.borrow` projection) --
                            # the projection borrows, it never hoists.
                            pbr: rootNameOf :ast n: (ast.nodes.get i: arg.operation.u64)
                            if pbr.length > 0 then {
                                pbv2: st.lookupVarId nameId: (nameIdOf :ast name: pbr.stringview)
                                match (
                                    pbv2
                                ) case some then {
                                    drainPendingBorrow :st
                                    pbc2: pbr.copy
                                    st.typing.pendingBorrowPath.append pbc2
                                } case none then null
                            }
                        } else {
                            if (argIsTrivial
                                :ast
                                op: (ast.nodes.get i: arg.operation.u64)
                            ) then {
                                pbn: bareAtomName :ast n: (ast.nodes.get i: arg.operation.u64)
                                if pbn.length > 0 then {
                                    pbv: st.lookupVarId nameId: (nameIdOf :ast name: pbn.stringview)
                                    match (
                                        pbv
                                    ) case some then {
                                        if consumes then {
                                            (st.invalidate
                                                nameId: (nameIdOf :ast name: pbn.stringview)
                                                loc: (optionval.none ztypes.zsrcpos)
                                            )
                                        }
                                    } case none then null
                                }
                            } else {
                                (hoistArg
                                    :ast
                                    :st
                                    argNode: (ast.nodes.get i: arg.operation.u64)
                                    argType: pvt
                                    paramType: 0
                                    :consumes
                                    viewParam: false
                                )
                            }
                        }
                    }
                }
            }
        } else null
    }
    setpj: pjId
    stampGate :st nid: call.nodeid.u64 tid: (ztypes.tid.create from: setpj.u64)
    pjk9: zast.callkind.protocolCreate
    if (st.reg.typetypeOf typeId: (ztypes.tid.create from: pjId.u64)) == ztypes.ztypetype.facetType then {
        if borrows then {
            pjk9 = zast.callkind.facetBorrow
        } else {
            pjk9 = zast.callkind.facetCreate
        }
    } else {
        if borrows then pjk9 = zast.callkind.protocolBorrow
    }
    st.typing.callKind.set key: call.nodeid.u64 value: pjk9
    return (ztypes.tid.create from: pjId)
}

# metaCreateBaseId -- the base atom's node id when a callable is the dotted
# `meta.create` (the enclosing type's raw allocator), or none.
metaCreateBaseId: function {ast: Ast.view n: Node.view} out optionval u32 is {
    match (
        n
    ) case dottedpath then {
        pn: atomName :ast n: (ast.nodes.get i: n.parent.u64)
        cn2: atomName :ast n: (ast.nodes.get i: n.child.u64)
        if pn.stringview == "meta" when cn2.stringview == "create" then {
            return (optionval.some (nodeId n: (ast.nodes.get i: n.parent.u64)).u32)
        }
    } else null
    return (optionval.none u32)
}

# typedefBaseOf -- a typedef type's base type id (the recorded base name,
# copiedMapStr -- owned copy of a u64-keyed map entry ("" when absent):
# confines the value view to this frame so the caller can immediately
# re-lend the map's container (fnReturnTidOf-style view scoping).
copiedMapStr: function {m: (MapVR u64 value: String) key: u64} out String is {
    vo: m.get :key
    match (
        vo
    ) case some then {
        return vo.copy
    } case none then {
        return "".string
    }
}

# resolved at read time -- the resolver runs before the base's unit), or 0.
typedefBaseOf: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    tid: ztypes.tid
} out ztypes.tid is {
    bn9: copiedMapStr m: st.typing.typedefBaseName key: tid
    if bn9.length == 0 then return (ztypes.tid.create from: 0)
    return (ztypes.tid.create from: (optU64Or
        o: (walkLookupTyperef
            :ast
            ty: st.typing
            reg: st.reg
            :unitDecl
            base: bn9.stringview
        )
        d: 0
    ))
}

# typedefBaseTidOf -- a typedef type's base INSTANCE id, resolved structurally
# when the wrapper was declared, or 0.
typedefBaseTidOf: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out ztypes.tid is {
    return (optTidOr o: (st.typing.typedefBaseTid.get key: tid) d: ztypes.tid)
}

# checkTypedefCreate -- `T.create from: expr` / bare `T expr` on a typedef:
# an owned cast, not a call. No CALL scope; the from-argument walks in the
# current scope (a non-trivial one hoists there) and is consumed; the value
# is the typedef type.
checkTypedefCreate: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    call: zast.CallData.view
    tdId: u64
} out ztypes.tid is {
    found: false
    aiter: call.arguments.iterate
    for argId9: aiter loop {
        arg: ast.nodes.get i: argId9.u64
        match (
            arg
        ) case namedoperation then {
            if (found) == false then {
                an: zast.nameTextAt :ast ref: arg.name
                isFrom: false
                if an.length == 0 then {
                    isFrom = true
                } else {
                    if an.stringview == "from" then isFrom = true
                }
                if isFrom then {
                    found = true
                    vt: (checkValue
                        :st
                        :unitDecl
                        :ast
                        node: (ast.nodes.get i: arg.operation.u64)
                    )
                    if vt > 0 then {
                        if (argIsTrivial :ast op: (ast.nodes.get i: arg.operation.u64)) then {
                            bn: bareAtomName :ast n: (ast.nodes.get i: arg.operation.u64)
                            if bn.length > 0 then {
                                bvo: st.lookupVarId nameId: (nameIdOf :ast name: bn.stringview)
                                match (
                                    bvo
                                ) case some then {
                                    # only a REFTYPE source transfers. A
                                    # valtype owns no heap, so the typedef
                                    # takes a copy and the name stays live --
                                    # the same guard a returned owned local
                                    # carries before it records a move.
                                    if (typeIsReftype :st tid: vt) then {
                                        (st.invalidate
                                            nameId: (nameIdOf :ast name: bn.stringview)
                                            loc: (optionval.none ztypes.zsrcpos)
                                        )
                                    }
                                } case none then null
                            }
                        } else {
                            (hoistArg
                                :ast
                                :st
                                argNode: (ast.nodes.get i: arg.operation.u64)
                                argType: vt
                                paramType: 0
                                consumes: true
                                viewParam: false
                            )
                        }
                    }
                }
            }
        } else null
    }
    settd: tdId
    stampGate :st nid: call.nodeid.u64 tid: (ztypes.tid.create from: settd.u64)
    st.typing.callKind.set key: call.nodeid.u64 value: zast.callkind.typedefCreate
    return (ztypes.tid.create from: tdId)
}

# checkTypedefBorrow -- `T.borrow from: expr` on a typedef: a borrowed
# cast. No CALL scope, no take; the from-argument walks in the current
# scope and the binding borrows the argument's source (the lifted view
# origin when the argument is itself a borrowed view, else the
# argument's own path).
checkTypedefBorrow: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    call: zast.CallData.view
    tdId: u64
} out ztypes.tid is {
    found: false
    aiter: call.arguments.iterate
    for argId9: aiter loop {
        arg: ast.nodes.get i: argId9.u64
        match (
            arg
        ) case namedoperation then {
            if (found) == false then {
                an: zast.nameTextAt :ast ref: arg.name
                isFrom: false
                if an.length == 0 then {
                    isFrom = true
                } else {
                    if an.stringview == "from" then isFrom = true
                }
                if isFrom then {
                    found = true
                    vt: (checkValue
                        :st
                        :unitDecl
                        :ast
                        node: (ast.nodes.get i: arg.operation.u64)
                    )
                    if vt > 0 then {
                        if st.typing.pendingBorrowPath.length <= 0 then {
                            tup: (List String)
                            (appendValueTuple
                                :ast
                                n: (ast.nodes.get i: arg.operation.u64)
                                dst: tup
                            )
                            ti: u64
                            tn: tup.length
                            for ti < tn loop {
                                te: tup.get i: ti
                                tec: te.copy
                                st.typing.pendingBorrowPath.append tec
                                ti = ti + 1
                            }
                        }
                    }
                }
            }
        } else null
    }
    settd: tdId
    stampGate :st nid: call.nodeid.u64 tid: (ztypes.tid.create from: settd.u64)
    st.typing.callKind.set key: call.nodeid.u64 value: zast.callkind.typedefBorrow
    return (ztypes.tid.create from: tdId)
}

# methodHasThisReceiver -- a FUNCTION child bound to a receiver: a declared
# `this` param (shorthand) or a recorded long-form receiver name. A this-less
# function member is a callable field, not a method.
methodHasThisReceiver: function {st: zenv.ZSymbolTable mid: ztypes.tid} out bool is {
    if (st.typing.declHasMemberId parentTypeId: mid nameId: zast.wkThis) then return true
    return (st.reg.hasThisParamName tid: mid)
}

# true when method `mid` takes no user arguments (only the receiver).
methodHasNoUserArgs: function {ast: Ast st: zenv.ZSymbolTable mid: ztypes.tid} out bool is {
    cnt: st.typing.declMemberCount ownerTid: mid
    if cnt == 0 then return true
    if cnt != 1 then return false
    soleName: String
    soleId: st.typing.declLastChildNameId ownerTid: mid
    if soleId > 0 then {
        snB9: ast.names.texts.get i: soleId.u64
        soleName = snB9.copy
    }
    if soleId == zast.wkThis.u64 then return true
    return (st.reg.thisParamNameIs
        tid: mid
        nameId: (zast.poolFind pool: ast.names text: soleName.stringview)
    )
}

# lockAutoCallReceiver -- the receiver locks for a zero-arg auto-call's
# duration, exactly as a written-out call does. The lock is released by holder
# as soon as it is taken -- an auto-call opens no scope to pop -- so its only
# effect is the conflict check against locks outstanding elsewhere. `mid` names
# the METHOD, which is what carries the receiver's marker and so decides whether
# the lock is shared or exclusive.
lockAutoCallReceiver: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    dp: zast.DottedPathData.view
    bt: ztypes.tid
    shared: bool
} is {
    atup9: (List String)
    appendValueTuple :ast n: (ast.nodes.get i: dp.parent.u64) dst: atup9
    if atup9.length == 0 then return
    if (typeIsReftype :st tid: (ztypes.tid.create from: bt.u64)) == false then return
    arv9: st.lookupVarId nameId: (nameIdOf :ast name: (atup9.get i: 0).stringview)
    if arv9.none then return
    ashr9: shared
    if atup9.length == 1 then {
        (lockCallArg
                                        :ast
            :st
            pool: ast.names
            name: (atup9.get i: 0).stringview
            callId: dp.nodeid.u64
            shared: ashr9
            nodeid: dp.nodeid
            lineno: dp.lineno
            colno: dp.colno
        )
    } else {
        (lockCallPath
            :st
            :ast
            pool: ast.names
            path: atup9
            callId: dp.nodeid.u64
            shared: ashr9
            nodeid: dp.nodeid
            lineno: dp.lineno
            colno: dp.colno
        )
    }
    ahl9: (ztypes.zlockholder
        kind: ztypes.zlockholderkind.callKind
        id: dp.nodeid.u64
    )
    st.releaseHeldLocks holder: ahl9
}

# fnAutoCallable -- a bare reference to this function is a zero-argument
# auto-call: it has no user parameters, or every non-receiver parameter
# carries a default the site can fill. The strict no-user-args predicate
# stays separate for its other gates (fnptr-field reads, for-iterators).
fnAutoCallable: function {ast: Ast st: zenv.ZSymbolTable mid: ztypes.tid} out bool is {
    if (methodHasNoUserArgs :ast :st :mid) then return true
    thisPnId9: u64
    {
        tpn9: zast.poolTextAt pool: ast.names ref: (st.reg.thisParamNameIdOf tid: mid)
        if tpn9.length > 0 then {
            thisPnId9 = (zast.poolFind pool: ast.names text: tpn9.stringview).u64
        }
    }
    pnIds9: (ListVal u64)
    {
        pdT9: (ListVal u64)
        st.typing.declChildRows ownerTid: mid names: pnIds9 tids: pdT9
    }
    userSeen9: false
    n9: pnIds9.length
    i9: u64
    for i9 < n9 loop {
        pnameId: pnIds9.get i: i9
        i9 = i9 + 1
        isRecv9: false
        if pnameId == zast.wkThis.u64 then isRecv9 = true
        if thisPnId9 > 0 when pnameId == thisPnId9 then isRecv9 = true
        if (isRecv9) == false then {
            userSeen9 = true
            hd9: (st.typing.declHasDefaultId
                parentTypeId: mid
                nameId: (zast.nameid.create from: pnameId.u32.orPanic)
            )
            if (hd9) == false then return false
        }
    }
    return userSeen9
}

# bareFnRefError -- a bare reference to a function with required parameters
# is a call missing its arguments (a reference needs the explicit '.take').
bareFnRefError: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u32
    fid: ztypes.tid
} is {
    prov9: (List String)
    misN9: (List String)
    misI9: (ListVal u64)
    (missingCtorFields
        :ast
        :st
        funcId: (ztypes.tid.create from: fid.u64)
        isCtor: false
        provided: prov9
        posCount: 0
        missingNames: misN9
        missingIds: misI9
    )
    lst9: String
    li9: u64
    ln9: misN9.length
    for li9 < ln9 loop {
        mn9: misN9.get i: li9
        mid9: misI9.get i: li9
        li9 = li9 + 1
        mtn9: typeNameOf :st tid: (ztypes.tid.create from: mid9.u64)
        if lst9.length > 0 then lst9.append ", "
        ln1: "'\{mn9}' (type: \{mtn9})"
        lst9.append ln1
    }
    fn9: typeNameOf :st tid: fid
    m9: "a bare reference to '\{fn9}' calls it: missing required arguments \{lst9}"
    nt9: "a bare function reference in value position is a call".string
    eh9: "call it with its required arguments, or store a reference with '\{fn9}.take'"
    (addErrorH
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.callError
        msg: m9
        note: nt9
        hint: eh9
        :width
    )
}

# canonicalChildBase -- a cross-unit narrowed match-arm base can be a shell id
# (distinct from the canonical defining-unit id) whose member children are not
# registered. Find a same-named type in any unit's resolved scope that has the
# named member; 0 when none. Mirrors the emitter's resolveTypeIdByName scan.
canonicalChildBase: function {ast: Ast st: zenv.ZSymbolTable bt: u64 child: StringView} out u64 is {
    nm: typeNameOf :st tid: (ztypes.tid.create from: bt.u64)
    if nm.length == 0 then return 0
    nmId9: nameIdOf :ast name: nm.stringview
    uks9: (ListVal u64)
    {
        puds9: programUnitDecls ty: st.typing
        with uit: puds9.iterate do for ud9: uit loop {
            unm9: (declNameIdOf
                ty: st.typing
                declId: (ztypes.declid.create from: ud9)
            )
            uks9.append unm9.u64
        }
    }
    cands9: (ListVal u64)
    uki9: u64
    ukn9: uks9.length
    for uki9 < ukn9 loop {
        uk9: uks9.get i: uki9
        uq4z9: unitDeclOfNameId ty: st.typing nameId: (zast.nameid.create from: uk9.u32.orPanic)
        ro9: (resolvedByIds
            :ast
            ty: st.typing

            unitDecl: uq4z9
            name: nmId9
        )
        match (
            ro9
        ) case some then {
            if ro9 != bt then cands9.append ro9
        } case none then null
        uki9 = uki9 + 1
    }
    found: u64
    ci9: u64
    cnn9: cands9.length
    for ci9 < cnn9 loop {
        if found == 0 then {
            cand9: cands9.get i: ci9
            rc9: (st.typing.declChildOf
                pool: ast.names
                parentTypeId: (ztypes.tid.create from: cand9.u64)
                name: child
            )
            match (
                rc9
            ) case some then {
                found = cand9
            } case none then null
        }
        ci9 = ci9 + 1
    }
    return found
}

# markDataRuntimeIndexed -- a data block accessed via `.index` / `.array` needs
# its static array emitted; label accesses fold to constants and don't.
markDataRuntimeIndexed: function {st: zenv.ZSymbolTable tid: ztypes.tid} is {
    if tid >= st.reg.typeById.length then return
    to9: st.reg.typeById.getMut i: tid
    to9.runtimeIndexed = true
}

# dataElemTypeOf -- the element type of a data block, 0 when it cannot be
# derived. A data block records its `out T` as the name of its tag child
# (`tag__u8`), so the element type is that name resolved in the reading unit's
# scope. Both `.index` and `.array` read it -- `.index` yields one element,
# `.array` an array of them -- so it is derived once.
dataElemTypeOf: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    dataTid: ztypes.tid
} out ztypes.tid is {
    (forceMemberOf ty: st.typing reg: st.reg :ast parentTypeId: dataTid nameId: zast.wkTag)
    tgo9: st.typing.declChildOfId parentTypeId: dataTid nameId: zast.wkTag
    match (
        tgo9
    ) case some then {
        tagn9: typeNameOf :st tid: (ztypes.tid.create from: tgo9.u64)
        eno9: tagn9.stringview.stripPrefix p: "tag__"
        match (
            eno9
        ) case some then {
            den9: eno9
            elo9: (walkLookupTyperef
                :ast
                ty: st.typing
                reg: st.reg
                :unitDecl
                base: den9
            )
            match (
                elo9
            ) case some then {
                return (ztypes.tid.create from: elo9.u64)
            } case none then null
        } case none then null
    } case none then null
    return (ztypes.tid.create from: 0)
}

# checkDotted -- a dotted method reference in a body: type the base, look the
# member up on the base's type, and stamp the dotted node -- with the method's
# return when the method takes no user parameters beyond the receiver (the
# auto-call coercion), else with the method FUNCTION type itself.
# baseIsPrivateCapable -- may a private member be read through this base? True
# when the base is the type's own `this`/same-type receiver (self, inside its
# methods), a `.private` projection, or a read of a `.private`-typed friend
# field. Everything else is external and gated.
baseIsPrivateCapable: function {
    st: zenv.ZSymbolTable
    ast: Ast
    bt: ztypes.tid
    baseNode: Node.view
} out bool is {
    btNm9: typeNameOf :st tid: (ztypes.tid.create from: bt.u64)
    if btNm9.length > 0 when st.typing.currentThisName.length > 0 then {
        if st.typing.currentThisName.stringview == btNm9.stringview then return true
    }
    match (
        baseNode
    ) case atomid then {
        anm9: zast.nameTextAt :ast ref: baseNode.name
        if anm9.stringview == "this" then return true
        vo9: st.lookupVarId nameId: (nameIdOf :ast name: anm9.stringview)
        match (
            vo9
        ) case some then {
            po9: st.typing.variableIsPrivate.get key: vo9
            match (
                po9
            ) case some then {
                return po9
            } case none then {
                return false
            }
        } case none then {
            return false
        }
    } case dottedpath then {
        cnm9: atomName :ast n: (ast.nodes.get i: baseNode.child.u64)
        if cnm9.stringview == "private" then return true
        pbNode9: ast.nodes.get i: baseNode.parent.u64
        pbNid9: nodeId n: pbNode9
        pbType9: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: pbNid9.u64
        if pbType9 > 0 when (st.typing.declGrantsPrivate
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: pbType9.u64)
            name: cnm9.stringview
        ) then return true
        return false
    } else {
        return false
    }
}

# memberStrictType -- whether `bt` should get the strict unknown-member check:
# a concrete record/class/union/variant with a declaration and no generic
# origin -- its method set is fully declared, whichever unit declares it.
# Generic instances (List/Map/Set monos, a user template's) and bare shells
# stay lenient because their members are minted per-instantiation.
memberStrictType: function {st: zenv.ZSymbolTable bt: u64} out bool is {
    tt9: st.reg.typetypeOf typeId: (ztypes.tid.create from: bt.u64)
    isConc9: false
    if tt9 == ztypes.ztypetype.recordType then isConc9 = true
    if tt9 == ztypes.ztypetype.classType then isConc9 = true
    if tt9 == ztypes.ztypetype.unionType then isConc9 = true
    if tt9 == ztypes.ztypetype.variantType then isConc9 = true
    if (isConc9) == false then return false
    hasUnit9: (unitDeclOfTid ty: st.typing reg: st.reg tid: (ztypes.tid.create from: bt.u64)) > 0
    if (hasUnit9) == false then return false
    if (st.reg.genericOriginOf tid: (ztypes.tid.create from: bt.u64)) > 0 then return false
    if (st.reg.hasType typeId: (ztypes.tid.create from: bt.u64)) == false then return false
    if (st.reg.isGenericOf tid: (ztypes.tid.create from: bt.u64)) then return false
    return true
}

# typecheck a dotted member-access expression, enforcing visibility and locks.
# isSubunitMemberOf -- the member `member` of unit `unitTid` is a hidden
# implementation subunit. Read off the AST node the member's declaration points
# at, because subunit-ness is how the unit was WRITTEN and the registry records
# only that it is a unit.
isSubunitMemberOf: function {
    ast: Ast.view
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    unitTid: ztypes.tid
    member: optionval u64
} out bool is {
    unitTid
    mt9: u64
    match (
        member
    ) case some then {
        mt9 = member
    } case none then {
        return false
    }
    if (reg.typetypeOf typeId: (ztypes.tid.create from: mt9)) != ztypes.ztypetype.unitType then {
        return false
    }
    dc9: declOfTypeId :reg tid: (ztypes.tid.create from: mt9)
    if dc9.isZero then return false
    dn9: u32
    {
        do9: ty.decls.get i: dc9.u64
        dn9 = do9.node
    }
    if dn9 == 0 then return false
    op9: u32
    {
        nn9: ast.nodes.get i: dn9.u64
        if nn9.namedoperation then op9 = nn9.operation
    }
    return (zast.unitOpKindIs :ast opId: op9 k: zast.unitkind.subunit)
}

# unitMemberTypeOf -- the type a member of unit `unitTid` names: the frame that
# unit roots, which follows a re-export and demands the definition, then its
# member index. One answer for every unit -- a file unit, an inline
# `m: unit { }` and a hidden subunit each root a frame off their own Decl, and
# `unit.member` names a member of THAT unit, so the prelude is not consulted.
unitMemberTypeOf: function {
    ast: Ast.view
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    unitTid: ztypes.tid
    unitDecl: ztypes.declid
    member: StringView
} out optionval u64 is {
    nid9: zast.poolFind pool: ast.names text: member
    if nid9.isZero then return (optionval.none u64)
    # A top-level unit roots a frame under its own name; a nested unit is
    # deliberately absent from that index -- two files may hold units of the
    # same name -- so its root comes off its type id instead. The name is
    # only trusted when it produces THIS unit: a nested unit may share a name
    # with a top-level one, and answering from the index alone probed the
    # other unit's frame for the member. A generic mono's own declaration
    # (declIdOfType) carries its substituted members; declOfTypeId hops to
    # the TEMPLATE's, whose members are the generic ones.
    root9: ztypes.declid
    {
        uro9: unitDecl
        if (uro9.isZero) == false then {
            urt9: declTypeIdOf :ty declId: uro9
            if urt9 == unitTid then root9 = uro9
        }
    }
    if root9.isZero then root9 = ty.declIdOfType typeId: unitTid
    if root9.isZero then root9 = declOfTypeId :reg tid: unitTid
    r9: probeFrameTyperef :ast :ty :reg root: root9 nameId: nid9
    if r9 > 0 then return (optionval.some r9)
    # a definition the unit's `public:` block makes is on its surface
    pb9: publicNsChildOf :ty root: root9
    if (pb9.isZero) == false then {
        r8: probeFrameTyperef :ast :ty :reg root: pb9 nameId: nid9
        if r8 > 0 then return (optionval.some r8)
    }
    return (optionval.none u64)
}

checkDotted: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: zast.DottedPathData.view
    coerce: bool
} out ztypes.tid is {
    # Numeric dotted suffix (`1.u8`, `(2.5).f32`): when the child names a
    # non-function type, the path is a typed-literal cast -- the parent atom
    # coerces to the suffix type and the path carries it. Parens around the
    # literal are the same conversion (peel expression wrappers).
    castBaseId9: dp.parent
    pw9c: u64
    for pw9c < 2 loop {
        cbn9: ast.nodes.get i: castBaseId9.u64
        if cbn9.expression then castBaseId9 = cbn9.expression
        pw9c = pw9c + 1
    }
    castBase: atomName :ast n: (ast.nodes.get i: castBaseId9.u64)
    if (isNumericLiteralName name: castBase.stringview) then {
        castChild: atomName :ast n: (ast.nodes.get i: dp.child.u64)
        castOpt: (walkLookupTyperef
            :ast
            ty: st.typing
            reg: st.reg
            :unitDecl
            base: castChild.stringview
        )
        match (
            castOpt
        ) case some then {
            if (st.reg.typetypeOf typeId: (ztypes.tid.create from: castOpt.u64)) != ztypes.ztypetype.functionType then {
                # a compile-time-constant conversion is checked statically: a
                # lossy literal cast is an error (300.u8, 3.5.u8, an int beyond
                # a float's mantissa). Parse the base against the target kind
                # for range/float checks; add the int->float exact-mantissa check.
                if (isNumericTypeName name: castChild.stringview) then {
                    isChar9c: castBase.stringview.startsWith "0c"
                    if (isChar9c) == false then {
                        nk9c: ztypes.numkindByName name: castChild.stringview
                        pn9c: ztypes.parseNumberAs numstr: castBase.stringview k: nk9c.kind
                        if pn9c.err.length > 0 then {
                            (addError
                                :st
                                nodeid: dp.nodeid
                                lineno: dp.lineno
                                colno: dp.colno
                                e: zast.err.typeError
                                msg: pn9c.err
                            )
                        } else {
                            if (ztypes.isFloatKind k: pn9c.kind) then {
                                baseDot9c: castBase.contains "."
                                exact9c: true
                                if baseDot9c then {
                                    exact9c = ztypes.floatFitsFloat value: pn9c.fval k: pn9c.kind
                                } else {
                                    ivp9c: ztypes.parseNumber numstr: castBase.stringview
                                    ivr9c: ivp9c.ival.i64
                                    match (
                                        ivr9c
                                    ) case ok then {
                                        exact9c = ztypes.intFitsFloat value: ivr9c k: pn9c.kind
                                    } case err then {
                                        exact9c = false
                                    }
                                }
                                if (exact9c) == false then {
                                    em9c: "Value \{castBase.stringview} not exactly representable as \{castChild.stringview}"
                                    (addError
                                        :st
                                        nodeid: dp.nodeid
                                        lineno: dp.lineno
                                        colno: dp.colno
                                        e: zast.err.typeError
                                        msg: em9c
                                    )
                                }
                            }
                        }
                    }
                }
                castPid: nodeId n: (ast.nodes.get i: dp.parent.u64)
                setcp: castOpt
                stampGate :st nid: castPid.u64 tid: (ztypes.tid.create from: setcp.u64)
                setcd: castOpt
                stampGate :st nid: dp.nodeid.u64 tid: (ztypes.tid.create from: setcd.u64)
                return (ztypes.tid.create from: castOpt)
            }
        } case none then null
    }
    # the base of a dotted path is a reference, not a bare value: a type
    # name there must not construct (Counter.create, unit.Type.arm). Only
    # name-shaped bases suppress -- an expression base walks normally so
    # atoms inside its args still stamp.
    supPrev9: st.typing.suppressBareCtor
    dpk9: zast.kindOf :ast id: dp.parent
    if dpk9 == zast.astkind.atomid then st.typing.suppressBareCtor = true
    if dpk9 == zast.astkind.dottedpath then st.typing.suppressBareCtor = true
    # a `.take` child makes the base a function REFERENCE: the base walk
    # must not auto-call it
    supFnPrev9: st.typing.suppressFnAutoCall
    tknm9: atomName :ast n: (ast.nodes.get i: dp.child.u64)
    if tknm9.stringview == "take" then st.typing.suppressFnAutoCall = true
    bt: checkValue :st :unitDecl :ast node: (ast.nodes.get i: dp.parent.u64)
    st.typing.suppressFnAutoCall = supFnPrev9
    st.typing.suppressBareCtor = supPrev9
    if bt.isZero then {
        # an unresolved bare-name base may be a unit-qualified member
        # path (io.stdout): the side map types the base as the UNIT type.
        ubn: atomName :ast n: (ast.nodes.get i: dp.parent.u64)
        if ubn.length > 0 then {
            ubo: (declTypeIdOf
                ty: st.typing
                declId: (st.typing.declFindChild
                    parentDeclId: st.typing.programRoot
                    nameId: (nameIdOf :ast name: ubn.stringview)
                )
            )
            if (ubo.isZero) == false then {
                bt = ztypes.tid.create from: ubo.u64
                ubp: nodeId n: (ast.nodes.get i: dp.parent.u64)
                if ubp > 0 then {
                    setub: ubo
                    stampGate :st nid: ubp.u64 tid: (ztypes.tid.create from: setub.u64)
                }
            }
        }
        if bt.isZero then return (ztypes.tid.create from: 0)
    }
    # A literal base materialises before member lookup (`5.iterate` is
    # i64.iterate); the parent node restamps at the concrete default.
    if (isLiteralTypeId :st tid: bt) then {
        mbt9: materialiseLiteral :ast :st :unitDecl t: bt
        if mbt9 != bt then {
            bt = mbt9
            pid9: nodeId n: (ast.nodes.get i: dp.parent.u64)
            if pid9 > 0 then {
                setp9: mbt9
                stampGate :st nid: pid9.u64 tid: setp9
            }
        }
    }
    cn: atomName :ast n: (ast.nodes.get i: dp.child.u64)
    if cn.length == 0 then return (ztypes.tid.create from: 0)
    cnId9: atomNameId :ast n: (ast.nodes.get i: dp.child.u64)
    # `.private` / `.public` access markers: the path carries the base's
    # type (the access view is a dump-filtered shell, not a member).
    if cn.stringview == "private" then {
        # Gate B: a `.private` view may only be produced from a base that
        # already holds private access -- the type's own `this`/same-type
        # receiver (the class minting it), or an existing `.private` handle (a
        # friend forwarding what it was given, per spec). External code holding
        # only a public value cannot mint one -- E0102.
        baseGN9: ast.nodes.get i: dp.parent.u64
        if (baseIsPrivateCapable :st :ast :bt baseNode: baseGN9) == false then {
            pcNode9: ast.nodes.get i: dp.child.u64
            pcnid9: nodeId n: pcNode9
            pcln9: nodeLine n: pcNode9
            pccl9: nodeCol n: pcNode9
            btNm9: typeNameOf :st tid: bt
            pmsg9: "'.private' of '\{btNm9}' may only be taken by '\{btNm9}' or a holder of its '.private' handle"
            (addErrorH
                :st
                nodeid: pcnid9
                lineno: pcln9
                colno: pccl9
                e: zast.err.privateEscape
                msg: pmsg9
                note: "".string
                hint: "".string
                width: cn.length.u32.orPanic
            )
        }
        setpv: bt
        stampGate :st nid: dp.nodeid.u64 tid: setpv
        return bt
    }
    if cn.stringview == "public" then {
        setpb: bt
        stampGate :st nid: dp.nodeid.u64 tid: setpb
        return bt
    }
    if cn.stringview == "lock" then {
        setlk: bt
        stampGate :st nid: dp.nodeid.u64 tid: setlk
        return bt
    }
    # `.stringview` on a StringView is an identity no-op and is rejected --
    # the value is already a StringView.
    if cn.stringview == "stringview" then {
        if bt == (builtinTidTc :ast :st base: "StringView") then {
            msv9: "redundant conversion: '.stringview' on a StringView".string
            nsv9: "the value is already a StringView".string
            hsv9: "drop '.stringview'".string
            (addErrorH
                :st
                nodeid: dp.nodeid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.typeError
                msg: msv9
                note: nsv9
                hint: hsv9
                width: cn.length.u32.orPanic
            )
            return (ztypes.tid.create from: 0)
        }
    }
    # `.str` on String/StringView/str bases is the sized-conversion form:
    # the path resolves to the str TEMPLATE (unstamped -- the call check
    # mints the sized instance and stamps only the Call node).
    if cn.stringview == "str" then {
        isStrBase: false
        if bt == (builtinTidTc :ast :st base: "String") then isStrBase = true
        if bt == (builtinTidTc :ast :st base: "StringView") then isStrBase = true
        if (isStrBase) == false then {
            bga9: u64
            {
                bgo9: st.reg.genericOriginOf tid: bt
                if bgo9 > 0 then bga9 = bgo9
            }
            if bga9 > 0 then {
                if bga9 == (builtinTidTc :ast :st base: "str") then isStrBase = true
            }
        }
        if isStrBase then {
            sto9: walkLookupTyperef :ast ty: st.typing reg: st.reg :unitDecl base: "str"
            match (
                sto9
            ) case some then {
                return (ztypes.tid.create from: sto9)
            } case none then null
        }
    }
    if cn.stringview == "borrow" then {
        # Protocol/facet `.borrow` and a typedef wrapper's FUNCTION borrow
        # child are projection callables, not ownership markers.
        btt1: st.reg.typetypeOf typeId: bt
        isMk: true
        if btt1 == ztypes.ztypetype.protocolType then isMk = false
        if btt1 == ztypes.ztypetype.facetType then isMk = false
        if isMk then {
