}


# resolve a record definition: its fields and methods.
resolveRecord: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    rnode: objref
} is {
    rid: (declareCanonicalType
        :st
        :frame
        :ast

        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.recordType
    )
    rrid: rid
    # `record is native` on the TYPE: the runtime supplies the layout, so
    # routing can ask the declaration whether a type is runtime-backed instead
    # of comparing its name. Mirrors resolveClass.
    st.reg.setNative typeId: (ztypes.tid.create from: rid.u64) value: rnode.isNative
    pvExcl_rrid: (ListVal u64)
    pvGrants_rrid: (ListVal u64)
    scanVisibility :st :ast onode: rnode excl: pvExcl_rrid grants: pvGrants_rrid
    st.reg.setValtype typeId: (ztypes.tid.create from: rid.u64) value: true
    isgen: false
    {
        onIsgen: ast.nodes.get i: rnode.nid.u64
        match (
            onIsgen
        ) case objectdef then {
            isgen = hasGenericParam :ast items: onIsgen.asItems
        } else null
    }
    eqOptR: false
    {
        onEqOptR: ast.nodes.get i: rnode.nid.u64
        match (
            onEqOptR
        ) case objectdef then {
            eqOptR = eqNullOptOut :ast asItems: onEqOptR.asItems
        } else null
    }
    eqAsR: false
    {
        onEqAsR: ast.nodes.get i: rnode.nid.u64
        match (
            onEqAsR
        ) case objectdef then {
            eqAsR = asDeclaresMember :ast asItems: onEqAsR.asItems member: "=="
        } else null
    }
    # `copy: null` strikes the default byte copy off this type. It is recorded
    # as a member carrying the null shell so the use site can tell it from a
    # type that simply never mentioned `copy`.
    hasMemberNullOptOut33: false
    {
        onhasMemberNullOptOut33: ast.nodes.get i: rnode.nid.u64
        match (
            onhasMemberNullOptOut33
        ) case objectdef then {
            hasMemberNullOptOut33 = (memberNullOptOut
                :ast
                asItems: onhasMemberNullOptOut33.asItems
                member: "copy"
            )
        } else null
    }
    if hasMemberNullOptOut33 then {
        st.typing.copyOptOut.add item: rid
    }
    if isgen then {
        st.reg.setGeneric typeId: (ztypes.tid.create from: rid.u64) value: true
        tdecl9: (declOfUnitDef :st :frame :unitDecl nameId: (nameIdOf :ast name: defName))
        {
            onRg: ast.nodes.get i: rnode.nid.u64
            match (
                onRg
            ) case objectdef then {
                (registerGenericParams
                    :st
                    :ast
                    tdecl: tdecl9
                    items: onRg.asItems
                )
            } else null
        }
    }
    istd: recordIsTypedef :ast :rnode
    if istd then recordTypedefBase :st :frame :ast :unitDecl :rnode :rid
    hasCreateIs: false
    hasEqIs: false
    if (istd) == false then {
        kFiter: u64
        for kFiter < rnode.nis loop {
            fmId: (zast.objIsItemAt :ast nid: rnode.nid i: kFiter).u32
            kFiter = kFiter + 1
            fm: argRefAt :ast nid: (zast.nodeid.create from: fmId.u32)
            if (fm.nid.isZero) == false then {
                # an owned copy: the walks below lend ast
                fname: zast.nameTextCopy :ast ref: fm.name
                ownerNmId: nameIdOf :ast name: defName
                mido: (resolveMethodFnLazy
                    :st
                    :frame

                    :ast
                    :unitDecl
                    ownerNameId: ownerNmId
                    mname: fname.stringView
                    thisName: defName
                    opId: fm.operation
                    lazyOk: (isgen) == false
                )
                match (
                    mido
                ) case some then {
                    if fname.stringView == "create" then hasCreateIs = true
                    if fname.stringView == "==" then hasEqIs = true
                    (st.typing.setMemberType
                        parentTypeId: (ztypes.tid.create from: rid.u64)
                        nameId: fm.name
                        childTypeId: mido
                    )
                    if (fnFieldFlaggableName name: fname.stringView) then {
                        (st.typing.setChildFnptrField
                            pool: ast.names
                            parentTypeId: (ztypes.tid.create from: rid.u64)
                            name: fname.stringView
                        )
                    }
                } case none then {
                    (attachRecordField
                        :st
                        :frame
                        :ast
                        :unitDecl
                        :defName
                        :rid
                        :fm
                        fname: fname.stringView
                    )
                }
            }
        }
    }
    hasCreateAs: (attachMethods
        :st
        :frame

        :ast
        :unitDecl
        :defName
        parentId: (ztypes.tid.create from: rid.u64)
        objId: rnode.nid
    )
    hasCreate: hasCreateIs
    if hasCreateAs then hasCreate = true
    attachMarkers :st :frame :ast :unitDecl parentId: rid objId: rnode.nid
    if (hasCreate) == false then {
        createId: (st.reg.newType
            name: "create"
            ownerTid: rid
            typetype: ztypes.ztypetype.functionType
        )
        (st.typing.declSynthMember
            parentTypeId: (ztypes.tid.create from: rid.u64)
            nameId: zast.names.wkCreate
            kind: ztyping.declkind.methodDecl
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: rid.u64)
            nameId: zast.names.wkCreate
            childTypeId: createId
        )
        materializeCreateParams :st :frame :ast typeTid: rid :createId
    }
    (synthRecordMembers
        :st
        :ast
        :rnode
        :rid
        :istd
        :isgen
        :eqOptR
        :eqAsR
        :hasEqIs
    )
    if pvExcl_rrid.length > 0 then st.typing.privacySeen = true
    applyGrantsPrivate :st parentId: rrid grants: pvGrants_rrid
}

# resolveVariant -- resolve a variant ObjectDef into a VARIANT valtype: a child per
# arm (arm name -> payload type-ref shell; a `null` arm -> the `null` shell), a
# synthesized `tag` child (the `{name}:tag:data` discriminator wrapper), any as-block
# methods, then synthesized `==`/`!=`. Variants have no `create` (bare construction is
# disabled). Custom-DATA tags + generics arrive later.
# detectTagAccessor -- a non-function variant/union as-item of the form
# `name: <numeric>.tag` declares the read-only tag accessor: instances
# expose the discriminator ordinal as the numeric type under that name.
detectTagAccessor: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    ownerId: u64
    armNames: (IdSet u64).view
    am: argref
} is {
    tp: dottedParentName :ast n: (ast.nodes.get i: am.operation.u64)
    # an owned copy: the walks below lend ast
    tc: zast.nameTextCopy :ast ref: (dottedChildNameId :ast n: (ast.nodes.get i: am.operation.u64))
    if tc.stringView != "tag" then return
    if (isNumericTypeName name: tp.stringView) == false then return
    # an owned copy: the walks below lend ast
    mname: zast.nameTextCopy :ast ref: am.name
    nid: (resolveTyperefShellMarked
        :st
        :frame

        :ast
        :unitDecl
        ownerId: 0
        nid: am.operation
        thisName: defName
    )
    if nid.isZero then return
    if (armNames.has item: am.name.u64) then {
        mac: "'\{mname}' collides with the '\{defName}' arm of the same name"
        (addResolveErrorH
            :st
            nodeid: am.nid
            lineno: am.lineno
            colno: am.colno
            e: zast.err.duplicateDef
            msg: mac
            width: mname.length.u32.orPanic
        )
        return
    }
    st.typing.tagAccessorName.set key: ownerId value: am.name
    st.typing.tagAccessorTid.set key: (ztypes.tid.create from: ownerId.u64) value: nid
}
# synthVariantEqHash -- a variant that writes its own `==` keeps it: the synthesised
# pair is the DEFAULT, and a default yields to a declaration, exactly as
# resolveRecord yields through eqAsR. Without this the synthesised marker
# overwrites the declared method's type, and the registry then answers that
# `bool`'s native `==` is a structural compare no runtime supplies. `hash` is on
# the same terms.
synthVariantEqHash: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    vnode: objref
    vid: u64
    isgen: bool
    eqOptV: bool
    eqAsV: bool
} is {
    # a variant that writes its own `==` keeps it: the synthesised pair is the
    # DEFAULT, and a default yields to a declaration, exactly as resolveRecord
    # yields through eqAsR and as `hash` yields three lines below. Without
    # this the synthesised marker overwrites the declared method's type, and
    # the registry then answers that `bool`'s native `==` is a structural
    # compare that no runtime supplies.
    if (isgen) == false when (eqOptV) == false when (eqAsV) == false then {
        eqId: st.reg.newType name: "==" ownerTid: vid typetype: ztypes.ztypetype.functionType
        (st.typing.declSynthMember
            parentTypeId: (ztypes.tid.create from: vid.u64)
            nameId: zast.names.wkOpEq
            kind: ztyping.declkind.methodDecl
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: vid.u64)
            nameId: zast.names.wkOpEq
            childTypeId: eqId
        )
        neqId: st.reg.newType name: "!=" ownerTid: vid typetype: ztypes.ztypetype.functionType
        (st.typing.declSynthMember
            parentTypeId: (ztypes.tid.create from: vid.u64)
            nameId: zast.names.wkOpNe
            kind: ztyping.declkind.methodDecl
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: vid.u64)
            nameId: zast.names.wkOpNe
            childTypeId: neqId
        )
    }
    # `hash` on the same terms as `==` above (see resolveRecord).
    hshOptV: false
    {
        onHshOptV: ast.nodes.get i: vnode.nid.u64
        match (
            onHshOptV
        ) case objectdef then {
            hshOptV = memberNullOptOut :ast asItems: onHshOptV.asItems member: "hash"
        } else null
    }
    hshAsV: false
    {
        onHshAsV: ast.nodes.get i: vnode.nid.u64
        match (
            onHshAsV
        ) case objectdef then {
            hshAsV = asDeclaresMember :ast asItems: onHshAsV.asItems member: "hash"
        } else null
    }
    if (isgen) == false when hshOptV == false when hshAsV == false then {
        hshV: st.reg.newType name: "hash" ownerTid: vid typetype: ztypes.ztypetype.functionType
        (st.typing.declSynthMember
            parentTypeId: (ztypes.tid.create from: vid.u64)
            nameId: zast.names.wkHash
            kind: ztyping.declkind.methodDecl
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: vid.u64)
            nameId: zast.names.wkHash
            childTypeId: hshV
        )
    }
}
# attachVariantMethods -- a variant's asItems are its methods. A name that collides
# with one of its ARM names is rejected here: an arm read and a method call spell
# the same at the use site.
attachVariantMethods: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    vnode: objref
    vid: u64
    isgen: bool
    ordinalArmNames: (IdSet u64).view
} is {
    kAiter: u64
    for kAiter < vnode.nas loop {
        amId: (zast.objAsItemAt :ast nid: vnode.nid i: kAiter).u32
        kAiter = kAiter + 1
        am: argRefAt :ast nid: (zast.nodeid.create from: amId.u32)
        if (am.nid.isZero) == false then {
            # an owned copy: the walks below lend ast
            mname: zast.nameTextCopy :ast ref: am.name
            ownerNmId: nameIdOf :ast name: defName
            mido: (resolveMethodFnLazy
                :st
                :frame

                :ast
                :unitDecl
                ownerNameId: ownerNmId
                mname: mname.stringView
                thisName: defName
                opId: am.operation
                lazyOk: (isgen) == false
            )
            match (
                mido
            ) case some then {
                if (ordinalArmNames.has item: am.name.u64) then {
                    mc: "'\{mname}' collides with the '\{defName}' arm of the same name"
                    (addResolveErrorH
                        :st
                        nodeid: am.nid
                        lineno: am.lineno
                        colno: am.colno
                        e: zast.err.duplicateDef
                        msg: mc
                        width: mname.length.u32.orPanic
                    )
                } else if mname.stringView == "tag" then {
                    mr: "'tag' is a reserved member name".string
                    (addResolveErrorH
                        :st
                        nodeid: am.nid
                        lineno: am.lineno
                        colno: am.colno
                        e: zast.err.reservedMember
                        msg: mr
                        width: 3
                    )
                } else {
                    (st.typing.setMemberType
                        parentTypeId: (ztypes.tid.create from: vid.u64)
                        nameId: am.name
                        childTypeId: mido
                    )
                }
            } else {
                if (isgen) == false then {
                    (detectTagAccessor
                        :st
                        :frame

                        :ast
                        :unitDecl
                        :defName
                        ownerId: vid
                        armNames: ordinalArmNames
                        :am
                    )
                }
            }
        }
    }
}
# attachVariantTag -- the discriminator member a concrete variant carries: the
# custom tag type its `as` block names, or the default one. A 2-arm sum also
# records which arm the zero discriminator selects.
attachVariantTag: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    vnode: objref
    vid: u64
    armCountV: u64
    allNullV: bool
} is {
    customTagV: unionCustomTagId :st :frame :ast :unitDecl uid: vid objId: vnode.nid
    tagId: u64
    match (
        customTagV
    ) case some then {
        tagId = customTagV
    } case none then {
        tagName: "\{defName}:tag:data"
        tagId = st.reg.newType name: tagName.stringView typetype: ztypes.ztypetype.dataType
    }
    (st.typing.declSynthMember
        parentTypeId: (ztypes.tid.create from: vid.u64)
        nameId: zast.names.wkTag
        kind: ztyping.declkind.fieldDecl
    )
    (st.typing.setMemberType
        parentTypeId: (ztypes.tid.create from: vid.u64)
        nameId: zast.names.wkTag
        childTypeId: tagId
    )
    # the discriminator's declared storage, so a backend can honour it
    {
        tbV: (variantTagBaseTid
            :st
            :frame
            :ast

            :unitDecl
            objId: vnode.nid
        )
        if tbV != 18446744073709551615.u64 then (st.typing.variantTagBase.set
            key: vid.u64
            value: tbV
        )
    }
    # the shape, for whatever backend reads it: every arm written `null`,
    # so the value is an ordinal and nothing needs a tagged struct -- and a
    # discriminator whose values ARE those ordinals.
    if allNullV when armCountV > 0 then {
        if (variantTagIsOrdinalPlain
            :st
            :frame
            :ast

            :unitDecl
            objId: vnode.nid
        ) then {
            st.typing.ordinalVariant.set key: vid.u64 value: armCountV
        }
    }
}


# resolve a variant definition: its arms and methods.
resolveVariant: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    vnode: objref
} is {
    vid: (declareCanonicalType
        :st
        :frame
        :ast

        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.variantType
    )
    vvid: vid
    # `variant is native` on the TYPE: the runtime supplies the layout, so
    # routing can ask the declaration rather than compare a name. Mirrors
    # resolveRecord and resolveClass.
    st.reg.setNative typeId: (ztypes.tid.create from: vid.u64) value: vnode.isNative
    pvExcl_vvid: (ListVal u64)
    pvGrants_vvid: (ListVal u64)
    scanVisibility :st :ast onode: vnode excl: pvExcl_vvid grants: pvGrants_vvid
    st.reg.setValtype typeId: (ztypes.tid.create from: vid.u64) value: true
    isgen: false
    {
        onIsgen: ast.nodes.get i: vnode.nid.u64
        match (
            onIsgen
        ) case objectdef then {
            isgen = hasGenericParam :ast items: onIsgen.asItems
        } else null
    }
    eqOptV: false
    {
        onEqOptV: ast.nodes.get i: vnode.nid.u64
        match (
            onEqOptV
        ) case objectdef then {
            eqOptV = eqNullOptOut :ast asItems: onEqOptV.asItems
        } else null
    }
    eqAsV: false
    {
        onEqAsV: ast.nodes.get i: vnode.nid.u64
        match (
            onEqAsV
        ) case objectdef then {
            eqAsV = asDeclaresMember :ast asItems: onEqAsV.asItems member: "=="
        } else null
    }
    hasMemberNullOptOut30: false
    {
        onhasMemberNullOptOut30: ast.nodes.get i: vnode.nid.u64
        match (
            onhasMemberNullOptOut30
        ) case objectdef then {
            hasMemberNullOptOut30 = (memberNullOptOut
                :ast
                asItems: onhasMemberNullOptOut30.asItems
                member: "copy"
            )
        } else null
    }
    if hasMemberNullOptOut30 then {
        st.typing.copyOptOut.add item: vid
    }
    if isgen then {
        st.reg.setGeneric typeId: (ztypes.tid.create from: vid.u64) value: true
        tdecl92: (declOfUnitDef :st :frame :unitDecl nameId: (nameIdOf :ast name: defName))
        {
            onRg: ast.nodes.get i: vnode.nid.u64
            match (
                onRg
            ) case objectdef then {
                (registerGenericParams
                    :st
                    :ast
                    tdecl: tdecl92
                    items: onRg.asItems
                )
            } else null
        }
    }
    ordinalArmNames: (IdSet u64)
    # an ORDINAL variant: every arm written `null`, so nothing distinguishes one
    # value but which arm it is. Recorded for the backend at the end of the loop.
    allNullV: true
    armCountV: u64
    firstArmV: u64
    secondArmV: u64
    kFiter: u64
    for kFiter < vnode.nis loop {
        fmId: (zast.objIsItemAt :ast nid: vnode.nid i: kFiter).u32
        kFiter = kFiter + 1
        fm: argRefAt :ast nid: (zast.nodeid.create from: fmId.u32)
        if (fm.nid.isZero) == false then {
            armCountV = armCountV + 1
            if armCountV == 1 then firstArmV = fm.name.u64
            if armCountV == 2 then secondArmV = fm.name.u64
            {
                anV: (zast.nameTextAt
                    :ast
                    ref: (atomNameId :ast n: (ast.nodes.get i: fm.operation.u64))
                )
                if anV.stringView != "null" then allNullV = false
            }
            if fm.name == zast.names.wkTag then {
                mt: "'tag' is a reserved member name".string
                (addResolveErrorH
                    :st
                    nodeid: fm.nid
                    lineno: fm.lineno
                    colno: fm.colno
                    e: zast.err.reservedMember
                    msg: mt
                    width: 3
                )
            }
            ordinalArmNames.add item: fm.name.u64
            cid: (resolveTyperefShellMarked
                :st
                :frame

                :ast
                :unitDecl
                ownerId: 0
                nid: fm.operation
                thisName: defName
            )
            (st.typing.setMemberType
                parentTypeId: (ztypes.tid.create from: vid.u64)
                nameId: fm.name
                childTypeId: cid
            )
            (recordTyperef
                :st
                :frame

                :ast
                :unitDecl
                thisName: ""
                nid: fm.operation
            )
        }
    }
    # Both arm names of a 2-arm sum, whatever the arms carry and whether or not
    # the type is generic: a template's arms ARE its monos'.
    #
    # Positional: which of these is the FALSY arm is a separate question, asked
    # of the discriminator by ztyping.sumPairZeroArm.
    if armCountV == 2 then {
        st.typing.sumPairFirstArm.set key: vid.u64 value: firstArmV
        st.typing.sumPairSecondArm.set key: vid.u64 value: secondArmV
    }
    if (isgen) == false then {
        (attachVariantTag
            :st
            :ast
            :unitDecl
            :frame
            :defName
            :vnode
            :vid
            :armCountV
            :allNullV
        )
    }
    (attachVariantMethods
        :st
        :ast
        :unitDecl
        :frame
        :defName
        :vnode
        :vid
        :isgen
        :ordinalArmNames
    )
    (synthVariantEqHash
        :st
        :ast
        :vnode
        :vid
        :isgen
        :eqOptV
        :eqAsV
    )
    if pvExcl_vvid.length > 0 then st.typing.privacySeen = true
    applyGrantsPrivate :st parentId: vvid grants: pvGrants_vvid
}

# dottedParentName -- the parent atom name of a `parent.child` dottedpath Node, ""
# for anything else. Matching the Node param narrows it cleanly.
# variantTagIsOrdinalPlain -- the discriminator's VALUES are the arm ordinals
# 0, 1, 2 ... stored in a byte, which is what lets a backend treat the value as
# the ordinal itself. True when the type declares no tag -- the spec's default
# is u8, sequential from 0 -- or declares a numeric tag whose storage is u8.
#
# False for a `data`-sourced tag, whose constants are whatever the data block
# says: `data { LOW: 0  HIGH: 10 }` has two arms and is NOT two ordinals. False
# too for a wider declared numeric, where the author asked for that width. And
# false when the tag base does not resolve, because an unverified shape is not
# one to optimise on.
#
# Found by the `.tag` SUFFIX rather than the member's label: the spec makes the
# label convention only ("commonly tag, but any name is valid").
# variantTagBaseTid -- the NUMERIC type a tagged type's discriminator is stored
# in: the base of a declared `tag: X.tag`, or u8 when none is declared, which is
# the spec's default (§tag: "If no tag is specified, the compiler uses u8 by
# default with sequential values starting from 0"). 0 when the tag is
# `data`-sourced -- its constants are whatever the data block says, so its width
# is that block's business -- or when the base does not resolve.
#
# Recorded so a backend can honour what the declaration asked for. Emitting the
# discriminator as a C `enum` ignores it: an enum is `int`, so `tag: u8.tag`
# silently became four bytes.
variantTagBaseTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    objId: zast.nodeid
} out u64 is {
    # the "no entry" signal, distinct from 0 (a data-sourced tag, whose
    # constants set their own width and whose enum must stay the storage)
    notRecorded: 18446744073709551615.u64
    declared: u64
    sawTag: false
    orf: objRefAt :ast nid: objId
    kIter: u64
    for kIter < orf.nas loop {
        amId: (zast.objAsItemAt :ast nid: objId i: kIter).u32
        kIter = kIter + 1
        am: argRefAt :ast nid: (zast.nodeid.create from: amId.u32)
        if (am.nid.isZero) == false then {
            # the member's operation is read through a view scoped to this
            # block: the lookup below lends ast
            isTagRef: false
            bn: String
            {
                opNode: ast.nodes.get i: am.operation.u64
                match (
                    opNode
                ) case dottedpath then {
                    if (atomNameId
                        :ast
                        n: (ast.nodes.get i: opNode.child.u64)
                    ) == zast.names.wkTag then isTagRef = true
                } else null
                if isTagRef then bn = dottedParentName :ast n: opNode
            }
            if isTagRef then {
                sawTag = true
                if bn.length > 0 then {
                    rr: (walkLookupTyperef
                        :st
                        :frame
                        :ast

                        :unitDecl
                        base: bn.stringView
                    )
                    match (
                        rr
                    ) case some then {
                        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: rr.u64)) == ztypes.ztypetype.dataType then {
                            declared = 0
                        } else {
                            declared = rr
                        }
                    } case none then null
                }
            }
        }
    }
    # NOT RECORDED when nothing is declared: the spec's default is u8, and the
    # backend can spell that without being told. Resolving u8's id here would be
    # a demand made during resolution, which need not be satisfiable yet -- and
    # when it was not, every tagged type silently fell back to the enum.
    if (sawTag) == false then return notRecorded
    return declared
}

variantTagIsOrdinalPlain: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    objId: zast.nodeid
} out bool is {
    result: true
    orf: objRefAt :ast nid: objId
    kIter: u64
    for kIter < orf.nas loop {
        amId: (zast.objAsItemAt :ast nid: objId i: kIter).u32
        kIter = kIter + 1
        am: argRefAt :ast nid: (zast.nodeid.create from: amId.u32)
        if (am.nid.isZero) == false then {
            # the member's operation is read through a view scoped to this
            # block: the lookup below lends ast
            isTagRef: false
            bn: String
            {
                opNode: ast.nodes.get i: am.operation.u64
                match (
                    opNode
                ) case dottedpath then {
                    if (atomNameId
                        :ast
                        n: (ast.nodes.get i: opNode.child.u64)
                    ) == zast.names.wkTag then isTagRef = true
                } else null
                if isTagRef then bn = dottedParentName :ast n: opNode
            }
            if isTagRef then {
                if bn.length == 0 then {
                    result = false
                } else {
                    rr: (walkLookupTyperef
                        :st
                        :frame
                        :ast

                        :unitDecl
                        base: bn.stringView
                    )
                    match (
                        rr
                    ) case some then {
                        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: rr.u64)) == ztypes.ztypetype.dataType then {
                            result = false
                        } else {
                            u8t: builtinTidT :st :frame :ast base: "u8"
                            if u8t.isZero then result = false
                            if (u8t.isZero) == false when rr != u8t.u64 then result = false
                        }
                    } case none then {
                        result = false
                    }
                }
            }
        }
    }
    return result
}

dottedParentName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (dottedParentName :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (atomName :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# dottedTyperefId -- the type id of a cross-unit qualified type ref `unit.Type`
# (e.g. the `zvfs.ProviderBox` element of a `(List of: zvfs.ProviderBox)`),
# resolved through the defining unit's scope. Bare-name visibility covers only
# main+system, so a dep element misses there; this bridges via the unit probe
# plus resolved. 0 when not a dotted ref or unresolved.
dottedTyperefId: function {ast: Ast.view st: zenv.ZSymbolTable op: Node.view} out u64 is {
    match (
        op
    ) case expression then {
        return (dottedTyperefId :ast :st op: (ast.nodes.get i: op.expression.u64))
    } case dottedpath then {
        pnId: atomNameId :ast n: (ast.nodes.get i: op.parent.u64)
        cnId: atomNameId :ast n: (ast.nodes.get i: op.child.u64)
        if (nameDenotesUnit :st frame: st.curFrame nameId: pnId) then {
            uq0z: unitDeclOfName :st nameId: pnId
            ro: (resolvedByIds
                :st
                :ast

                unitDecl: uq0z
                name: cnId
            )
            return (optU64Or o: ro d: 0)
        } else {
            return 0
        }
    } else {
        return 0
    }
}

# unionCustomTagId -- a union's custom DATA tag, if any: an `as { tag: <data>.tag }`
# item whose `<data>` resolves to an in-unit DATA type. Returns that DATA's type id;
# none when absent or not a DATA (the union then synthesizes its own tag wrapper).
# unionCustomTagOfArm -- one as-item of a union: a `tag` member naming a data
# block answers that block's type; a tag whose base resolves later records the
# demand and a pending fixup; anything else answers none.
unionCustomTagOfArm: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    uid: u64
    am: argref
} out optionval u64 is {
    # an owned copy: the walks below lend ast
    nm: zast.nameTextCopy :ast ref: am.name
    if nm.stringView == "tag" then {
        pn: dottedParentName :ast n: (ast.nodes.get i: am.operation.u64)
        if pn.length != 0 then {
            rr: walkLookupTyperef :st :frame :ast :unitDecl base: pn.stringView
            match (
                rr
            ) case some then {
                tt: st.reg.typetypeOf typeId: (ztypes.tid.create from: rr.u64)
                isdata: false
                match (
                    tt
                ) case dataType then {
                    isdata = true
                } else null
                if isdata then {
                    return (optionval.some rr)
                } else {
                    # only the main unit's custom-tag items stamp
                    # (system variants resolve standalone, unstamped).
                    if unitDecl == st.typing.mainUnitRoot then {
                        hUnitDecl: unitDeclOfName :st nameId: (nameIdOf :ast name: "system")
                        tgo: (resolvedByIds
                            :st
                            :ast
                            unitDecl: hUnitDecl
                            name: zast.names.wkTag
                        )
                        match (
                            tgo
                        ) case some then {
                            tnid0: (innermostNodeId
                                :ast
                                n: (ast.nodes.get i: am.operation.u64)
                            )
                            (ztyping.nodeTypeSet
                                tbl: st.typing.nodeType
                                nid: tnid0.u64
                                tid: (ztypes.tid.create from: tgo.u64)
                            )
                        } case none then null
                    }
                }
            } case none then {
                # the tag base resolves later (demand order): record
                # the demand and a pending fixup for the tag child.
                pnId: zast.poolFind pool: ast.names text: pn.stringView
                frame95: (unitFrameOf :st declId: frame)
                (demandDefinition
                    :st
                    frame: frame95
                    nameId: pnId
                )
                uk: uid
                st.typing.pendingCustomTag.set key: uk value: pnId
                uk2: uid
                pnid: innermostNodeId :ast n: (ast.nodes.get i: am.operation.u64)
                pnv: pnid.u64
                st.typing.pendingCustomTagNode.set key: uk2 value: pnv
            }
        }
    }
    return (optionval.none u64)
}

unionCustomTagId: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    uid: u64
    objId: zast.nodeid
} out optionval u64 is {
    orf: objRefAt :ast nid: objId
    kIter: u64
    for kIter < orf.nas loop {
        amId: (zast.objAsItemAt :ast nid: objId i: kIter).u32
        kIter = kIter + 1
        am: argRefAt :ast nid: (zast.nodeid.create from: amId.u32)
        if (am.nid.isZero) == false then {
            r: unionCustomTagOfArm :st :frame :ast :unitDecl :uid :am
            match (
                r
            ) case some then {
                return (optionval.some r)
            } case none then null
        }
    }
    return (optionval.none u64)
}
# checkUnionArmIsReftype -- THE BOX RULE: a union holds reftypes. A null arm carries
# no payload; a MARKED arm (view/borrow/hold) is reference-family whatever it
# points at; a collapsed `(Box T)` arm was already vetted valtype. What remains
# must be a reftype.
checkUnionArmIsReftype: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    fm: argref
    an: StringView
    aname: StringView
    armTe: zast.nodeid
    armMk: bool
    cid: ztypes.tid
} is {
    # THE BOX RULE: a union holds reftypes. A null arm carries no
    # payload; a MARKED arm (view/borrow/hold) is reference-family
    # whatever it points at; a collapsed (Box T) arm was already
    # vetted valtype. What remains must be a reftype.
    if an != "null" when armTe == fm.operation then {
        if (armMk) == false when (typeIsValtype :st tid: cid) then {
            bxv: atomName :ast n: (ast.nodes.get i: armTe.u64)
            mbv: "a union arm holds reftypes; box the valtype: '\{aname}: (Box \{bxv})'"
            (addResolveErrorH
                :st
                nodeid: fm.nid
                lineno: fm.lineno
                colno: fm.colno
                e: zast.err.typeError
                msg: mbv
                width: aname.length.u32.orPanic
            )
        }
    }
}

# attachUnionArm -- resolve one union isItem into an arm: its payload type, the
# ordinal it carries, and the diagnostics an ill-formed arm earns. Answers the
# arm's tid, or 0 for a null (payload-less) arm.
attachUnionArm: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    uid: u64
    defName: StringView
    fm: argref
    ordinalArmNames: (IdSet u64)
} is {
    # an owned copy: the walks below lend ast
    aname: zast.nameTextCopy :ast ref: fm.name
    if fm.name == zast.names.wkTag then {
        mt: "'tag' is a reserved member name".string
        (addResolveErrorH
            :st
            nodeid: fm.nid
            lineno: fm.lineno
            colno: fm.colno
            e: zast.err.reservedMember
            msg: mt
            width: 3
        )
    }
    ordinalArmNames.add item: fm.name.u64
    # an owned copy: the walks below lend ast
    an: zast.nameTextCopy :ast ref: (atomNameId :ast n: (ast.nodes.get i: fm.operation.u64))
    # A `(Box T)` arm collapses to T: the arm child IS the boxed
    # valtype. A union arm is heap-celled whichever family it holds,
    # so the spelling changes no emitted C; it exists so the
    # declaration SAYS the arm boxes a valtype. Only the builtin Box
    # (empty generic class body) collapses; a user class named Box
    # resolves as an ordinary parameterized arm.
    armTe: fm.operation
    armOpId: fm.operation
    armW: true
    for armW loop {
        armW = false
        {
            awn: ast.nodes.get i: armOpId.u64
            match (
                awn
            ) case expression then {
                armOpId = awn.expression
                armW = true
            } else null
        }
    }
    # the arm's call shape is read as plain values: the lookup below lends ast
    isBoxCall: false
    acr: callRefAt :ast nid: armOpId
    if (acr.nid.isZero) == false then {
        bxh: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: acr.callable.u64))
        isBoxCall = bxh.stringView == "Box"
    }
    if isBoxCall then {
        bxt: (optU64Or
            o: (walkLookupTyperef :st :frame :ast :unitDecl base: "Box")
            d: 0)
        isBx: false
        if bxt > 0 then {
            if (st.reg.typetypeOf typeId: (ztypes.tid.create from: bxt.u64)) == ztypes.ztypetype.classType then {
                if (st.typing.declMemberCount ownerTid: (ztypes.tid.create from: bxt.u64)) == 0 then isBx = true
            }
        }
        if isBx then {
            kB: u64
            for kB < acr.nargs loop {
                baId: (zast.callArgAt :ast nid: acr.nid i: kB).u32
                kB = kB + 1
                ba: argRefAt :ast nid: (zast.nodeid.create from: baId.u32)
                if (ba.nid.isZero) == false then {
                    if armTe == fm.operation then armTe = ba.operation
                }
            }
        }
    }
    cid: (resolveTyperefShellMarked
        :st
        :frame

        :ast
        :unitDecl
        ownerId: 0
        nid: armTe
        thisName: defName
    )
    if armTe != fm.operation then {
        if (typeIsValtype :st tid: cid) == false then {
            bxw: atomName :ast n: (ast.nodes.get i: armTe.u64)
            mbx: "'\{bxw}' is already a reftype; a union arm holds it directly -- drop the Box"
            (addResolveErrorH
                :st
                nodeid: fm.nid
                lineno: fm.lineno
                colno: fm.colno
                e: zast.err.typeError
                msg: mbx
                width: aname.length.u32.orPanic
            )
        }
    }
    (st.typing.setMemberType
        parentTypeId: (ztypes.tid.create from: uid.u64)
        nameId: fm.name
        childTypeId: cid
    )
    # An arm's marker is the payload's, not the union's: the shell
    # resolve above strips it, so record it per member the way a class
    # field does. `view` / `hold` are what a match arm reads back.
    alk: pathOwnership :ast n: (ast.nodes.get i: fm.operation.u64)
    armMk: false
    match (
        alk
    ) case some then {
        armMk = true
        (st.typing.setChildOwnership
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: uid.u64)
            name: aname.stringView
            ownership: alk
        )
    } case none then null
    (checkUnionArmIsReftype
        :st
        :ast
        :fm
        an: an.stringView
        aname: aname.stringView
        :armTe
        :armMk
        :cid
    )
    (recordTyperef
        :st
        :frame

        :ast
        :unitDecl
        thisName: ""
        nid: armTe
    )
}
# attachUnionMethods -- a union's asItems are its methods. A name that collides
# with one of its ARM names is rejected here: an arm read and a method call spell
# the same at the use site.
attachUnionMethods: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    vnode: objref
    uid: u64
    isgen: bool
    ordinalArmNames: (IdSet u64).view
} is {
    kAiter: u64
    for kAiter < vnode.nas loop {
        amId: (zast.objAsItemAt :ast nid: vnode.nid i: kAiter).u32
        kAiter = kAiter + 1
        am: argRefAt :ast nid: (zast.nodeid.create from: amId.u32)
        if (am.nid.isZero) == false then {
            # an owned copy: the walks below lend ast
            mname: zast.nameTextCopy :ast ref: am.name
            ownerNmId: nameIdOf :ast name: defName
            mido: (resolveMethodFnLazy
                :st
                :frame

                :ast
                :unitDecl
                ownerNameId: ownerNmId
                mname: mname.stringView
                thisName: defName
                opId: am.operation
                lazyOk: (isgen) == false
            )
            match (
                mido
            ) case some then {
                if (ordinalArmNames.has item: am.name.u64) then {
                    mc: "'\{mname}' collides with the '\{defName}' arm of the same name"
                    (addResolveErrorH
                        :st
                        nodeid: am.nid
                        lineno: am.lineno
                        colno: am.colno
                        e: zast.err.duplicateDef
                        msg: mc
                        width: mname.length.u32.orPanic
                    )
                } else if mname.stringView == "tag" then {
                    mr: "'tag' is a reserved member name".string
                    (addResolveErrorH
                        :st
                        nodeid: am.nid
                        lineno: am.lineno
                        colno: am.colno
                        e: zast.err.reservedMember
                        msg: mr
                        width: 3
                    )
                } else {
                    (st.typing.setMemberType
                        parentTypeId: (ztypes.tid.create from: uid.u64)
                        nameId: am.name
                        childTypeId: mido
                    )
                }
            } else {
                if (isgen) == false then {
                    (detectTagAccessor
                        :st
                        :frame

                        :ast
                        :unitDecl
                        :defName
                        ownerId: uid
                        armNames: ordinalArmNames
                        :am
                    )
                }
            }
        }
    }
}

# resolveUnion -- resolve a union ObjectDef into a UNION reference type: a child
# per arm (arm name -> payload type-ref shell; a `null` arm -> the `null` shell),
# a synthesized `tag` child (the `{name}:tag:data` discriminator wrapper), then any
# as-block methods. Unions are reference types (is_valtype false); they have no
# `create` (bare construction is disabled) and no `==`/`!=`. A union keeps a
# destructor unless every arm is `null` (Priority elides it; IntResult/Result/Typed
# keep it). A custom DATA tag (`as { tag: <data>.tag }`) becomes the `tag` child in
# place of the synth wrapper; generics arrive later.
resolveUnion: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    vnode: objref
} is {
    uid: (declareCanonicalType
        :st
        :frame
        :ast

        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.unionType
    )
    uuid: uid
    pvExcl_uuid: (ListVal u64)
    pvGrants_uuid: (ListVal u64)
    scanVisibility :st :ast onode: vnode excl: pvExcl_uuid grants: pvGrants_uuid
    st.reg.setValtype typeId: (ztypes.tid.create from: uid.u64) value: false
    isgen: false
    {
        onIsgen: ast.nodes.get i: vnode.nid.u64
        match (
            onIsgen
        ) case objectdef then {
            isgen = hasGenericParam :ast items: onIsgen.asItems
        } else null
    }
    if isgen then {
        st.reg.setGeneric typeId: (ztypes.tid.create from: uid.u64) value: true
        tdecl93: (declOfUnitDef :st :frame :unitDecl nameId: (nameIdOf :ast name: defName))
        {
            onRg: ast.nodes.get i: vnode.nid.u64
            match (
                onRg
            ) case objectdef then {
                (registerGenericParams
                    :st
                    :ast
                    tdecl: tdecl93
                    items: onRg.asItems
                )
            } else null
        }
    }
    allNull: true
    armCountU: u64
    firstArmU: u64
    secondArmU: u64
    ordinalArmNames: (IdSet u64)
    kFiter: u64
    for kFiter < vnode.nis loop {
        fmId: (zast.objIsItemAt :ast nid: vnode.nid i: kFiter).u32
        kFiter = kFiter + 1
        fm: argRefAt :ast nid: (zast.nodeid.create from: fmId.u32)
        if (fm.nid.isZero) == false then {
            armCountU = armCountU + 1
            if armCountU == 1 then firstArmU = fm.name.u64
            if armCountU == 2 then secondArmU = fm.name.u64
            # an owned copy: the walks below lend ast
            anU: (zast.nameTextCopy
                :ast
                ref: (atomNameId :ast n: (ast.nodes.get i: fm.operation.u64))
            )
            if anU.stringView != "null" then allNull = false
            (attachUnionArm
                :st
                :ast
                :unitDecl
                :frame
                :uid
                :defName
                :fm
                :ordinalArmNames
            )
        }
    }
    # both arm names of a 2-arm sum -- the union half of the same record the
    # variant resolver writes. Option and Result are the reason it exists.
    if armCountU == 2 then {
        st.typing.sumPairFirstArm.set key: uid.u64 value: firstArmU
        st.typing.sumPairSecondArm.set key: uid.u64 value: secondArmU
    }
    if (isgen) == false then {
        # the discriminator's declared storage, so a backend can honour it
        {
            tbU: (variantTagBaseTid
                :st
                :frame
                :ast

                :unitDecl
                objId: vnode.nid
            )
            if tbU != 18446744073709551615.u64 then (st.typing.variantTagBase.set
                key: uid.u64
                value: tbU
            )
        }
        customTag: unionCustomTagId :st :frame :ast :unitDecl :uid objId: vnode.nid
        tagId: u64
        match (
            customTag
        ) case some then {
            tagId = customTag
        } case none then {
            tagName: "\{defName}:tag:data"
            tagId = st.reg.newType name: tagName.stringView typetype: ztypes.ztypetype.dataType
        }
        (st.typing.declSynthMember
            parentTypeId: (ztypes.tid.create from: uid.u64)
            nameId: zast.names.wkTag
            kind: ztyping.declkind.fieldDecl
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: uid.u64)
            nameId: zast.names.wkTag
            childTypeId: tagId
        )
    }
    (attachUnionMethods
        :st
        :ast
        :unitDecl
        :frame
        :defName
        :vnode
        :uid
        :isgen
        :ordinalArmNames
    )
    if (allNull) == false then {
        st.reg.setNeedsDestructor typeId: (ztypes.tid.create from: uid.u64)
    }
    if pvExcl_uuid.length > 0 then st.typing.privacySeen = true
    applyGrantsPrivate :st parentId: uuid grants: pvGrants_uuid
}

# fieldTypeNeedsCleanup -- true when a class field needs cleanup (so the holder keeps
# a destructor): a `.lock` field (its borrow is released at scope exit), a native heap
# type (String/List/Map/Set), or an in-unit type that itself HAS a destructor
# (`st.reg.needsDestructor`). A scalar field, or an owned class/union field whose type
# has no destructor, needs none. Name check for the natives is a scaffold-stage
# approximation (system types carry no real id under resolve-only-main).
fieldTypeNeedsCleanup: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    name: StringView
    isLock: bool
} out bool is {
    if isLock then return true
    if name == "String" then return true
    if name == "List" then return true
    if name == "ListRef" then return true
    if name == "ListVal" then return true
    if name == "Map" then return true
    if name == "MapRR" then return true
    if name == "MapRV" then return true
    if name == "MapVR" then return true
    if name == "MapVV" then return true
    if name == "Set" then return true
    if name == "SetRef" then return true
    if name == "SetVal" then return true
    # the id-keyed containers own two heap arrays each. A Map field is a heap
    # POINTER whose destroy the holder calls; these are stack structs, so the
    # holder must free them in place -- and without a cleanup mark the holder
    # gets no destructor at all and the arrays leak.
    if name == "IdMapR" then return true
    if name == "IdMapV" then return true
    if name == "IdSet" then return true
    if name == "Option" then return true
    if name == "Result" then return true
    duo8: (definingSiteFor :st :frame :ast :unitDecl :name).defUnit
    if (duo8.isZero) == false then {
        tto8: (optionval.none ztypes.ztypetype)
        {
            dd8: declOfUnitDef :st :frame unitDecl: duo8 nameId: (nameIdOf :ast :name)
            if dd8 > 0 then tto8 = declDefTypetype :st :ast declId: dd8
        }
        match (
            tto8
        ) case some then {
            boxed8: false
            if tto8 == ztypes.ztypetype.classType then boxed8 = true
            if tto8 == ztypes.ztypetype.unionType then boxed8 = true
            if boxed8 then {
                if (st.typing.declIsResolving
                    declId: (declOfUnitDef :st :frame unitDecl: duo8 nameId: (nameIdOf :ast :name))
                ) then return true
            }
        } case none then null
        descendNamed :st :frame :ast unitDecl: duo8 :name
    }
    # key by the DEFINING unit: a bare cross-unit field type (Bytes from
    # collections) resolves under its own unit, not the class's
    ku8: unitNameIdOf :st :unitDecl
    if (duo8.isZero) == false then ku8 = unitNameIdOf :st unitDecl: duo8
    unitDecl9: (unitDeclOfName :st nameId: ku8)
    rr: (resolvedByIds
        :st
        :ast
        unitDecl: unitDecl9
        name: (nameIdOf :ast :name)
    )
    match (
        rr
    ) case some then {
        return (st.reg.needsDestructor typeId: (ztypes.tid.create from: rr.u64))
    } case none then {
        return false
    }
}
# resolveClassMethodDecl -- resolve a method declared in a class's `is` block:
# its signature, and the member entry that makes it reachable from the type.
resolveClassMethodDecl: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    cid: u64
    isgen: bool
    fm: argref
} is {
    if (isFunctionDefOp op: (ast.nodes.get i: fm.operation.u64)) then {
        # an owned copy: the walks below lend ast
        fname: zast.nameTextCopy :ast ref: fm.name
        prodM4: false
        if (isgen) == false then {
            prodM4 = true
        } else {
            if (functiondefIsNative op: (ast.nodes.get i: fm.operation.u64)) == false then {
                prodM4 = true
            } else {
                # Flipped collection families resolve their native
                # method decls like user template methods. create is
                # special-cased; length/capacity stay field children
                # (their C surface is a struct read, not a method).
                if unitDecl == st.typing.collectionsUnitRoot then {
                    prodSkipL: false
                    if fm.name == zast.names.wkCreate then prodSkipL = true
                    if fm.name == zast.names.wkLength then prodSkipL = true
                    if fm.name == zast.names.wkCapacity then prodSkipL = true
                    if (prodSkipL) == false then prodM4 = true
                }
            }
        }
        if prodM4 then {
            ownerNmId: nameIdOf :ast name: defName
            mido: (resolveMethodFnLazy
                :st
                :frame

                :ast
                :unitDecl
                ownerNameId: ownerNmId
                mname: fname.stringView
                thisName: defName
                opId: fm.operation
                lazyOk: (isgen) == false
            )
            match (
                mido
            ) case some then {
                (st.typing.setMemberType
                    parentTypeId: (ztypes.tid.create from: cid.u64)
                    nameId: fm.name
                    childTypeId: mido
                )
                if isgen then (st.reg.setGeneric
                    typeId: (ztypes.tid.create from: mido.u64)
                    value: true
                )
                if (fnFieldFlaggableName name: fname.stringView) then {
                    (st.typing.setChildFnptrField
                        pool: ast.names
                        parentTypeId: (ztypes.tid.create from: cid.u64)
                        name: fname.stringView
                    )
                }
            } case none then null
        }
    }
}
# recordFieldDefault -- record the default a field declares: a numeric literal
# folds to the field's own type, a named one waits for the type it references
# to resolve, and a marker-suffixed one is not a default at all.
recordFieldDefault: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    frame: ztypes.declid
    cid: u64
    cidf: ztypes.tid
    fname: StringView
    fm: argref
} is {
    dcn0: (zast.nameTextAt
        :ast
        ref: (dottedChildNameId :ast n: (ast.nodes.get i: fm.operation.u64))
    )
    rdnc: (zast.nameTextAt
        :ast
        ref: (rootNameIdOf :ast n: (ast.nodes.get i: fm.operation.u64))
    )
    if (isNumericLiteralName name: rdnc.stringView) then {
        (st.typing.setDefaultLiteral
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: cid.u64)
            name: fname
            node: fm.operation
        )
    } else {
        if dcn0.length > 0 when (isStripMarker name: dcn0.stringView) == false when (nameDenotesUnit
            :st
            :frame

            nameId: (nameIdOf
            :ast
            name: rdnc.stringView
        )
        ) == false then {
            cArmNid: zast.poolFind pool: ast.names text: dcn0.stringView
            cArmDecl: (st.typing.declMemberIdOf
                parentTypeId: cidf
                nameId: cArmNid
            )
            (st.typing.setDefaultVariantArm
                pool: ast.names
                parentTypeId: (ztypes.tid.create from: cid.u64)
                name: fname
                targetDecl: cArmDecl
            )
        }
    }
    if dcn0.length > 0 when (isStripMarker name: dcn0.stringView) then {} else {
        if dcn0.length > 0 then {
            rdk: nodeId n: (ast.nodes.get i: fm.operation.u64)
            rdo: cid
            st.typing.pendingDefaultOwner.set key: rdk.u64 value: rdo
            rdk2: nodeId n: (ast.nodes.get i: fm.operation.u64)
            rdn: rootNameIdOf :ast n: (ast.nodes.get i: fm.operation.u64)
            st.typing.pendingDefaultName.set key: rdk2.u64 value: rdn
        }
    }
}

# resolveNamedFieldSlot -- resolve an ordinary named field: its declared type,
# its ownership and visibility, the default it carries, and whether owning it
# gives the class a destructor. True when it does.
resolveNamedFieldSlot: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    cid: u64
    fname: StringView
    ftn: StringView
    lockField: bool
    fm: argref
} out bool is {
    needsDtor: false
    fieldLock: pathOwnership :ast n: (ast.nodes.get i: fm.operation.u64)
    if fname != "_resume_input" then {
        if (fieldTypeNeedsCleanup
            :st
            :frame

            :ast
            :unitDecl
            name: ftn
            isLock: lockField
        ) then needsDtor = true
    }
    cidf: (resolveTyperefShellMarked
        :st
        :frame

        :ast
        :unitDecl
        ownerId: cid
        nid: fm.operation
        thisName: defName
    )
    (st.typing.setMemberType
        parentTypeId: (ztypes.tid.create from: cid.u64)
        nameId: fm.name
        childTypeId: cidf
    )
    if (st.reg.typetypeOf typeId: cidf) == ztypes.ztypetype.functionType then {
        (st.typing.setChildFnptrField
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: cid.u64)
            name: fname
        )
    }
    if lockField then {
        (st.typing.setChildLockField
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: cid.u64)
            name: fname
        )
    }
    match (
        fieldLock
    ) case some then {
        (st.typing.setChildOwnership
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: cid.u64)
            name: fname
            ownership: fieldLock
        )
    } case none then null
    (recordTyperef
        :st
        :frame

        :ast
        :unitDecl
        thisName: ""
        nid: fm.operation
    )
    recordFieldDefault :st :ast :frame :cid :cidf :fname :fm
    return needsDtor
}

# resolveClassFieldSlot -- resolve a field that is not a reference to an
# already-declared member: its declared type, its default, and whether owning
# it gives the class a destructor. True when it does.
resolveClassFieldSlot: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    cid: u64
    fname: StringView
    ftn: StringView
    lockField: bool
    fm: argref
} out bool is {
    needsDtor: false
    if (isTypedefField :ast n: (ast.nodes.get i: fm.operation.u64)) then {
        # No field child for the wrapper, but the inner refs
        # (the u8 in `(List of: u8).typedef`) still stamp.
        (recordTyperef
            :st
            :frame

            :ast
            :unitDecl
            thisName: ""
            nid: fm.operation
        )
    } else {
        if (resolveNamedFieldSlot
            :st
            :ast
            :unitDecl
            :frame
            :defName
            :cid
            :fname
            :ftn
            :lockField
            :fm
        ) then needsDtor = true
    }
    return needsDtor
}
# recordMemberRefField -- record a field declared as a reference to a member
# that already exists: it takes that member's type, and a function-typed one
# becomes a function-pointer slot.
recordMemberRefField: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    cid: u64
    fname: StringView
    mref: u64
    lockField: bool
    fm: argref
} is {
    fieldLock: pathOwnership :ast n: (ast.nodes.get i: fm.operation.u64)
    (st.typing.setMemberType
        parentTypeId: (ztypes.tid.create from: cid.u64)
        nameId: fm.name
        childTypeId: mref
    )
    if (st.reg.typetypeOf typeId: (ztypes.tid.create from: mref.u64)) == ztypes.ztypetype.functionType then {
        (st.typing.setChildFnptrField
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: cid.u64)
            name: fname
        )
    }
    if lockField then (st.typing.setChildLockField
        pool: ast.names
        parentTypeId: (ztypes.tid.create from: cid.u64)
        name: fname
    )
    match (
        fieldLock
    ) case some then {
        (st.typing.setChildOwnership
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: cid.u64)
            name: fname
            ownership: fieldLock
        )
    } case none then null
    # a sibling-member ref default: the construction fill
    # stamps the default's node with the member's type.
    pdk: nodeId n: (ast.nodes.get i: fm.operation.u64)
    pdo: cid
    st.typing.pendingDefaultOwner.set key: pdk.u64 value: pdo
    pdk2: nodeId n: (ast.nodes.get i: fm.operation.u64)
    pdi: mref
    st.typing.pendingDefaultId.set key: pdk2.u64 value: pdi
}

# resolveClassFieldEntry -- resolve a class member that is not a method: a
# reference to an already-declared member, or a field slot of its own. True
# when owning it gives the class a destructor.
resolveClassFieldEntry: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    cid: u64
    fm: argref
} out bool is {
    needsDtor: false
    # an owned copy: the walks below lend ast
    fname: zast.nameTextCopy :ast ref: fm.name
    ftn: fieldHeadName :ast n: (ast.nodes.get i: fm.operation.u64)
    # A NON-OWNED field marker (lock / borrow / view) makes the
    # slot static: it is set in the constructor, never reassigned,
    # the constructor locks the caller's argument rather than
    # taking it, and the field holds no destructor. An OWNED one
    # (take / hold) is an ordinary field on all three counts --
    # `hold` freezes the contents, not the slot.
    lockField: false
    fieldLock: pathOwnership :ast n: (ast.nodes.get i: fm.operation.u64)
    match (
        fieldLock
    ) case some then {
        # This test is INVERTED: anything not named here becomes a
        # lock field, so a new owned mode must be listed or it is
        # silently treated as non-owned.
        fOwned: false
        if fieldLock == ztypes.zparamownership.takeMode then fOwned = true
        if fieldLock == ztypes.zparamownership.holdMode then fOwned = true
        if fieldLock == ztypes.zparamownership.takexMode then fOwned = true
        if fOwned == false then lockField = true
    } case none then null
    hNameId: zast.poolFind pool: ast.names text: ftn.stringView
    (forceMemberOf
        :st
        :frame

        :ast
        parentTypeId: (ztypes.tid.create from: cid.u64)
        nameId: hNameId
    )
    mref: (resolvedByIdsMember
        :st
        :ast
        :unitDecl
        defId: (zast.poolFind pool: ast.names text: defName)
        memberId: (zast.poolFind pool: ast.names text: ftn.stringView)
    )
    match (
        mref
    ) case some then {
        (recordMemberRefField :st :ast :cid fname: fname.stringView :mref :lockField :fm)
    } case none then {
        if (resolveClassFieldSlot
            :st
            :ast
            :unitDecl
            :frame
            :defName
            :cid
            fname: fname.stringView
            ftn: ftn.stringView
            :lockField
            :fm
        ) then needsDtor = true
    }
    return needsDtor
}

# resolveClassField -- resolve one field of a class: its declared type, its
# default, its visibility, and whether owning it makes the class need a
# destructor. True when this field does.
resolveClassField: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    cid: u64
    isgen: bool
    fmId: u32
} out bool is {
    needsDtor: false
    fm: argRefAt :ast nid: (zast.nodeid.create from: fmId.u32)
    if (fm.nid.isZero) == false then {
        if (isFunctionDefOp op: (ast.nodes.get i: fm.operation.u64)) then {
            (resolveClassMethodDecl
                :st
                :ast
                :unitDecl
                :frame
                :defName
                :cid
                :isgen
                :fm
            )
        } else {
            if (resolveClassFieldEntry
                :st
                :ast
                :unitDecl
                :frame
                :defName
                :cid
                :fm
            ) then needsDtor = true
        }
    }
    return needsDtor
}
# resolveClassAsMethods -- resolve the methods a class declares in its `as`
# block: each signature, and the member entry that makes it reachable from the
# type. Native declarations in a generic collection family resolve like a
# user template's, which is why the walk asks the unit and not the name.
resolveClassAsMethods: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    cid: u64
    isgen: bool
    cnode: objref
} is {
    kAiterP4: u64
    for kAiterP4 < cnode.nas loop {
        amP4Id: (zast.objAsItemAt :ast nid: cnode.nid i: kAiterP4).u32
        kAiterP4 = kAiterP4 + 1
        amP4: argRefAt :ast nid: (zast.nodeid.create from: amP4Id.u32)
        if (amP4.nid.isZero) == false then {
            if (isFunctionDefOp op: (ast.nodes.get i: amP4.operation.u64)) then {
                # an owned copy: the walks below lend ast
                afnP4: zast.nameTextCopy :ast ref: amP4.name
                prodA4: false
                fnNativeP4: functiondefIsNative op: (ast.nodes.get i: amP4.operation.u64)
                if isgen then {
                    if fnNativeP4 then {
                        if unitDecl == st.typing.collectionsUnitRoot then {
                            skipA4: false
                            if amP4.name == zast.names.wkCreate then skipA4 = true
                            if amP4.name == zast.names.wkLength then skipA4 = true
                            if amP4.name == zast.names.wkCapacity then skipA4 = true
                            if (skipA4) == false then prodA4 = true
                        }
                    } else {
                        prodA4 = true
                    }
                }
                if prodA4 then {
                    ownerNmId: nameIdOf :ast name: defName
                    amidP4: (resolveMethodFn
                        :st
                        :frame

                        :ast
                        :unitDecl
                        ownerNameId: ownerNmId
                        mname: afnP4.stringView
                        thisName: defName
                        opId: amP4.operation
                    )
                    match (
                        amidP4
                    ) case some then {
                        (st.typing.setMemberType
                            parentTypeId: (ztypes.tid.create from: cid.u64)
                            nameId: amP4.name
                            childTypeId: amidP4
                        )
                        st.reg.setGeneric typeId: (ztypes.tid.create from: amidP4.u64) value: true
                        if (fnFieldFlaggableName name: afnP4.stringView) then {
                            (st.typing.setChildFnptrField
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: cid.u64)
                                name: afnP4.stringView
                            )
                        }
                    } case none then null
                }
            }
        }
    }
}
# resolveClassCreate -- give a class its constructor surface: the declared
# `create`, or the synthesised field-wise one when it declares none, and the
# typedef wrapper's pass-through when the class is one.
resolveClassCreate: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    cid: u64
    isgen: bool
    istd: bool
    cnode: objref
} out bool is {
    needsDtor: false
    hasCreate: false
    if (isgen) == false then {
        hcAs: (attachMethods
            :st
            :frame

            :ast
            :unitDecl
            :defName
            parentId: (ztypes.tid.create from: cid.u64)
            objId: cnode.nid
        )
        if hcAs then hasCreate = true
        mNeedsDtor: (attachMarkers
            :st
            :frame

            :ast
            :unitDecl
            parentId: cid
            objId: cnode.nid
        )
        if mNeedsDtor then needsDtor = true
    }
    if (hasCreate) == false then {
        if (isgen) == false then {
            createId: (st.reg.newType
                name: "create"
                ownerTid: cid
                typetype: ztypes.ztypetype.functionType
            )
            (st.typing.declSynthMember
                parentTypeId: (ztypes.tid.create from: cid.u64)
                nameId: zast.names.wkCreate
                kind: ztyping.declkind.methodDecl
            )
            (st.typing.setMemberType
                parentTypeId: (ztypes.tid.create from: cid.u64)
                nameId: zast.names.wkCreate
                childTypeId: createId
            )
            materializeCreateParams :st :frame :ast typeTid: cid :createId
        }
    }
    if istd then {
        borrowId: (st.reg.newType
            name: "borrow"
            ownerTid: cid
            typetype: ztypes.ztypetype.functionType
        )
        (st.typing.declSynthMember
            parentTypeId: (ztypes.tid.create from: cid.u64)
            nameId: zast.names.wkBorrow
            kind: ztyping.declkind.methodDecl
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: cid.u64)
            nameId: zast.names.wkBorrow
            childTypeId: borrowId
        )
    }
    return needsDtor
}
# resolveClassTypedefBase -- record the base a typedef class wraps: its name id
# and its type, and whether the wrapper inherits the base's destructor. True
# when it does.
resolveClassTypedefBase: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    cid: u64
    cnode: objref
} out bool is {
    needsDtor: false
    tdbase: objectTypedefBaseId :ast onode: cnode
    # an owned copy: the walks below lend ast
    tdbaseT: zast.nameTextCopy :ast ref: tdbase
    if (fieldTypeNeedsCleanup
        :st
        :frame

        :ast
        :unitDecl
        name: tdbaseT.stringView
        isLock: false
    ) then needsDtor = true
    if (tdbase.isZero) == false then {
        tdk3: cid
        st.typing.typedefBaseName.set key: tdk3 value: tdbase
    }
    tdt3: objectTypedefBaseTid :st :frame :ast :unitDecl onode: cnode
    if tdt3 > 0 then {
        tdk6: cid
        (st.typing.typedefBaseTid.set
            key: (ztypes.tid.create from: tdk6.u64)
            value: (ztypes.tid.create from: tdt3.u64)
        )
    }
    return needsDtor
}

# resolveClass -- resolve a class ObjectDef into a CLASS reference type: a child per
# field (field name -> type-ref shell), a child per as-block method, then a synthesized
# `create` child (LAST). Classes are reference types (is_valtype false); they get
# `create` but NO `==`/`!=` (unlike records). A class keeps a destructor when any field
# owns heap data (fieldTypeNeedsCleanup), else none. A typedef class (single
# `X.typedef` field) gets no field child, synth `create`+`borrow`, and inherits
# needs_destructor from the wrapped base (List -> yes, ListView -> no). Custom /
# `null` create, generics + protocols come later.
# finishClassDef -- the class walk's tail: the as-block methods, the create
# path (which may require a destructor), the destructor flag, and the privacy
# exclusions and grants.
finishClassDef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    cid: u64
    ccid: u64
    isgen: bool
    istd: bool
    cnode: objref
    needsDtorIn: bool
    pvExcl: (ListVal u64).view
    pvGrants: (ListVal u64).view
} is {
    needsDtor: needsDtorIn
    (resolveClassAsMethods :st :ast :unitDecl :frame :defName :cid :isgen :cnode)
    if (resolveClassCreate
        :st
        :ast
        :unitDecl
        :frame
        :defName
        :cid
        :isgen
        :istd
        :cnode
    ) then needsDtor = true
    if defName == "String" then needsDtor = true
    if needsDtor then {
        st.reg.setNeedsDestructor typeId: (ztypes.tid.create from: cid.u64)
    }
    if pvExcl.length > 0 then st.typing.privacySeen = true
    applyGrantsPrivate :st parentId: ccid grants: pvGrants
}

resolveClass: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    cnode: objref
} is {
    cid: (declareCanonicalType
        :st
        :frame
        :ast

        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.classType
    )
    ccid: cid
    # `class is native` on the TYPE: the runtime supplies the layout and every
    # method, so routing can ask the declaration whether a type is
    # runtime-backed instead of comparing its unit's name. Mirrors
    # resolveFunction, which has always written the function-path flag.
    st.reg.setNative typeId: (ztypes.tid.create from: cid.u64) value: cnode.isNative
    pvExcl_ccid: (ListVal u64)
    pvGrants_ccid: (ListVal u64)
    scanVisibility :st :ast onode: cnode excl: pvExcl_ccid grants: pvGrants_ccid
    st.reg.setValtype typeId: (ztypes.tid.create from: cid.u64) value: false
    needsDtor: false
    isgen: false
    {
        onIsgen: ast.nodes.get i: cnode.nid.u64
        match (
            onIsgen
        ) case objectdef then {
            isgen = hasGenericParam :ast items: onIsgen.asItems
        } else null
    }
    if isgen then {
        st.reg.setGeneric typeId: (ztypes.tid.create from: cid.u64) value: true
        tdecl94: (declOfUnitDef :st :frame :unitDecl nameId: (nameIdOf :ast name: defName))
        {
            onRg: ast.nodes.get i: cnode.nid.u64
            match (
                onRg
            ) case objectdef then {
                (registerGenericParams
                    :st
                    :ast
                    tdecl: tdecl94
                    items: onRg.asItems
                )
            } else null
        }
    }
    istd: recordIsTypedef :ast rnode: cnode
    if istd then {
        if (resolveClassTypedefBase :st :ast :unitDecl :frame :cid :cnode) then needsDtor = true
    }
    kFiter: u64
    for kFiter < cnode.nis loop {
        fmId: (zast.objIsItemAt :ast nid: cnode.nid i: kFiter).u32
        kFiter = kFiter + 1
        if (resolveClassField :st :ast :unitDecl :frame :defName :cid :isgen :fmId) then {
            needsDtor = true
        }
    }
    # Flipped iterator families: their only method decl (`call`) lives in
    # the as-block; produce it like the isItems loop does. attachMethods
    # stays non-generic-only (it also handles const-clone members and
    # generator synthesis, which native decls never need).
    (finishClassDef
        :st
        :ast
        :unitDecl
        :frame
        :defName
        :cid
        :ccid
        :isgen
        :istd
        :cnode
        needsDtorIn: needsDtor
        pvExcl: pvExcl_ccid
        pvGrants: pvGrants_ccid
    )
}

# resolveFacet -- resolve a facet ObjectDef into a FACET valtype: a child per
# is-block spec method (the `:this` receiver dropped), then synthesized `create` +
# `borrow` FUNCTION shells (JOIN-only, no own row). Facets are value types
# (is_valtype true), no destructor, no `==`/`!=`. Generic facets arrive later.
resolveFacet: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    fnode: objref
} is {
    fid: (declareCanonicalType
        :st
        :frame
        :ast

        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.facetType
    )
    ffid: fid
    pvExcl_ffid: (ListVal u64)
    pvGrants_ffid: (ListVal u64)
    scanVisibility :st :ast onode: fnode excl: pvExcl_ffid grants: pvGrants_ffid
    st.reg.setValtype typeId: (ztypes.tid.create from: fid.u64) value: true
    isgen: false
    {
        onIsgen: ast.nodes.get i: fnode.nid.u64
        match (
            onIsgen
        ) case objectdef then {
            isgen = hasGenericParam :ast items: onIsgen.isItems
        } else null
    }
    if isgen then st.reg.setGeneric typeId: (ztypes.tid.create from: fid.u64) value: true
    # `type` INSIDE AN INTERFACE IS THE INTERFACE. It used to be the first
    # recorded CONFORMER, which made a spec member's parameter concrete: the
    # vtable slot came out typed `bool (*op_eq)(void*, pt)` and there was no
    # uniform signature to emit at all once a second type conformed. Which
    # conformer won depended on which one the unit's `main` happened to
    # mention first, so the layout of an interface depended on source order.
    #
    # A member that mentions it is not part of the dispatchable surface -- the
    # emitters omit its slot and the checker refuses the call -- but that is a
    # decision about the MEMBER, taken where the member is used, rather than a
    # rewriting of what its type means.
    specThisStr: defName.string
    dropThis: true
    kSiter: u64
    for kSiter < fnode.nis loop {
        smId: (zast.objIsItemAt :ast nid: fnode.nid i: kSiter).u32
        kSiter = kSiter + 1
        sm: argRefAt :ast nid: (zast.nodeid.create from: smId.u32)
        if (sm.nid.isZero) == false then {
            # an owned copy: the walks below lend ast
            mname: zast.nameTextCopy :ast ref: sm.name
            ownerNmId: nameIdOf :ast name: defName
            sido: (resolveSpecFn
                :st
                :frame

                :ast
                :unitDecl
                ownerNameId: ownerNmId
                mname: mname.stringView
                thisName: specThisStr.stringView
                opId: sm.operation
                skipThis: dropThis
            )
            match (
                sido
            ) case some then {
                (st.typing.setMemberType
                    parentTypeId: (ztypes.tid.create from: fid.u64)
                    nameId: sm.name
                    childTypeId: sido
                )
            } else null
        }
    }
    if (isgen) == false then {
        createId: (st.reg.newType
            name: "create"
            ownerTid: fid
            typetype: ztypes.ztypetype.functionType
        )
        (st.typing.declSynthMember
            parentTypeId: (ztypes.tid.create from: fid.u64)
            nameId: zast.names.wkCreate
            kind: ztyping.declkind.methodDecl
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: fid.u64)
            nameId: zast.names.wkCreate
            childTypeId: createId
        )
        borrowId: (st.reg.newType
            name: "borrow"
            ownerTid: fid
            typetype: ztypes.ztypetype.functionType
        )
        (st.typing.declSynthMember
            parentTypeId: (ztypes.tid.create from: fid.u64)
            nameId: zast.names.wkBorrow
            kind: ztyping.declkind.methodDecl
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: fid.u64)
            nameId: zast.names.wkBorrow
            childTypeId: borrowId
        )
    }
    if pvExcl_ffid.length > 0 then st.typing.privacySeen = true
    applyGrantsPrivate :st parentId: ffid grants: pvGrants_ffid
}

# resolveProtocol -- resolve a protocol ObjectDef into a PROTOCOL reftype: a child
# per is-block spec method (the `:this` receiver dropped), then synth `create` +
# `borrow` FUNCTION shells, then an unconditional destructor (a protocol wraps heap
# data). Reference type (is_valtype false), no `==`/`!=`. A generic protocol
# registers its parameters -- they sit in the IS block, not an `as` block -- so a
# spec member typed by one resolves as the parameter.
resolveProtocol: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    fnode: objref
} is {
    pid: (declareCanonicalType
        :st
        :frame
        :ast

        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.protocolType
    )
    ppid: pid
    pvExcl_ppid: (ListVal u64)
    pvGrants_ppid: (ListVal u64)
    scanVisibility :st :ast onode: fnode excl: pvExcl_ppid grants: pvGrants_ppid
    st.reg.setValtype typeId: (ztypes.tid.create from: pid.u64) value: false
    isgen: false
    {
        onIsgen: ast.nodes.get i: fnode.nid.u64
        match (
            onIsgen
        ) case objectdef then {
            isgen = hasGenericParam :ast items: onIsgen.isItems
        } else null
    }
    if isgen then {
        st.reg.setGeneric typeId: (ztypes.tid.create from: pid.u64) value: true
        # a generic protocol declares its parameters in the IS block, beside the
        # spec methods, where every other declaring kind uses `as`. Nothing
        # registered them, so isGenericParamOf answered false for a protocol and
        # a spec member typed by one was resolved as an ordinary value.
        tdeclP: (declOfUnitDef :st :frame :unitDecl nameId: (nameIdOf :ast name: defName))
        {
            onRgP: ast.nodes.get i: fnode.nid.u64
            match (
                onRgP
            ) case objectdef then {
                registerGenericParams :st :ast tdecl: tdeclP items: onRgP.isItems
            } else null
        }
    }
    # A protocol spec receiver is normally dropped (resolves to nothing). The reference
    # resolves Text NESTED inside String's `:Text` marker, so Text's spec `:this` binds
    # to the enclosing String -- mirror that for the system Text protocol.
    specThisStr: defName.string
    dropThis: true
    if unitDecl == st.typing.systemUnitRoot then {
        if defName == "Text" then {
            specThisStr = "String".string
            dropThis = false
        }
    }
    # `type` inside a protocol is the protocol, for the reason resolveFacet
    # states at length. `Text` keeps its exception: it is the one interface the
    # system unit declares whose spec receiver IS a concrete type.
    kSiter: u64
    for kSiter < fnode.nis loop {
        smId: (zast.objIsItemAt :ast nid: fnode.nid i: kSiter).u32
        kSiter = kSiter + 1
        sm: argRefAt :ast nid: (zast.nodeid.create from: smId.u32)
        if (sm.nid.isZero) == false then {
            # an owned copy: the walks below lend ast
            mname: zast.nameTextCopy :ast ref: sm.name
            ownerNmId: nameIdOf :ast name: defName
            sido: (resolveSpecFn
                :st
                :frame

                :ast
                :unitDecl
                ownerNameId: ownerNmId
                mname: mname.stringView
                thisName: specThisStr.stringView
                opId: sm.operation
                skipThis: dropThis
            )
            match (
                sido
            ) case some then {
                (st.typing.setMemberType
                    parentTypeId: (ztypes.tid.create from: pid.u64)
                    nameId: sm.name
                    childTypeId: sido
                )
            } else null
        }
    }
    if (isgen) == false then {
        createId: (st.reg.newType
            name: "create"
            ownerTid: pid
            typetype: ztypes.ztypetype.functionType
        )
        (st.typing.declSynthMember
            parentTypeId: (ztypes.tid.create from: pid.u64)
            nameId: zast.names.wkCreate
            kind: ztyping.declkind.methodDecl
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: pid.u64)
            nameId: zast.names.wkCreate
            childTypeId: createId
        )
        borrowId: (st.reg.newType
            name: "borrow"
            ownerTid: pid
            typetype: ztypes.ztypetype.functionType
        )
        (st.typing.declSynthMember
            parentTypeId: (ztypes.tid.create from: pid.u64)
            nameId: zast.names.wkBorrow
            kind: ztyping.declkind.methodDecl
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: pid.u64)
            nameId: zast.names.wkBorrow
            childTypeId: borrowId
        )
    }
    st.reg.setNeedsDestructor typeId: (ztypes.tid.create from: pid.u64)
    if pvExcl_ppid.length > 0 then st.typing.privacySeen = true
    applyGrantsPrivate :st parentId: ppid grants: pvGrants_ppid
}

# registerEmptyType -- register a native bottom type (null -> NULL, never -> NEVER) as a
# valtype with a single synth `create` child: they are `record is native` in source but
# carry a distinct typetype and only a create child.
registerEmptyType: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    name: StringView
    tt: ztypes.ztypetype
} out u64 is {
    ex0: (resolvedByIds
        :st
        :ast
        :unitDecl
        name: (zast.poolFind pool: ast.names text: name)
    )
    match (
        ex0
    ) case some then {
        st.reg.setValtype typeId: (ztypes.tid.create from: ex0.u64) value: true
        cci0: st.reg.newType name: "create" ownerTid: ex0 typetype: ztypes.ztypetype.functionType
        (st.typing.declSynthMember
            parentTypeId: (ztypes.tid.create from: ex0.u64)
            nameId: zast.names.wkCreate
            kind: ztyping.declkind.methodDecl
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: ex0.u64)
            nameId: zast.names.wkCreate
            childTypeId: cci0
        )
        return ex0
    } case none then null
    nid: st.reg.newType :name typetype: tt
    st.reg.setValtype typeId: nid value: true
    ccid: st.reg.newType name: "create" ownerTid: nid typetype: ztypes.ztypetype.functionType
    (st.typing.declSynthMember
        parentTypeId: nid
        nameId: zast.names.wkCreate
        kind: ztyping.declkind.methodDecl
    )
    st.typing.setMemberType parentTypeId: nid nameId: zast.names.wkCreate childTypeId: ccid
    linkDeclType :st :frame :ast :unitDecl :name tid: nid
    return nid
}

# descendNamed -- reference-level DFS entry: resolve a named top-level def's
# body by descending into its AST node (located via its Decl's node) so a
# reference's dependency resolves before the
# referrer continues. Returns the canonical forward-decl id; a grey
# (in-progress) or already-resolved target returns it without re-descending.
# Returns 0 when the name is not an indexed top-level def, so the caller keeps
# its shell behavior.


# defWasResolved -- has this definition's body already been resolved? The mark
# lives on its Decl, so a definition with no Decl of its own has not been.
defWasResolved: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nameId: zast.nameid
} out bool is {
    d: declOfUnitDef :st :frame :unitDecl :nameId
    if d > 0 then return (st.typing.declIsDefined declId: d)
    return false
}

# declOfUnitDef -- the same walk for a caller that already holds the
# definition's name id: unit root, then the child edge. No key is built.
declOfUnitDef: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    if nameId.isZero then return (ztypes.declid.create from: 0)
    # A definition is looked up in the scope it is WRITTEN in: `frame`'s
    # unit frame when it lies inside `unitDecl` (a nested unit's member is a
    # child of that unit), each enclosing unit frame outward, the unit's root
    # -- and no further: this names a DEFINITION of the unit, not a
    # reference, so the prelude is not consulted.
    cur: frameFor :st :frame :unitDecl
    for cur > 0 loop {
        if cur == st.typing.coreUnitRoot then return (ztypes.declid.create from: 0)
        nd: st.typing.declFindChild parentDeclId: cur :nameId
        if (nd.isZero) == false then return nd
        # a definition the unit's `public:` block makes -- the block's
        # contents are the unit's surface, spelled `unit.name` from outside
        pb: publicNsChildOf :st root: cur
        if (pb.isZero) == false then {
            pd: st.typing.declFindChild parentDeclId: pb :nameId
            if (pd.isZero) == false then return pd
        }
        cur = unitFrameOf :st declId: (declParentIdOf :st declId: cur)
    }
    return (ztypes.declid.create from: 0)
}

# declDefTypetype -- the typetype a declaration's def node declares
# (defTypetypeOf off the Decl's own namedoperation); none for defs that
# mint no canonical type (re-exports, constants, null/never).
declDefTypetype: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out optionval ztypes.ztypetype is {
    dnode: u32
    dname: u32
    {
        decl: st.typing.decls.get i: declId.u64
        dnode = decl.node
        dname = decl.name
    }
    if dnode == 0 then return (optionval.none ztypes.ztypetype)
    nop: ast.nodes.get i: dnode.u64
    if nop.namedoperation then {
        nmNode: zast.poolTextAt pool: ast.names ref: (zast.nameid.create from: dname.u32)
        return (defTypetypeOf
            :ast
            defn: (ast.nodes.get i: nop.operation.u64)
            name: nmNode.stringView
        )
    }
    return (optionval.none ztypes.ztypetype)
}

# reexportTargetIdsOf -- reexportTargetOf as an id pair (root id, member id);
# an absent pair when the Decl is absent or not a re-export.
reexportTargetIdsOf: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out ztypes.deftarget is {
    if declId.isZero then return ztypes.noDefTarget
    decl: st.typing.decls.get i: declId.u64
    if decl.kind.reexportDecl then {
        nop: ast.nodes.get i: decl.node.u64
        if nop.namedoperation then {
            vn: ast.nodes.get i: nop.operation.u64
            dk: dottedDefTargetIds :ast n: vn
            if dk.unitName.u32 > 0 then return dk
            # a BARE alias names a target in its OWN unit, so the missing
            # segment is the enclosing unit's name -- the Decl's parent.
            bid: bareDefTargetNameId :ast n: vn
            if (bid.isZero) == false then {
                puid: zast.nameid
                pdo: st.typing.decls.get i: decl.parent.u64
                puid = zast.nameid.create from: pdo.name
                if (puid.isZero) == false then return (ztypes.deftarget unitName: puid defName: bid)
            }
        }
    }
    return ztypes.noDefTarget
}

# aliasIsBareForm -- the alias Decl's value is a BARE name (`Same: Holder`)
# rather than a dotted one. The target pair cannot say: a bare alias
# borrows its own unit for the missing segment, which a self-unit dotted alias
# (`Alpha: thisunit.Beta`) spells explicitly.
aliasIsBareForm: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    if declId.isZero then return false
    bdo: st.typing.decls.get i: declId.u64
    if bdo.kind.reexportDecl then {
        bnp: ast.nodes.get i: bdo.node.u64
        if bnp.namedoperation then {
            bvn: ast.nodes.get i: bnp.operation.u64
            bnid: bareDefTargetNameId :ast n: bvn
            return (bnid.isZero) == false
        }
    }
    return false
}

# aliasNamesType -- the alias denotes a TYPE, not a value. A bare alias always
# does (`Same: Holder`); a dotted one does when its parent names a UNIT
# (`Node: zast.Node`) rather than a type, because a TYPE parent means the child
# is one arm and the alias denotes a VALUE of it (`false: bool.false`). This is
# the same split that decides how the alias registers.
aliasNamesType: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    if declId.isZero then return false
    if (aliasIsBareForm :st :ast :declId) then return true
    ndo: st.typing.decls.get i: declId.u64
    if ndo.kind.reexportDecl then {
        nnp: ast.nodes.get i: ndo.node.u64
        if nnp.namedoperation then {
            nvn: ast.nodes.get i: nnp.operation.u64
            ntk: dottedDefTargetIds :ast n: nvn
            if ntk.unitName.u32 > 0 then return (nameDenotesUnit
                :st
                frame: st.curFrame
                nameId: ntk.unitName
            )
        }
    }
    return false
}

# nestedUnitTidOf -- the type id of the nested unit `nestedNameId` names inside the
# unit that owns `ownerDeclId`: descend one edge of the Decl tree, ask demand
# for it, and read the id off its declaration. 0 when the name is not a child
# unit, which is the caller's cue that the name means something else.
nestedUnitTidOf: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    ownerDeclId: ztypes.declid
    nestedNameId: zast.nameid
} out ztypes.tid is {
    if ownerDeclId.isZero then return (ztypes.tid.create from: 0)
    sub: st.typing.declFindChild parentDeclId: ownerDeclId nameId: nestedNameId
    if (declDeclaresUnit :st :ast declId: sub) == false then return (ztypes.tid.create from: 0)
    resolveDemandedDecl :st :frame :ast declId: sub
    return (declTypeIdOf :st declId: sub)
}

# declDeclaresUnit -- does this declaration declare a unit? Read off the def
# node's kind, which the parser settled; nothing is resolved to answer. Says
# nothing about privacy -- `nestedUnitTidOf` calls it on a CHILD declaration,
# where being nested is a property of the descent, not of the arm.
declDeclaresUnit: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    dn: u64
    {
        decl: st.typing.decls.get i: declId.u64
        dn = decl.node.u64
    }
    if dn == 0 then return false
    np: ast.nodes.get i: dn
    if (np.namedoperation) == false then return false
    return (zast.unitOpDeclaresUnit :ast opId: np.operation)
}

# nestedUnitMemberTid -- `sub.member` where `sub` is a nested unit of the unit
# that owns `ownerDeclId`: two edges of the Decl tree, each resolved on demand
# the way any definition is. 0 when either edge is missing.
nestedUnitMemberTid: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    ownerDeclId: ztypes.declid
    nestedNameId: zast.nameid
    defName: zast.nameid
} out ztypes.tid is {
    subTid: nestedUnitTidOf :st :frame :ast :ownerDeclId :nestedNameId
    if subTid.isZero then return (ztypes.tid.create from: 0)
    sub: st.typing.declFindChild parentDeclId: ownerDeclId nameId: nestedNameId
    mem: st.typing.declFindChild parentDeclId: sub nameId: defName
    if mem.isZero then return (ztypes.tid.create from: 0)
    # declare before bind, as descendNamed does for a file unit's member: a
    # TYPE member's canonical id is declared (in the member's own frame)
    # before its definition resolves, so a reference that reaches it while
    # it is grey -- a legal back-edge between two types' method signatures
    # -- gets the id, not the not-yet-linked declaration field
    declared: u64
    tto: declDefTypetype :st :ast declId: mem
    match (
        tto
    ) case some then {
        rf: sub
        dnT: zast.poolTextAt pool: ast.names ref: defName
        unitDecl92: (unitDeclOfNameOrOwn :st frame: rf nameId: nestedNameId)
        declared = (declareCanonicalType
            :st
            frame: rf
            :ast

            unitDecl: unitDecl92
            ownerNameId: zast.nameid
            name: dnT.stringView
            typetype: tto
        )
    } case none then null
    resolveDemandedDecl :st :frame :ast declId: mem
    r: declTypeIdOf :st declId: mem
    if r.isZero when declared > 0 then return (ztypes.tid.create from: declared)
    return r
}

# aliasTargetMintedTid -- the canonical id an alias's target carries, or 0:
# a nested unit's member of the alias's own scope, else the named file
# unit's definition. The declaration's own field is set when its resolution
# COMPLETES; the canonical id is declared before bind (declareCanonicalType,
# idempotent), so a target mid-resolution -- a record whose members name the
# alias again -- answers with the id it already declared. It resolves
# nothing.
aliasTargetMintedTid: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    declId: ztypes.declid
    nestedNameId: zast.nameid
    defName: zast.nameid
} out u64 is {
    aParent: declParentIdOf :st :declId
    tgt: ztypes.declid
    sub: st.typing.declFindChild parentDeclId: aParent nameId: nestedNameId
    if (sub.isZero) == false then tgt = st.typing.declFindChild parentDeclId: sub nameId: defName
    if tgt.isZero then tgt = (declOfUnitDefIds
        :st
        unitDecl: (unitDeclOfNameOrOwn :st :frame nameId: nestedNameId)
        nameId: defName
    )
    if tgt.isZero then return 0
    mt: declTypeIdOf :st declId: tgt
    if (mt.isZero) == false then return mt.u64
    tto: declDefTypetype :st :ast declId: tgt
    match (
        tto
    ) case some then {
        tnT: zast.poolTextAt pool: ast.names ref: defName
        # declared in the TARGET's frame -- its parent unit -- so the id is
        # the one the target's own resolution declares (keyed on that unit)
        rf: declParentIdOf :st declId: tgt
        unitDecl93: (unitDeclOfNameOrOwn :st frame: rf nameId: nestedNameId)
        r: (declareCanonicalType
            :st
            frame: rf
            :ast

            unitDecl: unitDecl93
            ownerNameId: zast.nameid
            name: tnT.stringView
            typetype: tto
        )
        return r
    } case none then {
        return 0
    }
}

# resolveAliasKey -- single-minting for a unit-level re-export alias
# (a reexportDecl in the Decl tree; target read off its def node): resolve the
# TARGET's canonical id and reuse it -- the alias never mints its own
# tid. Registers the unit member and the alias Decl's typeId so
# every later lookup (declChildOf, resolveUnitChild, the Decl tree) sees
# the one canonical id. Returns 0 when the key is not an alias, the
# alias is mid-follow (a cycle), or the target cannot resolve yet.
resolveAliasKey: function {
    st: zenv.ZSymbolTable
    ast: Ast
    declId: ztypes.declid
} out u64 is {
    # an alias resolves in the frame it is written in
    aframe: declParentIdOf :st :declId
    r: resolveAliasKeyIn :st frame: aframe :ast :declId
    # an alias to a CONSTANT carries a VALUE as well as a type, and that value
    # is a member of the unit the ALIAS is written in. Folded here rather than
    # at a lookup because the Decl caches the type: the second reader finds an
    # id and never asks again, so the value has to be materialised the once,
    # where the alias itself resolves.
    constFoldDecl :st :ast :declId
    return r
}

# stampGenericBounds -- resolve each recorded generic BOUND and record the
# declaration it names on the atom that spells it.
#
# Into toolRefDecl, not refDecl: the emitter reads the latter in five places,
# and an entry added there for an editor moved the emitted C. And silence on a
# miss, because a bound that names
# nothing resolvable is already the constraint machinery's business -- reporting
# it here would make a retired bound raise a second, different error.
stampGenericBounds: function {st: zenv.ZSymbolTable ast: Ast} is {
    keys9: (ListVal u64)
    with bit: st.typing.genericBoundName.iterateItems do for e: bit loop keys9.append e.key
    with kit: keys9.iterate do for k9: kit loop {
        nm9: zast.nameid
        fr9: ztypes.declid
        {
            no9: st.typing.genericBoundName.get key: k9
            match (
                no9
            ) case some then {
                nm9 = no9
            } case none then null
            fo9: st.typing.genericBoundFrame.get key: k9
            match (
                fo9
            ) case some then {
                fr9 = fo9
            } case none then null
        }
        if (nm9.isZero) == false then {
            ud9: unitRootOfDecl :st declId: fr9
            # the READ-ONLY twin: a resolver that may MINT would materialise
            # types the program never asked for, and the frozen A/B says so --
            # a probe cannot mint.
            bo9: walkLookupTyperefByIdRo :ast :st unitDecl: ud9 frame: fr9 baseId: nm9
            match (
                bo9
            ) case some then {
                td9: declOfTypeId :st tid: (ztypes.tid.create from: bo9.u64)
                if (td9.isZero) == false then {
                    st.typing.toolRefDecl.set key: k9 value: td9
                }
            } case none then null
        }
    }
}

# stampGenericParams -- resolve each recorded generic PARAMETER and record the
# declaration it names on the node that spells it.
#
# A USE goes into toolRefDecl, the channel refDeclOf already falls back to. The
# DECLARATION cannot share it. Spans keys a declaration's row to the node of the
# thing declared, which for `t: anyval.generic` is the dotted path -- and that is
# the very node the `.generic` member row is keyed to. Anything refDeclOf can see
# there answers at both, so go-to-definition on the word `generic` would start
# jumping to the parameter. The declaration's answer goes in genericParamDecl,
# which the editor consults only for a declaration row.
#
# declFindChild, never declOfTypeId: `newType ... genericParam` leaves ZType.def
# zero, so a parameter's type id cannot name its own declaration. Silent on a
# miss, and nothing here reaches the emitter.
stampGenericParams: function {st: zenv.ZSymbolTable ast: Ast} is {
    keys9: (ListVal u64)
    with bit: st.typing.genericParamName.iterateItems do for e: bit loop keys9.append e.key
    with kit: keys9.iterate do for k9: kit loop {
        nm9: zast.nameid
        fr9: ztypes.declid
        {
            no9: st.typing.genericParamName.get key: k9
            match (
                no9
            ) case some then {
                nm9 = no9
            } case none then null
            fo9: st.typing.genericParamFrame.get key: k9
            match (
                fo9
            ) case some then {
                fr9 = fo9
            } case none then null
        }
        if (nm9.isZero) == false then {
            d9: st.typing.declFindChild parentDeclId: fr9 nameId: nm9
            if (d9.isZero) == false then {
                st.typing.genericParamDecl.set key: k9 value: d9
                # the Decl points at the `t: anyval.generic` arm: its operation
                # is the dotted path, and that path's parent atom spells the
                # bound the hover card reads.
                opn9: u64
                bnd9: u64
                {
                    dn9: st.typing.decls.get i: d9.u64
                    an9: ast.nodes.get i: dn9.node.u64
                    match (
                        an9
                    ) case namedoperation then {
                        opn9 = an9.operation.u64
                        po9: ast.nodes.get i: opn9
                        match (
                            po9
                        ) case dottedpath then {
                            pb9: ast.nodes.get i: po9.parent.u64
                            bnd9 = (nodeId n: pb9).u64
                        } else null
                    } else null
                }
                if bnd9 > 0 then st.typing.genericParamBound.set key: k9 value: bnd9
                if k9 != opn9 then st.typing.toolRefDecl.set key: k9 value: d9
            }
        }
    }
}

# stampAliasValues -- record, for every alias that resolved, the declaration its
# VALUE node refers to.
#
# A pass rather than a hook, because the two routes an alias resolves by do not
# agree on when its type is known. The eager tier reaches a DOTTED re-export
# through resolveAliasKey and a BARE one through resolveDef -- deliberately, a
# bare target names a sibling of the same unit and resolveDef is what folds it --
# and on that leg the Decl still carries no type when the leg ends. Asking once,
# afterwards, is the only place both are answerable, and it does not care which
# route ran.
#
# An alias that never resolved carries no type and is skipped: there is nothing
# it refers to yet. That is the ordinary demand-mode case for a definition
# nothing reaches.
stampAliasValues: function {st: zenv.ZSymbolTable ast: Ast.view} is {
    units: programUnitDecls :st
    with uit: units.iterate do for u9: uit loop {
        ud9: ztypes.declid.create from: u9
        cnt9: st.typing.declChildSlots declId: ud9
        ci9: u64
        for ci9 < cnt9 loop {
            cd9: st.typing.declChildAt declId: ud9 index: ci9
            ci9 = ci9 + 1
            if (cd9.isZero) == false then {
                isRx9: false
                {
                    d9: st.typing.decls.get i: cd9.u64
                    if d9.kind.reexportDecl then isRx9 = true
                }
                if isRx9 then {
                    t9: (declTypeIdOf :st declId: cd9).u64
                    stampAliasValue :st :ast declId: cd9 tid: t9
                }
            }
        }
    }
}

# stampAliasValue -- an alias's VALUE node references the target's declaration.
#
# An alias is resolved off the Decl tree -- the target is read as a name-id pair
# straight from the def node -- and is never walked as a type-ref, so nothing
# else records that edge. The nodes are in the tree and the tooling finds them,
# but they carry no stamp, which is why `zast.Node` answered nothing on the RHS
# of `Node: zast.Node` while the same path in a parameter type answered fine:
# there the type-ref walk stamps it. Recorded here, where the alias's canonical
# id is already in hand.
stampAliasValue: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    declId: ztypes.declid
    tid: u64
} is {
    if tid == 0 then return
    td: declOfTypeId :st tid: (ztypes.tid.create from: tid.u64)
    if td.isZero then return
    # the value node under the alias's `name: value` pair. Both alias forms
    # land one node: the dotted form's path node -- which is the id the member
    # selector is keyed by, not the child atom's -- and the bare form's atom.
    opNid: u64
    {
        d: st.typing.decls.get i: declId.u64
        n: ast.nodes.get i: d.node.u64
        if n.namedoperation then opNid = n.operation.u64
    }
    if opNid == 0 then return
    stampRefDecl :st nid: opNid declId: td
}
# aliasTargetTid -- the type a re-export alias stands for, when neither the nested-
# unit scope nor the file-unit index answered. It may be reached through the
# target unit's own root, or be TYPE-ROOTED -- a member of a type rather than of a
# unit -- which rootedOut reports so the caller edges it correctly.
aliasTargetTid: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    adecl: ztypes.declid
    aParent: ztypes.declid
    aName: StringView
    aUnit: StringView
    tu: StringView
    tn: StringView
    atid0: ztypes.tid
    rootedOut: (ListVal bool)
    defNameId: zast.nameid
} out ztypes.tid is {
    typeRooted: false
    atid: atid0
    if atid.isZero then {
        # a type-rooted target (`true: bool.true`): the root names a tagged
        # type, the member one of its value arms -- the alias denotes a VALUE
        # of the root type, so the edge binds the ROOT's tid
        nameId92: (declNameIdOf :st declId: (unitRootOfDecl :st declId: adecl))
        hUnitDecl3: unitDeclOfNameOrOwn :st :frame nameId: nameId92
        rto: (walkLookupTyperef
            :st
            :frame
            :ast

            unitDecl: hUnitDecl3
            base: tu
        )
        if rto.none then {
            # a tagged type declared in THIS file is invisible to the typeref
            # walk while resolution runs, so `READY: mode.ready` never reached
            # the arm test below. resolveAtomType is the current-unit-relative
            # resolver that sees it.
            nameId93: (declNameIdOf :st declId: (unitRootOfDecl :st declId: adecl))
            hUnitDecl2: unitDeclOfNameOrOwn :st :frame nameId: nameId93
            rtb: (resolveAtomType
                :st
                :frame

                :ast
                unitDecl: hUnitDecl2
                nm: tu
                thisName: ""
            )
            if rtb > 0 then rto = optionval.some rtb.u64
        }
        match (
            rto
        ) case some then {
            rtt: st.reg.typetypeOf typeId: (ztypes.tid.create from: rto.u64)
            isTag: false
            if rtt == ztypes.ztypetype.variantType then isTag = true
            if rtt == ztypes.ztypetype.unionType then isTag = true
            if isTag then {
                memberDecl: (st.typing.declChildOf
                    pool: ast.names
                    parentTypeId: (ztypes.tid.create from: rto.u64)
                    name: tn
                )
                match (
                    memberDecl
                ) case some then {
                    mtt: st.reg.typetypeOf typeId: (ztypes.tid.create from: memberDecl.u64)
                    isMem: true
                    if mtt == ztypes.ztypetype.functionType then isMem = false
                    if mtt == ztypes.ztypetype.dataType then isMem = false
                    if isMem then {
                        atid = ztypes.tid.create from: (rto)
                        typeRooted = true
                    }
                } case none then null
            }
        } case none then null
    }
    if atid.isZero then {
        # a BARE alias (`Text: String`, `tally: u64`): its target resolves
        # current-unit-relative, so it may live in a stdlib unit rather than in
        # the alias's own -- the pair carries this unit only because a bare name
        # has no unit segment. resolveAtomType is that precedence walk.
        if (aliasIsBareForm :st :ast declId: adecl) then {
            # a ring of bare aliases (`Alpha: Beta` / `Beta: Alpha`) is cut by
            # the guard at the top of this function, which returns silently --
            # the caller then mints a forward shell and the C carries an
            # incomplete type. Report it the way the dotted leg does instead.
            btd: st.typing.declFindChild parentDeclId: aParent nameId: defNameId
            if (st.typing.declIsResolving declId: btd) then {
                bcm: "alias cycle: '\{aUnit}.\{aName}' aliases '\{aUnit}.\{tn}' which is still resolving"
                addResolveError :st e: zast.err.typeError msg: bcm
                rootedOut.append typeRooted
                return (ztypes.tid.create from: 0)
            }
            st.typing.declSetResolving declId: adecl mark: true
            nameId94: (declNameIdOf :st declId: (unitRootOfDecl :st declId: adecl))
            hUnitDecl: unitDeclOfNameOrOwn :st :frame nameId: nameId94
            bat: (resolveAtomType
                :st
                :frame

                :ast
                unitDecl: hUnitDecl
                nm: tn
                thisName: ""
            )
            st.typing.declSetResolving declId: adecl mark: false
            if bat > 0 then atid = ztypes.tid.create from: (bat.u64)
        }
    }
    rootedOut.append typeRooted
    return atid
}


resolveAliasKeyIn: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    declId: ztypes.declid
} out u64 is {
    adecl: declId
    altK: reexportTargetIdsOf :st :ast declId: adecl
    if altK.unitName.u32 == 0 then return 0
    if (st.typing.declIsResolving declId: adecl) then {
        # re-entered while its target resolves: an alias is a forwarding
        # edge, not a definition with a body. When the target's own id is
        # already minted (a record's shell mints before its members, whose
        # signatures may name the alias again), forward to it; only a target
        # with no id yet is a true cycle.
        return (aliasTargetMintedTid
            :st
            :frame

            :ast
            declId: adecl
            nestedNameId: altK.unitName
            defName: altK.defName
        )
    }
    tu: zast.poolTextAt pool: ast.names ref: altK.unitName
    tn: zast.poolTextAt pool: ast.names ref: altK.defName
    aParent: ztypes.declid
    aNameId: zast.nameid
    {
        ado: st.typing.decls.get i: adecl.u64
        aParent = ado.parent
        aNameId = zast.nameid.create from: ado.name
    }
    if aNameId.isZero then return 0
    aName: zast.poolTextAt pool: ast.names ref: aNameId
    # the file unit the alias is written in, for the name walkers and the
    # diagnostics -- the alias's OWN scope is aParent, which is that unit's
    # root for a top-level alias and the nested unit's Decl for a nested one
    aUnit: (zast.poolTextAt
        pool: ast.names
        ref: (declNameIdOf
            :st
            declId: (unitDeclOfNameOrOwn
                :st
                :frame
                nameId: (declNameIdOf :st declId: (unitRootOfDecl :st declId: adecl))
            )
        )
    )
    st.typing.declSetResolving declId: adecl mark: true
    # A subunit of THIS unit is the nearer scope, so it answers before the
    # file-unit index -- the same order a name written inside a namespace takes.
    atid: (nestedUnitMemberTid
        :st
        :frame

        :ast
        ownerDeclId: aParent
        nestedNameId: altK.unitName
        defName: altK.defName
    )
    hUnitDecl: unitDeclOfNameOrOwn :st :frame nameId: altK.unitName
    if atid.isZero then atid = (descendNamed
        :st
        :frame

        :ast
        unitDecl: hUnitDecl
        name: tn.stringView
    )
    st.typing.declSetResolving declId: adecl mark: false
    rootedOut: (ListVal bool)
    atid = (aliasTargetTid
        :st
        :frame
        :ast
        :adecl
        :aParent
        aName: aName.stringView
        aUnit: aUnit.stringView
        tu: tu.stringView
        tn: tn.stringView
        atid0: atid
        :rootedOut
        defNameId: altK.defName
    )
    typeRooted: rootedOut.get i: 0
    if atid.isZero then return 0
    # the alias is a member of the unit it is WRITTEN in, which is that unit's
    # own id whether it is a file unit or a nested one -- both carry it on the
    # Decl the alias hangs under.
    ownTid: declTypeIdOf :st declId: aParent
    if (ownTid.isZero) == false then {
        (st.typing.setMemberType
            parentTypeId: ownTid
            nameId: aNameId
            childTypeId: atid
        )
    }
    st.typing.declSetType declId: adecl typeId: atid
    if typeRooted then {
        # the value alias's own dotted node resolves as a typeref to the
        # root type post-demand (nav from the alias line into the tag type)
        dnid: u64
        {
            do8: st.typing.decls.get i: adecl.u64
            nop8: ast.nodes.get i: do8.node.u64
            if nop8.namedoperation then dnid = nop8.operation.u64
        }
        if dnid > 0 then {
            st.typing.pendingTyperef.set key: dnid value: (nameIdOf :ast name: tu.stringView)
            # the alias resolves in the frame it is written in
            st.typing.pendingTyperefFrame.set key: dnid value: aParent
        }
    }
    return atid
}

# ensureDefGenericParams -- register a generic type definition's parameter names
# against its Decl. `registerGenericParams` runs from the definition resolvers,
# but a def can be marked RESOLVED by a path that never reached one -- the
# descent then short-circuits, and `getOrMintSpec` reads an arity of zero for a
# template that plainly has parameters, which costs it the trie. `addGenericParam`
# already refuses a name it holds, so re-registering is a no-op.
ensureDefGenericParams: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    declId: ztypes.declid
} is {
    if declId.isZero then return
    dnG: u64
    {
        dgG: st.typing.decls.get i: declId.u64
        dnG = dgG.node.u64
    }
    if dnG == 0 then return
    bmG: ast.nodes.get i: dnG
    if bmG.namedoperation then {
        odG: ast.nodes.get i: bmG.operation.u64
        match (
            odG
        ) case objectdef then {
            if (hasGenericParam :ast items: odG.asItems) then {
                registerGenericParams :st :ast tdecl: declId items: odG.asItems
            }
        } else null
    }
}

descendNamed: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    name: StringView
} out ztypes.tid is {
    # `unitDecl.name` resolves in unitDecl's frame, whatever asked for it
    ddec: declOfUnitDef :st :frame :unitDecl nameId: (nameIdOf :ast :name)
    rf: frame
    if (ddec.isZero) == false then rf = declParentIdOf :st declId: ddec
    if st.typing.defNodeIndexBuilt == false then return (ztypes.tid.create from: 0)
    if unitDecl == st.typing.coreUnitRoot then return (ztypes.tid.create from: 0)
    # a CONSTANT declares itself when it is read: its type is the one its value
    # carries, so a target that has not folded yet has nothing to answer with
    if (ddec.isZero) == false then {
        dcC: false
        {
            ddo: st.typing.decls.get i: ddec.u64
            if ddo.kind.constDecl when ddo.typeId.isZero then dcC = true
        }
        if dcC then constFoldDecl :st :ast declId: ddec
    }
    tto: (optionval.none ztypes.ztypetype)
    if ddec > 0 then tto = declDefTypetype :st :ast declId: ddec
    ttv: ztypes.ztypetype.nullType
    classified: false
    match (
        tto
    ) case some then {
        ttv = tto
        classified = true
    } case none then null
    tid: u64
    if classified then tid = (declareCanonicalType
        :st
        frame: rf
        :ast

        :unitDecl
        ownerNameId: zast.nameid
        :name
        typetype: ttv
    )
    if classified == false then {
        alo: resolveAliasKey :st :ast declId: ddec
        if alo > 0 then return (ztypes.tid.create from: alo.u64)
    }
    ddecl: declOfUnitDef :st frame: rf :unitDecl nameId: (nameIdOf :ast :name)
    if (defWasResolved
        :st
        frame: rf
        :unitDecl
        nameId: (zast.poolFind pool: ast.names text: name)
    ) then {
        # already resolved -- but not necessarily by a path that registered the
        # generic parameters, and the spec trie cannot key a template whose
        # arity reads as zero.
        ensureDefGenericParams :st :ast declId: ddecl
        return (ztypes.tid.create from: tid)
    }
    if (st.typing.declIsResolving declId: ddecl) then {
        # A grey hit is a back-edge. Reference-kind targets (UNION/CLASS --
        # boxed) are legal forward declarations; a VALUE-kind target reached
        # through a containment edge cannot lay out.
        if st.typing.inContainmentEdge then {
            cycV: false
            if ttv == ztypes.ztypetype.recordType then cycV = true
            if ttv == ztypes.ztypetype.variantType then cycV = true
            # a NATIVE record (a scalar: `u8: record is native`) lays out
            # nothing of its own and can hold nothing by value: reaching it
            # grey through a containment edge (a conversion of another scalar
            # returning `(resultval t: u8 ...)` while u8's own methods
            # resolve) is a back-edge to a leaf, not a layout cycle
            if cycV when (declDefIsNative :st :ast declId: ddecl) then cycV = false
            if cycV then {
                cem: "containment cycle: value type '\{unitNameTextOf :st :ast :unitDecl}.\{name}' contains itself by value; box the field behind a class, union, or Option"
                addResolveError :st e: zast.err.typeError msg: cem
            }
        }
        return (ztypes.tid.create from: tid)
    }
    if ddec.isZero then return (ztypes.tid.create from: tid.u64)
    dnode: u64
    {
        dgo: st.typing.decls.get i: ddec.u64
        dnode = dgo.node.u64
    }
    if dnode == 0 then return (ztypes.tid.create from: tid.u64)
    bmr: argRefAt :ast nid: (zast.nodeid.create from: dnode.u32.orPanic)
    if (bmr.nid.isZero) == false then {
        (resolveDef
            :st
            frame: rf

            :ast
            :unitDecl
            defName: name
            defnId: bmr.operation
        )
    }
    if classified == false then {
        roId: zast.poolFind pool: ast.names text: name
        ro: resolveUnitChild :st :ast :unitDecl nameId: roId
        return (ztypes.tid.create from: (optU64Or o: ro d: 0))
    }
    return (ztypes.tid.create from: tid)
}
# resolveDottedDef -- a unit-level definition whose value is a dotted path is the
# ALIAS form (`Node: zast.Node`): the name it binds stands for what the path names,
# so the alias edge is recorded rather than a fresh type minted.
resolveDottedDef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    rf: ztypes.declid
    defName: StringView
    defn: dpref
} is {
    # A unit-level type alias (`Node: zast.Node`): resolve the cross-unit dotted
    # ref to a (shell) type id and register it under the unit's name, so bare-alias
    # return types and value uses resolve. Replicates resolveTyperefShell's
    # cross-unit leg.
    # owned copies: the resolutions below lend ast
    apNm: zast.nameTextCopy :ast ref: (atomNameId :ast n: (ast.nodes.get i: defn.parent.u64))
    apId: atomNameId :ast n: (ast.nodes.get i: defn.parent.u64)
    if (nameDenotesUnit :st frame: rf nameId: apId) then {
        acNm: zast.nameTextCopy :ast ref: (atomNameId :ast n: (ast.nodes.get i: defn.child.u64))
        acId: atomNameId :ast n: (ast.nodes.get i: defn.child.u64)
        demandUnitMember :st unitNameId: apId nameId: acId
        # The alias target is read off the re-export Decl's node on demand
        # (reexportTargetIdsOf); resolution reuses the target's canonical id.
        if (st.typing.declIsResolving
            declId: (declOfUnitDef
                :st
                frame: rf
                unitDecl: (unitDeclOfNameOrOwn :st frame: rf nameId: apId)
                nameId: acId
            )
        ) then {
            aem: "alias cycle: '\{unitNameTextOf :st :ast :unitDecl}.\{defName}' aliases '\{apNm}.\{acNm}' which is still resolving"
            addResolveError :st e: zast.err.typeError msg: aem
        }
        udA: unitDeclOfNameOrOwn :st frame: rf nameId: (nameIdOf :ast name: apNm.stringView)
        (descendNamed
            :st
            frame: rf

            :ast
            unitDecl: udA
            name: acNm.stringView
        )
        udB: unitDeclOfName :st nameId: apId
        tgo: resolvedByIds :st :ast unitDecl: udB name: acId
        aid: u64
        match (
            tgo
        ) case some then {
            aid = tgo
        } case none then {
            aid = (resolveAtomType
                :st
                frame: rf

                :ast
                :unitDecl
                nm: acNm.stringView
                thisName: ""
            )
        }
        sda: aid
        (ztyping.nodeTypeSet
            tbl: st.typing.nodeType
            nid: defn.nid.u64
            tid: (ztypes.tid.create from: sda.u64)
        )
        # a cross-unit `unit.Type` alias records its target's declaration
        # for go-to-definition (dotted node; see the type-position stamp)
        declId9: (declOfTypeId :st tid: (ztypes.tid.create from: sda.u64))
        (stampRefDecl
            :st
            nid: defn.nid.u64
            declId: declId9
        )
    }
}
# refuseEmptyObjectDef -- AN EMPTY OBJECT DEFINITION IS AN ERROR. With no
# fields and no members there is nothing to hold and nothing to call: the
# emitter writes no struct for one (an empty struct is not C), so every use of
# it as a value produced C the compiler rejected while zc exited 0.
#
# `is native` is the exception, and the only one: the runtime owns those
# layouts, and the markers the compiler declares this way -- `null`, `never`,
# `anyval`, `Any` -- are deliberately empty. `null` and `never` parse as empty
# records, which is why the marker and not the shape has to be the test.
refuseEmptyObjectDef: function {
    st: zenv.ZSymbolTable
    defName: StringView
    defn: objref
} out bool is {
    if defn.nis > 0 then return false
    if defn.nas > 0 then return false
    if defn.isNative then return false
    em9o: "'\{defName}' is an empty object definition — it declares no fields and no members"
    eh9o: "give it a field, give it a member, or mark it `is native` when the runtime owns its layout".string
    en9o: String
    (addErrorH
        :st
        nodeid: defn.nid
        lineno: defn.lineno
        colno: defn.colno
        e: zast.err.typeError
        msg: em9o
        note: en9o
        hint: eh9o
        width: defName.length.u32.orPanic
    )
    return true
}

# resolveObjectDef -- a record / class / union / variant / facet / protocol / unit
# definition, routed to its family's resolver. A generic one resolves its
# constraint bounds first: a bound names a type the body then relies on.
resolveObjectDef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    rf: ztypes.declid
    defName: StringView
    defn: objref
} is {
    if (refuseEmptyObjectDef :st :defName :defn) then return
    match (
        defn.kind
    ) case recordDef then {
        if defName == "null" then {
            (registerEmptyType
                :st
                frame: rf
                :ast
                :unitDecl
                name: "null"
                tt: ztypes.ztypetype.nullType
            )
        } else {
            if defName == "never" then {
                nvid: (registerEmptyType
                    :st
                    frame: rf
                    :ast

                    :unitDecl
                    name: "never"
                    tt: ztypes.ztypetype.neverType
                )
                (ztyping.nodeTypeSet
                    tbl: st.typing.nodeType
                    nid: defn.nid.u64
                    tid: (ztypes.tid.create from: nvid.u64)
                )
            } else {
                resolveRecord :st frame: rf :ast :unitDecl :defName rnode: defn
            }
        }
    } case variantDef then {
        resolveVariant :st frame: rf :ast :unitDecl :defName vnode: defn
    } case unionDef then {
        resolveUnion :st frame: rf :ast :unitDecl :defName vnode: defn
    } case classDef then {
        resolveClass :st frame: rf :ast :unitDecl :defName cnode: defn
    } case facetDef then {
        resolveFacet :st frame: rf :ast :unitDecl :defName fnode: defn
    } case protocolDef then {
        resolveProtocol :st frame: rf :ast :unitDecl :defName fnode: defn
    } else null
    objrid: (resolvedByIds
        :st
        :ast
        :unitDecl
        name: (zast.poolFind pool: ast.names text: defName)
    )
    match (
        objrid
    ) case some then {
        (ztyping.nodeTypeSet
            tbl: st.typing.nodeType
            nid: defn.nid.u64
            tid: (ztypes.tid.create from: objrid.u64)
        )
    } case none then null
}


# resolveDef -- dispatch a main-unit definition by kind. Resolves functions, data
# blocks, records, variants, unions, classes, facets and protocols; a top-level data
# block parses as an `expression` wrapping a `datablock`, so unwrap one level and
# re-dispatch. Enums and generics arrive in later slices.
resolveDef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    defnId: zast.nodeid
} is {
    # a definition resolves in the frame it is written in, whatever path
    # asked for it. A definition the name index cannot place keeps the
    # caller's frame (a nested unit's member reached from its own unit walk).
    resolvedDecl: declOfUnitDef :st :frame :unitDecl nameId: (nameIdOf :ast name: defName)
    # every resolver funnels through here, so this is where a unit's toolchain
    # requirement is owed: before its first definition resolves.
    {
        ehd: resolvedDecl
        if ehd.isZero then ehd = frame
        ensureUnitRequire :st :frame :ast declId: ehd
    }
    rf: frame
    if (resolvedDecl.isZero) == false then rf = (declParentIdOf
        :st
        declId: resolvedDecl
    )
    enterUnitOnce :st :ast :unitDecl
    # a definition's BODY reaches names its signature does not: a type
    # constructed, or a sibling function called, only inside it must be demanded
    # or it never resolves -- and the body walk then reports a perfectly valid
    # reference as unknown. It goes HERE because every resolver funnels through
    # resolveDef: the demand drain, the descent, and the conformance pass. The
    # scan only queues declarations that are not yet pending, resolving or
    # resolved, so a repeat visit costs a walk and queues nothing.
    scanDefCalls :st frame: rf :ast op: (ast.nodes.get i: defnId.u64)
    st.typing.declSetResolving declId: resolvedDecl mark: true
    # A containment edge is ONE hop: this def's own resolution starts a
    # fresh context (its field/arm legs re-arm the flag), so an outer field
    # bracket never taints nested param/return resolution.
    prevContainmentEdge: st.typing.inContainmentEdge
    st.typing.inContainmentEdge = false
    arm: rowArmAt :ast nid: defnId
    match (
        arm
    ) case functiondef then {
        fr: fnRefAt :ast nid: defnId
        fid: (resolveFunction
            :st
            frame: rf

            :ast
            :unitDecl
            ownerNameId: zast.nameid
            :defName
            fnId: defnId
            thisName: ""
            skipThisType: false
        )
        (ztyping.nodeTypeSet
            tbl: st.typing.nodeType
            nid: defnId.u64
            tid: (ztypes.tid.create from: fid.u64)
        )
        if (isGeneratorReturn :ast oId: fr.returntype) then {
            (synthGeneratorIterClass
                :st
                frame: rf

                :ast
                :unitDecl
                fnName: defName
                thisName: ""
                fnode: fr
            )
        }
    } case expression then {
        wrap: exprRefAt :ast nid: defnId
        resolveDef :st frame: rf :ast :unitDecl :defName defnId: wrap.expression
        exprid: (resolvedByIds
            :st
            :ast
            :unitDecl
            name: (zast.poolFind pool: ast.names text: defName)
        )
        match (
            exprid
        ) case some then {
            (ztyping.nodeTypeSet
                tbl: st.typing.nodeType
                nid: defnId.u64
                tid: (ztypes.tid.create from: exprid.u64)
            )
        } case none then null
    } case datablock then {
        dr: dataRefAt :ast nid: defnId
        resolveData :st frame: rf :ast :unitDecl :defName dnode: dr
        dbrid: (resolvedByIds
            :st
            :ast
            :unitDecl
            name: (zast.poolFind pool: ast.names text: defName)
        )
        match (
            dbrid
        ) case some then {
            (ztyping.nodeTypeSet
                tbl: st.typing.nodeType
                nid: defnId.u64
                tid: (ztypes.tid.create from: dbrid.u64)
            )
        } case none then null
    } case objectdef then {
        orf: objRefAt :ast nid: defnId
        (resolveObjectDef
            :st
            :ast
            :unitDecl
            :rf
            :defName
            defn: orf
        )
    } case dottedpath then {
        ddr: dpRefAt :ast nid: defnId
        (resolveDottedDef
            :st
            :ast
            :unitDecl
            :rf
            :defName
            defn: ddr
        )
    } else null
    # Unit -> def childOf edges are built at mint (declareCanonicalType) for real
    # defs and on demand (resolvedByIds' alias-follow) for aliases; no tail pass.
    st.typing.inContainmentEdge = prevContainmentEdge
    rdecl1: declOfUnitDef :st frame: rf :unitDecl nameId: (nameIdOf :ast name: defName)
    st.typing.declSetResolving declId: rdecl1 mark: false
    if (rdecl1.isZero) == false then {
        st.typing.declSetDefined declId: rdecl1
    }
}


# registerUnitGenericParams -- a generic FILE unit's own parameters: registered
# against its root Decl, each with a canonical per-(unit, param) GENERIC_PARAM
# tid the definition's value node carries, so template signatures and bodies
# stamp it. Run for EVERY unit, not only an eagerly-resolved one: it is a
# property of the declaration, and a unit that is resolved on demand has the
# same parameters as one that is not.
registerUnitGenericParams: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    frame: ztypes.declid
    unitdefId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    if (hasGenericParam :ast items: bodyIds) then {
        urd0: ztypes.declid
        {
            uro0: unitDecl
            if (uro0.isZero) == false then urd0 = uro0
        }
        registerGenericParams :st :ast tdecl: urd0 items: bodyIds
        # Each generic-param name gets a canonical per-(unit,param)
        # GENERIC_PARAM tid (get-or-mint), attributed to the unit; the
        # param definition's value node carries it so template signatures
        # and bodies stamp it.
        with gpiter: bodyIds.iterate do for gmId: gpiter loop {
            gm: ast.nodes.get i: gmId.u64
            match (
                gm
            ) case namedoperation then {
                if (isBareGenericParam
                    :ast
                    op: (ast.nodes.get i: gm.operation.u64)
                ) then {
                    gpn0: zast.nameTextAt :ast ref: gm.name
                    gtid0: ztypes.tid
                    gpo0: (st.reg.genericParamTidOf
                        tdecl: urd0
                        paramName: (nameIdOf :ast name: gpn0.stringView)
                    )
                    match (
                        gpo0
                    ) case some then {
                        gtid0 = ztypes.tid.create from: (gpo0)
                    } case none then {
                        gtid0 = (st.reg.newType
                            name: gpn0.stringView
                            typetype: ztypes.ztypetype.genericParam
                        )
                        (st.reg.setGenericParamTid
                            tdecl: urd0
                            paramName: (nameIdOf :ast name: gpn0.stringView)
                            tid: gtid0
                        )
                    }
                    (linkDeclType
                        :st
                        :frame

                        :ast
                        :unitDecl
                        name: gpn0.stringView
                        tid: (ztypes.tid.create from: gtid0.u64)
                    )
                    gpnid: nodeId n: (ast.nodes.get i: gm.operation.u64)
                    ztyping.nodeTypeSet tbl: st.typing.nodeType nid: gpnid.u64 tid: gtid0
                }
            } else null
        }
    }
}


# recordUnitConformerContexts -- record, for each of this unit's definitions
# that its own `main` names, the conformer its as-block markers bind their spec
# `this` to. A spec receiver binds only when the conformer's resolution triggers
# the protocol's; a main body that never names the conformer resolves the
# protocol context-free (e.g. through a function signature). A property of the
# unit's own declarations, not of whether its body is walked eagerly -- so it
# runs for every unit. A unit with no `main` of its own has nothing to record.
recordUnitConformerContexts: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    unitdefId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    # collect member names first -- the body list cannot be passed while its
    # iterator is live.
    ccNames: (List String)
    with cmiter: bodyIds.iterate do for cmmId: cmiter loop {
        cmm: ast.nodes.get i: cmmId.u64
        ccn0: String
        match (
            cmm
        ) case namedoperation then {
            ccn1: zast.nameTextCopy :ast ref: cmm.name
            ccn0 = ccn1
        } else null
        ccNames.append ccn0
    }
    mainOp: zast.nodeid
    with cmit0: bodyIds.iterate do for cmm0: cmit0 loop {
        if mainOp.isZero then {
            cmn0: ast.nodes.get i: cmm0.u64
            match (
                cmn0
            ) case namedoperation then {
                if (zast.nameTextEq
                    :ast
                    ref: cmn0.name
                    s: "main"
                ) then mainOp = cmn0.operation
            } else null
        }
    }
    if mainOp.isZero then return
    uid: unitNameIdOf :st :unitDecl
    cci: u64
    ccTotal: ccNames.length
    for cci < ccTotal loop {
        cnm2: ccNames.get i: cci
        if cnm2.length > 0 then {
            if (fnBodyMentions
                :ast
                op: (ast.nodes.get i: mainOp.u64)
                name: cnm2.stringView
            ) then {
                mem2Id: bodyIds.get i: cci
                mem2: ast.nodes.get i: mem2Id.u64
                match (
                    mem2
                ) case namedoperation then {
                    unitDecl94: (unitDeclOfName :st nameId: uid)
                    (recordConformerContexts
                        :st
                        :ast
                        unitDecl: unitDecl94
                        defName: cnm2.stringView
                        op: (ast.nodes.get i: mem2.operation.u64)
                    )
                } else null
            }
        }
        cci = cci + 1
    }
}

# resolveUnitBody -- resolve every top-level definition signature in a unit.
# resolveUnitBody -- resolve a unit's definition signatures. Signature-only
# resolves every member; the full body-walk mode mirrors check()'s eager set
# (functions and units only -- other definitions resolve on demand, so unused
# main-unit records/classes/unions drop out of the full dump).
resolveUnitBody: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    unitdefId: zast.nodeid
    rootOnly: bool
} is {
    # a FILE unit is the one unit whose owner is looked up by name: nothing
    # holds its Decl the way an enclosing walk holds a nested unit's.
    # registerUnitRoots and indexUnitDefs both ran already, so both are there.
    ubPt: ztypes.tid
    ubPd: ztypes.declid
    {
        uo: (declTypeIdOf
            :st
            declId: unitDecl
        )
        if (uo.isZero) == false then {
            ubPt = ztypes.tid.create from: uo
        }
    }
    {
        ro: unitDecl
        if (ro.isZero) == false then ubPd = ro
    }
    (resolveUnitMembers
        :st

        :ast
        :unitDecl
        ownerDeclId: ubPd
        ownerTid: ubPt
        unitOpId: unitdefId
        speculative: true
        :rootOnly
    )
}

# registerUnitRoots -- register a UNIT type for EVERY unit up front, before
# lowerGenerators / indexUnitDefs / demand resolution, so childOf-at-mint
# (declareCanonicalType) always sees a populated unit root. indexUnitDefs binds
# each type to the unit's Decl, keyed on the unitdef NODE -- by then the name
# would find that very Decl. The main unit precedes its deps in unit order, so a
# cross-unit qualified type ref (zlexer.Token) sees the dep as a unit; a member
# path types its base as the UNIT type through the program root's child of that
# name -- never the resolution chain, where a main unit sharing a type's name
# (str.z, panic.z) would shadow it.
registerUnitRoots: function {st: zenv.ZSymbolTable program: Node.view} is {
    match (
        program
    ) case program then {
        # a unit name is one identity: the second file to claim it is
        # rejected here, before any type is minted, so the program root
        # holds one child per name and declFindChild there is unambiguous.
        # Keyed by name-pool id -- the pool interns, so id equality is text
        # equality and no spelling is compared.
        seenUnits: (IdSet u64)
        uCnt9c: program.ast.units.length
        uIdx9c: u64
        for uIdx9c < uCnt9c loop {
            ruId: (zast.nodeid.create from: (program.ast.units.get i: uIdx9c))
            uIdx9c = uIdx9c + 1
            opId: zast.nodeid
            nmNode: String
            nmRef: u64
            uNode: zast.nodeid
            uLine: u32
            uCol: u32
            {
                ru: program.ast.nodes.get i: ruId.u64
                if ru.namedoperation then {
                    nm: zast.poolTextAt pool: program.ast.names ref: ru.name
                    opId = ru.operation
                    nmNode = nm.copy
                    nmRef = ru.name.u64
                    uNode = ru.nodeid
                    uLine = ru.lineno
                    uCol = ru.colno
                }
            }
            if opId > 0 then {
                if (seenUnits.has item: nmRef) then {
                    dupm: "duplicate unit '\{nmNode}': a unit name is one identity, and another file already declares it"
                    (addResolveErrorH
                        :st
                        nodeid: uNode
                        lineno: uLine
                        colno: uCol
                        e: zast.err.duplicateDef
                        msg: dupm
                        width: nmNode.length.u32.orPanic
                    )
                } else {
                    seenUnits.add item: nmRef
                    uid: st.reg.newType name: nmNode.stringView typetype: ztypes.ztypetype.unitType
                    opid: unitdefNodeId ast: program.ast nId: opId
                    st.typing.unitTypesById.set key: opid.u64 value: uid
                }
            }
        }
    } else null
}

# demandAllUnitDefs -- demand every top-level definition of a unit (the
# eager mode: a definition nothing references is still resolved, so an error
# inside it is reported).
demandAllUnitDefs: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitNameId: zast.nameid
    unitdefId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    with dit: bodyIds.iterate do for bm9Id: dit loop {
        bm: ast.nodes.get i: bm9Id.u64
        if bm.namedoperation then {
            demandUnitMember :st :unitNameId nameId: bm.name
        }
    }
}

# demandAllDefs -- demand every top-level definition of EVERY unit. Without
# it a definition nothing references is never resolved, so an error inside
# it is reported by nothing.
demandAllDefs: function {st: zenv.ZSymbolTable program: Node.view} is {
    if (st.typing.eagerAll) == false then return
    match (
        program
    ) case program then {
        duN: program.ast.units.length
        duI: u64
        for duI < duN loop {
            duId: (zast.nodeid.create from: (program.ast.units.get i: duI))
            duI = duI + 1
            duOp: zast.nodeid
            duNm: zast.nameid
            {
                dun: program.ast.nodes.get i: duId.u64
                if dun.namedoperation then {
                    duOp = dun.operation
                    duNm = dun.name
                }
            }
            if duOp > 0 then {
                demandAllUnitDefs :st ast: program.ast unitNameId: duNm unitdefId: duOp
            }
        }
    } else null
}

# noMainError -- the target unit declares no `main`, so demand has no root.
# Positioned on the unit's own definition: there is no node to point at, the
# absence IS the error.
noMainError: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    unitdefId: zast.nodeid
} is {
    unc: unitNameTextOf :st :ast :unitDecl
    em: "unit '\{unc}' declares no 'main': there is nothing to compile it from"
    en: (
        "compilation is demand-driven -- `main` is the root, and what it reaches is what gets checked and emitted"
    ).string
    eh: (
        "add `main: function is { ... }`, or compile the program that opens this unit instead"
    ).string
    un: ast.nodes.get i: unitdefId.u64
    st.typing.errors.append (zast.ErrorData
        nodeid: (nodeId n: un)
        lineno: (nodeLine n: un)
        colno: (nodeCol n: un)
        width: unc.length.u32.orPanic
        err: zast.err.noMain
        msg: em
        fsno: zvfs.fsno
        note: en
        hint: eh
    )
    st.typing.isError = true
}

# register and resolve the program's main unit.
registerAndResolveMain: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    program: Node
} is {
    match (
        program
    ) case program then {
        unitDecl: st.typing.mainUnitRoot
        # Pass 1 (unit-root minting) hoisted to registerUnitRoots, run before lowerGenerators.
        # Pass 2: resolve EVERY file unit's definition signatures (main + deps
        # like zlexer/zast/zvfs), so cross-unit type refs resolve to the dep's
        # own type and the dep's type/fn def nodes get stamped for emission.
        muN0: program.ast.units.length
        muI0: u64
        for muI0 < muN0 loop {
            muId: (zast.nodeid.create from: (program.ast.units.get i: muI0))
            muI0 = muI0 + 1
            opId: zast.nodeid
            nmId: zast.nameid
            {
                mu: program.ast.nodes.get i: muId.u64
                if mu.namedoperation then {
                    opId = mu.operation
                    nmId = mu.name
                }
            }
            if opId > 0 then {
                # a unit's own generic parameters are a property of its
                # DECLARATION, not of whether its body is walked eagerly. Kept
                # at this point in the unit order so an eagerly-resolved unit
                # mints them exactly when it did before.
                unitDecl95: (unitDeclOfNameOrOwn :st :frame nameId: nmId)
                (registerUnitGenericParams
                    :st
                    :frame

                    ast: program.ast
                    unitDecl: unitDecl95
                    unitdefId: opId
                )
                # what a unit's own `main` names about its conformers is a
                # property of its declarations too, recorded for every unit:
                # only the main unit's body is eagerly resolved.
                unitDecl96: (unitDeclOfNameOrOwn :st :frame nameId: nmId)
                (recordUnitConformerContexts
                    :st
                    ast: program.ast
                    unitDecl: unitDecl96
                    unitdefId: opId
                )
                uc0z: unitDeclOfNameOrOwn :st :frame nameId: nmId
                eager: uc0z == unitDecl
                if eager then {
                    unitDecl97: (unitDeclOfNameOrOwn :st :frame nameId: nmId)
                    (resolveUnitBody
                        :st

                        ast: program.ast
                        unitDecl: unitDecl97
                        unitdefId: opId
                        rootOnly: (st.typing.eagerAll) == false
                    )
                }
            }
        }
    } else null
}

# isConformanceMarker -- true when an as-item operation is a bare type reference
# (atomid / labelvalue), i.e. a conformance marker like `:Text` or `m: Reader`.
isConformanceMarker: function {op: Node.view} out bool is {
    match (
        op
    ) case atomid then {
        return true
    } case labelvalue then {
        return true
    } else {
        return false
    }
}

# declaresConformance -- true when an objectdef declares conformance via an as-item.
declaresConformance: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case objectdef then {
        citer: op.asItems.iterate
        for cmId: citer loop {
            cm: ast.nodes.get i: cmId.u64
            match (
                cm
            ) case namedoperation then {
                if (isConformanceMarker op: (ast.nodes.get i: cm.operation.u64)) then return true
            } else null
        }
        return false
    } else {
        return false
    }
}

# enterUnitOnce -- a dependency unit's one-time pass, the first time any of
# its definitions resolves, whoever resolves it: demand the conformance
# declarers reference-following cannot reach (zvfs FSProvider) and the return
# / never the walk of its bodies uses. Not a property of the unit's NAME: a
# conformer is as unreachable in a user dependency as it is in collections.
# Queued, not resolved here: this runs inside whatever resolution reached the
# unit first, and the drain resolves them at the top level.
enterUnitOnce: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
} is {
    if unitDecl == st.typing.coreUnitRoot then return
    if unitDecl.isZero then return
    if (st.typing.enteredUnits.has item: unitDecl.u64) then return
    st.typing.enteredUnits.add item: unitDecl.u64
    if unitDecl == st.typing.mainUnitRoot then return
    ro: unitDecl
    if (ro.isZero) == false then {
        uop: zast.nodeid
        {
            rdo: st.typing.decls.get i: ro.u64
            unop: ast.nodes.get i: rdo.node.u64
            if unop.namedoperation then uop = unop.operation
        }
        if (uop.isZero) == false then {
            bodyIds: zast.unitBodyIdsAt :ast unitId: uop
            with biter: bodyIds.iterate do for bm: biter loop {
                bmNode: ast.nodes.get i: bm.u64
                if bmNode.namedoperation then {
                    hDeclId: st.typing.declFindChild parentDeclId: ro nameId: bmNode.name
                    if (declaresConformance
                        :ast
                        op: (ast.nodes.get i: bmNode.operation.u64)
                    ) then (demandDecl
                        :st
                        declId: hDeclId
                    )
                }
            }
        }
    }
    demandReturnNever :st :ast
}

# stampCtorDefaults -- a construction fills unprovided defaulted fields: the
# default's node stamps its resolved member/parent type, once the owner has
# actually been constructed (during the body walk).
stampCtorDefaults: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
} is {
    dnids: (ListVal u64)
    owners: (ListVal u64)
    with diter: st.typing.pendingDefaultOwner.iterateItems do for de: diter loop {
        dk: de.key
        dnids.append dk
        dv: de.value
        owners.append dv
    }
    di: u64
    dn: dnids.length
    for di < dn loop {
        ow: owners.get i: di
        cgot: st.typing.constructedTypes.get key: ow
        isCon: optBoolOr o: cgot d: false
        if isCon then {
            nd: dnids.get i: di
            ido: st.typing.pendingDefaultId.get key: nd
            idv: optU64Or o: ido d: 0
            if idv > 0 then {
                nd2: dnids.get i: di
                (ztyping.nodeTypeSet
                    tbl: st.typing.nodeType
                    nid: nd2
                    tid: (ztypes.tid.create from: idv.u64)
                )
            } else {
                nd3: dnids.get i: di
                ngId: zast.nameid
                {
                    ngo: st.typing.pendingDefaultName.get key: nd3
                    match (
                        ngo
                    ) case some then {
                        ngId = ngo
                    } case none then null
                }
                if (ngId.isZero) == false then {
                    nrt: (optU64Or
                        o: (walkLookupTyperefById
                            :st
                            :frame
                            :ast
                            :unitDecl
                            baseId: ngId
                        )
                        d: 0
                    )
                    if nrt > 0 then {
                        nd4: dnids.get i: di
                        (ztyping.nodeTypeSet
                            tbl: st.typing.nodeType
                            nid: nd4
                            tid: (ztypes.tid.create from: nrt.u64)
                        )
                    }
                }
            }
        }
        di = di + 1
    }
}

# fixupCustomTags -- bind deferred custom union tags: a `tag: X.tag` as-item
# whose data block resolved after the union (demand order) overrides the
# synthesized tag child once both exist.
fixupCustomTags: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
} is {
    pend: (ListVal u64)
    pnames: (ListVal zast.nameid)
    with citer: st.typing.pendingCustomTag.iterateItems do for ce: citer loop {
        ck: ce.key
        pend.append ck
        pnames.append ce.value
    }
    ci: u64
    cn: pend.length
    for ci < cn loop {
        cuid: pend.get i: ci
        # an owned copy: the walks below lend ast
        cnm: zast.nameTextCopy :ast ref: (pnames.get i: ci)
        co: walkLookupTyperef :st :frame :ast :unitDecl base: cnm.stringView
        ctid: optU64Or o: co d: 0
        if ctid > 0 then {
            if (st.reg.typetypeOf typeId: (ztypes.tid.create from: ctid.u64)) == ztypes.ztypetype.dataType then {
                cuidc: cuid
                (st.typing.declSynthMember
                    parentTypeId: (ztypes.tid.create from: cuidc.u64)
                    nameId: zast.names.wkTag
                    kind: ztyping.declkind.fieldDecl
                )
                (st.typing.setMemberType
                    parentTypeId: (ztypes.tid.create from: cuidc.u64)
                    nameId: zast.names.wkTag
                    childTypeId: ctid
                )
            } else {
                cuidn: cuid
                cngo: st.typing.pendingCustomTagNode.get key: cuidn
                cnid: optU64Or o: cngo d: 0
                if cnid > 0 then {
                    unitDecl98: (unitDeclOfName :st nameId: (nameIdOf :ast name: "system"))
                    tgo2: (resolvedByIds
                        :st
                        :ast
                        unitDecl: unitDecl98
                        name: zast.names.wkTag
                    )
                    match (
                        tgo2
                    ) case some then {
                        (ztyping.nodeTypeSet
                            tbl: st.typing.nodeType
                            nid: cnid
                            tid: (ztypes.tid.create from: tgo2.u64)
                        )
                    } case none then null
                }
            }
        }
        ci = ci + 1
    }
}

# bodyEndsInReturn -- true when a function body's last statement is a
# bare `return ...` call (the syntactic divergence the clone-scope synthesis
# needs; no stamps are made).
bodyEndsInReturn: function {ast: Ast.view bodyId: zast.nodeid} out bool is {
    if bodyId.isZero then return false
    return (blockEndsInReturn :ast block: (ast.nodes.get i: bodyId.u64))
}

# true when `block`'s last statement is a return.
blockEndsInReturn: function {ast: Ast.view block: Node.view} out bool is {
    match (
        block
    ) case statement then {
        ne: block.statements.length
        if ne > 0 then {
            lastId: block.statements.get i: (ne - 1)
            last: ast.nodes.get i: lastId.u64
            match (
                last
            ) case statementline then {
                return (stmtExprIsReturn :ast op: (ast.nodes.get i: last.statementline.u64))
            } else {
                return false
            }
        } else {
            return false
        }
    } else {
        return false
    }
}

# stmtExprIsReturn -- an expression statement whose inner call's callable is
# the `return` builtin.
stmtExprIsReturn: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case expression then {
        return (exprCallIsReturn :ast op: (ast.nodes.get i: op.expression.u64))
    } else {
        return false
    }
}

# true when operation `op` is a call to the `return` builtin.
exprCallIsReturn: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case call then {
        cn: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: op.callable.u64))
        return cn.stringView == "return"
    } else {
        return false
    }
}

# isFunctionDefWithBody -- true when a node is a functiondef carrying a non-empty body
# (a real method, not a facet/protocol spec signature whose body is none).
isFunctionDefWithBody: function {o: Node.view} out bool is {
    match (
        o
    ) case functiondef then {
        return o.body > 0
    } else {
        return false
    }
}

# objectHasMethodBody -- true when an objectdef holds at least one is/as-item method
# with a body. Scans both blocks (transient iterators over different lists).
objectHasMethodBody: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case objectdef then {
        iiter: op.isItems.iterate
        for imId: iiter loop {
            im: ast.nodes.get i: imId.u64
            match (
                im
            ) case namedoperation then {
                if (isFunctionDefWithBody o: (ast.nodes.get i: im.operation.u64)) then return true
            } else null
        }
        aiter: op.asItems.iterate
        for amId: aiter loop {
            am: ast.nodes.get i: amId.u64
            match (
                am
            ) case namedoperation then {
                if (isFunctionDefWithBody o: (ast.nodes.get i: am.operation.u64)) then return true
            } else null
        }
        return false
    } else {
        return false
    }
}

# unitHasObjectMethodBody -- true when a unit body holds an objectdef with a method-body.
unitHasObjectMethodBody: function {ast: Ast.view defId: u32} out bool is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: defId
    biter: bodyIds.iterate
    for bm: biter loop {
        bmNode: ast.nodes.get i: bm.u64
        if bmNode.namedoperation then {
            if (objectHasMethodBody
                :ast
                op: (ast.nodes.get i: bmNode.operation.u64)
            ) then return true
        }
    }
    return false
}

# demandDecl -- a reference found this declaration: queue it for resolution
# unless it is resolved, mid-resolution, already queued, or a prelude
# re-export already followed to its target. The mark lives on the
# declaration, so the walk that finds a definition also finds its state.
demandDecl: function {st: zenv.ZSymbolTable declId: ztypes.declid} is {
    if (st.typing.declIsPending :declId) then return
    if (st.typing.declIsResolving :declId) then return
    if (st.typing.declIsDefined :declId) then return
    {
        decl: st.typing.decls.get i: declId.u64
        if decl.parent == st.typing.coreUnitRoot when decl.typeId > 0 then return
    }
    st.typing.declSetPending :declId mark: true
    st.typing.pendingDefs.append from: declId
}

# demandDefinition -- a bare name written in `frame` demands the definition
# the environment walk finds for it, if any: a local variable, a member, or
# an unknown name finds nothing and demands nothing.
demandDefinition: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    nameId: zast.nameid
} is {
    hit: envLookup :st :frame :nameId
    if (hit.declId.isZero) == false then demandDecl :st declId: hit.declId
}

# demandUnitMember -- a qualified `unit.member` demands exactly that unit's
# member; the chain is not walked. A name the unit does not define directly
# may be an exported alias (`perimeter: perimImpl`), whose edge hangs under
# the unit's public block.
demandUnitMember: function {
    st: zenv.ZSymbolTable
    unitNameId: zast.nameid
    nameId: zast.nameid
} is {
    ro: st.typing.declFindChild parentDeclId: st.typing.programRoot nameId: unitNameId
    if (ro.isZero) == false then {
        d: st.typing.declFindChild parentDeclId: ro :nameId
        if (d.isZero) == false then {
            demandDecl :st declId: d
            return
        }
        pub: publicNsChildOf :st root: ro
        if (pub.isZero) == false then {
            e: st.typing.declFindChild parentDeclId: pub :nameId
            if (e.isZero) == false then {
                # a definition the block itself makes resolves with the
                # block, a nested unit (its constants key on the block's
                # id); an edge names a sibling of the unit, demanded as such
                ep: declParentIdOf :st declId: e
                if ep == pub then {
                    demandDecl :st declId: pub
                } else {
                    demandDecl :st declId: e
                }
            }
        }
    }
}

# publicNsChildOf -- a unit root's `public:` block Decl, or zero. Read one
# child slot at a time: a second decls probe cannot run under a live
# children borrow.
publicNsChildOf: function {st: zenv.ZSymbolTable.view root: ztypes.declid} out ztypes.declid is {
    return (st.typing.declPublicNsOf owner: root)
}

# owningUnitDecl -- the unit a declaration is written in: the nearest
# enclosing unit-kind Decl, or the declaration itself when it is one. Not the
# file root -- a subunit owns its own `require:` block, and `wideint`'s is not
# `system`'s.
owningUnitDecl: function {st: zenv.ZSymbolTable.view declId: ztypes.declid} out ztypes.declid is {
    cur: declId
    for cur > 0 loop {
        decl: st.typing.decls.get i: cur.u64
        if decl.kind.unitDecl then return cur
        cur = decl.parent
    }
    return (ztypes.declid.create from: 0)
}

# ensureUnitRequire -- a unit's `require:` block states what it needs from the
# host toolchain, which makes it a precondition on using the unit: the FIRST
# declaration demanded from a unit resolves the block first, through the
# ordinary unit machinery, so a block with definitions of its own folds them in
# dependency order. Marking before demanding is what stops the regress --
# folding `library:` demands `platform.cc`, a declaration in `platform`, which
# re-enters here.
ensureUnitRequire: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    declId: ztypes.declid
} is {
    own: owningUnitDecl :st :declId
    if own.isZero then return
    if (st.typing.requireSeen.has item: own.u64) then return
    st.typing.requireSeen.add item: own.u64
    rqn: zast.poolFind pool: ast.names text: "require"
    if rqn.isZero then return
    rq: st.typing.declFindChild parentDeclId: own nameId: rqn
    if rq.isZero then return
    st.typing.requireDemanded.append from: rq
    # a block that is demanded is one this program reaches, so a reached
    # `error` in it -- quadfloat's under tcc -- is this program's to hear, and
    # hearing it HERE is the point of the block: at the moment the unit is
    # first used, not after its C has been written. The ambient pending
    # failure belongs to whatever resolution we interrupted; save it.
    # the block guards on the toolchain, so the platform facts have to be in
    # place before it folds -- earlier than the main pass seeds them. Once.
    if (st.typing.platformSeeded) == false then {
        st.typing.platformSeeded = true
        seedFoldNatives :st :frame :ast
    }
    prevFail: st.typing.constFail
    constFailClear :st
    resolveDemandedDecl :st :frame :ast declId: rq
    # the block resolved as the unit it is; now DEMAND the fold of each entry,
    # which is what a general compile-time expression needs -- the eager
    # namespace walk folds only the simple forms.
    {
        ecnt: st.typing.declChildSlots declId: rq
        ei: u64
        for ei < ecnt loop {
            ec: st.typing.declChildAt declId: rq index: ei
            ei = ei + 1
            if (ec.isZero) == false then {
                enm: st.typing.declNameOf declId: ec
                enode: u32
                {
                    ed: st.typing.decls.get i: ec.u64
                    enode = ed.node
                }
                nameId95: (zast.nameid.create from: (st.typing.declNameOf declId: own))
                hUnitDecl: unitDeclOfName :st nameId: nameId95
                (constValueOfMemberAt
                    :st
                    :ast

                    unitDecl: hUnitDecl
                    ownerDecl: rq
                    nameId: (zast.nameid.create from: enm)
                    defNodeId: enode
                )
            }
        }
    }
    reportPendingConstFail :st
    st.typing.constFail = prevFail
}
# resolveDemandedReexport -- a re-export is a definition like any other, and
# resolving it means FOLLOWING its target. Without this a re-export of a re-export
# stops at the first hop: the second alias is demanded, resolveDef has no leg for
# a bare dotted alias, and the chain ends there.
resolveDemandedReexport: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rf: ztypes.declid
    declId: ztypes.declid
    puDecl: ztypes.declid
    defNameText: StringView
    opId: zast.nodeid
} is {
    # A re-export is a definition like any other, and resolving it means
    # following its target -- which is what resolveAliasKey does, from the
    # declaration. Without this a re-export of a re-export stops at the
    # first hop: the second alias is demanded, resolveDef has no leg for a
    # dotted target that names a NESTED unit, and the chain reads as a
    # member the parent does not have.
    isRx: false
    {
        rdo: st.typing.decls.get i: declId.u64
        if rdo.kind.reexportDecl then isRx = true
    }
    if isRx then {
        resolveAliasKey :st :ast :declId
    } else {
        (resolveDef
            :st
            frame: rf

            :ast
            unitDecl: puDecl
            defName: defNameText
            defnId: (zast.nodeid.create from: opId.u32)
        )
    }
    # A unit-level CONSTANT is a definition like any other, and resolveDef
    # has no leg for the shapes one takes -- a bare literal, a suffixed
    # one, a constant expression. Its type and its value are registered
    # here, where the demanding reference is asking. The eager tier
    # walks every definition of every unit instead, so exactly one of the
    # two speaks.
    if st.typing.eagerAll then return
    (resolveConstantMember
        :st
        frame: rf

        :ast
        unitDecl: puDecl
        defName: defNameText
        defnId: (zast.nodeid.create from: opId.u32)
    )
}
# resolveDemandedNamespace -- a demanded `unit { … }` resolves as the namespace it
# is. A DEMAND for one -- a `require:` block owed before its unit's first
# definition -- has to reach the same door the enclosing walk does, or its members
# never resolve.
resolveDemandedNamespace: function {
    st: zenv.ZSymbolTable
    ast: Ast
    declId: ztypes.declid
    dParent: ztypes.declid
    puDecl: ztypes.declid
    puNm: u32
    defNameText: StringView
    opId: zast.nodeid
} is {
    # A unit is RESOLVED when its unitdef node carries an id; the DEFINED
    # mark on its Decl answers a different question and can be laid by a
    # path that never resolved it as a unit. So the mark does not gate this
    # leg -- only the resolution itself is skipped when the unit is already
    # built, and the debts below are owed however it got there.
    alreadyU: false
    {
        unid: unitdefNodeId :ast nId: opId
        if (unid.isZero) == false then {
            if (ztyping.nodeTypeAt
                tbl: st.typing.nodeType
                nid: unid.u64
            ) > 0 then alreadyU = true
        }
    }
    if (alreadyU) == false then {
        parentTid9: (ztypes.tid.create from: (declTypeIdOf :st declId: puDecl).u64)
        (resolveNamespaceUnit
            :st

            :ast
            unitDecl: puDecl
            defName: defNameText
            parentTid: parentTid9
            parentDeclId: dParent
            unitOpId: opId
        )
    }
    st.typing.declSetDefined :declId
    # Signatures are resolved; the member bodies are owed a walk, which the
    # top-level drain does.
    (st.typing.nsBodiesOwed.append
        (ztyping.nsbody
            unitName: (zast.nameid.create from: puNm)
            unitOp: opId
        )
    )
    # The members just resolved recorded their signature type-refs the way
    # every definition does, and a unit materialises at whatever point
    # something first asks for it -- which can be after the post-demand
    # stamp pass. Stamp them here, as the drain stamps what it resolved:
    # unstamped, a re-exported function's return type reads as nothing and
    # its call sites reach the emitter bare.
    (stampPendingTyperefs
        :st

        :ast
        unitDecl: st.typing.mainUnitRoot
    )
}

# resolveDemandedDecl -- resolve one demanded declaration now, unless it is
# already resolved or mid-resolution: a prelude re-export follows its alias
# to the target; otherwise the dispatch is the unit sweeps' -- a namespace
# or subunit through resolveNamespaceUnit, a template through
# resolveInlineGenericUnit, every other definition through resolveDef.
resolveDemandedDecl: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    declId: ztypes.declid
} is {
    st.typing.declSetPending :declId mark: false
    if (st.typing.declIsResolving :declId) then return
    if (st.typing.declIsDefined :declId) then return
    ensureUnitRequire :st :frame :ast :declId
    # a demanded declaration resolves in the frame it is written in -- its
    # parent -- whatever frame the demand came from
    rf: declParentIdOf :st :declId
    dName: u32
    dParent: ztypes.declid
    dNode: u64
    dTid: ztypes.tid
    {
        decl: st.typing.decls.get i: declId.u64
        dName = decl.name
        dParent = decl.parent
        dNode = decl.node.u64
        dTid = decl.typeId
    }
    if (declAtProgramTop :st parentDeclId: dParent) then return
    puNm: u32
    {
        pdo: st.typing.decls.get i: dParent.u64
        puNm = pdo.name
    }
    defNameText: zast.poolTextAt pool: ast.names ref: (zast.nameid.create from: dName)
    puDecl: unitDeclOfNameOrOwn :st frame: rf nameId: (zast.nameid.create from: puNm)
    # a TEMPLATE's member: the template's own resolution minted every method
    # (resolveInlineGenericUnit), and its constants resolve together, keyed on
    # the template and evaluated in its rf -- the parent's NAME is no
    # unit-index key, so neither leg below could place one.
    if (declDeclaresTemplate :st :ast declId: dParent) then {
        if dTid.isZero then {
            resolveTemplateConstants :st frame: rf :ast tmplDeclId: dParent
        }
        st.typing.declSetDefined :declId
        return
    }
    if dParent == st.typing.coreUnitRoot then {
        if dTid.isZero then {
            resolveAliasKey :st :ast :declId
        }
        return
    }
    if dNode == 0 then return
    opId: zast.nodeid
    {
        nop: ast.nodes.get i: dNode
        if nop.namedoperation then opId = nop.operation
    }
    if opId.isZero then return
    isNs: zast.unitOpDeclaresUnit :ast :opId
    isTmpl: (zast.unitOpKindIs :ast :opId k: zast.unitkind.template)
    if isNs then {
        (resolveDemandedNamespace
            :st
            :ast
            :declId
            :dParent
            :puDecl
            :puNm
            defNameText: defNameText.stringView
            :opId
        )
    } else if isTmpl then {
        parentTid92: (ztypes.tid.create from: (declTypeIdOf :st declId: puDecl).u64)
        (resolveInlineGenericUnit
            :st

            :ast
            unitDecl: puDecl
            defName: defNameText.stringView
            parentTid: parentTid92
            parentDeclId: dParent
            unitOpId: opId
        )
        st.typing.declSetDefined :declId
    } else if (isUnitOp op: (ast.nodes.get i: opId.u64)) then {
        # an inline `unit { ... }` resolves as the namespace it is. The walk
        # reaches one when it walks the enclosing unit; a DEMAND for one --
        # a `require:` block owed before its unit's first definition -- has to
        # reach the same door, or the members never resolve and their
        # constants never fold.
        alreadyI: false
        {
            uni: unitdefNodeId :ast nId: opId
            if (uni.isZero) == false then {
                if (ztyping.nodeTypeAt
                    tbl: st.typing.nodeType
                    nid: uni.u64
                ) > 0 then alreadyI = true
            }
        }
        if (alreadyI) == false then {
            parentTid93: (ztypes.tid.create from: (declTypeIdOf :st declId: puDecl).u64)
            (resolveNamespaceUnit
                :st

                :ast
                unitDecl: puDecl
                defName: defNameText.stringView
                parentTid: parentTid93
                parentDeclId: dParent
                unitOpId: opId
            )
        }
        st.typing.declSetDefined :declId
        return
    } else {
        (resolveDemandedReexport
            :st
            :ast
            :rf
            :declId
            :puDecl
            defNameText: defNameText.stringView
            :opId
        )
    }
}

# resolveDemandedDefs -- resolve every demanded declaration, in discovery
# order, including the ones each resolution demands in turn: a definition's
# body is scanned once its own resolution completes, so a callee is never
# resolved inside its caller's grey window. A drain that is already running
# resolves whatever a nested request queued, so the nested call returns.
resolveDemandedDefs: function {st: zenv.ZSymbolTable frame: ztypes.declid ast: Ast} is {
    if st.typing.drainingDefs then return
    if st.typing.pendingDefs.length == 0 then return
    st.typing.drainingDefs = true
    # a drain runs in a neutral resolution context: it may be requested from
    # inside a body walk, whose template / containment state belongs to that
    # body, not to the definitions resolved here (each of which resolves in
    # the frame of its own declaration)
    rf: frame
    pCe: st.typing.inContainmentEdge
    pSup: st.typing.suppressParamStamps
    pMs: st.typing.curMonoStamp
    pMf: st.typing.curMonoFnTid
    st.typing.inContainmentEdge = false
    st.typing.suppressParamStamps = false
    st.typing.curMonoStamp = 0
    st.typing.curMonoFnTid = ztypes.tid
    i: u64
    for i < st.typing.pendingDefs.length loop {
        d: st.typing.pendingDefs.get :i
        i = i + 1
        resolveDemandedDecl :st frame: rf :ast declId: d
    }
    st.typing.pendingDefs = (ListVal ztypes.declid)
    # after the post-demand stamp pass, a drain stamps what it recorded
    if st.typing.typerefPassRan then {
        (stampPendingTyperefs
            :st

            :ast
            unitDecl: st.typing.mainUnitRoot
        )
    }
    st.typing.inContainmentEdge = pCe
    st.typing.suppressParamStamps = pSup
    st.typing.curMonoStamp = pMs
    st.typing.curMonoFnTid = pMf
    st.typing.drainingDefs = false
}

# scanCallsInNode -- the body-walk pre-pass: every name a subtree references
# demands the definition the scanning unit's environment holds for it, so the
# callee is resolved before the walk runs. A bare callable or atom walks the
# unit's frames (unit, then prelude); a qualified unit.member goes straight to
# that unit's member; `return` pulls return and never. A local variable or a
# member finds no definition and demands nothing.
scanCallsInNode: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast.view
    node: Node.view
} is {
    # the unit frame once: the demands below lend st
    uFr: unitFrameOf :st declId: frame
    match (
        node
    ) case call then {
        cn: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: node.callable.u64))
        if cn.stringView == "return" then {
            scFr: unitFrameOf :st declId: frame
            demandDefinition :st frame: scFr nameId: zast.names.wkReturn
            (demandDefinition
                :st
                frame: scFr
                nameId: (zast.poolFind pool: ast.names text: "never")
            )
        } else {
            if cn.length > 0 then (demandDefinition
                :st
                frame: uFr
                nameId: (atomNameId :ast n: (ast.nodes.get i: node.callable.u64))
            )
        }
        scanCallsIn :st :frame :ast ids: (zast.childIdsAt :ast id: node.nodeid.u32)
    } case atomid then {
        # bare body identifiers demand main-unit definitions (unit constants,
        # data blocks); non-definition names never match a demanded def.
        scN: ast.names.texts.get i: node.name.u64
        if (isNumericLiteralName name: scN.stringView) == false then {
            (demandDefinition
                :st
                frame: uFr
                nameId: node.name
            )
        }
    } case binop then {
        # the operator atom names a method, never a definition to demand
        scanCallsInNode :st :frame :ast node: (ast.nodes.get i: node.lhs.u64)
        scanCallsInNode :st :frame :ast node: (ast.nodes.get i: node.rhs.u64)
    } case statement then {
        # the block shapes descend through their OWN child lists: the generic
        # arm below builds one per node visited, and these four are most of
        # the nodes there are
        scanCallsIn :st :frame :ast ids: node.statements
    } case statementline then {
        scanCallsInNode :st :frame :ast node: (ast.nodes.get i: node.statementline.u64)
    } case expression then {
        scanCallsInNode :st :frame :ast node: (ast.nodes.get i: node.expression.u64)
    } case assignment then {
        scanCallsInNode :st :frame :ast node: (ast.nodes.get i: node.value.u64)
    } case ifexpr then {
        # Deliberately branch-blind. This pass runs before resolveConstantDefs,
        # so no fold exists yet and a dead clause's names are demanded anyway.
        # Over-demanding is CONSERVATIVE, and the invariant it protects is that
        # the constant fold may only ever remove EMISSION -- never change which
        # names resolve, and never be the thing that reports an error from a
        # branch that cannot run. That is why a reached `error` is reported by
        # the evaluator, which visits only the winning branch, and not by a
        # walk like this one, which sees every arm.
        for clId: node.clauses.iterate loop {
            scanCallsInNode :st :frame :ast node: (ast.nodes.get i: clId.u64)
        }
        scanBodyAt :st :frame :ast bodyId: node.elseclause
    } case forexpr then {
        (demandDefinition
            :st
            frame: uFr
            nameId: (zast.poolFind pool: ast.names text: "never")
        )
        scanCallsIn :st :frame :ast ids: (zast.childIdsAt :ast id: node.nodeid.u32)
    } case doexpr then {
        doFr: unitFrameOf :st declId: frame
        (demandDefinition
            :st
            frame: doFr
            nameId: (zast.poolFind pool: ast.names text: "never")
        )
        if (blockHasBreak :ast n: (ast.nodes.get i: node.statement.u64)) then {
            (demandDefinition
                :st
                frame: doFr
                nameId: (zast.poolFind pool: ast.names text: "optionval")
            )
        }
        scanCallsInNode :st :frame :ast node: (ast.nodes.get i: node.statement.u64)
    } case dottedpath then {
        bn: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: node.parent.u64))
        if bn.length > 0 then {
            (demandDefinition
                :st
                frame: uFr
                nameId: (atomNameId :ast n: (ast.nodes.get i: node.parent.u64))
            )
            # a unit-qualified member (io.stdout) demands exactly that member
            isUnitQ: nameDenotesUnit :st :frame nameId: (atomNameId
                :ast
                n: (ast.nodes.get i: node.parent.u64)
            )
            if isUnitQ then {
                mn0: (zast.nameTextAt
                    :ast
                    ref: (atomNameId :ast n: (ast.nodes.get i: node.child.u64))
                )
                if mn0.length > 0 then (demandUnitMember
                    :st
                    unitNameId: (atomNameId :ast n: (ast.nodes.get i: node.parent.u64))
                    nameId: (atomNameId :ast n: (ast.nodes.get i: node.child.u64))
                )
            }
        }
        # the member selector is never a definition to demand
        scanCallsInNode :st :frame :ast node: (ast.nodes.get i: node.parent.u64)
    } case caseclause then {
        # the arm pattern is never a definition to demand
        scanCallsInNode :st :frame :ast node: (ast.nodes.get i: node.statement.u64)
    } case functiondef then null case objectdef then null case unitdef then null case program then null case datablock then null case labelvalue then null else {
        scanCallsIn :st :frame :ast ids: (zast.childIds :ast n: node)
    }
}

scanCallsIn: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast.view
    ids: (ListVal u32).view
} is {
    with it: ids.iterate do for c: it loop {
        scanCallsInNode :st :frame :ast node: (ast.nodes.get i: c.u64)
    }
}

# scanBodyAt -- scan a function body table id for call demands (0 = absent).
scanBodyAt: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast.view
    bodyId: zast.nodeid
} is {
    if bodyId > 0 then (scanCallsInNode
        :st
        :frame
        :ast
        node: (ast.nodes.get i: bodyId.u64)
    )
}

# scanDefCalls -- scan a functiondef's body, or an objectdef's is/as method
# bodies, for call demands. A type constructed only inside a method body must be
# demanded here or it never resolves and the construction stamps type 0.
scanDefCalls: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast.view
    op: Node.view
} is {
    match (
        op
    ) case functiondef then {
        scanBodyAt :st :frame :ast bodyId: op.body
    } case objectdef then {
        iiter: op.isItems.iterate
        for imId: iiter loop {
            im: ast.nodes.get i: imId.u64
            match (
                im
            ) case namedoperation then {
                if (isFunctionDefWithBody o: (ast.nodes.get i: im.operation.u64)) then (scanDefCalls
                    :st
                    :frame
                    :ast
                    op: (ast.nodes.get i: im.operation.u64)
                )
            } else null
        }
        aiter: op.asItems.iterate
        for amId: aiter loop {
            am: ast.nodes.get i: amId.u64
            match (
                am
            ) case namedoperation then {
                if (isFunctionDefWithBody o: (ast.nodes.get i: am.operation.u64)) then (scanDefCalls
                    :st
                    :frame
                    :ast
                    op: (ast.nodes.get i: am.operation.u64)
                )
            } else null
        }
    } else null
}

# scanMainBodyCalls -- record call-target demands for every function body in the
# main unit (the body walk reaches them; demand must precede the pass).
scanMainBodyCalls: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    program: Node.view
    rootOnly: bool
} is {
    match (
        program
    ) case program then {
        unitDecl: st.typing.mainUnitRoot
        uCnt9f: program.ast.units.length
        uIdx9f: u64
        for uIdx9f < uCnt9f loop {
            uId: (zast.nodeid.create from: (program.ast.units.get i: uIdx9f))
            uIdx9f = uIdx9f + 1
            opId: zast.nodeid
            eager: false
            {
                u: program.ast.nodes.get i: uId.u64
                if u.namedoperation then {
                    uc1z: unitDeclOfNameOrOwn :st :frame nameId: u.name
                    if uc1z == unitDecl then eager = true
                    opId = u.operation
                }
            }
            if eager when opId > 0 then {
                (scanUnitCalls
                    :st
                    :frame

                    ast: program.ast
                    unitdefId: opId
                    :rootOnly
                )
            }
        }
    } else null
}

# scanUnitCalls -- scan each function definition's body in a unit for call demands.
scanUnitCalls: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast.view
    unitdefId: zast.nodeid
    rootOnly: bool
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    for bmId: bodyIds.iterate loop {
        bm: ast.nodes.get i: bmId.u64
        if bm.namedoperation then {
            scanIt: true
            if rootOnly then {
                bnm: zast.nameTextAt :ast ref: bm.name
                if bnm.stringView != "main" then scanIt = false
            }
            if scanIt then {
                scanDefCalls :st :frame :ast op: (ast.nodes.get i: bm.operation.u64)
            }
        }
    }
}

# demandReturnNever -- the builtins a walked or synthesized body uses without
# naming them in source: system's `return` and its `never` result.
demandReturnNever: function {st: zenv.ZSymbolTable ast: Ast.view} is {
    sysId: nameIdOf :ast name: "system"
    demandUnitMember :st unitNameId: sysId nameId: zast.names.wkReturn
    demandUnitMember :st unitNameId: sysId nameId: (zast.poolFind pool: ast.names text: "never")
}

seedBodyWalkDemands: function {st: zenv.ZSymbolTable frame: ztypes.declid program: Node.view} is {
    match (
        program
    ) case program then {
        unitDecl: st.typing.mainUnitRoot
        found: false
        uiter: program.ast.units.iterate
        for uId: uiter loop {
            u: program.ast.nodes.get i: uId.u64
            match (
                u
            ) case namedoperation then {
                uc2z: unitDeclOfNameOrOwn :st :frame nameId: u.name
                if uc2z == unitDecl then {
                    if (unitHasObjectMethodBody
                        ast: program.ast
                        defId: u.operation
                    ) then found = true
                }
            } else null
        }
        if found then demandReturnNever :st ast: program.ast
    } else null
}

# resolveDemands -- resolve everything the program has demanded so far, and
# everything those resolutions demand in turn: the body-walk seeds first, then
# the queue to exhaustion. Each unit's one-time conformance pass runs from the
# drain the first time one of its definitions resolves.
resolveDemands: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    program: Node
} is {
    seedBodyWalkDemands :st :frame :program
    match (
        program
    ) case program then {
        resolveDemandedDefs :st :frame ast: program.ast
    } else null
}

# instCallablePath -- an instantiation callable's name path as pool ids,
# outermost first: `mathops` -> [mathops], `helperu.mathops` -> [helperu,
# mathops]. A segment that is not a plain name appends 0, which
# instTemplateDecl then rejects -- there is no name to look up.
instCallablePath: function {ast: Ast.view op: Node.view segs: (ListVal u64)} is {
    match (
        op
    ) case expression then {
        instCallablePath :ast op: (ast.nodes.get i: op.expression.u64) :segs
    } case dottedpath then {
        instCallablePath :ast op: (ast.nodes.get i: op.parent.u64) :segs
        segs.append (atomNameId :ast n: (ast.nodes.get i: op.child.u64)).u64
    } case atomid then {
        segs.append op.name.u64
    } else {
        segs.append 0
    }
}

# callableInstPath -- the path of a binding whose value is a (possibly
# expression-wrapped) call. Empty for anything else, which is what says a
# binding is not an instantiation. The whole path, not a single atom name: a
# dotted callable names another unit's template.
callableInstPath: function {ast: Ast.view op: Node.view segs: (ListVal u64)} is {
    match (
        op
    ) case expression then {
        callableInstPath :ast op: (ast.nodes.get i: op.expression.u64) :segs
    } case call then {
        instCallablePath :ast op: (ast.nodes.get i: op.callable.u64) :segs
    } else null
}

# callableUnitName -- the callable's bare name when a binding value is a
# (possibly expression-wrapped) call, else "". A for-loop's inline generator
# iterable is named this way; a generic-unit instantiation is not -- it reads
# callableInstPath, which a dotted callable does not defeat.
callableUnitName: function {ast: Ast.view op: Node.view} out String is {
    match (
        op
    ) case expression then {
        return (callableUnitName :ast op: (ast.nodes.get i: op.expression.u64))
    } case call then {
        return (atomName :ast n: (ast.nodes.get i: op.callable.u64))
    } else {
        return "".string
    }
}


# declParentIdOf -- a declaration's enclosing declaration (0 at the program root).
# declNameIdOf -- a declaration's own name id, or 0.
declNameIdOf: function {st: zenv.ZSymbolTable.view declId: ztypes.declid} out zast.nameid is {
    decl: st.typing.decls.get i: declId.u64
    return (zast.nameid.create from: decl.name)
}

# unitRootOfDecl -- the top-level unit root a declaration sits under: the
# parent chain to the program root's own child. A definition of a NESTED unit
# answers with the file unit that loaded it, which is the unit the name walkers
# and the diagnostics are keyed on.
unitRootOfDecl: function {st: zenv.ZSymbolTable.view declId: ztypes.declid} out ztypes.declid is {
    cur: declId
    for cur > 0 loop {
        par: ztypes.declid
        {
            decl: st.typing.decls.get i: cur.u64
            par = decl.parent
        }
        if (declAtProgramTop :st parentDeclId: par) then return cur
        cur = par
    }
    return (ztypes.declid.create from: 0)
}

declParentIdOf: function {st: zenv.ZSymbolTable.view declId: ztypes.declid} out ztypes.declid is {
    r: ztypes.declid
    decl: st.typing.decls.get i: declId.u64
    r = decl.parent
    return r
}

# declAtProgramTop -- is this parent id the top of the declaration tree: no
# parent at all, or the program root whose children are the file units? The
# question every walk out of a file unit asks.
declAtProgramTop: function {st: zenv.ZSymbolTable.view parentDeclId: ztypes.declid} out bool is {
    if parentDeclId.isZero then return true
    if parentDeclId == st.typing.programRoot then return true
    return false
}

# instTemplateDecl -- the DECLARATION an instantiation's callable path names,
# resolved through the scope the instantiation was WRITTEN in: this namespace,
# then each enclosing one out to the unit root, then a file unit of that name.
# Nothing reaches into another unit except by naming it -- a dependency unit
# cannot see the main unit's constants or namespaces, and an instantiation is
# no different. 0 when the path names no declaration.
instTemplateDecl: function {
    st: zenv.ZSymbolTable.view
    scopeDeclId: ztypes.declid
    segs: (ListVal u64).view
} out ztypes.declid is {
    cur: ztypes.declid
    if segs.length == 0 then return cur
    s0v: segs.get i: 0
    if s0v == 0 then return cur
    s0: zast.nameid.create from: s0v.u32.orPanic
    probe: scopeDeclId
    for probe > 0 loop {
        c: st.typing.declFindChild parentDeclId: probe nameId: s0
        if (c.isZero) == false then cur = c
        if (cur.isZero) == false then {
            probe = ztypes.declid.create from: 0
        } else {
            probe = declParentIdOf :st declId: probe
        }
    }
    if cur.isZero then {
        ro: st.typing.declFindChild parentDeclId: st.typing.programRoot nameId: s0
        if (ro.isZero) == false then cur = ro
    }
    if cur.isZero then return cur
    si: u64
    si = 1
    for si < segs.length loop {
        sv: segs.get i: si
        if sv == 0 then return (ztypes.declid.create from: 0)
        cur = (st.typing.declFindChild
            parentDeclId: cur
            nameId: (zast.nameid.create from: sv.u32.orPanic)
        )
        if cur.isZero then return cur
        si = si + 1
    }
    return cur
}

# instTemplateOpOf -- the unitdef node a template declaration introduces, and 0
# when the declaration is not a generic unit at all. Both spellings count: an
# inline `unit as {...}` parses as `template`, and a generic FILE unit's root
# keeps its own kind but declares a generic parameter.
instTemplateOpOf: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out zast.nodeid is {
    none: zast.nodeid
    if declId.isZero then return none
    dn: u32
    {
        decl: st.typing.decls.get i: declId.u64
        dn = decl.node
    }
    if dn == 0 then return none
    opNode: zast.nodeid
    {
        nop: ast.nodes.get i: dn.u64
        if nop.namedoperation then opNode = nop.operation
    }
    if opNode.isZero then return none
    if (zast.unitOpKindIs :ast opId: opNode k: zast.unitkind.template) then return opNode
    udn: unitdefNodeId :ast nId: opNode
    if udn.isZero then return none
    if (unitDefIsGeneric :ast oId: udn) then return opNode
    return none
}


# declTypeIdOf -- the type a declaration carries (0 until one is bound).
declTypeIdOf: function {st: zenv.ZSymbolTable.view declId: ztypes.declid} out ztypes.tid is {
    r: ztypes.tid
    decl: st.typing.decls.get i: declId.u64
    r = decl.typeId
    return r
}

# collectMainInstantiations -- scan a unit body for generic-unit instantiation bindings
# and append the mono name ({template}_{arg}) + template name to the parallel lists.
# InstReq -- one generic-unit instantiation binding (intmath: (mathops t: i64)):
# the names the mint needs plus the binding's node ids for the instantiation stamps.
InstReq: class {
    # the unit the instantiation was WRITTEN in. Every lookup a request drives
    # -- the template, the type arguments, the binding name -- is relative to
    # it, and reading them off the main unit is why a generic unit worked only
    # there.
    declUnit: ztypes.declid
    bindId: zast.nameid
    tmplId: zast.nameid
    # the template's own id, the unitdef node that declares it, and the unit
    # whose AST that node lives in -- all resolved at COLLECTION, through the
    # scope the instantiation was written in. A name reached only a top-level
    # binding of the instantiating unit; an id reaches a dotted or
    # namespace-nested template too.
    tmplTid: ztypes.tid
    tmplDeclId: ztypes.declid
    tmplOpId: u64
    tmplUnit: ztypes.declid
    # the Decl the instantiation was written under: the unit root, or the
    # namespace when it is nested. Where the binding's own name belongs.
    scopeDeclId: ztypes.declid
    argLabels: (ListVal zast.nameid)
    argNames: (List String)
    argAtomIds: (ListVal u64)
    # every argument's operation node, whatever its shape: a bare atom names
    # its type (argNames); a call-shaped argument -- itself a specialisation,
    # `(Box t: i64)` -- has no name and resolves from this node
    argNodeIds: (ListVal u64)
    exprId: u64
    callId: u64
    calId: u64
}

# instFillIds -- record the instantiation's expression/call/callable/arg node
# ids on the request; all four stamp at binding resolution.
instFillIds: function {ast: Ast.view r: InstReq op: Node.view} is {
    match (
        op
    ) case expression then {
        r.exprId = op.nodeid.u64
        instFillIds :ast :r op: (ast.nodes.get i: op.expression.u64)
    } case call then {
        r.callId = op.nodeid.u64
        instFillCallable :r op: (ast.nodes.get i: op.callable.u64)
    } else null
}

# fill an instantiation request's callable from operation `op`.
instFillCallable: function {r: InstReq op: Node.view} is {
    match (
        op
    ) case atomid then {
        r.calId = op.nodeid.u64
    } case dottedpath then {
        r.calId = op.nodeid.u64
    } else null
}

# the atom id of an instantiation-call argument.
instArgAtomId: function {ast: Ast.view op: Node.view} out u64 is {
    match (
        op
    ) case expression then {
        return (instArgAtomId :ast op: (ast.nodes.get i: op.expression.u64))
    } case atomid then {
        return op.nodeid.u64
    } else {
        return 0
    }
}

# fillUnitArgs -- capture every instantiation argument (param label + type/value
# name + atom id) in declaration order, so a unit monomorphises over ALL its
# generic parameters, not just the first.
fillUnitArgs: function {ast: Ast.view r: InstReq op: Node.view} is {
    match (
        op
    ) case expression then {
        fillUnitArgs :ast :r op: (ast.nodes.get i: op.expression.u64)
    } case call then {
        aiter: op.arguments.iterate
        for a9Id: aiter loop {
            a: ast.nodes.get i: a9Id.u64
            match (
                a
            ) case namedoperation then {
                anm: atomName :ast n: (ast.nodes.get i: a.operation.u64)
                aid: instArgAtomId :ast op: (ast.nodes.get i: a.operation.u64)
                r.argLabels.append a.name
                r.argNames.append anm
                r.argAtomIds.append aid
                r.argNodeIds.append a.operation.u64
            } else null
        }
    } else null
}

# collect the generic instantiation requests reachable from main.
collectMainInstantiations: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    o: Node.view
    unitDecl: ztypes.declid
    scopeDeclId: ztypes.declid
    reqs: List InstReq
} is {
    match (
        o
    ) case unitdef then {
        biter: o.body.iterate
        for bm: biter loop {
            bmNode: ast.nodes.get i: bm.u64
            match (
                bmNode
            ) case namedoperation then {
                mop: ast.nodes.get i: bmNode.operation.u64
                # a namespace or subunit is a scope of its own: descend, so an
                # instantiation written one level in is collected too. A
                # template is not descended into -- it declares, it does not
                # instantiate.
                if (zast.unitOpDeclaresUnit :ast opId: bmNode.operation) then {
                    (collectMainInstantiations
                        :st
                        :ast
                        o: mop
                        :unitDecl
                        scopeDeclId: (st.typing.declFindChild
                            parentDeclId: scopeDeclId
                            nameId: bmNode.name
                        )
                        :reqs
                    )
                } else {
                    segs: (ListVal u64)
                    callableInstPath :ast op: mop :segs
                    tdecl: instTemplateDecl :st :scopeDeclId :segs
                    topId: instTemplateOpOf :st :ast declId: tdecl
                    tnId: zast.nameid
                    if segs.length > 0 then {
                        lastv: segs.get i: (segs.length - 1)
                        if lastv > 0 then tnId = (zast.nameid.create from: lastv.u32.orPanic)
                    }
                    if (tnId.isZero) == false then {
                        tuN: unitRootOfDecl :st declId: tdecl
                        r: (InstReq
                            declUnit: unitDecl
                            bindId: bmNode.name
                            tmplId: tnId
                            tmplTid: (declTypeIdOf :st declId: tdecl)
                            tmplDeclId: tdecl
                            tmplOpId: topId.u64
                            tmplUnit: tuN
                            :scopeDeclId
                            argLabels: (ListVal zast.nameid)
                            argNames: (List String)
                            argAtomIds: (ListVal u64)
                            argNodeIds: (ListVal u64)
                            exprId: 0
                            callId: 0
                            calId: 0
                        )
                        fillUnitArgs :ast :r op: mop
                        instFillIds :ast :r op: mop
                        reqs.append r
                    }
                }
            } else null
        }
    } else null
}

# scanMainForInstantiations -- collect every unit's instantiation requests.
# Its own function scope bounds the program.ast.units iterator so it releases before the
# mono-creation pass (which iterates program.ast.units again).
scanMainForInstantiations: function {
    st: zenv.ZSymbolTable.view
    frame: ztypes.declid
    program: Node.view
    reqs: List InstReq
} is {
    match (
        program
    ) case program then {
        uiter: program.ast.units.iterate
        for uId: uiter loop {
            u: program.ast.nodes.get i: uId.u64
            match (
                u
            ) case namedoperation then {
                rd: ztypes.declid
                {
                    ro: (st.typing.declFindChild
                        parentDeclId: st.typing.programRoot
                        nameId: (zast.nameid.create from: u.name)
                    )
                    if (ro.isZero) == false then rd = ro
                }
                (collectMainInstantiations
                    :st
                    ast: program.ast
                    o: (program.ast.nodes.get i: u.operation.u64)
                    unitDecl: (unitDeclOfNameOrOwn :st :frame nameId: u.name)
                    scopeDeclId: rd
                    :reqs
                )
            } else null
        }
    } else null
}

# attachMonoUnitFuncs -- add a JOIN-only FUNCTION shell child per function
# in the template unit's body. The mono function rows are defined_in_unit=NULL (excluded
# from the filtered dump), so no params are resolved -- only the names matter for the JOIN.
attachMonoUnitFuncs: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    monoId: ztypes.tid
    templateOpId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: templateOpId
    {
        fiter: bodyIds.iterate
        for fm: fiter loop {
            fmNode: ast.nodes.get i: fm.u64
            match (
                fmNode
            ) case namedoperation then {
                if (isFunctionDefOp op: (ast.nodes.get i: fmNode.operation.u64)) then {
                    fn: zast.nameTextAt :ast ref: fmNode.name
                    shellId: (st.reg.newType
                        name: fn.stringView
                        ownerTid: monoId
                        typetype: ztypes.ztypetype.functionType
                    )
                    (st.typing.declSynthMember
                        parentTypeId: monoId
                        nameId: fmNode.name
                        kind: ztyping.declkind.methodDecl
                    )
                    (st.typing.setMemberType
                        parentTypeId: monoId
                        nameId: fmNode.name
                        childTypeId: shellId
                    )
                }
            } else null
        }
    }
}

# resolveUnitMono -- create a mono UNIT (mangled name, defined_in_unit=the instantiating
# unit) with JOIN-only function-shell children from the template's body, then seed
# return/never demand (the template functions have bodies). Skips when already resolved
# or the template unit is not found.
# isIteratorCall -- true when a type-expr is a call to `Iterator` (a generator's
# `out (Iterator gives: T)` return), peeling an expression wrapper.
isIteratorCall: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case expression then {
        return (isIteratorCall :ast op: (ast.nodes.get i: op.expression.u64))
    } case call then {
        cn: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: op.callable.u64))
        return (cn.stringView == "Iterator")
    } else {
        return false
    }
}

# isGeneratorReturn -- true when a function's return type is the Iterator protocol
# (i.e. the function is a generator that lowers to a synth iterator class).
isGeneratorReturn: function {ast: Ast.view oId: zast.nodeid} out bool is {
    if oId.isZero then return false
    o: ast.nodes.get i: oId.u64
    return (isIteratorCall :ast op: o)

}

# subtreeHasYield -- true if a node subtree contains a yield expression.
subtreeHasYield: function {ast: Ast.view node: Node.view} out bool is {
    match (
        node
    ) case yieldexpr then {
        return true
    } case statement then {
        siter: node.statements.iterate
        for stId: siter loop {
            if (subtreeHasYield :ast node: (ast.nodes.get i: stId.u64)) then return true
        }
        return false
    } case statementline then {
        sln: ast.nodes.get i: node.statementline.u64
        return (subtreeHasYield :ast node: sln)
    } case expression then {
        return (subtreeHasYield :ast node: (ast.nodes.get i: node.expression.u64))
    } case forexpr then {
        if node.body.isZero then return false
        return (subtreeHasYield :ast node: (ast.nodes.get i: node.body.u64))
    } case ifexpr then {
        cliter: node.clauses.iterate
        for clId: cliter loop {
            if (subtreeHasYield :ast node: (ast.nodes.get i: clId.u64)) then return true
        }
        if node.elseclause.isZero then return false
        return (subtreeHasYield :ast node: (ast.nodes.get i: node.elseclause.u64))
    } case ifclause then {
        return (subtreeHasYield :ast node: (ast.nodes.get i: node.statement.u64))
    } else {
        return false
    }
}

# nodeIsYieldingLoop -- true when a statement (peeling statementline/expression) is a
# for-loop whose body contains a yield.
nodeIsYieldingLoop: function {ast: Ast.view node: Node.view} out bool is {
    match (
        node
    ) case statementline then {
        statementlineNode: ast.nodes.get i: node.statementline.u64
        return (nodeIsYieldingLoop :ast node: statementlineNode)
    } case expression then {
        return (nodeIsYieldingLoop :ast node: (ast.nodes.get i: node.expression.u64))
    } case forexpr then {
        if node.body.isZero then return false
        return (subtreeHasYield :ast node: (ast.nodes.get i: node.body.u64))
    } else {
        return false
    }
}

# bodyHasYieldingLoop -- true when a function body (a table id, 0 = absent) contains a
# yielding loop. Generators with one promote their straight-line locals to fields.
bodyHasYieldingLoop: function {ast: Ast.view bodyId: zast.nodeid} out bool is {
    if bodyId.isZero then return false
    return (blockHasYieldingLoop :ast blk: (ast.nodes.get i: bodyId.u64))
}
# true when `blk` contains a loop that yields (a generator body).
blockHasYieldingLoop: function {ast: Ast.view blk: Node.view} out bool is {
    match (
        blk
    ) case statement then {
        siter: blk.statements.iterate
        for stId: siter loop {
            if (nodeIsYieldingLoop :ast node: (ast.nodes.get i: stId.u64)) then return true
        }
        return false
    } else {
        return false
    }
}

# nameIdOf -- the pool id of an already-interned name. 0 (absent) is what
# every symbol-table query treats as a miss, so a name the pool never saw
# cannot resolve -- which is exactly right, since nothing declared it.
# nameIdOf -- nameIdOf widened for the u64-keyed unit-name table. A method
# on a CALL RESULT emits `&<call>`, which is not an lvalue, so the widening
# cannot ride the call site.
nameIdOf: function {ast: Ast.view name: StringView} out zast.nameid is {
    return (zast.poolFind pool: ast.names text: name)
}

# assignmentLocalName -- the pool id of the local a statement-line binds via
# `name: value`, or 0.
assignmentLocalName: function {ast: Ast.view line: Node.view} out zast.nameid is {
    match (
        line
    ) case statementline then {
        return (assignmentInnerName s: (ast.nodes.get i: line.statementline.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}
# the bound name of assignment statement `s`.
assignmentInnerName: function {s: Node.view} out zast.nameid is {
    match (
        s
    ) case assignment then {
        return s.name
    } else {
        return (zast.nameid.create from: 0)
    }
}

# addPromotedLocals -- add a field (i64) per top-level local binding in a generator body
# (the loop-carried counters promoted to iter-class fields).
addPromotedLocals: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    iterId: u64
    bodyId: zast.nodeid
} is {
    if bodyId > 0 then {
        addPromotedLocalsBlk :st :frame :ast :iterId blkId: bodyId
    }
}
# add generator-promoted locals as fields of the synthesised iterator.
addPromotedLocalsBlk: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    iterId: u64
    blkId: zast.nodeid
} is {
    nL: zast.stmtLineCount :ast nid: blkId
    k: u64
    for k < nL loop {
        stId: (zast.stmtLineAt :ast nid: blkId i: k).u32
        k = k + 1
        nm: assignmentLocalName :ast line: (ast.nodes.get i: stId.u64)
        if nm != 0 then {
            lf: (resolveAtomType
                :st
                :frame

                :ast
                unitDecl: ztypes.declid
                nm: "i64"
                thisName: ""
            )
            (st.typing.setMemberType
                parentTypeId: (ztypes.tid.create from: iterId.u64)
                nameId: nm
                childTypeId: lf
            )
        }
    }
}

# synthGeneratorIterClass -- synthesize the `<fn>_iter` CLASS a generator lowers
# to: a `state: i64` field, a `create` method (param `state: i64`), and a `call`
# method (receiver `this`, BORROW), all defined in the generator's unit; seeds the
# return/never demand (the lowered methods have bodies).
# addResumeInput -- for a bidirectional generator (`accepts: U` in the Iterator
# return), add the `_resume_input: U` field to the iter class and a `value: U` param
# (with the annotated ownership) to its `call` method.
addResumeInput: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    iterId: u64
    callId: u64
    returntypeId: zast.nodeid
} is {
    if returntypeId.isZero then return
    addResumeInputExpr :st :frame :ast :iterId :callId rtId: returntypeId

}
# add the resume-input expression to a generator's step body.
addResumeInputExpr: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    iterId: u64
    callId: u64
    rtId: zast.nodeid
} is {
    arm: rowArmAt :ast nid: rtId
    match (
        arm
    ) case expression then {
        wrap: exprRefAt :ast nid: rtId
        addResumeInputExpr :st :frame :ast :iterId :callId rtId: wrap.expression
    } case call then {
        cr: callRefAt :ast nid: rtId
        kA: u64
        for kA < cr.nargs loop {
            argId: (zast.callArgAt :ast nid: cr.nid i: kA).u32
            kA = kA + 1
            arg: argRefAt :ast nid: (zast.nodeid.create from: argId.u32)
            if (arg.nid.isZero) == false then {
                # an owned copy: the walks below lend ast
                an: zast.nameTextCopy :ast ref: arg.name
                if an.stringView == "Accepts" then {
                    tn: baseTypeName :ast n: (ast.nodes.get i: arg.operation.u64)
                    rf: (resolveAtomType
                        :st
                        :frame

                        :ast
                        unitDecl: ztypes.declid
                        nm: tn.stringView
                        thisName: ""
                    )
                    (st.typing.setMemberType
                        parentTypeId: (ztypes.tid.create from: iterId.u64)
                        nameId: zast.names.wkResumeInput
                        childTypeId: rf
                    )
                    vf: (resolveAtomType
                        :st
                        :frame

                        :ast
                        unitDecl: ztypes.declid
                        nm: tn.stringView
                        thisName: ""
                    )
                    (st.typing.setMemberType
                        parentTypeId: (ztypes.tid.create from: callId.u64)
                        nameId: zast.names.wkValue
                        childTypeId: vf
                    )
                    own: pathOwnership :ast n: (ast.nodes.get i: arg.operation.u64)
                    match (
                        own
                    ) case some then {
                        (st.typing.setChildOwnershipId
                            parentTypeId: (ztypes.tid.create from: callId.u64)
                            nameId: zast.names.wkValue
                            ownership: own
                        )
                    } case none then null
                }
            }
        }
    } else null
}

# condIterableCallable -- the callable name of a for-loop's inline iterable (a
# `binding: (gen ...)` condition), or "". A `while` condition (no binding) yields "".
condIterableCallable: function {ast: Ast.view conds: (ListVal u32).view} out String is {
    citer: conds.iterate
    for cId: citer loop {
        c: ast.nodes.get i: cId.u64
        match (
            c
        ) case namedoperation then {
            cb: callableUnitName :ast op: (ast.nodes.get i: c.operation.u64)
            if cb.length != 0 then return cb
        } else null
    }
    return "".string
}

# forIterableCallable -- for a yielding for-loop whose iterable is a generator call,
# the callable name; "" otherwise (peels statementline/expression).
forIterableCallable: function {ast: Ast.view e: Node.view} out String is {
    match (
        e
    ) case statementline then {
        sln: ast.nodes.get i: e.statementline.u64
        return (forIterableCallable :ast e: sln)
    } case expression then {
        return (forIterableCallable :ast e: (ast.nodes.get i: e.expression.u64))
    } case forexpr then {
        hy: false
        if e.body > 0 then {
            eb: ast.nodes.get i: e.body.u64
            hy = subtreeHasYield :ast node: eb
        }
        if hy then {
            return (condIterableCallable :ast conds: e.conditions)
        } else {
            return "".string
        }
    } else {
        return "".string
    }
}

# addInlineIterFields -- add an `_iterN: <callable>_iter` field per yielding for-loop
# whose iterable is an inline generator call (chain/map_filter's nested pipeline). The
# field is typed by the nested generator's iter class; no create param (that lives on
# the excluded NULL-unit create).
addInlineIterFields: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    iterId: u64
    bodyId: zast.nodeid
} is {
    if bodyId > 0 then {
        addInlineIterFieldsBlk :st :frame :ast :iterId blkId: bodyId
    }
}
# add inline iterator-state fields for a block.
addInlineIterFieldsBlk: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    iterId: u64
    blkId: zast.nodeid
} is {
    n: u64
    nL: zast.stmtLineCount :ast nid: blkId
    k: u64
    for k < nL loop {
        stId: (zast.stmtLineAt :ast nid: blkId i: k).u32
        k = k + 1
        cb: forIterableCallable :ast e: (ast.nodes.get i: stId.u64)
        if cb.length != 0 then {
            fieldName: "_iter\{n}"
            fieldType: "\{cb.stringView}_iter"
            ft: (resolveAtomType
                :st
                :frame

                :ast
                unitDecl: ztypes.declid
                nm: fieldType.stringView
                thisName: ""
            )
            (st.typing.setMemberType
                parentTypeId: (ztypes.tid.create from: iterId.u64)
                nameId: (ast.internString text: fieldName.stringView)
                childTypeId: ft
            )
            n = n + 1
        }
    }
}

# synthGeneratorForMethod -- synthesize the iter class for a generator METHOD (an
# as-block method whose return is the Iterator protocol). thisName is the enclosing
# type, so a `this`-typed captured param (b: this.private.lock) resolves to it.
synthGeneratorForMethod: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    fnName: StringView
    thisName: StringView
    opId: zast.nodeid
} is {
    fr: fnRefAt :ast nid: opId
    if fr.nid.isZero then return
    if (isGeneratorReturn :ast oId: fr.returntype) then {
        synthGeneratorIterClass :st :frame :ast :unitDecl :fnName :thisName fnode: fr
    }
}

# synthesise the iterator class that lowers a generator function.
synthGeneratorIterClass: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    fnName: StringView
    thisName: StringView
    fnode: fnref
} is {
    iterName: "\{fnName}_iter"
    iterId: st.reg.newType name: iterName.stringView typetype: ztypes.ztypetype.classType
    st.reg.setValtype typeId: iterId value: false
    # the synthesized iter class has no Decl of its own; its closest
    # declaration is the generator function it was lowered from
    gfp: declOfUnitDef :st :frame :unitDecl nameId: (nameIdOf :ast name: fnName)
    if gfp > 0 then st.reg.setDef typeId: iterId declId: gfp
    needsDtor: false
    st1: resolveAtomType :st :frame :ast :unitDecl nm: "i64" thisName: ""
    st.typing.setMemberType parentTypeId: iterId nameId: zast.names.wkState childTypeId: st1
    createId: st.reg.newType name: "create" ownerTid: iterId typetype: ztypes.ztypetype.functionType
    if gfp > 0 then st.reg.setDef typeId: createId declId: gfp
    callId: st.reg.newType name: "call" ownerTid: iterId typetype: ztypes.ztypetype.functionType
    if gfp > 0 then st.reg.setDef typeId: callId declId: gfp
    st.typing.setMemberType parentTypeId: callId nameId: zast.names.wkThis childTypeId: iterId
    (st.typing.setChildOwnershipId
        parentTypeId: callId
        nameId: zast.names.wkThis
        ownership: ztypes.zparamownership.borrowMode
    )
    kP: u64
    for kP < fnode.nparams loop {
        pmId: (zast.fnParamAt :ast nid: fnode.nid i: kP).u32
        kP = kP + 1
        pm: argRefAt :ast nid: (zast.nodeid.create from: pmId.u32)
        if (pm.nid.isZero) == false then {
            # an owned copy: the walks below lend ast
            pn: zast.nameTextCopy :ast ref: pm.name
            ptn: baseTypeName :ast n: (ast.nodes.get i: pm.operation.u64)
            f1: resolveAtomType :st :frame :ast :unitDecl nm: ptn.stringView :thisName
            (st.typing.setMemberType
                parentTypeId: iterId
                nameId: pm.name
                childTypeId: f1
            )
            f2: resolveAtomType :st :frame :ast :unitDecl nm: ptn.stringView :thisName
            (st.typing.setMemberType
                parentTypeId: createId
                nameId: pm.name
                childTypeId: f2
            )
            pown: pathOwnership :ast n: (ast.nodes.get i: pm.operation.u64)
            match (
                pown
            ) case some then {
                (st.typing.setChildOwnership
                    pool: ast.names
                    parentTypeId: createId
                    name: pn.stringView
                    ownership: pown
                )
                needsDtor = true
            } case none then null
        }
    }
    (addResumeInput
        :st
        :frame

        :ast
        :iterId
        :callId
        returntypeId: fnode.returntype
    )
    if (bodyHasYieldingLoop :ast bodyId: fnode.body) then {
        addPromotedLocals :st :frame :ast :iterId bodyId: fnode.body
    }
    addInlineIterFields :st :frame :ast :iterId bodyId: fnode.body
    st.typing.setMemberType parentTypeId: iterId nameId: zast.names.wkCreate childTypeId: createId
    st.typing.setMemberType parentTypeId: iterId nameId: zast.names.wkCall childTypeId: callId
    if needsDtor then {
        st.reg.setNeedsDestructor typeId: iterId
    }
    demandReturnNever :st :ast
}

# isUnitOp -- true when a binding's operation is an inline `unit as {...}` definition.
isUnitOp: function {op: Node.view} out bool is {
    match (
        op
    ) case unitdef then {
        return true
    } else {
        return false
    }
}

# resolveUnitMembers -- resolve the definition signatures in ONE unit's body,
# whatever kind of unit it is. A file unit, an inline `m: unit { }`, a hidden
# subunit and a `public:` block differ only in who supplies the owner, so the
# walk takes the owner's Decl and type id and never asks a name for them.
#
# `speculative` is the one fact the two entries differ on: a FILE unit's body is
# walked before anything asks for it, a nested unit's because something demanded
# the unit. Both of the file walk's peculiarities follow from it -- it resolves
# only what a declaration needs (a function, a unit or an interface), and it does
# not mark what it touched as DEFINED, having resolved it on nobody's behalf.
# `rootOnly` narrows the eager set once more for the main unit, where demand
# starts at `main` and everything else waits to be asked for.
resolveUnitMembers: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    ownerDeclId: ztypes.declid
    ownerTid: ztypes.tid
    unitOpId: zast.nodeid
    speculative: bool
    rootOnly: bool
} is {
    # every member resolves in the unit's own frame
    rf: ownerDeclId
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitOpId
    with biter: bodyIds.iterate do for bm: biter loop {
        bmNode: argRefAt :ast nid: (zast.nodeid.create from: bm.u32)
        if (bmNode.nid.isZero) == false then {
            mName: zast.nameTextCopy :ast ref: bmNode.name
            if mName.length > 0 then {
                # dispatch by KIND. A unit body that declares a generic param
                # parses as `template`, and only resolveInlineGenericUnit marks
                # it generic, registers its params and stamps its def node.
                isTmpl: (zast.unitOpKindIs
                    :ast
                    opId: bmNode.operation
                    k: zast.unitkind.template
                )
                isUnit: isUnitOp op: (ast.nodes.get i: bmNode.operation.u64)
                eager: true
                # a scope declaration -- a unit or a template -- is a property
                # of the DECLARATION, not a body: a nested namespace's template
                # is reached through the scope or not at all, so it stays
                # whatever the restriction. An INTERFACE was exempt here too,
                # because a constraint facet's only reference may be the
                # as-block marker naming it and markerTargetId merely PROBED for
                # its target. It resolves that target now, so the marker demands
                # the interface the way any other reference does.
                if speculative when (isUnit) == false then {
                    if (isFunctionDefOp
                        op: (ast.nodes.get i: bmNode.operation.u64)
                    ) == false then eager = false
                }
                if rootOnly when mName.stringView != "main" then {
                    if (isUnit) == false then eager = false
                }
                if st.typing.eagerAll then eager = true
                if eager then {
                    if isTmpl then {
                        # the template is a child of THIS unit: the mint funnel
                        # reaches the enclosing owner through the frame
                        (resolveInlineGenericUnit
                            :st

                            :ast
                            :unitDecl
                            defName: mName.stringView
                            parentTid: ownerTid
                            parentDeclId: ownerDeclId
                            unitOpId: bmNode.operation
                        )
                    } else if isUnit then {
                        (resolveNamespaceUnit
                            :st
                            :ast
                            :unitDecl
                            defName: mName.stringView
                            parentTid: ownerTid
                            parentDeclId: ownerDeclId
                            unitOpId: bmNode.operation
                        )
                    } else {
                        md: st.typing.declFindChild parentDeclId: ownerDeclId nameId: bmNode.name
                        # a `public:` block's reference entry (`:x`, `alias: x`)
                        # is an edge to a sibling of the enclosing unit, which
                        # resolves as that unit's definition, not as a member here
                        mdp: declParentIdOf :st declId: md
                        if (md.isZero) == false when mdp != ownerDeclId then continue
                        isRx: false
                        isDone: false
                        {
                            mdo: st.typing.decls.get i: md.u64
                            if mdo.kind.reexportDecl then isRx = true
                            if mdo.defined then isDone = true
                        }
                        # A re-export whose target is a DOTTED path is resolved by
                        # following it, which is resolveAliasKey's job -- resolveDef
                        # has no leg for a dotted target naming a NESTED unit, and
                        # marking the alias DEFINED after it did nothing is what
                        # stopped a re-export of a re-export at its first hop. A bare
                        # target (`ECHO: LIB`) names a sibling of this same unit and
                        # is an ordinary definition: resolveDef is what FOLDS it, and
                        # following it instead leaves the constant unfolded.
                        if isRx when (isDottedValue
                            :ast
                            n: (ast.nodes.get i: bmNode.operation.u64)
                        ) then {
                            resolveAliasKey :st :ast declId: md
                        } else if (isDone) == false then {
                            (resolveDef
                                :st
                                frame: rf

                                :ast
                                :unitDecl
                                defName: mName.stringView
                                defnId: (zast.nodeid.create from: bmNode.operation.u32)
                            )
                        }
                        # the eager tier reaches a BARE re-export through
                        # resolveDef, not resolveAliasKey, so the value node's
                        # reference edge is recorded here as well. Both legs, one
                        # call: which of the two resolved it is not something the
                        # editor's answer should depend on.
                        if isRx then {
                            rxTid: (declTypeIdOf :st declId: md).u64
                            stampAliasValue :st :ast declId: md tid: rxTid
                        }
                        if (md.isZero) == false when (speculative) == false then {
                            st.typing.declSetDefined declId: md
                        }
                    }
                }
            }
        }
    }
}

# resolveNamespaceUnit -- resolve a namespace unit: an inline `m: unit { }` or a
# hidden subunit, which are the same node after parsing. Its members are
# children of ITS type id, not of the enclosing unit's, so two namespaces may
# each declare a `twice` without colliding. Members go through resolveDef, so a
# constant, a record, a class and a nested namespace all resolve the way a file
# unit's members do -- which is the whole point: a unit is one concept however
# it was written.
resolveNamespaceUnit: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    parentTid: ztypes.tid
    parentDeclId: ztypes.declid
    unitOpId: zast.nodeid
} is {
    nameRef: zast.poolFind pool: ast.names text: defName
    if nameRef.isZero then return
    udnid: unitdefNodeId :ast nId: unitOpId
    if udnid.isZero then return
    # st.reg.newType has no dedup and a namespace can be demanded again after it
    # resolved, so the node stamp is what makes a second visit a no-op.
    uid: ztypes.tid
    {
        prev: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: udnid.u64
        if prev > 0 then uid = ztypes.tid.create from: prev
    }
    declId: st.typing.declFindChild :parentDeclId nameId: nameRef
    if uid.isZero then {
        uid = st.reg.newType name: defName typetype: ztypes.ztypetype.unitType
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: udnid.u64 tid: uid
        if (parentTid.isZero) == false then {
            (st.typing.setMemberType
                parentTypeId: parentTid
                nameId: nameRef
                childTypeId: uid
            )
        }
        if (declId.isZero) == false then {
            st.typing.declSetType :declId typeId: uid
            st.reg.setDef typeId: uid :declId
        }
    }
    (resolveUnitMembers
        :st

        :ast
        :unitDecl
        ownerDeclId: declId
        ownerTid: uid
        :unitOpId
        speculative: false
        rootOnly: false
    )
    # A namespace's constants are NOT folded here. Each one declares itself
    # when something reads it (probeFrameTyperef's constant leg), the way every
    # other definition of this unit waits to be demanded. Folding them up front
    # was the last eager tier left inside the lazy one.
}

# resolveInlineGenericUnit -- resolve an inline generic unit (mathops: unit as { t:
# Any.generic; add; double }) into a UNIT type (is_generic) whose functions are mangled
# {unit}_{fn} FUNCTION children (with their generic-param types KEPT -- unlike a generic
# FILE unit, an inline template's params are not suppressed).
resolveInlineGenericUnit: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    parentTid: ztypes.tid
    parentDeclId: ztypes.declid
    unitOpId: zast.nodeid
} is {
    # a template's members resolve in the template's own frame
    rf: (st.typing.declFindChild
        :parentDeclId
        nameId: (zast.poolFind pool: ast.names text: defName)
    )
    if rf.isZero then rf = parentDeclId
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitOpId
    # this template's own Decl, under the parent the CALLER names: the unit
    # root for a top-level template, the namespace's Decl for a nested one.
    # A (unit, name) walk reaches only the first.
    nRef5: zast.poolFind pool: ast.names text: defName
    tdl5: st.typing.declFindChild :parentDeclId nameId: nRef5
    # st.reg.newType has no dedup and a template can be demanded again after it
    # resolved, so a second visit must mint nothing at all. resolveNamespaceUnit
    # carries the equivalent node-stamp guard. The Decl below records
    # the id this minted, so it is the durable "already done" mark.
    if (declTypeIdOf :st declId: tdl5) > 0 then return
    {
        uid: st.reg.newType name: defName typetype: ztypes.ztypetype.unitType
        did: uid
        rid: uid
        if (hasGenericParam :ast items: bodyIds) then {
            st.reg.setGeneric typeId: uid value: true
            registerGenericParams :st :ast tdecl: tdl5 items: bodyIds
            # the unit node and each bare generic-param def stamp, and the
            # param name resolves so signature t-refs stamp. Unconditional --
            # createUnitMono falls back to this def-node stamp to find a template
            # with no childOf edge, so laying it is a property of resolving the
            # template, not of which walk got here.
            udnid: unitdefNodeId :ast nId: unitOpId
            ztyping.nodeTypeSet tbl: st.typing.nodeType nid: udnid.u64 tid: uid
            with gpiter: bodyIds.iterate do for gmId: gpiter loop {
                gm: argRefAt :ast nid: (zast.nodeid.create from: gmId.u32)
                if (gm.nid.isZero) == false then {
                    if (isBareGenericParam
                        :ast
                        op: (ast.nodes.get i: gm.operation.u64)
                    ) then {
                        gpn5: zast.nameTextAt :ast ref: gm.name
                        gtid5: u64
                        gpo5: (st.reg.genericParamTidOf
                            tdecl: tdl5
                            paramName: (nameIdOf :ast name: gpn5.stringView)
                        )
                        match (
                            gpo5
                        ) case some then {
                            gtid5 = gpo5
                        } case none then {
                            gtid5 = (st.reg.newType
                                name: gpn5.stringView
                                typetype: ztypes.ztypetype.genericParam
                            )
                            (st.reg.setGenericParamTid
                                tdecl: tdl5
                                paramName: (nameIdOf :ast name: gpn5.stringView)
                                tid: (ztypes.tid.create from: gtid5.u64)
                            )
                        }
                        gpnid: nodeId n: (ast.nodes.get i: gm.operation.u64)
                        (ztyping.nodeTypeSet
                            tbl: st.typing.nodeType
                            nid: gpnid.u64
                            tid: (ztypes.tid.create from: gtid5.u64)
                        )
                        # the parameter's own declaration carries the
                        # GENERIC_PARAM id, as a generic file unit's does: the
                        # template's rf answers `t` with the parameter, not
                        # with the constraint its definition names
                        gpd5: st.typing.declFindChild parentDeclId: tdl5 nameId: gm.name
                        if (gpd5.isZero) == false then {
                            (st.typing.declSetType
                                declId: gpd5
                                typeId: (ztypes.tid.create from: gtid5.u64)
                            )
                        }
                    }
                }
            }
        }
        if (tdl5.isZero) == false then {
            st.typing.declSetType declId: tdl5 typeId: did
            st.reg.setDef typeId: did declId: tdl5
        }
        # A non-generic inline unit is a real type; lay its unit->def childOf edge
        # (a generic template must NOT get one -- its id is the pre-instantiation
        # template, which would shadow instance lookups).
        if (hasGenericParam :ast items: bodyIds) == false then {
            if (parentTid.isZero) == false then {
                (st.typing.setMemberType
                    parentTypeId: parentTid
                    nameId: nRef5
                    childTypeId: rid
                )
            }
        }
        biter: bodyIds.iterate
        for bm: biter loop {
            bmNode: argRefAt :ast nid: (zast.nodeid.create from: bm.u32)
            if (bmNode.nid.isZero) == false then {
                # an owned copy: the walks below lend ast
                fn: zast.nameTextCopy :ast ref: bmNode.name
                ownerNmId: nameIdOf :ast name: defName
                mido: (resolveMethodFn
                    :st
                    frame: rf

                    :ast
                    :unitDecl
                    ownerNameId: ownerNmId
                    mname: fn.stringView
                    thisName: ""
                    opId: bmNode.operation
                )
                match (
                    mido
                ) case some then {
                    (declLinkTemplateMethod
                        :st
                        tmplDeclId: tdl5
                        memberNameId: bmNode.name
                        fnTid: mido
                    )
                    (st.typing.setMemberType
                        parentTypeId: uid
                        nameId: bmNode.name
                        childTypeId: mido
                    )
                } case none then null
            }
        }
    }
}


# createUnitMono -- mint a mono UNIT with JOIN-only function-shell children
# from a template unit body, then seed return/never demand. Identity is the
# caller's: the trie under the template, keyed on the resolved arguments
# (unitMonoOnTrie / unitMonoJoinTrie). `monoName` is the mono's LABEL --
# display only, registered nowhere.
createUnitMono: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    monoName: StringView
    tmplDeclId: ztypes.declid
    tplTid: ztypes.tid
    templateOpId: zast.nodeid
} out ztypes.tid is {
    monoId: st.reg.newType name: monoName typetype: ztypes.ztypetype.unitType
    # the mono's declaration is the TEMPLATE's (its origin), and its members
    # hang off a clone of it -- the request resolved the template's Decl at
    # collection through the instantiation's own scope. Nothing registers the
    # label: the mono is reached through the trie, or through the binding
    # names the completion pass registers.
    st.reg.setDef typeId: monoId declId: tmplDeclId
    mud: st.typing.declCloneType templateDeclId: tmplDeclId
    if mud > 0 then st.typing.declSetType declId: mud typeId: monoId
    if (tplTid.isZero) == false then st.reg.setGenericOrigin typeId: monoId value: tplTid
    attachMonoUnitFuncs :st :ast :monoId :templateOpId
    demandReturnNever :st :ast
    return monoId
}

# fnReturnBaseName -- the base type name of a function's return typeref
# ("" when absent), for completing substituted signatures whose template
# return was still unresolved at signature time.
fnReturnBaseName: function {ast: Ast.view oId: zast.nodeid} out String is {
    if oId.isZero then return "".string
    o: ast.nodes.get i: oId.u64
    return (baseTypeName :ast n: o)

}

# the base type name of function `op`'s declared return type -- the
# head of a form like `List X`.
fnReturnBaseNameOf: function {ast: Ast.view op: Node.view} out String is {
    match (
        op
    ) case functiondef then {
        return (fnReturnBaseName :ast oId: op.returntype)
    } else {
        return "".string
    }
}

# buildUnitMono -- unit-mono completion: substituted method
# children ({mono}.{fn} FUNCTION types whose generic-param-named child types
# and return are replaced by the instantiation arg). Bodies are walked once,
# per instance, over the template's AST (stampUnitMonoTemplates). One build
# per mono.
# registerMonoFnParams -- register a mono unit fn's generic-param-typed params
# (a: t -> a: argId) on the mono FUNCTION type, sourced from the template fn's
# AST. The template fn stays childless -- only the instance carries substituted
# param children.
registerMonoFnParams: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    op: Node.view
    fnId: u64
    subs: (IdMapV zast.nameid v: u64).view
} is {
    match (
        op
    ) case functiondef then {
        ppiter: op.parameters.iterate
        for ppmId: ppiter loop {
            ppm: ast.nodes.get i: ppmId.u64
            match (
                ppm
            ) case namedoperation then {
                pptn: atomNameId :ast n: (ast.nodes.get i: ppm.operation.u64)
                ppgo: subs.get key: pptn
                match (
                    ppgo
                ) case some then {
                    (st.typing.setMemberType
                        parentTypeId: (ztypes.tid.create from: fnId.u64)
                        nameId: ppm.name
                        childTypeId: ppgo
                    )
                } case none then null
            } else null
        }
    } else null
}
# fillMonoMethodSignature -- copy a template method's parameters and return type
# into the mono's method, with the instantiation's arguments substituted for the
# generic parameters the template names.
fillMonoMethodSignature: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rf: ztypes.declid
    tmplUnitName: ztypes.declid
    fmNode: argref
    srcId: u64
    newFnId: ztypes.tid
    subs: (IdMapV zast.nameid v: u64).view
    gpNames: (IdMapV zast.nameid v: bool).view
} is {
    bmNms: (ListVal u64)
    cIds: (ListVal u64)
    (st.typing.declMemberList
        ownerTid: (ztypes.tid.create from: srcId.u64)
        names: bmNms
        tids: cIds
    )
    ci: u64
    cn3: bmNms.length
    for ci < cn3 loop {
        chName: zast.nameid.create from: (bmNms.get i: ci).u32.orPanic
        chId: cIds.get i: ci
        target: chId
        ctnT: st.reg.nameOf tid: (ztypes.tid.create from: chId.u64)
        ctn: nameIdOf :ast name: ctnT.stringView
        cgo: gpNames.get key: ctn
        match (
            cgo
        ) case some then {
            cg: subs.get key: ctn
            match (
                cg
            ) case some then {
                target = cg
            } case none then null
        } case none then null
        (st.typing.setMemberType
            parentTypeId: newFnId
            nameId: chName
            childTypeId: target
        )
        ci = ci + 1
    }
    rto: st.reg.returnTypeOf tid: (ztypes.tid.create from: srcId.u64)
    if rto > 0 then {
        rtv: rto
        rtnT: st.reg.nameOf tid: rtv
        rtn: nameIdOf :ast name: rtnT.stringView
        rgo: gpNames.get key: rtn
        match (
            rgo
        ) case some then {
            rg: subs.get key: rtn
            match (
                rg
            ) case some then {
                rtv = ztypes.tid.create from: rg
            } case none then null
        } case none then null
        st.reg.setReturnType typeId: newFnId value: rtv
    } else {
        # template return unresolved at signature time
        # (out t): derive from the method's AST typeref.
        rnm: (fnReturnBaseNameOf
            :ast
            op: (ast.nodes.get i: fmNode.operation.u64)
        )
        if rnm.length > 0 then {
            rnmId: nameIdOf :ast name: rnm.stringView
            rgo2: gpNames.get key: rnmId
            rid2: u64
            match (
                rgo2
            ) case some then {
                sg2: subs.get key: rnmId
                match (
                    sg2
                ) case some then {
                    rid2 = sg2
                } case none then null
            } case none then {
                rlo2: (walkLookupTyperef
                    :st
                    frame: rf
                    :ast

                    unitDecl: tmplUnitName
                    base: rnm.stringView
                )
                match (
                    rlo2
                ) case some then {
                    rid2 = rlo2
                } case none then null
            }
            if rid2 > 0 then st.reg.setReturnType typeId: newFnId value: rid2
        }
    }
}

# buildUnitMonoMember -- substitute one member of a generic unit's body into the
# monomorphised instance: its own generic parameters bound to the instantiation's
# arguments, its type resolved in the TEMPLATE's frame (lexical scoping -- the
# instantiating unit is not where the template's names live).
buildUnitMonoMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rf: ztypes.declid
    tmplUnitName: ztypes.declid
    tmplNameId: zast.nameid
    monoId: ztypes.tid
    tplId: ztypes.tid
    fmNode: argref
    subs: (IdMapV zast.nameid v: u64).view
    gpNames: (IdMapV zast.nameid v: bool).view
} is {
    if (isFunctionDefOp op: (ast.nodes.get i: fmNode.operation.u64)) then {
        # an owned copy: the walks below lend ast
        fn: zast.nameTextCopy :ast ref: fmNode.name
        srcId: u64
        tfo: (st.typing.declChildOf
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: tplId.u64)
            name: fn.stringView
        )
        match (
            tfo
        ) case some then {
            srcId = tfo
        } case none then {
            mo0: (resolveMethodFn
                :st
                frame: rf

                :ast
                unitDecl: tmplUnitName
                ownerNameId: tmplNameId
                mname: fn.stringView
                thisName: ""
                opId: fmNode.operation
            )
            {
                mo0v: optU64Or o: mo0 d: 0
                tdl0: (declOfUnitDef
                    :st
                    frame: rf
                    unitDecl: tmplUnitName
                    nameId: tmplNameId
                )
                (declLinkTemplateMethod
                    :st
                    tmplDeclId: tdl0
                    memberNameId: fmNode.name
                    fnTid: mo0v
                )
            }
            match (
                mo0
            ) case some then {
                srcId = mo0
                (st.typing.setMemberType
                    parentTypeId: (ztypes.tid.create from: tplId.u64)
                    nameId: fmNode.name
                    childTypeId: mo0
                )
            } case none then null
        }
        newFnId: (st.reg.newType
            name: fn.stringView
            ownerTid: monoId
            typetype: ztypes.ztypetype.functionType
        )
        # declare and edge the method before filling its parameters:
        # edging claims the method's own function type for its
        # declaration, which is what the parameter writes below --
        # here and in registerMonoFnParams -- reach through
        (st.typing.declSynthMember
            parentTypeId: monoId
            nameId: fmNode.name
            kind: ztyping.declkind.methodDecl
        )
        (st.typing.setMemberType
            parentTypeId: monoId
            nameId: fmNode.name
            childTypeId: newFnId
        )
        if srcId > 0 then {
            (fillMonoMethodSignature
                :st
                :ast
                :rf
                :tmplUnitName
                :fmNode
                :srcId
                :newFnId
                :subs
                :gpNames
            )
        }
        (registerMonoFnParams
            :st
            :ast
            op: (ast.nodes.get i: fmNode.operation.u64)
            fnId: newFnId
            :subs
        )
    }
}


# build a monomorphised instance of a generic unit.
buildUnitMono: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    tmplUnitName: ztypes.declid
    tmplNameId: zast.nameid
    monoId: ztypes.tid
    tplId: ztypes.tid
    subs: (IdMapV zast.nameid v: u64).view
    templateOpId: zast.nodeid
} is {
    if (st.typing.collectionChildrenBuilt.has item: monoId) then return
    bk0: monoId
    st.typing.collectionChildrenBuilt.add item: bk0
    # the template's members resolve in the template's frame
    rf: frame
    {
        td: declOfTypeId :st tid: tplId
        if (td.isZero) == false then rf = td
    }
    bodyIds: zast.unitBodyIdsAt :ast unitId: templateOpId
    gpNames: (IdMapV zast.nameid v: bool)
    {
        with giter: bodyIds.iterate do for gmId: giter loop {
            gm: argRefAt :ast nid: (zast.nodeid.create from: gmId.u32)
            if (gm.nid.isZero) == false then {
                if (isGenericParam :ast op: (ast.nodes.get i: gm.operation.u64)) then {
                    gv: true
                    gpNames.set key: gm.name value: gv
                }
            }
        }
        fiter: bodyIds.iterate
        for fm: fiter loop {
            fmNode: argRefAt :ast nid: (zast.nodeid.create from: fm.u32)
            if (fmNode.nid.isZero) == false then {
                (buildUnitMonoMember
                    :st
                    :ast
                    :rf
                    :tmplUnitName
                    :tmplNameId
                    :monoId
                    :tplId
                    :fmNode
                    :subs
                    :gpNames
                )
            }
        }
    }
}


# completeInlineReq -- locate an inline template member by name in the main
# unit body and build its mono's completion.
completeInlineReq: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    monoId: ztypes.tid
    tmplNameId: zast.nameid
    tplId: ztypes.tid
    subs: (IdMapV zast.nameid v: u64).view
    mainOpId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: mainOpId
    {
        biter: bodyIds.iterate
        for bm: biter loop {
            bmNode: argRefAt :ast nid: (zast.nodeid.create from: bm.u32)
            if (bmNode.nid.isZero) == false then {
                if bmNode.name == tmplNameId then {
                    if (isUnitOp op: (ast.nodes.get i: bmNode.operation.u64)) then {
                        (buildUnitMono
                            :st
                            :frame

                            :ast
                            tmplUnitName: unitDecl
                            :tmplNameId
                            :monoId
                            :tplId
                            :subs
                            templateOpId: bmNode.operation
                        )
                    }
                }
            }
        }
    }
}

# inlineTemplateTid -- the canonical id of an inline generic-unit template
# (mathops: unit as {...} in the main body). A generic inline template has no
# unit->def childOf edge (it would shadow instance lookups) and is not a unit
# root, so the only durable record of its id is the def-node stamp
# laid by resolveInlineGenericUnit; 0 when no such binding is stamped.
inlineTemplateTid: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    mainOpId: zast.nodeid
    tmplNameId: zast.nameid
} out ztypes.tid is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: mainOpId
    found: u64
    {
        biter: bodyIds.iterate
        for bm: biter loop {
            bmNode: ast.nodes.get i: bm.u64
            match (
                bmNode
            ) case namedoperation then {
                if bmNode.name == tmplNameId then {
                    if (isUnitOp op: (ast.nodes.get i: bmNode.operation.u64)) then {
                        tnid: unitdefNodeId :ast nId: bmNode.operation
                        tso: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: tnid.u64
                        if tso > 0 then found = tso
                    }
                }
            } else null
        }
    }
    return (ztypes.tid.create from: found.u64)
}
# buildInstanceMono -- build the monomorphised unit for one instantiation request.
# When collection resolved the template (its id, the declaring node and the unit
# whose AST holds it) one call covers both shapes; otherwise the template is
# hunted down as a file unit named by the request or as an inline binding.
buildInstanceMono: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    program: Node
    rtId: zast.nameid
    rtu: ztypes.declid
    ru: ztypes.declid
    rtop: u64
    tplId0: ztypes.tid
    memberIdAt: u64
    subs: (IdMapV zast.nameid v: u64).view
} is {
    tplId: tplId0
    # the request resolved its template at COLLECTION: its id, the
    # node that declares it, and the unit whose AST holds that node.
    # One call covers both shapes the scans below split -- a file unit
    # named by the template, and an inline binding of the instantiating
    # unit -- because neither is found by name any more.
    if rtop > 0 when tplId > 0 then {
        match (
            program
        ) case program then {
            (buildUnitMono
                :st
                :frame

                ast: program.ast
                tmplUnitName: rtu
                tmplNameId: rtId
                monoId: (ztypes.tid.create from: memberIdAt.u64)
                :tplId
                :subs
                templateOpId: (zast.nodeid.create from: rtop.u32.orPanic)
            )
        } else null
    } else {
        if tplId.isZero then {
            match (
                program
            ) case program then {
                tuiter: program.ast.units.iterate
                for tuId: tuiter loop {
                    tu: program.ast.nodes.get i: tuId.u64
                    match (
                        tu
                    ) case namedoperation then {
                        uc3z: (unitDeclOfNameOrOwn
                            :st
                            :frame
                            nameId: tu.name
                        )
                        if uc3z == ru then {
                            tplId = (inlineTemplateTid
                                :st
                                ast: program.ast
                                mainOpId: tu.operation
                                tmplNameId: rtId
                            )
                        }
                    } else null
                }
            } else null
        }
        if tplId > 0 then {
            match (
                program
            ) case program then {
                uN: program.ast.units.length
                uI: u64
                for uI < uN loop {
                    u9Id: (zast.nodeid.create from: (program.ast.units.get i: uI))
                    uI = uI + 1
                    # scope the element borrow: the calls below lock
                    # `program.ast` exclusively (they intern mono names)
                    unitOpNodeId: zast.nodeid
                    un29Id: zast.nameid
                    {
                        u: program.ast.nodes.get i: u9Id.u64
                        match (
                            u
                        ) case namedoperation then {
                            un29Id = u.name
                            unitOpNodeId = u.operation
                        } else null
                    }
                    if un29Id == rtId then {
                        uq2z: (unitDeclOfNameOrOwn
                            :st
                            :frame
                            nameId: un29Id
                        )
                        (buildUnitMono
                            :st
                            :frame

                            ast: program.ast
                            tmplUnitName: uq2z
                            tmplNameId: rtId
                            monoId: (ztypes.tid.create from: memberIdAt.u64)
                            :tplId
                            :subs
                            templateOpId: unitOpNodeId
                        )
                    }
                    uc4z: (unitDeclOfNameOrOwn
                        :st
                        :frame
                        nameId: un29Id
                        )
                    if uc4z == ru then {
                        (completeInlineReq
                            :st
                            :frame

                            ast: program.ast
                            unitDecl: ru
                            monoId: (ztypes.tid.create from: memberIdAt.u64)
                            tmplNameId: rtId
                            :tplId
                            :subs
                            mainOpId: unitOpNodeId
                        )
                    }
                }
            } else null
        }
    }
}
# resolveInstArgSubs -- resolve one request's generic arguments into the type and
# value substitution maps. The arguments resolve where the instantiation is
# WRITTEN, so a request that carries its own scope binds there rather than in
# the frame the pass is walking.
resolveInstArgSubs: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    program: Node
    r: InstReq.view
    subs: (IdMapV zast.nameid v: u64)
    valSubs: (IdMapV zast.nameid v: u64)
} is {
    ru: r.declUnit
    rscope: r.scopeDeclId
    naR: r.argLabels.length
    aiR: u64
    # the arguments resolve where the instantiation is written
    rf: frame
    if (rscope.isZero) == false then rf = rscope
    for aiR < naR loop {
        lblR: (r.argLabels.get i: aiR)
        anmR: (r.argNames.get i: aiR)
        aidR: r.argAtomIds.get i: aiR
        if (isNumericLiteralName name: anmR.stringView) then {
            pvR: parseDecimalU64 text: anmR.stringView
            match (
                pvR
            ) case some then {
                valSubs.set key: lblR value: pvR
            } case none then null
        } else {
            aoR: (optionval.none u64)
            match (
                program
            ) case program then {
                if anmR.length > 0 then {
                    aoR = (walkLookupTyperef
                        :st
                        frame: rf
                        ast: program.ast

                        unitDecl: ru
                        base: anmR.stringView
                    )
                } else {
                    # a call-shaped argument: the specialisation it names
                    atR: instArgTypeOf :st frame: rf ast: program.ast :r i: aiR
                    if atR > 0 then aoR = (optionval.some atR)
                }
            } else null
            match (
                aoR
            ) case some then {
                subs.set key: lblR value: aoR
                if aidR > 0 then {
                    (ztyping.nodeTypeSet
                        tbl: st.typing.nodeType
                        nid: aidR
                        tid: (ztypes.tid.create from: aoR.u64)
                    )
                }
            } case none then null
        }
        aiR = aiR + 1
    }
}
# recordInstanceGenericArgs -- record a mono's arguments in DECLARATION order, the
# order the generic_arg rows keep and the order that keys its level of the id
# trie. A parameter with no substitution keys as 0 rather than being skipped, so
# the arity of the key always matches the template's.
recordInstanceGenericArgs: function {
    st: zenv.ZSymbolTable
    tplDecl: ztypes.declid
    memberIdAt: u64
    subs: (IdMapV zast.nameid v: u64).view
    valSubs: (IdMapV zast.nameid v: u64).view
} is {
    # the mono's arguments in DECLARATION order: what the generic_arg
    # rows record, and what keys its level of the id trie.
    mkeys: (ListVal u64)
    mkval: (ListVal bool)
    {
        pnR: st.reg.genericParamNamesOf tdecl: tplDecl
        pnN: pnR.length
        pnI: u64
        for pnI < pnN loop {
            pnmR: (pnR.get i: pnI)
            tgoR: subs.get key: pnmR
            match (
                tgoR
            ) case some then {
                mkeys.append tgoR
                mkval.append false
            } case none then {
                vgoR: valSubs.get key: pnmR
                match (
                    vgoR
                ) case some then {
                    mkeys.append vgoR
                    mkval.append true
                } case none then {
                    mkeys.append 0
                    mkval.append false
                }
            }
            pnI = pnI + 1
        }
    }
    if (st.reg.genericArgCount specId: (ztypes.tid.create from: memberIdAt.u64)) == 0 then {
        aiM: u64
        anM: mkeys.length
        for aiM < anM loop {
            kM: mkeys.get i: aiM
            if (mkval.get i: aiM) then {
                (st.reg.appendGenericArgValue
                    specId: (ztypes.tid.create from: memberIdAt.u64)
                    value: kM
                )
            } else {
                (st.reg.appendGenericArg
                    specId: (ztypes.tid.create from: memberIdAt.u64)
                    arg: kM
                )
            }
            aiM = aiM + 1
        }
    }
}
# completeOneInstance -- finish one instantiation whose mono the mint pass already
# laid on the trie. The binding's own Decl carries the instantiated unit's type
# wherever the binding is written, a binding inside a namespace is also a member
# of it, and the template settles here -- the trie join needs it as its root.
completeOneInstance: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    program: Node
    r: InstReq.view
    mgo: u64
    tnId: u32
    subs: (IdMapV zast.nameid v: u64).view
    valSubs: (IdMapV zast.nameid v: u64).view
} is {
    rbId: r.bindId
    rtId: r.tmplId
    ru: r.declUnit
    re: r.exprId
    rc: r.callId
    rl: r.calId
    rtu: r.tmplUnit
    rtop: r.tmplOpId
    rtid: r.tmplTid
    rtdecl: r.tmplDeclId
    rscope: r.scopeDeclId
    memberIdAt: mgo
    # the binding's own Decl carries the instantiated unit's type
    # WHEREVER the binding is written: that is what makes `intmath` a
    # unit to a reader, without asking a bare-name index.
    bDecl: st.typing.declFindChild parentDeclId: rscope nameId: rbId
    if (bDecl.isZero) == false then {
        st.typing.declSetType declId: bDecl typeId: (ztypes.tid.create from: memberIdAt.u64)
    }
    # A binding written inside a NAMESPACE is ALSO a member of that
    # namespace -- `outer.intmath` -- and a qualified read finds it on
    # the namespace's own type id. A top-level binding has no such
    # owner: the file unit's members are not indexed that way.
    rsp: declParentIdOf :st declId: rscope
    if (declAtProgramTop :st parentDeclId: rsp) == false then {
        sTid: declTypeIdOf :st declId: rscope
        if (sTid.isZero) == false then {
            (st.typing.setMemberType
                parentTypeId: sTid
                nameId: rbId
                childTypeId: memberIdAt
            )
        }
    }
    tplId: ztypes.tid
    tgo: (optionval.none u64)
    tplDecl: ztypes.declid
    match (
        program
    ) case program then {
        mnUid8: unitNameIdOf :st unitDecl: ru
        rtNid: rtId
        unitDecl99: (unitDeclOfName :st nameId: mnUid8)
        tgo = (resolvedByIds
            :st
            ast: program.ast
            unitDecl: unitDecl99
            name: rtNid
        )
        tplDecl = (declOfUnitDef
            :st
            :frame
            unitDecl: ru
            nameId: rtId
        )
        if tplDecl.isZero then tplDecl = rtdecl
        if tplDecl.isZero then {
            # a generic FILE unit used as the template: its params
            # live on its root Decl
            tro: (st.typing.declFindChild
                parentDeclId: st.typing.programRoot
                nameId: rtId
            )
            if (tro.isZero) == false then tplDecl = tro
        }
    } else null
    match (
        tgo
    ) case some then {
        tplId = ztypes.tid.create from: tgo.u64
    } case none then {
        ugo: (declTypeIdOf
            :st
            declId: (st.typing.declFindChild
                parentDeclId: st.typing.programRoot
                nameId: (zast.nameid.create from: tnId)
            )
        )
        if (ugo.isZero) == false then {
            tplId = ztypes.tid.create from: ugo.u64
        }
    }
    # neither probe reaches a template nested in a namespace or living
    # in another unit; the request resolved one at COLLECTION. Settled
    # HERE, before the arguments are keyed -- the trie join below needs
    # the template as its root.
    if tplId.isZero then tplId = rtid
    (recordInstanceGenericArgs
        :st
        :tplDecl
        :memberIdAt
        :subs
        :valSubs
    )
    (buildInstanceMono
        :st
        :frame
        :program
        :rtId
        :rtu
        :ru
        :rtop
        tplId0: tplId
        :memberIdAt
        :subs
    )
    if re > 0 then {
        ev: memberIdAt
        (ztyping.nodeTypeSet
            tbl: st.typing.nodeType
            nid: re
            tid: (ztypes.tid.create from: ev.u64)
        )
    }
    if rc > 0 then {
        cv: memberIdAt
        (ztyping.nodeTypeSet
            tbl: st.typing.nodeType
            nid: rc
            tid: (ztypes.tid.create from: cv.u64)
        )
    }
    if rl > 0 when tplId > 0 then {
        (ztyping.nodeTypeSet
            tbl: st.typing.nodeType
            nid: rl
            tid: (ztypes.tid.create from: tplId.u64)
        )
    }
}

# completeUnitInstantiations -- post-demand pass: with system types
# resolved, finish each generic-unit instantiation (substituted children +
# clone stash), register the binding name, and stamp the instantiation's
# expression/call/callable/arg nodes.
completeUnitInstantiations: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    program: Node
} is {
    reqs: (List InstReq)
    scanMainForInstantiations :st :frame :program :reqs
    i: u64
    for i < reqs.length loop {
        r: reqs.get :i
        rtId: r.tmplId
        rtdecl: r.tmplDeclId
        subs: (IdMapV zast.nameid v: u64)
        valSubs: (IdMapV zast.nameid v: u64)
        resolveInstArgSubs :st :frame :program :r :subs :valSubs
        # the mono is the one on the trie under the template, keyed on the
        # resolved arguments -- the identity the mint pass laid; the label is
        # not consulted
        mgo: (optionval.none u64)
        tnId: u32
        match (
            program
        ) case program then {
            if (rtdecl.isZero) == false then {
                keysC: (ListVal u64)
                isValC: (ListVal bool)
                if (instMonoKeys
                    :st
                    :frame

                    ast: program.ast
                    :r
                    tdecl: rtdecl
                    keys: keysC
                    isVal: isValC
                ) then {
                    mgo = unitMonoOnTrie :st tplTid: (declTypeIdOf :st declId: rtdecl) keys: keysC
                }
            }
            tnId = rtId.u32
        } else null
        match (
            mgo
        ) case some then {
            (completeOneInstance
                :st
                :frame
                :program
                :r
                :mgo
                :tnId
                :subs
                :valSubs
            )
        } case none then null
        i = i + 1
    }
}

# demandInstArgs -- demand every definition an instantiation's arguments
# name, from the scope the instantiation is written in (a bare type name, a
# dotted one, a nested specialisation's parts), so the mint pass -- which runs
# before the demand drain -- can key the mono on resolved arguments. The
# caller drains.
demandInstArgs: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast.view
    r: InstReq.view
} is {
    rf: frame
    if (r.scopeDeclId.isZero) == false then rf = r.scopeDeclId
    n: r.argNodeIds.length
    i: u64
    for i < n loop {
        nid: r.argNodeIds.get :i
        if nid > 0 then {
            scanCallsInNode :st frame: rf :ast node: (ast.nodes.get i: nid)
        }
        i = i + 1
    }
}

# instMonoKeys -- an instantiation's trie keys in the template's PARAMETER
# order: the argument's type id, or its numeric value (isVal). False when a
# parameter has no resolvable argument (its key stays 0).
instMonoKeys: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    r: InstReq.view
    tdecl: ztypes.declid
    keys: (ListVal u64)
    isVal: (ListVal bool)
} out bool is {
    ok: true
    pn: st.reg.genericParamNamesOf :tdecl
    if pn.length == 0 then return false
    pi: u64
    for pi < pn.length loop {
        pnm: pn.get i: pi
        pi = pi + 1
        k: u64
        valFound: false
        found: false
        ai: u64
        for ai < r.argLabels.length loop {
            lbl: r.argLabels.get i: ai
            if lbl == pnm then {
                an: r.argNames.get i: ai
                if (isNumericLiteralName name: an.stringView) then {
                    pv: parseDecimalU64 text: an.stringView
                    match (
                        pv
                    ) case some then {
                        # a value key may be 0 (`sized cap: 0`)
                        k = pv
                        valFound = true
                        found = true
                    } case none then null
                } else {
                    k = instArgTypeOf :st :frame :ast :r i: ai
                    if k > 0 then found = true
                }
            }
            ai = ai + 1
        }
        if (found) == false then ok = false
        keys.append k
        isVal.append valFound
    }
    return ok
}

# unitMonoOnTrie -- the unit mono already minted for `keys` under the
# template, walking one trie level per parameter; none when any level is
# missing. A probe: it lays nothing.
unitMonoOnTrie: function {
    st: zenv.ZSymbolTable.view
    tplTid: ztypes.tid
    keys: (ListVal u64).view
} out optionval u64 is {
    if tplTid.isZero then return (optionval.none u64)
    cur: tplTid.u64
    i: u64
    for i < keys.length loop {
        n: st.reg.getGenericChild parentId: cur key: (keys.get :i)
        match (
            n
        ) case some then {
            cur = n
        } case none then {
            return (optionval.none u64)
        }
        i = i + 1
    }
    return (optionval.some cur)
}

# unitMonoJoinTrie -- lay the mono's path under the template: one level per
# parameter, keyed on the argument (a type id or a numeric value; the kinds
# never share a level), interior nodes minted as `{template}__node`, the leaf
# the mono. getOrMintSpec keys a record specialisation the same way; a unit
# tid parents a trie node exactly as a record tid does.
unitMonoJoinTrie: function {
    st: zenv.ZSymbolTable
    tplTid: ztypes.tid
    tplName: StringView
    keys: (ListVal u64).view
    monoId: ztypes.tid
} is {
    if tplTid.isZero then return
    cur: tplTid.u64
    n: keys.length
    i: u64
    for i < n loop {
        k: keys.get :i
        last: false
        if i + 1 == n then last = true
        step: u64
        got: st.reg.getGenericChild parentId: cur key: k
        match (
            got
        ) case some then {
            step = got
        } case none then {
            if last then {
                step = monoId.u64
            } else {
                inm: "\{tplName}__node"
                step = (st.reg.newType
                    name: inm.stringView
                    typetype: ztypes.ztypetype.genericParam
                )
            }
            st.reg.setGenericChild parentId: cur key: k child: step
        }
        cur = step
        i = i + 1
    }
}

# instArgTypeOf -- the type an instantiation argument names, resolved where
# the instantiation is written: a bare atom by name, a call-shaped argument
# (a specialisation of its own, `(Box t: i64)`) through the type-ref
# resolver, which mints or finds it on the trie. 0 for a numeric value
# argument or an unresolvable one.
instArgTypeOf: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    r: InstReq.view
    i: u64
} out u64 is {
    anm: r.argNames.get :i
    if (isNumericLiteralName name: anm.stringView) then return 0
    rf: frame
    if (r.scopeDeclId.isZero) == false then rf = r.scopeDeclId
    result: u64
    if anm.length > 0 then {
        ao: (walkLookupTyperef
            :st
            frame: rf
            :ast

            unitDecl: r.declUnit
            base: anm.stringView
        )
        match (
            ao
        ) case some then {
            result = ao
        } case none then null
    } else {
        nid: r.argNodeIds.get :i
        if nid > 0 then {
            result = (resolveTyperefShell
                :st
                frame: rf

                :ast
                unitDecl: r.declUnit
                nid: (zast.nodeid.create from: nid.u32.orPanic)
                thisName: ""
            )
        }
    }
    return result
}

# instMonoLabel -- the mono's label: the template's name and one component per
# argument, a bare atom's own text or, for a call-shaped argument, the label of
# the specialisation it names. The same request derives the same label in
# every pass, which is what the two-pass mint relies on.
instMonoLabel: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    r: InstReq.view
} out String is {
    mn: zast.poolTextCopy pool: ast.names ref: r.tmplId
    na: r.argNames.length
    i: u64
    for i < na loop {
        mn.append "_"
        an: r.argNames.get :i
        if an.length > 0 then {
            mn.append an
        } else {
            at: instArgTypeOf :st :frame :ast :r :i
            if at > 0 then mn.append (monoValName
                :st
                :frame
                :ast

                tid: (ztypes.tid.create from: at)
            )
        }
        i = i + 1
    }
    return mn
}

# resolveMainUnitInstantiations -- resolve generic-unit instantiation bindings
# (intmath: (genmath t: i64)) into mono UNIT types. Two passes avoid nested
# program.ast.units iteration: collect requests (separate fn), then create each mono.
# resolve every generic instantiation the program declares, in whichever unit
# it was written.
resolveMainUnitInstantiations: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    program: Node
} is {
    reqs: (List InstReq)
    scanMainForInstantiations :st :frame :program :reqs
    i: u64
    for i < reqs.length loop {
        r: reqs.get :i
        rmL0: String
        match (
            program
        ) case program then {
            rmL0 = instMonoLabel :st :frame ast: program.ast :r
        } else null
        rm: rmL0.stringView
        rtId: r.tmplId
        # the template has to be RESOLVED before a mono is minted from it:
        # createUnitMono reads the template's id -- for an inline one, the stamp
        # resolveInlineGenericUnit lays on its def node -- to record the mono's
        # generic origin, and a template in a unit the eager pass did not walk
        # has none. The request already carries what it takes to resolve it:
        # instTemplateDecl found the template's Decl at COLLECTION, through the
        # scope the instantiation was written in. resolveInlineGenericUnit
        # self-guards on that Decl's type id, so this is a no-op whenever
        # anything already resolved the template -- which today is always.
        # A Decl parented straight to the program root is a file unit of the
        # template's name, not an inline template: registerUnitRoots has
        # already minted it.
        {
            tpd: declParentIdOf :st declId: r.tmplDeclId
            tu: r.tmplUnit
            if (declAtProgramTop :st parentDeclId: tpd) == false when r.tmplOpId > 0 then {
                match (
                    program
                ) case program then {
                    rtT: zast.poolTextAt pool: program.ast.names ref: rtId
                    parentTid94: (declTypeIdOf :st declId: tpd)
                    (resolveInlineGenericUnit
                        :st

                        ast: program.ast
                        unitDecl: tu
                        defName: rtT.stringView
                        parentTid: parentTid94
                        parentDeclId: tpd
                        unitOpId: (zast.nodeid.create from: r.tmplOpId.u32.orPanic)
                    )
                } else null
            }
        }
        # a request without a template Decl is no instantiation (a unit-level
        # constant CALL the collector also gathers); the template's Decl was
        # found at collection through the instantiation's own scope
        if (r.tmplDeclId.isZero) == false then {
            match (
                program
            ) case program then {
                mintUnitMonoOf :st :frame ast: program.ast :r label: rm
                (scanTemplateBodyDemands
                    :st
                    :frame

                    ast: program.ast
                    tmplDeclId: r.tmplDeclId
                    templateOpId: (zast.nodeid.create from: r.tmplOpId.u32.orPanic)
                )
            } else null
        }
        i = i + 1
    }
}

# mintUnitMonoOf -- one instantiation's mono: its arguments demanded and
# drained (the mint pass precedes the drain), keyed in the template's
# parameter order, found on the trie under the template or minted and
# joined there. The label is display only. An argument nothing resolves is
# reported here, where the request is.
mintUnitMonoOf: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    r: InstReq.view
    label: StringView
} is {
    demandInstArgs :st :frame :ast :r
    resolveDemandedDefs :st :frame :ast
    templateTid: declTypeIdOf :st declId: r.tmplDeclId
    keys: (ListVal u64)
    isVal: (ListVal bool)
    ok: instMonoKeys :st :frame :ast :r tdecl: r.tmplDeclId :keys :isVal
    if (ok) == false then {
        reportUnresolvedInstArgs :st :frame :ast :r
        return
    }
    got: unitMonoOnTrie :st tplTid: templateTid :keys
    match (
        got
    ) case some then {
        return
    } case none then null
    mono: (createUnitMono
        :st

        :ast
        monoName: label
        tmplDeclId: r.tmplDeclId
        tplTid: templateTid
        templateOpId: (zast.nodeid.create from: r.tmplOpId.u32.orPanic)
    )
    tplT9: zast.poolTextAt pool: ast.names ref: r.tmplId
    unitMonoJoinTrie :st tplTid: templateTid tplName: tplT9.stringView :keys monoId: mono
}

# reportUnresolvedInstArgs -- E0023 at every instantiation argument that names
# nothing (a numeric value always resolves).
reportUnresolvedInstArgs: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast.view
    r: InstReq.view
} is {
    n: r.argLabels.length
    i: u64
    for i < n loop {
        an: r.argNames.get :i
        nid: r.argNodeIds.get :i
        i = i + 1
        if (isNumericLiteralName name: an.stringView) then continue
        if nid == 0 then continue
        rt: u64
        {
            rf: frame
            if (r.scopeDeclId.isZero) == false then rf = r.scopeDeclId
            if an.length > 0 then {
                eh: (envLookup
                    :st
                    frame: rf
                    nameId: (nameIdOf :ast name: an.stringView)
                )
                rt = (declTypeIdOf :st declId: eh.declId).u64
            }
        }
        if rt > 0 then continue
        an8: an.copy
        if an8.length == 0 then an8 = "the argument".string
        n8: ast.nodes.get i: nid
        (addResolveErrorH
            :st
            nodeid: (nodeId n: n8)
            lineno: (nodeLine n: n8)
            colno: (nodeCol n: n8)
            e: zast.err.badReference
            msg: "Unknown reference '\{an8}'"
            width: an8.length.u32.orPanic
        )
    }
}

# resolveTemplateConstants -- a generic template's constant members resolve
# once, keyed on the template's type id and evaluated in the template's frame
# (the way a namespace's do under resolveConstantDefsIn); every instance of
# the template shares them. Idempotent through nsConstsWalked.
resolveTemplateConstants: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    tmplDeclId: ztypes.declid
} is {
    ttid: declTypeIdOf :st declId: tmplDeclId
    if ttid.isZero then return
    top: zast.nodeid
    {
        decl: st.typing.decls.get i: tmplDeclId.u64
        np: ast.nodes.get i: decl.node.u64
        if np.namedoperation then top = np.operation
    }
    if top.isZero then return
    fr: unitRootOfDecl :st declId: tmplDeclId
    if fr.isZero then return
    (resolveConstantDefsIn
        :st
        :frame
        :ast

        unitDecl: fr
        unitdefId: top
        ownerDeclId: tmplDeclId
    )
}

# scanTemplateBodyDemands -- a template's method bodies name definitions the
# way any body does -- a sibling constant, a sibling function, a core type --
# and they resolve in the TEMPLATE's frame, wherever the instantiation was
# written. Demand them from that frame before any instance walk asks; the
# instance walk itself does not scan. Once per template.
scanTemplateBodyDemands: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast.view
    tmplDeclId: ztypes.declid
    templateOpId: zast.nodeid
} is {
    if templateOpId.isZero then return
    if (st.typing.templateBodiesScanned.has item: templateOpId.u64) then return
    st.typing.templateBodiesScanned.add item: templateOpId.u64
    rf: frame
    if (tmplDeclId.isZero) == false then rf = tmplDeclId
    (scanUnitCalls
        :st
        frame: rf

        :ast
        unitdefId: templateOpId
        rootOnly: false
    )
}

# typecheck -- entry point. Registers a UNIT type per unit and resolves the main
# unit's definition signatures, then demand-resolves the cross-unit types those
# signatures referenced. The registry is supplied by the caller, read by the dumper.
# builtinTidTc -- the canonical registry id of a stdlib builtin by base name
# (unitDecl "" so a user type of the same name never shadows it). 0 when absent.
builtinTidT: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    base: StringView
} out ztypes.tid is {
    bk: (zast.poolFind pool: ast.names text: base)
    if bk > 0 then {
        m: st.typing.builtinTidMemo.get key: bk.u64
        match (
            m
        ) case some then {
            return m
        } case none then null
    }
    r: (ztypes.tid.create from: (optU64Or
        o: (walkLookupTyperef :st :frame :ast unitDecl: ztypes.declid :base)
        d: 0
    ))
    if r.isZero then {
        # an internal lookup may still say the aliased container name while
        # the declaration carries the family name (s7): retry the renamed
        # twin -- the alias and the declaration share one canonical tid.
        alt: aliasedContainerTwin name: base
        if alt.length > 0 then {
            r = ztypes.tid.create from: (optU64Or
                o: (walkLookupTyperef
                    :st
                    :frame
                    :ast

                    unitDecl: ztypes.declid
                    base: alt
                )
                d: 0
            )
        }
    }
    if r.isZero then return r
    if bk > 0 then st.typing.builtinTidMemo.set key: bk.u64 value: r
    return r
}

# the type id of builtin type `base` (typecheck-side lookup).
builtinTidTc: function {
    ast: Ast
    st: zenv.ZSymbolTable
    base: StringView
} out ztypes.tid is {
    return (builtinTidT :st frame: st.curFrame :ast :base)
}

# builtinTidTRo -- builtinTidT's read half: the memoised or already-resolved
# registry id of a stdlib builtin by base name, 0 when it has not been
# resolved. Never mints, so it lends ast as a view; a comparison against a
# tid that already exists is exact, because the builtin it could equal is
# resolved whenever that tid is.
builtinTidTRo: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    base: StringView
} out ztypes.tid is {
    bk: (zast.poolFind pool: ast.names text: base)
    if bk > 0 then {
        m: st.typing.builtinTidMemo.get key: bk.u64
        match (
            m
        ) case some then {
            return m
        } case none then null
    }
    r: (ztypes.tid.create from: (optU64Or
        o: (walkLookupTyperefRo :ast :st unitDecl: ztypes.declid :frame :base)
        d: 0
    ))
    if r.isZero then {
        alt: aliasedContainerTwin name: base
        if alt.length > 0 then {
            r = ztypes.tid.create from: (optU64Or
                o: (walkLookupTyperefRo :ast :st unitDecl: ztypes.declid :frame base: alt)
                d: 0
            )
        }
    }
    if r.isZero then return r
    if bk > 0 then st.typing.builtinTidMemo.set key: bk.u64 value: r
    return r
}

# builtinTidTcRo -- builtinTidTc's read half (the current frame; never mints).
builtinTidTcRo: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    base: StringView
} out ztypes.tid is {
    return (builtinTidTRo :st frame: st.curFrame :ast :base)
}

# stampTyperefs -- post-demand pass: stamp every recorded type-ref node with its real
# resolved type. Runs after the demand descent, so system + forward refs are present
# in childOf. pendingTyperef is a sibling field of nodeType (no lock
# conflict). The widened typed_nodes differential reads the resulting nodeType rows.
# nameClaimedByScope -- the probe core shared by the negative-proof chains
# (unknown-reference at value/callable sites, unknown-type at stampTyperefs):
# does a unit-level namespace claim the name -- the unit-name space, the
# current unit's resolved children, or system's children? Callers add their
# context legs (local variables, the typeref walk, the closure-wide unit
# scan) and their own exemptions.
nameClaimedByScope: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    name: StringView
} out bool is {
    if (nameDenotesUnit :st :frame nameId: (nameIdOf :ast :name)) then return true
    # a name the unit DECLARES is claimed whether or not it resolved: a
    # failed declaration is reported once, at the declaration
    declared: st.typing.declFindChild parentDeclId: unitDecl nameId: (nameIdOf :ast :name)
    if (declared.isZero) == false then return true
    # the current unit's own resolved members (its index), not its SURFACE:
    # a definition its `public:` block makes is reachable qualified, never
    # bare, and must not vouch for a bare name
    ncr: (childOfWalkIds
        :st
        :unitDecl
        name: (zast.poolFind pool: ast.names text: name)
    )
    match (
        ncr
    ) case some then {
        return true
    } case none then null
    # `Any` is not user-reachable through the system probe: only a real
    # scope claim above (its own unit defining it) counts.
    if name == "Any" then return false
    nameId96: (zast.poolFind pool: ast.names text: name)
    ncs: (resolveUnitChild
        :st
        :ast
        unitDecl: st.typing.systemUnitRoot
        nameId: nameId96
    )
    match (
        ncs
    ) case some then {
        # system's own nested units are private to it: a bare name that is
        # one of them is in scope nowhere else
        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: ncs)) != ztypes.ztypetype.unitType then return true
    } case none then null
    return false
}

# stamp resolved type ids onto every type reference in the program.
stampTyperefs: function {st: zenv.ZSymbolTable program: Node} is {
    match (
        program
    ) case program then {
        stampPendingTyperefs :st ast: program.ast unitDecl: st.typing.mainUnitRoot
        st.typing.typerefPassRan = true
    } else null
}
# stampOnePendingTyperef -- resolve one deferred type-ref and stamp it. The ref
# resolves in the frame it was WRITTEN in, not in whatever frame the drain runs
# under; one whose declaration is still unresolved is queued for retry rather
# than reported.
stampOnePendingTyperef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    uk: u64
    pval: zast.nameid
    gpNames: (IdSet zast.nameid).view
} is {
    # the type-ref resolves in the frame it was written in
    rf: ztypes.declid
    {
        fo: st.typing.pendingTyperefFrame.get key: uk
        match (
            fo
        ) case some then {
            rf = fo
        } case none then null
    }
    # the frame's unit, as the label the surface / claim probes take
    origin: unitDecl
    originOwn: String
    {
        our: unitRootOfDecl :st declId: rf
        if (our.isZero) == false then {
            originOwn = zast.poolTextCopy pool: ast.names ref: (declNameIdOf :st declId: our)
        }
    }
    if originOwn.length > 0 then origin = (unitDeclOfNameOrOwn
        :st
        frame: rf
        nameId: (nameIdOf :ast name: originOwn.stringView)
        )
    skip0: false
    {
        sk0: st.typing.noStampNode.get key: uk
        match (
            sk0
        ) case some then {
            if sk0 then skip0 = true
        } case none then null
    }
    if (skip0) == false then {
        r: (walkLookupTyperefFrom
            :st
            :ast

            frame: rf
            baseId: pval
        )
        match (
            r
        ) case some then {
            nid: uk
            (ztyping.nodeTypeSet
                tbl: st.typing.nodeType
                :nid
                tid: (ztypes.tid.create from: r.u64)
            )
            # every resolved type reference records the declaration it
            # names (refDecl), for go-to-definition (bare + dotted);
            # codegen-inert -- a type-annotation atom is never emitted
            # as an expression.
            sfNmB: pval
            sfB: (declSurfaceOfName
                :st

                :ast
                unitDecl: origin
                nameId: sfNmB
                tid: (ztypes.tid.create from: r.u64)
            )
            stampRefDecl :st :nid declId: sfB
        } case none then {
            # a signature typeref that resolves NOWHERE after every
            # demand pass names a nonexistent type. Template param
            # names are exempt: their pendings feed mono substitution
            # and resolve per instantiation (a dead-signature typo
            # that collides with some template's param name is the
            # accepted blind spot).
            if (gpNames.has item: pval) then return
            # a name whose declaration the environment finds queued or
            # mid-resolution is not unknown: this pass may run in the
            # middle of a drain (a nested unit materialising stamps what
            # it recorded) before the declaration has resolved. The
            # reference stamps on a later pass, once it has.
            dh: (envLookup
                :st
                frame: rf
                nameId: pval
            )
            dhWait: false
            if (dh.declId.isZero) == false then {
                if (st.typing.declIsPending declId: dh.declId) then dhWait = true
                if (st.typing.declIsResolving declId: dh.declId) then dhWait = true
            }
            if dhWait then {
                st.typing.typerefRetry.append from: uk
                return
            }
            # an owned copy: the walks below lend ast
            pvalT: zast.nameTextCopy :ast ref: pval
            urHit: (nameClaimedByScope
                :st
                frame: rf
                :ast

                unitDecl: origin
                name: pvalT.stringView
            )
            if urHit == false when pvalT.stringView == "Any" then {
                # `Any` is not user-reachable through the closure:
                # only a scope claim (its own unit defining it)
                # resolves it, so an unclaimed `Any` reports.
                urHit = false
            } else if urHit == false then {
                # closure-wide: a bare name may resolve to a member
                # of ANY loaded unit (the demand resolvers search
                # the closure; the typeref walk does not)
                puds: programUnitDecls :st
                with uit: puds.iterate do for ud: uit loop {
                    if urHit == false then {
                        uro2: (resolvedByIds
                            :st
                            :ast
                            unitDecl: (ztypes.declid.create from: ud)
                            name: pval
                        )
                        match (
                            uro2
                        ) case some then {
                            urHit = true
                        } case none then null
                    }
                }
            }
            if urHit then return
            un: ast.nodes.get i: uk
            um: "Unknown type '\{pvalT}'"
            (addResolveErrorH
                :st
                nodeid: (nodeId n: un)
                lineno: (nodeLine n: un)
                colno: (nodeCol n: un)
                e: zast.err.badReference
                msg: um
                width: pvalT.length.u32.orPanic
            )
        }
    }
}


# stampPendingTyperefs -- stamp the type-ref nodes recorded since the last
# call (pendingTyperef is append-only and iterates in insertion order, so a
# count is the cursor). The first call is the post-demand pass; a definition
# resolved after it -- from a drain during the body walk -- records its
# type-refs the same way, and the drain re-runs this over the new tail.
stampPendingTyperefs: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
} is {
    pkeys: (ListVal u64)
    pvals: (ListVal zast.nameid)
    # entries an earlier pass deferred (their declaration was still
    # unresolved) come first, then the entries recorded since the last pass
    ri: u64
    rn: st.typing.typerefRetry.length
    for ri < rn loop {
        rk: st.typing.typerefRetry.get i: ri
        ri = ri + 1
        rv: st.typing.pendingTyperef.get key: rk
        match (
            rv
        ) case some then {
            pkeys.append rk
            pvals.append rv
        } case none then null
    }
    st.typing.typerefRetry = (ListVal u64)
    seen: u64
    with it: st.typing.pendingTyperef.iterateItems do for e: it loop {
        seen = seen + 1
        if seen > st.typing.typerefsStamped then {
            pk: e.key
            pkeys.append pk
            pvals.append e.value
        }
    }
    st.typing.typerefsStamped = seen
    gpNames: (IdSet zast.nameid)
    gpiN: 1.u64
    gpLast: st.reg.nextTypeId
    for gpiN < gpLast loop {
        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: gpiN.u64)) == ztypes.ztypetype.genericParam then {
            gnm: st.reg.nameOf tid: (ztypes.tid.create from: gpiN.u64)
            gnmId: nameIdOf :ast name: gnm.stringView
            if (gnmId.isZero) == false then gpNames.add item: gnmId
        }
        gpiN = gpiN + 1
    }
    pi: u64
    pcnt: pkeys.length
    for pi < pcnt loop {
        uk: pkeys.get i: pi
        pval: pvals.get i: pi
        pi = pi + 1
        (stampOnePendingTyperef
            :st
            :ast
            :unitDecl
            :uk
            :pval
            :gpNames
        )
    }
}

# ownershipOfParam -- a parameter's binding ownership from its path annotation:
# an explicit .take binds OWNED, everything else (.borrow / .lock / default)
# binds BORROWED.
ownershipOfParam: function {o: optionval ztypes.zparamownership} out ztypes.zownership is {
    match (
        o
    ) case some then {
        po: o
        match (
            po
        ) case noneMode then {
            return ztypes.zownership.borrowed
        } case takeMode then {
            return ztypes.zownership.owned
        } case borrowMode then {
            return ztypes.zownership.borrowed
        } case viewMode then {
            return ztypes.zownership.borrowed
        } case holdMode then {
            return ztypes.zownership.owned
        } case takexMode then {
            # `takex` is a RETURN marker: the result is owned, and the pin on
            # its non-owned sources is what the marker adds. As an ownership
            # answer it is plain `owned`, exactly like `take`.
            return ztypes.zownership.owned
        }
    } case none then {
        return ztypes.zownership.borrowed
    }
}

# paramTypeId -- the resolved type id of a parameter's type-expr. Reads the
# post-demand node stamp (stampTyperefs), falling back to a cross-unit name
# lookup for a bare-atom base.
paramTypeId: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    opNid: zast.nodeid
} out u64 is {
    # A parameter type carrying an ownership marker (ztypes.ZTypeRegistry.take)
    # resolves through its peeled base: the marker node is recorded under the
    # current unit and left unstamped, so read the inner cross-unit ref that
    # stampTyperefs resolved. The row is read through a view scoped to this
    # block, and what leaves the block are NAME IDS: an id is a scalar, so it
    # holds no lock on ast, and the lookups below lend ast.
    peelTo: zast.nodeid
    onid: zast.nodeid
    anId: zast.nameid
    bnId: zast.nameid
    dcnId: zast.nameid
    {
        op: ast.nodes.get i: opNid.u64
        match (
            op
        ) case dottedpath then {
            ocn: zast.nameTextCopy :ast ref: (atomNameId :ast n: (ast.nodes.get i: op.child.u64))
            if (isStripMarker name: ocn.stringView) then peelTo = op.parent
        } else null
        onid = nodeId n: op
        anId = atomNameId :ast n: op
        bnId = rootNameIdOf :ast n: op
        dcnId = dottedChildNameId :ast n: op
    }
    if (peelTo.isZero) == false then return (paramTypeId :st :ast :unitDecl opNid: peelTo)
    r: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: onid.u64
    if r > 0 then return r
    ano: walkLookupTyperefById :st frame: st.curFrame :ast :unitDecl baseId: anId
    anid: optU64Or o: ano d: 0
    if anid > 0 then return anid
    # a dotted typeref naming a variant/union ARM is an arm DEFAULT:
    # the parameter's type is the tagged parent.
    if (bnId.isZero) == false then {
        # a dotted numeric literal (0.u64) declares the SUFFIX type: the
        # body read must carry it, not fall to 0 (untyped/permissive). The two
        # shape questions are asked of the text, so it is copied HERE -- the
        # early returns above are the common answer and pay nothing for it.
        bn: zast.nameTextCopy :ast ref: bnId
        dcn: zast.nameTextCopy :ast ref: dcnId
        isSfx: isNumericTypeName name: dcn.stringView
        if (isNumericLiteralName name: bn.stringView) when isSfx then {
            return (optU64Or
                o: (walkLookupTyperefById :st frame: st.curFrame :ast :unitDecl baseId: dcnId)
                d: 0
            )
        }
        return (optU64Or
            o: (walkLookupTyperefById :st frame: st.curFrame :ast :unitDecl baseId: bnId)
            d: 0
        )
    }
    return 0
}

# isReturnCallKind -- true iff the stamped call-kind is a diverging control
# statement (return / panic / error); the statement walk marks the scope
# unreachable after one.
isReturnCallKind: function {o: optionval zast.callkind} out bool is {
    match (
        o
    ) case some then {
        ck: o
        match (
            ck
        ) case returnCall then {
            return true
        } case panicCall then {
            return true
        } case errorCall then {
            return true
        } else {
            return false
        }
    } case none then {
        return false
    }
}

# printableNumericName -- the numeric/bool scalar names the emitter's
# interp formatter accepts by name (shadow or spec-scoped instances carry
# these names with non-builtin ids).
printableNumericName: function {name: StringView} out bool is {
    if (isNumericTypeName :name) then return true
    return name == "bool"
}

# printableInterpTid -- an interpolated part must be a value the string
# machinery can splice: a numeric scalar, bool, a declared tag, String or
# StringView (directly, via typedef, or a str-origin mono/port). Unstamped
# values and generic params pass -- the emitter's loud unhandled-construct
# backstop covers a bad instantiation.
printableInterpTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    tid: ztypes.tid
} out bool is {
    if tid.isZero then return true
    if tid == st.reg.literalIntTid then return true
    if tid == st.reg.literalFloatTid then return true
    t: tid
    for true loop {
        b: typedefBaseTidOf :st tid: t
        if b.isZero then break
        t = b
    }
    if (isNumericTid :st frame: st.curFrame :ast tid: t) then return true
    if t == (builtinTidT :st frame: st.curFrame :ast base: "bool") then return true
    if t == (builtinTidT :st frame: st.curFrame :ast base: "String") then return true
    if t == (builtinTidT :st frame: st.curFrame :ast base: "StringView") then return true
    tt: st.reg.typetypeOf typeId: t
    if tt == ztypes.ztypetype.genericParam then return true
    if tt == ztypes.ztypetype.tagType then return true
    if tt == ztypes.ztypetype.functionType then {
        ro: methodReturnOf :st mid: (ztypes.tid.create from: t.u64)
        match (
            ro
        ) case some then {
            return (printableInterpTid :ast :st :unitDecl tid: ro)
        } case none then null
        return true
    }
    tn: st.reg.nameOf tid: t
    if (printableNumericName name: tn.stringView) then return true
    if tn.stringView == "String" then return true
    if tn.stringView == "StringView" then return true
    strO: builtinTidT :st frame: st.curFrame :ast base: "str"
    go: st.reg.genericOriginOf tid: t
    if strO > 0 when go.u64 == strO then return true
    return false
}

# checkString -- a non-interpolated string literal types as StringView; an
# interpolated one (any non-chunk part) types as String, since it must allocate
# to splice the values, and each interpolated sub-expression is walked + stamped.
checkString: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    node: strref
} out ztypes.tid is {
    result: ztypes.tid
    hasInterp: false
    k: u64
    for k < node.nparts loop {
        partId: zast.stringPartAt :ast nid: node.nid i: k
        k = k + 1
        arm: rowArmAt :ast nid: partId
        match (
            arm
        ) case stringchunk then null else {
            hasInterp = true
            en0: st.typing.errors.length
            ptid: checkValueAt :st :unitDecl :ast nid: partId
            if ptid.isZero when st.typing.errors.length == en0 then {
                reportUnresolvedValue :st :unitDecl :ast nid: partId
            }
            if st.typing.errors.length == en0 when (printableInterpTid
                :ast
                :st
                :unitDecl
                tid: ptid
            ) == false then {
                pLn: u32
                pCo: u32
                {
                    part: ast.nodes.get i: partId.u64
                    pLn = nodeLine n: part
                    pCo = nodeCol n: part
                }
                ptn: st.reg.nameOf tid: ptid
                pm: "type '\{ptn}' is not printable in an interpolation"
                (addErrorH
                    :st
                    nodeid: partId
                    lineno: pLn
                    colno: pCo
                    e: zast.err.typeError
                    msg: pm
                    note: "an interpolated value must be numeric, bool, String or StringView".string
                    hint: "unwrap or format the value first: match on it or use an accessor that yields a printable type".string
                    width: 1
                )
            }
        }
    }
    # the runtime value is always the SYSTEM String/StringView (the interp
    # machinery and the literal pool build system strings), so the stamp is
    # canonical even in a unit that shadows the name
    tyOpt: (optionval.none u64)
    if hasInterp then {
        tyOpt = (walkLookupTyperef
            :st
            frame: st.curFrame
            :ast

            unitDecl: ztypes.declid
            base: "String"
        )
    } else {
        tyOpt = (walkLookupTyperef
            :st
            frame: st.curFrame
            :ast

            unitDecl: ztypes.declid
            base: "StringView"
        )
    }
    match (
        tyOpt
    ) case some then {
        result = ztypes.tid.create from: tyOpt.u64
        setk: result
        stampGate :st nid: node.nid.u64 tid: setk
    } case none then null
    drainPendingBorrow :st
    return result
}
# cloneMethodParams -- copy the template method's parameters onto the clone, with
# the specialisation's arguments substituted for the generic parameters, and the
# ownership markers the template declared carried across unchanged.
cloneMethodParams: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    specId: ztypes.tid
    fid5: ztypes.tid
    templateName: StringView
    cN5: (List String).view
    cI5: (ListVal u64).view
    cOh5: (ListVal bool).view
    cOv5: (ListVal ztypes.zparamownership).view
    idSubs: (IdMapV u64 v: u64)
    tplClassId: ztypes.tid
    tpn0: StringView
} is {
    pi5: u64
    pn5: cN5.length
    for pi5 < pn5 loop {
        pnm5: cN5.get i: pi5
        ptid5: cI5.get i: pi5
        tgt5: ptid5
        if ptid5 == tplClassId then tgt5 = specId
        if pnm5.stringView == "this" then tgt5 = specId
        if tpn0.length > 0 when pnm5.stringView == tpn0 then tgt5 = specId
        if tgt5 == ptid5 then {
            # `this`/`type`-typed params carry fresh shells named after the
            # class; shell-name identity marks the self type.
            ptn5: st.reg.nameOf tid: (ztypes.tid.create from: ptid5.u64)
            if ptn5.stringView == templateName then tgt5 = specId
        }
        if tgt5 == ptid5 then {
            ido5: idSubs.get key: ptid5
            match (
                ido5
            ) case some then {
                tgt5 = ido5
            } case none then {
                rs5: respecialize :st :frame :ast :unitDecl specTid: ptid5 :idSubs
                if rs5 > 0 then tgt5 = rs5
            }
        }
        (st.typing.setMemberType
            parentTypeId: fid5
            nameId: (zast.poolFind pool: ast.names text: pnm5.stringView)
            childTypeId: tgt5
        )
        if (cOh5.get i: pi5) then {
            pov5: cOv5.get i: pi5
            (st.typing.setChildOwnership
                pool: ast.names
                parentTypeId: fid5
                name: pnm5.stringView
                ownership: pov5
            )
        }
        pi5 = pi5 + 1
    }
}
# cloneMethodReturn -- the clone's return type: the template's, with the
# specialisation's arguments substituted. A composite return that still mentions a
# generic parameter respecializes rather than being copied through.
cloneMethodReturn: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    specId: ztypes.tid
    tplClassId: ztypes.tid
    fid5: ztypes.tid
    tplFnId: u64
    templateName: StringView
    idSubs: (IdMapV u64 v: u64)
} is {
    rto5: ztypes.tid
    {
        ro5: st.reg.returnTypeOf tid: (ztypes.tid.create from: tplFnId.u64)
        if ro5 > 0 then rto5 = ro5
    }
    if rto5 > 0 then {
        rt5: rto5
        if rto5 == tplClassId then rt5 = specId
        if rt5 == rto5 then {
            rtn5: st.reg.nameOf tid: (ztypes.tid.create from: rto5.u64)
            if rtn5.stringView == templateName then rt5 = specId
        }
        rdo5: idSubs.get key: rto5
        match (
            rdo5
        ) case some then {
            rt5 = ztypes.tid.create from: (rdo5)
        } case none then {
            rr5: respecialize :st :frame :ast :unitDecl specTid: rto5 :idSubs
            if rr5 > 0 then rt5 = ztypes.tid.create from: rr5.u64
        }
        # a return still GENERIC_PARAM-typed (a partial the subs could not
        # complete -- multi-param chains mint with empty subs) stays unset;
        # the name-keyed fixup arms heal it after minting
        if (st.reg.typetypeOf typeId: rt5) != ztypes.ztypetype.genericParam then {
            st.reg.setReturnType typeId: fid5 value: rt5
        }
    }
}

# checkAtomid -- type a name-atom in value position: a local variable resolves
# via the symbol table. (Numeric literals + unit-def atoms land in later slices.)
# cloneMethodInto -- specialize one template method for an instance: a fresh
# FUNCTION type named {spec}.{m} whose param children and return substitute
# the template parameters (id-first, then re-specialization). genericOriginId
# points at the TEMPLATE METHOD so the emitter's mono-instance sweep emits the
# template body against this signature.
cloneMethodInto: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    specId: ztypes.tid
    tplClassId: ztypes.tid
    m: StringView
    tplFnId: u64
    idSubs: (IdMapV u64 v: u64)
} is {
    fid5: st.reg.newType name: m ownerTid: specId typetype: ztypes.ztypetype.functionType
    st.reg.setGenericOrigin typeId: fid5 value: tplFnId
    # declare and type the method before filling its parameters: typing claims
    # the method's own function type for its declaration, which is what the
    # parameter writes below reach through. Doing it last leaves every parameter
    # of every cloned method with nowhere to land.
    mnid5: (zast.poolFind pool: ast.names text: m)
    (st.typing.declSynthMember
        parentTypeId: specId
        nameId: mnid5
        kind: ztyping.declkind.methodDecl
    )
    (st.typing.setMemberType parentTypeId: specId nameId: mnid5 childTypeId: fid5)
    # The clone answers call-site questions the same way the template does:
    # isNative gates arg validation, thisParamName drives receiver auto-fill
    # and the no-paren auto-call, funcReturnsBorrow carries the `.borrow`
    # return marker, and funcReturnNode backs methodReturnOf for concrete
    # (non-generic) returns.
    tpn0id: u32
    isNativeFn: false
    if tplFnId < st.reg.typeById.length then {
        tz0: st.reg.typeById.get i: tplFnId
        if tz0.isNative then isNativeFn = true
        tpn0id = tz0.thisParamNameId
    }
    if isNativeFn then st.reg.setNative typeId: fid5 value: true
    if tpn0id > 0 then (st.reg.setThisParamName
        typeId: fid5
        nameId: (zast.nameid.create from: tpn0id.u32)
    )
    tpn0: zast.poolTextAt pool: ast.names ref: (zast.nameid.create from: tpn0id.u32)
    if (optBoolOr o: (st.typing.funcReturnsView.get key: tplFnId) d: false) then {
        st.typing.funcReturnsView.set key: fid5 value: true
    }
    if (optBoolOr o: (st.typing.funcReturnsTakex.get key: tplFnId) d: false) then {
        st.typing.funcReturnsTakex.set key: fid5 value: true
    }
    if (optBoolOr o: (st.typing.funcReturnsBorrow.get key: tplFnId) d: false) then {
        st.typing.funcReturnsBorrow.set key: fid5 value: true
    }
    frn0: optU64Or o: (st.typing.funcReturnNode.get key: tplFnId) d: 0
    if frn0 > 0 then st.typing.funcReturnNode.set key: fid5 value: frn0
    cN5: (List String)
    cI5: (ListVal u64)
    cNid5: (ListVal u64)
    cOh5: (ListVal bool)
    cOv5: (ListVal ztypes.zparamownership)
    {
        (st.typing.declMemberList
            ownerTid: (ztypes.tid.create from: tplFnId.u64)
            names: cNid5
            tids: cI5
        )
        cq5: u64
        cqn5: cNid5.length
        for cq5 < cqn5 loop {
            nmB5: ast.names.texts.get i: ((cNid5.get i: cq5)).u64
            nm5: nmB5.copy
            cN5.append nm5
            cq5 = cq5 + 1
        }
    }
    # the template's parameter ownership
    {
        oi5: u64
        for oi5 < cNid5.length loop {
            onid5: cNid5.get i: oi5
            oi5 = oi5 + 1
            oo5: (st.typing.declOwnershipOfId
                parentTypeId: (ztypes.tid.create from: tplFnId.u64)
                nameId: (zast.nameid.create from: onid5.u32.orPanic)
            )
            match (
                oo5
            ) case some then {
                cOh5.append true
                ov5c: oo5
                cOv5.append ov5c
            } case none then {
                cOh5.append false
                cOv5.append ztypes.zparamownership.borrowMode
            }
        }
    }
    templateName: st.reg.nameOf tid: (ztypes.tid.create from: tplClassId.u64)
    (cloneMethodParams
        :ast
        :st
        :unitDecl
        :frame
        :specId
        :fid5
        templateName: templateName.stringView
        :cN5
        :cI5
        :cOh5
        :cOv5
        :idSubs
        :tplClassId
        tpn0: tpn0.stringView
    )
    (cloneMethodReturn
        :ast
        :st
        :unitDecl
        :frame
        :specId
        :tplClassId
        :fid5
        :tplFnId
        templateName: templateName.stringView
        :idSubs
    )
}

# respecialize -- a type that is itself a specialization (nonempty genericArgs)
# re-specializes when any of its arguments is substituted: the origin template
# specializes again with the mapped argument list. 0 when nothing changes.
respecialize: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    specTid: u64
    idSubs: (IdMapV u64 v: u64)
} out u64 is {
    an: st.reg.genericArgCount specId: (ztypes.tid.create from: specTid.u64)
    if an == 0 then return 0
    origin: ztypes.tid
    {
        og: st.reg.genericOriginOf tid: (ztypes.tid.create from: specTid.u64)
        if og > 0 then origin = og
    }
    if origin.isZero then return 0
    changed: false
    mapped: (ListVal u64)
    ai: u64
    for ai < an loop {
        av: st.reg.genericArgAt specId: (ztypes.tid.create from: specTid.u64) ordinal: ai
        if (st.reg.genericArgIsValueAt
            specId: (ztypes.tid.create from: specTid.u64)
            ordinal: ai
        ) then {
            # a numeric VALUE ordinal has nothing to substitute
            av9v: av
            mapped.append av9v
        } else {
            memberDecl: idSubs.get key: av
            match (
                memberDecl
            ) case some then {
                mapped.append memberDecl
                changed = true
            } case none then {
                # an arg that is itself a spec may carry substitutable args one
                # level down (OptionView over a MapEntry partial) -- recurse
                rec: respecialize :st :frame :ast :unitDecl specTid: av :idSubs
                if rec > 0 then {
                    mapped.append rec
                    changed = true
                } else {
                    av9b: av
                    mapped.append av9b
                }
            }
        }
        ai = ai + 1
    }
    if changed == false then return 0
    tk: declOfTypeId :st tid: origin
    pn: st.reg.genericParamNamesOf tdecl: tk
    if pn.length != an then return 0
    typeSubs: (IdMapV zast.nameid v: u64)
    rvSubs: (IdMapV zast.nameid v: u64)
    sfx: String
    mi: u64
    for mi < an loop {
        mp: pn.get i: mi
        mv: mapped.get i: mi
        sfx.append s: "_"
        if (st.reg.genericArgIsValueAt
            specId: (ztypes.tid.create from: specTid.u64)
            ordinal: mi
        ) then {
            vv9r: mv
            rvSubs.set key: mp value: vv9r
            nvs: "\{mv}"
            sfx.append s: nvs
        } else {
            sv: mv
            typeSubs.set key: mp value: sv
            vn: monoValName :st :frame :ast tid: (ztypes.tid.create from: mv.u64)
            sfx.append s: vn
        }
        mi = mi + 1
    }
    return (getOrMintSpec
        :st
        :frame
        :ast

        :unitDecl
        sfx: sfx.stringView
        templateId: (ztypes.tid.create from: origin.u64)
        subs: typeSubs
        valSubs: rvSubs
        fallbackArg: 0
    )
}

# templateTypetypeOf -- the typetype a specialization of `templateId` takes. The
# spec front door allocates the instance id itself (so the trie path can be
# written before the children are built), and this is the one thing about the
# template it needs to do that.
templateTypetypeOf: function {
    st: zenv.ZSymbolTable.view
    templateId: ztypes.tid
} out ztypes.ztypetype is {
    if templateId < st.reg.typeById.length then {
        tpl: st.reg.typeById.get i: templateId
        return tpl.typetype
    }
    return ztypes.ztypetype.recordType
}
# cloneGenericMemberInto -- a generic FUNCTION child of a template is cloned per
# instance, with its own parameters and return substituted. True when the clone
# landed, so the caller does not also write the member's template type.
cloneGenericMemberInto: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    rf: ztypes.declid
    templateId: ztypes.tid
    mid: u64
    chName: StringView
    chId: u64
    fallbackArg: u64
    listRefTid: ztypes.tid
    subs: (IdMapV zast.nameid v: u64).view
    idSubs: (IdMapV u64 v: u64)
} out bool is {
    deep5: false
    isSynth: false
    if chName == "create" then isSynth = true
    if chName == "borrow" then isSynth = true
    if chName == "==" then isSynth = true
    if chName == "!=" then isSynth = true
    if isSynth == false then {
        skip5: false
        # List's contains/sort exist only for eligible element
        # kinds (use-site parity with the materializer gate).
        if templateId == listRefTid when listRefTid > 0 then {
            csM5: false
            if chName == "contains" then csM5 = true
            if chName == "sort" then csM5 = true
            if csM5 then {
                elemTid: (optU64Or
                    o: (subs.get key: (firstGenericParamId :st :templateId))
                    d: 0
                )
                if elemTid == 0 then elemTid = fallbackArg
                ok5: false
                if elemTid > 0 then {
                    csel5: false
                    if chName == "contains" then {
                        csel5 = (isContainsEligibleTid
                            :st
                            frame: rf
                            :ast

                            tid: (ztypes.tid.create from: elemTid.u64)
                        )
                    } else {
                        csel5 = (isSortEligibleTid
                            :st
                            frame: rf
                            :ast

                            tid: (ztypes.tid.create from: elemTid.u64)
                        )
                    }
                    if csel5 then ok5 = true
                }
                if (ok5) == false then skip5 = true
            }
        }
        if skip5 then {
            deep5 = true
        } else {
            (cloneMethodInto
                :st
                frame: rf
                :ast

                :unitDecl
                specId: (ztypes.tid.create from: mid.u64)
                tplClassId: templateId
                m: chName
                tplFnId: chId
                :idSubs
            )
            deep5 = true
        }
    }
    return deep5
}
# copyMemberMarkers -- a marker belongs to the MEMBER, and every use site asks
# the INSTANCE about it, so ownership and lock-field marks are copied from the
# template's member onto the mono's. True when the member's own type gives the
# mono a destructor.
copyMemberMarkers: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    mid: u64
    templateId: ztypes.tid
    chName: StringView
    target: u64
} out bool is {
    monoNeedsDtor: false
    # A marker belongs to the MEMBER, and every use site asks the
    # INSTANCE type about it -- so it has to be copied onto the clone
    # or it is enforced on the template alone, which nothing checks.
    cho: (st.typing.declOwnershipOfId
        parentTypeId: templateId
        nameId: (zast.poolFind pool: ast.names text: chName)
    )
    match (
        cho
    ) case some then {
        (st.typing.setChildOwnership
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: mid.u64)
            name: chName
            ownership: cho
        )
    } case none then null
    if (st.typing.declIsLockField
        pool: ast.names
        parentTypeId: templateId
        name: chName
    ) then {
        (st.typing.setChildLockField
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: mid.u64)
            name: chName
        )
    } else {
        if (st.reg.needsDestructor typeId: (ztypes.tid.create from: target.u64)) then monoNeedsDtor = true
    }
    return monoNeedsDtor
}
# collapseBoxArm -- THE BOX RULE at instantiation: a union arm whose substituted
# type is a builtin Box mono collapses to the ELEMENT, exactly as a declared
# `(Box T)` arm does. Every union arm is a malloc'd cell on the void* data
# slot, so the collapse keeps construction, match narrowing, the destructor
# cast and the native io fragments' layout on the element -- a Box value IS
# the cell pointer. Answers the type the arm should carry.
collapseBoxArm: function {
    st: zenv.ZSymbolTable.view
    tt: ztypes.ztypetype
    argTid: u64
} out u64 is {
    target: argTid
    if tt == ztypes.ztypetype.unionType then {
        bxg5: ztypes.tid
        {
            bxo5: st.reg.genericOriginOf tid: (ztypes.tid.create from: target.u64)
            if bxo5 > 0 then bxg5 = bxo5
        }
        # the builtin-Box discriminator mirrors checkBoxConstruction's
        # call gate (name + classType + empty body); comparing by name
        # avoids RESOLVING Box here, which would mint its tid earlier
        # than before and renumber every later type id.
        isBoxed: false
        if bxg5 > 0 then {
            bxn5: st.reg.nameOf tid: (ztypes.tid.create from: bxg5.u64)
            if bxn5.stringView == "Box" then {
                if (st.reg.typetypeOf typeId: bxg5) == ztypes.ztypetype.classType then {
                    if (st.typing.declMemberCount ownerTid: bxg5) == 0 then isBoxed = true
                }
            }
        }
        if isBoxed then {
            if (st.reg.genericArgCount specId: (ztypes.tid.create from: target.u64)) == 1 then {
                target = (st.reg.genericArgAt
                    specId: (ztypes.tid.create from: target.u64)
                    ordinal: 0
                )
            }
        }
    }
    return target
}
# elidedArgFallbackTid -- with the leading type argument elided, a member whose
# own type still names the template parameter takes the single argument that
# was given. Answers the type the member should carry.
elidedArgFallbackTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    rf: ztypes.declid
    tplUnit: ztypes.declid
    fallbackArg: u64
    ctnT: StringView
    childIsGeneric: bool
    chId: u64
    argTid: u64
} out u64 is {
    target: argTid
    if fallbackArg > 0 when (ctnT == "null") == false when target == chId when (childIsGeneric) == false then {
        cko: (walkLookupTyperef
            :st
            frame: rf
            :ast

            unitDecl: tplUnit
            base: ctnT
        )
        match (
            cko
        ) case some then null case none then {
            target = fallbackArg
        }
    }
    return target
}
# substitutedMemberTid -- the type a template member resolves to for this
# instance: the id the argument map gives it, a respecialised nested generic,
# or the substitution its own type name selects; the member's own type when
# nothing substitutes.
substitutedMemberTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    rf: ztypes.declid
    chId: u64
    subs: (IdMapV zast.nameid v: u64).view
    idSubs: (IdMapV u64 v: u64)
} out u64 is {
    target: chId
    ido: idSubs.get key: chId
    match (
        ido
    ) case some then {
        target = ido
    } case none then {
        rsp: respecialize :st frame: rf :ast :unitDecl specTid: chId :idSubs
        if rsp > 0 then target = rsp
    }
    ctnT: st.reg.nameOf tid: (ztypes.tid.create from: chId.u64)
    ctn: nameIdOf :ast name: ctnT.stringView
    if target == chId then target = optU64Or o: (subs.get key: ctn) d: target
    return target
}

# mintMonoMember -- give one member of a monomorphised type its substituted
# type: the argument the template parameter resolved to, the mono of a nested
# generic, or the member's own type when nothing substitutes. True when the
# member's type gives the mono a destructor.
mintMonoMember: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    rf: ztypes.declid
    templateId: ztypes.tid
    mid: u64
    tt: ztypes.ztypetype
    tplUnit: ztypes.declid
    listRefTid: ztypes.tid
    fallbackArg: u64
    subs: (IdMapV zast.nameid v: u64).view
    idSubs: (IdMapV u64 v: u64)
    chName: StringView
    chId: u64
} out bool is {
    monoNeedsDtor: false
    target: (substitutedMemberTid :ast :st :unitDecl :rf :chId :subs :idSubs)
    ctnT: st.reg.nameOf tid: (ztypes.tid.create from: chId.u64)
    # THE BOX RULE at instantiation: a union arm whose substituted type
    # is a builtin Box mono collapses to the ELEMENT, exactly as a
    # declared (Box T) arm does. Every union arm is a malloc'd cell on
    # the void* data slot, so the collapse keeps construction, match
    # narrowing, the destructor cast and the native io fragments'
    # layout on the element -- a Box value IS the cell pointer.
    target = collapseBoxArm :st :tt argTid: target
    # Generic FUNCTION children are clone candidates: the elided-arg
    # fallback must not swallow them (a method child's dotted name never
    # resolves, so the lookup-miss leg would replace the method with the
    # element type).
    childIsGeneric: false
    if (st.reg.typetypeOf typeId: (ztypes.tid.create from: chId.u64)) == ztypes.ztypetype.functionType then {
        childIsGeneric = st.reg.isGenericOf tid: (ztypes.tid.create from: chId.u64)
    }
    target = (elidedArgFallbackTid
        :ast
        :st
        :rf
        :tplUnit
        :fallbackArg
        ctnT: ctnT.stringView
        :childIsGeneric
        :chId
        argTid: target
    )
    deep5: false
    if target == chId when childIsGeneric then {
        if (cloneGenericMemberInto
            :ast
            :st
            :unitDecl
            :rf
            :templateId
            :mid
            :chName
            :chId
            :fallbackArg
            :listRefTid
            :subs
            :idSubs
        ) then deep5 = true
    }
    if deep5 == false then {
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: mid.u64)
            nameId: (zast.poolFind pool: ast.names text: chName)
            childTypeId: target
        )
    }
    if (st.reg.typetypeOf typeId: (ztypes.tid.create from: chId.u64)) != ztypes.ztypetype.functionType then {
        if (copyMemberMarkers :ast :st :mid :templateId :chName :target) then monoNeedsDtor = true
    }
    return monoNeedsDtor
}
# mintMonoRecordShape -- give a monomorphised RECORD the shape its template
# declares: the ordinal arms of a variant-like record, the tag width, and the
# per-instance constructor the emitter fills.
mintMonoRecordShape: function {
    ast: Ast
    st: zenv.ZSymbolTable
    rf: ztypes.declid
    templateId: ztypes.tid
    mid: u64
    tt: ztypes.ztypetype
    tplUnit: ztypes.declid
} is {
    if tt == ztypes.ztypetype.recordType then {
        isSized: false
        if templateId == (builtinTidT :st frame: rf :ast base: "str") then isSized = true
        if templateId == (builtinTidT :st frame: rf :ast base: "array") then isSized = true
        tk: declOfTypeId :st tid: templateId
        pNames: st.reg.genericParamNamesOf tdecl: tk
        pi: u64
        pn0: pNames.length
        for pi < pn0 loop {
            pname: pNames.get i: pi
            cdx: st.reg.genericParamConstraintOf tdecl: tk paramName: pname
            # A NUMERIC bound is what synthesizes a field (`size: u64.generic`
            # becomes a real `size` field). Written as a denylist -- everything
            # except `any` and `none` -- this also claimed the FAMILY bounds and
            # StringLike, which are type constraints with nothing to store; it
            # only ever saw numeric/any/none because the family bounds were
            # spelled `Any.generic` until the val/ref rename. Ask the question
            # the comment above states.
            isNum: cdx.kind == ztypes.constraintkind.numeric
            if isNum then {
                exo: (st.typing.declChildOfId
                    parentTypeId: (ztypes.tid.create from: mid.u64)
                    nameId: pname
                )
                match (
                    exo
                ) case some then null case none then {
                    pcon: constraintTextOf desc: cdx
                    cno: (walkLookupTyperef
                        :st
                        frame: rf
                        :ast

                        unitDecl: tplUnit
                        base: pcon.stringView
                    )
                    match (
                        cno
                    ) case some then {
                        (st.typing.setMemberType
                            parentTypeId: (ztypes.tid.create from: mid.u64)
                            nameId: pname
                            childTypeId: cno
                        )
                    } case none then null
                }
            }
            pi = pi + 1
        }
        if (isSized) == false then {
            crId: (st.reg.newType
                name: "create"
                ownerTid: mid
                typetype: ztypes.ztypetype.functionType
            )
            (st.typing.declSynthMember
                parentTypeId: (ztypes.tid.create from: mid.u64)
                nameId: zast.names.wkCreate
                kind: ztyping.declkind.methodDecl
            )
            (st.typing.setMemberType
                parentTypeId: (ztypes.tid.create from: mid.u64)
                nameId: zast.names.wkCreate
                childTypeId: crId
            )
            (forceMemberOf
                :st
                frame: rf

                :ast
                parentTypeId: (ztypes.tid.create from: mid.u64)
                nameId: zast.names.wkOpEq
            )
            eqo: (st.typing.declChildOfId
                parentTypeId: (ztypes.tid.create from: mid.u64)
                nameId: zast.names.wkOpEq
            )
            match (
                eqo
            ) case some then null case none then {
                reqId: (st.reg.newType
                    name: "=="
                    ownerTid: mid
                    typetype: ztypes.ztypetype.functionType
                )
                (st.typing.declSynthMember
                    parentTypeId: (ztypes.tid.create from: mid.u64)
                    nameId: zast.names.wkOpEq
                    kind: ztyping.declkind.methodDecl
                )
                (st.typing.setMemberType
                    parentTypeId: (ztypes.tid.create from: mid.u64)
                    nameId: zast.names.wkOpEq
                    childTypeId: reqId
                )
                rneId: (st.reg.newType
                    name: "!="
                    ownerTid: mid
                    typetype: ztypes.ztypetype.functionType
                )
                (st.typing.declSynthMember
                    parentTypeId: (ztypes.tid.create from: mid.u64)
                    nameId: zast.names.wkOpNe
                    kind: ztyping.declkind.methodDecl
                )
                (st.typing.setMemberType
                    parentTypeId: (ztypes.tid.create from: mid.u64)
                    nameId: zast.names.wkOpNe
                    childTypeId: rneId
                )
            }
        }
    }
}
# templateNeedsMonoDtor -- whether a mono of this builtin template owns heap
# its destructor must release. The list is the collection families that carry
# one; a user template's answer comes from its substituted fields instead.
templateNeedsMonoDtor: function {
    ast: Ast
    st: zenv.ZSymbolTable
    rf: ztypes.declid
    templateId: ztypes.tid
} out bool is {
    needsDtorM: false
    if templateId == (builtinTidT :st frame: rf :ast base: "ListRef") then needsDtorM = true
    if templateId == (builtinTidT :st frame: rf :ast base: "ListVal") then needsDtorM = true
    if templateId == (builtinTidT :st frame: rf :ast base: "Option") then needsDtorM = true
    if templateId == (builtinTidT :st frame: rf :ast base: "Result") then needsDtorM = true
    if templateId == (builtinTidT :st frame: rf :ast base: "MapRR") then needsDtorM = true
    if templateId == (builtinTidT :st frame: rf :ast base: "MapRV") then needsDtorM = true
    if templateId == (builtinTidT :st frame: rf :ast base: "MapVR") then needsDtorM = true
    if templateId == (builtinTidT :st frame: rf :ast base: "MapVV") then needsDtorM = true
    if templateId == (builtinTidT :st frame: rf :ast base: "SetRef") then needsDtorM = true
    if templateId == (builtinTidT :st frame: rf :ast base: "SetVal") then needsDtorM = true
    if templateId == (builtinTidT :st frame: rf :ast base: "IdMapR") then needsDtorM = true
    if templateId == (builtinTidT :st frame: rf :ast base: "IdMapV") then needsDtorM = true
    if templateId == (builtinTidT :st frame: rf :ast base: "IdSet") then needsDtorM = true
    return needsDtorM
}
# mintMonoTagShape -- give a monomorphised sum type its discriminator: the tag
# width its template declares, and for a variant the ordinal each arm carries.
mintMonoTagShape: function {
    st: zenv.ZSymbolTable
    mid: u64
    tt: ztypes.ztypetype
    name: StringView
} is {
    wantTag: false
    if tt == ztypes.ztypetype.variantType then wantTag = true
    if tt == ztypes.ztypetype.unionType then wantTag = true
    if wantTag then {
        tagName: "\{name}:tag:data"
        tagId: st.reg.newType name: tagName.stringView typetype: ztypes.ztypetype.dataType
        (st.typing.declSynthMember
            parentTypeId: (ztypes.tid.create from: mid.u64)
            nameId: zast.names.wkTag
            kind: ztyping.declkind.fieldDecl
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: mid.u64)
            nameId: zast.names.wkTag
            childTypeId: tagId
        )
    }
    if tt == ztypes.ztypetype.variantType then {
        eqId: st.reg.newType name: "==" ownerTid: mid typetype: ztypes.ztypetype.functionType
        (st.typing.declSynthMember
            parentTypeId: (ztypes.tid.create from: mid.u64)
            nameId: zast.names.wkOpEq
            kind: ztyping.declkind.methodDecl
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: mid.u64)
            nameId: zast.names.wkOpEq
            childTypeId: eqId
        )
        neId: st.reg.newType name: "!=" ownerTid: mid typetype: ztypes.ztypetype.functionType
        (st.typing.declSynthMember
            parentTypeId: (ztypes.tid.create from: mid.u64)
            nameId: zast.names.wkOpNe
            kind: ztyping.declkind.methodDecl
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: mid.u64)
            nameId: zast.names.wkOpNe
            childTypeId: neId
        )
    }
}
# mintMonoMembers -- give every member of a monomorphised type its substituted
# type. True when any of them gives the mono a destructor.
mintMonoMembers: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    rf: ztypes.declid
    templateId: ztypes.tid
    mid: u64
    tt: ztypes.ztypetype
    tplUnit: ztypes.declid
    fallbackArg: u64
    subs: (IdMapV zast.nameid v: u64).view
    idSubs: (IdMapV u64 v: u64)
} out bool is {
    cNames: (List String)
    cIds: (ListVal u64)
    forceAllMembers :st frame: rf :ast tid: templateId
    {
        mmNms: (ListVal u64)
        st.typing.declMemberList ownerTid: templateId names: mmNms tids: cIds
        mmq: u64
        mmn: mmNms.length
        for mmq < mmn loop {
            cnB1: ast.names.texts.get i: ((mmNms.get i: mmq)).u64
            cn: cnB1.copy
            cNames.append cn
            mmq = mmq + 1
        }
    }
    listRefTid: builtinTidT :st frame: rf :ast base: "ListRef"
    monoNeedsDtor: false
    ci: u64
    cn3: cNames.length
    for ci < cn3 loop {
        chNameC: cNames.get i: ci
        if (mintMonoMember
            :ast
            :st
            :unitDecl
            :rf
            :templateId
            :mid
            :tt
            :tplUnit
            :listRefTid
            :fallbackArg
            :subs
            :idSubs
            chName: chNameC.stringView
            chId: (cIds.get i: ci)
        ) then monoNeedsDtor = true
        ci = ci + 1
    }
    return monoNeedsDtor
}


# mintMono -- populate one generic-instance type: the template's typetype and
# valtype flag, genericOriginId linking back, and the instance's children -- the template's children with generic-param targets
# substituted (matched by arg name; fallbackArg substitutes every child, the
# single-type-param call-site inference) -- plus the synthesized members: a
# per-instance tag data type (variants and unions) and the autogen ==/!=
# functions (variants). Childless templates (the collection classes) produce
# no children; their cloned method children land with the class-mono slice.
mintMono: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    name: StringView
    templateId: ztypes.tid
    subs: (IdMapV zast.nameid v: u64)
    idSubs: (IdMapV u64 v: u64)
    fallbackArg: u64
    monoTid: u64
} is {
    # a specialisation's members resolve in the TEMPLATE's frame, with the
    # argument substitution -- lexical scoping; the instantiating unit is
    # not where the template's names live
    rf: frame
    {
        td: declOfTypeId :st tid: templateId
        if (td.isZero) == false then rf = td
    }
    # the template's names -- a child's type, a constraint's type -- resolve
    # in the TEMPLATE's unit (the frame is the template), not the
    # instantiating unit's, which may shadow them
    tplUnit: unitDeclOfTid :st tid: templateId
    if tplUnit.isZero then tplUnit = unitDecl
    tt: ztypes.ztypetype.recordType
    vto: (optionval.none bool)
    tplNative: false
    if templateId < st.reg.typeById.length then {
        tpl: st.reg.typeById.get i: templateId
        tt = tpl.typetype
        vto = tpl.isValtype
        tplNative = tpl.isNative
    }
    mid: monoTid
    match (
        vto
    ) case some then {
        st.reg.setValtype typeId: (ztypes.tid.create from: mid.u64) value: vto
    } case none then null
    st.reg.setGenericOrigin typeId: (ztypes.tid.create from: mid.u64) value: templateId
    declMonoType :st monoTid: mid :templateId
    st.reg.setNative typeId: (ztypes.tid.create from: mid.u64) value: tplNative
    if tt == ztypes.ztypetype.classType then st.reg.setIsHeapAllocated typeId: (ztypes.tid.create from: mid.u64)
    # A heap-owning generic instance carries a destructor (so a holder/local
    # frees it; the emitter builds the cname). Collections own native heap;
    # Option/Result own a heap box. A user generic whose template already has a
    # destructor inherits one. Map/Set own native heap too (freed via a `&`-less
    # heap-pointer destroy), and IdMap/IdSet own their two arrays but not their
    # header, so they free like a List does. Views (ListView/OptionView) own no
    # heap -- excluded.
    needsDtorM: templateNeedsMonoDtor :ast :st :rf :templateId
    if needsDtorM then {
        st.reg.setNeedsDestructor typeId: (ztypes.tid.create from: mid.u64)
    }
    # An elided leading type argument stages under the empty name; rebind it
    # to the template's primary generic parameter so the substituted children
    # resolve (`(List String)` == `(List of: String)`).
    {
        emptyKey: zast.nameid
        ev: subs.get key: emptyKey
        match (
            ev
        ) case some then {
            prnm: firstGenericParamId :st :templateId
            if (prnm.isZero) == false then subs.set key: prnm value: ev
        } case none then null
    }
    monoNeedsDtor: (mintMonoMembers
        :ast
        :st
        :unitDecl
        :rf
        :templateId
        :mid
        :tt
        :tplUnit
        :fallbackArg
        :subs
        :idSubs
    )
    # A user generic CLASS whose SUBSTITUTED fields are destructible carries
    # an auto-destructor, exactly like its non-generic counterpart (the
    # builtin-template list above cannot see through substitution; without
    # this, `class { val: t }` with t=String leaks its payload).
    if tt == ztypes.ztypetype.classType when monoNeedsDtor when (st.reg.needsDestructor typeId: (ztypes.tid.create from: mid.u64)) == false then {
        st.reg.setNeedsDestructor typeId: (ztypes.tid.create from: mid.u64)
    }
    # RECORD instances: numeric-param fields synthesize from their declared
    # constraint (size: u64.generic -> a u64 child) when no field references
    # them; then the meta-create requalifies to the instance and ==/!=
    # synthesize -- except str/array, whose branches own those members
    # (their u64 `to` child comes from THIS synth; the branches add none).
    (mintMonoRecordShape :ast :st :rf :templateId :mid :tt :tplUnit)
    mintMonoTagShape :st :mid :tt :name
}


# isContainsEligibleTid / isSortEligibleTid -- element types List.contains /
# List.sort support (the hardcoded equality / ordering dispatch): numerics +
# bool + the String/StringView/str family; sort excludes bool (no ordering).
isContainsEligibleTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    tid: ztypes.tid
} out bool is {
    if tid == (builtinTidT :st :frame :ast base: "bool") then return true
    return (isSortEligibleTid :st :frame :ast :tid)
}

# true when type `tid` is eligible for the sort-support machinery.
isSortEligibleTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    tid: ztypes.tid
} out bool is {
    if tid.isZero then return false
    if (isNumericTid :st :frame :ast :tid) then return true
    if tid == (builtinTidT :st :frame :ast base: "String") then return true
    if tid == (builtinTidT :st :frame :ast base: "StringView") then return true
    if tid == (builtinTidT :st :frame :ast base: "str") then return true
    return false
}

# mintCollectionMethod -- one synthesized `{mono}.{m}` FUNCTION child; returns
# the method's type id so callers can link its return type.
mintCollectionMethod: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    monoId: ztypes.tid
    m: StringView
} out u64 is {
    fid: st.reg.newType name: m ownerTid: monoId typetype: ztypes.ztypetype.functionType
    st.reg.setNative typeId: fid value: true
    mnid: zast.poolFind pool: ast.names text: m
    # declare before typing: setMemberType claims the method's own function type
    # for its declaration, and the parameter writes that follow need it. Typing
    # first leaves the method undeclared, so nothing claims it and every
    # parameter has nowhere to land.
    (st.typing.declSynthMember
        parentTypeId: monoId
        nameId: mnid
        kind: ztyping.declkind.methodDecl
    )
    (st.typing.setMemberType
        parentTypeId: monoId
        nameId: mnid
        childTypeId: fid
    )
    return fid
}

# specLookup -- the existing specialization of `templateId` over the ordered
# concrete arguments `args`, read straight off the id trie getOrMintSpec builds.
# Lookup only: it never mints, so a caller can ask whether an instance was
# demanded. 0 when any argument is unset or the path is not in the trie.
specLookup: function {
    st: zenv.ZSymbolTable.view
    templateId: ztypes.tid
    args: (ListVal u64).view
} out ztypes.tid is {
    if templateId.isZero then return (ztypes.tid.create from: 0)
    if args.length == 0 then return (ztypes.tid.create from: 0)
    cur: templateId
    ok: true
    with ait: args.iterate do for a: ait loop {
        if ok then {
            if a == 0 then {
                ok = false
            } else {
                n: st.reg.getGenericChild parentId: cur key: a
                match (
                    n
                ) case some then {
                    cur = n
                } case none then {
                    ok = false
                }
            }
        }
    }
    if ok == false then return (ztypes.tid.create from: 0)
    return cur
}

# getOrMintSpec -- the id-keyed specialization tree front door: derive the
# definition-order argument keys from the name-keyed subs (fallbackArg fills a
# single missing parameter), walk the generic-child edges, and return the existing
# spec on a full-path hit. A parameter absent from subs with no fallback (a
# numeric value parameter -- str/array's `to`) skips the tree entirely, so
# nothing dedups it. On a miss the leaf materializes via mintMono; multi-level
# paths mint intermediate nodes (genericOriginId = template, genericArgs =
# the key prefix) that cache partial paths without being emitted.
# checkConstraintSat -- a specialization argument against its parameter's
# declared constraint. Any (and numeric bounds, which never reach the tree)
# pass; value-kind constraints check typeIsValtype/typeIsReftype; StringLike
# checks membership. GENERIC_PARAM args skip -- partial specs re-check on
# completion. Location-free (the spec front door holds no source node).
# constraintKindFor -- classify a constraint's declared text into a tag once,
# at registration; the checks then compare the tag, not the string.
constraintKindFor: function {text: StringView} out ztypes.constraintkind is {
    if text == "anyval" then return ztypes.constraintkind.valType
    if text == "AnyRef" then return ztypes.constraintkind.refType
    if text == "valhashable" then return ztypes.constraintkind.valHashable
    if text == "RefHashable" then return ztypes.constraintkind.refHashable
    if text == "idkey" then return ztypes.constraintkind.idKey
    # the pre-rename casings, mapped for the same reason as Any.valtype below
    if text == "AnyVal" then return ztypes.constraintkind.valType
    if text == "ValHashable" then return ztypes.constraintkind.valHashable
    # the pre-rename spellings. They still MAP rather than being removed:
    # an unmapped constraint falls through to `other`, which checkConstraintSat
    # treats as satisfied, so deleting these would silently unconstrain any
    # declaration still using them instead of rejecting it.
    if text == "Any.valtype" then return ztypes.constraintkind.valType
    if text == "Any.reftype" then return ztypes.constraintkind.refType
    if text == "StringLike" then return ztypes.constraintkind.stringLike
    if text == "Any" then return ztypes.constraintkind.any
    if text.length == 0 then return ztypes.constraintkind.none
    nmNode: constraintNumericMax cv: text
    match (
        nmNode
    ) case some then {
        return ztypes.constraintkind.numeric
    } case none then null
    return ztypes.constraintkind.other
}

# constraintNumericName -- the integer-scalar name for a numeric bound, for
# diagnostics; the exact inverse of constraintNumericMax.
constraintNumericName: function {max: u64} out String is {
    if max == 255 then return "u8".string
    if max == 65535 then return "u16".string
    if max == 4294967295 then return "u32".string
    if max == 18446744073709551615.u64 then return "u64".string
    if max == 127 then return "i8".string
    if max == 32767 then return "i16".string
    if max == 2147483647 then return "i32".string
    if max == 9223372036854775807 then return "i64".string
    return "".string
}

# constraintTextOf -- reconstruct a constraint's declared text from its tag
# for diagnostics; reads fields only, constructs nothing.
constraintTextOf: function {desc: ztypes.constraintdesc} out String is {
    if desc.kind == ztypes.constraintkind.valType then return "anyval".string
    if desc.kind == ztypes.constraintkind.refType then return "AnyRef".string
    if desc.kind == ztypes.constraintkind.valHashable then return "valhashable".string
    if desc.kind == ztypes.constraintkind.refHashable then return "RefHashable".string
    if desc.kind == ztypes.constraintkind.idKey then return "idkey".string
    if desc.kind == ztypes.constraintkind.stringLike then return "StringLike".string
    if desc.kind == ztypes.constraintkind.any then return "Any".string
    if desc.kind == ztypes.constraintkind.numeric then {
        nmx7: desc.numericMax
        match (
            nmx7
        ) case some then {
            return (constraintNumericName max: nmx7)
        } case none then null
    }
    return "".string
}

# constraintNumericMax -- the largest value an integer-scalar generic-param
# constraint admits; none when the constraint is not an integer scalar (a
# numeric argument on such a parameter stays on the name-keyed path).
constraintNumericMax: function {cv: StringView} out optionval u64 is {
    if cv == "u8" then return (optionval.some 255.u64)
    if cv == "u16" then return (optionval.some 65535.u64)
    if cv == "u32" then return (optionval.some 4294967295.u64)
    if cv == "u64" then return (optionval.some 18446744073709551615.u64)
    if cv == "i8" then return (optionval.some 127.u64)
    if cv == "i16" then return (optionval.some 32767.u64)
    if cv == "i32" then return (optionval.some 2147483647.u64)
    if cv == "i64" then return (optionval.some 9223372036854775807.u64)
    return (optionval.none u64)
}

# check that a generic argument satisfies its parameter's constraint.
checkConstraintSat: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    tdecl: ztypes.declid
    paramName: zast.nameid
    argTid: ztypes.tid
} is {
    if (st.reg.typetypeOf typeId: argTid) == ztypes.ztypetype.genericParam then return
    cd: st.reg.genericParamConstraintOf :tdecl :paramName
    ck: cd.kind
    if ck == ztypes.constraintkind.none then return
    # `null` is the payload-less marker and satisfies either FAMILY bound --
    # a null arm carries no payload, so the family question does not arise
    # ((Result null e: IoError) stays the io idiom). Hashability bounds
    # still reject it: a null key has nothing to hash.
    isNul: argTid.u64 == st.typing.nullTypeId
    if isNul == false then {
        nn: st.reg.nameOf tid: (ztypes.tid.create from: argTid.u64)
        if nn.stringView == "null" then isNul = true
    }
    if isNul when ck == ztypes.constraintkind.refType then return
    if isNul when ck == ztypes.constraintkind.valType then return
    ok: true
    if ck == ztypes.constraintkind.valType then ok = (typeIsValtype
        :st

        tid: (ztypes.tid.create from: argTid.u64)
    )
    if ck == ztypes.constraintkind.refType then {
        ok = st.reg.isReftypeOf tid: argTid
    }
    # Hashability: one question, asked in one place (see typeIsHashable).
    if ck == ztypes.constraintkind.valHashable then {
        ok = false
        if (typeIsValtype :st tid: (ztypes.tid.create from: argTid.u64)) then {
            ok = typeIsHashable :st :ast tid: (ztypes.tid.create from: argTid.u64)
            # a heap-owning value has no byte range to hash, and the synthesis
            # cannot ask that during resolution -- a self-containing record
            # would recurse forever before the cycle check has run
            if ok when (heapOwningValtypeTid
                :st
                :ast

                tid: (ztypes.tid.create from: argTid.u64)
            ) then ok = false
        }
    }
    if ck == ztypes.constraintkind.refHashable then {
        ok = false
        if (st.reg.isReftypeOf tid: argTid) then {
            ok = typeIsHashable :st :ast tid: (ztypes.tid.create from: argTid.u64)
        }
    }
    # an id key is not merely hashable: the container indexes on its BITS, so
    # the bound admits only the scalars whose bits are an index
    if ck == ztypes.constraintkind.idKey then {
        ok = typeIsIdKey :st :frame :ast tid: (ztypes.tid.create from: argTid.u64)
    }
    if ck == ztypes.constraintkind.stringLike then {
        okSL: false
        svT: builtinTidT :st :frame :ast base: "StringView"
        if svT > 0 when argTid == svT then okSL = true
        if okSL == false then {
            # conformance rows live on the declaring type; a mono (str_32)
            # conforms through its generic origin (the str template)
            probeT: argTid
            {
                agoo: st.reg.genericOriginOf tid: argTid
                if agoo > 0 then probeT = agoo
            }
            txT: builtinTidT :st :frame :ast base: "Text"
            if txT > 0 then {
                with cit: st.typing.conformance.iterate do for crow: cit loop {
                    if crow.specTypeId == txT then {
                        if crow.implTypeId == argTid then okSL = true
                        if crow.implTypeId == probeT then okSL = true
                    }
                }
            }
        }
        ok = okSL
    }
    if (ok) == false then {
        an: st.reg.nameOf tid: (ztypes.tid.create from: argTid.u64)
        con: constraintTextOf desc: cd
        tdn: String
        {
            tdo: st.typing.decls.get i: tdecl.u64
            tdn = st.reg.nameOf tid: (ztypes.tid.create from: tdo.typeId)
            un9x: unitNameOfTid :st tid: (ztypes.tid.create from: tdo.typeId)
            if un9x.length > 0 then tdn = "\{un9x}.\{tdn}"
        }
        pnmT: zast.nameTextAt :ast ref: paramName
        m: "generic argument '\{an}' does not satisfy constraint '\{con}' on parameter '\{pnmT}' of '\{tdn}'"
        addResolveError :st e: zast.err.genericError msg: m
    }
}

# checkAnyBounds -- `Any` is not a user-spellable bound: a generic parameter
# names the family it takes (AnyRef/anyval, a hashable bound, StringLike or a
# numeric width). The spelling still maps to constraintkind.any at
# registration, where the declaring unit is not known, so the gate runs once
# after resolution: a kind-`any` parameter whose declaring unit does not
# itself define `Any` reports the standard unknown-type error. system.z
# defines `Any`, so its residual bounds pass; a user unit passes only by
# defining its own `Any`.
checkAnyBounds: function {ast: Ast.view st: zenv.ZSymbolTable} is {
    anyNid: zast.poolFind pool: ast.names text: "Any"
    if anyNid.isZero then return
    # the declaration nodes to report, collected while the parameter table is
    # read and reported after: the report lends st
    anyNodes: (ListVal u32)
    with git: st.reg.genericParams.iterateItems do for ge: git loop {
        hasAny: false
        with pit: ge.value.params.iterate do for pd: pit loop {
            if pd.constraint.kind == ztypes.constraintkind.any then hasAny = true
        }
        if hasAny then {
            tdecl: ge.key
            unitDecl: ztypes.declid
            declNode: u32
            d: tdecl
            for d > 0 loop {
                decl: st.typing.decls.get i: d.u64
                if declNode == 0 then declNode = decl.node
                match (
                    decl.kind
                ) case unitDecl then {
                    unitDecl = d
                    d = ztypes.declid
                } else {
                    d = decl.parent
                }
            }
            defined: false
            if (unitDecl.isZero) == false then {
                # declFindChild reads the pre-resolution def index, so a
                # defined-but-never-demanded `Any` still counts.
                if (st.typing.declFindChild parentDeclId: unitDecl nameId: anyNid) > 0 then {
                    defined = true
                }
            } else {
                defined = true
            }
            if (defined) == false then {
                if declNode > 0 then anyNodes.append from: declNode
            }
        }
    }
    with rit: anyNodes.iterate do for dn: rit loop {
        tn: ast.nodes.get i: dn.u64
        m: "Unknown type 'Any'".string
        (addResolveErrorH
            :st
            nodeid: (nodeId n: tn)
            lineno: (nodeLine n: tn)
            colno: (nodeCol n: tn)
            e: zast.err.badReference
            msg: m
            width: 3
        )
    }
}

# typeIsHashable -- the type has both `hash` and `==`, so it may key a Map or
# a Set. Read straight off the DECLARATIONS: `hash` and `==` are synthesised
# for a valtype and declared for a reftype, and a member the author struck off
# with a null shell is simply absent -- so the opt-out needs no flag to record
# it, and there is exactly one place that asks.
#
# The answer is DERIVED rather than written back as a conformance row.
# Materialising one makes the emitter treat it as a user-written `:valhashable`
# and emit a facet vtable plus a wrapper per conforming type -- for members
# that have no body, and which nothing ever dispatches through: the containers
# call `hash`/`==` directly. The row would be pure bloat on every record in
# every program.
typeIsHashable: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out bool is {
    ast
    st
    if tid.isZero then return false
    # a typedef synthesises no hash/== of its own: the question chases to
    # the chain-end base (a typedef over a hashable type is hashable)
    htd: tid
    for true loop {
        bo: st.typing.typedefBaseTid.get key: htd
        match (
            bo
        ) case some then {
            htd = ztypes.tid.create from: (bo)
        } case none then break
    }
    if (st.typing.declIsMethodId
        parentTypeId: htd
        nameId: (zast.nameid.create from: zast.names.wkHash)
    ) == false then return false
    return (st.typing.declIsMethodId
        parentTypeId: htd
        nameId: (zast.nameid.create from: zast.names.wkOpEq)
    )
}

# typeIsIdKey -- the type is one of the six unsigned scalars an IdMap / IdSet
# may index on. Asked of the chain-end base, exactly as typeIsHashable is: an
# id space is a typedef over an unsigned scalar (`declid` over u64, `nameid`
# over u32) and collapses to that scalar in the emitted C, so what the wrapper
# is called never enters the question. The six are listed on `system.idkey`;
# this is the predicate that reads them, and the two must agree.
typeIsIdKey: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    tid: ztypes.tid
} out bool is {
    if tid.isZero then return false
    ktd: tid
    for true loop {
        bo: st.typing.typedefBaseTid.get key: ktd
        match (
            bo
        ) case some then {
            ktd = ztypes.tid.create from: (bo)
        } case none then break
    }
    if ktd == (builtinTidT :st :frame :ast base: "u8") then return true
    if ktd == (builtinTidT :st :frame :ast base: "u16") then return true
    if ktd == (builtinTidT :st :frame :ast base: "u32") then return true
    if ktd == (builtinTidT :st :frame :ast base: "u64") then return true
    if ktd == (builtinTidT :st :frame :ast base: "c8") then return true
    return ktd == (builtinTidT :st :frame :ast base: "c32")
}

# heapOwningValtypeTid -- a RECORD/VARIANT that transitively owns heap
# members (a class/union box, a destructor-carrying mono, or another owning
# valtype): its byte-range hash and equality cannot cover them.
heapOwningValtypeTid: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    tid: ztypes.tid
} out bool is {
    tt: st.reg.typetypeOf typeId: tid
    isVR: false
    if tt == ztypes.ztypetype.recordType then isVR = true
    if tt == ztypes.ztypetype.variantType then isVR = true
    if isVR == false then return false
    hcn: st.typing.declRowSlots ownerTid: tid
    hci: u64
    for hci < hcn loop {
        hrow: st.typing.declRowAt ownerTid: tid membersOnly: true slot: hci
        hci = hci + 1
        hnid: hrow.name
        hcto: hrow.tid
        hctt: st.reg.typetypeOf typeId: (ztypes.tid.create from: hcto.u64)
        hnB: ast.names.texts.get i: hnid.u64
        if hrow.keep when hctt != ztypes.ztypetype.functionType when hnB.stringView != "tag" then {
            if hctt == ztypes.ztypetype.classType then return true
            if hctt == ztypes.ztypetype.unionType then return true
            if (st.reg.needsDestructor typeId: (ztypes.tid.create from: hcto.u64)) then return true
            if hctt == ztypes.ztypetype.recordType then {
                if (heapOwningValtypeTid
                    :st
                    :ast

                    tid: (ztypes.tid.create from: hcto.u64)
                ) then return true
            }
            if hctt == ztypes.ztypetype.variantType then {
                if (heapOwningValtypeTid
                    :st
                    :ast

                    tid: (ztypes.tid.create from: hcto.u64)
                ) then return true
            }
        }
    }
    return false
}
# completeSpecChildren -- finish a spec that the trie already carries: its generic
# argument rows, its members, and the walks its members demand.
completeSpecChildren: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    templateId: ztypes.tid
    mid8: ztypes.tid
    keys8: (ListVal u64).view
    keyIsVal8: (ListVal bool).view
} is {
    # a trie-keyed concrete specialization mints its chain family and
    # collection children here with def-order args; name-keyed mints
    # (sized records, empty-subs chains) keep their caller-side
    # invocations, which carry the elem/val ids this path cannot derive
    # elem = the first TYPE key (a sized record's leading value key is
    # not an element); val = the second key only when it is a type
    elemTid: u64
    ei3: u64
    en3: keys8.length
    for ei3 < en3 loop {
        if elemTid == 0 then {
            if (keyIsVal8.get i: ei3) == false then elemTid = keys8.get i: ei3
        }
        ei3 = ei3 + 1
    }
    valC3: ztypes.tid
    if keys8.length > 1 then {
        if (keyIsVal8.get i: 1) == false then valC3 = ztypes.tid.create from: (keys8.get i: 1)
    }
    # MapItemIter's iterator element is the derived MapEntry spec (its
    # call's OptionView some-arm), not a trie key
    skipChild: false
    itemIsIter: false
    if templateId == (builtinTidT :st :frame :ast base: "MapItemIter") then itemIsIter = true
    if templateId == (builtinTidT :st :frame :ast base: "MapItemIterRV") then itemIsIter = true
    if templateId == (builtinTidT :st :frame :ast base: "MapItemIterVR") then itemIsIter = true
    if templateId == (builtinTidT :st :frame :ast base: "MapItemIterVV") then itemIsIter = true
    if itemIsIter then {
        skipChild = true
        (forceMemberOf :st :frame :ast parentTypeId: mid8 nameId: zast.names.wkCall)
        micoC4: st.typing.declChildOfId parentTypeId: mid8 nameId: zast.names.wkCall
        match (
            micoC4
        ) case some then {
            mrtoC4: st.reg.returnTypeOf tid: (ztypes.tid.create from: micoC4.u64)
            if mrtoC4 > 0 then {
                (forceMemberOf :st :frame :ast parentTypeId: mrtoC4 nameId: zast.names.wkSome)
                mieoC4: st.typing.declChildOfId parentTypeId: mrtoC4 nameId: zast.names.wkSome
                match (
                    mieoC4
                ) case some then {
                    elemTid = mieoC4
                    skipChild = false
                } case none then null
            }
        } case none then null
    }
    if skipChild == false then {
        (mintCollectionChildren
            :st
            :frame
            :ast

            monoId: (ztypes.tid.create from: mid8.u64)
            :templateId
            elemArg: elemTid
            valArg: (ztypes.tid.create from: valC3.u64)
        )
    }
}
# mintSpecUnderTemplate -- build the spec's children, LAST, and the trie edge laid
# above is why: building them respecializes, which re-enters getOrMintSpec for this
# very instantiation, and before the edge existed that re-entry found nothing and
# minted a SECOND spec under the same name -- which the emitter then emitted
# beside the first.
mintSpecUnderTemplate: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    name: StringView
    templateId: ztypes.tid
    mid8: ztypes.tid
    subs: (IdMapV zast.nameid v: u64)
    idSubs8: (IdMapV u64 v: u64)
    fallbackArg: u64
} out ztypes.tid is {
    {
        (mintMono
            :st
            :frame
            :ast

            :unitDecl
            :name
            :templateId
            :subs
            idSubs: idSubs8
            :fallbackArg
            monoTid: mid8
        )
        # a Box spec minted from TYPE POSITION (a union's type argument)
        # registers the identity the construction path stamps: isBox drives
        # typeRefC's bare-pointer rendering and the destructor plumbing. The
        # member copy stays with construction -- nothing reads members off
        # an un-constructed Box.
        isBxM8: false
        bxmn8: st.reg.nameOf tid: templateId
        if bxmn8.stringView == "Box" then {
            if (st.reg.typetypeOf typeId: templateId) == ztypes.ztypetype.classType then {
                if (st.typing.declMemberCount ownerTid: templateId) == 0 then isBxM8 = true
            }
        }
        if isBxM8 then {
            st.reg.setIsBox typeId: mid8
            st.reg.setIsHeapAllocated typeId: mid8
        }
    }
    return mid8
}
# buildSpecTrieKeys -- the arguments that key this spec's level of the id trie, in
# the template's DECLARATION order. Answers false when a key cannot be settled, in
# which case the trie is not consulted at all.
buildSpecTrieKeys: function {
    ast: Ast
    st: zenv.ZSymbolTable
    pnames8: (ListVal zast.nameid).view
    subs: (IdMapV zast.nameid v: u64).view
    valSubs: (IdMapV zast.nameid v: u64).view
    fallbackArg: u64
    keys8: (ListVal u64)
    keyIsVal8: (ListVal bool)
    frame: ztypes.declid
    tk8: ztypes.declid
} out bool is {
    trieOk8: true
    if pnames8.length == 0 then {
        # The template's arity is unreadable here -- its parameters are keyed by
        # the DEFINITION's Decl, and a canonical mint made before the unit roots
        # existed links `def` at a proxy instead. The loop below is skipped in
        # that case, so NOTHING in subs/valSubs reaches the key and the fallback
        # can only stand in for a template taking ONE argument. Where the caller
        # supplies more, keying on the fallback alone would hand two different
        # instantiations the SAME spec -- a silent conflation. Refuse the trie
        # instead: that at worst duplicates, which `checkTagStem` reports.
        argc8: subs.length + valSubs.length
        if fallbackArg > 0 when argc8 <= 1 then {
            fb0: fallbackArg
            keys8.append fb0
            keyIsVal8.append false
        } else {
            trieOk8 = false
        }
    }
    with pit8: pnames8.iterate do for pn8: pit8 loop {
        pgot8: subs.get key: pn8
        match (
            pgot8
        ) case some then {
            (checkConstraintSat
                :st
                :frame
                :ast

                tdecl: tk8
                paramName: pn8
                argTid: (ztypes.tid.create from: pgot8.u64)
            )
            keys8.append pgot8
            keyIsVal8.append false
        } case none then {
            vgot8: valSubs.get key: pn8
            match (
                vgot8
            ) case some then {
                # a numeric literal keys its trie level by VALUE; per-level
                # kind is fixed by the parameter, so values and type ids
                # cannot collide
                cd8: st.reg.genericParamConstraintOf tdecl: tk8 paramName: pn8
                nmx8: cd8.numericMax
                match (
                    nmx8
                ) case some then {
                    if vgot8 > nmx8 then {
                        cvn8: constraintTextOf desc: cd8
                        tkNum8: tk8 + 0
                        m8v: "numeric argument \{vgot8} exceeds constraint '\{cvn8}' on parameter '\{pn8}' of '\{tkNum8}'"
                        addResolveError :st e: zast.err.genericError msg: m8v
                    }
                    keys8.append vgot8
                    keyIsVal8.append true
                } case none then {
                    trieOk8 = false
                }
            } case none then {
                if fallbackArg > 0 when pnames8.length == 1 then {
                    fb8: fallbackArg
                    keys8.append fb8
                    keyIsVal8.append false
                } else {
                    trieOk8 = false
                }
            }
        }
    }
    return trieOk8
}
# registerSpecOnTrie -- lay the trie edge for a spec BEFORE its children are built,
# and record its generic-argument rows. The edge has to exist first: building the
# children respecializes, which re-enters getOrMintSpec for this very
# instantiation and must find the spec rather than mint a second one.
registerSpecOnTrie: function {
    st: zenv.ZSymbolTable
    name: StringView
    templateId: ztypes.tid
    mid8: ztypes.tid
    keys8: (ListVal u64).view
    keyIsVal8: (ListVal bool).view
} is {
    cur: templateId
    ki: u64
    kn: keys8.length
    for ki < kn loop {
        k: keys8.get i: ki
        last: false
        if ki + 1 == kn then last = true
        n: st.reg.getGenericChild parentId: cur key: k
        step: u64
        match (
            n
        ) case some then {
            step = n
        } case none then {
            if last then {
                step = mid8
            } else {
                inm: "\{name}__node"
                step = (st.reg.newType
                    name: inm.stringView
                    typetype: ztypes.ztypetype.genericParam
                )
                kj: u64
                for kj <= ki loop {
                    pk: keys8.get i: kj
                    if (keyIsVal8.get i: kj) then {
                        (st.reg.appendGenericArgValue
                            specId: (ztypes.tid.create from: step.u64)
                            value: pk
                        )
                    } else {
                        (st.reg.appendGenericArg
                            specId: (ztypes.tid.create from: step.u64)
                            arg: pk
                        )
                    }
                    kj = kj + 1
                }
            }
            st.reg.setGenericChild parentId: cur key: k child: step
        }
        cur = ztypes.tid.create from: (step)
        ki = ki + 1
    }
    ka: u64
    for ka < kn loop {
        av: keys8.get i: ka
        if (keyIsVal8.get i: ka) then {
            st.reg.appendGenericArgValue specId: mid8 value: av
        } else {
            st.reg.appendGenericArg specId: mid8 arg: av
        }
        ka = ka + 1
    }
}
# buildSpecIdSubs -- the same substitutions the trie keys carry, keyed by the
# template's generic-parameter DECLARATION ids rather than by name.
buildSpecIdSubs: function {
    st: zenv.ZSymbolTable.view
    pnames8: (ListVal zast.nameid).view
    keys8: (ListVal u64).view
    keyIsVal8: (ListVal bool).view
    idSubs8: (IdMapV u64 v: u64)
    tk8: ztypes.declid
} is {
    pi8: u64
    pt8: pnames8.length
    for pi8 < pt8 loop {
        pnm8: pnames8.get i: pi8
        pto8: st.reg.genericParamTidOf tdecl: tk8 paramName: pnm8
        match (
            pto8
        ) case some then {
            if (keyIsVal8.get i: pi8) == false then {
                kv8: keys8.get i: pi8
                pk8: pto8
                idSubs8.set key: pk8 value: kv8
            }
        } case none then null
        pi8 = pi8 + 1
    }
}


# get, or mint on first use, the specialisation for a generic instantiation.
getOrMintSpec: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    sfx: StringView
    templateId: ztypes.tid
    subs: (IdMapV zast.nameid v: u64)
    valSubs: (IdMapV zast.nameid v: u64)
    fallbackArg: u64
} out ztypes.tid is {
    # the label's HEAD is the template's own DECLARED name, never the spelling
    # a caller reached it by. A type has one declaration and any number of
    # aliases, so an alias -- `List` for `collections.ListRef`, or a user's
    # own -- must not decide what the mono is called, and which mint site wins
    # the trie must not decide it either. Callers pass only the argument
    # suffix, which is theirs to compose.
    tk8: declOfTypeId :st tid: templateId
    pnames8: st.reg.genericParamNamesOf tdecl: tk8
    # An elided leading type argument stages under the empty name; rebind it
    # to the primary generic parameter before the trie keys and idSubs build
    # (mintMono's own rebind happens after both).
    {
        emptyKey8: zast.nameid
        ev8: subs.get key: emptyKey8
        match (
            ev8
        ) case some then {
            prnm8: firstGenericParamId :st :templateId
            if (prnm8.isZero) == false then subs.set key: prnm8 value: ev8
        } case none then null
        evv8: valSubs.get key: emptyKey8
        match (
            evv8
        ) case some then {
            prnmv8: firstGenericParamId :st :templateId
            if (prnmv8.isZero) == false then valSubs.set key: prnmv8 value: evv8
        } case none then null
    }
    keys8: (ListVal u64)
    keyIsVal8: (ListVal bool)
    trieOk8: (buildSpecTrieKeys
        :ast
        :st
        :frame
        :tk8
        :pnames8
        :subs
        :valSubs
        :fallbackArg
        :keys8
        :keyIsVal8
    )
    if trieOk8 then {
        cur8: templateId
        ki8: u64
        kn8: keys8.length
        hit8: true
        for ki8 < kn8 loop {
            k8: keys8.get i: ki8
            n8: st.reg.getGenericChild parentId: cur8 key: k8
            match (
                n8
            ) case some then {
                cur8 = n8
            } case none then {
                hit8 = false
                ki8 = kn8
            }
            ki8 = ki8 + 1
        }
        if hit8 then {
            st.reg.specWasFresh = false
            return (ztypes.tid.create from: cur8)
        }
    }
    # composed only past the trie, because a HIT never reads it: the label is
    # decided once, where the spec is minted
    mn8: "\{st.reg.nameOf tid: templateId}\{sfx}"
    idSubs8: (IdMapV u64 v: u64)
    if trieOk8 then buildSpecIdSubs :st :pnames8 :keys8 :keyIsVal8 :idSubs8 :tk8
    hasParamKey8: false
    if trieOk8 then {
        hk8: u64
        hn8: keys8.length
        for hk8 < hn8 loop {
            if (keyIsVal8.get i: hk8) == false then {
                hv8: keys8.get i: hk8
                if (st.reg.typetypeOf typeId: (ztypes.tid.create from: hv8.u64)) == ztypes.ztypetype.genericParam then {
                    hasParamKey8 = true
                }
            }
            hk8 = hk8 + 1
        }
    }
    mid8: ztypes.tid
    if hasParamKey8 then {
        # a generic-param arg makes the spec PARTIAL: a trie-only entry that
        # is never emitted or name-registered; the clone-side respecialize
        # completes it with concrete args per instance.
        pnmP8: "\{mn8}__partial"
        mid8 = st.reg.newType name: pnmP8.stringView typetype: ztypes.ztypetype.genericParam
        st.reg.setGenericOrigin typeId: mid8 value: templateId
    } else {
        mid8 = st.reg.newType name: mn8.stringView typetype: (templateTypetypeOf :st :templateId)
    }
    if trieOk8 when mid8 > 0 then {
        (registerSpecOnTrie
            :st
            name: mn8.stringView
            :templateId
            :mid8
            :keys8
            :keyIsVal8
        )
    }
    # The children are built LAST, and the trie path above is why. Building
    # them respecializes, which re-enters this function for this very
    # instantiation; before the edge existed that re-entry found nothing and
    # minted a SECOND spec under the same name, which the emitter then emitted
    # beside the first.
    if (hasParamKey8) == false then mid8 = (mintSpecUnderTemplate
        :ast
        :st
        :unitDecl
        :frame
        name: mn8.stringView
        :templateId
        :mid8
        :subs
        :idSubs8
        :fallbackArg
    )
    okC3: trieOk8
    if hasParamKey8 then okC3 = false
    if mid8.isZero then okC3 = false
    if okC3 then {
        (completeSpecChildren
            :ast
            :st
            :frame
            :templateId
            :mid8
            :keys8
            :keyIsVal8
        )
    }
    st.reg.specWasFresh = true
    return (ztypes.tid.create from: mid8)
}
# mintCollectionChildren -- the per-instance collection children the
# produced templates cannot express: length/capacity u64 value children,
# the create child (except List and Map, which have their own create
# paths), the Map get/remove value-kind wrapper returns, MapEntry's
# key/value accessors, and the sized str/array member tables. Method
# signatures and composite returns come from the cloned template methods
# (healed by respecialize). No-op for other templates or when the
# instance already has children (re-mint dedup).
# monoValName -- the value-type name component of a get-wrapper mono name. A type
# SHADOWING a builtin -- its name resolves through the prelude to a DIFFERENT
# canonical id -- appends its own id, so its wrapper mono is distinct from the
# builtin's same-named wrapper (a user i64 -> "i64_7" vs system "i64"); otherwise
# the bare name. Without this the get-wrapper mono name (optionval_i64) collides
# under the shared system key and the shadow reuses the system instance (wrong
# `some`-arm type). Asked of the ids, from any unit: whoever defines it.
monoValName: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    tid: ztypes.tid
} out String is {
    tn: st.reg.nameOf :tid
    bt: builtinTidT :st :frame :ast base: tn.stringView
    if bt > 0 when (bt == tid) == false then return ("\{tn}_\{tid}")
    return tn
}
# mintEntryAndSizedChildren -- the members that depend on the instance's ARGUMENTS
# rather than on the template's own methods: a map entry's key/value pair, and the
# value-dependent members of the sized `str` and `array` records, which are
# REPLACED in place (setMemberType keeps positions).
mintEntryAndSizedChildren: function {
    ast: Ast
    st: zenv.ZSymbolTable
    rf: ztypes.declid
    monoId: ztypes.tid
    templateId: ztypes.tid
    elemArg: u64
    valArg: ztypes.tid
    u64id: u64
} is {
    mapEntryTid: builtinTidT :st frame: rf :ast base: "MapEntry"
    mapEntryRVTid: builtinTidT :st frame: rf :ast base: "MapEntryRV"
    mapEntryVRTid: builtinTidT :st frame: rf :ast base: "MapEntryVR"
    mapEntryVVTid: builtinTidT :st frame: rf :ast base: "MapEntryVV"
    idMapEntryRTid: builtinTidT :st frame: rf :ast base: "IdMapEntryR"
    idMapEntryVTid: builtinTidT :st frame: rf :ast base: "IdMapEntryV"
    strTid: builtinTidT :st frame: rf :ast base: "str"
    arrayTid: builtinTidT :st frame: rf :ast base: "array"
    boolid: u64
    boolT: builtinTidT :st frame: rf :ast base: "bool"
    bo: (optionval.none u64)
    if (boolT.isZero) == false then bo = (optionval.some boolT.u64)
    match (
        bo
    ) case some then {
        boolid = bo
    } case none then null
    isEntryTpl: false
    if templateId == mapEntryTid then isEntryTpl = true
    if templateId == mapEntryRVTid then isEntryTpl = true
    if templateId == mapEntryVRTid then isEntryTpl = true
    if templateId == mapEntryVVTid then isEntryTpl = true
    if templateId == idMapEntryRTid then isEntryTpl = true
    if templateId == idMapEntryVTid then isEntryTpl = true
    if isEntryTpl then {
        kyId: mintCollectionMethod :st :ast :monoId m: "key"
        st.reg.setReturnType typeId: (ztypes.tid.create from: kyId.u64) value: elemArg
        vlId: mintCollectionMethod :st :ast :monoId m: "value"
        if valArg > 0 then (st.reg.setReturnType
            typeId: (ztypes.tid.create from: vlId.u64)
            value: valArg
        )
        mintCollectionMethod :st :ast :monoId m: "create"
    }
    if templateId == arrayTid then {
        agId: mintCollectionMethod :st :ast :monoId m: "get"
        st.reg.setReturnType typeId: (ztypes.tid.create from: agId.u64) value: elemArg
        asId: mintCollectionMethod :st :ast :monoId m: "set"
        st.reg.setReturnType typeId: (ztypes.tid.create from: asId.u64) value: elemArg
        st.typing.setMemberType parentTypeId: monoId nameId: zast.names.wkLength childTypeId: u64id
        mintCollectionMethod :st :ast :monoId m: "create"
        aeqId: mintCollectionMethod :st :ast :monoId m: "=="
        st.reg.setReturnType typeId: (ztypes.tid.create from: aeqId.u64) value: boolid
        aneId: mintCollectionMethod :st :ast :monoId m: "!="
        st.reg.setReturnType typeId: (ztypes.tid.create from: aneId.u64) value: boolid
    }
    if templateId == strTid then {
        st.typing.setMemberType parentTypeId: monoId nameId: zast.names.wkLength childTypeId: u64id
        st.typing.setMemberType parentTypeId: monoId nameId: zast.names.wkSize childTypeId: u64id
        tstId: mintCollectionMethod :st :ast :monoId m: "string"
        sgid: (builtinTidT :st frame: rf :ast base: "String").u64
        if sgid > 0 then (st.reg.setReturnType
            typeId: (ztypes.tid.create from: tstId.u64)
            value: sgid
        )
        mintCollectionMethod :st :ast :monoId m: "create"
        teqId: mintCollectionMethod :st :ast :monoId m: "=="
        st.reg.setReturnType typeId: (ztypes.tid.create from: teqId.u64) value: boolid
        tneId: mintCollectionMethod :st :ast :monoId m: "!="
        st.reg.setReturnType typeId: (ztypes.tid.create from: tneId.u64) value: boolid
    }
}
# templateIsCollection -- whether a template is one of the builtin collection
# families, and (through iterOut) whether it is one of the ITERATOR families.
# Comparing tids rather than names is what makes this shadow-proof: a user type
# spelled `ListRef` is not this ListRef.
templateIsCollection: function {
    ast: Ast
    st: zenv.ZSymbolTable
    rf: ztypes.declid
    templateId: ztypes.tid
    iterOut: (ListVal bool)
} out bool is {
    listTid: builtinTidT :st frame: rf :ast base: "ListRef"
    listValTid: builtinTidT :st frame: rf :ast base: "ListVal"
    listViewTid: builtinTidT :st frame: rf :ast base: "ListView"
    listViewValTid: builtinTidT :st frame: rf :ast base: "ListViewVal"
    setTid: builtinTidT :st frame: rf :ast base: "SetRef"
    setValTid: builtinTidT :st frame: rf :ast base: "SetVal"
    mapTid: builtinTidT :st frame: rf :ast base: "MapRR"
    mapRVTid: builtinTidT :st frame: rf :ast base: "MapRV"
    mapVRTid: builtinTidT :st frame: rf :ast base: "MapVR"
    mapVVTid: builtinTidT :st frame: rf :ast base: "MapVV"
    idMapRTid: builtinTidT :st frame: rf :ast base: "IdMapR"
    idMapVTid: builtinTidT :st frame: rf :ast base: "IdMapV"
    idSetTid: builtinTidT :st frame: rf :ast base: "IdSet"
    mapEntryTid: builtinTidT :st frame: rf :ast base: "MapEntry"
    strTid: builtinTidT :st frame: rf :ast base: "str"
    arrayTid: builtinTidT :st frame: rf :ast base: "array"
    listIterTid: builtinTidT :st frame: rf :ast base: "ListIter"
    listIterValTid: builtinTidT :st frame: rf :ast base: "ListIterVal"
    setIterTid: builtinTidT :st frame: rf :ast base: "SetIter"
    setIterValTid: builtinTidT :st frame: rf :ast base: "SetIterVal"
    idSetIterTid: builtinTidT :st frame: rf :ast base: "IdSetIter"
    idMapItemIterRTid: builtinTidT :st frame: rf :ast base: "IdMapItemIterR"
    idMapItemIterVTid: builtinTidT :st frame: rf :ast base: "IdMapItemIterV"
    idMapEntryRTid: builtinTidT :st frame: rf :ast base: "IdMapEntryR"
    idMapEntryVTid: builtinTidT :st frame: rf :ast base: "IdMapEntryV"
    mapKeyIterTid: builtinTidT :st frame: rf :ast base: "MapKeyIter"
    mapItemIterTid: builtinTidT :st frame: rf :ast base: "MapItemIter"
    mapKeyIterRVTid: builtinTidT :st frame: rf :ast base: "MapKeyIterRV"
    mapKeyIterVRTid: builtinTidT :st frame: rf :ast base: "MapKeyIterVR"
    mapKeyIterVVTid: builtinTidT :st frame: rf :ast base: "MapKeyIterVV"
    mapItemIterRVTid: builtinTidT :st frame: rf :ast base: "MapItemIterRV"
    mapItemIterVRTid: builtinTidT :st frame: rf :ast base: "MapItemIterVR"
    mapItemIterVVTid: builtinTidT :st frame: rf :ast base: "MapItemIterVV"
    mapEntryRVTid: builtinTidT :st frame: rf :ast base: "MapEntryRV"
    mapEntryVRTid: builtinTidT :st frame: rf :ast base: "MapEntryVR"
    mapEntryVVTid: builtinTidT :st frame: rf :ast base: "MapEntryVV"
    isIter: false
    if templateId == listIterTid then isIter = true
    if templateId == listIterValTid then isIter = true
    if templateId == setIterTid then isIter = true
    if templateId == setIterValTid then isIter = true
    if templateId == idSetIterTid then isIter = true
    if templateId == idMapItemIterRTid then isIter = true
    if templateId == idMapItemIterVTid then isIter = true
    if templateId == mapKeyIterTid then isIter = true
    if templateId == mapItemIterTid then isIter = true
    if templateId == mapKeyIterRVTid then isIter = true
    if templateId == mapKeyIterVRTid then isIter = true
    if templateId == mapKeyIterVVTid then isIter = true
    if templateId == mapItemIterRVTid then isIter = true
    if templateId == mapItemIterVRTid then isIter = true
    if templateId == mapItemIterVVTid then isIter = true
    isColl: isIter
    if templateId == listTid then isColl = true
    if templateId == listValTid then isColl = true
    if templateId == listViewTid then isColl = true
    if templateId == listViewValTid then isColl = true
    if templateId == setTid then isColl = true
    if templateId == setValTid then isColl = true
    if templateId == mapTid then isColl = true
    if templateId == mapRVTid then isColl = true
    if templateId == mapVRTid then isColl = true
    if templateId == mapVVTid then isColl = true
    if templateId == idMapRTid then isColl = true
    if templateId == idMapVTid then isColl = true
    if templateId == idSetTid then isColl = true
    if templateId == idMapEntryRTid then isColl = true
    if templateId == idMapEntryVTid then isColl = true
    if templateId == mapEntryTid then isColl = true
    if templateId == mapEntryRVTid then isColl = true
    if templateId == mapEntryVRTid then isColl = true
    if templateId == mapEntryVVTid then isColl = true
    if templateId == strTid then isColl = true
    if templateId == arrayTid then isColl = true
    iterOut.append isIter
    return isColl
}
# mintCollectionCounters -- the members a collection instance needs that its
# template's own methods do not supply: the length/capacity counters (the
# canonical u64) and the `create` child. Every other member is produced and
# cloned from the template, its composite returns healed by respecialize.
# mintCounterFields -- stamp a collection mono's `length`, and for the forms
# that have one its `capacity`, with the canonical u64. Every collection family
# below wants the same pair, so the pair is written once.
mintCounterFields: function {
    st: zenv.ZSymbolTable
    monoId: ztypes.tid
    u64id: u64
    withCapacity: bool
} is {
    (st.typing.setMemberType
        parentTypeId: monoId
        nameId: zast.names.wkLength
        childTypeId: u64id
    )
    if withCapacity then {
        (st.typing.setMemberType
            parentTypeId: monoId
            nameId: zast.names.wkCapacity
            childTypeId: u64id
        )
    }
}

mintCollectionCounters: function {
    ast: Ast
    st: zenv.ZSymbolTable
    rf: ztypes.declid
    monoId: ztypes.tid
    templateId: ztypes.tid
    valArg: ztypes.tid
    u64id: u64
    isIter: bool
} is {
    listViewTid: builtinTidT :st frame: rf :ast base: "ListView"
    listViewValTid: builtinTidT :st frame: rf :ast base: "ListViewVal"
    setTid: builtinTidT :st frame: rf :ast base: "SetRef"
    setValTid: builtinTidT :st frame: rf :ast base: "SetVal"
    mapTid: builtinTidT :st frame: rf :ast base: "MapRR"
    mapRVTid: builtinTidT :st frame: rf :ast base: "MapRV"
    mapVRTid: builtinTidT :st frame: rf :ast base: "MapVR"
    mapVVTid: builtinTidT :st frame: rf :ast base: "MapVV"
    idMapRTid: builtinTidT :st frame: rf :ast base: "IdMapR"
    idMapVTid: builtinTidT :st frame: rf :ast base: "IdMapV"
    idSetTid: builtinTidT :st frame: rf :ast base: "IdSet"
    # ListView children come from the produced template method (get); the
    # length field (the canonical u64) and the create child materialize here,
    # once per mono (post-memo: this arm mints).
    isLViewTpl: false
    if templateId == listViewTid then isLViewTpl = true
    if templateId == listViewValTid then isLViewTpl = true
    if isLViewTpl then {
        mintCounterFields :st :monoId :u64id withCapacity: false
        mintCollectionMethod :st :ast :monoId m: "create"
        return
    }
    # Set children come from the produced template methods (returns healed
    # by respecialize); the length/capacity fields (the canonical u64) and
    # the create child materialize here, once per mono.
    isSetTpl: false
    if templateId == setTid then isSetTpl = true
    if templateId == setValTid then isSetTpl = true
    if isSetTpl then {
        mintCounterFields :st :monoId :u64id withCapacity: true
        mintCollectionMethod :st :ast :monoId m: "create"
        return
    }
    # Iterator families: call is produced+cloned (its OptionView return
    # healed by respecialize); only the create child mints here, once per
    # mono.
    if isIter then {
        mintCollectionMethod :st :ast :monoId m: "create"
        return
    }
    # Every Map form declares its real returns -- an `optionval` for a valtype
    # value, an `OptionView`/`Option` for a reference one -- so the clone pass
    # heals get/remove like any other composite return and only the
    # length/capacity fields materialize here.
    isMapTpl: false
    if templateId == mapTid then isMapTpl = true
    if templateId == mapRVTid then isMapTpl = true
    if templateId == mapVRTid then isMapTpl = true
    if templateId == mapVVTid then isMapTpl = true
    if isMapTpl when valArg > 0 then {
        mintCounterFields :st :monoId :u64id withCapacity: true
        return
    }
    # the id-keyed pair, for the same reason the Map forms are here: their
    # real returns are declared and the clone pass heals them, so only the
    # length/capacity counters need their canonical u64 stamped on the mono.
    # IdSet has no value parameter, so it is tested on its own.
    isIdMapTpl: false
    if templateId == idMapRTid then isIdMapTpl = true
    if templateId == idMapVTid then isIdMapTpl = true
    if isIdMapTpl when valArg > 0 then {
        mintCounterFields :st :monoId :u64id withCapacity: true
        return
    }
    if templateId == idSetTid then {
        mintCounterFields :st :monoId :u64id withCapacity: true
        return
    }
}


# mint the per-instantiation member edges of a collection type.
mintCollectionChildren: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    monoId: ztypes.tid
    templateId: ztypes.tid
    elemArg: u64
    valArg: ztypes.tid
} is {
    # a specialisation's members resolve in the TEMPLATE's frame, with the
    # argument substitution -- lexical scoping; the instantiating unit is
    # not where the template's names live
    rf: frame
    {
        td: declOfTypeId :st tid: templateId
        if (td.isZero) == false then rf = td
    }
    iterOut: (ListVal bool)
    isColl: templateIsCollection :ast :st :rf :templateId :iterOut
    isIter: iterOut.get i: 0
    if (isColl) == false then return
    listTid: builtinTidT :st frame: rf :ast base: "ListRef"
    listValTid: builtinTidT :st frame: rf :ast base: "ListVal"
    strTid: builtinTidT :st frame: rf :ast base: "str"
    arrayTid: builtinTidT :st frame: rf :ast base: "array"
    # List children come from the produced template methods cloned per
    # instance (composite returns healed by respecialize); only the
    # length/capacity u64 children materialize here. Runs on every naming.
    isListTpl: false
    if templateId == listTid then isListTpl = true
    if templateId == listValTid then isListTpl = true
    if isListTpl then {
        # system's u64, whichever unit instantiates the collection: a user
        # unit may shadow the name
        u64L: (builtinTidT :st frame: rf :ast base: "u64").u64
        if u64L > 0 then {
            (st.typing.setMemberType
                parentTypeId: monoId
                nameId: zast.names.wkLength
                childTypeId: u64L
            )
            (st.typing.setMemberType
                parentTypeId: monoId
                nameId: zast.names.wkCapacity
                childTypeId: u64L
            )
        }
        return
    }
    # One build per instance: a spec can reach this arm from several mint
    # paths, and the str/array rebuild below would mint fresh member types
    # per invocation (their instances copy template children at mint time,
    # so a member count cannot signal "already built").
    if (st.typing.collectionChildrenBuilt.has item: monoId) then return
    bk0: monoId
    st.typing.collectionChildrenBuilt.add item: bk0
    u64id: (declareCanonicalType
        :st
        frame: rf
        :ast

        unitDecl: st.typing.systemUnitRoot
        ownerNameId: zast.nameid
        name: "u64"
        typetype: ztypes.ztypetype.recordType
    )
    (mintCollectionCounters
        :ast
        :st
        :rf
        :monoId
        :templateId
        :valArg
        :u64id
        :isIter
    )
    isSized: false
    if templateId == strTid then isSized = true
    if templateId == arrayTid then isSized = true
    # str/array are PERMANENT materializer arms: sized RECORDs are keyed by
    # a numeric value parameter that rides the trie as a literal VALUE key
    # (genericArgIsValue marks the ordinal); it never enters idSubs, so
    # produce+clone has nothing to substitute. Their templates resolve from source (record
    # attachMethods runs regardless of genericity) and copy their children
    # at mint time; the branches below REPLACE the value-dependent members
    # in place (setMemberType keeps positions) -- fresh const-clone size fields,
    # element-typed get/set returns, String-returning string, and the ==/!=
    # that resolveRecord and mintMono both skip for sized records. The
    # emitter builds the structs from the z_str/z_array tmpls by name-parsed
    # size and reads only the == child's presence. The dedup guard below
    # applies only to the from-scratch families.
    if (isSized) == false then {
        if (st.typing.declMemberCount ownerTid: monoId) > 0 then return
    }
    (mintEntryAndSizedChildren
        :ast
        :st
        :rf
        :monoId
        :templateId
        :elemArg
        :valArg
        :u64id
    )
}


# firstGenericParamId -- the primary (first-declared) generic parameter name
# of a template as a pool id, 0 when it has none. Binds an elided leading type
# argument (`(List String)` == `(List of: String)`) to its parameter.
firstGenericParamId: function {
    st: zenv.ZSymbolTable.view
    templateId: ztypes.tid
} out zast.nameid is {
    tk: declOfTypeId :st tid: templateId
    names: st.reg.genericParamNamesOf tdecl: tk
    if names.length > 0 then return (names.get i: 0)
    return zast.nameid
}
# inferConstructionSubs -- infer a generic construction's type arguments from the
# values it is given. The value-arg walk is a DRY RUN: its ownership effects (take
# overlays, borrow locks) are bracketed in a frame discarded whole, so the real
# ctor walk re-checks from a clean slate -- an explicit `.take` argument otherwise
# collides with its own inference pass.
inferConstructionSubs: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    primaryName: zast.nameid
    fNames: (ListVal zast.nameid).view
    fParams: (ListVal zast.nameid).view
    sfx: String
    subs: (IdMapV zast.nameid v: u64)
    boundParams: (IdSet zast.nameid)
    tk: ztypes.declid
} is {
    argIdx: u64
    # the value-arg walk below is a DRY RUN for type inference: bracket its
    # ownership effects (take overlays, borrow locks) in a frame that is
    # discarded whole, so the real ctor walk re-checks from a clean slate --
    # an explicit `.take` arg otherwise collides with its own inference pass.
    st.pushDryRun
    kAiter: u64
    for kAiter < call.nargs loop {
        argId: (zast.callArgAt :ast nid: call.nid i: kAiter).u32
        kAiter = kAiter + 1
        # the argument is read through a view scoped to this block: the
        # lookups and the value walk below lend ast exclusively
        isNamedArg: false
        pk: zast.nameid
        opId: zast.nodeid
        {
            arg: argRefAt :ast nid: (zast.nodeid.create from: argId.u32)
            if (arg.nid.isZero) == false then {
                isNamedArg = true
                pk = arg.name
                opId = arg.operation
            }
        }
        if isNamedArg then {
            # elided leading type arg: an unnamed first arg naming a type
            # binds the primary generic param (`(List String)`); a value
            # first arg (`(box 5)`) is left for value inference.
            if pk.isZero when argIdx == 0 then {
                anE: paramTypeBaseName :ast op: (ast.nodes.get i: opId.u64)
                if (isNumericLiteralName name: anE.stringView) == false then {
                    teo: (walkLookupTyperef
                        :st
                        frame: st.curFrame
                        :ast

                        :unitDecl
                        base: anE.stringView
                    )
                    match (
                        teo
                    ) case some then {
                        if (primaryName.isZero) == false then pk = primaryName
                    } case none then null
                }
            }
            isP: false
            if (pk.isZero) == false then {
                isP = st.reg.isGenericParamOf tdecl: tk name: pk
            }
            if isP then {
                an: paramTypeBaseName :ast op: (ast.nodes.get i: opId.u64)
                if (isNumericLiteralName name: an.stringView) then {
                    sfx.append s: "_"
                    sfx.append s: an
                    boundParams.add item: pk
                } else {
                    ao: (walkLookupTyperef
                        :st
                        frame: st.curFrame
                        :ast

                        :unitDecl
                        base: an.stringView
                    )
                    match (
                        ao
                    ) case some then {
                        atn: (monoValName
                            :st
                            frame: st.curFrame
                            :ast

                            tid: (ztypes.tid.create from: ao.u64)
                        )
                        sfx.append s: "_"
                        sfx.append s: atn
                        pv2: ao
                        subs.set key: pk value: pv2
                        boundParams.add item: pk
                    } case none then null
                }
            } else {
                vt0: checkValueAt :st :unitDecl :ast nid: opId
                gidx: u64
                gfound: false
                fi: u64
                fn2: fNames.length
                for fi < fn2 loop {
                    if (fNames.get i: fi) == pk then {
                        if (gfound) == false then {
                            gidx = fi
                            gfound = true
                        }
                    }
                    fi = fi + 1
                }
                if gfound when vt0 > 0 then {
                    mv0: materialiseLiteral :ast :st :unitDecl t: vt0
                    if mv0 != vt0 then {
                        iid0: innermostNodeId :ast n: (ast.nodes.get i: opId.u64)
                        if iid0 > 0 then {
                            setm0: mv0
                            stampGate :st nid: iid0.u64 tid: setm0
                        }
                    }
                    gp0: fParams.get i: gidx
                    already: optU64Or o: (subs.get key: gp0) d: 0
                    if already <= 0 then {
                        vtn: monoValName :st frame: st.curFrame :ast tid: mv0
                        sfx.append s: "_"
                        sfx.append s: vtn
                        gpv: mv0
                        subs.set key: gp0 value: gpv
                        boundParams.add item: gp0
                    }
                }
            }
        }
        argIdx = argIdx + 1
    }
}


# inferGenericConstruction -- a generic class/record template called with
# field-bound value arguments: labels naming generic params resolve as
# explicit type args; other args walk as values and bind their field's
# param (literals materialise + restamp the bare node). The deduped
# instance mints with substituted fields plus a synthesized create.
# 0 when nothing infers.
inferGenericConstruction: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    tplId: ztypes.tid
    reportMissing: bool
} out ztypes.tid is {
    tname: st.reg.nameOf tid: tplId
    if tname.length == 0 then return (ztypes.tid.create from: 0)
    tk: declOfTypeId :st tid: tplId
    # Stage the template's children, then keep the ones whose TYPE NAME is a
    # registered generic param (field shells carry the param name, not a
    # GENERIC_PARAM typetype).
    childNames: (ListVal zast.nameid)
    cIds3: (ListVal u64)
    {
        igNms: (ListVal u64)
        igTds: (ListVal u64)
        st.typing.declMemberList ownerTid: tplId names: igNms tids: igTds
        igi: u64
        ign: igNms.length
        for igi < ign loop {
            childNames.append (zast.nameid.create from: ((igNms.get i: igi)).u32.orPanic)
            cid1: igTds.get i: igi
            cIds3.append cid1
            igi = igi + 1
        }
    }
    fNames: (ListVal zast.nameid)
    fParams: (ListVal zast.nameid)
    ci3: u64
    cn3: cIds3.length
    for ci3 < cn3 loop {
        cid3: cIds3.get i: ci3
        pnm3: st.reg.nameOf tid: (ztypes.tid.create from: cid3.u64)
        pid3: nameIdOf :ast name: pnm3.stringView
        if (st.reg.isGenericParamOf tdecl: tk name: pid3) then {
            fNames.append (childNames.get i: ci3)
            fParams.append pid3
        }
        ci3 = ci3 + 1
    }
    sfx: String
    subs: (IdMapV zast.nameid v: u64)
    boundParams: (IdSet zast.nameid)
    primaryName: firstGenericParamId :st templateId: (ztypes.tid.create from: tplId.u64)
    (inferConstructionSubs
        :st
        :unitDecl
        :ast
        :call
        :primaryName
        :fNames
        :fParams
        :sfx
        :subs
        :boundParams
        :tk
    )
    st.popDiscard
    paramsM: st.reg.genericParamNamesOf tdecl: tk
    firstMissing: zast.nameid
    pmi: u64
    pmn: paramsM.length
    for pmi < pmn loop {
        pmName: paramsM.get i: pmi
        if (boundParams.has item: pmName) == false then {
            if firstMissing.isZero then firstMissing = pmName
        }
        pmi = pmi + 1
    }
    if (firstMissing.isZero) == false then {
        if reportMissing then {
            emn: String
            ehn: String
            if sfx.length == 0 then {
                mmsg: "cannot infer type arguments for generic type '\{tname}'"
                (addErrorH
                    :st
                    nodeid: call.nid
                    lineno: call.lineno
                    colno: call.colno
                    e: zast.err.genericError
                    msg: mmsg
                    note: emn
                    hint: ehn
                    width: 0
                )
            } else {
                fmT: zast.nameTextAt :ast ref: firstMissing
                mmsg2: "cannot infer generic parameter '\{fmT}' for '\{tname}'"
                (addErrorH
                    :st
                    nodeid: call.nid
                    lineno: call.lineno
                    colno: call.colno
                    e: zast.err.genericError
                    msg: mmsg2
                    note: emn
                    hint: ehn
                    width: 0
                )
            }
        }
        return (ztypes.tid.create from: 0)
    }
    if sfx.length == 0 then return (ztypes.tid.create from: 0)
    vsD: (IdMapV zast.nameid v: u64)
    mid: (getOrMintSpec
        :st
        frame: st.curFrame
        :ast

        :unitDecl
        sfx: sfx.stringView
        templateId: (ztypes.tid.create from: tplId.u64)
        :subs
        valSubs: vsD
        fallbackArg: 0
    )
    if mid.isZero then return (ztypes.tid.create from: 0)
    (forceMemberOf :st frame: st.curFrame :ast parentTypeId: mid nameId: zast.names.wkCreate)
    cro: st.typing.declChildOfId parentTypeId: mid nameId: zast.names.wkCreate
    match (
        cro
    ) case some then null case none then {
        crId: st.reg.newType name: "create" ownerTid: mid typetype: ztypes.ztypetype.functionType
        (st.typing.declSynthMember
            parentTypeId: mid
            nameId: zast.names.wkCreate
            kind: ztyping.declkind.methodDecl
        )
        st.typing.setMemberType parentTypeId: mid nameId: zast.names.wkCreate childTypeId: crId
    }
    stampConstructionKind :st nid: call.nid.u64 tid: mid
    return mid
}
# skipCapacityArg -- `capacity:` on a builtin container is a create argument riding
# the construction sugar: it must not reach the spec key or the substitutions, and
# failing it over to field inference would type the whole call wrong. A skipped
# argument is still a VALUE, so it is walked here for its atoms' stamps.
skipCapacityArg: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    argOpId: zast.nodeid
    tplId: ztypes.tid
    pk0: zast.nameid
    isP0: bool
} out bool is {
    skipCr: false
    if (isP0) == false when pk0 == zast.names.wkCapacity then {
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "ListRef"
        ) then skipCr = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "ListVal"
        ) then skipCr = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "MapRR"
        ) then skipCr = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "MapRV"
        ) then skipCr = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "MapVR"
        ) then skipCr = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "MapVV"
        ) then skipCr = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "SetRef"
        ) then skipCr = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "SetVal"
        ) then skipCr = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "IdMapR"
        ) then skipCr = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "IdMapV"
        ) then skipCr = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "IdSet"
        ) then skipCr = true
    }
    # a skipped capacity: arg is still a value: check it so its
    # atoms stamp (atomVariableId / refDecl) like any arg
    if skipCr then {
        checkValueAt :st :unitDecl :ast nid: argOpId
    }
    return skipCr
}


# collectGenericTypeArgs -- read one generic construction's arguments into the type
# and value substitutions, building the mangled suffix that names the instance.
collectGenericTypeArgs: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    call: callref
    tplId: ztypes.tid
    primaryName: zast.nameid
    sfx: String
    subs: (IdMapV zast.nameid v: u64)
    valueSubs: (IdMapV zast.nameid v: u64)
    numParamNames: (ListVal zast.nameid)
    numParamNodes: (ListVal u32)
    tk0: ztypes.declid
    firstOut: (ListVal u64)
} out bool is {
    firstA: u64
    anyMiss: false
    argIdx: u64
    kAiter: u64
    for kAiter < call.nargs loop {
        argId: (zast.callArgAt :ast nid: call.nid i: kAiter).u32
        kAiter = kAiter + 1
        # the argument is read through a view scoped to this block: the
        # lookups below lend ast
        isNamedArg: false
        pk0: zast.nameid
        opId: zast.nodeid
        {
            arg: ast.nodes.get i: argId.u64
            match (
                arg
            ) case namedoperation then {
                isNamedArg = true
                pk0 = arg.name
                opId = arg.operation
            } else null
        }
        if isNamedArg then {
            # only generic-param labels construct here; a value arg means
            # the field-bound inference leg owns the call.
            # An elided leading type argument (`(List zvfs.ProviderBox)`) binds
            # the primary generic param: probe the unnamed first arg as a type
            # (atom via walkLookupTyperef, cross-unit dotted via dottedTyperefId).
            # Only a real type rebinds; a value first arg (`(box 5)`) keeps its
            # empty label so the field-bound inference leg owns the call.
            if pk0.isZero when argIdx == 0 then {
                if (primaryName.isZero) == false then {
                    anP: paramTypeBaseName :ast op: (ast.nodes.get i: opId.u64)
                    pid0: u64
                    if (isNumericLiteralName name: anP.stringView) == false then {
                        pao0: (walkLookupTyperef
                            :st
                            frame: st.curFrame
                            :ast

                            :unitDecl
                            base: anP.stringView
                        )
                        pid0 = optU64Or o: pao0 d: 0
                        if pid0 == 0 then {
                            dop: ast.nodes.get i: opId.u64
                            pid0 = dottedTyperefId :ast :st op: dop
                        }
                    }
                    if pid0 > 0 then pk0 = primaryName
                }
            }
            isP0: false
            if (pk0.isZero) == false then {
                isP0 = st.reg.isGenericParamOf tdecl: tk0 name: pk0
            }
            skipCr: (skipCapacityArg
                :ast
                :st
                :unitDecl
                argOpId: opId
                :tplId
                :pk0
                :isP0
            )
            if (isP0) == false when skipCr == false then anyMiss = true
            an: paramTypeBaseName :ast op: (ast.nodes.get i: opId.u64)
            if (anyMiss) == false when skipCr == false then { if (isNumericLiteralName name: an.stringView) then {
                asfx2: "_\{an}"
                sfx.append s: asfx2
                if (pk0.isZero) == false then {
                    numParamNames.append pk0
                    numParamNodes.append opId
                    pdv0: parseDecimalU64 text: an.stringView
                    match (
                        pdv0
                    ) case some then {
                        vgv0: pdv0
                        valueSubs.set key: pk0 value: vgv0
                    } case none then null
                }
            } else {
                ao: (walkLookupTyperef
                    :st
                    frame: st.curFrame
                    :ast

                    :unitDecl
                    base: an.stringView
                )
                aid: optU64Or o: ao d: 0
                if aid == 0 then {
                    argOpNode: ast.nodes.get i: opId.u64
                    aid = dottedTyperefId :ast :st op: argOpNode
                }
                if aid > 0 then {
                    atn: (monoValName
                        :st
                        frame: st.curFrame
                        :ast

                        tid: (ztypes.tid.create from: aid.u64)
                    )
                    asfx: "_\{atn}"
                    sfx.append s: asfx
                    if (pk0.isZero) == false then {
                        pv: aid
                        subs.set key: pk0 value: pv
                    }
                    if firstA == 0 then firstA = aid
                } else {
                    anyMiss = true
                }
            } }
        }
        argIdx = argIdx + 1
    }
    firstOut.append firstA
    return anyMiss
}


# genericTypeConstruction -- a generic TYPE template in callable position
# with type-name arguments constructs its mono in place (`(List of: String)`
# in value position): resolve each argument as a type, mint the deduped mono
# with its chains and children, and the call's
# value is the mono.
genericTypeConstruction: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    call: callref
    tplId: ztypes.tid
} out ztypes.tid is {
    tname: st.reg.nameOf tid: tplId
    if tname.length == 0 then return (ztypes.tid.create from: 0)
    tk0: declOfTypeId :st tid: tplId
    sfx: String
    subs: (IdMapV zast.nameid v: u64)
    valueSubs: (IdMapV zast.nameid v: u64)
    numParamNames: (ListVal zast.nameid)
    numParamNodes: (ListVal u32)
    primaryName: firstGenericParamId :st templateId: (ztypes.tid.create from: tplId.u64)
    firstOut: (ListVal u64)
    anyMiss: (collectGenericTypeArgs
        :ast
        :st
        :unitDecl
        :call
        :tplId
        :primaryName
        :sfx
        :subs
        :valueSubs
        :numParamNames
        :numParamNodes
        :tk0
        :firstOut
    )
    if anyMiss then return (ztypes.tid.create from: 0)
    firstA: firstOut.get i: 0
    if sfx.length == 0 then return (ztypes.tid.create from: 0)
    mid: (getOrMintSpec
        :st
        frame: st.curFrame
        :ast

        :unitDecl
        sfx: sfx.stringView
        templateId: (ztypes.tid.create from: tplId.u64)
        :subs
        valSubs: valueSubs
        fallbackArg: firstA
    )
    if mid.isZero then return (ztypes.tid.create from: 0)
    npi: u64
    npn: numParamNames.length
    for npi < npn loop {
        npName: zast.nameTextAt :ast ref: (numParamNames.get i: npi)
        npNode: numParamNodes.get i: npi
        (st.typing.setDefaultLiteral
            pool: ast.names
            parentTypeId: mid
            name: npName.stringView
            node: npNode
        )
        npi = npi + 1
    }
    isSized: false
    if tname.stringView == "str" then isSized = true
    if tname.stringView == "array" then isSized = true
    if isSized then {
        (mintCollectionChildren
            :st
            frame: st.curFrame
            :ast

            monoId: mid
            templateId: (ztypes.tid.create from: tplId.u64)
            elemArg: firstA
            valArg: ztypes.tid
        )
    }
    # Only a bare-atom callable restamps to the instance; a dotted callable
    # (the .str conversion form) leaves the path unstamped.
    gcb: zast.nameTextAt :ast ref: (bareAtomNameId :ast n: (ast.nodes.get i: call.callable.u64))
    gcal: nodeId n: (ast.nodes.get i: call.callable.u64)
    if gcal > 0 when gcb.length > 0 then {
        setga: mid
        stampGate :st nid: gcal.u64 tid: setga
    }
    setgt: mid
    stampGate :st nid: call.nid.u64 tid: setgt
    st.typing.callKind.set key: call.nid.u64 value: zast.callkind.classCreate
    return mid
}
# reportBadGenericArgLabel -- a label that names no generic parameter of this
# template. It may still be a legitimate FIELD label riding the construction
# sugar, or a builtin container's own create argument, so those are exempted
# before the error is raised.
reportBadGenericArgLabel: function {
    ast: Ast
    st: zenv.ZSymbolTable
    arg: argref
    tplId: ztypes.tid
    pk: zast.nameid
    childNames: (ListVal zast.nameid).view
    tname: StringView
    tk: ztypes.declid
} out bool is {
    ok: true
    isField: false
    ci: u64
    cn: childNames.length
    for ci < cn loop {
        if (childNames.get i: ci) == pk then isField = true
        ci = ci + 1
    }
    if (isField) == false when pk == zast.names.wkCapacity then {
        # `capacity:` on a builtin container construction is a
        # create argument (`Type arg:` is `Type.create arg:`);
        # native create params carry no modeled children, so
        # the label is admitted by template identity.
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "ListRef"
        ) then isField = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "ListVal"
        ) then isField = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "MapRR"
        ) then isField = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "MapRV"
        ) then isField = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "MapVR"
        ) then isField = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "MapVV"
        ) then isField = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "SetRef"
        ) then isField = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "SetVal"
        ) then isField = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "IdMapR"
        ) then isField = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "IdMapV"
        ) then isField = true
        if tplId == (builtinTidT
            :st
            frame: st.curFrame
            :ast

            base: "IdSet"
        ) then isField = true
    }
    if (isField) == false then {
        pkT2: zast.nameTextAt :ast ref: pk
        m2: "unknown type argument '\{pkT2}' for generic type '\{tname}'"
        plist: st.reg.genericParamNamesOf tdecl: tk
        note2: "valid type parameters: ".string
        pi: u64
        pn2: plist.length
        for pi < pn2 loop {
            if pi > 0 then note2.append s: ", "
            pnmT: zast.nameTextAt :ast ref: (plist.get i: pi)
            note2.append s: pnmT
            pi = pi + 1
        }
        eh2: String
        (addErrorH
            :st
            nodeid: arg.nid
            lineno: arg.lineno
            colno: arg.colno
            e: zast.err.genericError
            msg: m2
            note: note2
            hint: eh2
            width: pkT2.length.u32.orPanic
        )
        ok = false
    }
    return ok
}

# validateOneGenericArg -- one labelled generic argument: the label must name a
# parameter of this template, must not repeat, and its value must satisfy the
# parameter's declared constraint.
validateOneGenericArg: function {
    ast: Ast
    st: zenv.ZSymbolTable
    arg: argref
    tplId: ztypes.tid
    tk: ztypes.declid
    pk: zast.nameid
    seen: (IdSet zast.nameid)
    allowFrom: bool
    childNames: (ListVal zast.nameid).view
    tname: StringView
} out bool is {
    ok: true
    isP: st.reg.isGenericParamOf tdecl: tk name: pk
    if isP then {
        if (seen.has item: pk) when (allowFrom) == false then {
            pkT: zast.nameTextAt :ast ref: pk
            m1: "duplicate type argument '\{pkT}'"
            en1: String
            eh1: String
            (addErrorH
                :st
                nodeid: arg.nid
                lineno: arg.lineno
                colno: arg.colno
                e: zast.err.genericError
                msg: m1
                note: en1
                hint: eh1
                width: pkT.length.u32.orPanic
            )
            ok = false
        } else {
            seen.add item: pk
        }
    } else {
        ok = (reportBadGenericArgLabel
            :ast
            :st
            :arg
            :tplId
            :pk
            :childNames
            :tname
            :tk
        )
    }
    return ok
}


# validateGenericTypeArgs -- reject unknown / duplicate generic TYPE arguments
# at a settled construction site. A named arg matching neither a declared
# generic param nor a declared field (child) is an unknown type argument; a
# generic param supplied twice (e.g. an elided leading arg plus an explicit
# label) is a duplicate. Returns false when an error was emitted.
validateGenericTypeArgs: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    call: callref
    tplId: ztypes.tid
    allowFrom: bool
} out bool is {
    tname: st.reg.nameOf tid: tplId
    if tname.length == 0 then return true
    tk: declOfTypeId :st tid: tplId
    childNames: (ListVal zast.nameid)
    {
        vgN: (ListVal u64)
        vgT: (ListVal u64)
        st.typing.declChildRows ownerTid: tplId names: vgN tids: vgT
        vgi: u64
        vgn: vgN.length
        for vgi < vgn loop {
            vgnid: vgN.get i: vgi
            vgi = vgi + 1
            childNames.append (zast.nameid.create from: vgnid.u32.orPanic)
        }
    }
    primaryName: firstGenericParamId :st templateId: (ztypes.tid.create from: tplId.u64)
    fromId: nameIdOf :ast name: "from"
    seen: (IdSet zast.nameid)
    ok: true
    argIdx: u64
    kAiter: u64
    for kAiter < call.nargs loop {
        argId: (zast.callArgAt :ast nid: call.nid i: kAiter).u32
        kAiter = kAiter + 1
        arg: argRefAt :ast nid: (zast.nodeid.create from: argId.u32)
        if (arg.nid.isZero) == false then {
            pk: arg.name
            if pk.isZero when argIdx == 0 then {
                if (primaryName.isZero) == false then {
                    anP: paramTypeBaseName :ast op: (ast.nodes.get i: arg.operation.u64)
                    pid0: u64
                    if (isNumericLiteralName name: anP.stringView) == false then {
                        pao0: (walkLookupTyperef
                            :st
                            frame: st.curFrame
                            :ast

                            :unitDecl
                            base: anP.stringView
                        )
                        pid0 = optU64Or o: pao0 d: 0
                        if pid0 == 0 then {
                            dop: ast.nodes.get i: arg.operation.u64
                            pid0 = dottedTyperefId :ast :st op: dop
                        }
                    }
                    if pid0 > 0 then pk = primaryName
                }
            }
            skipFrom: false
            if allowFrom when pk == fromId then skipFrom = true
            if (pk.isZero) == false when (skipFrom) == false then {
                if (validateOneGenericArg
                    :ast
                    :st
                    :arg
                    :tplId
                    :tk
                    :pk
                    :seen
                    :allowFrom
                    :childNames
                    tname: tname.stringView
                ) == false then ok = false
            }
        }
        argIdx = argIdx + 1
    }
    return ok
}

# methodReturnOf -- a method FUNCTION type's return type id: the synthesized
# returnTypeId link when set, else the AST method's recorded `out T` ref node
# (funcReturnNode) read through the post-demand stamp.
methodReturnOf: function {st: zenv.ZSymbolTable.view mid: ztypes.tid} out optionval ztypes.tid is {
    rto: st.reg.returnTypeOf tid: mid
    if rto > 0 then return (optionval.some rto)
    rn: st.typing.funcReturnNode.get key: mid
    match (
        rn
    ) case some then {
        nt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: rn
        if nt > 0 then return (optionval.some (ztypes.tid.create from: nt))
    } case none then null
    return (optionval.none ztypes.tid)
}

# iterWrapperElem -- when a type is an Option / optionval / OptionView instance,
# its element (`some` child) type id.
iterWrapperElem: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    wid: ztypes.tid
} out optionval u64 is {
    origin: u64
    goo: st.reg.genericOriginOf tid: wid
    if goo > 0 then origin = goo
    if origin == 0 then return (optionval.none u64)
    isWrapper: false
    oo: walkLookupTyperef :st frame: st.curFrame :ast :unitDecl base: "Option"
    match (
        oo
    ) case some then {
        if origin == oo then isWrapper = true
    } case none then null
    vo: walkLookupTyperef :st frame: st.curFrame :ast :unitDecl base: "optionval"
    match (
        vo
    ) case some then {
        if origin == vo then isWrapper = true
    } case none then null
    wo: walkLookupTyperef :st frame: st.curFrame :ast :unitDecl base: "OptionView"
    match (
        wo
    ) case some then {
        if origin == wo then isWrapper = true
    } case none then null
    (forceMemberOf :st frame: st.curFrame :ast parentTypeId: wid nameId: zast.names.wkSome)
    if isWrapper then return (st.typing.declChildOfId parentTypeId: wid nameId: zast.names.wkSome)
    return (optionval.none u64)
}

# isOptionViewMono -- true when a type is an OptionView instance (its per-
# iteration values are borrowed views, so the loop var binds BORROWED).
isOptionViewMono: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    wid: ztypes.tid
} out bool is {
    origin: u64
    goo: st.reg.genericOriginOf tid: wid
    if goo > 0 then origin = goo
    if origin == 0 then return false
    wo: walkLookupTyperef :st frame: st.curFrame :ast :unitDecl base: "OptionView"
    match (
        wo
    ) case some then {
        return origin == wo
    } case none then {
        return false
    }
}

# methodHasNoUserArgs -- true when a method type has no user-visible parameters
# beyond the implicit receiver: no children at all (synthesized collection
# methods), or a single child that IS the receiver -- `this`, or the long-form
# receiver recorded in thisParamName (`stringView: function {t: this.lock}`).

# optU64Or / optBoolOr -- the option's payload, or the given default. Collapse
# the some/none match at get-or-default sites (match narrowing needs a
# bare-name subject, so inline gets can't match directly).
optVidOr: function {o: optionval ztypes.vid} out ztypes.vid is {
    match (
        o
    ) case some then {
        return o
    } case none then {
        return (ztypes.vid.create from: 0)
    }
}

# optTidOr -- the value of optional TYPE id `o`, or `d` when none. A sibling
# of optU64Or rather than a conversion at each call: `optionval tid` is not an
# `optionval u64`, a typedef substitutes for its base as a whole value and not
# as a generic argument.
optTidOr: function {o: optionval ztypes.tid d: ztypes.tid} out ztypes.tid is {
    match (
        o
    ) case some then {
        return o
    } case none then {
        return d
    }
}

# the value of optional u64 `o`, or `d` when none.
optU64Or: function {o: optionval u64 d: u64} out u64 is {
    match (
        o
    ) case some then {
        return o
    } case none then {
        return d
    }
}

# the value of optional bool `o`, or `d` when none.
optBoolOr: function {o: optionval bool d: bool} out bool is {
    match (
        o
    ) case some then {
        return o
    } case none then {
        return d
    }
}

# createDottedBaseId -- the base atom's node id when a dotted path's child is
# `create` (explicit construction: `T.create` is bare-name construction).
createDottedBaseId: function {ast: Ast.view n: Node.view} out optionval u32 is {
    match (
        n
    ) case dottedpath then {
        ccn: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: n.child.u64))
        if ccn.stringView == "create" then return (optionval.some n.parent.u32)
    } else null
    return (optionval.none u32)
}

# rootNameOf -- a value path's root atom name (unwrapping expressions and
# dotted segments), or "".
rootNameIdOf: function {ast: Ast.view n: Node.view} out zast.nameid is {
    match (
        n
    ) case atomid then {
        return n.name
    } case expression then {
        return (rootNameIdOf :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (rootNameIdOf :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}

rootNameOf: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } case expression then {
        return (rootNameOf :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (rootNameOf :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# dottedChildName -- a dotted path's child atom name, or "".
dottedChildName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case dottedpath then {
        return (atomName :ast n: (ast.nodes.get i: n.child.u64))
    } else {
        return "".string
    }
}

# dottedChildNameId -- the pool id of a dotted path's child atom name
# (0 when the shape differs).
dottedChildNameId: function {ast: Ast.view n: Node.view} out zast.nameid is {
    match (
        n
    ) case dottedpath then {
        return (atomNameId :ast n: (ast.nodes.get i: n.child.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}

# unionCreateArmName -- the constructed arm's name when a value is a tagged
# subtype construction (a UNION_CREATE-stamped call's dotted child), or "".
unionCreateArmName: function {ast: Ast.view st: zenv.ZSymbolTable.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (unionCreateArmName :ast :st n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        dgot: st.typing.dpTaggedParent.get key: n.nodeid.u64
        match (
            dgot
        ) case some then {
            return (atomName :ast n: (ast.nodes.get i: n.child.u64))
        } case none then {
            return "".string
        }
    } case call then {
        kOpt: st.typing.callKind.get key: n.nodeid.u64
        isUC: false
        match (
            kOpt
        ) case some then {
            if kOpt == zast.callkind.unionCreate then isUC = true
        } case none then null
        if isUC then return (dottedChildName :ast n: (ast.nodes.get i: n.callable.u64))
        return "".string
    } else {
        return "".string
    }
}

# borrowDottedBaseId -- the base atom's node id when a dotted path's child is
# `borrow` (a protocol/facet borrow projection), or none.
borrowDottedBaseId: function {ast: Ast.view n: Node.view} out optionval u32 is {
    match (
        n
    ) case dottedpath then {
        bcn: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: n.child.u64))
        if bcn.stringView == "borrow" then return (optionval.some n.parent.u32)
    } else null
    return (optionval.none u32)
}

# valueNoCoerceAt -- checkValueAt minus the value-position auto-call coercion
# (construction arguments take method REFERENCES for function-typed fields).
valueNoCoerceAt: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    nid: zast.nodeid
} out u64 is {
    arm: rowArmAt :ast :nid
    match (
        arm
    ) case expression then {
        wrap: exprRefAt :ast :nid
        ev: valueNoCoerceAt :st :unitDecl :ast nid: wrap.expression
        if ev > 0 then {
            sete: ev
            stampGate :st nid: wrap.nid.u64 tid: (ztypes.tid.create from: sete.u64)
        }
        return ev
    } case dottedpath then {
        dr: dpRefAt :ast :nid
        return (checkDotted :st :unitDecl :ast dp: dr coerce: false)
    } else {
        return (checkValueAt :st :unitDecl :ast :nid)
    }
}


# checkProjectionCreate -- `F.create from: expr` / `P.borrow from: expr` on a
# facet or protocol: a projection, not a call. No CALL scope; the from-argument
# walks in the current scope (a facet copies its source -- nothing is consumed);
# the value is the facet/protocol type.
checkProjectionCreate: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    pjId: u64
    consumes: bool
    borrows: bool
} out ztypes.tid is {
    found: false
    kAiter: u64
    for kAiter < call.nargs loop {
        argId: (zast.callArgAt :ast nid: call.nid i: kAiter).u32
        kAiter = kAiter + 1
        arg: argRefAt :ast nid: (zast.nodeid.create from: argId.u32)
        if (arg.nid.isZero) == false then {
            if (found) == false then {
                # an owned copy: the walks below lend ast
                an: zast.nameTextCopy :ast ref: arg.name
                isFrom: false
                if an.length == 0 then {
                    isFrom = true
                } else {
                    if an.stringView == "from" then isFrom = true
                }
                if isFrom then {
                    found = true
                    pvt: (checkValueAt :st :unitDecl :ast nid: arg.operation)
                    if pvt > 0 then {
                        if borrows then {
                            # The from-path's root is the borrow origin (a
                            # bare name or a `.lock`/`.borrow` projection) --
                            # the projection borrows, it never hoists.
                            pbr: rootNameIdOf :ast n: (ast.nodes.get i: arg.operation.u64)
                            if (pbr.isZero) == false then {
                                pbv2: st.lookupVarId nameId: pbr
                                match (
                                    pbv2
                                ) case some then {
                                    drainPendingBorrow :st
                                    st.typing.pendingBorrowPath.append pbr
                                } case none then null
                            }
                        } else {
                            if (argIsTrivial
                                :ast
                                op: (ast.nodes.get i: arg.operation.u64)
                            ) then {
                                pbn: (zast.nameTextAt
                                    :ast
                                    ref: (bareAtomNameId
                                        :ast
                                        n: (ast.nodes.get i: arg.operation.u64)
                                    )
                                )
                                if pbn.length > 0 then {
                                    pbv: st.lookupVarId nameId: (nameIdOf :ast name: pbn.stringView)
                                    match (
                                        pbv
                                    ) case some then {
                                        if consumes then {
                                            (st.invalidate
                                                nameId: (nameIdOf :ast name: pbn.stringView)
                                                loc: (optionval.none ztypes.zsrcpos)
                                            )
                                        }
                                    } case none then null
                                }
                            } else {
                                (hoistArg
                                    :ast
                                    :st
                                    argId: arg.operation
                                    argType: pvt
                                    paramType: 0
                                    :consumes
                                    viewParam: false
                                )
                            }
                        }
                    }
                }
            }
        }
    }
    setpj: pjId
    stampGate :st nid: call.nid.u64 tid: (ztypes.tid.create from: setpj.u64)
    pjk: zast.callkind.protocolCreate
    if (st.reg.typetypeOf typeId: (ztypes.tid.create from: pjId.u64)) == ztypes.ztypetype.facetType then {
        if borrows then {
            pjk = zast.callkind.facetBorrow
        } else {
            pjk = zast.callkind.facetCreate
        }
    } else {
        if borrows then pjk = zast.callkind.protocolBorrow
    }
    st.typing.callKind.set key: call.nid.u64 value: pjk
    return (ztypes.tid.create from: pjId)
}

# metaCreateBaseId -- the base atom's node id when a callable is the dotted
# `meta.create` (the enclosing type's raw allocator), or none.
metaCreateBaseId: function {ast: Ast.view n: Node.view} out optionval u32 is {
    match (
        n
    ) case dottedpath then {
        pn: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: n.parent.u64))
        cn2: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: n.child.u64))
        if pn.stringView == "meta" when cn2.stringView == "create" then {
            return (optionval.some (nodeId n: (ast.nodes.get i: n.parent.u64)).u32)
        }
    } else null
    return (optionval.none u32)
}

# typedefBaseOf -- a typedef type's base TYPE: the template for a base that
# is a generic instance (`Bytes: typedef (ListVal u8)` -> ListVal), else the
# base itself; 0 when `tid` is not a typedef. typedefBaseTidOf is the
# instance.
typedefBaseOf: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out ztypes.tid is {
    b: typedefBaseTidOf :st :tid
    if b.isZero then return b
    go: st.reg.genericOriginOf tid: b
    if go > 0 then return (ztypes.tid.create from: go.u64)
    return b
}

# typedefBaseTidOf -- a typedef type's base INSTANCE id, resolved structurally
# when the wrapper was declared, or 0.
typedefBaseTidOf: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out ztypes.tid is {
    return (optTidOr o: (st.typing.typedefBaseTid.get key: tid) d: ztypes.tid)
}
# reportUnresolvedCastArg -- a typedef cast's from-argument that resolved to
# nothing and raised nothing is an unknown reference, as at a read. Without this
# the value types to 0, every check on that argument is skipped, and the emitter
# writes the bare name into the C: zc exits 0 and only the C compiler catches
# it. The named / positional / constructor / method argument forms were fixed
# for exactly this (tests/fixtures/errors/arg_value_unresolved.z); the two
# typedef legs never got it, because a cast is not a call.
reportUnresolvedCastArg: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    argId: zast.nodeid
    vt: ztypes.tid
    errMark: u64
} is {
    if (vt.isZero) == false then return
    if st.typing.errors.length != errMark then return
    ub: unresolvedBareCallable :ast :st :unitDecl nid: argId
    if ub.length == 0 then return
    um: "Unknown reference '\{ub}'"
    en: String
    eh: String
    (addErrorH
        :st
        nodeid: argId
        lineno: (nodeLine n: (ast.nodes.get i: argId.u64))
        colno: (nodeCol n: (ast.nodes.get i: argId.u64))
        e: zast.err.badReference
        msg: um
        note: en
        hint: eh
        width: ub.length.u32.orPanic
    )
}
# consumeCastFromArg -- a typedef cast CONSUMES its from-argument. A trivial
# argument invalidates the source name; a non-trivial one hoists to the current
# scope. Only a REFTYPE source transfers -- a valtype owns no heap, so the cast
# takes a copy and the name stays live.
consumeCastFromArg: function {
    st: zenv.ZSymbolTable
    ast: Ast
    aOpId: zast.nodeid
    vt: ztypes.tid
} is {
    if (argIsTrivial :ast op: (ast.nodes.get i: aOpId.u64)) then {
        bn: (zast.nameTextAt
            :ast
            ref: (bareAtomNameId :ast n: (ast.nodes.get i: aOpId.u64))
        )
        if bn.length > 0 then {
            bvo: st.lookupVarId nameId: (nameIdOf :ast name: bn.stringView)
            match (
                bvo
            ) case some then {
                # only a REFTYPE source transfers. A
                # valtype owns no heap, so the typedef
                # takes a copy and the name stays live --
                # the same guard a returned owned local
                # carries before it records a move.
                if (typeIsReftype :st tid: vt) then {
                    (st.invalidate
                        nameId: (nameIdOf :ast name: bn.stringView)
                        loc: (optionval.none ztypes.zsrcpos)
                    )
                }
            } case none then null
        }
    } else {
        (hoistArg
            :ast
            :st
            argId: aOpId
            argType: vt
            paramType: 0
            consumes: true
            viewParam: false
        )
    }
}

# checkTypedefCreate -- `T.create from: expr` / bare `T expr` on a typedef:
# an owned cast, not a call. No CALL scope; the from-argument walks in the
# current scope (a non-trivial one hoists there) and is consumed; the value
# is the typedef type.
checkTypedefCreate: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    tdId: u64
} out ztypes.tid is {
    found: false
    kAiter: u64
    for kAiter < call.nargs loop {
        argId: (zast.callArgAt :ast nid: call.nid i: kAiter).u32
        kAiter = kAiter + 1
        arg: argRefAt :ast nid: (zast.nodeid.create from: argId.u32)
        if (arg.nid.isZero) == false then {
            if (found) == false then {
                # an owned copy: the walks below lend ast
                an: zast.nameTextCopy :ast ref: arg.name
                isFrom: false
                if an.length == 0 then {
                    isFrom = true
                } else {
                    if an.stringView == "from" then isFrom = true
                }
                if isFrom then {
                    found = true
                    errT0: st.typing.errors.length
                    vt: checkValueAt :st :unitDecl :ast nid: arg.operation
                    (reportUnresolvedCastArg
                        :st
                        :unitDecl
                        :ast
                        argId: arg.operation
                        :vt
                        errMark: errT0
                    )
                    if vt > 0 then (consumeCastFromArg :st :ast aOpId: arg.operation :vt)
                }
            }
        }
    }
    settd: tdId
    stampGate :st nid: call.nid.u64 tid: (ztypes.tid.create from: settd.u64)
    st.typing.callKind.set key: call.nid.u64 value: zast.callkind.typedefCreate
    return (ztypes.tid.create from: tdId)
}

# checkTypedefBorrow -- `T.borrow from: expr` on a typedef: a borrowed
# cast. No CALL scope, no take; the from-argument walks in the current
# scope and the binding borrows the argument's source (the lifted view
# origin when the argument is itself a borrowed view, else the
# argument's own path).
checkTypedefBorrow: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    tdId: u64
} out ztypes.tid is {
    found: false
    kAiter: u64
    for kAiter < call.nargs loop {
        argId: (zast.callArgAt :ast nid: call.nid i: kAiter).u32
        kAiter = kAiter + 1
        arg: argRefAt :ast nid: (zast.nodeid.create from: argId.u32)
        if (arg.nid.isZero) == false then {
            if (found) == false then {
                # an owned copy: the walks below lend ast
                an: zast.nameTextCopy :ast ref: arg.name
                isFrom: false
                if an.length == 0 then {
                    isFrom = true
                } else {
                    if an.stringView == "from" then isFrom = true
                }
                if isFrom then {
                    found = true
                    errT0: st.typing.errors.length
                    vt: (checkValueAt :st :unitDecl :ast nid: arg.operation)
                    (reportUnresolvedCastArg
                        :st
                        :unitDecl
                        :ast
                        argId: arg.operation
                        :vt
                        errMark: errT0
                    )
                    if vt > 0 then {
                        if st.typing.pendingBorrowPath.length <= 0 then {
                            tup: (ListVal zast.nameid)
                            (appendValueTuple
                                :ast
                                n: (ast.nodes.get i: arg.operation.u64)
                                dst: tup
                            )
                            with tit: tup.iterate do for te: tit loop st.typing.pendingBorrowPath.append te
                        }
                    }
                }
            }
        }
    }
    settd: tdId
    stampGate :st nid: call.nid.u64 tid: (ztypes.tid.create from: settd.u64)
    st.typing.callKind.set key: call.nid.u64 value: zast.callkind.typedefBorrow
    return (ztypes.tid.create from: tdId)
}

# methodHasThisReceiver -- a FUNCTION child bound to a receiver: a declared
# `this` param (shorthand) or a recorded long-form receiver name. A this-less
# function member is a callable field, not a method.
methodHasThisReceiver: function {st: zenv.ZSymbolTable.view mid: ztypes.tid} out bool is {
    if (st.typing.declHasMemberId parentTypeId: mid nameId: zast.names.wkThis) then return true
    return (st.reg.hasThisParamName tid: mid)
}

# true when method `mid` takes no user arguments (only the receiver).
methodHasNoUserArgs: function {
    st: zenv.ZSymbolTable.view
    mid: ztypes.tid
} out bool is {
    cnt: st.typing.declMemberCount ownerTid: mid
    if cnt == 0 then return true
    if cnt != 1 then return false
    # declLastChildNameId hands back a pool id, so the receiver test takes it
    # directly -- copying the text out to intern it again lands on this id.
    soleId: st.typing.declLastChildNameId ownerTid: mid
    if soleId == zast.names.wkThis.u64 then return true
    return (st.reg.thisParamNameIs
        tid: mid
        nameId: (zast.nameid.create from: soleId.u32.orPanic)
    )
}

# lockAutoCallReceiver -- the receiver locks for a zero-arg auto-call's
# duration, exactly as a written-out call does. The lock is released by holder
# as soon as it is taken -- an auto-call opens no scope to pop -- so its only
# effect is the conflict check against locks outstanding elsewhere. `mid` names
# the METHOD, which is what carries the receiver's marker and so decides whether
# the lock is shared or exclusive.
lockAutoCallReceiver: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    dp: dpref
    bt: ztypes.tid
    shared: bool
} is {
    atup: (ListVal zast.nameid)
    appendValueTuple :ast n: (ast.nodes.get i: dp.parent.u64) dst: atup
    if atup.length == 0 then return
    if (typeIsReftype :st tid: (ztypes.tid.create from: bt.u64)) == false then return
    arv: st.lookupVarId nameId: (atup.get i: 0)
    if arv.none then return
    ashr: shared
    if atup.length == 1 then {
        (lockCallArg
            :st
            pool: ast.names
            nameId: (atup.get i: 0)
            callId: dp.nid.u64
            shared: ashr
            nodeid: dp.nid
            lineno: dp.lineno
            colno: dp.colno
        )
    } else {
        (lockCallPath
            :st
            :ast
            pool: ast.names
            path: atup
            callId: dp.nid.u64
            shared: ashr
            nodeid: dp.nid
            lineno: dp.lineno
            colno: dp.colno
        )
    }
    ahl: (ztypes.zlockholder
        kind: ztypes.zlockholderkind.callKind
        id: dp.nid.u64
    )
    st.releaseHeldLocks holder: ahl
}

# fnAutoCallable -- a bare reference to this function is a zero-argument
# auto-call: it has no user parameters, or every non-receiver parameter
# carries a default the site can fill. The strict no-user-args predicate
# stays separate for its other gates (fnptr-field reads, for-iterators).
fnAutoCallable: function {st: zenv.ZSymbolTable.view mid: ztypes.tid} out bool is {
    if (methodHasNoUserArgs :st :mid) then return true
    # thisParamNameIdOf already answers in pool ids; viewing the text to look
    # the same id up again is the identity.
    thisPnId: (st.reg.thisParamNameIdOf tid: mid).u64
    userSeen: false
    n: st.typing.declRowSlots ownerTid: mid
    i: u64
    for i < n loop {
        row: st.typing.declRowAt ownerTid: mid membersOnly: false slot: i
        i = i + 1
        if row.keep then {
        pnameId: row.name
        isRecv: false
        if pnameId == zast.names.wkThis.u64 then isRecv = true
        if thisPnId > 0 when pnameId == thisPnId then isRecv = true
        if (isRecv) == false then {
            userSeen = true
            hd: (st.typing.declHasDefaultId
                parentTypeId: mid
                nameId: (zast.nameid.create from: pnameId.u32.orPanic)
            )
            if (hd) == false then return false
        }
        }
    }
    return userSeen
}

# bareFnRefError -- a bare reference to a function with required parameters
# is a call missing its arguments (a reference needs the explicit '.take').
bareFnRefError: function {
    ast: Ast
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u32
    fid: ztypes.tid
} is {
    prov: (List String)
    misN: (List String)
    misI: (ListVal u64)
    (missingCtorFields
        :ast
        :st
        funcId: (ztypes.tid.create from: fid.u64)
        isCtor: false
        provided: prov
        posCount: 0
        missingNames: misN
        missingIds: misI
    )
    lst: String
    li: u64
    ln: misN.length
    for li < ln loop {
        mn: misN.get i: li
        memberIdAt: misI.get i: li
        li = li + 1
        mtn: st.reg.nameOf tid: (ztypes.tid.create from: memberIdAt.u64)
        if lst.length > 0 then lst.append ", "
        ln1: "'\{mn}' (type: \{mtn})"
        lst.append ln1
    }
    fn: st.reg.nameOf tid: fid
    m: "a bare reference to '\{fn}' calls it: missing required arguments \{lst}"
    nt: "a bare function reference in value position is a call".string
    eh: "call it with its required arguments, or store a reference with '\{fn}.take'"
    (addErrorH
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.callError
        msg: m
        note: nt
        hint: eh
        :width
    )
}

# canonicalChildBase -- a cross-unit narrowed match-arm base can be a shell id
# (distinct from the canonical defining-unit id) whose member children are not
# registered. Find a same-named type in any unit's resolved scope that has the
# named member; 0 when none. Mirrors the emitter's resolveTypeIdByName scan.
canonicalChildBase: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    bt: u64
    child: StringView
} out u64 is {
    nm: st.reg.nameOf tid: (ztypes.tid.create from: bt.u64)
    if nm.length == 0 then return 0
    nmId: nameIdOf :ast name: nm.stringView
    uks: (ListVal u64)
    {
        puds: programUnitDecls :st
        with uit: puds.iterate do for ud: uit loop {
            unm: (declNameIdOf
                :st
                declId: (ztypes.declid.create from: ud)
            )
            uks.append unm.u64
        }
    }
    cands: (ListVal u64)
    uki: u64
    ukn: uks.length
    for uki < ukn loop {
        uk: uks.get i: uki
        uq4z: unitDeclOfName :st nameId: (zast.nameid.create from: uk.u32.orPanic)
        ro: (resolvedByIds
            :st
            :ast

            unitDecl: uq4z
            name: nmId
        )
        match (
            ro
        ) case some then {
            if ro != bt then cands.append ro
        } case none then null
        uki = uki + 1
    }
    found: u64
    ci: u64
    cnn: cands.length
    for ci < cnn loop {
        if found == 0 then {
            cand: cands.get i: ci
            rc: (st.typing.declChildOf
                pool: ast.names
                parentTypeId: (ztypes.tid.create from: cand.u64)
                name: child
            )
            match (
                rc
            ) case some then {
                found = cand
            } case none then null
        }
        ci = ci + 1
    }
    return found
}

# markDataRuntimeIndexed -- a data block accessed via `.index` / `.array` needs
# its static array emitted; label accesses fold to constants and don't.
markDataRuntimeIndexed: function {st: zenv.ZSymbolTable tid: ztypes.tid} is {
    if tid >= st.reg.typeById.length then return
    to: st.reg.typeById.getMut i: tid
    to.runtimeIndexed = true
}

# dataElemTypeOf -- the element type of a data block, 0 when it cannot be
# derived. A data block records its `out T` as the name of its tag child
# (`tag__u8`), so the element type is that name resolved in the reading unit's
# scope. Both `.index` and `.array` read it -- `.index` yields one element,
# `.array` an array of them -- so it is derived once.
dataElemTypeOf: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    dataTid: ztypes.tid
} out ztypes.tid is {
    (forceMemberOf :st frame: st.curFrame :ast parentTypeId: dataTid nameId: zast.names.wkTag)
    tgo: st.typing.declChildOfId parentTypeId: dataTid nameId: zast.names.wkTag
    match (
        tgo
    ) case some then {
        tagn: st.reg.nameOf tid: (ztypes.tid.create from: tgo.u64)
        eno: tagn.stringView.stripPrefix p: "tag__"
        match (
            eno
        ) case some then {
            den: eno
            elo: (walkLookupTyperef
                :st
                frame: st.curFrame
                :ast

                :unitDecl
                base: den
            )
            match (
                elo
            ) case some then {
                return (ztypes.tid.create from: elo.u64)
            } case none then null
        } case none then null
    } case none then null
    return (ztypes.tid.create from: 0)
}

# checkDotted -- a dotted method reference in a body: type the base, look the
# member up on the base's type, and stamp the dotted node -- with the method's
# return when the method takes no user parameters beyond the receiver (the
# auto-call coercion), else with the method FUNCTION type itself.
# baseIsPrivateCapable -- may a private member be read through this base? True
# when the base is the type's own `this`/same-type receiver (self, inside its
# methods), a `.private` projection, or a read of a `.private`-typed friend
# field. Everything else is external and gated.
baseIsPrivateCapable: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    bt: ztypes.tid
    baseNode: Node.view
} out bool is {
    if (bt.isZero) == false when bt == st.typing.currentThisTid then return true
    match (
        baseNode
    ) case atomid then {
        if baseNode.name == zast.names.wkThis then return true
        vo: st.lookupVarId nameId: baseNode.name
        match (
            vo
        ) case some then {
            return (st.reg.variableIsPrivate id: vo)
        } case none then {
            return false
        }
    } case dottedpath then {
        cnm: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: baseNode.child.u64))
        if cnm.stringView == "private" then return true
        pbNode: ast.nodes.get i: baseNode.parent.u64
        pbNid: nodeId n: pbNode
        pbType: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: pbNid.u64
        if pbType > 0 when (st.typing.declGrantsPrivate
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: pbType.u64)
            name: cnm.stringView
        ) then return true
        return false
    } else {
        return false
    }
}

# memberStrictType -- whether `bt` should get the strict unknown-member check:
# a concrete record/class/union/variant with a declaration and no generic
# origin -- its method set is fully declared, whichever unit declares it.
# Generic instances (List/Map/Set monos, a user template's) and bare shells
# stay lenient because their members are minted per-instantiation.
memberStrictType: function {st: zenv.ZSymbolTable.view bt: u64} out bool is {
    tt: st.reg.typetypeOf typeId: (ztypes.tid.create from: bt.u64)
    isConc: false
    if tt == ztypes.ztypetype.recordType then isConc = true
    if tt == ztypes.ztypetype.classType then isConc = true
    if tt == ztypes.ztypetype.unionType then isConc = true
    if tt == ztypes.ztypetype.variantType then isConc = true
    if tt == ztypes.ztypetype.dataType then isConc = true
    if (isConc) == false then return false
    hasUnit: (unitDeclOfTid :st tid: (ztypes.tid.create from: bt.u64)) > 0
    if (hasUnit) == false then return false
    if (st.reg.genericOriginOf tid: (ztypes.tid.create from: bt.u64)) > 0 then return false
    if (st.reg.hasType typeId: (ztypes.tid.create from: bt.u64)) == false then return false
    if (st.reg.isGenericOf tid: (ztypes.tid.create from: bt.u64)) then return false
    return true
}

# typecheck a dotted member-access expression, enforcing visibility and locks.
# isSubunitMemberOf -- the member `member` of unit `unitTid` is a hidden
# implementation subunit. Read off the AST node the member's declaration points
# at, because subunit-ness is how the unit was WRITTEN and the registry records
# only that it is a unit.
isSubunitMemberOf: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    unitTid: ztypes.tid
    member: optionval u64
} out bool is {
    unitTid
    mt: u64
    match (
        member
    ) case some then {
        mt = member
    } case none then {
        return false
    }
    if (st.reg.typetypeOf typeId: (ztypes.tid.create from: mt)) != ztypes.ztypetype.unitType then {
        return false
    }
    dc: declOfTypeId :st tid: (ztypes.tid.create from: mt)
    if dc.isZero then return false
    dn: u32
    {
        decl: st.typing.decls.get i: dc.u64
        dn = decl.node
    }
    if dn == 0 then return false
    opNode: u32
    {
        nn: ast.nodes.get i: dn.u64
        if nn.namedoperation then opNode = nn.operation
    }
    return (zast.unitOpKindIs :ast opId: opNode k: zast.unitkind.subunit)
}

# unitMemberTypeOf -- the type a member of unit `unitTid` names: the frame that
# unit roots, which follows a re-export and demands the definition, then its
# member index. One answer for every unit -- a file unit, an inline
# `m: unit { }` and a hidden subunit each root a frame off their own Decl, and
# `unit.member` names a member of THAT unit, so the prelude is not consulted.
unitMemberTypeOf: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitTid: ztypes.tid
    unitDecl: ztypes.declid
    member: StringView
} out optionval u64 is {
    nid: zast.poolFind pool: ast.names text: member
    if nid.isZero then return (optionval.none u64)
    # A top-level unit roots a frame under its own name; a nested unit is
    # deliberately absent from that index -- two files may hold units of the
    # same name -- so its root comes off its type id instead. The name is
    # only trusted when it produces THIS unit: a nested unit may share a name
    # with a top-level one, and answering from the index alone probed the
    # other unit's frame for the member. A generic mono's own declaration
    # (declIdOfType) carries its substituted members; declOfTypeId hops to
    # the TEMPLATE's, whose members are the generic ones.
    root: ztypes.declid
    {
        uro: unitDecl
        if (uro.isZero) == false then {
            urt: declTypeIdOf :st declId: uro
            if urt == unitTid then root = uro
        }
    }
    if root.isZero then root = st.typing.declIdOfType typeId: unitTid
    if root.isZero then root = declOfTypeId :st tid: unitTid
    r: probeFrameTyperef :st :ast :root nameId: nid
    if r > 0 then return (optionval.some r)
    # a definition the unit's `public:` block makes is on its surface
    pb: publicNsChildOf :st :root
    if (pb.isZero) == false then {
        r8: probeFrameTyperef :st :ast root: pb nameId: nid
        if r8 > 0 then return (optionval.some r8)
    }
    return (optionval.none u64)
}
# reportUnknownMember -- an unknown member on a concrete user-defined type is a
# hard error. Shells (no defining unit), stdlib/native types and template walks
# stay silent: their members resolve through later passes or per-instantiation.
reportUnknownMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cn: StringView
    cnId: zast.nameid
} is {
    # unknown member on a concrete user-defined type: hard error.
    # Shells (no defining unit), stdlib/native types, and template
    # walks stay silent -- their members resolve through later
    # passes or per-instantiation.
    bttMm: st.reg.typetypeOf typeId: bt
    isConcMm: false
    if bttMm == ztypes.ztypetype.recordType then isConcMm = true
    if bttMm == ztypes.ztypetype.classType then isConcMm = true
    if bttMm == ztypes.ztypetype.unionType then isConcMm = true
    if bttMm == ztypes.ztypetype.variantType then isConcMm = true
    if bttMm == ztypes.ztypetype.dataType then isConcMm = true
    if isConcMm when (memberStrictType :st :bt) then {
        if st.typing.suppressParamStamps == false then {
            # demand-order safety: walk the type's methods once and
            # re-probe before declaring the member unknown
            btnMm0: st.reg.nameOf tid: bt
            walkDefinitionById :st :ast tid: bt
            (forceMemberOf :st frame: st.curFrame :ast parentTypeId: bt nameId: cnId)
            moMm: st.typing.declChildOfId parentTypeId: bt nameId: cnId
            stillMiss: true
            match (
                moMm
            ) case some then {
                stillMiss = false
            } case none then null
            # a numeric-type-named member on a numeric base is a width
            # conversion; the identity form (x.T where x is already T) is
            # not a declared child but is a valid (redundant) cast.
            if stillMiss then {
                baseNum: false
                if (isNumericTypeName name: btnMm0.stringView) then baseNum = true
                # the literal types by ID: the tid is in hand here, and their
                # spellings now name declared types like any other
                if (isLiteralTypeId :st tid: bt) then baseNum = true
                if (isNumericTypeName name: cn) when baseNum then stillMiss = false
            }
            if stillMiss then {
                btnMm: st.reg.nameOf tid: bt
                mMm: "type '\{btnMm}' has no member '\{cn}'"
                sugMm: suggestSimilar :ast :st parentTypeId: bt name: cn
                hMm: String
                if sugMm.length > 0 then {
                    hhMm: "did you mean '\{sugMm}'?"
                    hMm = hhMm
                }
                if (declMemberIsPrivate
                    :st

                    tid: bt
                    nameId: (ast.names.find s: cn)
                ) then {
                    hpMm: "'\{cn}' is private (not in the public interface)"
                    hMm = hpMm
                }
                cnidMm: nodeId n: (ast.nodes.get i: dp.child.u64)
                cnlnMm: nodeLine n: (ast.nodes.get i: dp.child.u64)
                cnclMm: nodeCol n: (ast.nodes.get i: dp.child.u64)
                (addErrorH
                    :st
                    nodeid: cnidMm
                    lineno: cnlnMm
                    colno: cnclMm
                    e: zast.err.typeError
                    msg: mMm
                    note: "".string
                    hint: hMm
                    width: cn.length.u32.orPanic
                )
            }
        }
    }
}
# checkCopyMember -- `.copy` on a receiver that declares no copy member. Deep copy
# exists for strings, containers and generic type parameters only, so the gap is a
# hard error here rather than invalid C out of the emitter.
checkCopyMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cn: StringView
} out callleg is {
    # `.copy` on a receiver with no copy member is a hard error: deep
    # copy exists for strings, containers, and generic type parameters
    # only. Without this the emitter has no clone to emit and the
    # miss would surface as invalid C.
    if cn == "copy" when (st.reg.typetypeOf typeId: bt) != ztypes.ztypetype.genericParam then {
        # per-mono instance walk: `.copy` on a template param was
        # validated against the template (t -> t); the instance lowers
        # it per type (valtypes/views bitwise, String deep). Only the
        # user-reftype capability gap stays an error.
        if st.typing.curMonoStamp > 0 then {
            bttIw: st.reg.typetypeOf typeId: bt
            isRefIw: false
            if bttIw == ztypes.ztypetype.classType then isRefIw = true
            if bttIw == ztypes.ztypetype.unionType then isRefIw = true
            if isRefIw then {
                # native view classes (StringView) copy by assignment --
                # only USER reftypes lack a lowering
                if (st.reg.isNativeOf tid: bt) then isRefIw = false
            }
            if bt == (builtinTidTc :ast :st base: "StringView") then isRefIw = false
            if (isRefIw) == false then {
                stampGate :st nid: dp.nid.u64 tid: bt
                return (callleg handled: true tid: bt)
            }
        }
        btnCp: st.reg.nameOf tid: bt
        bttCp: st.reg.typetypeOf typeId: bt
        isValCp: false
        if bttCp == ztypes.ztypetype.recordType then isValCp = true
        if bttCp == ztypes.ztypetype.variantType then isValCp = true
        if bttCp == ztypes.ztypetype.facetType then isValCp = true
        # A valtype's DEFAULT `.copy` is the byte copy its assignment
        # already performs -- a valtype holds no reftype, so copying the
        # bytes copies the whole value. Writing one in the as-block
        # overrides this default; the member lookup above finds it first
        # and never reaches here. `copy: null` strikes the default off,
        # and a monomorphised instance inherits its template's decision.
        cpOff: st.typing.copyOptOut.has item: bt
        if (cpOff) == false then {
            cpOrg: st.reg.genericOriginOf tid: bt
            if cpOrg > 0 then cpOff = st.typing.copyOptOut.has item: cpOrg
        }
        if isValCp when (cpOff) == false then {
            stampGate :st nid: dp.nid.u64 tid: bt
            return (callleg handled: true tid: bt)
        }
        if cpOff then {
            mOff: "type '\{btnCp}' has no '.copy': its `as` block defines `copy: null`, striking the default copy off the type"
            (addError
                :st
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.typeError
                msg: mOff
            )
            return (callleg handled: true tid: (ztypes.tid.create from: 0))
        }
        mCp: "type '\{btnCp}' has no '.copy': a reftype has no default copy -- define a 'copy' method on '\{btnCp}' saying what a duplicate means, or move with '.take'"

        if bt == (builtinTidTc :ast :st base: "StringView") then {
            mCp = "type 'StringView' has no '.copy': a view is copied by assignment; '.string' makes an owned String (allocates)".string
        }
        (addError
            :st
            nodeid: dp.nid
            lineno: dp.lineno
            colno: dp.colno
            e: zast.err.typeError
            msg: mCp
        )
        return (callleg handled: true tid: (ztypes.tid.create from: 0))
    }
    return (callleg handled: false tid: (ztypes.tid.create from: 0))
}
# reportPrivateMember -- E0102 for a member the type does not make public, unless
# the base already holds private access or a public alias routed us here.
reportPrivateMember: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    dp: dpref
    bt: ztypes.tid
    cn: StringView
    aliasViaX: bool
} is {
    if aliasViaX == false when (declMemberIsPrivate
        :st

        tid: bt
        nameId: (ast.names.find s: cn)
    ) then {
        baseN: ast.nodes.get i: dp.parent.u64
        if (baseIsPrivateCapable :st :ast :bt baseNode: baseN) == false then {
            cnidP: nodeId n: (ast.nodes.get i: dp.child.u64)
            cnlnP: nodeLine n: (ast.nodes.get i: dp.child.u64)
            cnclP: nodeCol n: (ast.nodes.get i: dp.child.u64)
            btNmP: st.reg.nameOf tid: bt
            pmsgP: "'\{cn}' is not public on type '\{btNmP}'"
            (addErrorH
                :st
                nodeid: cnidP
                lineno: cnlnP
                colno: cnclP
                e: zast.err.notPublic
                msg: pmsgP
                note: "".string
                hint: "".string
                width: cn.length.u32.orPanic
            )
        }
    }
}
# checkMemberAutoCall -- a FUNCTION member read in value position auto-calls: it
# takes the receiver lock a reader takes, answers the method's return type, and
# routes the borrow / view / takex return reports. Answers the path's type.
checkMemberAutoCall: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    dp: dpref
    bt: ztypes.tid
    cn: StringView
    mo: u64
    coerce: bool
    result0: ztypes.tid
} out ztypes.tid is {
    result: result0
    if coerce when (st.typing.suppressFnAutoCall) == false when (fnAutoCallable
        :st
        mid: (ztypes.tid.create from: mo.u64)
    ) then {
        aShr: isContainerReaderCall :ast :st recvTid: bt mname: cn
        if (methodReceiverIsView :st mid: (ztypes.tid.create from: mo.u64)) then aShr = true
        lockAutoCallReceiver :ast :st :dp :bt shared: aShr
        ro: methodReturnOf :st mid: (ztypes.tid.create from: mo.u64)
        match (
            ro
        ) case some then {
            result = ro
            fb: st.typing.funcReturnsBorrow.get key: mo
            match (
                fb
            ) case some then {
                if fb then {
                    # Build locally, then append through the full field
                    # path (a field list passed as an argument is a
                    # non-owning shallow copy -- appends would be lost).
                    tup: (ListVal zast.nameid)
                    appendValueTuple :ast n: (ast.nodes.get i: dp.parent.u64) dst: tup
                    drainPendingBorrow :st
                    with tit: tup.iterate do for te: tit loop st.typing.pendingBorrowPath.append te
                    if (returnIsIteratorTid :st tid: result) == false then {
                        st.typing.pendingBorrowShared = true
                    } else {
                        mrv: (methodReceiverIsView
                            :st
                            mid: (ztypes.tid.create from: mo.u64)
                        )
                        if mrv then st.typing.pendingBorrowShared = true
                    }
                    # An `out T.view` result is a READONLY reference: shared pin,
                    # and the binding it lands on may only be read.
                    if (optBoolOr o: (st.typing.funcReturnsView.get key: mo) d: false) then {
                        st.typing.pendingBorrowShared = true
                        st.typing.pendingBorrowReadonly = true
                    }
                } else {
                    drainPendingBorrow :st
                }
            } case none then {
                # an owning auto-call (`.copy` / `.string` / user methods)
                # consumes any receiver-evaluation borrow residue (the get
                # in `(xs.get i).copy` must not flow to the binding).
                drainPendingBorrow :st
                if (optBoolOr o: (st.typing.funcReturnsTakex.get key: mo) d: false) then {
                    # `takex`: the result is OWNED but pins its source --
                    # the same receiver pin a borrow return takes, without
                    # demoting the binding (`pendingBorrowOwned`).
                    tupX: (ListVal zast.nameid)
                    appendValueTuple :ast n: (ast.nodes.get i: dp.parent.u64) dst: tupX
                    with titX: tupX.iterate do for teX: titX loop st.typing.pendingBorrowPath.append teX
                    if (returnIsIteratorTid :st tid: result) == false then {
                        st.typing.pendingBorrowShared = true
                    } else {
                        mrvX: (methodReceiverIsView :st mid: (ztypes.tid.create from: mo.u64))
                        if mrvX then st.typing.pendingBorrowShared = true
                    }
                    st.typing.pendingBorrowOwned = true
                }
            }
        } case none then {
            # A no-`out` METHOD auto-call resolves to null (the
            # reference's auto-call rule for out-less methods). Non-
            # function members (field shells) keep their re-resolved
            # type.
            if (st.reg.typetypeOf typeId: (ztypes.tid.create from: mo.u64)) == ztypes.ztypetype.functionType then {
                result = ztypes.tid.create from: (st.typing.nullTypeId)
            }
        }
    }
    return result
}
# checkMemberProjections -- the three legs a resolved member takes before the
# auto-call one: `X.create` in value position is zero-argument construction, a
# protocol-typed conformance member projects a borrow of its receiver, and an
# args-bearing fn-pointer field read bare is a call missing its arguments.
checkMemberProjections: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cn: StringView
    cnId: zast.nameid
    mo: u64
    rm: u64
    coerce: bool
} out callleg is {
    # `X.create` in value position is zero-argument construction (the same
    # as the bare type name); route it through the shared construction check
    # so a synthesized create's required fields are enforced and the
    # implicitCreate stamp drives field-wise emission.
    if coerce when cnId == zast.names.wkCreate when (st.reg.typetypeOf typeId: (ztypes.tid.create from: mo.u64)) == ztypes.ztypetype.functionType when (isImplicitZeroCreateTid
        :ast
        :st
        tid: bt
    ) == false then {
        (checkBareTypeValueAt
            :ast
            :st
            nodeid: dp.nid
            lineno: dp.lineno
            colno: dp.colno
            width: cn.length.u32.orPanic
            tid: bt
        )
        setcr: bt
        stampGate :st nid: dp.nid.u64 tid: setcr
        return (callleg handled: true tid: bt)
    }
    # Reading a protocol-typed conformance member projects a borrow of
    # the receiver: the consuming binding becomes BORROWED with the base
    # as its origin (and installs the borrow locks).
    rmtt: st.reg.typetypeOf typeId: (ztypes.tid.create from: rm.u64)
    if rmtt == ztypes.ztypetype.protocolType then {
        pjroot: (zast.nameTextAt
            :ast
            ref: (bareAtomNameId :ast n: (ast.nodes.get i: dp.parent.u64))
        )
        if pjroot.length > 0 then {
            pjvo: st.lookupVarId nameId: (nameIdOf :ast name: pjroot.stringView)
            match (
                pjvo
            ) case some then {
                drainPendingBorrow :st
                st.typing.pendingBorrowPath.append (nameIdOf :ast name: pjroot.stringView)
            } case none then null
        }
    }
    if coerce when (st.typing.declIsFnptrField
        pool: ast.names
        parentTypeId: bt
        name: cn
    ) then {
        # bare name = call: a value-position read of an args-bearing
        # fn-pointer field is a call missing its arguments; `.take` is
        # the reference form (peeled before this leg)
        natE3: st.typing.inAssignTarget
        {
            isNative9v: st.reg.isNativeOf tid: (ztypes.tid.create from: mo.u64)
                if isNative9v then natE3 = true
        }
        if natE3 == false when (methodHasNoUserArgs
            :st
            mid: (ztypes.tid.create from: mo.u64)
        ) == false then {
            mE3: "function-pointer field '\{cn}' takes arguments; call it, or reference it with '.take'"
            (addError
                :st
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.callError
                msg: mE3
            )
        }
    }
    return (callleg handled: false tid: (ztypes.tid.create from: 0))
}
# checkTaggedMemberPath -- a subtype member named on a tagged TYPE (not a value of
# it, not the tag, not a method) is a construction reference: the path's value IS
# the tagged parent. A VALUE base makes the path the arm PREDICATE instead -- it
# types bool and stamps dpArmPredicate for the tag-compare emission.
checkTaggedMemberPath: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cn: StringView
    mo: u64
    aliasViaX: bool
} out callleg is {
    # A subtype member named on a tagged TYPE (not a value of it, not the
    # tag, not a method) is a construction reference: record the dotted
    # node's tagged parent (construction dispatch and generic-union
    # inference key off it), stamp the path with the parent, and the
    # path's value IS the parent. A VALUE base makes the path the arm
    # PREDICATE: it types bool (true when the value currently holds
    # that arm) and stamps dpArmPredicate for the tag-compare emission.
    btt0: st.reg.typetypeOf typeId: bt
    isTagged: false
    if btt0 == ztypes.ztypetype.variantType then isTagged = true
    if btt0 == ztypes.ztypetype.unionType then isTagged = true
    if isTagged then {
        ctt0: st.reg.typetypeOf typeId: (ztypes.tid.create from: mo.u64)
        isMember: true
        if ctt0 == ztypes.ztypetype.functionType then isMember = false
        if ctt0 == ztypes.ztypetype.dataType then isMember = false
        if isMember then {
            isVal: taggedRecvIsValue :ast :st n: (ast.nodes.get i: dp.parent.u64)
            if (isVal) == false then {
                # arm constructors are members: from OUTSIDE the type an
                # unlisted arm is private (a public alias translated above).
                armHidden: false
                if aliasViaX == false then {
                    baseNodeC: ast.nodes.get i: dp.parent.u64
                    if (baseIsPrivateCapable :st :ast :bt baseNode: baseNodeC) == false then {
                        if (declMemberIsPrivate
                            :st

                            tid: bt
                            nameId: (ast.names.find s: cn)
                        ) then armHidden = true
                    }
                }
                if armHidden then {
                    ccnid: nodeId n: (ast.nodes.get i: dp.child.u64)
                    ccln: nodeLine n: (ast.nodes.get i: dp.child.u64)
                    cccl: nodeCol n: (ast.nodes.get i: dp.child.u64)
                    ccbn: st.reg.nameOf tid: bt
                    (addErrorH
                        :st
                        nodeid: ccnid
                        lineno: ccln
                        colno: cccl
                        e: zast.err.notPublic
                        msg: "'\{cn}' is not public on type '\{ccbn}'"
                        note: "".string
                        hint: "".string
                        width: cn.length.u32.orPanic
                    )
                    return (callleg handled: true tid: (ztypes.tid.create from: 0))
                }
                dpk0: dp.nid.u64
                dpv0: bt
                st.typing.dpTaggedParent.set key: dpk0 value: dpv0
                stampedTid: bt
                stampGate :st nid: dp.nid.u64 tid: stampedTid
                return (callleg handled: true tid: bt)
            }
            isArm: true
            if ctt0 == ztypes.ztypetype.tagType then isArm = false
            gtpl: false
            {
                isgeneric9v: st.reg.isGenericOf tid: bt
                    if isgeneric9v then gtpl = true
            }
            if isArm when (gtpl) == false then {
                boolId: (optU64Or
                    o: (walkLookupTyperef
                        :st
                        frame: st.curFrame
                        :ast

                        :unitDecl
                        base: "bool"
                    )
                    d: 0
                )
                if boolId > 0 then {
                    st.typing.dpArmPredicate.set key: dp.nid.u64 value: bt
                    stampGate :st nid: dp.nid.u64 tid: (ztypes.tid.create from: boolId.u64)
                    return (callleg handled: true tid: (ztypes.tid.create from: boolId))
                }
            }
        }
    }
    return (callleg handled: false tid: (ztypes.tid.create from: 0))
}
# checkTagAccessor -- a variant/union as-item `name: <numeric>.tag` exposes the
# discriminator on instances as a read-only numeric under the declared name.
# Without one, an instance read of `tag` is rejected here.
checkTagAccessor: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    dp: dpref
    bt: ztypes.tid
    cn: StringView
    cnId: zast.nameid
} out callleg is {
    # explicit tag accessor: a variant/union as-item `name: <numeric>.tag`
    # exposes the discriminator on instances as a read-only numeric under
    # the declared name; without one, instance reads of `tag` are rejected.
    btt5: st.reg.typetypeOf typeId: bt
    isSum: false
    if btt5 == ztypes.ztypetype.variantType then isSum = true
    if btt5 == ztypes.ztypetype.unionType then isSum = true
    if isSum when (taggedRecvIsValue :ast :st n: (ast.nodes.get i: dp.parent.u64)) then {
        tagHit: false
        {
            tan5: st.typing.tagAccessorName.get key: bt
            match (
                tan5
            ) case some then {
                if tan5 == cnId then tagHit = true
            } case none then null
        }
        if tagHit then {
            if st.typing.inAssignTarget then {
                mro5: "'\{cn}' is read-only — the tag accessor cannot be assigned"
                en5: String
                eh5: String
                (addErrorH
                    :st
                    nodeid: dp.nid
                    lineno: dp.lineno
                    colno: dp.colno
                    e: zast.err.typeError
                    msg: mro5
                    note: en5
                    hint: eh5
                    width: cn.length.u32.orPanic
                )
                return (callleg handled: true tid: (ztypes.tid.create from: 0))
            }
            tat5: optTidOr o: (st.typing.tagAccessorTid.get key: bt) d: ztypes.tid
            if tat5 > 0 then {
                st.typing.dpTagRead.set key: dp.nid.u64 value: bt
                mD5: (declMemberOf
                    :st

                    ownerTid: bt
                    nameId: cnId
                )
                stampRefDecl :st nid: dp.nid.u64 declId: mD5
                stampGate :st nid: dp.nid.u64 tid: (ztypes.tid.create from: tat5.u64)
                return (callleg handled: true tid: (ztypes.tid.create from: tat5))
            }
        }
        if cn == "tag" then {
            btn5: st.reg.nameOf tid: bt
            mnx5: "tag not exposed on '\{btn5}' — declare it in the as block (eg. `tag: u8.tag`)"
            en6: String
            eh6: String
            (addErrorH
                :st
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.typeError
                msg: mnx5
                note: en6
                hint: eh6
                width: cn.length.u32.orPanic
            )
            return (callleg handled: true tid: (ztypes.tid.create from: 0))
        }
    }
    return (callleg handled: false tid: (ztypes.tid.create from: 0))
}
# unitMemberEffectiveName -- the name a unit-qualified member actually resolves
# under. From ANOTHER unit a public alias translates to the internal def it
# exposes, and a private (unlisted) definition is rejected: E0101 and an empty
# answer, which leaves the path untyped.
unitMemberEffectiveName: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    dp: dpref
    bt: ztypes.tid
    cn: StringView
    un: StringView
} out String is {
    # public-interface visibility: from ANOTHER unit, translate a public
    # alias to the internal def it exposes, and reject a reference to a
    # private (unlisted) definition (E0101). Same-unit refs use declared
    # names and are never restricted.
    effUcn: cn.string
    # the unit a dotted base names, by id: two units may share a spelling,
    # so the DECLARATION that minted the unit type is the identity here
    btUd: declOfTypeId :st tid: bt
    if (st.typing.privacySeen) when btUd != unitDecl then {
        aliasHitU: false
        if st.typing.renameSeen then {
            intU: (declPublicAliasInternal
                :st

                pool: ast.names
                tid: bt
                name: cn
            )
            if intU.length > 0 then {
                (st.typing.setAliasInternalName
                    nodeid: dp.nid
                    internalName: intU.stringView
                )
                effUcn = intU.copy
                aliasHitU = true
            }
        }
        if (aliasHitU) == false when (declMemberIsPrivate
            :st

            tid: bt
            nameId: (ast.names.find s: cn)
        ) then {
            ucnid: nodeId n: (ast.nodes.get i: dp.child.u64)
            ucln: nodeLine n: (ast.nodes.get i: dp.child.u64)
            uccl: nodeCol n: (ast.nodes.get i: dp.child.u64)
            (addErrorH
                :st
                nodeid: ucnid
                lineno: ucln
                colno: uccl
                e: zast.err.notPublic
                msg: "'\{cn}' is not public on unit '\{un}'"
                note: "".string
                hint: "".string
                width: cn.length.u32.orPanic
            )
            return "".string
        }
    }
    return effUcn
}
# reportUnknownUnitMember -- `unit.name` naming nothing the unit declares. The hint
# separates a typo (a near-miss suggestion) from a member that exists but is not
# in the unit's public interface.
reportUnknownUnitMember: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    dp: dpref
    bt: ztypes.tid
    cn: StringView
    un: StringView
} is {
    m3: "unit '\{un}' has no member '\{cn}'"
    sug3: suggestSimilar :ast :st parentTypeId: bt name: cn
    h3: String
    if sug3.length > 0 then {
        hh3: "did you mean '\{sug3}'?"
        h3 = hh3
    }
    if (declMemberIsPrivate
        :st

        tid: bt
        nameId: (ast.names.find s: cn)
    ) then {
        hp3: "'\{cn}' is private (not in the public interface)"
        h3 = hp3
    }
    en3: String
    cnid3: nodeId n: (ast.nodes.get i: dp.child.u64)
    cnln3: nodeLine n: (ast.nodes.get i: dp.child.u64)
    cncl3: nodeCol n: (ast.nodes.get i: dp.child.u64)
    (addErrorH
        :st
        nodeid: cnid3
        lineno: cnln3
        colno: cncl3
        e: zast.err.typeError
        msg: m3
        note: en3
        hint: h3
        width: cn.length.u32.orPanic
    )
}
# checkUnitMemberValue -- a resolved `unit.member` in value position. The definition
# is walked where it is demanded, a no-arg FUNCTION member auto-calls, a TYPE
# member constructs like a bare atom, and the declaration is stamped so
# go-to-definition can find the unit it lives in.
checkUnitMemberValue: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    cn: StringView
    un: StringView
    memberDecl: u64
    coerce: bool
} out ztypes.tid is {
    result: memberDecl
    # `unit.member` resolved, so the definition it names is reachable
    # from here: walk it where it is demanded, in whatever unit it lives.
    walkDefinitionById :st :ast tid: (ztypes.tid.create from: memberDecl.u64)
    isFn: false
    if (st.reg.typetypeOf typeId: (ztypes.tid.create from: memberDecl.u64)) == ztypes.ztypetype.functionType then isFn = true
    if coerce when isFn then {
        if (st.typing.suppressFnAutoCall) == false when (fnAutoCallable
            :st
            mid: (ztypes.tid.create from: memberDecl.u64)
        ) == false then {
            ufl: nodeLine n: (ast.nodes.get i: dp.child.u64)
            ufc: nodeCol n: (ast.nodes.get i: dp.child.u64)
            (bareFnRefError
                :ast
                :st
                nodeid: dp.nid
                lineno: ufl
                colno: ufc
                width: cn.length.u32.orPanic
                fid: (ztypes.tid.create from: memberDecl.u64)
            )
        }
        if (st.typing.suppressFnAutoCall) == false when (fnAutoCallable
            :st
            mid: (ztypes.tid.create from: memberDecl.u64)
        ) then {
            ro: methodReturnOf :st mid: (ztypes.tid.create from: memberDecl.u64)
            match (
                ro
            ) case some then {
                result = ro
            } case none then {
                result = st.typing.nullTypeId
            }
        }
    }
    # a unit-qualified TYPE member in value position is the same
    # zero-argument construction as a bare atom (`p: unit.Conf`);
    # the name gate keeps value aliases out, the suppress flag
    # keeps dotted-path bases out
    if coerce when (isFn) == false then {
        if (st.typing.suppressBareCtor) == false then {
            tnd: st.reg.nameOf tid: (ztypes.tid.create from: memberDecl.u64)
            if tnd.stringView == cn then {
                cdl: nodeLine n: (ast.nodes.get i: dp.child.u64)
                cdc: nodeCol n: (ast.nodes.get i: dp.child.u64)
                if (isImplicitZeroCreateTid
                    :ast
                    :st
                    tid: (ztypes.tid.create from: memberDecl.u64)
                ) then {
                    icd: memberDecl
                    st.typing.implicitCreate.set key: dp.nid.u64 value: icd
                } else {
                    (checkBareTypeValueAt
                        :ast
                        :st
                        nodeid: dp.nid
                        lineno: cdl
                        colno: cdc
                        width: cn.length.u32.orPanic
                        tid: (ztypes.tid.create from: memberDecl.u64)
                    )
                }
            }
        }
    }
    setu: result
    stampGate :st nid: dp.nid.u64 tid: (ztypes.tid.create from: setu.u64)
    # record the resolved declaration so go-to-definition on a
    # unit-qualified `unit.member` can locate its defining unit.
    udD: ztypes.declid
    udR: (st.typing.declFindChild
        parentDeclId: st.typing.programRoot
        nameId: (nameIdOf :ast name: un)
    )
    if (udR.isZero) == false then {
        cnRef: zast.poolFind pool: ast.names text: cn
        udD = st.typing.declFindChild parentDeclId: udR nameId: cnRef
    }
    if udD.isZero then udD = (declOfTypeId
        :st
        tid: (ztypes.tid.create from: memberDecl.u64)
    )
    stampRefDecl :st nid: dp.nid.u64 declId: udD
    return (ztypes.tid.create from: result)
}
# checkUnitQualifiedMember -- `io.stdout`: the member resolves in that unit's
# namespace, under the name the public interface exposes it by. Answers
# handled: false when the base is not a unit type at all.
checkUnitQualifiedMember: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cn: StringView
    coerce: bool
} out callleg is {
    # a unit-qualified member (`io.stdout`): the member resolves in that
    # unit's namespace; a no-arg FUNCTION member auto-calls in value
    # position (its return is the path's value).
    if (st.reg.typetypeOf typeId: bt) == ztypes.ztypetype.unitType then {
        un: st.reg.nameOf tid: bt
        # the unit a dotted base names, by id: two units may share a spelling,
        # so the DECLARATION that minted the unit type is the identity here
        btUd: declOfTypeId :st tid: bt
        effUcn: (unitMemberEffectiveName
            :st
            :unitDecl
            :ast
            :dp
            :bt
            :cn
            un: un.stringView
        )
        if effUcn.length == 0 then return (callleg handled: true tid: (ztypes.tid.create from: 0))
        memberDecl: (unitMemberTypeOf
            :st
            :ast

            unitTid: bt
            unitDecl: btUd
            member: effUcn.stringView
        )
        # A hidden subunit is private to its parent BY DEFAULT: it is read
        # only because the parent named it, so it was never declared surface.
        # A `public:` block is the one visibility mechanism -- when the unit
        # has one, the block decides (declMemberIsPrivate above), and a
        # subunit listed there is public.
        if (isSubunitMemberOf :st :ast unitTid: bt member: memberDecl) then {
            pubU: publicNsOf :st tid: bt
            if btUd != unitDecl when pubU.isZero then {
                sbl: nodeLine n: (ast.nodes.get i: dp.child.u64)
                sbc: nodeCol n: (ast.nodes.get i: dp.child.u64)
                (addErrorH
                    :st
                    nodeid: (nodeId n: (ast.nodes.get i: dp.child.u64))
                    lineno: sbl
                    colno: sbc
                    e: zast.err.notPublic
                    msg: "'\{cn}' is an implementation subunit of '\{un}' and is private to it"
                    note: "a subunit is loaded only because its own unit named it".string
                    hint: "reach it through a definition '\{un}' exposes"
                    width: cn.length.u32.orPanic
                )
                return (callleg handled: true tid: (ztypes.tid.create from: 0))
            }
        }
        match (
            memberDecl
        ) case some then {
            return (callleg handled: true tid: (checkUnitMemberValue
                :st
                :ast
                :dp
                :cn
                un: un.stringView
                :memberDecl
                :coerce
            ))
        } case none then {
            reportUnknownUnitMember :st :ast :dp :bt :cn un: un.stringView
            return (callleg handled: true tid: (ztypes.tid.create from: 0))
        }
    }
    return (callleg handled: false tid: (ztypes.tid.create from: 0))
}
# checkDataBlockMember -- `.index` and `.array` on a data block. Both need the
# block's static array kept by the emitter (label accesses fold to constants);
# `.array` additionally copies the elements into the sized array instance
# (array_{elem}_{count}), minting it on first access.
checkDataBlockMember: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cn: StringView
} out callleg is {
    # `.index` / `.array` on a data block need its static array emitted (label
    # accesses fold to constants); mark the type so the emitter keeps the array.
    if (st.reg.typetypeOf typeId: bt) == ztypes.ztypetype.dataType then {
        if cn == "index" then {
            markDataRuntimeIndexed :st tid: bt
            sedi: dataElemTypeOf :ast :st :unitDecl dataTid: bt
            if sedi > 0 then {
                stampGate :st nid: dp.nid.u64 tid: sedi
                return (callleg handled: true tid: sedi)
            }
        }
        if cn == "array" then markDataRuntimeIndexed :st tid: bt
    }
    # `.array` on a data block copies the elements into the sized array
    # instance (array_{elem}_{count}), minting it on first access. The
    # element type rides the data's `tag__{elem}` tag-child name.
    if cn == "array" then {
        if (st.reg.typetypeOf typeId: bt) == ztypes.ztypetype.dataType then {
            (forceMemberOf :st frame: st.curFrame :ast parentTypeId: bt nameId: zast.names.wkTag)
            tgo: st.typing.declChildOfId parentTypeId: bt nameId: zast.names.wkTag
            match (
                tgo
            ) case some then {
                tagn: st.reg.nameOf tid: (ztypes.tid.create from: tgo.u64)
                eno: tagn.stringView.stripPrefix p: "tag__"
                match (
                    eno
                ) case some then {
                    den: eno
                    elo: (walkLookupTyperef
                        :st
                        frame: st.curFrame
                        :ast

                        :unitDecl
                        base: den
                    )
                    match (
                        elo
                    ) case some then {
                        ecnt: (st.typing.declMemberCount ownerTid: bt) - 1
                        ato: (walkLookupTyperef
                            :st
                            frame: st.curFrame
                            :ast

                            :unitDecl
                            base: "array"
                        )
                        match (
                            ato
                        ) case some then {
                            amn: "_\{den}_\{ecnt}"
                            # `array` declares its element parameter then its
                            # count; asking the template for both names keeps
                            # this site correct across a rename. Two names or
                            # the leg declines: a zero key is the ELIDED key,
                            # and getOrMintSpec rebinds that to the FIRST
                            # parameter -- which would bind the count to the
                            # element slot.
                            aNames: (st.reg.genericParamNamesOf
                                tdecl: (declOfTypeId
                                    :st
                                    tid: (ztypes.tid.create from: ato.u64)
                                )
                            )
                            if aNames.length < 2 then {
                                return (callleg
                                    handled: false
                                    tid: (ztypes.tid.create from: 0)
                                )
                            }
                            asubs: (IdMapV zast.nameid v: u64)
                            sv0: elo
                            asubs.set key: (aNames.get i: 0) value: sv0
                            vsE: (IdMapV zast.nameid v: u64)
                            vsE.set key: (aNames.get i: 1) value: ecnt
                            amid: (getOrMintSpec
                                :st
                                frame: st.curFrame
                                :ast

                                :unitDecl
                                sfx: amn.stringView
                                templateId: (ztypes.tid.create from: ato.u64)
                                subs: asubs
                                valSubs: vsE
                                fallbackArg: 0
                            )
                            (mintCollectionChildren
                                :st
                                frame: st.curFrame
                                :ast

                                monoId: amid
                                templateId: (ztypes.tid.create from: ato.u64)
                                elemArg: elo
                                valArg: ztypes.tid
                            )
                            setar: amid
                            stampGate :st nid: dp.nid.u64 tid: setar
                            return (callleg handled: true tid: amid)
                        } case none then null
                    } case none then null
                } case none then null
            } case none then null
        }
    }
    return (callleg handled: false tid: (ztypes.tid.create from: 0))
}
# checkArrayIndexMember -- a compile-time numeric index on an array instance
# projects the element type (`a.0` reads / reassigns element zero).
checkArrayIndexMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cn: StringView
} out callleg is {
    # A compile-time numeric index on an array instance projects the element
    # type (`a.0` reads / reassigns element zero).
    if (isNumericLiteralName name: cn) then {
        isArr: false
        bga8: ztypes.tid
        {
            bgo8: st.reg.genericOriginOf tid: bt
            if bgo8 > 0 then bga8 = bgo8
        }
        if bga8 > 0 then {
            gn8: st.reg.nameOf tid: (ztypes.tid.create from: bga8.u64)
            if gn8.stringView == "array" then isArr = true
        }
        if isArr then {
            (forceMemberOf :st frame: st.curFrame :ast parentTypeId: bt nameId: zast.names.wkGet)
            go8: st.typing.declChildOfId parentTypeId: bt nameId: zast.names.wkGet
            match (
                go8
            ) case some then {
                ro8: methodReturnOf :st mid: (ztypes.tid.create from: go8.u64)
                match (
                    ro8
                ) case some then {
                    seta8: ro8
                    stampGate :st nid: dp.nid.u64 tid: seta8
                    return (callleg handled: true tid: ro8)
                } case none then null
            } case none then null
        }
    }
    return (callleg handled: false tid: (ztypes.tid.create from: 0))
}
# checkDropMarkerVar -- `.drop` on a name in scope. Answers true when the drop
# is blocked (and the error is already reported), so the caller leaves the
# ownership transfer unrecorded.
checkDropMarkerVar: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    dp: dpref
    cn: StringView
    mkRoot: StringView
    blocked: bool
} out bool is {
    relBlocked: blocked
    if (isDropMarker name: cn) then {
        rpath: (ListVal zast.nameid)
        rpath.append (nameIdOf :ast name: mkRoot)
        elh: st.findExclusiveLock path: rpath
        match (
            elh
        ) case some then {
            relBlocked = true
            ahn: st.formatLockHolder pool: ast.names holder: elh
            macc: "Cannot access: '\{mkRoot}' has exclusive lock held by '\{ahn}'"
            ahint: String
            if elh.kind == ztypes.zlockholderkind.varKind then {
                ahint = "read through '\{ahn}' instead, or end '\{ahn}'s scope first to release the lock"
            }
            aen: String
            aid: nodeId n: (ast.nodes.get i: dp.parent.u64)
            aln: nodeLine n: (ast.nodes.get i: dp.parent.u64)
            acl: nodeCol n: (ast.nodes.get i: dp.parent.u64)
            (addErrorH
                :st
                nodeid: aid
                lineno: aln
                colno: acl
                e: zast.err.ownerError
                msg: macc
                note: aen
                hint: ahint
                width: mkRoot.length.u32.orPanic
            )
        } case none then null
        rlk: st.findLock nameId: (nameIdOf :ast name: mkRoot)
        match (
            rlk
        ) case some then {
            relBlocked = true
            rhn: String
            rlhh: st.findLockHolder nameId: (nameIdOf :ast name: mkRoot)
            match (
                rlhh
            ) case some then {
                rhn = st.formatLockHolder pool: ast.names holder: rlhh
            } case none then null
            lsn: zenv.zlockstateNameLower t: rlk
            mrel: "Cannot drop '\{mkRoot}': \{lsn} lock held by '\{rhn}'"
            (addError
                :st
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.ownerError
                msg: mrel
            )
        } case none then null
    }
    return relBlocked
}
# checkMoveMarkerVar -- `.take` on a name in scope: readonly first (a `view`
# parameter is both readonly and pinned), then pinned, then borrowed. Answers true
# when the move is blocked, so the caller leaves the transfer unrecorded.
checkMoveMarkerVar: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    dp: dpref
    cn: StringView
    mkRoot: StringView
    mvo: ztypes.vid
} out bool is {
    relBlocked: false
    if (isMoveMarker name: cn) then {
        # Readonly first: a `view` parameter is both readonly and
        # non-owned, and readonly is the rule the author has to
        # satisfy. A `hold` binding IS owned, so only this leg
        # catches it -- moving it out would thaw a frozen cell.
        if (nameIsReadonly :st :ast name: mkRoot) then {
            relBlocked = true
            tvb: "with '.\{cn}'"
            (readonlyMoveError
                :st
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                name: mkRoot
                verb: tvb.stringView
            )
        }
        if (relBlocked) == false then {
            tpv: "with '.\{cn}'"
            if (pinnedMoveError
                :st
                :ast
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                name: mkRoot
                verb: tpv.stringView
            ) then relBlocked = true
        }
        if (relBlocked) == false when (isBorrowedVar :st vid: mvo) then {
            relBlocked = true
            mtb: "Cannot move borrowed variable '\{mkRoot}' with '.take' — borrowed names stay bound to their source for the full scope; copy with '.copy' to keep the source"
            (addError
                :st
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.ownerError
                msg: mtb
            )
        }
    }
    return relBlocked
}
# checkUnresolvedMember -- the member did not resolve on the base type. `.copy` is
# an ownership primitive rather than a constrained member, so a generic-param
# receiver still types it t -> t; everything else is diagnosed here.
checkUnresolvedMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cn: StringView
    cnId: zast.nameid
} out ztypes.tid is {
    if (st.reg.typetypeOf typeId: bt) == ztypes.ztypetype.genericParam then {
        # `.copy` is an ownership primitive, not a constrained member:
        # every instantiation copies, so a generic-param receiver types
        # it t -> t (the per-instance clone emits the concrete copy).
        if cn == "copy" then {
            stampGate :st nid: dp.nid.u64 tid: bt
            return bt
        }
        btn9x: st.reg.nameOf tid: bt
        mgp: "type parameter '\{btn9x}' has no member '\{cn}' (its constraint provides none)"
        (addError
            :st
            nodeid: dp.nid
            lineno: dp.lineno
            colno: dp.colno
            e: zast.err.genericError
            msg: mgp
        )
    }
    cpleg: checkCopyMember :st :ast :dp :bt :cn
    if cpleg.handled then return cpleg.tid
    # `.view` marks a parameter type and is never a value member. The
    # strict unknown-member check says so, but a generic instance is
    # lenient there, so unstamped it reached the emitter as an unhandled
    # binding (E0500, no location) -- diagnose it on every base.
    if cn == "view" when st.typing.suppressParamStamps == false then {
        btnVw: st.reg.nameOf tid: bt
        mVw: "type '\{btnVw}' has no member 'view'"
        cnidVw: nodeId n: (ast.nodes.get i: dp.child.u64)
        cnlnVw: nodeLine n: (ast.nodes.get i: dp.child.u64)
        cnclVw: nodeCol n: (ast.nodes.get i: dp.child.u64)
        (addErrorH
            :st
            nodeid: cnidVw
            lineno: cnlnVw
            colno: cnclVw
            e: zast.err.typeError
            msg: mVw
            note: "'.view' marks a parameter type readonly; a value cannot be viewed".string
            hint: "".string
            width: cn.length.u32.orPanic
        )
        return (ztypes.tid.create from: 0)
    }
    reportUnknownMember :st :ast :dp :bt :cn :cnId
    return (ztypes.tid.create from: 0)
}
# checkResolvedMember -- the member resolved on the base type. Stamps the owner for
# tooling and the emitter, then runs the legs in order: tagged-type construction
# or arm predicate, the as-const clone, the projection legs, the auto-call, and
# finally the public-interface gate.
checkResolvedMember: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cn: StringView
    cnId: zast.nameid
    mo: u64
    coerce: bool
    aliasViaX: bool
} out ztypes.tid is {
    # member-owner stamp: the use-site dotted path resolved a member of
    # `bt` (field, method, or tagged arm). Tooling reads the member's
    # declaration for go-to-definition; the emitter derives the owner
    # from it to gate the numeric-cast leg (a scalar-named member of a
    # user type is not a conversion).
    if dp.nid > 0 when bt > 0 then {
        mD: (declMemberOf
            :st

            ownerTid: bt
            nameId: cnId
        )
        stampRefDecl :st nid: dp.nid.u64 declId: mD
    }
    tgleg: (checkTaggedMemberPath
        :st
        :unitDecl
        :ast
        :dp
        :bt
        :cn
        :mo
        :aliasViaX
    )
    if tgleg.handled then return tgleg.tid
    if (st.typing.isAsConstClone typeId: (ztypes.tid.create from: mo.u64)) then {
        setcc: mo
        stampGate :st nid: dp.nid.u64 tid: (ztypes.tid.create from: setcc.u64)
        return (ztypes.tid.create from: mo)
    }
    rm: mo
    result: ztypes.tid
    result = ztypes.tid.create from: rm.u64
    prleg: (checkMemberProjections
        :st
        :ast
        :dp
        :bt
        :cn
        :cnId
        :mo
        :rm
        :coerce
    )
    if prleg.handled then return prleg.tid
    # A member DECLARED as a method but materialised as a plain scalar --
    # a collection's `length`/`capacity`, which emit as a struct field read
    # -- resolves to its RETURN type, so everything keyed on "is this a
    # method?" skipped it, the auto-call receiver lock included. It is still
    # a call, and collapsing is only sound for a READ of the receiver, so it
    # takes the SHARED lock a reader takes. Without this `xs.length` inside
    # an exclusively-pinned iteration was accepted while `xs.contains item:
    # x` beside it was refused -- both readers, and under the locking model
    # a reader takes SHARED for its duration.
    if coerce when (st.reg.typetypeOf typeId: (ztypes.tid.create from: mo.u64)) != ztypes.ztypetype.functionType then {
        if (st.typing.declIsMethodId
            parentTypeId: bt
            nameId: cnId
        ) then {
            lockAutoCallReceiver :ast :st :dp :bt shared: true
        }
    }
    result = (checkMemberAutoCall
        :st
        :ast
        :dp
        :bt
        :cn
        :mo
        :coerce
        result0: result
    )
    reportPrivateMember :st :ast :dp :bt :cn :aliasViaX
    stampGate :st nid: dp.nid.u64 tid: result
    return result
}
# checkMarkerMember -- the access and conversion markers a dotted path can name
# instead of a member: `.private` / `.public` / `.lock` carry the base's own type,
# `.stringView` and `.str` convert between the two string forms, and `.borrow` is
# an ownership marker except on a protocol / facet / typedef-wrapper receiver,
# where it is a projection callable.
checkMarkerMember: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cn: StringView
} out callleg is {
    # `.private` / `.public` access markers: the path carries the base's
    # type (the access view is a dump-filtered shell, not a member).
    if cn == "private" then {
        # Gate B: a `.private` view may only be produced from a base that
        # already holds private access -- the type's own `this`/same-type
        # receiver (the class minting it), or an existing `.private` handle (a
        # friend forwarding what it was given, per spec). External code holding
        # only a public value cannot mint one -- E0102.
        baseGN: ast.nodes.get i: dp.parent.u64
        if (baseIsPrivateCapable :st :ast :bt baseNode: baseGN) == false then {
            pcNode: ast.nodes.get i: dp.child.u64
            pcnid: nodeId n: pcNode
            pcln: nodeLine n: pcNode
            pccl: nodeCol n: pcNode
            btNm: st.reg.nameOf tid: bt
            pmsg: "'.private' of '\{btNm}' may only be taken by '\{btNm}' or a holder of its '.private' handle"
            (addErrorH
                :st
                nodeid: pcnid
                lineno: pcln
                colno: pccl
                e: zast.err.privateEscape
                msg: pmsg
                note: "".string
                hint: "".string
                width: cn.length.u32.orPanic
            )
        }
        setpv: bt
        stampGate :st nid: dp.nid.u64 tid: setpv
        return (callleg handled: true tid: bt)
    }
    if cn == "public" then {
        setpb: bt
        stampGate :st nid: dp.nid.u64 tid: setpb
        return (callleg handled: true tid: bt)
    }
    if cn == "lock" then {
        setlk: bt
        stampGate :st nid: dp.nid.u64 tid: setlk
        return (callleg handled: true tid: bt)
    }
    # `.stringView` on a StringView is an identity no-op and is rejected --
    # the value is already a StringView.
    if (isStringViewMember name: cn) then {
        if bt == (builtinTidTc :ast :st base: "StringView") then {
            msv: "redundant conversion: '.stringView' on a StringView".string
            nsv: "the value is already a StringView".string
            hsv: "drop '.stringView'".string
            (addErrorH
                :st
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.typeError
                msg: msv
                note: nsv
                hint: hsv
                width: cn.length.u32.orPanic
            )
            return (callleg handled: true tid: (ztypes.tid.create from: 0))
        }
    }
    # `.str` on String/StringView/str bases is the sized-conversion form:
    # the path resolves to the str TEMPLATE (unstamped -- the call check
    # mints the sized instance and stamps only the Call node).
    if cn == "str" then {
        isStrBase: false
        if bt == (builtinTidTc :ast :st base: "String") then isStrBase = true
        if bt == (builtinTidTc :ast :st base: "StringView") then isStrBase = true
        if (isStrBase) == false then {
            bga: u64
            {
                bgo: st.reg.genericOriginOf tid: bt
                if bgo > 0 then bga = bgo
            }
            if bga > 0 then {
                if bga == (builtinTidTc :ast :st base: "str") then isStrBase = true
            }
        }
        if isStrBase then {
            sto: walkLookupTyperef :st frame: st.curFrame :ast :unitDecl base: "str"
            match (
                sto
            ) case some then {
                return (callleg handled: true tid: (ztypes.tid.create from: sto))
            } case none then null
        }
    }
    if cn == "borrow" then {
        # Protocol/facet `.borrow` and a typedef wrapper's FUNCTION borrow
        # child are projection callables, not ownership markers.
        btt1: st.reg.typetypeOf typeId: bt
        isMk: true
        if btt1 == ztypes.ztypetype.protocolType then isMk = false
        if btt1 == ztypes.ztypetype.facetType then isMk = false
        if isMk then {
            (forceMemberOf
                :st
                frame: st.curFrame
                :ast
                parentTypeId: bt
                nameId: zast.names.wkBorrow
            )
            bco: st.typing.declChildOfId parentTypeId: bt nameId: zast.names.wkBorrow
            bcid: optU64Or o: bco d: 0
            if bcid > 0 then {
                if (st.reg.typetypeOf typeId: (ztypes.tid.create from: bcid.u64)) == ztypes.ztypetype.functionType then isMk = false
            }
        }
        if isMk then {
            setbw: bt
            stampGate :st nid: dp.nid.u64 tid: setbw
            return (callleg handled: true tid: bt)
        }
    }
    return (callleg handled: false tid: (ztypes.tid.create from: 0))
}
# isNativeFnTid -- the tid is a FUNCTION type whose body the compiler supplies.
# Two questions, not one: a native TYPE (String, a container) is not a native
# function, and a bodied function is not native.
isNativeFnTid: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    if (st.reg.typetypeOf typeId: tid) == ztypes.ztypetype.functionType then {
        return (st.reg.isNativeOf :tid)
    }
    return false
}

# checkTransferMarker -- `.take` / `.drop` are ownership transfer markers, not
# members. The path carries the base's type; a bare-name source releases its held
# locks and invalidates (the taken overlay propagates out of popped scopes).
checkTransferMarker: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cn: StringView
} out callleg is {
    # `.take` / `.drop`: ownership transfer markers, not members. The path
    # carries the base's type; a bare-name source releases its held locks and
    # invalidates (the taken overlay propagates out of popped scopes).
    isXferMarker: false
    if (isMoveMarker name: cn) then isXferMarker = true
    if (isDropMarker name: cn) then isXferMarker = true
    if isXferMarker then {
        # a native has no reference form. The compiler supplies the body, and an
        # inlined one -- a binop, a conversion -- has no C function whose address
        # there is to take; even a fragment-backed one was not referenced but
        # CALLED, and typed by a function typedef that was never written. That
        # left the C compiler reporting a mangled name for a mistake in the path.
        if (isMoveMarker name: cn) when (isNativeFnTid :st tid: bt) then {
            pth: dottedRootName :ast n: (ast.nodes.get i: dp.parent.u64)
            mnm: dottedChildName :ast n: (ast.nodes.get i: dp.parent.u64)
            pth.append "."
            pth.append mnm
            mnr: "'\{pth.stringView}' is native and has no reference form"
            (addError
                :st
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.callError
                msg: mnr
            )
            stampGate :st nid: dp.nid.u64 tid: bt
            return (callleg handled: true tid: bt)
        }
        # `.drop` is a statement, not a value: it ends a lifetime and hands
        # back nothing, so a binding, an argument or an operand has nothing to
        # take from it. Legal only on the node that IS the statement.
        if (isDropMarker name: cn) when dp.nid.u64 != st.typing.stmtExprNid then {
            mvs: "'.drop' is a statement, not a value -- it ends a lifetime and produces nothing; use '.take' to move the value into a new name".string
            (addError
                :st
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.ownerError
                msg: mvs
            )
        }
        mkRootId: bareAtomNameId :ast n: (ast.nodes.get i: dp.parent.u64)
        if (isDropMarker name: cn) when mkRootId.isZero then {
            mrv: "'.drop' can only be applied to a variable name".string
            (addError
                :st
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.ownerError
                msg: mrv
            )
        }
        if (mkRootId.isZero) == false then {
            mvo: st.lookupVarId nameId: mkRootId
            match (
                mvo
            ) case some then {
                mkRoot: zast.nameTextAt :ast ref: mkRootId
                relBlocked: (checkMoveMarkerVar
                    :st
                    :ast
                    :dp
                    :cn
                    mkRoot: mkRoot.stringView
                    :mvo
                )
                relBlocked = (checkDropMarkerVar
                    :st
                    :ast
                    :dp
                    :cn
                    mkRoot: mkRoot.stringView
                    blocked: relBlocked
                )
                if (relBlocked) == false then {
                    mh: (ztypes.zlockholder kind: ztypes.zlockholderkind.varKind id: mvo)
                    st.releaseHeldLocks holder: mh
                    st.invalidate nameId: mkRootId loc: takenHere
                }
            } case none then {
                if (isDropMarker name: cn) then {
                    dfo: (walkLookupTyperefById
                        :st
                        frame: st.curFrame
                        :ast
                        :unitDecl
                        baseId: mkRootId
                    )
                    match (
                        dfo
                    ) case some then {
                        mkRoot: zast.nameTextAt :ast ref: mkRootId
                        mtl: "Cannot drop top-level definition '\{mkRoot}'"
                        (addError
                            :st
                            nodeid: dp.nid
                            lineno: dp.lineno
                            colno: dp.colno
                            e: zast.err.ownerError
                            msg: mtl
                        )
                    } case none then null
                }
            }
        }
        setmk: bt
        stampGate :st nid: dp.nid.u64 tid: setmk
        return (callleg handled: true tid: bt)
    }
    return (callleg handled: false tid: (ztypes.tid.create from: 0))
}
# checkNumericSuffixCast -- `1.u8` / `(2.5).f32`: when the child names a non-
# function type and the parent is a numeric literal, the path is a typed-literal
# cast -- the parent atom coerces to the suffix type and the path carries it.
# checkLiteralFits -- does literal `lit` fit `target`? A literal conversion is
# settled at COMPILE time: it either fits, or it is an error here. A
# declaration can say which conversions exist but not that 300 is too big for a
# u8, so this stays even though dispatch moved to the declared surface.
#
# Shared by the two places a suffixed literal is resolved -- inside a body and
# at unit level -- because a constant that skipped the check emitted a
# truncated value and only gcc's -Woverflow noticed.
checkLiteralFits: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    lit: StringView
    target: StringView
} is {
    if (isNumericTypeName name: target) == false then return
    # a character literal carries no numeric lexeme to parse
    if lit.startsWith "0c" then return
    nk9c: ztypes.numkindByName name: target
    pn9c: ztypes.parseNumberAs numstr: lit k: nk9c.kind
    if pn9c.err.length > 0 then {
        addError :st :nodeid :lineno :colno e: zast.err.typeError msg: pn9c.err
        return
    }
    if (ztypes.isFloatKind k: pn9c.kind) == false then return
    exact9c: true
    if lit.contains "." then {
        exact9c = ztypes.floatFitsFloat value: pn9c.fval k: pn9c.kind
    } else {
        ivp9c: ztypes.parseNumber numstr: lit
        ivr9c: ivp9c.ival.i64
        match (
            ivr9c
        ) case ok then {
            exact9c = ztypes.intFitsFloat value: ivr9c k: pn9c.kind
        } case err then {
            exact9c = false
        }
    }
    if (exact9c) == false then {
        em9c: "Value \{lit} not exactly representable as \{target}"
        addError :st :nodeid :lineno :colno e: zast.err.typeError msg: em9c
    }
}

# literalConvTarget -- the type a literal's declared conversion `nameId`
# produces, or none when the literal type does not declare it. The declaration
# holds the surface (`intliteral.u8` is `function {:this} out u8`), so the
# target is that method's return type; nothing here knows the sixteen names.
literalConvTarget: function {
    ast: Ast
    st: zenv.ZSymbolTable
    tid: ztypes.tid
    nameId: zast.nameid
} out optionval u64 is {
    if nameId.isZero then return (optionval.none u64)
    # DEMAND IT FIRST. Members materialise when something asks for them, so a
    # bare declChildOfId on a type nothing has reached yet answers none -- and
    # the literal types are reached by literals, not by name.
    (forceMemberOf :st frame: st.curFrame :ast parentTypeId: tid :nameId)
    co: st.typing.declChildOfId parentTypeId: tid :nameId
    match (
        co
    ) case some then {
        rt: methodReturnOf :st mid: (ztypes.tid.create from: co.u64)
        match (
            rt
        ) case some then {
            return (optionval.some rt.u64)
        } case none then null
    } case none then null
    return (optionval.none u64)
}

checkNumericSuffixCast: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
} out callleg is {
    # Numeric dotted suffix (`1.u8`, `(2.5).f32`): when the child names a
    # non-function type, the path is a typed-literal cast -- the parent atom
    # coerces to the suffix type and the path carries it. Parens around the
    # literal are the same conversion (peel expression wrappers).
    castBaseId: dp.parent
    pw9c: u64
    for pw9c < 2 loop {
        cbn: ast.nodes.get i: castBaseId.u64
        if cbn.expression then castBaseId = cbn.expression
        pw9c = pw9c + 1
    }
    castBaseNm: atomNameId :ast n: (ast.nodes.get i: castBaseId.u64)
    if (isNumericLiteralNameAt :ast ref: castBaseNm) then {
        castBase: zast.nameTextCopy :ast ref: castBaseNm
        castChildId: atomNameId :ast n: (ast.nodes.get i: dp.child.u64)
        # WHICH conversions a literal offers is a question for its DECLARATION:
        # `intliteral` names the sixteen it can reach and `floatliteral` only
        # the four float ones. The declared surface is EXHAUSTIVE for a numeric
        # suffix, so a numeric target the literal type does not declare is an
        # error here rather than a fall-through -- otherwise `3.5.u8` would
        # materialise to f64 and quietly become f64's runtime-checked `u8`.
        # A NON-numeric child does fall through: that is how `5.iterate` and
        # `1.0.scaleB` reach their member on the materialised receiver.
        litTid: st.reg.literalIntTid
        if (isFloatLiteralName name: castBase.stringView) then litTid = st.reg.literalFloatTid
        castOpt: literalConvTarget :ast :st tid: litTid nameId: castChildId
        if castOpt.none then {
            missChild: zast.nameTextAt :ast ref: castChildId
            if (isNumericTypeName name: missChild.stringView) then {
                ltn: st.reg.nameOf tid: litTid
                cm9: "'\{ltn}' has no conversion to '\{missChild}'"
                ch9: "a literal with a decimal point is a float: convert it to a float type, or write the value without a point".string
                cn9: String
                (addErrorH
                    :st
                    nodeid: dp.nid
                    lineno: dp.lineno
                    colno: dp.colno
                    e: zast.err.typeError
                    msg: cm9
                    note: cn9
                    hint: ch9
                    width: missChild.length.u32.orPanic
                )
                return (callleg handled: true tid: (ztypes.tid.create from: 0))
            }
        }
        match (
            castOpt
        ) case some then {
            castChild: zast.nameTextAt :ast ref: castChildId
            if (st.reg.typetypeOf typeId: (ztypes.tid.create from: castOpt.u64)) != ztypes.ztypetype.functionType then {
                # a compile-time-constant conversion is checked statically: a
                # lossy literal cast is an error (300.u8, 3.5.u8, an int beyond
                # a float's mantissa). Parse the base against the target kind
                # for range/float checks; add the int->float exact-mantissa check.
                (checkLiteralFits
                    :st
                    nodeid: dp.nid
                    lineno: dp.lineno
                    colno: dp.colno
                    lit: castBase.stringView
                    target: castChild.stringView
                )
                setcp: castOpt
                stampGate :st nid: dp.parent.u64 tid: (ztypes.tid.create from: setcp.u64)
                setcd: castOpt
                stampGate :st nid: dp.nid.u64 tid: (ztypes.tid.create from: setcd.u64)
                return (callleg handled: true tid: (ztypes.tid.create from: castOpt))
            }
        } case none then null
    }
    return (callleg handled: false tid: (ztypes.tid.create from: 0))
}
# dottedBaseTid -- type the base a dotted path hangs off. The base is a REFERENCE,
# so a name-shaped one must not construct and a `.take` child must not auto-call;
# an unresolved bare name may still be a unit, and a literal materialises to its
# concrete default before member lookup. 0 when the base types to nothing.
dottedBaseTid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
} out ztypes.tid is {
    # the base of a dotted path is a reference, not a bare value: a type
    # name there must not construct (Counter.create, unit.Type.arm). Only
    # name-shaped bases suppress -- an expression base walks normally so
    # atoms inside its args still stamp. A `.take` child makes the base a
    # function REFERENCE: the base walk must not auto-call it. Both shapes
    # are read through views scoped to this block: the base walk lends ast.
    baseIsName: false
    childIsTake: false
    {
        dpkN: ast.nodes.get i: dp.parent.u64
        if dpkN.atomid then baseIsName = true
        if dpkN.dottedpath then baseIsName = true
        tknm: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: dp.child.u64))
        if tknm.stringView == "take" then childIsTake = true
    }
    supPrev: st.typing.suppressBareCtor
    if baseIsName then st.typing.suppressBareCtor = true
    supFnPrev: st.typing.suppressFnAutoCall
    if childIsTake then st.typing.suppressFnAutoCall = true
    bt: checkValueAt :st :unitDecl :ast nid: dp.parent
    st.typing.suppressFnAutoCall = supFnPrev
    st.typing.suppressBareCtor = supPrev
    if bt.isZero then {
        # an unresolved bare-name base may be a unit-qualified member
        # path (io.stdout): the side map types the base as the UNIT type.
        ubn: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: dp.parent.u64))
        if ubn.length > 0 then {
            ubo: (declTypeIdOf
                :st
                declId: (st.typing.declFindChild
                    parentDeclId: st.typing.programRoot
                    nameId: (nameIdOf :ast name: ubn.stringView)
                )
            )
            if (ubo.isZero) == false then {
                bt = ztypes.tid.create from: ubo.u64
                ubp: dp.parent
                if ubp > 0 then {
                    setub: ubo
                    stampGate :st nid: ubp.u64 tid: (ztypes.tid.create from: setub.u64)
                }
            }
        }
        if bt.isZero then return (ztypes.tid.create from: 0)
    }
    # A literal base materialises before member lookup (`5.iterate` is
    # i64.iterate); the parent node restamps at the concrete default.
    if (isLiteralTypeId :st tid: bt) then {
        mbt: materialiseLiteral :ast :st :unitDecl t: bt
        if mbt != bt then {
            bt = mbt
            pid: dp.parent
            if pid > 0 then {
                setp: mbt
                stampGate :st nid: pid.u64 tid: setp
            }
        }
    }
    return bt
}


checkDotted: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    coerce: bool
} out ztypes.tid is {
    nsc: checkNumericSuffixCast :st :ast :dp
    if nsc.handled then return nsc.tid
    bt: dottedBaseTid :st :unitDecl :ast :dp
    if bt.isZero then return (ztypes.tid.create from: 0)
    cn: atomName :ast n: (ast.nodes.get i: dp.child.u64)
    if cn.length == 0 then return (ztypes.tid.create from: 0)
    cnId: atomNameId :ast n: (ast.nodes.get i: dp.child.u64)
    # a member of an INTERFACE that names the interface in a parameter has no
    # vtable slot, so this is where reaching for it is refused -- with the rule
    # rather than with whatever a conformer happened to be called
    if (refuseSelfTypedMember
        :st
        :ast
        recvTid: bt
        nameId: cnId
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
    ) then return (ztypes.tid.create from: 0)
    mkm: checkMarkerMember :st :unitDecl :ast :dp :bt cn: cn.stringView
    if mkm.handled then return mkm.tid
    xfm: checkTransferMarker :st :unitDecl :ast :dp :bt cn: cn.stringView
    if xfm.handled then return xfm.tid
    aix: checkArrayIndexMember :st :ast :dp :bt cn: cn.stringView
    if aix.handled then return aix.tid
    dbm: checkDataBlockMember :st :unitDecl :ast :dp :bt cn: cn.stringView
    if dbm.handled then return dbm.tid
    uqm: checkUnitQualifiedMember :st :unitDecl :ast :dp :bt cn: cn.stringView :coerce
    if uqm.handled then return uqm.tid
    # public-interface rename: from OUTSIDE the type, a public alias resolves
    # to the internal member it exposes (the internal name stays private,
    # enforced below). Same-object access (this / a .private handle) uses
    # declared names, so translate only when the base is not private-capable.
    aliasViaX: false
    intNmX: String
    {
        baseNodeX: ast.nodes.get i: dp.parent.u64
        if (st.typing.renameSeen) when (baseIsPrivateCapable
            :st
            :ast
            :bt
            baseNode: baseNodeX
        ) == false then {
            intNmX = (declPublicAliasInternal
                :st

                pool: ast.names
                tid: bt
                name: cn.stringView
            )
        }
    }
    if intNmX.length > 0 then {
        st.typing.setAliasInternalName nodeid: dp.nid internalName: intNmX.stringView
        cnId = ast.names.find s: intNmX.stringView
        cn = intNmX.copy
        aliasViaX = true
    }
    # a typedef member that isn't on the wrapper delegates to the base
    # (Bytes.append is List_u8.append).
    (forceMemberOf :st frame: st.curFrame :ast parentTypeId: bt nameId: cnId)
    tdw: st.typing.declChildOfId parentTypeId: bt nameId: cnId
    match (
        tdw
    ) case some then null case none then {
        tdd: typedefBaseTidOf :st tid: bt
        if tdd.isZero then {
            tdd = typedefBaseOf :st tid: bt
        }
        if tdd > 0 then bt = tdd
    }
    tacc: checkTagAccessor :st :ast :dp :bt cn: cn.stringView :cnId
    if tacc.handled then return tacc.tid
    # A cross-unit narrowed match-arm base can be a SHELL whose member
    # children are not registered (cross-unit demand mints a shell id distinct
    # from the canonical defining-unit id); on a member miss retarget the base
    # to a same-named type in another unit's resolved scope that has the member.
    (forceMemberOf :st frame: st.curFrame :ast parentTypeId: bt nameId: cnId)
    mo: st.typing.declChildOfId parentTypeId: bt nameId: cnId
    preHas: false
    match (
        mo
    ) case some then {
        preHas = true
    } case none then null
    if (preHas) == false then {
        udT: unitDeclOfTid :st tid: bt
        if udT.isZero then {
            cb: canonicalChildBase :ast :st :bt child: cn.stringView
            if cb > 0 then {
                bt = ztypes.tid.create from: cb.u64
                (forceMemberOf :st frame: st.curFrame :ast parentTypeId: bt nameId: cnId)
                mo = st.typing.declChildOfId parentTypeId: bt nameId: cnId
            }
        }
    }
    match (
        mo
    ) case some then {
        return (checkResolvedMember
            :st
            :unitDecl
            :ast
            :dp
            :bt
            cn: cn.stringView
            :cnId
            :mo
            :coerce
            :aliasViaX
        )
    } case none then {
        return (checkUnresolvedMember :st :ast :dp :bt cn: cn.stringView :cnId)
    }
}
# checkBareTypeValue -- a bare TYPE name in value position is zero-argument
# construction (`p: Point`), so a synthesized create's required fields are
# enforced here and an aliased container name resolves through its twin.
checkBareTypeValue: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    node: atomref
    fo: u64
} is {
    # only an atom NAMING the type is a bare construction; a
    # value alias typed as it (true: bool.true) is a value use.
    # The renamed-twin aliases name their type without
    # matching its registry name; a general typeref retry
    # cannot stand here because a VALUE alias also resolves
    # to its type's tid (`true` -> bool). The atom's text is
    # read through a view scoped to this block: the alias
    # test and the evaluator below lend ast.
    tnq: st.reg.nameOf tid: (ztypes.tid.create from: fo.u64)
    isTypeAtom: false
    {
        ndNm: zast.nameTextAt :ast ref: node.name
        isTypeAtom = tnq.stringView == ndNm.stringView
        if (isTypeAtom) == false then {
            twn: aliasedContainerTwin name: ndNm.stringView
            if twn.length > 0 when twn == tnq.stringView then isTypeAtom = true
        }
    }
    if (isTypeAtom) == false then {
        # an atom naming a TYPE alias constructs exactly as the
        # type's own name does. The tid cannot say so -- a VALUE
        # alias resolves to its root type's tid too -- but the
        # alias's own shape can. Without this the atom stays
        # unstamped and the emitter writes the alias name into
        # the C.
        aad: (declOfUnitDef
            :st
            frame: st.curFrame
            :unitDecl
            nameId: node.name
        )
        if (aliasNamesType
            :st

            :ast
            declId: aad
        ) then {
            # The alias test says TYPE; the CONSTANT gets to
            # overrule it. `ECHO: LIB` names a string
            # constant whose own type is StringView, so the
            # test above sees a decl carrying a type -- and a
            # bare StringView is an unconstructible view. A
            # definition with a compile-time value is a VALUE
            # alias, the case this leg's own comment names
            # for `true: bool.true`.
            # Asked SECOND, not first: the answer only
            # matters when the alias test said yes, and a
            # pull in front of it runs the evaluator for
            # every bare atom in every body. An owned copy of
            # the name: the evaluator lends ast.
            dn: zast.nameTextCopy :ast ref: node.name
            ecv: (constValueOfMember
                :st
                frame: st.curFrame
                :ast

                :unitDecl
                defName: dn.stringView
            )
            constFailClear :st
            if ecv.kind.none then isTypeAtom = true
        }
    }
    if isTypeAtom then {
        if (isImplicitZeroCreateTid
            :ast
            :st
            tid: (ztypes.tid.create from: fo.u64)
        ) then {
            icv: fo
            st.typing.implicitCreate.set key: node.nid.u64 value: icv
        } else {
            (checkBareTypeConstruction
                :st
                :ast
                :node
                tid: (ztypes.tid.create from: fo.u64)
            )
        }
    }
}

# typeOfBareName -- a bare name that is not a local: it names a TYPE, a unit, or a
# function. A no-arg non-generic FUNCTION name in value position is a call, and
# an aliased container name resolves through its twin. 0 when it names nothing.
typeOfBareName: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    node: atomref
} out ztypes.tid is {
    result: ztypes.tid
    fo: walkLookupTyperefById :st frame: st.curFrame :ast :unitDecl baseId: node.name
    match (
        fo
    ) case some then {
        result = ztypes.tid.create from: fo.u64
        # A bare no-arg non-generic FUNCTION name is a call: the
        # value is its return (an unregistered shell when out-less).
        isAutoFn: false
        if fo < st.reg.typeById.length then {
            fz: st.reg.typeById.get i: fo
            if fz.typetype == ztypes.ztypetype.functionType then {
                if (fz.isgeneric) == false then isAutoFn = true
            }
        }
        if isAutoFn when (st.typing.suppressFnAutoCall) == false then {
            if (fnAutoCallable
                :st
                mid: (ztypes.tid.create from: fo.u64)
            ) == false then {
                isAutoFn = false
                # the atom's width is read through a view scoped to this
                # block: the report below lends ast
                wdt: u32
                {
                    nm: zast.nameTextAt :ast ref: node.name
                    wdt = nm.length.u32.orPanic
                }
                (bareFnRefError
                    :ast
                    :st
                    nodeid: node.nid
                    lineno: node.lineno
                    colno: node.colno
                    width: wdt
                    fid: (ztypes.tid.create from: fo.u64)
                )
            }
        } else {
            isAutoFn = false
        }
        if isAutoFn then {
            ro: methodReturnOf :st mid: (ztypes.tid.create from: fo.u64)
            match (
                ro
            ) case some then {
                result = ro
            } case none then {
                result = ztypes.tid.create from: (st.typing.nullTypeId)
            }
        }
        if (st.typing.suppressBareCtor) == false then {
            (checkBareTypeValue
                :st
                :unitDecl
                :ast
                :node
                :fo
            )
        }
        setu: result
        stampGate :st nid: node.nid.u64 tid: setu
        # atom-use def reference: the DEF's declaration (nodeType
        # carries the auto-call RETURN type above, not the referent)
        sfF: (declSurfaceOfName
            :st

            :ast
            :unitDecl
            nameId: node.name
            tid: (ztypes.tid.create from: fo.u64)
        )
        stampRefDecl :st nid: node.nid.u64 declId: sfF
        maybeWalkMethodsById :st frame: st.curFrame :unitDecl :ast nameId: node.name
    } case none then null
    return result
}


# reportMissingReturnValue -- a bare `return` in a function that declares a
# value: reported at the atom.
reportMissingReturnValue: function {st: zenv.ZSymbolTable node: atomref} is {
    mrt: st.typing.currentReturnTypeId
    if mrt > 0 then {
        mtt: st.reg.typetypeOf typeId: mrt
        isVoidRet: false
        if mtt == ztypes.ztypetype.nullType then isVoidRet = true
        if mtt == ztypes.ztypetype.neverType then isVoidRet = true
        if (isVoidRet) == false then {
            rtn: st.reg.nameOf tid: mrt
            mm: "missing return value: function expects '\{rtn}'"
            en6: String
            eh6: String
            (addErrorH
                :st
                nodeid: node.nid
                lineno: node.lineno
                colno: node.colno
                e: zast.err.typeError
                msg: mm
                note: en6
                hint: eh6
                width: 6
            )
        }
    }
}

# reportTakenNameUse -- a read of a name whose value was moved out earlier.
reportTakenNameUse: function {st: zenv.ZSymbolTable ast: Ast.view node: atomref} is {
    ndNm: zast.nameTextAt :ast ref: node.name
    eh5: String
    m5: "cannot use '\{ndNm}' after ownership transfer"
    nt5: "this name no longer owns a value; it was moved earlier".string
    (addErrorH
        :st
        nodeid: node.nid
        lineno: node.lineno
        colno: node.colno
        e: zast.err.ownerError
        msg: m5
        note: nt5
        hint: eh5
        width: ndNm.length.u32.orPanic
    )
}

# checkLiteralAtom -- a numeric literal atom types as its literal pseudo-type.
# An INLINE type suffix (`65u8`, `2.5f32`) is not zerolang syntax: a
# conversion applies to a complete literal (`(65).u8`). Exempt 0x lexemes
# whose tail is hex-digit text (0x1f32, 0xac8) and 0c char literals (0c8 ends
# in a c8-shaped tail).
checkLiteralAtom: function {st: zenv.ZSymbolTable ast: Ast.view node: atomref} out ztypes.tid is {
    ndNm: zast.nameTextAt :ast ref: node.name
    sfR: ztypes.suffixInfoOf numstr: ndNm.stringView
    rejS: false
    if sfR.has then {
        rejS = true
        if (ndNm.stringView.startsWith prefix: "0x") then {
            sb: ndNm.stringView.byteAt (ndNm.length - sfR.len)
            match (
                sb
            ) case some then {
                if sb == 102 then rejS = false
                if sb == 99 then rejS = false
            } case none then null
        }
        if (ndNm.stringView.startsWith prefix: "0c") then rejS = false
    }
    if rejS then {
        core8: ndNm.stringView.substring from: 0 to: (ndNm.length - sfR.len)
        sfx8: (ndNm.stringView.substring
            from: (ndNm.length - sfR.len)
            to: ndNm.length
        )
        m8: "Unknown reference '\{ndNm}'"
        h8: "a numeric conversion applies to a complete literal: write (\{core8}).\{sfx8}"
        en8: String
        (addErrorH
            :st
            nodeid: node.nid
            lineno: node.lineno
            colno: node.colno
            e: zast.err.badReference
            msg: m8
            note: en8
            hint: h8
            width: ndNm.length.u32.orPanic
        )
        return (ztypes.tid.create from: 0)
    }
    result: ztypes.tid
    if (isFloatLiteralName name: ndNm.stringView) then {
        result = st.reg.literalFloatTid
    } else {
        result = st.reg.literalIntTid
    }
    setl: result
    stampGate :st nid: node.nid.u64 tid: setl
    return result
}

# checkAtomid -- type a bare name: a scope entry (break/continue diverge),
# else a numeric literal, else a definition looked up by name.
checkAtomid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    node: atomref
} out ztypes.tid is {
    result: ztypes.tid
    vtOpt: st.lookup nameId: node.name
    match (
        vtOpt
    ) case some then {
        result = ztypes.tid.create from: vtOpt.u64
        # break/continue diverge: the atom's value is never (the scope
        # entry stays the unregistered placeholder).
        isBrk: false
        if node.name.u32 == zast.names.wkBreak then isBrk = true
        if node.name.u32 == zast.names.wkContinue then isBrk = true
        if isBrk then {
            result = ztypes.tid.create from: (optU64Or
                o: (walkLookupTyperef
                    :st
                    frame: st.curFrame
                    :ast

                    :unitDecl
                    base: "never"
                )
                d: result.u64
            )
        }
        stampGate :st nid: node.nid.u64 tid: result
        # atom-use variable id: stamped even during template walks (variable
        # ids are valid there; stampGate only gates GENERIC_PARAM types)
        avo: st.lookupVarId nameId: node.name
        match (
            avo
        ) case some then {
            setav: avo
            st.typing.atomVariableId.set key: node.nid.u64 value: setav
        } case none then null
    } case none then {
        if node.name.u32 == zast.names.wkReturn then reportMissingReturnValue :st :node
        if (st.isTakenName nameId: node.name) then {
            reportTakenNameUse :st :ast :node
            return (ztypes.tid.create from: 0)
        }
        # a numeric literal is told by its text, read through a view scoped
        # to this block: the bare-name walk below lends ast
        isLit: false
        {
            ndNm: zast.nameTextAt :ast ref: node.name
            isLit = isNumericLiteralName name: ndNm.stringView
        }
        if isLit then return (checkLiteralAtom :st :ast :node)
        result = typeOfBareName :st :unitDecl :ast :node
    }
    return result
}

# isFloatLiteralName -- a numeric-literal atom carrying a decimal point (the
# float default; hex/binary stay integer literals).
isFloatLiteralName: function {name: StringView} out bool is {
    i: u64
    n: name.length
    for i < n loop {
        b: name.byteAt i
        match (
            b
        ) case some then {
            if b == 46 then return true
        } case none then null
        i = i + 1
    }
    return false
}

# isComparisonOp -- a binop operator whose result is bool (not the operand type).
isComparisonOp: function {name: StringView} out bool is {
    if name == "<" then return true
    if name == ">" then return true
    if name == "<=" then return true
    if name == ">=" then return true
    if name == "==" then return true
    if name == "!=" then return true
    return false
}

# ArmPredFact -- one bare arm predicate recognized in an if condition: the
# subject variable, the arm, the sum type, and whether the condition form
# is negated (`(x.a) == false` / trailing `.false`).
# stampTruthyCond -- record which arm a bare 2-arm-sum condition HOLDS when it
# is true: the second one, the type's non-falsy arm. Every reader then treats
# `if x` as `if x.<that arm>`. Stamped rather than derived, because a generic
# mono's record lives on the template it was minted from and reaching it needs
# the registry mutably.
stampTruthyCond: function {
    st: zenv.ZSymbolTable
    n: Node.view
    tid: ztypes.tid
} is {
    ta: ztyping.sumPairTruthyArmOf ty: st.typing reg: st.reg :tid
    if ta == 0 then return
    nid: nodeId :n
    if nid.isZero then return
    st.typing.truthyCondArm.set key: nid.u64 value: ta
}

ArmPredFact: class {
    subject: zast.nameid
    armName: zast.nameid
    fullTid: ztypes.tid
    negated: bool
}

# predDottedCore -- an ArmPredFact from an exploded predicate dotted node
# (`x.a` carrying a dpArmPredicate stamp on a non-bool receiver with a
# bare-variable subject), or none.
predDottedCore: function {ast: Ast.view
    st: zenv.ZSymbolTable.view
    nid: u64
    parent: Node.view
    childName: zast.nameid
    boolId: u64
    negated: bool
} out Option ArmPredFact is {
    ptid: optTidOr o: (st.typing.dpArmPredicate.get key: nid) d: ztypes.tid
    if ptid.isZero then return (Option.none ArmPredFact)
    if ptid.u64 == boolId then return (Option.none ArmPredFact)
    sn: bareAtomNameId :ast n: parent
    if sn.isZero then return (Option.none ArmPredFact)
    if childName.isZero then return (Option.none ArmPredFact)
    return (Option.some (ArmPredFact
        subject: sn
        armName: childName
        fullTid: (ztypes.tid.create from: ptid.u64)
        :negated
    ))
}

# predDottedFact -- predDottedCore over a Node (expression wrappers peeled).
predDottedFact: function {ast: Ast.view
    st: zenv.ZSymbolTable.view
    n: Node.view
    boolId: u64
    negated: bool
} out Option ArmPredFact is {
    match (
        n
    ) case expression then {
        return (predDottedFact
            :ast
            :st
            n: (ast.nodes.get i: n.expression.u64)
            :boolId
            :negated
        )
    } case dottedpath then {
        return (predDottedCore
            :ast
            :st
            nid: n.nodeid.u64
            parent: (ast.nodes.get i: n.parent.u64)
            childName: (bareAtomNameId :ast n: (ast.nodes.get i: n.child.u64))
            :boolId
            :negated
        )
    } else {
        return (Option.none ArmPredFact)
    }
}

# predFactOf -- recognize an if-condition operation as an arm predicate:
# bare `x.a`, trailing-bool `x.a.true` / `x.a.false`, or the comparison
# `(x.a) == true` / `(x.a) == false`. none otherwise.
# armSuffixSide -- the `.true` / `.false` suffix on a dotted arm predicate,
# read by arm identity. See ztyping.armSuffixSideOf.
armSuffixSide: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    nid: u64
    parent: Node.view
    child: Node.view
} out ztyping.armside is {
    cid: atomNameId :ast n: child
    return (ztyping.armSuffixSideOf
        ty: st.typing
        :nid
        parentNid: (nodeId n: parent).u64
        childNameId: cid.u64
    )
}

# truthyCondArmOf -- the arm a bare 2-arm-sum condition at `nid` holds, 0 when
# the node is not one.
truthyCondArmOf: function {st: zenv.ZSymbolTable.view nid: u64} out u64 is {
    o: st.typing.truthyCondArm.get key: nid
    match (
        o
    ) case some then {
        return o
    } case none then {
        return 0
    }
}

predFactOf: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    n: Node.view
    boolId: u64
} out Option ArmPredFact is {
    # A bare 2-arm sum as the condition IS an arm predicate with the arm left
    # implicit, so it states the same fact `if x.<arm>` states and narrows both
    # branches the same way: the then branch holds the arm, the else branch
    # excludes it and collapses only when what remains carries a payload.
    {
        ta0: truthyCondArmOf :st nid: (nodeId :n).u64
        if ta0 > 0 then {
            sj0: bareAtomNameId :ast :n
            ft0: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: (nodeId :n).u64
            if (sj0.isZero) == false when (ft0.isZero) == false then {
                return (Option.some (ArmPredFact
                    subject: sj0
                    armName: (zast.nameid.create from: ta0.u32.orPanic)
                    fullTid: ft0
                    negated: false
                ))
            }
        }
    }
    match (
        n
    ) case expression then {
        return (predFactOf :ast :st n: (ast.nodes.get i: n.expression.u64) :boolId)
    } case dottedpath then {
        # `.true` / `.false` on a predicate: which side it is comes from the
        # stamped type's arm ORDER, never from the spelling of the segment.
        sd: (armSuffixSide
            :ast
            :st
            nid: n.nodeid.u64
            parent: (ast.nodes.get i: n.parent.u64)
            child: (ast.nodes.get i: n.child.u64)
        )
        if sd.truthy then return (predDottedFact
            :ast
            :st
            n: (ast.nodes.get i: n.parent.u64)
            :boolId
            negated: false
        )
        if sd.falsy then return (predDottedFact
            :ast
            :st
            n: (ast.nodes.get i: n.parent.u64)
            :boolId
            negated: true
        )
        return (predDottedCore
            :ast
            :st
            nid: n.nodeid.u64
            parent: (ast.nodes.get i: n.parent.u64)
            childName: (bareAtomNameId :ast n: (ast.nodes.get i: n.child.u64))
            :boolId
            negated: false
        )
    } case binop then {
        opn: zast.nameTextAt :ast ref: (bareAtomNameId :ast n: (ast.nodes.get i: n.operator.u64))
        if opn.stringView == "==" then {
            # `== true` / `== false`: the operand names one of bool's arms,
            # and which side it is comes from bool's arm ORDER. boolId is the
            # canonical id the clause check already resolved.
            lsd: (ztyping.armSideOfName
                ty: st.typing
                typeId: boolId
                nameId: (bareAtomNameId :ast n: (ast.nodes.get i: n.lhs.u64)).u64
            )
            rsd: (ztyping.armSideOfName
                ty: st.typing
                typeId: boolId
                nameId: (bareAtomNameId :ast n: (ast.nodes.get i: n.rhs.u64)).u64
            )
            if rsd.truthy then return (predDottedFact
                :st
                :ast
                n: (ast.nodes.get i: n.lhs.u64)
                :boolId
                negated: false
            )
            if rsd.falsy then return (predDottedFact
                :st
                :ast
                n: (ast.nodes.get i: n.lhs.u64)
                :boolId
                negated: true
            )
            if lsd.truthy then return (predDottedFact
                :st
                :ast
                n: (ast.nodes.get i: n.rhs.u64)
                :boolId
                negated: false
            )
            if lsd.falsy then return (predDottedFact
                :st
                :ast
                n: (ast.nodes.get i: n.rhs.u64)
                :boolId
                negated: true
            )
        }
        return (Option.none ArmPredFact)
    } else {
        return (Option.none ArmPredFact)
    }
}

# shadowCollapseIfSingle -- when exclusions have collapsed `name` to a
# single PAYLOAD arm, upgrade to the shadow narrowing:
# the bare name becomes the payload, exactly as in a match arm. A null
# payload keeps the outer type (nothing to read). Condition-derived
# call sites only -- construction narrowing never routes through here.
shadowCollapseIfSingle: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    name: zast.nameid
    fullTid: u64
} is {
    arm: st.narrowedArmOf nameId: name fullTypeId: fullTid
    if arm.isZero then return
    po: (st.typing.declChildOfId
        parentTypeId: (ztypes.tid.create from: fullTid.u64)
        nameId: arm
    )
    match (
        po
    ) case some then {
        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: po.u64)) == ztypes.ztypetype.nullType then return
        (st.narrow
            nameId: name
            toTypeId: po
            subtypeName: arm
            shadow: true
        )
        (armPayloadReadonly
            :st
            :ast
            subject: name
            parentTid: fullTid
            armName: arm
            payloadTid: (ztypes.tid.create from: po.u64)
        )
    } case none then null
}

# applyPredFact -- record one predicate fact on its subject in the current
# branch scope. `holds` is the branch's knowledge of the condition: true
# on the then path, false on else/later-clause paths. A holding positive
# (or failing negated) fact SHADOW-narrows to the arm (the bare name is
# the payload); the opposite excludes it, and an exclusion that leaves a
# single payload arm collapses to the same shadow form.
applyPredFact: function {ast: Ast.view st: zenv.ZSymbolTable f: ArmPredFact.view holds: bool} is {
    doNarrow: false
    if holds when (f.negated) == false then doNarrow = true
    if (holds) == false when f.negated then doNarrow = true
    if doNarrow then {
        po: (st.typing.declChildOfId
            parentTypeId: f.fullTid
            nameId: f.armName
        )
        match (
            po
        ) case some then {
            (st.narrow
                nameId: f.subject
                toTypeId: po
                subtypeName: f.armName
                shadow: true
            )
            (armPayloadReadonly
                :st
                :ast
                subject: f.subject
                parentTid: f.fullTid
                armName: f.armName
                payloadTid: (ztypes.tid.create from: po.u64)
            )
        } case none then null
    } else {
        (st.exclude
            nameId: f.subject
            subtypeName: f.armName
            fullTypeId: f.fullTid
        )
        shadowCollapseIfSingle :ast :st name: f.subject fullTid: f.fullTid
    }
}

# postGuardRecord -- record the post-guard narrowing of `subject` under the
# guarding statement's node id when the applied facts left it SHADOW-
# narrowed to a payload arm: the emitter aliases the bare name for the
# rest of the enclosing block.
postGuardRecord: function {
    st: zenv.ZSymbolTable
    stmtNid: u32
    subject: zast.nameid
    fullTid: ztypes.tid
} is {
    if (st.isShadowNarrowed nameId: subject) == false then return
    arm: st.getSubtypeName nameId: subject
    if arm.isZero then return
    po: (st.typing.declChildOfId
        parentTypeId: (ztypes.tid.create from: fullTid.u64)
        nameId: arm
    )
    match (
        po
    ) case some then {
        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: po.u64)) == ztypes.ztypetype.nullType then return
        st.typing.postGuardName.set key: stmtNid.u64 value: subject
        pgv: optVidOr o: (st.lookupVarId nameId: subject)
        st.typing.postGuardVarId.set key: stmtNid.u64 value: pgv
        st.typing.postGuardTid.set key: stmtNid.u64 value: fullTid
        st.typing.postGuardArm.set key: stmtNid.u64 value: arm
    } case none then null
}

# checkClauseCondition -- walk one if-clause condition: an unresolved value
# is an unknown reference, and the value must be a bool or a 2-arm sum type.
checkClauseCondition: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    cond: argref
    boolId: u64
} is {
    errC: st.typing.errors.length
    ctv: checkValueAt :st :unitDecl :ast nid: cond.operation
    # a condition that typed to nothing and raised nothing is an
    # unresolvable name, exactly as in a binding or an operand: the
    # 0 disables the bool check below, and the emitter would write
    # the bare name into the C.
    if ctv.isZero when st.typing.errors.length == errC then {
        (reportUnresolvedValue
            :st
            :unitDecl
            :ast
            nid: cond.operation
        )
    }
    # An if-condition must be a boolean. A non-bool value (a
    # resultval, an aggregate, a raw numeric) is a type error rather
    # than invalid C. Bare arm predicates (`o.none`, `b.false`) type
    # as bool already; a diverging never-typed condition is allowed.
    # ... and so is any other 2-arm sum type: it has a falsy arm
    # and a truthy one, which is all a condition needs. Which arm
    # is which comes from the order the author wrote them.
    if ctv > 0 when boolId > 0 when ctv != boolId then {
        ctt: st.reg.typetypeOf typeId: ctv
        isPair: ztyping.isSumPair ty: st.typing reg: st.reg tid: ctv
        if isPair then {
            (stampTruthyCond
                :st
                n: (ast.nodes.get i: cond.operation.u64)
                tid: ctv
            )
        }
        if ctt != ztypes.ztypetype.neverType when (isPair) == false then {
            conode: ast.nodes.get i: cond.operation.u64
            ctnm: st.reg.nameOf tid: ctv
            cmsg: "condition must be bool or a 2-arm sum type, got '\{ctnm}'"
            (addError
                :st
                nodeid: cond.operation
                lineno: (nodeLine n: conode)
                colno: (nodeCol n: conode)
                e: zast.err.typeError
                msg: cmsg
            )
        }
    }
}

# checkClause -- walk one if-clause: its conditions (each must be bool or a
# 2-arm sum type), the predicate facts they establish, then its statement
# block. Answers the block's last statement type, 0 for a row that is no
# if-clause.
checkClause: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    clause: ifclauseref
    factsOut: List ArmPredFact
    boolId: u64
} out u64 is {
    if clause.nid.isZero then return 0
    k: u64
    for k < clause.nconds loop {
        condId: zast.ifCondAt :ast nid: clause.nid i: k
        k = k + 1
        cond: argRefAt :ast nid: condId
        if (cond.nid.isZero) == false then checkClauseCondition :st :unitDecl :ast :cond :boolId
    }
    k2: u64
    for k2 < clause.nconds loop {
        cndId: zast.ifCondAt :ast nid: clause.nid i: k2
        k2 = k2 + 1
        cnd: argRefAt :ast nid: cndId
        if (cnd.nid.isZero) == false then {
            fo: predFactOf :ast :st n: (ast.nodes.get i: cnd.operation.u64) :boolId
            match (
                fo
            ) case some then {
                factsOut.append fo.take
            } case none then null
        }
    }
    with afit: factsOut.iterate do for af: afit loop (applyPredFact
        :ast
        :st
        f: af
        holds: true
    )
    # a condition's borrow residue is dead once the condition value is
    # consumed -- it must not leak into the block's argument lock seeds
    drainPendingBorrow :st
    checkStatement :st :unitDecl :ast blockId: clause.statement
    return (lastStmtType :st :ast block: (ast.nodes.get i: clause.statement.u64))
}

# lastStmtType -- the resolved type id of a statement block's last statement
# (the value of a do-block), or 0 when empty/untyped.
lastStmtType: function {st: zenv.ZSymbolTable.view ast: Ast.view block: Node.view} out u64 is {
    result: u64
    match (
        block
    ) case statement then {
        ne: block.statements.length
        if ne > 0 then {
            lastId: block.statements.get i: (ne - 1)
            last: ast.nodes.get i: lastId.u64
            match (
                last
            ) case statementline then {
                lst: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: last.nodeid.u64
                if lst > 0 then result = lst
            } else null
        }
    } else {
        # An expression-shaped body (a bare `then 10` branch) carries its
        # value on its own node.
        bid: nodeId n: block
        if bid > 0 then {
            bst: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: bid.u64
            if bst > 0 then result = bst
        }
    }
    return result
}

# materialiseLiteral -- fold a literal pseudo-type id to its concrete default
# (i64 / f64); concrete ids pass through.
materialiseLiteral: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    t: u64
} out ztypes.tid is {
    base: ""
    if t == st.reg.literalIntTid then base = "i64"
    if t == st.reg.literalFloatTid then base = "f64"
    if base.length == 0 then return (ztypes.tid.create from: t)
    got: (optU64Or
        o: (walkLookupTyperef :st frame: st.curFrame :ast :unitDecl :base)
        d: 0
    )
    if got > 0 then return (ztypes.tid.create from: got)
    # a bare literal in a value context with no expected type IS `42.i64`: it
    # demands its own default scalar, the way the suffixed form and the
    # literal-NAME form (resolveNamedType) already do. Without this nothing
    # demands i64 for `x: 42` -- a literal names nothing.
    dn: (descendNamed
        :st
        frame: st.curFrame
        :ast
        unitDecl: st.typing.systemUnitRoot
        name: base
    )
    if dn > 0 then return dn
    return (ztypes.tid.create from: t)
}
# checkReadonlyBindSource -- binding FROM a readonly source. The test runs outside
# the destructor gate: a frozen binding may not be moved out of whether or not its
# type owns heap, and without a destructor the emitter builds a value from a
# pointer and gcc rejects the C. Readonly is also DEEP -- a reftype read out of a
# readonly path is itself readonly and takes the same self-lock, or the binding
# would be a laundering step.
checkReadonlyBindSource: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    asgn: asgnref
    vt: ztypes.tid
    vid2: ztypes.vid
} is {
    # The readonly test runs OUTSIDE the destructor gate below: a frozen
    # binding may not be moved out of whether or not its type owns heap,
    # and without a destructor the emitter builds a value from a pointer
    # and gcc rejects the C.
    rn5: zast.nameTextAt :ast ref: (bareAtomNameId :ast n: (ast.nodes.get i: asgn.value.u64))
    roMv5: false
    if rn5.length > 0 when (typeIsReftype :st tid: vt) then {
        if (nameIsReadonly :st :ast name: rn5.stringView) then {
            roMv5 = true
            (readonlyMoveError
                :st
                nodeid: asgn.nid
                lineno: asgn.lineno
                colno: asgn.colno
                name: rn5.stringView
                verb: "into an owned binding"
            )
        } else {
            if (pinnedMoveError
                :st
                :ast
                nodeid: asgn.nid
                lineno: asgn.lineno
                colno: asgn.colno
                name: rn5.stringView
                verb: "into an owned binding"
            ) then roMv5 = true
        }
    }
    if rn5.length > 0 when (roMv5) == false when (typeIsReftype
        :st
        tid: vt
    ) when (st.reg.needsDestructor typeId: vt) then {
        vo5: st.lookupVarId nameId: (nameIdOf :ast name: rn5.stringView)
        match (
            vo5
        ) case some then {
            if (isBorrowedVar :st vid: vo5) then {
                mb5: "Cannot move borrowed variable '\{rn5}' into an owned binding — borrowed names stay bound to their source for the full scope"
                (addError
                    :st
                    nodeid: asgn.nid
                    lineno: asgn.lineno
                    colno: asgn.colno
                    e: zast.err.ownerError
                    msg: mb5
                )
            } else {
                (st.invalidate
                    nameId: (nameIdOf :ast name: rn5.stringView)
                    loc: (optionval.none ztypes.zsrcpos)
                )
            }
        } case none then null
    }
    # Readonly is deep: a reftype read out of a readonly path is itself
    # readonly, and takes the same self-lock. Without this the binding is
    # a laundering step -- `i: c.sub` off a `view` receiver would hand back
    # a freely mutable name.
    roPath: (ListVal zast.nameid)
    appendValueTuple :ast n: (ast.nodes.get i: asgn.value.u64) dst: roPath
    roDeep: false
    if roPath.length > 1 when (typeIsReftype :st tid: vt) then {
        if (pathLeafIsMethod :st path: roPath) == false then {
            if (pathIsReadonly :st path: roPath) then roDeep = true
        }
    }
    if roDeep when (valueIsHold :ast n: (ast.nodes.get i: asgn.value.u64)) == false then {
        rop: (ListVal zast.nameid)
        rop.append asgn.name
        roh: (ztypes.zlockholder
            kind: ztypes.zlockholderkind.varKind
            id: vid2
        )
        ror: (st.tryLock
            pool: ast.names
            path: rop
            lockType: ztypes.zlockstate.shared
            lockScope: ztypes.zlockscope.target
            holder: roh
        )
        if ror.length > 0 then {
            (addError
                :st
                nodeid: asgn.nid
                lineno: asgn.lineno
                colno: asgn.colno
                e: zast.err.ownerError
                msg: ror
            )
        }
    }
    if (valueIsHold
        :ast
        n: (ast.nodes.get i: asgn.value.u64)
    ) when (typeIsReftype :st tid: vt) then {
        # Owned but frozen: the same readonly self-lock a `view` parameter
        # takes, so writes, mutating receivers and re-passing to a mutable
        # parameter are all caught by the ordinary lock rules. Ownership is
        # the other axis and is already `owned` above.
        hpp: (ListVal zast.nameid)
        hpp.append asgn.name
        hph: (ztypes.zlockholder
            kind: ztypes.zlockholderkind.varKind
            id: vid2
        )
        hpr: (st.tryLock
            pool: ast.names
            path: hpp
            lockType: ztypes.zlockstate.shared
            lockScope: ztypes.zlockscope.target
            holder: hph
        )
        if hpr.length > 0 then {
            (addError
                :st
                nodeid: asgn.nid
                lineno: asgn.lineno
                colno: asgn.colno
                e: zast.err.ownerError
                msg: hpr
            )
        }
    }
}


# checkAssignment -- a local binding `name: value`: walk the value, materialise a
# literal-typed value to its concrete default (the binding takes i64, unlike a
# for-loop binding which keeps the pseudo id), define the local (owned for a plain
# value), and stamp the assignment node + def-variable.
checkAssignment: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    asgn: asgnref
} is {
    drainPendingBorrow :st
    errA0: st.typing.errors.length
    vt: checkValueAt :st :unitDecl :ast nid: asgn.value
    mvt: materialiseLiteral :ast :st :unitDecl t: vt
    vt = mvt
    if vt.isZero when st.typing.errors.length == errA0 then {
        reportUnresolvedValue :st :unitDecl :ast nid: asgn.value
    }
    if vt > 0 when (st.reg.typetypeOf typeId: vt) == ztypes.ztypetype.nullType then {
        m1: "'null' cannot be used as a value — null must be wrapped in a union or variant (eg. option.none)".string
        vln1: u32
        vcl1: u32
        {
            av: ast.nodes.get i: asgn.value.u64
            vln1 = nodeLine n: av
            vcl1 = nodeCol n: av
        }
        vid1: asgn.value
        en1: String
        eh1: String
        (addErrorH
            :st
            nodeid: vid1
            lineno: vln1
            colno: vcl1
            e: zast.err.typeError
            msg: m1
            note: en1
            hint: eh1
            width: 4
        )
        return
    }
    if vt > 0 then {
        bsrc: (ListVal zast.nameid)
        takePendingBorrow :st dst: bsrc
        own: ztypes.zownership.owned
        # A `takex` result is pinned like a borrow but OWNED like a take, so the
        # pin must not demote it. `pendingBorrowOwned` is what tells them apart.
        pboX: st.typing.pendingBorrowOwned
        if bsrc.length > 0 when (typeIsReftype :st tid: vt) then {
            if (pboX) == false then own = ztypes.zownership.borrowed
        }
        vid: st.reg.newVariable ztypeId: vt ownership: own
        if own == ztypes.zownership.borrowed then (st.reg.setVariableBorrowOrigin
            id: vid
            origin: (bsrc.get i: 0)
        )
        # An `out T.view` result makes its binding readonly because the binding
        # IS the reference it handed back. A value merely DERIVED from one --
        # a valtype field read, a comparison, an arithmetic result -- is a fresh
        # value that aliases nothing, so it must not inherit the restriction.
        # `own` already draws exactly that line: the pin transfers only to a
        # reftype binding that the borrow actually flowed into.
        roRef: false
        if own == ztypes.zownership.borrowed then roRef = st.typing.pendingBorrowReadonly
        st.typing.pendingBorrowReadonly = false
        if (st.frameBindsHere nameId: asgn.name) then {
            dnm: zast.poolTextAt pool: ast.names ref: asgn.name
            dlm: "duplicate definition of '\{dnm}': this block already binds that name -- rebinding it here is a redefinition, and only a NESTED block shadows"
            (addError
                :st
                nodeid: asgn.nid
                lineno: asgn.lineno
                colno: asgn.colno
                e: zast.err.duplicateDef
                msg: dlm
            )
        }
        st.defineVar nameId: asgn.name :vid
        vid2: vid
        st.typing.defVariableId.set key: asgn.nid.u64 value: vid2
        st.reg.setVariableOrigin id: vid2 origin: ztypes.zvarorigin.local
        setk: vt
        stampGate :st nid: asgn.nid.u64 tid: setk
        if roRef then {
            rrn: (ast.names.texts.get i: asgn.name.u64).stringView
            rrr: readonlySelfLock :st :ast name: rrn vid: vid2
            if rrr.length > 0 then {
                (addError
                    :st
                    nodeid: asgn.nid
                    lineno: asgn.lineno
                    colno: asgn.colno
                    e: zast.err.ownerError
                    msg: rrr
                )
            }
        }
        (checkReadonlyBindSource
            :st
            :ast
            :asgn
            :vt
            :vid2
        )
        instX: false
        if own == ztypes.zownership.borrowed then instX = true
        if pboX when bsrc.length > 0 then instX = true
        st.typing.pendingBorrowOwned = false
        if instX then {
            lfsA: isViewFamilyTid :ast :st tid: vt
            if st.typing.pendingBorrowShared then lfsA = true
            st.typing.pendingBorrowShared = false
            (installBorrowLocks
                :st
                pool: ast.names
                src: bsrc
                :vid
                leafShared: lfsA
                nodeid: asgn.nid
                lineno: asgn.lineno
                colno: asgn.colno
            )
        }
        # Binding a tagged-subtype construction narrows the name to the
        # constructed arm (assignment-based narrowing: the overlay keeps the
        # subject's type and records the narrowed subtype).
        ucArm: unionCreateArmName :ast :st n: (ast.nodes.get i: asgn.value.u64)
        if ucArm.length > 0 then {
            (st.narrow
                nameId: asgn.name
                toTypeId: vt
                subtypeName: (nameIdOf :ast name: ucArm.stringView)
                shadow: false
            )
        }
    }
}
# invalidateMovedSource -- a bare-name reftype RHS is a MOVE: the source
# invalidates, which the symtab records by appending its taken overlay entry.
invalidateMovedSource: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    rasgn: reasgref
    rvt: ztypes.tid
} is {
    # A bare-name reftype RHS is a move: the source invalidates (the symtab
    # appends its taken overlay entry).
    rn: zast.nameTextAt :ast ref: (bareAtomNameId :ast n: (ast.nodes.get i: rasgn.value.u64))
    if rn.length > 0 when rvt > 0 when (typeIsReftype :st tid: rvt) then {
        vo: st.lookupVarId nameId: (nameIdOf :ast name: rn.stringView)
        match (
            vo
        ) case some then {
            if (nameIsReadonly :st :ast name: rn.stringView) then {
                (readonlyMoveError
                    :st
                    nodeid: rasgn.nid
                    lineno: rasgn.lineno
                    colno: rasgn.colno
                    name: rn.stringView
                    verb: "by reassignment"
                )
            } else {
                rpin: (pinnedMoveError
                    :st
                    :ast
                    nodeid: rasgn.nid
                    lineno: rasgn.lineno
                    colno: rasgn.colno
                    name: rn.stringView
                    verb: "by reassignment"
                )
                if rpin then null else if (isBorrowedVar :st vid: vo) then {
                    mc: "Cannot move borrowed variable '\{rn}' by reassignment — borrowed names stay bound to their source for the full scope; copy with '.copy' to keep the source"
                    (addError
                        :st
                        nodeid: rasgn.nid
                        lineno: rasgn.lineno
                        colno: rasgn.colno
                        e: zast.err.ownerError
                        msg: mc
                    )
                } else {
                    (st.invalidate
                        nameId: (nameIdOf :ast name: rn.stringView)
                        loc: (optionval.none ztypes.zsrcpos)
                    )
                }
            }
        } case none then null
    }
}
# checkMethodRefTarget -- reassigning through a dotted target whose root is a
# receiver: the member being written must be a field of it, not a method.
checkMethodRefTarget: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    rasgn: reasgref
} is {
    targetRoot: methodReceiverRoot :ast n: (ast.nodes.get i: rasgn.topath.u64)
    targetFnName: (zast.nameTextAt
        :ast
        ref: (dottedChildNameId :ast n: (ast.nodes.get i: rasgn.topath.u64))
    )
    if targetRoot.length > 0 when targetFnName.length > 0 then {
        tto: st.lookup nameId: (nameIdOf :ast name: targetRoot.stringView)
        match (
            tto
        ) case some then {
            if (st.typing.declIsLockField
                pool: ast.names
                parentTypeId: (ztypes.tid.create from: tto.u64)
                name: targetFnName.stringView
            ) then {
                tmk: "lock".string
                {
                    tmo: (st.typing.declOwnershipOfId
                        parentTypeId: (ztypes.tid.create from: tto.u64)
                        nameId: (zast.poolFind pool: ast.names text: targetFnName.stringView)
                    )
                    match (
                        tmo
                    ) case some then {
                        tmt: markerText o: tmo
                        if tmt.length > 0 then tmk = tmt
                    } case none then null
                }
                md: "Cannot reassign '.\{tmk}' field '\{targetFnName}' — a non-owned field is set at construction time and immutable"
                (addError
                    :st
                    nodeid: rasgn.nid
                    lineno: rasgn.lineno
                    colno: rasgn.colno
                    e: zast.err.ownerError
                    msg: md
                )
            }
        } case none then null
    }
}
# checkReassignedType -- the RHS value must be assignable to the target's DECLARED
# type. Numeric coercion (a literal, or concrete-to-concrete) is permitted exactly
# as at a call argument; a non-numeric mismatch is an error rather than invalid C
# downstream. A narrowed bare-name target accepts a fresh value of its whole type
# -- reassignment resets narrowing -- while a field target keeps lvt.
checkReassignedType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rasgn: reasgref
    lvt: ztypes.tid
    rvt: ztypes.tid
} is {
    # The RHS value must be assignable to the target's declared type. Numeric
    # coercion (a literal, or a concrete-to-concrete numeric) is permitted here
    # exactly as at a call argument; a non-numeric type mismatch -- a resultval
    # where a scalar is expected, a String into a numeric field -- is an error
    # rather than invalid C downstream.
    if lvt > 0 when rvt > 0 then {
        # Validate against the target's declared type: a narrowed bare-name
        # target accepts a fresh value of its whole type (reassignment resets
        # narrowing). A field target has no bare name and keeps lvt.
        chkT: lvt
        {
            nmId: atomNameId :ast n: (ast.nodes.get i: rasgn.topath.u64)
            if (nmId.isZero) == false then {
                dtoC: st.declaredTypeOf nameId: nmId
                match (
                    dtoC
                ) case some then {
                    chkT = ztypes.tid.create from: dtoC.u64
                } case none then null
            }
        }
        if (typesCompatible :ast :st a: rvt b: chkT) == false then {
            skipR: false
            if (isNumericTid
                :st
                frame: st.curFrame
                :ast

                tid: rvt
            ) when (isNumericTid :st frame: st.curFrame :ast tid: chkT) then skipR = true
            lttR: st.reg.typetypeOf typeId: chkT
            if lttR == ztypes.ztypetype.protocolType then skipR = true
            if lttR == ztypes.ztypetype.facetType then skipR = true
            if lttR == ztypes.ztypetype.genericParam then skipR = true
            if lttR == ztypes.ztypetype.functionType then skipR = true
            tsoR: st.typing.typeofShell.get key: chkT
            if tsoR.some then skipR = true
            if (skipR) == false then {
                enR: st.reg.nameOf tid: chkT
                anR: st.reg.nameOf tid: rvt
                mmR: "cannot assign value of type '\{anR}' to '\{enR}' target"
                (addError
                    :st
                    nodeid: rasgn.nid
                    lineno: rasgn.lineno
                    colno: rasgn.colno
                    e: zast.err.callError
                    msg: mmR
                )
            }
        }
    }
}
# checkNarrowedTargetWrite -- writing a bare name resets its narrowing (a fresh
# value of the whole declared type is legal again) and is refused outright when
# the name is borrowed or readonly-locked.
checkNarrowedTargetWrite: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    rasgn: reasgref
} is {
    nm: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: rasgn.topath.u64))
    if nm.length > 0 then {
        st.resetNarrowing nameId: (nameIdOf :ast name: nm.stringView)
        nvo: st.lookupVarId nameId: (nameIdOf :ast name: nm.stringView)
        match (
            nvo
        ) case some then {
            if (isBorrowedVar :st vid: nvo) then {
                ma: "Cannot reassign borrowed variable '\{nm}'"
                ha: "borrowed names are bound for their full scope; shadow in an inner scope instead".string
                ena: String
                (addErrorH
                    :st
                    nodeid: rasgn.nid
                    lineno: rasgn.lineno
                    colno: rasgn.colno
                    e: zast.err.ownerError
                    msg: ma
                    note: ena
                    hint: ha
                    width: nm.length.u32.orPanic
                )
            }
        } case none then null
    }
}
# resolveTypeofTarget -- a typeof-placeholder field resolves at its FIRST write:
# swap the field child to the RHS's type and restamp the target path.
resolveTypeofTarget: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    rasgn: reasgref
    lvt: ztypes.tid
    rvt: ztypes.tid
} is {
    # A typeof-placeholder field resolves at its first write: swap the
    # field child to the RHS's type and restamp the target path.
    if lvt > 0 when rvt > 0 then {
        tso: st.typing.typeofShell.get key: lvt
        match (
            tso
        ) case some then {
            troot: methodReceiverRoot :ast n: (ast.nodes.get i: rasgn.topath.u64)
            if troot.length > 0 then {
                tto: st.lookup nameId: (nameIdOf :ast name: troot.stringView)
                match (
                    tto
                ) case some then {
                    tfnId: dottedChildNameId :ast n: (ast.nodes.get i: rasgn.topath.u64)
                    if (tfnId.isZero) == false then {
                        mrvt: materialiseLiteral :ast :st :unitDecl t: rvt
                        (st.typing.setMemberType
                            parentTypeId: (ztypes.tid.create from: tto.u64)
                            nameId: tfnId
                            childTypeId: mrvt
                        )
                        settof: mrvt
                        stampGate :st nid: tso.u64 tid: settof
                        if (rasgn.topath.isZero) == false then {
                            settp: mrvt
                            stampGate :st nid: rasgn.topath.u64 tid: settp
                        }
                    }
                } case none then null
            }
        } case none then null
    }
}
# retakeHoldLock -- `h = y.hold` rebinds a hold binding, so its readonly self-lock
# stepped aside for the write and is retaken here over the new value.
retakeHoldLock: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    rasgn: reasgref
    hbVid: u64
    hbNmId: zast.nameid
} is {
    hrp: (ListVal zast.nameid)
    hrp.append hbNmId
    hrh: (ztypes.zlockholder
        kind: ztypes.zlockholderkind.varKind
        id: hbVid
    )
    hrr: (st.tryLock
        pool: ast.names
        path: hrp
        lockType: ztypes.zlockstate.shared
        lockScope: ztypes.zlockscope.target
        holder: hrh
    )
    if hrr.length > 0 then {
        (addError
            :st
            nodeid: rasgn.nid
            lineno: rasgn.lineno
            colno: rasgn.colno
            e: zast.err.ownerError
            msg: hrr
        )
    }
}

# checkReassignment -- `lhs = value`: resolve the target path and the value, then
# reset any narrowing on a bare-name target (appends a non-definition overlay
# entry).
checkReassignment: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    rasgn: reasgref
} is {
    st.typing.inAssignTarget = true
    errL0: st.typing.errors.length
    lvt: checkValueAt :st :unitDecl :ast nid: rasgn.topath
    st.typing.inAssignTarget = false
    # a target that resolved to nothing and raised nothing: an unresolvable
    # root name is an unknown reference, as at a read -- a local is not in
    # scope before the line that binds it
    if lvt.isZero when st.typing.errors.length == errL0 then {
        ubnL0: unresolvedBareCallable :ast :st :unitDecl nid: rasgn.topath
        if ubnL0.length > 0 then reportUnknownNameAt :st :ast nid: rasgn.topath name: ubnL0
    }
    # `h = y.hold`: a hold binding rebinds only when the marker is written
    # again, so its readonly self-lock steps aside for this assignment and is
    # retaken over the new value. Without the marker the lock stands and the
    # write is rejected -- there is no implicit downgrade at a reassignment.
    # The target's bare name and the value's shape are read through views
    # scoped to this block: the walks below lend ast.
    hbVid: u64
    hbNmId: zast.nameid
    rvIsHold: false
    {
        tpn: ast.nodes.get i: rasgn.topath.u64
        hbNmId = atomNameId :ast n: tpn
        rvIsHold = valueIsHold :ast n: (ast.nodes.get i: rasgn.value.u64)
    }
    if (hbNmId.isZero) == false when rvIsHold then {
        hbo: st.lookupVarId nameId: hbNmId
        match (
            hbo
        ) case some then {
            hlh: st.findLockHolder nameId: hbNmId
            match (
                hlh
            ) case some then {
                if hlh.kind == ztypes.zlockholderkind.varKind when hlh.id == hbo then {
                    hbVid = hbo
                    st.releaseHeldLocks holder: hlh
                }
            } case none then null
        } case none then null
    }
    checkWriteLock :st :ast n: (ast.nodes.get i: rasgn.topath.u64) verb: "assign to"
    errR0: st.typing.errors.length
    rvt: checkValueAt :st :unitDecl :ast nid: rasgn.value
    # a value that resolved to nothing and raised nothing: an unresolvable
    # root name is an unknown reference, as at a binding
    if rvt.isZero when st.typing.errors.length == errR0 then {
        ubnR0: unresolvedBareCallable :ast :st :unitDecl nid: rasgn.value
        if ubnR0.length > 0 then reportUnknownNameAt :st :ast nid: rasgn.value name: ubnR0
    }
    if hbVid > 0 then retakeHoldLock :st :ast :rasgn :hbVid :hbNmId
    mrv0: materialiseLiteral :ast :st :unitDecl t: rvt
    if mrv0 > 0 when (st.reg.typetypeOf typeId: mrv0) == ztypes.ztypetype.nullType then {
        m0n: "'null' cannot be used as a value — null must be wrapped in a union or variant (eg. option.none)".string
        vln0: u32
        vcl0: u32
        {
            rvn: ast.nodes.get i: rasgn.value.u64
            vln0 = nodeLine n: rvn
            vcl0 = nodeCol n: rvn
        }
        en0: String
        eh0: String
        (addErrorH
            :st
            nodeid: rasgn.value
            lineno: vln0
            colno: vcl0
            e: zast.err.typeError
            msg: m0n
            note: en0
            hint: eh0
            width: 4
        )
        return
    }
    resolveTypeofTarget :st :unitDecl :ast :rasgn :lvt :rvt
    # A literal RHS at a concretely-typed target coerces: restamp the RHS's
    # innermost node (wrappers derive through the dump's descent). A
    # literal-typed target (a literal-init loop binding) keeps the pseudo.
    if lvt > 0 when rvt > 0 when (isLiteralTypeId :st tid: rvt) then {
        if (isLiteralTypeId :st tid: lvt) == false then {
            iid: innermostNodeId :ast n: (ast.nodes.get i: rasgn.value.u64)
            if iid > 0 then {
                setc: lvt
                stampGate :st nid: iid.u64 tid: setc
            }
        }
    }
    checkReassignedType :st :ast :rasgn :lvt :rvt
    checkNarrowedTargetWrite :st :ast :rasgn
    checkMethodRefTarget :st :ast :rasgn
    invalidateMovedSource :st :ast :rasgn :rvt
}

# checkSwap -- `lhs swap rhs`: resolve both operand paths (stamping them). The swap
# carries no type (the expression wrapper is null, like reassignment) and does no
# narrowing. Operand ownership/lock/type-match validation produces no dump rows -- deferred.
checkSwap: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    swapnode: swapref
} is {
    checkValueAt :st :unitDecl :ast nid: swapnode.lhs
    checkValueAt :st :unitDecl :ast nid: swapnode.rhs
    checkWriteLock :st :ast n: (ast.nodes.get i: swapnode.lhs.u64) verb: "swap"
    checkWriteLock :st :ast n: (ast.nodes.get i: swapnode.rhs.u64) verb: "swap"
}

# withValueOwnership -- the with-binding's ownership from the bound value's
# syntactic shape, the same rules as a function argument: a bare
# name bound to a runtime variable or a plain dotted path borrows; `.take`
# transfers; calls, literals and constructions are fresh owned values.
withValueOwnership: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    v: Node.view
} out ztypes.zownership is {
    match (
        v
    ) case expression then {
        return (withValueOwnership :ast :st v: (ast.nodes.get i: v.expression.u64))
    } case atomid then {
        vNm: ast.names.texts.get i: v.name.u64
        vo: st.lookupVarId nameId: (nameIdOf :ast name: vNm.stringView)
        match (
            vo
        ) case some then {
            return ztypes.zownership.borrowed
        } case none then {
            return ztypes.zownership.owned
        }
    } case dottedpath then {
        cn: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: v.child.u64))
        if cn.stringView == "take" then {
            return ztypes.zownership.owned
        } else {
            return ztypes.zownership.borrowed
        }
    } else {
        return ztypes.zownership.owned
    }
}

# checkWith -- walk `with name: value do body`: push the `with` scope, bind the
# alias variable (BORROWED for a plain-path value), walk the body, then pop. The
# with node carries the bound value's type; the with-expression's value is the
# body's value.
checkWith: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    withnode: withref
} out ztypes.tid is {
    withMarker: st.pushBlock name: "with"
    errW: st.typing.errors.length
    vt: checkValueAt :st :unitDecl :ast nid: withnode.value
    if vt.u64 == 0 when st.typing.errors.length == errW then {
        (reportUnresolvedValue
            :st
            :unitDecl
            :ast
            nid: withnode.value
        )
    }
    # a value that failed still binds its name, typeless, so the body's reads
    # of it are not each an unknown reference
    if vt.isZero then {
        vh: st.reg.newVariable ztypeId: ztypes.tid ownership: ztypes.zownership.owned
        st.defineVar nameId: withnode.name vid: vh
    }
    if vt > 0 then {
        own: withValueOwnership :ast :st v: (ast.nodes.get i: withnode.value.u64)
        # The borrow target: a BORROW-returning auto-call reported the receiver
        # source; a plain-path value locks its full dotted tuple. Valtype
        # borrows are copies -- no lock.
        btgt: (ListVal zast.nameid)
        takePendingBorrow :st dst: btgt
        if btgt.length == 0 then {
            if own == ztypes.zownership.borrowed then {
                appendValueTuple :ast n: (ast.nodes.get i: withnode.value.u64) dst: btgt
            }
        } else {
            # A pending borrow from the value's call (a lock-param transfer
            # or a borrow-marked return) makes the with-binding borrowed.
            own = ztypes.zownership.borrowed
        }
        vid: st.reg.newVariable ztypeId: vt ownership: own
        # the borrow origin, as a plain binding records it: what this alias is
        # a reference INTO. A for-loop over an iterator alias reads it back to
        # learn how strongly the alias pins the container it walks.
        if btgt.length > 0 then st.reg.setVariableBorrowOrigin id: vid origin: (btgt.get i: 0)
        st.defineVar nameId: withnode.name :vid
        vid2: vid
        st.typing.defVariableId.set key: withnode.nid.u64 value: vid2
        if (typeIsReftype :st tid: vt) then {
            lfsW: isViewFamilyTid :ast :st tid: vt
            if st.typing.pendingBorrowShared then lfsW = true
            st.typing.pendingBorrowShared = false
            (installBorrowLocks
                :st
                pool: ast.names
                src: btgt
                :vid
                leafShared: lfsW
                nodeid: withnode.nid
                lineno: withnode.lineno
                colno: withnode.colno
            )
        }
        setk: vt
        stampGate :st nid: withnode.nid.u64 tid: setk
    }
    dt: checkValueAt :st :unitDecl :ast nid: withnode.body
    st.popTo marker: withMarker
    return dt
}

# blockHasBreak -- a bare `break` statement somewhere in this block's own
# control flow (descending if/match/with bodies but NOT nested do/for, whose
# breaks bind to them). Drives the do-block's optionval wrapping.
blockHasBreak: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case statement then {
        siter: n.statements.iterate
        for s0Id: siter loop {
            if (blockHasBreak :ast n: (ast.nodes.get i: s0Id.u64)) then return true
        }
        return false
    } case statementline then {
        return (blockHasBreak :ast n: (ast.nodes.get i: n.statementline.u64))
    } case expression then {
        return (blockHasBreak :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return n.name.u32 == zast.names.wkBreak
    } case ifexpr then {
        cliter: n.clauses.iterate
        for cl0Id: cliter loop {
            cl0: ast.nodes.get i: cl0Id.u64
            match (
                cl0
            ) case ifclause then {
                if (blockHasBreak
                    :ast
                    n: (ast.nodes.get i: cl0.statement.u64)
                ) then return true
            } else null
        }
        if n.elseclause.isZero then return false
        return (blockHasBreak :ast n: (ast.nodes.get i: n.elseclause.u64))
    } case caseexpr then {
        mliter: n.clauses.iterate
        for ml0Id: mliter loop {
            ml0: ast.nodes.get i: ml0Id.u64
            match (
                ml0
            ) case caseclause then {
                if (blockHasBreak
                    :ast
                    n: (ast.nodes.get i: ml0.statement.u64)
                ) then return true
            } else null
        }
        if n.elseclause.isZero then return false
        return (blockHasBreak :ast n: (ast.nodes.get i: n.elseclause.u64))
    } case withexpr then {
        return (blockHasBreak :ast n: (ast.nodes.get i: n.body.u64))
    } else {
        return false
    }
}

# checkDo -- walk a do-block: push the `block` scope, define break (an entry
# position placeholder with an unregistered type id, so it never joins the dump),
# walk the statements, then pop. The do resolves to its last statement's value type.
# wrapDoBreakValue -- the value type of a do-block that can BREAK: an early
# exit means there may be no value, so the block's type wraps in `optionval`
# (or `Option`, when the payload is a reftype and must be boxed). Returns the
# payload type unchanged when there is nothing to wrap.
#
# A break-carrying do-block's value wraps in optionval (early exit =
# none). A REFTYPE block value wraps in Option instead (boxed payload).
#
# MATERIALISE THE PAYLOAD FIRST. The wrap mints a monomorphization keyed on
# the payload type, and a literal one would key it on `intliteral` -- which
# is how the literal type reached the emitter at all, as the payload field
# of `optionval_intliteral` in `x: { if c then break  42 }`. Generic-arg
# inference already keys on the concrete default everywhere else; this is
# the same rule, at the one site that did not apply it.
wrapDoBreakValue: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    donode: doref
    result: u64
} out u64 is {
    # `result` is a borrowed parameter; the wrap replaces the type, so the
    # rebinding happens in a local.
    res: result
    if res > 0 when (blockHasBreak :ast n: (ast.nodes.get i: donode.statement.u64)) then {
        mres0: materialiseLiteral :ast :st :unitDecl t: res
        res = mres0.u64
        vtn0: st.reg.nameOf tid: (ztypes.tid.create from: res.u64)
        payloadTid: res
        if vtn0.length > 0 then {
            wrapBase: "optionval"
            if (typeIsReftype
                :st
                tid: (ztypes.tid.create from: payloadTid.u64)
            ) then wrapBase = "Option"
            ovo0: (walkLookupTyperef
                :st
                frame: st.curFrame
                :ast

                :unitDecl
                base: wrapBase
            )
            match (
                ovo0
            ) case some then {
                optionSubs: (IdMapV zast.nameid v: u64)
                ov0: payloadTid
                # `ovo0` is whichever of Option / optionval the payload's
                # family selected, and each names its own parameter. A zero
                # id stages under the elided key, which getOrMintSpec rebinds
                # to that same first parameter.
                (optionSubs.set
                    key: (firstGenericParamId
                        :st
                        templateId: (ztypes.tid.create from: ovo0.u64)
                    )
                    value: ov0
                )
                omn0: "_\{vtn0}"
                vsF: (IdMapV zast.nameid v: u64)
                omid0: (getOrMintSpec
                    :st
                    frame: st.curFrame
                    :ast

                    :unitDecl
                    sfx: omn0.stringView
                    templateId: (ztypes.tid.create from: ovo0.u64)
                    subs: optionSubs
                    valSubs: vsF
                    fallbackArg: 0
                )
                if omid0 > 0 then res = omid0
            } case none then null
        }
    }
    return res
}

checkDo: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    donode: doref
} out ztypes.tid is {
    doMarker: st.pushBlock name: "block"
    dbk: st.reg.ctlPlaceholder
    (st.define
        nameId: zast.names.wkBreak
        ztypeId: (ztypes.tid.create from: dbk.u64)
    )
    drainPendingBorrow :st
    checkStatement :st :unitDecl :ast blockId: donode.statement
    result: lastStmtType :st :ast block: (ast.nodes.get i: donode.statement.u64)
    st.popTo marker: doMarker
    result = wrapDoBreakValue :ast :st :unitDecl :donode :result
    if result > 0 then {
        setk: result
        stampGate :st nid: donode.nid.u64 tid: (ztypes.tid.create from: setk.u64)
    }
    return (ztypes.tid.create from: result)
}

# isCallNode -- the node is a (possibly expression-wrapped) call.
isCallNode: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case call then {
        return true
    } case expression then {
        return (isCallNode :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        return false
    }
}
# bindForBorrowedElement -- bind a `for` loop name to a BORROWED element: the
# iteration hands back a view into the container, so the binding records its
# borrow origin and holds the container locked for the body.
bindForBorrowedElement: function {
    st: zenv.ZSymbolTable
    ast: Ast
    cond: argref
    vt: ztypes.tid
    elem: u64
    nm: StringView
} is {
    vid: (st.reg.newVariable
        ztypeId: (ztypes.tid.create from: elem.u64)
        ownership: ztypes.zownership.borrowed
    )
    (st.reg.setVariableBorrowOrigin
        id: vid
        origin: (atomNameId :ast n: (ast.nodes.get i: cond.operation.u64))
    )
    nmId: cond.name
    st.defineVar nameId: nmId :vid
    condNid: nodeId n: (ast.nodes.get i: cond.operation.u64)
    st.typing.defVariableId.set key: condNid.u64 value: vid
    # `for x: xs.iterate` has no iterator binding to carry
    # the container's lock, so the element carries it: the
    # reference the loop hands out points into the
    # container's storage, and a write through the
    # container reallocates it. The `with` form leaves
    # nothing pending here -- its binding took the lock.
    fbs: (ListVal zast.nameid)
    takePendingBorrow :st dst: fbs
    flf: isViewFamilyTid :ast :st tid: vt
    if st.typing.pendingBorrowShared then flf = true
    st.typing.pendingBorrowShared = false
    if fbs.length > 0 then {
        fcn: ast.nodes.get i: cond.operation.u64
        fnd: nodeId n: fcn
        fln: nodeLine n: fcn
        fcl: nodeCol n: fcn
        (installBorrowLocks
            :st
            pool: ast.names
            src: fbs
            :vid
            leafShared: flf
            nodeid: fnd
            lineno: fln
            colno: fcl
        )
    }
    # The element is a reference derived from the lock its
    # holder has on the container, so it inherits that
    # lock's strength: a SHARED pin (a `view` iterator
    # receiver) yields READONLY elements, an exclusive one
    # yields writable ones. The binding-free form knows its
    # own strength; the `with` form has to ask its binding.
    elr: flf
    if fbs.length == 0 then {
        elr = (iterElementIsReadonly
            :st
            iterName: (atomNameId :ast n: (ast.nodes.get i: cond.operation.u64))
        )
    }
    if elr then {
        erm: readonlySelfLock :st :ast name: nm :vid
        if erm.length > 0 then {
            ecn: ast.nodes.get i: cond.operation.u64
            end: nodeId n: ecn
            eln: nodeLine n: ecn
            ecl: nodeCol n: ecn
            (addError
                :st
                nodeid: end
                lineno: eln
                colno: ecl
                e: zast.err.ownerError
                msg: erm
            )
        }
    }
}
# probeForCallIteration -- walk a call-shaped iterator init once, in an empty
# call scope, so its per-iteration call is typed before the loop binds an
# element. Gated on the value being an iterator wrapper.
probeForCallIteration: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    vt: ztypes.tid
} is {
    doProbe: false
    pw: iterWrapperElem :ast :st :unitDecl wid: vt
    match (
        pw
    ) case some then {
        doProbe = true
    } case none then {
        (forceMemberOf
            :st
            frame: st.curFrame

            :ast
            parentTypeId: vt
            nameId: zast.names.wkCall
        )
        ico: st.typing.declChildOfId parentTypeId: vt nameId: zast.names.wkCall
        match (
            ico
        ) case some then {
            doProbe = true
        } case none then null
    }
    if doProbe then {
        ecm: st.pushCall
        st.popTo marker: ecm
    }
}


# bindForIteration -- bind a `for` header's loop name to what its iterable
# yields: the element type and ownership, and the lock the iteration holds
# on the container for the body's duration.
bindForIteration: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    cond: argref
    vt: ztypes.tid
    nm: StringView
} is {
    # A call-shaped iterator init probes its per-iteration call
    # in an empty call scope; gated on the value being an iterator
    # wrapper.
    if (isCallNode :ast n: (ast.nodes.get i: cond.operation.u64)) then {
        probeForCallIteration :st :unitDecl :ast :vt
    }
    elem: u64
    isView: false
    w1: iterWrapperElem :ast :st :unitDecl wid: vt
    match (
        w1
    ) case some then {
        elem = w1
        isView = isOptionViewMono :ast :st :unitDecl wid: vt
    } case none then null
    if elem == 0 then {
        if (st.reg.typetypeOf typeId: vt) == ztypes.ztypetype.functionType then {
            r1: methodReturnOf :st mid: vt
            match (
                r1
            ) case some then {
                w2: iterWrapperElem :ast :st :unitDecl wid: r1
                match (
                    w2
                ) case some then {
                    elem = w2
                    isView = isOptionViewMono :ast :st :unitDecl wid: r1
                } case none then null
            } case none then null
        } else {
            (forceMemberOf
                :st
                frame: st.curFrame

                :ast
                parentTypeId: vt
                nameId: zast.names.wkCall
            )
            c1: st.typing.declChildOfId parentTypeId: vt nameId: zast.names.wkCall
            match (
                c1
            ) case some then {
                r2: methodReturnOf :st mid: (ztypes.tid.create from: c1.u64)
                match (
                    r2
                ) case some then {
                    w3: iterWrapperElem :ast :st :unitDecl wid: r2
                    match (
                        w3
                    ) case some then {
                        elem = w3
                        isView = isOptionViewMono :ast :st :unitDecl wid: r2
                    } case none then null
                } case none then null
            } case none then null
        }
    }
    if elem > 0 then {
        if isView then {
            bindForBorrowedElement :st :ast :cond :vt :elem :nm
        } else {
            (st.define
                nameId: cond.name
                ztypeId: (ztypes.tid.create from: elem.u64)
            )
        }
    } else {
        st.define nameId: cond.name ztypeId: vt
    }
}
# forFactoryTid -- the type id of a bare 0-arg function in a `for` header that
# returns an iterator class, and so auto-invokes; 0 when the condition names
# no such function. Its walk runs in a call scope, so the atom keeps the
# FUNCTION stamp rather than the auto-call's coerced return.
forFactoryTid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    fbn: StringView
} out u64 is {
    facId: u64
    if fbn.length > 0 then {
        ffo: (walkLookupTyperef
            :st
            frame: st.curFrame
            :ast

            :unitDecl
            base: fbn
        )
        match (
            ffo
        ) case some then {
            if (st.reg.typetypeOf typeId: (ztypes.tid.create from: ffo.u64)) == ztypes.ztypetype.functionType then {
                if (methodHasNoUserArgs
                    :st
                    mid: (ztypes.tid.create from: ffo.u64)
                ) then {
                    fro: methodReturnOf :st mid: (ztypes.tid.create from: ffo.u64)
                    match (
                        fro
                    ) case some then {
                        if (st.reg.typetypeOf typeId: fro) == ztypes.ztypetype.classType then {
                            (forceMemberOf
                                :st
                                frame: st.curFrame

                                :ast
                                parentTypeId: fro
                                nameId: zast.names.wkCall
                            )
                            fco: (st.typing.declChildOfId
                                parentTypeId: fro
                                nameId: zast.names.wkCall
                            )
                            match (
                                fco
                            ) case some then {
                                facId = ffo
                            } case none then null
                        }
                    } case none then null
                }
            }
        } case none then null
    }
    return facId
}

# checkBareForCondition -- type a `for while <cond> loop` header that binds no
# name: the value must be bool, or an iterable the loop can drive. Anything
# else is a type error rather than the invalid C a struct in a `while` head
# would emit.
checkBareForCondition: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    cond: argref
    vt: ztypes.tid
} is {
    fbId: builtinTidTc :ast :st base: "bool"
    fIter: false
    {
        fpw: iterWrapperElem :ast :st :unitDecl wid: vt
        match (
            fpw
        ) case some then {
            fIter = true
        } case none then null
    }
    {
        (forceMemberOf
            :st
            frame: st.curFrame

            :ast
            parentTypeId: vt
            nameId: zast.names.wkCall
        )
        fico: st.typing.declChildOfId parentTypeId: vt nameId: zast.names.wkCall
        match (
            fico
        ) case some then {
            fIter = true
        } case none then null
    }
    fTt: st.reg.typetypeOf typeId: vt
    fPair: ztyping.isSumPair ty: st.typing reg: st.reg tid: vt
    if fPair when (fIter) == false then {
        (stampTruthyCond
            :st
            n: (ast.nodes.get i: cond.operation.u64)
            tid: vt
        )
    }
    if fbId > 0 when vt != fbId when (fIter) == false when fTt != ztypes.ztypetype.neverType when (fPair) == false then {
        fcn: ast.nodes.get i: cond.operation.u64
        fctn: st.reg.nameOf tid: vt
        fcmsg: "loop condition must be bool or a 2-arm sum type, got '\{fctn}'"
        (addError
            :st
            nodeid: (nodeId n: fcn)
            lineno: (nodeLine n: fcn)
            colno: (nodeCol n: fcn)
            e: zast.err.typeError
            msg: fcmsg
        )
    }
}


# checkForCondition -- resolve one condition in a `for` header: the binding it
# introduces, the element type it iterates, and the locks that iteration takes.
checkForCondition: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    condId: zast.nodeid
} is {
    # the condition is a namedoperation row, read as plain values: the
    # walks below lend ast
    cond: argRefAt :ast nid: condId
    if cond.nid.isZero then return
    # A bare 0-arg function returning an iterator class auto-invokes:
    # its walk runs in a call scope and the atom keeps the FUNCTION
    # stamp rather than the auto-call's coerced return.
    # an owned copy: the walks below lend ast
    fbn: (zast.nameTextCopy
        :ast
        ref: (bareAtomNameId :ast n: (ast.nodes.get i: cond.operation.u64))
    )
    facId: forFactoryTid :st :unitDecl :ast fbn: fbn.stringView
    vt: ztypes.tid
    errC: st.typing.errors.length
    if facId > 0 then {
        # the factory's lazy walks (its body + the iterator class's
        # methods via return-first transitivity) fire before the
        # synthetic invocation's call scope opens.
        maybeWalkMethods :st frame: st.curFrame :unitDecl :ast name: fbn.stringView
        fcm: st.pushCall
        vt = checkValueAt :st :unitDecl :ast nid: cond.operation
        st.popTo marker: fcm
        fiid: innermostNodeId :ast n: (ast.nodes.get i: cond.operation.u64)
        if fiid > 0 then {
            setff: facId
            stampGate :st nid: fiid.u64 tid: (ztypes.tid.create from: setff.u64)
        }
    } else {
        vt = checkValueAt :st :unitDecl :ast nid: cond.operation
    }
    # a condition that typed to nothing and raised nothing is an
    # unresolvable name -- the same rule the binding and operand sites
    # follow. Without it the emitter writes the bare name into the C.
    if vt.isZero when st.typing.errors.length == errC then {
        (reportUnresolvedValue
            :st
            :unitDecl
            :ast
            nid: cond.operation
        )
    }
    # an owned copy: the binding below lends ast
    nm: zast.nameTextCopy :ast ref: cond.name
    # A bare `for while <cond> loop` (no binding, no iterator factory)
    # must be boolean; a non-bool, non-iterable value is a type error
    # rather than invalid C. Iterator bindings (`for e: it`) carry a
    # name; iterable inits expose an element wrapper or a `call` child.
    if nm.length == 0 when vt > 0 when facId == 0 then {
        checkBareForCondition :st :unitDecl :ast :cond :vt
    }
    if nm.length > 0 when vt > 0 then {
        bindForIteration :st :unitDecl :ast :cond :vt nm: nm.stringView
    }
    # an iterable that failed still binds its loop name, typeless, so
    # the body's reads of it are not each an unknown reference
    if nm.length > 0 when vt.isZero then {
        (st.define
            nameId: cond.name
            ztypeId: ztypes.tid
        )
    }
}
# forComprehensionTid -- the type a `for` used as an expression produces: a
# List of the body's value type, and 0 when the body produces no value.
forComprehensionTid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    fornode: forref
    elemT: ztypes.tid
} out ztypes.tid is {
    # for-as-expression: a value-producing body makes the loop a List of
    # that element type (the comprehension form).
    if elemT > 0 then {
        en: st.reg.nameOf tid: (ztypes.tid.create from: elemT.u64)
        isNull: false
        if en.stringView == "null" then isNull = true
        if en.length == 0 then isNull = true
        if (isNull) == false then {
            # the comprehension's element decides the family, exactly as a
            # written-out container declaration would
            ltn: "ListRef".string
            if (typeIsValtype
                :st

                tid: (ztypes.tid.create from: elemT.u64)
            ) then ltn = "ListVal".string
            lto: (walkLookupTyperef
                :st
                frame: st.curFrame
                :ast

                :unitDecl
                base: ltn.stringView
            )
            match (
                lto
            ) case some then {
                lsubs: (IdMapV zast.nameid v: u64)
                lv: elemT
                # `lto` is whichever of ListRef / ListVal the element's family
                # selected above; each names its own element parameter.
                (lsubs.set
                    key: (firstGenericParamId
                        :st
                        templateId: (ztypes.tid.create from: lto.u64)
                    )
                    value: lv
                )
                lsfx: "_\{en}"
                vsG: (IdMapV zast.nameid v: u64)
                lmid: (getOrMintSpec
                    :st
                    frame: st.curFrame
                    :ast

                    :unitDecl
                    sfx: lsfx.stringView
                    templateId: (ztypes.tid.create from: lto.u64)
                    subs: lsubs
                    valSubs: vsG
                    fallbackArg: 0
                )
                if lmid > 0 then {
                    setf: lmid
                    stampGate :st nid: fornode.nid.u64 tid: setf
                    return lmid
                }
            } case none then null
        }
    }
    return (ztypes.tid.create from: 0)
}
# checkForPostcondition -- type one `for loop { … } while <cond>` trailing
# condition. It carries the same bool rule as the header conditions: a
# non-bool value is a type error, not the invalid C a struct in a `while`
# head would emit.
checkForPostcondition: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    pcId: u32
} is {
    pcOp: zast.nodeid.create from: pcId
    pc: argRefAt :ast nid: pcOp
    if (pc.nid.isZero) == false then pcOp = pc.operation
    errP: st.typing.errors.length
    pcVt: checkValueAt :st :unitDecl :ast nid: pcOp
    if pcVt.isZero when st.typing.errors.length == errP then {
        reportUnresolvedValue :st :unitDecl :ast nid: pcOp
    }
    # A `for loop { ... } while <cond>` post-condition must be boolean, the
    # same rule the pre-condition carries above: a non-bool value is a type
    # error rather than the invalid C a struct in a `while` head emits.
    pbId: builtinTidTcRo :ast :st base: "bool"
    if pbId > 0 when pcVt > 0 when pcVt != pbId then {
        pTt: st.reg.typetypeOf typeId: pcVt
        pPair: ztyping.isSumPair ty: st.typing reg: st.reg tid: pcVt
        if pPair then stampTruthyCond :st n: (ast.nodes.get i: pcOp.u64) tid: pcVt
        if pTt != ztypes.ztypetype.neverType when (pPair) == false then {
            pctn: st.reg.nameOf tid: pcVt
            pcmsg: "loop postcondition must be bool or a 2-arm sum type, got '\{pctn}'"
            (addError
                :st
                nodeid: pcOp
                lineno: (nodeLine n: (ast.nodes.get i: pcOp.u64))
                colno: (nodeCol n: (ast.nodes.get i: pcOp.u64))
                e: zast.err.typeError
                msg: pcmsg
            )
        }
    }
}


# checkFor -- walk a for-loop: push the `for` scope, define break/continue (entry
# position placeholders with unregistered type ids, so they never join the dump),
# then walk the conditions, postconditions, and body, and pop. A named condition
# is a binding: define the loop var with the condition value's type (the value of
# a bare literal init stays the literal pseudo-type, keeping the entry out of the
# dump joins). Iterator-wrapper element extraction needs monomorphization and is
# not implemented. The for itself resolves to null (filtered) in statement position.
checkFor: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    fornode: forref
} out ztypes.tid is {
    forMarker: st.pushBlock name: "for"
    bk: st.reg.ctlPlaceholder
    (st.define
        nameId: zast.names.wkBreak
        ztypeId: (ztypes.tid.create from: bk.u64)
    )
    ct: st.reg.ctlPlaceholder
    (st.define
        nameId: zast.names.wkContinue
        ztypeId: (ztypes.tid.create from: ct.u64)
    )
    kC: u64
    for kC < fornode.nconds loop {
        condId: zast.forCondAt :ast nid: fornode.nid i: kC
        kC = kC + 1
        checkForCondition :st :unitDecl :ast :condId
    }
    kP: u64
    for kP < fornode.nposts loop {
        pcId: (zast.forPostAt :ast nid: fornode.nid i: kP).u32
        kP = kP + 1
        checkForPostcondition :st :unitDecl :ast :pcId
    }
    drainPendingBorrow :st
    walkBodyAt :st :unitDecl :ast bodyId: fornode.body
    elemT: ztypes.tid
    if fornode.body > 0 then {
        fb: ast.nodes.get i: fornode.body.u64
        elemT = ztypes.tid.create from: (lastStmtType :st :ast block: fb)
    }
    if st.isUnreachable then st.discardTakenInCurrentScope
    st.popTo marker: forMarker
    return (forComprehensionTid :st :unitDecl :ast :fornode :elemT)
}

# checkIf -- walk an if: push the `if` scope, then a `if_branch` scope per clause
# and an `if_else` scope for the else; when every branch diverges (returns) the
# if resolves to never and marks the enclosing scope unreachable.
# restoreTakenArm -- after a NON-diverging if arm, undo any takes of outer-scope
# owned vars (clearTaken) so the next arm + the restore see them live, recording
# them in `taken` for a single post-if invalidate. Without this a take in one arm
# propagates (via popTo) into the sibling arm, which then sees the var as gone and
# never stamps its type (e.g. an else-arm's `childpath.take` emitting `.take` on a
# String). A take is an overlay over a persisting entry, so clearTaken alone
# restores (no redefine).
restoreTakenArm: function {st: zenv.ZSymbolTable liveBefore: (IdSet u32).view taken: IdSet u32} is {
    liveAfter: st.getLiveOwnedVars
    for vn: liveBefore.iterate loop {
        if (liveAfter.has item: vn) == false then {
            taken.add item: vn
            st.clearTaken nameId: (zast.nameid.create from: vn.u32)
        }
    }
}

# invalidateTakenAcross -- after the whole if, mark every var taken in some arm as
# taken in the enclosing scope (it is consumed on at least one path, so a later use
# is use-after-take).
invalidateTakenAcross: function {st: zenv.ZSymbolTable names: (IdSet u32).view} is {
    for vn: names.iterate loop {
        st.invalidate nameId: (zast.nameid.create from: vn.u32) loc: (optionval.none ztypes.zsrcpos)
    }
}
# ifExpressionType -- the type an `if` used as an EXPRESSION produces: never when
# every branch diverges, otherwise the type its branches agree on -- and null when
# a branch produces no value or the else is missing, since one path then yields
# nothing.
ifExpressionType: function {
    st: zenv.ZSymbolTable
    ifnode: ifref
    branchTypes: (ListVal u64).view
    allDiverge: bool
    hasElse: bool
    anyEmpty: bool
    nvId: u64
    nullId: u64
} out ztypes.tid is {
    result: ztypes.tid
    if allDiverge then {
        if nvId > 0 then {
            result = ztypes.tid.create from: nvId.u64
            setk: result
            stampGate :st nid: ifnode.nid.u64 tid: setk
        }
    } else {
        # An exhaustive (else-carrying) if is a value: the first completing
        # branch's type, diverging branches skipped (mirrors the match rule).
        if hasElse when anyEmpty then {
            # an empty (`{}` / null) branch body makes the if valueless:
            # stamp null so consuming it as a value is rejected.
            if nullId > 0 then {
                result = ztypes.tid.create from: nullId.u64
                stampedTid: result
                stampGate :st nid: ifnode.nid.u64 tid: stampedTid
            }
        }
        if hasElse when (anyEmpty) == false then {
            ti: u64
            tn: branchTypes.length
            for ti < tn loop {
                bt2: branchTypes.get i: ti
                if bt2 != nvId then {
                    if bt2 > 0 then {
                        result = ztypes.tid.create from: bt2.u64
                        setv: result
                        stampGate :st nid: ifnode.nid.u64 tid: setv
                        ti = tn
                    } else {
                        ti = tn
                    }
                }
                ti = ti + 1
            }
        }
    }
    return result
}
# checkIfClauses -- walk each clause: its conditions, the facts they establish for
# the arm's body, and the body itself. A clause the fold proved dead is not walked
# at all -- the language does not promise to resolve names inside it, and that is
# what keeps a statically-eliminated branch from demanding its unit's link
# library. flagsOut reports allDiverge and anyEmpty.
checkIfClauses: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    ifnode: ifref
    accFacts: (List ArmPredFact)
    guardFacts: (List ArmPredFact)
    branchTypes: (ListVal u64)
    liveBefore: (IdSet u32).view
    takenAcross: IdSet u32
    skipDead: bool
    pBool: u64
    flagsOut: (ListVal bool)
    fbr: ztyping.foldedbranch
} is {
    allDiverge: true
    anyEmpty: false
    kC: u64
    for kC < ifnode.nclauses loop {
        clauseId: zast.ifClauseAt :ast nid: ifnode.nid i: kC
        kC = kC + 1
        clause: ifClauseRefAt :ast nid: clauseId
        dead: false
        if (clause.nid.isZero) == false then {
            if (isEmptyBody n: (ast.nodes.get i: clause.statement.u64)) then anyEmpty = true
            if skipDead when clause.statement != fbr.stmt then dead = true
        }
        if dead then continue
        bm: st.pushBlock name: "if_branch"
        with pfit: accFacts.iterate do for pf: pfit loop (applyPredFact
            :ast
            :st
            f: pf
            holds: false
        )
        cfacts: (List ArmPredFact)
        bt: checkClause :st :unitDecl :ast :clause factsOut: cfacts boolId: pBool
        dvgC: st.isUnreachable
        btc: bt
        branchTypes.append btc
        if st.isUnreachable then {
            # a diverging arm transfers ownership on a path that never reaches
            # fall-through: drop its take overlays before pop so they don't
            # bubble into the parent scope (where post-if uses would see the
            # variable as taken).
            st.discardTakenInCurrentScope
        } else {
            allDiverge = false
            restoreTakenArm :st :liveBefore taken: takenAcross
        }
        st.popTo marker: bm
        cn1c: clause.nconds
        if cn1c == 1 when cfacts.length == 1 then {
            mvf: cfacts.pop
            if dvgC then {
                gf: (ArmPredFact
                    subject: mvf.subject
                armName: mvf.armName
                fullTid: mvf.fullTid
                negated: mvf.negated
            )
            guardFacts.append gf
        }
        accFacts.append mvf
    }
    }
    flagsOut.append allDiverge
    flagsOut.append anyEmpty
}


# typecheck an if-expression, narrowing types across its arms.
checkIf: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    ifnode: ifref
} out ztypes.tid is {
    # Which clause a constant condition selects, recorded for the emitter. Most
    # body conditions name a local and do not fold at all, and the stamp says
    # so -- `known: false` means "emit a runtime if", which is the answer for
    # every ordinary branch. Only a condition made of constants decides
    # anything here.
    fbr: foldIfBranch :st frame: st.curFrame :ast :unitDecl nid: ifnode.nid
    constFailClear :st
    # A clause the fold proved dead is reached by no use site, and the language
    # does not promise to resolve names or check types inside it. NOT walking it
    # is what keeps a statically-eliminated branch from demanding its unit's
    # link library, and from being refused by a toolchain that never sees the
    # type it names. `--eager` -- and so zls and `zl lint --full` -- still walks
    # everything, which is what keeps the editor alive inside a branch that is
    # dead only on this host; neither of those emits C, so no artifact differs.
    skipDead: false
    if fbr.known when (st.typing.eagerAll) == false then skipDead = true
    ifMarker: st.pushBlock name: "if"
    liveBefore: st.getLiveOwnedVars
    takenAcross: (IdSet u32)
    nvId: (optU64Or
        o: (walkLookupTyperef :st frame: st.curFrame :ast :unitDecl base: "never")
        d: 0
    )
    nullId: (optU64Or
        o: (walkLookupTyperef :st frame: st.curFrame :ast :unitDecl base: "null")
        d: 0
    )
    pBool: (optU64Or
        o: (walkLookupTyperef :st frame: st.curFrame :ast :unitDecl base: "bool")
        d: 0
    )
    accFacts: (List ArmPredFact)
    guardFacts: (List ArmPredFact)
    elseDvg: false
    branchTypes: (ListVal u64)
    flagsOut: (ListVal bool)
    (checkIfClauses
        :st
        :unitDecl
        :ast
        :ifnode
        :accFacts
        :guardFacts
        :branchTypes
        :liveBefore
        :takenAcross
        :skipDead
        :pBool
        :flagsOut
        :fbr
    )
    allDiverge: flagsOut.get i: 0
    anyEmpty: flagsOut.get i: 1
hasElse: false
if ifnode.elseclause > 0 then {
    hasElse = true
    if (isEmptyBody n: (ast.nodes.get i: ifnode.elseclause.u64)) then anyEmpty = true
    elseDead: false
    if skipDead when ifnode.elseclause != fbr.stmt then elseDead = true
    if (elseDead) == false then {
        ebm: st.pushBlock name: "if_else"
        with efit: accFacts.iterate do for ef: efit loop (applyPredFact
            :ast
            :st
            f: ef
            holds: false
        )
        walkBodyAt :st :unitDecl :ast bodyId: ifnode.elseclause
        et: lastStmtType :st :ast block: (ast.nodes.get i: ifnode.elseclause.u64)
        if st.isUnreachable then elseDvg = true
        etc: et
        branchTypes.append etc
        if st.isUnreachable then {
            st.discardTakenInCurrentScope
        } else {
            allDiverge = false
            restoreTakenArm :st :liveBefore taken: takenAcross
        }
        st.popTo marker: ebm
    }
} else {
    allDiverge = false
    }
    result: (ifExpressionType
        :st
        :ifnode
        :branchTypes
        :allDiverge
        :hasElse
        :anyEmpty
        :nvId
        :nullId
    )
    st.popTo marker: ifMarker
    # post-guard flow typing: a diverging clause's condition was FALSE for
    # the remainder of the enclosing scope; a diverging else of a single-
    # clause if means its condition was TRUE. Apply that knowledge (the
    # exclusion collapse shadows to the payload where one arm remains) and
    # record it for the emitter's block aliasing.
    pgSubj: zast.nameid
    pgTid: u64
    pgApplied: u64
    with gfit: guardFacts.iterate do for gf2: gfit loop {
        applyPredFact :ast :st f: gf2 holds: false
        pgSubj = gf2.subject
        pgTid = gf2.fullTid
        pgApplied = pgApplied + 1
    }
    if elseDvg when ifnode.nclauses == 1 when accFacts.length == 1 then {
        af0: accFacts.get i: 0
        applyPredFact :ast :st f: af0 holds: true
        pgSubj = af0.subject
        pgTid = af0.fullTid
        pgApplied = pgApplied + 1
    }
    if pgApplied == 1 when (pgSubj.isZero) == false then {
        (postGuardRecord
            :st
            stmtNid: ifnode.nid
            subject: pgSubj
            fullTid: (ztypes.tid.create from: pgTid.u64)
        )
    }
    invalidateTakenAcross :st names: takenAcross
    if allDiverge then st.markUnreachable
    return result
}
# reportMissingBinopMethod -- the receiver declares no method for this operator.
# `!=` derives from `==`, so it only errors when `==` is unavailable too, and a
# comparison against a compatible type answers bool rather than nothing.
reportMissingBinopMethod: function {
    st: zenv.ZSymbolTable
    ast: Ast
    binop: binref
    opnId: zast.nameid
    lt: ztypes.tid
    dt: ztypes.tid
    isCmp: bool
} out ztypes.tid is {
    # an owned copy: the lookups below lend ast
    opn: zast.nameTextCopy :ast ref: opnId
    if isCmp then {
        # `!=` derives from `==`: only error when `==` is also unavailable.
        if opn == "!=" then {
            (forceMemberOf
                :st
                frame: st.curFrame
                :ast
                parentTypeId: dt
                nameId: zast.names.wkOpEq
            )
            eqEdge: st.typing.declChildOfId parentTypeId: dt nameId: zast.names.wkOpEq
            if eqEdge.some then {
                boD: builtinTidTc :ast :st base: "bool"
                if boD > 0 then return boD
                return (ztypes.tid.create from: lt)
            }
        }
        # Ordering comparisons have no structural fallback: unlike `==` /
        # `!=` there is no structural ordering, so the operand type must
        # declare the operator (numerics declare all six). An undeclared
        # `<` / `>` / `<=` / `>=` -- on a resultval or any other aggregate --
        # is a hard error, not invalid C.
        isOrd: false
        if opn == "<" then isOrd = true
        if opn == ">" then isOrd = true
        if opn == "<=" then isOrd = true
        if opn == ">=" then isOrd = true
        if isOrd then {
            lnOr: st.reg.nameOf tid: (ztypes.tid.create from: dt.u64)
            mgOr: "type '\{lnOr}' has no '\{opn}' method"
            (addError
                :st
                nodeid: binop.nid
                lineno: binop.lineno
                colno: binop.colno
                e: zast.err.typeError
                msg: mgOr
            )
            return (ztypes.tid.create from: 0)
        }
        # A concrete type that declares no comparison method -- a class or
        # union without `==`, or a record/variant that opted out with
        # `==: null` -- is a hard error rather than invalid C.
        if (memberStrictType :st bt: dt) then {
            lnc: st.reg.nameOf tid: (ztypes.tid.create from: dt.u64)
            mgc: "type '\{lnc}' has no '\{opn}' method"
            (addError
                :st
                nodeid: binop.nid
                lineno: binop.lineno
                colno: binop.colno
                e: zast.err.typeError
                msg: mgc
            )
            return (ztypes.tid.create from: 0)
        }
        bo: builtinTidTc :ast :st base: "bool"
        if bo > 0 then return bo
        return (ztypes.tid.create from: lt)
    }
    # A concrete aggregate (record / class / union / variant, including a
    # generic mono like resultval) that declares no arithmetic operator is a
    # type error rather than invalid C. Type params, protocols, facets and
    # non-aggregates resolve elsewhere and keep the coercible lhs result.
    aTt: st.reg.typetypeOf typeId: dt
    aAgg: false
    if aTt == ztypes.ztypetype.recordType then aAgg = true
    if aTt == ztypes.ztypetype.classType then aAgg = true
    if aTt == ztypes.ztypetype.unionType then aAgg = true
    if aTt == ztypes.ztypetype.variantType then aAgg = true
    if aAgg then {
        ln: st.reg.nameOf tid: (ztypes.tid.create from: dt.u64)
        noMethodMsg: "type '\{ln}' has no '\{opn}' method"
        (addError
            :st
            nodeid: binop.nid
            lineno: binop.lineno
            colno: binop.colno
            e: zast.err.typeError
            msg: noMethodMsg
        )
        return (ztypes.tid.create from: 0)
    }
    return (ztypes.tid.create from: lt)
}
# checkBinopMethodArg -- the right operand must suit the operator method's declared
# parameter, and a comparison answers bool whatever the method's own return says.
checkBinopMethodArg: function {
    st: zenv.ZSymbolTable
    ast: Ast
    binop: binref
    lt: ztypes.tid
    rt: ztypes.tid
    opo: u64
    isCmp: bool
    ltLit: bool
} out ztypes.tid is {
    oParamT: ztypes.tid
    p0n: (positionalParamName
        :ast
        :st
        funcId: (ztypes.tid.create from: opo.u64)
        idx: 0
        skipRecv: true
    )
    if p0n.length > 0 then {
        ppo: (st.typing.declChildOf
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: opo.u64)
            name: p0n.stringView
        )
        match (
            ppo
        ) case some then {
            oParamT = ztypes.tid.create from: (ppo)
        } case none then null
    }
    if oParamT > 0 when rt > 0 then {
        if (typesCompatible :ast :st a: rt b: oParamT) == false then {
            skipA: false
            strT9x: builtinTidTc :ast :st base: "String"
            svT9x: builtinTidTc :ast :st base: "StringView"
            rSty: false
            if rt == strT9x then rSty = true
            if rt == svT9x then rSty = true
            pSty: false
            if oParamT == strT9x then pSty = true
            if oParamT == svT9x then pSty = true
            if rSty when pSty then skipA = true
            ptt: st.reg.typetypeOf typeId: oParamT
            if ptt == ztypes.ztypetype.protocolType then skipA = true
            if ptt == ztypes.ztypetype.facetType then skipA = true
            if ptt == ztypes.ztypetype.genericParam then skipA = true
            if ptt == ztypes.ztypetype.functionType then skipA = true
            if (skipA) == false then {
                ea: st.reg.nameOf tid: (ztypes.tid.create from: oParamT.u64)
                aa: st.reg.nameOf tid: (ztypes.tid.create from: rt.u64)
                # an unresolved got-side renders empty: suppress the
                # knock-on when a prior error explains it, else name it
                if aa.length == 0 then {
                    if st.typing.errors.length > 0 then return (ztypes.tid.create from: 0)
                    aa = "an unresolved value".string
                }
                mma: "argument type mismatch: expected \{ea}, got \{aa}"
                (addError
                    :st
                    nodeid: binop.nid
                    lineno: binop.lineno
                    colno: binop.colno
                    e: zast.err.callError
                    msg: mma
                )
                return (ztypes.tid.create from: 0)
            }
        }
    }
    if isCmp then {
        cb: builtinTidTc :ast :st base: "bool"
        if cb > 0 then return cb
        return (ztypes.tid.create from: lt)
    }
    if ltLit then return (ztypes.tid.create from: lt)
    oro: methodReturnOf :st mid: (ztypes.tid.create from: opo.u64)
    match (
        oro
    ) case some then {
        return oro
    } case none then null
    return (ztypes.tid.create from: lt)
}

# checkBinopMethodDispatch -- resolve a binary operator as a declared method on
# the lhs type: materialise a bare-literal lhs for dispatch, chase typedef bases
# to the type that declares the operator, arg-check the rhs against the method's
# first parameter, and return the result type. For a comparison (isCmp) an
# undeclared operator falls back to bool -- structural `==`/`!=` on records and
# variants; for arithmetic an undeclared operator on a concrete type is an error
# and a bare-literal lhs keeps its coercible literal result. Returns 0 on an
# emitted arg-mismatch.
checkBinopMethodDispatch: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    binop: binref
    opnId: zast.nameid
    lt: ztypes.tid
    rt: ztypes.tid
    isCmp: bool
} out ztypes.tid is {
    ltLit: isLiteralTypeId :st tid: (ztypes.tid.create from: lt.u64)
    dt: lt
    if ltLit then dt = materialiseLiteral :ast :st :unitDecl t: lt
    (forceMemberOf :st frame: st.curFrame :ast parentTypeId: dt nameId: opnId)
    opo: st.typing.declChildOfId parentTypeId: dt nameId: opnId
    # `!=` on a type that writes its own `==` is that `==` negated, and looking
    # for it in the typedef BASE would answer with the base's raw comparison
    # instead -- silently discarding the equality the author defined. The
    # derived-inequality leg below owns this case, so the chase stops here and
    # leaves it to it.
    chase: true
    if opo.none when opnId == zast.names.wkOpNe then {
        (forceMemberOf :st frame: st.curFrame :ast parentTypeId: dt nameId: zast.names.wkOpEq)
        eqHere: st.typing.declChildOfId parentTypeId: dt nameId: zast.names.wkOpEq
        if eqHere.some then chase = false
    }
    if chase then {
        for opo.none while (typedefBaseOf :st tid: (ztypes.tid.create from: dt.u64)) > 0 loop {
            dt = typedefBaseOf :st tid: (ztypes.tid.create from: dt.u64)
            (forceMemberOf :st frame: st.curFrame :ast parentTypeId: dt nameId: opnId)
            opo = st.typing.declChildOfId parentTypeId: dt nameId: opnId
        }
    }
    # a Box is a heap pointer around ONE valtype and declares no members of its
    # own, so its operators are the boxed element's -- ALWAYS, not only when
    # the Box itself resolves nothing. Under --eager every member is minted,
    # the Box then answers the lookup with an edge of its own, and the operator
    # would be attributed to a type that declares no operators: the same
    # program resolved `Box i64 + i64` to i64 when demanded and to Box_i64 when
    # eager. The element's declaration wins wherever there is one.
    if (st.reg.isBoxOf tid: dt) then {
        if (st.reg.genericArgCount specId: dt) == 1 then {
            bx: st.reg.genericArgAt specId: dt ordinal: 0
            if bx > 0 then {
                bxt: ztypes.tid.create from: bx.u64
                (forceMemberOf :st frame: st.curFrame :ast parentTypeId: bxt nameId: opnId)
                bxo: st.typing.declChildOfId parentTypeId: bxt nameId: opnId
                match (
                    bxo
                ) case some then {
                    dt = bxt
                    opo = optionval.some (bxo)
                } case none then null
            }
        }
    }
    bmid: ztypes.tid
    match (
        opo
    ) case some then {
        bmid = ztypes.tid.create from: opo.u64
    } case none then null
    # the same refusal checkDotted makes for the named call form. An operator
    # is the call form for a one-argument method, so an operator declared
    # `{:this rhs: type}` on an interface is the self-typed case every time --
    # which is why every operator on a facet hit this and no named method did
    # until one was written to.
    if (refuseSelfTypedMember
        :st
        :ast
        recvTid: dt
        nameId: opnId
        nodeid: binop.nid
        lineno: binop.lineno
        colno: binop.colno
    ) then return (ztypes.tid.create from: 0)
    stampBinopOp :st nid: binop.nid.u64 owner: dt method: bmid
    match (
        opo
    ) case some then {
        return (checkBinopMethodArg
            :st
            :ast
            :binop
            :lt
            :rt
            :opo
            :isCmp
            :ltLit
        )
    } case none then {
        return (reportMissingBinopMethod
            :st
            :ast
            :binop
            :opnId
            :lt
            :dt
            :isCmp
        )
    }
}

# checkBinop -- type a binary operator expression. Both operands are walked (so
# their nodes are stamped), then the operator resolves as a declared method on
# the operand type via checkBinopMethodDispatch (comparisons yield bool; an
# undeclared comparison falls back to structural equality).
checkBinop: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    binop: binref
} out ztypes.tid is {
    result: ztypes.tid
    # an operand that typed to nothing and raised nothing is an unresolvable
    # name: report it here, where the operand is consumed. Without it the 0
    # silently disables the dispatch's own checks and the emitter writes the
    # bare name into the C -- the same rule the argument and return legs follow.
    errL: st.typing.errors.length
    lt: checkValueAt :st :unitDecl :ast nid: binop.lhs
    if lt.u64 == 0 when st.typing.errors.length == errL then {
        (reportUnresolvedValue
            :st
            :unitDecl
            :ast
            nid: binop.lhs
        )
    }
    errR: st.typing.errors.length
    rt: checkValueAt :st :unitDecl :ast nid: binop.rhs
    if rt.u64 == 0 when st.typing.errors.length == errR then {
        (reportUnresolvedValue
            :st
            :unitDecl
            :ast
            nid: binop.rhs
        )
    }
    # the operator's name id and comparison shape are read through a view
    # scoped to this block: the dispatch below lends ast
    opnId: zast.nameid
    isCmp: false
    {
        opnId = atomNameId :ast n: (ast.nodes.get i: binop.operator.u64)
        opn: zast.nameTextAt :ast ref: opnId
        isCmp = isComparisonOp name: opn.stringView
    }
    result = checkBinopMethodDispatch :st :unitDecl :ast :binop :opnId :lt :rt :isCmp
    tdb2: typedefBaseOf :st tid: result
    if tdb2 > 0 then result = tdb2
    if result > 0 when (st.reg.typetypeOf typeId: result) == ztypes.ztypetype.genericParam then {
        # Structural pass-through: the SAME parameter on both sides flows
        # through arithmetic as itself (the per-instance clone checks remain
        # the arithmetic backstop); mixed operands stay untyped.
        if (result == rt) == false then return (ztypes.tid.create from: 0)
    }
    if result > 0 then stampGate :st nid: binop.nid.u64 tid: result
    return result
}

# argIsTrivial -- true when a call argument's operation is a hoisting no-op: a
# bare atom, a labelvalue, a string literal without interpolation, or an
# expression wrapping a bare atom / labelvalue. Anything else (binop, call,
# dotted path, interpolated string) hoists into a synth temp.
argIsTrivial: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case atomid then {
        return true
    } case labelvalue then {
        return true
    } case atomstring then {
        spiter: op.stringparts.iterate
        for spId: spiter loop {
            sp: ast.nodes.get i: spId.u64
            match (
                sp
            ) case stringchunk then null else {
                return false
            }
        }
        return true
    } case expression then {
        opx: ast.nodes.get i: op.expression.u64
        match (
            opx
        ) case atomid then {
            return true
        } case labelvalue then {
            return true
        } else {
            return false
        }
    } else {
        return false
    }
}

# hoistArg -- hoist a non-trivial call argument into a fresh `_tN` synth temp:
# define the temp (OWNED, synth origin anf) in the open CALL scope and record
# the synth Assignment / value-Expression / AtomId rows + their type stamps for
# the dump. The parsed argument keeps its own stamps; only the dump rows are
# synthesised (no AST mutation).
# typeIsReftype -- a registered type whose isValtype flag is explicitly false
# (classes, unions, protocols, heap natives like String). Unset or unregistered
# ids are not reftypes.
typeIsReftype: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    return (st.reg.isReftypeOf :tid)
}

# typeIsValtype -- a registered type whose isValtype flag is explicitly true
# (records, variants, facets, primitives). Unset or unregistered ids are not
# valtypes.
typeIsValtype: function {
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out bool is {
    st
    return (st.reg.isValtypeOf :tid)
}

# innermostNodeId -- the node id of a value with its expression wrappers
# stripped (the node the dump's descent reads first); 0 for uncovered kinds.
innermostNodeId: function {ast: Ast.view n: Node.view} out zast.nodeid is {
    match (
        n
    ) case expression then {
        return (innermostNodeId :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        return (nodeId :n)
    }
}

# pathRootName -- the leftmost bare atom of a value path (`a.b.c` -> a,
# through expression wrappers), "" when the root is not a bare atom.
pathRootName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (pathRootName :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (pathRootName :ast n: (ast.nodes.get i: n.parent.u64))
    } case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# taggedRecvIsValue -- the dotted receiver denotes a VALUE (a variable at
# the path root, or a call result), not a type/unit reference.
taggedRecvIsValue: function {ast: Ast.view st: zenv.ZSymbolTable.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (taggedRecvIsValue :ast :st n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        return true
    } else {
        rn0: pathRootName :ast :n
        if rn0.length == 0 then return false
        rvo0: st.lookupVarId nameId: (nameIdOf :ast name: rn0.stringView)
        match (
            rvo0
        ) case some then {
            return true
        } case none then {
            return false
        }
    }
}

# bareAtomName -- the (expression-unwrapped) bare atom name of a value node,
# or "" when the value is any other shape.
# bareAtomNameId -- the interned name id of an expression-unwrapped bare atom,
# 0 for any other shape. The id twin of bareAtomName.
bareAtomNameId: function {ast: Ast.view n: Node.view} out zast.nameid is {
    match (
        n
    ) case expression then {
        return (bareAtomNameId :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return n.name
    } else {
        return (zast.nameid.create from: 0)
    }
}

bareAtomName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (bareAtomName :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# methodReceiverRoot -- the bare root name of a dotted callable's receiver
# (`a.compare` -> a), "" for non-dotted or non-bare receivers.
methodReceiverRoot: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case dottedpath then {
        return (bareAtomName :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# methodReceiverTuple -- the full dotted path of a method call's receiver
# (everything before the method name): `st.typing.decls.get` -> [st, typing,
# decls]. Empty when the callable is not a dotted path or the receiver
# is not a plain path. Path-scoped locks need the full tuple so sibling
# fields stay independent.
methodReceiverTuple: function {ast: Ast.view n: Node.view dst: (ListVal zast.nameid)} is {
    match (
        n
    ) case dottedpath then {
        appendValueTuple :ast n: (ast.nodes.get i: n.parent.u64) :dst
    } else null
}

# dottedParentNodeId -- the nodeid of a dotted callable's receiver expression
# (its stamped type is the immediate receiver type); 0 otherwise.
dottedParentNodeId: function {ast: Ast.view n: Node.view} out zast.nodeid is {
    match (
        n
    ) case dottedpath then {
        return (nodeId n: (ast.nodes.get i: n.parent.u64))
    } else {
        return (zast.nodeid.create from: 0)
    }
}

# positionalParamName -- the funcId's parameter name at `idx` (declaration
# order), "" when absent. Positional call args map to it. With
# skipRecv, receiver rows (`this` or the fn's thisParamName) are excluded
# from the count: a dotted method call supplies the receiver implicitly, so
# its positional args map onto the remaining params.
# memberIsSelfTyped -- a member of `ifaceTid` with a parameter of the
# INTERFACE'S OWN type, the receiver excluded. `type` inside an interface means
# the interface, so `near: function {:this rhs: type}` asks for a
# conformer-to-conformer call -- and a vtable cannot type one, because the slot
# would have to name a single implementation's argument and there may be many.
# The emitter omits the slot and the wrapper for such a member; this is the
# same question, asked where a call to it can still be refused with something
# better than a C compiler's opinion.
memberIsSelfTyped: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    ifaceTid: ztypes.tid
    memberTid: ztypes.tid
} out bool is {
    found: false
    ppi: u64
    ppn: st.typing.declRowSlots ownerTid: memberTid
    for ppi < ppn loop {
        prow: st.typing.declRowAt ownerTid: memberTid membersOnly: false slot: ppi
        ppi = ppi + 1
        if prow.keep then {
            pnid: prow.name
            isRecv: false
            if pnid == zast.names.wkThis.u64 then isRecv = true
            if (st.reg.thisParamNameIs
                tid: memberTid
                nameId: (zast.nameid.create from: pnid.u32.orPanic)
            ) then isRecv = true
            tnB: ast.names.texts.get i: pnid.u64
            if (isRecv) == false then {
                pto: (st.typing.declChildOf
                    pool: ast.names
                    parentTypeId: memberTid
                    name: tnB.stringView
                )
                match (
                    pto
                ) case some then {
                    if pto == ifaceTid.u64 then found = true
                } case none then null
            }
        }
    }
    return found
}

# refuseSelfTypedMember -- report and answer true when `nameId` names a member
# of an interface-typed receiver that cannot be dispatched. Both call forms ask
# it: a dotted call reaches it through checkDotted, an operator through
# checkBinopMethodDispatch, and neither should be deciding this for itself.
refuseSelfTypedMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    recvTid: ztypes.tid
    nameId: zast.nameid
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} out bool is {
    btt: st.reg.typetypeOf typeId: recvTid
    isIface: false
    if btt == ztypes.ztypetype.protocolType then isIface = true
    if btt == ztypes.ztypetype.facetType then isIface = true
    if (isIface) == false then return false
    mo: st.typing.declChildOfId parentTypeId: recvTid :nameId
    match (
        mo
    ) case some then {
        mtid: ztypes.tid.create from: mo
        if (memberIsSelfTyped :ast :st ifaceTid: recvTid memberTid: mtid) then {
            iname: st.reg.nameOf tid: recvTid
            # the member's own spelling, read only HERE: this is the one path
            # that renders it, and every call in the program reaches the test
            mtxt: zast.nameTextCopy :ast ref: nameId
            (reportSelfTypedDispatch
                :st
                ifaceName: iname.stringView
                memberName: mtxt.stringView
                :nodeid
                :lineno
                :colno
            )
            return true
        }
    } case none then null
    return false
}

# reportSelfTypedDispatch -- the refusal, said once and in the interface's own
# terms. E0300 because it is a call that cannot be made, not a type that does
# not exist: the member is declared, the conformer implements it, and what is
# missing is any single signature a vtable slot could carry.
reportSelfTypedDispatch: function {
    st: zenv.ZSymbolTable
    ifaceName: StringView
    memberName: StringView
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    ms: "'\{memberName}' takes a parameter of type '\{ifaceName}' itself, so it cannot be called through the interface"
    (addError
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.callError
        msg: ms
    )
}

# ctorSelfRecursionAt -- refuse a construction of the enclosing type from
# inside that type's own `create`: the constructor calls itself, without bound,
# and the program that results compiles clean and dies on a stack overflow.
# Both halves are id compares, and the second asks the RESOLVED member's own
# declaration rather than testing that the enclosing function is SPELLED
# `create`: a `create` a class declares in its body block is not that class's
# registered constructor, never runs as one, and a body reaching it is not
# recursing. E0300 because it is a call that cannot be made. The hint is the
# spec's own (docs/spec.pdoc "Constructor"): inside a create body, `meta.create`
# is what produces the instance.
ctorSelfRecursionAt: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u32
    ctorTid: ztypes.tid
} out bool is {
    if ctorTid.isZero then return false
    tt: st.typing.currentThisTid
    if tt.isZero then return false
    if (ctorTid == tt) == false then return false
    ft: st.typing.currentFnTid
    if ft.isZero then return false
    cro: st.typing.declChildOfId parentTypeId: tt nameId: zast.names.wkCreate
    crid: ztypes.tid
    match (
        cro
    ) case some then {
        crid = ztypes.tid.create from: (cro)
    } case none then null
    if crid.isZero then return false
    if (ft == crid) == false then return false
    tnm: st.reg.nameOf tid: tt
    ms: "'\{tnm}' constructs itself from inside its own 'create'"
    hs: "use 'meta.create' to produce the instance".string
    en: String
    (addErrorH
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.callError
        msg: ms
        note: en
        hint: hs
        :width
    )
    return true
}

positionalParamName: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    funcId: ztypes.tid
    idx: u64
    skipRecv: bool
} out String is {
    result: String
    found: false
    seen: u64
    ppi: u64
    ppn: st.typing.declRowSlots ownerTid: funcId
    for ppi < ppn loop {
        prow: st.typing.declRowAt ownerTid: funcId membersOnly: false slot: ppi
        ppi = ppi + 1
        ppnid: prow.name
        if prow.keep when (found) == false then {
            tnB: ast.names.texts.get i: ppnid.u64
            isRecv: false
            if skipRecv then {
                if tnB.stringView == "this" then isRecv = true
                if (st.reg.thisParamNameIs
                    tid: funcId
                    nameId: (zast.nameid.create from: ppnid.u32.orPanic)
                ) then isRecv = true
            }
            if (isRecv) == false then {
                if seen == idx then {
                    result = tnB.copy
                    found = true
                }
                seen = seen + 1
            }
        }
    }
    return result
}

# lockCallArg -- the call-scoped EXCLUSIVE lock a lock/borrow parameter takes
# on its argument's root for the call's duration (the symtab appends the lock
# overlay entry in the open call scope; it vanishes when the scope pops).
markVarMutated: function {st: zenv.ZSymbolTable nameId: zast.nameid} is {
    if nameId.isZero then return
    vo: st.lookupVarId :nameId
    match (
        vo
    ) case some then {
        mk: vo
        st.typing.variableMutated.add item: mk
    } case none then null
}

lockCallArg: function {
    st: zenv.ZSymbolTable
    pool: zast.StringPool.view
    nameId: zast.nameid
    callId: u64
    shared: bool
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    # a NON-shared lock is a mutable use: the callee may write through it
    if (shared) == false then markVarMutated :st :nameId
    pth: (ListVal zast.nameid)
    pth.append nameId
    h: (ztypes.zlockholder kind: ztypes.zlockholderkind.callKind id: callId)
    clk: ztypes.zlockstate.exclusive
    if shared then clk = ztypes.zlockstate.shared
    r: (st.tryLock
        :pool
        path: pth
        lockType: clk
        lockScope: ztypes.zlockscope.target
        holder: h
    )
    if r.length > 0 then addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: r
}

# lockCallPath -- call-scoped path lock over a full receiver tuple: SHARED
# on the strict prefixes, reader/writer kind on the leaf. The prefixes are
# intent locks, so they never block the leaf they were taken for.
lockCallPath: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    pool: zast.StringPool.view
    path: (ListVal zast.nameid).view
    callId: u64
    shared: bool
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    n: path.length
    if n == 0 then return
    if (shared) == false then {
        # a NESTED receiver (`st.reg.foo`) locks its path exclusively, which is a
        # mutable use of the ROOT. The third and last lock-taking entry point,
        # beside lockCallArg (bare names) and installBorrowLocks (path args).
        markVarMutated :st nameId: (path.get i: 0)
        (checkFrozenWrite
            :st
            :ast
            :path
            verb: "mutate through"
            upTo: path.length
            :nodeid
            :lineno
            :colno
        )
    }
    end: 1.u64
    for end < n loop {
        sub: (ListVal zast.nameid)
        i: u64
        for i < end loop {
            sub.append (path.get :i)
            i = i + 1
        }
        hs: (ztypes.zlockholder kind: ztypes.zlockholderkind.callKind id: callId)
        rs: (st.tryLock
            :pool
            path: sub
            lockType: ztypes.zlockstate.shared
            lockScope: ztypes.zlockscope.intent
            holder: hs
        )
        if rs.length > 0 then addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: rs
        end = end + 1
    }
    full: (ListVal zast.nameid)
    with fpit: path.iterate do for e2: fpit loop full.append e2
    he: (ztypes.zlockholder kind: ztypes.zlockholderkind.callKind id: callId)
    clk: ztypes.zlockstate.exclusive
    if shared then clk = ztypes.zlockstate.shared
    re: (st.tryLock
        :pool
        path: full
        lockType: clk
        lockScope: ztypes.zlockscope.target
        holder: he
    )
    if re.length > 0 then addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: re
}

# lockSuffixBase -- the bare base name of a `<atom>.lock` argument, ""
# otherwise.
lockSuffixBase: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (lockSuffixBase :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        ln: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: n.child.u64))
        if ln.stringView == "lock" then {
            return (bareAtomName :ast n: (ast.nodes.get i: n.parent.u64))
        } else {
            return "".string
        }
    } else {
        return "".string
    }
}

# takenHere -- the location stamp an ownership-transfer overlay carries (pop
# propagates only located takes into the enclosing scope).
takenHere: function {} out optionval ztypes.zsrcpos is {
    return (optionval.some (ztypes.zsrcpos fsno: zvfs.fsno lineno: 0 colno: 0))
}

# consumeBareArgOwnership -- a bare-name reftype value at an OWNING slot (a
# take parameter, a constructor field, a tagged-arm payload): refuse a
# readonly / pinned / borrowed source, else transfer ownership out of it.
consumeBareArgOwnership: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    name: StringView
    vid: ztypes.vid
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    # Readonly first, then ownership: ANY borrowed binding refuses the move
    # (the view-family test predates element borrows).
    if (nameIsReadonly :st :ast :name) then {
        (readonlyMoveError
            :st
            :nodeid
            :lineno
            :colno
            :name
            verb: "into a taking argument"
        )
    } else {
        apin7: (pinnedMoveError
            :st
            :ast
            :nodeid
            :lineno
            :colno
            :name
            verb: "into a taking argument"
        )
        if apin7 then null else if (isBorrowedVar :st :vid) then {
            bnc7: name
            mb7: "Cannot move borrowed variable '\{bnc7}' into a taking argument — borrowed names stay bound to their source for the full scope; copy with '.copy' to keep the source"
            (addError
                :st
                :nodeid
                :lineno
                :colno
                e: zast.err.ownerError
                msg: mb7
            )
        } else {
            (st.invalidate
                nameId: (nameIdOf :ast :name)
                loc: takenHere
            )
        }
    }
}

# appendValueTuple -- the source path of a value node (root first), appended onto
# dst. Ownership and access markers are not addressable segments, so
# `rec.field.borrow` contributes (rec, field); non-path shapes contribute nothing.
appendValueTuple: function {ast: Ast.view n: Node.view dst: ListVal zast.nameid} is {
    match (
        n
    ) case expression then {
        appendValueTuple :ast n: (ast.nodes.get i: n.expression.u64) :dst
    } case atomid then {
        dst.append n.name
    } case dottedpath then {
        appendValueTuple :ast n: (ast.nodes.get i: n.parent.u64) :dst
        cid: atomNameId :ast n: (ast.nodes.get i: n.child.u64)
        if (cid.isZero) == false then {
            ct: zast.poolTextAt pool: ast.names ref: cid
            if (isStripMarker name: ct.stringView) == false then dst.append cid
        }
    } else null
}

# drainPendingBorrow / takePendingBorrow -- clear the borrow side-channel /
# move it into a local list (root-first order preserved).
drainPendingBorrow: function {st: zenv.ZSymbolTable} is {
    for st.typing.pendingBorrowPath.length > 0 loop st.typing.pendingBorrowPath.pop
    st.typing.pendingBorrowShared = false
    st.typing.pendingBorrowReadonly = false
    st.typing.pendingBorrowOwned = false
}

# drain the pending-borrow markers accumulated during argument hoisting.
takePendingBorrow: function {st: zenv.ZSymbolTable dst: ListVal zast.nameid} is {
    with pit: st.typing.pendingBorrowPath.iterate do for e: pit loop dst.append e
    sh: st.typing.pendingBorrowShared
    ro: st.typing.pendingBorrowReadonly
    ow: st.typing.pendingBorrowOwned
    drainPendingBorrow :st
    st.typing.pendingBorrowShared = sh
    st.typing.pendingBorrowReadonly = ro
    st.typing.pendingBorrowOwned = ow
}

# installBorrowLocks -- SHARED on every path prefix, EXCLUSIVE on the leaf
# (the symtab appends one lock overlay entry per acquisition, keyed by the
# path root). Holder = the binding var.
installBorrowLocks: function {
    st: zenv.ZSymbolTable
    pool: zast.StringPool.view
    src: (ListVal zast.nameid).view
    vid: ztypes.vid
    leafShared: bool
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    n: src.length
    if n == 0 then return
    # an EXCLUSIVE leaf is a mutable use of the path's ROOT. This is the other
    # enforcement point beside lockCallArg: a PATH-shaped argument
    # (`pool: program.ast.names`) never reaches lockCallArg, it installs here.
    if (leafShared) == false then markVarMutated :st nameId: (src.get i: 0)
    end: 1.u64
    for end < n loop {
        sub: (ListVal zast.nameid)
        i: u64
        for i < end loop {
            sub.append (src.get :i)
            i = i + 1
        }
        hs: (ztypes.zlockholder kind: ztypes.zlockholderkind.varKind id: vid)
        rs: (st.tryLock
            :pool
            path: sub
            lockType: ztypes.zlockstate.shared
            lockScope: ztypes.zlockscope.intent
            holder: hs
        )
        if rs.length > 0 then addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: rs
        end = end + 1
    }
    full: (ListVal zast.nameid)
    with fsit: src.iterate do for e2: fsit loop full.append e2
    he: (ztypes.zlockholder kind: ztypes.zlockholderkind.varKind id: vid)
    lk: ztypes.zlockstate.exclusive
    if leafShared then lk = ztypes.zlockstate.shared
    re: (st.tryLock
        :pool
        path: full
        lockType: lk
        lockScope: ztypes.zlockscope.target
        holder: he
    )
    if re.length > 0 then addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: re
}

# frozenFieldInPath -- the first segment of a path, up to `upTo`, declared
# `view` or `hold`, or "". The contents of such a field are readonly for the
# instance's whole life; the slot rule (static or not) is the other axis and is
# decided at the declaration. Walks segment by segment, since the frozen field
# may be nested (`b.inner.name`).
#
# `upTo` is what separates writing THROUGH a frozen field from writing the
# field itself: an assignment passes the strict prefix, because assigning the
# slot is the slot rule's business, while a mutating call passes the whole path
# -- there the leaf IS the receiver being mutated.
frozenFieldInPath: function {
    st: zenv.ZSymbolTable.view
    path: (ListVal zast.nameid).view
    upTo: u64
} out zast.nameid is {
    n: upTo
    if n > path.length then n = path.length
    if n < 2 then return (zast.nameid.create from: 0)
    cur: u64
    {
        ro: st.lookup nameId: (path.get i: 0)
        match (
            ro
        ) case some then {
            cur = ro
        } case none then {
            return (zast.nameid.create from: 0)
        }
    }
    i: 1.u64
    for i < n loop {
        seg: path.get :i
        oo: (st.typing.declOwnershipOfId
            parentTypeId: (ztypes.tid.create from: cur.u64)
            nameId: seg
        )
        match (
            oo
        ) case some then {
            if oo == ztypes.zparamownership.viewMode then return seg
            if oo == ztypes.zparamownership.holdMode then return seg
        } case none then null
        co: (st.typing.declChildOfId
            parentTypeId: (ztypes.tid.create from: cur.u64)
            nameId: seg
        )
        match (
            co
        ) case some then {
            cur = co
        } case none then {
            return (zast.nameid.create from: 0)
        }
        i = i + 1
    }
    return (zast.nameid.create from: 0)
}

# pathLeafIsMethod -- the last segment of a path names a METHOD rather than a
# field. A call's result ownership is its signature's business -- `.copy` and
# every owned return are fresh values -- so the deep-readonly rule, which is
# about reading a reftype field out of a readonly path, must not claim them.
pathLeafIsMethod: function {
    st: zenv.ZSymbolTable.view
    path: (ListVal zast.nameid).view
} out bool is {
    n: path.length
    if n < 2 then return false
    cur: u64
    {
        ro: st.lookup nameId: (path.get i: 0)
        match (
            ro
        ) case some then {
            cur = ro
        } case none then {
            return false
        }
    }
    last: n - 1
    i: 1.u64
    for i < n loop {
        co: (st.typing.declChildOfId
            parentTypeId: (ztypes.tid.create from: cur.u64)
            nameId: (path.get :i)
        )
        match (
            co
        ) case some then {
            if i == last then {
                tt: st.reg.typetypeOf typeId: (ztypes.tid.create from: co.u64)
                if tt == ztypes.ztypetype.functionType then return true
                return false
            }
            # An INTERMEDIATE method continues from what it RETURNS, not from
            # the function type: `e.value.copy` walks entry -> value's return
            # (String) -> copy. Reading the segment's own type here dead-ends
            # on the first method in the path, and the walk then reports that
            # the leaf is not a method when it is.
            cur = co
            {
                mtt: st.reg.typetypeOf typeId: (ztypes.tid.create from: co.u64)
                if mtt == ztypes.ztypetype.functionType then {
                    cur = (st.reg.returnTypeOf tid: (ztypes.tid.create from: co.u64)).u64
                }
            }
        } case none then {
            return false
        }
        i = i + 1
    }
    return false
}

# pathIsReadonly -- true when a value path may only be read: it passes through
# a `view`/`hold` field, or its root binding holds a readonly lock on itself (a
# `view` parameter, a `hold` binding). Readonly is deep, so a binding taken
# from such a path is readonly in turn -- otherwise the intermediate name
# launders the restriction away.
pathIsReadonly: function {
    st: zenv.ZSymbolTable.view
    path: (ListVal zast.nameid).view
} out bool is {
    if path.length == 0 then return false
    ff: frozenFieldInPath :st :path upTo: path.length
    if (ff.isZero) == false then return true
    r: path.get i: 0
    rv: st.lookupVarId nameId: r
    if rv.none then return false
    lk: st.findLock nameId: r
    if lk.none then return false
    if lk != ztypes.zlockstate.shared then return false
    lh: st.findLockHolder nameId: r
    if lh.none then return false
    if lh.kind != ztypes.zlockholderkind.varKind then return false
    return lh.id == rv
}

# readonlySelfLock -- make `name` a readonly binding: it holds a shared lock on
# ITSELF, which is how a `view` parameter, a `hold` local, a marked match-arm
# payload and an `out T.view` result all say the same thing. Returns the
# conflict message, or "" when the lock was taken.
readonlySelfLock: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    name: StringView
    vid: ztypes.vid
} out String is {
    if name.length == 0 then return "".string
    if vid.isZero then return "".string
    rsp: (ListVal zast.nameid)
    rsp.append (nameIdOf :ast :name)
    rsh: (ztypes.zlockholder
        kind: ztypes.zlockholderkind.varKind
        id: vid
    )
    return (st.tryLock
        pool: ast.names
        path: rsp
        lockType: ztypes.zlockstate.shared
        lockScope: ztypes.zlockscope.target
        holder: rsh
    )
}

# iterElementIsReadonly -- ask an iterator BINDING what strength of lock it
# holds on the container it walks. A `view` iterator receiver pins SHARED, so
# the elements it hands out may only be read; an exclusive pin yields writable
# ones. Unlike pathIsReadonly this is not a self-lock question -- the holder is
# the iterator and the locked path is the container it recorded as its borrow
# origin.
iterElementIsReadonly: function {
    st: zenv.ZSymbolTable.view
    iterName: zast.nameid
} out bool is {
    if iterName.isZero then return false
    ivo: st.lookupVarId nameId: iterName
    if ivo.none then return false
    cnd: st.reg.variableBorrowOriginOf id: ivo
    if cnd.isZero then return false
    clk: st.findLock nameId: cnd
    if clk.none then return false
    if clk != ztypes.zlockstate.shared then return false
    clh: st.findLockHolder nameId: cnd
    if clh.none then return false
    if clh.kind != ztypes.zlockholderkind.varKind then return false
    return clh.id == ivo
}

# nameIsReadonly -- the one-segment form of pathIsReadonly. A `view` parameter,
# a `hold` binding and a payload narrowed from either each hold a readonly lock
# on their own name, so this answers "may this binding only be read?".
nameIsReadonly: function {st: zenv.ZSymbolTable.view ast: Ast.view name: StringView} out bool is {
    if name.length == 0 then return false
    rop: (ListVal zast.nameid)
    rop.append (nameIdOf :ast :name)
    return (pathIsReadonly :st path: rop)
}

# armPayloadReadonly -- a narrowed match-arm payload takes the readonly
# self-lock when its ARM is declared `view` or `hold`. The payload binds under
# the subject's own name, so the lock lands on that name for the arm's scope
# and every readonly rule -- writes, mutating receivers, moves -- follows from
# it. A readonly SUBJECT needs nothing here: the shadow reuses the name, so its
# lock is still the innermost one found.
armPayloadReadonly: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    subject: zast.nameid
    parentTid: u64
    armName: zast.nameid
    payloadTid: ztypes.tid
} is {
    if subject.isZero then return
    if parentTid == 0 then return
    if payloadTid.isZero then return
    if (typeIsReftype :st tid: (ztypes.tid.create from: payloadTid.u64)) == false then return
    ao: (st.typing.declOwnershipOfId
        parentTypeId: (ztypes.tid.create from: parentTid.u64)
        nameId: armName
    )
    apr: false
    match (
        ao
    ) case some then {
        if ao == ztypes.zparamownership.viewMode then apr = true
        if ao == ztypes.zparamownership.holdMode then apr = true
    } case none then null
    if (apr) == false then return
    svo: st.lookupVarId nameId: subject
    if svo.none then return
    spa: (ListVal zast.nameid)
    spa.append subject
    sho: (ztypes.zlockholder
        kind: ztypes.zlockholderkind.varKind
        id: svo
    )
    slr: (st.tryLock
        pool: ast.names
        path: spa
        lockType: ztypes.zlockstate.shared
        lockScope: ztypes.zlockscope.target
        holder: sho
    )
    if slr.length > 0 then return
}

# pinnedMoveError -- a move out of a binding ANOTHER holder has locked is
# refused: the holder reads or writes through that value, and a move frees it
# out from under them (a StringView over a moved String reads freed memory).
# `.drop` has refused this for a while; the move sites never asked. Reports
# and returns true when it fires, so the caller skips its remaining legs.
pinnedMoveError: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    name: StringView
    verb: StringView
} out bool is {
    if name.length == 0 then return false
    pnid: nameIdOf :ast :name
    pvo: st.lookupVarId nameId: (zast.nameid.create from: pnid.u32)
    if pvo.none then return false
    plk: st.findLock nameId: (zast.nameid.create from: pnid.u32)
    if plk.none then return false
    plh: st.findLockHolder nameId: (zast.nameid.create from: pnid.u32)
    if plh.none then return false
    # A holder that is the binding itself is the readonly case, which
    # readonlyMoveError words better; a call-scoped holder belongs to the
    # statement being checked, not to a live reader.
    if plh.kind != ztypes.zlockholderkind.varKind then return false
    if plh.id == pvo then return false
    phn: st.formatLockHolder pool: ast.names holder: plh
    plsn: zenv.zlockstateNameLower t: plk
    pnm: name
    pvb: verb
    pm: "Cannot move '\{pnm}' \{pvb}: \{plsn} lock held by '\{phn}'"
    pht: "'\{phn}' reads '\{pnm}' -- moving it would leave '\{phn}' pointing at freed memory; end its scope first, or copy with '.copy'"
    pen: String
    (addErrorH
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.ownerError
        msg: pm
        note: pen
        hint: pht
        width: name.length.u32.orPanic
    )
    return true
}

# readonlyMoveError -- a move whose SOURCE may only be read is refused:
# capability may only be given up, so `hold`/`view` never become an owned
# mutable value. `verb` names the move form ("with '.take'", "by
# reassignment", ...).
readonlyMoveError: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    name: StringView
    verb: StringView
} is {
    rmn: name
    rmv: verb
    rmm: "Cannot move readonly variable '\{rmn}' \{rmv} — a readonly binding may only be read; copy with '.copy' to keep the source"
    (addError
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.ownerError
        msg: rmm
    )
}

# checkFrozenWrite -- reject a mutation reaching through a readonly field.
checkFrozenWrite: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    path: (ListVal zast.nameid).view
    verb: StringView
    upTo: u64
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    ff: frozenFieldInPath :st :path :upTo
    if ff.isZero then return
    pp: zenv.formatPath pool: ast.names :path
    ffn: zast.poolTextAt pool: ast.names ref: ff
    mf: "Cannot \{verb} '\{pp}': field '\{ffn}' is readonly"
    (addError
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.ownerError
        msg: mf
    )
}

# checkWriteLock -- a write is rejected while an EXCLUSIVE lock overlapping its
# target path is outstanding: the holder reaches through that path, so the write
# would invalidate what it points at. Sibling paths do not overlap, so a lock on
# one field leaves the others writable.
checkWriteLock: function {st: zenv.ZSymbolTable ast: Ast.view n: Node.view verb: StringView} is {
    wp: (ListVal zast.nameid)
    appendValueTuple :ast :n dst: wp
    if wp.length == 0 then return
    markVarMutated :st nameId: (wp.get i: 0)
    # hoisted: the length read locks wp for its duration, and wp is already
    # an argument to the same call -- one appearance per call.
    wpn: wp.length
    (checkFrozenWrite
        :st
        :ast
        path: wp
        :verb
        upTo: wpn - 1
        nodeid: (nodeId :n)
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
    )
    wrn: wp.get i: 0
    wv: st.lookupVarId nameId: wrn
    if wv.none then return
    wr: zast.poolTextAt pool: ast.names ref: wrn
    pp: zenv.formatPath pool: ast.names path: wp
    wh: st.findExclusiveLock path: wp
    if (wh.none) == false then {
        hn: st.formatLockHolder pool: ast.names holder: wh
        mw: "Cannot \{verb} '\{pp}': exclusive lock held by '\{hn}'"
        wht: String
        if wh.kind == ztypes.zlockholderkind.varKind then {
            wht = "write through '\{hn}' instead, or end '\{hn}'s scope first to release the lock"
        }
        wen: String
        (addErrorH
            :st
            nodeid: (nodeId :n)
            lineno: (nodeLine :n)
            colno: (nodeCol :n)
            e: zast.err.ownerError
            msg: mw
            note: wen
            hint: wht
            width: wr.length.u32.orPanic
        )
        return
    }
    rh: st.findReadBlocker path: wp
    if rh.none then return
    rn: st.formatLockHolder pool: ast.names holder: rh
    ppc: pp
    selfRo: rn.stringView == wr.stringView
    mr: "Cannot \{verb} '\{ppc}': shared lock held by '\{rn}'"
    if selfRo then mr = "Cannot \{verb} '\{ppc}': '\{wr}' is readonly here"
    rht: String
    if rh.kind == ztypes.zlockholderkind.varKind when (selfRo) == false then {
        rht = "'\{rn}' reads this path -- writing it would invalidate what '\{rn}' points at; end its scope first"
    }
    if selfRo then {
        # `view` is not owned, `hold` is -- the self-lock is the same, so the
        # binding's ownership is what tells them apart for the hint.
        rmk: "hold".string
        if (isBorrowedVar :st vid: wv) then rmk = "view".string
        rht = "a `\{rmk}` binding is readonly for its whole scope; take a `.copy` to get a mutable value"
    }

    ren: String
    (addErrorH
        :st
        nodeid: (nodeId :n)
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.ownerError
        msg: mr
        note: ren
        hint: rht
        width: wr.length.u32.orPanic
    )
}

# isLiteralTypeId -- a literal-typed value: one of the registry's two reserved
# literal rows. Bare numeric literals and data-block elements wear them.
isLiteralTypeId: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    if tid == st.reg.literalIntTid then return true
    return tid == st.reg.literalFloatTid
}

# hoist a call argument into a temporary, recording its ownership.
hoistArg: function {ast: Ast
    st: zenv.ZSymbolTable
    argId: zast.nodeid
    argType: ztypes.tid
    paramType: u64
    consumes: bool
    viewParam: bool
} out String is {
    tn: st.typing.nextTempId
    st.typing.nextTempId = tn + 1
    tname: "_t\{tn}"
    # the argument's position, read through a view scoped to this block:
    # the hoist below lends ast
    ln: u32
    co: u32
    {
        argNode: ast.nodes.get i: argId.u64
        ln = nodeLine n: argNode
        co = nodeCol n: argNode
    }
    assignId: zast.tableReserve :ast
    exprId: zast.tableReserve :ast
    atomId: zast.tableReserve :ast
    st.typing.synthNodes.append (ztyping.SynthNode
        nodeid: assignId
        kind: "Assignment"
        ownerUnit: st.typing.synthOwnerUnit
        ownerName: st.typing.synthOwnerName
        lineno: ln
        colno: co)
    st.typing.synthNodes.append (ztyping.SynthNode
        nodeid: exprId
        kind: "Expression"
        ownerUnit: st.typing.synthOwnerUnit
        ownerName: st.typing.synthOwnerName
        lineno: ln
        colno: co)
    st.typing.synthNodes.append (ztyping.SynthNode
        nodeid: atomId
        kind: "AtomId"
        ownerUnit: st.typing.synthOwnerUnit
        ownerName: st.typing.synthOwnerName
        lineno: ln
        colno: co)
    seta: argType
    stampGate :st nid: assignId.u64 tid: (ztypes.tid.create from: seta.u64)
    sete: argType
    stampGate :st nid: exprId.u64 tid: (ztypes.tid.create from: sete.u64)
    atomT: argType
    if paramType > 0 then atomT = ztypes.tid.create from: paramType.u64
    setm: atomT
    stampGate :st nid: atomId.u64 tid: (ztypes.tid.create from: setm.u64)
    hbsrc: (ListVal zast.nameid)
    takePendingBorrow :st dst: hbsrc
    # A borrow path whose LEAF is a method describes a CALL, and a call's
    # result ownership is its signature's business: `.copy` hands back a fresh
    # value, so the temp OWNS it and locking `x.copy` as though it were a field
    # read freezes the source for nothing -- which is what made `.copy`, the
    # escape hatch every readonly diagnostic recommends, fail as an argument.
    # c0b482b applied this rule to bindings; the argument path had its own copy.
    if (pathLeafIsMethod :st path: hbsrc) then {
        for hbsrc.length > 0 loop hbsrc.pop
    }
    hown: ztypes.zownership.owned
    if hbsrc.length > 0 when (typeIsReftype
        :st
        tid: (ztypes.tid.create from: argType.u64)
    ) then hown = ztypes.zownership.borrowed
    vid: st.reg.newVariable ztypeId: argType ownership: hown
    st.reg.setVariableSynthOrigin id: vid origin: "anf".string
    if hown == ztypes.zownership.borrowed then (st.reg.setVariableBorrowOrigin
        id: vid
        origin: (hbsrc.get i: 0)
    )
    tnId: zast.poolSet pool: ast.names text: tname.stringView
    st.defineVar nameId: tnId :vid
    # the hoisted temp is the user-written hoist made explicit: it borrows
    # its source path for the call scope (SHARED prefixes, leaf kind from
    # the side channel), so aliasing between arguments -- or with a live
    # view of the source -- conflicts exactly as the call-scoped locking
    # algorithm in ownership.pdoc requires
    # install only when the consumed side-channel path belongs to THIS
    # argument (its root atom): a stale residue from receiver evaluation
    # must stay drained-without-locks, or it would double the call's own
    # receiver locks under a temp holder
    if hown == ztypes.zownership.borrowed then {
        hrt: rootNameIdOf :ast n: (ast.nodes.get i: argId.u64)
        okInstall: false
        if (hrt.isZero) == false when hbsrc.length > 0 then {
            if (hbsrc.get i: 0) == hrt then okInstall = true
        }
        if okInstall then {
            # A `.view` parameter only reads its argument, so the hoisted temp
            # locks the source SHARED -- exactly as the bare-name leg already
            # did via `isViewArg`. Without this a PATH-shaped argument
            # (`f xs: h.items`) took an exclusive lock and was refused off any
            # readonly holder, while the identical value hoisted to a local by
            # hand was accepted.
            hlfs: viewParam
            if st.typing.pendingBorrowShared then hlfs = true
            (installBorrowLocks
                :st
                pool: ast.names
                src: hbsrc
                :vid
                leafShared: hlfs
                nodeid: argId
                lineno: ln
                colno: co
            )
        }
    }
    st.typing.defVariableId.set key: assignId.u64 value: vid
    if consumes then (st.invalidate
        nameId: (nameIdOf :ast name: tname.stringView)
        loc: (optionval.none ztypes.zsrcpos)
    )
    return tname
}

# dataFieldIds -- a type's user-supplied data fields/params in order, as the
# (name pool id, type id) pairs: for a FUNCTION, all params; for a record/class,
# fnptr fields plus non-FUNCTION fields, excluding as-block constants
# (asConstClone) and conformance markers. dataFieldNames is this plus the texts,
# so what counts as a data field is decided in one place; a caller that only
# needs the ids takes this one and pays for no text at all.
dataFieldIds: function {
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
    ids: ListVal u64
    nameIds: ListVal u64
} is {
    isFn: false
    if (st.reg.typetypeOf typeId: tid) == ztypes.ztypetype.functionType then isFn = true
    # this type's conformance-marker label ids, collected once (the per-field
    # probe below is a scan over these few ids, not the whole table)
    mkIds8: (ListVal u64)
    if isFn == false then {
        with cfit8: st.typing.conformance.iterate do for crow8: cfit8 loop {
            if crow8.implTypeId == tid then mkIds8.append crow8.labelNameId
        }
    }
    # collect the rows first: the fnptr probe below resolves a member
    # declaration, which locks the whole ZTyping this iteration is holding
    rowNids: (ListVal u64)
    rowCtos: (ListVal u64)
    st.typing.declMemberList ownerTid: tid names: rowNids tids: rowCtos
    {
        {
            ri: u64
            for ri < rowNids.length loop {
                tcNameId: rowNids.get i: ri
                cto: rowCtos.get i: ri
                ri = ri + 1
                inc: false
            if isFn then {
                inc = true
            } else {
                fptr: false
                fptr = (st.typing.declIsFnptrFieldId
                    parentTypeId: tid
                    nameId: (zast.nameid.create from: tcNameId.u32.orPanic)
                )
                if fptr then {
                    inc = true
                } else {
                    if cto > 0 when (st.reg.typetypeOf typeId: (ztypes.tid.create from: cto.u64)) != ztypes.ztypetype.functionType then {
                        isC: false
                        aco: st.typing.asConstClone.get key: cto
                        match (
                            aco
                        ) case some then {
                            isC = aco
                        } case none then null
                        isMk8: false
                        mi8: u64
                        mn8: mkIds8.length
                        for mi8 < mn8 loop {
                            mv8: mkIds8.get i: mi8
                            if mv8 > 0 when mv8 == tcNameId then isMk8 = true
                            mi8 = mi8 + 1
                        }
                        if isC == false when isMk8 == false then inc = true
                    }
                }
            }
            if inc then {
                idx0: cto
                ids.append idx0
                nid0: tcNameId
                nameIds.append nid0
            }
            }
        }
    }
}

# dataFieldNames -- dataFieldIds with each field's text alongside its ids. The
# emitter's recFieldLists is this function, so a record's C struct and its
# checked field list cannot drift apart.
dataFieldNames: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
    names: List String
    ids: ListVal u64
    nameIds: ListVal u64
} is {
    dataFieldIds :st :tid :ids :nameIds
    ni: u64
    nn: nameIds.length
    for ni < nn loop {
        nidx: nameIds.get i: ni
        cnBn: ast.names.texts.get i: nidx
        cnn: cnBn.copy
        names.append cnn
        ni = ni + 1
    }
}

# missingCtorFields -- collect each required field/param (no default) of
# `funcId` that the provided labels / positional count do not cover, into
# missingNames/missingIds. The method receiver is implicitly bound; a
# construction's body-carrying FUNCTION-typed (fnptr) fields are auto-bound;
# native types have no required fields.
missingCtorFields: function {
    ast: Ast
    st: zenv.ZSymbolTable
    funcId: ztypes.tid
    isCtor: bool
    provided: (List String).view
    posCount: u64
    missingNames: List String
    missingIds: ListVal u64
} is {
    fzNat: false
    {
        isNative9v: st.reg.isNativeOf tid: funcId
            if isNative9v then fzNat = true
    }
    if fzNat then return
    effId: funcId
    if isCtor then {
        (forceMemberOf
            :st
            frame: st.curFrame
            :ast
            parentTypeId: funcId
            nameId: zast.names.wkCreate
        )
        crId: (optU64Or
            o: (st.typing.declChildOfId parentTypeId: funcId nameId: zast.names.wkCreate)
            d: 0
        )
        if crId > 0 when (st.reg.typetypeOf typeId: (ztypes.tid.create from: crId.u64)) == ztypes.ztypetype.functionType then {
            crBody: false
            crn: st.typing.funcReturnNode.get key: crId
            match (
                crn
            ) case some then {
                crBody = true
            } case none then null
            if crBody then effId = ztypes.tid.create from: crId.u64
        }
    }
    names: (List String)
    ids: (ListVal u64)
    idsNm: (ListVal u64)
    # a WALK consumer: an is-block `function {..} out T` with no body is an
    # fn-ptr FIELD, and an unresolved member carries no type, so it is
    # invisible here rather than reported missing
    forceAllMembers :st frame: st.curFrame :ast tid: effId
    dataFieldNames :ast :st tid: effId :names :ids nameIds: idsNm
    pcnt: names.length
    if pcnt == 0 then return
    thisPn: String
    thisPn = zast.poolTextCopy pool: ast.names ref: (st.reg.thisParamNameIdOf tid: effId)
    vpos: u64
    i: u64
    for i < pcnt loop {
        pname: names.get :i
        pcid: ids.get :i
        pnameId: idsNm.get :i
        i = i + 1
        isRecv: false
        if pnameId == zast.names.wkThis.u64 then isRecv = true
        if thisPn.length > 0 when thisPn.stringView == pname.stringView then isRecv = true
        if (isRecv) == false then {
            posI: vpos
            vpos = vpos + 1
            need: true
            if isCtor when (st.reg.typetypeOf typeId: (ztypes.tid.create from: pcid.u64)) == ztypes.ztypetype.functionType then {
                # only a body-carrying fn type defaults the field (a bodyless
                # SPEC field requires the reference); record and class
                # constructions fill the omitted slot with the field type's
                # symbol (the fnptr-field fill in the emitter's create path)
                fhbOk: optBoolOr o: (st.typing.fnHasBody.get key: pcid) d: false
                effTT: st.reg.typetypeOf typeId: effId
                ctorFill: false
                if effTT == ztypes.ztypetype.recordType then ctorFill = true
                if effTT == ztypes.ztypetype.classType then ctorFill = true
                if fhbOk when ctorFill then need = false
            }
            if (st.typing.declHasDefaultId
                parentTypeId: effId
                nameId: (zast.nameid.create from: pnameId.u32.orPanic)
            ) then need = false
            if need then {
                prov: false
                if posI < posCount then prov = true
                with piter: provided.iterate do for pv: piter loop {
                    if pv.stringView == pname.stringView then prov = true
                }
                if (prov) == false then {
                    missingNames.append pname.copy
                    missingIds.append pcid
                }
            }
        }
    }
}

# checkMissingCallArgs -- report each required field/param (no default) a call or
# construction did not provide, via missingCtorFields over the call's labeled
# and positional arguments.
checkMissingCallArgs: function {ast: Ast
    st: zenv.ZSymbolTable
    call: callref
    funcId: ztypes.tid
    isCtor: bool
} is {
    mcb0: metaCreateBaseId :ast n: (ast.nodes.get i: call.callable.u64)
    match (
        mcb0
    ) case some then {
        return
    } case none then null
    posCount: u64
    provided: (List String)
    kAiter: u64
    for kAiter < call.nargs loop {
        argId: (zast.callArgAt :ast nid: call.nid i: kAiter).u32
        kAiter = kAiter + 1
        arg: ast.nodes.get i: argId.u64
        match (
            arg
        ) case namedoperation then {
            an: zast.nameTextCopy :ast ref: arg.name
            if an.length == 0 then posCount = posCount + 1
            if an.length > 0 then provided.append an
        } else null
    }
    missingNames: (List String)
    missingIds: (ListVal u64)
    missingCtorFields :ast :st :funcId :isCtor :provided :posCount :missingNames :missingIds
    mi: u64
    mn: missingNames.length
    for mi < mn loop {
        pname: missingNames.get i: mi
        pcid: missingIds.get i: mi
        mi = mi + 1
        tnm: st.reg.nameOf tid: (ztypes.tid.create from: pcid.u64)
        mm: "missing required argument '\{pname}' (type: \{tnm})"
        (addError
            :st
            nodeid: call.nid
            lineno: call.lineno
            colno: call.colno
            e: zast.err.callError
            msg: mm
        )
    }
}
# checkUntypedArgLabel -- an argument whose VALUE did not type still has its
# label checked: whether the parameter exists, whether it was already given,
# and whether a positional argument is even allowed there. Those answers come
# from the parameter list alone, so they do not go down with the value.
checkUntypedArgLabel: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    effId: ztypes.tid
    funcId: ztypes.tid
    isCtor: bool
    reportUnknown: bool
    argIdx: u64
    boundArgIds: (ListVal u64)
    recvImplicit: bool
    arg: argref
} is {
        pnU: zast.nameTextCopy :ast ref: arg.name
        if pnU.length > 0 when effId > 0 then {
            if (st.typing.declMemberCount ownerTid: effId) > 0 then {
                pcU: (optU64Or
                    o: (st.typing.declChildOf
                        pool: ast.names
                        parentTypeId: effId
                        name: pnU.stringView
                    )
                    d: 0
                )
                if pcU == 0 then {
                    mU: "unknown argument '\{pnU}'"
                    sugU: (suggestSimilar
                        :ast
                        :st
                        parentTypeId: effId
                        name: pnU.stringView
                    )
                    hU: String
                    if sugU.length > 0 then {
                        hhU: "did you mean '\{sugU}'?"
                        hU = hhU
                    }
                    enU9b: String
                    (addErrorH
                        :st
                        nodeid: arg.nid
                        lineno: arg.lineno
                        colno: arg.colno
                        e: zast.err.callError
                        msg: mU
                        note: enU9b
                        hint: hU
                        width: pnU.length.u32.orPanic
                    )
                }
            }
        }
        if reportUnknown when (isCtor) == false when pnU.length == 0 when funcId > 0 then {
            if (st.typing.declMemberCount ownerTid: funcId) == 0 then {
                if (st.reg.typetypeOf typeId: funcId) == ztypes.ztypetype.functionType then {
                    tmU: "too many arguments: function takes no parameters".string
                    (addError
                        :st
                        nodeid: arg.nid
                        lineno: arg.lineno
                        colno: arg.colno
                        e: zast.err.callError
                        msg: tmU
                    )
                }
            }
        }
        if pnU.length == 0 then {
            pnU = (positionalParamName
                :ast
                :st
                funcId: effId
                idx: argIdx
                skipRecv: recvImplicit
            )
        }
        if effId > 0 when pnU.length > 0 then {
            dcnU: (zast.poolFind pool: ast.names text: pnU.stringView)
            dupU: false
            with bItU: boundArgIds.iterate do for bIdU: bItU loop {
                if bIdU == dcnU.u64 then dupU = true
            }
            if dupU when reportUnknown then {
                dmU: "argument '\{pnU}' specified more than once"
                (addError
                    :st
                    nodeid: arg.nid
                    lineno: arg.lineno
                    colno: arg.colno
                    e: zast.err.callError
                    msg: dmU
                )
            } else {
                boundArgIds.append dcnU.u64
            }
        }
}
# lockBorrowedArgPath -- a reftype argument passed to a locking parameter has
# its whole value path locked for the call, not just its root: a write through
# any prefix would move the storage the callee is reading.
lockBorrowedArgPath: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    arg: argref
} is {
    an: ast.nodes.get i: arg.operation.u64
    src: (ListVal zast.nameid)
    appendValueTuple :ast n: an dst: src
    if src.length > 0 then {
        rt: src.get i: 0
        # residue left by an EARLIER argument of this call
        # must not stand in for THIS argument's source:
        # keep a pending path only when it is rooted at
        # this argument's own base
        if st.typing.pendingBorrowPath.length > 0 then {
            if (st.typing.pendingBorrowPath.get i: 0) != rt then drainPendingBorrow :st
        }
        if st.typing.pendingBorrowPath.length == 0 then {
            rvo: st.lookupVarId nameId: rt
            match (
                rvo
            ) case some then {
                drainPendingBorrow :st
                with sit: src.iterate do for se: sit loop st.typing.pendingBorrowPath.append se
            } case none then null
        }
    }
}

# lockNonTrivialArg -- an argument the call cannot hoist to a temp keeps its
# source: take it, or lock the path it reads through for the call's duration.
# Answers the lock root.
lockNonTrivialArg: function {
    st: zenv.ZSymbolTable
    ast: Ast
    call: callref
    vt: ztypes.tid
    pt: u64
    isTake: bool
    isLockish: bool
    isDeclLock: bool
    isViewArg: bool
    lockRootIn: zast.nameid
    arg: argref
} out zast.nameid is {
    lockRoot: lockRootIn
    # A construction or take parameter consumes the hoisted
    # temp inside the call scope; a lock/borrow parameter
    # locks it there.
    consumes: false
    if isTake then consumes = true
    # a `.lock`-suffixed argument at a lock parameter locks
    # its base and hoists a BORROWED view of it (the synth
    # temp's origin is the base; the base's lock row lands
    # in the call scope via the borrow-lock install).
    if isLockish then {
        lsb: lockSuffixBase :ast n: (ast.nodes.get i: arg.operation.u64)
        if lsb.length > 0 then {
            drainPendingBorrow :st
            st.typing.pendingBorrowPath.append (nameIdOf :ast name: lsb.stringView)
            if lockRoot.isZero then lockRoot = nameIdOf :ast name: lsb.stringView
            if isDeclLock then st.typing.lastLockParamRoot = (nameIdOf
                :ast
                name: lsb.stringView
            )
        }
    }
    # a plain field-path argument behaves as its user-
    # written hoist would: seed the borrow side channel with
    # the real source tuple so the synth temp installs the
    # spec's SHARED-prefix + EXCLUSIVE-leaf locks on it
    if isLockish when (typeIsReftype
        :st
        tid: (ztypes.tid.create from: vt.u64)
    ) then {
        lockBorrowedArgPath :st :ast :arg
    }
    hadPending: false
    if st.typing.pendingBorrowPath.length > 0 then hadPending = true
    tnm: (hoistArg
        :ast
        :st
        argId: arg.operation
        argType: vt
        paramType: pt
        :consumes
        viewParam: isViewArg
    )
    if (hadPending) == false then {
        if isLockish when (typeIsReftype
            :st
            tid: (ztypes.tid.create from: vt.u64)
        ) then {
            (lockCallArg
                :st
                pool: ast.names
                nameId: (nameIdOf :ast name: tnm.stringView)
                callId: call.nid.u64
                shared: isViewArg
                nodeid: (nodeId n: (ast.nodes.get i: arg.operation.u64))
                lineno: (nodeLine n: (ast.nodes.get i: arg.operation.u64))
                colno: (nodeCol n: (ast.nodes.get i: arg.operation.u64))
            )
        }
    }
    return lockRoot
}
# hoistTrivialArg -- an argument the call CAN hoist to a temp still locks its
# source when the parameter borrows it: the temp aliases the same storage.
# Answers the lock root.
hoistTrivialArg: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    call: callref
    vt: ztypes.tid
    pt: u64
    isTake: bool
    isLockish: bool
    isDeclLock: bool
    isViewArg: bool
    lockRootIn: zast.nameid
    arg: argref
} out zast.nameid is {
    lockRoot: lockRootIn
    # A trivial literal argument coerces in place at the
    # parameter boundary (no hoist: restamp its bare node).
    if pt > 0 then {
        iid2: innermostNodeId :ast n: (ast.nodes.get i: arg.operation.u64)
        if iid2 > 0 then {
            seta2: pt
            stampGate :st nid: iid2.u64 tid: (ztypes.tid.create from: seta2.u64)
        }
    }
    # A bare-name reftype argument: a take parameter consumes
    # it (the overlay propagates out on pop); a lock/borrow
    # parameter locks it for the call. A `:name` shorthand
    # argument is the same bare local read and resolves
    # identically: a take parameter consumes it, a lock/borrow
    # parameter locks it (see docs/typechecker.pdoc, `:name` at
    # the argument site).
    bnId: bareAtomNameId :ast n: (ast.nodes.get i: arg.operation.u64)
    if bnId.isZero then {
        bnId = atomNameId :ast n: (ast.nodes.get i: arg.operation.u64)
    }
    if (bnId.isZero) == false when (typeIsReftype
        :st
        tid: (ztypes.tid.create from: vt.u64)
    ) then {
        bvo: st.lookupVarId nameId: bnId
        match (
            bvo
        ) case some then {
            if isTake then {
                # the only leg that spells the name: the diagnostics it may
                # raise are written from the text
                bnT: zast.nameTextCopy :ast ref: bnId
                (consumeBareArgOwnership
                    :st
                    :ast
                    name: bnT.stringView
                    vid: bvo
                    nodeid: (nodeId n: (ast.nodes.get i: arg.operation.u64))
                    lineno: (nodeLine n: (ast.nodes.get i: arg.operation.u64))
                    colno: (nodeCol n: (ast.nodes.get i: arg.operation.u64))
                )
            } else {
                if isLockish then {
                    (lockCallArg
                        :st
                        pool: ast.names
                        nameId: bnId
                        callId: call.nid.u64
                        shared: isViewArg
                        nodeid: (nodeId n: (ast.nodes.get i: arg.operation.u64))
                        lineno: (nodeLine n: (ast.nodes.get i: arg.operation.u64))
                        colno: (nodeCol n: (ast.nodes.get i: arg.operation.u64))
                    )
                    if lockRoot.isZero then lockRoot = bnId
                    if isDeclLock then st.typing.lastLockParamRoot = bnId
                }
            }
        } case none then null
    }
    return lockRoot
}


# hoistAndLockArg -- what the CALL does to the argument's source: hoist a
# non-trivial value to a temp, take ownership of it, or place the lock a
# borrowed parameter holds for the call's duration. Answers the lock root.
hoistAndLockArg: function {
    st: zenv.ZSymbolTable
    ast: Ast
    call: callref
    vt: ztypes.tid
    pt: u64
    isTake: bool
    isLockish: bool
    isDeclLock: bool
    isViewArg: bool
    lockRootIn: zast.nameid
    arg: argref
} out zast.nameid is {
    lockRoot: lockRootIn
    if (argIsTrivial :ast op: (ast.nodes.get i: arg.operation.u64)) then {
        lockRoot = (hoistTrivialArg
            :st
            :ast
            :call
            :vt
            :pt
            :isTake
            :isLockish
            :isDeclLock
            :isViewArg
            lockRootIn: lockRoot
            :arg
        )
    } else {
        lockRoot = (lockNonTrivialArg
            :st
            :ast
            :call
            :vt
            :pt
            :isTake
            :isLockish
            :isDeclLock
            :isViewArg
            lockRootIn: lockRoot
            :arg
        )
    }
    return lockRoot
}
# coercePositionalArg -- a positional argument takes the parameter at its own
# index: check the value against that parameter's type, and coerce a literal to
# the parameter's width rather than letting it keep its own default.
coercePositionalArg: function {
    st: zenv.ZSymbolTable
    ast: Ast
    effId: ztypes.tid
    vt: ztypes.tid
    pn: StringView
    arg: argref
} is {
    cpidP: (optU64Or
        o: (st.typing.declChildOf
            pool: ast.names
            parentTypeId: effId
            name: pn
        )
        d: 0
    )
    if cpidP > 0 then {
        ptidP: cpidP
        if ptidP > 0 when vt > 0 then {
            if (typesCompatible
                :ast
                :st
                a: vt
                b: (ztypes.tid.create from: ptidP.u64)
            ) == false then {
                skipP: false
                if (isNumericTid
                    :st
                    frame: st.curFrame
                    :ast

                    tid: (ztypes.tid.create from: vt.u64)
                ) when (isNumericTid
                    :st
                    frame: st.curFrame
                    :ast

                    tid: (ztypes.tid.create from: ptidP.u64)
                ) then skipP = true
                pttP: st.reg.typetypeOf typeId: (ztypes.tid.create from: ptidP.u64)
                if pttP == ztypes.ztypetype.protocolType then skipP = true
                if pttP == ztypes.ztypetype.facetType then skipP = true
                if pttP == ztypes.ztypetype.genericParam then skipP = true
                if pttP == ztypes.ztypetype.functionType then skipP = true
                if (skipP) == false then {
                    enP: (st.reg.nameOf tid: (ztypes.tid.create from: ptidP.u64))
                    anP: st.reg.nameOf tid: (ztypes.tid.create from: vt.u64)
                    emitP: true
                    if anP.length == 0 then {
                        # unresolved got-side: suppress the knock-on
                        # when a prior error explains it, else name it
                        if st.typing.errors.length > 0 then emitP = false
                        anP = "an unresolved value".string
                    }
                    if emitP then {
                        tmmP: "argument type mismatch: expected \{enP}, got \{anP}"
                        enP9b: String
                        ehP: String
                        (addErrorH
                            :st
                            nodeid: arg.nid
                            lineno: arg.lineno
                            colno: arg.colno
                            e: zast.err.callError
                            msg: tmmP
                            note: enP9b
                            hint: ehP
                            width: pn.length.u32.orPanic
                        )
                    }
                }
            }
        }
    }
}

# coerceArgToParam -- check a named argument against the parameter it binds to:
# that the types are compatible, and that a literal coerces to the parameter's
# width rather than carrying its own default.
coerceArgToParam: function {
    st: zenv.ZSymbolTable
    ast: Ast
    effId: ztypes.tid
    vt: ztypes.tid
    pn: StringView
    boundArgIds: (ListVal u64)
    reportUnknown: bool
    wasPos: bool
    arg: argref
} is {
    if effId.isZero then return
    if pn.length == 0 then return
    # the parameter's pool id is identity enough: effId is
    # fixed across this call's argument walk, so two args
    # collide exactly when they name the same parameter
    dcnid: (zast.poolFind pool: ast.names text: pn)
    dupSeen: false
    with bIt: boundArgIds.iterate do for bId: bIt loop {
        if bId == dcnid.u64 then dupSeen = true
    }
    if dupSeen when reportUnknown then {
        dmm: "argument '\{pn}' specified more than once"
        (addError
            :st
            nodeid: arg.nid
            lineno: arg.lineno
            colno: arg.colno
            e: zast.err.callError
            msg: dmm
        )
    } else {
        boundArgIds.append dcnid.u64
    }
    if wasPos then (coercePositionalArg :st :ast :effId :vt :pn :arg)
}
# checkNamedArgParam -- a labelled argument must name a parameter the callee
# has, and must not name one an earlier argument already bound. Records the
# binding so the positional walk and the missing-argument report agree.
checkNamedArgParam: function {
    st: zenv.ZSymbolTable
    ast: Ast
    effId: ztypes.tid
    pn: StringView
    vt: ztypes.tid
    arg: argref
} is {
    if pn.length > 0 when effId > 0 then {
        if (st.typing.declMemberCount ownerTid: effId) > 0 then {
            pco: (st.typing.declChildOf
                pool: ast.names
                parentTypeId: effId
                name: pn
            )
            pcidX: optU64Or o: pco d: 0
            if pcidX == 0 then {
                m2: "unknown argument '\{pn}'"
                anid: arg.nid
                anln: arg.lineno
                ancl: arg.colno
                sug2: (suggestSimilar
                    :ast
                    :st
                    parentTypeId: (ztypes.tid.create from: effId.u64)
                    name: pn
                )
                h2: String
                if sug2.length > 0 then {
                    hh2: "did you mean '\{sug2}'?"
                    h2 = hh2
                }
                en2: String
                (addErrorH
                    :st
                    nodeid: anid
                    lineno: anln
                    colno: ancl
                    e: zast.err.callError
                    msg: m2
                    note: en2
                    hint: h2
                    width: pn.length.u32.orPanic
                )
            } else {
                ptid: pcidX
                if ptid > 0 when vt > 0 then {
                    if (typesCompatible
                        :ast
                        :st
                        a: vt
                        b: (ztypes.tid.create from: ptid.u64)
                    ) == false then {
                        skipMM: false
                        if (isNumericTid
                            :st
                            frame: st.curFrame
                            :ast

                            tid: (ztypes.tid.create from: vt.u64)
                        ) when (isNumericTid
                            :st
                            frame: st.curFrame
                            :ast

                            tid: (ztypes.tid.create from: ptid.u64)
                        ) then skipMM = true
                        ptt: st.reg.typetypeOf typeId: (ztypes.tid.create from: ptid.u64)
                        if ptt == ztypes.ztypetype.protocolType then skipMM = true
                        if ptt == ztypes.ztypetype.facetType then skipMM = true
                        if ptt == ztypes.ztypetype.genericParam then skipMM = true
                        if ptt == ztypes.ztypetype.functionType then skipMM = true
                        if (skipMM) == false then {
                            en7: st.reg.nameOf tid: (ztypes.tid.create from: ptid.u64)
                            an7: st.reg.nameOf tid: (ztypes.tid.create from: vt.u64)
                            emit7: true
                            if an7.length == 0 then {
                                # unresolved got-side: suppress the knock-on
                                # when a prior error explains it, else name it
                                if st.typing.errors.length > 0 then emit7 = false
                                an7 = "an unresolved value".string
                            }
                            # a literal got-side would have COERCED had the
                            # expected type resolved, so its mismatch is a
                            # knock-on whenever an earlier error explains it
                            if (isLiteralTypeId
                                :st
                                tid: (ztypes.tid.create from: vt.u64)
                            ) then {
                                if st.typing.errors.length > 0 then emit7 = false
                            }
                            if emit7 then {
                                mm7: "argument '\{pn}' type mismatch: expected \{en7}, got \{an7}"
                                en7b: String
                                eh7: String
                                (addErrorH
                                    :st
                                    nodeid: arg.nid
                                    lineno: arg.lineno
                                    colno: arg.colno
                                    e: zast.err.callError
                                    msg: mm7
                                    note: en7b
                                    hint: eh7
                                    width: pn.length.u32.orPanic
                                )
                            }
                        }
                    }
                }
            }
        }
    }
}

# checkTypedCallArg -- everything one typed argument goes through: the parameter
# it binds to, coercion to that parameter's type, the ownership the call takes
# on it, and the lock a borrowed argument places on its source. Answers the
# lock root, which the call as a whole reports.
# what a call does to one argument's source, read off the parameter it binds to.
argownership: record {
    isTake: bool
    isLockish: bool
    isDeclLock: bool
    isViewArg: bool
    pt: u64
}
# argOwnershipOf -- what the call does to this argument's source, read off the
# parameter it binds to: take it, lock it, or read it through a view. A
# constructor reads the FIELD's ownership instead, since a `.lock` field locks
# the caller's argument where any other reftype field takes it.
argOwnershipOf: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    funcId: ztypes.tid
    isCtor: bool
    pn: StringView
    vt: ztypes.tid
} out argownership is {
    isTake: false
    isLockish: false
    isDeclLock: false
    isViewArg: false
    pt: u64
    if funcId > 0 when pn.length > 0 then {
        if (isLiteralTypeId :st tid: (ztypes.tid.create from: vt.u64)) then {
            po: (st.typing.declChildOf
                pool: ast.names
                parentTypeId: funcId
                name: pn
            )
            match (
                po
            ) case some then {
                pt = po
            } case none then null
        }
        oo: (st.typing.declOwnershipOfId
            parentTypeId: funcId
            nameId: (zast.poolFind pool: ast.names text: pn)
        )
        match (
            oo
        ) case some then {
            if oo == ztypes.zparamownership.takeMode then isTake = true
            if oo == ztypes.zparamownership.takexMode then isTake = true
            if oo == ztypes.zparamownership.borrowMode then isLockish = true
            if oo == ztypes.zparamownership.viewMode then {
                isLockish = true
                isViewArg = true
            }
        } case none then {
            # Unrecorded ownership: the effective default is
            # borrow (ctor field params keep their recorded flow).
            if (isCtor) == false then isLockish = true
        }
    if funcId > 0 when pn.length == 0 when isCtor then {
        # a POSITIONAL constructor argument (a tagged-sum arm
        # payload) transfers ownership exactly like its named
        # form: the arm stores it owned
        if (typeIsReftype :st tid: (ztypes.tid.create from: vt.u64)) then isTake = true
    }
        if isCtor then {
            # Field ownership flows to the constructor param:
            # a `.lock` field locks the caller's argument, any
            # other reftype field takes it.
            if (st.typing.declIsLockField
                pool: ast.names
                parentTypeId: funcId
                name: pn
            ) then {
                isLockish = true
            } else {
                if (typeIsReftype
                    :st
                    tid: (ztypes.tid.create from: vt.u64)
                ) then isTake = true
            }
        }
    }
    return (argownership :isTake :isLockish :isDeclLock :isViewArg :pt)
}
# reportPositionalNotAllowed -- a call to a function whose parameters are all
# named cannot pass one positionally; say so at the argument.
reportPositionalNotAllowed: function {
    st: zenv.ZSymbolTable
    funcId: ztypes.tid
    arg: argref
} is {
    if (st.typing.declMemberCount ownerTid: funcId) == 0 then {
        if (st.reg.typetypeOf typeId: funcId) == ztypes.ztypetype.functionType then {
            tmm: "too many arguments: function takes no parameters".string
            (addError
                :st
                nodeid: arg.nid
                lineno: arg.lineno
                colno: arg.colno
                e: zast.err.callError
                msg: tmm
            )
        }
    }
}


checkTypedCallArg: function {
    st: zenv.ZSymbolTable
    ast: Ast
    call: callref
    effId: ztypes.tid
    funcId: ztypes.tid
    isCtor: bool
    reportUnknown: bool
    recvImplicit: bool
    argIdx: u64
    boundArgIds: (ListVal u64)
    vt: ztypes.tid
    lockRootIn: zast.nameid
    arg: argref
} out zast.nameid is {
    lockRoot: lockRootIn
    if vt.isZero then return lockRoot
    pn: zast.nameTextCopy :ast ref: arg.name
    (checkNamedArgParam
        :st
        :ast
        :effId
        pn: pn.stringView
        :vt
        :arg
    )
    if reportUnknown when (isCtor) == false when pn.length == 0 when funcId > 0 then {
        reportPositionalNotAllowed :st :funcId :arg
    }
    wasPos: false
    if pn.length == 0 then {
        wasPos = true
        pp: (positionalParamName
            :ast
            :st
            funcId: effId
            idx: argIdx
            skipRecv: recvImplicit
        )
        pn = pp
    }
    (coerceArgToParam
        :st
        :ast
        :effId
        :vt
        pn: pn.stringView
        :boundArgIds
        :reportUnknown
        :wasPos
        :arg
    )
    aow: argOwnershipOf :st :ast :funcId :isCtor pn: pn.stringView :vt
    isTake: aow.isTake
    isLockish: aow.isLockish
    isDeclLock: aow.isDeclLock
    isViewArg: aow.isViewArg
    pt: aow.pt
    dispHit: false
    if isTake then dispHit = true
    if isLockish then dispHit = true
    if dispHit when (typeIsReftype :st tid: (ztypes.tid.create from: vt.u64)) then {
        dispVal: ztypes.zparamownership.borrowMode
        if isTake then dispVal = ztypes.zparamownership.takeMode
        dispNid: innermostNodeId :ast n: (ast.nodes.get i: arg.operation.u64)
        if dispNid > 0 then {
            st.typing.argDisposition.set key: dispNid.u64 value: dispVal
        }
    }
    lockRoot = (hoistAndLockArg
        :st
        :ast
        :call
        :vt
        :pt
        :isTake
        :isLockish
        :isDeclLock
        :isViewArg
        lockRootIn: lockRoot
        :arg
    )
    return lockRoot
}
# ctorEffectiveTid -- for a constructor call, the type whose FIELDS are the
# parameter list: the type being built, reached through whatever shape the
# callable took. The function's own id for anything else.
ctorEffectiveTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    call: callref
    funcId: ztypes.tid
} out ztypes.tid is {
    effId: funcId
    isMetaC: false
    {
        mcbC: metaCreateBaseId :ast n: (ast.nodes.get i: call.callable.u64)
        match (
            mcbC
        ) case some then {
            isMetaC = true
        } case none then null
    }
    if (isMetaC) == false then {
        (forceMemberOf
            :st
            frame: st.curFrame

            :ast
            parentTypeId: funcId
            nameId: zast.names.wkCreate
        )
        crEff: (optU64Or
            o: (st.typing.declChildOfId parentTypeId: funcId nameId: zast.names.wkCreate)
            d: 0
        )
        if crEff > 0 when (st.reg.typetypeOf typeId: (ztypes.tid.create from: crEff.u64)) == ztypes.ztypetype.functionType then effId = ztypes.tid.create from: crEff.u64
    }
    return effId
}
# ctorArgTakesFnRef -- a FUNCTION-typed field takes a method REFERENCE, so its
# constructor argument walks without the value-position auto-call coercion.
ctorArgTakesFnRef: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    effId: ztypes.tid
    arg: argref
} out bool is {
    useNC: false
    pn0: zast.nameTextAt :ast ref: arg.name
    if pn0.length > 0 then {
        fco: (st.typing.declChildOf
            pool: ast.names
            parentTypeId: effId
            name: pn0.stringView
        )
        fcid: optU64Or o: fco d: 0
        if fcid > 0 then {
            if (st.reg.typetypeOf typeId: (ztypes.tid.create from: fcid.u64)) == ztypes.ztypetype.functionType then {
                useNC = true
            }
        }
    }
    return useNC
}

# walkOneCallArg -- type one argument of a call and bind it to its parameter.
# Answers the lock root, which the call reports as a whole.
walkOneCallArg: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    effId: ztypes.tid
    funcId: ztypes.tid
    isCtor: bool
    reportUnknown: bool
    recvImplicit: bool
    argIdx: u64
    boundArgIds: (ListVal u64)
    lockRootIn: zast.nameid
    argId: u32
} out zast.nameid is {
    lockRoot: lockRootIn
    arg: argRefAt :ast nid: (zast.nodeid.create from: argId.u32)
    if (arg.nid.isZero) == false then {
        # a FUNCTION-typed field takes a method REFERENCE: its ctor
        # argument walks without the value-position auto-call coercion.
        useNC: false
        if isCtor then useNC = (ctorArgTakesFnRef :st :ast :effId :arg)
        vt: ztypes.tid
        errV: st.typing.errors.length
        if useNC then {
            vt = ztypes.tid.create from: (valueNoCoerceAt :st :unitDecl :ast nid: arg.operation)
        } else {
            vt = checkValueAt :st :unitDecl :ast nid: arg.operation
        }
        if vt.u64 == 0 when st.typing.errors.length == errV then {
            (reportUnresolvedValue
                :st
                :unitDecl
                :ast
                nid: arg.operation
            )
        }
        # A value that did not type must not take its LABEL checks down
        # with it: those answer from the parameter list alone. The block
        # below is gated on the value's type only because the ownership
        # and lock work there needs it, so the label-shaped checks run
        # here for the arguments it would otherwise skip entirely.
        if vt.u64 == 0 then {
            (checkUntypedArgLabel
                :st
                :ast
                :effId
                :funcId
                :isCtor
                :reportUnknown
                :argIdx
                :boundArgIds
                :recvImplicit
                :arg
            )
        }
        lockRoot = (checkTypedCallArg
            :st
            :ast
            :call
            :effId
            :funcId
            :isCtor
            :reportUnknown
            :recvImplicit
            :argIdx
            :boundArgIds
            :vt
            lockRootIn: lockRoot
            :arg
        )
    }
    return lockRoot
}

# hoist and typecheck each argument of a call.
# walkCallArgsHoist -- the user-call argument walk: type each argument, then
# hoist non-trivial ones into synth temps.
walkCallArgsHoist: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    funcId: ztypes.tid
    isCtor: bool
    reportUnknown: bool
    recvImplicit: bool
} out zast.nameid is {
    lockRoot: zast.nameid
    st.typing.lastLockParamRoot = zast.nameid
    argIdx: u64
    boundArgIds: (ListVal u64)
    effId: funcId
    if isCtor then effId = (ctorEffectiveTid :st :ast :call :funcId)
    forceAllMembers :st frame: st.curFrame :ast tid: effId
    kAiter: u64
    for kAiter < call.nargs loop {
        argId: (zast.callArgAt :ast nid: call.nid i: kAiter).u32
        kAiter = kAiter + 1
        lockRoot = (walkOneCallArg
            :st
            :unitDecl
            :ast
            :call
            :effId
            :funcId
            :isCtor
            :reportUnknown
            :recvImplicit
            :argIdx
            :boundArgIds
            lockRootIn: lockRoot
            :argId
        )
        argIdx = argIdx + 1
    }
    return lockRoot
}
# boxArgumentTid -- the type a `Box` construction is given: an explicit `t:` type
# argument, or the type of the single value it boxes. 0 when neither is present.
boxArgumentTid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    tplId: ztypes.tid
} out ztypes.tid is {
    # Box names its own type parameter; asking the template for it keeps this
    # site correct across a rename. An id compare has two zeros -- a template
    # that declared none, and an unlabelled argument -- so the compare is
    # guarded rather than trusted.
    boxParam: firstGenericParamId :st templateId: tplId
    fnd: false
    vt: ztypes.tid
    kAiter: u64
    for kAiter < call.nargs loop {
        argId: (zast.callArgAt :ast nid: call.nid i: kAiter).u32
        kAiter = kAiter + 1
        arg: argRefAt :ast nid: (zast.nodeid.create from: argId.u32)
        if (arg.nid.isZero) == false then {
            if (fnd) == false then {
                # an owned copy: the walks below lend ast
                an: zast.nameTextCopy :ast ref: arg.name
                isTypeArg: false
                if (boxParam.isZero) == false when arg.name == boxParam then isTypeArg = true
                if (isTypeArg) == false then {
                    if an.stringView != "from" then {
                        mbx7: "the builtin Box constructs with 'from:'; unknown argument '\{an}'"
                        bxid7: nodeId n: (ast.nodes.get i: arg.operation.u64)
                        bxln7: nodeLine n: (ast.nodes.get i: arg.operation.u64)
                        bxcl7: nodeCol n: (ast.nodes.get i: arg.operation.u64)
                        (addError
                            :st
                            nodeid: bxid7
                            lineno: bxln7
                            colno: bxcl7
                            e: zast.err.callError
                            msg: mbx7
                        )
                    }
                    fnd = true
                    avt: (checkValueAt :st :unitDecl :ast nid: arg.operation)
                    vt = materialiseLiteral :ast :st :unitDecl t: avt
                    if vt > 0 then {
                        if (argIsTrivial :ast op: (ast.nodes.get i: arg.operation.u64)) then {
                            iid: innermostNodeId :ast n: (ast.nodes.get i: arg.operation.u64)
                            if iid > 0 then {
                                setbl: vt
                                stampGate :st nid: iid.u64 tid: (ztypes.tid.create from: setbl.u64)
                            }
                            bn: (zast.nameTextAt
                                :ast
                                ref: (bareAtomNameId :ast n: (ast.nodes.get i: arg.operation.u64))
                            )
                            aid8b: nodeId n: (ast.nodes.get i: arg.operation.u64)
                            aln8b: nodeLine n: (ast.nodes.get i: arg.operation.u64)
                            acl8b: nodeCol n: (ast.nodes.get i: arg.operation.u64)
                            if bn.length > 0 when (typeIsReftype
                                :st
                                tid: (ztypes.tid.create from: vt.u64)
                            ) then {
                                bvo8: st.lookupVarId nameId: (nameIdOf :ast name: bn.stringView)
                                match (
                                    bvo8
                                ) case some then {
                                    if (nameIsReadonly :st :ast name: bn.stringView) then {
                                        (readonlyMoveError
                                            :st
                                            nodeid: aid8b
                                            lineno: aln8b
                                            colno: acl8b
                                            name: bn.stringView
                                            verb: "into a box"
                                        )
                                    } else {
                                        bpin8: (pinnedMoveError
                                            :st
                                            :ast
                                            nodeid: aid8b
                                            lineno: aln8b
                                            colno: acl8b
                                            name: bn.stringView
                                            verb: "into a box"
                                        )
                                        if bpin8 then null else if (isBorrowedVar
                                            :st
                                            vid: bvo8
                                        ) then {
                                            mb8: "Cannot move borrowed variable '\{bn}' into a box — borrowed names stay bound to their source for the full scope; copy with '.copy' to keep the source"
                                            (addError
                                                :st
                                                nodeid: aid8b
                                                lineno: aln8b
                                                colno: acl8b
                                                e: zast.err.ownerError
                                                msg: mb8
                                            )
                                        } else {
                                            (st.invalidate
                                                nameId: (nameIdOf :ast name: bn.stringView)
                                                loc: takenHere
                                            )
                                        }
                                    }
                                } case none then {
                                    (st.invalidate
                                        nameId: (nameIdOf :ast name: bn.stringView)
                                        loc: takenHere
                                    )
                                }
                            }
                        } else {
                            (hoistArg
                                :ast
                                :st
                                argId: arg.operation
                                argType: vt
                                paramType: 0
                                consumes: true
                                viewParam: false
                            )
                        }
                    }
                }
            }
        }
    }
    return vt
}


# checkBoxConstruction -- `Box from: val`: the value's (materialised) type
# binds t; the argument is consumed (hoisted first when non-trivial); the
# instance carries create plus the element type's children copied for
# transparent member access. Heap passthrough (List/Map boxing) lands when
# an example needs it.
checkBoxConstruction: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    tplId: ztypes.tid
} out ztypes.tid is {
    vt: boxArgumentTid :st :unitDecl :ast :call :tplId
    if vt.isZero then return (ztypes.tid.create from: 0)
    tn: st.reg.nameOf tid: (ztypes.tid.create from: vt.u64)
    mname: "_\{tn}"
    subs: (IdMapV zast.nameid v: u64)
    sv: vt
    subs.set key: (firstGenericParamId :st templateId: tplId) value: sv
    vsJ: (IdMapV zast.nameid v: u64)
    mid: (getOrMintSpec
        :st
        frame: st.curFrame
        :ast

        :unitDecl
        sfx: mname.stringView
        templateId: (ztypes.tid.create from: tplId.u64)
        :subs
        valSubs: vsJ
        fallbackArg: 0
    )
    if mid.isZero then return (ztypes.tid.create from: 0)
    st.reg.setIsBox typeId: mid
    st.reg.setIsHeapAllocated typeId: mid
    st.reg.setNeedsDestructor typeId: mid
    if (st.typing.declMemberCount ownerTid: mid) <= 0 then {
        crId: st.reg.newType name: "create" ownerTid: mid typetype: ztypes.ztypetype.functionType
        (st.typing.declSynthMember
            parentTypeId: mid
            nameId: zast.names.wkCreate
            kind: ztyping.declkind.methodDecl
        )
        st.typing.setMemberType parentTypeId: mid nameId: zast.names.wkCreate childTypeId: crId
        # Stage the element's members first: setMemberType appends to the very
        # declaration being iterated.
        cIds2: (ListVal u64)
        cNid2: (ListVal u64)
        st.typing.declMemberList ownerTid: vt names: cNid2 tids: cIds2
        bi: u64
        bn2: cNid2.length
        for bi < bn2 loop {
            chi: cIds2.get i: bi
            chnId: (zast.nameid.create from: (cNid2.get i: bi))
            (forceMemberOf :st frame: st.curFrame :ast parentTypeId: mid nameId: chnId)
            ext: st.typing.declChildOfId parentTypeId: mid nameId: chnId
            match (
                ext
            ) case some then null case none then {
                # declare before edging, so setMemberType stamps the copied
                # member's type onto its declaration instead of leaving the
                # sweep below to mint it and read the type back off the edge
                kk: ztyping.declkind.fieldDecl
                if (st.reg.typetypeOf typeId: (ztypes.tid.create from: chi.u64)) == ztypes.ztypetype.functionType then {
                    kk = ztyping.declkind.methodDecl
                }
                st.typing.declSynthMember parentTypeId: mid nameId: chnId kind: kk
                st.typing.setMemberType parentTypeId: mid nameId: chnId childTypeId: chi
            }
            bi = bi + 1
        }
    }
    bcal: nodeId n: (ast.nodes.get i: call.callable.u64)
    if bcal > 0 then {
        setbt: tplId
        stampGate :st nid: bcal.u64 tid: setbt
    }
    setbc: mid
    stampGate :st nid: call.nid.u64 tid: setbc
    st.typing.callKind.set key: call.nid.u64 value: zast.callkind.boxCreate
    return mid
}

# callableDottedResultAt -- a dotted callable resolves through the dotted-path
# walk (no auto-call coercion -- callable position wants the function itself);
# the base is typed and stamped there. none = the callable is not a dotted
# path; some 0 = dotted but unresolved (e.g. a data block's `.index`), which
# leaves the call untyped with its arguments unwalked.
callableDottedResultAt: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    nid: zast.nodeid
} out optionval ztypes.tid is {
    arm: rowArmAt :ast :nid
    match (
        arm
    ) case dottedpath then {
        dr: dpRefAt :ast :nid
        r: checkDotted :st :unitDecl :ast dp: dr coerce: false
        return (optionval.some r)
    } else {
        return (optionval.none ztypes.tid)
    }
}

# returnedBareFieldName -- `return <base>.<field>` where the member is a
# non-FUNCTION field whose type is a reftype or a generic param: the bare
# read escapes a shallow copy of storage the owner still frees (and a
# generic param may instantiate to one). Returns the field name for the
# diagnostic; "" when the return shape is fine.
returnedBareFieldName: function {
    ast: Ast
    st: zenv.ZSymbolTable
    nid: zast.nodeid
} out String is {
    arm: rowArmAt :ast :nid
    match (
        arm
    ) case expression then {
        wrap: exprRefAt :ast :nid
        return (returnedBareFieldName :ast :st nid: wrap.expression)
    } case dottedpath then {
        dr: dpRefAt :ast :nid
        bfc: atomName :ast n: (ast.nodes.get i: dr.child.u64)
        bfcId: atomNameId :ast n: (ast.nodes.get i: dr.child.u64)
        if bfc.length == 0 then return "".string
        if (isStripMarker name: bfc.stringView) then return "".string
        bft: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: dr.parent.u64
        if bft.isZero then return "".string
        (forceMemberOf
            :st
            frame: st.curFrame

            :ast
            parentTypeId: (ztypes.tid.create from: bft.u64)
            nameId: bfcId
        )
        bfo: (st.typing.declChildOfId
            parentTypeId: (ztypes.tid.create from: bft.u64)
            nameId: bfcId
        )
        match (
            bfo
        ) case some then {
            if (st.reg.typetypeOf typeId: (ztypes.tid.create from: bfo.u64)) == ztypes.ztypetype.functionType then return "".string
            if (st.reg.typetypeOf typeId: (ztypes.tid.create from: bfo.u64)) == ztypes.ztypetype.genericParam then return (bfc.copy)
            if (typeIsReftype :st tid: (ztypes.tid.create from: bfo.u64)) then return (bfc.copy)
            return "".string
        } case none then {
            return "".string
        }
    } else {
        return "".string
    }
}

# unresolvedBareCallable -- the bare-atom callable name of a call-shaped
# value that resolves to NOTHING (no local, no own-unit function, no system
# name, no walkable type): the checker's silent args-walked fallthrough
# otherwise leaves the binding untyped and the emitter prints a marker.
# unresolvedBareName -- prove a bare name resolves NOWHERE in value
# position: not a local, not a unit member, not a typeref, not a system
# child. The name when unresolvable; "" when anything claims it.
unresolvedBareName: function {ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    name: StringView
} out String is {
    if name.length == 0 then return "".string
    # `meta` is the enclosing type's raw allocator base (meta.create):
    # contextual, never a unit-resolvable name
    if name == "meta" then return "".string
    ubv: st.lookupVarId nameId: (nameIdOf :ast :name)
    match (
        ubv
    ) case some then {
        return "".string
    } case none then null
    # lookupVarId reads two in-scope names as absent: a binding that minted no
    # varId (a `meta.create` result) and a MOVED one (both `lookup` and
    # `lookupVarId` refuse a taken local). A declared name is in scope however
    # it was consumed, so the local's declaration itself is the authority.
    if (st.isLocalName nameId: (nameIdOf :ast :name)) then return "".string
    if (nameClaimedByScope
        :st
        frame: st.curFrame
        :ast

        :unitDecl
        :name
    ) then return "".string
    ubw: (walkLookupTyperef
        :st
        frame: st.curFrame
        :ast

        :unitDecl
        base: name
    )
    match (
        ubw
    ) case some then {
        return "".string
    } case none then null
    return name.string
}

# dottedRootName -- the root atom name of a dotted path ("" when the
# root is not a bare atom).
dottedRootName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case dottedpath then {
        return (dottedRootName :ast n: (ast.nodes.get i: n.parent.u64))
    } case expression then {
        return (dottedRootName :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        return (atomName :ast :n)
    }
}

# isDottedValue -- the node under any expression wrappers is a dotted path.
isDottedValue: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (isDottedValue :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return true
    } else {
        return false
    }
}

# report an unresolved bare callee (E0023).
unresolvedBareCallable: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out String is {
    # the row is read through a view scoped to this block (1 expression,
    # 2 call, 3 binop, 4 atomid, 5 dottedpath, 0 anything else): the name
    # probe below lends ast exclusively
    arm: u32
    innerId: zast.nodeid
    callableId: zast.nodeid
    lhsId: zast.nodeid
    rhsId: zast.nodeid
    parentId: zast.nodeid
    nameId: zast.nameid
    {
        n: ast.nodes.get i: nid.u64
        match (
            n
        ) case expression then {
            arm = 1
            innerId = n.expression
        } case call then {
            arm = 2
            callableId = n.callable
        } case binop then {
            arm = 3
            lhsId = n.lhs
            rhsId = n.rhs
        } case atomid then {
            arm = 4
            nameId = n.name
        } case dottedpath then {
            arm = 5
            parentId = n.parent
        } else null
    }
    if arm == 1 then return (unresolvedBareCallable :ast :st :unitDecl nid: innerId)
    if arm == 2 then {
        ubc: String
        ubr0: String
        {
            cnode: ast.nodes.get i: callableId.u64
            ubc = zast.nameTextCopy :ast ref: (atomNameId :ast n: cnode)
            ubr0 = dottedRootName :ast n: cnode
        }
        if ubc.length > 0 then return (unresolvedBareName :ast :st :unitDecl name: ubc.stringView)
        return (unresolvedBareName :ast :st :unitDecl name: ubr0.stringView)
    }
    if arm == 3 then {
        # an operand may carry the unresolvable name (`ghost + 1`)
        ubl: unresolvedBareCallable :ast :st :unitDecl nid: lhsId
        if ubl.length > 0 then return ubl
        return (unresolvedBareCallable :ast :st :unitDecl nid: rhsId)
    }
    if arm == 4 then {
        uba: zast.nameTextCopy :ast ref: nameId
        return (unresolvedBareName :ast :st :unitDecl name: uba.stringView)
    }
    if arm == 5 then {
        # a path is no better than its root (`b.n` with no `b`)
        ubd: String
        {
            pn: ast.nodes.get i: parentId.u64
            ubd = dottedRootName :ast n: pn
        }
        if ubd.length == 0 then return "".string
        return (unresolvedBareName :ast :st :unitDecl name: ubd.stringView)
    }
    return "".string
}

# reportUnresolvedValue -- a value that typed to nothing and raised nothing is
# an unresolvable name: report it here, where the value is consumed. Without
# it the 0 silently disables the consuming site's own checks and the emitter
# writes the bare name into the C. Mirrors the binding and statement sites.
reportUnresolvedValue: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    nid: zast.nodeid
} is {
    # the row's shape, root name and position are read through a view scoped
    # to this block: the name probes below lend ast
    isDotted: false
    ubD: String
    eLn: u32
    eCo: u32
    {
        vnode: ast.nodes.get i: nid.u64
        isDotted = isDottedValue :ast n: vnode
        if isDotted then ubD = dottedRootName :ast n: vnode
        eLn = nodeLine n: vnode
        eCo = nodeCol n: vnode
    }
    ubU: unresolvedBareCallable :ast :st :unitDecl :nid
    if ubU.length == 0 then {
        # the ROOT of a dotted VALUE carries the name (`ghost.field`) -- the
        # callee leg already makes this check for `ghost.method`. It stays
        # here rather than in unresolvedBareCallable: the statement and
        # binding sites share that helper and reach bodies whose locals are
        # absent from the scope table, where the negative proof would reject
        # a real name (`lx.advance` in zlexer's Lexer).
        if isDotted then ubU = unresolvedBareName :ast :st :unitDecl name: ubD.stringView
    }
    if ubU.length == 0 then return
    umU: "Unknown reference '\{ubU}'"
    enU: String
    ehU: String
    (addErrorH
        :st
        nodeid: nid
        lineno: eLn
        colno: eCo
        e: zast.err.badReference
        msg: umU
        note: enU
        hint: ehU
        width: ubU.length.u32.orPanic
    )
}

# monoMemberOf -- inside a unit mono's instance walk (curMonoStamp), the mono's
# own member for a bare callee that resolved to the TEMPLATE's method of that
# name; any other id passes through unchanged.
monoMemberOf: function {
    st: zenv.ZSymbolTable.view
    templateFnTid: ztypes.tid
    nameId: zast.nameid
} out ztypes.tid is {
    org: st.reg.genericOriginOf tid: (ztypes.tid.create from: st.typing.curMonoStamp)
    if org.isZero then return templateFnTid
    tm: st.typing.declChildOfId parentTypeId: org :nameId
    match (
        tm
    ) case some then {
        if tm != templateFnTid.u64 then return templateFnTid
    } case none then {
        return templateFnTid
    }
    mm: (st.typing.declChildOfId
        parentTypeId: (ztypes.tid.create from: st.typing.curMonoStamp)
        :nameId
    )
    match (
        mm
    ) case some then {
        return (ztypes.tid.create from: mm.u64)
    } case none then {
        return templateFnTid
    }
}
# checkControlBuiltinCall -- `return`, and the control builtins that share its
# shape: check the value against what the enclosing function declares, and
# stamp the call with the type it yields.
checkControlBuiltinCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
} out ztypes.tid is {
    result: ztypes.tid
    rtOpt: walkLookupTyperef :st frame: st.curFrame :ast :unitDecl base: "return"
    match (
        rtOpt
    ) case some then {
        calid: nodeId n: (ast.nodes.get i: call.callable.u64)
        stampGate :st nid: calid.u64 tid: (ztypes.tid.create from: rtOpt.u64)
    } case none then null
    st.typing.callKind.set key: call.nid.u64 value: zast.callkind.returnCall
    # `return` is itself a call, so a LABELLED argument binds to RETURN,
    # not to the expression being returned: `return f a: 1` hands `a: 1`
    # to return and leaves `f` bare. Say that, and say it once -- walking
    # the arguments as return values instead blames the bare callee for
    # the argument it was denied and then the return type for the
    # function value, neither of which names the real mistake.
    rLbl: false
    {
        kLIter: u64
        for kLIter < call.nargs loop {
            lArgId: (zast.callArgAt :ast nid: call.nid i: kLIter).u32
            kLIter = kLIter + 1
            lArg: argRefAt :ast nid: (zast.nodeid.create from: lArgId.u32)
            if (lArg.nid.isZero) == false then {
                if (lArg.name.isZero) == false when (rLbl) == false then {
                    rLbl = true
                    lNm: zast.poolTextAt pool: ast.names ref: lArg.name
                    lMsg: "'return' has no argument '\{lNm}'"
                    lNote: "'return' is itself a call, so a labelled argument binds to it".string
                    lHint: "wrap the returned call in parentheses so '\{lNm}:' binds to it"
                    (addErrorH
                        :st
                        nodeid: lArg.nid
                        lineno: lArg.lineno
                        colno: lArg.colno
                        e: zast.err.callError
                        msg: lMsg
                        note: lNote
                        hint: lHint
                        width: lNm.length.u32.orPanic
                    )
                }
            }
        }
    }
    if (rLbl) == false then {
        kAiter: u64
        for kAiter < call.nargs loop {
            argId: (zast.callArgAt :ast nid: call.nid i: kAiter).u32
            kAiter = kAiter + 1
            arg: argRefAt :ast nid: (zast.nodeid.create from: argId.u32)
            if (arg.nid.isZero) == false then {
                errR: st.typing.errors.length
                argT: (checkValueAt :st :unitDecl :ast nid: arg.operation)
                # A returned value that typed to nothing and raised nothing is
                # an unresolvable name -- but ONLY where this walk knows the
                # enclosing function's return type. Some bodies reach here
                # degenerate (zlexer's create/acceptAny: return type unknown,
                # the local's own binding never registered a scope entry), and
                # there the scope cannot answer whether a name is in scope.
                # currentReturnTypeId is exactly the condition under which the
                # return-type check below already runs.
                if argT.u64 == 0 when st.typing.errors.length == errR then {
                    if st.typing.currentReturnTypeId > 0 then {
                        (reportUnresolvedValue
                            :st
                            :unitDecl
                            :ast
                            nid: arg.operation
                        )
                    }
                }
                bfn: returnedBareFieldName :ast :st nid: arg.operation
                if st.typing.currentReturnsBorrow then bfn = "".string
                if bfn.length > 0 then {
                    mbf: "Cannot return field '\{bfn}' as a bare read — the owner still frees it; return '\{bfn}.copy' (duplicate) or '\{bfn}.take' (move out)"
                    bfid: nodeId n: (ast.nodes.get i: arg.operation.u64)
                    bfln: nodeLine n: (ast.nodes.get i: arg.operation.u64)
                    bfcl: nodeCol n: (ast.nodes.get i: arg.operation.u64)
                    (addError
                        :st
                        nodeid: bfid
                        lineno: bfln
                        colno: bfcl
                        e: zast.err.ownerError
                        msg: mbf
                    )
                }
                # a returned owned local is CONSUMED: record the
                # transfer so L022 does not offer a view for it
                rbnId: bareAtomNameId :ast n: (ast.nodes.get i: arg.operation.u64)
                if (rbnId.isZero) == false when argT > 0 when (typeIsReftype :st tid: argT) then {
                    rvv: st.lookupVarId nameId: rbnId
                    match (
                        rvv
                    ) case some then {
                        st.typing.variableMoved.add item: rvv
                    } case none then null
                }
                expR: st.typing.currentReturnTypeId
                if expR > 0 when argT > 0 then {
                    if (typesCompatible :ast :st a: argT b: expR) == false then {
                        en: st.reg.nameOf tid: expR
                        an: st.reg.nameOf tid: argT
                        m4: "return type mismatch: function expects \{en}, got \{an}"
                        rvid: nodeId n: (ast.nodes.get i: arg.operation.u64)
                        rvln: nodeLine n: (ast.nodes.get i: arg.operation.u64)
                        rvcl: nodeCol n: (ast.nodes.get i: arg.operation.u64)
                        (addError
                            :st
                            nodeid: rvid
                            lineno: rvln
                            colno: rvcl
                            e: zast.err.typeError
                            msg: m4
                        )
                    }
                }
            }
        }
    }

    nvOpt: walkLookupTyperef :st frame: st.curFrame :ast :unitDecl base: "never"
    match (
        nvOpt
    ) case some then {
        result = ztypes.tid.create from: nvOpt.u64
        setk: result
        stampGate :st nid: call.nid.u64 tid: setk
    } case none then null
    return result
}
# checkResolvedMethodCall -- the callable resolved through the dotted walk to a
# METHOD: check its arguments against that method's parameters, and answer what
# the call yields. The typedef and projection constructor forms answer here
# too, since they reach the walk the same way.
# a leg's answer: whether it fully handled the call, and the type it yields.
callleg: record {
    handled: bool
    tid: ztypes.tid
}
# checkTypedefOrProjectionCall -- a dotted `create` or `borrow` on a typedef or
# projection base: the wrapper's constructor, or the view it projects.
checkTypedefOrProjectionCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    tdcid: u32
    isBorrowForm: bool
} out callleg is {
    tdo: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: tdcid.u64
    isTd: false
    if (typedefBaseOf
        :st
        tid: (ztypes.tid.create from: tdo.u64)
    ) > 0 then isTd = true
    if (typedefBaseTidOf
        :st
        tid: (ztypes.tid.create from: tdo.u64)
    ) > 0 then isTd = true
    if isTd when isBorrowForm then {
        return (callleg handled: true tid: (checkTypedefBorrow
            :st
            :unitDecl
            :ast
            :call
            tdId: tdo
        ))
    }
    if isTd then {
        return (callleg handled: true tid: (checkTypedefCreate
            :st
            :unitDecl
            :ast
            :call
            tdId: tdo
        ))
    }
    pjtt: st.reg.typetypeOf typeId: (ztypes.tid.create from: tdo.u64)
    isProj: false
    if pjtt == ztypes.ztypetype.facetType then isProj = true
    if pjtt == ztypes.ztypetype.protocolType then isProj = true
    if isProj then {
        pjTake: false
        pjBorrow: false
        if pjtt == ztypes.ztypetype.protocolType then {
            callableNode: ast.nodes.get i: call.callable.u64
            pjcn: (zast.nameTextAt
                :ast
                ref: (dottedChildNameId :ast n: callableNode)
            )
            if pjcn.stringView == "create" then pjTake = true
            if pjcn.stringView == "borrow" then pjBorrow = true
        }
        return (callleg handled: true tid: (checkProjectionCreate
            :st
            :unitDecl
            :ast
            :call
            pjId: tdo
            consumes: pjTake
            borrows: pjBorrow
        ))
    }
    return (callleg handled: false tid: ztypes.tid)
}
# pinMethodBorrowReturn -- a method whose return BORROWS pins what it borrowed
# from for the binding's life: the receiver, or the argument the lock parameter
# named. An iterator's pin is exclusive; every other read-view is shared.
pinMethodBorrowReturn: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    call: callref
    dro: ztypes.tid
    mres: ztypes.tid
    mlr: zast.nameid
} is {
    if (optBoolOr o: (st.typing.funcReturnsBorrow.get key: dro) d: false) then {
        rtupB: (ListVal zast.nameid)
        callableNode: ast.nodes.get i: call.callable.u64
        methodReceiverTuple :ast n: callableNode dst: rtupB
        pushedB: false
        if rtupB.length > 0 then {
            rvoB: st.lookupVarId nameId: (rtupB.get i: 0)
            match (
                rvoB
            ) case some then {
                drainPendingBorrow :st
                with tib: rtupB.iterate do for segB: tib loop st.typing.pendingBorrowPath.append segB
                # An iterator pins its container as strongly
                # as its receiver is declared: a `view` receiver
                # only reads it, so the pin is readonly and
                # other readers of the container still pass.
                if (returnIsIteratorTid
                    :st
                    tid: (ztypes.tid.create from: mres.u64)
                ) == false then {
                    st.typing.pendingBorrowShared = true
                } else {
                    if (methodReceiverIsView :st mid: dro) then st.typing.pendingBorrowShared = true
                }
                # An `out T.view` result is a READONLY reference: shared pin,
                # and the binding it lands on may only be read.
                if (optBoolOr
                    o: (st.typing.funcReturnsView.get key: dro)
                    d: false
                ) then {
                    st.typing.pendingBorrowShared = true
                    st.typing.pendingBorrowReadonly = true
                }
                pushedB = true
            } case none then null
        }
        if (pushedB) == false when (mlr.isZero) == false then {
            drainPendingBorrow :st
            st.typing.pendingBorrowPath.append mlr
            if (returnIsIteratorTid
                :st
                tid: (ztypes.tid.create from: mres.u64)
            ) == false then {
                st.typing.pendingBorrowShared = true
            } else {
                if (methodReceiverIsView :st mid: dro) then st.typing.pendingBorrowShared = true
            }
            # An `out T.view` result is a READONLY reference: shared pin,
            # and the binding it lands on may only be read.
            if (optBoolOr
                o: (st.typing.funcReturnsView.get key: dro)
                d: false
            ) then {
                st.typing.pendingBorrowShared = true
                st.typing.pendingBorrowReadonly = true
            }
        }
    }
}
# lockMethodReceiver -- the lock a method call places on its RECEIVER: a mutating
# method takes it exclusively, a `view` receiver shares it, and a receiver that
# is not a bare name locks the path it was reached through.
lockMethodReceiver: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    call: callref
    dro: ztypes.tid
    rro: StringView
} is {
        if rro.length > 0 then {
            rvo2: st.lookupVarId nameId: (nameIdOf :ast name: rro)
            match (
                rvo2
            ) case some then {
                rvt2: st.lookup nameId: (nameIdOf :ast name: rro)
                match (
                    rvt2
                ) case some then {
                    # A receiver-bound method locks reftype
                    # receivers; a this-less function member is a
                    # callable field -- its receiver locks
                    # unconditionally.
                    doLock: false
                    rtt: st.reg.typetypeOf typeId: (ztypes.tid.create from: rvt2.u64)
                    isFP: false
                    if rtt == ztypes.ztypetype.facetType then isFP = true
                    if rtt == ztypes.ztypetype.protocolType then isFP = true
                    if isFP then {
                        doLock = true
                    } else {
                        if (methodHasThisReceiver :st mid: dro) then {
                            if (typeIsReftype
                                :st
                                tid: (ztypes.tid.create from: rvt2.u64)
                            ) then doLock = true
                        } else {
                            doLock = true
                        }
                    }
                    if doLock then {
                        callableNode: ast.nodes.get i: call.callable.u64
                        rmn: (zast.nameTextAt
                            :ast
                            ref: (dottedChildNameId :ast n: callableNode)
                        )
                        shr: (isContainerReaderCall
                            :ast
                            :st
                            recvTid: rvt2
                            mname: rmn.stringView
                        )
                        if (methodReceiverIsView :st mid: dro) then shr = true
                        (lockCallArg
                            :st
                            pool: ast.names
                            nameId: (nameIdOf :ast name: rro)
                            callId: call.nid.u64
                            shared: shr
                            nodeid: call.nid
                            lineno: call.lineno
                            colno: call.colno
                        )
                    }
                } case none then null
            } case none then null
        }
        if rro.length == 0 then {
            # Nested receiver (st.reg.map.get ...): the root-name
            # block above cannot see it. Lock the full receiver
            # tuple; the immediate receiver type (the stamped
            # parent) drives the reader/writer kind.
            rtupC: (ListVal zast.nameid)
            callableNode: ast.nodes.get i: call.callable.u64
            methodReceiverTuple :ast n: callableNode dst: rtupC
            if rtupC.length > 1 then {
                rvoN: st.lookupVarId nameId: (rtupC.get i: 0)
                match (
                    rvoN
                ) case some then {
                    callableNode: ast.nodes.get i: call.callable.u64
                    rpidN: dottedParentNodeId :ast n: callableNode
                    rvtN: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: rpidN.u64
                    if rvtN > 0 when (typeIsReftype
                        :st
                        tid: (ztypes.tid.create from: rvtN.u64)
                    ) then {
                        callableNode: ast.nodes.get i: call.callable.u64
                        rmnN: (zast.nameTextAt
                            :ast
                            ref: (dottedChildNameId :ast n: callableNode)
                        )
                        shrN: (isContainerReaderCall
                            :ast
                            :st
                            recvTid: rvtN
                            mname: rmnN.stringView
                        )
                        if (methodReceiverIsView :st mid: dro) then shrN = true
                        (lockCallPath
                            :st
                            :ast
                            pool: ast.names
                            path: rtupC
                            callId: call.nid.u64
                            shared: shrN
                            nodeid: call.nid
                            lineno: call.lineno
                            colno: call.colno
                        )
                    }
                } case none then null
            }
        }
}
# pinMethodTakexReturn -- a `takex` return is OWNED but still pins the source it
# was built from: the same receiver pin a borrow return takes, without demoting
# the binding it lands on.
pinMethodTakexReturn: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    call: callref
    dro: ztypes.tid
    mres: ztypes.tid
    mlr: zast.nameid
} is {
    if (optBoolOr
        o: (st.typing.funcReturnsTakex.get key: dro)
        d: false
    ) then {
        # `takex`: pin the source the result was built from,
        # while the binding stays OWNED. The source is the
        # receiver when there is one; else `mlr`, the call's
        # lock root, set for any non-owned argument -- which is
        # what lets a `borrow` parameter source the pin.
        rtupX: (ListVal zast.nameid)
        xq4X: ast.nodes.get i: call.callable.u64
        methodReceiverTuple :ast n: xq4X dst: rtupX
        pushedX: false
        if rtupX.length > 0 then {
            rvoX: st.lookupVarId nameId: (rtupX.get i: 0)
            match (
                rvoX
            ) case some then {
                drainPendingBorrow :st
                with tix: rtupX.iterate do for segX: tix loop st.typing.pendingBorrowPath.append segX
                if (returnIsIteratorTid
                    :st
                    tid: (ztypes.tid.create from: mres.u64)
                ) == false then {
                    st.typing.pendingBorrowShared = true
                } else {
                    if (methodReceiverIsView :st mid: dro) then st.typing.pendingBorrowShared = true
                }
                st.typing.pendingBorrowOwned = true
                pushedX = true
            } case none then null
        }
        if (pushedX) == false when (mlr.isZero) == false then {
            drainPendingBorrow :st
            st.typing.pendingBorrowPath.append mlr
            st.typing.pendingBorrowOwned = true
        }
    }
}

checkResolvedMethodCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    dro: ztypes.tid
} out ztypes.tid is {
        tdcb: createDottedBaseId :ast n: (ast.nodes.get i: call.callable.u64)
        tdcid: u32
        match (
            tdcb
        ) case some then {
            tdcid = tdcb
        } case none then null
        isBorrowForm: false
        bdcb: borrowDottedBaseId :ast n: (ast.nodes.get i: call.callable.u64)
        match (
            bdcb
        ) case some then {
            tdcid = bdcb
            isBorrowForm = true
        } case none then null
        # `T.create ...` from inside T's own create -- the explicit spelling
        # of the same recursion the bare-name leg refuses. The dotted base's
        # stamped type is the type being constructed, the same move the
        # synthesized-create leg below makes. The borrow form (`T.borrow`)
        # shares `tdcid` and is not a construction.
        if tdcid > 0 when (isBorrowForm) == false then {
            sctid: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: tdcid.u64
            if sctid > 0 then {
                (ctorSelfRecursionAt
                    :st
                    nodeid: call.nid
                    lineno: call.lineno
                    colno: call.colno
                    width: 1
                    ctorTid: (ztypes.tid.create from: sctid)
                )
            }
        }
        if tdcid > 0 then {
            dleg: (checkTypedefOrProjectionCall
                :st
                :unitDecl
                :ast
                :call
                :tdcid
                :isBorrowForm
            )
            if dleg.handled then return dleg.tid
        }
        mcm: st.pushCall
        # Dotted on a value in scope = the receiver is implicit;
        # dotted on the type (`Counter.increment c`) passes the
        # receiver as an ordinary positional arg.
        recvVal: false
        rrnId: rootNameIdOf :ast n: (ast.nodes.get i: call.callable.u64)
        if (rrnId.isZero) == false then {
            rlo: st.lookup nameId: rrnId
            match (
                rlo
            ) case some then {
                recvVal = true
            } case none then null
        }
        mlr: (walkCallArgsHoist
            :st
            :unitDecl
            :ast
            :call
            funcId: dro
            isCtor: false
            reportUnknown: false
            recvImplicit: recvVal
        )
        checkMissingCallArgs :ast :st :call funcId: dro isCtor: false
        # The receiver locks for the call's duration too, after
        # the args.
        rro: methodReceiverRoot :ast n: (ast.nodes.get i: call.callable.u64)
        lockMethodReceiver :st :ast :call :dro rro: rro.stringView
        st.popTo marker: mcm
        mres: ztypes.tid
        mro: methodReturnOf :st mid: dro
        match (
            mro
        ) case some then {
            mres = mro
            setmr: mres
            stampGate :st nid: call.nid.u64 tid: (ztypes.tid.create from: setmr.u64)
        } case none then null
        # A synthesized `create` has no recorded return: explicit
        # `.create` constructs, so the result is the base type.
        if mres.isZero then {
            cdb: createDottedBaseId :ast n: (ast.nodes.get i: call.callable.u64)
            cdbid: u32
            match (
                cdb
            ) case some then {
                cdbid = cdb
            } case none then null
            if cdbid > 0 then {
                btid: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: cdbid.u64
                if btid > 0 then {
                    mres = ztypes.tid.create from: (btid)
                    setmr2: mres
                    (stampGate
                        :st
                        nid: call.nid.u64
                        tid: (ztypes.tid.create from: setmr2.u64)
                    )
                }
            }
        }
        # receiver/argument evaluation may leave a pending borrow
        # (an inner marked-return call, e.g. the get in
        # `(xs.get i).copy`): an owning outer call consumes it --
        # only the push blocks below re-establish one.
        drainPendingBorrow :st
        xroot: st.typing.lastLockParamRoot
        if (xroot.isZero) == false then {
            st.typing.lastLockParamRoot = zast.nameid
            drainPendingBorrow :st
            st.typing.pendingBorrowPath.append xroot
        }
        pinMethodTakexReturn :st :ast :call :dro :mres :mlr
        pinMethodBorrowReturn :st :ast :call :dro :mres :mlr
        # A view-typed result (OptionView from Map.get, ...) is a
        # borrow into the receiver even without a .borrow marker:
        # the wrapper is synthesized, so the return TYPE is the
        # marker. Report the receiver root so the binding goes
        # borrowed (payload moves rejected, view lock installed).
        if mres > 0 when mlr.isZero then {
            if (isViewFamilyTid :ast :st tid: (ztypes.tid.create from: mres.u64)) then {
                rtupV: (ListVal zast.nameid)
                callableNode: ast.nodes.get i: call.callable.u64
                methodReceiverTuple :ast n: callableNode dst: rtupV
                if rtupV.length > 0 then {
                    rvb: st.lookupVarId nameId: (rtupV.get i: 0)
                    match (
                        rvb
                    ) case some then {
                        drainPendingBorrow :st
                        with tiv: rtupV.iterate do for segV: tiv loop st.typing.pendingBorrowPath.append segV
                    } case none then null
                }
            }
        }
        st.typing.callKind.set key: call.nid.u64 value: zast.callkind.regular
        return (ztypes.tid.create from: mres)
}
# mintSumArmInstance -- constructing a generic sum's ARM infers the whole type's
# argument from the payload given: mint that instance and answer its id.
mintSumArmInstance: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    dtp: u64
    subT: ztypes.tid
    isNullPay: bool
    pn0: StringView
} out callleg is {
        an2: st.reg.nameOf tid: (ztypes.tid.create from: subT.u64)
        monoName: "_\{an2}"
        subs2: (IdMapV zast.nameid v: u64)
        if (isNullPay) == false then {
            pv2: subT
            (subs2.set
                key: (nameIdOf :ast name: pn0)
                value: pv2
            )
        }
        vsH: (IdMapV zast.nameid v: u64)
        mintedT: (getOrMintSpec
            :st
            frame: st.curFrame
            :ast

            :unitDecl
            sfx: monoName.stringView
            templateId: (ztypes.tid.create from: dtp.u64)
            subs: subs2
            valSubs: vsH
            fallbackArg: subT
        )
        if mintedT > 0 then {
            setgu: mintedT
            stampGate :st nid: call.nid.u64 tid: setgu
            (st.typing.callKind.set
                key: call.nid.u64
                value: zast.callkind.unionCreate
            )
            return (callleg handled: true tid: mintedT)
        }
    return (callleg handled: false tid: ztypes.tid)
}

# checkGenericTypeCall -- the callable named a GENERIC type, so the call is an
# instantiation: bind the type arguments, mint the mono, and answer its id.
checkGenericTypeCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    dtp: u64
} out callleg is {
    result: ztypes.tid
        (validateGenericTypeArgs
            :ast
            :st
            :unitDecl
            :call
            tplId: (ztypes.tid.create from: dtp.u64)
            allowFrom: true
        )
        # Generic template: infer the mono (mirrors
        # _infer_generic_union_construction). A NULL-payload
        # arm with an argument names the type EXPLICITLY
        # (resolved as a type, never value-walked); a
        # param-payload arm infers from the value's type.
        armnId: (dottedChildNameId
            :ast
            n: (ast.nodes.get i: call.callable.u64)
        )
        (forceMemberOf
            :st
            frame: st.curFrame

            :ast
            parentTypeId: (ztypes.tid.create from: dtp.u64)
            nameId: armnId
        )
        co: (st.typing.declChildOfId
            parentTypeId: (ztypes.tid.create from: dtp.u64)
            nameId: armnId
        )
        payId: optU64Or o: co d: 0
        if payId > 0 then {
            pn0: st.reg.nameOf tid: (ztypes.tid.create from: payId.u64)
            isNullPay: false
            if pn0.stringView == "null" then isNullPay = true
            subT: ztypes.tid
            argFound: false
            kArgIter: u64
            for kArgIter < call.nargs loop {
                fargId: (zast.callArgAt :ast nid: call.nid i: kArgIter).u32
                kArgIter = kArgIter + 1
                farg: argRefAt :ast nid: (zast.nodeid.create from: fargId.u32)
                if (farg.nid.isZero) == false then {
                    if (argFound) == false then {
                        argFound = true
                        if isNullPay then {
                            etn: (paramTypeBaseName
                                :ast
                                op: (ast.nodes.get i: farg.operation.u64)
                            )
                            subT = ztypes.tid.create from: (optU64Or
                                o: (walkLookupTyperef
                                    :st
                                    frame: st.curFrame
                                    :ast

                                    :unitDecl
                                    base: etn.stringView
                                )
                                d: 0
                            )
                            if subT.isZero then {
                                # a cross-unit type arg (optionval.none ztypes.zlockstate):
                                # paramTypeBaseName/walkLookupTyperef miss a dotted ref, resolve cross-unit.
                                fargOpNode: ast.nodes.get i: farg.operation.u64
                                subT = ztypes.tid.create from: (dottedTyperefId
                                    :ast
                                    :st
                                    op: fargOpNode
                                )
                            }
                        } else {
                            avt2: (checkValueAt :st :unitDecl :ast nid: farg.operation)
                            mvt2: materialiseLiteral :ast :st :unitDecl t: avt2
                            subT = mvt2
                            fpbn: (bareAtomName
                                :ast
                                n: (ast.nodes.get i: farg.operation.u64)
                            )
                            if fpbn.length > 0 when (typeIsReftype
                                :st
                                tid: mvt2
                            ) then {
                                fpvo: st.lookupVarId nameId: (nameIdOf
                                    :ast
                                    name: fpbn.stringView
                                )
                                match (
                                    fpvo
                                ) case some then {
                                    (consumeBareArgOwnership
                                        :st
                                        :ast
                                        name: fpbn.stringView
                                        vid: fpvo
                                        nodeid: farg.nid
                                        lineno: farg.lineno
                                        colno: farg.colno
                                    )
                                } case none then null
                            }
                        }
                    }
                }
            }
            if subT > 0 then {
            if subT > 0 then {
                sleg: (mintSumArmInstance
                    :st
                    :unitDecl
                    :ast
                    :call
                    :dtp
                    :subT
                    :isNullPay
                    pn0: pn0.stringView
                )
                if sleg.handled then return sleg
            }
            }
        }
    return (callleg handled: false tid: result)
}
# checkTaggedCtorArg -- one argument of a tagged-type constructor: check it
# against the field or arm it fills, and take the ownership that field declares.
checkTaggedCtorArg: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dtp: u64
    unionCtorArm: StringView
    arg2Id: u32
} is {
    arg2: argRefAt :ast nid: (zast.nodeid.create from: arg2Id.u32)
    if (arg2.nid.isZero) == false then {
        # an owned copy: the walks below lend ast
        uan: zast.nameTextCopy :ast ref: arg2.name
        if uan.length > 0 when uan.stringView != "from" then {
            uum: "unknown argument '\{uan}'"
            (addError
                :st
                nodeid: arg2.nid
                lineno: arg2.lineno
                colno: arg2.colno
                e: zast.err.callError
                msg: uum
            )
        }
        uvt: (checkValueAt :st :unitDecl :ast nid: arg2.operation)
        # the arm stores its payload OWNED: a
        # bare-name reftype payload transfers
        upbn: (bareAtomName
            :ast
            n: (ast.nodes.get i: arg2.operation.u64)
        )
        if upbn.length > 0 when uvt > 0 when (typeIsReftype
            :st
            tid: uvt
        ) then {
            upvo: st.lookupVarId nameId: (nameIdOf
                :ast
                name: upbn.stringView
            )
            match (
                upvo
            ) case some then {
                (consumeBareArgOwnership
                    :st
                    :ast
                    name: upbn.stringView
                    vid: upvo
                    nodeid: arg2.nid
                    lineno: arg2.lineno
                    colno: arg2.colno
                )
            } case none then null
        }
        uparmo: (st.typing.declChildOf
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: dtp.u64)
            name: unionCtorArm
        )
        uparmid: optU64Or o: uparmo d: 0
        # a literal payload coerces at the arm's
        # payload type (restamp the bare node).
        if (isLiteralTypeId :st tid: uvt) then {
            if uparmid > 0 then {
                uiid: (innermostNodeId
                    :ast
                    n: (ast.nodes.get i: arg2.operation.u64)
                )
                if uiid > 0 then {
                    setup: uparmid
                    (stampGate
                        :st
                        nid: uiid.u64
                        tid: (ztypes.tid.create from: setup.u64)
                    )
                }
            }
        } else {
            # The parent is an ALREADY-monomorphised
            # instance, so the arm's payload type is
            # fixed and the value has to fit it. The
            # generic leg above infers its mono from
            # the payload; here there is nothing to
            # infer, and without this check the call
            # simply wears `dtp` whatever it holds --
            # so the return / argument checks
            # downstream compare that against itself
            # and can never fire.
            # A null-payload arm names a TYPE rather
            # than passing a value (optionval.none
            # u64), so it is not a payload at all.
            upnm: (st.reg.nameOf tid: (ztypes.tid.create from: uparmid.u64))
            upNull: upnm.stringView == "null"
            if uparmid > 0 when uvt > 0 when (upNull) == false then {
                if (typesCompatible
                    :ast
                    :st
                    a: uvt
                    b: (ztypes.tid.create from: uparmid.u64)
                ) == false then {
                    apn: st.reg.nameOf tid: uvt
                    dtn: (st.reg.nameOf tid: (ztypes.tid.create from: dtp.u64))
                    upm: "arm '\{unionCtorArm}' payload type mismatch: expected \{upnm}, got \{apn}"
                    # Name the rule for the one typedef
                    # shape that reaches here. The
                    # other direction (a typedef where
                    # its base is declared) is ALLOWED
                    # and never arrives: an arm payload
                    # is a typed slot like a parameter,
                    # so the whole-value substitution
                    # applies to it.
                    tdB: (typedefBaseOf
                        :st
                        tid: (ztypes.tid.create from: uparmid.u64)
                    )
                    upn: String
                    if tdB.u64 == uvt when tdB > 0 then {
                        upn = "a base type does not stand in for a typedef of it -- that direction is never implicit".string
                    }
                    uph: "convert at the boundary, or declare the target as the '\{dtn}' the value actually makes"
                    (addErrorH
                        :st
                        nodeid: arg2.nid
                        lineno: arg2.lineno
                        colno: arg2.colno
                        e: zast.err.callError
                        msg: upm
                        note: upn
                        hint: uph
                        width: 0
                    )
                }
            }
        }
    }
}

# checkTaggedTypeCall -- the callable named a non-generic TYPE reached through a
# tagged parent: a constructor for it, checked against the type's own fields.
checkTaggedTypeCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    dtp: u64
} out ztypes.tid is {
        unionCtorArm: (dottedChildName
            :ast
            n: (ast.nodes.get i: call.callable.u64)
        )
        kAiter2: u64
        for kAiter2 < call.nargs loop {
            arg2Id: (zast.callArgAt :ast nid: call.nid i: kAiter2).u32
            kAiter2 = kAiter2 + 1
            (checkTaggedCtorArg
                :st
                :unitDecl
                :ast
                :dtp
                unionCtorArm: unionCtorArm.stringView
                :arg2Id
            )
        }
        setuc: dtp
        (stampGate
            :st
            nid: call.nid.u64
            tid: (ztypes.tid.create from: setuc.u64)
        )
        (st.typing.callKind.set
            key: call.nid.u64
            value: zast.callkind.unionCreate
        )
        return (ztypes.tid.create from: dtp)
}
# checkGenericFnCall -- a GENERIC FUNCTION member reached through the dotted
# walk dispatches through the same machinery its bare-name form does: infer the
# type arguments from the call, mint the instance, and answer its return.
checkGenericFnCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    dro: ztypes.tid
} out ztypes.tid is {
        gfr: checkGenericCall :st :unitDecl :ast :call funcId: dro
        if gfr > 0 then {
            setgf: gfr
            stampGate :st nid: call.nid.u64 tid: setgf
        }
        st.typing.callKind.set key: call.nid.u64 value: zast.callkind.regular
        # A value receiver locks for the call's duration,
        # exactly like the concrete-method path: a generic
        # method's writer receiver must conflict with live
        # views. The lock lives in its own call scope (the
        # conflict check happens at take; the pop releases
        # it before the next statement). A unit-member
        # callee (io.eprintln) has no value root and skips.
        mcmG: st.pushCall
        callableNode: ast.nodes.get i: call.callable.u64
        rroG: methodReceiverRoot :ast n: callableNode
        if rroG.length > 0 then {
            rvoG: st.lookupVarId nameId: (nameIdOf :ast name: rroG.stringView)
            match (
                rvoG
            ) case some then {
                rvtG: st.lookup nameId: (nameIdOf :ast name: rroG.stringView)
                match (
                    rvtG
                ) case some then {
                    doLockG: false
                    rttG: st.reg.typetypeOf typeId: (ztypes.tid.create from: rvtG.u64)
                    isFPG: false
                    if rttG == ztypes.ztypetype.facetType then isFPG = true
                    if rttG == ztypes.ztypetype.protocolType then isFPG = true
                    if isFPG then {
                        doLockG = true
                    } else {
                        if (methodHasThisReceiver :st mid: dro) then {
                            if (typeIsReftype
                                :st
                                tid: (ztypes.tid.create from: rvtG.u64)
                            ) then doLockG = true
                        } else {
                            doLockG = true
                        }
                    }
                    if doLockG then {
                        callableNode: ast.nodes.get i: call.callable.u64
                        rmnG: (zast.nameTextAt
                            :ast
                            ref: (dottedChildNameId :ast n: callableNode)
                        )
                        shrG: (isContainerReaderCall
                            :ast
                            :st
                            recvTid: rvtG
                            mname: rmnG.stringView
                        )
                        if (methodReceiverIsView :st mid: dro) then shrG = true
                        (lockCallArg
                            :st
                            pool: ast.names
                            nameId: (nameIdOf :ast name: rroG.stringView)
                            callId: call.nid.u64
                            shared: shrG
                            nodeid: call.nid
                            lineno: call.lineno
                            colno: call.colno
                        )
                    }
                } case none then null
            } case none then null
        }
        if rroG.length == 0 then {
            # Nested receiver (`rec.field.append ...`): the
            # root-name block above cannot see it. Lock the
            # full receiver tuple; the immediate receiver
            # type drives the reader/writer kind.
            rtupG: (ListVal zast.nameid)
            callableNode: ast.nodes.get i: call.callable.u64
            methodReceiverTuple :ast n: callableNode dst: rtupG
            if rtupG.length > 1 then {
                rvoNG: st.lookupVarId nameId: (rtupG.get i: 0)
                match (
                    rvoNG
                ) case some then {
                    callableNode: ast.nodes.get i: call.callable.u64
                    rpidNG: dottedParentNodeId :ast n: callableNode
                    rvtNG: (ztyping.nodeTypeAt
                        tbl: st.typing.nodeType
                        nid: rpidNG.u64
                    )
                    if rvtNG > 0 when (typeIsReftype
                        :st
                        tid: (ztypes.tid.create from: rvtNG.u64)
                    ) then {
                        callableNode: ast.nodes.get i: call.callable.u64
                        rmnNG: (zast.nameTextAt
                            :ast
                            ref: (dottedChildNameId :ast n: callableNode)
                        )
                        shrNG: (isContainerReaderCall
                            :ast
                            :st
                            recvTid: rvtNG
                            mname: rmnNG.stringView
                        )
                        if (methodReceiverIsView
                            :st
                            mid: dro
                        ) then shrNG = true
                        (lockCallPath
                            :st
                            :ast
                            pool: ast.names
                            path: rtupG
                            callId: call.nid.u64
                            shared: shrNG
                            nodeid: call.nid
                            lineno: call.lineno
                            colno: call.colno
                        )
                    }
                } case none then null
            }
        }
        st.popTo marker: mcmG
        return gfr
}

# checkResolvedValueCall -- the callable resolved through the dotted walk to
# something that is NOT a method: a generic instantiation, a typedef, a
# function-pointer field, or a value whose type carries a `call`. Answers
# whether the leg handled the call outright, and the type it yields.
checkResolvedValueCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    dro: ztypes.tid
} out callleg is {
    result: ztypes.tid
        # A non-FUNCTION dotted member in callable position: a
        # tagged subtype constructs (the union/variant branch of
        # _dispatch_call_construction). Generic templates infer
        # their mono separately.
        calleeNodeId: nodeId n: (ast.nodes.get i: call.callable.u64)
        dtp: (optTidOr
            o: (st.typing.dpTaggedParent.get key: calleeNodeId.u64)
            d: ztypes.tid
        )
        if dtp > 0 then {
            isGenT: false
            {
                isgeneric9v: st.reg.isGenericOf tid: (ztypes.tid.create from: dtp.u64)
                    if isgeneric9v then isGenT = true
            }
            if isGenT then {
            gleg: checkGenericTypeCall :st :unitDecl :ast :call :dtp
            if gleg.handled then return gleg
            result = gleg.tid
            } else {
                tleg: checkTaggedTypeCall :st :unitDecl :ast :call :dtp
                return (callleg handled: true tid: tleg)
            }
        } else {
            # a GENERIC FUNCTION member (io.eprintln) dispatches
            # through the generic-call machinery like its bare-
            # name form.
            isGenF: false
            if dro < st.reg.typeById.length then {
                gf: st.reg.typeById.get i: dro
                if gf.typetype == ztypes.ztypetype.functionType then {
                    if gf.isgeneric then isGenF = true
                }
            }
            if isGenF then {
            fleg: checkGenericFnCall :st :unitDecl :ast :call :dro
                return (callleg handled: true tid: fleg)
            }
            # A generic non-FUNCTION dotted callee constructs its
            # instance in place: the .str conversion form resolves
            # the dotted path to the sized template, and the call
            # mints/stamps the instance (only the Call node).
            isGenD: false
            if dro < st.reg.typeById.length then {
                gz2: st.reg.typeById.get i: dro
                if gz2.isgeneric then {
                    if gz2.typetype != ztypes.ztypetype.functionType then isGenD = true
                }
            }
            if isGenD then {
                (validateGenericTypeArgs
                    :ast
                    :st
                    :unitDecl
                    :call
                    tplId: dro
                    allowFrom: false
                )
                gres2: (genericTypeConstruction
                    :ast
                    :st
                    :unitDecl
                    :call
                    tplId: dro
                )
                if gres2 > 0 then return (callleg handled: true tid: gres2)
            }
            # A plain cross-unit class/record dotted construction
            # (`unit.Type field: val`): the dotted callee resolved to
            # a constructible type (not a function / tagged subtype /
            # generic). Walk the ctor args (hoist + consume) and the
            # value IS the constructed type, so the binding stamps.
            dctt: st.reg.typetypeOf typeId: dro
            isCtorT: false
            if dctt == ztypes.ztypetype.classType then isCtorT = true
            if dctt == ztypes.ztypetype.recordType then isCtorT = true
            if isCtorT then {
                if call.nargs > 0 then {
                    dcm: st.pushCall
                    (walkCallArgsHoist
                        :st
                        :unitDecl
                        :ast
                        :call
                        funcId: dro
                        isCtor: true
                        reportUnknown: false
                        recvImplicit: false
                    )
                    checkMissingCallArgs :ast :st :call funcId: dro isCtor: true
                    (st.typing.callKind.set
                        key: call.nid.u64
                        value: zast.callkind.recordCreate
                    )
                    st.popTo marker: dcm
                    dck: dro
                    dcvv: true
                    st.typing.constructedTypes.set key: dck value: dcvv
                }
                setdc: dro
                stampGate :st nid: call.nid.u64 tid: setdc
                return (callleg handled: true tid: (ztypes.tid.create from: dro))
            }
        }
    return (callleg handled: false tid: result)
}
# checkBareGenericCall -- a bare-name call to a GENERIC function: infer its type
# arguments from the call, mint the instance, and answer its return type.
checkBareGenericCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    funcId: ztypes.tid
    cnId: zast.nameid
} out callleg is {
    result: ztypes.tid
    gtt: st.reg.typetypeOf typeId: funcId
    if gtt != ztypes.ztypetype.functionType then {
        errB: st.typing.errors.length
        vok: (validateGenericTypeArgs
            :ast
            :st
            :unitDecl
            :call
            tplId: funcId
            allowFrom: false
        )
        gres: genericTypeConstruction :ast :st :unitDecl :call tplId: funcId
        if gres > 0 then {
            stampConstructionKind :st nid: call.nid.u64 tid: gres
            return (callleg handled: true tid: gres)
        }
        # field-bound value args: infer the instance and construct
        # through the standard ctor flow, as a generic record/class
        # construction does.
        # an invalid type-argument list (unknown/duplicate already
        # diagnosed) never drives field-bound inference; the
        # single-diagnostic template resolution below stands
        gmid: ztypes.tid
        if vok then {
            gmid = (inferGenericConstruction
                :st
                :unitDecl
                :ast
                :call
                tplId: funcId
                reportMissing: vok
            )
        }
        if gmid > 0 then {
            calid: nodeId n: (ast.nodes.get i: call.callable.u64)
            if calid > 0 then {
                setc: gmid
                stampGate :st nid: calid.u64 tid: setc
            }
            cm: st.pushCall
            (walkCallArgsHoist
                :st
                :unitDecl
                :ast
                :call
                funcId: (ztypes.tid.create from: gmid.u64)
                isCtor: true
                reportUnknown: false
                recvImplicit: false
            )
            (checkMissingCallArgs
                :ast
                :st
                :call
                funcId: (ztypes.tid.create from: gmid.u64)
                isCtor: true
            )
            st.popTo marker: cm
            ctk: gmid
            ctv: true
            st.typing.constructedTypes.set key: ctk value: ctv
            setr: gmid
            stampGate :st nid: call.nid.u64 tid: setr
            stampConstructionKind :st nid: call.nid.u64 tid: gmid
            return (callleg handled: true tid: (ztypes.tid.create from: gmid))
        }
        # Construction failed AND a type-argument diagnostic was
        # emitted (unknown/duplicate by validation, or cannot-infer
        # by inferGenericConstruction): resolve to the template so a
        # single diagnostic stands without a downstream cascade.
        if st.typing.errors.length > errB then {
            sttE: funcId
            stampGate :st nid: call.nid.u64 tid: sttE
            return (callleg handled: true tid: (ztypes.tid.create from: funcId))
        }
    }
    gr: checkGenericCall :st :unitDecl :ast :call :funcId
    result = gr
    st.typing.callKind.set key: call.nid.u64 value: zast.callkind.regular
    if gr > 0 then {
        setgc: gr
        stampGate :st nid: call.nid.u64 tid: setgc
        # the callee is the TEMPLATE's declaration; the instance is
        # the call's stamped type
        declId92: (declOfTypeId :st tid: funcId)
        (stampRefDecl
            :st
            nid: (nodeId n: (ast.nodes.get i: call.callable.u64)).u64
            declId: declId92
        )
    }
    cn: zast.nameTextAt :ast ref: cnId
    if cn.stringView == "panic" then {
        calleeNodeId: nodeId n: (ast.nodes.get i: call.callable.u64)
        setpk: funcId
        stampGate :st nid: calleeNodeId.u64 tid: setpk
        st.typing.callKind.set key: call.nid.u64 value: zast.callkind.panicCall
    }
    if cn.stringView == "error" then {
        calid3: nodeId n: (ast.nodes.get i: call.callable.u64)
        seter: funcId
        stampGate :st nid: calid3.u64 tid: seter
        st.typing.callKind.set key: call.nid.u64 value: zast.callkind.errorCall
    }
    return (callleg handled: false tid: result)
}

# checkNonUserCall -- a callable that is not a user function: a builtin, a
# generic instantiation, a shell the walk could not place, or a name that
# resolves to nothing. Answers whether the leg handled the call, and its type.
checkNonUserCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    funcId: ztypes.tid
    isGen: bool
    cnId: zast.nameid
} out callleg is {
    result: ztypes.tid
        # `Box from: val` -- the system box (empty generic class body)
        # constructs through its own leg: t inferred from the value.
        isBox: false
        if isGen then {
            if (st.reg.typetypeOf typeId: funcId) == ztypes.ztypetype.classType then {
                bxn: st.reg.nameOf tid: funcId
                if bxn.stringView == "Box" then {
                    if (st.typing.declMemberCount ownerTid: funcId) == 0 then isBox = true
                }
            }
        }
        if isBox then {
            bres: checkBoxConstruction :st :unitDecl :ast :call tplId: funcId
            if bres > 0 then return (callleg handled: true tid: bres)
        }
        if isGen then {
            bleg: checkBareGenericCall :st :unitDecl :ast :call :funcId :cnId
            if bleg.handled then return bleg
            result = bleg.tid
        } else {
            kG: u64
            for kG < call.nargs loop {
                garg: argRefAt :ast nid: (zast.callArgAt :ast nid: call.nid i: kG)
                kG = kG + 1
                if (garg.nid.isZero) == false then {
                    checkValueAt :st :unitDecl :ast nid: garg.operation
                }
            }
            # a bare callable that resolves NOWHERE is an unknown
            # reference -- without this the emitter's fallback turns a
            # misspelled call into a constant 0 (mirrors the assignment
            # path's unresolved-value report)
            ubcn: unresolvedBareCallable :ast :st :unitDecl nid: call.nid
            if ubcn.length > 0 then {
                ubm0: "Unknown reference '\{ubcn}'"
                (addError
                    :st
                    nodeid: call.nid
                    lineno: call.lineno
                    colno: call.colno
                    e: zast.err.badReference
                    msg: ubm0
                )
            }
        }
    return (callleg handled: false tid: result)
}
# checkUserFnCall -- a call to a user-declared function or constructor: walk its
# arguments against the declared parameters, then decide what the RESULT pins.
# A borrow-returning call keeps its source locked for the binding's life.
checkUserFnCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    funcId: ztypes.tid
    isCtor: bool
    cnId: zast.nameid
} out ztypes.tid is {
    result: ztypes.tid
    calid: nodeId n: (ast.nodes.get i: call.callable.u64)
    setc: funcId
    stampGate :st nid: calid.u64 tid: setc
    # tooling: a bare callable resolving to a unit FUNCTION is a
    # def reference like any bare read (constructors excluded)
    if (isCtor) == false then {
        nameId97: cnId
        sfG: (declSurfaceOfName
            :st

            :ast
            :unitDecl
            nameId: nameId97
            tid: funcId
        )
        stampRefDecl :st nid: calid.u64 declId: sfG
    }
    cm: st.pushCall
    lockRoot: (walkCallArgsHoist
        :st
        :unitDecl
        :ast
        :call
        :funcId
        :isCtor
        reportUnknown: true
        recvImplicit: false
    )
    checkMissingCallArgs :ast :st :call :funcId :isCtor
    st.popTo marker: cm
    if isCtor then {
        # bare-name `T args...` inside T's own create. Reported, not returned
        # on: the walk finishes as it would have, so one offending construction
        # raises exactly one diagnostic.
        (ctorSelfRecursionAt
            :st
            nodeid: call.nid
            lineno: call.lineno
            colno: call.colno
            width: 1
            ctorTid: funcId
        )
        # a type in callable position constructs: the call's value is
        # the type itself.
        ctk: funcId
        ctv: true
        st.typing.constructedTypes.set key: ctk value: ctv
        result = ztypes.tid.create from: funcId.u64
        setr2: result
        stampGate :st nid: call.nid.u64 tid: setr2
        ctt: st.reg.typetypeOf typeId: funcId
        if ctt == ztypes.ztypetype.recordType then {
            st.typing.callKind.set key: call.nid.u64 value: zast.callkind.recordCreate
        }
        if ctt == ztypes.ztypetype.classType then {
            st.typing.callKind.set key: call.nid.u64 value: zast.callkind.classCreate
        }
        if ctt == ztypes.ztypetype.unionType then {
            st.typing.callKind.set key: call.nid.u64 value: zast.callkind.unionCreate
        }
    } else {
        st.typing.callKind.set key: call.nid.u64 value: zast.callkind.regular
        rnOpt: st.typing.funcReturnNode.get key: funcId
        match (
            rnOpt
        ) case some then {
            rtOpt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: rnOpt
            if rtOpt > 0 then {
                result = ztypes.tid.create from: rtOpt.u64
                setr: result
                stampGate :st nid: call.nid.u64 tid: setr
            }
        } case none then null
        # A `.borrow`-marked return borrows from the lock parameter's
        # argument: report the source for the binding site. Argument
        # evaluation residue drains first (owning calls consume it).
        drainPendingBorrow :st
        xroot2: st.typing.lastLockParamRoot
        if (xroot2.isZero) == false then {
            st.typing.lastLockParamRoot = zast.nameid
            drainPendingBorrow :st
            st.typing.pendingBorrowPath.append xroot2
        }
        if (optBoolOr
            o: (st.typing.funcReturnsTakex.get key: funcId)
            d: false
        ) when (lockRoot.isZero) == false then {
            # `takex`: pin the source, but the binding stays OWNED
            drainPendingBorrow :st
            st.typing.pendingBorrowPath.append lockRoot
            st.typing.pendingBorrowOwned = true
        }
        if (optBoolOr
            o: (st.typing.funcReturnsBorrow.get key: funcId)
            d: false
        ) when (lockRoot.isZero) == false then {
            drainPendingBorrow :st
            st.typing.pendingBorrowPath.append lockRoot
            if (returnIsIteratorTid :st tid: result) == false then {
                st.typing.pendingBorrowShared = true
            } else {
                if (methodReceiverIsView :st mid: funcId) then st.typing.pendingBorrowShared = true
            }
            # An `out T.view` result is a READONLY reference: shared pin,
            # and the binding it lands on may only be read.
            if (optBoolOr o: (st.typing.funcReturnsView.get key: funcId) d: false) then {
                st.typing.pendingBorrowShared = true
                st.typing.pendingBorrowReadonly = true
            }
        }
    }
    return result
}
# checkWrappedCall -- a callable that is itself an expression (a parenthesised
# call, or a value the walk produced): type it, then treat what it yields as
# the thing being called. 0 when it yields nothing callable.
checkWrappedCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
} out ztypes.tid is {
    errX: st.typing.errors.length
    wcv: checkValueAt :st :unitDecl :ast nid: call.callable
    if wcv.u64 == 0 when st.typing.errors.length == errX then {
        reportUnresolvedValue :st :unitDecl :ast nid: call.callable
    }
    if wcv > 0 then {
        # A non-FUNCTION wrapped callee is the paren-mono construction
        # form: value args ride the standard ctor walk (call scope,
        # hoists, consumption); arg-less stays a bare construction.
        isWType: true
        if (st.reg.typetypeOf typeId: wcv) == ztypes.ztypetype.functionType then isWType = false
        # a container template has its own native create path, so its
        # paren-construction arguments take no standard ctor scope.
        wgix: u64
        {
            wgi: st.reg.genericOriginOf tid: wcv
            if wgi > 0 then wgix = wgi
        }
        if wgix > 0 then {
            if wgix == (builtinTidTcRo :ast :st base: "ListRef") then isWType = false
            if wgix == (builtinTidTcRo :ast :st base: "ListVal") then isWType = false
            if wgix == (builtinTidTcRo :ast :st base: "MapRR") then isWType = false
            if wgix == (builtinTidTcRo :ast :st base: "MapRV") then isWType = false
            if wgix == (builtinTidTcRo :ast :st base: "MapVR") then isWType = false
            if wgix == (builtinTidTcRo :ast :st base: "MapVV") then isWType = false
            if wgix == (builtinTidTcRo :ast :st base: "SetRef") then isWType = false
            if wgix == (builtinTidTcRo :ast :st base: "SetVal") then isWType = false
        }
        if isWType when call.nargs > 0 then {
            wcm: st.pushCall
            (walkCallArgsHoist
                :st
                :unitDecl
                :ast
                :call
                funcId: wcv
                isCtor: true
                reportUnknown: false
                recvImplicit: false
            )
            checkMissingCallArgs :ast :st :call funcId: wcv isCtor: true
            st.popTo marker: wcm
            wck: wcv
            wcvv: true
            st.typing.constructedTypes.set key: wck value: wcvv
        } else {
            kW: u64
            for kW < call.nargs loop {
                warg: argRefAt :ast nid: (zast.callArgAt :ast nid: call.nid i: kW)
                kW = kW + 1
                if (warg.nid.isZero) == false then {
                    checkValueAt :st :unitDecl :ast nid: warg.operation
                }
            }
        }
        setwc: wcv
        stampGate :st nid: call.nid.u64 tid: setwc
        stampConstructionKind :st nid: call.nid.u64 tid: wcv
        return wcv
    }
    return (ztypes.tid.create from: 0)
}
# bareCalleeTid -- the function a BARE callable name resolves to: the local scope
# first, then the enclosing unit's definitions, then the prelude. 0 when the
# name reaches nothing callable.
bareCalleeTid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    cnId: zast.nameid
} out ztypes.tid is {
    funcId: ztypes.tid
    if (cnId.isZero) == false then {
        # A local variable of FUNCTION type (a spec-typed param or a
        # function reference) is callable; locals shadow unit names.
        lvo: st.lookup nameId: cnId
        match (
            lvo
        ) case some then {
            if (st.reg.typetypeOf typeId: (ztypes.tid.create from: lvo.u64)) == ztypes.ztypetype.functionType then {
                funcId = ztypes.tid.create from: lvo.u64
                st.typing.callKind.set key: call.nid.u64 value: zast.callkind.callable
                # callee-use variable id: calling through a fn-typed
                # variable reads it, so it stamps like a value atom
                cvo: st.lookupVarId nameId: cnId
                match (
                    cvo
                ) case some then {
                    setcv: cvo
                    st.typing.atomVariableId.set key: call.callable.u64 value: setcv
                } case none then null
            }
        } case none then null
        if funcId <= 0 then {
            fo: walkLookupTyperefById :st frame: st.curFrame :ast :unitDecl baseId: cnId
            match (
                fo
            ) case some then {
                funcId = ztypes.tid.create from: fo.u64
            } case none then {
                # The callee is a main-unit type not yet demand-resolved
                # (a construction inside a method body, walked before the
                # constructed type). Resolve it on demand, then retry --
                # otherwise the construction returns 0 and the binding goes
                # unstamped.
                maybeWalkMethodsById :st frame: st.curFrame :unitDecl :ast nameId: cnId
                fo2: walkLookupTyperefById :st frame: st.curFrame :ast :unitDecl baseId: cnId
                match (
                    fo2
                ) case some then {
                    funcId = ztypes.tid.create from: fo2.u64
                } case none then null
            }
        }
    }
    return funcId
}
# checkMetaCreateCall -- `meta.create` constructs the ENCLOSING type: the raw
# allocator's parameters are that type's field children, so the argument walk
# rides the type rather than a function.
checkMetaCreateCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    mcid: u32
} out ztypes.tid is {
    # `meta.create` constructs the enclosing type: the raw allocator's
    # params are the type's field children, so the ctor arg walk
    # (hoists, coercion, field consumption) rides funcId = the type.
    mtid: st.typing.currentThisTid.u64
    if mtid > 0 then {
        setmb: mtid
        stampGate :st nid: mcid.u64 tid: (ztypes.tid.create from: setmb.u64)
        mcm: st.pushCall
        (walkCallArgsHoist
            :st
            :unitDecl
            :ast
            :call
            funcId: (ztypes.tid.create from: mtid.u64)
            isCtor: true
            reportUnknown: false
            recvImplicit: false
        )
        (checkMissingCallArgs
            :ast
            :st
            :call
            funcId: (ztypes.tid.create from: mtid.u64)
            isCtor: true
        )
        st.popTo marker: mcm
        setmc: mtid
        stampGate :st nid: call.nid.u64 tid: (ztypes.tid.create from: setmc.u64)
        (stampConstructionKind
            :st
            nid: call.nid.u64
            tid: (ztypes.tid.create from: mtid)
        )
        return (ztypes.tid.create from: mtid)
    }
    return (ztypes.tid.create from: 0)
}
# checkDottedCallableCall -- the callable resolved through a dotted path.
# An unresolved one (a data block's `.index`) still walks its arguments so
# their atoms stamp; a resolved one dispatches as a method or a value call.
checkDottedCallableCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    dro: ztypes.tid
} out callleg is {
    result: ztypes.tid
    if dro.isZero then {
        # unresolved dotted callable (a data block's `.index`): the
        # call stays untyped, but its args are still values -- check
        # them so their atoms stamp (atomVariableId / refDecl)
        kU: u64
        for kU < call.nargs loop {
            uwa: argRefAt :ast nid: (zast.callArgAt :ast nid: call.nid i: kU)
            kU = kU + 1
            if (uwa.nid.isZero) == false then {
                checkValueAt :st :unitDecl :ast nid: uwa.operation
            }
        }
        return (callleg handled: true tid: (ztypes.tid.create from: 0))
    } else {
        # A non-generic FUNCTION member dispatches as a user method
        # call: call scope, arg walk, the callee's return, and the
        # borrow-return report.
        isMethodFn: false
        if dro < st.reg.typeById.length then {
            mzo: st.reg.typeById.get i: dro
            if mzo.typetype == ztypes.ztypetype.functionType then {
                if (mzo.isgeneric) == false then isMethodFn = true
            }
        }
        if isMethodFn then {
        mleg: (checkResolvedMethodCall
            :st
            :unitDecl
            :ast
            :call
            :dro
        )
        return (callleg handled: true tid: mleg)
        } else {
        vleg: (checkResolvedValueCall
            :st
            :unitDecl
            :ast
            :call
            :dro
        )
        if vleg.handled then return vleg
        result = vleg.tid
        }
    }
    return (callleg handled: false tid: result)
}


# checkCall -- type a call. C1 handles the `return <value>` control-flow form:
# stamp the callable atom with return's type, mark the call RETURN, walk the
# return value, and resolve the call to `never`. Other call kinds land later.
checkCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
} out ztypes.tid is {
    result: ztypes.tid
    st.typing.callKind.set key: call.nid.u64 value: zast.callkind.unknown
    cnId: atomNameId :ast n: (ast.nodes.get i: call.callable.u64)
    if cnId == zast.names.wkReturn then {
        result = checkControlBuiltinCall :st :unitDecl :ast :call
    } else {
        # A regular call. A dotted callable resolves through the dotted-path
        # walk first; an unresolved member bails with the args unwalked. A
        # bare-name callable: a non-generic user function pushes a call scope
        # and resolves to its return type; a generic callee (e.g. print) infers
        # a clone; an unresolvable callable just has its args walked (its
        # callable/result/mono are out of the own+system+collections filter).
        # A parenthesized construction in callable position re-applies its
        # init arguments: the value is the constructed type.
        # the callable's shape, read through a view scoped to this block:
        # the legs below lend ast
        isWrapCall: false
        {
            wrapN: ast.nodes.get i: call.callable.u64
            isWrapCall = wrapN.expression
        }
        if isWrapCall then {
            wres: checkWrappedCall :st :unitDecl :ast :call
            if (wres.isZero) == false then return wres
        }
        mcb: metaCreateBaseId :ast n: (ast.nodes.get i: call.callable.u64)
        mcid: u32
        match (
            mcb
        ) case some then {
            mcid = mcb
        } case none then null
        if mcid > 0 when (st.typing.currentThisTid.isZero) == false then {
            mcres: checkMetaCreateCall :st :unitDecl :ast :call :mcid
            if (mcres.isZero) == false then return mcres
        }
        dro: callableDottedResultAt :st :unitDecl :ast nid: call.callable
        match (
            dro
        ) case some then {
            dleg: checkDottedCallableCall :st :unitDecl :ast :call :dro
            if dleg.handled then return dleg.tid
            result = dleg.tid
        } case none then null
        funcId: ztypes.tid
        if (cnId.isZero) == false then funcId = bareCalleeTid :st :unitDecl :ast :call :cnId
        # the resolved id names the definition wherever it lives, so a callee in
        # another unit is walked at its call site like a local one. The
        # name-keyed trigger could only ever find same-unit definitions: it
        # looked `cn` up in the unit being walked.
        if funcId > 0 then walkDefinitionById :st :ast tid: funcId
        # inside a unit mono's instance walk, a bare callee naming a TEMPLATE
        # member is the MONO's member: the same definition with the argument
        # substitution applied to its parameters and return
        if funcId > 0 when st.typing.curMonoStamp > 0 then {
            funcId = (monoMemberOf
                :st
                templateFnTid: funcId
                nameId: cnId
            )
        }
        isUser: false
        isGen: false
        isCtor: false
        if funcId > 0 then {
            if funcId >= st.reg.typeById.length then return result
            zo: st.reg.typeById.get i: funcId
            if zo.isgeneric then {
                isGen = true
            } else {
                isUser = true
                if zo.typetype != ztypes.ztypetype.functionType then isCtor = true
            }
        }
        tdb0: u64
        if isCtor then tdb0 = typedefBaseOf :st tid: funcId
        if tdb0 > 0 then return (checkTypedefCreate
            :st
            :unitDecl
            :ast
            :call
            tdId: funcId
        )
        if isUser then {
            result = checkUserFnCall :st :unitDecl :ast :call :funcId :isCtor :cnId
        } else {
            nleg: (checkNonUserCall
                :st
                :unitDecl
                :ast
                :call
                :funcId
                :isGen
                :cnId
            )
            if nleg.handled then return nleg.tid
            result = nleg.tid
        }
    }
    return result
}
# healGenericReturn -- a generic-instance return (`out (optionval t: u64)`) has no
# bare pendingTyperef name, so the substitution path leaves the mono's return
# unset, and a native template has no body walk to heal it later. Heal from the
# template's resolved return type, respecializing a spec that mentions generic
# params -- the same treatment the generic-class method path gets.
healGenericReturn: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    funcId: ztypes.tid
    mid: ztypes.tid
} is {
    # A generic-instance return (`out (optionval t: u64)`) has no bare
    # pendingTyperef name, so the sub/name path above leaves the mono's
    # return unset -- a native template has no body walk to heal it later.
    # Heal from the template's resolved return type, respecializing a spec
    # that mentions generic params (mirrors the generic-class method path).
    rhas: false
    {
        rmo: st.reg.returnTypeOf tid: mid
        if rmo > 0 then rhas = true
    }
    if (rhas) == false then {
        rto: u64
        {
            rns: st.typing.funcReturnNode.get key: funcId
            match (
                rns
            ) case some then {
                rst: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: rns
                if rst > 0 then rto = rst
            } case none then null
        }
        if rto == 0 then {
            tro: st.reg.returnTypeOf tid: funcId
            if tro > 0 then rto = tro
        }
        if rto > 0 then {
            respecIdSubs: (IdMapV u64 v: u64)
            rr: (respecialize
                :st
                frame: st.curFrame
                :ast

                :unitDecl
                specTid: rto
                idSubs: respecIdSubs
            )
            rt: rto
            if rr > 0 then rt = rr
            if (st.reg.typetypeOf typeId: (ztypes.tid.create from: rt.u64)) != ztypes.ztypetype.genericParam then {
                st.reg.setReturnType typeId: mid value: rt
            }
        }
    }
}
# inferGenericCallSubs -- read one call's arguments into the generic-parameter
# substitutions: an explicit type argument names its parameter, a value argument
# infers from the type it walks to, and a positional one binds by index.
inferGenericCallSubs: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    gparams: (ListVal zast.nameid).view
    pNames: (ListVal zast.nameid).view
    subs: (IdMapV zast.nameid v: u64)
    funcId: ztypes.tid
    pHolders: (ListVal zast.nameid).view
} is {
    posIdx: u64
    kAiter: u64
    for kAiter < call.nargs loop {
        argId: (zast.callArgAt :ast nid: call.nid i: kAiter).u32
        kAiter = kAiter + 1
        arg: argRefAt :ast nid: (zast.nodeid.create from: argId.u32)
        if (arg.nid.isZero) == false then {
            an2: arg.name
            isTypeArg: false
            tgi: gparams.iterate
            for gp2: tgi loop {
                if an2 == gp2 then isTypeArg = true
            }
            if isTypeArg then {
                # an owned copy: the walks below lend ast
                tn3: (zast.nameTextCopy
                    :ast
                    ref: (atomNameId :ast n: (ast.nodes.get i: arg.operation.u64))
                )
                to3: (walkLookupTyperef
                    :st
                    frame: st.curFrame
                    :ast

                    :unitDecl
                    base: tn3.stringView
                )
                match (
                    to3
                ) case some then {
                    sv: to3
                    subs.set key: an2 value: sv
                } case none then null
            } else {
                avt: (checkValueAt :st :unitDecl :ast nid: arg.operation)
                mat: materialiseLiteral :ast :st :unitDecl t: avt
                holder: zast.nameid
                # a holder of 0 is a parameter whose type name the pool never
                # interned (a minted mono like `ListRef_String`): it binds no
                # generic parameter, which is not the same as an unknown label
                argFound: false
                if (an2.isZero) == false then {
                    hi: u64
                    hn2: pNames.length
                    for hi < hn2 loop {
                        if (pNames.get i: hi) == an2 then {
                            holder = pHolders.get i: hi
                            argFound = true
                        }
                        hi = hi + 1
                    }
                    if (argFound) == false then {
                        an2T: zast.nameTextAt :ast ref: an2
                        m3: "unknown argument '\{an2T}'"
                        sug3: suggestSimilar :ast :st parentTypeId: funcId name: an2T.stringView
                        h3: String
                        if sug3.length > 0 then {
                            hh3: "did you mean '\{sug3}'?"
                            h3 = hh3
                        }
                        en3: String
                        (addErrorH
                            :st
                            nodeid: arg.nid
                            lineno: arg.lineno
                            colno: arg.colno
                            e: zast.err.callError
                            msg: m3
                            note: en3
                            hint: h3
                            width: an2T.length.u32.orPanic
                        )
                    }
                } else {
                    if posIdx < pHolders.length then {
                        holder = pHolders.get i: posIdx
                    }
                }
                posIdx = posIdx + 1
                if (holder.isZero) == false when mat > 0 then {
                    hgot: subs.get key: holder
                    match (
                        hgot
                    ) case some then null case none then {
                        sv2: mat
                        subs.set key: holder value: sv2
                    }
                }
            }
        }
    }
}
# substituteGenericReturn -- the mono's return type, from the template's return
# NODE with the call's substitutions applied. getOrMintSpec resolved the mono
# structurally through the trie and reports whether it minted, so a reused spec
# keeps the return it already has.
substituteGenericReturn: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    funcId: ztypes.tid
    mid: ztypes.tid
    subs: (IdMapV zast.nameid v: u64).view
} is {
    rno: st.typing.funcReturnNode.get key: funcId
    match (
        rno
    ) case some then {
        rk2: zast.nameid
        {
            rko: st.typing.pendingTyperef.get key: rno
            match (
                rko
            ) case some then {
                rk2 = rko
            } case none then null
        }
        if (rk2.isZero) == false then {
            rgot2: subs.get key: rk2
            match (
                rgot2
            ) case some then {
                st.reg.setReturnType typeId: mid value: rgot2
            } case none then {
                # an owned copy: the walks below lend ast
                rk2T: zast.nameTextCopy :ast ref: rk2
                rconc: (walkLookupTyperef
                    :st
                    frame: st.curFrame
                    :ast

                    :unitDecl
                    base: rk2T.stringView
                )
                match (
                    rconc
                ) case some then {
                    st.reg.setReturnType typeId: mid value: rconc
                } case none then null
            }
        }
    } case none then null
}
# genericCallHolders -- the template's value parameters whose declared types name a
# generic parameter. Inferring the call's type arguments reads them by name, so
# their names and the parameters they hold are collected once, up front.
genericCallHolders: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    funcId: ztypes.tid
    pNames: (ListVal zast.nameid)
    pHolderIds: (ListVal u64)
    pHolders: (ListVal zast.nameid)
} out (ListVal zast.nameid) is {
    gparams: (st.reg.genericParamNamesOf tdecl: (st.typing.declIdOfType typeId: funcId))
    {
        gcNms: (ListVal u64)
        gcTds: (ListVal u64)
        st.typing.declMemberList ownerTid: funcId names: gcNms tids: gcTds
        {
            gci: u64
            gcn: gcNms.length
            for gci < gcn loop {
                gcNid: gcNms.get i: gci
                cto: gcTds.get i: gci
                gci = gci + 1
                {
                    # the receiver is implicit at method call sites: keep it
                    # out of the positional holder list so a label-free arg
                    # maps to the first USER param (T holders included). The
                    # receiver is the shorthand `this` or the type's recorded
                    # long-form receiver name.
                    isRecv: gcNid == zast.names.wkThis.u64
                    if (isRecv) == false then {
                        isRecv = (st.reg.thisParamNameIs
                            tid: funcId
                            nameId: (zast.nameid.create from: gcNid.u32.orPanic)
                        )
                    }
                    if (isRecv) == false then {
                        pNames.append (zast.nameid.create from: gcNid.u32.orPanic)
                        cto2: cto
                        pHolderIds.append cto2
                    }
                }
            }
        }
    }
    phi: u64
    phn: pHolderIds.length
    for phi < phn loop {
        hid: pHolderIds.get i: phi
        hn: st.reg.nameOf tid: (ztypes.tid.create from: hid.u64)
        pHolders.append (nameIdOf :ast name: hn.stringView)
        phi = phi + 1
    }
    return gparams
}

# checkGenericCall -- a call to a generic user function: walk the value args,
# infer the type-param bindings (explicit `param: Type` args, else each value
# arg's materialised type through the parameter it feeds), mint the instance
# (children substituted; return substituted from the recorded `out` placeholder
# name), synthesize the clone scope on first instantiation (empty, named by the
# instance, unreachable per the template body's syntactic divergence -- bodied
# templates only, so native generics like print add no scope), stamp the
# callable with the instance, and resolve to the instance's return. Nested
# control flow inside generic bodies needs a real clone walk and is deferred.
checkGenericCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    funcId: ztypes.tid
} out ztypes.tid is {
    pNames: (ListVal zast.nameid)
    pHolderIds: (ListVal u64)
    pHolders: (ListVal zast.nameid)
    gparams: (genericCallHolders
        :st
        :ast
        :funcId
        :pNames
        :pHolderIds
        :pHolders
    )
    subs: (IdMapV zast.nameid v: u64)
    (inferGenericCallSubs
        :st
        :unitDecl
        :ast
        :call
        :gparams
        :pNames
        :subs
        :funcId
        :pHolders
    )
    mname: st.reg.nameOf tid: funcId
    if mname.length == 0 then return (ztypes.tid.create from: 0)
    gsfx4: String
    allOk: true
    gtk4: declOfTypeId :st tid: funcId
    genericParamIter: gparams.iterate
    for gp3: genericParamIter loop {
        ggot: subs.get key: gp3
        match (
            ggot
        ) case some then {
            (checkConstraintSat
                :st
                frame: st.curFrame
                :ast

                tdecl: gtk4
                paramName: gp3
                argTid: (ztypes.tid.create from: ggot.u64)
            )
            an4: (monoValName
                :st
                frame: st.curFrame
                :ast
                tid: (ztypes.tid.create from: ggot.u64)
            )
            gsfx4.append s: "_"
            gsfx4.append s: an4
        } case none then {
            allOk = false
        }
    }
    if allOk == false then return (ztypes.tid.create from: 0)
    if gparams.length == 0 then return (ztypes.tid.create from: 0)
    vsI: (IdMapV zast.nameid v: u64)
    mid: (getOrMintSpec
        :st
        frame: st.curFrame
        :ast

        :unitDecl
        sfx: gsfx4.stringView
        templateId: funcId
        :subs
        valSubs: vsI
        fallbackArg: 0
    )
    # getOrMintSpec resolved the mono structurally through the trie and reports
    # whether it minted rather than reusing an existing spec
    wasNew: st.reg.specWasFresh
    (substituteGenericReturn
        :st
        :unitDecl
        :ast
        :funcId
        :mid
        :subs
    )
    healGenericReturn :st :unitDecl :ast :funcId :mid
    if wasNew then {
        dvo: st.typing.fnBodyDiverges.get key: funcId
        match (
            dvo
        ) case some then {
            csname: "function:\{mname}\{gsfx4}"
            cm2: st.pushBlock name: csname.stringView
            if dvo then st.markUnreachable
            st.popTo marker: cm2
        } case none then null
    }
    # The arg walk above (checkValue per value arg) can leave a pending
    # borrow from a projection argument (s.stringView): drain it -- the
    # call's result is an OWNED value, so a binding of it must not borrow
    # the argument's source. A view-returning generic native would need to
    # propagate its own borrow here instead.
    drainPendingBorrow :st
    with gsub: subs.iterateItems do for ge: gsub loop {
        gk: (ztyping.callslot
            call: call.nid.u64
            param: ge.key.u64
        )
        st.typing.callGenericBinding.set key: gk value: ge.value
    }
    calleeNodeId: nodeId n: (ast.nodes.get i: call.callable.u64)
    setc2: mid
    stampGate :st nid: calleeNodeId.u64 tid: setc2
    return (optTidOr o: (methodReturnOf :st :mid) d: ztypes.tid)
}

# subjectAtomName -- a match subject's bare-atom name (narrowing requires a
# simple addressable name): unwrap expression wrappers, "" for dotted/complex
# subjects and numeric atoms.
subjectAtomName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (subjectAtomName :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        saB: ast.names.texts.get i: n.name.u64
        if (isNumericLiteralName name: saB.stringView) then {
            return "".string
        } else {
            return saB.copy
        }
    } else {
        return "".string
    }
}

# sumSubtypeNames -- a union/variant's arm names: its members minus the
# synthesized ones (functions, the tag data record, enums).
sumSubtypeNames: function {ast: Ast.view st: zenv.ZSymbolTable.view sid: u64} out List String is {
    arms: (List String)
    (zenv.sumArmNames
        ty: st.typing
        reg: st.reg
        pool: ast.names
        tid: (ztypes.tid.create from: sid.u64)
        names: arms
    )
    return arms
}

# isEmptyBody -- a statement block with no statement lines (an empty
# `{}` or `null` clause body).
isEmptyBody: function {n: Node.view} out bool is {
    match (
        n
    ) case statement then {
        return n.statements.length == 0
    } else {
        return false
    }
}
# genericParamSubjectTid -- the GENERIC_PARAM type a `match t` subject names,
# once the declaration that owns the parameter is known. 0 when the
# declaration has no parameter of that name.
genericParamSubjectTid: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    casenode: caseref
    gdecl: ztypes.declid
    gsn: StringView
} out ztypes.tid is {
    subjT: ztypes.tid
    pgo: (st.reg.genericParamTidOf
        tdecl: gdecl
        paramName: (nameIdOf :ast name: gsn)
    )
    match (
        pgo
    ) case some then {
        subjT = ztypes.tid.create from: pgo.u64
    } case none then {
        ptid: (st.reg.newType
            name: gsn
            typetype: ztypes.ztypetype.genericParam
        )
        (st.reg.setGenericParamTid
            tdecl: gdecl
            paramName: (nameIdOf :ast name: gsn)
            tid: ptid
        )
        subjT = ptid
    }
    gsnid: nodeId n: (ast.nodes.get i: casenode.subject.u64)
    if gsnid > 0 when subjT > 0 then {
        # direct write, NOT stampGate: this genericParam stamp IS
        # the dissection marker the emitter dispatches on -- it
        # must survive the template walk's param-stamp suppression
        # AND override any substituted per-mono stamp the general
        # subject walk wrote (the canonical param tid is in
        # monoParamSubst now, so stampGate substitutes it)
        setgs: subjT
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: gsnid.u64 tid: setgs
        if st.typing.curMonoStamp > 0 then {
            gmk: (ztyping.monostamp mono: st.typing.curMonoStamp node: gsnid.u64)
            st.typing.monoNodeType.set key: gmk value: setgs
        }
    }
    return subjT
}
# monoSubjectDecl -- the declaration a `match t` subject resolves to when the
# enclosing owner did not claim it: a unit-level generic template whose
# parameter list carries the name. 0 when none does.
monoSubjectDecl: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
    gsn: StringView
} out ztypes.declid is {
    gdecl: ztypes.declid
    # the template's own body walk runs with unitDecl = the
    # TEMPLATE's name; the template def lives in the main unit,
    # which the registry names -- the eager walk's current unit
    # happened to be it for every program that reaches here, but
    # only because such a template is declared where main is.
    gunm: unitNameTextOf :st :ast :unitDecl
    gmud: st.typing.mainUnitRoot
    gcand: (declOfUnitDef
        :st
        frame: st.curFrame
        unitDecl: gmud
        nameId: (nameIdOf :ast name: gunm.stringView)
    )
    if gcand > 0 then {
        if (st.reg.isGenericParamOf
            tdecl: gcand
            name: (nameIdOf :ast name: gsn)
        ) then gdecl = gcand
    }
    return gdecl
}


# caseGenericSubjectTid -- the type of a `match` subject that is not a value: a
# bare generic parameter, resolved against the enclosing generic context so it
# stamps as a genericParam and the emitter can dissect it per mono. 0 when the
# subject names no such parameter.
caseGenericSubjectTid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    casenode: caseref
} out ztypes.tid is {
    subjT: ztypes.tid
    gsn: subjectAtomName :ast n: (ast.nodes.get i: casenode.subject.u64)
    if gsn.length > 0 then {
        gdecl: ztypes.declid
        {
            gdecl = (declOfUnitDef
                :st
                frame: st.curFrame
                unitDecl: st.typing.synthOwnerUnit
                nameId: st.typing.synthOwnerName
            )
        }
        if (gdecl.isZero) == false then {
            if (st.reg.isGenericParamOf
                tdecl: gdecl
                name: (nameIdOf :ast name: gsn.stringView)
            ) == false then {
                gdecl = ztypes.declid.create from: 0
            }
        }
        if gdecl.isZero then {
            gur: unitDecl
            if (gur.isZero) == false then {
                if (st.reg.isGenericParamOf
                    tdecl: gur
                    name: (nameIdOf :ast name: gsn.stringView)
                ) then gdecl = gur
            }
        }
        if gdecl.isZero when st.typing.curMonoStamp > 0 then {
            # a mono-clone body walk: the subject's template is the
            # current mono's generic origin
            mog: ztypes.tid
            {
                mgo: st.reg.genericOriginOf tid: (ztypes.tid.create from: st.typing.curMonoStamp)
                if mgo > 0 then mog = mgo
            }
            if mog > 0 then {
                gdecl = declOfTypeId :st tid: (ztypes.tid.create from: mog.u64)
                if (gdecl.isZero) == false then {
                    if (st.reg.isGenericParamOf
                        tdecl: gdecl
                        name: (nameIdOf :ast name: gsn.stringView)
                    ) == false then gdecl = ztypes.declid.create from: 0
                }
            }
        }
        if gdecl.isZero then {
        if gdecl.isZero then gdecl = (monoSubjectDecl :st :ast :unitDecl gsn: gsn.stringView)
        }
        if (gdecl.isZero) == false then {
            subjT = (genericParamSubjectTid
                :st
                :ast
                :casenode
                :gdecl
                gsn: gsn.stringView
            )
        }
    }
    return subjT
}


# checkCase -- walk a match: push the `match` scope, type the subject, push
# `match_body` (resetting the bare-name subject's narrowing), then per arm an
# `arm:{name}` scope with a shadow-narrowing overlay (the subject resolves to
# the arm payload in the body), tracking diverging arms; an else arm excludes
# the covered subtypes. After popping, an exhaustive all-diverging match
# resolves to `never` (a completing-arm result type lands with a value-match
# example) and each diverging arm's subtype is excluded from the subject in
# the enclosing scope (all-excluded marks it unreachable).
casearmfacts: record {
    empty: bool
    diverges: bool
}
# narrowCaseArmSubject -- inside an arm, the subject IS the arm's payload: narrow
# the binding to it, and carry the payload's readonly-ness from the parent.
narrowCaseArmSubject: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    targetName: StringView
    armName: StringView
    armTid: u64
    subjT: ztypes.tid
} is {
    if armTid == 0 then return
    (st.narrow
        nameId: (nameIdOf :ast name: targetName)
        toTypeId: armTid
        subtypeName: (nameIdOf :ast name: armName)
        shadow: true
    )
    (armPayloadReadonly
        :st
        :ast
        subject: (nameIdOf :ast name: targetName)
        parentTid: subjT
        armName: (nameIdOf :ast name: armName)
        payloadTid: (ztypes.tid.create from: armTid.u64)
    )
}
# checkSumArmName -- an arm of a sum-typed match must name one of the subject's
# arms; report the ones it could have meant when it does not.
checkSumArmName: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    clause: caseclauseref
    subjT: ztypes.tid
    armName: StringView
    armTid: u64
} is {
    if armTid == 0 then {
        subjTn: st.reg.nameOf tid: subjT
        amsg: "type '\{subjTn}' has no arm '\{armName}'"
        marm: ast.nodes.get i: clause.matcharm.u64
        (addError
            :st
            nodeid: (nodeId n: marm)
            lineno: (nodeLine n: marm)
            colno: (nodeCol n: marm)
            e: zast.err.typeError
            msg: amsg
        )
    }
}


# checkCaseClause -- type one `case` arm: bind what the arm narrows to, walk
# its body, and report what the arm contributes to the match -- whether it is
# empty and whether it diverges. Its arm name and value type are appended to
# the match's running lists.
checkCaseClause: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    clause: caseclauseref
    subjT: ztypes.tid
    isSum: bool
    targetName: StringView
    neverId: u64
    covered: (List String)
    diverging: (List String)
    armTypes: (ListVal u64)
} out casearmfacts is {
    anyEmpty: false
    allDiverge: true
    armName: atomName :ast n: (ast.nodes.get i: clause.matcharm.u64)
    armId: atomNameId :ast n: (ast.nodes.get i: clause.matcharm.u64)
    if (isEmptyBody n: (ast.nodes.get i: clause.statement.u64)) then anyEmpty = true
    # A value-match literal arm wears the subject's concrete type.
    if (isSum) == false then {
        if (isNumericLiteralName name: armName.stringView) when subjT > 0 then {
            if (isLiteralTypeId :st tid: subjT) == false then {
                amid: clause.matcharm
                if amid > 0 then {
                    seta: subjT
                    stampGate :st nid: amid.u64 tid: seta
                }
            }
        }
    }
    asname: "arm:\{armName}"
    armMarker: st.pushBlock name: asname.stringView
    # Every arm of a sum subject must name one of its declared arms.
    armo: (optionval.none u64)
    (forceMemberOf :st frame: st.curFrame :ast parentTypeId: subjT nameId: armId)
    if subjT > 0 then armo = st.typing.declChildOfId parentTypeId: subjT nameId: armId
    if isSum when subjT > 0 then {
    if isSum when subjT > 0 then {
        (checkSumArmName
            :st
            :ast
            :clause
            :subjT
            armName: armName.stringView
            armTid: (optU64Or o: armo d: 0)
        )
    }
    }
    if targetName.length > 0 when subjT > 0 then {
        (narrowCaseArmSubject
            :st
            :ast
            :targetName
            armName: armName.stringView
            armTid: (optU64Or o: armo d: 0)
            :subjT
        )
    }
    checkStatement :st :unitDecl :ast blockId: clause.statement
    at: lastStmtType :st :ast block: (ast.nodes.get i: clause.statement.u64)
    atc: at
    armTypes.append atc
    if at > 0 when at == neverId then {
        dn: armName.copy
        diverging.append dn
    } else {
        allDiverge = false
    }
    cn2: armName.copy
    covered.append cn2
    if st.isUnreachable then st.discardTakenInCurrentScope
    st.popTo marker: armMarker
    return (casearmfacts empty: anyEmpty diverges: allDiverge)
}
# caseIsExhaustive -- whether an else-less match covers every arm its subject
# can still hold, reporting the missing ones when it does not. Narrowing and
# construction both shrink that set, so the answer is about what the subject
# can reach here, not about the type's full arm list.
caseIsExhaustive: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    casenode: caseref
    subjT: ztypes.tid
    isSum: bool
    targetName: StringView
    covered: (List String).view
} out bool is {
    exhaustive: false
    if isSum then {
        arms2: sumSubtypeNames :ast :st sid: subjT
        # ambient narrowing relaxes the requirement: a subject already
        # narrowed to a single arm needs only that arm's case; arms the
        # enclosing flow has excluded are impossible and need none.
        required: (List String)
        nsn: String
        if targetName.length > 0 then {
            gsn: (st.narrowedArmOf
                nameId: (nameIdOf :ast name: targetName)
                fullTypeId: subjT
            )
            if (gsn.isZero) == false then {
                nsn = zast.poolTextCopy pool: ast.names ref: gsn
            }
        }
        if nsn.length > 0 then {
            nreq: nsn.copy
            required.append nreq
        } else {
            excl: (IdSet zast.nameid)
            if targetName.length > 0 then {
                (st.collectExcluded
                    nameId: (nameIdOf :ast name: targetName)
                    into: excl
                )
            }
            with a0it: arms2.iterate do for an0: a0it loop {
                anId: nameIdOf :ast name: an0.stringView
                if (excl.has item: anId) == false then required.append an0.copy
            }
        }
        allCovered: true
        missing: (List String)
        a2iter: required.iterate
        for an3: a2iter loop {
            found: false
            c2iter: covered.iterate
            for cn3: c2iter loop {
                if an3.stringView == cn3.stringView then found = true
            }
            if (found) == false then {
                allCovered = false
                missing.append an3.copy
            }
        }
        exhaustive = allCovered
        if (allCovered) == false then {
            mj: String
            mfirst: true
            with mit: missing.iterate do for mn: mit loop {
                if (mfirst) == false then mj.append ", "
                mj.append mn
                mfirst = false
            }
            (addErrorH
                :st
                nodeid: casenode.nid
                lineno: casenode.lineno
                colno: casenode.colno
                e: zast.err.nonExhaustive
                msg: "non-exhaustive match: missing case(s) \{mj} -- add them or an `else` clause"
                note: "".string
                hint: "".string
                width: 5
            )
        }
    }
    return exhaustive
}
# caseResultTid -- the value a match produces: `never` when every arm diverges,
# nothing when an arm is empty, else the first completing arm's type. A match
# that is not exhaustive produces no value at all.
caseResultTid: function {
    st: zenv.ZSymbolTable
    casenode: caseref
    exhaustive: bool
    allDiverge: bool
    anyEmpty: bool
    neverId: u64
    nullId: u64
    armTypes: (ListVal u64).view
} out ztypes.tid is {
    if exhaustive when allDiverge when neverId > 0 then {
        if casenode.nclauses > 0 then {
            setn2: neverId
            stampGate :st nid: casenode.nid.u64 tid: (ztypes.tid.create from: setn2.u64)
            return (ztypes.tid.create from: neverId)
        } else {
            return (ztypes.tid.create from: 0)
        }
    }
    if exhaustive when anyEmpty then {
        # an empty (`{}` / null) arm body makes the match valueless: stamp
        # null so consuming the match as a value is rejected.
        if nullId > 0 then {
            nullStampId: nullId
            stampGate :st nid: casenode.nid.u64 tid: (ztypes.tid.create from: nullStampId.u64)
            return (ztypes.tid.create from: nullId)
        }
        return (ztypes.tid.create from: 0)
    }
    if exhaustive then {
        # the first completing (non-diverging) arm's type is the match value;
        # an untyped completing arm leaves the match unstamped.
        ti: u64
        tn4: armTypes.length
        for ti < tn4 loop {
            at2: armTypes.get i: ti
            if at2 != neverId then {
                if at2 > 0 then {
                    setc3: at2
                    stampGate :st nid: casenode.nid.u64 tid: (ztypes.tid.create from: setc3.u64)
                    return (ztypes.tid.create from: at2)
                } else {
                    return (ztypes.tid.create from: 0)
                }
            }
            ti = ti + 1
        }
        return (ztypes.tid.create from: 0)
    } else {
        return (ztypes.tid.create from: 0)
    }
    return (ztypes.tid.create from: 0)
}
# applyCaseExclusions -- after an else-less match, the subject can no longer
# hold any arm the match covered: record those exclusions so the rest of the
# scope narrows on them.
applyCaseExclusions: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    targetName: StringView
    subjT: ztypes.tid
    diverging: (List String).view
    casenode: caseref
} is {
    with diter: diverging.iterate do for dn2: diter loop {
        (st.exclude
            nameId: (nameIdOf :ast name: targetName)
            subtypeName: (nameIdOf :ast name: dn2.stringView)
            fullTypeId: subjT
        )
    }
    if diverging.length > 0 then {
        (shadowCollapseIfSingle
            :ast
            :st
            name: (nameIdOf :ast name: targetName)
            fullTid: subjT
        )
        (postGuardRecord
            :st
            stmtNid: casenode.nid
            subject: (nameIdOf :ast name: targetName)
            fullTid: subjT
        )
    }
}
# checkCaseElse -- walk a match's `else` arm. It narrows the subject to what no
# earlier arm covered, and contributes the same two facts every arm does:
# whether it is empty and whether it diverges.
checkCaseElse: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    casenode: caseref
    subjT: ztypes.tid
    targetName: StringView
    neverId: u64
    covered: (List String)
    armTypes: (ListVal u64)
} out casearmfacts is {
    anyEmpty: false
    allDiverge: true
    if (isEmptyBody n: (ast.nodes.get i: casenode.elseclause.u64)) then anyEmpty = true
    elseMarker: st.pushBlock name: "arm:else"
    if targetName.length > 0 when subjT > 0 then {
        with eiter: covered.iterate do for en2: eiter loop {
            (st.exclude
                nameId: (nameIdOf :ast name: targetName)
                subtypeName: (nameIdOf :ast name: en2.stringView)
                fullTypeId: subjT
            )
        }
        (shadowCollapseIfSingle
            :ast
            :st
            name: (nameIdOf :ast name: targetName)
            fullTid: subjT
        )
    }
    walkBodyAt :st :unitDecl :ast bodyId: casenode.elseclause
    ecr: ast.nodes.get i: casenode.elseclause.u64
    et: lastStmtType :st :ast block: ecr
    armTypes.append et
    # the else is an arm: it decides `allDiverge` like any other. Leaving it
    # out stamped `never` on a match whose else completes -- and `never` is
    # read downstream as "control does not continue", so the emitter dropped
    # the enclosing arm's `break` and the switch fell through.
    if et > 0 when et == neverId then null else allDiverge = false
    if st.isUnreachable then st.discardTakenInCurrentScope
    st.popTo marker: elseMarker
    return (casearmfacts empty: anyEmpty diverges: allDiverge)
}
# walkCaseClauses -- walk every `case` arm of a match, accumulating the arm
# names, their value types, and the two facts the match needs back: whether any
# arm was empty and whether they all diverge.
walkCaseClauses: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    casenode: caseref
    subjT: ztypes.tid
    isSum: bool
    targetName: StringView
    neverId: u64
    covered: (List String)
    diverging: (List String)
    armTypes: (ListVal u64)
} out casearmfacts is {
    anyEmpty: false
    allDiverge: true
    kC: u64
    for kC < casenode.nclauses loop {
        clauseId: zast.caseClauseAt :ast nid: casenode.nid i: kC
        kC = kC + 1
        clause: caseClauseRefAt :ast nid: clauseId
        if (clause.nid.isZero) == false then {
            cf: (checkCaseClause
                :st
                :unitDecl
                :ast
                :clause
                :subjT
                :isSum
                :targetName
                :neverId
                :covered
                :diverging
                :armTypes
            )
            if cf.empty then anyEmpty = true
            if (cf.diverges) == false then allDiverge = false
        }
    }
    return (casearmfacts empty: anyEmpty diverges: allDiverge)
}
# finishCaseMatch -- close a match once its arms are walked: pop the match
# scope, decide exhaustiveness, record what the subject can no longer hold,
# and answer the match's own value type.
finishCaseMatch: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    casenode: caseref
    subjT: ztypes.tid
    isSum: bool
    targetName: StringView
    hasElse: bool
    allDiverge: bool
    anyEmpty: bool
    neverId: u64
    nullId: u64
    matchMarker: u64
    covered: (List String).view
    diverging: (List String).view
    armTypes: (ListVal u64).view
} out ztypes.tid is {
    st.popTo marker: matchMarker
    exhaustive: hasElse
    if (exhaustive) == false then {
        exhaustive = (caseIsExhaustive
            :st
            :ast
            :casenode
            :subjT
            :isSum
            :targetName
            :covered
        )
    }
    if targetName.length > 0 when subjT > 0 then {
        (applyCaseExclusions
            :st
            :ast
            :targetName
            :subjT
            :diverging
            :casenode
        )
    }
    return (caseResultTid
        :st
        :casenode
        :exhaustive
        :allDiverge
        :anyEmpty
        :neverId
        :nullId
        :armTypes
    )
}

# checkCaseArms -- walk a match's arms once its subject is typed: each clause,
# the else, then exhaustiveness and the narrowing the match leaves behind.
# Answers the match's own value type -- the first completing arm's.
checkCaseArms: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    casenode: caseref
    subjT: ztypes.tid
    isSum: bool
    matchMarker: u64
} out ztypes.tid is {
    drainPendingBorrow :st
    targetName: String
    if isSum then {
        tn: subjectAtomName :ast n: (ast.nodes.get i: casenode.subject.u64)
        targetName = tn
    }
    neverId: u64
    nvOpt: walkLookupTyperef :st frame: st.curFrame :ast :unitDecl base: "never"
    match (
        nvOpt
    ) case some then {
        neverId = nvOpt
    } case none then null
    nullId: (optU64Or
        o: (walkLookupTyperef :st frame: st.curFrame :ast :unitDecl base: "null")
        d: 0
    )
    anyEmpty: false
    st.pushBlock name: "match_body"
    if targetName.length > 0 then st.resetNarrowing nameId: (nameIdOf
        :ast
        name: targetName.stringView
    )
    covered: (List String)
    diverging: (List String)
    armTypes: (ListVal u64)
    allDiverge: true
    cf0: (walkCaseClauses
        :st
        :unitDecl
        :ast
        :casenode
        :subjT
        :isSum
        targetName: targetName.stringView
        :neverId
        :covered
        :diverging
        :armTypes
    )
    if cf0.empty then anyEmpty = true
    if (cf0.diverges) == false then allDiverge = false
    hasElse: casenode.elseclause > 0
    if hasElse then {
        ef: (checkCaseElse
            :st
            :unitDecl
            :ast
            :casenode
            :subjT
            targetName: targetName.stringView
            :neverId
            :covered
            :armTypes
        )
        if ef.empty then anyEmpty = true
        if (ef.diverges) == false then allDiverge = false
    }
    return (finishCaseMatch
        :st
        :ast
        :casenode
        :subjT
        :isSum
        targetName: targetName.stringView
        :hasElse
        :allDiverge
        :anyEmpty
        :neverId
        :nullId
        :matchMarker
        :covered
        :diverging
        :armTypes
    )
}
# rejectGenericValueMatch -- report a match over a VALUE whose type is a generic
# parameter, and say whether it was rejected. `match t` dissects the type
# parameter at monomorphisation; a value of that type has no per-instance arm
# dispatch (the template body is shared), so it is rejected rather than
# silently taking the else path.
rejectGenericValueMatch: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    casenode: caseref
    subjT: ztypes.tid
} out bool is {
    # `match t` dissects the TYPE parameter at monomorphisation. A match
    # over a VALUE whose type is the generic parameter has no per-
    # instance arm dispatch (the template body is shared), so it is
    # rejected rather than silently taking the else path.
    gvid: innermostNodeId :ast n: (ast.nodes.get i: casenode.subject.u64)
    gvav: st.typing.atomVariableId.get key: gvid.u64
    match (
        gvav
    ) case some then {
        gvav
        gsub0: ast.nodes.get i: casenode.subject.u64
        gtn0: st.reg.nameOf tid: subjT
        gtnc0: gtn0
        gm: "cannot match over a value of generic parameter type '\{gtnc0}'"
        gh: "dissect the type parameter itself (`match \{gtnc0}`), or move the value dispatch outside the generic"
        gn: String
        (addErrorH
            :st
            nodeid: (nodeId n: gsub0)
            lineno: (nodeLine n: gsub0)
            colno: (nodeCol n: gsub0)
            e: zast.err.typeError
            msg: gm
            note: gn
            hint: gh
            width: 0
        )
        return true
    } case none then null
    return false
}
# monoDissectionHandled -- on a per-mono instance walk, a subject that is a bare
# TYPE name is a compile-time dissection: template-time checking validated it
# and the emitter dispatches one arm per mono, so there is nothing to stamp.
# True when the match was handled that way and needs no further walk.
monoDissectionHandled: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    casenode: caseref
    matchMarker: u64
} out bool is {
    dsn: subjectAtomName :ast n: (ast.nodes.get i: casenode.subject.u64)
    if dsn.length > 0 then {
        dsv: st.lookupVarId nameId: (nameIdOf :ast name: dsn.stringView)
        match (
            dsv
        ) case some then null case none then {
            st.popTo marker: matchMarker
            return true
        }
    }
    return false
}


checkCase: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    casenode: caseref
} out ztypes.tid is {
    foldCaseArm :st :ast :unitDecl n: casenode
    constFailClear :st
    matchMarker: st.pushBlock name: "match"
    subjT: checkValueAt :st :unitDecl :ast nid: casenode.subject
    if subjT.isZero then subjT = (caseGenericSubjectTid :st :unitDecl :ast :casenode)
    # per-mono instance walk: a subject that is a bare TYPE name (resolved
    # by the instance's scope define, not a value) is a compile-time
    # dissection -- template-time checking validated it and the emitter
    # dispatches one arm per mono; there is nothing to stamp here
    if st.typing.curMonoStamp > 0 when subjT > 0 then {
    if st.typing.curMonoStamp > 0 when subjT > 0 then {
        if (monoDissectionHandled :st :ast :casenode :matchMarker) then {
            return (ztypes.tid.create from: 0)
        }
    }
    }
    if subjT > 0 then {
        if (st.reg.typetypeOf typeId: subjT) == ztypes.ztypetype.genericParam then {
            # a genericParam subject IS a compile-time dissection: write the
            # marker stamp directly (stampGate suppresses param stamps in
            # template walks, and the per-mono slot must carry the param,
            # not its substitution, for the emitter's dispatch gate)
            gmn: nodeId n: (ast.nodes.get i: casenode.subject.u64)
            if gmn > 0 then {
                gmv: subjT
                ztyping.nodeTypeSet tbl: st.typing.nodeType nid: gmn.u64 tid: gmv
                if st.typing.curMonoStamp > 0 then {
                    gmk8: (ztyping.monostamp mono: st.typing.curMonoStamp node: gmn.u64)
                    st.typing.monoNodeType.set key: gmk8 value: gmv
                }
            }
        }
    }
    isSum: false
    if subjT > 0 then {
        stt: st.reg.typetypeOf typeId: subjT
        if stt == ztypes.ztypetype.unionType then isSum = true
        if stt == ztypes.ztypetype.variantType then isSum = true
    }
    isGenericSubj: false
    if subjT > 0 then {
        if (st.reg.typetypeOf typeId: subjT) == ztypes.ztypetype.genericParam then isGenericSubj = true
    }
    if isGenericSubj then {
        if (rejectGenericValueMatch :st :ast :casenode :subjT) then {
            return (ztypes.tid.create from: 0)
        }
    }
    # A match dissects a union/variant into its arms (a runtime discriminator
    # test) or a generic parameter into its resolutions (at monomorphisation).
    # Any other subject -- a numeric, string, class, record, or a constant --
    # has no child arms to dissect into.
    if subjT > 0 when (isSum) == false when (isGenericSubj) == false then {
        subjNode: ast.nodes.get i: casenode.subject.u64
        subjTn0: st.reg.nameOf tid: subjT
        smsg: "match subject must be a union, variant, or generic parameter, got '\{subjTn0}'"
        (addError
            :st
            nodeid: (nodeId n: subjNode)
            lineno: (nodeLine n: subjNode)
            colno: (nodeCol n: subjNode)
            e: zast.err.typeError
            msg: smsg
        )
    }
    return (checkCaseArms :st :unitDecl :ast :casenode :subjT :isSum :matchMarker)
}

# rowarm -- which arm a value or statement row holds: the dispatch tag that
# checkValueAt and checkStmtInner read without keeping the row view.
rowarm: variant {
    call: null
    binop: null
    atomid: null
    atomstring: null
    dottedpath: null
    caseexpr: null
    ifexpr: null
    forexpr: null
    labelvalue: null
    yieldexpr: null
    doexpr: null
    withexpr: null
    reassignment: null
    swapstmt: null
    expression: null
    assignment: null
    stringchunk: null
    functiondef: null
    objectdef: null
    datablock: null
    unitdef: null
    other: null
}

# rowArmAt -- the arm tag of row `nid`; the row view is this frame's and
# dies here.
rowArmAt: function {ast: Ast.view nid: zast.nodeid} out rowarm is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case call then {
        return rowarm.call
    } case binop then {
        return rowarm.binop
    } case atomid then {
        return rowarm.atomid
    } case atomstring then {
        return rowarm.atomstring
    } case dottedpath then {
        return rowarm.dottedpath
    } case caseexpr then {
        return rowarm.caseexpr
    } case ifexpr then {
        return rowarm.ifexpr
    } case forexpr then {
        return rowarm.forexpr
    } case labelvalue then {
        return rowarm.labelvalue
    } case yieldexpr then {
        return rowarm.yieldexpr
    } case doexpr then {
        return rowarm.doexpr
    } case withexpr then {
        return rowarm.withexpr
    } case reassignment then {
        return rowarm.reassignment
    } case swapstmt then {
        return rowarm.swapstmt
    } case expression then {
        return rowarm.expression
    } case assignment then {
        return rowarm.assignment
    } case stringchunk then {
        return rowarm.stringchunk
    } case functiondef then {
        return rowarm.functiondef
    } case objectdef then {
        return rowarm.objectdef
    } case datablock then {
        return rowarm.datablock
    } case unitdef then {
        return rowarm.unitdef
    } else {
        return rowarm.other
    }
}

# swapref -- what the swap walk reads of its row: the operand ids and the
# position, as plain values.
swapref: record {
    nid: zast.nodeid
    lhs: zast.nodeid
    rhs: zast.nodeid
    lineno: u32
    colno: u32
}

# swapRefAt -- the swap row `nid` as plain values (all zero for any other arm).
swapRefAt: function {ast: Ast.view nid: zast.nodeid} out swapref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case swapstmt then {
        return (swapref :nid lhs: n.lhs rhs: n.rhs lineno: n.lineno colno: n.colno)
    } else null
    zn: zast.nodeid
    return (swapref nid: zn lhs: zn rhs: zn lineno: 0 colno: 0)
}

# withref -- what the with walk reads of its row: the bound name, the value
# and body ids and the position, as plain values.
withref: record {
    nid: zast.nodeid
    name: zast.nameid
    value: zast.nodeid
    body: zast.nodeid
    lineno: u32
    colno: u32
}

# withRefAt -- the with row `nid` as plain values (all zero for any other arm).
withRefAt: function {ast: Ast.view nid: zast.nodeid} out withref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case withexpr then {
        return (withref
            :nid
            name: n.name
            value: n.value
            body: n.body
            lineno: n.lineno
            colno: n.colno
        )
    } else null
    zn: zast.nodeid
    zm: zast.nameid
    return (withref nid: zn name: zm value: zn body: zn lineno: 0 colno: 0)
}

# doref -- what the do walk reads of its row: the statement id and the
# position, as plain values.
doref: record {
    nid: zast.nodeid
    statement: zast.nodeid
    lineno: u32
    colno: u32
}

# doRefAt -- the do row `nid` as plain values (all zero for any other arm).
doRefAt: function {ast: Ast.view nid: zast.nodeid} out doref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case doexpr then {
        return (doref :nid statement: n.statement lineno: n.lineno colno: n.colno)
    } else null
    zn: zast.nodeid
    return (doref nid: zn statement: zn lineno: 0 colno: 0)
}

# argref -- what an argument or member walk reads of a namedoperation row:
# the label, the operation id and the position, as plain values.
argref: record {
    nid: zast.nodeid
    name: zast.nameid
    operation: zast.nodeid
    lineno: u32
    colno: u32
}

# argRefAt -- the namedoperation row `nid` as plain values (all zero for any
# other arm).
argRefAt: function {ast: Ast.view nid: zast.nodeid} out argref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case namedoperation then {
        return (argref :nid name: n.name operation: n.operation lineno: n.lineno colno: n.colno)
    } else null
    zn: zast.nodeid
    zm: zast.nameid
    return (argref nid: zn name: zm operation: zn lineno: 0 colno: 0)
}

# reasgref -- what the reassignment walk reads of its row: the target and
# value ids and the position, as plain values.
reasgref: record {
    nid: zast.nodeid
    topath: zast.nodeid
    value: zast.nodeid
    lineno: u32
    colno: u32
}

# reasgRefAt -- the reassignment row `nid` as plain values (all zero for any
# other arm).
reasgRefAt: function {ast: Ast.view nid: zast.nodeid} out reasgref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case reassignment then {
        return (reasgref :nid topath: n.topath value: n.value lineno: n.lineno colno: n.colno)
    } else null
    zn: zast.nodeid
    return (reasgref nid: zn topath: zn value: zn lineno: 0 colno: 0)
}

# reportUnknownNameAt -- `name` is an unknown reference at row `nid`: the
# report the binding, statement and reassignment sites share.
reportUnknownNameAt: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    nid: zast.nodeid
    name: String
} is {
    vn: ast.nodes.get i: nid.u64
    um: "Unknown reference '\{name}'"
    en: String
    eh: String
    (addErrorH
        :st
        nodeid: nid
        lineno: (nodeLine n: vn)
        colno: (nodeCol n: vn)
        e: zast.err.badReference
        msg: um
        note: en
        hint: eh
        width: name.length.u32.orPanic
    )
}

# exprref -- what a walk reads of an expression wrapper row: the wrapped
# value id and the position, as plain values.
exprref: record {
    nid: zast.nodeid
    expression: zast.nodeid
    lineno: u32
    colno: u32
}

# exprRefAt -- the expression row `nid` as plain values (all zero for any
# other arm).
exprRefAt: function {ast: Ast.view nid: zast.nodeid} out exprref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case expression then {
        return (exprref :nid expression: n.expression lineno: n.lineno colno: n.colno)
    } else null
    zn: zast.nodeid
    return (exprref nid: zn expression: zn lineno: 0 colno: 0)
}

# asgnref -- what the binding walk reads of its row: the bound name, the
# value id and the position, as plain values.
asgnref: record {
    nid: zast.nodeid
    name: zast.nameid
    value: zast.nodeid
    lineno: u32
    colno: u32
}

# asgnRefAt -- the assignment row `nid` as plain values (all zero for any
# other arm).
asgnRefAt: function {ast: Ast.view nid: zast.nodeid} out asgnref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case assignment then {
        return (asgnref :nid name: n.name value: n.value lineno: n.lineno colno: n.colno)
    } else null
    zn: zast.nodeid
    zm: zast.nameid
    return (asgnref nid: zn name: zm value: zn lineno: 0 colno: 0)
}

# ifclauseref -- what the if-clause walk reads of its row: the condition
# count, the statement id and the position, as plain values.
ifclauseref: record {
    nid: zast.nodeid
    nconds: u64
    statement: zast.nodeid
    lineno: u32
    colno: u32
}

# ifClauseRefAt -- the if-clause row `nid` as plain values (all zero for any
# other arm).
ifClauseRefAt: function {ast: Ast.view nid: zast.nodeid} out ifclauseref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case ifclause then {
        return (ifclauseref
            :nid
            nconds: n.conditions.length
            statement: n.statement
            lineno: n.lineno
            colno: n.colno
        )
    } else null
    zn: zast.nodeid
    return (ifclauseref nid: zn nconds: 0 statement: zn lineno: 0 colno: 0)
}

# caseclauseref -- what the match-arm walk reads of its row: the binding
# name, the matched arm id, the statement id and the position.
caseclauseref: record {
    nid: zast.nodeid
    name: zast.nameid
    matcharm: zast.nodeid
    statement: zast.nodeid
    lineno: u32
    colno: u32
}

# caseClauseRefAt -- the match-arm row `nid` as plain values (all zero for
# any other arm).
caseClauseRefAt: function {ast: Ast.view nid: zast.nodeid} out caseclauseref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case caseclause then {
        return (caseclauseref
            :nid
            name: n.name
            matcharm: n.matcharm
            statement: n.statement
            lineno: n.lineno
            colno: n.colno
        )
    } else null
    zn: zast.nodeid
    zm: zast.nameid
    return (caseclauseref nid: zn name: zm matcharm: zn statement: zn lineno: 0 colno: 0)
}

# binref -- what the binary-operator walk reads of its row: the operand and
# operator ids and the position, as plain values.
binref: record {
    nid: zast.nodeid
    lhs: zast.nodeid
    operator: zast.nodeid
    rhs: zast.nodeid
    lineno: u32
    colno: u32
}

# binRefAt -- the binop row `nid` as plain values (all zero for any other arm).
binRefAt: function {ast: Ast.view nid: zast.nodeid} out binref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case binop then {
        return (binref
            :nid
            lhs: n.lhs
            operator: n.operator
            rhs: n.rhs
            lineno: n.lineno
            colno: n.colno
        )
    } else null
    zn: zast.nodeid
    return (binref nid: zn lhs: zn operator: zn rhs: zn lineno: 0 colno: 0)
}

# atomref -- what the bare-name walk reads of its row: the name id and the
# position, as plain values.
atomref: record {
    nid: zast.nodeid
    name: zast.nameid
    lineno: u32
    colno: u32
}

# atomRefAt -- the atomid row `nid` as plain values (all zero for any other
# arm).
atomRefAt: function {ast: Ast.view nid: zast.nodeid} out atomref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case atomid then {
        return (atomref :nid name: n.name lineno: n.lineno colno: n.colno)
    } else null
    zn: zast.nodeid
    zm: zast.nameid
    return (atomref nid: zn name: zm lineno: 0 colno: 0)
}

# strref -- what the string-literal walk reads of its row: the part count and
# the position, as plain values.
strref: record {
    nid: zast.nodeid
    nparts: u64
    lineno: u32
    colno: u32
}

# strRefAt -- the atomstring row `nid` as plain values (all zero for any other
# arm).
strRefAt: function {ast: Ast.view nid: zast.nodeid} out strref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case atomstring then {
        return (strref :nid nparts: n.stringparts.length lineno: n.lineno colno: n.colno)
    } else null
    zn: zast.nodeid
    return (strref nid: zn nparts: 0 lineno: 0 colno: 0)
}

# dpref -- what the dotted-path walk reads of its row: the parent and child
# ids and the position, as plain values.
dpref: record {
    nid: zast.nodeid
    parent: zast.nodeid
    child: zast.nodeid
    lineno: u32
    colno: u32
}

# dpRefOf -- the dotted-path row `dp` as plain values.
dpRefOf: function {dp: zast.DottedPathData.view} out dpref is {
    return (dpref
        nid: dp.nodeid
        parent: dp.parent
        child: dp.child
        lineno: dp.lineno
        colno: dp.colno
    )
}

# dpRefAt -- the dotted-path row `nid` as plain values (all zero for any other
# arm).
dpRefAt: function {ast: Ast.view nid: zast.nodeid} out dpref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case dottedpath then {
        return (dpRefOf dp: n)
    } else null
    zn: zast.nodeid
    return (dpref nid: zn parent: zn child: zn lineno: 0 colno: 0)
}

# callref -- what the call walk reads of its row: the callable id, the
# argument count and the position, as plain values. The arguments are read
# by index through zast.callArgAt.
callref: record {
    nid: zast.nodeid
    callable: zast.nodeid
    nargs: u64
    lineno: u32
    colno: u32
}

# callRefOf -- the call row `call` as plain values.
callRefOf: function {call: zast.CallData.view} out callref is {
    return (callref
        nid: call.nodeid
        callable: call.callable
        nargs: call.arguments.length
        lineno: call.lineno
        colno: call.colno
    )
}

# callRefAt -- the call row `nid` as plain values (all zero for any other arm).
callRefAt: function {ast: Ast.view nid: zast.nodeid} out callref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case call then {
        return (callRefOf call: n)
    } else null
    zn: zast.nodeid
    return (callref nid: zn callable: zn nargs: 0 lineno: 0 colno: 0)
}

# fnref -- what a function walk reads of its definition row: the return-type
# id, the parameter count, the body id, the native flag and the position, as
# plain values. Parameters are read by index through zast.fnParamAt.
fnref: record {
    nid: zast.nodeid
    returntype: zast.nodeid
    nparams: u64
    body: zast.nodeid
    isNative: bool
    lineno: u32
    colno: u32
}

# fnRefOf -- the function row `fnode` as plain values.
fnRefOf: function {fnode: zast.FunctionData.view} out fnref is {
    return (fnref
        nid: fnode.nodeid
        returntype: fnode.returntype
        nparams: fnode.parameters.length
        body: fnode.body
        isNative: fnode.isNative
        lineno: fnode.lineno
        colno: fnode.colno
    )
}

# fnRefAt -- the function row `nid` as plain values (all zero for any other
# arm).
fnRefAt: function {ast: Ast.view nid: zast.nodeid} out fnref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case functiondef then {
        return (fnRefOf fnode: n)
    } else null
    zn: zast.nodeid
    return (fnref
        nid: zn
        returntype: zn
        nparams: 0
        body: zn
        isNative: false
        lineno: 0
        colno: 0
    )
}

# objref -- what a definition walk reads of an object-definition row: the
# kind, the is/as item counts, the native flag and the position, as plain
# values. Items are read by index through zast.objIsItemAt / objAsItemAt.
objref: record {
    nid: zast.nodeid
    kind: zast.objectkind
    nis: u64
    nas: u64
    isNative: bool
    lineno: u32
    colno: u32
}

# objRefOf -- the object-definition row `o` as plain values.
objRefOf: function {o: zast.ObjectDefData.view} out objref is {
    return (objref
        nid: o.nodeid
        kind: o.kind
        nis: o.isItems.length
        nas: o.asItems.length
        isNative: o.isNative
        lineno: o.lineno
        colno: o.colno
    )
}

# objRefAt -- the object-definition row `nid` as plain values (all zero for
# any other arm).
objRefAt: function {ast: Ast.view nid: zast.nodeid} out objref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case objectdef then {
        return (objRefOf o: n)
    } else null
    zn: zast.nodeid
    return (objref
        nid: zn
        kind: zast.objectkind.recordDef
        nis: 0
        nas: 0
        isNative: false
        lineno: 0
        colno: 0
    )
}

# caseref -- what the match walk reads of its row: the subject id, the clause
# count, the else id and the position, as plain values. Clauses are read by
# index through zast.caseClauseAt.
caseref: record {
    nid: zast.nodeid
    subject: zast.nodeid
    nclauses: u64
    elseclause: zast.nodeid
    lineno: u32
    colno: u32
}

# caseRefAt -- the match row `nid` as plain values (all zero for any other arm).
caseRefAt: function {ast: Ast.view nid: zast.nodeid} out caseref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case caseexpr then {
        return (caseref
            :nid
            subject: n.subject
            nclauses: n.clauses.length
            elseclause: n.elseclause
            lineno: n.lineno
            colno: n.colno
        )
    } else null
    zn: zast.nodeid
    return (caseref nid: zn subject: zn nclauses: 0 elseclause: zn lineno: 0 colno: 0)
}

# ifref -- what the if walk reads of its row: the clause count, the else id
# and the position, as plain values. Clauses are read by index through
# zast.ifClauseAt.
ifref: record {
    nid: zast.nodeid
    nclauses: u64
    elseclause: zast.nodeid
    lineno: u32
    colno: u32
}

# ifRefAt -- the if row `nid` as plain values (all zero for any other arm).
ifRefAt: function {ast: Ast.view nid: zast.nodeid} out ifref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case ifexpr then {
        return (ifref
            :nid
            nclauses: n.clauses.length
            elseclause: n.elseclause
            lineno: n.lineno
            colno: n.colno
        )
    } else null
    zn: zast.nodeid
    return (ifref nid: zn nclauses: 0 elseclause: zn lineno: 0 colno: 0)
}

# forref -- what the for walk reads of its row: the condition and
# postcondition counts, the body id and the position, as plain values.
# Conditions and postconditions are read by index through zast.forCondAt /
# forPostAt.
forref: record {
    nid: zast.nodeid
    nconds: u64
    body: zast.nodeid
    nposts: u64
    lineno: u32
    colno: u32
}

# forRefAt -- the for row `nid` as plain values (all zero for any other arm).
forRefAt: function {ast: Ast.view nid: zast.nodeid} out forref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case forexpr then {
        return (forref
            :nid
            nconds: n.conditions.length
            body: n.body
            nposts: n.postconditions.length
            lineno: n.lineno
            colno: n.colno
        )
    } else null
    zn: zast.nodeid
    return (forref nid: zn nconds: 0 body: zn nposts: 0 lineno: 0 colno: 0)
}

# labelRefAt -- the labelvalue row `nid` as plain values: the same shape as an
# atom (name id and position), all zero for any other arm.
labelRefAt: function {ast: Ast.view nid: zast.nodeid} out atomref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case labelvalue then {
        return (atomref :nid name: n.name lineno: n.lineno colno: n.colno)
    } else null
    zn: zast.nodeid
    zm: zast.nameid
    return (atomref nid: zn name: zm lineno: 0 colno: 0)
}

# yieldref -- what the yield walk reads of its row: the yielded value id and
# the position, as plain values.
yieldref: record {
    nid: zast.nodeid
    expr: zast.nodeid
    lineno: u32
    colno: u32
}

# yieldRefAt -- the yield row `nid` as plain values (all zero for any other arm).
yieldRefAt: function {ast: Ast.view nid: zast.nodeid} out yieldref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case yieldexpr then {
        return (yieldref :nid expr: n.expr lineno: n.lineno colno: n.colno)
    } else null
    zn: zast.nodeid
    return (yieldref nid: zn expr: zn lineno: 0 colno: 0)
}

# checkLabelValueAt -- the `:x` shorthand in value position reads the local x
# -- and only a local: it resolves through no other scope, so a miss is
# unresolvable.
checkLabelValueAt: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    lv: atomref
} out ztypes.tid is {
    lvo: st.lookup nameId: lv.name
    match (
        lvo
    ) case some then {
        setlv: lvo
        stampGate :st nid: lv.nid.u64 tid: (ztypes.tid.create from: setlv.u64)
        lvv: st.lookupVarId nameId: lv.name
        match (
            lvv
        ) case some then {
            setlvv: lvv
            st.typing.atomVariableId.set key: lv.nid.u64 value: setlvv
        } case none then null
        return (ztypes.tid.create from: lvo)
    } case none then {
        lvNm: zast.nameTextAt :ast ref: lv.name
        lvm: "Unknown reference '\{lvNm}'"
        lvn: String
        lvh: "the ':name' shorthand reads a local named '\{lvNm}'; write the argument in full to pass something else"
        (addErrorH
            :st
            nodeid: lv.nid
            lineno: lv.lineno
            colno: lv.colno
            e: zast.err.badReference
            msg: lvm
            note: lvn
            hint: lvh
            width: lvNm.length.u32.orPanic
        )
        return (ztypes.tid.create from: 0)
    }
}

# checkYieldAt -- a suspension point: the yielded value walks for diagnostics.
# A bidirectional generator's yield carries the resumed value -- the synth
# `.call`'s `value` parameter's type (the node itself stays unstamped; the
# expression wrapper takes the type). A reftype resume value is a borrow into
# the caller's argument: the surrounding binding becomes BORROWED origin value.
checkYieldAt: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    yr: yieldref
} out ztypes.tid is {
    checkValueAt :st :unitDecl :ast nid: yr.expr
    yvn: nameIdOf :ast name: "value"
    yvo: st.lookup nameId: yvn
    match (
        yvo
    ) case some then {
        if (typeIsReftype :st tid: (ztypes.tid.create from: yvo.u64)) then {
            drainPendingBorrow :st
            st.typing.pendingBorrowPath.append yvn
        }
        return (ztypes.tid.create from: yvo)
    } case none then {
        return (ztypes.tid.create from: 0)
    }
}

# dataref -- what the data-block walk reads of its row: the element count,
# the out-type id and the position, as plain values. Elements are read by
# index through zast.dataElemAt.
dataref: record {
    nid: zast.nodeid
    nelems: u64
    outType: zast.nodeid
    lineno: u32
    colno: u32
}

# dataRefAt -- the data-block row `nid` as plain values (all zero for any
# other arm).
dataRefAt: function {ast: Ast.view nid: zast.nodeid} out dataref is {
    n: ast.nodes.get i: nid.u64
    match (
        n
    ) case datablock then {
        return (dataref
            :nid
            nelems: n.elements.length
            outType: n.outType
            lineno: n.lineno
            colno: n.colno
        )
    } else null
    zn: zast.nodeid
    return (dataref nid: zn nelems: 0 outType: zn lineno: 0 colno: 0)
}

# checkValueAt -- type the value row `nid`, then record what it evaluates to.
# The two channels are written in that order because the value channel renders
# through the type one: a node with no type stamp has nothing to render a
# constant AS.
checkValueAt: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    nid: zast.nodeid
} out ztypes.tid is {
    t: checkValueArmAt :st :unitDecl :ast :nid
    stampConstAt :st :unitDecl :ast :nid
    return t
}

# checkValueArmAt -- the arm dispatch: each handler takes its row as plain
# values, so no row view is held across the walk. Returns the resolved type id,
# or 0 when unhandled.
checkValueArmAt: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    nid: zast.nodeid
} out ztypes.tid is {
    arm: rowArmAt :ast :nid
    match (
        arm
    ) case call then {
        cr: callRefAt :ast :nid
        return (checkCall :st :unitDecl :ast call: cr)
    } case dottedpath then {
        dr: dpRefAt :ast :nid
        return (checkDotted :st :unitDecl :ast dp: dr coerce: true)
    } case binop then {
        br: binRefAt :ast :nid
        return (checkBinop :st :unitDecl :ast binop: br)
    } case atomid then {
        ar: atomRefAt :ast :nid
        return (checkAtomid :st :unitDecl :ast node: ar)
    } case atomstring then {
        str: strRefAt :ast :nid
        return (checkString :st :unitDecl :ast node: str)
    } case swapstmt then {
        sr: swapRefAt :ast :nid
        checkSwap :st :unitDecl :ast swapnode: sr
        return (ztypes.tid.create from: 0)
    } case withexpr then {
        wr: withRefAt :ast :nid
        return (checkWith :st :unitDecl :ast withnode: wr)
    } case doexpr then {
        dr: doRefAt :ast :nid
        return (checkDo :st :unitDecl :ast donode: dr)
    } case reassignment then {
        rr: reasgRefAt :ast :nid
        checkReassignment :st :unitDecl :ast rasgn: rr
        return (ztypes.tid.create from: 0)
    } case caseexpr then {
        csr: caseRefAt :ast :nid
        return (checkCase :st :unitDecl :ast casenode: csr)
    } case ifexpr then {
        ifr: ifRefAt :ast :nid
        return (checkIf :st :unitDecl :ast ifnode: ifr)
    } case forexpr then {
        frr: forRefAt :ast :nid
        return (checkFor :st :unitDecl :ast fornode: frr)
    } case labelvalue then {
        lvr: labelRefAt :ast :nid
        return (checkLabelValueAt :st :ast lv: lvr)
    } case yieldexpr then {
        yr: yieldRefAt :ast :nid
        return (checkYieldAt :st :unitDecl :ast :yr)
    } case expression then {
        wrap: exprRefAt :ast :nid
        t: checkValueAt :st :unitDecl :ast nid: wrap.expression
        if t > 0 then stampGate :st nid: wrap.nid.u64 tid: t
        return t
    } else {
        return (ztypes.tid.create from: 0)
    }
}


# checkStmtExpression -- an expression statement line: walk the value, stamp
# the wrapper, and answer whether the line diverges (a return call or a
# control builtin).
checkStmtExpression: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    wrap: exprref
} out bool is {
    errE0: st.typing.errors.length
    # a `.drop` is legal on this node and nowhere else; saved and restored
    # because a statement's expression can contain nested statement blocks
    outerStmt0: st.typing.stmtExprNid
    st.typing.stmtExprNid = wrap.expression.u64
    et0: checkValueAt :st :unitDecl :ast nid: wrap.expression
    st.typing.stmtExprNid = outerStmt0
    if et0 > 0 then stampGate :st nid: wrap.nid.u64 tid: et0
    ckOpt0: st.typing.callKind.get key: wrap.expression.u64
    isR0: isReturnCallKind o: ckOpt0
    bn0: bareAtomNameId :ast n: (ast.nodes.get i: wrap.expression.u64)
    ctl0: false
    if bn0 == zast.names.wkBreak then ctl0 = true
    if bn0 == zast.names.wkContinue then ctl0 = true
    if bn0 == zast.names.wkReturn then ctl0 = true
    if ctl0 then isR0 = true
    # a statement whose value resolved to nothing and raised nothing:
    # an unresolvable root name is an unknown reference (the emitter
    # would otherwise hit its unhandled-callee backstop)
    if st.typing.errors.length == errE0 when ctl0 == false then {
        eto0: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: wrap.nid.u64
        unkn0: true
        if eto0 > 0 then unkn0 = false
        if unkn0 then {
            ubn1: unresolvedBareCallable :ast :st :unitDecl nid: wrap.expression
            if ubn1.length > 0 then reportUnknownNameAt :st :ast nid: wrap.expression name: ubn1
        }
    }
    return isR0
}

# checkStmtInner -- dispatch a statement line's inner row by arm. Answers
# true when the line diverges (a return call or a control builtin).
checkStmtInner: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    innerId: zast.nodeid
} out bool is {
    arm: rowArmAt :ast nid: innerId
    match (
        arm
    ) case expression then {
        wrap: exprRefAt :ast nid: innerId
        return (checkStmtExpression :st :unitDecl :ast :wrap)
    } case assignment then {
        ar: asgnRefAt :ast nid: innerId
        checkAssignment :st :unitDecl :ast asgn: ar
        # a binding whose value failed still binds its name, typeless: the
        # failure is reported once, at the value, and a later read of the name
        # is not a second unknown reference
        if (st.frameBindsHere nameId: ar.name) == false then {
            vh: st.reg.newVariable ztypeId: ztypes.tid ownership: ztypes.zownership.owned
            st.defineVar nameId: ar.name vid: vh
        }
        return false
    } case reassignment then {
        checkValueAt :st :unitDecl :ast nid: innerId
        return false
    } else {
        return false
    }
}

# checkStatement -- walk a function-body statement block, marking the scope
# unreachable after a control-flow terminator (return).
checkStatement: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    blockId: zast.nodeid
} is {
    nLines: zast.stmtLineCount :ast nid: blockId
    k: u64
    for k < nLines loop {
        slnId: zast.stmtLineAt :ast nid: blockId i: k
        k = k + 1
        # the line wrapper carries its inner node's type; the wrapper row is
        # read through a view scoped to this block: the inner walk lends ast
        innerId: zast.nodeid
        {
            sline: ast.nodes.get i: slnId.u64
            match (
                sline
            ) case statementline then {
                innerId = sline.statementline
            } else null
        }
        isRet: false
        if (innerId.isZero) == false then {
            isRet = checkStmtInner :st :unitDecl :ast :innerId
            itOpt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: innerId.u64
            if itOpt > 0 then {
                stampGate :st nid: slnId.u64 tid: (ztypes.tid.create from: itOpt.u64)
            }
        }
        drainPendingBorrow :st
        if isRet then st.markUnreachable
    }
}

# walkBodyAt -- walk a function body by its table id (0 = a spec method, no body).
walkBodyAt: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    bodyId: zast.nodeid
} is {
    if bodyId > 0 then checkStatement :st :unitDecl :ast blockId: bodyId
}

# nodeIsFunctiondef -- kind test that keeps the caller's un-narrowed handle.
nodeIsFunctiondef: function {o: Node.view} out bool is {
    match (
        o
    ) case functiondef then {
        return true
    } else {
        return false
    }
}

# objectdefIsGeneric -- a type definition with a generic as-block parameter;
# generic templates are never body-walked (instances clone at call sites).
objectdefIsGeneric: function {ast: Ast.view o: Node.view} out bool is {
    match (
        o
    ) case objectdef then {
        return (hasGenericParam :ast items: o.asItems)
    } else {
        return false
    }
}

# scanTypeNameOpt -- recurse the method-walk trigger into an optional typeref
# (a function's return type).
scanTypeNameOpt: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    ast: Ast
    oId: zast.nodeid
} is {
    if oId.isZero then return
    # the row is read through a view scoped to this block: the walk below
    # lends ast
    bn: String
    {
        o: ast.nodes.get i: oId.u64
        bn = baseTypeName :ast n: o
    }
    if bn.length > 0 then maybeWalkMethods :st :frame :unitDecl :ast name: bn.stringView

}

# scanFnSig -- recurse the method-walk trigger through a function signature in
# resolution order: the return type first, then parameters in declaration order.
scanFnSig: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    ast: Ast
    opId: zast.nodeid
} is {
    fr: fnRefAt :ast nid: opId
    if fr.nid.isZero then return
    scanTypeNameOpt :st :frame :unitDecl :ast oId: fr.returntype
    kP: u64
    for kP < fr.nparams loop {
        pmId: (zast.fnParamAt :ast nid: fr.nid i: kP).u32
        kP = kP + 1
        pm: argRefAt :ast nid: (zast.nodeid.create from: pmId.u32)
        if (pm.nid.isZero) == false then {
            bn: baseTypeName :ast n: (ast.nodes.get i: pm.operation.u64)
            if bn.length > 0 then (maybeWalkMethods
                :st
                :frame
                :unitDecl
                :ast
                name: bn.stringView
            )
        }
    }
}

# scanMemberSignatures -- replay one definition's signature-resolution order:
# an objectdef resolves its field typerefs, then its is- and as-block method
# signatures; a function resolves its own signature. Each name recurses the
# trigger, so transitively referenced types walk their methods first.
scanMemberSignatures: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    ast: Ast
    opId: zast.nodeid
} is {
    arm: rowArmAt :ast nid: opId
    match (
        arm
    ) case functiondef then {
        scanFnSig :st :frame :unitDecl :ast :opId
    } case objectdef then {
        orf: objRefAt :ast nid: opId
        kF: u64
        for kF < orf.nis loop {
            fmId: (zast.objIsItemAt :ast nid: opId i: kF).u32
            kF = kF + 1
            fm: argRefAt :ast nid: (zast.nodeid.create from: fmId.u32)
            if (fm.nid.isZero) == false then {
                if (nodeIsFunctiondef o: (ast.nodes.get i: fm.operation.u64)) == false then {
                    bn: baseTypeName :ast n: (ast.nodes.get i: fm.operation.u64)
                    if bn.length > 0 then {
                        maybeWalkMethods :st :frame :unitDecl :ast name: bn.stringView
                    }
                }
            }
        }
        kI: u64
        for kI < orf.nis loop {
            imId: (zast.objIsItemAt :ast nid: opId i: kI).u32
            kI = kI + 1
            im: argRefAt :ast nid: (zast.nodeid.create from: imId.u32)
            if (im.nid.isZero) == false then {
                scanFnSig :st :frame :unitDecl :ast opId: im.operation
            }
        }
        kA: u64
        for kA < orf.nas loop {
            amId: (zast.objAsItemAt :ast nid: opId i: kA).u32
            kA = kA + 1
            am: argRefAt :ast nid: (zast.nodeid.create from: amId.u32)
            if (am.nid.isZero) == false then {
                scanFnSig :st :frame :unitDecl :ast opId: am.operation
            }
        }
    } else null
}

# maybeWalkMethods -- the resolution-time method-walk trigger: the first time
# a body walk resolves a main-unit definition's name, scan the signature
# typerefs (recursing per name) at the current scope position, then body-check
# the type's methods. The early mark stops re-entry (a method constructing its
# own type).
maybeWalkMethods: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    ast: Ast
    name: StringView
} is {
    nmId: zast.poolFind pool: ast.names text: name
    maybeWalkMethodsById :st :unitDecl :frame :ast nameId: nmId
}

# maybeWalkMethodsById -- maybeWalkMethods for a name already interned. The
# declaring node comes from the DECL, which is keyed by (unit, name) and
# records the node that declared it, so any unit's definition can be walked
# at the point something demands it.
maybeWalkMethodsById: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    ast: Ast
    nameId: zast.nameid
} is {
    if nameId.isZero then return
    dd: (declOfUnitDefIds
        :st
        :unitDecl
        :nameId
    )
    if dd.isZero then return
    if (st.typing.declIsWalked declId: dd) then return
    # an owned copy of the name: the walk lends ast, and it runs once per
    # definition
    nm: zast.nameTextCopy :ast ref: nameId
    walkDeclaredDef :st :frame :ast :unitDecl name: nm.stringView declId: dd
}

# walkDefinitionById -- walk the definition a RESOLVED ID names, wherever it
# lives. A unit is code layout: a path the parser follows to reach a definition,
# not a property of the walk. So the walk takes the definition -- the id IS the
# definition -- and reads its unit back off it for the one thing that needs one:
# the visibility context of the body being walked, where `un != unitDecl` is
# what makes a reference external. Deriving that from the CALLER instead would
# read a unit's use of its own private definitions as external access.
walkDefinitionById: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tid: ztypes.tid
} is {
    if tid.isZero then return
    dcl: st.typing.declIdOfType typeId: tid
    if dcl.isZero then return
    dnm: u32
    {
        dv: st.typing.decls.get i: dcl.u64
        dnm = dv.name
    }
    if dnm == 0 then return
    unTd: unitDeclOfTid :st :tid
    if unTd.isZero then return
    nt: zast.poolTextAt pool: ast.names ref: (zast.nameid.create from: dnm)
    (walkDeclaredDef
        :st
        frame: st.curFrame
        :ast
        unitDecl: unTd
        name: nt.stringView
        declId: dcl
    )
}

# walkDeclaredDef -- the shared core: mark the definition walked and walk it.
walkDeclaredDef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    name: StringView
    declId: ztypes.declid
} is {
    # the definition is walked in the frame of its own declaration
    rf: frame
    if (declId.isZero) == false then rf = declId
    dd: declId
    if (st.typing.declIsWalked declId: dd) then return
    memId: u32
    inNs: false
    {
        decl: st.typing.decls.get i: dd.u64
        memId = decl.node
        # a definition inside a NAMESPACE reads its own siblings from the
        # namespace's frame: `deep.mul` inside helper resolves against
        # helper first. checkNamespaceBodies walks it in the namespace's
        # frame, so a namespace member is left to that walk.
        pr: decl.parent
        if (pr.isZero) == false then {
            uro: unitDecl
            if (uro.isZero) == false then {
                if (pr == uro) == false then inNs = true
            }
        }
    }
    if memId == 0 then return
    if inNs then return
    # The mark means BODY WALKED, so it is never set for a definition this is
    # not about to walk. Claiming one and declining is what made a free function
    # -- and then a namespace -- vanish: the unit's own walk skipped it as done.
    mopId: zast.nodeid
    {
        mm2: ast.nodes.get i: memId.u64
        if mm2.namedoperation then mopId = mm2.operation
    }
    if mopId.isZero then return
    isFn: false
    if (isFunctionDefWithBody o: (ast.nodes.get i: mopId.u64)) then isFn = true
    canW: isFn
    if (canW) == false then {
        if (objectdefHasMethodBodies
            :ast
            op: (ast.nodes.get i: mopId.u64)
        ) then canW = true
    }
    if (canW) == false then return
    st.typing.declSetWalked declId: dd
    prevMono: st.typing.curMonoStamp
    st.typing.curMonoStamp = 0
    # walkOwnerMethods only ever walked a TYPE's methods; a free function
    # reaching it was marked and declined, and its unit's own free-function walk
    # then skipped it as done -- a body emitted with nothing stamped.
    if isFn then {
        # a demand-time walk is its own scope, and checkFunctionBody SETS the
        # ambient receiver without restoring it: a free function walked from
        # inside a method's body would leave the ambient receiver cleared, and the
        # rest of that method then reads `b.private` as external code. The type
        # branch has bracketed these two since it was the only branch.
        prevL: st.typing.synthLabel.copy
        prevL9U: st.typing.synthOwnerUnit
        prevL9N: st.typing.synthOwnerName
        prevT: st.typing.currentThisTid
        cfbFr: fnRefAt :ast nid: (zast.nodeid.create from: mopId.u32)
        (checkFunctionBody
            :st
            frame: rf
            :unitDecl
            defName: name
            fn: cfbFr
            thisName: ""
            thisTid: ztypes.tid
            :ast
            declId: dd
        )
        st.typing.synthLabel = prevL
        st.typing.synthOwnerUnit = prevL9U
        st.typing.synthOwnerName = prevL9N
        st.typing.currentThisTid = prevT
    } else {
        walkOwnerMethods :st frame: rf :unitDecl :ast :memId :name
    }
    st.typing.curMonoStamp = prevMono
}


# walkOwnerMethods -- check one type member's method bodies (the shared
# core of the demand-time walk and the completion sweep).
walkOwnerMethods: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    ast: Ast
    memId: u32
    name: StringView
} is {
    mem: argRefAt :ast nid: (zast.nodeid.create from: memId.u32)
    if (mem.nid.isZero) == false then {
        # a demand walk of the owner's method bodies is its own scope: a
        # dotted-base suppression live at the TRIGGERING reference must
        # not leak into the walked bodies
        mwSup: st.typing.suppressBareCtor
        st.typing.suppressBareCtor = false
        mwSupFn: st.typing.suppressFnAutoCall
        st.typing.suppressFnAutoCall = false
        # outside-in: the owner type resolves BEFORE anything reads it. A body
        # walked ahead of its owner binds `this` to notype, and every check that
        # hangs off the receiver -- member reads, the declared return type --
        # silently stops asking.
        owTid: (forceUnitDef
            :st
            :frame

            :ast
            :unitDecl
            :memId
        )
        (scanMemberSignatures
            :st
            :frame
            :unitDecl
            :ast
            opId: mem.operation
        )
        canWalk: objectdefHasMethodBodies :ast op: (ast.nodes.get i: mem.operation.u64)
        # an owner that will not resolve is not walked at all: its own
        # resolution reports its own error, while a body walk on notype only
        # cascades that failure into every line of every method.
        if canWalk when owTid == 0 then canWalk = false
        if canWalk then {
            prev: st.typing.synthLabel.copy
            prevU: st.typing.synthOwnerUnit
            prevN: st.typing.synthOwnerName
            prevThis: st.typing.currentThisTid
            (checkMethodBodies
                :st
                :frame
                :unitDecl
                :ast
                typeName: name
                typeTid: (ztypes.tid.create from: owTid)
                opId: mem.operation
            )
            st.typing.synthLabel = prev
            st.typing.synthOwnerUnit = prevU
            st.typing.synthOwnerName = prevN
            st.typing.currentThisTid = prevThis
        }
        st.typing.suppressFnAutoCall = mwSupFn
        st.typing.suppressBareCtor = mwSup
    }
}

# objectdefHasMethodBodies -- a unit member whose operation is an objectdef
# with at least one functiondef-with-body item.
objectdefHasMethodBodies: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case objectdef then {
        iiter: op.isItems.iterate
        for imId: iiter loop {
            im: ast.nodes.get i: imId.u64
            match (
                im
            ) case namedoperation then {
                if (isFunctionDefWithBody o: (ast.nodes.get i: im.operation.u64)) then return true
            } else null
        }
        aiter: op.asItems.iterate
        for amId: aiter loop {
            am: ast.nodes.get i: amId.u64
            match (
                am
            ) case namedoperation then {
                if (isFunctionDefWithBody o: (ast.nodes.get i: am.operation.u64)) then return true
            } else null
        }
        return false
    } else {
        return false
    }
}

# methodDeclOf -- the declaration of method `memberId` of type `typeName` in
# `unitDecl`, or 0.
methodDeclOf: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
    typeName: StringView
    memberId: zast.nameid
} out ztypes.declid is {
    td: (declOfUnitDefIds
        :st
        :unitDecl
        nameId: (nameIdOf :ast name: typeName)
    )
    if td.isZero then return (ztypes.declid.create from: 0)
    return (st.typing.declFindChild parentDeclId: td nameId: memberId)
}

# checkMethodBodies -- body-check every method of one type definition (is- and
# as-block functiondefs, declaration order). The scopes land under the walk's
# current scope, where the first demand placed them.
checkMethodBodies: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    ast: Ast
    typeName: StringView
    typeTid: ztypes.tid
    opId: zast.nodeid
} is {
    orf: objRefAt :ast nid: opId
    if (orf.nid.isZero) == false then {
        kI: u64
        for kI < orf.nis loop {
            imId: (zast.objIsItemAt :ast nid: opId i: kI).u32
            kI = kI + 1
            # the member is read through a view scoped to this block: the
            # body check below lends ast
            imIsFn: false
            imOp: zast.nodeid
            imName: zast.nameid
            mname: String
            {
                im: argRefAt :ast nid: (zast.nodeid.create from: imId.u32)
                if (im.nid.isZero) == false then {
                    if (isFunctionDefWithBody o: (ast.nodes.get i: im.operation.u64)) then {
                        imIsFn = true
                        imOp = im.operation
                        imName = im.name
                        mname = zast.nameTextCopy :ast ref: im.name
                    }
                }
            }
            if imIsFn then {
                {
                    # about to check this body, so its signature is needed:
                    # `this` binds from the resolved receiver
                    hDefId2: nameIdOf :ast name: typeName
                    (forceUnitDefMember
                        :st
                        :frame

                        :ast
                        :unitDecl
                        defId: hDefId2
                        memberId: imName
                    )
                    qn: "\{typeName}.\{mname}"
                    declId93: (methodDeclOf :st :ast :unitDecl :typeName memberId: imName)
                    imFr: fnRefAt :ast nid: imOp
                    (checkFunctionBody
                        :st
                        :frame
                        :unitDecl
                        defName: qn.stringView
                        fn: imFr
                        thisName: typeName
                        thisTid: typeTid
                        :ast
                        declId: declId93
                    )
                }
            }
        }
        kA: u64
        for kA < orf.nas loop {
            amId: (zast.objAsItemAt :ast nid: opId i: kA).u32
            kA = kA + 1
            # the member is read through a view scoped to this block: the
            # body check below lends ast
            amIsFn: false
            amOp: zast.nodeid
            amName: zast.nameid
            monoName: String
            {
                am: argRefAt :ast nid: (zast.nodeid.create from: amId.u32)
                if (am.nid.isZero) == false then {
                    if (isFunctionDefWithBody o: (ast.nodes.get i: am.operation.u64)) then {
                        amIsFn = true
                        amOp = am.operation
                        amName = am.name
                        monoName = zast.nameTextCopy :ast ref: am.name
                    }
                }
            }
            if amIsFn then {
                {
                    hDefId: nameIdOf :ast name: typeName
                    (forceUnitDefMember
                        :st
                        :frame

                        :ast
                        :unitDecl
                        defId: hDefId
                        memberId: amName
                    )
                    qn2: "\{typeName}.\{monoName}"
                    declId94: (methodDeclOf :st :ast :unitDecl :typeName memberId: amName)
                    amFr: fnRefAt :ast nid: amOp
                    (checkFunctionBody
                        :st
                        :frame
                        :unitDecl
                        defName: qn2.stringView
                        fn: amFr
                        thisName: typeName
                        thisTid: typeTid
                        :ast
                        declId: declId94
                    )
                }
            }
        }
    }
}

# lastStmtLineId / lastStmtLineIdAt -- the node id of a function body's last
# statement line (the implicit-return position), or 0 when absent.
lastStmtLineId: function {ast: Ast.view block: Node.view} out zast.nodeid is {
    match (
        block
    ) case statement then {
        ne: block.statements.length
        if ne > 0 then {
            lastId: block.statements.get i: (ne - 1)
            last: ast.nodes.get i: lastId.u64
            match (
                last
            ) case statementline then {
                return last.nodeid
            } else null
        }
    } else null
    return (zast.nodeid.create from: 0)
}

# the node id of the last statement line in operation `oId`.
lastStmtLineIdAt: function {ast: Ast.view oId: zast.nodeid} out zast.nodeid is {
    if oId.isZero then return (zast.nodeid.create from: 0)
    return (lastStmtLineId :ast block: (ast.nodes.get i: oId.u64))
}
# checkReceiverOwnership -- a receiver may be `borrow` (the default) or `view` only:
# an object cannot own itself. Family-independent -- the ownership axis says
# nothing about valtype or reftype -- and a `lock` receiver is rejected the same
# way, a lock being a thing a caller holds rather than a thing a method takes.
checkReceiverOwnership: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    pm: argref
    pnid: zast.nodeid
    ptid: u64
    hasOwn: bool
    ownMode: ztypes.zparamownership
    isLockP: bool
    isGenP: bool
    mkn: StringView
    pnameId: zast.nameid
} is {
    # A receiver may be `borrow` (the default) or `view` only:
    # an object cannot own itself. Family-independent -- the
    # ownership axis says nothing about valtype or reftype.
    ownRecv: false
    if hasOwn then {
        if ownMode == ztypes.zparamownership.takeMode then ownRecv = true
        if ownMode == ztypes.zparamownership.holdMode then ownRecv = true
    }
    if ownRecv when (paramIsThisReceiver
        :ast
        op: (ast.nodes.get i: pm.operation.u64)
    ) then {
        orm: "take".string
        if hasOwn when ownMode == ztypes.zparamownership.holdMode then orm = "hold".string
        orln: nodeLine n: (ast.nodes.get i: pm.operation.u64)
        orcl: nodeCol n: (ast.nodes.get i: pm.operation.u64)
        orm2: "Cannot use '.\{orm}' on a receiver — an object cannot own itself; a receiver is 'borrow' (the default) or 'view'"
        (addError
            :st
            nodeid: pnid
            lineno: orln
            colno: orcl
            e: zast.err.ownerError
            msg: orm2
        )
    }
    if isLockP when (paramIsThisReceiver
        :ast
        op: (ast.nodes.get i: pm.operation.u64)
    ) == false when (typeIsValtype
        :st

        tid: (ztypes.tid.create from: ptid.u64)
    ) when (isGenP) == false then {
        ptn: st.reg.nameOf tid: (ztypes.tid.create from: ptid.u64)
        plln: nodeLine n: (ast.nodes.get i: pm.operation.u64)
        plcl: nodeCol n: (ast.nodes.get i: pm.operation.u64)
        pname: zast.nameTextAt :ast ref: pnameId
        ml: "Cannot use '.\{mkn}' on valtype parameter '\{pname}' (type '\{ptn}') — locking requires identity (use a class)"
        (addError
            :st
            nodeid: pnid
            lineno: plln
            colno: plcl
            e: zast.err.ownerError
            msg: ml
        )
    }
}
# lockReadonlyParam -- a readonly parameter (`view`, not owned, or `hold`, owned) is
# readonly for the whole body: it holds a readonly lock on itself, so writes,
# mutating receivers and re-passing to a mutable parameter are all caught by the
# ordinary lock rules. Both families -- a `view`/`hold` valtype is not a copy, so
# the lock is taken here rather than left to the emitter's ABI choice.
lockReadonlyParam: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    pm: argref
    pnid: zast.nodeid
    pnId: zast.nameid
    vid2: ztypes.vid
} is {
    # A readonly parameter -- `view` (not owned) or `hold`
    # (owned) -- is readonly for the whole body: it holds a
    # readonly lock on itself, so writes, mutating receivers
    # and re-passing to a mutable parameter are all caught
    # by the ordinary lock rules. Ownership is a separate
    # axis and is carried by `own` above.
    #
    # Both families. A valtype leaf normally skips locking
    # -- the read is a copy, with no identity to protect --
    # but a `view`/`hold` valtype is not a copy: the lock is
    # what makes the marker mean anything, and it is taken
    # here rather than left to the emitter's ABI choice.
    vpp: (ListVal zast.nameid)
    vpp.append pnId
    vph: (ztypes.zlockholder
        kind: ztypes.zlockholderkind.varKind
        id: vid2
    )
    vpr: (st.tryLock
        pool: ast.names
        path: vpp
        lockType: ztypes.zlockstate.shared
        lockScope: ztypes.zlockscope.target
        holder: vph
    )
    if vpr.length > 0 then {
        (addError
            :st
            nodeid: pnid
            lineno: (nodeLine n: (ast.nodes.get i: pm.operation.u64))
            colno: (nodeCol n: (ast.nodes.get i: pm.operation.u64))
            e: zast.err.ownerError
            msg: vpr
        )
    }
}


# bindFunctionParam -- bind one declared parameter into the body's scope: its type,
# its ownership (a receiver may be `borrow` or `view` only -- an object cannot own
# itself), its locks, and the readonly and privacy gates its type expression
# carries. A template's own bare param has no stamp, so it binds the canonical
# param tid off the FUNCTION child instead.
# refuseNullTyped -- `null` is NOT a runtime value: it spells "no value" in a
# sum type's arm and undefines a member (`create: null`, `==: null`), and that
# is all. A parameter or field typed by it would be a slot holding something
# that does not exist, and the emitter has no C for it -- it wrote an undeclared
# `null` into the call and only the C compiler complained.
refuseNullTyped: function {
    st: zenv.ZSymbolTable
    tid: ztypes.tid
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    what: StringView
    name: StringView
} out bool is {
    if tid.isZero then return false
    if (st.reg.typetypeOf typeId: tid) != ztypes.ztypetype.nullType then return false
    mn9: "'null' cannot be the type of \{what} '\{name}' — null is not a runtime value"
    hn9: "null spells an arm that carries nothing (`none: null`) or undefines a member (`create: null`); for an optional value use a union or variant".string
    nn9: String
    (addErrorH
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.typeError
        msg: mn9
        note: nn9
        hint: hn9
        width: name.length.u32.orPanic
    )
    return true
}

bindFunctionParam: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    rf: ztypes.declid
    pm: argref
    thisName: StringView
    isGenDef: bool
    fnTid: ztypes.tid
} is {
    rgot: (optionval.none u64)
    if (fnTid.isZero) == false then rgot = (optionval.some fnTid.u64)
    pnid: nodeId n: (ast.nodes.get i: pm.operation.u64)
    ptid: paramTypeId :st :ast :unitDecl opNid: pm.operation
    if st.typing.curMonoFnTid > 0 then {
        # per-mono instance walk: the mono FUNCTION child
        # carries the substituted param type
        mpo: st.typing.declChildOfId parentTypeId: st.typing.curMonoFnTid nameId: pm.name
        match (
            mpo
        ) case some then {
            ptid = mpo
        } case none then null
    }
    if ptid == 0 when isGenDef then {
        # a template's own bare param carries no stamp; bind
        # the canonical param tid from the FUNCTION child so
        # the walk types it (stampGate suppresses the stamp)
        fgo3: rgot
        match (
            fgo3
        ) case some then {
            fco3: (st.typing.declChildOfId
                parentTypeId: (ztypes.tid.create from: fgo3.u64)
                nameId: pm.name
            )
            match (
                fco3
            ) case some then {
                if (st.reg.typetypeOf typeId: (ztypes.tid.create from: fco3.u64)) == ztypes.ztypetype.genericParam then {
                    ptid = fco3
                }
            } case none then null
        } case none then null
    }
    if ptid > 0 then {
        pnm9: zast.nameTextCopy :ast ref: pm.name
        (refuseNullTyped
            :st
            tid: (ztypes.tid.create from: ptid.u64)
            nodeid: pm.nid
            lineno: pm.lineno
            colno: pm.colno
            what: "parameter"
            name: pnm9.stringView
        )
    }
    if ptid > 0 then {
        noSt: optBoolOr o: (st.typing.noStampNode.get key: pnid.u64) d: false
        if (noSt) == false then {
            ppre: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: pnid.u64
            if ppre.isZero then {
                setpp: ptid
                stampGate :st nid: pnid.u64 tid: (ztypes.tid.create from: setpp.u64)
            }
        }
    }
    if thisName.length > 0 when (paramIsThisReceiver
        :ast
        op: (ast.nodes.get i: pm.operation.u64)
    ) then {
        thOpt: (walkLookupTyperef
            :st
            frame: rf
            :ast

            :unitDecl
            base: thisName
        )
        match (
            thOpt
        ) case some then {
            ptid = thOpt
        } case none then null
    }
    pown: pathOwnership :ast n: (ast.nodes.get i: pm.operation.u64)
    isLockP: false
    mkn: "lock".string
    match (
        pown
    ) case some then {
        # Only `.lock` needs an identity to point at, so only
        # `.lock` is refused on a valtype below. `.view` and
        # `.hold` are readonly markers, enforced by a lock on
        # the parameter's own NAME, which a valtype has just as
        # much as a class does.
        if pown == ztypes.zparamownership.viewMode then mkn = "view".string
        if pown == ztypes.zparamownership.holdMode then mkn = "hold".string
    } case none then null
    isGenP: false
    if (st.reg.typetypeOf typeId: (ztypes.tid.create from: ptid.u64)) == ztypes.ztypetype.genericParam then isGenP = true
    hasOwn: false
    ownMode: ztypes.zparamownership.borrowMode
    match (
        pown
    ) case some then {
        hasOwn = true
        ownMode = pown
    } case none then null
    (checkReceiverOwnership
        :st
        :ast
        :pm
        :pnid
        :ptid
        :hasOwn
        :ownMode
        :isLockP
        :isGenP
        mkn: mkn.stringView
        pnameId: pm.name
    )
    own: ownershipOfParam o: (pathOwnership
        :ast
        n: (ast.nodes.get i: pm.operation.u64)
    )
    isRoP: false
    match (
        pown
    ) case some then {
        if pown == ztypes.zparamownership.viewMode then isRoP = true
        if pown == ztypes.zparamownership.holdMode then isRoP = true
    } case none then null
    vid2: (st.reg.newVariable
        ztypeId: (ztypes.tid.create from: ptid.u64)
        ownership: own
    )
    if (typeExprHasPrivate
        :ast
        n: (ast.nodes.get i: pm.operation.u64)
    ) then st.reg.setVariablePrivate id: vid2
    pnId: pm.name
    st.defineVar nameId: pnId vid: vid2
    if isRoP then lockReadonlyParam :st :ast :pm :pnid :pnId :vid2
    st.typing.defVariableId.set key: pnid.u64 value: vid2
    st.reg.setVariableOrigin id: vid2 origin: ztypes.zvarorigin.param
}
# coerceImplicitReturn -- a literal-typed last statement takes the function's
# concrete return type, stamped on the statement line.
coerceImplicitReturn: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    defn: fnref
    fnTid: ztypes.tid
} is {
    # Implicit-return coercion: a literal-typed last statement takes
    # the function's concrete return type, stamped on the statement
    # line.
    ftid: fnTid
    if ftid > 0 then {
        ro: methodReturnOf :st mid: ftid
        match (
            ro
        ) case some then {
            lsid: lastStmtLineIdAt :ast oId: defn.body
            if lsid > 0 then {
                cur: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: lsid.u64
                if cur > 0 then {
                    if (isLiteralTypeId
                        :st
                        tid: (ztypes.tid.create from: cur.u64)
                    ) then stampGate :st nid: lsid.u64 tid: ro
                }
            }
        } case none then null
    }
}
# setSynthOwnerLabel -- synth rows carry the unit member's dump label: a method's
# nodes live inside its TYPE's subtree, so the label is the type name. The same
# pair travels as ids too -- a method's owner is its TYPE, everything else owns
# itself -- which is what checkCase reads instead of splitting the label apart.
setSynthOwnerLabel: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    defName: StringView
    thisName: StringView
} is {
    # Synth rows carry the unit member's dump label: a method's nodes
    # live inside its TYPE's subtree, so the label is the type name.
    # Nested method walks save and restore it around their bodies.
    lblUnit: zast.poolTextAt pool: ast.names ref: (unitNameIdOf :st :unitDecl)
    lbl: "\{lblUnit}.\{defName}"
    if thisName.length > 0 then lbl = "\{lblUnit}.\{thisName}"
    st.typing.synthLabel = lbl
    # the same pair as ids: a method's owner is its TYPE, everything
    # else owns itself. checkCase reads this instead of splitting the
    # label back apart.
    st.typing.synthOwnerUnit = unitDecl
    {
        soid: zast.poolFind pool: ast.names text: defName
        if thisName.length > 0 then soid = (zast.poolFind
            pool: ast.names
            text: thisName
        )
        st.typing.synthOwnerName = soid
    }
}


# checkFunctionBody -- type-check one function body. Pushes a scope, binds each
# parameter as a runtime variable, walks the body, then pops (the pop snapshots
# the scope's entries + unreachable flag for the SQL dump).
checkFunctionBody: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    fn: fnref
    thisName: StringView
    thisTid: ztypes.tid
    ast: Ast
    declId: ztypes.declid
} is {
    # the body resolves in the frame of its own declaration, whatever walk
    # reached it. A caller that has no declaration for the body (a mono
    # instance walk) keeps the frame it was given.
    rf: frame
    if (declId.isZero) == false then rf = declId
    if (fn.nid.isZero) == false then {
        # the function's own declaration, when the caller passed one whose
        # type IS this function (a free function, a namespace member, a
        # method), is its identity: a namespace member is not found by the
        # unit's name, and without it the walk skipped its return-type
        # checks. A mono instance walk passes the TEMPLATE's Decl -- its
        # function is the mono's substituted child, found by label -- and
        # keeps the name path.
        fnDecl: ztypes.declid
        fnTid: ztypes.tid
        if st.typing.curMonoStamp == 0 then {
            dt: declTypeIdOf :st :declId
            if (dt.isZero) == false then {
                if (st.reg.typetypeOf typeId: dt) == ztypes.ztypetype.functionType then {
                    fnDecl = declId
                    fnTid = dt
                }
            }
        }
        # a body is walked only once everything demanded so far has resolved:
        # an owner or function resolved late (from a walk) queued what its
        # bodies reference, and those must be resolved before those bodies are
        # walked, exactly as the early ones were.
        resolveDemandedDefs :st frame: rf :ast
        # Claim this definition BEFORE the trigger runs. The trigger now walks
        # a free function's body, and the body it would walk here is the one
        # already being walked -- checkFunctionBody calls it with its OWN name.
        # Claiming first turns the self-call into the signature scan it was
        # always there for, and leaves the body walk to this rf.
        {
            sfId: zast.poolFind pool: ast.names text: defName
            if (sfId.isZero) == false then {
                sfd: fnDecl
                if sfd.isZero then sfd = (declOfUnitDefIds
                    :st
                    :unitDecl
                    nameId: sfId
                )
                sfHad: st.typing.declIsWalked declId: sfd
                st.typing.declSetWalked declId: sfd
                if (sfHad) == false then {
                    (scanFnSig
                        :st
                        frame: rf
                        :unitDecl
                        :ast
                        opId: fn.nid
                    )
                }
            }
        }
        maybeWalkMethods :st frame: rf :unitDecl :ast name: defName
        hasBody: fn.body > 0
        isGenDef: false
        # the function's own tid, off the Decl the caller passed; a defName is
        # display only (a mono walk's owner is a registry label such as
        # `mathops_i64`, never an interned name).
        rgot: (optionval.none u64)
        if (fnTid.isZero) == false then rgot = (optionval.some fnTid.u64)
        match (
            rgot
        ) case some then {
            {
                isgeneric9v: st.reg.isGenericOf tid: (ztypes.tid.create from: rgot.u64)
                    if isgeneric9v then isGenDef = true
            }
        } case none then null
        if hasBody then {
            # A generic template body is checked ONCE, for diagnostics; the
            # emitter re-walks the shared AST per instance, so
            # GENERIC_PARAM-valued stamps are suppressed for the walk (and
            # its scopes/entries stay out of the dump log).
            prevSup: st.typing.suppressParamStamps
            if isGenDef then st.typing.suppressParamStamps = true
            sname: "function:\{defName}"
            st.push name: sname.stringView parent: rf
            kP: u64
            for kP < fn.nparams loop {
                pmId: (zast.fnParamAt :ast nid: fn.nid i: kP).u32
                kP = kP + 1
                pm: argRefAt :ast nid: (zast.nodeid.create from: pmId.u32)
                if (pm.nid.isZero) == false then {
                    (bindFunctionParam
                        :st
                        :unitDecl
                        :ast
                        :rf
                        :pm
                        :thisName
                        :isGenDef
                        :fnTid
                    )
                }
            }
            setSynthOwnerLabel :st :unitDecl :ast :defName :thisName
            st.typing.currentThisTid = thisTid
            prevFn: st.typing.currentFnTid
            st.typing.currentFnTid = fnTid
            prevRet: st.typing.currentReturnTypeId
            fitid: (optU64Or o: rgot d: 0)
            crt: ztypes.tid
            if fitid > 0 then crt = (optTidOr
                o: (methodReturnOf :st mid: (ztypes.tid.create from: fitid.u64))
                d: ztypes.tid
            )
            st.typing.currentReturnTypeId = crt
            prevRb: st.typing.currentReturnsBorrow
            st.typing.currentReturnsBorrow = (optBoolOr
                o: (st.typing.funcReturnsBorrow.get key: fitid)
                d: false
            )
            walkBodyAt :st :unitDecl :ast bodyId: fn.body
            st.typing.currentReturnTypeId = prevRet
            st.typing.currentReturnsBorrow = prevRb
            st.typing.currentFnTid = prevFn
            (coerceImplicitReturn
                :st
                :ast
                defn: fn
                fnTid: (ztypes.tid.create from: (optU64Or o: rgot d: ztypes.tid))
            )
            st.pop
            st.typing.suppressParamStamps = prevSup
        }
    }
}


# checkUnitBodies -- walk every function definition with a body in one unit.
# walkUnitTemplateBodies -- body-walk a generic unit template's functions with
# the generic param UNBOUND (no st.define of the arg), so a `match t` subject
# resolves to 0 and checkCase stamps it as a genericParam (against the bare unit
# name) for the emitter to dissect. Mirrors checkUnitBodies' fn loop (index-based
# so it never holds the iterator lock while passing unitBody).
walkUnitTemplateBodies: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    unitdefId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    # the template's own declaration, off its unitdef node's stamp: the frame
    # its members' bodies are walked in
    tdecl: ztypes.declid
    {
        tun: unitdefNodeId :ast nId: unitdefId
        if (tun.isZero) == false then {
            tnt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: tun.u64
            if tnt > 0 then tdecl = declOfTypeId :st tid: (ztypes.tid.create from: tnt)
        }
    }
    # a generic FILE unit is a root, named by `unitDecl`
    if tdecl.isZero then {
        tro: unitDecl
        if (tro.isZero) == false then tdecl = tro
    }
    # a template-time walk: the generic parameter resolves to its
    # GENERIC_PARAM id in the template's frame, and stamps of that type stay
    # out of the global table -- the emitter re-walks the shared AST per
    # instance and reads the instance's stamps (the rule every template walk
    # follows; the `match t` marker writes past it on purpose)
    prevSup: st.typing.suppressParamStamps
    st.typing.suppressParamStamps = true
    bn: bodyIds.length
    bi: u64
    for bi < bn loop {
        bmId: bodyIds.get i: bi
        bi = bi + 1
        bm: argRefAt :ast nid: (zast.nodeid.create from: bmId.u32)
        if (bm.nid.isZero) == false then {
            if (isFunctionDefOp op: (ast.nodes.get i: bm.operation.u64)) then {
                # an owned copy: the body walk below lends ast
                dn: zast.nameTextCopy :ast ref: bm.name
                fdecl: ztypes.declid
                if (tdecl.isZero) == false then fdecl = (st.typing.declFindChild
                    parentDeclId: tdecl
                    nameId: bm.name
                )
                cfbFr: fnRefAt :ast nid: (zast.nodeid.create from: bm.operation.u32)
                (checkFunctionBody
                    :st
                    :frame
                    :unitDecl
                    defName: dn.stringView
                    fn: cfbFr
                    thisName: ""
                    thisTid: ztypes.tid
                    :ast
                    declId: fdecl
                )
            }
        }
    }
    st.typing.suppressParamStamps = prevSup
}

# walkGenericUnitTemplates -- stamp `match t`/`match cap` in every generic unit
# template (file-level units and inline `unit as {}` bindings) via an unbound
# body walk. Runs after the main-unit body check. Unit op ids and
# names are lifted out of node views before program.ast is passed on (lock-safe).
walkGenericUnitTemplates: function {st: zenv.ZSymbolTable frame: ztypes.declid program: Node} is {
    match (
        program
    ) case program then {
        n: program.ast.units.length
        ui: u64
        for ui < n loop {
            uId: (zast.nodeid.create from: (program.ast.units.get i: ui))
            ui = ui + 1
            uop: zast.nodeid
            un: String
            {
                u: program.ast.nodes.get i: uId.u64
                if u.namedoperation then {
                    uop = u.operation
                    un = zast.poolTextCopy pool: program.ast.names ref: u.name
                }
            }
            if uop > 0 then {
                if (unitDefIsGeneric ast: program.ast oId: uop) then {
                    hUnitDecl2: (unitDeclOfNameOrOwn
                        :st
                        :frame
                        nameId: (nameIdOf ast: program.ast name: un.stringView)
                    )
                    (walkUnitTemplateBodies
                        :st
                        :frame
                        ast: program.ast
                        unitDecl: hUnitDecl2
                        unitdefId: uop
                    )
                }
                ibody: zast.unitBodyIdsAt ast: program.ast unitId: uop
                ibn: ibody.length
                ibi: u64
                for ibi < ibn loop {
                    ibmId: ibody.get i: ibi
                    ibi = ibi + 1
                    bop: zast.nodeid
                    isU: false
                    {
                        bm: program.ast.nodes.get i: ibmId.u64
                        if bm.namedoperation then {
                            if (isUnitOp op: (program.ast.nodes.get i: bm.operation.u64)) then {
                                isU = true
                                bop = bm.operation
                            }
                        }
                    }
                    if isU when (unitDefIsGeneric ast: program.ast oId: bop) then {
                        # an INLINE template's members resolve in the FILE unit
                        # it is written in -- its own name is no file unit, and
                        # naming it only ever meant "the frame of the walk",
                        # which is this unit
                        hUnitDecl: (unitDeclOfNameOrOwn
                            :st
                            :frame
                            nameId: (nameIdOf ast: program.ast name: un.stringView)
                        )
                        (walkUnitTemplateBodies
                            :st
                            :frame
                            ast: program.ast
                            unitDecl: hUnitDecl
                            unitdefId: bop
                        )
                    }
                }
            }
        }
    } else null
}

# typecheck every definition body in a unit.
# checkNamespaceBodies -- walk the function bodies of a namespace unit. Its
# members resolve against ITS body list, not the file unit's, so a name written
# inside a namespace finds the namespace's definition first. Without this a
# namespace's signatures reach the emitter with unstamped nodes, which surfaces
# as a loud E0500 rather than a diagnostic.
checkNamespaceBodies: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    unitdefId: zast.nodeid
} is {
    # Once per unit op: the main tree walk and the demand drain can both reach
    # the same namespace, and a second walk would re-report every diagnostic.
    if (st.typing.nsBodiesWalked.has item: unitdefId.u64) then return
    st.typing.nsBodiesWalked.add item: unitdefId.u64
    rf: frame
    nsDecl: ztypes.declid
    {
        un: unitdefNodeId :ast nId: unitdefId
        if (un.isZero) == false then {
            nt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: un.u64
            if nt > 0 then {
                nsDecl = declOfTypeId :st tid: (ztypes.tid.create from: nt)
                rf = nsDecl
            }
        }
    }
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    bn: bodyIds.length
    bi: u64
    for bi < bn loop {
        bmId: bodyIds.get i: bi
        bi = bi + 1
        bm: argRefAt :ast nid: (zast.nodeid.create from: bmId.u32)
        if (bm.nid.isZero) == false then {
            if (zast.unitOpDeclaresUnit :ast opId: bm.operation) then {
                (checkNamespaceBodies
                    :ast
                    :st
                    frame: rf
                    :unitDecl
                    unitdefId: bm.operation
                )
            } else {
                # an owned copy: the body walk below lends ast
                defNameText: zast.nameTextCopy :ast ref: bm.name
                bmDecl9: st.typing.declFindChild parentDeclId: nsDecl nameId: bm.name
                cfbFr: fnRefAt :ast nid: (zast.nodeid.create from: bm.operation.u32)
                (checkFunctionBody
                    :st
                    frame: rf
                    :unitDecl
                    defName: defNameText.stringView
                    fn: cfbFr
                    thisName: ""
                    thisTid: ztypes.tid
                    :ast
                    declId: bmDecl9
                )
            }
        }
    }
}

checkUnitBodies: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    unitdefId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    {
        mn: bodyIds.length
        mi: u64
        foundMain: false
        for mi < mn loop {
            mmId: bodyIds.get i: mi
            mi = mi + 1
            mm: argRefAt :ast nid: (zast.nodeid.create from: mmId.u32)
            if (mm.nid.isZero) == false then {
                # an owned copy: the body walk below lends ast
                memberName: zast.nameTextCopy :ast ref: mm.name
                if memberName.stringView == "main" when (isFunctionDefOp
                    op: (ast.nodes.get i: mm.operation.u64)
                ) then {
                    foundMain = true
                    hDeclId2: declOfUnitDefIds :st :unitDecl nameId: mm.name
                    cfbFr: fnRefAt :ast nid: (zast.nodeid.create from: mm.operation.u32)
                    (checkFunctionBody
                        :st
                        :frame
                        :unitDecl
                        defName: memberName.stringView
                        fn: cfbFr
                        thisName: ""
                        thisTid: ztypes.tid
                        :ast
                        declId: hDeclId2
                    )
                }
            }
        }
        # E0039 -- there is no root to demand from. Compilation is demand-driven
        # and `main` is the root, so a target unit without one has no entry point
        # and nothing to reach from: it is a LIBRARY, and the program that opens
        # it is what should be compiled. `--eager` is exempt on the same
        # reasoning rather than as a convenience -- it resolves every definition
        # instead of what a root reaches, so it needs no root. That exemption is
        # what keeps `zl lint --full`, zls and eager-guard (all eager: true)
        # working on a library unit.
        if (foundMain) == false when (st.typing.eagerAll) == false when st.typing.requireMain then {
            (noMainError
                :st
                :ast
                :unitDecl
                :unitdefId
            )
        }
        bn: bodyIds.length
        bi: u64
        for bi < bn loop {
            bmId: bodyIds.get i: bi
            bi = bi + 1
            bm: argRefAt :ast nid: (zast.nodeid.create from: bmId.u32)
            if (bm.nid.isZero) == false then {
                # an owned copy: the body walk below lends ast
                defName: zast.nameTextCopy :ast ref: bm.name
                # the target unit's own definitions are walked because something
                # DEMANDED them, exactly as a dependency's are. Walking every one
                # regardless is what made the root the one unit in the program
                # that was not demand-driven.
                if (st.typing.eagerAll) == false then {
                    if (defWasResolved
                        :st
                        :frame
                        :unitDecl
                        nameId: bm.name
                    ) == false then continue
                }
                # and not again if a demand point already walked it. depWalkUnit
                # has always asked this; the target unit never had to, because
                # nothing else walked its bodies.
                if (st.typing.declIsWalked declId: (declOfUnitDefIds
                    :st
                    :unitDecl
                    nameId: bm.name
                )) then continue
                if (zast.unitOpDeclaresUnit :ast opId: bm.operation) then {
                    (checkNamespaceBodies
                        :ast
                        :st
                        :frame
                        :unitDecl
                        unitdefId: bm.operation
                    )
                } else if defName.stringView != "main" then {
                    hDeclId: declOfUnitDefIds :st :unitDecl nameId: bm.name
                    cfbFr: fnRefAt :ast nid: (zast.nodeid.create from: bm.operation.u32)
                    (checkFunctionBody
                        :st
                        :frame
                        :unitDecl
                        defName: defName.stringView
                        fn: cfbFr
                        thisName: ""
                        thisTid: ztypes.tid
                        :ast
                        declId: hDeclId
                    )
                }
            }
        }
    }
}

# checkBodies -- the body-walk pass, mirroring check()'s top-level
# loop: walk the main unit's function bodies, main first, then the others in
# body order. Runs after demand resolution so referenced types are already
# resolved.
checkBodies: function {st: zenv.ZSymbolTable frame: ztypes.declid program: Node} is {
    match (
        program
    ) case program then {
        unitDecl: (unitDeclOfNameOrOwn
            :st
            :frame
            nameId: (nameIdOf ast: program.ast name: program.mainUnitName.stringView)
            )
        mainIdx: u64
        found: false
        i0: u64
        uCnt9d: program.ast.units.length
        uIdx9d: u64
        for uIdx9d < uCnt9d loop {
            uId: (zast.nodeid.create from: (program.ast.units.get i: uIdx9d))
            uIdx9d = uIdx9d + 1
            u: program.ast.nodes.get i: uId.u64
            match (
                u
            ) case namedoperation then {
                uc5z: unitDeclOfNameOrOwn :st :frame nameId: u.name
                if uc5z == unitDecl then {
                    if (found) == false then {
                        mainIdx = i0
                        found = true
                    }
                }
            } else null
            i0 = i0 + 1
        }
        if found then {
            muId: (zast.nodeid.create from: (program.ast.units.get i: mainIdx))
            mOpId: zast.nodeid
            {
                mu: program.ast.nodes.get i: muId.u64
                if mu.namedoperation then mOpId = mu.operation
            }
            if mOpId > 0 then {
                (checkUnitBodies
                    :st
                    :frame
                    :unitDecl
                    unitdefId: mOpId
                    ast: program.ast
                )
            }
        }
        # a body walk can demand definitions the signatures never reached
        # (a type constructed only inside a late-resolved owner's method):
        # resolve them before the completion pass walks their owners
        resolveDemandedDefs :st :frame ast: program.ast
        walkOwedNamespaceBodies :st :frame ast: program.ast
        walkLateResolvedOwners :st :frame ast: program.ast
        stampUnitMonoTemplates :st :frame :program
    } else null
}

# walkLateResolvedOwners -- complete the demand walk. A type can resolve AFTER
# its unit's walk has already run -- zvfs.ZVfs and DentryTable do it in astdemo,
# and a typedef constant does it in its own unit -- and nothing re-walks that
# unit, so its methods would be emitted with nothing stamped (E0500, "unhandled
# binding type"). The walk is what stamps a body, so the completion pass is not
# optional; it is the price of walking a unit once rather than to a fixpoint.
# A type NOTHING reached is not checked here: a definition the program cannot
# reach is not the compiler's to spend time on, and reporting on it is a LINT
# concern. So the keep test is `resolved` alone.
# walkOwedNamespaceBodies -- walk the member bodies of every namespace or
# hidden subunit the demand path resolved. The main unit's own namespaces are
# walked by checkUnitBodies; a DEPENDENCY's are reached only here, and without
# this their bodies arrive at the emitter unstamped -- a loud E0500 where a
# diagnostic belongs.
#
# Drained in rounds because a body can demand a deeper subunit: each round
# resolves what the last one demanded, so a subunit of a subunit is walked by
# the round after its parent, to any depth. Deterministic: demand order.
walkOwedNamespaceBodies: function {st: zenv.ZSymbolTable frame: ztypes.declid ast: Ast} is {
    for st.typing.nsBodiesOwed.length > 0 loop {
        round: (ListVal ztyping.nsbody)
        for st.typing.nsBodiesOwed.length > 0 loop round.append st.typing.nsBodiesOwed.pop
        ri: u64
        rn: round.length
        for ri < rn loop {
            rec: round.get i: ri
            ri = ri + 1
            unitDecl910: (unitDeclOfNameOrOwn :st :frame nameId: rec.unitName)
            (checkNamespaceBodies
                :ast
                :st
                :frame
                unitDecl: unitDecl910
                unitdefId: rec.unitOp
            )
        }
        # a walked body demands definitions of its own; resolving them here is
        # what puts the next depth on the list
        resolveDemandedDefs :st :frame :ast
    }
}

# the target unit's own owners is gone, which is the whole of the dead-code job.
#
# Template owners are skipped: their bodies check per instantiation.
# Deterministic: unit load order, declaration order.
walkLateResolvedOwners: function {st: zenv.ZSymbolTable frame: ztypes.declid ast: Ast} is {
    swN: ast.units.length
    swI: u64
    for swI < swN loop {
        swuId: (zast.nodeid.create from: (ast.units.get i: swI))
        swI = swI + 1
        swu: argRefAt :ast nid: (zast.nodeid.create from: swuId.u32)
        if (swu.nid.isZero) == false then {
            # an owned copy: the walks below lend ast
            swun: zast.nameTextCopy :ast ref: swu.name
            swBody: zast.unitBodyIdsAt :ast unitId: swu.operation
            swbi: u64
            swbn: swBody.length
            for swbi < swbn loop {
                swmId: swBody.get i: swbi
                swbi = swbi + 1
                swm: argRefAt :ast nid: (zast.nodeid.create from: swmId.u32)
                if (swm.nid.isZero) == false then {
                    # an owned copy: the walks below lend ast
                    swmn: zast.nameTextCopy :ast ref: swm.name
                    uq8z: (unitDeclOfName
                        :st
                        nameId: (nameIdOf :ast name: swun.stringView)
                    )
                    swd: (declOfUnitDefIds
                        :st
                        unitDecl: uq8z
                        nameId: swm.name
                    )
                    swWalked: st.typing.declIsWalked declId: swd
                    if swWalked == false then {
                        # the owner's definition row is read through a view
                        # scoped to this block: the walks below lend ast
                        swDo: false
                        swHasBodies: false
                        {
                            swop: ast.nodes.get i: swm.operation.u64
                            match (
                                swop
                            ) case objectdef then {
                                if (hasGenericParam
                                    :ast
                                    items: swop.asItems
                                ) == false then swDo = true
                            } else null
                            swHasBodies = objectdefHasMethodBodies :ast op: swop
                        }
                        # Whose dead code it is decides whether this compile
                        # cares. An owner in the program's OWN unit is worth
                        # reporting on: the author wrote it and can fix it. A
                        # DEPENDENCY's unreached type is not -- a build must not
                        # spend time probing definitions the program cannot
                        # reach, in code it does not own, and its body names
                        # siblings nothing demanded, so checking it reports
                        # valid references as unknown. `--eager` -- and so
                        # eager-guard, zls and `zl lint --full` -- checks
                        # everything regardless, which is the point of it.
                        # Asked HERE, not per member: resolvedByIds RESOLVES as
                        # it walks, so probing every member of every unit
                        # settles types this compile never needed.
                        if swDo when swHasBodies then {
                            swKeep: st.typing.eagerAll
                            if (swKeep) == false then {
                                uq9z: (unitDeclOfName
                                    :st
                                    nameId: (nameIdOf :ast name: swun.stringView)
                                )
                                swRo: (resolvedByIds
                                    :st
                                    :ast

                                    unitDecl: uq9z
                                    name: swm.name
                                )
                                match (
                                    swRo
                                ) case some then {
                                    swKeep = true
                                } case none then null
                            }
                            if (swKeep) == false then swDo = false
                        }
                        if swDo when swHasBodies then {
                            # the walked mark is what emission reads, so it is
                            # earned by a walk that can happen: resolve first,
                            # and a miss marks nothing.
                            ud5x: unitDeclOfNameOrOwn :st :frame nameId: swu.name
                            swTid: (forceUnitDef
                                :st
                                :frame

                                :ast
                                unitDecl: ud5x
                                memId: swmId
                            )
                            if swTid == 0 then swDo = false
                        }
                        if swDo when swHasBodies then {
                            st.typing.declSetWalked declId: swd
                            unitDecl911: (unitDeclOfNameOrOwn :st :frame nameId: swu.name)
                            (walkOwnerMethods
                                :st
                                :frame
                                unitDecl: unitDecl911
                                :ast
                                memId: swmId
                                name: swmn.stringView
                            )
                        }
                    }
                }
            }
        }
    }
}

# bindMonoParams -- scope-define one mono's type args under the template's
# param names, and fill monoParamSubst (param tid -> arg tid) for flat
# substitution at stamp time; the template's Decl is the one key.
bindMonoParams: function {
    st: zenv.ZSymbolTable
    monoId: ztypes.tid
} is {
    morig: ztypes.tid
    {
        mgo: st.reg.genericOriginOf tid: monoId
        if mgo > 0 then morig = mgo
    }
    tdecl: declOfTypeId :st tid: (ztypes.tid.create from: morig.u64)
    pn: st.reg.genericParamNamesOf :tdecl
    pc: pn.length
    pj: u64
    for pj < pc loop {
        if (st.reg.genericArgIsValueAt specId: monoId ordinal: pj) == false then {
            av: st.reg.genericArgAt specId: monoId ordinal: pj
            if av > 0 then {
                pnm: (pn.get i: pj)
                (st.define
                    nameId: pnm
                    ztypeId: (ztypes.tid.create from: av.u64)
                )
                pto: st.reg.genericParamTidOf :tdecl paramName: pnm
                match (
                    pto
                ) case some then {
                    sv: av
                    (st.typing.monoParamSubst.set
                        key: (ztypes.tid.create from: pto.u64)
                        value: (ztypes.tid.create from: sv.u64)
                    )
                } case none then null
            }
        }
        pj = pj + 1
    }
}

# stampMonoTemplateFn -- stamp-walk every registry mono of one generic free
# function template against the TEMPLATE body (mirrors emitFnMonoInstances'
# enumeration: FUNCTION types whose generic origin is the template).
stampMonoTemplateFn: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    fnOpId: u32
    templateFnId: u64
} is {
    last: st.reg.nextTypeId
    t: 1.u64
    for t < last loop {
        isMono: false
        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: t.u64)) == ztypes.ztypetype.functionType then {
            {
                go: st.reg.genericOriginOf tid: (ztypes.tid.create from: t.u64)
                if go.u64 == templateFnId when go > 0 then isMono = true
            }
        }
        if isMono then {
            (stampOneFnMono
                :st
                :frame
                :ast
                :unitDecl
                :fnOpId
                monoId: (ztypes.tid.create from: t.u64)
            )
        }
        t = t + 1
    }
}

# stampOneFnMono -- the instance walk for one free-function mono: args bound,
# params bound through the mono FUNCTION's substituted children, stamps into
# the side table under the mono FUNCTION tid (the emitter's curThisTid for
# fn-mono re-walks).
stampOneFnMono: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    fnOpId: u32
    monoId: ztypes.tid
} is {
    monoNm: st.reg.nameOf tid: monoId
    prevSup: st.typing.suppressParamStamps
    st.typing.suppressParamStamps = true
    sn: "fngeneric:\{monoNm}"
    st.push name: sn.stringView parent: frame
    st.typing.monoParamSubst = (IdMapV ztypes.tid v: ztypes.tid)
    {
        bindMonoParams :st :monoId
    }
    st.typing.curMonoStamp = monoId
    st.typing.curMonoFnTid = monoId
    prevL: st.typing.synthLabel.copy
    prevL9U: st.typing.synthOwnerUnit
    prevL9N: st.typing.synthOwnerName
    prevT: st.typing.currentThisTid
    tplDecl29Org: st.reg.genericOriginOf tid: monoId
    fnTemplateDecl: declOfTypeId :st tid: tplDecl29Org
    cfbFr: fnRefAt :ast nid: (zast.nodeid.create from: fnOpId.u32)
    (checkFunctionBody
        :st
        :frame
        :unitDecl
        defName: monoNm.stringView
        fn: cfbFr
        thisName: ""
        thisTid: ztypes.tid
        :ast
        declId: fnTemplateDecl
    )
    st.typing.synthLabel = prevL
    st.typing.synthOwnerUnit = prevL9U
    st.typing.synthOwnerName = prevL9N
    st.typing.currentThisTid = prevT
    st.typing.curMonoFnTid = ztypes.tid.create from: 0
    st.typing.curMonoStamp = 0
    st.typing.suppressParamStamps = prevSup
    st.typing.monoParamSubst = (IdMapV ztypes.tid v: ztypes.tid)
    st.pop
}

# stampMonoTemplateClass -- resolve one generic class/record template and
# stamp-walk every registry mono minted from it (mirrors emitRecordMethods'
# generic leg + emitClassMonoMethods' enumeration).
stampMonoTemplateClass: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    clsName: StringView
    clsOpId: u32
} is {
    isCand: false
    {
        cop: ast.nodes.get i: clsOpId.u64
        if cop.objectdef then isCand = true
    }
    if (isCand) == false then return
    if (objectdefIsGeneric :ast o: (ast.nodes.get i: clsOpId.u64)) == false then return
    if (objectdefHasMethodBodies :ast op: (ast.nodes.get i: clsOpId.u64)) == false then return
    templateTid: u64
    {
        tro: (resolvedByIds
            :st
            :ast

            :unitDecl
            name: (zast.poolFind pool: ast.names text: clsName)
        )
        match (
            tro
        ) case some then {
            templateTid = tro
        } case none then null
    }
    if templateTid == 0 then return
    last: st.reg.nextTypeId
    t: 1.u64
    for t < last loop {
        isMono: false
        {
            go: st.reg.genericOriginOf tid: (ztypes.tid.create from: t.u64)
            if go.u64 == templateTid when go > 0 then isMono = true
        }
        if isMono then {
            (stampOneClassMono
                :st
                :frame
                :ast
                :unitDecl
                :clsOpId
                monoId: (ztypes.tid.create from: t.u64)
            )
        }
        t = t + 1
    }
}

# stampOneClassMono -- the instance walk for one class/record mono: type args
# bound, each template method body re-checked with `this` typed as the mono
# and params bound through the mono's substituted method children.
stampOneClassMono: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    clsOpId: u32
    monoId: ztypes.tid
} is {
    monoNm: st.reg.nameOf tid: monoId
    prevSup: st.typing.suppressParamStamps
    st.typing.suppressParamStamps = true
    sn: "classgeneric:\{monoNm}"
    st.push name: sn.stringView parent: frame
    st.typing.monoParamSubst = (IdMapV ztypes.tid v: ztypes.tid)
    {
        bindMonoParams :st :monoId
    }
    mNames: (List String)
    mOps: (ListVal u32)
    {
        cop: ast.nodes.get i: clsOpId.u64
        match (
            cop
        ) case objectdef then {
            iit: cop.isItems.iterate
            for imId: iit loop {
                im: ast.nodes.get i: imId.u64
                match (
                    im
                ) case namedoperation then {
                    if (isFunctionDefWithBody o: (ast.nodes.get i: im.operation.u64)) then {
                        mNames.append (zast.nameTextCopy :ast ref: im.name)
                        mOps.append im.operation
                    }
                } else null
            }
            ait: cop.asItems.iterate
            for amId: ait loop {
                am: ast.nodes.get i: amId.u64
                match (
                    am
                ) case namedoperation then {
                    if (isFunctionDefWithBody o: (ast.nodes.get i: am.operation.u64)) then {
                        mNames.append (zast.nameTextCopy :ast ref: am.name)
                        mOps.append am.operation
                    }
                } else null
            }
        } else null
    }
    st.typing.curMonoStamp = monoId
    prevL: st.typing.synthLabel.copy
    prevL9U: st.typing.synthOwnerUnit
    prevL9N: st.typing.synthOwnerName
    prevT: st.typing.currentThisTid
    mi: u64
    for mi < mNames.length loop {
        mnm: (mNames.get i: mi)
        mop: mOps.get i: mi
        mi = mi + 1
        mfo: st.typing.declChildOf pool: ast.names parentTypeId: monoId name: mnm.stringView
        match (
            mfo
        ) case some then {
            st.typing.curMonoFnTid = ztypes.tid.create from: mfo.u64
        } case none then {
            st.typing.curMonoFnTid = ztypes.tid.create from: 0
        }
        q: "\{monoNm}.\{mnm}"
        tplDecl39Org: st.reg.genericOriginOf tid: monoId
        classTemplateDecl: declOfTypeId :st tid: tplDecl39Org
        cfbFr: fnRefAt :ast nid: (zast.nodeid.create from: mop.u32)
        (checkFunctionBody
            :st
            :frame
            :unitDecl
            defName: q.stringView
            fn: cfbFr
            thisName: monoNm.stringView
            thisTid: monoId
            :ast
            declId: classTemplateDecl
        )
    }
    st.typing.synthLabel = prevL
    st.typing.synthOwnerUnit = prevL9U
    st.typing.synthOwnerName = prevL9N
    st.typing.currentThisTid = prevT
    st.typing.curMonoFnTid = ztypes.tid.create from: 0
    st.typing.curMonoStamp = 0
    st.typing.suppressParamStamps = prevSup
    st.typing.monoParamSubst = (IdMapV ztypes.tid v: ztypes.tid)
    st.pop
}

# stampUnitMonoTemplates -- post-sweep: re-walk each generic-unit template's
# method bodies once per monomorphised instance, instance type args bound in
# scope, every stamp routed into the mono side table (stampGate's
# curMonoStamp mode, flat param->arg substitution via monoParamSubst). The
# emitter's per-instance template re-walk reads the table (monoStampIdOf)
# where the global table is param-suppressed. Runs under suppressParamStamps
# so its scopes/entries stay out of the dump log; skipped when diagnostics
# exist (nothing will be emitted).
# stampUnitMonoMembers -- the generic templates a unit's body declares, at any
# depth. A unit is a scope, and a scope nests: a template declared inside a
# plain unit inside another one is still a template, so a non-generic member
# unit is descended into rather than skipped. Reached only through
# stampUnitMonoTemplates, which supplies the file unit that both the templates
# and their instance bodies resolve against.
stampUnitMonoMembers: function {
    st: zenv.ZSymbolTable
    program: zast.ProgramData
    unitDecl: ztypes.declid
    frame: ztypes.declid
    unitOpId: zast.nodeid
} is {
    ibody: zast.unitBodyIdsAt ast: program.ast unitId: unitOpId
    ibn: ibody.length
    ibi: u64
    for ibi < ibn loop {
        imId: ibody.get i: ibi
        ibi = ibi + 1
        imOp: zast.nodeid
        imNm: String
        fnOp: u32
        fnNm: String
        clsOp: u32
        clsNm: String
        {
            im: program.ast.nodes.get i: imId.u64
            if im.namedoperation then {
                if (isUnitOp op: (program.ast.nodes.get i: im.operation.u64)) then {
                    imOp = im.operation
                    imNm = (zast.poolTextCopy
                        pool: program.ast.names
                        ref: im.name
                    )
                } else {
                    if (isFunctionDefWithBody o: (program.ast.nodes.get i: im.operation.u64)) then {
                        fnOp = im.operation
                        fnNm = (zast.poolTextCopy
                            pool: program.ast.names
                            ref: im.name
                        )
                    } else {
                        opn2: program.ast.nodes.get i: im.operation.u64
                        if opn2.objectdef then {
                            clsOp = im.operation
                            clsNm = (zast.poolTextCopy
                                pool: program.ast.names
                                ref: im.name
                            )
                        }
                    }
                }
            }
        }
        if imOp > 0 then {
            if (unitDefIsGeneric ast: program.ast oId: imOp) then {
                (stampMonoTemplateUnit
                    :st
                    :frame
                    ast: program.ast
                    :unitDecl
                    templateName: imNm.stringView
                    unitOpId: imOp
                )
            } else {
                stampUnitMonoMembers :st :frame :program :unitDecl unitOpId: imOp
            }
        }
        if fnOp > 0 then {
            fnTid: u64
            {
                fuUid: unitNameIdOf :st :unitDecl
                fnNmId: nameIdOf ast: program.ast name: fnNm.stringView
                uq10z: unitDeclOfName :st nameId: fuUid
                fro: (resolvedByIds
                    :st
                    ast: program.ast

                    unitDecl: uq10z
                    name: fnNmId
                )
                match (
                    fro
                ) case some then {
                    fnTid = fro
                } case none then null
            }
            isGenFn: false
            if fnTid > 0 then {
                if (st.reg.typetypeOf typeId: (ztypes.tid.create from: fnTid.u64)) == ztypes.ztypetype.functionType then {
                    {
                        isgeneric9v: st.reg.isGenericOf tid: (ztypes.tid.create from: fnTid.u64)
                            if isgeneric9v then isGenFn = true
                    }
                }
            }
            if isGenFn then {
                (stampMonoTemplateFn
                    :st
                    :frame
                    ast: program.ast
                    :unitDecl
                    fnOpId: fnOp
                    templateFnId: fnTid
                )
            }
        }
        if clsOp > 0 then {
            (stampMonoTemplateClass
                :st
                :frame
                ast: program.ast
                :unitDecl
                clsName: clsNm.stringView
                clsOpId: clsOp
            )
        }
    }
}

stampUnitMonoTemplates: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    program: zast.ProgramData
} is {
    if st.typing.errors.length > 0 then return
    {
        uCnt: program.ast.units.length
        uIdx: u64
        for uIdx < uCnt loop {
            uId: (zast.nodeid.create from: (program.ast.units.get i: uIdx))
            uIdx = uIdx + 1
            uOp: zast.nodeid
            uNm: String
            {
                u: program.ast.nodes.get i: uId.u64
                if u.namedoperation then {
                    uNm = zast.poolTextCopy pool: program.ast.names ref: u.name
                    uOp = u.operation
                }
            }
            if uOp > 0 then {
                uDecl9: (unitDeclOfNameOrOwn
                    :st
                    :frame
                    nameId: (nameIdOf ast: program.ast name: uNm.stringView)
                )
                if (unitDefIsGeneric ast: program.ast oId: uOp) then {
                    (stampMonoTemplateUnit
                        :st
                        :frame
                        ast: program.ast
                        unitDecl: uDecl9
                        templateName: uNm.stringView
                        unitOpId: uOp
                    )
                } else {
                    (stampUnitMonoMembers
                        :st
                        :frame
                        :program
                        unitDecl: uDecl9
                        unitOpId: uOp
                    )
                }
            }
        }
    }
}

# stampMonoTemplateUnit -- resolve one generic template unit (file-level by
# unit name, inline by its def-node stamp), then stamp-walk every registry
# mono minted from it.
stampMonoTemplateUnit: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    templateName: StringView
    unitOpId: zast.nodeid
} is {
    tplId: u64
    {
        tk: templateName
        tgo: (declTypeIdOf
            :st
            declId: (st.typing.declFindChild
                parentDeclId: st.typing.programRoot
                nameId: (nameIdOf :ast name: tk)
            )
        )
        if (tgo.isZero) == false then tplId = tgo
    }
    if tplId == 0 then {
        rid: u32
        {
            tuo: ast.nodes.get i: unitOpId.u64
            if tuo.unitdef then rid = tuo.nodeid
        }
        if rid > 0 then {
            sgo: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: rid.u64
            if sgo > 0 then tplId = sgo
        }
    }
    if tplId == 0 then return
    last: st.reg.nextTypeId
    t: 1.u64
    for t < last loop {
        isMono: false
        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: t.u64)) == ztypes.ztypetype.unitType then {
            {
                go: st.reg.genericOriginOf tid: (ztypes.tid.create from: t.u64)
                if go.u64 == tplId when go > 0 then isMono = true
            }
        }
        if isMono then {
            (stampOneUnitMono
                :st
                :frame
                :ast
                :unitDecl
                :unitOpId
                monoId: (ztypes.tid.create from: t.u64)
            )
        }
        t = t + 1
    }
}

# stampOneUnitMono -- the instance walk: bind the mono's type args (scope
# defines + monoParamSubst), then re-check each template method body with
# curMonoStamp routing stamps into the side table.
stampOneUnitMono: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    unitOpId: zast.nodeid
    monoId: ztypes.tid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitOpId
    monoNm: st.reg.nameOf tid: monoId
    prevSup: st.typing.suppressParamStamps
    st.typing.suppressParamStamps = true
    sn: "unitgeneric:\{monoNm}"
    st.push name: sn.stringView parent: frame
    st.typing.monoParamSubst = (IdMapV ztypes.tid v: ztypes.tid)
    {
        bindMonoParams :st :monoId
    }
    idxs: (ListVal u64)
    {
        di: u64
        with biter: bodyIds.iterate do for bmId: biter loop {
            bm: argRefAt :ast nid: (zast.nodeid.create from: bmId.u32)
            if (bm.nid.isZero) == false then {
                if (isFunctionDefWithBody o: (ast.nodes.get i: bm.operation.u64)) then {
                    dv: di
                    idxs.append dv
                }
            }
            di = di + 1
        }
    }
    st.typing.curMonoStamp = monoId
    prevL: st.typing.synthLabel.copy
    prevL9U: st.typing.synthOwnerUnit
    prevL9N: st.typing.synthOwnerName
    prevT: st.typing.currentThisTid
    wi: u64
    for wi < idxs.length loop {
        bidx: idxs.get i: wi
        wi = wi + 1
        bmId2: bodyIds.get i: bidx
        bm2: argRefAt :ast nid: (zast.nodeid.create from: bmId2.u32)
        if (bm2.nid.isZero) == false then {
            # an owned copy: the walks below lend ast
            mnm: zast.nameTextCopy :ast ref: bm2.name
            q: "\{monoNm}.\{mnm}"
            mfo: (st.typing.declChildOf
                pool: ast.names
                parentTypeId: monoId
                name: mnm.stringView
            )
            match (
                mfo
            ) case some then {
                st.typing.curMonoFnTid = ztypes.tid.create from: mfo.u64
            } case none then {
                st.typing.curMonoFnTid = ztypes.tid.create from: 0
            }
            tplDecl49Org: st.reg.genericOriginOf tid: monoId
            unitTemplateDecl: declOfTypeId :st tid: tplDecl49Org
            cfbFr: fnRefAt :ast nid: (zast.nodeid.create from: bm2.operation.u32)
            (checkFunctionBody
                :st
                :frame
                :unitDecl
                defName: q.stringView
                fn: cfbFr
                thisName: ""
                thisTid: ztypes.tid
                :ast
                declId: unitTemplateDecl
            )
        }
    }
    st.typing.synthLabel = prevL
    st.typing.synthOwnerUnit = prevL9U
    st.typing.synthOwnerName = prevL9N
    st.typing.currentThisTid = prevT
    st.typing.curMonoFnTid = ztypes.tid.create from: 0
    st.typing.curMonoStamp = 0
    st.typing.suppressParamStamps = prevSup
    st.typing.monoParamSubst = (IdMapV ztypes.tid v: ztypes.tid)
    st.pop
}

# foldLiteralStamps -- replace literal-typed node stamps with their concrete
# defaults (i64 / f64) after the body walk: the unregistered pseudo ids and the
# data blocks' registered intliteral/floatliteral element shells. Symbol-table
# entries keep their literal ids.
foldLiteralStamps: function {st: zenv.ZSymbolTable frame: ztypes.declid program: Node} is {
    match (
        program
    ) case program then {
        unitDecl: (unitDeclOfNameOrOwn
            :st
            :frame
            nameId: (nameIdOf ast: program.ast name: program.mainUnitName.stringView)
            )
        intId: u64
        li: (walkLookupTyperef
            :st
            :frame
            ast: program.ast

            :unitDecl
            base: "i64"
        )
        match (
            li
        ) case some then {
            intId = li
        } case none then null
        floatId: u64
        lf: (walkLookupTyperef
            :st
            :frame
            ast: program.ast

            :unitDecl
            base: "f64"
        )
        match (
            lf
        ) case some then {
            floatId = lf
        } case none then null
        nn: st.typing.nodeType.length
        ni: u64
        for ni < nn loop {
            fv: st.typing.nodeType.get i: ni
            if fv > 0 then {
                isInt: fv == st.reg.literalIntTid
                isFloat: fv == st.reg.literalFloatTid
                if isInt when intId > 0 then {
                    (ztyping.nodeTypeSet
                        tbl: st.typing.nodeType
                        nid: ni
                        tid: (ztypes.tid.create from: intId.u64)
                    )
                }
                if isFloat when floatId > 0 then {
                    (ztyping.nodeTypeSet
                        tbl: st.typing.nodeType
                        nid: ni
                        tid: (ztypes.tid.create from: floatId.u64)
                    )
                }
            }
            ni = ni + 1
        }
    } else null
}

# isBinopNode -- kind test without narrowing (the caller keeps the Node handle).
isBinopNode: function {n: Node.view} out bool is {
    match (
        n
    ) case binop then {
        return true
    } else {
        return false
    }
}

# constantOperandType -- type one operand of a unit-level constant expression,
# stamping as it walks: a numeric literal wears the pseudo id (folded to its
# visible default later), a name reads an already-materialised constant from
# resolved (body order), and a binop takes the first concretely-typed operand
# (else the literal pseudo). 0 = not a constant shape.
constantOperandType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nid: zast.nodeid
} out u64 is {
    # the row is read through a view scoped to this block (1 expression,
    # 2 atomid, 3 binop, 0 anything else): the lookups and operand walks
    # below lend ast exclusively
    arm: u32
    innerId: zast.nodeid
    nameId: zast.nameid
    lhsId: zast.nodeid
    rhsId: zast.nodeid
    opId: zast.nodeid
    {
        n: ast.nodes.get i: nid.u64
        match (
            n
        ) case expression then {
            arm = 1
            innerId = n.expression
        } case atomid then {
            arm = 2
            nameId = n.name
        } case binop then {
            arm = 3
            lhsId = n.lhs
            rhsId = n.rhs
            opId = n.operator
        } else null
    }
    if arm == 1 then return (constantOperandType :st :frame :ast :unitDecl nid: innerId)
    if arm == 2 then return (constantAtomType :st :frame :ast :unitDecl :nid :nameId)
    if arm == 3 then return (constantBinopType :st :frame :ast :unitDecl :nid :lhsId :rhsId :opId)
    return 0
}

# constantAtomType -- a bare atom's constant type: a numeric literal's
# literal type, else the type the name resolves to; stamped on the atom.
constantAtomType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nid: zast.nodeid
    nameId: zast.nameid
} out u64 is {
    result: u64
    # an owned copy: the lookup below lends ast
    trN: zast.nameTextCopy :ast ref: nameId
    if (isNumericLiteralName name: trN.stringView) then {
        if (isFloatLiteralName name: trN.stringView) then {
            result = st.reg.literalFloatTid
        } else {
            result = st.reg.literalIntTid
        }
    } else {
        ro: walkLookupTyperef :st :frame :ast :unitDecl base: trN.stringView
        match (
            ro
        ) case some then {
            result = ro
        } case none then null
    }
    if result > 0 then {
        (ztyping.nodeTypeSet
            tbl: st.typing.nodeType
            nid: nid.u64
            tid: (ztypes.tid.create from: result.u64)
        )
    }
    return result
}

# constantBinopType -- a binop's constant type: a comparison is bool and a
# literal operand coerces (restamps) at the concrete side's type; otherwise
# the operands' type, a concrete side winning over a literal one.
constantBinopType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nid: zast.nodeid
    lhsId: zast.nodeid
    rhsId: zast.nodeid
    opId: zast.nodeid
} out u64 is {
    lt: constantOperandType :st :frame :ast :unitDecl nid: lhsId
    rt: constantOperandType :st :frame :ast :unitDecl nid: rhsId
    # an owned copy: the bool lookup below lends ast
    opn: zast.nameTextCopy :ast ref: (atomNameId :ast n: (ast.nodes.get i: opId.u64))
    if (isComparisonOp name: opn.stringView) then {
        return (constantCompareType :st :frame :ast :unitDecl :nid :lhsId :rhsId :lt :rt)
    }
    result: lt
    if lt == 0 then result = rt
    if lt == st.reg.literalIntTid then {
        if rt > 0 when rt != st.reg.literalIntTid when rt != st.reg.literalFloatTid then result = rt
    }
    if lt == st.reg.literalFloatTid then {
        if rt > 0 when rt != st.reg.literalIntTid when rt != st.reg.literalFloatTid then result = rt
    }
    if result > 0 then {
        (ztyping.nodeTypeSet
            tbl: st.typing.nodeType
            nid: nid.u64
            tid: (ztypes.tid.create from: result.u64)
        )
    }
    return result
}

# constantCompareType -- a comparison condition: the result is bool and a
# literal operand coerces (restamps) at the concrete side's type.
constantCompareType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nid: zast.nodeid
    lhsId: zast.nodeid
    rhsId: zast.nodeid
    lt: u64
    rt: u64
} out u64 is {
    lLit: false
    if lt == st.reg.literalIntTid then lLit = true
    if lt == st.reg.literalFloatTid then lLit = true
    rLit: false
    if rt == st.reg.literalIntTid then rLit = true
    if rt == st.reg.literalFloatTid then rLit = true
    conc: u64
    if (lLit) == false then {
        if lt > 0 then conc = lt
    }
    if conc == 0 then {
        if (rLit) == false then {
            if rt > 0 then conc = rt
        }
    }
    if lLit when conc > 0 then {
        lid: innermostNodeId :ast n: (ast.nodes.get i: lhsId.u64)
        if lid > 0 then {
            (ztyping.nodeTypeSet
                tbl: st.typing.nodeType
                nid: lid.u64
                tid: (ztypes.tid.create from: conc.u64)
            )
        }
    }
    if rLit when conc > 0 then {
        rid: innermostNodeId :ast n: (ast.nodes.get i: rhsId.u64)
        if rid > 0 then {
            setr: conc
            (ztyping.nodeTypeSet
                tbl: st.typing.nodeType
                nid: rid.u64
                tid: (ztypes.tid.create from: setr.u64)
            )
        }
    }
    bres: u64
    bo: walkLookupTyperef :st :frame :ast :unitDecl base: "bool"
    match (
        bo
    ) case some then {
        bres = bo
        (ztyping.nodeTypeSet
            tbl: st.typing.nodeType
            nid: nid.u64
            tid: (ztypes.tid.create from: bres.u64)
        )
    } case none then null
    return bres
}

# constantBranchWalk -- walk one unit-level-if branch block: each statement's
# expression types through the constant walk; literal results materialise to
# their defaults (i64/f64) on the statement, its expression wrapper, and the
# atom. Returns the (materialised) last-statement type.
# constantLineType -- one statement line of a unit-level-if branch: the
# expression's constant type, stamped on the line, its expression wrapper
# and its atom; a literal result materialises to its default (i64/f64).
# 0 when the line has no constant type.
constantLineType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    s9Id: u32
    innerId: zast.nodeid
} out u64 is {
    bt0: constantOperandType :st :frame :ast :unitDecl nid: innerId
    mt0: u64
    if bt0 == st.reg.literalIntTid then {
        mt0 = (optU64Or
            o: (walkLookupTyperef :st :frame :ast :unitDecl base: "i64")
            d: 0
        )
    }
    if bt0 == st.reg.literalFloatTid then {
        mt0 = (optU64Or
            o: (walkLookupTyperef :st :frame :ast :unitDecl base: "f64")
            d: 0
        )
    }
    if mt0 > 0 then {
        (ztyping.nodeTypeSet
            tbl: st.typing.nodeType
            nid: s9Id.u64
            tid: (ztypes.tid.create from: mt0.u64)
        )
        eid0: nodeId n: (ast.nodes.get i: innerId.u64)
        if eid0 > 0 then {
            (ztyping.nodeTypeSet
                tbl: st.typing.nodeType
                nid: eid0.u64
                tid: (ztypes.tid.create from: mt0.u64)
            )
        }
        iid0: innermostNodeId :ast n: (ast.nodes.get i: innerId.u64)
        if iid0 > 0 then {
            (ztyping.nodeTypeSet
                tbl: st.typing.nodeType
                nid: iid0.u64
                tid: (ztypes.tid.create from: mt0.u64)
            )
        }
        return mt0
    } else {
        if bt0 > 0 then {
            (ztyping.nodeTypeSet
                tbl: st.typing.nodeType
                nid: s9Id.u64
                tid: (ztypes.tid.create from: bt0.u64)
            )
            return bt0
        }
    }
    return 0
}

constantBranchWalk: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nid: zast.nodeid
} out u64 is {
    # the block's line ids are read through views scoped to blocks: the
    # operand walk and the literal-default lookups lend ast exclusively
    isStmt: false
    lineIds: (ListVal u32)
    {
        block: ast.nodes.get i: nid.u64
        match (
            block
        ) case statement then {
            isStmt = true
            with sit: block.statements.iterate do for s: sit loop lineIds.append from: s
        } else null
    }
    if (isStmt) == false then return 0
    result: u64
    with lit: lineIds.iterate do for s9Id: lit loop {
        innerId: zast.nodeid
        {
            s: ast.nodes.get i: s9Id.u64
            match (
                s
            ) case statementline then {
                innerId = s.statementline
            } else null
        }
        if (innerId.isZero) == false then {
            lt: constantLineType :st :frame :ast :unitDecl :s9Id :innerId
            if lt > 0 then result = lt
        }
    }
    return result
}

# resolveUnitIfDef -- a unit-level `if` definition (compile-time conditional):
# conditions walk through the constant machinery (comparisons stamp bool and
# coerce literal operands), branches walk + materialise, and the definition
# resolves to the first branch's type -- stamped on the If, its Expression
# wrapper, and resolved[unit.name].
resolveUnitIfDef: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    wrapperId: u32
    nid: zast.nodeid
} is {
    # the row is read through a view scoped to this block: the clause walks
    # and the fold below lend ast exclusively
    isIf: false
    clauseIds: (ListVal u32)
    elseId: zast.nodeid
    {
        n: ast.nodes.get i: nid.u64
        match (
            n
        ) case ifexpr then {
            isIf = true
            with cit: n.clauses.iterate do for c: cit loop clauseIds.append from: c
            elseId = n.elseclause
        } else null
    }
    if isIf then {
        t: u64
        # every clause is still walked and typed -- a dead branch's type errors
        # are still type errors -- but the definition takes the type of the
        # branch that WINS, per the spec's "the type of the first arm whose
        # condition is true". `w` is that type; `t` stays the first-typed
        # fallback for an `if` whose conditions did not fold.
        w: u64
        fb: foldIfBranch :st :frame :ast :unitDecl :nid
        with cliter: clauseIds.iterate do for clauseId: cliter loop {
            # the clause and its conditions are read through views scoped to
            # blocks: the operand walks lend ast exclusively
            isClause: false
            condIds: (ListVal u32)
            stmtId: zast.nodeid
            {
                clause: ast.nodes.get i: clauseId.u64
                match (
                    clause
                ) case ifclause then {
                    isClause = true
                    with coit: clause.conditions.iterate do for c: coit loop condIds.append from: c
                    stmtId = clause.statement
                } else null
            }
            if isClause then {
                with coiter: condIds.iterate do for condId: coiter loop {
                    opId: zast.nodeid
                    {
                        cond: ast.nodes.get i: condId.u64
                        match (
                            cond
                        ) case namedoperation then {
                            opId = cond.operation
                        } else null
                    }
                    if (opId.isZero) == false then {
                        constantOperandType :st :frame :ast :unitDecl nid: opId
                    }
                }
                bt: constantBranchWalk :st :frame :ast :unitDecl nid: stmtId
                if t == 0 then t = bt
                if fb.known when stmtId == fb.stmt then w = bt
            }
        }
        if elseId > 0 then {
            et: constantBranchWalk :st :frame :ast :unitDecl nid: elseId
            if t == 0 then t = et
            if fb.known when elseId == fb.stmt then w = et
        }
        if fb.known when w > 0 then t = w
        if t > 0 then {
            (ztyping.nodeTypeSet
                tbl: st.typing.nodeType
                nid: wrapperId.u64
                tid: (ztypes.tid.create from: t.u64)
            )
            (ztyping.nodeTypeSet
                tbl: st.typing.nodeType
                nid: nid.u64
                tid: (ztypes.tid.create from: t.u64)
            )
            cu: (declTypeIdOf
                :st
                declId: unitDecl
            )
            if (cu.isZero) == false then {
                (st.typing.setMemberType
                    parentTypeId: (ztypes.tid.create from: cu.u64)
                    nameId: (zast.poolFind pool: ast.names text: defName)
                    childTypeId: t
                )
            }
        }
    }
}

# --- compile-time constant evaluation ---
#
# evalConstNode walks a constant expression once and yields a cval;
# constValueOfMember pulls the value
# of a NAMED constant on demand and memoises it. On demand rather than in source
# order because definitions are not written in dependency order and units are
# not visited in dependency order: `B: A + 2` may precede `A: 1`, and a
# `require:` block in one unit reads a constant declared in another.

# reportConstError -- the E0600 diagnostic: the compiler was asked for a value
# at compile time and could not produce one. One code for the whole category
# with a distinct message per case, the way typeError carries its own. Distinct
# from E0500, which is the emitter reporting a construct it cannot emit.
reportConstError: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u32
    msg: String
    hint: String
} is {
    nameCount: "a unit constant is evaluated at compile time".string
    st.typing.errors.append (zast.ErrorData
        :nodeid
        :lineno
        :colno
        :width
        err: zast.err.constError
        msg: msg.copy
        fsno: zvfs.fsno
        note: nameCount
        hint: hint.copy
    )
    st.typing.isError = true
}

# constFailClear -- drop any pending failure. Called before a pull that will
# render, and after one that will not, so a failure recorded for a body branch
# can never be attributed to the next definition.
constFailClear: function {st: zenv.ZSymbolTable} is {
    st.typing.constFail = ztypes.noConstFail
}

# constFailRecord -- the evaluator's way of saying "there is no value, and this
# is why". FIRST failure wins: the innermost one is the specific one, and an
# outer operand walk that fails afterwards would only say "an operand did not
# fold", which the caller already knows.
constFailRecord: function {
    st: zenv.ZSymbolTable
    kind: ztypes.constfailkind
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u32
    strId: 0.u32
} is {
    if (st.typing.constFail.kind.none) == false then return
    st.typing.constFail = (ztypes.constfail
        :kind
        :nodeid
        :lineno
        :colno
        :width
        :strId
    )
}

# reportPendingConstFail -- render the recorded failure, if any, and clear it.
# Only a caller that REQUIRED a value calls this: a unit-level definition, a
# `require:` block. A body fold never does, which is what keeps an unfoldable
# body condition an ordinary runtime branch instead of an error.
reportPendingConstFail: function {st: zenv.ZSymbolTable} is {
    f: st.typing.constFail
    if f.kind.none then return
    constFailClear :st
    if f.kind.reachedError then {
        # E0601: the program itself asserting, in the user's own words. Not an
        # E0600 -- the evaluator worked, and what it found was a reached
        # `error`.
        um: constStringAt :st id: f.strId
        uh: "the compiler proved this `error` reachable".string
        st.typing.errors.append (zast.ErrorData
            nodeid: f.nodeid
            lineno: f.lineno
            colno: f.colno
            width: f.width
            err: zast.err.userError
            msg: um.copy
            fsno: zvfs.fsno
            note: "".string
            hint: uh
        )
        st.typing.isError = true
        return
    }
    noMethodMsg: String
    hintText: String
    if f.kind.interp then {
        noMethodMsg = "an interpolated string has no compile-time value".string
        hintText = "interpolation reads its parts at run time; use a plain literal".string
    }
    if f.kind.overflow then {
        noMethodMsg = "constant integer operation overflows".string
        hintText = "the compile-time evaluator works in i64; this result does not fit".string
    }
    if f.kind.divZero then {
        noMethodMsg = "division by a constant zero".string
        hintText = "the divisor is a compile-time constant equal to 0".string
    }
    if f.kind.cycle then {
        nameCount: constStringAt :st id: f.strId
        noMethodMsg = "constant '\{nameCount}' is defined in terms of itself"
        hintText = "a unit constant may only read constants that do not read it back".string
    }
    if f.kind.unsupportedMethod then {
        mn: constStringAt :st id: f.strId
        noMethodMsg = "'\{mn}' has no compile-time value"
        hintText = "a string constant may use length, startsWith, endsWith, contains and substring".string
    }
    if f.kind.substringRange then {
        noMethodMsg = "constant 'substring' range is out of bounds".string
        hintText = "from and to must satisfy from <= to <= length; the run-time call panics".string
    }
    if noMethodMsg.length == 0 then return
    (reportConstError
        :st
        nodeid: f.nodeid
        lineno: f.lineno
        colno: f.colno
        width: f.width
        msg: noMethodMsg
        hint: hintText
    )
}

# constLiteralValue -- a numeric literal lexeme as a value, parsed through the
# same parseI64 / parseF64 the emitter's fold uses so the two cannot disagree
# about what a literal means. A magnitude outside i64 reads as "not a constant"
# rather than as a wrapped one.
constLiteralValue: function {name: StringView} out ztypes.cval is {
    if (isFloatLiteralName :name) then {
        pf: name.parseF64
        match (
            pf
        ) case ok then {
            return (ztypes.makeFloatConst pf)
        } case err then {
            return ztypes.noConst
        }
    }
    pi: name.parseI64
    match (
        pi
    ) case ok then {
        return (ztypes.makeIntConst pi)
    } case err then {
        return ztypes.noConst
    }
}

# constInternString -- the id of `text` in ZTyping.constStrings. The scan
# starts past the sentinel row, so 0 keeps meaning "no string" and a genuine
# empty constant gets a row of its own. Interned rather than stored inline
# because a cval is a valtype and owns no heap; deduplicated by a linear scan,
# which is right for a table that holds a handful of entries.
constInternString: function {st: zenv.ZSymbolTable text: StringView} out u32 is {
    i: 1.u64
    n: st.typing.constStrings.length
    for i < n loop {
        e: st.typing.constStrings.get :i
        if e.stringView == text then return i.u32.orPanic
        i = i + 1
    }
    id: st.typing.constStrings.length.u32.orPanic
    st.typing.constStrings.append text.string
    return id
}

# constStringAt -- the interned text a svalKind names; id 0 reads the sentinel
# row, which holds the empty text.
constStringAt: function {st: zenv.ZSymbolTable.view id: u32} out String is {
    # a list `get` hands back a NON-OWNING shallow copy; returning it as an
    # owned String hands the caller a buffer the pool still owns
    e: st.typing.constStrings.get i: id.u64
    return e.copy
}

# constFloatOf -- an integer or float value as an f64, for a mixed-kind binop.
# `has` false means the value is neither.
constFloatOf: function {v: ztypes.cval} out ffoldval is {
    if v.kind.fvalKind then return (ffoldval has: true val: v.fval)
    if v.kind.ivalKind then {
        cf: v.ival.f64
        match (
            cf
        ) case ok then {
            return (ffoldval has: true val: cf)
        } case err then {
            return (ffoldval has: false val: 0.0)
        }
    }
    return (ffoldval has: false val: 0.0)
}

# a float operand of a folded binop; `has` false = not a numeric value.
ffoldval: record {
    has: bool
    val: f64
}

# constArithInt -- fold an arithmetic operator over two integers. Reports the
# two failures the spec names: division by a constant zero, and a result the
# evaluator cannot represent. Overflow is checked against i64, the range the
# evaluator works in -- a value carries no target type until it materialises,
# so a narrower target's overflow is still the materialiser's business.
constArithInt: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    op: StringView
    a: i64
    b: i64
} out ztypes.cval is {
    mx: 9223372036854775807
    mn: (0 - 9223372036854775807) - 1
    ovk: ztypes.constfailkind.overflow
    if op == "+" then {
        if b > 0 when a > (mx - b) then {
            (constFailRecord :st kind: ovk :nodeid :lineno :colno width: 1)
            return ztypes.noConst
        }
        if b < 0 when a < (mn - b) then {
            (constFailRecord :st kind: ovk :nodeid :lineno :colno width: 1)
            return ztypes.noConst
        }
        return (ztypes.makeIntConst (a + b))
    }
    if op == "-" then {
        if b < 0 when a > (mx + b) then {
            (constFailRecord :st kind: ovk :nodeid :lineno :colno width: 1)
            return ztypes.noConst
        }
        if b > 0 when a < (mn + b) then {
            (constFailRecord :st kind: ovk :nodeid :lineno :colno width: 1)
            return ztypes.noConst
        }
        return (ztypes.makeIntConst (a - b))
    }
    if op == "*" then {
        if a == 0 then return (ztypes.makeIntConst 0)
        if b == 0 then return (ztypes.makeIntConst 0)
        # -fwrapv makes the product defined, so dividing it back is a valid
        # test; MIN * -1 wraps to itself and passes it, hence the pair below.
        bad: false
        if a == (0 - 1) when b == mn then bad = true
        if b == (0 - 1) when a == mn then bad = true
        r: a * b
        if (r / a) != b then bad = true
        if bad then {
            (constFailRecord :st kind: ovk :nodeid :lineno :colno width: 1)
            return ztypes.noConst
        }
        return (ztypes.makeIntConst r)
    }
    if op == "/" then {
        if b == 0 then {
            (constFailRecord
                :st
                kind: ztypes.constfailkind.divZero
                :nodeid
                :lineno
                :colno
                width: 1
            )
            return ztypes.noConst
        }
        if a == mn when b == (0 - 1) then {
            (constFailRecord :st kind: ovk :nodeid :lineno :colno width: 1)
            return ztypes.noConst
        }
        return (ztypes.makeIntConst (a / b))
    }
    return ztypes.noConst
}

# constCompareInt / constCompareFloat -- the six comparisons, yielding a bool
# value. Written twice rather than once over f64 because an i64 comparison must
# not lose precision by routing through a float.
# boolConst -- the folded truth value `v` as a constant naming one of bool's
# arms. bool is a variant like any other, so its constants are armKind ones:
# `true` is the arm bool declares second and `false` the arm it declares first,
# both read from what the checker recorded for the declaration rather than
# spelled here. noConst when bool is not in the program, or when its arms were
# not recorded -- an absent fold is a runtime branch, never a wrong one.
boolConst: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    v: bool
} out ztypes.cval is {
    bt: builtinTidT :st :frame :ast base: "bool"
    if bt.isZero then return ztypes.noConst
    nmNode: u64
    if v then {
        o: st.typing.sumPairSecondArm.get key: bt.u64
        match (
            o
        ) case some then {
            nmNode = o
        } case none then null
    } else {
        o8: st.typing.sumPairFirstArm.get key: bt.u64
        match (
            o8
        ) case some then {
            nmNode = o8
        } case none then null
    }
    if nmNode == 0 then return ztypes.noConst
    return (ztypes.makeArmConst armTid: bt armName: (zast.nameid.create from: nmNode.u32.orPanic))
}

constCompareInt: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    op: StringView
    a: i64
    b: i64
} out ztypes.cval is {
    if op == "==" then return (boolConst :st :frame :ast v: (a == b))
    if op == "!=" then return (boolConst :st :frame :ast v: (a != b))
    if op == "<" then return (boolConst :st :frame :ast v: (a < b))
    if op == "<=" then return (boolConst :st :frame :ast v: (a <= b))
    if op == ">" then return (boolConst :st :frame :ast v: (a > b))
    if op == ">=" then return (boolConst :st :frame :ast v: (a >= b))
    return ztypes.noConst
}

constCompareFloat: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    op: StringView
    a: f64
    b: f64
} out ztypes.cval is {
    if op == "==" then return (boolConst :st :frame :ast v: (a == b))
    if op == "!=" then return (boolConst :st :frame :ast v: (a != b))
    if op == "<" then return (boolConst :st :frame :ast v: (a < b))
    if op == "<=" then return (boolConst :st :frame :ast v: (a <= b))
    if op == ">" then return (boolConst :st :frame :ast v: (a > b))
    if op == ">=" then return (boolConst :st :frame :ast v: (a >= b))
    return ztypes.noConst
}

constArithFloat: function {op: StringView a: f64 b: f64} out ztypes.cval is {
    if op == "+" then return (ztypes.makeFloatConst (a + b))
    if op == "-" then return (ztypes.makeFloatConst (a - b))
    if op == "*" then return (ztypes.makeFloatConst (a * b))
    if op == "/" then return (ztypes.makeFloatConst (a / b))
    return ztypes.noConst
}

# constOwnerDeclFor -- the DECLARATION a constant named `defName` is a member
# of. A name written inside a namespace resolves against that namespace first
# and falls back to the file unit, which is the chain spec.pdoc describes for an
# inline unit. The TYPE and VALUE channels must agree about this, so both ask
# here rather than each deciding for itself -- and both facts the fold needs,
# the owner's type id and the constant's own def node, come off this one answer.
constOwnerDeclFor: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
} out ztypes.declid is {
    dn9: zast.poolFind pool: ast.names text: defName
    return (constOwnerDeclForId :st :frame :unitDecl nameId: dn9)
}

# constOwnerDeclForId -- the walk itself, asked BY ID. A caller that already
# holds the name id -- a use site does, the atom carries it -- would otherwise
# pay a pool search to hand over text this reduces straight back to an id.
constOwnerDeclForId: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    # the frames innermost outward from `frame`: a constant written inside
    # a unit is keyed on THAT unit, and on each unit enclosing it before the
    # file unit. Asking only the innermost left a constant of an enclosing
    # inline unit unreachable from a unit nested inside it.
    dnm: nameId
    cur: frameFor :st :frame :unitDecl
    for cur > 0 loop {
        if cur == st.typing.coreUnitRoot then {
            cur = ztypes.declid
        } else {
            nd: st.typing.declFindChild parentDeclId: cur nameId: dnm
            if (nd.isZero) == false then {
                ct: declTypeIdOf :st declId: cur
                if (ct.isZero) == false then return cur
            }
            cur = unitFrameOf :st declId: (declParentIdOf :st declId: cur)
        }
    }
    # nothing in the chain declares it: the file unit owns it, which is where a
    # constant reached before its own declaration was indexed is keyed
    return unitDecl
}

# constDefIsComputed -- the definition COMPUTES a value from others, as against
# the ALIAS forms (`Same: Holder`, `Node: zast.Node`) which name a type and are
# resolveDef's business. Only a computed definition can be self-referential in
# the constant sense: a ring of aliases is an alias cycle, and the resolver
# already reports that with its own diagnostic and its own wording.
constDefIsComputed: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (constDefIsComputed :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        return (isBinopNode :n)
    }
}

# constValueOfMemberTid -- the memoised compile-time value of a member of the
# unit whose type id is `unitTid`. A nested namespace has no unit-name index
# entry to reach it through, but resolveNamespaceUnit has already evaluated its
# members against this id, so the read is a pure lookup rather than a descent.
constValueOfMemberTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitTid: ztypes.tid
    defName: StringView
} out ztypes.cval is {
    if unitTid.isZero then return ztypes.noConst
    nid: zast.poolFind pool: ast.names text: defName
    if nid.isZero then return ztypes.noConst
    k: st.typing.memberConstKey parentTypeId: unitTid nameId: nid
    sg: st.typing.constEvalState.get key: k
    match (
        sg
    ) case some then {
        if sg == 2 then return (st.typing.memberConstOf parentTypeId: unitTid nameId: nid)
    } case none then null
    # not folded yet -- READING a constant is what folds it, so descend into
    # the owner's declaration and fold there, then read back. Without this a
    # constant that names another unit's constant sees a memo that nothing
    # filled.
    od: st.typing.declIdOfType typeId: unitTid
    if od.isZero then od = declOfTypeId :st tid: unitTid
    if od.isZero then return ztypes.noConst
    cd: st.typing.declFindChild parentDeclId: od nameId: nid
    if cd.isZero then return ztypes.noConst
    constFoldDecl :st :ast declId: cd
    return (st.typing.memberConstOf parentTypeId: unitTid nameId: nid)
}

# constValueOfMember -- the compile-time value of `unitDecl.defName`, evaluated
# on demand and memoised in memberConst. constEvalState carries the cycle
# guard: re-entering a member that is still evaluating is `A: B + 1` paired
# with `B: A + 1`, which has no value and must say so once rather than recur.
constValueOfMember: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
} out ztypes.cval is {
    dn9: zast.poolFind pool: ast.names text: defName
    return (constValueOfMemberId :st :frame :ast :unitDecl nameId: dn9)
}

# constValueOfMemberId -- the same pull, asked BY ID. The name is a pool id
# everywhere it matters: the owner walk compares ids, the child lookup compares
# ids, and the memo is keyed on one. Only a cycle diagnostic ever wants the
# text, and it reads it where it reports.
constValueOfMemberId: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nameId: zast.nameid
} out ztypes.cval is {
    nid: nameId
    if nid.isZero then return ztypes.noConst
    od: constOwnerDeclForId :st :frame :unitDecl :nameId
    if od.isZero then return ztypes.noConst
    # the constant's own declaration is the owner's child of that name, so the
    # def node comes off the same walk that found the owner
    dnode: 0
    {
        cd: st.typing.declFindChild parentDeclId: od nameId: nid
        if (cd.isZero) == false then {
            cdo: st.typing.decls.get i: cd.u64
            dnode = cdo.node
        }
    }
    return (constValueOfMemberAt
        :st
        :ast

        :unitDecl
        ownerDecl: od
        nameId: nid
        defNodeId: dnode
    )
}

# constValueOfMemberAt -- the fold itself, addressed by the OWNER's declaration.
# A member of a NESTED unit has no (unitDecl, defName) pair that names it, so
# the name-keyed lookup above is the wrapper's and the evaluation is here. The
# owner arrives as a Decl rather than a type id because that is what the
# evaluation frame is: deriving it back from the id was a reverse lookup.
constValueOfMemberAt: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ownerDecl: ztypes.declid
    nameId: zast.nameid
    defNodeId: u32
} out ztypes.cval is {
    utid: declTypeIdOf :st declId: ownerDecl
    nid: nameId
    if utid.isZero then return ztypes.noConst
    k: st.typing.memberConstKey parentTypeId: utid nameId: nid
    evalState: 0
    {
        sg: st.typing.constEvalState.get key: k
        match (
            sg
        ) case some then {
            evalState = sg.u64
        } case none then null
    }
    if evalState == 2 then return (st.typing.memberConstOf parentTypeId: utid nameId: nid)
    dnid: defNodeId
    if dnid == 0 then return ztypes.noConst
    opid: u32
    dline: u32
    dcol: u32
    dnode: zast.nodeid
    {
        dn: ast.nodes.get i: dnid.u64
        match (
            dn
        ) case namedoperation then {
            opid = dn.operation
            dline = dn.lineno
            dcol = dn.colno
            dnode = dn.nodeid
        } else null
    }
    if opid == 0 then return ztypes.noConst
    if evalState == 1 then {
        if (constDefIsComputed :ast n: (ast.nodes.get i: opid.u64)) == false then {
            st.typing.constEvalState.set key: k value: 2.u8
            return ztypes.noConst
        }
        # the only place the NAME's text is wanted: a cycle names itself in
        # its own diagnostic. Everywhere else the id is the whole answer.
        cycName: zast.nameTextCopy :ast ref: nid
        strId9: (constInternString :st text: cycName.stringView)
        (constFailRecord
            :st
            kind: ztypes.constfailkind.cycle
            nodeid: dnode
            lineno: dline
            colno: dcol
            width: cycName.length.u32.orPanic
            strId: strId9
        )
        st.typing.constEvalState.set key: k value: 2.u8
        return ztypes.noConst
    }
    st.typing.constEvalState.set key: k value: 1.u8
    # the value is evaluated in the frame of the unit that owns the member --
    # the owner itself, which the caller already holds
    valFound: (evalConstNode
        :st
        frame: ownerDecl
        :ast
        :unitDecl
        nid: (zast.nodeid.create from: opid)
    )
    st.typing.constEvalState.set key: k value: 2.u8
    if (valFound.kind.none) == false then {
        st.typing.setMemberConst parentTypeId: utid nameId: nid value: valFound
    }
    return valFound
}

# constBlockValue -- the value a branch block yields: its LAST statement's,
# the way constantBranchWalk takes the block's type from the last statement.
constBlockValue: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nid: zast.nodeid
} out ztypes.cval is {
    # the block's line ids are read through views scoped to blocks: each
    # line's evaluation lends ast exclusively
    isStmt: false
    lineIds: (ListVal u32)
    {
        n: ast.nodes.get i: nid.u64
        match (
            n
        ) case statement then {
            isStmt = true
            with sit: n.statements.iterate do for s: sit loop lineIds.append from: s
        } else null
    }
    if (isStmt) == false then return ztypes.noConst
    r: ztypes.noConst
    with lit: lineIds.iterate do for sId: lit loop {
        innerId: zast.nodeid
        {
            s: ast.nodes.get i: sId.u64
            match (
                s
            ) case statementline then {
                innerId = s.statementline
            } else null
        }
        if (innerId.isZero) == false then r = evalConstNode :st :frame :ast :unitDecl nid: innerId
    }
    return r
}

# foldIfBranch -- which clause of an `if` the constant fold selects, stamped on
# the If so every consumer reads ONE answer instead of recomputing its own.
# Every condition of a clause must fold and be true for that clause to win; the
# first winner takes it and the else clause is the fallback. `known` false means
# a condition did not fold: this is a runtime `if` and nothing may be elided.
# foldIfCond -- one condition of a folding `if`: 1 = a plain guard that
# folds true, 2 = folds false, 0 = undecided (a labelled condition other
# than `when`, or a guard whose value is not a known truth arm), 3 = not a
# named condition at all (it says nothing).
foldIfCond: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    condId: u32
} out u32 is {
    isGuard: false
    isOther: false
    opId: zast.nodeid
    {
        cond: ast.nodes.get i: condId.u64
        match (
            cond
        ) case namedoperation then {
            # a labelled condition other than `when` is not a plain guard, and
            # this fold does not speak for it
            cl: zast.nameTextAt :ast ref: cond.name
            if cl.length > 0 when cl.stringView != "when" then {
                isOther = true
            } else {
                isGuard = true
                opId = cond.operation
            }
        } else null
    }
    if isOther then return 0
    if (isGuard) == false then return 3
    cv: evalConstNode :st :frame :ast :unitDecl nid: opId
    # by the DISCRIMINATOR, not by arm position: a data-sourced tag names its
    # own values.
    fa: (ztyping.sumPairFalsyArmOf
        ty: st.typing
        reg: st.reg
        tid: cv.armTid
    )
    ta: (ztyping.sumPairTruthyArmOf
        ty: st.typing
        reg: st.reg
        tid: cv.armTid
    )
    if fa > 0 when cv.armName.u64 == fa then return 2
    if ta > 0 when cv.armName.u64 == ta then return 1
    return 0
}

foldIfBranch: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nid: zast.nodeid
} out ztyping.foldedbranch is {
    # the clause and statement ids are read through views scoped to blocks:
    # the condition folds lend ast exclusively
    isIf: false
    clauseIds: (ListVal u32)
    elseId: zast.nodeid
    {
        n: ast.nodes.get i: nid.u64
        match (
            n
        ) case ifexpr then {
            isIf = true
            with cit: n.clauses.iterate do for c: cit loop clauseIds.append from: c
            elseId = n.elseclause
        } else null
    }
    known: true
    stmt: zast.nodeid
    if (isIf) == false then return (ztyping.foldedbranch known: false :stmt)
    decided: false
    with cliter: clauseIds.iterate do for clauseId: cliter loop {
        if decided == false then {
            isClause: false
            condIds: (ListVal u32)
            stmtId: zast.nodeid
            {
                clause: ast.nodes.get i: clauseId.u64
                match (
                    clause
                ) case ifclause then {
                    isClause = true
                    with coit: clause.conditions.iterate do for c: coit loop condIds.append from: c
                    stmtId = clause.statement
                } else null
            }
            if isClause then {
                allTrue: true
                undecided: false
                with coiter: condIds.iterate do for condId: coiter loop {
                    v: foldIfCond :st :frame :ast :unitDecl :condId
                    if v == 0 then undecided = true
                    if v == 2 then allTrue = false
                }
                if undecided then {
                    known = false
                    decided = true
                } else {
                    if allTrue then {
                        stmt = stmtId
                        decided = true
                    }
                }
            }
        }
    }
    if decided == false then stmt = elseId
    fb: ztyping.foldedbranch :known :stmt
    st.typing.foldedBranch.set key: nid.u64 value: fb
    return fb
}

# constArmRead -- `<typeName>.<armName>` looked up from `lookupUnit`, as a
# value. The parent's FAMILY decides, the same test resolveConstantDef uses to
# tell an arm read from a construction: variant or union means the child is an
# arm, and anything else is a member read a constant cannot hold.
constArmRead: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    lookupUnit: ztypes.declid
    typeName: StringView
    armName: StringView
} out ztypes.cval is {
    # the type is looked up in `lookupUnit`'s frame -- `frame` itself when
    # it already lies inside that unit (a nested scope of it is nearer than
    # its root), else the unit's root
    rf: frame
    {
        lro: lookupUnit
        if (lro.isZero) == false then if (frameIsWithin
            :st
            frame: rf
            root: lro
        ) == false then rf = lro
    }
    ptu: (optU64Or
        o: (walkLookupTyperef
            :st
            frame: rf
            :ast
            unitDecl: lookupUnit
            base: typeName
        )
        d: 0
    )
    if ptu == 0 then {
        # a variant NOTHING ELSE mentions is not demanded, so the lookup finds
        # nothing and the arm read silently yields no value. Descending mints
        # it, which is what a use site would have done -- a constant reading an
        # arm IS a use of the type.
        ptu = (descendNamed
            :st
            frame: rf
            :ast
            unitDecl: lookupUnit
            name: typeName
        ).u64
    }
    if ptu == 0 then return ztypes.noConst
    ptid: ztypes.tid.create from: ptu.u64
    ptt: st.reg.typetypeOf typeId: ptid
    isSum: false
    if ptt == ztypes.ztypetype.variantType then isSum = true
    if ptt == ztypes.ztypetype.unionType then isSum = true
    if (isSum) == false then return ztypes.noConst
    return (ztypes.makeArmConst
        armTid: ptid
        armName: (zast.poolFind pool: ast.names text: armName)
    )
}

# constValEq -- do two compile-time values denote the same thing? Only defined
# within a kind: comparing an int to a tag is not false, it is unanswerable,
# which is what `has` reports.
constValEq: function {st: zenv.ZSymbolTable.view a: ztypes.cval b: ztypes.cval} out ffoldval is {
    if a.kind.ivalKind when b.kind.ivalKind then {
        r: 0.0
        if a.ival == b.ival then r = 1.0
        return (ffoldval has: true val: r)
    }
    if a.kind.armKind when b.kind.armKind then {
        r: 0.0
        if a.armTid == b.armTid when a.armName == b.armName then r = 1.0
        return (ffoldval has: true val: r)
    }
    if a.kind.svalKind when b.kind.svalKind then {
        constStr: constStringAt :st id: a.strId
        bs: constStringAt :st id: b.strId
        r: 0.0
        if constStr.stringView == bs.stringView then r = 1.0
        return (ffoldval has: true val: r)
    }
    return (ffoldval has: false val: 0.0)
}

# foldCaseArm -- which arm of a `match` a constant subject selects, stamped on
# the match the way foldIfBranch stamps an `if`. A BINDING arm (`case x then`)
# names its payload rather than testing a value, so a match holding one is not
# decidable here at all.
foldCaseArm: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    n: caseref
} is {
    sv: (evalConstNode
        :st
        frame: st.curFrame
        :ast

        :unitDecl
        nid: n.subject
    )
    if sv.kind.none then return
    known: true
    stmt: zast.nodeid
    decided: false
    kC: u64
    for kC < n.nclauses loop {
        clId: (zast.caseClauseAt :ast nid: n.nid i: kC).u32
        kC = kC + 1
        if known then {
            cl: caseClauseRefAt :ast nid: (zast.nodeid.create from: clId.u32)
            if (cl.nid.isZero) == false then {
                if cl.name != 0 then {
                    known = false
                } else {
                    av: (evalConstNode
                        :st
                        frame: st.curFrame
                        :ast

                        :unitDecl
                        nid: cl.matcharm
                    )
                    eq: constValEq :st a: av b: sv
                    if eq.has then {
                        if eq.val > 0.0 when decided == false then {
                            stmt = cl.statement
                            decided = true
                        }
                    } else {
                        known = false
                    }
                }
            } else {
                known = false
            }
        }
    }
    if known == false then return
    if decided == false then stmt = n.elseclause
    st.typing.foldedBranch.set key: n.nid.u64 value: (ztyping.foldedbranch known: true :stmt)
}

# constStrArgAt -- one argument of a static string method, found by LABEL or by
# POSITION. Argument labels are optional (`sv.startsWith "ztr_"` is legal), so a
# namedoperation carrying no name is the positional form and is matched on its
# ordinal instead.
constStrArgAt: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    args: (ListVal u32).view
    label: StringView
    idx: u64
} out ztypes.cval is {
    res: ztypes.noConst
    found: false
    i: u64
    with it: args.iterate do for aId: it loop {
        if (found) == false then {
            an: argRefAt :ast nid: (zast.nodeid.create from: aId.u32)
            if (an.nid.isZero) == false then {
                hit: false
                if an.name.isZero when i == idx then hit = true
                if (an.name.isZero) == false then {
                    lt: zast.nameTextAt :ast ref: an.name
                    if lt.stringView == label then hit = true
                }
                if hit then {
                    res = (evalConstNode
                        :st
                        :frame
                        :ast

                        :unitDecl
                        nid: an.operation
                    )
                    found = true
                }
                i = i + 1
            }
        }
    }
    return res
}

# constUnsupportedMethod -- "this name is a method on a string constant that
# does not fold". Records rather than reports, so it is an error only where a
# value was REQUIRED; a body `if` drops it and emits a runtime branch.
constUnsupportedMethod: function {
    st: zenv.ZSymbolTable
    name: StringView
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} out ztypes.cval is {
    strId92: (constInternString :st text: name)
    (constFailRecord
        :st
        kind: ztypes.constfailkind.unsupportedMethod
        :nodeid
        :lineno
        :colno
        width: name.length.u32.orPanic
        strId: strId92
    )
    return ztypes.noConst
}

# constStringDotted -- a member read on a string constant written as a bare
# dotted path, which is how `S.length` parses. `length` is the BYTE count,
# String.length's own answer; `count` is the codepoint one and is not folded.
constStringDotted: function {
    st: zenv.ZSymbolTable
    v: ztypes.cval
    name: StringView
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} out ztypes.cval is {
    s: constStringAt :st id: v.strId
    if name == "length" then return (ztypes.makeIntConst s.length.i64.orPanic)
    return (constUnsupportedMethod :st :name :nodeid :lineno :colno)
}

# constStringMethod -- fold a static method call on a string constant. Every
# answer is computed by CALLING the same method the run time would, so a folded
# result and a run-time one cannot disagree about an empty prefix, an empty
# needle, or a boundary index. `substring` PANICS out of range rather than
# clamping, so out of range at compile time means there is no value -- not a
# clamped one, and not a silent `none` that would let the definition through.
constStringMethod: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    args: (ListVal u32).view
    recv: ztypes.cval
    name: StringView
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} out ztypes.cval is {
    s: constStringAt :st id: recv.strId
    if name == "length" then return (ztypes.makeIntConst s.length.i64.orPanic)
    lbl: ""
    if name == "startsWith" then lbl = "prefix"
    if name == "endsWith" then lbl = "suffix"
    if name == "contains" then lbl = "needle"
    if lbl.length > 0 then {
        a: (constStrArgAt :st :frame :ast :unitDecl :args label: lbl idx: 0)
        if (a.kind.svalKind) == false then return ztypes.noConst
        constStr: constStringAt :st id: a.strId
        if name == "startsWith" then return (boolConst
            :st
            :frame
            :ast

            v: (s.startsWith prefix: constStr)
        )
        if name == "endsWith" then return (boolConst
            :st
            :frame
            :ast

            v: (s.endsWith suffix: constStr)
        )
        return (boolConst :st :frame :ast v: (s.contains needle: constStr))
    }
    if name == "substring" then {
        f: constStrArgAt :st :frame :ast :unitDecl :args label: "from" idx: 0
        t: constStrArgAt :st :frame :ast :unitDecl :args label: "to" idx: 1
        if (f.kind.ivalKind) == false then return ztypes.noConst
        if (t.kind.ivalKind) == false then return ztypes.noConst
        sz: s.length.i64.orPanic
        bad: false
        if f.ival < 0 then bad = true
        if t.ival < 0 then bad = true
        if f.ival > sz then bad = true
        if t.ival > sz then bad = true
        if f.ival > t.ival then bad = true
        if bad then {
            (constFailRecord
                :st
                kind: ztypes.constfailkind.substringRange
                :nodeid
                :lineno
                :colno
                width: 1
            )
            return ztypes.noConst
        }
        sub: s.substring from: f.ival.u64.orPanic to: t.ival.u64.orPanic
        return (ztypes.makeStrConst (constInternString :st text: sub))
    }
    return (constUnsupportedMethod :st :name :nodeid :lineno :colno)
}
# constOfBinop -- fold a binary operator over two constant operands. Two tags
# compare by ARM IDENTITY (owning type plus name-pool id), never by rendered
# text, and only equality is defined -- arms have no order.
# constOfBinopFold -- the folded value of `lv <op> rv`: two tags compare by
# ARM IDENTITY, two strings by interned text (and `+` joins), integers and
# floats by value. noConst for anything else.
constOfBinopFold: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    lv: ztypes.cval
    rv: ztypes.cval
    op: StringView
    nid: zast.nodeid
    ln: u32
    co: u32
} out ztypes.cval is {
    # two tags compare by ARM IDENTITY -- the owning type and the arm's
    # name-pool id -- never by rendered text. Only equality is defined:
    # arms have no order.
    if lv.kind.armKind when rv.kind.armKind then {
        same: false
        if lv.armTid == rv.armTid when lv.armName == rv.armName then same = true
        if op == "==" then return (boolConst :st :frame :ast v: same)
        if op == "!=" then return (boolConst
            :st
            :frame
            :ast
            v: ((same) == false)
        )
        return ztypes.noConst
    }
    # two string constants compare by their interned TEXT. Only equality is
    # folded: ordering is defined but nothing needs it at compile time yet,
    # and a wrong answer here would be silent.
    if lv.kind.svalKind when rv.kind.svalKind then {
        ls: constStringAt :st id: lv.strId
        rs: constStringAt :st id: rv.strId
        eq: ls.stringView == rs.stringView
        if op == "==" then return (boolConst :st :frame :ast v: eq)
        if op == "!=" then return (boolConst :st :frame :ast v: ((eq) == false))
        # `+` BUILDS, so the folded value is the joined text, interned like
        # any other. `A + B + C` folds left to right through this leg with
        # no runtime temporary at any step.
        if op == "+" then {
            ls.append rs
            return (ztypes.makeStrConst (constInternString :st text: ls.stringView))
        }
        return ztypes.noConst
    }
    if lv.kind.ivalKind when rv.kind.ivalKind then {
        if (isComparisonOp name: op) then {
            return (constCompareInt :st :frame :ast :op a: lv.ival b: rv.ival)
        }
        return (constArithInt
            :st
            nodeid: nid
            lineno: ln
            colno: co
            :op
            a: lv.ival
            b: rv.ival
        )
    }
    lf: constFloatOf v: lv
    rf: constFloatOf v: rv
    if lf.has when rf.has then {
        if (isComparisonOp name: op) then {
            return (constCompareFloat :st :frame :ast :op a: lf.val b: rf.val)
        }
        return (constArithFloat :op a: lf.val b: rf.val)
    }
    return ztypes.noConst
}

constOfBinop: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out ztypes.cval is {
    # the operand and operator ids are read through a view scoped to this
    # block: the operand evaluations lend ast exclusively
    isBinop: false
    lhsId: zast.nodeid
    rhsId: zast.nodeid
    opId: zast.nodeid
    ln: u32
    co: u32
    {
        n: ast.nodes.get i: nid.u64
        match (
            n
        ) case binop then {
            isBinop = true
            lhsId = n.lhs
            rhsId = n.rhs
            opId = n.operator
            ln = n.lineno
            co = n.colno
        } else null
    }
    if (isBinop) == false then return ztypes.noConst
    lv: evalConstNode :st :frame :ast :unitDecl nid: lhsId
    if lv.kind.none then return ztypes.noConst
    rv: evalConstNode :st :frame :ast :unitDecl nid: rhsId
    if rv.kind.none then return ztypes.noConst
    # an owned copy: the name must outlive the folds below, which lend ast
    opNode: zast.nameTextCopy :ast ref: (atomNameId :ast n: (ast.nodes.get i: opId.u64))
    if opNode.length == 0 then return ztypes.noConst
    return (constOfBinopFold :st :frame :ast :lv :rv op: opNode.stringView :nid :ln :co)
}
# constOfCall -- a call in constant position. `error "..."` is the program
# asserting: only the WINNING branch of a fold is ever evaluated, so an `error`
# in a dead one is never visited, which is why it lives here and not in a tree
# walk. A static method on a string constant folds here too.
# constOfStringMethodCall -- a static method on a string constant
# (`"abcd".length`) is a CALL whose callable is a dotted path: the receiver
# folds to a string and the child names the method. noConst when the call
# is not that shape or its receiver does not fold.
constOfStringMethodCall: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
    callableId: zast.nodeid
    args: (ListVal u32).view
    ln: u32
    co: u32
} out ztypes.cval is {
    recvId: zast.nodeid
    methodId: zast.nodeid
    {
        cnode: ast.nodes.get i: callableId.u64
        if cnode.dottedpath then {
            recvId = cnode.parent
            methodId = cnode.child
        }
    }
    if recvId.isZero then return ztypes.noConst
    rcv: evalConstNode :st :frame :ast :unitDecl nid: recvId
    if (rcv.kind.svalKind) == false then return ztypes.noConst
    mnc: String
    {
        mnode: ast.nodes.get i: methodId.u64
        mnc = zast.nameTextCopy :ast ref: (atomNameId :ast n: mnode)
    }
    if mnc.length == 0 then return ztypes.noConst
    return (constStringMethod
        :st
        :frame
        :ast

        :unitDecl
        :args
        recv: rcv
        name: mnc.stringView
        nodeid: nid
        lineno: ln
        colno: co
    )
}

constOfCall: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out ztypes.cval is {
    # the call's callable and argument ids are read through views scoped to
    # blocks: every evaluation below lends ast exclusively
    isCall: false
    callableId: zast.nodeid
    argIds: (ListVal u32)
    ln: u32
    co: u32
    {
        n: ast.nodes.get i: nid.u64
        match (
            n
        ) case call then {
            isCall = true
            callableId = n.callable
            with ait: n.arguments.iterate do for a: ait loop argIds.append from: a
            ln = n.lineno
            co = n.colno
        } else null
    }
    if (isCall) == false then return ztypes.noConst
    # `error "..."` in constant position is the program asserting. Only the
    # WINNING branch of a fold is ever evaluated, so an `error` in a dead
    # one is never visited -- which is why this lives in the evaluator and
    # not in a tree walk, and why the spec can promise that a statically
    # false branch's error goes unreported.
    # A static method on a string constant is a CALL whose callable is a
    # dotted path, so atomName is "" for it and the `error` test below would
    # bail before ever looking at the receiver. Intercept first.
    sm: constOfStringMethodCall :st :frame :ast :unitDecl :nid :callableId args: argIds :ln :co
    if (sm.kind.none) == false then return sm
    isError: false
    {
        cnode: ast.nodes.get i: callableId.u64
        cbn: zast.nameTextAt :ast ref: (atomNameId :ast n: cnode)
        if cbn.stringView == "error" then isError = true
    }
    if (isError) == false then return ztypes.noConst
    umsg: "compile-time error".string
    with it: argIds.iterate do for aId: it loop {
        opId: zast.nodeid
        {
            an: ast.nodes.get i: aId.u64
            match (
                an
            ) case namedoperation then {
                opId = an.operation
            } else null
        }
        if (opId.isZero) == false then {
            av: evalConstNode :st :frame :ast :unitDecl nid: opId
            if av.kind.svalKind then umsg = constStringAt :st id: av.strId
        }
    }
    strId93: (constInternString :st text: umsg.stringView)
    (constFailRecord
        :st
        kind: ztypes.constfailkind.reachedError
        nodeid: nid
        lineno: ln
        colno: co
        width: 5
        strId: strId93
    )
    return ztypes.noConst
}
# constOfNamedBase -- a dotted path whose base is a bare atom. The base can name a
# numeric literal (`1.u32` is a width suffix, not a member read), another unit, a
# nested namespace, a nested unit of the scope being evaluated, or a same-unit
# constant or type -- the constant is asked first, being the narrower question.
constOfNamedBase: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    unitDecl: ztypes.declid
    ast: Ast
    atNid: zast.nodeid
    atLine: u32
    atCol: u32
    pt: StringView
    nameCount: StringView
} out ztypes.cval is {
    if pt.length > 0 then {
        # `1.u32` is a width-suffixed literal, not a member read: the value
        # is the parent's lexeme and the child only names its type.
        if (isNumericLiteralName name: pt) then return (constLiteralValue name: pt)
        # `unit.CONST` reads a constant out of another unit.
        if (nameDenotesUnit :st :frame nameId: (nameIdOf :ast name: pt)) then {
            nameId98: (nameIdOf :ast name: pt)
            unitDecl98: unitDeclOfNameOrOwn :st :frame nameId: nameId98
            return (constValueOfMember
                :st
                :frame
                :ast

                unitDecl: unitDecl98
                defName: nameCount
            )
        }
        # A nested namespace (`m: unit { NUM: 7 }`) is a definition of THIS
        # unit whose type is a unit; it is deliberately absent from the
        # unit-name index, so its members are read off its type id.
        {
            nso: (resolvedByIds
                :st
                :ast
                :unitDecl
                name: (nameIdOf :ast name: pt)
            )
            match (
                nso
            ) case some then {
                nst: ztypes.tid.create from: nso
                if (st.reg.typetypeOf typeId: nst) == ztypes.ztypetype.unitType then {
                    nsv: (constValueOfMemberTid
                        :st
                        :ast

                        unitTid: nst
                        defName: nameCount
                    )
                    if (nsv.kind.none) == false then return nsv
                }
            } case none then null
        }
        # A nested unit of the SCOPE being evaluated: not in the unit-name
        # index either, and it resolves on demand, so it may have no id at
        # all until asked for here. The scope is the enclosing namespace
        # while its own members evaluate and the file unit otherwise --
        # rooting this at the file unit alone stopped a re-export chain at
        # its first hop, since a subunit's subunit is no child of the file.
        {
            sro: unitFrameOf :st declId: frame
            nestedNameId9: (nameIdOf :ast name: pt)
            sst: (nestedUnitTidOf
                :st
                :frame

                :ast
                ownerDeclId: sro
                nestedNameId: nestedNameId9
            )
            if (sst.isZero) == false then {
                ssv: (constValueOfMemberTid
                    :st
                    :ast

                    unitTid: sst
                    defName: nameCount
                )
                if (ssv.kind.none) == false then return ssv
            }
        }
        # A same-unit name can be a CONSTANT or a TYPE, and the two read
        # identically: `CC.tcc` asks whether the constant CC holds that arm,
        # `cckind.tcc` names an arm of the type. The constant is asked
        # first because it is the narrower question -- a name is not both,
        # and classifying a constant by its definition's shape would call
        # `CC: cckind.tcc` a variant and read a nonexistent arm off it.
        pcv: constValueOfMember :st :frame :ast :unitDecl defName: pt
        if pcv.kind.armKind then {
            cnid0: zast.poolFind pool: ast.names text: nameCount
            if cnid0.isZero then return ztypes.noConst
            return (boolConst :st :frame :ast v: (pcv.armName == cnid0))
        }
        if pcv.kind.svalKind then {
            return (constStringDotted
                :st
                v: pcv
                name: nameCount
                nodeid: atNid
                lineno: atLine
                colno: atCol
            )
        }
        return (constArmRead
            :st
            :frame
            :ast

            lookupUnit: unitDecl
            typeName: pt
            armName: nameCount
        )
    }
    return ztypes.noConst
}


# evalConstNode -- the compile-time value of a node, or `none` when the node is
# not a constant shape. Numeric shapes only for now: bool and variant arms,
# strings and static string methods arrive with the paths that render them.
# Silence is deliberate here -- a shape with no value is not automatically an
# error, because this walk also runs over definitions that are not constants at
# all. The E0600s below are the cases where a value was genuinely required and
# the operands were there.
# constplan -- what evaluating one row needs once its view is gone: the arm
# (1 expression, 2 atomid, 3 atomstring, 4 dottedpath, 5 binop, 6 call,
# 7 ifexpr, 0 anything else) and the ids and scalars that arm reads.
constplan: record {
    arm: u32
    innerId: zast.nodeid
    nameId: zast.nameid
    parts: u64
    parentId: zast.nodeid
    childId: zast.nodeid
    ln: u32
    co: u32
}

# evalConstPlan -- read-only: the plan for row `nid`; the row view is this
# frame's and dies here.
evalConstPlan: function {ast: Ast.view nid: zast.nodeid} out constplan is {
    arm: u32
    innerId: zast.nodeid
    nameId: zast.nameid
    parts: u64
    parentId: zast.nodeid
    childId: zast.nodeid
    ln: u32
    co: u32
    {
        n: ast.nodes.get i: nid.u64
        match (
            n
        ) case expression then {
            arm = 1
            innerId = n.expression
        } case atomid then {
            arm = 2
            nameId = n.name
        } case atomstring then {
            arm = 3
            parts = n.stringparts.length
            if parts == 1 then innerId = zast.nodeid.create from: (n.stringparts.get i: 0)
            ln = n.lineno
            co = n.colno
        } case dottedpath then {
            arm = 4
            parentId = n.parent
            childId = n.child
            ln = n.lineno
            co = n.colno
        } case binop then {
            arm = 5
        } case call then {
            arm = 6
        } case ifexpr then {
            arm = 7
        } else null
    }
    return (constplan :arm :innerId :nameId :parts :parentId :childId :ln :co)
}

# evalConstString -- a string literal's value: one chunk and nothing else is
# a plain literal. An INTERPOLATION has a value only at run time, and a
# unit-level definition is required to be a compile-time constant, so this is
# a case where the value was genuinely required and could not be produced --
# it reports rather than falling silent the way an unrecognised shape does.
evalConstString: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    nid: zast.nodeid
    parts: u64
    partId: zast.nodeid
    ln: u32
    co: u32
} out ztypes.cval is {
    if parts == 1 then {
        firstPartNode: ast.nodes.get i: partId.u64
        match (
            firstPartNode
        ) case stringchunk then {
            return (ztypes.makeStrConst (constInternString
                :st
                text: firstPartNode.text.stringView
            ))
        } else null
    }
    if parts == 0 then return (ztypes.makeStrConst (constInternString :st text: ""))
    (constFailRecord
        :st
        kind: ztypes.constfailkind.interp
        nodeid: nid
        lineno: ln
        colno: co
        width: 1
    )
    return ztypes.noConst
}

# evalConstArmViaUnit -- `platform.oskind.linux`: an arm of a type reached
# THROUGH its unit. The parent is a dotted path of its own (`gpId.gcId`), so
# the type is looked up from that unit rather than from the one being
# evaluated. noConst when the path is not that shape.
evalConstArmViaUnit: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    gpId: zast.nodeid
    gcId: zast.nodeid
    nameCount: StringView
} out ztypes.cval is {
    gpt: String
    gct: String
    gpNameId: zast.nameid
    {
        gp: ast.nodes.get i: gpId.u64
        gc: ast.nodes.get i: gcId.u64
        if gp.atomid when gc.atomid then {
            gpt = zast.nameTextCopy :ast ref: gp.name
            gct = zast.nameTextCopy :ast ref: gc.name
            gpNameId = gp.name
        }
    }
    if gpt.length > 0 when gct.length > 0 then {
        if (nameDenotesUnit
            :st
            :frame

            nameId: (nameIdOf :ast name: gpt.stringView)
        ) then {
            lookupUnit9: (unitDeclOfNameOrOwn :st :frame nameId: gpNameId)
            qa: (constArmRead
                :st
                :frame
                :ast

                lookupUnit: lookupUnit9
                typeName: gct.stringView
                armName: nameCount
            )
            if (qa.kind.none) == false then return qa
        }
    }
    return ztypes.noConst
}

# evalConstDotted -- a dotted path's value: a member read off a named base
# (a unit, a nested namespace, a constant, a type's arm), the arm predicate
# of a constant whose type is a variant, a method on a string constant, or
# an arm reached through a unit.
evalConstDotted: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
    parentId: zast.nodeid
    childId: zast.nodeid
    ln: u32
    co: u32
} out ztypes.cval is {
    nameCount: String
    {
        chn: ast.nodes.get i: childId.u64
        if chn.atomid then nameCount = zast.nameTextCopy :ast ref: chn.name
    }
    if nameCount.length == 0 then return ztypes.noConst
    pt: String
    parentIsDotted: false
    gpId: zast.nodeid
    gcId: zast.nodeid
    {
        pn: ast.nodes.get i: parentId.u64
        if pn.atomid then pt = zast.nameTextCopy :ast ref: pn.name
        if pn.dottedpath then {
            parentIsDotted = true
            gpId = pn.parent
            gcId = pn.child
        }
    }
    if pt.length > 0 then {
        pbv: (constOfNamedBase
            :st
            :frame
            :unitDecl
            :ast
            atNid: nid
            atLine: ln
            atCol: co
            pt: pt.stringView
            nameCount: nameCount.stringView
        )
        if (pbv.kind.none) == false then return pbv
    }
    # `platform.os.linux` -- the ARM-PREDICATE form, asked FIRST for the
    # same reason the atomid case asks the constant first: `tsrc.os` is a
    # constant whose TYPE is a variant, so reading it as a qualified type
    # name would find that variant and answer with an arm where the
    # question was "does it hold this one".
    pv: evalConstNode :st :frame :ast :unitDecl nid: parentId
    if pv.kind.armKind then {
        cnid: zast.poolFind pool: ast.names text: nameCount.stringView
        if cnid.isZero then return ztypes.noConst
        return (boolConst :st :frame :ast v: (pv.armName == cnid))
    }
    # a literal receiver (`"abcd".length`) or a qualified constant
    # (`quadfloat.LIB.length`): the parent is not a bare atom, so its value
    # comes from the recursive walk above rather than from a member read.
    if pv.kind.svalKind then {
        return (constStringDotted
            :st
            v: pv
            name: nameCount.stringView
            nodeid: nid
            lineno: ln
            colno: co
        )
    }
    # `platform.oskind.linux` -- an arm of a type reached THROUGH its unit.
    # The parent is a dotted path of its own, so the type must be looked up
    # from that unit rather than from the one being evaluated.
    if parentIsDotted then {
        qa: evalConstArmViaUnit :st :frame :ast :gpId :gcId nameCount: nameCount.stringView
        if (qa.kind.none) == false then return qa
    }
    return ztypes.noConst
}

evalConstNode: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nid: zast.nodeid
} out ztypes.cval is {
    plan: evalConstPlan :ast :nid
    # A NAME THAT READS A LOCAL IS NOT A CONSTANT, whatever a unit definition
    # of the same name says. This evaluator was written for unit-level
    # definitions, where there is no local scope to shadow one; asked about a
    # USE SITE inside a body it would resolve the unit member and quietly
    # answer for the wrong binding. The checker has already recorded which
    # atoms read a variable -- the two guards below are that record, one for a
    # bare name and one for the root of a path.
    if plan.arm == 1 then return (evalConstNode :st :frame :ast :unitDecl nid: plan.innerId)
    if plan.arm == 2 then {
        if (st.typing.atomVariableId.has key: nid.u64) then return ztypes.noConst
        # a literal never needs an OWNED name, and every numeric literal in the
        # program reaches this arm. The member pull below takes the id.
        isLit: false
        litVal: ztypes.noConst
        noName: false
        {
            nv: zast.nameTextAt :ast ref: plan.nameId
            if nv.length == 0 then noName = true
            if (noName) == false then {
                isLit = isNumericLiteralName name: nv.stringView
                if isLit then litVal = constLiteralValue name: nv.stringView
            }
        }
        if noName then return ztypes.noConst
        if isLit then return litVal
        return (constValueOfMemberId :st :frame :ast :unitDecl nameId: plan.nameId)
    }
    if plan.arm == 3 then {
        return (evalConstString
            :st
            :ast
            :nid
            parts: plan.parts
            partId: plan.innerId
            ln: plan.ln
            co: plan.co
        )
    }
    if plan.arm == 4 then {
        if (st.typing.atomVariableId.has key: plan.parentId.u64) then return ztypes.noConst
        return (evalConstDotted
            :st
            :frame
            :ast
            :unitDecl
            :nid
            parentId: plan.parentId
            childId: plan.childId
            ln: plan.ln
            co: plan.co
        )
    }
    if plan.arm == 5 then return (constOfBinop :st :frame :ast :unitDecl :nid)
    if plan.arm == 6 then return (constOfCall :st :frame :ast :unitDecl :nid)
    if plan.arm == 7 then {
        fb: foldIfBranch :st :frame :ast :unitDecl :nid
        if (fb.known) == false then return ztypes.noConst
        if fb.stmt.isZero then return ztypes.noConst
        return (constBlockValue :st :frame :ast :unitDecl nid: fb.stmt)
    }
    return ztypes.noConst
}

# stampConstAt -- record what a USE SITE evaluates to, when it evaluates to
# anything. The value walk asks this of every row the evaluator recognises, so
# the ask is SPECULATIVE: a row that does not fold is an ordinary run-time
# expression, not a mistake. The pending failure the evaluator records on the
# way is therefore restored rather than rendered -- only a caller that REQUIRED
# a value renders one, and a fold is an optimisation that must never turn a
# legal program into an error.
stampConstAt: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    nid: zast.nodeid
} is {
    if nid.isZero then return
    plan: evalConstPlan :ast :nid
    if plan.arm == 0 then return
    # A BINOP FOLDS ONLY IF BOTH OPERANDS DO, and the walk reached both of them
    # before it reached this. Asking the stamps rather than re-walking the
    # subtree is what keeps the cost linear in the tree instead of linear in
    # its depth at every node.
    if plan.arm == 5 then {
        br: binRefAt :ast :nid
        if (st.typing.nodeConst.has key: br.lhs.u64) == false then return
        if (st.typing.nodeConst.has key: br.rhs.u64) == false then return
    }
    if plan.arm == 1 then {
        if (st.typing.nodeConst.has key: plan.innerId.u64) == false then return
    }
    # A CALL AND AN `if` ARE NOT ASKED AT A USE SITE. The call arm folds string
    # static methods and records a reached `error`; the first changes nothing a
    # body emits and the second is a diagnostic this walk must never raise. The
    # `if` arm folds a branch the emitter already reads its own channel for.
    # Measured on a self-compile, the two together allocate for every call and
    # every `if` in the program and move not one byte of emitted C.
    if plan.arm == 6 then return
    if plan.arm == 7 then return
    # A PATH IS ASKED ONLY WHERE IT CAN BE A LITERAL. `1.u32` is a dotted path
    # and its value is the point of this walk; `zast.nodeid` is a dotted path
    # too, and asking costs two owned name copies to be told there is no value.
    # A unit constant reached through a path is inlined by memberConst already.
    if plan.arm == 4 then {
        pnLit: false
        {
            pv: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: plan.parentId.u64))
            pnLit = isNumericLiteralName name: pv.stringView
        }
        if (pnLit) == false then return
    }
    held: st.typing.constFail
    constFailClear :st
    cv: evalConstNode :st :unitDecl frame: st.curFrame :ast :nid
    st.typing.constFail = held
    if cv.kind.none then return
    st.typing.setNodeConst :nid value: cv
}

# reportUnitConstantShape -- the diagnostic for a unit-level definition whose
# value is not a literal. Unit constants inline literal numeric values BY
# DESIGN (resolveConstantDef registers the literal, suffixed-literal and
# constant-expression shapes only); without a report the definition registers
# nothing and every downstream read blames the reader instead.
reportUnitConstantShape: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u32
    msg: String
    hint: String
} is {
    un: "unit constants inline literal numeric values".string
    st.typing.errors.append (zast.ErrorData
        :nodeid
        :lineno
        :colno
        :width
        err: zast.err.typeError
        msg: msg.copy
        fsno: zvfs.fsno
        note: un
        hint: hint.copy
    )
    st.typing.isError = true
}

# reportUnitConstantRef -- the callee of a unit-level construction names
# nothing in scope. Reporting a malformed CONSTANT there blames the shape of a
# definition whose callee does not exist; the reference is what is wrong. The
# usual way here is a dependency unit naming a main-unit definition, which the
# language does not allow for a constant or a namespace either.
reportUnitConstantRef: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u32
    msg: String
} is {
    en: String
    eh: String
    st.typing.errors.append (zast.ErrorData
        :nodeid
        :lineno
        :colno
        :width
        err: zast.err.badReference
        msg: msg.copy
        fsno: zvfs.fsno
        note: en
        hint: eh
    )
    st.typing.isError = true
}
# resolveDottedConstantDef -- a unit-level constant whose value is a dotted path.
# That is a width-suffixed literal (`1.u32`, the child naming the type), a variant
# arm read (`false: bool.false` -- a compile-time value, the shape core.z uses 41
# times), the unit-alias form resolveDef registers, or a member read on a type.
resolveDottedConstantDef: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    defn: dpref
    sfLit: StringView
    sfTy: StringView
} is {
    # `origin: Point.create x: 0` parses as TWO unit members -- the
    # dotted value `Point.create` and a separate constant `x: 0` --
    # so the construction never reaches this pass as a call. A dotted
    # value is a suffixed literal (`1.u32`) or the unit-alias form
    # (`Node: zast.Node`, whose parent names a UNIT and which
    # resolveDef registers); anything else is a member read on a type.
    if (isNumericLiteralName name: sfLit) == false then {
        # `false: bool.false` reads a variant ARM -- a compile-time
        # value, and the shape core.z uses 41 times. A FUNCTION member
        # (`Point.create`) is a runtime construction instead, which a
        # unit constant cannot hold.
        # The parent's FAMILY decides: a variant or union parent means
        # the child is an ARM -- a compile-time value. Any other family
        # means a member read or a construction. `declDefTypetype`
        # classifies a definition without resolving it, which is what
        # reaches a SAME-UNIT type at this stage; the typeref walk
        # answers for the resolvable ones.
        isCtor: false
        if (nameDenotesUnit
            :st
            :frame

            nameId: (nameIdOf :ast name: sfLit)
        ) == false then {
            ptt: ztypes.ztypetype.nullType
            known: false
            {
                pdc: (declOfUnitDef
                    :st
                    :frame
                    :unitDecl
                    nameId: (nameIdOf :ast name: sfLit)
                )
                if (pdc.isZero) == false then {
                    pdt: declDefTypetype :st :ast declId: pdc
                    match (
                        pdt
                    ) case some then {
                        ptt = pdt
                        known = true
                    } case none then null
                }
            }
            if (known) == false then {
                pTo: (walkLookupTyperef
                    :st
                    :frame
                    :ast

                    :unitDecl
                    base: sfLit
                )
                match (
                    pTo
                ) case some then {
                    ptt = st.reg.typetypeOf typeId: (ztypes.tid.create from: pTo.u64)
                    known = true
                } case none then null
            }
            if known then {
                isCtor = true
                if ptt == ztypes.ztypetype.variantType then isCtor = false
                if ptt == ztypes.ztypetype.unionType then isCtor = false
                # `sub.NAME` where the parent is a UNIT reads a member
                # of it, which is what every cross-unit re-export is;
                # only a TYPE parent makes the read a construction.
                if ptt == ztypes.ztypetype.unitType then isCtor = false
            }
        }
        # ASK THE CONSTANT FIRST. `LEN: LIB.length` reads a member of
        # a string CONSTANT, and LIB's own type is StringView -- a
        # class -- so the typeref walk above finds a non-variant parent
        # and calls the read a construction. The value settles it.
        if isCtor then {
            pcs: (constValueOfMember
                :st
                :frame
                :ast

                :unitDecl
                defName: sfLit
            )
            if pcs.kind.svalKind then isCtor = false
        }
        if isCtor then {
            dm: "a unit-level constant takes a literal value, not a construction".string
            dh: "construct it inside a function, or make '\{defName}' a function that returns the value"
            (reportUnitConstantShape
                :st
                nodeid: defn.nid
                lineno: defn.lineno
                colno: defn.colno
                width: sfLit.length.u32.orPanic
                msg: dm
                hint: dh
            )
        }
    }
    if (isNumericLiteralName name: sfLit) then {
        # THE SAME FIT CHECK A BODY PERFORMS. Without it `big: 300.u8` at unit
        # level was accepted, emitted `uint8_t z_v1 = 300;` and printed 44 --
        # gcc's -Woverflow was the only thing that noticed, and warn-check
        # covers only the four emitted drivers.
        (checkLiteralFits
            :st
            nodeid: defn.nid
            lineno: defn.lineno
            colno: defn.colno
            lit: sfLit
            target: sfTy
        )
        # The suffix must name a conversion the literal type declares, and
        # those are exactly the sixteen scalars. Tested by SPELLING rather than
        # by asking the declaration: a unit constant resolves after the demand
        # walk, so the literal type's members are not necessarily materialised
        # yet -- `--eager` reaches this before they are -- and an unsatisfiable
        # demand is not the same answer as "no such conversion".
        #
        # This used to accept any type name that happened to resolve, with a
        # `descendNamed` fallback to reach a typedef nothing else referenced.
        # That is what made a typedef a literal suffix at all.
        if (isNumericTypeName name: sfTy) == false then {
            sfLitTid: st.reg.literalIntTid
            if (isFloatLiteralName name: sfLit) then sfLitTid = st.reg.literalFloatTid
            sfn: st.reg.nameOf tid: sfLitTid
            sm9: "'\{sfn}' has no conversion to '\{sfTy}'"
            sh9: "a literal's suffix names one of the numeric types it converts to".string
            sn9: String
            (addErrorH
                :st
                nodeid: defn.nid
                lineno: defn.lineno
                colno: defn.colno
                e: zast.err.typeError
                msg: sm9
                note: sn9
                hint: sh9
                width: sfTy.length.u32.orPanic
            )
            return
        }
        sfT: walkLookupTyperef :st :frame :ast :unitDecl base: sfTy
        match (
            sfT
        ) case some then {
            # keyed on the constant's OWNER -- the namespace, block or
            # file unit it is written in -- as the value channel keys
            # it, not on the file unit by name (which leaked a nested
            # unit's constant into the file unit's index)
            sfU: (declTypeIdOf
                :st
                declId: (constOwnerDeclFor :st :frame :ast :unitDecl :defName)
            )
            if (sfU.isZero) == false then {
                (st.typing.setMemberType
                    parentTypeId: sfU
                    nameId: (zast.poolFind pool: ast.names text: defName)
                    childTypeId: sfT
                )
            }
        } case none then null
    }
}
# resolveBinopConstantDef -- a unit-level constant whose value is a binary
# expression folds here, and a fold that fails is reported: a definition at unit
# level is required to be a compile-time constant.
resolveBinopConstantDef: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    defnId: zast.nodeid
} is {
    # A constant expression (`COMBINED: OFFSET + SCALE`): the operand
    # walk stamps the refs and the binop; a literal result materialises
    # to its default, a concrete one (an already-materialised constant)
    # keeps it.
    bt: constantOperandType :st :frame :ast :unitDecl nid: defnId
    base2: ""
    if bt == st.reg.literalIntTid then base2 = "i64"
    if bt == st.reg.literalFloatTid then base2 = "f64"
    if base2.length > 0 then {
        mOpt: walkLookupTyperef :st :frame :ast :unitDecl base: base2
        match (
            mOpt
        ) case some then {
            cu2: (declTypeIdOf
                :st
                declId: unitDecl
            )
            if (cu2.isZero) == false then {
                (st.typing.setMemberType
                    parentTypeId: (ztypes.tid.create from: cu2.u64)
                    nameId: (zast.poolFind pool: ast.names text: defName)
                    childTypeId: mOpt
                )
            }
        } case none then null
    } else {
        if bt > 0 then {
            cu3: (declTypeIdOf
                :st
                declId: unitDecl
            )
            if (cu3.isZero) == false then {
                (st.typing.setMemberType
                    parentTypeId: (ztypes.tid.create from: cu3.u64)
                    nameId: (zast.poolFind pool: ast.names text: defName)
                    childTypeId: bt
                )
            }
        }
    }
}
# resolveCalledConstantDef -- a unit-level constant whose value is a CALL. A
# construction is not a literal, but the parenthesised form is the generic-unit
# instantiation (`intmath: (genmath t: i64)`) and stays legal -- its callee names
# a UNIT, which is the test here. A unit declared in THIS file has no registry
# entry yet and a generic-unit binding is no file unit at all, so the Decl tree
# answers both.
# resolveInstantiatedAlias -- `Strs: (List String)`: a unit-level definition
# whose value INSTANTIATES a generic template NAMES the resulting mono, exactly
# as the bare (`Same: Holder`) and dotted (`Nd: zast.Node`) forms name a type.
# The alias shares the mono's canonical id and mints nothing of its own, so the
# id is recorded on the Decl and on the unit's member index the way
# resolveAliasKeyIn records the other two forms. false when the instantiation
# does not resolve, which leaves the caller's diagnostic to fire.
resolveInstantiatedAlias: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    defn: callref
} out bool is {
    mt: (resolveMonoRefInline
        :st
        :frame
        :ast

        :unitDecl
        thisName: ""
        enclDecl: ztypes.declid
        opNid: defn.nid
        nid: 0
    )
    if mt == 0 then return false
    mtid: ztypes.tid.create from: mt
    adecl: declOfUnitDef :st :frame :unitDecl nameId: (nameIdOf :ast name: defName)
    if (adecl.isZero) == false then st.typing.declSetType declId: adecl typeId: mtid
    cu: (declTypeIdOf
        :st
        declId: (constOwnerDeclFor :st :frame :ast :unitDecl :defName)
    )
    if (cu.isZero) == false then {
        (st.typing.setMemberType
            parentTypeId: cu
            nameId: (zast.poolFind pool: ast.names text: defName)
            childTypeId: mtid
        )
    }
    return true
}

resolveCalledConstantDef: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    defn: callref
} is {
    # the callee's root name, read through a view scoped to this block: the
    # lookups below lend ast
    cbn: String
    {
        ccn: ast.nodes.get i: defn.callable.u64
        cbn = atomName :ast n: ccn
        if cbn.length == 0 then cbn = dottedRootName :ast n: ccn
    }
    if cbn.length > 0 then {
        # a unit declared in THIS file has no registry entry yet, and
        # a generic-unit binding is no file unit at all: the Decl tree
        # answers both -- without it every `intmath: (mathops t: i64)`
        # reads as a construction.
        cbu: nameDenotesUnit :st :frame nameId: (nameIdOf :ast name: cbn.stringView)
        if (cbu) == false then {
            # the same scope walk the instantiation collector uses --
            # this namespace, each enclosing one, the unit root, then a
            # file unit of that name. declOfUnitDef reached only a
            # TOP-LEVEL binding of this unit, so a template nested in a
            # namespace, or named through another unit, read as a
            # construction and was reported as a malformed constant.
            cscp: unitFrameOf :st declId: frame
            csg: (ListVal u64)
            instCallablePath :ast op: (ast.nodes.get i: defn.callable.u64) segs: csg
            cdc: instTemplateDecl :st scopeDeclId: cscp segs: csg
            if (cdc.isZero) == false then {
                cdo: st.typing.decls.get i: cdc.u64
                if cdo.kind.unitDecl then cbu = true
            }
        }
        # ASK THE CONSTANT FIRST, the same ordering the dotted-path
        # value read uses: `CT: (LIB.contains needle: "x")` is a call
        # whose receiver is a string CONSTANT, so it is a value and not
        # a construction. Classifying by the callee's shape alone calls
        # every static string method a construction.
        if (cbu) == false then {
            crv: (constValueOfMember
                :st
                :frame
                :ast

                :unitDecl
                defName: cbn.stringView
            )
            if crv.kind.svalKind then cbu = true
        }
        if (cbu) == false then {
            ckn: false
            ctpl: u64
            {
                cko: (walkLookupTyperef
                    :st
                    :frame
                    :ast

                    :unitDecl
                    base: cbn.stringView
                )
                match (
                    cko
                ) case some then {
                    ckn = true
                    ctpl = cko
                } case none then null
            }
            # a GENERIC template is the one callee shape that can be
            # INSTANTIATED rather than constructed, so `Strs: (List String)`
            # is a type alias while `origin: Point.create x: 0` stays a
            # construction: `create` is a member of a concrete type and is not
            # generic.
            if ctpl > 0 then {
                cgen: false
                if ctpl < st.reg.typeById.length then {
                    ctr: st.reg.typeById.get i: ctpl
                    cgen = ctr.isgeneric
                }
                if cgen when (resolveInstantiatedAlias
                    :ast
                    :st
                    :unitDecl
                    :frame
                    :defName
                    :defn
                ) then cbu = true
            }
            if (ckn) == false then {
                crm: "Unknown reference '\{cbn}'"
                (reportUnitConstantRef
                    :st
                    nodeid: defn.nid
                    lineno: defn.lineno
                    colno: defn.colno
                    width: cbn.length.u32.orPanic
                    msg: crm
                )
                cbu = true
            }
        }
        if (cbu) == false then {
            cm: "a unit-level constant takes a literal value, not a construction".string
            ch: "construct it inside a function, or make '\{defName}' a function that returns the value"
            (reportUnitConstantShape
                :st
                nodeid: defn.nid
                lineno: defn.lineno
                colno: defn.colno
                width: cbn.length.u32.orPanic
                msg: cm
                hint: ch
            )
        }
    }
}


# resolveConstantDef -- one definition: an (expression-wrapped) numeric-literal
# atomid is a unit constant, recorded as the literal's concrete default (i64 /
# f64, which materialiseLiteral demands). The definition's own nodes stay
# unstamped.
resolveConstantDef: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    defnId: zast.nodeid
} is {
    arm: rowArmAt :ast nid: defnId
    match (
        arm
    ) case expression then {
        wrap: exprRefAt :ast nid: defnId
        (resolveUnitIfDef
            :st
            :frame
            :ast

            :unitDecl
            :defName
            wrapperId: defnId
            nid: wrap.expression
        )
        resolveConstantDef :st :frame :ast :unitDecl :defName defnId: wrap.expression
    } case dottedpath then {
        # a width-suffixed numeric literal (`1.u32`) is a dotted path over the
        # literal, not an atom: the child names the constant's type
        dr: dpRefAt :ast nid: defnId
        sfLit: String
        sfTy: String
        {
            sfB: ast.nodes.get i: dr.parent.u64
            if sfB.atomid then sfLit = zast.nameTextCopy :ast ref: sfB.name
        }
        {
            sfC: ast.nodes.get i: dr.child.u64
            if sfC.atomid then sfTy = zast.nameTextCopy :ast ref: sfC.name
        }
        if sfLit.length > 0 when sfTy.length > 0 then {
            (resolveDottedConstantDef
                :ast
                :st
                :unitDecl
                :frame
                :defName
                defn: dr
                sfLit: sfLit.stringView
                sfTy: sfTy.stringView
            )
        }
    } case atomid then {
        ar: atomRefAt :ast nid: defnId
        # an owned copy: the lookup below lends ast
        dfN: zast.nameTextCopy :ast ref: ar.name
        if (isNumericLiteralName name: dfN.stringView) then {
            base: "i64"
            if (isFloatLiteralName name: dfN.stringView) then base = "f64"
            tOpt: walkLookupTyperef :st :frame :ast :unitDecl :base
            match (
                tOpt
            ) case some then {
                cu: (declTypeIdOf
                    :st
                    declId: (constOwnerDeclFor :st :frame :ast :unitDecl :defName)
                )
                if (cu.isZero) == false then {
                    (st.typing.setMemberType
                        parentTypeId: cu
                        nameId: (zast.poolFind pool: ast.names text: defName)
                        childTypeId: tOpt
                    )
                }
            } case none then null
        }
        # a NON-numeric bare name is the unit-level alias form (`Same: Holder`),
        # which resolveDef registers -- it is not this pass's business.
    } case call then {
        # A construction is not a literal. The PARENTHESISED call is the
        # generic-unit instantiation form (`intmath: (genmath t: i64)`) and
        # stays legal -- its callee names a UNIT, which is the test here; the
        # definition arms (functiondef, objectdef, unitdef, datablock) reach
        # this leg too and must never be reported.
        cdr: callRefAt :ast nid: defnId
        (resolveCalledConstantDef
            :ast
            :st
            :unitDecl
            :frame
            :defName
            defn: cdr
        )
    } case binop then {
        (resolveBinopConstantDef
            :ast
            :st
            :unitDecl
            :frame
            :defName
            :defnId
        )
    } else null
}

# constRegisterValueType -- give a constant the type of its VALUE, for the
# shapes the shape-driven pass registers nothing for: a string literal, a
# concatenation, and any of the static string methods (`LIB.length` is an i64,
# `LIB.startsWith ...` a bool). A constant IS its value, so its type is the
# value's.
#
# A folded string types as StringView, never String, whatever produced it. The
# fold replaces the call outright and the value materialises as a static view
# -- nothing is allocated and nothing is owned -- so typing it String would
# hand a use site an owned type backed by a static. `+`'s declared `out String`
# governs the RUN-TIME path only.
#
# The shape-driven registrations win wherever they spoke: they know about
# typedefs and literal suffixes that a value does not carry.
constRegisterValueType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    v: ztypes.cval
} is {
    if v.kind.none then return
    nid0: zast.poolFind pool: ast.names text: defName
    if nid0.isZero then return
    ownerDecl9: (constOwnerDeclFor :st :frame :ast :unitDecl :defName)
    (constRegisterValueTypeAt
        :st
        :frame
        :ast

        ownerDecl: ownerDecl9
        nameId: nid0
        :v
    )
}

# constRegisterValueTypeAt -- the registration itself, addressed by the owner's
# declaration. A constant's type is the one its VALUE carries, so this is where
# a constant becomes a member of its owner at all.
constRegisterValueTypeAt: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ownerDecl: ztypes.declid
    nameId: zast.nameid
    v: ztypes.cval
} is {
    if v.kind.none then return
    utid: declTypeIdOf :st declId: ownerDecl
    if utid.isZero then return
    nid: nameId
    if nid.isZero then return
    {
        eo: st.typing.declChildOfId parentTypeId: utid nameId: nid
        if (eo.none) == false then return
    }
    if v.kind.armKind then {
        if v.armTid.isZero then return
        (st.typing.setMemberType
            parentTypeId: utid
            nameId: nid
            childTypeId: v.armTid.u64
        )
        return
    }
    recvBaseTid: ""
    if v.kind.ivalKind then recvBaseTid = "i64"
    if v.kind.fvalKind then recvBaseTid = "f64"
    if v.kind.svalKind then recvBaseTid = "StringView"
    if recvBaseTid.length == 0 then return
    # the constant's type is a reference to a system type: it resolves on
    # discovery, like every other reference, so the registration never depends
    # on some other reference having resolved the type first
    bo: descendNamed :st :frame :ast unitDecl: st.typing.systemUnitRoot name: recvBaseTid
    if bo > 0 then st.typing.setMemberType parentTypeId: utid nameId: nid childTypeId: bo.u64
}

# instantiatedAliasFold -- the alias-shaped door into constFoldDecl. A
# unit-level definition whose value INSTANTIATES a generic template declares a
# TYPE, not a constant, and like a constant it declares itself when it is first
# READ: a signature mentioning `Strs` may be resolved before the eager pass
# reaches `Strs: (List String)`, and without this door it would resolve to a
# shell of that name while the values carry the mono. false when the definition
# is not that shape, which leaves the fold to the constant channel.
instantiatedAliasFold: function {
    ast: Ast
    st: zenv.ZSymbolTable
    declId: ztypes.declid
} out bool is {
    dnode: u32
    {
        decl: st.typing.decls.get i: declId.u64
        dnode = decl.node
    }
    if dnode == 0 then return false
    opId: zast.nodeid
    {
        nop: ast.nodes.get i: dnode.u64
        if nop.namedoperation then opId = nop.operation
    }
    if opId.isZero then return false
    {
        o: ast.nodes.get i: opId.u64
        match (
            o
        ) case expression then opId = o.expression else null
    }
    if opId.isZero then return false
    isCall: false
    {
        arm: rowArmAt :ast nid: opId
        if arm.call then isCall = true
    }
    if (isCall) == false then return false
    own: declParentIdOf :st :declId
    if own.isZero then return false
    unm: unitRootOfDecl :st :declId
    if unm.isZero then return false
    dnm: zast.poolTextAt pool: ast.names ref: (declNameIdOf :st :declId)
    if dnm.length == 0 then return false
    cdr: callRefAt :ast nid: opId
    return (resolveInstantiatedAlias
        :ast
        :st
        unitDecl: unm
        frame: own
        defName: dnm.stringView
        defn: cdr
    )
}

# constFoldDecl -- fold the constant `declId` declares and register the type its
# value carries, addressed by the DECLARATION alone. This is the door a lookup
# takes when it finds a constant that has not folded yet: a constant's TYPE
# comes from its VALUE, so the fold is what declares it, exactly as an
# unresolved re-export is declared by following its alias.
constFoldDecl: function {
    ast: Ast
    st: zenv.ZSymbolTable
    declId: ztypes.declid
} is {
    if declId.isZero then return
    if (instantiatedAliasFold :ast :st :declId) then return
    own: declParentIdOf :st :declId
    if own.isZero then return
    nmNode: declNameIdOf :st :declId
    if nmNode.isZero then return
    dnode: 0
    {
        decl: st.typing.decls.get i: declId.u64
        dnode = decl.node
    }
    if dnode == 0 then return
    unm: unitRootOfDecl :st :declId
    if unm.isZero then return
    constFailClear :st
    valFound: (constValueOfMemberAt
        :st
        :ast

        unitDecl: unm
        ownerDecl: own
        nameId: nmNode
        defNodeId: dnode
    )
    (constRegisterValueTypeAt
        :st
        frame: own
        :ast

        ownerDecl: own
        nameId: nmNode
        v: valFound
    )
    reportPendingConstFail :st
}

# resolveConstantMember -- one unit-level definition's constant channels, both
# of them. The TYPE channel is shape-driven (`resolveConstantDef` registers the
# literal, suffixed-literal and constant-expression forms and reports the ones
# that are neither); the VALUE channel evaluates and memoises, and hands its
# result back so a value-typed constant -- a string, a concatenation, an arm --
# registers the type its value carries.
#
# Source order drives the visit but not the evaluation: each pull descends into
# whatever it names and memoises, so a definition already reached as a
# dependency is a no-op here and one written before its dependency still works.
# That is what lets the same entry point serve the demand path and the eager
# walk without the two drifting.
resolveConstantMember: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    defnId: zast.nodeid
} is {
    constFailClear :st
    resolveConstantDef :st :frame :ast :unitDecl :defName :defnId
    cvv: constValueOfMember :st :frame :ast :unitDecl :defName
    constRegisterValueType :st :frame :ast :unitDecl :defName v: cvv
    reportPendingConstFail :st
}

# resolve a unit's compile-time constant definitions.
resolveConstantDefsInUnit: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    unitdefId: zast.nodeid
} is {
    rd: ztypes.declid
    {
        ro: unitDecl
        if (ro.isZero) == false then rd = ro
    }
    (resolveConstantDefsIn
        :st
        :frame
        :ast

        :unitDecl
        :unitdefId
        ownerDeclId: rd
    )
}

# resolveConstantDefsIn -- the walk resolveConstantDefsInUnit drives, once for
# the file unit and once for each namespace or template nested in it, with
# `ownerDeclId` as the frame: a nested unit's constants key on that unit
# (constOwnerDeclFor climbs the frame's chain), the file unit's on the unit.
resolveConstantDefsIn: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    unitdefId: zast.nodeid
    ownerDeclId: ztypes.declid
} is {
    if (st.typing.nsConstsWalked.has item: unitdefId.u64) then return
    st.typing.nsConstsWalked.add item: unitdefId.u64
    rf: frame
    if (ownerDeclId.isZero) == false then rf = ownerDeclId
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    {
        biter: bodyIds.iterate
        for bm: biter loop {
            bmNode: argRefAt :ast nid: (zast.nodeid.create from: bm.u32)
            if (bmNode.nid.isZero) == false then {
                # an owned copy: the walks below lend ast
                defName: zast.nameTextCopy :ast ref: bmNode.name
                isNs: false
                if (zast.unitOpKindIs
                    :ast
                    opId: bmNode.operation
                    k: zast.unitkind.namespace
                ) then isNs = true
                if (zast.unitOpKindIs
                    :ast
                    opId: bmNode.operation
                    k: zast.unitkind.subunit
                ) then isNs = true
                # a generic template's constants are its own too, keyed on the
                # template's id (the def-node stamp resolveInlineGenericUnit
                # lays); a template nothing resolved yet has none to key on
                # and is skipped, and its members' demand resolves them
                if (zast.unitOpKindIs
                    :ast
                    opId: bmNode.operation
                    k: zast.unitkind.template
                ) then isNs = true
                if (zast.unitOpKindIs
                    :ast
                    opId: bmNode.operation
                    k: zast.unitkind.publicNs
                ) then isNs = true
                if isNs then {
                    ct: ztypes.tid
                    {
                        un: unitdefNodeId :ast nId: bmNode.operation
                        if (un.isZero) == false then {
                            ct = (ztypes.tid.create
                                from: (ztyping.nodeTypeAt tbl: st.typing.nodeType nid: un.u64)
                            )
                        }
                    }
                    if (ct.isZero) == false then {
                        ownerCd9: (st.typing.declFindChild
                            parentDeclId: ownerDeclId
                            nameId: bmNode.name
                        )
                        (resolveConstantDefsIn
                            :st
                            frame: rf
                            :ast

                            :unitDecl
                            unitdefId: bmNode.operation
                            ownerDeclId: ownerCd9
                        )
                    }
                } else if defName.length > 0 then {
                    # a template's generic PARAMETER (`t: anyval.generic`,
                    # `cap: u32.generic`) is a parameter, not a constant; a
                    # `public:` block's reference entry is an edge to a
                    # sibling, whose own unit resolves it
                    isEdge: false
                    {
                        ed: st.typing.declFindChild parentDeclId: ownerDeclId nameId: bmNode.name
                        edp: declParentIdOf :st declId: ed
                        if (ed.isZero) == false when edp != ownerDeclId then isEdge = true
                    }
                    if (isEdge) == false when (isGenericParam
                        :ast
                        op: (ast.nodes.get i: bmNode.operation.u64)
                    ) == false then {
                        (resolveConstantMember
                            :st
                            frame: rf
                            :ast

                            :unitDecl
                            defName: defName.stringView
                            defnId: (zast.nodeid.create from: bmNode.operation.u32)
                        )
                    }
                }
            }
        }
    }
}

# ccKindArm -- the `cckind` arm a resolved compiler PATH names, by basename.
# By name alone: probing --version would put a subprocess in every compile, so
# a --cc pointing at a wrapper script reads as `other` and a guard keyed on one
# compiler will not fire for it. `tcc` is tested before `cc` and `clang` before
# `gcc`, since the shorter spelling is a substring of paths naming the longer.
ccKindArm: function {ccPath: StringView} out String is {
    b: ccPath
    i: ccPath.length
    for i > 0 loop {
        i = i - 1
        ch: ccPath.byteAt i
        match (
            ch
        ) case some then {
            if ch == 47 then {
                b = ccPath.substring from: (i + 1) to: ccPath.length
                i = 0
            }
        } case none then null
    }
    if (b.contains needle: "tcc") then return "tcc".string
    if (b.contains needle: "clang") then return "clang".string
    if (b.contains needle: "gcc") then return "gcc".string
    return "other".string
}

# namesArm -- whether `comp`, one `-` separated component of a --target
# triple, is one of the space-separated `spellings` that name a single
# platform arm. The vocabulary is DATA passed in rather than a chain of
# comparisons in the caller: the spelling is the datum for external text --
# there is no name id for "mingw32" -- so the whole parser gets by on the one
# literal compare made here.
namesArm: function {spellings: StringView comp: StringView} out bool is {
    with it9n: (spellings.split sep: " ") do for s9n: it9n loop {
        if s9n == comp then return true
    }
    return false
}

# tripleOsNames -- the DISTINCT `oskind` arm names a --target triple asks for,
# space-separated. Empty when it names none, two words when it names two --
# both of which are errors, not a fall back to the host and not last-write-wins.
#
# Components are matched WHOLE, split on `-`, never as substrings. A
# `contains needle: "linux"` test cannot fail, so it cannot report failure: it
# read the host into every unknown triple, and `x86_64-linux-windows` resolved
# to whichever test happened to run last. Several spellings name one arm
# (`apple` and `darwin`; `mingw32` and `windows`), so what is counted here is
# the resolved VALUES and not the hits -- `x86_64-apple-darwin` names one.
tripleOsNames: function {triple: StringView} out String is {
    hasLinux: false
    hasDarwin: false
    hasWindows: false
    with it9t: (triple.split sep: "-") do for c9t: it9t loop {
        if (namesArm spellings: "linux" comp: c9t) then hasLinux = true
        if (namesArm spellings: "darwin apple macos" comp: c9t) then hasDarwin = true
        if (namesArm spellings: "windows mingw32 mingw msvc" comp: c9t) then hasWindows = true
    }
    r: String
    if hasLinux then r.append "linux"
    if hasDarwin then {
        if r.length > 0 then r.append " "
        r.append "darwin"
    }
    if hasWindows then {
        if r.length > 0 then r.append " "
        r.append "windows"
    }
    return r
}

# tripleArchNames -- the DISTINCT `archkind` arm names a --target triple asks
# for, on the same contract as tripleOsNames.
tripleArchNames: function {triple: StringView} out String is {
    hasX86: false
    hasArm: false
    with it9a: (triple.split sep: "-") do for c9a: it9a loop {
        if (namesArm spellings: "x86_64 amd64" comp: c9a) then hasX86 = true
        if (namesArm spellings: "aarch64 arm64" comp: c9a) then hasArm = true
    }
    r: String
    if hasX86 then r.append "x86_64"
    if hasArm then {
        if r.length > 0 then r.append " "
        r.append "aarch64"
    }
    return r
}

# oneNameOf -- the single name in a tripleOsNames/tripleArchNames answer, or ""
# when it named none or several. The two failures read the same here because
# both mean "no arm to seed"; targetTripleError tells them apart for the user.
oneNameOf: function {names: StringView} out String is {
    if names.length == 0 then return "".string
    if (names.contains needle: " ") then return "".string
    return names.string
}

# targetTripleError -- "" when `--target <triple>` names exactly one operating
# system and exactly one architecture zc models, else the message to print.
# Multi-line: the first line says what is wrong with the triple given, the rest
# list the vocabulary, which lives here beside the tables rather than at the
# flag so the two cannot drift.
#
# An empty triple is not an error -- it means a native build.
targetTripleError: function {triple: StringView} out String is {
    if triple.length == 0 then return "".string
    osn: tripleOsNames :triple
    arn: tripleArchNames :triple
    osv: osn.stringView
    arv: arn.stringView
    bad: String
    if osn.length == 0 then {
        bad.append "--target '\{triple}' names no operating system zc can build for"
    } else if (osv.contains needle: " ") then {
        bad.append "--target '\{triple}' names more than one operating system (\{osv})"
    } else if arn.length == 0 then {
        bad.append "--target '\{triple}' names no architecture zc can build for"
    } else if (arv.contains needle: " ") then {
        bad.append "--target '\{triple}' names more than one architecture (\{arv})"
    } else {
        return "".string
    }
    bad.append "\n  operating systems: linux, windows (also mingw32, mingw, msvc), darwin (also apple, macos)"
    bad.append "\n  architectures: x86_64 (also amd64), aarch64 (also arm64)"
    return bad
}

# targetOsName / targetArchName -- the single arm name a --target triple asks
# for, or "" when it names none or several (both of which zc refuses at the
# flag) and for an empty triple. Everything that needs to ASK about the target
# comes through these rather than through a substring of the triple.
targetOsName: function {triple: StringView} out String is {
    if triple.length == 0 then return "".string
    osn: tripleOsNames :triple
    return (oneNameOf names: osn.stringView)
}

targetArchName: function {triple: StringView} out String is {
    if triple.length == 0 then return "".string
    arn: tripleArchNames :triple
    return (oneNameOf names: arn.stringView)
}

# targetOrHostOs / targetOrHostArch -- what the build is FOR: the --target
# triple decides when one is given, and the host the compiler runs on
# otherwise. A cross --cc used WITHOUT --target therefore leaves these
# describing the host, which the docs say plainly. An unresolved half also
# keeps the host value: zc refuses such a triple at the flag, and a front end
# that never validated one is better served by the host than by a guess.
targetOrHostOs: function {triple: StringView} out String is {
    o9r: targetOsName :triple
    if o9r.length > 0 then return o9r
    return os.hostOsName
}

targetOrHostArch: function {triple: StringView} out String is {
    a9r: targetArchName :triple
    if a9r.length > 0 then return a9r
    return os.hostArchName
}

# targetExeSuffix -- the extension an executable built for this target carries.
# It lives beside the vocabulary because it IS a question about the vocabulary:
# no real mingw triple spells "windows", so asking the triple for the substring
# left `x86_64-w64-mingw32` -- the example the docs give -- without a suffix.
targetExeSuffix: function {triple: StringView} out String is {
    osn: targetOsName :triple
    if (namesArm spellings: "windows" comp: osn.stringView) then return ".exe".string
    return "".string
}

# targetIsHost -- true when `--target <triple>` names the machine zc is running
# on, and for an empty triple. The build path refuses a CROSS target its
# resolved compiler cannot evidently reach; a host target needs no such check.
# An unresolvable triple answers true, because targetTripleError has already
# refused it and a second complaint about the same string helps nobody.
targetIsHost: function {triple: StringView} out bool is {
    if triple.length == 0 then return true
    osn: tripleOsNames :triple
    arn: tripleArchNames :triple
    o9h: oneNameOf names: osn.stringView
    a9h: oneNameOf names: arn.stringView
    if o9h.length == 0 then return true
    if a9h.length == 0 then return true
    ho: os.hostOsName
    ha: os.hostArchName
    if (o9h.stringView == ho.stringView) == false then return false
    if (a9h.stringView == ha.stringView) == false then return false
    return true
}

# seedFoldNatives -- answer the compile-time values THIS TABLE names.
#
# natives.tbl is what says which paths the compiler answers; this walks its
# `fold` rows and asks foldProviderOf for each one. A row the compiler has no
# answer for is an error here: the table would otherwise promise a value that
# nothing supplies, which is the shape a bodyless native had before any of this
# was checked. The other direction -- a native declaration with no row -- is
# checkNativesResolve's, at the declaration.
#
# Silent for a unit this program never loads. A row is a fact about the
# compiler; a SEED is a fact about a program, and there is no member table to
# write onto for a unit that is not here.
seedFoldNatives: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
} is {
    # copied out first: every lookup below lends st, and the list is its field
    paths9: (List String)
    with fpit: st.typing.foldPaths.iterate do for fp: fpit loop paths9.append from: fp.copy
    with pit9: paths9.iterate do for pth9: pit9 loop {
        pv9: pth9.stringView
        dotp9: pv9.indexOf needle: "."
        match (
            dotp9
        ) case some then {
            un9: pv9.substring from: 0 to: dotp9
            mem9: pv9.substring from: (dotp9 + 1) to: pv9.length
            if (mem9.contains needle: ".") then {
                mf9: "natives.tbl: `fold` row '\{pv9}' is not a free function <unit>.<name>"
                (addError
                    :st
                    nodeid: (zast.nodeid.create from: 0)
                    lineno: 0
                    colno: 0
                    e: zast.err.compilerError
                    msg: mf9
                )
            } else {
                unm9: nameIdOf :ast name: un9
                mnm9: nameIdOf :ast name: mem9
                if (unm9.isZero) == false then {
                    ud9: unitDeclOfNameOrOwn :st :frame nameId: unm9
                    ptid9: (ztypes.tid.create from: (declTypeIdOf :st declId: ud9).u64)
                    if (ptid9.isZero) == false then {
                        # the answers are that unit's own definitions, so they
                        # resolve in its frame where it has one
                        rf9: frame
                        {
                            pro9: (st.typing.declFindChild
                                parentDeclId: st.typing.programRoot
                                nameId: unm9
                            )
                            if (pro9.isZero) == false then rf9 = pro9
                        }
                        prov9: foldProviderOf :ast unitNm: unm9 memberNm: mnm9
                        if prov9 == 0 then {
                            mp9: "natives.tbl marks '\{pv9}' `fold`, but this compiler answers no such value"
                            (addError
                                :st
                                nodeid: (zast.nodeid.create from: 0)
                                lineno: 0
                                colno: 0
                                e: zast.err.compilerError
                                msg: mp9
                            )
                        } else {
                            (applyFoldProvider
                                :st
                                :frame
                                unitFrame: rf9
                                :ast
                                ptid: ptid9
                                prov: prov9
                            )
                        }
                    }
                }
            }
        } case none then null
    }
}

# foldProviderOf -- which compile-time answer a path names, as a 1-based index
# into applyFoldProvider's arms; 0 for a path this compiler cannot answer.
#
# Keyed by NAME IDS, not by the spelling: the ids are what every other table
# here compares, and routing by a literal is what the architecture rules count.
# BOTH zeros are refused first. A name the program never mentions is not in the
# pool and answers 0, and a nameless node answers 0 too -- so an unguarded
# compare would match every path at once in exactly the programs that never
# name the unit.
foldProviderOf: function {
    ast: Ast.view
    unitNm: zast.nameid
    memberNm: zast.nameid
} out u64 is {
    if unitNm.isZero then return 0
    if memberNm.isZero then return 0
    pun: nameIdOf :ast name: "platform"
    if pun.isZero then return 0
    if (unitNm == pun) == false then return 0
    if memberNm == (nameIdOf :ast name: "os") then return 1
    if memberNm == (nameIdOf :ast name: "arch") then return 2
    if memberNm == (nameIdOf :ast name: "cc") then return 3
    if memberNm == (nameIdOf :ast name: "ccmode") then return 4
    if memberNm == (nameIdOf :ast name: "target") then return 5
    return 0
}

# applyFoldProvider -- write one compile-time answer onto the member-constant
# table. Takes foldProviderOf's INDEX rather than a name: the path is resolved
# once, at the lookup, and everything downstream of it compares integers.
#
# os and arch resolve their arm in the platform unit's own frame; cc and ccmode
# in the caller's. That difference is the seeding this replaced, kept as it was.
applyFoldProvider: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    unitFrame: ztypes.declid
    ptid: ztypes.tid
    prov: u64
} is {
    if prov == 1 then {
        osn: targetOrHostOs triple: st.typing.targetTriple.stringView
        (seedPlatformArm
            :st
            frame: unitFrame
            :ast

            :ptid
            member: "os"
            typeName: "oskind"
            armName: osn.stringView
        )
        return
    }
    if prov == 2 then {
        arn: targetOrHostArch triple: st.typing.targetTriple.stringView
        (seedPlatformArm
            :st
            frame: unitFrame
            :ast

            :ptid
            member: "arch"
            typeName: "archkind"
            armName: arn.stringView
        )
        return
    }
    if prov == 3 then {
        cka: ccKindArm ccPath: st.typing.ccPath.stringView
        (seedPlatformArm
            :st
            :frame
            :ast :ptid
            member: "cc"
            typeName: "cckind"
            armName: cka.stringView
        )
        return
    }
    if prov == 4 then {
        # the mode needs no classifier: it arrives as an arm name already,
        # having been validated at the flag. An unset one is answered `spawn`
        # HERE, in the open. It used to answer by seeding nothing and leaving
        # the on-disk default, which was `spawn` too -- the same answer, arrived
        # at by luck, and there is no file to fall back to now.
        ccModeC: st.typing.ccMode.copy # copied out first: seeding lends st
        if ccModeC.length == 0 then ccModeC = "spawn".string
        (seedPlatformArm
            :st
            :frame
            :ast :ptid
            member: "ccmode"
            typeName: "ccmodekind"
            armName: ccModeC.stringView
        )
        return
    }
    if prov == 5 then {
        tripleC: st.typing.targetTriple.copy
        value9: (ztypes.makeStrConst (constInternString :st text: tripleC.stringView))
        (seedPlatformValue
            :st
            :ptid
            :ast
            member: "target"
            value: value9
        )
        return
    }
}

# seedPlatformArm -- one platform member, as an arm of one of its kinds.
seedPlatformArm: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ptid: ztypes.tid
    member: StringView
    typeName: StringView
    armName: StringView
} is {
    lookupUnit92: (unitDeclOfNameOrOwn :st :frame nameId: (nameIdOf :ast name: "platform"))
    valFound: (constArmRead
        :st
        :frame
        :ast

        lookupUnit: lookupUnit92
        :typeName
        :armName
    )
    if valFound.kind.none then return
    (seedPlatformValue :st :ptid :ast :member value: valFound)
}

# seedPlatformValue -- record the value and mark the member EVALUATED, so the
# on-demand walk returns this instead of folding the placeholder on disk.
seedPlatformValue: function {
    st: zenv.ZSymbolTable
    ptid: ztypes.tid
    ast: Ast.view
    member: StringView
    value: ztypes.cval
} is {
    nid: zast.poolFind pool: ast.names text: member
    if nid.isZero then return
    st.typing.setMemberConst parentTypeId: ptid nameId: nid :value
    (st.typing.constEvalState.set
        key: (st.typing.memberConstKey parentTypeId: ptid nameId: nid)
        value: 2.u8
    )
}

# resolveConstantDefs -- materialise every unit's constant definitions, so a
# constant is a member of the unit that declares it and `unit.NAME` resolves
# across units the way
# `unit.fn` does. Runs post-demand so the numeric defaults are already resolved.
resolveConstantDefs: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    program: Node
} is {
    # the eager tier's answer to "what are this program's constants": every
    # definition of every unit, so one nothing references is still checked.
    # The lazy tier resolves a constant where it is demanded, in
    # resolveDemandedDecl, and this walk does not run at all.
    if (st.typing.eagerAll) == false then return
    match (
        program
    ) case program then {
        # stage (unit name, unit body) first: the call below takes an exclusive
        # lock on program.ast, which cannot run while the unit-row iteration
        # holds a shared one
        unms: (List String)
        uops: (ListVal u32)
        {
            uiter: program.ast.units.iterate
            for uId: uiter loop {
                u: program.ast.nodes.get i: uId.u64
                match (
                    u
                ) case namedoperation then {
                    nm: zast.poolTextAt pool: program.ast.names ref: u.name
                    if nm.length > 0 then {
                        unms.append nm.copy
                        uop: u.operation
                        uops.append uop
                    }
                } else null
            }
        }
        ui: u64
        un: unms.length
        for ui < un loop {
            unm: unms.get i: ui
            unmId: nameIdOf ast: program.ast name: unm.stringView
            udU: unitDeclOfNameOrOwn :st :frame nameId: unmId
            (resolveConstantDefsInUnit
                :st
                :frame

                ast: program.ast
                unitDecl: udU
                unitdefId: (zast.nodeid.create from: (uops.get i: ui))
            )
            ui = ui + 1
        }
    } else null
}

# unitHasYieldFn -- any function member of this unit whose body suspends.
unitHasYieldFn: function {ast: Ast.view unitdefId: zast.nodeid} out bool is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    biter: bodyIds.iterate
    for bm: biter loop {
        bmNode: ast.nodes.get i: bm.u64
        if bmNode.namedoperation then {
            if (zgenerator.fnBodyHasYield
                :ast
                n: (ast.nodes.get i: bmNode.operation.u64)
            ) then return true
            if (objectHasYieldMethod
                :ast
                n: (ast.nodes.get i: bmNode.operation.u64)
            ) then return true
        }
    }
    return false
}

# objectHasYieldMethod -- any is/as member of an object definition whose
# body suspends.
objectHasYieldMethod: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case objectdef then {
        aiter: n.asItems.iterate
        for amId: aiter loop {
            am: ast.nodes.get i: amId.u64
            match (
                am
            ) case namedoperation then {
                if (zgenerator.fnBodyHasYield
                    :ast
                    n: (ast.nodes.get i: am.operation.u64)
                ) then return true
            } else null
        }
        iiter: n.isItems.iterate
        for imId: iiter loop {
            im: ast.nodes.get i: imId.u64
            match (
                im
            ) case namedoperation then {
                if (zgenerator.fnBodyHasYield
                    :ast
                    n: (ast.nodes.get i: im.operation.u64)
                ) then return true
            } else null
        }
        return false
    } else {
        return false
    }
}

# resolveNamedDefsIn -- resolve exactly the named top-level defs of one
# unit. The generator pass runs pre-index (no node finder, no descent), so
# it walks the unitdef it already holds instead of the demand machinery.
resolveNamedDefsIn: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    unitdefId: zast.nodeid
    wantA: StringView
    wantB: StringView
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    {
        biter: bodyIds.iterate
        for bm: biter loop {
            bmNode: argRefAt :ast nid: (zast.nodeid.create from: bm.u32)
            if (bmNode.nid.isZero) == false then {
                # an owned copy: the walks below lend ast
                dn: zast.nameTextCopy :ast ref: bmNode.name
                hit: false
                if dn.stringView == wantA then hit = true
                if dn.stringView == wantB then hit = true
                if hit then {
                    if (defWasResolved
                        :st
                        :frame
                        :unitDecl
                        nameId: bmNode.name
                    ) == false then {
                        (resolveDef
                            :st
                            :frame

                            :ast
                            :unitDecl
                            defName: dn.stringView
                            defnId: (zast.nodeid.create from: bmNode.operation.u32)
                        )
                    }
                }
            }
        }
    }
}

# lowerGenerators -- the generator lowering pass: for each unit, rewrite every
# yield-function whose
# declared return head resolves to the stdlib Iterator protocol into a
# synth iterator class + a factory. Runs before main-unit resolution so
# the rewritten definitions flow through the normal walk; the Iterator
# protocol resolves through a targeted demand only when a suspending
# function exists, so non-generator programs never touch it.
lowerGenerators: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    program: Node
} is {
    match (
        program
    ) case program then {
        anyYield: false
        uCnt9e: program.ast.units.length
        uIdx9e: u64
        for uIdx9e < uCnt9e loop {
            yuId: (zast.nodeid.create from: (program.ast.units.get i: uIdx9e))
            uIdx9e = uIdx9e + 1
            yOpId: zast.nodeid
            {
                yu: program.ast.nodes.get i: yuId.u64
                if yu.namedoperation then yOpId = yu.operation
            }
            if yOpId > 0 then {
                if (unitHasYieldFn
                    ast: program.ast
                    unitdefId: yOpId
                ) then anyYield = true
            }
        }
        if (anyYield) == false then return
        suN0: program.ast.units.length
        suI0: u64
        for suI0 < suN0 loop {
            suId: (zast.nodeid.create from: (program.ast.units.get i: suI0))
            suI0 = suI0 + 1
            sOpId: zast.nodeid
            {
                su: program.ast.nodes.get i: suId.u64
                if su.namedoperation then {
                    snm: zast.poolTextAt pool: program.ast.names ref: su.name
                    if snm.stringView == "system" then sOpId = su.operation
                }
            }
            if sOpId > 0 then {
                (resolveNamedDefsIn
                    :st
                    :frame

                    ast: program.ast
                    unitDecl: st.typing.systemUnitRoot
                    unitdefId: sOpId
                    wantA: "Iterator"
                    wantB: "optionval"
                )
            }
        }
        sysU: nameIdOf ast: program.ast name: "system"
        sysI: zast.poolFind pool: program.ast.names text: "Iterator"
        unitDecl912: (unitDeclOfName :st nameId: sysU)
        iterTid: (optU64Or
            o: (resolvedByIds
                :st
                ast: program.ast
                unitDecl: unitDecl912
                name: sysI
            )
            d: 0
        )
        if iterTid == 0 then return
        ui: u64
        un: program.ast.units.length
        for ui < un loop {
            uelId: (zast.nodeid.create from: (program.ast.units.get i: ui))
            ui = ui + 1
            uOpId: zast.nodeid
            uNm: zast.nameid
            {
                uel: program.ast.nodes.get i: uelId.u64
                if uel.namedoperation then {
                    uOpId = uel.operation
                    uNm = uel.name
                }
            }
            if uOpId > 0 then {
                (lowerGeneratorsInUnit
                    :st
                    ast: program.ast
                    unitNameId: uNm
                    unitdefId: uOpId
                )
            }
        }
    } else null
}
# lowerFreeGenerators -- lower each free-function generator in the unit body into
# its state class and driver, staging the synth classes on a local list: the
# element view of the body list ends with each iteration, so it must not grow
# underneath the walk.
lowerFreeGenerators: function {
    st: zenv.ZSymbolTable
    ast: Ast
    bodyIds: (ListVal u32).view
    cIdx: (ListVal u64).view
    stagedCls: (List Node)
} is {
    ci: u64
    cn: cIdx.length
    for ci < cn loop {
        idx: cIdx.get i: ci
        uel2Id: bodyIds.get i: idx
        # scope the row view: lowering appends to the table below, and a
        # live row view must not span a growing append
        opId: zast.nodeid
        dnm: String
        {
            uel2: ast.nodes.get i: uel2Id.u64
            match (
                uel2
            ) case namedoperation then {
                dnm = zast.nameTextCopy :ast ref: uel2.name
                opId = uel2.operation
            } else null
        }
        if opId > 0 then {
            sname: "\{dnm}_iter"
            fnNode: zast.tableTake :ast id: opId
            lowOpt: (zgenerator.lowerOne :ast
                fn: fnNode
                synthName: sname.stringView
                receiverType: ""
            )
            match (
                lowOpt
            ) case some then {
                wfid: lowOpt.wrapperNodeId
                wfv: true
                st.typing.generatorWrapper.set key: wfid.u64 value: wfv
                # the create-param and field-path clones must not stamp:
                # those nodes are shared with the factory, and each ref
                # carries exactly one stamp.
                nsi: u64
                nsn: lowOpt.noStamp.length
                for nsi < nsn loop {
                    ns0: lowOpt.noStamp.get i: nsi
                    nsk: ns0.u64
                    nsv: true
                    st.typing.noStampNode.set key: nsk value: nsv
                    nsi = nsi + 1
                }
                fac: lowOpt.factory.take
                facId: zast.tableAdd :ast n: fac
                {
                    uel2w: ast.nodes.getMut i: uel2Id.u64
                    match (
                        uel2w
                    ) case namedoperation then {
                        uel2w.operation = facId
                    } else null
                }
                cls: lowOpt.synthClass.take
                clsN: (zgenerator.mkNamedOp
                    :ast
                    line: 0
                    col: 0
                    name: sname.stringView
                    op: cls
                )
                stagedCls.append clsN
            } case none then null
        }
        ci = ci + 1
    }
}


# lowerGeneratorsInUnit -- candidates collect first (indexes + names),
# then each lowers by index: the functiondef moves out of its
# namedoperation slot, the factory moves in, and the synth class appends
# to the unit body under `{name}_iter`.
lowerGeneratorsInUnit: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitNameId: zast.nameid
    unitdefId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    {
        cIdx: (ListVal u64)
        bi: u64
        bn: bodyIds.length
        for bi < bn loop {
            bmId: bodyIds.get i: bi
            bm: ast.nodes.get i: bmId.u64
            isCand: false
            match (
                bm
            ) case namedoperation then {
                if (zgenerator.fnBodyHasYield
                    :ast
                    n: (ast.nodes.get i: bm.operation.u64)
                ) then {
                    hd: zgenerator.returnHeadName :ast n: (ast.nodes.get i: bm.operation.u64)
                    if hd.stringView == "Iterator" then {
                        if (zgenerator.canLowerNow
                            :ast
                            n: (ast.nodes.get i: bm.operation.u64)
                            hasReceiver: false
                        ) then isCand = true
                    }
                }
            } else null
            if isCand then {
                bic: bi
                cIdx.append bic
            }
            bi = bi + 1
        }
        stagedCls: (List Node)
        (lowerFreeGenerators
            :st
            :ast
            :bodyIds
            :cIdx
            :stagedCls
        )
        # staged synth classes append after the loop: uel2's element view
        # ends with each iteration, and the list must not grow under it.
        for stagedCls.length > 0 loop {
            sc0: stagedCls.pop
            bodyIds.append (zast.tableAdd :ast n: sc0)
        }
        # method generators: each object definition's members lower the
        # same way, named {Type}_{method}_iter, with the receiver context.
        # Synth classes stage locally; the double-pop drain preserves order.
        pendingCls: (List Node)
        ogi: u64
        ogn: bodyIds.length
        for ogi < ogn loop {
            oelId: bodyIds.get i: ogi
            oel: argRefAt :ast nid: (zast.nodeid.create from: oelId.u32)
            if (oel.nid.isZero) == false then {
                # an owned copy: the walks below lend ast
                tnm: zast.nameTextCopy :ast ref: oel.name
                if tnm.length > 0 then {
                    (lowerGeneratorMethods
                        :st
                        :ast
                        typeName: tnm.stringView
                        defnId: (zast.nodeid.create from: oel.operation.u32)
                        dst: pendingCls
                    )
                }
            }
            ogi = ogi + 1
        }
        revCls: (List Node)
        for pendingCls.length > 0 loop {
            pc0: pendingCls.pop
            revCls.append pc0
        }
        for revCls.length > 0 loop {
            rc0: revCls.pop
            bodyIds.append (zast.tableAdd :ast n: rc0)
        }
        # the synth members were staged on the working list; write the new
        # tail back into the unit row, whose view is scoped to the write,
        # then index them: the def index was built before this pass ran
        first: u64
        {
            u: ast.nodes.getMut i: unitdefId.u64
            if u.unitdef then {
                wi: u.body.length
                first = wi
                wn: bodyIds.length
                for wi < wn loop {
                    nid: bodyIds.get i: wi
                    u.body.append nid
                    wi = wi + 1
                }
            }
        }
        uro: st.typing.declFindChild parentDeclId: st.typing.programRoot nameId: unitNameId
        if (uro.isZero) == false then {
            ii: first
            count: bodyIds.length
            for ii < count loop {
                nid: bodyIds.get i: ii
                ii = ii + 1
                nop: argRefAt :ast nid: (zast.nodeid.create from: nid.u32)
                if (nop.nid.isZero) == false then {
                    (indexDeclDef
                        :st
                        :ast
                        parentDeclId: uro
                        nameRef: nop.name
                        nopNodeId: nop.nid.u32
                        opNodeId: nop.operation.u32
                    )
                }
            }
        }
    }
}

# lowerGeneratorMethods -- lower the generator methods of one object
# definition (as-block first, then is-block), replacing each method with
# its factory in place and appending the synth class to the unit body.
lowerGeneratorMethods: function {
    ast: Ast
    st: zenv.ZSymbolTable
    typeName: StringView
    defnId: zast.nodeid
    dst: List Node
} is {
    orf: objRefAt :ast nid: defnId
    if orf.nid.isZero then return
    lowerGeneratorItems :st :ast :typeName objId: defnId asBlock: true :dst
    lowerGeneratorItems :st :ast :typeName objId: defnId asBlock: false :dst
}

# lower every generator function in a unit to its iterator class.
lowerGeneratorItems: function {
    ast: Ast
    st: zenv.ZSymbolTable
    typeName: StringView
    objId: zast.nodeid
    asBlock: bool
    dst: List Node
} is {
    orf: objRefAt :ast nid: objId
    bi: u64
    bn: orf.nis
    if asBlock then bn = orf.nas
    for bi < bn loop {
        isCand: false
        # The candidacy read is scoped so it ENDS before the mutable re-read
        # below begins: `bm` pins ast.nodes shared for as long as it lives, and
        # `bm2` -- the same element, taken to write through -- needs it
        # exclusively. One mutable element reference at a time.
        {
            bmId: u32
            if asBlock then {
                bmId = (zast.objAsItemAt :ast nid: objId i: bi).u32
            } else {
                bmId = (zast.objIsItemAt :ast nid: objId i: bi).u32
            }
            bm: ast.nodes.get i: bmId.u64
            match (
                bm
            ) case namedoperation then {
                if (zgenerator.fnBodyHasYield
                    :ast
                    n: (ast.nodes.get i: bm.operation.u64)
                ) then {
                    hd: zgenerator.returnHeadName :ast n: (ast.nodes.get i: bm.operation.u64)
                    if hd.stringView == "Iterator" then {
                        if (zgenerator.canLowerNow
                            :ast
                            n: (ast.nodes.get i: bm.operation.u64)
                            hasReceiver: true
                        ) then isCand = true
                    }
                }
            } else null
        }
        if isCand then {
            bm2Id: u32
            if asBlock then {
                bm2Id = (zast.objAsItemAt :ast nid: objId i: bi).u32
            } else {
                bm2Id = (zast.objIsItemAt :ast nid: objId i: bi).u32
            }
            # the candidate's operation and name are read through a view scoped
            # to this block (an owned name copy): the lowering below lends ast,
            # and the rewritten operation is written back through its own
            # mutable view at the end
            bmOp: zast.nodeid
            mnm: String
            {
                bm2: ast.nodes.get i: bm2Id.u64
                match (
                    bm2
                ) case namedoperation then {
                    bmOp = bm2.operation
                    mnm = zast.nameTextCopy :ast ref: bm2.name
                } else null
            }
            if (bmOp.isZero) == false then {
                sname: "\{typeName}_\{mnm}_iter"
                fnNode: zast.tableTake :ast id: bmOp.u32
                lowOpt: (zgenerator.lowerOne :ast
                    fn: fnNode
                    synthName: sname.stringView
                    receiverType: typeName
                )
                match (
                    lowOpt
                ) case some then {
                    wfid: lowOpt.wrapperNodeId
                    wfv: true
                    st.typing.generatorWrapper.set key: wfid.u64 value: wfv
                    nsi: u64
                    nsn: lowOpt.noStamp.length
                    for nsi < nsn loop {
                        ns0: lowOpt.noStamp.get i: nsi
                        nsk: ns0.u64
                        nsv: true
                        st.typing.noStampNode.set key: nsk value: nsv
                        nsi = nsi + 1
                    }
                    fac: lowOpt.factory.take
                    facId: zast.tableAdd :ast n: fac
                    {
                        bm3: ast.nodes.getMut i: bm2Id.u64
                        match (
                            bm3
                        ) case namedoperation then {
                            bm3.operation = facId
                        } else null
                    }
                    cls: lowOpt.synthClass.take
                    clsN: (zgenerator.mkNamedOp
                        :ast
                        line: 0
                        col: 0
                        name: sname.stringView
                        op: cls
                    )
                    dst.append clsN
                } case none then null
            }
        }
        bi = bi + 1
    }
}

# stampConstructionKind -- record what a call CONSTRUCTS, derived from the type
# it answers. The three families are the three the emitter renders differently;
# anything else is an ordinary call and says so.
stampConstructionKind: function {st: zenv.ZSymbolTable nid: u64 tid: ztypes.tid} is {
    if nid == 0 then return
    if tid.isZero then return
    tt: st.reg.typetypeOf typeId: tid
    ck: zast.callkind.regular
    if tt == ztypes.ztypetype.recordType then ck = zast.callkind.recordCreate
    if tt == ztypes.ztypetype.classType then ck = zast.callkind.classCreate
    if tt == ztypes.ztypetype.unionType then ck = zast.callkind.unionCreate
    if tt == ztypes.ztypetype.variantType then ck = zast.callkind.unionCreate
    st.typing.callKind.set key: nid value: ck
}

# stampRefDecl -- record the declaration a reference node resolved to.
stampRefDecl: function {st: zenv.ZSymbolTable nid: u64 declId: ztypes.declid} is {
    if nid == 0 then return
    if declId.isZero then return
    st.typing.refDecl.set key: nid value: declId
}

# declOfTypeId -- the declaration that minted type `tid` (ZType.def); a
# mono derives its home through genericOriginId -> the template's Decl.
declOfTypeId: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out ztypes.declid is {
    cur: tid
    for cur > 0 loop {
        next: u64
        if cur >= st.reg.typeById.length then return (ztypes.declid.create from: 0)
        zo: st.reg.typeById.get i: cur
        if zo.def > 0 then return zo.def
        go: zo.genericOriginId
        match (
            go
        ) case some then {
            next = go
        } case none then null
        cur = ztypes.tid.create from: (next)
    }
    return (ztypes.declid.create from: 0)
}

# unitDeclOfTid -- the top-level unit root Decl that owns type `tid`'s
# declaration (declOfTypeId -> parent walk to the parentless unit root);
# 0 when the type has no declaration. The id-valued unit-identity
# primitive: compare unit ownership by this, not by name.
unitDeclOfTid: function {
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out ztypes.declid is {
    cur: ztypes.declid
    {
        def9v: st.reg.defOf :tid
            cur = def9v
    }
    for cur > 0 loop {
        par: ztypes.declid
        isU: false
        selfT: u64
        {
            decl: st.typing.decls.get i: cur.u64
            par = decl.parent
            if decl.kind.unitDecl then isU = true
            selfT = decl.typeId
        }
        if (declAtProgramTop :st parentDeclId: par) then {
            # a FILE unit's own tid links to its own root under the program
            # root: the unit is not "defined in" a unit (inline units and
            # root-proxied synths do report the enclosing unit)
            if selfT == tid then return (ztypes.declid.create from: 0)
            if isU then return cur
            return (ztypes.declid.create from: 0)
        }
        cur = par
    }
    return (ztypes.declid.create from: 0)
}

# unitNameOfTid -- the defining unit's name for type `tid`, read off the
# Decl parent chain; "" when the type has no declaration. The display /
# dump projection over unitDeclOfTid -- identity gates should compare
# unitDeclOfTid ids instead.
unitNameOfTid: function {
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out String is {
    ud: unitDeclOfTid :st :tid
    if ud.u64 == 0 then return "".string
    utid: u64
    {
        decl: st.typing.decls.get i: ud.u64
        utid = decl.typeId
    }
    if utid == 0 then return "".string
    return (st.reg.nameOf tid: (ztypes.tid.create from: utid.u64))
}

# declLinkTemplateMethod -- a generic unit template's method is minted under a
# mangled `Tmpl_fn` name that no top-level def carries, so linkDeclType cannot
# find a declaration for it and the function type ends up with none. Bind the
# template's own method declaration to that type, which makes its parameters --
# indexed in AST order at pre-index time -- reachable from the type id. The
# template's Decl is passed IN: a template declared inside a namespace is not a
# child of its unit root, so no (unit, name) pair reaches it.
declLinkTemplateMethod: function {
    st: zenv.ZSymbolTable
    tmplDeclId: ztypes.declid
    memberNameId: u32
    fnTid: u64
} is {
    if fnTid == 0 then return
    if (st.typing.declIdOfType typeId: (ztypes.tid.create from: fnTid.u64)) > 0 then return
    if tmplDeclId.isZero then return
    md: (st.typing.declFindChild
        parentDeclId: tmplDeclId
        nameId: (zast.nameid.create from: memberNameId.u32)
    )
    if md.isZero then return
    st.typing.declSetType declId: md typeId: (ztypes.tid.create from: fnTid.u64)
}

# declMonoType -- give a monomorphisation its own type declaration, cloned
# from its template's, so its members carry the instantiated types rather than
# resolving back through genericOrigin to the template's.
declMonoType: function {
    st: zenv.ZSymbolTable
    monoTid: u64
    templateId: ztypes.tid
} is {
    td: declOfTypeId :st tid: templateId
    if td.isZero then return
    md: st.typing.declCloneType templateDeclId: td
    if md.isZero then return
    st.typing.declSetType declId: md typeId: (ztypes.tid.create from: monoTid.u64)
}

# declMemberOf -- the Decl of member `nameId` under the type that minted
# `ownerTid` (monos resolve through their template's Decl); 0 when the
# owner has no Decl or no such indexed member.
declMemberOf: function {
    st: zenv.ZSymbolTable.view
    ownerTid: ztypes.tid
    nameId: zast.nameid
} out ztypes.declid is {
    od: declOfTypeId :st tid: ownerTid
    if od.isZero then return (ztypes.declid.create from: 0)
    return (st.typing.declFindChild parentDeclId: od :nameId)
}

# declSurfaceOfName -- the Decl a bare-name reference lands on: the
# current unit's own def, else the prelude carrier's (core's) re-export,
# else the definition that minted the resolved type. The SURFACE is
# recorded (a re-export keeps its own Decl) so navigation lands where
# the name was found, not where its type lives.
declSurfaceOfName: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    nameId: zast.nameid
    tid: ztypes.tid
} out ztypes.declid is {
    if nameId > 0 then {
        ro: unitDecl
        if (ro.isZero) == false then {
            cd: st.typing.declFindChild parentDeclId: ro :nameId
            sv: declSurfaceEnsure :st :ast declId: cd want: tid
            if sv > 0 then return sv
        }
        co: (st.typing.declFindChild
            parentDeclId: st.typing.programRoot
            nameId: (nameIdOf :ast name: "core")
        )
        if (co.isZero) == false then {
            cd8: st.typing.declFindChild parentDeclId: co :nameId
            sv8: declSurfaceEnsure :st :ast declId: cd8 want: tid
            if sv8 > 0 then return sv8
        }
    }
    return (declOfTypeId :st :tid)
}

# declSurfaceEnsure -- accept a candidate surface Decl only when its
# minted type id equals the reference's resolved tid, resolving a
# not-yet-touched re-export on the spot -- a stamped surface must serve
# both navigation (its node) and tid consumers like the emitter.
declSurfaceEnsure: function {
    st: zenv.ZSymbolTable
    ast: Ast
    declId: ztypes.declid
    want: u64
} out ztypes.declid is {
    if declId.isZero then return (ztypes.declid.create from: 0)
    dtid: u64
    isRx: false
    {
        d: st.typing.decls.get i: declId.u64
        dtid = d.typeId
        if d.kind.reexportDecl then isRx = true
    }
    if dtid == 0 when isRx then dtid = resolveAliasKey :st :ast :declId
    if dtid == want then return declId
    return (ztypes.declid.create from: 0)
}

# --- the environment walk for a bare definition name ---

# --- the environment ---


# unitDeclOfNameOrOwn -- the Decl of the FILE unit a name denotes, or, for a
# name that is no file unit (a nested unit's or a template's own name, spelled
# as the walk's unit), the unit `frame` lies in. unitDeclOfName is the door
# whose miss is 0; the two are not interchangeable.
unitDeclOfNameOrOwn: function {
    st: zenv.ZSymbolTable.view
    frame: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    if nameId.isZero then return (ztypes.declid.create from: 0)
    r: st.typing.declFindChild parentDeclId: st.typing.programRoot :nameId
    if r.isZero then return (unitRootOfDecl :st declId: frame)
    return r
}

# unitNameIdOf / unitNameTextOf -- the spelling a unit's DECLARATION carries.
# The display projection of a unit id, for a diagnostic, a composed key or a
# text compare: reading a name OFF the Decl is not a re-resolution, and is the
# only sanctioned direction now that identity travels as an id.
unitNameIdOf: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
} out zast.nameid is {
    if unitDecl.isZero then return (zast.nameid.create from: 0)
    return (zast.nameid.create from: (st.typing.declNameOf declId: unitDecl))
}

unitNameTextOf: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
} out String is {
    if unitDecl.isZero then return "".string
    return (zast.poolTextCopy pool: ast.names ref: (unitNameIdOf :st :unitDecl))
}

# unitDeclOfName -- the Decl of the FILE unit a name denotes: the program
# root's child of that name, or 0. THE ONE DOOR from a unit's name to its
# declaration -- everything downstream compares and looks up by id, where two
# units sharing a name are two answers rather than declFindChild's last-wins
# coin flip. The empty name is the prelude-only probe and has no unit.
unitDeclOfName: function {
    st: zenv.ZSymbolTable.view
    nameId: zast.nameid
} out ztypes.declid is {
    if nameId.isZero then return (ztypes.declid.create from: 0)
    return (st.typing.declFindChild parentDeclId: st.typing.programRoot :nameId)
}

# frameFor -- the frame a name written in unit `unitDecl` resolves from:
# `frame`'s unit frame when `frame` lies inside that unit (a body, a nested
# unit, a template), else the unit's root -- a caller naming another unit is
# a qualified probe (`core`'s `i64` for a literal's default, from a unit that
# shadows `i64`) and starts there. 0 for no unit (a prelude-only probe).
frameFor: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    frame: ztypes.declid
} out ztypes.declid is {
    if unitDecl.isZero then return (ztypes.declid.create from: 0)
    # the frame's nearest unit frame first: it lies within the unit's root
    # exactly when the frame does, and the climb from a unit frame to the
    # root is a hop or two where the climb from a body frame is many
    uf: unitFrameOf :st declId: frame
    if (frameIsWithin :st frame: uf root: unitDecl) then return uf
    return unitDecl
}

# nsFrameOf -- the NESTED unit frame a name written in unit `unitDecl`
# resolves from -- frameFor's answer when it is not the unit's own root --
# or 0 at the top level of the unit. The scope the members of a namespace or
# template are declared in, as against the file unit.
nsFrameOf: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    frame: ztypes.declid
} out ztypes.declid is {
    f: frameFor :st :frame :unitDecl
    if f.isZero then return f
    if f == unitDecl then return (ztypes.declid.create from: 0)
    return f
}

# unitFrameOf -- the nearest frame at or above `declId` that a bare-name walk
# consults: a unit (file, inline, subunit, template) or a `public:` block. A
# type or function declaration is transparent to bare names -- members are
# reached through `this` or a qualified path, never bare -- so the walk climbs
# through it. 0 when `declId` is 0 or has no such ancestor.
unitFrameOf: function {
    st: zenv.ZSymbolTable.view
    declId: ztypes.declid
} out ztypes.declid is {
    cur: declId
    for cur > 0 loop {
        # the row carries the answer (declSetUnitFrame, laid at index time):
        # a body, a function, a local is not a unit frame, and no walk touches
        # the node
        if (st.typing.declIsUnitFrame declId: cur) then return cur
        cur = declParentIdOf :st declId: cur
    }
    return (ztypes.declid.create from: 0)
}

# declDefIsNative -- the definition this declaration records is a NATIVE
# object (`record is native`, `class is native`): the runtime owns its
# layout, so it holds nothing by value.
declDefIsNative: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    dn: u64
    {
        decl: st.typing.decls.get i: declId.u64
        dn = decl.node.u64
    }
    if dn == 0 then return false
    np: ast.nodes.get i: dn
    if (np.namedoperation) == false then return false
    opNode: ast.nodes.get i: np.operation.u64
    match (
        opNode
    ) case objectdef then {
        return opNode.isNative
    } else {
        return false
    }
}

# declDeclaresTemplate -- does this declaration declare a generic template
# unit (`m: unit as { t: anyval.generic ... }`)? Read off the def node's
# kind, like declDeclaresUnit; a template is a frame of its own -- its
# members and generic parameters are its children -- that the unit
# predicates deliberately exclude.
declDeclaresTemplate: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    dn: u64
    {
        decl: st.typing.decls.get i: declId.u64
        dn = decl.node.u64
    }
    if dn == 0 then return false
    np: ast.nodes.get i: dn
    if (np.namedoperation) == false then return false
    return (zast.unitOpKindIs :ast opId: np.operation k: zast.unitkind.template)
}

# envTypeIdOf -- the environment's answer for a bare name as a type id: the
# declaration `frame`'s chain reaches, when it is minted. 0 when the
# frame is unset, the name is unknown to the chain, or the declaration is
# not resolved yet (a probe cannot mint; the demand scans see to that).
envTypeIdOf: function {
    st: zenv.ZSymbolTable.view
    frame: ztypes.declid
    nameId: zast.nameid
} out u64 is {
    if frame.isZero then return 0
    eh: envLookup :st :frame :nameId
    if eh.declId.isZero then return 0
    return (declTypeIdOf :st declId: eh.declId).u64
}

# frameIsWithin -- is `root` `frame` itself or one of its enclosing frames?
frameIsWithin: function {
    st: zenv.ZSymbolTable.view
    frame: ztypes.declid
    root: ztypes.declid
} out bool is {
    if root.isZero then return false
    cur: frame
    for cur > 0 loop {
        if cur == root then return true
        cur = declParentIdOf :st declId: cur
    }
    return false
}

# envLookup -- the environment walk for a bare name: from `frame` outward
# through each enclosing unit frame to the root, then `core`, first match
# wins. A hit is the child's DeclId whatever its resolution state and the
# frame it was found in; a miss is zero. A probe: it reads the index and mints
# nothing.
envLookup: function {
    st: zenv.ZSymbolTable.view
    frame: ztypes.declid
    nameId: zast.nameid
} out zdefhit is {
    if nameId.isZero then return (zdefhit declId: ztypes.declid frame: ztypes.declid)
    cur: unitFrameOf :st declId: frame
    for cur > 0 loop {
        h: st.typing.declFindChild parentDeclId: cur :nameId
        if (h.isZero) == false then return (zdefhit declId: h frame: cur)
        if cur == st.typing.coreUnitRoot then return (zdefhit
            declId: ztypes.declid
            frame: ztypes.declid
        )
        cur = unitFrameOf :st declId: (declParentIdOf :st declId: cur)
    }
    if (st.typing.coreUnitRoot.isZero) == false then {
        h8: st.typing.declFindChild parentDeclId: st.typing.coreUnitRoot :nameId
        if (h8.isZero) == false then return (zdefhit declId: h8 frame: st.typing.coreUnitRoot)
    }
    return (zdefhit declId: ztypes.declid frame: ztypes.declid)
}

# zdefhit -- an envLookup hit: the child DeclId and the frame (its root
# DeclId) it was found in. Both zero on a miss.
zdefhit: record {
    declId: ztypes.declid
    frame: ztypes.declid
}

# reexportUnitOf -- for a prelude Decl whose value is a unit-rooted dotted
# alias (`List: collections.ListRef`), the name id of the unit it names; the
# zero id for a bare alias, a type-rooted value (`true: bool.true`), or a real
# definition.
reexportUnitOf: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out zast.nameid is {
    decl: st.typing.decls.get i: declId.u64
    nop: ast.nodes.get i: decl.node.u64
    if nop.namedoperation then {
        dk: dottedDefTargetIds :ast n: (ast.nodes.get i: nop.operation.u64)
        if dk.unitName.u32 > 0 then {
            dkr: st.typing.declFindChild parentDeclId: st.typing.programRoot nameId: dk.unitName
            if (dkr.isZero) == false then return dk.unitName
        }
    }
    return (zast.nameid.create from: 0)
}

# programUnitDecls -- every FILE unit's Decl, in load order: the program root's
# children, one per unit name (registerUnitRoots rejects a repeated one).
programUnitDecls: function {st: zenv.ZSymbolTable.view} out (ListVal u64) is {
    result: (ListVal u64)
    ro: st.typing.decls.get i: st.typing.programRoot.u64
    with cit: ro.children.iterateItems do for c: cit loop result.append c.value.u64
    return result
}

# isUnitNameDecl -- does `nameId` name a FILE unit: a child of the program root
# whose declared type is a unit? The Decl-tree answer to what the unit-name
# index was asked.
# nameDenotesUnit -- does `nameId` name a unit HERE: a FILE unit, or a
# generic-unit BINDING in scope (`intmath: (mathops t: i64)`) whose Decl
# carries the instantiated unit's type. The second leg is what a bare-name
# index could not express -- two namespaces may each bind an `intmath` -- so
# it resolves through the environment like any other name.
nameDenotesUnit: function {
    st: zenv.ZSymbolTable.view
    frame: ztypes.declid
    nameId: zast.nameid
} out bool is {
    if (isUnitNameDecl :st :nameId) then return true
    h: envLookup :st :frame :nameId
    if h.declId.isZero then return false
    # only a BINDING of an instantiated unit, never a unit DECLARATION: a
    # nested unit or subunit is in scope here, and reading one as a qualified
    # root changes what a dotted path means (qualified_subunit_type, the
    # re-export chains).
    isUd: false
    {
        hdo: st.typing.decls.get i: h.declId.u64
        if hdo.kind.unitDecl then isUd = true
    }
    if isUd then return false
    bt: declTypeIdOf :st declId: h.declId
    if bt.isZero then return false
    return (st.reg.typetypeOf typeId: bt) == ztypes.ztypetype.unitType
}

isUnitNameDecl: function {
    st: zenv.ZSymbolTable.view
    nameId: zast.nameid
} out bool is {
    ur: st.typing.declFindChild parentDeclId: st.typing.programRoot :nameId
    if ur.isZero then return false
    ut: declTypeIdOf :st declId: ur
    if ut.isZero then return false
    return (st.reg.typetypeOf typeId: ut) == ztypes.ztypetype.unitType
}


# declProbeUnitChildRoot -- the same probe from an already-resolved unit root.
# Callers on a per-reference path resolve the root once and come here; only the
# name-taking wrapper above pays a pool probe.
declProbeUnitChildRoot: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitRoot: ztypes.declid
    nameId: zast.nameid
} out u64 is {
    if nameId.isZero then return 0
    cid: st.typing.declFindChild parentDeclId: unitRoot :nameId
    if cid.isZero then return 0
    ctid: u64
    isRx: false
    isC: false
    {
        decl: st.typing.decls.get i: cid.u64
        ctid = decl.typeId
        if decl.kind.reexportDecl then isRx = true
        if decl.kind.constDecl then isC = true
    }
    if ctid > 0 then return ctid
    if isRx then {
        # a re-export not yet resolved: mint once through the alias,
        # cache on the Decl (covers value re-exports like core.false)
        return (resolveAliasKey :st :ast declId: cid)
    }
    if isC then {
        constFoldDecl :st :ast declId: cid
        rt: declTypeIdOf :st declId: unitRoot
        if (rt.isZero) == false then {
            co: st.typing.declChildOfId parentTypeId: rt :nameId
            match (
                co
            ) case some then {
                return co
            } case none then null
        }
    }
    return 0
}

# monoOriginTidOf -- a type's genericOriginId (the template it monomorphized
# from), or 0. A tid with an origin is a registered mono: inherently canonical,
# never a placeholder shell.
monoOriginTidOf: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out ztypes.tid is {
    return (st.reg.genericOriginOf :tid)
}

# probeFrameTyperef -- one frame's answer for a type name: the Decl-tree
# child's minted id (a not-yet-touched re-export minted through its alias),
# else the unit type's member index, which also serves the pre-index window
# (no root yet) and members that are not Decls (unit monos, namespace
# bindings). 0 when the frame has no such name yet -- the caller moves to the
# next frame.
probeFrameTyperef: function {
    ast: Ast
    st: zenv.ZSymbolTable
    root: ztypes.declid
    nameId: zast.nameid
} out u64 is {
    if nameId.isZero then return 0
    if root.isZero then return 0
    dt: declProbeUnitChildRoot :st :ast unitRoot: root :nameId
    if dt > 0 then return dt
    # the frame's own member index, keyed on the unit id its ROOT DECL
    # carries. Every unit root has one -- a file unit's is stamped where the
    # roots are indexed, a nested unit's where resolveNamespaceUnit mints it
    # -- so the frame answers the same way whichever kind of unit it is.
    rt: declTypeIdOf :st declId: root
    if rt.isZero then return 0
    co: st.typing.declChildOfId parentTypeId: rt :nameId
    match (
        co
    ) case some then {
        return co
    } case none then null
    return 0
}

# walkLookupTyperef -- resolve a bare type name to its id: the environment
# walk from the frame a name written in `unitDecl` resolves from (frameFor:
# `frame`'s unit frame when it lies inside that unit, else the unit's
# own root), each enclosing unit frame outward, then the prelude -- the
# current unit shadows core, and every other unit is reached through core's
# re-exports or a qualified path. It serves internal/mangled queries (dotted
# member keys) beyond the source-level surface, so a frame answers from the
# member index as well as the Decl tree (probeFrameTyperef).
walkLookupTyperef: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    base: StringView
} out optionval u64 is {
    nid: zast.poolFind pool: ast.names text: base
    if nid.isZero then return (optionval.none u64)
    return (walkLookupTyperefById :st :frame :ast :unitDecl baseId: nid)
}


# probeFrameTyperefRo -- probeFrameTyperef's read half: the Decl child's
# already-minted id, else the unit type's member index. Never mints; a name
# whose id only a mint leg could produce answers 0.
probeFrameTyperefRo: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    root: ztypes.declid
    nameId: zast.nameid
    depth: u64
} out u64 is {
    if nameId.isZero then return 0
    if root.isZero then return 0
    if depth > 8 then return 0
    cid: st.typing.declFindChild parentDeclId: root :nameId
    if (cid.isZero) == false then {
        ctid: u64
        isRx: false
        {
            decl: st.typing.decls.get i: cid.u64
            ctid = decl.typeId
            if decl.kind.reexportDecl then isRx = true
        }
        if ctid > 0 then return ctid
        if isRx then {
            # a re-export the walk never touched: follow the target by
            # reading the ids off its def node -- never lay the edge
            alTgt: reexportTargetIdsOf :st :ast declId: cid
            if alTgt.unitName.u32 > 0 then {
                return (probeFrameTyperefRo
                    :ast
                    :st
                    root: (unitDeclOfName :st nameId: alTgt.unitName)
                    nameId: alTgt.defName
                    depth: depth + 1
                )
            }
        }
    }
    rt: declTypeIdOf :st declId: root
    if rt.isZero then return 0
    co: st.typing.declChildOfId parentTypeId: rt :nameId
    match (
        co
    ) case some then {
        return co
    } case none then null
    return 0
}

# walkLookupTyperefRo -- the post-typecheck read-only environment walk:
# enclosing unit frames, then core, answering only from what resolution
# already minted. The emitter consumes and never demands, so the mint legs
# (re-export aliases, const folds, pending waits) have nothing left to do
# by the time it asks.
walkLookupTyperefRo: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    frame: ztypes.declid
    base: StringView
} out optionval u64 is {
    baseId: zast.poolFind pool: ast.names text: base
    if baseId.isZero then return (optionval.none u64)
    return (walkLookupTyperefByIdRo :st :frame :ast :unitDecl :baseId)
}

# walkLookupTyperefByIdRo -- walkLookupTyperefRo for a name already interned:
# the same read-only frame walk, answering only ids resolution minted.
walkLookupTyperefByIdRo: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    frame: ztypes.declid
    baseId: zast.nameid
} out optionval u64 is {
    if baseId.isZero then return (optionval.none u64)
    cur: frameFor :st :frame :unitDecl
    for cur > 0 loop {
        if cur == st.typing.coreUnitRoot then {
            cur = ztypes.declid
        } else {
            r: probeFrameTyperefRo :ast :st root: cur nameId: baseId depth: 0
            if r > 0 then return (optionval.some r)
            cur = unitFrameOf :st declId: (declParentIdOf :st declId: cur)
        }
    }
    if (zast.nameTextAt :ast ref: baseId).stringView == "Any" then return (optionval.none u64)
    if (st.typing.coreUnitRoot.isZero) == false then {
        r5: probeFrameTyperefRo :ast :st root: st.typing.coreUnitRoot nameId: baseId depth: 0
        if r5 > 0 then return (optionval.some r5)
    }
    return (optionval.none u64)
}


# resolveUnitChildRo -- resolveUnitChild's read half: the already-minted
# Decl-tree answer, else the unit type's member index. Never mints.
resolveUnitChildRo: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out optionval u64 is {
    r: probeFrameTyperefRo :ast :st root: unitDecl :nameId depth: 0
    if r > 0 then return (optionval.some r)
    return (optionval.none u64)
}

# resolvedByIds / resolvedByIdsMember -- resolve a (unit, name[, member])
# id tuple by walking childOf from the unit root, with the on-demand alias
# follow on a miss. resolveUnitChild is the probing entry point.
# declOfUnitDefIds -- declOfUnitDef for a caller holding BOTH ids: unit
# root by id, then the child edge. No name is interned and no key is built.
declOfUnitDefIds: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    if nameId.isZero then return (ztypes.declid.create from: 0)
    ro: unitDecl
    if (ro.isZero) == false then {
        d: st.typing.declFindChild parentDeclId: ro :nameId
        if (d.isZero) == false then return d
        # a definition the unit's `public:` block makes is on its surface
        pb: publicNsChildOf :st root: ro
        if (pb.isZero) == false then return (st.typing.declFindChild parentDeclId: pb :nameId)
    }
    return (ztypes.declid.create from: 0)
}

# childOfWalkIds -- the two-segment walk with both segments already interned.
childOfWalkIds: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    name: zast.nameid
} out optionval u64 is {
    ro: declTypeIdOf :st declId: unitDecl
    if (ro.isZero) == false then {
        return (st.typing.declChildOfId
            parentTypeId: (ztypes.tid.create from: ro.u64)
            nameId: name
        )
    }
    return (optionval.none u64)
}

# resolvedByIds -- resolve a `unit.name` id pair to its type id: the
# childOf walk, then the on-demand alias follow (which lays the
# unit->alias edge so later probes resolve through childOf).
resolvedByIds: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    name: zast.nameid
} out optionval u64 is {
    wo: childOfWalkIds :st :unitDecl :name
    match (
        wo
    ) case some then {
        return (optionval.some wo)
    } case none then null
    alDecl: declOfUnitDefIds :st :unitDecl nameId: name
    # a definition the unit's `public:` block makes: on the unit's surface,
    # so `unit.name` reaches it, but NOT laid on the unit's member index --
    # that index also answers bare names written inside the unit, and the
    # block's definitions are reached from there by `public.name` alone
    {
        alT: declTypeIdOf :st declId: alDecl
        alP: declParentIdOf :st declId: alDecl
        alRoot: ztypes.declid
        if (unitDecl.isZero) == false then alRoot = unitDecl
        if (alT.isZero) == false when (alP.isZero) == false when alP != alRoot then {
            return (optionval.some alT.u64)
        }
    }
    alTgt: reexportTargetIdsOf :st :ast declId: alDecl
    if alTgt.unitName.u32 > 0 then {
        tgo: (childOfWalkIds
            :st
            unitDecl: (unitDeclOfName :st nameId: alTgt.unitName)
            name: alTgt.defName
        )
        match (
            tgo
        ) case some then {
            uro: (declTypeIdOf
                :st
                declId: unitDecl
            )
            if (uro.isZero) == false then {
                if (name.isZero) == false then (st.typing.setMemberType
                    parentTypeId: (ztypes.tid.create from: uro.u64)
                    nameId: name
                    childTypeId: tgo
                )
            }
            return (optionval.some tgo)
        } case none then null
    }
    return (optionval.none u64)
}


# resolvedByIdsRo -- resolvedByIds minus its one write (the re-export member
# memo): the member-index walk, the public-block surface, then the re-export
# target read. The post-typecheck readers hold views and never lay the edge.
resolvedByIdsRo: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    name: zast.nameid
} out optionval u64 is {
    wo: childOfWalkIds :st :unitDecl :name
    match (
        wo
    ) case some then {
        return (optionval.some wo)
    } case none then null
    alDecl: declOfUnitDefIds :st :unitDecl nameId: name
    {
        alT: declTypeIdOf :st declId: alDecl
        alP: declParentIdOf :st declId: alDecl
        alRoot: ztypes.declid
        if (unitDecl.isZero) == false then alRoot = unitDecl
        if (alT.isZero) == false when (alP.isZero) == false when alP != alRoot then {
            return (optionval.some alT.u64)
        }
    }
    alTgt: reexportTargetIdsOf :st :ast declId: alDecl
    if alTgt.unitName.u32 > 0 then {
        tgo: (childOfWalkIds
            :st
            unitDecl: (unitDeclOfName :st nameId: alTgt.unitName)
            name: alTgt.defName
        )
        match (
            tgo
        ) case some then {
            return (optionval.some tgo)
        } case none then null
    }
    return (optionval.none u64)
}

# resolvedByIdsMember -- `unit.def.member` from ids: the unit-level
# definition, then one more child edge. The two three-segment keys in this
# unit were the only reason the walk had to handle an arbitrary segment count.
resolvedByIdsMember: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    defId: zast.nameid
    memberId: zast.nameid
} out optionval u64 is {
    decl: resolvedByIds :st :ast :unitDecl name: defId
    match (
        decl
    ) case some then {
        return (st.typing.declChildOfId
            parentTypeId: (ztypes.tid.create from: decl.u64)
            nameId: memberId
        )
    } case none then null
    return (optionval.none u64)
}

resolveUnitChild: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out optionval u64 is {
    dt: declProbeUnitChildRoot :st :ast unitRoot: unitDecl :nameId
    if dt > 0 then return (optionval.some dt)
    ro: declTypeIdOf :st declId: unitDecl
    if (ro.isZero) == false then {
        co: st.typing.declChildOfId parentTypeId: (ztypes.tid.create from: ro.u64) :nameId
        match (
            co
        ) case some then {
            return (optionval.some co)
        } case none then null
    }
    # miss: the alias follow lays the unit->alias edge, so the next probe
    # resolves through childOf above
    return (resolvedByIds :st :ast :unitDecl name: nameId)
}


# --- id-keyed resolution twins: same shape as the text resolvers above, but
# the child name arrives as an already-interned Ast.names pool id, so each
# probe is a childOfId (no per-stage StringPool.find). The composed-key miss
# path materialises the name text once via poolTextCopy (rare). ---

# walkLookupTyperefById -- walkLookupTyperef for a caller holding the base
# name's pool id.
walkLookupTyperefById: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    baseId: zast.nameid
} out optionval u64 is {
    if baseId.isZero then return (optionval.none u64)
    frame96: (frameFor :st :frame :unitDecl)
    return (walkLookupTyperefFrom
        :st
        :ast

        frame: frame96
        :baseId
    )
}

# walkLookupTyperefFrom -- the walk itself, from an explicit start frame (0:
# the prelude alone): each enclosing unit frame outward, then core.
walkLookupTyperefFrom: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    baseId: zast.nameid
} out optionval u64 is {
    if baseId.isZero then return (optionval.none u64)
    cur: frame
    # the nearest frame that declares the name with a declaration still in
    # flight (queued or mid-resolution): the nearest declaration wins
    # whatever its state (envLookup's rule), so an outer frame may answer
    # only with THAT declaration's own id -- core's re-export of it -- never
    # with a different definition of the same name; otherwise the reference
    # waits for the declaration to resolve
    waitDecl: ztypes.declid
    for cur > 0 loop {
        if cur == st.typing.coreUnitRoot then {
            cur = ztypes.declid
        } else {
            r: probeFrameTyperef :st :ast root: cur nameId: baseId
            if r > 0 then {
                if waitDecl.isZero then return (optionval.some r)
                od: declOfTypeId :st tid: (ztypes.tid.create from: r)
                if od == waitDecl then return (optionval.some r)
                return (optionval.none u64)
            }
            if waitDecl.isZero then {
                here: st.typing.declFindChild parentDeclId: cur nameId: baseId
                if (here.isZero) == false then {
                    hd: st.typing.decls.get i: here.u64
                    if hd.pending then waitDecl = here
                    if hd.resolving then waitDecl = here
                }
            }
            cur = unitFrameOf :st declId: (declParentIdOf :st declId: cur)
        }
    }
    # `Any` is not user-reachable through core: only its own unit (system.z,
    # or a user unit defining one) resolves it. The constraint-position gate
    # is checkAnyBounds.
    if (zast.poolTextAt pool: ast.names ref: baseId) == "Any" then return (optionval.none u64)
    if (st.typing.coreUnitRoot.isZero) == false then {
        r5: probeFrameTyperef :st :ast root: st.typing.coreUnitRoot nameId: baseId
        if r5 > 0 then {
            if waitDecl.isZero then return (optionval.some r5)
            od5: declOfTypeId :st tid: (ztypes.tid.create from: r5)
            if od5 == waitDecl then return (optionval.some r5)
        }
    }
    return (optionval.none u64)
}

# shellScalarName -- a shell named like a C scalar stays a shell: the
# emitter spells those by NAME (cTypeOf) before any canonicalization, so
# rebinding them would change shadow semantics. The set is the numeric
# scalars the emitter spells, plus `bool` -- which cTypeOf does not spell
# (its C form comes from the bool declaration) but which is a shell name on
# the same footing. The two literal types are NOT here: they never reach the
# emitter, so there is no spelling of them to protect.
shellScalarName: function {name: StringView} out bool is {
    if (isNumericTypeName :name) then return true
    return name == "bool"
}

# shellResolveByName -- the emitter's shell resolution order for `name` seen
# from `unit`: the unit-local key, the system key, the walk list, then the
# registry-wide cross-unit scan. 0 when nothing resolves.
# canonShellTid -- the canonical id for a SHELL stamp value, 0 to leave
# the stamp alone. Mirrors canonicalizeShellChildren's shell detection
# (no defining unit, not a generic param / scalar shell / as-const clone
# / typeof shell); memoized per shell id.
canonShellTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    cache: (IdMapV u64 v: u64)
    tid: ztypes.tid
    unitDecl: ztypes.declid
    frame: ztypes.declid
} out u64 is {
    if tid.isZero then return 0
    co: cache.get key: tid
    match (
        co
    ) case some then {
        return co
    } case none then null
    res: u64
    ok: (st.reg.typetypeOf typeId: tid) != ztypes.ztypetype.genericParam
    # a registered mono is inherently canonical (its name resolves back to
    # itself); only a homeless placeholder shell needs the name lookup
    if ok when (monoOriginTidOf :st :tid) > 0 then ok = false
    if ok then {
        if (unitDeclOfTid :st :tid) > 0 then ok = false
    }
    if ok then {
        nmNode: st.reg.nameOf :tid
        if (shellScalarName name: nmNode.stringView) then nmNode = "".string
        aco: st.typing.asConstClone.get key: tid
        match (
            aco
        ) case some then {
            if aco then nmNode = "".string
        } case none then null
        tso: st.typing.typeofShell.get key: tid
        match (
            tso
        ) case some then {
            nmNode = "".string
        } case none then null
        if nmNode.length > 0 then {
            rid: (shellResolveByName
                :st
                :frame
                :ast

                fromUnit: unitDecl
                name: nmNode.stringView
            )
            if rid > 0 when rid != tid then res = rid
        }
    }
    kc: tid
    vc: res
    cache.set key: kc value: vc
    return res
}

# canonicalizeShellNodeStamps -- checkBodies runs BEFORE the shell-child
# canonicalization, so expression nodes typed through a then-shell edge
# carry the shell id in nodeType (and dpTaggedParent):
# the emitter reads receiver types from those stamps, and a shell has no
# origin/children to dispatch on. Rebind them to the canonical type the way
# canonicalizeShellChildren rebinds the members.
canonicalizeShellNodeStamps: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
} is {
    cache: (IdMapV u64 v: u64)
    nameCount: st.typing.nodeType.length
    ci: u64
    for ci < nameCount loop {
        cv: st.typing.nodeType.get i: ci
        if cv > 0 then {
            rid: (canonShellTid
                :ast
                :st
                :frame
                :cache
                tid: (ztypes.tid.create from: cv.u64)
                :unitDecl
            )
            if rid > 0 then {
                (ztyping.nodeTypeSet
                    tbl: st.typing.nodeType
                    nid: ci
                    tid: (ztypes.tid.create from: rid.u64)
                )
            }
        }
        ci = ci + 1
    }
    dnids: (ListVal u64)
    dvals: (ListVal u64)
    # the table's rows are copied out first: canonicalising lends st
    dKeys: (ListVal u64)
    dIns: (ListVal u64)
    with dt: st.typing.dpTaggedParent.iterateItems do for d: dt loop {
        dKeys.append d.key
        dIns.append d.value
    }
    di: u64
    for di < dKeys.length loop {
        rid3: (canonShellTid
            :ast
            :st
            :frame
            :cache
            tid: (ztypes.tid.create from: (dIns.get i: di))
            :unitDecl
        )
        if rid3 > 0 then {
            dnids.append (dKeys.get i: di)
            dvals.append rid3
        }
        di = di + 1
    }
    l: u64
    for l < dnids.length loop {
        k3: dnids.get i: l
        v3: dvals.get i: l
        st.typing.dpTaggedParent.set key: k3 value: (ztypes.tid.create from: v3.u64)
        l = l + 1
    }
    pnids: (ListVal u64)
    pvals: (ListVal u64)
    # the table's rows are copied out first: canonicalising lends st
    pKeys: (ListVal u64)
    pIns: (ListVal u64)
    with pt: st.typing.dpArmPredicate.iterateItems do for p: pt loop {
        pKeys.append p.key
        pIns.append p.value
    }
    pi: u64
    for pi < pKeys.length loop {
        rid4: (canonShellTid
            :ast
            :st
            :frame
            :cache
            tid: (ztypes.tid.create from: (pIns.get i: pi))
            :unitDecl
        )
        if rid4 > 0 then {
            pnids.append (pKeys.get i: pi)
            pvals.append rid4
        }
        pi = pi + 1
    }
    q: u64
    for q < pnids.length loop {
        k4: pnids.get i: q
        v4: pvals.get i: q
        st.typing.dpArmPredicate.set key: k4 value: (ztypes.tid.create from: v4.u64)
        q = q + 1
    }
    tnids: (ListVal u64)
    tvals: (ListVal u64)
    # the table's rows are copied out first: canonicalising lends st
    tKeys: (ListVal u64)
    tIns: (ListVal u64)
    with tt: st.typing.dpTagRead.iterateItems do for t: tt loop {
        tKeys.append t.key
        tIns.append t.value
    }
    ti: u64
    for ti < tKeys.length loop {
        rid5: (canonShellTid
            :ast
            :st
            :frame
            :cache
            tid: (ztypes.tid.create from: (tIns.get i: ti))
            :unitDecl
        )
        if rid5 > 0 then {
            tnids.append (tKeys.get i: ti)
            tvals.append rid5
        }
        ti = ti + 1
    }
    r: u64
    for r < tnids.length loop {
        k5: tnids.get i: r
        v5: tvals.get i: r
        st.typing.dpTagRead.set key: k5 value: (ztypes.tid.create from: v5.u64)
        r = r + 1
    }
    gnids: (ListVal u64)
    gvals: (ListVal u64)
    # the table's rows are copied out first: canonicalising lends st
    gKeys: (ListVal u64)
    gIns: (ListVal u64)
    with gt: st.typing.postGuardTid.iterateItems do for g: gt loop {
        gKeys.append g.key
        gIns.append g.value
    }
    gi: u64
    for gi < gKeys.length loop {
        rid7: (canonShellTid
            :ast
            :st
            :frame
            :cache
            tid: (ztypes.tid.create from: (gIns.get i: gi))
            :unitDecl
        )
        if rid7 > 0 then {
            gnids.append (gKeys.get i: gi)
            gvals.append rid7
        }
        gi = gi + 1
    }
    y: u64
    for y < gnids.length loop {
        k7: gnids.get i: y
        v7: gvals.get i: y
        st.typing.postGuardTid.set key: k7 value: (ztypes.tid.create from: v7.u64)
        y = y + 1
    }
    anids: (ListVal u64)
    avals: (ListVal u64)
    # the table's rows are copied out first: canonicalising lends st
    aKeys: (ListVal u64)
    aIns: (ListVal u64)
    with at: st.typing.tagAccessorTid.iterateItems do for a: at loop {
        aKeys.append a.key
        aIns.append a.value
    }
    ai: u64
    for ai < aKeys.length loop {
        rid6: (canonShellTid
            :ast
            :st
            :frame
            :cache
            tid: (ztypes.tid.create from: (aIns.get i: ai))
            :unitDecl
        )
        if rid6 > 0 then {
            anids.append (aKeys.get i: ai)
            avals.append rid6
        }
        ai = ai + 1
    }
    w: u64
    for w < anids.length loop {
        k6: anids.get i: w
        v6: avals.get i: w
        (st.typing.tagAccessorTid.set
            key: (ztypes.tid.create from: k6.u64)
            value: (ztypes.tid.create from: v6.u64)
        )
        w = w + 1
    }
}

# resolve a type name to its shell type id (before member resolution).
shellResolveByName: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    fromUnit: ztypes.declid
    name: StringView
} out u64 is {
    nameId99: (zast.poolFind pool: ast.names text: name)
    r1: (resolveUnitChild
        :st
        :ast
        unitDecl: fromUnit
        nameId: nameId99
    )
    match (
        r1
    ) case some then {
        return r1
    } case none then null
    nameId910: (zast.poolFind pool: ast.names text: name)
    r2: (resolveUnitChild
        :st
        :ast
        unitDecl: st.typing.systemUnitRoot
        nameId: nameId910
    )
    match (
        r2
    ) case some then {
        return r2
    } case none then null
    r3: walkLookupTyperef :st :frame :ast unitDecl: fromUnit base: name
    match (
        r3
    ) case some then {
        return r3
    } case none then null
    return 0
}

# canonicalizeShellChildren -- rebind every member whose declared type is a
# SHELL id (a name-minted reference with no defining unit) to the canonical
# type, resolved in the member's parent's defining unit with the emitter's
# resolution order. Runs post-resolution so the emitter reads canonical child
# ids and never re-resolves a child by name.
canonicalizeShellChildren: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
} is {
    # stage every member first: the loop rebinds member types as it goes, and
    # a declaration write cannot run while an enumeration of the typing is open
    owns: (ListVal u64)
    nms: (ListVal u64)
    ctds: (ListVal u64)
    (st.typing.declAllMemberRows
        lastTid: st.reg.nextTypeId
        owners: owns
        names: nms
        tids: ctds
    )
    ri: u64
    rn: owns.length
    for ri < rn loop {
        rpt: owns.get i: ri
        rnm: (zast.nameid.create from: (nms.get i: ri).u32.orPanic)
        cto: ctds.get i: ri
        ok: cto > 0
        if ok when (st.reg.typetypeOf typeId: (ztypes.tid.create from: cto.u64)) == ztypes.ztypetype.genericParam then {
            ok = false
        }
        if ok when (monoOriginTidOf
            :st
            tid: (ztypes.tid.create from: cto.u64)
        ) > 0 then ok = false
        if ok then {
            if (unitDeclOfTid
                :st

                tid: (ztypes.tid.create from: cto.u64)
            ) > 0 then ok = false
        }
        # a unit mono's members are its own substituted FUNCTIONS, minted per
        # instance with no declaration of their own: not shells. Resolving them
        # by name in the mono's defining unit -- the template's -- would rebind
        # them to the template's methods.
        if ok when (st.reg.typetypeOf typeId: (ztypes.tid.create from: rpt.u64)) == ztypes.ztypetype.unitType then {
            if (st.reg.genericOriginOf tid: (ztypes.tid.create from: rpt.u64)) > 0 then ok = false
        }
        if ok then {
            pu: unitDecl
            {
                puo: (unitDeclOfTid
                    :st

                    tid: (ztypes.tid.create from: rpt.u64)
                )
                if (puo.isZero) == false then pu = puo
            }
            # the child's name resolves where its parent type is declared. A
            # specialisation has no declaration of its own yet and keeps the
            # frame it is given.
            rf: frame
            {
                pgo: st.reg.genericOriginOf tid: (ztypes.tid.create from: rpt.u64)
                if pgo.isZero then {
                    pdo: declOfTypeId :st tid: (ztypes.tid.create from: rpt.u64)
                    if (pdo.isZero) == false then rf = pdo
                }
            }
            nmNode: st.reg.nameOf tid: (ztypes.tid.create from: cto.u64)
            if (shellScalarName name: nmNode.stringView) then nmNode = "".string
            {
                aco: st.typing.asConstClone.get key: cto
                match (
                    aco
                ) case some then {
                    if aco then nmNode = "".string
                } case none then null
            }
            {
                tso: st.typing.typeofShell.get key: cto
                match (
                    tso
                ) case some then {
                    nmNode = "".string
                } case none then null
            }
            if nmNode.length > 0 then {
                rid: (shellResolveByName
                    :st
                    frame: rf
                    :ast

                    fromUnit: pu
                    name: nmNode.stringView
                )
                if rid > 0 when rid != cto then {
                    setc: rid
                    (st.typing.declSetMemberType
                        parentTypeId: (ztypes.tid.create from: rpt.u64)
                        nameId: rnm
                        typeId: (ztypes.tid.create from: setc.u64)
                    )
                }
            }
        }
        ri = ri + 1
    }
}

# typecheck a whole program against registry `reg`: resolve every type,
# stamp all nodes, and return the populated symbol table (diagnostics
# ride in the typing tables).
# publicNsOf -- the publicNs child Decl of the type/unit that minted `tid`
# (0 when the type has no `public:` block). The children are read one index at
# a time: a second st.typing.decls probe cannot run under a live children borrow.
publicNsOf: function {
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out ztypes.declid is {
    od: ztypes.declid
    {
        def9v: st.reg.defOf :tid
            od = def9v
    }
    # a nested unit or hidden subunit links its declaration through the
    # typing side (declSetType), not the registry's def
    if od.u64 == 0 then od = st.typing.declIdOfType typeId: tid
    if od.u64 == 0 then return (ztypes.declid.create from: 0)
    return (st.typing.declPublicNsOf owner: od)
}

# declMemberIsPrivate -- member `nameId` is private on the type/unit that minted
# `tid`: true iff that type has a publicNs (a `public:` block) and `nameId` is not
# one of its exposed edges. Exact-tid: a mono has no own publicNs, so all its
# members read public (matching the childPrivate map's exact-tid keying).
declMemberIsPrivate: function {
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
    nameId: zast.nameid
} out bool is {
    pn: publicNsOf :st :tid
    if pn.isZero then return false
    od: ztypes.declid
    {
        po: st.typing.decls.get i: pn.u64
        od = po.parent
    }
    md: st.typing.declFindChild parentDeclId: od :nameId
    # not private if `nameId` is not a declared member (isChildPrivate is false
    # for a missing member edge), nor the publicNs block pseudo-member itself
    if md.isZero then return false
    if md == pn then return false
    fcP: st.typing.declFindChild parentDeclId: pn :nameId
    return fcP.isZero
}

# declPublicAliasInternal -- the internal member name that public alias `name`
# exposes on `tid`, or "" when `name` is not a renamed public entry (the exposed
# name equals the internal name, or there is no such entry).
declPublicAliasInternal: function {
    st: zenv.ZSymbolTable.view
    pool: zast.StringPool.view
    tid: ztypes.tid
    name: StringView
} out String is {
    nid: pool.find s: name
    if nid.isZero then return "".string
    pn: publicNsOf :st :tid
    if pn.isZero then return "".string
    tgt: st.typing.declFindChild parentDeclId: pn nameId: nid
    if tgt.isZero then return "".string
    intName: u32
    {
        decl: st.typing.decls.get i: tgt.u64
        intName = decl.name
    }
    if intName == nid then return "".string
    if intName == 0 then return "".string
    return (zast.poolTextCopy :pool ref: (zast.nameid.create from: intName.u32))
}

# publicAliasInternalNames -- the internal member names `tid`'s public interface
# exposes under a DIFFERENT public name (its alias targets); empty when `tid` has
# no publicNs. The linter marks these as used so a renamed def is not flagged.
publicAliasInternalNames: function {
    st: zenv.ZSymbolTable.view
    pool: zast.StringPool.view
    tid: ztypes.tid
} out (List String) is {
    result: (List String)
    pn: publicNsOf :st :tid
    if pn.isZero then return result
    ename: (ListVal u64)
    edecl: (ListVal ztypes.declid)
    {
        po: st.typing.decls.get i: pn.u64
        with cit: po.children.iterateItems do for c: cit loop {
            ename.append from: c.key.u64
            edecl.append from: c.value
        }
    }
    ei: u64
    en: ename.length
    for ei < en loop {
        pubNid: ename.get i: ei
        tdecl: edecl.get i: ei
        ei = ei + 1
        intNid: u32
        {
            decl: st.typing.decls.get i: tdecl.u64
            intNid = decl.name
        }
        if intNid > 0 when intNid.u64 != pubNid then result.append from: (zast.poolTextCopy
            :pool
            ref: (zast.nameid.create from: intNid.u32)
        )
    }
    return result
}

# typecheck -- the entry point: index every unit's declarations, resolve from
# the program's `main` outward (or every definition under `eager`), walk the
# bodies, and return the walk state whose `typing` and `reg` hold the result.
typecheck: function {
    program: Node
    reg: ztypes.ZTypeRegistry.take
    eager: bool
    requireMain: bool
    dumpRows: bool
    ccPath: StringView
    ccMode: StringView
    target: StringView
    foldPaths: (List String)
} out zenv.ZSymbolTable is {
    nodeEstT: u64
    match (
        program
    ) case program then {
        nodeEstT = program.ast.nodes.length
    } else null
    ty: ztyping.newTyping nodeEst: nodeEstT
    ty.eagerAll = eager
    ty.requireMain = requireMain
    ty.dumpRows = dumpRows
    ty.ccPath = ccPath.string
    ty.ccMode = ccMode.string
    ty.targetTriple = target.string
    with fpit: foldPaths.iterate do for fp: fpit loop ty.foldPaths.append from: fp.copy
    match (
        program
    ) case program then {
        muNid: nameIdOf ast: program.ast name: program.mainUnitName.stringView
        reg.setMainUnit name: program.mainUnitName.stringView nameId: muNid
    } else null
    st: zenv.newSymbolTable :reg typing: ty
    # every unit's root type and name, then the def index -- every top-level
    # name of every unit, marked not yet typechecked -- BEFORE any resolution,
    # so a reference always finds its declaration and never mints a shell for
    # a name that has one. Generator lowering indexes what it synthesizes.
    registerUnitRoots :st :program
    indexUnitDefs :st frame: ztypes.declid :program
    match (
        program
    ) case program then {
        (declareCanonicalType
            :st
            frame: ztypes.declid
            ast: program.ast

            unitDecl: st.typing.systemUnitRoot
            ownerNameId: zast.nameid
            name: "never"
            typetype: ztypes.ztypetype.neverType
        )
        st.typing.nullTypeId = (declareCanonicalType
            :st
            frame: ztypes.declid
            ast: program.ast

            unitDecl: st.typing.systemUnitRoot
            ownerNameId: zast.nameid
            name: "null"
            typetype: ztypes.ztypetype.nullType
        )
    } else null
    lowerGenerators :st frame: ztypes.declid :program
    # the main unit's passes run in the main unit's frame; a walk that enters
    # another declaration sets its own and restores this one
    # the main unit's root is the frame the program-level passes resolve in
    rf: ztypes.declid
    match (
        program
    ) case program then {
        mro: (st.typing.declFindChild
            parentDeclId: st.typing.programRoot
            nameId: (nameIdOf ast: program.ast name: program.mainUnitName.stringView)
        )
        if (mro.isZero) == false then rf = mro
    } else null
    registerAndResolveMain :st frame: rf :program
    resolveMainUnitInstantiations :st frame: rf :program
    scanMainBodyCalls :st frame: rf :program rootOnly: (st.typing.eagerAll) == false
    demandAllDefs :st :program
    resolveDemands :st frame: rf :program
    match (
        program
    ) case program then {
        (fixupCustomTags
            :st
            frame: rf
            ast: program.ast

            unitDecl: st.typing.mainUnitRoot
        )
    } else null
    match (
        program
    ) case program then {
        seedFoldNatives :st frame: rf ast: program.ast
    } else null
    resolveConstantDefs :st frame: rf :program
    completeUnitInstantiations :st frame: rf :program
    applyUnitVisibility :st :program
    stampTyperefs :st :program
    checkBodies :st frame: rf :program
    # AFTER checkBodies: whether a program reaches a unit is not settled until
    # its bodies have been walked -- `x: 1.5.f128` is what pulls quadfloat in,
    # and nothing before this point knows that. Running earlier made every
    # require: block a claim about every program.
    checkRequireBlocks :st :program
    walkGenericUnitTemplates :st frame: rf :program
    match (
        program
    ) case program then {
        ctorUd9: (unitDeclOfNameOrOwn
            :st
            frame: rf
            nameId: (nameIdOf ast: program.ast name: program.mainUnitName.stringView)
        )
        (stampCtorDefaults
            ast: program.ast
            :st
            frame: rf
            unitDecl: ctorUd9
        )
    } else null
    foldLiteralStamps :st frame: rf :program
    match (
        program
    ) case program then {
        canonUd9: (unitDeclOfNameOrOwn
            :st
            frame: rf
            nameId: (nameIdOf ast: program.ast name: program.mainUnitName.stringView)
        )
        (canonicalizeShellChildren
            ast: program.ast
            :st
            frame: rf
            unitDecl: canonUd9
        )
        (canonicalizeShellNodeStamps
            ast: program.ast
            :st
            frame: rf
            unitDecl: canonUd9
        )
        checkAnyBounds ast: program.ast :st
        stampAliasValues :st ast: program.ast
        stampGenericBounds :st ast: program.ast
        stampGenericParams :st ast: program.ast
    } else null
    return st
}
