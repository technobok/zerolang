} is {
    tdb: objectTypedefBaseId :ast onode: rnode
    if (tdb.isZero) == false then {
        tdk: rid
        st.typing.typedefBaseName.set key: tdk value: tdb
    }
    tdt: objectTypedefBaseTid :st :frame :ast :unitDecl onode: rnode
    if tdt > 0 then {
        tdk5: rid
        (st.typing.typedefBaseTid.set
            key: (ztypes.tid.create from: tdk5.u64)
            value: (ztypes.tid.create from: tdt.u64)
