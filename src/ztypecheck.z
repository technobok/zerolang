            stampRefDecl ty: st.typing nid: dp.nodeid.u64 declId: mD9
        }
        # A subtype member named on a tagged TYPE (not a value of it, not the
        # tag, not a method) is a construction reference: record the dotted
        # node's tagged parent (construction dispatch and generic-union
        # inference key off it), stamp the path with the parent, and the
        # path's value IS the parent. A VALUE base makes the path the arm
        # PREDICATE: it types bool (true when the value currently holds
        # that arm) and stamps dpArmPredicate for the tag-compare emission.
        btt0: st.reg.typetypeOf typeId: bt
        isTagged0: false
        if btt0 == ztypes.ztypetype.variantType then isTagged0 = true
        if btt0 == ztypes.ztypetype.unionType then isTagged0 = true
        if isTagged0 then {
            ctt0: st.reg.typetypeOf typeId: (ztypes.tid.create from: mo.u64)
            isMember0: true
            if ctt0 == ztypes.ztypetype.functionType then isMember0 = false
            if ctt0 == ztypes.ztypetype.dataType then isMember0 = false
            if isMember0 then {
                isVal9: taggedRecvIsValue :ast :st n: (ast.nodes.get i: dp.parent.u64)
                if (isVal9) == false then {
                    # arm constructors are members: from OUTSIDE the type an
                    # unlisted arm is private (a public alias translated above).
                    armHidden9: false
                    if aliasViaX9 == false then {
                        baseNodeC9: ast.nodes.get i: dp.parent.u64
                        if (baseIsPrivateCapable :st :ast :bt baseNode: baseNodeC9) == false then {
                            if (declMemberIsPrivate
                                ty: st.typing
                                reg: st.reg
                                tid: bt
                                nameId: (ast.names.find s: cn.stringview)
                            ) then armHidden9 = true
                        }
                    }
                    if armHidden9 then {
                        ccnid9: nodeId n: (ast.nodes.get i: dp.child.u64)
                        ccln9: nodeLine n: (ast.nodes.get i: dp.child.u64)
                        cccl9: nodeCol n: (ast.nodes.get i: dp.child.u64)
                        ccbn9: typeNameOf :st tid: bt
                        (addErrorH
                            :st
                            nodeid: ccnid9
                            lineno: ccln9
                            colno: cccl9
                            e: zast.err.notPublic
                            msg: "'\{cn}' is not public on type '\{ccbn9}'"
                            note: "".string
                            hint: "".string
                            width: cn.length.u32.orPanic
                        )
                        return (ztypes.tid.create from: 0)
                    }
                    dpk0: dp.nodeid.u64
                    dpv0: bt
                    st.typing.dpTaggedParent.set key: dpk0 value: dpv0
                    setdp0: bt
                    stampGate :st nid: dp.nodeid.u64 tid: setdp0
                    return bt
                }
                isArm9: true
                if ctt0 == ztypes.ztypetype.tagType then isArm9 = false
                gtpl9: false
                {
                    isgeneric9v: st.reg.isGenericOf tid: bt
                        if isgeneric9v then gtpl9 = true
                }
                if isArm9 when (gtpl9) == false then {
                    boolId9: (optU64Or
                        o: (walkLookupTyperef
                            :ast
                            ty: st.typing
                            reg: st.reg
                            :unitDecl
                            base: "bool"
                        )
                        d: 0
                    )
                    if boolId9 > 0 then {
                        st.typing.dpArmPredicate.set key: dp.nodeid.u64 value: bt
                        stampGate :st nid: dp.nodeid.u64 tid: (ztypes.tid.create from: boolId9.u64)
                        return (ztypes.tid.create from: boolId9)
                    }
                }
            }
        }
        if (st.typing.isAsConstClone typeId: (ztypes.tid.create from: mo.u64)) then {
            setcc: mo
            stampGate :st nid: dp.nodeid.u64 tid: (ztypes.tid.create from: setcc.u64)
            return (ztypes.tid.create from: mo)
        }
        rm: mo
        result: ztypes.tid
        result = ztypes.tid.create from: rm.u64
        # `X.create` in value position is zero-argument construction (the same
        # as the bare type name); route it through the shared construction check
        # so a synthesized create's required fields are enforced and the
        # implicitCreate stamp drives field-wise emission.
        if coerce when cnId9 == zast.wkCreate when (st.reg.typetypeOf typeId: (ztypes.tid.create from: mo.u64)) == ztypes.ztypetype.functionType when (isImplicitZeroCreateTid
            :ast
            :st
            tid: bt
        ) == false then {
            (checkBareTypeValueAt
                :ast
                :st
                :unitDecl
                nodeid: dp.nodeid
                lineno: dp.lineno
                colno: dp.colno
                width: cn.length.u32.orPanic
                tid: bt
            )
            setcr9: bt
            stampGate :st nid: dp.nodeid.u64 tid: setcr9
            return bt
        }
        # Reading a protocol-typed conformance member projects a borrow of
        # the receiver: the consuming binding becomes BORROWED with the base
        # as its origin (and installs the borrow locks).
        rmtt: st.reg.typetypeOf typeId: (ztypes.tid.create from: rm.u64)
        if rmtt == ztypes.ztypetype.protocolType then {
            pjroot: bareAtomName :ast n: (ast.nodes.get i: dp.parent.u64)
            if pjroot.length > 0 then {
                pjvo: st.lookupVarId nameId: (nameIdOf :ast name: pjroot.stringview)
                match (
                    pjvo
                ) case some then {
                    drainPendingBorrow :st
                    pjc: pjroot.copy
                    st.typing.pendingBorrowPath.append pjc
                } case none then null
            }
        }
        if coerce when (st.typing.declIsFnptrField
            pool: ast.names
            parentTypeId: bt
            name: cn.stringview
        ) then {
            # bare name = call: a value-position read of an args-bearing
            # fn-pointer field is a call missing its arguments; `.take` is
            # the reference form (peeled before this leg)
            natE3: st.typing.inAssignTarget
            {
                isNative9v: st.reg.isNativeOf tid: (ztypes.tid.create from: mo.u64)
                    if isNative9v then natE3 = true
            }
            if natE3 == false when (methodHasNoUserArgs
                :ast
                :st
                mid: (ztypes.tid.create from: mo.u64)
            ) == false then {
                mE3: "function-pointer field '\{cn}' takes arguments; call it, or reference it with '.take'"
                (addError
                    :st
                    nodeid: dp.nodeid
                    lineno: dp.lineno
                    colno: dp.colno
                    e: zast.err.callError
                    msg: mE3
                )
            }
        }
        # A member DECLARED as a method but materialised as a plain scalar --
        # a collection's `length`/`capacity`, which emit as a struct field read
        # -- resolves to its RETURN type, so everything keyed on "is this a
        # method?" skipped it, the auto-call receiver lock included. It is still
        # a call, and collapsing is only sound for a READ of the receiver, so it
        # takes the SHARED lock a reader takes. Without this `xs.length` inside
        # an exclusively-pinned iteration was accepted while `xs.contains item:
        # x` beside it was refused -- both readers, and under the locking model
        # a reader takes SHARED for its duration.
        if coerce when (st.reg.typetypeOf typeId: (ztypes.tid.create from: mo.u64)) != ztypes.ztypetype.functionType then {
            if (st.typing.declIsMethodId
                parentTypeId: bt
                nameId: cnId9
            ) then {
                lockAutoCallReceiver :ast :st :dp :bt shared: true
            }
        }
        if coerce when (st.typing.suppressFnAutoCall) == false when (fnAutoCallable
            :ast
            :st
            mid: (ztypes.tid.create from: mo.u64)
        ) then {
            aShr9: isContainerReaderCall :ast :st recvTid: bt mname: cn.stringview
            if (methodReceiverIsView :st mid: (ztypes.tid.create from: mo.u64)) then aShr9 = true
            lockAutoCallReceiver :ast :st :dp :bt shared: aShr9
            ro: methodReturnOf :st mid: (ztypes.tid.create from: mo.u64)
            match (
                ro
            ) case some then {
                result = ro
                fb: st.typing.funcReturnsBorrow.get key: mo
                match (
                    fb
                ) case some then {
                    if fb then {
                        # Build locally, then append through the full field
                        # path (a field list passed as an argument is a
                        # non-owning shallow copy -- appends would be lost).
                        tup: (List String)
                        appendValueTuple :ast n: (ast.nodes.get i: dp.parent.u64) dst: tup
                        drainPendingBorrow :st
                        ti: u64
                        tn: tup.length
                        for ti < tn loop {
                            te: tup.get i: ti
                            tec: te.copy
                            st.typing.pendingBorrowPath.append tec
                            ti = ti + 1
                        }
                        if (returnIsIteratorTid :st tid: result) == false then {
                            st.typing.pendingBorrowShared = true
                        } else {
                            mrv9: (methodReceiverIsView
                                :st
                                mid: (ztypes.tid.create from: mo.u64)
                            )
                            if mrv9 then st.typing.pendingBorrowShared = true
                        }
                        # An `out T.view` result is a READONLY reference: shared pin,
                        # and the binding it lands on may only be read.
                        if (optBoolOr o: (st.typing.funcReturnsView.get key: mo) d: false) then {
                            st.typing.pendingBorrowShared = true
                            st.typing.pendingBorrowReadonly = true
                        }
                    } else {
                        drainPendingBorrow :st
                    }
                } case none then {
                    # an owning auto-call (`.copy` / `.string` / user methods)
                    # consumes any receiver-evaluation borrow residue (the get
                    # in `(xs.get i).copy` must not flow to the binding).
                    drainPendingBorrow :st
                    if (optBoolOr o: (st.typing.funcReturnsTakex.get key: mo) d: false) then {
                        # `takex`: the result is OWNED but pins its source --
                        # the same receiver pin a borrow return takes, without
                        # demoting the binding (`pendingBorrowOwned`).
                        tupX: (List String)
                        appendValueTuple :ast n: (ast.nodes.get i: dp.parent.u64) dst: tupX
                        tiX: u64
                        tnX: tupX.length
                        for tiX < tnX loop {
                            teX: tupX.get i: tiX
                            tecX: teX.copy
                            st.typing.pendingBorrowPath.append tecX
                            tiX = tiX + 1
                        }
                        if (returnIsIteratorTid :st tid: result) == false then {
                            st.typing.pendingBorrowShared = true
                        } else {
                            mrvX9: (methodReceiverIsView :st mid: (ztypes.tid.create from: mo.u64))
                            if mrvX9 then st.typing.pendingBorrowShared = true
                        }
                        st.typing.pendingBorrowOwned = true
                    }
                }
            } case none then {
                # A no-`out` METHOD auto-call resolves to null (the
                # reference's auto-call rule for out-less methods). Non-
                # function members (field shells) keep their re-resolved
                # type.
                if (st.reg.typetypeOf typeId: (ztypes.tid.create from: mo.u64)) == ztypes.ztypetype.functionType then {
                    result = ztypes.tid.create from: (st.typing.nullTypeId)
                }
            }
        }
        if aliasViaX9 == false when (declMemberIsPrivate
            ty: st.typing
            reg: st.reg
            tid: bt
            nameId: (ast.names.find s: cn.stringview)
        ) then {
            baseN9: ast.nodes.get i: dp.parent.u64
            if (baseIsPrivateCapable :st :ast :bt baseNode: baseN9) == false then {
                cnidP9: nodeId n: (ast.nodes.get i: dp.child.u64)
                cnlnP9: nodeLine n: (ast.nodes.get i: dp.child.u64)
                cnclP9: nodeCol n: (ast.nodes.get i: dp.child.u64)
                btNmP9: typeNameOf :st tid: bt
                pmsgP9: "'\{cn}' is not public on type '\{btNmP9}'"
                (addErrorH
                    :st
                    nodeid: cnidP9
                    lineno: cnlnP9
                    colno: cnclP9
                    e: zast.err.notPublic
                    msg: pmsgP9
                    note: "".string
                    hint: "".string
                    width: cn.length.u32.orPanic
                )
            }
        }
        stampGate :st nid: dp.nodeid.u64 tid: result
        return result
    } case none then {
        if (st.reg.typetypeOf typeId: bt) == ztypes.ztypetype.genericParam then {
            # `.copy` is an ownership primitive, not a constrained member:
            # every instantiation copies, so a generic-param receiver types
            # it t -> t (the per-instance clone emits the concrete copy).
            if cn.stringview == "copy" then {
                stampGate :st nid: dp.nodeid.u64 tid: bt
                return bt
            }
            btn9x: typeNameOf :st tid: bt
            mgp9: "type parameter '\{btn9x}' has no member '\{cn}' (its constraint provides none)"
            (addError
                :st
                nodeid: dp.nodeid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.genericError
                msg: mgp9
            )
        }
        # `.copy` on a receiver with no copy member is a hard error: deep
        # copy exists for strings, containers, and generic type parameters
        # only. Without this the emitter has no clone to emit and the
        # miss would surface as invalid C.
        if cn.stringview == "copy" when (st.reg.typetypeOf typeId: bt) != ztypes.ztypetype.genericParam then {
            # per-mono instance walk: `.copy` on a template param was
            # validated against the template (t -> t); the instance lowers
            # it per type (valtypes/views bitwise, String deep). Only the
            # user-reftype capability gap stays an error.
            if st.typing.curMonoStamp > 0 then {
                bttIw9: st.reg.typetypeOf typeId: bt
                isRefIw9: false
                if bttIw9 == ztypes.ztypetype.classType then isRefIw9 = true
                if bttIw9 == ztypes.ztypetype.unionType then isRefIw9 = true
                if isRefIw9 then {
                    # native view classes (StringView) copy by assignment --
                    # only USER reftypes lack a lowering
                    if (st.reg.isNativeOf tid: bt) then isRefIw9 = false
                }
                if bt == (builtinTidTc :ast :st base: "StringView") then isRefIw9 = false
                if (isRefIw9) == false then {
                    stampGate :st nid: dp.nodeid.u64 tid: bt
                    return bt
                }
            }
            btnCp9: typeNameOf :st tid: bt
            bttCp9: st.reg.typetypeOf typeId: bt
            isValCp9: false
            if bttCp9 == ztypes.ztypetype.recordType then isValCp9 = true
            if bttCp9 == ztypes.ztypetype.variantType then isValCp9 = true
            if bttCp9 == ztypes.ztypetype.facetType then isValCp9 = true
            # A valtype's DEFAULT `.copy` is the byte copy its assignment
            # already performs -- a valtype holds no reftype, so copying the
            # bytes copies the whole value. Writing one in the as-block
            # overrides this default; the member lookup above finds it first
            # and never reaches here. `copy: null` strikes the default off,
            # and a monomorphised instance inherits its template's decision.
            cpOff9: st.typing.copyOptOut.has item: bt
            if (cpOff9) == false then {
                cpOrg9: st.reg.genericOriginOf tid: bt
                if cpOrg9 > 0 then cpOff9 = st.typing.copyOptOut.has item: cpOrg9
            }
            if isValCp9 when (cpOff9) == false then {
                stampGate :st nid: dp.nodeid.u64 tid: bt
                return bt
            }
            if cpOff9 then {
                mOff9: "type '\{btnCp9}' has no '.copy': its `as` block defines `copy: null`, striking the default copy off the type"
                (addError
                    :st
                    nodeid: dp.nodeid
                    lineno: dp.lineno
                    colno: dp.colno
                    e: zast.err.typeError
                    msg: mOff9
                )
                return (ztypes.tid.create from: 0)
            }
            mCp9: "type '\{btnCp9}' has no '.copy': a reftype has no default copy -- define a 'copy' method on '\{btnCp9}' saying what a duplicate means, or move with '.take'"

            if bt == (builtinTidTc :ast :st base: "StringView") then {
                mCp9 = "type 'StringView' has no '.copy': a view is copied by assignment; '.string' makes an owned String (allocates)".string
            }
            (addError
                :st
                nodeid: dp.nodeid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.typeError
                msg: mCp9
            )
            return (ztypes.tid.create from: 0)
        }
        # unknown member on a concrete user-defined type: hard error.
        # Shells (no defining unit), stdlib/native types, and template
        # walks stay silent -- their members resolve through later
        # passes or per-instantiation.
        bttMm9: st.reg.typetypeOf typeId: bt
        isConcMm9: false
        if bttMm9 == ztypes.ztypetype.recordType then isConcMm9 = true
        if bttMm9 == ztypes.ztypetype.classType then isConcMm9 = true
        if bttMm9 == ztypes.ztypetype.unionType then isConcMm9 = true
        if bttMm9 == ztypes.ztypetype.variantType then isConcMm9 = true
        if isConcMm9 when (memberStrictType :st :bt) then {
            if st.typing.suppressParamStamps == false then {
                # demand-order safety: walk the type's methods once and
                # re-probe before declaring the member unknown
                btnMm0: typeNameOf :st tid: bt
                walkDefinitionById :st :ast tid: bt
                (forceMemberOf ty: st.typing reg: st.reg :ast parentTypeId: bt nameId: cnId9)
                moMm9: st.typing.declChildOfId parentTypeId: bt nameId: cnId9
                stillMiss9: true
                match (
                    moMm9
                ) case some then {
                    stillMiss9 = false
                } case none then null
                # a numeric-type-named member on a numeric base is a width
                # conversion; the identity form (x.T where x is already T) is
                # not a declared child but is a valid (redundant) cast.
                if stillMiss9 then {
                    baseNum9: false
                    if (isNumericTypeName name: btnMm0.stringview) then baseNum9 = true
                    if btnMm0.stringview == "literal_int" then baseNum9 = true
                    if btnMm0.stringview == "literal_float" then baseNum9 = true
                    if (isNumericTypeName name: cn.stringview) when baseNum9 then stillMiss9 = false
                }
                if stillMiss9 then {
                    btnMm9: typeNameOf :st tid: bt
                    mMm9: "type '\{btnMm9}' has no member '\{cn}'"
                    sugMm9: suggestSimilar :ast :st parentTypeId: bt name: cn.stringview
                    hMm9: String
                    if sugMm9.length > 0 then {
                        hhMm9: "did you mean '\{sugMm9}'?"
                        hMm9 = hhMm9
                    }
                    if (declMemberIsPrivate
                        ty: st.typing
                        reg: st.reg
                        tid: bt
                        nameId: (ast.names.find s: cn.stringview)
                    ) then {
                        hpMm9: "'\{cn}' is private (not in the public interface)"
                        hMm9 = hpMm9
                    }
                    cnidMm9: nodeId n: (ast.nodes.get i: dp.child.u64)
                    cnlnMm9: nodeLine n: (ast.nodes.get i: dp.child.u64)
                    cnclMm9: nodeCol n: (ast.nodes.get i: dp.child.u64)
                    (addErrorH
                        :st
                        nodeid: cnidMm9
                        lineno: cnlnMm9
                        colno: cnclMm9
                        e: zast.err.typeError
                        msg: mMm9
                        note: "".string
                        hint: hMm9
                        width: cn.length.u32.orPanic
                    )
                }
            }
        }
        return (ztypes.tid.create from: 0)
    }
}

# typecheck a bare identifier reference.
checkAtomid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    node: zast.AtomIdData.view
} out ztypes.tid is {
    ndNm9: ast.names.texts.get i: node.name.u64
    result: ztypes.tid
    vtOpt: st.lookup nameId: (nameIdOf :ast name: ndNm9.stringview)
    match (
        vtOpt
    ) case some then {
        result = ztypes.tid.create from: vtOpt.u64
        # break/continue diverge: the atom's value is never (the scope
        # entry stays the unregistered placeholder).
        isBrk9: false
        if node.name.u32 == zast.wkBreak then isBrk9 = true
        if node.name.u32 == zast.wkContinue then isBrk9 = true
        if isBrk9 then {
            result = ztypes.tid.create from: (optU64Or
                o: (walkLookupTyperef
                    :ast
                    ty: st.typing
                    reg: st.reg
                    :unitDecl
                    base: "never"
                )
                d: result.u64
            )
        }
        stampGate :st nid: node.nodeid.u64 tid: result
        # atom-use variable id: stamped even during template walks (variable
        # ids are valid there; stampGate only gates GENERIC_PARAM types)
        avo9: st.lookupVarId nameId: (nameIdOf :ast name: ndNm9.stringview)
        match (
            avo9
        ) case some then {
            setav9: avo9
            st.typing.atomVariableId.set key: node.nodeid.u64 value: setav9
        } case none then null
    } case none then {
        if node.name.u32 == zast.wkReturn then {
            mrt9: st.typing.currentReturnTypeId
            if mrt9 > 0 then {
                mtt9: st.reg.typetypeOf typeId: mrt9
                isVoidRet9: false
                if mtt9 == ztypes.ztypetype.nullType then isVoidRet9 = true
                if mtt9 == ztypes.ztypetype.neverType then isVoidRet9 = true
                if (isVoidRet9) == false then {
                    rtn9: typeNameOf :st tid: mrt9
                    mm9: "missing return value: function expects '\{rtn9}'"
                    en6: String
                    eh6: String
                    (addErrorH
                        :st
                        nodeid: node.nodeid
                        lineno: node.lineno
                        colno: node.colno
                        e: zast.err.typeError
                        msg: mm9
                        note: en6
                        hint: eh6
                        width: 6
                    )
                }
            }
        }
        if (st.isTakenName nameId: (nameIdOf :ast name: ndNm9.stringview)) then {
            eh5: String
            m5: "cannot use '\{ndNm9}' after ownership transfer"
            nt5: "this name no longer owns a value; it was moved earlier".string
            (addErrorH
                :st
                nodeid: node.nodeid
                lineno: node.lineno
                colno: node.colno
                e: zast.err.ownerError
                msg: m5
                note: nt5
                hint: eh5
                width: ndNm9.length.u32.orPanic
            )
            return (ztypes.tid.create from: 0)
        }
        if (isNumericLiteralName name: ndNm9.stringview) then {
            # an INLINE type suffix (`65u8`, `2.5f32`) is not zerolang syntax:
            # a conversion applies to a complete literal (`(65).u8`). Exempt
            # 0x lexemes whose tail is hex-digit text (0x1f32, 0xac8) and 0c
            # char literals (0c8 ends in a c8-shaped tail).
            sfR9: ztypes.suffixInfoOf numstr: ndNm9.stringview
            rejS9: false
            if sfR9.has then {
                rejS9 = true
                if (ndNm9.stringview.startsWith prefix: "0x") then {
                    sb9: ndNm9.stringview.byteAt (ndNm9.length - sfR9.len)
                    match (
                        sb9
                    ) case some then {
                        if sb9 == 102 then rejS9 = false
                        if sb9 == 99 then rejS9 = false
                    } case none then null
                }
                if (ndNm9.stringview.startsWith prefix: "0c") then rejS9 = false
            }
            if rejS9 then {
                core8: ndNm9.stringview.substring from: 0 to: (ndNm9.length - sfR9.len)
                sfx8: (ndNm9.stringview.substring
                    from: (ndNm9.length - sfR9.len)
                    to: ndNm9.length
                )
                m8: "Unknown reference '\{ndNm9}'"
                h8: "a numeric conversion applies to a complete literal: write (\{core8}).\{sfx8}"
                en8: String
                (addErrorH
                    :st
                    nodeid: node.nodeid
                    lineno: node.lineno
                    colno: node.colno
                    e: zast.err.badReference
                    msg: m8
                    note: en8
                    hint: h8
                    width: ndNm9.length.u32.orPanic
                )
                return (ztypes.tid.create from: 0)
            }
            if (isFloatLiteralName name: ndNm9.stringview) then {
                result = st.reg.literalFloatTid
            } else {
                result = st.reg.literalIntTid
            }
            setl: result
            stampGate :st nid: node.nodeid.u64 tid: setl
        } else {
            fo: (walkLookupTyperef
                :ast
                ty: st.typing
                reg: st.reg
                :unitDecl
                base: ndNm9.stringview
            )
            match (
                fo
            ) case some then {
                result = ztypes.tid.create from: fo.u64
                # A bare no-arg non-generic FUNCTION name is a call: the
                # value is its return (an unregistered shell when out-less).
                isAutoFn: false
                if fo < st.reg.typeById.length then {
                    fz9: st.reg.typeById.get i: fo
                    if fz9.typetype == ztypes.ztypetype.functionType then {
                        if (fz9.isgeneric) == false then isAutoFn = true
                    }
                }
                if isAutoFn when (st.typing.suppressFnAutoCall) == false then {
                    if (fnAutoCallable
                        :ast
                        :st
                        mid: (ztypes.tid.create from: fo.u64)
                    ) == false then {
                        isAutoFn = false
                        (bareFnRefError
                            :ast
                            :st
                            nodeid: node.nodeid
                            lineno: node.lineno
                            colno: node.colno
                            width: ndNm9.length.u32.orPanic
                            fid: (ztypes.tid.create from: fo.u64)
                        )
                    }
                } else {
                    isAutoFn = false
                }
                if isAutoFn then {
                    ro9: methodReturnOf :st mid: (ztypes.tid.create from: fo.u64)
                    match (
                        ro9
                    ) case some then {
                        result = ro9
                    } case none then {
                        result = ztypes.tid.create from: (st.typing.nullTypeId)
                    }
                }
                if (st.typing.suppressBareCtor) == false then {
                    # only an atom NAMING the type is a bare construction; a
                    # value alias typed as it (true: bool.true) is a value use.
                    # The renamed-twin aliases name their type without
                    # matching its registry name; a general typeref retry
                    # cannot stand here because a VALUE alias also resolves
                    # to its type's tid (`true` -> bool).
                    tnq9: typeNameOf :st tid: (ztypes.tid.create from: fo.u64)
                    isTypeAtom9: tnq9.stringview == ndNm9.stringview
                    if (isTypeAtom9) == false then {
                        twn9: ""
                        if ndNm9.stringview == "List" then twn9 = "ListRef"
                        if ndNm9.stringview == "Set" then twn9 = "SetRef"
                        if ndNm9.stringview == "Map" then twn9 = "MapRR"
                        if twn9.length > 0 when twn9 == tnq9.stringview then isTypeAtom9 = true
                        # an atom naming a TYPE alias constructs exactly as the
                        # type's own name does. The tid cannot say so -- a VALUE
                        # alias resolves to its root type's tid too -- but the
                        # alias's own shape can. Without this the atom stays
                        # unstamped and the emitter writes the alias name into
                        # the C.
                        if (isTypeAtom9) == false then {
                            aad9: (declOfUnitDef
                                ty: st.typing
                                :ast
                                :unitDecl
                                name: ndNm9.stringview
                            )
                            if (aliasNamesType
                                ty: st.typing
                                reg: st.reg
                                :ast
                                declId: aad9
                            ) then {
                                # The alias test says TYPE; the CONSTANT gets to
                                # overrule it. `ECHO: LIB` names a string
                                # constant whose own type is StringView, so the
                                # test above sees a decl carrying a type -- and a
                                # bare StringView is an unconstructible view. A
                                # definition with a compile-time value is a VALUE
                                # alias, the case this leg's own comment names
                                # for `true: bool.true`.
                                # Asked SECOND, not first: the answer only
                                # matters when the alias test said yes, and a
                                # pull in front of it runs the evaluator for
                                # every bare atom in every body.
                                ecv9: (constValueOfMember
                                    :ast
                                    ty: st.typing
                                    reg: st.reg
                                    :unitDecl
                                    defName: ndNm9.stringview
                                )
                                constFailClear ty: st.typing
                                if ecv9.kind.none then isTypeAtom9 = true
                            }
                        }
                    }
                    if isTypeAtom9 then {
                        if (isImplicitZeroCreateTid
                            :ast
                            :st
                            tid: (ztypes.tid.create from: fo.u64)
                        ) then {
                            icv9: fo
                            st.typing.implicitCreate.set key: node.nodeid.u64 value: icv9
                        } else {
                            (checkBareTypeConstruction
                                :st
                                :unitDecl
                                :ast
                                :node
                                tid: (ztypes.tid.create from: fo.u64)
                            )
                        }
                    }
                }
                setu: result
                stampGate :st nid: node.nodeid.u64 tid: setu
                # atom-use def reference: the DEF's declaration (nodeType
                # carries the auto-call RETURN type above, not the referent)
                sfF9: (declSurfaceOfName
                    ty: st.typing
                    reg: st.reg
                    :ast
                    :unitDecl
                    nameId: node.name
                    tid: (ztypes.tid.create from: fo.u64)
                )
                stampRefDecl ty: st.typing nid: node.nodeid.u64 declId: sfF9
                maybeWalkMethods :st :unitDecl :ast name: ndNm9.stringview
            } case none then null
        }
    }
    return result
}

# isFloatLiteralName -- a numeric-literal atom carrying a decimal point (the
# float default; hex/binary stay integer literals).
isFloatLiteralName: function {name: StringView} out bool is {
    i: u64
    n: name.length
    for i < n loop {
        b: name.byteAt i
        match (
            b
        ) case some then {
            if b == 46 then return true
        } case none then null
        i = i + 1
    }
    return false
}

# isComparisonOp -- a binop operator whose result is bool (not the operand type).
isComparisonOp: function {name: StringView} out bool is {
    if name == "<" then return true
    if name == ">" then return true
    if name == "<=" then return true
    if name == ">=" then return true
    if name == "==" then return true
    if name == "!=" then return true
    return false
}

# ArmPredFact -- one bare arm predicate recognized in an if condition: the
# subject variable, the arm, the sum type, and whether the condition form
# is negated (`(x.a) == false` / trailing `.false`).
# stampTruthyCond -- record which arm a bare 2-arm-sum condition HOLDS when it
# is true: the second one, the type's non-falsy arm. Every reader then treats
# `if x` as `if x.<that arm>`. Stamped rather than derived, because a generic
# mono's record lives on the template it was minted from and reaching it needs
# the registry mutably.
stampTruthyCond: function {
    st: zenv.ZSymbolTable
    n: Node.view
    tid: ztypes.tid
} is {
    ta9: ztyping.sumPairTruthyArmOf ty: st.typing reg: st.reg :tid
    if ta9 == 0 then return
    nid9: nodeId :n
    if nid9.isZero then return
    st.typing.truthyCondArm.set key: nid9.u64 value: ta9
}

ArmPredFact: class {
    subject: String
    armName: String
    fullTid: ztypes.tid
    negated: bool
}

# predDottedCore -- an ArmPredFact from an exploded predicate dotted node
# (`x.a` carrying a dpArmPredicate stamp on a non-bool receiver with a
# bare-variable subject), or none.
predDottedCore: function {ast: Ast.view
    st: zenv.ZSymbolTable.view
    nid: u64
    parent: Node.view
    childName: StringView
    boolId: u64
    negated: bool
} out Option ArmPredFact is {
    ptid9: optTidOr o: (st.typing.dpArmPredicate.get key: nid) d: ztypes.tid
    if ptid9.isZero then return (Option.none ArmPredFact)
    if ptid9.u64 == boolId then return (Option.none ArmPredFact)
    sn9: bareAtomName :ast n: parent
    if sn9.length == 0 then return (Option.none ArmPredFact)
    if childName.length == 0 then return (Option.none ArmPredFact)
    an9: childName.string
    return (Option.some (ArmPredFact
        subject: sn9
        armName: an9
        fullTid: (ztypes.tid.create from: ptid9.u64)
        :negated
    ))
}

# predDottedFact -- predDottedCore over a Node (expression wrappers peeled).
predDottedFact: function {ast: Ast.view
    st: zenv.ZSymbolTable.view
    n: Node.view
    boolId: u64
    negated: bool
} out Option ArmPredFact is {
    match (
        n
    ) case expression then {
        return (predDottedFact
            :ast
            :st
            n: (ast.nodes.get i: n.expression.u64)
            :boolId
            :negated
        )
    } case dottedpath then {
        cnc9: atomName :ast n: (ast.nodes.get i: n.child.u64)
        return (predDottedCore
            :ast
            :st
            nid: n.nodeid.u64
            parent: (ast.nodes.get i: n.parent.u64)
            childName: cnc9.stringview
            :boolId
            :negated
        )
    } else {
        return (Option.none ArmPredFact)
    }
}

# predFactOf -- recognize an if-condition operation as an arm predicate:
# bare `x.a`, trailing-bool `x.a.true` / `x.a.false`, or the comparison
# `(x.a) == true` / `(x.a) == false`. none otherwise.
# armSuffixSide -- the `.true` / `.false` suffix on a dotted arm predicate,
# read by arm identity. See ztyping.armSuffixSideOf.
armSuffixSide: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    nid: u64
    parent: Node.view
    child: Node.view
} out ztyping.armside is {
    cid9: atomNameId :ast n: child
    return (ztyping.armSuffixSideOf
        ty: st.typing
        :nid
        parentNid: (nodeId n: parent).u64
        childNameId: cid9.u64
    )
}

# truthyCondArmOf -- the arm a bare 2-arm-sum condition at `nid` holds, 0 when
# the node is not one.
truthyCondArmOf: function {st: zenv.ZSymbolTable.view nid: u64} out u64 is {
    o9: st.typing.truthyCondArm.get key: nid
    match (
        o9
    ) case some then {
        return o9
    } case none then {
        return 0
    }
}

predFactOf: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    n: Node.view
    boolId: u64
} out Option ArmPredFact is {
    # A bare 2-arm sum as the condition IS an arm predicate with the arm left
    # implicit, so it states the same fact `if x.<arm>` states and narrows both
    # branches the same way: the then branch holds the arm, the else branch
    # excludes it and collapses only when what remains carries a payload.
    {
        ta0: truthyCondArmOf :st nid: (nodeId :n).u64
        if ta0 > 0 then {
            sj0: bareAtomName :ast :n
            ft0: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: (nodeId :n).u64
            if sj0.length > 0 when (ft0.isZero) == false then {
                am0: zast.nameTextCopy :ast ref: (zast.nameid.create from: ta0.u32.orPanic)
                return (Option.some (ArmPredFact
                    subject: sj0
                    armName: am0
                    fullTid: ft0
                    negated: false
                ))
            }
        }
    }
    match (
        n
    ) case expression then {
        return (predFactOf :ast :st n: (ast.nodes.get i: n.expression.u64) :boolId)
    } case dottedpath then {
        cn9: atomName :ast n: (ast.nodes.get i: n.child.u64)
        # `.true` / `.false` on a predicate: which side it is comes from the
        # stamped type's arm ORDER, never from the spelling of the segment.
        sd9: (armSuffixSide
            :ast
            :st
            nid: n.nodeid.u64
            parent: (ast.nodes.get i: n.parent.u64)
            child: (ast.nodes.get i: n.child.u64)
        )
        if sd9.truthy then return (predDottedFact
            :ast
            :st
            n: (ast.nodes.get i: n.parent.u64)
            :boolId
            negated: false
        )
        if sd9.falsy then return (predDottedFact
            :ast
            :st
            n: (ast.nodes.get i: n.parent.u64)
            :boolId
            negated: true
        )
        return (predDottedCore
            :ast
            :st
            nid: n.nodeid.u64
            parent: (ast.nodes.get i: n.parent.u64)
            childName: cn9.stringview
            :boolId
            negated: false
        )
    } case binop then {
        opn9: bareAtomName :ast n: (ast.nodes.get i: n.operator.u64)
        if opn9.stringview == "==" then {
            # `== true` / `== false`: the operand names one of bool's arms,
            # and which side it is comes from bool's arm ORDER. boolId is the
            # canonical id the clause check already resolved.
            lsd9: (ztyping.armSideOfName
                ty: st.typing
                typeId: boolId
                nameId: (bareAtomNameId :ast n: (ast.nodes.get i: n.lhs.u64)).u64
            )
            rsd9: (ztyping.armSideOfName
                ty: st.typing
                typeId: boolId
                nameId: (bareAtomNameId :ast n: (ast.nodes.get i: n.rhs.u64)).u64
            )
            if rsd9.truthy then return (predDottedFact
                :st
                :ast
                n: (ast.nodes.get i: n.lhs.u64)
                :boolId
                negated: false
            )
            if rsd9.falsy then return (predDottedFact
                :st
                :ast
                n: (ast.nodes.get i: n.lhs.u64)
                :boolId
                negated: true
            )
            if lsd9.truthy then return (predDottedFact
                :st
                :ast
                n: (ast.nodes.get i: n.rhs.u64)
                :boolId
                negated: false
            )
            if lsd9.falsy then return (predDottedFact
                :st
                :ast
                n: (ast.nodes.get i: n.rhs.u64)
                :boolId
                negated: true
            )
        }
        return (Option.none ArmPredFact)
    } else {
        return (Option.none ArmPredFact)
    }
}

# shadowCollapseIfSingle -- when exclusions have collapsed `name` to a
# single PAYLOAD arm, upgrade to the shadow narrowing:
# the bare name becomes the payload, exactly as in a match arm. A null
# payload keeps the outer type (nothing to read). Condition-derived
# call sites only -- construction narrowing never routes through here.
shadowCollapseIfSingle: function {ast: Ast st: zenv.ZSymbolTable name: StringView fullTid: u64} is {
    arm9: st.narrowedArmOf nameId: (nameIdOf :ast :name) fullTypeId: fullTid
    if arm9.length == 0 then return
    po9: (st.typing.declChildOf
        pool: ast.names
        parentTypeId: (ztypes.tid.create from: fullTid.u64)
        name: arm9.stringview
    )
    match (
        po9
    ) case some then {
        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: po9.u64)) == ztypes.ztypetype.nullType then return
        (st.narrow
            pool: ast.names
            nameId: (nameIdOf :ast :name)
            toTypeId: po9
            subtypeName: arm9.stringview
            shadow: true
        )
        (armPayloadReadonly
            :st
            :ast
            subject: name
            parentTid: fullTid
            armName: arm9.stringview
            payloadTid: (ztypes.tid.create from: po9.u64)
        )
    } case none then null
}

# applyPredFact -- record one predicate fact on its subject in the current
# branch scope. `holds` is the branch's knowledge of the condition: true
# on the then path, false on else/later-clause paths. A holding positive
# (or failing negated) fact SHADOW-narrows to the arm (the bare name is
# the payload); the opposite excludes it, and an exclusion that leaves a
# single payload arm collapses to the same shadow form.
applyPredFact: function {ast: Ast st: zenv.ZSymbolTable f: ArmPredFact.view holds: bool} is {
    doNarrow9: false
    if holds when (f.negated) == false then doNarrow9 = true
    if (holds) == false when f.negated then doNarrow9 = true
    if doNarrow9 then {
        po9: (st.typing.declChildOf
            pool: ast.names
            parentTypeId: f.fullTid
            name: f.armName.stringview
        )
        match (
            po9
        ) case some then {
            (st.narrow
                pool: ast.names
                nameId: (nameIdOf :ast name: f.subject.stringview)
                toTypeId: po9
                subtypeName: f.armName.stringview
                shadow: true
            )
            (armPayloadReadonly
                :st
                :ast
                subject: f.subject.stringview
                parentTid: f.fullTid
                armName: f.armName.stringview
                payloadTid: (ztypes.tid.create from: po9.u64)
            )
        } case none then null
    } else {
        (st.exclude
            pool: ast.names
            nameId: (nameIdOf :ast name: f.subject.stringview)
            subtypeName: f.armName.stringview
            fullTypeId: f.fullTid
        )
        shadowCollapseIfSingle :ast :st name: f.subject.stringview fullTid: f.fullTid
    }
}

# postGuardRecord -- record the post-guard narrowing of `subject` under the
# guarding statement's node id when the applied facts left it SHADOW-
# narrowed to a payload arm: the emitter aliases the bare name for the
# rest of the enclosing block.
postGuardRecord: function {
    ast: Ast
    st: zenv.ZSymbolTable
    stmtNid: u32
    subject: StringView
    fullTid: ztypes.tid
} is {
    if (st.isShadowNarrowed nameId: (nameIdOf :ast name: subject)) == false then return
    arm9: st.getSubtypeName nameId: (nameIdOf :ast name: subject)
    if arm9.length == 0 then return
    po9: (st.typing.declChildOf
        pool: ast.names
        parentTypeId: (ztypes.tid.create from: fullTid.u64)
        name: arm9.stringview
    )
    match (
        po9
    ) case some then {
        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: po9.u64)) == ztypes.ztypetype.nullType then return
        sn9: subject.string
        st.typing.postGuardName.set key: stmtNid.u64 value: sn9
        pgv9: optVidOr o: (st.lookupVarId nameId: (nameIdOf :ast name: subject))
        st.typing.postGuardVarId.set key: stmtNid.u64 value: pgv9
        rv9: ztypes.mangleVarName name: subject
        st.typing.postGuardRecv.set key: stmtNid.u64 value: rv9
        st.typing.postGuardTid.set key: stmtNid.u64 value: fullTid
        av9: arm9.copy
        st.typing.postGuardArm.set key: stmtNid.u64 value: av9
    } case none then null
}

# checkClause -- walk one if-clause: its condition(s) (namedoperation-wrapped),
# then this clause's predicate facts as condition-true knowledge (appended to
# factsOut), then its then-statement block.
checkClause: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    clause: Node.view
    factsOut: List ArmPredFact
    boolId: u64
} out u64 is {
    match (
        clause
    ) case ifclause then {
        with coiter: clause.conditions.iterate do for condId9: coiter loop {
            cond: ast.nodes.get i: condId9.u64
            match (
                cond
            ) case namedoperation then {
                ctv9: (checkValue
                    :st
                    :unitDecl
                    :ast
                    node: (ast.nodes.get i: cond.operation.u64)
                )
                # An if-condition must be a boolean. A non-bool value (a
                # resultval, an aggregate, a raw numeric) is a type error rather
                # than invalid C. Bare arm predicates (`o.none`, `b.false`) type
                # as bool already; a diverging never-typed condition is allowed.
                # ... and so is any other 2-arm sum type: it has a falsy arm
                # and a truthy one, which is all a condition needs. Which arm
                # is which comes from the order the author wrote them.
                if ctv9 > 0 when boolId > 0 when ctv9 != boolId then {
                    ctt9: st.reg.typetypeOf typeId: ctv9
                    isPair9: ztyping.isSumPair ty: st.typing reg: st.reg tid: ctv9
                    if isPair9 then {
                        (stampTruthyCond
                            :st
                            n: (ast.nodes.get i: cond.operation.u64)
                            tid: ctv9
                        )
                    }
                    if ctt9 != ztypes.ztypetype.neverType when (isPair9) == false then {
                        conode9: ast.nodes.get i: cond.operation.u64
                        ctnm9: typeNameOf :st tid: ctv9
                        cmsg9: "condition must be bool or a 2-arm sum type, got '\{ctnm9}'"
                        (addError
                            :st
                            nodeid: (nodeId n: conode9)
                            lineno: (nodeLine n: conode9)
                            colno: (nodeCol n: conode9)
                            e: zast.err.typeError
                            msg: cmsg9
                        )
                    }
                }
            } else null
        }
        with cfit9: clause.conditions.iterate do for cnd9Id9: cfit9 loop {
            cnd9: ast.nodes.get i: cnd9Id9.u64
            match (
                cnd9
            ) case namedoperation then {
                fo9: predFactOf :ast :st n: (ast.nodes.get i: cnd9.operation.u64) :boolId
                match (
                    fo9
                ) case some then {
                    factsOut.append fo9.take
                } case none then null
            } else null
        }
        with afit9: factsOut.iterate do for af9: afit9 loop (applyPredFact
            :ast
            :st
            f: af9
            holds: true
        )
        cs9: ast.nodes.get i: clause.statement.u64
        # a condition's borrow residue is dead once the condition value is
        # consumed -- it must not leak into the block's argument lock seeds
        drainPendingBorrow :st
        checkStatement :st :unitDecl :ast block: cs9
        return (lastStmtType :st :ast block: cs9)
    } else {
        return 0
    }
}

# lastStmtType -- the resolved type id of a statement block's last statement
# (the value of a do-block), or 0 when empty/untyped.
lastStmtType: function {st: zenv.ZSymbolTable ast: Ast.view block: Node.view} out u64 is {
    result: u64
    match (
        block
    ) case statement then {
        ne: block.statements.length
        if ne > 0 then {
            lastId9: block.statements.get i: (ne - 1)
            last: ast.nodes.get i: lastId9.u64
            match (
                last
            ) case statementline then {
                lst9: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: last.nodeid.u64
                if lst9 > 0 then result = lst9
            } else null
        }
    } else {
        # An expression-shaped body (a bare `then 10` branch) carries its
        # value on its own node.
        bid9: nodeId n: block
        if bid9 > 0 then {
            bst9: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: bid9.u64
            if bst9 > 0 then result = bst9
        }
    }
    return result
}

# materialiseLiteral -- fold a literal pseudo-type id to its concrete default
# (i64 / f64); concrete ids pass through.
materialiseLiteral: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    t: u64
} out ztypes.tid is {
    base: ""
    if t == st.reg.literalIntTid then base = "i64"
    if t == st.reg.literalFloatTid then base = "f64"
    if base.length == 0 then return (ztypes.tid.create from: t)
    got9: (optU64Or
        o: (walkLookupTyperef :ast ty: st.typing reg: st.reg :unitDecl :base)
        d: 0
    )
    if got9 > 0 then return (ztypes.tid.create from: got9)
    # a bare literal in a value context with no expected type IS `42.i64`: it
    # demands its own default scalar, the way the suffixed form and the
    # literal-NAME form (resolveNamedType) already do. Without this nothing
    # demands i64 for `x: 42` -- a literal names nothing.
    dn9: descendNamed ty: st.typing reg: st.reg :ast unitDecl: st.typing.systemUnitRoot name: base
    if dn9 > 0 then return dn9
    return (ztypes.tid.create from: t)
}

# checkAssignment -- a local binding `name: value`: walk the value, materialise a
# literal-typed value to its concrete default (the binding takes i64, unlike a
# for-loop binding which keeps the pseudo id), define the local (owned for a plain
# value), and stamp the assignment node + def-variable.
checkAssignment: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    asgn: zast.AssignmentData.view
} is {
    drainPendingBorrow :st
    av9: ast.nodes.get i: asgn.value.u64
    errA0: st.typing.errors.length
    vt: checkValue :st :unitDecl :ast node: av9
    mvt: materialiseLiteral :ast :st :unitDecl t: vt
    vt = mvt
    if vt.isZero when st.typing.errors.length == errA0 then {
        reportUnresolvedValue :st :unitDecl :ast vnode: av9
    }
    if vt > 0 when (st.reg.typetypeOf typeId: vt) == ztypes.ztypetype.nullType then {
        m1: "'null' cannot be used as a value — null must be wrapped in a union or variant (eg. option.none)".string
        vln1: nodeLine n: av9
        vcl1: nodeCol n: av9
        vid1: nodeId n: av9
        en1: String
        eh1: String
        (addErrorH
            :st
            nodeid: vid1
            lineno: vln1
            colno: vcl1
            e: zast.err.typeError
            msg: m1
            note: en1
            hint: eh1
            width: 4
        )
        return
    }
    if vt > 0 then {
        bsrc: (List String)
        takePendingBorrow :st dst: bsrc
        own: ztypes.zownership.owned
        # A `takex` result is pinned like a borrow but OWNED like a take, so the
        # pin must not demote it. `pendingBorrowOwned` is what tells them apart.
        pboX9: st.typing.pendingBorrowOwned
        if bsrc.length > 0 when (typeIsReftype :st tid: vt) then {
            if (pboX9) == false then own = ztypes.zownership.borrowed
        }
        v: st.reg.newVariable ztypeId: vt ownership: own
        vid: v.variableId
        if own == ztypes.zownership.borrowed then {
            r0: bsrc.get i: 0
            bo: r0.copy
            v.borrowOrigin = (Option.some bo)
        }
        # An `out T.view` result makes its binding readonly because the binding
        # IS the reference it handed back. A value merely DERIVED from one --
        # a valtype field read, a comparison, an arithmetic result -- is a fresh
        # value that aliases nothing, so it must not inherit the restriction.
        # `own` already draws exactly that line: the pin transfers only to a
        # reftype binding that the borrow actually flowed into.
        roRef9: false
        if own == ztypes.zownership.borrowed then roRef9 = st.typing.pendingBorrowReadonly
        st.typing.pendingBorrowReadonly = false
        st.defineVar nameId: asgn.name var: v
        vid2: vid
        st.typing.defVariableId.set key: asgn.nodeid.u64 value: vid2
        st.typing.variableOrigin.set key: vid2 value: false
        setk: vt
        stampGate :st nid: asgn.nodeid.u64 tid: setk
        if roRef9 then {
            rrn9: (ast.names.texts.get i: asgn.name.u64).stringview
            rrr9: readonlySelfLock :st :ast name: rrn9 vid: vid2
            if rrr9.length > 0 then {
                (addError
                    :st
                    nodeid: asgn.nodeid
                    lineno: asgn.lineno
                    colno: asgn.colno
                    e: zast.err.ownerError
                    msg: rrr9
                )
            }
        }
        rn5: bareAtomName :ast n: av9
        # The readonly test runs OUTSIDE the destructor gate below: a frozen
        # binding may not be moved out of whether or not its type owns heap,
        # and without a destructor the emitter builds a value from a pointer
        # and gcc rejects the C.
        roMv5: false
        if rn5.length > 0 when (typeIsReftype :st tid: vt) then {
            if (nameIsReadonly :st :ast name: rn5.stringview) then {
                roMv5 = true
                (readonlyMoveError
                    :st
                    nodeid: asgn.nodeid
                    lineno: asgn.lineno
                    colno: asgn.colno
                    name: rn5.stringview
                    verb: "into an owned binding"
                )
            } else {
                if (pinnedMoveError
                    :st
                    :ast
                    nodeid: asgn.nodeid
                    lineno: asgn.lineno
                    colno: asgn.colno
                    name: rn5.stringview
                    verb: "into an owned binding"
                ) then roMv5 = true
            }
        }
        if rn5.length > 0 when (roMv5) == false when (typeIsReftype
            :st
            tid: vt
        ) when (st.reg.hasDestructorName typeId: vt) then {
            vo5: st.lookupVarId nameId: (nameIdOf :ast name: rn5.stringview)
            match (
                vo5
            ) case some then {
                if (isBorrowedVar :st vid: vo5) then {
                    mb5: "Cannot move borrowed variable '\{rn5}' into an owned binding — borrowed names stay bound to their source for the full scope"
                    (addError
                        :st
                        nodeid: asgn.nodeid
                        lineno: asgn.lineno
                        colno: asgn.colno
                        e: zast.err.ownerError
                        msg: mb5
                    )
                } else {
                    (st.invalidate
                        nameId: (nameIdOf :ast name: rn5.stringview)
                        loc: (optionval.none ztypes.zsrcpos)
                    )
                }
            } case none then null
        }
        # Readonly is deep: a reftype read out of a readonly path is itself
        # readonly, and takes the same self-lock. Without this the binding is
        # a laundering step -- `i: c.sub` off a `view` receiver would hand back
        # a freely mutable name.
        roPath9: (List String)
        appendValueTuple :ast n: av9 dst: roPath9
        roDeep9: false
        if roPath9.length > 1 when (typeIsReftype :st tid: vt) then {
            if (pathLeafIsMethod :st :ast path: roPath9) == false then {
                if (pathIsReadonly :st :ast path: roPath9) then roDeep9 = true
            }
        }
        if roDeep9 when (valueIsHold :ast n: av9) == false then {
            rop9: (List String)
            ropn9: (ast.names.texts.get i: asgn.name.u64).stringview.string
            rop9.append ropn9
            roh9: (ztypes.zlockholder
                kind: ztypes.zlockholderkind.varKind
                id: vid2
            )
            ror9: (st.tryLock
                pool: ast.names
                path: rop9
                lockType: ztypes.zlockstate.shared
                lockScope: ztypes.zlockscope.target
                holder: roh9
            )
            if ror9.length > 0 then {
                (addError
                    :st
                    nodeid: asgn.nodeid
                    lineno: asgn.lineno
                    colno: asgn.colno
                    e: zast.err.ownerError
                    msg: ror9
                )
            }
        }
        if (valueIsHold :ast n: av9) when (typeIsReftype :st tid: vt) then {
            # Owned but frozen: the same readonly self-lock a `view` parameter
            # takes, so writes, mutating receivers and re-passing to a mutable
            # parameter are all caught by the ordinary lock rules. Ownership is
            # the other axis and is already `owned` above.
            hpp9: (List String)
            hpn9: (ast.names.texts.get i: asgn.name.u64).stringview.string
            hpp9.append hpn9
            hph9: (ztypes.zlockholder
                kind: ztypes.zlockholderkind.varKind
                id: vid2
            )
            hpr9: (st.tryLock
                pool: ast.names
                path: hpp9
                lockType: ztypes.zlockstate.shared
                lockScope: ztypes.zlockscope.target
                holder: hph9
            )
            if hpr9.length > 0 then {
                (addError
                    :st
                    nodeid: asgn.nodeid
                    lineno: asgn.lineno
                    colno: asgn.colno
                    e: zast.err.ownerError
                    msg: hpr9
                )
            }
        }
        instX9: false
        if own == ztypes.zownership.borrowed then instX9 = true
        if pboX9 when bsrc.length > 0 then instX9 = true
        st.typing.pendingBorrowOwned = false
        if instX9 then {
            lfsA9: isViewFamilyTid :ast :st tid: vt
            if st.typing.pendingBorrowShared then lfsA9 = true
            st.typing.pendingBorrowShared = false
            (installBorrowLocks
                :st
                :ast
                pool: ast.names
                src: bsrc
                :vid
                leafShared: lfsA9
                nodeid: asgn.nodeid
                lineno: asgn.lineno
                colno: asgn.colno
            )
        }
        # Binding a tagged-subtype construction narrows the name to the
        # constructed arm (assignment-based narrowing: the overlay keeps the
        # subject's type and records the narrowed subtype).
        ucArm: unionCreateArmName :ast :st n: av9
        if ucArm.length > 0 then {
            (st.narrow
                pool: ast.names
                nameId: asgn.name
                toTypeId: vt
                subtypeName: ucArm.stringview
                shadow: false
            )
        }
    }
}

# checkReassignment -- `lhs = value`: resolve the target path and the value, then
# reset any narrowing on a bare-name target (appends a non-definition overlay
# entry, mirroring _check_reassignment_inner's reset_narrowing).
checkReassignment: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    rasgn: zast.ReassignmentData.view
} is {
    st.typing.inAssignTarget = true
    tpn9: ast.nodes.get i: rasgn.topath.u64
    rvn9: ast.nodes.get i: rasgn.value.u64
    lvt: checkValue :st :unitDecl :ast node: tpn9
    st.typing.inAssignTarget = false
    # `h = y.hold`: a hold binding rebinds only when the marker is written
    # again, so its readonly self-lock steps aside for this assignment and is
    # retaken over the new value. Without the marker the lock stands and the
    # write is rejected -- there is no implicit downgrade at a reassignment.
    hbVid9: u64
    hbNm9: atomName :ast n: tpn9
    if hbNm9.length > 0 when (valueIsHold :ast n: rvn9) then {
        hbo9: st.lookupVarId nameId: (nameIdOf :ast name: hbNm9.stringview)
        match (
            hbo9
        ) case some then {
            hlh9: st.findLockHolder nameId: (nameIdOf :ast name: hbNm9.stringview)
            match (
                hlh9
            ) case some then {
                if hlh9.kind == ztypes.zlockholderkind.varKind when hlh9.id == hbo9 then {
                    hbVid9 = hbo9
                    st.releaseHeldLocks holder: hlh9
                }
            } case none then null
        } case none then null
    }
    checkWriteLock :st :ast n: tpn9 verb: "assign to"
    errR0: st.typing.errors.length
    rvt: checkValue :st :unitDecl :ast node: rvn9
    # a value that resolved to nothing and raised nothing: an unresolvable
    # root name is an unknown reference, as at a binding
    if rvt.isZero when st.typing.errors.length == errR0 then {
        ubnR0: unresolvedBareCallable :ast :st :unitDecl n: rvn9
        if ubnR0.length > 0 then {
            umR0: "Unknown reference '\{ubnR0}'"
            enR0: String
            ehR0: String
            (addErrorH
                :st
                nodeid: (nodeId n: rvn9)
                lineno: (nodeLine n: rvn9)
                colno: (nodeCol n: rvn9)
                e: zast.err.badReference
                msg: umR0
                note: enR0
                hint: ehR0
                width: ubnR0.length.u32.orPanic
            )
        }
    }
    if hbVid9 > 0 then {
        hrp9: (List String)
        hrn9: hbNm9.copy
        hrp9.append hrn9
        hrh9: (ztypes.zlockholder
            kind: ztypes.zlockholderkind.varKind
            id: hbVid9
        )
        hrr9: (st.tryLock
            pool: ast.names
            path: hrp9
            lockType: ztypes.zlockstate.shared
            lockScope: ztypes.zlockscope.target
            holder: hrh9
        )
        if hrr9.length > 0 then {
            (addError
                :st
                nodeid: rasgn.nodeid
                lineno: rasgn.lineno
                colno: rasgn.colno
                e: zast.err.ownerError
                msg: hrr9
            )
        }
    }
    mrv0: materialiseLiteral :ast :st :unitDecl t: rvt
    if mrv0 > 0 when (st.reg.typetypeOf typeId: mrv0) == ztypes.ztypetype.nullType then {
        m0n: "'null' cannot be used as a value — null must be wrapped in a union or variant (eg. option.none)".string
        vln0: nodeLine n: rvn9
        vcl0: nodeCol n: rvn9
        vid0: nodeId n: rvn9
        en0: String
        eh0: String
        (addErrorH
            :st
            nodeid: vid0
            lineno: vln0
            colno: vcl0
            e: zast.err.typeError
            msg: m0n
            note: en0
            hint: eh0
            width: 4
        )
        return
    }
    # A typeof-placeholder field resolves at its first write: swap the
    # field child to the RHS's type and restamp the target path.
    if lvt > 0 when rvt > 0 then {
        tso: st.typing.typeofShell.get key: lvt
        match (
            tso
        ) case some then {
            troot: methodReceiverRoot :ast n: tpn9
            if troot.length > 0 then {
                tto: st.lookup nameId: (nameIdOf :ast name: troot.stringview)
                match (
                    tto
                ) case some then {
                    tfn: dottedChildName :ast n: tpn9
                    if tfn.length > 0 then {
                        mrvt: materialiseLiteral :ast :st :unitDecl t: rvt
                        (st.typing.setMemberType
                            parentTypeId: (ztypes.tid.create from: tto.u64)
                            nameId: (zast.poolFind pool: ast.names text: tfn.stringview)
                            childTypeId: mrvt
                        )
                        settof: mrvt
                        stampGate :st nid: tso.u64 tid: settof
                        tpid: nodeId n: tpn9
                        if tpid > 0 then {
                            settp: mrvt
                            stampGate :st nid: tpid.u64 tid: settp
                        }
                    }
                } case none then null
            }
        } case none then null
    }
    # A literal RHS at a concretely-typed target coerces: restamp the RHS's
    # innermost node (wrappers derive through the dump's descent). A
    # literal-typed target (a literal-init loop binding) keeps the pseudo.
    if lvt > 0 when rvt > 0 when (isLiteralTypeId :st tid: rvt) then {
        if (isLiteralTypeId :st tid: lvt) == false then {
            iid: innermostNodeId :ast n: rvn9
            if iid > 0 then {
                setc: lvt
                stampGate :st nid: iid.u64 tid: setc
            }
        }
    }
    # The RHS value must be assignable to the target's declared type. Numeric
    # coercion (a literal, or a concrete-to-concrete numeric) is permitted here
    # exactly as at a call argument; a non-numeric type mismatch -- a resultval
    # where a scalar is expected, a String into a numeric field -- is an error
    # rather than invalid C downstream.
    if lvt > 0 when rvt > 0 then {
        # Validate against the target's declared type: a narrowed bare-name
        # target accepts a fresh value of its whole type (reassignment resets
        # narrowing). A field target has no bare name and keeps lvt.
        chkT9: lvt
        {
            nmC9: atomName :ast n: tpn9
            if nmC9.length > 0 then {
                dtoC9: st.declaredTypeOf nameId: (nameIdOf :ast name: nmC9.stringview)
                match (
                    dtoC9
                ) case some then {
                    chkT9 = ztypes.tid.create from: dtoC9.u64
                } case none then null
            }
        }
        if (typesCompatible :ast :st :unitDecl a: rvt b: chkT9) == false then {
            skipR9: false
            if (isNumericTid
                :ast
                ty: st.typing
                reg: st.reg
                tid: rvt
            ) when (isNumericTid :ast ty: st.typing reg: st.reg tid: chkT9) then skipR9 = true
            lttR9: st.reg.typetypeOf typeId: chkT9
            if lttR9 == ztypes.ztypetype.protocolType then skipR9 = true
            if lttR9 == ztypes.ztypetype.facetType then skipR9 = true
            if lttR9 == ztypes.ztypetype.genericParam then skipR9 = true
            if lttR9 == ztypes.ztypetype.functionType then skipR9 = true
            tsoR9: st.typing.typeofShell.get key: chkT9
            if tsoR9.some then skipR9 = true
            if (skipR9) == false then {
                enR9: typeNameOf :st tid: chkT9
                anR9: typeNameOf :st tid: rvt
                mmR9: "cannot assign value of type '\{anR9}' to '\{enR9}' target"
                (addError
                    :st
                    nodeid: rasgn.nodeid
                    lineno: rasgn.lineno
                    colno: rasgn.colno
                    e: zast.err.callError
                    msg: mmR9
                )
            }
        }
    }
    nm: atomName :ast n: tpn9
    if nm.length > 0 then {
        st.resetNarrowing nameId: (nameIdOf :ast name: nm.stringview)
        nvo9: st.lookupVarId nameId: (nameIdOf :ast name: nm.stringview)
        match (
            nvo9
        ) case some then {
            if (isBorrowedVar :st vid: nvo9) then {
                ma9: "Cannot reassign borrowed variable '\{nm}'"
                ha9: "borrowed names are bound for their full scope; shadow in an inner scope instead".string
                ena9: String
                (addErrorH
                    :st
                    nodeid: rasgn.nodeid
                    lineno: rasgn.lineno
                    colno: rasgn.colno
                    e: zast.err.ownerError
                    msg: ma9
                    note: ena9
                    hint: ha9
                    width: nm.length.u32.orPanic
                )
            }
        } case none then null
    }
    troot9: methodReceiverRoot :ast n: tpn9
    tfn9: dottedChildName :ast n: tpn9
    if troot9.length > 0 when tfn9.length > 0 then {
        tto9: st.lookup nameId: (nameIdOf :ast name: troot9.stringview)
        match (
            tto9
        ) case some then {
            if (st.typing.declIsLockField
                pool: ast.names
                parentTypeId: (ztypes.tid.create from: tto9.u64)
                name: tfn9.stringview
            ) then {
                tmk9: "lock".string
                {
                    tmo9: (st.typing.declOwnershipOfId
                        parentTypeId: (ztypes.tid.create from: tto9.u64)
                        nameId: (zast.poolFind pool: ast.names text: tfn9.stringview)
                    )
                    match (
                        tmo9
                    ) case some then {
                        tmt9: markerText o: tmo9
                        if tmt9.length > 0 then tmk9 = tmt9
                    } case none then null
                }
                md9: "Cannot reassign '.\{tmk9}' field '\{tfn9}' — a non-owned field is set at construction time and immutable"
                (addError
                    :st
                    nodeid: rasgn.nodeid
                    lineno: rasgn.lineno
                    colno: rasgn.colno
                    e: zast.err.ownerError
                    msg: md9
                )
            }
        } case none then null
    }
    # A bare-name reftype RHS is a move: the source invalidates (the symtab
    # appends its taken overlay entry).
    rn: bareAtomName :ast n: rvn9
    if rn.length > 0 when rvt > 0 when (typeIsReftype :st tid: rvt) then {
        vo: st.lookupVarId nameId: (nameIdOf :ast name: rn.stringview)
        match (
            vo
        ) case some then {
            if (nameIsReadonly :st :ast name: rn.stringview) then {
                (readonlyMoveError
                    :st
                    nodeid: rasgn.nodeid
                    lineno: rasgn.lineno
                    colno: rasgn.colno
                    name: rn.stringview
                    verb: "by reassignment"
                )
            } else {
                rpin9: (pinnedMoveError
                    :st
                    :ast
                    nodeid: rasgn.nodeid
                    lineno: rasgn.lineno
                    colno: rasgn.colno
                    name: rn.stringview
                    verb: "by reassignment"
                )
                if rpin9 then null else if (isBorrowedVar :st vid: vo) then {
                    mc9: "Cannot move borrowed variable '\{rn}' by reassignment — borrowed names stay bound to their source for the full scope; copy with '.copy' to keep the source"
                    (addError
                        :st
                        nodeid: rasgn.nodeid
                        lineno: rasgn.lineno
                        colno: rasgn.colno
                        e: zast.err.ownerError
                        msg: mc9
                    )
                } else {
                    (st.invalidate
                        nameId: (nameIdOf :ast name: rn.stringview)
                        loc: (optionval.none ztypes.zsrcpos)
                    )
                }
            }
        } case none then null
    }
}

# checkSwap -- `lhs swap rhs`: resolve both operand paths (stamping them). The swap
# carries no type (the expression wrapper is null, like reassignment) and does no
# narrowing. Operand ownership/lock/type-match validation produces no dump rows -- deferred.
checkSwap: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    ast: Ast.view
    swapnode: zast.SwapStmtData.view
} is {
    checkValue :st :unitDecl :ast node: (ast.nodes.get i: swapnode.lhs.u64)
    checkValue :st :unitDecl :ast node: (ast.nodes.get i: swapnode.rhs.u64)
    checkWriteLock :st :ast n: (ast.nodes.get i: swapnode.lhs.u64) verb: "swap"
    checkWriteLock :st :ast n: (ast.nodes.get i: swapnode.rhs.u64) verb: "swap"
}

# withValueOwnership -- the with-binding's ownership from the bound value's
# syntactic shape, mirroring the reference's function-argument rules: a bare
# name bound to a runtime variable or a plain dotted path borrows; `.take`
# transfers; calls, literals and constructions are fresh owned values.
withValueOwnership: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    v: Node.view
} out ztypes.zownership is {
    match (
        v
    ) case expression then {
        return (withValueOwnership :ast :st v: (ast.nodes.get i: v.expression.u64))
    } case atomid then {
        vNm9: ast.names.texts.get i: v.name.u64
        vo: st.lookupVarId nameId: (nameIdOf :ast name: vNm9.stringview)
        match (
            vo
        ) case some then {
            return ztypes.zownership.borrowed
        } case none then {
            return ztypes.zownership.owned
        }
    } case dottedpath then {
        cn: atomName :ast n: (ast.nodes.get i: v.child.u64)
        if cn.stringview == "take" then {
            return ztypes.zownership.owned
        } else {
            return ztypes.zownership.borrowed
        }
    } else {
        return ztypes.zownership.owned
    }
}

# checkWith -- walk `with name: value do body`: push the `with` scope, bind the
# alias variable (BORROWED for a plain-path value), walk the body, then pop. The
# with node carries the bound value's type; the with-expression's value is the
# body's value.
checkWith: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    withnode: zast.WithData.view
} out ztypes.tid is {
    withMarker: st.pushBlock name: "with"
    errW9: st.typing.errors.length
    vt: checkValue :st :unitDecl :ast node: (ast.nodes.get i: withnode.value.u64)
    if vt.u64 == 0 when st.typing.errors.length == errW9 then {
        (reportUnresolvedValue
            :st
            :unitDecl
            :ast
            vnode: (ast.nodes.get i: withnode.value.u64)
        )
    }
    if vt > 0 then {
        own: withValueOwnership :ast :st v: (ast.nodes.get i: withnode.value.u64)
        # The borrow target: a BORROW-returning auto-call reported the receiver
        # source; a plain-path value locks its full dotted tuple. Valtype
        # borrows are copies -- no lock.
        btgt: (List String)
        takePendingBorrow :st dst: btgt
        if btgt.length == 0 then {
            if own == ztypes.zownership.borrowed then {
                appendValueTuple :ast n: (ast.nodes.get i: withnode.value.u64) dst: btgt
            }
        } else {
            # A pending borrow from the value's call (a lock-param transfer
            # or a borrow-marked return) makes the with-binding borrowed.
            own = ztypes.zownership.borrowed
        }
        v: st.reg.newVariable ztypeId: vt ownership: own
        # the borrow origin, as a plain binding records it: what this alias is
        # a reference INTO. A for-loop over an iterator alias reads it back to
        # learn how strongly the alias pins the container it walks.
        if btgt.length > 0 then {
            w0: btgt.get i: 0
            wbo: w0.copy
            v.borrowOrigin = (Option.some wbo)
        }
        vid: v.variableId
        st.defineVar nameId: withnode.name var: v
        vid2: vid
        st.typing.defVariableId.set key: withnode.nodeid.u64 value: vid2
        if (typeIsReftype :st tid: vt) then {
            lfsW9: isViewFamilyTid :ast :st tid: vt
            if st.typing.pendingBorrowShared then lfsW9 = true
            st.typing.pendingBorrowShared = false
            (installBorrowLocks
                :st
                :ast
                pool: ast.names
                src: btgt
                :vid
                leafShared: lfsW9
                nodeid: withnode.nodeid
                lineno: withnode.lineno
                colno: withnode.colno
            )
        }
        setk: vt
        stampGate :st nid: withnode.nodeid.u64 tid: setk
    }
    dt: checkValue :st :unitDecl :ast node: (ast.nodes.get i: withnode.body.u64)
    st.popTo marker: withMarker
    return dt
}

# blockHasBreak -- a bare `break` statement somewhere in this block's own
# control flow (descending if/match/with bodies but NOT nested do/for, whose
# breaks bind to them). Drives the do-block's optionval wrapping.
blockHasBreak: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case statement then {
        siter: n.statements.iterate
        for s0Id9: siter loop {
            if (blockHasBreak :ast n: (ast.nodes.get i: s0Id9.u64)) then return true
        }
        return false
    } case statementline then {
        return (blockHasBreak :ast n: (ast.nodes.get i: n.statementline.u64))
    } case expression then {
        return (blockHasBreak :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return n.name.u32 == zast.wkBreak
    } case ifexpr then {
        cliter: n.clauses.iterate
        for cl0Id9: cliter loop {
            cl0: ast.nodes.get i: cl0Id9.u64
            match (
                cl0
            ) case ifclause then {
                if (blockHasBreak
                    :ast
                    n: (ast.nodes.get i: cl0.statement.u64)
                ) then return true
            } else null
        }
        if n.elseclause.isZero then return false
        return (blockHasBreak :ast n: (ast.nodes.get i: n.elseclause.u64))
    } case caseexpr then {
        mliter: n.clauses.iterate
        for ml0Id9: mliter loop {
            ml0: ast.nodes.get i: ml0Id9.u64
            match (
                ml0
            ) case caseclause then {
                if (blockHasBreak
                    :ast
                    n: (ast.nodes.get i: ml0.statement.u64)
                ) then return true
            } else null
        }
        if n.elseclause.isZero then return false
        return (blockHasBreak :ast n: (ast.nodes.get i: n.elseclause.u64))
    } case withexpr then {
        return (blockHasBreak :ast n: (ast.nodes.get i: n.body.u64))
    } else {
        return false
    }
}

# checkDo -- walk a do-block: push the `block` scope, define break (an entry
# position placeholder with an unregistered type id, so it never joins the dump),
# walk the statements, then pop. The do resolves to its last statement's value type.
checkDo: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    donode: zast.DoData.view
} out ztypes.tid is {
    doMarker: st.pushBlock name: "block"
    dbk: st.reg.ctlPlaceholder
    (st.define
        nameId: (zast.poolSet pool: ast.names text: "break")
        ztypeId: (ztypes.tid.create from: dbk.u64)
    )
    drainPendingBorrow :st
    checkStatement :st :unitDecl :ast block: (ast.nodes.get i: donode.statement.u64)
    result: lastStmtType :st :ast block: (ast.nodes.get i: donode.statement.u64)
    st.popTo marker: doMarker
    # A break-carrying do-block's value wraps in optionval (early exit =
    # none). A literal-typed value needs no special case: it is a registered
    # row like any other, so its name and its payload id read straight off it.
    # A REFTYPE block value wraps in Option instead (boxed payload).
    if result > 0 when (blockHasBreak :ast n: (ast.nodes.get i: donode.statement.u64)) then {
        vtn0: typeNameOf :st tid: (ztypes.tid.create from: result.u64)
        payId0: result
        if vtn0.length > 0 then {
            wrapB0: "optionval"
            if (typeIsReftype :st tid: (ztypes.tid.create from: payId0.u64)) then wrapB0 = "Option"
            ovo0: (walkLookupTyperef
                :ast
                ty: st.typing
                reg: st.reg
                :unitDecl
                base: wrapB0
            )
            match (
                ovo0
            ) case some then {
                osubs0: (MapRV String value: u64)
                ok0: "t".string
                ov0: payId0
                osubs0.set key: ok0 value: ov0
                omn0: "\{wrapB0}_\{vtn0}"
                vsF9: (MapRV String value: u64)
                omid0: (getOrMintSpec
                    :ast
                    ty: st.typing
                    reg: st.reg
                    :unitDecl
                    name: omn0.stringview
                    templateId: (ztypes.tid.create from: ovo0.u64)
                    subs: osubs0
                    valSubs: vsF9
                    fallbackArg: 0
                )
                if omid0 > 0 then result = omid0
            } case none then null
        }
    }
    if result > 0 then {
        setk: result
        stampGate :st nid: donode.nodeid.u64 tid: (ztypes.tid.create from: setk.u64)
    }
    return (ztypes.tid.create from: result)
}

# isCallNode -- the node is a (possibly expression-wrapped) call.
isCallNode: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case call then {
        return true
    } case expression then {
        return (isCallNode :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        return false
    }
}

# checkFor -- walk a for-loop: push the `for` scope, define break/continue (entry
# position placeholders with unregistered type ids, so they never join the dump),
# then walk the conditions, postconditions, and body, and pop. A named condition
# is a binding: define the loop var with the condition value's type (the value of
# a bare literal init stays the literal pseudo-type, keeping the entry out of the
# dump joins). Iterator-wrapper element extraction needs monomorphization and is
# not implemented. The for itself resolves to null (filtered) in statement position.
checkFor: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    fornode: zast.ForData.view
} out ztypes.tid is {
    forMarker: st.pushBlock name: "for"
    bk: st.reg.ctlPlaceholder
    (st.define
        nameId: (zast.poolSet pool: ast.names text: "break")
        ztypeId: (ztypes.tid.create from: bk.u64)
    )
    ct: st.reg.ctlPlaceholder
    (st.define
        nameId: (zast.poolSet pool: ast.names text: "continue")
        ztypeId: (ztypes.tid.create from: ct.u64)
    )
    citer: fornode.conditions.iterate
    for condId9: citer loop {
        cond: ast.nodes.get i: condId9.u64
        match (
            cond
        ) case namedoperation then {
            # A bare 0-arg function returning an iterator class auto-invokes
            # (the reference rewrites the condition to a synthetic call):
            # its walk runs in a call scope and the atom keeps the FUNCTION
            # stamp rather than the auto-call's coerced return.
            facId: u64
            fbn: bareAtomName :ast n: (ast.nodes.get i: cond.operation.u64)
            if fbn.length > 0 then {
                ffo: (walkLookupTyperef
                    :ast
                    ty: st.typing
                    reg: st.reg
                    :unitDecl
                    base: fbn.stringview
                )
                match (
                    ffo
                ) case some then {
                    if (st.reg.typetypeOf typeId: (ztypes.tid.create from: ffo.u64)) == ztypes.ztypetype.functionType then {
                        if (methodHasNoUserArgs
                            :ast
                            :st
                            mid: (ztypes.tid.create from: ffo.u64)
                        ) then {
                            fro: methodReturnOf :st mid: (ztypes.tid.create from: ffo.u64)
                            match (
                                fro
                            ) case some then {
                                if (st.reg.typetypeOf typeId: fro) == ztypes.ztypetype.classType then {
                                    (forceMemberOf
                                        ty: st.typing
                                        reg: st.reg
                                        :ast
                                        parentTypeId: fro
                                        nameId: zast.wkCall
                                    )
                                    fco: (st.typing.declChildOfId
                                        parentTypeId: fro
                                        nameId: zast.wkCall
                                    )
                                    match (
                                        fco
                                    ) case some then {
                                        facId = ffo
                                    } case none then null
                                }
                            } case none then null
                        }
                    }
                } case none then null
            }
            vt: ztypes.tid
            if facId > 0 then {
                # the factory's lazy walks (its body + the iterator class's
                # methods via return-first transitivity) fire before the
                # synthetic invocation's call scope opens.
                maybeWalkMethods :st :unitDecl :ast name: fbn.stringview
                fcm: st.pushCall
                opf29: ast.nodes.get i: cond.operation.u64
                vt = checkValue :st :unitDecl :ast node: opf29
                st.popTo marker: fcm
                fiid: innermostNodeId :ast n: (ast.nodes.get i: cond.operation.u64)
                if fiid > 0 then {
                    setff: facId
                    stampGate :st nid: fiid.u64 tid: (ztypes.tid.create from: setff.u64)
                }
            } else {
                opf39: ast.nodes.get i: cond.operation.u64
                vt = checkValue :st :unitDecl :ast node: opf39
            }
            nm: zast.nameTextAt :ast ref: cond.name
            # A bare `for while <cond> loop` (no binding, no iterator factory)
            # must be boolean; a non-bool, non-iterable value is a type error
            # rather than invalid C. Iterator bindings (`for e: it`) carry a
            # name; iterable inits expose an element wrapper or a `call` child.
            if nm.length == 0 when vt > 0 when facId == 0 then {
                fbId9: builtinTidTc :ast :st base: "bool"
                fIter9: false
                {
                    fpw9: iterWrapperElem :ast :st :unitDecl wid: vt
                    match (
                        fpw9
                    ) case some then {
                        fIter9 = true
                    } case none then null
                }
                {
                    (forceMemberOf
                        ty: st.typing
                        reg: st.reg
                        :ast
                        parentTypeId: vt
                        nameId: zast.wkCall
                    )
                    fico9: st.typing.declChildOfId parentTypeId: vt nameId: zast.wkCall
                    match (
                        fico9
                    ) case some then {
                        fIter9 = true
                    } case none then null
                }
                fTt9: st.reg.typetypeOf typeId: vt
                fPair9: ztyping.isSumPair ty: st.typing reg: st.reg tid: vt
                if fPair9 when (fIter9) == false then {
                    (stampTruthyCond
                        :st
                        n: (ast.nodes.get i: cond.operation.u64)
                        tid: vt
                    )
                }
                if fbId9 > 0 when vt != fbId9 when (fIter9) == false when fTt9 != ztypes.ztypetype.neverType when (fPair9) == false then {
                    fcn9: ast.nodes.get i: cond.operation.u64
                    fctn9: typeNameOf :st tid: vt
                    fcmsg9: "loop condition must be bool or a 2-arm sum type, got '\{fctn9}'"
                    (addError
                        :st
                        nodeid: (nodeId n: fcn9)
                        lineno: (nodeLine n: fcn9)
                        colno: (nodeCol n: fcn9)
                        e: zast.err.typeError
                        msg: fcmsg9
                    )
                }
            }
            if nm.length > 0 when vt > 0 then {
                # A call-shaped iterator init probes its per-iteration call
                # in an empty call scope (the reference's rewrite walks it
                # once); gated on the value being an iterator wrapper.
                if (isCallNode :ast n: (ast.nodes.get i: cond.operation.u64)) then {
                    doProbe9: false
                    pw9: iterWrapperElem :ast :st :unitDecl wid: vt
                    match (
                        pw9
                    ) case some then {
                        doProbe9 = true
                    } case none then {
                        (forceMemberOf
                            ty: st.typing
                            reg: st.reg
                            :ast
                            parentTypeId: vt
                            nameId: zast.wkCall
                        )
                        ico9: st.typing.declChildOfId parentTypeId: vt nameId: zast.wkCall
                        match (
                            ico9
                        ) case some then {
                            doProbe9 = true
                        } case none then null
                    }
                    if doProbe9 then {
                        ecm9: st.pushCall
                        st.popTo marker: ecm9
                    }
                }
                elem: u64
                isView: false
                w1: iterWrapperElem :ast :st :unitDecl wid: vt
                match (
                    w1
                ) case some then {
                    elem = w1
                    isView = isOptionViewMono :ast :st :unitDecl wid: vt
                } case none then null
                if elem == 0 then {
                    if (st.reg.typetypeOf typeId: vt) == ztypes.ztypetype.functionType then {
                        r1: methodReturnOf :st mid: vt
                        match (
                            r1
                        ) case some then {
                            w2: iterWrapperElem :ast :st :unitDecl wid: r1
                            match (
                                w2
                            ) case some then {
                                elem = w2
                                isView = isOptionViewMono :ast :st :unitDecl wid: r1
                            } case none then null
                        } case none then null
                    } else {
                        (forceMemberOf
                            ty: st.typing
                            reg: st.reg
                            :ast
                            parentTypeId: vt
                            nameId: zast.wkCall
                        )
                        c1: st.typing.declChildOfId parentTypeId: vt nameId: zast.wkCall
                        match (
                            c1
                        ) case some then {
                            r2: methodReturnOf :st mid: (ztypes.tid.create from: c1.u64)
                            match (
                                r2
                            ) case some then {
                                w3: iterWrapperElem :ast :st :unitDecl wid: r2
                                match (
                                    w3
                                ) case some then {
                                    elem = w3
                                    isView = isOptionViewMono :ast :st :unitDecl wid: r2
                                } case none then null
                            } case none then null
                        } case none then null
                    }
                }
                if elem > 0 then {
                    if isView then {
                        srcName: atomName :ast n: (ast.nodes.get i: cond.operation.u64)
                        bo: "<iterator>".string
                        if srcName.length > 0 then bo = srcName.copy
                        v: (st.reg.newVariable
                            ztypeId: (ztypes.tid.create from: elem.u64)
                            ownership: ztypes.zownership.borrowed
                        )
                        v.borrowOrigin = (Option.some bo)
                        vid: v.variableId
                        nmId9: zast.poolSet pool: ast.names text: nm.stringview
                    st.defineVar nameId: nmId9 var: v
                        condNid: nodeId n: (ast.nodes.get i: cond.operation.u64)
                        st.typing.defVariableId.set key: condNid.u64 value: vid
                        # `for x: xs.iterate` has no iterator binding to carry
                        # the container's lock, so the element carries it: the
                        # reference the loop hands out points into the
                        # container's storage, and a write through the
                        # container reallocates it. The `with` form leaves
                        # nothing pending here -- its binding took the lock.
                        fbs9: (List String)
                        takePendingBorrow :st dst: fbs9
                        flf9: isViewFamilyTid :ast :st tid: vt
                        if st.typing.pendingBorrowShared then flf9 = true
                        st.typing.pendingBorrowShared = false
                        if fbs9.length > 0 then {
                            fcn9: ast.nodes.get i: cond.operation.u64
                            fnd9: nodeId n: fcn9
                            fln9: nodeLine n: fcn9
                            fcl9: nodeCol n: fcn9
                            (installBorrowLocks
                                :st
                                :ast
                                pool: ast.names
                                src: fbs9
                                :vid
                                leafShared: flf9
                                nodeid: fnd9
                                lineno: fln9
                                colno: fcl9
                            )
                        }
                        # The element is a reference derived from the lock its
                        # holder has on the container, so it inherits that
                        # lock's strength: a SHARED pin (a `view` iterator
                        # receiver) yields READONLY elements, an exclusive one
                        # yields writable ones. The binding-free form knows its
                        # own strength; the `with` form has to ask its binding.
                        elr9: flf9
                        if fbs9.length == 0 then {
                            elr9 = (iterElementIsReadonly
                                :st
                                :ast
                                iterName: srcName.stringview
                            )
                        }
                        if elr9 then {
                            erm9: readonlySelfLock :st :ast name: nm.stringview :vid
                            if erm9.length > 0 then {
                                ecn9: ast.nodes.get i: cond.operation.u64
                                end9: nodeId n: ecn9
                                eln9: nodeLine n: ecn9
                                ecl9: nodeCol n: ecn9
                                (addError
                                    :st
                                    nodeid: end9
                                    lineno: eln9
                                    colno: ecl9
                                    e: zast.err.ownerError
                                    msg: erm9
                                )
                            }
                        }
                    } else {
                        (st.define
                            nameId: (zast.poolSet pool: ast.names text: nm.stringview)
                            ztypeId: (ztypes.tid.create from: elem.u64)
                        )
                    }
                } else {
                    st.define nameId: (zast.poolSet pool: ast.names text: nm.stringview) ztypeId: vt
                }
            }
        } else null
    }
    piter: fornode.postconditions.iterate
    for pcId9: piter loop {
        pc: ast.nodes.get i: pcId9.u64
        pcOp9: pcId9
        match (
            pc
        ) case namedoperation then {
            pcOp9 = pc.operation
        } else null
        pcNd9: ast.nodes.get i: pcOp9.u64
        pcVt9: checkValue :st :unitDecl :ast node: pcNd9
        # A `for loop { ... } while <cond>` post-condition must be boolean, the
        # same rule the pre-condition carries above: a non-bool value is a type
        # error rather than the invalid C a struct in a `while` head emits.
        pbId9: builtinTidTc :ast :st base: "bool"
        if pbId9 > 0 when pcVt9 > 0 when pcVt9 != pbId9 then {
            pTt9: st.reg.typetypeOf typeId: pcVt9
            pPair9: ztyping.isSumPair ty: st.typing reg: st.reg tid: pcVt9
            if pPair9 then stampTruthyCond :st n: pcNd9 tid: pcVt9
            if pTt9 != ztypes.ztypetype.neverType when (pPair9) == false then {
                pctn9: typeNameOf :st tid: pcVt9
                pcmsg9: "loop postcondition must be bool or a 2-arm sum type, got '\{pctn9}'"
                (addError
                    :st
                    nodeid: (nodeId n: pcNd9)
                    lineno: (nodeLine n: pcNd9)
                    colno: (nodeCol n: pcNd9)
                    e: zast.err.typeError
                    msg: pcmsg9
                )
            }
        }
    }
    drainPendingBorrow :st
    walkBodyAt :st :unitDecl :ast bodyId: fornode.body
    elemT9: ztypes.tid
    if fornode.body > 0 then {
        fb9: ast.nodes.get i: fornode.body.u64
        elemT9 = ztypes.tid.create from: (lastStmtType :st :ast block: fb9)
    }
    if st.isUnreachable then st.discardTakenInCurrentScope
    st.popTo marker: forMarker
    # for-as-expression: a value-producing body makes the loop a List of
    # that element type (the comprehension form).
    if elemT9 > 0 then {
        en9: typeNameOf :st tid: (ztypes.tid.create from: elemT9.u64)
        isNull9: false
        if en9.stringview == "null" then isNull9 = true
        if en9.length == 0 then isNull9 = true
        if (isNull9) == false then {
            # the comprehension's element decides the family, exactly as a
            # written-out container declaration would
            ltn9: "ListRef".string
            if (typeIsValtype
                ty: st.typing
                reg: st.reg
                tid: (ztypes.tid.create from: elemT9.u64)
            ) then ltn9 = "ListVal".string
            lto9: (walkLookupTyperef
                :ast
                ty: st.typing
                reg: st.reg
                :unitDecl
                base: ltn9.stringview
            )
            match (
                lto9
            ) case some then {
                lsubs9: (MapRV String value: u64)
                lk9: "of".string
                lv9: elemT9
                lsubs9.set key: lk9 value: lv9
                lsfx9: "_\{en9}"
                lmn9: "\{ltn9}\{lsfx9}"
                vsG9: (MapRV String value: u64)
                lmid9: (getOrMintSpec
                    :ast
                    ty: st.typing
                    reg: st.reg
                    :unitDecl
                    name: lmn9.stringview
                    templateId: (ztypes.tid.create from: lto9.u64)
                    subs: lsubs9
                    valSubs: vsG9
                    fallbackArg: 0
                )
                if lmid9 > 0 then {
                    setf9: lmid9
                    stampGate :st nid: fornode.nodeid.u64 tid: setf9
                    return lmid9
                }
            } case none then null
        }
    }
    return (ztypes.tid.create from: 0)
}

# checkIf -- walk an if: push the `if` scope, then a `if_branch` scope per clause
# and an `if_else` scope for the else; when every branch diverges (returns) the
# if resolves to never and marks the enclosing scope unreachable.
# restoreTakenArm -- after a NON-diverging if arm, undo any takes of outer-scope
# owned vars (clearTaken) so the next arm + the restore see them live, recording
# them in `taken` for a single post-if invalidate. Without this a take in one arm
# propagates (via popTo) into the sibling arm, which then sees the var as gone and
# never stamps its type (e.g. an else-arm's `childpath.take` emitting `.take` on a
# String). Mirrors the reference _check_if_inner per-arm restore; the port's take
# is an overlay over a persisting entry, so clearTaken alone restores (no redefine).
restoreTakenArm: function {st: zenv.ZSymbolTable liveBefore: SetVal u32 taken: SetVal u32} is {
    liveAfter: st.getLiveOwnedVars
    for vn: liveBefore.iterate loop {
        if (liveAfter.has item: vn) == false then {
            taken.add item: vn
            st.clearTaken nameId: (zast.nameid.create from: vn.u32)
        }
    }
}

# invalidateTakenAcross -- after the whole if, mark every var taken in some arm as
# taken in the enclosing scope (it is consumed on at least one path, so a later use
# is use-after-take).
invalidateTakenAcross: function {st: zenv.ZSymbolTable names: SetVal u32} is {
    for vn: names.iterate loop {
        st.invalidate nameId: (zast.nameid.create from: vn.u32) loc: (optionval.none ztypes.zsrcpos)
    }
}

# typecheck an if-expression, narrowing types across its arms.
checkIf: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    ifnode: zast.IfData.view
} out ztypes.tid is {
    # Which clause a constant condition selects, recorded for the emitter. Most
    # body conditions name a local and do not fold at all, and the stamp says
    # so -- `known: false` means "emit a runtime if", which is the answer for
    # every ordinary branch. Only a condition made of constants decides
    # anything here.
    fbr9: foldIfBranch :ast ty: st.typing reg: st.reg :unitDecl n: ifnode
    constFailClear ty: st.typing
    # A clause the fold proved dead is reached by no use site, and the language
    # does not promise to resolve names or check types inside it. NOT walking it
    # is what keeps a statically-eliminated branch from demanding its unit's
    # link library, and from being refused by a toolchain that never sees the
    # type it names. `--eager` -- and so zls and `zl lint --full` -- still walks
    # everything, which is what keeps the editor alive inside a branch that is
    # dead only on this host; neither of those emits C, so no artifact differs.
    skipDead9: false
    if fbr9.known when (st.typing.eagerAll) == false then skipDead9 = true
    ifMarker: st.pushBlock name: "if"
    liveBefore: st.getLiveOwnedVars
    takenAcross: (SetVal u32)
    nvId: (optU64Or
        o: (walkLookupTyperef :ast ty: st.typing reg: st.reg :unitDecl base: "never")
        d: 0
    )
    nullId: (optU64Or
        o: (walkLookupTyperef :ast ty: st.typing reg: st.reg :unitDecl base: "null")
        d: 0
    )
    pBool9: (optU64Or
        o: (walkLookupTyperef :ast ty: st.typing reg: st.reg :unitDecl base: "bool")
        d: 0
    )
    accFacts: (List ArmPredFact)
    guardFacts9: (List ArmPredFact)
    elseDvg9: false
    anyEmpty: false
    branchTypes: (ListVal u64)
    allDiverge: true
    cliter: ifnode.clauses.iterate
    for clauseId9: cliter loop {
        clause: ast.nodes.get i: clauseId9.u64
        dead9: false
        match (
            clause
        ) case ifclause then {
            if (isEmptyBody n: (ast.nodes.get i: clause.statement.u64)) then anyEmpty = true
            if skipDead9 when clause.statement != fbr9.stmt then dead9 = true
        } else null
        if dead9 then continue
        bm: st.pushBlock name: "if_branch"
        with pfit9: accFacts.iterate do for pf9: pfit9 loop (applyPredFact
            :ast
            :st
            f: pf9
            holds: false
        )
        cfacts9: (List ArmPredFact)
        bt9: checkClause :st :unitDecl :ast :clause factsOut: cfacts9 boolId: pBool9
        dvgC9: st.isUnreachable
        btc: bt9
        branchTypes.append btc
        if st.isUnreachable then {
            # a diverging arm transfers ownership on a path that never reaches
            # fall-through: drop its take overlays before pop so they don't
            # bubble into the parent scope (where post-if uses would see the
            # variable as taken).
            st.discardTakenInCurrentScope
        } else {
            allDiverge = false
            restoreTakenArm :st :liveBefore taken: takenAcross
        }
        st.popTo marker: bm
        cn1c9: u64
        match (
            clause
        ) case ifclause then {
            cn1c9 = clause.conditions.length
        } else null
        if cn1c9 == 1 when cfacts9.length == 1 then {
            mvf9: cfacts9.pop
            if dvgC9 then {
                gf9: (ArmPredFact
                    subject: mvf9.subject.copy
                    armName: mvf9.armName.copy
                    fullTid: mvf9.fullTid
                    negated: mvf9.negated
                )
                guardFacts9.append gf9
            }
            accFacts.append mvf9
        }
    }
    hasElse: false
    if ifnode.elseclause > 0 then {
        hasElse = true
        if (isEmptyBody n: (ast.nodes.get i: ifnode.elseclause.u64)) then anyEmpty = true
        elseDead9: false
        if skipDead9 when ifnode.elseclause != fbr9.stmt then elseDead9 = true
        if (elseDead9) == false then {
            ebm: st.pushBlock name: "if_else"
            with efit9: accFacts.iterate do for ef9: efit9 loop (applyPredFact
                :ast
                :st
                f: ef9
                holds: false
            )
            walkBodyAt :st :unitDecl :ast bodyId: ifnode.elseclause
            et9: lastStmtType :st :ast block: (ast.nodes.get i: ifnode.elseclause.u64)
            if st.isUnreachable then elseDvg9 = true
            etc9: et9
            branchTypes.append etc9
            if st.isUnreachable then {
                st.discardTakenInCurrentScope
            } else {
                allDiverge = false
                restoreTakenArm :st :liveBefore taken: takenAcross
            }
            st.popTo marker: ebm
        }
    } else {
        allDiverge = false
    }
    result: ztypes.tid
    if allDiverge then {
        if nvId > 0 then {
            result = ztypes.tid.create from: nvId.u64
            setk: result
            stampGate :st nid: ifnode.nodeid.u64 tid: setk
        }
    } else {
        # An exhaustive (else-carrying) if is a value: the first completing
        # branch's type, diverging branches skipped (mirrors the match rule).
        if hasElse when anyEmpty then {
            # an empty (`{}` / null) branch body makes the if valueless:
            # stamp null so consuming it as a value is rejected.
            if nullId > 0 then {
                result = ztypes.tid.create from: nullId.u64
                setnv0: result
                stampGate :st nid: ifnode.nodeid.u64 tid: setnv0
            }
        }
        if hasElse when (anyEmpty) == false then {
            ti9: u64
            tn9: branchTypes.length
            for ti9 < tn9 loop {
                bt2: branchTypes.get i: ti9
                if bt2 != nvId then {
                    if bt2 > 0 then {
                        result = ztypes.tid.create from: bt2.u64
                        setv9: result
                        stampGate :st nid: ifnode.nodeid.u64 tid: setv9
                        ti9 = tn9
                    } else {
                        ti9 = tn9
                    }
                }
                ti9 = ti9 + 1
            }
        }
    }
    st.popTo marker: ifMarker
    # post-guard flow typing: a diverging clause's condition was FALSE for
    # the remainder of the enclosing scope; a diverging else of a single-
    # clause if means its condition was TRUE. Apply that knowledge (the
    # exclusion collapse shadows to the payload where one arm remains) and
    # record it for the emitter's block aliasing.
    pgSubj9: String
    pgTid9: u64
    pgApplied9: u64
    with gfit9: guardFacts9.iterate do for gf2: gfit9 loop {
        applyPredFact :ast :st f: gf2 holds: false
        pgs9: gf2.subject.copy
        pgSubj9 = pgs9
        pgTid9 = gf2.fullTid
        pgApplied9 = pgApplied9 + 1
    }
    if elseDvg9 when ifnode.clauses.length == 1 when accFacts.length == 1 then {
        af0: accFacts.get i: 0
        applyPredFact :ast :st f: af0 holds: true
        pga9: af0.subject.copy
        pgSubj9 = pga9
        pgTid9 = af0.fullTid
        pgApplied9 = pgApplied9 + 1
    }
    if pgApplied9 == 1 when pgSubj9.length > 0 then {
        (postGuardRecord
            :ast
            :st
            stmtNid: ifnode.nodeid
            subject: pgSubj9.stringview
            fullTid: (ztypes.tid.create from: pgTid9.u64)
        )
    }
    invalidateTakenAcross :st names: takenAcross
    if allDiverge then st.markUnreachable
    return result
}

# checkBinopMethodDispatch -- resolve a binary operator as a declared method on
# the lhs type: materialise a bare-literal lhs for dispatch, chase typedef bases
# to the type that declares the operator, arg-check the rhs against the method's
# first parameter, and return the result type. For a comparison (isCmp9) an
# undeclared operator falls back to bool -- structural `==`/`!=` on records and
# variants; for arithmetic an undeclared operator on a concrete type is an error
# and a bare-literal lhs keeps its coercible literal result. Returns 0 on an
# emitted arg-mismatch.
checkBinopMethodDispatch: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    binop: zast.BinOpData.view
    opn: StringView
    opnId9: zast.nameid
    lt: ztypes.tid
    rt: ztypes.tid
    isCmp9: bool
} out ztypes.tid is {
    ltLit9: isLiteralTypeId :st tid: (ztypes.tid.create from: lt.u64)
    dt9: lt
    if ltLit9 then dt9 = materialiseLiteral :ast :st :unitDecl t: lt
    (forceMemberOf ty: st.typing reg: st.reg :ast parentTypeId: dt9 nameId: opnId9)
    opo: st.typing.declChildOfId parentTypeId: dt9 nameId: opnId9
    # `!=` on a type that writes its own `==` is that `==` negated, and looking
    # for it in the typedef BASE would answer with the base's raw comparison
    # instead -- silently discarding the equality the author defined. The
    # derived-inequality leg below owns this case, so the chase stops here and
    # leaves it to it.
    chase9: true
    if opo.none when opnId9 == zast.wkOpNe then {
        (forceMemberOf ty: st.typing reg: st.reg :ast parentTypeId: dt9 nameId: zast.wkOpEq)
        eqHere9: st.typing.declChildOfId parentTypeId: dt9 nameId: zast.wkOpEq
        if eqHere9.some then chase9 = false
    }
    if chase9 then {
        for opo.none while (typedefBaseOf
            :ast
            :st
            :unitDecl
            tid: (ztypes.tid.create from: dt9.u64)
        ) > 0 loop {
            dt9 = typedefBaseOf :ast :st :unitDecl tid: (ztypes.tid.create from: dt9.u64)
            (forceMemberOf ty: st.typing reg: st.reg :ast parentTypeId: dt9 nameId: opnId9)
            opo = st.typing.declChildOfId parentTypeId: dt9 nameId: opnId9
        }
    }
    # a Box is a heap pointer around ONE valtype and declares no members of its
    # own, so its operators are the boxed element's -- ALWAYS, not only when
    # the Box itself resolves nothing. Under --eager every member is minted,
    # the Box then answers the lookup with an edge of its own, and the operator
    # would be attributed to a type that declares no operators: the same
    # program resolved `Box i64 + i64` to i64 when demanded and to Box_i64 when
    # eager. The element's declaration wins wherever there is one.
    if (st.reg.isBoxOf tid: dt9) then {
        if (st.reg.genericArgCount specId: dt9) == 1 then {
            bx9: st.reg.genericArgAt specId: dt9 ordinal: 0
            if bx9 > 0 then {
                bxt9: ztypes.tid.create from: bx9.u64
                (forceMemberOf ty: st.typing reg: st.reg :ast parentTypeId: bxt9 nameId: opnId9)
                bxo9: st.typing.declChildOfId parentTypeId: bxt9 nameId: opnId9
                match (
                    bxo9
                ) case some then {
                    dt9 = bxt9
                    opo = optionval.some (bxo9)
                } case none then null
            }
        }
    }
    bmid9: ztypes.tid
    match (
        opo
    ) case some then {
        bmid9 = ztypes.tid.create from: opo.u64
    } case none then null
    stampBinopOp :st nid: binop.nodeid.u64 owner: dt9 method: bmid9
    match (
        opo
    ) case some then {
        oParamT9: ztypes.tid
        p0n9: (positionalParamName
            :ast
            :st
            funcId: (ztypes.tid.create from: opo.u64)
            idx: 0
            skipRecv: true
        )
        if p0n9.length > 0 then {
            ppo9: (st.typing.declChildOf
                pool: ast.names
                parentTypeId: (ztypes.tid.create from: opo.u64)
                name: p0n9.stringview
            )
            match (
                ppo9
            ) case some then {
                oParamT9 = ztypes.tid.create from: (ppo9)
            } case none then null
        }
        if oParamT9 > 0 when rt > 0 then {
            if (typesCompatible :ast :st :unitDecl a: rt b: oParamT9) == false then {
                skipA9: false
                strT9x: builtinTidTc :ast :st base: "String"
                svT9x: builtinTidTc :ast :st base: "StringView"
                rSty9: false
                if rt == strT9x then rSty9 = true
                if rt == svT9x then rSty9 = true
                pSty9: false
                if oParamT9 == strT9x then pSty9 = true
                if oParamT9 == svT9x then pSty9 = true
                if rSty9 when pSty9 then skipA9 = true
                ptt9: st.reg.typetypeOf typeId: oParamT9
                if ptt9 == ztypes.ztypetype.protocolType then skipA9 = true
                if ptt9 == ztypes.ztypetype.facetType then skipA9 = true
                if ptt9 == ztypes.ztypetype.genericParam then skipA9 = true
                if ptt9 == ztypes.ztypetype.functionType then skipA9 = true
                if (skipA9) == false then {
                    ea9: typeNameOf :st tid: (ztypes.tid.create from: oParamT9.u64)
                    aa9: typeNameOf :st tid: (ztypes.tid.create from: rt.u64)
                    # an unresolved got-side renders empty: suppress the
                    # knock-on when a prior error explains it, else name it
                    if aa9.length == 0 then {
                        if st.typing.errors.length > 0 then return (ztypes.tid.create from: 0)
                        aa9 = "an unresolved value".string
                    }
                    mma9: "argument type mismatch: expected \{ea9}, got \{aa9}"
                    (addError
                        :st
                        nodeid: binop.nodeid
                        lineno: binop.lineno
                        colno: binop.colno
                        e: zast.err.callError
                        msg: mma9
                    )
                    return (ztypes.tid.create from: 0)
                }
            }
        }
        if isCmp9 then {
            cb9: builtinTidTc :ast :st base: "bool"
            if cb9 > 0 then return cb9
            return (ztypes.tid.create from: lt)
        }
        if ltLit9 then return (ztypes.tid.create from: lt)
        oro: methodReturnOf :st mid: (ztypes.tid.create from: opo.u64)
        match (
            oro
        ) case some then {
            return oro
        } case none then null
        return (ztypes.tid.create from: lt)
    } case none then {
        if isCmp9 then {
            # `!=` derives from `==`: only error when `==` is also unavailable.
            if opn == "!=" then {
                (forceMemberOf ty: st.typing reg: st.reg :ast parentTypeId: dt9 nameId: zast.wkOpEq)
                eqEdge9: st.typing.declChildOfId parentTypeId: dt9 nameId: zast.wkOpEq
                if eqEdge9.some then {
                    boD9: builtinTidTc :ast :st base: "bool"
                    if boD9 > 0 then return boD9
                    return (ztypes.tid.create from: lt)
                }
            }
            # Ordering comparisons have no structural fallback: unlike `==` /
            # `!=` there is no structural ordering, so the operand type must
            # declare the operator (numerics declare all six). An undeclared
            # `<` / `>` / `<=` / `>=` -- on a resultval or any other aggregate --
            # is a hard error, not invalid C.
            isOrd9: false
            if opn == "<" then isOrd9 = true
            if opn == ">" then isOrd9 = true
            if opn == "<=" then isOrd9 = true
            if opn == ">=" then isOrd9 = true
            if isOrd9 then {
                lnOr9: typeNameOf :st tid: (ztypes.tid.create from: dt9.u64)
                mgOr9: "type '\{lnOr9}' has no '\{opn}' method"
                (addError
                    :st
                    nodeid: binop.nodeid
                    lineno: binop.lineno
                    colno: binop.colno
                    e: zast.err.typeError
                    msg: mgOr9
                )
                return (ztypes.tid.create from: 0)
            }
            # A concrete type that declares no comparison method -- a class or
            # union without `==`, or a record/variant that opted out with
            # `==: null` -- is a hard error rather than invalid C.
            if (memberStrictType :st bt: dt9) then {
                lnc9: typeNameOf :st tid: (ztypes.tid.create from: dt9.u64)
                mgc9: "type '\{lnc9}' has no '\{opn}' method"
                (addError
                    :st
                    nodeid: binop.nodeid
                    lineno: binop.lineno
                    colno: binop.colno
                    e: zast.err.typeError
                    msg: mgc9
                )
                return (ztypes.tid.create from: 0)
            }
            bo9: builtinTidTc :ast :st base: "bool"
            if bo9 > 0 then return bo9
            return (ztypes.tid.create from: lt)
        }
        # A concrete aggregate (record / class / union / variant, including a
        # generic mono like resultval) that declares no arithmetic operator is a
        # type error rather than invalid C. Type params, protocols, facets and
        # non-aggregates resolve elsewhere and keep the coercible lhs result.
        aTt9: st.reg.typetypeOf typeId: dt9
        aAgg9: false
        if aTt9 == ztypes.ztypetype.recordType then aAgg9 = true
        if aTt9 == ztypes.ztypetype.classType then aAgg9 = true
        if aTt9 == ztypes.ztypetype.unionType then aAgg9 = true
        if aTt9 == ztypes.ztypetype.variantType then aAgg9 = true
        if aAgg9 then {
            ln9: typeNameOf :st tid: (ztypes.tid.create from: dt9.u64)
            msg9: "type '\{ln9}' has no '\{opn}' method"
            (addError
                :st
                nodeid: binop.nodeid
                lineno: binop.lineno
                colno: binop.colno
                e: zast.err.typeError
                msg: msg9
            )
            return (ztypes.tid.create from: 0)
        }
        return (ztypes.tid.create from: lt)
    }
}

# checkBinop -- type a binary operator expression. Both operands are walked (so
# their nodes are stamped), then the operator resolves as a declared method on
# the operand type via checkBinopMethodDispatch (comparisons yield bool; an
# undeclared comparison falls back to structural equality).
checkBinop: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    binop: zast.BinOpData.view
} out ztypes.tid is {
    result: ztypes.tid
    # an operand that typed to nothing and raised nothing is an unresolvable
    # name: report it here, where the operand is consumed. Without it the 0
    # silently disables the dispatch's own checks and the emitter writes the
    # bare name into the C -- the same rule the argument and return legs follow.
    errL9: st.typing.errors.length
    lt: checkValue :st :unitDecl :ast node: (ast.nodes.get i: binop.lhs.u64)
    if lt.u64 == 0 when st.typing.errors.length == errL9 then {
        (reportUnresolvedValue
            :st
            :unitDecl
            :ast
            vnode: (ast.nodes.get i: binop.lhs.u64)
        )
    }
    errR9: st.typing.errors.length
    rt: checkValue :st :unitDecl :ast node: (ast.nodes.get i: binop.rhs.u64)
    if rt.u64 == 0 when st.typing.errors.length == errR9 then {
        (reportUnresolvedValue
            :st
            :unitDecl
            :ast
            vnode: (ast.nodes.get i: binop.rhs.u64)
        )
    }
    opn: atomName :ast n: (ast.nodes.get i: binop.operator.u64)
    opnId9: atomNameId :ast n: (ast.nodes.get i: binop.operator.u64)
    result = (checkBinopMethodDispatch
        :st
        :unitDecl
        :ast
        :binop
        opn: opn.stringview
        :opnId9
        :lt
        :rt
        isCmp9: (isComparisonOp name: opn.stringview)
    )
    tdb2: typedefBaseOf :ast :st :unitDecl tid: result
    if tdb2 > 0 then result = tdb2
    if result > 0 when (st.reg.typetypeOf typeId: result) == ztypes.ztypetype.genericParam then {
        # Structural pass-through: the SAME parameter on both sides flows
        # through arithmetic as itself (the per-instance clone checks remain
        # the arithmetic backstop); mixed operands stay untyped.
        if (result == rt) == false then return (ztypes.tid.create from: 0)
    }
    if result > 0 then stampGate :st nid: binop.nodeid.u64 tid: result
    return result
}

# argIsTrivial -- true when a call argument's operation is a hoisting no-op: a
# bare atom, a labelvalue, a string literal without interpolation, or an
# expression wrapping a bare atom / labelvalue. Anything else (binop, call,
# dotted path, interpolated string) hoists into a synth temp.
argIsTrivial: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case atomid then {
        return true
    } case labelvalue then {
        return true
    } case atomstring then {
        spiter: op.stringparts.iterate
        for spId9: spiter loop {
            sp: ast.nodes.get i: spId9.u64
            match (
                sp
            ) case stringchunk then null else {
                return false
            }
        }
        return true
    } case expression then {
        opx9: ast.nodes.get i: op.expression.u64
        match (
            opx9
        ) case atomid then {
            return true
        } case labelvalue then {
            return true
        } else {
            return false
        }
    } else {
        return false
    }
}

# hoistArg -- hoist a non-trivial call argument into a fresh `_tN` synth temp:
# define the temp (OWNED, synth origin anf) in the open CALL scope and record
# the synth Assignment / value-Expression / AtomId rows + their type stamps so
# the dump matches the reference's hoisted tree. The parsed argument keeps its
# own stamps; only the dump rows are synthesised (no AST mutation).
# typeIsReftype -- a registered type whose isValtype flag is explicitly false
# (classes, unions, protocols, heap natives like String). Unset or unregistered
# ids are not reftypes.
typeIsReftype: function {st: zenv.ZSymbolTable tid: ztypes.tid} out bool is {
    return (st.reg.isReftypeOf :tid)
}

# typeIsValtype -- a registered type whose isValtype flag is explicitly true
# (records, variants, facets, primitives). Unset or unregistered ids are not
# valtypes.
typeIsValtype: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry
    tid: ztypes.tid
} out bool is {
    ty
    return (reg.isValtypeOf :tid)
}

# innermostNodeId -- the node id of a value with its expression wrappers
# stripped (the node the dump's descent reads first); 0 for uncovered kinds.
innermostNodeId: function {ast: Ast.view n: Node.view} out zast.nodeid is {
    match (
        n
    ) case expression then {
        return (innermostNodeId :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        return (nodeId :n)
    }
}

# pathRootName -- the leftmost bare atom of a value path (`a.b.c` -> a,
# through expression wrappers), "" when the root is not a bare atom.
pathRootName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (pathRootName :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (pathRootName :ast n: (ast.nodes.get i: n.parent.u64))
    } case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# taggedRecvIsValue -- the dotted receiver denotes a VALUE (a variable at
# the path root, or a call result), not a type/unit reference.
taggedRecvIsValue: function {ast: Ast.view st: zenv.ZSymbolTable n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (taggedRecvIsValue :ast :st n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        return true
    } else {
        rn0: pathRootName :ast :n
        if rn0.length == 0 then return false
        rvo0: st.lookupVarId nameId: (nameIdOf :ast name: rn0.stringview)
        match (
            rvo0
        ) case some then {
            return true
        } case none then {
            return false
        }
    }
}

# bareAtomName -- the (expression-unwrapped) bare atom name of a value node,
# or "" when the value is any other shape.
# bareAtomNameId -- the interned name id of an expression-unwrapped bare atom,
# 0 for any other shape. The id twin of bareAtomName.
bareAtomNameId: function {ast: Ast.view n: Node.view} out zast.nameid is {
    match (
        n
    ) case expression then {
        return (bareAtomNameId :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return n.name
    } else {
        return (zast.nameid.create from: 0)
    }
}

bareAtomName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (bareAtomName :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# methodReceiverRoot -- the bare root name of a dotted callable's receiver
# (`a.compare` -> a), "" for non-dotted or non-bare receivers.
methodReceiverRoot: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case dottedpath then {
        return (bareAtomName :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# methodReceiverTuple -- the full dotted path of a method call's receiver
# (everything before the method name): `st.typing.decls.get` -> [st, typing,
# decls]. Empty when the callable is not a dotted path or the receiver
# is not a plain path. Path-scoped locks need the full tuple so sibling
# fields stay independent.
methodReceiverTuple: function {ast: Ast.view n: Node.view dst: (List String).view} is {
    match (
        n
    ) case dottedpath then {
        appendValueTuple :ast n: (ast.nodes.get i: n.parent.u64) :dst
    } else null
}

# dottedParentNodeId -- the nodeid of a dotted callable's receiver expression
# (its stamped type is the immediate receiver type); 0 otherwise.
dottedParentNodeId: function {ast: Ast.view n: Node.view} out zast.nodeid is {
    match (
        n
    ) case dottedpath then {
        return (nodeId n: (ast.nodes.get i: n.parent.u64))
    } else {
        return (zast.nodeid.create from: 0)
    }
}

# positionalParamName -- the funcId's parameter name at `idx` (declaration
# order), "" when absent. Positional call args map to it. With
# skipRecv, receiver rows (`this` or the fn's thisParamName) are excluded
# from the count: a dotted method call supplies the receiver implicitly, so
# its positional args map onto the remaining params.
positionalParamName: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    funcId: ztypes.tid
    idx: u64
    skipRecv: bool
} out String is {
    result: String
    found: false
    seen: u64
    ppN9: (ListVal u64)
    ppT9: (ListVal u64)
    st.typing.declChildRows ownerTid: funcId names: ppN9 tids: ppT9
    ppi9: u64
    ppn9: ppN9.length
    for ppi9 < ppn9 loop {
        ppnid9: ppN9.get i: ppi9
        ppi9 = ppi9 + 1
        if (found) == false then {
            tnB9: ast.names.texts.get i: ppnid9.u64
            isRecv9: false
            if skipRecv then {
                if tnB9.stringview == "this" then isRecv9 = true
                if (st.reg.thisParamNameIs
                    tid: funcId
                    nameId: (zast.nameid.create from: ppnid9.u32.orPanic)
                ) then isRecv9 = true
            }
            if (isRecv9) == false then {
                if seen == idx then {
                    result = tnB9.copy
                    found = true
                }
                seen = seen + 1
            }
        }
    }
    return result
}

# lockCallArg -- the call-scoped EXCLUSIVE lock a lock/borrow parameter takes
# on its argument's root for the call's duration (the symtab appends the lock
# overlay entry in the open call scope; it vanishes when the scope pops).
markVarMutatedName: function {st: zenv.ZSymbolTable ast: Ast.view name: StringView} is {
    if name.length == 0 then return
    vo9: st.lookupVarId nameId: (nameIdOf :ast :name)
    match (
        vo9
    ) case some then {
        mk9: vo9
        st.typing.variableMutated.set key: mk9 value: true
    } case none then null
}

lockCallArg: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    pool: zast.StringPool.view
    name: StringView
    callId: u64
    shared: bool
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    # a NON-shared lock is a mutable use: the callee may write through it
    if (shared) == false then markVarMutatedName :st :ast :name
    pth: (List String)
    nm: name.string
    pth.append nm
    h: (ztypes.zlockholder kind: ztypes.zlockholderkind.callKind id: callId)
    clk9: ztypes.zlockstate.exclusive
    if shared then clk9 = ztypes.zlockstate.shared
    r: (st.tryLock
        :pool
        path: pth
        lockType: clk9
        lockScope: ztypes.zlockscope.target
        holder: h
    )
    if r.length > 0 then addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: r
}

# lockCallPath -- call-scoped path lock over a full receiver tuple: SHARED
# on the strict prefixes, reader/writer kind on the leaf. The prefixes are
# intent locks, so they never block the leaf they were taken for.
lockCallPath: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    pool: zast.StringPool.view
    path: (List String).view
    callId: u64
    shared: bool
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    n: path.length
    if n == 0 then return
    if (shared) == false then {
        # a NESTED receiver (`st.reg.foo`) locks its path exclusively, which is a
        # mutable use of the ROOT. The third and last lock-taking entry point,
        # beside lockCallArg (bare names) and installBorrowLocks (path args).
        {
            lcp9: (path.get i: 0)
            markVarMutatedName :st :ast name: lcp9.stringview
        }
        (checkFrozenWrite
            :st
            :ast
            :path
            verb: "mutate through"
            upTo: path.length
            :nodeid
            :lineno
            :colno
        )
    }
    end: 1.u64
    for end < n loop {
        sub: (List String)
        i: u64
        for i < end loop {
            e: path.get :i
            ec: e.copy
            sub.append ec
            i = i + 1
        }
        hs: (ztypes.zlockholder kind: ztypes.zlockholderkind.callKind id: callId)
        rs: (st.tryLock
            :pool
            path: sub
            lockType: ztypes.zlockstate.shared
            lockScope: ztypes.zlockscope.intent
            holder: hs
        )
        if rs.length > 0 then addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: rs
        end = end + 1
    }
    full: (List String)
    j: u64
    for j < n loop {
        e2: path.get i: j
        ec2: e2.copy
        full.append ec2
        j = j + 1
    }
    he: (ztypes.zlockholder kind: ztypes.zlockholderkind.callKind id: callId)
    clk9: ztypes.zlockstate.exclusive
    if shared then clk9 = ztypes.zlockstate.shared
    re: (st.tryLock
        :pool
        path: full
        lockType: clk9
        lockScope: ztypes.zlockscope.target
        holder: he
    )
    if re.length > 0 then addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: re
}

# lockSuffixBase -- the bare base name of a `<atom>.lock` argument, ""
# otherwise.
lockSuffixBase: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (lockSuffixBase :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        ln: atomName :ast n: (ast.nodes.get i: n.child.u64)
        if ln.stringview == "lock" then {
            return (bareAtomName :ast n: (ast.nodes.get i: n.parent.u64))
        } else {
            return "".string
        }
    } else {
        return "".string
    }
}

# takenHere -- the location stamp an ownership-transfer overlay carries (pop
# propagates only located takes into the enclosing scope).
takenHere: function {} out optionval ztypes.zsrcpos is {
    return (optionval.some (ztypes.zsrcpos fsno: zvfs.fsno lineno: 0 colno: 0))
}

# consumeBareArgOwnership -- a bare-name reftype value at an OWNING slot (a
# take parameter, a constructor field, a tagged-arm payload): refuse a
# readonly / pinned / borrowed source, else transfer ownership out of it.
consumeBareArgOwnership: function {
    st: zenv.ZSymbolTable
    ast: Ast
    name: StringView
    vid: ztypes.vid
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    # Readonly first, then ownership: ANY borrowed binding refuses the move
    # (the view-family test predates element borrows).
    if (nameIsReadonly :st :ast :name) then {
        (readonlyMoveError
            :st
            :nodeid
            :lineno
            :colno
            :name
            verb: "into a taking argument"
        )
    } else {
        apin7: (pinnedMoveError
            :st
            :ast
            :nodeid
            :lineno
            :colno
            :name
            verb: "into a taking argument"
        )
        if apin7 then null else if (isBorrowedVar :st :vid) then {
            bnc7: name
            mb7: "Cannot move borrowed variable '\{bnc7}' into a taking argument — borrowed names stay bound to their source for the full scope; copy with '.copy' to keep the source"
            (addError
                :st
                :nodeid
                :lineno
                :colno
                e: zast.err.ownerError
                msg: mb7
            )
        } else {
            (st.invalidate
                nameId: (nameIdOf :ast :name)
                loc: takenHere
            )
        }
    }
}

# appendValueTuple -- the source path of a value node (root first), appended onto
# dst. Ownership and access markers are not addressable segments, so
# `rec.field.borrow` contributes (rec, field); non-path shapes contribute nothing.
appendValueTuple: function {ast: Ast.view n: Node.view dst: List String} is {
    match (
        n
    ) case expression then {
        appendValueTuple :ast n: (ast.nodes.get i: n.expression.u64) :dst
    } case atomid then {
        nm: zast.nameTextCopy :ast ref: n.name
        dst.append nm
    } case dottedpath then {
        appendValueTuple :ast n: (ast.nodes.get i: n.parent.u64) :dst
        cn: atomName :ast n: (ast.nodes.get i: n.child.u64)
        if cn.length > 0 when (isStripMarker name: cn.stringview) == false then dst.append cn
    } else null
}

# drainPendingBorrow / takePendingBorrow -- clear the borrow side-channel /
# move it into a local list (root-first order preserved).
drainPendingBorrow: function {st: zenv.ZSymbolTable} is {
    for st.typing.pendingBorrowPath.length > 0 loop st.typing.pendingBorrowPath.pop
    st.typing.pendingBorrowShared = false
    st.typing.pendingBorrowReadonly = false
    st.typing.pendingBorrowOwned = false
}

# drain the pending-borrow markers accumulated during argument hoisting.
takePendingBorrow: function {st: zenv.ZSymbolTable dst: List String} is {
    n: st.typing.pendingBorrowPath.length
    i: u64
    for i < n loop {
        e: st.typing.pendingBorrowPath.get :i
        ec: e.copy
        dst.append ec
        i = i + 1
    }
    sh9: st.typing.pendingBorrowShared
    ro9: st.typing.pendingBorrowReadonly
    ow9: st.typing.pendingBorrowOwned
    drainPendingBorrow :st
    st.typing.pendingBorrowShared = sh9
    st.typing.pendingBorrowReadonly = ro9
    st.typing.pendingBorrowOwned = ow9
}

# installBorrowLocks -- SHARED on every path prefix, EXCLUSIVE on the leaf
# (the symtab appends one lock overlay entry per acquisition, keyed by the
# path root -- the oracle's non-definition rows). Holder = the binding var.
installBorrowLocks: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    pool: zast.StringPool.view
    src: (List String).view
    vid: ztypes.vid
    leafShared: bool
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    n: src.length
    if n == 0 then return
    # an EXCLUSIVE leaf is a mutable use of the path's ROOT. This is the other
    # enforcement point beside lockCallArg: a PATH-shaped argument
    # (`pool: program.ast.names`) never reaches lockCallArg, it installs here.
    if (leafShared) == false then {
        ibr9: (src.get i: 0)
        markVarMutatedName :st :ast name: ibr9.stringview
    }
    end: 1.u64
    for end < n loop {
        sub: (List String)
        i: u64
        for i < end loop {
            e: src.get :i
            ec: e.copy
            sub.append ec
            i = i + 1
        }
        hs: (ztypes.zlockholder kind: ztypes.zlockholderkind.varKind id: vid)
        rs: (st.tryLock
            :pool
            path: sub
            lockType: ztypes.zlockstate.shared
            lockScope: ztypes.zlockscope.intent
            holder: hs
        )
        if rs.length > 0 then addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: rs
        end = end + 1
    }
    full: (List String)
    j: u64
    for j < n loop {
        e2: src.get i: j
        ec2: e2.copy
        full.append ec2
        j = j + 1
    }
    he: (ztypes.zlockholder kind: ztypes.zlockholderkind.varKind id: vid)
    lk9: ztypes.zlockstate.exclusive
    if leafShared then lk9 = ztypes.zlockstate.shared
    re: (st.tryLock
        :pool
        path: full
        lockType: lk9
        lockScope: ztypes.zlockscope.target
        holder: he
    )
    if re.length > 0 then addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: re
}

# frozenFieldInPath -- the first segment of a path, up to `upTo`, declared
# `view` or `hold`, or "". The contents of such a field are readonly for the
# instance's whole life; the slot rule (static or not) is the other axis and is
# decided at the declaration. Walks segment by segment, since the frozen field
# may be nested (`b.inner.name`).
#
# `upTo` is what separates writing THROUGH a frozen field from writing the
# field itself: an assignment passes the strict prefix, because assigning the
# slot is the slot rule's business, while a mutating call passes the whole path
# -- there the leaf IS the receiver being mutated.
frozenFieldInPath: function {
    st: zenv.ZSymbolTable
    ast: Ast
    path: (List String).view
    upTo: u64
} out String is {
    n9: upTo
    if n9 > path.length then n9 = path.length
    if n9 < 2 then return "".string
    r9: path.get i: 0
    cur9: u64
    {
        ro9: st.lookup nameId: (nameIdOf :ast name: r9.stringview)
        match (
            ro9
        ) case some then {
            cur9 = ro9
        } case none then {
            return "".string
        }
    }
    i9: 1.u64
    for i9 < n9 loop {
        seg9: path.get i: i9
        oo9: (st.typing.declOwnershipOfId
            parentTypeId: (ztypes.tid.create from: cur9.u64)
            nameId: (zast.poolFind pool: ast.names text: seg9.stringview)
        )
        match (
            oo9
        ) case some then {
            if oo9 == ztypes.zparamownership.viewMode then return seg9.copy
            if oo9 == ztypes.zparamownership.holdMode then return seg9.copy
        } case none then null
        co9: (st.typing.declChildOf
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: cur9.u64)
            name: seg9.stringview
        )
        match (
            co9
        ) case some then {
            cur9 = co9
        } case none then {
            return "".string
        }
        i9 = i9 + 1
    }
    return "".string
}

# pathLeafIsMethod -- the last segment of a path names a METHOD rather than a
# field. A call's result ownership is its signature's business -- `.copy` and
# every owned return are fresh values -- so the deep-readonly rule, which is
# about reading a reftype field out of a readonly path, must not claim them.
pathLeafIsMethod: function {st: zenv.ZSymbolTable ast: Ast path: (List String).view} out bool is {
    n9: path.length
    if n9 < 2 then return false
    r9: path.get i: 0
    cur9: u64
    {
        ro9: st.lookup nameId: (nameIdOf :ast name: r9.stringview)
        match (
            ro9
        ) case some then {
            cur9 = ro9
        } case none then {
            return false
        }
    }
    last9: n9 - 1
    i9: 1.u64
    for i9 < n9 loop {
        seg9: path.get i: i9
        co9: (st.typing.declChildOf
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: cur9.u64)
            name: seg9.stringview
        )
        match (
            co9
        ) case some then {
            if i9 == last9 then {
                tt9: st.reg.typetypeOf typeId: (ztypes.tid.create from: co9.u64)
                if tt9 == ztypes.ztypetype.functionType then return true
                return false
            }
            cur9 = co9
        } case none then {
            return false
        }
        i9 = i9 + 1
    }
    return false
}

# pathIsReadonly -- true when a value path may only be read: it passes through
# a `view`/`hold` field, or its root binding holds a readonly lock on itself (a
# `view` parameter, a `hold` binding). Readonly is deep, so a binding taken
# from such a path is readonly in turn -- otherwise the intermediate name
# launders the restriction away.
pathIsReadonly: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    path: (List String).view
} out bool is {
    if path.length == 0 then return false
    ff9: frozenFieldInPath :st :ast :path upTo: path.length
    if ff9.length > 0 then return true
    r9: path.get i: 0
    rv9: st.lookupVarId nameId: (nameIdOf :ast name: r9.stringview)
    if rv9.none then return false
    lk9: st.findLock nameId: (nameIdOf :ast name: r9.stringview)
    if lk9.none then return false
    if lk9 != ztypes.zlockstate.shared then return false
    lh9: st.findLockHolder nameId: (nameIdOf :ast name: r9.stringview)
    if lh9.none then return false
    if lh9.kind != ztypes.zlockholderkind.varKind then return false
    return lh9.id == rv9
}

# readonlySelfLock -- make `name` a readonly binding: it holds a shared lock on
# ITSELF, which is how a `view` parameter, a `hold` local, a marked match-arm
# payload and an `out T.view` result all say the same thing. Returns the
# conflict message, or "" when the lock was taken.
readonlySelfLock: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    name: StringView
    vid: ztypes.vid
} out String is {
    if name.length == 0 then return "".string
    if vid.isZero then return "".string
    rsp9: (List String)
    rsn9: name.string
    rsp9.append rsn9
    rsh9: (ztypes.zlockholder
        kind: ztypes.zlockholderkind.varKind
        id: vid
    )
    return (st.tryLock
        pool: ast.names
        path: rsp9
        lockType: ztypes.zlockstate.shared
        lockScope: ztypes.zlockscope.target
        holder: rsh9
    )
}

# iterElementIsReadonly -- ask an iterator BINDING what strength of lock it
# holds on the container it walks. A `view` iterator receiver pins SHARED, so
# the elements it hands out may only be read; an exclusive pin yields writable
# ones. Unlike pathIsReadonly this is not a self-lock question -- the holder is
# the iterator and the locked path is the container it recorded as its borrow
# origin.
iterElementIsReadonly: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    iterName: StringView
} out bool is {
    if iterName.length == 0 then return false
    ivo9: st.lookupVarId nameId: (nameIdOf :ast name: iterName)
    if ivo9.none then return false
    # the container name, copied OUT of the map view: the view holds a shared
    # lock on st for its scope, and the lock queries below want st exclusively.
    ocn9: String
    {
        oro9: st.typing.variableBorrowOrigin.get key: ivo9
        match (
            oro9
        ) case some then {
            ocn9 = oro9.copy
        } case none then null
    }
    if ocn9.length == 0 then return false
    cnd9: nameIdOf :ast name: ocn9.stringview
    clk9: st.findLock nameId: (zast.nameid.create from: cnd9.u32)
    if clk9.none then return false
    if clk9 != ztypes.zlockstate.shared then return false
    clh9: st.findLockHolder nameId: (zast.nameid.create from: cnd9.u32)
    if clh9.none then return false
    if clh9.kind != ztypes.zlockholderkind.varKind then return false
    return clh9.id == ivo9
}

# nameIsReadonly -- the one-segment form of pathIsReadonly. A `view` parameter,
# a `hold` binding and a payload narrowed from either each hold a readonly lock
# on their own name, so this answers "may this binding only be read?".
nameIsReadonly: function {st: zenv.ZSymbolTable.view ast: Ast.view name: StringView} out bool is {
    if name.length == 0 then return false
    rop9: (List String)
    ron9: name.string
    rop9.append ron9
    return (pathIsReadonly :st :ast path: rop9)
}

# armPayloadReadonly -- a narrowed match-arm payload takes the readonly
# self-lock when its ARM is declared `view` or `hold`. The payload binds under
# the subject's own name, so the lock lands on that name for the arm's scope
# and every readonly rule -- writes, mutating receivers, moves -- follows from
# it. A readonly SUBJECT needs nothing here: the shadow reuses the name, so its
# lock is still the innermost one found.
armPayloadReadonly: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    subject: StringView
    parentTid: u64
    armName: StringView
    payloadTid: ztypes.tid
} is {
    if subject.length == 0 then return
    if parentTid == 0 then return
    if payloadTid.isZero then return
    if (typeIsReftype :st tid: (ztypes.tid.create from: payloadTid.u64)) == false then return
    ao9: (st.typing.declOwnershipOfId
        parentTypeId: (ztypes.tid.create from: parentTid.u64)
        nameId: (nameIdOf :ast name: armName)
    )
    apr9: false
    match (
        ao9
    ) case some then {
        if ao9 == ztypes.zparamownership.viewMode then apr9 = true
        if ao9 == ztypes.zparamownership.holdMode then apr9 = true
    } case none then null
    if (apr9) == false then return
    svo9: st.lookupVarId nameId: (nameIdOf :ast name: subject)
    if svo9.none then return
    spa9: (List String)
    snm9: subject.string
    spa9.append snm9
    sho9: (ztypes.zlockholder
        kind: ztypes.zlockholderkind.varKind
        id: svo9
    )
    slr9: (st.tryLock
        pool: ast.names
        path: spa9
        lockType: ztypes.zlockstate.shared
        lockScope: ztypes.zlockscope.target
        holder: sho9
    )
    if slr9.length > 0 then return
}

# pinnedMoveError -- a move out of a binding ANOTHER holder has locked is
# refused: the holder reads or writes through that value, and a move frees it
# out from under them (a StringView over a moved String reads freed memory).
# `.release` has refused this for a while; the move sites never asked. Reports
# and returns true when it fires, so the caller skips its remaining legs.
pinnedMoveError: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    name: StringView
    verb: StringView
} out bool is {
    if name.length == 0 then return false
    pnid9: nameIdOf :ast :name
    pvo9: st.lookupVarId nameId: (zast.nameid.create from: pnid9.u32)
    if pvo9.none then return false
    plk9: st.findLock nameId: (zast.nameid.create from: pnid9.u32)
    if plk9.none then return false
    plh9: st.findLockHolder nameId: (zast.nameid.create from: pnid9.u32)
    if plh9.none then return false
    # A holder that is the binding itself is the readonly case, which
    # readonlyMoveError words better; a call-scoped holder belongs to the
    # statement being checked, not to a live reader.
    if plh9.kind != ztypes.zlockholderkind.varKind then return false
    if plh9.id == pvo9 then return false
    phn9: st.formatLockHolder pool: ast.names holder: plh9
    plsn9: zenv.zlockstateNameLower t: plk9
    pnm9: name
    pvb9: verb
    pm9: "Cannot move '\{pnm9}' \{pvb9}: \{plsn9} lock held by '\{phn9}'"
    pht9: "'\{phn9}' reads '\{pnm9}' -- moving it would leave '\{phn9}' pointing at freed memory; end its scope first, or copy with '.copy'"
    pen9: String
    (addErrorH
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.ownerError
        msg: pm9
        note: pen9
        hint: pht9
        width: name.length.u32.orPanic
    )
    return true
}

# readonlyMoveError -- a move whose SOURCE may only be read is refused:
# capability may only be given up, so `hold`/`view` never become an owned
# mutable value. `verb` names the move form ("with '.take'", "by
# reassignment", ...).
readonlyMoveError: function {
    st: zenv.ZSymbolTable.view
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    name: StringView
    verb: StringView
} is {
    rmn9: name
    rmv9: verb
    rmm9: "Cannot move readonly variable '\{rmn9}' \{rmv9} — a readonly binding may only be read; copy with '.copy' to keep the source"
    (addError
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.ownerError
        msg: rmm9
    )
}

# checkFrozenWrite -- reject a mutation reaching through a readonly field.
checkFrozenWrite: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    path: (List String).view
    verb: StringView
    upTo: u64
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    ff9: frozenFieldInPath :st :ast :path :upTo
    if ff9.length == 0 then return
    pp9: zenv.formatPath :path
    mf9: "Cannot \{verb} '\{pp9}': field '\{ff9}' is readonly"
    (addError
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.ownerError
        msg: mf9
    )
}

# checkWriteLock -- a write is rejected while an EXCLUSIVE lock overlapping its
# target path is outstanding: the holder reaches through that path, so the write
# would invalidate what it points at. Sibling paths do not overlap, so a lock on
# one field leaves the others writable.
checkWriteLock: function {st: zenv.ZSymbolTable ast: Ast.view n: Node.view verb: StringView} is {
    wp9: (List String)
    appendValueTuple :ast :n dst: wp9
    if wp9.length == 0 then return
    {
        wrt9: (wp9.get i: 0)
        markVarMutatedName :st :ast name: wrt9.stringview
    }
    # hoisted: the length read locks wp9 for its duration, and wp9 is already
    # an argument to the same call -- one appearance per call.
    wpn9: wp9.length
    (checkFrozenWrite
        :st
        :ast
        path: wp9
        :verb
        upTo: wpn9 - 1
        nodeid: (nodeId :n)
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
    )
    wr9: (wp9.get i: 0)
    wv9: st.lookupVarId nameId: (nameIdOf :ast name: wr9.stringview)
    if wv9.none then return
    pp9: zenv.formatPath path: wp9
    wh9: st.findExclusiveLock pool: ast.names path: wp9
    if (wh9.none) == false then {
        hn9: st.formatLockHolder pool: ast.names holder: wh9
        mw9: "Cannot \{verb} '\{pp9}': exclusive lock held by '\{hn9}'"
        wht9: String
        if wh9.kind == ztypes.zlockholderkind.varKind then {
            wht9 = "write through '\{hn9}' instead, or end '\{hn9}'s scope first to release the lock"
        }
        wen9: String
        (addErrorH
            :st
            nodeid: (nodeId :n)
            lineno: (nodeLine :n)
            colno: (nodeCol :n)
            e: zast.err.ownerError
            msg: mw9
            note: wen9
            hint: wht9
            width: wr9.length.u32.orPanic
        )
        return
    }
    rh9: st.findReadBlocker pool: ast.names path: wp9
    if rh9.none then return
    rn9: st.formatLockHolder pool: ast.names holder: rh9
    ppc9: pp9
    selfRo9: rn9.stringview == wr9.stringview
    mr9: "Cannot \{verb} '\{ppc9}': shared lock held by '\{rn9}'"
    if selfRo9 then mr9 = "Cannot \{verb} '\{ppc9}': '\{wr9}' is readonly here"
    rht9: String
    if rh9.kind == ztypes.zlockholderkind.varKind when (selfRo9) == false then {
        rht9 = "'\{rn9}' reads this path -- writing it would invalidate what '\{rn9}' points at; end its scope first"
    }
    if selfRo9 then {
        # `view` is not owned, `hold` is -- the self-lock is the same, so the
        # binding's ownership is what tells them apart for the hint.
        rmk9: "hold".string
        if (isBorrowedVar :st vid: wv9) then rmk9 = "view".string
        rht9 = "a `\{rmk9}` binding is readonly for its whole scope; take a `.copy` to get a mutable value"
    }

    ren9: String
    (addErrorH
        :st
        nodeid: (nodeId :n)
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.ownerError
        msg: mr9
        note: ren9
        hint: rht9
        width: wr9.length.u32.orPanic
    )
}

# isLiteralTypeId -- a literal-typed value: one of the registry's two reserved
# literal rows. Bare numeric literals and data-block elements wear them.
isLiteralTypeId: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    if tid == st.reg.literalIntTid then return true
    return tid == st.reg.literalFloatTid
}

# hoist a call argument into a temporary, recording its ownership.
hoistArg: function {ast: Ast
    st: zenv.ZSymbolTable
    argNode: Node.view
    argType: ztypes.tid
    paramType: u64
    consumes: bool
    viewParam: bool
} out String is {
    tn: st.typing.nextTempId
    st.typing.nextTempId = tn + 1
    tname: "_t\{tn}"
    ln: nodeLine n: argNode
    co: nodeCol n: argNode
    assignId: zast.tableReserve :ast
    exprId: zast.tableReserve :ast
    atomId: zast.tableReserve :ast
    st.typing.synthNodes.append (ztyping.SynthNode
        nodeid: assignId
        kind: "Assignment".string
        label: st.typing.synthLabel.copy
        lineno: ln
        colno: co)
    st.typing.synthNodes.append (ztyping.SynthNode
        nodeid: exprId
        kind: "Expression".string
        label: st.typing.synthLabel.copy
        lineno: ln
        colno: co)
    st.typing.synthNodes.append (ztyping.SynthNode
        nodeid: atomId
        kind: "AtomId".string
        label: st.typing.synthLabel.copy
        lineno: ln
        colno: co)
    seta: argType
    stampGate :st nid: assignId.u64 tid: (ztypes.tid.create from: seta.u64)
    sete: argType
    stampGate :st nid: exprId.u64 tid: (ztypes.tid.create from: sete.u64)
    atomT: argType
    if paramType > 0 then atomT = ztypes.tid.create from: paramType.u64
    setm: atomT
    stampGate :st nid: atomId.u64 tid: (ztypes.tid.create from: setm.u64)
    hbsrc: (List String)
    takePendingBorrow :st dst: hbsrc
    # A borrow path whose LEAF is a method describes a CALL, and a call's
    # result ownership is its signature's business: `.copy` hands back a fresh
    # value, so the temp OWNS it and locking `x.copy` as though it were a field
    # read freezes the source for nothing -- which is what made `.copy`, the
    # escape hatch every readonly diagnostic recommends, fail as an argument.
    # c0b482b applied this rule to bindings; the argument path had its own copy.
    if (pathLeafIsMethod :st :ast path: hbsrc) then {
        for hbsrc.length > 0 loop hbsrc.pop
    }
    hown: ztypes.zownership.owned
    if hbsrc.length > 0 when (typeIsReftype
        :st
        tid: (ztypes.tid.create from: argType.u64)
    ) then hown = ztypes.zownership.borrowed
    v: st.reg.newVariable ztypeId: argType ownership: hown
    v.synthOrigin = (Option.some "anf".string)
    if hown == ztypes.zownership.borrowed then {
        hr0: hbsrc.get i: 0
        hbo: hr0.copy
        v.borrowOrigin = (Option.some hbo)
    }
    vid: v.variableId
    tnId9: zast.poolSet pool: ast.names text: tname.stringview
    st.defineVar nameId: tnId9 var: v
    # the hoisted temp is the user-written hoist made explicit: it borrows
    # its source path for the call scope (SHARED prefixes, leaf kind from
    # the side channel), so aliasing between arguments -- or with a live
    # view of the source -- conflicts exactly as the call-scoped locking
    # algorithm in ownership.pdoc requires
    # install only when the consumed side-channel path belongs to THIS
    # argument (its root atom): a stale residue from receiver evaluation
    # must stay drained-without-locks, or it would double the call's own
    # receiver locks under a temp holder
    if hown == ztypes.zownership.borrowed then {
        hrt9: rootNameOf :ast n: argNode
        okInstall9: false
        if hrt9.length > 0 when hbsrc.length > 0 then {
            h0c9: (hbsrc.get i: 0)
            if h0c9.stringview == hrt9.stringview then okInstall9 = true
        }
        if okInstall9 then {
            # A `.view` parameter only reads its argument, so the hoisted temp
            # locks the source SHARED -- exactly as the bare-name leg already
            # did via `isViewArg`. Without this a PATH-shaped argument
            # (`f xs: h.items`) took an exclusive lock and was refused off any
            # readonly holder, while the identical value hoisted to a local by
            # hand was accepted.
            hlfs9: viewParam
            if st.typing.pendingBorrowShared then hlfs9 = true
            (installBorrowLocks
                :st
                :ast
                pool: ast.names
                src: hbsrc
                :vid
                leafShared: hlfs9
                nodeid: (nodeId n: argNode)
                lineno: (nodeLine n: argNode)
                colno: (nodeCol n: argNode)
            )
        }
    }
    st.typing.defVariableId.set key: assignId.u64 value: vid
    if consumes then (st.invalidate
        nameId: (nameIdOf :ast name: tname.stringview)
        loc: (optionval.none ztypes.zsrcpos)
    )
    return tname
}

# dataFieldNames -- a type's user-supplied data fields/params in order: for a
# FUNCTION, all params; for a record/class, fnptr fields plus non-FUNCTION
# fields, excluding as-block constants (asConstClone) and conformance markers.
# The emitter's recFieldLists is this function, so a record's C struct and its
# checked field list cannot drift apart.
dataFieldNames: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    tid: ztypes.tid
    names: List String
    ids: ListVal u64
    nameIds: ListVal u64
} is {
    isFn: false
    if (st.reg.typetypeOf typeId: tid) == ztypes.ztypetype.functionType then isFn = true
    # this type's conformance-marker labels, collected once (the per-field
    # probe below is a scan over these few names, not the whole table)
    mkNames8: (List String)
    if isFn == false then {
        with cfit8: st.typing.conformance.iterate do for crow8: cfit8 loop {
            if crow8.implTypeId == tid then mkNames8.append crow8.label.copy
        }
    }
    # collect the rows first: the fnptr probe below resolves a member
    # declaration, which locks the whole ZTyping this iteration is holding
    rowNids9: (ListVal u64)
    rowCtos9: (ListVal u64)
    st.typing.declMemberList ownerTid: tid names: rowNids9 tids: rowCtos9
    {
        {
            ri9: u64
            for ri9 < rowNids9.length loop {
                tcNameId9: rowNids9.get i: ri9
                cto: rowCtos9.get i: ri9
                ri9 = ri9 + 1
                inc: false
            if isFn then {
                inc = true
            } else {
                fptr: false
                fptr = (st.typing.declIsFnptrFieldId
                    parentTypeId: tid
                    nameId: (zast.nameid.create from: tcNameId9.u32.orPanic)
                )
                if fptr then {
                    inc = true
                } else {
                    if cto > 0 when (st.reg.typetypeOf typeId: (ztypes.tid.create from: cto.u64)) != ztypes.ztypetype.functionType then {
                        isC: false
                        aco: st.typing.asConstClone.get key: cto
                        match (
                            aco
                        ) case some then {
                            isC = aco
                        } case none then null
                        isMk8: false
                        mi8: u64
                        cnBm8: ast.names.texts.get i: tcNameId9.u64
                        mn8: mkNames8.length
                        for mi8 < mn8 loop {
                            mv8: mkNames8.get i: mi8
                            if mv8.stringview == cnBm8.stringview then isMk8 = true
                            mi8 = mi8 + 1
                        }
                        if isC == false when isMk8 == false then inc = true
                    }
                }
            }
            if inc then {
                cnBx9: ast.names.texts.get i: tcNameId9.u64
                cnx: cnBx9.copy
                names.append cnx
                idx0: cto
                ids.append idx0
                nid0: tcNameId9
                nameIds.append nid0
            }
            }
        }
    }
}

# missingCtorFields -- collect each required field/param (no default) of
# `funcId` that the provided labels / positional count do not cover, into
# missingNames/missingIds. The method receiver is implicitly bound; a
# construction's body-carrying FUNCTION-typed (fnptr) fields are auto-bound;
# native types have no required fields.
missingCtorFields: function {
    ast: Ast
    st: zenv.ZSymbolTable
    funcId: ztypes.tid
    isCtor: bool
    provided: (List String).view
    posCount: u64
    missingNames: List String
    missingIds: ListVal u64
} is {
    fzNat9: false
    {
        isNative9v: st.reg.isNativeOf tid: funcId
            if isNative9v then fzNat9 = true
    }
    if fzNat9 then return
    effId: funcId
    if isCtor then {
        (forceMemberOf ty: st.typing reg: st.reg :ast parentTypeId: funcId nameId: zast.wkCreate)
        crId: (optU64Or
            o: (st.typing.declChildOfId parentTypeId: funcId nameId: zast.wkCreate)
            d: 0
        )
        if crId > 0 when (st.reg.typetypeOf typeId: (ztypes.tid.create from: crId.u64)) == ztypes.ztypetype.functionType then {
            crBody9: false
            crn9: st.typing.funcReturnNode.get key: crId
            match (
                crn9
            ) case some then {
                crBody9 = true
            } case none then null
            if crBody9 then effId = ztypes.tid.create from: crId.u64
        }
    }
    names: (List String)
    ids: (ListVal u64)
    idsNm: (ListVal u64)
    # a WALK consumer: an is-block `function {..} out T` with no body is an
    # fn-ptr FIELD, and an unresolved member carries no type, so it is
    # invisible here rather than reported missing
    forceAllMembers ty: st.typing reg: st.reg :ast tid: effId
    dataFieldNames :ast :st tid: effId :names :ids nameIds: idsNm
    pcnt: names.length
    if pcnt == 0 then return
    thisPn9: String
    thisPn9 = zast.poolTextCopy pool: ast.names ref: (st.reg.thisParamNameIdOf tid: effId)
    vpos: u64
    i: u64
    for i < pcnt loop {
        pname: names.get :i
        pcid: ids.get :i
        pnameId: idsNm.get :i
        i = i + 1
        isRecv9: false
        if pnameId == zast.wkThis.u64 then isRecv9 = true
        if thisPn9.length > 0 when thisPn9.stringview == pname.stringview then isRecv9 = true
        if (isRecv9) == false then {
            posI: vpos
            vpos = vpos + 1
            need: true
            if isCtor when (st.reg.typetypeOf typeId: (ztypes.tid.create from: pcid.u64)) == ztypes.ztypetype.functionType then {
                # only a body-carrying fn type defaults the field (a bodyless
                # SPEC field requires the reference); record and class
                # constructions fill the omitted slot with the field type's
                # symbol (the fnptr-field fill in the emitter's create path)
                fhbOk9: optBoolOr o: (st.typing.fnHasBody.get key: pcid) d: false
                effTT9: st.reg.typetypeOf typeId: effId
                ctorFill9: false
                if effTT9 == ztypes.ztypetype.recordType then ctorFill9 = true
                if effTT9 == ztypes.ztypetype.classType then ctorFill9 = true
                if fhbOk9 when ctorFill9 then need = false
            }
            if (st.typing.declHasDefaultId
                parentTypeId: effId
                nameId: (zast.nameid.create from: pnameId.u32.orPanic)
            ) then need = false
            if need then {
                prov: false
                if posI < posCount then prov = true
                with piter: provided.iterate do for pv: piter loop {
                    if pv.stringview == pname.stringview then prov = true
                }
                if (prov) == false then {
                    missingNames.append pname.copy
                    missingIds.append pcid
                }
            }
        }
    }
}

# checkMissingCallArgs -- report each required field/param (no default) a call or
# construction did not provide, via missingCtorFields over the call's labeled
# and positional arguments.
checkMissingCallArgs: function {ast: Ast.view
    st: zenv.ZSymbolTable.view
    call: zast.CallData.view
    funcId: ztypes.tid
    isCtor: bool
} is {
    mcb0: metaCreateBaseId :ast n: (ast.nodes.get i: call.callable.u64)
    match (
        mcb0
    ) case some then {
        return
    } case none then null
    posCount: u64
    provided: (List String)
    with aiter: call.arguments.iterate do for argId9: aiter loop {
        arg: ast.nodes.get i: argId9.u64
        match (
            arg
        ) case namedoperation then {
            an: zast.nameTextCopy :ast ref: arg.name
            if an.length == 0 then posCount = posCount + 1
            if an.length > 0 then provided.append an
        } else null
    }
    missingNames: (List String)
    missingIds: (ListVal u64)
    missingCtorFields :ast :st :funcId :isCtor :provided :posCount :missingNames :missingIds
    mi: u64
    mn: missingNames.length
    for mi < mn loop {
        pname: missingNames.get i: mi
        pcid: missingIds.get i: mi
        mi = mi + 1
        tnm: typeNameOf :st tid: (ztypes.tid.create from: pcid.u64)
        mm: "missing required argument '\{pname}' (type: \{tnm})"
        (addError
            :st
            nodeid: call.nodeid
            lineno: call.lineno
            colno: call.colno
            e: zast.err.callError
            msg: mm
        )
    }
}

# hoist and typecheck each argument of a call.
# walkCallArgsHoist -- the user-call argument walk: type each argument, then
# hoist non-trivial ones into synth temps.
walkCallArgsHoist: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: zast.CallData.view
    funcId: ztypes.tid
    isCtor: bool
    reportUnknown: bool
    recvImplicit: bool
} out String is {
    lockRoot: String
    st.typing.lastLockParamRoot = "".string
    argIdx: u64
    boundArgIds: (ListVal u64)
    effId9: funcId
    if isCtor then {
        isMetaC9: false
        {
            mcbC9: metaCreateBaseId :ast n: (ast.nodes.get i: call.callable.u64)
            match (
                mcbC9
            ) case some then {
                isMetaC9 = true
            } case none then null
        }
        if (isMetaC9) == false then {
            (forceMemberOf
                ty: st.typing
                reg: st.reg
                :ast
                parentTypeId: funcId
                nameId: zast.wkCreate
            )
            crEff9: (optU64Or
                o: (st.typing.declChildOfId parentTypeId: funcId nameId: zast.wkCreate)
                d: 0
            )
            if crEff9 > 0 when (st.reg.typetypeOf typeId: (ztypes.tid.create from: crEff9.u64)) == ztypes.ztypetype.functionType then effId9 = ztypes.tid.create from: crEff9.u64
        }
    }
    forceAllMembers ty: st.typing reg: st.reg :ast tid: effId9
    aiter: call.arguments.iterate
    for argId9: aiter loop {
        arg: ast.nodes.get i: argId9.u64
        match (
            arg
        ) case namedoperation then {
            # a FUNCTION-typed field takes a method REFERENCE: its ctor
            # argument walks without the value-position auto-call coercion.
            useNC: false
            if isCtor then {
                pn0: zast.nameTextAt :ast ref: arg.name
                if pn0.length > 0 then {
                    fco: (st.typing.declChildOf
                        pool: ast.names
                        parentTypeId: effId9
                        name: pn0.stringview
                    )
                    fcid: optU64Or o: fco d: 0
                    if fcid > 0 then {
                        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: fcid.u64)) == ztypes.ztypetype.functionType then {
                            useNC = true
                        }
                    }
                }
            }
            vt: ztypes.tid
            errV9: st.typing.errors.length
            if useNC then {
                opf49: ast.nodes.get i: arg.operation.u64
                vt = ztypes.tid.create from: (valueNoCoerce :st :unitDecl :ast n: opf49)
            } else {
                opf59: ast.nodes.get i: arg.operation.u64
                vt = checkValue :st :unitDecl :ast node: opf59
            }
            if vt.u64 == 0 when st.typing.errors.length == errV9 then {
                (reportUnresolvedValue
                    :st
                    :unitDecl
                    :ast
                    vnode: (ast.nodes.get i: arg.operation.u64)
                )
            }
            # A value that did not type must not take its LABEL checks down
            # with it: those answer from the parameter list alone. The block
            # below is gated on the value's type only because the ownership
            # and lock work there needs it, so the label-shaped checks run
            # here for the arguments it would otherwise skip entirely.
            if vt.u64 == 0 then {
                pnU9: zast.nameTextCopy :ast ref: arg.name
                if pnU9.length > 0 when effId9 > 0 then {
                    if (st.typing.declMemberCount ownerTid: effId9) > 0 then {
                        pcU9: (optU64Or
                            o: (st.typing.declChildOf
                                pool: ast.names
                                parentTypeId: effId9
                                name: pnU9.stringview
                            )
                            d: 0
                        )
                        if pcU9 == 0 then {
                            mU9: "unknown argument '\{pnU9}'"
                            sugU9: (suggestSimilar
                                :ast
                                :st
                                parentTypeId: effId9
                                name: pnU9.stringview
                            )
                            hU9: String
                            if sugU9.length > 0 then {
                                hhU9: "did you mean '\{sugU9}'?"
                                hU9 = hhU9
                            }
                            enU9b: String
                            (addErrorH
                                :st
                                nodeid: arg.nodeid
                                lineno: arg.lineno
                                colno: arg.colno
                                e: zast.err.callError
                                msg: mU9
                                note: enU9b
                                hint: hU9
                                width: pnU9.length.u32.orPanic
                            )
                        }
                    }
                }
                if reportUnknown when (isCtor) == false when pnU9.length == 0 when funcId > 0 then {
                    if (st.typing.declMemberCount ownerTid: funcId) == 0 then {
                        if (st.reg.typetypeOf typeId: funcId) == ztypes.ztypetype.functionType then {
                            tmU9: "too many arguments: function takes no parameters".string
                            (addError
                                :st
                                nodeid: arg.nodeid
                                lineno: arg.lineno
                                colno: arg.colno
                                e: zast.err.callError
                                msg: tmU9
                            )
                        }
                    }
                }
                if pnU9.length == 0 then {
                    pnU9 = (positionalParamName
                        :ast
                        :st
                        funcId: effId9
                        idx: argIdx
                        skipRecv: recvImplicit
                    )
                }
                if effId9 > 0 when pnU9.length > 0 then {
                    dcnU9: (zast.poolFind pool: ast.names text: pnU9.stringview)
                    dupU9: false
                    with bItU9: boundArgIds.iterate do for bIdU9: bItU9 loop {
                        if bIdU9 == dcnU9.u64 then dupU9 = true
                    }
                    if dupU9 when reportUnknown then {
                        dmU9: "argument '\{pnU9}' specified more than once"
                        (addError
                            :st
                            nodeid: arg.nodeid
                            lineno: arg.lineno
                            colno: arg.colno
                            e: zast.err.callError
                            msg: dmU9
                        )
                    } else {
                        boundArgIds.append dcnU9.u64
                    }
                }
            }
            if vt > 0 then {
                pn: zast.nameTextCopy :ast ref: arg.name
                if pn.length > 0 when effId9 > 0 then {
                    if (st.typing.declMemberCount ownerTid: effId9) > 0 then {
                        pco9: (st.typing.declChildOf
                            pool: ast.names
                            parentTypeId: effId9
                            name: pn.stringview
                        )
                        pcidX9: optU64Or o: pco9 d: 0
                        if pcidX9 == 0 then {
                            m2: "unknown argument '\{pn}'"
                            anid9: arg.nodeid
                            anln9: arg.lineno
                            ancl9: arg.colno
                            sug2: (suggestSimilar
                                :ast
                                :st
                                parentTypeId: (ztypes.tid.create from: effId9.u64)
                                name: pn.stringview
                            )
                            h2: String
                            if sug2.length > 0 then {
                                hh2: "did you mean '\{sug2}'?"
                                h2 = hh2
                            }
                            en2: String
                            (addErrorH
                                :st
                                nodeid: anid9
                                lineno: anln9
                                colno: ancl9
                                e: zast.err.callError
                                msg: m2
                                note: en2
                                hint: h2
                                width: pn.length.u32.orPanic
                            )
                        } else {
                            ptid9: pcidX9
                            if ptid9 > 0 when vt > 0 then {
                                if (typesCompatible
                                    :ast
                                    :st
                                    :unitDecl
                                    a: vt
                                    b: (ztypes.tid.create from: ptid9.u64)
                                ) == false then {
                                    skipMM9: false
                                    if (isNumericTid
                                        :ast
                                        ty: st.typing
                                        reg: st.reg
                                        tid: (ztypes.tid.create from: vt.u64)
                                    ) when (isNumericTid
                                        :ast
                                        ty: st.typing
                                        reg: st.reg
                                        tid: (ztypes.tid.create from: ptid9.u64)
                                    ) then skipMM9 = true
                                    ptt9: st.reg.typetypeOf typeId: (ztypes.tid.create from: ptid9.u64)
                                    if ptt9 == ztypes.ztypetype.protocolType then skipMM9 = true
                                    if ptt9 == ztypes.ztypetype.facetType then skipMM9 = true
                                    if ptt9 == ztypes.ztypetype.genericParam then skipMM9 = true
                                    if ptt9 == ztypes.ztypetype.functionType then skipMM9 = true
                                    if (skipMM9) == false then {
                                        en7: typeNameOf :st tid: (ztypes.tid.create from: ptid9.u64)
                                        an7: typeNameOf :st tid: (ztypes.tid.create from: vt.u64)
                                        emit7: true
                                        if an7.length == 0 then {
                                            # unresolved got-side: suppress the knock-on
                                            # when a prior error explains it, else name it
                                            if st.typing.errors.length > 0 then emit7 = false
                                            an7 = "an unresolved value".string
                                        }
                                        # a literal got-side would have COERCED had the
                                        # expected type resolved, so its mismatch is a
                                        # knock-on whenever an earlier error explains it
                                        if (isLiteralTypeId
                                            :st
                                            tid: (ztypes.tid.create from: vt.u64)
                                        ) then {
                                            if st.typing.errors.length > 0 then emit7 = false
                                        }
                                        if emit7 then {
                                            mm7: "argument '\{pn}' type mismatch: expected \{en7}, got \{an7}"
                                            en7b: String
                                            eh7: String
                                            (addErrorH
                                                :st
                                                nodeid: arg.nodeid
                                                lineno: arg.lineno
                                                colno: arg.colno
                                                e: zast.err.callError
                                                msg: mm7
                                                note: en7b
                                                hint: eh7
                                                width: pn.length.u32.orPanic
                                            )
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                if reportUnknown when (isCtor) == false when pn.length == 0 when funcId > 0 then {
                    if (st.typing.declMemberCount ownerTid: funcId) == 0 then {
                        if (st.reg.typetypeOf typeId: funcId) == ztypes.ztypetype.functionType then {
                            tmm9: "too many arguments: function takes no parameters".string
                            (addError
                                :st
                                nodeid: arg.nodeid
                                lineno: arg.lineno
                                colno: arg.colno
                                e: zast.err.callError
                                msg: tmm9
                            )
                        }
                    }
                }
                wasPos9: false
                if pn.length == 0 then {
                    wasPos9 = true
                    pp: (positionalParamName
                        :ast
                        :st
                        funcId: effId9
                        idx: argIdx
                        skipRecv: recvImplicit
                    )
                    pn = pp
                }
                if effId9 > 0 when pn.length > 0 then {
                    # the parameter's pool id is identity enough: effId9 is
                    # fixed across this call's argument walk, so two args
                    # collide exactly when they name the same parameter
                    dcnid9: (zast.poolFind pool: ast.names text: pn.stringview)
                    dupSeen9: false
                    with bIt9: boundArgIds.iterate do for bId9: bIt9 loop {
                        if bId9 == dcnid9.u64 then dupSeen9 = true
                    }
                    if dupSeen9 when reportUnknown then {
                        dmm9: "argument '\{pn}' specified more than once"
                        (addError
                            :st
                            nodeid: arg.nodeid
                            lineno: arg.lineno
                            colno: arg.colno
                            e: zast.err.callError
                            msg: dmm9
                        )
                    } else {
                        boundArgIds.append dcnid9.u64
                    }
                    if wasPos9 then {
                        cpidP9: (optU64Or
                            o: (st.typing.declChildOf
                                pool: ast.names
                                parentTypeId: effId9
                                name: pn.stringview
                            )
                            d: 0
                        )
                        if cpidP9 > 0 then {
                            ptidP9: cpidP9
                            if ptidP9 > 0 when vt > 0 then {
                                if (typesCompatible
                                    :ast
                                    :st
                                    :unitDecl
                                    a: vt
                                    b: (ztypes.tid.create from: ptidP9.u64)
                                ) == false then {
                                    skipP9: false
                                    if (isNumericTid
                                        :ast
                                        ty: st.typing
                                        reg: st.reg
                                        tid: (ztypes.tid.create from: vt.u64)
                                    ) when (isNumericTid
                                        :ast
                                        ty: st.typing
                                        reg: st.reg
                                        tid: (ztypes.tid.create from: ptidP9.u64)
                                    ) then skipP9 = true
                                    pttP9: st.reg.typetypeOf typeId: (ztypes.tid.create from: ptidP9.u64)
                                    if pttP9 == ztypes.ztypetype.protocolType then skipP9 = true
                                    if pttP9 == ztypes.ztypetype.facetType then skipP9 = true
                                    if pttP9 == ztypes.ztypetype.genericParam then skipP9 = true
                                    if pttP9 == ztypes.ztypetype.functionType then skipP9 = true
                                    if (skipP9) == false then {
                                        enP9: (typeNameOf
                                            :st
                                            tid: (ztypes.tid.create from: ptidP9.u64)
                                        )
                                        anP9: typeNameOf :st tid: (ztypes.tid.create from: vt.u64)
                                        emitP9: true
                                        if anP9.length == 0 then {
                                            # unresolved got-side: suppress the knock-on
                                            # when a prior error explains it, else name it
                                            if st.typing.errors.length > 0 then emitP9 = false
                                            anP9 = "an unresolved value".string
                                        }
                                        if emitP9 then {
                                            tmmP9: "argument type mismatch: expected \{enP9}, got \{anP9}"
                                            enP9b: String
                                            ehP9: String
                                            (addErrorH
                                                :st
                                                nodeid: arg.nodeid
                                                lineno: arg.lineno
                                                colno: arg.colno
                                                e: zast.err.callError
                                                msg: tmmP9
                                                note: enP9b
                                                hint: ehP9
                                                width: pn.length.u32.orPanic
                                            )
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                isTake: false
                isLockish: false
                isDeclLock: false
                isViewArg: false
                pt: u64
                if funcId > 0 when pn.length > 0 then {
                    if (isLiteralTypeId :st tid: (ztypes.tid.create from: vt.u64)) then {
                        po: (st.typing.declChildOf
                            pool: ast.names
                            parentTypeId: funcId
                            name: pn.stringview
                        )
                        match (
                            po
                        ) case some then {
                            pt = po
                        } case none then null
                    }
                    oo: (st.typing.declOwnershipOfId
                        parentTypeId: funcId
                        nameId: (zast.poolFind pool: ast.names text: pn.stringview)
                    )
                    match (
                        oo
                    ) case some then {
                        if oo == ztypes.zparamownership.takeMode then isTake = true
                        if oo == ztypes.zparamownership.takexMode then isTake = true
                        if oo == ztypes.zparamownership.borrowMode then isLockish = true
                        if oo == ztypes.zparamownership.viewMode then {
                            isLockish = true
                            isViewArg = true
                        }
                    } case none then {
                        # Unrecorded ownership: the effective default is
                        # borrow (ctor field params keep their recorded flow).
                        if (isCtor) == false then isLockish = true
                    }
                if funcId > 0 when pn.length == 0 when isCtor then {
                    # a POSITIONAL constructor argument (a tagged-sum arm
                    # payload) transfers ownership exactly like its named
                    # form: the arm stores it owned
                    if (typeIsReftype :st tid: (ztypes.tid.create from: vt.u64)) then isTake = true
                }
                    if isCtor then {
                        # Field ownership flows to the constructor param:
                        # a `.lock` field locks the caller's argument, any
                        # other reftype field takes it.
                        if (st.typing.declIsLockField
                            pool: ast.names
                            parentTypeId: funcId
                            name: pn.stringview
                        ) then {
                            isLockish = true
                        } else {
                            if (typeIsReftype
                                :st
                                tid: (ztypes.tid.create from: vt.u64)
                            ) then isTake = true
                        }
                    }
                }
                dispHit9: false
                if isTake then dispHit9 = true
                if isLockish then dispHit9 = true
                if dispHit9 when (typeIsReftype :st tid: (ztypes.tid.create from: vt.u64)) then {
                    dispVal9: ztypes.zparamownership.borrowMode
                    if isTake then dispVal9 = ztypes.zparamownership.takeMode
                    dispNid9: innermostNodeId :ast n: (ast.nodes.get i: arg.operation.u64)
                    if dispNid9 > 0 then {
                        st.typing.argDisposition.set key: dispNid9.u64 value: dispVal9
                    }
                }
                if (argIsTrivial :ast op: (ast.nodes.get i: arg.operation.u64)) then {
                    # A trivial literal argument coerces in place at the
                    # parameter boundary (no hoist: restamp its bare node).
                    if pt > 0 then {
                        iid2: innermostNodeId :ast n: (ast.nodes.get i: arg.operation.u64)
                        if iid2 > 0 then {
                            seta2: pt
                            stampGate :st nid: iid2.u64 tid: (ztypes.tid.create from: seta2.u64)
                        }
                    }
                    # A bare-name reftype argument: a take parameter consumes
                    # it (the overlay propagates out on pop); a lock/borrow
                    # parameter locks it for the call. A `:name` shorthand
                    # argument is the same bare local read, so a take
                    # parameter consumes it identically; at lock/borrow
                    # parameters the shorthand takes no lock (enforcing
                    # those is a recorded follow-on, measured at 1,848
                    # sites -- see docs/typechecker.pdoc).
                    bn: bareAtomName :ast n: (ast.nodes.get i: arg.operation.u64)
                    if bn.length == 0 when isTake then {
                        bn = atomName :ast n: (ast.nodes.get i: arg.operation.u64)
                    }
                    if bn.length > 0 when (typeIsReftype
                        :st
                        tid: (ztypes.tid.create from: vt.u64)
                    ) then {
                        bvo: st.lookupVarId nameId: (nameIdOf :ast name: bn.stringview)
                        match (
                            bvo
                        ) case some then {
                            if isTake then {
                                (consumeBareArgOwnership
                                    :st
                                    :ast
                                    name: bn.stringview
                                    vid: bvo
                                    nodeid: (nodeId n: (ast.nodes.get i: arg.operation.u64))
                                    lineno: (nodeLine n: (ast.nodes.get i: arg.operation.u64))
                                    colno: (nodeCol n: (ast.nodes.get i: arg.operation.u64))
                                )
                            } else {
                                if isLockish then {
                                    (lockCallArg
                                        :ast
                                        :st
                                        pool: ast.names
                                        name: bn.stringview
                                        callId: call.nodeid.u64
                                        shared: isViewArg
                                        nodeid: (nodeId n: (ast.nodes.get i: arg.operation.u64))
                                        lineno: (nodeLine n: (ast.nodes.get i: arg.operation.u64))
                                        colno: (nodeCol n: (ast.nodes.get i: arg.operation.u64))
                                    )
                                    if lockRoot.length == 0 then lockRoot = bn.copy
                                    if isDeclLock then {
                                        xlc: bn.copy
                                        st.typing.lastLockParamRoot = xlc
                                    }
                                }
                            }
                        } case none then null
                    }
                } else {
                    # A construction or take parameter consumes the hoisted
                    # temp inside the call scope; a lock/borrow parameter
                    # locks it there.
                    consumes: false
                    if isTake then consumes = true
                    # a `.lock`-suffixed argument at a lock parameter locks
                    # its base and hoists a BORROWED view of it (the synth
                    # temp's origin is the base; the base's lock row lands
                    # in the call scope via the borrow-lock install).
                    if isLockish then {
                        lsb9: lockSuffixBase :ast n: (ast.nodes.get i: arg.operation.u64)
                        if lsb9.length > 0 then {
                            drainPendingBorrow :st
                            lsbc9: lsb9.copy
                            st.typing.pendingBorrowPath.append lsbc9
                            if lockRoot.length == 0 then lockRoot = lsb9.copy
                            if isDeclLock then {
                                xlc9: lsb9.copy
                                st.typing.lastLockParamRoot = xlc9
                            }
                        }
                    }
                    # a plain field-path argument behaves as its user-
                    # written hoist would: seed the borrow side channel with
                    # the real source tuple so the synth temp installs the
                    # spec's SHARED-prefix + EXCLUSIVE-leaf locks on it
                    if isLockish when (typeIsReftype
                        :st
                        tid: (ztypes.tid.create from: vt.u64)
                    ) then {
                        an9: ast.nodes.get i: arg.operation.u64
                        src9: (List String)
                        appendValueTuple :ast n: an9 dst: src9
                        if src9.length > 0 then {
                            rt9: rootNameOf :ast n: an9
                            # residue left by an EARLIER argument of this call
                            # must not stand in for THIS argument's source:
                            # keep a pending path only when it is rooted at
                            # this argument's own base
                            if st.typing.pendingBorrowPath.length > 0 then {
                                pr9: st.typing.pendingBorrowPath.get i: 0
                                if pr9.stringview != rt9.stringview then drainPendingBorrow :st
                            }
                            if st.typing.pendingBorrowPath.length == 0 then {
                                rvo9: st.lookupVarId nameId: (nameIdOf :ast name: rt9.stringview)
                                match (
                                    rvo9
                                ) case some then {
                                    drainPendingBorrow :st
                                    si9: u64
                                    sn9: src9.length
                                    for si9 < sn9 loop {
                                        se9: src9.get i: si9
                                        sec9: se9.copy
                                        st.typing.pendingBorrowPath.append sec9
                                        si9 = si9 + 1
                                    }
                                } case none then null
                            }
                        }
                    }
                    hadPending: false
                    if st.typing.pendingBorrowPath.length > 0 then hadPending = true
                    tnm: (hoistArg
                        :ast
                        :st
                        argNode: (ast.nodes.get i: arg.operation.u64)
                        argType: vt
                        paramType: pt
                        :consumes
                        viewParam: isViewArg
                    )
                    if (hadPending) == false then {
                        if isLockish when (typeIsReftype
                            :st
                            tid: (ztypes.tid.create from: vt.u64)
                        ) then {
                            (lockCallArg
                                        :ast
                                :st
                                pool: ast.names
                                name: tnm.stringview
                                callId: call.nodeid.u64
                                shared: isViewArg
                                nodeid: (nodeId n: (ast.nodes.get i: arg.operation.u64))
                                lineno: (nodeLine n: (ast.nodes.get i: arg.operation.u64))
                                colno: (nodeCol n: (ast.nodes.get i: arg.operation.u64))
                            )
                        }
                    }
                }
            }
            argIdx = argIdx + 1
        } else null
    }
    return lockRoot
}

# checkBoxConstruction -- `Box from: val`: the value's (materialised) type
# binds t; the argument is consumed (hoisted first when non-trivial); the
# instance carries create plus the element type's children copied for
# transparent member access. Heap passthrough (List/Map boxing) lands when
# an example needs it.
checkBoxConstruction: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: zast.CallData.view
    tplId: ztypes.tid
} out ztypes.tid is {
    fnd: false
    vt: ztypes.tid
    with aiter: call.arguments.iterate do for argId9: aiter loop {
        arg: ast.nodes.get i: argId9.u64
        match (
            arg
        ) case namedoperation then {
            if (fnd) == false then {
                an: zast.nameTextAt :ast ref: arg.name
                if an.stringview != "t" then {
                    if an.stringview != "from" then {
                        mbx7: "the builtin Box constructs with 'from:'; unknown argument '\{an}'"
                        bxid7: nodeId n: (ast.nodes.get i: arg.operation.u64)
                        bxln7: nodeLine n: (ast.nodes.get i: arg.operation.u64)
                        bxcl7: nodeCol n: (ast.nodes.get i: arg.operation.u64)
                        (addError
                            :st
                            nodeid: bxid7
                            lineno: bxln7
                            colno: bxcl7
                            e: zast.err.callError
                            msg: mbx7
                        )
                    }
                    fnd = true
                    avt: (checkValue
                        :st
                        :unitDecl
                        :ast
                        node: (ast.nodes.get i: arg.operation.u64)
                    )
                    vt = materialiseLiteral :ast :st :unitDecl t: avt
                    if vt > 0 then {
                        if (argIsTrivial :ast op: (ast.nodes.get i: arg.operation.u64)) then {
                            iid: innermostNodeId :ast n: (ast.nodes.get i: arg.operation.u64)
                            if iid > 0 then {
                                setbl: vt
                                stampGate :st nid: iid.u64 tid: (ztypes.tid.create from: setbl.u64)
                            }
                            bn: bareAtomName :ast n: (ast.nodes.get i: arg.operation.u64)
                            aid8b: nodeId n: (ast.nodes.get i: arg.operation.u64)
                            aln8b: nodeLine n: (ast.nodes.get i: arg.operation.u64)
                            acl8b: nodeCol n: (ast.nodes.get i: arg.operation.u64)
                            if bn.length > 0 when (typeIsReftype
                                :st
                                tid: (ztypes.tid.create from: vt.u64)
                            ) then {
                                bvo8: st.lookupVarId nameId: (nameIdOf :ast name: bn.stringview)
                                match (
                                    bvo8
                                ) case some then {
                                    if (nameIsReadonly :st :ast name: bn.stringview) then {
                                        (readonlyMoveError
                                            :st
                                            nodeid: aid8b
                                            lineno: aln8b
                                            colno: acl8b
                                            name: bn.stringview
                                            verb: "into a box"
                                        )
                                    } else {
                                        bpin8: (pinnedMoveError
                                            :st
                                            :ast
                                            nodeid: aid8b
                                            lineno: aln8b
                                            colno: acl8b
                                            name: bn.stringview
                                            verb: "into a box"
                                        )
                                        if bpin8 then null else if (isBorrowedVar
                                            :st
                                            vid: bvo8
                                        ) then {
                                            mb8: "Cannot move borrowed variable '\{bn}' into a box — borrowed names stay bound to their source for the full scope; copy with '.copy' to keep the source"
                                            (addError
                                                :st
                                                nodeid: aid8b
                                                lineno: aln8b
                                                colno: acl8b
                                                e: zast.err.ownerError
                                                msg: mb8
                                            )
                                        } else {
                                            (st.invalidate
                                                nameId: (nameIdOf :ast name: bn.stringview)
                                                loc: takenHere
                                            )
                                        }
                                    }
                                } case none then {
                                    (st.invalidate
                                        nameId: (nameIdOf :ast name: bn.stringview)
                                        loc: takenHere
                                    )
                                }
                            }
                        } else {
                            (hoistArg
                                :ast
                                :st
                                argNode: (ast.nodes.get i: arg.operation.u64)
                                argType: vt
                                paramType: 0
                                consumes: true
                                viewParam: false
                            )
                        }
                    }
                }
            }
        } else null
    }
    if vt.isZero then return (ztypes.tid.create from: 0)
    tn: typeNameOf :st tid: (ztypes.tid.create from: vt.u64)
    mname: "Box_\{tn}"
    subs: (MapRV String value: u64)
    sk: "t".string
    sv: vt
    subs.set key: sk value: sv
    vsJ9: (MapRV String value: u64)
    mid: (getOrMintSpec
        :ast
        ty: st.typing
        reg: st.reg
        :unitDecl
        name: mname.stringview
        templateId: (ztypes.tid.create from: tplId.u64)
        :subs
        valSubs: vsJ9
        fallbackArg: 0
    )
    if mid.isZero then return (ztypes.tid.create from: 0)
    st.reg.setIsBox typeId: mid
    st.reg.setIsHeapAllocated typeId: mid
    bdtor9: "z_\{mname}_destroy"
    (st.reg.setDestructorName
        typeId: mid
        nameId: (zast.poolSet pool: ast.names text: bdtor9.stringview)
    )
    if (st.typing.declMemberCount ownerTid: mid) <= 0 then {
        crId: st.reg.newType name: "create" ownerTid: mid typetype: ztypes.ztypetype.functionType
        (st.typing.declSynthMember
            parentTypeId: mid
            nameId: zast.wkCreate
            kind: ztyping.declkind.methodDecl
        )
        st.typing.setMemberType parentTypeId: mid nameId: zast.wkCreate childTypeId: crId
        # Stage the element's members first: setMemberType appends to the very
        # declaration being iterated.
        cIds2: (ListVal u64)
        cNid2: (ListVal u64)
        st.typing.declMemberList ownerTid: vt names: cNid2 tids: cIds2
        bi: u64
        bn2: cNid2.length
        for bi < bn2 loop {
            chi: cIds2.get i: bi
            chnId: (zast.nameid.create from: (cNid2.get i: bi))
            (forceMemberOf ty: st.typing reg: st.reg :ast parentTypeId: mid nameId: chnId)
            ext9: st.typing.declChildOfId parentTypeId: mid nameId: chnId
            match (
                ext9
            ) case some then null case none then {
                # declare before edging, so setMemberType stamps the copied
                # member's type onto its declaration instead of leaving the
                # sweep below to mint it and read the type back off the edge
                kk9: ztyping.declkind.fieldDecl
                if (st.reg.typetypeOf typeId: (ztypes.tid.create from: chi.u64)) == ztypes.ztypetype.functionType then {
                    kk9 = ztyping.declkind.methodDecl
                }
                st.typing.declSynthMember parentTypeId: mid nameId: chnId kind: kk9
                st.typing.setMemberType parentTypeId: mid nameId: chnId childTypeId: chi
            }
            bi = bi + 1
        }
    }
    bcal: nodeId n: (ast.nodes.get i: call.callable.u64)
    if bcal > 0 then {
        setbt: tplId
        stampGate :st nid: bcal.u64 tid: setbt
    }
    setbc: mid
    stampGate :st nid: call.nodeid.u64 tid: setbc
    st.typing.callKind.set key: call.nodeid.u64 value: zast.callkind.boxCreate
    return mid
}

# callableDottedResult -- a dotted callable resolves through the dotted-path
# walk (no auto-call coercion -- callable position wants the function itself);
# the base is typed and stamped there. none = the callable is not a dotted
# path; some 0 = dotted but unresolved (e.g. a data block's `.index`), which
# leaves the call untyped with its arguments unwalked, like the reference.
callableDottedResult: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    ast: Ast.view
    n: Node.view
} out optionval ztypes.tid is {
    match (
        n
    ) case dottedpath then {
        r: checkDotted :st :unitDecl :ast dp: n coerce: false
        return (optionval.some r)
    } else {
        return (optionval.none ztypes.tid)
    }
}

# returnedBareFieldName -- `return <base>.<field>` where the member is a
# non-FUNCTION field whose type is a reftype or a generic param: the bare
# read escapes a shallow copy of storage the owner still frees (and a
# generic param may instantiate to one). Returns the field name for the
# diagnostic; "" when the return shape is fine.
returnedBareFieldName: function {ast: Ast.view st: zenv.ZSymbolTable n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (returnedBareFieldName :ast :st n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        bfc9: atomName :ast n: (ast.nodes.get i: n.child.u64)
        bfcId9: atomNameId :ast n: (ast.nodes.get i: n.child.u64)
        if bfc9.length == 0 then return "".string
        if (isStripMarker name: bfc9.stringview) then return "".string
        bfp9: nodeId n: (ast.nodes.get i: n.parent.u64)
        bft9: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: bfp9.u64
        if bft9.isZero then return "".string
        (forceMemberOf
            ty: st.typing
            reg: st.reg
            :ast
            parentTypeId: (ztypes.tid.create from: bft9.u64)
            nameId: bfcId9
        )
        bfo9: (st.typing.declChildOfId
            parentTypeId: (ztypes.tid.create from: bft9.u64)
            nameId: bfcId9
        )
        match (
            bfo9
        ) case some then {
            if (st.reg.typetypeOf typeId: (ztypes.tid.create from: bfo9.u64)) == ztypes.ztypetype.functionType then return "".string
            if (st.reg.typetypeOf typeId: (ztypes.tid.create from: bfo9.u64)) == ztypes.ztypetype.genericParam then return (bfc9.copy)
            if (typeIsReftype :st tid: (ztypes.tid.create from: bfo9.u64)) then return (bfc9.copy)
            return "".string
        } case none then {
            return "".string
        }
    } else {
        return "".string
    }
}

# unresolvedBareCallable -- the bare-atom callable name of a call-shaped
# value that resolves to NOTHING (no local, no own-unit function, no system
# name, no walkable type): the checker's silent args-walked fallthrough
# otherwise leaves the binding untyped and the emitter prints a marker.
# unresolvedBareName -- prove a bare name resolves NOWHERE in value
# position: not a local, not a unit member, not a typeref, not a system
# child. The name when unresolvable; "" when anything claims it.
unresolvedBareName: function {ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    name: StringView
} out String is {
    if name.length == 0 then return "".string
    # `meta` is the enclosing type's raw allocator base (meta.create):
    # contextual, never a unit-resolvable name
    if name == "meta" then return "".string
    ubv9: st.lookupVarId nameId: (nameIdOf :ast :name)
    match (
        ubv9
    ) case some then {
        return "".string
    } case none then null
    # lookupVarId reads two in-scope names as absent: a binding that minted no
    # varId (a `meta.create` result) and a MOVED one (both `lookup` and
    # `lookupVarId` refuse a taken local). A declared name is in scope however
    # it was consumed, so the local's declaration itself is the authority.
    if (st.isLocalName nameId: (nameIdOf :ast :name)) then return "".string
    if (nameClaimedByScope
        :ast
        ty: st.typing
        reg: st.reg
        :unitDecl
        :name
    ) then return "".string
    ubw9: (walkLookupTyperef
        :ast
        ty: st.typing
        reg: st.reg
        :unitDecl
        base: name
    )
    match (
        ubw9
    ) case some then {
        return "".string
    } case none then null
    return name.string
}

# dottedRootName -- the root atom name of a dotted path ("" when the
# root is not a bare atom).
dottedRootName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case dottedpath then {
        return (dottedRootName :ast n: (ast.nodes.get i: n.parent.u64))
    } case expression then {
        return (dottedRootName :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        return (atomName :ast :n)
    }
}

# isDottedValue -- the node under any expression wrappers is a dotted path.
isDottedValue: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (isDottedValue :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return true
    } else {
        return false
    }
}

# report an unresolved bare callee (E0023).
unresolvedBareCallable: function {ast: Ast.view
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    n: Node.view
} out String is {
    match (
        n
    ) case expression then {
        return (unresolvedBareCallable
            :ast
            :st
            :unitDecl
            n: (ast.nodes.get i: n.expression.u64)
        )
    } case call then {
        cnode9: ast.nodes.get i: n.callable.u64
        ubc9: atomName :ast n: cnode9
        if ubc9.length > 0 then return (unresolvedBareName :ast :st :unitDecl name: ubc9.stringview)
        ubr0: dottedRootName :ast n: cnode9
        return (unresolvedBareName :ast :st :unitDecl name: ubr0.stringview)
    } case binop then {
        # an operand may carry the unresolvable name (`ghost + 1`)
        ubl9: (unresolvedBareCallable
            :ast
            :st
            :unitDecl
            n: (ast.nodes.get i: n.lhs.u64)
        )
        if ubl9.length > 0 then return ubl9
        return (unresolvedBareCallable
            :ast
            :st
            :unitDecl
            n: (ast.nodes.get i: n.rhs.u64)
        )
    } case atomid then {
        uba9: zast.nameTextAt :ast ref: n.name
        return (unresolvedBareName :ast :st :unitDecl name: uba9.stringview)
    } else {
        return "".string
    }
}

# reportUnresolvedValue -- a value that typed to nothing and raised nothing is
# an unresolvable name: report it here, where the value is consumed. Without
# it the 0 silently disables the consuming site's own checks and the emitter
# writes the bare name into the C. Mirrors the binding and statement sites.
reportUnresolvedValue: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    vnode: Node.view
} is {
    ubU9: unresolvedBareCallable :ast :st :unitDecl n: vnode
    if ubU9.length == 0 then {
        # the ROOT of a dotted VALUE carries the name (`ghost.field`) -- the
        # callee leg already makes this check for `ghost.method`. It stays
        # here rather than in unresolvedBareCallable: the statement and
        # binding sites share that helper and reach bodies whose locals are
        # absent from the scope table, where the negative proof would reject
        # a real name (`lx.advance` in zlexer's Lexer).
        if (isDottedValue :ast n: vnode) then {
            ubD9: dottedRootName :ast n: vnode
            ubU9 = unresolvedBareName :ast :st :unitDecl name: ubD9.stringview
        }
    }
    if ubU9.length == 0 then return
    umU9: "Unknown reference '\{ubU9}'"
    enU9: String
    ehU9: String
    (addErrorH
        :st
        nodeid: (nodeId n: vnode)
        lineno: (nodeLine n: vnode)
        colno: (nodeCol n: vnode)
        e: zast.err.badReference
        msg: umU9
        note: enU9
        hint: ehU9
        width: ubU9.length.u32.orPanic
    )
}

# monoMemberOf -- inside a unit mono's instance walk (curMonoStamp), the mono's
# own member for a bare callee that resolved to the TEMPLATE's method of that
# name; any other id passes through unchanged.
monoMemberOf: function {
    st: zenv.ZSymbolTable
    templateFnTid: ztypes.tid
    nameId: zast.nameid
} out ztypes.tid is {
    org9: st.reg.genericOriginOf tid: (ztypes.tid.create from: st.typing.curMonoStamp)
    if org9.isZero then return templateFnTid
    tm9: st.typing.declChildOfId parentTypeId: org9 :nameId
    match (
        tm9
    ) case some then {
        if tm9 != templateFnTid.u64 then return templateFnTid
    } case none then {
        return templateFnTid
    }
    mm9: (st.typing.declChildOfId
        parentTypeId: (ztypes.tid.create from: st.typing.curMonoStamp)
        :nameId
    )
    match (
        mm9
    ) case some then {
        return (ztypes.tid.create from: mm9.u64)
    } case none then {
        return templateFnTid
    }
}

# checkCall -- type a call. C1 handles the `return <value>` control-flow form:
# stamp the callable atom with return's type, mark the call RETURN, walk the
# return value, and resolve the call to `never`. Other call kinds land later.
checkCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: zast.CallData.view
} out ztypes.tid is {
    result: ztypes.tid
    cn: atomName :ast n: (ast.nodes.get i: call.callable.u64)
    if cn.stringview == "return" then {
        rtOpt: walkLookupTyperef :ast ty: st.typing reg: st.reg :unitDecl base: "return"
        match (
            rtOpt
        ) case some then {
            calid: nodeId n: (ast.nodes.get i: call.callable.u64)
            stampGate :st nid: calid.u64 tid: (ztypes.tid.create from: rtOpt.u64)
        } case none then null
        st.typing.callKind.set key: call.nodeid.u64 value: zast.callkind.returnCall
        aiter: call.arguments.iterate
        # `return` is itself a call, so a LABELLED argument binds to RETURN,
        # not to the expression being returned: `return f a: 1` hands `a: 1`
        # to return and leaves `f` bare. Say that, and say it once -- walking
        # the arguments as return values instead blames the bare callee for
        # the argument it was denied and then the return type for the
        # function value, neither of which names the real mistake.
        rLbl9: false
        {
            lIter9: call.arguments.iterate
            for lArgId9: lIter9 loop {
                lArg9: ast.nodes.get i: lArgId9.u64
                match (
                    lArg9
                ) case namedoperation then {
                    if (lArg9.name.isZero) == false when (rLbl9) == false then {
                        rLbl9 = true
                        lNm9: zast.poolTextAt pool: ast.names ref: lArg9.name
                        lMsg9: "'return' has no argument '\{lNm9}'"
                        lNote9: "'return' is itself a call, so a labelled argument binds to it".string
                        lHint9: "wrap the returned call in parentheses so '\{lNm9}:' binds to it"
                        (addErrorH
                            :st
                            nodeid: lArg9.nodeid
                            lineno: lArg9.lineno
                            colno: lArg9.colno
                            e: zast.err.callError
                            msg: lMsg9
                            note: lNote9
                            hint: lHint9
                            width: lNm9.length.u32.orPanic
                        )
                    }
                } else null
            }
        }
        if (rLbl9) == false then {
            for argId9: aiter loop {
                arg: ast.nodes.get i: argId9.u64
                match (
                    arg
                ) case namedoperation then {
                    errR9: st.typing.errors.length
                    argT9: (checkValue
                        :st
                        :unitDecl
                        :ast
                        node: (ast.nodes.get i: arg.operation.u64)
                    )
                    # A returned value that typed to nothing and raised nothing is
                    # an unresolvable name -- but ONLY where this walk knows the
                    # enclosing function's return type. Some bodies reach here
                    # degenerate (zlexer's create/acceptAny: return type unknown,
                    # the local's own binding never registered a scope entry), and
                    # there the scope cannot answer whether a name is in scope.
                    # currentReturnTypeId is exactly the condition under which the
                    # return-type check below already runs.
                    if argT9.u64 == 0 when st.typing.errors.length == errR9 then {
                        if st.typing.currentReturnTypeId > 0 then {
                            (reportUnresolvedValue
                                :st
                                :unitDecl
                                :ast
                                vnode: (ast.nodes.get i: arg.operation.u64)
                            )
                        }
                    }
                    bfn9: (returnedBareFieldName
                        :ast
                        :st
                        n: (ast.nodes.get i: arg.operation.u64)
                    )
                    if st.typing.currentReturnsBorrow then bfn9 = "".string
                    if bfn9.length > 0 then {
                        mbf9: "Cannot return field '\{bfn9}' as a bare read — the owner still frees it; return '\{bfn9}.copy' (duplicate) or '\{bfn9}.take' (move out)"
                        bfid9: nodeId n: (ast.nodes.get i: arg.operation.u64)
                        bfln9: nodeLine n: (ast.nodes.get i: arg.operation.u64)
                        bfcl9: nodeCol n: (ast.nodes.get i: arg.operation.u64)
                        (addError
                            :st
                            nodeid: bfid9
                            lineno: bfln9
                            colno: bfcl9
                            e: zast.err.ownerError
                            msg: mbf9
                        )
                    }
                    # a returned owned local is CONSUMED: record the
                    # transfer so L022 does not offer a view for it
                    rbn9: bareAtomName :ast n: (ast.nodes.get i: arg.operation.u64)
                    if rbn9.length > 0 when argT9 > 0 when (typeIsReftype :st tid: argT9) then {
                        rvv9: st.lookupVarId nameId: (nameIdOf :ast name: rbn9.stringview)
                        match (
                            rvv9
                        ) case some then {
                            st.typing.variableMoved.set key: rvv9 value: true
                        } case none then null
                    }
                    expR9: st.typing.currentReturnTypeId
                    if expR9 > 0 when argT9 > 0 then {
                        if (typesCompatible :ast :st :unitDecl a: argT9 b: expR9) == false then {
                            en9: typeNameOf :st tid: expR9
                            an9: typeNameOf :st tid: argT9
                            m4: "return type mismatch: function expects \{en9}, got \{an9}"
                            rvid9: nodeId n: (ast.nodes.get i: arg.operation.u64)
                            rvln9: nodeLine n: (ast.nodes.get i: arg.operation.u64)
                            rvcl9: nodeCol n: (ast.nodes.get i: arg.operation.u64)
                            (addError
                                :st
                                nodeid: rvid9
                                lineno: rvln9
                                colno: rvcl9
                                e: zast.err.typeError
                                msg: m4
                            )
                        }
                    }
                } else null
            }
        }

        nvOpt: walkLookupTyperef :ast ty: st.typing reg: st.reg :unitDecl base: "never"
        match (
            nvOpt
        ) case some then {
            result = ztypes.tid.create from: nvOpt.u64
            setk: result
            stampGate :st nid: call.nodeid.u64 tid: setk
        } case none then null
    } else {
        # A regular call. A dotted callable resolves through the dotted-path
        # walk first; an unresolved member bails with the args unwalked. A
        # bare-name callable: a non-generic user function pushes a call scope
        # and resolves to its return type; a generic callee (e.g. print) infers
        # a clone; an unresolvable callable just has its args walked (its
        # callable/result/mono are out of the own+system+collections filter).
        # A parenthesized construction in callable position re-applies its
        # init arguments: the value is the constructed type.
        isWrapCall: (zast.kindOf :ast id: call.callable) == zast.astkind.expression
        if isWrapCall then {
            xq119: ast.nodes.get i: call.callable.u64
            errX9: st.typing.errors.length
            wcv: checkValue :st :unitDecl :ast node: xq119
            if wcv.u64 == 0 when st.typing.errors.length == errX9 then {
                reportUnresolvedValue :st :unitDecl :ast vnode: xq119
            }
            if wcv > 0 then {
                # A non-FUNCTION wrapped callee is the paren-mono construction
                # form: value args ride the standard ctor walk (call scope,
                # hoists, consumption); arg-less stays a bare construction.
                isWType: true
                if (st.reg.typetypeOf typeId: wcv) == ztypes.ztypetype.functionType then isWType = false
                # a container template has its own native create path, so its
                # paren-construction arguments take no standard ctor scope.
                wgix9: u64
                {
                    wgi9: st.reg.genericOriginOf tid: wcv
                    if wgi9 > 0 then wgix9 = wgi9
                }
                if wgix9 > 0 then {
                    if wgix9 == (builtinTidTc :ast :st base: "ListRef") then isWType = false
                    if wgix9 == (builtinTidTc :ast :st base: "ListVal") then isWType = false
                    if wgix9 == (builtinTidTc :ast :st base: "MapRR") then isWType = false
                    if wgix9 == (builtinTidTc :ast :st base: "MapRV") then isWType = false
                    if wgix9 == (builtinTidTc :ast :st base: "MapVR") then isWType = false
                    if wgix9 == (builtinTidTc :ast :st base: "MapVV") then isWType = false
                    if wgix9 == (builtinTidTc :ast :st base: "SetRef") then isWType = false
                    if wgix9 == (builtinTidTc :ast :st base: "SetVal") then isWType = false
                }
                if isWType when call.arguments.length > 0 then {
                    wcm: st.pushCall
                    (walkCallArgsHoist
                        :st
                        :unitDecl
                        :ast
                        :call
                        funcId: wcv
                        isCtor: true
                        reportUnknown: false
                        recvImplicit: false
                    )
                    checkMissingCallArgs :ast :st :call funcId: wcv isCtor: true
                    st.popTo marker: wcm
                    wck: wcv
                    wcvv: true
                    st.typing.constructedTypes.set key: wck value: wcvv
                } else {
                    witer: call.arguments.iterate
                    for wargId9: witer loop {
                        warg: ast.nodes.get i: wargId9.u64
                        match (
                            warg
                        ) case namedoperation then {
                            (checkValue
                                :st
                                :unitDecl
                                :ast
                                node: (ast.nodes.get i: warg.operation.u64)
                            )
                        } else null
                    }
                }
                setwc: wcv
                stampGate :st nid: call.nodeid.u64 tid: setwc
                return wcv
            }
        }
        mcb: metaCreateBaseId :ast n: (ast.nodes.get i: call.callable.u64)
        mcid: u32
        match (
            mcb
        ) case some then {
            mcid = mcb
        } case none then null
        if mcid > 0 when st.typing.currentThisName.length > 0 then {
            # `meta.create` constructs the enclosing type: the raw allocator's
            # params are the type's field children, so the ctor arg walk
            # (hoists, coercion, field consumption) rides funcId = the type.
            mctn: st.typing.currentThisName
            mto: (walkLookupTyperef
                :ast
                ty: st.typing
                reg: st.reg
                :unitDecl
                base: mctn.stringview
            )
            mtid: optU64Or o: mto d: 0
            if mtid > 0 then {
                setmb: mtid
                stampGate :st nid: mcid.u64 tid: (ztypes.tid.create from: setmb.u64)
                mcm: st.pushCall
                (walkCallArgsHoist
                    :st
                    :unitDecl
                    :ast
                    :call
                    funcId: (ztypes.tid.create from: mtid.u64)
                    isCtor: true
                    reportUnknown: false
                    recvImplicit: false
                )
                (checkMissingCallArgs
                    :ast
                    :st
                    :call
                    funcId: (ztypes.tid.create from: mtid.u64)
                    isCtor: true
                )
                st.popTo marker: mcm
                setmc: mtid
                stampGate :st nid: call.nodeid.u64 tid: (ztypes.tid.create from: setmc.u64)
                return (ztypes.tid.create from: mtid)
            }
        }
        xq109: ast.nodes.get i: call.callable.u64
        dro: callableDottedResult :st :unitDecl :ast n: xq109
        match (
            dro
        ) case some then {
            if dro.isZero then {
                # unresolved dotted callable (a data block's `.index`): the
                # call stays untyped, but its args are still values -- check
                # them so their atoms stamp (atomVariableId / refDecl)
                uwiter9: call.arguments.iterate
                for uwArg9: uwiter9 loop {
                    uwa9: ast.nodes.get i: uwArg9.u64
                    match (
                        uwa9
                    ) case namedoperation then {
                        (checkValue
                            :st
                            :unitDecl
                            :ast
                            node: (ast.nodes.get i: uwa9.operation.u64)
                        )
                    } else null
                }
                return (ztypes.tid.create from: 0)
            } else {
                # A non-generic FUNCTION member dispatches as a user method
                # call: call scope, arg walk, the callee's return, and the
                # borrow-return report.
                isMethodFn: false
                if dro < st.reg.typeById.length then {
                    mzo: st.reg.typeById.get i: dro
                    if mzo.typetype == ztypes.ztypetype.functionType then {
                        if (mzo.isgeneric) == false then isMethodFn = true
                    }
                }
                if isMethodFn then {
                    tdcb: createDottedBaseId :ast n: (ast.nodes.get i: call.callable.u64)
                    tdcid: u32
                    match (
                        tdcb
                    ) case some then {
                        tdcid = tdcb
                    } case none then null
                    isBorrowForm: false
                    bdcb: borrowDottedBaseId :ast n: (ast.nodes.get i: call.callable.u64)
                    match (
                        bdcb
                    ) case some then {
                        tdcid = bdcb
                        isBorrowForm = true
                    } case none then null
                    if tdcid > 0 then {
                        tdo: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: tdcid.u64
                        isTd: false
                        if (typedefBaseOf
                            :ast
                            :st
                            :unitDecl
                            tid: (ztypes.tid.create from: tdo.u64)
                        ) > 0 then isTd = true
                        if (typedefBaseTidOf
                            :st
                            tid: (ztypes.tid.create from: tdo.u64)
                        ) > 0 then isTd = true
                        if isTd when isBorrowForm then {
                            return (checkTypedefBorrow
                                :st
                                :unitDecl
                                :ast
                                :call
                                tdId: tdo
                            )
                        }
                        if isTd then {
                            return (checkTypedefCreate
                                :st
                                :unitDecl
                                :ast
                                :call
                                tdId: tdo
                            )
                        }
                        pjtt: st.reg.typetypeOf typeId: (ztypes.tid.create from: tdo.u64)
                        isProj: false
                        if pjtt == ztypes.ztypetype.facetType then isProj = true
                        if pjtt == ztypes.ztypetype.protocolType then isProj = true
                        if isProj then {
                            pjTake: false
                            pjBorrow: false
                            if pjtt == ztypes.ztypetype.protocolType then {
                                xq99: ast.nodes.get i: call.callable.u64
                                pjcn: dottedChildName :ast n: xq99
                                if pjcn.stringview == "create" then pjTake = true
                                if pjcn.stringview == "borrow" then pjBorrow = true
                            }
                            return (checkProjectionCreate
                                :st
                                :unitDecl
                                :ast
                                :call
                                pjId: tdo
                                consumes: pjTake
                                borrows: pjBorrow
                            )
                        }
                    }
                    mcm: st.pushCall
                    # Dotted on a value in scope = the receiver is implicit;
                    # dotted on the type (`Counter.increment c`) passes the
                    # receiver as an ordinary positional arg.
                    recvVal9: false
                    rrn9: rootNameOf :ast n: (ast.nodes.get i: call.callable.u64)
                    if rrn9.length > 0 then {
                        rlo9: st.lookup nameId: (nameIdOf :ast name: rrn9.stringview)
                        match (
                            rlo9
                        ) case some then {
                            recvVal9 = true
                        } case none then null
                    }
                    mlr: (walkCallArgsHoist
                        :st
                        :unitDecl
                        :ast
                        :call
                        funcId: dro
                        isCtor: false
                        reportUnknown: false
                        recvImplicit: recvVal9
                    )
                    checkMissingCallArgs :ast :st :call funcId: dro isCtor: false
                    # The receiver locks for the call's duration too (after
                    # the args, matching the oracle's entry order).
                    rro: methodReceiverRoot :ast n: (ast.nodes.get i: call.callable.u64)
                    if rro.length > 0 then {
                        rvo2: st.lookupVarId nameId: (nameIdOf :ast name: rro.stringview)
                        match (
                            rvo2
                        ) case some then {
                            rvt2: st.lookup nameId: (nameIdOf :ast name: rro.stringview)
                            match (
                                rvt2
                            ) case some then {
                                # A receiver-bound method locks reftype
                                # receivers; a this-less function member is a
                                # callable field -- its receiver locks
                                # unconditionally (mirrors _lock_receiver).
                                doLock: false
                                rtt: st.reg.typetypeOf typeId: (ztypes.tid.create from: rvt2.u64)
                                isFP: false
                                if rtt == ztypes.ztypetype.facetType then isFP = true
                                if rtt == ztypes.ztypetype.protocolType then isFP = true
                                if isFP then {
                                    doLock = true
                                } else {
                                    if (methodHasThisReceiver :st mid: dro) then {
                                        if (typeIsReftype
                                            :st
                                            tid: (ztypes.tid.create from: rvt2.u64)
                                        ) then doLock = true
                                    } else {
                                        doLock = true
                                    }
                                }
                                if doLock then {
                                    xq89: ast.nodes.get i: call.callable.u64
                                    rmn9: dottedChildName :ast n: xq89
                                    shr9: (isContainerReaderCall
                                        :ast
                                        :st
                                        recvTid: rvt2
                                        mname: rmn9.stringview
                                    )
                                    if (methodReceiverIsView :st mid: dro) then shr9 = true
                                    (lockCallArg
                                        :ast
                                        :st
                                        pool: ast.names
                                        name: rro.stringview
                                        callId: call.nodeid.u64
                                        shared: shr9
                                        nodeid: call.nodeid
                                        lineno: call.lineno
                                        colno: call.colno
                                    )
                                }
                            } case none then null
                        } case none then null
                    }
                    if rro.length == 0 then {
                        # Nested receiver (st.reg.map.get ...): the root-name
                        # block above cannot see it. Lock the full receiver
                        # tuple; the immediate receiver type (the stamped
                        # parent) drives the reader/writer kind.
                        rtupC: (List String)
                        xq79: ast.nodes.get i: call.callable.u64
                        methodReceiverTuple :ast n: xq79 dst: rtupC
                        if rtupC.length > 1 then {
                            rvoN: st.lookupVarId nameId: (nameIdOf
                                :ast
                                name: (rtupC.get i: 0).stringview
                            )
                            match (
                                rvoN
                            ) case some then {
                                xq69: ast.nodes.get i: call.callable.u64
                                rpidN: dottedParentNodeId :ast n: xq69
                                rvtN: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: rpidN.u64
                                if rvtN > 0 when (typeIsReftype
                                    :st
                                    tid: (ztypes.tid.create from: rvtN.u64)
                                ) then {
                                    xq59: ast.nodes.get i: call.callable.u64
                                    rmnN: dottedChildName :ast n: xq59
                                    shrN9: (isContainerReaderCall
                                        :ast
                                        :st
                                        recvTid: rvtN
                                        mname: rmnN.stringview
                                    )
                                    if (methodReceiverIsView :st mid: dro) then shrN9 = true
                                    (lockCallPath
                                        :st
                                        :ast
                                        pool: ast.names
                                        path: rtupC
                                        callId: call.nodeid.u64
                                        shared: shrN9
                                        nodeid: call.nodeid
                                        lineno: call.lineno
                                        colno: call.colno
                                    )
                                }
                            } case none then null
                        }
                    }
                    st.popTo marker: mcm
                    mres: ztypes.tid
                    mro: methodReturnOf :st mid: dro
                    match (
                        mro
                    ) case some then {
                        mres = mro
                        setmr: mres
