# The type checker. Every unit's top-level names are indexed into the Decl
# tree first; resolution then starts at the program's `main` and demands only
# what a reference reaches -- a definition resolves in the frame it was written
# in, a generic specialises through the arg-keyed trie under its template, and
# a body is walked (types, ownership, locks, narrowing, constants) only once
# its owner has resolved. Everything it decides is stamped into the ZTyping
# the caller hands in, beside the type registry; the emitter and the SQL dump
# read those and resolve nothing themselves.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :isFunctionDefWithBody
    :truthyCondArmOf
    :blockEndsInReturn
    :ccKindArm
    :targetIsHost
    :targetExeSuffix
    :targetTripleError
    :blockHasBreak
    :bodyEndsInReturn
    :builtinTidT
    :builtinTidTRo
    :dataFieldIds
    :dataFieldNames
    :descendNamed
    :fnReturnBaseNameOf
    :isBareGenericParam
    :isComparisonOp
    :isGenericParam
    :isListViewMember
    :isMoveMarker
    :isStringViewMember
    :isNumericTypeName
    :armSuffixSide
    :metaCreateBaseId
    :methodReturnOf
    :nodeId
    :nodeLine
    :optTidOr
    :optU64Or
    :paramIsThisReceiverId
    :declOfTypeId
    :declTypeIdOf
    :publicNsOf
    :declParentIdOf
    :declDeclaresUnit
    :declOfUnitDefIds
    :unitDeclOfName
    :unitDeclOfNameOrOwn
    :isUnitNameDecl
    :programUnitDecls
    :declNameIdOf
    :declMemberIsPrivate
    :publicAliasInternalNames
    :unitDeclOfTid
    :unitNameOfTid
    :resolveUnitChild
    :reexportTargetIdsOf
    :resolvedByIds
    :requiredLibs
    :rootNameOf
    :specLookup
    :sumSubtypeNames
    :typecheck
    :walkLookupTyperef
    :walkLookupTyperefById
    :walkLookupTyperefRo
    :walkLookupTyperefByIdRo
    :resolveUnitChildRo
    :resolvedByIdsRo
}

Node: zast.Node
Ast: zast.Ast
defaultval: ztyping.defaultval

# unitdefNodeId -- the nodeid of the unit row an id names (0 when the id does
# not name a unit). The row view is scoped to the fetch.
unitdefNodeId: function {ast: Ast.view nId: zast.nodeid} out zast.nodeid is {
    result: zast.nodeid
    {
        n: ast.nodes.get i: nId.u64
        if n.unitdef then result = n.nodeid
    }
    return result
}

# nodeId -- the nodeid of an arbitrary type-ref / definition Node. Covers the
# kinds a type expression or method def can take (atom / labelvalue / dotted /
# expression / call / functiondef); 0 otherwise (the stamp is then a no-op row
# the typed_nodes JOIN drops).
nodeId: function {n: Node.view} out zast.nodeid is {
    match (
        n
    ) case atomid then {
        return n.nodeid
    } case labelvalue then {
        return n.nodeid
    } case binop then {
        return n.nodeid
    } case dottedpath then {
        return n.nodeid
    } case expression then {
        return n.nodeid
    } case call then {
        return n.nodeid
    } case functiondef then {
        return n.nodeid
    } case assignment then {
        return n.nodeid
    } case reassignment then {
        return n.nodeid
    } else {
        return (zast.nodeid.create from: 0)
    }
}

# nodeLine / nodeCol -- the source position of node `n`.
nodeLine: function {n: Node.view} out u32 is {
    return (zast.posOf :n).line
}

nodeCol: function {n: Node.view} out u32 is {
    return (zast.posOf :n).col
}

# atomName -- the name of an atom Node (atomid / labelvalue) as an owned String,
# "" for anything else. Matching the Node param narrows it cleanly (the proven
# simple-param pattern), so callers pass a field/arg projection without worrying
# about path-subject narrowing.
atomName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } case labelvalue then {
        return (zast.nameTextCopy :ast ref: n.name)
    } else {
        return "".string
    }
}

# atomNameId -- the Ast.names pool id of an atomid/labelvalue node's name
# (0 when the node is neither; no pool id is 0, so lookups by it miss).
atomNameId: function {ast: Ast.view n: Node.view} out zast.nameid is {
    ast
    match (
        n
    ) case atomid then {
        return n.name
    } case labelvalue then {
        return n.name
    } else {
        return (zast.nameid.create from: 0)
    }
}

# addError -- append a typecheck diagnostic to the typing's error list,
# deduped by node position so a spec resolved more than once reports once.
# addResolveError -- a diagnostic raised from the resolution core, which
# holds no source node: location-free, deduped by message.
addResolveError: function {st: zenv.ZSymbolTable e: zast.err msg: String} is {
    dup: false
    with eit: st.typing.errors.iterate do for pe: eit loop {
        if pe.msg.stringView == msg.stringView then dup = true
    }
    if (dup) == false then {
        en: String
        eh: String
        st.typing.errors.append (zast.ErrorData
            nodeid: (zast.nodeid.create from: 0)
            lineno: 0
            colno: 0
            width: 1
            err: e
            msg: msg.copy
            fsno: zvfs.fsno
            note: en
            hint: eh
        )
        st.typing.isError = true
    }
}

# stampGate -- a body-walk node stamp that suppresses GENERIC_PARAM values
# during a generic template walk: the emitter re-walks the shared template
# AST per instance and must not see template-time param stamps.
stampGate: function {st: zenv.ZSymbolTable nid: u64 tid: ztypes.tid} is {
    if st.typing.curMonoStamp > 0 then {
        mtid: tid
        subo: st.typing.monoParamSubst.get key: tid
        match (
            subo
        ) case some then {
            mtid = ztypes.tid.create from: (subo)
        } case none then null
        mk: (ztyping.monostamp mono: st.typing.curMonoStamp node: nid)
        st.typing.monoNodeType.set key: mk value: mtid
        return
    }
    if st.typing.suppressParamStamps then {
        if (st.reg.typetypeOf typeId: tid) == ztypes.ztypetype.genericParam then return
    }
    ztyping.nodeTypeSet tbl: st.typing.nodeType :nid :tid
}

# stampBinopOp -- record which type DECLARES a binop's operator and which method
# the operator resolved to, so emission asks the resolution rather than the
# operator's spelling. Routed exactly as stampGate routes a type stamp: an
# instance walk writes the mono pair, keyed (monoId << 32 | nodeid) and
# substituted through the instance's type args, and a template walk's own
# generic-param answer is dropped because no template body is emitted. A `method` of 0 is the truthful record for an
# operator no declaration was found for -- a comparison that fell back to
# structural equality -- and the owner still stands.
stampBinopOp: function {
    st: zenv.ZSymbolTable
    nid: u64
    owner: ztypes.tid
    method: ztypes.tid
} is {
    if owner.isZero then return
    if st.typing.curMonoStamp > 0 then {
        mow: owner
        subo: st.typing.monoParamSubst.get key: owner
        match (
            subo
        ) case some then {
            mow = ztypes.tid.create from: (subo)
        } case none then null
        mk: (ztyping.monostamp mono: st.typing.curMonoStamp node: nid)
        st.typing.monoBinopOwner.set key: mk value: mow
        st.typing.monoBinopMethod.set key: mk value: method
        return
    }
    if st.typing.suppressParamStamps then {
        if (st.reg.typetypeOf typeId: owner) == ztypes.ztypetype.genericParam then return
    }
    st.typing.binopOwner.set key: nid value: owner
    st.typing.binopMethod.set key: nid value: method
}

# record a diagnostic (with a note/hint) into the typing tables.
addErrorH: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    e: zast.err
    msg: String
    note: String
    hint: String
    width: u32
} is {
    dup: false
    with it: st.typing.errors.iterate do for prev: it loop {
        if prev.nodeid == nodeid when prev.lineno == lineno when prev.colno == colno when prev.msg.stringView == msg.stringView then {
            dup = true
        }
    }
    if (dup) == false then {
        st.typing.errors.append (zast.ErrorData
            :nodeid
            :lineno
            :colno
            :width
            err: e
            msg: msg.copy
            fsno: zvfs.fsno
            note: note.copy
            hint: hint.copy
        )
        st.typing.isError = true
    }
}

# addResolveErrorH -- addErrorH for resolution-time callers that hold the
# ZTyping directly (no symbol table yet); same dedup, so re-entrant
# resolution passes report once.
addResolveErrorH: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    e: zast.err
    msg: String
    width: u32
} is {
    dup: false
    with it: st.typing.errors.iterate do for prev: it loop {
        if prev.nodeid == nodeid when prev.lineno == lineno when prev.colno == colno when prev.msg.stringView == msg.stringView then {
            dup = true
        }
    }
    if (dup) == false then {
        st.typing.errors.append (zast.ErrorData
            :nodeid
            :lineno
            :colno
            :width
            err: e
            msg: msg.copy
            fsno: zvfs.fsno
            note: "".string
            hint: "".string
        )
        st.typing.isError = true
    }
}

# record a diagnostic into the typing tables.
addError: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    e: zast.err
    msg: String
} is {
    en: String
    eh: String
    addErrorH :st :nodeid :lineno :colno :e :msg note: en hint: eh width: 1
}

# isBorrowedVar -- true when the variable id is bound BORROWED (a borrowed
# parameter or a genuine borrowed local).
isBorrowedVar: function {st: zenv.ZSymbolTable.view vid: ztypes.vid} out bool is {
    if (st.reg.hasVariable id: vid) == false then return false
    return (st.reg.variableOwnershipOf id: vid) == ztypes.zownership.borrowed
}

# isNumericTid -- a concrete integer/float type id (literal-coercion target).
# Reads the id's own name and confirms it against the single builtin that name
# spells. A builtin lookup resolves, so asking for all sixteen would mint every
# numeric type -- and in most programs nothing else reaches f128's unit.
isNumericTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    tid: ztypes.tid
} out bool is {
    if tid.isZero then return false
    if tid >= st.reg.typeById.length then return false
    tn: String
    {
        row: st.reg.typeById.get i: tid
        tn = row.name.copy
    }
    si: ztypes.numkindByName name: tn.stringView
    if (si.has) == false then return false
    return tid == (builtinTidT :st :frame :ast base: tn.stringView)
}

# isImplicitZeroCreateTid -- a bare type name in a runtime value position
# that constructs its zero/empty value with no arguments: the numeric
# scalars (zero) and String (empty). The stamp drives the emitter; the
# atom's nodeType stays the type id itself.
isImplicitZeroCreateTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    tid: ztypes.tid
} out bool is {
    if (isNumericTid :st frame: st.curFrame :ast :tid) then return true
    if tid == (builtinTidT :st frame: st.curFrame :ast base: "String") then return true
    return false
}

# bareCtorError -- one diagnostic for a bare type name in value position
# that cannot construct, with the shared teaching note.
bareCtorError: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u32
    msg: String
    hint: String
} is {
    nt: "a bare type name in value position is a zero-argument 'create' construction".string
    mc: msg.copy
    hc: hint.copy
    (addErrorH
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.callError
        msg: mc
        note: nt
        hint: hc
        :width
    )
}

# checkBareTypeConstruction -- a bare type name in a runtime value position
# is a zero-argument create construction. Records/classes stamp for the
# emitter when no required field remains (defaults and a body-carrying user
# create both satisfy) and report the missing fields otherwise; a typedef
# class over String is the empty string value. Families that cannot
# construct -- views, generic templates, unions/variants (an arm must be
# selected), protocols/facets, source-produced iterators, create-disabled
# types -- each get a targeted diagnostic.
checkBareTypeConstruction: function {
    st: zenv.ZSymbolTable
    ast: Ast
    node: atomref
    tid: ztypes.tid
} is {
    # the atom's width is read through a view scoped to this block: the
    # check below lends ast
    wdt: u32
    {
        cbW: zast.nameTextAt :ast ref: node.name
        wdt = cbW.length.u32.orPanic
    }
    (checkBareTypeValueAt
        :ast
        :st
        nodeid: node.nid
        lineno: node.lineno
        colno: node.colno
        width: wdt
        :tid
    )
}

# checkBareTypeValueAt -- checkBareTypeConstruction's core against explicit
# source coordinates, shared by the bare-atom and unit-qualified dotted legs.
checkBareTypeValueAt: function {
    ast: Ast
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u32
    tid: ztypes.tid
} is {
    tt: st.reg.typetypeOf typeId: tid
    isFam: false
    if tt == ztypes.ztypetype.recordType then isFam = true
    if tt == ztypes.ztypetype.classType then isFam = true
    if tt == ztypes.ztypetype.unionType then isFam = true
    if tt == ztypes.ztypetype.variantType then isFam = true
    if tt == ztypes.ztypetype.protocolType then isFam = true
    if tt == ztypes.ztypetype.facetType then isFam = true
    if (isFam) == false then return
    tn: st.reg.nameOf :tid
    # borrowed views -- including a typedef class over a view (PathView) --
    # bind from an owner and cannot be constructed
    isVw: isViewFamilyTid :ast :st :tid
    tdb: ztypes.tid
    if (isVw) == false then {
        tdb = typedefBaseOf :st :tid
        if tdb > 0 when (isViewFamilyTid
            :ast
            :st
            tid: (ztypes.tid.create from: tdb.u64)
        ) then isVw = true
    }
    if isVw then {
        mv: "cannot construct '\{tn}' from its bare name: a borrowed view binds from an owner"
        hv: "project the view from its owner ('.stringView', '.listView', '.substring')".string
        bareCtorError :st :nodeid :lineno :colno :width msg: mv hint: hv
        return
    }
    # a generic template has no concrete layout until its arguments apply
    isGen: false
    {
        isgeneric9v: st.reg.isGenericOf :tid
            if isgeneric9v then isGen = true
    }
    if isGen then {
        mg: "cannot construct '\{tn}' from its bare name: a generic type needs type arguments"
        hg: "apply type arguments first, e.g. '(ListVal t: u8)'".string
        bareCtorError :st :nodeid :lineno :colno :width msg: mg hint: hg
        return
    }
    # unions and variants select an arm; bool's arms are its literals
    isUV: false
    if tt == ztypes.ztypetype.unionType then isUV = true
    if tt == ztypes.ztypetype.variantType then isUV = true
    if isUV then {
        mu: "cannot construct '\{tn}' from its bare name: a union/variant selects an arm"
        hu: "construct an arm: '\{tn}.<arm> ...'"
        if tid == (builtinTidT :st frame: st.curFrame :ast base: "bool") then {
            hu = "write 'false' (the zero arm) or 'true'".string
        }
        bareCtorError :st :nodeid :lineno :colno :width msg: mu hint: hu
        return
    }
    isPF: false
    if tt == ztypes.ztypetype.protocolType then isPF = true
    if tt == ztypes.ztypetype.facetType then isPF = true
    if isPF then {
        mp: "cannot construct '\{tn}' from its bare name: a protocol/facet projects a conforming value"
        hp: "bind a value of a conforming type instead".string
        bareCtorError :st :nodeid :lineno :colno :width msg: mp hint: hp
        return
    }
    # a typedef class over String (Path) is the empty string value
    if tdb > 0 when tdb == (builtinTidT :st frame: st.curFrame :ast base: "String") then {
        ics: tid
        st.typing.implicitCreate.set key: nodeid.u64 value: ics
        return
    }
    # source-produced iterators have no standalone construction
    isIt: false
    if tid == (builtinTidT :st frame: st.curFrame :ast base: "CpIter") then isIt = true
    if tid == (builtinTidT :st frame: st.curFrame :ast base: "Splitter") then isIt = true
    if tid == (builtinTidT :st frame: st.curFrame :ast base: "LinesIter") then isIt = true
    if isIt then {
        mi: "cannot construct '\{tn}' from its bare name: iterators are produced by their source"
        hi: "call '.iterate' / '.split' / '.codepoints' / '.lines' on the source value".string
        bareCtorError :st :nodeid :lineno :colno :width msg: mi hint: hi
        return
    }
    (forceMemberOf :st frame: st.curFrame :ast parentTypeId: tid nameId: zast.names.wkCreate)
    crO: st.typing.declChildOfId parentTypeId: tid nameId: zast.names.wkCreate
    hasCr: false
    match (
        crO
    ) case some then {
        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: crO.u64)) == ztypes.ztypetype.functionType then hasCr = true
    } case none then null
    if (hasCr) == false then {
        mn0: "cannot construct '\{tn}' from its bare name: the type does not define construction (create: null)"
        hn0: "use the type's own factory functions".string
        bareCtorError :st :nodeid :lineno :colno :width msg: mn0 hint: hn0
        return
    }
    # the zero-argument spelling of self-construction: a bare type name (or
    # `T.create` with no arguments) in value position inside T's own create.
    if (ctorSelfRecursionAt :st :nodeid :lineno :colno :width ctorTid: tid) then return
    prov: (List String)
    misN: (List String)
    misI: (ListVal u64)
    (missingCtorFields
        :ast
        :st
        funcId: (ztypes.tid.create from: tid.u64)
        isCtor: true
        provided: prov
        posCount: 0
        missingNames: misN
        missingIds: misI
    )
    if misN.length == 0 then {
        icr: tid
        st.typing.implicitCreate.set key: nodeid.u64 value: icr
        return
    }
    lst: String
    li: u64
    ln: misN.length
    for li < ln loop {
        mn: misN.get i: li
        memberIdAt: misI.get i: li
        li = li + 1
        mtn: st.reg.nameOf tid: (ztypes.tid.create from: memberIdAt.u64)
        if lst.length > 0 then lst.append ", "
        ln1: "'\{mn}' (type: \{mtn})"
        lst.append ln1
    }
    m: "cannot construct '\{tn}' from its bare name: missing required arguments \{lst}"
    eh: "provide each listed argument ('\{tn} name: value ...') or add field defaults"
    bareCtorError :st :nodeid :lineno :colno :width msg: m hint: eh
}

# isViewFamilyTid -- a borrowed-view type: OptionView/ListView/MapEntry monos
# (generic-origin keyed) or the non-generic StringView/ByteView views. A view
# result is a borrow into its parent container/string: the binding holds a
# SHARED lock on the parent and the payload cannot be moved out.
isViewFamilyTid: function {ast: Ast st: zenv.ZSymbolTable tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    if tid == (builtinTidT :st frame: st.curFrame :ast base: "StringView") then return true
    if tid == (builtinTidT :st frame: st.curFrame :ast base: "ByteView") then return true
    vog: u64
    {
        vgo: st.reg.genericOriginOf :tid
        if vgo > 0 then vog = vgo
    }
    if vog == 0 then return false
    if vog == (builtinTidT :st frame: st.curFrame :ast base: "OptionView") then return true
    if vog == (builtinTidT :st frame: st.curFrame :ast base: "ListView") then return true
    if vog == (builtinTidT :st frame: st.curFrame :ast base: "ListViewVal") then return true
    if vog == (builtinTidT :st frame: st.curFrame :ast base: "MapEntry") then return true
    if vog == (builtinTidT :st frame: st.curFrame :ast base: "MapEntryRV") then return true
    if vog == (builtinTidT :st frame: st.curFrame :ast base: "MapEntryVR") then return true
    if vog == (builtinTidT :st frame: st.curFrame :ast base: "MapEntryVV") then return true
    return false
}

# methodReceiverIsView -- the method declares its receiver `.view`, so a call
# reads the receiver instead of writing it and the receiver lock is SHARED.
# Declared readonly-ness: unlike isContainerReaderCall it needs no name
# whitelist and works for user types.
methodReceiverIsView: function {st: zenv.ZSymbolTable.view mid: ztypes.tid} out bool is {
    rpn: st.reg.thisParamNameIdOf tid: mid
    if rpn.isZero then return false
    rpo: st.typing.declOwnershipOfId parentTypeId: mid nameId: (zast.nameid.create from: rpn.u32)
    match (
        rpo
    ) case some then {
        return rpo == ztypes.zparamownership.viewMode
    } case none then {
        return false
    }
}

# isContainerReaderCall -- the container methods whose receiver lock is
# SHARED but which cannot say so themselves. Everything a `.view` receiver
# can express has moved to the declarations (methodReceiverIsView, ORed in at
# every call site); what is left is what a marker cannot cover:
#
#   get / listView hand out a mutable interior pointer, so their C
#   refuses a const receiver and `.view` would let a caller write through an
#   alias obtained from a readonly receiver;
#   MapEntry.key / .value are projections through the entry pointer with no
#   method declaration to mark;
#   copy is the universal `.copy` marker, which resolves to no method either.
#
# Writers and user methods (opaque bodies) stay EXCLUSIVE.
# isContainerReaderCall -- the irreducible core. Every entry left here is one a
# DECLARATION cannot express, and the reason differs per entry:
#
#   Map.get / List.get / List.listView  hand back a MUTABLE interior
#     pointer (`_r.data = &_this->entries[idx].value`), so their C refuses
#     `const` and `.view` would hand a caller a writable alias out of a readonly
#     receiver. List.get write-back is load-bearing at 28 sites.
#   Map.copy / Set.copy / List.copy  are the synthesised `.copy` marker; the
#     containers declare no `copy` member to mark.
#
# The String arm is gone: `String.copy` was already declared `{t: this.view}`,
# and `String.stringView` now is, so `methodReceiverIsView` answers for both.
isContainerReaderCall: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    recvTid: u64
    mname: StringView
} out bool is {
    if recvTid == 0 then return false
    recvBaseTid: recvTid
    {
        rg: st.reg.genericOriginOf tid: (ztypes.tid.create from: recvTid.u64)
        if rg > 0 then recvBaseTid = rg
    }
    isMapB: false
    if recvBaseTid == (builtinTidTRo
        :st
        frame: st.curFrame
        :ast
        base: "MapRR"
    ) then isMapB = true
    if recvBaseTid == (builtinTidTRo
        :st
        frame: st.curFrame
        :ast
        base: "MapRV"
    ) then isMapB = true
    if recvBaseTid == (builtinTidTRo
        :st
        frame: st.curFrame
        :ast
        base: "MapVR"
    ) then isMapB = true
    if recvBaseTid == (builtinTidTRo
        :st
        frame: st.curFrame
        :ast
        base: "MapVV"
    ) then isMapB = true
    if isMapB then {
        if mname == "get" then return true
        if mname == "copy" then return true
        return false
    }
    isSetB: false
    if recvBaseTid == (builtinTidTRo
        :st
        frame: st.curFrame
        :ast
        base: "SetRef"
    ) then isSetB = true
    if recvBaseTid == (builtinTidTRo
        :st
        frame: st.curFrame
        :ast
        base: "SetVal"
    ) then isSetB = true
    if isSetB then {
        if mname == "copy" then return true
        return false
    }
    # BOTH List templates: they share one emitted `get`, so they share its
    # reason for being here -- a mutable interior pointer whose C refuses a
    # const receiver.
    isListB: false
    if recvBaseTid == (builtinTidTRo
        :st
        frame: st.curFrame
        :ast

        base: "ListRef"
    ) then isListB = true
    if recvBaseTid == (builtinTidTRo
        :st
        frame: st.curFrame
        :ast

        base: "ListVal"
    ) then isListB = true
    if isListB then {
        if mname == "get" then return true
        if (isListViewMember name: mname) then return true
        if mname == "copy" then return true
        return false
    }
    return false
}

# typesCompatible -- compare two type ids: identity, never (divergent) actual,
# generic-param pairs, literal/numeric coercion (intliteral/floatliteral -> concrete
# numerics), and an asymmetric typedef-base walk on `a`.
typesCompatible: function {
    ast: Ast
    st: zenv.ZSymbolTable
    a: ztypes.tid
    b: ztypes.tid
} out bool is {
    if a == b then return true
    if (st.reg.typetypeOf typeId: a) == ztypes.ztypetype.neverType then return true
    if (st.reg.typetypeOf typeId: a) == ztypes.ztypetype.genericParam when (st.reg.typetypeOf typeId: b) == ztypes.ztypetype.genericParam then {
        # Any two type parameters are template-compatible: params resolve to
        # canonical per-(template,param) tids and the per-instance clone
        # checks are the concrete backstop.
        return true
    }
    aLit: isLiteralTypeId :st tid: (ztypes.tid.create from: a.u64)
    bLit: isLiteralTypeId :st tid: (ztypes.tid.create from: b.u64)
    if aLit when bLit then return true
    if aLit then {
        if (isNumericTid
            :st
            frame: st.curFrame
            :ast

            tid: (ztypes.tid.create from: b.u64)
        ) then return true
    }
    if bLit then {
        if (isNumericTid
            :st
            frame: st.curFrame
            :ast

            tid: (ztypes.tid.create from: a.u64)
        ) then return true
    }
    cur: a
    for cur > 0 loop {
        nb: typedefBaseOf :st tid: (ztypes.tid.create from: cur.u64)
        if nb.isZero then {
            cur = ztypes.tid.create from: (0)
        } else {
            if nb.u64 == b then return true
            cur = nb
        }
    }
    return false
}

# byteOf -- the byte at index i (0 when out of range).
byteOf: function {s: StringView i: u64} out u8 is {
    bo: s.byteAt i
    match (
        bo
    ) case some then {
        return bo
    } case none then null
    return 0
}

# levenshtein -- byte-level edit distance (two-row DP), for did-you-mean.
levenshtein: function {a: StringView b: StringView} out u64 is {
    na: a.length
    nb: b.length
    if na == 0 then return nb
    if nb == 0 then return na
    prev: (ListVal u64)
    j0: u64
    for j0 <= nb loop {
        jv: j0
        prev.append jv
        j0 = j0 + 1
    }
    i: u64
    for i < na loop {
        cur: (ListVal u64)
        cur.append (i + 1)
        ab: byteOf s: a :i
        j: u64
        for j < nb loop {
            bb: byteOf s: b i: j
            cost: 1.u64
            if ab == bb then cost = 0
            delc: (prev.get i: (j + 1)) + 1
            insc: (cur.get i: j) + 1
            subc: (prev.get i: j) + cost
            best: delc
            if insc < best then best = insc
            if subc < best then best = subc
            cur.append best
            j = j + 1
        }
        prev = cur
        i = i + 1
    }
    return (prev.get i: nb)
}

# suggestSimilar -- the closest child name of parentTypeId to `name` (edit
# distance <= 2 and unique); "" if none. Powers the did-you-mean hint.
suggestSimilar: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    parentTypeId: ztypes.tid
    name: StringView
} out String is {
    best: String
    bestDist: 3.u64
    tied: false
    nms: (ListVal u64)
    tds: (ListVal u64)
    st.typing.declChildRows ownerTid: parentTypeId names: nms tids: tds
    ci: u64
    nameCount: nms.length
    for ci < nameCount loop {
        nid: nms.get i: ci
        ci = ci + 1
        cnB: ast.names.texts.get i: nid.u64
        cn: cnB.stringView
        if (cn == name) == false then {
            d: levenshtein a: name b: cn
            if d < bestDist then {
                best = cnB.copy
                bestDist = d
                tied = false
            } else {
                if d == bestDist then tied = true
            }
        }
    }
    if bestDist <= 2 when (tied) == false when best.length > 0 then return best
    return "".string
}

# indexUnitDefs -- pre-scan every unit's top-level definitions into a
# (unit.name) -> typetype index BEFORE resolution, so a reference can declare the
# ONE canonical record id (declare-before-bind) instead of an anonymous shell. No
# ids minted here. Dotted-path aliases and the null/never empty types keep their
# existing post-demand handling (defTypetypeOf returns none for them).
indexUnitDefs: function {st: zenv.ZSymbolTable frame: ztypes.declid program: Node} is {
    match (
        program
    ) case program then {
        uCnt9b: program.ast.units.length
        uIdx9b: u64
        for uIdx9b < uCnt9b loop {
            ruId: (zast.nodeid.create from: (program.ast.units.get i: uIdx9b))
            uIdx9b = uIdx9b + 1
            opId: zast.nodeid
            unmRef: u32
            {
                ru: program.ast.nodes.get i: ruId.u64
                if ru.namedoperation then {
                    opId = ru.operation
                    unmRef = ru.name
                }
            }
            if opId > 0 then {
                # registerUnitRoots minted the unit's TYPE and keyed it on the
                # unitdef node; the declaration binds to it here. Read by node,
                # not by name: the name lookup would find this very Decl, whose
                # type is what we are about to set. A unit with no type there
                # is a repeated unit name registerUnitRoots already rejected --
                # it gets no declaration, so the program root keeps one child
                # per name.
                utl: (st.typing.unitTypesById.get
                    key: (unitdefNodeId ast: program.ast nId: opId).u64
                )
                match (
                    utl
                ) case some then {
                    # a file unit is a NAMED child of the program root, which
                    # is what makes declFindChild(programRoot, name) the
                    # unit-root lookup. The root carries no unit-frame bit, so
                    # no bare-name walk reaches these children -- unitFrameOf
                    # climbs through it.
                    udid: (st.typing.declNew
                        name: unmRef
                        parent: st.typing.programRoot
                        kind: ztyping.declkind.unitDecl
                        node: ruId
                    )
                    st.typing.declSetUnitFrame declId: udid
                    st.typing.declSetType declId: udid typeId: utl
                    st.reg.setDef typeId: utl declId: udid
                    (indexUnitBody
                        :st
                        ast: program.ast
                        unitopId: opId
                        unitDeclId: udid
                    )
                } case none then null
            }
        }
        st.typing.defNodeIndexBuilt = true
        {
            cro: (st.typing.declFindChild
                parentDeclId: st.typing.programRoot
                nameId: (nameIdOf ast: program.ast name: "core")
            )
            if (cro.isZero) == false then st.typing.coreUnitRoot = cro
        }
        {
            clo: (st.typing.declFindChild
                parentDeclId: st.typing.programRoot
                nameId: (nameIdOf ast: program.ast name: "collections")
            )
            if (clo.isZero) == false then st.typing.collectionsUnitRoot = clo
            mro: (st.typing.declFindChild
                parentDeclId: st.typing.programRoot
                nameId: (zast.nameid.create from: st.reg.regMainUnitId.u32.orPanic)
            )
            if (mro.isZero) == false then st.typing.mainUnitRoot = mro
            # the fourth anchor is established here with the rest: every unit
            # the checker names outright is an id from this point on, and a
            # spelling never decides which one it meant
            sro: (st.typing.declFindChild
                parentDeclId: st.typing.programRoot
                nameId: (nameIdOf ast: program.ast name: "system")
            )
            if (sro.isZero) == false then st.typing.systemUnitRoot = sro
        }
        # pre-index mints (lowerGenerators' system pre-resolves) predate
        # the def index; link any still-unlinked named system def now
        cu: ztypes.tid
        cn9x: st.reg.nextTypeId
        for cu < cn9x loop {
            unl: false
            if (st.reg.defOf tid: cu).u64 == 0 then unl = true
            if unl then {
                cnm: st.reg.nameOf tid: (ztypes.tid.create from: cu.u64)
                if cnm.length > 0 then {
                    (linkDeclType
                        :st
                        :frame

                        ast: program.ast
                        unitDecl: st.typing.systemUnitRoot
                        name: cnm.stringView
                        tid: (ztypes.tid.create from: cu.u64)
                    )
                }
            }
            cu = ztypes.tid.create from: (cu + 1)
        }
    } else null
}

# indexUnitBody -- index one unit's top-level defs, in body order.
indexUnitBody: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitopId: u32
    unitDeclId: ztypes.declid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitopId
    {
        publicDeclId: ztypes.declid
        publicOpId: u32
        with bit: bodyIds.iterate do for bmId: bit loop {
            bm: argRefAt :ast nid: (zast.nodeid.create from: bmId.u32)
            if (bm.nid.isZero) == false then {
                ddid0: (indexDeclDef
                    :st
                    :ast
                    parentDeclId: unitDeclId
                    nameRef: bm.name
                    nopNodeId: bm.nid.u32
                    opNodeId: bm.operation.u32
                )
                if (zast.unitOpKindIs :ast opId: bm.operation.u32 k: zast.unitkind.publicNs) then {
                    publicDeclId = ddid0
                    publicOpId = bm.operation.u32
                }
            }
        }
        if (publicDeclId.isZero) == false then {
            (indexDeclPublicEntries
                :st
                :ast
                ownerDeclId: unitDeclId
                pubDeclId: publicDeclId
                pubOpId: publicOpId
            )
        }
    }
}

# indexDeclDef -- create the Decl for one definition (a namedoperation's
# name + operation) under parentDeclId, descending into the definition's
# own namespace (function params, object members, nested unit bodies).
# Returns the new DeclId.
indexDeclDef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    parentDeclId: ztypes.declid
    nameRef: zast.nameid
    nopNodeId: u32
    opNodeId: u32
} out ztypes.declid is {
    did0: ztypes.declid
    opNid: zast.nodeid.create from: opNodeId
    opArm: rowArmAt :ast nid: opNid
    match (
        opArm
    ) case datablock then {
        did0 = (st.typing.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.dataDecl
            node: nopNodeId
        )
        indexDeclDataInner :st :ast declId: did0 dataNodeId: opNodeId
    } case expression then {
        # unwrap: dispatch on the inner node, keep this def's name/node
        wrap: exprRefAt :ast nid: opNid
        return (indexDeclDef
            :st
            :ast
            :parentDeclId
            :nameRef
            :nopNodeId
            opNodeId: wrap.expression.u32
        )
    } case functiondef then {
        did0 = (st.typing.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.funcDecl
            node: nopNodeId
        )
        indexDeclFnInner :st :ast declId: did0 fnNodeId: opNodeId
    } case objectdef then {
        did0 = (st.typing.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.typeDecl
            node: nopNodeId
        )
        indexDeclObjInner :st :ast declId: did0 objNodeId: opNodeId
    } case unitdef then {
        if (zast.unitOpKindIs :ast opId: opNodeId k: zast.unitkind.publicNs) then {
            # the exported-namespace block: entries become name -> sibling
            # edges, filled by indexDeclPublicEntries after the unit walk.
            # Any block anywhere -- a nested unit's, a hidden subunit's --
            # restricts a surface, so the visibility check is armed.
            did0 = (st.typing.declNew
                name: nameRef
                parent: parentDeclId
                kind: ztyping.declkind.publicNs
                node: nopNodeId
            )
            st.typing.privacySeen = true
        } else {
            did0 = (st.typing.declNew
                name: nameRef
                parent: parentDeclId
                kind: ztyping.declkind.unitDecl
                node: nopNodeId
            )
            # a namespace, subunit or template is a lookup frame; a
            # `require:` block is not (its schema check runs in its unit)
            if (zast.unitOpDeclaresUnit
                :ast
                opId: opNodeId
            ) then st.typing.declSetUnitFrame declId: did0
            if (zast.unitOpKindIs
                :ast
                opId: opNodeId
                k: zast.unitkind.template
            ) then st.typing.declSetUnitFrame declId: did0
            npub: ztypes.declid
            npubOp: u32
            bodyIds: zast.unitBodyIdsAt :ast unitId: opNodeId
            with nbit: bodyIds.iterate do for nmId: nbit loop {
                nm: argRefAt :ast nid: (zast.nodeid.create from: nmId.u32)
                if (nm.nid.isZero) == false then {
                    nd: (indexDeclDef
                        :st
                        :ast
                        parentDeclId: did0
                        nameRef: nm.name
                        nopNodeId: nm.nid.u32
                        opNodeId: nm.operation.u32
                    )
                    if (zast.unitOpKindIs
                        :ast
                        opId: nm.operation.u32
                        k: zast.unitkind.publicNs
                    ) then {
                        npub = nd
                        npubOp = nm.operation.u32
                    }
                }
            }
            # a nested unit's `public:` block fills its namespace after the
            # body walk, as a file unit's does (entries name later siblings)
            if (npub.isZero) == false then {
                (indexDeclPublicEntries
                    :st
                    :ast
                    ownerDeclId: did0
                    pubDeclId: npub
                    pubOpId: npubOp
                )
            }
        }
    } case dottedpath then {
        # a cross-unit re-export alias: its own Decl and node; shares the
        # target's type id once minting routes through the Decl layer
        did0 = (st.typing.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.reexportDecl
            node: nopNodeId
        )
    } case atomid then {
        # a bare name aliases too (`Same: Holder`), exactly as the dotted form
        # does -- the target just lives in THIS unit, so the alias-follow reads
        # the enclosing unit for the missing segment. A numeric literal is the
        # unit-constant shape and keeps its constDecl.
        ar: atomRefAt :ast nid: opNid
        anm: zast.nameTextAt :ast ref: ar.name
        akind: ztyping.declkind.reexportDecl
        if (isNumericLiteralName name: anm.stringView) then akind = ztyping.declkind.constDecl
        did0 = (st.typing.declNew
            name: nameRef
            parent: parentDeclId
            kind: akind
            node: nopNodeId
        )
    } else {
        did0 = (st.typing.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.constDecl
            node: nopNodeId
        )
    }
    return did0
}

# indexDeclFnInner -- parameter and as-member Decls under a function
# declaration (parameters are in the tree: a navigable signature).
indexDeclFnInner: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    declId: ztypes.declid
    fnNodeId: u32
} is {
    fn: ast.nodes.get i: fnNodeId.u64
    match (
        fn
    ) case functiondef then {
        with pit: fn.parameters.iterate do for pId: pit loop {
            pn: ast.nodes.get i: pId.u64
            if pn.namedoperation then {
                (st.typing.declNew
                    name: pn.name
                    parent: declId
                    kind: ztyping.declkind.paramDecl
                    node: pn.nodeid
                )
            }
        }
        with ait: fn.asItems.iterate do for aId: ait loop {
            an: ast.nodes.get i: aId.u64
            if an.namedoperation then {
                (indexDeclAsMember
                    :st
                    :ast
                    parentDeclId: declId
                    nameRef: an.name
                    nopNodeId: an.nodeid
                    opNodeId: an.operation
                )
            }
        }
    } else null
}

# indexDeclDataInner -- member Decls under a data (enum) declaration: one arm
# per element, named the way resolveData names it, so an unnamed element
# takes its ordinal.
indexDeclDataInner: function {
    st: zenv.ZSymbolTable
    ast: Ast
    declId: ztypes.declid
    dataNodeId: u32
} is {
    nrefs: (ListVal u32)
    nodes: (ListVal u32)
    ords: (ListVal u64)
    {
        dn: ast.nodes.get i: dataNodeId.u64
        match (
            dn
        ) case datablock then {
            ord: u64
            with eit: dn.elements.iterate do for eId: eit loop {
                en: ast.nodes.get i: eId.u64
                if en.namedoperation then {
                    nrefs.append en.name
                    nodes.append en.nodeid
                    ords.append ord
                }
                ord = ord + 1
            }
        } else null
    }
    i: u64
    n: nrefs.length
    for i < n loop {
        nr: nrefs.get :i
        nd: nodes.get :i
        od: ords.get :i
        i = i + 1
        if nr == 0 then {
            ots: "\{od}"
            nr = ast.internString text: ots.stringView
        }
        (st.typing.declNew
            name: nr
            parent: declId
            kind: ztyping.declkind.armDecl
            node: nd
        )
    }
}

# indexDeclObjInner -- member Decls under a type declaration: is-block
# entries (fields; arms for variant/union kinds) and as-block members.
indexDeclObjInner: function {
    st: zenv.ZSymbolTable
    ast: Ast
    declId: ztypes.declid
    objNodeId: u32
} is {
    ob: objRefAt :ast nid: (zast.nodeid.create from: objNodeId)
    if (ob.nid.isZero) == false then {
        isArm: false
        if ob.kind.variantDef then isArm = true
        if ob.kind.unionDef then isArm = true
        kIit: u64
        for kIit < ob.nis loop {
            iId: (zast.objIsItemAt :ast nid: ob.nid i: kIit).u32
            kIit = kIit + 1
            itemNode: argRefAt :ast nid: (zast.nodeid.create from: iId.u32)
            if (itemNode.nid.isZero) == false then {
                if isArm then {
                    (st.typing.declNew
                        name: itemNode.name
                        parent: declId
                        kind: ztyping.declkind.armDecl
                        node: itemNode.nid.u32
                    )
                } else {
                    (indexDeclAsMember
                        :st
                        :ast
                        parentDeclId: declId
                        nameRef: itemNode.name
                        nopNodeId: itemNode.nid.u32
                        opNodeId: itemNode.operation.u32
                    )
                }
            }
        }
        publicDeclId: ztypes.declid
        publicOpId: u32
        kAit: u64
        for kAit < ob.nas loop {
            aId: (zast.objAsItemAt :ast nid: ob.nid i: kAit).u32
            kAit = kAit + 1
            an: argRefAt :ast nid: (zast.nodeid.create from: aId.u32)
            if (an.nid.isZero) == false then {
                if (zast.unitOpKindIs :ast opId: an.operation.u32 k: zast.unitkind.publicNs) then {
                    # the type's exported-namespace block: a publicNs Decl whose
                    # edges (public name -> internal member Decl) are filled after
                    # all members are indexed. Mirrors the unit `public:` block.
                    publicDeclId = (st.typing.declNew
                        name: an.name
                        parent: declId
                        kind: ztyping.declkind.publicNs
                        node: an.nid.u32
                    )
                    publicOpId = an.operation.u32
                } else {
                    (indexDeclAsMember
                        :st
                        :ast
                        parentDeclId: declId
                        nameRef: an.name
                        nopNodeId: an.nid.u32
                        opNodeId: an.operation.u32
                    )
                }
            }
        }
        if (publicDeclId.isZero) == false then {
            (indexDeclPublicEntries
                :st
                :ast
                ownerDeclId: declId
                pubDeclId: publicDeclId
                pubOpId: publicOpId
            )
        }
    }
}

# indexDeclAsMember -- one as-block member Decl: a method when the member
# is a function (with its own parameter Decls), a field-like entry
# otherwise (generic parameters, tag specs, member constants).
indexDeclAsMember: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    parentDeclId: ztypes.declid
    nameRef: zast.nameid
    nopNodeId: u32
    opNodeId: u32
} is {
    opNode: ast.nodes.get i: opNodeId.u64
    match (
        opNode
    ) case expression then {
        (indexDeclAsMember
            :st
            :ast
            :parentDeclId
            :nameRef
            :nopNodeId
            opNodeId: opNode.expression
        )
    } case functiondef then {
        md: (st.typing.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.methodDecl
            node: nopNodeId
        )
        indexDeclFnInner :st :ast declId: md fnNodeId: opNodeId
    } else {
        (st.typing.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.fieldDecl
            node: nopNodeId
        )
    }
}

# indexDeclPublicEntries -- fill a publicNs Decl's namespace. A `public:`
# block is a unit body: an entry that REFERENCES a sibling of the enclosing
# unit -- `:member`, or `alias: member` naming one -- becomes an exposed
# name -> sibling-declaration edge (no fresh row); any other entry is a
# DEFINITION of the block (a constant, a function, a type, an alias to a
# name outside the unit) and is indexed under the block like a nested
# unit's member. Runs after the unit's body walk so entries naming later
# siblings bind.
indexDeclPublicEntries: function {
    st: zenv.ZSymbolTable
    ast: Ast
    ownerDeclId: ztypes.declid
    pubDeclId: ztypes.declid
    pubOpId: u32
} is {
    # the block's arm and entries are read as plain values: the index walk
    # below lends ast
    isUnit: false
    {
        popArm: rowArmAt :ast nid: (zast.nodeid.create from: pubOpId)
        match (
            popArm
        ) case unitdef then {
            isUnit = true
        } else null
    }
    if isUnit then {
        bodyIds: zast.unitBodyIdsAt :ast unitId: pubOpId
        with bit: bodyIds.iterate do for mId: bit loop {
            m: argRefAt :ast nid: (zast.nodeid.create from: mId.u32)
            if (m.nid.isZero) == false then {
                # the entry's value row is read through a view scoped to this
                # block: the index walk below lends ast
                iref: m.name
                isRef: false
                isLabel: false
                {
                    mop: ast.nodes.get i: m.operation.u64
                    if mop.labelvalue then {
                        isRef = true
                        isLabel = true
                    }
                    if mop.atomid then {
                        iref = mop.name
                        isRef = true
                    }
                }
                tgt: ztypes.declid
                if isRef then tgt = st.typing.declFindChild parentDeclId: ownerDeclId nameId: iref
                if (tgt.isZero) == false then {
                    (st.typing.declAddChildEdge
                        parentDeclId: pubDeclId
                        nameId: m.name
                        childDeclId: tgt
                    )
                    # the entry's value node (`:m` labelvalue / `alias: m`
                    # atom) is a navigable reference to the sibling def
                    stampRefDecl :st nid: m.operation.u64 declId: tgt
                } else if isLabel == false then {
                    (indexDeclDef
                        :st
                        :ast
                        parentDeclId: pubDeclId
                        nameRef: m.name
                        nopNodeId: m.nid.u32
                        opNodeId: m.operation.u32
                    )
                }
            }
        }
    }
}

# linkDeclType -- record the canonical id on the indexed Decl and the Decl on
# the type, at the mint funnel. References that mint outside the def index (literal shells,
# forward names) find no Decl and no-op.
linkDeclType: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    frame: ztypes.declid
    name: StringView
    tid: ztypes.tid
} is {
    dko: declOfUnitDef :st :frame :unitDecl nameId: (nameIdOf :ast :name)
    if dko.u64 == 0 then return
    st.typing.declSetType declId: dko typeId: tid
    st.reg.setDef typeId: tid declId: dko
}

# defTypetypeOf -- the typetype a top-level definition node declares, mirroring
# resolveDef's dispatch. None for nodes that mint no canonical type here (dotted-
# path aliases, the null/never empty types, enums/generics in later slices).
defTypetypeOf: function {
    ast: Ast.view
    defn: Node.view
    name: StringView
} out optionval ztypes.ztypetype is {
    match (
        defn
    ) case functiondef then {
        return (optionval.some ztypes.ztypetype.functionType)
    } case expression then {
        return (defTypetypeOf :ast defn: (ast.nodes.get i: defn.expression.u64) :name)
    } case datablock then {
        return (optionval.some ztypes.ztypetype.dataType)
    } case objectdef then {
        match (
            defn.kind
        ) case recordDef then {
            # `null` and `never` parse as empty records but ARE their own
            # typetypes, which resolveNamedType and resolveDef already know.
            # Reporting none here left them "unclassified" alongside dotted
            # aliases, and an unclassified def resolves to tid 0 -- which is
            # why core's `null:`/`never:` re-exports never resolved and the
            # lookup chain's system probe had to answer for them.
            if name == "null" then return (optionval.some ztypes.ztypetype.nullType)
            if name == "never" then return (optionval.some ztypes.ztypetype.neverType)
            return (optionval.some ztypes.ztypetype.recordType)
        } case variantDef then {
            return (optionval.some ztypes.ztypetype.variantType)
        } case unionDef then {
            return (optionval.some ztypes.ztypetype.unionType)
        } case classDef then {
            return (optionval.some ztypes.ztypetype.classType)
        } case facetDef then {
            return (optionval.some ztypes.ztypetype.facetType)
        } case protocolDef then {
            return (optionval.some ztypes.ztypetype.protocolType)
        } else {
            return (optionval.none ztypes.ztypetype)
        }
    } else {
        return (optionval.none ztypes.ztypetype)
    }
}

# defsite -- where a name is defined: the unit to look it up in, and the
# re-export Decl that binds it when one does. Zero unit on a miss.
defsite: record {
    defUnit: ztypes.declid
    aliasDecl: ztypes.declid
}

# noDefSite -- the absent site.
noDefSite: function {} out defsite is {
    return (defsite
        defUnit: (ztypes.declid.create from: 0)
        aliasDecl: (ztypes.declid.create from: 0)
    )
}

# definingSiteFor -- the site that defines `name` for a reference in
# `unitDecl`: the environment walk over the unit's own frame, then the
# prelude, where a hit is a re-export and the defining unit is the one its
# dotted value names. The Decl the walk hit rides along because a re-export
# may RENAME its target -- `List: collections.ListRef` puts no `List` in
# `collections`, so the unit alone cannot resolve it and only the alias Decl
# knows what it stands for. An absent site means neither frame indexes the
# name (generic params, this/numerics, forward refs to a nonexistent type) --
# the caller then mints a shell exactly as before.
definingSiteFor: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
    frame: ztypes.declid
    name: StringView
} out defsite is {
    hit: (envLookup
        :st
        frame: (frameFor :st :frame :unitDecl)
        nameId: (zast.poolFind pool: ast.names text: name)
    )
    if hit.declId.isZero then return noDefSite
    if hit.frame == unitDecl then {
        return (defsite defUnit: unitDecl aliasDecl: (ztypes.declid.create from: 0))
    }
    ru: reexportUnitOf :st :ast declId: hit.declId
    if ru.isZero then return noDefSite
    return (defsite defUnit: (unitDeclOfName :st nameId: ru) aliasDecl: hit.declId)
}

# declareCanonicalType -- get-or-declare the ONE canonical id for `unit.name` as a
# childOf edge under its unit, linked to its Decl. The single convergence point for both a
# reference (resolveAtomType) and the definition (the resolveX resolvers): whoever
# runs first mints; the rest reuse the same id. Does NOT touch definedKeys (the
# body-resolved marker), so demanded bodies still resolve lazily.
declareCanonicalType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    # the type that owns this one when it is a member (`Type.method`), by
    # interned name id; 0 for a free definition. `name` is always the
    # definition's OWN name -- no qualified name is built, and none is parsed.
    ownerNameId: zast.nameid
    name: StringView
    typetype: ztypes.ztypetype
} out u64 is {
    qowner: u64
    # Inside a namespace unit, the enclosing type is a child of THAT unit, not
    # of the file unit -- the unit-name index only ever holds file units.
    nsF: nsFrameOf :st :frame :unitDecl
    nsT: declTypeIdOf :st declId: nsF
    if (ownerNameId.isZero) == false when (nsT.isZero) == false then {
        nso: st.typing.declChildOfId parentTypeId: nsT nameId: ownerNameId
        match (
            nso
        ) case some then {
            qowner = nso
        } case none then null
    }
    if (ownerNameId.isZero) == false when qowner == 0 then {
        cudq: (declTypeIdOf
            :st
            declId: unitDecl
        )
        if (cudq.isZero) == false then {
            (forceMemberOf
                :st
                :frame

                :ast
                parentTypeId: (ztypes.tid.create from: cudq.u64)
                nameId: ownerNameId
            )
            bo: (st.typing.declChildOfId
                parentTypeId: (ztypes.tid.create from: cudq.u64)
                nameId: ownerNameId
            )
            match (
                bo
            ) case some then {
                qowner = bo
            } case none then null
        }
    }
    # a free definition that is a member of the namespace is declared under
    # the namespace, not the file unit
    if ownerNameId.isZero when (nsT.isZero) == false then {
        nsm: (st.typing.declFindChild
            parentDeclId: nsF
            nameId: (zast.poolFind pool: ast.names text: name)
        )
        if (nsm.isZero) == false then qowner = nsT.u64
    }
    if qowner > 0 then {
        exq: (st.typing.declChildOf
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: qowner.u64)
            :name
        )
        match (
            exq
        ) case some then {
            return exq
        } case none then null
    }
    if ownerNameId.isZero when qowner == 0 then {
        cudm: (declTypeIdOf
            :st
            declId: unitDecl
        )
        if (cudm.isZero) == false then {
            exm: (st.typing.declChildOf
                pool: ast.names
                parentTypeId: (ztypes.tid.create from: cudm.u64)
                :name
            )
            match (
                exm
            ) case some then {
                linkDeclType :st :frame :ast :unitDecl :name tid: (ztypes.tid.create from: exm.u64)
                return exm
            } case none then null
        }
    }
    id: st.reg.newType :name ownerTid: qowner :typetype
    # valtype-ness is a property of the definition's KIND -- a record or a
    # variant is a valtype, a class or a union is not -- and is known here,
    # at declaration; a reference that reaches the declared id before its
    # definition resolves (a generic argument checked against `anyval`
    # while the target of a re-export is mid-resolution) must not read an
    # unset flag as "not a valtype". The definition's own resolution sets
    # the same value again.
    if typetype == ztypes.ztypetype.recordType then st.reg.setValtype typeId: id value: true
    if typetype == ztypes.ztypetype.variantType then st.reg.setValtype typeId: id value: true
    if qowner > 0 then {
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: qowner.u64)
            nameId: (ast.internString text: name)
            childTypeId: id
        )
    } else {
        if ownerNameId.isZero then {
            cud0: (declTypeIdOf
                :st
                declId: unitDecl
            )
            if (cud0.isZero) == false then {
                # declare the unit child before typing it. A synthesized name
                # (a mangled `Tmpl_fn`, a `tag__u8`) has no source def for
                # linkDeclType to find, so without this nothing declares it and
                # declChildOf cannot answer. declSynthMember no-ops when the
                # name is already declared.
                unid: (ast.internString text: name)
                ukk: ztyping.declkind.typeDecl
                if typetype == ztypes.ztypetype.functionType then ukk = ztyping.declkind.funcDecl
                (st.typing.declSynthMember
                    parentTypeId: (ztypes.tid.create from: cud0.u64)
                    nameId: unid
                    kind: ukk
                )
                (st.typing.setMemberType
                    parentTypeId: (ztypes.tid.create from: cud0.u64)
                    nameId: unid
                    childTypeId: id
                )
            }
        }
    }
    if ownerNameId.isZero then linkDeclType :st :frame :ast :unitDecl :name tid: id
    prxOk: false
    if (st.reg.defOf tid: id).u64 == 0 then prxOk = true
    if prxOk then {
        # a canonically-declared name with no source Decl (a synthesized
        # type like tag__u8): attribute it to the unit's root Decl
        if (unitDecl.isZero) == false then st.reg.setDef typeId: id declId: unitDecl
    }
    return id
}

# dottedDefTargetIds -- dottedDefTarget as an id pair: the parent atom's name
# id and the child's; an absent pair when the definition is not a dotted alias.
dottedDefTargetIds: function {ast: Ast.view n: Node.view} out ztypes.deftarget is {
    match (
        n
    ) case expression then {
        return (dottedDefTargetIds :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        pid: atomNameId :ast n: (ast.nodes.get i: n.parent.u64)
        cid: atomNameId :ast n: (ast.nodes.get i: n.child.u64)
        if pid.isZero then return ztypes.noDefTarget
        if cid.isZero then return ztypes.noDefTarget
        return (ztypes.deftarget unitName: pid defName: cid)
    } else {
        return ztypes.noDefTarget
    }
}

# bareDefTargetNameId -- the name id a BARE alias value names (`Same: Holder`),
# through any expression wrapper; the zero id when the value is not a bare
# name. The dotted twin is dottedDefTargetIds.
bareDefTargetNameId: function {ast: Ast.view n: Node.view} out zast.nameid is {
    match (
        n
    ) case expression then {
        return (bareDefTargetNameId :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        return n.name
    } else {
        return (zast.nameid.create from: 0)
    }
}

# resolveNamedType -- resolve a bare type NAME to its canonical id via the
# declare-before-bind index (definingUnitFor -> declareCanonicalType), minting a
# RECORD shell only for a numeric-literal default or an unresolved/forward name.
# `thisName` scopes the enclosing type's generic params. resolveAtomType aliases
# the self-type keywords `this`/`type` to the enclosing type name and calls here,
# so a native method's `:this` / `rhs: type` lands on the one canonical id, not a
# fresh shell.
resolveNamedType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    name: StringView
    thisName: StringView
    nid: 0.u64
} out u64 is {
    if name == "null" then {
        return (declareCanonicalType
            :st
            :frame
            :ast

            unitDecl: st.typing.systemUnitRoot
            ownerNameId: zast.nameid
            name: "null"
            typetype: ztypes.ztypetype.nullType
        )
    }
    if name == "never" then {
        return (declareCanonicalType
            :st
            :frame
            :ast

            unitDecl: st.typing.systemUnitRoot
            ownerNameId: zast.nameid
            name: "never"
            typetype: ztypes.ztypetype.neverType
        )
    }
    b0: name.byteAt 0.u64
    isnum: false
    match (
        b0
    ) case some then {
        if b0 >= 48 when b0 <= 57 then isnum = true
    } case none then null
    if isnum then {
        # A numeric-literal name types as the literal's DEFAULT scalar (system
        # i64/f64) -- it is not a name reference, so a unit-local scalar shadow
        # must not capture it. Pre-index (defNodeIndexBuilt false) keeps the
        # named-shell fallback.
        dn7: "i64"
        if name.contains "." then dn7 = "f64"
        sid7: (descendNamed
            :st
            :frame

            :ast
            unitDecl: st.typing.systemUnitRoot
            name: dn7
        )
        if sid7 > 0 then return sid7
        return (st.reg.newType name: dn7 typetype: ztypes.ztypetype.recordType)
    }
    if thisName.length > 0 then {
        etk7: declOfUnitDef :st :frame :unitDecl nameId: (nameIdOf :ast name: thisName)
        gpn7: nameIdOf :ast :name
        if (st.reg.isGenericParamOf tdecl: etk7 name: gpn7) then {
            recordGenericParamRef :st :nid frame: etk7 name: gpn7
            pgo7: st.reg.genericParamTidOf tdecl: etk7 paramName: gpn7
            match (
                pgo7
            ) case some then {
                return pgo7
            } case none then null
            ptid7: st.reg.newType :name typetype: ztypes.ztypetype.genericParam
            st.reg.setGenericParamTid tdecl: etk7 paramName: gpn7 tid: ptid7
            return ptid7
        }
    }
    site7: definingSiteFor :st :frame :ast :unitDecl :name
    duo7: site7.defUnit
    if (duo7.isZero) == false then {
        tto7: (optionval.none ztypes.ztypetype)
        dd7: declOfUnitDef :st :frame unitDecl: duo7 nameId: (nameIdOf :ast :name)
        if dd7 > 0 then tto7 = declDefTypetype :st :ast declId: dd7
        match (
            tto7
        ) case some then {
            did7: descendNamed :st :frame :ast unitDecl: duo7 :name
            if did7 > 0 then return did7
            return (declareCanonicalType
                :st
                :frame
                :ast

                unitDecl: duo7
                ownerNameId: zast.nameid
                :name
                typetype: tto7
            )
        } case none then {
            ex7: (resolvedByIds
                :st
                :ast
                unitDecl: duo7
                name: (zast.poolFind pool: ast.names text: name)
            )
            match (
                ex7
            ) case some then {
                return ex7
            } case none then null
            al7: resolveAliasKey :st :ast declId: dd7
            if al7 > 0 then return al7
            # `Strs: (List String)` names a TYPE through a call-shaped value.
            # It declares itself when READ, the same door a constant takes in
            # descendNamed -- a signature mentioning it may be resolved before
            # the pass that walks its definition.
            if (dd7.isZero) == false when (instantiatedAliasFold
                :ast
                :st
                declId: dd7
            ) then {
                it7: declTypeIdOf :st declId: dd7
                if (it7.isZero) == false then return it7.u64
            }
            # the alias RENAMES its target, so its own name is no member of the
            # target's unit and dd7 found nothing there. The Decl the
            # environment walk hit IS the binding; following it is what
            # resolveAliasKey is for.
            if (site7.aliasDecl.isZero) == false when dd7.isZero then {
                al8: resolveAliasKey :st :ast declId: site7.aliasDecl
                if al8 > 0 then return al8
            }
            return (st.reg.newType :name typetype: ztypes.ztypetype.recordType)
        }
    } else {
        # the environment before a shell: a name no unit-name index places
        # but the frame's chain reaches -- a template's generic
        # parameter in its own method signature (`v: t`), which is the
        # canonical GENERIC_PARAM id, not a forward record of that name
        e7: envTypeIdOf :st :frame nameId: (zast.poolFind pool: ast.names text: name)
        if e7 > 0 then return e7
        return (st.reg.newType :name typetype: ztypes.ztypetype.recordType)
    }
}

# resolveAtomType -- resolve a type-atom name in a method/param position. `this`
# and `type` alias the enclosing type (thisName); everything else is a plain name.
resolveAtomType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nm: StringView
    thisName: StringView
    nid: 0.u64
} out u64 is {
    if nm == "this" then {
        # the receiver's name is both the name and the receiver: the second
        # role reads an owned copy
        tnOwn: thisName.string
        return (resolveNamedType
            :st
            :frame
            :ast
            :unitDecl
            name: thisName
            thisName: tnOwn.stringView
        )
    }
    if nm == "type" then {
        if thisName.length != 0 then {
            tnOwnT: thisName.string
            return (resolveNamedType
                :st
                :frame
                :ast
                :unitDecl
                name: thisName
                thisName: tnOwnT.stringView
            )
        }
    }
    return (resolveNamedType :st :frame :ast :unitDecl name: nm :thisName :nid)
}

# parseDecimalU64 -- a decimal digit string as a u64 value; none when empty
# or any byte is not a digit (signs, radix prefixes, suffixed forms stay on
# the name-keyed path).
parseDecimalU64: function {text: StringView} out optionval u64 is {
    acc: u64
    i: u64
    any: false
    run: true
    for run loop {
        bo: text.byteAt i
        match (
            bo
        ) case some then {
            if bo >= 48 when bo <= 57 then {
                d: bo - 48
                acc = acc * 10 + d.u64
                any = true
            } else {
                any = false
                run = false
            }
        } case none then {
            run = false
        }
        i = i + 1
    }
    if any then return (optionval.some acc)
    return (optionval.none u64)
}

# isNumericTypeName -- the name of a builtin numeric scalar type.
# aliasedContainerTwin -- the DECLARATION name behind a container alias
# (`List` is declared `ListRef`), "" when the name is not one. The alias and
# its declaration share one canonical tid, so a lookup that missed under the
# alias retries under this.
aliasedContainerTwin: function {name: StringView} out StringView is {
    if name == "List" then return "ListRef"
    if name == "Set" then return "SetRef"
    if name == "Map" then return "MapRR"
    return ""
}

isNumericTypeName: function {name: StringView} out bool is {
    if name == "i8" then return true
    if name == "i16" then return true
    if name == "i32" then return true
    if name == "i64" then return true
    if name == "i128" then return true
    if name == "u8" then return true
    if name == "u16" then return true
    if name == "u32" then return true
    if name == "u64" then return true
    if name == "u128" then return true
    if name == "f16" then return true
    if name == "f32" then return true
    if name == "f64" then return true
    if name == "f128" then return true
    if name == "c8" then return true
    if name == "c32" then return true
    return false
}

# isNumericLiteralName -- true when a name begins with a digit or a minus: a
# numeric-literal atom (an `as`-block static constant like `version: 1`), as
# opposed to a type-name atom (a conformance marker). 48..57 are the ASCII
# digits, 45 the minus.
isNumericLiteralName: function {name: StringView} out bool is {
    b0: name.byteAt 0.u64
    match (
        b0
    ) case some then {
        if b0 >= 48 when b0 <= 57 then return true
        if b0 == 45 then {
            b1: name.byteAt 1.u64
            match (
                b1
            ) case some then {
                if b1 >= 48 when b1 <= 57 then return true
            } case none then null
        }
    } case none then null
    return false
}

# isNumericLiteralNameAt -- the same question asked of an interned name id.
# The text is read through a borrow scoped to the block, so a caller that wants
# only the answer copies nothing; a zero ref reads the sentinel empty text.
isNumericLiteralNameAt: function {ast: Ast.view ref: zast.nameid} out bool is {
    r9nl: false
    {
        t9nl: zast.nameTextAt :ast :ref
        r9nl = isNumericLiteralName name: t9nl.stringView
    }
    return r9nl
}

# markerText -- a field or parameter marker's source spelling, for diagnostics.
markerText: function {o: ztypes.zparamownership} out String is {
    match (
        o
    ) case noneMode then {
        return "".string
    } case takeMode then {
        return "take".string
    } case borrowMode then {
        return "borrow".string
    } case viewMode then {
        return "view".string
    } case holdMode then {
        return "hold".string
    } case takexMode then {
        return "takex".string
    }
}

# isStringViewMember / isListViewMember -- the view-conversion members, named
# once each so a reader changing the spelling has one place to change and the
# emitter, the checker and the linter cannot drift apart on it.
isStringViewMember: function {name: StringView} out bool is {
    if name == "stringView" then return true
    return false
}

# see isStringViewMember.
isListViewMember: function {name: StringView} out bool is {
    if name == "listView" then return true
    return false
}

# isMoveMarker -- a value-position ownership-transfer marker. `.hold` moves its
# source exactly as `.take` does; the two differ only in whether the destination
# is frozen afterwards.
isMoveMarker: function {name: StringView} out bool is {
    if name == "take" then return true
    if name == "hold" then return true
    return false
}

# isDropMarker -- the early-lifetime marker. A statement-only sibling of the
# move markers: it ends a lifetime and hands back nothing, where `.take` moves
# the value on. One predicate so the spelling lives in one place -- four
# hardcoded compares is how member-guard came to be watching a spelling that had
# moved.
isDropMarker: function {name: StringView} out bool is {
    return name == "drop"
}

# valueIsHold -- true when a bound value carries the `.hold` marker, through any
# `expression` wrapper. `hold` is owned and readonly, so the binding both moves
# the source away and freezes itself.
valueIsHold: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (valueIsHold :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        cnh: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: n.child.u64))
        return (cnh.stringView == "hold")
    } else {
        return false
    }
}

# isStripMarker -- true for a dotted-path leaf that is an ownership or access marker
# (`.lock`/`.borrow`/`.take`/`.private`/`.public`); a type reference peels these to
# reach the underlying base type.
isStripMarker: function {name: StringView} out bool is {
    if name == "lock" then return true
    if name == "borrow" then return true
    if name == "take" then return true
    if name == "view" then return true
    if name == "hold" then return true
    if name == "takex" then return true
    if name == "private" then return true
    if name == "public" then return true
    return false
}

# isLabelValue -- true when a node is a bare `:X` label-value (an anonymous
# conformance marker in an as-block parses as a namedoperation wrapping one).
isLabelValue: function {op: Node.view} out bool is {
    match (
        op
    ) case labelvalue then {
        return true
    } else {
        return false
    }
}

# nodeMentionsName -- whether a subtree references a bare name (atom reads,
# call callables, dotted bases). Drives the conformer-context gate: the
# reference's lazy resolution only reaches a conformer the main body names.
nodeMentionsName: function {ast: Ast.view n: Node.view name: StringView} out bool is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextEq :ast ref: n.name s: name)
    } case expression then {
        return (nodeMentionsName :ast n: (ast.nodes.get i: n.expression.u64) :name)
    } case dottedpath then {
        return (nodeMentionsName :ast n: (ast.nodes.get i: n.parent.u64) :name)
    } case call then {
        if (nodeMentionsName :ast n: (ast.nodes.get i: n.callable.u64) :name) then return true
        aiter: n.arguments.iterate
        for argId: aiter loop {
            arg: ast.nodes.get i: argId.u64
            match (
                arg
            ) case namedoperation then {
                if (nodeMentionsName
                    :ast
                    n: (ast.nodes.get i: arg.operation.u64)
                    :name
                ) then return true
            } else null
        }
        return false
    } case binop then {
        if (nodeMentionsName :ast n: (ast.nodes.get i: n.lhs.u64) :name) then return true
        return (nodeMentionsName :ast n: (ast.nodes.get i: n.rhs.u64) :name)
    } case statement then {
        siter: n.statements.iterate
        for smId: siter loop {
            if (nodeMentionsName :ast n: (ast.nodes.get i: smId.u64) :name) then return true
        }
        return false
    } case statementline then {
        sln: ast.nodes.get i: n.statementline.u64
        return (nodeMentionsName :ast n: sln :name)
    } case assignment then {
        return (nodeMentionsName :ast n: (ast.nodes.get i: n.value.u64) :name)
    } case reassignment then {
        return (nodeMentionsName :ast n: (ast.nodes.get i: n.value.u64) :name)
    } case caseexpr then {
        if (nodeMentionsName :ast n: (ast.nodes.get i: n.subject.u64) :name) then return true
        citer: n.clauses.iterate
        for cm: citer loop {
            if (nodeMentionsName :ast n: (ast.nodes.get i: cm.u64) :name) then return true
        }
        return false
    } case caseclause then {
        return (nodeMentionsName :ast n: (ast.nodes.get i: n.statement.u64) :name)
    } case ifexpr then {
        citer2: n.clauses.iterate
        for cm2Id: citer2 loop {
            if (nodeMentionsName :ast n: (ast.nodes.get i: cm2Id.u64) :name) then return true
        }
        return false
    } case forexpr then {
        return (nodeMentionsNameOptAt :ast oId: n.body :name)
    } case withexpr then {
        if (nodeMentionsName :ast n: (ast.nodes.get i: n.value.u64) :name) then return true
        return (nodeMentionsName :ast n: (ast.nodes.get i: n.body.u64) :name)
    } case doexpr then {
        return (nodeMentionsName :ast n: (ast.nodes.get i: n.statement.u64) :name)
    } else {
        return false
    }
}

# nodeMentionsNameOptAt -- nodeMentionsName over a table id (0 = absent).
nodeMentionsNameOptAt: function {ast: Ast.view oId: zast.nodeid name: StringView} out bool is {
    if oId.isZero then return false
    return (nodeMentionsName :ast n: (ast.nodes.get i: oId.u64) :name)
}

# fnBodyMentions -- nodeMentionsName over a function definition's body.
fnBodyMentions: function {ast: Ast.view op: Node.view name: StringView} out bool is {
    match (
        op
    ) case functiondef then {
        return (nodeMentionsNameOptAt :ast oId: op.body :name)
    } else {
        return false
    }
}

# recordConformerContexts -- pre-record each as-block marker target's first
# conforming type (body order) so a demand-resolved protocol binds its spec
# receiver to the conformer, whatever order the two resolve in.
recordConformerContexts: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    defName: StringView
    op: Node.view
} is {
    match (
        op
    ) case objectdef then {
        isRef: false
        if op.kind == zast.objectkind.classDef then isRef = true
        if op.kind == zast.objectkind.unionDef then isRef = true
        dk0: (zast.poolFind pool: ast.names text: defName).u64
        dv0: isRef
        st.typing.mainDefIsReftype.set key: dk0 value: dv0
        aiter: op.asItems.iterate
        for amId: aiter loop {
            am: ast.nodes.get i: amId.u64
            match (
                am
            ) case namedoperation then {
                cn: (zast.nameTextAt
                    :ast
                    ref: (atomNameId :ast n: (ast.nodes.get i: am.operation.u64))
                )
                skipIt: false
                if cn.length == 0 then skipIt = true
                if (isNumericLiteralName name: cn.stringView) then skipIt = true
                if (skipIt) == false then {
                    ro8: unitDecl
                    if (ro8.isZero) == false then {
                        md: (st.typing.declFindChild
                            parentDeclId: ro8
                            nameId: (zast.poolFind pool: ast.names text: cn.stringView)
                        )
                        (st.typing.declSetConformer
                            declId: md
                            nameId: dk0.u32.orPanic
                        )
                    }
                }
            } else null
        }
    } else null
}

# isBareGenericParam -- a generic-param definition in direct dotted form
# (`t: Any.generic`); wrapped shapes (a def whose payload merely contains a
# constraint) are not unit-level generic params.
isBareGenericParam: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case dottedpath then {
        leaf: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: op.child.u64))
        if leaf.stringView == "generic" then return true
        if leaf.stringView == "valtype" then return true
        if leaf.stringView == "reftype" then return true
        return false
    } else {
        return false
    }
}

# isGenericParam -- true when a type-expr is a generic-parameter constraint
# (`Any.generic` / `u64.generic` / `anyval.generic`): a dottedpath whose leaf is
# `generic` or `valtype`, peeling an `expression` / parameterized `call` wrapper.
isGenericParam: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case expression then {
        return (isGenericParam :ast op: (ast.nodes.get i: op.expression.u64))
    } case call then {
        return (isGenericParam :ast op: (ast.nodes.get i: op.callable.u64))
    } case dottedpath then {
        leaf: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: op.child.u64))
        if leaf.stringView == "generic" then return true
        if leaf.stringView == "valtype" then return true
        if leaf.stringView == "reftype" then return true
        return false
    } else {
        return false
    }
}

# declOfFnDef -- the Decl of a resolved function definition: a free
# function's unit child, or a method's member Decl under its owner (the
# defName arrives owner-composed -- "u8.+" -- and the owner may be the
# DECLARING protocol rather than thisName, so the owner splits at the
# composed name's last dot). 0 when unindexed (synthesized functions).
declOfFnDef: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
    frame: ztypes.declid
    ownerNameId: zast.nameid
    defName: StringView
    thisName: StringView
} out ztypes.declid is {
    if thisName.length == 0 then return (declOfUnitDef
        :st
        :frame
        :unitDecl
        nameId: (nameIdOf :ast name: defName)
    )
    mown: declOfUnitDef :st :frame :unitDecl nameId: (nameIdOf :ast name: thisName)
    mnm: defName
    if (ownerNameId.isZero) == false then {
        if (zast.poolTextEq
            pool: ast.names
            ref: (zast.nameid.create from: ownerNameId.u32)
            s: thisName
        ) == false then {
            malt: (declOfUnitDef
                :st
                :frame
                :unitDecl
                nameId: (zast.nameid.create from: ownerNameId.u32)
            )
            if (malt.isZero) == false then mown = malt
        }
    }
    if mown.u64 == 0 then return (ztypes.declid.create from: 0)
    return (st.typing.declFindChild
        parentDeclId: mown
        nameId: (zast.poolFind pool: ast.names text: mnm)
    )
}

# recordGenericParamRef -- note that node `nid` spells the generic parameter
# `name` of the template `frame`, for stampGenericParams to resolve once at the
# end. Recording only: a generic parameter lives outside the name-resolution
# table, so making one a real type-ref here would bind a user type that merely
# shares its name, and the stamp would reach emission.
recordGenericParamRef: function {
    st: zenv.ZSymbolTable
    nid: u64
    frame: ztypes.declid
    name: zast.nameid
} is {
    if nid == 0 then return
    if frame.isZero then return
    if name.isZero then return
    st.typing.genericParamName.set key: nid value: name
    st.typing.genericParamFrame.set key: nid value: frame
}

# registerGenericParams -- record a type's generic-param names (keyed by
# the template's DeclId) so method-param resolution can drop params typed by them.
# registerGenericParamOne -- record one member's generic-param declaration.
registerGenericParamOne: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    tdecl: ztypes.declid
    m: Node.view
} is {
    match (
        m
    ) case namedoperation then {
        if (isGenericParam :ast op: (ast.nodes.get i: m.operation.u64)) then {
            cb: genericConstraintBase :ast n: (ast.nodes.get i: m.operation.u64)
            ckx: genericConstraintKind :ast n: (ast.nodes.get i: m.operation.u64)
            cf9x: cb.copy
            if ckx.length > 0 then cf9x = "\{cb}.\{ckx}"
            k: constraintKindFor text: cf9x.stringView
            mx: (optionval.none u64)
            if k == ztypes.constraintkind.numeric then {
                mx = constraintNumericMax cv: cf9x.stringView
            }
            st.reg.addGenericParam :tdecl paramName: m.name kind: k numericMax: mx
            # the BOUND names a real declaration -- `anyval`, a protocol -- but
            # everything above reads it as TEXT and maps it to a constraint kind,
            # because that is all the compiler needs from it. Nothing then stamps
            # the atom that SPELLS it, so an editor asking what `anyval` is in
            # `t: anyval.generic` had no answer while the same name in a return
            # type had one. Recorded here and resolved at the end, for TOOLING
            # only: this must not resolve as a type-ref, or a retired bound would
            # start reporting an unknown type and the stamp would reach emission.
            bnid9: u64
            {
                op9: ast.nodes.get i: m.operation.u64
                match (
                    op9
                ) case dottedpath then {
                    pn9: ast.nodes.get i: op9.parent.u64
                    bnid9 = (nodeId n: pn9).u64
                } else null
            }
            if bnid9 > 0 then {
                st.typing.genericBoundName.set key: bnid9 value: (nameIdOf :ast name: cb.stringView)
                st.typing.genericBoundFrame.set key: bnid9 value: tdecl
            }
            # and the parameter itself, keyed to the OPERATION node -- what
            # Spans keys a declaration's own row to.
            recordGenericParamRef :st nid: m.operation.u64 frame: tdecl name: m.name
        }
    } else null
}

# genericConstraintKind -- the value-kind leaf of a constraint declaration
# (`Any.valtype` -> "valtype", `Any.reftype` -> "reftype"), "" for plain
# `.generic` bounds.
genericConstraintKind: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (genericConstraintKind :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        nameCount: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: n.child.u64))
        if nameCount.stringView == "valtype" then return nameCount
        if nameCount.stringView == "reftype" then return nameCount
        return "".string
    } else {
        return "".string
    }
}

# genericConstraintBase -- the constraint name of a `u64.generic`-style param
# declaration (the dotted parent), "" otherwise.
genericConstraintBase: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (genericConstraintBase :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        return (atomName :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return "".string
    }
}

# hasGenericParam -- true when any item in the block is a generic-param declaration.
# Takes the list by value so its iterator's lock is released on return (the scan is
# sequenced before any persistent iterator over the same list).
# hasGenericParam / registerGenericParams -- id-list flavors for
# converted unit bodies (declaration lists stay embedded until S4).
hasGenericParam: function {ast: Ast.view items: (ListVal u32).view} out bool is {
    return (zast.itemsHaveGenericParam :ast :items)
}

# register a template's generic parameters, classifying each constraint.
registerGenericParams: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    tdecl: ztypes.declid
    items: (ListVal u32).view
} is {
    ri: u64
    rn: items.length
    for ri < rn loop {
        rid: items.get i: ri
        rm: ast.nodes.get i: rid.u64
        registerGenericParamOne :st :ast :tdecl m: rm
        ri = ri + 1
    }
}

# unitDefIsGeneric -- a unit definition is generic when its body declares a generic
# param. Mirrors objectdefIsGeneric; gates dep-signature-stamp suppression off generic
# units, whose template signatures resolve differently.
unitDefIsGeneric: function {ast: Ast.view oId: zast.nodeid} out bool is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: oId
    return (hasGenericParam :ast items: bodyIds)
}

# pathOwnership -- the ownership a param/field/return type expr declares via a
# dotted-path marker leaf, or none. Fields take the non-owned markers (which make
# the slot static) or `take`/`hold`; params take any of the four grid markers;
# `takex` is a RETURN marker only.
pathOwnership: function {ast: Ast.view n: Node.view} out optionval ztypes.zparamownership is {
    match (
        n
    ) case dottedpath then {
        cn: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: n.child.u64))
        # `.lock` is a second spelling of `borrow`: the grid has one
        # non-owned-and-mutable concept, and both words parse to it.
        if cn.stringView == "lock" then return (optionval.some ztypes.zparamownership.borrowMode)
        if cn.stringView == "borrow" then return (optionval.some ztypes.zparamownership.borrowMode)
        if cn.stringView == "take" then return (optionval.some ztypes.zparamownership.takeMode)
        if cn.stringView == "view" then return (optionval.some ztypes.zparamownership.viewMode)
        if cn.stringView == "hold" then return (optionval.some ztypes.zparamownership.holdMode)
        if cn.stringView == "takex" then return (optionval.some ztypes.zparamownership.takexMode)
        return (optionval.none ztypes.zparamownership)
    } else {
        return (optionval.none ztypes.zparamownership)
    }
}

# baseTypeName -- the underlying base type name of a type expr, peeling `.lock`/
# `.private`/etc. dotted-path markers (`Container.private.lock` -> `Container`,
# `this.lock` -> `this`); the atom name for a bare atom; "" otherwise.
baseTypeName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } case labelvalue then {
        return (zast.nameTextCopy :ast ref: n.name)
    } case dottedpath then {
        cn: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: n.child.u64))
        if (isStripMarker name: cn.stringView) then {
            return (baseTypeName :ast n: (ast.nodes.get i: n.parent.u64))
        } else {
            return "".string
        }
    } else {
        return "".string
    }
}

# genericApplHead -- the head type name of a generic application `(List of: T)` /
# `(Option t: T)` (the callable's atom name); "" for a non-application expr.
genericApplHead: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (genericApplHead :ast n: (ast.nodes.get i: n.expression.u64))
    } case call then {
        return (atomName :ast n: (ast.nodes.get i: n.callable.u64))
    } else {
        return "".string
    }
}

# fieldHeadName -- a field type's head name: baseTypeName, falling back to the
# generic-application head so a `(List of: Node)` / `(Option t: Node)` field is
# recognized (List/Option) for the destructor-cleanup decision.
fieldHeadName: function {ast: Ast.view n: Node.view} out String is {
    b: baseTypeName :ast :n
    if b.length > 0 then return b
    return (genericApplHead :ast :n)
}

# resolveTyperefShell -- register a SHALLOW named shell for a referenced type
# (e.g. the `i64` in `n: i64`), routing atom names through resolveAtomType so
# `this`/numeric-default atoms resolve correctly. A parenthesized parameterized
# type `(T arg: N)` (an expression wrapping a call) mangles to a `T_N` shell.
# Source-type rows never include these shells (they fall outside `defined_in_unit`),
# but a `type_children` row joins to the shell's name. Returns the shell's type id.
recordNodeName: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    name: StringView
    nid: u64
    frame: ztypes.declid
} is {
    if name.length != 0 then {
        kc: nid
        st.typing.pendingTyperef.set key: kc value: (nameIdOf :ast :name)
        kc3: nid
        st.typing.pendingTyperefFrame.set key: kc3 value: frame
    }
}

# recordResolvedName -- record (nid -> name) for post-demand resolution; the `this` and
# `type` self-keywords record as the enclosing type (thisName).
# stampNestedTyperef -- a qualified type reference into a NESTED unit
# (`out sub.T`) names a member exactly as a cross-unit reference does, but it
# cannot be recorded as a pending typeref: that carries a (unit NAME, member
# name) pair, and a nested unit has no name-index entry to be found by. So it
# resolves here and stamps the node itself. Recorded by nothing, such a
# reference reached no resolver at all and its slot typed as null.
stampNestedTyperef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    unitId: zast.nameid
    memberId: zast.nameid
    nid: zast.nodeid
} is {
    if unitId.isZero then return
    if memberId.isZero then return
    root: ztypes.declid
    {
        ro: unitDecl
        if (ro.isZero) == false then root = ro
    }
    if root.isZero then return
    mt: (nestedUnitMemberTid
        :st
        :frame

        :ast
        ownerDeclId: root
        nestedNameId: unitId
        defName: memberId
    )
    if mt.isZero then return
    ztyping.nodeTypeSet tbl: st.typing.nodeType nid: nid.u64 tid: mt
}

recordResolvedName: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    frame: ztypes.declid
    thisName: StringView
    name: StringView
    nid: u64
    recFrame: ztypes.declid
} is {
    if name == "this" then {
        recordNodeName :ast :st name: thisName :nid frame: recFrame
    } else {
        if name == "type" then {
            recordNodeName :ast :st name: thisName :nid frame: recFrame
        } else {
            if (isNumericLiteralName :name) then {
                if name.contains "." then {
                    recordNodeName :ast :st name: "f64" :nid frame: recFrame
                } else {
                    recordNodeName :ast :st name: "i64" :nid frame: recFrame
                }
            } else {
                # a template's own param name still RECORDS (the pending
                # map feeds mono substitution) but never name-resolves: mark
                # it no-stamp so resolution doesn't chase or report it
                gskip: false
                gpnr: nameIdOf :ast :name
                if thisName.length > 0 then {
                    enclK: declOfUnitDef :st :frame :unitDecl nameId: (nameIdOf :ast name: thisName)
                    if (st.reg.isGenericParamOf tdecl: enclK name: gpnr) then gskip = true
                }
                if gskip == false when st.typing.sigGenericDecl > 0 then {
                    if (st.reg.isGenericParamOf
                        tdecl: st.typing.sigGenericDecl
                        name: gpnr
                    ) then gskip = true
                }
                recordNodeName :ast :st :name :nid frame: recFrame
                if gskip then {
                    nsg: nid
                    nsv: true
                    st.typing.noStampNode.set key: nsg value: nsv
                }
            }
        }
    }
}

# monoArgName -- a pending-instantiation argument's recorded name: `this` and
# `type` map to the enclosing type (the recordResolvedName mapping); "" when
# there is no enclosing type.
monoArgName: function {an: StringView thisName: StringView} out String is {
    if an == "this" then return thisName.string
    if an == "type" then return thisName.string
    return an.string
}

# resolveDottedArgTid -- a unit-qualified dotted generic argument
# (ztypes.zlockstate): descend the member in its defining unit. Marker /
# non-unit dotted shapes resolve 0 (the caller skips the record).
resolveDottedArgTid: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    nid: zast.nodeid
} out u64 is {
    dr: dpRefAt :ast :nid
    if dr.nid.isZero then return 0
    # owned copies: the walks below lend ast
    pq: zast.nameTextCopy :ast ref: (atomNameId :ast n: (ast.nodes.get i: dr.parent.u64))
    cq: zast.nameTextCopy :ast ref: (atomNameId :ast n: (ast.nodes.get i: dr.child.u64))
    if pq.length > 0 when cq.length > 0 then {
        pqId: atomNameId :ast n: (ast.nodes.get i: dr.parent.u64)
        if (nameDenotesUnit :frame :st nameId: pqId) then {
            ud: unitDeclOfNameOrOwn :st :frame nameId: pqId
            return (descendNamed :st :frame :ast unitDecl: ud name: cq.stringView)
        }
    }
    return 0
}


# resolveMonoRefInline -- resolve a call-shaped parameterized type ref at the
# point it is recorded: resolve the template and every argument now (nested
# parameterized args recurse; the descent pulls unresolved defs), then dedup /
# materialize through getOrMintSpec and stamp the wrapper node. Numeric size
# literals join the instance name only (const values, not type refs). Returns
# 0 -- recording nothing -- when the callable is empty or any argument is
# unresolvable (a template-internal generic-param name stays a shell).
resolveMonoRefInline: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    thisName: StringView
    enclDecl: ztypes.declid
    opNid: zast.nodeid
    nid: u32
} out u64 is {
    # the row is read through a view scoped to this block (1 expression,
    # 2 call, 0 anything else): the resolution below lends ast exclusively
    arm: u32
    innerId: zast.nodeid
    callableId: zast.nodeid
    argIds: (ListVal u32)
    {
        op: ast.nodes.get i: opNid.u64
        match (
            op
        ) case expression then {
            arm = 1
            innerId = op.expression
        } case call then {
            arm = 2
            callableId = op.callable
            with ait: op.arguments.iterate do for a: ait loop argIds.append from: a
        } else null
    }
    if arm == 1 then {
        return (resolveMonoRefInline
            :st
            :frame
            :ast
            :unitDecl
            :thisName
            :enclDecl
            opNid: innerId
            :nid
        )
    }
    if arm == 2 then {
        return (resolveMonoRefParts
            :st
            :frame

            :ast
            :unitDecl
            :thisName
            :enclDecl
            callableNid: callableId
            arguments: argIds
            :nid
        )
    }
    return 0
}
# monoRefArgTid -- resolve one mono type-reference argument to a tid. An unlabelled
# argument is a dotted type-ref; a labelled one names a type in the enclosing
# declaration's scope, its own unit, or a builtin. 0 with okOut false when it
# names nothing resolvable.
monoRefArgTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    thisName: StringView
    enclDecl: ztypes.declid
    arg: argref
    an: StringView
    okOut: (ListVal bool)
} out ztypes.tid is {
    aid: ztypes.tid
    allOk: true
    if an.length == 0 then {
        aid = ztypes.tid.create from: (resolveDottedArgTid :st :frame :ast nid: arg.operation)
        if aid.isZero then {
            inner: (resolveMonoRefInline
                :st
                :frame

                :ast
                :unitDecl
                :thisName
                :enclDecl
                opNid: arg.operation
                nid: 0
            )
            if inner > 0 then {
                aid = ztypes.tid.create from: (inner)
            } else {
                allOk = false
            }
        }
    } else {
        anc: monoArgName :an :thisName
        if anc.length == 0 then {
            allOk = false
        } else {
            if enclDecl > 0 when (st.reg.isGenericParamOf
                tdecl: enclDecl
                name: (nameIdOf :ast name: anc.stringView)
            ) then {
                (recordGenericParamRef
                    :st
                    nid: arg.operation.u64
                    frame: enclDecl
                    name: (nameIdOf :ast name: anc.stringView)
                )
                epo: (st.reg.genericParamTidOf
                    tdecl: enclDecl
                    paramName: (nameIdOf :ast name: anc.stringView)
                )
                match (
                    epo
                ) case some then {
                    aid = ztypes.tid.create from: (epo)
                } case none then {
                    aid = (st.reg.newType
                        name: anc.stringView
                        typetype: ztypes.ztypetype.genericParam
                    )
                    (st.reg.setGenericParamTid
                        tdecl: enclDecl
                        paramName: (nameIdOf :ast name: anc.stringView)
                        tid: aid
                    )
                }
            }
            # a name the CURRENT unit defines wins even when
            # not yet declared -- the ladder walk sees only
            # declared defs and would fall through to a
            # same-named stdlib type (resolveAtomType's rule)
            duo: (definingSiteFor
                :st
                :frame
                :ast
                :unitDecl
                name: anc.stringView
            ).defUnit
            if aid.isZero when duo == unitDecl then {
                aid = (descendNamed
                    :st
                    :frame

                    :ast
                    unitDecl: duo
                    name: anc.stringView
                )
            }
            if aid.isZero then {
                ao: (walkLookupTyperef
                    :st
                    :frame
                    :ast

                    :unitDecl
                    base: anc.stringView
                )
                aid = ztypes.tid.create from: (optU64Or o: ao d: 0)
            }
            if aid.isZero then {
                if (duo.isZero) == false then {
                    aid = (descendNamed
                        :st
                        :frame

                        :ast
                        unitDecl: duo
                        name: anc.stringView
                    )
                }
            }
            if aid.isZero then allOk = false
        }
    }
    okOut.append allOk
    return aid
}

# collectMonoRefArgs -- read a mono type-reference's arguments into the type and
# value substitutions, building the mangled suffix that names the instance.
# Answers false when an argument names nothing resolvable.
collectMonoRefArgs: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    thisName: StringView
    enclDecl: ztypes.declid
    arguments: (ListVal u32).view
    sfx: String
    typeSubs: (IdMapV zast.nameid v: u64)
    valSubsR: (IdMapV zast.nameid v: u64)
    firstOut: (ListVal u64)
} out bool is {
    allOk: true
    firstA: ztypes.tid
    aiter: arguments.iterate
    for arg9Id: aiter loop {
        arg: argRefAt :ast nid: (zast.nodeid.create from: arg9Id.u32)
        if (arg.nid.isZero) == false then {
            an: atomName :ast n: (ast.nodes.get i: arg.operation.u64)
            if (isNumericLiteralName name: an.stringView) then {
                sfx.append s: "_"
                sfx.append s: an
                pdv: parseDecimalU64 text: an.stringView
                match (
                    pdv
                ) case some then {
                    vsv: pdv
                    valSubsR.set key: arg.name value: vsv
                } case none then null
            } else {
                okOut: (ListVal bool)
                aid: (monoRefArgTid
                    :st
                    :ast
                    :unitDecl
                    :frame
                    :thisName
                    :enclDecl
                    :arg
                    an: an.stringView
                    :okOut
                )
                if (okOut.get i: 0) == false then allOk = false
                if aid > 0 then {
                    sfx.append s: "_"
                    vn: monoValName :st :frame :ast tid: (ztypes.tid.create from: aid.u64)
                    sfx.append s: vn
                    if firstA.isZero then firstA = aid
                    sv: aid
                    typeSubs.set key: arg.name value: sv
                }
            }
        }
    }
    firstOut.append firstA.u64
    return allOk
}


# validateMonoRefLabels -- reject a label that names no generic parameter of the
# template, at a TYPE REFERENCE rather than a construction. The construction
# path has validateGenericTypeArgs; a field type, a return type, a parameter
# type and a nested type argument reach a mono through here instead, and an
# unlabelled fallback there is not harmless: collectMonoRefArgs keys the
# substitution by whatever the label says, so a wrong one mints a SECOND mono
# that prints under the same name as the right one -- the "expected X, got X"
# mismatch. Shares reportBadGenericArgLabel so there is one message and one set
# of exemptions. Silent while the template has no registered parameters: this
# runs on the shell path too, before registration has necessarily happened.
validateMonoRefLabels: function {
    ast: Ast
    st: zenv.ZSymbolTable
    arguments: (ListVal u32).view
    tplId: ztypes.tid
} is {
    tk: declOfTypeId :st tid: tplId
    pnames: st.reg.genericParamNamesOf tdecl: tk
    if pnames.length == 0 then return
    tname: st.reg.nameOf tid: tplId
    if tname.length == 0 then return
    childNames: (ListVal zast.nameid)
    {
        mrN: (ListVal u64)
        mrT: (ListVal u64)
        st.typing.declChildRows ownerTid: tplId names: mrN tids: mrT
        mri: u64
        mrn: mrN.length
        for mri < mrn loop {
            mrnid: mrN.get i: mri
            mri = mri + 1
            childNames.append (zast.nameid.create from: mrnid.u32.orPanic)
        }
    }
    aiterV: arguments.iterate
    for argVId: aiterV loop {
        arg: argRefAt :ast nid: (zast.nodeid.create from: argVId.u32)
        if (arg.nid.isZero) == false then {
            pk: arg.name
            if (pk.isZero) == false then {
                if (st.reg.isGenericParamOf tdecl: tk name: pk) == false then {
                    (reportBadGenericArgLabel
                        :ast
                        :st
                        :arg
                        :tplId
                        :pk
                        :childNames
                        tname: tname.stringView
                        :tk
                    )
                }
            }
        }
    }
}

# resolveMonoRefParts -- resolveMonoRefInline's call-shaped core, taking the
# callable and argument list directly so narrowed call subjects can feed it.
resolveMonoRefParts: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    thisName: StringView
    enclDecl: ztypes.declid
    callableNid: zast.nodeid
    arguments: (ListVal u32).view
    nid: u32
} out u64 is {
    {
        # the callee's name, an owned copy read through a view scoped to this
        # block: the lookups below lend ast
        tname: String
        {
            callable: ast.nodes.get i: callableNid.u64
            tname = zast.nameTextCopy :ast ref: (atomNameId :ast n: callable)
        }
        if tname.length == 0 then return 0
        sfx: String
        typeSubs: (IdMapV zast.nameid v: u64)
        valSubsR: (IdMapV zast.nameid v: u64)
        firstOut: (ListVal u64)
        allOk: (collectMonoRefArgs
            :st
            :ast
            :unitDecl
            :frame
            :thisName
            :enclDecl
            :arguments
            :sfx
            :typeSubs
            :valSubsR
            :firstOut
        )
        firstA: ztypes.tid.create from: (firstOut.get i: 0)
        if allOk == false then return 0
        if sfx.length == 0 then return 0
        tplId: ztypes.tid
        tduo: (definingSiteFor :st :frame :ast :unitDecl name: tname.stringView).defUnit
        if tduo == unitDecl then {
            tplId = (descendNamed
                :st
                :frame

                :ast
                unitDecl: tduo
                name: tname.stringView
            )
        }
        if tplId.isZero then {
            tplO: walkLookupTyperef :st :frame :ast :unitDecl base: tname.stringView
            tplId = ztypes.tid.create from: (optU64Or o: tplO d: 0)
        }
        if tplId.isZero then {
            if (tduo.isZero) == false then {
                tplId = (descendNamed
                    :st
                    :frame

                    :ast
                    unitDecl: tduo
                    name: tname.stringView
                )
            }
        }
        if tplId.isZero then return 0
        validateMonoRefLabels :ast :st :arguments :tplId
        # generator wrapper collapse: the synth `.call` return's Option over a
        # VALTYPE element is optionval (ownership is a physical no-op there);
        # a REFTYPE element is Option (the yielded value is owned — it must
        # outlive the `.call`, so the payload lives in a malloc'd box).
        tn: tname.copy
        gwv: optBoolOr o: (st.typing.generatorWrapper.get key: nid.u64) d: false
        if gwv when firstA > 0 then {
            if (typeIsValtype :st tid: (ztypes.tid.create from: firstA.u64)) then {
                ovd: (descendNamed
                    :st
                    :frame

                    :ast
                    unitDecl: st.typing.systemUnitRoot
                    name: "optionval"
                )
                if ovd > 0 then {
                    tplId = ztypes.tid.create from: (ovd)
                    tn = "optionval".string
                }
            } else {
                obd: (descendNamed
                    :st
                    :frame

                    :ast
                    unitDecl: st.typing.systemUnitRoot
                    name: "Option"
                )
                if obd > 0 then {
                    tplId = ztypes.tid.create from: (obd)
                    tn = "Option".string
                }
            }
        }
    mainName: st.typing.mainUnitRoot

        # firstA rides as the fallback: when a template's param name differs
        # from the call label (Option's `t` vs the conventional `of:`), the
        # clone fallback leg types native-union arms from it -- a spec first
        # minted from a TYPE-position ref must carry real arm payloads.
        memberIdAt: (getOrMintSpec
            :st
            :frame
            :ast

            unitDecl: mainName
            sfx: sfx.stringView
            templateId: (ztypes.tid.create from: tplId.u64)
            subs: typeSubs
            valSubs: valSubsR
            fallbackArg: firstA
        )
        if memberIdAt.isZero then return 0
        # backstop for a sized record whose size literal did not parse as a
        # decimal (the value-keyed trie path arms sized specs centrally)
        isSized: false
        if tn.stringView == "str" then isSized = true
        if tn.stringView == "array" then isSized = true
        if isSized then {
            (mintCollectionChildren
                :st
                :frame
                :ast

                monoId: memberIdAt
                templateId: (ztypes.tid.create from: tplId.u64)
                elemArg: firstA
                valArg: ztypes.tid
            )
        }
        if nid > 0 then {
            ztyping.nodeTypeSet tbl: st.typing.nodeType nid: nid.u64 tid: memberIdAt
        }
        return memberIdAt
    }
}
# recordDottedTyperef -- a type-ref written as a dotted path: a unit-qualified type
# name, a nested namespace's type, or a member type of a type. Records the
# dependency the reference creates, whichever shape it takes.
recordDottedTyperef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    thisName: StringView
    nid: zast.nodeid
} is {
    # Ownership/access strip marker (this.lock / StringView.borrow / Container.private):
    # record the dotted node with its peeled base AND recurse on the parent so the
    # stripped inner atom is stamped too.
    # A `.typedef` marker only recurses -- the dotted node itself resolves to a
    # NULL-defined typedef wrapper the dump filters out.
    # the row and its parent/child names are read through views scoped to
    # blocks (owned copies): the recordings below lend ast exclusively
    parentId: zast.nodeid
    childId: zast.nodeid
    {
        node: ast.nodes.get i: nid.u64
        match (
            node
        ) case dottedpath then {
            parentId = node.parent
            childId = node.child
        } else null
    }
    if parentId.isZero then return
    cn: String
    pn: String
    cnId: zast.nameid
    pnId: zast.nameid
    {
        cNode: ast.nodes.get i: childId.u64
        cnId = atomNameId :ast n: cNode
        cn = zast.nameTextCopy :ast ref: cnId
        pNode: ast.nodes.get i: parentId.u64
        pnId = atomNameId :ast n: pNode
        pn = zast.nameTextCopy :ast ref: pnId
    }
    if (nameDenotesUnit :st :frame nameId: (nameIdOf :ast name: pn.stringView)) then {
        # cross-unit qualified type ref (zlexer.Token): record the MEMBER under
        # its DEFINING unit (the parent) so stampTyperefs bridges this node.
        # The member resolves in the qualifier's frame, not the writer's.
        qfr: ztypes.declid
        {
            qro: (st.typing.declFindChild
                parentDeclId: st.typing.programRoot
                nameId: (nameIdOf :ast name: pn.stringView)
            )
            if (qro.isZero) == false then qfr = qro
        }
        udQ: unitDeclOfNameOrOwn :st :frame nameId: (nameIdOf :ast name: pn.stringView)
        (recordResolvedName
            :st
            :frame

            :ast
            unitDecl: udQ
            :thisName
            name: cn.stringView
            nid: nid.u64
            recFrame: qfr
        )
    } else {
        if (isStripMarker name: cn.stringView) then {
            bn: baseTypeName :ast n: (ast.nodes.get i: parentId.u64)
            (recordResolvedName
                :st
                :frame

                :ast
                :unitDecl
                :thisName
                name: bn.stringView
                nid: nid.u64
                recFrame: frame
            )
            # a parameterized parent ((List of: String).take) has no base
            # name; the marker dp wears the parent's mono stamp.
            if bn.length == 0 then {
                (resolveMonoRefInline
                    :st
                    :frame

                    :ast
                    :unitDecl
                    :thisName
                    enclDecl: ztypes.declid
                    opNid: parentId
                    nid: nid.u32
                )
            }
            # Ownership markers peel and stamp the inner ref; `.private` /
            # `.public` resolve the pair atomically (no base-atom stamp).
            if cn.stringView != "private" then {
                if cn.stringView != "public" then {
                    recordTyperef :st :frame :ast :unitDecl :thisName nid: parentId
                }
            }
        } else {
            if cn.stringView == "typedef" then {
                recordTyperef :st :frame :ast :unitDecl :thisName nid: parentId
            } else {
                (stampNestedTyperef
                    :st
                    :frame

                    :ast
                    :unitDecl
                    unitId: pnId
                    memberId: cnId
                    :nid
                )
            }
        }
    }
}


# recordTyperef -- record a signature type-ref node (param / field / arm / return) for
# post-demand stamping. resolveTyperefShell yields only a NULL-unit shell and the real
# type may be unresolved here (system / forward refs), so the base name is resolved to its
# real type later by stampTyperefs. Recurses parameterized args and strip-marker dotted
# paths; `this`/`type` record as the enclosing type (thisName).
# recordTyperefArgs -- a parameterized type `(T arg: U ...)`: the outer node
# resolves to a NULL-defined mono (filtered out); record each argument's
# inner TYPE-ref (e.g. the `u32` in `(optionval t: u32)`), but skip
# numeric-literal size args (the `16` in `(str to: 16)`) -- they are const
# values, not type references -- then the head atom, so go-to-definition /
# hover resolve the template (the wrapper expression carries the instance
# stamp, recorded by the enclosing expression arm).
recordTyperefArgs: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    thisName: StringView
    callableId: zast.nodeid
    argIds: (ListVal u32).view
} is {
    with ait: argIds.iterate do for argId: ait loop {
        # the argument is read through a view scoped to this block
        isNamedArg: false
        opId: zast.nodeid
        an: String
        {
            arg: ast.nodes.get i: argId.u64
            match (
                arg
            ) case namedoperation then {
                isNamedArg = true
                opId = arg.operation
                an = (zast.nameTextCopy
                    :ast
                    ref: (atomNameId :ast n: (ast.nodes.get i: arg.operation.u64))
                )
            } else {
                an = zast.nameTextCopy :ast ref: (atomNameId :ast n: arg)
            }
        }
        if (isNumericLiteralName name: an.stringView) == false then {
            if isNamedArg then {
                recordTyperef :st :frame :ast :unitDecl :thisName nid: opId
            } else {
                # a bare (label-less) type argument records directly, with
                # the same numeric-size-arg skip as the labeled form
                (recordTyperef
                    :st
                    :frame
                    :ast
                    :unitDecl
                    :thisName
                    nid: (zast.nodeid.create from: argId)
                )
            }
        }
    }
    # the head atom is itself a type reference: record it so
    # go-to-definition / hover resolve the template (the wrapper
    # expression still carries the instance stamp)
    recordTyperef :st :frame :ast :unitDecl :thisName nid: callableId
}

recordTyperef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    thisName: StringView
    nid: zast.nodeid
} is {
    # the row is read through a view scoped to this block (1 expression,
    # 2 call, 3 dottedpath, 4 atomid, 5 labelvalue, 0 anything else): the
    # recordings below lend ast exclusively
    arm: u32
    innerId: zast.nodeid
    callableId: zast.nodeid
    argIds: (ListVal u32)
    nameId: zast.nameid
    {
        node: ast.nodes.get i: nid.u64
        match (
            node
        ) case expression then {
            arm = 1
            innerId = node.expression
        } case call then {
            arm = 2
            callableId = node.callable
            with ait: node.arguments.iterate do for a: ait loop argIds.append from: a
        } case dottedpath then {
            arm = 3
        } case atomid then {
            arm = 4
            nameId = node.name
        } case labelvalue then {
            arm = 5
            nameId = node.name
        } else null
    }
    if arm == 1 then {
        (resolveMonoRefInline
            :st
            :frame

            :ast
            :unitDecl
            :thisName
            enclDecl: ztypes.declid
            opNid: innerId
            nid: nid.u32
        )
        recordTyperef :st :frame :ast :unitDecl :thisName nid: innerId
        return
    }
    if arm == 2 then {
        recordTyperefArgs :st :frame :ast :unitDecl :thisName :callableId :argIds
        return
    }
    if arm == 3 then {
        recordDottedTyperef :st :ast :unitDecl :frame :thisName :nid
        return
    }
    if arm == 4 then {
        rrA: ast.names.texts.get i: nameId.u64
        (recordResolvedName
            :st
            :frame

            :ast
            :unitDecl
            :thisName
            name: rrA.stringView
            nid: nid.u64
            recFrame: frame
        )
        return
    }
    if arm == 5 then {
        rrA: ast.names.texts.get i: nameId.u64
        (recordResolvedName
            :st
            :frame

            :ast
            :unitDecl
            :thisName
            name: rrA.stringView
            nid: nid.u64
            recFrame: frame
        )
    }
}

# returnParamTid -- when a return typeref names one of the enclosing
# template's generic parameters, its canonical parameter type id; else 0.
returnParamTid: function {
    st: zenv.ZSymbolTable
    enclDecl: ztypes.declid
    ast: Ast.view
    oId: zast.nodeid
} out u64 is {
    if oId.isZero then return 0
    o: ast.nodes.get i: oId.u64
    bn: atomName :ast n: o
    # a marker-suffixed generic return (`of.take` / `of.borrow`) reads its
    # base name through the peeled parent.
    if bn.length == 0 then bn = markerPeeledBase :ast n: o
    if (st.reg.isGenericParamOf tdecl: enclDecl name: (nameIdOf :ast name: bn.stringView)) then {
        (recordGenericParamRef
            :st
            nid: oId.u64
            frame: enclDecl
            name: (nameIdOf :ast name: bn.stringView)
        )
        po: st.reg.genericParamTidOf tdecl: enclDecl paramName: (nameIdOf :ast name: bn.stringView)
        match (
            po
        ) case some then {
            return po
        } case none then null
        rpt7: st.reg.newType name: bn.stringView typetype: ztypes.ztypetype.genericParam
        (st.reg.setGenericParamTid
            tdecl: enclDecl
            paramName: (nameIdOf :ast name: bn.stringView)
            tid: rpt7
        )
        return rpt7
    }

    return 0
}

# returnWrapperBaseNameId -- the Ast.names pool id of the base atom of a declared
# return typeref (`(Option String)` -> the id of `Option`), peeling expression
# wrappers and `.borrow`-style strip markers; 0 for any other shape. Reads the
# declaration only: it resolves nothing and mints nothing, unlike partialTyperefTid
# below.
returnWrapperBaseNameId: function {ast: Ast.view n: Node.view} out zast.nameid is {
    match (
        n
    ) case expression then {
        return (returnWrapperBaseNameId :ast n: (ast.nodes.get i: n.expression.u64))
    } case dottedpath then {
        dcn7: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: n.child.u64))
        if (isStripMarker name: dcn7.stringView) then {
            return (returnWrapperBaseNameId :ast n: (ast.nodes.get i: n.parent.u64))
        }
        return (zast.nameid.create from: 0)
    } case call then {
        return (atomNameId :ast n: (ast.nodes.get i: n.callable.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}

# partialTyperefTid -- resolve a composite parameterized typeref inside a
# template method signature to a spec through the shared disassembly
# (resolveMonoRefParts with the template's enclKey). Returns the spec only
# when it is PARTIAL (an argument named a generic param); a fully-concrete
# composite stays 0, preserving the caller's eager-path behavior.
partialTyperefTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    enclDecl: ztypes.declid
    nid: zast.nodeid
} out u64 is {
    arm: rowArmAt :ast :nid
    match (
        arm
    ) case expression then {
        wrap: exprRefAt :ast :nid
        return (partialTyperefTid :st :frame :ast :unitDecl :enclDecl nid: wrap.expression)
    } case dottedpath then {
        dr: dpRefAt :ast :nid
        # the child's name is read through a view scoped to this block: the
        # walk below lends ast
        isStrip: false
        {
            dcn6: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: dr.child.u64))
            isStrip = isStripMarker name: dcn6.stringView
        }
        if isStrip then return (partialTyperefTid
            :st
            :frame
            :ast
            :unitDecl
            :enclDecl
            nid: dr.parent
        )
        return 0
    } case call then {
        # the arguments as an owned list: the resolver below lends ast
        cr: callRefAt :ast :nid
        args6: (ListVal u32)
        k6: u64
        for k6 < cr.nargs loop {
            args6.append from: (zast.callArgAt :ast nid: cr.nid i: k6).u32
            k6 = k6 + 1
        }
        rmp6: (resolveMonoRefParts
            :st
            :frame

            :ast
            :unitDecl
            thisName: ""
            :enclDecl
            callableNid: cr.callable
            arguments: args6
            nid: 0
        )
        if rmp6 > 0 then {
            if (st.reg.typetypeOf typeId: (ztypes.tid.create from: rmp6.u64)) == ztypes.ztypetype.genericParam then return rmp6
        }
        return 0
    } else null
    return 0
}

# partialReturnTid -- partialTyperefTid over a function's return typeref.
partialReturnTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    enclDecl: ztypes.declid
    oId: zast.nodeid
} out u64 is {
    if oId.isZero then return 0
    return (partialTyperefTid :st :frame :ast :unitDecl :enclDecl nid: oId)

    return 0
}

# returnIsIteratorTid -- the resolved return type is an iterator: a class
# carrying a `call` member, which is the Iterator marker system.z declares
# (no explicit conformance is required of it). Asked of the generic origin,
# so a mono answers as its template. Iterator borrows stay EXCLUSIVE (many
# SHARED views XOR one writer XOR one exclusive iterator); other returned
# borrows are read-views and lock SHARED.
returnIsIteratorTid: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    org: u64
    {
        go: st.reg.genericOriginOf :tid
        if go > 0 then org = go
    }
    probe: tid
    if org > 0 then probe = ztypes.tid.create from: org.u64
    if (st.reg.typetypeOf typeId: probe) == ztypes.ztypetype.classType then {
        co9: st.typing.declChildOfId parentTypeId: probe nameId: zast.names.wkCall
        match (
            co9
        ) case some then {
            return true
        } case none then null
    }
    return false
}

# markerPeeledBase -- the base atom name under a strip-marker dotted path
# (`of.take` -> "of"); "" for any other shape.
markerPeeledBase: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case dottedpath then {
        mcn3: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: n.child.u64))
        if (isStripMarker name: mcn3.stringView) then {
            return (atomName :ast n: (ast.nodes.get i: n.parent.u64))
        }
        return "".string
    } else {
        return "".string
    }
}

# stampGenericParamRef -- a return typeref naming one of the enclosing
# template's generic params stamps the unit's generic-param type directly
# (generic params live outside the name-resolution table).
stampGenericParamRef: function {
    st: zenv.ZSymbolTable
    enclDecl: ztypes.declid
    ast: Ast.view oId: zast.nodeid
} is {
    if oId.isZero then return
    o: ast.nodes.get i: oId.u64
    bn: atomName :ast n: o
    # a marker-suffixed generic return (`of.take` / `of.borrow`) reads its
    # base name through the peeled parent; the marker dp wears the stamp,
    # matching recordTyperef's convention for concrete marked returns.
    if bn.length == 0 then bn = markerPeeledBase :ast n: o
    if (st.reg.isGenericParamOf tdecl: enclDecl name: (nameIdOf :ast name: bn.stringView)) then {
        gpt3: u64
        gpo3: (st.reg.genericParamTidOf
            tdecl: enclDecl
            paramName: (nameIdOf :ast name: bn.stringView)
        )
        match (
            gpo3
        ) case some then {
            gpt3 = gpo3
        } case none then {
            gpt3 = st.reg.newType name: bn.stringView typetype: ztypes.ztypetype.genericParam
            (st.reg.setGenericParamTid
                tdecl: enclDecl
                paramName: (nameIdOf :ast name: bn.stringView)
                tid: (ztypes.tid.create from: gpt3.u64)
            )
        }
        gnid3: nodeId n: o
        (ztyping.nodeTypeSet
            tbl: st.typing.nodeType
            nid: gnid3.u64
            tid: (ztypes.tid.create from: gpt3.u64)
        )
    }

}

# recordGenericMarkerReturn -- a marker-suffixed generic-param return
# (`out of.take` / `out of.borrow`) records its peeled base name at the
# dotted node (pendingTyperef) so the mono-return substitution finds it:
# the plain-atom leg records inside recordTyperef, while the marker leg
# only resolution-stamps.
recordGenericMarkerReturn: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    enclDecl: ztypes.declid
    ast: Ast.view oId: zast.nodeid
} is {
    if oId.isZero then return
    o: ast.nodes.get i: oId.u64
    mpb3: markerPeeledBase :ast n: o
    if mpb3.length > 0 when (st.reg.isGenericParamOf
        tdecl: enclDecl
        name: (nameIdOf :ast name: mpb3.stringView)
    ) then {
        mnid3: nodeId n: o
        recordNodeName :ast :st name: mpb3.stringView nid: mnid3.u64 :frame
        # the entry feeds mono-return substitution (the pending MAP is the
        # consumer); it names a template param, so it never name-resolves
        nsk3: mnid3.u64
        nsv3: true
        st.typing.noStampNode.set key: nsk3 value: nsv3
    }

}

# recordFuncReturnNode -- map a function type id to its return type-ref's node id
# so a call site can read the resolved return type (node_type, post stampTyperefs).
recordFuncReturnNode: function {
    st: zenv.ZSymbolTable
    fid: ztypes.tid
    ast: Ast.view
    oId: zast.nodeid
} is {
    if oId.isZero then return
    o: ast.nodes.get i: oId.u64
    rn: nodeId n: o
    fidc: fid
    st.typing.funcReturnNode.set key: fidc value: rn.u64

}

# recordReturnType -- record a function's `out T` return type-ref (mirrors
# demandReturnType's extraction). A parameterized return (out (Result ...)) yields no
# bare base name and is skipped (its mono is NULL-defined, filtered out anyway).
recordReturnType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    thisName: StringView
    oId: zast.nodeid
} is {
    if oId.isZero then return
    recordTyperef :st :frame :ast :unitDecl :thisName nid: oId

}

# demandTyperefNames -- demand every name a type-expr references (the head
# and, transitively, parameter-arg names), so a signature's full closure
# resolves. Creates no types.
demandTyperefNames: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    frame: ztypes.declid
    typeExpr: Node.view
} is {
    match (
        typeExpr
    ) case atomid then {
        teN: ast.names.texts.get i: typeExpr.name.u64
        if (isNumericLiteralName name: teN.stringView) == false then {
            frame9: (frameFor :st :frame :unitDecl)
            (demandDefinition
                :st
                frame: frame9
                nameId: typeExpr.name
            )
        }
    } case expression then {
        (demandTyperefNames
            :st
            :frame
            :ast
            :unitDecl
            typeExpr: (ast.nodes.get i: typeExpr.expression.u64)
        )
    } case call then {
        hn: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: typeExpr.callable.u64))
        if hn.length > 0 then {
            frame92: (frameFor :st :frame :unitDecl)
            (demandDefinition
                :st
                frame: frame92
                nameId: (atomNameId :ast n: (ast.nodes.get i: typeExpr.callable.u64))
            )
        }
        aiter: typeExpr.arguments.iterate
        for argId: aiter loop {
            arg: ast.nodes.get i: argId.u64
            match (
                arg
            ) case namedoperation then {
                (demandTyperefNames
                    :st
                    :frame
                    :ast
                    :unitDecl
                    typeExpr: (ast.nodes.get i: arg.operation.u64)
                )
            } else null
        }
    } case dottedpath then {
        (demandTyperefNames
            :st
            :frame
            :ast
            :unitDecl
            typeExpr: (ast.nodes.get i: typeExpr.parent.u64)
        )
    } else null
}

# typeArgSuffixName -- the suffix component a collection type-arg contributes to a
# shell mono name. A bare atom gives its name; a cross-unit dotted ref gives its
# MEMBER name (ztypes.zparamownership -> zparamownership) so the shell's mono name
# matches the construction path's nameOf-based name. Without this the dotted
# arg's atomName is "" and the shell mints `Map_u64_` (empty value), a distinct id
# from the constructed `Map_u64_zparamownership` -- the emitter's fieldMonoId
# canonicalizes by name, so divergent names leave a field/create type mismatch.
typeArgSuffixName: function {
    st: zenv.ZSymbolTable.view
    frame: ztypes.declid
    ast: Ast.view
    op: Node.view
} out String is {
    match (
        op
    ) case expression then {
        return (typeArgSuffixName :st :frame :ast op: (ast.nodes.get i: op.expression.u64))
    } case dottedpath then {
        if (nameDenotesUnit
    :frame
    :st nameId: (atomNameId
            :ast
            n: (ast.nodes.get i: op.parent.u64)
        )) then {
            return (atomName :ast n: (ast.nodes.get i: op.child.u64))
        } else {
            return "".string
        }
    } else {
        return (atomName :ast n: op)
    }
}
# dottedTyperefShell -- the shell a dotted type-ref names: a unit-qualified type, a
# nested namespace's type, a member type of a type, or the parent a marker peels
# back to (`Container.private.lock`, `direction.north`).
dottedTyperefShell: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nid: zast.nodeid
    thisName: StringView
} out u64 is {
    # the dotted row's parent and child ids, read through a view scoped to
    # this block: the resolutions below lend ast
    parentId: zast.nodeid
    childId: zast.nodeid
    {
        typeExpr: ast.nodes.get i: nid.u64
        match (
            typeExpr
        ) case dottedpath then {
            parentId = typeExpr.parent
            childId = typeExpr.child
        } else null
    }
    if parentId.isZero then return 0
    # A cross-unit qualified type ref (zlexer.Token) names the MEMBER in the
    # referenced unit -- resolve the child like a bare atom. Otherwise a dotted
    # type-expr peels to its parent: an ownership/access strip marker
    # (Container.private.lock) or a variant/union subtype default where the arm
    # is the default value and the type is the parent (direction.north).
    # owned copies: the resolutions below lend ast
    pNm: zast.nameTextCopy :ast ref: (atomNameId :ast n: (ast.nodes.get i: parentId.u64))
    if (nameDenotesUnit
        :frame
        :st
        nameId: (atomNameId :ast n: (ast.nodes.get i: parentId.u64))
    ) then {
        cNm: (zast.nameTextCopy
            :ast
            ref: (atomNameId :ast n: (ast.nodes.get i: childId.u64))
        )
        (demandUnitMember
            :st
            unitNameId: (atomNameId :ast n: (ast.nodes.get i: parentId.u64))
            nameId: (atomNameId :ast n: (ast.nodes.get i: childId.u64))
        )
        ud8: unitDeclOfNameOrOwn :st :frame nameId: (nameIdOf :ast name: pNm.stringView)
        did8: (descendNamed
            :st
            :frame

            :ast
            unitDecl: ud8
            name: cNm.stringView
        )
        if did8 > 0 then return did8
        return (resolveAtomType :st :frame :ast :unitDecl nm: cNm.stringView :thisName)
    } else {
        # a dotted numeric literal (4.u64, 2.5.f32) declares the SUFFIX
        # type: peeling to the numeric parent would collapse it to the
        # literal default (i64/f64), silently mistyping the slot
        nSfx: (zast.nameTextCopy
            :ast
            ref: (atomNameId :ast n: (ast.nodes.get i: childId.u64))
        )
        isSfx: isNumericTypeName name: nSfx.stringView
        if (isNumericLiteralName name: pNm.stringView) when isSfx then {
            return (resolveAtomType
                :st
                :frame

                :ast
                :unitDecl
                nm: nSfx.stringView
                :thisName
            )
        }
        # A qualified ref into a NESTED unit names a MEMBER, the way a
        # cross-unit ref does -- the leg above cannot see it because a
        # nested unit is absent from the unit-name index. Peeling to the
        # parent instead handed the slot the UNIT's own type.
        nsRoot: ztypes.declid
        {
            nsro: unitDecl
            if (nsro.isZero) == false then nsRoot = nsro
        }
        nsParentNm: atomNameId :ast n: (ast.nodes.get i: parentId.u64)
        nsChildNm: atomNameId :ast n: (ast.nodes.get i: childId.u64)
        nsTid: (nestedUnitMemberTid
            :st
            :frame

            :ast
            ownerDeclId: nsRoot
            nestedNameId: nsParentNm
            defName: nsChildNm
        )
        if (nsTid.isZero) == false then return nsTid.u64
        return (resolveTyperefShell :st :frame :ast :unitDecl nid: parentId :thisName)
    }
}


# resolve a type reference to its shell type id, deferring member resolution.
# resolveTyperefAtomShell -- a bare atom (or label) type ref: the name
# resolves as an atom type; an atom also demands the definition it names.
resolveTyperefAtomShell: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nameId: zast.nameid
    thisName: StringView
    demand: bool
    nid: 0.u64
} out u64 is {
    # an owned copy: the resolution below lends ast
    teR: zast.nameTextCopy :ast ref: nameId
    if demand then {
        frame93: (frameFor :st :frame :unitDecl)
        (demandDefinition
            :st
            frame: frame93
            :nameId
        )
    }
    return (resolveAtomType
        :st
        :frame

        :ast
        :unitDecl
        nm: teR.stringView
        :thisName
        :nid
    )
}

resolveTyperefShell: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nid: zast.nodeid
    thisName: StringView
} out u64 is {
    # the row is read through a view scoped to this block (1 atomid,
    # 2 labelvalue, 3 expression, 4 call, 5 dottedpath, 0 anything else): the
    # resolutions below lend ast exclusively
    arm: u32
    nameId: zast.nameid
    innerId: zast.nodeid
    callableId: zast.nodeid
    argIds: (ListVal u32)
    {
        typeExpr: ast.nodes.get i: nid.u64
        match (
            typeExpr
        ) case atomid then {
            arm = 1
            nameId = typeExpr.name
        } case labelvalue then {
            arm = 2
            nameId = typeExpr.name
        } case expression then {
            arm = 3
            innerId = typeExpr.expression
        } case call then {
            arm = 4
            callableId = typeExpr.callable
            with ait: typeExpr.arguments.iterate do for a: ait loop argIds.append from: a
        } case dottedpath then {
            arm = 5
        } else null
    }
    if arm == 1 then return (resolveTyperefAtomShell
        :st
        :frame
        :ast
        :unitDecl
        :nameId
        :thisName
        demand: true
        nid: nid.u64
    )
    if arm == 2 then return (resolveTyperefAtomShell
        :st
        :frame
        :ast
        :unitDecl
        :nameId
        :thisName
        demand: false
        nid: nid.u64
    )
    if arm == 3 then return (resolveTyperefShell :st :frame :ast :unitDecl nid: innerId :thisName)
    if arm == 4 then return (resolveTyperefCallShell
        :st
        :frame
        :ast
        :unitDecl
        :thisName
        :callableId
        :argIds
    )
    if arm == 5 then {
        return (dottedTyperefShell
            :st
            :ast
            :unitDecl
            :frame
            :nid
            :thisName
        )
    }
    return (st.reg.newType name: "?" typetype: ztypes.ztypetype.recordType)
}

# resolveTyperefCallShell -- a parameterized type ref: the mono it names
# when resolution knows one, else a fresh record shell named by the head
# and its argument suffixes, each argument's type names demanded on the way.
resolveTyperefCallShell: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    thisName: StringView
    callableId: zast.nodeid
    argIds: (ListVal u32).view
} out u64 is {
    imid8: (resolveMonoRefParts
        :st
        :frame

        :ast
        :unitDecl
        :thisName
        enclDecl: ztypes.declid
        callableNid: callableId
        arguments: argIds
        nid: 0
    )
    if imid8 > 0 then return imid8
    suffix: atomName :ast n: (ast.nodes.get i: callableId.u64)
    frame94: (frameFor :st :frame :unitDecl)
    (demandDefinition
        :st
        frame: frame94
        nameId: (atomNameId :ast n: (ast.nodes.get i: callableId.u64))
    )
    with ait: argIds.iterate do for argId: ait loop {
        # the argument is read through a view scoped to this block
        opId: zast.nodeid
        {
            arg: ast.nodes.get i: argId.u64
            match (
                arg
            ) case namedoperation then {
                opId = arg.operation
            } else null
        }
        if (opId.isZero) == false then {
            an: typeArgSuffixName :st :frame :ast op: (ast.nodes.get i: opId.u64)
            suffix.append "_"
            suffix.append an
            (demandTyperefNames
                :st
                :frame
                :ast
                :unitDecl
                typeExpr: (ast.nodes.get i: opId.u64)
            )
        }
    }
    return (st.reg.newType name: suffix.stringView typetype: ztypes.ztypetype.recordType)
}

# typeofSourceType -- resolve a typeof field's SOURCE without a body walk: a
# bare atom reads the owner's already-resolved field of that name (a generator
# parameter capture). 0 when the shape needs the body walk.
typeofSourceType: function {ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    ownerId: u64
    nid: zast.nodeid
} out u64 is {
    arm: rowArmAt :ast :nid
    match (
        arm
    ) case expression then {
        wrap: exprRefAt :ast :nid
        return (typeofSourceType :st :frame :ast :unitDecl :ownerId nid: wrap.expression)
    } case atomid then {
        if ownerId == 0 then return 0
        ar: atomRefAt :ast :nid
        co: (st.typing.declChildOfId
            parentTypeId: (ztypes.tid.create from: ownerId.u64)
            nameId: ar.name
        )
        match (
            co
        ) case some then {
            nameCount: st.reg.nameOf tid: (ztypes.tid.create from: co.u64)
            if nameCount.length > 0 then {
                ro: walkLookupTyperef :st :frame :ast :unitDecl base: nameCount.stringView
                match (
                    ro
                ) case some then {
                    return ro
                } case none then {
                    return co
                }
            } else {
                return co
            }
        } case none then {
            return 0
        }
    } else {
        return 0
    }
}

# resolveTyperefShellMarked -- resolveTyperefShell plus the typeof handling:
# a generator-promoted local's field type is a `typeof <first-rhs>` node.
# When the source resolves from signatures alone the field types directly
# (and the typeof node stamps); otherwise the shell is marked and the
# body's first `this.<field> =` write swaps it.
resolveTyperefShellMarked: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    ownerId: u64
    nid: zast.nodeid
    thisName: StringView
} out ztypes.tid is {
    # the row is read through a view scoped to this block: the resolutions
    # below lend ast exclusively
    isTof: false
    sourceId: zast.nodeid
    {
        typeExpr: ast.nodes.get i: nid.u64
        match (
            typeExpr
        ) case typeofexpr then {
            isTof = true
            sourceId = typeExpr.source
        } else null
    }
    if isTof then {
        rid: u64
        rid = typeofSourceType :st :frame :ast :unitDecl :ownerId nid: sourceId
        if rid > 0 then {
            # the node's stamp defers to the post-demand pass so it lands
            # on the globally-resolved type, not an early shell
            tnm: st.reg.nameOf tid: (ztypes.tid.create from: rid.u64)
            if tnm.length > 0 then {
                (st.typing.pendingTyperef.set
                    key: nid.u64
                    value: (nameIdOf :ast name: tnm.stringView)
                )
                st.typing.pendingTyperefFrame.set key: nid.u64 value: frame
            }
            return (ztypes.tid.create from: rid)
        }
    }
    prevCE: st.typing.inContainmentEdge
    st.typing.inContainmentEdge = true
    cid: resolveTyperefShell :st :frame :ast :unitDecl :nid :thisName
    st.typing.inContainmentEdge = prevCE
    if isTof then {
        tk: cid
        tv: nid
        st.typing.typeofShell.set key: tk value: tv
    }
    return (ztypes.tid.create from: cid)
}

# nameIsInUnitReftype -- true when a type name resolves to an in-unit reference type
# (class or union). Drives the reftype-param BORROW default and class field cleanup.
# Native heap params (String/List/Map) are pointer-typed already and get no BORROW
# default, so they are NOT matched here -- only user class/union types defined in
# this unit.
nameIsInUnitReftype: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    name: StringView
} out bool is {
    rrId: zast.poolFind pool: ast.names text: name
    rr: resolveUnitChild :st :ast :unitDecl nameId: rrId
    match (
        rr
    ) case some then {
        tt: st.reg.typetypeOf typeId: (ztypes.tid.create from: rr.u64)
        match (
            tt
        ) case classType then {
            return true
        } case unionType then {
            return true
        } else {
            return false
        }
    } case none then {
        return false
    }
}

# paramTypeBaseName -- the base type name of a (possibly parameterized) param type
# expression: an atom name directly, or the callable of a parenthesized
# `(List of: i64)` form (an expression wrapping a call). "" for anything else.
# returnHasBorrowMarkerNode / returnHasBorrowMarker -- the function's return
# type carries a REFERENCE marker: `out T.borrow` hands back a mutable
# reference into the receiver, `out T.view` a readonly one. Both pin the
# receiver for the result binding's scope; they differ only in how strongly
# (returnHasViewMarker picks that apart).
returnHasBorrowMarkerNode: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (returnHasBorrowMarkerNode :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        rbo: pathOwnership :ast :n
        match (
            rbo
        ) case some then {
            if rbo == ztypes.zparamownership.borrowMode then return true
            return rbo == ztypes.zparamownership.viewMode
        } case none then {
            return false
        }
    }
}

# returnHasViewMarkerNode / returnHasViewMarker -- the reference the return
# hands back is READONLY (`out T.view`), so the pin it leaves on the receiver
# is shared: several such references may be live at once.
returnHasViewMarkerNode: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (returnHasViewMarkerNode :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        rvo: pathOwnership :ast :n
        match (
            rvo
        ) case some then {
            return rvo == ztypes.zparamownership.viewMode
        } case none then {
            return false
        }
    }
}

returnHasViewMarker: function {ast: Ast.view oId: zast.nodeid} out bool is {
    if oId.isZero then return false
    o: ast.nodes.get i: oId.u64
    return (returnHasViewMarkerNode :ast n: o)
}

# returnHasTakexMarkerNode / returnHasTakexMarker -- `out T.takex`: the result is
# OWNED, and the non-owned sources it was built from stay pinned for as long as
# it lives. It is not a reference return, so it is kept apart from
# returnHasBorrowMarker -- the binding keeps its destructor.
returnHasTakexMarkerNode: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (returnHasTakexMarkerNode :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        rxo: pathOwnership :ast :n
        match (
            rxo
        ) case some then {
            return rxo == ztypes.zparamownership.takexMode
        } case none then {
            return false
        }
    }
}

returnHasTakexMarker: function {ast: Ast.view oId: zast.nodeid} out bool is {
    if oId.isZero then return false
    o: ast.nodes.get i: oId.u64
    return (returnHasTakexMarkerNode :ast n: o)
}

# true when operation `oId`'s return type carries a `.borrow` marker.
returnHasBorrowMarker: function {ast: Ast.view oId: zast.nodeid} out bool is {
    if oId.isZero then return false
    o: ast.nodes.get i: oId.u64
    return (returnHasBorrowMarkerNode :ast n: o)

}

# paramIsThisReceiver -- the parameter's type names the receiver: bare `this`
# or a marker-suffixed `this.lock` / `this.borrow`.
paramIsThisReceiver: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case expression then {
        return (paramIsThisReceiver :ast op: (ast.nodes.get i: op.expression.u64))
    } case atomid then {
        return op.name.u32 == zast.names.wkThis
    } case dottedpath then {
        return (atomNameId :ast n: (ast.nodes.get i: op.parent.u64)) == zast.names.wkThis
    } else {
        return false
    }
}

# paramIsThisReceiverId -- paramIsThisReceiver over a node id, for callers
# that hold no outstanding view into ast.nodes.
paramIsThisReceiverId: function {ast: Ast.view opId: u32} out bool is {
    return (paramIsThisReceiver :ast op: (ast.nodes.get i: opId.u64))
}

# the base type name of parameter operation `op`.
# paramTypeBaseNameId -- paramTypeBaseName's answer as the name's id.
paramTypeBaseNameId: function {ast: Ast.view op: Node.view} out zast.nameid is {
    match (
        op
    ) case atomid then {
        return op.name
    } case labelvalue then {
        return op.name
    } case expression then {
        return (paramTypeBaseNameId :ast op: (ast.nodes.get i: op.expression.u64))
    } case call then {
        return (atomNameId :ast n: (ast.nodes.get i: op.callable.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}

paramTypeBaseName: function {ast: Ast.view op: Node.view} out String is {
    match (
        op
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: op.name)
    } case labelvalue then {
        return (zast.nameTextCopy :ast ref: op.name)
    } case expression then {
        return (paramTypeBaseName :ast op: (ast.nodes.get i: op.expression.u64))
    } case call then {
        return (atomName :ast n: (ast.nodes.get i: op.callable.u64))
    } else {
        return "".string
    }
}

# isBorrowReftypeCollection -- true for a parameterized collection whose mono is a
# non-heap-allocated reftype, which takes the reftype-param BORROW default: List and
# ListView (stack struct + heap buffer). Set/Map monos are heap-allocated (no BORROW);
# the native iterator views have no destructor (no BORROW); str/array are valtypes.
isBorrowReftypeCollection: function {name: StringView} out bool is {
    if name == "List" then return true
    if name == "ListRef" then return true
    if name == "ListVal" then return true
    if name == "ListView" then return true
    if name == "ListViewVal" then return true
    # the id-keyed containers are stack structs too -- a header plus two heap
    # arrays, created BY VALUE -- so they take the same borrow default
    if name == "IdMapR" then return true
    if name == "IdMapV" then return true
    if name == "IdSet" then return true
    return false
}

# isBorrowNativeReftype -- true for native heap-owning reftypes (currently String)
# that take the BORROW default as an unannotated param. Keyed by name, like the
# classifiers above: native types resolve AFTER the main unit, so the metadata
# that would answer (a native CLASS that owns heap) is not yet populated when a
# param resolves.
isBorrowNativeReftype: function {name: StringView} out bool is {
    if name == "String" then return true
    return false
}

# isNativeValueView -- true for StringView, the native immutable string view (subtype
# STRINGVIEW): a param of this type stays unowned (a value-passed copy of a borrowed
# view), so it takes no BORROW default. Other reftypes -- String (native, owns heap),
# the mutable iterators (CpIter/Splitter/LinesIter), and non-native views (ListView/
# OptionView) -- take the normal reftype-param BORROW default.
isNativeValueView: function {name: StringView} out bool is {
    if name == "StringView" then return true
    return false
}

# demandReturnType -- demand a function's return-type names (`out (Result t:
# u64 e: IoError)` -> Result), so a type named only in a return position is
# resolved.
demandReturnType: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    frame: ztypes.declid
    oId: zast.nodeid
} is {
    if oId.isZero then return
    o: ast.nodes.get i: oId.u64
    demandTyperefNames :st :frame :ast :unitDecl typeExpr: o

}

# resolveFunction -- resolve a function definition signature into a FUNCTION
# type: a child per parameter (param name -> type-ref shell, `this` params bound
# to thisName), its defining unit (source-types filter), and a `{unit}.{name}`
# entry in the resolved name-view. Returns the FUNCTION type id (a record method
# binds it as a child; a free function discards it).
# fnHasLockParam -- does any parameter (including a marked receiver) carry a
# non-owned marker? A `.borrow` return must borrow from a non-owned parameter
# so the returned view has a pinned parent to live in (docs/ownership.pdoc).
fnHasLockParam: function {ast: Ast.view fnode: fnref} out bool is {
    found: false
    kP: u64
    for kP < fnode.nparams loop {
        pmId: (zast.fnParamAt :ast nid: fnode.nid i: kP).u32
        kP = kP + 1
        if (found) == false then {
            pm: ast.nodes.get i: pmId.u64
            match (
                pm
            ) case namedoperation then {
                po: pathOwnership :ast n: (ast.nodes.get i: pm.operation.u64)
                match (
                    po
                ) case some then {
                    # Any NON-OWNED parameter is a valid source: the returned
                    # view's parent is pinned either way, readonly for `view`
                    # and exclusive for `lock`/`borrow`. This is L1 of the
                    # plan's liveness rules -- the source's identity stopped
                    # mattering once every non-owned parameter is pinned.
                    if po == ztypes.zparamownership.borrowMode then found = true
                    if po == ztypes.zparamownership.viewMode then found = true
                } case none then null
            } else null
        }
    }
    return found
}

# typeHasNonOwnedField -- the type declares at least one field the instance does
# NOT own: a `borrow`/`view` slot, i.e. a reference into something else. Such an
# instance is only sound while whatever it points at outlives it.
typeHasNonOwnedField: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    i: u64
    n: st.typing.declRowSlots ownerTid: tid
    found: false
    for i < n loop {
        frow: st.typing.declRowAt ownerTid: tid membersOnly: true slot: i
        if frow.keep when (found) == false then {
            nid: frow.name.u32.orPanic
            if (st.typing.declIsLockFieldId
                parentTypeId: tid
                nameId: (zast.nameid.create from: nid.u32)
            ) then found = true
        }
        i = i + 1
    }
    return found
}

# returnNamesThis -- the return type is the enclosing type itself (`out this`,
# with or without a marker), which is what a constructor writes.
returnNamesThis: function {ast: Ast.view oId: zast.nodeid} out bool is {
    if oId.isZero then return false
    return (rootNameIdOf :ast n: (ast.nodes.get i: oId.u64)) == zast.names.wkThis
}

# checkTakexHonesty -- an OWNED `out this` whose type declares a non-owned field
# hands back a value holding a reference into something the callee was given.
# Unless the return says `takex`, nothing pins that source and the field dangles
# as soon as the caller drops it. This is the rule `.lock` on the parameter used
# to enforce by accident; `takex` states it on the signature, where a reader can
# see it.
checkTakexHonesty: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    fnode: fnref
    thisTid: ztypes.tid
    defName: StringView
} is {
    if thisTid.isZero then return
    if (returnNamesThis :ast oId: fnode.returntype) == false then return
    # a reference return is a different contract, checked by checkBorrowReturnLock
    if (returnHasBorrowMarker :ast oId: fnode.returntype) then return
    if (returnHasTakexMarker :ast oId: fnode.returntype) then return
    if (typeHasNonOwnedField :st tid: (ztypes.tid.create from: thisTid.u64)) == false then return
    (addResolveErrorH
        :st
        nodeid: fnode.nid
        lineno: fnode.lineno
        colno: fnode.colno
        e: zast.err.ownerError
        msg: "an owned `out this` whose type declares a non-owned field must be `.takex` -- the result holds a reference into a parameter, and only `takex` pins that source for the result's lifetime".string
        width: defName.length.u32.orPanic
    )
}

# checkBorrowReturnLock -- a `.borrow`-returning function must borrow from a
# non-owned parameter (a marked receiver counts), so the returned view has a
# pinned parent (docs/ownership.pdoc). Runs at every function/method decl.
checkBorrowReturnLock: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    fnode: fnref
    defName: StringView
} is {
    if (returnHasBorrowMarker :ast oId: fnode.returntype) then {
        if (fnHasLockParam :ast :fnode) == false then {
            (addResolveErrorH
                :st
                nodeid: fnode.nid
                lineno: fnode.lineno
                colno: fnode.colno
                e: zast.err.ownerError
                msg: "a `.borrow` return must borrow from a non-owned parameter -- mark the source `.view` (readonly) or `.borrow` (mutable), e.g. `t: this.view`, so the returned view has a pinned parent".string
                width: defName.length.u32.orPanic
            )
        }
    }
}
# checkParamTypeShape -- report the ways a parameter's declared type can fail to
# name a type: an unknown name, a sum ARM used where its type belongs, or a
# unit used as a type.
checkParamTypeShape: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    rf: ztypes.declid
    cid: u64
    ptnT: StringView
    pname: StringView
    fid: u64
    pm: argref
} is {
    fnRefIsFn: false
    fnRefOpt: (walkLookupTyperef
        :st
        frame: rf
        :ast

        :unitDecl
        base: ptnT
    )
    fnRefTid: ztypes.tid
    match (
        fnRefOpt
    ) case some then {
        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: fnRefOpt.u64)) == ztypes.ztypetype.functionType then {
            fnRefIsFn = true
            fnRefTid = ztypes.tid.create from: (fnRefOpt)
        }
    } case none then null
    if fnRefIsFn then {
        (st.typing.setDefaultFunction
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: fid.u64)
            name: pname
            targetDecl: (declOfTypeId
                :st
                tid: (ztypes.tid.create from: fnRefTid.u64)
            )
        )
    } else {
        pdcn: (zast.nameTextAt
            :ast
            ref: (dottedChildNameId :ast n: (ast.nodes.get i: pm.operation.u64))
        )
        if pdcn.length > 0 when (isStripMarker name: pdcn.stringView) == false then {
            prn: (zast.nameTextAt
                :ast
                ref: (rootNameIdOf :ast n: (ast.nodes.get i: pm.operation.u64))
            )
            # a dotted numeric literal (0.u64) is a typed numeric
            # default, not a variant arm (mirrors the field
            # classifiers' rootNameOf guard)
            if (isNumericLiteralName name: prn.stringView) then {
                (st.typing.setDefaultLiteral
                    pool: ast.names
                    parentTypeId: (ztypes.tid.create from: fid.u64)
                    name: pname
                    node: pm.operation
                )
            } else if (nameDenotesUnit
                :st
                frame: rf
                nameId: (nameIdOf :ast name: prn.stringView)
            ) == false then {
                pArmNid: zast.poolFind pool: ast.names text: pdcn.stringView
                pArmDecl: (st.typing.declMemberIdOf
                    parentTypeId: (ztypes.tid.create from: cid.u64)
                    nameId: pArmNid
                )
                (st.typing.setDefaultVariantArm
                    pool: ast.names
                    parentTypeId: (ztypes.tid.create from: fid.u64)
                    name: pname
                    targetDecl: pArmDecl
                )
            }
        }
    }
}

# registerValueParam -- record an ordinary (non-generic, non-receiver) parameter
# on its function's type: its declared type, its ownership, and the default it
# carries.
registerValueParam: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    rf: ztypes.declid
    fid: u64
    thisName: StringView
    ptnT: StringView
    pm: argref
} is {
    # an owned copy: the registrations below lend ast
    pname: zast.nameTextCopy :ast ref: pm.name
    cid: (resolveTyperefShell
        :st
        frame: rf

        :ast
        :unitDecl
        nid: pm.operation
        :thisName
    )
    (st.typing.setMemberType
        parentTypeId: (ztypes.tid.create from: fid.u64)
        nameId: pm.name
        childTypeId: cid
    )
    if (isNumericLiteralName name: ptnT) then {
        (st.typing.setDefaultLiteral
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: fid.u64)
            name: pname.stringView
            node: pm.operation
        )
    } else {
        (checkParamTypeShape
            :st
            :ast
            :unitDecl
            :rf
            :cid
            :ptnT
            pname: pname.stringView
            :fid
            :pm
        )
    }
    if (paramIsThisReceiver :ast op: (ast.nodes.get i: pm.operation.u64)) then {
        (st.reg.setThisParamName
            typeId: (ztypes.tid.create from: fid.u64)
            nameId: pm.name
        )
    }
    (recordTyperef
        :st
        frame: rf

        :ast
        :unitDecl
        :thisName
        nid: pm.operation
    )
    pown: pathOwnership :ast n: (ast.nodes.get i: pm.operation.u64)
    match (
        pown
    ) case some then {
        (st.typing.setChildOwnership
            pool: ast.names
            parentTypeId: (ztypes.tid.create from: fid.u64)
            name: pname.stringView
            ownership: pown
        )
    } case none then {
        isref: (paramIsBorrowReftype
            :st
            frame: rf
            :ast

            :unitDecl
            :thisName
            opId: pm.operation
        )
        if isref then {
            (st.typing.setChildOwnership
                pool: ast.names
                parentTypeId: (ztypes.tid.create from: fid.u64)
                name: pname.stringView
                ownership: ztypes.zparamownership.borrowMode
            )
        }
    }
}
# registerFnGenericParam -- record the function's OWN generic parameter: the
# canonical per-(function, parameter) tid, stamped on the parameter node so
# every reference in the signature resolves to the same type.
registerFnGenericParam: function {
    st: zenv.ZSymbolTable
    fid: u64
    fnDecl: ztypes.declid
    ptn: zast.nameid
    ptnT: StringView
    fnParam: bool
    pm: argref
} is {
    if fnParam then {
        # the template's own param: bind the canonical
        # per-(template,param) tid as the child so holder
        # inference and the idSubs clone substitution ride it.
        # No node stamp (fn monos re-walk the SHARED template
        # AST) and no typeref/demand recording (a user type
        # coincidentally named like the param must not bind).
        fpt: u64
        fpo: (st.reg.genericParamTidOf
            tdecl: fnDecl
            paramName: ptn
        )
        match (
            fpo
        ) case some then {
            fpt = fpo
        } case none then {
            fpt = (st.reg.newType
                name: ptnT
                typetype: ztypes.ztypetype.genericParam
            )
            (st.reg.setGenericParamTid
                tdecl: fnDecl
                paramName: ptn
                tid: (ztypes.tid.create from: fpt.u64)
            )
        }
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: fid.u64)
            nameId: pm.name
            childTypeId: fpt
        )
    }
}

# registerGenericOrReceiverParam -- record a parameter that is not an ordinary
# value: the function's own generic parameter, the enclosing type's, or the
# `this` receiver. Each binds a type without taking an argument slot.
registerGenericOrReceiverParam: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    fid: u64
    fnDecl: ztypes.declid
    receiverEnclDecl: ztypes.declid
    thisName: StringView
    genParam: bool
    fnParam: bool
    ptn: zast.nameid
    ptnT: StringView
    isRecvP: bool
    pm: argref
} is {
    # A dropped RECEIVER still records its alias: the vtable
    # emitters and methodReceiverIsView ask which parameter is the
    # receiver, and on a bodyless spec this is the only chance.
    if isRecvP then {
        # BIND the copy: an owned `String` return consumed inline
        # has no scope to die in and leaks on every dropped
        # receiver. The keep branch below binds `pname` for the
        # same reason.
        rcvNm: zast.nameTextAt :ast ref: pm.name
        (st.reg.setThisParamName
            typeId: (ztypes.tid.create from: fid.u64)
            nameId: pm.name
        )
        # ... and its MARKER. The name alone tells a caller which
        # parameter is the receiver; only the ownership row tells
        # it whether the call reads or writes, which is what
        # methodReceiverIsView asks. A bodyless spec has no other
        # chance to record it.
        rcvOw: pathOwnership :ast n: (ast.nodes.get i: pm.operation.u64)
        match (
            rcvOw
        ) case some then {
            (st.typing.setChildOwnership
                pool: ast.names
                parentTypeId: (ztypes.tid.create from: fid.u64)
                name: rcvNm.stringView
                ownership: rcvOw
            )
        } case none then null
    }
    (registerFnGenericParam
        :st
        :fid
        :fnDecl
        :ptn
        :ptnT
        :fnParam
        :pm
    )
    # the parameter's type IS a generic parameter -- the function's own
    # (fnParam) or the enclosing type's (genParam). Neither leg records a
    # type-ref, and the fn leg writes no node stamp either, so this is the only
    # point at which the node that spells it is known.
    gpFrame9: ztypes.declid
    if fnParam then gpFrame9 = fnDecl
    if genParam then gpFrame9 = receiverEnclDecl
    if (gpFrame9.isZero) == false then {
        recordGenericParamRef :st nid: pm.operation.u64 frame: gpFrame9 name: ptn
    }
    if genParam then {
        # the unit's own param: stamp the param node with the
        # canonical per-(enclosing,param) tid (get-or-mint). No
        # member type -- unit template methods stay childless (emit
        # `(void)`); unit bodies clone, so the stamp is per-clone.
        gpt2: u64
        gpo2: (st.reg.genericParamTidOf
            tdecl: receiverEnclDecl
            paramName: ptn
        )
        match (
            gpo2
        ) case some then {
            gpt2 = gpo2
        } case none then {
            gpt2 = (st.reg.newType
                name: ptnT
                typetype: ztypes.ztypetype.genericParam
            )
            (st.reg.setGenericParamTid
                tdecl: receiverEnclDecl
                paramName: ptn
                tid: (ztypes.tid.create from: gpt2.u64)
            )
        }
        pnid2: nodeId n: (ast.nodes.get i: pm.operation.u64)
        (ztyping.nodeTypeSet
            tbl: st.typing.nodeType
            nid: pnid2.u64
            tid: (ztypes.tid.create from: gpt2.u64)
        )
        if thisName.length != 0 then {
            (st.typing.setMemberType
                parentTypeId: (ztypes.tid.create from: fid.u64)
                nameId: pm.name
                childTypeId: gpt2
            )
        }
    }
}


# resolveFunctionParam -- resolve one parameter of a function signature: its
# type and ownership, and the generic or receiver role that exempts it from
# being an ordinary parameter.
resolveFunctionParam: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    rf: ztypes.declid
    fid: u64
    fnDecl: ztypes.declid
    receiverEnclDecl: ztypes.declid
    isgen: bool
    thisName: StringView
    skipThisType: bool
    pmId: u32
} is {
    pm: argRefAt :ast nid: (zast.nodeid.create from: pmId.u32)
    if (pm.nid.isZero) == false then {
        skipParam: false
        genParam: false
        fnParam: false
        ptn: atomNameId :ast n: (ast.nodes.get i: pm.operation.u64)
        # an owned copy: the walks below lend ast
        ptnT: zast.nameTextCopy :ast ref: ptn
        # A MARKED receiver is an alias, so its type is `this.view` rather
        # than the bare `this` an atom name reports. Ask the shared
        # predicate, which knows every marker form.
        isRecvP: (paramIsThisReceiver
            :ast
            op: (ast.nodes.get i: pm.operation.u64)
        )
        if skipThisType then {
            # BOTH tests are load-bearing. The atom-name test catches the
            # bare `:this` shorthand, whose operation node does not carry
            # the well-known `this` name id that paramIsThisReceiver checks;
            # the predicate catches every MARKED form, whose type is a
            # dotted path and so has no atom name at all. Dropping either
            # leaves that family of receivers as ordinary parameters.
            if ptn == zast.names.wkThis then skipParam = true
            if isRecvP then skipParam = true
        }
        if skipParam == false when isgen then {
            if (st.reg.isGenericParamOf
                tdecl: fnDecl
                name: ptn
            ) then {
                skipParam = true
                fnParam = true
            }
        }
        if skipParam == false when (st.reg.isGenericParamOf
            tdecl: receiverEnclDecl
            name: ptn
        ) then {
            skipParam = true
            genParam = true
        }
        if skipParam then {
            (registerGenericOrReceiverParam
                :st
                :ast
                :fid
                :fnDecl
                :receiverEnclDecl
                :thisName
                :genParam
                :fnParam
                :ptn
                ptnT: ptnT.stringView
                :isRecvP
                :pm
            )
        } else {
            (registerValueParam
                :st
                :ast
                :unitDecl
                :rf
                :fid
                :thisName
                ptnT: ptnT.stringView
                :pm
            )
        }
    }
}
# recordFunctionReturn -- record what a function returns on its type: the
# declared return, the partial specialisation a collection template declares
# instead, and the borrow or takex marker the return carries.
recordFunctionReturn: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    rf: ztypes.declid
    fid: u64
    isgen: bool
    fnDecl: ztypes.declid
    receiverEnclDecl: ztypes.declid
    fnode: fnref
} is {
    rpt4: u64
    frOpt: fnode.returntype
    if isgen then {
        rpt4 = returnParamTid :st :ast enclDecl: fnDecl oId: frOpt
    }
    if rpt4 == 0 then {
        frOpt9b: fnode.returntype
        rpt4 = returnParamTid :st :ast enclDecl: receiverEnclDecl oId: frOpt9b
    }
    if rpt4 > 0 then {
        st.reg.setReturnType typeId: (ztypes.tid.create from: fid.u64) value: rpt4
        # a method whose return is a generic param (its own OR the enclosing
        # type's) is a per-instance clone candidate: mintMono's clone loop
        # (gated on isgeneric) must substitute the return for each mono
        st.reg.setGeneric typeId: (ztypes.tid.create from: fid.u64) value: true
    }
    if rpt4 == 0 when unitDecl == st.typing.collectionsUnitRoot then {
        # collection template methods declare composite parameterized returns
        # ((ListIter of: of).borrow); they resolve to partial specs so clones
        # heal through respecialize.
        prt4: (partialReturnTid
            :st
            frame: rf

            :ast
            :unitDecl
            enclDecl: receiverEnclDecl
            oId: fnode.returntype
        )
        if prt4 > 0 then st.reg.setReturnType typeId: (ztypes.tid.create from: fid.u64) value: prt4
    }
    if (returnHasBorrowMarker :ast oId: fnode.returntype) then {
        fbk: fid
        fbv: true
        st.typing.funcReturnsBorrow.set key: fbk value: fbv
        if (returnHasViewMarker :ast oId: fnode.returntype) then {
            fvk: fid
            fvv: true
            st.typing.funcReturnsView.set key: fvk value: fvv
        }
    }
    if (returnHasTakexMarker :ast oId: fnode.returntype) then {
        fxk: fid
        fxv: true
        st.typing.funcReturnsTakex.set key: fxk value: fxv
    }
}
# finishFunctionSignature -- close a function's signature once its parameters
# are recorded: demand and record the return, check the borrow-return lock, and
# mark the declaration resolved.
finishFunctionSignature: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    rf: ztypes.declid
    fid: u64
    dfid: u64
    isgen: bool
    fnDecl: ztypes.declid
    receiverEnclDecl: ztypes.declid
    defName: StringView
    thisName: StringView
    fnode: fnref
} is {
    demandReturnType :st frame: rf :ast :unitDecl oId: fnode.returntype
    (recordReturnType
        :st
        frame: rf

        :ast
        :unitDecl
        :thisName
        oId: fnode.returntype
    )
    recordFuncReturnNode :st :ast fid: (ztypes.tid.create from: fid.u64) oId: fnode.returntype
    (stampGenericParamRef
        :st

        :ast
        enclDecl: receiverEnclDecl
        oId: fnode.returntype
    )
    (recordGenericMarkerReturn
        :st
        frame: rf

        :ast
        enclDecl: receiverEnclDecl
        oId: fnode.returntype
    )
    (recordFunctionReturn :st :ast :unitDecl :rf :fid :isgen :fnDecl :receiverEnclDecl :fnode)
    checkBorrowReturnLock :st :ast :fnode :defName
    if (fnDecl.isZero) == false then {
        st.typing.declSetType declId: fnDecl typeId: (ztypes.tid.create from: dfid.u64)
        st.reg.setDef typeId: (ztypes.tid.create from: dfid.u64) declId: fnDecl
    }
    dfp: false
    if (st.reg.defOf tid: (ztypes.tid.create from: dfid.u64)).u64 == 0 then dfp = true
    if dfp then {
        # neither a free-fn Decl nor a member Decl (a synthesized function
        # like a generic-unit template's flattened method): attribute it
        # to the unit's root Decl
        dfr: unitDecl
        if (dfr.isZero) == false then {
            st.reg.setDef typeId: (ztypes.tid.create from: dfid.u64) declId: dfr
        }
    }
}
# registerFnGenericParams -- record a generic function's own parameter list on
# its declaration, so the signature walk and every later instantiation agree on
# which names are parameters.
registerFnGenericParams: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    fnDecl: ztypes.declid
    fid: u64
    fnode: fnref
} is {
    st.reg.setGeneric typeId: (ztypes.tid.create from: fid.u64) value: true
    # Function templates register their param constraints like type
    # templates do (checkGenericCall checks satisfaction per call).
    # the as-items are read through a view scoped to this block
    {
        fn: ast.nodes.get i: fnode.nid.u64
        match (
            fn
        ) case functiondef then {
            registerGenericParams :st :ast tdecl: fnDecl items: fn.asItems
        } else null
    }
    hasB: fnode.body > 0
    if hasB then {
        dvg: bodyEndsInReturn :ast bodyId: fnode.body
        fidd: fid
        st.typing.fnBodyDiverges.set key: fidd value: dvg
    }
}
# recordFnBodyPresence -- note whether a function has a body: a bodyless one is
# a spec method, which the emitter renders as a vtable slot rather than code.
recordFnBodyPresence: function {
    st: zenv.ZSymbolTable
    fid: u64
    fnode: fnref
} is {
    {
        fhbV: fnode.body > 0
        fhbK: fid
        st.typing.fnHasBody.set key: fhbK value: fhbV
    }
}
# receiverOwnerDecl -- the declaration a method's receiver belongs to: its owner
# type for a method, the enclosing unit for a free function.
receiverOwnerDecl: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
    rf: ztypes.declid
    thisName: StringView
} out ztypes.declid is {
    receiverEnclDecl: ztypes.declid
    if thisName.length != 0 then {
        receiverEnclDecl = (declOfUnitDef
            :st
            frame: rf
            :unitDecl
            nameId: (nameIdOf :ast name: thisName)
        )
    } else {
        ero: unitDecl
        if (ero.isZero) == false then receiverEnclDecl = ero
    }
    return receiverEnclDecl
}
# fnSignatureFrame -- the frame a function's signature resolves in: a METHOD's
# own declaration, under its owner's, since a free function's caller has
# already entered its frame. A method the name index cannot place keeps the
# caller's frame.
fnSignatureFrame: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
    frame: ztypes.declid
    ownerNameId: zast.nameid
    defName: StringView
} out ztypes.declid is {
    rf: frame
    if (ownerNameId.isZero) == false then {
        od: declOfUnitDef :st frame: rf :unitDecl nameId: ownerNameId
        if (od.isZero) == false then {
            fd: st.typing.declFindChild parentDeclId: od nameId: (nameIdOf :ast name: defName)
            if (fd.isZero) == false then rf = fd
        }
    }
    return rf
}


# resolve a function definition: its parameters, return type, and body.
resolveFunction: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    # a method's owner, by interned name id; 0 for a free function
    ownerNameId: zast.nameid
    defName: StringView
    fnId: zast.nodeid
    thisName: StringView
    skipThisType: bool
} out u64 is {
    # a METHOD's signature resolves in the frame of its declaration, under
    rf: (fnSignatureFrame :st :ast :unitDecl :frame :ownerNameId :defName)
    fid: (declareCanonicalType
        :st
        frame: rf
        :ast

        :unitDecl
        :ownerNameId
        name: defName
        typetype: ztypes.ztypetype.functionType
    )
    fnode: fnRefAt :ast nid: fnId
    st.reg.setNative typeId: (ztypes.tid.create from: fid.u64) value: fnode.isNative
    recordFnBodyPresence :st :fid :fnode
    dfid: fid
    rfid: fid
    # the as-items are read through a view scoped to this block: the walks
    # below lend ast
    isgen: false
    {
        fn: ast.nodes.get i: fnId.u64
        match (
            fn
        ) case functiondef then {
            isgen = hasGenericParam :ast items: fn.asItems
        } else null
    }
    fnDecl: declOfFnDef :st frame: rf :ast :unitDecl :ownerNameId :defName :thisName
    # link the declaration to its type up front: the parameter loop below
    # records ownership and defaults on member declarations, which needs the
    # owner reachable from its type id.
    if (fnDecl.isZero) == false then (st.typing.declSetType
        declId: fnDecl
        typeId: (ztypes.tid.create from: dfid.u64)
    )
    if isgen then {
        registerFnGenericParams :st :ast :fnDecl :fid :fnode
    }
    receiverEnclDecl: (receiverOwnerDecl :st :ast :unitDecl :rf :thisName)
    sgkPrev: st.typing.sigGenericDecl
    if isgen then st.typing.sigGenericDecl = fnDecl
    kP: u64
    for kP < fnode.nparams loop {
        pmId: (zast.fnParamAt :ast nid: fnId i: kP).u32
        kP = kP + 1
        (resolveFunctionParam
            :st
            :ast
            :unitDecl
            :rf
            :fid
            :fnDecl
            :receiverEnclDecl
            :isgen
            :thisName
            :skipThisType
            :pmId
        )
    }
    (finishFunctionSignature
        :st
        :ast
        :unitDecl
        :rf
        :fid
        :dfid
        :isgen
        :fnDecl
        :receiverEnclDecl
        :defName
        :thisName
        :fnode
    )
    st.typing.sigGenericDecl = sgkPrev
    return rfid
}


# paramIsBorrowReftype -- the default-ownership rule for a parameter with no
# explicit suffix: user reftypes (and the borrow-default native reftypes /
# collections) borrow; native value views do not.
paramIsBorrowReftype: function {ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    thisName: StringView
    opId: zast.nodeid
} out bool is {
    # an owned copy: the walks below lend ast
    tn: zast.nameTextCopy :ast ref: (atomNameId :ast n: (ast.nodes.get i: opId.u64))
    isref: false
    if tn.stringView == "this" then {
        isref = nameIsInUnitReftype :st :ast :unitDecl name: thisName
        if (isref) == false then {
            tk0: (zast.poolFind pool: ast.names text: thisName).u64
            rgo: st.typing.mainDefIsReftype.get key: tk0
            match (
                rgo
            ) case some then {
                isref = rgo
            } case none then null
        }
        if (isNativeValueView name: thisName) then isref = false
    } else {
        if tn.length == 0 then {
            base: paramTypeBaseName :ast op: (ast.nodes.get i: opId.u64)
            isref = isBorrowReftypeCollection name: base.stringView
        } else {
            isref = nameIsInUnitReftype :st :ast :unitDecl name: tn.stringView
            tdu: (definingSiteFor :st :frame :ast :unitDecl name: tn.stringView).defUnit
            if (isBorrowNativeReftype name: tn.stringView) when tdu == st.typing.systemUnitRoot then {
                isref = true
            }
            if (isNativeValueView name: tn.stringView) when tdu == st.typing.systemUnitRoot then {
                isref = false
            }
        }
    }
    return isref
}

# resolveMethodFn -- resolve one record-method as-item (a namedoperation whose
# operation is a functiondef) into a qualified `{record}.{method}` FUNCTION type,
# `this` params bound to thisName (the record). Returns its type id, or none for a
# non-function as-item (tag spec / generic param), which the caller skips.
resolveMethodFn: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    ownerNameId: zast.nameid
    mname: StringView
    thisName: StringView
    opId: zast.nodeid
} out optionval u64 is {
    arm: rowArmAt :ast nid: opId
    match (
        arm
    ) case functiondef then {
        mid: (resolveFunction
            :st
            :frame

            :ast
            :unitDecl
            :ownerNameId
            defName: mname
            fnId: opId
            :thisName
            skipThisType: false
        )
        (ztyping.nodeTypeSet
            tbl: st.typing.nodeType
            nid: opId.u64
            tid: (ztypes.tid.create from: mid.u64)
        )
        return (optionval.some mid)
    } else {
        return (optionval.none u64)
    }
}

# resolveMethodFnLazy -- resolveMethodFn under the member-demand mode. The item
# is still reported AS a method, carrying no type yet; forceMemberDecl mints the
# signature when a consumer first needs it. `lazyOk` is false where the caller
# READS the returned id rather than only recording it -- a generic class's
# methods feed st.reg.setGeneric, and a unit template's feed declLinkTemplateMethod.
resolveMethodFnLazy: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    ownerNameId: zast.nameid
    mname: StringView
    thisName: StringView
    opId: zast.nodeid
    lazyOk: bool
} out optionval u64 is {
    isFnDef: false
    {
        arm: rowArmAt :ast nid: opId
        match (
            arm
        ) case functiondef then {
            isFnDef = true
        } else null
    }
    if lazyOk when (st.typing.eagerAll) == false when isFnDef then return (optionval.some 0.u64)
    return (resolveMethodFn
        :st
        :frame
        :ast
        :unitDecl
        :ownerNameId
        :mname
        :thisName
        :opId
    )
}

# stampMemberSignature -- stamp a member's return and parameter type-refs.
# paramTypeId and methodReturnOf both read the node stamp first, and
# stampTyperefs has already run by the time a member resolves on demand, so
# without this every parameter -- `this` included -- binds to nothing.
# Idempotent: stampForcedTyperef skips a node that already carries a type.
stampMemberSignature: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    thisName: StringView
    ownerTid: u64
    fnNodeId: u32
    mid: u64
} is {
    # the member's type-refs resolve in its owner's frame
    rf: frame
    {
        od: declOfTypeId :st tid: (ztypes.tid.create from: ownerTid.u64)
        if (od.isZero) == false then rf = od
    }
    rn: optU64Or o: (st.typing.funcReturnNode.get key: (ztypes.tid.create from: mid.u64)) d: 0
    stampForcedTyperef :st frame: rf :ast :unitDecl :thisName nid: rn
    if fnNodeId == 0 then return
    fr: fnRefAt :ast nid: (zast.nodeid.create from: fnNodeId.u32)
    if (fr.nid.isZero) == false then {
        kP: u64
        for kP < fr.nparams loop {
            pId: (zast.fnParamAt :ast nid: fr.nid i: kP).u32
            kP = kP + 1
            pn: argRefAt :ast nid: (zast.nodeid.create from: pId.u32)
            if (pn.nid.isZero) == false then {
                # the parameter's root name is read through a view scoped to
                # this block: the stamp below lends ast
                isThisRoot: false
                {
                    pRoot: (zast.nameTextAt
                        :ast
                        ref: (rootNameIdOf :ast n: (ast.nodes.get i: pn.operation.u64))
                    )
                    isThisRoot = pRoot.stringView == "this"
                }
                if isThisRoot then {
                    (ztyping.nodeTypeSet
                        tbl: st.typing.nodeType
                        nid: pn.operation.u64
                        tid: (ztypes.tid.create from: ownerTid.u64)
                    )
                } else {
                    (stampForcedTyperef
                        :st
                        frame: rf

                        :ast
                        :unitDecl
                        :thisName
                        nid: pn.operation.u64
                    )
                }
            }
        }
    }
}


# forceMemberDecl -- resolve one member's signature on demand: the rung below
# descendNamed. The grey / done marks are read off the MEMBER's own Decl rather
# than its type's, because the conversion lattice cycles through members --
# u8's `.i128` names i128, whose `.u8` names u8 -- and a member reached while its
# owner is still resolving is not the owner's back-edge.
forceMemberDecl: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    memberDeclId: ztypes.declid
} out optionval u64 is {
    isM: false
    have: u64
    mnm: u32
    mnd: u32
    par: ztypes.declid
    {
        memberDecl: st.typing.decls.get i: memberDeclId.u64
        if memberDecl.kind.methodDecl then isM = true
        have = memberDecl.typeId
        mnm = memberDecl.name
        mnd = memberDecl.node
        par = memberDecl.parent
    }
    if have > 0 then return (optionval.some have)
    if (st.typing.declIsDefined declId: memberDeclId) then return (optionval.none u64)
    if (st.typing.declIsResolving declId: memberDeclId) then return (optionval.none u64)
    if mnd == 0 then return (optionval.none u64)
    otid: u64
    onm: u32
    {
        po: st.typing.decls.get i: par.u64
        otid = po.typeId
        onm = po.name
    }
    if otid == 0 then return (optionval.none u64)
    opId: u32
    {
        nn: ast.nodes.get i: mnd.u64
        if nn.namedoperation then opId = nn.operation
    }
    if opId == 0 then return (optionval.none u64)
    unD: unitDeclOfTid :st tid: (ztypes.tid.create from: otid.u64)
    if unD.isZero then return (optionval.none u64)
    tn: zast.poolTextAt pool: ast.names ref: (zast.nameid.create from: onm)
    mn: zast.poolTextAt pool: ast.names ref: (zast.nameid.create from: mnm)
    st.typing.declSetResolving declId: memberDeclId mark: true
    memberIdAt: (optionval.none u64)
    if isM then {
        memberIdAt = (resolveMethodFn
            :st
            :frame

            :ast
            unitDecl: unD
            ownerNameId: (zast.nameid.create from: onm)
            mname: mn.stringView
            thisName: tn.stringView
            opId: (zast.nodeid.create from: opId)
        )
    } else {
        # an as-block MARKER designates a type rather than declaring a field
        memberIdAt = (markerTargetId
            :st
            :frame

            unitDecl: unD
            :ast
            opNid: (zast.nodeid.create from: opId)
        )
    }
    st.typing.declSetResolving declId: memberDeclId mark: false
    st.typing.declSetDefined declId: memberDeclId
    match (
        memberIdAt
    ) case some then null case none then null
    match (
        memberIdAt
    ) case some then {
        if isM then (stampMemberSignature
            :st
            :frame

            :ast
            unitDecl: unD
            thisName: tn.stringView
            ownerTid: otid
            fnNodeId: opId
            mid: memberIdAt
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: otid.u64)
            nameId: (zast.nameid.create from: mnm)
            childTypeId: memberIdAt
        )
        return (optionval.some memberIdAt)
    } case none then null
    return (optionval.none u64)
}

# stampForcedTyperef -- stamp one type-ref node that resolved AFTER stampTyperefs
# ran. recordFuncReturnNode routes a call site's return type through the node
# stamp, and stampTyperefs fills those before the body walk -- so a member forced
# DURING the body walk records its return type-ref too late and reads back as
# null. Mirrors that pass's success leg for the one node.
stampForcedTyperef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    thisName: StringView
    nid: u64
} is {
    if nid == 0 then return
    # an ownership marker (`zlexer.Token.view`) is not part of the type.
    # paramTypeId peels it and reads the PARENT's stamp, so that is the node
    # to stamp -- stamping the marker node leaves the parameter untyped.
    tnid: nid
    peel: u64
    for peel < 4 loop {
        peel = peel + 1
        stop: true
        {
            pk: ast.nodes.get i: tnid
            match (
                pk
            ) case dottedpath then {
                mcn: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: pk.child.u64))
                if (isStripMarker name: mcn.stringView) then {
                    tnid = pk.parent.u64
                    stop = false
                }
            } else null
        }
        if stop then peel = 4
    }
    if tnid == 0 then return
    if (ztyping.nodeTypeAt tbl: st.typing.nodeType nid: tnid) > 0 when (ztyping.nodeTypeAt
        tbl: st.typing.nodeType
        :nid
    ) > 0 then return
    # the real resolver first: it handles a PARAMETERIZED type-expr
    # (`out (resultval t: u32 e: converror)`), where a base name would name the
    # TEMPLATE and stamping that is worse than not stamping at all.
    {
        rs: (resolveTyperefShell
            :st
            :frame

            :ast
            :unitDecl
            nid: (zast.nodeid.create from: tnid.u32.orPanic)
            :thisName
        )
        if rs > 0 then {
            (ztyping.nodeTypeSet
                tbl: st.typing.nodeType
                nid: tnid
                tid: (ztypes.tid.create from: rs.u64)
            )
            ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: (ztypes.tid.create from: rs.u64)
            return
        }
    }
    # a DOTTED return (`out zast.nodeid`) names its type in another unit, which
    # no single base name reaches
    {
        # an owned copy: the walks below lend ast
        rootN: zast.nameTextCopy :ast ref: (rootNameIdOf :ast n: (ast.nodes.get i: tnid))
        # an owned copy: the walks below lend ast
        childN: zast.nameTextCopy :ast ref: (dottedChildNameId :ast n: (ast.nodes.get i: tnid))
        if childN.length > 0 when rootN.length > 0 then {
            hUnitDecl: unitDeclOfNameOrOwn :st :frame nameId: (nameIdOf :ast name: rootN.stringView)
            dd: (descendNamed
                :st
                :frame

                :ast
                unitDecl: hUnitDecl
                name: childN.stringView
            )
            if dd > 0 then {
                ztyping.nodeTypeSet tbl: st.typing.nodeType nid: tnid tid: dd
                ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: dd
                return
            }
        }
    }
    # the base name: from the pending record when the demand pass saw this
    # node, else off the type-expr itself -- a member resolved on demand never
    # went through a pass that records one
    recvBaseTid: String
    {
        pv: st.typing.pendingTyperef.get key: tnid
        match (
            pv
        ) case some then {
            pvT: zast.nameTextAt :ast ref: pv
            recvBaseTid = pvT.copy
        } case none then null
    }
    if recvBaseTid.length == 0 then recvBaseTid = (baseTypeName :ast n: (ast.nodes.get i: tnid))
    if recvBaseTid.length == 0 then return
    r: walkLookupTyperef :st :frame :ast :unitDecl base: recvBaseTid.stringView
    match (
        r
    ) case some then {
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: tnid tid: (ztypes.tid.create from: r.u64)
        ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: (ztypes.tid.create from: r.u64)
        return
    } case none then null
    # the name resolves nowhere because nothing ever demanded it: a member
    # resolved on demand can be the FIRST reference to a type, and the demand
    # fixpoint finished before the body walk. Descend into it here.
    dn: descendNamed :st :frame :ast :unitDecl name: recvBaseTid.stringView
    if dn > 0 then {
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: tnid tid: dn
        ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: dn
        return
    }
    r9b: walkLookupTyperef :st :frame :ast :unitDecl base: recvBaseTid.stringView
    match (
        r9b
    ) case some then {
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: tnid tid: (ztypes.tid.create from: r9b.u64)
        ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: (ztypes.tid.create from: r9b.u64)
    } case none then null
}

# forceMemberOf -- the member `nameId` of `parentTypeId`, resolved if it is not
# yet. The by-NAME demand point: declChildOfId is a readonly view holding no
# registry and no ast, so it can never resolve anything itself -- every force
# sits in front of a lookup, never inside one.
forceMemberOf: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    parentTypeId: ztypes.tid
    nameId: zast.nameid
} is {
    if st.typing.eagerAll then return
    if nameId.isZero then return
    md: st.typing.declMemberIdOf :parentTypeId :nameId
    if md.isZero then return
    forceMemberDecl :st :frame :ast memberDeclId: md
}

# forceUnitDefMember -- force `unit.def.member` from ids. Body checking reaches
# a method by NAME rather than through a receiver's type, so it is the one
# demand point that cannot go through a tid.
forceUnitDefMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defId: zast.nameid
    memberId: zast.nameid
} is {
    if st.typing.eagerAll then return
    dd: declOfUnitDefIds :st :unitDecl nameId: defId
    if dd.isZero then return
    md: st.typing.declFindChild parentDeclId: dd nameId: memberId
    if md.isZero then return
    forceMemberDecl :st :frame :ast memberDeclId: md
}

# forceUnitDef -- resolve ONE top-level TYPE definition of a unit now, and
# answer its type id (0 when it does not resolve). Every other `force*` resolves
# a MEMBER, and every resolver of a DEFINITION is a whole-unit loop, so a caller
# holding a single member node -- the method walk -- had no way to say "resolve
# this owner first". It walked the bodies regardless, with the owner's Decl
# still carrying typeId 0: `this` typed as notype, so a correct body was
# REJECTED and a wrong return type was ACCEPTED, one per body shape. The probe
# it used (resolveUnitChild) cannot mint -- a probe reads what resolution left.
forceUnitDef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    memId: u32
} out u64 is {
    nmId: zast.nameid
    opId: zast.nodeid
    {
        mm: ast.nodes.get i: memId.u64
        if mm.namedoperation then {
            nmId = mm.name
            opId = mm.operation
        }
    }
    if nmId.isZero then return 0
    uId: unitNameIdOf :st :unitDecl
    uDecl9b: unitDeclOfName :st nameId: uId
    {
        got: resolvedByIds :st :ast unitDecl: uDecl9b name: nmId
        match (
            got
        ) case some then {
            return got.u64
        } case none then null
    }
    if opId.isZero then return 0
    # a TYPE only: a namespace, a template and a function each reach their own
    # resolver, and none of them owns the method bodies this guards.
    isObj: false
    {
        oo: ast.nodes.get i: opId.u64
        if oo.objectdef then isObj = true
    }
    if (isObj) == false then return 0
    if (defWasResolved :st :frame :unitDecl nameId: nmId) then return 0
    # re-entry: a method that constructs its own type walks back through here
    # while the definition is mid-resolution.
    if (st.typing.declIsResolving declId: (declOfUnitDefIds
        :st
        unitDecl: uDecl9b
        nameId: nmId
    )) then return 0
    dn: zast.poolTextAt pool: ast.names ref: nmId
    (resolveDef
        :st
        :frame

        :ast
        :unitDecl
        defName: dn.stringView
        defnId: (zast.nodeid.create from: opId.u32)
    )
    ro: resolvedByIds :st :ast unitDecl: uDecl9b name: nmId
    match (
        ro
    ) case some then {
        return ro.u64
    } case none then null
    return 0
}

# forceAllMembers -- every member signature of `tid`, in declaration order. The
# WALK demand point: a caller reading a member LIST (the mono clone, the
# emitter's member tables) cannot name what it has not seen, and an unresolved
# member carries no type so declChildWalk skips it silently.
forceAllMembers: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    tid: ztypes.tid
} is {
    if st.typing.eagerAll then return
    od: st.typing.declIdOfType typeId: tid
    if od.isZero then return
    n: st.typing.declChildSlots declId: od
    i: u64
    for i < n loop {
        did: st.typing.declChildAt declId: od index: i
        i = i + 1
        if (did.isZero) == false then {
            forceMemberDecl :st :frame :ast memberDeclId: did
        }
    }
}

# forceAllFields -- every FIELD signature of `tid`, in declaration order: the
# members a field walk consumes. A methodDecl is skipped unless it holds a
# function-pointer slot (an is-block `function {..} out T` with no body), which
# a field filter counts as a field. `fnptrField` is a declaration flag written
# before any signature resolves, so the test forces nothing itself. A method's
# own signature stays unresolved, and that is not a hole: a field filter admits
# a member only to find a FUNCTION type and drop it, which is exactly what it
# does with the type 0 an unresolved member carries.
forceAllFields: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    tid: ztypes.tid
} is {
    if st.typing.eagerAll then return
    od: st.typing.declIdOfType typeId: tid
    if od.isZero then return
    n: st.typing.declChildSlots declId: od
    i: u64
    for i < n loop {
        did: st.typing.declChildAt declId: od index: i
        i = i + 1
        if (did.isZero) == false then {
            want: true
            {
                memberDecl: st.typing.decls.get i: did.u64
                if memberDecl.kind.methodDecl when (memberDecl.fnptrField) == false then want = false
            }
            if want then {
                forceMemberDecl :st :frame :ast memberDeclId: did
            }
        }
    }
}

# functiondefIsNative -- an is-block method marked `is native` (no body to
# check or emit; its members come from the native materializer).
functiondefIsNative: function {op: Node.view} out bool is {
    match (
        op
    ) case functiondef then {
        return op.isNative
    } else {
        return false
    }
}

# isFunctionDefOp -- true when an is-block item's operation is a functiondef (a
# method), false for a field type-ref. Gates generic-class method production without
# resolving the function: a generic class never gets a method FUNCTION type of its
# own, only its instances do.
isFunctionDefOp: function {op: Node.view} out bool is {
    match (
        op
    ) case functiondef then {
        return true
    } else {
        return false
    }
}

# resolveSpecFn -- resolve one facet/protocol is-block spec method (a namedoperation
# whose operation is a functiondef) into a qualified `{type}.{spec}` FUNCTION. Like
# resolveMethodFn but drops the `:this` receiver: a facet/protocol `this` resolves to
# nothing, so the spec keeps only its real params.
resolveSpecFn: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    ownerNameId: zast.nameid
    mname: StringView
    thisName: StringView
    opId: zast.nodeid
    skipThis: bool
} out optionval u64 is {
    arm: rowArmAt :ast nid: opId
    match (
        arm
    ) case functiondef then {
        sid: (resolveFunction
            :st
            :frame

            :ast
            :unitDecl
            :ownerNameId
            defName: mname
            fnId: opId
            :thisName
            skipThisType: skipThis
        )
        (ztyping.nodeTypeSet
            tbl: st.typing.nodeType
            nid: opId.u64
            tid: (ztypes.tid.create from: sid.u64)
        )
        return (optionval.some sid)
    } else {
        return (optionval.none u64)
    }
}

# markerTargetId -- the FACET/PROTOCOL type a conformance as-item points at
# (`m: measurable` / `myreader: Reader`), or none for a method / `create: null` /
# any other as-item. A marker is a reference: its target resolves on discovery,
# depth-first, before anything is asked of it -- the conformer's destructor
# follows the target's, which exists only once the target's body resolved, so
# the order the two are written in cannot decide it.
markerTargetId: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    ast: Ast
    opNid: zast.nodeid
} out optionval u64 is {
    nameId: zast.nameid
    {
        op: ast.nodes.get i: opNid.u64
        nameId = atomNameId :ast n: op
    }
    if nameId.isZero then return (optionval.none u64)
    {
        mnm: zast.poolTextAt pool: ast.names ref: nameId
        duo: (definingSiteFor :st :frame :ast :unitDecl name: mnm.stringView).defUnit
        if (duo.isZero) == false then {
            descendNamed :st :frame :ast unitDecl: duo name: mnm.stringView
        }
    }
    rr: (resolvedByIds
        :st
        :ast
        :unitDecl
        name: nameId
    )
    match (
        rr
    ) case some then {
        tt: st.reg.typetypeOf typeId: (ztypes.tid.create from: rr.u64)
        match (
            tt
        ) case facetType then {
            return (optionval.some rr)
        } case protocolType then {
            return (optionval.some rr)
        } case recordType then {
            return (optionval.some rr)
        } else {
            return (optionval.none u64)
        }
    } case none then {
        return (optionval.none u64)
    }
}

# eqNullOptOut -- true when a type's `as {}` block opts out of equality by
# declaring `==: null` or `!=: null` (mirrors the `create: null` opt-out): the
# record / variant synthetic `==` / `!=` is then suppressed, so a comparison on
# the type resolves no method and is a hard error.
# memberNullOptOut -- true when a type's `as {}` block defines `member` as
# `null`, the language's way of striking a compiler-provided member off a type.
# asDeclaresMember -- the as-block declares `member` as a real definition (not
# the `member: null` opt-out shell). The synthesised valtype defaults must
# YIELD to it: `hasEqIs` is computed from the IS-block alone, so without this a
# record whose `==` lives in its `as` block would get a synthesised `==` minted
# on top of the author's, and the emitter would pick the synthesised one.
asDeclaresMember: function {
    ast: Ast.view
    asItems: (ListVal u32).view
    member: StringView
} out bool is {
    result: false
    with aiter: asItems.iterate do for amId: aiter loop {
        am: ast.nodes.get i: amId.u64
        match (
            am
        ) case namedoperation then {
            mn: zast.nameTextAt :ast ref: am.name
            if mn.stringView == member then {
                vn: (zast.nameTextAt
                    :ast
                    ref: (atomNameId :ast n: (ast.nodes.get i: am.operation.u64))
                )
                if vn.stringView != "null" then result = true
            }
        } else null
    }
    return result
}

memberNullOptOut: function {
    ast: Ast.view
    asItems: (ListVal u32).view
    member: StringView
} out bool is {
    result: false
    with aiter: asItems.iterate do for amId: aiter loop {
        am: ast.nodes.get i: amId.u64
        match (
            am
        ) case namedoperation then {
            mn: zast.nameTextAt :ast ref: am.name
            if mn.stringView == member then {
                vn: (zast.nameTextAt
                    :ast
                    ref: (atomNameId :ast n: (ast.nodes.get i: am.operation.u64))
                )
                if vn.stringView == "null" then result = true
            }
        } else null
    }
    return result
}

eqNullOptOut: function {ast: Ast.view asItems: (ListVal u32).view} out bool is {
    result: false
    with aiter: asItems.iterate do for amId: aiter loop {
        am: ast.nodes.get i: amId.u64
        match (
            am
        ) case namedoperation then {
            mn: zast.nameTextAt :ast ref: am.name
            isEqNe: false
            if mn.stringView == "==" then isEqNe = true
            if mn.stringView == "!=" then isEqNe = true
            if isEqNe then {
                vn: (zast.nameTextAt
                    :ast
                    ref: (atomNameId :ast n: (ast.nodes.get i: am.operation.u64))
                )
                if vn.stringView == "null" then result = true
            }
        } else null
    }
    return result
}

# attachMethods -- resolve an as-block's method items (namedoperation -> functiondef)
# as children of `parentId`, returning whether one is named `create` (so the caller
# skips the synth create). Takes the item list by value so its iterator's lock is
# released on return -- letting attachMarkers re-scan the same list (cf. resolveUnion).
attachMethods: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    parentId: ztypes.tid
    objId: zast.nodeid
} out bool is {
    hasCreate: false
    # a generic template's methods are cloned BY ID into every instance
    # (mintMono reads a member list), so a template's signatures resolve eagerly
    agen: false
    {
        onA: ast.nodes.get i: objId.u64
        match (
            onA
        ) case objectdef then {
            agen = hasGenericParam :ast items: onA.asItems
        } else null
    }
    orf: objRefAt :ast nid: objId
    kAiter: u64
    for kAiter < orf.nas loop {
        amId: (zast.objAsItemAt :ast nid: objId i: kAiter).u32
        kAiter = kAiter + 1
        am: argRefAt :ast nid: (zast.nodeid.create from: amId.u32)
        if (am.nid.isZero) == false then {
            # an owned copy: the walks below lend ast
            mname: zast.nameTextCopy :ast ref: am.name
            if am.name == zast.names.wkCreate then hasCreate = true
            {
                mop: ast.nodes.get i: am.operation.u64
                match (
                    mop
                ) case functiondef then {
                    mr: fnRefOf fnode: mop
                    checkBorrowReturnLock :st :ast fnode: mr defName: mname.stringView
                    (checkTakexHonesty
                        :st
                        :ast
                        fnode: mr
                        thisTid: (ztypes.tid.create from: parentId.u64)
                        defName: mname.stringView
                    )
                } else null
            }
            ownerNmId: nameIdOf :ast name: defName
            mido: (resolveMethodFnLazy
                :st
                :frame

                :ast
                :unitDecl
                ownerNameId: ownerNmId
                mname: mname.stringView
                thisName: defName
                opId: am.operation
                lazyOk: (agen) == false
            )
            match (
                mido
            ) case some then {
                (st.typing.setMemberType
                    parentTypeId: parentId
                    nameId: am.name
                    childTypeId: mido
                )
            } case none then {
                cn: (zast.nameTextAt
                    :ast
                    ref: (atomNameId :ast n: (ast.nodes.get i: am.operation.u64))
                )
                if (isNumericLiteralName name: cn.stringView) then {
                    # A static constant's child is a per-constant NULL-unit
                    # clone of the literal's default type: named through the
                    # type_children join, filtered from typed_nodes.
                    clname: "i64"
                    if (isFloatLiteralName name: cn.stringView) then clname = "f64"
                    cid: st.reg.newType name: clname typetype: ztypes.ztypetype.recordType
                    (st.typing.setMemberType
                        parentTypeId: parentId
                        nameId: am.name
                        childTypeId: cid
                    )
                    st.typing.markAsConstClone typeId: cid
                    cnid3: nodeId n: (ast.nodes.get i: am.operation.u64)
                    ztyping.nodeTypeSet tbl: st.typing.nodeType nid: cnid3.u64 tid: cid
                }
            }
            gfn: "\{defName}_\{mname}"
            (synthGeneratorForMethod
                :st
                :frame

                :ast
                :unitDecl
                fnName: gfn.stringView
                thisName: defName
                opId: am.operation
            )
        }
    }
    return hasCreate
}

# attachMarkers -- resolve an as-block's facet/protocol conformance markers
# (`m: measurable` / `myreader: Reader`) as children of `parentId`, run AFTER the
# methods so markers take later positions. Returns whether any marker target owns a
# destructor (a protocol), so a class holder keeps its own.
# recordConformance -- record an impl-satisfies-spec conformance, but only when the
# spec resolves to a FACET or PROTOCOL (a RECORD marker like a numeric's `tag: tag` is a
# discriminator child, NOT a conformance). The helper C names (vtable/create/destroy/
# wrapper) are the emitter's and stay empty here.
recordConformance: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    implTypeId: u64
    specTypeId: u64
    label: StringView
    labelNameId: u64
} is {
    tt: st.reg.typetypeOf typeId: (ztypes.tid.create from: specTypeId.u64)
    recordIt: false
    isFacetC: false
    match (
        tt
    ) case facetType then {
        recordIt = true
        isFacetC = true
    } case protocolType then {
        recordIt = true
    } else null
    if recordIt then {
        cf: (st.reg.newConformance :implTypeId :specTypeId :label :labelNameId isFacet: isFacetC)
        st.typing.conformance.append cf
        # the vtable wrapper names every member the spec names, and it is
        # emitted from the conformance row rather than from a use site, so
        # nothing else would ever demand the impl's signatures
        forceAllMembers :st :frame :ast tid: (ztypes.tid.create from: implTypeId.u64)
    }
}

# attach the ownership/lock markers stamped during resolution to a definition.
attachMarkers: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    parentId: u64
    objId: zast.nodeid
} out bool is {
    needsDtor: false
    orf: objRefAt :ast nid: objId
    kMiter: u64
    for kMiter < orf.nas loop {
        mmId: (zast.objAsItemAt :ast nid: objId i: kMiter).u32
        kMiter = kMiter + 1
        # the marker is read through a view scoped to this block (an owned
        # copy of its operation's name): the recordings below lend ast
        isMarker: false
        mmOp: zast.nodeid
        mmName: zast.nameid
        cnm: String
        {
            mm: ast.nodes.get i: mmId.u64
            match (
                mm
            ) case namedoperation then {
                isMarker = true
                mmOp = mm.operation
                mmName = mm.name
                cnm = (zast.nameTextCopy
                    :ast
                    ref: (atomNameId :ast n: (ast.nodes.get i: mm.operation.u64))
                )
            } else null
        }
        if isMarker then {
            # `tag: tag` is not a field of the numeric record that carries it:
            # it designates the discriminator STORAGE type so a sum type can
            # spell `u8.tag`. A program declaring no sum type never names it,
            # so it resolves when something does -- forceMemberDecl.
            lazyTag: false
            if (st.typing.eagerAll) == false when cnm.stringView == "tag" then {
                mlbT: zast.nameTextCopy :ast ref: mmName
                if mlbT.stringView == "tag" then lazyTag = true
            }
            if (isNumericLiteralName name: cnm.stringView) == false when (lazyTag) == false then {
                (recordTyperef
                    :st
                    :frame

                    :ast
                    :unitDecl
                    thisName: ""
                    nid: mmOp
                )
            }
            mtid: (optionval.none u64)
            if (lazyTag) == false then mtid = (markerTargetId
                :st
                :frame

                :unitDecl
                :ast
                opNid: mmOp
            )
            match (
                mtid
            ) case some then {
                mlbl: zast.nameTextCopy :ast ref: mmName
                (st.typing.setMemberType
                    parentTypeId: (ztypes.tid.create from: parentId.u64)
                    nameId: mmName
                    childTypeId: mtid
                )
                if (st.reg.needsDestructor typeId: (ztypes.tid.create from: mtid.u64)) then needsDtor = true
                (recordConformance
                    :st
                    :frame

                    :ast
                    implTypeId: parentId
                    specTypeId: mtid
                    label: mlbl.stringView
                    labelNameId: mmName.u64
                )
            } case none then {
                if (isLabelValue op: (ast.nodes.get i: mmOp.u64)) then {
                    amlbl: zast.nameTextCopy :ast ref: mmName
                    amlid: (resolveAtomType
                        :st
                        :frame

                        :ast
                        :unitDecl
                        nm: amlbl.stringView
                        thisName: ""
                    )
                    (st.typing.setMemberType
                        parentTypeId: (ztypes.tid.create from: parentId.u64)
                        nameId: mmName
                        childTypeId: amlid
                    )
                    acf: (st.reg.newConformance
                        implTypeId: parentId
                        specTypeId: amlid
                        label: amlbl.stringView
                        labelNameId: mmName.u64
                        isFacet: false
                    )
                    st.typing.conformance.append acf
                    # a LABEL marker (`:Text`) conforms without naming a spec
                    # member, and the vtable wrapper is emitted from this row
                    (forceAllMembers
                        :st
                        :frame

                        :ast
                        tid: (ztypes.tid.create from: parentId.u64)
                    )
                }
            }
        }
    }
    return needsDtor
}

# dataOutTypeName -- the element-type name from a data block's optional `out T`
# (an atom type-expr), or "" when absent. The Option is BORROWED (param), never
# bound to a local: a bare bind would move the Option out of the shared AST node
# and free its payload, corrupting the later dump walk.
dataOutTypeName: function {ast: Ast.view oId: zast.nodeid} out String is {
    if oId.isZero then return "".string
    return (atomName :ast n: (ast.nodes.get i: oId.u64))
}

# dataelem -- one data-block element dissected into the nodes carrying its
# lexeme and its per-element type tag (`cNul: 0.u8` gives the `0` node and the
# `u8` node). `tagId` is 0 for a bare element, which is what lets the block's
# type be unified from the tags that ARE written.
dataelem: record {
    litId: zast.nodeid
    tagId: zast.nodeid
    ok: bool
}

# dataElemParts -- dissect a data element's value. A bare literal is its own
# lexeme with no tag; a tagged one (`0.u8`) is a dotted path over the literal,
# so the parent carries the lexeme and the child names the type.
dataElemParts: function {ast: Ast.view opId: zast.nodeid} out dataelem is {
    zt: zast.nodeid
    miss: (dataelem litId: zt tagId: zt ok: false)
    if opId.isZero then return miss
    n: ast.nodes.get i: opId.u64
    match (
        n
    ) case expression then {
        return (dataElemParts :ast opId: n.expression)
    } case dottedpath then {
        pt: atomName :ast n: (ast.nodes.get i: n.parent.u64)
        if (isNumericLiteralName name: pt.stringView) == false then return miss
        return (dataelem litId: n.parent tagId: n.child ok: true)
    } case atomid then {
        at: zast.nameTextCopy :ast ref: n.name
        if (isNumericLiteralName name: at.stringView) == false then return miss
        return (dataelem litId: opId tagId: zt ok: true)
    } else null
    return miss
}

# dataElemTypeName -- the ONE type name a data block's elements carry: the
# `out T` clause when written, else the type the elements' own tags agree on,
# else i64 -- f64 when every element is a bare float literal. Tags that
# disagree are reported here, at the declaration, because a block that means
# two widths at once has no honest emission.
dataElemTypeName: function {
    ast: Ast
    st: zenv.ZSymbolTable
    dnode: dataref
    outName: StringView
} out zast.nameid is {
    pick: zast.nameid
    if outName.length > 0 then pick = ast.internString text: outName
    allFloat: true
    kU: u64
    for kU < dnode.nelems loop {
        elId: (zast.dataElemAt :ast nid: dnode.nid i: kU).u32
        kU = kU + 1
        opRef: zast.nodeid
        {
            el: ast.nodes.get i: elId.u64
            match (
                el
            ) case namedoperation then {
                opRef = el.operation
            } else null
        }
        de: dataElemParts :ast opId: opRef
        if (de.ok) == false then allFloat = false
        if de.ok then {
            lx: zast.nameTextCopy :ast ref: (atomNameId :ast n: (ast.nodes.get i: de.litId.u64))
            cv: constLiteralValue name: lx.stringView
            if (cv.kind.fvalKind) == false then allFloat = false
            if (de.tagId.isZero) == false then {
                tgId: atomNameId :ast n: (ast.nodes.get i: de.tagId.u64)
                if pick.isZero then pick = tgId
                if (tgId == pick) == false then {
                    pn: zast.nameTextCopy :ast ref: pick
                    tn: zast.nameTextCopy :ast ref: tgId
                    dm: "data element types disagree: '\{pn.stringView}' and '\{tn.stringView}'"
                    dh: "a data block has one element type: write it once, as `out T`".string
                    en: String
                    (addErrorH
                        :st
                        nodeid: dnode.nid
                        lineno: dnode.lineno
                        colno: dnode.colno
                        e: zast.err.typeError
                        msg: dm
                        note: en
                        hint: dh
                        width: 4
                    )
                }
            }
        }
    }
    if (pick.isZero) == false then return pick
    if allFloat when dnode.nelems > 0 then return (ast.internString text: "f64")
    return (ast.internString text: "i64")
}

# resolveData -- resolve a data-block definition into a DATA type: one child per
# element (the element's own label when present, else its ordinal), all of the
# block's single element type, plus a `tag` child typed `tag__{element-type}`.
# Mark it a non-valtype, then record its defining unit + `{unit}.{name}` view.
# The element type is settled and RANGE-CHECKED here, at the declaration: a
# value the declared width cannot hold is an error where it is written, not a
# silent truncation at every read.
resolveData: function {ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    frame: ztypes.declid
    defName: StringView
    dnode: dataref
} is {
    did: (declareCanonicalType
        :st
        :frame
        :ast

        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.dataType
    )
    st.reg.setValtype typeId: (ztypes.tid.create from: did.u64) value: false
    litId: st.reg.literalIntTid
    etn: dataOutTypeName :ast oId: dnode.outType
    etId: dataElemTypeName :ast :st :dnode outName: etn.stringView
    etName: zast.nameTextCopy :ast ref: etId
    elemTid: litId
    {
        lk: walkLookupTyperef :st :frame :ast :unitDecl base: etName.stringView
        match (
            lk
        ) case some then {
            elemTid = ztypes.tid.create from: lk.u64
        } case none then {
            dn: descendNamed :st :frame :ast :unitDecl name: etName.stringView
            if (dn.isZero) == false then elemTid = dn
        }
    }
    ek: ztypes.numkindByName name: etName.stringView
    ordinal: u64
    kE: u64
    for kE < dnode.nelems loop {
        elId: (zast.dataElemAt :ast nid: dnode.nid i: kE).u32
        kE = kE + 1
        nmRef: zast.nameid
        isNo: false
        opRef: zast.nodeid
        {
            el: ast.nodes.get i: elId.u64
            match (
                el
            ) case namedoperation then {
                nmRef = el.name
                opRef = el.operation
                isNo = true
            } else null
        }
        if isNo then {
            memberIdAt: nmRef
            if nmRef.isZero then {
                ord: "\{ordinal}"
                memberIdAt = ast.internString text: ord.stringView
            }
            # the block's own discriminator is synthesised below under this
            # name, so an element claiming it would shadow the tag and leave
            # the tagged type reading an element as its discriminator.
            if memberIdAt == zast.names.wkTag then {
                tm: "a data element may not be named 'tag'".string
                th: "`tag` is the block's own discriminator: rename the element".string
                en: String
                (addErrorH
                    :st
                    nodeid: dnode.nid
                    lineno: dnode.lineno
                    colno: dnode.colno
                    e: zast.err.typeError
                    msg: tm
                    note: en
                    hint: th
                    width: 4
                )
            }
            (st.typing.setMemberType
                parentTypeId: (ztypes.tid.create from: did.u64)
                nameId: memberIdAt
                childTypeId: elemTid
            )
            # The element's VALUE, recorded here rather than folded on demand:
            # it is the discriminator a tagged type using this block will be
            # emitted with, and a backend reading it has no unit to fold under.
            # A non-literal element records nothing and keeps its position.
            de: dataElemParts :ast opId: opRef
            if de.ok then {
                lt: zast.nameTextCopy :ast ref: (atomNameId :ast n: (ast.nodes.get i: de.litId.u64))
                if lt.length > 0 then {
                    if ek.has then {
                        pn: ztypes.parseNumberAs numstr: lt.stringView k: ek.kind
                        if pn.err.length > 0 then {
                            (addError
                                :st
                                nodeid: dnode.nid
                                lineno: (nodeLine n: (ast.nodes.get i: de.litId.u64))
                                colno: (nodeCol n: (ast.nodes.get i: de.litId.u64))
                                e: zast.err.typeError
                                msg: pn.err
                            )
                        }
                    }
                    cv: constLiteralValue name: lt.stringView
                    if cv.kind.ivalKind then {
                        (st.typing.setMemberConst
                            parentTypeId: (ztypes.tid.create from: did.u64)
                            nameId: memberIdAt
                            value: cv
                        )
                    }
                }
            }
        }
        ordinal = ordinal + 1
    }
    # `length` is a constant of the block: every element is known here, so the
    # read folds like a labelled element rather than reaching a runtime array.
    # An element labelled `length` has already claimed the name and keeps it.
    # It stays a literal: a COUNT is not an element, and pinning it to a narrow
    # element type would make `for i < xs.length` compare across widths.
    lgot: (st.typing.declChildOfId
        parentTypeId: (ztypes.tid.create from: did.u64)
        nameId: zast.names.wkLength
    )
    match (
        lgot
    ) case some then null case none then {
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: did.u64)
            nameId: zast.names.wkLength
            childTypeId: litId
        )
        (st.typing.setMemberConst
            parentTypeId: (ztypes.tid.create from: did.u64)
            nameId: zast.names.wkLength
            value: (ztypes.makeIntConst ordinal.i64.orPanic)
        )
    }
    tagName: "tag__\{etName.stringView}"
    tagId: (declareCanonicalType
        :st
        :frame
        :ast

        unitDecl: st.typing.systemUnitRoot
        ownerNameId: zast.nameid
        name: tagName.stringView
        typetype: ztypes.ztypetype.recordType
    )
    (st.typing.declSynthMember
        parentTypeId: (ztypes.tid.create from: did.u64)
        nameId: zast.names.wkTag
        kind: ztyping.declkind.fieldDecl
    )
    (st.typing.setMemberType
        parentTypeId: (ztypes.tid.create from: did.u64)
        nameId: zast.names.wkTag
        childTypeId: tagId
    )
    st.reg.setDataElemType typeId: (ztypes.tid.create from: did.u64) value: elemTid.u64
}

# isTypedefField -- true when a type-expr Node is an `X.typedef` dottedpath (the
# marker that makes a record a zero-overhead typedef wrapper). Matching the Node
# param narrows it cleanly.
isTypedefField: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case dottedpath then {
        cn: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: n.child.u64))
        return (cn.stringView == "typedef")
    } else {
        return false
    }
}

# recordIsTypedef -- true when a record's `is` body carries a single `X.typedef`
# field. Such a record gets no field child and synthesizes `create`+`borrow`
# instead of `create`/`==`/`!=`.
recordIsTypedef: function {ast: Ast.view rnode: objref} out bool is {
    kFiter: u64
    for kFiter < rnode.nis loop {
        fmId: (zast.objIsItemAt :ast nid: rnode.nid i: kFiter).u32
        kFiter = kFiter + 1
        fm: ast.nodes.get i: fmId.u64
        match (
            fm
        ) case namedoperation then {
            if (isTypedefField :ast n: (ast.nodes.get i: fm.operation.u64)) then return true
        } else null
    }
    return false
}

# typedefFieldBaseName -- the base type name of an `X.typedef` field's `X`
# (e.g. `(List of: u8).typedef` -> "List"). Borrows the Node, never binds it (a
# bare bind would move the type-expr out of the shared AST).
typedefFieldBaseNameId: function {ast: Ast.view n: Node.view} out zast.nameid is {
    match (
        n
    ) case dottedpath then {
        return (paramTypeBaseNameId :ast op: (ast.nodes.get i: n.parent.u64))
    } else {
        return (zast.nameid.create from: 0)
    }
}

# objectTypedefBase -- the base type name of an objectdef's single `X.typedef`
# field (the typedef wrapper base), or "" when the object is not a typedef.
objectTypedefBaseId: function {ast: Ast.view onode: objref} out zast.nameid is {
    kFiter: u64
    for kFiter < onode.nis loop {
        fmId: (zast.objIsItemAt :ast nid: onode.nid i: kFiter).u32
        kFiter = kFiter + 1
        fm: ast.nodes.get i: fmId.u64
        match (
            fm
        ) case namedoperation then {
            if (isTypedefField
                :ast
                n: (ast.nodes.get i: fm.operation.u64)
            ) then return (typedefFieldBaseNameId
                :ast
                n: (ast.nodes.get i: fm.operation.u64)
            )
        } else null
    }
    return (zast.nameid.create from: 0)
}

# typedefFieldBaseTid -- the type id of an `X.typedef` field's `X`. A
# parameterized base (`(List of: u8).typedef`) resolves through the spec trie,
# which materializes the instance; a bare atom (`String.typedef`) resolves
# through the unit ladder. 0 when the node is not a typedef field or the base
# does not resolve.
typedefFieldBaseTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    nid: zast.nodeid
} out u64 is {
    dr: dpRefAt :ast :nid
    if (dr.nid.isZero) == false then {
        memberIdAt: (resolveMonoRefInline
            :st
            :frame

            :ast
            :unitDecl
            thisName: ""
            enclDecl: ztypes.declid
            opNid: dr.parent
            nid: 0
        )
        if memberIdAt > 0 then return memberIdAt
        an: paramTypeBaseName :ast op: (ast.nodes.get i: dr.parent.u64)
        if an.length == 0 then return 0
        return (resolveAtomType :st :frame :ast :unitDecl nm: an.stringView thisName: "")
    } else {
        return 0
    }
}

# objectTypedefBaseTid -- the base type id of an objectdef's single `X.typedef`
# field, or 0 when the object is not a typedef.
objectTypedefBaseTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    frame: ztypes.declid
    onode: objref
} out u64 is {
    kFiter: u64
    for kFiter < onode.nis loop {
        fmId: (zast.objIsItemAt :ast nid: onode.nid i: kFiter).u32
        kFiter = kFiter + 1
        fm: argRefAt :ast nid: (zast.nodeid.create from: fmId.u32)
        if (fm.nid.isZero) == false then {
            if (isTypedefField :ast n: (ast.nodes.get i: fm.operation.u64)) then {
                return (typedefFieldBaseTid
                    :st
                    :frame

                    :ast
                    :unitDecl
                    nid: fm.operation
                )
            }
        }
    }
    return 0
}

# resolveRecord -- resolve a record ObjectDef into a RECORD valtype. A normal
# record: a child per field (field name -> type-ref shell), a child per as-block
# method, then synthesized `create`/`==`/`!=`. A typedef record (single
# `X.typedef` field): no field child, the methods, then `create`+`borrow`. Synth
# children are shallow FUNCTION shells (JOIN-only). Generics arrive later.
# fnFieldFlaggableName -- an is-block FUNCTION member that should become a struct
# fnptr slot (a spec field / method / method-ref), excluding the constructor and
# comparison synthetics so they stay free functions / ctors.
fnFieldFlaggableName: function {name: StringView} out bool is {
    if name == "create" then return false
    if name == "==" then return false
    if name == "!=" then return false
    if name == "borrow" then return false
    return true
}

# typeExprHasPrivate -- does a field's type expression carry a `.private` marker
# (`Container.private.lock`), i.e. is it a friend handle? Walks the dotted path
# (markers nest outermost-last: `((Container.private).lock)`).
typeExprHasPrivate: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case dottedpath then {
        nameCount: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: n.child.u64))
        if nameCount.stringView == "private" then return true
        return (typeExprHasPrivate :ast n: (ast.nodes.get i: n.parent.u64))
    } else {
        return false
    }
}

# materializeCreateParams -- give a synthesized `.create` one parameter per
# the type's data field, in declaration order, so the create method carries the
# signature the construction sugar validates and dispatches against. Mirrors
# dataFieldNames' field filter (fnptr fields + non-FUNCTION fields, excluding
# as-block const clones and conformance markers), and resolves exactly what
# that filter reads. The synth create keeps no
# funcReturnNode, so emission still routes it field-wise.
materializeCreateParams: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    typeTid: u64
    createId: u64
} is {
    # the synthesized constructor's parameters are this type's FIELDS, so an
    # unresolved fn-ptr field -- an is-block `function {..} out T` with no
    # body -- would be silently absent from the signature. A METHOD is never a
    # parameter, and forcing one only to drop it resolved every signature in
    # the member block: `StringView` reached `parseF16`/`parseF128` that way,
    # and through them f16 and f128, in every program ever compiled.
    forceAllFields :st :frame :ast tid: (ztypes.tid.create from: typeTid.u64)
    # every field edge is written by now -- only the synthesized borrow / == /
    # != follow this call -- so settle the type here rather than waiting for
    # resolveDef's settle, which lands after the parameter order is decided
    mkIds8: (ListVal u64)
    with cfit8: st.typing.conformance.iterate do for crow8: cfit8 loop {
        if crow8.implTypeId == typeTid then mkIds8.append crow8.labelNameId
    }
    fnameIds: (ListVal u64)
    ftypeIds: (ListVal u64)
    rowNids: (ListVal u64)
    rowCtos: (ListVal u64)
    (st.typing.declMemberList
        ownerTid: (ztypes.tid.create from: typeTid.u64)
        names: rowNids
        tids: rowCtos
    )
    {
        {
            ri: u64
            for ri < rowNids.length loop {
                tcNameId: rowNids.get i: ri
                cto: rowCtos.get i: ri
                ri = ri + 1
                inc: false
                fptr: false
                fptr = (st.typing.declIsFnptrFieldId
                    parentTypeId: (ztypes.tid.create from: typeTid.u64)
                    nameId: (zast.nameid.create from: tcNameId.u32.orPanic)
                )
                if fptr then {
                    inc = true
                } else {
                    if cto > 0 when (st.reg.typetypeOf typeId: (ztypes.tid.create from: cto.u64)) != ztypes.ztypetype.functionType then {
                        isC: false
                        aco: st.typing.asConstClone.get key: cto
                        match (
                            aco
                        ) case some then {
                            isC = aco
                        } case none then null
                        isMk8: false
                        mi8: u64
                        mn8: mkIds8.length
                        for mi8 < mn8 loop {
                            mv8: mkIds8.get i: mi8
                            if mv8 > 0 when mv8 == tcNameId then isMk8 = true
                            mi8 = mi8 + 1
                        }
                        if isC == false when isMk8 == false then inc = true
                    }
                }
                if inc then {
                    fnameIds.append tcNameId
                    ftypeIds.append cto
                }
            }
        }
    }
    i: u64
    for i < fnameIds.length loop {
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: createId.u64)
            nameId: (zast.nameid.create from: (fnameIds.get :i))
            childTypeId: (ftypeIds.get :i)
        )
        i = i + 1
    }
}

# scanVisibility -- one AST-only pass over a type's `public:` block filling two
# out-lists (with-scoped iterators, no lock outlives the scan): `excl` = pool
# ids of USER-declared members NOT in the block (empty when there is no block --
# the all-public default; synthesized members are never listed); `grants` = pool
# ids of fields whose declared type is a `.private` handle (independent of any
# `public:` block). The resolver applies both once the members are registered.
scanVisibility: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    onode: objref
    excl: (ListVal u64)
    grants: (ListVal u64)
} is {
    pubIds: (IdSet u64)
    memberIds: (IdSet u64)
    aliasPubRef: (ListVal u32)
    aliasIntRef: (ListVal u32)
    aliasLine: (ListVal u32)
    aliasCol: (ListVal u32)
    aliasNode: (ListVal u32)
    pubFound: false
    kAiter: u64
    for kAiter < onode.nas loop {
        aId: (zast.objAsItemAt :ast nid: onode.nid i: kAiter).u32
        kAiter = kAiter + 1
        an: ast.nodes.get i: aId.u64
        match (
            an
        ) case namedoperation then {
            if (zast.unitOpKindIs :ast opId: an.operation k: zast.unitkind.privateNs) then {
                (addResolveErrorH
                    :st
                    nodeid: an.nodeid
                    lineno: an.lineno
                    colno: an.colno
                    e: zast.err.typeError
                    msg: "`private:` cannot be redefined -- `private` always includes every field and method of the type".string
                    width: 7
                )
            }
            if (zast.unitOpKindIs :ast opId: an.operation k: zast.unitkind.publicNs) then {
                pubFound = true
                opNode: ast.nodes.get i: an.operation.u64
                match (
                    opNode
                ) case unitdef then {
                    with biter: opNode.body.iterate do for bId: biter loop {
                        bn: ast.nodes.get i: bId.u64
                        match (
                            bn
                        ) case namedoperation then {
                            pubIds.add item: bn.name.u64
                            bop: ast.nodes.get i: bn.operation.u64
                            match (
                                bop
                            ) case labelvalue then null case atomid then {
                                # `alias: internal` renames when the exposed
                                # name differs from the member being exposed
                                if bn.name != bop.name then {
                                    aliasPubRef.append from: bn.name
                                    aliasIntRef.append from: bop.name
                                    aliasLine.append from: bn.lineno
                                    aliasCol.append from: bn.colno
                                    aliasNode.append from: bn.nodeid.u32
                                }
                            } else {
                                (addResolveErrorH
                                    :st
                                    nodeid: bn.nodeid
                                    lineno: bn.lineno
                                    colno: bn.colno
                                    e: zast.err.typeError
                                    msg: "a public interface entry must be ':member' or 'alias: member'".string
                                    width: 1
                                )
                            }
                        } else null
                    }
                } else null
            }
        } else null
    }
    kFiter: u64
    for kFiter < onode.nis loop {
        fId: (zast.objIsItemAt :ast nid: onode.nid i: kFiter).u32
        kFiter = kFiter + 1
        fm: ast.nodes.get i: fId.u64
        match (
            fm
        ) case namedoperation then {
            memberIds.add item: fm.name.u64
            if (typeExprHasPrivate
                :ast
                n: (ast.nodes.get i: fm.operation.u64)
            ) then grants.append from: fm.name.u64
            if pubFound then {
                hasF: pubIds.has item: fm.name.u64
                if (hasF) == false then excl.append from: fm.name.u64
            }
        } else null
    }
    if (pubFound) == false then return
    kA2iter: u64
    for kA2iter < onode.nas loop {
        a2Id: (zast.objAsItemAt :ast nid: onode.nid i: kA2iter).u32
        kA2iter = kA2iter + 1
        am: ast.nodes.get i: a2Id.u64
        match (
            am
        ) case namedoperation then {
            skip: false
            if (zast.unitOpKindIs :ast opId: am.operation k: zast.unitkind.publicNs) then {
                skip = true
            }
            if (zast.unitOpKindIs :ast opId: am.operation k: zast.unitkind.privateNs) then {
                skip = true
            }
            if (skip) == false then {
                memberIds.add item: am.name.u64
                hasM: pubIds.has item: am.name.u64
                if (hasM) == false then excl.append from: am.name.u64
            }
        } else null
    }
    # validate the rename aliases against the now-known member set, then install
    ax: u64
    for ax < aliasPubRef.length loop {
        pRef: aliasPubRef.get i: ax
        iRef: aliasIntRef.get i: ax
        okAlias: true
        if (memberIds.has item: iRef.u64) == false then {
            iTxt: zast.nameTextAt :ast ref: (zast.nameid.create from: iRef.u32)
            (addResolveErrorH
                :st
                nodeid: (zast.nodeid.create from: (aliasNode.get i: ax))
                lineno: (aliasLine.get i: ax)
                colno: (aliasCol.get i: ax)
                e: zast.err.typeError
                msg: "public interface exposes '\{iTxt}', which is not a member of this type"
                width: 1
            )
            okAlias = false
        }
        if okAlias when (memberIds.has item: pRef.u64) then {
            pTxt: zast.nameTextAt :ast ref: (zast.nameid.create from: pRef.u32)
            (addResolveErrorH
                :st
                nodeid: (zast.nodeid.create from: (aliasNode.get i: ax))
                lineno: (aliasLine.get i: ax)
                colno: (aliasCol.get i: ax)
                e: zast.err.typeError
                msg: "public alias '\{pTxt}' collides with a member of the same name"
                width: 1
            )
            okAlias = false
        }
        if okAlias then st.typing.renameSeen = true
        ax = ax + 1
    }
}

# applyGrantsPrivate -- mark each `.private`-typed field as a friend handle.
applyGrantsPrivate: function {st: zenv.ZSymbolTable parentId: u64 grants: (ListVal u64).view} is {
    gi: u64
    gn: grants.length
    for gi < gn loop {
        (st.typing.setChildGrantsPrivateId
            parentTypeId: (ztypes.tid.create from: parentId.u64)
            nameId: (zast.nameid.create from: (grants.get i: gi))
        )
        gi = gi + 1
    }
}

# scanUnitVisibility -- restrict a file unit's public interface. A `public:`
# block lists the exposed top-level definitions; unlisted defs become private
# (E0101 when referenced from another unit) and `alias: internal` entries
# expose a def under a different public name. A unit exposes its members
# through its publicNs declaration subtree, exactly as a type does.
scanUnitVisibility: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitdefId: zast.nodeid
} is {
    pubIds: (IdSet u64)
    memberIds: (IdSet u64)
    memberNameList: (ListVal u64)
    aliasPubRef: (ListVal u32)
    aliasIntRef: (ListVal u32)
    aliasLine: (ListVal u32)
    aliasCol: (ListVal u32)
    aliasNode: (ListVal u32)
    pubFound: false
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    with uit: bodyIds.iterate do for umId: uit loop {
        um: ast.nodes.get i: umId.u64
        match (
            um
        ) case namedoperation then {
            isPubU: zast.unitOpKindIs :ast opId: um.operation k: zast.unitkind.publicNs
            isPrivU: (zast.unitOpKindIs
                :ast
                opId: um.operation
                k: zast.unitkind.privateNs
            )
            if isPrivU then {
                (addResolveErrorH
                    :st
                    nodeid: um.nodeid
                    lineno: um.lineno
                    colno: um.colno
                    e: zast.err.typeError
                    msg: "`private:` cannot be redefined -- `private` always includes every definition of the unit".string
                    width: 7
                )
            }
            if isPubU then {
                uop: ast.nodes.get i: um.operation.u64
                match (
                    uop
                ) case unitdef then {
                    pubFound = true
                    with ubit: uop.body.iterate do for ubId: ubit loop {
                        ubn: ast.nodes.get i: ubId.u64
                        match (
                            ubn
                        ) case namedoperation then {
                            pubIds.add item: ubn.name.u64
                            ubop: ast.nodes.get i: ubn.operation.u64
                            match (
                                ubop
                            ) case labelvalue then null case atomid then {
                                # `alias: member` renames a sibling; an atom
                                # that names no sibling is a definition of the
                                # block (`MAX: 10`), like any other shape
                                if ubn.name != ubop.name then {
                                    aliasPubRef.append from: ubn.name
                                    aliasIntRef.append from: ubop.name
                                    aliasLine.append from: ubn.lineno
                                    aliasCol.append from: ubn.colno
                                    aliasNode.append from: ubn.nodeid
                                }
                            } else null
                        } else null
                    }
                } else null
            }
            if (isPubU) == false when (isPrivU) == false then {
                memberIds.add item: um.name.u64
                memberNameList.append from: um.name.u64
            }
        } else null
    }
    if (pubFound) == false then return
    emiU: u64
    for emiU < memberNameList.length loop {
        mnidU: memberNameList.get i: emiU
        if (pubIds.has item: mnidU) == false then st.typing.privacySeen = true
        emiU = emiU + 1
    }
    axU: u64
    for axU < aliasPubRef.length loop {
        pRefU: aliasPubRef.get i: axU
        iRefU: aliasIntRef.get i: axU
        okU: true
        # an atom naming no sibling is not a rename but a definition of the
        # block, resolved in the block's frame like any alias
        if (memberIds.has item: iRefU.u64) == false then okU = false
        if okU when (memberIds.has item: pRefU.u64) then {
            pTxtU: zast.nameTextAt :ast ref: (zast.nameid.create from: pRefU.u32)
            (addResolveErrorH
                :st
                nodeid: (zast.nodeid.create from: (aliasNode.get i: axU))
                lineno: (aliasLine.get i: axU)
                colno: (aliasCol.get i: axU)
                e: zast.err.typeError
                msg: "public alias '\{pTxtU}' collides with a definition of the same name"
                width: 1
            )
            okU = false
        }
        if okU then st.typing.renameSeen = true
        axU = axU + 1
    }
}
# checkOneRequireBlock -- the schema for one `require:` block: it introduces a
# unit, declares at least one requirement, and every entry is a key the
# compiler consumes -- today only `library:`, whose value is a compile-time
# string. A key nothing reads would be silently ignored, so it is rejected.
# The block is read as what it is -- a nested unit -- through its Decl children
# and the constant its resolution folded, never off the AST: an entry may be
# computed from other definitions in the block, and only the ordinary
# machinery resolves those in dependency order.
checkOneRequireBlock: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    declId: ztypes.declid
    libNid: zast.nameid
} is {
    rnode9q: u32
    isUnit9q: false
    rtid9q: ztypes.tid
    {
        dr9q: st.typing.decls.get i: declId.u64
        rnode9q = dr9q.node
        if dr9q.kind.unitDecl then isUnit9q = true
        rtid9q = dr9q.typeId
    }
    if rnode9q == 0 then return
    rline9q: u32
    rcol9q: u32
    {
        rn9q: ast.nodes.get i: rnode9q.u64
        rline9q = nodeLine n: rn9q
        rcol9q = nodeCol n: rn9q
    }
    if (isUnit9q) == false then {
        (addResolveErrorH
            :st
            nodeid: (zast.nodeid.create from: rnode9q)
            lineno: rline9q
            colno: rcol9q
            e: zast.err.requireBlock
            msg: "'require:' must introduce a unit definition, e.g. `require: unit { library: \"m\" }`".string
            width: 7
        )
        return
    }
    nmem9q: st.typing.declChildSlots :declId
    if nmem9q == 0 then {
        (addResolveErrorH
            :st
            nodeid: (zast.nodeid.create from: rnode9q)
            lineno: rline9q
            colno: rcol9q
            e: zast.err.requireBlock
            msg: "a 'require:' block must declare at least one requirement".string
            width: 7
        )
        return
    }
    i9q: u64
    for i9q < nmem9q loop {
        c9q: st.typing.declChildAt :declId index: i9q
        i9q = i9q + 1
        if (c9q.isZero) == false then {
            cnm9q: st.typing.declNameOf declId: c9q
            cnode9q: u32
            {
                cd9q: st.typing.decls.get i: c9q.u64
                cnode9q = cd9q.node
            }
            eline9q: rline9q
            ecol9q: rcol9q
            enid9q: (zast.nodeid.create from: rnode9q)
            if cnode9q > 0 then {
                cn9q: ast.nodes.get i: cnode9q.u64
                eline9q = nodeLine n: cn9q
                ecol9q = nodeCol n: cn9q
                enid9q = nodeId n: cn9q
            }
            if cnm9q == libNid.u32 then {
                # the value the block's own resolution folded. An entry the
                # evaluator already reported on -- a reached `error`, an
                # interpolation -- has said what is wrong, and "must evaluate
                # to a string" on top of that is noise.
                lv9q: st.typing.memberConstOf parentTypeId: rtid9q nameId: libNid
                if (lv9q.kind.svalKind) == false when (st.typing.isError) == false then {
                    (addResolveErrorH
                        :st
                        nodeid: enid9q
                        lineno: eline9q
                        colno: ecol9q
                        e: zast.err.requireBlock
                        msg: "'library:' must evaluate to a string at compile time".string
                        width: 7
                    )
                }
            } else {
                kt9q: (zast.poolTextAt
                    pool: ast.names
                    ref: (zast.nameid.create from: cnm9q)
                )
                (addResolveErrorH
                    :st
                    nodeid: enid9q
                    lineno: eline9q
                    colno: ecol9q
                    e: zast.err.requireBlock
                    msg: "unknown 'require:' entry '\{kt9q}' -- the compiler consumes only 'library:'"
                    width: 1
                )
            }
        }
    }
}

# requireLibraryOf -- the link library one demanded `require:` block names, ""
# when it names none. A pure read of the constant its resolution folded.
requireLibraryOf: function {
    st: zenv.ZSymbolTable.view
    declId: ztypes.declid
    libNid: zast.nameid
} out String is {
    lib9w: String
    rtid9w: ztypes.tid
    {
        dr9w: st.typing.decls.get i: declId.u64
        rtid9w = dr9w.typeId
    }
    if rtid9w.isZero then return lib9w
    v9w: st.typing.memberConstOf parentTypeId: rtid9w nameId: libNid
    if v9w.kind.svalKind then lib9w = constStringAt :st id: v9w.strId
    return lib9w
}

# requiredLibs -- the link libraries the program's reached units declare. A
# `require:` block applies only when the program reaches its unit, and
# ZTyping.requireDemanded IS that set: a block is demanded by the first
# declaration resolved from its unit and by nothing else, so it cannot light
# its own unit.
requiredLibs: function {
    st: zenv.ZSymbolTable.view
    program: Node.view
} out List String is {
    st
    libs9w: (List String)
    match (
        program
    ) case program then {
        libNid9w: zast.poolFind pool: program.ast.names text: "library"
        if libNid9w.isZero then return libs9w
        with rit9w: st.typing.requireDemanded.iterate do for rq9w: rit9w loop {
            lib9x: requireLibraryOf :st declId: rq9w libNid: libNid9w
            if lib9x.length > 0 then {
                dup9w: false
                with dit9w: libs9w.iterate do for e9w: dit9w loop {
                    if e9w.stringView == lib9x.stringView then dup9w = true
                }
                if (dup9w) == false then libs9w.append from: lib9x.copy
            }
        }
    } else null
    return libs9w
}

# checkRequireBlocks -- the schema check for every `require:` block the program
# demanded. A block in a unit nothing reached is never resolved and so has no
# claim to make about this program; the linter is what checks code a program
# does not use.
checkRequireBlocks: function {
    st: zenv.ZSymbolTable
    program: Node.view
} is {
    st
    match (
        program
    ) case program then {
        libNid9q: zast.poolFind pool: program.ast.names text: "library"
        if libNid9q.isZero then return
        rqs9q: (ListVal ztypes.declid)
        with cit9q: st.typing.requireDemanded.iterate do for r9q: cit9q loop rqs9q.append from: r9q
        with qit9q: rqs9q.iterate do for rq9q: qit9q loop {
            (checkOneRequireBlock
                :st
                ast: program.ast
                declId: rq9q
                libNid: libNid9q
            )
        }
    } else null
}

# applyUnitVisibility -- run scanUnitVisibility for every file unit that
# declares a `public:` block, after all unit members are registered.
applyUnitVisibility: function {
    st: zenv.ZSymbolTable
    program: Node.view
} is {
    match (
        program
    ) case program then {
        uCntV: program.ast.units.length
        uIdxV: u64
        for uIdxV < uCntV loop {
            uIdV: (zast.nodeid.create from: (program.ast.units.get i: uIdxV))
            uIdxV = uIdxV + 1
            opIdV: zast.nodeid
            nmV: String
            {
                ruV: program.ast.nodes.get i: uIdV.u64
                if ruV.namedoperation then {
                    nmt: zast.poolTextAt pool: program.ast.names ref: ruV.name
                    opIdV = ruV.operation
                    nmV = nmt.copy
                }
            }
            if opIdV > 0 then {
                utidV: ztypes.tid
                {
                    uidoV: (declTypeIdOf
                        :st
                        declId: (st.typing.declFindChild
                            parentDeclId: st.typing.programRoot
                            nameId: (nameIdOf ast: program.ast name: nmV.stringView)
                        )
                    )
                    if (uidoV.isZero) == false then utidV = uidoV
                }
                if utidV > 0 then {
                    (scanUnitVisibility
                        :st
                        ast: program.ast
                        unitdefId: opIdV
                    )
                    # the entry `main` of the primary unit must stay public:
                    # a `public:` block that omits it hides the entry point
                    if nmV.stringView == program.mainUnitName.stringView then {
                        if (declMemberIsPrivate
                            :st

                            tid: (ztypes.tid.create from: utidV.u64)
                            nameId: (program.ast.names.find s: "main")
                        ) then {
                            mnid: zast.nodeid
                            mnln: u32
                            mncl: u32
                            {
                                mIds: zast.unitBodyIdsAt ast: program.ast unitId: opIdV
                                mref: program.ast.names.find s: "main"
                                with mit: mIds.iterate do for memberIdAt: mit loop {
                                    mn: program.ast.nodes.get i: memberIdAt.u64
                                    match (
                                        mn
                                    ) case namedoperation then {
                                        if mn.name == mref when mref > 0 then {
                                            mnid = mn.nodeid
                                            mnln = mn.lineno
                                            mncl = mn.colno
                                        }
                                    } else null
                                }
                            }
                            mmsg: "the entry 'main' must be public".string
                            if mnid > 0 then {
                                (addResolveErrorH
                                    :st
                                    nodeid: mnid
                                    lineno: mnln
                                    colno: mncl
                                    e: zast.err.notPublic
                                    msg: mmsg
                                    width: 4
                                )
                            } else {
                                addResolveError :st e: zast.err.notPublic msg: mmsg
                            }
                        }
                    }
                }
            }
        }
    } else null
}
# attachRecordField -- an isItem that is not a method is a FIELD: resolve its
# type-ref (which may name a SIBLING method, an fn-ptr slot defaulting to it),
# attach it, and record the marker and default the declaration carries.
attachRecordField: function {
    st: zenv.ZSymbolTable
    frame: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    rid: u64
    fm: argref
    fname: StringView
} is {
    ftnR: fieldHeadName :ast n: (ast.nodes.get i: fm.operation.u64)
    # a field's type-ref can name a SIBLING method (an fn-ptr
    # slot defaulting to it), which is a member like any other
    nameId9: (zast.poolFind pool: ast.names text: ftnR.stringView)
    (forceMemberOf
        :st
        :frame

        :ast
        parentTypeId: (ztypes.tid.create from: rid.u64)
        nameId: nameId9
    )
    mrefR: (resolvedByIdsMember
        :st
        :ast
        :unitDecl
        defId: (zast.poolFind pool: ast.names text: defName)
        memberId: (zast.poolFind pool: ast.names text: ftnR.stringView)
    )
    handledR: false
    match (
        mrefR
    ) case some then {
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: rid.u64)
            nameId: fm.name
            childTypeId: mrefR
        )
        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: mrefR.u64)) == ztypes.ztypetype.functionType then {
            (st.typing.setChildFnptrField
                pool: ast.names
                parentTypeId: (ztypes.tid.create from: rid.u64)
                name: fname
            )
        }
        pdkR: nodeId n: (ast.nodes.get i: fm.operation.u64)
        pdoR: rid
        st.typing.pendingDefaultOwner.set key: pdkR.u64 value: pdoR
        pdk2R: nodeId n: (ast.nodes.get i: fm.operation.u64)
        pdiR: mrefR
        st.typing.pendingDefaultId.set key: pdk2R.u64 value: pdiR
        handledR = true
    } case none then null
    if (handledR) == false then {
        cid: (resolveTyperefShellMarked
            :st
            :frame

            :ast
            :unitDecl
            ownerId: 0
            nid: fm.operation
            thisName: defName
        )
        (refuseNullTyped
            :st
            tid: cid
            nodeid: fm.nid
            lineno: fm.lineno
            colno: fm.colno
            what: "field"
            name: fname
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: rid.u64)
            nameId: fm.name
            childTypeId: cid
        )
        if (st.reg.typetypeOf typeId: cid) == ztypes.ztypetype.functionType then {
            (st.typing.setChildFnptrField
                pool: ast.names
                parentTypeId: (ztypes.tid.create from: rid.u64)
                name: fname
            )
        }
        (recordTyperef
            :st
            :frame

            :ast
            :unitDecl
            thisName: ""
            nid: fm.operation
        )
        dcn1: (zast.nameTextAt
            :ast
            ref: (dottedChildNameId :ast n: (ast.nodes.get i: fm.operation.u64))
        )
        rdnr: (zast.nameTextAt
            :ast
            ref: (rootNameIdOf :ast n: (ast.nodes.get i: fm.operation.u64))
        )
        if (isNumericLiteralName name: rdnr.stringView) then {
            (st.typing.setDefaultLiteral
                pool: ast.names
                parentTypeId: (ztypes.tid.create from: rid.u64)
                name: fname
                node: fm.operation
            )
        } else {
            if dcn1.length > 0 when (isStripMarker name: dcn1.stringView) == false when (nameDenotesUnit
                :st
                :frame

                nameId: (nameIdOf
                :ast
                name: rdnr.stringView
            )
            ) == false then {
                rArmNid: zast.poolFind pool: ast.names text: dcn1.stringView
                rArmDecl: st.typing.declMemberIdOf parentTypeId: cid nameId: rArmNid
                (st.typing.setDefaultVariantArm
                    pool: ast.names
                    parentTypeId: (ztypes.tid.create from: rid.u64)
                    name: fname
                    targetDecl: rArmDecl
                )
            }
        }
        if dcn1.length > 0 when (isStripMarker name: dcn1.stringView) then {} else {
            if dcn1.length > 0 then {
                rdk3: nodeId n: (ast.nodes.get i: fm.operation.u64)
                rdo3: rid
                st.typing.pendingDefaultOwner.set key: rdk3.u64 value: rdo3
                rdk4: nodeId n: (ast.nodes.get i: fm.operation.u64)
                rdn4: rootNameIdOf :ast n: (ast.nodes.get i: fm.operation.u64)
                st.typing.pendingDefaultName.set key: rdk4.u64 value: rdn4
            }
        }
    }
}
# synthRecordMembers -- the members a record gets without declaring them: a typedef
# wrapper's `borrow` projection, or the byte-wise `==` and `hash` a plain record
# carries. `hash` is INDEPENDENT of whether `==` was synthesised -- a type that
# declares its own `==` (every numeric does) still hashes by its bytes -- and a
# heap-owning value has no byte range to hash, so it gets none and is not
# Hashable.
# synthRecordHash -- `hash` is INDEPENDENT of whether `==` was synthesised -- a
# type that declares its own `==` (every numeric does) still hashes by its
# bytes. It exists unless the author struck it off with a null shell or wrote
# their own, and a heap-owning value has no byte range to hash, so it gets
# none and is simply not Hashable.
synthRecordHash: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    rnode: objref
    rid: u64
    isgen: bool
} is {
    hshOptR: false
    {
        onHshOptR: ast.nodes.get i: rnode.nid.u64
        match (
            onHshOptR
        ) case objectdef then {
            hshOptR = memberNullOptOut :ast asItems: onHshOptR.asItems member: "hash"
        } else null
    }
    hshAsR: false
    {
        onHshAsR: ast.nodes.get i: rnode.nid.u64
        match (
            onHshAsR
        ) case objectdef then {
            hshAsR = asDeclaresMember :ast asItems: onHshAsR.asItems member: "hash"
        } else null
    }
    if (isgen) == false when hshOptR == false when hshAsR == false then {
        hshR: st.reg.newType name: "hash" ownerTid: rid typetype: ztypes.ztypetype.functionType
        (st.typing.declSynthMember
            parentTypeId: (ztypes.tid.create from: rid.u64)
            nameId: zast.names.wkHash
            kind: ztyping.declkind.methodDecl
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: rid.u64)
            nameId: zast.names.wkHash
            childTypeId: hshR
        )
    }
}

synthRecordMembers: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    rnode: objref
    rid: u64
    istd: bool
    isgen: bool
    eqOptR: bool
    eqAsR: bool
    hasEqIs: bool
} is {
    if istd then {
        borrowId: (st.reg.newType
            name: "borrow"
            ownerTid: rid
            typetype: ztypes.ztypetype.functionType
        )
        (st.typing.declSynthMember
            parentTypeId: (ztypes.tid.create from: rid.u64)
            nameId: zast.names.wkBorrow
            kind: ztyping.declkind.methodDecl
        )
        (st.typing.setMemberType
            parentTypeId: (ztypes.tid.create from: rid.u64)
            nameId: zast.names.wkBorrow
            childTypeId: borrowId
        )
    } else {
        if (isgen) == false then {
            if (hasEqIs) == false when (eqOptR) == false when (eqAsR) == false then {
                eqId: (st.reg.newType
                    name: "=="
                    ownerTid: rid
                    typetype: ztypes.ztypetype.functionType
                )
                (st.typing.declSynthMember
                    parentTypeId: (ztypes.tid.create from: rid.u64)
                    nameId: zast.names.wkOpEq
                    kind: ztyping.declkind.methodDecl
                )
                (st.typing.setMemberType
                    parentTypeId: (ztypes.tid.create from: rid.u64)
                    nameId: zast.names.wkOpEq
                    childTypeId: eqId
                )
                neqId: (st.reg.newType
                    name: "!="
                    ownerTid: rid
                    typetype: ztypes.ztypetype.functionType
                )
                (st.typing.declSynthMember
                    parentTypeId: (ztypes.tid.create from: rid.u64)
                    nameId: zast.names.wkOpNe
                    kind: ztyping.declkind.methodDecl
                )
                (st.typing.setMemberType
                    parentTypeId: (ztypes.tid.create from: rid.u64)
                    nameId: zast.names.wkOpNe
                    childTypeId: neqId
                )
            }
        }
    }
    synthRecordHash :st :ast :rnode :rid :isgen
}
# recordTypedefBase -- `X: T.typedef` records the base it wraps by BOTH channels:
# the declaration's name id and, when it resolves here, its tid. The two are not
# the same presence set, so both are written.
recordTypedefBase: function {
    st: zenv.ZSymbolTable
