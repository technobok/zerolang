# The type checker. Every unit's top-level names are indexed into the Decl
# tree first; resolution then starts at the program's `main` and demands only
# what a reference reaches -- a definition resolves in the scope it was written
# in, a generic specialises through the arg-keyed trie under its template, and
# a body is walked (types, ownership, locks, narrowing, constants) only once
# its owner has resolved. Everything it decides is stamped into the ZTyping
# the caller hands in, beside the type registry; the emitter and the SQL dump
# read those and resolve nothing themselves.

# A name read out of `ast` and still needed across a walk is an OWNED copy
# (`zast.nameTextCopy`), never a borrowed view: the walks below LEND `ast`, and a
# view into its name pool does not outlive a walk that takes the pool. That is the
# reason at every copy site in this unit, so it is stated here and the sites are
# left bare. `st` is lent the same way, which is why a table's rows are copied out
# before canonicalising.
#
# An `out T.view` result is a READONLY reference wherever the checker takes a
# pending borrow from one: a shared pin, and the binding it lands on may only be
# read.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    # the generator `call` whose recorded answers (`yield` in scope, the state fields) the
    # function node `nid` takes: the node itself, or for an instance's copy of a generic
    # generator's `call`, the template's
    generatorCallOf: bodies.generatorCallOf
    :indexAddedUnits
    :resolveUnitMemberLate
    :constValueOfDeclLate
    # an integer constant's value as a BigInt, inline or interned
    constBigOf: consteval.constBigOf
    constIntText: consteval.constIntText
    # the IEEE 754 bit pattern of float kind `k`'s value nearest the number constant `v`, a
    # tie to the even one: rounded once from the exact value
    constFloatBits: consteval.constFloatBits
    constFloatText: consteval.constFloatText
    # the IEEE 754 bits of float kind `k`'s value nearest a float literal, read as
    # constOfFloatLiteral reads it and rounded once, with nothing interned: what a default
    # written as a literal emits
    floatLexemeBits: consteval.floatLexemeBits
    :constLiteralBig
    # a member read off a Box that is its element's: anything but the ownership and access
    # markers and `.copy`, which act on the box
    boxMemberDelegates: moves.boxMemberDelegates
    # true when a node is a functiondef carrying a non-empty body (a real method, not a
    # facet/protocol spec signature whose body is none)
    isFunctionDefWithBody: bodies.isFunctionDefWithBody
    # the arm a bare 2-arm-sum condition at `nid` holds, 0 when the node is not one
    truthyCondArmOf: consteval.truthyCondArmOf
    # true when `block`'s last statement is a return
    blockEndsInReturn: flow.blockEndsInReturn
    blockHasBreak: flow.blockHasBreak
    # return position passes INTO a `with`'s body, rather than the `with` being the tail value
    # itself, when that body is a `do` block no `break` leaves
    withForwardsTail: flow.withForwardsTail
    armLeaves: flow.armLeaves
    # what the instance `ownerTid` bound its template's generic parameter `paramName` to; a
    # type argument of no type when the owner is no instance of a template declaring that
    # parameter
    dissectedArgOf: flow.dissectedArgOf
    dissectedArmOf: flow.dissectedArmOf
    # the argument `darg` the instance `ownerTid` bound its template's parameter `paramName`
    # to, as a diagnostic names it: a value as the program writes it, a type's name, "" for
    # none
    dissectedArgText: flow.dissectedArgText
    # stdTid for a caller holding only a view of the tree: the memoised or already-resolved
    # id, 0 when the type has not been resolved
    stdTidRo: stdtypes.stdTidRo
    # the declaration `member` of standard unit `stdUnit`, both well-known name ids, read
    # only: what a backend lowers by hand (io's streams, os's arguments) asked by declaration,
    # never by spelling
    stdDeclRo: resolve.stdDeclRo
    :firstGenericParamId
    :bareNameReaches
    # the nodeid of the unit row an id names (0 when the id does not name a unit)
    unitdefNodeId: resolve.unitdefNodeId
    # stdTidRo for a reader holding only a view of the table, the emitter: the memoised id,
    # else the prelude's answer, never stored
    stdTidPeek: moves.stdTidPeek
    :isOperatorName
    # the instances of `tplId`, a template with parameters of its own written in a generic
    # unit, that belong to that unit's instance `owner`: those whose arguments for the unit's
    # parameters are `owner`'s (bindInheritedParams), in the order they were minted
    instancesWithin: bodies.instancesWithin
    # a type's user-supplied data fields/params in order, as the (name pool id, type id)
    # pairs: for a FUNCTION, all params; for a record/class, fnptr fields plus non-FUNCTION
    # fields, excluding as-block constants (asConstDecls) and implementation markers
    dataFieldIds: conform.dataFieldIds
    :knownFieldSpan
    # the type is `null`, the payload-less marker
    isNullTid: conform.isNullTid
    dataFieldNames: conform.dataFieldNames
    # a generic-param definition in direct dotted form (`t: anyval.generic`); wrapped shapes
    # (a def whose payload merely contains a constraint) are not unit-level generic params
    isBareGenericParam: declare.isBareGenericParam
    :asAliasKnownAt
    # the expression an `out`-typed function body's last line hands back: the line's own
    # expression when it yields a value
    implicitReturnValue: moves.implicitReturnValue
    :controlArmBlocks
    # the node id of the last statement line in operation `oId`
    lastStmtLineIdAt: moves.lastStmtLineIdAt
    :isComparisonOp
    # true when a type-expr is a generic-parameter constraint (`u64.generic` /
    # `anyval.generic`): a dottedpath whose leaf is `generic`, peeling a parameterized `call`
    # around it
    isGenericParam: declare.isGenericParam
    # see isStringViewMember
    isListViewMember: conform.isListViewMember
    # a value-position ownership-transfer marker, by id
    isMoveMarkerId: moves.isMoveMarkerId
    :isStringViewMember
    # whether TEXT spells one of the sixteen scalar names: a literal's suffix, or a fix-it's
    # proposed name, which no pool holds
    isNumericTypeName: consteval.isNumericTypeName
    :isScalarNameId
    :isNumericLiteralName
    # the `.true` / `.false` / `.not` suffix on a dotted arm predicate, read by arm identity
    # (`.not` answers as `.false`)
    armSuffixSide: consteval.armSuffixSide
    # the base atom's node id when a callable is the dotted `meta.create` (the enclosing
    # type's raw allocator), or none
    metaCreateBaseId: callchecks.metaCreateBaseId
    # a method FUNCTION type's return type id: the synthesized returnTypeId link when set,
    # else the AST method's recorded `out T` ref node (funcReturnNode) read through the post-
    # demand stamp
    methodReturnOf: conform.methodReturnOf
    :nodeId
    :nodeLine
    :paramIsThisReceiverId
    :methodImplementsSpec
    :templateDeclOf
    :tagAccessorOwner
    # the Decl a READER means by a type's name
    surfaceDeclOfTypeId: resolve.surfaceDeclOfTypeId
    :publicNsOf
    # E0601, an `error` the compiler proved reachable, in the author's words: the program
    # asserting, not the compiler diagnosing
    reachedErrorData: consteval.reachedErrorData
    # does this declaration declare a unit? Read off the def node's kind, which the parser
    # settled; nothing is resolved to answer
    declDeclaresUnit: resolve.declDeclaresUnit
    declOfUnitDefIds: resolve.declOfUnitDefIds
    # the Decl of the FILE unit a name denotes: the program root's child of that name, or 0
    unitDeclOfName: resolve.unitDeclOfName
    :filePathsOf
    :declMemberIsPrivate
    # the function member `cnId` of `bt` (of type `mo`) belongs to the TYPE, so no instance
    # reaches it: it declares no receiver -- `create`, a shared function of the `as` section
    memberIsTypeOnly: moves.memberIsTypeOnly
    :publicAliasInternalNames
    # the top-level unit root Decl that owns type `tid`'s declaration (declIdOfType -> parent
    # walk to the parentless unit root); 0 when the type has no declaration
    unitDeclOfTid: resolve.unitDeclOfTid
    # the numeric kind of a scalar type: one the SYSTEM declares, by the name its declaration
    # was given -- system.z's own `u8`, or wideint's `i128`
    numKindOfTid: numerics.numKindOfTid
    # the defining unit's name for type `tid`, read off the Decl parent chain; "" when the
    # type has no declaration
    unitNameOfTid: conform.unitNameOfTid
    # the defining unit's name BORROWED rather than copied
    unitNameViewOfTid: resolve.unitNameViewOfTid
    # unitPathOfTid's walk from a declaration: the units a program spells to reach what
    # `declId` declares (a unit constant's `nav`)
    unitPathOfDecl: numerics.unitPathOfDecl
    unitPathOfTid: numerics.unitPathOfTid
    # the (unit, member) pair a re-export Decl names, as ids; an absent pair when the Decl is
    # absent or not a re-export
    reexportTargetIdsOf: resolve.reexportTargetIdsOf
    :rootNameOf
    :specLookup
    # a union/variant's arm names: its members minus the synthesized ones (functions, the tag
    # data record, enums)
    sumSubtypeNames: consteval.sumSubtypeNames
    # entry point
    typecheck: resolve.typecheck
    :checkreach
    # the post-typecheck read-only environment walk: the nearest scope that holds the name
    # answers (nearestScopeOf), from what resolution already minted, and an outer scope never
    # stands in for it
    walkLookupTyperefRo: resolve.walkLookupTyperefRo
    # the parts a generated member of `tid` is built from: a record's fields, a variant's
    # payloads, an array's element
    valPartTids: conform.valPartTids
    valOpSource: conform.valOpSource
    :isLiteralTypeId
    :sumArmDeclared
    # the type in `tid`'s typedef chain that carries member `nameId`, or the last type of the
    # chain when none does
    valOpOwner: conform.valOpOwner
    # `tid` is an instance of the builtin template named `base`
    valIsMonoOf: numerics.valIsMonoOf
    # an array instance's element type: its first argument that is a type rather than a value
    arrayElemTid: conform.arrayElemTid
    # resolveUnitChild's read half: the already-minted Decl-tree answer, else the unit type's
    # member index
    resolveUnitChildRo: resolve.resolveUnitChildRo
    resolvedByIdsRo: resolve.resolvedByIdsRo
    # the chain-end base tid of a typedef (tid itself when it is not one): a typedef behaves
    # exactly as its base wherever its ownership, equality, casts or C layout are asked
    typedefChaseTid: conform.typedefChaseTid
}

astnode: zast.astnode
Ast: zast.Ast
defaultval: ztyping.defaultval

# nodeId -- the nodeid of an arbitrary type-ref / definition astnode. Covers the
# kinds a type expression or method def can take (atom / labelvalue / dotted /
# expression / call / functiondef); 0 otherwise (the stamp is then a no-op row
# the typed_nodes JOIN drops).
nodeId: function {n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case atomid then {
        return n.nodeid
    } case labelvalue then {
        return n.nodeid
    } case dottedpath then {
        return n.nodeid
    } case call then {
        return n.nodeid
    } case functiondef then {
        return n.nodeid
    } case assignment then {
        return n.nodeid
    } case reassignment then {
        return n.nodeid
    } else {
        return zast.nodeid
    }
}

# nodeLine / nodeCol -- the source position of node `n`.
nodeLine: function {n: astnode.view} out u32 is {
    return (zast.posOf :n).line
}

# a node's column, whatever arm it is. Every carrier holds one and the union
# has no common accessor, so the match lives here once
nodeCol: function {n: astnode.view} out u32 is {
    return (zast.posOf :n).col
}

# atomNameId -- the Ast.names pool id of an atomid/labelvalue node's name
# (0 when the node is neither; no pool id is 0, so lookups by it miss).
atomNameId: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    ast.drop
    match (
        n
    ) case atomid then {
        return n.name
    } case labelvalue then {
        return n.name
    } else {
        return zast.nameid.zero
    }
}

# monoSubstTid -- a tid met during an INSTANCE walk, substituted through the
# instance's type arguments; the tid itself where the instance binds nothing
# for it.
monoSubstTid: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out ztypes.tid is {
    return ((st.walk.monoParamSubst.get key: tid).or d: tid)
}

# stampGate -- a body-walk node stamp: an instance's walk writes the
# substituted type, on a row of its own; every other walk writes the type as
# it is.
stampGate: function {st: zenv.ZSymbolTable nid: zast.nodeid tid: ztypes.tid} is {
    if st.typing.curMonoStamp.notZero then {
        if (st.typing.rowIsForeign :nid) then {
            panic msg: "ztypecheck: an instance's walk typed a row that is not its own"
        }
        ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: (monoSubstTid :st :tid)
        return
    }
    ztyping.nodeTypeSet tbl: st.typing.nodeType :nid :tid
}


# record a diagnostic (with a note/hint) into the typing tables.
addErrorWithHint: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    e: zast.err
    msg: String
    note: String
    hint: String
    width: u64
} is {
    dup: false
    for each prev: st.typing.errors loop {
        if prev.lineno == lineno when prev.msg.stringView == msg then dup = true
    }
    if dup.not then {
        st.typing.errors.append (
            zast.ErrorData
            :nodeid
            :lineno
            :colno
            width: width.u32.orPanic
            err: e
            msg: msg.copy
            fsno: zvfs.fsno
            note: note.copy
            hint: hint.copy
        )
        st.typing.isError = true
    }
}

# addError -- append a typecheck diagnostic to the typing's error list,
# deduped by line and text: a spec resolved more than once reports once, and
# a statement that fails one lock twice (the call's own lock, then the pin its
# binding would hold) reports it once.
addError: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    e: zast.err
    msg: String
} is {
    en: String
    eh: String
    addErrorWithHint :st :nodeid :lineno :colno :e :msg note: en hint: eh width: 1
}

# isImplicitZeroCreateTid -- a bare type name in a runtime value position
# that constructs its zero/empty value with no arguments: the numeric
# scalars (zero) and String (empty). The stamp drives the emitter; the
# atom's nodeType stays the type id itself.
isImplicitZeroCreateTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    tid: ztypes.tid
} out bool is {
    if (numerics.isNumericTid :st :tid) then return true
    if tid == (stdTid :ast :st wk: zast.wellKnown.slot.tyString) then return true
    return false
}

# monoOfNativeTemplate -- the type instantiates a COMPILER-PROVIDED template,
# so the runtime supplies its construction and the declaration tree cannot be
# asked for it. A mono's own `create` member carries the substituted READ type
# rather than a signature, and the template's member is resolved on demand, so
# it reads as absent under `--eager` and as the element type without it.
monoOfNativeTemplate: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    go: st.reg.genericOriginOf :tid
    if go.isZero then return false
    return (st.reg.isNativeOf tid: go)
}

# bareCtorError -- one diagnostic for a construction by type name that the type
# does not offer. The teaching note is said of the bare spelling only: a bare
# type name in value position is a zero-argument `create`, which a construction
# written with arguments is not.
bareCtorError: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u64
    msg: String
    hint: String
    # the construction is the bare type name, not the name given arguments
    bare: true
} is {
    nt: String
    if bare then nt = "a bare type name in value position is a zero-argument 'create' construction".string
    mc: msg.copy
    hc: hint.copy
    (
        addErrorWithHint
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.callError
        msg: mc
        note: nt
        hint: hc
        :width
    )
}

# checkBareTypeConstruction -- a bare type name in a runtime value position
# is a zero-argument create construction. Records/classes stamp for the
# emitter when no required field remains (defaults and a body-carrying user
# create both satisfy) and report the missing fields otherwise; a typedef
# class over String is the empty string value. Families that cannot
# construct -- views, generic templates, unions/variants (an arm must be
# selected), protocols/facets, source-produced iterators, create-disabled
# types -- each get a targeted diagnostic.
checkBareTypeConstruction: function {
    st: zenv.ZSymbolTable
    ast: Ast
    node: atomref
    tid: ztypes.tid
} is {
    # the atom's width is read through a view, dropped before the check below
    # lends ast
    wdt: u32
    cbW: zast.nameTextAt :ast ref: node.name
    wdt = cbW.length.u32.orPanic
    cbW.drop
    (
        checkBareTypeValueAt
        :ast
        :st
        nodeid: node.nid
        lineno: node.lineno
        colno: node.colno
        width: wdt
        :tid
    )
}

# checkBareTypeValueAt -- checkBareTypeConstruction's core against explicit
# source coordinates, shared by the bare-atom and unit-qualified dotted legs and
# by `T.create` read as a value, the same zero-argument construction.
checkBareTypeValueAt: function {
    ast: Ast
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u64
    tid: ztypes.tid
    # the bare name, or `T.create` with no arguments
    spelling: ctorspelling.bareName
} is {
    if (st.reg.typetypeOf typeId: tid).isUserFamily.not then return
    if (callchecks.refuseNameConstruction :ast :st :nodeid :lineno :colno :width :tid :spelling
    ) then return
    tdb: callchecks.typedefBaseOf :st :tid
    # a typedef class over String (Path) is the empty string value
    if tdb.notZero when tdb == (stdTid :ast :st wk: zast.wellKnown.slot.tyString) then {
        ics: tid
        st.typing.implicitCreate.set key: nodeid value: ics
        return
    }
    # a collection or iterator instantiation constructs its empty value through
    # the runtime, which declares no fields for the check below to ask about
    if (monoOfNativeTemplate :st :tid) then {
        if (
            refuseZerolessArray
            :st
            :ast
            tplId: (st.reg.genericOriginOf :tid)
            elemTid: (conform.arrayElemTid reg: st.reg :tid)
            at: nodeid
        ) then return
        icn: tid
        st.typing.implicitCreate.set key: nodeid value: icn
        return
    }
    forceMemberOf :st :ast parentTypeId: tid nameId: zast.wellKnown.slot.wkCreate
    # the zero-argument spelling of self-construction: a bare type name (or
    # `T.create` with no arguments) in value position inside T's own create.
    if (callchecks.ctorSelfRecursionAt :st :nodeid :lineno :colno :width ctorTid: tid) then return
    prov: ListVal zast.nameid
    misN: List String
    misI: ListVal ztypes.tid
    (
        callchecks.missingCtorFields
        :ast
        :st
        funcId: tid
        isCtor: true
        provided: prov
        posCount: 0
        recvImplicit: true
        missingNames: misN
        missingIds: misI
    )
    if misN.length == 0 then {
        icr: tid
        st.typing.implicitCreate.set key: nodeid value: icr
        return
    }
    tn: specWrittenName :st :ast :tid
    lst: String
    li: u64
    ln: misN.length
    for li < ln loop {
        mn: misN.get i: li
        memberIdAt: misI.get i: li
        li = li + 1
        mtn: specWrittenName :st :ast tid: memberIdAt
        if lst.length > 0 then lst.append ", "
        ln1: "'\{mn}' (type: \{mtn})"
        lst.append ln1
    }
    m: "cannot construct '\{tn}': missing required arguments \{lst}"
    if spelling.bareName then m = "cannot construct '\{tn}' from its bare name: missing required arguments \{lst}"
    eh: "provide each listed argument ('\{tn} name: value ...') or add field defaults"
    bareCtorError :st :nodeid :lineno :colno :width msg: m hint: eh bare: spelling.bareName
}

# checkTypePathValue -- a dotted path that names a type, read as a value
# (`p: unit.Conf`, `w: p.Inner`): the zero-argument construction the type's
# bare name makes, placed at the path's last segment `leafNid`, named `leafId`.
checkTypePathValue: function {
    st: zenv.ZSymbolTable
    ast: Ast
    nid: zast.nodeid
    leafNid: zast.nodeid
    leafId: zast.nameid
    tid: ztypes.tid
} is {
    if (isImplicitZeroCreateTid :ast :st :tid) then {
        st.typing.implicitCreate.set key: nid value: tid
        return
    }
    ln: ast.nodes.get i: leafNid
    lineno: nodeLine n: ln
    colno: nodeCol n: ln
    cn: zast.nameTextCopy :ast ref: leafId
    checkBareTypeValueAt :ast :st nodeid: nid :lineno :colno width: cn.length :tid
}

# readSingletonBase -- a dotted path's base `base`, of type `bt`, that names a
# numeric generic parameter's singleton type (`SAME` in `SAME.u64`): its one
# value, which the member is read on (readSingletonValue). A bare parameter
# base is read as that value already.
readSingletonBase: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    base: zast.nodeid
    bt: ztypes.tid
} is {
    if (st.typing.numericParamRead.has key: base) then return
    if (st.typing.isSingletonType tid: bt).not then return
    if (nodeNamesType :st :ast :unitDecl nid: base) then readSingletonValue :st nid: base tid: bt
}

# readSingletonValue -- a name of a numeric generic parameter's singleton type
# read as a value at `nid` (`P9.SAME`, `SAME.u64` with `SAME: cap`): the
# type's one value, read as the bare parameter is -- the instance's value, or
# in the template's walk the value each instance gives. False for any other
# type.
readSingletonValue: function {st: zenv.ZSymbolTable nid: zast.nodeid tid: ztypes.tid} out bool is {
    row: st.typing.singletons.get key: tid
    if row.none then return false
    sg: tid
    # the template's own parameter type is each instance's own in its walk
    if row.instance.isZero then {
        ws: monoSingletonOf :st nameId: row.param
        if ws.notZero then sg = ws
    }
    v: st.typing.singletonValueOf tid: sg
    if v.isConst then st.typing.setNodeConst :nid value: v
    stampGate :st :nid tid: sg
    st.typing.numericParamRead.set key: nid value: row.param
    return true
}


# isViewFamilyTid -- a borrowed-view type: OptionView/ListView/MapEntry monos
# (generic-origin keyed), the non-generic StringView/ByteView views, and the
# writable windows (isMutableViewTid). A view result is a borrow into its parent
# container/string: the binding holds the lock its call took on the parent --
# SHARED for a readonly view, EXCLUSIVE for a window -- and the payload cannot
# be moved out.
isViewFamilyTid: function {ast: Ast st: zenv.ZSymbolTable tid: ztypes.tid} out bool is {
    if (stdtypes.isMutableViewTid :ast :st :tid) then return true
    if tid.isZero then return false
    if tid == (stdTid :ast :st wk: zast.wellKnown.slot.tyStringView) then return true
    if tid == (stdTid :ast :st wk: zast.wellKnown.slot.tyByteView) then return true
    vog: ztypes.tid
    vgo: st.reg.genericOriginOf :tid
    if vgo.notZero then vog = vgo
    if vog.isZero then return false
    if vog == (stdTid :ast :st wk: zast.wellKnown.slot.tyOptionView) then return true
    if vog == (stdTid :ast :st wk: zast.wellKnown.slot.tyOptionViewVal) then return true
    if vog == (stdtypes.stdTidRo :ast :st wk: zast.wellKnown.slot.tyStaticView) then return true
    if vog == (stdTid :ast :st wk: zast.wellKnown.slot.tyListView) then return true
    if vog == (stdTid :ast :st wk: zast.wellKnown.slot.tyListViewVal) then return true
    if vog == (stdTid :ast :st wk: zast.wellKnown.slot.tyMapEntry) then return true
    if vog == (stdTid :ast :st wk: zast.wellKnown.slot.tyMapEntryRV) then return true
    if vog == (stdTid :ast :st wk: zast.wellKnown.slot.tyMapEntryVR) then return true
    if vog == (stdTid :ast :st wk: zast.wellKnown.slot.tyMapEntryVV) then return true
    return false
}

# byteOf -- the byte at index i (0 when out of range).
byteOf: function {s: StringView i: u64} out u8 is {
    bo: s.byteAt i
    if bo.some then {
        return bo
    }
    return 0
}

# levenshtein -- byte-level edit distance (two-row DP), for did-you-mean.
levenshtein: function {a: StringView b: StringView} out u64 is {
    na: a.length
    nb: b.length
    if na == 0 then return nb
    if nb == 0 then return na
    prev: ListVal u64
    j0: u64
    for j0 <= nb loop {
        jv: j0
        prev.append jv
        j0 = j0 + 1
    }
    i: u64
    for i < na loop {
        cur: ListVal u64
        cur.append i + 1
        ab: byteOf s: a :i
        j: u64
        for j < nb loop {
            bb: byteOf s: b i: j
            cost: 1.u64
            if ab == bb then cost = 0
            delc: (prev.get i: j + 1) + 1
            insc: (cur.get i: j) + 1
            subc: (prev.get i: j) + cost
            best: delc
            if insc < best then best = insc
            if subc < best then best = subc
            cur.append best
            j = j + 1
        }
        prev = cur.take
        i = i + 1
    }
    return (prev.get i: nb)
}

# suggestSimilar -- the closest child name of parentTypeId to `name` (edit
# distance <= 2 and unique); "" if none. Powers the did-you-mean hint.
suggestSimilar: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    parentTypeId: ztypes.tid
    name: StringView
} out String is {
    best: String
    bestDist: 3.u64
    tied: false
    otci: parentTypeId
    ci: u64
    nameCount: st.typing.declRowSlots ownerTid: otci
    for ci < nameCount loop {
        rwci: st.typing.declRowAt ownerTid: otci membersOnly: false slot: ci
        ci = ci + 1
        if rwci.keep then {
            nid: rwci.name
            cnB: ast.names.texts.get i: nid
            cn: cnB.stringView
            if (cn == name).not then {
                d: levenshtein a: name b: cn
                if d < bestDist then {
                    best = cnB.copy
                    bestDist = d
                    tied = false
                } else {
                    if d == bestDist then tied = true
                }
            }
        }
    }
    if bestDist <= 2 when tied.not when best.length > 0 then return best
    return "".string
}

# indexAddedUnits -- index units loaded into a checked tree after its check
# ran (zls loads one the program does not use when completion names it, with
# the units it names): `units` are new top-level units, `members` new members
# of the unit declared by `ownerDecl`. Each is indexed as the check indexes a
# unit -- generators lowered, unit type minted, declarations made, `public:`
# block scanned -- and nothing is demanded: a later lookup resolves what it
# reaches. A unit whose name the program root already holds is skipped. The
# tree's files from `fileFrom` on get their display paths.
indexAddedUnits: function {
    st: zenv.ZSymbolTable
    program: Ast
    vfs: zvfs.ZVfs.view
    units: (ListVal zast.nodeid).view
    ownerDecl: ztypes.declid
    members: (ListVal zast.nodeid).view
    fileFrom: u64
} is {
    fresh: ListVal zast.nodeid
    for each ruId: units loop {
        ru: program.nodes.get i: ruId
        if ru.namedoperation then {
            held: st.typing.declFindChild parentDeclId: st.typing.programRoot nameId: ru.name
            if held.isZero then fresh.append ruId
        }
    }
    for each ruId: fresh loop {
        (
            lowerDeclaredGeneratorsInUnit
            :st
            ast: program
            unitdefId: (argRefAt ast: program nid: ruId).operation
        )
    }
    seen: IdSet zast.nameid
    for each ruId: fresh loop resolve.registerOneUnitRoot :st :program :ruId seenUnits: seen
    for each ruId: fresh loop {
        resolve.indexOneUnitDef :st :program :ruId
        (
            declare.scanUnitVisibility
            :st
            ast: program
            unitdefId: (argRefAt ast: program nid: ruId).operation
        )
    }
    if ownerDecl.notZero then {
        for each mId: members loop {
            m: argRefAt ast: program nid: mId
            if m.nid.notZero then {
                isUnit: (program.nodes.get i: m.operation).unitdef
                if isUnit then lowerDeclaredGeneratorsInUnit :st ast: program unitdefId: m.operation
                (
                    declare.indexDeclDef
                    :st
                    ast: program
                    parentDeclId: ownerDecl
                    nameRef: m.name
                    nopNodeId: m.nid
                    opNodeId: m.operation
                )
                if isUnit then declare.scanUnitVisibility :st ast: program unitdefId: m.operation
            }
        }
    }
    fi: fileFrom
    for fi < program.files.length loop {
        f: program.files.get i: fi
        st.typing.filePaths.set key: f value: (vfs.displayPath dentryid: f)
        fi = fi + 1
    }
}

# resolveUnitMemberLate -- the unit member `name` of `unitDecl`, resolved for a
# reader after the check (zls): descendNamed, then the type-refs that resolution
# recorded are stamped, as the check stamps a namespace member resolved alone.
# Unstamped, its signature would read its return type as nothing.
resolveUnitMemberLate: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    name: StringView
} out ztypes.tid is {
    t: resolve.descendNamed :st scope: ztypes.declid :ast :unitDecl :name
    resolve.stampResolvedOnDemand :st :ast
    return t
}

# constValueOfDeclLate -- the value the declaration `declId` holds, for a reader
# after the check (zls's card for a constant): the memo when a read already
# folded it, else, for a constant, folded now, as a lookup folds one it meets
# unfolded. A re-export is asked as resolveAliasKey asks one: `os: oskind.linux`
# folds to its arm. A list's element is its list row's item. noConst when the
# declaration holds no value.
constValueOfDeclLate: function {
    st: zenv.ZSymbolTable
    ast: Ast
    declId: ztypes.declid
} out ztypes.cval is {
    if declId.isZero then return ztypes.noConst
    lr: listDeclRow :ast :st declId: (st.typing.declParentOf :declId)
    if lr != 0 then return (
        staticListMemberValue
        :st
        :ast
        row: lr
        nameId: (st.typing.declNameOf :declId)
    )
    otid: st.typing.declTypeOf declId: (st.typing.declParentOf :declId)
    if otid.isZero then return ztypes.noConst
    dk: (st.typing.decls.get i: declId).kind
    k: st.typing.memberConstKey parentTypeId: otid nameId: (st.typing.declNameOf :declId)
    if dk.constDecl or dk.reexportDecl or dk.staticListDecl when (
        (st.walk.constEvalState.get key: k).or
        d: ztyping.constevalstate.unvisited
    ).done.not then {
        constFoldDecl :ast :st :declId
        resolve.stampResolvedOnDemand :st :ast
    }
    return (constValueOfDecl :st :declId)
}

# defsite -- where a name is defined: the unit to look it up in, and the
# re-export Decl that binds it when one does. Zero unit on a miss.
defsite: record {
    # the unit the definition was written in, which is the scope it resolves in
    defUnit: ztypes.declid
    # the alias that brought it into view, when one did
    aliasDecl: ztypes.declid
}

# genericParamTypeId -- the name is a member of the enclosing type that is a
# type there (typeAsMemberTid): a generic PARAMETER, its canonical
# GENERIC_PARAM id, minted on first reference and recorded against the
# referencing node, or an alias, its target. 0 when there is no enclosing type,
# or the name is neither.
genericParamTypeId: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nameId: zast.nameid
    thisName: StringView
    nid: zast.nodeid
} out ztypes.tid is {
    if thisName.length == 0 then return ztypes.tid.zero
    enclosingDecl: declOfUnitDef :st :scope :unitDecl nameId: (nameIdOf :ast name: thisName)
    return (typeAsMemberTid :st :ast tdecl: enclosingDecl :nameId :nid numeric: true)
}

# typeAsMemberTid -- the type the name `nameId` denotes as a member of the type
# declared by `tdecl`, written in that type's own scope: a generic parameter,
# its GENERIC_PARAM id recorded against `nid` (a numeric one only when
# `numeric`, for elsewhere it is a value), or an alias, its target. 0 for any
# other name.
typeAsMemberTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tdecl: ztypes.declid
    nameId: zast.nameid
    nid: zast.nodeid
    numeric: bool
} out ztypes.tid is {
    if tdecl.isZero or nameId.isZero then return ztypes.tid.zero
    if (st.reg.isGenericParamOf :tdecl name: nameId) then {
        if numeric.not when (
            st.reg.genericParamConstraintOf
            :tdecl
            paramName: nameId
        ).numKind.has then return ztypes.tid.zero
        declare.recordGenericParamRef :st :nid scope: tdecl name: nameId
        return (declare.genericParamTidMint :st :ast :tdecl :nameId)
    }
    # a `:x` shorthand names x as it is named outside the declaration it makes,
    # which is the one member of that name
    if nid.notZero when (ast.nodes.get i: nid).labelvalue then return ztypes.tid.zero
    md: st.typing.declFindChild parentDeclId: tdecl :nameId
    if md.isZero then return ztypes.tid.zero
    at: asAliasTargetOf :st :ast :tdecl :md
    # the nearest declaration wins: an `as` member that is a value -- a
    # constant, an implementation -- stops the name here, and is refused as
    # what it is. A method is named for what it converts to (`u64`'s `.i128`,
    # BigInt's `u64` returning a u64), and the type's `is` members -- its fields
    # and arms (`idkey`'s `:u8`) -- name no types: neither stops the name
    if at.isZero when nid.notZero when (memberStopsTypeName :st :ast :tdecl :md) then {
        refuseMemberAsType :st :ast :tdecl :md :nid
        return ztypes.tid.zero
    }
    # the referencing node is stamped with the target here: the deferred stamp
    # resolves in the scope the type is written in, which sees no alias
    if at.notZero when nid.notZero then {
        ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: at
        nsk: nid
        nsv: true
        st.walk.noStampNode.set key: nsk value: nsv
    }
    return at
}

# memberStopsTypeName -- the member `md` of the type declared by `tdecl` is an
# `as` item holding a value -- a constant that folds -- and no alias, method or
# generic parameter: written where a type is, its name finds it before any
# outer type of that spelling.
memberStopsTypeName: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tdecl: ztypes.declid
    md: ztypes.declid
} out bool is {
    if (asMemberIsAlias :st :ast :tdecl :md) then return false
    item: argRefAt :ast nid: (st.typing.decls.get i: md).node
    if item.operation.notZero when (zast.isGenericParamOp :ast opId: item.operation
    ) then return false
    return true
}

# memberKindPhrase -- what the member `md` of the type declared by `tdecl` is,
# as a refusal names it: a method, a field, an arm, an implementation or a
# constant.
memberKindPhrase: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tdecl: ztypes.declid
    md: ztypes.declid
} out String is {
    if (st.typing.decls.get i: md).kind.methodDecl then return "a method".string
    item: argRefAt :ast nid: (st.typing.decls.get i: md).node
    if (asMemberIsAsItem :st :ast :tdecl :md) then {
        if item.operation.notZero when (zast.implementBaseOf :ast opId: item.operation
        ).notZero then return "an implementation".string
        if item.operation.notZero when (ast.nodes.get i: item.operation).functiondef then {
            return "a method".string
        }
        return "a constant".string
    }
    if (st.reg.typetypeOf typeId: (st.typing.declTypeOf declId: tdecl)
    ).isSum then return "an arm".string
    return "a field".string
}

# memberFailedWhereWritten -- the member `md` of the type declared by `tdecl`
# has no definition to stand for, and its own refusal says why: an `as`
# constant whose value does not fold, or a member whose value was refused
# where it is written. That report stands for every use of the member.
memberFailedWhereWritten: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tdecl: ztypes.declid
    md: ztypes.declid
} out bool is {
    item: argRefAt :ast nid: (st.typing.decls.get i: md).node
    if item.operation.isZero then return false
    if (st.typing.refusedValues.has item: item.operation) then return true
    if (asMemberIsAsItem :st :ast :tdecl :md).not then return false
    if (st.typing.decls.get i: md).kind.methodDecl then return false
    # an implementation holds no value either, and is refused as what it is
    if (zast.implementBaseOf :ast opId: item.operation).notZero then return false
    # a constant that does not fold says why where it is written (attachAsConstant)
    constFoldDecl :ast :st declId: md
    return (constValueOfDecl :st declId: md).kind.none
}

# refuseMemberAsType -- E0100 at the type-ref `nid` that names the `as` member
# `md` of the type declared by `tdecl`, a member that is no type: the nearest
# declaration of the name, which an outer type of that spelling does not
# answer for. The ref is refused with it, so its stamp reports nothing more.
refuseMemberAsType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tdecl: ztypes.declid
    md: ztypes.declid
    nid: zast.nodeid
} is {
    dname: (st.typing.decls.get i: md).name
    # a member whose own definition failed said why where it is written, and
    # that report stands for every use of it
    quiet: memberFailedWhereWritten :st :ast :tdecl :md
    what: memberKindPhrase :st :ast :tdecl :md
    nn: zast.nameTextAt :ast ref: dname
    tn: zast.nameTextAt :ast ref: (st.typing.decls.get i: tdecl).name
    n: ast.nodes.get i: nid
    if quiet.not then (
        addErrorWithHint
        :st
        nodeid: nid
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.typeError
        msg: "'\{nn}' is \{what} of '\{tn}', not a type"
        note: "".string
        hint: "".string
        width: nn.length
    )
    st.typing.refusedValues.add item: nid
    nsk: nid
    nsv: true
    st.walk.noStampNode.set key: nsk value: nsv
}

# --- `as` aliases -----------------------------------------------------------
# A type's `as` item whose value names a type is an alias of it: a name local
# to the type (`Node: zast.Node`), seen wherever the type's own scope is -- its
# fields, its method signatures and bodies -- and through a path (`Tree.Node`).
# Whether an item is one is read off the declarations; its target resolves on
# first use, in the scope the type is written in, with the type's own generic
# parameters and aliases in reach.

# the depth a chain of aliases naming aliases is followed to; a ring is cut there
asAliasDepth: 16

# asMemberIsAsItem -- the member declaration `md` of the type declared by
# `tdecl` is one of its `as` items, not an `is` field or arm.
asMemberIsAsItem: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    tdecl: ztypes.declid
    md: ztypes.declid
} out bool is {
    dn: (st.typing.decls.get i: md).node
    tn: (st.typing.decls.get i: tdecl).node
    if dn.isZero or tn.isZero then return false
    objId: zast.nodeid
    {
        nop: ast.nodes.get i: tn
        if nop.namedoperation then objId = nop.operation
    }
    if objId.isZero then return false
    orf: declare.objRefAt :ast nid: objId
    i: u64
    for i < orf.nas loop {
        if (zast.objAsItemAt :ast nid: objId :i) == dn then return true
        i = i + 1
    }
    return false
}

# declNamesType -- the declaration `d`, found by name, defines a type: a type
# definition, or a unit's alias of one (`Node: zast.Node`). Read off the
# declaration and never folded -- a constant's value reads the names in it
# (`A: B + 1` asks `B.+`), so a fold here would follow a ring of constants
# without end. A constant, a function and a unit name none.
declNamesType: function {st: zenv.ZSymbolTable.view ast: Ast.view d: ztypes.declid} out bool is {
    if d.isZero then return false
    k: (st.typing.decls.get i: d).kind
    if k.unitDecl or k.funcDecl or k.constDecl then return false
    tto: resolve.declDefTypetype :st :ast declId: d
    if tto.some then {
        return (tto != ztypes.ztypetype.functionType) and (tto != ztypes.ztypetype.unitType)
    }
    if k.reexportDecl then return (aliasNamesType :st :ast declId: d)
    return false
}

# pathTypeDecl -- the type declaration a name or a path written in the unit
# scope `scope` names, read off the declarations: a name the scope reaches, or
# a member of a unit a path names (`zast.Node`, `u.sub.T`). 0 when it names no
# type that way.
pathTypeDecl: function {
    st: zenv.ZSymbolTable
    ast: Ast
    scope: ztypes.declid
    nid: zast.nodeid
} out ztypes.declid is {
    none: ztypes.declid
    isAtom: false
    nm: zast.nameid
    par: zast.nodeid
    chd: zast.nodeid
    {
        n: ast.nodes.get i: nid
        if n.atomid then {
            isAtom = true
            nm = n.name
        }
        if n.dottedpath then {
            par = n.parent
            chd = n.child
        }
    }
    if isAtom then {
        d: nearestDeclOf :st :scope baseId: nm
        if (declNamesType :st :ast :d) then return d
        return none
    }
    if par.isZero then return none
    ud: qualifierUnitDecl :st :scope :ast nid: par
    if ud.isZero then return none
    m: st.typing.declFindChild parentDeclId: ud nameId: (atomNameId :ast n: (ast.nodes.get i: chd))
    if (declNamesType :st :ast d: m) then return m
    return none
}

# asValueNamesType -- the value `op` of the `as` item named `item` of the type
# declared by `tdecl` names a type, which makes the item an alias of it: the
# type's own generic parameter or alias, a type its scope reaches by name or
# through a unit (`zast.Node`), an alias of another type (`Tree.Node`), or an
# instance of a generic template (`(ListVal t)`). Read off the declarations,
# never resolved: a constant, an arm (`kind.fast`), a member that is no type,
# a marker and a literal name none.
asValueNamesType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tdecl: ztypes.declid
    item: zast.nameid
    op: zast.nodeid
    depth: u64
} out bool is {
    if op.isZero or (depth > asAliasDepth) then return false
    kind: zast.nodekind.placeholder
    nm: zast.nameid
    par: zast.nodeid
    chd: zast.nodeid
    cal: zast.nodeid
    {
        n: ast.nodes.get i: op
        kind = zast.kindOf :n
        if n.atomid then {
            nm = n.name
        }
        if n.dottedpath then {
            par = n.parent
            chd = n.child
        }
        if n.call then {
            cal = n.callable
        }
    }
    if kind.atomid then return (asNameNamesType :st :ast :tdecl :item :nm :depth)
    if kind.dottedpath then return (asPathNamesType :st :ast :tdecl :op :par :chd :depth)
    if kind.call then {
        tpl: (
            typeargs.typeApplicationTemplate
            :st
            scope: tdecl
            :ast
            unitDecl: (unitRootOfDecl typing: st.typing declId: tdecl)
            callableNid: cal
        )
        if tpl.isZero then return false
        return (st.reg.isGenericOf tid: tpl)
    }
    return false
}

# asNameNamesType -- asValueNamesType for a bare name `nm`: the type's own
# generic parameter (a numeric one is a value) or alias, or a type the type's
# scope reaches by name. The item's own name names itself, no type.
asNameNamesType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tdecl: ztypes.declid
    item: zast.nameid
    nm: zast.nameid
    depth: u64
} out bool is {
    if (nm == item) or (isNumericLiteralNameAt :ast ref: nm) then return false
    # a numeric parameter too: its type is its singleton type
    if (st.reg.isGenericParamOf :tdecl name: nm) then return true
    own: st.typing.declFindChild parentDeclId: tdecl nameId: nm
    if own.notZero then return (asMemberIsAliasAt :st :ast :tdecl md: own depth: depth + 1)
    uscope: resolve.unitScopeOf typing: st.typing declId: tdecl
    return (declNamesType :st :ast d: (nearestDeclOf :st scope: uscope baseId: nm))
}

# asPathNamesType -- asValueNamesType for a path `op` (`par`.`chd`): a member of
# a unit that is a type (`zast.Node`), or an alias of another type
# (`Tree.Node`). A marker leaf, an arm and any other member name none.
asPathNamesType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tdecl: ztypes.declid
    op: zast.nodeid
    par: zast.nodeid
    chd: zast.nodeid
    depth: u64
} out bool is {
    leaf: atomNameId :ast n: (ast.nodes.get i: chd)
    if (typeref.leafNamesNoMember leafId: leaf) then return false
    uscope: resolve.unitScopeOf typing: st.typing declId: tdecl
    if (pathTypeDecl :st :ast scope: uscope nid: op).notZero then return true
    pt: pathTypeDecl :st :ast scope: uscope nid: par
    if pt.isZero then return false
    pm: st.typing.declFindChild parentDeclId: pt nameId: leaf
    return (asMemberIsAliasAt :st :ast tdecl: pt md: pm depth: depth + 1)
}

# asMemberIsAlias -- the member `md` of the type declared by `tdecl` is an
# alias: one of its `as` items, no method, generic parameter, implementation,
# tag spec or shorthand, whose value names a type (asValueNamesType). Asked
# once per member.
asMemberIsAlias: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tdecl: ztypes.declid
    md: ztypes.declid
} out bool is {
    return (asMemberIsAliasAt :st :ast :tdecl :md depth: 0)
}

# asMemberIsAliasAt -- asMemberIsAlias, `depth` aliases into a chain of them.
asMemberIsAliasAt: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tdecl: ztypes.declid
    md: ztypes.declid
    depth: u64
} out bool is {
    if md.isZero or tdecl.isZero then return false
    kv: st.typing.asAliasKind.get key: md
    if kv.some then {
        return kv == 1
    }
    yes: false
    # a method, and a name no `as` item spells as a type, are no alias: asked
    # before the walk of the type's `as` items
    mdk: (st.typing.decls.get i: md).kind
    mdn: (st.typing.decls.get i: md).name
    shaped: mdk.methodDecl.not and (st.walk.asTypeShapedNames.has item: mdn)
    if shaped when (asMemberIsAsItem :st :ast :tdecl :md) then {
        item: argRefAt :ast nid: (st.typing.decls.get i: md).node
        if (declare.asItemCanAlias :st :ast :tdecl :item) then yes = (
            asValueNamesType
            :st
            :ast
            :tdecl
            item: item.name
            op: item.operation
            :depth
        )
    }
    kk: md
    kvv: 2.u8
    if yes then kvv = 1
    st.typing.asAliasKind.set key: kk value: kvv
    return yes
}

# asAliasKnownAt -- whether the member `md` is already known to be an alias,
# for a reader holding only views: the forced member was asked first
# (forceMemberDecl).
asAliasKnownAt: function {typing: ztyping.ZTyping.view md: ztypes.declid} out bool is {
    if md.isZero then return false
    return ((typing.asAliasKind.get key: md).or d: 0.u8) == 1
}

# asAliasTargetOf -- the type the alias `md` of the type declared by `tdecl`
# names: resolved on first ask in the scope the type is written in, with the
# type's own generic parameters and aliases in reach, and kept. 0 when `md` is
# no alias, or its target does not resolve (an alias asked while its own target
# resolves is a ring of them).
asAliasTargetOf: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tdecl: ztypes.declid
    md: ztypes.declid
} out ztypes.tid is {
    if (asMemberIsAlias :st :ast :tdecl :md).not then return ztypes.tid.zero
    have: (st.walk.asAliasTarget.get key: md).or d: ztypes.tid.zero
    if have.notZero then return have
    if (st.typing.declIsResolving declId: md) then return ztypes.tid.zero
    op: (argRefAt :ast nid: (st.typing.decls.get i: md).node).operation
    tn: zast.nameTextCopy :ast ref: (st.typing.decls.get i: tdecl).name
    sgt: (
        numericParamAliasTarget
        :st
        :ast
        scope: tdecl
        nameId: (zast.atomNameIdOf n: (ast.nodes.get i: op))
    )
    if sgt.notZero then {
        st.walk.asAliasTarget.set key: md value: sgt
        return sgt
    }
    st.typing.declSetResolving declId: md mark: true
    t: (
        typeref.resolveTyperefShell
        :st
        scope: tdecl
        :ast
        unitDecl: (unitRootOfDecl typing: st.typing declId: tdecl)
        nid: op
        thisName: tn.stringView
    )
    st.typing.declSetResolving declId: md mark: false
    if t.notZero then {
        mk: md
        mv: t
        st.walk.asAliasTarget.set key: mk value: mv
    }
    return t
}

# numericParamAliasTarget -- the target of an alias whose value is the bare name
# `nameId` of a numeric generic parameter of the definition at or enclosing
# `scope` (`SAME: cap`): the parameter's own singleton type, where a type-ref of
# the name takes its bound. 0 for any other name.
numericParamAliasTarget: function {
    st: zenv.ZSymbolTable
    ast: Ast
    scope: ztypes.declid
    nameId: zast.nameid
} out ztypes.tid is {
    if nameId.isZero then return ztypes.tid
    npo: numericParamOwnerFrom :st :scope :nameId
    if npo.isZero then return ztypes.tid
    cd: st.reg.genericParamConstraintOf tdecl: npo paramName: nameId
    bnd: numericBoundTid :ast :st :scope :cd
    if bnd.isZero then return ztypes.tid
    return (abstractSingletonOf :st :ast tdecl: npo param: nameId bound: bnd)
}

# typePathAliasTid -- the target of the alias a path through a type names
# (`Tree.Node`, `unit.Tree.Node`): the type the parent `parentNid` names, read
# off the declarations from the scope `scope` it is written in, and its alias
# `leafId`. One the type keeps out of its `public:` block is refused where the
# path is written outside the type (E0101) and still names its target. 0 when
# the path names no alias.
typePathAliasTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    scope: ztypes.declid
    parentNid: zast.nodeid
    leafId: zast.nameid
    # the path, where a refusal is placed
    nid: zast.nodeid
} out ztypes.tid is {
    if (st.walk.asTypeShapedNames.has item: leafId).not then return ztypes.tid.zero
    # an operator is a method (`B + 1` calls `B.+`), never an alias
    isOp: false
    {
        lt: zast.nameTextAt :ast ref: leafId
        isOp = isOperatorName name: lt.stringView
    }
    if isOp then return ztypes.tid.zero
    td: (
        pathTypeDecl
        :st
        :ast
        scope: (resolve.unitScopeOf typing: st.typing declId: scope)
        nid: parentNid
    )
    md: st.typing.declFindChild parentDeclId: td nameId: leafId
    # an INSTANCE of a generic type (`(Box t: i64)`, or a name defined as one)
    # declares no alias of its own: its template's alias, completed with the
    # instance's arguments, is the one it has
    inst: ztypes.tid
    if (asMemberIsAlias :st :ast tdecl: td :md).not then {
        inst = pathInstanceTid :st :ast :scope :parentNid :leafId
        if inst.isZero then return ztypes.tid.zero
        td = templateDeclOf reg: st.reg typing: st.typing tid: inst
        md = st.typing.declFindChild parentDeclId: td nameId: leafId
        if (asMemberIsAlias :st :ast tdecl: td :md).not then return ztypes.tid.zero
    }
    # the path refers to the alias, as a path to a definition refers to it
    rdk: nid
    rdv: md
    st.typing.refDecl.set key: rdk value: rdv
    pn: st.typing.declPublicNsOf owner: td
    if pn.notZero when (st.typing.declFindChild parentDeclId: pn nameId: leafId).isZero when (
        scopeIsInside
        :st
        :scope
        outer: td
    ).not then {
        dn: ast.nodes.get i: nid
        cn: zast.nameTextAt :ast ref: leafId
        tn: zast.nameTextAt :ast ref: (st.typing.decls.get i: td).name
        (
            addErrorWithHint
            :st
            nodeid: nid
            lineno: (nodeLine n: dn)
            colno: (nodeCol n: dn)
            e: zast.err.notPublic
            msg: "'\{cn}' is not public on type '\{tn}'"
            note: "".string
            hint: "".string
            width: 1
        )
    }
    target: asAliasTargetOf :st :ast tdecl: td :md
    if inst.isZero or target.isZero then return target
    # an alias of the template's numeric parameter (`SAME: cap`) is the
    # instance's singleton type
    srow: st.typing.singletons.get key: target
    if srow.some when srow.instance.isZero then {
        isg: st.typing.singletonOf instance: inst param: srow.param
        if isg.notZero then return isg
    }
    return (
        partialSubstituted
        :st
        :ast
        unitDecl: (owningUnitDecl :st declId: scope)
        partial: inst
        tid: target
    )
}

# applicationDeclaresAlias -- the call `app`, written in `scope`, applies a type
# whose declaration has the alias `leafId`: read off the declarations, so a value
# call (an operator, a function, a method on a local) is told apart unresolved.
applicationDeclaresAlias: function {
    st: zenv.ZSymbolTable
    ast: Ast
    scope: ztypes.declid
    app: zast.nodeid
    leafId: zast.nameid
} out bool is {
    callable: zast.nodeid
    infix: false
    {
        an: ast.nodes.get i: app
        if an.call then {
            callable = an.callable
            infix = an.infix
        }
    }
    if infix or callable.isZero then return false
    rn: rootNameIdOf :ast n: (ast.nodes.get i: callable)
    if rn.notZero when (st.lookup nameId: rn).some then return false
    td: (
        pathTypeDecl
        :st
        :ast
        scope: (resolve.unitScopeOf typing: st.typing declId: scope)
        nid: callable
    )
    md: st.typing.declFindChild parentDeclId: td nameId: leafId
    return (asMemberIsAlias :st :ast tdecl: td :md)
}

# pathInstanceTid -- the instance of a generic type a path's parent names, when
# its template declares the alias `leafId`: a type application (`(Box t: i64)`),
# or a name whose definition is one (`B: (Box t: i64)`). Most parents a path
# goes through are values (`(f x: 1).not`, `(v.has k).not`), so the head is read
# off the declarations first, and only an application whose template has the
# alias is resolved. 0 for any other parent.
pathInstanceTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    scope: ztypes.declid
    parentNid: zast.nodeid
    leafId: zast.nameid
} out ztypes.tid is {
    # the application: the parent itself, or the value of the definition the
    # parent names, read in the scope that definition is written in
    app: zast.nodeid
    appScope: scope
    nm: zast.nameid
    {
        n: ast.nodes.get i: parentNid
        if n.call then app = parentNid
        if n.atomid then nm = n.name
    }
    if nm.notZero then {
        h: envLookup :st :scope nameId: nm
        if h.declId.isZero then return ztypes.tid.zero
        dn: (st.typing.decls.get i: h.declId).node
        if dn.isZero then return ztypes.tid.zero
        dv: ast.nodes.get i: dn
        if dv.namedoperation when (ast.nodes.get i: dv.operation).call then {
            app = dv.operation
            appScope = st.typing.declParentOf declId: h.declId
        }
    }
    if app.isZero then return ztypes.tid.zero
    if (applicationDeclaresAlias :st :ast scope: appScope :app :leafId
    ).not then return ztypes.tid.zero
    t: (
        typeref.resolveTyperefShell
        :st
        :ast
        unitDecl: (owningUnitDecl :st declId: scope)
        :scope
        nid: parentNid
        thisName: ""
    )
    if (st.reg.genericOriginOf tid: t).isZero then return ztypes.tid.zero
    return t
}

# scopeIsInside -- the scope `scope` is the declaration `outer` or lies within
# it: a member, a method's body.
scopeIsInside: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    outer: ztypes.declid
} out bool is {
    cur: scope
    for cur.notZero loop {
        if cur == outer then return true
        cur = st.typing.declParentOf declId: cur
    }
    return false
}

# typeDeclAliasTid -- the target of the alias `nameId` of the type declared by
# `decl`; 0 when `decl` declares no type, or no alias of that name.
typeDeclAliasTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    decl: ztypes.declid
    nameId: zast.nameid
} out ztypes.tid is {
    if (st.walk.asTypeShapedNames.has item: nameId).not then return ztypes.tid.zero
    if (st.typing.decls.get i: decl).kind.typeDecl.not then return ztypes.tid.zero
    md: st.typing.declFindChild parentDeclId: decl :nameId
    if md.isZero then return ztypes.tid.zero
    return (asAliasTargetOf :st :ast tdecl: decl :md)
}

# enclosingAsAliasTid -- the target of an alias named `nameId` of a type
# enclosing the scope `scope` (a method's body, a type's `as` item), the
# nearest first; 0 when none declares one.
enclosingAsAliasTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    scope: ztypes.declid
    nameId: zast.nameid
} out ztypes.tid is {
    if (st.walk.asTypeShapedNames.has item: nameId).not then return ztypes.tid.zero
    cur: scope
    for cur.notZero loop {
        if (st.typing.decls.get i: cur).kind.unitDecl then return ztypes.tid.zero
        at: typeDeclAliasTid :st :ast decl: cur :nameId
        if at.notZero then return at
        cur = st.typing.declParentOf declId: cur
    }
    return ztypes.tid.zero
}

# isScalarNameId -- whether name id `id` is one of the sixteen scalar names,
# which every pool holds at fixed ids (zast.wellKnown's ty* entries).
isScalarNameId: function {id: zast.nameid} out bool is {
    return (id >= zast.wellKnown.slot.tyI8) and (id <= zast.wellKnown.slot.tyF128)
}

# isNumericLiteralName -- true when a name begins with a digit, or a sign and
# a digit: a numeric-literal atom (an `as`-block static constant like
# `version: 1`), as opposed to a type-name atom (an implementation marker). 48..57
# are the ASCII digits, 45 the minus and 43 the plus.
isNumericLiteralName: function {name: StringView} out bool is {
    b0: name.byteAt 0.u64
    if b0.some then {
        if (ascii.isDigit b: b0) then return true
        # a sign, `-` or `+`, then a digit
        if (b0 == 0c-) or (b0 == 0c+) then {
            b1: name.byteAt 1.u64
            if b1.some when (ascii.isDigit b: b1) then return true
        }
    }
    return false
}

# isNumericLiteralNameAt -- the same question asked of an interned name id.
# The text is read through a borrow, so a caller that wants only the answer
# copies nothing; a zero ref reads the sentinel empty text.
isNumericLiteralNameAt: function {ast: Ast.view ref: zast.nameid} out bool is {
    result: false
    text: zast.nameTextAt :ast :ref
    result = isNumericLiteralName name: text.stringView
    return result
}

# isStringViewMember / isListViewMember -- the view-conversion members, named
# once each so a reader changing the spelling has one place to change and the
# emitter, the checker and the linter cannot drift apart on it.
isStringViewMember: function {nameId: zast.nameid} out bool is {
    return nameId == zast.wellKnown.slot.wkStringView
}

# valueIsHold -- true when a bound value carries the `.hold` marker. `hold` is
# owned and readonly, so the binding both moves
# the source away and freezes itself.
valueIsHold: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case dottedpath then {
        return (zast.markerKindOfLeaf :ast leaf: n.child).holdMarker
    } else {
        return false
    }
}

# isStripMarkerId -- the ownership and access markers a value path may end in,
# by id: not addressable segments of the path. A type reference peels them to
# reach its base; `public` peels too, as the in-unit `public.X` namespace.
isStripMarkerId: function {nameId: zast.nameid} out bool is {
    if nameId == zast.wellKnown.slot.wkPublic then return true
    k: zast.markerKindOfName id: nameId
    if k.unmarked or k.dropMarker or k.implementMarker then return false
    return k.genericBound.not
}

# isStringViewMemberId -- `.stringView`, by id.
isStringViewMemberId: function {nameId: zast.nameid} out bool is {
    return nameId == zast.wellKnown.slot.wkStringView
}

# unitNestedSelf -- a bare name, inside a generic unit, of a type that unit
# declares means this unit instance's own copy of it: the instance on an
# instance walk, the template itself on the template's walk. 0 for any other
# type or place, and for a type with parameters of its own, which has an
# instance per argument rather than one copy.
unitNestedSelf: function {
    st: zenv.ZSymbolTable.view ast: Ast.view tid: ztypes.tid
} out ztypes.tid is {
    none: ztypes.tid
    if (st.reg.isGenericOf :tid).not or (ownsTypeParams :st :tid) then return none
    td: templateDeclOf reg: st.reg typing: st.typing :tid
    if td.isZero then return none
    ud: st.typing.declParentOf declId: td
    if ud.isZero then return none
    if (declIsUnitTemplate :st :ast declId: ud).not then return none
    cur: st.curScope
    for cur.notZero loop {
        if cur == ud then return (monoSubstTid :st :tid)
        cur = st.typing.declParentOf declId: cur
    }
    return none
}

# declIsUnitTemplate -- the declaration is a generic unit: a nested
# `unit { t: anyval.generic ... }` template, a generic FILE unit, or a
# `unit { ... }` written in either. The types each declares are generic over its
# parameters, and each instance has its own copy of them.
declIsUnitTemplate: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    if declId.isZero then return false
    if (resolve.declDeclaresTemplate :st :ast :declId) then return true
    if (declIsGenericFileUnit :st :ast :declId) then return true
    # a `unit { ... }` written in a generic unit took its parameters
    # (resolveNamespaceUnit)
    if (resolve.declIsNamespace :st :ast :declId).not then return false
    return (st.reg.genericParamNamesOf tdecl: declId).length > 0
}

# scopeInUnitTemplate -- `scope` is a generic unit template or lies inside one:
# what is resolved there is resolved for the template, and each instance has its
# own.
scopeInUnitTemplate: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    scope: ztypes.declid
} out bool is {
    cur: scope
    for cur.notZero and (cur != st.typing.programRoot) loop {
        if (declIsUnitTemplate :st :ast declId: cur) then return true
        cur = st.typing.declParentOf declId: cur
    }
    return false
}

# declIsGenericFileUnit -- the declaration is a FILE unit (a child of the program
# root) whose body declares a generic parameter: a template like a nested
# `unit { ... }`, with its parameters on its root declaration.
declIsGenericFileUnit: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    if (st.typing.declParentOf :declId) != st.typing.programRoot then return false
    dn: (st.typing.decls.get i: declId).node
    if dn.isZero then return false
    ar: argRefAt :ast nid: dn
    if ar.operation.isZero then return false
    return (zast.unitIsGeneric :ast unitId: ar.operation)
}

# notePendingTyperef -- node `nid` writes the type name `nameId`: a pending
# type-ref, which the next stampPendingTyperefs pass stamps. A node recorded
# before keeps its place and is not stamped a second time.
notePendingTyperef: function {st: zenv.ZSymbolTable nid: zast.nodeid nameId: zast.nameid} is {
    before: st.walk.pendingTyperef.length
    st.walk.pendingTyperef.set key: nid value: nameId
    if st.walk.pendingTyperef.length > before then st.walk.typerefNew.append from: nid
}

# stampNestedTyperef -- a qualified type reference into a NESTED unit
# (`out sub.T`) names a member exactly as a cross-unit reference does, but it
# cannot be recorded as a pending typeref: that carries a (unit NAME, member
# name) pair, and a nested unit has no name-index entry to be found by. So it
# resolves here and stamps the node itself, as it does a member reached through
# a unit instance: a binding of one (`ic.Cell`) or one applied in place
# (`(cells t: i64).Cell`). Recorded by nothing, such a reference reached no
# resolver at all: a parameter typed by it was typed as nothing and a return
# as null.
stampNestedTyperef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    unitId: zast.nameid
    memberId: zast.nameid
    nid: zast.nodeid
} is {
    if memberId.isZero then return
    mt: ztypes.tid
    if unitId.notZero when unitDecl.notZero then {
        mt = (
            resolve.nestedUnitMemberTid
            :st
            :ast
            ownerDeclId: unitDecl
            nestedNameId: unitId
            defName: memberId
        )
    }
    # a qualifier with no name is an application (`(cells t: i64).Cell`), which
    # can only be a unit instance written in place
    if mt.isZero when (
        unitId.isZero or (qualifierMayBeInstance :st :ast :scope nameId: unitId)
    ) then {
        mt = unitInstanceMemberTid :st :scope :ast :unitDecl :nid :memberId
    }
    if mt.isZero then return
    ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: mt
}

# unitInstanceMemberTid -- the type `memberId` a dotted type-ref names through a
# unit instance (`ic.Cell`): that instance's own copy, built on demand; 0 when
# the qualifier names no instance or the instance has no such type.
unitInstanceMemberTid: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
    memberId: zast.nameid
} out ztypes.tid is {
    parentId: zast.nodeid
    node: ast.nodes.get i: nid
    if node.dottedpath then parentId = node.parent
    if parentId.isZero then return ztypes.tid
    ui: unitInstanceOfTyperef :st :scope :ast :unitDecl nid: parentId thisName: ""
    if ui.isZero then return ztypes.tid
    ensureUnitMonoBuilt :st :scope :ast monoId: ui
    # a numeric generic parameter is the instance's singleton type
    sg: st.typing.singletonOf instance: ui param: memberId
    if sg.notZero then return sg
    mo: (st.typing.declChildOfId parentTypeId: ui nameId: memberId).or d: ztypes.tid.zero
    return mo
}

# ownsTypeParams -- `tid` is a generic type declaring type parameters of its own:
# naming it takes arguments. A type a generic unit declares is generic through
# its unit, whose parameters it carries, and is named bare.
ownsTypeParams: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    if (st.reg.isGenericOf :tid).not then return false
    tdecl: templateDeclOf reg: st.reg typing: st.typing :tid
    own: st.reg.genericParamCountOf :tdecl
    if own == 0 then return false
    ud: st.typing.declParentOf declId: tdecl
    if ud.isZero then return true
    return own > (st.reg.genericParamCountOf tdecl: ud)
}

# selfApplicationTid -- `type` inside a generic type's own declaration: the type
# applied to its own parameters, as `(GB t: t)` spells it, each parameter the
# GENERIC_PARAM the explicit spelling resolves it to there. A signature's partial
# is completed per instance and a body's walk per instance, so `type` is the
# instance being checked wherever it stands. 0 when the type owns no parameters.
selfApplicationTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    templateId: ztypes.tid
    # the `type` written, where the application is recorded
    nid: zast.nodeid
} out ztypes.tid is {
    if (ownsTypeParams :st tid: templateId).not then return ztypes.tid.zero
    tdecl: st.typing.declIdOfType typeId: templateId
    sfx: String
    typeSubs: IdMapV zast.nameid v: ztypes.tid
    valSubsR: IdMapV zast.nameid v: u64
    firstA: ztypes.tid
    for each pn: (st.reg.genericParamNamesOf :tdecl) loop {
        declare.recordGenericParamRef :st :nid scope: tdecl name: pn
        pt: declare.genericParamTidMint :st :ast :tdecl nameId: pn
        sfx.append s: "_"
        if (st.reg.genericParamConstraintOf :tdecl paramName: pn).numKind.has then {
            sfx.append s: (zast.nameTextAt :ast ref: pn)
        } else {
            sfx.append s: (typeargs.monoValName :st :ast tid: pt)
            if firstA.isZero then firstA = pt
        }
        typeSubs.set key: pn value: pt
    }
    mono: (
        getOrMintSpec
        :st
        :scope
        :ast
        unitDecl: st.typing.mainUnitRoot
        sfx: sfx.stringView
        :templateId
        subs: typeSubs
        valSubs: valSubsR
        fallbackArg: firstA
    )
    if mono.isZero then return ztypes.tid.zero
    at: nid
    recordMonoRef :st :ast :mono :nid :at :unitDecl
    return mono
}

# defaultsInstance -- the instance of the generic type `tid` that its
# parameters' defaults name, when every parameter has one; 0 otherwise (a
# default refused is reported at the default).
defaultsInstance: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    tid: ztypes.tid
    scope: ztypes.declid
} out ztypes.tid is {
    if (ownsTypeParams :st :tid).not then return ztypes.tid
    tdecl: st.typing.declIdOfType typeId: tid
    if (templateHasDefaults :st :tdecl).not then return ztypes.tid
    subs: IdMapV zast.nameid v: ztypes.tid
    valSubs: IdMapV zast.nameid v: u64
    sfx: String
    if (fillGenericDefaults :st :ast :tdecl :subs :valSubs :sfx).not then return ztypes.tid
    if (subs.length + valSubs.length) != (st.reg.genericParamCountOf :tdecl) then return ztypes.tid
    return (
        getOrMintSpec
        :st
        :scope
        :ast
        :unitDecl
        sfx: sfx.stringView
        templateId: tid
        :subs
        :valSubs
        fallbackArg: ztypes.tid.zero
    )
}

# bareGenericType -- a type position names a generic type without its
# arguments (ownsTypeParams): it names the instance its parameters' defaults
# make, the same instance the application written with them names. A
# parameter with no default leaves nothing to name, and is refused at `nid`.
# Answers `tid` itself when it is not generic or was refused.
bareGenericType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    tid: ztypes.tid
    nid: zast.nodeid
    # the scope the position is in, whose enclosing type is asked when
    # `thisName` is empty
    scope: ztypes.declid
    # the type whose declaration the position is in, when the caller knows it
    thisName: StringView
} out ztypes.tid is {
    if (ownsTypeParams :st :tid).not then return tid
    tdecl: st.typing.declIdOfType typeId: tid
    mono: defaultsInstance :st :ast :unitDecl :tid :scope
    if mono.notZero then {
        recordMonoRef :st :ast :mono :nid at: nid :unitDecl
        return mono
    }
    tn: st.reg.nameOf :tid
    own: tn.stringView == thisName
    if thisName.length == 0 then own = (callchecks.enclosingTypeDecl :st :scope) == tdecl
    hint: "apply type arguments first, e.g. '(ListVal t: u8)', or give each parameter a default".string
    if own then hint = "inside its own declaration, `type` is the instance being checked".string
    n: ast.nodes.get i: nid
    (
        addErrorWithHint
        :st
        nodeid: nid
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.genericError
        msg: "'\{tn}' is a generic type: a type position names it with its type arguments"
        note: String
        :hint
        width: tn.length
    )
    return tid
}


# namedTypeArg -- a type argument written as a name, once the name resolved to
# `aid`: `type` in a generic type's own members is the instance being checked
# (selfApplicationTid); any other name of a generic type takes its arguments
# or its defaults (bareGenericType), and `this` is the type being declared.
namedTypeArg: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    thisName: StringView
    aid: ztypes.tid
    argNid: zast.nodeid
} out ztypes.tid is {
    nameId: atomNameId :ast n: (ast.nodes.get i: argNid)
    if nameId == zast.wellKnown.slot.wkThis then return aid
    if nameId == zast.wellKnown.slot.wkType when thisName.length != 0 then {
        sa: selfApplicationTid :st :ast :unitDecl :scope templateId: aid nid: argNid
        if sa.notZero then return sa
        return aid
    }
    return (bareGenericType :st :ast :unitDecl tid: aid nid: argNid :scope :thisName)
}


# bareArgNamesNothing -- a type reference's argument that is a bare name no type
# and no constant in scope declares.
bareArgNamesNothing: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    arg: argref
} out bool is {
    # a bare name, or the pun `(fx :n)` whose value is the name it labels, as
    # numericParamRefTid reads it
    nameId: atomNameId :ast n: (ast.nodes.get i: arg.operation)
    if nameId.isZero or (isNumericLiteralNameAt :ast ref: nameId) then return false
    if (walkLookupTyperefById :st :scope :ast :unitDecl baseId: nameId).some then return false
    od: constOwnerDeclForId :st :scope :unitDecl :nameId
    return (st.typing.declFindChild parentDeclId: od :nameId).isZero
}

# refuseZerolessArray -- an array is filled with its element's zero value, and
# a static value has none (lacksZero): `array row to: 4` is refused, with a
# ListVal or an optionval as the remedy. True when it reported.
refuseZerolessArray: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    tplId: ztypes.tid
    elemTid: ztypes.tid
    at: zast.nodeid
} out bool is {
    if st.typing.staticTypesSeen.not then return false
    if tplId != (stdtypes.stdTidRo :ast :st wk: zast.wellKnown.slot.tyArray) then return false
    seen: ListVal ztypes.tid
    if (conform.lacksZero :st tid: elemTid :seen).not then return false
    tn: specWrittenName :st :ast tid: elemTid
    n: ast.nodes.get i: at
    (
        addErrorWithHint
        :st
        nodeid: at
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.typeError
        msg: "an array of '\{tn}' is refused: an array starts as zero values, and a static value has no zero"
        note: "".string
        hint: "hold the values in a 'ListVal', or make the element 'optionval \{tn}'"
        width: 1
    )
    return true
}

# staticValueNoun -- a value of static type `tid` as a message names it: "a
# data value", or "a choice value" for a static sum.
staticValueNoun: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out StringView is {
    if (st.reg.typetypeOf typeId: tid) == ztypes.ztypetype.variantType then return "a choice value"
    return "a data value"
}

# refuseStaticMarker -- a data value is copied by binding it and is never
# moved, borrowed or freed, so no marker applies to it: `.take`, `.borrow`,
# `.view`, `.hold` and `.copy` are refused. True when it reported.
refuseStaticMarker: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out bool is {
    if (st.reg.isStaticOf tid: bt).not then return false
    mk: zast.markerKindOfName id: cnId
    isMarker: (
        mk.takeMarker or
        mk.borrowMarker or
        mk.viewMarker or
        mk.holdMarker or
        (cnId == zast.wellKnown.slot.wkCopy)
    )
    if isMarker.not then return false
    mn: zast.nameTextCopy :ast ref: cnId
    noun: staticValueNoun :st tid: bt
    (
        addError
        :st
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
        e: zast.err.typeError
        msg: "'.\{mn}' does not apply to \{noun}: it is copied by binding it, and is never moved, borrowed or freed"
    )
    return true
}

# refuseStaticWrite -- a data value never changes, so a write to a field of
# one, at any depth of the target's path, is refused. Rebinding a name that
# holds a data value is no write to it. True when it reported.
refuseStaticWrite: function {st: zenv.ZSymbolTable ast: Ast target: zast.nodeid} out bool is {
    cur: target
    for true loop {
        parentId: zast.nodeid
        {
            n: ast.nodes.get i: cur
            if n.dottedpath then parentId = n.parent
        }
        if parentId.isZero then return false
        pt: walkTypeOf :st nid: parentId
        if (st.reg.isStaticOf tid: pt) then {
            tn: ast.nodes.get i: target
            (
                addError
                :st
                nodeid: target
                lineno: (nodeLine n: tn)
                colno: (nodeCol n: tn)
                e: zast.err.typeError
                msg: "\{staticValueNoun :st tid: pt} cannot change: this writes a part of one"
            )
            return true
        }
        cur = parentId
    }
    return false
}

# refuseSingletonWrite -- a slot typed by a numeric parameter's singleton type
# holds that type's one value: no write gives it another, nor the same one again.
# True when it reported.
refuseSingletonWrite: function {st: zenv.ZSymbolTable ast: Ast target: zast.nodeid} out bool is {
    tt: walkTypeOf :st nid: target
    if (st.typing.isSingletonType tid: tt).not then return false
    tn: ast.nodes.get i: target
    tw: specWrittenName :st :ast tid: tt
    (
        addError
        :st
        nodeid: target
        lineno: (nodeLine n: tn)
        colno: (nodeCol n: tn)
        e: zast.err.typeError
        msg: "this cannot be written: its type, '\{tw}', has only one value"
    )
    return true
}

# bindInheritedParams -- a template written in a generic unit takes that unit's
# parameters after its own (registerUnitParamsOn), and an application names only
# its own: the unit's are bound by what the application reaches the template
# through. Through an instance of the unit (`wi.pairs`, `(wrap t: i64).pairs`)
# they are that instance's arguments; by the template's bare name, written in
# the unit, they are the unit's parameters, which each instance's walk reads as
# its own arguments. One written in the application, or the template reached
# through the unit's template (`wrap.pairs`), is refused: a generic unit's
# contents are used through an instance. False once refused.
bindInheritedParams: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    tplId: ztypes.tid
    typeSubs: (IdMapV zast.nameid v: ztypes.tid)
    valSubs: (IdMapV zast.nameid v: u64)
    sfx: String
    # the application's callee
    at: zast.nodeid
    # a construction in a body, whose instance walk binds the unit's
    # parameters to that instance's arguments, as it binds its values' types;
    # a type reference is the template's answer, completed per instance
    walked: false
} out bool is {
    ud: st.typing.declParentOf declId: (st.typing.declIdOfType typeId: tplId)
    if ud.isZero or (declIsUnitTemplate :st :ast declId: ud).not then return true
    via: applicationQualifier :st :ast :unitDecl :scope :at
    if via.notZero when (st.reg.genericOriginOf tid: via).isZero then {
        if (st.reg.isGenericOf tid: via) then {
            refuseTemplateReachedThroughTemplate :st :ast :tplId unitTid: via :at
            return false
        }
        via = ztypes.tid.zero
    }
    inherited: st.reg.genericParamNamesOf tdecl: ud
    for each pw: inherited loop {
        if (typeSubs.has key: pw) or (valSubs.has key: pw) then {
            refuseInheritedParamWritten :st :ast :tplId :ud param: pw :at
            return false
        }
    }
    for each pn: inherited loop {
        bound: (
            typeargs.bindInheritedParam
            :st
            :ast
            :ud
            param: pn
            :via
            :walked
            :typeSubs
            :valSubs
            :sfx
        )
        if bound.not then return true
    }
    return true
}

# applicationQualifier -- the unit a type application's callee is reached
# through (`wi` in `wi.pairs`); 0 for a bare callee.
applicationQualifier: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    at: zast.nodeid
} out ztypes.tid is {
    par: zast.nodeid
    {
        cn: ast.nodes.get i: at
        match (
            cn
        ) case dottedpath then {
            par = cn.parent
        } else null
    }
    if par.isZero then return ztypes.tid.zero
    return (qualifierUnitTid :st :ast :unitDecl :scope nid: par)
}

# qualifierUnitTid -- the unit a type application's qualifier names: a name
# bound to one (`wi`), a unit an instance declares (`wi.inner`), or an
# instance written in place (`(wrap t: i64)`). 0 for anything else.
qualifierUnitTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
} out ztypes.tid is {
    q: ztypes.tid
    n: ast.nodes.get i: nid
    match (
        n
    ) case atomid then {
        nm: n.name
        n.drop
        # only a name that may stand for a unit is resolved: an infix call's
        # receiver (`B + 1`) is a value, and resolving a constant here would
        # evaluate it out of turn
        h: envLookup :st :scope nameId: nm
        if h.declId.notZero then {
            hk: (st.typing.decls.get i: h.declId).kind
            if hk.unitDecl.not and hk.typeDecl.not when (
                declBindsUnitInstance
                :st
                :ast
                declId: h.declId
            ).not then return ztypes.tid.zero
        }
        q = resolve.resolveAtomType :st :ast :unitDecl :scope nameId: nm thisName: ""
    } case dottedpath then {
        par: n.parent
        chn: atomNameId :ast n: (ast.nodes.get i: n.child)
        n.drop
        pq: qualifierUnitTid :st :ast :unitDecl :scope nid: par
        if pq.isZero then return ztypes.tid.zero
        q = (st.typing.declChildOfId parentTypeId: pq nameId: chn).or d: ztypes.tid.zero
    } case call then {
        ccal: n.callable
        n.drop
        # only a call that applies a unit template names an instance
        segs: ListVal zast.nameid
        instCallablePath :ast op: (ast.nodes.get i: ccal) :segs
        ctd: (
            instTemplateDecl
            :st
            scopeDeclId: (resolve.unitScopeOf typing: st.typing declId: scope)
            :segs
        )
        if ctd.isZero or (st.typing.decls.get i: ctd).kind.unitDecl.not then return ztypes.tid.zero
        q = (
            resolve.resolveMonoRefInline
            :st
            :ast
            :unitDecl
            :scope
            thisName: ""
            enclDecl: ztypes.declid
            opNid: nid
            :nid
        )
    } else return ztypes.tid.zero
    if (st.reg.typetypeOf typeId: q) != ztypes.ztypetype.unitType then return ztypes.tid.zero
    return q
}

# declBindsUnitInstance -- a definition whose value instantiates a unit template
# (`wi: (wrap t: i64)`), told by its shape as the instantiation collector tells
# it, without resolving anything.
declBindsUnitInstance: function {
    st: zenv.ZSymbolTable.view ast: Ast.view declId: ztypes.declid
} out bool is {
    callable: zast.nodeid
    {
        dn: ast.nodes.get i: (st.typing.decls.get i: declId).node
        if dn.namedoperation.not then return false
        op: ast.nodes.get i: dn.operation
        match (
            op
        ) case call then {
            callable = op.callable
        } else return false
    }
    segs: ListVal zast.nameid
    instCallablePath :ast op: (ast.nodes.get i: callable) :segs
    td: instTemplateDecl :st scopeDeclId: (st.typing.declParentOf :declId) :segs
    if td.isZero then return false
    return (st.typing.decls.get i: td).kind.unitDecl
}

# refuseInheritedLabel -- a construction of a template written in a generic unit
# labels one of the unit's parameters (refuseInheritedParamWritten). True once
# reported.
refuseInheritedLabel: function {
    st: zenv.ZSymbolTable ast: Ast.view tplId: ztypes.tid call: callref
} out bool is {
    ud: st.typing.declParentOf declId: (st.typing.declIdOfType typeId: tplId)
    if ud.isZero or (declIsUnitTemplate :st :ast declId: ud).not then return false
    ai: u64
    for ai < call.nargs loop {
        arg: argRefAt :ast nid: (zast.callArgAt :ast nid: call.nid i: ai)
        ai = ai + 1
        if arg.nid.notZero when arg.name.notZero when (
            st.reg.isGenericParamOf
            tdecl: ud
            name: arg.name
        ) then {
            refuseInheritedParamWritten :st :ast :tplId :ud param: arg.name at: call.callable
            return true
        }
    }
    return false
}

# refuseInheritedParamWritten -- an application of a template written in a
# generic unit names one of the unit's parameters, which the template takes
# from the instance it is reached through.
refuseInheritedParamWritten: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    tplId: ztypes.tid
    ud: ztypes.declid
    param: zast.nameid
    at: zast.nodeid
} is {
    tn: specWrittenName :st :ast tid: tplId
    un: zast.nameTextAt :ast ref: (st.typing.declNameOf declId: ud)
    pt: zast.nameTextAt :ast ref: param
    n: ast.nodes.get i: at
    (
        addErrorWithHint
        :st
        nodeid: at
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.genericError
        msg: "'\{pt}' is a parameter of '\{un}', which '\{tn}' takes from the instance of '\{un}' it is reached through"
        note: "an application names the template's own parameters".string
        hint: "leave '\{pt}' out"
        width: 0
    )
}

# refuseTemplateReachedThroughTemplate -- a template written in a generic unit,
# reached through the unit's own template (`wrap.pairs`) rather than an
# instance of it: nothing binds the unit's parameters.
refuseTemplateReachedThroughTemplate: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    tplId: ztypes.tid
    unitTid: ztypes.tid
    at: zast.nodeid
} is {
    tn: specWrittenName :st :ast tid: tplId
    un: st.reg.nameOf tid: unitTid
    n: ast.nodes.get i: at
    (
        addErrorWithHint
        :st
        nodeid: at
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.genericError
        msg: "'\{tn}' is reached through the generic unit '\{un}' itself: a generic unit's contents are used through an instance of it"
        note: "".string
        hint: "instantiate it first -- 'w: (\{un} ...)' -- and write 'w.\{tn}'"
        width: 0
    )
}

# fillApplicationDefaults -- a type application's parameters it leaves out,
# from their defaults. An unlabelled leading argument binds the first
# parameter, so it is recorded as that parameter's before any default is
# taken. Nothing to do for a template none of whose parameters has a default.
# False once a default was refused.
fillApplicationDefaults: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tplId: ztypes.tid
    typeSubs: (IdMapV zast.nameid v: ztypes.tid)
    valSubs: (IdMapV zast.nameid v: u64)
    sfx: String
    firstA: ztypes.tid
} out bool is {
    tdecl: st.typing.declIdOfType typeId: tplId
    if (templateHasDefaults :st :tdecl).not then return true
    if firstA.notZero when (st.reg.genericParamCountOf :tdecl) > 0 then {
        p0: st.reg.genericParamNameAt :tdecl i: 0
        if (typeSubs.has key: p0).not when (valSubs.has key: p0).not then (
            typeSubs.set
            key: p0
            value: firstA
        )
    }
    return (fillGenericDefaults :st :ast :tdecl subs: typeSubs :valSubs :sfx)
}

# templateHasDefaults -- one of the template's parameters declares a default.
templateHasDefaults: function {st: zenv.ZSymbolTable.view tdecl: ztypes.declid} out bool is {
    pi: u64
    for pi < (st.reg.genericParamCountOf :tdecl) loop {
        pn: st.reg.genericParamNameAt :tdecl i: pi
        pi = pi + 1
        if (st.reg.genericParamConstraintOf :tdecl paramName: pn
        ).defaultNode.notZero then return true
    }
    return false
}


# qualifiedMemberScope -- the scope a qualified type-ref's member `unit.member`
# is looked up from: the unit's root, or its `public:` block when the block
# DEFINES the member (`Cell: impl.Cell`). Such a member is on the unit's surface
# as much as one the unit defines, but no walk from the unit's scope finds it --
# a bare name in the unit never reaches into the block. Looked up from the
# unit, a parameter's type-ref stayed unstamped and nothing said so: the body
# walked with the parameter typed as nothing, and a method call on it reached
# the C as a field read.
qualifiedMemberScope: function {
    st: zenv.ZSymbolTable.view
    unitRoot: ztypes.declid
    memberId: zast.nameid
} out ztypes.declid is {
    own: st.typing.declFindChild parentDeclId: unitRoot nameId: memberId
    if own.notZero then return unitRoot
    pb: st.typing.declPublicNsOf owner: unitRoot
    if pb.isZero then return unitRoot
    if (st.typing.declFindChild parentDeclId: pb nameId: memberId).isZero then return unitRoot
    return pb
}


# fieldSlotTid -- a field's declared type: the partial specialisation when the
# typeref's argument names a generic parameter of the owning template, and the
# ordinary named shell otherwise. Both field paths ask this rather than carrying
# the choice themselves.
fieldSlotTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    ownerTid: ztypes.tid
    oId: zast.nodeid
    thisName: StringView
} out ztypes.tid is {
    pt9: typeargs.partialFieldTid :st :ast :unitDecl :scope :ownerTid :oId
    if pt9.notZero then return pt9
    # THE OWNER IS ON THE CONTAINMENT PATH for the width of this typeref, and
    # only for it. A layout cycle is a field edge that reaches a type already
    # on that path, which is a different question from reaching one merely
    # part-resolved: the resolution walk gets into a type through method
    # signatures and return types too, and neither forces a layout.
    od7: st.typing.declIdOfType typeId: ownerTid
    prevOn: false
    if od7.notZero then {
        prevOn = st.typing.declIsOnContainmentPath declId: od7
        st.typing.declSetContaining declId: od7 mark: true
    }
    # a data field is a static position: its value is folded, never
    # emitted as written, so it may keep a literal untyped. A sum's arm may
    # name a literal type too: the sum is then a compile-time sum, which bounds
    # a parameter and is never made (refuseCompileTimeSumValue)
    if (st.reg.isStaticOf tid: ownerTid) or (isSumTid :st tid: ownerTid) then (
        st.walk.staticLiteralTyperefs.add
        item: oId
    )
    r7: typeref.resolveFieldTyperef :st :ast :unitDecl :scope nid: oId :thisName
    if od7.notZero then st.typing.declSetContaining declId: od7 mark: prevOn
    return r7
}

# instanceTyperefMember -- the member `cId` a dotted type-ref names through a unit
# instance, 0 when the qualifier `pId` names none. A signature can name one
# before the instance's completion pass has typed the binding or built the
# instance, so the qualifier is resolved and the instance built here: peeling
# to the parent handed the slot the unit's own type. The cheap refusals come
# first -- a file unit, an ownership marker, a numeric suffix.
instanceTyperefMember: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
    pId: zast.nameid
    cId: zast.nameid
} out ztypes.tid is {
    if (isStripMarkerId nameId: cId) then return ztypes.tid
    if (isScalarNameId id: cId) then return ztypes.tid
    # a qualifier that is itself a path (`lib.ic`) binds in another unit, and
    # one that is an application (`(cells t: i64)`) is one: only resolving it
    # says what it is
    if (compoundQualifier :ast :nid).not then {
        if (isUnitNameDecl :st :scope nameId: pId) then return ztypes.tid
        if (qualifierMayBeInstance :st :ast :scope nameId: pId).not then return ztypes.tid
    }
    return (unitInstanceMemberTid :st :scope :ast :unitDecl :nid memberId: cId)
}

# compoundQualifier -- the dotted type-ref `nid` is qualified by a path or by an
# application rather than by a name.
compoundQualifier: function {ast: Ast.view nid: zast.nodeid} out bool is {
    parentId: zast.nodeid
    node: ast.nodes.get i: nid
    if node.dottedpath then parentId = node.parent
    if parentId.isZero then return false
    pn: ast.nodes.get i: parentId
    return pn.dottedpath or pn.call
}

# qualifierMayBeInstance -- the name a dotted type-ref is qualified by may bind a
# unit instance: it does, or it is a definition whose value is a call -- the
# instantiation -- that nothing has typed yet.
qualifierMayBeInstance: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    scope: ztypes.declid
    nameId: zast.nameid
} out bool is {
    if (isUnitNameDecl :st :scope :nameId) then return false
    if (bindingIsUnitInstance :st :scope :nameId) then return true
    if (nameDenotesUnit :scope :st :nameId) then return false
    if (qualifierSettledNotInstance :st :scope :nameId) then return false
    return (qualifierValueIsCall :st :ast :scope :nameId)
}

# qualifierValueIsCall -- the declaration `nameId` names in scope is a definition
# whose value is a call: the one shape an instantiation takes.
qualifierValueIsCall: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    scope: ztypes.declid
    nameId: zast.nameid
} out bool is {
    h: envLookup :st :scope :nameId
    if h.declId.isZero then return false
    dn: zast.nodeid
    hd: st.typing.decls.get i: h.declId
    dn = hd.node
    if dn.isZero then return false
    isCall: false
    nn: ast.nodes.get i: dn
    if nn.namedoperation then {
        vn: ast.nodes.get i: nn.operation
        isCall = vn.call
    }
    return isCall
}

# qualifierSettledNotInstance -- the name a dotted type-ref is qualified by is
# known not to bind a unit instance without resolving it: it declares a type, a
# function, a list or a unit (a nested unit or subunit), or its declaration
# is typed as anything but a unit.
qualifierSettledNotInstance: function {
    st: zenv.ZSymbolTable.view scope: ztypes.declid nameId: zast.nameid
} out bool is {
    h: envLookup :st :scope :nameId
    if h.declId.isZero then return false
    isDef: false
    {
        hd: st.typing.decls.get i: h.declId
        isDef = (
            hd.kind.unitDecl or
            hd.kind.typeDecl or
            hd.kind.funcDecl or
            hd.kind.staticListDecl or
            hd.kind.publicNs
        )
    }
    if isDef then return true
    bt: st.typing.declTypeOf declId: h.declId
    if bt.isZero then return false
    return (st.reg.typetypeOf typeId: bt) != ztypes.ztypetype.unitType
}

# unitInstanceOfTyperef -- the unit instance a dotted type-ref's qualifier names
# (a binding of an instantiated unit, here or through its unit), 0 when it names
# anything else. Only a name or a path is asked: a binding is the one qualifier
# that can be an instance.
unitInstanceOfTyperef: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
    thisName: StringView
} out ztypes.tid is {
    isRef: false
    isApp: false
    pn: ast.nodes.get i: nid
    isRef = pn.atomid or pn.dottedpath
    isApp = pn.call
    pt: ztypes.tid
    if isApp then {
        pt = (
            resolve.resolveMonoRefInline
            :st
            :scope
            :ast
            :unitDecl
            :thisName
            enclDecl: ztypes.declid
            opNid: nid
            :nid
        )
    } else {
        if isRef.not then return ztypes.tid
        pt = typeref.resolveTyperefShell :st :scope :ast :unitDecl :nid :thisName
    }
    ptid: pt
    if (st.reg.typetypeOf typeId: ptid) != ztypes.ztypetype.unitType then return ztypes.tid
    if (st.reg.genericOriginOf tid: ptid).isZero then return ztypes.tid
    return ptid
}

# stampInstanceTyperef -- stamp a dotted type-ref whose qualifier binds a unit
# instance with that instance's member; false when it binds none, or the
# instance has no such type.
stampInstanceTyperef: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
    qualId: zast.nameid
    memberId: zast.nameid
} out bool is {
    if (isUnitNameDecl :st :scope nameId: qualId) then return false
    if (bindingIsUnitInstance :st :scope nameId: qualId).not then return false
    mt: unitInstanceMemberTid :st :scope :ast :unitDecl :nid :memberId
    if mt.isZero then return false
    ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: mt
    return true
}

# bindingIsUnitInstance -- `nameId` is a binding in scope whose declared type is
# an instantiated unit (a unit mono).
bindingIsUnitInstance: function {
    st: zenv.ZSymbolTable.view scope: ztypes.declid nameId: zast.nameid
} out bool is {
    h: envLookup :st :scope :nameId
    if h.declId.isZero then return false
    bt: st.typing.declTypeOf declId: h.declId
    if bt.isZero then return false
    if (st.reg.typetypeOf typeId: bt) != ztypes.ztypetype.unitType then return false
    return (st.reg.genericOriginOf tid: bt).notZero
}

# unitAppliedTypeRef -- a unit applied in a type-ref is that unit's instance,
# stamped on the ref's node; 0 when the template is not a unit or its instance
# does not settle here, which leaves the ref to the ordinary mint.
unitAppliedTypeRef: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    tplId: ztypes.tid
    typeSubs: (IdMapV zast.nameid v: ztypes.tid).view
    valSubsR: (IdMapV zast.nameid v: u64).view
    # the template's name and the argument suffix, the instance's label
    tn: String
    sfx: String
    nid: zast.nodeid
} out ztypes.tid is {
    if (st.reg.typetypeOf typeId: tplId) != ztypes.ztypetype.unitType then return ztypes.tid.zero
    ium: (
        ensureUnitInstanceMono
        :st
        :scope
        :ast
        :tplId
        tdecl: (st.typing.declIdOfType typeId: tplId)
        subs: typeSubs
        valSubs: valSubsR
        label: "\{tn}\{sfx}"
    )
    if ium.notZero when nid.notZero then {
        ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: ium
    }
    return ium
}

# paramArgOf -- the argument `subs` / `valSubs` give the parameter `pnm` of
# `tdecl`, of the kind its declaration takes: a numeric parameter its value --
# or, in a reference over the template's own numeric parameter, that generic
# parameter's type -- and any other parameter a type. None when neither gives it
# one.
paramArgOf: function {
    st: zenv.ZSymbolTable.view
    tdecl: ztypes.declid
    pnm: zast.nameid
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    valSubs: (IdMapV zast.nameid v: u64).view
} out optionval ztypes.genericarg is {
    if (st.reg.genericParamConstraintOf :tdecl paramName: pnm).numKind.has then {
        vv: valSubs.get key: pnm
        if vv.some then return (optionval.some (ztypes.genericarg.valueArg vv))
    }
    tv: subs.get key: pnm
    if tv.some then return (optionval.some (ztypes.genericarg.typeArg tv))
    return (optionval.none ztypes.genericarg)
}

# unitInstanceKeys -- an instance's arguments in the template's parameter order;
# false when one is missing or is a generic parameter (a template walk), or
# when the template has no parameters registered: no arguments would find the
# trie's root, the template itself.
unitInstanceKeys: function {
    st: zenv.ZSymbolTable.view
    tdecl: ztypes.declid
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    valSubs: (IdMapV zast.nameid v: u64).view
    args: ListVal ztypes.genericarg
} out bool is {
    pn: st.reg.genericParamNamesOf :tdecl
    if pn.length == 0 then return false
    for each pnm: pn loop {
        a: paramArgOf :st :tdecl :pnm :subs :valSubs
        if a.none then return false
        match (
            a
        ) case typeArg then {
            if a.isZero then return false
            if (st.reg.typetypeOf typeId: a) == ztypes.ztypetype.genericParam then return false
        } case valueArg then null
        args.append a
    }
    return true
}

# ensureUnitInstanceMono -- the instance of the unit template `tplId` for these
# arguments, built: found on the trie, where a unit-level binding with the same
# arguments put it, or minted and joined there as that binding's is. 0 when an
# argument is a generic parameter -- a template walk, whose instances are
# settled per instance.
ensureUnitInstanceMono: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    tplId: ztypes.tid
    tdecl: ztypes.declid
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    valSubs: (IdMapV zast.nameid v: u64).view
    label: String
    # the instance that owns this one as a member -- a generic unit's instance,
    # for the unit it declares -- set before the build reads it; 0 for none
    owner: ztypes.tid.zero
} out ztypes.tid is {
    if tdecl.isZero then return ztypes.tid
    args: ListVal ztypes.genericarg
    if (unitInstanceKeys :st :tdecl :subs :valSubs :args).not then return ztypes.tid
    mono: ztypes.tid
    got: bodies.unitMonoOnTrie :st tplTid: tplId :args
    match (
        got
    ) case some then {
        mono = got
    } case none then {
        opId: zast.nodeid
        tnode: (st.typing.decls.get i: tdecl).node
        nn: ast.nodes.get i: tnode
        if nn.namedoperation then opId = nn.operation
        if opId.isZero then return ztypes.tid
        mono = (
            createUnitMono
            :st
            :ast
            monoName: label.stringView
            tmplDeclId: tdecl
            tplTid: tplId
            templateOpId: opId
        )
        own: owner
        if own.isZero then own = enclosingInstanceOf :st :scope :ast :tdecl :subs :valSubs
        if own.notZero then st.reg.setOwnerTid typeId: mono owner: own
        # a copy: the join grows the registry the name would be a view into
        tplNm: st.reg.nameOf tid: tplId
        bodies.unitMonoJoinTrie :st tplTid: tplId tplName: tplNm.stringView :args monoId: mono
        for each a: args loop st.reg.appendGenericArg specId: mono arg: a
        recordNumericArgConsts :ast :st :scope monoId: mono :tdecl
        shareUnitSingletons :st :tdecl encl: own monoId: mono
        mintNumericSingletons :ast :st :scope monoId: mono :tdecl
    }
    ensureUnitMonoBuilt :st :scope :ast monoId: mono
    return mono
}

# enclosingInstanceOf -- the instance an instance of the template `tdecl` belongs
# to when the template is written in a generic unit: that unit's instance at the
# arguments the template took for the unit's parameters (bindInheritedParams),
# which `subs` and `valSubs` hold beside its own. 0 for a template written
# anywhere else.
enclosingInstanceOf: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    tdecl: ztypes.declid
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    valSubs: (IdMapV zast.nameid v: u64).view
} out ztypes.tid is {
    ud: st.typing.declParentOf declId: tdecl
    if ud.isZero or (declIsUnitTemplate :st :ast declId: ud).not then return ztypes.tid.zero
    utpl: st.typing.declTypeOf declId: ud
    if utpl.isZero then return ztypes.tid.zero
    lbl: st.reg.nameOf tid: utpl
    for each pn: (st.reg.genericParamNamesOf tdecl: ud) loop {
        vo: valSubs.get key: pn
        match (
            vo
        ) case some then {
            (
                typeargs.appendNumericArgSuffix
                sfx: lbl
                bits: vo
                cd: (st.reg.genericParamConstraintOf tdecl: ud paramName: pn)
            )
        } case none then {
            lbl.append s: "_"
            (
                lbl.append
                s: (typeargs.monoValName :st :ast tid: ((subs.get key: pn).or d: ztypes.tid.zero))
            )
        }
    }
    return (ensureUnitInstanceMono :st :scope :ast tplId: utpl tdecl: ud :subs :valSubs label: lbl)
}

# ensureUnitMonoBuilt -- a unit instance's members, built now when its completion
# pass has not reached it yet. What the build takes is read off the mono and its
# template: the template's declaration and unit, the arguments by parameter.
ensureUnitMonoBuilt: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    monoId: ztypes.tid
} is {
    if (st.walk.collectionChildrenBuilt.has item: monoId) then return
    tplId: st.reg.genericOriginOf tid: monoId
    if tplId.isZero then return
    tdecl: st.typing.declIdOfType typeId: tplId
    if tdecl.isZero then return
    tnode: zast.nodeid
    tname: zast.nameid
    d: st.typing.decls.get i: tdecl
    tnode = d.node
    tname = d.name
    d.drop
    if tnode.isZero then return
    opId: zast.nodeid
    nn: ast.nodes.get i: tnode
    if nn.namedoperation then opId = nn.operation
    if opId.isZero then return
    subs: IdMapV zast.nameid v: ztypes.tid
    pn: st.reg.genericParamNamesOf :tdecl
    pj: u64
    for pj < pn.length loop {
        av: st.reg.genericTypeArgAt specId: monoId ordinal: pj
        if av.notZero then subs.set key: (pn.get i: pj) value: av
        pj = pj + 1
    }
    (
        buildUnitMono
        :st
        :scope
        :ast
        tmplUnitName: (unitRootOfDecl typing: st.typing declId: tdecl)
        tmplNameId: tname
        :monoId
        :tplId
        :subs
        templateOpId: opId
    )
}

# numericParamTypeOwner -- the declaration whose numeric generic parameter a
# type-ref atom names: a definition at or enclosing `scope` (a generic unit),
# the function whose signature is being resolved or one enclosing it (its own
# parameters, its type's), or the enclosing type (a field's type-ref resolves
# in the scope the type is written in). Such a type-ref is refused where it is
# written (refuseSingletonDeclType, refuseSingletonTypeArg) and takes the
# bound's type (numericParamBoundOf), so its uses say nothing more; a type's
# numeric argument (`to: cap`) reads the same way. 0 for any other name.
numericParamTypeOwner: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nameId: zast.nameid
    thisName: StringView
} out ztypes.declid is {
    owner: numericParamOwnerFrom :st :scope :nameId
    sgd: st.walk.sigGenericDecl
    if owner.isZero when sgd.notZero then owner = numericParamOwnerFrom :st scope: sgd :nameId
    if owner.isZero when thisName.length != 0 then {
        encl: declOfUnitDef :st :unitDecl :scope nameId: (nameIdOf :ast name: thisName)
        if encl.notZero then owner = numericParamOwnerFrom :st scope: encl :nameId
    }
    return owner
}

# refuseSingletonDeclType -- a declaration of `ownerDecl` typed by a numeric
# generic parameter of it or of a definition enclosing it, in a place only a
# field's or a local's type may name one: a function's parameter (`n: cap`,
# `x: k`) or a marked type (`n: cap.hold`, `stored: cap.hold`). A field's bare
# `stored: cap` is a slot of the singleton type (singletonFieldType).
refuseSingletonDeclType: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    ownerDecl: ztypes.declid
    isFunction: bool
    typeNid: zast.nodeid
} is {
    if typeNid.isZero then return
    n: ast.nodes.get i: typeNid
    an: zast.atomNameIdOf :n
    baseNid: typeNid
    if an.notZero when isFunction.not then return
    if an.isZero then {
        baseNid = markedTyperefBase :ast nid: typeNid
        if baseNid.isZero then return
        an = zast.atomNameIdOf n: (ast.nodes.get i: baseNid)
    }
    if an.isZero then return
    owner: numericParamOwnerFrom :st scope: ownerDecl nameId: an
    if owner.notZero then typeargs.refuseSingletonTypeRef :st :ast :owner nameId: an nid: baseNid
}

# refuseLiteralTyperef -- a literal type names what a lexeme wears until context
# pins it; it is COMPILE-TIME ONLY and has no C representation, so written as a
# declared type it produced C that does not compile (`z_t1_t` is never defined).
# A unit-level ALIAS may still name one -- that binds the type, it does not
# declare a value of it, and an alias never resolves through this path.
refuseLiteralTyperef: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    nid: zast.nodeid
    tid: ztypes.tid
} is {
    if (isAnyLiteralTid :st :tid).not then return
    # a list's `out` and a data field name an untyped value this way
    if (st.walk.staticLiteralTyperefs.has item: nid) then return
    ltn: st.reg.nameOf :tid
    # only where the NAME was written. A literal type's own conversions take an
    # elided `:this`, whose type legitimately IS the literal type -- there is no
    # written name there to refuse, and refusing it breaks system.z itself.
    wn9: typeargs.paramTypeBaseNameId :ast op: (ast.nodes.get i: nid)
    if wn9.isZero then return
    wroteLiteral: false
    wt9: zast.nameTextAt :ast ref: wn9
    wroteLiteral = wt9.stringView == ltn
    if wroteLiteral.not then return
    dflt: literalDefaultName :st :tid
    lm9: "'\{ltn}' is a compile-time type and cannot be written as a declared type"
    ln9: "a literal wears it until context pins one; it never reaches emission".string
    lh9: "name the type the value should have, such as `\{dflt}`"
    pos: zast.posOf n: (ast.nodes.get i: nid)
    (
        addErrorWithHint
        :st
        nodeid: nid
        lineno: pos.line
        colno: pos.col
        e: zast.err.typeError
        msg: lm9
        note: ln9
        hint: lh9
        width: ltn.length
    )
}

# paramIsThisReceiver -- the parameter's type names the receiver: bare `this`
# or a marker-suffixed `this.view` / `this.borrow`.
paramIsThisReceiver: function {ast: Ast.view op: astnode.view} out bool is {
    match (
        op
    ) case atomid then {
        return op.name == zast.wellKnown.slot.wkThis
    } case dottedpath then {
        return (atomNameId :ast n: (ast.nodes.get i: op.parent)) == zast.wellKnown.slot.wkThis
    } else {
        return false
    }
}

# paramIsThisReceiverId -- paramIsThisReceiver over a node id, for callers
# that hold no outstanding view into ast.nodes.
paramIsThisReceiverId: function {ast: Ast.view opId: zast.nodeid} out bool is {
    return (paramIsThisReceiver :ast op: (ast.nodes.get i: opId))
}

# recordParamArmDefault -- record a parameter's arm default, for the DOTTED
# spelling, whose path names the sum and the arm directly -- when it does
# (armDefaultLeaf). The refusal and the stamp are recordArmDefault's, shared
# with the bare spelling and with the field side, and docs/spec.pdoc states the
# rule once for all of them ("Defaulting to an arm that carries a non-null
# payload is rejected").
recordParamArmDefault: function {
    # where the refusal and the default are both recorded
    st: zenv.ZSymbolTable
    # the tree the parameter's name is read from
    ast: Ast.view
    # the parameter's declaration, for the position
    pm: argref
    # the parameter's own name
    pnameId: zast.nameid
    # the function the parameter belongs to
    fid: ztypes.tid
    # the sum whose arm the default names
    cid: ztypes.tid
    # the scope the declaration was written in
    rf: ztypes.declid
} is {
    armNid: armDefaultLeaf :st scope: rf :ast node: pm.operation ownerTid: fid slotTid: cid
    if armNid.isZero then return
    paramName: zast.nameTextCopy :ast ref: pnameId
    (
        recordArmDefault
        :st
        :ast
        what: "parameter"
        ownerTid: fid
        nameId: pnameId
        fname: paramName.stringView
        dm: pm
        armTid: cid
        armName: armNid
    )
}

# checkParamTypeShape -- record the default a parameter's declaration carries
# when it is not a bare name: a function reference (the declaration resolved to
# a function with a body, bare or unit-qualified), a suffixed numeric literal
# (`0.u64`), or a sum ARM (`bool.false`). A spec or a native function types the
# parameter and supplies no default: neither has a body to reference. It reports nothing -- an unknown name is the pending-typeref
# walk's business (stampOnePendingTyperef's E0023), reached through the
# recordTyperef its caller lays either way.
#
# The BARE spellings never reach here: a bare numeric is answered by
# registerValueParam's isNumericLiteralNameAt, and a bare name that a unit
# declares as a constant by the fold, which is the door the field side takes for
# the same declaration.
checkParamTypeShape: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rf: ztypes.declid
    cid: ztypes.tid
    pnameId: zast.nameid
    fid: ztypes.tid
    pm: argref
} is {
    # the TYPE the declaration resolved to, not its head name: `helper.seven`
    # heads with the unit, and a head lookup finds a spec as readily as a
    # function it could call
    if (st.reg.typetypeOf typeId: cid) == ztypes.ztypetype.functionType then {
        fnDecl: st.typing.declIdOfType typeId: cid
        if (declaresFunctionWithBody :st :ast declId: fnDecl) then {
            (
                st.typing.declSetDefaultId
                parentTypeId: fid
                nameId: pnameId
                value: ztyping.defaultval.func fnDecl
            )
        }
    } else {
        pdcnId: dottedChildNameId :ast n: (ast.nodes.get i: pm.operation)
        if pdcnId.notZero when (isStripMarkerId nameId: pdcnId).not then {
            prn: zast.nameTextAt :ast ref: (rootNameIdOf :ast n: (ast.nodes.get i: pm.operation))
            # a dotted numeric literal (0.u64) is a typed numeric
            # default, not a variant arm (mirrors the field
            # classifiers' rootNameOf guard)
            if (isNumericLiteralName name: prn.stringView) then {
                # a refused default keeps its place, so the member is not
                # reported as required as well
                refuseLiteralMember :st :ast nid: pm.operation
                (
                    st.typing.declSetDefaultId
                    parentTypeId: fid
                    nameId: pnameId
                    value: ztyping.defaultval.literal pm.operation
                )
            } else {
                recordParamArmDefault :st :ast :pm :pnameId :fid :cid :rf
            }
        }
    }
}

# declaresFunctionWithBody -- the declaration is a function with a body: not a
# spec, not a native, and not anything else.
declaresFunctionWithBody: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    if declId.isZero then return false
    dn: (st.typing.decls.get i: declId).node
    if dn.isZero then return false
    n: ast.nodes.get i: dn
    if n.namedoperation.not then return false
    return (bodies.isFunctionDefWithBody o: (ast.nodes.get i: n.operation))
}

# refuseMarkedFunctionType -- a declaration's type written as a function's NAME
# with a marker (`f: double.take`). A function with a body declares both the type
# and the default (`f: double`); a type with no default is declared by a SPEC, a
# function with no body (`Op: function {n: i64} out i64`, then `f: Op`). True
# when it reported.
refuseMarkedFunctionType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    # the declaration's type node
    typeNid: zast.nodeid
} out bool is {
    baseId: zast.nameid
    childId: zast.nameid
    {
        tn: ast.nodes.get i: typeNid
        match (
            tn
        ) case dottedpath then {
            baseId = atomNameId :ast n: (ast.nodes.get i: tn.parent)
            childId = atomNameId :ast n: (ast.nodes.get i: tn.child)
        } else null
    }
    if baseId.isZero or childId.isZero then return false
    k: zast.markerKindOfName id: childId
    if (k.takeMarker or k.borrowMarker or k.viewMarker or k.holdMarker).not then return false
    if (bodies.namesFunctionWithBody :st :ast :unitDecl :scope :baseId).not then return false
    bn: zast.nameTextCopy :ast ref: baseId
    cn: zast.nameTextAt :ast ref: childId
    # composed with append, not interpolation: a dotted path built inline reads
    # to A002 as a composed table key
    marked: bn.copy
    marked.append "."
    marked.append cn
    (
        addErrorWithHint
        :st
        nodeid: (zast.nodeIdOf n: (ast.nodes.get i: typeNid))
        lineno: (nodeLine n: (ast.nodes.get i: typeNid))
        colno: (nodeCol n: (ast.nodes.get i: typeNid))
        e: zast.err.typeError
        msg: "'\{marked}' marks a function in a declaration: a function-typed slot with no default is declared by a spec"
        note: "a function with a body declares the type and the default ('f: \{bn}'); a spec, a function with no body, declares the type alone"
        hint: "declare a spec with \{bn}'s signature and no body, and name it here"
        width: bn.length
    )
    return true
}

# foldParamValue -- the type a parameter's VALUE declares (foldedDeclType), asked
# only where it could answer: always without a partial specialisation, and with
# one only for a declaration that is a value. 0 for a type-ref. A conversion of
# an expression that did not fold is refused here, where nothing else would.
foldParamValue: function {
    st: zenv.ZSymbolTable
    ast: Ast
    fid: ztypes.tid
    pm: argref
    partialTid: ztypes.tid
} out ztypes.tid is {
    if partialTid.notZero when (valueDeclares :ast node: pm.operation).not then return ztypes.tid
    f: foldedDeclType :st :ast ownerTid: fid dm: pm
    if f.isZero then refuseUnfoldedConversion :st :ast what: "parameter" dm: pm
    return f
}

# registerValueParam -- record an ordinary (non-generic, non-receiver) parameter
# on its function's type: its declared type, its ownership, and the default it
# carries.
registerValueParam: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    rf: ztypes.declid
    fid: ztypes.tid
    thisName: StringView
    # the head name id of the declared type (the atom of `pm.operation`)
    ptn: zast.nameid
    # the partial specialisation the typeref resolves to when its argument names
    # a generic parameter, 0 for every other shape -- the shell path below has no
    # enclosing declaration and would mint a fresh record named after the head
    partialTid: ztypes.tid
    pm: argref
} is {
    if (declare.refuseStringDefault :st :ast what: "parameter" nameId: pm.name fm: pm) then return
    refuseMarkedFunctionType :st :ast :unitDecl scope: rf typeNid: pm.operation
    cid: partialTid
    # THE VALUE DECLARES THE TYPE, on a parameter exactly as on a field: one
    # declared by a value is a constant declaration, so it takes the same door
    # -- the fold -- and only one that names no constant falls through to the
    # type-ref path. Asked BEFORE the shell, which is what stops a bare `false`
    # or `-1` from minting a type named after its own text. `partialTid` is a
    # resolved specialisation and never a value, so the fold is asked only where
    # it could answer.
    # a partial specialisation answers only for a typeref; a value that folds
    # (`n: 2 * 3`) is no typeref, whatever shell the partial walk made of it
    folded: foldParamValue :st :ast :fid :pm partialTid: cid
    if folded.notZero then cid = folded
    if cid.isZero then cid = (
        typeref.resolveTyperefShell
        :st
        scope: rf
        :ast
        :unitDecl
        nid: pm.operation
        :thisName
    )
    refuseLiteralTyperef :st :ast nid: pm.operation tid: cid
    if folded.isZero then cid = typeargs.refuseSingletonPathType :st :ast nid: pm.operation tid: cid
    st.typing.setMemberType parentTypeId: fid nameId: pm.name childTypeId: cid
    if folded.notZero then {
        pnmA: zast.nameTextCopy :ast ref: pm.name
        (
            recordFoldedArmDefault
            :st
            :ast
            what: "parameter"
            ownerTid: fid
            fname: pnmA.stringView
            dm: pm
        )
        recordFoldedDefault :st :ast ownerTid: fid dm: pm
    }
    if (isNumericLiteralNameAt :ast ref: ptn) then {
        refuseWideDefault :st :ast nid: pm.operation
        (
            st.typing.declSetDefaultId
            parentTypeId: fid
            nameId: pm.name
            value: ztyping.defaultval.literal pm.operation
        )
    } else if folded.isZero then {
        # a value that folded declared its own default above; only a type-ref
        # carries a function, suffixed-literal or arm default
        checkParamTypeShape :st :ast :rf :cid pnameId: pm.name :fid :pm
    }
    if (paramIsThisReceiver :ast op: (ast.nodes.get i: pm.operation)) then {
        st.reg.setThisParamName typeId: fid nameId: pm.name
    }
    typeref.stampTypePathAlias :st :ast scope: rf nid: pm.operation
    typeref.recordTyperef :st scope: rf :ast :unitDecl :thisName nid: pm.operation
    # a `.private` parameter is a friend handle: the call must hand it one. A
    # `this.private` receiver is the type's own method, and grants itself
    pmOp: ast.nodes.get i: pm.operation
    if (typeExprHasPrivate :ast n: pmOp) when (typeExprRootIsThis :ast n: pmOp).not then {
        st.typing.setChildGrantsPrivateId parentTypeId: fid nameId: pm.name
    }
    pown: declare.pathOwnership :ast n: (ast.nodes.get i: pm.operation)
    match (
        pown
    ) case some then {
        st.typing.setChildOwnershipId parentTypeId: fid nameId: pm.name ownership: pown
    } case none then {
        if (stdtypes.paramIsBorrowReftype :ast :st tid: cid) then {
            (
                st.typing.setChildOwnershipId
                parentTypeId: fid
                nameId: pm.name
                ownership: ztypes.zparamownership.borrowMode
            )
        }
    }
}


# forceMemberOf -- the member `nameId` of `parentTypeId`, resolved if it is not
# yet. The by-NAME demand point: declChildOfId is a readonly view holding no
# registry and no ast, so it can never resolve anything itself -- every force
# sits in front of a lookup, never inside one. Under --eager too: the eager
# tier resolves every member, but in its own order, and a lookup may come
# first -- a literal type is reached by a literal, never by a name that would
# have resolved it, so `m: 2 * 3` as a parameter default reads intliteral's
# `*` before the tier reaches intliteral.
forceMemberOf: function {
    st: zenv.ZSymbolTable
    ast: Ast
    parentTypeId: ztypes.tid
    nameId: zast.nameid
} is {
    if nameId.isZero then return
    md: st.typing.declMemberIdOf :parentTypeId :nameId
    if md.isZero then return
    conform.forceMemberDecl :st :ast memberDeclId: md
    stdtypes.nativeMethodForInstance :st :ast inst: parentTypeId :nameId
}

# foldInstanceConstant -- a template's constant over one of its numeric
# generic parameters -- an `as` constant (instanceOnlyAsConstant) or a generic
# unit's definition -- folded for the instance `mono` when the instance first
# meets it: a read through the instance (foldReadInstanceConstant) or, for an
# `as` constant, the sweep at the end of the check (foldInstanceConstants).
# One that does not fold is asked why as any constant is (constFoldDecl). The
# template has no value for it and said nothing, so the reason is the
# instance's, and carries its note.
foldInstanceConstant: function {
    st: zenv.ZSymbolTable
    ast: Ast
    mono: ztypes.tid
    declId: ztypes.declid
} is {
    if declId.isZero then return
    nameId: zast.nameid
    dnode: zast.nodeid
    own: ztypes.declid
    isConst: false
    {
        d: st.typing.decls.get i: declId
        nameId = d.name
        dnode = d.node
        own = d.parent
        # a path reads as a re-export until its root is a value
        isConst = d.kind.constDecl or d.kind.reexportDecl
    }
    if dnode.isZero then return
    if isConst.not when (st.typing.isAsConstDecl :declId).not then return
    opId: zast.nodeid
    {
        dn: ast.nodes.get i: dnode
        if dn.namedoperation then opId = dn.operation
    }
    if (constReadsNumericParam :st :ast owner: own :opId).not then return
    k: st.typing.memberConstKey parentTypeId: mono :nameId
    if (st.walk.instanceConstsChecked.has item: k) then return
    st.walk.instanceConstsChecked.add item: k
    prev: st.walk.constMono
    st.walk.constMono = mono
    from: st.typing.errors.length
    constFoldDecl :ast :st :declId
    st.walk.constMono = prev
    bodies.noteInstanceErrors :st :ast :mono :from
    # the instance's member has the type of the instance's value: it has none
    # of its own, or the parameter's stand-in when the definition is the
    # parameter itself (`K: cap`), which a unit indexes as a re-export
    v: st.typing.memberConstOf parentTypeId: mono :nameId
    if v.kind.none then return
    had: (st.typing.declChildOfId parentTypeId: mono :nameId).or d: ztypes.tid.zero
    if had.notZero when (st.reg.isTypeParamOf tid: had).not then return
    vt: constValueTid :st scope: own :ast :v
    if vt.notZero then st.typing.setMemberType parentTypeId: mono :nameId childTypeId: vt
}

# forInstancesOnly -- the definition with value `defnId` of the template
# `owner`, met with no instance of it being folded for, reads one of the
# template's numeric generic parameters: only an instance has a value for it.
forInstancesOnly: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    owner: ztypes.declid
    defnId: zast.nodeid
} out bool is {
    if owner.isZero or ((st.reg.genericNumericParamCountOf tdecl: owner) == 0) then return false
    if (activeConstMono :st ownerDecl: owner).notZero then return false
    return (constReadsNumericParam :st :ast :owner opId: defnId)
}

# instanceOnlyConstantNamed -- member `cnId` of `bt` (a template, or an
# instance of one) is the template's constant over one of its numeric generic
# parameters (foldInstanceConstant). Read with no type, it is an instance's
# whose fold failed and said why, or the template's own, which only an
# instance has a value for.
instanceOnlyConstantNamed: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    bt: ztypes.tid
    cnId: zast.nameid
} out bool is {
    if bt.isZero or cnId.isZero then return false
    tpl: bt
    org: st.reg.genericOriginOf tid: bt
    if org.notZero then tpl = org
    tdecl: st.typing.declIdOfType typeId: tpl
    if tdecl.isZero or ((st.reg.genericNumericParamCountOf :tdecl) == 0) then return false
    md: st.typing.declFindChild parentDeclId: tdecl nameId: cnId
    if md.isZero then return false
    dnode: zast.nodeid
    isConst: false
    {
        d: st.typing.decls.get i: md
        dnode = d.node
        isConst = d.kind.constDecl or d.kind.reexportDecl
    }
    if dnode.isZero then return false
    if isConst.not when (st.typing.isAsConstDecl declId: md).not then return false
    opId: zast.nodeid
    {
        dn: ast.nodes.get i: dnode
        if dn.namedoperation then opId = dn.operation
    }
    return (constReadsNumericParam :st :ast owner: tdecl :opId)
}

# foldReadInstanceConstant -- a read of member `cnId` of `bt`: when it is a
# template's constant over a numeric parameter, read through an instance or in
# an instance's walk, the instance folds it first (foldInstanceConstant),
# since the member's type is the value's.
foldReadInstanceConstant: function {
    st: zenv.ZSymbolTable
    ast: Ast
    bt: ztypes.tid
    cnId: zast.nameid
} is {
    if bt.isZero or cnId.isZero then return
    org: st.reg.genericOriginOf tid: bt
    tpl: bt
    if org.notZero then tpl = org
    tdecl: st.typing.declIdOfType typeId: tpl
    if tdecl.isZero or ((st.reg.genericNumericParamCountOf :tdecl) == 0) then return
    mono: bt
    if org.isZero then mono = activeConstMono :st ownerDecl: tdecl
    if mono.isZero or (st.reg.isPartialOf tid: mono) then return
    (
        foldInstanceConstant
        :st
        :ast
        :mono
        declId: (st.typing.declFindChild parentDeclId: tdecl nameId: cnId)
    )
}

# foldInstanceConstants -- every type instance's `as` constants over its
# numeric parameters, read or not: a used type's constants are checked with it
# (attachAsConstant), and only an instance has values for these.
foldInstanceConstants: function {ast: Ast st: zenv.ZSymbolTable} is {
    last: st.reg.nextTid
    t: ztypes.tid 1
    for t < last loop {
        mono: t
        t = t.next
        org: st.reg.genericOriginOf tid: mono
        if org.isZero or (st.reg.isPartialOf tid: mono) then continue
        if (st.reg.typetypeOf typeId: org) == ztypes.ztypetype.unitType then continue
        tdecl: templateDeclOf reg: st.reg typing: st.typing tid: org
        if tdecl.isZero or ((st.reg.genericNumericParamCountOf :tdecl) == 0) then continue
        for each nm: (asItemNamesOf :st :ast :tdecl) loop {
            (
                foldInstanceConstant
                :st
                :ast
                :mono
                declId: (st.typing.declFindChild parentDeclId: tdecl nameId: nm)
            )
        }
    }
}

# asItemNamesOf -- the names the `as` block of the type `tdecl` declares, in
# the order written; none for a type with no `as` block.
asItemNamesOf: function {
    st: zenv.ZSymbolTable.view ast: Ast.view tdecl: ztypes.declid
} out ListVal zast.nameid is {
    names: ListVal zast.nameid
    dn: ast.nodes.get i: (st.typing.decls.get i: tdecl).node
    if dn.namedoperation.not then return names
    op: ast.nodes.get i: dn.operation
    if op.objectdef.not then return names
    for each amId: (zast.kidsOf :ast span: op.asItems) loop {
        am: ast.nodes.get i: amId
        if am.namedoperation then names.append am.name
    }
    return names
}

# reportUnknownAsHead -- an `as` item whose value is a call (`k: (f a: 1)`,
# or a type application `g: (Getter v: i64)`) or a path (`origin: io.nosuch`)
# whose head resolves nowhere: reported as the same name is in a body, rather
# than left a constant that never folds or an implementation naming nothing. True
# when it reported.
reportUnknownAsHead: function {
    st: zenv.ZSymbolTable
    ast: Ast
    parentId: ztypes.tid
    item: argref
} out bool is {
    headNid: zast.nodeid
    {
        vn: ast.nodes.get i: item.operation
        if vn.call then headNid = vn.callable
        if vn.dottedpath then headNid = item.operation
    }
    if headNid.isZero then return false
    # an operator's call (`cap * 2`) has a path for its head, and no name in it
    if (operatorPartsAt :ast nid: item.operation).found then return false
    # a head through a unit (`sch.row`) is checked at its root, then at its member
    rootNid: headNid
    {
        hn0: ast.nodes.get i: headNid
        match (
            hn0
        ) case dottedpath then {
            rootNid = hn0.parent
        } else null
    }
    headId: zast.atomNameIdOf n: (ast.nodes.get i: rootNid)
    if headId.isZero then return false
    td: st.typing.declIdOfType typeId: parentId
    if td.isZero then return false
    # the type's own generic parameter, which only an instance has a value for
    if ((st.reg.genericParamNamesOf tdecl: td).contains item: headId) then return false
    unknown: (
        unresolvedBareName
        :ast
        :st
        unitDecl: (unitRootOfDecl typing: st.typing declId: td)
        nameId: headId
    )
    if unknown.length == 0 then {
        if rootNid == headNid then return false
        return (reportMissingHeadMember :st scope: td :ast callable: headNid)
    }
    hn: ast.nodes.get i: rootNid
    (
        addErrorWithHint
        :st
        nodeid: rootNid
        lineno: (nodeLine n: hn)
        colno: (nodeCol n: hn)
        e: zast.err.badReference
        msg: "Unknown reference '\{unknown}'"
        note: "".string
        hint: "".string
        width: unknown.length
    )
    return true
}

# valueMayNameType -- a declaration's value spelled as a bare name or a path,
# or as a type application whose head names a type (`g: (Getter v: i64)`): the
# only forms a type or an implementation can take. The head is looked up where the
# type `parentId` is declared.
valueMayNameType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    parentId: ztypes.tid
    node: zast.nodeid
} out bool is {
    headId: zast.nameid
    pathHead: zast.nodeid
    n: ast.nodes.get i: node
    if n.dottedpath then return true
    if n.call.not then return (zast.atomNameIdOf :n).notZero
    if (ast.nodes.get i: n.callable).dottedpath then pathHead = n.callable
    headId = zast.atomNameIdOf n: (ast.nodes.get i: n.callable)
    td: st.typing.declIdOfType typeId: parentId
    if td.isZero then return false
    sc: st.typing.declParentOf declId: td
    # a head that is a path names a type when it reaches one through a unit
    # (`(pr.Getter v: i64)`); an infix call's path (`cap * 2`) reaches none
    if pathHead.notZero then {
        segs: ListVal zast.nameid
        instCallablePath :ast op: (ast.nodes.get i: pathHead) :segs
        pd: instTemplateDecl :st scopeDeclId: sc :segs
        if pd.isZero then return false
        return (st.typing.decls.get i: pd).kind.typeDecl
    }
    if headId.isZero then return false
    ud: unitRootOfDecl typing: st.typing declId: td
    return (walkLookupTyperefById :st scope: sc :ast unitDecl: ud baseId: headId).some
}

# methodImplementsSpec -- `mid` is a method its owner declares in order to
# implement a member of a spec it explicitly implements. Such a method's
# signature, markers included, is the spec's (checkImplementationSignature), so it
# is not the method's own to change.
methodImplementsSpec: function {st: zenv.ZSymbolTable.view mid: ztypes.tid} out bool is {
    owner: st.reg.ownerTidOf tid: mid
    if owner.isZero then return false
    ownerOg: st.reg.genericOriginOf tid: owner
    mnameId: memberNameIdOfTid :st :owner :mid
    if mnameId.isZero then return false
    found: false
    cfId: ztypes.confid
    for cfId.next < st.typing.nextConf loop {
        cfId = cfId.next
        crow: st.typing.implementation.get i: cfId
        isOwn: crow.implTypeId == owner
        if ownerOg.notZero when crow.implTypeId == ownerOg then isOwn = true
        if isOwn when (
            specDeclaresMethod
            :st
            specTid: crow.specTypeId
            nameId: mnameId
        ) then found = true
    }
    return found
}

# memberNameIdOfTid -- the name `owner` declares its member `mid` under, or 0.
memberNameIdOfTid: function {
    st: zenv.ZSymbolTable.view
    owner: ztypes.tid
    mid: ztypes.tid
} out zast.nameid is {
    r: zast.nameid
    slots: st.typing.declRowSlots ownerTid: owner
    si: u64
    for si < slots loop {
        row: st.typing.declRowAt ownerTid: owner membersOnly: true slot: si
        si = si + 1
        if row.keep when row.tid == mid then r = row.name
    }
    return r
}

# specDeclaresMethod -- the spec declares a method named `nameId`.
specDeclaresMethod: function {
    st: zenv.ZSymbolTable.view
    specTid: ztypes.tid
    nameId: zast.nameid
} out bool is {
    smo: st.typing.declChildOfId parentTypeId: specTid :nameId
    match (
        smo
    ) case some then {
        stt: st.reg.typetypeOf typeId: smo
        return stt == ztypes.ztypetype.functionType
    } case none then return false
}

# staticlistelem -- one list element dissected into the nodes carrying its
# lexeme and its per-element type tag (`cNul: 0.u8` gives the `0` node and the
# `u8` node). `tagId` is 0 for a bare element, which is what lets the block's
# type be unified from the tags that ARE written.
staticlistelem: record {
    # the element's literal constant
    litId: zast.nodeid
    # its tag, when the element is a sum arm
    tagId: zast.nodeid
    # whether the element resolved at all; the two above mean nothing when it
    # did not
    ok: bool
}

# staticListElemParts -- dissect a list element's value. A bare literal is its own
# lexeme with no tag; a tagged one (`0.u8`) is a dotted path over the literal,
# so the parent carries the lexeme and the child names the type.
staticListElemParts: function {ast: Ast.view opId: zast.nodeid} out staticlistelem is {
    zt: zast.nodeid
    miss: staticlistelem litId: zt tagId: zt ok: false
    if opId.isZero then return miss
    n: ast.nodes.get i: opId
    match (
        n
    ) case dottedpath then {
        pt: typeargs.atomName :ast n: (ast.nodes.get i: n.parent)
        if (isNumericLiteralName name: pt.stringView).not then return miss
        return (staticlistelem litId: n.parent tagId: n.child ok: true)
    } case atomid then {
        at: zast.nameTextAt :ast ref: n.name
        if (isNumericLiteralName name: at.stringView).not then return miss
        return (staticlistelem litId: opId tagId: zt ok: true)
    } else null
    return miss
}

# staticListElemValues -- each element's VALUE, by slot. A literal is read from its
# lexeme; anything else folds through the evaluator, so an element may be any
# compile-time constant -- an expression, a unit constant, string `+`, another
# block's element. An element with no value is refused where it is written and
# holds noConst, keeping its slot.
staticListElemValues: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    dnode: staticlistref
    # the list type an element that is itself a list takes, 0 for none
    elemWant: ztypes.tid
} out ListVal ztypes.cval is {
    vals: ListVal ztypes.cval
    kV: u64
    for kV < dnode.nelems loop {
        elId: zast.listElemAt :ast nid: dnode.nid i: kV
        kV = kV + 1
        opRef: zast.nodeid
        {
            el: ast.nodes.get i: elId
            if el.namedoperation then opRef = el.operation
        }
        # a nested list is a value of the list's element type
        if opRef.notZero when (ast.nodes.get i: opRef).listblock then {
            vals.append (staticListNestedValue :ast :st :unitDecl :scope :opRef want: elemWant)
            continue
        }
        vals.append (staticListElemValue :ast :st :unitDecl :scope :opRef)
    }
    return vals
}

# staticListNestedValue -- an element that is itself a list: a value of the
# list's element type `want`, its row; noConst after the refusal its own
# resolution made.
staticListNestedValue: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    opRef: zast.nodeid
    want: ztypes.tid
} out ztypes.cval is {
    w: want
    if (
        numerics.valIsMonoOf
        reg: st.reg
        typing: st.typing
        tid: w
        wk: zast.wellKnown.slot.tyStaticlist
    ).not then w = ztypes.tid.zero
    return (constOfList :st :scope :ast :unitDecl nid: opRef want: w)
}

# staticListElemValue -- one element's value (staticListElemValues), or noConst after the
# refusal: a number is the only value a numeric block holds.
staticListElemValue: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    opRef: zast.nodeid
} out ztypes.cval is {
    if opRef.isZero then return ztypes.noConst
    de: staticListElemParts :ast opId: opRef
    if de.ok then {
        lt: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: de.litId))
        return (consteval.constLiteralValue :st name: lt.stringView)
    }
    held: st.walk.constFail
    constFailClear :st
    errA: st.typing.errors.length
    cv: evalConstNode :st :scope :ast :unitDecl nid: opRef
    got: st.walk.constFail
    st.walk.constFail = held
    if cv.kind.ivalKind or cv.kind.fvalKind or cv.kind.svalKind then return cv
    if cv.kind.armKind or cv.kind.aggKind then return cv
    en: ast.nodes.get i: opRef
    if got.failed when cv.kind.none then {
        # a block read from its own elements fails where nothing is written
        if got.kind.cycle then {
            got.nodeid = opRef
            got.lineno = nodeLine n: en
            got.colno = nodeCol n: en
        }
        consteval.renderConstFail :st f: got
        return ztypes.noConst
    }
    # a generic unit's block, resolved for the template, has no value for an
    # element over a numeric parameter (`n * n`): each instance's copy evaluates
    # it, and refuses it there when it has none
    if cv.kind.none when st.walk.constMono.isZero when (scopeInUnitTemplate :st :ast :scope) then {
        return ztypes.noConst
    }
    # an element whose evaluation reported why it has no value -- the
    # definition it names failed -- has its one error already
    if st.typing.errors.length > errA then return ztypes.noConst
    # one that recorded no reason says why through the part of it that has
    # none, as a definition does; the walk must not drop the failure an
    # enclosing fold holds
    if cv.kind.none then {
        visiting: ListVal zast.nodeid
        said: unfoldedPartWhy :st :scope :ast :unitDecl nid: opRef :visiting
        st.walk.constFail = held
        if said then return ztypes.noConst
    }
    msg: "a list element must be a compile-time constant".string
    hint: "an element is a literal, a unit constant, or an expression over them".string
    (
        addErrorWithHint
        :st
        nodeid: opRef
        lineno: (nodeLine n: en)
        colno: (nodeCol n: en)
        e: zast.err.typeError
        :msg
        note: String
        :hint
        width: 1
    )
    return ztypes.noConst
}

# staticListKindsAgree -- a list holds one kind of element: all integers, all
# floats, all strings, or all values of one other type -- arms of one enum,
# data values of one type, lists of one type -- and a list of strings is a
# StringView one. An element of another kind or type than the first, or one
# its `out` cannot hold, is refused where it is written. An integer in a float
# list is refused too: a float list's elements are written as floats. False
# when one was refused.
staticListKindsAgree: function {
    ast: Ast
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    dnode: staticlistref
    vals: ListVal ztypes.cval
    elemTid: ztypes.tid
} out bool is {
    first: ztypes.zconstkind.none
    firstTid: ztypes.tid
    k: u64
    for k < dnode.nelems loop {
        cv: vals.get i: k
        elId: zast.listElemAt :ast nid: dnode.nid i: k
        k = k + 1
        kind: staticListValueKind :cv
        if kind.none then continue
        vt: ztypes.tid
        if (staticListKindHasType :kind) then vt = constValueTid :ast :st :scope v: cv
        if first.none then {
            first = kind
            firstTid = vt
        }
        msg: staticListElemMismatch :ast :st :kind :vt :first :firstTid :elemTid
        if msg.length > 0 then {
            el: ast.nodes.get i: elId
            (
                addErrorWithHint
                :st
                nodeid: (zast.nodeIdOf n: el)
                lineno: (nodeLine n: el)
                colno: (nodeCol n: el)
                e: zast.err.typeError
                :msg
                note: String
                hint: "a list holds elements of one type: name it once, as `out staticlist T`".string
                width: 1
            )
            return false
        }
    }
    return true
}

# staticListElemMismatch -- why an element of kind `kind` and type `vt` (for
# an arm or an aggregate) is no element of a list whose first element is of
# `first` / `firstTid` and whose element type is `elemTid`; "" when it is one.
staticListElemMismatch: function {
    ast: Ast
    st: zenv.ZSymbolTable
    kind: ztypes.zconstkind
    vt: ztypes.tid
    first: ztypes.zconstkind
    firstTid: ztypes.tid
    elemTid: ztypes.tid
} out String is {
    typed: staticListKindHasType :kind
    firstTyped: staticListKindHasType kind: first
    kt: staticListKindText :kind
    if typed then kt = specWrittenName :st :ast tid: vt
    # an arm and a value of one choice are elements of one type
    sameKind: (kind == first) or (typed and firstTyped)
    if sameKind.not or (vt != firstTid) then {
        ft: staticListKindText kind: first
        if firstTyped then ft = specWrittenName :st :ast tid: firstTid
        # numbers and strings differ in kind, anything else in type
        what: "type"
        if typed.not when firstTyped.not then what = "kind"
        return "list elements are of one \{what}: this one is \{kt}, the first \{ft}"
    }
    if typed then {
        if (vt == elemTid) or (staticListFits :ast :st have: vt want: elemTid) then return "".string
        return "\{kt} cannot be an element of a list of \{specWrittenName :st :ast tid: elemTid}"
    }
    if kind.svalKind == (isStaticStringTid :ast :st tid: elemTid) then return "".string
    return "\{kt} cannot be an element of a list of \{st.reg.nameOf tid: elemTid}"
}

# staticListValueKind -- a list element's kind: its constant's kind, and none
# for a function reference, which is no element value.
staticListValueKind: function {cv: ztypes.cval} out ztypes.zconstkind is {
    if cv.kind.fnKind then return ztypes.zconstkind.none
    return cv.kind
}

# staticListKindHasType -- an arm or an aggregate: an element that has a type
# of its own, where a number or a string has only a kind.
staticListKindHasType: function {kind: ztypes.zconstkind} out bool is {
    return kind.armKind or kind.aggKind
}

# staticListFirstValueTid -- the type of a list's first element with a value
# when that is an arm, a data value or a list: the type a list naming none has
# as its element type. 0 for a list of numbers or strings, or of no value.
staticListFirstValueTid: function {
    ast: Ast st: zenv.ZSymbolTable scope: ztypes.declid vals: (ListVal ztypes.cval).view
} out ztypes.tid is {
    for each cv: vals loop {
        if cv.isConst then {
            if (staticListKindHasType kind: (staticListValueKind :cv)
            ).not then return ztypes.tid.zero
            return (constValueTid :ast :st :scope v: cv)
        }
    }
    return ztypes.tid.zero
}

# staticListKindText -- a list element kind as a diagnostic names it.
staticListKindText: function {kind: ztypes.zconstkind} out String is {
    if kind.ivalKind then return "an integer".string
    if kind.fvalKind then return "a float".string
    return "a string".string
}

# staticListTagWritten -- some element of the block carries its own type tag
# (`cNul: 0.u8`).
staticListTagWritten: function {ast: Ast dnode: staticlistref} out bool is {
    k: u64
    for k < dnode.nelems loop {
        el: ast.nodes.get i: (zast.listElemAt :ast nid: dnode.nid i: k)
        k = k + 1
        if el.namedoperation then {
            de: staticListElemParts :ast opId: el.operation
            if de.tagId.notZero then return true
        }
    }
    return false
}

# staticListElemTypeName -- the ONE type name a list's elements carry: the
# `out T` clause when written, else the type the elements' own tags agree on,
# else i64 -- text when every element is a string, f64 when every one is a
# float. Tags that disagree are reported here, at the declaration, because a
# block that means two widths at once has no honest emission.
staticListElemTypeName: function {
    ast: Ast
    st: zenv.ZSymbolTable
    dnode: staticlistref
    outName: StringView
    # each element's value, by slot (staticListElemValues)
    vals: ListVal ztypes.cval
} out zast.nameid is {
    pick: zast.nameid
    if outName.length > 0 then pick = ast.internString text: outName
    allFloat: true
    allString: true
    kU: u64
    for kU < dnode.nelems loop {
        elId: zast.listElemAt :ast nid: dnode.nid i: kU
        cv: vals.get i: kU
        kU = kU + 1
        # an element with no value was refused already, and says nothing here
        if cv.kind.none then continue
        if cv.kind.svalKind.not then allString = false
        if cv.kind.fvalKind.not then allFloat = false
        opRef: zast.nodeid
        el: ast.nodes.get i: elId
        if el.namedoperation then opRef = el.operation
        de: staticListElemParts :ast opId: opRef
        if de.tagId.notZero then {
            tgId: atomNameId :ast n: (ast.nodes.get i: de.tagId)
            if pick.isZero then pick = tgId
            if (tgId == pick).not then {
                pn: zast.nameTextAt :ast ref: pick
                tn: zast.nameTextAt :ast ref: tgId
                dm: "list element types disagree: '\{pn.stringView}' and '\{tn.stringView}'"
                dh: "a list has one element type: write it once, as `out staticlist T`".string
                en: String
                (
                    addErrorWithHint
                    :st
                    nodeid: dnode.nid
                    lineno: dnode.lineno
                    colno: dnode.colno
                    e: zast.err.typeError
                    msg: dm
                    note: en
                    hint: dh
                    width: 4
                )
            }
        }
    }
    if pick.notZero then return pick
    if allString when dnode.nelems > 0 then return (ast.internString text: "text")
    if allFloat when dnode.nelems > 0 then return (ast.internString text: "f64")
    return (ast.internString text: "i64")
}

# staticlistoutparts -- what a list's `out` says when it names a list type: the element
# type and the index type, as the run-time instance has them, and whether each
# was left untyped -- written as a literal type or not written at all.
staticlistoutparts: record {
    # whether the `out` type is a list type at all; the rest mean nothing when
    # it is not
    isValue: bool
    # the element type
    elem: ztypes.tid
    # the type that indexes the list, 0 for the default
    index: ztypes.tid
    # the element was left untyped: the list's elements read as literals
    elemLiteral: bool
    # the index was left untyped: the list's slots read as literals
    indexLiteral: bool
}

# staticListValueTemplate -- the template a list of element type `elemTid` is a value
# of: `list`, for an element a list may hold; 0 for anything else (an element
# type that did not resolve).
staticListValueTemplate: function {
    ast: Ast st: zenv.ZSymbolTable elemTid: ztypes.tid
} out ztypes.tid is {
    if (conform.constraintHolds :ast :st ck: ztypes.constraintkind.staticMember argTid: elemTid
    ).not then {
        return ztypes.tid.zero
    }
    return (stdTid :ast :st wk: zast.wellKnown.slot.tyStaticlist)
}

# staticListValueTypeOver -- the type a list of element type `elemTid` has as a
# value: the list template's instance over the element, and over the index
# when the list names one (`idxTid`, else 0). An untyped element or index is
# bound at the run-time type it becomes (materialiseStaticListArgs). 0 when the
# element is none a list may hold.
staticListValueTypeOver: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    elemTid: ztypes.tid
    idxTid: ztypes.tid
} out ztypes.tid is {
    tpl: staticListValueTemplate :ast :st :elemTid
    if tpl.isZero then return ztypes.tid.zero
    # the parameters by position in the template's own declaration: the
    # element first, then the index, each at the run-time type it holds
    et: elemTid
    if (isLiteralTypeId reg: st.reg tid: et) then et = (
        materialTid
        :ast
        :st
        isElem: true
        float: et == st.reg.literalFloatTid
    )
    # an untyped string is text in a static position
    if et == st.reg.literalTextTid then et = stdTid :ast :st wk: zast.wellKnown.slot.tyText
    it: idxTid
    if it.notZero when (isLiteralTypeId reg: st.reg tid: it) then it = (
        materialTid
        :ast
        :st
        isElem: false
        float: false
    )
    pn: st.reg.genericParamNamesOf tdecl: (st.typing.declIdOfType typeId: tpl)
    subs: IdMapV zast.nameid v: ztypes.tid
    subs.set key: (pn.get i: 0) value: et
    sfx: "_\{st.reg.nameOf tid: et}"
    if it.notZero then {
        subs.set key: (pn.get i: 1) value: it
        sfx.append "_"
        sfx.append (st.reg.nameOf tid: it)
    }
    noVals: IdMapV zast.nameid v: u64
    return (
        getOrMintSpec
        :st
        scope: st.curScope
        :ast
        :unitDecl
        sfx: sfx.stringView
        templateId: tpl
        :subs
        valSubs: noVals
        fallbackArg: ztypes.tid.zero
    )
}

# staticListFits -- a list value of type `have` is one of type `want`: both
# are the list template's instances over one element type, and their indexes
# agree, an index left out being the template's default.
staticListFits: function {
    ast: Ast
    st: zenv.ZSymbolTable
    have: ztypes.tid
    want: ztypes.tid
} out bool is {
    tpl: stdtypes.stdTidRo :ast :st wk: zast.wellKnown.slot.tyStaticlist
    if tpl.isZero then return false
    if (st.reg.genericOriginOf tid: have) != tpl then return false
    if (st.reg.genericOriginOf tid: want) != tpl then return false
    if (
        (st.reg.genericTypeArgAt specId: have ordinal: 0) !=
        (st.reg.genericTypeArgAt specId: want ordinal: 0)
    ) then return false
    u64t: stdTid :ast :st wk: zast.wellKnown.slot.tyU64
    hi: st.reg.genericTypeArgAt specId: have ordinal: 1
    if hi.isZero then hi = u64t
    wi: st.reg.genericTypeArgAt specId: want ordinal: 1
    if wi.isZero then wi = u64t
    return hi == wi
}

# staticListAsValue -- a value of type `vt` written where a value is wanted:
# a list's `slot` is none, and is refused. `vt` itself otherwise, 0 when
# refused.
staticListAsValue: function {
    st: zenv.ZSymbolTable
    ast: Ast
    vt: ztypes.tid
    nid: zast.nodeid
} out ztypes.tid is {
    if vt.isZero or (vt != st.typing.listSlotTid) then return vt
    nn: ast.nodes.get i: nid
    (
        addErrorWithHint
        :st
        nodeid: nid
        lineno: (nodeLine n: nn)
        colno: (nodeCol n: nn)
        e: zast.err.typeError
        msg: "a list's `slot` is no value: it names its labels' positions".string
        note: String
        hint: "read one label's position, `blk.slot.label`".string
        width: 4
    )
    return ztypes.tid.zero
}

# constOfList -- a list definition's value: its row in the aggregate store
# (resolveStaticListInto). A list is a constant: a unit (or a type's `as`
# block) declares it, and its name reads it.
constOfList: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
    # the list type the place it lands in takes, 0 for none
    want: ztypes.tid
} out ztypes.cval is {
    dnode: staticListRefAt :ast :nid
    if dnode.nid.isZero then return ztypes.noConst
    noSubs: IdMapV zast.nameid v: ztypes.tid
    row: (
        resolveStaticListInto
        :ast
        :st
        :unitDecl
        :scope
        :dnode
        monoId: ztypes.tid
        tplId: ztypes.tid
        subs: noSubs
        :want
    )
    if row == 0 then return ztypes.noConst
    return (ztypes.makeAggConst id: row)
}

# staticListWantParts -- the parts of list type `want` a list with no `out`
# takes from the place it lands in: its element and its index, typed as
# written there -- an index `want` leaves out reads its slots untyped.
staticListWantParts: function {st: zenv.ZSymbolTable want: ztypes.tid} out staticlistoutparts is {
    idx: st.reg.genericTypeArgAt specId: want ordinal: 1
    return (
        staticlistoutparts
        isValue: true
        elem: (st.reg.genericTypeArgAt specId: want ordinal: 0)
        index: idx
        elemLiteral: false
        indexLiteral: idx.isZero
    )
}

# refuseListOutAgainst -- a nested list whose `out` names a list type other
# than the one the place it lands in takes.
refuseListOutAgainst: function {
    ast: Ast
    st: zenv.ZSymbolTable
    outId: zast.nodeid
    ot: ztypes.tid
    want: ztypes.tid
} is {
    n: ast.nodes.get i: outId
    gn: specWrittenName :st :ast tid: ot
    en: specWrittenName :st :ast tid: want
    (
        addErrorWithHint
        :st
        nodeid: outId
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.typeError
        msg: "the list's `out` is \{gn}, but it is a value of \{en} here"
        note: String
        hint: "drop the `out`: a nested list takes its type from where it is written".string
        width: 1
    )
}

# resolveStaticListInto -- a list definition as its row in the aggregate store:
# one item per element, labelled by the element's own label when it has one,
# all of the list's single element type. The row's type is the list's value
# type, its `elem` the type an element read has, its `slot` the type of a
# label's position. The element type is settled and RANGE-CHECKED here, at the
# declaration: a value the declared width cannot hold is an error where it is
# written, not a silent truncation at every read. For a generic unit's
# instance (`monoId`), the template's elements are evaluated for the instance
# -- a numeric parameter reads its value -- and the `out` type is read as the
# instance sees it (unitMonoTypeOf). 0 when the list has no row.
resolveStaticListInto: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    dnode: staticlistref
    # the instance the row is for, and its template; 0 for the list itself
    monoId: ztypes.tid
    tplId: ztypes.tid
    # the instance's substitutions (buildUnitMono's)
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    # the list type the place it lands in takes (a data field's), 0 for none:
    # a list with no `out` is of it, and one with an `out` must agree
    want: ztypes.tid
} out u32 is {
    # an empty list has no element to take its type from: one that lands
    # nowhere typed must write `out`
    if dnode.nelems == 0 when dnode.outType.isZero when want.isZero then {
        (
            addError
            :st
            nodeid: dnode.nid
            lineno: dnode.lineno
            colno: dnode.colno
            e: zast.err.badList
            msg: "an empty list must name its type: `list {} out staticlist u8`".string
        )
        return 0
    }
    litId: st.reg.literalIntTid
    # whether `out` names the list's own type (`out staticlist u8`) rather than
    # its element type (`out u8`, read until every list says its value type)
    valueOut: false
    # whether `slot` reads untyped: the index was left untyped, or no `out` named
    # one. An old-form `out T` keeps its typed (u64) slots.
    untypedSlots: dnode.outType.isZero
    # the `out` type, resolved first: a value type says the element type, and
    # only an old-form element type is a name staticListElemTypeName weighs
    ot: ztypes.tid
    vparts: (
        staticlistoutparts
        isValue: false
        elem: ztypes.tid
        index: ztypes.tid
        elemLiteral: false
        indexLiteral: false
    )
    if dnode.outType.notZero then {
        # `out T` is a type written in the list's scope and resolved as any
        # written type is: a user type spelled like a builtin is the user's
        ot = typeref.resolveTyperefShell :st :scope :ast :unitDecl nid: dnode.outType thisName: ""
        if monoId.isZero then {
            # recorded as any signature's type is, so a name that resolves to
            # nothing is reported as an unknown type where it is written
            typeref.recordTyperef :st :scope :ast :unitDecl thisName: "" nid: dnode.outType
        } else {
            ot = unitMonoTypeOf :st :ast rf: scope :tplId :monoId :subs tid: ot
        }
        vparts = (
            typeref.staticListOutParts
            :ast
            :st
            :scope
            :unitDecl
            valueTid: ot
            outId: dnode.outType
        )
        if want.notZero when ot.notZero when ot != want when (
            staticListFits
            :ast
            :st
            have: ot
            :want
        ).not then {
            refuseListOutAgainst :ast :st outId: dnode.outType :ot :want
            return 0
        }
    } else if want.notZero then {
        vparts = staticListWantParts :st :want
        untypedSlots = vparts.indexLiteral
    }
    # the values, read for the instance a generic unit's copy is for; an
    # element that is a list takes the element type the `out` names
    prevMono: st.walk.constMono
    if monoId.notZero then st.walk.constMono = monoId
    ew: ztypes.tid
    if vparts.isValue then ew = vparts.elem
    vals: staticListElemValues :ast :st :unitDecl :scope :dnode elemWant: ew
    st.walk.constMono = prevMono
    # a typed value type names the element type the elements' own tags are
    # weighed against; an untyped one, or an `out` refused below, names none
    etn: String
    if vparts.isValue when vparts.elemLiteral.not then etn = st.reg.nameOf tid: vparts.elem
    etId: staticListElemTypeName :ast :st :dnode outName: etn.stringView :vals
    elemTid: litId
    idxTid: ztypes.tid
    # the list's value type, when its `out` names one over a type parameter
    vt: ztypes.tid
    if vparts.isValue then {
        idxTid = vparts.index
        untypedSlots = vparts.indexLiteral
        # an untyped element reads as a literal, as in a list with no `out`,
        # and the list's value is the template's over the run-time type the
        # literal materialises to
        valueOut = vparts.elemLiteral.not
        elemTid = vparts.elem
        # a generic unit's list over its parameter (`out staticlist t`) is a value
        # of the type its `out` names, which no element type selects: each
        # instance's row is a value of its own
        if (st.reg.typetypeOf typeId: elemTid) == ztypes.ztypetype.genericParam then vt = ot
    } else {
        # an element's suffix (`0.u8`) or the untyped default names the
        # prelude's type whatever the unit declares, as a literal's suffix
        # does in a body
        lk: walkLookupTyperefFrom :st :ast scope: ztypes.declid baseId: etId
        if lk.some then {
            elemTid = lk
        }
        # a list of arms, data values or lists is of its first element's type
        ft: staticListFirstValueTid :ast :st :scope :vals
        if ft.notZero then elemTid = ft
    }
    ek: numerics.baseNumKind :st tid: elemTid
    # a list of mixed kinds has no element type to check its elements against
    kindsOk: staticListKindsAgree :ast :st :scope :dnode :vals :elemTid
    # a list that names its type -- `out T`, or a tagged element -- reads each
    # element at that type; one that names none reads them untyped, as a unit
    # constant reads, and only what reaches run time is the i64 / f64 default
    typed: (etn.length > 0) or valueOut or (staticListTagWritten :ast :dnode)
    # the template the list's value is an instance of: its members are every
    # list's own
    valTpl: staticListValueTemplate :ast :st :elemTid
    # an `out` names the list's value type; a declared type that is none is
    # refused here, and a name that resolved to nothing is the unknown type
    # recordTyperef reports
    if vparts.isValue.not when ot.notZero when (st.typing.declIdOfType typeId: ot).notZero then {
        conform.refuseStaticListOutType :ast :st outId: dnode.outType :ot
    }
    # every name an element takes: its label, else its ordinal
    taken: IdSet zast.nameid
    labelled: false
    ordinal: u64
    # each element's value and label, in order: the list's aggregate row
    aggItems: ListVal ztypes.cval
    aggLabels: ListVal zast.nameid
    kE: u64
    for kE < dnode.nelems loop {
        elId: zast.listElemAt :ast nid: dnode.nid i: kE
        kE = kE + 1
        itemV: ztypes.noConst
        nmRef: zast.nameid
        isNo: false
        opRef: zast.nodeid
        el: ast.nodes.get i: elId
        if el.namedoperation then {
            nmRef = el.name
            opRef = el.operation
            isNo = true
        }
        if isNo then {
            memberIdAt: nmRef
            if nmRef.isZero then {
                ord: "\{ordinal}"
                memberIdAt = ast.internString text: ord.stringView
            }
            if (taken.has item: memberIdAt) then {
                elD: ast.nodes.get i: elId
                dnm: zast.nameTextAt :ast ref: memberIdAt
                (
                    addErrorWithHint
                    :st
                    nodeid: (zast.nodeIdOf n: elD)
                    lineno: (nodeLine n: elD)
                    colno: (nodeCol n: elD)
                    e: zast.err.duplicateDef
                    msg: "list element name '\{dnm}' is used twice"
                    note: String
                    hint: "an unlabelled element is named by its index; give each element its own name".string
                    width: dnm.length
                )
            }
            taken.add item: memberIdAt
            if nmRef.notZero then labelled = true
            # an element named for one of the list's own members would shadow
            # it, or be shadowed by it -- either way a read of the name would
            # not mean what it says
            if (conform.staticListOwnMember :st :ast tpl: valTpl nameId: memberIdAt) then {
                elN: ast.nodes.get i: elId
                emN: zast.nameTextAt :ast ref: memberIdAt
                tm: "a list element may not be named '\{emN}'"
                th: "`\{emN}` is a member of every list: rename the element"
                (
                    addErrorWithHint
                    :st
                    nodeid: (zast.nodeIdOf n: elN)
                    lineno: (nodeLine n: elN)
                    colno: (nodeCol n: elN)
                    e: zast.err.typeError
                    msg: tm
                    note: String
                    hint: th
                    width: emN.length
                )
            }
            # The element's VALUE, recorded here rather than folded on demand:
            # it is the discriminator a tagged type using this list will be
            # emitted with, and a backend reading it has no unit to fold under.
            cv: vals.get i: ordinal
            if typed when cv.isConst when (numerics.isNumericTid :st tid: elemTid) then {
                cv = ztypes.typedConst c: cv numTid: elemTid
            }
            # a typed string list's element is a TYPED constant too: it reads
            # as its element type, not as a textliteral
            if typed when cv.kind.svalKind when (isStaticStringTid :ast :st tid: elemTid) then {
                cv = ztypes.typedConst c: cv numTid: elemTid
            }
            if kindsOk when cv.isConst when (
                numerics.staticListElemFits
                :ast
                :st
                :dnode
                :opRef
                :cv
                :ek
                fitTid: elemTid
            ) then itemV = cv
        }
        aggItems.append itemV
        aggLabels.append nmRef
        ordinal = ordinal + 1
    }
    if vt.isZero then vt = staticListValueTypeOver :st :ast :unitDecl :elemTid :idxTid
    # a label's position is typed as the list's index, else as the template's
    # default u64 -- or untyped when the index was left so. A list with no
    # labelled element has no `slot`.
    slotTid: ztypes.tid
    if labelled then {
        slotTid = idxTid
        if slotTid.isZero then slotTid = stdTid :ast :st wk: zast.wellKnown.slot.tyU64
        if untypedSlots then slotTid = litId
    }
    return (
        constInternAgg
        :st
        shape: (
            ztyping.aggshape
            kind: ztyping.constaggkind.staticList
            tid: vt
            arm: zast.nameid.zero
            elem: elemTid
            slot: slotTid
        )
        items: aggItems
        labels: aggLabels
        at: dnode.nid
    )
}

# typeExprHasPrivate -- does a field's type expression carry a `.private` marker
# (`Container.private.borrow`), i.e. is it a friend handle? Walks the dotted path
# (markers nest outermost-last: `((Container.private).borrow)`).
typeExprHasPrivate: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case dottedpath then {
        if (zast.markerKindOfLeaf :ast leaf: n.child).privateMarker then return true
        return (typeExprHasPrivate :ast n: (ast.nodes.get i: n.parent))
    } else {
        return false
    }
}

# typeExprRootIsThis -- does a type expression name the receiver under any
# markers (`this`, `this.private.borrow`)?
typeExprRootIsThis: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case atomid then {
        return n.name == zast.wellKnown.slot.wkThis
    } case dottedpath then {
        return (typeExprRootIsThis :ast n: (ast.nodes.get i: n.parent))
    } else {
        return false
    }
}

# scanTypeField -- one declared field: it is a member, its type may carry a
# `.private` handle grant, and a `public:` block that does not name it excludes
# it. A field holding a handle says how: `.private.borrow` or `.private.view`.
scanTypeField: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    n: astnode.view
    memberIds: IdSet zast.nameid
    grants: ListVal zast.nameid
    excl: ListVal zast.nameid
    pubIds: IdSet zast.nameid
    pubFound: bool
} is {
    if n.namedoperation.not then return
    memberIds.add item: n.name
    if (typeExprHasPrivate :ast n: (ast.nodes.get i: n.operation)) then {
        grants.append from: n.name
        refuseBarePrivateField :st :ast opId: n.operation
    }
    if pubFound.not then return
    if (pubIds.has item: n.name).not then excl.append from: n.name
}

# refuseBarePrivateField -- a field's type that ENDS in `.private`: a field holds
# a friend handle by reference, and must say which kind, `.private.borrow` or
# `.private.view`. A parameter's bare `.private` is `.private.borrow`.
refuseBarePrivateField: function {st: zenv.ZSymbolTable ast: Ast.view opId: zast.nodeid} is {
    if (typeExprLeafId :ast :opId) != zast.wellKnown.slot.wkPrivate then return
    op: ast.nodes.get i: opId
    (
        declare.addResolveErrorAt
        :st
        nodeid: opId
        lineno: (nodeLine n: op)
        colno: (nodeCol n: op)
        e: zast.err.typeError
        msg: "a `.private` field must be `.private.borrow` or `.private.view`".string
        width: 1
    )
}

# typeExprLeafId -- the name a dotted type expression ends in, zero for any
# other shape
typeExprLeafId: function {ast: Ast.view opId: zast.nodeid} out zast.nameid is {
    op: ast.nodes.get i: opId
    match (
        op
    ) case dottedpath then {
        return (atomNameId :ast n: (ast.nodes.get i: op.child))
    } else {
        return zast.nameid.zero
    }
}

# declaredFieldTid -- the slot type of a field declared by a type-ref: the type
# its folded value gives it, or else the type-ref resolved.
declaredFieldTid: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    rid: ztypes.tid
    fm: argref
    # the type the declaration's folded value gives it, zero for none
    folded: ztypes.tid
} out ztypes.tid is {
    if folded.notZero then return folded
    refuseUnfoldedConversion :st :ast what: "field" dm: fm
    noteFieldRefOwner :st :ast ownerTid: rid :fm
    return (
        fieldSlotTid
        :st
        :ast
        :unitDecl
        :scope
        ownerTid: rid
        oId: fm.operation
        thisName: defName
    )
}

# noteFieldRefOwner -- a field declared by the bare name of a member of its own
# type that did not fold (`w: u` with `u` an `as` member): the type-ref that
# stands in for it waits in the scope the type is written in, where `u` is not
# seen, so the type is noted for the stamp to ask (ZTyping.fieldRefOwner). A
# generic parameter is a type, resolved as one, a field named as its type names
# the type, and a member that folds never gets here.
noteFieldRefOwner: function {
    st: zenv.ZSymbolTable ast: Ast.view ownerTid: ztypes.tid fm: argref
} is {
    if fm.operation.isZero then return
    isAtom: false
    {
        vn: ast.nodes.get i: fm.operation
        isAtom = vn.atomid
    }
    if isAtom.not then return
    nameId: atomNameId :ast n: (ast.nodes.get i: fm.operation)
    od: st.typing.declIdOfType typeId: ownerTid
    # a field named as its type is (`text: text`) names the type, not itself
    if nameId.isZero or od.isZero or (nameId == fm.name) then return
    omd: st.typing.declFindChild parentDeclId: od :nameId
    if omd.isZero then return
    if (st.reg.isGenericParamOf tdecl: od name: nameId) then return
    # an alias is a type, resolved as one
    if (asAliasKnownAt typing: st.typing md: omd) then return
    kf: fm.operation
    st.walk.fieldRefOwner.set key: kf value: od
}

# attachDeclaredField -- a field declared by a type-ref rather than by a
# sibling method: resolve its slot type, refuse what a record may not hold,
# attach it, and record the marker and default the declaration carries.
attachDeclaredField: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    rid: ztypes.tid
    fm: argref
    fname: StringView
} is {
    folded: foldedDeclType :st :ast ownerTid: rid dm: fm
    cid: declaredFieldTid :st :scope :ast :unitDecl :defName :rid :fm :folded
    # a list that did not fold declares nothing; its fold said why
    if (ast.nodes.get i: fm.operation).listblock when folded.isZero then return
    (
        refuseNullTyped
        :st
        tid: cid
        nodeid: fm.nid
        lineno: fm.lineno
        colno: fm.colno
        what: "field"
        name: fname
    )
    # a refused field is still the type's field, as written: a construction
    # naming it is not refused again for an unknown argument
    if (st.reg.isStaticOf tid: rid) then {
        refuseNonStaticMember :st :ast :fm tid: cid
    } else {
        (
            refuseReftypeMember
            :st
            :ast
            :fm
            owner: defName
            tid: cid
            what: "record field"
            remedy: "class"
            name: fname
        )
    }
    st.typing.setMemberType parentTypeId: rid nameId: fm.name childTypeId: cid
    recordSingletonDefault :st ownerTid: rid nameId: fm.name
    if (st.reg.typetypeOf typeId: cid) == ztypes.ztypetype.functionType then {
        st.typing.setChildFnptrField pool: ast.names parentTypeId: rid name: fname
    }
    # an expression, or a name the type's own scope declares, is no type-ref to
    # stamp; a name the unit declares (`p: false`) still navigates as one
    stampsTyperef: valueStampsTyperef :st :ast ownerTid: rid :folded node: fm.operation
    if stampsTyperef then (
        typeref.recordTyperef
        :st
        :scope
        :ast
        :unitDecl
        thisName: ""
        nid: fm.operation
    )
    dcn1Id: dottedChildNameId :ast n: (ast.nodes.get i: fm.operation)
    rdnr: zast.nameTextAt :ast ref: (rootNameIdOf :ast n: (ast.nodes.get i: fm.operation))
    if (isNumericLiteralName name: rdnr.stringView) then {
        refuseWideDefault :st :ast nid: fm.operation
        refuseLiteralMember :st :ast nid: fm.operation
        (
            st.typing.declSetDefault
            parentTypeId: rid
            pool: ast.names
            name: fname
            value: ztyping.defaultval.literal fm.operation
        )
    } else {
        rArmNid: armDefaultLeaf :st :scope :ast node: fm.operation ownerTid: rid slotTid: cid
        if rArmNid.notZero then {
            rArmDecl: st.typing.declMemberIdOf parentTypeId: cid nameId: rArmNid
            (
                st.typing.declSetDefault
                parentTypeId: rid
                pool: ast.names
                name: fname
                value: ztyping.defaultval.arm rArmDecl
            )
        }
    }
    recordFoldedArmDefault :st :ast what: "field" ownerTid: rid :fname dm: fm
    recordFoldedDefault :st :ast ownerTid: rid dm: fm
    if dcn1Id.notZero when (isStripMarkerId nameId: dcn1Id) then null else {
        if dcn1Id.notZero then {
            fieldNid: nodeId n: (ast.nodes.get i: fm.operation)
            st.walk.pendingDefaultOwner.set key: fieldNid value: rid
            rootNameId: rootNameIdOf :ast n: (ast.nodes.get i: fm.operation)
            st.walk.pendingDefaultName.set key: fieldNid value: rootNameId
        }
    }
}


# detectTagAccessor -- a non-function variant/union as-item of the form
# `name: <integer>.tag` declares the read-only tag accessor: instances
# expose the discriminator ordinal as that integer type under that name. The
# storage is the type its name resolves to.
detectTagAccessor: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    ownerId: ztypes.tid
    am: argref
} is {
    if (opIsTagRef :ast :am).not then return
    # a list names the tag's values, and is no storage to resolve
    storeNm: zast.nameid
    {
        op: ast.nodes.get i: am.operation
        if op.dottedpath then storeNm = atomNameId :ast n: (ast.nodes.get i: op.parent)
    }
    sd: declInScope :st scopeDeclId: scope nameId: storeNm
    if sd.notZero when (st.typing.decls.get i: sd).kind.staticListDecl then return
    # A TAG ACCESSOR IS NOT A CONTAINMENT EDGE. `tag: u8.tag` declares a read of
    # the discriminator the variant already carries, not a field that has to lay
    # out inside it -- so it takes the plain typeref, and a type reached through
    # it is never an ancestor of anything.
    nid: (
        ztypes.tid.create
        from: (
            typeref.resolveTyperefShell
            :st
            :scope
            :ast
            :unitDecl
            nid: am.operation
            thisName: defName
        )
    )
    # a storage that is not an integer is refused where the storage is
    # decided (variantTagBaseTid)
    if (isTagStorage :st tid: nid).not then return
    st.typing.tagAccessor.set key: ownerId value: (ztyping.tagaccessor name: am.name tid: nid)
}

# isTagStorage -- `tid` can hold a sum's discriminator: one of the system's
# integer types, at most 64 bits wide.
isTagStorage: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    nk: numerics.numKindOfTid typing: st.typing :tid
    if nk.has.not then return false
    if (ztypes.isFloatKind k: nk.kind) then return false
    return (ztypes.intKindBits k: nk.kind) <= 64
}

# tagAccessorOwner -- the type whose tag accessor `tid` answers with: its own,
# else, for an instance, its template's.
tagAccessorOwner: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view tid: ztypes.tid
} out ztypes.tid is {
    if (typing.tagAccessor.has key: tid) then return tid
    og: reg.genericOriginOf :tid
    if og.isZero then return tid
    return og
}

# variantTagBaseTid -- the NUMERIC type a tagged type's discriminator is stored
# in: the base of a declared `tag: X.tag`, or u8 when none is declared, which is
# the spec's default (§tag: "If no tag is specified, the compiler uses u8 by
# default with sequential values starting from 0"). 0 when the tag is
# list-sourced -- its constants are whatever the list says, so its width
# is that block's business -- or when the base does not resolve. Any other base
# is the type its name resolves to, and one that is not one of the system's
# integers of at most 64 bits is refused here, where the storage is decided.
#
# Recorded so a backend can honour what the declaration asked for. Emitting the
# discriminator as a C `enum` ignores it: an enum is `int`, so `tag: u8.tag`
# silently became four bytes.
variantTagBaseTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    objId: zast.nodeid
} out optionval ztypes.tid is {
    declared: ztypes.tid
    sawTag: false
    orf: declare.objRefAt :ast nid: objId
    kIter: u64
    for kIter < orf.nas loop {
        amId: zast.objAsItemAt :ast nid: objId i: kIter
        kIter = kIter + 1
        am: argRefAt :ast nid: amId
        if am.nid.notZero when (opIsTagRef :ast :am) then {
            sawTag = true
            # the storage's name: a list names the tag's values; any
            # other name is the type it resolves to, as every type-ref is
            bnId: zast.nameid
            {
                opNode: ast.nodes.get i: am.operation
                if opNode.dottedpath then bnId = (
                    atomNameId
                    :ast
                    n: (ast.nodes.get i: opNode.parent)
                )
            }
            if bnId.notZero then {
                bd: declInScope :st scopeDeclId: scope nameId: bnId
                if bd.notZero when (st.typing.decls.get i: bd).kind.staticListDecl then {
                    declared = ztypes.tid.zero
                } else {
                    rr: resolve.resolveAtomType :st :ast :unitDecl :scope nameId: bnId thisName: ""
                    if (isTagStorage :st tid: rr) then {
                        declared = rr
                    } else if rr.notZero then {
                        bn: zast.nameTextCopy :ast ref: bnId
                        (
                            declare.addResolveErrorAt
                            :st
                            nodeid: am.nid
                            lineno: am.lineno
                            colno: am.colno
                            e: zast.err.typeError
                            msg: "a tag is stored as an integer type of at most 64 bits: '\{bn}' is not one"
                            width: bn.length
                        )
                    }
                }
            }
        }
    }
    # NOT RECORDED when nothing is declared: the spec's default is u8, and the
    # backend can spell that without being told. Resolving u8's id here would be
    # a demand made during resolution, which need not be satisfiable yet -- and
    # when it was not, every tagged type silently fell back to the enum.
    if sawTag.not then return (optionval.none ztypes.tid)
    return (optionval.some declared)
}

# opIsTagRef -- whether a member's operation is a `<Base>.tag` reference.
opIsTagRef: function {ast: Ast am: argref} out bool is {
    opNode: ast.nodes.get i: am.operation
    if opNode.dottedpath.not then return false
    return (atomNameId :ast n: (ast.nodes.get i: opNode.child)) == zast.wellKnown.slot.wkTag
}

# tagBaseIsU8 -- whether the base a `.tag` reference names resolves to `u8`
# exactly: not a list, and the same type id as the builtin.
tagBaseIsU8: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    bn: StringView
} out bool is {
    rr: bodies.walkLookupTyperef :st :scope :ast :unitDecl base: bn
    if rr.none then return false
    u8t: stdTid :ast :st wk: zast.wellKnown.slot.tyU8
    if u8t.isZero then return false
    return rr == u8t
}

# whether a variant's tag is the plain ordinal one rather than an author-
# declared `data` tag. The truthiness rules only apply to the plain kind
variantTagIsOrdinalPlain: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    objId: zast.nodeid
} out bool is {
    orf: declare.objRefAt :ast nid: objId
    kIter: u64
    for kIter < orf.nas loop {
        amId: zast.objAsItemAt :ast nid: objId i: kIter
        kIter = kIter + 1
        am: argRefAt :ast nid: amId
        if am.nid.notZero when (opIsTagRef :ast :am) then {
            # the base name is read before the lookup below lends ast
            bn: dottedParentName :ast n: (ast.nodes.get i: am.operation)
            if bn.length == 0 then return false
            if (tagBaseIsU8 :ast :st :unitDecl :scope bn: bn.stringView).not then return false
        }
    }
    return true
}

# dottedParentName -- the parent atom name of a `parent.child` dottedpath astnode, ""
# for anything else. Matching the astnode param narrows it cleanly.
# variantTagIsOrdinalPlain -- the discriminator's VALUES are the arm ordinals
# 0, 1, 2 ... stored in a byte, which is what lets a backend treat the value as
# the ordinal itself. True when the type declares no tag -- the spec's default
# is u8, sequential from 0 -- or declares a numeric tag whose storage is u8.
#
# False for a list-sourced tag, whose constants are whatever the list
# says: `list { LOW: 0  HIGH: 10 }` has two arms and is NOT two ordinals. False
# too for a wider declared numeric, where the author asked for that width. And
# false when the tag base does not resolve, because an unverified shape is not
# one to optimise on.
#
# Found by the `.tag` SUFFIX rather than the member's label: the spec makes the
# label convention only ("commonly tag, but any name is valid").
dottedParentName: function {ast: Ast.view n: astnode.view} out String is {
    match (
        n
    ) case dottedpath then {
        return (typeargs.atomName :ast n: (ast.nodes.get i: n.parent))
    } else {
        return "".string
    }
}

# qualifierUnitDecl -- the unit declaration a qualifier path names: a bare name
# through the environment (a file unit, or a unit a unit declares), each further
# segment a unit its predecessor declares, and at any segment an alias of a unit
# (`c: runtime.nativec`). 0 when a segment names no unit.
qualifierUnitDecl: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    ast: Ast.view
    nid: zast.nodeid
} out ztypes.declid is {
    return (resolve.qualifierUnitDeclAt :st :scope :ast :nid hops: 0)
}

# tagsource -- the list a sum's `as` block sources its tag from (`tag:
# levels.tag`): its row and its declaration. A zero row is none.
tagsource: record {
    row: u32
    decl: ztypes.declid
}

# typeExprText -- a type expression as it is WRITTEN (exprTextOf),
# parenthesised when it is a call, so a report names what the author wrote and
# not the name the compiler minted for it. "" when the node spells nothing.
typeExprText: function {ast: Ast.view nid: zast.nodeid} out String is {
    if nid.isZero then return "".string
    isCall: false
    node: ast.nodes.get i: nid
    # exprTextOf spells atoms, dotted paths and calls; any other node spells
    # nothing a report could name
    if node.atomid.not when node.dottedpath.not when node.call.not then return "".string
    isCall = node.call
    r: String
    if isCall then r.append "("
    moves.exprTextOf :ast n: (ast.nodes.get i: nid) dst: r
    if isCall then r.append ")"
    return r
}

# refuseArmPayload -- what an arm of a sum may not carry: a variant's, a
# reftype (refuseReftypeMember); a choice's, anything but a static value
# (refuseNonStaticMember). True when refused, so the arm is skipped.
refuseArmPayload: function {
    st: zenv.ZSymbolTable
    ast: Ast
    fm: argref
    defName: StringView
    cid: ztypes.tid
    isChoice: bool
} out bool is {
    # an arm that carries nothing carries nothing a choice refuses
    if isChoice when cid == st.typing.nullTypeId then return false
    if isChoice then return (
        refuseNonStaticMember
        :st
        :ast
        :fm
        tid: cid
        arm: true
    )
    return (
        refuseReftypeMember
        :st
        :ast
        :fm
        owner: defName
        tid: cid
        what: "variant arm"
        remedy: "union"
        name: (zast.nameTextAt :ast ref: fm.name).stringView
    )
}

# refuseNonStaticMember -- a data field holds a static value, and a choice's
# arm carries one: a number (a literal type included), an enum (bool among
# them), text, a function reference, a static list, a data type or a choice.
# True when it reported.
refuseNonStaticMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    # the member, whose name the report quotes
    fm: argref
    tid: ztypes.tid
    # the member is a choice's arm rather than a data field
    arm: false
} out bool is {
    if tid.isZero or (isStaticMemberTid :st :ast :tid) then return false
    # a type parameter: the data type itself is refused (refuseDataShape)
    if (st.reg.typetypeOf typeId: tid) == ztypes.ztypetype.genericParam then return false
    tn: specWrittenName :st :ast :tid
    hint: String
    if tid == (stdTid :ast :st wk: zast.wellKnown.slot.tyStringView) then {
        hint = "a data field's string is text: declare it `text`".string
        if arm then hint = "a choice arm's string is text: declare it `text`".string
    }
    name: zast.nameTextAt :ast ref: fm.name
    what: "data field '\{name}' holds a '\{tn}': a data field holds"
    if arm then what = "choice arm '\{name}' carries a '\{tn}': a choice arm carries"

    (
        addErrorWithHint
        :st
        nodeid: fm.nid
        lineno: fm.lineno
        colno: fm.colno
        e: zast.err.typeError
        msg: "\{what} static values -- numbers, bool and other enums, text, function references, static lists, data types and choices"
        note: String
        :hint
        width: name.length
    )
    return true
}

# staticMemberHolds -- `tid` satisfies `staticmember`, what a list holds: what
# a data field holds, a function reference aside, and StringView.
staticMemberHolds: function {st: zenv.ZSymbolTable ast: Ast tid: ztypes.tid} out bool is {
    if (st.reg.typetypeOf typeId: tid) == ztypes.ztypetype.functionType then return false
    if (isStaticStringTid :ast :st :tid) then return true
    return (isStaticMemberTid :st :ast :tid)
}

# isStaticMemberTid -- a type a data field may hold (refuseNonStaticMember).
isStaticMemberTid: function {st: zenv.ZSymbolTable ast: Ast tid: ztypes.tid} out bool is {
    if (
        (typeIsNumberOf :st :tid float: false) or (typeIsNumberOf :st :tid float: true)
    ) then return true
    if (isAnyLiteralTid :st :tid) then return true
    if tid == (stdTid :ast :st wk: zast.wellKnown.slot.tyText) then return true
    if (st.reg.isStaticOf :tid) then return true
    if (numerics.valIsMonoOf reg: st.reg typing: st.typing :tid wk: zast.wellKnown.slot.tyStaticlist
    ) then return true
    tt: st.reg.typetypeOf typeId: tid
    if tt == ztypes.ztypetype.functionType then return true
    if tt != ztypes.ztypetype.variantType then return false
    pays: ListVal ztypes.tid
    resolve.variantPayloadTids typing: st.typing :tid parts: pays
    return pays.length == 0
}

# refuseReftypeMember -- A VALTYPE HOLDS VALUE DATA ONLY, the dual of the Box
# rule below: a record field, a variant arm and a record typedef's base may
# not be a reftype (a class, a union, a protocol, a heap native such as
# String), directly or through a typedef. The declaration is refused, not the
# use: the synthesised `==` and hash read the value's bytes, and a member
# behind a pointer has none to read. `what` names the member kind and
# `remedy` the reftype the author should declare instead. True when refused,
# so the caller can skip the member the way refuseStringArmPayload's does.
refuseReftypeMember: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    fm: argref
    owner: StringView
    tid: ztypes.tid
    what: StringView
    remedy: StringView
    name: StringView
} out bool is {
    if (st.reg.isReftypeOf :tid).not then return false
    # the type the author WROTE: a mono's minted name (`ListRef_String`) is
    # not a name the program spells anywhere
    tn: typeExprText :ast nid: fm.operation
    if tn.length == 0 then tn = st.reg.nameOf :tid
    mr: "a \{what} holds valtypes; make '\{owner}' a \{remedy} to hold '\{tn}'"
    (
        declare.addResolveErrorAt
        :st
        nodeid: fm.nid
        lineno: fm.lineno
        colno: fm.colno
        e: zast.err.typeError
        msg: mr
        width: name.length
    )
    return true
}

# fieldTypeNeedsCleanup -- true when a class field needs cleanup (so the holder
# keeps a destructor), asked of the field's resolved type: a borrowed field (its
# borrow is released at scope exit), a type with a destructor, or a class or
# union whose declaration is still resolving -- a self-reference, whose
# destructor is not known yet and which owns its data whatever it turns out to
# hold. A scalar, a record, or a class or union with no destructor needs none.
fieldTypeNeedsCleanup: function {
    st: zenv.ZSymbolTable.view
    # the field's type
    tid: ztypes.tid
    isBorrowed: bool
} out bool is {
    if isBorrowed then return true
    if tid.isZero then return false
    if (st.reg.needsDestructor typeId: tid) then return true
    if (st.reg.typetypeOf typeId: tid).isReferenceData.not then return false
    return (st.typing.declIsResolving declId: (st.typing.declIdOfType typeId: tid))
}

# refuseLiteralMember -- a default written over a numeric literal: `0.u64` names
# the literal's width, and that is the only member a literal has, so `0.rid` is
# refused the way a body refuses the same read -- the literal's own type has no
# member of that name. The default keeps its place either way, so the member is
# not reported as required as well.
refuseLiteralMember: function {st: zenv.ZSymbolTable ast: Ast.view nid: zast.nodeid} is {
    parentId: zast.nodeid
    childId: zast.nodeid
    {
        n: ast.nodes.get i: nid
        if n.dottedpath.not then return
        parentId = n.parent
        childId = n.child
    }
    cn: atomNameId :ast n: (ast.nodes.get i: childId)
    if cn.isZero then return
    if (isScalarNameId id: cn) then return
    ct: zast.nameTextAt :ast ref: cn
    # the literal's own type: a decimal integer reads as an i64, any other
    # spelling as a u64
    lex: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: parentId))
    ltn: "u64"
    if (isDecimalLexeme lex: lex.stringView) then ltn = "i64"
    cnode: ast.nodes.get i: childId
    (
        addError
        :st
        nodeid: childId
        lineno: (nodeLine n: cnode)
        colno: (nodeCol n: cnode)
        e: zast.err.typeError
        msg: "type '\{ltn}' has no member '\{ct}'"
    )
}

# refuseWideDefault -- a default written as a bare integer literal is an i64, as
# the declaration's own type is, so one outside i64 is refused where it is
# written, as every untyped value is where it lands: a decimal past i64 needs
# its conversion written (`18446744073709551615.u64`).
refuseWideDefault: function {st: zenv.ZSymbolTable ast: Ast.view nid: zast.nodeid} is {
    isAtom: false
    {
        da: ast.nodes.get i: nid
        isAtom = da.atomid
    }
    if isAtom.not then return
    da: ast.nodes.get i: nid
    lex: zast.nameTextAt :ast ref: (atomNameId :ast n: da)
    if lex.length < 19 then return
    v: consteval.constLiteralValue :st name: lex.stringView
    m: String
    if v.bigId != 0 then {
        m = consteval.constFitsKindMessage :st :v k: ztypes.numkind.i64Type spelling: lex.stringView
    } else if v.kind.none when (constLiteralBig lex: lex.stringView).none then {
        # past the 512 bits a constant holds, there is no value at all
        m = "integer literal \{lex} overflows"
    }
    if m.length == 0 then return
    (
        addErrorWithHint
        :st
        nodeid: (zast.nodeIdOf n: da)
        lineno: (nodeLine n: da)
        colno: (nodeCol n: da)
        e: zast.err.typeError
        msg: m
        note: String
        hint: "a default written as a bare literal is an i64: write `\{lex}.u64` for a u64"
        width: lex.length
    )
}

# recordFieldDefault -- record the default a field declares: a numeric literal
# folds to the field's own type, a named one waits for the type it references
# to resolve, and a marker-suffixed one is not a default at all.
recordFieldDefault: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    scope: ztypes.declid
    cid: ztypes.tid
    cidf: ztypes.tid
    fname: StringView
    fm: argref
} is {
    dcn0Id: dottedChildNameId :ast n: (ast.nodes.get i: fm.operation)
    rdnc: zast.nameTextAt :ast ref: (rootNameIdOf :ast n: (ast.nodes.get i: fm.operation))
    if (isNumericLiteralName name: rdnc.stringView) then {
        refuseWideDefault :st :ast nid: fm.operation
        refuseLiteralMember :st :ast nid: fm.operation
        (
            st.typing.declSetDefault
            parentTypeId: cid
            pool: ast.names
            name: fname
            value: ztyping.defaultval.literal fm.operation
        )
    } else {
        cArmNid: armDefaultLeaf :st :scope :ast node: fm.operation ownerTid: cid slotTid: cidf
        if cArmNid.notZero then {
            cArmDecl: st.typing.declMemberIdOf parentTypeId: cidf nameId: cArmNid
            if (
                refuseArmDefaultPayload
                :st
                :ast
                what: "field"
                :fname
                :fm
                armTid: cidf
                armName: cArmNid
            ).not then (
                st.typing.declSetDefault
                parentTypeId: cid
                pool: ast.names
                name: fname
                value: ztyping.defaultval.arm cArmDecl
            )
        }
    }
    if dcn0Id.notZero when (isStripMarkerId nameId: dcn0Id) then null else {
        if dcn0Id.notZero then {
            rdk: nodeId n: (ast.nodes.get i: fm.operation)
            rdo: cid
            st.walk.pendingDefaultOwner.set key: rdk value: rdo
            fieldNid: nodeId n: (ast.nodes.get i: fm.operation)
            rdn: rootNameIdOf :ast n: (ast.nodes.get i: fm.operation)
            st.walk.pendingDefaultName.set key: fieldNid value: rdn
        }
    }
}


# foldedDeclType -- the type a declaration's VALUE declares, for a field or a
# parameter declared by a bare value; 0 when it declares none.
#
# This is the door every other constant takes: `constFoldDecl` folds the value
# and registers the type that value carries, addressed by the declaration alone
# -- "a constant's TYPE comes from its VALUE, so the fold is what declares it".
# Reading the answer back is what lets `n: -1` be an i64 holding -1, rather than
# the declaration's first byte being consulted twice and the two answers
# disagreeing.
#
# A FIELD AND A PARAMETER ASK THIS THE SAME WAY. Both are constant declarations
# in the sense a unit-level `x: -1` is, docs/spec.pdoc lists their eligible
# value forms once for the two of them, and an owner is an owner: a class's type
# id or a function's, with the member hanging off it either way.
#
# ONLY WHERE THE VALUE HAS NO TYPE OF ITS OWN TO SAY (valueDeclares): a bare
# name, an operator, an `if`. A dotted declaration carries its own type in the
# leaf -- `value: 4.u64` is a u64 field, and the suffix is the entire point of
# writing it -- so the type-ref path answers those, and folding them would
# flatten them to the literal's own type.
foldedDeclType: function {
    # where the fold is recorded
    st: zenv.ZSymbolTable
    # the tree the declaration's value is read from
    ast: Ast
    # the type the member hangs off: a class's, or a function's
    ownerTid: ztypes.tid
    # the member's declaration
    dm: argref
} out ztypes.tid is {
    declare.refuseNumericParamName :st :ast :ownerTid :dm
    sgT: singletonFieldType :st :ast :ownerTid :dm
    if sgT.notZero then return sgT
    ownerDecl: st.typing.declIdOfType typeId: ownerTid
    if (numericParamsInScope :st scope: ownerDecl) then {
        (
            refuseSingletonDeclType
            :st
            :ast
            :ownerDecl
            isFunction: (st.reg.typetypeOf typeId: ownerTid) == ztypes.ztypetype.functionType
            typeNid: dm.operation
        )
        if (refusePerInstanceDefault :st :ast :ownerTid :dm) then return ztypes.tid
    }
    bare: declaredByValue :st :ast :ownerTid node: dm.operation
    if bare.not then return ztypes.tid
    fd: st.typing.declMemberIdOf parentTypeId: ownerTid nameId: dm.name
    if fd.isZero then return ztypes.tid
    errsBefore: st.typing.errors.length
    constFoldDecl :ast :st declId: fd
    # AN ARM CONSTANT MUST NAME AN ARM SOMETHING DECLARES. A GENERIC
    # PARAMETER'S declaration wears the same shape -- `t: anyval.generic` reads
    # as a dotted arm of `anyval` -- and folds to an arm constant no arm answers
    # for. Answering from it types `v: t` as the bound, `anyval`, and the
    # template stops agreeing with itself. The arm's own declaration tells the
    # two apart, and a name the fold cannot place belongs to the type-ref path,
    # which knows how to resolve one.
    cvD: constValueOfDecl :st declId: fd
    # a value the fold refused declares nothing: its report is the member's
    if cvD.kind.none when st.typing.errors.length > errsBefore then return ztypes.tid
    if cvD.kind.armKind then {
        avD: st.typing.declMemberIdOf parentTypeId: cvD.armTid nameId: cvD.armName
        if avD.isZero then return ztypes.tid
    }
    fto: st.typing.declChildOfId parentTypeId: ownerTid nameId: dm.name
    if fto.some then {
        return fto
    }
    return ztypes.tid
}

# numericParamsInScope -- a declaration at or enclosing `scope` has a numeric
# generic parameter, which a declaration there may name.
numericParamsInScope: function {st: zenv.ZSymbolTable.view scope: ztypes.declid} out bool is {
    cur: scope
    for cur.notZero loop {
        if (st.reg.genericNumericParamCountOf tdecl: cur) > 0 then return true
        cur = st.typing.declParentOf declId: cur
    }
    return false
}

# refusePerInstanceDefault -- a field or parameter whose default is computed
# from a numeric generic parameter (`n: cap * 2`, `n: cap.u64`, `n: D` with
# `D: cap * 3`): each instance would give it another value, and a default is
# one value for every instance. The member is declared by its type instead and
# set where it is made. Recorded as refused, so its uses say nothing more.
# True when it refused.
refusePerInstanceDefault: function {
    st: zenv.ZSymbolTable
    ast: Ast
    ownerTid: ztypes.tid
    dm: argref
} out bool is {
    ownerDecl: st.typing.declIdOfType typeId: ownerTid
    if (defaultReadsNumericParam :st :ast :ownerDecl node: dm.operation).not then return false
    # an alias (`SAME: cap`) names a type, which declares the member
    if (namesAsAlias :st :ast scope: ownerDecl node: dm.operation) then return false
    pn: zast.nameTextAt :ast ref: dm.name
    what: "field"
    how: "set it in a `create`"
    if (st.reg.typetypeOf typeId: ownerTid) == ztypes.ztypetype.functionType then {
        what = "parameter"
        how = "have the caller pass it"
    }
    (
        addErrorWithHint
        :st
        nodeid: dm.nid
        lineno: dm.lineno
        colno: dm.colno
        e: zast.err.typeError
        msg: "the \{what} '\{pn}' has a default computed from a numeric generic parameter, which each instance gives another value"
        note: String
        hint: "declare '\{pn}' by its type and \{how}"
        width: pn.length
    )
    st.typing.refusedValues.add item: dm.operation
    return true
}

# namesAsAlias -- `node` is a bare name of an `as` alias of a type at or
# enclosing `scope`: a type-ref, not a value.
namesAsAlias: function {
    st: zenv.ZSymbolTable
    ast: Ast
    scope: ztypes.declid
    node: zast.nodeid
} out bool is {
    nm: zast.atomNameIdOf n: (ast.nodes.get i: node)
    if nm.isZero then return false
    cur: scope
    for cur.notZero loop {
        md: st.typing.declFindChild parentDeclId: cur nameId: nm
        if md.notZero then {
            # a unit's definition aliases a type, as a type's `as` item does
            if (aliasNamesType :st :ast declId: md) then return true
            return (asMemberIsAlias :st :ast tdecl: cur :md)
        }
        cur = st.typing.declParentOf declId: cur
    }
    return false
}

# defaultReadsNumericParam -- the declaration's value `node` is computed from a
# numeric generic parameter of `ownerDecl` or of a definition enclosing it: an
# expression or a constant over one (constReadsNumericParam), or a member read
# off one (`cap.u64`). A bare parameter declares a slot of its singleton type,
# and a type built from one (`(array t: i64 to: cap)`) is a type.
defaultReadsNumericParam: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    ownerDecl: ztypes.declid
    node: zast.nodeid
} out bool is {
    n: ast.nodes.get i: node
    an: zast.atomNameIdOf :n
    if an.notZero when (numericParamOwnerFrom :st scope: ownerDecl nameId: an).notZero then {
        return false
    }
    leaf: dottedChildNameId :ast :n
    root: rootNameIdOf :ast :n
    if leaf.notZero when (isStripMarkerId nameId: leaf).not when (
        numericParamOwnerFrom
        :st
        scope: ownerDecl
        nameId: root
    ).notZero then return true
    if (valueDeclares :ast :node).not then return false
    return (constReadsNumericParam :st :ast owner: ownerDecl opId: node)
}

# singletonFieldType -- a type's field declared by a numeric generic parameter
# of the type or of a definition enclosing it (`stored: cap`): a slot of the
# parameter's singleton type -- the parameter's own type in the template
# (abstractSingletonOf), its instance's singleton type in each instance
# (completeIdSubs) -- whose default is that type's one value
# (recordNumericDefaults). 0 for any other declaration: a function's parameter
# so declared is a type-ref, which refuseSingletonTypeRef refuses.
singletonFieldType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    ownerTid: ztypes.tid
    dm: argref
} out ztypes.tid is {
    if (st.reg.typetypeOf typeId: ownerTid) == ztypes.ztypetype.functionType then return ztypes.tid
    vnId: zast.atomNameIdOf n: (ast.nodes.get i: dm.operation)
    if vnId.isZero then return ztypes.tid
    # the parameter is the owner's or an enclosing definition's -- a unit's --
    # found as a read of the name in a body finds it
    ownerDecl: st.typing.declIdOfType typeId: ownerTid
    tdecl: numericParamOwnerFrom :st scope: ownerDecl nameId: vnId
    if tdecl.isZero then return ztypes.tid
    cd: st.reg.genericParamConstraintOf :tdecl paramName: vnId
    bound: numericBoundTid :ast :st scope: st.curScope :cd
    if bound.isZero then return ztypes.tid
    fd: st.typing.declMemberIdOf parentTypeId: ownerTid nameId: dm.name
    if fd.isZero then return ztypes.tid
    (
        st.typing.declSetDefaultId
        parentTypeId: ownerTid
        nameId: dm.name
        value: ztyping.defaultval.constant fd
    )
    return (abstractSingletonOf :st :ast :tdecl param: vnId :bound)
}

# abstractSingletonOf -- the numeric generic parameter `param` of `tdecl` as the
# template sees its singleton type: the parameter's own GENERIC_PARAM type, a
# typedef over `bound` with no value yet, so the template's walk forwards the
# bound's members to it and passes it where the bound is expected.
abstractSingletonOf: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tdecl: ztypes.declid
    param: zast.nameid
    bound: ztypes.tid
} out ztypes.tid is {
    gp: declare.genericParamTidMint :st :ast :tdecl nameId: param
    if (st.typing.isSingletonType tid: gp) then return gp
    bn: st.reg.nameOf tid: bound
    bnId: zast.poolFind pool: ast.names text: bn.stringView
    st.typing.typedefBase.set key: gp value: (ztyping.typedefbase name: bnId tid: bound)
    (
        st.typing.singletons.set
        key: gp
        value: (ztyping.singleton instance: ztypes.tid :param value: ztypes.noConst)
    )
    return gp
}

# recordNumericDefaults -- each field of `ownerTid`, an instance of
# `templateId`, that the template declares by a numeric generic parameter
# (`stored: cap`, singletonFieldType) is of the instance's singleton type, and
# defaults to its one value (recordSingletonDefault).
recordNumericDefaults: function {
    st: zenv.ZSymbolTable
    ownerTid: ztypes.tid
    templateId: ztypes.tid
} is {
    if st.typing.singletonAt.length == 0 then return
    slots: st.typing.declRowSlots ownerTid: templateId
    si: u64
    for si < slots loop {
        row: st.typing.declRowAt ownerTid: templateId membersOnly: true slot: si
        si = si + 1
        if row.keep then recordSingletonDefault :st :ownerTid nameId: row.name
    }
}

# recordSingletonDefault -- field `nameId` of `ownerTid`, when it is of a numeric
# generic parameter's singleton type with a value -- an instance's -- defaults
# to that value, which every construction writes: the field takes no argument.
recordSingletonDefault: function {
    st: zenv.ZSymbolTable
    ownerTid: ztypes.tid
    nameId: zast.nameid
} is {
    ft: (st.typing.declChildOfId parentTypeId: ownerTid :nameId).or d: ztypes.tid
    v: st.typing.singletonValueOf tid: ft
    if v.kind.none then return
    md: st.typing.declMemberIdOf parentTypeId: ownerTid :nameId
    if md.isZero then return
    st.typing.setMemberConst parentTypeId: ownerTid :nameId value: v
    st.typing.declSetDefaultId parentTypeId: ownerTid :nameId value: ztyping.defaultval.constant md
}

# armCarriesPayload -- the arm a field defaults to carries a payload, so
# it cannot BE the default.
#
# A constant naming an arm is `armKind`, and that cval holds `armTid` and
# `armName` and nothing else -- there is no slot for what the arm carries. So a
# constant can say WHICH arm and never what is in it, which is exactly why bool
# works: its arms carry nothing, and the discriminator IS the whole value. The
# same is true of any discriminator-only arm, including a payload-less arm of a
# sum whose other arms do carry things.
#
# Nothing checked. `n: V.a` with `a: i64` defaulted the field to arm `a` over a
# zero payload, and `n: U.a` with `a: String` defaulted it to a String that was
# never constructed -- reading it SEGFAULTS.
armCarriesPayload: function {
    # where the arm's own declaration is read
    st: zenv.ZSymbolTable.view
    # the sum the arm belongs to
    armTid: ztypes.tid
    # the arm's name
    armName: zast.nameid
} out bool is {
    ad: st.typing.declMemberIdOf parentTypeId: armTid nameId: armName
    if ad.isZero then return false
    at: st.typing.declTypeOf declId: ad
    if at.isZero then return false
    return (st.reg.typetypeOf typeId: at) != ztypes.ztypetype.nullType
}

# refuseArmDefaultPayload -- report the arm-default above, and answer whether it
# was refused so the caller records nothing.
refuseArmDefaultPayload: function {
    # where the refusal and the default are both recorded
    st: zenv.ZSymbolTable
    # the tree the declared name is read from
    ast: Ast.view
    # what was declared, for the message: `field` or `parameter`
    what: StringView
    # the name the default was written on
    fname: StringView
    # the declaration, for the position
    fm: argref
    # the sum whose arm was named
    armTid: ztypes.tid
    # the arm the default named
    armName: zast.nameid
} out bool is {
    if (armCarriesPayload :st :armTid :armName).not then return false
    an: zast.nameTextAt :ast ref: armName
    ma: "\{what} '\{fname}' defaults to arm '\{an}', which carries a payload -- a default names an arm, and cannot supply what the arm holds"
    ha: "default to an arm that carries nothing, or drop the default and pass the value in".string
    na: String
    (
        addErrorWithHint
        :st
        nodeid: fm.nid
        lineno: fm.lineno
        colno: fm.colno
        e: zast.err.typeError
        msg: ma
        note: na
        hint: ha
        width: 1
    )
    return true
}

# recordArmDefault -- record that a member defaults to an ARM, once the arm is
# known, and refuse it when that arm carries a payload. The dotted spelling
# reads the pair off the path and the bare one reads it off the folded cval;
# from here down they are one declaration, which is what keeps the refusal and
# the stamp from drifting apart.
recordArmDefault: function {
    # the tables the stamp and any refusal land in
    st: zenv.ZSymbolTable
    # the tree the member's name is read from
    ast: Ast.view
    # the noun the refusal reports under: `field` or `parameter`
    what: StringView
    # the owning type's id: the class's, or the function's
    ownerTid: ztypes.tid
    # the member's own name
    nameId: zast.nameid
    # that name as text, for the message
    fname: StringView
    # the member's declaration, for the position
    dm: argref
    # the sum whose arm was named
    armTid: ztypes.tid
    # the arm named, within that sum
    armName: zast.nameid
} is {
    if (refuseArmDefaultPayload :st :ast :what :fname fm: dm :armTid :armName) then return
    avDecl: st.typing.declMemberIdOf parentTypeId: armTid nameId: armName
    st.typing.declSetDefaultId parentTypeId: ownerTid :nameId value: ztyping.defaultval.arm avDecl
}

# declaredByValue -- a field or parameter declaration whose value may fold and so
# declare the member's type (valueDeclares), or a path naming a type's constant.
declaredByValue: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    ownerTid: ztypes.tid
    node: zast.nodeid
} out bool is {
    if (valueDeclares :ast :node) then return true
    return (pathNamesTypeConstant :st :ast :ownerTid :node)
}

# armDefaultLeaf -- the arm a dotted member declaration defaults to, or 0 when
# the path names a type: an ownership marker (`Bag.borrow`), a type constant,
# or the member a unit-qualified ref names (`math.BigInt`, `shade.hue`). A path
# from a unit is an arm only past the type, its leaf an arm of the slot's sum
# (`math.roundingmode.toZero`).
armDefaultLeaf: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast.view
    # the declaration's dotted path
    node: zast.nodeid
    # the type, function or record the member belongs to
    ownerTid: ztypes.tid
    # the type the path resolved to: the sum, when the leaf is its arm
    slotTid: ztypes.tid
} out zast.nameid is {
    none: zast.nameid.zero
    n: ast.nodes.get i: node
    leaf: dottedChildNameId :ast :n
    if leaf.isZero or (isStripMarkerId nameId: leaf) then return none
    if (pathNamesTypeConstant :st :ast :ownerTid :node) then return none
    if (rootNamesAnyUnit :st :scope nameId: (rootNameIdOf :ast :n)) then {
        pathParent: zast.nodeid
        match n case dottedpath then pathParent = n.parent else null
        if (ast.nodes.get i: pathParent).dottedpath.not then return none
        if (st.reg.typetypeOf typeId: slotTid).isSum.not then return none
    }
    if (st.typing.declMemberIdOf parentTypeId: slotTid nameId: leaf).isZero then return none
    return leaf
}

# pathNamesTypeConstant -- a path in declaration position that names an `as`
# constant of a type, a constant of a unit (`n: cfg.LIMIT`, `n: ids.did.zero`,
# `n: zast.nodeid.zero`) or an element of a list (`v: verbs.run`): a value,
# where any other path there is a type. The
# qualifier is followed through units and aliases (`did: ids.did`, then
# `n: did.zero`), as a read of the same path in an expression is. Read off the
# declarations, so nothing resolves to answer.
pathNamesTypeConstant: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    ownerTid: ztypes.tid
    node: zast.nodeid
} out bool is {
    leafId: zast.nameid
    qualNid: zast.nodeid
    n: ast.nodes.get i: node
    if n.dottedpath then {
        leafId = zast.atomNameIdOf n: (ast.nodes.get i: n.child)
        qualNid = n.parent
    }
    if leafId.isZero then return false
    td: (
        conform.qualifierDecl
        :st
        :ast
        ownerDecl: (st.typing.declIdOfType typeId: ownerTid)
        node: qualNid
    )
    if td.notZero when (st.typing.decls.get i: td).kind.unitDecl then {
        return (unitMemberHoldsValue :st :ast unitDecl: td nameId: leafId)
    }
    # an element of a list, or its length
    if td.notZero when (st.typing.decls.get i: td).kind.staticListDecl then return true
    if (declIsType :st declId: td).not then return false
    md: st.typing.declFindChild parentDeclId: td nameId: leafId
    if md.isZero then return false
    mdNode: (st.typing.decls.get i: md).node
    return (typeMemberHoldsConstant :st :ast typeDecl: td defNode: mdNode)
}

# valueStampsTyperef -- whether a field declaration's value is stamped as a
# type-ref: when nothing folded, unless its root is a numeric generic parameter
# of the owner or of a definition enclosing it (`stored: cap.hold`), which the
# scope the ref waits in does not see; when a value folded, only for a bare
# name the enclosing scopes declare (`p: false`, `n: LIMIT`, `x: 0.0`), which
# navigation reads. An expression names nothing, and a name the type's own
# scope declares (`n: CAP`) is no type the drain could resolve.
valueStampsTyperef: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    ownerTid: ztypes.tid
    folded: ztypes.tid
    node: zast.nodeid
} out bool is {
    if folded.isZero then {
        rootId: rootNameIdOf :ast n: (ast.nodes.get i: node)
        ownerDecl: st.typing.declIdOfType typeId: ownerTid
        return (numericParamOwnerFrom :st scope: ownerDecl nameId: rootId).isZero
    }
    vnId: zast.atomNameIdOf n: (ast.nodes.get i: node)
    if vnId.isZero then return false
    own: st.typing.declIdOfType typeId: ownerTid
    return (st.typing.declFindChild parentDeclId: own nameId: vnId).isZero
}

# valueDeclares -- a field or parameter declaration whose value, when it folds,
# declares the member's type: a bare name (`n: LIMIT`, `p: false`), a string
# (`s: "x"`), an operator (`n: 2 * 3`) or a compile-time `if` or `match`. A path is a TYPE in declaration position
# (`zast.astnode.view`), and its value forms -- a suffixed literal,
# an arm -- have paths of their own.
valueDeclares: function {ast: Ast.view node: zast.nodeid} out bool is {
    n: ast.nodes.get i: node
    if (zast.atomNameIdOf :n).notZero then return true
    if n.atomstring or n.ifexpr or n.caseexpr or n.listblock then return true
    if (convertsExpression :ast :node) then return true
    return (operatorPartsAt :ast nid: node).found
}

# convertsExpression -- the declaration's value is a conversion written on an
# OPERATOR EXPRESSION, `(0 - 7).i64`, on a compile-time `if` or `match`, or on a
# string literal, `"x".text`: a value, whose base names no type the way `4.u64`,
# `zast.nodeid` and a type application's `(List t: u8).view` do.
convertsExpression: function {ast: Ast.view node: zast.nodeid} out bool is {
    n: ast.nodes.get i: node
    match (
        n
    ) case dottedpath then {
        pn: ast.nodes.get i: n.parent
        if pn.atomstring or pn.ifexpr or pn.caseexpr then return true
        return (operatorPartsAt :ast nid: n.parent).found
    } else {
        return false
    }
}

# refuseUnfoldedConversion -- a member declared by a conversion of an
# expression that did not fold. A default is a compile-time constant, and the
# path names no type, so nothing else declares the member: without this its
# value's text was minted into a type of its own. True when it reported.
refuseUnfoldedConversion: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    # the noun to report under: `field` or `parameter`
    what: StringView
    dm: argref
} out bool is {
    if (convertsExpression :ast node: dm.operation).not then return false
    fname: zast.nameTextAt :ast ref: dm.name
    (
        addErrorWithHint
        :st
        nodeid: dm.nid
        lineno: dm.lineno
        colno: dm.colno
        e: zast.err.typeError
        msg: "\{what} '\{fname}' is declared by a conversion of a value with no compile-time value -- a default must be a compile-time constant"
        note: "".string
        hint: "name the type instead (`\{fname}: i64`) and pass the value in, or convert a constant"
        width: fname.length
    )
    return true
}

# recordFoldedDefault -- record the default a declaration's folded value
# is, when that value is a compile-time SCALAR written as a name or an
# expression (`n: LIMIT`, `n: 2 * 3`, `n: CAP + 1`), a string that folds (a
# literal, a unit string constant, a list element): a StringView of static
# memory, re-emitted at every call and construction as its `_zcsN`, or a static
# list (`tags: list { "core" }`), passed as the view of its array. A literal
# number and an arm keep their own kinds of default.
recordFoldedDefault: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    # the owner the member hangs off
    ownerTid: ztypes.tid
    # the member's declaration
    dm: argref
} is {
    rootName: rootNameIdOf :ast n: (ast.nodes.get i: dm.operation)
    if (isNumericLiteralNameAt :ast ref: rootName) then return
    fdc: st.typing.declMemberIdOf parentTypeId: ownerTid nameId: dm.name
    cv: constValueOfDecl :st declId: fdc
    isList: false
    if cv.kind.aggKind then isList = (st.typing.constAggs.get i: cv.aggId.u64).kind.staticList
    if cv.kind.ivalKind or cv.kind.fvalKind or cv.kind.svalKind or isList then {
        (
            st.typing.declSetDefaultId
            parentTypeId: ownerTid
            nameId: dm.name
            value: ztyping.defaultval.constant fdc
        )
    }
    # a call that leaves the member out reads the list at run time; the
    # emitter writes it only where C spells it
    if isList then markAggReached :ast :st id: cv.aggId at: dm.nid
    # a data value types the member but is no default: it would be dropped, and
    # each use would then be told the member is required
    if cv.kind.aggKind when isList.not then {
        nm: zast.nameTextCopy :ast ref: dm.name
        (
            addError
            :st
            nodeid: dm.nid
            lineno: dm.lineno
            colno: dm.colno
            e: zast.err.typeError
            msg: "'\{nm}' defaults to a data value: a default is a number, a string, a static list, an arm or a function"
        )
    }
}

# recordFoldedArmDefault -- record the default a declaration's folded value
# names, when that value is an ARM constant. This is what makes `p: false` and
# `q: bool.false` one declaration: the same cval, so the same default.
recordFoldedArmDefault: function {
    # where the default and any diagnostic are recorded
    st: zenv.ZSymbolTable
    # the tree the declaration's name is read from
    ast: Ast.view
    # the noun to report under, passed through to the refusal
    what: StringView
    # the owner the member hangs off: a class's type id, or a function's
    ownerTid: ztypes.tid
    # the member's own name as text, for the message
    fname: StringView
    # the member's declaration, for the position
    dm: argref
} is {
    fdc: st.typing.declMemberIdOf parentTypeId: ownerTid nameId: dm.name
    cvF: constValueOfDecl :st declId: fdc
    if cvF.kind.armKind.not then return
    (
        recordArmDefault
        :st
        :ast
        :what
        :ownerTid
        nameId: dm.name
        :fname
        :dm
        armTid: cvF.armTid
        armName: cvF.armName
    )
}

# resolveNamedFieldSlot -- resolve an ordinary named field: its declared type,
# its ownership and visibility, the default it carries, and whether owning it
# gives the class a destructor. True when it does.
resolveNamedFieldSlot: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    cid: ztypes.tid
    fname: StringView
    borrowedField: bool
    fm: argref
} out bool is {
    needsDtor: false
    refuseMarkedFunctionType :st :ast :unitDecl :scope typeNid: fm.operation
    fieldOwn: declare.pathOwnership :ast n: (ast.nodes.get i: fm.operation)
    # THE VALUE DECLARES THE TYPE, when the declaration is a value. A field
    # declared by one is a constant declaration in the same sense a unit-level
    # `x: -1` is, so it takes the same door -- the fold -- and only a
    # declaration that names no constant falls through to the type-ref path.
    foldTid: foldedDeclType :st :ast ownerTid: cid dm: fm
    cidf: foldTid
    if cidf.isZero then cidf = (
        fieldSlotTid
        :st
        :ast
        :unitDecl
        :scope
        ownerTid: cid
        oId: fm.operation
        thisName: defName
    )
    if fm.name != zast.wellKnown.slot.wkResumeInput when (
        fieldTypeNeedsCleanup
        :st
        tid: cidf
        isBorrowed: borrowedField
    ) then needsDtor = true
    # `null` is no runtime value, in a class exactly as in a record: `create:
    # null` in the BODY would otherwise be a field of no type every
    # construction then demands
    if (
        refuseNullTyped
        :st
        tid: cidf
        nodeid: fm.nid
        lineno: fm.lineno
        colno: fm.colno
        what: "field"
        name: fname
    ) then return needsDtor
    st.typing.setMemberType parentTypeId: cid nameId: fm.name childTypeId: cidf
    recordSingletonDefault :st ownerTid: cid nameId: fm.name
    recordFoldedArmDefault :st :ast what: "field" ownerTid: cid :fname dm: fm
    recordFoldedDefault :st :ast ownerTid: cid dm: fm
    if (st.reg.typetypeOf typeId: cidf) == ztypes.ztypetype.functionType then {
        st.typing.setChildFnptrField pool: ast.names parentTypeId: cid name: fname
    }
    if fieldOwn.some then {
        (
            st.typing.setChildOwnership
            pool: ast.names
            parentTypeId: cid
            name: fname
            ownership: fieldOwn
        )
    }
    # an expression, or a name the type's own scope declares, is no type-ref to
    # stamp; a name the unit declares (`p: false`) still navigates as one
    stampsTyperef: valueStampsTyperef :st :ast ownerTid: cid folded: foldTid node: fm.operation
    if stampsTyperef then (
        typeref.recordTyperef
        :st
        :scope
        :ast
        :unitDecl
        thisName: ""
        nid: fm.operation
    )
    recordFieldDefault :st :ast :scope :cid :cidf :fname :fm
    return needsDtor
}

# declOfUnitDef -- the same walk for a caller that already holds the
# definition's name id: unit root, then the child edge. No key is built.
declOfUnitDef: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    if nameId.isZero then return ztypes.declid.zero
    # A definition is looked up in the scope it is WRITTEN in: `scope`'s
    # unit scope when it lies inside `unitDecl` (a nested unit's member is a
    # child of that unit), each enclosing unit scope outward, the unit's root
    # -- and no further: this names a DEFINITION of the unit, not a
    # reference, so the prelude is not consulted.
    cur: typeargs.scopeFor typing: st.typing :scope :unitDecl
    for cur.notZero loop {
        if cur == st.typing.coreUnitRoot then return ztypes.declid.zero
        nd: st.typing.declFindChild parentDeclId: cur :nameId
        if nd.notZero then return nd
        # a definition the unit's `public:` block makes -- the block's
        # contents are the unit's surface, spelled `unit.name` from outside
        pb: st.typing.declPublicNsOf owner: cur
        if pb.notZero then {
            pd: st.typing.declFindChild parentDeclId: pb :nameId
            if pd.notZero then return pd
        }
        cur = resolve.unitScopeOf typing: st.typing declId: (st.typing.declParentOf declId: cur)
    }
    return ztypes.declid.zero
}

# aliasNamesType -- the alias denotes a TYPE, not a value. A bare alias always
# does (`Same: Holder`); a dotted one does when its parent names a UNIT
# (`astnode: zast.astnode`) rather than a type, because a TYPE parent means the child
# is one arm and the alias denotes a VALUE of it (`false: bool.false`). This is
# the same split that decides how the alias registers.
aliasNamesType: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    if declId.isZero then return false
    if (resolve.aliasIsBareForm :st :ast :declId) then return true
    # a path to an instance's numeric generic parameter (`X: B5.cap`) names its
    # singleton type (singletonPathAlias)
    if (st.typing.isSingletonType tid: (st.typing.declTypeOf :declId)) then return true
    ndo: st.typing.decls.get i: declId
    if ndo.kind.reexportDecl then {
        nnp: ast.nodes.get i: ndo.node
        if nnp.namedoperation then {
            nvn: ast.nodes.get i: nnp.operation
            ntk: resolve.dottedDefTargetIds :ast n: nvn
            # a unit of any kind qualifies it, a nested one as a file one does,
            # seen from where the alias is written, not from where it is read
            if ntk.unitName.notZero then return (
                rootNamesAnyUnit
                :st
                scope: ndo.parent
                nameId: ntk.unitName
            )
            # a member reached through a path of units (`T: u.sub.duo`): the
            # qualifier names a unit as a bare one does
            if (qualifierIsUnitPath :st :ast scope: ndo.parent valueNid: nnp.operation) then {
                return true
            }
            # a member of a unit applied in place (`(cells t: i64).Cell`): what
            # it resolved to says whether it is a type
            if (valueAppliesUnitTemplate :st :ast scope: st.curScope valueNid: nnp.operation) then {
                return (isNamedTypeFamily :st tid: (st.typing.declTypeOf :declId))
            }
        }
    }
    return false
}

# qualifierIsUnitPath -- the definition value `valueNid` is `<path>.<name>` with
# a qualifier that is itself a path and names a unit (`u.sub` in `u.sub.duo`)
qualifierIsUnitPath: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    scope: ztypes.declid
    valueNid: zast.nodeid
} out bool is {
    vn: ast.nodes.get i: valueNid
    if vn.dottedpath.not then return false
    if (ast.nodes.get i: vn.parent).dottedpath.not then return false
    return (unitDeclOfPath :st :scope :ast nid: vn.parent).notZero
}

# valueAppliesUnitTemplate -- the definition value `valueNid` is a member of a
# generic UNIT applied in place (`(cells t: i64).Cell`): a dotted path whose
# qualifier is a call naming a unit template, looked up as the instantiation
# collector looks one up.
valueAppliesUnitTemplate: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    scope: ztypes.declid
    valueNid: zast.nodeid
} out bool is {
    callableNid: zast.nodeid
    {
        vn: ast.nodes.get i: valueNid
        if vn.dottedpath then {
            pn: ast.nodes.get i: vn.parent
            match (
                pn
            ) case call then {
                callableNid = pn.callable
            } else null
        }
    }
    if callableNid.isZero then return false
    segs: ListVal zast.nameid
    instCallablePath :ast op: (ast.nodes.get i: callableNid) :segs
    td: (
        instTemplateDecl
        :st
        scopeDeclId: (resolve.unitScopeOf typing: st.typing declId: scope)
        :segs
    )
    if td.isZero then return false
    return (st.typing.decls.get i: td).kind.unitDecl
}

# isNamedTypeFamily -- `tid` is a type a definition names (a record, class,
# variant, union, protocol or facet), not a function or a value's type.
isNamedTypeFamily: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    tt: st.reg.typetypeOf typeId: tid
    return tt.isUserFamily
}

# unitNestedCopyNamed -- `tid` is an instance of a type a generic unit declares,
# and `nameId` is that type's name.
unitNestedCopyNamed: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    tid: ztypes.tid
    nameId: zast.nameid
} out bool is {
    og: st.reg.genericOriginOf :tid
    if og.isZero then return false
    td: st.typing.declIdOfType typeId: og
    if td.isZero then return false
    if ((st.typing.declNameOf declId: td) == nameId).not then return false
    return (declIsUnitTemplate :st :ast declId: (st.typing.declParentOf declId: td))
}

# preludeAliasNamesType -- whether core aliases the name `nameId` to type `tid`
# (`List: collections.ListRef`), asked by id. A core definition carrying a
# compile-time value is a VALUE alias (`false: bool.false`) and names no type.
preludeAliasNamesType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    nameId: zast.nameid
    tid: ztypes.tid
} out bool is {
    core: st.typing.coreUnitRoot
    if core.isZero then return false
    cd: st.typing.declFindChild parentDeclId: core :nameId
    if cd.isZero then return false
    if (aliasNamesType :st :ast declId: cd).not then return false
    if (
        ((walkLookupTyperefFrom :st :ast scope: ztypes.declid baseId: nameId).or d: ztypes.tid.zero
        ) !=
        tid
    ) then return false
    ecv: constValueOfMemberId :st scope: core :ast unitDecl: core :nameId
    constFailClear :st
    return ecv.kind.none
}

# bareNameDenotesType -- the name spelled at a site denotes the TYPE `tid`
# rather than a value of it, so a bare occurrence in value position is the
# zero-argument construction. The registry name answers directly when the
# definition IS the type. A RENAMING alias does not carry that name, so the
# alias's own shape answers instead: the prelude's alias (core's `List` names
# `ListRef`), a bare or dotted alias, or a definition whose value INSTANTIATES a generic
# template (`Strs: (List String)`), which declares itself when it is first
# read. A definition carrying a compile-time value is a VALUE alias
# (`true: bool.true`) and overrules every alias shape.
bareNameDenotesType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nameId: zast.nameid
    tid: ztypes.tid
} out bool is {
    if nameId.isZero then return false
    # an alias of a type enclosing the site names its target
    if tid.notZero when (enclosingAsAliasTid :st :ast :scope :nameId) == tid then return true
    aad: declOfUnitDef :st :unitDecl :scope :nameId
    # a constant names a value, whatever its type is called: `foundation:
    # (c.foundation n: 3)` is a value of the type `foundation`. A constant
    # whose value instantiates a template names that instance, a type.
    if aad.notZero when (st.typing.decls.get i: aad).kind.constDecl when (
        instantiatedAliasFold
        :ast
        :st
        declId: aad
    ).not then return false
    # the spelled name against the registry name, both read through views
    # scoped to this block: the alias walk below lends ast and the table
    named: false
    {
        tnq: st.reg.nameViewOf :tid
        ndNm: zast.nameTextAt :ast ref: nameId
        named = tnq == ndNm
    }
    if named then return true
    if (preludeAliasNamesType :st :ast :nameId :tid) then return true
    # a unit instance's copy of a type its generic unit declares is named as
    # the type is
    if (unitNestedCopyNamed :st :ast :tid :nameId) then return true
    if aad.isZero then return false
    isAl: aliasNamesType :st :ast declId: aad
    if isAl.not when (instantiatedAliasFold :ast :st declId: aad) then isAl = true
    if isAl.not then return false
    # Asked LAST, not first: the answer only matters once an alias shape said
    # yes, and a pull in front of it runs the evaluator for every bare atom in
    # every body. `ECHO: LIB` names a string constant whose own type is
    # StringView, so the alias test sees a decl carrying a type -- and a bare
    # StringView is an unconstructible view.
    ecv: constValueOfMemberId :st :scope :ast :unitDecl :nameId
    constFailClear :st
    return ecv.kind.none
}

# singletonPathAlias -- the singleton type the value of the unit-level definition
# `declId` names when it is a path to an instance's numeric generic parameter
# (`B5.cap`, `(Box cap: 5).cap`, `w3.n`; numericParamTyperef); 0 for any other
# value.
singletonPathAlias: function {
    st: zenv.ZSymbolTable
    ast: Ast
    declId: ztypes.declid
    scope: ztypes.declid
} out ztypes.tid is {
    op: declOperationOf :st :ast :declId
    if op.isZero then return ztypes.tid
    parentId: zast.nodeid
    leafId: zast.nameid
    {
        n: ast.nodes.get i: op
        if n.dottedpath then {
            parentId = n.parent
            leafId = atomNameId :ast n: (ast.nodes.get i: n.child)
        }
    }
    if parentId.isZero or leafId.isZero then return ztypes.tid
    # only an application, or a name defined as one, names an instance
    pnm: zast.nameid
    isApp: false
    {
        pn: ast.nodes.get i: parentId
        isApp = pn.call
        pnm = zast.atomNameIdOf n: pn
    }
    if isApp.not when pnm.isZero or (qualifierValueIsCall :st :ast :scope nameId: pnm).not then {
        return ztypes.tid
    }
    t: (
        typeref.numericParamTyperef
        :st
        :scope
        :ast
        unitDecl: (unitRootOfDecl typing: st.typing declId: scope)
        nid: op
        :parentId
        :leafId
        thisName: ""
    )
    if (st.typing.isSingletonType tid: t).not then return ztypes.tid
    return t
}

# resolveDeepAlias -- a unit-level alias whose target is reached through a path
# of units (`T: u.sub.duo`, `X: z.build.oskind`). The target pair carries only
# the qualifier's last segment, which names no file unit when it is a subunit,
# so the qualifier is resolved unit by unit (unitDeclOfPath) and the member
# looked up in the unit it names, and recorded as any alias is. A member that
# unit does not declare is the body's error, at the definition; so is a member
# a TYPE so reached does not declare (`u.sub.duo.nosuch`), its arms having
# folded already. 0 when the value is not that shape or names nothing.
resolveDeepAlias: function {
    st: zenv.ZSymbolTable
    ast: Ast
    scope: ztypes.declid
    declId: ztypes.declid
} out ztypes.tid is {
    ar: argRefAt :ast nid: (st.typing.decls.get i: declId).node
    if ar.operation.isZero then return ztypes.tid.zero
    v: ast.nodes.get i: ar.operation
    if v.dottedpath.not then return ztypes.tid.zero
    qn: ast.nodes.get i: v.parent
    if qn.dottedpath.not then return ztypes.tid.zero
    cn: atomNameId :ast n: (ast.nodes.get i: v.child)
    qcn: atomNameId :ast n: (ast.nodes.get i: qn.child)
    if cn.isZero or qcn.isZero then return ztypes.tid.zero
    pu: unitDeclOfPath :st :scope :ast nid: v.parent
    if pu.isZero then {
        reportDeepTypeMember :st :scope :ast :declId unitPath: qn.parent typeId: qcn memberId: cn
        return ztypes.tid.zero
    }
    own: qualifiedMemberScope :st unitRoot: pu memberId: cn
    if (st.typing.declFindChild parentDeclId: own nameId: cn).isZero then {
        reportDeepAliasMissing :st :ast :declId what: "unit" ownerId: qcn memberId: cn ownerUnit: pu
        return ztypes.tid.zero
    }
    atid: resolve.descendNamedId :st :scope :ast unitDecl: pu nameId: cn
    if atid.isZero then return ztypes.tid.zero
    ownTid: st.typing.declTypeOf declId: (st.typing.declParentOf :declId)
    if ownTid.notZero then {
        (
            st.typing.setMemberType
            parentTypeId: ownTid
            nameId: (st.typing.declNameOf :declId)
            childTypeId: atid
        )
    }
    st.typing.declSetType :declId typeId: atid
    return atid
}

# reportDeepTypeMember -- `u.sub.duo.nosuch`: the qualifier is a TYPE reached
# through units, and the member is no member of it. Silent when the type does
# not resolve either, or the member exists (a payload arm is refused where its
# value is read).
reportDeepTypeMember: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    declId: ztypes.declid
    # the units before the type (`u.sub`)
    unitPath: zast.nodeid
    # the type's name
    typeId: zast.nameid
    # the member asked of it
    memberId: zast.nameid
} is {
    tu: unitDeclOfPath :st :scope :ast nid: unitPath
    if tu.isZero then return
    # a list's element or count
    lr: listDeclRow :ast :st declId: (st.typing.declFindChild parentDeclId: tu nameId: typeId)
    if lr != 0 then {
        if (listMemberType :st :ast row: lr nameId: memberId).notZero then return
        (
            reportDeepAliasMissing
            :st
            :ast
            :declId
            what: "list"
            ownerId: typeId
            :memberId
            ownerUnit: ztypes.declid
        )
        return
    }
    ptid: resolve.descendNamedId :st :scope :ast unitDecl: tu nameId: typeId
    if ptid.isZero then return
    if (st.typing.declChildOfId parentTypeId: ptid nameId: memberId).some then return
    if (typeref.leafNamesNoMember leafId: memberId) then return
    (
        reportDeepAliasMissing
        :st
        :ast
        :declId
        what: "type"
        ownerId: typeId
        :memberId
        ownerUnit: ztypes.declid
    )
}

# reportDeepAliasMissing -- the alias `declId` names a member its owner (a unit
# or a type, `what`) does not declare: the body's E0100, at the definition
reportDeepAliasMissing: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    declId: ztypes.declid
    what: StringView
    ownerId: zast.nameid
    memberId: zast.nameid
    # the unit the owner resolved to, 0 for a type owner
    ownerUnit: ztypes.declid
} is {
    owner: zast.nameTextAt :ast ref: ownerId
    member: zast.nameTextAt :ast ref: memberId
    at: aliasValueSite :st :ast adecl: declId
    (
        addErrorWithHint
        :st
        nodeid: at.nid
        lineno: at.lineno
        colno: at.colno
        e: zast.err.typeError
        msg: "\{what} '\{owner}' has no member '\{member}'"
        note: (resolve.unitFileNote :st :ast unitDecl: ownerUnit)
        hint: "".string
        width: owner.length
    )
}

# constValueOfDecl -- the value a declaration folded to, addressed by the
# declaration alone; `noConst` when it folded to none. The memo constFoldDecl
# fills is keyed on (owner type, name), which is what this reduces to.
constValueOfDecl: function {
    # where the memo lives
    st: zenv.ZSymbolTable.view
    # the declaration whose folded value is wanted
    declId: ztypes.declid
} out ztypes.cval is {
    if declId.isZero then return ztypes.noConst
    own: st.typing.declParentOf :declId
    if own.isZero then return ztypes.noConst
    nm: st.typing.declNameOf :declId
    if nm.isZero then return ztypes.noConst
    ot: st.typing.declTypeOf declId: own
    if ot.isZero then return ztypes.noConst
    k: st.typing.memberConstKey parentTypeId: ot nameId: nm
    r: st.typing.memberConst.get key: k
    match (
        r
    ) case some then {
        return r
    } case none then {
        return ztypes.noConst
    }
}

# aliasValueSite -- where a unit-level definition's VALUE is written, which is
# what a report about its target points at: the node, its line and its column.
aliasValueSite: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    adecl: ztypes.declid
} out argref is {
    ar: argRefAt :ast nid: (st.typing.decls.get i: adecl).node
    if ar.operation.isZero then return ar
    vn: ast.nodes.get i: ar.operation
    return (
        argref
        nid: ar.operation
        name: ar.name
        operation: ar.operation
        lineno: (nodeLine n: vn)
        colno: (nodeCol n: vn)
    )
}

# reportUnknownBareAliasTarget -- a bare alias (`X: Nope`) whose target names
# nothing in any scope: the body's E0023 for the same name, at the definition.
# True when it reported.
reportUnknownBareAliasTarget: function {
    st: zenv.ZSymbolTable
    ast: Ast
    adecl: ztypes.declid
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out bool is {
    # a name the alias's own scope declares -- a generic unit's parameter, a
    # namespace's sibling -- is claimed wherever the resolution was asked from
    adp: st.typing.declParentOf declId: adecl
    if (nameDeclaredOutward :st from: adp :nameId) then return false
    unknown: unresolvedBareName :ast :st :unitDecl :nameId
    if unknown.length == 0 then return false
    at: aliasValueSite :st :ast :adecl
    st.typing.refusedValues.add item: at.nid
    (
        addErrorWithHint
        :st
        nodeid: at.nid
        lineno: at.lineno
        colno: at.colno
        e: zast.err.badReference
        msg: "Unknown reference '\{unknown}'"
        note: "".string
        hint: "".string
        width: unknown.length
    )
    return true
}


# owningUnitDecl -- the unit a declaration is written in: the nearest
# enclosing unit-kind Decl, or the declaration itself when it is one. Not the
# file root -- a subunit is reached on its own, and reaching `quadfloat` is
# not reaching `system`.
owningUnitDecl: function {st: zenv.ZSymbolTable.view declId: ztypes.declid} out ztypes.declid is {
    cur: declId
    for cur.notZero loop {
        decl: st.typing.decls.get i: cur
        if decl.kind.unitDecl then return cur
        cur = decl.parent
    }
    return ztypes.declid.zero
}

# instCallablePath -- an instantiation callable's name path as pool ids,
# outermost first: `mathops` -> [mathops], `helperu.mathops` -> [helperu,
# mathops]. A segment that is not a plain name appends 0, which
# instTemplateDecl then rejects -- there is no name to look up.
instCallablePath: function {ast: Ast.view op: astnode.view segs: ListVal zast.nameid} is {
    match (
        op
    ) case dottedpath then {
        instCallablePath :ast op: (ast.nodes.get i: op.parent) :segs
        segs.append (atomNameId :ast n: (ast.nodes.get i: op.child))
    } case atomid then {
        segs.append op.name
    } else {
        segs.append zast.nameid.zero
    }
}

# callableInstPath -- the path of a binding whose value is a call. Empty for anything else, which is what says a
# binding is not an instantiation. The whole path, not a single atom name: a
# dotted callable names another unit's template.
callableInstPath: function {ast: Ast.view op: astnode.view segs: ListVal zast.nameid} is {
    match (
        op
    ) case call then {
        instCallablePath :ast op: (ast.nodes.get i: op.callable) :segs
    } else null
}


# unitRootOfDecl -- the top-level unit root a declaration sits under: the
# parent chain to the program root's own child. A definition of a NESTED unit
# answers with the file unit that loaded it, which is the unit the name walkers
# and the diagnostics are keyed on.
unitRootOfDecl: function {typing: ztyping.ZTyping.view declId: ztypes.declid} out ztypes.declid is {
    cur: declId
    for cur.notZero loop {
        par: ztypes.declid
        decl: typing.decls.get i: cur
        par = decl.parent
        if (resolve.declAtProgramTop :typing parentDeclId: par) then return cur
        cur = par
    }
    return ztypes.declid.zero
}

# declInScope -- the declaration `nameId` names from `scopeDeclId`: the nearest
# scope up the chain that declares it, else a file unit of that name; zero for
# none.
declInScope: function {
    st: zenv.ZSymbolTable.view
    scopeDeclId: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    probe: scopeDeclId
    for probe.notZero loop {
        c: st.typing.declFindChild parentDeclId: probe :nameId
        if c.notZero then return c
        probe = st.typing.declParentOf declId: probe
    }
    return (st.typing.declFindChild parentDeclId: st.typing.programRoot :nameId)
}

# instTemplateDecl -- the DECLARATION an instantiation's callable path names,
# resolved through the scope the instantiation was WRITTEN in: this namespace,
# then each enclosing one out to the unit root, then a file unit of that name.
# Nothing reaches into another unit except by naming it -- a dependency unit
# cannot see the main unit's constants or namespaces, and an instantiation is
# no different. 0 when the path names no declaration.
instTemplateDecl: function {
    st: zenv.ZSymbolTable.view
    scopeDeclId: ztypes.declid
    segs: (ListVal zast.nameid).view
} out ztypes.declid is {
    cur: ztypes.declid
    if segs.length == 0 then return cur
    s0v: segs.get i: 0
    if s0v.isZero then return cur
    cur = declInScope :st :scopeDeclId nameId: s0v
    if cur.isZero then return cur
    si: u64
    si = 1
    for si < segs.length loop {
        sv: segs.get i: si
        if sv.isZero then return ztypes.declid.zero
        cur = st.typing.declFindChild parentDeclId: cur nameId: sv
        if cur.isZero then return cur
        si = si + 1
    }
    return cur
}

# instTemplateOpOf -- the unitdef node a template declaration introduces, and 0
# when the declaration is not a generic unit at all. Both spellings count: an
# inline `unit {...}` parses as `template`, and a generic FILE unit's root
# keeps its own kind but declares a generic parameter.
instTemplateOpOf: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out zast.nodeid is {
    none: zast.nodeid
    if declId.isZero then return none
    dn: zast.nodeid
    decl: st.typing.decls.get i: declId
    dn = decl.node
    if dn.isZero then return none
    opNode: zast.nodeid
    nop: ast.nodes.get i: dn
    if nop.namedoperation then opNode = nop.operation
    if opNode.isZero then return none
    if (zast.unitOpKindIs :ast opId: opNode k: zast.unitkind.template) then return opNode
    udn: resolve.unitdefNodeId :ast nId: opNode
    if udn.isZero then return none
    if (zast.unitIsGeneric :ast unitId: udn) then return opNode
    return none
}


# InstReq -- one generic-unit instantiation binding (intmath: (mathops t: i64)):
# the names the mint needs plus the binding's node ids for the instantiation stamps.
InstReq: class {
    # the unit the instantiation was WRITTEN in. Every lookup a request drives
    # -- the template, the type arguments, the binding name -- is relative to
    # it, and reading them off the main unit is why a generic unit worked only
    # there.
    declUnit: ztypes.declid
    # the binding that named it
    bindId: zast.nameid
    # the template's node
    tmplId: zast.nameid
    # the template's own id, the unitdef node that declares it, and the unit
    # whose AST that node lives in -- all resolved at COLLECTION, through the
    # scope the instantiation was written in. A name reached only a top-level
    # binding of the instantiating unit; an id reaches a dotted or
    # namespace-nested template too.
    tmplTid: ztypes.tid
    # the template's declaration
    tmplDeclId: ztypes.declid
    # the template's operation node
    tmplOpId: zast.nodeid
    # the unit the template was declared in, which is the scope its body
    # resolves in and NOT the caller's
    tmplUnit: ztypes.declid
    # the Decl the instantiation was written under: the unit root, or the
    # namespace when it is nested. Where the binding's own name belongs.
    scopeDeclId: ztypes.declid
    # the type arguments' labels, in order
    argLabels: ListVal zast.nameid
    # their spellings
    argNames: List String
    # the argument atoms' own nodes, 0 for an argument that is no bare atom
    argAtomIds: ListVal zast.nodeid
    # every argument's operation node, whatever its shape: a bare atom names
    # its type (argNames); a call-shaped argument -- itself a specialisation,
    # `(Box t: i64)` -- has no name and resolves from this node
    argNodeIds: ListVal zast.nodeid
    # the call node that requested the instantiation
    callId: zast.nodeid
    # that call's callable, which is the template being named
    calId: zast.nodeid
}

# instFillIds -- record the instantiation's expression/call/callable/arg node
# ids on the request; all four stamp at binding resolution.
instFillIds: function {ast: Ast.view r: InstReq op: astnode.view} is {
    match (
        op
    ) case call then {
        r.callId = op.nodeid
        instFillCallable :r op: (ast.nodes.get i: op.callable)
    } else null
}

# fill an instantiation request's callable from operation `op`.
instFillCallable: function {r: InstReq op: astnode.view} is {
    match (
        op
    ) case atomid then {
        r.calId = op.nodeid
    } case dottedpath then {
        r.calId = op.nodeid
    } else null
}

# the atom id of an instantiation-call argument.
instArgAtomId: function {op: astnode.view} out zast.nodeid is {
    match (
        op
    ) case atomid then {
        return op.nodeid
    } else {
        return zast.nodeid
    }
}

# fillUnitArgs -- capture every instantiation argument (param label + type/value
# name + atom id) in declaration order, so a unit monomorphises over ALL its
# generic parameters, not just the first.
fillUnitArgs: function {ast: Ast.view r: InstReq op: astnode.view} is {
    match (
        op
    ) case call then {
        for each argId: (zast.kidsOf :ast span: op.arguments) loop {
            a: ast.nodes.get i: argId
            if a.namedoperation then {
                anm: typeargs.atomName :ast n: (ast.nodes.get i: a.operation)
                aid: instArgAtomId op: (ast.nodes.get i: a.operation)
                r.argLabels.append a.name
                r.argNames.append anm
                r.argAtomIds.append aid
                r.argNodeIds.append a.operation
            }
        }
    } else null
}

# collectMainInstantiations -- scan a unit body for generic-unit instantiation bindings
# and append the mono name ({template}_{arg}) + template name to the parallel lists.
collectMainInstantiations: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    o: astnode.view
    unitDecl: ztypes.declid
    scopeDeclId: ztypes.declid
    reqs: List InstReq
} is {
    if o.unitdef then {
        for each bm: (zast.kidsOf :ast span: o.body) loop {
            bmNode: ast.nodes.get i: bm
            if bmNode.namedoperation then {
                mop: ast.nodes.get i: bmNode.operation
                # a namespace or subunit is a scope of its own: descend, so an
                # instantiation written one level in is collected too. A
                # template is not descended into -- it declares, it does not
                # instantiate.
                if (zast.unitOpDeclaresUnit :ast opId: bmNode.operation) then {
                    (
                        collectMainInstantiations
                        :st
                        :ast
                        o: mop
                        :unitDecl
                        scopeDeclId: (
                            st.typing.declFindChild
                            parentDeclId: scopeDeclId
                            nameId: bmNode.name
                        )
                        :reqs
                    )
                } else {
                    segs: ListVal zast.nameid
                    callableInstPath :ast op: mop :segs
                    tdecl: instTemplateDecl :st :scopeDeclId :segs
                    # a template written in a generic unit takes the unit's
                    # parameters from the instance it is reached through, so it
                    # is applied as a type is (bindInheritedParams)
                    if tdecl.notZero when (
                        declIsUnitTemplate
                        :st
                        :ast
                        declId: (st.typing.declParentOf declId: tdecl)
                    ) then continue
                    topId: instTemplateOpOf :st :ast declId: tdecl
                    tnId: zast.nameid
                    if segs.length > 0 then {
                        lastv: segs.get i: segs.length - 1
                        if lastv.notZero then tnId = lastv
                    }
                    if tnId.notZero then {
                        tuN: unitRootOfDecl typing: st.typing declId: tdecl
                        r: (
                            InstReq
                            declUnit: unitDecl
                            bindId: bmNode.name
                            tmplId: tnId
                            tmplTid: (st.typing.declTypeOf declId: tdecl)
                            tmplDeclId: tdecl
                            tmplOpId: topId
                            tmplUnit: tuN
                            :scopeDeclId
                            argLabels: ListVal zast.nameid
                            argNames: List String
                            argAtomIds: ListVal zast.nodeid
                            argNodeIds: ListVal zast.nodeid
                            callId: zast.nodeid
                            calId: zast.nodeid
                        )
                        fillUnitArgs :ast :r op: mop
                        instFillIds :ast :r op: mop
                        reqs.append r
                    }
                }
            }
        }
    }
}

# nameIdOf -- the pool id of an already-interned name. 0 (absent) is what
# every symbol-table query treats as a miss, so a name the pool never saw
# cannot resolve -- which is exactly right, since nothing declared it.
# nameIdOf -- nameIdOf widened for the u64-keyed unit-name table. A method
# on a CALL RESULT emits `&<call>`, which is not an lvalue, so the widening
# cannot ride the call site.
nameIdOf: function {ast: Ast.view name: StringView} out zast.nameid is {
    return (zast.poolFind pool: ast.names text: name)
}


# createUnitMono -- mint a mono UNIT with JOIN-only function-shell children
# from a template unit body, then seed return/never demand. Identity is the
# caller's: the trie under the template, keyed on the resolved arguments
# (unitMonoOnTrie / unitMonoJoinTrie). `monoName` is the mono's LABEL --
# display only, registered nowhere.
createUnitMono: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    monoName: StringView
    tmplDeclId: ztypes.declid
    tplTid: ztypes.tid
    templateOpId: zast.nodeid
} out ztypes.tid is {
    monoId: st.reg.newType name: monoName typetype: ztypes.ztypetype.unitType
    # the mono's declaration is the TEMPLATE's (its origin), and its members
    # hang off a clone of it -- the request resolved the template's Decl at
    # collection through the instantiation's own scope. Nothing registers the
    # label: the mono is reached through the trie, or through the binding
    # names the completion pass registers.
    mud: st.typing.declCloneType templateDeclId: tmplDeclId
    if mud.notZero then st.typing.declSetType declId: mud typeId: monoId
    if tplTid.notZero then st.reg.setGenericOrigin typeId: monoId value: tplTid
    declare.attachMonoUnitFuncs :st :ast :monoId :templateOpId
    resolve.demandReturnNever :st
    return monoId
}

# fnReturnTyperefOf -- the node of function `op`'s declared return type-ref, 0
# when it declares none.
fnReturnTyperefOf: function {op: astnode.view} out zast.nodeid is {
    match (
        op
    ) case functiondef then {
        return op.returntype
    } else {
        return zast.nodeid
    }
}

# fnReturnBaseNameIdOf -- the base type name id of function `op`'s declared
# return typeref -- the head of a form like `List X`; zero when absent. Completes
# substituted signatures whose template return was still unresolved at
# signature time.
fnReturnBaseNameIdOf: function {ast: Ast.view op: astnode.view} out zast.nameid is {
    match (
        op
    ) case functiondef then {
        if op.returntype.isZero then return zast.nameid.zero
        return (declare.baseTypeNameId :ast n: (ast.nodes.get i: op.returntype))
    } else {
        return zast.nameid.zero
    }
}

# completeUnitMonoPartial -- a partial parameter type of a unit template's
# function, completed with the instance's arguments; the partial itself when
# nothing substitutes.
completeUnitMonoPartial: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rf: ztypes.declid
    partialTid: ztypes.tid
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
} out ztypes.tid is {
    rsp: (
        respecialize
        :st
        scope: rf
        :ast
        unitDecl: (unitRootOfDecl typing: st.typing declId: rf)
        specTid: partialTid
        :idSubs
    )
    if rsp.notZero then return rsp
    return partialTid
}

# unitMonoIdSubs -- a unit instance's arguments keyed by its template's
# GENERIC_PARAM ids, as a spec's are: a type's id, or a numeric value.
unitMonoIdSubs: function {
    st: zenv.ZSymbolTable.view
    tdecl: ztypes.declid
    monoId: ztypes.tid
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
} is {
    pn: st.reg.genericParamNamesOf :tdecl
    pi: u64
    for pi < pn.length loop {
        pnm: pn.get i: pi
        po: st.reg.genericParamTidOf :tdecl paramName: pnm
        if po.some then {
            vg: st.reg.genericValueArgAt specId: monoId ordinal: pi
            if vg.some then {
                idSubs.set key: po value: ztypes.genericarg.valueArg vg
            } else {
                sg: subs.get key: pnm
                if sg.some then {
                    idSubs.set key: po value: ztypes.genericarg.typeArg sg
                }
            }
        }
        pi = pi + 1
    }
}

# unitTemplateKeyOf -- the key a generic unit instance's substitutions hold
# `tid` under: a generic parameter of the template `tdecl`, or a type the
# template declares, by its name; 0 for a type declared anywhere else,
# whatever it is spelled (`lib.T` is not the template's `T`).
unitTemplateKeyOf: function {
    st: zenv.ZSymbolTable.view
    tdecl: ztypes.declid
    tid: ztypes.tid
} out zast.nameid is {
    if tdecl.isZero or tid.isZero then return zast.nameid
    pn: st.reg.genericParamNameOfTid :tdecl ptid: tid
    if pn.notZero then return pn
    d: templateDeclOf reg: st.reg typing: st.typing :tid
    if d.isZero then return zast.nameid
    if (st.typing.declParentOf declId: d) != tdecl then return zast.nameid
    return (st.typing.decls.get i: d).name
}

# unitMonoTypeOf -- a type a generic unit's template names, as the instance
# `monoId` sees it: a partial completed with the instance's arguments, and a
# parameter, or a type or alias the template declares, replaced by the
# instance's own (`subs`), or a type an enclosing generic unit declares by its
# owning instance's copy. The type itself when nothing substitutes.
unitMonoTypeOf: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rf: ztypes.declid
    tplId: ztypes.tid
    monoId: ztypes.tid
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    tid: ztypes.tid
} out ztypes.tid is {
    tdecl: st.typing.declIdOfType typeId: tplId
    r: tid
    if (st.reg.isPartialOf :tid) then {
        idSubs: IdMapV ztypes.tid v: ztypes.genericarg
        unitMonoIdSubs :st :tdecl :monoId :subs :idSubs
        r = completeUnitMonoPartial :st :ast :rf partialTid: tid :idSubs
    }
    k: unitTemplateKeyOf :st :tdecl :tid
    if k.notZero then return ((subs.get key: k).or d: r)
    # a type an enclosing generic unit declares is that unit's instance's copy
    return (instanceCopyOf :st mono: (st.reg.ownerTidOf tid: monoId) tid: r)
}

# instanceCopyOf -- `tid`, a member of a generic unit template, as the instance
# `mono` sees it: the copy `mono` holds, else the copy the nearest instance
# owning it holds -- a nested unit's instance reads its enclosing instance's
# members. The walk stops at the first owner that is no instance; `tid` itself
# when none on the way holds a copy. The copies are recorded where buildUnitMono
# mints them (recordUnitMemberCopy).
instanceCopyOf: function {
    st: zenv.ZSymbolTable.view mono: ztypes.tid tid: ztypes.tid
} out ztypes.tid is {
    own: mono
    for own.notZero and (st.reg.genericOriginOf tid: own).notZero loop {
        cp: st.typing.unitMemberCopyAt mono: own member: tid
        if cp.notZero then return cp
        own = st.reg.ownerTidOf tid: own
    }
    return tid
}

# fillMonoMethodSignature -- copy a template method's parameters and return type
# into the mono's method, with the instantiation's arguments substituted for the
# generic parameters the template names.
fillMonoMethodSignature: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rf: ztypes.declid
    tmplUnitName: ztypes.declid
    fmNode: argref
    srcId: ztypes.tid
    newFnId: ztypes.tid
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    # the unit instance and its template, whose arguments complete a partial
    # parameter type
    monoId: ztypes.tid
    tplId: ztypes.tid
} is {
    otBm: srcId
    ci: u64
    cn3: st.typing.declRowSlots ownerTid: otBm
    for ci < cn3 loop {
        rwBm: st.typing.declRowAt ownerTid: otBm membersOnly: true slot: ci
        ci = ci + 1
        if rwBm.keep then {
            chName: rwBm.name
            target: unitMonoTypeOf :st :ast :rf :tplId :monoId :subs tid: rwBm.tid
            st.typing.setMemberType parentTypeId: newFnId nameId: chName childTypeId: target
            # and the parameter's ownership: a `.take` parameter of the
            # instance takes its argument as the template's does
            pown: st.typing.declOwnershipOfId parentTypeId: srcId nameId: chName
            if pown.some then (
                st.typing.setChildOwnershipId
                parentTypeId: newFnId
                nameId: chName
                ownership: pown
            )
            # and its default: a call that leaves it out fills it on the
            # instance as on the template
            pdft: st.typing.declDefaultOfId parentTypeId: srcId nameId: chName
            if pdft.none.not then (
                st.typing.declSetDefaultId
                parentTypeId: newFnId
                nameId: chName
                value: pdft
            )
            # and its refusal: the instance's declares the bound, not the
            # parameter the template names
            if (memberRefusedForNumericParam :st :ast owner: srcId nameId: chName) then {
                cpd: declMemberOf :st ownerTid: newFnId nameId: chName
                if cpd.notZero then st.walk.refusedParamCopies.add item: cpd
            }
        }
    }
    rto: st.reg.returnTypeOf tid: srcId
    if rto.notZero then {
        rtv: unitMonoTypeOf :st :ast :rf :tplId :monoId :subs tid: rto
        st.reg.setReturnType typeId: newFnId value: rtv
    } else {
        # template return unresolved at signature time
        # (out t): derive from the method's AST typeref.
        rnmId: fnReturnBaseNameIdOf :ast op: (ast.nodes.get i: fmNode.operation)
        # a name the function declares as its own generic parameter is that
        # parameter, nearer than any of the unit's
        if (declare.fnDeclaresGeneric :ast op: (ast.nodes.get i: fmNode.operation) nameId: rnmId
        ) then return
        if rnmId.isZero then {
            # a qualified return (`out lib.T`) names a type declared elsewhere,
            # resolved where the template writes it
            rtr: fnReturnTyperefOf op: (ast.nodes.get i: fmNode.operation)
            if rtr.notZero when (ast.nodes.get i: rtr).dottedpath then {
                qt: (
                    typeref.resolveTyperefShell
                    :st
                    :ast
                    unitDecl: tmplUnitName
                    scope: rf
                    nid: rtr
                    thisName: ""
                )
                if qt.notZero then {
                    (
                        st.reg.setReturnType
                        typeId: newFnId
                        value: (unitMonoTypeOf :st :ast :rf :tplId :monoId :subs tid: qt)
                    )
                }
            }
        }
        if rnmId.notZero then {
            # written bare in the template, the name is the unit's own -- a
            # parameter, or a type it declares -- before anything wider
            returnSub: subs.get key: rnmId
            returnTid: ztypes.tid
            match (
                returnSub
            ) case some then {
                returnTid = returnSub
            } case none then {
                returnLookup: (
                    walkLookupTyperefById
                    :st
                    scope: rf
                    :ast
                    unitDecl: tmplUnitName
                    baseId: rnmId
                )
                if returnLookup.some then {
                    returnTid = returnLookup
                }
            }
            if returnTid.notZero then {
                (
                    st.reg.setReturnType
                    typeId: newFnId
                    value: (unitMonoTypeOf :st :ast :rf :tplId :monoId :subs tid: returnTid)
                )
            }
        }
    }
}


# mintUnitNestedInstances -- each type a generic unit declares, instantiated
# with the unit instance's arguments: the instance's own member of that name, and
# the substitution its signatures take for the name.
mintUnitNestedInstances: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rf: ztypes.declid
    tmplUnitName: ztypes.declid
    monoId: ztypes.tid
    tplId: ztypes.tid
    bodyIds: zast.kidspan
    allSubs: (IdMapV zast.nameid v: ztypes.tid)
} is {
    copies: IdMapV ztypes.tid v: ztypes.tid
    valSubs: unitInstanceValueArgs :st :monoId :tplId
    vi: u64
    for vi < bodyIds.count loop {
        nm: argRefAt :ast nid: (zast.kidAt kids: ast.kids span: bodyIds i: vi)
        vi = vi + 1
        if nm.nid.notZero then {
            inst: unitNestedInstance :st :ast :rf :tmplUnitName bmNode: nm subs: allSubs :valSubs
            if inst.notZero then {
                (
                    st.typing.declSynthMember
                    parentTypeId: monoId
                    nameId: nm.name
                    kind: ztyping.declkind.typeDecl
                )
                st.typing.setMemberType parentTypeId: monoId nameId: nm.name childTypeId: inst
                # a template the instance reaches is no copy of one
                if (st.reg.genericOriginOf tid: inst).notZero then {
                    allSubs.set key: nm.name value: inst
                    copies.set key: (st.reg.genericOriginOf tid: inst) value: inst
                    recordUnitMemberCopy :st :monoId :tplId nameId: nm.name copy: inst
                }
            }
        }
    }
    for each ce: copies.iterateItems loop {
        retargetNestedSignatures :st instTid: ce.value :copies
    }
}

# mintUnitAliasInstances -- each alias a generic unit declares (`elem: t`), as
# the instance's own member: its target as the instance sees it, which is also
# the substitution the instance's signatures take for the alias's name. A
# constant is no alias: it is evaluated for each instance where it is read.
mintUnitAliasInstances: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rf: ztypes.declid
    monoId: ztypes.tid
    tplId: ztypes.tid
    bodyIds: zast.kidspan
    allSubs: (IdMapV zast.nameid v: ztypes.tid)
} is {
    vi: u64
    for vi < bodyIds.count loop {
        nm: argRefAt :ast nid: (zast.kidAt kids: ast.kids span: bodyIds i: vi)
        vi = vi + 1
        if nm.nid.isZero then continue
        ad: st.typing.declFindChild parentDeclId: rf nameId: nm.name
        if (
            ad.isZero or (declare.isBareGenericParam :ast op: (ast.nodes.get i: nm.operation))
        ) then continue
        # an alias of a type, bare or dotted, or one whose value instantiates
        # a generic (`Vals: (ListVal t: t)`), as bareNameDenotesType asks
        isAl: aliasNamesType :st :ast declId: ad
        if isAl.not when (instantiatedAliasFold :ast :st declId: ad) then isAl = true
        if isAl.not then continue
        at: st.typing.declTypeOf declId: ad
        if at.isZero when (st.typing.decls.get i: ad).kind.reexportDecl then at = (
            resolve.resolveAliasKey
            :st
            :ast
            declId: ad
        )
        if at.isZero or (constValueOfDecl :st declId: ad).isConst then continue
        inst: unitMonoTypeOf :st :ast :rf :tplId :monoId subs: allSubs tid: at
        (
            st.typing.declSynthMember
            parentTypeId: monoId
            nameId: nm.name
            kind: ztyping.declkind.typeDecl
        )
        st.typing.setMemberType parentTypeId: monoId nameId: nm.name childTypeId: inst
        allSubs.set key: nm.name value: inst
        recordUnitMemberCopy :st :monoId :tplId nameId: nm.name copy: inst
    }
}

# mintUnitStaticListInstances -- each list a generic unit declares, as the
# instance's own: its row, the template's elements evaluated and range-checked
# for the instance (resolveStaticListInto), recorded as the instance's
# constant -- which a read through the instance, or the instance's walk of the
# template, finds (constValueOfMemberAt). An element the instance cannot hold
# is an error that names the instance.
mintUnitStaticListInstances: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rf: ztypes.declid
    tmplUnitName: ztypes.declid
    monoId: ztypes.tid
    tplId: ztypes.tid
    bodyIds: zast.kidspan
    allSubs: (IdMapV zast.nameid v: ztypes.tid).view
} is {
    vi: u64
    for vi < bodyIds.count loop {
        nm: argRefAt :ast nid: (zast.kidAt kids: ast.kids span: bodyIds i: vi)
        vi = vi + 1
        if nm.nid.isZero or (ast.nodes.get i: nm.operation).listblock.not then continue
        k: st.typing.memberConstKey parentTypeId: monoId nameId: nm.name
        if (st.walk.constEvalState.has key: k) then continue
        st.walk.constEvalState.set key: k value: ztyping.constevalstate.evaluating
        from: st.typing.errors.length
        row: (
            resolveStaticListInto
            :ast
            :st
            unitDecl: tmplUnitName
            scope: rf
            dnode: (staticListRefAt :ast nid: nm.operation)
            :monoId
            :tplId
            subs: allSubs
            want: ztypes.tid
        )
        bodies.noteInstanceErrors :st :ast mono: monoId :from
        st.walk.constEvalState.set key: k value: ztyping.constevalstate.done
        if row == 0 then continue
        (
            st.typing.setMemberConst
            parentTypeId: monoId
            nameId: nm.name
            value: (ztypes.makeAggConst id: row)
        )
        (
            st.typing.declSynthMember
            parentTypeId: monoId
            nameId: nm.name
            kind: ztyping.declkind.staticListDecl
        )
        (
            st.typing.setMemberType
            parentTypeId: monoId
            nameId: nm.name
            childTypeId: (st.typing.constAggs.get i: row.u64).tid
        )
    }
}

# unitInstanceValueArgs -- the numeric arguments unit instance `monoId` of
# template `tplId` was made with, by parameter name: what an instance of a
# definition nested in the unit takes for the unit's numeric parameters.
unitInstanceValueArgs: function {
    st: zenv.ZSymbolTable.view
    monoId: ztypes.tid
    tplId: ztypes.tid
} out (IdMapV zast.nameid v: u64) is {
    valSubs: IdMapV zast.nameid v: u64
    pn: st.reg.genericParamNamesOf tdecl: (st.typing.declIdOfType typeId: tplId)
    pi: u64
    for pi < pn.length loop {
        vg: st.reg.genericValueArgAt specId: monoId ordinal: pi
        if vg.some then valSubs.set key: (pn.get i: pi) value: vg
        pi = pi + 1
    }
    return valSubs
}

# mintUnitNamespaceInstances -- each `unit { ... }` a generic unit declares, as
# the instance's own: the nested unit is generic over the enclosing unit's
# parameters (resolveNamespaceUnit), and its instance with this instance's
# arguments -- found on the trie, or minted and built as any unit instance is --
# is the member of its name. The instance owns it, so a walk of the nested
# instance reads this instance's members too (bindUnitNestedTypes), and a unit
# nested two deep is built the same way from its own enclosing instance. A
# `unit { ... }` template with parameters of its own is the member itself:
# reached through the instance, which binds the enclosing parameters
# (bindInheritedParams), it has an instance per argument, each owned by the
# instance whose arguments it took (enclosingInstanceOf).
mintUnitNamespaceInstances: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rf: ztypes.declid
    monoId: ztypes.tid
    tplId: ztypes.tid
    bodyIds: zast.kidspan
    allSubs: (IdMapV zast.nameid v: ztypes.tid).view
} is {
    valSubs: unitInstanceValueArgs :st :monoId :tplId
    vi: u64
    for vi < bodyIds.count loop {
        nm: argRefAt :ast nid: (zast.kidAt kids: ast.kids span: bodyIds i: vi)
        vi = vi + 1
        if nm.nid.isZero or (zast.unitOpHasBody :ast opId: nm.operation).not then continue
        mintNamespaceMember :st :ast :rf :monoId :tplId member: nm :allSubs :valSubs
    }
}

# mintNamespaceMember -- mintUnitNamespaceInstances for one unit `member` of the
# template's body.
mintNamespaceMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rf: ztypes.declid
    monoId: ztypes.tid
    tplId: ztypes.tid
    member: argref
    allSubs: (IdMapV zast.nameid v: ztypes.tid).view
    valSubs: (IdMapV zast.nameid v: u64).view
} is {
    nd: st.typing.declFindChild parentDeclId: rf nameId: member.name
    if nd.isZero then return
    if (st.typing.declTypeOf declId: nd).isZero then resolve.resolveDemandedDecl :st :ast declId: nd
    ntpl: st.typing.declTypeOf declId: nd
    if ntpl.isZero or (st.reg.isGenericOf tid: ntpl).not then return
    lbl: st.reg.nameOf tid: monoId
    lbl.append "_"
    lbl.append (zast.nameTextAt :ast ref: member.name)
    inst: (
        ensureUnitInstanceMono
        :st
        scope: rf
        :ast
        tplId: ntpl
        tdecl: nd
        subs: allSubs
        :valSubs
        label: lbl
        owner: monoId
    )
    # a template with parameters of its own stays one, reached through the
    # instance, which binds the rest (bindInheritedParams)
    if inst.isZero when (ownsTypeParams :st tid: ntpl) then inst = ntpl
    if inst.isZero then return
    (
        st.typing.declSynthMember
        parentTypeId: monoId
        nameId: member.name
        kind: ztyping.declkind.unitDecl
    )
    st.typing.setMemberType parentTypeId: monoId nameId: member.name childTypeId: inst
    if inst != ntpl then recordUnitMemberCopy :st :monoId :tplId nameId: member.name copy: inst
}

# recordUnitMemberCopy -- `copy` is the instance `monoId`'s own member `nameId`:
# record it against both things it is a copy of -- its generic origin (a type,
# an alias's target, a list, a nested unit), and the template's member of
# that name, which is what a bare name read in the template resolves to (a
# function copy carries no origin at all).
recordUnitMemberCopy: function {
    st: zenv.ZSymbolTable
    monoId: ztypes.tid
    tplId: ztypes.tid
    nameId: zast.nameid
    copy: ztypes.tid
} is {
    st.typing.unitMemberCopySet mono: monoId member: (st.reg.genericOriginOf tid: copy) :copy
    (
        st.typing.unitMemberCopySet
        mono: monoId
        member: ((st.typing.declChildOfId parentTypeId: tplId :nameId).or d: ztypes.tid.zero)
        :copy
    )
}

# retargetNestedSignatures -- a copy's methods, cloned before its siblings
# existed, name a sibling type by its template: they name this unit instance's
# copy of it instead.
retargetNestedSignatures: function {
    st: zenv.ZSymbolTable
    instTid: ztypes.tid
    copies: (IdMapV ztypes.tid v: ztypes.tid).view
} is {
    fns: ListVal ztypes.tid
    ri: u64
    rn: st.typing.declRowSlots ownerTid: instTid
    for ri < rn loop {
        rw: st.typing.declRowAt ownerTid: instTid membersOnly: true slot: ri
        ri = ri + 1
        if rw.keep when (st.reg.typetypeOf typeId: rw.tid) == ztypes.ztypetype.functionType then (
            fns.append
            from: rw.tid
        )
    }
    for each fv: fns loop {
        fid: fv
        rt: conform.methodReturnOf reg: st.reg typing: st.typing mid: fid
        if rt.some then {
            rc: (copies.get key: rt).or d: ztypes.tid.zero
            if rc.notZero then st.reg.setReturnType typeId: fid value: rc
        }
        retargetNestedParams :st :fid :copies
    }
}

# retargetNestedParams -- retargetNestedSignatures over one method's parameters.
retargetNestedParams: function {
    st: zenv.ZSymbolTable
    fid: ztypes.tid
    copies: (IdMapV ztypes.tid v: ztypes.tid).view
} is {
    pi: u64
    pn: st.typing.declRowSlots ownerTid: fid
    for pi < pn loop {
        pr: st.typing.declRowAt ownerTid: fid membersOnly: true slot: pi
        pi = pi + 1
        pc: (copies.get key: pr.tid).or d: ztypes.tid.zero
        if pr.keep when pc.notZero then {
            st.typing.setMemberType parentTypeId: fid nameId: pr.name childTypeId: pc
        }
    }
}

# unitNestedInstance -- the instance of the type `bmNode` defines in a generic
# unit's body, over the unit instance's arguments; 0 when it defines none.
unitNestedInstance: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rf: ztypes.declid
    tmplUnitName: ztypes.declid
    bmNode: argref
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    # the unit instance's numeric arguments, by parameter name
    valSubs: (IdMapV zast.nameid v: u64).view
} out ztypes.tid is {
    none: ztypes.tid
    isObj: false
    op: ast.nodes.get i: bmNode.operation
    isObj = op.objectdef
    if isObj.not then return none
    declare.resolveUnitNestedType :st :ast unitDecl: tmplUnitName scope: rf :bmNode
    td: st.typing.declFindChild parentDeclId: rf nameId: bmNode.name
    tpl: st.typing.declTypeOf declId: td
    if tpl.isZero or (st.reg.isGenericOf tid: tpl).not then return none
    # a template with parameters of its own stays one, reached through the
    # instance, which binds the rest (bindInheritedParams)
    if (ownsTypeParams :st tid: tpl) then return tpl
    sfx: String
    vs: IdMapV zast.nameid v: u64
    for each pn: (st.reg.genericParamNamesOf tdecl: td) loop {
        av: (subs.get key: pn).or d: ztypes.tid.zero
        vg: valSubs.get key: pn
        if av.notZero then {
            sfx.append s: "_"
            sfx.append s: (typeargs.monoValName :st :ast tid: av)
        } else if vg.some then {
            vs.set key: pn value: vg
            cdP: st.reg.genericParamConstraintOf tdecl: td paramName: pn
            typeargs.appendNumericArgSuffix :sfx bits: vg cd: cdP
        }
    }
    own: IdMapV zast.nameid v: ztypes.tid
    for each se: subs.iterateItems loop own.set key: se.key value: se.value
    mid: (
        getOrMintSpec
        :st
        scope: rf
        :ast
        unitDecl: tmplUnitName
        sfx: sfx.stringView
        templateId: tpl
        subs: own
        valSubs: vs
        fallbackArg: ztypes.tid.zero
    )
    return mid
}

# buildUnitMono -- unit-mono completion: substituted method
# children ({mono}.{fn} FUNCTION types whose generic-param-named child types
# and return are replaced by the instantiation arg). Bodies are walked once,
# per instance, over the template's AST (stampUnitMonoTemplates). One build
# per mono.
buildUnitMono: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    tmplUnitName: ztypes.declid
    tmplNameId: zast.nameid
    monoId: ztypes.tid
    tplId: ztypes.tid
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    templateOpId: zast.nodeid
} is {
    if (st.walk.collectionChildrenBuilt.has item: monoId) then return
    bk0: monoId
    st.walk.collectionChildrenBuilt.add item: bk0
    # the template's members resolve in the template's scope
    rf: scope
    td: st.typing.declIdOfType typeId: tplId
    if td.notZero then rf = td
    bodyIds: zast.unitBodyIdsAt :ast unitId: templateOpId
    # the substitutions the instance's signatures take: its arguments, and each
    # type the unit declares as this instance's own copy of it
    allSubs: IdMapV zast.nameid v: ztypes.tid
    for each se: subs.iterateItems loop allSubs.set key: se.key value: se.value
    {
        mintUnitNestedInstances :st :ast :rf :tmplUnitName :monoId :tplId :bodyIds :allSubs
        mintUnitAliasInstances :st :ast :rf :monoId :tplId :bodyIds :allSubs
        mintUnitStaticListInstances :st :ast :rf :tmplUnitName :monoId :tplId :bodyIds :allSubs
        mintUnitNamespaceInstances :st :ast :rf :monoId :tplId :bodyIds :allSubs
        i: u64
        for i < bodyIds.count loop {
            fm: zast.kidAt kids: ast.kids span: bodyIds :i
            i = i + 1
            fmNode: argRefAt :ast nid: fm
            if fmNode.nid.notZero then {
                (
                    declare.buildUnitMonoMember
                    :st
                    :ast
                    :rf
                    :tmplUnitName
                    :tmplNameId
                    :monoId
                    :tplId
                    :fmNode
                    subs: allSubs
                )
            }
        }
    }
}


# buildInstanceMono -- build the monomorphised unit for one instantiation request,
# from the template collection resolved: its id, the declaring node and the unit
# whose AST holds it.
buildInstanceMono: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    program: Ast
    rtId: zast.nameid
    rtu: ztypes.declid
    rtop: zast.nodeid
    tplId: ztypes.tid
    memberIdAt: ztypes.tid
    subs: (IdMapV zast.nameid v: ztypes.tid).view
} is {
    # the request resolved its template at COLLECTION: its id, the node that
    # declares it, and the unit whose AST holds that node
    if rtop.isZero or tplId.isZero then return
    (
        buildUnitMono
        :st
        :scope
        ast: program
        tmplUnitName: rtu
        tmplNameId: rtId
        monoId: memberIdAt
        :tplId
        :subs
        templateOpId: rtop
    )
}

# recordInstanceGenericArgs -- record a mono's arguments in DECLARATION order, the
# order the generic_arg rows keep and the order that keys its level of the id
# trie. A parameter with no substitution keys as 0 rather than being skipped, so
# the arity of the key always matches the template's.
recordInstanceGenericArgs: function {
    st: zenv.ZSymbolTable
    tplDecl: ztypes.declid
    memberIdAt: ztypes.tid
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    valSubs: (IdMapV zast.nameid v: u64).view
} is {
    mono: memberIdAt
    if (st.reg.genericArgCount specId: mono) > 0 then return
    for each pnm: (st.reg.genericParamNamesOf tdecl: tplDecl) loop {
        a: paramArgOf :st tdecl: tplDecl :pnm :subs :valSubs
        (
            st.reg.appendGenericArg
            specId: mono
            arg: (a.or d: ztypes.genericarg.typeArg ztypes.tid.zero)
        )
    }
}

# stdTid -- the stdlib type the well-known name `wk` names (zast.wellKnown's ty*
# entries), resolved once from the PRELUDE -- core's re-exports of the system
# and collections units -- and never from a program's own scope: a program's
# `String` is its own type, never this one, and which scope asked first decides
# nothing. Memoized on the name id.
stdTid: function {ast: Ast st: zenv.ZSymbolTable wk: zast.nameid} out ztypes.tid is {
    m: st.typing.stdTidMemo.get key: wk
    if m.some then {
        return m
    }
    r: (walkLookupTyperefFrom :st :ast scope: ztypes.declid baseId: wk).or d: ztypes.tid.zero
    if r.isZero then return r
    st.typing.stdTidMemo.set key: wk value: r
    # cached for the readers that hold no ast to look it up with -- a synth
    # comparison's return type is answered from here
    if wk == zast.wellKnown.slot.wkBool then st.typing.boolTid = r
    return r
}

# stdTidOr -- stdTid, or `d` when the program has no such type
stdTidOr: function {
    ast: Ast st: zenv.ZSymbolTable wk: zast.nameid d: ztypes.tid
} out ztypes.tid is {
    t: stdTid :ast :st :wk
    if t.isZero then return d
    return t
}

# stampResolvedTyperef -- a deferred type-ref that resolved: stamp the node,
# refuse a literal type, and record the declaration it names (refDecl) for
# go-to-definition; codegen-inert, since a type-annotation atom is never
# emitted as an expression.
stampResolvedTyperef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    # the type-ref node
    nid: zast.nodeid
    # the name it spells
    pval: zast.nameid
    # the unit the ref was written in, which labels the surface probe
    origin: ztypes.declid
    # what the name resolved to
    tid: ztypes.tid
} is {
    ztyping.nodeTypeSet tbl: st.typing.nodeType :nid :tid
    refuseLiteralTyperef :st :ast :nid :tid
    sfB: declSurfaceOfName :st :ast unitDecl: origin nameId: pval :tid
    stampRefDecl :st :nid declId: sfB
}

# stampAliasRef -- stamp the deferred type-ref `uk`, spelled `pval`, when it
# names an alias of the type it is written in (ZTyping.aliasRefOwner). True
# when it did.
stampAliasRef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    uk: zast.nodeid
    pval: zast.nameid
    origin: ztypes.declid
} out bool is {
    ao: (st.walk.aliasRefOwner.get key: uk).or d: ztypes.declid
    if ao.isZero then return false
    amd: st.typing.declFindChild parentDeclId: ao nameId: pval
    aot: asAliasTargetOf :st :ast tdecl: ao md: amd
    if aot.isZero then {
        # the nearest declaration of the name is a member that is no type
        if amd.isZero or (memberStopsTypeName :st :ast tdecl: ao md: amd).not then return false
        refuseMemberAsType :st :ast tdecl: ao md: amd nid: uk
        return true
    }
    stampResolvedTyperef :st :ast nid: uk :pval :origin tid: aot
    return true
}

# ownershipOfParam -- a parameter's binding ownership from its path annotation:
# an explicit .take binds OWNED, everything else (.borrow / .view / default)
# binds BORROWED.
ownershipOfParam: function {o: optionval ztypes.zparamownership} out ztypes.zownership is {
    match (
        o
    ) case some then {
        po: o
        match (
            po
        ) case noneMode then {
            return ztypes.zownership.borrowed
        } case takeMode then {
            return ztypes.zownership.owned
        } case borrowMode then {
            return ztypes.zownership.borrowed
        } case viewMode then {
            return ztypes.zownership.borrowed
        } case holdMode then {
            return ztypes.zownership.owned
        }
    } case none then {
        return ztypes.zownership.borrowed
    }
}

# paramTypeId -- the resolved type id of a parameter's type-expr. Reads the
# post-demand node stamp (stampTyperefs), falling back to a cross-unit name
# lookup for a bare-atom base.
paramTypeId: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    opNid: zast.nodeid
} out ztypes.tid is {
    # A parameter type carrying an ownership marker (ztypes.ZTypeRegistry.take)
    # resolves through its peeled base: the marker node is recorded under the
    # current unit and left unstamped, so read the inner cross-unit ref that
    # stampTyperefs resolved. The row is read through a view scoped to this
    # block, and what leaves the block are NAME IDS: an id is a scalar, so it
    # holds no lock on ast, and the lookups below lend ast.
    peelTo: zast.nodeid
    onid: zast.nodeid
    anId: zast.nameid
    bnId: zast.nameid
    dcnId: zast.nameid
    {
        op: ast.nodes.get i: opNid
        if op.dottedpath when (
            isStripMarkerId
            nameId: (atomNameId :ast n: (ast.nodes.get i: op.child))
        ) then {
            peelTo = op.parent
        }
        onid = nodeId n: op
        anId = atomNameId :ast n: op
        bnId = rootNameIdOf :ast n: op
        dcnId = dottedChildNameId :ast n: op
    }
    if peelTo.notZero then return (paramTypeId :st :ast :unitDecl opNid: peelTo)
    r: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: onid
    if r.notZero then return r
    ano: walkLookupTyperefById :st scope: st.curScope :ast :unitDecl baseId: anId
    anid: ano.or d: ztypes.tid.zero
    if anid.notZero then return anid
    # a dotted typeref naming a variant/union ARM is an arm DEFAULT:
    # the parameter's type is the tagged parent.
    if bnId.notZero then {
        # a dotted numeric literal (0.u64) declares the SUFFIX type: the
        # body read must carry it, not fall to 0 (untyped/permissive). The
        # suffix is the system's scalar, whatever the program declares under
        # its name. The two shape questions are asked of the ids, through
        # block-scoped borrows.
        isSfx: isScalarNameId id: dcnId
        if (isNumericLiteralNameAt :ast ref: bnId) when isSfx then {
            return (scalarTidOf :st scope: st.curScope :ast nameId: dcnId)
        }
        # a path from a unit (`shade.hue.red`) names no type at its root:
        # bindFunctionParam takes the type its registration resolved
        if (rootNamesAnyUnit :st scope: st.curScope nameId: bnId) then return ztypes.tid.zero
        return (
            (walkLookupTyperefById :st scope: st.curScope :ast :unitDecl baseId: bnId).or
            d: ztypes.tid.zero
        )
    }
    return ztypes.tid.zero
}

# printableInterpTid -- an interpolated part must be a value the string
# machinery can splice: a numeric scalar, bool, a declared tag, String or
# StringView (directly, via typedef, or a str-origin mono/port). Unstamped
# values and generic params pass -- the emitter's loud unhandled-construct
# backstop covers a bad instantiation.
printableInterpTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    tid: ztypes.tid
} out bool is {
    if tid.isZero then return true
    if (isAnyLiteralTid :st :tid) then return true
    t: tid
    for true loop {
        b: st.typing.typedefBaseTidOf tid: t
        if b.isZero then break
        t = b
    }
    if (numerics.isNumericTid :st tid: t) then return true
    if t == (stdTid :ast :st wk: zast.wellKnown.slot.wkBool) then return true
    if t == (stdTid :ast :st wk: zast.wellKnown.slot.tyString) then return true
    if t == (stdTid :ast :st wk: zast.wellKnown.slot.tyStringView) then return true
    if t == (stdTid :ast :st wk: zast.wellKnown.slot.tyText) then return true
    tt: st.reg.typetypeOf typeId: t
    if tt == ztypes.ztypetype.genericParam then return true
    if tt == ztypes.ztypetype.tagType then return true
    strO: stdTid :ast :st wk: zast.wellKnown.slot.tyStr
    go: st.reg.genericOriginOf tid: t
    if strO.notZero when go == strO then return true
    return false
}

# cloneMethodParams -- copy the template method's parameters onto the clone, with
# the specialisation's arguments substituted for the generic parameters, and the
# ownership markers the template declared carried across unchanged.
cloneMethodParams: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    specId: ztypes.tid
    fnTid: ztypes.tid
    templateName: StringView
    # the template's parameters: name ids, types and declared ownership, slot
    # for slot
    paramNames: (ListVal zast.nameid).view
    paramTids: (ListVal ztypes.tid).view
    paramHolds: (ListVal bool).view
    paramOwnerships: (ListVal ztypes.zparamownership).view
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
    tplClassId: ztypes.tid
    # the template's receiver name, when a marked receiver renames it
    tpn0id: zast.nameid
} is {
    pi5: u64
    pn5: paramNames.length
    for pi5 < pn5 loop {
        paramName: paramNames.get i: pi5
        paramTid: paramTids.get i: pi5
        targetTid: paramTid
        if paramTid == tplClassId then targetTid = specId
        if paramName == zast.wellKnown.slot.wkThis then targetTid = specId
        if tpn0id.notZero when paramName == tpn0id then targetTid = specId
        if targetTid == paramTid then {
            # `this`/`type`-typed params carry fresh shells named after the
            # class; shell-name identity marks the self type.
            paramTypeName: st.reg.nameOf tid: paramTid
            if paramTypeName.stringView == templateName then targetTid = specId
        }
        if targetTid == paramTid then {
            idSub: idTypeSubOf :idSubs key: paramTid
            match (
                idSub
            ) case some then {
                targetTid = idSub
            } case none then {
                rs5: respecialize :st :scope :ast :unitDecl specTid: paramTid :idSubs
                if rs5.notZero then targetTid = rs5
            }
        }
        st.typing.setMemberType parentTypeId: fnTid nameId: paramName childTypeId: targetTid
        if (paramHolds.get i: pi5) then {
            paramOwnership: paramOwnerships.get i: pi5
            (
                st.typing.setChildOwnershipId
                parentTypeId: fnTid
                nameId: paramName
                ownership: paramOwnership
            )
        }
        pi5 = pi5 + 1
    }
}

# unitSiblingReturn -- the template a method's return typeref names by its bare
# name, when the method's type is itself declared in a generic unit; 0 otherwise.
unitSiblingReturn: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tplClassId: ztypes.tid
    rn: zast.nodeid
} out ztypes.tid is {
    none: ztypes.tid
    td: st.typing.declIdOfType typeId: tplClassId
    if td.isZero then return none
    ud: st.typing.declParentOf declId: td
    if ud.isZero or (declIsUnitTemplate :st :ast declId: ud).not then return none
    bn: declare.baseTypeNameId :ast n: (ast.nodes.get i: rn)
    if bn.isZero then return none
    sib: st.typing.declFindChild parentDeclId: ud nameId: bn
    if sib.isZero then return none
    return (st.typing.declTypeOf declId: sib)
}

# returnNamesSelf -- a return typeref that names the type declaring the method:
# `this`, `type` (in a generic type's members, the instance), or a name that,
# looked up from the template, reaches the template's own declaration, bare or
# marked.
returnNamesSelf: function {
    # the tree the return typeref is read from
    ast: Ast.view
    # the declarations the written name is looked up in
    st: zenv.ZSymbolTable.view
    # the return typeref
    nid: zast.nodeid
    # the declaration of the template whose method returns it
    tplDecl: ztypes.declid
} out bool is {
    bid: rootNameIdOf :ast n: (ast.nodes.get i: nid)
    if bid.isZero then return false
    if bid == zast.wellKnown.slot.wkThis then return true
    if bid == zast.wellKnown.slot.wkType then return true
    if tplDecl.isZero then return false
    return (declInScope :st scopeDeclId: tplDecl nameId: bid) == tplDecl
}

# cloneMethodReturn -- the clone's return type: the template's, with the
# specialisation's arguments substituted. A composite return that still mentions a
# generic parameter respecializes rather than being copied through.
cloneMethodReturn: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    specId: ztypes.tid
    tplClassId: ztypes.tid
    fnTid: ztypes.tid
    tplFnId: ztypes.tid
    templateName: StringView
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
} is {
    returnTid: ztypes.tid
    ro5: st.reg.returnTypeOf tid: tplFnId
    if ro5.notZero then returnTid = ro5
    if returnTid.isZero then {
        # the registry records a return type only where the return NAMES a
        # generic parameter, so a return typed as the TEMPLATE itself leaves it
        # 0 and the substitution below never ran at all. The AST typeref's stamp
        # is the other half of the answer -- the second lookup methodReturnOf
        # already makes, over the node cloneMethodInto has copied onto the
        # clone, which is why the clone answered the TEMPLATE's own type rather
        # than nothing. Registry first: it is the half that carries a parameter
        # tid for the substitution, and the stamp is the unsubstituted one.
        rn5: (st.typing.funcReturnNode.get key: tplFnId).or d: zast.nodeid
        if rn5.notZero then {
            nt5: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: rn5
            if nt5.notZero then returnTid = nt5
        }
        # an instance minted before the template's returns resolved (through
        # an alias) still knows a return that names the type itself
        if returnTid.isZero when rn5.notZero when (
            returnNamesSelf
            :ast
            :st
            nid: rn5
            tplDecl: (st.typing.declIdOfType typeId: tplClassId)
        ) then {
            st.reg.setReturnType typeId: fnTid value: specId
            return
        }
        # a type a generic unit declares, cloned before its method's return was
        # stamped (the eager order), names a sibling type the unit resolved
        # already; the unit instance retargets it to its own copy
        if returnTid.isZero when rn5.notZero then returnTid = (
            unitSiblingReturn
            :st
            :ast
            :tplClassId
            rn: rn5
        )
    }
    if returnTid.notZero then {
        rt5: returnTid
        if returnTid == tplClassId then rt5 = specId
        if rt5 == returnTid then {
            returnName: st.reg.nameOf tid: returnTid
            if returnName.stringView == templateName then rt5 = specId
        }
        returnSub: idTypeSubOf :idSubs key: returnTid
        gw5: generatorCallWrap :st :ast :unitDecl :scope :tplFnId wrap: returnTid :idSubs
        match (
            returnSub
        ) case some then {
            rt5 = returnSub
        } case none then {
            if gw5.notZero then {
                rt5 = gw5
            } else {
                rr5: respecialize :st :scope :ast :unitDecl specTid: returnTid :idSubs
                if rr5.notZero then rt5 = rr5
            }
        }
        # a return still GENERIC_PARAM-typed stays unset -- a partial the subs
        # could not complete (multi-param chains mint with empty subs) OR a
        # bare parameter no substitution covered. Both must stay unset, so this
        # asks the tag rather than isPartialOf; the name-keyed fixup arms heal
        # it after minting
        if (st.reg.typetypeOf typeId: rt5) != ztypes.ztypetype.genericParam then {
            st.reg.setReturnType typeId: fnTid value: rt5
        }
    }
}

# generatorCallWrap -- the return of an instance's `call` of a generic
# generator: the wrapper its own element takes (generatorWrapperOf). The
# template's wrapper is over its parameter, so respecializing it would keep the
# template's choice, which is `Option` whatever the instance's element is. 0 for
# any other method, and while the element is still a parameter.
generatorCallWrap: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    tplFnId: ztypes.tid
    # the template's return: its wrapper over the template's element
    wrap: ztypes.tid
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
} out ztypes.tid is {
    rn: (st.typing.funcReturnNode.get key: tplFnId).or d: zast.nodeid
    if ((st.walk.generatorWrapper.get key: rn).or d: false).not then return ztypes.tid
    tElem: st.reg.genericTypeArgAt specId: wrap ordinal: 0
    if tElem.isZero then return ztypes.tid
    elem: tElem
    eso: idTypeSubOf :idSubs key: tElem
    match (
        eso
    ) case some then {
        elem = eso
    } case none then {
        er: respecialize :st :scope :ast :unitDecl specTid: tElem :idSubs
        if er.notZero then elem = er
    }
    if (st.reg.typetypeOf typeId: elem) == ztypes.ztypetype.genericParam then return ztypes.tid
    tpl: generatorWrapperOf :st :ast :scope :elem
    if tpl.isZero then return ztypes.tid
    subs: IdMapV zast.nameid v: ztypes.tid
    (
        subs.set
        key: (st.reg.genericParamNameAt tdecl: (st.typing.declIdOfType typeId: tpl) i: 0)
        value: elem
    )
    noVals: IdMapV zast.nameid v: u64
    sfx: "_\{typeargs.monoValName :ast :st tid: elem}"
    return (
        getOrMintSpec
        :st
        :scope
        :ast
        :unitDecl
        sfx: sfx.stringView
        templateId: tpl
        :subs
        valSubs: noVals
        fallbackArg: ztypes.tid.zero
    )
}

# generatorWrapperOf -- the option a generator's `call` hands its element back
# in: `optionval` over a valtype, held inline, and `Option` otherwise, whose
# boxed payload outlives the `call` that yields it. The lowering writes one
# wrapper over the element as written; this is the choice for the element the
# template or an instance actually has.
generatorWrapperOf: function {
    st: zenv.ZSymbolTable
    ast: Ast
    scope: ztypes.declid
    elem: ztypes.tid
} out ztypes.tid is {
    wk: zast.wellKnown.slot.tyOption
    if (st.reg.isValtypeOf tid: elem) then wk = zast.wellKnown.slot.tyOptionval
    return (resolve.descendNamedId :st :scope :ast unitDecl: st.typing.systemUnitRoot nameId: wk)
}

# cloneParamDefaults -- the defaults the template method's parameters carry,
# copied onto its clone's parameters of the same names.
cloneParamDefaults: function {
    st: zenv.ZSymbolTable
    from: ztypes.tid
    to: ztypes.tid
    names: (ListVal zast.nameid).view
} is {
    for each dn: names loop {
        dnid: dn
        dft: st.typing.declDefaultOfId parentTypeId: (ztypes.tid.create :from) nameId: dnid
        if dft.none.not then st.typing.declSetDefaultId parentTypeId: to nameId: dnid value: dft
    }
}

# cloneDroppedReceiver -- a spec method resolves with its receiver DROPPED from
# the parameters: the receiver's row has no type, so the typed-row copy in
# cloneMethodInto passes it by, and with it the only record of its marker. The
# clone declares the same untyped row and takes the marker, which is what
# methodReceiverIsView asks. A receiver that kept its type was copied already.
cloneDroppedReceiver: function {
    st: zenv.ZSymbolTable
    tplFnId: ztypes.tid
    toFn: ztypes.tid
    tpn0id: zast.nameid
} is {
    if tpn0id.isZero then return
    rnid: tpn0id
    if (st.typing.declMemberIdOf parentTypeId: tplFnId nameId: rnid).isZero then return
    if (st.typing.declMemberIdOf parentTypeId: toFn nameId: rnid).notZero then return
    st.typing.declSynthMember parentTypeId: toFn nameId: rnid kind: ztyping.declkind.paramDecl
    rown: st.typing.declOwnershipOfId parentTypeId: tplFnId nameId: rnid
    if rown.some then {
        st.typing.setChildOwnershipId parentTypeId: toFn nameId: rnid ownership: rown
    }
}

# cloneMethodInto -- specialize one template method for an instance: a fresh
# FUNCTION type named {spec}.{m} whose param children and return substitute
# the template parameters (id-first, then re-specialization). genericOriginId
# points at the TEMPLATE METHOD so the emitter's mono-instance sweep emits the
# template body against this signature.
cloneMethodInto: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    specId: ztypes.tid
    tplClassId: ztypes.tid
    m: StringView
    tplFnId: ztypes.tid
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
} is {
    fnTid: st.reg.newType name: m ownerTid: specId typetype: ztypes.ztypetype.functionType
    st.reg.setGenericOrigin typeId: fnTid value: tplFnId
    # declare and type the method before filling its parameters: typing claims
    # the method's own function type for its declaration, which is what the
    # parameter writes below reach through. Doing it last leaves every parameter
    # of every cloned method with nowhere to land.
    methodNameId: zast.poolFind pool: ast.names text: m
    (
        st.typing.declSynthMember
        parentTypeId: specId
        nameId: methodNameId
        kind: ztyping.declkind.methodDecl
    )
    st.typing.setMemberType parentTypeId: specId nameId: methodNameId childTypeId: fnTid
    # a function the template's `is` section writes is a field of each
    # instance too, and its body is that field's default there as well
    if (st.typing.declIsFnptrFieldId parentTypeId: tplClassId nameId: methodNameId) then {
        st.typing.setChildFnptrFieldId parentTypeId: specId nameId: methodNameId
        if ((st.walk.fnHasBody.get key: tplFnId).or d: false) then (
            st.walk.fnHasBody.set
            key: fnTid
            value: true
        )
    }
    # The clone answers call-site questions the same way the template does:
    # isNative gates arg validation, the recorded receiver name drives receiver auto-fill
    # and the no-paren auto-call, funcReturnMarker carries the `.borrow`
    # return marker, and funcReturnNode backs methodReturnOf for concrete
    # (non-generic) returns.
    tpn0id: zast.nameid
    isNativeFn: false
    if tplFnId < st.reg.nextTid then {
        tz0: st.reg.typeById.get i: tplFnId
        if tz0.isNative then isNativeFn = true
        tpn0id = tz0.thisParamNameId
    }
    if isNativeFn then st.reg.setNative typeId: fnTid value: true
    if tpn0id.notZero then st.reg.setThisParamName typeId: fnTid nameId: tpn0id
    copyReturnMarkers :st fromFn: tplFnId toFn: fnTid
    returnNode: (st.typing.funcReturnNode.get key: tplFnId).or d: zast.nodeid
    if returnNode.notZero then st.typing.funcReturnNode.set key: fnTid value: returnNode
    paramTids: ListVal ztypes.tid
    paramNames: ListVal zast.nameid
    paramHolds: ListVal bool
    paramOwnerships: ListVal ztypes.zparamownership
    {
        ot5: tplFnId
        cq5: u64
        rowSlots: st.typing.declRowSlots ownerTid: ot5
        for cq5 < rowSlots loop {
            rw5: st.typing.declRowAt ownerTid: ot5 membersOnly: true slot: cq5
            cq5 = cq5 + 1
            if rw5.keep then {
                paramNames.append rw5.name
                paramTids.append rw5.tid
            }
        }
    }
    # the template's parameter ownership
    {
        for each paramNameId: paramNames loop {
            oo5: st.typing.declOwnershipOfId parentTypeId: tplFnId nameId: paramNameId
            match (
                oo5
            ) case some then {
                paramHolds.append true
                ov5c: oo5
                paramOwnerships.append ov5c
            } case none then {
                paramHolds.append false
                paramOwnerships.append ztypes.zparamownership.borrowMode
            }
        }
    }
    templateName: st.reg.nameOf tid: tplClassId
    (
        cloneMethodParams
        :ast
        :st
        :unitDecl
        :scope
        :specId
        :fnTid
        templateName: templateName.stringView
        :paramNames
        :paramTids
        :paramHolds
        :paramOwnerships
        :idSubs
        :tplClassId
        :tpn0id
    )
    cloneDroppedReceiver :st :tplFnId toFn: fnTid :tpn0id
    # the parameter defaults: a construction or a call that leaves one out
    # fills it from the clone
    cloneParamDefaults :st from: tplFnId to: fnTid names: paramNames
    (
        cloneMethodReturn
        :ast
        :st
        :unitDecl
        :scope
        :specId
        :tplClassId
        :fnTid
        :tplFnId
        templateName: templateName.stringView
        :idSubs
    )
}

# respecialize -- a type that is itself a specialization (nonempty genericArgs)
# re-specializes when any of its arguments is substituted: the origin template
# specializes again with the mapped argument list. 0 when nothing changes.
respecialize: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    specTid: ztypes.tid
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
} out ztypes.tid is {
    an: st.reg.genericArgCount specId: specTid
    if an == 0 then return ztypes.tid.zero
    origin: ztypes.tid
    og: st.reg.genericOriginOf tid: specTid
    if og.notZero then origin = og
    if origin.isZero then return ztypes.tid.zero
    changed: false
    mapped: ListVal ztypes.genericarg
    ai: u64
    for ai < an loop {
        avv: st.reg.genericValueArgAt specId: specTid ordinal: ai
        av: st.reg.genericTypeArgAt specId: specTid ordinal: ai
        if avv.some then {
            # a numeric VALUE ordinal has nothing to substitute
            mapped.append (ztypes.genericarg.valueArg avv)
        } else {
            # a numeric parameter's GENERIC_PARAM substitutes its value
            memberDecl: idSubs.get key: av
            match (
                memberDecl
            ) case some then {
                mapped.append memberDecl
                changed = true
            } case none then {
                # an arg that is itself a spec may carry substitutable args one
                # level down (OptionView over a MapEntry partial) -- recurse
                rec: respecialize :st :scope :ast :unitDecl specTid: av :idSubs
                if rec.notZero then {
                    mapped.append (ztypes.genericarg.typeArg rec)
                    changed = true
                } else {
                    mapped.append (ztypes.genericarg.typeArg av)
                }
            }
        }
        ai = ai + 1
    }
    if changed.not then return ztypes.tid.zero
    tk: st.typing.declIdOfType typeId: origin
    pn: st.reg.genericParamNamesOf tdecl: tk
    if pn.length != an then return ztypes.tid.zero
    typeSubs: IdMapV zast.nameid v: ztypes.tid
    rvSubs: IdMapV zast.nameid v: u64
    sfx: String
    mi: u64
    for mi < an loop {
        mp: pn.get i: mi
        mv: mapped.get i: mi
        # the parameter's declaration decides how its argument is read
        bits: u64
        mt: ztypes.tid
        match (
            mv
        ) case valueArg then {
            bits = mv
            mt = ztypes.tid.create from: mv
        } case typeArg then {
            bits = mv.u64
            mt = mv
        }
        cdm: st.reg.genericParamConstraintOf tdecl: tk paramName: mp
        if cdm.numKind.has then {
            # an instance's singleton type passes its one value
            sv: st.typing.singletonValueOf tid: mt
            if sv.isConst then bits = constBits64 :st v: sv
            rvSubs.set key: mp value: bits
            typeargs.appendNumericArgSuffix :sfx :bits cd: cdm
        } else {
            sfx.append s: "_"
            typeSubs.set key: mp value: mt
            vn: typeargs.monoValName :st :ast tid: mt
            sfx.append s: vn
        }
        mi = mi + 1
    }
    return (
        getOrMintSpec
        :st
        :scope
        :ast
        :unitDecl
        sfx: sfx.stringView
        templateId: origin
        subs: typeSubs
        valSubs: rvSubs
        fallbackArg: ztypes.tid.zero
    )
}

# templateTypetypeOf -- the typetype a specialization of `templateId` takes. The
# spec front door allocates the instance id itself (so the trie path can be
# written before the children are built), and this is the one thing about the
# template it needs to do that.
templateTypetypeOf: function {
    st: zenv.ZSymbolTable.view
    templateId: ztypes.tid
} out ztypes.ztypetype is {
    if templateId < st.reg.nextTid then {
        tpl: st.reg.typeById.get i: templateId
        return tpl.typetype
    }
    return ztypes.ztypetype.recordType
}

# cloneGenericMemberInto -- a generic FUNCTION child of a template is cloned per
# instance, with its own parameters and return substituted. True when the clone
# landed, so the caller does not also write the member's template type.
cloneGenericMemberInto: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    rf: ztypes.declid
    templateId: ztypes.tid
    mid: ztypes.tid
    chName: StringView
    # the member's name, interned: `create` is told apart by it
    chNameId: zast.nameid
    chId: ztypes.tid
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
} out bool is {
    deep: false
    # a `create` the template writes is cloned like any method; the synthesised
    # one is the instance's own (mintMonoRecordShape)
    isSynth: false
    if chNameId == zast.wellKnown.slot.wkCreate then {
        isSynth = (
            st.typing.declMemberIsSynth
            parentTypeId: templateId
            nameId: zast.wellKnown.slot.wkCreate
        )
    }
    # a list's `contains`, `==`, `!=` and `sort` exist on every instance and
    # are checked where they are called (refuseListMemberWithoutElemOp)
    if isSynth.not then {
        (
            cloneMethodInto
            :st
            scope: rf
            :ast
            :unitDecl
            specId: mid
            tplClassId: templateId
            m: chName
            tplFnId: chId
            :idSubs
        )
        deep = true
        # a method with type parameters of its own stays a template on the
        # instance: its calls mint instances of the clone, over the same
        # parameters its signature names
        chDecl: st.typing.declIdOfType typeId: chId
        if (st.reg.genericParamCountOf tdecl: chDecl) > 0 then {
            cloneId: (
                (st.typing.declChildOfId parentTypeId: mid nameId: chNameId).or
                d: ztypes.tid.zero
            )
            cloneDecl: st.typing.declIdOfType typeId: cloneId
            if cloneDecl.notZero then {
                st.reg.setGeneric typeId: cloneId value: true
                st.reg.copyGenericParams from: chDecl to: cloneDecl
            }
        }
    }
    return deep
}

# copyMemberMarkers -- a marker belongs to the MEMBER, and every use site asks
# the INSTANCE about it, so ownership and lock-field marks and the default are
# copied from the template's member onto the mono's. True when the member's own
# type gives the mono a destructor.
copyMemberMarkers: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    mid: ztypes.tid
    templateId: ztypes.tid
    chName: StringView
    # the member's name, interned: the key its markers are read and copied under
    chNameId: zast.nameid
    target: ztypes.tid
} out bool is {
    monoNeedsDtor: false
    # A marker belongs to the MEMBER, and every use site asks the
    # INSTANCE type about it -- so it has to be copied onto the clone
    # or it is enforced on the template alone, which nothing checks.
    # So does a default: a field the template gives one is optional in
    # every instance's construction.
    cho: st.typing.declOwnershipOfId parentTypeId: templateId nameId: chNameId
    dft: st.typing.declDefaultOfId parentTypeId: templateId nameId: chNameId
    # a template arm written `(Box t)` is a cell in every instance
    tplArm: st.typing.armKey parentTypeId: templateId nameId: chNameId
    if (st.walk.boxedArms.has item: tplArm) then {
        monoArm: st.typing.armKey parentTypeId: mid nameId: chNameId
        st.walk.boxedArms.add item: monoArm
    }
    if dft.none.not then {
        st.typing.declSetDefaultId parentTypeId: mid nameId: chNameId value: dft
    }
    if cho.some then {
        st.typing.setChildOwnership pool: ast.names parentTypeId: mid name: chName ownership: cho
    }
    if (st.typing.declIsBorrowedFieldId parentTypeId: templateId nameId: chNameId) then null else {
        if (st.reg.needsDestructor typeId: target) then monoNeedsDtor = true
    }
    return monoNeedsDtor
}

# collapseBoxArm -- THE BOX RULE at instantiation: a union arm whose substituted
# type is a builtin Box mono collapses to the ELEMENT, exactly as a declared
# `(Box T)` arm does. A boxed arm is a malloc'd cell on the void* data slot,
# so the collapse keeps construction, match narrowing, the destructor cast and
# the native io fragments' layout on the element -- a Box value IS the cell
# pointer. Answers the type the arm should carry.
collapseBoxArm: function {
    st: zenv.ZSymbolTable.view
    tt: ztypes.ztypetype
    argTid: ztypes.tid
} out ztypes.tid is {
    target: argTid
    if tt == ztypes.ztypetype.unionType then {
        boxArg: ztypes.tid
        boxOrigin: st.reg.genericOriginOf tid: target
        if boxOrigin.notZero then boxArg = boxOrigin
        isBoxed: isBoxTemplate :st tid: boxArg
        if isBoxed when (st.reg.genericArgCount specId: target) == 1 then {
            target = st.reg.genericTypeArgAt specId: target ordinal: 0
        }
    }
    return target
}

# elidedArgFallbackTid -- with the leading type argument elided, a member whose
# own type is one of the template's parameters and was left unsubstituted takes
# the single argument that was given. Answers the type the member should carry;
# any other member -- a function, a concrete type, an instance of another
# generic -- keeps its own.
elidedArgFallbackTid: function {
    st: zenv.ZSymbolTable
    templateId: ztypes.tid
    fallbackArg: ztypes.tid
    chId: ztypes.tid
    argTid: ztypes.tid
} out ztypes.tid is {
    if fallbackArg.isZero or (argTid != chId) then return argTid
    tdecl: st.typing.declIdOfType typeId: templateId
    if tdecl.isZero then return argTid
    pn: st.reg.genericParamNameOfTid :tdecl ptid: chId
    if pn.isZero then return argTid
    return fallbackArg
}

# substitutedMemberTid -- the type a template member resolves to for this
# instance: the id the argument map gives it, a respecialised nested generic,
# or, for a type declared beside the template (a generic unit's own types),
# the instance's copy of it; the member's own type when nothing substitutes.
substitutedMemberTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    rf: ztypes.declid
    templateId: ztypes.tid
    chId: ztypes.tid
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
} out ztypes.tid is {
    target: chId
    ido: idTypeSubOf :idSubs key: chId
    match (
        ido
    ) case some then {
        target = ido
    } case none then {
        rsp: respecialize :st scope: rf :ast :unitDecl specTid: chId :idSubs
        if rsp.notZero then target = rsp
    }
    if target == chId then {
        sk: siblingKeyOf :st :templateId tid: chId
        if sk.notZero then target = (subs.get key: sk).or d: target
    }
    return target
}

# siblingKeyOf -- the key an instance's substitutions hold `tid` under when it
# belongs to the template `templateId`: one of its generic parameters, or a type
# declared beside it (in the same generic unit); 0 for a type declared anywhere
# else, whatever it is spelled.
siblingKeyOf: function {
    st: zenv.ZSymbolTable.view
    templateId: ztypes.tid
    tid: ztypes.tid
} out zast.nameid is {
    td: templateDeclOf reg: st.reg typing: st.typing tid: templateId
    if td.isZero then return zast.nameid
    pn: st.reg.genericParamNameOfTid tdecl: td ptid: tid
    if pn.notZero then return pn
    d: templateDeclOf reg: st.reg typing: st.typing :tid
    if d.isZero then return zast.nameid
    if (
        (st.typing.declParentOf declId: d) != (st.typing.declParentOf declId: td)
    ) then return zast.nameid
    return (st.typing.decls.get i: d).name
}

# mintMonoMember -- give one member of a monomorphised type its substituted
# type: the argument the template parameter resolved to, the mono of a nested
# generic, or the member's own type when nothing substitutes. True when the
# member's type gives the mono a destructor.
mintMonoMember: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    rf: ztypes.declid
    templateId: ztypes.tid
    mid: ztypes.tid
    tt: ztypes.ztypetype
    fallbackArg: ztypes.tid
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
    chName: StringView
    # the member's name, interned: the key the instance's member is set under
    chNameId: zast.nameid
    chId: ztypes.tid
} out bool is {
    monoNeedsDtor: false
    target: substitutedMemberTid :ast :st :unitDecl :rf :templateId :chId :subs :idSubs
    # A VALTYPE HOLDS VALUE DATA ONLY at instantiation: a bound the kinds do
    # not classify (a facet) admits any argument, so a reftype can reach a
    # record field or a variant arm here that refuseReftypeBounds could not
    # see at the template. Only what the ARGUMENT brought in is judged: a
    # member the substitution left alone (a concrete field, an implementation row
    # such as str's `:StringViewable`) was the declaration's business, and a native
    # template's layout is the runtime's.
    isVrM: tt.isValueData
    if isVrM when target != chId when (st.reg.isNativeOf tid: templateId).not when (
        (st.reg.typetypeOf typeId: chId) != ztypes.ztypetype.functionType
    ) when (st.reg.isReftypeOf tid: target) then {
        anM: specWrittenName :st :ast tid: target
        tnM: specWrittenName :st :ast tid: templateId
        mgM: "generic argument '\{anM}' cannot be a record field or variant arm of '\{tnM}'"
        declare.addResolveError :st e: zast.err.genericError msg: mgM
    }
    # THE BOX RULE at instantiation: a union arm whose substituted type
    # is a builtin Box mono collapses to the ELEMENT, exactly as a
    # declared (Box T) arm does, and is recorded as boxed: a heap cell on
    # the void* data slot, which keeps construction, match narrowing, the
    # destructor cast and the native io fragments' layout on the element --
    # a Box value IS the cell pointer.
    preBox: target
    target = collapseBoxArm :st :tt argTid: target
    if target != preBox then {
        st.walk.boxedArms.add item: (st.typing.armKey parentTypeId: mid nameId: chNameId)
    }
    # generic function children are the clone candidates below
    childIsFunction: (st.reg.typetypeOf typeId: chId) == ztypes.ztypetype.functionType
    childIsGeneric: false
    if childIsFunction then {
        childIsGeneric = st.reg.isGenericOf tid: chId
    }
    target = elidedArgFallbackTid :st :templateId :fallbackArg :chId argTid: target
    deep: false
    if target == chId when childIsGeneric when (
        cloneGenericMemberInto
        :ast
        :st
        :unitDecl
        :rf
        :templateId
        :mid
        :chName
        :chNameId
        :chId
        :idSubs
    ) then deep = true
    if deep.not then {
        st.typing.setMemberType parentTypeId: mid nameId: chNameId childTypeId: target
    }
    if (st.reg.typetypeOf typeId: chId) != ztypes.ztypetype.functionType when (
        copyMemberMarkers
        :ast
        :st
        :mid
        :templateId
        :chName
        :chNameId
        :target
    ) then monoNeedsDtor = true
    return monoNeedsDtor
}

# isBoxTemplate -- `tid` is the system Box template: the class the system unit
# declares as `Box`, which declares no members (its instances do). Asked of the
# declaration, so a program's own `Box` is never it; the system's Box is never
# resolved here, which would mint its tid early and renumber later type ids.
isBoxTemplate: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    if ((st.reg.typetypeOf typeId: tid) == ztypes.ztypetype.classType).not then return false
    d: st.typing.declIdOfType typeId: tid
    if (st.typing.decls.get i: d).name != zast.wellKnown.slot.tyBox then return false
    if (numerics.declaredBySystem typing: st.typing declId: d).not then return false
    return (st.typing.declMemberCount ownerTid: tid) == 0
}

# mintMonoRecordShape -- give a monomorphised user RECORD or CLASS the
# field-wise constructor its template does not write, which the emitter fills
# as it fills a plain type's. A `create` the template writes was cloned onto the
# instance already and is kept. A numeric generic parameter is no field of it:
# its value is a constant the mono records.
mintMonoRecordShape: function {
    ast: Ast
    st: zenv.ZSymbolTable
    templateId: ztypes.tid
    mid: ztypes.tid
    tt: ztypes.ztypetype
} is {
    # the system Box is `is native` -- the runtime owns its layout, a pointer --
    # but is constructed like a user class: its instances take the one element
    isUserClass: (
        (tt == ztypes.ztypetype.classType) and
        ((st.reg.isNativeOf tid: templateId).not or (isBoxTemplate :st tid: templateId))
    )
    if (tt == ztypes.ztypetype.recordType) or isUserClass then {
        isSized: stdtypes.isSizedTemplate :ast :st tid: templateId
        # a `create` the TEMPLATE writes was cloned onto the instance; a record
        # template's synthesised one names the template's own field types and
        # is replaced
        written: (
            st.typing.declChildOfId
            parentTypeId: templateId
            nameId: zast.wellKnown.slot.wkCreate
        ).some
        if written then {
            written = (
                st.typing.declMemberIsSynth
                parentTypeId: templateId
                nameId: zast.wellKnown.slot.wkCreate
            ).not
        }
        # `create: null` on the template: its instances construct in no spelling
        optOut: (callchecks.typeDefinesConstruction :st tid: templateId).not
        if isSized.not when written.not when optOut.not then {
            crId: (
                st.reg.newType
                name: "create"
                ownerTid: mid
                typetype: ztypes.ztypetype.functionType
            )
            (
                st.typing.declSynthMember
                parentTypeId: mid
                nameId: zast.wellKnown.slot.wkCreate
                kind: ztyping.declkind.methodDecl
            )
            (
                st.typing.setMemberType
                parentTypeId: mid
                nameId: zast.wellKnown.slot.wkCreate
                childTypeId: crId
            )
            conform.materializeCreateParams :st :ast typeTid: mid createId: crId
        }
    }
}

# completeIdSubs -- the substitutions of `mid` keyed by a template parameter id
# that resolving the template's members minted after the instance's map was
# built: under `--eager` a unit first reached from a body is instantiated
# before its turn, and its members, resolved now, mint the ids they name
completeIdSubs: function {
    st: zenv.ZSymbolTable
    templateId: ztypes.tid
    mid: ztypes.tid
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
} is {
    td: templateDeclOf reg: st.reg typing: st.typing tid: templateId
    if td.isZero then return
    pns: st.reg.genericParamNamesOf tdecl: td
    k: u64
    for k < pns.length loop {
        pn: pns.get i: k
        po: st.reg.genericParamTidOf tdecl: td paramName: pn
        if po.some when (idSubs.has key: po).not when (
            k < (st.reg.genericArgCount specId: mid)
        ) then {
            idSubs.set key: po value: (st.reg.genericArgAt specId: mid ordinal: k)
        }
        # a numeric parameter is its instance's singleton type, whose value a
        # numeric level reads back (respecialize)
        sg: st.typing.singletonOf instance: mid param: pn
        if po.some when sg.notZero then idSubs.set key: po value: ztypes.genericarg.typeArg sg
        k = k + 1
    }
}

# mintMonoMembers -- give every member of a monomorphised type its substituted
# type. True when any of them gives the mono a destructor.
mintMonoMembers: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    rf: ztypes.declid
    templateId: ztypes.tid
    mid: ztypes.tid
    tt: ztypes.ztypetype
    fallbackArg: ztypes.tid
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
} out bool is {
    cNames: List String
    cNameIds: ListVal zast.nameid
    cIds: ListVal ztypes.tid
    conform.forceAllMembers :st :ast tid: templateId
    completeIdSubs :st :templateId :mid :idSubs
    # a template resolved on demand is copied at once, and the copy reads its
    # members' signatures off their stamped type-refs
    resolve.stampResolvedOnDemand :st :ast
    {
        mmq: u64
        mmn: st.typing.declRowSlots ownerTid: templateId
        for mmq < mmn loop {
            rwMm: st.typing.declRowAt ownerTid: templateId membersOnly: true slot: mmq
            mmq = mmq + 1
            if rwMm.keep then {
                cIds.append rwMm.tid
                cNameIds.append rwMm.name
                memberName: ast.names.texts.get i: rwMm.name
                cn: memberName.copy
                cNames.append cn
            }
        }
    }
    monoNeedsDtor: false
    ci: u64
    cn3: cNames.length
    for ci < cn3 loop {
        chNameC: cNames.get i: ci
        if (
            mintMonoMember
            :ast
            :st
            :unitDecl
            :rf
            :templateId
            :mid
            :tt
            :fallbackArg
            :subs
            :idSubs
            chName: chNameC.stringView
            chNameId: (cNameIds.get i: ci)
            chId: (cIds.get i: ci)
        ) then monoNeedsDtor = true
        ci = ci + 1
    }
    return monoNeedsDtor
}


# copyReturnMarkers -- the markers a function's signature records about what it
# returns -- `.borrow`, `.view`, a frozen result, `outx` -- carried onto a copy
# of it: a generic function's instance, a generic type's method clone, a generic
# unit instance's copy of the unit's function. Each answers the call site and
# its own body's return checks as the function does.
copyReturnMarkers: function {st: zenv.ZSymbolTable fromFn: ztypes.tid toFn: ztypes.tid} is {
    m: st.typing.funcReturnMarker.get key: fromFn
    if m.some then st.typing.funcReturnMarker.set key: toFn value: m
    if (st.typing.funcPins.has item: fromFn) then st.typing.funcPins.add item: toFn
}

# mintMono -- populate one generic-instance type: the template's typetype and
# valtype flag, genericOriginId linking back, and the instance's children -- the template's children with generic-param targets
# substituted (matched by arg name; fallbackArg substitutes every child, the
# single-type-param call-site inference) -- plus the synthesized members: a
# per-instance tag data type (variants and unions) and the autogen ==/!=
# functions (variants). Childless templates (the collection classes) produce
# no children; their cloned method children land with the class-mono slice.
mintMono: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    name: StringView
    templateId: ztypes.tid
    subs: (IdMapV zast.nameid v: ztypes.tid)
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
    fallbackArg: ztypes.tid
    monoTid: ztypes.tid
} is {
    # a specialisation's members resolve in the TEMPLATE's scope, with the
    # argument substitution -- lexical scoping; the instantiating unit is
    # not where the template's names live
    rf: scope
    td: templateDeclOf reg: st.reg typing: st.typing tid: templateId
    if td.notZero then rf = td
    tt: ztypes.ztypetype.recordType
    vto: optionval.none bool
    tplNative: false
    if templateId < st.reg.nextTid then {
        tpl: st.reg.typeById.get i: templateId
        tt = tpl.typetype
        vto = tpl.isValtype
        tplNative = tpl.isNative
    }
    mid: monoTid
    if vto.some then {
        st.reg.setValtype typeId: mid value: vto
    }
    st.reg.setGenericOrigin typeId: mid value: templateId
    # an instance of a generic method takes its receiver where the template
    # does, under the name the template gives it
    st.reg.setThisParamName typeId: mid nameId: (st.reg.thisParamNameIdOf tid: templateId)
    declMonoType :st monoTid: mid :templateId
    mintMonoTypedefBase :ast :st :unitDecl :rf :templateId :mid :subs :idSubs
    # a function's instance returns what its template says it returns, a
    # reference or not, as a method's clone does
    if tt == ztypes.ztypetype.functionType then {
        copyReturnMarkers :st fromFn: templateId toFn: mid
    }
    st.reg.setNative typeId: mid value: tplNative
    if tt == ztypes.ztypetype.classType then st.reg.setIsHeapAllocated typeId: mid
    # A heap-owning generic instance carries a destructor (so a holder/local
    # frees it; the emitter builds the cname). Collections own native heap;
    # Option/Result own a heap box. A user generic whose template already has a
    # destructor inherits one. Map/Set own native heap too (freed via a `&`-less
    # heap-pointer destroy), and IdMap/IdSet own their two arrays but not their
    # header, so they free like a List does. Views (ListView/OptionView) own no
    # heap -- excluded.
    needsDtorM: stdtypes.templateNeedsMonoDtor :ast :st :templateId
    if needsDtorM or (stdtypes.unionMonoNeedsDtor :ast :st :templateId :tt) then {
        st.reg.setNeedsDestructor typeId: mid
    }
    # An elided leading type argument stages under the empty name; rebind it
    # to the template's primary generic parameter so the substituted children
    # resolve (`(List String)` == `(List of: String)`).
    {
        emptyKey: zast.nameid
        ev: subs.get key: emptyKey
        if ev.some then {
            prnm: firstGenericParamId :st :templateId
            if prnm.notZero then subs.set key: prnm value: ev
        }
    }
    monoNeedsDtor: (
        mintMonoMembers
        :ast
        :st
        :unitDecl
        :rf
        :templateId
        :mid
        :tt
        :fallbackArg
        :subs
        :idSubs
    )
    # A user generic CLASS whose SUBSTITUTED fields are destructible carries
    # an auto-destructor, exactly like its non-generic counterpart (the
    # builtin-template list above cannot see through substitution; without
    # this, `class { val: t }` with t=String leaks its payload).
    if tt == ztypes.ztypetype.classType when monoNeedsDtor when (
        st.reg.needsDestructor
        typeId: mid
    ).not then {
        st.reg.setNeedsDestructor typeId: mid
    }
    # RECORD instances: the meta-create requalifies to the instance -- except
    # str/array, whose branches own their members.
    mintMonoRecordShape :ast :st :templateId :mid :tt
    declare.mintMonoTagShape :st :mid :tt :name
    declare.synthInstanceValueMembers :ast :st :templateId :mid :tt
    mintSpecInstanceShape :st :mid :tt
}

# mintSpecInstanceShape -- an instance of a generic protocol or facet is the
# interface a non-generic one is: it takes the `create` resolveProtocol and
# resolveFacet synthesise for one (a generic template has none, so the
# instance copied none), and a protocol instance the destructor every protocol
# has, for the box an owning one holds.
mintSpecInstanceShape: function {st: zenv.ZSymbolTable mid: ztypes.tid tt: ztypes.ztypetype} is {
    if tt != ztypes.ztypetype.protocolType when tt != ztypes.ztypetype.facetType then return
    mt: mid
    if (st.typing.declHasMemberId parentTypeId: mt nameId: zast.wellKnown.slot.wkCreate).not then {
        createId: (
            st.reg.newType
            name: "create"
            ownerTid: mid
            typetype: ztypes.ztypetype.functionType
        )
        (
            st.typing.declSynthMemberTyped
            parentTypeId: mt
            nameId: zast.wellKnown.slot.wkCreate
            kind: ztyping.declkind.methodDecl
            childTypeId: createId
        )
    }
    if tt == ztypes.ztypetype.protocolType then st.reg.setNeedsDestructor typeId: mt
}

# mintMonoTypedefBase -- an instance of a generic typedef wraps the instance of
# its base: the template's partial base (`List t`) respecialised under this
# instance's arguments (`List String`), and the base's name, which is what
# the emitter asks to know a typedef. It frees what its base frees.
mintMonoTypedefBase: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    rf: ztypes.declid
    templateId: ztypes.tid
    mid: ztypes.tid
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
} is {
    tb: st.typing.typedefBaseTidOf tid: templateId
    if tb.isZero then return
    mt: mid
    # a base argument the base's own parameter refuses is this instance's
    # error, reported where the instance is named; the base is minted
    # quietly, so its members still answer and nothing repeats the refusal
    savedMode: st.mode
    cl: typedefBaseClash :ast :st base: tb :idSubs
    if cl.argTid.notZero then {
        st.walk.typedefClash.set key: mid value: cl
        st.mode.quietBounds = true
    }
    target: substitutedMemberTid :ast :st :unitDecl :rf :templateId chId: tb :subs :idSubs
    st.mode = savedMode
    bn: zast.nameid
    tmpl: st.typing.typedefBase.get key: templateId
    if tmpl.some then bn = tmpl.name
    st.typing.typedefBase.set key: mt value: (ztyping.typedefbase name: bn tid: target)
    if (st.reg.needsDestructor typeId: target) then {
        st.reg.setNeedsDestructor typeId: mt
    }
}

# typedefBaseClash -- the first argument a generic typedef's partial base
# (`List t`) takes from this instance's substitution that the base's own
# parameter refuses; a zero argTid when every one is admitted.
typedefBaseClash: function {
    ast: Ast
    st: zenv.ZSymbolTable
    base: ztypes.tid
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg).view
} out ztyping.typedefclash is {
    none: (
        ztyping.typedefclash
        baseDecl: ztypes.declid
        paramName: zast.nameid
        argTid: ztypes.tid
        reported: false
    )
    if (st.reg.isPartialOf tid: base).not then return none
    bd: st.typing.declIdOfType typeId: (st.reg.genericOriginOf tid: base)
    if bd.isZero then return none
    pn: st.reg.genericParamNamesOf tdecl: bd
    n: st.reg.genericArgCount specId: base
    if pn.length < n then n = pn.length
    i: u64
    for i < n loop {
        ta: st.reg.genericTypeArgAt specId: base ordinal: i
        if ta.notZero then {
            a: ta
            sa: (idTypeSubOf :idSubs key: a).or d: a
            p: pn.get :i
            at: sa
            if (conform.constraintAdmits :ast :st tdecl: bd paramName: p argTid: at).not then {
                return (ztyping.typedefclash baseDecl: bd paramName: p argTid: at reported: false)
            }
        }
        i = i + 1
    }
    return none
}


# specLookup -- the existing specialization of `templateId` over the ordered
# concrete arguments `args`, read straight off the id trie getOrMintSpec builds.
# Lookup only: it never mints, so a caller can ask whether an instance was
# demanded. Parameters past `args` take their defaults, as the written
# application `(ListVal u8)` does; 0 when any argument is unset, an omitted
# parameter has no recorded default, or the path is not in the trie -- a walk
# that stops at an interior node names no instance.
specLookup: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    templateId: ztypes.tid
    args: (ListVal ztypes.tid).view
} out ztypes.tid is {
    if templateId.isZero then return ztypes.tid.zero
    if args.length == 0 then return ztypes.tid.zero
    cur: templateId
    ok: true
    for each a: args loop {
        if ok then {
            if a.isZero then {
                ok = false
            } else {
                n: reg.getGenericChild parentId: cur key: ztypes.genericarg.typeArg a
                match (
                    n
                ) case some then {
                    cur = n
                } case none then {
                    ok = false
                }
            }
        }
    }
    if ok.not then return ztypes.tid.zero
    if (reg.isTrieNodeOf tid: cur).not then return cur
    return (specLookupDefaults :reg :typing :templateId node: cur from: args.length)
}

# specLookupDefaults -- specLookup past the written arguments: from the trie
# node `node` the walk reached, one level per remaining parameter of
# `templateId`, each keyed on the type its default named. 0 when one has no
# recorded default or its level is missing.
specLookupDefaults: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    templateId: ztypes.tid
    node: ztypes.tid
    # the first parameter no argument was written for
    from: u64
} out ztypes.tid is {
    tdecl: typing.declIdOfType typeId: templateId
    cur: node
    pi: from
    for pi < (reg.genericParamCountOf :tdecl) loop {
        d: reg.genericParamDefaultTidAt :tdecl i: pi
        if d.isZero then return ztypes.tid
        n: reg.getGenericChild parentId: cur key: ztypes.genericarg.typeArg d
        match (
            n
        ) case some then {
            cur = n
        } case none then {
            return ztypes.tid
        }
        pi = pi + 1
    }
    if (reg.isTrieNodeOf tid: cur) then return ztypes.tid
    return cur
}

# declOperationOf -- the definition node a declaration's namedoperation holds;
# zero for a declaration with none.
declOperationOf: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out zast.nodeid is {
    dn: (st.typing.decls.get i: declId).node
    if dn.isZero then return dn
    nop: ast.nodes.get i: dn
    if nop.namedoperation then return nop.operation
    return zast.nodeid
}


# typeIsNumberOf -- the type's chain-end base is a builtin integer type (`float`
# false) or float type (`float` true), which is what `staticmember` admits of
# numbers. Asked by kind rather than through a variant of the types, which would
# reach every one of them -- and with i128 and f128 their helpers and
# libquadmath -- in every program that names the bound.
typeIsNumberOf: function {
    st: zenv.ZSymbolTable
    tid: ztypes.tid
    float: bool
} out bool is {
    if tid.isZero then return false
    ktd: conform.typedefChaseTid typing: st.typing :tid
    nk: numerics.numKindOfTid typing: st.typing tid: ktd
    if nk.has.not then return false
    return (ztypes.isFloatKind k: nk.kind) == float
}

# mintSpecUnderTemplate -- build the spec's children, LAST, and the trie edge laid
# above is why: building them respecializes, which re-enters getOrMintSpec for this
# very instantiation, and before the edge existed that re-entry found nothing and
# minted a SECOND spec under the same name -- which the emitter then emitted
# beside the first.
mintSpecUnderTemplate: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    name: StringView
    templateId: ztypes.tid
    mid8: ztypes.tid
    subs: (IdMapV zast.nameid v: ztypes.tid)
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
    fallbackArg: ztypes.tid
} out ztypes.tid is {
    {
        (
            mintMono
            :st
            :scope
            :ast
            :unitDecl
            :name
            :templateId
            :subs
            :idSubs
            :fallbackArg
            monoTid: mid8
        )
        # a Box spec minted from TYPE POSITION (a field's or a union's type
        # argument) registers the identity the construction path stamps: isBox
        # drives typeRefC's bare-pointer rendering, and the cell it points at
        # is the holder's to free. The member copy stays with construction --
        # nothing reads members off an un-constructed Box.
        if (isBoxTemplate :st tid: templateId) then {
            st.reg.setIsBox typeId: mid8
            st.reg.setIsHeapAllocated typeId: mid8
            st.reg.setNeedsDestructor typeId: mid8
        }
    }
    return mid8
}

# bindSpecDefaults -- getOrMintSpec's arguments completed for a template with
# defaults, so its instance keys on EVERY parameter: `fallbackArg` binds the
# first unbound parameter with no default (the one argument an internal mint
# such as a comprehension's list passes), and every other unbound parameter
# takes its default, adding its label component to `sfx`. A default refused
# is reported at the default and leaves its parameter unbound.
bindSpecDefaults: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tk8: ztypes.declid
    paramNames: (ListVal zast.nameid).view
    subs: (IdMapV zast.nameid v: ztypes.tid)
    valSubs: (IdMapV zast.nameid v: u64)
    fallbackArg: ztypes.tid
    sfx: String
} is {
    if fallbackArg.notZero then {
        for each pn: paramNames loop {
            if (subs.has key: pn).not when (valSubs.has key: pn).not when (
                st.reg.genericParamConstraintOf
                tdecl: tk8
                paramName: pn
            ).defaultNode.isZero then {
                subs.set key: pn value: fallbackArg
                break
            }
        }
    }
    fillGenericDefaults :st :ast tdecl: tk8 :subs :valSubs :sfx
}

# buildSpecTrieKeys -- the arguments that key this spec's levels of the id trie, in
# the template's DECLARATION order. Answers false when one cannot be settled, in
# which case the trie is not consulted at all.
buildSpecTrieKeys: function {
    ast: Ast
    st: zenv.ZSymbolTable
    paramNames: (ListVal zast.nameid).view
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    valSubs: (IdMapV zast.nameid v: u64).view
    fallbackArg: ztypes.tid
    args: ListVal ztypes.genericarg
    tk8: ztypes.declid
} out bool is {
    trieOk: true
    if paramNames.length == 0 then {
        # The template's arity is unreadable here -- its parameters are keyed by
        # the DEFINITION's Decl, and a canonical mint made before the unit roots
        # existed links `def` at a proxy instead. The loop below is skipped in
        # that case, so NOTHING in subs/valSubs reaches the key and the fallback
        # can only stand in for a template taking ONE argument. Where the caller
        # supplies more, keying on the fallback alone would hand two different
        # instantiations the SAME spec -- a silent conflation. Refuse the trie
        # instead: that at worst emits one instance twice, each under its own id.
        argCount: subs.length + valSubs.length
        if fallbackArg.notZero when argCount <= 1 then {
            args.append (ztypes.genericarg.typeArg fallbackArg)
        } else {
            trieOk = false
        }
    }
    for each pn8: paramNames loop {
        a8: paramArgOf :st tdecl: tk8 pnm: pn8 :subs :valSubs
        match (
            a8
        ) case some then {
            match (
                a8
            ) case typeArg then {
                (
                    conform.checkConstraintSat
                    :st
                    :ast
                    tdecl: tk8
                    paramName: pn8
                    argTid: a8
                    at: zast.nodeid
                    lineno: 0
                    colno: 0
                )
            } case valueArg then null
            args.append a8
        } case none then {
            if fallbackArg.notZero when paramNames.length == 1 then {
                args.append (ztypes.genericarg.typeArg fallbackArg)
            } else {
                trieOk = false
            }
        }
    }
    (
        conform.checkPartialBounds
        :st
        :ast
        unitDecl: (unitRootOfDecl typing: st.typing declId: tk8)
        tdecl: tk8
        pnames: paramNames
        :subs
        at: zast.nodeid
        lineno: 0
        colno: 0
    )
    return trieOk
}

# registerSpecOnTrie -- lay the trie edge for a spec BEFORE its children are built,
# and record its generic-argument rows. The edge has to exist first: building the
# children respecializes, which re-enters getOrMintSpec for this very
# instantiation and must find the spec rather than mint a second one.
registerSpecOnTrie: function {
    st: zenv.ZSymbolTable
    name: StringView
    templateId: ztypes.tid
    mid8: ztypes.tid
    args: (ListVal ztypes.genericarg).view
} is {
    cur: templateId
    ki: u64
    kn: args.length
    for ki < kn loop {
        k: args.get i: ki
        last: false
        if (ki + 1) == kn then last = true
        n: st.reg.getGenericChild parentId: cur key: k
        step: ztypes.tid
        match (
            n
        ) case some then {
            step = n
        } case none then {
            if last then {
                step = mid8
            } else {
                # An interior node wears GENERIC_PARAM like a partial does and
                # carries a key PREFIX in genericArgs, so arity and typetype
                # tell them apart from nothing. What does is the ORIGIN: a
                # partial sets one, a node never has. Keep it that way --
                # respecialize's only guard against walking a node is that
                # origin being zero.
                step = st.reg.newType :name typetype: ztypes.ztypetype.genericParam
                st.reg.setTrieNode typeId: step value: true
                kj: u64
                for kj <= ki loop {
                    st.reg.appendGenericArg specId: step arg: (args.get i: kj)
                    kj = kj + 1
                }
            }
            st.reg.setGenericChild parentId: cur key: k child: step
        }
        cur = step
        ki = ki + 1
    }
    for each a: args loop st.reg.appendGenericArg specId: mid8 arg: a
}

# recordNumericArgConsts -- each numeric generic argument of a mono recorded as
# the compile-time value of its parameter on the mono, typed by the bound: the
# value channel a read of the parameter through the mono answers from.
recordNumericArgConsts: function {
    ast: Ast
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    monoId: ztypes.tid
    tdecl: ztypes.declid
} is {
    # most monos key on types alone, and the name list allocates
    hasValue: false
    ac: st.reg.genericArgCount specId: monoId
    ai: u64
    for ai < ac loop {
        if (st.reg.genericValueArgAt specId: monoId ordinal: ai).some then hasValue = true
        ai = ai + 1
    }
    if hasValue.not then return
    pn: st.reg.genericParamNamesOf :tdecl
    pi: u64
    for pi < pn.length loop {
        vg: st.reg.genericValueArgAt specId: monoId ordinal: pi
        if vg.some then {
            pnm: pn.get i: pi
            cd: st.reg.genericParamConstraintOf :tdecl paramName: pnm
            bt: numericBoundTid :ast :st :scope :cd
            if bt.notZero then {
                bits: vg
                (
                    st.typing.setMemberConst
                    parentTypeId: monoId
                    nameId: pnm
                    value: (
                        ztypes.typedConst
                        c: (ztypes.makeIntConst v: (ztypes.bitsI64 b: bits))
                        numTid: bt
                    )
                )
            }
        }
        pi = pi + 1
    }
}

# mintNumericSingletons -- each numeric generic argument of the instance
# `monoId` as its parameter's singleton type: a typedef over the parameter's
# bound, owned by the instance and named by the parameter, whose one value is
# the argument. A compiler-provided template's instance (array, str) has none.
mintNumericSingletons: function {
    ast: Ast
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    monoId: ztypes.tid
    tdecl: ztypes.declid
} is {
    if (st.reg.isNativeOf tid: (st.reg.genericOriginOf tid: monoId)) then return
    hasValue: false
    ac: st.reg.genericArgCount specId: monoId
    ai: u64
    for ai < ac loop {
        if (st.reg.genericValueArgAt specId: monoId ordinal: ai).some then hasValue = true
        ai = ai + 1
    }
    if hasValue.not then return
    pn: st.reg.genericParamNamesOf :tdecl
    pi: u64
    for pi < pn.length loop {
        vg: st.reg.genericValueArgAt specId: monoId ordinal: pi
        pnm: pn.get i: pi
        pi = pi + 1
        if vg.some when (st.typing.singletonOf instance: monoId param: pnm).isZero then {
            cd: st.reg.genericParamConstraintOf :tdecl paramName: pnm
            bt: numericBoundTid :ast :st :scope :cd
            if bt.notZero then {
                bits: vg
                pt: zast.nameTextCopy :ast ref: pnm
                s: (
                    st.reg.newType
                    name: pt.stringView
                    typetype: (st.reg.typetypeOf typeId: bt)
                    ownerTid: monoId
                )
                st.reg.setValtype typeId: s value: true
                bn: st.reg.nameOf tid: bt
                bnId: zast.poolFind pool: ast.names text: bn.stringView
                st.typing.typedefBase.set key: s value: (ztyping.typedefbase name: bnId tid: bt)
                v: ztypes.typedConst c: (ztypes.makeIntConst v: (ztypes.bitsI64 b: bits)) numTid: s
                (
                    st.typing.singletons.set
                    key: s
                    value: (ztyping.singleton instance: monoId param: pnm value: v)
                )
                st.typing.singletonAt.set key: (ztyping.constslot owner: monoId name: pnm) value: s
            }
        }
    }
}

# shareUnitSingletons -- an instance `monoId` of the template `tdecl` written in a
# generic unit takes, for each numeric parameter it inherits from the unit, the
# singleton type of the unit's instance `encl` (0 for none): the same parameter
# of the same instance is one type. mintNumericSingletons then mints only the
# template's own.
shareUnitSingletons: function {
    st: zenv.ZSymbolTable
    tdecl: ztypes.declid
    encl: ztypes.tid
    monoId: ztypes.tid
} is {
    if encl.isZero then return
    for each pn: (st.reg.genericParamNamesOf tdecl: (st.typing.declParentOf declId: tdecl)) loop {
        s: st.typing.singletonOf instance: encl param: pn
        if s.notZero then (
            st.typing.singletonAt.set
            key: (ztyping.constslot owner: monoId name: pn)
            value: s
        )
    }
}

# unitHasNumericParams -- the declaration `tdecl` (0 for none) has a numeric
# generic parameter, which a template written in it inherits.
unitHasNumericParams: function {st: zenv.ZSymbolTable.view tdecl: ztypes.declid} out bool is {
    if tdecl.isZero then return false
    return (st.reg.genericNumericParamCountOf :tdecl) > 0
}

# numericLevelKeyedByParam -- whether a spec's keys put a generic parameter's
# type at a numeric parameter's level: a reference inside a template over its
# own numeric parameter.
numericLevelKeyedByParam: function {
    st: zenv.ZSymbolTable.view
    tk8: ztypes.declid
    paramNames: (ListVal zast.nameid).view
    args: (ListVal ztypes.genericarg).view
} out bool is {
    pi: u64
    for pi < paramNames.length loop {
        if pi < args.length when (args.get i: pi).typeArg when (
            st.reg.genericParamConstraintOf
            tdecl: tk8
            paramName: (paramNames.get i: pi)
        ).numKind.has then return true
        pi = pi + 1
    }
    return false
}

# mintValuePartialSpec -- the partial such a reference is: the template's
# arguments recorded, a generic parameter among them, and no trie entry.
mintValuePartialSpec: function {
    st: zenv.ZSymbolTable
    templateId: ztypes.tid
    sfx: StringView
    args: (ListVal ztypes.genericarg).view
} out ztypes.tid is {
    mn: "\{st.reg.nameOf tid: templateId}\{sfx}"
    mid: st.reg.newType name: mn.stringView typetype: ztypes.ztypetype.genericParam
    st.reg.setGenericOrigin typeId: mid value: templateId
    st.reg.setPartial typeId: mid value: true
    for each a: args loop st.reg.appendGenericArg specId: mid arg: a
    return mid
}

# buildSpecIdSubs -- the same substitutions the trie keys carry, keyed by the
# template's generic-parameter DECLARATION ids rather than by name. A parameter
# whose id no member has minted yet is left out; completeIdSubs adds it once
# the members are resolved.
buildSpecIdSubs: function {
    st: zenv.ZSymbolTable.view
    paramNames: (ListVal zast.nameid).view
    args: (ListVal ztypes.genericarg).view
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
    tk8: ztypes.declid
} is {
    pi8: u64
    pt8: paramNames.length
    for pi8 < pt8 loop {
        paramName: paramNames.get i: pi8
        # a numeric parameter's value substitutes too: a reference over the
        # parameter inside the template completes with it
        paramTid: st.reg.genericParamTidOf tdecl: tk8 :paramName
        if paramTid.some then {
            idSubs.set key: paramTid value: (args.get i: pi8)
        }
        pi8 = pi8 + 1
    }
}


# getOrMintSpec -- the id-keyed specialization tree front door: derive the
# definition-order argument keys from the name-keyed subs (fallbackArg fills a
# single missing parameter), walk the generic-child edges, and return the existing
# spec on a full-path hit. A parameter absent from subs with no fallback (a
# numeric value parameter -- str/array's `to`) skips the tree entirely, so
# nothing dedups it. On a miss the leaf materializes via mintMono, a unit
# template's through ensureUnitInstanceMono, which builds it; multi-level
# paths mint intermediate nodes (genericOriginId = template, genericArgs =
# the key prefix) that cache partial paths without being emitted.
# checkConstraintSat -- a specialization argument against its parameter's
# declared constraint. Numeric bounds, which never reach the tree, pass;
# value-kind constraints check the registry's isValtypeOf / isReftypeOf; StringLike
# checks membership. GENERIC_PARAM args skip -- partial specs re-check on
# completion. Location-free (the spec front door holds no source node).
getOrMintSpec: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    sfx: StringView
    templateId: ztypes.tid
    subs: (IdMapV zast.nameid v: ztypes.tid)
    valSubs: (IdMapV zast.nameid v: u64)
    fallbackArg: ztypes.tid
} out ztypes.tid is {
    # the label's HEAD is the template's own DECLARED name, never the spelling
    # a caller reached it by. A type has one declaration and any number of
    # aliases, so an alias -- `List` for `collections.ListRef`, or a user's
    # own -- must not decide what the mono is called, and which mint site wins
    # the trie must not decide it either. Callers pass only the argument
    # suffix, which is theirs to compose.
    tk8: templateDeclOf reg: st.reg typing: st.typing tid: templateId
    paramNames: st.reg.genericParamNamesOf tdecl: tk8
    # An elided leading type argument stages under the empty name; rebind it
    # to the primary generic parameter before the trie keys and idSubs build
    # (mintMono's own rebind happens after both).
    {
        emptyKey: zast.nameid
        ev8: subs.get key: emptyKey
        if ev8.some then {
            primaryParam: firstGenericParamId :st :templateId
            if primaryParam.notZero then subs.set key: primaryParam value: ev8
        }
        emptyValue: valSubs.get key: emptyKey
        if emptyValue.some then {
            primaryValueParam: firstGenericParamId :st :templateId
            if primaryValueParam.notZero then (
                valSubs.set
                key: primaryValueParam
                value: emptyValue
            )
        }
    }
    # the label components the defaults add, after the caller's own
    defaultSuffix: String
    # a list template's parameters are all bound here, at the run-time types
    # their literals materialise to, so no literal default names the instance
    materialiseStaticListArgs :st :ast :templateId pnames: paramNames :subs
    if (templateHasDefaults :st tdecl: tk8) then {
        bindSpecDefaults :st :ast :tk8 :paramNames :subs :valSubs :fallbackArg sfx: defaultSuffix
    }
    args: ListVal ztypes.genericarg
    trieOk: buildSpecTrieKeys :ast :st :tk8 :paramNames :subs :valSubs :fallbackArg :args
    # a numeric level keyed by a generic parameter is a partial that stays off
    # the trie, where a value and a type id could coincide
    if trieOk when (numericLevelKeyedByParam :st :tk8 :paramNames :args) then {
        return (mintValuePartialSpec :st :templateId :sfx :args)
    }
    if trieOk then {
        cur: templateId
        ki8: u64
        kn8: args.length
        hit: true
        for ki8 < kn8 loop {
            k8: args.get i: ki8
            n8: st.reg.getGenericChild parentId: cur key: k8
            match (
                n8
            ) case some then {
                cur = n8
            } case none then {
                hit = false
                ki8 = kn8
            }
            ki8 = ki8 + 1
        }
        if hit then {
            return cur
        }
    }
    # composed only past the trie, because a HIT never reads it: the label is
    # decided once, where the spec is minted
    mn8: "\{st.reg.nameOf tid: templateId}\{sfx}\{defaultSuffix}"
    if trieOk then {
        defaultsCut: typeargs.defaultsTailLength :st :ast :tk8 :args label: mn8.stringView
        if defaultsCut > 0 then mn8 = "\{mn8.substring from: 0 to: mn8.length - defaultsCut}"
    }
    idSubs: IdMapV ztypes.tid v: ztypes.genericarg
    if trieOk then buildSpecIdSubs :st :paramNames :args :idSubs :tk8
    # A generic-parameter argument makes the spec partial -- and so does a
    # nested PARTIAL argument, which wears the same tag. Both readings are
    # wanted here and the tag is what carries both: narrowing this to
    # isPartialOf would stop `(Cell :t)` being partial, narrowing it to a
    # bare-parameter test would stop `(A (B :t))` being partial one level up.
    hasParamKey: false
    if trieOk then {
        for each a: args loop {
            match (
                a
            ) case typeArg then {
                if (
                    (st.reg.typetypeOf typeId: a) == ztypes.ztypetype.genericParam
                ) then hasParamKey = true
            } case valueArg then null
        }
    }
    # a unit template's instance is minted and built where every unit instance
    # is: an instance without its members owes walks no visit can settle
    if trieOk when hasParamKey.not when (
        (templateTypetypeOf :st :templateId) == ztypes.ztypetype.unitType
    ) then {
        return (
            ensureUnitInstanceMono
            :st
            :scope
            :ast
            tplId: templateId
            tdecl: tk8
            :subs
            :valSubs
            label: mn8
        )
    }
    mid8: ztypes.tid
    if hasParamKey then {
        # a generic-param arg makes the spec PARTIAL: a trie-only entry that
        # is never emitted or name-registered; the clone-side respecialize
        # completes it with concrete args per instance. It carries the same
        # label as any other spec -- `isPartial` on the row is what says it is
        # one, and the dump has that as its own column.
        mid8 = st.reg.newType name: mn8.stringView typetype: ztypes.ztypetype.genericParam
        st.reg.setGenericOrigin typeId: mid8 value: templateId
        st.reg.setPartial typeId: mid8 value: true
    } else {
        mid8 = st.reg.newType name: mn8.stringView typetype: (templateTypetypeOf :st :templateId)
    }
    if trieOk when mid8.notZero then {
        registerSpecOnTrie :st name: mn8.stringView :templateId :mid8 :args
        recordNumericArgConsts :ast :st :scope monoId: mid8 tdecl: tk8
        # a partial's value arguments complete per instance: it has no singletons
        if hasParamKey.not then {
            if (unitHasNumericParams :st tdecl: (st.typing.declParentOf declId: tk8)) then (
                shareUnitSingletons
                :st
                tdecl: tk8
                encl: (enclosingInstanceOf :st :scope :ast tdecl: tk8 :subs :valSubs)
                monoId: mid8
            )
            mintNumericSingletons :ast :st :scope monoId: mid8 tdecl: tk8
        }
    }
    # The children are built LAST, and the trie path above is why. Building
    # them respecializes, which re-enters this function for this very
    # instantiation; before the edge existed that re-entry found nothing and
    # minted a SECOND spec under the same name, which the emitter then emitted
    # beside the first.
    if hasParamKey.not then mid8 = (
        mintSpecUnderTemplate
        :ast
        :st
        :unitDecl
        :scope
        name: mn8.stringView
        :templateId
        :mid8
        :subs
        :idSubs
        :fallbackArg
    )
    completes: trieOk
    if hasParamKey then completes = false
    if mid8.isZero then completes = false
    if completes then {
        stdtypes.completeSpecChildren :ast :st :templateId :mid8
        recordNumericDefaults :st ownerTid: mid8 :templateId
    }
    return mid8
}

# materialiseStaticListArgs -- a list type's arguments at the run-time types its
# literals become: an untyped element is an i64, or an f64 for an untyped float,
# and an untyped index a u64, as an untyped list's value is `(staticlist i64 i: u64)`.
# A parameter left out takes its default, which is the literal type, so it is
# bound here too -- the instance is named by what it holds, and a literal type
# reaches no instance, so the emitter never sees one. The parameters are read by
# position: the element first, then the index.
materialiseStaticListArgs: function {
    st: zenv.ZSymbolTable
    ast: Ast
    templateId: ztypes.tid
    pnames: (ListVal zast.nameid).view
    subs: (IdMapV zast.nameid v: ztypes.tid)
} is {
    if pnames.length == 0 then return
    # READ, not resolved: every instance of every template passes here, and a
    # template no program named cannot be this one
    if templateId != (stdtypes.stdTidRo :ast :st wk: zast.wellKnown.slot.tyStaticlist) then return
    k: u64
    for k < pnames.length loop {
        pn: pnames.get i: k
        v: (subs.get key: pn).or d: ztypes.tid.zero
        if v == st.reg.literalTextTid then {
            subs.set key: pn value: (stdTid :ast :st wk: zast.wellKnown.slot.tyText)
        } else if v.isZero or (isLiteralTypeId reg: st.reg tid: v) then {
            float: v == st.reg.literalFloatTid
            subs.set key: pn value: (materialTid :ast :st isElem: k == 0 :float)
        }
        k = k + 1
    }
}

# materialTid -- the run-time type an untyped data argument becomes: an element
# is an i64, or an f64 when it is a float; an index is a u64.
materialTid: function {ast: Ast st: zenv.ZSymbolTable isElem: bool float: bool} out ztypes.tid is {
    if isElem.not then return (stdTid :ast :st wk: zast.wellKnown.slot.tyU64)
    if float then return (stdTid :ast :st wk: zast.wellKnown.slot.tyF64)
    return (stdTid :ast :st wk: zast.wellKnown.slot.tyI64)
}


# firstGenericParamId -- the primary (first-declared) generic parameter name
# of a template as a pool id, 0 when it has none. Binds an elided leading type
# argument (`(List String)` == `(List of: String)`) to its parameter.
firstGenericParamId: function {
    st: zenv.ZSymbolTable.view
    templateId: ztypes.tid
} out zast.nameid is {
    tk: st.typing.declIdOfType typeId: templateId
    names: st.reg.genericParamNamesOf tdecl: tk
    if names.length > 0 then return (names.get i: 0)
    return zast.nameid
}

# constructionArgTid -- the type a construction's type ARGUMENT names. An
# argument that is ITSELF an instantiation -- `(Pair t: (Cell t: i64))` -- has
# no name of its own, so a name lookup finds its HEAD and hands back the bare
# template. That is not just a wrong label: the template is what gets recorded
# as the argument and what keys the trie, so two different nested arguments
# collapse onto one mono, and a field typed by the parameter then names a type
# nothing ever emits. Resolve the instantiation first, through the same
# disassembly the type-position path uses; every other shape falls through to
# the name it spells.
constructionArgTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    opId: zast.nodeid
    baseId: zast.nameid
} out ztypes.tid is {
    # an alias reached through its type (`Tree.Node`)
    tpa: dottedArgAliasTid :st :ast :opId
    if tpa.notZero then return tpa
    inlineTid: (
        resolve.resolveMonoRefInline
        :st
        scope: st.curScope
        :ast
        :unitDecl
        thisName: ""
        enclDecl: ztypes.declid
        opNid: opId
        nid: zast.nodeid
    )
    if inlineTid.notZero then return (instanceTypeOf :st :ast :unitDecl tid: inlineTid)
    named: bodyTypeNameTid :st :ast :unitDecl nameId: baseId nid: opId
    # `type` names the instance being checked; any other name of a generic type
    # takes its arguments
    selfNameId: bodySelfTypeNameId :st nameId: baseId
    if selfNameId != baseId then {
        sa: selfApplicationTid :st :ast :unitDecl scope: st.curScope templateId: named nid: opId
        if sa.notZero then return (instanceTypeOf :st :ast :unitDecl tid: sa)
    } else {
        named = (
            bareGenericType
            :st
            :ast
            :unitDecl
            tid: named
            nid: opId
            scope: st.curScope
            thisName: ""
        )
    }
    return (instanceTypeOf :st :ast :unitDecl tid: named)
}

# bodyTypeNameTid -- the type a bare name denotes as a type argument written in
# a body: a type parameter of a declaration enclosing the body first, since it
# shadows any type of that name, then a type the scope reaches. 0 when it
# denotes none.
bodyTypeNameTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    nameId: zast.nameid
    nid: zast.nodeid
} out ztypes.tid is {
    # a local or a parameter of the name is nearer than any type: the name is
    # that value, and denotes none (refuseValueTypeArg refuses it where a type
    # must be)
    if (st.findLocal :nameId).notZero then return ztypes.tid.zero
    bn: bodySelfTypeNameId :st :nameId
    gp: declare.genericParamInScope :st :ast scope: st.curScope nameId: bn :nid
    if gp.notZero then return gp
    return (
        (walkLookupTyperefById :st scope: st.curScope :ast :unitDecl baseId: bn).or
        d: ztypes.tid.zero
    )
}

# bodySelfTypeNameId -- the name `nameId` spells in a body, with `type` read as
# the enclosing type's name: a predefined identifier naming the parent object
# (spec, Predefined identifiers) means in a method's body what it means in the
# method's signature. A local named `type` redefines it; outside a type's
# members, and for any other name, the name answers itself.
bodySelfTypeNameId: function {
    st: zenv.ZSymbolTable
    nameId: zast.nameid
} out zast.nameid is {
    if nameId.isZero then return nameId
    if (nameId == zast.wellKnown.slot.wkType).not then return nameId
    if (st.lookupVarId :nameId).some then return nameId
    td: callchecks.enclosingTypeDecl :st scope: st.curScope
    if td.isZero then return nameId
    return (st.typing.decls.get i: td).name
}

# idTypeSubOf -- the type an id substitution gives the generic parameter `key`;
# none when it gives none, or gives a value (a numeric parameter substitutes
# no type).
idTypeSubOf: function {
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg).view
    key: ztypes.tid
} out optionval ztypes.tid is {
    g: idSubs.get :key
    if g.some then {
        match (
            g
        ) case typeArg then {
            return (optionval.some g)
        } case valueArg then null
    }
    return (optionval.none ztypes.tid)
}

# instanceTypeOf -- a type a body walk resolved, as the instance being walked
# sees it: a generic parameter is the instance's argument, and a specialization
# over one specializes again with it. The type itself outside an instance walk.
instanceTypeOf: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    tid: ztypes.tid
} out ztypes.tid is {
    if tid.isZero then return ztypes.tid.zero
    if st.typing.curMonoStamp.isZero then return tid
    flat: monoSubstTid :st :tid
    if flat != tid then return flat
    if (st.reg.genericArgCount specId: flat) == 0 then return tid
    subs: IdMapV ztypes.tid v: ztypes.genericarg
    si: u64
    for si < st.walk.monoParamSubst.length loop {
        sk: st.walk.monoParamSubst.keyAt i: si
        sv: (st.walk.monoParamSubst.valueAt i: si).or d: sk
        subs.set key: sk value: ztypes.genericarg.typeArg sv
        si = si + 1
    }
    bindMonoValueParams :st monoId: st.typing.curMonoStamp :subs
    rsp: respecialize :st scope: st.curScope :ast :unitDecl specTid: tid idSubs: subs
    if rsp.notZero then return rsp
    return tid
}

# bindMonoValueParams -- the value half of bindMonoParams, into `subs`: each
# numeric parameter's GENERIC_PARAM to the instance's value, so a partial over
# one (`(Bx t: t cap: cap)`) respecializes to the instance. Kept out of
# monoParamSubst, which maps types to types.
bindMonoValueParams: function {
    st: zenv.ZSymbolTable
    monoId: ztypes.tid
    subs: (IdMapV ztypes.tid v: ztypes.genericarg)
} is {
    morig: st.reg.genericOriginOf tid: monoId
    if morig.isZero then return
    tdecl: st.typing.declIdOfType typeId: morig
    pn: st.reg.genericParamNamesOf :tdecl
    pj: u64
    for pj < pn.length loop {
        vg: st.reg.genericValueArgAt specId: monoId ordinal: pj
        if vg.some then {
            pto: st.reg.genericParamTidOf :tdecl paramName: (pn.get i: pj)
            if pto.some then {
                subs.set key: pto value: ztypes.genericarg.valueArg vg
            }
        }
        pj = pj + 1
    }
}

# dottedArgAliasTid -- the target of the alias a body's type argument names
# through its type (`ListVal t: Tree.Node`); 0 for any other argument.
dottedArgAliasTid: function {st: zenv.ZSymbolTable ast: Ast opId: zast.nodeid} out ztypes.tid is {
    par: zast.nodeid
    chd: zast.nodeid
    {
        n: ast.nodes.get i: opId
        if n.dottedpath then {
            par = n.parent
            chd = n.child
        }
    }
    if par.isZero then return ztypes.tid.zero
    return (
        typePathAliasTid
        :st
        :ast
        scope: st.curScope
        parentNid: par
        leafId: (atomNameId :ast n: (ast.nodes.get i: chd))
        nid: opId
    )
}

# inferConstructionSubs -- infer a generic construction's type arguments from the
# values it is given. The value-arg walk is a DRY RUN: its ownership effects (take
# overlays, borrow locks) are bracketed in a scope discarded whole, so the real
# ctor walk re-checks from a clean slate -- an explicit `.take` argument otherwise
# collides with its own inference pass.
inferConstructionSubs: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    primaryName: zast.nameid
    fNames: (ListVal zast.nameid).view
    fParams: (ListVal zast.nameid).view
    # the rows typed over the params, and their types
    ptNames: (ListVal zast.nameid).view
    ptTids: (ListVal ztypes.tid).view
    sfx: String
    subs: (IdMapV zast.nameid v: ztypes.tid)
    valueSubs: (IdMapV zast.nameid v: u64)
    boundParams: IdSet zast.nameid
    tk: ztypes.declid
} is {
    st.pushDryRun
    kAiter: u64
    for kAiter < call.nargs loop {
        argId: zast.callArgAt :ast nid: call.nid i: kAiter
        (
            typeargs.inferConstructionArg
            :st
            :unitDecl
            :ast
            :argId
            argIdx: kAiter
            :primaryName
            :fNames
            :fParams
            :ptNames
            :ptTids
            :sfx
            :subs
            :valueSubs
            :boundParams
            :tk
        )
        kAiter = kAiter + 1
    }
}

# stageRowsOf -- the names and types of the member rows of `ownerTid` (none when
# 0).
stageRowsOf: function {
    st: zenv.ZSymbolTable.view
    ownerTid: ztypes.tid
    names: ListVal zast.nameid
    tids: ListVal ztypes.tid
} is {
    if ownerTid.isZero then return
    ri: u64
    rn: st.typing.declRowSlots :ownerTid
    for ri < rn loop {
        rw: st.typing.declRowAt :ownerTid membersOnly: true slot: ri
        ri = ri + 1
        if rw.keep then {
            names.append rw.name
            tids.append rw.tid
        }
    }
}

# classifyInferenceRows -- which of a template's rows infer its params: one
# typed as a bare param binds it by name (`fNames`/`fParams`), and one typed as
# a type application over the params (`(ListVal t: t)`, `(slot t: t)`) binds
# them from the argument's own arguments (`ptNames`/`ptTids`).
classifyInferenceRows: function {
    st: zenv.ZSymbolTable.view
    tk: ztypes.declid
    childNames: (ListVal zast.nameid).view
    rowTids: (ListVal ztypes.tid).view
    fNames: ListVal zast.nameid
    fParams: ListVal zast.nameid
    ptNames: ListVal zast.nameid
    ptTids: ListVal ztypes.tid
} is {
    ci3: u64
    for ci3 < rowTids.length loop {
        rowTid: rowTids.get i: ci3
        # a row typed by one of the template's own parameters, by id: a type
        # merely spelled like one (`lib.T`) is no parameter
        paramName: st.reg.genericParamNameOfTid tdecl: tk ptid: rowTid
        if paramName.notZero then {
            fNames.append (childNames.get i: ci3)
            fParams.append paramName
        } else if (st.reg.isPartialOf tid: rowTid) then {
            ptNames.append (childNames.get i: ci3)
            ptTids.append rowTid
        }
        ci3 = ci3 + 1
    }
}

# inferGenericConstruction -- a generic class/record template called with
# field-bound value arguments: labels naming generic params resolve as
# explicit type args; other args walk as values and bind their field's
# param (literals materialise + restamp the bare node). The deduped
# instance mints with substituted fields plus a synthesized create.
# 0 when nothing infers.
inferGenericConstruction: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    tplId: ztypes.tid
    reportMissing: bool
} out ztypes.tid is {
    tname: st.reg.nameOf tid: tplId
    if tname.length == 0 then return ztypes.tid.zero
    tk: st.typing.declIdOfType typeId: tplId
    # Stage the template's children, then keep the ones whose TYPE NAME is a
    # registered generic param (field shells carry the param name, not a
    # GENERIC_PARAM typetype).
    childNames: ListVal zast.nameid
    rowTids: ListVal ztypes.tid
    # a create the template writes is what its construction calls, so its
    # parameters infer first; the fields still do, so a field label written
    # against it mints the instance whose call reports the label
    (
        stageRowsOf
        :st
        ownerTid: (typeargs.writtenTemplateCreate :st templateId: tplId)
        names: childNames
        tids: rowTids
    )
    stageRowsOf :st ownerTid: tplId names: childNames tids: rowTids
    fNames: ListVal zast.nameid
    fParams: ListVal zast.nameid
    ptNames: ListVal zast.nameid
    ptTids: ListVal ztypes.tid
    classifyInferenceRows :st :tk :childNames :rowTids :fNames :fParams :ptNames :ptTids
    sfx: String
    subs: IdMapV zast.nameid v: ztypes.tid
    valueSubs: IdMapV zast.nameid v: u64
    boundParams: IdSet zast.nameid
    primaryName: firstGenericParamId :st templateId: tplId
    # the unit's parameters a template written in a generic unit takes are
    # bound by what the construction reaches it through, before any value
    # could infer them; their part of the label follows the inferred one's
    if (refuseInheritedLabel :st :ast :tplId :call) then return ztypes.tid.zero
    isfx: String
    if (
        bindInheritedParams
        :st
        :ast
        :unitDecl
        scope: st.curScope
        :tplId
        typeSubs: subs
        valSubs: valueSubs
        sfx: isfx
        at: call.callable
        walked: true
    ).not then {
        return ztypes.tid.zero
    }
    enI: st.typing.errors.length
    (
        inferConstructionSubs
        :st
        :unitDecl
        :ast
        :call
        :primaryName
        :fNames
        :fParams
        :ptNames
        :ptTids
        :sfx
        :subs
        :valueSubs
        :boundParams
        :tk
    )
    st.popDiscard
    # an argument refused on the way said why: inference would only report the
    # parameter it was written for again, as one it cannot infer, and a type
    # minted without it would read the argument once more as a field
    if st.typing.errors.length > enI then return ztypes.tid.zero
    sfx.append s: isfx
    # a parameter no argument names takes its default
    if (fillGenericDefaults :st :ast tdecl: tk :subs valSubs: valueSubs :sfx).not then {
        return ztypes.tid.zero
    }
    if (
        typeargs.constructionParamMissing
        :st
        :ast
        :call
        tdecl: tk
        :subs
        :valueSubs
        :boundParams
        :sfx
        tname: tname.stringView
        :reportMissing
    ) then {
        return ztypes.tid.zero
    }
    paramsM: st.reg.genericParamNamesOf tdecl: tk
    pmn: paramsM.length
    if sfx.length == 0 then return ztypes.tid.zero
    # a numeric parameter bound with no value was refused, and is reported
    {
        pvi: u64
        for pvi < pmn loop {
            pvName: paramsM.get i: pvi
            pvi = pvi + 1
            pvNumeric: (st.reg.genericParamConstraintOf tdecl: tk paramName: pvName).numKind.has
            if pvNumeric when (valueSubs.has key: pvName).not then return ztypes.tid
        }
    }
    mid: (
        getOrMintSpec
        :st
        scope: st.curScope
        :ast
        :unitDecl
        sfx: sfx.stringView
        templateId: tplId
        :subs
        valSubs: valueSubs
        fallbackArg: ztypes.tid.zero
    )
    if mid.isZero then return ztypes.tid.zero
    noteMonoSite :st mono: mid :call :unitDecl
    forceMemberOf :st :ast parentTypeId: mid nameId: zast.wellKnown.slot.wkCreate
    cro: st.typing.declChildOfId parentTypeId: mid nameId: zast.wellKnown.slot.wkCreate
    match (
        cro
    ) case some then null case none then {
        crId: st.reg.newType name: "create" ownerTid: mid typetype: ztypes.ztypetype.functionType
        (
            st.typing.declSynthMember
            parentTypeId: mid
            nameId: zast.wellKnown.slot.wkCreate
            kind: ztyping.declkind.methodDecl
        )
        (
            st.typing.setMemberType
            parentTypeId: mid
            nameId: zast.wellKnown.slot.wkCreate
            childTypeId: crId
        )
    }
    callchecks.stampConstructionKind :st nid: call.nid tid: mid
    return mid
}

# checkCapacityArg -- `capacity:` written inside a container's type application is
# create's argument, so it is checked as one: a name nothing declares, and a
# value that does not fit create's `capacity: u64`, are the call's diagnostics.
checkCapacityArg: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    argId: zast.nodeid
    argOpId: zast.nodeid
} is {
    errC: st.typing.errors.length
    vt: checkValueAt :st :unitDecl :ast nid: argOpId
    if st.typing.errors.length != errC then return
    if vt.isZero then {
        ubn: unresolvedBareCallable :ast :st :unitDecl nid: argOpId
        if ubn.length > 0 then reportUnknownNameAt :st :ast nid: argOpId name: ubn
        return
    }
    u64t: stdTid :ast :st wk: zast.wellKnown.slot.tyU64
    (
        numerics.checkArgTypeMismatch
        :st
        :ast
        ptid: u64t
        :vt
        pnId: zast.wellKnown.slot.wkCapacity
        arg: (argRefAt :ast nid: argId)
    )
}


# numargstate -- what reading a numeric generic argument found.
numargstate: variant {
    # a compile-time integer that stands in for the parameter's type
    value: null
    # no value, and the reason is reported
    refused: null
    # no value in this walk, because the argument reads a numeric generic
    # parameter of the template being walked: each instance's walk has one
    dependent: null
} as { tag: u8.tag }

# numarg -- one numeric generic argument, read.
numarg: record {
    # whether it has a value
    state: numargstate
    # the value as two's-complement bits, read by the bound's signedness
    bits: u64
}

# numericGenericArgRead -- the value written for numeric generic parameter
# `param` of the template `tdecl`. The
# argument is any compile-time integer -- a literal, a constant, an expression
# of constants -- read through the constant evaluator, and it stands in for the
# parameter's integer type as a body argument would: an untyped literal by its
# value, a typed constant without loss. Anything else is refused here, naming
# the parameter; a refusal is reported once, however many paths ask.
numericGenericArgRead: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    tdecl: ztypes.declid
    param: zast.nameid
    argOp: zast.nodeid
    # the argument is written in a body, where a name can read a local
    inBody: bool
} out numarg is {
    refused: numarg state: numargstate.refused bits: 0
    cd: st.reg.genericParamConstraintOf :tdecl paramName: param
    if cd.numKind.has.not then return refused
    nameId: zast.nameid
    an: ast.nodes.get i: argOp
    nameId = atomNameId :ast n: an
    v: ztypes.noConst
    if nameId.notZero when (isNumericLiteralNameAt :ast ref: nameId) then {
        lt: zast.nameTextAt :ast ref: nameId
        v = consteval.constLiteralValue :st name: lt.stringView
    } else {
        fold: numericArgFold :ast :st :unitDecl :scope :tdecl :param :argOp :nameId :inBody
        if fold.reported then return refused
        v = fold.v
        if v.kind.none when (constReadsNumericParam :st :ast owner: scope opId: argOp) then {
            return (numarg state: numargstate.dependent bits: 0)
        }
    }
    if (numericArgHasInteger :ast :st :unitDecl :scope :tdecl :param :argOp :nameId :v
    ).not then return refused
    if (consteval.numericArgStandsIn :ast :st :scope :tdecl :param :argOp :cd :v
    ).not then return refused
    return (numarg state: numargstate.value bits: (constBits64 :st :v))
}

# constBits64 -- an integer constant's low 64 bits, two's complement: the bits a
# numeric generic argument carries. A value that stood in for its bound fits
# 64 bits, a u64 above i64 included.
constBits64: function {st: zenv.ZSymbolTable.view v: ztypes.cval} out u64 is {
    if v.bigId == 0 then return (ztypes.i64Bits v: v.ival)
    b: consteval.constBigOf typing: st.typing :v
    if b.words.length == 0 then return 0
    w: b.words.get i: 0
    if b.negative then return w.not + 1
    return w
}

# argfold -- a non-literal numeric generic argument evaluated: its value, or
# that its refusal is already reported.
argfold: record {
    # the value; none when it has none
    v: ztypes.cval
    # a reason for no value was reported
    reported: bool
}

# numericArgFold -- a numeric generic argument that is not a literal, evaluated.
# In a body a bare name that reads a local is a run-time value, and any other
# expression is walked first, so a local inside it is known for one and an
# unknown name is the walk's to report.
numericArgFold: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    tdecl: ztypes.declid
    param: zast.nameid
    argOp: zast.nodeid
    nameId: zast.nameid
    inBody: bool
} out argfold is {
    if inBody when nameId.notZero when (st.findLocal :nameId).notZero then {
        reportNumericArg :ast :st :tdecl :param :argOp :nameId why: "is a run-time value"
        return (argfold v: ztypes.noConst reported: true)
    }
    errBefore: st.typing.errors.length
    if inBody when nameId.isZero then checkValueAt :st :unitDecl :ast nid: argOp
    if st.typing.errors.length > errBefore then return (argfold v: ztypes.noConst reported: true)
    held: st.walk.constFail
    constFailClear :st
    v: evalConstNode :st :unitDecl :scope :ast nid: argOp
    f: st.walk.constFail
    st.walk.constFail = held
    if v.kind.none when f.failed then {
        consteval.renderConstFail :st :f
        return (argfold v: ztypes.noConst reported: true)
    }
    return (argfold v: (singletonAsBound :st :v) reported: false)
}

# numericArgHasInteger -- whether the argument's value is an integer, reporting
# why when it is not: a name nothing declares, no value at all, or a value of
# another kind.
numericArgHasInteger: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    tdecl: ztypes.declid
    param: zast.nameid
    argOp: zast.nodeid
    nameId: zast.nameid
    v: ztypes.cval
} out bool is {
    if v.kind.ivalKind then return true
    if v.isConst then {
        reportNumericArg :ast :st :tdecl :param :argOp :nameId why: "is not an integer"
        return false
    }
    known: walkLookupTyperefById :st :scope :ast :unitDecl baseId: nameId
    if nameId.notZero when known.none then {
        nt: zast.nameTextCopy :ast ref: nameId
        reportUnknownNameAt :st :ast nid: argOp name: nt
        return false
    }
    reportNumericArg :ast :st :tdecl :param :argOp :nameId why: "has no compile-time value"
    return false
}

# numericBoundTid -- the scalar type a numeric generic parameter's bound names,
# 0 when it names none.
numericBoundTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    cd: ztypes.constraintdesc
} out ztypes.tid is {
    if cd.numKind.has.not then return ztypes.tid
    bn: ztypes.numkindName k: cd.numKind.kind
    return (scalarTidOf :st :scope :ast nameId: (nameIdOf :ast name: bn.stringView))
}

# reportNumericArg -- the E0600 for a numeric generic argument that is not a
# compile-time integer: what the argument is, and the parameter it was written
# for.
reportNumericArg: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    tdecl: ztypes.declid
    param: zast.nameid
    argOp: zast.nodeid
    # the argument's name when it is a bare name, else 0
    nameId: zast.nameid
    why: StringView
} is {
    pn: zast.nameTextAt :ast ref: param
    tn: specWrittenName :st :ast tid: (st.typing.declTypeOf declId: tdecl)
    what: "the argument".string
    w: 1.u32
    if nameId.notZero then {
        at: zast.nameTextAt :ast ref: nameId
        what = "'\{at}'"
        w = at.length.u32.orPanic
    }
    n: ast.nodes.get i: argOp
    (
        addErrorWithHint
        :st
        nodeid: (nodeId :n)
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.constError
        msg: "\{what} \{why}: generic parameter '\{pn}' of '\{tn}' takes a compile-time integer"
        note: String
        hint: "write a literal, a constant, or an expression of constants".string
        width: w
    )
}


# genericTypeConstruction -- a generic TYPE template in callable position
# with type-name arguments constructs its mono in place (`(List of: String)`
# in value position): resolve each argument as a type, mint the deduped mono
# with its chains and children, and the call's
# value is the mono.
genericTypeConstruction: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    call: callref
    tplId: ztypes.tid
} out ztypes.tid is {
    tname: st.reg.nameOf tid: tplId
    if tname.length == 0 then return ztypes.tid.zero
    tk0: st.typing.declIdOfType typeId: tplId
    sfx: String
    subs: IdMapV zast.nameid v: ztypes.tid
    valueSubs: IdMapV zast.nameid v: u64
    primaryName: firstGenericParamId :st templateId: tplId
    firstOut: ListVal ztypes.tid
    prevDep: st.walk.numericArgDependent
    st.walk.numericArgDependent = false
    anyMiss: (
        typeargs.collectGenericTypeArgs
        :ast
        :st
        :unitDecl
        :call
        :tplId
        :primaryName
        :sfx
        :subs
        :valueSubs
        :tk0
        :firstOut
    )
    dependent: st.walk.numericArgDependent
    st.walk.numericArgDependent = prevDep
    if anyMiss then return ztypes.tid.zero
    if dependent then return (valuePartialConstruction :st :ast :call :tplId)
    firstA: firstOut.get i: 0
    if sfx.length == 0 then return ztypes.tid.zero
    if (
        bindInheritedParams
        :st
        :ast
        :unitDecl
        scope: st.curScope
        :tplId
        typeSubs: subs
        valSubs: valueSubs
        :sfx
        at: call.callable
        walked: true
    ).not then {
        return ztypes.tid.zero
    }
    if (
        fillApplicationDefaults
        :st
        :ast
        :tplId
        typeSubs: subs
        valSubs: valueSubs
        :sfx
        :firstA
    ).not then {
        return ztypes.tid.zero
    }
    if (
        typeargs.refuseIncompleteApplication
        :st
        :ast
        :tplId
        typeSubs: subs
        valSubsR: valueSubs
        :firstA
        at: call.callable
    ) then {
        return ztypes.tid.zero
    }
    # a UNIT applied in place is that unit's instance -- the same one a
    # unit-level binding with these arguments names -- not a value to construct
    if (st.reg.typetypeOf typeId: tplId) == ztypes.ztypetype.unitType then {
        um: (
            ensureUnitInstanceMono
            :st
            scope: st.curScope
            :ast
            :tplId
            tdecl: tk0
            :subs
            valSubs: valueSubs
            label: "\{tname}\{sfx}"
        )
        if um.notZero then stampGate :st nid: call.nid tid: um
        return um
    }
    mid: (
        getOrMintSpec
        :st
        scope: st.curScope
        :ast
        :unitDecl
        sfx: sfx.stringView
        templateId: tplId
        :subs
        valSubs: valueSubs
        fallbackArg: firstA
    )
    if mid.isZero then return ztypes.tid.zero
    noteMonoSite :st mono: mid :call :unitDecl
    resolve.reportTypedefClash :ast :st tid: mid at: call.nid lineno: call.lineno colno: call.colno
    if (stdtypes.isSizedTemplate :ast :st tid: tplId) then {
        stdtypes.mintCollectionChildren :st :ast monoId: mid templateId: tplId
    }
    # Only a bare-atom callable restamps to the instance; a dotted callable
    # (the .str conversion form) leaves the path unstamped.
    gcb: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: (ast.nodes.get i: call.callable))
    gcal: nodeId n: (ast.nodes.get i: call.callable)
    if gcal.notZero when gcb.length > 0 then {
        setga: mid
        stampGate :st nid: gcal tid: setga
    }
    setgt: mid
    stampGate :st nid: call.nid tid: setgt
    st.typing.callKind.set key: call.nid value: zast.callkind.classCreate
    return mid
}

# valuePartialConstruction -- a construction whose numeric generic argument
# reads a parameter of the template being walked, in the walk with no instance:
# a partial of the template, one per construction, which its members are read
# through. Each instance's walk has the value and mints the concrete type.
valuePartialConstruction: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    call: callref
    tplId: ztypes.tid
} out ztypes.tid is {
    mid: (st.walk.valuePartialAt.get key: call.nid).or d: ztypes.tid
    if mid.isZero then {
        # a copy: a view into the registry cannot be handed to the call that
        # grows it
        tplNm: st.reg.nameOf tid: tplId
        mid = st.reg.newType name: tplNm.stringView typetype: ztypes.ztypetype.genericParam
        st.reg.setGenericOrigin typeId: mid value: tplId
        st.reg.setPartial typeId: mid value: true
        st.walk.valuePartialAt.set key: call.nid value: mid
    }
    gcal: nodeId n: (ast.nodes.get i: call.callable)
    if gcal.notZero then stampGate :st nid: gcal tid: mid
    stampGate :st nid: call.nid tid: mid
    st.typing.callKind.set key: call.nid value: zast.callkind.classCreate
    return mid
}


# dottedBaseIsValue -- whether the base of the dotted path `n` is a VALUE rather
# than a TYPE: the one question both a member's namespace and a call's receiver
# are settled by, and settled by what the base NAMES, never by its shape. A call
# result is a value unless the call is a type application (`(ListVal i64).create`)
# -- a construction is a value; a name or a path is a value unless it resolves to
# a type. Reading every name
# the local lookup missed as a type made `(mk).plus n: 3` -- a call of `mk` --
# demand a receiver the dot had already handed over.
dottedBaseIsValue: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    n: astnode.view
} out bool is {
    baseId: zast.nodeid
    callableId: zast.nodeid
    match (
        n
    ) case dottedpath then {
        baseId = n.parent
    } else null
    if baseId.isZero then return true
    # a numeric parameter's value, read bare or through a name of its type
    if (st.typing.numericParamRead.has key: baseId) then return true
    bn: ast.nodes.get i: baseId
    if bn.call then callableId = bn.callable
    # the answer is recorded on the base for the emitter: a member read through
    # a TYPE is the type's own, never a receiver's
    if callableId.notZero then {
        if (nodeNamesType :st :ast :unitDecl nid: callableId).not then return true
        cbi: callBuildsInstance :st :ast :unitDecl nid: baseId
        if cbi.not then st.typing.dpTypeBase.add item: baseId
        return cbi
    }
    if (nodeNamesType :st :ast :unitDecl nid: baseId) then {
        st.typing.dpTypeBase.add item: baseId
        return false
    }
    return true
}

# callBuildsInstance -- the call at `nid`, whose callee names a type, builds an
# instance rather than naming one: some argument is labelled with a name that is
# none of the type's generic parameters -- a field, a create parameter. A
# construction is a call like any other, so `(Cell n: 2).show` reads the
# instance it builds; reading every call whose callee named a type as a type
# demanded a receiver the dot had already handed over. A type given its generic
# parameters alone -- `(ListVal i64)`, `(array t: i64 to: 4)` -- names one
callBuildsInstance: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out bool is {
    call: callRefAt :ast :nid
    tpl: (
        typeargs.typeApplicationTemplate
        :st
        scope: st.curScope
        :ast
        :unitDecl
        callableNid: call.callable
    )
    tk: st.typing.declIdOfType typeId: tpl
    k: u64
    for k < call.nargs loop {
        arg: argRefAt :ast nid: (zast.callArgAt :ast :nid i: k)
        k = k + 1
        if arg.nid.notZero when arg.name.notZero when (
            st.reg.isGenericParamOf
            tdecl: tk
            name: arg.name
        ).not then return true
    }
    return false
}

# nodeNamesType -- the name or path at `nid` resolves to a TYPE: a bare name no
# open scope defines that the environment finds as a type, or a path whose member
# is a type declaration (`other.T`). A local of the same name shadows the type,
# and a numeric literal interns like a name but names nothing.
nodeNamesType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out bool is {
    nameId: zast.nameid
    isPath: false
    {
        nn: ast.nodes.get i: nid
        match (
            nn
        ) case atomid then {
            nameId = nn.name
        } case dottedpath then {
            isPath = true
        } else null
    }
    if isPath then return (pathNamesType :st :ast :nid)
    if nameId.isZero then return false
    # `type` in a type's members names that type
    if (bodySelfTypeNameId :st :nameId) != nameId then return true
    if (st.isLocalName :nameId) then return false
    # an alias of a type enclosing the body
    if (enclosingAsAliasTid :st :ast scope: st.curScope :nameId).notZero then return true
    if (isNumericLiteralNameAt :ast ref: nameId) then return false
    return (nameNamesType :st :ast :unitDecl :nameId)
}

# pathNamesType -- a path names a type when its member resolved to a type
# declaration, to a definition that instantiates a generic (`lib.F2` for
# `F2: (fx n: 2)`), or to a re-export of something that is neither a function
# nor a value -- the answers nameNamesType gives a bare name. A path rooted at a
# local is a value however it continues.
pathNamesType: function {st: zenv.ZSymbolTable ast: Ast nid: zast.nodeid} out bool is {
    rr: rootNameIdOf :ast n: (ast.nodes.get i: nid)
    if rr.notZero when (st.isLocalName nameId: rr) then return false
    # a type's alias reached through it (`Tree.Node`), whether or not a walk
    # has met the path yet
    if (dottedArgAliasTid :st :ast opId: nid).notZero then return true
    rd: (st.typing.refDecl.get key: nid).or d: ztypes.declid
    if rd.isZero then return false
    isType: false
    isReexport: false
    isConst: false
    rdd: st.typing.decls.get i: rd
    isType = rdd.kind.typeDecl
    isReexport = rdd.kind.reexportDecl
    isConst = rdd.kind.constDecl
    rdd.drop
    # only a unit-level definition is an alias: a field declared
    # `(optionval t: tid)` is call-shaped too, and its path is a value
    if isConst when (resolve.declNamesInstantiation :st :ast declId: rd) then return true
    if isReexport.not then return isType
    pst: walkTypeOf :st :nid
    if pst.isZero then return false
    if (st.reg.typetypeOf typeId: pst) == ztypes.ztypetype.functionType then return false
    # a re-export carrying a compile-time value -- one naming an arm (`k:
    # kind.a`) or a constant -- is a VALUE alias, as nameNamesType reads a bare
    # one, so `u.k.b` is the arm predicate and not a construction of `kind.b`
    pcv: (
        constValueOfMemberId
        :st
        scope: (st.typing.declParentOf declId: rd)
        :ast
        unitDecl: (owningUnitDecl :st declId: rd)
        nameId: (st.typing.declNameOf declId: rd)
    )
    constFailClear :st
    return pcv.kind.none
}

# nameNamesType -- a bare name no open scope defines names a type. Asked without
# resolving anything -- the base has been walked already, and a resolver that
# demanded here would reorder the checks the program sees. The declaration the
# name finds answers by its kind: a type or a unit names one, a re-export when
# its alias denotes a type rather than a value (`true: bool.true` is a value, and
# so is an alias of a constant), and a template's own type parameter is a type.
nameNamesType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out bool is {
    dd: declOfUnitDef :st :unitDecl scope: st.curScope :nameId
    if dd.isZero when st.typing.coreUnitRoot.notZero then {
        dd = st.typing.declFindChild parentDeclId: st.typing.coreUnitRoot :nameId
    }
    if dd.notZero then {
        isReexport: false
        ddk: st.typing.decls.get i: dd
        if ddk.kind.typeDecl or ddk.kind.unitDecl then return true
        isReexport = ddk.kind.reexportDecl
        ddk.drop
        if isReexport.not then return (resolve.declNamesInstantiation :st :ast declId: dd)
        if (aliasNamesType :st :ast declId: dd).not then return false
        # an alias of a CONSTANT (`SAME: GREETING`, `NAME: strs.NAME`) has a type
        # alias's shape and denotes a value. Asked last, as bareNameDenotesType
        # asks it: only a name with an alias's shape reaches the evaluator.
        acv: constValueOfMemberId :st scope: st.curScope :ast :unitDecl :nameId
        constFailClear :st
        return acv.kind.none
    }
    to: (
        resolve.walkLookupTyperefByIdRo
        typing: st.typing
        scope: st.curScope
        :ast
        :unitDecl
        baseId: nameId
    )
    match (
        to
    ) case some then {
        return (st.reg.typetypeOf typeId: to) == ztypes.ztypetype.genericParam
    } case none then {
        return false
    }
}

# rootNameIdOf -- rootNameOf as an interned name id, for a caller that compares
# the root rather than printing it.
rootNameIdOf: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    match (
        n
    ) case atomid then {
        return n.name
    } case dottedpath then {
        return (rootNameIdOf :ast n: (ast.nodes.get i: n.parent))
    } else {
        return zast.nameid.zero
    }
}

# rootNameOf -- a value path's root atom name (unwrapping expressions and
# dotted segments), or "".
rootNameOf: function {ast: Ast.view n: astnode.view} out String is {
    match (
        n
    ) case atomid then {
        return (zast.nameTextCopy :ast ref: n.name)
    } case dottedpath then {
        return (rootNameOf :ast n: (ast.nodes.get i: n.parent))
    } else {
        return "".string
    }
}

# dottedChildNameId -- the pool id of a dotted path's child atom name
# (0 when the shape differs).
dottedChildNameId: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    match (
        n
    ) case dottedpath then {
        return (atomNameId :ast n: (ast.nodes.get i: n.child))
    } else {
        return zast.nameid.zero
    }
}

# methodHasNoUserArgs -- true when a method type has no user-visible parameters
# beyond the implicit receiver: no children at all (synthesized collection
# methods), or a single child that IS the receiver -- `this`, or the long-form
# receiver the registry records (thisParamNameIs: `stringView: function {t:
# this.view}`).
methodHasNoUserArgs: function {
    st: zenv.ZSymbolTable.view
    mid: ztypes.tid
} out bool is {
    cnt: st.typing.declMemberCount ownerTid: mid
    if cnt == 0 then return true
    if cnt != 1 then return false
    # declLastChildNameId hands back a pool id, so the receiver test takes it
    # directly -- copying the text out to intern it again lands on this id.
    soleId: st.typing.declLastChildNameId ownerTid: mid
    if soleId == zast.wellKnown.slot.wkThis then return true
    return (st.reg.thisParamNameIs tid: mid nameId: soleId)
}

# fnAutoCallable -- a bare reference to this function is a zero-argument
# auto-call: it has no user parameters, or every non-receiver parameter
# carries a default the site can fill. The strict no-user-args predicate
# stays separate for its other gates (fnptr-field reads, for-iterators).
fnAutoCallable: function {st: zenv.ZSymbolTable.view mid: ztypes.tid} out bool is {
    if (methodHasNoUserArgs :st :mid) then return true
    # thisParamNameIdOf already answers in pool ids; viewing the text to look
    # the same id up again is the identity.
    thisPnId: st.reg.thisParamNameIdOf tid: mid
    userSeen: false
    n: st.typing.declRowSlots ownerTid: mid
    i: u64
    for i < n loop {
        row: st.typing.declRowAt ownerTid: mid membersOnly: false slot: i
        i = i + 1
        if row.keep then {
            pnameId: row.name
            isRecv: (
                (pnameId == zast.wellKnown.slot.wkThis) or
                (thisPnId.notZero and (pnameId == thisPnId))
            )
            if isRecv.not then {
                userSeen = true
                hd: st.typing.declHasDefaultId parentTypeId: mid nameId: pnameId
                rc: refusedParamCopy :st fnId: mid nameId: pnameId
                if (hd or rc).not then return false
            }
        }
    }
    return userSeen
}

# refusedParamCopy -- parameter `nameId` of `fnId` is a unit instance's copy of
# one the template refused (WalkState.refusedParamCopies), which a call does
# not pass.
refusedParamCopy: function {
    st: zenv.ZSymbolTable.view
    fnId: ztypes.tid
    nameId: zast.nameid
} out bool is {
    if st.walk.refusedParamCopies.length == 0 then return false
    return (st.walk.refusedParamCopies.has item: (declMemberOf :st ownerTid: fnId :nameId))
}

# bareFnRefError -- a bare reference to a function with required parameters
# is a call missing its arguments (a reference needs the explicit '.copy').
bareFnRefError: function {
    ast: Ast
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u64
    fid: ztypes.tid
} is {
    fn: moves.declWrittenName :st :ast tid: fid
    (
        bareFnRefErrorFor
        :ast
        :st
        :nodeid
        :lineno
        :colno
        :width
        :fid
        written: fn.stringView
        refHint: true
    )
}

# bareFnRefErrorFor -- bareFnRefError naming the read as it was written: a
# variable holding the reference is named, not the function it holds. The hint
# offers `.copy` only where the read has a reference form: not for a native,
# and not for a method read through an instance (`refHint` false).
bareFnRefErrorFor: function {
    ast: Ast
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u64
    fid: ztypes.tid
    written: StringView
    refHint: bool
    # the hint to give instead of the one the read's form takes; "" for that one
    hint: ""
} is {
    prov: ListVal zast.nameid
    misN: List String
    misI: ListVal ztypes.tid
    (
        callchecks.missingCtorFields
        :ast
        :st
        funcId: fid
        isCtor: false
        provided: prov
        posCount: 0
        recvImplicit: true
        missingNames: misN
        missingIds: misI
    )
    # every one missing was refused where it is written, which said why
    if misN.length == 0 then return
    lst: String
    li: u64
    ln: misN.length
    for li < ln loop {
        mn: misN.get i: li
        memberIdAt: misI.get i: li
        li = li + 1
        mtn: specWrittenName :st :ast tid: memberIdAt
        if lst.length > 0 then lst.append ", "
        ln1: "'\{mn}' (type: \{mtn})"
        lst.append ln1
    }
    m: "a bare reference to '\{written}' calls it: missing required arguments \{lst}"
    nt: "a bare function reference in value position is a call".string
    eh: "call it with its required arguments, or copy the reference with '\{written}.copy'"
    # a native has no reference form to copy (refuseNativeReference)
    noRef: refHint.not or (isNativeFnTid :st tid: fid)
    if noRef then eh = "call it with its required arguments".string
    if hint.length > 0 then eh = hint.string
    (
        addErrorWithHint
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.callError
        msg: m
        note: nt
        hint: eh
        :width
    )
}

# baseIsPrivateCapable -- may a private member be read through this base? True
# when the base is the type's own `this`/same-type receiver (self, inside its
# methods), a `.private` projection, or a read of a `.private`-typed friend
# field. Everything else is external and gated.
baseIsPrivateCapable: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    bt: ztypes.tid
    baseNode: astnode.view
} out bool is {
    if bt.notZero when bt == st.walk.currentThisTid then return true
    match (
        baseNode
    ) case atomid then {
        if baseNode.name == zast.wellKnown.slot.wkThis then return true
        vo: st.lookupVarId nameId: baseNode.name
        match (
            vo
        ) case some then {
            return (st.reg.variableIsPrivate id: vo)
        } case none then {
            return false
        }
    } case dottedpath then {
        cnId: atomNameId :ast n: (ast.nodes.get i: baseNode.child)
        if cnId == zast.wellKnown.slot.wkPrivate then return true
        pbNode: ast.nodes.get i: baseNode.parent
        pbNid: nodeId n: pbNode
        pbType: walkTypeOf :st nid: pbNid
        if pbType.notZero when (
            st.typing.declGrantsPrivateId
            parentTypeId: pbType
            nameId: cnId
        ) then return true
        return false
    } else {
        return false
    }
}

# memberStrictType -- whether `bt` should get the strict unknown-member check:
# a concrete record/class/union/variant, or a protocol/facet interface, whose
# member set is fully declared SOMEWHERE. An interface value reaches only what
# the interface declares, whatever its implementer adds. A type its own unit
# declares answers for itself; a TEMPLATE
# declares its own member set too, and a generic INSTANCE has no unit of its
# own and answers through that template, since its members are the template's
# declarations substituted. What instantiation mints is each member's
# substituted TYPE, never a new member NAME, so the names are all known here.
# Only a bare shell, which no unit declares, stays lenient: it has no member
# set yet for the check to be complete against.
memberStrictType: function {st: zenv.ZSymbolTable.view bt: ztypes.tid} out bool is {
    # `null` -- what a function without an `out` returns -- declares nothing, so
    # its member set is complete and empty
    if bt.notZero when bt == st.typing.nullTypeId then return true
    tt: st.reg.typetypeOf typeId: bt
    isConc: tt.isUserFamily or (tt == ztypes.ztypetype.functionType)
    if isConc.not then return false
    if (st.reg.hasType typeId: bt).not then return false
    declTid: bt
    gorig: st.reg.genericOriginOf tid: bt
    if gorig.notZero then declTid = gorig
    hasUnit: (resolve.unitDeclOfTid reg: st.reg typing: st.typing tid: declTid).notZero
    if hasUnit.not then return false
    return true
}

# typecheck a dotted member-access expression, enforcing visibility and locks.
# isSubunitMemberOf -- the member `member` of unit `unitTid` is a hidden
# implementation subunit. Read off the AST node the member's declaration points
# at, because subunit-ness is how the unit was WRITTEN and the registry records
# only that it is a unit.
isSubunitMemberOf: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    unitTid: ztypes.tid
    member: optionval ztypes.tid
} out bool is {
    unitTid.drop
    mt: ztypes.tid
    match (
        member
    ) case some then {
        mt = member
    } case none then {
        return false
    }
    if (st.reg.typetypeOf typeId: mt) != ztypes.ztypetype.unitType then {
        return false
    }
    dc: templateDeclOf reg: st.reg typing: st.typing tid: mt
    if dc.isZero then return false
    dn: zast.nodeid
    decl: st.typing.decls.get i: dc
    dn = decl.node
    if dn.isZero then return false
    opNode: zast.nodeid
    nn: ast.nodes.get i: dn
    if nn.namedoperation then opNode = nn.operation
    return (zast.unitOpKindIs :ast opId: opNode k: zast.unitkind.subunit)
}

# unitMemberTypeOf -- the type a member of unit `unitTid` names: the scope that
# unit roots, which follows a re-export and demands the definition, then its
# member index. One answer for every unit -- a file unit, an inline
# `m: unit { }` and a hidden subunit each root a scope off their own Decl, and
# `unit.member` names a member of THAT unit, so the prelude is not consulted.
unitMemberTypeOf: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitTid: ztypes.tid
    unitDecl: ztypes.declid
    memberId: zast.nameid
} out optionval ztypes.tid is {
    nid: memberId
    if nid.isZero then return (optionval.none ztypes.tid)
    root: unitScopeRoot :st :unitTid :unitDecl
    r: resolve.scopeMemberTid :st :ast :root nameId: nid
    if r.notZero then return (optionval.some r)
    # a definition the unit's `public:` block makes is on its surface
    pb: st.typing.declPublicNsOf owner: root
    if pb.notZero then {
        r8: resolve.scopeMemberTid :st :ast root: pb nameId: nid
        if r8.notZero then return (optionval.some r8)
    }
    return (optionval.none ztypes.tid)
}

# unitScopeRoot -- the declaration whose scope holds unit `unitTid`'s members.
# A top-level unit roots a scope under its own name; a nested unit is
# deliberately absent from that index -- two files may hold units of the same
# name -- so its root comes off its type id instead. The name is only trusted
# when it produces THIS unit: a nested unit may share a name with a top-level
# one, and answering from the index alone probed the other unit's scope for the
# member. A generic mono's own declaration (declIdOfType) carries its
# substituted members; its template's (templateDeclOf) carries the generic
# ones.
unitScopeRoot: function {
    st: zenv.ZSymbolTable.view
    unitTid: ztypes.tid
    unitDecl: ztypes.declid
} out ztypes.declid is {
    if unitDecl.notZero when (st.typing.declTypeOf declId: unitDecl) == unitTid then return unitDecl
    root: st.typing.declIdOfType typeId: unitTid
    if root.isZero then root = templateDeclOf reg: st.reg typing: st.typing tid: unitTid
    return root
}


# memberDefinitionFailed -- the scope `root` (a type's or a unit's, or its
# `public:` block) declares a member `nameId` that a read found no type for,
# because the member's definition failed and reported why where it is written:
# a constant, a list or a type's `as` constant whose value did not type (with an
# error recorded), or a value refused where it is written (ZTyping.refusedValues):
# a default, a type name or an alias target naming nothing. That report stands
# for every read of the member, so a read adds no "has no member" of its own. A
# function, a parameter, a field or a method a read does not find is the read's
# to report.
memberDefinitionFailed: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    root: ztypes.declid
    nameId: zast.nameid
} out bool is {
    if root.isZero then return false
    md: st.typing.declFindChild parentDeclId: root :nameId
    if md.isZero then {
        pb: st.typing.declPublicNsOf owner: root
        if pb.isZero then return false
        md = st.typing.declFindChild parentDeclId: pb :nameId
        if md.isZero then return false
    }
    d: st.typing.decls.get i: md
    valued: d.kind.constDecl or d.kind.staticListDecl or (st.typing.isAsConstDecl declId: md)
    if valued then return st.typing.errors.length > 0
    if d.node.isZero then return false
    n: ast.nodes.get i: d.node
    if n.namedoperation.not then return false
    return (st.typing.refusedValues.has item: n.operation)
}

# memberTyperefRefused -- member `nameId` of `bt` is declared by a type-ref that
# named nothing, refused and reported where it is written (ZTyping.
# refusedValues), or by the name of a constant whose own definition failed and
# said why (namesFailedConstant). The member is still the type's -- a
# construction gives it a value -- but a READ of it has no type: the shell the
# ref was given is no type a value can be checked against, and every check made
# on it was a second report of the first.
memberTyperefRefused: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    bt: ztypes.tid
    nameId: zast.nameid
} out bool is {
    # a refusal is always reported, so a program with no errors has none
    if (st.typing.errors.length == 0) or bt.isZero then return false
    md: declMemberOf :st ownerTid: bt :nameId
    if md.isZero then return false
    d: st.typing.decls.get i: md
    if d.node.isZero then return false
    n: ast.nodes.get i: d.node
    if n.namedoperation.not then return false
    if (st.typing.refusedValues.has item: n.operation) then return true
    return (namesFailedConstant :st :ast scope: d.parent opId: n.operation)
}

# memberRefusedForNumericParam -- member `nameId` of `owner` was refused where it
# is written for naming a numeric generic parameter: typed by one where only a
# field may be (refuseSingletonDeclType), or defaulted to a value computed from
# one (refusePerInstanceDefault), or it is a unit instance's copy of a parameter
# so refused (refusedParamCopies). A refusal is always reported, so a program
# with no errors has none.
memberRefusedForNumericParam: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    owner: ztypes.tid
    nameId: zast.nameid
} out bool is {
    if (st.typing.errors.length == 0) or owner.isZero then return false
    md: declMemberOf :st ownerTid: owner :nameId
    if md.isZero then return false
    if (refusedParamCopy :st fnId: owner :nameId) then return true
    op: declOperationOf :st :ast declId: md
    if op.isZero then return false
    ownerDecl: templateDeclOf reg: st.reg typing: st.typing tid: owner
    if (defaultReadsNumericParam :st :ast :ownerDecl node: op) then return true
    base: op
    if (zast.atomNameIdOf n: (ast.nodes.get i: op)).isZero then base = (
        markedTyperefBase
        :ast
        nid: op
    )
    if base.isZero then return false
    bn: zast.atomNameIdOf n: (ast.nodes.get i: base)
    if bn.isZero then return false
    if (numericParamOwnerFrom :st scope: ownerDecl nameId: bn).isZero then return false
    # a type's bare field so named is a slot of the singleton type, which the
    # construction fills (missingCtorFields skips it by its type)
    if base != op then return true
    return (st.reg.typetypeOf typeId: owner) == ztypes.ztypetype.functionType
}

# markedTyperefBase -- the base of a marked type-ref, `T` in `T.hold`; 0 for any
# other node.
markedTyperefBase: function {ast: Ast.view nid: zast.nodeid} out zast.nodeid is {
    n: ast.nodes.get i: nid
    if (isStripMarkerId nameId: (dottedChildNameId :ast :n)).not then return zast.nodeid
    match (
        n
    ) case dottedpath then {
        return n.parent
    } else null
    return zast.nodeid
}

# namesFailedConstant -- `opId` is a bare name whose nearest declaration, from
# `scope` outward, is a constant with no type because its definition failed: an
# error said why where it is written (memberDefinitionFailed).
namesFailedConstant: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    scope: ztypes.declid
    opId: zast.nodeid
} out bool is {
    if opId.isZero then return false
    isAtom: false
    {
        vn: ast.nodes.get i: opId
        isAtom = vn.atomid
    }
    if isAtom.not then return false
    nameId: atomNameId :ast n: (ast.nodes.get i: opId)
    if nameId.isZero then return false
    at: scope
    for at.notZero loop {
        hit: st.typing.declFindChild parentDeclId: at :nameId
        if hit.notZero then {
            if (st.typing.declTypeOf declId: hit).notZero then return false
            return (memberDefinitionFailed :st :ast root: at :nameId)
        }
        at = st.typing.declParentOf declId: at
    }
    return false
}

# reportUnknownMember -- an unknown member on a type whose member set is
# complete is a hard error; memberStrictType says which types those are. A
# template's walk reports it as any walk does: a member's EXISTENCE is settled
# by the declarations, not by what the walk stamps.
reportUnknownMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} is {
    shown: walkTypeOf :st nid: dp.parent
    if shown.isZero then shown = bt
    reportUnknownMemberAs :st :ast :dp :bt :cnId :shown
}

# reportUnknownMemberAs -- reportUnknownMember with the receiver named as
# `shown`: the value's own type, which a typedef's is (`rid`) where `bt` is the
# base it forwards its members to. A unit-level constant's nodes are not walked,
# so its reader names the constant's type itself.
reportUnknownMemberAs: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
    shown: ztypes.tid
} is {
    if (memberStrictType :st :bt) then {
        # demand-order safety: walk the type's methods once and
        # re-probe before declaring the member unknown
        walkDefinitionById :st :ast tid: bt
        forceMemberOf :st :ast parentTypeId: bt nameId: cnId
        moMm: st.typing.declChildOfId parentTypeId: bt nameId: cnId
        stillMiss: true
        if moMm.some then {
            stillMiss = false
        }
        # a function's PARAMETERS are its declared children, but a parameter is
        # not a member of the function VALUE: only a CALL reaches one, and it
        # reaches it by label. So a function base misses whatever was found.
        if (st.reg.typetypeOf typeId: bt) == ztypes.ztypetype.functionType then stillMiss = true
        # A generic PARAMETER is read by name through the type that declares
        # it: `this.cap` in a `Buffer` body and `b.cap` on a `(Buffer cap: 8)`
        # each read the value an instance was made with. A parameter is a
        # member of neither the template nor the mono, so the parameter list is
        # the only place that can vouch for the name -- and a mono holds none
        # of its own, so the question goes to its origin.
        if stillMiss then {
            gpOwn: bt
            goMm: st.reg.genericOriginOf tid: bt
            if goMm.notZero then gpOwn = goMm
            gpMm: st.reg.genericParamNamesOf tdecl: (st.typing.declIdOfType typeId: gpOwn)
            if (gpMm.contains item: cnId) then stillMiss = false
        }
        # a numeric-type-named member on a numeric base is a width
        # conversion; the identity form (x.T where x is already T) is
        # not a declared child but is a valid (redundant) cast.
        if stillMiss then {
            # the base by ID, the builtin itself or a literal type: a user type
            # spelled like a scalar is a type of its own and converts to nothing
            baseNum: (numerics.isNumericTid :st tid: bt) or (isLiteralTypeId reg: st.reg tid: bt)
            if (isScalarNameId id: cnId) when baseNum then stillMiss = false
        }
        if stillMiss when (
            memberDefinitionFailed
            :st
            :ast
            root: (templateDeclOf reg: st.reg typing: st.typing tid: bt)
            nameId: cnId
        ) then stillMiss = false
        # an `as` alias is one of the type's types, which a value does not
        # reach (D9)
        if stillMiss when (typeMemberIsAlias :st :ast :bt :cnId) then {
            refuseTypeMemberThroughValue :st :ast :dp bt: shown :cnId
            return
        }
        if stillMiss then {
            cn: zast.nameTextAt :ast ref: cnId
            btnMm: specWrittenName :st :ast tid: shown
            mMm: "type '\{btnMm}' has no member '\{cn}'"
            sugMm: suggestSimilar :ast :st parentTypeId: bt name: cn.stringView
            hMm: String
            if sugMm.length > 0 then {
                hhMm: "did you mean '\{sugMm}'?"
                hMm = hhMm.take
            }
            if (declMemberIsPrivate :st tid: bt nameId: cnId) then {
                cn: zast.nameTextAt :ast ref: cnId
                hpMm: "'\{cn}' is private (not in the public interface)"
                hMm = hpMm.take
            }
            cnidMm: nodeId n: (ast.nodes.get i: dp.child)
            cnlnMm: nodeLine n: (ast.nodes.get i: dp.child)
            cnclMm: nodeCol n: (ast.nodes.get i: dp.child)
            (
                addErrorWithHint
                :st
                nodeid: cnidMm
                lineno: cnlnMm
                colno: cnclMm
                e: zast.err.typeError
                msg: mMm
                note: "".string
                hint: hMm
                width: cn.length
            )
        }
    }
}

# checkCopyMember -- `.copy` on a receiver that declares no copy member. A
# valtype gets the byte copy its assignment already performs, unless its author
# struck it off with `copy: null`; everything else is an error HERE, where the
# type is, rather than invalid C or an emitFail out of the code generator.
checkCopyMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out callleg is {
    # a FUNCTION value and `null` decline here so they take the same refusal
    # every other member read on them takes: "no default copy -- define a
    # 'copy' method" is advice neither can follow, because nothing declares
    # members on them
    noMembers: (
        ((st.reg.typetypeOf typeId: bt) == ztypes.ztypetype.functionType) or
        (bt.notZero and (bt == st.typing.nullTypeId))
    )
    if noMembers then return (callleg handled: false tid: ztypes.tid.zero)
    if cnId == zast.wellKnown.slot.wkCopy when (st.reg.isTypeParamOf tid: bt).not then {
        # A MONO PRESENTS EXACTLY THE CONCRETE TYPE'S INTERFACE, so there is
        # no per-mono leg here. The template body validated `.copy` against
        # the parameter (t -> t); the INSTANCE is held to what the type it was
        # given declares, by the same legs concrete code takes. A waiver here
        # would offer what the concrete spelling does not: a container reaching
        # the EMITTER to fail there as an E0500, a StringView lowered to an
        # ALIAS of its source, a valtype whose author wrote `copy: null` let
        # through.
        btnCp: specWrittenName :st :ast tid: bt
        bttCp: st.reg.typetypeOf typeId: bt
        # A valtype's `.copy` is ALWAYS the byte copy its assignment already
        # performs -- a valtype holds no reftype, so copying the bytes copies
        # the whole value -- and no valtype may write or strike one
        # (refuseValtypeCopy).
        if bttCp.isValueFamily then {
            stampGate :st nid: dp.nid tid: bt
            return (callleg handled: true tid: bt)
        }
        mCp: "type '\{btnCp}' has no '.copy': a reftype has no default copy -- define a 'copy' method on '\{btnCp}' saying what a duplicate means, or move with '.take'"

        if bt == (stdTid :ast :st wk: zast.wellKnown.slot.tyStringView) then {
            mCp = "type 'StringView' has no '.copy': a view has no owned duplicate; '.string' makes an owned String (allocates)".string
        }
        if (stdtypes.refBearingContainer :ast :st tid: bt) then {
            mCp = "type '\{btnCp}' has no '.copy': a container holding REFERENCES has no duplicate to make -- each element would end up owned twice. Build a new one and move the elements with '.take', or '.copy' them one by one"
        }
        (
            addError
            :st
            nodeid: dp.nid
            lineno: dp.lineno
            colno: dp.colno
            e: zast.err.typeError
            msg: mCp
        )
        return (callleg handled: true tid: ztypes.tid.zero)
    }
    return (callleg handled: false tid: ztypes.tid.zero)
}

# reportPrivateMember -- E0102 for a member the type does not make public, unless
# the base already holds private access or a public alias routed us here.
reportPrivateMember: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
    aliasViaX: bool
} is {
    if aliasViaX.not when (declMemberIsPrivate :st tid: bt nameId: cnId) then {
        baseN: ast.nodes.get i: dp.parent
        if (baseIsPrivateCapable :st :ast :bt baseNode: baseN).not then {
            cn: zast.nameTextAt :ast ref: cnId
            cnidP: nodeId n: (ast.nodes.get i: dp.child)
            cnlnP: nodeLine n: (ast.nodes.get i: dp.child)
            cnclP: nodeCol n: (ast.nodes.get i: dp.child)
            btNmP: specWrittenName :st :ast tid: bt
            pmsgP: "'\{cn}' is not public on type '\{btNmP}'"
            (
                addErrorWithHint
                :st
                nodeid: cnidP
                lineno: cnlnP
                colno: cnclP
                e: zast.err.notPublic
                msg: pmsgP
                note: "".string
                hint: "".string
                width: cn.length
            )
        }
    }
}

# checkMemberProjections -- the three legs a resolved member takes before the
# auto-call one: `X.create` in value position is zero-argument construction, a
# protocol-typed implementation member projects a borrow of its receiver, and an
# args-bearing fn-pointer field read bare is a call missing its arguments.
checkMemberProjections: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
    mo: ztypes.tid
    rm: ztypes.tid
    coerce: bool
} out callleg is {
    # `X.create` in value position is zero-argument construction (the same
    # as the bare type name); route it through the shared construction check
    # so a synthesized create's required fields are enforced and the
    # implicitCreate stamp drives field-wise emission.
    if coerce when cnId == zast.wellKnown.slot.wkCreate when (
        (st.reg.typetypeOf typeId: mo) == ztypes.ztypetype.functionType
    ) when (
        isImplicitZeroCreateTid
        :ast
        :st
        tid: bt
    ).not then {
        if (stdtypes.appliedTemplateBase :st :ast :bt base: dp.parent) then return (
            callleg
            handled: true
            tid: ztypes.tid.zero
        )
        cn: zast.nameTextCopy :ast ref: cnId
        (
            checkBareTypeValueAt
            :ast
            :st
            nodeid: dp.nid
            lineno: dp.lineno
            colno: dp.colno
            width: cn.length
            tid: bt
            spelling: ctorspelling.createBare
        )
        setcr: bt
        stampGate :st nid: dp.nid tid: setcr
        return (callleg handled: true tid: bt)
    }
    # Reading a protocol-typed implementation member projects a borrow of
    # the receiver: the consuming binding becomes BORROWED with the base
    # as its origin (and installs the borrow locks).
    rmtt: st.reg.typetypeOf typeId: rm
    if rmtt == ztypes.ztypetype.protocolType when (
        moves.memberReadIsField
        :st
        parentNid: dp.parent
        nameId: cnId
    ).not then {
        pjroot: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: (ast.nodes.get i: dp.parent))
        if pjroot.length > 0 then {
            pjvo: st.lookupVarId nameId: (nameIdOf :ast name: pjroot.stringView)
            if pjvo.some then {
                (
                    callchecks.pinsPushOne
                    :st
                    nameId: (nameIdOf :ast name: pjroot.stringView)
                    shared: false
                    mutable: true
                )
            }
        }
    }
    if coerce when (st.typing.declIsFnptrFieldId parentTypeId: bt nameId: cnId) then {
        # bare name = call: a value-position read of an args-bearing
        # fn-pointer field is a call missing its arguments; `.take` is
        # the reference form.
        #
        # AND THE HINT HAS TO BE FOLLOWABLE. `.take` is NOT peeled before this
        # leg -- dottedBaseTid walks the base with suppressFnAutoCall set and
        # this leg never asked -- so `p.op.take` was refused by the very
        # diagnostic telling it to use `.take`. Asking the flag is what the
        # comment above always claimed was happening.
        leaveUncalled: st.mode.inAssignTarget
        if st.mode.suppressFnAutoCall then leaveUncalled = true
        isNative: st.reg.isNativeOf tid: mo
        if isNative then leaveUncalled = true
        if leaveUncalled.not when (methodHasNoUserArgs :st mid: mo).not then {
            cn: zast.nameTextAt :ast ref: cnId
            msg: "function-pointer field '\{cn}' takes arguments; call it, or copy the reference with '.copy'"
            (
                addError
                :st
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.callError
                :msg
            )
        }
    }
    return (callleg handled: false tid: ztypes.tid.zero)
}

# refuseHiddenArm -- arm constructors are members, so from OUTSIDE the type an
# unlisted arm is private (a public alias is translated before this).
refuseHiddenArm: function {
    # where the refusal is recorded
    st: zenv.ZSymbolTable
    # the tree the arm's name is read from
    ast: Ast.view
    # the dotted path being read
    dp: dpref
    # the sum the unlisted arm belongs to
    bt: ztypes.tid
    # the arm being reached for
    cnId: zast.nameid
    # whether a public alias already translated this name
    aliasViaX: bool
} out bool is {
    if aliasViaX then return false
    baseNodeC: ast.nodes.get i: dp.parent
    if (baseIsPrivateCapable :st :ast :bt baseNode: baseNodeC) then return false
    if (declMemberIsPrivate :st tid: bt nameId: cnId).not then return false
    ccnode: ast.nodes.get i: dp.child
    cn: zast.nameTextAt :ast ref: cnId
    ccbn: specWrittenName :st :ast tid: bt
    (
        addErrorWithHint
        :st
        nodeid: (zast.nodeIdOf n: ccnode)
        lineno: (nodeLine n: ccnode)
        colno: (nodeCol n: ccnode)
        e: zast.err.notPublic
        msg: "'\{cn}' is not public on type '\{ccbn}'"
        note: "".string
        hint: "".string
        width: cn.length
    )
    return true
}

# refuseBareArmPayload -- `Type.arm` READ, with no argument to fill the arm.
# The tag is the whole value only for an arm that carries nothing; for one that
# carries something the emitter has nothing to build and falls through to the
# raw-name fallback, which spells the TYPE into the C (`z_v1 = U.a`). A call
# supplies the payload, and only the callable walk knows a call is coming.
refuseBareArmPayload: function {
    # where the refusal is recorded, and what says this path is a callable
    st: zenv.ZSymbolTable
    # the tree the arm's name is read from
    ast: Ast.view
    # the dotted path being read
    dp: dpref
    # the sum the read hangs off
    bt: ztypes.tid
    # the arm the read named
    cnId: zast.nameid
} out bool is {
    if st.walk.calleeDottedNid == dp.nid then return false
    anId: cnId
    if anId.isZero then return false
    if (armCarriesPayload :st armTid: bt armName: anId).not then return false
    cn: zast.nameTextAt :ast ref: cnId
    btn: specWrittenName :st :ast tid: bt
    cnode: ast.nodes.get i: dp.child
    mb: "arm '\{cn}' of '\{btn}' carries a payload -- naming an arm gives its tag, and cannot supply what the arm holds"
    hb: "supply the payload after the arm name, or name an arm that carries nothing".string
    nb: String
    (
        addErrorWithHint
        :st
        nodeid: (zast.nodeIdOf n: cnode)
        lineno: (nodeLine n: cnode)
        colno: (nodeCol n: cnode)
        e: zast.err.typeError
        msg: mb
        note: nb
        hint: hb
        width: cn.length
    )
    return true
}

# templateArmBase -- the sum a bare arm read constructs: `bt` itself, or for
# `Opt.none` READ on a generic sum's template with no argument, the instance
# its parameters' defaults name. 0 when a parameter has no default: nothing
# names it, and that is reported. An arm about to be called infers from its
# argument instead, and a type written with its arguments (`(Option T:
# type).none` in a generic body) is made concrete by each instance's walk.
templateArmBase: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out ztypes.tid is {
    if st.walk.calleeDottedNid == dp.nid then return bt
    if (st.reg.isGenericOf tid: bt).not then return bt
    if (ast.nodes.get i: dp.parent).call then return bt
    tdecl: st.typing.declIdOfType typeId: bt
    subs: IdMapV zast.nameid v: ztypes.tid
    valSubs: IdMapV zast.nameid v: u64
    sfx: String
    if (fillGenericDefaults :st :ast :tdecl :subs :valSubs :sfx).not then return ztypes.tid
    pi: u64
    for pi < (st.reg.genericParamCountOf :tdecl) loop {
        pn: st.reg.genericParamNameAt :tdecl i: pi
        pi = pi + 1
        if (subs.has key: pn) or (valSubs.has key: pn) then continue
        if (st.reg.genericParamConstraintOf :tdecl paramName: pn).numKind.has then continue
        cnode: ast.nodes.get i: dp.child
        (
            reportUninferredArm
            :st
            :ast
            dtp: bt
            :pn
            armId: cnId
            isNullPay: true
            at: (nodeId n: cnode)
            line: (nodeLine n: cnode)
            col: (nodeCol n: cnode)
        )
        return ztypes.tid
    }
    return (
        getOrMintSpec
        :st
        scope: st.curScope
        :ast
        :unitDecl
        sfx: sfx.stringView
        templateId: bt
        :subs
        :valSubs
        fallbackArg: ztypes.tid.zero
    )
}

# sumArmDeclared -- member `nameId` of sum `sumTid` is declared as one of its
# arms, whatever type the arm carries: a function type among them, which makes
# it no method.
sumArmDeclared: function {
    typing: ztyping.ZTyping.view sumTid: ztypes.tid nameId: zast.nameid
} out bool is {
    md: typing.declMemberIdOf parentTypeId: sumTid :nameId
    if md.isZero then return false
    return (typing.decls.get i: md).kind.armDecl
}

# checkTaggedMemberPath -- a subtype member named on a tagged TYPE (not a value of
# it, not the tag, not a method) is a construction reference: the path's value IS
# the tagged parent. A VALUE base makes the path the arm PREDICATE instead -- it
# types bool and stamps dpArmPredicate for the tag-compare emission.
checkTaggedMemberPath: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
    mo: ztypes.tid
    aliasViaX: bool
} out callleg is {
    # A subtype member named on a tagged TYPE (not a value of it, not the
    # tag, not a method) is a construction reference: record the dotted
    # node's tagged parent (construction dispatch and generic-union
    # inference key off it), stamp the path with the parent, and the
    # path's value IS the parent. A VALUE base makes the path the arm
    # PREDICATE: it types bool (true when the value currently holds
    # that arm) and stamps dpArmPredicate for the tag-compare emission.
    # a type its generic unit declares names that unit instance's copy, and on
    # the template's own walk the template: neither infers arguments
    nsb: unitNestedSelf :st :ast tid: bt
    if nsb.notZero then bt = nsb
    baseKind: st.reg.typetypeOf typeId: bt
    isTagged: baseKind.isSum
    # an implementation label is no arm: it projects, as a record's does
    if isTagged when (
        zenv.isImplementationLabelOf
        ty: st.typing
        reg: st.reg
        tid: bt
        nameId: cnId
    ) then {
        isTagged = false
    }
    if isTagged then {
        memberKind: st.reg.typetypeOf typeId: mo
        # a method is a function member; an arm that carries a function is an
        # arm, as its declaration says
        armDeclared: sumArmDeclared typing: st.typing sumTid: bt nameId: cnId
        isMethod: (memberKind == ztypes.ztypetype.functionType) and armDeclared.not
        isMember: (
            isMethod or
            (resolve.memberIsList :st parentTid: bt nameId: cnId) or
            (memberKind == ztypes.ztypetype.tagType)
        ).not
        if isMember then {
            isVal: dottedBaseIsValue :st :ast :unitDecl n: (ast.nodes.get i: dp.nid)
            if isVal.not then {
                if (refuseHiddenArm :st :ast :dp :bt :cnId :aliasViaX) then {
                    return (callleg handled: true tid: ztypes.tid.zero)
                }
                if (refuseBareArmPayload :st :ast :dp :bt :cnId) then {
                    return (callleg handled: true tid: ztypes.tid.zero)
                }
                abt: bt
                if nsb.isZero then abt = templateArmBase :st :unitDecl :ast :dp :bt :cnId
                if abt.isZero then return (callleg handled: true tid: ztypes.tid.zero)
                pathNid: dp.nid
                armTid: abt
                st.typing.dpTaggedParent.set key: pathNid value: armTid
                stampedTid: abt
                stampGate :st nid: dp.nid tid: stampedTid
                return (callleg handled: true tid: abt)
            }
            gtpl: false
            isGeneric: st.reg.isGenericOf tid: bt
            if isGeneric then gtpl = true
            # a value whose type is a partial of the template (`optionval_t` in
            # a generic body) tests its arm as any value does; each instance
            # walk stamps the concrete predicate the emitter reads
            ptb: walkTypeOf :st nid: dp.parent
            # a value of a partial of the template, or of a type its generic
            # unit declares, tests its arm as any value does
            ptSelf: (st.reg.isPartialOf tid: ptb) or ((unitNestedSelf :st :ast tid: ptb) == ptb)
            if gtpl when ptSelf then {
                pbool: stdTid :ast :st wk: zast.wellKnown.slot.wkBool
                if pbool.notZero then {
                    st.typing.dpArmPredicate.set key: dp.nid value: ptb
                    stampGate :st nid: dp.nid tid: pbool
                    return (callleg handled: true tid: pbool)
                }
            }
            if gtpl.not then {
                boolId: stdTid :ast :st wk: zast.wellKnown.slot.wkBool
                if boolId.notZero then {
                    st.typing.dpArmPredicate.set key: dp.nid value: bt
                    stampGate :st nid: dp.nid tid: boolId
                    return (callleg handled: true tid: boolId)
                }
            }
        }
    }
    return (callleg handled: false tid: ztypes.tid.zero)
}

# checkTagAccessor -- a variant/union as-item `name: <numeric>.tag` exposes the
# discriminator on instances as a read-only numeric under the declared name.
# Without one, an instance read of `tag` is rejected here.
checkTagAccessor: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out callleg is {
    # explicit tag accessor: a variant/union as-item `name: <numeric>.tag`
    # exposes the discriminator on instances as a read-only numeric under
    # the declared name; without one, instance reads of `tag` are rejected.
    baseKind: st.reg.typetypeOf typeId: bt
    isSum: baseKind.isSum
    if isSum when (dottedBaseIsValue :st :ast :unitDecl n: (ast.nodes.get i: dp.nid)) then {
        tagHit: false
        tob: tagAccessorOwner reg: st.reg typing: st.typing tid: bt
        accessorTid: ztypes.tid
        acc: st.typing.tagAccessor.get key: tob
        if acc.some when acc.name == cnId then {
            tagHit = true
            accessorTid = acc.tid
        }
        if tagHit then {
            if st.mode.inAssignTarget then {
                cn: zast.nameTextAt :ast ref: cnId
                readOnlyMsg: "'\{cn}' is read-only — the tag accessor cannot be assigned"
                en5: String
                eh5: String
                (
                    addErrorWithHint
                    :st
                    nodeid: dp.nid
                    lineno: dp.lineno
                    colno: dp.colno
                    e: zast.err.typeError
                    msg: readOnlyMsg
                    note: en5
                    hint: eh5
                    width: cn.length
                )
                return (callleg handled: true tid: ztypes.tid.zero)
            }
            if accessorTid.notZero then {
                st.typing.dpTagRead.set key: dp.nid value: bt
                memberDecl: declMemberOf :st ownerTid: bt nameId: cnId
                stampRefDecl :st nid: dp.nid declId: memberDecl
                stampGate :st nid: dp.nid tid: accessorTid
                return (callleg handled: true tid: accessorTid)
            }
        }
        if cnId == zast.wellKnown.slot.wkTag then {
            cn: zast.nameTextAt :ast ref: cnId
            baseName: specWrittenName :st :ast tid: bt
            notExposedMsg: "tag not exposed on '\{baseName}' — declare it in the as block (eg. `tag: u8.tag`)"
            # a list-sourced tag is declared, but the spec makes only a numeric
            # tag source readable on an instance: name the block it came from
            tbD: st.typing.variantTagBase.get key: tob
            if tbD.some when tbD.isZero then {
                dtD: (
                    (st.typing.declChildOfId parentTypeId: tob nameId: zast.wellKnown.slot.wkTag).or
                    d: ztypes.tid.zero
                )
                lsD: (st.walk.tagSourceDecls.get key: dtD).or d: ztypes.declid
                dnD: zast.nameTextCopy :ast ref: (st.typing.declNameOf declId: lsD)
                notExposedMsg = "tag not readable on '\{baseName}' — its values come from list '\{dnD}'; only a numeric tag source (eg. `tag: u8.tag`) is readable on an instance"
            }
            en6: String
            eh6: String
            (
                addErrorWithHint
                :st
                nodeid: dp.nid
                lineno: dp.lineno
                colno: dp.colno
                e: zast.err.typeError
                msg: notExposedMsg
                note: en6
                hint: eh6
                width: cn.length
            )
            return (callleg handled: true tid: ztypes.tid.zero)
        }
    }
    return (callleg handled: false tid: ztypes.tid.zero)
}

# unitMemberEffectiveName -- the name a unit-qualified member actually resolves
# under. From ANOTHER unit a public alias translates to the internal def it
# exposes, and a private (unlisted) definition is rejected: E0101 and an empty
# answer, which leaves the path untyped.
unitMemberEffectiveName: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out zast.nameid is {
    # public-interface visibility: from ANOTHER unit, translate a public
    # alias to the internal def it exposes, and reject a reference to a
    # private (unlisted) definition (E0101). Same-unit refs use declared
    # names and are never restricted.
    effUcn: cnId
    # the unit a dotted base names, by id: two units may share a spelling,
    # so the DECLARATION that minted the unit type is the identity here
    btUd: templateDeclOf reg: st.reg typing: st.typing tid: bt
    if st.walk.privacySeen when btUd != unitDecl then {
        aliasHitU: false
        if st.typing.renameSeen then {
            intU: declPublicAliasInternal :st tid: bt nameId: cnId
            if intU.notZero then {
                st.typing.setAliasInternalId nodeid: dp.nid internalId: intU
                effUcn = intU
                aliasHitU = true
            }
        }
        if aliasHitU.not when (declMemberIsPrivate :st tid: bt nameId: cnId) then {
            cn: zast.nameTextAt :ast ref: cnId
            un: st.reg.nameOf tid: bt
            ucnid: nodeId n: (ast.nodes.get i: dp.child)
            ucln: nodeLine n: (ast.nodes.get i: dp.child)
            uccl: nodeCol n: (ast.nodes.get i: dp.child)
            (
                addErrorWithHint
                :st
                nodeid: ucnid
                lineno: ucln
                colno: uccl
                e: zast.err.notPublic
                msg: "'\{cn}' is not public on unit '\{un}'"
                note: "".string
                hint: "".string
                width: cn.length
            )
            return zast.nameid
        }
    }
    return effUcn
}

# reportUnknownUnitMember -- `unit.name` naming nothing the unit declares. The hint
# separates a typo (a near-miss suggestion) from a member that exists but is not
# in the unit's public interface.
reportUnknownUnitMember: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} is {
    cn: zast.nameTextAt :ast ref: cnId
    un: st.reg.nameOf tid: bt
    m3: "unit '\{un}' has no member '\{cn}'"
    suggestion: suggestSimilar :ast :st parentTypeId: bt name: cn.stringView
    h3: String
    if suggestion.length > 0 then {
        hh3: "did you mean '\{suggestion}'?"
        h3 = hh3.take
    }
    if (declMemberIsPrivate :st tid: bt nameId: cnId) then {
        cn: zast.nameTextAt :ast ref: cnId
        hp3: "'\{cn}' is private (not in the public interface)"
        h3 = hp3.take
    }
    en3: resolve.unitFileNote :st :ast unitDecl: (st.typing.declIdOfType typeId: bt)
    childNid: nodeId n: (ast.nodes.get i: dp.child)
    childLine: nodeLine n: (ast.nodes.get i: dp.child)
    childCol: nodeCol n: (ast.nodes.get i: dp.child)
    (
        addErrorWithHint
        :st
        nodeid: childNid
        lineno: childLine
        colno: childCol
        e: zast.err.typeError
        msg: m3
        note: en3
        hint: h3
        width: cn.length
    )
}

# checkUnitMemberValue -- a resolved `unit.member` in value position. The definition
# is walked where it is demanded, a no-arg FUNCTION member auto-calls, a TYPE
# member constructs like a bare atom, and the declaration is stamped so
# go-to-definition can find the unit it lives in.
checkUnitMemberValue: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    cnId: zast.nameid
    # the unit's type: its name finds the unit when `memberUnit` is zero
    unitTid: ztypes.tid
    memberUnit: ztypes.declid
    memberDecl: ztypes.tid
    coerce: bool
} out ztypes.tid is {
    result: memberDecl
    # `unit.member` resolved, so the definition it names is reachable
    # from here: walk it where it is demanded, in whatever unit it lives.
    walkDefinitionById :st :ast tid: memberDecl
    isFn: false
    if (st.reg.typetypeOf typeId: memberDecl) == ztypes.ztypetype.functionType then isFn = true
    if coerce when isFn then {
        if st.mode.suppressFnAutoCall.not when (fnAutoCallable :st mid: memberDecl).not then {
            cn: zast.nameTextCopy :ast ref: cnId
            ufl: nodeLine n: (ast.nodes.get i: dp.child)
            ufc: nodeCol n: (ast.nodes.get i: dp.child)
            (
                bareFnRefError
                :ast
                :st
                nodeid: dp.nid
                lineno: ufl
                colno: ufc
                width: cn.length
                fid: memberDecl
            )
        }
        if st.mode.suppressFnAutoCall.not when (fnAutoCallable :st mid: memberDecl) then {
            noteStatementAutoCall :st nid: dp.nid
            ro: conform.methodReturnOf reg: st.reg typing: st.typing mid: memberDecl
            match (
                ro
            ) case some then {
                result = ro
            } case none then {
                result = st.typing.nullTypeId
            }
        }
    }
    # a unit-qualified TYPE member in value position is the same
    # zero-argument construction as a bare atom (`p: unit.Conf`), and the
    # member's own name reaches it through an alias as readily as through the
    # type's registry name; the suppress flag keeps dotted-path bases out
    if coerce when isFn.not when st.mode.suppressBareCtor.not when (
        bareNameDenotesType
        :ast
        :st
        unitDecl: memberUnit
        scope: memberUnit
        nameId: cnId
        tid: memberDecl
    ) then checkTypePathValue :st :ast nid: dp.nid leafNid: dp.child leafId: cnId tid: memberDecl
    setu: result
    stampGate :st nid: dp.nid tid: setu
    # record the resolved declaration so go-to-definition on a
    # unit-qualified `unit.member` can locate its defining unit. The unit is
    # the one the base resolved to -- a subunit (`u.sub.k`) is no child of the
    # program root -- and only a unit nothing resolved is looked up by name.
    # Without it, a member reached through a subunit was stamped with what its
    # TYPE declares: a value alias `k2: kind2.a` read as the type `kind2`, so
    # `u.sub.k2.a` constructed an arm rather than testing one.
    udD: ztypes.declid
    udR: memberUnit
    if udR.isZero then {
        un: st.reg.nameOf tid: unitTid
        udR = (
            st.typing.declFindChild
            parentDeclId: st.typing.programRoot
            nameId: (nameIdOf :ast name: un.stringView)
        )
    }
    if udR.notZero then {
        cnRef: cnId
        # the unit's root, or its public block when the block defines it
        udO: qualifiedMemberScope :st unitRoot: udR memberId: cnRef
        udD = st.typing.declFindChild parentDeclId: udO nameId: cnRef
    }
    if udD.isZero then udD = templateDeclOf reg: st.reg typing: st.typing tid: memberDecl
    stampRefDecl :st nid: dp.nid declId: udD
    return result
}

# readsUnboundGenericUnit -- a member read through the generic unit `tid`
# itself, not an instance of it, from outside the declaration that owns its
# parameters: nothing binds them there. A unit's own body, and a unit nested
# in it (generic through it), read its members bare.
readsUnboundGenericUnit: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    if (st.reg.isGenericOf :tid).not or (st.reg.genericOriginOf :tid).notZero then return false
    owner: st.typing.declIdOfType typeId: tid
    for owner.notZero while (ownsTypeParams :st tid: (st.typing.declTypeOf declId: owner)
    ).not loop {
        owner = st.typing.declParentOf declId: owner
    }
    if owner.isZero then return false
    cur: st.curScope
    for cur.notZero loop {
        if cur == owner then return false
        cur = st.typing.declParentOf declId: cur
    }
    return true
}

# refuseGenericUnitMemberRead -- a member read through the unit `bt` that
# readsUnboundGenericUnit refuses, reported. True once reported.
refuseGenericUnitMemberRead: function {
    st: zenv.ZSymbolTable ast: Ast.view dp: dpref bt: ztypes.tid
} out bool is {
    if (st.reg.typetypeOf typeId: bt) != ztypes.ztypetype.unitType then return false
    if (readsUnboundGenericUnit :st tid: bt).not then return false
    un: st.reg.nameOf tid: bt
    mn: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: dp.child))
    (
        addErrorWithHint
        :st
        nodeid: dp.parent
        lineno: dp.lineno
        colno: dp.colno
        e: zast.err.genericError
        msg: "'\{un}' is a generic unit: its contents are used through an instance of it"
        note: "".string
        hint: "instantiate it first -- 'w: (\{un} ...)' -- and write 'w.\{mn}'"
        width: un.length
    )
    return true
}

# checkUnitQualifiedMember -- `io.stdout`: the member resolves in that unit's
# namespace, under the name the public interface exposes it by. Answers
# handled: false when the base is not a unit type at all.
checkUnitQualifiedMember: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
    coerce: bool
} out callleg is {
    # a unit-qualified member (`io.stdout`): the member resolves in that
    # unit's namespace; a no-arg FUNCTION member auto-calls in value
    # position (its return is the path's value).
    if (st.reg.typetypeOf typeId: bt) == ztypes.ztypetype.unitType then {
        # the unit a dotted base names, by id: two units may share a spelling,
        # so the DECLARATION that minted the unit type is the identity here
        btUd: templateDeclOf reg: st.reg typing: st.typing tid: bt
        effUcn: unitMemberEffectiveName :st :unitDecl :ast :dp :bt :cnId
        if effUcn.isZero then return (callleg handled: true tid: ztypes.tid.zero)
        foldReadInstanceConstant :st :ast :bt cnId: effUcn
        memberDecl: unitMemberTypeOf :st :ast unitTid: bt unitDecl: btUd memberId: effUcn
        # a unit instance walks the functions read through it
        stdtypes.markMemberUsed :st ownerTid: bt nameId: effUcn
        # A hidden subunit is private to its parent BY DEFAULT: it is read
        # only because the parent named it, so it was never declared surface.
        # A `public:` block is the one visibility mechanism -- when the unit
        # has one, the block decides (declMemberIsPrivate above), and a
        # subunit listed there is public.
        if (isSubunitMemberOf :st :ast unitTid: bt member: memberDecl) then {
            pubU: publicNsOf reg: st.reg typing: st.typing tid: bt
            if btUd != unitDecl when pubU.isZero then {
                cn: zast.nameTextAt :ast ref: cnId
                un: st.reg.nameOf tid: bt
                sbl: nodeLine n: (ast.nodes.get i: dp.child)
                sbc: nodeCol n: (ast.nodes.get i: dp.child)
                (
                    addErrorWithHint
                    :st
                    nodeid: (zast.nodeIdOf n: (ast.nodes.get i: dp.child))
                    lineno: sbl
                    colno: sbc
                    e: zast.err.notPublic
                    msg: "'\{cn}' is an implementation subunit of '\{un}' and is private to it"
                    note: "a subunit is loaded only because its own unit named it".string
                    hint: "reach it through a definition '\{un}' exposes"
                    width: cn.length
                )
                return (callleg handled: true tid: ztypes.tid.zero)
            }
        }
        match (
            memberDecl
        ) case some then {
            if (refuseTemplateOnlyConstant :st :ast :dp :bt :cnId) then return (
                callleg
                handled: true
                tid: ztypes.tid
            )
            return (callleg handled: true tid: (
                checkUnitMemberValue
                :st
                :ast
                :dp
                :cnId
                unitTid: bt
                memberUnit: btUd
                :memberDecl
                :coerce
            )
            )
        } case none then {
            return (
                checkUnitUndeclaredMember
                :st
                :ast
                :dp
                :bt
                memberUnit: btUd
                :cnId
                memberId: effUcn
            )
        }
    }
    return (callleg handled: false tid: ztypes.tid.zero)
}

# listElemReadTid -- the type a read of one element of a list has: the list's
# element type, except that an untyped string reads as the literal it was
# written as, a textliteral, though the list of untyped strings is a
# `staticlist text`. A number list's elements read as i64 and land by their
# untyped value.
listElemReadTid: function {
    st: zenv.ZSymbolTable.view elem: ztypes.tid item: ztypes.cval
} out ztypes.tid is {
    if item.kind.svalKind when item.numTid.isZero then return st.reg.literalTextTid
    return elem
}

# listMemberType -- the type list row `row` gives member `nameId`: a label,
# then the count (`length`, untyped), then an ordinal (`blk.3`), an element
# read as listElemReadTid says. An element may claim `length`. 0 for any other name.
listMemberType: function {
    st: zenv.ZSymbolTable.view ast: Ast.view row: u32 nameId: zast.nameid
} out ztypes.tid is {
    g: st.typing.constAggs.get i: row.u64
    lp: st.typing.aggLabelPos id: row label: nameId
    if lp.some then {
        return (
            listElemReadTid
            :st
            elem: g.elem
            item: (st.typing.constAggItems.get i: g.itemStart.u64 + lp)
        )
    }
    if nameId == zast.wellKnown.slot.wkLength then return st.reg.literalIntTid
    pos: (zast.nameTextAt :ast ref: nameId).stringView.parseU64
    match (
        pos
    ) case ok then {
        if pos < g.itemCount then return (
            listElemReadTid
            :st
            elem: g.elem
            item: (st.typing.constAggItems.get i: g.itemStart.u64 + pos)
        )
    } case err then null
    return ztypes.tid.zero
}

# checkArrayIndexMember -- a compile-time numeric index on an array instance
# projects the element type (`a.0` reads / reassigns element zero).
checkArrayIndexMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out callleg is {
    # A compile-time numeric index on an array instance projects the element
    # type (`a.0` reads / reassigns element zero).
    if (isNumericLiteralNameAt :ast ref: cnId) then {
        isArr: false
        elemTid: ztypes.tid
        baseOrigin: st.reg.genericOriginOf tid: bt
        if baseOrigin.notZero then elemTid = baseOrigin
        if elemTid.notZero then isArr = (
            elemTid == (stdtypes.stdTidRo :ast :st wk: zast.wellKnown.slot.tyArray)
        )
        if isArr then {
            forceMemberOf :st :ast parentTypeId: bt nameId: zast.wellKnown.slot.wkGet
            go8: st.typing.declChildOfId parentTypeId: bt nameId: zast.wellKnown.slot.wkGet
            if go8.some then {
                ro8: conform.methodReturnOf reg: st.reg typing: st.typing mid: go8
                if ro8.some then {
                    stamped: ro8
                    stampGate :st nid: dp.nid tid: stamped
                    return (callleg handled: true tid: ro8)
                }
            }
        }
    }
    return (callleg handled: false tid: ztypes.tid.zero)
}

# derivedInequalityMember -- `!=` resolved to the declared `==` it negates, or
# none for every other member and for a `!=` the author wrote.
#
# A type whose `!=` is only the STRUCTURAL SYNTH -- or absent entirely, as on a
# facet -- but which DECLARES `==` takes its inequality from that `==`. The
# argument then binds the parameter the author wrote, and the emitter negates
# at the dispatch site as it already does. Without this a declared `==` taking
# anything but the owner's own type (`==: function {p: this rhs: u64}`) had its
# partner demand the owner's type, so `a != 3` asked for a `pt` and got a
# literal.
derivedInequalityMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    bt: ztypes.tid
    cnId: zast.nameid
    mo: optionval ztypes.tid
} out optionval ztypes.tid is {
    if cnId != zast.wellKnown.slot.wkOpNe then return (optionval.none ztypes.tid)
    neSynthetic: true
    if mo.some then {
        neSynthetic = st.typing.synthCmpTids.has item: mo
    }
    if neSynthetic.not then return (optionval.none ztypes.tid)
    forceMemberOf :st :ast parentTypeId: bt nameId: zast.wellKnown.slot.wkOpEq
    eqMember: st.typing.declChildOfId parentTypeId: bt nameId: zast.wellKnown.slot.wkOpEq
    if eqMember.some when (st.typing.synthCmpTids.has item: eqMember
    ).not then return (optionval.some eqMember)
    return (optionval.none ztypes.tid)
}

# refuseTemplateOnlyConstant -- a generic template's constant that reads one of
# its numeric generic parameters, read through the template itself where no
# instance is being walked: it has a value only in an instance. True when it
# reported.
refuseTemplateOnlyConstant: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out bool is {
    if (st.reg.genericOriginOf tid: bt).notZero then return false
    tdecl: st.typing.declIdOfType typeId: bt
    if (st.reg.genericParamCountOf :tdecl) == 0 then return false
    if (activeConstMono :st ownerDecl: tdecl).notZero then return false
    # inside the template each instance's walk values it
    if (scopeIsWithin typing: st.typing scope: st.curScope root: tdecl) then return false
    cd: st.typing.declFindChild parentDeclId: tdecl nameId: cnId
    if cd.isZero then return false
    opId: zast.nodeid
    cdo: st.typing.decls.get i: cd
    dn: ast.nodes.get i: cdo.node
    if dn.namedoperation then opId = dn.operation
    cdo.drop
    if opId.isZero then return false
    if (constReadsNumericParam :st :ast owner: tdecl :opId).not then return false
    cn: zast.nameTextAt :ast ref: cnId
    tn: specWrittenName :st :ast tid: bt
    (
        addErrorWithHint
        :st
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
        e: zast.err.constError
        msg: "'\{cn}' reads a numeric generic parameter of '\{tn}', which only an instance has a value for"
        note: String
        hint: "read it through an instance of '\{tn}'"
        width: cn.length
    )
    return true
}

# constReadsNumericParam -- whether a constant's value expression names a
# numeric generic parameter of `owner`, through an operator, an `if` or a
# `match` as the constant fold reaches it, a member read or a method call on it
# (`cap.u64`, `cap.max y: 2`), a call's argument, or a constant it names whose
# own value reads one (`G: F + 1` with `F: cap.u64`): such a constant has a
# value in each instance and none in the template, however far it derives.
constReadsNumericParam: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    owner: ztypes.declid
    opId: zast.nodeid
} out bool is {
    followed: ListVal ztypes.declid
    return (constReadsNumericParamVia :st :ast :owner :opId :followed)
}

# constReadsNumericParamVia -- constReadsNumericParam, given the constants the
# walk has followed so far, so a ring of constants ends it.
constReadsNumericParamVia: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    owner: ztypes.declid
    opId: zast.nodeid
    followed: ListVal ztypes.declid
} out bool is {
    if opId.isZero then return false
    kids: ListVal zast.nodeid
    nameId: zast.nameid
    {
        n: ast.nodes.get i: opId
        # a bare name, or a pun's labelled one
        nameId = atomNameId :ast :n
        ip: operatorPartsAt :ast nid: opId
        if ip.found then {
            kids.append from: ip.lhs
            kids.append from: ip.rhs
        }
        if ip.found.not when n.dottedpath then kids.append from: n.parent
        # `type.K`, the path a method body reads its type's bare `K` as, reads K
        if nameId.isZero then nameId = dottedTypeMemberName :ast :n
        appendHeldValues :ast :n :kids
        if ip.found.not when n.call then {
            kids.append from: n.callable
            c: callRefAt :ast nid: opId
            ai: u64
            for ai < c.nargs loop {
                (
                    kids.append
                    from: (argRefAt :ast nid: (zast.callArgAt :ast nid: c.nid i: ai)).operation
                )
                ai = ai + 1
            }
        }
    }
    if nameId.notZero then return (nameReadsNumericParam :st :ast :owner :nameId :followed)
    for each k: kids loop {
        if (constReadsNumericParamVia :st :ast :owner opId: k :followed) then return true
    }
    return (constBranchReadsNumericParam :st :ast :owner :opId :followed)
}

# dottedTypeMemberName -- the member `type.K` names, the path through the
# enclosing type a method body reads a bare `K` of its type as; 0 for any other
# node.
dottedTypeMemberName: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    match (
        n
    ) case dottedpath then {
        if (atomNameId :ast n: (ast.nodes.get i: n.parent)) != zast.wellKnown.slot.wkType then {
            return zast.nameid
        }
        return (atomNameId :ast n: (ast.nodes.get i: n.child))
    } else null
    return zast.nameid
}

# nameReadsNumericParam -- the name `nameId`, read in a constant of `owner`, is
# a numeric generic parameter of `owner` or of a definition enclosing it, or
# names the nearest constant of that name whose value reads one.
nameReadsNumericParam: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    owner: ztypes.declid
    nameId: zast.nameid
    followed: ListVal ztypes.declid
} out bool is {
    if (numericParamOwnerFrom :st scope: owner :nameId).notZero then return true
    cur: owner
    for cur.notZero loop {
        cd: st.typing.declFindChild parentDeclId: cur :nameId
        if cd.notZero then {
            if (
                (followed.contains item: cd) or (declIsConstant :st :ast declId: cd).not
            ) then return false
            followed.append from: cd
            return (
                constReadsNumericParamVia
                :st
                :ast
                :owner
                opId: (declOperationOf :st :ast declId: cd)
                :followed
            )
        }
        cur = st.typing.declParentOf declId: cur
    }
    return false
}

# declIsConstant -- the declaration is a constant: a unit's, an `as`
# section's -- known by its value before the section is checked -- or a path
# a unit re-exports until its root is read as a value.
declIsConstant: function {
    st: zenv.ZSymbolTable.view ast: Ast.view declId: ztypes.declid
} out bool is {
    k: (st.typing.decls.get i: declId).kind
    if k.constDecl or k.reexportDecl then return true
    if (st.typing.isAsConstDecl :declId) then return true
    if (declIsType :st declId: (st.typing.declParentOf :declId)).not then return false
    return (valueDeclares :ast node: (declOperationOf :st :ast :declId))
}

# appendHeldValues -- the values a node holds without being an operation of
# its own, appended to the caller's list: an `if`'s condition is held by a
# labelled node, and a branch's value by its block's lines.
appendHeldValues: function {ast: Ast.view n: astnode.view kids: ListVal zast.nodeid} is {
    if n.namedoperation then kids.append from: n.operation
    if n.statementline then kids.append from: n.statementline
    if n.statement then appendKidIds :ast span: n.statements ids: kids
}

# constBranchReadsNumericParam -- constReadsNumericParam over an `if`'s
# conditions and branch values, the forms a unit-level `if` folds.
constBranchReadsNumericParam: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    owner: ztypes.declid
    opId: zast.nodeid
    followed: ListVal ztypes.declid
} out bool is {
    clauseIds: ListVal zast.nodeid
    site: readUnitIf :ast nid: opId :clauseIds
    for each clauseId: clauseIds loop {
        condIds: ListVal zast.nodeid
        stmtId: readIfClause :ast :clauseId :condIds
        for each condId: condIds loop {
            if (constReadsNumericParamVia :st :ast :owner opId: condId :followed) then return true
        }
        if stmtId.notZero when (constReadsNumericParamVia :st :ast :owner opId: stmtId :followed
        ) then return true
    }
    if site.elseId.notZero then return (
        constReadsNumericParamVia
        :st
        :ast
        :owner
        opId: site.elseId
        :followed
    )
    return false
}

# checkUnitUndeclaredMember -- `unit.name` naming no member of the unit
# `memberUnit` (the declaration of `bt`) that has a type: a member whose
# definition failed, which said why where it is written; an instance's numeric
# generic parameter, or a constant of its template, both read through it as
# through a type; anything else is unknown.
checkUnitUndeclaredMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    memberUnit: ztypes.declid
    cnId: zast.nameid
    memberId: zast.nameid
} out callleg is {
    if (
        memberDefinitionFailed
        :st
        :ast
        root: (unitScopeRoot :st unitTid: bt unitDecl: memberUnit)
        nameId: memberId
    ) then return (callleg handled: true tid: ztypes.tid.zero)
    npU: checkNumericParamMember :st :ast unitDecl: memberUnit :dp :bt :cnId
    if npU.handled then return npU
    icU: checkInstanceConstant :st :ast :dp :bt :cnId
    if icU.handled then return icU
    if (instanceOnlyConstantNamed :st :ast :bt :cnId) then {
        refuseTemplateOnlyConstant :st :ast :dp :bt :cnId
        return (callleg handled: true tid: ztypes.tid)
    }
    reportUnknownUnitMember :st :ast :dp :bt :cnId
    return (callleg handled: true tid: ztypes.tid)
}

# checkInstanceConstant -- a template's constant read through an instantiation
# (`a.LIMIT`, `a.BIG` on a unit instance): the template declares it, and it is
# evaluated for the instantiation, whose numeric generic parameters it may read.
checkInstanceConstant: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out callleg is {
    miss: callleg handled: false tid: ztypes.tid
    origin: st.reg.genericOriginOf tid: bt
    if origin.isZero then return miss
    tdecl: st.typing.declIdOfType typeId: origin
    cd: st.typing.declFindChild parentDeclId: tdecl nameId: cnId
    if cd.isZero then return miss
    dnode: zast.nodeid
    cdo: st.typing.decls.get i: cd
    dnode = cdo.node
    cdo.drop
    prevMono: st.walk.constMono
    st.walk.constMono = bt
    v: (
        bodies.constValueOfMemberAt
        :st
        :ast
        unitDecl: (unitRootOfDecl typing: st.typing declId: cd)
        ownerDecl: tdecl
        nameId: cnId
        defNodeId: dnode
    )
    st.walk.constMono = prevMono
    if v.kind.none then return miss
    vt: consteval.constNumTidOf :ast :st scope: st.curScope :v
    # a value that is no number -- text, an arm, an aggregate -- is typed by what
    # it is, as the instance's own: the template's member has no type for it
    if vt.isZero then vt = constValueTid :ast :st scope: st.curScope :v
    if vt.isZero then {
        vto: st.typing.declChildOfId parentTypeId: origin nameId: cnId
        vt = vto.or d: ztypes.tid.zero
    }
    if vt.isZero then return miss
    st.typing.setNodeConst nid: dp.nid value: v
    stampGate :st nid: dp.nid tid: vt
    stampRefDecl :st nid: dp.nid declId: cd
    return (callleg handled: true tid: vt)
}

# baseRunsCall -- whether reading a dotted base runs a call: a call, or a bare
# name that auto-calls the function it names.
baseRunsCall: function {st: zenv.ZSymbolTable.view ast: Ast.view nid: zast.nodeid} out bool is {
    isCall: false
    isAtom: false
    bn: ast.nodes.get i: nid
    isCall = bn.call
    isAtom = bn.atomid
    if isCall then return true
    if (
        isAtom.not or (st.typing.atomVariableId.get key: nid).some
    ) then return false
    rdo: st.typing.refDecl.get key: nid
    match (
        rdo
    ) case some then {
        rdt: st.typing.declTypeOf declId: rdo
        return (st.reg.typetypeOf typeId: rdt) == ztypes.ztypetype.functionType
    } case none then {
        return false
    }
}

# checkNumericParamMember -- a numeric generic parameter read through a value
# (`b.cap`, `this.cap`) or a type: not a member of the template or of a mono,
# but a compile-time constant of the type the base has, and the one static a
# value reaches, since a value's type fixes it. Typed by the bound; valued when
# the base's type is a mono, which recorded its argument. A call's result is
# refused as a base: folding the read would drop the call.
checkNumericParamMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out callleg is {
    miss: callleg handled: false tid: ztypes.tid
    if bt.isZero then return miss
    origin: st.reg.genericOriginOf tid: bt
    owner: bt
    if origin.notZero then owner = origin
    tdecl: st.typing.declIdOfType typeId: owner
    cd: st.reg.genericParamConstraintOf :tdecl paramName: cnId
    if cd.numKind.has.not then return miss
    bound: numericBoundTid :ast :st scope: st.curScope :cd
    if bound.isZero then return miss
    tb: templateNamedBase :st :ast :dp :bt :cnId :tdecl
    if tb.none then return (callleg handled: true tid: ztypes.tid)
    bt = tb
    origin = st.reg.genericOriginOf tid: bt
    # a value reaches its type's fields and methods, not its types (D9)
    isValue: false
    if (st.reg.typetypeOf typeId: bt) != ztypes.ztypetype.unitType then {
        isValue = dottedBaseIsValue :st :ast :unitDecl n: (ast.nodes.get i: dp.nid)
    }
    if isValue then {
        refuseTypeMemberThroughValue :st :ast :dp :bt :cnId
        return (callleg handled: true tid: ztypes.tid)
    }
    if isValue when (baseRunsCall :st :ast nid: dp.parent) then {
        pn: zast.nameTextAt :ast ref: cnId
        (
            addErrorWithHint
            :st
            nodeid: dp.nid
            lineno: dp.lineno
            colno: dp.colno
            e: zast.err.typeError
            msg: "generic parameter '\{pn}' is read from a call's result, and reading it would not make the call"
            note: String
            hint: "bind the result first, or read it through the type".string
            width: 1
        )
        return (callleg handled: true tid: ztypes.tid)
    }
    if origin.notZero when (st.reg.isPartialOf tid: bt).not then {
        v: monoNumericArg :st mono: bt nameId: cnId
        if v.isConst then (
            st.typing.setNodeConst
            nid: dp.nid
            value: v
        )
        # an instance's parameter is its singleton type
        sg: st.typing.singletonOf instance: bt param: cnId
        if sg.notZero then bound = sg
    }
    stampGate :st nid: dp.nid tid: bound
    (
        stampRefDecl
        :st
        nid: dp.nid
        declId: (st.typing.declFindChild parentDeclId: tdecl nameId: cnId)
    )
    st.typing.numericParamRead.set key: dp.nid value: cnId
    return (callleg handled: true tid: bound)
}

# typeMemberIsAlias -- `cnId` is an `as` alias the type `bt` declares (its
# template's, for an instance): a type, reached through the type's name.
typeMemberIsAlias: function {
    st: zenv.ZSymbolTable ast: Ast bt: ztypes.tid cnId: zast.nameid
} out bool is {
    td: templateDeclOf reg: st.reg typing: st.typing tid: bt
    if td.isZero then return false
    md: st.typing.declFindChild parentDeclId: td nameId: cnId
    if md.isZero then return false
    return (asMemberIsAlias :st :ast tdecl: td :md)
}

# templateNamedBase -- the base a numeric generic parameter `cnId` is read
# through, when that is its generic template itself (`Box.cap`): inside the
# template, the instance whose walk reads it, as the bare name reads; outside,
# refused (refuseTemplateOnlyParam), none. Any other base is itself.
templateNamedBase: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
    tdecl: ztypes.declid
} out optionval ztypes.tid is {
    if (st.reg.genericOriginOf tid: bt).notZero then return (optionval.some bt)
    if (refuseTemplateOnlyParam :st :ast :dp :bt :cnId :tdecl
    ) then return (optionval.none ztypes.tid)
    wi: walkedInstanceOf :st template: bt param: cnId
    if wi.isZero then return (optionval.some bt)
    return (optionval.some wi)
}

# walkedInstanceOf -- the instance of `template` whose walk is reading its
# numeric generic parameter `param`: the instance the walk's singleton type for
# the name belongs to, when that is an instance of `template`; 0 otherwise.
walkedInstanceOf: function {
    st: zenv.ZSymbolTable.view template: ztypes.tid param: zast.nameid
} out ztypes.tid is {
    sg: monoSingletonOf :st nameId: param
    if sg.isZero then return ztypes.tid
    row: st.typing.singletons.get key: sg
    if row.none then return ztypes.tid
    if (st.reg.genericOriginOf tid: row.instance) != template then return ztypes.tid
    return row.instance
}

# refuseTemplateOnlyParam -- a numeric generic parameter read through its generic
# template itself (`Box.cap`) where no instance is being walked: it has a value
# only in an instance, as a template's constant over it has (refuseTemplateOnlyConstant).
# Inside the template each instance's walk values it. True when it reported.
refuseTemplateOnlyParam: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
    tdecl: ztypes.declid
} out bool is {
    if (st.reg.genericOriginOf tid: bt).notZero then return false
    if (activeConstMono :st ownerDecl: tdecl).notZero then return false
    if (scopeIsWithin typing: st.typing scope: st.curScope root: tdecl) then return false
    cn: zast.nameTextAt :ast ref: cnId
    tn: specWrittenName :st :ast tid: bt
    (
        addErrorWithHint
        :st
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
        e: zast.err.constError
        msg: "'\{cn}' is a numeric generic parameter of '\{tn}', which only an instance has a value for"
        note: String
        hint: "read it through an instance of '\{tn}'"
        width: cn.length
    )
    return true
}

# refuseTypeMemberThroughValue -- member `cnId` of `bt` is one of its types (a
# numeric generic parameter, which is the instance's singleton type, or an `as`
# alias), reached through a run-time value of it (`b.cap`, `this.cap`,
# `b.Elem`): a value reaches its type's fields and methods, and a type through
# the type's own name.
refuseTypeMemberThroughValue: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} is {
    cn: zast.nameTextAt :ast ref: cnId
    tn: specWrittenName :st :ast tid: bt
    # a template names no instance's type: inside it the bare name is read
    h: "read it as `\{cn}` inside the type"
    if (st.reg.isGenericOf tid: bt).not then {
        path: tn.copy
        path.append "."
        path.append cn
        h = "name it through the type: `\{path}`, or `\{cn}` inside the type"
    }
    (
        addErrorWithHint
        :st
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
        e: zast.err.typeError
        msg: "'\{cn}' is a type of '\{tn}'; a value reaches only its fields and methods"
        note: String
        hint: h
        width: cn.length
    )
}

# checkUnresolvedMember -- the member did not resolve on the base type. On a
# type parameter nothing is diagnosed: every member use -- a method, a field,
# an operator -- is the instance's to resolve; everything else is diagnosed
# here.
checkUnresolvedMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out ztypes.tid is {
    npleg: checkNumericParamMember :st :ast :unitDecl :dp :bt :cnId
    if npleg.handled then return npleg.tid
    # a template's constant over its numeric parameter with no type: an
    # instance's fold said why, the template's own walk reads it as not yet
    # known, and a read through the template from anywhere else is refused
    if (instanceOnlyConstantNamed :st :ast :bt :cnId) then {
        refuseTemplateOnlyConstant :st :ast :dp :bt :cnId
        return ztypes.tid
    }
    # `T.create` on a type with no `create` to find -- a sum, a `create: null`
    # type, a generic sum template: the construction is refused by the rule it
    # breaks, in the words every other spelling of it uses, not as a missing
    # member
    if cnId == zast.wellKnown.slot.wkCreate when (
        stdtypes.appliedTemplateBase
        :st
        :ast
        :bt
        base: dp.parent
    ) then return ztypes.tid.zero
    if cnId == zast.wellKnown.slot.wkCreate when (
        callchecks.refuseNameConstruction
        :ast
        :st
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
        width: 1
        tid: bt
        spelling: ctorspelling.createCall
    ) then return ztypes.tid.zero
    if (st.reg.isTypeParamOf tid: bt) then {
        cn: zast.nameTextAt :ast ref: cnId
        # `.copy` is an ownership primitive, not a constrained member:
        # every instantiation copies, so a generic-param receiver types
        # it t -> t (the per-instance clone emits the concrete copy).
        if cnId == zast.wellKnown.slot.wkCopy then {
            stampGate :st nid: dp.nid tid: bt
            return bt
        }
        # A MEMBER ON A TYPE PARAMETER RESOLVES AT INSTANTIATION, not in the
        # template: `add: function {a: t b: t} out t is { return a + b }` and
        # `area: function {s: T} out u64 is { return s.area }` are checked
        # against each concrete type by the per-instance clone. Operators are
        # methods, and a bound only decides which types may instantiate, so a
        # member the bound does not declare is not refused here either (duck
        # typing, spec "What a bound promises"). An operator keeps the
        # coercible lhs result; a named member's result is not known until
        # the instance, and the template types it as nothing, which every
        # later check reads as not yet known.
        if (isOperatorName name: cn.stringView) then {
            stampGate :st nid: dp.nid tid: bt
            return bt
        }
        return ztypes.tid
    }
    cpleg: checkCopyMember :st :ast :dp :bt :cnId
    if cpleg.handled then return cpleg.tid
    # `.view` marks a parameter type and is never a value member. The
    # strict unknown-member check says so, but a generic instance is
    # lenient there, so unstamped it reached the emitter as an unhandled
    # binding (E0500, no location) -- diagnose it on every base.
    if cnId == zast.wellKnown.slot.wkView when st.mode.genericWalk.not then {
        cn: zast.nameTextAt :ast ref: cnId
        btnVw: specWrittenName :st :ast tid: bt
        mVw: "type '\{btnVw}' has no member 'view'"
        cnidVw: nodeId n: (ast.nodes.get i: dp.child)
        cnlnVw: nodeLine n: (ast.nodes.get i: dp.child)
        cnclVw: nodeCol n: (ast.nodes.get i: dp.child)
        (
            addErrorWithHint
            :st
            nodeid: cnidVw
            lineno: cnlnVw
            colno: cnclVw
            e: zast.err.typeError
            msg: mVw
            note: "'.view' marks a parameter type readonly; a value cannot be viewed".string
            hint: "".string
            width: cn.length
        )
        return ztypes.tid.zero
    }
    reportUnknownMember :st :ast :dp :bt :cnId
    return ztypes.tid.zero
}

# checkMemberNamespace -- a type's members and an instance's are two namespaces.
# A function declared with no receiver -- `create`, a shared function of the `as`
# section -- belongs to the TYPE, so it is not reached through an instance. A
# function field of the `is` section belongs to each INSTANCE, so it is not
# reached through the type. Both were read as the other: `p.helper n: 3` dropped
# its receiver, and `T.first p` called an instance's field without an instance.
# false once it has reported.
checkMemberNamespace: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
    mo: ztypes.tid
    # the read is in value position, where a method auto-calls
    coerce: bool
} out bool is {
    if bt.isZero then return true
    # an interface's members are the implementer's methods, reached through a value
    btt: st.reg.typetypeOf typeId: bt
    if btt.isInterface then return true
    # a function VALUE has no members: its parameters are its declared children,
    # so a read of one RESOLVED and reached the C as a field of a function
    # pointer. One rule, reported where the missing case is reported.
    if btt == ztypes.ztypetype.functionType then {
        reportUnknownMember :st :ast :dp :bt :cnId
        return false
    }
    if (st.reg.typetypeOf typeId: mo) != ztypes.ztypetype.functionType then {
        return (checkDataMemberNamespace :st :ast :unitDecl :dp :bt :cnId)
    }
    # an arm that carries a function is no method: through the type it builds
    # a value, on a value it is the arm's predicate
    if (sumArmDeclared typing: st.typing sumTid: bt nameId: cnId) then return true
    isValue: dottedBaseIsValue :st :ast :unitDecl n: (ast.nodes.get i: dp.nid)
    # a bare numeric generic parameter names its singleton type as well as the
    # type's one value, and `create` belongs to the type: `cap.create`
    if isValue when cnId == zast.wellKnown.slot.wkCreate when (
        st.typing.numericParamRead.has
        key: dp.parent
    ) then return true
    if (st.typing.declIsFnptrFieldId parentTypeId: bt nameId: cnId) then {
        if isValue then return true
        (
            reportMemberNamespace
            :st
            :ast
            :unitDecl
            :dp
            :bt
            :cnId
            instanceMember: true
            functionMember: true
        )
        return false
    }
    if (baseNamesBareGeneric :st :ast :unitDecl :dp :bt :cnId :isValue) then {
        refuseBareGenericMethodBase :st :ast :dp :bt
        return false
    }
    if isValue.not then return (
        checkTypeReadSuppliesReceiver
        :st
        :ast
        :unitDecl
        :dp
        :bt
        :cnId
        :mo
        :coerce
    )
    if (moves.memberIsTypeOnly :st :bt :cnId :mo).not then return true
    (
        reportMemberNamespace
        :st
        :ast
        :unitDecl
        :dp
        :bt
        :cnId
        instanceMember: false
        functionMember: true
    )
    return false
}

# baseNamesBareGeneric -- a type read (`isValue` false) of member `cnId` whose
# base is a generic type's bare name, which names no instance. `type` names the
# instance being checked, and a name bound to an instance over a parameter
# (`pu: (pairs u: t)`) is read through to the template but names the instance.
baseNamesBareGeneric: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
    isValue: bool
} out bool is {
    if isValue or (cnId == zast.wellKnown.slot.wkCreate) then return false
    if (ownsTypeParams :st tid: bt).not then return false
    baseNm: zast.nameid
    {
        bn: ast.nodes.get i: dp.parent
        if bn.atomid when (bodySelfTypeNameId :st nameId: bn.name) == bn.name then baseNm = bn.name
    }
    if baseNm.isZero then return false
    return (
        (resolve.resolveAtomType :st :ast :unitDecl scope: st.curScope nameId: baseNm thisName: ""
        ) ==
        bt
    )
}

# refuseBareGenericMethodBase -- a method reached through a generic type's bare
# name (`fx.make`): the bare name is no type, so it names no instance for the
# method to belong to. The instance is written with the type's arguments; the
# hint spells it over the type's own parameters, which is how its own members
# name the instance being checked.
refuseBareGenericMethodBase: function {
    st: zenv.ZSymbolTable ast: Ast.view dp: dpref bt: ztypes.tid
} is {
    tn: st.reg.nameOf tid: bt
    app: "(\{tn}"
    for each pn: (st.reg.genericParamNamesOf tdecl: (st.typing.declIdOfType typeId: bt)) loop {
        pt: zast.nameTextAt :ast ref: pn
        app.append " \{pt}: \{pt}"
    }
    app.append ")"
    (
        addErrorWithHint
        :st
        nodeid: dp.parent
        lineno: dp.lineno
        colno: dp.colno
        e: zast.err.genericError
        msg: "'\{tn}' is a generic type: a method is reached through it written with its type arguments"
        note: "".string
        hint: "for example \{app}, which inside its own declaration is the instance being checked"
        width: tn.length
    )
}

# checkDataMemberNamespace -- the two namespaces for a member that is not a
# function. A field is each instance's data, so it is not reached through the
# type: `T.x` reached the C as a read of a name it does not have. A constant of
# the `as` section is the type's, so it is not reached through an instance:
# `p.LIMIT` reached the C as a struct field the instance does not store.
checkDataMemberNamespace: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out bool is {
    md: st.typing.declMemberIdOf parentTypeId: bt nameId: cnId
    if md.isZero then return true
    isField: false
    mdd: st.typing.decls.get i: md
    isField = mdd.kind.fieldDecl
    mdd.drop
    if isField.not then return true
    isConst: st.typing.isAsConstDecl declId: md
    isValue: dottedBaseIsValue :st :ast :unitDecl n: (ast.nodes.get i: dp.nid)
    if isConst == isValue.not then return true
    (
        reportMemberNamespace
        :st
        :ast
        :unitDecl
        :dp
        :bt
        :cnId
        instanceMember: isConst.not
        functionMember: false
    )
    return false
}

# reportMemberNamespace -- the E0100 for a member reached through the namespace
# it does not live in: an instance's function field through the type, or a type's
# static member through an instance.
reportMemberNamespace: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
    # the member belongs to each instance and was reached through the type;
    # otherwise it belongs to the type and was reached through an instance
    instanceMember: bool
    # the member is a function (called) rather than data (read)
    functionMember: bool
} is {
    cn: zast.nameTextCopy :ast ref: cnId
    tn: specWrittenName :st :ast tid: bt
    verb: "read"
    if functionMember then verb = "call"
    msg: "'\{cn}' belongs to the type '\{tn}', not to an instance"
    hint: "\{verb} it through the type '\{tn}' instead"
    if instanceMember then {
        what: "field"
        if functionMember then what = "function field"
        msg = "'\{cn}' is a \{what} of each '\{tn}' instance, not a member of the type"
        hint = "\{verb} it through an instance: `value.\{cn}`"
        ah: aliasValueHint :st :ast :unitDecl :dp :bt
        if ah.length > 0 then hint = ah.take
    }
    (
        addErrorWithHint
        :st
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
        e: zast.err.typeError
        :msg
        note: "".string
        :hint
        width: cn.length
    )
}

# aliasValueHint -- the hint for an instance member read through a unit-level
# alias of a concrete type, empty for any other base. A unit-level value takes no
# labelled arguments, so `origin: Pt x: 0` is the alias `origin` and a constant
# `x`. Only a read through the alias shows a value was meant. The type's own
# name, a re-export under it (`Spot: geo.Spot`) and a generic instance
# (`Strs: (ListVal i64)`, a type application rather than an alias) keep their
# hints.
aliasValueHint: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    dp: dpref
    bt: ztypes.tid
} out String is {
    an: atomNameId :ast n: (ast.nodes.get i: dp.parent)
    if an.isZero then return "".string
    ad: declOfUnitDef :st :unitDecl scope: unitDecl nameId: an
    if ad.isZero then return "".string
    if (aliasNamesType :st :ast declId: ad).not then return "".string
    tn: specWrittenName :st :ast tid: bt
    atx: zast.nameTextAt :ast ref: an
    if atx == tn then return "".string
    pre: "'\{atx}' names the type '\{tn}', not a value: on a unit-level line, a label after the value begins a definition of its own."
    # a data value is built where it is declared, its labelled arguments in
    # parentheses
    if (st.reg.isStaticOf tid: bt
    ) then return "\{pre} Write the value in parentheses: `\{atx}: (\{tn} field: value)`"
    return "\{pre} Build a '\{tn}' value inside a function"
}

# checkTypeReadSuppliesReceiver -- a method read through the TYPE in value position
# auto-calls with nothing to hand it: the type supplies no receiver, and there are
# no arguments to supply one. `T.first` reached the C as a function pointer bound
# to its result. A call (`T.first p`) is the call walk's to check, and a
# reference (`.take`) calls nothing. false once it has reported.
checkTypeReadSuppliesReceiver: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
    mo: ztypes.tid
    coerce: bool
} out bool is {
    if coerce.not or st.mode.suppressFnAutoCall then return true
    if (moves.memberDeclaresReceiver :st :bt :cnId :mo).not then return true
    rpn: callchecks.receiverParamNameOf :st tid: mo
    if rpn.isZero then rpn = zast.wellKnown.slot.wkThis
    rn: zast.nameTextAt :ast ref: rpn
    tn: specWrittenName :st :ast tid: bt
    mr: "missing required argument '\{rn}' (type: \{tn})"
    cn: zast.nameTextCopy :ast ref: cnId
    mh: aliasValueHint :st :ast :unitDecl :dp :bt
    if mh.length == 0 then {
        mh = "a method read through its type is handed its receiver as an argument".string
    }
    (
        addErrorWithHint
        :st
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
        e: zast.err.callError
        msg: mr
        note: "".string
        hint: mh
        width: cn.length
    )
    return false
}

# callFieldObject -- a FIELD holding a callable object is called when read bare,
# as a variable holding one is: the read, already checked, becomes the
# base of its `call`, and only the call is checked on top of it. Answers the
# read's type unchanged when it is not such a field.
callFieldObject: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    # the member read, a field unless it is a function
    mo: ztypes.tid
    # the read is in value position, where a bare path is called
    coerce: bool
    # the field read's type
    result: ztypes.tid
} out ztypes.tid is {
    if coerce.not then return result
    moKind: st.reg.typetypeOf typeId: mo
    if moKind == ztypes.ztypetype.functionType then return result
    oc: readsObjectAsCall :st :ast t: result nid: dp.nid
    if oc.isZero then return result
    if (fnAutoCallable :st mid: oc).not then {
        wtp: ListVal zast.nameid
        moves.appendValueTuple :ast n: (ast.nodes.get i: dp.nid) dst: wtp
        wpath: zenv.formatPath pool: ast.names path: wtp.listView
        (
            bareFnRefErrorFor
            :ast
            :st
            nodeid: dp.nid
            lineno: dp.lineno
            colno: dp.colno
            width: 1
            fid: oc
            written: wpath.stringView
            refHint: false
        )
        return result
    }
    rewriteFieldReadAsObjectCall :st :ast :dp tid: result
    return (checkDottedOn :st :unitDecl :ast dp: (dpRefAt :ast nid: dp.nid) bt: result coerce: true)
}

# checkMarkerMember -- the access and conversion markers a dotted path can name
# instead of a member: `.private` / `.public` carry the base's own type,
# `.stringView` and `.str` convert between the two string forms, and `.borrow` is
# an ownership marker except on a protocol / facet / typedef-wrapper receiver,
# where it is a projection callable.
checkMarkerMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out callleg is {
    # `.private` / `.public` access markers: the path carries the base's
    # type (the access view is a dump-filtered shell, not a member).
    if cnId == zast.wellKnown.slot.wkPrivate then {
        # Gate B: a `.private` view may only be produced from a base that
        # already holds private access -- the type's own `this`/same-type
        # receiver (the class minting it), or an existing `.private` handle (a
        # friend forwarding what it was given, per spec). External code holding
        # only a public value cannot mint one -- E0102.
        baseGN: ast.nodes.get i: dp.parent
        if (baseIsPrivateCapable :st :ast :bt baseNode: baseGN).not then {
            cn: zast.nameTextAt :ast ref: cnId
            pcNode: ast.nodes.get i: dp.child
            pcnid: nodeId n: pcNode
            pcln: nodeLine n: pcNode
            pccl: nodeCol n: pcNode
            btNm: specWrittenName :st :ast tid: bt
            pmsg: "'.private' of '\{btNm}' may only be taken by '\{btNm}' or a holder of its '.private' handle"
            (
                addErrorWithHint
                :st
                nodeid: pcnid
                lineno: pcln
                colno: pccl
                e: zast.err.privateEscape
                msg: pmsg
                note: "".string
                hint: "".string
                width: cn.length
            )
        }
        setpv: bt
        stampGate :st nid: dp.nid tid: setpv
        return (callleg handled: true tid: bt)
    }
    # `public` is no member of anything: a unit's `public:` block IS its
    # surface (`host.MAX`), and a value outside its type reads only that
    # surface already. Inside the unit the block is reached by its own name.
    if cnId == zast.wellKnown.slot.wkPublic then {
        pbWhat: "type"
        if (st.reg.typetypeOf typeId: bt) == ztypes.ztypetype.unitType then pbWhat = "unit"
        pbNm: specWrittenName :st :ast tid: bt
        pcN: ast.nodes.get i: dp.child
        (
            addErrorWithHint
            :st
            nodeid: (zast.nodeIdOf n: pcN)
            lineno: (nodeLine n: pcN)
            colno: (nodeCol n: pcN)
            e: zast.err.typeError
            msg: "\{pbWhat} '\{pbNm}' has no member 'public'"
            note: "a `public:` block is the surface itself; its members are read directly".string
            hint: "".string
            width: 6
        )
        return (callleg handled: true tid: ztypes.tid.zero)
    }
    # in an INSTANCE the author wrote `.stringView` for a type parameter a
    # StringView happened to fill: the conversion is the identity, as `.copy` is
    if st.typing.curMonoStamp.notZero when (isStringViewMemberId nameId: cnId) when (
        bt == (stdTid :ast :st wk: zast.wellKnown.slot.tyStringView)
    ) then {
        stampGate :st nid: dp.nid tid: bt
        return (callleg handled: true tid: bt)
    }
    # `.stringView` on a StringView is an identity no-op and is rejected --
    # the value is already a StringView.
    if (isStringViewMemberId nameId: cnId) when (
        bt == (stdTid :ast :st wk: zast.wellKnown.slot.tyStringView)
    ) then {
        cn: zast.nameTextAt :ast ref: cnId
        msv: "redundant conversion: '.stringView' on a StringView".string
        nsv: "the value is already a StringView".string
        hsv: "drop '.stringView'".string
        (
            addErrorWithHint
            :st
            nodeid: dp.nid
            lineno: dp.lineno
            colno: dp.colno
            e: zast.err.typeError
            msg: msv
            note: nsv
            hint: hsv
            width: cn.length
        )
        return (callleg handled: true tid: ztypes.tid.zero)
    }
    # `.str` on String/StringView/str bases, and on a string literal read as its
    # StringView, is the sized-conversion form: the path resolves to the str
    # TEMPLATE (unstamped -- the call check mints the sized instance and stamps
    # only the Call node).
    if cnId == zast.wellKnown.slot.tyStr then {
        isStrBase: (
            (bt == (stdTid :ast :st wk: zast.wellKnown.slot.tyString)) or
            (bt == (stdTid :ast :st wk: zast.wellKnown.slot.tyStringView)) or
            (bt == st.reg.literalTextTid)
        )
        if isStrBase.not then {
            bga: ztypes.tid
            bgo: st.reg.genericOriginOf tid: bt
            if bgo.notZero then bga = bgo
            if bga.notZero when (
                bga == (stdTid :ast :st wk: zast.wellKnown.slot.tyStr)
            ) then isStrBase = true
        }
        if isStrBase then {
            sto: stdtypes.stdTidOpt :ast :st wk: zast.wellKnown.slot.tyStr
            if sto.some then {
                return (callleg handled: true tid: sto)
            }
        }
    }
    if cnId == zast.wellKnown.slot.wkBorrow then {
        # a `.borrow` VALUE bound by a binding or a `with` is a second name for
        # what it names: the alias may write through itself, so it pins the
        # source EXCLUSIVE. An ARGUMENT position locks through the call's own leg
        # instead, so the pin is left to it.
        if dp.nid != st.walk.callArgNode when (st.reg.isReftypeOf tid: bt) then {
            btup: ListVal zast.nameid
            moves.appendValueTuple :ast n: (ast.nodes.get i: dp.parent) dst: btup
            if btup.length > 0 when (st.lookupVarId nameId: (btup.get i: 0)).some then {
                moves.pinsPush :st path: btup shared: true mutable: true
            }
        }
        setbw: bt
        stampGate :st nid: dp.nid tid: setbw
        return (callleg handled: true tid: bt)
    }
    return (callleg handled: false tid: ztypes.tid.zero)
}

# isNativeFnTid -- the tid is a FUNCTION type whose body the compiler supplies.
# Two questions, not one: a native TYPE (String, a container) is not a native
# function, and a bodied function is not native.
isNativeFnTid: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    if (st.reg.typetypeOf typeId: tid) == ztypes.ztypetype.functionType then {
        return (st.reg.isNativeOf :tid)
    }
    return false
}

# checkNumericSuffixCast -- `1.u8` / `(2.5).f32`: when the child names a non-
# function type and the parent is a numeric literal, the path is a typed-literal
# cast -- the parent atom coerces to the suffix type and the path carries it.
checkNumericSuffixCast: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
} out callleg is {
    # Numeric dotted suffix (`1.u8`, `(2.5).f32`): when the child names a
    # non-function type, the path is a typed-literal cast -- the parent atom
    # coerces to the suffix type and the path carries it. Parens around the
    # literal are the same conversion: they leave no row of their own.
    castBaseId: dp.parent
    castBaseNm: atomNameId :ast n: (ast.nodes.get i: castBaseId)
    if (isNumericLiteralNameAt :ast ref: castBaseNm) then {
        castBase: zast.nameTextCopy :ast ref: castBaseNm
        castChildId: atomNameId :ast n: (ast.nodes.get i: dp.child)
        # WHICH conversions a literal offers is a question for its DECLARATION:
        # `intliteral` names the sixteen it can reach and `floatliteral` only
        # the four float ones. The declared surface is EXHAUSTIVE for a numeric
        # suffix, so a numeric target the literal type does not declare is an
        # error here rather than a fall-through -- otherwise `3.5.u8` would
        # materialise to f64 and quietly become f64's runtime-checked `u8`.
        # A child that names no scalar type is no conversion: it is one of the
        # literal type's other members (`+`, `5.times`), reached by the
        # ordinary member lookup.
        if (isScalarNameId id: castChildId).not then return (
            callleg
            handled: false
            tid: ztypes.tid.zero
        )
        litTid: st.reg.literalIntTid
        if (ztypes.isFloatLexeme numstr: castBase.stringView) then litTid = st.reg.literalFloatTid
        castOpt: conform.literalConvTarget :ast :st tid: litTid nameId: castChildId
        if castOpt.none when (refuseLiteralConversion :st :ast :dp :litTid childId: castChildId
        ) then {
            return (callleg handled: true tid: ztypes.tid.zero)
        }
        if castOpt.some then {
            castChild: zast.nameTextAt :ast ref: castChildId
            if (st.reg.typetypeOf typeId: castOpt) != ztypes.ztypetype.functionType then {
                # a compile-time-constant conversion is checked statically: a
                # lossy literal cast is an error (300.u8, 3.5.u8, an int beyond
                # a float's mantissa). Parse the base against the target kind
                # for range/float checks; add the int->float exact-mantissa check.
                (
                    consteval.checkLiteralFits
                    :st
                    nodeid: dp.nid
                    lineno: dp.lineno
                    colno: dp.colno
                    lit: castBase.stringView
                    target: castChild.stringView
                )
                setcp: castOpt
                stampGate :st nid: dp.parent tid: setcp
                setcd: castOpt
                stampGate :st nid: dp.nid tid: setcd
                recordSuffixDecl :st nid: dp.nid tid: litTid nameId: castChildId
                return (callleg handled: true tid: castOpt)
            }
        }
    }
    return (callleg handled: false tid: ztypes.tid.zero)
}

# refuseLiteralConversion -- a numeric conversion the literal type `litTid`
# does not declare (`3.5.u8`): reported, true. false for a child that names no
# numeric type, which reaches its member on the materialised receiver.
refuseLiteralConversion: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    litTid: ztypes.tid
    childId: zast.nameid
} out bool is {
    if (isScalarNameId id: childId).not then return false
    missChild: zast.nameTextAt :ast ref: childId
    ltn: specWrittenName :st :ast tid: litTid
    cm9: "'\{ltn}' has no conversion to '\{missChild}'"
    ch9: "a literal with a decimal point or an exponent is a float: convert it to a float type, or write the integer's digits".string
    cn9: String
    (
        addErrorWithHint
        :st
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
        e: zast.err.typeError
        msg: cm9
        note: cn9
        hint: ch9
        width: missChild.length
    )
    return true
}

# checkUntypedConstantCast -- `N.u8` where N is a constant built only from bare
# literals: the conversion is the literal's own (`5.u8`, `0.5.f32`), so the
# path carries the target type and the value must fit it, and one the literal
# type does not declare is refused as the literal's is. A typed constant
# converts through its type's surface like any value of that type.
checkUntypedConstantCast: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
} out callleg is {
    notCast: callleg handled: false tid: ztypes.tid.zero
    v: st.typing.nodeConstAt nid: dp.parent
    if (v.kind.ivalKind or v.kind.fvalKind).not or v.numTid.notZero then return notCast
    childId: atomNameId :ast n: (ast.nodes.get i: dp.child)
    if (isScalarNameId id: childId).not then return notCast
    litTid: st.reg.literalIntTid
    if v.kind.fvalKind then litTid = st.reg.literalFloatTid
    castOpt: conform.literalConvTarget :ast :st tid: litTid nameId: childId
    if castOpt.none when (refuseLiteralConversion :st :ast :dp :litTid :childId) then {
        return (callleg handled: true tid: ztypes.tid.zero)
    }
    if castOpt.none then return notCast
    target: castOpt
    fm: numerics.constFitsType :st :v :target
    if fm.length > 0 then (
        addError
        :st
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
        e: zast.err.typeError
        msg: fm
    )
    stampGate :st nid: dp.nid tid: target
    return (callleg handled: true tid: target)
}

# checkUntypedTextCast -- `NAME.text` or `NAME.stringView` where NAME is an
# untyped string constant, or a folded read of an untyped list's element: the
# conversion is the literal's own, as `"abc".text` is, so the base and the path
# carry the target type.
checkUntypedTextCast: function {st: zenv.ZSymbolTable ast: Ast dp: dpref} out callleg is {
    notCast: callleg handled: false tid: ztypes.tid.zero
    v: st.typing.nodeConstAt nid: dp.parent
    if v.kind.svalKind.not or v.numTid.notZero then return notCast
    target: textLiteralCastTarget :ast :st nameId: (atomNameId :ast n: (ast.nodes.get i: dp.child))
    if target.isZero then return notCast
    stampGate :st nid: dp.parent tid: target
    stampGate :st nid: dp.nid tid: target
    return (callleg handled: true tid: target)
}

# textLiteralCastTarget -- the type a textliteral's conversion member `nameId`
# makes it: text for `text`, StringView for `stringView`; 0 for any other name.
textLiteralCastTarget: function {
    ast: Ast st: zenv.ZSymbolTable nameId: zast.nameid
} out ztypes.tid is {
    if nameId == zast.wellKnown.slot.tyText then {
        return (stdTid :ast :st wk: zast.wellKnown.slot.tyText)
    }
    if nameId == zast.wellKnown.slot.wkStringView then {
        return (stdTid :ast :st wk: zast.wellKnown.slot.tyStringView)
    }
    return ztypes.tid.zero
}


# dottedAliasValueTid -- the type a body's path through a type names when its
# leaf is an alias of that type (`Tree.Node x: 1`, `ListVal Tree.Node`),
# stamped on the path as a type name is; 0 when the base is a local value, or
# the path names no alias.
dottedAliasValueTid: function {st: zenv.ZSymbolTable ast: Ast dp: dpref} out ztypes.tid is {
    bnm: zast.nameid
    {
        bn: ast.nodes.get i: dp.parent
        if bn.atomid then bnm = bn.name
    }
    if bnm.notZero when (st.lookup nameId: bnm).some then return ztypes.tid.zero
    t: (
        typePathAliasTid
        :st
        :ast
        scope: st.curScope
        parentNid: dp.parent
        leafId: (atomNameId :ast n: (ast.nodes.get i: dp.child))
        nid: dp.nid
    )
    if t.notZero then stampGate :st nid: dp.nid tid: t
    return t
}

# checkDotted -- a dotted method reference in a body: type the base, then the
# member on it (checkDottedOn).
checkDotted: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    coerce: bool
} out ztypes.tid is {
    if (typeref.refuseMisplacedImplement :st :ast nid: dp.nid) then return ztypes.tid.zero
    # an alias reached through its type (`Tree.Node x: 1`) names the type; read
    # as a value (`w: p.Inner`) it constructs, as the type's own name does
    tpv: dottedAliasValueTid :st :ast :dp
    if tpv.notZero when coerce when (readSingletonValue :st nid: dp.nid tid: tpv) then return tpv
    if tpv.notZero then {
        if coerce when st.mode.suppressBareCtor.not then (
            checkTypePathValue
            :st
            :ast
            nid: dp.nid
            leafNid: dp.child
            leafId: (atomNameId :ast n: (ast.nodes.get i: dp.child))
            tid: tpv
        )
        return tpv
    }
    nsc: checkNumericSuffixCast :st :ast :dp
    if nsc.handled then return nsc.tid
    if (
        callchecks.refuseMetaMember
        :st
        :ast
        path: dp.nid
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
    ) then return ztypes.tid.zero
    bt: moves.dottedBaseTid :st :unitDecl :ast :dp
    if bt.isZero then return ztypes.tid.zero
    return (checkDottedOn :st :unitDecl :ast :dp :bt :coerce)
}

# checkDottedOn -- the member of a dotted path whose base is already typed `bt`:
# look it up on that type and stamp the dotted node -- with the method's return
# when the method takes no user parameters beyond the receiver (the auto-call
# coercion), else with the method FUNCTION type itself.
checkDottedOn: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    coerce: bool
} out ztypes.tid is {
    ucc: checkUntypedConstantCast :st :ast :dp
    if ucc.handled then return ucc.tid
    utc: checkUntypedTextCast :st :ast :dp
    if utc.handled then return utc.tid
    cnId: atomNameId :ast n: (ast.nodes.get i: dp.child)
    if cnId.isZero then return ztypes.tid.zero
    sgc: checkSingletonCreateRead :st :dp :bt :cnId :coerce
    if sgc.handled then return sgc.tid
    # an instance's walk reads a partial base as the spec its arguments complete
    if (st.reg.isPartialOf tid: bt) then bt = instanceTypeOf :st :ast :unitDecl tid: bt
    # a member of an INTERFACE that names the interface in a parameter has no
    # vtable slot, so this is where reaching for it is refused -- with the rule
    # rather than with whatever an implementer happened to be called
    if (
        refuseSelfTypedMember
        :st
        :ast
        recvTid: bt
        nameId: cnId
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
    ) then return ztypes.tid.zero
    if (refuseStaticMarker :st :ast :dp :bt :cnId) then return ztypes.tid.zero
    noStorage: moves.refuseMarkerWithoutStorage :st :unitDecl :ast :dp :bt :cnId
    if noStorage then return ztypes.tid.zero
    mkm: checkMarkerMember :st :ast :dp :bt :cnId
    if mkm.handled then return mkm.tid
    xfm: moves.checkTransferMarker :st :unitDecl :ast :dp :bt :cnId
    if xfm.handled then return xfm.tid
    fcp: moves.checkFunctionCopy :st :ast :dp :bt :cnId
    if fcp.handled then return fcp.tid
    aix: checkArrayIndexMember :st :ast :dp :bt :cnId
    if aix.handled then return aix.tid
    dbm: moves.checkStaticListMember :st :unitDecl :ast :dp :bt :cnId
    if dbm.handled then return dbm.tid
    if (refuseGenericUnitMemberRead :st :ast :dp :bt) then return ztypes.tid.zero
    uqm: checkUnitQualifiedMember :st :unitDecl :ast :dp :bt :cnId :coerce
    if uqm.handled then return uqm.tid
    # public-interface rename: from OUTSIDE the type, a public alias resolves
    # to the internal member it exposes (the internal name stays private,
    # enforced below). Same-object access (this / a .private handle) uses
    # declared names, so translate only when the base is not private-capable.
    aliasViaX: false
    intNmX: zast.nameid
    {
        baseNodeX: ast.nodes.get i: dp.parent
        if st.typing.renameSeen when (
            baseIsPrivateCapable
            :st
            :ast
            :bt
            baseNode: baseNodeX
        ).not then {
            intNmX = declPublicAliasInternal :st tid: bt nameId: cnId
        }
    }
    if intNmX.notZero then {
        st.typing.setAliasInternalId nodeid: dp.nid internalId: intNmX
        cnId = intNmX
        aliasViaX = true
    }
    tdT: bt
    if (declaresOwnInequality :st :ast :bt :cnId).not then {
        bt = typedefMemberOwner :st :ast :bt :cnId
        if (refuseHiddenTypedefMember :st :ast :dp :bt :cnId) then return ztypes.tid
    }
    if (refuseTypedefArmConstructor :st :unitDecl :ast :dp :tdT :bt :cnId) then return ztypes.tid
    tacc: checkTagAccessor :st :unitDecl :ast :dp :bt :cnId
    if tacc.handled then return tacc.tid
    foldReadInstanceConstant :st :ast :bt :cnId
    forceMemberOf :st :ast parentTypeId: bt nameId: cnId
    mo: st.typing.declChildOfId parentTypeId: bt nameId: cnId
    preHas: false
    if mo.some then {
        preHas = true
    }
    # the partial a member is read through to its template, whose own type
    # arguments the member's type takes back (partialSubstituted)
    viaPartial: ztypes.tid
    # A partial carries no members of its own: getOrMintSpec skips the clone
    # for it, because an argument that is still a generic parameter has nothing
    # concrete to substitute. Read through to the TEMPLATE, whose members ARE
    # the answer while the template body is being checked; the per-instance
    # walk asks the completed spec instead.
    if preHas.not when (st.reg.isPartialOf tid: bt) then {
        baseOrigin: st.reg.genericOriginOf tid: bt
        if baseOrigin.notZero then {
            viaPartial = bt
            bt = baseOrigin
            forceMemberOf :st :ast parentTypeId: bt nameId: cnId
            mo = st.typing.declChildOfId parentTypeId: bt nameId: cnId
            # an element read by index (`a.1`) is no member the template
            # declares: the per-instance walk types it on the completed spec
            if mo.none when (isNumericLiteralNameAt :ast ref: cnId) then return ztypes.tid
        }
    }
    dn9: derivedInequalityMember :st :ast :bt :cnId :mo
    if dn9.some then {
        mo = optionval.some dn9
    }
    # a native container's `create` is its TEMPLATE's: every family declares the
    # one `create: function {capacity: 0.u64}`, which no type argument
    # substitutes, and an instance need not carry a copy of it -- under --eager
    # none does, and `(ListVal t: i64).create` was "no member"
    if mo.none when cnId == zast.wellKnown.slot.wkCreate when (monoOfNativeTemplate :st tid: bt
    ) then {
        ctpl: st.reg.genericOriginOf tid: bt
        # resolved by its declaration: the eager tier resolves no native create,
        # and forceMemberOf defers to it
        cmd: st.typing.declMemberIdOf parentTypeId: ctpl nameId: cnId
        if cmd.notZero then conform.forceMemberDecl :st :ast memberDeclId: cmd
        mo = st.typing.declChildOfId parentTypeId: ctpl nameId: cnId
    }
    match (
        mo
    ) case some then {
        rm: conform.checkResolvedMember :st :unitDecl :ast :dp :bt :cnId :mo :coerce :aliasViaX
        return (memberTypeViaPartial :st :ast :unitDecl :dp partial: viaPartial tid: rm)
    } case none then {
        return (checkUnresolvedMember :st :ast :unitDecl :dp :bt :cnId)
    }
}

# checkSingletonCreateRead -- `cap.create` read as a value, where `cap` is a bare
# numeric generic parameter: the zero-argument create of its singleton type,
# whose result is the type's one value, as the bare `cap` is. The template's own
# walk reads the parameter as its bound, and so the create's result too.
checkSingletonCreateRead: function {
    st: zenv.ZSymbolTable
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
    coerce: bool
} out callleg is {
    miss: callleg handled: false tid: ztypes.tid
    if coerce.not then return miss
    if cnId != zast.wellKnown.slot.wkCreate then return miss
    if (st.typing.numericParamRead.has key: dp.parent).not then return miss
    stampGate :st nid: dp.nid tid: bt
    if (st.typing.isSingletonType tid: bt) then (
        st.typing.setNodeConst
        nid: dp.nid
        value: (st.typing.singletonValueOf tid: bt)
    )
    return (callleg handled: true tid: bt)
}

# memberTypeViaPartial -- a member's type as the dotted path at `dp` reads it:
# read through a partial to its template, a value type takes the partial's own
# arguments back (partialSubstituted) and the path is restamped with it; a
# method, or a member read on no partial, is as checkResolvedMember answered
memberTypeViaPartial: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    dp: dpref
    partial: ztypes.tid
    tid: ztypes.tid
} out ztypes.tid is {
    if partial.isZero or tid.isZero then return tid
    if (st.reg.typetypeOf typeId: tid) == ztypes.ztypetype.functionType then return tid
    rs: partialSubstituted :st :ast :unitDecl :partial :tid
    if rs != tid then ztyping.nodeTypeSet tbl: st.typing.nodeType nid: dp.nid tid: rs
    return rs
}

# partialSubstituted -- a type read off a partial instance's template, with the
# partial's own type arguments put back: in a template walk `(array u64 to:
# n).listView` is `(ListViewVal t: u64)`, not the array template's
# `(ListViewVal t: t)`. A parameter the partial still leaves open stays a
# parameter; the per-instance walk sees the completed spec.
partialSubstituted: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    partial: ztypes.tid
    tid: ztypes.tid
} out ztypes.tid is {
    tdecl: st.typing.declIdOfType typeId: (st.reg.genericOriginOf tid: partial)
    if tdecl.isZero then return tid
    pn: st.reg.genericParamNamesOf :tdecl
    n: st.reg.genericArgCount specId: partial
    if pn.length < n then n = pn.length
    subs: IdMapV zast.nameid v: ztypes.tid
    idSubs: IdMapV ztypes.tid v: ztypes.genericarg
    i: u64
    for i < n loop {
        ta: st.reg.genericTypeArgAt specId: partial ordinal: i
        p: pn.get :i
        i = i + 1
        if ta.isZero then continue
        subs.set key: p value: ta
        (
            idSubs.set
            key: (declare.genericParamTidMint :st :ast :tdecl nameId: p)
            value: ztypes.genericarg.typeArg ta
        )
    }
    if subs.length == 0 then return tid
    return (
        substitutedMemberTid
        :ast
        :st
        :unitDecl
        rf: tdecl
        templateId: (st.reg.genericOriginOf tid: partial)
        chId: tid
        :subs
        :idSubs
    )
}

# declaresOwnInequality -- the member read is a `!=` this type answers itself,
# through the `==` its author wrote (derivedInequalityMember). Asked BEFORE the
# base a typedef delegates to, whose raw comparison takes the BASE's type: `a
# != 7.u64` was accepted where `a == 7.u64` is refused.
declaresOwnInequality: function {
    st: zenv.ZSymbolTable
    ast: Ast
    bt: ztypes.tid
    cnId: zast.nameid
} out bool is {
    if cnId != zast.wellKnown.slot.wkOpNe then return false
    forceMemberOf :st :ast parentTypeId: bt nameId: cnId
    mo: st.typing.declChildOfId parentTypeId: bt nameId: cnId
    return (derivedInequalityMember :st :ast :bt :cnId :mo).some
}

# refuseTypedefArmConstructor -- `ShapeAlias.sq 4`: an arm constructor named
# through a typedef `tdT` over a union or variant `bt` (the same type when the
# receiver is no typedef). A typedef is built from one value
# of its base, so the arm is constructed on the base and the typedef from it.
# On a VALUE the same path is the arm predicate, which reads through.
refuseTypedefArmConstructor: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    tdT: ztypes.tid
    bt: ztypes.tid
    cnId: zast.nameid
} out bool is {
    if tdT == bt then return false
    btt: st.reg.typetypeOf typeId: bt
    if btt != ztypes.ztypetype.unionType when btt != ztypes.ztypetype.variantType then return false
    mo: st.typing.declChildOfId parentTypeId: bt nameId: cnId
    if mo.none then return false
    ctt: st.reg.typetypeOf typeId: mo
    if (
        (ctt == ztypes.ztypetype.functionType) or
        (resolve.memberIsList :st parentTid: bt nameId: cnId) or
        (ctt == ztypes.ztypetype.tagType)
    ) then return false
    if (dottedBaseIsValue :st :ast :unitDecl n: (ast.nodes.get i: dp.nid)) then return false
    tn: specWrittenName :st :ast tid: tdT
    bn: specWrittenName :st :ast tid: bt
    an: zast.nameTextAt :ast ref: cnId
    (
        addErrorWithHint
        :st
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
        e: zast.err.typeError
        msg: "'\{an}' is an arm of '\{bn}', not of the typedef '\{tn}'"
        note: "a typedef is built from one value of its base".string
        hint: "construct the arm on '\{bn}' and build '\{tn}' from that value"
        width: 1
    )
    return true
}

# typedefMemberOwner -- the type a member read resolves on: the first link of
# the receiver's typedef chain that declares it -- the receiver itself, or the
# base a typedef delegates a member it does not carry to (Bytes.append is
# List_u8.append), through any number of typedefs. A typedef that hides the
# member (`twice: null`) declares it too, and typedefHidesMember tells the
# caller so. When no link declares it, the chain's end, whose conversions and
# lenient members answer for it.
typedefMemberOwner: function {
    st: zenv.ZSymbolTable
    ast: Ast
    bt: ztypes.tid
    cnId: zast.nameid
} out ztypes.tid is {
    cur: bt
    depth: u64
    for depth < 64 loop {
        depth = depth + 1
        forceMemberOf :st :ast parentTypeId: cur nameId: cnId
        if (st.typing.declChildOfId parentTypeId: cur nameId: cnId).some then return cur
        if (typedefHidesMember :st :ast tid: cur :cnId) then return cur
        nxt: st.typing.typedefBaseTidOf tid: cur
        if nxt.isZero then nxt = callchecks.typedefBaseOf :st tid: cur
        if nxt.isZero then return cur
        cur = nxt
    }
    return cur
}

# refuseHiddenTypedefMember -- a use of a member the typedef `bt` hides.
refuseHiddenTypedefMember: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out bool is {
    if (typedefHidesMember :st :ast tid: bt :cnId).not then return false
    hn: specWrittenName :st :ast tid: bt
    mn: zast.nameTextAt :ast ref: cnId
    (
        addErrorWithHint
        :st
        nodeid: dp.nid
        lineno: dp.lineno
        colno: dp.colno
        e: zast.err.typeError
        msg: "'\{hn}' hides '\{mn}'"
        note: "a typedef's `\{mn}: null` hides the member its base declares"
        hint: String
        width: 1
    )
    return true
}

# typedefHidesMember -- a typedef's as-block sets the member to `null`, which
# hides the member its base declares.
typedefHidesMember: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    tid: ztypes.tid
    cnId: zast.nameid
} out bool is {
    if (st.typing.typedefBaseTidOf :tid).isZero then return false
    td: templateDeclOf reg: st.reg typing: st.typing :tid
    if td.isZero then return false
    dnode: zast.nodeid
    dro: st.typing.decls.get i: td
    dnode = dro.node
    if dnode.isZero then return false
    nop: ast.nodes.get i: dnode
    if nop.namedoperation.not then return false
    op: ast.nodes.get i: nop.operation
    if op.objectdef then {
        return (declare.asBindingOf :st :ast ownerDecl: td asItems: op.asItems nameId: cnId).struck
    }
    return false
}

# checkBareTypeValue -- a bare TYPE name in value position is zero-argument
# construction (`p: Point`), so a synthesized create's required fields are
# enforced here. The name may be the type's own, a container twin or any alias
# of it, which is the one question bareNameDenotesType answers.
checkBareTypeValue: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    node: atomref
    fo: ztypes.tid
} is {
    if (
        bareNameDenotesType
        :ast
        :st
        :unitDecl
        scope: st.curScope
        nameId: node.name
        tid: fo
    ).not then return
    # a singleton type's name is its one value
    if (readSingletonValue :st nid: node.nid tid: fo) then return
    # a type its generic unit declares is that instance's copy: checked as the
    # instance, and not at all on the template's own walk
    nsv: unitNestedSelf :st :ast tid: fo
    if nsv == fo then return
    if nsv.notZero then {
        checkBareTypeValue :st :unitDecl :ast :node fo: nsv
        return
    }
    if (isImplicitZeroCreateTid :ast :st tid: fo) then {
        icv: fo
        st.typing.implicitCreate.set key: node.nid value: icv
    } else {
        checkBareTypeConstruction :st :ast :node tid: fo
    }
}

# bareFnCall -- a bare read of a function is a call with no arguments, whether it
# names the function or reads a reference to one from a variable: answers the
# call's result -- nothing, for a function with no `out` -- or, when a parameter
# is required, reports the missing arguments and answers the function itself.
# The caller has already asked whether the reference itself is wanted
# (suppressFnAutoCall).
bareFnCall: function {
    st: zenv.ZSymbolTable
    ast: Ast
    node: atomref
    fid: ztypes.tid
} out ztypes.tid is {
    if (fnAutoCallable :st mid: fid).not then {
        nm: zast.nameTextCopy :ast ref: node.name
        (
            bareFnRefErrorFor
            :ast
            :st
            nodeid: node.nid
            lineno: node.lineno
            colno: node.colno
            width: nm.length
            :fid
            written: nm.stringView
            refHint: true
        )
        return fid
    }
    noteStatementAutoCall :st nid: node.nid
    ro: conform.methodReturnOf reg: st.reg typing: st.typing mid: fid
    match (
        ro
    ) case some then {
        return ro
    } case none then {
        return st.typing.nullTypeId
    }
}

# rewriteReadAsCall -- the bare read `node` of a variable holding a function
# reference becomes, in the tree, the call it makes: the name moves to a fresh
# row, and the read's own row -- which every parent already holds -- is
# replaced by a call of that name with no arguments, at the name's position.
# What the checker walks next, and the emitter later, is that call.
rewriteReadAsCall: function {ast: Ast node: atomref} is {
    aid: zast.tableReserve :ast from: node.nid
    (
        zast.tableAdd
        :ast
        n: astnode.atomid (
            zast.atomidrow
            nodeid: aid
            lineno: node.lineno
            colno: node.colno
            name: node.name
        )
    )
    none: ListVal zast.nodeid
    (
        zast.tableSet
        :ast
        id: node.nid
        child: astnode.call (
            zast.callrow
            nodeid: node.nid
            lineno: node.lineno
            colno: node.colno
            callable: aid
            arguments: (zast.kidsAdd kids: ast.kids xs: none)
            infix: false
        )
    )
}

# eachSubjectNidOf -- the value node of a `for each` header (eachSubjectNid); 0
# for a plain header, whose value is evaluated -- and a callable one called -- at
# every iteration.
eachSubjectNidOf: function {isEach: bool nid: zast.nodeid} out zast.nodeid is {
    if isEach then return nid
    return zast.nodeid
}

# declaresIterate -- values of type `t` have a zero-argument `iterate`, the walk
# `for each` implies (implicitIterate).
declaresIterate: function {st: zenv.ZSymbolTable ast: Ast t: ztypes.tid} out bool is {
    forceMemberOf :st :ast parentTypeId: t nameId: zast.wellKnown.slot.wkIterate
    mo: (
        (st.typing.declChildOfId parentTypeId: t nameId: zast.wellKnown.slot.wkIterate).or
        d: ztypes.tid.zero
    )
    if mo.isZero then return false
    mt: mo
    if (st.reg.typetypeOf typeId: mt) != ztypes.ztypetype.functionType then return false
    return (fnAutoCallable :st mid: mt)
}

# readsObjectAsCall -- a bare read `nid` of a value of type `t` is a call of the
# object's `call`: the type has one, and nothing asks for the object itself --
# no marker after it (suppressFnAutoCall), not a dotted path's base
# (suppressBareCtor), not a write target, and not a `for each` header's value
# whose type declares `iterate`: `for each` asks `iterate` first. 0 when
# it is read as the object.
readsObjectAsCall: function {
    st: zenv.ZSymbolTable ast: Ast t: ztypes.tid nid: zast.nodeid
} out ztypes.tid is {
    if st.mode.suppressFnAutoCall or st.mode.suppressBareCtor then return ztypes.tid
    if st.mode.inAssignTarget then return ztypes.tid
    if nid == st.walk.eachSubjectNid when (declaresIterate :st :ast :t) then return ztypes.tid
    return (stdtypes.objectCallOf :st :ast :t)
}

# callsObjectBare -- the bare read `node`, of type `t`, of a callable object is
# rewritten into its call (rewriteReadAsObjectCall), answering true: the caller
# walks the call. A `call` that needs input is refused as a bare call missing
# its arguments, naming the read as written, and the read stays the object.
callsObjectBare: function {st: zenv.ZSymbolTable ast: Ast node: atomref t: ztypes.tid} out bool is {
    oc: readsObjectAsCall :st :ast :t nid: node.nid
    if oc.isZero then return false
    if (fnAutoCallable :st mid: oc) then {
        rewriteReadAsObjectCall :ast :node
        return true
    }
    nm: zast.nameTextCopy :ast ref: node.name
    (
        bareFnRefErrorFor
        :ast
        :st
        nodeid: node.nid
        lineno: node.lineno
        colno: node.colno
        width: nm.length
        fid: oc
        written: nm.stringView
        refHint: false
    )
    return false
}

# rewriteReadAsObjectCall -- the bare read `node` of a callable object becomes,
# in the tree, `node.call`: the read moves to a fresh row, and the read's own row
# -- which every parent already holds -- becomes the dotted path of its `call`,
# at the read's position. What is walked next, and emitted, is the written call.
rewriteReadAsObjectCall: function {ast: Ast node: atomref} is {
    aid: zast.tableReserve :ast from: node.nid
    (
        zast.tableAdd
        :ast
        n: astnode.atomid (
            zast.atomidrow
            nodeid: aid
            lineno: node.lineno
            colno: node.colno
            name: node.name
        )
    )
    cid: zast.tableReserve :ast from: node.nid
    (
        zast.tableAdd
        :ast
        n: astnode.atomid (
            zast.atomidrow
            nodeid: cid
            lineno: node.lineno
            colno: node.colno
            name: zast.wellKnown.slot.wkCall
        )
    )
    (
        zast.tableSet
        :ast
        id: node.nid
        child: astnode.dottedpath (
            zast.dottedpathrow
            nodeid: node.nid
            lineno: node.lineno
            colno: node.colno
            parent: aid
            child: cid
        )
    )
}

# rewriteFieldReadAsObjectCall -- the checked field read `dp` of a callable
# object becomes, in the tree, the base of its `call`: the read moves to a fresh
# row (keeping its stamp), and its own row -- which its parent holds -- becomes
# the dotted path `<read>.call`.
rewriteFieldReadAsObjectCall: function {
    st: zenv.ZSymbolTable ast: Ast dp: dpref tid: ztypes.tid
} is {
    rid: zast.tableReserve :ast from: dp.nid
    (
        zast.tableAdd
        :ast
        n: astnode.dottedpath (
            zast.dottedpathrow
            nodeid: rid
            lineno: dp.lineno
            colno: dp.colno
            parent: dp.parent
            child: dp.child
        )
    )
    stampGate :st nid: rid :tid
    cid: zast.tableReserve :ast from: dp.nid
    (
        zast.tableAdd
        :ast
        n: astnode.atomid (
            zast.atomidrow
            nodeid: cid
            lineno: dp.lineno
            colno: dp.colno
            name: zast.wellKnown.slot.wkCall
        )
    )
    (
        zast.tableSet
        :ast
        id: dp.nid
        child: astnode.dottedpath (
            zast.dottedpathrow
            nodeid: dp.nid
            lineno: dp.lineno
            colno: dp.colno
            parent: rid
            child: cid
        )
    )
}

# readsFnRefAsCall -- a read of a variable of type `t` is a call of the function
# it holds: `t` is a function type and nothing asks for the reference -- no
# marker after it (suppressFnAutoCall), and not the target of a write.
readsFnRefAsCall: function {st: zenv.ZSymbolTable.view t: ztypes.tid} out bool is {
    if (st.reg.typetypeOf typeId: t) != ztypes.ztypetype.functionType then return false
    if st.mode.suppressFnAutoCall then return false
    return st.mode.inAssignTarget.not
}

# typeOfBareName -- a bare name that is not a local: it names a TYPE, a unit, or a
# function. A no-arg non-generic FUNCTION name in value position is a call, and
# an aliased container name resolves through its twin. 0 when it names nothing.
typeOfBareName: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    node: atomref
} out ztypes.tid is {
    result: ztypes.tid
    fo: walkLookupTyperefById :st scope: st.curScope :ast :unitDecl baseId: node.name
    # `type` in a type's members names that type, in a body as in a signature,
    # and in a generic type's members the instance being checked (spec, type):
    # `type.make` is the type's own `make`
    if (bodySelfTypeNameId :st nameId: node.name) != node.name then {
        sty: constructionArgTid :st :ast :unitDecl opId: node.nid baseId: node.name
        if sty.notZero then fo = optionval.some sty
    }
    if fo.some then {
        result = fo
        # A bare no-arg non-generic FUNCTION name is a call: the
        # value is its return (an unregistered shell when out-less).
        isAutoFn: false
        isGenFn: false
        if fo < st.reg.nextTid then {
            fz: st.reg.typeById.get i: result
            if fz.typetype == ztypes.ztypetype.functionType then {
                if fz.isgeneric then {
                    isGenFn = true
                } else {
                    isAutoFn = true
                }
            }
        }
        # A GENERIC function's name is held to the same rule as any other: read
        # bare it is a call, and a required parameter is reported in the same
        # words. The read BECOMES the call in the tree (rewriteReadAsCall), whose
        # walk infers the type arguments -- from nothing, so a parameter no
        # default covers is refused there. `return` / `break` / `continue` are
        # generic builtins whose bare form IS the statement: a bare `return`
        # leaves a void function and supplies no result on purpose, so the
        # control names are not held to this.
        if isGenFn when (
            (flow.ctlDivKind bn: node.name) == zenv.divkind.none
        ) when st.mode.suppressFnAutoCall.not when st.mode.allowBareFnRef.not then {
            if (fnAutoCallable :st mid: fo) then {
                rewriteReadAsCall :ast :node
                return (checkValueRowAt :st :unitDecl :ast nid: node.nid)
            }
            wdtG: u32
            nmG: zast.nameTextAt :ast ref: node.name
            wdtG = nmG.length.u32.orPanic
            nmG.drop
            (
                bareFnRefError
                :ast
                :st
                nodeid: node.nid
                lineno: node.lineno
                colno: node.colno
                width: wdtG
                fid: fo
            )
        }
        if isAutoFn when (
            typeargs.refuseSpecValue
            :st
            :ast
            :unitDecl
            baseId: node.name
            nodeid: node.nid
            lineno: node.lineno
            colno: node.colno
        ) then isAutoFn = false
        if isAutoFn when st.mode.suppressFnAutoCall.not then {
            result = bareFnCall :st :ast :node fid: fo
        }
        # a type read as its zero value is the instance's: a generic unit's
        # parameter, or an alias of it, is the instance's argument, and the
        # construction is checked as that argument's
        if isAutoFn.not when isGenFn.not then result = instanceTypeOf :st :ast :unitDecl tid: result
        # atom-use def reference: the DEF's declaration (nodeType
        # carries the auto-call RETURN type above, not the referent)
        sfF: declSurfaceOfName :st :ast :unitDecl nameId: node.name tid: fo
        # a list's name reads its value, never a construction of its type
        isList: sfF.notZero and (st.typing.decls.get i: sfF).kind.staticListDecl
        if st.mode.suppressBareCtor.not when isList.not then (
            checkBareNameValue
            :st
            :unitDecl
            :ast
            :node
            :fo
            instTid: result
        )
        setu: result
        stampGate :st nid: node.nid tid: setu
        stampRefDecl :st nid: node.nid declId: sfF
        # the definition the name resolved to, wherever it lives: a namespace
        # member is no definition of the unit the read is written in
        walkDefinitionById :st :ast tid: fo
    }
    return result
}


# checkBareNameValue -- a bare name read as a value, checked as the
# construction it is: a generic parameter as the instance's argument
# (`instTid`), which the template's own walk does not check; any other type as
# itself (checkBareTypeValue).
checkBareNameValue: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    node: atomref
    fo: ztypes.tid
    instTid: ztypes.tid
} is {
    if (st.reg.typetypeOf typeId: fo) != ztypes.ztypetype.genericParam then {
        checkBareTypeValue :st :unitDecl :ast :node :fo
        return
    }
    if instTid == fo then return
    wdt: u32
    nm: zast.nameTextAt :ast ref: node.name
    wdt = nm.length.u32.orPanic
    nm.drop
    (
        checkBareTypeValueAt
        :ast
        :st
        nodeid: node.nid
        lineno: node.lineno
        colno: node.colno
        width: wdt
        tid: instTid
    )
}

# reportMissingYieldValue -- a bare `yield`, which supplies nothing. `yield`
# wears the control placeholder that `break` and `continue` wear, so no function
# leg sees it; unlike those two it carries the value the consumer receives, and
# omitting that wrote the bare name into the C for the C compiler to reject.
reportMissingYieldValue: function {st: zenv.ZSymbolTable node: atomref} is {
    (
        addErrorWithHint
        :st
        nodeid: node.nid
        lineno: node.lineno
        colno: node.colno
        e: zast.err.callError
        msg: "a bare `yield` supplies no value: the iteration produces what `yield` is given".string
        note: "`yield` is a function, and its argument is the element the consumer receives".string
        hint: "write `yield <value>`".string
        # the caller has already matched the name, so the caret spans `yield`
        width: 5
    )
}

# reportTakenNameUse -- a read of a name whose value was moved out earlier.
reportTakenNameUse: function {st: zenv.ZSymbolTable ast: Ast.view node: atomref} is {
    ndNm: zast.nameTextAt :ast ref: node.name
    (
        reportTakenUseAt
        :st
        nodeid: node.nid
        lineno: node.lineno
        colno: node.colno
        name: ndNm.stringView
        width: ndNm.length
    )
}

# reportTakenUseAt -- a read of `name` after its value was moved out: a name, or
# a field an earlier argument of the same call moved.
reportTakenUseAt: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    name: StringView
    width: u64
} is {
    eh5: String
    m5: "cannot use '\{name}' after ownership transfer"
    nt5: "this name no longer owns a value; it was moved earlier".string
    (
        addErrorWithHint
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.ownerError
        msg: m5
        note: nt5
        hint: eh5
        :width
    )
}

# checkLiteralAtom -- a numeric literal atom types as its literal pseudo-type.
# An INLINE type suffix (`65u8`, `2.5f32`) is not zerolang syntax: a
# conversion applies to a complete literal (`(65).u8`). Exempt 0x lexemes
# whose tail is hex-digit text (0x1f32, 0xac8) and 0c char literals (0c8 ends
# in a c8-shaped tail).
checkLiteralAtom: function {st: zenv.ZSymbolTable ast: Ast.view node: atomref} out ztypes.tid is {
    ndNm: zast.nameTextAt :ast ref: node.name
    sfR: ztypes.suffixInfoOf numstr: ndNm.stringView
    rejS: false
    if sfR.has then {
        rejS = true
        if (ndNm.stringView.startsWith prefix: "0x") then {
            sb: ndNm.stringView.byteAt ndNm.length - sfR.len
            if sb.some then {
                if sb == 0cf then rejS = false
                if sb == 0cc then rejS = false
            }
        }
        if (ndNm.stringView.startsWith prefix: "0c") then rejS = false
    }
    if rejS then {
        core: ndNm.stringView.substring from: 0 to: ndNm.length - sfR.len
        suffix: ndNm.stringView.substring from: ndNm.length - sfR.len to: ndNm.length
        m8: "Unknown reference '\{ndNm}'"
        h8: "a numeric conversion applies to a complete literal: write (\{core}).\{suffix}"
        en8: String
        (
            addErrorWithHint
            :st
            nodeid: node.nid
            lineno: node.lineno
            colno: node.colno
            e: zast.err.badReference
            msg: m8
            note: en8
            hint: h8
            width: ndNm.length
        )
        return ztypes.tid.zero
    }
    # a lexeme that spells no number at all is refused where it is written,
    # whatever position it stands in -- a statement's value included
    shapeErr: ztypes.literalShapeError lex: ndNm.stringView
    if shapeErr.length > 0 then {
        hs: String
        if (ndNm.stringView.startsWith "0c") or (ndNm.stringView.startsWith "-0c") then {
            hs = "a character literal is 0c and one character or one escape: 0ca, 0c\\n, 0c\\x41".string
        }
        (
            addErrorWithHint
            :st
            nodeid: node.nid
            lineno: node.lineno
            colno: node.colno
            e: zast.err.badToken
            msg: shapeErr
            note: String
            hint: hs
            width: ndNm.length
        )
        return ztypes.tid.zero
    }
    result: literalTidOfLexeme :st lex: ndNm.stringView
    if result != st.reg.literalFloatTid then noteWideLiteral :st :node lex: ndNm.stringView
    setl: result
    stampGate :st nid: node.nid tid: setl
    return result
}

# noteWideLiteral -- an integer literal no constant can hold, refused where it
# is written: past the 512 bits an untyped integer holds, in any radix. One
# inside them reaches its value, which lands where checkWideConstants settles
# it. Nineteen characters is the shortest lexeme outside i64.
noteWideLiteral: function {st: zenv.ZSymbolTable node: atomref lex: StringView} is {
    if lex.length < 19 then return
    if (lex.startsWith "0c") or (constLiteralBig :lex).some then return
    (
        addErrorWithHint
        :st
        nodeid: node.nid
        lineno: node.lineno
        colno: node.colno
        e: zast.err.typeError
        msg: "integer literal \{lex} overflows"
        note: String
        hint: "an untyped integer constant holds up to 512 bits".string
        width: lex.length
    )
}

# isDecimalLexeme -- the integer lexeme is written in decimal: no `0x`, `0o`,
# `0b` or `0c` prefix after its sign.
isDecimalLexeme: function {lex: StringView} out bool is {
    b: u64
    if lex.startsWith "-" then b = 1
    if ((lex.byteAt i: b).or d: 0) != 0c0 then return true
    c: (lex.byteAt i: b + 1).or d: 0
    return c < 0cA
}

# markAggsReached -- each data value the walk folded where no fold consumed
# it (a field read does) is used at run time: it and every data value it holds
# are reached, which the emitter writes out. A reached value's untyped numbers
# land in i64 and f64 there, so one outside them is refused at the value.
markAggsReached: function {ast: Ast.view st: zenv.ZSymbolTable} is {
    i: u64
    for i < st.walk.aggUses.length loop {
        ms: st.walk.aggUses.get :i
        i = i + 1
        taken: (st.walk.wideConstTaken.get key: ms).or d: 0
        if taken == 0 then (
            markAggReached
            :ast
            :st
            id: (st.typing.nodeConstAt nid: ms.node).aggId
            at: ms.node
        )
    }
}

# markAggReached -- aggregate row `id` and the aggregates it holds are reached
# from the run-time use at `at`; each, the first time, has its untyped numbers
# checked against i64 and f64, reported at that use.
markAggReached: function {ast: Ast.view st: zenv.ZSymbolTable id: u32 at: zast.nodeid} is {
    if (id == 0) or (aggHasNoValue :st :id) then return
    {
        g: st.typing.constAggs.getMut i: id.u64
        if g.reached then return
        g.reached = true
    }
    markAggItemsReached :ast :st :id :at
}

# markAggItemsReached -- the aggregates row `id` holds are reached with it. A
# data value or a list is held by its object's address, so its object is
# reached. A choice value is written inside its holder, in braces
# (staticChoiceInit), so it has no object of its own there: only what it holds
# is reached.
markAggItemsReached: function {ast: Ast.view st: zenv.ZSymbolTable id: u32 at: zast.nodeid} is {
    start: u64
    count: u64
    {
        g: st.typing.constAggs.get i: id.u64
        start = g.itemStart
        count = g.itemCount
    }
    k: u64
    for k < count loop {
        v: st.typing.constAggItems.get i: start + k
        k = k + 1
        if v.kind.aggKind then {
            if (st.typing.constAggs.get i: v.aggId.u64).kind.staticChoice then {
                markAggItemsReached :ast :st id: v.aggId :at
            } else {
                markAggReached :ast :st id: v.aggId :at
            }
        }
        consteval.refuseWideAggItem :ast :st :v :at
    }
}

# aggHasNoValue -- row `id` holds an element with no value: a generic unit's
# own list over its parameters, whose instances' rows are the ones run time
# reaches. A data value with a part of no value has no row at all.
aggHasNoValue: function {st: zenv.ZSymbolTable.view id: u32} out bool is {
    g: st.typing.constAggs.get i: id.u64
    k: u64
    for k < g.itemCount loop {
        if (st.typing.constAggItems.get i: g.itemStart.u64 + k).kind.none then return true
        k = k + 1
    }
    return false
}

# noteClosedRange -- record an `upto` / `downto` call, whose two ends
# checkClosedRangeSpans asks of once the walk has folded them.
noteClosedRange: function {st: zenv.ZSymbolTable ast: Ast.view call: callref} is {
    cn: dottedChildNameId :ast n: (ast.nodes.get i: call.callable)
    if (cn == zast.wellKnown.slot.wkUpto).not when (
        cn == zast.wellKnown.slot.wkDownto
    ).not then return
    st.walk.closedRanges.append (ztyping.monostamp mono: st.typing.curMonoStamp node: call.nid)
}

# checkAtomid -- type a bare name: a scope entry (break/continue diverge),
# else a numeric literal, else a definition looked up by name.
checkAtomid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    node: atomref
} out ztypes.tid is {
    result: ztypes.tid
    vtOpt: st.lookup nameId: node.name
    match (
        vtOpt
    ) case some then {
        result = vtOpt
        # break/continue diverge: the atom's value is never (the scope
        # entry stays the unregistered placeholder).
        # `yield` wears the same unregistered placeholder, and is the one of the
        # three that is NOT valueless: its argument is the element the consumer
        # receives, so a bare one is a call missing it.
        if node.name == zast.wellKnown.slot.wkYield when (numerics.yieldIsInScope :st) then {
            reportMissingYieldValue :st :node
        }
        isBrk: (
            (node.name == zast.wellKnown.slot.wkBreak) or
            (node.name == zast.wellKnown.slot.wkContinue)
        )
        if isBrk then result = stdTidOr :ast :st wk: zast.wellKnown.slot.tyNever d: result
        # a variable holding a function reference is called when read bare,
        # as the function's own name is. The read BECOMES the call in the tree
        # (rewriteReadAsCall), so everything after -- receiver temporaries,
        # path roots, the emitter -- sees a call, not the variable's storage.
        # a variable holding a callable object is called when read bare: the
        # read becomes `x.call` in the tree (rewriteReadAsObjectCall)
        if (callsObjectBare :st :ast :node t: result) then {
            return (checkValueRowAt :st :unitDecl :ast nid: node.nid)
        }
        if (readsFnRefAsCall :st t: result) then {
            if (fnAutoCallable :st mid: result) then {
                rewriteReadAsCall :ast :node
                return (checkValueRowAt :st :unitDecl :ast nid: node.nid)
            }
            result = bareFnCall :st :ast :node fid: result
        }
        stampGate :st nid: node.nid tid: result
        # atom-use variable id: stamped even during template walks (variable
        # ids are valid there; stampGate only gates GENERIC_PARAM types)
        avo: st.lookupVarId nameId: node.name
        if avo.some then {
            setav: avo
            st.typing.setAtomVariable nid: node.nid vid: setav
        }
    } case none then {
        result = checkUnboundAtom :st :unitDecl :ast :node
    }
    return result
}

# enclosingTypeDeclOf -- the type whose method body (or a body nested in one)
# the scope is inside; 0 outside any
enclosingTypeDeclOf: function {
    st: zenv.ZSymbolTable.view scope: ztypes.declid
} out ztypes.declid is {
    cur: scope
    for cur.notZero loop {
        k: (st.typing.decls.get i: cur).kind
        if k.unitDecl then return ztypes.declid.zero
        if k.typeDecl then return cur
        cur = st.typing.declParentOf declId: cur
    }
    return ztypes.declid.zero
}

# bodyMemberDecl -- the member of the enclosing type a bare body name finds
# before any outer declaration: a type's members are in scope throughout its
# methods' bodies. 0 when no enclosing type declares the name.
bodyMemberDecl: function {st: zenv.ZSymbolTable.view nameId: zast.nameid} out ztypes.declid is {
    td: enclosingTypeDeclOf :st scope: st.curScope
    if td.isZero then return td
    return (st.typing.declFindChild parentDeclId: td :nameId)
}

# bodyMemberIsConstant -- the member `md` is an `as` constant: an item holding
# a value, no alias, generic parameter or implementation, which the walk reads
# as it reads `type.K`
bodyMemberIsConstant: function {st: zenv.ZSymbolTable ast: Ast md: ztypes.declid} out bool is {
    td: (st.typing.decls.get i: md).parent
    if (asMemberIsAsItem :st :ast tdecl: td :md).not then return false
    if (asMemberIsAlias :st :ast tdecl: td :md) then return false
    item: argRefAt :ast nid: (st.typing.decls.get i: md).node
    if item.operation.isZero then return false
    if (zast.isGenericParamOp :ast opId: item.operation) then return false
    if (zast.implementBaseOf :ast opId: item.operation).notZero then return false
    return (ast.nodes.get i: item.operation).functiondef.not
}

# refuseBodyFieldRead -- a bare body name that finds a FIELD or an ARM of the
# enclosing type: an instance's member, read through a value of it. True when
# it refused.
refuseBodyFieldRead: function {
    st: zenv.ZSymbolTable ast: Ast nameId: zast.nameid nid: zast.nodeid
} out bool is {
    md: bodyMemberDecl :st :nameId
    if md.isZero then return false
    td: (st.typing.decls.get i: md).parent
    if (asMemberIsAsItem :st :ast tdecl: td :md) then return false
    if (st.typing.decls.get i: md).kind.methodDecl then return false
    what: memberKindPhrase :st :ast tdecl: td :md
    nn: zast.nameTextAt :ast ref: nameId
    tn: zast.nameTextAt :ast ref: (st.typing.decls.get i: td).name
    n: ast.nodes.get i: nid
    (
        addErrorWithHint
        :st
        nodeid: nid
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.typeError
        msg: "'\{nn}' is \{what} of '\{tn}', not a value: read it through a '\{tn}'"
        note: "".string
        hint: "".string
        width: nn.length
    )
    return true
}

# reportGreyUse -- E0103 at a use of a local whose statement is still being
# checked (zenv.isGreyName): it holds no value yet. Once per node.
reportGreyUse: function {
    st: zenv.ZSymbolTable ast: Ast.view nid: zast.nodeid nameId: zast.nameid
} is {
    if (st.typing.refusedValues.has item: nid) then return
    nn: zast.nameTextAt :ast ref: nameId
    n: ast.nodes.get i: nid
    (
        addErrorWithHint
        :st
        nodeid: nid
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.useBeforeInit
        msg: "'\{nn}' is used before it is initialised"
        note: "".string
        hint: "".string
        width: nn.length
    )
    st.typing.refusedValues.add item: nid
}

# refuseUnreadableLocal -- the bare name `node` finds a local with no value to
# read: grey, while its own statement is checked (E0103), or moved out of
# (E0200). True when it refused.
refuseUnreadableLocal: function {st: zenv.ZSymbolTable ast: Ast.view node: atomref} out bool is {
    ld: st.findLocal nameId: node.name
    if ld.isZero then return false
    if (st.typing.declIsResolving declId: ld) then {
        reportGreyUse :st :ast nid: node.nid nameId: node.name
        return true
    }
    if (st.isTakenDecl declId: ld).not then return false
    reportTakenNameUse :st :ast :node
    return true
}

# checkUnboundAtom -- a bare name no local binds: a moved name's use, a literal,
# a type, unit or function, or a numeric generic parameter. 0 when it names
# none of those.
checkUnboundAtom: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    node: atomref
} out ztypes.tid is {
    if node.name == zast.wellKnown.slot.wkReturn then numerics.reportMissingReturnValue :st :node
    # a numeric literal is told by its text, read through a view dropped before
    # the bare-name walk below lends ast. It names no local and no member, so
    # it is told first
    isLit: false
    ndNm: zast.nameTextAt :ast ref: node.name
    isLit = isNumericLiteralName name: ndNm.stringView
    ndNm.drop
    if isLit then return (checkLiteralAtom :st :ast :node)
    # a local the lookup answered none for: one whose statement is still being
    # checked, or one moved out of, asked off one lookup
    if (refuseUnreadableLocal :st :ast :node) then return ztypes.tid
    if (callchecks.bodyMemberAsPath :st :ast nameId: node.name nid: node.nid) then {
        return (checkValueRowAt :st :unitDecl :ast nid: node.nid)
    }
    if (refuseBodyFieldRead :st :ast nameId: node.name nid: node.nid) then return ztypes.tid
    ncr: checkNarrowedConstRead :st :unitDecl :ast :node
    if ncr.notZero then return ncr
    if (refuseStrayControl :st :unitDecl :ast :node) then return ztypes.tid
    # the parameter is the innermost scope's: a unit template declares it as a
    # member, where a type lookup would find it as a name
    result: checkNumericParamAtom :st :ast :node
    if result.isZero then result = typeOfBareName :st :unitDecl :ast :node
    return result
}


# refuseStrayControl -- a `break` or `continue` outside every scope that brings
# it in: a `for` loop brings both, a block `break` alone. The name then finds
# the system unit's own declaration, which documents the builtin and has no
# loop or block to leave. A unit's own definition of the name is an ordinary
# one. True when it refused.
refuseStrayControl: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    node: atomref
} out bool is {
    isBreak: node.name == zast.wellKnown.slot.wkBreak
    if isBreak.not when node.name != zast.wellKnown.slot.wkContinue then return false
    fo: walkLookupTyperefById :st scope: st.curScope :ast :unitDecl baseId: node.name
    if fo.none then return false
    d: st.typing.declIdOfType typeId: fo
    if d.isZero then return false
    if (st.typing.decls.get i: d).parent != st.typing.systemUnitRoot then return false
    nm: "continue"
    note: "`continue` is defined only inside a `for` loop".string
    hint: "it ends the current iteration of the innermost `for` loop that holds it -- move it into one, or remove it".string
    if isBreak then {
        nm = "break"
        note = "`break` is defined only inside a `for` loop or a block".string
        hint = "it leaves the innermost `for` loop or block that holds it -- move it into one, or remove it".string
    }
    (
        addErrorWithHint
        :st
        nodeid: node.nid
        lineno: node.lineno
        colno: node.colno
        e: zast.err.badReference
        msg: "Unknown reference '\{nm}'"
        :note
        :hint
        width: nm.length
    )
    return true
}

# checkNarrowedConstRead -- a bare name reading a unit constant that a match arm
# or an arm predicate narrowed to an arm carrying a payload: the name IS the
# payload, as a narrowed local's is. Its value is the payload the constant
# holds; an arm the constant does not hold is never run (its match or `if`
# folds), so a read there has a type and no value. 0 when the name is no
# constant narrowed so.
checkNarrowedConstRead: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    node: atomref
} out ztypes.tid is {
    d: st.subjectDecl nameId: node.name
    if d.isZero or (st.typing.decls.get i: d).kind.constDecl.not then return ztypes.tid.zero
    if (st.isShadowNarrowed nameId: node.name).not then return ztypes.tid.zero
    arm: st.getSubtypeName nameId: node.name
    v: flow.constSumValueOf :st :ast :unitDecl nameId: node.name
    if v.kind.none or arm.isZero then return ztypes.tid.zero
    if (armCarriesPayload :st armTid: (constValueTid :st scope: st.curScope :ast :v) armName: arm
    ).not then return ztypes.tid.zero
    tid: st.currentTypeOf declId: d
    pv: constArmPayload :st :v :arm
    st.typing.narrowedConstReads.set key: node.nid value: pv
    if pv.isConst then (
        st.typing.setNodeConst
        nid: node.nid
        value: pv
    )
    stampGate :st nid: node.nid :tid
    return tid
}

# constArmPayload -- the payload sum constant `v` holds in arm `arm`: its value
# when it holds that arm and the arm carries one, noConst otherwise
constArmPayload: function {
    st: zenv.ZSymbolTable.view v: ztypes.cval arm: zast.nameid
} out ztypes.cval is {
    if v.kind.aggKind.not then return ztypes.noConst
    g: st.typing.constAggs.get i: v.aggId.u64
    if (g.arm != arm) or (g.itemCount == 0) then return ztypes.noConst
    return (st.typing.constAggItems.get i: g.itemStart.u64)
}

# checkNumericParamAtom -- a bare name that names a numeric generic parameter of
# the definition the body is in: the one value of the parameter's singleton
# type, which each mono supplies (the evaluator reads it in the mono's walk) --
# the instance's singleton type in an instance's walk, the parameter's own
# (abstractSingletonOf) in the template's. 0 when the name is no such
# parameter.
checkNumericParamAtom: function {
    st: zenv.ZSymbolTable
    ast: Ast
    node: atomref
} out ztypes.tid is {
    owner: numericParamOwner :st nameId: node.name
    if owner.isZero then return ztypes.tid
    cd: st.reg.genericParamConstraintOf tdecl: owner paramName: node.name
    bt: numericBoundTid :ast :st scope: st.curScope :cd
    if bt.isZero then return ztypes.tid
    sg: monoSingletonOf :st nameId: node.name
    if sg.isZero then sg = abstractSingletonOf :st :ast tdecl: owner param: node.name bound: bt
    bt = sg
    stampGate :st nid: node.nid tid: bt
    (
        stampRefDecl
        :st
        nid: node.nid
        declId: (st.typing.declFindChild parentDeclId: owner nameId: node.name)
    )
    st.typing.numericParamRead.set key: node.nid value: node.name
    return bt
}

# numericParamOwner -- the declaration, enclosing the current scope, whose
# numeric generic parameter `nameId` is; 0 when none is.
numericParamOwner: function {st: zenv.ZSymbolTable.view nameId: zast.nameid} out ztypes.declid is {
    return (numericParamOwnerFrom :st scope: st.curScope :nameId)
}

# numericParamOwnerFrom -- the declaration at or enclosing `scope` whose numeric
# generic parameter `nameId` is; 0 when none is.
numericParamOwnerFrom: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    cur: scope
    for cur.notZero loop {
        if (st.reg.genericParamConstraintOf tdecl: cur paramName: nameId
        ).numKind.has then return cur
        cur = st.typing.declParentOf declId: cur
    }
    return ztypes.declid.zero
}

# isComparisonOp -- a binop operator whose result is bool (not the operand type).
isComparisonOp: function {nameId: zast.nameid} out bool is {
    return (consteval.cmpOpOf opnId: nameId).other.not
}

# stampTruthyCond -- record which arm a bare 2-arm-sum condition HOLDS when it
# is true: the second one, the type's non-falsy arm. Every reader then treats
# `if x` as `if x.<that arm>`. Stamped rather than derived, because a generic
# mono's record lives on the template it was minted from and reaching it needs
# the registry mutably.
stampTruthyCond: function {
    st: zenv.ZSymbolTable
    n: astnode.view
    tid: ztypes.tid
} is {
    ta: ztyping.sumPairTruthyArmOf ty: st.typing reg: st.reg :tid
    if ta.isZero then return
    nid: nodeId :n
    if nid.isZero then return
    st.typing.truthyCondArm.set key: nid value: ta
}

# ArmPredFact -- one bare arm predicate recognized in an if condition: the
# subject variable, the arm, the sum type, and whether the condition form
# is negated (`(x.a) == false` / trailing `.false`).
ArmPredFact: class {
    # the name the predicate tests
    subject: zast.nameid
    # the arm it tests for
    armName: zast.nameid
    # the subject's type before narrowing, so it can be restored
    fullTid: ztypes.tid
    # whether the test was inverted, which swaps which branch narrows
    negated: bool
}

# checkClauseCondition -- walk one if-clause condition: an unresolved value
# is an unknown reference, and the value must be a bool or a 2-arm sum type.
checkClauseCondition: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    cond: argref
    boolId: ztypes.tid
} is {
    errC: st.typing.errors.length
    ctv: checkValueAt :st :unitDecl :ast nid: cond.operation
    # a condition that typed to nothing and raised nothing is an
    # unresolvable name, exactly as in a binding or an operand: the
    # 0 disables the bool check below, and the emitter would write
    # the bare name into the C.
    if ctv.isZero when st.typing.errors.length == errC then {
        reportUnresolvedValue :st :unitDecl :ast nid: cond.operation
        refuseUntypedValue :st :ast nid: cond.operation
    }
    # An if-condition must be a boolean. A non-bool value (a
    # resultval, an aggregate, a raw numeric) is a type error rather
    # than invalid C. Bare arm predicates (`o.none`, `b.false`) type
    # as bool already; a diverging never-typed condition is allowed.
    # ... and so is any other 2-arm sum type: it has a falsy arm
    # and a truthy one, which is all a condition needs. Which arm
    # is which comes from the order the author wrote them.
    if ctv.notZero when boolId.notZero when ctv != boolId then {
        ctt: st.reg.typetypeOf typeId: ctv
        isPair: ztyping.isSumPair ty: st.typing reg: st.reg tid: ctv
        if isPair then {
            stampTruthyCond :st n: (ast.nodes.get i: cond.operation) tid: ctv
        }
        if ctt != ztypes.ztypetype.neverType when isPair.not then {
            conode: ast.nodes.get i: cond.operation
            ctnm: specWrittenName :st :ast tid: ctv
            cmsg: "condition must be bool or a 2-arm sum type, got '\{ctnm}'"
            (
                addError
                :st
                nodeid: cond.operation
                lineno: (nodeLine n: conode)
                colno: (nodeCol n: conode)
                e: zast.err.typeError
                msg: cmsg
            )
        }
    }
}

# materialiseLiteral -- fold a literal pseudo-type id to its concrete default
# (i64 / f64, StringView for a string); concrete ids pass through.
materialiseLiteral: function {
    ast: Ast
    st: zenv.ZSymbolTable
    t: ztypes.tid
} out ztypes.tid is {
    # a bare literal in a value context with no expected type IS `42.i64`: it
    # demands its own default scalar, the way the suffixed form and the
    # literal-NAME form (resolveNamedType) already do. Without this nothing
    # demands i64 for `x: 42` -- a literal names nothing.
    dn: literalTypeDefaultTid :st scope: st.curScope :ast :t
    if dn.isZero then return t
    return dn
}

# literalTypeDefaultTid -- the system scalar a literal pseudo-type takes where
# nothing gives it one (i64 or f64), read from the system unit as
# literalDefaultTid reads a constant's: a program's own `i64` is never a
# literal's type. `t` itself when it is no literal type; 0 when the system
# does not declare the scalar.
literalTypeDefaultTid: function {
    # the checked program
    st: zenv.ZSymbolTable
    # the scope the literal is written in
    scope: ztypes.declid
    # the tree the system unit is read from
    ast: Ast
    # the literal's type
    t: ztypes.tid
} out ztypes.tid is {
    nm: zast.nameid
    if t == st.reg.literalIntTid then nm = zast.wellKnown.slot.tyI64
    if t == st.reg.literalFloatTid then nm = zast.wellKnown.slot.tyF64
    if t == st.reg.literalTextTid then return (stdTid :ast :st wk: zast.wellKnown.slot.tyStringView)
    if nm.isZero then return t
    return (scalarTidOf :st :scope :ast nameId: nm)
}

# checkReadonlyBindSource -- the readonly and take bookkeeping a binding's SOURCE
# earns. Readonly is DEEP: a reftype read out of a readonly path is itself
# readonly and takes the same self-lock, or the binding would be a laundering
# step -- and a bare name launders exactly as a path does, which is why the
# rule asks about a one-segment path too.
checkReadonlyBindSource: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    asgn: asgnref
    vt: ztypes.tid
    boundVid: ztypes.vid
} is {
    # Readonly is deep: a reftype read out of a readonly path is itself
    # readonly, and takes the same self-lock. Without this the binding is
    # a laundering step -- `i: c.sub` off a `view` receiver would hand back
    # a freely mutable name.
    roPath: ListVal zast.nameid
    moves.appendValueTuple :ast n: (ast.nodes.get i: asgn.value) dst: roPath
    roDeep: false
    if roPath.length > 0 when (st.reg.isReftypeOf tid: vt) when (
        moves.pathLeafIsMethod
        :st
        path: roPath
    ).not when (moves.pathIsReadonly :st path: roPath) then roDeep = true
    if roDeep when (valueIsHold :ast n: (ast.nodes.get i: asgn.value)).not then {
        rop: ListVal zast.nameid
        rop.append asgn.name
        roh: ztypes.zlockholder.var boundVid
        ror: (
            st.tryLock
            pool: ast.names
            path: rop.listView
            lockType: ztypes.zlockstate.shared
            lockScope: ztypes.zlockscope.target
            holder: roh
            mutable: false
        )
        if ror.length > 0 then {
            (
                addError
                :st
                nodeid: asgn.nid
                lineno: asgn.lineno
                colno: asgn.colno
                e: zast.err.ownerError
                msg: ror
            )
        }
    }
    if (valueIsHold :ast n: (ast.nodes.get i: asgn.value)) then {
        # Owned but frozen: the same readonly self-lock a `view` parameter
        # takes, so writes, mutating receivers and re-passing to a mutable
        # parameter are all caught by the ordinary lock rules. Ownership is
        # the other axis and is already `owned` above.
        #
        # Both families, as lockReadonlyParam says of a parameter: a valtype
        # leaf normally skips locking, the read being a copy, but a `hold`
        # valtype is not a copy -- the lock is what makes the marker mean
        # anything.
        hpp: ListVal zast.nameid
        hpp.append asgn.name
        hph: ztypes.zlockholder.var boundVid
        hpr: (
            st.tryLock
            pool: ast.names
            path: hpp.listView
            lockType: ztypes.zlockstate.shared
            lockScope: ztypes.zlockscope.target
            holder: hph
            mutable: false
        )
        if hpr.length > 0 then {
            (
                addError
                :st
                nodeid: asgn.nid
                lineno: asgn.lineno
                colno: asgn.colno
                e: zast.err.ownerError
                msg: hpr
            )
        }
    }
}


# recordRootAt -- the root of pin `i` of the record `vp`, zero past its end.
recordRootAt: function {
    st: zenv.ZSymbolTable.view vp: ztyping.valuepins i: u64
} out zast.nameid is {
    if i >= vp.len then return zast.nameid
    p: st.walk.valuePins.get i: vp.start.u64 + i
    return (p.path.get i: 0)
}

# checkMovedValueAt -- type the value a place moves in whole: a binding or a
# reassignment, or an owning place (a `.take` parameter, an arm payload, a
# returned value), walked as checkOwnedValueAt walks one. A `w.take` moves w's
# locks into its value's record, which the place installs as any value's.
checkMovedValueAt: function {
    # the symbol table the moved value's locks are kept in
    st: zenv.ZSymbolTable
    # the unit the walk is in
    unitDecl: ztypes.declid
    # the tree the value is read from
    ast: Ast
    # the value node
    nid: zast.nodeid
    # the place owns what it is handed (checkOwnedValueAt)
    owning: bool
} out ztypes.tid is {
    if owning then return (callchecks.checkOwnedValueAt :st :unitDecl :ast :nid)
    return (checkValueAt :st :unitDecl :ast :nid)
}

# refuseValueBorrow -- `.borrow` on a VALUE type where the value is copied: a
# binding of it (`b: p.borrow`), a `with` (`with w: p.borrow`), a typedef built
# from it (`P p.borrow`). The copy aliases nothing, so no pin transfers to it,
# and it goes on reading the old value after `p` is written: the marker says a
# borrow that does not happen, and is refused. A `.borrow` PARAMETER, which is
# passed by reference, still aliases, and so does a protocol box, which points
# at its source. `value` is the marked node. true when it refused.
refuseValueBorrow: function {
    st: zenv.ZSymbolTable ast: Ast.view vt: ztypes.tid value: zast.nodeid
} out bool is {
    if vt.isZero or (st.reg.isValtypeOf tid: vt).not then return false
    vn: ast.nodes.get i: value
    if vn.dottedpath.not or (zast.markerKindOf :ast n: vn).borrowMarker.not then return false
    tn: specWrittenName :st :ast tid: vt
    (
        addErrorWithHint
        :st
        nodeid: value
        lineno: (nodeLine n: vn)
        colno: (nodeCol n: vn)
        e: zast.err.ownerError
        msg: "'\{tn}' is a value type: the binding copies it, so `.borrow` has nothing to borrow"
        note: "".string
        hint: "drop the marker; a `.borrow` parameter is what refers to the caller's value".string
        width: 1
    )
    return true
}

# namesItsOwnType -- the value at `nid` is a bare name whose declaration, or the
# alias it reached it through, declares its own type `vt`: the type itself
# written as a value
namesItsOwnType: function {st: zenv.ZSymbolTable.view nid: zast.nodeid vt: ztypes.tid} out bool is {
    rd: (st.typing.refDecl.get key: nid).or d: ztypes.declid
    if rd.isZero then return false
    return (st.typing.declTypeOf declId: rd) == vt
}

# nameIsUnitHere -- `nameId` names a unit where the walk stands: a unit has
# that name, and no local and no definition of a nearer scope takes it first
# (`io: io.print` makes `io` the program's own).
nameIsUnitHere: function {st: zenv.ZSymbolTable.view nameId: zast.nameid} out bool is {
    if nameId.isZero then return false
    ud: resolve.unitDeclOfName typing: st.typing :nameId
    if ud.isZero then return false
    if (st.lookupVarId :nameId).some then return false
    hit: envLookup :st scope: st.curScope :nameId
    return hit.declId.isZero or (hit.declId == ud)
}

# refuseUnitNameValue -- a unit's name written where a value is read -- an
# argument, a condition, a statement of its own: it names a unit and is no
# value. Said in a recorded walk; a template's walk is asked again per
# instance.
refuseUnitNameValue: function {st: zenv.ZSymbolTable ast: Ast.view nid: zast.nodeid} is {
    if st.recording.not then return
    vn: ast.nodes.get i: nid
    nameId: zast.atomNameIdOf n: vn
    if (nameIsUnitHere :st :nameId).not then return
    (
        addError
        :st
        nodeid: nid
        lineno: (nodeLine n: vn)
        colno: (nodeCol n: vn)
        e: zast.err.typeError
        msg: "'\{zast.nameTextAt :ast ref: nameId}' is a unit, not a value"
    )
}

# refuseUntypedValue -- a value a binding or an interpolation reads that has
# no type and that nothing has reported: a unit's name (`n: io`), or an
# expression that produces no value at all (`x: for i < 3 loop ..`, a member
# of a definition that has none). Without this it reached the emitter untyped. Said in a recorded walk -- a template leaves what its
# parameters decide untyped -- of a program with no other error.
refuseUntypedValue: function {st: zenv.ZSymbolTable ast: Ast.view nid: zast.nodeid} is {
    if st.recording.not or (st.typing.errors.length > 0) then return
    vn: ast.nodes.get i: nid
    msg: "the expression produces no value, so it cannot be used as one".string
    nameId: zast.atomNameIdOf n: vn
    if (nameIsUnitHere :st :nameId) then {
        msg = "'\{zast.nameTextAt :ast ref: nameId}' is a unit, not a value"
    }
    (
        addError
        :st
        nodeid: nid
        lineno: (nodeLine n: vn)
        colno: (nodeCol n: vn)
        e: zast.err.typeError
        :msg
    )
}

# refuseNullValue -- a value of type `null` or `never` bound or assigned, `vt`
# its type: the type `null` written as a value has none until a union or
# variant wraps it, any other expression typed `null` produces none, and one of
# type `never` does not finish, so there is nothing to bind. True when it
# refused.
refuseNullValue: function {
    st: zenv.ZSymbolTable ast: Ast.view vt: ztypes.tid nid: zast.nodeid
} out bool is {
    if vt.isZero then return false
    vtt: st.reg.typetypeOf typeId: vt
    if vtt != ztypes.ztypetype.nullType when vtt != ztypes.ztypetype.neverType then return false
    vn: ast.nodes.get i: nid
    nm: "the expression produces no value, so it cannot be used as one".string
    hint: "a call to a function with no `out` produces none, and so does a block whose last line has none or that ends in `break`".string
    w: 1.u32
    if vtt == ztypes.ztypetype.neverType then {
        nm = "a value of type 'never' cannot be bound -- the expression never finishes".string
        hint = String
    } else if (namesItsOwnType :st :nid :vt) then {
        nm = "'null' cannot be used as a value — null must be wrapped in a union or variant (eg. option.none)".string
        hint = String
        w = 4
    }
    (
        addErrorWithHint
        :st
        nodeid: nid
        lineno: (nodeLine n: vn)
        colno: (nodeCol n: vn)
        e: zast.err.typeError
        msg: nm
        note: String
        :hint
        width: w
    )
    return true
}

# checkAssignmentIn -- checkAssignment's check of the definition, whose local
# `grey` is bound and grey (0 when the block already binds the name).
checkAssignmentIn: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    asgn: asgnref
    grey: ztypes.declid
} is {
    errsBefore: st.typing.errors.length
    # an `if` or a `match` that is the whole value runs as statements, so its
    # arms may leave
    outerForm: st.walk.formValueNid
    st.walk.formValueNid = asgn.value
    vt: checkMovedValueAt :st :unitDecl :ast nid: asgn.value owning: false
    st.walk.formValueNid = outerForm
    mvt: materialiseLiteral :ast :st t: vt
    vt = mvt
    if vt.isZero when st.typing.errors.length == errsBefore then {
        reportUnresolvedValue :st :unitDecl :ast nid: asgn.value
        refuseUntypedValue :st :ast nid: asgn.value
    }
    if (refuseNullValue :st :ast :vt nid: asgn.value) then return
    vt = staticListAsValue :st :ast :vt nid: asgn.value
    if (flow.refuseUnitValue :st :ast :vt nid: asgn.value) then return
    refuseValueBorrow :st :ast :vt value: asgn.value
    if vt.notZero then {
        bpins: List ztyping.PinPath
        bread: (
            moves.pinsOfValue
            :st
            :ast
            :vt
            nid: asgn.value
            borrowing: true
            verb: "bind"
            dst: bpins
        )
        own: ztypes.zownership.owned
        # An `outx` result is pinned like a borrow but OWNED like a take, so
        # the pins must not demote it. The draft's `owned` tells them apart.
        # A view-family result (OptionView, ListView, StringView, ...) is the
        # reference itself, whatever its declaration spells: its binding is a
        # view of the parent, so the payload cannot be moved out of it.
        pboX: bread.owned
        if bpins.length > 0 when (st.reg.isReftypeOf tid: vt) then {
            if pboX.not then own = ztypes.zownership.borrowed
            if (isViewFamilyTid :ast :st tid: vt) then own = ztypes.zownership.borrowed
        } else if bpins.length > 0 when pboX.not when (isPlainValue :st :ast tid: vt) then {
            # a value-type element a call lends (`xs.getMut i: 0` over a
            # ListVal, a MutexGuardVal's `value`) is bound as a second name for
            # it: a write through the binding reaches the element, so the
            # binding keeps its source locked
            lent: moves.callHandsBackBorrow :st :ast n: (ast.nodes.get i: asgn.value)
            if lent then own = ztypes.zownership.borrowed
        }
        vid: st.reg.newVariable ztypeId: vt ownership: own
        if own == ztypes.zownership.borrowed then (
            st.reg.setVariableBorrowOrigin
            id: vid
            origin: (pinRootAt pins: bpins i: 0)
        )
        # An `out T.view` result makes its binding readonly because the binding
        # IS the reference it handed back. A value merely DERIVED from one --
        # a valtype field read, a comparison, an arithmetic result -- is a fresh
        # value that aliases nothing, so it must not inherit the restriction.
        # `own` already draws exactly that line: the pin transfers only to a
        # binding that the borrow actually flowed into.
        pending: bread.marker
        roRef: false
        if own == ztypes.zownership.borrowed then roRef = pending == ztypes.zparamownership.viewMode
        # An `out T.hold` result is readonly for a different reason: it is
        # OWNED, so it can never satisfy the borrowed gate above, and the
        # freeze is a property of the value rather than of a reference into
        # someone else's. Both end at the same self-lock below.
        if pending == ztypes.zparamownership.holdMode then roRef = true
        st.walk.draft.marker = ztypes.zparamownership.noneMode
        # the block bound the name before this statement began
        redefined: grey.isZero and asgn.name.notZero
        if redefined then {
            dnm: zast.poolTextAt pool: ast.names ref: asgn.name
            dlm: "duplicate definition of '\{dnm}': this block already binds that name -- rebinding it here is a redefinition, and only a NESTED block shadows"
            (
                addError
                :st
                nodeid: asgn.nid
                lineno: asgn.lineno
                colno: asgn.colno
                e: zast.err.duplicateDef
                msg: dlm
            )
        }
        st.defineVar nameId: asgn.name :vid
        bindGenLocal :st :ast :own :vid nameId: asgn.name value: asgn.value
        boundVid: vid
        st.typing.setDefVariable nid: asgn.nid vid: boundVid
        st.reg.setVariableOrigin id: boundVid origin: ztypes.zvarorigin.local
        setk: vt
        stampGate :st nid: asgn.nid tid: setk
        if roRef then {
            rrn: (ast.names.texts.get i: asgn.name).stringView
            rrr: readonlySelfLock :st :ast name: rrn vid: boundVid
            if rrr.length > 0 then {
                (
                    addError
                    :st
                    nodeid: asgn.nid
                    lineno: asgn.lineno
                    colno: asgn.colno
                    e: zast.err.ownerError
                    msg: rrr
                )
            }
        }
        checkReadonlyBindSource :st :ast :asgn :vt :boundVid
        instX: (own == ztypes.zownership.borrowed) or (pboX and (bpins.length > 0))
        st.walk.draft.owned = false
        if instX then {
            (
                installPins
                :st
                pool: ast.names
                pins: bpins
                :vid
                onlyRoot: zast.nameid
                forceShared: false
                nodeid: asgn.nid
                lineno: asgn.lineno
                colno: asgn.colno
            )
        }
        # Binding a tagged-subtype construction narrows the name to the
        # constructed arm (assignment-based narrowing: the overlay keeps the
        # subject's type and records the narrowed subtype).
        ucArm: moves.unionCreateArmId :ast :st n: (ast.nodes.get i: asgn.value)
        if ucArm.notZero then {
            st.narrow nameId: asgn.name toTypeId: vt subtypeName: ucArm shadow: false
        }
    }
}

# checkMethodRefTarget -- reassigning through a dotted target whose root is a
# receiver: the member being written must be a field of it, not a method.
checkMethodRefTarget: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    rasgn: reasgref
} is {
    tmk: borrowedFieldMarkerOf :st :ast :rasgn
    if tmk.length == 0 then return
    targetFnName: (
        zast.nameTextAt
        :ast
        ref: (dottedChildNameId :ast n: (ast.nodes.get i: rasgn.topath))
    )
    md: "Cannot reassign '.\{tmk}' field '\{targetFnName}' — a non-owned field is set at construction time and immutable"
    (
        addError
        :st
        nodeid: rasgn.nid
        lineno: rasgn.lineno
        colno: rasgn.colno
        e: zast.err.ownerError
        msg: md
    )
}

# borrowedFieldMarkerOf -- the marker (`borrow`, `view`) of the non-owned field a
# dotted target writes, read off its root's type; "" for an owned field or any
# other target.
borrowedFieldMarkerOf: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    rasgn: reasgref
} out String is {
    tmk: String
    targetRoot: moves.methodReceiverRootId :ast n: (ast.nodes.get i: rasgn.topath)
    targetFnId: dottedChildNameId :ast n: (ast.nodes.get i: rasgn.topath)
    if targetRoot.isZero or targetFnId.isZero then return tmk
    tto: st.lookup nameId: targetRoot
    if tto.some when (st.typing.declIsBorrowedFieldId parentTypeId: tto nameId: targetFnId) then {
        tmk.append "borrow"
        tmo: st.typing.declOwnershipOfId parentTypeId: tto nameId: targetFnId
        if tmo.some then {
            tmt: conform.markerText o: tmo
            if tmt.length > 0 then tmk = tmt.take
        }
    }
    return tmk
}

# checkNarrowedTargetWrite -- writing a bare name resets its narrowing (a fresh
# value of the whole declared type is legal again).
checkNarrowedTargetWrite: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    rasgn: reasgref
} is {
    nmId: atomNameId :ast n: (ast.nodes.get i: rasgn.topath)
    if nmId.isZero then return
    markVarRebound :st nameId: nmId
    # a narrowed name is written as its WHOLE declared type, and the emitter
    # spells the write's temporary and the destroy of the old value from the
    # target's stamp -- the payload's would assign a union to its payload
    if (st.isShadowNarrowed nameId: nmId) then {
        dto: st.declaredTypeOf nameId: nmId
        if dto.some then {
            stampGate :st nid: rasgn.topath tid: dto
        }
    }
    st.endNarrowingByWrite nameId: nmId
}

# refuseBorrowedWrite -- a swap of a bare name bound to a BORROWED variable, or
# a reassignment of a value-type reference -- a parameter passed by reference
# (`.borrow`, `.view`), or a local naming a value a call lent (`xs.getMut i: 0`)
# -- the writes a borrow does not re-point -- is refused: a swap exchanges what
# two owners hold, and a borrow holds nothing; a value-type reference is
# written through its fields, not replaced whole. An unmarked value-type
# parameter is the callee's own copy, reassigned as a local is.
# true when it refused.
refuseBorrowedWrite: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    target: zast.nodeid
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    # the write is a swap, not a reassignment
    swapping: bool
} out bool is {
    nmId: atomNameId :ast n: (ast.nodes.get i: target)
    if nmId.isZero then return false
    nvo: st.lookupVarId nameId: nmId
    if nvo.none then return false
    if (moves.isBorrowedVar :st vid: nvo).not then return false
    if swapping.not when (valtypeParamIsCopy :st vid: nvo nameId: nmId) then return false
    nm: zast.nameTextAt :ast ref: nmId
    ma: "Cannot reassign borrowed variable '\{nm}'"
    ena: "a parameter is not replaced whole".string
    if (st.reg.variableOriginOf id: nvo) != ztypes.zvarorigin.param then {
        ena = "it names a value a call lent, which is written through its fields, not replaced whole; replace it through what lent it (`set`)".string
    }
    if swapping then {
        ma = "Cannot swap borrowed variable '\{nm}'"
        ena = "a swap exchanges the values two owners hold, and a borrow owns none".string
    }
    ha: String
    (
        addErrorWithHint
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.ownerError
        msg: ma
        note: ena
        hint: ha
        width: nm.length
    )
    return true
}

# valtypeParamIsCopy -- the variable is a value-type parameter of the function
# being walked declared with no marker: passed by value, the callee's own copy.
valtypeParamIsCopy: function {
    st: zenv.ZSymbolTable.view vid: ztypes.vid nameId: zast.nameid
} out bool is {
    if (st.reg.variableOriginOf id: vid) != ztypes.zvarorigin.param then return false
    if (st.reg.isValtypeOf tid: (st.reg.variableTypeOf id: vid)).not then return false
    fn: st.walk.currentFnTid
    if fn.isZero then return false
    return (st.typing.declOwnershipOfId parentTypeId: fn :nameId).none
}

# retakeHoldLock -- `h = y.hold` rebinds a hold binding, so its readonly self-lock
# stepped aside for the write and is retaken here over the new value.
retakeHoldLock: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    rasgn: reasgref
    hbVid: ztypes.vid
    hbNmId: zast.nameid
} is {
    hrp: ListVal zast.nameid
    hrp.append hbNmId
    hrh: ztypes.zlockholder.var hbVid
    hrr: (
        st.tryLock
        pool: ast.names
        path: hrp.listView
        lockType: ztypes.zlockstate.shared
        lockScope: ztypes.zlockscope.target
        holder: hrh
        mutable: false
    )
    if hrr.length > 0 then {
        (
            addError
            :st
            nodeid: rasgn.nid
            lineno: rasgn.lineno
            colno: rasgn.colno
            e: zast.err.ownerError
            msg: hrr
        )
    }
}

# checkReassignment -- `lhs = value`: resolve the target path and the value, then
# reset any narrowing on a bare-name target (appends a non-definition overlay
# entry).
checkReassignment: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    rasgn: reasgref
} is {
    errsBeforeTarget: st.typing.errors.length
    lvt: refillTargetType :st :ast :rasgn
    if lvt.isZero then {
        st.mode.inAssignTarget = true
        lvt = checkValueAt :st :unitDecl :ast nid: rasgn.topath
        st.mode.inAssignTarget = false
    }
    # a target that resolved to nothing and raised nothing: an unresolvable
    # root name is an unknown reference, as at a read -- a local is not in
    # scope before the line that binds it
    if lvt.isZero when st.typing.errors.length == errsBeforeTarget then {
        unresolvedTarget: unresolvedBareCallable :ast :st :unitDecl nid: rasgn.topath
        if unresolvedTarget.length > 0 then (
            reportUnknownNameAt
            :st
            :ast
            nid: rasgn.topath
            name: unresolvedTarget
        )
    }
    # a target the walk accepted may still name no storage: the value is walked
    # for its own mistakes, and nothing below is asked of a slot that is not one
    addressable: isAddressableTarget :ast :st nid: rasgn.topath
    if st.typing.errors.length == errsBeforeTarget when addressable.not then {
        reportNotAddressable :st :ast target: rasgn.topath write: "reassignment"
        checkMovedValueAt :st :unitDecl :ast nid: rasgn.value owning: false
        return
    }
    if (
        (refuseStaticWrite :st :ast target: rasgn.topath) or
        (
            refuseSingletonWrite
            :st
            :ast
            target: rasgn.topath
        )
    ) then {
        checkMovedValueAt :st :unitDecl :ast nid: rasgn.value owning: false
        return
    }
    # `h = y.hold`: a hold binding rebinds only when the marker is written
    # again, so its readonly self-lock steps aside for this assignment and is
    # retaken over the new value. Without the marker the lock stands and the
    # write is rejected -- there is no implicit downgrade at a reassignment.
    # The target's bare name and the value's shape are read first.
    hbVid: ztypes.vid
    hbNmId: zast.nameid
    rvIsHold: false
    tpn: ast.nodes.get i: rasgn.topath
    hbNmId = atomNameId :ast n: tpn
    rvIsHold = valueIsHold :ast n: (ast.nodes.get i: rasgn.value)
    if hbNmId.notZero then {
        hbo: st.lookupVarId nameId: hbNmId
        if hbo.some then {
            hlh: st.findLockHolder nameId: hbNmId
            if hlh.some when hlh == (ztypes.zlockholder.var hbo) then {
                hbVid = hbo
                if rvIsHold then st.releaseHeldLocks holder: hlh
            }
        }
    }
    # a borrowed reftype local or parameter is re-pointed, not written through;
    # a value-type parameter is its own copy, and is not reassigned whole
    if hbNmId.notZero when (st.reg.isReftypeOf tid: lvt) then {
        # a borrowed local whose value moved out is re-pointed all the same
        bvo: st.writeTargetVarId nameId: hbNmId
        if bvo.some when (moves.isBorrowedVar :st vid: bvo) then {
            checkRepoint :st :unitDecl :ast :rasgn xVid: bvo :lvt
            return
        }
    }
    # a refused target walks no value: a move the value spells would outlive
    # the refusal and report its source as spent
    if (
        refuseBorrowedWrite
        :st
        :ast
        target: rasgn.topath
        nodeid: rasgn.nid
        lineno: rasgn.lineno
        colno: rasgn.colno
        swapping: false
    ) then return
    if (refuseModeChange :st :ast :rasgn targetHeld: hbVid.notZero vt: ztypes.tid) then return
    moves.checkWriteLock :st :ast n: (ast.nodes.get i: rasgn.topath) verb: "assign to" moving: false
    errsBeforeValue: st.typing.errors.length
    # a function-typed target is written a reference as any value is: a bare
    # callable path is called, and `.copy` is the reference
    owPrev: st.walk.owningValueNid
    st.walk.owningValueNid = moves.valueCoreNid :ast nid: rasgn.value
    rvt: checkMovedValueAt :st :unitDecl :ast nid: rasgn.value owning: false
    st.walk.owningValueNid = owPrev
    # a value that resolved to nothing and raised nothing: an unresolvable
    # root name is an unknown reference, as at a binding
    if rvt.isZero when st.typing.errors.length == errsBeforeValue then {
        unresolvedValue: unresolvedBareCallable :ast :st :unitDecl nid: rasgn.value
        if unresolvedValue.length > 0 then (
            reportUnknownNameAt
            :st
            :ast
            nid: rasgn.value
            name: unresolvedValue
        )
    }
    # a held target's readonly lock refused the write already (checkWriteLock)
    if hbVid.isZero when lvt.notZero when (
        (st.reg.typetypeOf typeId: lvt) != ztypes.ztypetype.functionType
    ) then {
        if (refuseModeChange :st :ast :rasgn targetHeld: false vt: rvt) then return
        moves.refuseArmLeavesIntoOwned :st :ast :rasgn
    }
    # the local's old value dies here, in whatever state the value left it --
    # recorded before the write lays anything over the local (its hold lock
    # retaken, its narrowing ended), which would read it as live again
    if hbNmId.notZero then st.recordNamedDestroy nid: rasgn.nid nameId: hbNmId
    if hbVid.notZero when rvIsHold then retakeHoldLock :st :ast :rasgn :hbVid :hbNmId
    moves.refuseBorrowedReassign :st :ast :rasgn targetNameId: hbNmId :rvt
    moves.refuseBorrowedArms :st :ast nid: rasgn.value verb: "by reassignment"
    consumeReassignPins :st :ast :rasgn :hbNmId :rvt
    valueTid: materialiseLiteral :ast :st t: rvt
    if valueTid.isZero then refuseUntypedValue :st :ast nid: rasgn.value
    if (refuseNullValue :st :ast vt: valueTid nid: rasgn.value) then return
    # A literal RHS at a concretely-typed target coerces: restamp the RHS. A
    # literal-typed target (a literal-init loop binding) keeps the pseudo.
    if lvt.notZero when rvt.notZero when (isAnyLiteralTid :st tid: rvt) when (
        isAnyLiteralTid
        :st
        tid: lvt
    ).not then {
        iid: nodeId n: (ast.nodes.get i: rasgn.value)
        if iid.notZero then {
            setc: lvt
            stampGate :st nid: iid tid: setc
        }
    }
    numerics.checkReassignedType :st :ast :rasgn :lvt :rvt
    checkNarrowedTargetWrite :st :ast :rasgn
    checkMethodRefTarget :st :ast :rasgn
}

# mintRepointCompanion -- the companion of the borrowed reftype local or
# parameter `borrowVid`, minted the first time it is re-pointed at an owned
# value: an owned local of the borrow's own scope, unnamed and empty until it is
# filled, destroyed wherever that scope ends as any owned local is -- the exits
# already recorded that leave it included (addToExitsLeaving). Zero where there
# is none: a generator's locals live in its instance, and a borrow does not live
# across a suspension.
mintRepointCompanion: function {
    st: zenv.ZSymbolTable
    ast: Ast
    borrowVid: ztypes.vid
} out ztypes.vid is {
    none: ztypes.vid
    if st.walk.currentGenTid.notZero then return none
    io: st.openIndexOf scope: (st.scopeOfVar vid: borrowVid)
    if io.none then return none
    tn: st.walk.nextTempId
    st.walk.nextTempId = tn + 1
    tname: "_t\{tn}"
    cv: (
        st.reg.newVariable
        ztypeId: (st.reg.variableTypeOf id: borrowVid)
        ownership: ztypes.zownership.owned
    )
    tnId: zast.poolSet pool: ast.names text: tname.stringView
    st.defineVarAt index: io nameId: tnId vid: cv
    st.reg.setVariableOrigin id: cv origin: ztypes.zvarorigin.local
    st.addToExitsLeaving index: io since: borrowVid vid: cv
    st.typing.repointCompanion.set key: borrowVid value: cv
    return cv
}

# checkRepoint -- `x = v` into the BORROWED local or parameter `x`: the name is
# re-pointed at what `v` borrows (repoints), the way a binding of `v` would
# borrow it, and nothing is written through it. `v` must be a borrow -- a
# place unmarked or `.borrow`, or a call that hands one back; a `.take` or
# `.hold` is refused as a mode change, and so is an owned value. The storage
# `v` borrows must live as long as `x`, and a writable `x` cannot take a
# readonly borrow. The re-point ends the borrow `x` held on the path it is
# written on: written in an arm or a loop body, the other paths keep it.
checkRepoint: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    rasgn: reasgref
    # the borrowed target
    xVid: ztypes.vid
    # the target's declared type
    lvt: ztypes.tid
} is {
    vn0: ast.nodes.get i: rasgn.value
    mk: zast.markerKindOf :ast n: vn0
    if mk.takeMarker or mk.holdMarker then {
        vmT: "an owned"
        if mk.holdMarker then vmT = "a held"
        reportRepointMode :st :ast :rasgn vmode: vmT
        return
    }
    # a borrow of `x` itself (`c: x`) aliases what `x` refers to, and the
    # re-point would release that storage under it; `x`'s own readonly lock is
    # no borrow of it
    oth: (
        st.lockHeldByOther
        nameId: (atomNameId :ast n: (ast.nodes.get i: rasgn.topath))
        except: ztypes.zlockholder.var xVid
    )
    if oth.some then {
        tn: varNameText :st :ast vid: xVid
        hn: st.formatLockHolder pool: ast.names holder: oth
        (
            addError
            :st
            nodeid: rasgn.nid
            lineno: rasgn.lineno
            colno: rasgn.colno
            e: zast.err.ownerError
            msg: "Cannot re-point '\{tn}': '\{hn}' borrows through it"
        )
        return
    }
    errR: st.typing.errors.length
    rvt: checkValueAt :st :unitDecl :ast nid: rasgn.value
    if rvt.isZero or (st.typing.errors.length != errR) then return
    numerics.checkReassignedType :st :ast :rasgn :lvt :rvt
    bpins: List ztyping.PinPath
    rread: (
        moves.pinsOfValue
        :st
        :ast
        vt: rvt
        nid: rasgn.value
        borrowing: true
        verb: "bind"
        dst: bpins
    )
    # an `outx` result is pinned and owned, unless it is a view -- the
    # reference itself, as its binding would be. A view a call hands back is a
    # value with no storage of its own, which `x` cannot refer to: it is kept
    # in the companion as an owned value is
    isView: isViewFamilyTid :ast :st tid: rvt
    owned: (
        (bpins.length == 0) or
        (rread.owned and isView.not) or
        (isView and (isAddressableTarget :ast :st nid: rasgn.value).not)
    )
    roV: rread.marker == ztypes.zparamownership.viewMode
    st.walk.draft.owned = false
    st.walk.draft.marker = ztypes.zparamownership.noneMode
    if owned then {
        repointOwned :st :ast :rasgn :xVid pins: bpins
        return
    }
    if (refuseRepointReadonly :st :ast :rasgn :xVid :lvt pins: bpins :roV) then return
    # a REFERENCE that dies before `x` -- a borrowed local of an arm `x` is
    # re-pointed in -- owns nothing: `x` borrows what it borrows instead, as a
    # value the arm hands back does (followDyingReferences)
    xpins: List ztyping.PinPath
    for each bp: bpins loop moves.appendFollowedPin :st p: bp dst: xpins depth: 0 holder: xVid
    if (refuseRepointOutlives :st :ast :rasgn :xVid pins: xpins) then return
    releaseCascade :st holder: ztypes.zlockholder.var xVid
    (
        installPins
        :st
        pool: ast.names
        pins: xpins
        vid: xVid
        onlyRoot: zast.nameid
        forceShared: false
        nodeid: rasgn.nid
        lineno: rasgn.lineno
        colno: rasgn.colno
    )
    st.reg.setVariableBorrowOrigin id: xVid origin: (pinRootAt pins: xpins i: 0)
    checkNarrowedTargetWrite :st :ast :rasgn
    st.typing.repoints.add item: rasgn.nid
}

# refuseRepointReadonly -- a writable borrowed target re-pointed at a readonly
# borrow (`roV`, or a pin that may not write) would write through storage it
# may only read. A readonly view writes through nothing, whatever it borrows; a
# window does. true when it refused.
refuseRepointReadonly: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rasgn: reasgref
    xVid: ztypes.vid
    lvt: ztypes.tid
    pins: (List ztyping.PinPath).view
    roV: bool
} out bool is {
    if (isViewFamilyTid :ast :st tid: lvt) when (stdtypes.isMutableViewTid :ast :st tid: lvt
    ).not then return false
    xName: varNameText :st :ast vid: xVid
    if (moves.nameIsReadonly :st :ast name: xName.stringView) then return false
    ro: roV
    for each rp: pins loop {
        if rp.mutable.not then ro = true
    }
    if ro.not then return false
    reportRepointMode :st :ast :rasgn vmode: "a readonly"
    return true
}

# repointOwned -- `x = v` with `v` an owned value -- a call's result, a
# construction -- or a view a call hands back, into the borrowed `x`: the
# value is stored in `x`'s companion
# (mintRepointCompanion), whose old value, and the locks it held, go first, and
# `x` refers to it. A lock the value holds is its companion's, so what it locks
# must live as long as `x`. Refused where `x` can have no companion.
repointOwned: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rasgn: reasgref
    xVid: ztypes.vid
    pins: (List ztyping.PinPath).view
} is {
    cv: (st.typing.repointCompanion.get key: xVid).or d: ztypes.vid
    if cv.isZero then cv = mintRepointCompanion :st :ast borrowVid: xVid
    if cv.isZero then {
        reportRepointMode :st :ast :rasgn vmode: "an owned"
        return
    }
    if (refuseRepointOutlives :st :ast :rasgn :xVid :pins) then return
    releaseCascade :st holder: ztypes.zlockholder.var cv
    if pins.length > 0 then (
        installPins
        :st
        pool: ast.names
        :pins
        vid: cv
        onlyRoot: zast.nameid
        forceShared: false
        nodeid: rasgn.nid
        lineno: rasgn.lineno
        colno: rasgn.colno
    )
    releaseCascade :st holder: ztypes.zlockholder.var xVid
    checkNarrowedTargetWrite :st :ast :rasgn
    st.typing.repoints.add item: rasgn.nid
    st.typing.ownedRepoints.add item: rasgn.nid
}

# reportRepointMode -- the refusal of re-pointing the borrowed target at a
# value of the mode `vmode`, spelt with its article (`an owned`).
reportRepointMode: function {
    st: zenv.ZSymbolTable ast: Ast.view rasgn: reasgref vmode: StringView
} is {
    tt: String
    moves.exprTextOf :ast n: (ast.nodes.get i: rasgn.topath) dst: tt
    mm: "Cannot reassign borrowed '\{tt}' with \{vmode} value: a reassignment keeps the ownership its target was bound with"
    vn: ast.nodes.get i: rasgn.value
    (
        addError
        :st
        nodeid: rasgn.value
        lineno: (nodeLine n: vn)
        colno: (nodeCol n: vn)
        e: zast.err.ownerError
        msg: mm
    )
}

# refuseRepointOutlives -- a re-point's pins rooted at a local of a scope that
# ends before the target's: the target would go on referring to storage that
# is gone. A borrowed or viewed parameter outlives every local. true when it
# refused.
refuseRepointOutlives: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    rasgn: reasgref
    xVid: ztypes.vid
    pins: (List ztyping.PinPath).view
} out bool is {
    xScope: st.scopeOfVar vid: xVid
    for each p: pins loop {
        root: p.path.get i: 0
        rvo: st.lookupVarId nameId: root
        if rvo.some when (st.reg.variableOriginOf id: rvo) != ztypes.zvarorigin.param when (
            st.scopeEncloses
            outer: (st.scopeOfVar vid: rvo)
            inner: xScope
        ).not then {
            xn: varNameText :st :ast vid: xVid
            rn: zast.nameTextAt :ast ref: root
            mo: "Cannot re-point '\{xn}' at '\{rn}': '\{xn}' outlives '\{rn}'"
            # a call's argument the result keeps locked has no name of the
            # program's
            if (st.walk.adoptableTemps.get key: root).some then {
                mo = "Cannot re-point '\{xn}' at a value that locks a temporary: '\{xn}' outlives the temporary"
            }
            (
                addError
                :st
                nodeid: rasgn.value
                lineno: (nodeLine n: (ast.nodes.get i: rasgn.value))
                colno: (nodeCol n: (ast.nodes.get i: rasgn.value))
                e: zast.err.ownerError
                msg: mo
            )
            return true
        }
    }
    return false
}

# refillTargetType -- a local whose value was moved out, written whole: the
# write refills it, so the target is typed as its declaration and stamped as its
# variable rather than read, which would be a use after the move. The write
# lays a live row over the local (checkNarrowedTargetWrite). Zero for any other
# target.
refillTargetType: function {st: zenv.ZSymbolTable ast: Ast.view rasgn: reasgref} out ztypes.tid is {
    nm: atomNameId :ast n: (ast.nodes.get i: rasgn.topath)
    if nm.isZero or (st.isTakenName nameId: nm).not then return ztypes.tid
    d: st.findLocal nameId: nm
    t: st.typing.declTypeOf declId: d
    stampGate :st nid: rasgn.topath tid: t
    v: st.typing.declLocalVarOf declId: d
    if v.notZero then st.typing.setAtomVariable nid: rasgn.topath vid: v
    return t
}

# refuseModeChange -- a reassignment keeps the ownership its target was bound
# with, so a value written in another mode is refused (reassignValueMode):
# `.hold` rebinds only a `.hold` binding, and a borrow is stored in no owned or
# held target -- `x = d.take` moves. A non-owned field target is
# checkMethodRefTarget's. Asked before the value is walked, with `vt` zero, of
# the markers, whose walk would move their source; and after, of an unmarked
# place. true when it refused.
refuseModeChange: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    rasgn: reasgref
    # the target is a `.hold` binding
    targetHeld: bool
    vt: ztypes.tid
} out bool is {
    vn: ast.nodes.get i: rasgn.value
    vmode: moves.reassignValueMode :st :ast n: vn :vt
    if vmode.length == 0 then return false
    if targetHeld when (zast.markerKindOf :ast n: vn).holdMarker then return false
    if (borrowedFieldMarkerOf :st :ast :rasgn).length > 0 then return false
    moves.reportModeChange :st :ast :rasgn :targetHeld :vmode value: rasgn.value
    return true
}

# isPlainValue -- `tid` is a value type that is no view: a copy of one is a
# value of its own, holding nothing of where it was read from.
isPlainValue: function {st: zenv.ZSymbolTable ast: Ast tid: ztypes.tid} out bool is {
    if (st.reg.isReftypeOf :tid) then return false
    return (isViewFamilyTid :ast :st :tid).not
}

# consumeReassignPins -- a pinning call on the right of `x = ...` keeps its
# pins under the TARGET, exactly as a binding would. The value the target held
# is destroyed by the assignment, so the locks it held go first. An owned value's
# pins must be locks the target may hold (refuseLockHolder).
consumeReassignPins: function {
    # the symbol table holding the pending pins
    st: zenv.ZSymbolTable
    # the tree the target name is spelt in
    ast: Ast
    # the reassignment, for the report position
    rasgn: reasgref
    # the target's bare name, zero when the target is a path
    hbNmId: zast.nameid
    # the assigned value's type; nothing is consumed for an untyped value
    rvt: ztypes.tid
} is {
    if rvt.isZero then return
    rpins: List ztyping.PinPath
    rr: (
        moves.readValuePins
        :st
        :ast
        vt: rvt
        nid: rasgn.value
        borrowing: false
        writes: false
        verb: "store"
        dst: rpins
    )
    if rpins.length == 0 then {
        releaseRefilledName :st nameId: hbNmId
        return
    }
    # An OWNED value holding locks -- a construction or an `outx` result over a
    # moved lock-holder -- lands in the target, so the target must be able to
    # hold them; a field store (`h.w = Option.some w`) keeps them under the
    # target's root.
    owned: rr.owned
    # a lent value keeps no pins in a field -- a plain one is copied there, any
    # other refused (refuseBorrowedReassign) -- nor in a name when it is plain:
    # it is copied into the name's own storage, or through it to the place the
    # name was bound to, whose locks the name keeps. A VIEW is the exception: its
    # copy views what it viewed, so its pins go wherever a copy of it does
    keepsNone: hbNmId.isZero or (isPlainValue :st :ast tid: rvt)
    if owned.not when (isViewFamilyTid :ast :st tid: rvt).not when keepsNone then return
    tgtNm: hbNmId
    if tgtNm.isZero then {
        tgtNm = rootNameIdOf :ast n: (ast.nodes.get i: rasgn.topath)
        if tgtNm.isZero then return
    }
    # a bare name whose value moved out is refilled here: its variable holds
    # what the new value keeps locked, though the row saying it holds a value
    # again is laid after (endNarrowingByWrite)
    tvo: st.lookupVarId nameId: tgtNm
    if hbNmId.notZero then tvo = st.writeTargetVarId nameId: hbNmId
    # a `w.take` is reported as w
    movedNm: moves.takenNameText :ast nid: rasgn.value
    if tvo.some then {
        if owned when (
            refuseLockHolder
            :st
            :ast
            held: rpins
            fromNm: movedNm.stringView
            movedT: rvt
            to: tvo
            verb: "by reassignment"
            nodeid: rasgn.nid
            lineno: rasgn.lineno
            colno: rasgn.colno
        ) then return
        # the old value's locks go before the new value's are laid, and a
        # temporary nothing holds after both lets go: one the new value views
        # (a `w.take`'s) is held by then
        if hbNmId.notZero then st.releaseHeldLocks holder: ztypes.zlockholder.var tvo
        (
            installPins
            :st
            pool: ast.names
            pins: rpins
            vid: tvo
            onlyRoot: zast.nameid
            forceShared: false
            nodeid: rasgn.nid
            lineno: rasgn.lineno
            colno: rasgn.colno
        )
        if hbNmId.notZero then st.releaseUnheldTemps
    }
}

# releaseRefilledName -- a value that keeps nothing locked replaced the value
# the bare name `nameId` held: the old value's locks end with it. A borrowed
# name is written through, to the place it refers to, and keeps its borrow; a
# `hold` binding's own readonly lock is retaken over its new value
# (retakeHoldLock).
releaseRefilledName: function {st: zenv.ZSymbolTable nameId: zast.nameid} is {
    if nameId.isZero then return
    tvo: st.writeTargetVarId :nameId
    if tvo.none then return
    th: ztypes.zlockholder.var tvo
    # most names written hold no lock at all
    if (st.holdsAnyLock holder: th).not then return
    if (moves.isBorrowedVar :st vid: tvo) then return
    hlh: st.findLockHolder :nameId
    if hlh.some when hlh == th then return
    releaseCascade :st holder: th
}

# checkSwap -- `lhs swap rhs` writes BOTH sides, so each is walked as a write
# target and asked what a reassignment's target is asked: that it names
# something, that it names storage, that no lock holds it, that it is not a
# borrowed name. The two then hold one type -- each receives the other's value,
# so there is no conversion -- and narrowing on each bare name ends. A side
# that was refused is not compared, so each mistake is reported once.
checkSwap: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    swapnode: swapref
} is {
    errL: st.typing.errors.length
    lwt: walkSwapSide :st :unitDecl :ast side: swapnode.lhs
    lok: st.typing.errors.length == errL
    errR: st.typing.errors.length
    rwt: walkSwapSide :st :unitDecl :ast side: swapnode.rhs
    rok: st.typing.errors.length == errR
    lt: checkSwapSide :st :unitDecl :ast :swapnode side: swapnode.lhs walked: lwt ok: lok
    rt: checkSwapSide :st :unitDecl :ast :swapnode side: swapnode.rhs walked: rwt ok: rok
    if lt.isZero then return
    if rt.isZero then return
    if (callchecks.swapTypesAgree :st a: lt b: rt).not then {
        an: specWrittenName :st :ast tid: lt
        bn: specWrittenName :st :ast tid: rt
        (
            addError
            :st
            nodeid: swapnode.nid
            lineno: swapnode.lineno
            colno: swapnode.colno
            e: zast.err.callError
            msg: "cannot swap '\{an}' with '\{bn}'"
        )
        return
    }
    resetSwapNarrowing :st :ast side: swapnode.lhs
    resetSwapNarrowing :st :ast side: swapnode.rhs
}

# walkSwapSide -- one side of a swap, walked as a write target is: a
# function-pointer field is a slot rather than a call missing its arguments,
# and a tag accessor is refused as read-only.
walkSwapSide: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    side: zast.nodeid
} out ztypes.tid is {
    st.mode.inAssignTarget = true
    t: checkValueAt :st :unitDecl :ast nid: side
    st.mode.inAssignTarget = false
    return t
}

# checkSwapSide -- the target checks of one walked swap side, in a
# reassignment's order: a name nothing declares, a location that is not
# storage, a lock, a borrowed name. Answers the side's DECLARED type -- a
# narrowed name swaps as its whole type, and its node is restamped so the
# emitter's temporary is spelt as that type -- or 0 when the side was refused
# or its walk already reported.
checkSwapSide: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    swapnode: swapref
    side: zast.nodeid
    # the type the side's walk answered
    walked: ztypes.tid
    # whether the walk raised nothing
    ok: bool
} out ztypes.tid is {
    none: ztypes.tid
    if ok.not then return none
    if walked.isZero then {
        ubn: unresolvedBareCallable :ast :st :unitDecl nid: side
        if ubn.length > 0 then reportUnknownNameAt :st :ast nid: side name: ubn
        return none
    }
    if (isAddressableTarget :ast :st nid: side).not then {
        reportNotAddressable :st :ast target: side write: "swap"
        return none
    }
    if (refuseSingletonWrite :st :ast target: side) then return none
    errW: st.typing.errors.length
    moves.checkWriteLock :st :ast n: (ast.nodes.get i: side) verb: "swap" moving: false
    if st.typing.errors.length != errW then return none
    if (
        refuseBorrowedWrite
        :st
        :ast
        target: side
        nodeid: swapnode.nid
        lineno: swapnode.lineno
        colno: swapnode.colno
        swapping: true
    ) then return none
    dt: walked
    nmId: atomNameId :ast n: (ast.nodes.get i: side)
    if nmId.notZero then {
        dto: st.declaredTypeOf nameId: nmId
        if dto.some then {
            dt = dto
        }
        if dt != walked then stampGate :st nid: side tid: dt
    }
    return (materialiseLiteral :ast :st t: dt)
}

# resetSwapNarrowing -- a swap writes a bare name, so narrowing on it ends.
resetSwapNarrowing: function {st: zenv.ZSymbolTable ast: Ast.view side: zast.nodeid} is {
    nmId: atomNameId :ast n: (ast.nodes.get i: side)
    if nmId.isZero then return
    markVarRebound :st nameId: nmId
    st.endNarrowingByWrite nameId: nmId
}

# isAddressableTarget -- whether a write target names STORAGE: a bare name a body
# binds (a variable, a parameter, a loop binding), or a path whose every step
# past its root is a slot -- a field, a function-pointer field, or an array
# element by constant index. A call, a literal, a unit constant, a type, a
# function, or a method -- at the leaf or in the middle -- names no storage, and
# C has nothing to assign to. Asked after the target's walk, whose member reads
# stamp the declaration each step resolved to.
isAddressableTarget: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    nid: zast.nodeid
} out bool is {
    cur: nid
    for cur.notZero loop {
        nameId: zast.nameid
        parentId: zast.nodeid
        childId: zast.nodeid
        isPath: false
        {
            n: ast.nodes.get i: cur
            match (
                n
            ) case atomid then {
                nameId = n.name
            } case dottedpath then {
                isPath = true
                parentId = n.parent
                childId = n.child
            } else null
        }
        if isPath.not then {
            if nameId.isZero then return false
            isLocal: st.isLocalName :nameId
            return isLocal
        }
        if (pathStepIsSlot :ast :st step: cur :childId isLeaf: cur == nid).not then return false
        cur = parentId
    }
    return false
}

# pathStepIsSlot -- one step of a write target's path names storage: an array
# element (a numeric child), or a member that is a slot, which a numeric generic
# parameter read through a value is not. A function field is
# storage only as the path's LEAF: in the middle of one it is called, and its
# result is a temporary.
pathStepIsSlot: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    step: zast.nodeid
    childId: zast.nodeid
    isLeaf: bool
} out bool is {
    if (isNumericLiteralNameAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: childId))
    ) then return true
    # a numeric generic parameter is fixed by the type: its declaration is the
    # parameter's, and no instance stores it
    if (st.typing.numericParamRead.has key: step) then return false
    md: (st.typing.refDecl.get key: step).or d: ztypes.declid
    if md.isZero then return false
    if (memberIsSlot :st declId: md).not then return false
    if isLeaf then return true
    return (st.typing.decls.get i: md).fnptrField.not
}

# memberIsSlot -- whether a member declaration is storage an instance holds: a
# field, or a function field of the `is` section. A function field is each
# instance's own slot whether or not it is written with a body -- the body is
# only its default -- so it can be replaced on the instance with a function of
# the same signature.
memberIsSlot: function {
    st: zenv.ZSymbolTable.view
    declId: ztypes.declid
} out bool is {
    mo: st.typing.decls.get i: declId
    return mo.kind.fieldDecl or mo.fnptrField
}

# reportNotAddressable -- the E0100 for a write target that names no storage.
reportNotAddressable: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    target: zast.nodeid
    # the write, as the message names it: `reassignment` or `swap`
    write: StringView
} is {
    tp: ListVal zast.nameid
    moves.appendValueTuple :ast n: (ast.nodes.get i: target) dst: tp
    what: "this expression".string
    if (ast.nodes.get i: target).call then what = "a call".string
    width: 1.u32
    if tp.length > 0 then {
        pp: zenv.formatPath pool: ast.names path: tp.listView
        what = "'\{pp}'"
        width = pp.length.u32.orPanic
    }
    tn: ast.nodes.get i: target
    (
        addErrorWithHint
        :st
        nodeid: target
        lineno: (nodeLine n: tn)
        colno: (nodeCol n: tn)
        e: zast.err.typeError
        msg: "\{what} is not an addressable location: a \{write} writes to a variable or a field"
        note: "".string
        hint: "only a variable, or a field reached through one, can be written".string
        :width
    )
}

# checkWith -- walk `with name: value do body`: push the `with` scope, bind the
# alias variable (BORROWED for a plain-path value), walk the body, then pop. The
# with node carries the bound value's type; the with-expression's value is the
# body's value.
checkWith: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    withnode: withref
} out ztypes.tid is {
    withMarker: st.pushBlock node: withnode.nid
    # the name is bound, grey, while its value is checked
    grey: st.beginLocal nameId: withnode.name
    errW: st.typing.errors.length
    vt: checkValueAt :st :unitDecl :ast nid: withnode.value
    # a literal bound to a name takes its default, as a plain binding's does:
    # a literal type has no run-time variable
    vt = materialiseLiteral :ast :st t: vt
    vt = staticListAsValue :st :ast :vt nid: withnode.value
    if (flow.refuseUnitValue :st :ast :vt nid: withnode.value) then vt = ztypes.tid
    refuseValueBorrow :st :ast :vt value: withnode.value
    if vt.u64 == 0 when st.typing.errors.length == errW then {
        reportUnresolvedValue :st :unitDecl :ast nid: withnode.value
    }
    # a value that failed still binds its name, typeless, so the body's reads
    # of it are not each an unknown reference
    if vt.isZero then {
        vh: st.reg.newVariable ztypeId: ztypes.tid ownership: ztypes.zownership.owned
        st.defineVar nameId: withnode.name vid: vh
    }
    if vt.notZero then {
        own: moves.withValueOwnership :ast :st nid: withnode.value
        # The borrow target: a BORROW-returning auto-call reported the receiver
        # source; a plain-path value pins its full dotted tuple, EXCLUSIVE since
        # the alias may write through itself.
        # Valtype borrows are copies -- no lock.
        wpins: List ztyping.PinPath
        wread: (
            moves.pinsOfValue
            :st
            :ast
            :vt
            nid: withnode.value
            borrowing: false
            verb: "bind"
            dst: wpins
        )
        pboW: wread.owned
        if wpins.length == 0 then {
            # a borrow pins the path it aliases; an auto-called member's result
            # is owned, and pins the path it was called on the same way, as it
            # may look into it without its signature saying so
            if (
                (own == ztypes.zownership.borrowed) or
                (moves.withValueIsMemberCall :st :ast v: (ast.nodes.get i: withnode.value))
            ) then {
                wtup: ListVal zast.nameid
                moves.appendValueTuple :ast n: (ast.nodes.get i: withnode.value) dst: wtup
                moves.pinsAppend pins: wpins path: wtup shared: true mutable: true carried: false
            }
        } else {
            # A reference return makes the with-binding borrowed; an `outx`
            # result is OWNED (it keeps its destructor) and only pins -- also
            # when it was reached as a dotted auto-call, which the shape rule
            # above read as a plain path. A view-family result is the
            # reference itself, so it binds borrowed.
            if pboW then {
                own = ztypes.zownership.owned
            } else {
                own = ztypes.zownership.borrowed
            }
            if (isViewFamilyTid :ast :st tid: vt) then own = ztypes.zownership.borrowed
        }
        vid: st.reg.newVariable ztypeId: vt ownership: own
        # the borrow origin, as a plain binding records it: what this alias is
        # a reference INTO. A for-loop over an iterator alias reads it back to
        # learn how strongly the alias pins the container it walks.
        if wpins.length > 0 then (
            st.reg.setVariableBorrowOrigin
            id: vid
            origin: (pinRootAt pins: wpins i: 0)
        )
        st.defineVar nameId: withnode.name :vid
        noteGenBorrowBinding :st :ast :own nameId: withnode.name value: withnode.value
        boundVid: vid
        st.typing.setDefVariable nid: withnode.nid vid: boundVid
        if (withValueCrossesSuspension :st :ast :withnode :own) then {
            # a literal value's type is the literal placeholder until a slot
            # asks for a width; a field is such a slot
            wvt: materialiseLiteral :ast :st t: vt
            wf: mintGenField :st :ast name: "wf" tid: wvt
            st.typing.genLocalFieldOf.set key: boundVid value: wf
        }
        if (st.reg.isReftypeOf tid: vt) then {
            (
                installPins
                :st
                pool: ast.names
                pins: wpins
                :vid
                onlyRoot: zast.nameid
                forceShared: false
                nodeid: withnode.nid
                lineno: withnode.lineno
                colno: withnode.colno
            )
        }
        setk: vt
        stampGate :st nid: withnode.nid tid: setk
    }
    # a `with` standing as a statement discards its body's value, so the body
    # stands as the statement too: `with x: v do if c then ...` needs no else
    st.endLocal declId: grey
    outerStmt: st.walk.stmtExprNid
    if outerStmt == withnode.nid then st.walk.stmtExprNid = withnode.body
    dt: checkValueAt :st :unitDecl :ast nid: withnode.body
    st.walk.stmtExprNid = outerStmt
    # a body that is one expression is the with's one arm: what its value pins is
    # kept for the destination, as an arm line's is, before the binding dies
    if (ast.nodes.get i: withnode.body).doexpr.not then (
        moves.recordHandedBackLocks
        :st
        :ast
        valNid: withnode.body
    )
    # a body that leaves on every path leaves the `with`, and takes the code
    # after it out of reach
    wk: st.unreachableKind
    if wk == zenv.divkind.none then wk = flow.exprDivKind :st :ast valueId: withnode.body
    moveWithValue :st :ast body: withnode.body used: outerStmt != withnode.nid kind: wk
    st.popTo marker: withMarker
    # a `with` used as a value answers whether it hands back a place
    if outerStmt != withnode.nid then moves.recordControlPlaceLeaves :st :ast nid: withnode.nid
    if wk > 0 then st.markUnreachable kind: wk
    return dt
}

# withValueCrossesSuspension -- an OWNED `with` value inside a generator body
# whose block suspends: the header's C local dies at the return, so the
# value lives in the instance instead. A borrowed value is a reference the
# instance could not own; it is left where it is.
withValueCrossesSuspension: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    withnode: withref
    own: ztypes.zownership
} out bool is {
    if st.walk.currentGenTid.isZero then return false
    if own != ztypes.zownership.owned then return false
    return (zast.yieldCountIn :ast nid: withnode.body) > 0
}

# wrapDoBreakValue -- the value type of a do-block that can BREAK: an early
# exit means there may be no value, so the block's type wraps in `optionval`
# (or `Option`, when the payload is a reftype and must be boxed). Returns the
# payload type unchanged when there is nothing to wrap.
#
# A break-carrying do-block's value wraps in optionval (early exit =
# none). A REFTYPE block value wraps in Option instead (boxed payload). A block
# whose last line has no value, or never finishes, is left only by its
# `break` and has no value either: null, not `never`, since the code after
# the block runs when it breaks.
#
# MATERIALISE THE PAYLOAD FIRST. The wrap mints a monomorphization keyed on
# the payload type, and a literal one would key it on `intliteral` -- which
# is how the literal type reached the emitter at all, as the payload field
# of `optionval_intliteral` in `x: { if c then break  42 }`. Generic-arg
# inference already keys on the concrete default everywhere else; this is
# the same rule, at the one site that did not apply it.
wrapDoBreakValue: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    donode: doref
    result: ztypes.tid
} out ztypes.tid is {
    if result.isZero then return result
    if (flow.blockHasBreak :ast n: (ast.nodes.get i: donode.statement)).not then return result
    rtt: st.reg.typetypeOf typeId: result
    if (rtt == ztypes.ztypetype.nullType) or (rtt == ztypes.ztypetype.neverType) then {
        return st.typing.nullTypeId
    }
    payloadTid: materialiseLiteral :ast :st t: result
    payloadName: st.reg.nameOf tid: payloadTid
    if payloadName.length == 0 then return payloadTid
    # the system's own Option or optionval: by its well-known slot, so a user
    # type spelled like one does not capture the value
    wrapWk: zast.wellKnown.slot.tyOptionval
    if (st.reg.isReftypeOf tid: payloadTid) then wrapWk = zast.wellKnown.slot.tyOption
    optionTemplate: stdtypes.stdTidOpt :ast :st wk: wrapWk
    if optionTemplate.none then return payloadTid
    # `ovo0` is whichever of Option / optionval the payload's family selected,
    # and each names its own parameter. A zero id stages under the elided key,
    # which getOrMintSpec rebinds to that same first parameter.
    optionSubs: IdMapV zast.nameid v: ztypes.tid
    optionSubs.set key: (firstGenericParamId :st templateId: optionTemplate) value: payloadTid
    monoSuffix: "_\{payloadName}"
    vsF: IdMapV zast.nameid v: u64
    omid0: (
        getOrMintSpec
        :st
        scope: st.curScope
        :ast
        :unitDecl
        sfx: monoSuffix.stringView
        templateId: optionTemplate
        subs: optionSubs
        valSubs: vsF
        fallbackArg: ztypes.tid.zero
    )
    if omid0.isZero then return payloadTid
    return omid0
}

# headerIsPlace -- the value a `for each` header walks is storage that already
# has a home: a variable, or a field read off one -- or either lent with
# `.borrow`, which moves nothing. It stays where it is across a
# suspension. Anything else -- a call's result, a construction, a method read
# off a place (an implied `.iterate` among them) -- is new, and a suspending
# loop keeps it in a state field.
headerIsPlace: function {st: zenv.ZSymbolTable.view ast: Ast.view nid: zast.nodeid} out bool is {
    n: ast.nodes.get i: nid
    match (
        n
    ) case atomid then {
        if (st.typing.implicitCreate.has key: nid) then return false
        return (st.lookupVarId nameId: n.name).some
    } case dottedpath then {
        mk: zast.markerKindOfLeaf :ast leaf: n.child
        if mk.borrowMarker then return (headerIsPlace :st :ast nid: n.parent)
        d: (st.typing.refDecl.get key: nid).or d: ztypes.declid
        if d.isZero then return false
        if (st.typing.decls.get i: d).kind.fieldDecl.not then return false
        return (headerIsPlace :st :ast nid: n.parent)
    } else {
        return false
    }
}

# bindForBorrowedElement -- bind a `for` loop name to a BORROWED element: the
# iteration hands back a view into the container, so the binding records its
# borrow origin and holds the container locked for the body.
bindForBorrowedElement: function {
    st: zenv.ZSymbolTable
    ast: Ast
    cond: argref
    elem: ztypes.tid
    nm: StringView
    # the element is a reference into the container's storage (an OptionView's
    # payload), not a view value of its own
    aliasesStorage: bool
    # what the header keeps locked (bindForIteration)
    fpins: List ztyping.PinPath
} is {
    vid: st.reg.newVariable ztypeId: elem ownership: ztypes.zownership.borrowed
    # the element borrows from the iterator it came from, named or called
    st.reg.setVariableBorrowOrigin id: vid origin: (forElementIteratorName :ast nid: cond.operation)
    nmId: cond.name
    st.defineVar nameId: nmId :vid
    # the element is the header's variable whatever shape the header is: an
    # `if` or a `match` over iterators included, which nodeId reads as none
    st.typing.setDefVariable nid: cond.operation :vid
    # `for each x: xs` has no iterator binding to carry
    # the container's lock, so the element carries it: the
    # reference the loop hands out points into the
    # container's storage, and a write through the
    # container reallocates it. The `with` form leaves
    # nothing pending here -- its binding took the lock.
    st.walk.draft.dropPins
    if fpins.length > 0 then {
        fcn: ast.nodes.get i: cond.operation
        fnd: zast.nodeIdOf n: fcn
        fln: nodeLine n: fcn
        fcl: nodeCol n: fcn
        (
            installPins
            :st
            pool: ast.names
            pins: fpins
            :vid
            onlyRoot: zast.nameid
            forceShared: false
            nodeid: fnd
            lineno: fln
            colno: fcl
        )
    }
    # THE `with` FORM: the element holds nothing of its own, so it takes the
    # iterator itself -- see lockIteratorForElement.
    iterNm: forElementIteratorName :ast nid: cond.operation
    if fpins.length == 0 then {
        ilm: lockIteratorForElement :st :ast iterName: iterNm :vid
        if ilm.length > 0 then {
            icn: ast.nodes.get i: cond.operation
            (
                addError
                :st
                nodeid: (zast.nodeIdOf n: icn)
                lineno: (nodeLine n: icn)
                colno: (nodeCol n: icn)
                e: zast.err.ownerError
                msg: ilm
            )
        }
    }
    # The element is a reference derived from the lock its
    # holder has on the container, so it inherits that
    # lock's strength: a SHARED pin (a `view` iterator
    # receiver) yields READONLY elements, an exclusive one
    # yields writable ones. An element that is a view value of
    # its own (`split`'s StringView) points into nothing it could
    # write: it holds the pins, as a view bound by a let does, and
    # stays an ordinary binding. The binding-free form knows its
    # own strength; a walk of an iterator binding -- `for each
    # e: it`, or the plain `for e: it.call`, whose pins are the
    # call's on the iterator -- asks the binding.
    elr: false
    if fpins.length > 0 when (pinsAllShared pins: fpins) then elr = true
    if elr.not then elr = iterElementIsReadonly :st iterName: iterNm
    if elr when aliasesStorage then {
        erm: readonlySelfLock :st :ast name: nm :vid
        if erm.length > 0 then {
            ecn: ast.nodes.get i: cond.operation
            end: zast.nodeIdOf n: ecn
            eln: nodeLine n: ecn
            ecl: nodeCol n: ecn
            addError :st nodeid: end lineno: eln colno: ecl e: zast.err.ownerError msg: erm
        }
    }
}


# forelem -- what a `for` header's binding yields, as forOptionElementOf or
# forIteratorElementOf reads it.
forelem: record {
    # the element type the loop name binds to; 0 when the iterable exposes
    # no element wrapper
    elem: ztypes.tid
    # the option wrapper the element was read out of: the iterable's own
    # type, or its (or its `call`'s) return
    wrapper: ztypes.tid
    # whether the wrapper is an OptionView: the element is then a borrowed
    # view into the container rather than an owned or copied value
    isView: bool
}

# mintGenField -- a state field the generator class needs for something a C
# local cannot hold across a suspension: minted here, during the body walk,
# because only the walk knows the type -- the payload of a loop, the value
# of a `with` -- and the struct, the generated create and the destructor
# read the declaration rows at emission, so a field declared late is a
# field like any other. Its name is `#<name>_<n>`, which no source can spell, so
# it never meets a field the author declared. Owning a reftype that carries a
# destructor makes the instance need one: an abandoned iterator frees what it
# was holding.
mintGenField: function {
    st: zenv.ZSymbolTable
    ast: Ast
    name: StringView
    tid: ztypes.tid
} out zast.nameid is {
    st.walk.genSpillNext = st.walk.genSpillNext + 1
    fnm: "#".string
    fnm.append name
    sfx: "_\{st.walk.genSpillNext}"
    fnm.append sfx
    fnId: zast.poolSet pool: ast.names text: fnm.stringView
    (
        st.typing.declSynthMemberTyped
        parentTypeId: st.walk.currentGenTid
        nameId: fnId
        kind: ztyping.declkind.fieldDecl
        childTypeId: tid
    )
    # a function reference is kept as a function-pointer FIELD, as a class's
    # is: a function-typed member without the flag is a method, which the
    # state struct does not store
    if (st.reg.typetypeOf typeId: tid) == ztypes.ztypetype.functionType then {
        (
            st.typing.setChildFnptrField
            pool: ast.names
            parentTypeId: st.walk.currentGenTid
            name: fnm.stringView
        )
    }
    if (st.reg.isReftypeOf :tid) when (st.reg.needsDestructor typeId: tid) then {
        st.reg.setNeedsDestructor typeId: st.walk.currentGenTid
    }
    return fnId
}

# mintForSpillFields -- the state fields a suspending loop's binding needs: its
# payload, typed by the element (an owned or value yield) or by the wrapper (a
# borrowed view: the emitter re-derives the element's pointer or copy from the
# saved union), and, for an `each` binding, its iterable when that is new
# rather than a place (headerIsPlace), which would otherwise live in a C local
# outside the loop. An iterable that is already a binding or a field is
# left where it is, and one of the generator's own type is not embedded.
mintForSpillFields: function {
    st: zenv.ZSymbolTable
    ast: Ast
    cond: argref
    fe: forelem
    vt: ztypes.tid
    facId: ztypes.tid
    isEach: bool
} is {
    payT: fe.elem
    if fe.isView then payT = fe.wrapper
    pf: mintGenField :st :ast name: "fp" tid: payT
    st.typing.forPayloadField.set key: cond.nid value: pf
    # a plain binding is evaluated afresh at every iteration: there is no
    # iterable to keep
    if isEach.not then return
    if facId.isZero when (headerIsPlace :st :ast nid: cond.operation) then return
    # a factory's auto-call already typed the header as the iterator it
    # returns; only a header still typed as the FUNCTION needs its return
    itT: vt
    if (st.reg.typetypeOf typeId: vt) == ztypes.ztypetype.functionType then {
        fr: conform.methodReturnOf reg: st.reg typing: st.typing mid: vt
        match (
            fr
        ) case some then {
            itT = fr
        } case none then {
            return
        }
    }
    if itT == st.walk.currentGenTid then return
    gf: mintGenField :st :ast name: "gi" tid: itT
    st.typing.forIterableField.set key: cond.nid value: gf
}

# forFactoryTid -- the type id of a bare 0-arg function in a `for` header that
# returns an iterator class, and so auto-invokes; 0 when the condition names
# no such function. Its walk runs in a call scope, so the atom keeps the
# FUNCTION stamp rather than the auto-call's coerced return.
forFactoryTid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    # the header's bare atom name id; zero when the condition is not an atom
    fbnId: zast.nameid
} out ztypes.tid is {
    facId: ztypes.tid
    if fbnId.notZero then {
        ffo: walkLookupTyperefById :st scope: st.curScope :ast :unitDecl baseId: fbnId
        if ffo.some when (st.reg.typetypeOf typeId: ffo) == ztypes.ztypetype.functionType when (
            methodHasNoUserArgs
            :st
            mid: ffo
        ) then {
            fro: conform.methodReturnOf reg: st.reg typing: st.typing mid: ffo
            if fro.some when (st.reg.typetypeOf typeId: fro) == ztypes.ztypetype.classType when (
                stdtypes.objectCallOf
                :st
                :ast
                t: fro
            ).notZero then facId = ffo
        }
    }
    return facId
}

# checkBareForCondition -- type a `for while <cond> loop` header that binds no
# name: the value must be bool or a 2-arm sum type. An iterator is a value
# like any other here -- its `call` is what answers, and the header writes it
# (`for it.call loop`) -- so a bare instance is refused rather than the
# invalid C a struct in a `while` head would emit.
checkBareForCondition: function {
    st: zenv.ZSymbolTable
    ast: Ast
    cond: argref
    vt: ztypes.tid
} is {
    fbId: stdTid :ast :st wk: zast.wellKnown.slot.wkBool
    fTt: st.reg.typetypeOf typeId: vt
    fPair: ztyping.isSumPair ty: st.typing reg: st.reg tid: vt
    if fPair then {
        stampTruthyCond :st n: (ast.nodes.get i: cond.operation) tid: vt
    }
    if fbId.notZero when vt != fbId when fTt != ztypes.ztypetype.neverType when fPair.not then {
        fcn: ast.nodes.get i: cond.operation
        fctn: specWrittenName :st :ast tid: vt
        fcmsg: "loop condition must be bool or a 2-arm sum type, got '\{fctn}'"
        (
            addError
            :st
            nodeid: (zast.nodeIdOf n: fcn)
            lineno: (nodeLine n: fcn)
            colno: (nodeCol n: fcn)
            e: zast.err.typeError
            msg: fcmsg
        )
    }
}


# iterwalk -- what an `each` binding walks when its value is not itself the
# iterator: the `E.iterate` node minted for it, and the iterator type that
# answered. A zero node means E is walked as it is.
iterwalk: record {
    nid: zast.nodeid
    tid: ztypes.tid
}

# implicitIterate -- `for each x: E` over a type with a zero-argument
# `iterate`: E is walked through it, exactly as if `E.iterate` were written.
# The call is a dotted node minted over the E already checked (so E runs, and
# is checked, once), and it is checked as the written call is -- its receiver
# lock, the pins its result keeps and its return all come from checkDottedOn.
# Only `iterate` is implied; a type without one is walked as it is.
implicitIterate: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    cond: argref
    vt: ztypes.tid
} out iterwalk is {
    none: iterwalk nid: zast.nodeid tid: vt
    # the member is read where checkDottedOn will read it: a typedef's is its
    # owner's, and a partial's is its template's
    ot: typedefMemberOwner :st :ast bt: vt cnId: zast.wellKnown.slot.wkIterate
    if (st.reg.isPartialOf tid: ot) then {
        og: st.reg.genericOriginOf tid: ot
        if og.notZero then ot = og
    }
    forceMemberOf :st :ast parentTypeId: ot nameId: zast.wellKnown.slot.wkIterate
    mo: (
        (st.typing.declChildOfId parentTypeId: ot nameId: zast.wellKnown.slot.wkIterate).or
        d: ztypes.tid.zero
    )
    if mo.isZero then return none
    mt: mo
    if (st.reg.typetypeOf typeId: mt) != ztypes.ztypetype.functionType then return none
    # callable with no arguments, as the written `E.iterate` must be to auto-call
    if (fnAutoCallable :st mid: mt).not then return none
    dn: implicitIterateNode :st :ast :cond
    rt: checkDottedOn :st :unitDecl :ast dp: (dpRefAt :ast nid: dn) bt: vt coerce: true
    return (iterwalk nid: dn tid: rt)
}

# implicitIterateNode -- the `E.iterate` node of an `each` condition, minted once
# over the condition's own value node (a loop's header may be walked again) and
# reported from E's file and position.
implicitIterateNode: function {st: zenv.ZSymbolTable ast: Ast cond: argref} out zast.nodeid is {
    have: st.typing.forImplicitIterate.get key: cond.nid
    if have.some then {
        return have
    }
    aid: zast.tableReserve :ast from: cond.operation
    (
        zast.tableAdd
        :ast
        n: astnode.atomid (
            zast.atomidrow
            nodeid: aid
            lineno: cond.lineno
            colno: cond.colno
            name: zast.wellKnown.slot.wkIterate
        )
    )
    did: zast.tableReserve :ast from: cond.operation
    (
        zast.tableAdd
        :ast
        n: astnode.dottedpath (
            zast.dottedpathrow
            nodeid: did
            lineno: cond.lineno
            colno: cond.colno
            parent: cond.operation
            child: aid
        )
    )
    st.typing.forImplicitIterate.set key: cond.nid value: did
    return did
}

# checkForCondition -- resolve one condition in a `for` header: the binding it
# introduces, the element type it iterates, and the locks that iteration takes.
checkForCondition: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    condId: zast.nodeid
    # whether the loop's body suspends inside a generator, so what the
    # header binds must be saved to the instance
    spillFor: bool
    # the loop's binding was written `each`
    isEach: bool
} is {
    # the condition is a namedoperation row, read as plain values: the
    # walks below lend ast
    cond: argRefAt :ast nid: condId
    if cond.nid.isZero then return
    # the name a condition binds is bound, grey, while its value is checked
    grey: ztypes.declid
    if (zast.nameTextAt :ast ref: cond.name).length > 0 then grey = st.beginLocal nameId: cond.name
    checkForConditionIn :st :unitDecl :ast :cond :condId :spillFor :isEach
    st.endLocal declId: grey
}

# checkForConditionIn -- checkForCondition's check of the condition `cond`.
checkForConditionIn: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    cond: argref
    condId: zast.nodeid
    spillFor: bool
    isEach: bool
} is {
    # A bare 0-arg function returning an iterator class, as an `each`
    # binding, auto-invokes: its walk runs in a call scope and the atom keeps
    # the FUNCTION stamp rather than the auto-call's coerced return.
    fbnId: zast.nameid
    if isEach then fbnId = zast.atomNameIdOf n: (ast.nodes.get i: cond.operation)
    facId: forFactoryTid :st :unitDecl :ast :fbnId
    vt: ztypes.tid
    errC: st.typing.errors.length
    # An `each` header's value is the ITERATOR, not a call. `for each x: 5.times loop`
    # lowers to a counted C loop and emits no call at all, so a member that
    # keeps its FUNCTION stamp here is legitimate and its arity never
    # matters. fnAutoCallable answers false for that AND for a bare
    # `r.add` in value position, so it cannot separate them -- this flag
    # does. It does NOT suppress the auto-call: `for each x: counter loop` over
    # a 0-arg generator still has to be invoked.
    savedMode: st.mode
    st.mode.allowBareFnRef = true
    esPrev: st.walk.eachSubjectNid
    st.walk.eachSubjectNid = eachSubjectNidOf :isEach nid: cond.operation
    if facId.notZero then {
        # the factory's lazy walks (its body + the iterator class's
        # methods via return-first transitivity) fire before the
        # synthetic invocation's call scope opens.
        bodies.maybeWalkMethodsById :st scope: st.curScope :unitDecl :ast nameId: fbnId
        fcm: st.pushCall node: condId
        vt = checkValueAt :st :unitDecl :ast nid: cond.operation
        st.popTo marker: fcm
        fiid: nodeId n: (ast.nodes.get i: cond.operation)
        if fiid.notZero then {
            setff: facId
            stampGate :st nid: fiid tid: setff
        }
    } else {
        vt = checkValueAt :st :unitDecl :ast nid: cond.operation
    }
    st.mode = savedMode
    st.walk.eachSubjectNid = esPrev
    vt = staticListAsValue :st :ast :vt nid: cond.operation
    if (flow.refuseUnitValue :st :ast :vt nid: cond.operation) then vt = ztypes.tid
    # a condition that typed to nothing and raised nothing is an
    # unresolvable name -- the same rule the binding and operand sites
    # follow. Without it the emitter writes the bare name into the C.
    if vt.isZero when st.typing.errors.length == errC then {
        reportUnresolvedValue :st :unitDecl :ast nid: cond.operation
        refuseUntypedValue :st :ast nid: cond.operation
    }
    nm: zast.nameTextCopy :ast ref: cond.name
    # A bare `for while <cond> loop` must be boolean or a 2-arm sum; anything
    # else is a type error rather than invalid C.
    if nm.length == 0 when vt.notZero then {
        checkBareForCondition :st :ast :cond :vt
    }
    if nm.length > 0 when vt.notZero then {
        (
            stdtypes.bindForIteration
            :st
            :unitDecl
            :ast
            :cond
            :vt
            nm: nm.stringView
            :facId
            :spillFor
            :isEach
        )
    }
    # an iterable that failed still binds its loop name, typeless, so
    # the body's reads of it are not each an unknown reference
    if nm.length > 0 when vt.isZero then {
        st.define nameId: cond.name ztypeId: ztypes.tid
    }
}

# forComprehensionTid -- the type a `for` used as an expression produces: a
# List of the body's value type, and 0 when the body produces no value.
forComprehensionTid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    fornode: forref
    elemT: ztypes.tid
} out ztypes.tid is {
    # for-as-expression: a value-producing body makes the loop a List of
    # that element type (the comprehension form).
    if elemT.notZero then {
        isNull: (
            (conform.isNullTid reg: st.reg tid: elemT) or
            ((st.reg.nameViewOf tid: elemT).length == 0)
        )
        if isNull.not then {
            # the comprehension's element decides the family, exactly as a
            # written-out container declaration would: the system's own ListRef
            # or ListVal, by its well-known slot, so a user type spelled like
            # one does not capture the loop
            ltWk: zast.wellKnown.slot.tyListRef
            if (st.reg.isValtypeOf tid: elemT) then ltWk = zast.wellKnown.slot.tyListVal
            lto: stdtypes.stdTidOpt :ast :st wk: ltWk
            if lto.some then {
                lsubs: IdMapV zast.nameid v: ztypes.tid
                lv: elemT
                # `lto` is whichever of ListRef / ListVal the element's family
                # selected above; each names its own element parameter.
                lsubs.set key: (firstGenericParamId :st templateId: lto) value: lv
                lsfx: "_\{st.reg.nameViewOf tid: elemT}"
                vsG: IdMapV zast.nameid v: u64
                lmid: (
                    getOrMintSpec
                    :st
                    scope: st.curScope
                    :ast
                    :unitDecl
                    sfx: lsfx.stringView
                    templateId: lto
                    subs: lsubs
                    valSubs: vsG
                    fallbackArg: ztypes.tid.zero
                )
                if lmid.notZero then {
                    setf: lmid
                    stampGate :st nid: fornode.nid tid: setf
                    return lmid
                }
            }
        }
    }
    return ztypes.tid.zero
}

# checkForPostcondition -- type one `for loop { … } while <cond>` trailing
# condition. It carries the same bool rule as the header conditions: a
# non-bool value is a type error, not the invalid C a struct in a `while`
# head would emit.
checkForPostcondition: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    pcId: zast.nodeid
} is {
    pcOp: pcId
    pc: argRefAt :ast nid: pcOp
    if pc.nid.notZero then pcOp = pc.operation
    errP: st.typing.errors.length
    pcVt: checkValueAt :st :unitDecl :ast nid: pcOp
    if pcVt.isZero when st.typing.errors.length == errP then {
        reportUnresolvedValue :st :unitDecl :ast nid: pcOp
        refuseUntypedValue :st :ast nid: pcOp
    }
    # A `for loop { ... } while <cond>` post-condition must be boolean, the
    # same rule the pre-condition carries above: a non-bool value is a type
    # error rather than the invalid C a struct in a `while` head emits.
    pbId: stdtypes.stdTidRo :ast :st wk: zast.wellKnown.slot.wkBool
    if pbId.notZero when pcVt.notZero when pcVt != pbId then {
        pTt: st.reg.typetypeOf typeId: pcVt
        pPair: ztyping.isSumPair ty: st.typing reg: st.reg tid: pcVt
        if pPair then stampTruthyCond :st n: (ast.nodes.get i: pcOp) tid: pcVt
        if pTt != ztypes.ztypetype.neverType when pPair.not then {
            pctn: specWrittenName :st :ast tid: pcVt
            pcmsg: "loop postcondition must be bool or a 2-arm sum type, got '\{pctn}'"
            (
                addError
                :st
                nodeid: pcOp
                lineno: (nodeLine n: (ast.nodes.get i: pcOp))
                colno: (nodeCol n: (ast.nodes.get i: pcOp))
                e: zast.err.typeError
                msg: pcmsg
            )
        }
    }
}


# relayContinueTakes -- in a loop that tests postconditions, a `continue` lands
# on their test, inside the iteration's scope, where the path that fell out of
# the body arrives too. So a local of that scope -- the element the binding
# holds -- that either path moved is moved on some of the paths that reach the
# test, and the iteration's end: what a `continue` path had moved is laid
# here, and every take since the body began (`bodyMark`) is one of some paths.
# Asked with the body's scope closed and the iteration's still open.
relayContinueTakes: function {st: zenv.ZSymbolTable bodyMark: u64} is {
    if st.loopContinued.not then return
    i: st.continueTakesStart
    for i < st.loopContinueTakes.length loop {
        d: st.loopContinueTakes.get :i
        i = i + 1
        if (st.innermostOpenIs scope: (st.typing.declParentOf declId: d)) then (
            st.invalidateDeclAs
            declId: d
            loc: moves.takenHere
            maybe: true
        )
    }
    st.markTakesMaybeFrom from: bodyMark
}

# checkForPostconditions -- walk a loop's postconditions. A POSTCONDITION RUNS
# AFTER THE BODY, so the walk reaches it after the body: walked before, a lock it
# released was released for the body's first iteration too, which runs first. A
# `continue` reaches it too (relayContinueTakes).
checkForPostconditions: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    fornode: forref
    end: ztyping.loopend
    # where the body's rows began
    bodyMark: u64
} is {
    if fornode.nposts > 0 then relayContinueTakes :st :bodyMark
    kP: u64
    for kP < fornode.nposts loop {
        pcId: zast.forPostAt :ast nid: fornode.nid i: kP
        kP = kP + 1
        checkForPostcondition :st :unitDecl :ast :pcId
        # a false one ends the loop, and the ones after it never run
        if end == ztyping.loopend.once when (
            (
                foldLoopPost
                :st
                scope: st.curScope
                :ast
                :unitDecl
                :pcId
            ) ==
            2
        ) then return
    }
}


# armvalue -- one arm of a value-producing `if` or `match`: the node its value
# is, the type it yields, and whether that value is an untyped literal, which
# the other arms' type governs.
armvalue: record {
    # the value's node, 0 when the arm yields none or diverges
    nid: zast.nodeid
    # the type the arm yields
    tid: ztypes.tid
    # whether the value is an untyped literal constant
    untyped: bool
}

# controlArmBlocks -- the bodies of an `if`'s clauses and else, or a `match`'s
# arms and else, in order; a block's or a `with`'s one body.
controlArmBlocks: function {ast: Ast.view nid: zast.nodeid into: ListVal zast.nodeid} is {
    n: ast.nodes.get i: nid
    body: zast.nodeid
    if n.doexpr then body = (doRefAt :ast :nid).statement
    if n.withexpr then body = (withRefAt :ast :nid).body
    if n.doexpr or n.withexpr then {
        if body.notZero then into.append from: body
        return
    }
    flow.branchArmBlocks :ast :nid :into
}


# memberIsSelfTyped -- a member of `ifaceTid` with a parameter of the
# INTERFACE'S OWN type, the receiver excluded. `type` inside an interface means
# the interface, so `near: function {:this rhs: type}` asks for a
# implementer-to-implementer call -- and a vtable cannot type one, because the slot
# would have to name a single implementation's argument and there may be many.
# The emitter omits the slot and the wrapper for such a member; this is the
# same question, asked where a call to it can still be refused with something
# better than a C compiler's opinion.
memberIsSelfTyped: function {
    st: zenv.ZSymbolTable.view
    ifaceTid: ztypes.tid
    memberTid: ztypes.tid
} out bool is {
    found: false
    ppi: u64
    ppn: st.typing.declRowSlots ownerTid: memberTid
    for ppi < ppn loop {
        prow: st.typing.declRowAt ownerTid: memberTid membersOnly: false slot: ppi
        ppi = ppi + 1
        if prow.keep then {
            pnid: prow.name
            isRecv: (
                (pnid == zast.wellKnown.slot.wkThis) or
                (st.reg.thisParamNameIs tid: memberTid nameId: pnid)
            )
            if isRecv.not then {
                pto: st.typing.declChildOfId parentTypeId: memberTid nameId: pnid
                if pto.some when pto == ifaceTid then found = true
            }
        }
    }
    return found
}

# refuseSelfTypedMember -- report and answer true when `nameId` names a member
# of an interface-typed receiver that cannot be dispatched. checkDotted asks
# it, and an operator reaches it the same way: the infix spelling IS a dotted
# call, so one refusal serves both.
refuseSelfTypedMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    recvTid: ztypes.tid
    nameId: zast.nameid
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} out bool is {
    btt: st.reg.typetypeOf typeId: recvTid
    isIface: btt.isInterface
    if isIface.not then return false
    mo: st.typing.declChildOfId parentTypeId: recvTid :nameId
    if mo.some then {
        mtid: mo
        if (memberIsSelfTyped :st ifaceTid: recvTid memberTid: mtid) then {
            iname: st.reg.nameOf tid: recvTid
            # the member's own spelling, read only HERE: this is the one path
            # that renders it, and every call in the program reaches the test
            mtxt: zast.nameTextAt :ast ref: nameId
            (
                reportSelfTypedDispatch
                :st
                ifaceName: iname.stringView
                memberName: mtxt.stringView
                :nodeid
                :lineno
                :colno
            )
            return true
        }
    }
    return false
}

# reportSelfTypedDispatch -- the refusal, said once and in the interface's own
# terms. E0300 because it is a call that cannot be made, not a type that does
# not exist: the member is declared, the implementer implements it, and what is
# missing is any single signature a vtable slot could carry.
reportSelfTypedDispatch: function {
    st: zenv.ZSymbolTable
    ifaceName: StringView
    memberName: StringView
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    ms: "'\{memberName}' takes a parameter of type '\{ifaceName}' itself, so it cannot be called through the interface"
    addError :st :nodeid :lineno :colno e: zast.err.callError msg: ms
}

# markVarRebound -- record that a reassignment or a swap rebinds the variable
# `nameId` names.
markVarRebound: function {st: zenv.ZSymbolTable nameId: zast.nameid} is {
    vo: st.lookupVarId :nameId
    if vo.none then return
    st.typing.variableRebound.add item: vo
}

# varNameText -- the name of the open local bound to `vid`, "" when none is.
varNameText: function {st: zenv.ZSymbolTable.view ast: Ast.view vid: ztypes.vid} out String is {
    nm: st.localNameOfVar :vid
    if nm.isZero then return "".string
    return (zast.nameTextCopy :ast ref: nm)
}

# refuseLockHolder -- whether `to` may not hold the locks `held` names, which
# a value moving into it carries: reported, and true, when it may not. A
# parameter cannot hold them (they would be handed to the caller unseen); a
# reference cannot (it owns nothing: the value lands in what it refers to,
# whose owner may outlive the source, while the reference -- and a lock moved
# onto it -- ends with its own scope); and every source that is a local must be
# bound in a scope enclosing `to`'s. A source that is a borrow/view parameter
# or the receiver imposes nothing. `fromNm` names the moving value, empty when
# it is not a name (a construction).
refuseLockHolder: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    held: (List ztyping.PinPath).view
    fromNm: StringView
    # the moving value's type, which says what would hold no lock
    movedT: ztypes.tid
    to: ztypes.vid
    verb: StringView
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} out bool is {
    what: "the value".string
    if fromNm.length > 0 then what = "'\{fromNm}'"
    rem: moves.lockFreeRemedy :st :ast tid: movedT
    toNm: varNameText :st :ast vid: to
    firstRoot: moves.lockRootPhrase :st :ast nameId: (pinRootAt pins: held i: 0)
    if (st.reg.variableOriginOf id: to) == ztypes.zvarorigin.param then {
        mp: "Cannot move \{what} \{verb}: it holds a lock on \{firstRoot}, and '\{toNm}' is a parameter, so the value would reach the caller without that lock\{rem}"
        addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: mp
        return true
    }
    if (moves.isBorrowedVar :st vid: to) then {
        mr: "Cannot move \{what} \{verb}: it holds a lock on \{firstRoot}, and '\{toNm}' is a reference, so the value would land in storage it does not own, and the lock would end with it\{rem}"
        hr: String
        ow: st.reg.variableBorrowOriginOf id: to
        if ow.notZero then {
            own: zast.nameTextAt :ast ref: ow
            hr = "'\{toNm}' refers into '\{own}', which owns the storage the value would land in"
        }
        (
            reportLockHolder
            :st
            :nodeid
            :lineno
            :colno
            msg: mr.stringView
            hint: hr.stringView
            width: fromNm.length
        )
        return true
    }
    outlived: outlivedSource :st :held :to
    if outlived.isZero then return false
    rn: zast.nameTextAt :ast ref: outlived
    mo: "Cannot move \{what} \{verb}: it holds a lock on '\{rn}', and '\{toNm}' outlives '\{rn}'"
    mo.append s: rem
    ho: "keep '\{toNm}' inside '\{rn}'s scope"
    if fromNm.length > 0 then ho = "\{ho}, or end '\{fromNm}' before '\{rn}' does"
    (
        reportLockHolder
        :st
        :nodeid
        :lineno
        :colno
        msg: mo.stringView
        hint: ho.stringView
        width: fromNm.length
    )
    return true
}

# outlivedSource -- the first local `held` locks that `to` would outlive: one
# bound in a scope that does not enclose `to`'s. A parameter source imposes
# nothing. Zero when there is none.
outlivedSource: function {
    st: zenv.ZSymbolTable
    held: (List ztyping.PinPath).view
    to: ztypes.vid
} out zast.nameid is {
    toScope: st.scopeOfVar vid: to
    for each hp: held loop {
        rootNm: hp.path.get i: 0
        rvo: st.lookupVarId nameId: rootNm
        if rvo.some then {
            isParam: (st.reg.variableOriginOf id: rvo) == ztypes.zvarorigin.param
            if isParam.not when (
                st.scopeEncloses
                outer: (st.scopeOfVar vid: rvo)
                inner: toScope
            ).not then return rootNm
        }
    }
    return zast.nameid
}

# reportLockHolder -- refuseLockHolder's report, underlining the moving value
# (`width` 0 when it has no name)
reportLockHolder: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    msg: StringView
    hint: StringView
    width: u64
} is {
    no: String
    (
        addErrorWithHint
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.ownerError
        msg: msg.string
        note: no
        hint: hint.string
        :width
    )
}

# pinRootAt -- the root of pin `i` of a local pin list.
pinRootAt: function {pins: (List ztyping.PinPath).view i: u64} out zast.nameid is {
    if i >= pins.length then return zast.nameid
    p: pins.get :i
    return (p.path.get i: 0)
}

# pinsAllShared -- every pin is SHARED, so a value derived from them may only
# be read.
pinsAllShared: function {pins: (List ztyping.PinPath).view} out bool is {
    for each p: pins loop {
        if p.shared.not then return false
    }
    return true
}

# installPins -- install every pin under the binding `vid`, each at its own
# strength. `onlyRoot` (when set) keeps the pins rooted at that name -- the
# argument a hoisted temp stands for -- and `forceShared` makes every leaf
# SHARED: the bound value is a view-family type, which is a read of its
# parent whatever the call declared, or the temp of a `.view` parameter.
installPins: function {
    # the symbol table the lock rows are laid in
    st: zenv.ZSymbolTable
    # the name pool the paths are spelt in
    pool: zast.StringPool.view
    # the pins to install, each with its own path and strength
    pins: (List ztyping.PinPath).view
    # the binding that holds them
    vid: ztypes.vid
    # when set, only the pins rooted at this name are installed
    onlyRoot: zast.nameid
    # every leaf SHARED, whatever the pin says
    forceShared: bool
    # the node a conflict is reported at
    nodeid: zast.nodeid
    # the line a conflict is reported at
    lineno: u32
    # the column a conflict is reported at
    colno: u32
} is {
    for each p: pins loop {
        keep: true
        if onlyRoot.notZero when (p.path.get i: 0) != onlyRoot then keep = false
        if keep then {
            ls: p.shared
            lm: p.mutable
            if forceShared then {
                ls = true
                lm = false
            }
            (
                installBorrowLocks
                :st
                :pool
                src: p.path
                :vid
                leafShared: ls
                mutable: lm
                :nodeid
                :lineno
                :colno
            )
        }
    }
}

# namesTypeApplication -- the call at `nid` applies a type to type arguments
# alone (`(Option T: PC)`, `(ListVal i64)`, `(pr.Getter v: i64)`): it names the
# instance and computes no value. Its head names a type -- a bare name or a path
# through a unit -- and every argument names a type or is such an application
# itself. A value among the arguments (`(Rd a)` a projection, `(Rd.create from:
# c)` a create through the type's path) makes it a value.
namesTypeApplication: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out bool is {
    headId: zast.nodeid
    bn: ast.nodes.get i: nid
    if bn.call then headId = bn.callable
    if headId.isZero then return false
    if (nodeNamesType :st :ast :unitDecl nid: headId).not then return false
    call: callRefAt :ast :nid
    k: u64
    for k < call.nargs loop {
        arg: argRefAt :ast nid: (zast.callArgAt :ast :nid i: k)
        k = k + 1
        if arg.nid.isZero then return false
        isCall: (ast.nodes.get i: arg.operation).call
        if isCall then {
            if (namesTypeApplication :st :ast :unitDecl nid: arg.operation).not then return false
        } else if (nodeNamesType :st :ast :unitDecl nid: arg.operation).not then return false
    }
    return true
}

# releaseCascade -- `holder` releases its locks, and so does every temporary a
# line kept (heldTemps) that nothing locks any more: a temporary lives no longer
# than the holds on it, and its own locks go with it, in turn freeing the
# temporaries only it held.
releaseCascade: function {st: zenv.ZSymbolTable holder: ztypes.zlockholder} is {
    st.releaseHeldLocks :holder
    st.releaseUnheldTemps
}

# installBorrowLocks -- SHARED on every path prefix, the pin's own strength on
# the leaf (the symtab appends one lock overlay entry per acquisition, keyed
# by the path root). Holder = the binding var.
installBorrowLocks: function {
    st: zenv.ZSymbolTable
    pool: zast.StringPool.view
    src: (ListVal zast.nameid).view
    vid: ztypes.vid
    leafShared: bool
    # the binding may write through its reference
    mutable: bool
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} is {
    n: src.length
    if n == 0 then return
    # a reference that may write is a mutable use of the path's ROOT. This is
    # the other enforcement point beside lockCallArg: a PATH-shaped argument
    # (`pool: program.names`) never reaches lockCallArg, it installs here.
    if mutable then moves.markVarMutated :st nameId: (src.get i: 0)
    end: 1.u64
    for end < n loop {
        hs: ztypes.zlockholder.var vid
        rs: (
            st.tryLock
            :pool
            path: (src.slice from: 0 to: end)
            lockType: ztypes.zlockstate.shared
            lockScope: ztypes.zlockscope.intent
            holder: hs
            mutable: false
        )
        if rs.length > 0 then addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: rs
        end = end + 1
    }
    he: ztypes.zlockholder.var vid
    lk: ztypes.zlockstate.exclusive
    if leafShared when mutable.not then lk = ztypes.zlockstate.shared
    re: (
        st.tryLock
        :pool
        path: src.listView
        lockType: lk
        lockScope: ztypes.zlockscope.target
        holder: he
        :mutable
    )
    if re.length > 0 then addError :st :nodeid :lineno :colno e: zast.err.ownerError msg: re
}

# readonlySelfLock -- make `name` a readonly binding: it holds a shared lock on
# ITSELF, which is how a `view` parameter, a `hold` local, a marked match-arm
# payload and an `out T.view` result all say the same thing. Returns the
# conflict message, or "" when the lock was taken.
readonlySelfLock: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    name: StringView
    vid: ztypes.vid
} out String is {
    if name.length == 0 then return "".string
    if vid.isZero then return "".string
    rsp: ListVal zast.nameid
    rsp.append (nameIdOf :ast :name)
    rsh: ztypes.zlockholder.var vid
    return (
        st.tryLock
        pool: ast.names
        path: rsp.listView
        lockType: ztypes.zlockstate.shared
        lockScope: ztypes.zlockscope.target
        holder: rsh
        mutable: false
    )
}

# forElementIteratorName -- the iterator binding a `for` element came from: the
# header's value names it (`for each e: it`), or calls it (the plain binding
# `for e: it.call`). The element's lock and its readonly-ness are the ones that
# iterator holds. Zero when the value names no iterator binding.
forElementIteratorName: function {ast: Ast.view nid: zast.nodeid} out zast.nameid is {
    n: ast.nodes.get i: nid
    match (
        n
    ) case atomid then {
        return n.name
    } case dottedpath then {
        leaf: atomNameId :ast n: (ast.nodes.get i: n.child)
        if leaf != zast.wellKnown.slot.wkCall then return zast.nameid
        return (atomNameId :ast n: (ast.nodes.get i: n.parent))
    } else {
        return zast.nameid
    }
}

# lockIteratorForElement -- the loop element takes a lock on the ITERATOR it
# came from. Returns the conflict message, or "" when the lock was taken.
#
# A `with`-bound iterator holds the lock on the container; the element holds
# nothing, so its validity rests on a lock another binding owns and anything
# that ends that lock early -- reassigning the iterator -- leaves the element
# pointing into storage nothing holds. Confirmed heap-use-after-free.
#
# The element locks the ITERATOR rather than the container, which is the chain
# as it actually runs: `e` holds `it`, `it` holds `xs`. Copying the container
# lock onto the element instead makes two bindings claim one path, and an
# `iterateItems` / `iterateMut` walk holds that path exclusively. This is also
# the lock an explicit `p: it.call` already takes -- the `for` payload is the
# same reference and earns the same row.
lockIteratorForElement: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    iterName: zast.nameid
    vid: ztypes.vid
} out String is {
    if iterName.isZero then return "".string
    if vid.isZero then return "".string
    if (st.lookupVarId nameId: iterName).none then return "".string
    lip: ListVal zast.nameid
    lip.append iterName
    lih: ztypes.zlockholder.var vid
    return (
        st.tryLock
        pool: ast.names
        path: lip.listView
        lockType: ztypes.zlockstate.exclusive
        lockScope: ztypes.zlockscope.target
        holder: lih
        mutable: false
    )
}

# iterElementIsReadonly -- ask an iterator BINDING what strength of lock it
# holds on the container it walks. A `view` iterator receiver pins SHARED, so
# the elements it hands out may only be read; an exclusive pin yields writable
# ones. Unlike pathIsReadonly this is not a self-lock question -- the holder is
# the iterator and the locked path is the container it recorded as its borrow
# origin.
iterElementIsReadonly: function {
    st: zenv.ZSymbolTable.view
    iterName: zast.nameid
} out bool is {
    if iterName.isZero then return false
    ivo: st.lookupVarId nameId: iterName
    if ivo.none then return false
    cnd: st.reg.variableBorrowOriginOf id: ivo
    if cnd.isZero then return false
    clk: st.findLock nameId: cnd
    if clk.none then return false
    if clk != ztypes.zlockstate.shared then return false
    clh: st.findLockHolder nameId: cnd
    if clh.none then return false
    return clh == (ztypes.zlockholder.var ivo)
}

# isOperatorName -- an operator is spelled in PUNCTUATION, so the name itself
# says which members these are. A word-named member is never one, whatever it
# does: `bool.or` is an operator by its native row, not by its spelling.
isOperatorName: function {name: StringView} out bool is {
    b0: name.byteAt 0.u64
    if b0.some then {
        return ((ascii.isLower b: b0) or (ascii.isUpper b: b0) or (b0 == 0c_)).not
    }
    return false
}

# isLiteralTypeId -- a literal-typed value: one of the registry's reserved
# literal rows. Bare numeric literals and list elements wear them.
isLiteralTypeId: function {reg: ztypes.ZTypeRegistry.view tid: ztypes.tid} out bool is {
    if tid == reg.literalIntTid then return true
    return tid == reg.literalFloatTid
}

# isAnyLiteralTid -- a literal's pseudo-type, numeric or textliteral: a value
# that takes the type of the place it lands in.
isAnyLiteralTid: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    return (isLiteralTypeId reg: st.reg :tid) or (numerics.isTextLiteralTid :st :tid)
}

# isSumTid -- the type is a union or a variant.
isSumTid: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    tt: st.reg.typetypeOf typeId: tid
    return (tt == ztypes.ztypetype.unionType) or (tt == ztypes.ztypetype.variantType)
}

# isCompileTimeSum -- a union or variant one of whose arms is a literal type
# (`anyint`'s `:intliteral`). Like that arm it has no run-time form: it bounds
# a parameter, and no value of it is made.
isCompileTimeSum: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    if (isSumTid :st :tid).not then return false
    n: st.typing.declRowSlots ownerTid: tid
    i: u64
    for i < n loop {
        row: st.typing.declRowAt ownerTid: tid membersOnly: true slot: i
        i = i + 1
        if row.keep when (isAnyLiteralTid :st tid: row.tid) then return true
    }
    return false
}

# refuseCompileTimeSumValue -- the value at `nid`, of type `t`, MAKES a value of
# a compile-time sum: an arm's construction, or the type's name read as a
# value. That is the one use such a sum has no answer for. Naming it, or
# bounding a parameter with it, is not refused.
refuseCompileTimeSumValue: function {
    st: zenv.ZSymbolTable ast: Ast.view nid: zast.nodeid t: ztypes.tid
} is {
    if (isSumTid :st tid: t).not then return
    made: st.typing.implicitCreate.has key: nid
    ck: st.typing.callKind.get key: nid
    if ck.some when ck == zast.callkind.unionCreate then made = true
    if made.not then return
    if (isCompileTimeSum :st tid: t).not then return
    tn: specWrittenName :st :ast tid: t
    pos: zast.posOf n: (ast.nodes.get i: nid)
    (
        addErrorWithHint
        :st
        nodeid: nid
        lineno: pos.line
        colno: pos.col
        e: zast.err.typeError
        msg: "'\{tn}' has an arm of a compile-time type, so no value of it can be made"
        note: "a literal type has no run-time form, and neither has a sum with one as an arm".string
        hint: "use '\{tn}' as a bound (`\{tn}.generic`), or make a value of a type without a literal arm"
        width: 1
    )
}

# literalDefaultName -- the type a literal pseudo-type takes where nothing gives
# it one: i64 for an integer, f64 for a float, and StringView for a string
# outside a static position. "" for any other type.
literalDefaultName: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out StringView is {
    if tid == st.reg.literalIntTid then return "i64"
    if tid == st.reg.literalFloatTid then return "f64"
    if tid == st.reg.literalTextTid then return "StringView"
    return ""
}

# literalTidOfLexeme -- the pseudo-type a numeric literal wears: a float's, or
# an integer's, whatever its base.
literalTidOfLexeme: function {st: zenv.ZSymbolTable.view lex: StringView} out ztypes.tid is {
    if (ztypes.isFloatLexeme numstr: lex) then return st.reg.literalFloatTid
    return st.reg.literalIntTid
}


# fieldRefusedWhereWritten -- `label` is a FIELD of `owner` whose type-ref was
# refused where it is written (memberTyperefRefused): still the type's field
fieldRefusedWhereWritten: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    owner: ztypes.tid
    label: zast.nameid
} out bool is {
    if owner.isZero then return false
    md: declMemberOf :st ownerTid: owner nameId: label
    if md.isZero then return false
    ownerD: templateDeclOf reg: st.reg typing: st.typing tid: owner
    if (asMemberIsAsItem :st :ast tdecl: ownerD :md) then return false
    return (memberTyperefRefused :st :ast bt: owner nameId: label)
}

# specWrittenName -- a spec as a program writes it: a function type no program
# names, its signature written out (signatureText); any other, its name or the
# application that names it (declWrittenName).
specWrittenName: function {st: zenv.ZSymbolTable.view ast: Ast.view tid: ztypes.tid} out String is {
    if (moves.spelledAsSignature :st :tid) then return (moves.signatureText :st :ast :tid)
    return (moves.declWrittenName :st :ast :tid)
}

# literalLandingTid -- the type a literal receiver of type `rt` lands in for
# native `method` (landLiteralReceiver): a string literal its StringView,
# whatever the method's own parameters bind; a number the type the operator's
# one generic parameter is bound to (`instance`), or for a method that is not
# generic its default -- except a conversion, or a method returning a literal,
# which land nowhere. 0 when it lands nowhere.
literalLandingTid: function {
    st: zenv.ZSymbolTable ast: Ast rt: ztypes.tid method: ztypes.tid instance: ztypes.tid
} out ztypes.tid is {
    if (numerics.isTextLiteralTid :st tid: rt) then return (materialiseLiteral :ast :st t: rt)
    if (isLiteralTypeId reg: st.reg tid: rt).not then return ztypes.tid.zero
    if instance.notZero then {
        if (st.reg.genericArgCount specId: instance) != 1 then return ztypes.tid.zero
        return (st.reg.genericTypeArgAt specId: instance ordinal: 0)
    }
    ret: conform.methodReturnOf reg: st.reg typing: st.typing mid: method
    if ret.some when (isAnyLiteralTid :st tid: ret) then return ztypes.tid.zero
    nm: (st.typing.decls.get i: (st.typing.declIdOfType typeId: method)).name
    if (declare.scalarKindOfNameId id: nm).has then return ztypes.tid.zero
    return (materialiseLiteral :ast :st t: rt)
}


# what one call argument's parameter asks of it -- taken, locked, viewed,
# held -- resolved once and read by everything downstream
argownership: record {
    # the parameter takes ownership, so the caller's binding is spent
    isTake: bool
    # the parameter locks its argument for the call
    isLockish: bool
    # the parameter is `.view`, so the argument stays readable across the call
    isViewArg: bool
    # the parameter is `.hold`: passed by pointer and never freed by the callee
    isHold: bool
    # the parameter's type, which the argument is coerced to
    pt: ztypes.tid
}

# reportBoxUnknownArgument -- the builtin Box constructs with `from:`; any
# other label is reported, and the argument is still taken as the value so the
# rest of the check has something to work with.
reportBoxUnknownArgument: function {
    st: zenv.ZSymbolTable
    ast: Ast
    arg: argref
} is {
    if arg.name == zast.wellKnown.slot.wkFrom then return
    an: zast.nameTextCopy :ast ref: arg.name
    msg: "the builtin Box constructs with 'from:'; unknown argument '\{an}'"
    (
        addError
        :st
        nodeid: (zast.nodeIdOf n: (ast.nodes.get i: arg.operation))
        lineno: (nodeLine n: (ast.nodes.get i: arg.operation))
        colno: (nodeCol n: (ast.nodes.get i: arg.operation))
        e: zast.err.callError
        :msg
    )
}

# boxArgumentTid -- the type a `Box` construction is given: an explicit `t:` type
# argument, or the type of the single value it boxes. 0 when neither is present.
boxArgumentTid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    tplId: ztypes.tid
} out ztypes.tid is {
    # Box names its own type parameter; asking the template for it keeps this
    # site correct across a rename. An id compare has two zeros -- a template
    # that declared none, and an unlabelled argument -- so the compare is
    # guarded rather than trusted.
    boxParam: firstGenericParamId :st templateId: tplId
    fnd: false
    vt: ztypes.tid
    kAiter: u64
    for kAiter < call.nargs loop {
        argId: zast.callArgAt :ast nid: call.nid i: kAiter
        kAiter = kAiter + 1
        arg: argRefAt :ast nid: argId
        if arg.nid.isZero then continue
        if fnd then continue
        if boxParam.notZero when arg.name == boxParam then continue
        reportBoxUnknownArgument :st :ast :arg
        fnd = true
        avt: callchecks.checkOwnedValueAt :st :unitDecl :ast nid: arg.operation
        vt = materialiseLiteral :ast :st t: avt
        if vt.isZero then continue
        moves.bindBoxedArgument :st :ast :arg argT: vt
    }
    return vt
}

# checkBoxConstruction -- `Box from: val`: the value's (materialised) type
# binds t; the argument is consumed (hoisted first when non-trivial); the
# instance carries create plus the element type's children copied for
# transparent member access. Heap passthrough (List/Map boxing) lands when
# an example needs it.
checkBoxConstruction: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    tplId: ztypes.tid
} out ztypes.tid is {
    vt: boxArgumentTid :st :unitDecl :ast :call :tplId
    if vt.isZero then return ztypes.tid.zero
    tn: st.reg.nameOf tid: vt
    mname: "_\{tn}"
    subs: IdMapV zast.nameid v: ztypes.tid
    sv: vt
    subs.set key: (firstGenericParamId :st templateId: tplId) value: sv
    vsJ: IdMapV zast.nameid v: u64
    mid: (
        getOrMintSpec
        :st
        scope: st.curScope
        :ast
        :unitDecl
        sfx: mname.stringView
        templateId: tplId
        :subs
        valSubs: vsJ
        fallbackArg: ztypes.tid.zero
    )
    if mid.isZero then return ztypes.tid.zero
    st.reg.setIsBox typeId: mid
    st.reg.setIsHeapAllocated typeId: mid
    st.reg.setNeedsDestructor typeId: mid
    if (st.typing.declMemberCount ownerTid: mid) <= 0 then {
        crId: st.reg.newType name: "create" ownerTid: mid typetype: ztypes.ztypetype.functionType
        (
            st.typing.declSynthMemberTyped
            parentTypeId: mid
            nameId: zast.wellKnown.slot.wkCreate
            kind: ztyping.declkind.methodDecl
            childTypeId: crId
        )
        # Stage the element's members first: setMemberType appends to the very
        # declaration being iterated.
        bi: u64
        bn2: st.typing.declRowSlots ownerTid: vt
        for bi < bn2 loop {
            row: st.typing.declRowAt ownerTid: vt membersOnly: true slot: bi
            bi = bi + 1
            if row.keep then {
                chi: row.tid
                chnId: row.name
                forceMemberOf :st :ast parentTypeId: mid nameId: chnId
                ext: st.typing.declChildOfId parentTypeId: mid nameId: chnId
                match (
                    ext
                ) case some then null case none then {
                    # declare before edging, so setMemberType stamps the copied
                    # member's type onto its declaration instead of leaving the
                    # sweep below to mint it and read the type back off the edge
                    kk: ztyping.declkind.fieldDecl
                    if (st.reg.typetypeOf typeId: chi) == ztypes.ztypetype.functionType then {
                        kk = ztyping.declkind.methodDecl
                    }
                    # NOT the atomic pair: a box child is declared by the sweep
                    # above and RE-TYPED here as its element type settles
                    st.typing.declSynthMember parentTypeId: mid nameId: chnId kind: kk
                    st.typing.setMemberType parentTypeId: mid nameId: chnId childTypeId: chi
                }
            }
        }
    }
    bcal: nodeId n: (ast.nodes.get i: call.callable)
    if bcal.notZero then {
        setbt: tplId
        stampGate :st nid: bcal tid: setbt
    }
    setbc: mid
    stampGate :st nid: call.nid tid: setbc
    st.typing.callKind.set key: call.nid value: zast.callkind.boxCreate
    return mid
}

# callableDottedResultAt -- a dotted callable resolves through the dotted-path
# walk (no auto-call coercion -- callable position wants the function itself);
# the base is typed and stamped there. none = the callable is not a dotted
# path; some 0 = dotted but unresolved (e.g. a list's `.get`), which
# leaves the call untyped with its arguments unwalked.
callableDottedResultAt: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    nid: zast.nodeid
} out optionval ztypes.tid is {
    arm: declare.rowArmAt :ast :nid
    match (
        arm
    ) case dottedpath then {
        dr: dpRefAt :ast :nid
        # `Type.arm` is one path whether an argument follows or not, so the
        # arm read is told it is a CALLABLE here -- the only place that knows
        cdPrev: st.walk.calleeDottedNid
        st.walk.calleeDottedNid = dr.nid
        r: checkDotted :st :unitDecl :ast dp: dr coerce: false
        st.walk.calleeDottedNid = cdPrev
        return (optionval.some r)
    } else {
        return (optionval.none ztypes.tid)
    }
}

# unresolvedBareName -- prove a bare name resolves NOWHERE in value
# position: not a local, not a unit member, not a typeref, not a system
# child. The name when unresolvable; "" when anything claims it.
unresolvedBareName: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    # the bare name, interned
    nameId: zast.nameid
} out String is {
    if nameId.isZero then return "".string
    # A NUMERIC LITERAL IS NOT A NAME and can never resolve to one, so it is
    # never the unresolvable name a report should print. It reaches here from
    # an operand walk: `k bump 5` on a member that returns nothing types to
    # nothing correctly, and naming `5` as an unknown reference reported the
    # statement as broken when what it did was return no value.
    if (isNumericLiteralNameAt :ast ref: nameId) then return "".string
    # `meta` is the enclosing type's raw allocator base (meta.create):
    # contextual, never a unit-resolvable name
    if nameId == zast.wellKnown.slot.wkMeta then return "".string
    # `type` in a type's members names that type; a path through it a template
    # walk leaves untyped is the instance walk's to check
    if (bodySelfTypeNameId :st :nameId) != nameId then return "".string
    ubv: st.lookupVarId :nameId
    if ubv.some then {
        return "".string
    }
    # lookupVarId reads two in-scope names as absent: a binding that minted no
    # varId (a `meta.create` result) and a MOVED one (both `lookup` and
    # `lookupVarId` refuse a taken local). A declared name is in scope however
    # it was consumed, so the local's declaration itself is the authority.
    if (st.isLocalName :nameId) then return "".string
    if (resolve.nameClaimedByScopeId :st scope: st.curScope :ast :unitDecl :nameId
    ) then return "".string
    # a VALUE a scope on the way out declares -- a namespace's, a hidden
    # subunit's -- is claimed as the unit's own is: a failed declaration is
    # reported once, at the declaration, not again as an unknown reference at
    # each use. A subunit's constant beyond i64 read both ways.
    # A type's fields and methods are no names in its methods' scope -- they
    # are reached through `this`, a value or the type -- so a type on the way
    # out claims only its constants and parameters, as resolution does.
    if (nameDeclaredOutward :st from: st.curScope :nameId) then return "".string
    ubw: walkLookupTyperefById :st scope: st.curScope :ast :unitDecl baseId: nameId
    if ubw.some then {
        return "".string
    }
    return (zast.nameTextCopy :ast ref: nameId)
}

# nameDeclaredOutward -- a scope from `from` out to the program root declares
# `nameId` as a name its body reads bare: a definition, a constant, a generic
# parameter. A type's fields and methods are no such names -- they are reached
# through `this`, a value or the type.
nameDeclaredOutward: function {
    st: zenv.ZSymbolTable.view
    from: ztypes.declid
    nameId: zast.nameid
} out bool is {
    cur: from
    for cur.notZero and (cur != st.typing.programRoot) loop {
        fc: st.typing.declFindChild parentDeclId: cur :nameId
        if fc.notZero when (declIsTypeMember :st declId: fc).not then return true
        cur = st.typing.declParentOf declId: cur
    }
    return false
}

# declIsTypeMember -- a field or method of a type: reached through a value or the
# type, never by its bare name
declIsTypeMember: function {st: zenv.ZSymbolTable.view declId: ztypes.declid} out bool is {
    k: (st.typing.decls.get i: declId).kind
    return k.fieldDecl or k.methodDecl
}

# unresolvedBareCallable -- the bare-atom callable name of a call-shaped
# value that resolves to NOTHING (no local, no own-unit function, no system
# name, no walkable type): the checker's silent args-walked fallthrough
# otherwise leaves the binding untyped and the emitter prints a marker.
unresolvedBareCallable: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out String is {
    # the row is read through a view scoped to this block: the name probe below
    # lends ast exclusively. An operator's call is told apart from any other.
    kind: zast.nodekind.placeholder
    isOperator: false
    callableId: zast.nodeid
    lhsId: zast.nodeid
    rhsId: zast.nodeid
    parentId: zast.nodeid
    nameId: zast.nameid
    {
        n: ast.nodes.get i: nid
        kind = zast.kindOf :n
        # an INFIX call hides the unresolvable name in EITHER operand
        # (`1 + ghost`), and the callable alone reaches only the left one.
        # Read ahead of the match: an arm narrows `n` to its own row.
        ipu: operatorPartsAt :ast :nid
        match (
            n
        ) case call then {
            callableId = n.callable
            if ipu.found then {
                isOperator = true
                lhsId = ipu.lhs
                rhsId = ipu.rhs
            }
        } case atomid then {
            nameId = n.name
        } case dottedpath then {
            parentId = n.parent
        } else null
    }
    if isOperator then {
        # an operand may carry the unresolvable name (`ghost + 1`)
        ubl: unresolvedBareCallable :ast :st :unitDecl nid: lhsId
        if ubl.length > 0 then return ubl
        return (unresolvedBareCallable :ast :st :unitDecl nid: rhsId)
    }
    if kind.call then {
        ubc: zast.nameid
        rootName: zast.nameid
        cnode: ast.nodes.get i: callableId
        ubc = atomNameId :ast n: cnode
        rootName = rootNameIdOf :ast n: cnode
        if ubc.notZero then return (unresolvedBareName :ast :st :unitDecl nameId: ubc)
        return (unresolvedBareName :ast :st :unitDecl nameId: rootName)
    }
    if kind.atomid then return (unresolvedBareName :ast :st :unitDecl :nameId)
    if kind.dottedpath then {
        # a path is no better than its root (`b.n` with no `b`)
        ubd: zast.nameid
        pn: ast.nodes.get i: parentId
        ubd = rootNameIdOf :ast n: pn
        if ubd.isZero then return "".string
        return (unresolvedBareName :ast :st :unitDecl nameId: ubd)
    }
    return "".string
}

# reportUnresolvedValue -- a value that typed to nothing and raised nothing is
# an unresolvable name: report it here, where the value is consumed. Without
# it the 0 silently disables the consuming site's own checks and the emitter
# writes the bare name into the C. Mirrors the binding and statement sites.
reportUnresolvedValue: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    nid: zast.nodeid
} is {
    # the row's shape, root name and position
    isDotted: false
    ubD: zast.nameid
    eLn: u32
    eCo: u32
    vnode: ast.nodes.get i: nid
    isDotted = vnode.dottedpath
    if isDotted then ubD = rootNameIdOf :ast n: vnode
    eLn = nodeLine n: vnode
    eCo = nodeCol n: vnode
    ubU: unresolvedBareCallable :ast :st :unitDecl :nid
    # the ROOT of a dotted VALUE carries the name (`ghost.field`) -- the
    # callee leg already makes this check for `ghost.method`. It stays
    # here rather than in unresolvedBareCallable: the statement and
    # binding sites share that helper and reach bodies whose locals are
    # absent from the scope table, where the negative proof would reject
    # a real name (`lx.advance` in zlexer's Lexer).
    if ubU.length == 0 when isDotted then ubU = unresolvedBareName :ast :st :unitDecl nameId: ubD
    if ubU.length == 0 then {
        refuseUnitNameValue :st :ast :nid
        return
    }
    umU: "Unknown reference '\{ubU}'"
    enU: String
    ehU: String
    (
        addErrorWithHint
        :st
        nodeid: nid
        lineno: eLn
        colno: eCo
        e: zast.err.badReference
        msg: umU
        note: enU
        hint: ehU
        width: ubU.length
    )
}

# walkOwnerMono -- the instance whose members the current instance walk reads
# its bare names from: the walked instance, or -- for an instance of a unit
# function with type parameters of its own -- the unit instance that owns the
# function. 0 outside an instance walk.
walkOwnerMono: function {st: zenv.ZSymbolTable.view} out ztypes.tid is {
    m: st.typing.curMonoStamp
    if (st.reg.typetypeOf typeId: m) != ztypes.ztypetype.functionType then return m
    own: st.reg.ownerTidOf tid: (st.reg.genericOriginOf tid: m)
    if (st.reg.typetypeOf typeId: own) != ztypes.ztypetype.unitType then return m
    if (st.reg.genericOriginOf tid: own).isZero then return m
    return own
}

# bindGenLocal -- a local a generator `call` body bound. The body resumes in a
# later call, so the local is kept in the instance: a field of the local's own
# type, one per variable, which the emitter binds and reads it through
# (genLocalFieldOf). A view is a value like any other there. A borrow of a place
# stays a C local and may not be in scope at a yield (noteGenBorrowBinding); a
# `yield` value lives in the resume slot.
bindGenLocal: function {
    st: zenv.ZSymbolTable
    ast: Ast
    own: ztypes.zownership
    vid: ztypes.vid
    nameId: zast.nameid
    value: zast.nodeid
} is {
    if st.walk.currentGenTid.isZero then return
    vt: st.reg.variableTypeOf id: vid
    if own == ztypes.zownership.borrowed when (isViewFamilyTid :ast :st tid: vt).not then {
        noteGenBorrowBinding :st :ast :own :nameId :value
        return
    }
    if (valueIsYieldCall :ast nid: value) then return
    nm: zast.nameTextCopy :ast ref: nameId
    fid: mintGenField :st :ast name: nm.stringView tid: vt
    st.typing.genLocalFieldOf.set key: vid value: fid
}

# noteGenBorrowBinding -- a generator body bound `nameId` to a borrow, which may
# not be in scope at a yield (reportBorrowsAtYield). A `yield` value is no borrow
# of the body's: it lives in the resume slot.
noteGenBorrowBinding: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    own: ztypes.zownership
    nameId: zast.nameid
    value: zast.nodeid
} is {
    if own != ztypes.zownership.borrowed then return
    if st.walk.currentGenTid.isZero then return
    if (valueIsYieldCall :ast nid: value) then return
    st.noteGenBorrow :nameId
}

# valueIsYieldCall -- the value `nid` is a `yield` call, through a statement
# line.
valueIsYieldCall: function {ast: Ast.view nid: zast.nodeid} out bool is {
    n: ast.nodes.get i: nid
    match (
        n
    ) case statementline then {
        return (valueIsYieldCall :ast nid: n.statementline)
    } case call then {
        return (zast.isYieldCalleeAt :ast callableId: n.callable)
    } else {
        return false
    }
}

# refuseYieldedLocks -- a generator hands out owned values only (a yield of a
# reference is not built yet: docs/Design-OPEN.pdoc), so a yielded value that
# keeps something locked -- a view of the generator's own state, of what it was
# given, of a local -- would reach the caller with nothing keeping its source
# alive: it is refused, as a return through `out` is (checkReturnCarries). A
# plain value copied out (a list walk's i64) points into nothing, whatever lock
# the name it was read from holds.
refuseYieldedLocks: function {st: zenv.ZSymbolTable ast: Ast arg: argref argT: ztypes.tid} is {
    if argT.isZero then return
    points: (st.reg.isReftypeOf tid: argT) or (isViewFamilyTid :ast :st tid: argT)
    if points.not then return
    held: List ztyping.PinPath
    yn: zast.atomNameIdOf n: (ast.nodes.get i: arg.operation)
    if yn.notZero then {
        yv: st.lookupVarId nameId: yn
        if yv.some then st.heldLockPaths holder: ztypes.zlockholder.var yv dst: held
    }
    root: zast.nameid
    if held.length > 0 then root = pinRootAt pins: held i: 0
    yp: moves.valuePinsOf :st nid: arg.operation
    if root.isZero when yp.len > 0 then root = recordRootAt :st vp: yp i: 0
    if root.isZero then return
    rp: moves.lockRootPhrase :st :ast nameId: root
    (
        addError
        :st
        nodeid: arg.nid
        lineno: arg.lineno
        colno: arg.colno
        e: zast.err.ownerError
        msg: "Cannot yield this value: it keeps \{rp} locked, and a generator hands out owned values only"
    )
}

# one call-checking leg's answer: whether it handled the call at all, and
# what the call yields if it did
callleg: record {
    # whether this leg answered at all; `tid` means nothing when it did not
    handled: bool
    # what the call yields, when the leg answered
    tid: ztypes.tid
}

# fillGenericDefaults -- bind each parameter of `tdecl` that the instantiation
# neither wrote nor inferred and that declares a `default:`, in declaration
# order: a type into `subs`, a numeric constant into `valSubs`, each adding its
# component to `sfx`. A default may name another parameter of the same
# declaration, written before or after it, which is filled first; only a cycle
# is refused. False once a default was refused (reported at the default).
fillGenericDefaults: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tdecl: ztypes.declid
    subs: (IdMapV zast.nameid v: ztypes.tid)
    valSubs: (IdMapV zast.nameid v: u64)
    sfx: String
} out bool is {
    grey: IdSet zast.nameid
    pi: u64
    for pi < (st.reg.genericParamCountOf :tdecl) loop {
        pn: st.reg.genericParamNameAt :tdecl i: pi
        pi = pi + 1
        if (typeargs.fillOneDefault :st :ast :tdecl :pn :subs :valSubs :sfx :grey
        ).not then return false
    }
    return true
}

# refuseUninferredArmParam -- an arm constructed without the type's arguments
# binds only the parameters its payload names (`leaf: t` binds `t`, `many:
# (List t)` binds it from the list's element); any other parameter is inferred
# from nothing, as the language infers no expected type, and is refused here.
# True once reported.
refuseUninferredArmParam: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    call: callref
    dtp: ztypes.tid
    tdecl: ztypes.declid
    # the arm constructed, for the note
    armId: zast.nameid
    # the arm carries nothing: its argument names the type, or nothing does
    isNullPay: bool
    subs: (IdMapV zast.nameid v: ztypes.tid).view
} out bool is {
    pi: u64
    for pi < (st.reg.genericParamCountOf :tdecl) loop {
        pn: st.reg.genericParamNameAt :tdecl i: pi
        pi = pi + 1
        numeric: (st.reg.genericParamConstraintOf :tdecl paramName: pn).numKind.has
        if numeric.not when (subs.has key: pn).not then {
            (
                reportUninferredArm
                :st
                :ast
                :dtp
                :pn
                :armId
                :isNullPay
                at: call.nid
                line: call.lineno
                col: call.colno
            )
            return true
        }
    }
    return false
}

# reportUninferredArm -- the refusal of an arm construction that leaves `pn`
# unbound: the note says why nothing names it, the hint writes the argument.
reportUninferredArm: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    dtp: ztypes.tid
    pn: zast.nameid
    armId: zast.nameid
    isNullPay: bool
    at: zast.nodeid
    line: u32
    col: u32
} is {
    pnT: zast.nameTextAt :ast ref: pn
    armT: zast.nameTextAt :ast ref: armId
    tname: specWrittenName :st :ast tid: dtp
    note: "arm '\{armT}' holds no '\{pnT}', so its value does not name it"
    if isNullPay then note = "arm '\{armT}' carries nothing, so no value names '\{pnT}'"
    hint: "write the type's arguments: '(\{tname} \{pnT}: <type>).\{armT}'"
    (
        addErrorWithHint
        :st
        nodeid: at
        lineno: line
        colno: col
        e: zast.err.genericError
        msg: "cannot infer generic parameter '\{pnT}' for '\{tname}'"
        :note
        :hint
        width: 0
    )
}

# mintSumArmInstance -- constructing a generic sum's ARM infers the type's
# arguments from the payload given, through the arm's DECLARED payload: a
# payload that is a parameter binds it, one that applies parameters binds them
# from the value's own arguments, and a null arm's argument names the type of a
# one-parameter sum. Mints that instance and answers its id.
mintSumArmInstance: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    dtp: ztypes.tid
    subT: ztypes.tid
    isNullPay: bool
    # the arm's declared payload type
    payId: ztypes.tid
    armId: zast.nameid
} out callleg is {
    tdecl: st.typing.declIdOfType typeId: dtp
    npar: st.reg.genericParamCountOf :tdecl
    armSubs: IdMapV zast.nameid v: ztypes.tid
    if isNullPay then {
        if npar == 1 then armSubs.set key: (st.reg.genericParamNameAt :tdecl i: 0) value: subT
    } else {
        ppn: st.reg.genericParamNameOfTid :tdecl ptid: payId
        if ppn.notZero then {
            armSubs.set key: ppn value: subT
        } else {
            gparams: st.reg.genericParamNamesOf :tdecl
            (
                typeargs.bindPartialParamSubs
                :st
                :ast
                :gparams
                paramTid: payId
                argTid: subT
                subs: armSubs
            )
        }
    }
    vsH: IdMapV zast.nameid v: u64
    dsfx: String
    if (fillGenericDefaults :st :ast :tdecl subs: armSubs valSubs: vsH sfx: dsfx).not then {
        return (callleg handled: true tid: ztypes.tid)
    }
    if (refuseUninferredArmParam :st :ast :call :dtp :tdecl :armId :isNullPay subs: armSubs) then {
        return (callleg handled: true tid: ztypes.tid)
    }
    monoName: String
    gi: u64
    for gi < npar loop {
        bv: (armSubs.get key: (st.reg.genericParamNameAt :tdecl i: gi)).or d: ztypes.tid.zero
        gi = gi + 1
        if bv.isZero then continue
        an2: st.reg.nameOf tid: bv
        monoName.append s: "_"
        monoName.append s: an2
    }
    mintedT: (
        getOrMintSpec
        :st
        scope: st.curScope
        :ast
        :unitDecl
        sfx: monoName.stringView
        templateId: dtp
        subs: armSubs
        valSubs: vsH
        fallbackArg: ztypes.tid.zero
    )
    if mintedT.notZero then {
        noteMonoSite :st mono: mintedT :call :unitDecl
        setgu: mintedT
        stampGate :st nid: call.nid tid: setgu
        st.typing.callKind.set key: call.nid value: zast.callkind.unionCreate
        return (callleg handled: true tid: mintedT)
    }
    return (callleg handled: false tid: ztypes.tid)
}


# calleeOwnInstance -- the instance a bare generic callee names by itself: a
# type a generic unit declares is the unit instance's copy (unitNestedSelf),
# and `type` in a generic type's own members the instance being checked, as
# `(GB t: t) x: ..` builds it; zero for any other callee.
calleeOwnInstance: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    call: callref
    funcId: ztypes.tid
} out ztypes.tid is {
    own: unitNestedSelf :st :ast tid: funcId
    if own.notZero then return own
    cn: atomNameId :ast n: (ast.nodes.get i: call.callable)
    if (cn == zast.wellKnown.slot.wkType).not then return own
    sa: (
        selfApplicationTid
        :st
        :ast
        :unitDecl
        scope: st.curScope
        templateId: funcId
        nid: call.callable
    )
    if sa.isZero then return own
    return (instanceTypeOf :st :ast :unitDecl tid: sa)
}

# ctorspelling -- how a construction by type name is written, which decides the
# rules refuseNameConstruction applies
ctorspelling: variant {
    # the bare name, `kd` or `(GT t: i64)` alone: a zero-argument `create`
    bareName: null
    # the name given arguments, `kd 5`, `(GT t: i64) leaf: 5`, a template's
    # before they are inferred
    withArgs: null
    # the name's `create` given arguments, `kd.create k: 5`
    createCall: null
    # the name's `create` with none, `kd.create` read as a value: a
    # zero-argument construction, as the bare name is, written another way
    createBare: null
}

# bareCalleeTid -- the function a BARE callable name resolves to: the local scope
# first, then the enclosing unit's definitions, then the prelude. 0 when the
# name reaches nothing callable.
bareCalleeTid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    cnId: zast.nameid
} out ztypes.tid is {
    funcId: ztypes.tid
    if cnId.notZero then {
        # A local variable of FUNCTION type (a spec-typed param or a
        # function reference) is callable; locals shadow unit names.
        lvo: st.lookup nameId: cnId
        if lvo.some when (st.reg.typetypeOf typeId: lvo) == ztypes.ztypetype.functionType then {
            funcId = lvo
            st.typing.callKind.set key: call.nid value: zast.callkind.callable
            # callee-use variable id: calling through a fn-typed
            # variable reads it, so it stamps like a value atom
            cvo: st.lookupVarId nameId: cnId
            if cvo.some then {
                setcv: cvo
                st.typing.setAtomVariable nid: call.callable vid: setcv
            }
        }
        if funcId.isZero then {
            fo: walkLookupTyperefById :st scope: st.curScope :ast :unitDecl baseId: cnId
            if fo.some then {
                funcId = fo
            }
        }
    }
    return funcId
}


# calleekind -- what a bare callee's resolved id turns out to be, and which of
# the call shapes it takes.
calleekind: record {
    # the resolved definition id, 0 when the name resolved to nothing
    fid: ztypes.tid
    # a non-generic user function, or a construction
    isUser: bool
    # a generic callee, whose call infers a clone
    isGen: bool
    # a construction rather than a function call
    isCtor: bool
    # the registry holds no row for the id, so nothing can be said about it
    unknown: bool
}

# bareCalleeKind -- resolve a bare callee NAME and say what it is. The resolved
# id names the definition wherever it lives, so a callee in another unit is
# walked at its call site like a local one -- the name-keyed trigger it
# replaced could only ever find same-unit definitions, because it looked the
# name up in the unit being walked.
bareCalleeKind: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    cnId: zast.nameid
} out calleekind is {
    funcId: ztypes.tid
    if cnId.notZero then funcId = bareCalleeTid :st :unitDecl :ast :call :cnId
    if funcId.notZero then walkDefinitionById :st :ast tid: funcId
    # inside a unit mono's instance walk, a bare callee naming a TEMPLATE
    # member is the MONO's member: the same definition with the argument
    # substitution applied to its parameters and return
    if funcId.notZero when st.typing.curMonoStamp.notZero then {
        # the walked instance's copy, or the copy of an instance owning it: a
        # nested unit's function calls its enclosing unit's functions as that
        # instance's
        funcId = instanceCopyOf :st mono: (walkOwnerMono :st) tid: funcId
        # used on the instance whose member it is: the walked one, or an
        # instance owning it
        usedOn: st.reg.ownerTidOf tid: funcId
        if (st.reg.genericOriginOf tid: usedOn).isZero then usedOn = walkOwnerMono :st
        stdtypes.markMemberUsed :st ownerTid: usedOn nameId: cnId
    }
    if funcId.isZero then {
        return (calleekind fid: funcId isUser: false isGen: false isCtor: false unknown: false)
    }
    if funcId >= st.reg.nextTid then {
        return (calleekind fid: funcId isUser: false isGen: false isCtor: false unknown: true)
    }
    zo: st.reg.typeById.get i: funcId
    if zo.isgeneric then {
        return (calleekind fid: funcId isUser: false isGen: true isCtor: false unknown: false)
    }
    isCtor: zo.typetype != ztypes.ztypetype.functionType
    return (calleekind fid: funcId isUser: true isGen: false :isCtor unknown: false)
}

# refuseNumericOperator -- AN OPERATOR IS AN IDENTIFIER, and a numeric literal
# names no method and never can. This reaches the infix form from the shape a
# call takes when a second argument is written without its name: `f 10 3` is
# three paths, and three paths are the operator form -- receiver `f`, operator
# `10`, argument `3` -- not two arguments. Reported, true; a body and a
# unit-level definition ask the same.
refuseNumericOperator: function {st: zenv.ZSymbolTable ast: Ast call: callref} out bool is {
    if call.infix.not then return false
    opLit: zast.nameTextAt :ast ref: (dottedChildNameId :ast n: (ast.nodes.get i: call.callable))
    if (opLit.length == 0) or (isNumericLiteralName name: opLit.stringView).not then return false
    opNode: ast.nodes.get i: call.callable
    opChild: zast.nodeid
    if opNode.dottedpath then opChild = opNode.child
    mLit: "'\{opLit}' is not an operator: an operator is an identifier"
    hLit: "a call takes at most one unlabelled argument -- give every later argument its parameter name".string
    nLit: String
    (
        addErrorWithHint
        :st
        nodeid: opChild
        lineno: (nodeLine n: (ast.nodes.get i: opChild))
        colno: (nodeCol n: (ast.nodes.get i: opChild))
        e: zast.err.callError
        msg: mLit
        note: nLit
        hint: hLit
        width: opLit.length
    )
    return true
}

# checkCall -- type a call. C1 handles the `return <value>` control-flow form:
# stamp the callable atom with return's type, mark the call RETURN, walk the
# return value, and resolve the call to `never`. Other call kinds land later.
checkCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
} out ztypes.tid is {
    st.typing.callKind.set key: call.nid value: zast.callkind.unknown
    if call.infix.not then noteClosedRange :st :ast :call
    # asked BEFORE the callable or the operands are walked, because walking the
    # receiver reports `f` as a bare function reference first and buries the
    # mistake that produced it
    if (refuseNumericOperator :st :ast :call) then return ztypes.tid.zero
    cnId: bodySelfTypeNameId :st nameId: (atomNameId :ast n: (ast.nodes.get i: call.callable))
    if cnId == zast.wellKnown.slot.wkReturn then {
        return (stdtypes.checkControlBuiltinCall :st :unitDecl :ast :call)
    }
    if cnId == zast.wellKnown.slot.wkYield when (numerics.yieldIsInScope :st) then {
        return (callchecks.checkYieldCall :st :unitDecl :ast :call)
    }
    # a spec has no body to call; a local holding a reference of its type does
    if cnId.notZero when (st.lookupVarId nameId: cnId).none when (
        typeargs.refuseSpecValue
        :st
        :ast
        :unitDecl
        baseId: cnId
        nodeid: call.nid
        lineno: call.lineno
        colno: call.colno
    ) then return ztypes.tid.zero
    return (callchecks.checkRegularCall :st :unitDecl :ast :call :cnId)
}

# callParamIdSubs -- a generic call's substitutions keyed by the function's
# parameter ids rather than their names: the key respecialize maps an
# instance's arguments by.
callParamIdSubs: function {
    st: zenv.ZSymbolTable.view
    funcId: ztypes.tid
    gparams: (ListVal zast.nameid).view
    subs: (IdMapV zast.nameid v: ztypes.tid).view
} out (IdMapV ztypes.tid v: ztypes.genericarg) is {
    idSubs: IdMapV ztypes.tid v: ztypes.genericarg
    fdecl: st.typing.declIdOfType typeId: funcId
    if fdecl.isZero then return idSubs
    for each gp: gparams loop {
        ptid: (st.reg.genericParamTidOf tdecl: fdecl paramName: gp).or d: ztypes.tid.zero
        bound: (subs.get key: gp).or d: ztypes.tid.zero
        if ptid.notZero when bound.notZero then (
            idSubs.set
            key: ptid
            value: ztypes.genericarg.typeArg bound
        )
    }
    return idSubs
}

# healGenericReturn -- a generic-instance return (`out (optionval t: u64)`,
# `out (ListVal t: t)`) has no bare pendingTyperef name, so the substitution
# path leaves the mono's return unset, and a native template has no body walk to
# heal it later. Heal from the template's resolved return type, respecialized
# with the call's own substitutions (keyed by the function's parameter ids) --
# the same treatment the generic-class method path gets.
healGenericReturn: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    funcId: ztypes.tid
    mid: ztypes.tid
    gparams: (ListVal zast.nameid).view
    subs: (IdMapV zast.nameid v: ztypes.tid).view
} is {
    rhas: false
    rmo: st.reg.returnTypeOf tid: mid
    if rmo.notZero then rhas = true
    if rhas.not then {
        rto: ztypes.tid
        {
            rns: st.typing.funcReturnNode.get key: funcId
            if rns.some then {
                rst: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: rns
                if rst.notZero then rto = rst
            }
        }
        if rto.isZero then {
            tro: st.reg.returnTypeOf tid: funcId
            if tro.notZero then rto = tro
        }
        if rto.notZero then {
            respecIdSubs: callParamIdSubs :st :funcId :gparams :subs
            rr: respecialize :st scope: st.curScope :ast :unitDecl specTid: rto idSubs: respecIdSubs
            rt: rto
            if rr.notZero then rt = rr
            if (st.reg.typetypeOf typeId: rt) != ztypes.ztypetype.genericParam then {
                st.reg.setReturnType typeId: mid value: rt
            }
        }
    }
}


# caseGenericSubjectTid -- the type of a `match` subject that is not a value: a
# bare generic parameter, resolved against the enclosing generic context so it
# stamps as a genericParam and the emitter can dissect it per mono. 0 when the
# subject names no such parameter.
caseGenericSubjectTid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    casenode: caseref
} out ztypes.tid is {
    subjT: ztypes.tid
    gsn: flow.subjectAtomName :ast n: (ast.nodes.get i: casenode.subject)
    if gsn.length > 0 then {
        gdecl: ztypes.declid
        {
            gdecl = (
                declOfUnitDef
                :st
                scope: st.curScope
                unitDecl: st.walk.synthOwnerUnit
                nameId: st.walk.synthOwnerName
            )
        }
        if gdecl.notZero when (
            st.reg.isGenericParamOf
            tdecl: gdecl
            name: (nameIdOf :ast name: gsn.stringView)
        ).not then {
            gdecl = ztypes.declid.zero
        }
        if gdecl.isZero then {
            gur: unitDecl
            if gur.notZero when (
                st.reg.isGenericParamOf
                tdecl: gur
                name: (nameIdOf :ast name: gsn.stringView)
            ) then gdecl = gur
        }
        if gdecl.isZero when st.typing.curMonoStamp.notZero then {
            # a mono-clone body walk: the subject's template is the
            # current mono's generic origin
            mog: ztypes.tid
            mgo: st.reg.genericOriginOf tid: st.typing.curMonoStamp
            if mgo.notZero then mog = mgo
            if mog.notZero then {
                gdecl = st.typing.declIdOfType typeId: mog
                if gdecl.notZero when (
                    st.reg.isGenericParamOf
                    tdecl: gdecl
                    name: (nameIdOf :ast name: gsn.stringView)
                ).not then gdecl = ztypes.declid.zero
            }
        }
        if gdecl.isZero when gdecl.isZero then gdecl = (
            bodies.monoSubjectDecl
            :st
            :ast
            :unitDecl
            gsn: gsn.stringView
        )
        if gdecl.notZero then {
            subjT = declare.genericParamSubjectTid :st :ast :casenode :gdecl gsn: gsn.stringView
        }
    }
    return subjT
}


# publicCaseArm -- the arm a case clause names through its subject type's
# public interface: a renamed arm is the arm it renames (stamped on the clause
# for the emitter), and a private arm is refused, as a member read is.
publicCaseArm: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    clause: caseclauseref
    subjT: ztypes.tid
    written: zast.nameid
    # false through a private-capable subject, which names arms as declared
    armsPublic: bool
} out zast.nameid is {
    if armsPublic.not then return written
    intA: declPublicAliasInternal :st tid: subjT nameId: written
    if intA.notZero then {
        st.typing.setAliasInternalId nodeid: clause.nid internalId: intA
        return intA
    }
    if (declMemberIsPrivate :st tid: subjT nameId: written) then {
        an: zast.nameTextAt :ast ref: written
        stn: specWrittenName :st :ast tid: subjT
        marm: ast.nodes.get i: clause.matcharm
        (
            addError
            :st
            nodeid: (zast.nodeIdOf n: marm)
            lineno: (nodeLine n: marm)
            colno: (nodeCol n: marm)
            e: zast.err.notPublic
            msg: "'\{an}' is not public on type '\{stn}'"
        )
    }
    return written
}


# caseSubjectTid -- type a match's subject. A subject that types to nothing and
# raised nothing is an unresolvable name, reported where the match reads it.
caseSubjectTid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    casenode: caseref
} out ztypes.tid is {
    errS: st.typing.errors.length
    subjT: checkValueAt :st :unitDecl :ast nid: casenode.subject
    # a numeric generic parameter is dissected per mono, never matched as the
    # number it reads as
    if (st.typing.numericParamRead.has key: casenode.subject) then {
        gs: caseGenericSubjectTid :st :unitDecl :ast :casenode
        if gs.isZero then gs = unitParamSubjectTid :st :unitDecl :ast :casenode
        return gs
    }
    if subjT.isZero then subjT = caseGenericSubjectTid :st :unitDecl :ast :casenode
    if subjT.isZero when st.typing.errors.length == errS then {
        reportUnresolvedValue :st :unitDecl :ast nid: casenode.subject
    }
    # a subject no variable holds -- a call's owning result -- is held, and
    # freed, by a temporary of the checker's, as a value receiver is
    if subjT.notZero when (moves.receiverIsValue :st :ast :unitDecl nid: casenode.subject) then {
        moves.ownedReceiverTemp :st :ast recvT: subjT recvNid: casenode.subject
        genSubjectField :st :ast nid: casenode.subject tid: subjT
    }
    return subjT
}

# genSubjectField -- in a generator body a match's arms may suspend, so the
# temporary holding its subject is kept in the instance, as a local of the body
# is (bindGenLocal): a field of the subject's type, freed by the instance's
# destructor if the body never reaches the temporary's own destroy.
genSubjectField: function {st: zenv.ZSymbolTable ast: Ast nid: zast.nodeid tid: ztypes.tid} is {
    if st.walk.currentGenTid.isZero then return
    tv: st.typing.tempOf.get key: nid
    if tv.none then return
    fid: mintGenField :st :ast name: "m" :tid
    st.typing.genLocalFieldOf.set key: tv value: fid
}

# unitParamSubjectTid -- a bare match subject naming a generic UNIT's parameter:
# the unit declares it as a member, and the type it names there is the
# parameter's GENERIC_PARAM type, which checkCase dissects. 0 for any other.
unitParamSubjectTid: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    casenode: caseref
} out ztypes.tid is {
    nameId: zast.atomNameIdOf n: (ast.nodes.get i: casenode.subject)
    if nameId.isZero then return ztypes.tid
    ro: walkLookupTyperefById :st scope: st.curScope :ast :unitDecl baseId: nameId
    if ro.some then {
        rt: ro
        if (st.reg.isTypeParamOf tid: rt) then return rt
    }
    return ztypes.tid
}

# swapref -- what the swap walk reads of its row: the operand ids and the
# position, as plain values.
swapref: record {
    # the swap node this was read from
    nid: zast.nodeid
    # one side of the swap
    lhs: zast.nodeid
    # the other side
    rhs: zast.nodeid
    # the line to report this swap against
    lineno: u32
    # the column to report this swap against
    colno: u32
}

# swapRefAt -- the swap row `nid` as plain values (all zero for any other arm).
swapRefAt: function {ast: Ast.view nid: zast.nodeid} out swapref is {
    n: ast.nodes.get i: nid
    if n.swapstmt then return (swapref :nid lhs: n.lhs rhs: n.rhs lineno: n.lineno colno: n.colno)
    zn: zast.nodeid
    return (swapref nid: zn lhs: zn rhs: zn lineno: 0 colno: 0)
}

# withref -- what the with walk reads of its row: the bound name, the value
# and body ids and the position, as plain values.
withref: record {
    # the with node this was read from
    nid: zast.nodeid
    # the name bound for the block
    name: zast.nameid
    # what it is bound to
    value: zast.nodeid
    # the block the binding lives for
    body: zast.nodeid
    # the line to report this with against
    lineno: u32
    # the column to report this with against
    colno: u32
}

# withRefAt -- the with row `nid` as plain values (all zero for any other arm).
withRefAt: function {ast: Ast.view nid: zast.nodeid} out withref is {
    n: ast.nodes.get i: nid
    if n.withexpr then {
        return (
            withref
            :nid
            name: n.name
            value: n.value
            body: n.body
            lineno: n.lineno
            colno: n.colno
        )
    }
    zn: zast.nodeid
    zm: zast.nameid
    return (withref nid: zn name: zm value: zn body: zn lineno: 0 colno: 0)
}

# doref -- what the do walk reads of its row: the statement id and the
# position, as plain values.
doref: record {
    # the do node this was read from
    nid: zast.nodeid
    # the block whose value the do takes
    statement: zast.nodeid
    # the line to report this do against
    lineno: u32
    # the column to report this do against
    colno: u32
}

# doRefAt -- the do row `nid` as plain values (all zero for any other arm).
doRefAt: function {ast: Ast.view nid: zast.nodeid} out doref is {
    n: ast.nodes.get i: nid
    if n.doexpr then return (doref :nid statement: n.statement lineno: n.lineno colno: n.colno)
    zn: zast.nodeid
    return (doref nid: zn statement: zn lineno: 0 colno: 0)
}

# argref -- what an argument or member walk reads of a namedoperation row:
# the label, the operation id and the position, as plain values.
argref: record {
    # the argument node this was read from
    nid: zast.nodeid
    # the argument's label
    name: zast.nameid
    # the value it labels
    operation: zast.nodeid
    # the line to report this argument against
    lineno: u32
    # the column to report this argument against
    colno: u32
}

# argRefAt -- the namedoperation row `nid` as plain values (all zero for any
# other arm).
argRefAt: function {ast: Ast.view nid: zast.nodeid} out argref is {
    n: ast.nodes.get i: nid
    if n.namedoperation then {
        return (argref :nid name: n.name operation: n.operation lineno: n.lineno colno: n.colno)
    }
    zn: zast.nodeid
    zm: zast.nameid
    return (argref nid: zn name: zm operation: zn lineno: 0 colno: 0)
}

# reasgref -- what the reassignment walk reads of its row: the target and
# value ids and the position, as plain values.
reasgref: record {
    # the reassignment node this was read from
    nid: zast.nodeid
    # the path written to
    topath: zast.nodeid
    # the new value
    value: zast.nodeid
    # the line to report this reassignment against
    lineno: u32
    # the column to report this reassignment against
    colno: u32
}

# reasgRefAt -- the reassignment row `nid` as plain values (all zero for any
# other arm).
reasgRefAt: function {ast: Ast.view nid: zast.nodeid} out reasgref is {
    n: ast.nodes.get i: nid
    if n.reassignment then {
        return (reasgref :nid topath: n.topath value: n.value lineno: n.lineno colno: n.colno)
    }
    zn: zast.nodeid
    return (reasgref nid: zn topath: zn value: zn lineno: 0 colno: 0)
}

# reportUnknownNameAt -- `name` is an unknown reference at row `nid`: the
# report the binding, statement and reassignment sites share.
reportUnknownNameAt: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    nid: zast.nodeid
    name: String
} is {
    vn: ast.nodes.get i: nid
    um: "Unknown reference '\{name}'"
    en: String
    eh: String
    (
        addErrorWithHint
        :st
        nodeid: nid
        lineno: (nodeLine n: vn)
        colno: (nodeCol n: vn)
        e: zast.err.badReference
        msg: um
        note: en
        hint: eh
        width: name.length
    )
}

# asgnref -- what the binding walk reads of its row: the bound name, the
# value id and the position, as plain values.
asgnref: record {
    # the binding node this was read from
    nid: zast.nodeid
    # the name declared
    name: zast.nameid
    # the value bound to it
    value: zast.nodeid
    # the line to report this binding against
    lineno: u32
    # the column to report this binding against
    colno: u32
}

# caseclauseref -- what the match-arm walk reads of its row: the binding
# name, the matched arm id, the statement id and the position.
caseclauseref: record {
    # the match arm node this was read from
    nid: zast.nodeid
    # the arm matched
    name: zast.nameid
    # the binding the payload narrows into, 0 for a payload-less arm
    matcharm: zast.nodeid
    # the arm's body
    statement: zast.nodeid
    # the line to report this match arm against
    lineno: u32
    # the column to report this match arm against
    colno: u32
}

# operatorPartsAt -- the operands and the operator of the binary operation at
# `nid`, in either spelling: written between its operands (`a + b`), or as a
# call of a symbol-named member with one argument (`a.+ rhs: b`). The two name
# one method, so every walk that asks what an operation is asks here. Not
# found for any other row.
operatorPartsAt: function {ast: Ast.view nid: zast.nodeid} out zast.infixparts is {
    zn: zast.nodeid
    ip: zast.infixPartsOf :ast n: (ast.nodes.get i: nid)
    if ip.found then return ip
    n: ast.nodes.get i: nid
    absent: zast.infixparts found: false lhs: zn operator: zn rhs: zn
    if n.call.not then return absent
    if n.arguments.count.u64 != 1 then return absent
    cb: ast.nodes.get i: n.callable
    if cb.dottedpath.not then return absent
    opText: zast.nameTextAt :ast ref: (zast.atomNameIdOf n: (ast.nodes.get i: cb.child))
    if (isOperatorName name: opText.stringView).not then return absent
    an: ast.nodes.get i: (zast.kidAt kids: ast.kids span: n.arguments i: 0)
    if an.namedoperation.not then return absent
    return (zast.infixparts found: true lhs: cb.parent operator: cb.child rhs: an.operation)
}

# atomref -- what the bare-name walk reads of its row: the name id and the
# position, as plain values.
atomref: record {
    # the atom node this was read from
    nid: zast.nodeid
    # the name the atom spells
    name: zast.nameid
    # the line to report this atom against
    lineno: u32
    # the column to report this atom against
    colno: u32
}

# atomRefAt -- the atomid row `nid` as plain values (all zero for any other
# arm).
atomRefAt: function {ast: Ast.view nid: zast.nodeid} out atomref is {
    n: ast.nodes.get i: nid
    if n.atomid then return (atomref :nid name: n.name lineno: n.lineno colno: n.colno)
    zn: zast.nodeid
    zm: zast.nameid
    return (atomref nid: zn name: zm lineno: 0 colno: 0)
}

# strref -- what the string-literal walk reads of its row: the part count and
# the position, as plain values.
strref: record {
    # the interpolated string node this was read from
    nid: zast.nodeid
    # how many chunks the literal has, counted so the view can be dropped before
    # they are walked
    nparts: u64
    # the line to report this interpolated string against
    lineno: u32
    # the column to report this interpolated string against
    colno: u32
}

# strRefAt -- the atomstring row `nid` as plain values (all zero for any other
# arm).
strRefAt: function {ast: Ast.view nid: zast.nodeid} out strref is {
    n: ast.nodes.get i: nid
    if n.atomstring then {
        return (strref :nid nparts: n.stringparts.count lineno: n.lineno colno: n.colno)
    }
    zn: zast.nodeid
    return (strref nid: zn nparts: 0 lineno: 0 colno: 0)
}

# dpref -- what the dotted-path walk reads of its row: the parent and child
# ids and the position, as plain values.
dpref: record {
    # the dotted path node this was read from
    nid: zast.nodeid
    # the left of the dot
    parent: zast.nodeid
    # the right of it
    child: zast.nodeid
    # the line to report this dotted path against
    lineno: u32
    # the column to report this dotted path against
    colno: u32
}

# dpRefOf -- the dotted-path row `dp` as plain values.
dpRefOf: function {dp: zast.dottedpathrow.view} out dpref is {
    return (
        dpref
        nid: dp.nodeid
        parent: dp.parent
        child: dp.child
        lineno: dp.lineno
        colno: dp.colno
    )
}

# dpRefAt -- the dotted-path row `nid` as plain values (all zero for any other
# arm).
dpRefAt: function {ast: Ast.view nid: zast.nodeid} out dpref is {
    n: ast.nodes.get i: nid
    if n.dottedpath then return (dpRefOf dp: n)
    zn: zast.nodeid
    return (dpref nid: zn parent: zn child: zn lineno: 0 colno: 0)
}

# callref -- what the call walk reads of its row: the callable id, the
# argument count and the position, as plain values. The arguments are read
# by index through zast.callArgAt.
callref: record {
    # the call node this was read from
    nid: zast.nodeid
    # what is being called
    callable: zast.nodeid
    # how many arguments it has
    nargs: u64
    # the line to report this call against
    lineno: u32
    # the column to report this call against
    colno: u32
    # written INFIX (`a op b`). The two spellings differ in the RECEIVER:
    # infix evaluates its left operand as a VALUE expression, where the
    # dotted form reads it as a path segment
    infix: bool
}

# callRefOf -- the call row `call` as plain values.
callRefOf: function {call: zast.callrow.view} out callref is {
    return (
        callref
        nid: call.nodeid
        callable: call.callable
        nargs: call.arguments.count
        lineno: call.lineno
        colno: call.colno
        infix: call.infix
    )
}

# callRefAt -- the call row `nid` as plain values (all zero for any other arm).
callRefAt: function {ast: Ast.view nid: zast.nodeid} out callref is {
    n: ast.nodes.get i: nid
    if n.call then return (callRefOf call: n)
    zn: zast.nodeid
    return (callref nid: zn callable: zn nargs: 0 lineno: 0 colno: 0 infix: false)
}

# fnref -- what a function walk reads of its definition row: the return-type
# id, the parameter count, the body id, the native flag and the position, as
# plain values. Parameters are read by index through zast.fnParamAt.
fnref: record {
    # the function definition node this was read from
    nid: zast.nodeid
    # the declared `out` type, 0 when there is none
    returntype: zast.nodeid
    # how many parameters it declares
    nparams: u64
    # the body, 0 for a native
    body: zast.nodeid
    # whether the runtime provides it, so there is nothing here to walk
    isNative: bool
    # declared `outx`: the result keeps the call's borrow/view inputs locked
    pins: bool
    # the line to report this function definition against
    lineno: u32
    # the column to report this function definition against
    colno: u32
}

# caseref -- what the match walk reads of its row: the subject id, the clause
# count, the else id and the position, as plain values. Clauses are read by
# index through zast.caseClauseAt.
caseref: record {
    # the match node this was read from
    nid: zast.nodeid
    # what is matched
    subject: zast.nodeid
    # how many arms it has
    nclauses: u64
    # the trailing else, 0 when the arms are exhaustive
    elseclause: zast.nodeid
    # the line to report this match against
    lineno: u32
    # the column to report this match against
    colno: u32
}

# caseRefAt -- the match row `nid` as plain values (all zero for any other arm).
caseRefAt: function {ast: Ast.view nid: zast.nodeid} out caseref is {
    n: ast.nodes.get i: nid
    if n.caseexpr then {
        return (
            caseref
            :nid
            subject: n.subject
            nclauses: n.clauses.count
            elseclause: n.elseclause
            lineno: n.lineno
            colno: n.colno
        )
    }
    zn: zast.nodeid
    return (caseref nid: zn subject: zn nclauses: 0 elseclause: zn lineno: 0 colno: 0)
}

# ifref -- what the if walk reads of its row: the clause count, the else id
# and the position, as plain values. Clauses are read by index through
# zast.ifClauseAt.
ifref: record {
    # the if node this was read from
    nid: zast.nodeid
    # how many if and else-if clauses
    nclauses: u64
    # the trailing else, 0 for none
    elseclause: zast.nodeid
    # the line to report this if against
    lineno: u32
    # the column to report this if against
    colno: u32
}

# ifRefAt -- the if row `nid` as plain values (all zero for any other arm).
ifRefAt: function {ast: Ast.view nid: zast.nodeid} out ifref is {
    n: ast.nodes.get i: nid
    if n.ifexpr then {
        return (
            ifref
            :nid
            nclauses: n.clauses.count
            elseclause: n.elseclause
            lineno: n.lineno
            colno: n.colno
        )
    }
    zn: zast.nodeid
    return (ifref nid: zn nclauses: 0 elseclause: zn lineno: 0 colno: 0)
}

# forref -- what the for walk reads of its row: the condition and
# postcondition counts, the body id and the position, as plain values.
# Conditions and postconditions are read by index through zast.forCondAt /
# forPostAt.
forref: record {
    # the for node this was read from
    nid: zast.nodeid
    # how many leading conditions
    nconds: u64
    # the loop body
    body: zast.nodeid
    # how many trailing conditions, which is what makes it a do-while
    nposts: u64
    # the line to report this for against
    lineno: u32
    # the column to report this for against
    colno: u32
    # the binding was written `each`
    isEach: bool
}

# forRefAt -- the for row `nid` as plain values (all zero for any other arm).
forRefAt: function {ast: Ast.view nid: zast.nodeid} out forref is {
    n: ast.nodes.get i: nid
    if n.forexpr then {
        return (
            forref
            :nid
            nconds: n.conditions.count
            body: n.body
            nposts: n.postconditions.count
            lineno: n.lineno
            colno: n.colno
            isEach: n.isEach
        )
    }
    zn: zast.nodeid
    return (forref nid: zn nconds: 0 body: zn nposts: 0 lineno: 0 colno: 0 isEach: false)
}

# labelRefAt -- the labelvalue row `nid` as plain values: the same shape as an
# atom (name id and position), all zero for any other arm.
labelRefAt: function {ast: Ast.view nid: zast.nodeid} out atomref is {
    n: ast.nodes.get i: nid
    if n.labelvalue then return (atomref :nid name: n.name lineno: n.lineno colno: n.colno)
    zn: zast.nodeid
    zm: zast.nameid
    return (atomref nid: zn name: zm lineno: 0 colno: 0)
}


# checkLabelValueAt -- the `:x` shorthand in value position reads the local x
# -- and only a local: it resolves through no other scope, so a miss is
# unresolvable.
checkLabelValueAt: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    lv: atomref
} out ztypes.tid is {
    lvo: st.lookup nameId: lv.name
    match (
        lvo
    ) case some then {
        lvt: lvo
        # `:f` over a function reference calls it, as a bare `f` does: the label
        # is its namedoperation's, and the value becomes the call. A lowering's
        # forward hands the parameter on as it is.
        fwd: zast.isForwardingLabel n: (ast.nodes.get i: lv.nid)
        if fwd.not when (callsObjectBare :st :ast node: lv t: lvt) then {
            return (checkValueRowAt :st :unitDecl :ast nid: lv.nid)
        }
        if fwd.not when (readsFnRefAsCall :st t: lvt) then {
            if (fnAutoCallable :st mid: lvt) then {
                rewriteReadAsCall :ast node: lv
                return (checkValueRowAt :st :unitDecl :ast nid: lv.nid)
            }
            lvt = bareFnCall :st :ast node: lv fid: lvt
        }
        stampGate :st nid: lv.nid tid: lvt
        lvv: st.lookupVarId nameId: lv.name
        if lvv.some then {
            setlvv: lvv
            st.typing.setAtomVariable nid: lv.nid vid: setlvv
        }
        return lvt
    } case none then {
        # the local whose statement is being checked, which lookup answers
        # none for
        if (st.isGreyName nameId: lv.name) then {
            reportGreyUse :st :ast nid: lv.nid nameId: lv.name
            return ztypes.tid
        }
        lvNm: zast.nameTextAt :ast ref: lv.name
        lvm: "Unknown reference '\{lvNm}'"
        lvn: String
        lvh: "the ':name' shorthand reads a local named '\{lvNm}'; write the argument in full to pass something else"
        (
            addErrorWithHint
            :st
            nodeid: lv.nid
            lineno: lv.lineno
            colno: lv.colno
            e: zast.err.badReference
            msg: lvm
            note: lvn
            hint: lvh
            width: lvNm.length
        )
        return ztypes.tid.zero
    }
}


# staticlistref -- what the list walk reads of its row: the element count,
# the out-type id and the position, as plain values. Elements are read by
# index through zast.listElemAt.
staticlistref: record {
    # the list node this was read from
    nid: zast.nodeid
    # how many elements
    nelems: u64
    # the declared element type, 0 when it is inferred
    outType: zast.nodeid
    # the line to report this list against
    lineno: u32
    # the column to report this list against
    colno: u32
}

# staticListRefAt -- what the list walk reads of list definition `nid`: its
# element count and position (all zero for any other arm).
staticListRefAt: function {ast: Ast.view nid: zast.nodeid} out staticlistref is {
    n: ast.nodes.get i: nid
    if n.listblock then {
        return (
            staticlistref
            :nid
            nelems: n.elements.count
            outType: n.outType
            lineno: n.lineno
            colno: n.colno
        )
    }
    zn: zast.nodeid
    return (staticlistref nid: zn nelems: 0 outType: zn lineno: 0 colno: 0)
}

# walkTypeOf -- the type the walk in progress stamped on body node `nid`.
walkTypeOf: function {st: zenv.ZSymbolTable.view nid: zast.nodeid} out ztypes.tid is {
    return (ztyping.nodeTypeAt tbl: st.typing.nodeType :nid)
}

# checkValueAt -- type the value row `nid`, then record what it evaluates to.
# The two channels are written in that order because the value channel renders
# through the type one: a node with no type stamp has nothing to render a
# constant AS.
checkValueAt: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    nid: zast.nodeid
} out ztypes.tid is {
    # THE NODE'S DRAFT IS ITS OWN, AND ITS RECORD. A draft the enclosing walk
    # has under way waits for the node's walk and comes back as it was
    # (checkValueAside); the node's draft goes to its record (recordDraft),
    # which a value composed from the node reads (composeChildRecord)
    if st.walk.draft.holds then return (stdtypes.checkValueAside :st :unitDecl :ast :nid)
    t: checkValueRowAt :st :unitDecl :ast :nid
    stdtypes.recordDraft :st :nid
    st.walk.draft.clear
    return t
}

# checkValueRowAt -- checkValueAt's walk of the row.
checkValueRowAt: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    nid: zast.nodeid
} out ztypes.tid is {
    t: checkValueArmAt :st :unitDecl :ast :nid
    refuseCompileTimeSumValue :st :ast :nid :t
    consteval.stampConstAt :st :unitDecl :ast :nid
    ult: untypedNameReadTid :st :ast :nid
    if ult.notZero then {
        stampGate :st :nid tid: ult
        return ult
    }
    markStaticListIndexRead :st :ast :nid
    markFoldedFnFieldCall :st :ast :nid
    ft: textFoldType :st :ast :nid
    if ft.notZero then {
        stampGate :st :nid tid: ft
        return ft
    }
    return t
}

# untypedNameReadTid -- the literal type a NAME read at `nid` wears when it
# folded to an untyped number: a constant read bare or through its unit or type
# (`K`, `nums.J`, `cfg.K` with `K: 5`), or an untyped data value's field -- not
# a method's folded result, which has the method's type. Such
# a constant is an untyped literal, so it reads as its value written in place
# would -- `K + w` is w's type, as `5 + w` is. 0 for any other node; a typed
# constant (`L: 5.u8`) is its type.
untypedNameReadTid: function {st: zenv.ZSymbolTable ast: Ast nid: zast.nodeid} out ztypes.tid is {
    {
        n: ast.nodes.get i: nid
        if n.atomid.not and n.dottedpath.not then return ztypes.tid.zero
    }
    # a method's result is the method's: `C.length` on a text constant is the
    # u64 `length` declares, folded or not
    rd: st.typing.refDecl.get key: nid
    if rd.some then {
        k: (st.typing.decls.get i: rd).kind
        if k.methodDecl or k.funcDecl then return ztypes.tid.zero
    }
    v: st.typing.nodeConstAt :nid
    if v.numTid.notZero then return ztypes.tid.zero
    if v.kind.ivalKind then return st.reg.literalIntTid
    if v.kind.fvalKind then return st.reg.literalFloatTid
    return ztypes.tid.zero
}

# textFoldType -- the type of a text method's folded call at `nid` on an
# untyped string: a literal's, as the value it folded to (an untyped number an
# intliteral, a string of the receiver's type), so `"abc".toUpperAscii` is a
# textliteral and no String. 0 when the node is no such fold.
textFoldType: function {st: zenv.ZSymbolTable ast: Ast nid: zast.nodeid} out ztypes.tid is {
    cv: st.typing.nodeConstAt :nid
    if cv.kind.none then return ztypes.tid.zero
    path: nid
    {
        n: ast.nodes.get i: nid
        match n case call then path = n.callable else null
    }
    recvId: zast.nodeid
    nameId: zast.nameid
    {
        pn: ast.nodes.get i: path
        match (
            pn
        ) case dottedpath then {
            recvId = pn.parent
            nameId = zast.atomNameIdOf n: (ast.nodes.get i: pn.child)
        } else return ztypes.tid.zero
    }
    if (textFoldOp :nameId) == textfold.none then return ztypes.tid.zero
    rv: st.typing.nodeConstAt nid: recvId
    if rv.kind.svalKind.not or rv.numTid.notZero then return ztypes.tid.zero
    if cv.kind.ivalKind when cv.numTid.isZero then return st.reg.literalIntTid
    if cv.kind.svalKind when cv.numTid.isZero then return st.reg.literalTextTid
    if cv.kind.armKind then return cv.armTid
    if cv.kind.aggKind then return (st.typing.constAggs.get i: cv.aggId.u64).tid
    return ztypes.tid.zero
}

# markFoldedFnFieldCall -- a call through a function field of a folded data
# value names the function the field holds (the emitter's foldedFnRefC): the
# value at the callable's base is read for that field alone and reaches
# nothing.
markFoldedFnFieldCall: function {st: zenv.ZSymbolTable ast: Ast nid: zast.nodeid} is {
    callable: zast.nodeid
    {
        n: ast.nodes.get i: nid
        match n case call then callable = n.callable else return
    }
    baseId: zast.nodeid
    field: zast.nameid
    {
        cn: ast.nodes.get i: callable
        match (
            cn
        ) case dottedpath then {
            baseId = cn.parent
            field = zast.atomNameIdOf n: (ast.nodes.get i: cn.child)
        } else return
    }
    if field.isZero then return
    mono: st.typing.curMonoStamp
    bv: st.typing.nodeConstAt nid: baseId
    if bv.kind.aggKind.not then return
    if (st.typing.constAggs.get i: bv.aggId.u64).kind.staticData.not then return
    if (constAggField :st :ast v: bv nameId: field).kind.fnKind.not then return
    st.walk.wideConstTaken.set key: (ztyping.monostamp :mono node: baseId) value: 1
}

# markStaticListIndexRead -- a `blk.get K` the fold answered reads an element,
# a constant, and not the list's array: the list at its base reaches nothing.
# One the fold did not answer reads the array at run time, and the base's own
# use reaches it.
markStaticListIndexRead: function {st: zenv.ZSymbolTable ast: Ast.view nid: zast.nodeid} is {
    baseId: staticListIndexedAt :st :ast :nid
    if baseId.isZero then return
    mono: st.typing.curMonoStamp
    if (st.typing.nodeConstAt :nid).kind.none then return
    st.walk.wideConstTaken.set key: (ztyping.monostamp :mono node: baseId) value: 1
}

# staticListIndexedAt -- the base of a `blk.get i` call at `nid` whose base is
# a list reached by a compile-time path; 0 for any other node.
staticListIndexedAt: function {
    st: zenv.ZSymbolTable.view ast: Ast.view nid: zast.nodeid
} out zast.nodeid is {
    baseId: zast.nodeid
    {
        n: ast.nodes.get i: nid
        if n.call.not then return zast.nodeid
        cn: ast.nodes.get i: n.callable
        if cn.dottedpath.not then return zast.nodeid
        if (consteval.atomIsIndex :ast nid: cn.child).not then return zast.nodeid
        baseId = cn.parent
    }
    if (moves.listRowOfNode :st nid: baseId) == 0 then return zast.nodeid
    return baseId
}

# checkValueArmAt -- the arm dispatch: each handler takes its row as plain
# values, so no row view is held across the walk. Returns the resolved type id,
# or 0 when unhandled.
checkValueArmAt: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    nid: zast.nodeid
} out ztypes.tid is {
    arm: declare.rowArmAt :ast :nid
    match (
        arm
    ) case call then {
        cr: callRefAt :ast :nid
        return (checkCall :st :unitDecl :ast call: cr)
    } case dottedpath then {
        dr: dpRefAt :ast :nid
        return (checkDotted :st :unitDecl :ast dp: dr coerce: true)
    } case atomid then {
        ar: atomRefAt :ast :nid
        return (checkAtomid :st :unitDecl :ast node: ar)
    } case atomstring then {
        str: strRefAt :ast :nid
        return (declare.checkString :st :unitDecl :ast node: str)
    } case swapstmt then {
        sr: swapRefAt :ast :nid
        checkSwap :st :unitDecl :ast swapnode: sr
        return ztypes.tid.zero
    } case withexpr then {
        wr: withRefAt :ast :nid
        return (checkWith :st :unitDecl :ast withnode: wr)
    } case doexpr then {
        dr: doRefAt :ast :nid
        return (flow.checkDo :st :unitDecl :ast donode: dr)
    } case reassignment then {
        rr: reasgRefAt :ast :nid
        checkReassignment :st :unitDecl :ast rasgn: rr
        return ztypes.tid.zero
    } case caseexpr then {
        csr: caseRefAt :ast :nid
        return (flow.checkCase :st :unitDecl :ast casenode: csr)
    } case ifexpr then {
        ifr: ifRefAt :ast :nid
        return (flow.checkIf :st :unitDecl :ast ifnode: ifr)
    } case forexpr then {
        frr: forRefAt :ast :nid
        return (flow.checkFor :st :unitDecl :ast fornode: frr)
    } case labelvalue then {
        lvr: labelRefAt :ast :nid
        return (checkLabelValueAt :st :unitDecl :ast lv: lvr)
    } case listblock then {
        refuseBodyList :st :ast :nid
        return ztypes.tid.zero
    } else {
        return ztypes.tid.zero
    }
}

# refuseBodyList -- a list written in a function body. A list is a declaration,
# built once into static storage, so it is declared at unit level (or in an
# `as` block) and read by name.
refuseBodyList: function {st: zenv.ZSymbolTable ast: Ast.view nid: zast.nodeid} is {
    n: ast.nodes.get i: nid
    (
        addErrorWithHint
        :st
        nodeid: nid
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.typeError
        msg: "a list is declared at unit level, not in a function body".string
        note: String
        hint: "declare it at unit level, `codes: list { 9 10 }`, and read it by name".string
        width: 4
    )
}

# moveWithValue -- a `with` whose value is `used` and whose body reaches its
# end (`kind` none) hands out what the body yields: the value the `with` binds,
# when the body yields that (moveYieldedValue). Asked with the `with`'s scope
# still open.
moveWithValue: function {st: zenv.ZSymbolTable ast: Ast body: zast.nodeid used: bool kind: u8} is {
    if used when kind == zenv.divkind.none then moves.moveYieldedValue :st :ast valueNid: body
}

# noteStatementAutoCall -- the function or method named at `nid` without an
# argument list is called there, and `nid` is a statement's own value: a
# result the statement may discard (recordDiscard).
noteStatementAutoCall: function {st: zenv.ZSymbolTable nid: zast.nodeid} is {
    if nid == st.walk.stmtExprNid then st.typing.autoCallNodes.add item: nid
}

# recordTempHoldingLine -- a statement line that made unnamed locals ends: one a
# binding still locks keeps its temporary to the end of the block, so the line
# is recorded; the others are released with the statement. The names are
# dropped either way.
recordTempHoldingLine: function {st: zenv.ZSymbolTable lineId: zast.nodeid from: u64} is {
    held: false
    i: from
    for i < st.walk.lineUnnamedLocals.length loop {
        nm: st.walk.lineUnnamedLocals.get :i
        p: ListVal zast.nameid
        p.append nm
        if (st.isPathLocked path: p) then {
            held = true
            st.walk.heldTemps.append nm
        } else {
            st.typing.unheldTemps.add item: nm
            # it ends with the statement, and the locks it holds with it
            tv: st.lookupVarId nameId: nm
            if tv.some then releaseCascade :st holder: ztypes.zlockholder.var tv
        }
        i = i + 1
    }
    if held then st.typing.tempHoldingLines.add item: lineId
    for st.walk.lineUnnamedLocals.length > from loop st.walk.lineUnnamedLocals.pop
}

# walkDefinitionById -- walk the definition a RESOLVED ID names, wherever it
# lives. A unit is code layout: a path the parser follows to reach a definition,
# not a property of the walk. So the walk takes the definition -- the id IS the
# definition -- and reads its unit back off it for the one thing that needs one:
# the visibility context of the body being walked, where `un != unitDecl` is
# what makes a reference external. Deriving that from the CALLER instead would
# read a unit's use of its own private definitions as external access.
walkDefinitionById: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tid: ztypes.tid
} is {
    if tid.isZero then return
    dcl: st.typing.declIdOfType typeId: tid
    if dcl.isZero then return
    dnm: zast.nameid
    dv: st.typing.decls.get i: dcl
    dnm = dv.name
    dv.drop
    if dnm.isZero then return
    unTd: resolve.unitDeclOfTid reg: st.reg typing: st.typing :tid
    if unTd.isZero then return
    bodies.walkDeclaredDef :st scope: st.curScope :ast unitDecl: unTd declId: dcl
}


# checkReceiverOwnership -- a receiver may be `borrow` (the default) or `view` only:
# an object cannot own itself. Family-independent -- the ownership axis says
# nothing about valtype or reftype -- and a `lock` receiver is rejected the same
# way, a lock being a thing a caller holds rather than a thing a method takes.
checkReceiverOwnership: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    pm: argref
    pnid: zast.nodeid
    hasOwn: bool
    ownMode: ztypes.zparamownership
} is {
    # A receiver may be `borrow` (the default) or `view` only:
    # an object cannot own itself. Family-independent -- the
    # ownership axis says nothing about valtype or reftype.
    ownRecv: false
    if hasOwn then {
        if ownMode == ztypes.zparamownership.takeMode then ownRecv = true
        if ownMode == ztypes.zparamownership.holdMode then ownRecv = true
    }
    if ownRecv when (paramIsThisReceiver :ast op: (ast.nodes.get i: pm.operation)) then {
        orm: "take".string
        if hasOwn when ownMode == ztypes.zparamownership.holdMode then orm = "hold".string
        orln: nodeLine n: (ast.nodes.get i: pm.operation)
        orcl: nodeCol n: (ast.nodes.get i: pm.operation)
        msg: "Cannot use '.\{orm}' on a receiver — an object cannot own itself; a receiver is 'borrow' (the default) or 'view'"
        addError :st nodeid: pnid lineno: orln colno: orcl e: zast.err.ownerError :msg
    }
}

# lockReadonlyParam -- a readonly parameter (`view`, not owned, or `hold`, owned) is
# readonly for the whole body: it holds a readonly lock on itself, so writes,
# mutating receivers and re-passing to a mutable parameter are all caught by the
# ordinary lock rules. Both families -- a `view`/`hold` valtype is not a copy, so
# the lock is taken here rather than left to the emitter's ABI choice.
lockReadonlyParam: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    pm: argref
    pnid: zast.nodeid
    pnId: zast.nameid
    boundVid: ztypes.vid
} is {
    # A readonly parameter -- `view` (not owned) or `hold`
    # (owned) -- is readonly for the whole body: it holds a
    # readonly lock on itself, so writes, mutating receivers
    # and re-passing to a mutable parameter are all caught
    # by the ordinary lock rules. Ownership is a separate
    # axis and is carried by `own` above.
    #
    # Both families. A valtype leaf normally skips locking
    # -- the read is a copy, with no identity to protect --
    # but a `view`/`hold` valtype is not a copy: the lock is
    # what makes the marker mean anything, and it is taken
    # here rather than left to the emitter's ABI choice.
    vpp: ListVal zast.nameid
    vpp.append pnId
    vph: ztypes.zlockholder.var boundVid
    vpr: (
        st.tryLock
        pool: ast.names
        path: vpp.listView
        lockType: ztypes.zlockstate.shared
        lockScope: ztypes.zlockscope.target
        holder: vph
        mutable: false
    )
    if vpr.length > 0 then {
        (
            addError
            :st
            nodeid: pnid
            lineno: (nodeLine n: (ast.nodes.get i: pm.operation))
            colno: (nodeCol n: (ast.nodes.get i: pm.operation))
            e: zast.err.ownerError
            msg: vpr
        )
    }
}


# refuseNullTyped -- `null` is NOT a runtime value: it spells "no value" in a
# sum type's arm and undefines a member (`create: null`, `==: null`), and that
# is all. A parameter or field typed by it would be a slot holding something
# that does not exist, and the emitter has no C for it -- it wrote an undeclared
# `null` into the call and only the C compiler complained.
refuseNullTyped: function {
    st: zenv.ZSymbolTable
    tid: ztypes.tid
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    what: StringView
    name: StringView
} out bool is {
    if tid.isZero then return false
    if (st.reg.typetypeOf typeId: tid) != ztypes.ztypetype.nullType then return false
    mn9: "'null' cannot be the type of \{what} '\{name}' — null is not a runtime value"
    hn9: "null spells an arm that carries nothing (`none: null`) or undefines a member (`create: null`); for an optional value use a union or variant".string
    nn9: String
    (
        addErrorWithHint
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.typeError
        msg: mn9
        note: nn9
        hint: hn9
        width: name.length
    )
    return true
}

# foldedParamTid -- the type of a parameter declared by a value that folded
# (`n: 2 * 3`, `n: cfg.K`), which has no type-ref of its own: the type the fold
# registered on the function. 0 for any other parameter.
foldedParamTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    fnTid: ztypes.tid
    pm: argref
} out ztypes.tid is {
    if fnTid.isZero then return ztypes.tid.zero
    if (declaredByValue :st :ast ownerTid: fnTid node: pm.operation).not then return ztypes.tid.zero
    pmd: st.typing.declMemberIdOf parentTypeId: fnTid nameId: pm.name
    pvd: constValueOfDecl :st declId: pmd
    if pvd.kind.none then return ztypes.tid.zero
    fvo: (st.typing.declChildOfId parentTypeId: fnTid nameId: pm.name).or d: ztypes.tid.zero
    return fvo
}

# bindFunctionParam -- bind one declared parameter into the body's scope: its type,
# its ownership (a receiver may be `borrow` or `view` only -- an object cannot own
# itself), its locks, and the readonly and privacy gates its type expression
# carries. A template's own bare param has no stamp, so it binds the canonical
# param tid off the FUNCTION child instead.
bindFunctionParam: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    rf: ztypes.declid
    pm: argref
    thisName: StringView
    isGenDef: bool
    fnTid: ztypes.tid
} is {
    # every value form a parameter may be declared by, an `if` or a `match`
    # included, keys the parameter's variable
    pnid: zast.nodeIdOf n: (ast.nodes.get i: pm.operation)
    ptid: paramTypeId :st :ast :unitDecl opNid: pm.operation
    if st.walk.curMonoFnTid.notZero then {
        # per-mono instance walk: the mono FUNCTION child
        # carries the substituted param type
        mpo: st.typing.declChildOfId parentTypeId: st.walk.curMonoFnTid nameId: pm.name
        if mpo.some then {
            ptid = mpo
        }
    }
    # a template's own bare param carries no stamp; bind the canonical param tid
    # from the FUNCTION child so the walk types it
    if ptid.isZero when isGenDef when fnTid.notZero then {
        paramChild: st.typing.declChildOfId parentTypeId: fnTid nameId: pm.name
        if paramChild.some when (
            (st.reg.typetypeOf typeId: paramChild) == ztypes.ztypetype.genericParam
        ) then {
            ptid = paramChild
        }
    }
    fpt: foldedParamTid :st :ast :fnTid :pm
    if fpt.notZero then ptid = fpt
    if ptid.isZero when (unitRootedPath :st :ast scope: rf node: pm.operation) then {
        # an arm default through a unit (`m: math.roundingmode.toZero`) names no
        # type its node can give: it has the type registerValueParam recorded
        ptid = (st.typing.declChildOfId parentTypeId: fnTid nameId: pm.name).or d: ztypes.tid.zero
    }
    # a parameter whose type-ref named nothing was reported where it is written
    # (refusedValues): it binds with no type, as a read of a field declared so
    # has none (memberTyperefRefused)
    if st.typing.errors.length > 0 when (st.typing.refusedValues.has item: pm.operation) then {
        ptid = ztypes.tid.zero
    }
    if ptid.notZero then {
        (
            refuseNullTyped
            :st
            tid: ptid
            nodeid: pm.nid
            lineno: pm.lineno
            colno: pm.colno
            what: "parameter"
            name: (zast.nameTextAt :ast ref: pm.name).stringView
        )
    }
    if ptid.notZero then {
        noSt: (st.walk.noStampNode.get key: pnid).or d: false
        if noSt.not then {
            ppre: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: pnid
            if ppre.isZero then {
                setpp: ptid
                stampGate :st nid: pnid tid: setpp
            }
        }
    }
    if thisName.length > 0 when (
        paramIsThisReceiver
        :ast
        op: (ast.nodes.get i: pm.operation)
    ) then {
        thOpt: bodies.walkLookupTyperef :st scope: rf :ast :unitDecl base: thisName
        if thOpt.some then {
            ptid = thOpt
        }
    }
    pown: declare.pathOwnership :ast n: (ast.nodes.get i: pm.operation)
    hasOwn: false
    ownMode: ztypes.zparamownership.borrowMode
    if pown.some then {
        hasOwn = true
        ownMode = pown
    }
    checkReceiverOwnership :st :ast :pm :pnid :hasOwn :ownMode
    own: ownershipOfParam o: (declare.pathOwnership :ast n: (ast.nodes.get i: pm.operation))
    isRoP: false
    if pown.some then {
        if pown == ztypes.zparamownership.viewMode then isRoP = true
        if pown == ztypes.zparamownership.holdMode then isRoP = true
    }
    paramVid: st.reg.newVariable ztypeId: ptid ownership: own
    if (
        typeExprHasPrivate
        :ast
        n: (ast.nodes.get i: pm.operation)
    ) then st.reg.setVariablePrivate id: paramVid
    pnId: pm.name
    st.defineVar nameId: pnId vid: paramVid
    if isRoP then lockReadonlyParam :st :ast :pm :pnid :pnId boundVid: paramVid
    st.typing.setDefVariable nid: pnid vid: paramVid
    st.reg.setVariableOrigin id: paramVid origin: ztypes.zvarorigin.param
}


# noteMonoSite -- the first call that instantiates `mono`, a generic function's
# call or a generic type's construction: an error in the instance names it.
noteMonoSite: function {
    st: zenv.ZSymbolTable
    mono: ztypes.tid
    call: callref
    unitDecl: ztypes.declid
} is {
    if mono.isZero or (st.walk.monoSite.has key: mono) then return
    ms: ztyping.monosite lineno: call.lineno colno: call.colno :unitDecl
    st.walk.monoSite.set key: mono value: ms
}

# recordMonoRef -- a type application resolved to `mono`: its node `nid` is
# stamped with it, and an instance a TYPE names -- a field, a signature, an
# annotation -- is sited at the application's head, as a call's or a
# construction's instance is (noteMonoSite), unless an earlier one sited it.
recordMonoRef: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    mono: ztypes.tid
    nid: zast.nodeid
    at: zast.nodeid
    unitDecl: ztypes.declid
} is {
    if nid.notZero then ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: mono
    if mono.isZero or (st.walk.monoSite.has key: mono) then return
    n: ast.nodes.get i: at
    ms: ztyping.monosite lineno: (nodeLine :n) colno: (nodeCol :n) :unitDecl
    st.walk.monoSite.set key: mono value: ms
}

# recordSuffixDecl -- name the conversion member a numeric suffix selects. The
# suffix leg returns before member resolution, so nothing else stamps the dotted
# node and an editor asking what `u8` in `65.u8` refers to has no answer at all.
# Same table as recordLiteralDecl, for the same reason.
recordSuffixDecl: function {
    st: zenv.ZSymbolTable
    nid: zast.nodeid
    tid: ztypes.tid
    nameId: zast.nameid
} is {
    cdl: st.typing.declFindChild parentDeclId: (st.typing.declIdOfType typeId: tid) :nameId
    if cdl.isZero then return
    st.typing.toolRefDecl.set key: nid value: cdl
}


# constantOperandType -- type one operand of a unit-level constant expression,
# stamping as it walks: a numeric literal wears the pseudo id (folded to its
# visible default later), a name reads an already-materialised constant from
# resolved (body order), a binop takes the first concretely-typed operand
# (else the literal pseudo), and a compile-time `if` -- the value of an
# `else if` -- its selected branch's type. 0 = not a constant shape.
constantOperandType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
} out ztypes.tid is {
    # the row is read through a view scoped to this block (2 atomid, 3 infix,
    # 0 anything else): the lookups and operand walks below lend ast
    # exclusively
    kind: zast.nodekind.placeholder
    isConversion: false
    isOperator: false
    nameId: zast.nameid
    lhsId: zast.nodeid
    rhsId: zast.nodeid
    opId: zast.nodeid
    {
        n: ast.nodes.get i: nid
        kind = zast.kindOf :n
        match (
            n
        ) case atomid then {
            nameId = n.name
        } case dottedpath then {
            # a numeric conversion (`10.u64`, `N.u8`) has the type it names,
            # which is what it folds to
            cn: atomNameId :ast n: (ast.nodes.get i: n.child)
            if (isScalarNameId id: cn) then {
                isConversion = true
                nameId = cn
            }
        } else null
        # AN INFIX CALL IS THE OPERATOR SHAPE THIS WALK ALREADY UNDERSTANDS.
        # `a op b` parses to the call form, and a unit-level constant built
        # from one folds exactly as the same expression written any other way.
        if kind.atomid.not when kind.ifexpr.not when isConversion.not then {
            ip: operatorPartsAt :ast :nid
            if ip.found then {
                isOperator = true
                lhsId = ip.lhs
                rhsId = ip.rhs
                opId = ip.operator
            }
        }
    }
    if kind.atomid then return (constantAtomType :st :scope :ast :unitDecl :nid :nameId)
    if isOperator then return (constantBinopType :st :scope :ast :unitDecl :nid :lhsId :rhsId :opId)
    if kind.ifexpr then return (constantIfType :st :scope :ast :unitDecl :nid)
    if isConversion then return (scalarTidOf :st :scope :ast :nameId)
    return ztypes.tid.zero
}

# constantAtomType -- a bare atom's constant type: a numeric literal's
# literal type, else the type the name resolves to; stamped on the atom.
constantAtomType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
    nameId: zast.nameid
} out ztypes.tid is {
    result: ztypes.tid
    trN: zast.nameTextCopy :ast ref: nameId
    if (isNumericLiteralName name: trN.stringView) then {
        result = literalTidOfLexeme :st lex: trN.stringView
    } else {
        # a template's numeric generic parameter types by its bound, where a
        # lookup would find its declaration as a name
        npOwn: numericParamOwnerFrom :st :scope :nameId
        if npOwn.notZero then {
            cdN: st.reg.genericParamConstraintOf tdecl: npOwn paramName: nameId
            result = numericBoundTid :ast :st :scope cd: cdN
        } else {
            ro: bodies.walkLookupTyperef :st :scope :ast :unitDecl base: trN.stringView
            if ro.some then {
                result = ro
            }
        }
    }
    if result.notZero then {
        ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: result
    }
    return result
}

# constantBinopType -- a binop's constant type: a comparison is bool and a
# literal operand coerces (restamps) at the concrete side's type; otherwise
# the operands' type, a concrete side winning over a literal one.
constantBinopType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
    lhsId: zast.nodeid
    rhsId: zast.nodeid
    opId: zast.nodeid
} out ztypes.tid is {
    lt: constantOperandType :st :scope :ast :unitDecl nid: lhsId
    rt: constantOperandType :st :scope :ast :unitDecl nid: rhsId
    if (isComparisonOp nameId: (atomNameId :ast n: (ast.nodes.get i: opId))) then {
        return (constantCompareType :st :ast :nid :lhsId :rhsId :lt :rt)
    }
    result: lt
    if lt.isZero then result = rt
    # a literal on the left takes a typed right operand's type; between two
    # literals the left one's default governs
    if (isLiteralTypeId reg: st.reg tid: lt) when rt.notZero when (
        isLiteralTypeId
        reg: st.reg
        tid: rt
    ).not then result = rt
    if result.notZero then {
        ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: result
    }
    return result
}

# constantCompareType -- a comparison condition: the result is bool and a
# literal operand coerces (restamps) at the concrete side's type.
constantCompareType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    nid: zast.nodeid
    lhsId: zast.nodeid
    rhsId: zast.nodeid
    lt: ztypes.tid
    rt: ztypes.tid
} out ztypes.tid is {
    lLit: isLiteralTypeId reg: st.reg tid: lt
    rLit: isLiteralTypeId reg: st.reg tid: rt
    conc: ztypes.tid
    if lLit.not when lt.notZero then conc = lt
    if conc.isZero when rLit.not when rt.notZero then conc = rt
    if lLit when conc.notZero then {
        lid: nodeId n: (ast.nodes.get i: lhsId)
        if lid.notZero then {
            ztyping.nodeTypeSet tbl: st.typing.nodeType nid: lid tid: conc
        }
    }
    if rLit when conc.notZero then {
        rid: nodeId n: (ast.nodes.get i: rhsId)
        if rid.notZero then {
            setr: conc
            ztyping.nodeTypeSet tbl: st.typing.nodeType nid: rid tid: setr
        }
    }
    bres: ztypes.tid
    bo: stdtypes.stdTidOpt :ast :st wk: zast.wellKnown.slot.wkBool
    if bo.some then {
        bres = bo
        ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: bres
    }
    return bres
}

# constantLineType -- one statement line of a unit-level-if branch: the
# expression's constant type, stamped on the line and its value; a literal
# result materialises to its default (i64/f64).
# 0 when the line has no constant type.
constantLineType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    stmtId: zast.nodeid
    innerId: zast.nodeid
} out ztypes.tid is {
    bt0: constantOperandType :st :scope :ast :unitDecl nid: innerId
    mt0: ztypes.tid
    if (isLiteralTypeId reg: st.reg tid: bt0) then mt0 = (
        literalTypeDefaultTid
        :st
        :scope
        :ast
        t: bt0
    )
    if mt0.notZero then {
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: stmtId tid: mt0
        innerNid: nodeId n: (ast.nodes.get i: innerId)
        if innerNid.notZero then {
            ztyping.nodeTypeSet tbl: st.typing.nodeType nid: innerNid tid: mt0
        }
        return mt0
    } else {
        if bt0.notZero then {
            ztyping.nodeTypeSet tbl: st.typing.nodeType nid: stmtId tid: bt0
            return bt0
        }
    }
    return ztypes.tid.zero
}

# constantBranchWalk -- walk one unit-level-if branch block: each statement's
# expression types through the constant walk; literal results materialise to
# their defaults (i64/f64) on the statement and its value. Returns the (materialised) last-statement type.
constantBranchWalk: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
} out ztypes.tid is {
    # the block's line ids are read through views scoped to blocks: the
    # operand walk and the literal-default lookups lend ast exclusively
    isStmt: false
    lineIds: ListVal zast.nodeid
    {
        block: ast.nodes.get i: nid
        if block.statement then {
            isStmt = true
            for each s: (zast.kidsOf :ast span: block.statements) loop {
                lineIds.append from: s
            }
        }
    }
    if isStmt.not then return ztypes.tid.zero
    result: ztypes.tid
    for each stmtId: lineIds loop {
        innerId: zast.nodeid
        {
            s: ast.nodes.get i: stmtId
            if s.statementline then innerId = s.statementline
        }
        if innerId.notZero then {
            lt: constantLineType :st :scope :ast :unitDecl :stmtId :innerId
            if lt.notZero then result = lt
        }
    }
    return result
}

# unitifsite -- what the compile-time `if` walk reads of its own node: whether it
# IS one, and its else branch. The clause ids come back in the caller's list.
unitifsite: record {
    isIf: bool
    elseId: zast.nodeid
}

# appendKidIds -- a node span's child ids, appended to the caller's list. The
# list is the caller's so the ids outlive the view they were read through.
appendKidIds: function {ast: Ast.view span: zast.kidspan ids: ListVal zast.nodeid} is {
    ix: u64
    for ix < span.count loop {
        ids.append from: (zast.kidAt kids: ast.kids :span i: ix)
        ix = ix + 1
    }
}

# readUnitIf -- the node's shape and clause ids, read through a view scoped to
# this call because the walks that follow lend ast exclusively.
readUnitIf: function {
    ast: Ast.view
    nid: zast.nodeid
    clauseIds: ListVal zast.nodeid
} out unitifsite is {
    n: ast.nodes.get i: nid
    if n.ifexpr.not then return (unitifsite isIf: false elseId: zast.nodeid)
    appendKidIds :ast span: n.clauses ids: clauseIds
    return (unitifsite isIf: true elseId: n.elseclause)
}

# readIfClause -- one clause's condition ids, and the branch it guards. A zero
# answer means the node is not a clause: the parser interns every clause's
# statement, so a real one never reads zero.
readIfClause: function {
    ast: Ast.view
    clauseId: zast.nodeid
    condIds: ListVal zast.nodeid
} out zast.nodeid is {
    clause: ast.nodes.get i: clauseId
    if clause.ifclause.not then return zast.nodeid
    appendKidIds :ast span: clause.conditions ids: condIds
    return clause.statement
}

# walkClauseConditions -- every condition operand walks through the constant
# machinery, which is what stamps a comparison bool and coerces its literals.
walkClauseConditions: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    condIds: (ListVal zast.nodeid).view
} is {
    for each condId: condIds loop {
        opId: zast.nodeid
        cond: ast.nodes.get i: condId
        if cond.namedoperation then opId = cond.operation
        if opId.notZero then {
            constantOperandType :st :scope :ast :unitDecl nid: opId
        }
    }
}

# takeBranchType -- the running answer after one walked branch. Every branch is
# walked and typed -- a dead branch's type errors are still type errors -- but
# the definition takes the type of the branch that WINS and of no other, per the
# spec's "the type of the first arm whose condition is true". A dead branch's
# type never stands in for a winner the walk could not type: a string winner
# after an f64 branch is a string, typed from the value it yields.
takeBranchType: function {
    winner: ztypes.tid
    bt: ztypes.tid
    stmtId: zast.nodeid
    fb: ztyping.foldedbranch
} out ztypes.tid is {
    if fb.known when stmtId == fb.stmt then return bt
    return winner
}

# resolveUnitIfDef -- a unit-level `if` definition (compile-time conditional):
# its conditions and branches walk, and the If is stamped with the type of the
# value the fold selects -- the constant's own type, which the fold registers.
# Nothing is stamped when the fold selects nothing: the definition is refused
# on its door.
resolveUnitIfDef: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
} is {
    constantIfType :st :scope :ast :unitDecl :nid
    t: selectedValueType :st :scope :ast :unitDecl :nid
    if t.notZero then {
        ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: t
    }
}

# selectedValueType -- the type of the value a DEFINITION's compile-time `if`
# yields, read off the fold. Asked of the definition alone and never of an `if`
# nested in one of its branches: evaluating a branch the fold did not select
# would reach an `error` the spec promises stays silent.
selectedValueType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
} out ztypes.tid is {
    fb: foldIfBranch :st :scope :ast :unitDecl :nid
    if fb.known.not then return ztypes.tid.zero
    if fb.stmt.isZero then return ztypes.tid.zero
    v: constBlockValue :st :scope :ast :unitDecl nid: fb.stmt
    return (constValueTid :st :scope :ast :v)
}

# constantIfType -- the constant type of a compile-time `if`: conditions walk
# through the constant machinery (comparisons stamp bool and coerce literal
# operands), every branch walks and materialises, and the answer is the type
# of the branch the fold selects, stamped on the If. 0 when the fold selects
# nothing or the selected branch is a shape the walk does not type.
constantIfType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
} out ztypes.tid is {
    clauseIds: ListVal zast.nodeid
    site: readUnitIf :ast :nid :clauseIds
    if site.isIf.not then return ztypes.tid.zero
    fb: foldIfBranch :st :scope :ast :unitDecl :nid
    t: ztypes.tid
    for each clauseId: clauseIds loop {
        condIds: ListVal zast.nodeid
        stmtId: readIfClause :ast :clauseId :condIds
        if stmtId.notZero then {
            walkClauseConditions :ast :st :unitDecl :scope :condIds
            bt: constantBranchWalk :st :scope :ast :unitDecl nid: stmtId
            t = takeBranchType winner: t :bt :stmtId :fb
        }
    }
    if site.elseId.notZero then {
        et: constantBranchWalk :st :scope :ast :unitDecl nid: site.elseId
        t = takeBranchType winner: t bt: et stmtId: site.elseId :fb
    }
    if t.notZero then {
        ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: t
    }
    return t
}

# constFailClear -- drop any pending failure. Called before a pull that will
# render, and after one that will not, so a failure recorded for a body branch
# can never be attributed to the next definition.
constFailClear: function {st: zenv.ZSymbolTable} is {
    st.walk.constFail = ztypes.noConstFail
}

# reportPendingConstFail -- render the recorded failure, if any, and clear it.
# Only a caller that REQUIRED a value calls this: a unit-level definition. A
# body fold never does, which is what keeps an unfoldable
# body condition an ordinary runtime branch instead of an error.
reportPendingConstFail: function {st: zenv.ZSymbolTable} is {
    f: st.walk.constFail
    if f.kind.none then return
    constFailClear :st
    consteval.renderConstFail :st :f
}

# constLiteralBig -- an integer literal read exactly, in any radix the lexer
# accepts: its digits, `_` aside, through a BigInt. none past the 512 bits an
# untyped integer holds, or for a lexeme that is not an integer literal.
constLiteralBig: function {lex: StringView.view} out Option math.BigInt is {
    neg: lex.startsWith "-"
    i: u64
    if neg then i = 1
    base: literalRadix :lex at: i
    if base != 10 then i = i + 2
    digits: String
    for i < lex.length loop {
        b: (lex.byteAt :i).or d: 0
        i = i + 1
        # 95 is `_`, a separator that carries no value
        if b != 0c_ then digits.appendByte :b
    }
    if digits.length == 0 then return (Option math.BigInt).none
    r: math.BigInt.parse text: digits.stringView :base
    match (
        r
    ) case ok then {
        v: r.take
        if v.bitLength > untypedIntBits then return (Option math.BigInt).none
        if neg then return ((Option math.BigInt).some v.neg)
        return ((Option math.BigInt).some v)
    } case err then {
        return (Option math.BigInt).none
    }
}

# literalRadix -- the base an integer lexeme's digits are in, read from the
# prefix at `at`: `0x` 16, `0o` 8, `0b` 2, and 10 without one.
literalRadix: function {lex: StringView.view at: u64} out u64 is {
    if ((lex.byteAt i: at).or d: 0) != 0c0 then return 10
    # the letter after the leading 0
    p: (lex.byteAt i: at + 1).or d: 0
    if p == 0cx then return 16
    if p == 0co then return 8
    if p == 0cb then return 2
    return 10
}

# untypedIntBits -- the magnitude an untyped integer constant holds, in bits:
# wide enough for every intermediate of the fixed types up to 512 bits
untypedIntBits: 512.u64

# scalarTidOf -- the system scalar type the name `nameId` spells, found as a
# constant's registered type is: resolved on discovery from the system unit, so
# a fold never waits on another reference having reached it.
scalarTidOf: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    nameId: zast.nameid
} out ztypes.tid is {
    if nameId.isZero then return ztypes.tid
    return (resolve.descendNamedId :st :scope :ast unitDecl: st.typing.systemUnitRoot :nameId)
}

# constOfMatch -- a compile-time `match`: the subject folds to an arm constant
# or a choice value, and the value is the selected arm's, as an `if`'s is its
# selected branch's, typed by that arm alone. Inside the arm a choice value's
# subject, named bare, reads the value the arm carries, as a body's narrowing
# does. The arms are checked as a body checks them, and only
# the selected arm is evaluated, so a dead one may reach an `error` the program
# never runs. A refusal is RECORDED for the caller that required the value: a
# use site never asks.
constOfMatch: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out ztypes.cval is {
    cr: caseRefAt :ast :nid
    if cr.nid.isZero then return ztypes.noConst
    sv: evalConstNode :st :scope :ast :unitDecl nid: cr.subject
    if sv.kind.none then return ztypes.noConst
    # a choice value selects its arm as an arm constant does; the value it
    # carries is what the subject's name reads inside that arm
    payload: ztypes.noConst
    if sv.kind.aggKind then {
        g: st.typing.constAggs.get i: sv.aggId.u64
        if g.kind.staticChoice then {
            payload = st.typing.constAggItems.get i: g.itemStart.u64
            sv = ztypes.makeArmConst armTid: g.tid armName: g.arm
        }
    }
    if sv.kind.armKind.not then {
        stn: specWrittenName :st :ast tid: (constValueTid :st :scope :ast v: sv)
        sm: "match subject must be a union, variant, or generic parameter, got '\{stn}'"
        sn: ast.nodes.get i: cr.subject
        (
            consteval.constFailMismatch
            :st
            nid: cr.subject
            ln: (nodeLine n: sn)
            co: (nodeCol n: sn)
            msg: sm.stringView
        )
        return ztypes.noConst
    }
    stmt: consteval.constMatchArm :st :ast :cr subject: sv
    if stmt.isZero then return ztypes.noConst
    sn: atomNameId :ast n: (ast.nodes.get i: cr.subject)
    narrows: payload.isConst and sn.notZero
    if narrows then {
        st.walk.constNarrows.append (ztyping.constnarrow name: sn value: payload)
    }
    r: constBlockValue :st :scope :ast :unitDecl nid: stmt
    if narrows then {
        st.walk.constNarrows.pop
    }
    return r
}

# constOwnerDeclFor -- the DECLARATION a constant named `defName` is a member
# of. A name written inside a namespace resolves against that namespace first
# and falls back to the file unit, which is the chain spec.pdoc describes for an
# inline unit. The TYPE and VALUE channels must agree about this, so both ask
# here rather than each deciding for itself -- and both facts the fold needs,
# the owner's type id and the constant's own def node, come off this one answer.
constOwnerDeclFor: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
} out ztypes.declid is {
    dn9: zast.poolFind pool: ast.names text: defName
    return (constOwnerDeclForId :st :scope :unitDecl nameId: dn9)
}

# constOwnerDeclForId -- the walk itself, asked BY ID. A caller that already
# holds the name id -- a use site does, the atom carries it -- would otherwise
# pay a pool search to hand over text this reduces straight back to an id.
constOwnerDeclForId: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    # A TYPE IS A SCOPE for the expressions written at its level -- an `as`
    # constant, a field's default -- and for its methods' bodies. Its `as` and
    # `is` members are one scope, asked before the scopes enclosing it, and a
    # member written later is found as a unit's later constant is.
    own: enclosingTypeDeclOf :st :scope
    if own.notZero when (st.typing.declFindChild parentDeclId: own :nameId).notZero then return own
    # the scopes innermost outward from `scope`: a constant written inside
    # a unit is keyed on THAT unit, and on each unit enclosing it before the
    # file unit. Asking only the innermost left a constant of an enclosing
    # inline unit unreachable from a unit nested inside it.
    dnm: nameId
    cur: typeargs.scopeFor typing: st.typing :scope :unitDecl
    for cur.notZero loop {
        if cur == st.typing.coreUnitRoot then {
            cur = ztypes.declid
        } else {
            nd: st.typing.declFindChild parentDeclId: cur nameId: dnm
            if nd.notZero then {
                ct: st.typing.declTypeOf declId: cur
                if ct.notZero then return cur
            }
            cur = resolve.unitScopeOf typing: st.typing declId: (st.typing.declParentOf declId: cur)
        }
    }
    # CORE IS THE ROOT SCOPE, and the scope chain does not run through it -- it
    # ends at the file unit. A name the chain does not declare may still be
    # core's, and core's constants are constants like any other: `false` is
    # `bool.false`, an arm constant over bool's type. Asked last, so anything a
    # nearer scope declares still shadows it, which is what lets a program
    # rebind `false` and be believed.
    cr: st.typing.coreUnitRoot
    if cr.notZero then {
        cnd: st.typing.declFindChild parentDeclId: cr nameId: dnm
        if cnd.notZero then {
            cct: st.typing.declTypeOf declId: cr
            if cct.notZero then return cr
        }
    }
    # nothing in the chain declares it: the file unit owns it, which is where a
    # constant reached before its own declaration was indexed is keyed
    return unitDecl
}

# constDefIsComputed -- the definition COMPUTES a value from others, as against
# the ALIAS forms (`Same: Holder`, `astnode: zast.astnode`) which name a type and are
# resolveDef's business. Only a computed definition can be self-referential in
# the constant sense: a ring of aliases is an alias cycle, and the resolver
# already reports that with its own diagnostic and its own wording.
constDefIsComputed: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    # the definition's value
    nid: zast.nodeid
} out bool is {
    # `X: X + 1` computes, and so does a data value built from others (`a:
    # (inner v: b.v)`), a list (`a: list { 1 a.0 }`) and a function's call
    callableId: zast.nodeid
    {
        n: ast.nodes.get i: nid
        if (operatorPartsAt :ast :nid).found or n.listblock then return true
        if n.call then callableId = n.callable
    }
    if callableId.isZero then return false
    if (staticCtorHead :st :scope :ast :unitDecl :callableId).notZero then return true
    # a function's call computes from its arguments too (`foo: bar foo`)
    return (calleeFnTid :st :scope :ast :unitDecl :callableId).notZero
}

# constOfUnitMember -- `unit.CONST`: a constant read out of the unit `ptId`
# names, found where its type-refs are: the unit's root, or its public block
# when the block defines it.
constOfUnitMember: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    ptId: zast.nameid
    ncId: zast.nameid
} out ztypes.cval is {
    ud: resolve.unitWrittenAt :st :scope nameId: ptId
    owner: qualifiedMemberScope :st unitRoot: ud memberId: ncId
    return (constValueOfMemberId :st scope: owner :ast unitDecl: ud nameId: ncId)
}

# constValueOfMemberTidId -- the memoised compile-time value of a member of the
# unit whose type id is `unitTid`. A nested namespace has no unit-name index
# entry to reach it through, but resolveNamespaceUnit has already evaluated its
# members against this id, so the read is a pure lookup rather than a descent.
# Asked by the member's name id.
constValueOfMemberTidId: function {
    # the tree the constant's expression is read from
    ast: Ast
    # the symbol table holding the constant-evaluation state
    st: zenv.ZSymbolTable
    # the unit type the member belongs to
    unitTid: ztypes.tid
    # the member's name id
    nameId: zast.nameid
} out ztypes.cval is {
    if unitTid.isZero then return ztypes.noConst
    nid: nameId
    if nid.isZero then return ztypes.noConst
    # a template's constant read while one of its instantiations is walked is
    # that instantiation's (activeConstMono); the memo and the value are its
    readTid: unitTid
    unitD: templateDeclOf reg: st.reg typing: st.typing tid: unitTid
    if (st.reg.genericParamCountOf tdecl: unitD) > 0 then {
        am: activeConstMono :st ownerDecl: unitD
        if am.notZero then readTid = am
    }
    k: st.typing.memberConstKey parentTypeId: readTid nameId: nid
    sg: st.walk.constEvalState.get key: k
    if sg.some when sg.done then return (st.typing.memberConstOf parentTypeId: readTid nameId: nid)
    # not folded yet -- READING a constant is what folds it, so descend into
    # the owner's declaration and fold there, then read back. Without this a
    # constant that names another unit's constant sees a memo that nothing
    # filled.
    od: st.typing.declIdOfType typeId: unitTid
    if od.isZero then od = templateDeclOf reg: st.reg typing: st.typing tid: unitTid
    if od.isZero then return ztypes.noConst
    cd: st.typing.declFindChild parentDeclId: od nameId: nid
    if cd.isZero then return ztypes.noConst
    constFoldDecl :st :ast declId: cd
    return (st.typing.memberConstOf parentTypeId: readTid nameId: nid)
}

# constValueOfMember -- the compile-time value of `unitDecl.defName`, evaluated
# on demand and memoised in memberConst. constEvalState carries the cycle
# guard: re-entering a member that is still evaluating is `A: B + 1` paired
# with `B: A + 1`, which has no value and must say so once rather than recur.
constValueOfMember: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
} out ztypes.cval is {
    dn9: zast.poolFind pool: ast.names text: defName
    return (constValueOfMemberId :st :scope :ast :unitDecl nameId: dn9)
}

# constFoldOpen -- whether the constant `nameId`, as `scope` in `unitDecl` names
# it, is being evaluated now, further up the stack
constFoldOpen: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out bool is {
    if nameId.isZero then return false
    od: constOwnerDeclForId :st :scope :unitDecl :nameId
    if od.isZero then return false
    utid: st.typing.declTypeOf declId: od
    if utid.isZero then return false
    em: activeConstMono :st ownerDecl: od
    if em.notZero then utid = em
    sg: st.walk.constEvalState.get key: (st.typing.memberConstKey parentTypeId: utid :nameId)
    match (
        sg
    ) case some then {
        return sg.evaluating
    } case none then return false
}

# constValueOfMemberId -- the same pull, asked BY ID. The name is a pool id
# everywhere it matters: the owner walk compares ids, the child lookup compares
# ids, and the memo is keyed on one. Only a cycle diagnostic ever wants the
# text, and it reads it where it reports.
constValueOfMemberId: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nameId: zast.nameid
} out ztypes.cval is {
    nid: nameId
    if nid.isZero then return ztypes.noConst
    od: constOwnerDeclForId :st :scope :unitDecl :nameId
    if od.isZero then return ztypes.noConst
    # the constant's own declaration is the owner's child of that name, so the
    # def node comes off the same walk that found the owner. u32 because a node
    # id is one, and the binding's type IS its initializer.
    dnode: zast.nodeid
    cd: st.typing.declFindChild parentDeclId: od nameId: nid
    if cd.notZero then {
        cdo: st.typing.decls.get i: cd
        dnode = cdo.node
    }
    # a type member found in the type's scope is a value only when it is an
    # `as` item holding one; a field or a method stops the search with none
    if (declIsType :st declId: od) then {
        holds: typeMemberHoldsConstant :st :ast typeDecl: od defNode: dnode
        if holds.not then return ztypes.noConst
    }
    return (
        bodies.constValueOfMemberAt
        :st
        :ast
        :unitDecl
        ownerDecl: od
        nameId: nid
        defNodeId: dnode
    )
}

# declIsType -- the declaration is a type definition.
declIsType: function {st: zenv.ZSymbolTable.view declId: ztypes.declid} out bool is {
    if declId.isZero then return false
    d: st.typing.decls.get i: declId
    return d.kind.typeDecl
}

# unitMemberHoldsValue -- the unit `unitDecl` defines `nameId` as a value rather
# than a function, a type, a unit or a list: a constant, which the fold then
# evaluates. Read off the definition, so nothing resolves to answer.
unitMemberHoldsValue: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out bool is {
    md: st.typing.declFindChild parentDeclId: unitDecl :nameId
    if md.isZero then return false
    dn: (st.typing.decls.get i: md).node
    if dn.isZero then return false
    opId: zast.nodeid
    {
        n: ast.nodes.get i: dn
        if n.namedoperation then opId = n.operation
    }
    if opId.isZero then return false
    op: ast.nodes.get i: opId
    return (op.functiondef or op.objectdef or op.unitdef or op.listblock).not
}

# typeMemberHoldsConstant -- the member written at `defNode` is one of the type's
# `as` items holding a value: the only member of a type a constant can read. An
# `is` field belongs to each instance; a method, a generic parameter, a
# implementation label, the tag spec and an opt-out (`create: null`) are no value.
typeMemberHoldsConstant: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    typeDecl: ztypes.declid
    defNode: zast.nodeid
} out bool is {
    objId: zast.nodeid
    td: st.typing.decls.get i: typeDecl
    nop: ast.nodes.get i: td.node
    if nop.namedoperation then objId = nop.operation
    if objId.isZero then return false
    orf: declare.objRefAt :ast nid: objId
    i: u64
    for i < orf.nas loop {
        itemId: zast.objAsItemAt :ast nid: objId :i
        i = i + 1
        if itemId == defNode then {
            return (declare.asItemNamesNoValue :st :ast :typeDecl item: (argRefAt :ast nid: itemId)
            ).not
        }
    }
    return false
}

# activeConstMono -- the instantiation a constant of `ownerDecl` is evaluated
# for: the owner's own type when that is an instantiation, else the one a read
# is for (constMono) or the one being walked (curMonoStamp), or an instance
# owning either, when its template is the owner. 0 when the constant is the
# template's alone.
activeConstMono: function {st: zenv.ZSymbolTable.view ownerDecl: ztypes.declid} out ztypes.tid is {
    own: st.typing.declTypeOf declId: ownerDecl
    if own.isZero then return ztypes.tid
    if (st.reg.genericOriginOf tid: own).notZero then return own
    if (st.reg.genericParamCountOf tdecl: ownerDecl) == 0 then return ztypes.tid
    cm: instanceOfTemplateFrom :st mono: st.walk.constMono :ownerDecl
    if cm.notZero then return cm
    return (instanceOfTemplateFrom :st mono: (walkOwnerMono :st) :ownerDecl)
}

# instanceOfTemplateFrom -- `mono` when it instantiates the template `ownerDecl`
# declares, else the instance owning it that does: a nested unit's instance
# reads its enclosing unit's constants as that unit's instance. 0 when none does.
instanceOfTemplateFrom: function {
    st: zenv.ZSymbolTable.view mono: ztypes.tid ownerDecl: ztypes.declid
} out ztypes.tid is {
    m: mono
    for m.notZero loop {
        if (monoOfTemplate :st mono: m :ownerDecl) then return m
        m = st.reg.ownerTidOf tid: m
    }
    return ztypes.tid
}

# monoOfTemplate -- whether `mono` is an instantiation of the template
# `ownerDecl` declares.
monoOfTemplate: function {
    st: zenv.ZSymbolTable.view mono: ztypes.tid ownerDecl: ztypes.declid
} out bool is {
    if mono.isZero then return false
    origin: st.reg.genericOriginOf tid: mono
    if origin.isZero then return false
    return (st.typing.declIdOfType typeId: origin) == ownerDecl
}

# constBlockValue -- the value a branch block yields: its LAST statement's,
# the way constantBranchWalk takes the block's type from the last statement.
constBlockValue: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
} out ztypes.cval is {
    # the block's line ids are read through views scoped to blocks: each
    # line's evaluation lends ast exclusively
    isStmt: false
    lineIds: ListVal zast.nodeid
    {
        n: ast.nodes.get i: nid
        if n.statement then {
            isStmt = true
            for each s: (zast.kidsOf :ast span: n.statements) loop {
                lineIds.append from: s
            }
        }
    }
    if isStmt.not then return ztypes.noConst
    r: ztypes.noConst
    for each sId: lineIds loop {
        innerId: zast.nodeid
        {
            s: ast.nodes.get i: sId
            if s.statementline then innerId = s.statementline
        }
        if innerId.notZero then r = evalConstNode :st :scope :ast :unitDecl nid: innerId
    }
    return r
}

# foldIfCond -- one condition of a folding `if`: 1 = a plain guard that
# folds true, 2 = folds false, 0 = undecided (a labelled condition other
# than `when`, or a guard whose value is not a known truth arm), 3 = not a
# named condition at all (it says nothing).
foldIfCond: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    condId: zast.nodeid
} out u32 is {
    isGuard: false
    isOther: false
    opId: zast.nodeid
    {
        cond: ast.nodes.get i: condId
        if cond.namedoperation then {
            # a labelled condition other than `when` is not a plain guard, and
            # this fold does not speak for it
            if cond.name.notZero when cond.name != zast.wellKnown.slot.kwWhen then {
                isOther = true
            } else {
                isGuard = true
                opId = cond.operation
            }
        }
    }
    if isOther then return 0
    if isGuard.not then return 3
    return (foldTruth :st :scope :ast :unitDecl :opId)
}

# foldTruth -- the truth of the expression `opId` when it has a compile-time
# value: 1 = true, 2 = false, 0 = undecided.
foldTruth: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    opId: zast.nodeid
} out u32 is {
    cv: evalConstNode :st :scope :ast :unitDecl nid: opId
    # by the DISCRIMINATOR, not by arm position: a data-sourced tag names its
    # own values.
    fa: ztyping.sumPairFalsyArmOf ty: st.typing reg: st.reg tid: cv.armTid
    ta: ztyping.sumPairTruthyArmOf ty: st.typing reg: st.reg tid: cv.armTid
    held: u32
    if fa.notZero when cv.armName == fa then held = 2
    if ta.notZero when cv.armName == ta then held = 1
    # asked last: almost no condition has a value to doubt
    if held > 0 when (foldReadsLocal :st :ast :scope nid: opId) then return 0
    return held
}

# foldReadsLocal -- the expression at `nid` reads a name an open scope of `scope`
# defines, which is no constant whatever a unit definition of that name says. A
# condition folds BEFORE its walk, so the record evalConstNode asks of which atoms
# read a variable has nothing on it yet. A `scope` that is not a body's has no
# locals, so a unit-level fold answers the same during a body's walk.
foldReadsLocal: function {
    st: zenv.ZSymbolTable.view ast: Ast.view scope: ztypes.declid nid: zast.nodeid
} out bool is {
    work: ListVal zast.nodeid capacity: 16
    work.append nid
    wi: u64
    for wi < work.length loop {
        wid: work.get i: wi
        wi = wi + 1
        if wid.notZero then {
            wn: ast.nodes.get i: wid
            nm: zast.atomNameIdOf n: wn
            if (st.typing.declFindLocal :scope nameId: nm).notZero then return true
            # the member of a path is the root's to answer for
            if wn.dottedpath then {
                work.append from: wn.parent
            } else {
                zast.childIdsInto :ast n: wn acc: work
            }
        }
    }
    return false
}

# foldLoopPost -- the truth of one postcondition, as foldTruth answers it.
foldLoopPost: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    pcId: zast.nodeid
} out u32 is {
    opId: pcId
    pc: argRefAt :ast nid: pcId
    if pc.nid.notZero then opId = pc.operation
    return (foldTruth :st :scope :ast :unitDecl :opId)
}

# foldIfBranch -- which clause of an `if` the constant fold selects, stamped on
# the If so every consumer reads ONE answer instead of recomputing its own.
# A clause's conditions are read in the order they run: a true one is passed
# over, a false one loses the clause before anything after it is read, and one
# that does not fold stops the fold. The first winner takes it and the else
# clause is the fallback. `known` false means a condition that runs did not
# fold: this is a runtime `if` and nothing may be elided.
foldIfBranch: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
} out ztyping.foldedbranch is {
    # the clause and statement ids are read through views scoped to blocks:
    # the condition folds lend ast exclusively
    isIf: false
    clauseIds: ListVal zast.nodeid
    elseId: zast.nodeid
    {
        n: ast.nodes.get i: nid
        if n.ifexpr then {
            isIf = true
            for each c: (zast.kidsOf :ast span: n.clauses) loop {
                clauseIds.append from: c
            }
            elseId = n.elseclause
        }
    }
    known: true
    stmt: zast.nodeid
    if isIf.not then return (ztyping.foldedbranch known: false :stmt)
    decided: false
    for each clauseId: clauseIds loop {
        if decided.not then {
            isClause: false
            condIds: ListVal zast.nodeid
            stmtId: zast.nodeid
            {
                clause: ast.nodes.get i: clauseId
                if clause.ifclause then {
                    isClause = true
                    for each c: (zast.kidsOf :ast span: clause.conditions) loop {
                        condIds.append from: c
                    }
                    stmtId = clause.statement
                }
            }
            if isClause then {
                allTrue: true
                undecided: false
                for each condId: condIds loop {
                    v: foldIfCond :st :scope :ast :unitDecl :condId
                    if v == 0 then undecided = true
                    if v == 2 then allTrue = false
                    if undecided or allTrue.not then break
                }
                if undecided then {
                    known = false
                    decided = true
                } else {
                    if allTrue then {
                        stmt = stmtId
                        decided = true
                    }
                }
            }
        }
    }
    if decided.not then stmt = elseId
    fb: ztyping.foldedbranch :known :stmt
    # the branch is kept the way setNodeConst keeps a value
    foreign: st.typing.rowIsForeign :nid
    (
        ztyping.setAgreed
        shared: st.typing.foldedBranch
        :foreign
        :nid
        value: fb
    )
    return fb
}

# staticListMemberValue -- the value list row `row` holds under the member name
# `nameId`: a label first (an element may claim `length`), then the count,
# then an element named by its position (`blk.3`); `none` for any other name.
# An element is a value only when the list's elements are a builtin number or
# a string: `out byteid` makes each element a byteid, whose own `==` a fold of
# the bare integer would bypass. The count is never an element, and is always
# one.
staticListMemberValue: function {
    st: zenv.ZSymbolTable
    ast: Ast
    row: u32
    nameId: zast.nameid
} out ztypes.cval is {
    g: st.typing.constAggs.get i: row.u64
    folds: staticListElemFolds :ast :st elemTid: g.elem
    lp: st.typing.aggLabelPos id: row label: nameId
    if lp.some then {
        if folds.not then return ztypes.noConst
        return (st.typing.constAggItems.get i: g.itemStart.u64 + lp)
    }
    if nameId == zast.wellKnown.slot.wkLength then return (ztypes.makeIntConst g.itemCount)
    pos: (zast.nameTextAt :ast ref: nameId).stringView.parseU64
    match (
        pos
    ) case ok then {
        if folds when pos < g.itemCount then return (
            st.typing.constAggItems.get
            i: g.itemStart.u64 + pos
        )
    } case err then null
    return ztypes.noConst
}

# staticListElemFolds -- a list element of type `elemTid` reads as a constant: a
# builtin number, a string, an arm, a data value or a list. A typedef element
# is a value of its own type, whose own members a fold of the bare number
# would bypass.
staticListElemFolds: function {
    ast: Ast
    st: zenv.ZSymbolTable
    elemTid: ztypes.tid
} out bool is {
    if (numerics.isNumericTid :st tid: elemTid) then return true
    if (isStaticStringTid :ast :st tid: elemTid) then return true
    if (callchecks.typedefBaseOf :st tid: elemTid).notZero then return false
    return (isStaticMemberTid :st :ast tid: elemTid)
}

# isStaticStringTid -- a type a string literal can be held as in a static
# list: StringView, `text`, or the untyped textliteral.
isStaticStringTid: function {ast: Ast st: zenv.ZSymbolTable tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    if tid == st.reg.literalTextTid then return true
    if tid == (stdTid :ast :st wk: zast.wellKnown.slot.tyStringView) then return true
    return tid == (stdTid :ast :st wk: zast.wellKnown.slot.tyText)
}

# constArmRead -- `<typeName>.<armName>` looked up from `lookupUnit`, as a
# value. The parent's FAMILY decides, the same test resolveConstantDef uses to
# tell an arm read from a construction: variant or union means the child is an
# arm, and anything else is a member read a constant cannot hold.
constArmRead: function {
    ast: Ast
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    lookupUnit: ztypes.declid
    # the sum type's name id, resolved in `lookupUnit`
    typeNameId: zast.nameid
    # the arm's name id
    armNameId: zast.nameid
} out ztypes.cval is {
    ptid: typeNamedFrom :st :scope :ast :lookupUnit :typeNameId
    if ptid.isZero then return ztypes.noConst
    ptt: st.reg.typetypeOf typeId: ptid
    # another type's `as` constant (`cfg.LIMIT`), folded where it is declared
    ptd: templateDeclOf reg: st.reg typing: st.typing tid: ptid
    pmd: st.typing.declFindChild parentDeclId: ptd nameId: armNameId
    if pmd.notZero when (
        typeMemberHoldsConstant
        :st
        :ast
        typeDecl: ptd
        defNode: (st.typing.decls.get i: pmd).node
    ) then return (constValueOfMemberTidId :ast :st unitTid: ptid nameId: armNameId)
    isSum: ptt.isSum
    if isSum.not then return ztypes.noConst
    anm: armNameId
    # an arm the type does not declare is no value of it
    if (st.typing.declChildOfId parentTypeId: ptid nameId: anm).none then return ztypes.noConst
    if (armCarriesPayload :st armTid: ptid armName: anm) then return ztypes.noConst
    return (ztypes.makeArmConst armTid: ptid armName: anm)
}

# typeNamedFrom -- the type a constant's bare name `typeNameId` names, looked up
# from `lookupUnit`; 0 when it names none.
typeNamedFrom: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    lookupUnit: ztypes.declid
    typeNameId: zast.nameid
} out ztypes.tid is {
    # the type is looked up in `lookupUnit`'s scope -- `scope` itself when
    # it already lies inside that unit (a nested scope of it is nearer than
    # its root), else the unit's root
    rf: scope
    lro: lookupUnit
    if lro.notZero when (scopeIsWithin typing: st.typing scope: rf root: lro).not then rf = lro
    ptu: (
        (walkLookupTyperefById :st scope: rf :ast unitDecl: lookupUnit baseId: typeNameId).or
        d: ztypes.tid.zero
    )
    # the unit's own declaration of the name is the one meant, demanded or not:
    # the lookup answers only with what has resolved, so a `Box` of this unit
    # that nothing has used yet loses to the prelude's `Box`. Reading its
    # constant is a use, and descending below resolves it.
    ownDef: declOfUnitDef :st scope: rf unitDecl: lookupUnit nameId: typeNameId
    own: conform.aliasTargetDecl :st :ast aliasDecl: ownDef
    ptuDecl: templateDeclOf reg: st.reg typing: st.typing tid: ptu
    if ptu.notZero when own.notZero when ptuDecl != own then ptu = ztypes.tid.zero
    if ptu.isZero then {
        # a variant NOTHING ELSE mentions is not demanded, so the lookup finds
        # nothing and the arm read silently yields no value. Descending mints
        # it, which is what a use site would have done -- a constant reading an
        # arm IS a use of the type.
        ptu = resolve.descendNamedId :st scope: rf :ast unitDecl: lookupUnit nameId: typeNameId
    }
    return ptu
}

# checkConstantMethodShape -- each member read, method call and operator on a
# constant in a unit-level definition, checked the way a body checks it: the
# member on the value's type (constantMemberTid), and a string or option
# method's arguments against its declaration. The evaluator answers only "a
# value or none": an unknown member folded to `false`, a surplus argument or an
# unknown label folded anyway, and a missing argument or one of the wrong kind
# left no value and no reason, which the emitter then met. The reports are the
# body's own, so each shape reads as it does in a body; a receiver that is
# itself such a call is checked first. True when a report was
# made -- now or on an earlier ask of the same node -- which tells the caller
# the evaluator's own reason is not the one to show. Otherwise that reason is
# kept: the lookups below demand declarations, and a demanded constant clears
# the pending failure on its way in.
checkConstantMethodShape: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out bool is {
    held: st.walk.constFail
    reported: checkConstantMethodShapeAt :st :scope :ast :unitDecl :nid
    if reported.not then st.walk.constFail = held
    return reported
}

# constmethodsite -- where a member read or method call on a constant sits in
# the tree: the dotted path, its receiver, the member node naming the method,
# and the call when there is one (a bare `P.substring` is a dotted path and has
# none).
constmethodsite: record {
    # the dotted path naming the member
    pathId: zast.nodeid
    # the receiver node, 0 when the node is not a method call or read
    recvId: zast.nodeid
    # the member node naming the method
    childId: zast.nodeid
    # whether arguments were written, as a call
    isCall: bool
    # the call, when isCall
    call: callref
}

# constMethodSiteAt -- the method site at `nid`: a dotted path, or a
# non-infix call whose callable is one.
constMethodSiteAt: function {ast: Ast.view nid: zast.nodeid} out constmethodsite is {
    call: callRefAt :ast :nid
    pathId: zast.nodeid
    recvId: zast.nodeid
    childId: zast.nodeid
    isCall: false
    n: ast.nodes.get i: nid
    if n.dottedpath then {
        pathId = nid
        recvId = n.parent
        childId = n.child
    }
    if recvId.isZero when call.nid.notZero when call.infix.not then {
        cn: ast.nodes.get i: call.callable
        if cn.dottedpath then {
            pathId = call.callable
            recvId = cn.parent
            childId = cn.child
            isCall = true
        }
    }
    return (constmethodsite :pathId :recvId :childId :isCall :call)
}

# checkConstantMethodShapeAt -- checkConstantMethodShape's walk, which may
# leave the pending failure changed. An operator is asked about both operands
# and an `if` about the branch it selects.
checkConstantMethodShapeAt: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out bool is {
    if (st.walk.constShapesReported.has item: nid) then return true
    lhsId: zast.nodeid
    rhsId: zast.nodeid
    isIf: false
    {
        ipn: ast.nodes.get i: nid
        ip: operatorPartsAt :ast :nid
        if ip.found then {
            lhsId = ip.lhs
            rhsId = ip.rhs
        }
        isIf = ipn.ifexpr
    }
    if lhsId.notZero then {
        lr: checkConstantMethodShapeAt :st :scope :ast :unitDecl nid: lhsId
        rr: checkConstantMethodShapeAt :st :scope :ast :unitDecl nid: rhsId
        if lr or rr then return true
        return (checkConstantOperator :st :scope :ast :unitDecl :nid :lhsId)
    }
    if isIf then return (checkConstantIfBranchShape :st :scope :ast :unitDecl :nid)
    site: constMethodSiteAt :ast :nid
    if site.recvId.isZero then return (checkConstantFnCall :st :scope :ast :unitDecl :nid)
    # a receiver naming a unit (`io.print`) qualifies that unit's member, as
    # qualifierUnitDecl answers for every qualifier: it is no constant, and
    # asking it for one finds a definition of the same name instead -- the one
    # being folded, when that is `io: io.print`
    if (qualifierUnitDecl :st :scope :ast nid: site.recvId).notZero then return false
    inner: checkConstantMethodShapeAt :st :scope :ast :unitDecl nid: site.recvId
    if inner then return true
    errsBefore: st.typing.errors.length
    checkConstantMethodCall :st :scope :ast :unitDecl :site
    if st.typing.errors.length == errsBefore then return false
    st.walk.constShapesReported.add item: nid
    return true
}

# checkConstantOperator -- `a op b` is `a.op b`: the operator at `nid` is a
# member of the left operand `lhsId`, asked as a body asks it
# (constantMemberTid). True when a report was made.
checkConstantOperator: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
    lhsId: zast.nodeid
} out bool is {
    opIdN: (operatorPartsAt :ast :nid).operator
    call: callRefAt :ast :nid
    opSite: constmethodsite pathId: call.callable recvId: lhsId childId: opIdN isCall: true :call
    errsOp: st.typing.errors.length
    held: st.walk.constFail
    constFailClear :st
    lv: evalConstNode :st :scope :ast :unitDecl nid: lhsId
    st.walk.constFail = held
    # an operand with no value is the evaluator's to explain
    if lv.isConst then constantMemberTid :st :scope :ast :unitDecl site: opSite rv: lv
    if st.typing.errors.length == errsOp then return false
    st.walk.constShapesReported.add item: nid
    return true
}

# checkConstantFnCall -- a unit-level call of a function, its arguments checked
# as a body checks them (checkConstantCallArgs); an interpolated string, each
# part printable as a body's must be. True when a report was made.
checkConstantFnCall: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out bool is {
    errsBefore: st.typing.errors.length
    sr: strRefAt :ast :nid
    if sr.nid.notZero then {
        checkConstantInterpParts :st :scope :ast :unitDecl node: sr
    } else {
        call: callRefAt :ast :nid
        if call.nid.isZero or call.infix then return false
        fid: calleeFieldFnTid :st :scope :ast :unitDecl callableId: call.callable
        if fid.isZero then return false
        callchecks.checkConstantCallArgs :st :scope :ast :unitDecl :call :fid recvImplicit: false
    }
    if st.typing.errors.length == errsBefore then return false
    st.walk.constShapesReported.add item: nid
    return true
}

# checkConstantInterpParts -- each part of a unit-level interpolated string is
# printable, as a body's must be (reportNotPrintable): an interpolation has no
# compile-time value, and a part that could not print is the mistake to report.
checkConstantInterpParts: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    node: strref
} is {
    k: u64
    for k < node.nparts loop {
        partId: zast.stringPartAt :ast nid: node.nid i: k
        k = k + 1
        if (declare.rowArmAt :ast nid: partId).stringchunk.not then {
            held: st.walk.constFail
            constFailClear :st
            pv: evalConstNode :st :scope :ast :unitDecl nid: partId
            st.walk.constFail = held
            pt: constArgTid :st :scope :ast v: pv
            if pv.isConst when pt.notZero when (printableInterpTid :ast :st tid: pt).not then {
                moves.reportNotPrintable :st :ast :partId ptid: pt
            }
        }
    }
}

# checkConstantIfBranchShape -- a unit-level `if` is asked about the branch it
# selects, whose value is its last line's. A branch it does not select is never
# evaluated, so it is never asked about either.
checkConstantIfBranchShape: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out bool is {
    fb: foldIfBranch :st :scope :ast :unitDecl :nid
    if fb.known.not or fb.stmt.isZero then return false
    lastId: zast.nodeid
    bn: ast.nodes.get i: fb.stmt
    if bn.statement when bn.statements.count.u64 > 0 then {
        sId: zast.kidAt kids: ast.kids span: bn.statements i: bn.statements.count.u64 - 1
        sl: ast.nodes.get i: sId
        if sl.statementline then lastId = sl.statementline
    }
    if lastId.isZero then return false
    return (checkConstantMethodShapeAt :st :scope :ast :unitDecl nid: lastId)
}

# constantMemberTid -- the member at `site`, when its receiver has a
# compile-time value: the member a body finds on the value's type, an unknown
# one reported in the body's words. Asked whether the definition folded or not:
# the evaluator computes a value, and a value never decides what a name means
# -- an arm predicate on a name the type does not declare is no `false`. A
# static list's elements and labels are its own (listMemberType, which every
# position asks). The member's type is 0 when the receiver has no value, the
# member was reported, or it is a cast or an element, which take no arguments.
constantMemberTid: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    site: constmethodsite
    rv: ztypes.cval
} out constmember is {
    none: constmember recvTid: ztypes.tid.zero memberTid: ztypes.tid.zero
    methodId: atomNameId :ast n: (ast.nodes.get i: site.childId)
    if methodId.isZero then return none
    dp: dpRefAt :ast nid: site.pathId
    # a function's name has no value here, and its members are its type's
    if rv.kind.none then return (constantFnMember :st :scope :ast :unitDecl :site :dp :methodId)
    svT: constValueTid :ast :st :scope v: rv
    if svT.isZero then return none
    if rv.kind.aggKind when (st.typing.constAggs.get i: rv.aggId.u64).kind.staticList then {
        row: rv.aggId
        if (listMemberType :st :ast :row nameId: methodId).notZero then return none
        if (moves.listValueMember :st :ast :dp :row cnId: methodId).not then return none
    }
    # an untyped string's conversion (`"x".text`) is a cast, as in a body
    # (checkUntypedTextCast)
    if rv.kind.svalKind when rv.numTid.isZero when (textLiteralCastTarget :ast :st nameId: methodId
    ).notZero then return none
    svT = constantReceiverTid :st vt: svT v: rv
    shown: svT
    svT = typedefMemberOwner :st :ast bt: svT cnId: methodId
    forceMemberOf :st :ast parentTypeId: svT nameId: methodId
    mo: st.typing.declChildOfId parentTypeId: svT nameId: methodId
    if mo.none then {
        reportUnknownMemberAs :st :ast :dp bt: svT cnId: methodId :shown
        return none
    }
    return (constmember recvTid: svT memberTid: mo)
}

# constantReceiverTid -- the type a constant's member is looked up on, as a
# body looks it up: an untyped number's literal type, and any other value's own
# type `vt` (constValueTid) -- an untyped string's is textliteral.
constantReceiverTid: function {
    st: zenv.ZSymbolTable vt: ztypes.tid v: ztypes.cval
} out ztypes.tid is {
    if v.numTid.notZero then return vt
    if v.kind.ivalKind then return st.reg.literalIntTid
    if v.kind.fvalKind then return st.reg.literalFloatTid
    return vt
}

# constantFnMember -- constantMemberTid for a receiver that names a function,
# which has no value at unit level: the member on the function's type
constantFnMember: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    site: constmethodsite
    dp: dpref
    methodId: zast.nameid
} out constmember is {
    none: constmember recvTid: ztypes.tid.zero memberTid: ztypes.tid.zero
    fnT: calleeFnTid :st :scope :ast :unitDecl callableId: site.recvId
    if fnT.isZero then return none
    # `.copy` on a function's name is its reference (checkFunctionCopy)
    if methodId == zast.wellKnown.slot.wkCopy then return none
    forceMemberOf :st :ast parentTypeId: fnT nameId: methodId
    fm: st.typing.declChildOfId parentTypeId: fnT nameId: methodId
    if fm.none then {
        reportUnknownMemberAs :st :ast :dp bt: fnT cnId: methodId shown: fnT
        return none
    }
    return (constmember recvTid: fnT memberTid: fm)
}

# constmember -- a constant's member as constantMemberTid finds it: the type
# it is read on and the member's own type, both 0 when there is none to check
constmember: record {
    recvTid: ztypes.tid
    memberTid: ztypes.tid
}

# checkConstantMethodCall -- the member at `site` (constantMemberTid), then, for
# a method of a string or an option, either the arguments written or, for a
# bare read, none of the required ones left out.
checkConstantMethodCall: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    site: constmethodsite
} is {
    held: st.walk.constFail
    constFailClear :st
    rv: evalConstNode :st :scope :ast :unitDecl nid: site.recvId
    st.walk.constFail = held
    cm: constantMemberTid :st :scope :ast :unitDecl :site :rv
    fid: cm.memberTid
    if (st.reg.typetypeOf typeId: fid) != ztypes.ztypetype.functionType then return
    if site.isCall then {
        (
            callchecks.checkConstantCallArgs
            :st
            :scope
            :ast
            :unitDecl
            call: site.call
            :fid
            recvImplicit: true
        )
        return
    }
    # a read with no arguments is a call, which a method needing them is not
    if (fnAutoCallable :st mid: fid) then return
    sh: unitSplitCallHint :st :scope :ast :fid pathId: site.pathId
    (
        moves.reportBareMemberRef
        :st
        :ast
        :unitDecl
        dp: (dpRefAt :ast nid: site.pathId)
        bt: cm.recvTid
        cnId: (atomNameId :ast n: (ast.nodes.get i: site.childId))
        mo: fid
        result: fid
        hint: sh.stringView
    )
}

# unitSplitCallHint -- a unit-level method read at `pathId` whose missing
# arguments are each a definition written after it on its line: at unit level
# every `name:` begins a definition, so `T: S.substring from: 2 to: 3` is
# three of them. The hint says so and shows the call in parentheses; "" when
# the line holds no such definitions.
unitSplitCallHint: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    fid: ztypes.tid
    pathId: zast.nodeid
} out String is {
    prov: ListVal zast.nameid
    misN: List String
    misI: ListVal ztypes.tid
    (
        callchecks.missingCtorFields
        :ast
        :st
        funcId: fid
        isCtor: false
        provided: prov
        posCount: 0
        recvImplicit: true
        missingNames: misN
        missingIds: misI
    )
    if misN.length == 0 then return "".string
    line: nodeLine n: (ast.nodes.get i: pathId)
    names: String
    args: String
    k: u64
    for each mn: misN loop {
        k = k + 1
        d: st.typing.declFindChild parentDeclId: scope nameId: (nameIdOf :ast name: mn.stringView)
        if d.isZero then return "".string
        opId: zast.nodeid
        dLine: u32
        {
            dn: ast.nodes.get i: (st.typing.decls.get i: d).node
            if dn.namedoperation then opId = dn.operation
            dLine = nodeLine n: dn
        }
        if opId.isZero or (dLine != line) then return "".string
        if k == misN.length when k > 1 then {
            names.append " and "
        } else if names.length > 0 then names.append ", "
        names.append "`\{mn}`"
        args.append " \{mn}: \{typeExprText :ast nid: opId}"
    }
    what: "are definitions of their own"
    if misN.length == 1 then what = "is a definition of its own"
    return "at unit level each `name:` begins a definition, so \{names} here \{what}: write the call in parentheses, `(\{(typeExprText
        :ast
        nid: pathId
    )}\{args})`"
}

# constArgTid -- the type a body sees for an argument whose value is `v`: an
# untyped number or string is its literal type, which its parameter converts,
# and a typed value is its own type
constArgTid: function {
    st: zenv.ZSymbolTable scope: ztypes.declid ast: Ast v: ztypes.cval
} out ztypes.tid is {
    if v.numTid.isZero then {
        if v.kind.ivalKind then return st.reg.literalIntTid
        if v.kind.fvalKind then return st.reg.literalFloatTid
        if v.kind.svalKind then return st.reg.literalTextTid
    }
    return (constValueTid :st :scope :ast :v)
}

# constStringDotted -- a member read on a string constant written as a bare
# dotted path, which is how `S.length` parses. `length` is the BYTE count,
# String.length's own answer; `count` is the codepoint one and is not folded.
# `"abc".text` and `NAME.text` are the literal made text, as the checker types
# them in a body, so a field default or a unit constant has the same type.
constStringDotted: function {
    ast: Ast
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    v: ztypes.cval
    nameId: zast.nameid
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} out ztypes.cval is {
    # the literal's conversions (checkUntypedTextCast): an untyped string made
    # text or a StringView
    if v.numTid.isZero then {
        ct: textLiteralCastTarget :ast :st :nameId
        if ct.notZero then return (ztypes.typedConst c: v numTid: ct)
    }
    noArgs: ListVal zast.nodeid
    return (
        consteval.constTextFold
        :st
        :scope
        :ast
        unitDecl: ztypes.declid
        args: noArgs
        recv: v
        :nameId
        :nodeid
        :lineno
        :colno
    )
}

# textfold -- the text methods a constant folds through (constTextFold), each
# read off its name once (textFoldOp): first those that take no argument, then
# one string, then two, then numbers, then those answering an option
# (constTextFoldOption). A method that walks (`split`, `lines`, `codepoints`)
# does not fold, and runs on the StringView the literal becomes.
textfold: list {
    byteLength: 0
    count: 1
    isEmpty: 2
    isAscii: 3
    trim: 4
    trimStart: 5
    trimEnd: 6
    toUpperAscii: 7
    toLowerAscii: 8
    startsWith: 9
    endsWith: 10
    contains: 11
    concat: 12
    replace: 13
    replaceFirst: 14
    substring: 15
    repeated: 16
    indexOf: 17
    lastIndexOf: 18
    splitOnce: 19
    stripPrefix: 20
    stripSuffix: 21
    byteAt: 22
    # no fold
    none: 23
} out staticlist u8

# textFoldOp -- the fold the text method `nameId` has, textfold.none for a
# name that does not fold.
textFoldOp: function {nameId: zast.nameid} out u8 is {
    if nameId == zast.wellKnown.slot.wkLength then return textfold.byteLength
    if nameId == zast.wellKnown.slot.wkCount then return textfold.count
    if nameId == zast.wellKnown.slot.wkIsEmpty then return textfold.isEmpty
    if nameId == zast.wellKnown.slot.wkIsAscii then return textfold.isAscii
    if nameId == zast.wellKnown.slot.wkTrim then return textfold.trim
    if nameId == zast.wellKnown.slot.wkTrimStart then return textfold.trimStart
    if nameId == zast.wellKnown.slot.wkTrimEnd then return textfold.trimEnd
    if nameId == zast.wellKnown.slot.wkToUpperAscii then return textfold.toUpperAscii
    if nameId == zast.wellKnown.slot.wkToLowerAscii then return textfold.toLowerAscii
    return (textFoldArgOp :nameId)
}

# textFoldArgOp -- textFoldOp for the methods that take arguments, those
# answering an option last.
textFoldArgOp: function {nameId: zast.nameid} out u8 is {
    if nameId == zast.wellKnown.slot.wkStartsWith then return textfold.startsWith
    if nameId == zast.wellKnown.slot.wkEndsWith then return textfold.endsWith
    if nameId == zast.wellKnown.slot.wkContains then return textfold.contains
    if nameId == zast.wellKnown.slot.wkConcat then return textfold.concat
    if nameId == zast.wellKnown.slot.wkReplace then return textfold.replace
    if nameId == zast.wellKnown.slot.wkReplaceFirst then return textfold.replaceFirst
    if nameId == zast.wellKnown.slot.wkSubstring then return textfold.substring
    if nameId == zast.wellKnown.slot.wkRepeated then return textfold.repeated
    if nameId == zast.wellKnown.slot.wkIndexOf then return textfold.indexOf
    if nameId == zast.wellKnown.slot.wkLastIndexOf then return textfold.lastIndexOf
    if nameId == zast.wellKnown.slot.wkSplitOnce then return textfold.splitOnce
    if nameId == zast.wellKnown.slot.wkStripPrefix then return textfold.stripPrefix
    if nameId == zast.wellKnown.slot.wkStripSuffix then return textfold.stripSuffix
    if nameId == zast.wellKnown.slot.wkByteAt then return textfold.byteAt
    return textfold.none
}

# constOfBinop -- fold a binary operator over two constant operands. Two tags
# compare by ARM IDENTITY (owning type plus name-pool id), never by rendered
# text, and only equality is defined -- arms have no order.
constOfBinop: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out ztypes.cval is {
    # the operand and operator ids
    br: consteval.binRefAt :ast :nid
    if br.operator.isZero then return ztypes.noConst
    lhsId: br.lhs
    rhsId: br.rhs
    opId: br.operator
    ln: br.lineno
    co: br.colno
    lv: singletonAsBound :st v: (evalConstNode :st :scope :ast :unitDecl nid: lhsId)
    if lv.kind.none then return ztypes.noConst
    rv: singletonAsBound :st v: (evalConstNode :st :scope :ast :unitDecl nid: rhsId)
    if rv.kind.none then return ztypes.noConst
    opnId: atomNameId :ast n: (ast.nodes.get i: opId)
    if opnId.isZero then return ztypes.noConst
    return (consteval.constOfBinopFold :st :scope :ast :lv :rv :opnId :nid :ln :co)
}

# calleeFieldFnTid -- calleeFnTid, or the function a static data value holds
# in the field the callee reads (`H.f`), which only its value says
calleeFieldFnTid: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    callableId: zast.nodeid
} out ztypes.tid is {
    ft: calleeFnTid :st :scope :ast :unitDecl :callableId
    if ft.notZero then return ft
    cn: ast.nodes.get i: callableId
    if cn.dottedpath.not then return ztypes.tid.zero
    pv: evalConstNode :st :scope :ast :unitDecl nid: cn.parent
    if pv.kind.aggKind.not then return ztypes.tid.zero
    if (st.typing.constAggs.get i: pv.aggId.u64).kind.staticData.not then return ztypes.tid.zero
    fv: constAggField :st :ast v: pv nameId: (atomNameId :ast n: (ast.nodes.get i: cn.child))
    if fv.kind.fnKind then return (constValueTid :st :scope :ast v: fv)
    return ztypes.tid.zero
}

# calleeFnTid -- the function type a call's callee names, by its name
# (`twice`) or through a unit; resolved, never evaluated. A path through a
# value is a member of that value (`K.u8`), no function. 0 for any other
# callee.
calleeFnTid: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    callableId: zast.nodeid
} out ztypes.tid is {
    cn: ast.nodes.get i: callableId
    if cn.call then return ztypes.tid.zero
    if cn.dottedpath when (unitDeclOfPath :st :scope :ast nid: cn.parent
    ).isZero then return ztypes.tid.zero
    # a constant is never resolved here: resolving folds it, and a constant
    # read while its own fold is open is a cycle the fold reports. One that
    # holds a function (`C: twice`) has that type once it is declared.
    an: atomNameId :ast n: cn
    if an.notZero then {
        ad: declOfUnitDef :st :unitDecl :scope nameId: an
        if ad.notZero when (st.typing.decls.get i: ad).kind.constDecl then {
            at: (st.typing.decls.get i: ad).typeId
            if (
                (st.reg.typetypeOf typeId: at) != ztypes.ztypetype.functionType
            ) then return ztypes.tid.zero
            return at
        }
    }
    ft: fnRefTid :st :scope :ast :unitDecl nid: callableId
    if (st.reg.typetypeOf typeId: ft) != ztypes.ztypetype.functionType then return ztypes.tid.zero
    return ft
}

# staticChoiceHead -- the choice a call's head builds a value of: `form.arm`,
# or through a unit (`tbl.form.arm`); 0 when the head names no arm of a
# choice's type.
staticChoiceHead: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    callableId: zast.nodeid
} out ztypes.tid is {
    if st.typing.staticTypesSeen.not then return ztypes.tid.zero
    headId: zast.nodeid
    {
        cn: ast.nodes.get i: callableId
        if cn.dottedpath when (ast.nodes.get i: cn.child).atomid then headId = cn.parent
    }
    if headId.isZero then return ztypes.tid.zero
    # the head's own name, the last of a unit path's
    hn: atomNameId :ast n: (ast.nodes.get i: headId)
    if hn.isZero when (ast.nodes.get i: headId).dottedpath then {
        hn = atomNameId :ast n: (ast.nodes.get i: (dpRefAt :ast nid: headId).child)
    }
    if (st.walk.choiceNames.has item: hn).not then return ztypes.tid.zero
    ct: namedTypeAtHead :st :scope :ast :unitDecl :headId
    if (st.reg.typetypeOf typeId: ct) != ztypes.ztypetype.variantType then return ztypes.tid.zero
    return ct
}

# constOfStaticChoice -- `(form.template "x")` in a static position: the choice
# value of the arm the path names, carrying its one argument folded and fitted
# to the arm's type as a data field's value is (staticFieldValue). noConst
# when the path names no arm of a choice; an arm that carries nothing, or an
# argument count other than one, is reported.
constOfStaticChoice: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    callableId: zast.nodeid
    args: (ListVal zast.nodeid).view
    at: zast.nodeid
    ln: u32
    co: u32
} out ztypes.cval is {
    ct: staticChoiceHead :st :scope :ast :unitDecl :callableId
    if ct.isZero then return ztypes.noConst
    armId: atomNameId :ast n: (ast.nodes.get i: (dpRefAt :ast nid: callableId).child)
    conform.forceAllMembers :st :ast tid: ct
    ad: st.typing.declMemberIdOf parentTypeId: ct nameId: armId
    an: zast.nameTextCopy :ast ref: armId
    cnm: specWrittenName :st :ast tid: ct
    path: typeExprText :ast nid: callableId
    msg: String
    ptid: ztypes.tid
    if ad.notZero then ptid = (st.typing.decls.get i: ad).typeId
    if ad.isZero then {
        msg = "choice '\{cnm}' has no arm '\{an}'"
    } else if ptid == st.typing.nullTypeId then {
        msg = "arm '\{an}' of '\{cnm}' carries nothing: write it `\{path}`, without a value"
    } else if args.length != 1 then {
        msg = "arm '\{an}' of '\{cnm}' carries one value: `(\{path} value)`"
    }
    if msg.length > 0 then {
        addError :st nodeid: at lineno: ln colno: co e: zast.err.callError :msg
        return ztypes.noConst
    }
    argNid: args.get i: 0
    av: argRefAt :ast nid: argNid
    if av.name.notZero then {
        callchecks.reportUnknownArgument :st :ast ownerTid: ct label: av.name arg: av
        return ztypes.noConst
    }
    v: (
        staticFieldValue
        :st
        :scope
        :ast
        :unitDecl
        ownerTid: ct
        ftid: ptid
        name: armId
        :argNid
        :at
        :ln
        :co
    )
    if v.kind.none then return ztypes.noConst
    items: ListVal ztypes.cval
    items.append v
    id: (
        constInternAgg
        :st
        shape: (
            ztyping.aggshape
            kind: ztyping.constaggkind.staticChoice
            tid: ct
            arm: armId
            elem: ztypes.tid.zero
            slot: ztypes.tid.zero
        )
        :items
        labels: ListVal zast.nameid
        :at
    )
    return (ztypes.makeAggConst :id)
}

# staticCtorHead -- the data type a call's head constructs: `row`,
# `row.create`, or either through a unit (`tbl.row`); 0 when the head names
# no data type.
staticCtorHead: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    callableId: zast.nodeid
} out ztypes.tid is {
    if st.typing.staticTypesSeen.not then return ztypes.tid.zero
    headId: callableId
    {
        cn: ast.nodes.get i: callableId
        if cn.dottedpath when (
            (atomNameId :ast n: (ast.nodes.get i: cn.child)) == zast.wellKnown.slot.wkCreate
        ) then headId = cn.parent
    }
    t: namedTypeAtHead :st :scope :ast :unitDecl :headId
    if (st.reg.typetypeOf typeId: t) == ztypes.ztypetype.recordType then return t
    return ztypes.tid.zero
}

# namedTypeAtHead -- the type a head names: `row`, `form`, `add`, or one
# through a unit (`tbl.row`); 0 when the head names none.
namedTypeAtHead: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    headId: zast.nodeid
} out ztypes.tid is {
    t: ztypes.tid
    hn: atomNameId :ast n: (ast.nodes.get i: headId)
    if hn.notZero then t = typeNamedFrom :st :scope :ast lookupUnit: unitDecl typeNameId: hn
    # a path is a type only through a unit (`tbl.row`, `inner.row`, `c.row`
    # with `c: inner`): a member read on a value (`x.isZero`), which the fold
    # meets far more often, is never resolved here
    if hn.isZero when (ast.nodes.get i: headId).dottedpath then {
        qn: (dpRefAt :ast nid: headId).parent
        rn: atomNameId :ast n: (ast.nodes.get i: qn)
        viaUnit: (
            (nameDenotesUnit :st :scope nameId: rn) or
            (qualifierUnitDecl :st :scope :ast nid: qn).notZero
        )
        if viaUnit then t = resolve.resolveDottedArgTid :st :scope :ast nid: headId
    }
    if (st.reg.isStaticOf tid: t) then return t
    return ztypes.tid.zero
}

# constOfStaticCreate -- `row.create` in a static position, the type named
# bare or through a unit (`tbl.row.create`, namedTypeAtHead): the data value of
# every field's default (constOfStaticFields); noConst for any other path.
constOfStaticCreate: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    # the path's parent: the data type
    headId: zast.nodeid
    # the member atom's name: `create`
    ncId: zast.nameid
    atNid: zast.nodeid
    atLine: u32
    atCol: u32
} out ztypes.cval is {
    if (
        (ncId != zast.wellKnown.slot.wkCreate) or st.typing.staticTypesSeen.not
    ) then return ztypes.noConst
    sct: namedTypeAtHead :st :scope :ast :unitDecl :headId
    if sct.isZero then return ztypes.noConst
    # a choice has no value of its own: it is built through an arm
    if (st.reg.typetypeOf typeId: sct) != ztypes.ztypetype.recordType then return ztypes.noConst
    return (
        constOfStaticFields
        :st
        :scope
        :ast
        :unitDecl
        tid: sct
        args: ListVal zast.nodeid
        at: atNid
        ln: atLine
        co: atCol
    )
}

# constOfStaticFields -- a data value built in a static position, `(row key:
# "a")` or `row.create`: each field, in declared order, is the argument that
# names it (by label, or the one unlabelled argument the first field) or else
# the field's default, fitted to
# the field's type (constFitToField). An unknown argument and a missing field
# are reported in a body construction's words. noConst when any field has no
# value; else the interned aggregate.
constOfStaticFields: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    tid: ztypes.tid
    args: (ListVal zast.nodeid).view
    # where a missing field is reported: the construction
    at: zast.nodeid
    ln: u32
    co: u32
} out ztypes.cval is {
    span: dataFieldsOf :st :ast :tid
    argOf: ListVal zast.nodeid
    ok: matchStaticArgs :st :ast :tid :args :span :argOf
    items: ListVal ztypes.cval
    fi: u32
    for fi < span.count loop {
        v: (
            staticFieldRowValue
            :st
            :scope
            :ast
            :unitDecl
            ownerTid: tid
            row: span.from + fi
            argNid: (argOf.get i: fi.u64)
            :at
            :ln
            :co
        )
        if v.kind.none then ok = false
        items.append v
        fi = fi + 1
    }
    if ok.not then return ztypes.noConst
    id: (
        constInternAgg
        :st
        shape: (
            ztyping.aggshape
            kind: ztyping.constaggkind.staticData
            :tid
            arm: zast.nameid.zero
            elem: ztypes.tid.zero
            slot: ztypes.tid.zero
        )
        :items
        labels: ListVal zast.nameid
        :at
    )
    return (ztypes.makeAggConst :id)
}

# matchStaticArgs -- the argument each field of a data construction is given,
# row for row with the type's fields `span` in `argOf` (0 for none): by label,
# or the one unlabelled argument the first field. False when a label names no
# field, which is reported.
matchStaticArgs: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tid: ztypes.tid
    args: (ListVal zast.nodeid).view
    span: ztyping.fieldspan
    argOf: ListVal zast.nodeid
} out bool is {
    nf: span.count.u64
    for argOf.length < nf loop argOf.append zast.nodeid.zero
    ok: true
    pos: u64
    for each aId: args loop {
        a: argRefAt :ast nid: aId
        slot: nf
        if a.name.isZero then {
            slot = pos
            pos = pos + 1
        }
        fi: u64
        for fi < nf loop {
            fname: (st.typing.fieldRows.get i: span.from.u64 + fi).name
            if a.name.notZero when fname == a.name then slot = fi
            fi = fi + 1
        }
        if slot < nf then argOf.set i: slot val: aId
        if slot == nf then {
            callchecks.reportUnknownArgument :st :ast ownerTid: tid label: a.name arg: a
            ok = false
        }
    }
    return ok
}

# staticFieldValue -- one field of a data construction: its argument at
# `argNid` folded, else its default, fitted to the field's type
# (constFitToField). noConst, reported, when it has neither or does not fit.
staticFieldValue: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    ownerTid: ztypes.tid
    ftid: ztypes.tid
    name: zast.nameid
    # the argument naming the field, 0 for none
    argNid: zast.nodeid
    # where a missing field is reported: the construction
    at: zast.nodeid
    ln: u32
    co: u32
} out ztypes.cval is {
    # a field of a type no data field may hold was refused where it is
    # declared (refuseNonStaticMember): that is the one error, not each value
    if (isStaticMemberTid :st :ast tid: ftid).not then return ztypes.noConst
    if argNid.notZero then return (staticArgValue :st :scope :ast :unitDecl :ftid :name :argNid)
    dv: constOfFieldDefault :st :ast :ownerTid :ftid :name
    if dv.isConst then return (constFitToField :st :scope :ast v: dv :ftid :name :at :ln :co)
    missingFieldError :st :ast :ftid :name :at :ln :co
    return ztypes.noConst
}

# staticFieldRowValue -- staticFieldValue for the field row `row` of a data
# type (dataFieldsOf), which answers the static verdict once per type. A
# default that folded and fitted is kept on the row: a default is a constant,
# the same value at every construction.
staticFieldRowValue: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    ownerTid: ztypes.tid
    row: u32
    # the argument naming the field, 0 for none
    argNid: zast.nodeid
    # the construction the field belongs to, where its absence is reported
    at: zast.nodeid
    ln: u32
    co: u32
} out ztypes.cval is {
    fr: st.typing.fieldRows.get i: row.u64
    ftid: fr.tid
    name: fr.name
    # refused where it is declared (refuseNonStaticMember), as in staticFieldValue
    if fr.isStatic.not then return ztypes.noConst
    if argNid.notZero then return (staticArgValue :st :scope :ast :unitDecl :ftid :name :argNid)
    if fr.defaultVal.isConst then return fr.defaultVal
    dv: constOfFieldDefault :st :ast :ownerTid :ftid :name
    if dv.kind.none then {
        missingFieldError :st :ast :ftid :name :at :ln :co
        return ztypes.noConst
    }
    fv: constFitToField :st :scope :ast v: dv :ftid :name :at :ln :co
    if fv.isConst then {
        (
            st.typing.fieldRows.set
            i: row.u64
            val: (ztyping.datafield tid: ftid :name isStatic: true defaultVal: fv)
        )
    }
    return fv
}

# missingFieldError -- a construction at `at` gives field `name` (of type
# `ftid`) no value, and it has no default
missingFieldError: function {
    st: zenv.ZSymbolTable
    ast: Ast
    ftid: ztypes.tid
    name: zast.nameid
    at: zast.nodeid
    ln: u32
    co: u32
} is {
    fn: zast.nameTextCopy :ast ref: name
    tnm: specWrittenName :st :ast tid: ftid
    (
        addError
        :st
        nodeid: at
        lineno: ln
        colno: co
        e: zast.err.callError
        msg: "missing required argument '\{fn}' (type: \{tnm})"
    )
}

# staticArgValue -- the argument at `argNid` given a data field (or a choice
# arm's payload) of type `ftid`, folded and fitted to it
staticArgValue: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    ftid: ztypes.tid
    name: zast.nameid
    argNid: zast.nodeid
} out ztypes.cval is {
    {
        a: argRefAt :ast nid: argNid
        errA: st.typing.errors.length
        av: ztypes.noConst
        # a nested list is of the field's list type
        if (ast.nodes.get i: a.operation).listblock then {
            av = constOfList :st :scope :ast :unitDecl nid: a.operation want: ftid
        } else if (st.reg.typetypeOf typeId: ftid) == ztypes.ztypetype.functionType then {
            av = constOfFnRef :st :scope :ast :unitDecl nid: a.operation
        } else {
            av = evalConstNode :st :scope :ast :unitDecl nid: a.operation
            # one with no value and no recorded reason says why through the
            # part of it that has none, as a definition does
            unsaid: st.typing.errors.length == errA
            if av.kind.none when st.walk.constFail.kind.none when unsaid then {
                visiting: ListVal zast.nodeid
                said: unfoldedPartWhy :st :scope :ast :unitDecl nid: a.operation :visiting
                if said then return ztypes.noConst
            }
        }
        # a value whose own fold was reported (a cycle through it) is not
        # reported again here
        if av.kind.none when st.typing.errors.length > errA then return ztypes.noConst
        return (
            constFitToField
            :st
            :scope
            :ast
            v: av
            :ftid
            :name
            at: a.nid
            ln: a.lineno
            co: a.colno
        )
    }
}

# constOfFnRef -- a function's name, bare or through a unit, where a static
# value of a function type is taken: the reference to that function. A call is
# never a static value, so the name is never called here. A spec has no body
# to refer to; a native function, a generic one and a method are no single
# function a static value can hold. Each is reported; a name that is no
# function is noConst, unreported, for the caller's own report.
constOfFnRef: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out ztypes.cval is {
    if (ast.nodes.get i: nid).call then {
        cnn: ast.nodes.get i: nid
        (
            addError
            :st
            nodeid: nid
            lineno: (nodeLine n: cnn)
            colno: (nodeCol n: cnn)
            e: zast.err.typeError
            msg: "a call is never a static value: a function-typed member takes the function itself, by its name".string
        )
        return ztypes.noConst
    }
    ft: fnRefTid :st :scope :ast :unitDecl :nid
    if (st.reg.typetypeOf typeId: ft) != ztypes.ztypetype.functionType then return ztypes.noConst
    fd: st.typing.declIdOfType typeId: ft
    if fd.isZero then return ztypes.noConst
    fname: typeExprText :ast :nid
    why: String
    fnode: zast.nodeid
    {
        dn: ast.nodes.get i: (st.typing.decls.get i: fd).node
        if dn.namedoperation then fnode = dn.operation
    }
    if fnode.notZero when (declare.functiondefIsNative op: (ast.nodes.get i: fnode)) then {
        why = "'\{fname}' is a native function: it has no body a static value can refer to"
    } else if (declaresFunctionWithBody :st :ast declId: fd).not then {
        why = "'\{fname}' is a spec: it has no body a static value can refer to"
    } else if (st.reg.isGenericOf tid: ft) then {
        why = "'\{fname}' is generic: a static value refers to one function, and a generic one is many"
    } else if (fnDeclIsMethod :st declId: fd) then {
        why = "'\{fname}' is a method: a static value refers to a function, and a method is bound to its receiver"
    }
    if why.length > 0 then {
        n: ast.nodes.get i: nid
        (
            addError
            :st
            nodeid: nid
            lineno: (nodeLine :n)
            colno: (nodeCol :n)
            e: zast.err.typeError
            msg: why
        )
        return ztypes.noConst
    }
    # the function is used: the body pass walks it (walkStaticFnRefs), so the
    # emitter writes it
    st.walk.staticFnRefs.append fd
    return (ztypes.makeFnConst decl: fd)
}

# fnRefTid -- the function type a name in a static position names: a bare
# name, a unit's function (`util.sub`) or a type's member (`box.twice`), each
# resolved in the scope that declares it, so its signature is complete. 0 when
# it names none.
fnRefTid: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out ztypes.tid is {
    ft: ztypes.tid
    hn: atomNameId :ast n: (ast.nodes.get i: nid)
    if hn.notZero then {
        lk: walkLookupTyperefById :st :scope :ast :unitDecl baseId: hn
        match lk case some then ft = lk case none then null
        return ft
    }
    if (ast.nodes.get i: nid).dottedpath.not then return ft
    dr: dpRefAt :ast :nid
    rn: atomNameId :ast n: (ast.nodes.get i: dr.parent)
    cn: atomNameId :ast n: (ast.nodes.get i: dr.child)
    if rn.isZero or cn.isZero then return ft
    # the unit the path names declares the function: its declaration there
    ud: unitDeclOfPath :st :scope :ast nid: dr.parent
    if ud.notZero then {
        fd: st.typing.declFindChild parentDeclId: ud nameId: cn
        if fd.isZero then return ft
        # resolved now, as a demand would resolve it: the signature is compared
        resolve.resolveDemandedDecl :st :ast declId: fd
        return (st.typing.decls.get i: fd).typeId
    }
    pt: typeNamedFrom :st :scope :ast lookupUnit: unitDecl typeNameId: rn
    if pt.isZero then return ft
    conform.forceAllMembers :st :ast tid: pt
    mt: st.typing.declChildOfId parentTypeId: pt nameId: cn
    match mt case some then ft = mt case none then null
    return ft
}

# fnDeclIsMethod -- function declaration `fd` is a member of a type, a method,
# rather than of a unit.
fnDeclIsMethod: function {st: zenv.ZSymbolTable.view declId: ztypes.declid} out bool is {
    pd: st.typing.declParentOf :declId
    if pd.isZero then return false
    pt: (st.typing.decls.get i: pd).typeId
    if pt.isZero then return false
    return (st.reg.typetypeOf typeId: pt) != ztypes.ztypetype.unitType
}

# constOfFieldDefault -- the value field `name` of `ownerTid` defaults to, as a
# constant: a literal folded from its node, a named or computed default from
# its declaration's fold, an arm as that arm. noConst when it has none.
constOfFieldDefault: function {
    st: zenv.ZSymbolTable
    ast: Ast
    ownerTid: ztypes.tid
    # the field's type: an arm default is an arm of it
    ftid: ztypes.tid
    name: zast.nameid
} out ztypes.cval is {
    dv: st.typing.declDefaultOfId parentTypeId: ownerTid nameId: name
    od: st.typing.declIdOfType typeId: ownerTid
    match (
        dv
    ) case literal then {
        return (evalConstNode :st scope: od :ast unitDecl: od nid: dv)
    } case constant then {
        return (constValueOfDecl :st declId: dv)
    } case arm then {
        return (ztypes.makeArmConst armTid: ftid armName: (st.typing.declNameOf declId: dv))
    } case func then {
        return (ztypes.makeFnConst decl: dv)
    } else null
    # a field declared by a function's name (`lower: defaultLower`) is of that
    # function's type, and defaults to it; one declared by a spec has none
    if (st.reg.typetypeOf typeId: ftid) != ztypes.ztypetype.functionType then return ztypes.noConst
    fd: st.typing.declIdOfType typeId: ftid
    if (declaresFunctionWithBody :st :ast declId: fd).not then return ztypes.noConst
    return (ztypes.makeFnConst decl: fd)
}

# constAggField -- field `nameId` of the data value `v`, as its value was
# folded, a list's member (staticListMemberValue), or a choice value's arm
# predicate; noConst when the type declares no such member, which the read's
# own check reports.
constAggField: function {
    st: zenv.ZSymbolTable ast: Ast v: ztypes.cval nameId: zast.nameid
} out ztypes.cval is {
    tid: ztypes.tid
    start: u64
    isList: false
    isChoice: false
    arm: zast.nameid
    {
        g: st.typing.constAggs.get i: v.aggId.u64
        tid = g.tid
        start = g.itemStart
        isList = g.kind.staticList
        isChoice = g.kind.staticChoice
        arm = g.arm
    }
    if isList then return (staticListMemberValue :st :ast row: v.aggId :nameId)
    # a choice value's arm name is its arm predicate, as on any variant value
    if isChoice then {
        md: st.typing.declMemberIdOf parentTypeId: tid :nameId
        if md.isZero or (st.typing.decls.get i: md).kind.armDecl.not then return ztypes.noConst
        return (consteval.boolConst :ast :st v: arm == nameId)
    }
    span: dataFieldsOf :st :ast :tid
    fi: u32
    for fi < span.count loop {
        if (st.typing.fieldRows.get i: (span.from + fi).u64).name == nameId then return (
            st.typing.constAggItems.get
            i: start + fi
        )
        fi = fi + 1
    }
    return ztypes.noConst
}

# dataFieldsOf -- `tid`'s data fields as its constructions read them, a run of
# st.typing.fieldRows in dataFieldIds' order: made on the first ask, with every
# member forced, and kept. A resolved type's fields, their types and whether a
# data value may hold them do not change, so each construction reads the row
# rather than asking again.
dataFieldsOf: function {st: zenv.ZSymbolTable ast: Ast tid: ztypes.tid} out ztyping.fieldspan is {
    known: st.walk.fieldSpans.get key: tid
    if known.some then {
        return known
    }
    conform.forceAllMembers :st :ast :tid
    ftids: ListVal ztypes.tid
    fnames: ListVal zast.nameid
    conform.dataFieldIds reg: st.reg typing: st.typing :tid ids: ftids nameIds: fnames
    from: st.typing.fieldRows.length
    fi: u64
    for fi < fnames.length loop {
        ft: ftids.get i: fi
        isStatic: isStaticMemberTid :st :ast tid: ft
        (
            st.typing.fieldRows.append
            from: (
                ztyping.datafield
                tid: ft
                name: (fnames.get i: fi)
                :isStatic
                defaultVal: ztypes.noConst
            )
        )
        fi = fi + 1
    }
    span: ztyping.fieldspan from: from.u32.orPanic count: fnames.length.u32.orPanic
    st.walk.fieldSpans.set key: tid value: span
    return span
}

# knownFieldSpan -- `tid`'s run of st.typing.fieldRows when a construction made
# one (dataFieldsOf), none otherwise: a reader holding the checked tree reads
# a data value's fields there, without asking dataFieldIds again.
knownFieldSpan: function {
    st: zenv.ZSymbolTable.view tid: ztypes.tid
} out optionval ztyping.fieldspan is {
    return (st.walk.fieldSpans.get key: tid)
}

# constFitToField -- the constant `v` as the value of a data field of type
# `ftid`, or noConst with the reason reported at the argument: an untyped
# number fits the field's number type (constFitsType) or stays untyped in an
# intliteral or floatliteral field, an untyped string is text, and any other
# value -- a typed number, an arm, a data value -- must already be of the
# field's type.
constFitToField: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    v: ztypes.cval
    ftid: ztypes.tid
    name: zast.nameid
    at: zast.nodeid
    ln: u32
    co: u32
} out ztypes.cval is {
    if v.kind.none then {
        # the fold's own reason, when it recorded one (a cycle, an overflow)
        if st.walk.constFail.failed then {
            reportPendingConstFail :st
            return ztypes.noConst
        }
        (
            addError
            :st
            nodeid: at
            lineno: ln
            colno: co
            e: zast.err.callError
            msg: "argument '\{(
                zast.nameTextCopy
                :ast
                ref: name
            )}' is not a constant: a data value is built from constants"
        )
        return ztypes.noConst
    }
    num: v.kind.ivalKind or v.kind.fvalKind
    untyped: v.numTid.isZero
    if num when untyped when ftid == st.reg.literalIntTid when v.kind.ivalKind then return v
    if num when untyped when ftid == st.reg.literalFloatTid then return v
    isNum: (typeIsNumberOf :st tid: ftid float: false) or (typeIsNumberOf :st tid: ftid float: true)
    if num when untyped when isNum then return (constFitNumber :st :scope :ast :v :ftid :at :ln :co)
    txT: stdTid :ast :st wk: zast.wellKnown.slot.tyText
    if v.kind.svalKind when ftid == txT when untyped or (v.numTid == txT) then {
        return (ztypes.typedConst c: v numTid: txT)
    }
    vt: constValueTid :ast :st :scope :v
    if vt == ftid then return v
    # a function fits a function slot by its signature (functionSignaturesMatch)
    if v.kind.fnKind then {
        stampDeclaredSignature :st :ast fid: vt
        stampDeclaredSignature :st :ast fid: ftid
        if (conform.functionSignaturesMatch :ast :st a: vt b: ftid) then return v
        fen: specWrittenName :st :ast tid: ftid
        fgn: specWrittenName :st :ast tid: vt
        (
            addError
            :st
            nodeid: at
            lineno: ln
            colno: co
            e: zast.err.callError
            msg: "argument '\{(
                zast.nameTextCopy
                :ast
                ref: name
            )}' is a function of another signature: '\{fgn}' does not match '\{fen}'"
        )
        return ztypes.noConst
    }
    en: specWrittenName :st :ast tid: ftid
    gn: specWrittenName :st :ast tid: vt
    (
        addError
        :st
        nodeid: at
        lineno: ln
        colno: co
        e: zast.err.callError
        msg: "argument '\{(
            zast.nameTextCopy
            :ast
            ref: name
        )}' type mismatch: expected \{en}, got \{gn}"
    )
    return ztypes.noConst
}

# stampDeclaredSignature -- stamp the type-refs of the function type `fid`'s
# signature, when a definition declares it. A data value is folded before
# stampTyperefs runs, and functionSignaturesMatch reads a return type off its
# node stamp: unstamped, a declared function had no return, so two functions
# with returns of different types matched and a correct one was refused.
stampDeclaredSignature: function {st: zenv.ZSymbolTable ast: Ast fid: ztypes.tid} is {
    d: st.typing.declIdOfType typeId: fid
    if d.isZero then return
    if (st.reg.typetypeOf typeId: fid) != ztypes.ztypetype.functionType then return
    dn: zast.nodeid
    dp: ztypes.declid
    {
        decl: st.typing.decls.get i: d
        dn = decl.node
        dp = decl.parent
    }
    if dn.isZero or dp.isZero then return
    opId: zast.nodeid
    {
        nn: ast.nodes.get i: dn
        if nn.namedoperation then opId = nn.operation
    }
    if opId.isZero then return
    ud: resolve.unitDeclOfTid reg: st.reg typing: st.typing tid: fid
    if ud.isZero then return
    (
        resolve.stampMemberSignature
        :st
        scope: dp
        :ast
        unitDecl: ud
        thisName: ""
        ownerTid: ztypes.tid.zero
        fnNodeId: opId
        mid: fid
    )
}

# constFitNumber -- the untyped number `v` as a value of the number type `ftid`
# (a typedef over one included): it must fit the base type (constFitsType,
# reported at `at`), and it converts as its literal would.
constFitNumber: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    v: ztypes.cval
    ftid: ztypes.tid
    at: zast.nodeid
    ln: u32
    co: u32
} out ztypes.cval is {
    base: conform.typedefChaseTid typing: st.typing tid: ftid
    fm: numerics.constFitsType :st :v target: base
    if fm.length > 0 then {
        addError :st nodeid: at lineno: ln colno: co e: zast.err.typeError msg: fm
        return ztypes.noConst
    }
    r: v
    bn: nameIdOf :ast name: (st.reg.nameOf tid: base).stringView
    cv: (
        consteval.constOfConversion
        :st
        :scope
        :ast
        v: (singletonAsBound :st :v)
        targetId: bn
        nid: at
        :ln
        :co
    )
    if cv.isConst then r = cv
    return (ztypes.typedConst c: r numTid: ftid)
}

# constInternAgg -- the row of an aggregate in ZTyping.constAggs, its items
# appended to constAggItems: an equal aggregate's row when one is there (same
# shape, items and labels), else a new one.
constInternAgg: function {
    st: zenv.ZSymbolTable
    shape: ztyping.aggshape
    items: (ListVal ztypes.cval).view
    # a list's labels, row for row with items (0 for an unlabelled element);
    # empty for a data or choice value
    labels: (ListVal zast.nameid).view
    # where it is built; an equal value interned earlier keeps its own
    at: zast.nodeid
} out u32 is {
    h: shape.kind.tag.u64 + 1 * 1099511628211
    h = (h ^ shape.tid.u64) * 1099511628211
    h = (h ^ shape.arm.u32) * 1099511628211
    h = (h ^ shape.elem.u64 ^ (shape.slot.u64 << 32)) * 1099511628211
    for each it: items loop h = (h ^ (constItemHash v: it)) * 1099511628211
    for each lb: labels loop h = (h ^ lb.u32) * 1099511628211
    head: (st.typing.constAggIndex.heads.get key: h).or d: 0
    r: head
    for r != 0 loop {
        if (constAggMatches :st row: r :shape :items :labels) then return r
        r = st.typing.constAggIndex.next.get i: r.u64
    }
    start: st.typing.constAggItems.length.u32.orPanic
    for each it: items loop st.typing.constAggItems.append it
    lstart: st.typing.constAggLabels.length.u32.orPanic
    for each lb: labels loop st.typing.constAggLabels.append lb
    id: st.typing.constAggs.length.u32.orPanic
    st.typing.constAggs.append (
        ztyping.constagg
        kind: shape.kind
        tid: shape.tid
        arm: shape.arm
        itemStart: start
        itemCount: items.length.u32.orPanic
        labelStart: lstart
        labelCount: labels.length.u32.orPanic
        elem: shape.elem
        slot: shape.slot
        node: at
        reached: false
    )
    st.typing.constAggIndex.next.append head
    st.typing.constAggIndex.heads.set key: h value: id
    return id
}

# constItemHash -- a hash of one aggregate item over the parts that tell
# values apart; equal values hash alike (a float's bits are left out, so
# floats share a bucket and are told apart by the compare).
constItemHash: function {v: ztypes.cval} out u64 is {
    h: v.kind.tag.u64 + 7 * 1099511628211
    h = (h ^ (ztypes.i64Bits v: v.ival)) * 1099511628211
    h = (h ^ v.bigId ^ (v.ratId.u64 << 20) ^ (v.floatId.u64 << 40)) * 1099511628211
    h = (h ^ v.strId ^ (v.aggId.u64 << 32)) * 1099511628211
    h = (h ^ v.armTid.u64 ^ (v.armName.u32.u64 << 32)) * 1099511628211
    return (h ^ v.numTid.u64) * 1099511628211
}

# constAggMatches -- whether aggregate row `row` holds exactly this shape,
# items and labels.
constAggMatches: function {
    st: zenv.ZSymbolTable.view
    row: u32
    shape: ztyping.aggshape
    items: (ListVal ztypes.cval).view
    labels: (ListVal zast.nameid).view
} out bool is {
    g: st.typing.constAggs.get i: row.u64
    if (g.kind != shape.kind) or (g.tid != shape.tid) or (g.arm != shape.arm) then return false
    if (g.elem != shape.elem) or (g.slot != shape.slot) then return false
    if g.itemCount.u64 != items.length then return false
    if g.labelCount.u64 != labels.length then return false
    i: u64
    for i < items.length loop {
        if (st.typing.constAggItems.get i: g.itemStart.u64 + i) != (items.get :i) then return false
        i = i + 1
    }
    i = 0
    for i < labels.length loop {
        if (
            (st.typing.constAggLabels.get i: g.labelStart.u64 + i) != (labels.get :i)
        ) then return false
        i = i + 1
    }
    return true
}

# constOfDottedHead -- what a dotted path's head settles before the parent's own
# value is asked: `row.create`, the type named bare or through a unit
# (`tbl.row.create`), a data value of every field's default; then a member read
# off a bare-atom base (constOfNamedBase). noConst when neither answers.
constOfDottedHead: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
    parentId: zast.nodeid
    # the parent's name when it is a bare atom, else zero
    ptId: zast.nameid
    ncId: zast.nameid
    ln: u32
    co: u32
} out ztypes.cval is {
    sc: (
        constOfStaticCreate
        :st
        :scope
        :ast
        :unitDecl
        headId: parentId
        :ncId
        atNid: nid
        atLine: ln
        atCol: co
    )
    if sc.isConst or ptId.isZero then return sc
    return (constOfNamedBase :st :scope :unitDecl :ast atNid: nid atLine: ln atCol: co :ptId :ncId)
}

# constOfNamedBase -- a dotted path whose base is a bare atom. The base can name a
# numeric literal (`1.u32` is a width suffix, not a member read), another unit, a
# nested namespace, a nested unit of the scope being evaluated, or a same-unit
# constant or type -- the constant is asked first, being the narrower question.
constOfNamedBase: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    unitDecl: ztypes.declid
    ast: Ast
    atNid: zast.nodeid
    atLine: u32
    atCol: u32
    # the base atom's name, interned; zero when the parent is not a bare atom
    ptId: zast.nameid
    # the member atom's name, interned
    ncId: zast.nameid
} out ztypes.cval is {
    if ptId.notZero then {
        # `1.u32` is a width-suffixed literal, not a member read: the literal
        # converted to the type the child names.
        if (isNumericLiteralNameAt :ast ref: ptId) then {
            lit: ztypes.noConst
            # the literal is parsed from its spelling, read through a borrow
            ptT: zast.nameTextAt :ast ref: ptId
            lit = consteval.constLiteralValue :st name: ptT.stringView
            ptT.drop
            return (
                consteval.constOfConversion
                :st
                :scope
                :ast
                v: (singletonAsBound :st v: lit)
                targetId: ncId
                nid: atNid
                ln: atLine
                co: atCol
            )
        }
        # `unit.CONST` reads a constant out of another unit
        if (nameDenotesUnit :st :scope nameId: ptId) then {
            uv: constOfUnitMember :st :scope :ast :ptId :ncId
            # a unit instance's own constant (`wi.primes`, `wi: (wrap t: i64)`)
            # is read off the instance, below
            if (
                uv.isConst or
                (st.reg.genericOriginOf tid: (resolve.resolvedTidOr :st :ast :unitDecl name: ptId)
                ).isZero
            ) then return uv
        }
        # `c.CONST` through an alias of a unit (`c: inner`): the unit is read off
        # the alias's value, so the read holds before anything resolves the alias
        {
            ah: envLookup :st :scope nameId: ptId
            au: resolve.unitNamedBy :st :scope :ast nameId: ptId
            if au.notZero when au != ah.declId when ah.declId.notZero then {
                aowner: qualifiedMemberScope :st unitRoot: au memberId: ncId
                av: constValueOfMemberId :st scope: aowner :ast unitDecl: au nameId: ncId
                if av.isConst then return av
            }
        }
        # A nested namespace (`m: unit { NUM: 7 }`) is a definition of THIS
        # unit whose type is a unit; it is deliberately absent from the
        # unit-name index, so its members are read off its type id.
        {
            nso: resolve.resolvedByIds :st :ast :unitDecl name: ptId
            if nso.some then {
                nst: nso
                if (st.reg.typetypeOf typeId: nst) == ztypes.ztypetype.unitType then {
                    nsv: constValueOfMemberTidId :st :ast unitTid: nst nameId: ncId
                    if nsv.isConst then return nsv
                }
            }
        }
        # A nested unit of the SCOPE being evaluated: not in the unit-name
        # index either, and it resolves on demand, so it may have no id at
        # all until asked for here. The scope is the enclosing namespace
        # while its own members evaluate and the file unit otherwise --
        # rooting this at the file unit alone stopped a re-export chain at
        # its first hop, since a subunit's subunit is no child of the file.
        {
            sro: resolve.unitScopeOf typing: st.typing declId: scope
            # a public block's definitions read the unit's own names
            # (`seven: inner.seven`), its subunits among them
            if (resolve.declIsPublicBlock :st declId: sro) then sro = (
                st.typing.declParentOf
                declId: sro
            )
            nestedNameId: ptId
            sst: resolve.nestedUnitTidOf :st :ast ownerDeclId: sro :nestedNameId
            if sst.notZero then {
                ssv: constValueOfMemberTidId :st :ast unitTid: sst nameId: ncId
                if ssv.isConst then return ssv
            }
        }
        # A same-unit name can be a CONSTANT or a TYPE, and the two read
        # identically: `CC.tcc` asks whether the constant CC holds that arm,
        # `cckind.tcc` names an arm of the type. The constant is asked
        # first because it is the narrower question -- a name is not both,
        # and classifying a constant by its definition's shape would call
        # `CC: cckind.tcc` a variant and read a nonexistent arm off it.
        pcv: constValueOfMemberId :st :scope :ast :unitDecl nameId: ptId
        if pcv.kind.armKind then return (consteval.constArmChild :st :ast v: pcv :ncId)
        if pcv.kind.aggKind then return (constAggField :st :ast v: pcv nameId: ncId)
        # a constant whose fold failed with a reason (a cycle) is no type
        # either: the type walk below would fold other declarations and lose it
        if pcv.kind.none when st.walk.constFail.failed then return ztypes.noConst
        if pcv.kind.svalKind then {
            return (
                constStringDotted
                :st
                :scope
                :ast
                v: pcv
                nameId: ncId
                nodeid: atNid
                lineno: atLine
                colno: atCol
            )
        }
        if pcv.kind.ivalKind when ncId == zast.wellKnown.slot.wkNot then return (
            consteval.constIntNot
            :st
            v: (singletonAsBound :st v: pcv)
        )
        if pcv.kind.ivalKind or pcv.kind.fvalKind then {
            return (
                consteval.constOfConversion
                :st
                :scope
                :ast
                v: (singletonAsBound :st v: pcv)
                targetId: ncId
                nid: atNid
                ln: atLine
                co: atCol
            )
        }
        return (constArmRead :st :scope :ast lookupUnit: unitDecl typeNameId: ptId armNameId: ncId)
    }
    return ztypes.noConst
}


# constStaticListSlotRead -- `blk.slot.label`: the position of a list's labelled
# element, typed as the list's `slot`. The list is any compile-time path to it
# (`codes`, `zast.wellKnown`). noConst when the path is not that shape.
constStaticListSlotRead: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    # the list's path and the `slot` segment
    gpId: zast.nodeid
    gcId: zast.nodeid
    labelId: zast.nameid
} out ztypes.cval is {
    {
        gc: ast.nodes.get i: gcId
        if gc.atomid.not then return ztypes.noConst
        if gc.name != zast.wellKnown.slot.wkSlot then return ztypes.noConst
    }
    lv: evalConstNode :st :scope :ast :unitDecl nid: gpId
    if lv.kind.aggKind.not then return ztypes.noConst
    g: st.typing.constAggs.get i: lv.aggId.u64
    if g.kind.staticList.not or g.slot.isZero then return ztypes.noConst
    # a position folds as an element of its type would: a typedef index is a
    # value of its own type, read where it is written and not folded
    if (isLiteralTypeId reg: st.reg tid: g.slot).not when (
        staticListElemFolds
        :ast
        :st
        elemTid: g.slot
    ).not then {
        return ztypes.noConst
    }
    po: st.typing.aggLabelPos id: lv.aggId label: labelId
    if po.some then {
        cv: ztypes.makeIntConst po.i64.orPanic
        if (isLiteralTypeId reg: st.reg tid: g.slot).not when (numerics.isNumericTid :st tid: g.slot
        ) then {
            cv = ztypes.typedConst c: cv numTid: g.slot
        }
        return cv
    }
    return ztypes.noConst
}

# evalConstArmViaUnit -- `unit.kind.arm`: an arm of a type reached THROUGH its
# unit, which may itself be a subunit (`z.build.oskind.linux`). The parent is a
# dotted path of its own (`gpId.gcId`), so the type is looked up from that unit
# rather than from the one being evaluated. noConst when the path is not that
# shape.
evalConstArmViaUnit: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    gpId: zast.nodeid
    gcId: zast.nodeid
    # the arm's name id
    nameCountId: zast.nameid
} out ztypes.cval is {
    gcNameId: zast.nameid
    gc: ast.nodes.get i: gcId
    if gc.atomid then gcNameId = gc.name
    if gcNameId.isZero then return ztypes.noConst
    pathUnit: unitDeclOfPath :st :scope :ast nid: gpId
    if pathUnit.isZero then return ztypes.noConst
    qa: (
        constArmRead
        :st
        :scope
        :ast
        lookupUnit: pathUnit
        typeNameId: gcNameId
        armNameId: nameCountId
    )
    return qa
}

# constOfUnitPathMember -- the constant `ncId` of the unit the path `parentId`
# names (`z.build`), none when the path names no unit or the unit no constant
constOfUnitPathMember: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    parentId: zast.nodeid
    ncId: zast.nameid
} out ztypes.cval is {
    pud: unitDeclOfPath :st :scope :ast nid: parentId
    if pud.isZero then return ztypes.noConst
    pown: qualifiedMemberScope :st unitRoot: pud memberId: ncId
    return (constValueOfMemberId :st scope: pown :ast unitDecl: pud nameId: ncId)
}

# unitDeclOfPath -- the unit declaration a name or dotted path names
# (qualifierUnitDecl: a file unit, a unit a scope declares, `inl.codes.lf`,
# `z.build`, an alias of one), else for a bare name binding a generic unit's
# instance the unit the walk is in. 0 when the path names no unit.
unitDeclOfPath: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    ast: Ast.view
    nid: zast.nodeid
} out ztypes.declid is {
    ud: qualifierUnitDecl :st :scope :ast :nid
    if ud.notZero then return ud
    n: ast.nodes.get i: nid
    match (
        n
    ) case atomid then {
        if (nameDenotesUnit :st :scope nameId: n.name) then {
            return (resolve.unitDeclOfNameOrOwn :st :scope nameId: n.name)
        }
    } else null
    return ztypes.declid.zero
}

# evalConstDotted -- a dotted path's value: a member read off a named base
# (a unit, a nested namespace, a constant, a type's arm), the arm predicate
# of a constant whose type is a variant, a method on a string constant, or
# an arm reached through a unit.
evalConstDotted: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
    parentId: zast.nodeid
    childId: zast.nodeid
    ln: u32
    co: u32
} out ztypes.cval is {
    ncId: zast.nameid
    chn: ast.nodes.get i: childId
    if chn.atomid then ncId = chn.name
    if ncId.isZero then return ztypes.noConst
    ptId: zast.nameid
    parentIsDotted: false
    gpId: zast.nodeid
    gcId: zast.nodeid
    {
        pn: ast.nodes.get i: parentId
        if pn.atomid then ptId = pn.name
        if pn.dottedpath then {
            parentIsDotted = true
            gpId = pn.parent
            gcId = pn.child
        }
    }
    tsv: constOfSelfTypeMember :st :scope :ast :unitDecl :ptId :ncId
    if tsv.isConst then return tsv
    ptId = selfTypeNameIn :st :scope nameId: ptId
    hv: constOfDottedHead :st :scope :ast :unitDecl :nid :parentId :ptId :ncId :ln :co
    if hv.isConst then return hv
    # `z.build.os.linux` -- the ARM-PREDICATE form, asked FIRST for the
    # same reason the atomid case asks the constant first: `tsrc.os` is a
    # constant whose TYPE is a variant, so reading it as a qualified type
    # name would find that variant and answer with an arm where the
    # question was "does it hold this one".
    pv: evalConstNode :st :scope :ast :unitDecl nid: parentId
    if pv.kind.armKind then return (consteval.constArmChild :st :ast v: pv :ncId)
    if (readsSingletonCreate :st :scope :pv :ptId :ncId) then return pv
    if pv.kind.aggKind then return (constAggField :st :ast v: pv nameId: ncId)
    # a literal receiver (`"abcd".length`) or a qualified constant
    # (`quadfloat.LIB.length`): the parent is not a bare atom, so its value
    # comes from the recursive walk above rather than from a member read.
    if pv.kind.svalKind then {
        return (
            constStringDotted
            :st
            :scope
            :ast
            v: pv
            nameId: ncId
            nodeid: nid
            lineno: ln
            colno: co
        )
    }
    if pv.kind.ivalKind when ncId == zast.wellKnown.slot.wkNot then return (
        consteval.constIntNot
        :st
        v: (singletonAsBound :st v: pv)
    )
    if pv.kind.ivalKind or pv.kind.fvalKind then {
        return (
            consteval.constOfConversion
            :st
            :scope
            :ast
            v: (singletonAsBound :st v: pv)
            targetId: ncId
            :nid
            :ln
            :co
        )
    }
    # `io.filekind.dir` -- an arm of a type reached THROUGH its unit.
    # The parent is a dotted path of its own, so the type must be looked up
    # from that unit rather than from the one being evaluated.
    # `z.build.os` -- a constant of a unit reached through a path of units: a
    # subunit is no file unit, so no bare base names it
    iv: constOfInstanceMember :st :ast :parentId :ncId
    if iv.isConst then return iv
    if parentIsDotted then {
        return (evalConstViaDottedParent :st :scope :ast :unitDecl :parentId :gpId :gcId :ncId)
    }
    return ztypes.noConst
}

# readsSingletonCreate -- the path `ptId.ncId`, whose base has the value `pv`, is
# `cap.create` on a bare numeric generic parameter: the create of its singleton
# type, whose value is the type's one value, `pv` itself.
readsSingletonCreate: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    pv: ztypes.cval
    ptId: zast.nameid
    ncId: zast.nameid
} out bool is {
    if ncId != zast.wellKnown.slot.wkCreate then return false
    if (st.typing.isSingletonType tid: pv.numTid).not then return false
    return (numericParamOwnerFrom :st :scope nameId: ptId).notZero
}

# constOfSelfTypeMember -- `type.K` in a method's body, the path the body reads
# its type's bare `K` as (bodySelfTypeNameId): the bare name's value, which in
# a generic type is the instance's. noConst for any other path.
constOfSelfTypeMember: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    ptId: zast.nameid
    ncId: zast.nameid
} out ztypes.cval is {
    if ptId != zast.wellKnown.slot.wkType then return ztypes.noConst
    if (enclosingTypeDeclOf :st :scope).isZero then return ztypes.noConst
    return (constValueOfMemberId :st :scope :ast :unitDecl nameId: ncId)
}

# selfTypeNameIn -- the name `nameId` spells in `scope`, with `type` read as the
# enclosing type's name, as a body reads it (bodySelfTypeNameId).
selfTypeNameIn: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    nameId: zast.nameid
} out zast.nameid is {
    if nameId != zast.wellKnown.slot.wkType then return nameId
    td: enclosingTypeDeclOf :st :scope
    if td.isZero then return nameId
    return (st.typing.decls.get i: td).name
}

# constOfInstanceMember -- `wi.inner.sq`: a constant of the unit instance the
# walk typed the parent as; noConst for any other parent.
constOfInstanceMember: function {
    st: zenv.ZSymbolTable ast: Ast parentId: zast.nodeid ncId: zast.nameid
} out ztypes.cval is {
    put: walkTypeOf :st nid: parentId
    if (st.reg.typetypeOf typeId: put) != ztypes.ztypetype.unitType then return ztypes.noConst
    if (st.reg.genericOriginOf tid: put).isZero then return ztypes.noConst
    return (constValueOfMemberTidId :st :ast unitTid: put nameId: ncId)
}

# evalConstViaDottedParent -- `a.b.c` whose parent `a.b` is itself a path: a
# block's label position (`codes.slot.lf`, `zast.wellKnown.slot.wkThis`), an arm
# of a type reached through its unit (`io.filekind.dir`), or a constant of a unit
# reached through a path of units (`z.build.os`).
evalConstViaDottedParent: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    parentId: zast.nodeid
    gpId: zast.nodeid
    gcId: zast.nodeid
    ncId: zast.nameid
} out ztypes.cval is {
    sl: constStaticListSlotRead :st :scope :ast :unitDecl :gpId :gcId labelId: ncId
    if sl.isConst then return sl
    qa: evalConstArmViaUnit :st :scope :ast :gpId :gcId nameCountId: ncId
    if qa.isConst then return qa
    return (constOfUnitPathMember :st :scope :ast :parentId :ncId)
}

# evalConstNode -- the compile-time value of a node, or `none` when the node is
# not a constant shape. Silence is deliberate here -- a shape with no value is not automatically an
# error, because this walk also runs over definitions that are not constants at
# all. The E0600s below are the cases where a value was genuinely required and
# the operands were there.
evalConstNode: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
} out ztypes.cval is {
    plan: consteval.evalConstPlan :ast :nid
    # A NAME THAT READS A LOCAL IS NOT A CONSTANT, whatever a unit definition
    # of the same name says. This evaluator was written for unit-level
    # definitions, where there is no local scope to shadow one; asked about a
    # USE SITE inside a body it would resolve the unit member and quietly
    # answer for the wrong binding. The checker has already recorded which
    # atoms read a variable -- the two guards below are that record, one for a
    # bare name and one for the root of a path.
    if plan.shape.name then {
        if (st.typing.atomVariableId.get key: nid).some then return ztypes.noConst
        # a literal never needs an OWNED name, and every numeric literal in the
        # program reaches this arm. The member pull below takes the id.
        isLit: false
        litVal: ztypes.noConst
        noName: false
        nv: zast.nameTextAt :ast ref: plan.nameId
        if nv.length == 0 then noName = true
        if noName.not then {
            isLit = isNumericLiteralName name: nv.stringView
            if isLit then litVal = consteval.constLiteralValue :st name: nv.stringView
        }
        nv.drop
        if noName then return ztypes.noConst
        if isLit then return litVal
        ncv: st.typing.narrowedConstReads.get key: nid
        match (
            ncv
        ) case some then return ncv case none then null
        nk: st.walk.constNarrows.length
        for nk > 0 loop {
            nk = nk - 1
            cn: st.walk.constNarrows.get i: nk
            if cn.name == plan.nameId then return cn.value
        }
        if st.walk.constMono.notZero or st.typing.curMonoStamp.notZero then {
            gv: monoNumericParamValue :st nameId: plan.nameId
            if gv.isConst then return gv
        }
        return (constValueOfMemberId :st :scope :ast :unitDecl nameId: plan.nameId)
    }
    if plan.shape.atomstring then {
        return (
            consteval.evalConstString
            :st
            :ast
            :nid
            parts: plan.parts
            partId: plan.innerId
            ln: plan.ln
            co: plan.co
        )
    }
    if plan.shape.dottedpath then {
        vp: (
            numericParamThroughName
            :st
            :ast
            :unitDecl
            :nid
            parentId: plan.parentId
            childId: plan.childId
        )
        if vp.isConst then return vp
        if (st.typing.atomVariableId.get key: plan.parentId).some then return ztypes.noConst
        return (
            evalConstDotted
            :st
            :scope
            :ast
            :unitDecl
            :nid
            parentId: plan.parentId
            childId: plan.childId
            ln: plan.ln
            co: plan.co
        )
    }
    if plan.shape.operator then return (constOfBinop :st :scope :ast :unitDecl :nid)
    if plan.shape.call then return (consteval.constOfCall :st :scope :ast :unitDecl :nid)
    if plan.shape.ifexpr then {
        fb: foldIfBranch :st :scope :ast :unitDecl :nid
        if fb.known.not then return ztypes.noConst
        if fb.stmt.isZero then return ztypes.noConst
        return (constBlockValue :st :scope :ast :unitDecl nid: fb.stmt)
    }
    if plan.shape.caseexpr then return (constOfMatch :st :scope :ast :unitDecl :nid)
    if plan.shape.listblock then return (constOfList :st :scope :ast :unitDecl :nid want: ztypes.tid
    )
    return ztypes.noConst
}

# numericParamThroughName -- `B5.cap`, `four.cap`, `(Box cap: 5).cap`: a numeric
# generic parameter read through a name of an instance, whose value the body's
# check recorded (checkNumericParamMember), as the instance's one value. none for
# any other path.
numericParamThroughName: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
    parentId: zast.nodeid
    childId: zast.nodeid
} out ztypes.cval is {
    if (st.typing.numericParamRead.has key: nid) then {
        cv: st.typing.nodeConstAt :nid
        if cv.isConst then return cv
    }
    # asked before the body's check reaches the path (a folding `if`): a type
    # application's parameter is the argument it is given there,
    # `(Box cap: 5).cap`; a base that names an instance -- an alias of one, a
    # unit instance -- by name
    leaf: atomNameId :ast n: (ast.nodes.get i: childId)
    pcall: callRefAt :ast nid: parentId
    if pcall.nid.notZero then return (
        typeApplicationArgValue
        :st
        :ast
        :unitDecl
        call: pcall
        param: leaf
    )
    rootId: atomNameId :ast n: (ast.nodes.get i: parentId)
    if rootId.isZero or (st.typing.atomVariableId.get key: parentId).some then return ztypes.noConst
    # read without demanding: a name not resolved yet answers when the body
    # reaches it
    rd: nearestDeclOf :st scope: st.curScope baseId: rootId
    if rd.isZero then return ztypes.noConst
    it: st.typing.declTypeOf declId: rd
    if it.isZero or (st.reg.genericOriginOf tid: it).isZero then return ztypes.noConst
    return (monoNumericArg :st mono: it nameId: leaf)
}

# typeApplicationArgValue -- the value a type application `call` gives its
# template's numeric generic parameter `param`, `5` in `(Box cap: 5)`; none when
# the callee names no template with that parameter or the argument is absent.
typeApplicationArgValue: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    call: callref
    param: zast.nameid
} out ztypes.cval is {
    # the template read without demanding it, by the callee's name
    cn: atomNameId :ast n: (ast.nodes.get i: call.callable)
    if cn.isZero then return ztypes.noConst
    td: nearestDeclOf :st scope: st.curScope baseId: cn
    if td.isZero then return ztypes.noConst
    if (st.reg.genericParamConstraintOf tdecl: td paramName: param
    ).numKind.has.not then return ztypes.noConst
    k: u64
    for k < call.nargs loop {
        arg: argRefAt :ast nid: (zast.callArgAt :ast nid: call.nid i: k)
        k = k + 1
        if arg.nid.notZero when arg.name == param then return (
            evalConstNode
            :st
            scope: st.curScope
            :ast
            :unitDecl
            nid: arg.operation
        )
    }
    return ztypes.noConst
}

# monoNumericParamValue -- a bare name's value in a mono's walk when it names a
# numeric generic parameter of the mono's template, or -- in the walk of a unit
# function's own instance -- of the unit's (walkOwnerMono): the argument the
# mono was made with, recorded on it at mint. none for any other name or walk.
monoNumericParamValue: function {
    st: zenv.ZSymbolTable.view nameId: zast.nameid
} out ztypes.cval is {
    m: st.walk.constMono
    if m.isZero then m = st.typing.curMonoStamp
    v: monoNumericArg :st mono: m :nameId
    if v.isConst or st.walk.constMono.notZero then return v
    own: walkOwnerMono :st
    if own == m then return v
    return (monoNumericArg :st mono: own :nameId)
}

# monoSingletonOf -- in a mono's walk, the singleton type a bare name is when
# it names a numeric generic parameter of the mono's template, or -- in the walk
# of a unit function's own instance -- of the unit's (walkOwnerMono); 0 for any
# other name or walk.
monoSingletonOf: function {st: zenv.ZSymbolTable.view nameId: zast.nameid} out ztypes.tid is {
    m: st.walk.constMono
    if m.isZero then m = st.typing.curMonoStamp
    if m.isZero then return ztypes.tid
    s: st.typing.singletonOf instance: m param: nameId
    if s.notZero or st.walk.constMono.notZero then return s
    return (st.typing.singletonOf instance: (walkOwnerMono :st) param: nameId)
}

# singletonAsBound -- a constant typed as a numeric parameter's singleton type,
# as its bound's: the singleton's members are the bound's, so an operation on
# it folds as the bound's does (`cap * 2` is a u32) and a conversion converts
# from the bound.
singletonAsBound: function {st: zenv.ZSymbolTable.view v: ztypes.cval} out ztypes.cval is {
    if (st.typing.isSingletonType tid: v.numTid).not then return v
    return (ztypes.typedConst c: v numTid: (st.typing.typedefBaseTidOf tid: v.numTid))
}

# monoNumericArg -- the value mono `mono` was made with for its template's
# numeric generic parameter `nameId`, typed as the parameter's singleton type
# when the mono has one; none when that is no such parameter.
monoNumericArg: function {
    st: zenv.ZSymbolTable.view mono: ztypes.tid nameId: zast.nameid
} out ztypes.cval is {
    sg: st.typing.singletonOf instance: mono param: nameId
    if sg.notZero then return (st.typing.singletonValueOf tid: sg)
    origin: st.reg.genericOriginOf tid: mono
    if origin.isZero then return ztypes.noConst
    tdecl: templateDeclOf reg: st.reg typing: st.typing tid: origin
    if (st.reg.genericParamConstraintOf :tdecl paramName: nameId
    ).numKind.has.not then return ztypes.noConst
    return (st.typing.memberConstOf parentTypeId: mono :nameId)
}

# reportUnitConstantShape -- the diagnostic for a unit-level definition whose
# value is not a literal. Unit constants inline literal numeric values BY
# DESIGN (resolveConstantDef registers the literal, suffixed-literal and
# constant-expression shapes only); without a report the definition registers
# nothing and every downstream read blames the reader instead.
reportUnitConstantShape: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u64
    msg: String
    hint: String
} is {
    un: "unit constants inline literal numeric values".string
    addErrorWithHint :st :nodeid :lineno :colno e: zast.err.typeError :msg note: un :hint :width
}

# reportUnitConstantRef -- the callee of a unit-level construction names
# nothing in scope. Reporting a malformed CONSTANT there blames the shape of a
# definition whose callee does not exist; the reference is what is wrong. The
# usual way here is a dependency unit naming a main-unit definition, which the
# language does not allow for a constant or a namespace either.
reportUnitConstantRef: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u64
    msg: String
} is {
    (
        addErrorWithHint
        :st
        :nodeid
        :lineno
        :colno
        e: zast.err.badReference
        :msg
        note: String
        hint: String
        :width
    )
}

# staticListConstantIsConstruction -- a unit-level constant reading a list's
# element or count (`ONE: primes.1`), the list being row `row`. Any other
# member is no element, and the shape check asks the list about it as a body
# does (checkConstantMethodCall). True when the
# element is not a builtin number or a string -- `out byteid` makes each one a
# byteid -- so the read builds a value rather than naming a constant, and is
# refused as a construction is.
staticListConstantIsConstruction: function {
    st: zenv.ZSymbolTable
    ast: Ast
    # the member read off it
    sfTy: StringView
    row: u32
} out bool is {
    mid: nameIdOf :ast name: sfTy
    if (listMemberType :st :ast :row nameId: mid).isZero then return false
    if mid == zast.wellKnown.slot.wkLength then return false
    return (staticListElemFolds :ast :st elemTid: (st.typing.constAggs.get i: row.u64).elem).not
}

# listDeclRow -- the row of list declaration `declId`, folded on first ask; 0
# when the declaration is no list, or the list has no row.
listDeclRow: function {ast: Ast st: zenv.ZSymbolTable declId: ztypes.declid} out u32 is {
    if declId.isZero then return 0
    if (st.typing.decls.get i: declId).kind.staticListDecl.not then return 0
    constFoldDecl :ast :st :declId
    v: constValueOfDecl :st :declId
    if v.kind.aggKind.not then return 0
    return v.aggId
}

# resolveDottedConstantDef -- a unit-level constant whose value is a dotted path.
# That is a width-suffixed literal (`1.u32`, the child naming the type), a variant
# arm read (`false: bool.false` -- a compile-time value, the shape core.z uses 41
# times), the unit-alias form resolveDef registers, or a member read on a type.
resolveDottedConstantDef: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    defn: dpref
    sfLit: StringView
    sfTy: StringView
} is {
    # `origin: Point.create x: 0` parses as TWO unit members -- the
    # dotted value `Point.create` and a separate constant `x: 0` --
    # so the construction never reaches this pass as a call. A dotted
    # value is a suffixed literal (`1.u32`) or the unit-alias form
    # (`astnode: zast.astnode`, whose parent names a UNIT and which
    # resolveDef registers); anything else is a member read on a type.
    if (isNumericLiteralName name: sfLit).not then {
        # `false: bool.false` reads a variant ARM -- a compile-time
        # value, and the shape core.z uses 41 times. A FUNCTION member
        # (`Point.create`) is a runtime construction instead, which a
        # unit constant cannot hold.
        # The parent's FAMILY decides: a variant or union parent means
        # the child is an ARM -- a compile-time value. Any other family
        # means a member read or a construction. `declDefTypetype`
        # classifies a definition without resolving it, which is what
        # reaches a SAME-UNIT type at this stage; the typeref walk
        # answers for the resolvable ones.
        isCtor: false
        # a list's element or count (`ONE: primes.1`)
        ldr: (
            listDeclRow
            :ast
            :st
            declId: (declOfUnitDef :st :scope :unitDecl nameId: (nameIdOf :ast name: sfLit))
        )
        if ldr != 0 then isCtor = staticListConstantIsConstruction :st :ast :sfTy row: ldr
        # a unit's member, the unit named or aliased (`c: inner`), is no
        # construction
        namesUnit: (
            (nameDenotesUnit :st :scope nameId: (nameIdOf :ast name: sfLit)) or
            (qualifierUnitDecl :st :scope :ast nid: defn.parent).notZero
        )
        if ldr == 0 when namesUnit.not then {
            ptt: ztypes.ztypetype.nullType
            known: false
            {
                pdc: declOfUnitDef :st :scope :unitDecl nameId: (nameIdOf :ast name: sfLit)
                if pdc.notZero then {
                    pdt: resolve.declDefTypetype :st :ast declId: pdc
                    if pdt.some then {
                        ptt = pdt
                        known = true
                    }
                }
            }
            if known.not then {
                pTo: bodies.walkLookupTyperef :st :scope :ast :unitDecl base: sfLit
                if pTo.some then {
                    ptt = st.reg.typetypeOf typeId: pTo
                    known = true
                }
            }
            # a member the type does not declare is no construction: the read
            # names nothing, and says so
            if known when (
                typeref.reportMissingTypeMember
                :st
                :scope
                :ast
                :unitDecl
                op: defn.nid
            ) then known = false
            if known then {
                # a variant or union parent names an ARM, and a UNIT parent
                # reads a member of it -- which is what every cross-unit
                # re-export is. Only a plain TYPE parent makes the read a
                # construction.
                isCtor = (
                    (ptt != ztypes.ztypetype.variantType) and
                    (ptt != ztypes.ztypetype.unionType) and
                    (ptt != ztypes.ztypetype.unitType)
                )
            }
        }
        # ASK THE CONSTANT FIRST. `LEN: LIB.length` reads a member of
        # a string CONSTANT, and LIB's own type is StringView -- a
        # class -- so the typeref walk above finds a non-variant parent
        # and calls the read a construction. The value settles it. A list's
        # value is no answer: its typedef element builds a value.
        if isCtor when ldr == 0 then {
            pcs: constValueOfMember :st :scope :ast :unitDecl defName: sfLit
            if pcs.isConst then isCtor = false
        }
        # a member read through a function's name is the function's, and the
        # shape check asks it as a body does
        if isCtor when (calleeFnTid :st :scope :ast :unitDecl callableId: defn.parent
        ).notZero then isCtor = false
        # a type's `as` constant (`cfg.LIMIT`) is a value, and so is `row.create`,
        # a data value in a static position: the value channel folds both
        if isCtor when ldr == 0 then {
            cId: atomNameId :ast n: (ast.nodes.get i: defn.child)
            sct: (
                typeNamedFrom
                :st
                :scope
                :ast
                lookupUnit: unitDecl
                typeNameId: (nameIdOf :ast name: sfLit)
            )
            sctD: st.typing.declIdOfType typeId: sct
            cmD: st.typing.declFindChild parentDeclId: sctD nameId: cId
            if cmD.notZero when (
                typeMemberHoldsConstant
                :st
                :ast
                typeDecl: sctD
                defNode: (st.typing.decls.get i: cmD).node
            ) then isCtor = false
            if cId == zast.wellKnown.slot.wkCreate when (st.reg.isStaticOf tid: sct
            ) then isCtor = false
        }
        if isCtor then {
            dm: "a unit-level constant takes a literal value, not a construction".string
            dh: "construct it inside a function, or make '\{defName}' a function that returns the value"
            (
                reportUnitConstantShape
                :st
                nodeid: defn.nid
                lineno: defn.lineno
                colno: defn.colno
                width: sfLit.length
                msg: dm
                hint: dh
            )
        }
    }
    if (isNumericLiteralName name: sfLit) then {
        # THE SAME FIT CHECK A BODY PERFORMS. Without it `big: 300.u8` at unit
        # level was accepted, emitted `uint8_t z_v1 = 300;` and printed 44 --
        # gcc's -Woverflow was the only thing that noticed, and warn-check
        # covers only the four emitted drivers.
        (
            consteval.checkLiteralFits
            :st
            nodeid: defn.nid
            lineno: defn.lineno
            colno: defn.colno
            lit: sfLit
            target: sfTy
        )
        # A suffix that names no numeric type is no conversion: it is a member
        # read on the literal's materialised type, which the shape check asks
        # about as a body does (constantMemberTid)
    }
}

# resolveBinopConstantDef -- a unit-level constant whose value is a binary
# expression: the operand walk stamps the refs and the binop. The constant's
# type is its value's, registered from the fold; a definition that yields none
# is refused on its door, where resolveConstantMember asks
# diagnoseUnfoldedConstant why.
resolveBinopConstantDef: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defnId: zast.nodeid
} is {
    constantOperandType :st :scope :ast :unitDecl nid: defnId
}

# staticValueCall -- the unit-level definition `defName: defn` builds a data
# value (`row 5`) or a choice value (`form.count 3`): the head's kind decides,
# and the value channel folds it (constOfStaticFields, constOfStaticChoice).
staticValueCall: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    defn: callref
} out bool is {
    ct: staticCtorHead :st :scope :ast :unitDecl callableId: defn.callable
    if ct.isZero then ct = staticChoiceHead :st :scope :ast :unitDecl callableId: defn.callable
    return ct.notZero
}

# reportMissingHeadMember -- the head `callable` of a call outside a function
# (a unit-level constant's, a type constant's) is `unit.member` and the unit
# declares no such member: reported at the member, as a body reports the same
# read. False when the head is another shape or the member exists.
reportMissingHeadMember: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    callable: zast.nodeid
} out bool is {
    qualId: zast.nodeid
    memberNid: zast.nodeid
    {
        hn: ast.nodes.get i: callable
        match (
            hn
        ) case dottedpath then {
            if (ast.nodes.get i: hn.parent).atomid then {
                qualId = hn.parent
                memberNid = hn.child
            }
        } else null
    }
    memberId: atomNameId :ast n: (ast.nodes.get i: memberNid)
    if qualId.isZero or memberId.isZero then return false
    ud: qualifierUnitDecl :st :scope :ast nid: qualId
    if ud.isZero then return false
    if (st.typing.declFindChild parentDeclId: ud nameId: memberId).notZero then return false
    if (resolve.declOfUnitDefIds typing: st.typing unitDecl: ud nameId: memberId
    ).notZero then return false
    cn: ast.nodes.get i: memberNid
    un: zast.nameTextAt :ast ref: (atomNameId :ast n: (ast.nodes.get i: qualId))
    mn: zast.nameTextAt :ast ref: memberId
    (
        addErrorWithHint
        :st
        nodeid: (nodeId n: cn)
        lineno: (nodeLine n: cn)
        colno: (nodeCol n: cn)
        e: zast.err.typeError
        msg: "unit '\{un}' has no member '\{mn}'"
        note: (resolve.unitFileNote :st :ast unitDecl: ud)
        hint: String
        width: mn.length
    )
    return true
}

# resolveCalledConstantDef -- a unit-level constant whose value is a CALL. A
# construction is not a literal, but the parenthesised form is the generic-unit
# instantiation (`intmath: (genmath t: i64)`) and stays legal -- its callee names
# a UNIT, which is the test here. A unit declared in THIS file has no registry
# entry yet and a generic-unit binding is no file unit at all, so the Decl tree
# answers both.
resolveCalledConstantDef: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    defn: callref
} is {
    # the callee's root name
    cbn: String
    ccn: ast.nodes.get i: defn.callable
    cbn = typeargs.atomName :ast n: ccn
    if cbn.length == 0 then cbn = typeargs.dottedRootName :ast n: ccn
    if cbn.length > 0 then {
        # a unit declared in THIS file has no registry entry yet, and
        # a generic-unit binding is no file unit at all: the Decl tree
        # answers both -- without it every `intmath: (mathops t: i64)`
        # reads as a construction.
        # a head reached through a unit (`c.impl`) names a member that unit
        # declares, or the construction has nothing to build
        if (reportMissingHeadMember :st :scope :ast callable: defn.callable) then return
        cbu: nameDenotesUnit :st :scope nameId: (nameIdOf :ast name: cbn.stringView)
        if cbu.not then {
            # the same scope walk the instantiation collector uses --
            # this namespace, each enclosing one, the unit root, then a
            # file unit of that name. declOfUnitDef reached only a
            # TOP-LEVEL binding of this unit, so a template nested in a
            # namespace, or named through another unit, read as a
            # construction and was reported as a malformed constant.
            cscp: resolve.unitScopeOf typing: st.typing declId: scope
            csg: ListVal zast.nameid
            instCallablePath :ast op: (ast.nodes.get i: defn.callable) segs: csg
            cdc: instTemplateDecl :st scopeDeclId: cscp segs: csg
            # a unit template written in a generic unit is applied as a type
            # is, below (collectMainInstantiations)
            if cdc.notZero when (
                declIsUnitTemplate
                :st
                :ast
                declId: (st.typing.declParentOf declId: cdc)
            ).not then {
                cdo: st.typing.decls.get i: cdc
                if cdo.kind.unitDecl then cbu = true
            }
        }
        # ASK THE CONSTANT FIRST, the same ordering the dotted-path
        # value read uses: `CT: (LIB.contains needle: "x")` is a call
        # whose receiver is a string CONSTANT, so it is a value and not
        # a construction, and so is `(N.compare rhs: 3)` on a number and
        # `(twice n: 2)` on a function. Classifying by the callee's shape
        # alone calls every one of them a construction.
        if cbu.not then {
            crv: constValueOfMember :st :scope :ast :unitDecl defName: cbn.stringView
            # any constant's method -- a literal's too (`8.u32.compare rhs: 2`)
            # -- and a call of a function, is a call: the shape check asks it
            # as a body does, and a value or "no compile-time value" is the
            # evaluator's answer
            if crv.isConst or (isNumericLiteralName name: cbn.stringView) then cbu = true
            if (calleeFnTid :st :scope :ast :unitDecl callableId: defn.callable
            ).notZero then cbu = true
        }
        if cbu.not then {
            # found the way a type reference finds its template: a name the
            # CURRENT unit defines wins even before it is declared
            ctpl: resolve.monoRefTemplateTid :st :scope :ast :unitDecl name: cbn.stringView
            # a head that is a type application's -- a path through a unit
            # (`pr.Pair`) included -- names its template by the one answer
            htpl: (
                typeargs.typeApplicationTemplate
                :st
                :scope
                :ast
                :unitDecl
                callableNid: defn.callable
            )
            if htpl.notZero then ctpl = htpl
            ckn: ctpl.notZero
            # a GENERIC template is the one callee shape that can be
            # INSTANTIATED rather than constructed, so `Strs: (List String)`
            # is a type alias while `origin: Point.create x: 0` stays a
            # construction: `create` is a member of a concrete type and is not
            # generic.
            if ctpl.notZero then {
                cgen: false
                if ctpl < st.reg.nextTid then {
                    ctr: st.reg.typeById.get i: ctpl
                    cgen = ctr.isgeneric
                }
                errA: st.typing.errors.length
                if cgen when (
                    resolve.resolveInstantiatedAlias
                    :ast
                    :st
                    :unitDecl
                    :scope
                    :defName
                    :defn
                ) then cbu = true
                # an instantiation refused for its arguments is reported there
                if cgen when st.typing.errors.length > errA then cbu = true
            }
            if ckn.not then {
                crm: "Unknown reference '\{cbn}'"
                (
                    reportUnitConstantRef
                    :st
                    nodeid: defn.nid
                    lineno: defn.lineno
                    colno: defn.colno
                    width: cbn.length
                    msg: crm
                )
                cbu = true
            }
        }
        # a numeric typedef applied to one value (`NONE: rid 0`) is a constant of
        # that typedef: the value channel folds it and checks it fits
        if cbu.not when defn.nargs == 1 when (
            declare.typedefOverNumericDecl
            :st
            :ast
            :unitDecl
            :scope
            callableId: defn.callable
        ) then cbu = true
        # a data or choice value is built here, in a static position
        if cbu.not when (staticValueCall :st :scope :ast :unitDecl :defn) then cbu = true
        if cbu.not then {
            cm: "a unit-level constant takes a literal value, not a construction".string
            ch: "construct it inside a function, or make '\{defName}' a function that returns the value"
            (
                reportUnitConstantShape
                :st
                nodeid: defn.nid
                lineno: defn.lineno
                colno: defn.colno
                width: cbn.length
                msg: cm
                hint: ch
            )
        }
    }
}


# resolveDottedConstantRead -- a unit constant whose value is a dotted path, taken
# apart for resolveDottedConstantDef: the base and the member, and the unit a
# `unit.Type.member` path is read through.
resolveDottedConstantRead: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    defnId: zast.nodeid
} is {
    if (typeref.refuseMisplacedImplement :st :ast nid: defnId) then return
    dr: dpRefAt :ast nid: defnId
    sfLit: String
    sfTy: String
    # `unit.Type.member`: the parent is itself a path, through a unit
    qUnitPath: zast.nodeid
    # `blk.slot.label`: the parent is a block's `slot`
    viaSlot: false
    {
        sfB: ast.nodes.get i: dr.parent
        if sfB.atomid then sfLit = zast.nameTextCopy :ast ref: sfB.name
        if sfB.dottedpath then {
            gpc: ast.nodes.get i: sfB.child
            if gpc.atomid then {
                qUnitPath = sfB.parent
                sfLit = zast.nameTextCopy :ast ref: gpc.name
                viaSlot = gpc.name == zast.wellKnown.slot.wkSlot
            }
        }
        sfC: ast.nodes.get i: dr.child
        if sfC.atomid then sfTy = zast.nameTextCopy :ast ref: sfC.name
    }
    # the read is classified in the unit its path names, as the same
    # read written there would be
    lookupUnit: unitDecl
    if qUnitPath.notZero then lookupUnit = unitDeclOfPath :st :scope :ast nid: qUnitPath
    # a label's position is a constant when its index type folds: a typedef
    # index is a value of its own type, as a typedef element is
    if viaSlot when lookupUnit.isZero when (evalConstNode :st :scope :ast :unitDecl nid: defnId
    ).kind.none then {
        (
            reportUnitConstantShape
            :st
            nodeid: dr.nid
            lineno: dr.lineno
            colno: dr.colno
            width: 4
            msg: "a unit-level constant takes a literal value, not a construction".string
            hint: "read the position inside a function, where it is a value of the list's index type".string
        )
        return
    }
    # a path to an instance's numeric generic parameter (`X: B5.cap`) names
    # its singleton type: an alias, which resolveAliasKey registers
    xd: declOfUnitDef :st :scope :unitDecl nameId: (nameIdOf :ast name: defName)
    if (singletonPathAlias :st :ast declId: xd :scope).notZero then return
    if sfLit.length > 0 when sfTy.length > 0 when lookupUnit.notZero then {
        (
            resolveDottedConstantDef
            :ast
            :st
            unitDecl: lookupUnit
            scope: (if qUnitPath.isZero then scope else lookupUnit)
            :defName
            defn: dr
            sfLit: sfLit.stringView
            sfTy: sfTy.stringView
        )
    }
}

# resolveConstantDef -- one definition: a numeric-literal atomid is a unit
# constant, recorded as the literal's concrete default (i64 / f64, which
# materialiseLiteral demands). The definition's own nodes stay unstamped.
resolveConstantDef: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    defnId: zast.nodeid
} is {
    # AN INFIX CALL IS A BINARY OPERATION, NOT A CONSTRUCTION. `COMBINED:
    # OFFSET + SCALE` folds like the same expression written any other way,
    # and the call arm below would report it as a construction instead.
    ipI: operatorPartsAt :ast nid: defnId
    if ipI.found then {
        if (refuseNumericOperator :st :ast call: (callRefAt :ast nid: defnId)) then {
            # the one mistake: the evaluator's own answer for the shape is not asked
            st.walk.constShapesReported.add item: defnId
            return
        }
        resolveBinopConstantDef :ast :st :unitDecl :scope :defnId
        return
    }
    arm: declare.rowArmAt :ast nid: defnId
    match (
        arm
    ) case ifexpr then {
        # a compile-time conditional: its branches decide the constant's type
        resolveUnitIfDef :st :scope :ast :unitDecl nid: defnId
    } case dottedpath then {
        # a width-suffixed numeric literal (`1.u32`) is a dotted path over the
        # literal, not an atom: the child names the constant's type
        resolveDottedConstantRead :ast :st :unitDecl :scope :defName :defnId
    } case call then {
        # A construction is not a literal. A generic-unit instantiation
        # (`intmath: (genmath t: i64)`) stays legal, and the test here is that
        # its callee names a UNIT -- not that it is parenthesised, which changes
        # nothing: bare and wrapped resolve identically. The definition arms
        # (functiondef, objectdef, unitdef, listblock) reach this leg too and
        # must never be reported.
        cdr: callRefAt :ast nid: defnId
        resolveCalledConstantDef :ast :st :unitDecl :scope :defName defn: cdr
    } else null
}

# constRegisterValueType -- give a constant the type of its VALUE, for the
# shapes the shape-driven pass registers nothing for: a string literal, a
# concatenation, and any of the static string methods (`LIB.length` is an i64,
# `LIB.startsWith ...` a bool). A constant IS its value, so its type is the
# value's.
#
# A folded string types as StringView, never String, whatever produced it. The
# fold replaces the call outright and the value materialises as a static view
# -- nothing is allocated and nothing is owned -- so typing it String would
# hand a use site an owned type backed by a static. `+`'s declared `out String`
# governs the RUN-TIME path only.
#
# The shape-driven registrations win wherever they spoke: they know about
# typedefs and literal suffixes that a value does not carry.
constRegisterValueType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    v: ztypes.cval
} is {
    if v.kind.none then return
    defNameId: zast.poolFind pool: ast.names text: defName
    if defNameId.isZero then return
    ownerDecl: constOwnerDeclFor :st :scope :ast :unitDecl :defName
    constRegisterValueTypeAt :st :scope :ast :ownerDecl nameId: defNameId :v
}

# constRegisterValueTypeAt -- the registration itself, addressed by the owner's
# declaration. A constant's type is the one its VALUE carries, so this is where
# a constant becomes a member of its owner at all.
constRegisterValueTypeAt: function {
    ast: Ast
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ownerDecl: ztypes.declid
    nameId: zast.nameid
    v: ztypes.cval
} is {
    if v.kind.none then return
    utid: st.typing.declTypeOf declId: ownerDecl
    if utid.isZero then return
    nid: nameId
    if nid.isZero then return
    eo: st.typing.declChildOfId parentTypeId: utid nameId: nid
    if eo.some then return
    vt: constValueTid :st :scope :ast :v
    # an untyped string a field or a parameter is declared by is that member's
    # type, so it takes a default as a number does: text in a static position
    # (a data field), a StringView elsewhere. A constant keeps the textliteral
    if vt == st.reg.literalTextTid when (memberDeclaredByDefault :st :ownerDecl :nameId) then {
        vt = stdTid :ast :st wk: zast.wellKnown.slot.tyStringView
        if (st.reg.isStaticOf tid: utid) then vt = stdTid :ast :st wk: zast.wellKnown.slot.tyText
    }
    if vt.notZero then st.typing.setMemberType parentTypeId: utid nameId: nid childTypeId: vt
}

# memberDeclaredByDefault -- the member `nameId` of the declaration `ownerDecl`
# is a field or a parameter, declared by its default value; false for a
# constant.
memberDeclaredByDefault: function {
    st: zenv.ZSymbolTable.view ownerDecl: ztypes.declid nameId: zast.nameid
} out bool is {
    md: st.typing.declFindChild parentDeclId: ownerDecl :nameId
    if md.isZero then return false
    k: (st.typing.decls.get i: md).kind
    return k.fieldDecl or k.paramDecl
}

# constValueTid -- the type a compile-time value carries: an arm its owning
# type, a number i64 or f64, an untyped string textliteral. 0 for no value.
constValueTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    v: ztypes.cval
} out ztypes.tid is {
    if v.kind.armKind then return v.armTid
    if v.kind.aggKind then return (st.typing.constAggs.get i: v.aggId.u64).tid
    if v.kind.fnKind then return (st.typing.decls.get i: v.fnDecl).typeId
    if v.numTid.notZero then return v.numTid
    recvBaseTid: ""
    if v.kind.ivalKind then recvBaseTid = "i64"
    if v.kind.fvalKind then recvBaseTid = "f64"
    # an untyped string is a literal: its destination converts it
    if v.kind.svalKind then return st.reg.literalTextTid
    if recvBaseTid.length == 0 then return ztypes.tid.zero
    # the constant's type is a reference to a system type: it resolves on
    # discovery, like every other reference, so the registration never depends
    # on some other reference having resolved the type first
    bo: resolve.descendNamed :st :scope :ast unitDecl: st.typing.systemUnitRoot name: recvBaseTid
    return bo
}

# instantiatedAliasFold -- the alias-shaped door into constFoldDecl. A
# unit-level definition whose value INSTANTIATES a generic template declares a
# TYPE, not a constant, and like a constant it declares itself when it is first
# READ: a signature mentioning `Strs` may be resolved before the eager pass
# reaches `Strs: (List String)`, and without this door it would resolve to a
# shell of that name while the values carry the mono. false when the definition
# is not that shape, which leaves the fold to the constant channel.
instantiatedAliasFold: function {
    ast: Ast
    st: zenv.ZSymbolTable
    declId: ztypes.declid
} out bool is {
    dnode: zast.nodeid
    decl: st.typing.decls.get i: declId
    dnode = decl.node
    decl.drop
    if dnode.isZero then return false
    opId: zast.nodeid
    nop: ast.nodes.get i: dnode
    if nop.namedoperation then opId = nop.operation
    if opId.isZero then return false
    isCall: false
    arm: declare.rowArmAt :ast nid: opId
    if arm.call then isCall = true
    if isCall.not then return false
    own: st.typing.declParentOf :declId
    if own.isZero then return false
    unm: unitRootOfDecl typing: st.typing :declId
    if unm.isZero then return false
    dnm: zast.nameTextCopy :ast ref: (st.typing.declNameOf :declId)
    if dnm.length == 0 then return false
    tdc: callRefAt :ast nid: opId
    # a value that names its own definition, directly or through another
    # (`foo: bar foo`, `Strs: (List Strs)`, `foo: (foo n: 3)`), re-enters here
    # while its head or its arguments resolve: that is a cycle, reported once,
    # and the re-entry is answered as a constant would be. The definition is
    # open from here on, so a head that names it is caught as an argument is.
    open: false
    for each od: st.walk.aliasFoldsOpen loop {
        if od == declId then open = true
    }
    if open then {
        resolve.reportAliasCycle :st :ast :declId :dnode
        return false
    }
    st.walk.aliasFoldsOpen.append declId
    noTemplate: appliesNoTemplate :st :ast unitDecl: unm scope: own call: tdc
    # a function's call is a call, never an instance
    isFnCall: (
        tdc.infix.not and
        (calleeFnTid :st scope: own :ast unitDecl: unm callableId: tdc.callable).notZero
    )
    if noTemplate or isFnCall then {
        st.walk.aliasFoldsOpen.pop
        return false
    }
    cdr: callRefAt :ast nid: opId
    folded: (
        resolve.resolveInstantiatedAlias
        :ast
        :st
        unitDecl: unm
        scope: own
        defName: dnm.stringView
        defn: cdr
    )
    st.walk.aliasFoldsOpen.pop
    return folded
}

# appliesNoTemplate -- a unit-level call that instantiates nothing, so the
# constant channel folds it: a numeric typedef applied to one value (`NONE: rid
# 0`), a head naming a user type that is not generic -- a data type's fields
# (constOfStaticFields), or a record's, which is no constant at all -- or a
# choice's arm (constOfStaticChoice). A
# function head is a call, which the alias walk checks for cycles.
appliesNoTemplate: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    call: callref
} out bool is {
    if call.nargs == 1 when (
        declare.typedefOverNumericDecl
        :st
        :ast
        :unitDecl
        :scope
        callableId: call.callable
    ) then return true
    # a choice value (constOfStaticChoice) names an arm, not a template
    chHead: staticChoiceHead :st :scope :ast :unitDecl callableId: call.callable
    if chHead.notZero then return true
    htpl: typeargs.typeApplicationTemplate :st :scope :ast :unitDecl callableNid: call.callable
    if htpl.isZero or (st.reg.isGenericOf tid: htpl) then return false
    return (st.reg.typetypeOf typeId: htpl).isUserFamily
}

# constFoldDecl -- fold the constant `declId` declares and register the type its
# value carries, addressed by the DECLARATION alone. This is the door a lookup
# takes when it finds a constant that has not folded yet: a constant's TYPE
# comes from its VALUE, so the fold is what declares it, exactly as an
# unresolved re-export is declared by following its alias.
constFoldDecl: function {
    ast: Ast
    st: zenv.ZSymbolTable
    declId: ztypes.declid
} is {
    if declId.isZero then return
    if (instantiatedAliasFold :ast :st :declId) then return
    own: st.typing.declParentOf :declId
    if own.isZero then return
    nmNode: st.typing.declNameOf :declId
    if nmNode.isZero then return
    dnode: zast.nodeid
    decl: st.typing.decls.get i: declId
    dnode = decl.node
    decl.drop
    if dnode.isZero then return
    opId: zast.nodeid
    {
        dn: ast.nodes.get i: dnode
        if dn.namedoperation then opId = dn.operation
    }
    # a lookup reaches a template's constant over its numeric parameter as the
    # constant pass does (resolveConstantMember): only an instance has its value
    if (forInstancesOnly :st :ast owner: own defnId: opId) then return
    unm: unitRootOfDecl typing: st.typing :declId
    if unm.isZero then return
    constFailClear :st
    valFound: (
        bodies.constValueOfMemberAt
        :st
        :ast
        unitDecl: unm
        ownerDecl: own
        nameId: nmNode
        defNodeId: dnode
    )
    constRegisterValueTypeAt :st scope: own :ast ownerDecl: own nameId: nmNode v: valFound
    if opId.notZero when (
        checkConstantMethodShape
        :st
        scope: own
        :ast
        unitDecl: unm
        nid: opId
    ) then constFailClear :st
    reportPendingConstFail :st
    # a nested unit's constant is reached through this door alone, so a
    # definition that must fold and did not is asked why here as well
    if valFound.kind.none when opId.notZero then {
        reportMissingQualifiedMember :st scope: own :ast defnId: opId
        diagnoseUnfoldedConstant :st :ast unitDecl: unm ownerDecl: own nameId: nmNode defnId: opId
    }
}

# reportMissingQualifiedMember -- a unit-level definition with no value whose
# value names `unit.Type.member`, when the unit has no such type or the type --
# a sum or a list, whose members are values -- has no such member. It
# typed to nothing and raised nothing, so every read reached the emitter; the
# report is the body's for the same read.
reportMissingQualifiedMember: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    defnId: zast.nodeid
} is {
    unitId: zast.nameid
    typeId: zast.nameid
    memberId: zast.nameid
    ln: u32
    co: u32
    {
        dn: ast.nodes.get i: defnId
        ln = nodeLine n: dn
        co = nodeCol n: dn
        if dn.dottedpath then {
            memberId = atomNameId :ast n: (ast.nodes.get i: dn.child)
            pn: ast.nodes.get i: dn.parent
            if pn.dottedpath then {
                unitId = atomNameId :ast n: (ast.nodes.get i: pn.parent)
                typeId = atomNameId :ast n: (ast.nodes.get i: pn.child)
            }
        }
    }
    if unitId.isZero or typeId.isZero or memberId.isZero then return
    if (nameDenotesUnit :st :scope nameId: unitId).not then return
    ud: resolve.unitDeclOfNameOrOwn :st :scope nameId: unitId
    missing: typeId
    owner: unitId
    if (st.typing.declFindChild parentDeclId: ud nameId: typeId).notZero then {
        tt: (
            (walkLookupTyperefById :st :scope :ast unitDecl: ud baseId: typeId).or
            d: ztypes.tid.zero
        )
        if tt.isZero then return
        typeTid: tt
        ttt: st.reg.typetypeOf typeId: typeTid
        if ttt.isSum.not then return
        declared: st.typing.declChildOfId parentTypeId: typeTid nameId: memberId
        if declared.some then return
        missing = memberId
        owner = typeId
    }
    ownerName: zast.nameTextAt :ast ref: owner
    missingName: zast.nameTextAt :ast ref: missing
    kind: "type"
    if owner == unitId then kind = "unit"
    (
        addErrorWithHint
        :st
        nodeid: defnId
        lineno: ln
        colno: co
        e: zast.err.typeError
        msg: "\{kind} '\{ownerName}' has no member '\{missingName}'"
        note: "".string
        hint: "".string
        width: ownerName.length
    )
}

# resolveConstantMember -- one unit-level definition's constant channels, both
# of them. The TYPE channel is shape-driven (`resolveConstantDef` registers the
# literal, suffixed-literal and constant-expression forms and reports the ones
# that are neither); the VALUE channel evaluates and memoises, and hands its
# result back so a value-typed constant -- a string, a concatenation, an arm --
# registers the type its value carries.
#
# Source order drives the visit but not the evaluation: each pull descends into
# whatever it names and memoises, so a definition already reached as a
# dependency is a no-op here and one written before its dependency still works.
# That is what lets the same entry point serve the demand path and the eager
# walk without the two drifting.
resolveConstantMember: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    defnId: zast.nodeid
} is {
    # a template's constant over its numeric parameter is each instance's
    # (foldInstanceConstant): with no instance it has no value to judge
    if (
        forInstancesOnly
        :st
        :ast
        owner: (constOwnerDeclFor :st :scope :ast :unitDecl :defName)
        :defnId
    ) then return
    constFailClear :st
    resolveConstantDef :st :scope :ast :unitDecl :defName :defnId
    cvv: constValueOfMember :st :scope :ast :unitDecl :defName
    constRegisterValueType :st :scope :ast :unitDecl :defName v: cvv
    if (checkConstantMethodShape :st :scope :ast :unitDecl nid: defnId) then constFailClear :st
    reportPendingConstFail :st
    if cvv.kind.none then reportMissingQualifiedMember :st :scope :ast :defnId
    if cvv.kind.none when (constDefNeedsValue :st :scope :ast :unitDecl nid: defnId) then {
        (
            diagnoseUnfoldedConstant
            :st
            :ast
            :unitDecl
            ownerDecl: (constOwnerDeclFor :st :scope :ast :unitDecl :defName)
            nameId: (zast.poolFind pool: ast.names text: defName)
            :defnId
        )
    }
}

# diagnoseUnfoldedConstant -- a unit-level definition built from an operator or
# an `if` is REQUIRED to fold, and when it yields no value the evaluator has
# often recorded no reason: an unknown name, a call, an operator it does not
# fold, a condition that is not a bool all answer "no value" and say nothing.
# Accepted silently, the emitter spelled the definition's TYPE where its value
# belonged. The walk below follows the fold -- the conditions it reaches, the
# branch it selects, an operator's operands -- and reports the first node with
# no value. Other definitions (a literal, an alias, a construction) are the
# shape pass's business and are not asked. Both constant doors ask, and each
# definition is asked once: the stand-in type below looks names up, a lookup
# demands the definition it finds, and a ring of constants would ask forever.
diagnoseUnfoldedConstant: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    # the unit that owns the member: the value was evaluated in its scope, and
    # the walk re-evaluates in the same one
    ownerDecl: ztypes.declid
    nameId: zast.nameid
    defnId: zast.nodeid
} is {
    if ownerDecl.isZero then return
    if (constDefNeedsValue :st scope: ownerDecl :ast :unitDecl nid: defnId).not then return
    # a definition whose shape was reported has its one error already
    if (st.walk.constShapesReported.has item: defnId) then return
    if (st.walk.constsDiagnosed.has item: defnId) then return
    st.walk.constsDiagnosed.add item: defnId
    visiting: ListVal zast.nodeid
    visiting.append from: defnId
    unfoldedWhy :st scope: ownerDecl :ast :unitDecl nid: defnId :visiting
    standInConstantType :st :ast :unitDecl :ownerDecl :nameId nid: defnId
}

# standInConstantType -- a REFUSED computed constant still needs a type, or
# every use of its name is a second report of the same mistake. A nested
# unit's constant gets its type from its value alone, and a unit-level `if`
# gets only its selected branch's, so when the owner has no member type for
# the name one stands in: the first `if` branch that types, or an operator's
# operand-walk type. Reached only after a refusal -- a definition with a value
# never gets here.
standInConstantType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ownerDecl: ztypes.declid
    nameId: zast.nameid
    nid: zast.nodeid
} is {
    cu: st.typing.declTypeOf declId: ownerDecl
    if cu.isZero then return
    eo: st.typing.declChildOfId parentTypeId: cu :nameId
    if eo.some then return
    isIf: false
    n: ast.nodes.get i: nid
    if n.ifexpr then isIf = true
    t: ztypes.tid
    if isIf then {
        t = firstBranchType :st :ast :unitDecl scope: ownerDecl :nid
    } else {
        t = operandConstantType :st :ast :unitDecl scope: ownerDecl :nid
    }
    if t.isZero then return
    st.typing.setMemberType parentTypeId: cu :nameId childTypeId: t
}

# firstBranchType -- the type of the first branch of a compile-time `if` that
# types, the else branch last. 0 when none does.
firstBranchType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
} out ztypes.tid is {
    clauseIds: ListVal zast.nodeid
    site: readUnitIf :ast :nid :clauseIds
    t: ztypes.tid
    for each clauseId: clauseIds loop {
        if t.isZero then {
            condIds: ListVal zast.nodeid
            stmtId: readIfClause :ast :clauseId :condIds
            if stmtId.notZero then t = constantBranchWalk :st :scope :ast :unitDecl nid: stmtId
        }
    }
    if t.isZero when site.elseId.notZero then {
        t = constantBranchWalk :st :scope :ast :unitDecl nid: site.elseId
    }
    return t
}

# operandConstantType -- an operator constant's type from the operand walk, a
# literal result materialised to its default (i64/f64). 0 when it has none.
operandConstantType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
} out ztypes.tid is {
    return (
        literalTypeDefaultTid
        :st
        :scope
        :ast
        t: (constantOperandType :st :scope :ast :unitDecl :nid)
    )
}

# constDefNeedsValue -- a unit-level definition REQUIRED to fold: a computed one
# (isComputedConstantDef), or a call of a function, of a constant or of a
# method of a constant, which the classifier takes as a call rather than a
# construction or a type's instance
constDefNeedsValue: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
} out bool is {
    if (isComputedConstantDef :ast :nid) then return true
    call: callRefAt :ast :nid
    if call.nid.isZero or call.infix then return false
    if (calleeFieldFnTid :st :scope :ast :unitDecl callableId: call.callable
    ).notZero then return true
    cn: ast.nodes.get i: call.callable
    # a constant written with arguments (`C 1`, `1 1`) is a call of a value,
    # which has none
    base: call.callable
    if cn.dottedpath then base = cn.parent
    held: st.walk.constFail
    rv: evalConstNode :st :scope :ast :unitDecl nid: base
    st.walk.constFail = held
    return rv.isConst
}

# isComputedConstantDef -- the definition COMPUTES its value: an operator or a
# compile-time `if` or `match`. These are the shapes whose missing value is a
# refusal.
isComputedConstantDef: function {ast: Ast.view nid: zast.nodeid} out bool is {
    n: ast.nodes.get i: nid
    if n.ifexpr or n.caseexpr then return true
    return (operatorPartsAt :ast :nid).found
}

# unfoldedWhy -- why `nid` has no compile-time value: true once the walk has
# found the reason, false when the node has a value after all. A node whose
# evaluation RECORDS a reason -- a division by zero, a cycle, a reached
# `error` -- ends the walk without a report: that reason is the evaluator's to
# render, and it was rendered where the value was first pulled. Every report
# goes through addErrorWithHint, which drops a repeat, because one definition can be
# asked about from its own door and from a constant that reads it.
unfoldedWhy: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
    # the computed definitions on the walk's path, so a cycle ends it
    visiting: ListVal zast.nodeid
} out bool is {
    constFailClear :st
    v: evalConstNode :st :scope :ast :unitDecl :nid
    recorded: st.walk.constFail.failed
    constFailClear :st
    if v.isConst then return false
    if recorded then return true
    if (unfoldedPartWhy :st :scope :ast :unitDecl :nid :visiting) then return true
    msg: "not a compile-time constant".string
    hint: "a unit constant is built from literals, other constants, operators, `if` and `match`".string
    reportUnfolded :st :ast :nid width: 1 :msg :hint
    return true
}

# unfoldedPartWhy -- node `nid`, which has no value and recorded no reason: the
# part of it that says why -- an `if` or `match` branch, an operand, a name, a
# call, a member read -- reported (or, for a template's constant over its
# numeric parameter, deliberately not). False, nothing reported, when no part
# says more than that the node is not a constant: the caller reports in its own
# words -- a definition, a data argument and a list element each have theirs.
unfoldedPartWhy: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
    visiting: ListVal zast.nodeid
} out bool is {
    plan: consteval.evalConstPlan :ast :nid
    if plan.shape.ifexpr then return (unfoldedIfWhy :st :scope :ast :unitDecl :nid :visiting)
    if plan.shape.caseexpr then return (unfoldedMatchWhy :st :scope :ast :unitDecl :nid :visiting)
    if plan.shape.operator then return (unfoldedBinopWhy :st :scope :ast :unitDecl :nid :visiting)
    if plan.shape.name then {
        return (unfoldedNameWhy :st :scope :ast :unitDecl :nid nameId: plan.nameId :visiting)
    }
    if plan.shape.call then {
        # a call whose shape was reported needs no second reason
        if (checkConstantMethodShape :st :scope :ast :unitDecl :nid) then return true
        return (unfoldedCallWhy :st :scope :ast :unitDecl :nid :visiting)
    }
    if plan.shape.dottedpath when (
        unfoldedMemberWhy
        :st
        :scope
        :ast
        parentId: plan.parentId
        childId: plan.childId
    ) then return true
    if plan.shape.dottedpath when (checkConstantMethodShape :st :scope :ast :unitDecl :nid
    ) then return true
    return false
}

# constNameClosesRing -- the constant `nameId` read at `nid` is defined by a
# definition the walk is already in: a cycle, reported in the evaluator's words.
constNameClosesRing: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nid: zast.nodeid
    nameId: zast.nameid
    visiting: (ListVal zast.nodeid).view
} out bool is {
    cd: (
        st.typing.declFindChild
        parentDeclId: (constOwnerDeclForId :st :scope :unitDecl :nameId)
        :nameId
    )
    if cd.isZero then return false
    defOp: zast.nodeid
    {
        dn: ast.nodes.get i: (st.typing.decls.get i: cd).node
        if dn.namedoperation then defOp = dn.operation
    }
    if defOp.isZero or (visiting.contains item: defOp).not then return false
    nameText: zast.nameTextCopy :ast ref: nameId
    (
        consteval.reportConstError
        :st
        nodeid: nid
        lineno: (nodeLine n: (ast.nodes.get i: nid))
        colno: (nodeCol n: (ast.nodes.get i: nid))
        width: nameText.length
        msg: "constant '\{nameText}' is defined in terms of itself"
        hint: "a unit constant may only read constants that do not read it back".string
    )
    return true
}

# unfoldedCallWhy -- a unit-level call with no value. Its arguments run first,
# so a constant one names with no value is the reason -- a definition naming
# itself through it among them, a ring the evaluator does not walk, as it runs
# no call; then a call of a function, or of a method of a constant, runs only
# at run time and is named as written: "'twice' has no compile-time value".
unfoldedCallWhy: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
    visiting: ListVal zast.nodeid
} out bool is {
    call: callRefAt :ast :nid
    ai: u64
    for ai < call.nargs loop {
        arg: argRefAt :ast nid: (zast.callArgAt :ast nid: call.nid i: ai)
        ai = ai + 1
        an: atomNameId :ast n: (ast.nodes.get i: arg.operation)
        if an.notZero then {
            if (
                constNameClosesRing
                :st
                :scope
                :ast
                :unitDecl
                nid: arg.operation
                nameId: an
                :visiting
            ) then {
                return true
            }
            if (unfoldedWhy :ast :st :unitDecl :scope nid: arg.operation :visiting) then return true
        }
    }
    named: calleeFieldFnTid :st :scope :ast :unitDecl callableId: call.callable
    cn: ast.nodes.get i: call.callable
    if named.isZero when cn.dottedpath then {
        held: st.walk.constFail
        rv: evalConstNode :st :scope :ast :unitDecl nid: cn.parent
        st.walk.constFail = held
        if rv.isConst then named = constValueTid :st :scope :ast v: rv
    }
    if named.isZero then {
        (
            reportUnfolded
            :st
            :ast
            :nid
            width: 1
            msg: "a call has no compile-time value".string
            hint: "only `error` and the string constant methods are evaluated at compile time".string
        )
        return true
    }
    ctx: typeExprText :ast nid: call.callable
    (
        reportUnfolded
        :st
        :ast
        :nid
        width: 1
        msg: "'\{ctx}' has no compile-time value"
        hint: "only a function body can call it: it runs there, at run time".string
    )
    return true
}

# unfoldedIfWhy -- a compile-time `if` with no value. The clauses are asked in
# order, every condition of a clause as the fold asks them: one with no value,
# or one whose value is not a truth, is the reason. The first clause whose
# conditions all hold selects its branch, and the else branch is the fallback.
# A clause after the selected one, and every branch not selected, is never
# evaluated -- which is what lets a dead branch name what does not exist.
unfoldedIfWhy: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
    visiting: ListVal zast.nodeid
} out bool is {
    clauseIds: ListVal zast.nodeid
    site: readUnitIf :ast :nid :clauseIds
    if site.isIf.not then return false
    verdict: u32
    for each clauseId: clauseIds loop {
        if verdict == 0 then {
            verdict = unfoldedClauseWhy :st :scope :ast :unitDecl :clauseId :visiting
        }
    }
    if verdict == 1 then return true
    if verdict == 2 then return false
    if site.elseId.notZero then {
        return (unfoldedBranchWhy :st :scope :ast :unitDecl nid: site.elseId :visiting)
    }
    (
        reportUnfolded
        :st
        :ast
        :nid
        width: 2
        msg: "no branch of this `if` is selected, so it has no value".string
        hint: "give a unit-level `if` an else branch".string
    )
    return true
}

# unfoldedClauseWhy -- one clause of a compile-time `if`: 0 = it does not
# select its branch, so the next clause is asked; 1 = the reason was found in
# it; 2 = it selects a branch that has a value after all.
unfoldedClauseWhy: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    clauseId: zast.nodeid
    visiting: ListVal zast.nodeid
} out u32 is {
    condIds: ListVal zast.nodeid
    stmtId: readIfClause :ast :clauseId :condIds
    if stmtId.isZero then return 0
    held: unfoldedCondsWhy :st :scope :ast :unitDecl :condIds :visiting
    if held == 0 then return 1
    if held == 2 then return 0
    if (unfoldedBranchWhy :st :scope :ast :unitDecl nid: stmtId :visiting) then return 1
    return 2
}

# unfoldedCondsWhy -- the conditions of one clause, asked the way the fold asks
# them, in order, up to the first that decides: 0 = the reason was found in one,
# 1 = all hold, 2 = one does not, and what follows it never runs.
unfoldedCondsWhy: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    condIds: (ListVal zast.nodeid).view
    visiting: ListVal zast.nodeid
} out u32 is {
    for each condId: condIds loop {
        cw: unfoldedCondWhy :st :scope :ast :unitDecl :condId :visiting
        if cw == 0 then return 0
        if cw == 2 then return 2
    }
    return 1
}

# unfoldedCondWhy -- one condition of a compile-time `if`, as foldIfCond asks it:
# 0 = the reason was found here (reported, or recorded by the evaluator),
# 1 = it holds, 2 = it does not, 3 = not a named condition, which says nothing.
unfoldedCondWhy: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    condId: zast.nodeid
    visiting: ListVal zast.nodeid
} out u32 is {
    isNamed: false
    opId: zast.nodeid
    cond: ast.nodes.get i: condId
    if cond.namedoperation then {
        isNamed = true
        opId = cond.operation
    }
    if isNamed.not then return 3
    held: foldIfCond :st :scope :ast :unitDecl :condId
    if (held == 1) or (held == 2) then return held
    if (unfoldedWhy :st :scope :ast :unitDecl nid: opId :visiting) then return 0
    # the operand has a value, and it is not a truth: the body's own refusal
    # for a condition that is not a bool, in the body's own words
    constFailClear :st
    cv: evalConstNode :st :scope :ast :unitDecl nid: opId
    constFailClear :st
    ctnm: constKindName :st v: cv
    (
        reportUnfoldedAs
        :st
        :ast
        nid: opId
        width: 1
        e: zast.err.typeError
        msg: "condition must be bool or a 2-arm sum type, got '\{ctnm}'"
        hint: "".string
    )
    return 0
}

# unfoldedMatchWhy -- a compile-time `match` with no value. A refused arm or a
# missing case is recorded by the evaluator and rendered where the value was
# pulled; what is left is a subject with no value, or a selected arm whose body
# has none.
unfoldedMatchWhy: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
    visiting: ListVal zast.nodeid
} out bool is {
    cr: caseRefAt :ast :nid
    if cr.nid.isZero then return false
    if (unfoldedWhy :st :scope :ast :unitDecl nid: cr.subject :visiting) then return true
    sv: evalConstNode :st :scope :ast :unitDecl nid: cr.subject
    stmt: consteval.constMatchArm :st :ast :cr subject: sv
    constFailClear :st
    if stmt.isZero then return true
    return (unfoldedBranchWhy :st :scope :ast :unitDecl nid: stmt :visiting)
}

# unfoldedBranchWhy -- the selected branch of a compile-time `if` has no value:
# a branch yields its last statement's, the way constBlockValue reads it.
unfoldedBranchWhy: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
    visiting: ListVal zast.nodeid
} out bool is {
    lastId: branchValueLine :ast :nid
    if lastId.notZero then return (unfoldedWhy :st :scope :ast :unitDecl nid: lastId :visiting)
    (
        reportUnfolded
        :st
        :ast
        :nid
        width: 1
        msg: "the selected branch of this `if` has no value".string
        hint: "a branch's value is its last statement".string
    )
    return true
}

# branchValueLine -- the expression a branch block yields: its last statement's.
# Zero when the node is not a block or holds no statement line.
branchValueLine: function {ast: Ast.view nid: zast.nodeid} out zast.nodeid is {
    lastLine: zast.nodeid
    {
        block: ast.nodes.get i: nid
        if block.statement when block.statements.count > 0 then {
            lastLine = (
                zast.kidAt
                kids: ast.kids
                span: block.statements
                i: block.statements.count.u64 - 1
            )
        }
    }
    if lastLine.isZero then return zast.nodeid
    s: ast.nodes.get i: lastLine
    if s.statementline then return s.statementline
    return zast.nodeid
}

# unfoldedBinopWhy -- an operator with no value: an operand with none is the
# reason, and when both have one the operator does not fold over them.
unfoldedBinopWhy: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
    visiting: ListVal zast.nodeid
} out bool is {
    br: consteval.binRefAt :ast :nid
    if (unfoldedWhy :st :scope :ast :unitDecl nid: br.lhs :visiting) then return true
    if (unfoldedWhy :st :scope :ast :unitDecl nid: br.rhs :visiting) then return true
    constFailClear :st
    lv: evalConstNode :st :scope :ast :unitDecl nid: br.lhs
    rv: evalConstNode :st :scope :ast :unitDecl nid: br.rhs
    constFailClear :st
    lk: constKindName :st v: lv
    rk: constKindName :st v: rv
    opn: zast.nameTextCopy :ast ref: (atomNameId :ast n: (ast.nodes.get i: br.operator))
    (
        reportUnfolded
        :st
        :ast
        nid: br.operator
        width: opn.length
        msg: "'\{opn}' has no compile-time value for \{lk} and \{rk}"
        hint: "constants fold + - * / and comparisons on numbers, % & | ^ << >> on integers, + == != on strings, and == != and or on arms, == != on data values".string
    )
    return true
}

# unfoldedMemberWhy -- a path `T.m` with no value, where `T` names a type that
# declares no member `m`: the body's unknown-member error, at the member. True
# when it reported.
unfoldedMemberWhy: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    parentId: zast.nodeid
    childId: zast.nodeid
} out bool is {
    pn: zast.atomNameIdOf n: (ast.nodes.get i: parentId)
    cn: zast.atomNameIdOf n: (ast.nodes.get i: childId)
    if pn.isZero or cn.isZero then return false
    hit: envLookup :st :scope nameId: pn
    if hit.declId.isZero then return false
    # a constant's declaration carries its value's type: only a type is asked
    if (st.typing.decls.get i: hit.declId).kind.typeDecl.not then return false
    tid: st.typing.declTypeOf declId: hit.declId
    if tid.isZero then return false
    if (st.reg.typetypeOf typeId: tid) == ztypes.ztypetype.unitType then return false
    if (st.typing.declFindChild parentDeclId: hit.declId nameId: cn).notZero then return false
    tn: specWrittenName :st :ast :tid
    mn: zast.nameTextAt :ast ref: cn
    msg: "type '\{tn}' has no member '\{mn}'"
    w: mn.length.u32.orPanic
    reportUnfoldedAs :st :ast nid: childId width: w e: zast.err.typeError :msg hint: String
    return true
}

# unfoldedNameWhy -- a bare name with no value. A name nothing declares is the
# body's unknown reference. A constant computed from others is asked in turn,
# so the report lands where the reason is written; any other declaration -- a
# function, a type, a generic parameter -- is not a compile-time value.
unfoldedNameWhy: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nid: zast.nodeid
    nameId: zast.nameid
    visiting: ListVal zast.nodeid
} out bool is {
    # a template's constant over its numeric generic parameter has a value in
    # each instantiation, and none of its own
    if (numericParamOwnerFrom :st :scope :nameId).notZero then return true
    nameText: zast.nameTextCopy :ast ref: nameId
    od: constOwnerDeclForId :st :scope :unitDecl :nameId
    cd: st.typing.declFindChild parentDeclId: od :nameId
    if cd.isZero then {
        tr: (walkLookupTyperefById :st :scope :ast :unitDecl baseId: nameId).or d: ztypes.tid.zero
        if tr.isZero then {
            reportUnknownNameAt :st :ast :nid name: nameText
            return true
        }
    } else {
        defOp: zast.nodeid
        cdo: st.typing.decls.get i: cd
        dn: ast.nodes.get i: cdo.node
        if dn.namedoperation then defOp = dn.operation
        cdo.drop
        if defOp.notZero when (constDefNeedsValue :st scope: od :ast :unitDecl nid: defOp) then {
            # a ring of constants is a cycle, which the evaluator reports
            if (visiting.contains item: defOp) then return true
            visiting.append from: defOp
            return (unfoldedWhy :st scope: od :ast :unitDecl nid: defOp :visiting)
        }
    }
    (
        reportUnfolded
        :st
        :ast
        :nid
        width: nameText.length
        msg: "'\{nameText}' has no compile-time value"
        hint: "a unit constant reads only literals and other unit constants".string
    )
    return true
}

# constKindName -- the type a folded value carries, named for a diagnostic.
constKindName: function {st: zenv.ZSymbolTable.view v: ztypes.cval} out String is {
    if v.numTid.notZero then return (st.reg.nameOf tid: v.numTid)
    if v.kind.ivalKind then return "intliteral".string
    if v.kind.fvalKind then return "floatliteral".string
    if v.kind.svalKind then return "StringView".string
    if v.kind.armKind then return (st.reg.nameOf tid: v.armTid)
    return "no value".string
}

# reportUnfolded -- one E0600 for a unit constant with no value, at `nid`.
reportUnfolded: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    nid: zast.nodeid
    width: u64
    msg: String
    hint: String
} is {
    reportUnfoldedAs :st :ast :nid :width e: zast.err.constError :msg :hint
}

# reportUnfoldedAs -- the report under a chosen code, through the error sink
# that drops a repeat of the same message on the same line.
reportUnfoldedAs: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    nid: zast.nodeid
    width: u64
    e: zast.err
    msg: String
    hint: String
} is {
    n: ast.nodes.get i: nid
    (
        addErrorWithHint
        :st
        nodeid: nid
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        :e
        :msg
        note: "a unit constant is evaluated at compile time".string
        :hint
        :width
    )
}

# validateGeneratorDef -- the shape rules of the declared form, checked BEFORE
# the lowering runs: it appends a generated `create` and injects `call`'s
# receiver, so afterwards a user-written `create` is indistinguishable from the
# generated one and the input parameter has moved to second place.
#
# Each of these was accepted in silence and failed as C the compiler rejected,
# or -- worse -- as nothing at all.
validateGeneratorDef: function {
    # where the diagnostics are recorded
    st: zenv.ZSymbolTable
    # the tree the definition is read from; a written receiver is dropped from it
    ast: Ast
    # the generator's own name, which every message here names
    defName: StringView
    # the generator definition to check
    objId: zast.nodeid
} is {
    obn: ast.nodes.get i: objId
    if obn.objectdef then {
        nCall: u64
        callId: zast.nodeid
        for each amId: (zast.kidsOf :ast span: obn.asItems) loop {
            am: ast.nodes.get i: amId
            if am.namedoperation then {
                if am.name == zast.wellKnown.slot.wkCall then {
                    nCall = nCall + 1
                    callId = am.operation
                }
                if am.name == zast.wellKnown.slot.wkCreate then {
                    mc: "'\{defName}' declares its own `create` -- a generator's construction is generated from its `is` fields"
                    hc: "delete the `create`; the `is` fields already name its parameters, in order".string
                    nc: String
                    (
                        addErrorWithHint
                        :st
                        nodeid: am.nodeid
                        lineno: am.lineno
                        colno: am.colno
                        e: zast.err.typeError
                        msg: mc
                        note: nc
                        hint: hc
                        width: 6
                    )
                }
            }
        }
        if nCall == 0 then {
            m0: "'\{defName}' declares no `call` -- a generator's body is its `call` member"
            h0: "add `call: function out <element type> is { ... yield ... }` to the `as` block".string
            n0: String
            (
                addErrorWithHint
                :st
                nodeid: obn.nodeid
                lineno: obn.lineno
                colno: obn.colno
                e: zast.err.typeError
                msg: m0
                note: n0
                hint: h0
                width: defName.length
            )
        }
        if callId.notZero then {
            np: refuseCallReceiver :st :ast :defName :callId
            cf: ast.nodes.get i: callId
            if cf.functiondef when np > 1 then {
                m1: "'\{defName}' declares \{np} parameters on `call` -- a generator receives at most one value per call"
                h1: "keep the one the call sites hand it; read it as `yield`'s own value, not as a binding".string
                n1: String
                (
                    addErrorWithHint
                    :st
                    nodeid: cf.nodeid
                    lineno: cf.lineno
                    colno: cf.colno
                    e: zast.err.typeError
                    msg: m1
                    note: n1
                    hint: h1
                    width: 4
                )
            }
            refuseYieldlessCall :st :ast :defName :callId
        }
    }
}

# refuseYieldlessCall -- a generator's `call` with a body that holds no
# `yield`: it hands out nothing, and the lowering has no element to build its
# state around (the emitter then asked for a member that does not exist).
refuseYieldlessCall: function {
    st: zenv.ZSymbolTable
    ast: Ast
    defName: StringView
    callId: zast.nodeid
} is {
    cf: ast.nodes.get i: callId
    if cf.functiondef.not then return
    if cf.body.isZero or ((zast.yieldCountIn :ast nid: cf.body) > 0) then return
    (
        addErrorWithHint
        :st
        nodeid: cf.nodeid
        lineno: cf.lineno
        colno: cf.colno
        e: zast.err.typeError
        msg: "'\{defName}' never yields: a generator's `call` hands out each element with `yield`"
        note: String
        hint: "add a `yield <value>` to the body".string
        width: 4
    )
}

# paramNamesReceiver -- the parameter `pId` of a function definition names its
# receiver: `:this`, or any name typed `this`, `this.view` or `this.borrow`.
paramNamesReceiver: function {ast: Ast.view pId: zast.nodeid} out bool is {
    pm: ast.nodes.get i: pId
    match (
        pm
    ) case namedoperation then {
        if pm.name == zast.wellKnown.slot.wkThis then return true
        return (paramIsThisReceiverId :ast opId: pm.operation)
    } case labelvalue then {
        return pm.name == zast.wellKnown.slot.wkThis
    } else {
        return false
    }
}

# refuseCallReceiver -- a generator's `call` has an implicit receiver, and its
# parameter list declares only the per-call input: a parameter that names the
# receiver (`:this`, `g: this`, `this: this.borrow`) is refused, then dropped,
# so the lowering reads the list as the author meant it rather than taking the
# receiver for the input. Answers how many parameters are left.
refuseCallReceiver: function {
    st: zenv.ZSymbolTable
    ast: Ast
    defName: StringView
    callId: zast.nodeid
} out u64 is {
    params: zast.kidspan first: 0 count: 0
    cf: ast.nodes.get i: callId
    if cf.functiondef.not then return 0
    params = cf.parameters
    kept: ListVal zast.nodeid
    dropped: false
    for each pId: (zast.kidsOf :ast span: params) loop {
        pNid: zast.nodeid
        pLine: u32
        pCol: u32
        pm: ast.nodes.get i: pId
        pNid = nodeId n: pm
        pLine = nodeLine n: pm
        pCol = nodeCol n: pm
        if (paramNamesReceiver :ast :pId) then {
            dropped = true
            mr: "'\{defName}' writes `call`'s receiver -- a generator's `call` has an implicit receiver, never written in its parameter list"
            hr: "delete the parameter: the fields are read as `this.x`, and the list declares only the per-call input".string
            nr: String
            (
                addErrorWithHint
                :st
                nodeid: pNid
                lineno: pLine
                colno: pCol
                e: zast.err.typeError
                msg: mr
                note: nr
                hint: hr
                width: 4
            )
        } else {
            kept.append pId
        }
    }
    if dropped then {
        ks: zast.kidsAdd kids: ast.kids xs: kept
        cfm: ast.nodes.getMut i: callId
        if cfm.functiondef then cfm.parameters = ks
    }
    return kept.length
}

# lowerDeclaredGeneratorsInUnit -- prepare every `generator` definition in the
# unit, and in every unit it declares, for the ordinary class walk. Unlike the
# function form there is nothing to move: the definition stays where the author
# wrote it and keeps its name, so this only hands each one to zgenerator and
# records which body `yield` is legal in.
lowerDeclaredGeneratorsInUnit: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitdefId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    i: u64
    for i < bodyIds.count loop {
        bmId: zast.kidAt kids: ast.kids span: bodyIds :i
        i = i + 1
        opId: zast.nodeid
        gnm: String
        nestedId: zast.nodeid
        {
            bm: ast.nodes.get i: bmId
            if bm.namedoperation then {
                bo: ast.nodes.get i: bm.operation
                if bo.objectdef when bo.kind == zast.objectkind.generatorDef then {
                    opId = bm.operation
                    gnm = zast.nameTextCopy :ast ref: bm.name
                }
                if bo.unitdef when (zast.unitOpHasBody :ast opId: bm.operation) then {
                    nestedId = bm.operation
                }
            }
        }
        # a unit declared inside this one -- inline, a hidden subunit, a generic
        # unit, one more level down -- declares generators of its own
        if nestedId.notZero then lowerDeclaredGeneratorsInUnit :st :ast unitdefId: nestedId
        if opId.notZero then {
            validateGeneratorDef :st :ast defName: gnm.stringView objId: opId
            gd: (
                zgenerator.GenDeclared
                callFnId: zast.nodeid
                wrapperNodeId: zast.nodeid
                readsAbsentInput: false
                stateField: zast.nameid
                resumeInputField: zast.nameid
                yieldSlotFields: ListVal zast.nameid
                forCounterFields: ListVal zast.nameid
                forCountFields: ListVal zast.nameid
            )
            zgenerator.lowerDeclared :ast objId: opId dst: gd
            # the fields the transform added, for the emitter to reach by id
            if gd.callFnId.notZero then {
                gfk: gd.callFnId
                gfv: st.typing.genFields.length
                st.typing.genFieldsOf.set key: gfk value: gfv
                st.typing.genFields.append (
                    ztyping.GenFields
                    state: gd.stateField
                    resumeInput: gd.resumeInputField
                    yieldSlots: gd.yieldSlotFields.copy
                    forCounters: gd.forCounterFields.copy
                    forCounts: gd.forCountFields.copy
                )
            }
            # `yield` is in scope for exactly this body, and the pass that
            # prepared the body is what knows which body that is
            if gd.callFnId.notZero then st.typing.generatorCallBodies.add item: gd.callFnId
            # the wrapper collapses to `optionval` over a valtype element, and
            # the collapse is keyed on this very node
            if gd.wrapperNodeId.notZero then {
                gwk: gd.wrapperNodeId
                gwv: true
                st.walk.generatorWrapper.set key: gwk value: gwv
            }
            if gd.readsAbsentInput then {
                my: "'\{gnm}' reads `yield`'s value, but `call` declares no input to receive"
                hy: "give `call` a parameter -- its type, its ownership and the label the call sites read -- or drop the binding and yield for effect".string
                ny: String
                (
                    addErrorWithHint
                    :st
                    nodeid: opId
                    lineno: 0
                    colno: 0
                    e: zast.err.typeError
                    msg: my
                    note: ny
                    hint: hy
                    width: 1
                )
            }
        }
    }
}

# lowerDeclaredGenerators -- prepare every `generator` definition in the program.
#
# RUNS BEFORE indexUnitDefs, and the ordering is load-bearing. It APPENDS FIELDS
# to a definition the author wrote, and indexing binds a definition's members
# where it stands -- so a field added after indexing is not there when the
# class resolves, and the state cursor and the loop counters go missing from
# the struct while everything else about the program still typechecks.
lowerDeclaredGenerators: function {st: zenv.ZSymbolTable program: Ast} is {
    {
        ui: u64
        un: program.units.length
        for ui < un loop {
            uelId: program.units.get i: ui
            ui = ui + 1
            uOpId: zast.nodeid
            uel: program.nodes.get i: uelId
            if uel.namedoperation then uOpId = uel.operation
            if uOpId.notZero then {
                lowerDeclaredGeneratorsInUnit :st ast: program unitdefId: uOpId
            }
        }
    }
}

# stampRefDecl -- record the declaration a reference node resolved to.
stampRefDecl: function {st: zenv.ZSymbolTable nid: zast.nodeid declId: ztypes.declid} is {
    if nid.isZero then return
    if declId.isZero then return
    st.typing.refDecl.set key: nid value: declId
}

# templateDeclOf -- the declaration of the template `tid` is made from: the
# end of an instance's genericOrigin chain, or the template function a unit
# instance's copy of a generic function keeps (unitFnTemplate); for any other
# type, its own declaration.
templateDeclOf: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
} out ztypes.declid is {
    root: tid
    for (reg.genericOriginOf tid: root).notZero loop root = reg.genericOriginOf tid: root
    kept: typing.unitFnTemplate.get key: root
    if kept.some then root = kept
    return (typing.declIdOfType typeId: root)
}


# declMonoType -- give a monomorphisation its own type declaration, cloned
# from its template's, so its members carry the instantiated types rather than
# resolving back through genericOriginOf to the template's.
declMonoType: function {
    st: zenv.ZSymbolTable
    monoTid: ztypes.tid
    templateId: ztypes.tid
} is {
    td: templateDeclOf reg: st.reg typing: st.typing tid: templateId
    if td.isZero then return
    md: st.typing.declCloneType templateDeclId: td
    if md.isZero then return
    st.typing.declSetType declId: md typeId: monoTid
}

# declMemberOf -- the Decl of member `nameId` under the type that minted
# `ownerTid` (monos resolve through their template's Decl); 0 when the
# owner has no Decl or no such indexed member.
declMemberOf: function {
    st: zenv.ZSymbolTable.view
    ownerTid: ztypes.tid
    nameId: zast.nameid
} out ztypes.declid is {
    od: templateDeclOf reg: st.reg typing: st.typing tid: ownerTid
    if od.isZero then return ztypes.declid.zero
    return (st.typing.declFindChild parentDeclId: od :nameId)
}

# declSurfaceOfName -- the Decl a bare-name reference lands on: the
# current unit's own def, else the prelude carrier's (core's) re-export,
# else the definition that minted the resolved type. The SURFACE is
# recorded (a re-export keeps its own Decl) so navigation lands where
# the name was found, not where its type lives.
declSurfaceOfName: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    nameId: zast.nameid
    tid: ztypes.tid
} out ztypes.declid is {
    if nameId.notZero then {
        se: nestedScopeSurface :st :ast :unitDecl :nameId :tid
        if se.notZero then return se
        ro: unitDecl
        if ro.notZero then {
            cd: st.typing.declFindChild parentDeclId: ro :nameId
            sv: declSurfaceEnsure :st :ast declId: cd want: tid
            if sv.notZero then return sv
        }
        co: (
            st.typing.declFindChild
            parentDeclId: st.typing.programRoot
            nameId: zast.wellKnown.slot.unCore
        )
        if co.notZero then {
            cd8: st.typing.declFindChild parentDeclId: co :nameId
            sv8: declSurfaceEnsure :st :ast declId: cd8 want: tid
            if sv8.notZero then return sv8
        }
    }
    return (templateDeclOf reg: st.reg typing: st.typing :tid)
}

# nestedScopeSurface -- declSurfaceOfName's first answer: a scope nested in the
# unit, from the reference outward. A name a generic unit or a namespace
# declares -- a parameter, an alias of it -- lands on that declaration, which
# the unit itself does not hold. 0 when the name is found no nearer than the
# unit.
nestedScopeSurface: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    nameId: zast.nameid
    tid: ztypes.tid
} out ztypes.declid is {
    eh: envLookup :st scope: st.curScope :nameId
    if (
        (eh.scope == unitDecl) or
        (scopeIsWithin typing: st.typing scope: eh.scope root: unitDecl).not
    ) then {
        return ztypes.declid.zero
    }
    return (declSurfaceEnsure :st :ast declId: eh.declId want: tid)
}

# declSurfaceEnsure -- accept a candidate surface Decl only when its
# minted type id equals the reference's resolved tid, resolving a
# not-yet-touched re-export on the spot -- a stamped surface must serve
# both navigation (its node) and tid consumers like the emitter.
declSurfaceEnsure: function {
    st: zenv.ZSymbolTable
    ast: Ast
    declId: ztypes.declid
    want: ztypes.tid
} out ztypes.declid is {
    if declId.isZero then return ztypes.declid.zero
    dtid: ztypes.tid
    isRx: false
    d: st.typing.decls.get i: declId
    dtid = d.typeId
    if d.kind.reexportDecl then isRx = true
    d.drop
    if dtid.isZero when isRx then dtid = resolve.resolveAliasKey :st :ast :declId
    if dtid == want then return declId
    return ztypes.declid.zero
}

# --- the environment walk for a bare definition name ---

# scopeIsWithin -- is `root` `scope` itself or one of its enclosing scopes?
scopeIsWithin: function {
    typing: ztyping.ZTyping.view
    scope: ztypes.declid
    root: ztypes.declid
} out bool is {
    if root.isZero then return false
    cur: scope
    for cur.notZero loop {
        if cur == root then return true
        cur = typing.declParentOf declId: cur
    }
    return false
}

# envLookup -- the environment walk for a bare name: from `scope` outward
# through each enclosing unit scope to the root, then `core`, first match
# wins. A hit is the child's DeclId whatever its resolution state and the
# scope it was found in; a miss is zero. A probe: it reads the index and mints
# nothing.
envLookup: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    nameId: zast.nameid
} out zdefhit is {
    if nameId.isZero then return (zdefhit declId: ztypes.declid scope: ztypes.declid)
    cur: resolve.unitScopeOf typing: st.typing declId: scope
    for cur.notZero loop {
        h: st.typing.declFindChild parentDeclId: cur :nameId
        if h.notZero then return (zdefhit declId: h scope: cur)
        if cur == st.typing.coreUnitRoot then return (
            zdefhit
            declId: ztypes.declid
            scope: ztypes.declid
        )
        cur = resolve.unitScopeOf typing: st.typing declId: (st.typing.declParentOf declId: cur)
    }
    if st.typing.coreUnitRoot.notZero then {
        h8: st.typing.declFindChild parentDeclId: st.typing.coreUnitRoot :nameId
        if h8.notZero then return (zdefhit declId: h8 scope: st.typing.coreUnitRoot)
    }
    return (zdefhit declId: ztypes.declid scope: ztypes.declid)
}

# bareNameReaches -- the type's bare name, looked up from `site`, reaches the
# type: its nearest declaration there is the type's own, or a re-export that
# resolved to it (core's `u8: system.u8`). A re-export not yet resolved is
# taken to reach it; any other declaration of the name shadows it. Read from
# declarations only. True for no site.
bareNameReaches: function {
    # the checked program the lookup reads
    st: zenv.ZSymbolTable.view
    # the unit the name would be written in
    site: ztypes.declid
    # the type, a template for a generic instance
    base: ztypes.tid
} out bool is {
    if site.isZero then return true
    bd: templateDeclOf reg: st.reg typing: st.typing tid: base
    if bd.isZero then return true
    nameId: (st.typing.decls.get i: bd).name
    hit: (
        envLookup
        :st
        scope: (typeargs.scopeFor typing: st.typing scope: site unitDecl: site)
        :nameId
    )
    if hit.declId == bd then return true
    if hit.declId.isZero then return false
    hd: st.typing.decls.get i: hit.declId
    if hd.kind.reexportDecl.not then return false
    return hd.typeId.isZero or (hd.typeId == base)
}

# zdefhit -- an envLookup hit: the child DeclId and the scope (its root
# DeclId) it was found in. Both zero on a miss.
zdefhit: record {
    # the declaration found
    declId: ztypes.declid
    # the scope it was found in, which decides what else is visible from it
    scope: ztypes.declid
}

# nameDenotesUnit -- does `nameId` name a unit HERE: a FILE unit, or a
# generic-unit BINDING in scope (`intmath: (mathops t: i64)`) whose Decl
# carries the instantiated unit's type. The second leg is what a bare-name
# index could not express -- two namespaces may each bind an `intmath` -- so
# it resolves through the environment like any other name.
nameDenotesUnit: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    nameId: zast.nameid
} out bool is {
    if (isUnitNameDecl :st :scope :nameId) then return true
    h: envLookup :st :scope :nameId
    if h.declId.isZero then return false
    # only a BINDING of an instantiated unit, never a unit DECLARATION: a
    # nested unit or subunit is in scope here, and reading one as a qualified
    # root changes what a dotted path means (qualified_subunit_type, the
    # re-export chains).
    isUd: false
    hdo: st.typing.decls.get i: h.declId
    if hdo.kind.unitDecl then isUd = true
    if isUd then return false
    bt: st.typing.declTypeOf declId: h.declId
    if bt.isZero then return false
    return (st.reg.typetypeOf typeId: bt) == ztypes.ztypetype.unitType
}

# rootNamesAnyUnit -- does `nameId` name a unit of any kind here: what
# nameDenotesUnit answers, or a unit declaration in scope -- a subunit, a nested
# unit -- which it leaves out on purpose. A path from one names no type at its
# root (`shade.hue.red` beside a sibling subunit `shade`).
rootNamesAnyUnit: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    nameId: zast.nameid
} out bool is {
    if (nameDenotesUnit :st :scope :nameId) then return true
    h: envLookup :st :scope :nameId
    if h.declId.isZero then return false
    return (st.typing.decls.get i: h.declId).kind.unitDecl
}

# unitRootedPath -- whether a declaration is a dotted path from a unit
unitRootedPath: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    scope: ztypes.declid
    node: zast.nodeid
} out bool is {
    if (ast.nodes.get i: node).dottedpath.not then return false
    return (rootNamesAnyUnit :st :scope nameId: (rootNameIdOf :ast n: (ast.nodes.get i: node)))
}

# isUnitNameDecl -- does `nameId`, written in `scope`, name a FILE unit
# (fileUnitNamedAt) whose declared type is a unit?
isUnitNameDecl: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    nameId: zast.nameid
} out bool is {
    ur: resolve.fileUnitNamedAt :st :scope :nameId
    if ur.isZero then return false
    ut: st.typing.declTypeOf declId: ur
    if ut.isZero then return false
    return (st.reg.typetypeOf typeId: ut) == ztypes.ztypetype.unitType
}


# --- id-keyed resolution twins: same shape as the text resolvers above, but
# the child name arrives as an already-interned Ast.names pool id, so each
# probe is a declChildOfId (no per-stage StringPool.find). The composed-key miss
# path materialises the name text once via poolTextCopy (rare). ---

# walkLookupTyperefById -- walkLookupTyperef for a caller holding the base
# name's pool id.
walkLookupTyperefById: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    baseId: zast.nameid
} out optionval ztypes.tid is {
    if baseId.isZero then return (optionval.none ztypes.tid)
    # an alias of a type enclosing the scope is nearer than any unit's name
    ea: enclosingAsAliasTid :st :ast :scope nameId: baseId
    if ea.notZero then return (optionval.some ea)
    walkScope: typeargs.scopeFor typing: st.typing :scope :unitDecl
    return (walkLookupTyperefFrom :st :ast scope: walkScope :baseId)
}

# nearestDeclOf -- the declaration the type-ref walk meets first for `baseId`
# from `scope`, read without demanding it: zero when the nearest scope holds the
# name only in its member index, or no scope holds it.
nearestDeclOf: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    baseId: zast.nameid
} out ztypes.declid is {
    at: resolve.nearestScopeOf typing: st.typing :scope :baseId
    if at.isZero then return at
    return (st.typing.declFindChild parentDeclId: at nameId: baseId)
}

# walkLookupTyperefFrom -- the walk itself, from an explicit start scope (0:
# the prelude alone): the nearest scope that holds the name answers, and a
# declaration nothing has demanded yet is resolved there, in place
# (scopeMemberTid). None when that declaration does not resolve, or is
# mid-resolution; the walk never moves past it.
walkLookupTyperefFrom: function {
    ast: Ast
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    baseId: zast.nameid
} out optionval ztypes.tid is {
    if baseId.isZero then return (optionval.none ztypes.tid)
    at: resolve.nearestScopeOf typing: st.typing :scope :baseId
    if at.isZero then return (optionval.none ztypes.tid)
    r: resolve.scopeMemberTid :st :ast root: at nameId: baseId
    if r.isZero then return (optionval.none ztypes.tid)
    return (optionval.some r)
}

# typecheck a whole program against registry `reg`: resolve every type,
# stamp all nodes, and return the populated symbol table (diagnostics
# ride in the typing tables).
# publicNsOf -- the publicNs child Decl of the type/unit that minted `tid`
# (0 when the type has no `public:` block). The children are read one index at
# a time: a second st.typing.decls probe cannot run under a live children borrow.
publicNsOf: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
} out ztypes.declid is {
    od: templateDeclOf :reg :typing :tid
    pn: ztypes.declid
    if od.u64 != 0 then pn = typing.declPublicNsOf owner: od
    # a generic instance IS its template's type: it presents the template's
    # public interface, renames and private members alike
    if pn.isZero then {
        og: reg.genericOriginOf :tid
        if og.notZero when og != tid then return (publicNsOf :reg :typing tid: og)
    }
    return pn
}

# declMemberIsPrivate -- member `nameId` is private on the type/unit that minted
# `tid`: true iff that type has a publicNs (a `public:` block) and `nameId` is not
# one of its exposed edges. A generic instance answers with its template's
# publicNs (publicNsOf).
declMemberIsPrivate: function {
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
    nameId: zast.nameid
} out bool is {
    pn: publicNsOf reg: st.reg typing: st.typing :tid
    if pn.isZero then return false
    od: ztypes.declid
    po: st.typing.decls.get i: pn
    od = po.parent
    md: st.typing.declFindChild parentDeclId: od :nameId
    # not private if `nameId` is not a declared member, nor the publicNs block
    # pseudo-member itself
    if md.isZero then return false
    if md == pn then return false
    fcP: st.typing.declFindChild parentDeclId: pn :nameId
    return fcP.isZero
}

# declPublicAliasInternal -- the internal member name that public alias `name`
# exposes on `tid`, or zero when `nameId` is not a renamed public entry (the
# exposed name equals the internal name, or there is no such entry).
declPublicAliasInternal: function {
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
    nameId: zast.nameid
} out zast.nameid is {
    nid: nameId
    if nid.isZero then return zast.nameid
    pn: publicNsOf reg: st.reg typing: st.typing :tid
    if pn.isZero then return zast.nameid
    tgt: st.typing.declFindChild parentDeclId: pn nameId: nid
    if tgt.isZero then return zast.nameid
    intName: zast.nameid
    decl: st.typing.decls.get i: tgt
    intName = decl.name
    if intName == nid then return zast.nameid
    if intName.isZero then return zast.nameid
    return intName
}

# publicAliasInternalNames -- the internal member names `tid`'s public interface
# exposes under a DIFFERENT public name (its alias targets); empty when `tid` has
# no publicNs. The linter marks these as used so a renamed def is not flagged.
publicAliasInternalNames: function {
    st: zenv.ZSymbolTable.view
    pool: zast.StringPool.view
    tid: ztypes.tid
} out List String is {
    result: List String
    pn: publicNsOf reg: st.reg typing: st.typing :tid
    if pn.isZero then return result
    ename: ListVal zast.nameid
    edecl: ListVal ztypes.declid
    po: st.typing.decls.get i: pn
    for each c: po.children.iterateItems loop {
        ename.append from: c.key
        edecl.append from: c.value
    }
    ei: u64
    en: ename.length
    for ei < en loop {
        pubNid: ename.get i: ei
        tdecl: edecl.get i: ei
        ei = ei + 1
        intNid: zast.nameid
        decl: st.typing.decls.get i: tdecl
        intNid = decl.name
        if intNid.notZero when intNid != pubNid then result.append from: (
            zast.poolTextCopy
            :pool
            ref: intNid
        )
    }
    return result
}

# filePathsOf -- each file the parse of `ast` loaded, by its id, at the path a
# diagnostic's location shows it at.
filePathsOf: function {vfs: zvfs.ZVfs.view ast: Ast.view} out (IdMapR zvfs.fsno V: String) is {
    r: IdMapR zvfs.fsno V: String
    for each f: ast.files loop r.set key: f value: (vfs.displayPath dentryid: f)
    return r
}

# checkreach -- where a check's demand starts, besides what a use reaches
checkreach: variant {
    # a program: demand starts at the main unit's `main`
    fromMain: null
    # every declaration written in the main unit -- its nested units, its types'
    # members, every branch of its bodies -- whether or not anything uses it, and
    # the rest of the program as those reach it: a data file, a file being linted
    mainUnit: null
    # every declaration of every unit: `--eager`
    everything: null
} as { tag: u8.tag }
