                                checkMissingCallArgs :ast :st :call funcId: dro isCtor: true
                                (st.typing.callKind.set
                                    key: call.nodeid.u64
                                    value: zast.callkind.recordCreate
                                )
                                st.popTo marker: dcm9
                                dck9: dro
                                dcvv9: true
                                st.typing.constructedTypes.set key: dck9 value: dcvv9
                            }
                            setdc9: dro
                            stampGate :st nid: call.nodeid.u64 tid: setdc9
                            return (ztypes.tid.create from: dro)
                        }
                    }
                }
            }
        } case none then null
        funcId: ztypes.tid
        if cn.length > 0 then {
            # A local variable of FUNCTION type (a spec-typed param or a
            # function reference) is callable; locals shadow unit names.
            lvo: st.lookup nameId: (nameIdOf :ast name: cn.stringview)
            match (
                lvo
            ) case some then {
                if (st.reg.typetypeOf typeId: (ztypes.tid.create from: lvo.u64)) == ztypes.ztypetype.functionType then {
                    funcId = ztypes.tid.create from: lvo.u64
                    st.typing.callKind.set key: call.nodeid.u64 value: zast.callkind.callable
                    # callee-use variable id: calling through a fn-typed
                    # variable reads it, so it stamps like a value atom
                    cvo9: st.lookupVarId nameId: (nameIdOf :ast name: cn.stringview)
                    match (
                        cvo9
                    ) case some then {
                        setcv9: cvo9
                        st.typing.atomVariableId.set key: call.callable.u64 value: setcv9
                    } case none then null
                }
            } case none then null
            if funcId <= 0 then {
                fo: (walkLookupTyperef
                    :ast
                    ty: st.typing
                    reg: st.reg
                    :unitDecl
                    base: cn.stringview
                )
                match (
                    fo
                ) case some then {
                    funcId = ztypes.tid.create from: fo.u64
                } case none then {
                    # The callee is a main-unit type not yet demand-resolved
                    # (a construction inside a method body, walked before the
                    # constructed type). Resolve it on demand, then retry --
                    # otherwise the construction returns 0 and the binding goes
                    # unstamped.
                    maybeWalkMethods :st :unitDecl :ast name: cn.stringview
                    fo2: (walkLookupTyperef
                        :ast
                        ty: st.typing
                        reg: st.reg
                        :unitDecl
                        base: cn.stringview
                    )
                    match (
                        fo2
                    ) case some then {
                        funcId = ztypes.tid.create from: fo2.u64
                    } case none then null
                }
            }
        }
        # the resolved id names the definition wherever it lives, so a callee in
        # another unit is walked at its call site like a local one. The
        # name-keyed trigger could only ever find same-unit definitions: it
        # looked `cn` up in the unit being walked.
        if funcId > 0 then walkDefinitionById :st :ast tid: funcId
        # inside a unit mono's instance walk, a bare callee naming a TEMPLATE
        # member is the MONO's member: the same definition with the argument
        # substitution applied to its parameters and return
        if funcId > 0 when st.typing.curMonoStamp > 0 then {
            funcId = (monoMemberOf
                :st
                templateFnTid: funcId
                nameId: (nameIdOf :ast name: cn.stringview)
            )
        }
        isUser: false
        isGen: false
        isCtor: false
        if funcId > 0 then {
            if funcId >= st.reg.typeById.length then return result
            zo: st.reg.typeById.get i: funcId
            if zo.isgeneric then {
                isGen = true
            } else {
                isUser = true
                if zo.typetype != ztypes.ztypetype.functionType then isCtor = true
            }
        }
        tdb0: u64
        if isCtor then tdb0 = typedefBaseOf :ast :st :unitDecl tid: funcId
        if tdb0 > 0 then return (checkTypedefCreate
            :st
            :unitDecl
            :ast
            :call
            tdId: funcId
        )
        if isUser then {
            calid: nodeId n: (ast.nodes.get i: call.callable.u64)
            setc: funcId
            stampGate :st nid: calid.u64 tid: setc
            # tooling: a bare callable resolving to a unit FUNCTION is a
            # def reference like any bare read (constructors excluded)
            if (isCtor) == false then {
                sfG9: (declSurfaceOfName
                    ty: st.typing
                    reg: st.reg
                    :ast
                    :unitDecl
                    nameId: (zast.poolFind pool: ast.names text: cn.stringview)
                    tid: funcId
                )
                stampRefDecl ty: st.typing nid: calid.u64 declId: sfG9
            }
            cm: st.pushCall
            lockRoot: (walkCallArgsHoist
                :st
                :unitDecl
                :ast
                :call
                :funcId
                :isCtor
                reportUnknown: true
                recvImplicit: false
            )
            checkMissingCallArgs :ast :st :call :funcId :isCtor
            st.popTo marker: cm
            if isCtor then {
                # a type in callable position constructs: the call's value is
                # the type itself.
                ctk: funcId
                ctv: true
                st.typing.constructedTypes.set key: ctk value: ctv
                result = ztypes.tid.create from: funcId.u64
                setr2: result
                stampGate :st nid: call.nodeid.u64 tid: setr2
                ctt9: st.reg.typetypeOf typeId: funcId
                if ctt9 == ztypes.ztypetype.recordType then {
                    st.typing.callKind.set key: call.nodeid.u64 value: zast.callkind.recordCreate
                }
                if ctt9 == ztypes.ztypetype.classType then {
                    st.typing.callKind.set key: call.nodeid.u64 value: zast.callkind.classCreate
                }
                if ctt9 == ztypes.ztypetype.unionType then {
                    st.typing.callKind.set key: call.nodeid.u64 value: zast.callkind.unionCreate
                }
            } else {
                rnOpt: st.typing.funcReturnNode.get key: funcId
                match (
                    rnOpt
                ) case some then {
                    rtOpt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: rnOpt
                    if rtOpt > 0 then {
                        result = ztypes.tid.create from: rtOpt.u64
                        setr: result
                        stampGate :st nid: call.nodeid.u64 tid: setr
                    }
                } case none then null
                # A `.borrow`-marked return borrows from the lock parameter's
                # argument: report the source for the binding site. Argument
                # evaluation residue drains first (owning calls consume it).
                drainPendingBorrow :st
                xroot2: st.typing.lastLockParamRoot.copy
                if xroot2.length > 0 then {
                    st.typing.lastLockParamRoot = "".string
                    drainPendingBorrow :st
                    st.typing.pendingBorrowPath.append xroot2
                }
                if (optBoolOr
                    o: (st.typing.funcReturnsTakex.get key: funcId)
                    d: false
                ) when lockRoot.length > 0 then {
                    # `takex`: pin the source, but the binding stays OWNED
                    drainPendingBorrow :st
                    lrx9: lockRoot.copy
                    st.typing.pendingBorrowPath.append lrx9
                    st.typing.pendingBorrowOwned = true
                }
                if (optBoolOr
                    o: (st.typing.funcReturnsBorrow.get key: funcId)
                    d: false
                ) when lockRoot.length > 0 then {
                    drainPendingBorrow :st
                    lrc: lockRoot.copy
                    st.typing.pendingBorrowPath.append lrc
                    if (returnIsIteratorTid :st tid: result) == false then {
                        st.typing.pendingBorrowShared = true
                    } else {
                        if (methodReceiverIsView :st mid: funcId) then {
                            st.typing.pendingBorrowShared = true
                        }
                    }
                    # An `out T.view` result is a READONLY reference: shared pin,
                    # and the binding it lands on may only be read.
                    if (optBoolOr o: (st.typing.funcReturnsView.get key: funcId) d: false) then {
                        st.typing.pendingBorrowShared = true
                        st.typing.pendingBorrowReadonly = true
                    }
                }
            }
        } else {
            # `Box from: val` -- the system box (empty generic class body)
            # constructs through its own leg: t inferred from the value.
            isBox: false
            if isGen then {
                if (st.reg.typetypeOf typeId: funcId) == ztypes.ztypetype.classType then {
                    bxn: typeNameOf :st tid: funcId
                    if bxn.stringview == "Box" then {
                        if (st.typing.declMemberCount ownerTid: funcId) == 0 then isBox = true
                    }
                }
            }
            if isBox then {
                bres: checkBoxConstruction :st :unitDecl :ast :call tplId: funcId
                if bres > 0 then return bres
            }
            if isGen then {
                gtt: st.reg.typetypeOf typeId: funcId
                if gtt != ztypes.ztypetype.functionType then {
                    errB9: st.typing.errors.length
                    vok9: (validateGenericTypeArgs
                        :ast
                        :st
                        :unitDecl
                        :call
                        tplId: funcId
                        allowFrom: false
                    )
                    gres: genericTypeConstruction :ast :st :unitDecl :call tplId: funcId
                    if gres > 0 then return gres
                    # field-bound value args: infer the instance and construct
                    # through the standard ctor flow (mirrors the reference's
                    # generic record/class construction).
                    # an invalid type-argument list (unknown/duplicate already
                    # diagnosed) never drives field-bound inference; the
                    # single-diagnostic template resolution below stands
                    gmid: ztypes.tid
                    if vok9 then {
                        gmid = (inferGenericConstruction
                            :st
                            :unitDecl
                            :ast
                            :call
                            tplId: funcId
                            reportMissing: vok9
                        )
                    }
                    if gmid > 0 then {
                        calid9: nodeId n: (ast.nodes.get i: call.callable.u64)
                        if calid9 > 0 then {
                            setc9: gmid
                            stampGate :st nid: calid9.u64 tid: setc9
                        }
                        cm9: st.pushCall
                        (walkCallArgsHoist
                            :st
                            :unitDecl
                            :ast
                            :call
                            funcId: (ztypes.tid.create from: gmid.u64)
                            isCtor: true
                            reportUnknown: false
                            recvImplicit: false
                        )
                        (checkMissingCallArgs
                            :ast
                            :st
                            :call
                            funcId: (ztypes.tid.create from: gmid.u64)
                            isCtor: true
                        )
                        st.popTo marker: cm9
                        ctk9: gmid
                        ctv9: true
                        st.typing.constructedTypes.set key: ctk9 value: ctv9
                        setr9: gmid
                        stampGate :st nid: call.nodeid.u64 tid: setr9
                        return (ztypes.tid.create from: gmid)
                    }
                    # Construction failed AND a type-argument diagnostic was
                    # emitted (unknown/duplicate by validation, or cannot-infer
                    # by inferGenericConstruction): resolve to the template so a
                    # single diagnostic stands without a downstream cascade.
                    if st.typing.errors.length > errB9 then {
                        sttE9: funcId
                        stampGate :st nid: call.nodeid.u64 tid: sttE9
                        return (ztypes.tid.create from: funcId)
                    }
                }
                gr: checkGenericCall :st :unitDecl :ast :call :funcId
                result = gr
                if gr > 0 then {
                    setgc: gr
                    stampGate :st nid: call.nodeid.u64 tid: setgc
                }
                if cn.stringview == "panic" then {
                    calid2: nodeId n: (ast.nodes.get i: call.callable.u64)
                    setpk: funcId
                    stampGate :st nid: calid2.u64 tid: setpk
                    st.typing.callKind.set key: call.nodeid.u64 value: zast.callkind.panicCall
                }
                if cn.stringview == "error" then {
                    calid3: nodeId n: (ast.nodes.get i: call.callable.u64)
                    seter: funcId
                    stampGate :st nid: calid3.u64 tid: seter
                    st.typing.callKind.set key: call.nodeid.u64 value: zast.callkind.errorCall
                }
            } else {
                giter: call.arguments.iterate
                for gargId9: giter loop {
                    garg: ast.nodes.get i: gargId9.u64
                    match (
                        garg
                    ) case namedoperation then {
                        (checkValue
                            :st
                            :unitDecl
                            :ast
                            node: (ast.nodes.get i: garg.operation.u64)
                        )
                    } else null
                }
                # a bare callable that resolves NOWHERE is an unknown
                # reference -- without this the emitter's fallback turns a
                # misspelled call into a constant 0 (mirrors the assignment
                # path's unresolved-value report)
                ubcn9: (unresolvedBareCallable
                    :ast
                    :st
                    :unitDecl
                    n: (ast.nodes.get i: call.nodeid.u64)
                )
                if ubcn9.length > 0 then {
                    ubm0: "Unknown reference '\{ubcn9}'"
                    (addError
                        :st
                        nodeid: call.nodeid
                        lineno: call.lineno
                        colno: call.colno
                        e: zast.err.badReference
                        msg: ubm0
                    )
                }
            }
        }
    }
    return result
}

# checkGenericCall -- a call to a generic user function: walk the value args,
# infer the type-param bindings (explicit `param: Type` args, else each value
# arg's materialised type through the parameter it feeds), mint the instance
# (children substituted; return substituted from the recorded `out` placeholder
# name), synthesize the clone scope on first instantiation (empty, named by the
# instance, unreachable per the template body's syntactic divergence -- bodied
# templates only, so native generics like print add no scope), stamp the
# callable with the instance, and resolve to the instance's return. Nested
# control flow inside generic bodies needs a real clone walk and is deferred.
checkGenericCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: zast.CallData.view
    funcId: ztypes.tid
} out ztypes.tid is {
    gparams: (List String)
    with gpiter: st.typing.typeGenericArg.iterate do for gp: gpiter loop {
        if gp.parentTypeId == funcId then {
            gpn: gp.paramName.copy
            gparams.append gpn
        }
    }
    pNames: (List String)
    pHolderIds: (ListVal u64)
    {
        gcNms9: (ListVal u64)
        gcTds9: (ListVal u64)
        st.typing.declMemberList ownerTid: funcId names: gcNms9 tids: gcTds9
        {
            gci9: u64
            gcn9: gcNms9.length
            for gci9 < gcn9 loop {
                gcNid9: gcNms9.get i: gci9
                cto: gcTds9.get i: gci9
                gci9 = gci9 + 1
                {
                    # the receiver is implicit at method call sites: keep it
                    # out of the positional holder list so a label-free arg
                    # maps to the first USER param (T holders included). The
                    # receiver is the shorthand `this` or the type's recorded
                    # long-form receiver name.
                    pnB9: ast.names.texts.get i: gcNid9.u64
                    isRecv9: gcNid9 == zast.wkThis.u64
                    if (isRecv9) == false then {
                        isRecv9 = (st.reg.thisParamNameIs
                            tid: funcId
                            nameId: (zast.nameid.create from: gcNid9.u32.orPanic)
                        )
                    }
                    if (isRecv9) == false then {
                        pn2: pnB9.copy
                        pNames.append pn2
                        cto2: cto
                        pHolderIds.append cto2
                    }
                }
            }
        }
    }
    pHolders: (List String)
    phi: u64
    phn: pHolderIds.length
    for phi < phn loop {
        hid: pHolderIds.get i: phi
        hn: typeNameOf :st tid: (ztypes.tid.create from: hid.u64)
        pHolders.append hn
        phi = phi + 1
    }
    subs: (MapRV String value: u64)
    posIdx: u64
    aiter: call.arguments.iterate
    for argId9: aiter loop {
        arg: ast.nodes.get i: argId9.u64
        match (
            arg
        ) case namedoperation then {
            an2: zast.nameTextAt :ast ref: arg.name
            isTypeArg: false
            tgi: gparams.iterate
            for gp2: tgi loop {
                if an2.stringview == gp2.stringview then isTypeArg = true
            }
            if isTypeArg then {
                tn3: atomName :ast n: (ast.nodes.get i: arg.operation.u64)
                to3: (walkLookupTyperef
                    :ast
                    ty: st.typing
                    reg: st.reg
                    :unitDecl
                    base: tn3.stringview
                )
                match (
                    to3
                ) case some then {
                    sk: an2.copy
                    sv: to3
                    subs.set key: sk value: sv
                } case none then null
            } else {
                avt: (checkValue
                    :st
                    :unitDecl
                    :ast
                    node: (ast.nodes.get i: arg.operation.u64)
                )
                mat: materialiseLiteral :ast :st :unitDecl t: avt
                holder: ""
                if an2.length > 0 then {
                    hi: u64
                    hn2: pNames.length
                    for hi < hn2 loop {
                        pn3: pNames.get i: hi
                        if an2.stringview == pn3.stringview then {
                            hv: pHolders.get i: hi
                            holder = hv.stringview
                        }
                        hi = hi + 1
                    }
                    if holder.length == 0 then {
                        m3: "unknown argument '\{an2}'"
                        sug3: suggestSimilar :ast :st parentTypeId: funcId name: an2.stringview
                        h3: String
                        if sug3.length > 0 then {
                            hh3: "did you mean '\{sug3}'?"
                            h3 = hh3
                        }
                        en3: String
                        (addErrorH
                            :st
                            nodeid: arg.nodeid
                            lineno: arg.lineno
                            colno: arg.colno
                            e: zast.err.callError
                            msg: m3
                            note: en3
                            hint: h3
                            width: an2.length.u32.orPanic
                        )
                    }
                } else {
                    if posIdx < pHolders.length then {
                        hv2: pHolders.get i: posIdx
                        holder = hv2.stringview
                    }
                }
                posIdx = posIdx + 1
                if holder.length > 0 when mat > 0 then {
                    hk: holder
                    hgot: subs.get key: hk.asString
                    match (
                        hgot
                    ) case some then null case none then {
                        sk2: holder.string
                        sv2: mat
                        subs.set key: sk2 value: sv2
                    }
                }
            }
        } else null
    }
    mname: typeNameOf :st tid: funcId
    if mname.length == 0 then return (ztypes.tid.create from: 0)
    allOk: true
    gtk4: declOfTypeId reg: st.reg tid: funcId
    giter2: gparams.iterate
    for gp3: giter2 loop {
        gv: gp3.stringview
        gk: gv
        ggot: subs.get key: gk.asString
        match (
            ggot
        ) case some then {
            (checkConstraintSat
                :ast
                ty: st.typing
                reg: st.reg
                tdecl: gtk4
                paramName: gv
                argTid: (ztypes.tid.create from: ggot.u64)
            )
            an4: monoValName :ast ty: st.typing reg: st.reg tid: (ztypes.tid.create from: ggot.u64)
            mname.append s: "_"
            mname.append s: an4
        } case none then {
            allOk = false
        }
    }
    if allOk == false then return (ztypes.tid.create from: 0)
    if gparams.length == 0 then return (ztypes.tid.create from: 0)
    vsI9: (MapRV String value: u64)
    mid: (getOrMintSpec
        :ast
        ty: st.typing
        reg: st.reg
        :unitDecl
        name: mname.stringview
        templateId: funcId
        :subs
        valSubs: vsI9
        fallbackArg: 0
    )
    # getOrMintSpec resolved the mono structurally through the trie and reports
    # whether it minted rather than reusing an existing spec
    wasNew: st.reg.specWasFresh
    rno: st.typing.funcReturnNode.get key: funcId
    match (
        rno
    ) case some then {
        rk2: copiedMapStr m: st.typing.pendingTyperef key: rno
        if rk2.length > 0 then {
            rgot2: subs.get key: rk2
            match (
                rgot2
            ) case some then {
                st.reg.setReturnType typeId: mid value: rgot2
            } case none then {
                rconc: (walkLookupTyperef
                    :ast
                    ty: st.typing
                    reg: st.reg
                    :unitDecl
                    base: rk2.stringview
                )
                match (
                    rconc
                ) case some then {
                    st.reg.setReturnType typeId: mid value: rconc
                } case none then null
            }
        }
    } case none then null
    # A generic-instance return (`out (optionval t: u64)`) has no bare
    # pendingTyperef name, so the sub/name path above leaves the mono's
    # return unset -- a native template has no body walk to heal it later.
    # Heal from the template's resolved return type, respecializing a spec
    # that mentions generic params (mirrors the generic-class method path).
    rhas9: false
    {
        rmo9: st.reg.returnTypeOf tid: mid
        if rmo9 > 0 then rhas9 = true
    }
    if (rhas9) == false then {
        rto9: u64
        {
            rns9: st.typing.funcReturnNode.get key: funcId
            match (
                rns9
            ) case some then {
                rst9: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: rns9
                if rst9 > 0 then rto9 = rst9
            } case none then null
        }
        if rto9 == 0 then {
            tro9: st.reg.returnTypeOf tid: funcId
            if tro9 > 0 then rto9 = tro9
        }
        if rto9 > 0 then {
            idSubs9: (MapVV u64 value: u64)
            rr9: (respecialize
                :ast
                ty: st.typing
                reg: st.reg
                :unitDecl
                specTid: rto9
                idSubs: idSubs9
            )
            rt9: rto9
            if rr9 > 0 then rt9 = rr9
            if (st.reg.typetypeOf typeId: (ztypes.tid.create from: rt9.u64)) != ztypes.ztypetype.genericParam then {
                st.reg.setReturnType typeId: mid value: rt9
            }
        }
    }
    if wasNew then {
        dvo: st.typing.fnBodyDiverges.get key: funcId
        match (
            dvo
        ) case some then {
            csname: "function:\{mname}"
            cm2: st.pushBlock name: csname.stringview
            if dvo then st.markUnreachable
            st.popTo marker: cm2
        } case none then null
    }
    # The arg walk above (checkValue per value arg) can leave a pending
    # borrow from a projection argument (s.stringview): drain it -- the
    # call's result is an OWNED value, so a binding of it must not borrow
    # the argument's source. A view-returning generic native would need to
    # propagate its own borrow here instead.
    drainPendingBorrow :st
    with gsub9: subs.iterateItems do for ge9: gsub9 loop {
        gk9: (ztyping.callslot
            call: call.nodeid.u64
            param: (zast.poolFind pool: ast.names text: ge9.key.stringview).u64
        )
        st.typing.callGenericBinding.set key: gk9 value: ge9.value
    }
    calid2: nodeId n: (ast.nodes.get i: call.callable.u64)
    setc2: mid
    stampGate :st nid: calid2.u64 tid: setc2
    return (optTidOr o: (methodReturnOf :st :mid) d: ztypes.tid)
}

# subjectAtomName -- a match subject's bare-atom name (narrowing requires a
# simple addressable name): unwrap expression wrappers, "" for dotted/complex
# subjects and numeric atoms.
subjectAtomName: function {ast: Ast.view n: Node.view} out String is {
    match (
        n
    ) case expression then {
        return (subjectAtomName :ast n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        saB9: ast.names.texts.get i: n.name.u64
        if (isNumericLiteralName name: saB9.stringview) then {
            return "".string
        } else {
            return saB9.copy
        }
    } else {
        return "".string
    }
}

# sumSubtypeNames -- a union/variant's arm names: its members minus the
# synthesized ones (functions, the tag data record, enums).
sumSubtypeNames: function {ast: Ast.view st: zenv.ZSymbolTable sid: u64} out List String is {
    arms: (List String)
    (zenv.sumArmNames
        ty: st.typing
        reg: st.reg
        pool: ast.names
        tid: (ztypes.tid.create from: sid.u64)
        names: arms
    )
    return arms
}

# isEmptyBody -- a statement block with no statement lines (an empty
# `{}` or `null` clause body).
isEmptyBody: function {n: Node.view} out bool is {
    match (
        n
    ) case statement then {
        return n.statements.length == 0
    } else {
        return false
    }
}

# checkCase -- walk a match: push the `match` scope, type the subject, push
# `match_body` (resetting the bare-name subject's narrowing), then per arm an
# `arm:{name}` scope with a shadow-narrowing overlay (the subject resolves to
# the arm payload in the body), tracking diverging arms; an else arm excludes
# the covered subtypes. After popping, an exhaustive all-diverging match
# resolves to `never` (a completing-arm result type lands with a value-match
# example) and each diverging arm's subtype is excluded from the subject in
# the enclosing scope (all-excluded marks it unreachable).
checkCase: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    casenode: zast.CaseData.view
} out ztypes.tid is {
    foldCaseArm :ast ty: st.typing reg: st.reg :unitDecl n: casenode
    constFailClear ty: st.typing
    matchMarker: st.pushBlock name: "match"
    subjT: (checkValue
        :st
        :unitDecl
        :ast
        node: (ast.nodes.get i: casenode.subject.u64)
    )
    # A bare generic-parameter subject (`match t`) is not a value -- resolve it
    # against the enclosing generic context (synthLabel is `{unit}.{type}` for a
    # method, `{unit}.{fn}` for a generic free function or unit) so it stamps as a
    # genericParam and the emitter can dissect it per monomorphised instance.
    if subjT.isZero then {
        gsn9: subjectAtomName :ast n: (ast.nodes.get i: casenode.subject.u64)
        if gsn9.length > 0 then {
            gdecl9: ztypes.declid
            {
                slOwn9: st.typing.synthLabel
                slv9: slOwn9.stringview
                sdot9: slv9.indexOf needle: "."
                match (
                    sdot9
                ) case some then {
                    su9: unitDeclOfName ty: st.typing :ast name: (slv9.substring from: 0 to: sdot9)
                    sn9: slv9.substring from: (sdot9 + 1) to: slv9.length
                    gdecl9 = (declOfUnitDef
                        ty: st.typing
                        :ast
                        unitDecl: su9
                        name: sn9
                    )
                } case none then null
            }
            if (gdecl9.isZero) == false then {
                if (st.reg.isGenericParamOf tdecl: gdecl9 name: gsn9.stringview) == false then {
                    gdecl9 = ztypes.declid.create from: 0
                }
            }
            if gdecl9.isZero then {
                gur9: unitDecl
                if (gur9.isZero) == false then {
                    if (st.reg.isGenericParamOf tdecl: gur9 name: gsn9.stringview) then {
                        gdecl9 = gur9
                    }
                }
            }
            if gdecl9.isZero when st.typing.curMonoStamp > 0 then {
                # a mono-clone body walk: the subject's template is the
                # current mono's generic origin
                mog9: ztypes.tid
                {
                    mgo9: st.reg.genericOriginOf tid: (ztypes.tid.create from: st.typing.curMonoStamp)
                    if mgo9 > 0 then mog9 = mgo9
                }
                if mog9 > 0 then {
                    gdecl9 = declOfTypeId reg: st.reg tid: (ztypes.tid.create from: mog9.u64)
                    if (gdecl9.isZero) == false then {
                        if (st.reg.isGenericParamOf
                            tdecl: gdecl9
                            name: gsn9.stringview
                        ) == false then gdecl9 = ztypes.declid.create from: 0
                    }
                }
            }
            if gdecl9.isZero then {
                # the template's own body walk runs with unitDecl = the
                # TEMPLATE's name; the template def lives in the main unit,
                # which the registry names -- the eager walk's current unit
                # happened to be it for every program that reaches here, but
                # only because such a template is declared where main is.
                gunm9: unitNameTextOf ty: st.typing :ast :unitDecl
                gmud9: st.typing.mainUnitRoot
                gcand9: (declOfUnitDef
                    ty: st.typing
                    :ast
                    unitDecl: gmud9
                    name: gunm9.stringview
                )
                if gcand9 > 0 then {
                    if (st.reg.isGenericParamOf tdecl: gcand9 name: gsn9.stringview) then {
                        gdecl9 = gcand9
                    }
                }
            }
            if (gdecl9.isZero) == false then {
                pgo9: st.reg.genericParamTidOf tdecl: gdecl9 paramName: gsn9.stringview
                match (
                    pgo9
                ) case some then {
                    subjT = ztypes.tid.create from: pgo9.u64
                } case none then {
                    ptid9: (st.reg.newType
                        name: gsn9.stringview
                        typetype: ztypes.ztypetype.genericParam
                    )
                    st.reg.setGenericParamTid tdecl: gdecl9 paramName: gsn9.stringview tid: ptid9
                    subjT = ptid9
                }
                gsnid9: nodeId n: (ast.nodes.get i: casenode.subject.u64)
                if gsnid9 > 0 when subjT > 0 then {
                    # direct write, NOT stampGate: this genericParam stamp IS
                    # the dissection marker the emitter dispatches on -- it
                    # must survive the template walk's param-stamp suppression
                    # AND override any substituted per-mono stamp the general
                    # subject walk wrote (the canonical param tid is in
                    # monoParamSubst now, so stampGate substitutes it)
                    setgs9: subjT
                    ztyping.nodeTypeSet tbl: st.typing.nodeType nid: gsnid9.u64 tid: setgs9
                    if st.typing.curMonoStamp > 0 then {
                        gmk9: (ztyping.monostamp mono: st.typing.curMonoStamp node: gsnid9.u64)
                        st.typing.monoNodeType.set key: gmk9 value: setgs9
                    }
                }
            }
        }
    }
    # per-mono instance walk: a subject that is a bare TYPE name (resolved
    # by the instance's scope define, not a value) is a compile-time
    # dissection -- template-time checking validated it and the emitter
    # dispatches one arm per mono; there is nothing to stamp here
    if st.typing.curMonoStamp > 0 when subjT > 0 then {
        dsn9: subjectAtomName :ast n: (ast.nodes.get i: casenode.subject.u64)
        if dsn9.length > 0 then {
            dsv9: st.lookupVarId nameId: (nameIdOf :ast name: dsn9.stringview)
            match (
                dsv9
            ) case some then null case none then {
                st.popTo marker: matchMarker
                return (ztypes.tid.create from: 0)
            }
        }
    }
    if subjT > 0 then {
        if (st.reg.typetypeOf typeId: subjT) == ztypes.ztypetype.genericParam then {
            # a genericParam subject IS a compile-time dissection: write the
            # marker stamp directly (stampGate suppresses param stamps in
            # template walks, and the per-mono slot must carry the param,
            # not its substitution, for the emitter's dispatch gate)
            gmn9: nodeId n: (ast.nodes.get i: casenode.subject.u64)
            if gmn9 > 0 then {
                gmv9: subjT
                ztyping.nodeTypeSet tbl: st.typing.nodeType nid: gmn9.u64 tid: gmv9
                if st.typing.curMonoStamp > 0 then {
                    gmk8: (ztyping.monostamp mono: st.typing.curMonoStamp node: gmn9.u64)
                    st.typing.monoNodeType.set key: gmk8 value: gmv9
                }
            }
        }
    }
    isSum: false
    if subjT > 0 then {
        stt: st.reg.typetypeOf typeId: subjT
        if stt == ztypes.ztypetype.unionType then isSum = true
        if stt == ztypes.ztypetype.variantType then isSum = true
    }
    isGenericSubj9: false
    if subjT > 0 then {
        if (st.reg.typetypeOf typeId: subjT) == ztypes.ztypetype.genericParam then isGenericSubj9 = true
    }
    if isGenericSubj9 then {
        # `match t` dissects the TYPE parameter at monomorphisation. A match
        # over a VALUE whose type is the generic parameter has no per-
        # instance arm dispatch (the template body is shared), so it is
        # rejected rather than silently taking the else path.
        gvid9: innermostNodeId :ast n: (ast.nodes.get i: casenode.subject.u64)
        gvav9: st.typing.atomVariableId.get key: gvid9.u64
        match (
            gvav9
        ) case some then {
            gvav9
            gsub0: ast.nodes.get i: casenode.subject.u64
            gtn0: typeNameOf :st tid: subjT
            gtnc0: gtn0
            gm9: "cannot match over a value of generic parameter type '\{gtnc0}'"
            gh9: "dissect the type parameter itself (`match \{gtnc0}`), or move the value dispatch outside the generic"
            gn9: String
            (addErrorH
                :st
                nodeid: (nodeId n: gsub0)
                lineno: (nodeLine n: gsub0)
                colno: (nodeCol n: gsub0)
                e: zast.err.typeError
                msg: gm9
                note: gn9
                hint: gh9
                width: 0
            )
            return (ztypes.tid.create from: 0)
        } case none then null
    }
    # A match dissects a union/variant into its arms (a runtime discriminator
    # test) or a generic parameter into its resolutions (at monomorphisation).
    # Any other subject -- a numeric, string, class, record, or a constant --
    # has no child arms to dissect into.
    if subjT > 0 when (isSum) == false when (isGenericSubj9) == false then {
        subjNode9: ast.nodes.get i: casenode.subject.u64
        subjTn0: typeNameOf :st tid: subjT
        smsg9: "match subject must be a union, variant, or generic parameter, got '\{subjTn0}'"
        (addError
            :st
            nodeid: (nodeId n: subjNode9)
            lineno: (nodeLine n: subjNode9)
            colno: (nodeCol n: subjNode9)
            e: zast.err.typeError
            msg: smsg9
        )
    }
    drainPendingBorrow :st
    targetName: String
    if isSum then {
        tn: subjectAtomName :ast n: (ast.nodes.get i: casenode.subject.u64)
        targetName = tn
    }
    neverId: u64
    nvOpt: walkLookupTyperef :ast ty: st.typing reg: st.reg :unitDecl base: "never"
    match (
        nvOpt
    ) case some then {
        neverId = nvOpt
    } case none then null
    nullId: (optU64Or
        o: (walkLookupTyperef :ast ty: st.typing reg: st.reg :unitDecl base: "null")
        d: 0
    )
    anyEmpty: false
    st.pushBlock name: "match_body"
    if targetName.length > 0 then st.resetNarrowing nameId: (nameIdOf
        :ast
        name: targetName.stringview
    )
    covered: (List String)
    diverging: (List String)
    armTypes: (ListVal u64)
    allDiverge: true
    cliter: casenode.clauses.iterate
    for clauseId9: cliter loop {
        clause: ast.nodes.get i: clauseId9.u64
        match (
            clause
        ) case caseclause then {
            armName: atomName :ast n: (ast.nodes.get i: clause.matcharm.u64)
            armId9: atomNameId :ast n: (ast.nodes.get i: clause.matcharm.u64)
            if (isEmptyBody n: (ast.nodes.get i: clause.statement.u64)) then anyEmpty = true
            # A value-match literal arm wears the subject's concrete type.
            if (isSum) == false then {
                if (isNumericLiteralName name: armName.stringview) when subjT > 0 then {
                    if (isLiteralTypeId :st tid: subjT) == false then {
                        amid9: clause.matcharm
                        if amid9 > 0 then {
                            seta9: subjT
                            stampGate :st nid: amid9.u64 tid: seta9
                        }
                    }
                }
            }
            asname: "arm:\{armName}"
            armMarker: st.pushBlock name: asname.stringview
            # Every arm of a sum subject must name one of its declared arms.
            armo9: (optionval.none u64)
            (forceMemberOf ty: st.typing reg: st.reg :ast parentTypeId: subjT nameId: armId9)
            if subjT > 0 then armo9 = st.typing.declChildOfId parentTypeId: subjT nameId: armId9
            if isSum when subjT > 0 then {
                match (
                    armo9
                ) case some then null case none then {
                    subjTn9: typeNameOf :st tid: subjT
                    amsg9: "type '\{subjTn9}' has no arm '\{armName}'"
                    marm9: ast.nodes.get i: clause.matcharm.u64
                    (addError
                        :st
                        nodeid: (nodeId n: marm9)
                        lineno: (nodeLine n: marm9)
                        colno: (nodeCol n: marm9)
                        e: zast.err.typeError
                        msg: amsg9
                    )
                }
            }
            if targetName.length > 0 when subjT > 0 then {
                match (
                    armo9
                ) case some then {
                    (st.narrow
                        pool: ast.names
                        nameId: (nameIdOf :ast name: targetName.stringview)
                        toTypeId: armo9
                        subtypeName: armName.stringview
                        shadow: true
                    )
                    (armPayloadReadonly
                        :st
                        :ast
                        subject: targetName.stringview
                        parentTid: subjT
                        armName: armName.stringview
                        payloadTid: (ztypes.tid.create from: armo9.u64)
                    )
                } case none then null
            }
            cstC9: ast.nodes.get i: clause.statement.u64
            checkStatement :st :unitDecl :ast block: cstC9
            at: lastStmtType :st :ast block: cstC9
            atc: at
            armTypes.append atc
            if at > 0 when at == neverId then {
                dn: armName.copy
                diverging.append dn
            } else {
                allDiverge = false
            }
            cn2: armName.copy
            covered.append cn2
            if st.isUnreachable then st.discardTakenInCurrentScope
            st.popTo marker: armMarker
        } else null
    }
    hasElse: casenode.elseclause > 0
    if hasElse then {
        if (isEmptyBody n: (ast.nodes.get i: casenode.elseclause.u64)) then anyEmpty = true
        elseMarker: st.pushBlock name: "arm:else"
        if targetName.length > 0 when subjT > 0 then {
            with eiter: covered.iterate do for en2: eiter loop {
                (st.exclude
                    pool: ast.names
                    nameId: (nameIdOf :ast name: targetName.stringview)
                    subtypeName: en2.stringview
                    fullTypeId: subjT
                )
            }
            shadowCollapseIfSingle :ast :st name: targetName.stringview fullTid: subjT
        }
        walkBodyAt :st :unitDecl :ast bodyId: casenode.elseclause
        ecr9: ast.nodes.get i: casenode.elseclause.u64
        et: lastStmtType :st :ast block: ecr9
        armTypes.append et
        # the else is an arm: it decides `allDiverge` like any other. Leaving it
        # out stamped `never` on a match whose else completes -- and `never` is
        # read downstream as "control does not continue", so the emitter dropped
        # the enclosing arm's `break` and the switch fell through.
        if et > 0 when et == neverId then null else allDiverge = false
        if st.isUnreachable then st.discardTakenInCurrentScope
        st.popTo marker: elseMarker
    }
    st.popTo marker: matchMarker
    exhaustive: hasElse
    if (exhaustive) == false then {
        if isSum then {
            arms2: sumSubtypeNames :ast :st sid: subjT
            # ambient narrowing relaxes the requirement: a subject already
            # narrowed to a single arm needs only that arm's case; arms the
            # enclosing flow has excluded are impossible and need none.
            required9: (List String)
            nsn9: String
            if targetName.length > 0 then {
                gsn9: (st.narrowedArmOf
                    nameId: (nameIdOf :ast name: targetName.stringview)
                    fullTypeId: subjT
                )
                nsn9 = gsn9
            }
            if nsn9.length > 0 then {
                nreq9: nsn9.copy
                required9.append nreq9
            } else {
                excl9: (Set String)
                if targetName.length > 0 then {
                    (st.collectExcluded
                        nameId: (nameIdOf :ast name: targetName.stringview)
                        into: excl9
                    )
                }
                with a0it9: arms2.iterate do for an0: a0it9 loop {
                    if (excl9.has item: an0) == false then required9.append an0.copy
                }
            }
            allCovered: true
            missing9: (List String)
            a2iter: required9.iterate
            for an3: a2iter loop {
                found: false
                c2iter: covered.iterate
                for cn3: c2iter loop {
                    if an3.stringview == cn3.stringview then found = true
                }
                if (found) == false then {
                    allCovered = false
                    missing9.append an3.copy
                }
            }
            exhaustive = allCovered
            if (allCovered) == false then {
                mj9: String
                mfirst9: true
                with mit9: missing9.iterate do for mn9: mit9 loop {
                    if (mfirst9) == false then mj9.append ", "
                    mj9.append mn9
                    mfirst9 = false
                }
                (addErrorH
                    :st
                    nodeid: casenode.nodeid
                    lineno: casenode.lineno
                    colno: casenode.colno
                    e: zast.err.nonExhaustive
                    msg: "non-exhaustive match: missing case(s) \{mj9} -- add them or an `else` clause"
                    note: "".string
                    hint: "".string
                    width: 5
                )
            }
        }
    }
    if targetName.length > 0 when subjT > 0 then {
        with diter: diverging.iterate do for dn2: diter loop {
            (st.exclude
                pool: ast.names
                nameId: (nameIdOf :ast name: targetName.stringview)
                subtypeName: dn2.stringview
                fullTypeId: subjT
            )
        }
        if diverging.length > 0 then {
            shadowCollapseIfSingle :ast :st name: targetName.stringview fullTid: subjT
            (postGuardRecord
                :ast
                :st
                stmtNid: casenode.nodeid
                subject: targetName.stringview
                fullTid: subjT
            )
        }
    }
    if exhaustive when allDiverge when neverId > 0 then {
        if casenode.clauses.length > 0 then {
            setn2: neverId
            stampGate :st nid: casenode.nodeid.u64 tid: (ztypes.tid.create from: setn2.u64)
            return (ztypes.tid.create from: neverId)
        } else {
            return (ztypes.tid.create from: 0)
        }
    }
    if exhaustive when anyEmpty then {
        # an empty (`{}` / null) arm body makes the match valueless: stamp
        # null so consuming the match as a value is rejected.
        if nullId > 0 then {
            setne0: nullId
            stampGate :st nid: casenode.nodeid.u64 tid: (ztypes.tid.create from: setne0.u64)
            return (ztypes.tid.create from: nullId)
        }
        return (ztypes.tid.create from: 0)
    }
    if exhaustive then {
        # the first completing (non-diverging) arm's type is the match value;
        # an untyped completing arm leaves the match unstamped.
        ti: u64
        tn4: armTypes.length
        for ti < tn4 loop {
            at2: armTypes.get i: ti
            if at2 != neverId then {
                if at2 > 0 then {
                    setc3: at2
                    stampGate :st nid: casenode.nodeid.u64 tid: (ztypes.tid.create from: setc3.u64)
                    return (ztypes.tid.create from: at2)
                } else {
                    return (ztypes.tid.create from: 0)
                }
            }
            ti = ti + 1
        }
        return (ztypes.tid.create from: 0)
    } else {
        return (ztypes.tid.create from: 0)
    }
}

# checkValue -- type an expression-value node, dispatching by kind. Returns the
# resolved type id, or 0 when unhandled.
checkValue: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    node: Node.view
} out ztypes.tid is {
    match (
        node
    ) case call then {
        return (checkCall :st :unitDecl :ast call: node)
    } case binop then {
        return (checkBinop :st :unitDecl :ast binop: node)
    } case atomid then {
        return (checkAtomid :st :unitDecl :ast :node)
    } case atomstring then {
        return (checkString :st :unitDecl :ast :node)
    } case dottedpath then {
        return (checkDotted :st :unitDecl :ast dp: node coerce: true)
    } case caseexpr then {
        return (checkCase :st :unitDecl :ast casenode: node)
    } case ifexpr then {
        return (checkIf :st :unitDecl :ast ifnode: node)
    } case forexpr then {
        return (checkFor :st :unitDecl :ast fornode: node)
    } case labelvalue then {
        # the `:x` shorthand in value position reads the local x -- and only a
        # local: it resolves through no other scope, so a miss is unresolvable
        lvNm9: ast.names.texts.get i: node.name.u64
        lvo9: st.lookup nameId: (nameIdOf :ast name: lvNm9.stringview)
        match (
            lvo9
        ) case some then {
            setlv9: lvo9
            stampGate :st nid: node.nodeid.u64 tid: (ztypes.tid.create from: setlv9.u64)
            lvv9: st.lookupVarId nameId: (nameIdOf :ast name: lvNm9.stringview)
            match (
                lvv9
            ) case some then {
                setlvv9: lvv9
                st.typing.atomVariableId.set key: node.nodeid.u64 value: setlvv9
            } case none then null
            return (ztypes.tid.create from: lvo9)
        } case none then {
            lvm9: "Unknown reference '\{lvNm9}'"
            lvn9: String
            lvh9: "the ':name' shorthand reads a local named '\{lvNm9}'; write the argument in full to pass something else"
            (addErrorH
                :st
                nodeid: node.nodeid
                lineno: node.lineno
                colno: node.colno
                e: zast.err.badReference
                msg: lvm9
                note: lvn9
                hint: lvh9
                width: lvNm9.length.u32.orPanic
            )
            return (ztypes.tid.create from: 0)
        }
    } case yieldexpr then {
        # a suspension point: the yielded value walks for diagnostics. A
        # bidirectional generator's yield carries the resumed value -- the
        # synth `.call`'s `value` parameter's type (the node itself stays
        # unstamped; the expression wrapper takes the type). A reftype
        # resume value is a borrow into the caller's argument: the
        # surrounding binding becomes BORROWED origin value.
        checkValue :st :unitDecl :ast node: (ast.nodes.get i: node.expr.u64)
        yvo: st.lookup nameId: (nameIdOf :ast name: "value")
        match (
            yvo
        ) case some then {
            if (typeIsReftype :st tid: (ztypes.tid.create from: yvo.u64)) then {
                drainPendingBorrow :st
                yvc: "value".string
                st.typing.pendingBorrowPath.append yvc
            }
            return (ztypes.tid.create from: yvo)
        } case none then {
            return (ztypes.tid.create from: 0)
        }
    } case doexpr then {
        return (checkDo :st :unitDecl :ast donode: node)
    } case withexpr then {
        return (checkWith :st :unitDecl :ast withnode: node)
    } case reassignment then {
        checkReassignment :st :unitDecl :ast rasgn: node
        return (ztypes.tid.create from: 0)
    } case swapstmt then {
        checkSwap :st :unitDecl :ast swapnode: node
        return (ztypes.tid.create from: 0)
    } case expression then {
        t: (checkValue
            :st
            :unitDecl
            :ast
            node: (ast.nodes.get i: node.expression.u64)
        )
        if t > 0 then stampGate :st nid: node.nodeid.u64 tid: t
        return t
    } else {
        return (ztypes.tid.create from: 0)
    }
}

# checkExpression -- type an expression wrapper from its inner value; returns
# true when the inner is a return terminator (so the caller marks the scope
# unreachable).
checkExpression: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    ast: Ast.view
    expr: zast.ExpressionData.view
} out bool is {
    isRet: false
    t: checkValue :st :unitDecl :ast node: (ast.nodes.get i: expr.expression.u64)
    if t > 0 then stampGate :st nid: expr.nodeid.u64 tid: t
    innerNid: nodeId n: (ast.nodes.get i: expr.expression.u64)
    ckOpt: st.typing.callKind.get key: innerNid.u64
    isRet = isReturnCallKind o: ckOpt
    return isRet
}

# checkStmtInner -- dispatch a statement line's inner node (C1: expressions).
checkStmtInner: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    inner: Node.view
} out bool is {
    match (
        inner
    ) case expression then {
        errE0: st.typing.errors.length
        isR0: checkExpression :st :unitDecl :ast expr: inner
        bn0: bareAtomName :ast n: (ast.nodes.get i: inner.expression.u64)
        if bn0.stringview == "break" then isR0 = true
        if bn0.stringview == "continue" then isR0 = true
        if bn0.stringview == "return" then isR0 = true
        # a statement whose value resolved to nothing and raised nothing:
        # an unresolvable root name is an unknown reference (the emitter
        # would otherwise hit its unhandled-callee backstop)
        ctl0: false
        if bn0.stringview == "break" then ctl0 = true
        if bn0.stringview == "continue" then ctl0 = true
        if bn0.stringview == "return" then ctl0 = true
        if st.typing.errors.length == errE0 when ctl0 == false then {
            eto0: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: inner.nodeid.u64
            unkn0: true
            if eto0 > 0 then unkn0 = false
            if unkn0 then {
                einv0: ast.nodes.get i: inner.expression.u64
                ubn1: unresolvedBareCallable :ast :st :unitDecl n: einv0
                if ubn1.length > 0 then {
                    um1: "Unknown reference '\{ubn1}'"
                    en1u: String
                    eh1u: String
                    (addErrorH
                        :st
                        nodeid: (nodeId n: einv0)
                        lineno: (nodeLine n: einv0)
                        colno: (nodeCol n: einv0)
                        e: zast.err.badReference
                        msg: um1
                        note: en1u
                        hint: eh1u
                        width: ubn1.length.u32.orPanic
                    )
                }
            }
        }
        return isR0
    } case assignment then {
        checkAssignment :st :unitDecl :ast asgn: inner
        return false
    } case reassignment then {
        checkReassignment :st :unitDecl :ast rasgn: inner
        return false
    } else {
        return false
    }
}

# checkStatementLine -- type a statement line; propagate the inner type to the
# line wrapper. Returns true for a return terminator.
checkStatementLine: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    sline: Node.view
} out bool is {
    isRet: false
    match (
        sline
    ) case statementline then {
        sln9: ast.nodes.get i: sline.statementline.u64
        isRet = checkStmtInner :st :unitDecl :ast inner: sln9
        inid: nodeId n: sln9
        itOpt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: inid.u64
        if itOpt > 0 then {
            stampGate :st nid: sline.nodeid.u64 tid: (ztypes.tid.create from: itOpt.u64)
        }
    } else null
    return isRet
}

# checkStatement -- walk a function-body statement block, marking the scope
# unreachable after a control-flow terminator (return).
checkStatement: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    block: Node.view
} is {
    match (
        block
    ) case statement then {
        siter: block.statements.iterate
        for slnId9: siter loop {
            sline: ast.nodes.get i: slnId9.u64
            isRet: checkStatementLine :st :unitDecl :ast :sline
            drainPendingBorrow :st
            if isRet then st.markUnreachable
        }
    } else null
}

# walkBodyAt -- walk a function body by its table id (0 = a spec method, no body).
walkBodyAt: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    ast: Ast.view
    bodyId: zast.nodeid
} is {
    if bodyId > 0 then {
        b9: ast.nodes.get i: bodyId.u64
        checkStatement :st :unitDecl :ast block: b9
    }
}

# nodeIsFunctiondef -- kind test that keeps the caller's un-narrowed handle.
nodeIsFunctiondef: function {o: Node.view} out bool is {
    match (
        o
    ) case functiondef then {
        return true
    } else {
        return false
    }
}

# objectdefIsGeneric -- a type definition with a generic as-block parameter;
# generic templates are never body-walked (instances clone at call sites).
objectdefIsGeneric: function {ast: Ast.view o: Node.view} out bool is {
    match (
        o
    ) case objectdef then {
        return (hasGenericParam :ast items: o.asItems)
    } else {
        return false
    }
}

# scanTypeNameOpt -- recurse the method-walk trigger into an optional typeref
# (a function's return type).
scanTypeNameOpt: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    ast: Ast.view
    oId: zast.nodeid
} is {
    if oId.isZero then return
    o: ast.nodes.get i: oId.u64
    bn: baseTypeName :ast n: o
    if bn.length > 0 then maybeWalkMethods :st :unitDecl :ast name: bn.stringview

}

# scanFnSig -- recurse the method-walk trigger through a function signature in
# resolution order: the return type first, then parameters in declaration order.
scanFnSig: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    ast: Ast.view
    op: Node.view
} is {
    match (
        op
    ) case functiondef then {
        scanTypeNameOpt :st :unitDecl :ast oId: op.returntype
        piter: op.parameters.iterate
        for pmId9: piter loop {
            pm: ast.nodes.get i: pmId9.u64
            match (
                pm
            ) case namedoperation then {
                bn: baseTypeName :ast n: (ast.nodes.get i: pm.operation.u64)
                if bn.length > 0 then (maybeWalkMethods
                    :st
                    :unitDecl
                    :ast
                    name: bn.stringview
                )
            } else null
        }
    } else null
}

# scanMemberSignatures -- replay one definition's signature-resolution order:
# an objectdef resolves its field typerefs, then its is- and as-block method
# signatures; a function resolves its own signature. Each name recurses the
# trigger, so transitively referenced types walk their methods first.
scanMemberSignatures: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    ast: Ast.view
    op: Node.view
} is {
    if (nodeIsFunctiondef o: op) then {
        scanFnSig :st :unitDecl :ast :op
    } else {
        match (
            op
        ) case objectdef then {
            with fiter: op.isItems.iterate do for fmId9: fiter loop {
                fm: ast.nodes.get i: fmId9.u64
                match (
                    fm
                ) case namedoperation then {
                    if (nodeIsFunctiondef o: (ast.nodes.get i: fm.operation.u64)) == false then {
                        bn: baseTypeName :ast n: (ast.nodes.get i: fm.operation.u64)
                        if bn.length > 0 then {
                            maybeWalkMethods :st :unitDecl :ast name: bn.stringview
                        }
                    }
                } else null
            }
            with iiter: op.isItems.iterate do for imId9: iiter loop {
                im: ast.nodes.get i: imId9.u64
                match (
                    im
                ) case namedoperation then {
                    (scanFnSig
                        :st
                        :unitDecl
                        :ast
                        op: (ast.nodes.get i: im.operation.u64)
                    )
                } else null
            }
            with aiter: op.asItems.iterate do for amId9: aiter loop {
                am: ast.nodes.get i: amId9.u64
                match (
                    am
                ) case namedoperation then {
                    (scanFnSig
                        :st
                        :unitDecl
                        :ast
                        op: (ast.nodes.get i: am.operation.u64)
                    )
                } else null
            }
        } else null
    }
}

# maybeWalkMethods -- the resolution-time method-walk trigger: the first time
# a body walk resolves a main-unit definition's name, replay the reference
# resolver's side effects at the current scope position -- scan the signature
# typerefs (recursing per name), then body-check the type's methods. The
# early mark stops re-entry (a method constructing its own type).
maybeWalkMethods: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    name: StringView
} is {
    # The declaring node comes from the DECL, not from a positional index into
    # one unit's body list. That index was keyed by bare name and indexed the
    # target unit's members only, which is the whole of what the main-unit fence
    # here used to guard -- consulting it from elsewhere would have walked
    # whatever member happened to share the name. A Decl is keyed by (unit,
    # name) and records the node that declared it, so any unit's definition can
    # be walked at the point something demands it.
    nmId9: zast.poolFind pool: ast.names text: name
    if nmId9.isZero then return
    dd9: (declOfUnitDefIds
        ty: st.typing
        :unitDecl
        nameId: nmId9
    )
    if dd9.isZero then return
    if (st.typing.declIsWalked declId: dd9) then return
    walkDeclaredDef :st :ast :unitDecl :name declId: dd9
}

# walkDefinitionById -- walk the definition a RESOLVED ID names, wherever it
# lives. A unit is code layout: a path the parser follows to reach a definition,
# not a property of the walk. So the walk takes the definition -- the id IS the
# definition -- and reads its unit back off it for the one thing that needs one:
# the visibility context of the body being walked, where `un != unitDecl` is
# what makes a reference external. Deriving that from the CALLER instead would
# read a unit's use of its own private definitions as external access.
walkDefinitionById: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    tid: ztypes.tid
} is {
    if tid.isZero then return
    dcl9: st.typing.declIdOfType typeId: tid
    if dcl9.isZero then return
    dnm9: u32
    {
        dv9: st.typing.decls.get i: dcl9.u64
        dnm9 = dv9.name
    }
    if dnm9 == 0 then return
    unTd9: unitDeclOfTid ty: st.typing reg: st.reg :tid
    if unTd9.isZero then return
    nt9: zast.poolTextAt pool: ast.names ref: (zast.nameid.create from: dnm9)
    (walkDeclaredDef
        :st
        :ast
        unitDecl: unTd9
        name: nt9.stringview
        declId: dcl9
    )
}

# walkDeclaredDef -- the shared core: mark the definition walked and walk it.
# `unitBody` is gone from here; it was threaded to reach a positional index that
# no longer exists.
walkDeclaredDef: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    name: StringView
    declId: ztypes.declid
} is {
    # the definition is walked in the frame of its own declaration
    prevFrame9: st.typing.curFrame
    if (declId.isZero) == false then st.typing.curFrame = declId
    walkDeclaredDefIn :st :ast :unitDecl :name :declId
    st.typing.curFrame = prevFrame9
}

walkDeclaredDefIn: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    name: StringView
    declId: ztypes.declid
} is {
    dd9: declId
    if (st.typing.declIsWalked declId: dd9) then return
    memId9: u32
    inNs9: false
    {
        do9: st.typing.decls.get i: dd9.u64
        memId9 = do9.node
        # a definition inside a NAMESPACE reads its own siblings from the
        # namespace's frame: `deep.mul` inside helper resolves against
        # helper first. checkNamespaceBodies walks it with the cursor at
        # the namespace, so a namespace member is left to that walk.
        pr9: do9.parent
        if (pr9.isZero) == false then {
            uro9: unitDecl
            if (uro9.isZero) == false then {
                if (pr9 == uro9) == false then inNs9 = true
            }
        }
    }
    if memId9 == 0 then return
    if inNs9 then return
    # The mark means BODY WALKED, so it is never set for a definition this is
    # not about to walk. Claiming one and declining is what made a free function
    # -- and then a namespace -- vanish: the unit's own walk skipped it as done.
    mopId9: zast.nodeid
    {
        mm2: ast.nodes.get i: memId9.u64
        if mm2.namedoperation then mopId9 = mm2.operation
    }
    if mopId9.isZero then return
    isFn9: false
    if (isFunctionDefWithBody o: (ast.nodes.get i: mopId9.u64)) then isFn9 = true
    canW9: isFn9
    if (canW9) == false then {
        if (objectdefHasMethodBodies
            :ast
            op: (ast.nodes.get i: mopId9.u64)
        ) then canW9 = true
    }
    if (canW9) == false then return
    st.typing.declSetWalked declId: dd9
    prevMono9: st.typing.curMonoStamp
    st.typing.curMonoStamp = 0
    # walkOwnerMethods only ever walked a TYPE's methods; a free function
    # reaching it was marked and declined, and its unit's own free-function walk
    # then skipped it as done -- a body emitted with nothing stamped.
    if isFn9 then {
        # a demand-time walk is its own scope, and checkFunctionBody SETS the
        # ambient receiver without restoring it: a free function walked from
        # inside a method's body would leave currentThisName cleared, and the
        # rest of that method then reads `b.private` as external code. The type
        # branch has bracketed these two since it was the only branch.
        prevL9: st.typing.synthLabel.copy
        prevT9: st.typing.currentThisName.copy
        qn9: "\{unitNameTextOf ty: st.typing :ast :unitDecl}.\{name}"
        (checkFunctionBody
            :st
            :unitDecl
            defName: qn9.stringview
            defn: (ast.nodes.get i: mopId9.u64)
            thisName: ""
            :ast
            declId: dd9
        )
        st.typing.synthLabel = prevL9
        st.typing.currentThisName = prevT9
    } else {
        walkOwnerMethods :st :unitDecl :ast :memId9 :name
    }
    st.typing.curMonoStamp = prevMono9
}

# walkOwnerMethods -- check one type member's method bodies (the shared
# core of the demand-time walk and the completion sweep).
walkOwnerMethods: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    memId9: u32
    name: StringView
} is {
    mem: ast.nodes.get i: memId9.u64
    match (
        mem
    ) case namedoperation then {
        # a demand walk of the owner's method bodies is its own scope: a
        # dotted-base suppression live at the TRIGGERING reference must
        # not leak into the walked bodies
        mwSup9: st.typing.suppressBareCtor
        st.typing.suppressBareCtor = false
        mwSupFn9: st.typing.suppressFnAutoCall
        st.typing.suppressFnAutoCall = false
        # outside-in: the owner type resolves BEFORE anything reads it. A body
        # walked ahead of its owner binds `this` to notype, and every check that
        # hangs off the receiver -- member reads, the declared return type --
        # silently stops asking.
        owTid9: (forceUnitDef
            ty: st.typing
            reg: st.reg
            :ast
            :unitDecl
            :memId9
        )
        (scanMemberSignatures
            :st
            :unitDecl
            :ast
            op: (ast.nodes.get i: mem.operation.u64)
        )
        canWalk: objectdefHasMethodBodies :ast op: (ast.nodes.get i: mem.operation.u64)
        # an owner that will not resolve is not walked at all: its own
        # resolution reports its own error, while a body walk on notype only
        # cascades that failure into every line of every method.
        if canWalk when owTid9 == 0 then canWalk = false
        if canWalk then {
            prev: st.typing.synthLabel.copy
            prevThis: st.typing.currentThisName.copy
            (checkMethodBodies
                :st
                :unitDecl
                :ast
                typeName: name
                op: (ast.nodes.get i: mem.operation.u64)
            )
            st.typing.synthLabel = prev
            st.typing.currentThisName = prevThis
        }
        st.typing.suppressFnAutoCall = mwSupFn9
        st.typing.suppressBareCtor = mwSup9
    } else null
}

# objectdefHasMethodBodies -- a unit member whose operation is an objectdef
# with at least one functiondef-with-body item.
objectdefHasMethodBodies: function {ast: Ast.view op: Node.view} out bool is {
    match (
        op
    ) case objectdef then {
        iiter: op.isItems.iterate
        for imId9: iiter loop {
            im: ast.nodes.get i: imId9.u64
            match (
                im
            ) case namedoperation then {
                if (isFunctionDefWithBody o: (ast.nodes.get i: im.operation.u64)) then return true
            } else null
        }
        aiter: op.asItems.iterate
        for amId9: aiter loop {
            am: ast.nodes.get i: amId9.u64
            match (
                am
            ) case namedoperation then {
                if (isFunctionDefWithBody o: (ast.nodes.get i: am.operation.u64)) then return true
            } else null
        }
        return false
    } else {
        return false
    }
}

# methodDeclOf -- the declaration of method `memberId` of type `typeName` in
# `unitDecl`, or 0.
methodDeclOf: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    typeName: StringView
    memberId: zast.nameid
} out ztypes.declid is {
    td9: (declOfUnitDefIds
        ty: st.typing
        :unitDecl
        nameId: (nameIdOf :ast name: typeName)
    )
    if td9.isZero then return (ztypes.declid.create from: 0)
    return (st.typing.declFindChild parentDeclId: td9 nameId: memberId)
}

# checkMethodBodies -- body-check every method of one type definition (is- and
# as-block functiondefs, declaration order). The scopes land under the walk's
# current scope, mirroring the oracle's resolve-at-first-demand placement.
checkMethodBodies: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast.view
    typeName: StringView
    op: Node.view
} is {
    match (
        op
    ) case objectdef then {
        iiter: op.isItems.iterate
        for imId9: iiter loop {
            im: ast.nodes.get i: imId9.u64
            match (
                im
            ) case namedoperation then {
                if (isFunctionDefWithBody o: (ast.nodes.get i: im.operation.u64)) then {
                    mname: zast.nameTextAt :ast ref: im.name
                    # about to check this body, so its signature is needed:
                    # `this` binds from the resolved receiver
                    (forceUnitDefMember
                        ty: st.typing
                        reg: st.reg
                        :ast
                        :unitDecl
                        defId: (nameIdOf :ast name: typeName)
                        memberId: im.name
                    )
                    qn: "\{typeName}.\{mname}"
                    (checkFunctionBody
                        :st
                        :unitDecl
                        defName: qn.stringview
                        defn: (ast.nodes.get i: im.operation.u64)
                        thisName: typeName
                        :ast
                        declId: (methodDeclOf :st :ast :unitDecl :typeName memberId: im.name)
                    )
                }
            } else null
        }
        aiter: op.asItems.iterate
        for amId9: aiter loop {
            am: ast.nodes.get i: amId9.u64
            match (
                am
            ) case namedoperation then {
                if (isFunctionDefWithBody o: (ast.nodes.get i: am.operation.u64)) then {
                    mname2: zast.nameTextAt :ast ref: am.name
                    (forceUnitDefMember
                        ty: st.typing
                        reg: st.reg
                        :ast
                        :unitDecl
                        defId: (nameIdOf :ast name: typeName)
                        memberId: am.name
                    )
                    qn2: "\{typeName}.\{mname2}"
                    (checkFunctionBody
                        :st
                        :unitDecl
                        defName: qn2.stringview
                        defn: (ast.nodes.get i: am.operation.u64)
                        thisName: typeName
                        :ast
                        declId: (methodDeclOf :st :ast :unitDecl :typeName memberId: am.name)
                    )
                }
            } else null
        }
    } else null
}

# lastStmtLineId / lastStmtLineIdAt -- the node id of a function body's last
# statement line (the implicit-return position), or 0 when absent.
lastStmtLineId: function {ast: Ast.view block: Node.view} out zast.nodeid is {
    match (
        block
    ) case statement then {
        ne: block.statements.length
        if ne > 0 then {
            lastId9: block.statements.get i: (ne - 1)
            last: ast.nodes.get i: lastId9.u64
            match (
                last
            ) case statementline then {
                return last.nodeid
            } else null
        }
    } else null
    return (zast.nodeid.create from: 0)
}

# the node id of the last statement line in operation `oId`.
lastStmtLineIdAt: function {ast: Ast.view oId: zast.nodeid} out zast.nodeid is {
    if oId.isZero then return (zast.nodeid.create from: 0)
    return (lastStmtLineId :ast block: (ast.nodes.get i: oId.u64))
}

# checkFunctionBody -- type-check one function body. Pushes a scope, binds each
# parameter as a runtime variable, walks the body, then pops (the pop snapshots
# the scope's entries + unreachable flag for the SQL dump).
checkFunctionBody: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    defName: StringView
    defn: Node.view
    thisName: StringView
    ast: Ast
    declId: ztypes.declid
} is {
    # the body resolves in the frame of its own declaration, whatever walk
    # reached it. A caller that has no declaration for the body (a mono
    # instance walk) leaves the cursor as it found it.
    prevFrame9: st.typing.curFrame
    if (declId.isZero) == false then st.typing.curFrame = declId
    checkFunctionBodyIn :st :unitDecl :defName :defn :thisName :ast :declId
    st.typing.curFrame = prevFrame9
}

checkFunctionBodyIn: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    defName: StringView
    defn: Node.view
    thisName: StringView
    ast: Ast
    declId: ztypes.declid
} is {
    match (
        defn
    ) case functiondef then {
        # the function's own declaration, when the caller passed one whose
        # type IS this function (a free function, a namespace member, a
        # method), is its identity: a namespace member is not found by the
        # unit's name, and without it the walk skipped its return-type
        # checks. A mono instance walk passes the TEMPLATE's Decl -- its
        # function is the mono's substituted child, found by label -- and
        # keeps the name path.
        fnDecl9: ztypes.declid
        fnTid9: ztypes.tid
        if st.typing.curMonoStamp == 0 then {
            dt9: declTypeIdOf ty: st.typing :declId
            if (dt9.isZero) == false then {
                if (st.reg.typetypeOf typeId: dt9) == ztypes.ztypetype.functionType then {
                    fnDecl9 = declId
                    fnTid9 = dt9
                }
            }
        }
        # a body is walked only once everything demanded so far has resolved:
        # an owner or function resolved late (from a walk) queued what its
        # bodies reference, and those must be resolved before those bodies are
        # walked, exactly as the early ones were.
        # a body is walked only once everything demanded so far has resolved:
        # an owner or function resolved late (from a walk) queued what its
        # bodies reference, and those must be resolved before those bodies are
        # walked, exactly as the early ones were.
        resolveDemandedDefs ty: st.typing reg: st.reg :ast
        # Claim this definition BEFORE the trigger runs. The trigger now walks
        # a free function's body, and the body it would walk here is the one
        # already being walked -- checkFunctionBody calls it with its OWN name.
        # Claiming first turns the self-call into the signature scan it was
        # always there for, and leaves the body walk to this frame.
        {
            sfId9: zast.poolFind pool: ast.names text: defName
            if (sfId9.isZero) == false then {
                sfd9: fnDecl9
                if sfd9.isZero then sfd9 = (declOfUnitDefIds
                    ty: st.typing
                    :unitDecl
                    nameId: sfId9
                )
                sfHad9: st.typing.declIsWalked declId: sfd9
                st.typing.declSetWalked declId: sfd9
                if (sfHad9) == false then {
                    (scanFnSig
                        :st
                        :unitDecl
                        :ast
                        op: (ast.nodes.get i: defn.nodeid.u64)
                    )
                }
            }
        }
        maybeWalkMethods :st :unitDecl :ast name: defName
        hasBody: defn.body > 0
        isGenDef: false
        # A dependency unit's definitions arrive with defName ALREADY carrying
        # their unit ("zast.errCode"), while a method arrives bare of its unit
        # but not of its type ("Ast.create"). Prefixing unconditionally built
        # "zast.zast.errCode", which resolves to nothing -- and this key drives
        # the generic-template gate, the template param binding, AND the
        # expected return type, so every one of them silently did nothing for
        # those bodies.
        # A dependency unit's definitions arrive with defName ALREADY
        # carrying their unit ("zast.errCode"); strip the duplicate prefix,
        # then resolve one or two remaining segments by ids.
        fnUid9: unitNameIdOf ty: st.typing :unitDecl
        # the unit's own spelling, read OFF its declaration: this compares
        # TEXT against a composed defName, which is not a re-resolution
        fnUnm9: unitNameTextOf ty: st.typing :ast :unitDecl
        rest9: defName
        {
            dfd9: defName.indexOf needle: "."
            match (
                dfd9
            ) case some then {
                if dfd9 == fnUnm9.length when (defName.substring
                    from: 0
                    to: dfd9
                ) == fnUnm9.stringview then {
                    rest9 = defName.substring from: (dfd9 + 1) to: defName.length
                }
            } case none then null
        }
        rgot: (optionval.none u64)
        if (fnTid9.isZero) == false then rgot = (optionval.some fnTid9.u64)
        if fnTid9.isZero then {
            rsd9: rest9.indexOf needle: "."
            match (
                rsd9
            ) case some then {
                uq5z9: unitDeclOfNameId ty: st.typing nameId: fnUid9
                (forceUnitDefMember
                    ty: st.typing
                    reg: st.reg
                    :ast
                    unitDecl: uq5z9
                    defId: (nameIdOf :ast name: (rest9.substring from: 0 to: rsd9))
                    memberId: (nameIdOf
                        :ast
                        name: (rest9.substring from: (rsd9 + 1) to: rest9.length)
                    )
                )
                uq6z9: unitDeclOfNameId ty: st.typing nameId: fnUid9
                rgot = (resolvedByIdsMember
                    :ast
                    ty: st.typing
                    unitDecl: uq6z9
                    defId: (nameIdOf :ast name: (rest9.substring from: 0 to: rsd9))
                    memberId: (nameIdOf
                        :ast
                        name: (rest9.substring from: (rsd9 + 1) to: rest9.length)
                    )
                )
            } case none then {
                uq7z9: unitDeclOfNameId ty: st.typing nameId: fnUid9
                rgot = (resolvedByIds
                    :ast
                    ty: st.typing

                    unitDecl: uq7z9
                    name: (nameIdOf :ast name: rest9)
                )
            }
        }
        match (
            rgot
        ) case some then {
            {
                isgeneric9v: st.reg.isGenericOf tid: (ztypes.tid.create from: rgot.u64)
                    if isgeneric9v then isGenDef = true
            }
        } case none then null
        if hasBody then {
            # A generic template body is checked ONCE, for diagnostics; the
            # emitter re-walks the shared AST per instance, so
            # GENERIC_PARAM-valued stamps are suppressed for the walk (and
            # its scopes/entries stay out of the dump log).
            prevSup9: st.typing.suppressParamStamps
            if isGenDef then st.typing.suppressParamStamps = true
            sname: "function:\{defName}"
            st.push name: sname.stringview
            piter: defn.parameters.iterate
            for pmId9: piter loop {
                pm: ast.nodes.get i: pmId9.u64
                match (
                    pm
                ) case namedoperation then {
                    pname: zast.nameTextAt :ast ref: pm.name
                    pnid: nodeId n: (ast.nodes.get i: pm.operation.u64)
                    ptid: (paramTypeId
                        :ast
                        typing: st.typing
                        reg: st.reg
                        :unitDecl
                        op: (ast.nodes.get i: pm.operation.u64)
                    )
                    if st.typing.curMonoFnTid > 0 then {
                        # per-mono instance walk: the mono FUNCTION child
                        # carries the substituted param type
                        mpo9: (st.typing.declChildOf
                            pool: ast.names
                            parentTypeId: st.typing.curMonoFnTid
                            name: pname.stringview
                        )
                        match (
                            mpo9
                        ) case some then {
                            ptid = mpo9
                        } case none then null
                    }
                    if ptid == 0 when isGenDef then {
                        # a template's own bare param carries no stamp; bind
                        # the canonical param tid from the FUNCTION child so
                        # the walk types it (stampGate suppresses the stamp)
                        fgo3: rgot
                        match (
                            fgo3
                        ) case some then {
                            fco3: (st.typing.declChildOf
                                pool: ast.names
                                parentTypeId: (ztypes.tid.create from: fgo3.u64)
                                name: pname.stringview
                            )
                            match (
                                fco3
                            ) case some then {
                                if (st.reg.typetypeOf typeId: (ztypes.tid.create from: fco3.u64)) == ztypes.ztypetype.genericParam then {
                                    ptid = fco3
                                }
                            } case none then null
                        } case none then null
                    }
                    if ptid > 0 then {
                        noSt: optBoolOr o: (st.typing.noStampNode.get key: pnid.u64) d: false
                        if (noSt) == false then {
                            ppre: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: pnid.u64
                            if ppre.isZero then {
                                setpp: ptid
                                stampGate :st nid: pnid.u64 tid: (ztypes.tid.create from: setpp.u64)
                            }
                        }
                    }
                    if thisName.length > 0 when (paramIsThisReceiver
                        :ast
                        op: (ast.nodes.get i: pm.operation.u64)
                    ) then {
                        thOpt: (walkLookupTyperef
                            :ast
                            ty: st.typing
                            reg: st.reg
                            :unitDecl
                            base: thisName
                        )
                        match (
                            thOpt
                        ) case some then {
                            ptid = thOpt
                        } case none then null
                    }
                    pown9: pathOwnership :ast n: (ast.nodes.get i: pm.operation.u64)
                    isLockP9: false
                    mkn9: "lock".string
                    match (
                        pown9
                    ) case some then {
                        # Only `.lock` needs an identity to point at, so only
                        # `.lock` is refused on a valtype below. `.view` and
                        # `.hold` are readonly markers, enforced by a lock on
                        # the parameter's own NAME, which a valtype has just as
                        # much as a class does.
                        if pown9 == ztypes.zparamownership.viewMode then mkn9 = "view".string
                        if pown9 == ztypes.zparamownership.holdMode then mkn9 = "hold".string
                    } case none then null
                    isGenP9: false
                    if (st.reg.typetypeOf typeId: (ztypes.tid.create from: ptid.u64)) == ztypes.ztypetype.genericParam then isGenP9 = true
                    # A receiver may be `borrow` (the default) or `view` only:
                    # an object cannot own itself. Family-independent -- the
                    # ownership axis says nothing about valtype or reftype.
                    ownRecv9: false
                    match (
                        pown9
                    ) case some then {
                        if pown9 == ztypes.zparamownership.takeMode then ownRecv9 = true
                        if pown9 == ztypes.zparamownership.holdMode then ownRecv9 = true
                    } case none then null
                    if ownRecv9 when (paramIsThisReceiver
                        :ast
                        op: (ast.nodes.get i: pm.operation.u64)
                    ) then {
                        orm9: "take".string
                        {
                            oro9: pown9
                            match (
                                oro9
                            ) case some then {
                                if oro9 == ztypes.zparamownership.holdMode then orm9 = "hold".string
                            } case none then null
                        }
                        orln9: nodeLine n: (ast.nodes.get i: pm.operation.u64)
                        orcl9: nodeCol n: (ast.nodes.get i: pm.operation.u64)
                        orm2: "Cannot use '.\{orm9}' on a receiver — an object cannot own itself; a receiver is 'borrow' (the default) or 'view'"
                        (addError
                            :st
                            nodeid: pnid
                            lineno: orln9
                            colno: orcl9
                            e: zast.err.ownerError
                            msg: orm2
                        )
                    }
                    if isLockP9 when (paramIsThisReceiver
                        :ast
                        op: (ast.nodes.get i: pm.operation.u64)
                    ) == false when (typeIsValtype
                        ty: st.typing
                        reg: st.reg
                        tid: (ztypes.tid.create from: ptid.u64)
                    ) when (isGenP9) == false then {
                        ptn9: typeNameOf :st tid: (ztypes.tid.create from: ptid.u64)
                        plln9: nodeLine n: (ast.nodes.get i: pm.operation.u64)
                        plcl9: nodeCol n: (ast.nodes.get i: pm.operation.u64)
                        ml9: "Cannot use '.\{mkn9}' on valtype parameter '\{pname}' (type '\{ptn9}') — locking requires identity (use a class)"
                        (addError
                            :st
                            nodeid: pnid
                            lineno: plln9
                            colno: plcl9
                            e: zast.err.ownerError
                            msg: ml9
                        )
                    }
                    own: ownershipOfParam o: (pathOwnership
                        :ast
                        n: (ast.nodes.get i: pm.operation.u64)
                    )
                    isRoP9: false
                    match (
                        pown9
                    ) case some then {
                        if pown9 == ztypes.zparamownership.viewMode then isRoP9 = true
                        if pown9 == ztypes.zparamownership.holdMode then isRoP9 = true
                    } case none then null
                    v: st.reg.newVariable ztypeId: (ztypes.tid.create from: ptid.u64) ownership: own
                    if (typeExprHasPrivate
                        :ast
                        n: (ast.nodes.get i: pm.operation.u64)
                    ) then v.isPrivateAccess = true
                    vid2: v.variableId
                    pnId9: zast.poolSet pool: ast.names text: pname.stringview
        st.defineVar nameId: pnId9 var: v
                    if isRoP9 then {
                        # A readonly parameter -- `view` (not owned) or `hold`
                        # (owned) -- is readonly for the whole body: it holds a
                        # readonly lock on itself, so writes, mutating receivers
                        # and re-passing to a mutable parameter are all caught
                        # by the ordinary lock rules. Ownership is a separate
                        # axis and is carried by `own` above.
                        #
                        # Both families. A valtype leaf normally skips locking
                        # -- the read is a copy, with no identity to protect --
                        # but a `view`/`hold` valtype is not a copy: the lock is
                        # what makes the marker mean anything, and it is taken
                        # here rather than left to the emitter's ABI choice.
                        vpp9: (List String)
                        vpn9: pname.copy
                        vpp9.append vpn9
                        vph9: (ztypes.zlockholder
                            kind: ztypes.zlockholderkind.varKind
                            id: vid2
                        )
                        vpr9: (st.tryLock
                            pool: ast.names
                            path: vpp9
                            lockType: ztypes.zlockstate.shared
                            lockScope: ztypes.zlockscope.target
                            holder: vph9
                        )
                        if vpr9.length > 0 then {
                            (addError
                                :st
                                nodeid: pnid
                                lineno: (nodeLine n: (ast.nodes.get i: pm.operation.u64))
                                colno: (nodeCol n: (ast.nodes.get i: pm.operation.u64))
                                e: zast.err.ownerError
                                msg: vpr9
                            )
                        }
                    }
                    st.typing.defVariableId.set key: pnid.u64 value: vid2
                    st.typing.variableOrigin.set key: vid2 value: true
                } else null
            }
            # Synth rows carry the unit member's dump label: a method's nodes
            # live inside its TYPE's subtree, so the label is the type name.
            # Nested method walks save and restore it around their bodies.
            lbl: "\{unitNameTextOf ty: st.typing :ast :unitDecl}.\{defName}"
            if thisName.length > 0 then lbl = "\{unitNameTextOf ty: st.typing :ast :unitDecl}.\{thisName}"
            st.typing.synthLabel = lbl
            tnl: thisName.string
            st.typing.currentThisName = tnl
            prevRet9: st.typing.currentReturnTypeId
            fitid9: (optU64Or o: rgot d: 0)
            crt9: ztypes.tid
            if fitid9 > 0 then crt9 = (optTidOr
                o: (methodReturnOf :st mid: (ztypes.tid.create from: fitid9.u64))
                d: ztypes.tid
            )
            st.typing.currentReturnTypeId = crt9
            prevRb9: st.typing.currentReturnsBorrow
            st.typing.currentReturnsBorrow = (optBoolOr
                o: (st.typing.funcReturnsBorrow.get key: fitid9)
                d: false
            )
            walkBodyAt :st :unitDecl :ast bodyId: defn.body
            st.typing.currentReturnTypeId = prevRet9
            st.typing.currentReturnsBorrow = prevRb9
            # Implicit-return coercion: a literal-typed last statement takes
            # the function's concrete return type, stamped on the statement
            # line (the node the reference coerces by id).
            ftid: ztypes.tid
            ftid = ztypes.tid.create from: (optU64Or o: rgot d: ftid)
            if ftid > 0 then {
                ro: methodReturnOf :st mid: ftid
                match (
                    ro
                ) case some then {
                    lsid: lastStmtLineIdAt :ast oId: defn.body
                    if lsid > 0 then {
                        cur: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: lsid.u64
                        if cur > 0 then {
                            if (isLiteralTypeId
                                :st
                                tid: (ztypes.tid.create from: cur.u64)
                            ) then stampGate :st nid: lsid.u64 tid: ro
                        }
                    }
                } case none then null
            }
            st.pop
            st.typing.suppressParamStamps = prevSup9
        }
    } else null
}

# checkUnitBodies -- walk every function definition with a body in one unit.
# walkUnitTemplateBodies9 -- body-walk a generic unit template's functions with
# the generic param UNBOUND (no st.define of the arg), so a `match t` subject
# resolves to 0 and checkCase stamps it as a genericParam (against the bare unit
# name) for the emitter to dissect. Mirrors checkUnitBodies' fn loop (index-based
# so it never holds the iterator lock while passing unitBody).
walkUnitTemplateBodies9: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    unitdefId: zast.nodeid
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: unitdefId
    # the template's own declaration, off its unitdef node's stamp: the frame
    # its members' bodies are walked in
    tdecl9: ztypes.declid
    {
        tun9: unitdefNodeId :ast nId: unitdefId
        if (tun9.isZero) == false then {
            tnt9: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: tun9.u64
            if tnt9 > 0 then tdecl9 = declOfTypeId reg: st.reg tid: (ztypes.tid.create from: tnt9)
        }
    }
    # a generic FILE unit is a root, named by `unitDecl`
    if tdecl9.isZero then {
        tro9: unitDecl
        if (tro9.isZero) == false then tdecl9 = tro9
    }
    # a template-time walk: the generic parameter resolves to its
    # GENERIC_PARAM id in the template's frame, and stamps of that type stay
    # out of the global table -- the emitter re-walks the shared AST per
    # instance and reads the instance's stamps (the rule every template walk
    # follows; the `match t` marker writes past it on purpose)
    prevSup9: st.typing.suppressParamStamps
    st.typing.suppressParamStamps = true
    bn9: bodyIds9.length
    bi9: u64
    for bi9 < bn9 loop {
        bmId9: bodyIds9.get i: bi9
        bi9 = bi9 + 1
        bm9: ast.nodes.get i: bmId9.u64
        if bm9.namedoperation then {
            if (isFunctionDefOp op: (ast.nodes.get i: bm9.operation.u64)) then {
                dn9: zast.nameTextAt :ast ref: bm9.name
                fdecl9: ztypes.declid
                if (tdecl9.isZero) == false then fdecl9 = (st.typing.declFindChild
                    parentDeclId: tdecl9
                    nameId: bm9.name
                )
                (checkFunctionBody
                    :st
                    :unitDecl
                    defName: dn9.stringview
                    defn: (ast.nodes.get i: bm9.operation.u64)
                    thisName: ""
                    :ast
                    declId: fdecl9
                )
            }
        }
    }
    st.typing.suppressParamStamps = prevSup9
}

# walkGenericUnitTemplates -- stamp `match t`/`match cap` in every generic unit
# template (file-level units and inline `unit as {}` bindings) via an unbound
# body walk. Runs after the main-unit body check. Unit op ids and
# names are lifted out of node views before program.ast is passed on (lock-safe).
walkGenericUnitTemplates: function {st: zenv.ZSymbolTable program: Node} is {
    match (
        program
    ) case program then {
        n9: program.ast.units.length
        ui9: u64
        for ui9 < n9 loop {
            uId9: (zast.nodeid.create from: (program.ast.units.get i: ui9))
            ui9 = ui9 + 1
            uop9: zast.nodeid
            un9: String
            {
                u9: program.ast.nodes.get i: uId9.u64
                if u9.namedoperation then {
                    uop9 = u9.operation
                    un9 = zast.poolTextCopy pool: program.ast.names ref: u9.name
                }
            }
            if uop9 > 0 then {
                if (unitDefIsGeneric ast: program.ast oId: uop9) then {
                    (walkUnitTemplateBodies9
                        :st
                        ast: program.ast
                        unitDecl: (unitDeclOfName
                            ty: st.typing
                            ast: program.ast
                            name: un9.stringview
                        )
                        unitdefId: uop9
                    )
                }
                ibody9: zast.unitBodyIdsAt ast: program.ast unitId: uop9
                ibn9: ibody9.length
                ibi9: u64
                for ibi9 < ibn9 loop {
                    ibmId9: ibody9.get i: ibi9
                    ibi9 = ibi9 + 1
                    bop9: zast.nodeid
                    bnm9: String
                    isU9: false
                    {
                        bm9: program.ast.nodes.get i: ibmId9.u64
                        if bm9.namedoperation then {
                            if (isUnitOp op: (program.ast.nodes.get i: bm9.operation.u64)) then {
                                isU9 = true
                                bop9 = bm9.operation
                                bnm9 = zast.poolTextCopy pool: program.ast.names ref: bm9.name
                            }
                        }
                    }
                    if isU9 when (unitDefIsGeneric ast: program.ast oId: bop9) then {
                        # an INLINE template's members resolve in the FILE unit
                        # it is written in -- its own name is no file unit, and
                        # naming it only ever meant "whatever frame the cursor
                        # is in", which is this unit
                        (walkUnitTemplateBodies9
                            :st
                            ast: program.ast
                            unitDecl: (unitDeclOfName
                                ty: st.typing
                                ast: program.ast
                                name: un9.stringview
                            )
                            unitdefId: bop9
                        )
                    }
                }
            }
        }
    } else null
}

# typecheck every definition body in a unit.
# checkNamespaceBodies -- walk the function bodies of a namespace unit. Its
# members resolve against ITS body list, not the file unit's, so a name written
# inside a namespace finds the namespace's definition first. Without this a
# namespace's signatures reach the emitter with unstamped nodes, which surfaces
# as a loud E0500 rather than a diagnostic.
checkNamespaceBodies: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    unitdefId: zast.nodeid
} is {
    # Once per unit op: the main tree walk and the demand drain can both reach
    # the same namespace, and a second walk would re-report every diagnostic.
    if (st.typing.nsBodiesWalked.has item: unitdefId.u64) then return
    st.typing.nsBodiesWalked.add item: unitdefId.u64
    prevFrame9: st.typing.curFrame
    nsDecl9: ztypes.declid
    {
        un9: unitdefNodeId :ast nId: unitdefId
        if (un9.isZero) == false then {
            nt9: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: un9.u64
            if nt9 > 0 then {
                nsDecl9 = declOfTypeId reg: st.reg tid: (ztypes.tid.create from: nt9)
                st.typing.curFrame = nsDecl9
            }
        }
    }
    bodyIds9: zast.unitBodyIdsAt :ast unitId: unitdefId
    bn9: bodyIds9.length
    bi9: u64
    for bi9 < bn9 loop {
        bmId9: bodyIds9.get i: bi9
        bi9 = bi9 + 1
        bm: ast.nodes.get i: bmId9.u64
        if bm.namedoperation then {
            if (zast.unitOpDeclaresUnit :ast opId: bm.operation) then {
                (checkNamespaceBodies
                    :ast
                    :st
                    :unitDecl
                    unitdefId: bm.operation
                )
            } else {
                defName9: zast.nameTextAt :ast ref: bm.name
                (checkFunctionBody
                    :st
                    :unitDecl
                    defName: defName9.stringview
                    defn: (ast.nodes.get i: bm.operation.u64)
                    thisName: ""
                    :ast
                    declId: (st.typing.declFindChild
                        parentDeclId: nsDecl9
                        nameId: bm.name
                    )
                )
            }
        }
    }
    st.typing.curFrame = prevFrame9
}

checkUnitBodies: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    unitdefId: zast.nodeid
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: unitdefId
    {
        mn9: bodyIds9.length
        mi9: u64
        foundMain9: false
        for mi9 < mn9 loop {
            mmId9: bodyIds9.get i: mi9
            mi9 = mi9 + 1
            mm: ast.nodes.get i: mmId9.u64
            if mm.namedoperation then {
                memberName9: zast.nameTextAt :ast ref: mm.name
                if memberName9.stringview == "main" when (isFunctionDefOp
                    op: (ast.nodes.get i: mm.operation.u64)
                ) then {
                    foundMain9 = true
                    (checkFunctionBody
                        :st
                        :unitDecl
                        defName: memberName9.stringview
                        defn: (ast.nodes.get i: mm.operation.u64)
                        thisName: ""
                        :ast
                        declId: (declOfUnitDefIds
                            ty: st.typing
                            :unitDecl
                            nameId: mm.name
                        )
                    )
                }
            }
        }
        # E0039 -- there is no root to demand from. Compilation is demand-driven
        # and `main` is the root, so a target unit without one has no entry point
        # and nothing to reach from: it is a LIBRARY, and the program that opens
        # it is what should be compiled. `--eager` is exempt on the same
        # reasoning rather than as a convenience -- it resolves every definition
        # instead of what a root reaches, so it needs no root. That exemption is
        # what keeps `zl lint --full`, zls and eager-guard (all eager: true)
        # working on a library unit.
        if (foundMain9) == false when (st.typing.eagerAll) == false when st.typing.requireMain then {
            (noMainError
                ty: st.typing
                :ast
                :unitDecl
                :unitdefId
            )
        }
        bn9: bodyIds9.length
        bi9: u64
        for bi9 < bn9 loop {
            bmId9: bodyIds9.get i: bi9
            bi9 = bi9 + 1
            bm: ast.nodes.get i: bmId9.u64
            if bm.namedoperation then {
                defName: zast.nameTextAt :ast ref: bm.name
                # the target unit's own definitions are walked because something
                # DEMANDED them, exactly as a dependency's are. Walking every one
                # regardless is what made the root the one unit in the program
                # that was not demand-driven.
                if (st.typing.eagerAll) == false then {
                    if (defWasResolved
                        ty: st.typing
                        :unitDecl
                        nameId: bm.name
                    ) == false then continue
                }
                # and not again if a demand point already walked it. depWalkUnit
                # has always asked this; the target unit never had to, because
                # nothing else walked its bodies.
                if (st.typing.declIsWalked declId: (declOfUnitDefIds
                    ty: st.typing
                    :unitDecl
                    nameId: bm.name
                )) then continue
                if (zast.unitOpDeclaresUnit :ast opId: bm.operation) then {
                    (checkNamespaceBodies
                        :ast
                        :st
                        :unitDecl
                        unitdefId: bm.operation
                    )
                } else if defName.stringview != "main" then {
                    (checkFunctionBody
                        :st
                        :unitDecl
                        defName: defName.stringview
                        defn: (ast.nodes.get i: bm.operation.u64)
                        thisName: ""
                        :ast
                        declId: (declOfUnitDefIds
                            ty: st.typing
                            :unitDecl
                            nameId: bm.name
                        )
                    )
                }
            }
        }
    }
}

# checkBodies -- the body-walk pass, mirroring check()'s top-level
# loop: walk the main unit's function bodies, main first, then the others in
# body order. Runs after demand resolution so referenced types are already
# resolved.
checkBodies: function {st: zenv.ZSymbolTable program: Node} is {
    match (
        program
    ) case program then {
        unitDecl: (unitDeclOfName
            ty: st.typing
            ast: program.ast
            name: program.mainUnitName.stringview
        )
        mainIdx: u64
        found0: false
        i0: u64
        uCnt9d: program.ast.units.length
        uIdx9d: u64
        for uIdx9d < uCnt9d loop {
            uId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9d))
            uIdx9d = uIdx9d + 1
            u: program.ast.nodes.get i: uId9.u64
            match (
                u
            ) case namedoperation then {
                uc5z9: unitDeclOfNameIdHere ty: st.typing nameId: u.name
                if uc5z9 == unitDecl then {
                    if (found0) == false then {
                        mainIdx = i0
                        found0 = true
                    }
                }
            } else null
            i0 = i0 + 1
        }
        if found0 then {
            muId9: (zast.nodeid.create from: (program.ast.units.get i: mainIdx))
            mOpId9: zast.nodeid
            {
                mu: program.ast.nodes.get i: muId9.u64
                if mu.namedoperation then mOpId9 = mu.operation
            }
            if mOpId9 > 0 then {
                (checkUnitBodies
                    :st
                    :unitDecl
                    unitdefId: mOpId9
                    ast: program.ast
                )
            }
        }
        # a body walk can demand definitions the signatures never reached
        # (a type constructed only inside a late-resolved owner's method):
        # resolve them before the completion pass walks their owners
        resolveDemandedDefs ty: st.typing reg: st.reg ast: program.ast
        walkOwedNamespaceBodies :st ast: program.ast
        walkLateResolvedOwners :st ast: program.ast
        stampUnitMonoTemplates :st :program
    } else null
}

# walkLateResolvedOwners -- complete the demand walk. A type can resolve AFTER
# its unit's walk has already run -- zvfs.ZVfs and DentryTable do it in astdemo,
# and a typedef constant does it in its own unit -- and nothing re-walks that
# unit, so its methods would be emitted with nothing stamped (E0500, "unhandled
# binding type"). The walk is what stamps a body, so the completion pass is not
# optional; it is the price of walking a unit once rather than to a fixpoint.
#
# What it no longer does is check a type NOTHING reached. That was its other
# half, and it is retired: with the root demand-driven, a definition the program
# cannot reach is not the compiler's to spend time on, and reporting on it is a
# LINT concern. So the keep test is `resolved` alone -- the blanket keep for
# walkOwedNamespaceBodies -- walk the member bodies of every namespace or
# hidden subunit the demand path resolved. The main unit's own namespaces are
# walked by checkUnitBodies; a DEPENDENCY's are reached only here, and without
# this their bodies arrive at the emitter unstamped -- a loud E0500 where a
# diagnostic belongs.
#
# Drained in rounds because a body can demand a deeper subunit: each round
# resolves what the last one demanded, so a subunit of a subunit is walked by
# the round after its parent, to any depth. Deterministic: demand order.
walkOwedNamespaceBodies: function {st: zenv.ZSymbolTable ast: Ast} is {
    for st.typing.nsBodiesOwed.length > 0 loop {
        round9: (ListVal ztyping.nsbody)
        for st.typing.nsBodiesOwed.length > 0 loop round9.append st.typing.nsBodiesOwed.pop
        ri9: u64
        rn9: round9.length
        for ri9 < rn9 loop {
            rec9: round9.get i: ri9
            ri9 = ri9 + 1
            (checkNamespaceBodies
                :ast
                :st
                unitDecl: (unitDeclOfNameIdHere ty: st.typing nameId: rec9.unitName)
                unitdefId: rec9.unitOp
            )
        }
        # a walked body demands definitions of its own; resolving them here is
        # what puts the next depth on the list
        resolveDemandedDefs ty: st.typing reg: st.reg :ast
    }
}

# the target unit's own owners is gone, which is the whole of the dead-code job.
#
# Template owners are skipped: their bodies check per instantiation.
# Deterministic: unit load order, declaration order.
walkLateResolvedOwners: function {st: zenv.ZSymbolTable ast: Ast.view} is {
    swN9: ast.units.length
    swI9: u64
    for swI9 < swN9 loop {
        swuId9: (zast.nodeid.create from: (ast.units.get i: swI9))
        swI9 = swI9 + 1
        swu9: ast.nodes.get i: swuId9.u64
        match (
            swu9
        ) case namedoperation then {
            swun9: zast.nameTextAt :ast ref: swu9.name
            swBody9: zast.unitBodyIdsAt :ast unitId: swu9.operation
            swbi9: u64
            swbn9: swBody9.length
            for swbi9 < swbn9 loop {
                swmId9: swBody9.get i: swbi9
                swbi9 = swbi9 + 1
                swm9: ast.nodes.get i: swmId9.u64
                match (
                    swm9
                ) case namedoperation then {
                    swmn9: zast.nameTextAt :ast ref: swm9.name
                    uq8z9: (unitDeclOfNameId
                        ty: st.typing
                        nameId: (nameIdOf :ast name: swun9.stringview)
                    )
                    swd9: (declOfUnitDefIds
                        ty: st.typing
                        unitDecl: uq8z9
                        nameId: swm9.name
                    )
                    swWalked9: st.typing.declIsWalked declId: swd9
                    if swWalked9 == false then {
                        swop9: ast.nodes.get i: swm9.operation.u64
                        swDo9: false
                        match (
                            swop9
                        ) case objectdef then {
                            if (hasGenericParam :ast items: swop9.asItems) == false then {
                                swDo9 = true
                            }
                        } else null
                        # Whose dead code it is decides whether this compile
                        # cares. An owner in the program's OWN unit is worth
                        # reporting on: the author wrote it and can fix it. A
                        # DEPENDENCY's unreached type is not -- a build must not
                        # spend time probing definitions the program cannot
                        # reach, in code it does not own, and its body names
                        # siblings nothing demanded, so checking it reports
                        # valid references as unknown. `--eager` -- and so
                        # eager-guard, zls and `zl lint --full` -- checks
                        # everything regardless, which is the point of it.
                        # Asked HERE, not per member: resolvedByIds RESOLVES as
                        # it walks, so probing every member of every unit
                        # settles types this compile never needed.
                        if swDo9 when (objectdefHasMethodBodies
                            :ast
                            op: swop9
                        ) then {
                            swKeep9: st.typing.eagerAll
                            if (swKeep9) == false then {
                                uq9z9: (unitDeclOfNameId
                                    ty: st.typing
                                    nameId: (nameIdOf :ast name: swun9.stringview)
                                )
                                swRo9: (resolvedByIds
                                    :ast
                                    ty: st.typing

                                    unitDecl: uq9z9
                                    name: swm9.name
                                )
                                match (
                                    swRo9
                                ) case some then {
                                    swKeep9 = true
                                } case none then null
                            }
                            if (swKeep9) == false then swDo9 = false
                        }
                        if swDo9 when (objectdefHasMethodBodies :ast op: swop9) then {
                            # the walked mark is what emission reads, so it is
                            # earned by a walk that can happen: resolve first,
                            # and a miss marks nothing.
                            ud5x9: unitDeclOfNameIdHere ty: st.typing nameId: swu9.name
                            swTid9: (forceUnitDef
                                ty: st.typing
                                reg: st.reg
                                :ast
                                unitDecl: ud5x9
                                memId9: swmId9
                            )
                            if swTid9 == 0 then swDo9 = false
                        }
                        if swDo9 when (objectdefHasMethodBodies :ast op: swop9) then {
                            st.typing.declSetWalked declId: swd9
                            (walkOwnerMethods
                                :st
                                unitDecl: (unitDeclOfNameIdHere ty: st.typing nameId: swu9.name)
                                :ast
                                memId9: swmId9
                                name: swmn9.stringview
                            )
                        }
                    }
                } else null
            }
        } else null
    }
}

# bindMonoParams -- scope-define one mono's type args under the template's
# param names, and fill monoParamSubst (param tid -> arg tid) for flat
# substitution at stamp time; the template's Decl is the one key.
bindMonoParams: function {
    st: zenv.ZSymbolTable
    pool: zast.StringPool.view
    monoId: ztypes.tid
} is {
    morig9: ztypes.tid
    {
        mgo9: st.reg.genericOriginOf tid: monoId
        if mgo9 > 0 then morig9 = mgo9
    }
    tdecl: declOfTypeId reg: st.reg tid: (ztypes.tid.create from: morig9.u64)
    pn9: st.reg.genericParamNamesOf :tdecl
    pc9: pn9.length
    pj9: u64
    for pj9 < pc9 loop {
        if (st.reg.genericArgIsValueAt specId: monoId ordinal: pj9) == false then {
            av9: st.reg.genericArgAt specId: monoId ordinal: pj9
            if av9 > 0 then {
                pnm9: (pn9.get i: pj9)
                (st.define
                    nameId: (zast.poolSet :pool text: pnm9.stringview)
                    ztypeId: (ztypes.tid.create from: av9.u64)
                )
                pto9: st.reg.genericParamTidOf :tdecl paramName: pnm9.stringview
                match (
                    pto9
                ) case some then {
                    sv9: av9
                    (st.typing.monoParamSubst.set
                        key: (ztypes.tid.create from: pto9.u64)
                        value: (ztypes.tid.create from: sv9.u64)
                    )
                } case none then null
            }
        }
        pj9 = pj9 + 1
    }
}

# stampMonoTemplateFn -- stamp-walk every registry mono of one generic free
# function template against the TEMPLATE body (mirrors emitFnMonoInstances'
# enumeration: FUNCTION types whose generic origin is the template).
stampMonoTemplateFn: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    fnOpId: u32
    templateFnId: u64
} is {
    last9: st.reg.nextTypeId
    t9: 1.u64
    for t9 < last9 loop {
        isMono9: false
        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: t9.u64)) == ztypes.ztypetype.functionType then {
            {
                go9: st.reg.genericOriginOf tid: (ztypes.tid.create from: t9.u64)
                if go9.u64 == templateFnId when go9 > 0 then isMono9 = true
            }
        }
        if isMono9 then {
            (stampOneFnMono
                :st
                :ast
                :unitDecl
                :fnOpId
                monoId: (ztypes.tid.create from: t9.u64)
            )
        }
        t9 = t9 + 1
    }
}

# stampOneFnMono -- the instance walk for one free-function mono: args bound,
# params bound through the mono FUNCTION's substituted children, stamps into
# the side table under the mono FUNCTION tid (the emitter's curThisTid for
# fn-mono re-walks).
stampOneFnMono: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    fnOpId: u32
    monoId: ztypes.tid
} is {
    monoNm9: regTypeNameOf reg: st.reg tid: monoId
    prevSup9: st.typing.suppressParamStamps
    st.typing.suppressParamStamps = true
    sn9: "fngeneric:\{monoNm9}"
    st.push name: sn9.stringview
    st.typing.monoParamSubst = (MapVV ztypes.tid value: ztypes.tid)
    {
        bindMonoParams :st pool: ast.names :monoId
    }
    st.typing.curMonoStamp = monoId
    st.typing.curMonoFnTid = monoId
    prevL9: st.typing.synthLabel.copy
    prevT9: st.typing.currentThisName.copy
    tplDecl29Org: st.reg.genericOriginOf tid: monoId
    tplDecl29: declOfTypeId reg: st.reg tid: tplDecl29Org
    (checkFunctionBody
        :st
        :unitDecl
        defName: monoNm9.stringview
        defn: (ast.nodes.get i: fnOpId.u64)
        thisName: ""
        :ast
        declId: tplDecl29
    )
    st.typing.synthLabel = prevL9
    st.typing.currentThisName = prevT9
    st.typing.curMonoFnTid = ztypes.tid.create from: 0
    st.typing.curMonoStamp = 0
    st.typing.suppressParamStamps = prevSup9
    st.typing.monoParamSubst = (MapVV ztypes.tid value: ztypes.tid)
    st.pop
}

# stampMonoTemplateClass -- resolve one generic class/record template and
# stamp-walk every registry mono minted from it (mirrors emitRecordMethods'
# generic leg + emitClassMonoMethods' enumeration).
stampMonoTemplateClass: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    clsName: StringView
    clsOpId: u32
} is {
    isCand9: false
    {
        cop9: ast.nodes.get i: clsOpId.u64
        if cop9.objectdef then isCand9 = true
    }
    if (isCand9) == false then return
    if (objectdefIsGeneric :ast o: (ast.nodes.get i: clsOpId.u64)) == false then return
    if (objectdefHasMethodBodies :ast op: (ast.nodes.get i: clsOpId.u64)) == false then return
    tplTid9: u64
    {
        tro9: (resolvedByIds
            :ast
            ty: st.typing

            :unitDecl
            name: (zast.poolFind pool: ast.names text: clsName)
        )
        match (
            tro9
        ) case some then {
            tplTid9 = tro9
        } case none then null
    }
    if tplTid9 == 0 then return
    last9: st.reg.nextTypeId
    t9: 1.u64
    for t9 < last9 loop {
        isMono9: false
        {
            go9: st.reg.genericOriginOf tid: (ztypes.tid.create from: t9.u64)
            if go9.u64 == tplTid9 when go9 > 0 then isMono9 = true
        }
        if isMono9 then {
            (stampOneClassMono
                :st
                :ast
                :unitDecl
                :clsOpId
                monoId: (ztypes.tid.create from: t9.u64)
            )
        }
        t9 = t9 + 1
    }
}

# stampOneClassMono -- the instance walk for one class/record mono: type args
# bound, each template method body re-checked with `this` typed as the mono
# and params bound through the mono's substituted method children.
stampOneClassMono: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    clsOpId: u32
    monoId: ztypes.tid
} is {
    monoNm9: regTypeNameOf reg: st.reg tid: monoId
    prevSup9: st.typing.suppressParamStamps
    st.typing.suppressParamStamps = true
    sn9: "classgeneric:\{monoNm9}"
    st.push name: sn9.stringview
    st.typing.monoParamSubst = (MapVV ztypes.tid value: ztypes.tid)
    {
        bindMonoParams :st pool: ast.names :monoId
    }
    mNames9: (List String)
    mOps9: (ListVal u32)
    {
        cop9: ast.nodes.get i: clsOpId.u64
        match (
            cop9
        ) case objectdef then {
            iit9: cop9.isItems.iterate
            for imId9: iit9 loop {
                im9: ast.nodes.get i: imId9.u64
                match (
                    im9
                ) case namedoperation then {
                    if (isFunctionDefWithBody o: (ast.nodes.get i: im9.operation.u64)) then {
                        mNames9.append (zast.nameTextCopy :ast ref: im9.name)
                        mOps9.append im9.operation
                    }
                } else null
            }
            ait9: cop9.asItems.iterate
            for amId9: ait9 loop {
                am9: ast.nodes.get i: amId9.u64
                match (
                    am9
                ) case namedoperation then {
                    if (isFunctionDefWithBody o: (ast.nodes.get i: am9.operation.u64)) then {
                        mNames9.append (zast.nameTextCopy :ast ref: am9.name)
                        mOps9.append am9.operation
                    }
                } else null
            }
        } else null
    }
    st.typing.curMonoStamp = monoId
    prevL9: st.typing.synthLabel.copy
    prevT9: st.typing.currentThisName.copy
    mi9: u64
    for mi9 < mNames9.length loop {
        mnm9: (mNames9.get i: mi9)
        mop9: mOps9.get i: mi9
        mi9 = mi9 + 1
        mfo9: st.typing.declChildOf pool: ast.names parentTypeId: monoId name: mnm9.stringview
        match (
            mfo9
        ) case some then {
            st.typing.curMonoFnTid = ztypes.tid.create from: mfo9.u64
        } case none then {
            st.typing.curMonoFnTid = ztypes.tid.create from: 0
        }
        q9: "\{monoNm9}.\{mnm9}"
        tplDecl39Org: st.reg.genericOriginOf tid: monoId
        tplDecl39: declOfTypeId reg: st.reg tid: tplDecl39Org
        (checkFunctionBody
            :st
            :unitDecl
            defName: q9.stringview
            defn: (ast.nodes.get i: mop9.u64)
            thisName: monoNm9.stringview
            :ast
            declId: tplDecl39
        )
    }
    st.typing.synthLabel = prevL9
    st.typing.currentThisName = prevT9
    st.typing.curMonoFnTid = ztypes.tid.create from: 0
    st.typing.curMonoStamp = 0
    st.typing.suppressParamStamps = prevSup9
    st.typing.monoParamSubst = (MapVV ztypes.tid value: ztypes.tid)
    st.pop
}

# stampUnitMonoTemplates -- post-sweep: re-walk each generic-unit template's
# method bodies once per monomorphised instance, instance type args bound in
# scope, every stamp routed into the mono side table (stampGate's
# curMonoStamp mode, flat param->arg substitution via monoParamSubst). The
# emitter's per-instance template re-walk reads the table (monoStampIdOf)
# where the global table is param-suppressed. Runs under suppressParamStamps
# so its scopes/entries stay out of the dump log; skipped when diagnostics
# exist (nothing will be emitted).
# stampUnitMonoMembers -- the generic templates a unit's body declares, at any
# depth. A unit is a scope, and a scope nests: a template declared inside a
# plain unit inside another one is still a template, so a non-generic member
# unit is descended into rather than skipped. Reached only through
# stampUnitMonoTemplates, which supplies the file unit that both the templates
# and their instance bodies resolve against.
stampUnitMonoMembers: function {
    st: zenv.ZSymbolTable
    program: zast.ProgramData
    unitDecl: ztypes.declid
    unitOpId: zast.nodeid
} is {
    ibody9: zast.unitBodyIdsAt ast: program.ast unitId: unitOpId
    ibn9: ibody9.length
    ibi9: u64
    for ibi9 < ibn9 loop {
        imId9: ibody9.get i: ibi9
        ibi9 = ibi9 + 1
        imOp9: zast.nodeid
        imNm9: String
        fnOp9: u32
        fnNm9: String
        clsOp9: u32
        clsNm9: String
        {
            im9: program.ast.nodes.get i: imId9.u64
            if im9.namedoperation then {
                if (isUnitOp op: (program.ast.nodes.get i: im9.operation.u64)) then {
                    imOp9 = im9.operation
                    imNm9 = (zast.poolTextCopy
                        pool: program.ast.names
                        ref: im9.name
                    )
                } else {
                    if (isFunctionDefWithBody o: (program.ast.nodes.get i: im9.operation.u64)) then {
                        fnOp9 = im9.operation
                        fnNm9 = (zast.poolTextCopy
                            pool: program.ast.names
                            ref: im9.name
                        )
                    } else {
                        opn2: program.ast.nodes.get i: im9.operation.u64
                        if opn2.objectdef then {
                            clsOp9 = im9.operation
                            clsNm9 = (zast.poolTextCopy
                                pool: program.ast.names
                                ref: im9.name
                            )
                        }
                    }
                }
            }
        }
        if imOp9 > 0 then {
            if (unitDefIsGeneric ast: program.ast oId: imOp9) then {
                (stampMonoTemplateUnit
                    :st
                    ast: program.ast
                    :unitDecl
                    templateName: imNm9.stringview
                    unitOpId: imOp9
                )
            } else {
                stampUnitMonoMembers :st :program :unitDecl unitOpId: imOp9
            }
        }
        if fnOp9 > 0 then {
            fnTid9: u64
            {
                fuUid9: unitNameIdOf ty: st.typing :unitDecl
                fnNmId9: nameIdOf ast: program.ast name: fnNm9.stringview
                uq10z9: unitDeclOfNameId ty: st.typing nameId: fuUid9
                fro9: (resolvedByIds
                    ast: program.ast
                    ty: st.typing

                    unitDecl: uq10z9
                    name: fnNmId9
                )
                match (
                    fro9
                ) case some then {
                    fnTid9 = fro9
                } case none then null
            }
            isGenFn9: false
            if fnTid9 > 0 then {
                if (st.reg.typetypeOf typeId: (ztypes.tid.create from: fnTid9.u64)) == ztypes.ztypetype.functionType then {
                    {
                        isgeneric9v: st.reg.isGenericOf tid: (ztypes.tid.create from: fnTid9.u64)
                            if isgeneric9v then isGenFn9 = true
                    }
                }
            }
            if isGenFn9 then {
                (stampMonoTemplateFn
                    :st
                    ast: program.ast
                    :unitDecl
                    fnOpId: fnOp9
                    templateFnId: fnTid9
                )
            }
        }
        if clsOp9 > 0 then {
            (stampMonoTemplateClass
                :st
                ast: program.ast
                :unitDecl
                clsName: clsNm9.stringview
                clsOpId: clsOp9
            )
        }
    }
}

stampUnitMonoTemplates: function {st: zenv.ZSymbolTable program: zast.ProgramData} is {
    if st.typing.errors.length > 0 then return
    {
        uCnt9: program.ast.units.length
        uIdx9: u64
        for uIdx9 < uCnt9 loop {
            uId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9))
            uIdx9 = uIdx9 + 1
            uOp9: zast.nodeid
            uNm9: String
            {
                u9: program.ast.nodes.get i: uId9.u64
                if u9.namedoperation then {
                    uNm9 = zast.poolTextCopy pool: program.ast.names ref: u9.name
                    uOp9 = u9.operation
                }
            }
            if uOp9 > 0 then {
                if (unitDefIsGeneric ast: program.ast oId: uOp9) then {
                    (stampMonoTemplateUnit
                        :st
                        ast: program.ast
                        unitDecl: (unitDeclOfName
                            ty: st.typing
                            ast: program.ast
                            name: uNm9.stringview
                        )
                        templateName: uNm9.stringview
                        unitOpId: uOp9
                    )
                } else {
                    (stampUnitMonoMembers
                        :st
                        :program
                        unitDecl: (unitDeclOfName
                            ty: st.typing
                            ast: program.ast
                            name: uNm9.stringview
                        )
                        unitOpId: uOp9
                    )
                }
            }
        }
    }
}

# stampMonoTemplateUnit -- resolve one generic template unit (file-level by
# unit name, inline by its def-node stamp), then stamp-walk every registry
# mono minted from it.
stampMonoTemplateUnit: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    templateName: StringView
    unitOpId: zast.nodeid
} is {
    tplId9: u64
    {
        tk9: templateName
        tgo9: (declTypeIdOf
            ty: st.typing
            declId: (st.typing.declFindChild
                parentDeclId: st.typing.programRoot
                nameId: (nameIdOf :ast name: tk9)
            )
        )
        if (tgo9.isZero) == false then tplId9 = tgo9
    }
    if tplId9 == 0 then {
        rid9: u32
        {
            tuo9: ast.nodes.get i: unitOpId.u64
            if tuo9.unitdef then rid9 = tuo9.nodeid
        }
        if rid9 > 0 then {
            sgo9: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: rid9.u64
            if sgo9 > 0 then tplId9 = sgo9
        }
    }
    if tplId9 == 0 then return
    last9: st.reg.nextTypeId
    t9: 1.u64
    for t9 < last9 loop {
        isMono9: false
        if (st.reg.typetypeOf typeId: (ztypes.tid.create from: t9.u64)) == ztypes.ztypetype.unitType then {
            {
                go9: st.reg.genericOriginOf tid: (ztypes.tid.create from: t9.u64)
                if go9.u64 == tplId9 when go9 > 0 then isMono9 = true
            }
        }
        if isMono9 then {
            (stampOneUnitMono
                :st
                :ast
                :unitDecl
                :unitOpId
                monoId: (ztypes.tid.create from: t9.u64)
            )
        }
        t9 = t9 + 1
    }
}

# stampOneUnitMono -- the instance walk: bind the mono's type args (scope
# defines + monoParamSubst), then re-check each template method body with
# curMonoStamp routing stamps into the side table.
stampOneUnitMono: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    unitOpId: zast.nodeid
    monoId: ztypes.tid
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: unitOpId
    monoNm9: regTypeNameOf reg: st.reg tid: monoId
    prevSup9: st.typing.suppressParamStamps
    st.typing.suppressParamStamps = true
    sn9: "unitgeneric:\{monoNm9}"
    st.push name: sn9.stringview
    st.typing.monoParamSubst = (MapVV ztypes.tid value: ztypes.tid)
    {
        bindMonoParams :st pool: ast.names :monoId
    }
    idxs9: (ListVal u64)
    {
        di9: u64
        with biter9: bodyIds9.iterate do for bmId9: biter9 loop {
            bm9: ast.nodes.get i: bmId9.u64
            match (
                bm9
            ) case namedoperation then {
                if (isFunctionDefWithBody o: (ast.nodes.get i: bm9.operation.u64)) then {
                    dv9: di9
                    idxs9.append dv9
                }
            } else null
            di9 = di9 + 1
        }
    }
    st.typing.curMonoStamp = monoId
    prevL9: st.typing.synthLabel.copy
    prevT9: st.typing.currentThisName.copy
    wi9: u64
    for wi9 < idxs9.length loop {
        bidx9: idxs9.get i: wi9
        wi9 = wi9 + 1
        bmId2: bodyIds9.get i: bidx9
        bm2: ast.nodes.get i: bmId2.u64
        match (
            bm2
        ) case namedoperation then {
            mnm9: zast.nameTextAt :ast ref: bm2.name
            q9: "\{monoNm9}.\{mnm9}"
            mfo9: (st.typing.declChildOf
                pool: ast.names
                parentTypeId: monoId
                name: mnm9.stringview
            )
            match (
                mfo9
            ) case some then {
                st.typing.curMonoFnTid = ztypes.tid.create from: mfo9.u64
            } case none then {
                st.typing.curMonoFnTid = ztypes.tid.create from: 0
            }
            tplDecl49Org: st.reg.genericOriginOf tid: monoId
            tplDecl49: declOfTypeId reg: st.reg tid: tplDecl49Org
            (checkFunctionBody
                :st
                :unitDecl
                defName: q9.stringview
                defn: (ast.nodes.get i: bm2.operation.u64)
                thisName: ""
                :ast
                declId: tplDecl49
            )
        } else null
    }
    st.typing.synthLabel = prevL9
    st.typing.currentThisName = prevT9
    st.typing.curMonoFnTid = ztypes.tid.create from: 0
    st.typing.curMonoStamp = 0
    st.typing.suppressParamStamps = prevSup9
    st.typing.monoParamSubst = (MapVV ztypes.tid value: ztypes.tid)
    st.pop
}

# foldLiteralStamps -- replace literal-typed node stamps with their concrete
# defaults (i64 / f64) after the body walk: the unregistered pseudo ids and the
# data blocks' registered literal_int/literal_float element shells. Symbol-table
# entries keep their literal ids (the oracle's entry/variable rows read
# literal_int there too).
foldLiteralStamps: function {st: zenv.ZSymbolTable program: Node.view} is {
    match (
        program
    ) case program then {
        unitDecl: (unitDeclOfName
            ty: st.typing
            ast: program.ast
            name: program.mainUnitName.stringview
        )
        intId: u64
        li: (walkLookupTyperef
            ast: program.ast
            ty: st.typing
            reg: st.reg
            :unitDecl
            base: "i64"
        )
        match (
            li
        ) case some then {
            intId = li
        } case none then null
        floatId: u64
        lf: (walkLookupTyperef
            ast: program.ast
            ty: st.typing
            reg: st.reg
            :unitDecl
            base: "f64"
        )
        match (
            lf
        ) case some then {
            floatId = lf
        } case none then null
        nn9: st.typing.nodeType.length
        ni9: u64
        for ni9 < nn9 loop {
            fv9: st.typing.nodeType.get i: ni9
            if fv9 > 0 then {
                isInt: fv9 == st.reg.literalIntTid
                isFloat: fv9 == st.reg.literalFloatTid
                if isInt when intId > 0 then {
                    (ztyping.nodeTypeSet
                        tbl: st.typing.nodeType
                        nid: ni9
                        tid: (ztypes.tid.create from: intId.u64)
                    )
                }
                if isFloat when floatId > 0 then {
                    (ztyping.nodeTypeSet
                        tbl: st.typing.nodeType
                        nid: ni9
                        tid: (ztypes.tid.create from: floatId.u64)
                    )
                }
            }
            ni9 = ni9 + 1
        }
    } else null
}

# isBinopNode -- kind test without narrowing (the caller keeps the Node handle).
isBinopNode: function {n: Node.view} out bool is {
    match (
        n
    ) case binop then {
        return true
    } else {
        return false
    }
}

# constantOperandType -- type one operand of a unit-level constant expression,
# stamping as it walks: a numeric literal wears the pseudo id (folded to its
# visible default later), a name reads an already-materialised constant from
# resolved (body order), and a binop takes the first concretely-typed operand
# (else the literal pseudo). 0 = not a constant shape.
constantOperandType: function {ast: Ast.view
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    unitDecl: ztypes.declid
    n: Node.view
} out u64 is {
    match (
        n
    ) case expression then {
        return (constantOperandType
            :ast
            :ty
            :reg
            :unitDecl
            n: (ast.nodes.get i: n.expression.u64)
        )
    } case atomid then {
        result: u64
        trN9: ast.names.texts.get i: n.name.u64
        if (isNumericLiteralName name: trN9.stringview) then {
            if (isFloatLiteralName name: trN9.stringview) then {
                result = reg.literalFloatTid
            } else {
                result = reg.literalIntTid
            }
        } else {
            ro: walkLookupTyperef :ast :ty :reg :unitDecl base: trN9.stringview
            match (
                ro
            ) case some then {
                result = ro
            } case none then null
        }
        if result > 0 then {
            (ztyping.nodeTypeSet
                tbl: ty.nodeType
                nid: n.nodeid.u64
                tid: (ztypes.tid.create from: result.u64)
            )
        }
        return result
    } case binop then {
        lt: constantOperandType :ast :ty :reg :unitDecl n: (ast.nodes.get i: n.lhs.u64)
        rt: constantOperandType :ast :ty :reg :unitDecl n: (ast.nodes.get i: n.rhs.u64)
        opn9: atomName :ast n: (ast.nodes.get i: n.operator.u64)
        if (isComparisonOp name: opn9.stringview) then {
            # A comparison condition: the result is bool and a literal
            # operand coerces (restamps) at the concrete side's type.
            lLit: false
            if lt == reg.literalIntTid then lLit = true
            if lt == reg.literalFloatTid then lLit = true
            rLit: false
            if rt == reg.literalIntTid then rLit = true
            if rt == reg.literalFloatTid then rLit = true
            conc: u64
            if (lLit) == false then {
                if lt > 0 then conc = lt
            }
            if conc == 0 then {
                if (rLit) == false then {
                    if rt > 0 then conc = rt
                }
            }
            if lLit when conc > 0 then {
                lid9: innermostNodeId :ast n: (ast.nodes.get i: n.lhs.u64)
                if lid9 > 0 then {
                    (ztyping.nodeTypeSet
                        tbl: ty.nodeType
                        nid: lid9.u64
                        tid: (ztypes.tid.create from: conc.u64)
                    )
                }
            }
            if rLit when conc > 0 then {
                rid9: innermostNodeId :ast n: (ast.nodes.get i: n.rhs.u64)
                if rid9 > 0 then {
                    setr9: conc
                    (ztyping.nodeTypeSet
                        tbl: ty.nodeType
                        nid: rid9.u64
                        tid: (ztypes.tid.create from: setr9.u64)
                    )
                }
            }
            bres9: u64
            bo9: walkLookupTyperef :ast :ty :reg :unitDecl base: "bool"
            match (
                bo9
            ) case some then {
                bres9 = bo9
                (ztyping.nodeTypeSet
                    tbl: ty.nodeType
                    nid: n.nodeid.u64
                    tid: (ztypes.tid.create from: bres9.u64)
                )
            } case none then null
            return bres9
        }
        result: lt
        if lt == 0 then result = rt
        if lt == reg.literalIntTid then {
            if rt > 0 when rt != reg.literalIntTid when rt != reg.literalFloatTid then result = rt
        }
        if lt == reg.literalFloatTid then {
            if rt > 0 when rt != reg.literalIntTid when rt != reg.literalFloatTid then result = rt
        }
        if result > 0 then {
            (ztyping.nodeTypeSet
                tbl: ty.nodeType
                nid: n.nodeid.u64
                tid: (ztypes.tid.create from: result.u64)
            )
        }
        return result
    } else {
        return 0
    }
}

# constantBranchWalk -- walk one unit-level-if branch block: each statement's
# expression types through the constant walk; literal results materialise to
# their defaults (i64/f64) on the statement, its expression wrapper, and the
# atom. Returns the (materialised) last-statement type.
constantBranchWalk: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    block: Node.view
} out u64 is {
    match (
        block
    ) case statement then {
        result: u64
        siter: block.statements.iterate
        for s9Id9: siter loop {
            s9: ast.nodes.get i: s9Id9.u64
            match (
                s9
            ) case statementline then {
                sInner9: ast.nodes.get i: s9.statementline.u64
                bt0: constantOperandType :ast :ty :reg :unitDecl n: sInner9
                mt0: u64
                if bt0 == reg.literalIntTid then {
                    mt0 = (optU64Or
                        o: (walkLookupTyperef :ast :ty :reg :unitDecl base: "i64")
                        d: 0
                    )
                }
                if bt0 == reg.literalFloatTid then {
                    mt0 = (optU64Or
                        o: (walkLookupTyperef :ast :ty :reg :unitDecl base: "f64")
                        d: 0
                    )
                }
                if mt0 > 0 then {
                    (ztyping.nodeTypeSet
                        tbl: ty.nodeType
                        nid: s9.nodeid.u64
                        tid: (ztypes.tid.create from: mt0.u64)
                    )
                    eid0: nodeId n: sInner9
                    if eid0 > 0 then {
                        (ztyping.nodeTypeSet
                            tbl: ty.nodeType
                            nid: eid0.u64
                            tid: (ztypes.tid.create from: mt0.u64)
                        )
                    }
                    iid0: innermostNodeId :ast n: sInner9
                    if iid0 > 0 then {
                        (ztyping.nodeTypeSet
                            tbl: ty.nodeType
                            nid: iid0.u64
                            tid: (ztypes.tid.create from: mt0.u64)
                        )
                    }
                    result = mt0
                } else {
                    if bt0 > 0 then {
                        (ztyping.nodeTypeSet
                            tbl: ty.nodeType
                            nid: s9.nodeid.u64
                            tid: (ztypes.tid.create from: bt0.u64)
                        )
                        result = bt0
                    }
                }
            } else null
        }
        return result
    } else {
        return 0
    }
}

# resolveUnitIfDef -- a unit-level `if` definition (compile-time conditional):
# conditions walk through the constant machinery (comparisons stamp bool and
# coerce literal operands), branches walk + materialise, and the definition
# resolves to the first branch's type -- stamped on the If, its Expression
# wrapper, and resolved[unit.name].
resolveUnitIfDef: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    unitDecl: ztypes.declid
    defName: StringView
    wrapperId: u32
    n: Node.view
} is {
    match (
        n
    ) case ifexpr then {
        t9: u64
        # every clause is still walked and typed -- a dead branch's type errors
        # are still type errors -- but the definition takes the type of the
        # branch that WINS, per the spec's "the type of the first arm whose
        # condition is true". w9 is that type; t9 stays the first-typed
        # fallback for an `if` whose conditions did not fold.
        w9: u64
        fb9: foldIfBranch :ast :ty :reg :unitDecl :n
        cliter: n.clauses.iterate
        for clauseId9: cliter loop {
            clause: ast.nodes.get i: clauseId9.u64
            match (
                clause
            ) case ifclause then {
                coiter: clause.conditions.iterate
                for condId9: coiter loop {
                    cond: ast.nodes.get i: condId9.u64
                    match (
                        cond
                    ) case namedoperation then {
                        (constantOperandType
                            :ast
                            :ty
                            :reg
                            :unitDecl
                            n: (ast.nodes.get i: cond.operation.u64)
                        )
                    } else null
                }
                bt9: (constantBranchWalk
                    :ty
                    :reg
                    :ast
                    :unitDecl
                    block: (ast.nodes.get i: clause.statement.u64)
                )
                if t9 == 0 then t9 = bt9
                if fb9.known when clause.statement == fb9.stmt then w9 = bt9
            } else null
        }
        if n.elseclause > 0 then {
            et9: (constantBranchWalk
                :ty
                :reg
                :ast
                :unitDecl
                block: (ast.nodes.get i: n.elseclause.u64)
            )
            if t9 == 0 then t9 = et9
            if fb9.known when n.elseclause == fb9.stmt then w9 = et9
        }
        if fb9.known when w9 > 0 then t9 = w9
        if t9 > 0 then {
            (ztyping.nodeTypeSet
                tbl: ty.nodeType
                nid: wrapperId.u64
                tid: (ztypes.tid.create from: t9.u64)
            )
            (ztyping.nodeTypeSet
                tbl: ty.nodeType
                nid: n.nodeid.u64
                tid: (ztypes.tid.create from: t9.u64)
            )
            cu9: (declTypeIdOf
                :ty
                declId: unitDecl
            )
            if (cu9.isZero) == false then {
                (ty.setMemberType
                    parentTypeId: (ztypes.tid.create from: cu9.u64)
                    nameId: (zast.poolFind pool: ast.names text: defName)
                    childTypeId: t9
                )
            }
        }
    } else null
}

# --- compile-time constant evaluation ---
#
# The value domain the emitter used to answer for itself. evalConstNode walks a
# constant expression once and yields a cval; constValueOfMember pulls the value
# of a NAMED constant on demand and memoises it. On demand rather than in source
# order because definitions are not written in dependency order and units are
# not visited in dependency order: `B: A + 2` may precede `A: 1`, and a
# `require:` block in one unit reads a constant declared in another.

# reportConstError -- the E0600 diagnostic: the compiler was asked for a value
# at compile time and could not produce one. One code for the whole category
# with a distinct message per case, the way typeError carries its own. Distinct
# from E0500, which is the emitter reporting a construct it cannot emit.
reportConstError: function {
    ty: ztyping.ZTyping
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u32
    msg: String
    hint: String
} is {
    cn9: "a unit constant is evaluated at compile time".string
    ty.errors.append (zast.ErrorData
        :nodeid
        :lineno
        :colno
        :width
        err: zast.err.constError
        msg: msg.copy
        fsno: zvfs.fsno
        note: cn9
        hint: hint.copy
    )
    ty.isError = true
}

# constFailClear -- drop any pending failure. Called before a pull that will
# render, and after one that will not, so a failure recorded for a body branch
# can never be attributed to the next definition.
constFailClear: function {ty: ztyping.ZTyping} is {
    ty.constFail = ztypes.noConstFail
}

# constFailRecord -- the evaluator's way of saying "there is no value, and this
# is why". FIRST failure wins: the innermost one is the specific one, and an
# outer operand walk that fails afterwards would only say "an operand did not
# fold", which the caller already knows.
constFailRecord: function {
    ty: ztyping.ZTyping
    kind: ztypes.constfailkind
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u32
    strId: 0.u32
} is {
    if (ty.constFail.kind.none) == false then return
    ty.constFail = (ztypes.constfail
        :kind
        :nodeid
        :lineno
        :colno
        :width
        :strId
    )
}

# reportPendingConstFail -- render the recorded failure, if any, and clear it.
# Only a caller that REQUIRED a value calls this: a unit-level definition, a
# `require:` block. A body fold never does, which is what keeps an unfoldable
# body condition an ordinary runtime branch instead of an error.
reportPendingConstFail: function {ty: ztyping.ZTyping} is {
    f9: ty.constFail
    if f9.kind.none then return
    constFailClear :ty
    if f9.kind.reachedError then {
        # E0601: the program itself asserting, in the user's own words. Not an
        # E0600 -- the evaluator worked, and what it found was a reached
        # `error`.
        um9: constStringAt :ty id: f9.strId
        uh9: "the compiler proved this `error` reachable".string
        ty.errors.append (zast.ErrorData
            nodeid: f9.nodeid
            lineno: f9.lineno
            colno: f9.colno
            width: f9.width
            err: zast.err.userError
            msg: um9.copy
            fsno: zvfs.fsno
            note: "".string
            hint: uh9
        )
        ty.isError = true
        return
    }
    msg9: String
    hint9: String
    if f9.kind.interp then {
        msg9 = "an interpolated string has no compile-time value".string
        hint9 = "interpolation reads its parts at run time; use a plain literal".string
    }
    if f9.kind.overflow then {
        msg9 = "constant integer operation overflows".string
        hint9 = "the compile-time evaluator works in i64; this result does not fit".string
    }
    if f9.kind.divZero then {
        msg9 = "division by a constant zero".string
        hint9 = "the divisor is a compile-time constant equal to 0".string
    }
    if f9.kind.cycle then {
        cn9: constStringAt :ty id: f9.strId
        msg9 = "constant '\{cn9}' is defined in terms of itself"
        hint9 = "a unit constant may only read constants that do not read it back".string
    }
    if f9.kind.unsupportedMethod then {
        mn9: constStringAt :ty id: f9.strId
        msg9 = "'\{mn9}' has no compile-time value"
        hint9 = "a string constant may use length, startsWith, endsWith, contains and substring".string
    }
    if f9.kind.substringRange then {
        msg9 = "constant 'substring' range is out of bounds".string
        hint9 = "from and to must satisfy from <= to <= length; the run-time call panics".string
    }
    if msg9.length == 0 then return
    (reportConstError
        :ty
        nodeid: f9.nodeid
        lineno: f9.lineno
        colno: f9.colno
        width: f9.width
        msg: msg9
        hint: hint9
    )
}

# constLiteralValue -- a numeric literal lexeme as a value, parsed through the
# same parseI64 / parseF64 the emitter's fold uses so the two cannot disagree
# about what a literal means. A magnitude outside i64 reads as "not a constant"
# rather than as a wrapped one.
constLiteralValue: function {name: StringView} out ztypes.cval is {
    if (isFloatLiteralName :name) then {
        pf9: name.parseF64
        match (
            pf9
        ) case ok then {
            return (ztypes.makeFloatConst pf9)
        } case err then {
            return ztypes.noConst
        }
    }
    pi9: name.parseI64
    match (
        pi9
    ) case ok then {
        return (ztypes.makeIntConst pi9)
    } case err then {
        return ztypes.noConst
    }
}

# constInternString -- the id of `text` in ZTyping.constStrings. The scan
# starts past the sentinel row, so 0 keeps meaning "no string" and a genuine
# empty constant gets a row of its own. Interned rather than stored inline
# because a cval is a valtype and owns no heap; deduplicated by a linear scan,
# which is right for a table that holds a handful of entries.
constInternString: function {ty: ztyping.ZTyping text: StringView} out u32 is {
    i9: 1.u64
    n9: ty.constStrings.length
    for i9 < n9 loop {
        e9: ty.constStrings.get i: i9
        if e9.stringview == text then return i9.u32.orPanic
        i9 = i9 + 1
    }
    id9: ty.constStrings.length.u32.orPanic
    ty.constStrings.append text.string
    return id9
}

# constStringAt -- the interned text a svalKind names; id 0 reads the sentinel
# row, which holds the empty text.
constStringAt: function {ty: ztyping.ZTyping.view id: u32} out String is {
    # a list `get` hands back a NON-OWNING shallow copy; returning it as an
    # owned String hands the caller a buffer the pool still owns
    e9: ty.constStrings.get i: id.u64
    return e9.copy
}

# constFloatOf -- an integer or float value as an f64, for a mixed-kind binop.
# `has` false means the value is neither.
constFloatOf: function {v: ztypes.cval} out ffoldval is {
    if v.kind.fvalKind then return (ffoldval has: true val: v.fval)
    if v.kind.ivalKind then {
        cf9: v.ival.f64
        match (
            cf9
        ) case ok then {
            return (ffoldval has: true val: cf9)
        } case err then {
            return (ffoldval has: false val: 0.0)
        }
    }
    return (ffoldval has: false val: 0.0)
}

# a float operand of a folded binop; `has` false = not a numeric value.
ffoldval: record {
    has: bool
    val: f64
}

# constArithInt -- fold an arithmetic operator over two integers. Reports the
# two failures the spec names: division by a constant zero, and a result the
# evaluator cannot represent. Overflow is checked against i64, the range the
# evaluator works in -- a value carries no target type until it materialises,
# so a narrower target's overflow is still the materialiser's business.
constArithInt: function {
    ty: ztyping.ZTyping
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    op: StringView
    a: i64
    b: i64
} out ztypes.cval is {
    mx9: 9223372036854775807
    mn9: (0 - 9223372036854775807) - 1
    ovk9: ztypes.constfailkind.overflow
    if op == "+" then {
        if b > 0 when a > (mx9 - b) then {
            (constFailRecord :ty kind: ovk9 :nodeid :lineno :colno width: 1)
            return ztypes.noConst
        }
        if b < 0 when a < (mn9 - b) then {
            (constFailRecord :ty kind: ovk9 :nodeid :lineno :colno width: 1)
            return ztypes.noConst
        }
        return (ztypes.makeIntConst (a + b))
    }
    if op == "-" then {
        if b < 0 when a > (mx9 + b) then {
            (constFailRecord :ty kind: ovk9 :nodeid :lineno :colno width: 1)
            return ztypes.noConst
        }
        if b > 0 when a < (mn9 + b) then {
            (constFailRecord :ty kind: ovk9 :nodeid :lineno :colno width: 1)
            return ztypes.noConst
        }
        return (ztypes.makeIntConst (a - b))
    }
    if op == "*" then {
        if a == 0 then return (ztypes.makeIntConst 0)
        if b == 0 then return (ztypes.makeIntConst 0)
        # -fwrapv makes the product defined, so dividing it back is a valid
        # test; MIN * -1 wraps to itself and passes it, hence the pair below.
        bad9: false
        if a == (0 - 1) when b == mn9 then bad9 = true
        if b == (0 - 1) when a == mn9 then bad9 = true
        r9: a * b
        if (r9 / a) != b then bad9 = true
        if bad9 then {
            (constFailRecord :ty kind: ovk9 :nodeid :lineno :colno width: 1)
            return ztypes.noConst
        }
        return (ztypes.makeIntConst r9)
    }
    if op == "/" then {
        if b == 0 then {
            (constFailRecord
                :ty
                kind: ztypes.constfailkind.divZero
                :nodeid
                :lineno
                :colno
                width: 1
            )
            return ztypes.noConst
        }
        if a == mn9 when b == (0 - 1) then {
            (constFailRecord :ty kind: ovk9 :nodeid :lineno :colno width: 1)
            return ztypes.noConst
        }
        return (ztypes.makeIntConst (a / b))
    }
    return ztypes.noConst
}

# constCompareInt / constCompareFloat -- the six comparisons, yielding a bool
# value. Written twice rather than once over f64 because an i64 comparison must
# not lose precision by routing through a float.
# boolConst9 -- the folded truth value `v` as a constant naming one of bool's
# arms. bool is a variant like any other, so its constants are armKind ones:
# `true` is the arm bool declares second and `false` the arm it declares first,
# both read from what the checker recorded for the declaration rather than
# spelled here. noConst when bool is not in the program, or when its arms were
# not recorded -- an absent fold is a runtime branch, never a wrong one.
boolConst9: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    v: bool
} out ztypes.cval is {
    bt9: builtinTidT :ast :ty :reg base: "bool"
    if bt9.isZero then return ztypes.noConst
    nm9: u64
    if v then {
        o9: ty.sumPairSecondArm.get key: bt9.u64
        match (
            o9
        ) case some then {
            nm9 = o9
        } case none then null
    } else {
        o8: ty.sumPairFirstArm.get key: bt9.u64
        match (
            o8
        ) case some then {
            nm9 = o8
        } case none then null
    }
    if nm9 == 0 then return ztypes.noConst
    return (ztypes.makeArmConst armTid: bt9 armName: (zast.nameid.create from: nm9.u32.orPanic))
}

constCompareInt: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    op: StringView
    a: i64
    b: i64
} out ztypes.cval is {
    if op == "==" then return (boolConst9 :ast :ty :reg v: (a == b))
    if op == "!=" then return (boolConst9 :ast :ty :reg v: (a != b))
    if op == "<" then return (boolConst9 :ast :ty :reg v: (a < b))
    if op == "<=" then return (boolConst9 :ast :ty :reg v: (a <= b))
    if op == ">" then return (boolConst9 :ast :ty :reg v: (a > b))
    if op == ">=" then return (boolConst9 :ast :ty :reg v: (a >= b))
    return ztypes.noConst
}

constCompareFloat: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    op: StringView
    a: f64
    b: f64
} out ztypes.cval is {
    if op == "==" then return (boolConst9 :ast :ty :reg v: (a == b))
    if op == "!=" then return (boolConst9 :ast :ty :reg v: (a != b))
    if op == "<" then return (boolConst9 :ast :ty :reg v: (a < b))
    if op == "<=" then return (boolConst9 :ast :ty :reg v: (a <= b))
    if op == ">" then return (boolConst9 :ast :ty :reg v: (a > b))
    if op == ">=" then return (boolConst9 :ast :ty :reg v: (a >= b))
    return ztypes.noConst
}

constArithFloat: function {op: StringView a: f64 b: f64} out ztypes.cval is {
    if op == "+" then return (ztypes.makeFloatConst (a + b))
    if op == "-" then return (ztypes.makeFloatConst (a - b))
    if op == "*" then return (ztypes.makeFloatConst (a * b))
    if op == "/" then return (ztypes.makeFloatConst (a / b))
    return ztypes.noConst
}

# constOwnerDeclFor -- the DECLARATION a constant named `defName` is a member
# of. A name written inside a namespace resolves against that namespace first
# and falls back to the file unit, which is the chain spec.pdoc describes for an
# inline unit. The TYPE and VALUE channels must agree about this, so both ask
# here rather than each deciding for itself -- and both facts the fold needs,
# the owner's type id and the constant's own def node, come off this one answer.
constOwnerDeclFor: function {
    ast: Ast.view
    ty: ztyping.ZTyping.view
    unitDecl: ztypes.declid
    defName: StringView
} out ztypes.declid is {
    # the frames innermost outward from the cursor: a constant written inside
    # a unit is keyed on THAT unit, and on each unit enclosing it before the
    # file unit. Asking only the innermost left a constant of an enclosing
    # inline unit unreachable from a unit nested inside it.
    dnm9: zast.poolFind pool: ast.names text: defName
    cur9: frameFor :ty :unitDecl
    for cur9 > 0 loop {
        if cur9 == ty.coreUnitRoot then {
            cur9 = ztypes.declid
        } else {
            nd9: ty.declFindChild parentDeclId: cur9 nameId: dnm9
            if (nd9.isZero) == false then {
                ct9: declTypeIdOf :ty declId: cur9
                if (ct9.isZero) == false then return cur9
            }
            cur9 = unitFrameOf :ty declId: (declParentIdOf :ty declId: cur9)
        }
    }
    # nothing in the chain declares it: the file unit owns it, which is where a
    # constant reached before its own declaration was indexed is keyed
    return unitDecl
}

# constDefIsComputed -- the definition COMPUTES a value from others, as against
# the ALIAS forms (`Same: Holder`, `Node: zast.Node`) which name a type and are
# resolveDef's business. Only a computed definition can be self-referential in
# the constant sense: a ring of aliases is an alias cycle, and the resolver
# already reports that with its own diagnostic and its own wording.
constDefIsComputed: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case expression then {
        return (constDefIsComputed :ast n: (ast.nodes.get i: n.expression.u64))
    } else {
        return (isBinopNode :n)
    }
}

# constValueOfMemberTid -- the memoised compile-time value of a member of the
# unit whose type id is `unitTid`. A nested namespace has no unit-name index
# entry to reach it through, but resolveNamespaceUnit has already evaluated its
# members against this id, so the read is a pure lookup rather than a descent.
constValueOfMemberTid: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitTid: ztypes.tid
    defName: StringView
} out ztypes.cval is {
    if unitTid.isZero then return ztypes.noConst
    nid9: zast.poolFind pool: ast.names text: defName
    if nid9.isZero then return ztypes.noConst
    k9: ty.memberConstKey parentTypeId: unitTid nameId: nid9
    sg9: ty.constEvalState.get key: k9
    match (
        sg9
    ) case some then {
        if sg9 == 2 then return (ty.memberConstOf parentTypeId: unitTid nameId: nid9)
    } case none then null
    # not folded yet -- READING a constant is what folds it, so descend into
    # the owner's declaration and fold there, then read back. Without this a
    # constant that names another unit's constant sees a memo that nothing
    # filled.
    od9: ty.declIdOfType typeId: unitTid
    if od9.isZero then od9 = declOfTypeId :reg tid: unitTid
    if od9.isZero then return ztypes.noConst
    cd9: ty.declFindChild parentDeclId: od9 nameId: nid9
    if cd9.isZero then return ztypes.noConst
    constFoldDecl :ast :ty :reg declId: cd9
    return (ty.memberConstOf parentTypeId: unitTid nameId: nid9)
}

# constValueOfMember -- the compile-time value of `unitDecl.defName`, evaluated
# on demand and memoised in memberConst. constEvalState carries the cycle
# guard: re-entering a member that is still evaluating is `A: B + 1` paired
# with `B: A + 1`, which has no value and must say so once rather than recur.
constValueOfMember: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    defName: StringView
} out ztypes.cval is {
    od9: constOwnerDeclFor :ast :ty :unitDecl :defName
    if od9.isZero then return ztypes.noConst
    nid9: zast.poolFind pool: ast.names text: defName
    if nid9.isZero then return ztypes.noConst
    # the constant's own declaration is the owner's child of that name, so the
    # def node comes off the same walk that found the owner
    dnode9: 0
    {
        cd9: ty.declFindChild parentDeclId: od9 nameId: nid9
        if (cd9.isZero) == false then {
            cdo9: ty.decls.get i: cd9.u64
            dnode9 = cdo9.node
        }
    }
    return (constValueOfMemberAt
        :ast
        :ty
        :reg
        :unitDecl
        ownerDecl: od9
        nameId: nid9
        defNodeId: dnode9
        :defName
    )
}

# constValueOfMemberAt -- the fold itself, addressed by the OWNER's declaration.
# A member of a NESTED unit has no (unitDecl, defName) pair that names it, so
# the name-keyed lookup above is the wrapper's and the evaluation is here. The
# owner arrives as a Decl rather than a type id because that is what the
# evaluation frame is: deriving it back from the id was a reverse lookup.
constValueOfMemberAt: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    ownerDecl: ztypes.declid
    nameId: zast.nameid
    defNodeId: u32
    defName: StringView
} out ztypes.cval is {
    utid9: declTypeIdOf :ty declId: ownerDecl
    nid9: nameId
    if utid9.isZero then return ztypes.noConst
    k9: ty.memberConstKey parentTypeId: utid9 nameId: nid9
    st9: 0
    {
        sg9: ty.constEvalState.get key: k9
        match (
            sg9
        ) case some then {
            st9 = sg9.u64
        } case none then null
    }
    if st9 == 2 then return (ty.memberConstOf parentTypeId: utid9 nameId: nid9)
    dnid9: defNodeId
    if dnid9 == 0 then return ztypes.noConst
    opid9: u32
    dline9: u32
    dcol9: u32
    dnode9: zast.nodeid
    {
        dn9: ast.nodes.get i: dnid9.u64
        match (
            dn9
        ) case namedoperation then {
            opid9 = dn9.operation
            dline9 = dn9.lineno
            dcol9 = dn9.colno
            dnode9 = dn9.nodeid
        } else null
    }
    if opid9 == 0 then return ztypes.noConst
    if st9 == 1 then {
        if (constDefIsComputed :ast n: (ast.nodes.get i: opid9.u64)) == false then {
            ty.constEvalState.set key: k9 value: 2.u8
            return ztypes.noConst
        }
        (constFailRecord
            :ty
            kind: ztypes.constfailkind.cycle
            nodeid: dnode9
            lineno: dline9
            colno: dcol9
            width: defName.length.u32.orPanic
            strId: (constInternString :ty text: defName)
        )
        ty.constEvalState.set key: k9 value: 2.u8
        return ztypes.noConst
    }
    ty.constEvalState.set key: k9 value: 1.u8
    # the value is evaluated in the frame of the unit that owns the member --
    # the owner itself, which the caller already holds
    prevFrame9: ty.curFrame
    ty.curFrame = ownerDecl
    v9: (evalConstNode :ast :ty :reg :unitDecl n: (ast.nodes.get i: opid9.u64))
    ty.curFrame = prevFrame9
    ty.constEvalState.set key: k9 value: 2.u8
    if (v9.kind.none) == false then {
        ty.setMemberConst parentTypeId: utid9 nameId: nid9 value: v9
    }
    return v9
}

# constBlockValue -- the value a branch block yields: its LAST statement's,
# the way constantBranchWalk takes the block's type from the last statement.
constBlockValue: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    block: Node.view
} out ztypes.cval is {
    match (
        block
    ) case statement then {
        r9: ztypes.noConst
        siter9: block.statements.iterate
        for sId9: siter9 loop {
            s9: ast.nodes.get i: sId9.u64
            match (
                s9
            ) case statementline then {
                r9 = (evalConstNode
                    :ast
                    :ty
                    :reg
                    :unitDecl
                    n: (ast.nodes.get i: s9.statementline.u64)
                )
            } else null
        }
        return r9
    } else {
        return ztypes.noConst
    }
}

# foldIfBranch -- which clause of an `if` the constant fold selects, stamped on
# the If so every consumer reads ONE answer instead of recomputing its own.
# Every condition of a clause must fold and be true for that clause to win; the
# first winner takes it and the else clause is the fallback. `known` false means
# a condition did not fold: this is a runtime `if` and nothing may be elided.
foldIfBranch: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    n: zast.IfData.view
} out ztyping.foldedbranch is {
    {
        known9: true
        stmt9: zast.nodeid
        decided9: false
        cliter9: n.clauses.iterate
        for clauseId9: cliter9 loop {
            if decided9 == false then {
                clause9: ast.nodes.get i: clauseId9.u64
                match (
                    clause9
                ) case ifclause then {
                    allTrue9: true
                    undecided9: false
                    coiter9: clause9.conditions.iterate
                    for condId9: coiter9 loop {
                        cond9: ast.nodes.get i: condId9.u64
                        match (
                            cond9
                        ) case namedoperation then {
                            # a labelled condition other than `when` is not a
                            # plain guard, and this fold does not speak for it
                            cl9: zast.nameTextAt :ast ref: cond9.name
                            if cl9.length > 0 when cl9.stringview != "when" then {
                                undecided9 = true
                            } else {
                                cv9: (evalConstNode
                                    :ast
                                    :ty
                                    :reg
                                    :unitDecl
                                    n: (ast.nodes.get i: cond9.operation.u64)
                                )
                                # by the DISCRIMINATOR, not by arm position: a
                                # data-sourced tag names its own values.
                                fa9: (ztyping.sumPairFalsyArmOf :ty :reg tid: cv9.armTid)
                                ta9: (ztyping.sumPairTruthyArmOf :ty :reg tid: cv9.armTid)
                                isF9: false
                                if fa9 > 0 when cv9.armName.u64 == fa9 then isF9 = true
                                isT9: false
                                if ta9 > 0 when cv9.armName.u64 == ta9 then isT9 = true
                                if isF9 then {
                                    allTrue9 = false
                                } else {
                                    if (isT9) == false then undecided9 = true
                                }
                            }
                        } else null
                    }
                    if undecided9 then {
                        known9 = false
                        decided9 = true
                    } else {
                        if allTrue9 then {
                            stmt9 = clause9.statement
                            decided9 = true
                        }
                    }
                } else null
            }
        }
        if decided9 == false then stmt9 = n.elseclause
        fb9: ztyping.foldedbranch known: known9 stmt: stmt9
        ty.foldedBranch.set key: n.nodeid.u64 value: fb9
        return fb9
    }
}

# constArmRead -- `<typeName>.<armName>` looked up from `lookupUnit`, as a
# value. The parent's FAMILY decides, the same test resolveConstantDef uses to
# tell an arm read from a construction: variant or union means the child is an
# arm, and anything else is a member read a constant cannot hold.
constArmRead: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    lookupUnit: ztypes.declid
    typeName: StringView
    armName: StringView
} out ztypes.cval is {
    # the type is looked up in `lookupUnit`'s frame -- the cursor's own when
    # it already lies inside that unit (a nested scope of it is nearer than
    # its root), else the unit's root
    prevFrame9: ty.curFrame
    {
        lro9: lookupUnit
        if (lro9.isZero) == false then if (frameIsWithin
            :ty
            frame: ty.curFrame
            root: lro9
        ) == false then ty.curFrame = lro9
    }
    ptu9: (optU64Or
        o: (walkLookupTyperef :ast :ty :reg unitDecl: lookupUnit base: typeName)
        d: 0
    )
    if ptu9 == 0 then {
        # a variant NOTHING ELSE mentions is not demanded, so the lookup finds
        # nothing and the arm read silently yields no value. Descending mints
        # it, which is what a use site would have done -- a constant reading an
        # arm IS a use of the type.
        ptu9 = (descendNamed :ty :reg :ast unitDecl: lookupUnit name: typeName).u64
    }
    ty.curFrame = prevFrame9
    if ptu9 == 0 then return ztypes.noConst
    ptid9: ztypes.tid.create from: ptu9.u64
    ptt9: reg.typetypeOf typeId: ptid9
    isSum9: false
    if ptt9 == ztypes.ztypetype.variantType then isSum9 = true
    if ptt9 == ztypes.ztypetype.unionType then isSum9 = true
    if (isSum9) == false then return ztypes.noConst
    return (ztypes.makeArmConst
        armTid: ptid9
        armName: (zast.poolFind pool: ast.names text: armName)
    )
}

# constValEq -- do two compile-time values denote the same thing? Only defined
# within a kind: comparing an int to a tag is not false, it is unanswerable,
# which is what `has` reports.
constValEq: function {ty: ztyping.ZTyping.view a: ztypes.cval b: ztypes.cval} out ffoldval is {
    if a.kind.ivalKind when b.kind.ivalKind then {
        r9: 0.0
        if a.ival == b.ival then r9 = 1.0
        return (ffoldval has: true val: r9)
    }
    if a.kind.armKind when b.kind.armKind then {
        r9: 0.0
        if a.armTid == b.armTid when a.armName == b.armName then r9 = 1.0
        return (ffoldval has: true val: r9)
    }
    if a.kind.svalKind when b.kind.svalKind then {
        as9: constStringAt :ty id: a.strId
        bs9: constStringAt :ty id: b.strId
        r9: 0.0
        if as9.stringview == bs9.stringview then r9 = 1.0
        return (ffoldval has: true val: r9)
    }
    return (ffoldval has: false val: 0.0)
}

# foldCaseArm -- which arm of a `match` a constant subject selects, stamped on
# the match the way foldIfBranch stamps an `if`. A BINDING arm (`case x then`)
# names its payload rather than testing a value, so a match holding one is not
# decidable here at all.
foldCaseArm: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    n: zast.CaseData.view
} is {
    sv9: (evalConstNode
        :ast
        :ty
        :reg
        :unitDecl
        n: (ast.nodes.get i: n.subject.u64)
    )
    if sv9.kind.none then return
    known9: true
    stmt9: zast.nodeid
    decided9: false
    cliter9: n.clauses.iterate
    for clId9: cliter9 loop {
        if known9 then {
            cl9: ast.nodes.get i: clId9.u64
            match (
                cl9
            ) case caseclause then {
                if cl9.name != 0 then {
                    known9 = false
                } else {
                    av9: (evalConstNode
                        :ast
                        :ty
                        :reg
                        :unitDecl
                        n: (ast.nodes.get i: cl9.matcharm.u64)
                    )
                    eq9: constValEq :ty a: av9 b: sv9
                    if eq9.has then {
                        if eq9.val > 0.0 when decided9 == false then {
                            stmt9 = cl9.statement
                            decided9 = true
                        }
                    } else {
                        known9 = false
                    }
                }
            } else {
                known9 = false
            }
        }
    }
    if known9 == false then return
    if decided9 == false then stmt9 = n.elseclause
    ty.foldedBranch.set key: n.nodeid.u64 value: (ztyping.foldedbranch known: true stmt: stmt9)
}

# constStrArgAt -- one argument of a static string method, found by LABEL or by
# POSITION. Argument labels are optional (`sv.startsWith "ztr_"` is legal), so a
# namedoperation carrying no name is the positional form and is matched on its
# ordinal instead.
constStrArgAt: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    args: (ListVal u32).view
    label: StringView
    idx: u64
} out ztypes.cval is {
    res9: ztypes.noConst
    found9: false
    i9: u64
    with it9: args.iterate do for aId9: it9 loop {
        if (found9) == false then {
            an9: ast.nodes.get i: aId9.u64
            match (
                an9
            ) case namedoperation then {
                hit9: false
                if an9.name.isZero when i9 == idx then hit9 = true
                if (an9.name.isZero) == false then {
                    lt9: zast.nameTextAt :ast ref: an9.name
                    if lt9.stringview == label then hit9 = true
                }
                if hit9 then {
                    res9 = (evalConstNode
                        :ast
                        :ty
                        :reg
                        :unitDecl
                        n: (ast.nodes.get i: an9.operation.u64)
                    )
                    found9 = true
                }
                i9 = i9 + 1
            } else null
        }
    }
    return res9
}

# constUnsupportedMethod -- "this name is a method on a string constant that
# does not fold". Records rather than reports, so it is an error only where a
# value was REQUIRED; a body `if` drops it and emits a runtime branch.
constUnsupportedMethod: function {
    ty: ztyping.ZTyping
    name: StringView
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} out ztypes.cval is {
    (constFailRecord
        :ty
        kind: ztypes.constfailkind.unsupportedMethod
        :nodeid
        :lineno
        :colno
        width: name.length.u32.orPanic
        strId: (constInternString :ty text: name)
    )
    return ztypes.noConst
}

# constStringDotted -- a member read on a string constant written as a bare
# dotted path, which is how `S.length` parses. `length` is the BYTE count,
# String.length's own answer; `count` is the codepoint one and is not folded.
constStringDotted: function {
    ty: ztyping.ZTyping
    v: ztypes.cval
    name: StringView
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} out ztypes.cval is {
    s9: constStringAt :ty id: v.strId
    if name == "length" then return (ztypes.makeIntConst s9.length.i64.orPanic)
    return (constUnsupportedMethod :ty :name :nodeid :lineno :colno)
}

# constStringMethod -- fold a static method call on a string constant. Every
# answer is computed by CALLING the same method the run time would, so a folded
# result and a run-time one cannot disagree about an empty prefix, an empty
# needle, or a boundary index. `substring` PANICS out of range rather than
# clamping, so out of range at compile time means there is no value -- not a
# clamped one, and not a silent `none` that would let the definition through.
constStringMethod: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    args: (ListVal u32).view
    recv: ztypes.cval
    name: StringView
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
} out ztypes.cval is {
    s9: constStringAt :ty id: recv.strId
    if name == "length" then return (ztypes.makeIntConst s9.length.i64.orPanic)
    lbl9: ""
    if name == "startsWith" then lbl9 = "prefix"
    if name == "endsWith" then lbl9 = "suffix"
    if name == "contains" then lbl9 = "needle"
    if lbl9.length > 0 then {
        a9: (constStrArgAt :ast :ty :reg :unitDecl :args label: lbl9 idx: 0)
        if (a9.kind.svalKind) == false then return ztypes.noConst
        as9: constStringAt :ty id: a9.strId
        if name == "startsWith" then return (boolConst9
            :ast
            :ty
            :reg
            v: (s9.startsWith prefix: as9)
        )
        if name == "endsWith" then return (boolConst9
            :ast
            :ty
            :reg
            v: (s9.endsWith suffix: as9)
        )
        return (boolConst9 :ast :ty :reg v: (s9.contains needle: as9))
    }
    if name == "substring" then {
        f9: constStrArgAt :ast :ty :reg :unitDecl :args label: "from" idx: 0
        t9: constStrArgAt :ast :ty :reg :unitDecl :args label: "to" idx: 1
        if (f9.kind.ivalKind) == false then return ztypes.noConst
        if (t9.kind.ivalKind) == false then return ztypes.noConst
        sz9: s9.length.i64.orPanic
        bad9: false
        if f9.ival < 0 then bad9 = true
        if t9.ival < 0 then bad9 = true
        if f9.ival > sz9 then bad9 = true
        if t9.ival > sz9 then bad9 = true
        if f9.ival > t9.ival then bad9 = true
        if bad9 then {
            (constFailRecord
                :ty
                kind: ztypes.constfailkind.substringRange
                :nodeid
                :lineno
                :colno
                width: 1
            )
            return ztypes.noConst
        }
        sub9: s9.substring from: f9.ival.u64.orPanic to: t9.ival.u64.orPanic
        return (ztypes.makeStrConst (constInternString :ty text: sub9))
    }
    return (constUnsupportedMethod :ty :name :nodeid :lineno :colno)
}

# evalConstNode -- the compile-time value of a node, or `none` when the node is
# not a constant shape. Numeric shapes only for now: bool and variant arms,
# strings and static string methods arrive with the paths that render them.
# Silence is deliberate here -- a shape with no value is not automatically an
# error, because this walk also runs over definitions that are not constants at
# all. The E0600s below are the cases where a value was genuinely required and
# the operands were there.
evalConstNode: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    n: Node.view
} out ztypes.cval is {
    match (
        n
    ) case expression then {
        return (evalConstNode :ast :ty :reg :unitDecl n: (ast.nodes.get i: n.expression.u64))
    } case atomid then {
        an9: zast.nameTextCopy :ast ref: n.name
        if an9.length == 0 then return ztypes.noConst
        if (isNumericLiteralName name: an9.stringview) then {
            return (constLiteralValue name: an9.stringview)
        }
        return (constValueOfMember :ast :ty :reg :unitDecl defName: an9.stringview)
    } case atomstring then {
        # one chunk and nothing else is a plain literal. An INTERPOLATION has a
        # value only at run time, and a unit-level definition is required to be
        # a compile-time constant, so this is a case where the value was
        # genuinely required and could not be produced -- it reports rather
        # than falling silent the way an unrecognised shape does.
        parts9: n.stringparts.length
        if parts9 == 1 then {
            p09: ast.nodes.get i: (n.stringparts.get i: 0).u64
            match (
                p09
            ) case stringchunk then {
                return (ztypes.makeStrConst (constInternString :ty text: p09.text.stringview))
            } else null
        }
        if parts9 == 0 then return (ztypes.makeStrConst (constInternString :ty text: ""))
        (constFailRecord
            :ty
            kind: ztypes.constfailkind.interp
            nodeid: n.nodeid
            lineno: n.lineno
            colno: n.colno
            width: 1
        )
        return ztypes.noConst
    } case dottedpath then {
        cn9: String
        {
            chn9: ast.nodes.get i: n.child.u64
            if chn9.atomid then cn9 = zast.nameTextCopy :ast ref: chn9.name
        }
        if cn9.length == 0 then return ztypes.noConst
        pn9: ast.nodes.get i: n.parent.u64
        pt9: String
        if pn9.atomid then pt9 = zast.nameTextCopy :ast ref: pn9.name
        if pt9.length > 0 then {
            # `1.u32` is a width-suffixed literal, not a member read: the value
            # is the parent's lexeme and the child only names its type.
            if (isNumericLiteralName name: pt9.stringview) then {
                return (constLiteralValue name: pt9.stringview)
            }
            # `unit.CONST` reads a constant out of another unit.
            if (nameDenotesUnit :ty :reg nameId: (nameIdOf :ast name: pt9.stringview)) then {
                return (constValueOfMember
                    :ast
                    :ty
                    :reg
                    unitDecl: (unitDeclOfName :ty :ast name: pt9.stringview)
                    defName: cn9.stringview
                )
            }
            # A nested namespace (`m: unit { NUM: 7 }`) is a definition of THIS
            # unit whose type is a unit; it is deliberately absent from the
            # unit-name index, so its members are read off its type id.
            {
                nso9: (resolvedByIds
                    :ast
                    :ty
                    :unitDecl
                    name: (nameIdOf :ast name: pt9.stringview)
                )
                match (
                    nso9
                ) case some then {
                    nst9: ztypes.tid.create from: nso9
                    if (reg.typetypeOf typeId: nst9) == ztypes.ztypetype.unitType then {
                        nsv9: (constValueOfMemberTid
                            :ast
                            :ty
                            :reg
                            unitTid: nst9
                            defName: cn9.stringview
                        )
                        if (nsv9.kind.none) == false then return nsv9
                    }
                } case none then null
            }
            # A nested unit of the SCOPE being evaluated: not in the unit-name
            # index either, and it resolves on demand, so it may have no id at
            # all until asked for here. The scope is the enclosing namespace
            # while its own members evaluate and the file unit otherwise --
            # rooting this at the file unit alone stopped a re-export chain at
            # its first hop, since a subunit's subunit is no child of the file.
            {
                sro9: unitFrameOf :ty declId: ty.curFrame
                sst9: (nestedUnitTidOf
                    :ty
                    :reg
                    :ast
                    ownerDeclId: sro9
                    nestedNameId: (nameIdOf :ast name: pt9.stringview)
                )
                if (sst9.isZero) == false then {
                    ssv9: (constValueOfMemberTid
                        :ast
                        :ty
                        :reg
                        unitTid: sst9
                        defName: cn9.stringview
                    )
                    if (ssv9.kind.none) == false then return ssv9
                }
            }
            # A same-unit name can be a CONSTANT or a TYPE, and the two read
            # identically: `CC.tcc` asks whether the constant CC holds that arm,
            # `cckind.tcc` names an arm of the type. The constant is asked
            # first because it is the narrower question -- a name is not both,
            # and classifying a constant by its definition's shape would call
            # `CC: cckind.tcc` a variant and read a nonexistent arm off it.
            pcv9: constValueOfMember :ast :ty :reg :unitDecl defName: pt9.stringview
            if pcv9.kind.armKind then {
                cnid0: zast.poolFind pool: ast.names text: cn9.stringview
                if cnid0.isZero then return ztypes.noConst
                return (boolConst9 :ast :ty :reg v: (pcv9.armName == cnid0))
            }
            if pcv9.kind.svalKind then {
                return (constStringDotted
                    :ty
                    v: pcv9
                    name: cn9.stringview
                    nodeid: n.nodeid
                    lineno: n.lineno
                    colno: n.colno
                )
            }
            return (constArmRead
                :ast
                :ty
                :reg
                lookupUnit: unitDecl
                typeName: pt9.stringview
                armName: cn9.stringview
            )
        }
        # `platform.os.linux` -- the ARM-PREDICATE form, asked FIRST for the
        # same reason the atomid case asks the constant first: `tsrc.os` is a
        # constant whose TYPE is a variant, so reading it as a qualified type
        # name would find that variant and answer with an arm where the
        # question was "does it hold this one".
        pv9: evalConstNode :ast :ty :reg :unitDecl n: pn9
        if pv9.kind.armKind then {
            cnid9: zast.poolFind pool: ast.names text: cn9.stringview
            if cnid9.isZero then return ztypes.noConst
            return (boolConst9 :ast :ty :reg v: (pv9.armName == cnid9))
        }
        # a literal receiver (`"abcd".length`) or a qualified constant
        # (`quadfloat.LIB.length`): the parent is not a bare atom, so its value
        # comes from the recursive walk above rather than from a member read.
        if pv9.kind.svalKind then {
            return (constStringDotted
                :ty
                v: pv9
                name: cn9.stringview
                nodeid: n.nodeid
                lineno: n.lineno
                colno: n.colno
            )
        }
        # `platform.oskind.linux` -- an arm of a type reached THROUGH its unit.
        # The parent is a dotted path of its own, so the type must be looked up
        # from that unit rather than from the one being evaluated.
        if pn9.dottedpath then {
            gp9: ast.nodes.get i: pn9.parent.u64
            gc9: ast.nodes.get i: pn9.child.u64
            if gp9.atomid when gc9.atomid then {
                gpt9: zast.nameTextCopy :ast ref: gp9.name
                gct9: zast.nameTextCopy :ast ref: gc9.name
                if gpt9.length > 0 when gct9.length > 0 then {
                    if (nameDenotesUnit
                        :ty
                        :reg
                        nameId: (nameIdOf :ast name: gpt9.stringview)
                    ) then {
                        qa9: (constArmRead
                            :ast
                            :ty
                            :reg
                            lookupUnit: (unitDeclOfNameIdHere :ty nameId: gp9.name)
                            typeName: gct9.stringview
                            armName: cn9.stringview
                        )
                        if (qa9.kind.none) == false then return qa9
                    }
                }
            }
        }
        return ztypes.noConst
    } case binop then {
        lv9: evalConstNode :ast :ty :reg :unitDecl n: (ast.nodes.get i: n.lhs.u64)
        if lv9.kind.none then return ztypes.noConst
        rv9: evalConstNode :ast :ty :reg :unitDecl n: (ast.nodes.get i: n.rhs.u64)
        if rv9.kind.none then return ztypes.noConst
        op9: atomName :ast n: (ast.nodes.get i: n.operator.u64)
        if op9.length == 0 then return ztypes.noConst
        # two tags compare by ARM IDENTITY -- the owning type and the arm's
        # name-pool id -- never by rendered text. Only equality is defined:
        # arms have no order.
        if lv9.kind.armKind when rv9.kind.armKind then {
            same9: false
            if lv9.armTid == rv9.armTid when lv9.armName == rv9.armName then same9 = true
            if op9.stringview == "==" then return (boolConst9 :ast :ty :reg v: same9)
            if op9.stringview == "!=" then return (boolConst9 :ast :ty :reg v: ((same9) == false))
            return ztypes.noConst
        }
        # two string constants compare by their interned TEXT. Only equality is
        # folded: ordering is defined but nothing needs it at compile time yet,
        # and a wrong answer here would be silent.
        if lv9.kind.svalKind when rv9.kind.svalKind then {
            ls9: constStringAt :ty id: lv9.strId
            rs9: constStringAt :ty id: rv9.strId
            eq9: ls9.stringview == rs9.stringview
            if op9.stringview == "==" then return (boolConst9 :ast :ty :reg v: eq9)
            if op9.stringview == "!=" then return (boolConst9 :ast :ty :reg v: ((eq9) == false))
            # `+` BUILDS, so the folded value is the joined text, interned like
            # any other. `A + B + C` folds left to right through this leg with
            # no runtime temporary at any step.
            if op9.stringview == "+" then {
                ls9.append rs9
                return (ztypes.makeStrConst (constInternString :ty text: ls9.stringview))
            }
            return ztypes.noConst
        }
        if lv9.kind.ivalKind when rv9.kind.ivalKind then {
            if (isComparisonOp name: op9.stringview) then {
                return (constCompareInt :ast :ty :reg op: op9.stringview a: lv9.ival b: rv9.ival)
            }
            return (constArithInt
                :ty
                nodeid: n.nodeid
                lineno: n.lineno
                colno: n.colno
                op: op9.stringview
                a: lv9.ival
                b: rv9.ival
            )
        }
        lf9: constFloatOf v: lv9
        rf9: constFloatOf v: rv9
        if lf9.has when rf9.has then {
            if (isComparisonOp name: op9.stringview) then {
                return (constCompareFloat :ast :ty :reg op: op9.stringview a: lf9.val b: rf9.val)
            }
            return (constArithFloat op: op9.stringview a: lf9.val b: rf9.val)
        }
        return ztypes.noConst
    } case call then {
        # `error "..."` in constant position is the program asserting. Only the
        # WINNING branch of a fold is ever evaluated, so an `error` in a dead
        # one is never visited -- which is why this lives in the evaluator and
        # not in a tree walk, and why the spec can promise that a statically
        # false branch's error goes unreported.
        # A static method on a string constant is a CALL whose callable is a
        # dotted path, so atomName is "" for it and the `error` test below would
        # bail before ever looking at the receiver. Intercept first.
        {
            cnode9: ast.nodes.get i: n.callable.u64
            if cnode9.dottedpath then {
                rcv9: (evalConstNode
                    :ast
                    :ty
                    :reg
                    :unitDecl
                    n: (ast.nodes.get i: cnode9.parent.u64)
                )
                if rcv9.kind.svalKind then {
                    mnc9: atomName :ast n: (ast.nodes.get i: cnode9.child.u64)
                    if mnc9.length > 0 then {
                        return (constStringMethod
                            :ast
                            :ty
                            :reg
                            :unitDecl
                            args: n.arguments
                            recv: rcv9
                            name: mnc9.stringview
                            nodeid: n.nodeid
                            lineno: n.lineno
                            colno: n.colno
                        )
                    }
                }
            }
        }
        cbn9: atomName :ast n: (ast.nodes.get i: n.callable.u64)
        if cbn9.stringview != "error" then return ztypes.noConst
        umsg9: "compile-time error".string
        with ait9: n.arguments.iterate do for aId9: ait9 loop {
            an9: ast.nodes.get i: aId9.u64
            match (
                an9
            ) case namedoperation then {
                av9: (evalConstNode
                    :ast
                    :ty
                    :reg
                    :unitDecl
                    n: (ast.nodes.get i: an9.operation.u64)
                )
                if av9.kind.svalKind then umsg9 = constStringAt :ty id: av9.strId
            } else null
        }
        (constFailRecord
            :ty
            kind: ztypes.constfailkind.reachedError
            nodeid: n.nodeid
            lineno: n.lineno
            colno: n.colno
            width: 5
            strId: (constInternString :ty text: umsg9.stringview)
        )
        return ztypes.noConst
    } case ifexpr then {
        fb9: foldIfBranch :ast :ty :reg :unitDecl :n
        if (fb9.known) == false then return ztypes.noConst
        if fb9.stmt.isZero then return ztypes.noConst
        return (constBlockValue
            :ast
            :ty
            :reg
            :unitDecl
            block: (ast.nodes.get i: fb9.stmt.u64)
        )
    } else {
        return ztypes.noConst
    }
}

# reportUnitConstantShape -- the diagnostic for a unit-level definition whose
# value is not a literal. Unit constants inline literal numeric values BY
# DESIGN (resolveConstantDef registers the literal, suffixed-literal and
# constant-expression shapes only); without a report the definition registers
# nothing and every downstream read blames the reader instead.
reportUnitConstantShape: function {
    ty: ztyping.ZTyping
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u32
    msg: String
    hint: String
} is {
    un9: "unit constants inline literal numeric values".string
    ty.errors.append (zast.ErrorData
        :nodeid
        :lineno
        :colno
        :width
        err: zast.err.typeError
        msg: msg.copy
        fsno: zvfs.fsno
        note: un9
        hint: hint.copy
    )
    ty.isError = true
}

# reportUnitConstantRef -- the callee of a unit-level construction names
# nothing in scope. Reporting a malformed CONSTANT there blames the shape of a
# definition whose callee does not exist; the reference is what is wrong. The
# usual way here is a dependency unit naming a main-unit definition, which the
# language does not allow for a constant or a namespace either.
reportUnitConstantRef: function {
    ty: ztyping.ZTyping
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    width: u32
    msg: String
} is {
    en9: String
    eh9: String
    ty.errors.append (zast.ErrorData
        :nodeid
        :lineno
        :colno
        :width
        err: zast.err.badReference
        msg: msg.copy
        fsno: zvfs.fsno
        note: en9
        hint: eh9
    )
    ty.isError = true
}

# resolveConstantDef -- one definition: an (expression-wrapped) numeric-literal
# atomid is a unit constant. Record resolved[unit.name] as the literal's concrete
# default (i64 / f64, which materialiseLiteral demands). The definition's
# own nodes stay unstamped: the oracle's stamps there carry its unregistered
# literal pseudo-type (NULL in the dump), invisible to every projection.
resolveConstantDef: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    defName: StringView
    defn: Node.view
} is {
    match (
        defn
    ) case expression then {
        (resolveUnitIfDef
            :ast
            :ty
            :reg
            :unitDecl
            :defName
            wrapperId: defn.nodeid
            n: (ast.nodes.get i: defn.expression.u64)
        )
        iexL9: ast.nodes.get i: defn.expression.u64
        resolveConstantDef :ast :ty :reg :unitDecl :defName defn: iexL9
    } case dottedpath then {
        # a width-suffixed numeric literal (`1.u32`) is a dotted path over the
        # literal, not an atom: the child names the constant's type
        sfLit9: String
        sfTy9: String
        {
            sfB9: ast.nodes.get i: defn.parent.u64
            if sfB9.atomid then sfLit9 = zast.nameTextCopy :ast ref: sfB9.name
        }
        {
            sfC9: ast.nodes.get i: defn.child.u64
            if sfC9.atomid then sfTy9 = zast.nameTextCopy :ast ref: sfC9.name
        }
        if sfLit9.length > 0 when sfTy9.length > 0 then {
            # `origin: Point.create x: 0` parses as TWO unit members -- the
            # dotted value `Point.create` and a separate constant `x: 0` --
            # so the construction never reaches this pass as a call. A dotted
            # value is a suffixed literal (`1.u32`) or the unit-alias form
            # (`Node: zast.Node`, whose parent names a UNIT and which
            # resolveDef registers); anything else is a member read on a type.
            if (isNumericLiteralName name: sfLit9.stringview) == false then {
                # `false: bool.false` reads a variant ARM -- a compile-time
                # value, and the shape core.z uses 41 times. A FUNCTION member
                # (`Point.create`) is a runtime construction instead, which a
                # unit constant cannot hold.
                # The parent's FAMILY decides: a variant or union parent means
                # the child is an ARM -- a compile-time value. Any other family
                # means a member read or a construction. `declDefTypetype`
                # classifies a definition without resolving it, which is what
                # reaches a SAME-UNIT type at this stage; the typeref walk
                # answers for the resolvable ones.
                isCtor9: false
                if (nameDenotesUnit
                    :ty
                    :reg
                    nameId: (nameIdOf :ast name: sfLit9.stringview)
                ) == false then {
                    ptt9: ztypes.ztypetype.nullType
                    known9: false
                    {
                        pdc9: declOfUnitDef :ty :ast :unitDecl name: sfLit9.stringview
                        if (pdc9.isZero) == false then {
                            pdt9: declDefTypetype :ty :ast declId: pdc9
                            match (
                                pdt9
                            ) case some then {
                                ptt9 = pdt9
                                known9 = true
                            } case none then null
                        }
                    }
                    if (known9) == false then {
                        pTo9: (walkLookupTyperef
                            :ast
                            :ty
                            :reg
                            :unitDecl
                            base: sfLit9.stringview
                        )
                        match (
                            pTo9
                        ) case some then {
                            ptt9 = reg.typetypeOf typeId: (ztypes.tid.create from: pTo9.u64)
                            known9 = true
                        } case none then null
                    }
                    if known9 then {
                        isCtor9 = true
                        if ptt9 == ztypes.ztypetype.variantType then isCtor9 = false
                        if ptt9 == ztypes.ztypetype.unionType then isCtor9 = false
                        # `sub.NAME` where the parent is a UNIT reads a member
                        # of it, which is what every cross-unit re-export is;
                        # only a TYPE parent makes the read a construction.
                        if ptt9 == ztypes.ztypetype.unitType then isCtor9 = false
                    }
                }
                # ASK THE CONSTANT FIRST. `LEN: LIB.length` reads a member of
                # a string CONSTANT, and LIB's own type is StringView -- a
                # class -- so the typeref walk above finds a non-variant parent
                # and calls the read a construction. The value settles it.
                if isCtor9 then {
                    pcs9: (constValueOfMember
                        :ast
                        :ty
                        :reg
                        :unitDecl
                        defName: sfLit9.stringview
                    )
                    if pcs9.kind.svalKind then isCtor9 = false
                }
                if isCtor9 then {
                    dm9: "a unit-level constant takes a literal value, not a construction".string
                    dh9: "construct it inside a function, or make '\{defName}' a function that returns the value"
                    (reportUnitConstantShape
                        :ty
                        nodeid: defn.nodeid
                        lineno: defn.lineno
                        colno: defn.colno
                        width: sfLit9.length.u32.orPanic
                        msg: dm9
                        hint: dh9
                    )
                }
            }
            if (isNumericLiteralName name: sfLit9.stringview) then {
                # `wkFirst: 1.nid` NAMES its type, so asking for the constant
                # is asking for that type: descend for it rather than only
                # looking it up, or a typedef nothing else references is
                # unresolved at the moment the constant needs it and the
                # value's own i64 registers in its place.
                sfT9: walkLookupTyperef :ast :ty :reg :unitDecl base: sfTy9.stringview
                if sfT9.none then {
                    sfD9: descendNamed :ty :reg :ast :unitDecl name: sfTy9.stringview
                    if sfD9 > 0 then sfT9 = optionval.some sfD9.u64
                }
                match (
                    sfT9
                ) case some then {
                    # keyed on the constant's OWNER -- the namespace, block or
                    # file unit it is written in -- as the value channel keys
                    # it, not on the file unit by name (which leaked a nested
                    # unit's constant into the file unit's index)
                    sfU9: (declTypeIdOf
                        :ty
                        declId: (constOwnerDeclFor :ast :ty :unitDecl :defName)
)
                    if (sfU9.isZero) == false then {
                        (ty.setMemberType
                            parentTypeId: sfU9
                            nameId: (zast.poolFind pool: ast.names text: defName)
                            childTypeId: sfT9
                        )
                    }
                } case none then null
            }
        }
    } case atomid then {
        dfN9: zast.nameTextAt :ast ref: defn.name
        if (isNumericLiteralName name: dfN9.stringview) then {
            base: "i64"
            if (isFloatLiteralName name: dfN9.stringview) then base = "f64"
            tOpt: walkLookupTyperef :ast :ty :reg :unitDecl :base
            match (
                tOpt
            ) case some then {
                cu: (declTypeIdOf
                    :ty
                    declId: (constOwnerDeclFor :ast :ty :unitDecl :defName)
)
                if (cu.isZero) == false then {
                    (ty.setMemberType
                        parentTypeId: cu
                        nameId: (zast.poolFind pool: ast.names text: defName)
                        childTypeId: tOpt
                    )
                }
            } case none then null
        }
        # a NON-numeric bare name is the unit-level alias form (`Same: Holder`),
        # which resolveDef registers -- it is not this pass's business.
    } else {
        # A construction is not a literal. `origin: Point.create x: 0` used to
        # register nothing and report nothing. The PARENTHESISED call is the
        # generic-unit instantiation form (`intmath: (genmath t: i64)`) and
        # stays legal -- its callee names a UNIT, which is the test here; the
        # definition arms (functiondef, objectdef, unitdef, datablock) reach
        # this leg too and must never be reported.
        match (
            defn
        ) case call then {
            ccn9: ast.nodes.get i: defn.callable.u64
            cbn9: atomName :ast n: ccn9
            if cbn9.length == 0 then cbn9 = dottedRootName :ast n: ccn9
            if cbn9.length > 0 then {
                # a unit declared in THIS file has no registry entry yet, and
                # a generic-unit binding is no file unit at all: the Decl tree
                # answers both -- without it every `intmath: (mathops t: i64)`
                # reads as a construction.
                cbu9: nameDenotesUnit :ty :reg nameId: (nameIdOf :ast name: cbn9.stringview)
                if (cbu9) == false then {
                    # the same scope walk the instantiation collector uses --
                    # this namespace, each enclosing one, the unit root, then a
                    # file unit of that name. declOfUnitDef reached only a
                    # TOP-LEVEL binding of this unit, so a template nested in a
                    # namespace, or named through another unit, read as a
                    # construction and was reported as a malformed constant.
                    cscp9: unitFrameOf :ty declId: ty.curFrame
                    csg9: (ListVal u64)
                    instCallablePath :ast op: ccn9 segs: csg9
                    cdc9: instTemplateDecl :ty scopeDeclId: cscp9 segs: csg9
                    if (cdc9.isZero) == false then {
                        cdo9: ty.decls.get i: cdc9.u64
                        if cdo9.kind.unitDecl then cbu9 = true
                    }
                }
                # ASK THE CONSTANT FIRST, the same ordering the dotted-path
                # value read uses: `CT: (LIB.contains needle: "x")` is a call
                # whose receiver is a string CONSTANT, so it is a value and not
                # a construction. Classifying by the callee's shape alone calls
                # every static string method a construction.
                if (cbu9) == false then {
                    crv9: (constValueOfMember
                        :ast
                        :ty
                        :reg
                        :unitDecl
                        defName: cbn9.stringview
                    )
                    if crv9.kind.svalKind then cbu9 = true
                }
                if (cbu9) == false then {
                    ckn9: false
                    {
                        cko9: (walkLookupTyperef
                            :ast
                            :ty
                            :reg
                            :unitDecl
                            base: cbn9.stringview
                        )
                        match (
                            cko9
                        ) case some then {
                            ckn9 = true
                        } case none then null
                    }
                    if (ckn9) == false then {
                        crm9: "Unknown reference '\{cbn9}'"
                        (reportUnitConstantRef
                            :ty
                            nodeid: defn.nodeid
                            lineno: defn.lineno
                            colno: defn.colno
                            width: cbn9.length.u32.orPanic
                            msg: crm9
                        )
                        cbu9 = true
                    }
                }
                if (cbu9) == false then {
                    cm9: "a unit-level constant takes a literal value, not a construction".string
                    ch9: "construct it inside a function, or make '\{defName}' a function that returns the value"
                    (reportUnitConstantShape
                        :ty
                        nodeid: defn.nodeid
                        lineno: defn.lineno
                        colno: defn.colno
                        width: cbn9.length.u32.orPanic
                        msg: cm9
                        hint: ch9
                    )
                }
            }
        } else null
        if (isBinopNode n: defn) then {
            # A constant expression (`COMBINED: OFFSET + SCALE`): the operand
            # walk stamps the refs and the binop; a literal result materialises
            # to its default, a concrete one (an already-materialised constant)
            # keeps it.
            bt: constantOperandType :ast :ty :reg :unitDecl n: defn
            base2: ""
            if bt == reg.literalIntTid then base2 = "i64"
            if bt == reg.literalFloatTid then base2 = "f64"
            if base2.length > 0 then {
                mOpt: walkLookupTyperef :ast :ty :reg :unitDecl base: base2
                match (
                    mOpt
                ) case some then {
                    cu2: (declTypeIdOf
                        :ty
                        declId: unitDecl
                    )
                    if (cu2.isZero) == false then {
                        (ty.setMemberType
                            parentTypeId: (ztypes.tid.create from: cu2.u64)
                            nameId: (zast.poolFind pool: ast.names text: defName)
                            childTypeId: mOpt
                        )
                    }
                } case none then null
            } else {
                if bt > 0 then {
                    cu3: (declTypeIdOf
                        :ty
                        declId: unitDecl
                    )
                    if (cu3.isZero) == false then {
                        (ty.setMemberType
                            parentTypeId: (ztypes.tid.create from: cu3.u64)
                            nameId: (zast.poolFind pool: ast.names text: defName)
                            childTypeId: bt
                        )
                    }
                }
            }
        }
    }
}

# constRegisterValueType -- give a constant the type of its VALUE, for the
# shapes the shape-driven pass registers nothing for: a string literal, a
# concatenation, and any of the static string methods (`LIB.length` is an i64,
# `LIB.startsWith ...` a bool). A constant IS its value, so its type is the
# value's.
#
# A folded string types as StringView, never String, whatever produced it. The
# fold replaces the call outright and the value materialises as a static view
# -- nothing is allocated and nothing is owned -- so typing it String would
# hand a use site an owned type backed by a static. `+`'s declared `out String`
# governs the RUN-TIME path only.
#
# The shape-driven registrations win wherever they spoke: they know about
# typedefs and literal suffixes that a value does not carry.
constRegisterValueType: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    unitDecl: ztypes.declid
    defName: StringView
    v: ztypes.cval
} is {
    if v.kind.none then return
    nid0: zast.poolFind pool: ast.names text: defName
    if nid0.isZero then return
    (constRegisterValueTypeAt
        :ast
        :ty
        :reg
        ownerDecl: (constOwnerDeclFor :ast :ty :unitDecl :defName)
        nameId: nid0
        :v
    )
}

# constRegisterValueTypeAt -- the registration itself, addressed by the owner's
# declaration. A constant's type is the one its VALUE carries, so this is where
# a constant becomes a member of its owner at all.
constRegisterValueTypeAt: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ownerDecl: ztypes.declid
    nameId: zast.nameid
    v: ztypes.cval
} is {
    if v.kind.none then return
    utid9: declTypeIdOf :ty declId: ownerDecl
    if utid9.isZero then return
    nid9: nameId
    if nid9.isZero then return
    {
        eo9: ty.declChildOfId parentTypeId: utid9 nameId: nid9
        if (eo9.none) == false then return
    }
    if v.kind.armKind then {
        if v.armTid.isZero then return
        (ty.setMemberType
            parentTypeId: utid9
            nameId: nid9
            childTypeId: v.armTid.u64
        )
        return
    }
    base9: ""
    if v.kind.ivalKind then base9 = "i64"
    if v.kind.fvalKind then base9 = "f64"
    if v.kind.svalKind then base9 = "StringView"
    if base9.length == 0 then return
    # the constant's type is a reference to a system type: it resolves on
    # discovery, like every other reference, so the registration never depends
    # on some other reference having resolved the type first
    bo9: descendNamed :ty :reg :ast unitDecl: ty.systemUnitRoot name: base9
    if bo9 > 0 then ty.setMemberType parentTypeId: utid9 nameId: nid9 childTypeId: bo9.u64
}

# constFoldDecl -- fold the constant `declId` declares and register the type its
# value carries, addressed by the DECLARATION alone. This is the door a lookup
# takes when it finds a constant that has not folded yet: a constant's TYPE
# comes from its VALUE, so the fold is what declares it, exactly as an
# unresolved re-export is declared by following its alias.
constFoldDecl: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    declId: ztypes.declid
} is {
    if declId.isZero then return
    own9: declParentIdOf :ty :declId
    if own9.isZero then return
    nm9: declNameIdOf :ty :declId
    if nm9.isZero then return
    dnode9: 0
    {
        do9: ty.decls.get i: declId.u64
        dnode9 = do9.node
    }
    if dnode9 == 0 then return
    # both names are COPIED: the fold takes an exclusive lock on ast.names,
    # which a live view into the pool would hold open
    unm9: unitRootOfDecl :ty :declId
    if unm9.isZero then return
    nmt9: zast.poolTextCopy pool: ast.names ref: nm9
    constFailClear :ty
    v9: (constValueOfMemberAt
        :ast
        :ty
        :reg
        unitDecl: unm9
        ownerDecl: own9
        nameId: nm9
        defNodeId: dnode9
        defName: nmt9.stringview
    )
    (constRegisterValueTypeAt
        :ast
        :ty
        :reg
        ownerDecl: own9
        nameId: nm9
        v: v9
    )
    reportPendingConstFail :ty
}

# resolveConstantMember -- one unit-level definition's constant channels, both
# of them. The TYPE channel is shape-driven (`resolveConstantDef` registers the
# literal, suffixed-literal and constant-expression forms and reports the ones
# that are neither); the VALUE channel evaluates and memoises, and hands its
# result back so a value-typed constant -- a string, a concatenation, an arm --
# registers the type its value carries.
#
# Source order drives the visit but not the evaluation: each pull descends into
# whatever it names and memoises, so a definition already reached as a
# dependency is a no-op here and one written before its dependency still works.
# That is what lets the same entry point serve the demand path and the eager
# walk without the two drifting.
resolveConstantMember: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    unitDecl: ztypes.declid
    defName: StringView
    defn: Node
} is {
    constFailClear :ty
    resolveConstantDef :ast :ty :reg :unitDecl :defName :defn
    cvv9: constValueOfMember :ast :ty :reg :unitDecl :defName
    constRegisterValueType :ast :ty :reg :unitDecl :defName v: cvv9
    reportPendingConstFail :ty
}

# resolve a unit's compile-time constant definitions.
resolveConstantDefsInUnit: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    unitDecl: ztypes.declid
    unitdefId: zast.nodeid
} is {
    rd9: ztypes.declid
    {
        ro9: unitDecl
        if (ro9.isZero) == false then rd9 = ro9
    }
    (resolveConstantDefsIn
        :ast
        :ty
        :reg
        :unitDecl
        :unitdefId
        ownerDeclId: rd9
    )
}

# resolveConstantDefsIn -- the walk resolveConstantDefsInUnit drives, once for
# the file unit and once for each namespace or template nested in it, with
# the cursor at `ownerDeclId`: a nested unit's constants key on that unit
# (constOwnerDeclFor walks the cursor's frames), the file unit's on the unit.
resolveConstantDefsIn: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    unitDecl: ztypes.declid
    unitdefId: zast.nodeid
    ownerDeclId: ztypes.declid
} is {
    if (ty.nsConstsWalked.has item: unitdefId.u64) then return
    ty.nsConstsWalked.add item: unitdefId.u64
    prevFrame9: ty.curFrame
    if (ownerDeclId.isZero) == false then ty.curFrame = ownerDeclId
    bodyIds9: zast.unitBodyIdsAt :ast unitId: unitdefId
    {
        biter: bodyIds9.iterate
        for bm: biter loop {
            bmNode9: ast.nodes.get i: bm.u64
            match (
                bmNode9
            ) case namedoperation then {
                defName: zast.nameTextAt :ast ref: bmNode9.name
                isNs9: false
                if (zast.unitOpKindIs
                    :ast
                    opId: bmNode9.operation
                    k: zast.unitkind.namespace
                ) then isNs9 = true
                if (zast.unitOpKindIs
                    :ast
                    opId: bmNode9.operation
                    k: zast.unitkind.subunit
                ) then isNs9 = true
                # a generic template's constants are its own too, keyed on the
                # template's id (the def-node stamp resolveInlineGenericUnit
                # lays); a template nothing resolved yet has none to key on
                # and is skipped, and its members' demand resolves them
                if (zast.unitOpKindIs
                    :ast
                    opId: bmNode9.operation
                    k: zast.unitkind.template
                ) then isNs9 = true
                if (zast.unitOpKindIs
                    :ast
                    opId: bmNode9.operation
                    k: zast.unitkind.publicNs
                ) then isNs9 = true
                if isNs9 then {
                    ct9: ztypes.tid
                    {
                        un9: unitdefNodeId :ast nId: bmNode9.operation
                        if (un9.isZero) == false then {
                            ct9 = (ztypes.tid.create
                                from: (ztyping.nodeTypeAt tbl: ty.nodeType nid: un9.u64)
                            )
                        }
                    }
                    if (ct9.isZero) == false then {
                        (resolveConstantDefsIn
                            :ast
                            :ty
                            :reg
                            :unitDecl
                            unitdefId: bmNode9.operation
                            ownerDeclId: (ty.declFindChild
                                parentDeclId: ownerDeclId
                                nameId: bmNode9.name
                            )
                        )
                    }
                } else if defName.length > 0 then {
                    # a template's generic PARAMETER (`t: anyval.generic`,
                    # `cap: u32.generic`) is a parameter, not a constant; a
                    # `public:` block's reference entry is an edge to a
                    # sibling, whose own unit resolves it
                    isEdge9: false
                    {
                        ed9: ty.declFindChild parentDeclId: ownerDeclId nameId: bmNode9.name
                        edp9: declParentIdOf :ty declId: ed9
                        if (ed9.isZero) == false when edp9 != ownerDeclId then isEdge9 = true
                    }
                    if (isEdge9) == false when (isGenericParam
                        :ast
                        op: (ast.nodes.get i: bmNode9.operation.u64)
                    ) == false then {
                        (resolveConstantMember
                            :ast
                            :ty
                            :reg
                            :unitDecl
                            defName: defName.stringview
                            defn: (ast.nodes.get i: bmNode9.operation.u64)
                        )
                    }
                }
            } else null
        }
    }
    ty.curFrame = prevFrame9
}

# ccKindArm -- the `cckind` arm a resolved compiler PATH names, by basename.
# By name alone: probing --version would put a subprocess in every compile, so
# a --cc pointing at a wrapper script reads as `other` and a guard keyed on one
# compiler will not fire for it. `tcc` is tested before `cc` and `clang` before
# `gcc`, since the shorter spelling is a substring of paths naming the longer.
ccKindArm: function {ccPath: StringView} out String is {
    b9: ccPath
    i9: ccPath.length
    for i9 > 0 loop {
        i9 = i9 - 1
        ch9: ccPath.byteAt i9
        match (
            ch9
        ) case some then {
            if ch9 == 47 then {
                b9 = ccPath.substring from: (i9 + 1) to: ccPath.length
                i9 = 0
            }
        } case none then null
    }
    if (b9.contains needle: "tcc") then return "tcc".string
    if (b9.contains needle: "clang") then return "clang".string
    if (b9.contains needle: "gcc") then return "gcc".string
    return "other".string
}

# seedPlatformConsts -- fill the `platform` unit in for THIS build.
#
# The file on disk carries defaults so the seed compiler can build a working
# zc from a clean checkout; those defaults describe nothing in particular. The
# real values are known only here, so they are written straight onto the
# member-constant table and the definitions on disk are marked evaluated so
# nothing reads them back.
#
# A no-op when the unit was never loaded, which is every program that does not
# mention `platform`.
seedPlatformConsts: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
} is {
    ptid9: unitTidOfName9 :ty unitNameId: (nameIdOf :ast name: "platform")
    if ptid9.isZero then return
    # the seeds are platform's own definitions, so they resolve in its frame
    prevFrame9: ty.curFrame
    {
        pro9: ty.declFindChild parentDeclId: ty.programRoot nameId: (nameIdOf :ast name: "platform")
        if (pro9.isZero) == false then ty.curFrame = pro9
    }
    # os/arch describe what the build is FOR: the --target triple decides when
    # one is given, and the host the compiler runs on otherwise. A cross --cc
    # used WITHOUT --target therefore leaves these describing the host, which
    # the docs say plainly -- the preprocessor path they replaced could not be
    # wrong that way, because it ran inside the C compiler doing the targeting.
    osn9: os.hostOsName
    arn9: os.hostArchName
    if ty.targetTriple.length > 0 then {
        tv9: ty.targetTriple.stringview
        if (tv9.contains needle: "linux") then osn9 = "linux".string
        if (tv9.contains needle: "darwin") then osn9 = "darwin".string
        if (tv9.contains needle: "apple") then osn9 = "darwin".string
        if (tv9.contains needle: "windows") then osn9 = "windows".string
        if (tv9.contains needle: "x86_64") then arn9 = "x86_64".string
        if (tv9.contains needle: "aarch64") then arn9 = "aarch64".string
    }
    (seedPlatformArm
        :ast
        :ty
        :reg
        :ptid9
        member: "os"
        typeName: "oskind"
        armName: osn9.stringview
    )
    (seedPlatformArm
        :ast
        :ty
        :reg
        :ptid9
        member: "arch"
        typeName: "archkind"
        armName: arn9.stringview
    )
    ty.curFrame = prevFrame9
    cka9: ccKindArm ccPath: ty.ccPath.stringview
    (seedPlatformArm
        :ast :ty :reg :ptid9
        member: "cc"
        typeName: "cckind"
        armName: cka9.stringview
    )
    # the mode needs no classifier: it arrives as an arm name already, having
    # been validated at the flag. An unset one seeds nothing, leaving the
    # on-disk default -- which is `spawn`, the same answer.
    (seedPlatformArm
        :ast :ty :reg :ptid9
        member: "ccmode"
        typeName: "ccmodekind"
        armName: ty.ccMode.stringview
    )
    (seedPlatformValue
        :ty
        :ptid9
        :ast
        member: "target"
        value: (ztypes.makeStrConst (constInternString :ty text: ty.targetTriple.stringview))
    )
}

# seedPlatformArm -- one platform member, as an arm of one of its kinds.
seedPlatformArm: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    ptid9: ztypes.tid
    member: StringView
    typeName: StringView
    armName: StringView
} is {
    v9: (constArmRead
        :ast
        :ty
        :reg
        lookupUnit: (unitDeclOfName :ty :ast name: "platform")
        :typeName
        :armName
    )
    if v9.kind.none then return
    (seedPlatformValue :ty :ptid9 :ast :member value: v9)
}

# seedPlatformValue -- record the value and mark the member EVALUATED, so the
# on-demand walk returns this instead of folding the placeholder on disk.
seedPlatformValue: function {
    ty: ztyping.ZTyping
    ptid9: ztypes.tid
    ast: Ast
    member: StringView
    value: ztypes.cval
} is {
    nid9: zast.poolFind pool: ast.names text: member
    if nid9.isZero then return
    ty.setMemberConst parentTypeId: ptid9 nameId: nid9 :value
    ty.constEvalState.set key: (ty.memberConstKey parentTypeId: ptid9 nameId: nid9) value: 2.u8
}

# resolveConstantDefs -- materialise every unit's constant definitions the way
# the oracle resolves them on first name lookup, so a constant is a member of
# the unit that declares it and `unit.NAME` resolves across units the way
# `unit.fn` does. Runs post-demand so the numeric defaults are already resolved.
resolveConstantDefs: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    program: Node
} is {
    # the eager tier's answer to "what are this program's constants": every
    # definition of every unit, so one nothing references is still checked.
    # The lazy tier resolves a constant where it is demanded, in
    # resolveDemandedDecl, and this walk does not run at all.
    if (ty.eagerAll) == false then return
    match (
        program
    ) case program then {
        # stage (unit name, unit body) first: the call below takes an exclusive
        # lock on program.ast, which cannot run while the unit-row iteration
        # holds a shared one
        unms9: (List String)
        uops9: (ListVal u32)
        {
            uiter: program.ast.units.iterate
            for uId9: uiter loop {
                u: program.ast.nodes.get i: uId9.u64
                match (
                    u
                ) case namedoperation then {
                    nm: zast.poolTextAt pool: program.ast.names ref: u.name
                    if nm.length > 0 then {
                        unms9.append nm.copy
                        uop9: u.operation
                        uops9.append uop9
                    }
                } else null
            }
        }
        ui9: u64
        un9: unms9.length
        for ui9 < un9 loop {
            unm9: unms9.get i: ui9
            (resolveConstantDefsInUnit
                :ty
                :reg
                ast: program.ast
                unitDecl: (unitDeclOfName :ty ast: program.ast name: unm9.stringview)
                unitdefId: (zast.nodeid.create from: (uops9.get i: ui9))
            )
            ui9 = ui9 + 1
        }
    } else null
}

# unitHasYieldFn -- any function member of this unit whose body suspends.
unitHasYieldFn: function {ast: Ast.view unitdefId: zast.nodeid} out bool is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: unitdefId
    biter: bodyIds9.iterate
    for bm: biter loop {
        bmNode9: ast.nodes.get i: bm.u64
        if bmNode9.namedoperation then {
            if (zgenerator.fnBodyHasYield
                :ast
                n: (ast.nodes.get i: bmNode9.operation.u64)
            ) then return true
            if (objectHasYieldMethod
                :ast
                n: (ast.nodes.get i: bmNode9.operation.u64)
            ) then return true
        }
    }
    return false
}

# objectHasYieldMethod -- any is/as member of an object definition whose
# body suspends.
objectHasYieldMethod: function {ast: Ast.view n: Node.view} out bool is {
    match (
        n
    ) case objectdef then {
        aiter: n.asItems.iterate
        for amId9: aiter loop {
            am: ast.nodes.get i: amId9.u64
            match (
                am
            ) case namedoperation then {
                if (zgenerator.fnBodyHasYield
                    :ast
                    n: (ast.nodes.get i: am.operation.u64)
                ) then return true
            } else null
        }
        iiter: n.isItems.iterate
        for imId9: iiter loop {
            im: ast.nodes.get i: imId9.u64
            match (
                im
            ) case namedoperation then {
                if (zgenerator.fnBodyHasYield
                    :ast
                    n: (ast.nodes.get i: im.operation.u64)
                ) then return true
            } else null
        }
        return false
    } else {
        return false
    }
}

# resolveNamedDefsIn -- resolve exactly the named top-level defs of one
# unit. The generator pass runs pre-index (no node finder, no descent), so
# it walks the unitdef it already holds instead of the demand machinery.
resolveNamedDefsIn: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    unitdefId: zast.nodeid
    wantA: StringView
    wantB: StringView
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: unitdefId
    {
        biter: bodyIds9.iterate
        for bm: biter loop {
            bmNode9: ast.nodes.get i: bm.u64
            match (
                bmNode9
            ) case namedoperation then {
                dn: zast.nameTextAt :ast ref: bmNode9.name
                hit: false
                if dn.stringview == wantA then hit = true
                if dn.stringview == wantB then hit = true
                if hit then {
                    if (defWasResolved
                        :ty
                        :unitDecl
                        nameId: bmNode9.name
                    ) == false then {
                        (resolveDef
                            :ty
                            :reg
                            :ast
                            :unitDecl
                            defName: dn.stringview
                            defn: (ast.nodes.get i: bmNode9.operation.u64)
                        )
                    }
                }
            } else null
        }
    }
}

# lowerGenerators -- the generator lowering pass (the reference's
# _lower_generators): for each unit, rewrite every yield-function whose
# declared return head resolves to the stdlib Iterator protocol into a
# synth iterator class + a factory. Runs before main-unit resolution so
# the rewritten definitions flow through the normal walk; the Iterator
# protocol resolves through a targeted demand only when a suspending
# function exists, so non-generator programs never touch it.
lowerGenerators: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    program: Node
} is {
    match (
        program
    ) case program then {
        anyYield: false
        uCnt9e: program.ast.units.length
        uIdx9e: u64
        for uIdx9e < uCnt9e loop {
            yuId9: (zast.nodeid.create from: (program.ast.units.get i: uIdx9e))
            uIdx9e = uIdx9e + 1
            yOpId9: zast.nodeid
            {
                yu: program.ast.nodes.get i: yuId9.u64
                if yu.namedoperation then yOpId9 = yu.operation
            }
            if yOpId9 > 0 then {
                if (unitHasYieldFn
                    ast: program.ast
                    unitdefId: yOpId9
                ) then anyYield = true
            }
        }
        if (anyYield) == false then return
        suN0: program.ast.units.length
        suI0: u64
        for suI0 < suN0 loop {
            suId9: (zast.nodeid.create from: (program.ast.units.get i: suI0))
            suI0 = suI0 + 1
            sOpId9: zast.nodeid
            {
                su: program.ast.nodes.get i: suId9.u64
                if su.namedoperation then {
                    snm: zast.poolTextAt pool: program.ast.names ref: su.name
                    if snm.stringview == "system" then sOpId9 = su.operation
                }
            }
            if sOpId9 > 0 then {
                (resolveNamedDefsIn
                    :ty
                    :reg
                    ast: program.ast
                    unitDecl: ty.systemUnitRoot
                    unitdefId: sOpId9
                    wantA: "Iterator"
                    wantB: "optionval"
                )
            }
        }
        sysU9: nameIdOf ast: program.ast name: "system"
        sysI9: zast.poolFind pool: program.ast.names text: "Iterator"
        iterTid: (optU64Or
            o: (resolvedByIds
                ast: program.ast
                :ty
                unitDecl: (unitDeclOfNameId :ty nameId: sysU9)
                name: sysI9
            )
            d: 0
        )
        if iterTid == 0 then return
        ui: u64
        un: program.ast.units.length
        for ui < un loop {
            uelId9: (zast.nodeid.create from: (program.ast.units.get i: ui))
            ui = ui + 1
            uOpId9: zast.nodeid
            uNm9: zast.nameid
            {
                uel: program.ast.nodes.get i: uelId9.u64
                if uel.namedoperation then {
                    uOpId9 = uel.operation
                    uNm9 = uel.name
                }
            }
            if uOpId9 > 0 then {
                (lowerGeneratorsInUnit
                    :ty
                    ast: program.ast
                    unitNameId: uNm9
                    unitdefId: uOpId9
                )
            }
        }
    } else null
}

# lowerGeneratorsInUnit -- candidates collect first (indexes + names),
# then each lowers by index: the functiondef moves out of its
# namedoperation slot, the factory moves in, and the synth class appends
# to the unit body under `{name}_iter`.
lowerGeneratorsInUnit: function {
    ty: ztyping.ZTyping
    ast: Ast
    unitNameId: zast.nameid
    unitdefId: zast.nodeid
} is {
    bodyIds9: zast.unitBodyIdsAt :ast unitId: unitdefId
    {
        cIdx: (ListVal u64)
        bi: u64
        bn: bodyIds9.length
        for bi < bn loop {
            bmId9: bodyIds9.get i: bi
            bm: ast.nodes.get i: bmId9.u64
            isCand: false
            match (
                bm
            ) case namedoperation then {
                if (zgenerator.fnBodyHasYield
                    :ast
                    n: (ast.nodes.get i: bm.operation.u64)
                ) then {
                    hd: zgenerator.returnHeadName :ast n: (ast.nodes.get i: bm.operation.u64)
                    if hd.stringview == "Iterator" then {
                        if (zgenerator.canLowerNow
                            :ast
                            n: (ast.nodes.get i: bm.operation.u64)
                            hasReceiver: false
                        ) then isCand = true
                    }
                }
            } else null
            if isCand then {
                bic: bi
                cIdx.append bic
            }
            bi = bi + 1
        }
        stagedCls: (List Node)
        ci: u64
        cn: cIdx.length
        for ci < cn loop {
            idx: cIdx.get i: ci
            uel2Id9: bodyIds9.get i: idx
            # scope the row view: lowering appends to the table below, and a
            # live row view must not span a growing append
            opId9: zast.nodeid
            dnm: String
            {
                uel2: ast.nodes.get i: uel2Id9.u64
                match (
                    uel2
                ) case namedoperation then {
                    dnm = zast.nameTextCopy :ast ref: uel2.name
                    opId9 = uel2.operation
                } else null
            }
            if opId9 > 0 then {
                sname: "\{dnm}_iter"
                fnNode: zast.tableTake :ast id: opId9
                lowOpt: (zgenerator.lowerOne :ast
                    fn: fnNode
                    synthName: sname.stringview
                    receiverType: ""
                )
                match (
                    lowOpt
                ) case some then {
                    wfid: lowOpt.wrapperNodeId
                    wfv: true
                    ty.generatorWrapper.set key: wfid.u64 value: wfv
                    # the create-param and field-path clones must not stamp:
                    # the reference shares those nodes with the factory, so
                    # each ref carries exactly one stamp.
                    nsi: u64
                    nsn: lowOpt.noStamp.length
                    for nsi < nsn loop {
                        ns0: lowOpt.noStamp.get i: nsi
                        nsk: ns0.u64
                        nsv: true
                        ty.noStampNode.set key: nsk value: nsv
                        nsi = nsi + 1
                    }
                    fac: lowOpt.factory.take
                    facId9: zast.tableAdd :ast n: fac
                    {
                        uel2w: ast.nodes.getMut i: uel2Id9.u64
                        match (
                            uel2w
                        ) case namedoperation then {
                            uel2w.operation = facId9
                        } else null
                    }
                    cls: lowOpt.synthClass.take
                    clsN: (zgenerator.mkNamedOp
                        :ast
                        line: 0
                        col: 0
                        name: sname.stringview
                        op: cls
                    )
                    stagedCls.append clsN
                } case none then null
            }
            ci = ci + 1
        }
        # staged synth classes append after the loop: uel2's element view
        # ends with each iteration, and the list must not grow under it.
        for stagedCls.length > 0 loop {
            sc0: stagedCls.pop
            bodyIds9.append (zast.tableAdd :ast n: sc0)
        }
        # method generators: each object definition's members lower the
        # same way, named {Type}_{method}_iter, with the receiver context.
        # Synth classes stage locally; the double-pop drain preserves order.
        pendingCls: (List Node)
        ogi: u64
        ogn: bodyIds9.length
        for ogi < ogn loop {
            oelId9: bodyIds9.get i: ogi
            oel: ast.nodes.get i: oelId9.u64
            match (
                oel
            ) case namedoperation then {
                tnm: zast.nameTextAt :ast ref: oel.name
                if tnm.length > 0 then {
                    (lowerGeneratorMethods
                        :ast
                        :ty
                        typeName: tnm.stringview
                        defn: (ast.nodes.get i: oel.operation.u64)
                        dst: pendingCls
                    )
                }
            } else null
            ogi = ogi + 1
        }
        revCls: (List Node)
        for pendingCls.length > 0 loop {
            pc0: pendingCls.pop
            revCls.append pc0
        }
        for revCls.length > 0 loop {
            rc0: revCls.pop
            bodyIds9.append (zast.tableAdd :ast n: rc0)
        }
        # the synth members were staged on the working list; write the new
        # tail back into the unit row, whose view is scoped to the write,
        # then index them: the def index was built before this pass ran
        first9: u64
        {
            u9: ast.nodes.getMut i: unitdefId.u64
            if u9.unitdef then {
                wi9: u9.body.length
                first9 = wi9
                wn9: bodyIds9.length
                for wi9 < wn9 loop {
                    nid9: bodyIds9.get i: wi9
                    u9.body.append nid9
                    wi9 = wi9 + 1
                }
            }
        }
        uro9: ty.declFindChild parentDeclId: ty.programRoot nameId: unitNameId
        if (uro9.isZero) == false then {
            ii9: first9
            in9: bodyIds9.length
            for ii9 < in9 loop {
                nid9: bodyIds9.get i: ii9
                ii9 = ii9 + 1
                nop9: ast.nodes.get i: nid9.u64
                if nop9.namedoperation then {
                    (indexDeclDef
                        :ty
                        :ast
                        parentDeclId: uro9
                        nameRef: nop9.name
                        nopNodeId: nop9.nodeid
                        opNodeId: nop9.operation
                    )
                }
            }
        }
    }
}

# lowerGeneratorMethods -- lower the generator methods of one object
# definition (as-block first, then is-block), replacing each method with
# its factory in place and appending the synth class to the unit body.
lowerGeneratorMethods: function {
    ast: Ast.view
    ty: ztyping.ZTyping.view
    typeName: StringView
    defn: Node.view
    dst: (List Node).view
} is {
    match (
        defn
    ) case objectdef then {
        lowerGeneratorItems :ast :ty :typeName items: defn.asItems :dst
        lowerGeneratorItems :ast :ty :typeName items: defn.isItems :dst
    } else null
}

# lower every generator function in a unit to its iterator class.
lowerGeneratorItems: function {
    ast: Ast
    ty: ztyping.ZTyping
    typeName: StringView
    items: (ListVal u32).view
    dst: List Node
} is {
    bi: u64
    bn: items.length
    for bi < bn loop {
        isCand: false
        # The candidacy read is scoped so it ENDS before the mutable re-read
        # below begins: `bm` pins ast.nodes shared for as long as it lives, and
        # `bm2` -- the same element, taken to write through -- needs it
        # exclusively. One mutable element reference at a time.
        {
            bmId9: items.get i: bi
            bm: ast.nodes.get i: bmId9.u64
            match (
                bm
            ) case namedoperation then {
                if (zgenerator.fnBodyHasYield
                    :ast
                    n: (ast.nodes.get i: bm.operation.u64)
                ) then {
                    hd: zgenerator.returnHeadName :ast n: (ast.nodes.get i: bm.operation.u64)
                    if hd.stringview == "Iterator" then {
                        if (zgenerator.canLowerNow
                            :ast
                            n: (ast.nodes.get i: bm.operation.u64)
                            hasReceiver: true
                        ) then isCand = true
                    }
                }
            } else null
        }
        if isCand then {
            bm2Id9: items.get i: bi
            bm2: ast.nodes.getMut i: bm2Id9.u64
            match (
                bm2
            ) case namedoperation then {
                mnm: zast.nameTextAt :ast ref: bm2.name
                sname: "\{typeName}_\{mnm}_iter"
                fnNode: zast.tableTake :ast id: bm2.operation
                lowOpt: (zgenerator.lowerOne :ast
                    fn: fnNode
                    synthName: sname.stringview
                    receiverType: typeName
                )
                match (
                    lowOpt
                ) case some then {
                    wfid: lowOpt.wrapperNodeId
                    wfv: true
                    ty.generatorWrapper.set key: wfid.u64 value: wfv
                    nsi: u64
                    nsn: lowOpt.noStamp.length
                    for nsi < nsn loop {
                        ns0: lowOpt.noStamp.get i: nsi
                        nsk: ns0.u64
                        nsv: true
                        ty.noStampNode.set key: nsk value: nsv
                        nsi = nsi + 1
                    }
                    fac: lowOpt.factory.take
                    bm2.operation = zast.tableAdd :ast n: fac
                    cls: lowOpt.synthClass.take
                    clsN: (zgenerator.mkNamedOp
                        :ast
                        line: 0
                        col: 0
                        name: sname.stringview
                        op: cls
                    )
                    dst.append clsN
                } case none then null
            } else null
        }
        bi = bi + 1
    }
}

# stampRefDecl -- record the declaration a reference node resolved to.
stampRefDecl: function {ty: ztyping.ZTyping nid: u64 declId: ztypes.declid} is {
    if nid == 0 then return
    if declId.isZero then return
    ty.refDecl.set key: nid value: declId
}

# declOfTypeId -- the declaration that minted type `tid` (ZType.def); a
# mono derives its home through genericOriginId -> the template's Decl.
declOfTypeId: function {reg: ztypes.ZTypeRegistry.view tid: ztypes.tid} out ztypes.declid is {
    cur9: tid
    for cur9 > 0 loop {
        next9: u64
        if cur9 >= reg.typeById.length then return (ztypes.declid.create from: 0)
        zo9: reg.typeById.get i: cur9
        if zo9.def > 0 then return zo9.def
        go9: zo9.genericOriginId
        match (
            go9
        ) case some then {
            next9 = go9
        } case none then null
        cur9 = ztypes.tid.create from: (next9)
    }
    return (ztypes.declid.create from: 0)
}

# unitDeclOfTid -- the top-level unit root Decl that owns type `tid`'s
# declaration (declOfTypeId -> parent walk to the parentless unit root);
# 0 when the type has no declaration. The id-valued unit-identity
# primitive: compare unit ownership by this, not by name.
unitDeclOfTid: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    tid: ztypes.tid
} out ztypes.declid is {
    cur9: ztypes.declid
    {
        def9v: reg.defOf :tid
            cur9 = def9v
    }
    for cur9 > 0 loop {
        par9: ztypes.declid
        isU9: false
        selfT9: u64
        {
            do9: ty.decls.get i: cur9.u64
            par9 = do9.parent
            if do9.kind.unitDecl then isU9 = true
            selfT9 = do9.typeId
        }
        if (declAtProgramTop :ty parentDeclId: par9) then {
            # a FILE unit's own tid links to its own root under the program
            # root: the unit is not "defined in" a unit (inline units and
            # root-proxied synths do report the enclosing unit)
            if selfT9 == tid then return (ztypes.declid.create from: 0)
            if isU9 then return cur9
            return (ztypes.declid.create from: 0)
        }
        cur9 = par9
    }
    return (ztypes.declid.create from: 0)
}

# unitNameOfTid -- the defining unit's name for type `tid`, read off the
# Decl parent chain; "" when the type has no declaration. The display /
# dump projection over unitDeclOfTid -- identity gates should compare
# unitDeclOfTid ids instead.
unitNameOfTid: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    tid: ztypes.tid
} out String is {
    ud9: unitDeclOfTid :ty :reg :tid
    if ud9.u64 == 0 then return "".string
    utid9: u64
    {
        do9: ty.decls.get i: ud9.u64
        utid9 = do9.typeId
    }
    if utid9 == 0 then return "".string
    return (reg.nameOf tid: (ztypes.tid.create from: utid9.u64))
}

# declLinkTemplateMethod -- a generic unit template's method is minted under a
# mangled `Tmpl_fn` name that no top-level def carries, so linkDeclType cannot
# find a declaration for it and the function type ends up with none. Bind the
# template's own method declaration to that type, which makes its parameters --
# indexed in AST order at pre-index time -- reachable from the type id. The
# template's Decl is passed IN: a template declared inside a namespace is not a
# child of its unit root, so no (unit, name) pair reaches it.
declLinkTemplateMethod: function {
    ty: ztyping.ZTyping
    tmplDeclId: ztypes.declid
    memberNameId: u32
    fnTid: u64
} is {
    if fnTid == 0 then return
    if (ty.declIdOfType typeId: (ztypes.tid.create from: fnTid.u64)) > 0 then return
    if tmplDeclId.isZero then return
    md9: (ty.declFindChild
        parentDeclId: tmplDeclId
        nameId: (zast.nameid.create from: memberNameId.u32)
    )
    if md9.isZero then return
    ty.declSetType declId: md9 typeId: (ztypes.tid.create from: fnTid.u64)
}

# declMonoType -- give a monomorphisation its own type declaration, cloned
# from its template's, so its members carry the instantiated types rather than
# resolving back through genericOrigin to the template's.
declMonoType: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    monoTid: u64
    templateId: ztypes.tid
} is {
    td9: declOfTypeId :reg tid: templateId
    if td9.isZero then return
    md9: ty.declCloneType templateDeclId: td9
    if md9.isZero then return
    ty.declSetType declId: md9 typeId: (ztypes.tid.create from: monoTid.u64)
}

# declMemberOf -- the Decl of member `nameId` under the type that minted
# `ownerTid` (monos resolve through their template's Decl); 0 when the
# owner has no Decl or no such indexed member.
declMemberOf: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ownerTid: ztypes.tid
    nameId: zast.nameid
} out ztypes.declid is {
    od9: declOfTypeId :reg tid: ownerTid
    if od9.isZero then return (ztypes.declid.create from: 0)
    return (ty.declFindChild parentDeclId: od9 :nameId)
}

# declSurfaceOfName -- the Decl a bare-name reference lands on: the
# current unit's own def, else the prelude carrier's (core's) re-export,
# else the definition that minted the resolved type. The SURFACE is
# recorded (a re-export keeps its own Decl) so navigation lands where
# the name was found, not where its type lives.
declSurfaceOfName: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    unitDecl: ztypes.declid
    nameId: zast.nameid
    tid: ztypes.tid
} out ztypes.declid is {
    if nameId > 0 then {
        ro9: unitDecl
        if (ro9.isZero) == false then {
            cd9: ty.declFindChild parentDeclId: ro9 :nameId
            sv9: declSurfaceEnsure9 :ty :reg :ast declId: cd9 want: tid
            if sv9 > 0 then return sv9
        }
        co9: ty.declFindChild parentDeclId: ty.programRoot nameId: (nameIdOf :ast name: "core")
        if (co9.isZero) == false then {
            cd8: ty.declFindChild parentDeclId: co9 :nameId
            sv8: declSurfaceEnsure9 :ty :reg :ast declId: cd8 want: tid
            if sv8 > 0 then return sv8
        }
    }
    return (declOfTypeId :reg :tid)
}

# declSurfaceEnsure9 -- accept a candidate surface Decl only when its
# minted type id equals the reference's resolved tid, resolving a
# not-yet-touched re-export on the spot -- a stamped surface must serve
# both navigation (its node) and tid consumers like the emitter.
declSurfaceEnsure9: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast
    declId: ztypes.declid
    want: u64
} out ztypes.declid is {
    if declId.isZero then return (ztypes.declid.create from: 0)
    dtid9: u64
    isRx9: false
    {
        d9: ty.decls.get i: declId.u64
        dtid9 = d9.typeId
        if d9.kind.reexportDecl then isRx9 = true
    }
    if dtid9 == 0 when isRx9 then dtid9 = resolveAliasKey :ty :reg :ast :declId
    if dtid9 == want then return declId
    return (ztypes.declid.create from: 0)
}

# --- the environment walk for a bare definition name ---

# --- the environment ---

# unitDeclOfName -- the Decl of the FILE unit a name denotes: the program
# root's child of that name. THE ONE DOOR from a unit's name to its
# declaration -- everything downstream compares and looks up by id, where two
# units sharing a name are two answers rather than declFindChild's last-wins
# coin flip. The empty name is the prelude-only probe and has no unit. A name
# that is no file unit at all (a nested unit's or a template's own name,
# spelled as the walk's unit) is not a probe: the cursor's own unit answers.
unitDeclOfName: function {
    ty: ztyping.ZTyping.view
    ast: Ast.view
    name: StringView
} out ztypes.declid is {
    if name.length == 0 then return (ztypes.declid.create from: 0)
    return (unitDeclOfNameIdHere :ty nameId: (zast.poolFind pool: ast.names text: name))
}

# unitDeclOfNameIdHere -- unitDeclOfName for a caller that already holds the
# interned name. SAME door: a name that is no file unit answers with the
# CURSOR's own unit. Distinct from unitDeclOfNameId, whose miss is 0 -- they
# are not interchangeable, and a nested unit's name reaches this one.
unitDeclOfNameIdHere: function {
    ty: ztyping.ZTyping.view
    nameId: zast.nameid
} out ztypes.declid is {
    if nameId.isZero then return (ztypes.declid.create from: 0)
    r9: ty.declFindChild parentDeclId: ty.programRoot :nameId
    if r9.isZero then return (unitRootOfDecl :ty declId: ty.curFrame)
    return r9
}

# unitNameIdOf / unitNameTextOf -- the spelling a unit's DECLARATION carries.
# The display projection of a unit id, for a diagnostic, a composed key or a
# text compare: reading a name OFF the Decl is not a re-resolution, and is the
# only sanctioned direction now that identity travels as an id.
unitNameIdOf: function {
    ty: ztyping.ZTyping.view
    unitDecl: ztypes.declid
} out zast.nameid is {
    if unitDecl.isZero then return (zast.nameid.create from: 0)
    return (zast.nameid.create from: (ty.declNameOf declId: unitDecl))
}

unitNameTextOf: function {
    ty: ztyping.ZTyping.view
    ast: Ast.view
    unitDecl: ztypes.declid
} out String is {
    if unitDecl.isZero then return "".string
    return (zast.poolTextCopy pool: ast.names ref: (unitNameIdOf :ty :unitDecl))
}

# unitDeclOfNameId -- the Decl of the FILE unit an interned name denotes, or 0.
# The door for callers whose miss answer is "no unit" rather than "the cursor's
# unit" -- the `unit.name` id walks, which resolve nothing when the unit is not
# a file unit. unitDeclOfName is the other door and they are not interchangeable.
unitDeclOfNameId: function {
    ty: ztyping.ZTyping.view
    nameId: zast.nameid
} out ztypes.declid is {
    if nameId.isZero then return (ztypes.declid.create from: 0)
    return (ty.declFindChild parentDeclId: ty.programRoot :nameId)
}

# frameFor -- the frame a name written in unit `unitDecl` resolves from: the
# cursor's own frame when the cursor lies inside that unit (a body, a nested
# unit, a template), else the unit's root -- a caller naming another unit is
# a qualified probe (`core`'s `i64` for a literal's default, from a unit that
# shadows `i64`) and starts there. 0 for no unit (a prelude-only probe).
frameFor: function {
    ty: ztyping.ZTyping.view
    unitDecl: ztypes.declid
} out ztypes.declid is {
    if unitDecl.isZero then return (ztypes.declid.create from: 0)
    # the cursor's nearest unit frame first: it lies within the unit's root
    # exactly when the cursor does, and the climb from a unit frame to the
    # root is a hop or two where the climb from a body frame is many
    uf9: unitFrameOf :ty declId: ty.curFrame
    if (frameIsWithin :ty frame: uf9 root: unitDecl) then return uf9
    return unitDecl
}

# nsFrameOf -- the NESTED unit frame a name written in unit `unitDecl`
# resolves from -- frameFor's answer when it is not the unit's own root --
# or 0 at the top level of the unit. The scope the members of a namespace or
# template are declared in, as against the file unit.
nsFrameOf: function {
    ty: ztyping.ZTyping.view
    unitDecl: ztypes.declid
} out ztypes.declid is {
    f9: frameFor :ty :unitDecl
    if f9.isZero then return f9
    if f9 == unitDecl then return (ztypes.declid.create from: 0)
    return f9
}

# unitFrameOf -- the nearest frame at or above `declId` that a bare-name walk
# consults: a unit (file, inline, subunit, template) or a `public:` block. A
# type or function declaration is transparent to bare names -- members are
# reached through `this` or a qualified path, never bare -- so the walk climbs
# through it. 0 when `declId` is 0 or has no such ancestor.
unitFrameOf: function {
    ty: ztyping.ZTyping.view
    declId: ztypes.declid
} out ztypes.declid is {
    cur9: declId
    for cur9 > 0 loop {
        # the row carries the answer (declSetUnitFrame, laid at index time):
        # a body, a function, a local is not a unit frame, and no walk touches
        # the node
        if (ty.declIsUnitFrame declId: cur9) then return cur9
        cur9 = declParentIdOf :ty declId: cur9
    }
    return (ztypes.declid.create from: 0)
}

# declDefIsNative -- the definition this declaration records is a NATIVE
# object (`record is native`, `class is native`): the runtime owns its
# layout, so it holds nothing by value.
declDefIsNative: function {
    ty: ztyping.ZTyping.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    dn9: u64
    {
        do9: ty.decls.get i: declId.u64
        dn9 = do9.node.u64
    }
    if dn9 == 0 then return false
    np9: ast.nodes.get i: dn9
    if (np9.namedoperation) == false then return false
    op9: ast.nodes.get i: np9.operation.u64
    match (
        op9
    ) case objectdef then {
        return op9.isNative
    } else {
        return false
    }
}

# declDeclaresTemplate -- does this declaration declare a generic template
# unit (`m: unit as { t: anyval.generic ... }`)? Read off the def node's
# kind, like declDeclaresUnit; a template is a frame of its own -- its
# members and generic parameters are its children -- that the unit
# predicates deliberately exclude.
declDeclaresTemplate: function {
    ty: ztyping.ZTyping.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    dn9: u64
    {
        do9: ty.decls.get i: declId.u64
        dn9 = do9.node.u64
    }
    if dn9 == 0 then return false
    np9: ast.nodes.get i: dn9
    if (np9.namedoperation) == false then return false
    return (zast.unitOpKindIs :ast opId: np9.operation k: zast.unitkind.template)
}

# envTypeIdOf -- the environment's answer for a bare name as a type id: the
# declaration the cursor's frame chain reaches, when it is minted. 0 when the
# cursor is unset, the name is unknown to the chain, or the declaration is
# not resolved yet (a probe cannot mint; the demand scans see to that).
envTypeIdOf: function {
    ty: ztyping.ZTyping.view
    nameId: zast.nameid
} out u64 is {
    if ty.curFrame.isZero then return 0
    eh9: envLookup :ty frame: ty.curFrame :nameId
    if eh9.declId.isZero then return 0
    return (declTypeIdOf :ty declId: eh9.declId).u64
}

# frameIsWithin -- is `root` `frame` itself or one of its enclosing frames?
frameIsWithin: function {
    ty: ztyping.ZTyping.view
    frame: ztypes.declid
    root: ztypes.declid
} out bool is {
    if root.isZero then return false
    cur9: frame
    for cur9 > 0 loop {
        if cur9 == root then return true
        cur9 = declParentIdOf :ty declId: cur9
    }
    return false
}

# envLookup -- the environment walk for a bare name: from `frame` outward
# through each enclosing unit frame to the root, then `core`, first match
# wins. A hit is the child's DeclId whatever its resolution state and the
# frame it was found in; a miss is zero. A probe: it reads the index and mints
# nothing.
envLookup: function {
    ty: ztyping.ZTyping.view
    frame: ztypes.declid
    nameId: zast.nameid
} out zdefhit is {
    if nameId.isZero then return (zdefhit declId: ztypes.declid frame: ztypes.declid)
    cur9: unitFrameOf :ty declId: frame
    for cur9 > 0 loop {
        h9: ty.declFindChild parentDeclId: cur9 :nameId
        if (h9.isZero) == false then return (zdefhit declId: h9 frame: cur9)
        if cur9 == ty.coreUnitRoot then return (zdefhit declId: ztypes.declid frame: ztypes.declid)
        cur9 = unitFrameOf :ty declId: (declParentIdOf :ty declId: cur9)
    }
    if (ty.coreUnitRoot.isZero) == false then {
        h8: ty.declFindChild parentDeclId: ty.coreUnitRoot :nameId
        if (h8.isZero) == false then return (zdefhit declId: h8 frame: ty.coreUnitRoot)
    }
    return (zdefhit declId: ztypes.declid frame: ztypes.declid)
}

# zdefhit -- an envLookup hit: the child DeclId and the frame (its root
# DeclId) it was found in. Both zero on a miss.
zdefhit: record {
    declId: ztypes.declid
    frame: ztypes.declid
}

# reexportUnitOf -- for a prelude Decl whose value is a unit-rooted dotted
# alias (`List: collections.ListRef`), the name id of the unit it names; the
# zero id for a bare alias, a type-rooted value (`true: bool.true`), or a real
# definition.
reexportUnitOf: function {
    ty: ztyping.ZTyping.view
    ast: Ast.view
    declId: ztypes.declid
} out zast.nameid is {
    do9: ty.decls.get i: declId.u64
    nop9: ast.nodes.get i: do9.node.u64
    if nop9.namedoperation then {
        dk9: dottedDefTargetIds :ast n: (ast.nodes.get i: nop9.operation.u64)
        if dk9.unitName.u32 > 0 then {
            dkr9: ty.declFindChild parentDeclId: ty.programRoot nameId: dk9.unitName
            if (dkr9.isZero) == false then return dk9.unitName
        }
    }
    return (zast.nameid.create from: 0)
}

# programUnitDecls -- every FILE unit's Decl, in load order: the program root's
# children. What a closure-wide sweep iterated the unit-name index for. Two
# files declaring the same unit name appear twice, where the index held one --
# a sweep asks each of them, which is the point.
programUnitDecls: function {ty: ztyping.ZTyping.view} out (ListVal u64) is {
    out9: (ListVal u64)
    ro9: ty.decls.get i: ty.programRoot.u64
    with cit9: ro9.children.iterate do for c9: cit9 loop out9.append c9.declId.u64
    return out9
}

# isUnitNameDecl -- does `nameId` name a FILE unit: a child of the program root
# whose declared type is a unit? The Decl-tree answer to what the unit-name
# index was asked.
# nameDenotesUnit -- does `nameId` name a unit HERE: a FILE unit, or a
# generic-unit BINDING in scope (`intmath: (mathops t: i64)`) whose Decl
# carries the instantiated unit's type. The second leg is what a bare-name
# index could not express -- two namespaces may each bind an `intmath` -- so
# it resolves through the environment like any other name.
nameDenotesUnit: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    nameId: zast.nameid
} out bool is {
    if (isUnitNameDecl :ty :reg :nameId) then return true
    h9: envLookup :ty frame: ty.curFrame :nameId
    if h9.declId.isZero then return false
    # only a BINDING of an instantiated unit, never a unit DECLARATION: a
    # nested unit or subunit is in scope here but was never in the index this
    # replaces, and reading one as a qualified root changes what a dotted path
    # means (qualified_subunit_type, the re-export chains).
    isUd9: false
    {
        hdo9: ty.decls.get i: h9.declId.u64
        if hdo9.kind.unitDecl then isUd9 = true
    }
    if isUd9 then return false
    bt9: declTypeIdOf :ty declId: h9.declId
    if bt9.isZero then return false
    return (reg.typetypeOf typeId: bt9) == ztypes.ztypetype.unitType
}

isUnitNameDecl: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    nameId: zast.nameid
} out bool is {
    ur9: ty.declFindChild parentDeclId: ty.programRoot :nameId
    if ur9.isZero then return false
    ut9: declTypeIdOf :ty declId: ur9
    if ut9.isZero then return false
    return (reg.typetypeOf typeId: ut9) == ztypes.ztypetype.unitType
}

# declProbeUnitChildId -- the Decl-tree unit-child probe: unit root (the
# program root's child of that name) -> direct child (by pool name id) ->
# its minted type id. 0 when the unit is unknown, the name is not an
# indexed child, or the child's type is not yet declared -- callers
# then fall to the declare-on-demand miss path exactly as before.
declProbeUnitChildId: function {
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    ast: Ast.view
    uname: ztypes.declid
    nameId: zast.nameid
} out u64 is {
    if nameId.isZero then return 0
    ro9: uname
    if (ro9.isZero) == false then {
        return (declProbeUnitChildRoot :ty :reg :ast unitRoot: ro9 :nameId)
    }
    return 0
}

# declProbeUnitChildRoot -- the same probe from an already-resolved unit root.
# Callers on a per-reference path resolve the root once and come here; only the
# name-taking wrapper above pays a pool probe.
declProbeUnitChildRoot: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    ast: Ast
    unitRoot: ztypes.declid
    nameId: zast.nameid
} out u64 is {
    if nameId.isZero then return 0
    cid9: ty.declFindChild parentDeclId: unitRoot :nameId
    if cid9.isZero then return 0
    ctid9: u64
    isRx9: false
    isC9: false
    {
        do9: ty.decls.get i: cid9.u64
        ctid9 = do9.typeId
        if do9.kind.reexportDecl then isRx9 = true
        if do9.kind.constDecl then isC9 = true
    }
    if ctid9 > 0 then return ctid9
    if isRx9 then {
        # a re-export not yet resolved: mint once through the alias,
        # cache on the Decl (covers value re-exports like core.false)
        return (resolveAliasKey :ty :reg :ast declId: cid9)
    }
    if isC9 then {
        constFoldDecl :ast :ty :reg declId: cid9
        rt9: declTypeIdOf :ty declId: unitRoot
        if (rt9.isZero) == false then {
            co9: ty.declChildOfId parentTypeId: rt9 :nameId
            match (
                co9
            ) case some then {
                return co9
            } case none then null
        }
    }
    return 0
}

# monoOriginTidOf -- a type's genericOriginId (the template it monomorphized
# from), or 0. A tid with an origin is a registered mono: inherently canonical,
# never a placeholder shell.
monoOriginTidOf: function {reg: ztypes.ZTypeRegistry tid: ztypes.tid} out ztypes.tid is {
    return (reg.genericOriginOf :tid)
}

# probeFrameTyperef -- one frame's answer for a type name: the Decl-tree
# child's minted id (a not-yet-touched re-export minted through its alias),
# else the unit type's member index, which also serves the pre-index window
# (no root yet) and members that are not Decls (unit monos, namespace
# bindings). 0 when the frame has no such name yet -- the caller moves to the
# next frame.
probeFrameTyperef: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    root: ztypes.declid
    nameId: zast.nameid
} out u64 is {
    if nameId.isZero then return 0
    if root.isZero then return 0
    dt9: declProbeUnitChildRoot :ty :reg :ast unitRoot: root :nameId
    if dt9 > 0 then return dt9
    # the frame's own member index, keyed on the unit id its ROOT DECL
    # carries. Every unit root has one -- a file unit's is stamped where the
    # roots are indexed, a nested unit's where resolveNamespaceUnit mints it
    # -- so the frame answers the same way whichever kind of unit it is.
    rt9: declTypeIdOf :ty declId: root
    if rt9.isZero then return 0
    co9: ty.declChildOfId parentTypeId: rt9 :nameId
    match (
        co9
    ) case some then {
        return co9
    } case none then null
    return 0
}

# walkLookupTyperef -- resolve a bare type name to its id: the environment
# walk from the frame a name written in `unitDecl` resolves from (frameFor:
# the cursor's frame when the cursor lies inside that unit, else the unit's
# own root), each enclosing unit frame outward, then the prelude -- the
# current unit shadows core, and every other unit is reached through core's
# re-exports or a qualified path. It serves internal/mangled queries (dotted
# member keys) beyond the source-level surface, so a frame answers from the
# member index as well as the Decl tree (probeFrameTyperef).
walkLookupTyperef: function {
    ast: Ast.view
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    unitDecl: ztypes.declid
    base: StringView
} out optionval u64 is {
    nid9: zast.poolFind pool: ast.names text: base
    if nid9.isZero then return (optionval.none u64)
    return (walkLookupTyperefById :ast :ty :reg :unitDecl baseId: nid9)
}

# resolvedByIds / resolvedByIdsMember -- resolve a (unit, name[, member])
# id tuple by walking childOf from the unit root, with the on-demand alias
# follow on a miss. resolveUnitChild / resolveSystemChild are the text-view
# entry points; resolveSystemChild probes the cached system unit root with
# no allocation at all.
# declOfUnitDefIds -- declOfUnitDefId for a caller holding BOTH ids: unit
# root by id, then the child edge. No name is interned and no key is built.
declOfUnitDefIds: function {
    ty: ztyping.ZTyping
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    if nameId.isZero then return (ztypes.declid.create from: 0)
    ro9: unitDecl
    if (ro9.isZero) == false then {
        d9: ty.declFindChild parentDeclId: ro9 :nameId
        if (d9.isZero) == false then return d9
        # a definition the unit's `public:` block makes is on its surface
        pb9: publicNsChildOf :ty root: ro9
        if (pb9.isZero) == false then return (ty.declFindChild parentDeclId: pb9 :nameId)
    }
    return (ztypes.declid.create from: 0)
}

# childOfWalkIds -- the two-segment walk with both segments already interned.
# The string form's fast path composed a key, split it back with indexOf +
# substring, re-interned the unit segment and handed the name segment to a
# text lookup that interned it again -- all to reach exactly this.
childOfWalkIds: function {
    ty: ztyping.ZTyping
    unitDecl: ztypes.declid
    name: zast.nameid
} out optionval u64 is {
    ro9: declTypeIdOf :ty declId: unitDecl
    if (ro9.isZero) == false then {
        return (ty.declChildOfId
            parentTypeId: (ztypes.tid.create from: ro9.u64)
            nameId: name
        )
    }
    return (optionval.none u64)
}

# resolvedByIds -- resolve a `unit.name` id pair to its type id: the
# childOf walk, then the on-demand alias follow (which lays the
# unit->alias edge so later probes resolve through childOf).
resolvedByIds: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    unitDecl: ztypes.declid
    name: zast.nameid
} out optionval u64 is {
    wo9: childOfWalkIds :ty :unitDecl :name
    match (
        wo9
    ) case some then {
        return (optionval.some wo9)
    } case none then null
    alDecl9: declOfUnitDefIds :ty :unitDecl nameId: name
    # a definition the unit's `public:` block makes: on the unit's surface,
    # so `unit.name` reaches it, but NOT laid on the unit's member index --
    # that index also answers bare names written inside the unit, and the
    # block's definitions are reached from there by `public.name` alone
    {
        alT9: declTypeIdOf :ty declId: alDecl9
        alP9: declParentIdOf :ty declId: alDecl9
        alRoot9: ztypes.declid
        if (unitDecl.isZero) == false then alRoot9 = unitDecl
        if (alT9.isZero) == false when (alP9.isZero) == false when alP9 != alRoot9 then {
            return (optionval.some alT9.u64)
        }
    }
    alTgt9: reexportTargetIdsOf :ty :ast declId: alDecl9
    if alTgt9.unitName.u32 > 0 then {
        tgo9: (childOfWalkIds
            :ty
            unitDecl: (unitDeclOfNameId :ty nameId: alTgt9.unitName)
            name: alTgt9.defName
        )
        match (
            tgo9
        ) case some then {
            uro9: (declTypeIdOf
                :ty
                declId: unitDecl
            )
            if (uro9.isZero) == false then {
                if (name.isZero) == false then (ty.setMemberType
                    parentTypeId: (ztypes.tid.create from: uro9.u64)
                    nameId: name
                    childTypeId: tgo9
                )
            }
            return (optionval.some tgo9)
        } case none then null
    }
    return (optionval.none u64)
}

# resolvedByIdsMember -- `unit.def.member` from ids: the unit-level
# definition, then one more child edge. The two three-segment keys in this
# unit were the only reason the walk had to handle an arbitrary segment count.
resolvedByIdsMember: function {
    ast: Ast.view
    ty: ztyping.ZTyping
    unitDecl: ztypes.declid
    defId: zast.nameid
    memberId: zast.nameid
} out optionval u64 is {
    do9: resolvedByIds :ast :ty :unitDecl name: defId
    match (
        do9
    ) case some then {
        return (ty.declChildOfId
            parentTypeId: (ztypes.tid.create from: do9.u64)
            nameId: memberId
        )
    } case none then null
    return (optionval.none u64)
}

resolveUnitChild: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    unitDecl: ztypes.declid
    name: StringView
} out optionval u64 is {
    uId9: unitNameIdOf :ty :unitDecl
    nId9: zast.poolFind pool: ast.names text: name
    dt9: declProbeUnitChildId :ty :reg :ast uname: unitDecl nameId: nId9
    if dt9 > 0 then return (optionval.some dt9)
    ro: declTypeIdOf :ty declId: (ty.declFindChild parentDeclId: ty.programRoot nameId: uId9)
    if (ro.isZero) == false then {
        co: ty.declChildOfId parentTypeId: (ztypes.tid.create from: ro.u64) nameId: nId9
        match (
            co
        ) case some then {
            return (optionval.some co)
        } case none then null
    }
    # miss: the alias follow lays the unit->alias edge, so the next probe
    # resolves through childOf above
    return (resolvedByIds :ast :ty unitDecl: (unitDeclOfNameId :ty nameId: uId9) name: nId9)
}

# resolve member `name` of the system/stdlib unit to its type id, or `none`.
resolveSystemChild: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    name: StringView
} out optionval u64 is {
    nId9: zast.poolFind pool: ast.names text: name
    dt9: declProbeUnitChildId :ty :reg :ast uname: ty.systemUnitRoot nameId: nId9
    if dt9 > 0 then return (optionval.some dt9)
    if ty.systemUnitTid > 0 then {
        co: ty.declChildOfId parentTypeId: ty.systemUnitTid nameId: nId9
        match (
            co
        ) case some then {
            return (optionval.some co)
        } case none then null
    }
    return (resolvedByIds
        :ast
        :ty
        unitDecl: (unitDeclOfNameId :ty nameId: (nameIdOf :ast name: "system"))
        name: nId9
    )
}

# --- id-keyed resolution twins: same shape as the text resolvers above, but
# the child name arrives as an already-interned Ast.names pool id, so each
# probe is a childOfId (no per-stage StringPool.find). The composed-key miss
# path materialises the name text once via poolTextCopy (rare). ---

# walkLookupTyperefById -- walkLookupTyperef for a caller holding the base
# name's pool id.
walkLookupTyperefById: function {
    ast: Ast.view
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    unitDecl: ztypes.declid
    baseId: zast.nameid
} out optionval u64 is {
    if baseId.isZero then return (optionval.none u64)
    return (walkLookupTyperefFrom
        :ast
        :ty
        :reg
        frame: (frameFor :ty :unitDecl)
        :baseId
    )
}

# walkLookupTyperefFrom -- the walk itself, from an explicit start frame (0:
# the prelude alone): each enclosing unit frame outward, then core.
walkLookupTyperefFrom: function {
    ast: Ast.view
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    frame: ztypes.declid
    baseId: zast.nameid
} out optionval u64 is {
    if baseId.isZero then return (optionval.none u64)
    cur9: frame
    # the nearest frame that declares the name with a declaration still in
    # flight (queued or mid-resolution): the nearest declaration wins
    # whatever its state (envLookup's rule), so an outer frame may answer
    # only with THAT declaration's own id -- core's re-export of it -- never
    # with a different definition of the same name; otherwise the reference
    # waits for the declaration to resolve
    waitDecl9: ztypes.declid
    for cur9 > 0 loop {
        if cur9 == ty.coreUnitRoot then {
            cur9 = ztypes.declid
        } else {
            r9: probeFrameTyperef :ast :ty :reg root: cur9 nameId: baseId
            if r9 > 0 then {
                if waitDecl9.isZero then return (optionval.some r9)
                od9: declOfTypeId :reg tid: (ztypes.tid.create from: r9)
                if od9 == waitDecl9 then return (optionval.some r9)
                return (optionval.none u64)
            }
            if waitDecl9.isZero then {
                here9: ty.declFindChild parentDeclId: cur9 nameId: baseId
                if (here9.isZero) == false then {
                    hd9: ty.decls.get i: here9.u64
                    if hd9.pending then waitDecl9 = here9
                    if hd9.resolving then waitDecl9 = here9
                }
            }
            cur9 = unitFrameOf :ty declId: (declParentIdOf :ty declId: cur9)
        }
    }
    # `Any` is not user-reachable through core: only its own unit (system.z,
    # or a user unit defining one) resolves it. The constraint-position gate
    # is checkAnyBounds.
    if (zast.poolTextAt pool: ast.names ref: baseId) == "Any" then return (optionval.none u64)
    if (ty.coreUnitRoot.isZero) == false then {
        r5: probeFrameTyperef :ast :ty :reg root: ty.coreUnitRoot nameId: baseId
        if r5 > 0 then {
            if waitDecl9.isZero then return (optionval.some r5)
            od5: declOfTypeId :reg tid: (ztypes.tid.create from: r5)
            if od5 == waitDecl9 then return (optionval.some r5)
        }
    }
    return (optionval.none u64)
}

# resolve member `nameId` of user unit `unitDecl` to its type id, or `none`.
resolveUnitChildById: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out optionval u64 is {
    dt9: declProbeUnitChildId :ty :reg :ast uname: unitDecl :nameId
    if dt9 > 0 then return (optionval.some dt9)
    ro: (declTypeIdOf
        :ty
        declId: unitDecl
    )
    if (ro.isZero) == false then {
        co: ty.declChildOfId parentTypeId: (ztypes.tid.create from: ro.u64) :nameId
        match (
            co
        ) case some then {
            return (optionval.some co)
        } case none then null
    }
    return (resolvedByIds
        :ast
        :ty
        :unitDecl
        name: nameId
    )
}

# id-keyed `resolveSystemChild`: the member is a StringPool name-id.
resolveSystemChildById: function {
    ast: Ast
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    nameId: zast.nameid
} out optionval u64 is {
    if ty.systemUnitRoot > 0 then {
        dt9: (declProbeUnitChildRoot
            :ty
            :reg
            :ast
            unitRoot: ty.systemUnitRoot
            :nameId
        )
        if dt9 > 0 then return (optionval.some dt9)
    }
    if ty.systemUnitTid > 0 then {
        co: ty.declChildOfId parentTypeId: ty.systemUnitTid :nameId
        match (
            co
        ) case some then {
            return (optionval.some co)
        } case none then null
    }
    return (resolvedByIds
        :ast
        :ty
        unitDecl: (unitDeclOfNameId :ty nameId: (nameIdOf :ast name: "system"))
        name: nameId
    )
}

# shellScalarName -- a shell named like a C scalar stays a shell: the
# emitter spells those by NAME (cTypeOf) before any canonicalization, so
# rebinding them would change shadow semantics. Mirrors cTypeOf's set.
shellScalarName: function {name: StringView} out bool is {
    if name == "i8" then return true
    if name == "i16" then return true
    if name == "i32" then return true
    if name == "i64" then return true
    if name == "u8" then return true
    if name == "u16" then return true
    if name == "u32" then return true
    if name == "u64" then return true
    if name == "i128" then return true
    if name == "u128" then return true
    if name == "f16" then return true
    if name == "f32" then return true
    if name == "f64" then return true
    if name == "f128" then return true
    if name == "bool" then return true
    if name == "literal_int" then return true
    return false
}

# shellResolveByName -- the emitter's shell resolution order for `name` seen
# from `unit`: the unit-local key, the system key, the walk list, then the
# registry-wide cross-unit scan. 0 when nothing resolves.
# canonShellTid -- the canonical id for a SHELL stamp value, 0 to leave
# the stamp alone. Mirrors canonicalizeShellChildren's shell detection
# (no defining unit, not a generic param / scalar shell / as-const clone
# / typeof shell); memoized per shell id.
canonShellTid: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    cache9: (MapVV u64 value: u64)
    tid: ztypes.tid
    unitDecl: ztypes.declid
} out u64 is {
    if tid.isZero then return 0
    co9: cache9.get key: tid
    match (
        co9
    ) case some then {
        return co9
    } case none then null
    res9: u64
    ok9: (st.reg.typetypeOf typeId: tid) != ztypes.ztypetype.genericParam
    # a registered mono is inherently canonical (its name resolves back to
    # itself); only a homeless placeholder shell needs the name lookup
    if ok9 when (monoOriginTidOf reg: st.reg :tid) > 0 then ok9 = false
    if ok9 then {
        if (unitDeclOfTid ty: st.typing reg: st.reg :tid) > 0 then ok9 = false
    }
    if ok9 then {
        nm9: regTypeNameOf reg: st.reg :tid
        if (shellScalarName name: nm9.stringview) then nm9 = "".string
        aco9: st.typing.asConstClone.get key: tid
        match (
            aco9
        ) case some then {
            if aco9 then nm9 = "".string
        } case none then null
        tso9: st.typing.typeofShell.get key: tid
        match (
            tso9
        ) case some then {
            nm9 = "".string
        } case none then null
        if nm9.length > 0 then {
            rid9: (shellResolveByName
                :ast
                ty: st.typing
                reg: st.reg
                fromUnit: unitDecl
                name: nm9.stringview
            )
            if rid9 > 0 when rid9 != tid then res9 = rid9
        }
    }
    kc9: tid
    vc9: res9
    cache9.set key: kc9 value: vc9
    return res9
}

# canonicalizeShellNodeStamps -- checkBodies runs BEFORE the shell-child
# canonicalization, so expression nodes typed through a then-shell edge
# carry the shell id in nodeType (and dpTaggedParent):
# the emitter reads receiver types from those stamps, and a shell has no
# origin/children to dispatch on. Rebind them to the canonical type the way
# canonicalizeShellChildren rebinds the members.
canonicalizeShellNodeStamps: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
} is {
    cache9: (MapVV u64 value: u64)
    cn9: st.typing.nodeType.length
    ci9: u64
    for ci9 < cn9 loop {
        cv9: st.typing.nodeType.get i: ci9
        if cv9 > 0 then {
            rid9: canonShellTid :ast :st :cache9 tid: (ztypes.tid.create from: cv9.u64) :unitDecl
            if rid9 > 0 then {
                (ztyping.nodeTypeSet
                    tbl: st.typing.nodeType
                    nid: ci9
                    tid: (ztypes.tid.create from: rid9.u64)
                )
            }
        }
        ci9 = ci9 + 1
    }
    dnids9: (ListVal u64)
    dvals9: (ListVal u64)
    with dt9: st.typing.dpTaggedParent.iterateItems do for d9: dt9 loop {
        rid3: canonShellTid :ast :st :cache9 tid: (ztypes.tid.create from: d9.value) :unitDecl
        if rid3 > 0 then {
            dnids9.append d9.key
            dvals9.append rid3
        }
    }
    l9: u64
    for l9 < dnids9.length loop {
        k3: dnids9.get i: l9
        v3: dvals9.get i: l9
        st.typing.dpTaggedParent.set key: k3 value: (ztypes.tid.create from: v3.u64)
        l9 = l9 + 1
    }
    pnids9: (ListVal u64)
    pvals9: (ListVal u64)
    with pt9: st.typing.dpArmPredicate.iterateItems do for p9: pt9 loop {
        rid4: canonShellTid :ast :st :cache9 tid: (ztypes.tid.create from: p9.value) :unitDecl
        if rid4 > 0 then {
            pnids9.append p9.key
            pvals9.append rid4
        }
    }
    q9: u64
    for q9 < pnids9.length loop {
        k4: pnids9.get i: q9
        v4: pvals9.get i: q9
        st.typing.dpArmPredicate.set key: k4 value: (ztypes.tid.create from: v4.u64)
        q9 = q9 + 1
    }
    tnids9: (ListVal u64)
    tvals9: (ListVal u64)
    with tt9: st.typing.dpTagRead.iterateItems do for t9: tt9 loop {
        rid5: canonShellTid :ast :st :cache9 tid: (ztypes.tid.create from: t9.value) :unitDecl
        if rid5 > 0 then {
            tnids9.append t9.key
            tvals9.append rid5
        }
    }
    r9: u64
    for r9 < tnids9.length loop {
        k5: tnids9.get i: r9
        v5: tvals9.get i: r9
        st.typing.dpTagRead.set key: k5 value: (ztypes.tid.create from: v5.u64)
        r9 = r9 + 1
    }
    gnids9: (ListVal u64)
    gvals9: (ListVal u64)
    with gt9: st.typing.postGuardTid.iterateItems do for g9: gt9 loop {
        rid7: canonShellTid :ast :st :cache9 tid: (ztypes.tid.create from: g9.value) :unitDecl
        if rid7 > 0 then {
            gnids9.append g9.key
            gvals9.append rid7
        }
    }
    y9: u64
    for y9 < gnids9.length loop {
        k7: gnids9.get i: y9
        v7: gvals9.get i: y9
        st.typing.postGuardTid.set key: k7 value: (ztypes.tid.create from: v7.u64)
        y9 = y9 + 1
    }
    anids9: (ListVal u64)
    avals9: (ListVal u64)
    with at9: st.typing.tagAccessorTid.iterateItems do for a9: at9 loop {
        rid6: canonShellTid :ast :st :cache9 tid: (ztypes.tid.create from: a9.value) :unitDecl
        if rid6 > 0 then {
            anids9.append a9.key
            avals9.append rid6
        }
    }
    w9: u64
    for w9 < anids9.length loop {
        k6: anids9.get i: w9
        v6: avals9.get i: w9
        (st.typing.tagAccessorTid.set
            key: (ztypes.tid.create from: k6.u64)
            value: (ztypes.tid.create from: v6.u64)
        )
        w9 = w9 + 1
    }
}

# resolve a type name to its shell type id (before member resolution).
shellResolveByName: function {
    ast: Ast.view
    ty: ztyping.ZTyping.view
    reg: ztypes.ZTypeRegistry.view
    fromUnit: ztypes.declid
    name: StringView
} out u64 is {
    r1: resolveUnitChild :ast :ty :reg unitDecl: fromUnit :name
    match (
        r1
    ) case some then {
        return r1
    } case none then null
    r2: resolveSystemChild :ast :ty :reg :name
    match (
        r2
    ) case some then {
        return r2
    } case none then null
    r3: walkLookupTyperef :ast :ty :reg unitDecl: fromUnit base: name
    match (
        r3
    ) case some then {
        return r3
    } case none then null
    return 0
}

# canonicalizeShellChildren -- rebind every member whose declared type is a
# SHELL id (a name-minted reference with no defining unit) to the canonical
# type, resolved in the member's parent's defining unit with the emitter's
# resolution order. Runs post-resolution so the emitter reads canonical child
# ids and never re-resolves a child by name.
canonicalizeShellChildren: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
} is {
    # stage every member first: the loop rebinds member types as it goes, and
    # a declaration write cannot run while an enumeration of the typing is open
    owns9: (ListVal u64)
    nms9: (ListVal u64)
    ctds9: (ListVal u64)
    (st.typing.declAllMemberRows
        lastTid: st.reg.nextTypeId
        owners: owns9
        names: nms9
        tids: ctds9
    )
    ri9: u64
    rn9: owns9.length
    for ri9 < rn9 loop {
        rpt9: owns9.get i: ri9
        rnm9: (zast.nameid.create from: (nms9.get i: ri9).u32.orPanic)
        cto9: ctds9.get i: ri9
        ok9: cto9 > 0
        if ok9 when (st.reg.typetypeOf typeId: (ztypes.tid.create from: cto9.u64)) == ztypes.ztypetype.genericParam then {
            ok9 = false
        }
        if ok9 when (monoOriginTidOf
            reg: st.reg
            tid: (ztypes.tid.create from: cto9.u64)
        ) > 0 then ok9 = false
        if ok9 then {
            if (unitDeclOfTid
                ty: st.typing
                reg: st.reg
                tid: (ztypes.tid.create from: cto9.u64)
            ) > 0 then ok9 = false
        }
        # a unit mono's members are its own substituted FUNCTIONS, minted per
        # instance with no declaration of their own: not shells. Resolving them
        # by name in the mono's defining unit -- the template's -- would rebind
        # them to the template's methods.
        if ok9 when (st.reg.typetypeOf typeId: (ztypes.tid.create from: rpt9.u64)) == ztypes.ztypetype.unitType then {
            if (st.reg.genericOriginOf tid: (ztypes.tid.create from: rpt9.u64)) > 0 then ok9 = false
        }
        if ok9 then {
            pu9: unitDecl
            {
                puo9: (unitDeclOfTid
                    ty: st.typing
                    reg: st.reg
                    tid: (ztypes.tid.create from: rpt9.u64)
                )
                if (puo9.isZero) == false then pu9 = puo9
            }
            # the child's name resolves where its parent type is declared. A
            # specialisation has no declaration of its own yet and keeps the
            # frame it is given.
            prevFrame9: st.typing.curFrame
            {
                pgo9: st.reg.genericOriginOf tid: (ztypes.tid.create from: rpt9.u64)
                if pgo9.isZero then {
                    pdo9: declOfTypeId reg: st.reg tid: (ztypes.tid.create from: rpt9.u64)
                    if (pdo9.isZero) == false then st.typing.curFrame = pdo9
                }
            }
            nm9: regTypeNameOf reg: st.reg tid: (ztypes.tid.create from: cto9.u64)
            if (shellScalarName name: nm9.stringview) then nm9 = "".string
            {
                aco9: st.typing.asConstClone.get key: cto9
                match (
                    aco9
                ) case some then {
                    if aco9 then nm9 = "".string
                } case none then null
            }
            {
                tso9: st.typing.typeofShell.get key: cto9
                match (
                    tso9
                ) case some then {
                    nm9 = "".string
                } case none then null
            }
            if nm9.length > 0 then {
                rid9: (shellResolveByName
                    :ast
                    ty: st.typing
                    reg: st.reg
                    fromUnit: pu9
                    name: nm9.stringview
                )
                if rid9 > 0 when rid9 != cto9 then {
                    setc9: rid9
                    (st.typing.declSetMemberType
                        parentTypeId: (ztypes.tid.create from: rpt9.u64)
                        nameId: rnm9
                        typeId: (ztypes.tid.create from: setc9.u64)
                    )
                }
            }
            st.typing.curFrame = prevFrame9
        }
        ri9 = ri9 + 1
    }
}

# typecheck a whole program against registry `reg`: resolve every type,
# stamp all nodes, and return the populated symbol table (diagnostics
# ride in the typing tables).
# publicNsOf -- the publicNs child Decl of the type/unit that minted `tid`
# (0 when the type has no `public:` block). The children are read one index at
# a time: a second ty.decls probe cannot run under a live children borrow.
publicNsOf: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry
    tid: ztypes.tid
} out ztypes.declid is {
    od9: ztypes.declid
    {
        def9v: reg.defOf :tid
            od9 = def9v
    }
    # a nested unit or hidden subunit links its declaration through the
    # typing side (declSetType), not the registry's def
    if od9.u64 == 0 then od9 = ty.declIdOfType typeId: tid
    if od9.u64 == 0 then return (ztypes.declid.create from: 0)
    return (ty.declPublicNsOf owner: od9)
}

# declMemberIsPrivate -- member `nameId` is private on the type/unit that minted
# `tid`: true iff that type has a publicNs (a `public:` block) and `nameId` is not
# one of its exposed edges. Exact-tid: a mono has no own publicNs, so all its
# members read public (matching the childPrivate map's exact-tid keying).
declMemberIsPrivate: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    tid: ztypes.tid
    nameId: zast.nameid
} out bool is {
    pn9: publicNsOf :ty :reg :tid
    if pn9.isZero then return false
    od9: ztypes.declid
    {
        po9: ty.decls.get i: pn9.u64
        od9 = po9.parent
    }
    md9: ty.declFindChild parentDeclId: od9 :nameId
    # not private if `nameId` is not a declared member (isChildPrivate is false
    # for a missing member edge), nor the publicNs block pseudo-member itself
    if md9.isZero then return false
    if md9 == pn9 then return false
    fcP9: ty.declFindChild parentDeclId: pn9 :nameId
    return fcP9.isZero
}

# declPublicAliasInternal -- the internal member name that public alias `name`
# exposes on `tid`, or "" when `name` is not a renamed public entry (the exposed
# name equals the internal name, or there is no such entry).
declPublicAliasInternal: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    pool: zast.StringPool
    tid: ztypes.tid
    name: StringView
} out String is {
    nid9: pool.find s: name
    if nid9.isZero then return "".string
    pn9: publicNsOf :ty :reg :tid
    if pn9.isZero then return "".string
    tgt9: ty.declFindChild parentDeclId: pn9 nameId: nid9
    if tgt9.isZero then return "".string
    intName9: u32
    {
        do9: ty.decls.get i: tgt9.u64
        intName9 = do9.name
    }
    if intName9 == nid9 then return "".string
    if intName9 == 0 then return "".string
    return (zast.poolTextCopy :pool ref: (zast.nameid.create from: intName9.u32))
}

# publicAliasInternalNames -- the internal member names `tid`'s public interface
# exposes under a DIFFERENT public name (its alias targets); empty when `tid` has
# no publicNs. The linter marks these as used so a renamed def is not flagged.
publicAliasInternalNames: function {
    ty: ztyping.ZTyping
    reg: ztypes.ZTypeRegistry.view
    pool: zast.StringPool.view
    tid: ztypes.tid
} out (List String) is {
    out9: (List String)
    pn9: publicNsOf :ty :reg :tid
    if pn9.isZero then return out9
    ename9: (ListVal u64)
    edecl9: (ListVal ztypes.declid)
    {
        po9: ty.decls.get i: pn9.u64
        with cit9: po9.children.iterate do for c9: cit9 loop {
            ename9.append from: c9.nameId.u64
            edecl9.append from: c9.declId
        }
    }
    ei9: u64
    en9: ename9.length
    for ei9 < en9 loop {
        pubNid9: ename9.get i: ei9
        tdecl9: edecl9.get i: ei9
        ei9 = ei9 + 1
        intNid9: u32
        {
            do9: ty.decls.get i: tdecl9.u64
            intNid9 = do9.name
        }
        if intNid9 > 0 when intNid9.u64 != pubNid9 then out9.append from: (zast.poolTextCopy
            :pool
            ref: (zast.nameid.create from: intNid9.u32)
        )
    }
    return out9
}

typecheck: function {
    program: Node
    reg: ztypes.ZTypeRegistry.take
    eager: bool
    requireMain: bool
    dumpRows: bool
    ccPath: StringView
    ccMode: StringView
    target: StringView
} out zenv.ZSymbolTable is {
    nodeEstT9: u64
    match (
        program
    ) case program then {
        nodeEstT9 = program.ast.nodes.length
    } else null
    ty: ztyping.newTyping nodeEst: nodeEstT9
    ty.eagerAll = eager
    ty.requireMain = requireMain
    ty.dumpRows = dumpRows
    ty.ccPath = ccPath.string
    ty.ccMode = ccMode.string
    ty.targetTriple = target.string
    match (
        program
    ) case program then {
        muNid9: nameIdOf ast: program.ast name: program.mainUnitName.stringview
        reg.setMainUnit name: program.mainUnitName.stringview nameId: muNid9
    } else null
    st: zenv.newSymbolTable :reg typing: ty
    # every unit's root type and name, then the def index -- every top-level
    # name of every unit, marked not yet typechecked -- BEFORE any resolution,
    # so a reference always finds its declaration and never mints a shell for
    # a name that has one. Generator lowering indexes what it synthesizes.
    registerUnitRoots ty: st.typing reg: st.reg :program
    indexUnitDefs ty: st.typing reg: st.reg :program
    {
        sysId9: u32
        match (
            program
        ) case program then {
            sysId9 = nameIdOf ast: program.ast name: "system"
        } else null
        sysUo9: (declTypeIdOf
            ty: st.typing
            declId: (st.typing.declFindChild
                parentDeclId: st.typing.programRoot
                nameId: (zast.nameid.create from: sysId9)
            )
        )
        if (sysUo9.isZero) == false then {
            st.typing.systemUnitTid = ztypes.tid.create from: sysUo9.u64
        }
    }
    match (
        program
    ) case program then {
        (declareCanonicalType
            ast: program.ast
            ty: st.typing
            reg: st.reg
            unitDecl: st.typing.systemUnitRoot
            ownerNameId: zast.nameid
            name: "never"
            typetype: ztypes.ztypetype.neverType
        )
        st.typing.nullTypeId = (declareCanonicalType
            ast: program.ast
            ty: st.typing
            reg: st.reg
            unitDecl: st.typing.systemUnitRoot
            ownerNameId: zast.nameid
            name: "null"
            typetype: ztypes.ztypetype.nullType
        )
    } else null
    lowerGenerators ty: st.typing reg: st.reg :program
    # the main unit's passes run in the main unit's frame; a walk that enters
    # another declaration sets its own and restores this one
    match (
        program
    ) case program then {
        mro9: (st.typing.declFindChild
            parentDeclId: st.typing.programRoot
            nameId: (nameIdOf ast: program.ast name: program.mainUnitName.stringview)
        )
        if (mro9.isZero) == false then st.typing.curFrame = mro9
    } else null
    registerAndResolveMain ty: st.typing reg: st.reg :program
    resolveMainUnitInstantiations ty: st.typing reg: st.reg :program
    scanMainBodyCalls ty: st.typing reg: st.reg :program rootOnly9: (st.typing.eagerAll) == false
    demandAllDefs ty: st.typing :program
    resolveDemands ty: st.typing reg: st.reg :program
    match (
        program
    ) case program then {
        ud8x9: unitDeclOfName ty: st.typing ast: program.ast name: program.mainUnitName.stringview
        (fixupCustomTags
            ast: program.ast
            ty: st.typing
            reg: st.reg
            unitDecl: ud8x9
        )
    } else null
    match (
        program
    ) case program then {
        seedPlatformConsts ast: program.ast ty: st.typing reg: st.reg
    } else null
    resolveConstantDefs ty: st.typing reg: st.reg :program
    completeUnitInstantiations ty: st.typing reg: st.reg :program
    applyUnitVisibility ty: st.typing reg: st.reg :program
    stampTyperefs ty: st.typing reg: st.reg :program
    checkBodies :st :program
    # AFTER checkBodies: whether a program reaches a unit is not settled until
    # its bodies have been walked -- `x: 1.5.f128` is what pulls quadfloat in,
    # and nothing before this point knows that. Running earlier made every
    # require: block a claim about every program.
    checkRequireBlocks ty: st.typing reg: st.reg :program
    walkGenericUnitTemplates :st :program
    match (
        program
    ) case program then {
        (stampCtorDefaults
            ast: program.ast
            :st
            unitDecl: (unitDeclOfName
                ty: st.typing
                ast: program.ast
                name: program.mainUnitName.stringview
            )
        )
    } else null
    foldLiteralStamps :st :program
    match (
        program
    ) case program then {
        (canonicalizeShellChildren
            ast: program.ast
            :st
            unitDecl: (unitDeclOfName
                ty: st.typing
                ast: program.ast
                name: program.mainUnitName.stringview
            )
        )
        (canonicalizeShellNodeStamps
            ast: program.ast
            :st
            unitDecl: (unitDeclOfName
                ty: st.typing
                ast: program.ast
                name: program.mainUnitName.stringview
            )
        )
        checkAnyBounds ast: program.ast :st
    } else null
    st.typing.curFrame = ztypes.declid
    return st
}
