# zfmtcursor -- the formatter's token cursor: the raw token stream of one
# source (whitespace, comments and newlines included) with a byte offset per
# token, walked in lockstep with the syntax tree. The builder asks for the next
# SIGNIFICANT token and expects its kind; the trivia between two significant
# tokens is reported as newline counts and comment tokens for the builder to
# place. A kind the tree did not predict is a lockstep failure, recorded once,
# after which every expectation answers the failure -- the caller refuses the
# file rather than printing a guess. A comment the builder never asked for is
# counted too, and a count above zero refuses the file the same way.

# Public interface -- the definitions other units may reference; all
# other top-level definitions are private to this unit.
public: unit {
    :Cursor
    :gapinfo
}

# what lies between the last consumed significant token and the next one
gapinfo: record {
    # whether the gap begins with a newline before any comment: the author's
    # "keep expanded" marker after an opening delimiter
    newlineFirst: bool
    # whether the first comment sits on the previous token's line
    trailing: bool
    # the comments, as a window into Cursor.gapComments and gapEols
    first: u32
    # how many comments the gap holds
    count: u32
    # the newlines after the last comment, or since the previous token when
    # there is none
    eolsEnd: u32
}

# isTrivia -- a token the tree never names: whitespace, a newline, a comment
# or a statement separator
isTrivia: function {tt: zlexer.toktype} out bool is {
    match (
        tt
    ) case wsTok then {
        return true
    } case eolTok then {
        return true
    } case commentTok then {
        return true
    } case semicolonTok then {
        return true
    } else {
        return false
    }
}

# kindName -- a token kind spelled as its arm name, for a lockstep failure
# message
kindName: function {tt: zlexer.toktype} out String is {
    match (
        tt
    ) case bofTok then {
        return "bofTok".string
    } case eofTok then {
        return "eofTok".string
    } case errTok then {
        return "errTok".string
    } case wsTok then {
        return "wsTok".string
    } case eolTok then {
        return "eolTok".string
    } case commentTok then {
        return "commentTok".string
    } case colonTok then {
        return "colonTok".string
    } case semicolonTok then {
        return "semicolonTok".string
    } case parenOpenTok then {
        return "parenOpenTok".string
    } case parenCloseTok then {
        return "parenCloseTok".string
    } case braceOpenTok then {
        return "braceOpenTok".string
    } case braceCloseTok then {
        return "braceCloseTok".string
    } case dotTok then {
        return "dotTok".string
    } case refIdTok then {
        return "refIdTok".string
    } case labelTok then {
        return "labelTok".string
    } case labelPreTok then {
        return "labelPreTok".string
    } case reservedLabelTok then {
        return "reservedLabelTok".string
    } case reservedLabelPreTok then {
        return "reservedLabelPreTok".string
    } case equalsTok then {
        return "equalsTok".string
    } case functionTok then {
        return "functionTok".string
    } case ifTok then {
        return "ifTok".string
    } case whenTok then {
        return "whenTok".string
    } case thenTok then {
        return "thenTok".string
    } case elseTok then {
        return "elseTok".string
    } case forTok then {
        return "forTok".string
    } case eachTok then {
        return "eachTok".string
    } case loopTok then {
        return "loopTok".string
    } case whileTok then {
        return "whileTok".string
    } case doTok then {
        return "doTok".string
    } case caseTok then {
        return "caseTok".string
    } case matchTok then {
        return "matchTok".string
    } case onTok then {
        return "onTok".string
    } case outTok then {
        return "outTok".string
    } case outxTok then {
        return "outxTok".string
    } case inTok then {
        return "inTok".string
    } case swapTok then {
        return "swapTok".string
    } case unitTok then {
        return "unitTok".string
    } case recordTok then {
        return "recordTok".string
    } case classTok then {
        return "classTok".string
    } case unionTok then {
        return "unionTok".string
    } case variantTok then {
        return "variantTok".string
    } case protocolTok then {
        return "protocolTok".string
    } case dataTok then {
        return "dataTok".string
    } case choiceTok then {
        return "choiceTok".string
    } case listTok then {
        return "listTok".string
    } case isTok then {
        return "isTok".string
    } case asTok then {
        return "asTok".string
    } case withTok then {
        return "withTok".string
    } case facetTok then {
        return "facetTok".string
    } case generatorTok then {
        return "generatorTok".string
    } case typedefTok then {
        return "typedefTok".string
    } case nativeTok then {
        return "nativeTok".string
    } case takeTok then {
        return "takeTok".string
    } case borrowTok then {
        return "borrowTok".string
    } case viewTok then {
        return "viewTok".string
    } case holdTok then {
        return "holdTok".string
    } case dropTok then {
        return "dropTok".string
    } case privateTok then {
        return "privateTok".string
    } case genericTok then {
        return "genericTok".string
    } case implementTok then {
        return "implementTok".string
    } case strBegTok then {
        return "strBegTok".string
    } case strMidTok then {
        return "strMidTok".string
    } case strChrTok then {
        return "strChrTok".string
    } case strEndTok then {
        return "strEndTok".string
    } case strExprBegTok then {
        return "strExprBegTok".string
    }
}

# the raw token stream of one source and the tree walk's position in it
Cursor: class {
    # every token of the source, trivia included, ending with the EOF token
    toks: ListVal tokenize.token
    # the pool the tokens' texts are interned in: the scan's own, so a text
    # is compared with a tree name by its bytes
    pool: zast.StringPool
    # each token's first byte, plus one more entry holding the source length
    lo: ListVal u64
    # the next raw index, which trivia skipping moves past
    i: u64
    # the last consumed significant token
    prev: u64
    # whether any significant token was consumed yet
    hasPrev: bool
    # the raw index up to which trivia was reported to the builder
    reported: u64
    # parentheses skipped on the way in and not yet closed. Brackets nest, so a
    # depth is all the walk needs: the value that ENDS where a closer sits
    # consumes it, which need not be the value that skipped the opener
    openParens: u32
    # every reported comment's raw index, end to end
    gapComments: ListVal u64
    # the newlines before each reported comment, parallel to gapComments
    gapEols: ListVal u32
    # comments the builder consumed a token past without asking for
    lostComments: u64
    # whether a lockstep failure was recorded
    failed: bool
    # the line of the first failure
    failLine: u32
    # the column of the first failure
    failCol: u32
    # what the first failure expected and found
    failMsg: String
} as {
    # a cursor at the first token of `source`, over its scanned tokens, whose
    # texts live in `pool`
    create: function {
        toks: (ListVal tokenize.token).take
        pool: zast.StringPool.take
        source: StringView
    } out this is {
        lo: byteOffsetsOf :toks :source
        return (
            meta.create
            :toks
            :pool
            :lo
            i: 0
            prev: 0
            hasPrev: false
            reported: 0
            openParens: 0
            gapComments: ListVal u64
            gapEols: ListVal u32
            lostComments: 0
            failed: false
            failLine: 0
            failCol: 0
            failMsg: String
        )
    }

    # count -- how many raw tokens there are, the EOF token included
    count: function {t: this.view} out u64 is {
        return t.toks.length
    }

    # rawKind -- the kind of raw token `k`
    rawKind: function {t: this.view k: u64} out zlexer.toktype is {
        return (t.toks.get i: k).toktype
    }

    # textEq -- whether raw token `k` spells `s`
    textEq: function {t: this.view k: u64 s: StringView} out bool is {
        return (zast.poolTextEq pool: t.pool ref: (t.toks.get i: k).text :s)
    }

    # peekTextIs -- whether the next significant token spells `s`
    peekTextIs: function {t: this s: StringView} out bool is {
        t.skipTrivia
        return (t.textEq k: t.i :s)
    }

    # rawLo -- the first byte of raw token `k`
    rawLo: function {t: this.view k: u64} out u64 is {
        return (t.lo.get i: k)
    }

    # rawHi -- one past the last byte of raw token `k`
    rawHi: function {t: this.view k: u64} out u64 is {
        return (t.lo.get i: k + 1)
    }

    # rawLine -- the line raw token `k` starts on
    rawLine: function {t: this.view k: u64} out u32 is {
        return (t.toks.get i: k).lineno
    }

    # skipTrivia -- move past the trivia before the next significant token
    skipTrivia: function {t: this} is {
        n: t.toks.length
        for (t.i + 1) < n loop {
            tt: (t.toks.get i: t.i).toktype
            if (isTrivia :tt).not then break
            t.i = t.i + 1
        }
    }

    # peekIndex -- the raw index of the next significant token
    peekIndex: function {t: this} out u64 is {
        t.skipTrivia
        return t.i
    }

    # peekKind -- the kind of the next significant token
    peekKind: function {t: this} out zlexer.toktype is {
        t.skipTrivia
        return (t.toks.get i: t.i).toktype
    }

    # atEof -- whether every significant token was consumed
    atEof: function {t: this} out bool is {
        return t.peekKind == zlexer.toktype.eofTok
    }

    # note -- record the first lockstep failure at the next raw token
    note: function {t: this msg: String.take} is {
        if t.failed then return
        t.failed = true
        tok: t.toks.get i: t.i
        t.failLine = tok.lineno
        t.failCol = tok.colno
        t.failMsg = msg.take
    }

    # consume -- the raw token at the cursor, as its index
    consume: function {t: this} out u64 is {
        k: t.i
        n: t.toks.length
        if (k + 1) >= n then return n
        t.i = k + 1
        return k
    }

    # takeRaw -- consume the next raw token whatever it is, for the string
    # walk, which reads chunks and newlines the tree does not name. The token
    # becomes the last consumed one, so a gap read after the literal starts
    # past its closing delimiter and the newlines inside it are never counted
    # as blank lines
    takeRaw: function {t: this} out u64 is {
        k: t.consume
        t.prev = k
        t.hasPrev = true
        return k
    }

    # holeSpansLines -- the interpolation hole whose `{` is the next raw token
    # holds a line break or a comment before its matching `}`
    holeSpansLines: function {t: this.view} out bool is {
        k: t.i
        depth: u64
        for k < t.toks.length loop {
            tt: (t.toks.get i: k).toktype
            if tt == zlexer.toktype.braceOpenTok then depth = depth + 1
            if tt == zlexer.toktype.braceCloseTok then {
                if depth <= 1 then return false
                depth = depth - 1
            }
            if (tt == zlexer.toktype.eolTok) or (tt == zlexer.toktype.commentTok) then return true
            if tt == zlexer.toktype.eofTok then return false
            k = k + 1
        }
        return false
    }

    # takeHoleRaw -- consume the interpolation hole at the cursor raw, through
    # its matching `}`: the caller copies it as written, so the comments in it
    # are placed, not lost. Answers the `}`'s index
    takeHoleRaw: function {t: this} out u64 is {
        depth: u64
        last: t.i
        for t.i < t.toks.length loop {
            tt: (t.toks.get i: t.i).toktype
            last = t.takeRaw
            if tt == zlexer.toktype.braceOpenTok then depth = depth + 1
            if tt == zlexer.toktype.braceCloseTok then {
                if depth <= 1 then break
                depth = depth - 1
            }
            if tt == zlexer.toktype.eofTok then break
        }
        t.reported = t.i
        return last
    }

    # expect -- consume the next significant token, which must be `tt`; on a
    # mismatch the failure is recorded and the EOF index answers, so the
    # builder can finish and the caller can refuse the file
    expect: function {t: this tt: zlexer.toktype} out u64 is {
        t.skipTrivia
        n: t.toks.length
        got: (t.toks.get i: t.i).toktype
        if got != tt then {
            en: kindName :tt
            gn: kindName tt: got
            t.note msg: "expected \{en}, found \{gn}"
            return n
        }
        t.countLost
        k: t.consume
        t.prev = k
        t.hasPrev = true
        return k
    }

    # countLost -- comments between the last report and the cursor that no
    # gap request covered
    countLost: function {t: this} is {
        k: t.reported
        for k < t.i loop {
            if (t.toks.get i: k).toktype == zlexer.toktype.commentTok then {
                t.lostComments = t.lostComments + 1
            }
            k = k + 1
        }
        t.reported = t.i
    }

    # gap -- the trivia between the last consumed significant token and the
    # next one, its comments appended to gapComments / gapEols
    gap: function {t: this} out gapinfo is {
        t.skipTrivia
        stop: t.i
        k: t.reported
        if t.hasPrev when (t.prev + 1) > k then k = t.prev + 1
        info: (
            gapinfo
            newlineFirst: false
            trailing: false
            first: t.gapComments.length.u32.orPanic
            count: 0
            eolsEnd: 0
        )
        eols: u32
        sawNonWs: false
        for k < stop loop {
            tt: (t.toks.get i: k).toktype
            if tt == zlexer.toktype.eolTok then {
                if sawNonWs.not then info.newlineFirst = true
                sawNonWs = true
                eols = eols + 1
            } else if tt == zlexer.toktype.commentTok then {
                if info.count == 0 when eols == 0 when t.hasPrev then info.trailing = true
                sawNonWs = true
                t.gapComments.append k
                t.gapEols.append eols
                info.count = info.count + 1
                eols = 0
            } else if tt == zlexer.toktype.semicolonTok then sawNonWs = true
            k = k + 1
        }
        info.eolsEnd = eols
        t.reported = stop
        return info
    }

    # gapHasComment -- whether a comment sits between the last consumed
    # significant token and the next one, read without reporting the gap
    gapHasComment: function {t: this} out bool is {
        t.skipTrivia
        k: t.reported
        if t.hasPrev when (t.prev + 1) > k then k = t.prev + 1
        for k < t.i loop {
            if (t.toks.get i: k).toktype == zlexer.toktype.commentTok then return true
            k = k + 1
        }
        return false
    }

    # commentAt -- the raw index of the j-th comment of a gap
    commentAt: function {t: this.view info: gapinfo j: u32} out u64 is {
        return (t.gapComments.get i: info.first + j)
    }

    # commentEols -- the newlines before the j-th comment of a gap
    commentEols: function {t: this.view info: gapinfo j: u32} out u32 is {
        return (t.gapEols.get i: info.first + j)
    }
}

# byteOffsetsOf -- each token's first byte, with one extra entry holding the
# source length (EOF stands at it)
byteOffsetsOf: function {
    toks: (ListVal tokenize.token).view
    source: StringView
} out ListVal u64 is {
    offs: ListVal u64
    n: source.length
    for each t: toks loop {
        if t.toktype == zlexer.toktype.eofTok then {
            offs.append n
        } else {
            offs.append t.offset
        }
    }
    offs.append n
    return offs
}
