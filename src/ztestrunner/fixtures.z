# fixtures -- the FIXTURES kind (in every full run, and `--only fixtures`):
# what the fixtures themselves must hold.
#   cases    every example and emitc_corpus program that declares `main` is in a
#            case list (run, smoke or dump), so something compiles it, and no
#            list names a case twice (the runner would build and run it twice)
#   params   no generic parameter of an example, a corpus program or an error
#            fixture has a case other than its bound's (`zl lint`, L023), which
#            no lint gate over the compiler's own source reads
# A subunit of ztestrunner.

# caseLists -- the case lists, under tests/fixtures
caseLists: list { "run_cases.txt" "smoke_cases.txt" "dump_cases.txt" } out staticlist StringView

# runFixtureCases -- the fixtures kind
runFixtureCases: function {r: Runner} is {
    bad: (checkCaseLists :r) + (checkGenericParams :r)
    if bad > 0 then {
        r.fails = r.fails + bad
        return
    }
    r.passN = r.passN + 2
}

# checkCaseLists -- the cases check; answers how many cases break it
checkCaseLists: function {r: Runner.view} out u64 is {
    bad: u64
    listed: List String
    for each l: caseLists loop {
        names: caseNames path: "\{r.root}/tests/fixtures/\{l}".stringView
        seen: List String
        for each n: names loop {
            if (seen.contains item: n) then {
                print "FAIL(fixtures) cases: \{n} is listed twice in tests/fixtures/\{l} -- the runner would build and run it twice; delete one line"
                bad = bad + 1
            } else seen.append n.copy
            listed.append n.copy
        }
    }
    for each d: (listOfDirs a: r.examplesDir.stringView b: r.corpusDir.stringView) loop {
        for each n: (fixtureNames dir: d.stringView suffix: ".z") loop {
            path: "\{d}/\{n}.z"
            if (declaresMain path: path.stringView) when (listed.contains item: n).false then {
                print "FAIL(fixtures) cases: \{n} declares main but is in no case list -- nothing compiles it. Add it to run_cases.txt with a tests/fixtures/run_golden/<name>.out, or to smoke_cases.txt when its output depends on the machine (build only)"
                bad = bad + 1
            }
        }
    }
    return bad
}

# listOfDirs -- the directories `a` and `b`
listOfDirs: function {a: StringView b: StringView} out List String is {
    l: List String
    l.append a.string
    l.append b.string
    return l
}

# caseNames -- the first word of each line of the case list at `path`, `#`
# lines and empty ones left out
caseNames: function {path: StringView} out List String is {
    names: List String
    text: slurp :path
    for each ln: text.stringView.lines loop {
        l: ln.trim
        if (l.length == 0) or (l.startsWith "#") then continue
        sp: (l.indexOf " ").or d: l.length
        names.append (l.substring from: 0 to: sp).string
    }
    return names
}

# checkGenericParams -- the params check: one `zl lint --counts` over the
# examples, the corpus and the error fixtures; answers how many files hold an
# L023 finding
checkGenericParams: function {r: Runner.view} out u64 is {
    argv: List String
    argv.append "\{r.root}/bin/zl"
    argv.append "lint".string
    argv.append "--counts".string
    errorsDir: "\{r.root}/tests/fixtures/errors"
    for each d: (listOfDirs a: r.examplesDir.stringView b: r.corpusDir.stringView) loop {
        for each n: (fixtureNames dir: d.stringView suffix: ".z") loop argv.append "\{d}/\{n}.z"
    }
    for each n: (fixtureNames dir: errorsDir.stringView suffix: ".z"
    ) loop argv.append "\{errorsDir}/\{n}.z"
    rowsFile: "\{r.tmp}/fixtures-lint.out"
    rc: (
        os.spawn
        :argv
        cwd: ""
        outPath: rowsFile.stringView
        errPath: os.nullDevice.stringView
        timeoutSecs: r.timeoutSecs
    )
    if (rc != 0) and (rc != 1) then {
        print "FAIL(fixtures) params: zl lint did not run (exit \{rc})"
        return 1
    }
    rows: slurp path: rowsFile.stringView
    bad: u64
    for each l: rows.stringView.lines loop {
        if l.startsWith "L023 " then {
            row: l.substring from: 5 to: l.length
            sp: (row.lastIndexOf " ").or d: row.length
            n: row.substring from: (minOf a: sp + 1 b: row.length) to: row.length
            print "FAIL(fixtures) params: \{(
                row.substring
                from: 0
                to: sp
            )}: \{n} generic parameter(s) whose case does not follow their bound's -- see docs/styleguide.pdoc, Generic Parameters"
            bad = bad + 1
        }
    }
    return bad
}

# minOf -- the smaller of `a` and `b`
minOf: function {a: u64 b: u64} out u64 is {
    if a < b then return a
    return b
}
