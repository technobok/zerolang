# conform -- specs, implementations, markers, bounds and value operations. An
# implementation subunit of ztypecheck.

# definingSiteFor -- the site that defines `name` for a reference in
# `unitDecl`: the environment walk over the unit's own scope, then the
# prelude, where a hit is a re-export and the defining unit is the one its
# dotted value names. The Decl the walk hit rides along because a re-export
# may RENAME its target -- `List: collections.ListRef` puts no `List` in
# `collections`, so the unit alone cannot resolve it and only the alias Decl
# knows what it stands for. An absent site means neither scope indexes the
# name (generic params, this/numerics, forward refs to a nonexistent type) --
# the caller then mints a shell exactly as before.
definingSiteFor: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
    scope: ztypes.declid
    name: StringView
} out defsite is {
    return (
        resolve.definingSiteForId
        :st
        :ast
        :unitDecl
        :scope
        nameId: (zast.poolFind pool: ast.names text: name)
    )
}

# markerText -- a field or parameter marker's source spelling, for diagnostics.
markerText: function {o: ztypes.zparamownership} out String is {
    match (
        o
    ) case noneMode then {
        return "".string
    } case takeMode then {
        return "take".string
    } case borrowMode then {
        return "borrow".string
    } case viewMode then {
        return "view".string
    } case holdMode then {
        return "hold".string
    }
}

# see isStringViewMember.
isListViewMember: function {nameId: zast.nameid} out bool is {
    if nameId == zast.wellKnown.slot.wkListView then return true
    # `Bytes.byteView` is its base's listView, re-typed: the typedef shares the
    # base's representation
    return nameId == zast.wellKnown.slot.wkByteView
}

# lacksZero -- the type has no zero value: a data type (a handle to a value the
# compiler built), or a valtype whose zero holds one -- a record with such a
# field, a variant whose first arm (its zero) carries one, an array of one, a
# typedef over one.
lacksZero: function {
    st: zenv.ZSymbolTable.view tid: ztypes.tid seen: ListVal ztypes.tid
} out bool is {
    if tid.isZero or (seen.contains item: tid) then return false
    seen.append tid
    if (st.reg.isStaticOf :tid) then return true
    if (st.reg.typetypeOf typeId: tid) == ztypes.ztypetype.variantType then {
        od: st.typing.declIdOfType typeId: tid
        if od.isZero or ((st.typing.declChildSlots declId: od) == 0) then return false
        a0: st.typing.declChildAt declId: od index: 0
        if a0.isZero then return false
        return (lacksZero :st tid: (st.typing.decls.get i: a0).typeId :seen)
    }
    parts: ListVal ztypes.tid
    valPartTids reg: st.reg typing: st.typing :tid :parts
    for each pt: parts loop {
        if (lacksZero :st tid: pt :seen) then return true
    }
    return false
}

# typedefChaseTid -- the chain-end base tid of a typedef (tid itself when it
# is not one): a typedef behaves exactly as its base wherever its ownership,
# equality, casts or C layout are asked.
typedefChaseTid: function {typing: ztyping.ZTyping.view tid: ztypes.tid} out ztypes.tid is {
    cur: tid
    for true loop {
        b: typing.typedefBaseTidOf tid: cur
        if b.isZero then break
        cur = b
    }
    return cur
}

# typedefLinkDeclaring -- the first link of `tid`'s typedef chain that declares
# the member `name` -- `tid` itself, or a base it hands the member on to -- else
# the chain's end, whose conversions and lenient members answer for it. A
# typedef's own member wins over its base's (the spec), and one it hides
# (`twice: null`) is its own declaration too. Read off the declarations, so a
# member still resolving counts. Every chain ends: a typedef of itself is
# refused, and no base is recorded for it (refuseTypedefOfItself).
typedefLinkDeclaring: function {
    typing: ztyping.ZTyping.view tid: ztypes.tid name: zast.nameid
} out ztypes.tid is {
    cur: tid
    for (typing.declMemberIdOf parentTypeId: cur nameId: name).isZero loop {
        b: typing.typedefBaseTidOf tid: cur
        if b.isZero then return cur
        cur = b
    }
    return cur
}

# typedefDeclaredMember -- the type of the member `name` that a typedef link of
# `tid`'s chain declares (typedefLinkDeclaring); 0 when only the chain's end
# could -- `tid` is no typedef, or no typedef link declares it.
typedefDeclaredMember: function {
    typing: ztyping.ZTyping.view tid: ztypes.tid name: zast.nameid
} out ztypes.tid is {
    link: typedefLinkDeclaring :typing :tid :name
    if (typing.typedefBaseTidOf tid: link).isZero then return ztypes.tid.zero
    return ((typing.declChildOfId parentTypeId: link nameId: name).or d: ztypes.tid.zero)
}

# forceMemberDecl -- resolve one member's signature on demand: the rung below
# descendNamed. The grey / black marks are read off the MEMBER's own Decl rather
# than its type's, because the conversion lattice cycles through members --
# u8's `.i128` names i128, whose `.u8` names u8 -- and a member reached while its
# owner is still resolving is not the owner's back-edge.
forceMemberDecl: function {
    st: zenv.ZSymbolTable
    ast: Ast
    memberDeclId: ztypes.declid
} out optionval ztypes.tid is {
    isM: false
    have: ztypes.tid
    mnm: zast.nameid
    mnd: zast.nodeid
    par: ztypes.declid
    memberDecl: st.typing.decls.get i: memberDeclId
    if memberDecl.kind.methodDecl then isM = true
    have = memberDecl.typeId
    mnm = memberDecl.name
    mnd = memberDecl.node
    par = memberDecl.parent
    memberDecl.drop
    if have.notZero then return (optionval.some have)
    if (st.typing.declIsResolved declId: memberDeclId) then return (optionval.none ztypes.tid)
    if (st.typing.declIsResolving declId: memberDeclId) then return (optionval.none ztypes.tid)
    if mnd.isZero then return (optionval.none ztypes.tid)
    otid: ztypes.tid
    onm: zast.nameid
    po: st.typing.decls.get i: par
    otid = po.typeId
    onm = po.name
    po.drop
    if otid.isZero then return (optionval.none ztypes.tid)
    opId: zast.nodeid
    nn: ast.nodes.get i: mnd
    if nn.namedoperation then opId = nn.operation
    if opId.isZero then return (optionval.none ztypes.tid)
    unD: resolve.unitDeclOfTid reg: st.reg typing: st.typing tid: otid
    if unD.isZero then return (optionval.none ztypes.tid)
    st.typing.declSetResolving declId: memberDeclId mark: true
    memberIdAt: optionval.none ztypes.tid
    # THE SIGNATURE IS THE OWNER'S, NOT THE CALLER'S. A member's types are
    # written where the member is, so they resolve in the declaration that owns
    # it: a caller in another unit that declares a same-named type of its own
    # otherwise had the parameter resolve to ITS type, and `q1 == q2` was
    # refused as "expected point, got point".
    sigScope: par
    if isM then {
        memberIdAt = (
            declare.resolveMethodFn
            :st
            scope: sigScope
            :ast
            unitDecl: unD
            ownerNameId: onm
            mnameId: mnm
            thisName: onm
            :opId
        )
    } else if (memberaccess.asMemberIsAlias :st :ast tdecl: par md: memberDeclId).not then {
        # an as-block MARKER designates a type rather than declaring a field;
        # an alias names a type, and is no member a value carries
        memberIdAt = (
            markerTargetId
            :st
            scope: sigScope
            unitDecl: unD
            :ast
            opNid: opId
            ownerDecl: (st.typing.declIdOfType typeId: otid)
        )
    }
    st.typing.declSetResolving declId: memberDeclId mark: false
    st.typing.declSetResolved declId: memberDeclId
    match (
        memberIdAt
    ) case some then null case none then null
    if memberIdAt.some then {
        if isM then (
            resolve.stampMemberSignature
            :st
            scope: sigScope
            :ast
            unitDecl: unD
            thisName: onm
            ownerTid: otid
            fnNodeId: opId
            mid: memberIdAt
        )
        st.typing.setMemberType parentTypeId: otid nameId: mnm childTypeId: memberIdAt
        return (optionval.some memberIdAt)
    }
    return (optionval.none ztypes.tid)
}

# forceAllMembers -- every member signature of `tid`, in declaration order. The
# WALK demand point: a caller reading a member LIST (the mono clone, the
# emitter's member tables) cannot name what it has not seen, and an unresolved
# member carries no type so declChildWalk skips it silently.
forceAllMembers: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tid: ztypes.tid
} is {
    # `--eager` resolved every declaration up front -- but a generic template a
    # body first reaches is instantiated before its unit's turn, and the copy
    # needs its members now
    if st.typing.eagerAll when (st.reg.isGenericOf :tid).not then return
    od: st.typing.declIdOfType typeId: tid
    if od.isZero then return
    n: st.typing.declChildSlots declId: od
    i: u64
    for i < n loop {
        did: st.typing.declChildAt declId: od index: i
        i = i + 1
        if did.notZero then {
            forceMemberDecl :st :ast memberDeclId: did
        }
    }
}

# forceSpecMembers -- the members of `impl` that the spec `spec` names: what a
# implementation compares and its vtable wrapper calls, and no more. Forcing every
# member of the implementer instead made each program resolve all of String's,
# text's and str's members for their one `stringView`, and through those
# signatures the collection families. A typedef forwards its members to its
# base, so each name is forced along the chain, as markSpecMembersUsed marks it.
forceSpecMembers: function {
    st: zenv.ZSymbolTable
    ast: Ast
    impl: ztypes.tid
    spec: ztypes.tid
} is {
    # `--eager` resolved every declaration up front, a generic template's
    # members aside (forceAllMembers)
    if st.typing.eagerAll when (st.reg.isGenericOf tid: impl).not then return
    sd: st.typing.declIdOfType typeId: spec
    if sd.isZero then return
    n: st.typing.declChildSlots declId: sd
    i: u64
    for i < n loop {
        did: st.typing.declChildAt declId: sd index: i
        i = i + 1
        if did.notZero then {
            mn: (st.typing.decls.get i: did).name
            t: impl
            for t.notZero loop {
                md: st.typing.declMemberIdOf parentTypeId: t nameId: mn
                if md.notZero then forceMemberDecl :st :ast memberDeclId: md
                t = st.typing.typedefBaseTidOf tid: t
            }
        }
    }
}

# forceAllFields -- every FIELD signature of `tid`, in declaration order: the
# members a field walk consumes. A methodDecl is skipped unless it holds a
# function-pointer slot (an is-block `function {..} out T` with no body), which
# a field filter counts as a field. `fnptrField` is a declaration flag written
# before any signature resolves, so the test forces nothing itself. A method's
# own signature stays unresolved, and that is not a hole: a field filter admits
# a member only to find a FUNCTION type and drop it, which is exactly what it
# does with the type 0 an unresolved member carries.
forceAllFields: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tid: ztypes.tid
} is {
    if st.typing.eagerAll then return
    od: st.typing.declIdOfType typeId: tid
    if od.isZero then return
    n: st.typing.declChildSlots declId: od
    i: u64
    for i < n loop {
        did: st.typing.declChildAt declId: od index: i
        i = i + 1
        if did.notZero then {
            want: true
            memberDecl: st.typing.decls.get i: did
            if memberDecl.kind.methodDecl when memberDecl.fnptrField.not then want = false
            memberDecl.drop
            if want then {
                forceMemberDecl :st :ast memberDeclId: did
            }
        }
    }
}

# markerTargetId -- the FACET/PROTOCOL type an implementation as-item points at
# (`m: measurable` / `myreader: Reader`), or none for a method / `create: null` /
# any other as-item. A marker is a reference: its target resolves on discovery,
# depth-first, before anything is asked of it -- the implementer's destructor
# follows the target's, which exists only once the target's body resolved, so
# the order the two are written in cannot decide it. A type application
# (`g: (Getter v: i64)`) names an instance of a generic spec, resolved in
# `ownerDecl`, the implementing type, whose own parameters it may name.
# An `X.implement` item points at its X, and only when X is an interface; an
# item refused where it is written (refuseMisplacedImplement,
# reportAsItemTypeName) points at nothing.
markerTargetId: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    ast: Ast
    opNid: zast.nodeid
    ownerDecl: ztypes.declid
} out optionval ztypes.tid is {
    if (st.typing.refusedValues.has item: opNid) then return (optionval.none ztypes.tid)
    ib: zast.implementBaseOf :ast opId: opNid
    if ib.isZero then return (markerBaseTarget :st :unitDecl :scope :ast :opNid :ownerDecl)
    r: markerBaseTarget :st :unitDecl :scope :ast opNid: ib :ownerDecl
    if r.some when (specTypetypeOf :st tid: r).isInterface then return (optionval.some r)
    return (optionval.none ztypes.tid)
}

# markerBaseTarget -- markerTargetId for an item written without `.implement`,
# or for the X of one written with it.
markerBaseTarget: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    ast: Ast
    opNid: zast.nodeid
    ownerDecl: ztypes.declid
} out optionval ztypes.tid is {
    tgt: opNid
    nameId: zast.nameid
    isApp: false
    isPath: false
    op: ast.nodes.get i: tgt
    nameId = atomNameId :ast n: op
    isApp = op.call
    isPath = op.dottedpath
    if isApp then return (markerApplicationTarget :st :unitDecl :scope :ast opNid: tgt :ownerDecl)
    # a marker through a unit (`r: pr.Rd`) names what the path does
    if isPath then return (
        markerFamilyTarget
        :st
        rid: (resolve.resolveDottedArgTid :st :scope :ast nid: tgt)
    )
    if nameId.isZero then return (optionval.none ztypes.tid)
    mnm: zast.nameTextCopy :ast ref: nameId
    duo: (definingSiteFor :st :scope :ast :unitDecl name: mnm.stringView).defUnit
    if duo.notZero then {
        resolve.descendNamed :st :scope :ast unitDecl: duo name: mnm.stringView
    }
    rr: resolve.resolvedByIds :st :ast :unitDecl name: nameId
    if rr.some then {
        return (markerFamilyTarget :st rid: rr)
    }
    # an interface another unit declares and this one reaches through the
    # environment -- core's `StringViewable` from collections -- is the one
    # the walk finds, as a type-ref's is. Any other type the walk finds is no
    # target: an item naming it is refused as such (asItemTypeNameRefused)
    wr: walkLookupTyperefById :st :scope :ast :unitDecl baseId: nameId
    if wr.some when (specTypetypeOf :st tid: wr).isInterface then return (optionval.some wr)
    return (optionval.none ztypes.tid)
}

# markerFamilyTarget -- a marker's resolved target, when its family is one a
# marker names: a facet, a protocol or a record.
markerFamilyTarget: function {
    st: zenv.ZSymbolTable.view rid: ztypes.tid
} out optionval ztypes.tid is {
    if rid.isZero then return (optionval.none ztypes.tid)
    tt: st.reg.typetypeOf typeId: rid
    match (
        tt
    ) case facetType then {
        return (optionval.some rid)
    } case protocolType then {
        return (optionval.some rid)
    } case recordType then {
        return (optionval.some rid)
    } else {
        return (optionval.none ztypes.tid)
    }
}

# markerApplicationTarget -- the spec instance a marker's type application
# names, resolved as the same application written in a signature is; none when
# it names no protocol or facet instance.
markerApplicationTarget: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    ast: Ast
    opNid: zast.nodeid
    ownerDecl: ztypes.declid
} out optionval ztypes.tid is {
    # only a generic template is applied: a head naming any other type is a
    # construction (`origin: (Pt x: 0)`), which reportAsConstruction refuses
    hc: statics.callRefAt :ast nid: opNid
    if hc.callable.notZero then {
        htpl: typeargs.typeApplicationTemplate :st :scope :ast :unitDecl callableNid: hc.callable
        if htpl.notZero when (st.reg.isGenericOf tid: htpl
        ).not then return (optionval.none ztypes.tid)
    }
    r: (
        resolve.resolveMonoRefInline
        :st
        :ast
        :unitDecl
        :scope
        thisName: zast.nameid
        enclDecl: ownerDecl
        :opNid
        nid: opNid
    )
    if r.isZero then return (optionval.none ztypes.tid)
    tt: specTypetypeOf :st tid: r
    if tt.isInterface then {
        return (optionval.some r)
    }
    return (optionval.none ztypes.tid)
}

# specTypetypeOf -- a spec's family. A PARTIAL instance (`(Getter v: t)`, over a
# parameter of the implementing type) wears the generic-parameter tag, so its
# family is its template's.
specTypetypeOf: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out ztypes.ztypetype is {
    if (st.reg.isPartialOf :tid) then {
        og: st.reg.genericOriginOf :tid
        if og.notZero then return (st.reg.typetypeOf typeId: og)
    }
    return (st.reg.typetypeOf typeId: tid)
}

# instanceConstantRead -- `memberDecl`, read on `bt` (a template's instance, or
# the template itself while an instance is walked), is a constant over the
# template's numeric parameter, which only an instance has a value for
# (instanceOnlyAsConstant).
instanceConstantRead: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    bt: ztypes.tid
    memberDecl: ztypes.declid
} out bool is {
    if memberDecl.isZero then return false
    tmpl: st.reg.genericOriginOf tid: bt
    if tmpl.isZero then tmpl = bt
    item: argRefAt :ast nid: (st.typing.decls.get i: memberDecl).node
    return (declare.instanceOnlyAsConstant :st :ast parentId: tmpl :item)
}

# recordImplementation -- record an impl-satisfies-spec implementation, but only when the
# spec resolves to a FACET or PROTOCOL (a RECORD marker like a numeric's `tag: tag` is a
# discriminator child, NOT an implementation). The helper C names (vtable/create/destroy/
# wrapper) are the emitter's and stay empty here.
#
# A FACET IS CONFORMED BY A VALTYPE, a protocol by a reftype, and the stdlib
# says so itself: `valhashable` is a facet and `RefHashable` is a protocol, the
# same constraint split by family. A facet value holds its implementer INLINE, in
# a union, so a reference one would put a reference inside a value.
recordImplementation: function {
    st: zenv.ZSymbolTable
    ast: Ast
    implTypeId: ztypes.tid
    specTypeId: ztypes.tid
    label: StringView
    labelNameId: zast.nameid
    # the marker's operation node, for the refusal's position
    markerOp: zast.nodeid
} is {
    # refused, the row is still recorded, as a reference type's facet row is
    # below: the marker is no field either way
    refuseGenericSpecMarker :st :ast :specTypeId :label :markerOp
    tt: specTypetypeOf :st tid: specTypeId
    recordIt: false
    isFacetC: false
    match (
        tt
    ) case facetType then {
        recordIt = true
        isFacetC = true
    } case protocolType then {
        recordIt = true
    } else null
    if isFacetC when (st.reg.isReftypeOf tid: implTypeId) then {
        rcin: specWrittenName :st :ast tid: implTypeId
        rcsn: specWrittenName :st :ast tid: specTypeId
        rcm: "'\{rcin}' is a reference type and cannot implement the facet '\{rcsn}'"
        rch: "a facet holds the value implementing it INLINE, so a reference one would put a reference inside a value; declare '\{rcsn}' a protocol, the way the stdlib pairs `valhashable` (a facet) with `RefHashable` (a protocol)"
        rcn: String
        rcnode: ast.nodes.getView i: markerOp
        (
            addErrorWithHint
            :st
            nodeid: markerOp
            lineno: (nodeLine n: rcnode)
            colno: (nodeCol n: rcnode)
            e: zast.err.typeError
            msg: rcm
            note: rcn
            hint: rch
            width: rcsn.length
        )
        # the row is still recorded: nothing is emitted once there is an error,
        # and a marker that is no implementation reads as an ordinary FIELD, which
        # made the construction below it report a missing argument as well
    }
    # a protocol's refused implementation is not recorded: it would be checked
    # for members a protocol never implements
    if recordIt when (refuseMarkerHolder :st :ast :implTypeId :specTypeId :markerOp) then return
    if recordIt then {
        st.typing.addImplementation :implTypeId :specTypeId :label :labelNameId isFacet: isFacetC
        # a marker names no member: implementing to one demands nothing of the type
        if (specIsMarker :st spec: specTypeId) then return
        markSpecMembersUsed :st impl: implTypeId spec: specTypeId
        # the spec's members, which checkImplementations compares the impl's with
        forceAllMembers :st :ast tid: specTypeId
        # the vtable wrapper names every member the spec names, and it is
        # emitted from the implementation row rather than from a use site, so
        # nothing else would ever demand those of the impl's signatures
        forceSpecMembers :st :ast impl: implTypeId spec: specTypeId
    }
}

# refuseGenericSpecMarker -- a marker naming a GENERIC spec itself (`g: Getter`,
# `:Getter`) names no interface a type can implement: each instance is its own.
# Refused at the marker, which is shown the instance form; nothing is inferred
# from the implementer's methods.
refuseGenericSpecMarker: function {
    st: zenv.ZSymbolTable
    ast: Ast
    specTypeId: ztypes.tid
    label: StringView
    markerOp: zast.nodeid
} is {
    stid: specTypeId
    if (st.reg.isGenericOf tid: stid).not then return
    stt: st.reg.typetypeOf typeId: stid
    if stt != ztypes.ztypetype.protocolType when stt != ztypes.ztypetype.facetType then return
    sn: specWrittenName :st :ast tid: stid
    ex: "\{label}: (\{sn}"
    td: st.typing.declIdOfType typeId: stid
    # the first argument is written without its label, every later one with it
    labelled: false
    for each pn: (st.reg.genericParamNamesOf tdecl: td) loop {
        cd: st.reg.genericParamConstraintOf tdecl: td paramName: pn
        arg: exampleArgFor :ast :cd
        if labelled then {
            ex.append " \{zast.nameTextAt :ast ref: pn}: \{arg}"
        } else {
            ex.append " \{arg}"
        }
        labelled = true
    }
    ex.append ").implement"
    n: ast.nodes.getView i: markerOp
    (
        addError
        :st
        nodeid: markerOp
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.typeError
        msg: "'\{sn}' is generic: name the instance this type implements, e.g. `\{ex}`"
    )
}

# exampleArgFor -- a type a parameter's bound admits, to show an instance form
# with: i64 for a value or unbounded one, String for a reference one, the
# bound itself when it names a declaration.
exampleArgFor: function {ast: Ast.view cd: ztypes.constraintdesc} out String is {
    if cd.kind == ztypes.constraintkind.refType then return "String".string
    if cd.kind == ztypes.constraintkind.refHashable then return "String".string
    if cd.kind == ztypes.constraintkind.stringLike then return "String".string
    if cd.kind == ztypes.constraintkind.other when cd.boundName.notZero then {
        return (zast.nameTextCopy :ast ref: cd.boundName)
    }
    return "i64".string
}

# implementationOwn -- a receiver's or a reftype parameter's marker as an
# implementation compares it: `.borrow` is the default a missing marker means,
# and a bare `:this` is recorded as one, so the two read alike.
implementationOwn: function {o: optionval ztypes.zparamownership} out ztypes.zparamownership is {
    r: o.or d: ztypes.zparamownership.noneMode
    if r == ztypes.zparamownership.borrowMode then return ztypes.zparamownership.noneMode
    return r
}

# implementationParamOwn -- the marker of the parameter `nameId` of method `mid`,
# of type `tid`, as an implementation compares it. A reftype parameter passes a
# reference marked `.borrow` or not, so the two read alike (implementationOwn).
# Any other parameter is a copy unmarked and goes by pointer marked `.borrow`
# (valtypeArgOwn), so the two differ, and the vtable's wrapper could not pass
# the one where the other is declared.
implementationParamOwn: function {
    st: zenv.ZSymbolTable.view
    mid: ztypes.tid
    nameId: zast.nameid
    tid: ztypes.tid
} out ztypes.zparamownership is {
    o: st.typing.declOwnershipOfId parentTypeId: mid :nameId
    if (st.reg.isReftypeOf :tid) then return (implementationOwn :o)
    return (o.or d: ztypes.zparamownership.noneMode)
}

# checkInstanceImplementations -- a generic template's implementation row, checked on
# each instance the program made (against the instance's own substituted
# methods), at the template's marker and in the template's name, each error
# carrying the instance note; the same failure in two instances is one error.
# An implementing instance gets its own row, as a generic typedef instance does. A
# template nothing instantiates is silent, as any unused declaration is. A
# native template's rows (str's `:StringViewable`) are its instances' already.
checkInstanceImplementations: function {
    st: zenv.ZSymbolTable
    ast: Ast
    # the template's row
    row: ztypes.confid
    markerOp: zast.nodeid
    implName: StringView
} is {
    tpl: ztypes.tid
    spec: ztypes.tid
    label: String
    labelNameId: zast.nameid
    isFacet: false
    crow: st.typing.implementation.get i: row
    tpl = crow.implTypeId
    spec = crow.specTypeId
    label = crow.label.copy
    labelNameId = crow.labelNameId
    isFacet = crow.isFacet
    crow.drop
    last: st.reg.nextTid
    t: ztypes.tid 1
    for t < last loop {
        mono: t
        t = t.next
        if (st.reg.genericOriginOf tid: mono) != tpl then continue
        # a partial is trie bookkeeping with no methods of its own
        if (st.reg.isPartialOf tid: mono) then continue
        errsBefore: st.typing.errors.length
        forceAllMembers :st :ast tid: mono
        # a spec over the template's own parameter is this instance's own
        instSpec: instanceSpecOf :st :mono :spec :labelNameId
        if instSpec.isZero then continue
        checkImplementationSignature :st :ast implTid: mono specTid: instSpec :markerOp :implName
        if st.typing.errors.length > errsBefore then {
            bodies.noteInstanceErrors :st :ast :mono from: errsBefore
        } else {
            # a failure another instance already reported is deduped away, so
            # this instance may still read as implementing; nothing is emitted
            # once there is an error
            (
                st.typing.addImplementation
                implTypeId: mono
                specTypeId: instSpec
                label: label.stringView
                :labelNameId
                :isFacet
            )
            markSpecMembersUsed :st impl: mono spec: instSpec
        }
    }
}

# instanceSpecOf -- the spec an instance of a generic implementer implements. A
# spec over the template's own parameter (`g: (Getter v: t)`) is partial, and
# each instance's is the one its marker member was substituted to -- `(Box i64)`'s
# `g` is `(Getter v: i64)`; any other spec is the template's own. 0 when the
# instance's is still partial, which has no methods to check.
instanceSpecOf: function {
    st: zenv.ZSymbolTable.view
    mono: ztypes.tid
    spec: ztypes.tid
    labelNameId: zast.nameid
} out ztypes.tid is {
    if (st.reg.isPartialOf tid: spec).not then return spec
    lid: labelNameId
    mto: st.typing.declChildOfId parentTypeId: mono nameId: lid
    mt: mto.or d: ztypes.tid.zero
    if mt.isZero or (st.reg.isPartialOf tid: mt) then return ztypes.tid.zero
    return mt
}

# implementationReceiverOwn -- a method's receiver marker, noneMode when it has
# none: the receiver thisParamNameIdOf names, or else the bare `:this`, which
# records no name. A spec receiver that resolution dropped reads unmarked.
implementationReceiverOwn: function {
    st: zenv.ZSymbolTable.view
    mid: ztypes.tid
} out ztypes.zparamownership is {
    rpn: st.reg.thisParamNameIdOf tid: mid
    rn: zast.wellKnown.slot.wkThis
    if rpn.notZero then rn = rpn
    return (implementationOwn o: (st.typing.declOwnershipOfId parentTypeId: mid nameId: rn))
}

# implementationParams -- a method's parameters in order, the receiver left out,
# as (type id, name id) pairs: what an implementer is compared on, position by
# position, the way the vtable wrapper forwards them.
implementationParams: function {
    st: zenv.ZSymbolTable.view
    mid: ztypes.tid
    ids: ListVal ztypes.tid
    nameIds: ListVal zast.nameid
} is {
    aids: ListVal ztypes.tid
    anms: ListVal zast.nameid
    dataFieldIds reg: st.reg typing: st.typing tid: mid ids: aids nameIds: anms
    rpn: st.reg.thisParamNameIdOf tid: mid
    i: u64
    for i < anms.length loop {
        pn: anms.get :i
        pt: aids.get :i
        i = i + 1
        if (pn == zast.wellKnown.slot.wkThis) or (rpn.notZero and (pn == rpn)) then continue
        ids.append pt
        nameIds.append pn
    }
}

# implementationReturnMarker -- the marker a method's return carries, as the
# source spells it: `view`, `borrow`, `hold`, or "" for none.
implementationReturnMarker: function {st: zenv.ZSymbolTable.view mid: ztypes.tid} out String is {
    m: st.typing.returnMarkerOf tid: mid
    if m == ztypes.zparamownership.viewMode then return "view".string
    if m == ztypes.zparamownership.borrowMode then return "borrow".string
    if m == ztypes.zparamownership.holdMode then return "hold".string
    return "".string
}

# implementationParamNoun -- "parameter" or "parameters", for a count in a message.
implementationParamNoun: function {n: u64} out String is {
    if n == 1 then return "parameter".string
    return "parameters".string
}

# implementationMarkerPhrase -- a marker for a message: `` `.view` `` or
# "unmarked".
implementationMarkerPhrase: function {m: StringView} out String is {
    if m.length == 0 then return "unmarked".string
    return "`.\{m}`"
}

# implementationSpecIsSelfTyped -- a spec member with a parameter of the
# interface's OWN type, the receiver excluded. It is no part of the
# dispatchable surface (the emitter's specMemberIsSelfTyped gives it no slot),
# so an implementer is not compared on it.
implementationSpecIsSelfTyped: function {
    st: zenv.ZSymbolTable.view
    specTid: ztypes.tid
    smid: ztypes.tid
} out bool is {
    sids: ListVal ztypes.tid
    snms: ListVal zast.nameid
    implementationParams :st mid: smid ids: sids nameIds: snms
    return (sids.contains item: specTid)
}

# checkImplementationSignature -- an explicit implementer implements each method its
# spec declares with the spec's own signature: present, the same arity, the
# same parameter and return types, and the same ownership marker on the
# receiver, on every parameter and on the return (`out` against `outx`
# included). Unmarked matches only unmarked; a stricter implementation is not
# a match. A call through the interface is checked against the SPEC, and the
# vtable wrapper forwards it to the implementation by name, so whatever the
# spec promises the implementation has to keep.
checkImplementationSignature: function {
    st: zenv.ZSymbolTable
    ast: Ast
    implTid: ztypes.tid
    specTid: ztypes.tid
    markerOp: zast.nodeid
    # the implementer as its messages name it: an instance is named by its
    # template, and its note says which instance
    implName: StringView
} is {
    slots: st.typing.declRowSlots ownerTid: specTid
    si: u64
    for si < slots loop {
        row: st.typing.declRowAt ownerTid: specTid membersOnly: true slot: si
        si = si + 1
        smid: row.tid
        if row.keep.not or (row.name == zast.wellKnown.slot.wkCreate) then continue
        if (st.reg.typetypeOf typeId: smid) != ztypes.ztypetype.functionType then continue
        if (implementationSpecIsSelfTyped :st :specTid :smid) then continue
        (
            checkImplementationMethod
            :st
            :ast
            :implTid
            :specTid
            :smid
            mnameId: row.name
            :markerOp
            :implName
        )
    }
}

# implementationReport -- an implementation finding, reported at the marker.
implementationReport: function {
    st: zenv.ZSymbolTable ast: Ast.view markerOp: zast.nodeid msg: String
} is {
    mnode: ast.nodes.getView i: markerOp
    (
        addError
        :st
        nodeid: markerOp
        lineno: (nodeLine n: mnode)
        colno: (nodeCol n: mnode)
        e: zast.err.typeError
        :msg
    )
}

# implementationImplMethod -- the method the implementer declares under the spec
# method's name, or 0 when it declares none (or declares a field there). A
# typedef's is its chain's first declarer: its own, or its base's, and a `null`
# shell that hides the base's is no method.
implementationImplMethod: function {
    st: zenv.ZSymbolTable.view
    implTid: ztypes.tid
    mnameId: zast.nameid
} out ztypes.tid is {
    r: ztypes.tid
    imo: (
        st.typing.declChildOfId
        parentTypeId: (valOpOwner typing: st.typing tid: implTid nameId: mnameId)
        nameId: mnameId
    )
    if imo.some then {
        r = imo
    }
    if r.notZero when (st.reg.typetypeOf typeId: r) != ztypes.ztypetype.functionType then {
        r = ztypes.tid.zero
    }
    return r
}

# checkImplementationMethod -- one spec method against the implementer's method of
# the same name: present, not generic, the same arity, then the receiver, the
# parameters and the return.
checkImplementationMethod: function {
    st: zenv.ZSymbolTable
    ast: Ast
    implTid: ztypes.tid
    specTid: ztypes.tid
    smid: ztypes.tid
    mnameId: zast.nameid
    markerOp: zast.nodeid
    implName: StringView
} is {
    specName: specWrittenName :st :ast tid: specTid
    mname: zast.poolTextAt pool: ast.names ref: mnameId
    imid: implementationImplMethod :st :implTid :mnameId
    if imid.isZero then {
        (
            implementationReport
            :st
            :ast
            :markerOp
            msg: "'\{implName}' implements \{specName} but does not define '\{mname}'"
        )
        return
    }
    if (st.reg.isGenericOf tid: imid) then {
        (
            implementationReport
            :st
            :ast
            :markerOp
            msg: "'\{implName}' implements \{specName}'s '\{mname}' with a generic method, where the spec's is not: an implementation takes the spec's own signature"
        )
        return
    }
    if (implementationTakesReceiver :st mid: imid).not when (
        specLacksReceiver
        :st
        :ast
        :specTid
        :mnameId
    ).not then {
        (
            implementationReport
            :st
            :ast
            :markerOp
            msg: "'\{implName}' implements \{specName}'s '\{mname}' with a function that takes no receiver, where the spec's takes one"
        )
        return
    }
    sids: ListVal ztypes.tid
    snms: ListVal zast.nameid
    implementationParams :st mid: smid ids: sids nameIds: snms
    iids: ListVal ztypes.tid
    inms: ListVal zast.nameid
    implementationParams :st mid: imid ids: iids nameIds: inms
    if sids.length != iids.length then {
        noun: implementationParamNoun n: iids.length
        (
            implementationReport
            :st
            :ast
            :markerOp
            msg: "'\{implName}' implements \{specName}'s '\{mname}' taking \{iids.length} \{noun}, where the spec's takes \{sids.length}"
        )
        return
    }
    srOwn: implementationReceiverOwn :st mid: smid
    irOwn: implementationReceiverOwn :st mid: imid
    if srOwn != irOwn then {
        srm: markerText o: srOwn
        irm: markerText o: irOwn
        srp: implementationMarkerPhrase m: srm.stringView
        irp: implementationMarkerPhrase m: irm.stringView
        (
            implementationReport
            :st
            :ast
            :markerOp
            msg: "'\{implName}' implements \{specName}'s '\{mname}' with a receiver that is \{irp}, where the spec's is \{srp}"
        )
    }
    pi: u64
    for pi < sids.length loop {
        (
            checkImplementationParam
            :st
            :ast
            :smid
            :imid
            spT: (sids.get i: pi)
            ipT: (iids.get i: pi)
            spN: (snms.get i: pi)
            ipN: (inms.get i: pi)
            :implName
            :specName
            :mname
            :markerOp
        )
        pi = pi + 1
    }
    if (specReturnUnresolved :st :ast :specTid :mnameId :smid).not then {
        checkImplementationReturn :st :ast :smid :imid :implName :specName :mname :markerOp
    }
}

# specReturnUnresolved -- the spec member declares an `out` whose type was
# never stamped. A typecheck that stopped short -- a refused generic argument
# -- need not have demanded the spec's members, and an unresolved return is
# no evidence: read as "nothing" it refused an implementer that matched.
specReturnUnresolved: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    specTid: ztypes.tid
    mnameId: zast.nameid
    smid: ztypes.tid
} out bool is {
    if (methodReturnOf reg: st.reg typing: st.typing mid: smid).some then return false
    md: st.typing.declMemberIdOf parentTypeId: specTid nameId: mnameId
    if md.isZero then return false
    fnode: valMemberFnNode :ast typing: st.typing memberDecl: md
    if fnode.isZero then return false
    fn: ast.nodes.getView i: fnode
    match (
        fn
    ) case functiondef then {
        return fn.returntype.notZero
    } else {
        return false
    }
}

# checkImplementationParam -- one parameter pair, in position: the same type and
# the same marker.
checkImplementationParam: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    smid: ztypes.tid
    imid: ztypes.tid
    spT: ztypes.tid
    ipT: ztypes.tid
    spN: zast.nameid
    ipN: zast.nameid
    implName: StringView
    specName: String.view
    mname: String.view
    markerOp: zast.nodeid
} is {
    pnm: zast.poolTextAt pool: ast.names ref: spN
    if spT != ipT then {
        stn: specWrittenName :st :ast tid: spT
        itn: specWrittenName :st :ast tid: ipT
        (
            implementationReport
            :st
            :ast
            :markerOp
            msg: "'\{implName}' implements \{specName}'s '\{mname}' with parameter '\{pnm}' of type \{itn}, where the spec's is \{stn}"
        )
    }
    spO: implementationParamOwn :st mid: smid nameId: spN tid: spT
    ipO: implementationParamOwn :st mid: imid nameId: ipN tid: ipT
    if spO != ipO then {
        spm: markerText o: spO
        ipm: markerText o: ipO
        spp: implementationMarkerPhrase m: spm.stringView
        ipp: implementationMarkerPhrase m: ipm.stringView
        (
            implementationReport
            :st
            :ast
            :markerOp
            msg: "'\{implName}' implements \{specName}'s '\{mname}' with parameter '\{pnm}' \{ipp}, where the spec's is \{spp}"
        )
    }
}

# checkImplementationReturn -- the return: the same type, `out` against `outx`, and
# the same marker.
checkImplementationReturn: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    smid: ztypes.tid
    imid: ztypes.tid
    implName: StringView
    specName: String.view
    mname: String.view
    markerOp: zast.nodeid
} is {
    sRetT: (methodReturnOf reg: st.reg typing: st.typing mid: smid).or d: ztypes.tid
    iRetT: (methodReturnOf reg: st.reg typing: st.typing mid: imid).or d: ztypes.tid
    # `out null` names the absence of a return: it and no `out` are one answer
    if sRetT == st.typing.nullTypeId then sRetT = ztypes.tid.zero
    if iRetT == st.typing.nullTypeId then iRetT = ztypes.tid.zero
    if sRetT != iRetT then {
        srn: "nothing".string
        if sRetT.notZero then srn = specWrittenName :st :ast tid: sRetT
        irn: "nothing".string
        if iRetT.notZero then irn = specWrittenName :st :ast tid: iRetT
        (
            implementationReport
            :st
            :ast
            :markerOp
            msg: "'\{implName}' implements \{specName}'s '\{mname}' returning \{irn}, where the spec's returns \{srn}"
        )
    }
    sPins: st.typing.funcPins.has item: smid
    iPins: st.typing.funcPins.has item: imid
    if sPins != iPins then {
        skw: "out".string
        if sPins then skw = "outx".string
        ikw: "out".string
        if iPins then ikw = "outx".string
        (
            implementationReport
            :st
            :ast
            :markerOp
            msg: "'\{implName}' implements \{specName}'s '\{mname}' declared `\{ikw}`, where the spec's is `\{skw}`"
        )
    }
    sRm: implementationReturnMarker :st mid: smid
    iRm: implementationReturnMarker :st mid: imid
    if sRm != iRm then {
        srp: implementationMarkerPhrase m: sRm.stringView
        irp: implementationMarkerPhrase m: iRm.stringView
        (
            implementationReport
            :st
            :ast
            :markerOp
            msg: "'\{implName}' implements \{specName}'s '\{mname}' with a return that is \{irp}, where the spec's is \{srp}"
        )
    }
}

# implementTargetOf -- the interface an `X.implement` item implements: `target`,
# its X resolved, when that is a protocol or a facet. Any other X is refused
# where it is written (reportNotImplementable), and implements nothing.
implementTargetOf: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    unitDecl: ztypes.declid
    ast: Ast
    target: optionval ztypes.tid
    op: zast.nodeid
} out optionval ztypes.tid is {
    match (
        target
    ) case some then {
        if (specTypetypeOf :st tid: target).isInterface then return (optionval.some target)
        reportNotImplementable :st :ast :op
    } case none then {
        if (implementBaseResolves :st :scope :ast :unitDecl :op) then (
            reportNotImplementable
            :st
            :ast
            :op
        )
    }
    return (optionval.none ztypes.tid)
}

# reportNotImplementable -- the E0100 for an `X.implement` item whose X is no
# protocol or facet: only an interface is implemented. `op` is the X.
reportNotImplementable: function {st: zenv.ZSymbolTable ast: Ast op: zast.nodeid} is {
    xt: statics.typeExprText :ast nid: op
    n: ast.nodes.getView i: op
    (
        addErrorWithHint
        :st
        nodeid: op
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.typeError
        msg: "'\{xt}' is not a protocol or a facet: only an interface is implemented"
        note: "".string
        hint: "".string
        width: xt.length
    )
}

# implementBaseResolves -- whether the X of an `X.implement` item names
# something, so that it being no interface is the report to make. A bare name
# that names nothing, and an application of no generic template, are reported
# where their type-ref is stamped; an instance of a generic interface that did
# not resolve, by its arguments.
implementBaseResolves: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    op: zast.nodeid
} out bool is {
    if (ast.nodes.get i: op).call then {
        hc: statics.callRefAt :ast nid: op
        htpl: typeargs.typeApplicationTemplate :st :scope :ast :unitDecl callableNid: hc.callable
        if htpl.isZero then return false
        if (st.reg.isGenericOf tid: htpl).not then return false
        # an instance of a generic interface that did not resolve was refused
        # by its arguments
        return (specTypetypeOf :st tid: htpl).isInterface.not
    }
    vnId: zast.atomNameIdOf n: (ast.nodes.getView i: op)
    if vnId.isZero then return true
    if (walkLookupTyperefById :st :scope :ast :unitDecl baseId: vnId).some then return true
    return (envLookup typing: st.typing :scope nameId: vnId).declId.notZero
}

# refuseMarkerHolder -- an implementation its holder cannot declare: a protocol
# implements no other protocol's members, so it implements only to a marker (an
# empty protocol); and `thread.Crossing` says a protocol's values are handed to
# another thread, which a parameter's protocol type or bound is read for, so
# only a protocol declares it. True when the holder is a protocol refused.
refuseMarkerHolder: function {
    st: zenv.ZSymbolTable
    ast: Ast
    implTypeId: ztypes.tid
    specTypeId: ztypes.tid
    markerOp: zast.nodeid
} out bool is {
    isProto: (st.reg.typetypeOf typeId: implTypeId) == ztypes.ztypetype.protocolType
    msg: String
    if isProto when (specIsMarker :st spec: specTypeId).not then {
        sn: specWrittenName :st :ast tid: specTypeId
        msg = "a protocol cannot implement '\{sn}': it defines no members of its own, so it implements only markers (empty protocols)"
    }
    root: st.walk.threadUnitRoot
    if isProto.not when root.notZero then {
        crd: st.typing.declFindChild parentDeclId: root nameId: zast.wellKnown.slot.tyCrossing
        if crd.notZero when (st.typing.declIdOfType typeId: specTypeId) == crd then {
            hn: specWrittenName :st :ast tid: implTypeId
            msg = "'\{hn}' cannot declare `thread.Crossing`: it marks a protocol, whose values a parameter typed or bounded by it hands to another thread"
        }
    }
    if msg.length == 0 then return false
    n: ast.nodes.getView i: markerOp
    (
        addError
        :st
        nodeid: markerOp
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.typeError
        :msg
    )
    return isProto
}

# staticListOwnMember -- the name is one of the block's own members, so no element
# may take it: a method its value template `tpl` declares (`index`, `length`,
# `iterate`, and `tag` on a block of integers). The template's generic
# parameter and its `null` opt-outs name nothing a block reads, so they stay
# free.
staticListOwnMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tpl: ztypes.tid
    nameId: zast.nameid
} out bool is {
    if nameId.isZero or tpl.isZero then return false
    md: st.typing.declMemberIdOf parentTypeId: tpl :nameId
    if md.isZero then return false
    forceMemberDecl :st :ast memberDeclId: md
    mt: (st.typing.declChildOfId parentTypeId: tpl :nameId).or d: ztypes.tid.zero
    return (st.reg.typetypeOf typeId: mt) == ztypes.ztypetype.functionType
}

# refuseStaticListOutType -- a list's `out` names a type that is no list type. When it
# names an element type, the hint writes the list type that holds it.
refuseStaticListOutType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    outId: zast.nodeid
    ot: ztypes.tid
} is {
    otn: specWrittenName :st :ast tid: ot
    oNode: ast.nodes.get i: outId
    hint: "name the list's full type: `out staticlist u8`, `out staticlist StringView`".string
    if (constraintHolds :ast :st ck: ztypes.constraintkind.staticMember argTid: ot) then {
        hint = "a list of \{otn} is `out staticlist \{otn}`"
    }
    (
        addErrorWithHint
        :st
        nodeid: outId
        lineno: (nodeLine n: oNode)
        colno: (nodeCol n: oNode)
        e: zast.err.typeError
        msg: "'\{otn}' is no list type: a list's `out` names the list's own type"
        note: String
        :hint
        width: otn.length
    )
}

# materializeCreateParams -- give a synthesized `.create` one parameter per
# the type's data field, in declaration order, so the create method carries the
# signature the construction sugar validates and dispatches against. Mirrors
# dataFieldNames' field filter (fnptr fields + non-FUNCTION fields, excluding
# `as` constants and implementation markers), and resolves exactly what
# that filter reads. The synth create keeps no
# funcReturnNode, so emission still routes it field-wise.
materializeCreateParams: function {
    st: zenv.ZSymbolTable
    ast: Ast
    typeTid: ztypes.tid
    createId: ztypes.tid
} is {
    # the synthesized constructor's parameters are this type's FIELDS, so an
    # unresolved fn-ptr field -- an is-block `function {..} out T` with no
    # body -- would be silently absent from the signature. A METHOD is never a
    # parameter, and forcing one only to drop it resolved every signature in
    # the member block: `StringView` reached `parseF16`/`parseF128` that way,
    # and through them f16 and f128, in every program ever compiled.
    forceAllFields :st :ast tid: typeTid
    # every field edge is written by now -- only the synthesized borrow / == /
    # != follow this call -- so settle the type here rather than waiting for
    # resolveDef's settle, which lands after the parameter order is decided
    createParamIds: ListVal zast.nameid
    implementationMarkerIds reg: st.reg typing: st.typing tid: typeTid ids: createParamIds
    fnameIds: ListVal zast.nameid
    ftypeIds: ListVal ztypes.tid
    {
        {
            ri: u64
            rowCount: st.typing.declRowSlots ownerTid: typeTid
            for ri < rowCount loop {
                row: st.typing.declRowAt ownerTid: typeTid membersOnly: true slot: ri
                ri = ri + 1
                if row.keep then {
                    tcNameId: row.name
                    cto: row.tid
                    inc: false
                    fptr: false
                    fptr = st.typing.declIsFnptrFieldId parentTypeId: typeTid nameId: tcNameId
                    if fptr then {
                        inc = true
                    } else {
                        if cto.notZero when (
                            (st.reg.typetypeOf typeId: cto) != ztypes.ztypetype.functionType
                        ) then {
                            isC: (
                                st.typing.isAsConstDecl
                                declId: (
                                    st.typing.declMemberIdOf
                                    parentTypeId: typeTid
                                    nameId: tcNameId
                                )
                            )
                            isCreateParam: false
                            for each mv8: createParamIds loop {
                                if mv8.notZero when mv8 == tcNameId then isCreateParam = true
                            }
                            # a singleton-typed field holds its type's one
                            # value and takes no argument
                            if isC.not when isCreateParam.not when (
                                st.typing.isSingletonType
                                tid: cto
                            ).not then inc = true
                        }
                    }
                    if inc then {
                        fnameIds.append tcNameId
                        ftypeIds.append cto
                    }
                }
            }
        }
    }
    i: u64
    for i < fnameIds.length loop {
        pnId: fnameIds.get :i
        st.typing.setMemberType parentTypeId: createId nameId: pnId childTypeId: (ftypeIds.get :i)
        # the parameter carries the FIELD's disposition, so a call site reads
        # one answer whether it names the type or its create
        (
            st.typing.setChildOwnershipId
            parentTypeId: createId
            nameId: pnId
            ownership: (
                createParamOwnership
                :st
                ownerTid: typeTid
                fieldId: pnId
                fieldTid: (ftypeIds.get :i)
            )
        )
        i = i + 1
    }
}

# createParamOwnership -- what a synthesised create's parameter does with its
# argument, read off the field it fills: a `.borrow` / `.view` field keeps its
# marker, any other reftype field (unmarked, `.take`, `.hold`) owns what it is
# given and so moves the argument in, and a valtype field copies it.
createParamOwnership: function {
    st: zenv.ZSymbolTable.view
    ownerTid: ztypes.tid
    fieldId: zast.nameid
    fieldTid: ztypes.tid
} out ztypes.zparamownership is {
    fo: st.typing.declOwnershipOfId parentTypeId: ownerTid nameId: fieldId
    if fo.some then {
        if fo == ztypes.zparamownership.borrowMode then return fo
        if fo == ztypes.zparamownership.viewMode then return fo
    }
    if (st.reg.isReftypeOf tid: fieldTid) then {
        return ztypes.zparamownership.takeMode
    }
    return ztypes.zparamownership.noneMode
}

# boundAdmitsReftype -- whether the parameter `fm` of template `tdecl` is
# bounded by a family that admits a reftype, read from the kind registration
# classified. `AnyRef`, `RefHashable` and `StringLike` do by kind; a bound
# the kinds do not classify is looked up read-only (a probe cannot mint, and
# a name that resolves to nothing is the constraint machinery's business, as
# stampGenericBounds says) and admits one by boundFamilyOf's answer.
boundAdmitsReftype: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tdecl: ztypes.declid
    fm: argref
} out bool is {
    cd: st.reg.genericParamConstraintOf :tdecl paramName: fm.name
    k: cd.kind
    if k == ztypes.constraintkind.refType then return true
    if k == ztypes.constraintkind.refHashable then return true
    if k == ztypes.constraintkind.stringLike then return true
    if k != ztypes.constraintkind.other then return false
    # a bound naming a union or a variant answers from its declaration, which
    # resolves none of its arms
    dtt: boundDeclTypetype :ast :st :tdecl desc: cd
    if dtt.some when (
        (dtt == ztypes.ztypetype.unionType) or (dtt == ztypes.ztypetype.variantType)
    ) then {
        return dtt == ztypes.ztypetype.unionType
    }
    # what the bound RESOLVES to answers -- an application (`(Getter v: i64)`)
    # or a qualified name included, which its text alone does not find
    bt: namedBoundTid :ast :st :tdecl :cd
    if bt.isZero then return false
    fam: boundFamilyOf :st :bt
    if fam.none then return (st.reg.isReftypeOf tid: bt)
    return fam
}

# qualifierDecl -- the declaration a constant path's qualifier names, read off
# the declarations: its root in the owner's unit or as a file unit, then each
# further segment a member of the unit before it, each step followed through an
# alias to what the alias names. Zero when a segment names nothing, or a
# segment past the root sits under something that is not a unit.
qualifierDecl: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    # the declaration of the type or function the member belongs to
    ownerDecl: ztypes.declid
    # the qualifier: a bare name, or a dotted path of names
    node: zast.nodeid
} out ztypes.declid is {
    zd: ztypes.declid
    if node.isZero then return zd
    q: ast.nodes.getView i: node
    if q.dottedpath then {
        pd: qualifierDecl :st :ast :ownerDecl node: q.parent
        if pd.isZero or (st.typing.decls.get i: pd).kind.unitDecl.not then return zd
        segId: zast.atomNameIdOf n: (ast.nodes.getView i: q.child)
        if segId.isZero then return zd
        sd: declOfUnitDef :st scope: pd unitDecl: pd nameId: segId
        return (aliasTargetDecl :st :ast aliasDecl: sd)
    }
    rootId: zast.atomNameIdOf n: q
    if rootId.isZero then return zd
    td: (
        st.typing.declFindChild
        parentDeclId: (unitRootOfDecl typing: st.typing declId: ownerDecl)
        nameId: rootId
    )
    # a UNIT is a type too: `n: cfg.LIMIT` reads a constant of a unit the owner's
    # unit declares, or of a file unit (`n: zast.nodeid.zero`)
    if td.isZero then td = resolve.unitDeclOfName typing: st.typing nameId: rootId
    return (aliasTargetDecl :st :ast aliasDecl: td)
}

# aliasTargetDecl -- the definition an alias Decl names, through any number of
# aliases -- into a file unit or a unit nested where the alias is written, as
# system's `f128: quadfloat.f128` names its subunit's; zero when it names none.
aliasTargetDecl: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    aliasDecl: ztypes.declid
} out ztypes.declid is {
    d: aliasDecl
    hops: u64
    for hops < 16 loop {
        hops = hops + 1
        tk: resolve.reexportTargetIdsOf typing: st.typing :ast declId: d
        if tk.unitName.isZero then return d
        du: boundQualifierUnit :st scope: (st.typing.declParentOf declId: d) qualId: tk.unitName
        if du.isZero then return ztypes.declid.zero
        nd: declOfUnitDef :st scope: du unitDecl: du nameId: tk.defName
        if nd.isZero then return nd
        d = nd
    }
    return d
}

# stampGenericBounds -- resolve each recorded generic BOUND and record the
# declaration it names on the atom that spells it.
#
# Into toolRefDecl, not refDecl: the emitter reads the latter in five places,
# and an entry added there for an editor moved the emitted C. And silence on a
# miss, because a bound that names
# nothing resolvable is already the constraint machinery's business -- reporting
# it here would make a retired bound raise a second, different error.
stampGenericBounds: function {st: zenv.ZSymbolTable ast: Ast} is {
    keys: ListVal zast.nodeid
    for each e: st.walk.bounds.genericBoundName.iterateItems loop keys.append e.key
    for each k9: keys loop {
        nm9: zast.nameid
        fr9: ztypes.declid
        {
            no9: st.walk.bounds.genericBoundName.get key: k9
            if no9.some then {
                nm9 = no9
            }
            fo9: st.walk.bounds.genericBoundScope.get key: k9
            if fo9.some then {
                fr9 = fo9
            }
        }
        if nm9.notZero then {
            td9: boundNameDecl :st :ast scope: fr9 nameId: nm9
            if td9.notZero then st.typing.toolRefDecl.set key: k9 value: td9
        }
    }
}

# boundNameDecl -- the declaration a bare bound name written in `scope` names,
# for an editor: the DECLARATION, read without resolving it (bareBoundDecl), as
# a sum used only as a bound is never resolved (sumBoundDeclAdmits) and a
# resolver that may MINT would materialise types the program never asked for;
# else the minted type's own, for a name the nearest scope holds only in its
# member index. Zero when neither answers.
boundNameDecl: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    scope: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    d: bareBoundDecl :st :ast :scope :nameId
    if d.notZero then return d
    ud: unitRootOfDecl typing: st.typing declId: scope
    bo: resolve.walkLookupTyperefByIdRo :ast typing: st.typing unitDecl: ud :scope baseId: nameId
    if bo.some then {
        return (templateDeclOf reg: st.reg typing: st.typing tid: bo)
    }
    return d
}

# constraintTextOf -- reconstruct a constraint's declared text from its tag
# for diagnostics; reads fields only, constructs nothing.
constraintTextOf: function {desc: ztypes.constraintdesc} out String is {
    if desc.kind == ztypes.constraintkind.valType then return "anyval".string
    if desc.kind == ztypes.constraintkind.refType then return "AnyRef".string
    if desc.kind == ztypes.constraintkind.valHashable then return "valhashable".string
    if desc.kind == ztypes.constraintkind.refHashable then return "RefHashable".string
    if desc.kind == ztypes.constraintkind.staticIndex then return "staticindex".string
    if desc.kind == ztypes.constraintkind.staticMember then return "staticmember".string
    if desc.kind == ztypes.constraintkind.stringLike then return "StringLike".string
    if desc.kind == ztypes.constraintkind.numeric when desc.numKind.has then {
        return (ztypes.numkindName k: desc.numKind.kind)
    }
    return "".string
}

# implementsStringViewable -- the generic argument is StringLike: it IS
# StringView, or an implementation row names it against `StringViewable`. Implementation rows live on the
# DECLARING type, so a mono (str_32) implements through the generic origin it was
# instantiated from rather than under its own id.
implementsStringViewable: function {
    ast: Ast
    st: zenv.ZSymbolTable
    argTid: ztypes.tid
} out bool is {
    svT: stdTid :ast :st wk: zast.wellKnown.slot.tyStringView
    if svT.notZero when argTid == svT then return true
    txT: stdTid :ast :st wk: zast.wellKnown.slot.tyStringViewable
    if txT.isZero then return false
    probeT: argTid
    agoo: st.reg.genericOriginOf tid: argTid
    if agoo.notZero then probeT = agoo
    found: false
    cfId: ztypes.confid
    for cfId.next < st.typing.nextConf loop {
        cfId = cfId.next
        crow: st.typing.implementation.get i: cfId
        if crow.specTypeId == txT when (
            (crow.implTypeId == argTid) or (crow.implTypeId == probeT)
        ) then found = true
    }
    return found
}

# literalSatisfies -- an untyped literal type meets the bound that admits one: a
# list's element may be left untyped (staticmember), and so may its index
# (staticindex), which leaves its slots untyped.
literalSatisfies: function {
    st: zenv.ZSymbolTable.view ck: ztypes.constraintkind argTid: ztypes.tid
} out bool is {
    if argTid == st.reg.literalIntTid then {
        return (
            (ck == ztypes.constraintkind.staticIndex) or (ck == ztypes.constraintkind.staticMember)
        )
    }
    if argTid == st.reg.literalFloatTid then return ck == ztypes.constraintkind.staticMember
    if argTid == st.reg.literalTextTid then return ck == ztypes.constraintkind.staticMember
    return false
}

# constraintHolds -- the generic argument satisfies the constraint KIND. Yes or
# no only: the caller owns the diagnostic, and a kind with nothing to demand
# admits everything.
constraintHolds: function {
    ast: Ast
    st: zenv.ZSymbolTable
    ck: ztypes.constraintkind
    argTid: ztypes.tid
} out bool is {
    if (literalSatisfies :st :ck :argTid) then return true
    match (
        ck
    ) case valType then {
        return (st.reg.isValtypeOf tid: argTid)
    } case refType then {
        return (st.reg.isReftypeOf tid: argTid)
    } case valHashable then {
        if (st.reg.isValtypeOf tid: argTid).not then return false
        forceValParts :st :ast tid: argTid depth: 0
        if (typeIsHashable :st :ast tid: argTid).not then return false
        st.typing.hashUsed.add item: argTid
        st.walk.hashKeys.add item: argTid
        markKeyOpsUsed :ast :st tid: argTid
        return true
    } case refHashable then {
        if (st.reg.isReftypeOf tid: argTid).not then return false
        if (typeIsHashable :st :ast tid: argTid).not then return false
        st.walk.hashKeys.add item: argTid
        markKeyOpsUsed :ast :st tid: argTid
        return true
    } case staticIndex then {
        # a list's index: an id key, or untyped (literalSatisfies)
        return (staticIndexAdmits :ast :st :argTid)
    } case staticMember then {
        return (statics.staticMemberHolds :st :ast tid: argTid)
    } case stringLike then {
        # a union bound, so it admits reference types only: a `str` implements
        # StringViewable as a value, and is handed to a StringLike parameter as its
        # `stringView`
        if (st.reg.isReftypeOf tid: argTid).not then return false
        return (implementsStringViewable :ast :st :argTid)
    } else {
        return true
    }
}

# constraintAdmits -- a generic argument its parameter's constraint admits.
constraintAdmits: function {
    ast: Ast
    st: zenv.ZSymbolTable
    tdecl: ztypes.declid
    paramName: zast.nameid
    argTid: ztypes.tid
} out bool is {
    # a bare parameter has nothing to check yet and a partial re-checks on
    # completion: both wear GENERIC_PARAM, and the tag is what covers both
    if (st.reg.typetypeOf typeId: argTid) == ztypes.ztypetype.genericParam then return true
    cd: st.reg.genericParamConstraintOf :tdecl :paramName
    return (descAdmits :ast :st :tdecl :cd :argTid)
}

# descAdmits -- a generic argument bound `cd` admits; `tdecl` is the
# declaration the bound's names resolve in.
descAdmits: function {
    ast: Ast
    st: zenv.ZSymbolTable
    tdecl: ztypes.declid
    cd: ztypes.constraintdesc
    argTid: ztypes.tid
} out bool is {
    if (st.reg.typetypeOf typeId: argTid) == ztypes.ztypetype.genericParam then return true
    ck: cd.kind
    if ck == ztypes.constraintkind.none then return true
    # `null` is reference-family (user, 2026-09-30): an absent reference. It
    # satisfies AnyRef ((Result null E: IoError) is the io idiom) and a union
    # bound with a null arm, never anyval or a variant bound. Hashability
    # bounds reject it too: a null key has nothing to hash.
    isNul: isNullTid reg: st.reg tid: argTid
    if isNul when ck == ztypes.constraintkind.refType then return true
    if isNul when ck == ztypes.constraintkind.valType then return false
    if ck == ztypes.constraintkind.other then return (namedBoundAdmits :ast :st :tdecl :cd :argTid)
    return (constraintHolds :ast :st :ck :argTid)
}

# methodBoundUnmet -- the first bound method `nameId` adds to its type's
# parameters (ZTypeRegistry.methodBoundsOf) that instance `monoId`'s argument
# does not meet: the template's method, the parameter and the argument. All
# zero when it meets every one, and for a member of no instance -- the method
# then exists on the instance.
methodBoundUnmet: function {
    ast: Ast
    st: zenv.ZSymbolTable
    monoId: ztypes.tid
    nameId: zast.nameid
} out ztyping.unmetbound is {
    none: ztyping.unmetbound tdecl: ztypes.declid paramName: zast.nameid argTid: ztypes.tid
    origin: st.reg.genericOriginOf tid: monoId
    if origin.isZero then return none
    tmd: st.typing.declMemberIdOf parentTypeId: origin :nameId
    if tmd.isZero then return none
    bounds: st.reg.methodBoundsOf mdecl: tmd
    if bounds.length == 0 then return none
    names: st.reg.genericParamNamesOf tdecl: (st.typing.declIdOfType typeId: origin)
    for each b: bounds loop {
        k: u64
        for k < names.length while (names.get i: k) != b.paramName loop k = k + 1
        if k < names.length then {
            arg: st.reg.genericTypeArgAt specId: monoId ordinal: k
            if arg.notZero when (descAdmits :ast :st tdecl: tmd cd: b.bound argTid: arg).not then {
                return (ztyping.unmetbound tdecl: tmd paramName: b.paramName argTid: arg)
            }
        }
    }
    return none
}

# check that a generic argument satisfies its parameter's constraint. A refusal
# is reported at `at`/`lineno`/`colno`, the call that inferred the argument;
# line 0 is the spec front door, which holds no source node.
checkConstraintSat: function {
    ast: Ast
    st: zenv.ZSymbolTable
    tdecl: ztypes.declid
    paramName: zast.nameid
    at: zast.nodeid
    lineno: u32
    colno: u32
    argTid: ztypes.tid
} is {
    if st.mode.quietBounds then return
    if (constraintAdmits :ast :st :tdecl :paramName :argTid) then return
    if lineno == 0 when st.walk.bounds.siteLine > 0 then {
        if st.walk.bounds.siteFailArg == argTid then return
        st.walk.bounds.siteFailArg = argTid
    }
    if (unmetBoundReported :st :tdecl :paramName :argTid) then return
    m: constraintUnmetText :ast :st :tdecl :paramName :argTid
    declare.reportConstraintUnmet :st :at :lineno :colno msg: m
}

# unmetBoundReported -- this refusal was reported already; one not yet
# reported is recorded, as the caller reports it now.
unmetBoundReported: function {
    st: zenv.ZSymbolTable
    tdecl: ztypes.declid
    paramName: zast.nameid
    argTid: ztypes.tid
} out bool is {
    for each u: st.walk.unmetBounds loop {
        if u.tdecl == tdecl when u.paramName == paramName when u.argTid == argTid then return true
    }
    st.walk.unmetBounds.append (ztyping.unmetbound :tdecl :paramName :argTid)
    return false
}

# qualifiedTemplateName -- a template as a constraint report names it: its
# name, qualified by its unit.
qualifiedTemplateName: function {st: zenv.ZSymbolTable.view tdecl: ztypes.declid} out String is {
    tdo: st.typing.decls.get i: tdecl
    tdn: st.reg.nameOf tid: tdo.typeId
    # every unit on the way, a subunit's included (`top.lib.Box`), as a program
    # spells it
    unitName: numerics.unitPathOfTid reg: st.reg typing: st.typing tid: tdo.typeId
    if unitName.length > 0 then return "\{unitName}.\{tdn}"
    return tdn
}

# checkPartialBounds -- a bound over another of the template's parameters,
# `T: (Getter v: u).generic`, names a PARTIAL instance, which admission checks
# argument by argument and so cannot decide (namedBoundAdmits admits it). Once
# every parameter is bound it is decided: the bound is respecialised with
# this instantiation's arguments, and the argument for its parameter must
# implement that instance.
checkPartialBounds: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    tdecl: ztypes.declid
    pnames: (ListVal zast.nameid).view
    subs: (IdMapV zast.nameid v: ztypes.tid).view
    at: zast.nodeid
    lineno: u32
    colno: u32
} is {
    if st.mode.quietBounds then return
    anyApp: false
    for each qn: pnames loop {
        if (st.reg.genericParamConstraintOf :tdecl paramName: qn
        ).boundApp.notZero then anyApp = true
    }
    if anyApp.not then return
    idSubs: IdMapV ztypes.tid v: ztypes.genericarg
    for each an: pnames loop {
        av: subs.get key: an
        if av.some then {
            (
                idSubs.set
                key: (declare.genericParamTidMint :st :ast :tdecl nameId: an)
                value: ztypes.genericarg.typeArg av
            )
        }
    }
    for each pn: pnames loop {
        argv: (subs.get key: pn).or d: ztypes.tid.zero
        inst: partialBoundInstance :st :ast :unitDecl :tdecl param: pn :idSubs
        if argv.isZero or inst.isZero then continue
        argT: argv
        instT: inst
        if (argT == instT) or (typeImplements :st impl: argT spec: instT) then continue
        an: specWrittenName :st :ast tid: argT
        sn: specWrittenName :st :ast tid: instT
        pt: zast.nameTextAt :ast ref: pn
        tdn: qualifiedTemplateName :st :tdecl
        m: "generic argument '\{an}' does not satisfy constraint '\{sn}' on parameter '\{pt}' of '\{tdn}'"
        declare.reportConstraintUnmet :st :at :lineno :colno msg: m
    }
}

# partialBoundInstance -- the instance a parameter's partial application bound
# names once `idSubs` binds the template's parameters; 0 when the bound is no
# partial application or stays partial.
partialBoundInstance: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    tdecl: ztypes.declid
    param: zast.nameid
    idSubs: (IdMapV ztypes.tid v: ztypes.genericarg)
} out ztypes.tid is {
    cd: st.reg.genericParamConstraintOf :tdecl paramName: param
    if cd.boundApp.isZero then return ztypes.tid.zero
    bt: boundApplicationTid :ast :st :tdecl app: cd.boundApp
    if bt.isZero or (st.reg.isPartialOf tid: bt).not then return ztypes.tid.zero
    inst: instantiate.respecialize :st scope: tdecl :ast :unitDecl specTid: bt :idSubs
    if inst.isZero or (st.reg.isPartialOf tid: inst) then return ztypes.tid.zero
    return inst
}

# namedBoundAdmits -- a bound that names a DECLARATION admits what that
# declaration says, within the one family boundFamilyAdmits gives it: a
# protocol or facet admits its implementers, a union a member's own type or a
# implementer of a protocol member, and a variant exactly its arms' payload
# types. A union or variant bound is read off its declaration
# (sumBoundDeclAdmits), so checking an instance resolves only the arms it can
# be. A bound that names nothing is checkGenericBounds's report, not this one,
# and admits everything here so the same mistake is not reported twice. A
# bound over another of the template's parameters (`(Getter v: u).generic`) is
# a PARTIAL instance, which one argument alone cannot decide, and admits it.
namedBoundAdmits: function {
    ast: Ast
    st: zenv.ZSymbolTable
    # the template whose parameter the bound is on
    tdecl: ztypes.declid
    cd: ztypes.constraintdesc
    argTid: ztypes.tid
} out bool is {
    sb: sumBoundByDecl :ast :st :tdecl :cd :argTid
    if sb.some then {
        return sb
    }
    bt: namedBoundTid :ast :st :tdecl :cd
    if bt.isZero then return true
    if (boundFamilyAdmits :st :bt :argTid).not then return false
    if bt == argTid then return true
    if (st.reg.isPartialOf tid: bt) then return true
    tt: st.reg.typetypeOf typeId: bt
    if tt.isInterface then {
        return (typeImplements :st impl: argTid spec: bt)
    }
    if tt == ztypes.ztypetype.unionType then return (
        sumBoundAdmits
        :st
        :bt
        :argTid
        implementers: true
    )
    if tt == ztypes.ztypetype.variantType then {
        # a variant holds value data only, and `null` is reference-family
        if (isNullTid reg: st.reg tid: argTid) then return false
        return (sumBoundAdmits :st :bt :argTid implementers: false)
    }
    return true
}

# sumBoundByDecl -- namedBoundAdmits's answer for a bound whose declaration is a
# union or a variant (sumBoundDeclAdmits); none for any other bound.
sumBoundByDecl: function {
    ast: Ast
    st: zenv.ZSymbolTable
    tdecl: ztypes.declid
    cd: ztypes.constraintdesc
    argTid: ztypes.tid
} out optionval bool is {
    bd: boundDeclOf :st :ast :tdecl :cd
    if bd.isZero then return (optionval.none bool)
    dtt: resolve.declDefTypetype :st :ast declId: bd
    if dtt.none then return (optionval.none bool)
    isUnion: dtt == ztypes.ztypetype.unionType
    if isUnion.not when dtt != ztypes.ztypetype.variantType then return (optionval.none bool)
    return (optionval.some (sumBoundDeclAdmits :ast :st :bd :isUnion :argTid))
}

# sumBoundDeclAdmits -- a union or variant bound, read off its DECLARATION
# `bd`: the argument is one of its arms' types, or -- a union's -- implements
# a protocol or facet arm. A sum's definition does not make every arm used: only
# an arm that can be the argument is resolved (sumArmCanBe), so an f64 instance
# of `wide: variant { :f64 :f128 }` never demands f128's unit. A TYPEDEF IS
# ADMITTED WHERE ANY TYPE UP ITS CHAIN IS (sumMemberAdmits), and the parameter
# binds the typedef itself: `meters: typedef u32` meets an arm `:u32`.
sumBoundDeclAdmits: function {
    ast: Ast
    st: zenv.ZSymbolTable
    bd: ztypes.declid
    isUnion: bool
    argTid: ztypes.tid
} out bool is {
    if (sumFamilyAdmits :st :isUnion :argTid).not then return false
    {
        cur: argTid
        for cur.notZero loop {
            if (sumArgDecl :st tid: cur) == bd then return true
            cur = st.typing.typedefBaseTidOf tid: cur
        }
    }
    sc: st.typing.declParentOf declId: bd
    ud: unitRootOfDecl typing: st.typing declId: bd
    opId: statics.declOperationOf :st :ast declId: bd
    if opId.isZero or (declare.objRefAt :ast nid: opId).nid.isZero then return false
    nis: (declare.objRefAt :ast nid: opId).nis
    k: u64
    for k < nis loop {
        fm: argRefAt :ast nid: (zast.objIsItemAt :ast nid: opId i: k)
        k = k + 1
        if fm.nid.isZero then continue
        te: sumArmTypeNode :st :ast scope: sc unitDecl: ud op: fm.operation
        if (sumArmCanBe :st :ast scope: sc unitDecl: ud :te :argTid :isUnion) then {
            mt: (
                typeref.resolveTyperefShell
                :st
                :ast
                unitDecl: ud
                scope: sc
                nid: te
                thisName: zast.nameid
            )
            if (sumMemberAdmits :st member: mt :argTid implementers: isUnion) then return true
        }
    }
    return false
}

# sumFamilyAdmits -- the family a sum bound admits: a union reference types and
# `null`, a variant value types.
sumFamilyAdmits: function {
    st: zenv.ZSymbolTable.view
    isUnion: bool
    argTid: ztypes.tid
} out bool is {
    if (isNullTid reg: st.reg tid: argTid) then return isUnion
    if isUnion then return (st.reg.isValtypeOf tid: argTid).not
    return (st.reg.isReftypeOf tid: argTid).not
}

# sumArgDecl -- the declaration a sum bound's argument names: an instance's
# template's, else its own; 0 when it has none readable here.
sumArgDecl: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out ztypes.declid is {
    og: st.reg.genericOriginOf :tid
    if og.notZero then return (st.typing.declIdOfType typeId: og)
    return (st.typing.declIdOfType typeId: tid)
}

# sumArmCanBe -- whether the arm whose type is written at `te` can admit the
# argument `argTid`, read without resolving it: its type names the declaration
# of the argument or of a type up its typedef chain, or it is a union's protocol
# or facet arm, or the arm's type (or a type on the chain) names no declaration
# readable here, which only resolving can settle.
sumArmCanBe: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    scope: ztypes.declid
    unitDecl: ztypes.declid
    te: zast.nodeid
    argTid: ztypes.tid
    isUnion: bool
} out bool is {
    hd: sumArmHeadDecl :st :ast :scope :unitDecl op: te
    if hd.isZero then return true
    cur: argTid
    for cur.notZero loop {
        ad: sumArgDecl :st tid: cur
        if ad.isZero or (ad == hd) then return true
        cur = st.typing.typedefBaseTidOf tid: cur
    }
    if isUnion.not then return false
    htt: resolve.declDefTypetype :st :ast declId: hd
    if htt.none then return false
    return (htt == ztypes.ztypetype.protocolType) or (htt == ztypes.ztypetype.facetType)
}

# sumArmTypeNode -- the node an arm's type is written at: a `(Box T)` arm's T,
# which the arm IS (attachUnionArm collapses it), else the arm's own operation.
sumArmTypeNode: function {
    st: zenv.ZSymbolTable
    ast: Ast
    scope: ztypes.declid
    unitDecl: ztypes.declid
    op: zast.nodeid
} out zast.nodeid is {
    acr: statics.callRefAt :ast nid: op
    if acr.nid.isZero or (acr.nargs != 1) then return op
    cd: sumArmHeadDecl :st :ast :scope :unitDecl op: acr.callable
    if cd.isZero then return op
    if (
        cd !=
        (st.typing.declIdOfType typeId: (stdtypes.stdTidRo :ast :st wk: zast.wellKnown.slot.tyBox))
    ) then return op
    ba: argRefAt :ast nid: (zast.callArgAt :ast nid: acr.nid i: 0)
    if ba.nid.isZero then return op
    return ba.operation
}

# sumArmHeadDecl -- the definition an arm's type names, read without resolving
# it: a bare name's nearest declaration from the sum's scope, an application's
# callee's, or a qualified `unit.T`'s member of that unit, through aliases. Zero
# when the type names nothing readable here.
sumArmHeadDecl: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    scope: ztypes.declid
    unitDecl: ztypes.declid
    op: zast.nodeid
} out ztypes.declid is {
    d: ztypes.declid
    n: ast.nodes.getView i: op
    # a bare name, or the `:T` shorthand arm, whose label is the type's name
    if n.atomid or n.labelvalue then {
        d = (
            memberaccess.nearestDeclOf
            :st
            scope: (typeargs.scopeFor typing: st.typing :unitDecl :scope)
            baseId: (atomNameId :ast n: (ast.nodes.getView i: op))
        )
    } else if n.call then {
        return (
            sumArmHeadDecl
            :st
            :ast
            :scope
            :unitDecl
            op: (statics.callRefAt :ast nid: op).callable
        )
    } else if n.dottedpath then {
        qu: (
            boundQualifierUnit
            :st
            :scope
            qualId: (atomNameId :ast n: (ast.nodes.getView i: n.parent))
        )
        if qu.notZero then {
            d = (
                st.typing.declFindChild
                parentDeclId: qu
                nameId: (atomNameId :ast n: (ast.nodes.getView i: n.child))
            )
        }
    }
    if d.isZero then return d
    return (aliasTargetDecl :st :ast aliasDecl: d)
}

# boundFamilyAdmits -- a generic parameter admits ONE family: the family of
# the declaration that bounds it. A union or a protocol admits reference types
# and a variant or a facet value types, whatever their members or implementers
# are -- a protocol VALUE may still hold a record, but a parameter bounded by
# the protocol takes reference types only. `null` is reference-family. An
# argument whose family is not yet known is left to the member and
# implementation tests.
boundFamilyAdmits: function {
    st: zenv.ZSymbolTable.view
    bt: ztypes.tid
    argTid: ztypes.tid
} out bool is {
    fam: boundFamilyOf :st :bt
    if fam.none then return true
    if (isNullTid reg: st.reg tid: argTid) then return fam
    if fam then return (st.reg.isValtypeOf tid: argTid).not
    return (st.reg.isReftypeOf tid: argTid).not
}

# boundFamilyOf -- the family a bound naming `bt` admits: true for reference
# types (a union or a protocol), false for value types (a variant or a facet),
# none for a declaration of any other kind, which has no `.generic`.
boundFamilyOf: function {st: zenv.ZSymbolTable.view bt: ztypes.tid} out optionval bool is {
    return (familyOfBoundTypetype tt: (st.reg.typetypeOf typeId: bt))
}

# boundDeclTypetype -- the kind of declaration a bound names, found read-only
# (boundDeclOf); StringLike is a union. An application bound is not read, and
# answers none, as does a bound the kinds classify otherwise.
boundDeclTypetype: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    tdecl: ztypes.declid
    desc: ztypes.constraintdesc
} out optionval ztypes.ztypetype is {
    if desc.kind == ztypes.constraintkind.stringLike then {
        return (optionval.some ztypes.ztypetype.unionType)
    }
    if desc.kind != ztypes.constraintkind.other then return (optionval.none ztypes.ztypetype)
    d: boundDeclOf :st :ast :tdecl cd: desc
    if d.isZero then return (optionval.none ztypes.ztypetype)
    return (resolve.declDefTypetype :st :ast declId: d)
}

# boundDeclOf -- the definition a named bound names, read without resolving it:
# the nearest declaration of its name from the TEMPLATE's scope, where the bound
# is written (never a call's), or the member of the unit a qualified bound
# names, through aliases. Zero for an application bound or a name that declares
# nothing.
boundDeclOf: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    tdecl: ztypes.declid
    cd: ztypes.constraintdesc
} out ztypes.declid is {
    d: ztypes.declid
    if cd.boundName.isZero or cd.boundApp.notZero then return d
    if cd.boundQual.notZero then {
        qu: boundQualifierUnit :st scope: tdecl qualId: cd.boundQual
        if qu.isZero then return d
        d = st.typing.declFindChild parentDeclId: qu nameId: cd.boundName
        if d.isZero then return d
        return (aliasTargetDecl :st :ast aliasDecl: d)
    }
    return (bareBoundDecl :st :ast scope: tdecl nameId: cd.boundName)
}

# bareBoundDecl -- the definition a bare bound name written in `scope` names: its
# nearest declaration (nearestDeclOf), through aliases, read without resolving
# anything. Zero when no scope declares it.
bareBoundDecl: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    scope: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    ud: unitRootOfDecl typing: st.typing declId: scope
    d: (
        memberaccess.nearestDeclOf
        :st
        scope: (typeargs.scopeFor typing: st.typing unitDecl: ud :scope)
        baseId: nameId
    )
    if d.isZero then return d
    return (aliasTargetDecl :st :ast aliasDecl: d)
}

# familyOfBoundTypetype -- boundFamilyOf's answer for a declaration of kind
# `tt`.
familyOfBoundTypetype: function {tt: ztypes.ztypetype} out optionval bool is {
    if (tt == ztypes.ztypetype.unionType) or (tt == ztypes.ztypetype.protocolType) then {
        return (optionval.some true)
    }
    if (tt == ztypes.ztypetype.variantType) or (tt == ztypes.ztypetype.facetType) then {
        return (optionval.some false)
    }
    return (optionval.none bool)
}

# boundApplicationTid -- the instance a bound written as a type application
# names, resolved as the same application written in a signature is: over a
# generic template it mints the instance, over any other type it is refused,
# and an argument that names nothing is reported as a signature's is (the
# shell leg), leaving a type no argument implements.
boundApplicationTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    tdecl: ztypes.declid
    app: zast.nodeid
} out ztypes.tid is {
    ud: unitRootOfDecl typing: st.typing declId: tdecl
    r: (
        resolve.resolveMonoRefInline
        :st
        :ast
        unitDecl: ud
        scope: tdecl
        thisName: zast.nameid
        enclDecl: tdecl
        opNid: app
        nid: app
    )
    if r.isZero then {
        cr: statics.callRefAt :ast nid: app
        args: ListVal zast.nodeid
        k: u64
        for k < cr.nargs loop {
            args.append from: (zast.callArgAt :ast nid: cr.nid i: k)
            k = k + 1
        }
        r = (
            typeargs.resolveTyperefCallShell
            :st
            :ast
            unitDecl: ud
            scope: tdecl
            thisName: zast.nameid
            callableId: cr.callable
            argIds: args
            nid: app
        )
    }
    return r
}

# boundQualifierUnit -- the unit a qualified bound (`pr.Rd.generic`) is reached
# through: a file unit, or a unit declared in scope (a subunit), found down the
# declaration path as a type application's unit path is; zero for none.
boundQualifierUnit: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    qualId: zast.nameid
} out ztypes.declid is {
    fu: resolve.fileUnitNamedAt :st :scope nameId: qualId
    if fu.notZero then return fu
    d: memberaccess.declInScope :st scopeDeclId: scope nameId: qualId
    if d.isZero then return d
    if (st.typing.decls.get i: d).kind.unitDecl then return d
    return ztypes.declid
}

# namedBoundTid -- the type a named bound resolves to, 0 when it names none.
namedBoundTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    # the template whose parameter the bound is on, where the bound's names
    # resolve
    tdecl: ztypes.declid
    cd: ztypes.constraintdesc
} out ztypes.tid is {
    if cd.boundApp.notZero then return (boundApplicationTid :ast :st :tdecl app: cd.boundApp)
    if cd.boundName.isZero then return ztypes.tid
    # a qualified bound names a member of that unit; a bare one is found as any
    # written type is, nearest scope first (a definition nothing has demanded
    # yet is resolved where the walk meets it)
    if cd.boundQual.notZero then {
        qu: boundQualifierUnit :st scope: tdecl qualId: cd.boundQual
        if qu.isZero then return ztypes.tid
        return (resolve.scopeMemberTid :st :ast root: qu nameId: cd.boundName)
    }
    ud: unitRootOfDecl typing: st.typing declId: tdecl
    return (
        (walkLookupTyperefById :st scope: tdecl :ast unitDecl: ud baseId: cd.boundName).or
        d: ztypes.tid.zero
    )
}

# sumBoundAdmits -- a union or variant bound: the argument IS one of its
# members' types, or -- for a union, whose members may be protocols or facets --
# implements one.
sumBoundAdmits: function {
    st: zenv.ZSymbolTable
    bt: ztypes.tid
    argTid: ztypes.tid
    implementers: bool
} out bool is {
    n: st.typing.declRowSlots ownerTid: bt
    i: u64
    for i < n loop {
        row: st.typing.declRowAt ownerTid: bt membersOnly: true slot: i
        i = i + 1
        if row.keep when (sumMemberAdmits :st member: row.tid :argTid :implementers) then {
            return true
        }
    }
    return false
}

# sumMemberAdmits -- one member of a sum bound: the argument IS its type, or a
# type up the argument's typedef chain is -- walked one base at a time to the
# root, so a typedef over a typedef is tested at every step -- or, for a union,
# whose members may be protocols or facets, the argument implements it.
sumMemberAdmits: function {
    st: zenv.ZSymbolTable
    member: ztypes.tid
    argTid: ztypes.tid
    implementers: bool
} out bool is {
    cur: argTid
    for cur.notZero loop {
        if member == cur then return true
        cur = st.typing.typedefBaseTidOf tid: cur
    }
    if implementers.not then return false
    mtt: st.reg.typetypeOf typeId: member
    if mtt != ztypes.ztypetype.protocolType when mtt != ztypes.ztypetype.facetType then {
        return false
    }
    return (typeImplements :st impl: argTid spec: member)
}

# typeImplements -- an implementation row names `impl` (or the template it was
# instantiated from) against `spec`, or `impl` is a typedef that inherits the
# implementation from its base. The template's row over its own parameter
# (`g: (Getter v: t)`) names this instance's substituted spec.
typeImplements: function {
    st: zenv.ZSymbolTable.view impl: ztypes.tid spec: ztypes.tid
} out bool is {
    og: st.reg.genericOriginOf tid: impl
    found: false
    cfId: ztypes.confid
    for cfId.next < st.typing.nextConf loop {
        cfId = cfId.next
        crow: st.typing.implementation.get i: cfId
        if crow.specTypeId == spec when (
            (crow.implTypeId == impl) or (og.notZero and (crow.implTypeId == og))
        ) then {
            found = true
        } else if og.notZero when crow.implTypeId == og then {
            isp: instanceSpecOf :st mono: impl spec: crow.specTypeId labelNameId: crow.labelNameId
            if isp == spec then found = true
        }
    }
    if found then return true
    return (typedefInheritsImplementation :st :impl :spec)
}

# typedefInheritsImplementation -- a typedef implements where its base does, while
# every spec method's first declarer on the typedef still keeps the spec's
# signature: the base's own, or an override that counts as its own new
# definition. A method hidden with `null` implements nothing, so a typedef
# that hides or reshapes one quietly does not implement, and using it as the
# spec is refused at the use.
typedefInheritsImplementation: function {
    st: zenv.ZSymbolTable.view impl: ztypes.tid spec: ztypes.tid
} out bool is {
    base: st.typing.typedefBaseTidOf tid: impl
    if base.isZero then return false
    if (typeImplements :st impl: base :spec).not then return false
    slots: st.typing.declRowSlots ownerTid: spec
    si: u64
    for si < slots loop {
        row: st.typing.declRowAt ownerTid: spec membersOnly: true slot: si
        si = si + 1
        smid: row.tid
        if row.keep.not or (row.name == zast.wellKnown.slot.wkCreate) then continue
        if (st.reg.typetypeOf typeId: smid) != ztypes.ztypetype.functionType then continue
        if (implementationSpecIsSelfTyped :st specTid: spec :smid) then continue
        imid: implementationImplMethod :st implTid: impl mnameId: row.name
        if (implementationMethodMatches :st :smid :imid).not then return false
    }
    return true
}

# implementationTakesReceiver -- the implementing method `mid` declares a
# receiver: one thisParamNameIdOf names (`t: this.view`), or the bare `:this`,
# which records no name and stands among the parameters as `this`. Every spec
# takes a receiver, and the vtable's wrapper passes the held value as the first
# argument, so a method without one cannot implement a spec.
implementationTakesReceiver: function {st: zenv.ZSymbolTable.view mid: ztypes.tid} out bool is {
    if (st.reg.thisParamNameIdOf tid: mid).notZero then return true
    return (st.typing.declChildOfId parentTypeId: mid nameId: zast.wellKnown.slot.wkThis).some
}

# specLacksReceiver -- the spec member `mnameId` of `specTid` is declared with
# no parameter that names a receiver (paramNamesReceiver). Its declaration is
# refused already (refuseSpecWithoutReceiver), so an implementer is not
# refused again for the same mistake. False when the declaration is not found.
specLacksReceiver: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    specTid: ztypes.tid
    mnameId: zast.nameid
} out bool is {
    md: st.typing.declMemberIdOf parentTypeId: specTid nameId: mnameId
    if md.isZero then return false
    fnode: valMemberFnNode :ast typing: st.typing memberDecl: md
    if fnode.isZero then return false
    if (ast.nodes.get i: fnode).functiondef.not then return false
    return (memberaccess.functionNamesReceiver :ast fnId: fnode).not
}

# implementationMethodMatches -- checkImplementationMethod's comparisons as a
# predicate: `imid` implements the spec method `smid` with its exact
# signature. Nothing is reported.
implementationMethodMatches: function {
    st: zenv.ZSymbolTable.view smid: ztypes.tid imid: ztypes.tid
} out bool is {
    if imid.isZero or (st.reg.isGenericOf tid: imid) then return false
    if (implementationTakesReceiver :st mid: imid).not then return false
    sids: ListVal ztypes.tid
    snms: ListVal zast.nameid
    implementationParams :st mid: smid ids: sids nameIds: snms
    iids: ListVal ztypes.tid
    inms: ListVal zast.nameid
    implementationParams :st mid: imid ids: iids nameIds: inms
    if sids.length != iids.length then return false
    sRo: implementationReceiverOwn :st mid: smid
    if sRo != (implementationReceiverOwn :st mid: imid) then return false
    pi: u64
    for pi < sids.length loop {
        if (sids.get i: pi) != (iids.get i: pi) then return false
        spN: snms.get i: pi
        ipN: inms.get i: pi
        pT: sids.get i: pi
        spO: implementationParamOwn :st mid: smid nameId: spN tid: pT
        ipO: implementationParamOwn :st mid: imid nameId: ipN tid: pT
        if spO != ipO then return false
        pi = pi + 1
    }
    sRetT: (methodReturnOf reg: st.reg typing: st.typing mid: smid).or d: ztypes.tid
    iRetT: (methodReturnOf reg: st.reg typing: st.typing mid: imid).or d: ztypes.tid
    if sRetT != iRetT then return false
    sPins: st.typing.funcPins.has item: smid
    iPins: st.typing.funcPins.has item: imid
    if sPins != iPins then return false
    return (implementationReturnMarker :st mid: smid) == (implementationReturnMarker :st mid: imid)
}

# constraintUnmetText -- the message for a generic argument its parameter's
# constraint refuses, naming the template by its unit.
constraintUnmetText: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    tdecl: ztypes.declid
    paramName: zast.nameid
    argTid: ztypes.tid
} out String is {
    an: specWrittenName :st :ast tid: argTid
    cdx: st.reg.genericParamConstraintOf :tdecl :paramName
    con: boundSpelling :ast desc: cdx
    tdn: qualifiedTemplateName :st :tdecl
    pnmT: zast.nameTextAt :ast ref: paramName
    m: "generic argument '\{an}' does not satisfy constraint '\{con}' on parameter '\{pnmT}' of '\{tdn}'"
    why: hashableUnmetReason :ast :st ck: cdx.kind tid: argTid
    if (isNullTid reg: st.reg tid: argTid) then {
        why = "'null' is reference-family -- it is a member of AnyRef and of a union bound with a null arm, not of a value-family bound".string
    }
    if why.length == 0 then why = boundFamilyUnmetReason :ast :st :tdecl desc: cdx :argTid
    if why.length > 0 then {
        m.append ": "
        m.append why
    }
    return m
}

# boundSpelling -- a bound as a report names it: its family, else its own
# name, else the text of the application it is written as.
boundSpelling: function {ast: Ast.view desc: ztypes.constraintdesc} out String is {
    con: constraintTextOf :desc
    if con.length == 0 when desc.boundApp.notZero then con = (
        statics.typeExprText
        :ast
        nid: desc.boundApp
    )
    if con.length == 0 when desc.boundName.notZero then {
        con = zast.nameTextCopy :ast ref: desc.boundName
    }
    return con
}

# refuseUnmetMethodBound -- `bt` is an instance whose argument does not meet a
# bound its member `cnId` adds to the type's parameter (methodBoundUnmet): the
# method does not exist on it, and the use is refused there, naming the bound.
refuseUnmetMethodBound: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out bool is {
    if bt.isZero or (st.reg.isPartialOf tid: bt) then return false
    u: methodBoundUnmet :ast :st monoId: bt nameId: cnId
    if u.tdecl.isZero then return false
    if st.mode.quietBounds then return true
    origin: st.reg.genericOriginOf tid: bt
    for each mb: (st.reg.methodBoundsOf mdecl: u.tdecl) loop {
        if mb.paramName == u.paramName then {
            an: specWrittenName :st :ast tid: u.argTid
            con: boundSpelling :ast desc: mb.bound
            mnT: zast.nameTextAt :ast ref: cnId
            pnmT: zast.nameTextAt :ast ref: u.paramName
            tdn: qualifiedTemplateName :st tdecl: (st.typing.declIdOfType typeId: origin)
            m: "generic argument '\{an}' does not satisfy constraint '\{con}' that method '\{mnT}' places on parameter '\{pnmT}' of '\{tdn}'"
            why: boundFamilyUnmetReason :ast :st tdecl: u.tdecl desc: mb.bound argTid: u.argTid
            if why.length > 0 then {
                m.append ": "
                m.append why
            }
            declare.reportConstraintUnmet :st at: dp.nid lineno: dp.lineno colno: dp.colno msg: m
            return true
        }
    }
    return true
}

# boundFamilyUnmetReason -- the family, when that is why a bound refuses its
# argument: a union or protocol bound admits reference types only, a variant or
# facet bound value types only; "" when the family is not the reason.
boundFamilyUnmetReason: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    tdecl: ztypes.declid
    desc: ztypes.constraintdesc
    argTid: ztypes.tid
} out String is {
    if (isNullTid reg: st.reg tid: argTid) then return "".string
    tt: boundDeclTypetype :ast :st :tdecl :desc
    if tt.none then return "".string
    fam: familyOfBoundTypetype :tt
    if fam.none then return "".string
    an: specWrittenName :st :ast tid: argTid
    kw: "union"
    if tt == ztypes.ztypetype.protocolType then kw = "protocol"
    if tt == ztypes.ztypetype.variantType then kw = "variant"
    if tt == ztypes.ztypetype.facetType then kw = "facet"
    if fam when (st.reg.isValtypeOf tid: argTid) then {
        return "'\{an}' is a value type, and a \{kw} bound admits reference types only"
    }
    if fam.not when (st.reg.isReftypeOf tid: argTid) then {
        return "'\{an}' is a reference type, and a \{kw} bound admits value types only"
    }
    return "".string
}

# hashableUnmetReason -- why a type of the bound's family has no usable `hash`
# and `==`, for the refusal of a hashable bound; "" for any other bound, or a
# type of the other family (the family is the reason there).
hashableUnmetReason: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    ck: ztypes.constraintkind
    tid: ztypes.tid
} out String is {
    if ck == ztypes.constraintkind.valHashable when (st.reg.isValtypeOf :tid) then {
        return (valHashableUnmetReason :ast :st :tid)
    }
    if ck == ztypes.constraintkind.refHashable when (st.reg.isReftypeOf :tid) then {
        kn: specWrittenName :st :ast :tid
        ho: valOpOwner typing: st.typing :tid nameId: zast.wellKnown.slot.wkHash
        if (st.typing.declIsMethodId parentTypeId: ho nameId: zast.wellKnown.slot.wkHash).not then {
            return "'\{kn}' declares no 'hash'"
        }
        eo: valOpOwner typing: st.typing :tid nameId: zast.wellKnown.slot.wkOpEq
        if (st.typing.declIsMethodId parentTypeId: eo nameId: zast.wellKnown.slot.wkOpEq).not then {
            return "'\{kn}' declares no '=='"
        }
        if (ownEqWithoutOwnHash :st :tid) then {
            return "it writes its own '==' but not its 'hash', and a key's two must agree".string
        }
    }
    return "".string
}

# valHashableUnmetReason -- the first thing that leaves a value type with no
# usable `==` or `hash`: its own member, or the part whose member is missing.
valHashableUnmetReason: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out String is {
    kn: specWrittenName :st :ast :tid
    em: valEqMissingPart :ast :st :tid depth: 0
    if em == tid then {
        eo: valOpOwner typing: st.typing :tid nameId: zast.wellKnown.slot.wkOpEq
        if (st.typing.declIsMethodId parentTypeId: eo nameId: zast.wellKnown.slot.wkOpEq) then {
            return "its '==' does not compare a '\{kn}' with another '\{kn}'"
        }
        return "'\{kn}' has no '=='"
    }
    if em.notZero then return "its part '\{specWrittenName :st :ast tid: em}' has no '=='"
    hm: valHashMissingPart :ast :st :tid depth: 0
    if hm.isZero then return "".string
    if hm != tid then return "its part '\{specWrittenName :st :ast tid: hm}' has no 'hash'"
    hsrc: valOpSource :ast reg: st.reg typing: st.typing :tid nameId: zast.wellKnown.slot.wkHash
    if hsrc.none then return "'\{kn}' has no 'hash'"
    return "it writes its own '==' but not its 'hash', and a key's two must agree".string
}

# typeIsHashable -- the type has both `hash` and `==`, so it may key a Map or
# a Set. Read straight off the DECLARATIONS: `hash` and `==` are synthesised
# for a valtype and declared for a reftype, and a member the author struck off
# with a null shell is simply absent -- so the opt-out needs no flag to record
# it, and there is exactly one place that asks.
#
# The answer is DERIVED rather than written back as an implementation row.
# Materialising one makes the emitter treat it as a user-written `:valhashable`
# and emit a facet vtable plus a wrapper per implementing type -- for members
# that have no body, and which nothing ever dispatches through: the containers
# call `hash`/`==` directly. The row would be pure bloat on every record in
# every program.
typeIsHashable: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out bool is {
    if tid.isZero then return false
    if (st.reg.isValtypeOf :tid) then {
        if (valEqMissingPart :ast :st :tid depth: 0).notZero then return false
        return (valHashMissingPart :ast :st :tid depth: 0).isZero
    }
    # a reference type declares both itself; a typedef takes each from the
    # first link of its chain that declares it, and a `null` shell is no method
    ho: valOpOwner typing: st.typing :tid nameId: zast.wellKnown.slot.wkHash
    if (st.typing.declIsMethodId parentTypeId: ho nameId: zast.wellKnown.slot.wkHash
    ).not then return false
    eo: valOpOwner typing: st.typing :tid nameId: zast.wellKnown.slot.wkOpEq
    if (st.typing.declIsMethodId parentTypeId: eo nameId: zast.wellKnown.slot.wkOpEq
    ).not then return false
    return (ownEqWithoutOwnHash :st :tid).not
}

# ownEqWithoutOwnHash -- a link of `tid`'s typedef chain writes its own `==`
# while the `hash` it would be keyed by is still its base's. The two must
# agree, and the base's hash knows nothing of the typedef's equality.
ownEqWithoutOwnHash: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    t: tid
    for t.notZero loop {
        bo: st.typing.typedefBaseTidOf tid: t
        if bo.isZero then return false
        if (st.typing.declMemberIdOf parentTypeId: t nameId: zast.wellKnown.slot.wkHash
        ).notZero then {
            return false
        }
        if (st.typing.declMemberIdOf parentTypeId: t nameId: zast.wellKnown.slot.wkOpEq
        ).notZero then {
            return true
        }
        t = bo
    }
    return false
}

# checkHashKey -- one key type, or one part of a generated key member.
checkHashKey: function {
    ast: Ast
    st: zenv.ZSymbolTable
    tid: ztypes.tid
    seen: IdSet ztypes.tid
    depth: u64
} is {
    if tid.isZero or (depth > 64) or (seen.has item: tid) then return
    seen.add item: tid
    if (st.reg.isValtypeOf :tid).not then {
        if (st.reg.isReftypeOf :tid).not then return
        (
            checkKeyMember
            :ast
            :st
            owner: (valOpOwner typing: st.typing :tid nameId: zast.wellKnown.slot.wkHash)
            nameId: zast.wellKnown.slot.wkHash
        )
        (
            checkKeyMember
            :ast
            :st
            owner: (valOpOwner typing: st.typing :tid nameId: zast.wellKnown.slot.wkOpEq)
            nameId: zast.wellKnown.slot.wkOpEq
        )
        return
    }
    hs: valOpSource :ast reg: st.reg typing: st.typing :tid nameId: zast.wellKnown.slot.wkHash
    es: valOpSource :ast reg: st.reg typing: st.typing :tid nameId: zast.wellKnown.slot.wkOpEq
    if hs.written then {
        ho: valOpOwner typing: st.typing :tid nameId: zast.wellKnown.slot.wkHash
        checkKeyMember :ast :st owner: ho nameId: zast.wellKnown.slot.wkHash
    }
    if es.written then {
        eo: valOpOwner typing: st.typing :tid nameId: zast.wellKnown.slot.wkOpEq
        checkKeyMember :ast :st owner: eo nameId: zast.wellKnown.slot.wkOpEq
    }
    if (hs.generated or es.generated).not then return
    parts: ListVal ztypes.tid
    (
        valPartTids
        reg: st.reg
        typing: st.typing
        tid: (valOpOwner typing: st.typing :tid nameId: zast.wellKnown.slot.wkOpEq)
        :parts
    )
    for each pt: parts loop {
        checkHashKey :ast :st tid: pt :seen depth: depth + 1
    }
}

# checkKeyMember -- `owner`'s member `nameId` (`hash` or `==`) against the key
# spec, reported at the member when it differs.
checkKeyMember: function {
    ast: Ast
    st: zenv.ZSymbolTable
    owner: ztypes.tid
    nameId: zast.nameid
} is {
    mid: implementationImplMethod :st implTid: owner mnameId: nameId
    if mid.isZero then return
    why: keyMemberMismatch :ast :st :owner :mid :nameId
    if why.length == 0 then return
    md: st.typing.declMemberIdOf parentTypeId: owner :nameId
    if md.isZero then return
    dn: (st.typing.decls.get i: md).node
    mnode: ast.nodes.getView i: dn
    kn: specWrittenName :st :ast tid: owner
    msg: "'\{kn}' cannot be a Map or Set key: "
    msg.append why
    (
        addErrorWithHint
        :st
        nodeid: dn
        lineno: (nodeLine n: mnode)
        colno: (nodeCol n: mnode)
        e: zast.err.typeError
        :msg
        note: "a key declares `hash: function {t: this.view} out u64` and `==: function {t: this.view rhs: type} out bool`".string
        hint: "".string
        width: 1
    )
}

# keyMemberMismatch -- how method `mid` differs from the key spec's member of
# the same name, or "" when it matches: its parameter count, its receiver,
# `==`'s parameter, and its return.
keyMemberMismatch: function {
    ast: Ast
    st: zenv.ZSymbolTable
    owner: ztypes.tid
    mid: ztypes.tid
    nameId: zast.nameid
} out String is {
    isHash: nameId == zast.wellKnown.slot.wkHash
    mname: zast.nameTextCopy :ast ref: nameId
    ids: ListVal ztypes.tid
    nms: ListVal zast.nameid
    implementationParams :st :mid :ids nameIds: nms
    want: 1.u64
    if isHash then want = 0
    if ids.length != want then {
        noun: implementationParamNoun n: ids.length
        return "its '\{mname}' takes \{ids.length} \{noun}, where a key's takes \{want}"
    }
    why: keyReceiverMismatch :st :mid mname: mname.stringView
    if why.length == 0 when isHash.not then why = (
        keyEqParamMismatch
        :ast
        :st
        :owner
        :mid
        pT: (ids.get i: 0)
        pnId: (nms.get i: 0)
    )
    if why.length == 0 then why = keyReturnMismatch :ast :st :mid mname: mname.stringView :isHash
    return why
}

# keyReceiverMismatch -- a key member's receiver is `.view`; a bare `:this`
# is not.
keyReceiverMismatch: function {
    st: zenv.ZSymbolTable.view
    mid: ztypes.tid
    mname: StringView
} out String is {
    rpn: st.reg.thisParamNameIdOf tid: mid
    rn: zast.wellKnown.slot.wkThis
    if rpn.notZero then rn = rpn
    rOwnO: st.typing.declOwnershipOfId parentTypeId: mid nameId: rn
    rOwn: rOwnO.or d: ztypes.zparamownership.noneMode
    if rOwn == ztypes.zparamownership.viewMode then return "".string
    rm: markerText o: rOwn
    rp: implementationMarkerPhrase m: rm.stringView
    return "its '\{mname}' has a receiver that is \{rp}, where a key's is `.view`"
}

# keyEqParamMismatch -- `==`'s parameter is the key's own type, unmarked, or a
# generic parameter whose bound admits the key.
keyEqParamMismatch: function {
    ast: Ast
    st: zenv.ZSymbolTable
    owner: ztypes.tid
    mid: ztypes.tid
    pT: ztypes.tid
    pnId: zast.nameid
} out String is {
    if (st.reg.typetypeOf typeId: pT) == ztypes.ztypetype.genericParam then {
        if (keyParamAdmits :ast :st :mid :pT key: owner) then return "".string
        kn: specWrittenName :st :ast tid: owner
        return "its '==' is generic, and its bound does not admit a '\{kn}'"
    }
    if pT != owner then {
        ptn: specWrittenName :st :ast tid: pT
        return "its '==' compares with a '\{ptn}', where a key's compares with its own type"
    }
    pO: implementationParamOwn :st :mid nameId: pnId tid: pT
    if pO == ztypes.zparamownership.noneMode then return "".string
    pm: markerText o: pO
    pp: implementationMarkerPhrase m: pm.stringView
    return "its '==' takes its parameter \{pp}, where a key's is unmarked"
}

# keyReturnMismatch -- a key's `hash` returns u64 and its `==` bool, both
# unmarked. A return not yet resolved is not judged.
keyReturnMismatch: function {
    ast: Ast
    st: zenv.ZSymbolTable
    mid: ztypes.tid
    mname: StringView
    isHash: bool
} out String is {
    wantT: stdTid :ast :st wk: zast.wellKnown.slot.wkBool
    if isHash then wantT = stdTid :ast :st wk: zast.wellKnown.slot.tyU64
    rt: methodReturnOf reg: st.reg typing: st.typing :mid
    if rt.some when rt != wantT then {
        rtn: specWrittenName :st :ast tid: rt
        wtn: specWrittenName :st :ast tid: wantT
        return "its '\{mname}' returns \{rtn}, where a key's returns \{wtn}"
    }
    rmk: implementationReturnMarker :st :mid
    if rmk.length == 0 then return "".string
    return "its '\{mname}' returns `.\{rmk}`, where a key's return is unmarked"
}

# keyParamAdmits -- a generic `==`'s parameter type `pT` admits the key: the
# bound of the method's type parameter holds for it, as String's StringLike
# one holds for a String.
keyParamAdmits: function {
    ast: Ast
    st: zenv.ZSymbolTable
    mid: ztypes.tid
    pT: ztypes.tid
    key: ztypes.tid
} out bool is {
    tdecl: st.typing.declIdOfType typeId: mid
    if tdecl.isZero then return true
    pn: st.reg.genericParamNameOfTid :tdecl ptid: pT
    cd: st.reg.genericParamConstraintOf :tdecl paramName: pn
    if cd.kind == ztypes.constraintkind.none then return true
    if cd.kind == ztypes.constraintkind.other then {
        return (namedBoundAdmits :ast :st :tdecl :cd argTid: key)
    }
    return (constraintHolds :ast :st ck: cd.kind argTid: key)
}

# valopsrc -- where a value type's `==`, `hash` or `compare` comes from. A
# generated member is built out of the parts' own, so the question is asked of
# every part as well as of the container.
valopsrc: variant {
    # the type has none: struck off with `null`, never declared, or the type is
    # a reference type, a facet or a generic parameter
    none: null
    # the runtime supplies it: a numeric, bool, str, a function pointer
    builtin: null
    # the author wrote it
    written: null
    # the author wrote only `!=`, and `==` is its negation
    negated: null
    # the compiler generates it from the parts
    generated: null
} as { tag: u8.tag }

# valOpOwner -- the type in `tid`'s typedef chain that carries member `nameId`,
# or the last type of the chain when none does. A `null` shell is a member: it
# stops the chase, so a typedef that strikes `==` off does not take its base's.
valOpOwner: function {
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    nameId: zast.nameid
} out ztypes.tid is {
    t: tid
    for t.notZero loop {
        if (typing.declMemberIdOf parentTypeId: t :nameId).notZero then return t
        bo: typing.typedefBaseTidOf tid: t
        if bo.isZero then return t
        t = bo
    }
    return t
}

# isValOpName -- `==`, `!=`, `hash` or `compare`: the members a value type may
# have generated from its parts.
isValOpName: function {cnId: zast.nameid} out bool is {
    if (cnId == zast.wellKnown.slot.wkOpEq) or (cnId == zast.wellKnown.slot.wkOpNe) then return true
    return (cnId == zast.wellKnown.slot.wkHash) or (cnId == zast.wellKnown.slot.wkCompare)
}

# specIsMarker -- `spec` is a MARKER protocol: it specifies no method, so its
# only member is the `create` every protocol is given
specIsMarker: function {st: zenv.ZSymbolTable.view spec: ztypes.tid} out bool is {
    if (st.reg.typetypeOf typeId: spec) != ztypes.ztypetype.protocolType then return false
    sd: st.typing.declIdOfType typeId: spec
    if sd.isZero then return false
    i: u64
    for i < (st.typing.declChildSlots declId: sd) loop {
        did: st.typing.declChildAt declId: sd index: i
        i = i + 1
        if did.notZero when (st.typing.decls.get i: did).name != zast.wellKnown.slot.wkCreate then {
            return false
        }
    }
    return true
}

# markSpecMembersUsed -- `impl` implements `spec`: the vtable wrapper calls
# every member the spec names, from the implementation row rather than a use
# site, so each is used on every link of `impl`'s typedef chain -- a slot is
# filled by the first link that declares the member.
markSpecMembersUsed: function {st: zenv.ZSymbolTable impl: ztypes.tid spec: ztypes.tid} is {
    sd: st.typing.declIdOfType typeId: spec
    if sd.isZero then return
    n: st.typing.declChildSlots declId: sd
    i: u64
    for i < n loop {
        did: st.typing.declChildAt declId: sd index: i
        i = i + 1
        if did.notZero then {
            mn: (st.typing.decls.get i: did).name
            t: impl
            for t.notZero loop {
                stdtypes.markMemberUsed :st ownerTid: t nameId: mn
                t = st.typing.typedefBaseTidOf tid: t
            }
        }
    }
}

# markKeyOpsUsed -- a Map or Set key is hashed and compared by the container,
# which no member reference spells.
markKeyOpsUsed: function {ast: Ast.view st: zenv.ZSymbolTable tid: ztypes.tid} is {
    markValOpUsed :ast :st :tid nameId: zast.wellKnown.slot.wkHash depth: 0
    markValOpUsed :ast :st :tid nameId: zast.wellKnown.slot.wkOpEq depth: 0
}

# markValOpUsed -- `tid`'s `==`, `!=`, `hash` or `compare` is used. A written
# member is marked used. A generated one is built from its parts' members, so
# theirs are, and a `==` negated from a written `!=` uses that; the generated
# member itself is not marked, as only a read of it by name asks the emitter to
# write it out as a function.
markValOpUsed: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    tid: ztypes.tid
    nameId: zast.nameid
    depth: u64
} is {
    if tid.isZero or (depth > 64) then return
    # an untyped number compares and hashes as the number it is emitted as,
    # with no member of its own
    if (isLiteralTypeId reg: st.reg :tid) then return
    owner: valOpOwner typing: st.typing :tid :nameId
    if owner.isZero then return
    md: st.typing.declMemberIdOf parentTypeId: owner :nameId
    if md.isZero then return
    if (st.typing.declMemberIsSynth parentTypeId: owner :nameId).not then {
        st.walk.usedMemberDecl.add item: md
        return
    }
    if nameId == zast.wellKnown.slot.wkOpEq when (
        valOpWritten
        :ast
        typing: st.typing
        :owner
        nameId: zast.wellKnown.slot.wkOpNe
    ) then {
        markValOpUsed :ast :st tid: owner nameId: zast.wellKnown.slot.wkOpNe depth: depth + 1
        return
    }
    parts: ListVal ztypes.tid
    valPartTids reg: st.reg typing: st.typing tid: owner :parts
    for each pt: parts loop {
        markValOpUsed :ast :st tid: pt :nameId depth: depth + 1
    }
}

# valOpSource -- where `tid`'s member `nameId` (`==`, `hash` or `compare`)
# comes from. Read from the DECLARATIONS alone, and no member is forced: this
# runs while members are still resolving, and resolving a signature here would
# mint its types out of demand order.
valOpSource: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    nameId: zast.nameid
} out valopsrc is {
    t: valOpOwner :typing :tid :nameId
    if t.isZero then return valopsrc.none
    tt: reg.typetypeOf typeId: t
    if tt == ztypes.ztypetype.functionType then return valopsrc.builtin
    isVal: tt.isValueData
    if isVal.not then return valopsrc.none
    md: typing.declMemberIdOf parentTypeId: t :nameId
    if md.isZero then return valopsrc.none
    # a str compares and hashes its content, which the runtime does
    if (numerics.valIsMonoOf :reg :typing tid: t wk: zast.wellKnown.slot.tyStr
    ) then return valopsrc.builtin
    # a `null` shell is a member that is not a method
    if (typing.declIsMethodId parentTypeId: t :nameId).not then return valopsrc.none
    if (typing.declMemberIsSynth parentTypeId: t :nameId).not then {
        return (valDeclaredSource :ast :typing owner: t :nameId memberDecl: md)
    }
    if nameId == zast.wellKnown.slot.wkOpEq then {
        neWritten: valOpWritten :ast :typing owner: t nameId: zast.wellKnown.slot.wkOpNe
        if neWritten then return valopsrc.negated
    }
    return valopsrc.generated
}

# valDeclaredSource -- where a member the declarations carry for `owner` itself
# comes from: the runtime or the author. A written comparison counts only when
# it compares the type with itself -- `pt ==` taking a u64 answers a different
# question.
valDeclaredSource: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    owner: ztypes.tid
    nameId: zast.nameid
    memberDecl: ztypes.declid
} out valopsrc is {
    fnode: valMemberFnNode :ast :typing :memberDecl
    if (declare.functiondefIsNative op: (ast.nodes.getView i: fnode)) then return valopsrc.builtin
    if nameId == zast.wellKnown.slot.wkHash then return valopsrc.written
    if (valRhsIsOwner :ast :typing :owner :fnode) then return valopsrc.written
    return valopsrc.none
}

# valMemberFnNode -- the function a member declaration names; zero when it
# names none.
valMemberFnNode: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    memberDecl: ztypes.declid
} out zast.nodeid is {
    fnode: zast.nodeid
    dn: ast.nodes.getView i: (typing.decls.get i: memberDecl).node
    if dn.namedoperation then fnode = dn.operation
    return fnode
}

# valOpWritten -- the author wrote member `nameId` of `owner`, as a method that
# compares the type with itself.
valOpWritten: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    owner: ztypes.tid
    nameId: zast.nameid
} out bool is {
    md: typing.declMemberIdOf parentTypeId: owner :nameId
    if md.isZero then return false
    if (typing.declIsMethodId parentTypeId: owner :nameId).not then return false
    if (typing.declMemberIsSynth parentTypeId: owner :nameId) then return false
    return (valRhsIsOwner :ast :typing :owner fnode: (valMemberFnNode :ast :typing memberDecl: md))
}

# valRhsIsOwner -- the second parameter of function `fnode` names the type that
# declares it: its own name, `type` or `this`. A mono's member is its
# template's, and so is the name the mono's declaration carries.
valRhsIsOwner: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    owner: ztypes.tid
    fnode: zast.nodeid
} out bool is {
    if fnode.isZero then return false
    pm: zast.fnParamAt :ast nid: fnode i: 1
    if pm.isZero then return false
    rn: zast.nameid
    pn: ast.nodes.getView i: pm
    if pn.namedoperation then rn = rootNameIdOf :ast n: (ast.nodes.getView i: pn.operation)
    if rn.isZero then return false
    if rn == zast.wellKnown.slot.wkThis then return true
    if rn == zast.wellKnown.slot.wkType then return true
    od: typing.declIdOfType typeId: owner
    if od.isZero then return false
    return rn == (typing.decls.get i: od).name
}

# valPartTids -- the parts a generated member of `tid` is built from: a
# record's fields, a variant's payloads, an array's element.
valPartTids: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    parts: ListVal ztypes.tid
} is {
    # a typedef is its base: a member generated on it is built from the base's
    tdb: typing.typedefBaseTidOf :tid
    if tdb.notZero then {
        parts.append tdb
        return
    }
    if (reg.typetypeOf typeId: tid) == ztypes.ztypetype.variantType then {
        resolve.variantPayloadTids :typing :tid :parts
        return
    }
    if (numerics.valIsMonoOf :reg :typing :tid wk: zast.wellKnown.slot.tyArray) then {
        parts.append (arrayElemTid :reg :tid)
        return
    }
    # a native record's layout is the runtime's: its as-block items (a number's
    # `tag`) are not parts, whatever they resolve to
    if (reg.isNativeOf :tid) then return
    names: ListVal zast.nameid
    dataFieldIds :reg :typing :tid ids: parts nameIds: names
}

# arrayElemTid -- an array instance's element type: its first argument that is
# a type rather than a value.
arrayElemTid: function {reg: ztypes.ZTypeRegistry.view tid: ztypes.tid} out ztypes.tid is {
    n: reg.genericArgCount specId: tid
    i: u64
    for i < n loop {
        ta: reg.genericTypeArgAt specId: tid ordinal: i
        if ta.notZero then return ta
        i = i + 1
    }
    return ztypes.tid
}

# valEqMissingPart -- the first part of `tid` that leaves it with no `==`, or
# `tid` itself when its own is struck off; zero when the type has one. A
# generated `==` compares the parts with their own, so it exists only when every
# part has one. A valtype cannot hold itself, so `depth` only bounds a
# malformed chain.
valEqMissingPart: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
    depth: u64
} out ztypes.tid is {
    src: valOpSource :ast reg: st.reg typing: st.typing :tid nameId: zast.wellKnown.slot.wkOpEq
    if src.none then return tid
    if src.generated.not then return ztypes.tid
    if depth > 64 then return tid
    owner: valOpOwner typing: st.typing :tid nameId: zast.wellKnown.slot.wkOpEq
    parts: ListVal ztypes.tid
    valPartTids reg: st.reg typing: st.typing tid: owner :parts
    for each p: parts loop {
        # an untyped number holds the i64 or f64 it is emitted as, and compares
        # as that number does
        if (isLiteralTypeId reg: st.reg tid: p) then continue
        if (valEqMissingPart :ast :st tid: p depth: depth + 1).notZero then return p
    }
    return ztypes.tid
}

# valHashMissingPart -- the first part of `tid` that leaves it with no usable
# `hash`, or `tid` itself; zero when it has one. The author's `hash` and the
# runtime's always count. A generated one hashes the parts, so it agrees with
# `==` only when `==` is generated too -- or is the runtime's, as a number's is
# -- and every part has a hash: a type that writes its `==` must write its
# `hash` to be a key.
valHashMissingPart: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
    depth: u64
} out ztypes.tid is {
    src: valOpSource :ast reg: st.reg typing: st.typing :tid nameId: zast.wellKnown.slot.wkHash
    if src.none then return tid
    if src.generated.not then return ztypes.tid
    eqSrc: valOpSource :ast reg: st.reg typing: st.typing :tid nameId: zast.wellKnown.slot.wkOpEq
    if (eqSrc.generated or eqSrc.builtin).not then return tid
    if depth > 64 then return tid
    owner: valOpOwner typing: st.typing :tid nameId: zast.wellKnown.slot.wkHash
    parts: ListVal ztypes.tid
    valPartTids reg: st.reg typing: st.typing tid: owner :parts
    for each p: parts loop {
        # an untyped number hashes as the i64 it is emitted as; a float has no
        # hash, so neither has a floatliteral
        if p == st.reg.literalFloatTid then return p
        if p == st.reg.literalIntTid then continue
        if (valHashMissingPart :ast :st tid: p depth: depth + 1).notZero then return p
    }
    return ztypes.tid
}

# forceValParts -- resolve the fields a generated `==` of `tid` is built from,
# all the way down, so valEqMissingPart reads complete declarations. A field
# that has not been resolved carries no type and would read as a part with none.
forceValParts: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tid: ztypes.tid
    depth: u64
} is {
    if depth > 64 then return
    if (valOpSource :ast reg: st.reg typing: st.typing :tid nameId: zast.wellKnown.slot.wkOpEq
    ).generated.not then return
    owner: valOpOwner typing: st.typing :tid nameId: zast.wellKnown.slot.wkOpEq
    forceAllFields :st :ast tid: owner
    parts: ListVal ztypes.tid
    valPartTids reg: st.reg typing: st.typing tid: owner :parts
    for each p: parts loop {
        forceValParts :st :ast tid: p depth: depth + 1
    }
}

# refuseListMemberWithoutElemOp -- `contains`, `==` or `!=` read on a list
# whose element type has no `==` of its own, or `sort` on one whose element
# type has no `compare`: the members use the element's, so for such an
# element they do not exist, and the read is the ordinary unknown-member
# error. Checked where the member is used, as a generated `==` is: the list
# instance itself is legal. True when it reported.
refuseListMemberWithoutElemOp: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out bool is {
    isCmp: (
        (cnId == zast.wellKnown.slot.wkContains) or
        (cnId == zast.wellKnown.slot.wkOpEq) or
        (cnId == zast.wellKnown.slot.wkOpNe)
    )
    isSort: cnId == zast.wellKnown.slot.wkSort
    if isCmp.not when isSort.not then return false
    if (st.reg.isPartialOf tid: bt) then return false
    org: st.reg.genericOriginOf tid: bt
    if org.isZero then return false
    isList: org == (stdTid :ast :st wk: zast.wellKnown.slot.tyListVal)
    if isList.not then isList = org == (stdTid :ast :st wk: zast.wellKnown.slot.tyListRef)
    if isList.not then return false
    elem: arrayElemTid reg: st.reg tid: bt
    if elem.isZero then return false
    if (st.reg.typetypeOf typeId: elem) == ztypes.ztypetype.genericParam then return false
    if isCmp when (listElemHasEq :st :ast :elem) then {
        markValOpUsed :ast :st tid: elem nameId: zast.wellKnown.slot.wkOpEq depth: 0
        return false
    }
    if isSort when (listElemHasCompare :st :ast :elem) then {
        markValOpUsed :ast :st tid: elem nameId: zast.wellKnown.slot.wkCompare depth: 0
        return false
    }
    cn: zast.nameTextAt :ast ref: cnId
    btn: specWrittenName :st :ast tid: bt
    en: specWrittenName :st :ast tid: elem
    m: "type '\{btn}' has no member '\{cn}'"
    h: "its element type '\{en}' has no '=='"
    if isSort then h = "its element type '\{en}' has no 'compare'"
    cn2: ast.nodes.getView i: dp.child
    (
        addErrorWithHint
        :st
        nodeid: (zast.nodeIdOf n: cn2)
        lineno: (nodeLine n: cn2)
        colno: (nodeCol n: cn2)
        e: zast.err.typeError
        msg: m
        note: "".string
        hint: h
        width: cn.length
    )
    return true
}

# listElemHasCompare -- a list element type that has a `compare` of its own:
# the runtime's (an integer, a char, bool, str, String) or the author's. None
# is generated -- an order is the author's to choose -- and a float has none.
listElemHasCompare: function {st: zenv.ZSymbolTable ast: Ast elem: ztypes.tid} out bool is {
    if (st.reg.isValtypeOf tid: elem) then {
        src: (
            valOpSource
            :ast
            reg: st.reg
            typing: st.typing
            tid: elem
            nameId: zast.wellKnown.slot.wkCompare
        )
        return src.builtin or src.written
    }
    et: typedefChaseTid typing: st.typing tid: elem
    return (st.typing.declIsMethodId parentTypeId: et nameId: zast.wellKnown.slot.wkCompare)
}

# listElemHasEq -- a list element type that has an `==` of its own: a value
# type by the generated-`==` rule, a reference type by declaring one.
listElemHasEq: function {st: zenv.ZSymbolTable ast: Ast elem: ztypes.tid} out bool is {
    if (st.reg.isValtypeOf tid: elem) then {
        forceValParts :st :ast tid: elem depth: 0
        return (valEqMissingPart :ast :st tid: elem depth: 0).isZero
    }
    et: typedefChaseTid typing: st.typing tid: elem
    return (st.typing.declIsMethodId parentTypeId: et nameId: zast.wellKnown.slot.wkOpEq)
}

# refuseHashWithoutPartHash -- a generated `hash` read on a type whose `==` is
# not generated, or one of whose parts has no hash: the type has no `hash`, and
# the read is the ordinary unknown-member error. Otherwise the read is
# recorded, so the emitter writes the hash, and the member is given its `u64`
# result here: minting `u64` where the member itself is minted would pull it
# ahead of the demand order. True when it reported.
refuseHashWithoutPartHash: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    mo: ztypes.tid
} out bool is {
    if (st.reg.isPartialOf tid: bt) then return false
    forceValParts :st :ast tid: bt depth: 0
    miss: valHashMissingPart :ast :st tid: bt depth: 0
    if miss.isZero then {
        st.typing.hashUsed.add item: bt
        st.reg.setReturnType typeId: mo value: (stdTid :ast :st wk: zast.wellKnown.slot.tyU64)
        return false
    }
    btn: specWrittenName :st :ast tid: bt
    m: "type '\{btn}' has no member 'hash'"
    h: String
    if (miss == bt).not then {
        mn: specWrittenName :st :ast tid: miss
        hm: "its part of type '\{mn}' has no 'hash'"
        h = hm.take
    }
    eqSrc: valOpSource :ast reg: st.reg typing: st.typing tid: bt nameId: zast.wellKnown.slot.wkOpEq
    if miss == bt when eqSrc.written or eqSrc.negated then {
        h = "its `==` is written by hand, and a generated `hash` would not agree with it".string
    }
    cn2: ast.nodes.getView i: dp.child
    (
        addErrorWithHint
        :st
        nodeid: (zast.nodeIdOf n: cn2)
        lineno: (nodeLine n: cn2)
        colno: (nodeCol n: cn2)
        e: zast.err.typeError
        msg: m
        note: "".string
        hint: h
        width: 4
    )
    return true
}

# refuseEqWithoutPartEq -- a generated `==` or `!=` read on a type one of
# whose parts has no `==` of its own. The type has none either, and the read is
# the ordinary unknown-member error. True when it reported.
refuseEqWithoutPartEq: function {
    st: zenv.ZSymbolTable
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
} out bool is {
    if (st.reg.isPartialOf tid: bt) then return false
    miss: ztypes.tid
    known: st.walk.valEqMissing.get key: bt
    match (
        known
    ) case some then {
        miss = known
    } case none then {
        forceValParts :st :ast tid: bt depth: 0
        miss = valEqMissingPart :ast :st tid: bt depth: 0
        st.walk.valEqMissing.set key: bt value: miss
    }
    if miss.isZero then return false
    cn: zast.nameTextAt :ast ref: cnId
    btn: specWrittenName :st :ast tid: bt
    m: "type '\{btn}' has no member '\{cn}'"
    h: String
    if (miss == bt).not then {
        mn: specWrittenName :st :ast tid: miss
        hm: "its part of type '\{mn}' has no '=='"
        h = hm.take
    }
    cn2: ast.nodes.getView i: dp.child
    (
        addErrorWithHint
        :st
        nodeid: (zast.nodeIdOf n: cn2)
        lineno: (nodeLine n: cn2)
        colno: (nodeCol n: cn2)
        e: zast.err.typeError
        msg: m
        note: "".string
        hint: h
        width: cn.length
    )
    return true
}

# staticIndexAdmits -- a list's index type: one `system.idkey` admits, read off
# its declaration as any variant bound is (sumBoundDeclAdmits), a typedef over
# an unsigned scalar included
staticIndexAdmits: function {ast: Ast st: zenv.ZSymbolTable argTid: ztypes.tid} out bool is {
    bd: (
        st.typing.declFindChild
        parentDeclId: st.typing.systemUnitRoot
        nameId: zast.wellKnown.slot.tyIdkey
    )
    if bd.isZero then return false
    return (sumBoundDeclAdmits :ast :st :bd isUnion: false :argTid)
}

# methodReturnOf -- a method FUNCTION type's return type id: the synthesized
# returnTypeId link when set, else the AST method's recorded `out T` ref node
# (funcReturnNode) read through the post-demand stamp.
methodReturnOf: function {
    reg: ztypes.ZTypeRegistry.view typing: ztyping.ZTyping.view mid: ztypes.tid
} out optionval ztypes.tid is {
    rto: reg.returnTypeOf tid: mid
    if rto.notZero then return (optionval.some rto)
    # A SYNTHESISED COMPARISON RETURNS BOOL. It cannot be given that return type
    # where it is minted (see synthComparisonMember), and the eager tier never
    # calls forceMemberDecl on it, so this -- the one place both tiers read a
    # method's return type -- is where the answer belongs.
    if (typing.synthCmpTids.has item: mid
    ) when typing.boolTid.notZero then return (optionval.some typing.boolTid)
    rn: typing.funcReturnNode.get key: mid
    if rn.some then {
        nt: ztyping.nodeTypeAt tbl: typing.nodeType nid: rn
        if nt.notZero then return (optionval.some nt)
        # a return type naming nothing was reported where it is written: a call
        # has a value of no type, not none
        if (typing.refusedValues.has item: rn) then return (optionval.some ztypes.tid.zero)
    }
    return (optionval.none ztypes.tid)
}

# markTypedefListViewUse -- `cnId` is a list-view conversion used on a typedef
# `bt`: record its base instance's listView as used too, since the conversion
# lowers to it.
markTypedefListViewUse: function {
    st: zenv.ZSymbolTable
    bt: ztypes.tid
    cnId: zast.nameid
} is {
    if (isListViewMember nameId: cnId).not then return
    base: st.typing.typedefBaseTidOf tid: bt
    if base.isZero then return
    lvD: st.typing.declMemberIdOf parentTypeId: base nameId: zast.wellKnown.slot.wkListView
    if lvD.notZero then st.walk.usedMemberDecl.add item: lvD
}

# checkResolvedMember -- the member resolved on the base type. Stamps the owner for
# tooling and the emitter, then runs the legs in order: tagged-type construction
# or arm predicate, the `as` constant, the projection legs, the auto-call, and
# finally the public-interface gate.
checkResolvedMember: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    dp: dpref
    bt: ztypes.tid
    cnId: zast.nameid
    mo: ztypes.tid
    coerce: bool
    aliasViaX: bool
} out ztypes.tid is {
    # member-owner stamp: the use-site dotted path resolved a member of
    # `bt` (field, method, or tagged arm). Tooling reads the member's
    # declaration for go-to-definition; the emitter derives the owner
    # from it to gate the numeric-cast leg (a scalar-named member of a
    # user type is not a conversion).
    if dp.nid.notZero when bt.notZero then {
        mD: memberaccess.declMemberOf :st ownerTid: bt nameId: cnId
        memberaccess.stampRefDecl :st nid: dp.nid declId: mD
        # and the member of the RECEIVER's own type. declMemberOf walks a mono
        # to the template that minted it, so mD names the template's member;
        # the emitter needs to know which INSTANCE was used
        stdtypes.markMemberUsed :st ownerTid: bt nameId: cnId
        # a generated comparison or hash reaches its parts' own
        if (isValOpName :cnId) then markValOpUsed :ast :st tid: bt nameId: cnId depth: 0
        # a typedef's view conversion (`Bytes.byteView`) IS its base's listView,
        # which the emitter writes only for a base instance something used
        markTypedefListViewUse :st :bt :cnId
    }
    if (memberaccess.memberTyperefRefused :st :ast :bt nameId: cnId) then return ztypes.tid.zero
    if (instantiate.checkMemberNamespace :st :ast :unitDecl :dp :bt :cnId :mo :coerce
    ).not then return ztypes.tid.zero
    # a generated comparison exists only when every part has one
    isSynthCmp: st.typing.synthCmpTids.has item: mo
    if isSynthCmp when (refuseEqWithoutPartEq :st :ast :dp :bt :cnId) then return ztypes.tid
    if (refuseListMemberWithoutElemOp :st :ast :dp :bt :cnId) then return ztypes.tid
    isSynthHash: (
        (cnId == zast.wellKnown.slot.wkHash) and
        (st.typing.declMemberIsSynth parentTypeId: bt nameId: cnId)
    )
    if isSynthHash when (refuseHashWithoutPartHash :st :ast :dp :bt :mo) then return ztypes.tid
    # a type's `as` constant reads as its value, typed by it
    memberDecl: st.typing.declMemberIdOf parentTypeId: bt nameId: cnId
    if (st.typing.isAsConstDecl declId: memberDecl) then {
        # an instantiation's constant is folded for it when first read: its
        # template's value may read a numeric generic parameter
        acv: statics.constValueOfMemberTidId :ast :st unitTid: bt nameId: cnId
        if acv.isConst then consteval.keepNodeConst :st nid: dp.nid cv: acv
        if acv.kind.none when (memberaccess.refuseTemplateOnlyConstant :st :ast :dp :bt :cnId
        ) then return ztypes.tid
        # a template's constant over its numeric parameter has a value only in
        # an instance, and so a type only there: the branches of an `if` may
        # give each instance a value of another type, which the template's
        # member cannot know. One whose type names a type parameter (`out
        # staticlist t`) is the instance's value, of the instance's type.
        rt: mo
        if acv.isConst when (
            (instanceConstantRead :st :ast :bt :memberDecl) or (st.reg.isPartialOf tid: mo)
        ) then {
            vt: statics.constValueTid :ast :st scope: unitDecl v: acv
            if vt.notZero then rt = vt
        }
        stampGate :st nid: dp.nid tid: rt
        return rt
    }
    tgleg: instantiate.checkTaggedMemberPath :st :unitDecl :ast :dp :bt :cnId :mo :aliasViaX
    if tgleg.handled then return tgleg.tid
    rm: mo
    result: ztypes.tid
    result = rm
    prleg: valuechecks.checkMemberProjections :st :ast :dp :bt :cnId :mo :rm :coerce
    if prleg.handled then return prleg.tid
    # A field READ of a path another variable holds an EXCLUSIVE pin on (the
    # `.borrow` input of an `outx` result) is refused: read through the holder
    # instead. Asked of the OUTERMOST path only (a base walk sets
    # suppressBareCtor): a method receiver is judged by the lock its call
    # takes, a reftype argument by the lock the call takes on it, and a write
    # target by checkWriteLock.
    if st.mode.inAssignTarget.not when st.mode.suppressBareCtor.not when (
        (st.reg.typetypeOf typeId: mo) != ztypes.ztypetype.functionType
    ) then {
        argVal: false
        if dp.nid == st.walk.value.callArgNode when (st.reg.isReftypeOf tid: rm) then argVal = true
        if argVal.not then (
            moves.refuseReadUnderPin
            :st
            :ast
            nid: dp.nid
            lineno: dp.lineno
            colno: dp.colno
        )
    }
    # A FUNCTION FIELD NAMED AS A WRITE TARGET is the slot, not a call of it:
    # `h.zero = other.take` replaces the function, where auto-calling typed the
    # target as the function's result. Asked of the OUTERMOST path only.
    callIt: coerce
    if st.mode.inAssignTarget when st.mode.suppressBareCtor.not when (
        st.typing.declIsFnptrFieldId
        parentTypeId: bt
        nameId: cnId
    ) then callIt = false
    result = (
        moves.checkMemberAutoCall
        :st
        :ast
        :unitDecl
        :dp
        :bt
        :mo
        coerce: callIt
        memberResult: result
    )
    # a refused read has no type, so what binds it is not refused again at
    # each use (`v: c.compare` then `"\{v}"`)
    if coerce when (moves.reportBareMemberRef :st :ast :unitDecl :dp :bt :cnId :mo :result) then {
        result = ztypes.tid.zero
    }
    memberaccess.reportPrivateMember :st :ast :dp :bt :cnId :aliasViaX
    moves.readBorrowedField :st :ast :unitDecl base: dp.parent :bt :cnId
    stampGate :st nid: dp.nid tid: result
    return (valuechecks.callFieldObject :st :unitDecl :ast :dp :mo :coerce :result)
}

# literalConvTarget -- the type a literal's declared conversion `nameId`
# produces, or none when the literal type does not declare it. The declaration
# holds the surface (`intliteral.u8` is `function {:this} out u8`), so the
# target is that method's return type; nothing here knows the sixteen names.
literalConvTarget: function {
    ast: Ast
    st: zenv.ZSymbolTable
    tid: ztypes.tid
    nameId: zast.nameid
} out optionval ztypes.tid is {
    if nameId.isZero then return (optionval.none ztypes.tid)
    # DEMAND IT FIRST. Members materialise when something asks for them, so a
    # bare declChildOfId on a type nothing has reached yet answers none -- and
    # the literal types are reached by literals, not by name.
    forceMemberOf :st :ast parentTypeId: tid :nameId
    co: st.typing.declChildOfId parentTypeId: tid :nameId
    if co.some then {
        rt: methodReturnOf reg: st.reg typing: st.typing mid: co
        if rt.some then {
            return (optionval.some rt)
        }
    }
    return (optionval.none ztypes.tid)
}

# isNullTid -- the type is `null`, the payload-less marker.
isNullTid: function {reg: ztypes.ZTypeRegistry.view tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    return (reg.typetypeOf typeId: tid) == ztypes.ztypetype.nullType
}

# memberIsDataField -- whether a member row is stored in the type's C struct:
# every parameter of a function type; an fnptr field; a field whose type is
# not itself a function, is not an `as` constant, and is not one of the
# type's implementation-marker labels (`mkIds`).
memberIsDataField: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    # the row's name id and type
    tcNameId: zast.nameid
    cto: ztypes.tid
    # the type is a function type: every row is a parameter
    isFn: bool
    # the type's implementation-marker label ids
    mkIds: (ListVal zast.nameid).view
} out bool is {
    if isFn then return true
    if (typing.declIsFnptrFieldId parentTypeId: tid nameId: tcNameId) then return true
    if cto.isZero then return false
    if (reg.typetypeOf typeId: cto) == ztypes.ztypetype.functionType then {
        return false
    }
    # a field an instance types `null` (`v: T` with T = null) carries nothing:
    # it has no storage and takes no argument. A sum's null arm is its own case.
    if (isNullTid :reg tid: cto) when (reg.typetypeOf typeId: tid).isSum.not then {
        return false
    }
    if (
        typing.isAsConstDecl
        declId: (typing.declMemberIdOf parentTypeId: tid nameId: tcNameId)
    ) then return false
    for each mv: mkIds loop {
        if mv.notZero when mv == tcNameId then return false
    }
    return true
}

# implementationMarkerIds -- the label ids of `tid`'s implementation markers: its own
# rows, and those of the generic template it is an instance of, whose markers
# hold for every instance (zenv.isImplementationLabelOf asks the same of one name).
implementationMarkerIds: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    ids: ListVal zast.nameid
} is {
    og: reg.genericOriginOf :tid
    cfId: ztypes.confid
    for cfId.next < typing.nextConf loop {
        cfId = cfId.next
        crow: typing.implementation.get i: cfId
        if (crow.implTypeId == tid) or (og.notZero and (crow.implTypeId == og)) then {
            ids.append crow.labelNameId
        }
    }
}

# dataFieldIds -- a type's user-supplied data fields/params in order, as the
# (name pool id, type id) pairs: for a FUNCTION, all params; for a record/class,
# fnptr fields plus non-FUNCTION fields, excluding as-block constants
# (asConstDecls) and implementation markers. dataFieldNames is this plus the texts,
# so what counts as a data field is decided in one place; a caller that only
# needs the ids takes this one and pays for no text at all.
dataFieldIds: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    ids: ListVal ztypes.tid
    nameIds: ListVal zast.nameid
} is {
    isFn: (reg.typetypeOf typeId: tid) == ztypes.ztypetype.functionType
    # this type's implementation-marker label ids, collected once (the per-field
    # probe below is a scan over these few ids, not the whole table)
    fieldIds: ListVal zast.nameid
    if isFn.not then implementationMarkerIds :reg :typing :tid ids: fieldIds
    ri: u64
    rowCount: typing.declRowSlots ownerTid: tid
    for ri < rowCount loop {
        row: typing.declRowAt ownerTid: tid membersOnly: true slot: ri
        ri = ri + 1
        if (dataFieldKeeps :reg :typing :tid :row :isFn mkIds: fieldIds) then {
            ids.append row.tid
            nameIds.append row.name
        }
    }
}

# dataFieldKeeps -- whether member row `row` of `tid` is one of its data
# fields: the one test dataFieldIds applies per row, for a walk over the
# rows that needs no list of them.
dataFieldKeeps: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    row: ztyping.declrow
    isFn: bool
    mkIds: (ListVal zast.nameid).view
} out bool is {
    if row.keep.not then return false
    return (memberIsDataField :reg :typing :tid tcNameId: row.name cto: row.tid :isFn :mkIds)
}

# dataFieldNames -- dataFieldIds with each field's text alongside its ids. The
# emitter's recFieldLists is this function, so a record's C struct and its
# checked field list cannot drift apart.
dataFieldNames: function {
    ast: Ast.view
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
    names: List String
    ids: ListVal ztypes.tid
    nameIds: ListVal zast.nameid
} is {
    dataFieldIds :reg :typing :tid :ids :nameIds
    for each nidx: nameIds loop {
        cnBn: ast.names.texts.get i: nidx
        cnn: cnBn.copy
        names.append cnn
    }
}

# holdStandIn -- a stand-in that holds: the implementation a typedef inherits is
# recorded, and the value is kept (standInOf) for the emitter to box as the spec
# where it is written; one that already is the spec is not a stand-in.
holdStandIn: function {ast: Ast st: zenv.ZSymbolTable su: ztyping.specstandin} is {
    recordInheritedImplementation :ast :st value: su.value spec: su.spec
    if su.value != su.spec then st.typing.standInOf.set key: su.valueNid value: su
}

# checkSpecStandIns -- every value noted where a spec value is expected
# implements the spec: an implementation row names its type, or the template it
# was instantiated from. Anything else would typecheck and then fail in the
# C compiler, whatever its type -- an i64 passed for a protocol parameter
# included. A type parameter, and a type still partial, are the instance's
# to decide.
checkSpecStandIns: function {ast: Ast st: zenv.ZSymbolTable} is {
    bad: ListVal u64
    n: st.walk.specStandIns.length
    i: u64
    for i < n loop {
        su: st.walk.specStandIns.get :i
        if (specStandInHolds :st value: su.value spec: su.spec).not then {
            bad.append from: i
        } else if su.owning when (standInNeedsBox :st value: su.value spec: su.spec) then {
            bad.append from: i
        } else {
            holdStandIn :ast :st :su
        }
        i = i + 1
    }
    for each bi: bad loop {
        su: st.walk.specStandIns.get i: bi
        if (specStandInHolds :st value: su.value spec: su.spec) then {
            reportOwnedStandIn :ast :st :su
            continue
        }
        vn: "'\{specWrittenName :st :ast tid: su.value}'"
        if (isLiteralTypeId reg: st.reg tid: su.value) then vn = "a numeric literal".string
        sn: specWrittenName :st :ast tid: su.spec
        hn: "a type implementing it declares `name: \{sn}.implement` in its `as` block"
        why: "it does not implement it".string
        if (st.reg.typetypeOf typeId: su.value) == ztypes.ztypetype.protocolType then {
            why = "a protocol value wraps the value implementing it and stands in for its own protocol only".string
        }
        (
            addErrorWithHint
            :st
            nodeid: su.nid
            lineno: su.lineno
            colno: su.colno
            e: zast.err.typeError
            msg: "\{vn} cannot stand in for \{sn}: \{why}"
            note: String
            hint: hn
            width: 1
        )
    }
}

# recordInheritedImplementation -- a typedef that stands in for `spec` through its
# base takes the base's implementation row as its own, under the base's label.
# The emitter builds an implementer's vtable from its row, and each slot is the
# typedef's first declarer of that method -- an override it writes included --
# so the base's own vtable would not serve it.
recordInheritedImplementation: function {
    ast: Ast
    st: zenv.ZSymbolTable
    value: ztypes.tid
    spec: ztypes.tid
} is {
    if (st.typing.typedefBaseTidOf tid: value).isZero then return
    src: implementationRowLink :st impl: value :spec
    if src.isZero or (src == value) then return
    if (typedefInheritsImplementation :st impl: value :spec).not then return
    lbl: String
    lblId: zast.nameid
    isF: false
    srcOg: st.reg.genericOriginOf tid: src
    cfId: ztypes.confid
    for cfId.next < st.typing.nextConf loop {
        cfId = cfId.next
        crow: st.typing.implementation.get i: cfId
        isSrc: crow.implTypeId == src
        if srcOg.notZero when crow.implTypeId == srcOg then isSrc = true
        if crow.specTypeId == spec when isSrc when lbl.length == 0 then {
            lbl = crow.label.copy
            lblId = crow.labelNameId
            isF = crow.isFacet
        }
    }
    (
        st.typing.addImplementation
        implTypeId: value
        specTypeId: spec
        label: lbl.stringView
        labelNameId: lblId
        isFacet: isF
    )
    markSpecMembersUsed :st impl: value :spec
    forceAllMembers :st :ast tid: value
}

# implementationRowLink -- the first link of `impl`'s typedef chain, `impl` itself
# first, that an implementation row names against `spec` -- a row on the link, or
# on the template it is an instance of (`str_8` implements by str's `:StringViewable`);
# zero when none does.
implementationRowLink: function {
    st: zenv.ZSymbolTable.view impl: ztypes.tid spec: ztypes.tid
} out ztypes.tid is {
    t: impl
    for t.notZero loop {
        og: st.reg.genericOriginOf tid: t
        cfId: ztypes.confid
        for cfId.next < st.typing.nextConf loop {
            cfId = cfId.next
            crow: st.typing.implementation.get i: cfId
            isT: crow.implTypeId == t
            if og.notZero when crow.implTypeId == og then isT = true
            if crow.specTypeId == spec when isT then return t
        }
        t = st.typing.typedefBaseTidOf tid: t
    }
    return t
}

# standInNeedsBox -- a concrete implementer written for a PROTOCOL: an owning
# place refuses it, since only a borrowing one may take it as the spec
# implicitly. A protocol's implementers are a class or a union (a record or a
# variant implements a facet, and is refused as a non-implementer before this);
# a value of the spec's own type (a box already), a type parameter, and a facet
# place are not this rule's.
standInNeedsBox: function {
    st: zenv.ZSymbolTable.view
    value: ztypes.tid
    spec: ztypes.tid
} out bool is {
    if value == spec then return false
    if (st.reg.typetypeOf typeId: spec) != ztypes.ztypetype.protocolType then return false
    return (st.reg.typetypeOf typeId: value).isReferenceData
}

# signatureReturnText -- a function type's return as its signature writes it,
# ` out T` or ` outx T` with the return's marker, "" for none
signatureReturnText: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    tid: ztypes.tid
    # the signatures being spelled, this one last
    seen: ListVal ztypes.tid
} out String is {
    r: String
    ro: methodReturnOf reg: st.reg typing: st.typing mid: tid
    if ro.none then return r
    if (st.typing.funcPins.has item: tid) then {
        r.append " outx "
    } else r.append " out "
    r.append (moves.signatureMemberName :st :ast tid: ro :seen)
    rm: markerText o: (st.typing.returnMarkerOf :tid)
    if rm.length > 0 then {
        r.append "."
        r.append rm
    }
    return r
}

# reportOwnedStandIn -- an implementer written where the value is owned. The
# place would own a box of a value it never took, so it says how to make one
# that owns: `P.create from: d.take`, or the construction wrapped as it is.
reportOwnedStandIn: function {ast: Ast st: zenv.ZSymbolTable su: ztyping.specstandin} is {
    vn: specWrittenName :st :ast tid: su.value
    sn: specWrittenName :st :ast tid: su.spec
    fix: "wrap it: `\{sn}.create from: (...)`"
    bn: zast.atomNameIdOf n: (ast.nodes.getView i: su.valueNid)
    if bn.isZero then bn = moves.takenBareName :ast nid: su.valueNid
    if bn.notZero then {
        bt: zast.nameTextAt :ast ref: bn
        fix = "write `\{sn}.create from: \{bt}.take`"
    }
    (
        addErrorWithHint
        :st
        nodeid: su.nid
        lineno: su.lineno
        colno: su.colno
        e: zast.err.typeError
        msg: "'\{vn}' cannot stand in for \{sn} where the value is owned: \{fix}"
        note: "only a borrowing place -- a borrow or view parameter, or `\{sn} d` -- takes a value implementing the protocol as the protocol implicitly"
        hint: String
        width: 1
    )
}

# specStandInHolds -- `value` may be written where `spec` is expected. A
# protocol value is itself the wrapper around its implementer, so it stands in for
# its own protocol only, never for a marker it declares.
specStandInHolds: function {
    st: zenv.ZSymbolTable.view
    value: ztypes.tid
    spec: ztypes.tid
} out bool is {
    if value.isZero or (value == spec) then return true
    vtt: st.reg.typetypeOf typeId: value
    if vtt == ztypes.ztypetype.genericParam then return true
    if vtt == ztypes.ztypetype.protocolType then return false
    if (st.reg.isPartialOf tid: value) then return true
    return (typeImplements :st impl: value :spec)
}

# functionSignaturesMatch -- a function value `a` fits a place typed by the
# function type `b`: the same parameters in order, with the same names, types and
# ownership, and the same return, `out` or `outx` and its marker included. Specs and functions are structurally typed, so
# this is the whole of the rule; it was not asked at all, and a function of any
# signature stored in a function field or passed for a function parameter
# reached the C as an incompatible pointer. A generic parameter on either side
# matches, as it does wherever types are compared before instantiation.
functionSignaturesMatch: function {
    ast: Ast
    st: zenv.ZSymbolTable
    a: ztypes.tid
    b: ztypes.tid
} out bool is {
    if a == b then return true
    if (st.reg.typetypeOf typeId: a) != ztypes.ztypetype.functionType then return false
    an: ListVal zast.nameid
    at: ListVal ztypes.tid
    bn: ListVal zast.nameid
    bt: ListVal ztypes.tid
    collectParamRows :st fnTid: a names: an tids: at
    collectParamRows :st fnTid: b names: bn tids: bt
    if an.length != bn.length then return false
    i: u64
    for i < an.length loop {
        if (an.get :i) != (bn.get :i) then return false
        if (paramTypesMatch :ast :st a: (at.get :i) b: (bt.get :i)).not then {
            return false
        }
        pnm: an.get :i
        ao: st.typing.declOwnershipOfId parentTypeId: a nameId: pnm
        bo: st.typing.declOwnershipOfId parentTypeId: b nameId: pnm
        if ao != bo then return false
        i = i + 1
    }
    # the result is the same kind of result: an `outx` one keeps its inputs
    # locked, and a call through a slot typed `out` would keep nothing
    if (st.typing.funcPins.has item: a) != (st.typing.funcPins.has item: b) then return false
    sameMarker: (implementationReturnMarker :st mid: a) == (implementationReturnMarker :st mid: b)
    if sameMarker.not then return false
    ar: methodReturnOf reg: st.reg typing: st.typing mid: a
    br: methodReturnOf reg: st.reg typing: st.typing mid: b
    if ar.none != br.none then return false
    if ar.some when br.some then {
        return (paramTypesMatch :ast :st a: ar b: br)
    }
    return true
}

# collectParamRows -- a function type's parameters in declaration order: their
# interned names and resolved types.
collectParamRows: function {
    st: zenv.ZSymbolTable
    fnTid: ztypes.tid
    names: ListVal zast.nameid
    tids: ListVal ztypes.tid
} is {
    ns: st.typing.declRowSlots ownerTid: fnTid
    k: u64
    for k < ns loop {
        row: st.typing.declRowAt ownerTid: fnTid membersOnly: true slot: k
        k = k + 1
        if row.keep then {
            names.append row.name
            tids.append row.tid
        }
    }
}

# paramTypesMatch -- two types in matching signature positions agree: the same
# type, a generic parameter on either side, or compatible either way round.
paramTypesMatch: function {
    ast: Ast
    st: zenv.ZSymbolTable
    a: ztypes.tid
    b: ztypes.tid
} out bool is {
    if a == b then return true
    if (st.reg.typetypeOf typeId: a) == ztypes.ztypetype.genericParam then return true
    if (st.reg.typetypeOf typeId: b) == ztypes.ztypetype.genericParam then return true
    return (numerics.typesCompatible :ast :st :a :b)
}

# boundMayBeReftype -- whether `tdecl`'s type parameter `paramName` may be
# instantiated with a reftype: every bound boundAdmitsReftype says does admits
# one. A parameter whose declaration cannot be found
# may be anything.
boundMayBeReftype: function {
    ast: Ast
    st: zenv.ZSymbolTable
    tdecl: ztypes.declid
    paramName: zast.nameid
} out bool is {
    k: (st.reg.genericParamConstraintOf :tdecl :paramName).kind
    if k == ztypes.constraintkind.none then return true
    pd: st.typing.declFindChild parentDeclId: tdecl nameId: paramName
    if pd.isZero then return true
    fm: argRefAt :ast nid: (st.typing.decls.get i: pd).node
    if fm.nid.isZero then return true
    return (boundAdmitsReftype :st :ast :tdecl :fm)
}

# crossingProtocolOf -- the protocol a parameter of type `ptid` is typed by --
# or bounded by, when `ptid` is one of `funcId`'s generic parameters -- when
# that protocol implements the marker `thread.Crossing`: a value moved into the
# parameter is handed to another thread. Zero for any other parameter, and for
# every parameter of a program in which nothing implements the marker.
crossingProtocolOf: function {
    st: zenv.ZSymbolTable
    ast: Ast
    funcId: ztypes.tid
    ptid: ztypes.tid
} out ztypes.tid is {
    none: ztypes.tid.zero
    if ptid.isZero then return none
    cr: threadMarkerTid :st nameId: zast.wellKnown.slot.tyCrossing
    if cr.isZero then return none
    # an instance over the function's parameters (`(Task R)`) names its
    # protocol by its origin; a bare parameter (`T`) by its bound
    pro: st.reg.genericOriginOf tid: ptid
    if pro.isZero then pro = ptid
    if (st.reg.typetypeOf typeId: ptid) == ztypes.ztypetype.genericParam when pro == ptid then {
        pro = paramBoundProtocol :st :ast :funcId :ptid
    }
    if pro.isZero then return none
    if (st.reg.typetypeOf typeId: pro) != ztypes.ztypetype.protocolType then return none
    if (typeImplements :st impl: pro spec: cr) then return pro
    return none
}

# paramBoundProtocol -- the template of the bound on `funcId`'s generic
# parameter `ptid` (`Job` for `J: Job.generic`, `Task` for
# `T: (Task R).generic`); zero for an unbounded one
paramBoundProtocol: function {
    st: zenv.ZSymbolTable
    ast: Ast
    funcId: ztypes.tid
    ptid: ztypes.tid
} out ztypes.tid is {
    none: ztypes.tid.zero
    tdecl: st.typing.declIdOfType typeId: funcId
    if tdecl.isZero then return none
    pn: st.reg.genericParamNameOfTid :tdecl :ptid
    if pn.isZero then return none
    cd: st.reg.genericParamConstraintOf :tdecl paramName: pn
    bt: none
    if cd.boundApp.notZero then {
        bt = boundApplicationTid :ast :st :tdecl app: cd.boundApp
    } else {
        bd: boundDeclOf :st :ast :tdecl :cd
        if bd.isZero then return none
        bt = st.typing.declTypeOf declId: bd
    }
    bo: st.reg.genericOriginOf tid: bt
    if bo.notZero then return bo
    return bt
}

# crossingCallName -- the callee a crossing report names: `thread.spawn` for a
# function, `pool.Pool.submit` for a method
crossingCallName: function {st: zenv.ZSymbolTable.view funcId: ztypes.tid} out String is {
    f: funcId
    fo: st.reg.genericOriginOf tid: funcId
    if fo.notZero then f = fo
    d: st.typing.declIdOfType typeId: f
    if d.isZero then return (st.reg.nameOf tid: f)
    pd: st.typing.declParentOf declId: d
    if pd.notZero when pd != (unitRootOfDecl typing: st.typing declId: d) then {
        r: qualifiedTemplateName :st tdecl: pd
        r.append "."
        r.append (st.reg.nameOf tid: f)
        return r
    }
    return (qualifiedTemplateName :st tdecl: d)
}

# refuseCrossingArg -- an argument of type `at` moved into a parameter of the
# Crossing protocol `pro` goes to another thread. It is refused when it holds a
# `thread.ThreadBound` type at any depth; when the instance of `pro` it
# implements names one -- a task's result, which `join` hands back across;
# and when it holds a `thread.SharedReads` type over a `thread.Unshareable`
# one, which several threads would then use at once. The argument is recorded
# (`crossingArgCallee`) so the locks it carries are checked, and refused, in a
# thread's words.
refuseCrossingArg: function {
    st: zenv.ZSymbolTable
    ast: Ast
    arg: argref
    at: ztypes.tid
    pro: ztypes.tid
    funcId: ztypes.tid
} is {
    st.walk.value.crossingArgCallee.set key: arg.nid value: funcId
    if at.isZero then return
    # the thread calls the protocol's members through the argument's
    # implementation, which no member reference spells: they are used here. An
    # instance of a generic type gets its implementation row only at the end
    # of the check, after the bodies the program uses have been walked.
    markSpecMembersUsed :st impl: at spec: pro
    via: crossingCallName :st :funcId
    quoted: "`\{via}`"
    if (refuseThreadBoundArg :st :ast :arg :at :pro quotedCall: quoted.stringView) then return
    if (refuseProtocolValueArg :st :ast :arg :at :pro quotedCall: quoted.stringView) then return
    sr: threadMarkerTid :st nameId: zast.wellKnown.slot.tySharedReads
    un: threadMarkerTid :st nameId: zast.wellKnown.slot.tyUnshareable
    if sr.isZero or un.isZero then return
    seen: IdSet ztypes.tid
    holder: sharedReadsHolder :st :ast tid: at :sr :un :seen
    if holder.notZero then (
        sharedReadsError
        :st
        :ast
        :arg
        :at
        :holder
        :un
        quotedCall: quoted.stringView
    )
}

# refuseThreadBoundArg -- refuseCrossingArg's ThreadBound half: the argument,
# or the result its task answers, holding a `thread.ThreadBound` type. True
# when it refused.
refuseThreadBoundArg: function {
    st: zenv.ZSymbolTable
    ast: Ast
    arg: argref
    at: ztypes.tid
    pro: ztypes.tid
    quotedCall: StringView
} out bool is {
    tb: threadMarkerTid :st nameId: zast.wellKnown.slot.tyThreadBound
    if tb.isZero then return false
    seen: IdSet ztypes.tid
    bound: markedTypeIn :st :ast tid: at mk: tb :seen
    if bound.notZero then {
        threadBoundError :st :ast :arg :at :bound :quotedCall
        return true
    }
    inst: implementedInstanceOf :st impl: at origin: pro
    if inst.isZero when (st.reg.genericOriginOf tid: at) == pro then inst = at
    k: u64
    for k < (st.reg.genericArgCount specId: inst) loop {
        ga: st.reg.genericTypeArgAt specId: inst ordinal: k
        k = k + 1
        rseen: IdSet ztypes.tid
        rb: markedTypeIn :st :ast tid: ga mk: tb seen: rseen
        if rb.notZero then {
            threadBoundResultError :st :ast :arg bound: rb :quotedCall
            return true
        }
    }
    return false
}

# refuseProtocolValueArg -- refuseCrossingArg's protocol half: the argument,
# or the result its task answers, holding a protocol value at any depth. A
# protocol value shows nothing of what it holds, so what may not cross -- a
# lock guard behind it -- cannot be told at the crossing: it never crosses. A
# type parameter bounded by the protocol keeps the type in sight. True when it
# refused.
refuseProtocolValueArg: function {
    st: zenv.ZSymbolTable
    ast: Ast
    arg: argref
    at: ztypes.tid
    pro: ztypes.tid
    quotedCall: StringView
} out bool is {
    seen: IdSet ztypes.tid
    pv: protocolValueIn :st :ast tid: at :seen
    if pv.notZero then {
        protocolValueError :st :ast :arg :at held: pv result: false :quotedCall
        return true
    }
    inst: implementedInstanceOf :st impl: at origin: pro
    if inst.isZero when (st.reg.genericOriginOf tid: at) == pro then inst = at
    k: u64
    for k < (st.reg.genericArgCount specId: inst) loop {
        ga: st.reg.genericTypeArgAt specId: inst ordinal: k
        k = k + 1
        rv: ga
        if (isProtocolValueType :st tid: ga).not then {
            rseen: IdSet ztypes.tid
            rv = protocolValueIn :st :ast tid: ga seen: rseen
        }
        if rv.notZero then {
            protocolValueError :st :ast :arg :at held: rv result: true :quotedCall
            return true
        }
    }
    return false
}

# isProtocolValueType -- whether `tid` is a protocol, or an instance of a
# generic one: the type of a value that hides the type behind it.
isProtocolValueType: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out bool is {
    if tid.isZero then return false
    if (st.reg.typetypeOf typeId: tid) == ztypes.ztypetype.protocolType then return true
    o: st.reg.genericOriginOf :tid
    if o.isZero then return false
    return (st.reg.typetypeOf typeId: o) == ztypes.ztypetype.protocolType
}

# protocolValueIn -- the first protocol type `tid` holds at any depth
# (heldTypes); zero for none. `seen` ends a walk that meets a type again.
protocolValueIn: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tid: ztypes.tid
    seen: IdSet ztypes.tid
} out ztypes.tid is {
    if tid.isZero or (seen.has item: tid) then return ztypes.tid.zero
    seen.add item: tid
    held: ListVal ztypes.tid
    heldTypes :st :ast :tid :held
    for each h: held loop {
        if (isProtocolValueType :st tid: h) then return h
        inner: protocolValueIn :st :ast tid: h :seen
        if inner.notZero then return inner
    }
    return ztypes.tid.zero
}

# protocolValueError -- the refusal of the crossing argument `arg`, of type
# `at`, that holds a value of the protocol `held`, or whose task answers a
# result that does (`result`), at the crossing call `quotedCall` names
protocolValueError: function {
    st: zenv.ZSymbolTable
    ast: Ast
    arg: argref
    at: ztypes.tid
    held: ztypes.tid
    result: bool
    quotedCall: StringView
} is {
    att: at
    ao: st.reg.genericOriginOf tid: at
    if ao.notZero then att = ao
    an: specWrittenName :st :ast tid: att
    ht: held
    ho: st.reg.genericOriginOf tid: held
    if ho.notZero then ht = ho
    hn: specWrittenName :st :ast tid: ht
    msg: "Cannot hand '\{an}' to another thread with \{quotedCall}: it holds a value of the protocol '\{hn}', and a protocol value does not show what it holds, so it never crosses to another thread; give the type a parameter bounded by the protocol instead (`T: \{hn}.generic`)"
    if result then {
        msg = "Cannot start a thread with \{quotedCall} whose result holds a value of the protocol '\{hn}': `join` would hand it to another thread, and a protocol value does not show what it holds, so it never crosses to one"
    }
    addError :st nodeid: arg.nid lineno: arg.lineno colno: arg.colno e: zast.err.ownerError :msg
}

# threadMarkerTid -- the type of the thread unit's marker `nameId`
# (`ThreadBound`, `Crossing`, ...); zero when nothing in the program resolved
# it, and then nothing implements it.
threadMarkerTid: function {st: zenv.ZSymbolTable.view nameId: zast.nameid} out ztypes.tid is {
    root: st.walk.threadUnitRoot
    if root.isZero then return ztypes.tid.zero
    d: st.typing.declFindChild parentDeclId: root :nameId
    if d.isZero then return ztypes.tid.zero
    return (st.typing.declTypeOf declId: d)
}

# refuseUnshareablePins -- the locks a crossing argument added to `pins`, from
# `from` on. A SHARED one on a value holding a `thread.Unshareable` type at any
# depth would leave its owner and the new thread using that value at once, and
# is refused; an exclusive one (`.borrow`) keeps the owner off it until the
# join. An argument that crosses nothing has none to check.
refuseUnshareablePins: function {
    st: zenv.ZSymbolTable
    ast: Ast
    arg: argref
    pins: (List ztyping.PinPath).view
    from: u64
} is {
    fid: (st.walk.value.crossingArgCallee.get key: arg.nid).or d: ztypes.tid.zero
    if fid.isZero or (pins.length <= from) then return
    un: threadMarkerTid :st nameId: zast.wellKnown.slot.tyUnshareable
    if un.isZero then return
    i: from
    for i < pins.length loop {
        pn: pins.get :i
        i = i + 1
        if pn.shared when pn.mutable.not then {
            seen: IdSet ztypes.tid
            hit: markedTypeIn :st :ast tid: (pinnedTypeOf :st pin: pn) mk: un :seen
            if hit.notZero then {
                unshareableViewError :st :ast :arg pin: pn :hit funcId: fid
                return
            }
        }
    }
}

# pinnedTypeOf -- the type of the place a pin locks: its root variable's,
# then each field's along the path; zero where a step names nothing
pinnedTypeOf: function {st: zenv.ZSymbolTable.view pin: ztyping.PinPath.view} out ztypes.tid is {
    if pin.path.length == 0 then return ztypes.tid.zero
    t: (st.lookup nameId: (pin.path.get i: 0)).or d: ztypes.tid.zero
    k: 1.u64
    for k < pin.path.length loop {
        if t.isZero then return t
        step: pin.path.get i: k
        t = (st.typing.declChildOfId parentTypeId: t nameId: step).or d: ztypes.tid.zero
        k = k + 1
    }
    return t
}

# unshareableViewError -- the refusal of a crossing argument that keeps the
# place `pin` viewed, a place holding the `thread.Unshareable` type `hit`
unshareableViewError: function {
    st: zenv.ZSymbolTable
    ast: Ast
    arg: argref
    pin: ztyping.PinPath.view
    hit: ztypes.tid
    funcId: ztypes.tid
} is {
    root: zast.nameTextAt :ast ref: (pin.path.get i: 0)
    hn: specWrittenName :st :ast tid: hit
    via: crossingCallName :st :funcId
    (
        addError
        :st
        nodeid: arg.nid
        lineno: arg.lineno
        colno: arg.colno
        e: zast.err.ownerError
        msg: "Cannot hand a view of '\{root}' to another thread with `\{via}`: it holds '\{hn}', a `thread.Unshareable` type, which one thread at a time may use, and the owner would go on using it beside the thread; move it to the thread (`.take`), give each thread its own, or share it through a `sync.Mutex`"
    )
}

# sharedReadsError -- the refusal of a crossing argument of type `at` that
# holds `holder`, a `thread.SharedReads` type over the `thread.Unshareable`
# type `un`
sharedReadsError: function {
    st: zenv.ZSymbolTable
    ast: Ast
    arg: argref
    at: ztypes.tid
    holder: ztypes.tid
    un: ztypes.tid
    quotedCall: StringView
} is {
    an: specWrittenName :st :ast tid: (originOrSelf :st tid: at)
    hn: specWrittenName :st :ast tid: (originOrSelf :st tid: holder)
    inner: un
    k: u64
    for k < (st.reg.genericArgCount specId: holder) loop {
        ga: st.reg.genericTypeArgAt specId: holder ordinal: k
        k = k + 1
        seen: IdSet ztypes.tid
        hit: markedTypeIn :st :ast tid: ga mk: un :seen
        if hit.notZero then inner = hit
    }
    un2: specWrittenName :st :ast tid: (originOrSelf :st tid: inner)
    (
        addError
        :st
        nodeid: arg.nid
        lineno: arg.lineno
        colno: arg.colno
        e: zast.err.ownerError
        msg: "Cannot hand '\{an}' to another thread with \{quotedCall}: it holds '\{hn}' over '\{un2}', whose readers run on several threads at once, and '\{un2}' is `thread.Unshareable` -- one thread at a time may use it; share it through a `sync.Mutex` instead"
    )
}

# originOrSelf -- the template an instance was minted from, or the type itself
originOrSelf: function {st: zenv.ZSymbolTable.view tid: ztypes.tid} out ztypes.tid is {
    o: st.reg.genericOriginOf :tid
    if o.isZero then return tid
    return o
}

# refuseCrossingParamArg -- the argument `arg`, of type `vt`, bound to the
# parameter `pnId` of `funcId`, checked as a crossing when the parameter's type
# makes it one (crossingProtocolOf)
refuseCrossingParamArg: function {
    st: zenv.ZSymbolTable
    ast: Ast
    funcId: ztypes.tid
    pnId: zast.nameid
    arg: argref
    vt: ztypes.tid
    # a field construction, which stores its argument; a declared `create` is
    # a call like any other
    fieldCtor: false
} is {
    if fieldCtor or pnId.isZero or st.walk.threadUnitRoot.isZero then return
    po: st.typing.declChildOfId parentTypeId: funcId nameId: pnId
    if po.some then {
        pro: crossingProtocolOf :st :ast :funcId ptid: po
        if pro.notZero then refuseCrossingArg :st :ast :arg at: vt :pro :funcId
    }
}

# threadBoundResultError -- the refusal of a crossing argument `arg` whose task
# answers a result holding the ThreadBound type `bound`, which `join` would
# hand back across threads
threadBoundResultError: function {
    st: zenv.ZSymbolTable
    ast: Ast
    arg: argref
    bound: ztypes.tid
    quotedCall: StringView
} is {
    bt: bound
    bo: st.reg.genericOriginOf tid: bound
    if bo.notZero then bt = bo
    bn: specWrittenName :st :ast tid: bt
    (
        addError
        :st
        nodeid: arg.nid
        lineno: arg.lineno
        colno: arg.colno
        e: zast.err.ownerError
        msg: "Cannot start a thread with \{quotedCall} whose result holds '\{bn}': `join` would hand it to another thread, and a `thread.ThreadBound` value never leaves the thread that made it"
    )
}

# threadBoundError -- the refusal of argument `arg`, of type `at`, holding the
# ThreadBound type `bound`, at the crossing call `quotedCall` names
threadBoundError: function {
    st: zenv.ZSymbolTable
    ast: Ast
    arg: argref
    at: ztypes.tid
    bound: ztypes.tid
    quotedCall: StringView
} is {
    # an instance is named by its template: the guard, not its arguments
    att: at
    ao: st.reg.genericOriginOf tid: at
    if ao.notZero then att = ao
    an: specWrittenName :st :ast tid: att
    bt: bound
    bo: st.reg.genericOriginOf tid: bound
    if bo.notZero then bt = bo
    bn: specWrittenName :st :ast tid: bt
    held: "it holds '\{bn}'"
    if bound == at then held = "it is one".string
    (
        addError
        :st
        nodeid: arg.nid
        lineno: arg.lineno
        colno: arg.colno
        e: zast.err.ownerError
        msg: "Cannot hand '\{an}' to another thread with \{quotedCall}: \{held}, and a `thread.ThreadBound` value never leaves the thread that made it; make it on the new thread instead"
    )
}

# heldTypes -- the types `tid` holds one level down: each type argument of an
# instance, and each field or arm payload by any marker. An implementation label
# (`task: (thread.Task R)`) names a protocol the type implements and stores
# nothing, so it is not one.
heldTypes: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tid: ztypes.tid
    held: ListVal ztypes.tid
} is {
    k: u64
    for k < (st.reg.genericArgCount specId: tid) loop {
        held.append (st.reg.genericTypeArgAt specId: tid ordinal: k)
        k = k + 1
    }
    forceAllFields :st :ast :tid
    labels: ListVal zast.nameid
    implementationMarkerIds reg: st.reg typing: st.typing :tid ids: labels
    ri: u64
    for ri < (st.typing.declRowSlots ownerTid: tid) loop {
        rw: st.typing.declRowAt ownerTid: tid membersOnly: true slot: ri
        ri = ri + 1
        if rw.keep when (
            (st.reg.typetypeOf typeId: rw.tid) != ztypes.ztypetype.functionType
        ) when (labels.contains rw.name).not then held.append rw.tid
    }
}

# markedTypeIn -- the first type, `tid` itself or one it holds at any depth
# (heldTypes), that implements the marker `mk`; zero for none. `seen` ends a
# walk that meets a type again.
markedTypeIn: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tid: ztypes.tid
    mk: ztypes.tid
    seen: IdSet ztypes.tid
} out ztypes.tid is {
    if tid.isZero or (seen.has item: tid) then return ztypes.tid.zero
    seen.add item: tid
    if (typeImplements :st impl: tid spec: mk) then return tid
    held: ListVal ztypes.tid
    heldTypes :st :ast :tid :held
    for each h: held loop {
        inner: markedTypeIn :st :ast tid: h :mk :seen
        if inner.notZero then return inner
    }
    return ztypes.tid.zero
}

# sharedReadsHolder -- the first type, `tid` itself or one it holds at any
# depth, that implements `sr` -- several threads read its value at once --
# over a type argument holding the marker `un` at any depth; zero for none
sharedReadsHolder: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tid: ztypes.tid
    sr: ztypes.tid
    un: ztypes.tid
    seen: IdSet ztypes.tid
} out ztypes.tid is {
    if tid.isZero or (seen.has item: tid) then return ztypes.tid.zero
    seen.add item: tid
    if (typeImplements :st impl: tid spec: sr) then {
        k: u64
        for k < (st.reg.genericArgCount specId: tid) loop {
            ga: st.reg.genericTypeArgAt specId: tid ordinal: k
            k = k + 1
            useen: IdSet ztypes.tid
            if (markedTypeIn :st :ast tid: ga mk: un seen: useen).notZero then return tid
        }
    }
    held: ListVal ztypes.tid
    heldTypes :st :ast :tid :held
    for each h: held loop {
        inner: sharedReadsHolder :st :ast tid: h :sr :un :seen
        if inner.notZero then return inner
    }
    return ztypes.tid.zero
}

# anyPartialType -- some type of `tids` is partial: declared over a generic
# parameter
anyPartialType: function {st: zenv.ZSymbolTable.view tids: (ListVal ztypes.tid).view} out bool is {
    for each t: tids loop if (st.reg.isPartialOf tid: t) then return true
    return false
}

# argBindingTid -- the type a value argument of type `avt` binds the generic
# parameter `holder` to. A literal binds its default (i64, f64, StringView),
# except that a NATIVE callee's parameter whose bound lists the literal's own
# type binds the literal itself: the native is then computed by the compiler on
# the literal, which is how `4 + 5` is exact. An integer literal under a bound
# that lists floatliteral but not intliteral binds floatliteral, the
# conversion any float parameter applies (`0.5 + 1`). A singleton binds its
# bound, whose members it has (`4 + cap` is a u32).
argBindingTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    funcId: ztypes.tid
    holder: zast.nameid
    avt: ztypes.tid
} out ztypes.tid is {
    if (st.typing.singletons.has key: avt) then return (st.typing.typedefBaseTidOf tid: avt)
    mat: valuechecks.materialiseLiteral :ast :st t: avt
    if (mat == avt) or holder.isZero then return mat
    if (st.reg.isNativeOf tid: funcId).not then return mat
    tdecl: templateDeclOf reg: st.reg typing: st.typing tid: funcId
    if (boundListsType :ast :st :tdecl paramName: holder tid: avt) then return avt
    lf: st.reg.literalFloatTid
    if avt == st.reg.literalIntTid when (boundListsType :ast :st :tdecl paramName: holder tid: lf
    ) then {
        return lf
    }
    return mat
}

# boundListsType -- the bound of `paramName` on `tdecl` names `tid` itself: an
# arm of a sum bound is it, or a bound the checker admits by kind admits it as
# a literal (staticmember, staticindex). A parameter with no bound, or a family
# bound such as `anyval`, admits a literal without listing it.
boundListsType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    tdecl: ztypes.declid
    paramName: zast.nameid
    tid: ztypes.tid
} out bool is {
    cd: st.reg.genericParamConstraintOf :tdecl :paramName
    if cd.kind == ztypes.constraintkind.other then {
        sb: sumBoundByDecl :ast :st :tdecl :cd argTid: tid
        if sb.some then return sb
        return false
    }
    return (literalSatisfies :st ck: cd.kind argTid: tid)
}

# substituteGenericReturn -- the mono's return type, from the template's return
# NODE with the call's substitutions applied. getOrMintSpec resolved the mono
# structurally through the trie and reports whether it minted, so a reused spec
# keeps the return it already has.
substituteGenericReturn: function {
    st: zenv.ZSymbolTable
    funcId: ztypes.tid
    mid: ztypes.tid
    subs: (IdMapV zast.nameid v: ztypes.tid).view
} is {
    rno: st.typing.funcReturnNode.get key: funcId
    if rno.some then {
        rk2: zast.nameid
        rko: st.walk.pendingTyperef.get key: rno
        if rko.some then {
            rk2 = rko
        }
        if rk2.notZero then {
            subTid: subs.get key: rk2
            match (
                subTid
            ) case some then {
                st.reg.setReturnType typeId: mid value: subTid
            } case none then {
                # a return naming none of the call's own parameters is the
                # function's declared return, as concrete as the function is
                ownR: (
                    (methodReturnOf reg: st.reg typing: st.typing mid: funcId).or
                    d: ztypes.tid.zero
                )
                if ownR.notZero then st.reg.setReturnType typeId: mid value: ownR
            }
        }
    }
}

# genericCallHolders -- the template's value parameters whose declared types name a
# generic parameter. Inferring the call's type arguments reads them by name, so
# their names and the parameters they hold are collected once, up front.
genericCallHolders: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    funcId: ztypes.tid
    pNames: ListVal zast.nameid
    pHolderIds: ListVal ztypes.tid
    pHolders: ListVal zast.nameid
} out ListVal zast.nameid is {
    gparams: st.reg.genericParamNamesOf tdecl: (st.typing.declIdOfType typeId: funcId)
    {
        {
            gci: u64
            gcn: st.typing.declRowSlots ownerTid: funcId
            for gci < gcn loop {
                row: st.typing.declRowAt ownerTid: funcId membersOnly: true slot: gci
                gci = gci + 1
                if row.keep then {
                    gcNid: row.name
                    cto: row.tid
                    {
                        # the receiver is implicit at method call sites: keep it
                        # out of the positional holder list so a label-free arg
                        # maps to the first USER param (T holders included). The
                        # receiver is the shorthand `this` or the type's recorded
                        # long-form receiver name.
                        isRecv: gcNid == zast.wellKnown.slot.wkThis
                        if isRecv.not then {
                            isRecv = st.reg.thisParamNameIs tid: funcId nameId: gcNid
                        }
                        if isRecv.not then {
                            pNames.append gcNid
                            ctorTid: cto
                            pHolderIds.append ctorTid
                        }
                    }
                }
            }
        }
    }
    # an instance holds no parameter, whatever its label spells
    for each hid: pHolderIds loop {
        if (st.reg.genericOriginOf tid: hid).notZero then {
            pHolders.append zast.nameid
            continue
        }
        hn: st.reg.nameOf tid: hid
        pHolders.append (nameIdOf :ast name: hn.stringView)
    }
    return gparams
}

# inferThroughImplementation -- a parameter the arguments did not bind, named as a
# type argument of another parameter's bound (`J: (Job R).generic`): the
# argument bound to that other parameter implements an instance of the bound's
# protocol (`Name` declares `job: (Job String)`), and that instance's argument
# in the same position binds it (R is String). Repeated while it binds more. An
# argument implementing to no instance of the protocol is refused as any unmet
# bound is, which is the reason R cannot be inferred.
inferThroughImplementation: function {
    st: zenv.ZSymbolTable
    ast: Ast
    call: callref
    tdecl: ztypes.declid
    gparams: (ListVal zast.nameid).view
    subs: (IdMapV zast.nameid v: ztypes.tid)
} is {
    more: true
    for more loop {
        more = false
        for each pn: gparams loop {
            av: (subs.get key: pn).or d: ztypes.tid.zero
            cd: st.reg.genericParamConstraintOf :tdecl paramName: pn
            if av.notZero when cd.boundApp.notZero then {
                bt: boundApplicationTid :ast :st :tdecl app: cd.boundApp
                if (bindFromImplementation :st :ast :tdecl bound: bt arg: av :subs) then more = true
            }
        }
    }
    refuseNonImplementingArgs :st :ast :call :tdecl :gparams :subs
}

# refuseNonImplementingArgs -- an argument bound to a parameter whose bound is an
# instance of a generic protocol over other parameters (`J: (Job R).generic`)
# that implements no instance of the protocol: the bound is unmet, which is why
# what it names cannot be inferred. A generic parameter is admitted, as
# constraintAdmits admits it: each instance is checked with its own argument.
refuseNonImplementingArgs: function {
    st: zenv.ZSymbolTable
    ast: Ast
    call: callref
    tdecl: ztypes.declid
    gparams: (ListVal zast.nameid).view
    subs: (IdMapV zast.nameid v: ztypes.tid).view
} is {
    for each pn: gparams loop {
        av: (subs.get key: pn).or d: ztypes.tid.zero
        cd: st.reg.genericParamConstraintOf :tdecl paramName: pn
        if av.notZero when cd.boundApp.notZero when (
            (st.reg.typetypeOf typeId: av) != ztypes.ztypetype.genericParam
        ) then {
            bt: boundApplicationTid :ast :st :tdecl app: cd.boundApp
            bo: st.reg.genericOriginOf tid: bt
            if (st.reg.isPartialOf tid: bt) when (implementedInstanceOf :st impl: av origin: bo
            ).isZero then {
                an: specWrittenName :st :ast tid: av
                sn: specWrittenName :st :ast tid: bo
                pt: zast.nameTextAt :ast ref: pn
                tdn: qualifiedTemplateName :st :tdecl
                m: "generic argument '\{an}' does not satisfy constraint '\{sn}' on parameter '\{pt}' of '\{tdn}': it implements no instance of it"
                (
                    declare.reportConstraintUnmet
                    :st
                    at: call.nid
                    lineno: call.lineno
                    colno: call.colno
                    msg: m
                )
            }
        }
    }
}

# bindFromImplementation -- each type argument of the partial `bound` that is one
# of `tdecl`'s unbound parameters, bound to the same argument of the instance of
# `bound`'s protocol that `arg` implements. True when it bound any.
bindFromImplementation: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tdecl: ztypes.declid
    bound: ztypes.tid
    arg: ztypes.tid
    subs: (IdMapV zast.nameid v: ztypes.tid)
} out bool is {
    if bound.isZero or (st.reg.isPartialOf tid: bound).not then return false
    origin: st.reg.genericOriginOf tid: bound
    if origin.isZero then return false
    inst: implementedInstanceOf :st impl: arg :origin
    if (st.reg.typetypeOf typeId: arg) == ztypes.ztypetype.genericParam then {
        inst = boundInstanceInScope :st :ast ptid: arg :origin
    }
    if inst.isZero then return false
    boundAny: false
    k: u64
    for k < (st.reg.genericArgCount specId: bound) loop {
        ba: st.reg.genericTypeArgAt specId: bound ordinal: k
        ia: st.reg.genericTypeArgAt specId: inst ordinal: k
        k = k + 1
        pn: st.reg.genericParamNameOfTid :tdecl ptid: ba
        if pn.notZero when ia.notZero when (subs.has key: pn).not then {
            subs.set key: pn value: ia
            boundAny = true
        }
    }
    return boundAny
}

# boundInstanceInScope -- the instance of the generic protocol `origin` that the
# generic parameter `ptid` implements by its bound (`(Maker R)` for
# `T: (Maker R).generic`), read on the declaration at or enclosing the current
# scope that owns it; zero when its bound is no instance of `origin`.
boundInstanceInScope: function {
    st: zenv.ZSymbolTable ast: Ast ptid: ztypes.tid origin: ztypes.tid
} out ztypes.tid is {
    cur: st.curScope
    for cur.notZero loop {
        pn: st.reg.genericParamNameOfTid tdecl: cur :ptid
        if pn.notZero then {
            cd: st.reg.genericParamConstraintOf tdecl: cur paramName: pn
            if cd.boundApp.isZero then return ztypes.tid.zero
            bt: boundApplicationTid :ast :st tdecl: cur app: cd.boundApp
            if (st.reg.genericOriginOf tid: bt) == origin then return bt
            return ztypes.tid.zero
        }
        cur = st.typing.declParentOf declId: cur
    }
    return ztypes.tid.zero
}

# implementedInstanceOf -- the instance of the generic protocol `origin` that
# `impl` (or the template it was instantiated from) declares it implements;
# zero for none.
implementedInstanceOf: function {
    st: zenv.ZSymbolTable.view impl: ztypes.tid origin: ztypes.tid
} out ztypes.tid is {
    og: st.reg.genericOriginOf tid: impl
    cfId: ztypes.confid
    for cfId.next < st.typing.nextConf loop {
        cfId = cfId.next
        crow: st.typing.implementation.get i: cfId
        spec: ztypes.tid.zero
        if crow.implTypeId == impl then spec = crow.specTypeId
        if spec.isZero when og.notZero when crow.implTypeId == og then {
            spec = instanceSpecOf :st mono: impl spec: crow.specTypeId labelNameId: crow.labelNameId
        }
        if spec.notZero when (st.reg.genericOriginOf tid: spec) == origin then return spec
    }
    return ztypes.tid.zero
}

# checkGenericCall -- a call to a generic user function: walk the value args,
# infer the type-param bindings (explicit `param: Type` args, else each value
# arg's materialised type through the parameter it feeds), mint the instance
# (children substituted; return substituted from the recorded `out` placeholder
# name), synthesize the clone scope on first instantiation (empty, named by the
# instance, unreachable per the template body's syntactic divergence -- bodied
# templates only, so native generics like print add no scope), stamp the
# callable with the instance, and resolve to the instance's return. Nested
# control flow inside generic bodies needs a real clone walk and is deferred.
checkGenericCall: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    call: callref
    funcId: ztypes.tid
    # the locks the call's result may keep, which the argument walk adds to
    pins: List ztyping.PinPath
} out ztypes.tid is {
    pNames: ListVal zast.nameid
    pHolderIds: ListVal ztypes.tid
    pHolders: ListVal zast.nameid
    # a method's receiver arrives through the dot (a call through its type
    # is the call on its receiver, callchecks.rewriteTypedCall)
    recvImplicit: moves.methodHasThisReceiver :st mid: funcId
    gparams: genericCallHolders :st :ast :funcId :pNames :pHolderIds :pHolders
    subs: IdMapV zast.nameid v: ztypes.tid
    errI: st.typing.reportCount
    argTypes: ListVal ztypes.tid
    # a parameter declared over the generic parameters checks its argument
    # once the instance exists (checkPartialParamArgs), and needs its type
    wantTypes: anyPartialType :st tids: pHolderIds
    (
        callchecks.inferGenericCallSubs
        :st
        :unitDecl
        :ast
        :call
        :pins
        :gparams
        :pNames
        :subs
        :funcId
        :pHolders
        :pHolderIds
        :argTypes
        :wantTypes
        :recvImplicit
    )
    mname: st.reg.nameOf tid: funcId
    if mname.length == 0 then return ztypes.tid.zero
    allOk: true
    templateDecl: templateDeclOf reg: st.reg typing: st.typing tid: funcId
    inferThroughImplementation :st :ast :call tdecl: templateDecl :gparams :subs
    vsI: IdMapV zast.nameid v: u64
    # a parameter no argument names takes its default; a numeric one only when
    # the call does not write it
    dvs: IdMapV zast.nameid v: u64
    if (instantiate.fillGenericDefaults :st :ast tdecl: templateDecl :subs valSubs: dvs).not then {
        return ztypes.tid.zero
    }
    allOk = (
        typeargs.bindCallParams
        :st
        :unitDecl
        :ast
        :call
        tdecl: templateDecl
        :gparams
        :subs
        :dvs
        :vsI
        fname: mname.stringView
        :pHolderIds
        :errI
    )
    if allOk.not then return ztypes.tid.zero
    if gparams.length == 0 then return ztypes.tid.zero
    (
        checkPartialBounds
        :st
        :ast
        :unitDecl
        tdecl: templateDecl
        pnames: gparams
        :subs
        at: call.nid
        lineno: call.lineno
        colno: call.colno
    )
    mintedBefore: st.reg.nextTid
    mid: (
        instantiate.getOrMintSpec
        :st
        scope: st.curScope
        :ast
        :unitDecl
        templateId: funcId
        :subs
        valSubs: vsI
        fallbackArg: ztypes.tid.zero
    )
    instantiate.noteMonoSite :st mono: mid :call :unitDecl
    if st.typing.reportCount > errI then {
        if mid >= mintedBefore then st.walk.refusedInstances.set key: mid value: true
    } else if (st.walk.refusedInstances.has key: mid) then {
        st.walk.refusedInstances.set key: mid value: false
    }
    if wantTypes then (
        callchecks.checkPartialParamArgs
        :st
        :ast
        :call
        :funcId
        :mid
        :gparams
        :pNames
        :pHolderIds
        :argTypes
    )
    substituteGenericReturn :st :funcId :mid :subs
    instantiate.healGenericReturn :st :unitDecl :ast :funcId :mid :gparams :subs
    for each ge: subs.iterateItems loop {
        gk: ztyping.callslot call: call.nid param: ge.key
        st.typing.callGenericBinding.set key: gk value: ge.value
    }
    calleeNodeId: stampNodeId n: (ast.nodes.getView i: call.callable)
    calleeTid: mid
    stampGate :st nid: calleeNodeId tid: calleeTid
    rt: methodReturnOf reg: st.reg typing: st.typing :mid
    if rt.some then return rt
    # a function with no `out` returns no value; one whose `out` the walk has
    # not settled yet answers 0
    if (st.typing.funcReturnNode.has key: funcId) then return ztypes.tid
    return st.typing.nullTypeId
}

# reportConstantConstraintArg -- a value that is not a string, given for a
# generic parameter, of type `argTid` as a body sees it (statics.constArgTid):
# it binds the parameter as a body's argument does (argBindingTid), and gets
# the body's constraint report where that type does not meet the bound. One
# that meets it is no refusal: the call has no compile-time value, which the
# evaluator says.
reportConstantConstraintArg: function {
    st: zenv.ZSymbolTable
    ast: Ast
    fid: ztypes.tid
    pt: ztypes.tid
    argTid: ztypes.tid
    arg: argref
} is {
    if argTid.isZero then return
    ftd: st.typing.declIdOfType typeId: fid
    gpn: st.reg.genericParamNameOfTid tdecl: ftd ptid: pt
    bt: argBindingTid :st :ast funcId: fid holder: gpn avt: argTid
    if (constraintAdmits :ast :st tdecl: ftd paramName: gpn argTid: bt) then return
    (
        addErrorWithHint
        :st
        nodeid: arg.nid
        lineno: arg.lineno
        colno: arg.colno
        e: zast.err.genericError
        msg: (constraintUnmetText :ast :st tdecl: ftd paramName: gpn argTid: bt)
        note: "".string
        hint: "".string
        width: 1
    )
}

# unitNameOfTid -- the defining unit's name for type `tid`, read off the
# Decl parent chain; "" when the type has no declaration. The display /
# dump projection over unitDeclOfTid -- identity gates should compare
# unitDeclOfTid ids instead.
unitNameOfTid: function {
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
} out String is {
    return (resolve.unitNameViewOfTid reg: st.reg typing: st.typing :tid).string
}
