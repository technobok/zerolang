# resolve -- finding a definition on demand: units, scopes, aliases, shells.
# An implementation subunit of ztypecheck.

# unitdefNodeId -- the nodeid of the unit row an id names (0 when the id does
# not name a unit).
unitdefNodeId: function {ast: Ast.view nId: zast.nodeid} out zast.nodeid is {
    result: zast.nodeid
    n: ast.nodes.get i: nId
    if n.unitdef then result = n.nodeid
    return result
}

# indexOneUnitDef -- declare the file unit `ruId` (its namedoperation) under
# the program root and index its body.
indexOneUnitDef: function {st: zenv.ZSymbolTable program: Ast ruId: zast.nodeid} is {
    opId: zast.nodeid
    unmRef: zast.nameid
    {
        ru: program.nodes.get i: ruId
        if ru.namedoperation then {
            opId = ru.operation
            unmRef = ru.name
        }
    }
    if opId.isZero then return
    # registerUnitRoots minted the unit's TYPE and keyed it on the unitdef
    # node; the declaration binds to it here. Read by node, not by name: the
    # name lookup would find this very Decl, whose type is what we are about to
    # set. A unit with no type there is a repeated unit name registerUnitRoots
    # already rejected -- it gets no declaration, so the program root keeps one
    # child per name.
    utl: st.typing.unitTypesById.get key: (unitdefNodeId ast: program nId: opId)
    if utl.some then {
        # a file unit is a NAMED child of the program root, which is what makes
        # declFindChild(programRoot, name) the unit-root lookup. The root
        # carries no unit-scope bit, so no bare-name walk reaches these
        # children -- unitScopeOf climbs through it.
        udid: (
            st.typing.declNew
            name: unmRef
            parent: st.typing.programRoot
            kind: ztyping.declkind.unitDecl
            node: ruId
        )
        st.typing.declSetUnitScope declId: udid
        st.typing.declSetType declId: udid typeId: utl
        declare.indexUnitBody :st ast: program unitopId: opId unitDeclId: udid
    }
}

# linkDeclTypeId -- linkDeclType by the definition's name id.
linkDeclTypeId: function {
    # the symbol table whose Decl is linked
    st: zenv.ZSymbolTable
    # the unit the definition belongs to
    unitDecl: ztypes.declid
    # the scope the definition is found from
    scope: ztypes.declid
    # the definition's name id
    nameId: zast.nameid
    # the canonical type id to record on it
    tid: ztypes.tid
} is {
    dko: declOfUnitDef :st :scope :unitDecl :nameId
    if dko.u64 == 0 then return
    st.typing.declSetType declId: dko typeId: tid
}

# defTypetypeOf -- the typetype a top-level definition node declares, mirroring
# resolveDef's dispatch. None for nodes that mint no canonical type here (dotted-
# path aliases, enums/generics in later slices).
defTypetypeOf: function {
    defn: astnode.view
    nameId: zast.nameid
    # whether the definition is the system unit's own: only there do `null` and
    # `never` name the empty types
    inSystem: bool
} out optionval ztypes.ztypetype is {
    match (
        defn
    ) case functiondef then {
        return (optionval.some ztypes.ztypetype.functionType)
    } case objectdef then {
        match (
            defn.kind
        ) case recordDef then {
            # the system unit's `null` and `never` parse as empty records but
            # ARE their own typetypes, which resolveObjectDef gives them too.
            # Reporting none here left them "unclassified" alongside dotted
            # aliases, and an unclassified def resolves to tid 0 -- which is
            # why core's `null:`/`never:` re-exports never resolved. A record
            # any other unit names `null` is an ordinary record.
            if inSystem when nameId == zast.wellKnown.slot.tyNull then {
                return (optionval.some ztypes.ztypetype.nullType)
            }
            if inSystem when nameId == zast.wellKnown.slot.tyNever then {
                return (optionval.some ztypes.ztypetype.neverType)
            }
            return (optionval.some ztypes.ztypetype.recordType)
        } case dataDef then {
            # a data type is a record whose values are static (isStatic)
            return (optionval.some ztypes.ztypetype.recordType)
        } case variantDef then {
            return (optionval.some ztypes.ztypetype.variantType)
        } case choiceDef then {
            # a choice is a variant whose values are static (isStatic)
            return (optionval.some ztypes.ztypetype.variantType)
        } case unionDef then {
            return (optionval.some ztypes.ztypetype.unionType)
        } case classDef then {
            return (optionval.some ztypes.ztypetype.classType)
        } case generatorDef then {
            # a generator IS a class: `is` fields, a `call` method, one struct.
            # The kind survives only on the AST node, where the checks that are
            # particular to it read it.
            return (optionval.some ztypes.ztypetype.classType)
        } case facetDef then {
            return (optionval.some ztypes.ztypetype.facetType)
        } case protocolDef then {
            return (optionval.some ztypes.ztypetype.protocolType)
        } else {
            return (optionval.none ztypes.ztypetype)
        }
    } else {
        return (optionval.none ztypes.ztypetype)
    }
}

# noDefSite -- the absent site.
noDefSite: function {} out defsite is {
    return (defsite defUnit: ztypes.declid.zero aliasDecl: ztypes.declid.zero)
}

# definingSiteForId -- definingSiteFor by the name's id.
definingSiteForId: function {
    # the symbol table whose environment is searched
    st: zenv.ZSymbolTable.view
    # the tree the re-export edges are read from
    ast: Ast.view
    # the unit the lookup is made from
    unitDecl: ztypes.declid
    # the scope the lookup climbs from
    scope: ztypes.declid
    # the looked-up name, interned
    nameId: zast.nameid
} out defsite is {
    hit: envLookup :st scope: (typeargs.scopeFor typing: st.typing :scope :unitDecl) :nameId
    if hit.declId.isZero then return noDefSite
    # a definition of this unit, or of a namespace written inside it: both
    # resolve in this unit, the namespace member in its namespace's scope
    inNs: (
        (declIsNamespace :st :ast declId: hit.scope) and
        ((unitRootOfDecl typing: st.typing declId: hit.scope) == unitDecl)
    )
    if (hit.scope == unitDecl) or inNs then {
        return (defsite defUnit: unitDecl aliasDecl: ztypes.declid.zero)
    }
    ru: reexportUnitOf :st :ast declId: hit.declId
    if ru.isZero then return noDefSite
    return (defsite defUnit: (unitDeclOfName typing: st.typing nameId: ru) aliasDecl: hit.declId)
}

# declareCanonicalTypeId -- declareCanonicalType by the type's name id: every
# lookup is by id, and the spelling is read only at the mint.
declareCanonicalTypeId: function {
    # the tree the name was read from
    ast: Ast
    # the symbol table the type is declared in
    st: zenv.ZSymbolTable
    # the unit the declaration belongs to
    unitDecl: ztypes.declid
    # the scope the declaration is made in
    scope: ztypes.declid
    # the owning type's name id for a nested type, zero for a unit member
    ownerNameId: zast.nameid
    # the declared type's own name id, which every lookup here keys on
    nameId: zast.nameid
    # what kind of type is declared
    typetype: ztypes.ztypetype
} out ztypes.tid is {
    qowner: ztypes.tid
    # Inside a namespace unit, the enclosing type is a child of THAT unit, not
    # of the file unit -- the unit-name index only ever holds file units.
    nsF: nsScopeOf :st :scope :unitDecl
    nsT: st.typing.declTypeOf declId: nsF
    if ownerNameId.notZero when nsT.notZero then {
        nso: st.typing.declChildOfId parentTypeId: nsT nameId: ownerNameId
        if nso.some then {
            qowner = nso
        }
    }
    if ownerNameId.notZero when qowner.isZero then {
        cudq: st.typing.declTypeOf declId: unitDecl
        if cudq.notZero then {
            forceMemberOf :st :ast parentTypeId: cudq nameId: ownerNameId
            bo: st.typing.declChildOfId parentTypeId: cudq nameId: ownerNameId
            if bo.some then {
                qowner = bo
            }
        }
    }
    # a free definition that is a member of the namespace is declared under
    # the namespace, not the file unit
    if ownerNameId.isZero when nsT.notZero then {
        nsm: st.typing.declFindChild parentDeclId: nsF :nameId
        if nsm.notZero then qowner = nsT
    }
    if qowner.notZero then {
        exq: st.typing.declChildOfId parentTypeId: qowner :nameId
        if exq.some then {
            return exq
        }
    }
    if ownerNameId.isZero when qowner.isZero then {
        cudm: st.typing.declTypeOf declId: unitDecl
        if cudm.notZero then {
            exm: st.typing.declChildOfId parentTypeId: cudm :nameId
            if exm.some then {
                linkDeclTypeId :st :scope :unitDecl :nameId tid: exm
                return exm
            }
        }
    }
    # the mint spells the name, read through a borrow
    id: ztypes.tid
    nT: zast.nameTextAt :ast ref: nameId
    id = st.reg.newType name: nT.stringView ownerTid: qowner :typetype
    # valtype-ness is a property of the definition's KIND -- a record or a
    # variant is a valtype, a class or a union is not -- and is known here,
    # at declaration; a reference that reaches the declared id before its
    # definition resolves (a generic argument checked against `anyval`
    # while the target of a re-export is mid-resolution) must not read an
    # unset flag as "not a valtype". The definition's own resolution sets
    # the same value again.
    if typetype == ztypes.ztypetype.recordType then st.reg.setValtype typeId: id value: true
    if typetype == ztypes.ztypetype.variantType then st.reg.setValtype typeId: id value: true
    if qowner.notZero then {
        st.typing.setMemberType parentTypeId: qowner :nameId childTypeId: id
    } else {
        if ownerNameId.isZero then {
            canonUnitDecl: st.typing.declTypeOf declId: unitDecl
            if canonUnitDecl.notZero then {
                # declare the unit child before typing it. A synthesized name
                # (a mangled `Tmpl_fn`, a `tag__u8`) has no source def for
                # linkDeclType to find, so without this nothing declares it and
                # declChildOf cannot answer. declSynthMemberTyped no-ops when
                # the name is already declared -- for the type as well as the
                # declaration, which is the half a bare setMemberType undid.
                unid: nameId
                ukk: ztyping.declkind.typeDecl
                if typetype == ztypes.ztypetype.functionType then ukk = ztyping.declkind.funcDecl
                st.typing.declSynthMember parentTypeId: canonUnitDecl nameId: unid kind: ukk
                # NOT the atomic pair: this one RE-TYPES an already-declared
                # unit child on purpose. A canonical unit member is declared
                # once and its type settled as resolution progresses, so
                # yielding here leaves every later definition at `notype`.
                st.typing.setMemberType parentTypeId: canonUnitDecl nameId: unid childTypeId: id
            }
        }
    }
    if ownerNameId.isZero then linkDeclTypeId :st :scope :unitDecl :nameId tid: id
    return id
}

# dottedDefTargetIds -- the (unit, member) pair a dotted alias value names: the
# parent atom's name id and the child's; an absent pair when the definition is
# not a dotted alias.
dottedDefTargetIds: function {ast: Ast.view n: astnode.view} out ztypes.deftarget is {
    match (
        n
    ) case dottedpath then {
        pid: atomNameId :ast n: (ast.nodes.get i: n.parent)
        cid: atomNameId :ast n: (ast.nodes.get i: n.child)
        if pid.isZero then return ztypes.noDefTarget
        if cid.isZero then return ztypes.noDefTarget
        return (ztypes.deftarget unitName: pid defName: cid)
    } else {
        return ztypes.noDefTarget
    }
}

# resolveNamedType -- resolve a bare type NAME to its canonical id via the
# declare-before-bind index (definingSiteForId -> declareCanonicalTypeId), minting a
# RECORD shell only for a numeric-literal default or an unresolved/forward name.
# `thisName` scopes the enclosing type's generic params. resolveAtomType aliases
# the self-type keywords `this`/`type` to the enclosing type name and calls here,
# so a native method's `:this` / `rhs: type` lands on the one canonical id, not a
# fresh shell.
resolveNamedType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    name: StringView
    thisName: StringView
    nid: zast.nodeid.zero
} out ztypes.tid is {
    # a name that reaches here as text is interned first, so the id form
    # can mint it by the same spelling
    nameId: zast.poolFind pool: ast.names text: name
    if nameId.isZero then nameId = ast.internString text: name
    return (resolveNamedTypeId :st :scope :ast :unitDecl :nameId :thisName :nid)
}

# literalNameTypeId -- a name that IS a numeric literal types as the literal's
# DEFAULT scalar (system i64/f64). It is not a name reference, so a unit-local
# scalar shadow must not capture it; pre-index (defNodeIndexBuilt false) keeps
# the named-shell fallback. 0 when the name is no literal.
literalNameTypeId: function {
    st: zenv.ZSymbolTable
    ast: Ast
    scope: ztypes.declid
    nameId: zast.nameid
} out ztypes.tid is {
    # the spelling is read through a block-scoped borrow: the mint below lends
    # the pool
    isnum: false
    hasDot: false
    {
        nT: zast.nameTextAt :ast ref: nameId
        b0: nT.stringView.byteAt 0.u64
        if b0.some when (ascii.isDigit b: b0) then isnum = true
        if (ztypes.isFloatLexeme numstr: nT.stringView) then hasDot = true
    }
    if isnum.not then return ztypes.tid.zero
    dn7: "i64"
    if hasDot then dn7 = "f64"
    scalarTid: descendNamed :st :scope :ast unitDecl: st.typing.systemUnitRoot name: dn7
    if scalarTid.notZero then return scalarTid
    return (st.reg.newType name: dn7 typetype: ztypes.ztypetype.recordType)
}

# aliasOrShellTypeId -- the defining unit knows the name but its definition
# carries no typetype: an existing registration answers first, then the alias
# followed to its target, then a definition whose value INSTANTIATES a generic
# and so declares itself when read; failing all of them, a forward shell of
# that name.
aliasOrShellTypeId: function {
    st: zenv.ZSymbolTable
    ast: Ast
    defUnit: ztypes.declid
    defDecl: ztypes.declid
    aliasDecl: ztypes.declid
    nameId: zast.nameid
} out ztypes.tid is {
    ex7: resolvedByIds :st :ast unitDecl: defUnit name: nameId
    if ex7.some then {
        return ex7
    }
    al7: resolveAliasKey :st :ast declId: defDecl
    if al7.notZero then return al7
    # `Strs: (List String)` names a TYPE through a call-shaped value. It
    # declares itself when READ, the same door a constant takes in
    # descendNamed -- a signature mentioning it may be resolved before the pass
    # that walks its definition.
    if defDecl.notZero when (statics.instantiatedAliasFold :ast :st declId: defDecl) then {
        it7: st.typing.declTypeOf declId: defDecl
        if it7.notZero then return it7
    }
    # the alias RENAMES its target, so its own name is no member of the
    # target's unit and defDecl found nothing there. The Decl the environment
    # walk hit IS the binding; following it is what resolveAliasKey is for.
    if aliasDecl.notZero when defDecl.isZero then {
        al8: resolveAliasKey :st :ast declId: aliasDecl
        if al8.notZero then return al8
    }
    nameText: zast.nameTextAt :ast ref: nameId
    return (st.reg.newType name: nameText.stringView typetype: ztypes.ztypetype.recordType)
}

# nodeRefused -- the type-ref node `nid` was refused where it is written
nodeRefused: function {st: zenv.ZSymbolTable.view nid: zast.nodeid} out bool is {
    if nid.isZero then return false
    return (st.typing.refusedValues.has item: nid)
}

# resolveNamedTypeId -- resolveNamedType by the name's id. The spelling is read
# through a block-scoped borrow where a literal is classified, and copied only
# where a type is minted or declared under it.
resolveNamedTypeId: function {
    # the symbol table the type is declared or found in
    st: zenv.ZSymbolTable
    # the tree the name was read from
    ast: Ast
    # the unit the reference is written in
    unitDecl: ztypes.declid
    # the scope the reference resolves in
    scope: ztypes.declid
    # the type's name, interned
    nameId: zast.nameid
    # the enclosing type's name for `this`/`type`, "" outside a type
    thisName: StringView
    # the referencing node, for the generic-parameter record; 0 when none
    nid: zast.nodeid.zero
} out ztypes.tid is {
    literalTid: literalNameTypeId :st :ast :scope :nameId
    if literalTid.notZero then return literalTid
    # a name its signature's parameter declares is refused, and the node with it
    bodies.refuseParamAsType :st :ast :nameId :nid
    gp7: memberaccess.genericParamTypeId :st :ast :unitDecl :scope :nameId :thisName :nid
    # a name refused as the member it names has no type of that spelling either
    if gp7.notZero or (nodeRefused :st :nid) then return gp7
    site: definingSiteForId :st :scope :ast :unitDecl :nameId
    defUnit: site.defUnit
    if defUnit.isZero then {
        # the environment before a shell: a name no unit-name index places
        # but the scope's chain reaches -- a template's generic
        # parameter in its own method signature (`v: t`), which is the
        # canonical GENERIC_PARAM id, not a forward record of that name
        e7: envTypeIdOf :st :scope :nameId
        if e7.notZero then return e7
        # an alias the chain reaches before it resolved -- a generic unit's
        # `elem: t`, read by a sibling's signature -- is followed to its target
        eh7: envLookup :st :scope :nameId
        if eh7.declId.notZero when (st.typing.decls.get i: eh7.declId).kind.reexportDecl then {
            ea7: resolveAliasKey :st :ast declId: eh7.declId
            if ea7.notZero then return ea7
        }
        nameText: zast.nameTextAt :ast ref: nameId
        return (st.reg.newType name: nameText.stringView typetype: ztypes.ztypetype.recordType)
    }
    typeKind: optionval.none ztypes.ztypetype
    dd7: declOfUnitDef :st :scope unitDecl: defUnit :nameId
    if dd7.notZero then typeKind = declDefTypetype :st :ast declId: dd7
    if typeKind.some then {
        descended: descendNamedId :st :scope :ast unitDecl: defUnit :nameId
        if descended.notZero then return descended
        return (
            declareCanonicalTypeId
            :st
            :scope
            :ast
            unitDecl: defUnit
            ownerNameId: zast.nameid
            :nameId
            typetype: typeKind
        )
    }
    return (aliasOrShellTypeId :st :ast :defUnit defDecl: dd7 aliasDecl: site.aliasDecl :nameId)
}

# resolveAtomType -- resolve a type-atom name in a method/param position. `this`
# and `type` alias the enclosing type (thisName); everything else is a plain name.
resolveAtomType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    # the atom's name, interned
    nameId: zast.nameid
    thisName: StringView
    nid: zast.nodeid.zero
} out ztypes.tid is {
    if nameId == zast.wellKnown.slot.wkThis then {
        # the receiver's name is both the name and the receiver: the second
        # role reads an owned copy
        tnOwn: thisName.string
        return (
            resolveNamedType
            :st
            :scope
            :ast
            :unitDecl
            name: thisName
            thisName: tnOwn.stringView
        )
    }
    if nameId == zast.wellKnown.slot.wkType when thisName.length != 0 then {
        tnOwnT: thisName.string
        named: resolveNamedType :st :scope :ast :unitDecl name: thisName thisName: tnOwnT.stringView
        selfApp: instantiate.selfApplicationTid :st :ast :unitDecl :scope templateId: named :nid
        if selfApp.notZero then return selfApp
        return named
    }
    return (resolveNamedTypeId :st :scope :ast :unitDecl :nameId :thisName :nid)
}

# monoArgName -- a pending-instantiation argument's recorded name: `this` and
# `type` map to the enclosing type (the recordResolvedName mapping); "" when
# there is no enclosing type.
monoArgName: function {an: StringView anId: zast.nameid thisName: StringView} out String is {
    if anId == zast.wellKnown.slot.wkThis then return thisName.string
    if anId == zast.wellKnown.slot.wkType then return thisName.string
    return an.string
}

# resolveDottedArgTid -- a unit-qualified dotted generic argument
# (ztypes.zlockstate): descend the member in its defining unit. Marker /
# non-unit dotted shapes resolve 0 (the caller skips the record).
resolveDottedArgTid: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    nid: zast.nodeid
} out ztypes.tid is {
    dr: statics.dpRefAt :ast :nid
    if dr.nid.isZero then return ztypes.tid.zero
    # a unit the declarations name, however deep and through any alias
    cqId: atomNameId :ast n: (ast.nodes.get i: dr.child)
    qm: qualifiedMemberTid :st :scope :ast qualNid: dr.parent memberId: cqId
    if qm.notZero then return qm
    # an alias of a type, reached through it
    tpa: memberaccess.typePathAliasTid :st :ast :scope parentNid: dr.parent leafId: cqId :nid
    if tpa.notZero then return tpa
    # owned copies: the walks below lend ast
    pq: zast.nameTextCopy :ast ref: (atomNameId :ast n: (ast.nodes.get i: dr.parent))
    cq: zast.nameTextCopy :ast ref: (atomNameId :ast n: (ast.nodes.get i: dr.child))
    if pq.length > 0 when cq.length > 0 then {
        pqId: atomNameId :ast n: (ast.nodes.get i: dr.parent)
        childNameId: atomNameId :ast n: (ast.nodes.get i: dr.child)
        if (typeref.qualifierNamesUnit :st :scope qualId: pqId memberId: childNameId) then {
            ud: unitDeclOfNameOrOwn :st :scope nameId: pqId
            return (descendNamed :st :scope :ast unitDecl: ud name: cq.stringView)
        }
    }
    return ztypes.tid.zero
}

# resolveMonoRefInline -- resolve a call-shaped parameterized type ref at the
# point it is recorded: resolve the template and every argument now (nested
# parameterized args recurse; the descent pulls unresolved defs), then dedup /
# materialize through getOrMintSpec and stamp node `nid`. Numeric size
# literals join the instance name only (const values, not type refs). Returns
# 0 -- recording nothing -- when the callable is empty or any argument is
# unresolvable (a template-internal generic-param name stays a shell).
resolveMonoRefInline: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    thisName: StringView
    enclDecl: ztypes.declid
    opNid: zast.nodeid
    nid: zast.nodeid
} out ztypes.tid is {
    # the row is read through a view scoped to this block: the resolution below
    # lends ast exclusively
    kind: zast.nodekind.placeholder
    callableId: zast.nodeid
    argIds: ListVal zast.nodeid
    {
        op: ast.nodes.get i: opNid
        kind = zast.kindOf n: op
        match (
            op
        ) case call then {
            callableId = op.callable
            for each a: (zast.kidsOf :ast span: op.arguments) loop {
                argIds.append from: a
            }
        } else null
    }
    if kind.call then {
        rm: (
            typeargs.resolveMonoRefParts
            :st
            :scope
            :ast
            :unitDecl
            :thisName
            :enclDecl
            callableNid: callableId
            arguments: argIds
            :nid
        )
        if rm.notZero when (st.walk.resolve.typedefClash.has key: rm) then {
            opn: ast.nodes.get i: opNid
            (
                reportTypedefClash
                :ast
                :st
                tid: rm
                at: opNid
                lineno: (nodeLine n: opn)
                colno: (nodeCol n: opn)
            )
        }
        return rm
    }
    return ztypes.tid.zero
}

# monoRefArgTid -- resolve one mono type-reference argument to a tid. An unlabelled
# argument is a dotted type-ref; a labelled one names a type in the enclosing
# declaration's scope, its own unit, or a builtin. 0 with okOut false when it
# names nothing resolvable.
monoRefArgTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    thisName: StringView
    enclDecl: ztypes.declid
    arg: argref
    an: StringView
    okOut: ListVal bool
} out ztypes.tid is {
    aid: ztypes.tid
    allOk: true
    if an.length == 0 then {
        aid = resolveDottedArgTid :st :scope :ast nid: arg.operation
        if aid.isZero then aid = (
            typeref.singletonPathArg
            :st
            :ast
            :unitDecl
            :scope
            :thisName
            nid: arg.operation
        )
        if aid.isZero then {
            inner: (
                resolveMonoRefInline
                :st
                :scope
                :ast
                :unitDecl
                :thisName
                :enclDecl
                opNid: arg.operation
                nid: zast.nodeid
            )
            if inner.notZero then {
                aid = inner
            } else {
                allOk = false
            }
        }
    } else {
        anc: monoArgName :an anId: (atomNameId :ast n: (ast.nodes.get i: arg.operation)) :thisName
        if anc.length == 0 then {
            allOk = false
        } else {
            if enclDecl.notZero when (
                st.reg.isGenericParamOf
                tdecl: enclDecl
                name: (nameIdOf :ast name: anc.stringView)
            ) then {
                (
                    declare.recordGenericParamRef
                    :st
                    nid: arg.operation
                    scope: enclDecl
                    name: (nameIdOf :ast name: anc.stringView)
                )
                aid = (
                    ztypes.tid.create
                    from: (
                        declare.genericParamTidMint
                        :st
                        :ast
                        tdecl: enclDecl
                        nameId: (nameIdOf :ast name: anc.stringView)
                    )
                )
            }
            # written in a body, where no enclosing declaration is passed: a
            # parameter of any template around the scope
            if aid.isZero when enclDecl.isZero then {
                aid = (
                    ztypes.tid.create
                    from: (
                        declare.genericParamInScope
                        :st
                        :ast
                        :scope
                        nameId: (atomNameId :ast n: (ast.nodes.get i: arg.operation))
                        nid: arg.operation
                    )
                )
            }
            # a name the CURRENT unit defines wins even when
            # not yet declared -- the ladder walk sees only
            # declared defs and would fall through to a
            # same-named stdlib type (resolveAtomType's rule)
            duo: (conform.definingSiteFor :st :scope :ast :unitDecl name: anc.stringView).defUnit
            if aid.isZero when duo == unitDecl then {
                aid = descendNamed :st :scope :ast unitDecl: duo name: anc.stringView
            }
            if aid.isZero then {
                ao: bodies.walkLookupTyperef :st :scope :ast :unitDecl base: anc.stringView
                aid = ao.or d: ztypes.tid.zero
            }
            if aid.isZero when duo.notZero then {
                aid = descendNamed :st :scope :ast unitDecl: duo name: anc.stringView
            }
            if aid.isZero then allOk = false
        }
    }
    if aid.notZero then aid = (
        instantiate.namedTypeArg
        :st
        :ast
        :unitDecl
        :scope
        :thisName
        :aid
        argNid: arg.operation
    )
    okOut.append allOk
    return aid
}

# monoRefTemplateTid -- the template a mono type-reference names: a name the
# CURRENT unit defines wins even when not yet declared, then the ladder, then
# the defining unit, then a generic file unit of that name. 0 when none is
# found.
monoRefTemplateTid: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    name: StringView
} out ztypes.tid is {
    return (monoRefTemplateTidById :st :scope :ast :unitDecl nameId: (nameIdOf :ast :name))
}

# monoRefTemplateTidById -- monoRefTemplateTid by the name's id.
monoRefTemplateTidById: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out ztypes.tid is {
    tplId: ztypes.tid
    if nameId.isZero then return tplId
    tduo: (definingSiteForId :st :ast :unitDecl :scope :nameId).defUnit
    if tduo == unitDecl then tplId = descendNamedId :st :scope :ast unitDecl: tduo :nameId
    if tplId.isZero then {
        tplO: walkLookupTyperefById :st :scope :ast :unitDecl baseId: nameId
        tplId = tplO.or d: ztypes.tid.zero
    }
    if tplId.isZero when tduo.notZero then tplId = (
        descendNamedId
        :st
        :scope
        :ast
        unitDecl: tduo
        :nameId
    )
    if tplId.isZero then {
        fud: st.typing.declFindChild parentDeclId: st.typing.programRoot :nameId
        if fud.notZero when (instantiate.declIsGenericFileUnit :st :ast declId: fud) then {
            tplId = st.typing.declTypeOf declId: fud
        }
    }
    return tplId
}

# pathMemberTypeTid -- the type a path's member names: a member of a unit the
# declarations name (a file unit, a nested unit, a path of them, an alias of
# any), the way a cross-unit ref is, or an alias of a type reached through it
# (`Tree.Node`). 0 when it names neither.
pathMemberTypeTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    scope: ztypes.declid
    parentId: zast.nodeid
    leafId: zast.nameid
    nid: zast.nodeid
} out ztypes.tid is {
    qm: qualifiedMemberTid :st :scope :ast qualNid: parentId memberId: leafId
    if qm.notZero then return qm
    return (memberaccess.typePathAliasTid :st :ast :scope parentNid: parentId :leafId :nid)
}

# unitInstanceMemberNamed -- the type `memberId` of the unit instance the name
# `qualId` binds, built on demand; 0 when `qualId` binds no instance or the
# instance has no such type.
unitInstanceMemberNamed: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    qualId: zast.nameid
    memberId: zast.nameid
} out ztypes.tid is {
    # a file unit's member is the ordinary alias, found before this is asked
    if (instantiate.isUnitNameDecl :st :scope nameId: qualId) then return ztypes.tid
    qt: (
        ztypes.tid.create
        from: (resolveAtomType :st :ast :unitDecl :scope nameId: qualId thisName: "")
    )
    if (st.reg.typetypeOf typeId: qt) != ztypes.ztypetype.unitType then return ztypes.tid
    if (st.reg.genericOriginOf tid: qt).isZero then return ztypes.tid
    instantiate.ensureUnitMonoBuilt :st :scope :ast monoId: qt
    mo: (st.typing.declChildOfId parentTypeId: qt nameId: memberId).or d: ztypes.tid.zero
    return mo
}

# resolve a type reference to its shell type id, deferring member resolution.
# resolveTyperefAtomShell -- a bare atom (or label) type ref: the name
# resolves as an atom type; an atom also demands the definition it names.
resolveTyperefAtomShell: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nameId: zast.nameid
    thisName: StringView
    demand: bool
    nid: zast.nodeid.zero
} out ztypes.tid is {
    npO: statics.numericParamTypeOwner :st :ast :unitDecl :scope :nameId :thisName
    if npO.notZero then return (typeref.numericParamBoundOf :st :ast :scope owner: npO :nameId)
    if demand then {
        walkScope: typeargs.scopeFor typing: st.typing :scope :unitDecl
        demandDefinition :st scope: walkScope :nameId
    }
    return (resolveAtomType :st :scope :ast :unitDecl :nameId :thisName :nid)
}

# stampMemberSignature -- stamp a member's return and parameter type-refs.
# paramTypeId and methodReturnOf both read the node stamp first, and
# stampTyperefs has already run by the time a member resolves on demand, so
# without this every parameter -- `this` included -- binds to nothing.
# Idempotent: stampForcedTyperef skips a node that already carries a type.
stampMemberSignature: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    thisName: StringView
    ownerTid: ztypes.tid
    fnNodeId: zast.nodeid
    mid: ztypes.tid
} is {
    # the member's type-refs resolve in its owner's scope
    rf: scope
    od: st.typing.declIdOfType typeId: ownerTid
    if od.notZero then rf = od
    # a generic member's own parameters are no names of that scope: a type-ref
    # naming one stays unstamped, as a generic free function's does, and the
    # walk binds the template's GENERIC_PARAM or an instance's substitution
    md: ztypes.declid
    if (st.reg.isGenericOf tid: mid) then md = st.typing.declIdOfType typeId: mid
    rn: (st.typing.funcReturnNode.get key: mid).or d: zast.nodeid
    if (typeExprNamesParamOf :st :ast tdecl: md nid: rn).not then {
        stampForcedTyperef :st scope: rf :ast :unitDecl :thisName nid: rn
    }
    if fnNodeId.isZero then return
    fr: bodies.fnRefAt :ast nid: fnNodeId
    if fr.nid.notZero then {
        kP: u64
        for kP < fr.nparams loop {
            pId: zast.fnParamAt :ast nid: fr.nid i: kP
            kP = kP + 1
            pn: argRefAt :ast nid: pId
            if pn.nid.notZero then {
                # the parameter's root name is read through a view, dropped
                # before the stamp below lends ast
                isThisRoot: false
                pRoot: rootNameIdOf :ast n: (ast.nodes.get i: pn.operation)
                isThisRoot = pRoot == zast.wellKnown.slot.wkThis
                if isThisRoot then {
                    ztyping.nodeTypeSet tbl: st.typing.nodeType nid: pn.operation tid: ownerTid
                } else if (typeExprNamesParamOf :st :ast tdecl: md nid: pn.operation).not then {
                    stampForcedTyperef :st scope: rf :ast :unitDecl :thisName nid: pn.operation
                }
            }
        }
    }
}

# typeExprNamesParamOf -- a type expression names a generic parameter `tdecl`
# declares anywhere inside it: under markers, as a call's callee or as one of
# its arguments. false for a zero `tdecl`.
typeExprNamesParamOf: function {
    st: zenv.ZSymbolTable.view ast: Ast.view tdecl: ztypes.declid nid: zast.nodeid
} out bool is {
    if tdecl.isZero or nid.isZero then return false
    n: ast.nodes.get i: nid
    match (
        n
    ) case atomid then {
        return (st.reg.isGenericParamOf :tdecl name: n.name)
    } case dottedpath then {
        return (typeExprNamesParamOf :st :ast :tdecl nid: n.parent)
    } case call then {
        if (typeExprNamesParamOf :st :ast :tdecl nid: n.callable) then return true
        i: u64
        for i < n.arguments.count loop {
            a: argRefAt :ast nid: (zast.callArgAt :ast :nid :i)
            i = i + 1
            if (typeExprNamesParamOf :st :ast :tdecl nid: a.operation) then return true
        }
        return false
    } else {
        return false
    }
}

# stampForcedTyperef -- stamp one type-ref node that resolved AFTER stampTyperefs
# ran. recordFuncReturnNode routes a call site's return type through the node
# stamp, and stampTyperefs fills those before the body walk -- so a member forced
# DURING the body walk records its return type-ref too late and reads back as
# null. Mirrors that pass's success leg for the one node.
stampForcedTyperef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    thisName: StringView
    nid: zast.nodeid
} is {
    if nid.isZero then return
    # an ownership marker (`zlexer.token.view`) is not part of the type.
    # paramTypeId peels it and reads the PARENT's stamp, so that is the node
    # to stamp -- stamping the marker node leaves the parameter untyped.
    tnid: nid
    peel: u64
    for peel < 4 loop {
        peel = peel + 1
        stop: true
        pk: ast.nodes.get i: tnid
        pkLeaf: memberaccess.dottedChildNameId :ast n: pk
        if pk.dottedpath when (isStripMarkerId nameId: pkLeaf) then {
            tnid = pk.parent
            stop = false
        }
        if stop then peel = 4
    }
    if tnid.isZero then return
    tnT: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: tnid
    nT: ztyping.nodeTypeAt tbl: st.typing.nodeType :nid
    if tnT.notZero when nT.notZero then return
    # the real resolver first: it handles a PARAMETERIZED type-expr
    # (`out (resultval t: u32 e: converror)`), where a base name would name the
    # TEMPLATE and stamping that is worse than not stamping at all.
    {
        rs: typeref.resolveTyperefShell :st :scope :ast :unitDecl nid: tnid :thisName
        if rs.notZero then {
            ztyping.nodeTypeSet tbl: st.typing.nodeType nid: tnid tid: rs
            ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: rs
            return
        }
    }
    # a DOTTED return (`out zast.nodeid`) names its type in another unit, which
    # no single base name reaches
    {
        rootN: zast.nameTextCopy :ast ref: (rootNameIdOf :ast n: (ast.nodes.get i: tnid))
        childN: (
            zast.nameTextCopy
            :ast
            ref: (memberaccess.dottedChildNameId :ast n: (ast.nodes.get i: tnid))
        )
        if childN.length > 0 when rootN.length > 0 then {
            hUnitDecl: unitDeclOfNameOrOwn :st :scope nameId: (nameIdOf :ast name: rootN.stringView)
            dd: descendNamed :st :scope :ast unitDecl: hUnitDecl name: childN.stringView
            if dd.notZero then {
                ztyping.nodeTypeSet tbl: st.typing.nodeType nid: tnid tid: dd
                ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: dd
                return
            }
        }
    }
    # the base name: from the pending record when the demand pass saw this
    # node, else off the type-expr itself -- a member resolved on demand never
    # went through a pass that records one
    recvBaseId: zast.nameid
    pv: st.walk.pendingTyperef.get key: tnid
    if pv.some then recvBaseId = pv
    if recvBaseId.isZero then recvBaseId = declare.baseTypeNameId :ast n: (ast.nodes.get i: tnid)
    if recvBaseId.isZero then return
    r: walkLookupTyperefById :st :scope :ast :unitDecl baseId: recvBaseId
    if r.some then {
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: tnid tid: r
        ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: r
        return
    }
    # the name resolves nowhere because nothing ever demanded it: a member
    # resolved on demand can be the FIRST reference to a type, and the demand
    # fixpoint finished before the body walk. Descend into it here.
    dn: descendNamedId :st :scope :ast :unitDecl nameId: recvBaseId
    if dn.notZero then {
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: tnid tid: dn
        ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: dn
        return
    }
    recvTid: walkLookupTyperefById :st :scope :ast :unitDecl baseId: recvBaseId
    if recvTid.some then {
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: tnid tid: recvTid
        ztyping.nodeTypeSet tbl: st.typing.nodeType :nid tid: recvTid
    }
}

# forceUnitDef -- resolve ONE top-level TYPE definition of a unit now, and
# answer its type id (0 when it does not resolve). Every other `force*` resolves
# a MEMBER, and every resolver of a DEFINITION is a whole-unit loop, so a caller
# holding a single member node -- the method walk -- had no way to say "resolve
# this owner first". It walked the bodies regardless, with the owner's Decl
# still carrying typeId 0: `this` typed as notype, so a correct body was
# REJECTED and a wrong return type was ACCEPTED, one per body shape. The probe
# it used (resolveUnitChild) cannot mint -- a probe reads what resolution left.
forceUnitDef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    memId: zast.nodeid
} out ztypes.tid is {
    nmId: zast.nameid
    opId: zast.nodeid
    mm: ast.nodes.get i: memId
    if mm.namedoperation then {
        nmId = mm.name
        opId = mm.operation
    }
    if nmId.isZero then return ztypes.tid.zero
    uId: bodies.unitNameIdOf :st :unitDecl
    targetUnit: unitDeclOfName typing: st.typing nameId: uId
    got: resolvedByIds :st :ast unitDecl: targetUnit name: nmId
    if got.some then {
        return got
    }
    if opId.isZero then return ztypes.tid.zero
    # a TYPE only: a namespace, a template and a function each reach their own
    # resolver, and none of them owns the method bodies this guards.
    isObj: false
    oo: ast.nodes.get i: opId
    if oo.objectdef then isObj = true
    if isObj.not then return ztypes.tid.zero
    if (defWasResolved :st :scope :unitDecl nameId: nmId) then return ztypes.tid.zero
    # re-entry: a method that constructs its own type walks back through here
    # while the definition is mid-resolution.
    if (st.typing.declIsResolving declId: (
        declOfUnitDefIds
        typing: st.typing
        unitDecl: targetUnit
        nameId: nmId
    )
    ) then return ztypes.tid.zero
    dn: zast.nameTextCopy :ast ref: nmId
    resolveDef :st :scope :ast :unitDecl defName: dn.stringView defnId: opId
    ro: resolvedByIds :st :ast unitDecl: targetUnit name: nmId
    if ro.some then {
        return ro
    }
    return ztypes.tid.zero
}

# namesNullTypeAt -- namesNullType for a name written in `scope` of `unitDecl`:
# the same walk over declarations, from where a body or a definition stands.
namesNullTypeAt: function {
    # the declarations the name is looked up in, by its definitions alone
    st: zenv.ZSymbolTable.view
    # the tree whose re-export edges the walk follows
    ast: Ast.view
    # the unit the name is written in
    unitDecl: ztypes.declid
    # the scope the name is written in
    scope: ztypes.declid
    # the name, interned; 0 for no name
    nameId: zast.nameid
} out bool is {
    if nameId.isZero then return false
    du: (definingSiteForId :st :ast :unitDecl :scope :nameId).defUnit
    hops: u64
    for hops < 8 loop {
        hops = hops + 1
        if du.isZero then return false
        dd: declOfUnitDef :st :scope unitDecl: du :nameId
        if dd.isZero then return false
        tt: declDefTypetype :st :ast declId: dd
        if tt.some then {
            return tt == ztypes.ztypetype.nullType
        }
        # a re-export the defining unit itself makes (core's `null: system.null`)
        du = unitDeclOfName typing: st.typing nameId: (reexportUnitOf :st :ast declId: dd)
    }
    return false
}

# checkImplementations -- every explicit implementation the program recorded, checked
# against its spec (checkImplementationSignature). Run once the declarations are
# resolved and the shells canonical: a row is recorded when its marker is
# reached, before the spec's return types have been stamped. Reported at the
# marker, the member the impl declares under the implementation's label. A user
# generic template's marker is a promise for every instance, so each instance
# is checked instead of the template (checkInstanceImplementations).
checkImplementations: function {ast: Ast st: zenv.ZSymbolTable} is {
    # the rows recorded so far: checking an instance records rows of its own,
    # which are checked already
    rowEnd: st.typing.nextConf
    ci: ztypes.confid
    for ci.next < rowEnd loop {
        ci = ci.next
        implT: ztypes.tid
        specT: ztypes.tid
        lblId: zast.nameid
        crow: st.typing.implementation.get i: ci
        implT = crow.implTypeId
        specT = crow.specTypeId
        lblId = crow.labelNameId
        crow.drop
        mdecl: st.typing.declMemberIdOf parentTypeId: implT nameId: lblId
        if mdecl.isZero then mdecl = st.typing.declIdOfType typeId: implT
        mnid: zast.nodeid
        if mdecl.notZero then {
            dnode: (st.typing.decls.get i: mdecl).node
            mnid = dnode
        }
        implName: st.reg.nameOf tid: implT
        # a marker naming a generic spec itself was refused where it was written
        if (st.reg.isGenericOf tid: specT) then continue
        if (st.reg.isGenericOf tid: implT) when (st.reg.isNativeOf tid: implT).not then {
            (
                conform.checkInstanceImplementations
                :st
                :ast
                row: ci
                markerOp: mnid
                implName: implName.stringView
            )
        } else {
            (
                conform.checkImplementationSignature
                :st
                :ast
                implTid: implT
                specTid: specT
                markerOp: mnid
                implName: implName.stringView
            )
        }
    }
}

# dottedTyperefId -- the type id of a cross-unit qualified type ref `unit.Type`
# (e.g. the `zvfs.ProviderBox` element of a `(List of: zvfs.ProviderBox)`),
# resolved through the defining unit's scope, or of a type's alias reached
# through it (`Tree.Node`). Bare-name visibility covers only
# main+system, so a dep element misses there; this bridges via the unit probe
# plus resolved. 0 when not a dotted ref or unresolved.
dottedTyperefId: function {ast: Ast st: zenv.ZSymbolTable op: astnode.view} out ztypes.tid is {
    match (
        op
    ) case dottedpath then {
        pnId: atomNameId :ast n: (ast.nodes.get i: op.parent)
        cnId: atomNameId :ast n: (ast.nodes.get i: op.child)
        if (typeref.qualifierNamesUnit :st scope: st.curScope qualId: pnId memberId: cnId) then {
            uq0z: fileUnitNamedAt :st scope: st.curScope nameId: pnId
            ro: resolvedByIds :st :ast unitDecl: uq0z name: cnId
            return (ro.or d: ztypes.tid.zero)
        }
        # an alias reached through its type (`Tree.Node`)
        tpa: (
            memberaccess.typePathAliasTid
            :st
            :ast
            scope: st.curScope
            parentNid: op.parent
            leafId: cnId
            nid: op.nodeid
        )
        if tpa.notZero then return tpa
        return (qualifiedMemberTid :st scope: st.curScope :ast qualNid: op.parent memberId: cnId)
    } else {
        return ztypes.tid.zero
    }
}

# qualifiedMemberTid -- `q.Member` where the qualifier path `qualNid` names a
# unit (qualifierUnitDecl): a file unit, a unit declared inside another
# (inline, a hidden subunit, `rem.deeper`), or an alias of one (`c: rem`). The
# member of that unit's own declaration; 0 when the qualifier names no unit.
qualifiedMemberTid: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    qualNid: zast.nodeid
    memberId: zast.nameid
} out ztypes.tid is {
    if memberId.isZero then return ztypes.tid.zero
    ud: statics.qualifierUnitDecl :st :scope :ast nid: qualNid
    if ud.isZero then return ztypes.tid.zero
    owner: st.typing.declParentOf declId: ud
    if owner == st.typing.programRoot then {
        demandUnitMember :st unitNameId: (st.typing.declNameOf declId: ud) nameId: memberId
        return (descendNamedId :st :scope :ast unitDecl: ud nameId: memberId)
    }
    return (
        nestedUnitMemberTid
        :st
        :ast
        ownerDeclId: owner
        nestedNameId: (st.typing.declNameOf declId: ud)
        defName: memberId
    )
}

# qualifierUnitDeclAt -- qualifierUnitDecl, `hops` unit aliases into a chain.
# A chain longer than unitAliasHops is a cycle and names no unit.
qualifierUnitDeclAt: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    ast: Ast.view
    nid: zast.nodeid
    hops: u64
} out ztypes.declid is {
    none: ztypes.declid.zero
    if nid.isZero or (hops > unitAliasHops) then return none
    n: ast.nodes.get i: nid
    match (
        n
    ) case atomid then {
        return (unitNamedBy :st :scope :ast nameId: n.name :hops)
    } case dottedpath then {
        pd: qualifierUnitDeclAt :st :scope :ast nid: n.parent :hops
        if pd.isZero then return none
        cd: (
            st.typing.declFindChild
            parentDeclId: pd
            nameId: (atomNameId :ast n: (ast.nodes.get i: n.child))
        )
        return (unitOfBinding :st :ast declId: cd :hops)
    } else {
        return none
    }
}

# unitNamedBy -- the unit a bare name written in `scope` names: the file unit it
# reaches (fileUnitNamedAt), else the unit its binding in scope declares or
# aliases (unitOfBinding, read off the alias's value whether or not the alias
# has resolved), `hops` aliases into a chain. 0 for none.
unitNamedBy: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    ast: Ast.view
    nameId: zast.nameid
    hops: 0.u64
} out ztypes.declid is {
    fu: fileUnitNamedAt :st :scope :nameId
    if fu.notZero then return fu
    h: envLookup :st :scope :nameId
    return (unitOfBinding :st :ast declId: h.declId :hops)
}

# unitAliasHops -- how many unit aliases a qualifier is followed through
unitAliasHops: 8

# unitOfBinding -- the unit declaration `declId` names: itself when it declares
# a unit, the unit its value names when it is an alias of one (read off the
# value as written, so it holds before the alias resolves), else 0.
unitOfBinding: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
    hops: u64
} out ztypes.declid is {
    if declId.isZero then return ztypes.declid.zero
    isUd: false
    dO: st.typing.decls.get i: declId
    if dO.kind.unitDecl then isUd = true
    if isUd then return declId
    ar: argRefAt :ast nid: (st.typing.decls.get i: declId).node
    if ar.operation.isZero then return ztypes.declid.zero
    return (
        qualifierUnitDeclAt
        :st
        scope: (st.typing.declParentOf :declId)
        :ast
        nid: ar.operation
        hops: hops + 1
    )
}

# unionCustomTagOfArm -- one as-item of a union: a `tag` member whose base is a
# list answers that list. A tag on any other base (`u8.tag`) stamps the item
# with the system's `tag` and answers none, as does every other item.
unionCustomTagOfArm: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    am: argref
} out tagsource is {
    none: tagsource row: 0 decl: ztypes.declid
    if am.name != zast.wellKnown.slot.wkTag then return none
    # `tag: tag` names the item being made; `:tag` names the system's tag
    if (zast.atomNameIdOf n: (ast.nodes.get i: am.operation)) == zast.wellKnown.slot.wkTag then {
        (
            addErrorWithHint
            :st
            nodeid: am.operation
            lineno: am.lineno
            colno: am.colno
            e: zast.err.constError
            msg: "'tag' is defined in terms of itself".string
            note: "".string
            hint: "a definition's value may not name the definition; the shorthand `:tag` names `tag` as it is named outside it".string
            width: 3
        )
        return none
    }
    pnId: zast.nameid
    baseId: zast.nodeid
    {
        op: ast.nodes.get i: am.operation
        if op.dottedpath then {
            baseId = op.parent
            pnId = atomNameId :ast n: (ast.nodes.get i: op.parent)
        }
    }
    if pnId.isZero then return none
    ld: memberaccess.declInScope :st scopeDeclId: scope nameId: pnId
    if ld.notZero when (st.typing.decls.get i: ld).kind.staticListDecl then {
        lv: statics.evalConstNode :st :scope :ast :unitDecl nid: baseId
        if lv.kind.aggKind then return (tagsource row: lv.aggId decl: ld)
        return none
    }
    hUnitDecl: unitDeclOfName typing: st.typing nameId: zast.wellKnown.slot.unSystem
    tgo: resolvedByIds :st :ast unitDecl: hUnitDecl name: zast.wellKnown.slot.wkTag
    if tgo.some then {
        armNid: nodeId n: (ast.nodes.get i: am.operation)
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: armNid tid: tgo
    }
    return none
}

# defWasResolved -- has this definition's body already been resolved? The mark
# lives on its Decl, so a definition with no Decl of its own has not been.
defWasResolved: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nameId: zast.nameid
} out bool is {
    d: declOfUnitDef :st :scope :unitDecl :nameId
    if d.notZero then return (st.typing.declIsResolved declId: d)
    return false
}

# typedefBaseDecl -- the Decl a typedef definition's base names, looked up from
# the unit the typedef is written in: an atom or a parameterized base by its
# head name, a dotted one by its unit and name. A name that reaches its
# definition through an alias (`List` is core's `collections.ListRef`) is
# followed to the alias's target. Zero when the base names no definition.
typedefBaseDecl: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
    baseNid: zast.nodeid
} out ztypes.declid is {
    zd: ztypes.declid
    bn: ast.nodes.get i: baseNid
    # a head that is a path through a unit -- the base's own, or a type
    # application's (`(pr.GBox t: i64)`) -- names its declaration down that path
    headNid: baseNid
    if bn.call then headNid = bn.callable
    hdn: ast.nodes.get i: headNid
    if hdn.dottedpath then {
        segs: ListVal zast.nameid
        instantiate.instCallablePath :ast op: (ast.nodes.get i: headNid) :segs
        pd: instantiate.instTemplateDecl :st scopeDeclId: (st.typing.declParentOf :declId) :segs
        if pd.notZero then return pd
    }
    dk: dottedDefTargetIds :ast n: bn
    if dk.unitName.notZero then {
        du: fileUnitNamedAt :st scope: (st.typing.declParentOf :declId) nameId: dk.unitName
        if du.isZero then return zd
        return (declOfUnitDef :st scope: du unitDecl: du nameId: dk.defName)
    }
    hn: typeargs.paramTypeBaseNameId :ast op: bn
    if hn.isZero then return zd
    scope: st.typing.declParentOf :declId
    ud: unitScopeOf typing: st.typing declId: scope
    site: definingSiteForId :st :ast unitDecl: ud :scope nameId: hn
    if site.defUnit.isZero then return zd
    if site.aliasDecl.notZero then return (
        conform.aliasTargetDecl
        :st
        :ast
        aliasDecl: site.aliasDecl
    )
    return (declOfUnitDef :st :scope unitDecl: site.defUnit nameId: hn)
}

# typedefDefTypetype -- the typetype a `typedef` definition takes: its base's
# family, so a valtype base makes it a record and a reftype base a class. A
# typedef of a typedef takes the family its base took. A base that names no
# definition reads as a record, and resolving the base reports it.
typedefDefTypetype: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
    baseNid: zast.nodeid
    depth: u64
} out ztypes.ztypetype is {
    if depth > 32 then return ztypes.ztypetype.recordType
    bd: typedefBaseDecl :st :ast :declId :baseNid
    if bd.isZero then return ztypes.ztypetype.recordType
    bb: declTypedefBaseNid :st :ast declId: bd
    if bb.notZero then {
        return (typedefDefTypetype :st :ast declId: bd baseNid: bb depth: depth + 1)
    }
    btt: declDefTypetype :st :ast declId: bd
    if btt.some then {
        if btt == ztypes.ztypetype.classType then return ztypes.ztypetype.classType
        if btt == ztypes.ztypetype.unionType then return ztypes.ztypetype.classType
        if btt == ztypes.ztypetype.protocolType then return ztypes.ztypetype.classType
    }
    return ztypes.ztypetype.recordType
}

# declTypedefBaseNid -- the base type reference of the `typedef` definition a
# Decl records; zero when it records anything else.
declTypedefBaseNid: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out zast.nodeid is {
    zn: zast.nodeid
    dnode: zast.nodeid
    dro: st.typing.decls.get i: declId
    dnode = dro.node
    if dnode.isZero then return zn
    nop: ast.nodes.get i: dnode
    if nop.namedoperation then {
        dop: ast.nodes.get i: nop.operation
        if dop.objectdef when dop.kind == zast.objectkind.typedefDef then {
            return (zast.kidAt kids: ast.kids span: dop.isItems i: 0)
        }
    }
    return zn
}

# typedefDefIsReftype -- a unit's `typedef` definition named `defName` takes a
# reftype base, so it resolves as a class.
typedefDefIsReftype: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
    defName: StringView
} out bool is {
    dd: (
        declOfUnitDef
        :st
        scope: unitDecl
        :unitDecl
        nameId: (zast.poolFind pool: ast.names text: defName)
    )
    if dd.isZero then return false
    tt: declDefTypetype :st :ast declId: dd
    match (
        tt
    ) case some then {
        return tt == ztypes.ztypetype.classType
    } case none then {
        return false
    }
}

# declDefTypetype -- the typetype a declaration's def node declares
# (defTypetypeOf off the Decl's own namedoperation); none for defs that
# mint no canonical type (re-exports, constants, null/never).
declDefTypetype: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out optionval ztypes.ztypetype is {
    dnode: zast.nodeid
    dname: zast.nameid
    decl: st.typing.decls.get i: declId
    dnode = decl.node
    dname = decl.name
    if dnode.isZero then return (optionval.none ztypes.ztypetype)
    db: declTypedefBaseNid :st :ast :declId
    if db.notZero then {
        return (optionval.some (typedefDefTypetype :st :ast :declId baseNid: db depth: 0))
    }
    nop: ast.nodes.get i: dnode
    if nop.namedoperation then {
        return (
            defTypetypeOf
            defn: (ast.nodes.get i: nop.operation)
            nameId: dname
            inSystem: decl.parent == st.typing.systemUnitRoot
        )
    }
    return (optionval.none ztypes.ztypetype)
}

# reexportTargetIdsOf -- the (unit, member) pair a re-export Decl names, as ids;
# an absent pair when the Decl is absent or not a re-export.
reexportTargetIdsOf: function {
    typing: ztyping.ZTyping.view
    ast: Ast.view
    declId: ztypes.declid
} out ztypes.deftarget is {
    if declId.isZero then return ztypes.noDefTarget
    decl: typing.decls.get i: declId
    if decl.kind.reexportDecl then {
        nop: ast.nodes.get i: decl.node
        if nop.namedoperation then {
            vn: ast.nodes.get i: nop.operation
            dk: dottedDefTargetIds :ast n: vn
            if dk.unitName.notZero then return dk
            # a BARE alias names a target in its OWN unit, so the missing
            # segment is the enclosing unit's name -- the Decl's parent.
            bid: zast.atomNameIdOf n: vn
            if bid.notZero then {
                puid: zast.nameid
                pdo: typing.decls.get i: decl.parent
                puid = pdo.name
                if puid.notZero then return (ztypes.deftarget unitName: puid defName: bid)
            }
        }
    }
    return ztypes.noDefTarget
}

# aliasIsBareForm -- the alias Decl's value is a BARE name (`Same: Holder`)
# rather than a dotted one. The target pair cannot say: a bare alias
# borrows its own unit for the missing segment, which a self-unit dotted alias
# (`Alpha: thisunit.Beta`) spells explicitly.
aliasIsBareForm: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    if declId.isZero then return false
    bdo: st.typing.decls.get i: declId
    if bdo.kind.reexportDecl then {
        bnp: ast.nodes.get i: bdo.node
        if bnp.namedoperation then {
            bvn: ast.nodes.get i: bnp.operation
            bnid: zast.atomNameIdOf n: bvn
            return bnid.notZero
        }
    }
    return false
}

# aliasTargetOwner -- the declaration whose unit `nestedNameId` an alias written
# in `scopeDeclId` names: the alias's own scope, else each unit enclosing it,
# outward to the file unit -- the chain any name written there walks. A
# `public:` block is a scope of its own, so `Foo: impl.Foo` in one names the
# enclosing unit's hidden subunit `impl` whether or not the block lists it.
# `scopeDeclId` itself when no scope on the way declares that unit.
aliasTargetOwner: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    scopeDeclId: ztypes.declid
    nestedNameId: zast.nameid
} out ztypes.declid is {
    cur: scopeDeclId
    for cur.notZero and (cur != st.typing.programRoot) loop {
        sub: st.typing.declFindChild parentDeclId: cur nameId: nestedNameId
        if (declDeclaresUnit typing: st.typing :ast declId: sub) then return cur
        cur = st.typing.declParentOf declId: cur
    }
    return scopeDeclId
}

# nestedUnitTidOf -- the type id of the nested unit `nestedNameId` names inside the
# unit that owns `ownerDeclId`: descend one edge of the Decl tree, ask demand
# for it, and read the id off its declaration. 0 when the name is not a child
# unit, which is the caller's cue that the name means something else.
nestedUnitTidOf: function {
    st: zenv.ZSymbolTable
    ast: Ast
    ownerDeclId: ztypes.declid
    nestedNameId: zast.nameid
} out ztypes.tid is {
    if ownerDeclId.isZero then return ztypes.tid.zero
    sub: st.typing.declFindChild parentDeclId: ownerDeclId nameId: nestedNameId
    if (declDeclaresUnit typing: st.typing :ast declId: sub).not then return ztypes.tid.zero
    resolveDemandedDecl :st :ast declId: sub
    return (st.typing.declTypeOf declId: sub)
}

# declDeclaresUnit -- does this declaration declare a unit? Read off the def
# node's kind, which the parser settled; nothing is resolved to answer. Says
# nothing about privacy -- `nestedUnitTidOf` calls it on a CHILD declaration,
# where being nested is a property of the descent, not of the arm.
declDeclaresUnit: function {
    typing: ztyping.ZTyping.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    dn: zast.nodeid
    decl: typing.decls.get i: declId
    dn = decl.node
    if dn.isZero then return false
    np: ast.nodes.get i: dn
    if np.namedoperation.not then return false
    return (zast.unitOpDeclaresUnit :ast opId: np.operation)
}

# nestedUnitMemberTid -- `sub.member` where `sub` is a nested unit of the unit
# that owns `ownerDeclId`: two edges of the Decl tree, each resolved on demand
# the way any definition is. 0 when either edge is missing.
nestedUnitMemberTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    ownerDeclId: ztypes.declid
    nestedNameId: zast.nameid
    defName: zast.nameid
} out ztypes.tid is {
    subTid: nestedUnitTidOf :st :ast :ownerDeclId :nestedNameId
    if subTid.isZero then return ztypes.tid.zero
    sub: st.typing.declFindChild parentDeclId: ownerDeclId nameId: nestedNameId
    mem: st.typing.declFindChild parentDeclId: sub nameId: defName
    if mem.isZero then return ztypes.tid.zero
    # declare before bind, as descendNamed does for a file unit's member: a
    # TYPE member's canonical id is declared (in the member's own scope)
    # before its definition resolves, so a reference that reaches it while
    # it is grey -- a legal back-edge between two types' method signatures
    # -- gets the id, not the not-yet-linked declaration field
    declared: ztypes.tid
    tto: declDefTypetype :st :ast declId: mem
    if tto.some then {
        declared = (
            declareCanonicalTypeId
            :st
            scope: sub
            :ast
            unitDecl: sub
            ownerNameId: zast.nameid
            nameId: defName
            typetype: tto
        )
    }
    resolveDemandedDecl :st :ast declId: mem
    r: st.typing.declTypeOf declId: mem
    if r.isZero when declared.notZero then return declared
    return r
}

# aliasTargetMintedTid -- the canonical id an alias's target carries, or 0:
# a nested unit's member of the alias's own scope, else the named file
# unit's definition. The declaration's own field is set when its resolution
# COMPLETES; the canonical id is declared before bind (declareCanonicalType,
# idempotent), so a target mid-resolution -- a record whose members name the
# alias again -- answers with the id it already declared. It resolves
# nothing.
aliasTargetMintedTid: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    declId: ztypes.declid
    nestedNameId: zast.nameid
    defName: zast.nameid
} out ztypes.tid is {
    aParent: st.typing.declParentOf :declId
    tgt: ztypes.declid
    sub: (
        st.typing.declFindChild
        parentDeclId: (aliasTargetOwner :st :ast scopeDeclId: aParent :nestedNameId)
        nameId: nestedNameId
    )
    # the unit the target is declared in: the nested unit, else the unit the
    # name reaches from the alias's scope
    tgtUnit: sub
    if sub.notZero then tgt = st.typing.declFindChild parentDeclId: sub nameId: defName
    if tgt.isZero then {
        tgtUnit = unitDeclOfNameOrOwn :st :scope nameId: nestedNameId
        tgt = declOfUnitDefIds typing: st.typing unitDecl: tgtUnit nameId: defName
    }
    if tgt.isZero then return ztypes.tid.zero
    mt: st.typing.declTypeOf declId: tgt
    if mt.notZero then return mt
    tto: declDefTypetype :st :ast declId: tgt
    match (
        tto
    ) case some then {
        # declared in the TARGET's scope -- its parent unit -- so the id is
        # the one the target's own resolution declares (keyed on that unit)
        rf: st.typing.declParentOf declId: tgt
        r: (
            declareCanonicalTypeId
            :st
            scope: rf
            :ast
            unitDecl: tgtUnit
            ownerNameId: zast.nameid
            nameId: defName
            typetype: tto
        )
        return r
    } case none then {
        return ztypes.tid.zero
    }
}

# resolveAliasKey -- single-minting for a unit-level re-export alias
# (a reexportDecl in the Decl tree; target read off its def node): resolve the
# TARGET's canonical id and reuse it -- the alias never mints its own
# tid. Registers the unit member and the alias Decl's typeId so
# every later lookup (declChildOf, resolveUnitChild, the Decl tree) sees
# the one canonical id. Returns 0 when the key is not an alias, the
# alias is mid-follow (a cycle), or the target cannot resolve yet.
resolveAliasKey: function {
    st: zenv.ZSymbolTable
    ast: Ast
    declId: ztypes.declid
} out ztypes.tid is {
    # a value whose head names the definition itself (`foo: foo`, `foo: foo.x`)
    # can give it neither a value nor a type, and resolving it asks for itself
    # without end: a cycle, reported where it is written
    if (valueHeadIsSelf :st :ast :declId) then {
        reportAliasCycle :st :ast :declId dnode: (st.typing.decls.get i: declId).node
        return ztypes.tid.zero
    }
    # an alias resolves in the scope it is written in
    ascope: st.typing.declParentOf :declId
    # THE VALUE DECIDES WHETHER THIS IS AN ALIAS AT ALL. `X: <something>` is
    # recorded as a re-export during indexing, a pass that runs before anything
    # resolves and so has only the text to go on. Here the target CAN be asked,
    # so it is: a definition whose value is a compile-time CONSTANT is a
    # constant, and minting an alias type for it would give the program a type
    # named `false`, and `x: false` would fail as one.
    #
    # Folded first for that reason. A genuine type alias folds to nothing and
    # falls through to the chase below, unchanged. A path to an instance's
    # numeric generic parameter (`X: B5.cap`) folds too, and names its
    # singleton type: an alias.
    sgp: statics.singletonPathAlias :st :ast :declId scope: ascope
    if sgp.notZero then {
        registerAliasTarget :st :declId scope: ascope tid: sgp
        return sgp
    }
    statics.constFoldDecl :st :ast :declId
    cvA: statics.constValueOfDecl :st :declId
    if cvA.isConst then return (st.typing.declTypeOf :declId)
    # an alias of a numeric generic parameter (`SAME: cap`) in the template
    # names the parameter's singleton type
    if (aliasIsBareForm :st :ast :declId) then {
        npa: (
            statics.numericParamAliasTarget
            :st
            :ast
            scope: ascope
            nameId: (
                zast.atomNameIdOf
                n: (ast.nodes.get i: (statics.declOperationOf :st :ast :declId))
            )
        )
        if npa.notZero then {
            registerAliasTarget :st :declId scope: ascope tid: npa
            return npa
        }
    }
    r: fileUnitAliasTid :st :ast adecl: declId
    if r.isZero then r = resolveAliasKeyIn :st scope: ascope :ast :declId
    if r.isZero then r = resolveAppliedMemberAlias :st :ast scope: ascope :declId
    if r.isZero then r = statics.resolveDeepAlias :st :ast scope: ascope :declId
    refuseArmAliasPayload :st :ast :declId tid: r
    return r
}

# registerAliasTarget -- the unit-level alias `declId`, written in `scope`, names
# `tid`: the unit's member and the alias's declaration both carry it.
registerAliasTarget: function {
    st: zenv.ZSymbolTable
    declId: ztypes.declid
    scope: ztypes.declid
    tid: ztypes.tid
} is {
    ownTid: st.typing.declTypeOf declId: scope
    if ownTid.notZero then (
        st.typing.setMemberType
        parentTypeId: ownTid
        nameId: (st.typing.decls.get i: declId).name
        childTypeId: tid
    )
    st.typing.declSetType :declId typeId: tid
}

# valueHeadIsSelf -- whether the value of the definition `declId` starts with
# the definition itself: its head names it (`foo` in `foo` and in `foo.x.y`), or
# names a definition whose value's head does, through any chain of them (`foo:
# bar.x` with `bar: foo`). The scope a definition is written in finds the
# definition itself for its head, and so hides any unit of that name (`io:
# io.print`). The chain is followed two steps at a time beside one at a time,
# so a ring the definition is not on ends the walk when the two meet.
valueHeadIsSelf: function {
    st: zenv.ZSymbolTable.view ast: Ast.view declId: ztypes.declid
} out bool is {
    if declId.isZero then return false
    slow: declId
    fast: declId
    for true loop {
        fast = valueHeadDecl :st :ast declId: fast
        if fast.isZero or (fast == declId) then return fast == declId
        fast = valueHeadDecl :st :ast declId: fast
        if fast.isZero or (fast == declId) then return fast == declId
        slow = valueHeadDecl :st :ast declId: slow
        if slow == fast then return false
    }
    return false
}

# valueHeadDecl -- the definition the head of `declId`'s value names (`foo` in
# `foo.x.y`, `Beta` in `u.Beta.x` when `u` names a unit), looked up from the
# scope the definition is written in; 0 when the value has no name at its head,
# the name finds no definition, or `declId` is no definition by value (a
# re-export or a constant) -- a unit, a type or a function ends the chain.
valueHeadDecl: function {
    st: zenv.ZSymbolTable.view ast: Ast.view declId: ztypes.declid
} out ztypes.declid is {
    dk: (st.typing.decls.get i: declId).kind
    if dk.reexportDecl.not when dk.constDecl.not then return ztypes.declid.zero
    ar: argRefAt :ast nid: (st.typing.decls.get i: declId).node
    scope: st.typing.declParentOf :declId
    nid: ar.operation
    for nid.notZero loop {
        n: ast.nodes.get i: nid
        match (
            n
        ) case dottedpath then {
            # a qualifier naming a unit is no definition by value: the head is
            # the member it reaches, so a ring through a unit's name -- the
            # definition's own unit or another -- is still a ring
            qu: statics.qualifierUnitDecl :st :scope :ast nid: n.parent
            if qu.notZero then {
                cn: atomNameId :ast n: (ast.nodes.get i: n.child)
                if cn.isZero then return ztypes.declid.zero
                own: statics.qualifiedMemberScope :st unitRoot: qu memberId: cn
                return (st.typing.declFindChild parentDeclId: own nameId: cn)
            }
            nid = n.parent
        } else break
    }
    if nid.isZero then return ztypes.declid.zero
    head: atomNameId :ast n: (ast.nodes.get i: nid)
    if head.isZero then return ztypes.declid.zero
    return (envLookup :st :scope nameId: head).declId
}

# resolveAppliedMemberAlias -- `C5: (cells t: i64).Cell`: a unit-level alias of a
# member of a unit applied in place, which has no unit name for the target pair
# to carry. It resolves as the same type-ref would -- the application's instance,
# that instance's copy of the type -- and is recorded on the Decl and the unit's
# member index as the other alias forms are. 0 when the value is not that shape.
resolveAppliedMemberAlias: function {
    st: zenv.ZSymbolTable
    ast: Ast
    scope: ztypes.declid
    declId: ztypes.declid
} out ztypes.tid is {
    vid: zast.nodeid
    nm: zast.nameid
    {
        decl: st.typing.decls.get i: declId
        nm = decl.name
        if decl.kind.reexportDecl then {
            nop: ast.nodes.get i: decl.node
            if nop.namedoperation then {
                vn: ast.nodes.get i: nop.operation
                if vn.dottedpath then {
                    pn: ast.nodes.get i: vn.parent
                    if pn.call then vid = nop.operation
                }
            }
        }
    }
    if vid.isZero then return ztypes.tid
    if (instantiate.valueAppliesUnitTemplate :st :ast :scope valueNid: vid
    ).not then return ztypes.tid
    rt: (
        typeref.dottedTyperefShell
        :st
        :ast
        unitDecl: (unitRootOfDecl typing: st.typing :declId)
        :scope
        nid: vid
        thisName: ""
    )
    if rt.isZero then return ztypes.tid
    rtid: rt
    st.typing.declSetType :declId typeId: rtid
    ownTid: st.typing.declTypeOf declId: scope
    if ownTid.notZero then {
        st.typing.setMemberType parentTypeId: ownTid nameId: nm childTypeId: rtid
    }
    return rtid
}

# refuseArmAliasPayload -- a definition whose value NAMES AN ARM resolves to the
# arm's own sum, and is emitted as a bare tag. That is right for an arm that
# carries nothing and wrong for one that carries something: `k: U.a` with
# `a: String` yields a tag over a payload no one built, and reading it
# SEGFAULTS. The fold cannot catch this one -- a payload arm has no constant, so
# the fold answers none and the definition falls through to here as an alias.
refuseArmAliasPayload: function {
    # where the refusal is recorded
    st: zenv.ZSymbolTable
    # the tree the definition's value is read from
    ast: Ast.view
    # the definition being resolved
    declId: ztypes.declid
    # what it resolved to: the arm's sum, when its value names an arm
    tid: ztypes.tid
} is {
    if tid.isZero then return
    tt: st.reg.typetypeOf typeId: tid
    isSum: tt.isSum
    if isSum.not then return
    tgt: reexportTargetIdsOf typing: st.typing :ast :declId
    if tgt.defName.isZero then return
    if (memberaccess.armCarriesPayload :st armTid: tid armName: tgt.defName).not then return
    dn: String
    dnode: zast.nodeid
    dr: st.typing.decls.get i: declId
    dn = zast.nameTextCopy :ast ref: dr.name
    dnode = dr.node
    dr.drop
    ar: argRefAt :ast nid: dnode
    an: zast.nameTextAt :ast ref: tgt.defName
    mg: "'\{dn}' names arm '\{an}', which carries a payload -- naming an arm gives its tag, and cannot supply what the arm holds"
    hg: "supply the payload at each use (`\{an} <value>`), or name an arm that carries nothing"
    ng: String
    (
        addErrorWithHint
        :st
        nodeid: ar.nid
        lineno: ar.lineno
        colno: ar.colno
        e: zast.err.typeError
        msg: mg
        note: ng
        hint: hg
        width: dn.length
    )
}

# stampGenericParams -- resolve each recorded generic PARAMETER and record the
# declaration it names on the node that spells it.
#
# A USE goes into toolRefDecl, the channel refDeclOf already falls back to. The
# DECLARATION cannot share it. Spans keys a declaration's row to the node of the
# thing declared, which for `t: anyval.generic` is the dotted path -- and that is
# the very node the `.generic` member row is keyed to. Anything refDeclOf can see
# there answers at both, so go-to-definition on the word `generic` would start
# jumping to the parameter. The declaration's answer goes in genericParamDecl,
# which the editor consults only for a declaration row.
#
# declFindChild, never declIdOfType: a generic parameter's type is minted
# (`newType ... genericParam`) with no declaration, so its type id cannot name
# its own. Silent on a miss, and nothing here reaches the emitter.
stampGenericParams: function {st: zenv.ZSymbolTable ast: Ast} is {
    keys: ListVal zast.nodeid
    for each e: st.walk.bounds.genericParamName.iterateItems loop keys.append e.key
    for each k9: keys loop {
        nm9: zast.nameid
        fr9: ztypes.declid
        {
            no9: st.walk.bounds.genericParamName.get key: k9
            if no9.some then {
                nm9 = no9
            }
            fo9: st.walk.bounds.genericParamScope.get key: k9
            if fo9.some then {
                fr9 = fo9
            }
        }
        if nm9.notZero then {
            d9: st.typing.declFindChild parentDeclId: fr9 nameId: nm9
            if d9.notZero then {
                st.typing.genericParamDecl.set key: k9 value: d9
                # the Decl points at the `t: anyval.generic` arm: its operation
                # is the dotted path, and that path's parent atom spells the
                # bound the hover card reads.
                opNid: zast.nodeid
                boundNid: zast.nodeid
                {
                    dn9: st.typing.decls.get i: d9
                    an9: ast.nodes.get i: dn9.node
                    if an9.namedoperation then {
                        opNid = an9.operation
                        po9: ast.nodes.get i: opNid
                        if po9.dottedpath then {
                            pb9: ast.nodes.get i: po9.parent
                            boundNid = nodeId n: pb9
                        }
                    }
                }
                if boundNid.notZero then st.typing.genericParamBound.set key: k9 value: boundNid
                if k9 != opNid then st.typing.toolRefDecl.set key: k9 value: d9
            }
        }
    }
}

# stampAliasValues -- record, for every alias that resolved, the declaration its
# VALUE node refers to.
#
# A pass rather than a hook, because the two routes an alias resolves by do not
# agree on when its type is known. The eager tier reaches a DOTTED re-export
# through resolveAliasKey and a BARE one through resolveDef -- deliberately, a
# bare target names a sibling of the same unit and resolveDef is what folds it --
# and on that leg the Decl still carries no type when the leg ends. Asking once,
# afterwards, is the only place both are answerable, and it does not care which
# route ran.
#
# An alias that never resolved carries no type and is skipped: there is nothing
# it refers to yet. That is the ordinary demand-mode case for a definition
# nothing reaches.
stampAliasValues: function {st: zenv.ZSymbolTable ast: Ast.view} is {
    units: programUnitDecls :st
    for each ud9: units loop {
        slotCount: st.typing.declChildSlots declId: ud9
        ci9: u64
        for ci9 < slotCount loop {
            cd9: st.typing.declChildAt declId: ud9 index: ci9
            ci9 = ci9 + 1
            if cd9.notZero then {
                isReexport: false
                d9: st.typing.decls.get i: cd9
                if d9.kind.reexportDecl then isReexport = true
                d9.drop
                if isReexport then {
                    t9: st.typing.declTypeOf declId: cd9
                    stampAliasValue :st :ast declId: cd9 tid: t9
                }
            }
        }
    }
}

# stampAliasValue -- an alias's VALUE node references the target's declaration.
#
# An alias is resolved off the Decl tree -- the target is read as a name-id pair
# straight from the def node -- and is never walked as a type-ref, so nothing
# else records that edge. The nodes are in the tree and the tooling finds them,
# but they carry no stamp, which is why `zast.astnode` answered nothing on the RHS
# of `astnode: zast.astnode` while the same path in a parameter type answered fine:
# there the type-ref walk stamps it. Recorded here, where the alias's canonical
# id is already in hand.
stampAliasValue: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    declId: ztypes.declid
    tid: ztypes.tid
} is {
    if tid.isZero then return
    td: templateDeclOf reg: st.reg typing: st.typing :tid
    if td.isZero then return
    # the value node under the alias's `name: value` pair. Both alias forms
    # land one node: the dotted form's path node -- which is the id the member
    # selector is keyed by, not the child atom's -- and the bare form's atom.
    opNid: zast.nodeid
    d: st.typing.decls.get i: declId
    n: ast.nodes.get i: d.node
    if n.namedoperation then opNid = n.operation
    d.drop
    if opNid.isZero then return
    memberaccess.stampRefDecl :st nid: opNid declId: td
}

# aliasTargetTid -- the type a re-export alias stands for, when neither the nested-
# unit scope nor the file-unit index answered. It may be reached through the
# target unit's own root, or be TYPE-ROOTED -- a member of a type rather than of a
# unit -- which rootedOut reports so the caller edges it correctly.
aliasTargetTid: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    adecl: ztypes.declid
    aParent: ztypes.declid
    tuId: zast.nameid
    tnId: zast.nameid
    startTid: ztypes.tid
    rootedOut: ListVal bool
    defNameId: zast.nameid
} out ztypes.tid is {
    typeRooted: false
    atid: startTid
    if atid.isZero then {
        # a type-rooted target (`true: bool.true`): the root names a tagged
        # type, the member one of its value arms -- the alias denotes a VALUE
        # of the root type, so the edge binds the ROOT's tid
        homeName: st.typing.declNameOf declId: (unitRootOfDecl typing: st.typing declId: adecl)
        homeUnit: unitDeclOfNameOrOwn :st :scope nameId: homeName
        rto: walkLookupTyperefById :st :scope :ast unitDecl: homeUnit baseId: tuId
        if rto.none then {
            # a tagged type declared in THIS file is invisible to the typeref
            # walk while resolution runs, so `READY: mode.ready` never reached
            # the arm test below. resolveAtomType is the current-unit-relative
            # resolver that sees it.
            rtb: (
                resolveAtomType
                :st
                :scope
                :ast
                unitDecl: homeUnit
                nameId: tuId
                thisName: ""
            )
            if rtb.notZero then rto = optionval.some rtb
        }
        if rto.some then {
            rtt: st.reg.typetypeOf typeId: rto
            isTag: rtt.isSum
            if isTag then {
                memberDecl: st.typing.declChildOfId parentTypeId: rto nameId: tnId
                if memberDecl.some then {
                    mtt: st.reg.typetypeOf typeId: memberDecl
                    isMem: (
                        (mtt == ztypes.ztypetype.functionType) or
                        (memberIsList :st parentTid: rto nameId: tnId) or
                        (mtt == ztypes.ztypetype.tagType)
                    ).not
                    if isMem then {
                        atid = rto
                        typeRooted = true
                    }
                }
            }
        }
    }
    # a BARE alias (`Text: String`, `tally: u64`): its target resolves
    # current-unit-relative, so it may live in a stdlib unit rather than in
    # the alias's own -- the pair carries this unit only because a bare name
    # has no unit segment. resolveAtomType is that precedence walk.
    if atid.isZero when (aliasIsBareForm :st :ast declId: adecl) then {
        # a ring of bare aliases (`Alpha: Beta` / `Beta: Alpha`) is cut by
        # the guard at the top of this function, which returns silently --
        # the caller then mints a forward shell and the C carries an
        # incomplete type. A ring is caught where the definition resolves
        # (valueHeadIsSelf); one reached here is reported the same way.
        btd: st.typing.declFindChild parentDeclId: aParent nameId: defNameId
        if (st.typing.declIsResolving declId: btd) then {
            reportAliasCycle :st :ast declId: adecl dnode: (st.typing.decls.get i: adecl).node
            rootedOut.append typeRooted
            return ztypes.tid.zero
        }
        homeName: st.typing.declNameOf declId: (unitRootOfDecl typing: st.typing declId: adecl)
        hUnitDecl: unitDeclOfNameOrOwn :st :scope nameId: homeName
        # a name that resolves nowhere is not a forward reference: resolving it
        # would mint a shell of that name, and every use would then report the
        # shell -- "cannot construct 'Nope'" -- instead of the name
        if (
            valuechecks.reportUnknownBareAliasTarget
            :st
            :ast
            :adecl
            unitDecl: hUnitDecl
            nameId: tnId
        ) then {
            rootedOut.append typeRooted
            return ztypes.tid.zero
        }
        st.typing.declSetResolving declId: adecl mark: true
        bat: (
            resolveAtomType
            :st
            :scope
            :ast
            unitDecl: hUnitDecl
            nameId: tnId
            thisName: ""
        )
        st.typing.declSetResolving declId: adecl mark: false
        if bat.notZero then atid = bat
    }
    rootedOut.append typeRooted
    return atid
}

# reportMissingAliasTarget -- a unit-level alias whose target the chase could not
# resolve, when the declarations say the target does not exist: a unit or a sum
# type with no member of that name, or a root that names nothing. A missing
# target is not a transient answer -- declarations are indexed before anything
# resolves -- and without a report every read of the alias typed to nothing and
# reached the emitter. The report is the body's for the same reference, placed
# at the definition.
reportMissingAliasTarget: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    adecl: ztypes.declid
    aParent: ztypes.declid
    target: ztypes.deftarget
} is {
    what: missingAliasTargetKind :st :scope :ast :adecl :aParent :target
    if what == 0 then return
    # the unit the root resolved to, which the note names the file of
    rootU: ztypes.declid
    if what == 1 then rootU = (aliasRootScope :st :scope :ast :aParent nameId: target.unitName
    ).unitDecl
    root: zast.nameTextAt :ast ref: target.unitName
    member: zast.nameTextAt :ast ref: target.defName
    msg: "Unknown reference '\{root}'"
    code: zast.err.badReference
    note: String
    if what == 1 then {
        msg = "unit '\{root}' has no member '\{member}'"
        note = unitFileNote :st :ast unitDecl: rootU
    }
    if what == 2 then msg = "type '\{root}' has no member '\{member}'"
    if what != 3 then code = zast.err.typeError
    at: statics.aliasValueSite :st :ast :adecl
    st.typing.refusedValues.add item: at.nid
    (
        addErrorWithHint
        :st
        nodeid: at.nid
        lineno: at.lineno
        colno: at.colno
        e: code
        :msg
        :note
        hint: "".string
        width: root.length
    )
}

# aliasroot -- what the root of a dotted alias names, as far as a missing target
# is concerned.
aliasroot: record {
    # the unit it names, 0 when it names no unit
    unitDecl: ztypes.declid
    # it is declared in the alias's own scope as neither a unit nor a type
    other: bool
}

# aliasRootScope -- the unit a dotted alias's root names: a subunit of the
# alias's own scope first, as a name written there resolves, then a file unit.
# A root the scope declares as a type is left to the type check; one it declares
# as anything else -- a constant -- is marked `other`.
aliasRootScope: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    aParent: ztypes.declid
    nameId: zast.nameid
} out aliasroot is {
    none: ztypes.declid
    local: st.typing.declFindChild parentDeclId: aParent :nameId
    if local.notZero then {
        localUnit: aliasroot unitDecl: local other: false
        if (declDeclaresUnit typing: st.typing :ast declId: local) then return localUnit
        isType: false
        ld: st.typing.decls.get i: local
        isType = ld.kind.typeDecl
        if isType.not then return (aliasroot unitDecl: none other: true)
        return (aliasroot unitDecl: none other: false)
    }
    if (statics.nameDenotesUnit :st :scope :nameId) then {
        return (aliasroot unitDecl: (unitDeclOfNameOrOwn :st :scope :nameId) other: false)
    }
    return (aliasroot unitDecl: none other: false)
}

# missingAliasTargetKind -- what a dotted alias's target lacks: 1 a unit without
# the member, 2 a type without it (a sum type's arm, any other type's member),
# 3 a root that names nothing, 0 when it is none of those. A bare alias resolves
# elsewhere; a root declared in the alias's own scope as something other than a
# unit -- a constant, whose member reads the value channel reports -- is another
# check's; so is a member that EXISTS on a type that is not a sum (`Point.create`
# is a construction, refused as one); and a target that exists but did not
# resolve is the chase's to explain. A generic parameter's
# marker (`t: anyval.generic`) names no member.
missingAliasTargetKind: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    adecl: ztypes.declid
    aParent: ztypes.declid
    target: ztypes.deftarget
} out u32 is {
    if (aliasIsBareForm :st :ast declId: adecl) then return 0
    # `big: 300.u8` is a suffixed literal, refused where its value is
    if (isNumericLiteralNameAt :ast ref: target.unitName) then return 0
    # `t: anyval.generic` declares a generic parameter: the leaf is a marker
    ar: argRefAt :ast nid: (st.typing.decls.get i: adecl).node
    if ar.operation.isZero then return 0
    if (declare.isBareGenericParam :ast op: (ast.nodes.get i: ar.operation)) then return 0
    root: aliasRootScope :st :scope :ast :aParent nameId: target.unitName
    if root.other then return 0
    rootUnit: root.unitDecl
    if rootUnit.notZero then {
        member: st.typing.declFindChild parentDeclId: rootUnit nameId: target.defName
        if member.notZero then return 0
        return 1
    }
    rootTid: (
        (
            walkLookupTyperefById
            :st
            :scope
            :ast
            unitDecl: (unitRootOfDecl typing: st.typing declId: adecl)
            baseId: target.unitName
        ).or
        d: ztypes.tid.zero
    )
    if rootTid.isZero then return 3
    rt: rootTid
    if (st.typing.declChildOfId parentTypeId: rt nameId: target.defName).some then return 0
    if (typeref.leafNamesNoMember leafId: target.defName) then return 0
    return 2
}

# fileUnitAliasTid -- an alias of a FILE unit (`l: lib1`) is that unit, as an
# alias of a nested one is: its bare value names no member of the unit the
# alias is written in. The unit's type, recorded as the alias's own and as the
# member of its unit; 0 for any other alias.
fileUnitAliasTid: function {st: zenv.ZSymbolTable ast: Ast adecl: ztypes.declid} out ztypes.tid is {
    if (aliasIsBareForm :st :ast declId: adecl).not then return ztypes.tid.zero
    aParent: st.typing.declParentOf declId: adecl
    aNameId: (st.typing.decls.get i: adecl).name
    fu: (
        fileUnitNamedAt
        :st
        scope: aParent
        nameId: (reexportTargetIdsOf typing: st.typing :ast declId: adecl).defName
    )
    if fu.isZero then return ztypes.tid.zero
    fuTid: st.typing.declTypeOf declId: fu
    if fuTid.isZero then return fuTid
    ownTid: st.typing.declTypeOf declId: aParent
    if ownTid.notZero then (
        st.typing.setMemberType
        parentTypeId: ownTid
        nameId: aNameId
        childTypeId: fuTid
    )
    st.typing.declSetType declId: adecl typeId: fuTid
    return fuTid
}

# chase an alias to the declaration it finally names, so callers compare one
# key rather than a chain
resolveAliasKeyIn: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    declId: ztypes.declid
} out ztypes.tid is {
    adecl: declId
    altK: reexportTargetIdsOf typing: st.typing :ast declId: adecl
    if altK.unitName.u32 == 0 then return ztypes.tid.zero
    if (st.typing.declIsResolving declId: adecl) then {
        # re-entered while its target resolves: an alias is a forwarding
        # edge, not a definition with a body. When the target's own id is
        # already minted (a record's shell mints before its members, whose
        # signatures may name the alias again), forward to it; only a target
        # with no id yet is a true cycle.
        return (
            aliasTargetMintedTid
            :st
            :scope
            :ast
            declId: adecl
            nestedNameId: altK.unitName
            defName: altK.defName
        )
    }
    aParent: ztypes.declid
    aNameId: zast.nameid
    ado: st.typing.decls.get i: adecl
    aParent = ado.parent
    aNameId = ado.name
    ado.drop
    if aNameId.isZero then return ztypes.tid.zero
    st.typing.declSetResolving declId: adecl mark: true
    # A subunit of THIS unit is the nearer scope, so it answers before the
    # file-unit index -- the same order a name written inside a namespace takes.
    atid: (
        nestedUnitMemberTid
        :st
        :ast
        ownerDeclId: (aliasTargetOwner :st :ast scopeDeclId: aParent nestedNameId: altK.unitName)
        nestedNameId: altK.unitName
        defName: altK.defName
    )
    hUnitDecl: unitDeclOfNameOrOwn :st :scope nameId: altK.unitName
    if atid.isZero then atid = (
        descendNamedId
        :st
        :scope
        :ast
        unitDecl: hUnitDecl
        nameId: altK.defName
    )
    # a unit INSTANCE's member (`ICell: ic.Cell`): the instance's own copy
    if atid.isZero then atid = (
        unitInstanceMemberNamed
        :st
        :scope
        :ast
        unitDecl: (unitRootOfDecl typing: st.typing declId: adecl)
        qualId: altK.unitName
        memberId: altK.defName
    )
    # a member of a unit an alias names (`lk: c.link` with `c: inner`)
    if atid.isZero then {
        avn: (argRefAt :ast nid: (st.typing.decls.get i: adecl).node).operation
        if avn.notZero then atid = (
            qualifiedMemberTid
            :st
            scope: aParent
            :ast
            qualNid: (statics.dpRefAt :ast nid: avn).parent
            memberId: altK.defName
        )
    }
    st.typing.declSetResolving declId: adecl mark: false
    rootedOut: ListVal bool
    atid = (
        aliasTargetTid
        :st
        :scope
        :ast
        :adecl
        :aParent
        tuId: altK.unitName
        tnId: altK.defName
        startTid: atid
        :rootedOut
        defNameId: altK.defName
    )
    typeRooted: rootedOut.get i: 0
    if atid.isZero then {
        reportMissingAliasTarget :st :scope :ast :adecl :aParent target: altK
        return ztypes.tid.zero
    }
    # the alias is a member of the unit it is WRITTEN in, which is that unit's
    # own id whether it is a file unit or a nested one -- both carry it on the
    # Decl the alias hangs under.
    ownTid: st.typing.declTypeOf declId: aParent
    if ownTid.notZero then {
        st.typing.setMemberType parentTypeId: ownTid nameId: aNameId childTypeId: atid
    }
    st.typing.declSetType declId: adecl typeId: atid
    if typeRooted then {
        # the value alias's own dotted node resolves as a typeref to the
        # root type post-demand (nav from the alias line into the tag type)
        dnid: zast.nodeid
        {
            do8: st.typing.decls.get i: adecl
            defNode: ast.nodes.get i: do8.node
            if defNode.namedoperation then dnid = defNode.operation
        }
        if dnid.notZero then {
            notePendingTyperef :st nid: dnid nameId: altK.unitName
            # the alias resolves in the scope it is written in
            st.walk.resolve.pendingTyperefScope.set key: dnid value: aParent
        }
    }
    return atid
}

# ensureDefGenericParams -- register a generic type definition's parameter names
# against its Decl. `registerGenericParams` runs from the definition resolvers,
# but a def can be marked RESOLVED by a path that never reached one -- the
# descent then short-circuits, and `getOrMintSpec` reads an arity of zero for a
# template that plainly has parameters, which costs it the trie. `addGenericParam`
# already refuses a name it holds, so re-registering is a no-op.
ensureDefGenericParams: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    declId: ztypes.declid
} is {
    if declId.isZero then return
    dnG: zast.nodeid
    dgG: st.typing.decls.get i: declId
    dnG = dgG.node
    dgG.drop
    if dnG.isZero then return
    bmG: ast.nodes.get i: dnG
    if bmG.namedoperation then {
        odG: ast.nodes.get i: bmG.operation
        if odG.objectdef when (zast.itemsHaveGenericParam :ast items: odG.asItems) then {
            declare.registerGenericParams :st :ast tdecl: declId items: odG.asItems
        }
    }
}

# resolve a dotted name one segment at a time from `scope`, answering the
# type it lands on
descendNamed: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    name: StringView
} out ztypes.tid is {
    nid: nameIdOf :ast :name
    return (descendNamedId :st :scope :ast :unitDecl nameId: nid)
}

# descendNamedId -- descendNamed by the name's id: one lookup where the text
# form found the id three times over, the spelling copied only where the
# definition is declared or resolved under it.
descendNamedId: function {
    # the symbol table the definition is resolved into
    st: zenv.ZSymbolTable
    # the tree the definition is read from
    ast: Ast
    # the unit the name is a member of
    unitDecl: ztypes.declid
    # the scope the descent starts from
    scope: ztypes.declid
    # the member's name, interned
    nameId: zast.nameid
} out ztypes.tid is {
    # `unitDecl.name` resolves in unitDecl's scope, whatever asked for it
    ddec: declOfUnitDef :st :scope :unitDecl :nameId
    rf: scope
    if ddec.notZero then rf = st.typing.declParentOf declId: ddec
    if st.walk.defNodeIndexBuilt.not then return ztypes.tid.zero
    if unitDecl == st.typing.coreUnitRoot then return ztypes.tid.zero
    # a CONSTANT declares itself when it is read: its type is the one its value
    # carries, so a target that has not folded yet has nothing to answer with
    if ddec.notZero then {
        dcC: false
        ddo: st.typing.decls.get i: ddec
        if ddo.kind.constDecl or ddo.kind.staticListDecl when ddo.typeId.isZero then dcC = true
        isConst: ddo.kind.constDecl
        ddo.drop
        if dcC then statics.constFoldDecl :st :ast declId: ddec
        # a definition that instantiates a generic (`F2: (fx n: 2)`) names that
        # instance, a type, once folded -- reached through its unit's path as
        # through its bare name
        if isConst when (declNamesInstantiation :st :ast declId: ddec) then {
            return (st.typing.declTypeOf declId: ddec)
        }
    }
    tto: optionval.none ztypes.ztypetype
    if ddec.notZero then tto = declDefTypetype :st :ast declId: ddec
    ttv: ztypes.ztypetype.nullType
    classified: false
    if tto.some then {
        ttv = tto
        classified = true
    }
    tid: ztypes.tid
    if classified then {
        tid = (
            declareCanonicalTypeId
            :st
            scope: rf
            :ast
            :unitDecl
            ownerNameId: zast.nameid
            :nameId
            typetype: ttv
        )
    }
    if classified.not then {
        alo: resolveAliasKey :st :ast declId: ddec
        if alo.notZero then return alo
    }
    ddecl: declOfUnitDef :st scope: rf :unitDecl :nameId
    if (defWasResolved :st scope: rf :unitDecl :nameId) then {
        # already resolved -- but not necessarily by a path that registered the
        # generic parameters, and the spec trie cannot key a template whose
        # arity reads as zero.
        ensureDefGenericParams :st :ast declId: ddecl
        return (resolvedDescentTid :st :ast :unitDecl :nameId :classified :tid)
    }
    if (st.typing.declIsResolving declId: ddecl) then {
        # A grey hit is a back-edge, and the early return below is what stops
        # the descent going round again: it uses the forward-decl id rather
        # than re-entering resolveDef. Whether that back-edge is an ERROR is a
        # narrower question.
        #
        # Reference-kind targets (UNION/CLASS -- boxed) are legal forward
        # declarations; a VALUE-kind target reached through a containment edge
        # cannot lay out -- but only when the target is on the containment
        # PATH. Grey alone says the resolution walk is inside it, and that walk
        # gets into a type through method signatures, return types and tag
        # accessors, none of which force a layout.
        if st.mode.inContainmentEdge when (st.typing.declIsOnContainmentPath declId: ddecl) then {
            cycV: (
                (ttv == ztypes.ztypetype.recordType) or
                (
                    ttv == ztypes.ztypetype.variantType
                )
            )
            # a NATIVE record (a scalar: `u8: record is native`) lays out
            # nothing of its own and can hold nothing by value: reaching it
            # grey through a containment edge (a conversion of another scalar
            # returning `(resultval t: u8 ...)` while u8's own methods
            # resolve) is a back-edge to a leaf, not a layout cycle
            if cycV when (declDefIsNative :st :ast declId: ddecl) then cycV = false
            if cycV then {
                name: zast.nameTextAt :ast ref: nameId
                cem: "containment cycle: value type '\{(bodies.unitNameTextOf
                    :st
                    :ast
                    :unitDecl
                )}.\{name}' contains itself by value; box the field behind a class, union, or Option"
                declare.addResolveError :st e: zast.err.typeError msg: cem
            }
        }
        return tid
    }
    if ddec.isZero then return tid
    dnode: zast.nodeid
    dgo: st.typing.decls.get i: ddec
    dnode = dgo.node
    dgo.drop
    if dnode.isZero then return tid
    bmr: argRefAt :ast nid: dnode
    if bmr.nid.notZero then {
        # the definition resolves under its spelling: copied once, here
        nTd: zast.nameTextCopy :ast ref: nameId
        resolveDef :st scope: rf :ast :unitDecl defName: nTd.stringView defnId: bmr.operation
    }
    return (resolvedDescentTid :st :ast :unitDecl :nameId :classified :tid)
}

# resolvedDescentTid -- what a descent answers once the definition is resolved,
# by this descent or an earlier one: the canonical type it declares, or -- for a
# definition that mints none (a unit template, a namespace, a re-export) -- the
# unit's child of that name.
resolvedDescentTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    nameId: zast.nameid
    # whether the definition declares a canonical type, and that type
    classified: bool
    tid: ztypes.tid
} out ztypes.tid is {
    if classified then return tid
    return ((resolveUnitChild :st :ast :unitDecl :nameId).or d: ztypes.tid.zero)
}

# resolveDottedDef -- a unit-level definition whose value is a dotted path is the
# ALIAS form (`astnode: zast.astnode`): the name it binds stands for what the path names,
# so the alias edge is recorded rather than a fresh type minted.
resolveDottedDef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    rf: ztypes.declid
    defName: StringView
    defn: dpref
} is {
    # A unit-level type alias (`astnode: zast.astnode`): resolve the cross-unit dotted
    # ref to a (shell) type id and register it under the unit's name, so bare-alias
    # return types and value uses resolve. Replicates resolveTyperefShell's
    # cross-unit leg.
    apId: atomNameId :ast n: (ast.nodes.get i: defn.parent)
    if (statics.nameDenotesUnit :st scope: rf nameId: apId) then {
        acId: atomNameId :ast n: (ast.nodes.get i: defn.child)
        demandUnitMember :st unitNameId: apId nameId: acId
        # The alias target is read off the re-export Decl's node on demand
        # (reexportTargetIdsOf); resolution reuses the target's canonical id.
        if (
            st.typing.declIsResolving
            declId: (
                declOfUnitDef
                :st
                scope: rf
                unitDecl: (unitDeclOfNameOrOwn :st scope: rf nameId: apId)
                nameId: acId
            )
        ) then {
            # a ring through a unit's name, caught where the definition resolves
            # (valueHeadIsSelf); one reached here is reported the same way
            ad: st.typing.declFindChild parentDeclId: rf nameId: (nameIdOf :ast name: defName)
            if ad.notZero then (
                reportAliasCycle
                :st
                :ast
                declId: ad
                dnode: (st.typing.decls.get i: ad).node
            )
        }
        udA: unitDeclOfNameOrOwn :st scope: rf nameId: apId
        descendNamedId :st scope: rf :ast unitDecl: udA nameId: acId
        udB: unitDeclOfName typing: st.typing nameId: apId
        tgo: resolvedByIds :st :ast unitDecl: udB name: acId
        aid: ztypes.tid
        match (
            tgo
        ) case some then {
            aid = tgo
        } case none then {
            aid = (
                resolveAtomType
                :st
                scope: rf
                :ast
                :unitDecl
                nameId: acId
                thisName: ""
            )
        }
        sda: aid
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: defn.nid tid: sda
        # a cross-unit `unit.Type` alias records its target's declaration
        # for go-to-definition (dotted node; see the type-position stamp)
        targetDecl: templateDeclOf reg: st.reg typing: st.typing tid: sda
        memberaccess.stampRefDecl :st nid: defn.nid declId: targetDecl
    }
}

# resolveDef -- dispatch a main-unit definition by kind. Resolves functions,
# lists, records, variants, unions, classes, facets and protocols. Enums and
# generics arrive in later slices.
resolveDef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    defnId: zast.nodeid
} is {
    # a definition resolves in the scope it is written in, whatever path
    # asked for it. A definition the name index cannot place keeps the
    # caller's scope (a nested unit's member reached from its own unit walk).
    defNameId: nameIdOf :ast name: defName
    resolvedDecl: declOfUnitDef :st :scope :unitDecl nameId: defNameId
    # every resolver funnels through here, so this is where a unit is first
    # reached: before its first definition resolves
    ehd: resolvedDecl
    if ehd.isZero then ehd = scope
    markUnitReached :st declId: ehd
    rf: scope
    if resolvedDecl.notZero then rf = st.typing.declParentOf declId: resolvedDecl
    # a definition that declares a unit -- an inline namespace, a hidden
    # subunit, a template -- resolves as the unit it is, which the demand path
    # does. The dispatch below has no leg for one, and its resolved mark left the
    # unit typeless for good: the demand path then skipped it as done. A
    # constant fold reaching `impl.Foo` or `lib.ic` through the descent gets
    # here first.
    if resolvedDecl.notZero when (zast.unitOpHasBody :ast opId: defnId) then {
        resolveDemandedDecl :st :ast declId: resolvedDecl
        return
    }
    enterUnitOnce :st :ast :unitDecl
    # a definition's BODY reaches names its signature does not: a type
    # constructed, or a sibling function called, only inside it must be demanded
    # or it never resolves -- and the body walk then reports a perfectly valid
    # reference as unknown. It goes HERE because every resolver funnels through
    # resolveDef: the demand drain, the descent, and the implementation pass. The
    # scan only queues declarations that are not yet pending, resolving or
    # resolved, so a repeat visit costs a walk and queues nothing.
    scanDefCalls :st scope: rf :ast op: (ast.nodes.get i: defnId)
    st.typing.declSetResolving declId: resolvedDecl mark: true
    # A containment edge is ONE hop: this def's own resolution starts a
    # fresh context (its field/arm legs re-arm the flag), so an outer field
    # bracket never taints nested param/return resolution.
    savedMode: st.mode
    st.mode.inContainmentEdge = false
    arm: declare.rowArmAt :ast nid: defnId
    match (
        arm
    ) case functiondef then {
        fid: (
            declare.resolveFunction
            :st
            scope: rf
            :ast
            :unitDecl
            ownerNameId: zast.nameid
            :defName
            fnId: defnId
            thisName: ""
            skipThisType: false
        )
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: defnId tid: fid
    } case listblock then {
        # a list is a constant: folding it registers its type, its value's
        ld: st.typing.declFindChild parentDeclId: rf nameId: defNameId
        statics.constFoldDecl :ast :st declId: ld
        dbt: st.typing.declTypeOf declId: ld
        if dbt.notZero then ztyping.nodeTypeSet tbl: st.typing.nodeType nid: defnId tid: dbt
    } case objectdef then {
        orf: declare.objRefAt :ast nid: defnId
        declare.resolveObjectDef :st :ast :unitDecl :rf :defName nameId: defNameId defn: orf
    } case dottedpath then {
        ddr: statics.dpRefAt :ast nid: defnId
        resolveDottedDef :st :ast :unitDecl :rf :defName defn: ddr
    } case atomid then {
        # a bare name (`Text: String`, `n: LIMIT`) resolves as its use would:
        # a constant folds, an alias chases its target, and a target nothing
        # declares is reported here, where it is written. The chase keeps its
        # own resolving mark, and reads this one as a cycle
        if (aliasIsBareForm :st :ast declId: resolvedDecl) then {
            st.typing.declSetResolving declId: resolvedDecl mark: false
            resolveAliasKey :st :ast declId: resolvedDecl
        }
    } else null
    # Unit -> def childOf edges are built at mint (declareCanonicalType) for real
    # defs and on demand (resolvedByIds' alias-follow) for aliases; no tail pass.
    st.mode = savedMode
    defDecl: declOfUnitDef :st scope: rf :unitDecl nameId: (nameIdOf :ast name: defName)
    st.typing.declSetResolving declId: defDecl mark: false
    if defDecl.notZero then {
        st.typing.declSetResolved declId: defDecl
    }
}

# resolveUnitBody -- resolve every top-level definition signature in a unit.
# resolveUnitBody -- resolve a unit's definition signatures. Signature-only
# resolves every member; the full body-walk mode mirrors check()'s eager set
# (functions and units only -- other definitions resolve on demand, so unused
# main-unit records/classes/unions drop out of the full dump).
resolveUnitBody: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    unitdefId: zast.nodeid
    rootOnly: bool
} is {
    # a FILE unit is the one unit whose owner is looked up by name: nothing
    # holds its Decl the way an enclosing walk holds a nested unit's.
    # registerUnitRoots and indexUnitDefs both ran already, so both are there.
    ubPt: ztypes.tid
    ubPd: ztypes.declid
    {
        uo: st.typing.declTypeOf declId: unitDecl
        if uo.notZero then {
            ubPt = uo
        }
    }
    ro: unitDecl
    if ro.notZero then ubPd = ro
    (
        resolveUnitMembers
        :st
        :ast
        :unitDecl
        ownerDeclId: ubPd
        ownerTid: ubPt
        unitOpId: unitdefId
        speculative: true
        :rootOnly
    )
}

# registerUnitRoots -- register a UNIT type for EVERY unit up front, before
# indexUnitDefs and demand resolution, so childOf-at-mint
# (declareCanonicalType) always sees a populated unit root. indexUnitDefs binds
# each type to the unit's Decl, keyed on the unitdef NODE -- by then the name
# would find that very Decl. The main unit precedes its deps in unit order, so a
# cross-unit qualified type ref (zlexer.token) sees the dep as a unit; a member
# path types its base as the UNIT type through the program root's child of that
# name -- never the resolution chain, where a main unit sharing a type's name
# (str.z, panic.z) would shadow it.
registerUnitRoots: function {st: zenv.ZSymbolTable program: Ast.view} is {
    {
        # a unit name is one identity: the second file to claim it is
        # rejected here, before any type is minted, so the program root
        # holds one child per name and declFindChild there is unambiguous.
        # Keyed by name-pool id -- the pool interns, so id equality is text
        # equality and no spelling is compared.
        seenUnits: IdSet zast.nameid
        for each ruId: program.units loop {
            registerOneUnitRoot :st :program :ruId :seenUnits
        }
    }
}

# registerOneUnitRoot -- mint the unit type of the file unit `ruId` (its
# namedoperation) and key it on the unitdef node; a name `seenUnits` already
# holds is a duplicate unit, rejected here.
registerOneUnitRoot: function {
    st: zenv.ZSymbolTable
    program: Ast.view
    ruId: zast.nodeid
    seenUnits: IdSet zast.nameid
} is {
    opId: zast.nodeid
    nmNode: String
    nmRef: zast.nameid
    uNode: zast.nodeid
    uLine: u32
    uCol: u32
    {
        ru: program.nodes.get i: ruId
        if ru.namedoperation then {
            nm: zast.poolTextAt pool: program.names ref: ru.name
            opId = ru.operation
            nmNode = nm.copy
            nmRef = ru.name
            uNode = ru.nodeid
            uLine = ru.lineno
            uCol = ru.colno
        }
    }
    if opId.isZero then return
    if (seenUnits.has item: nmRef) then {
        dupm: "duplicate unit '\{nmNode}': a unit name is one identity, and another file already declares it"
        (
            declare.addResolveErrorAt
            :st
            nodeid: uNode
            lineno: uLine
            colno: uCol
            e: zast.err.duplicateDef
            msg: dupm
            width: nmNode.length
        )
        return
    }
    seenUnits.add item: nmRef
    uid: st.reg.newType name: nmNode.stringView typetype: ztypes.ztypetype.unitType
    # a file unit whose body declares a generic parameter is a template, as a
    # nested `unit as` is
    if (zast.unitIsGeneric ast: program unitId: opId) then {
        st.reg.setGeneric typeId: uid value: true
    }
    opid: unitdefNodeId ast: program nId: opId
    st.typing.unitTypesById.set key: opid value: uid
}

# demandAllUnitDefs -- demand every top-level definition of a unit (the
# eager mode: a definition nothing references is still resolved, so an error
# inside it is reported).
demandAllUnitDefs: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitNameId: zast.nameid
    unitdefId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    for each memberId: (zast.kidsOf :ast span: bodyIds) loop {
        bm: ast.nodes.get i: memberId
        if bm.namedoperation then {
            demandUnitMember :st :unitNameId nameId: bm.name
        }
    }
}

# demandAllDefs -- demand every top-level definition of EVERY unit, or of the
# main unit alone under checkreach.mainUnit. Without it a definition nothing
# references is never resolved, so an error inside it is reported by nothing.
demandAllDefs: function {st: zenv.ZSymbolTable program: Ast.view} is {
    if st.typing.mainUnitAll then {
        for each dmId: program.units loop {
            dmn: program.nodes.get i: dmId
            if dmn.namedoperation when dmn.name == st.reg.regMainUnitId then {
                demandAllUnitDefs :st ast: program unitNameId: dmn.name unitdefId: dmn.operation
            }
        }
        return
    }
    if st.typing.eagerAll.not then return
    {
        for each duId: program.units loop {
            duOp: zast.nodeid
            duNm: zast.nameid
            dun: program.nodes.get i: duId
            if dun.namedoperation then {
                duOp = dun.operation
                duNm = dun.name
            }
            if duOp.notZero then {
                demandAllUnitDefs :st ast: program unitNameId: duNm unitdefId: duOp
            }
        }
    }
}

# register and resolve the program's main unit.
registerAndResolveMain: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    program: Ast
} is {
    {
        unitDecl: st.typing.mainUnitRoot
        # Pass 1 (unit-root minting) is registerUnitRoots, run before indexUnitDefs.
        # Pass 2: resolve EVERY file unit's definition signatures (main + deps
        # like zlexer/zast/zvfs), so cross-unit type refs resolve to the dep's
        # own type and the dep's type/fn def nodes get stamped for emission.
        unitCount: program.units.length
        # every unit's own generic parameters, before any body resolves: an
        # eagerly-resolved unit can instantiate a unit later in the order
        gpI: u64
        for gpI < unitCount loop {
            gpU: program.nodes.get i: (program.units.get i: gpI)
            gpI = gpI + 1
            if gpU.namedoperation when gpU.operation.notZero then {
                (
                    declare.registerUnitGenericParams
                    :st
                    :scope
                    ast: program
                    unitDecl: (unitDeclOfNameOrOwn :st :scope nameId: gpU.name)
                    unitdefId: gpU.operation
                )
            }
        }
        unitIdx: u64
        for unitIdx < unitCount loop {
            muId: program.units.get i: unitIdx
            unitIdx = unitIdx + 1
            opId: zast.nodeid
            nmId: zast.nameid
            mu: program.nodes.get i: muId
            if mu.namedoperation then {
                opId = mu.operation
                nmId = mu.name
            }
            if opId.notZero then {
                unitOfName: unitDeclOfNameOrOwn :st :scope nameId: nmId
                # only the main unit's body is eagerly resolved
                eager: unitOfName == unitDecl
                if eager then {
                    # read before the call: `.not` is a receiver call on the
                    # field, and `st` is lent to the same call
                    rootOnly: st.typing.eagerAll.not
                    (
                        resolveUnitBody
                        :st
                        ast: program
                        unitDecl: unitOfName
                        unitdefId: opId
                        :rootOnly
                    )
                }
            }
        }
    }
}

# isImplementationMarker -- true when an as-item operation declares an
# implementation: `r: Reader.implement`, through a unit or a type application
# alike.
# An opt-out (`==: null`) and a numeric constant (`version: 1`) are atoms that
# name no type, so they declare nothing.
isImplementationMarker: function {ast: Ast.view op: astnode.view} out bool is {
    match (
        op
    ) case dottedpath then {
        return (zast.markerKindOfLeaf :ast leaf: op.child).implementMarker
    } else {
        return false
    }
}

# declaresImplementation -- true when an objectdef declares implementation via an as-item.
declaresImplementation: function {ast: Ast.view op: astnode.view} out bool is {
    match (
        op
    ) case objectdef then {
        for each cmId: (zast.kidsOf :ast span: op.asItems) loop {
            cm: ast.nodes.get i: cmId
            if cm.namedoperation when (
                isImplementationMarker
                :ast
                op: (ast.nodes.get i: cm.operation)
            ) then return true
        }
        return false
    } else {
        return false
    }
}

# enterUnitOnce -- a dependency unit's one-time pass, the first time any of
# its definitions resolves, whoever resolves it: demand the implementation
# declarers reference-following cannot reach (zvfs FSProvider) and the return
# / never the walk of its bodies uses. Not a property of the unit's NAME: a
# implementer is as unreachable in a user dependency as it is in collections.
# Queued, not resolved here: this runs inside whatever resolution reached the
# unit first, and the drain resolves them at the top level.
enterUnitOnce: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
} is {
    if unitDecl == st.typing.coreUnitRoot then return
    if unitDecl.isZero then return
    if (st.walk.resolve.enteredUnits.has item: unitDecl) then return
    st.walk.resolve.enteredUnits.add item: unitDecl
    if unitDecl == st.typing.mainUnitRoot then return
    ro: unitDecl
    if ro.notZero then {
        uop: zast.nodeid
        rdo: st.typing.decls.get i: ro
        unop: ast.nodes.get i: rdo.node
        if unop.namedoperation then uop = unop.operation
        rdo.drop
        if uop.notZero then {
            bodyIds: zast.unitBodyIdsAt :ast unitId: uop
            for each bm: (zast.kidsOf :ast span: bodyIds) loop {
                bmNode: ast.nodes.get i: bm
                if bmNode.namedoperation then {
                    hDeclId: st.typing.declFindChild parentDeclId: ro nameId: bmNode.name
                    if (declaresImplementation :ast op: (ast.nodes.get i: bmNode.operation)) then (
                        demandDecl
                        :st
                        declId: hDeclId
                    )
                }
            }
        }
    }
    demandReturnNever :st
}

# stampCtorDefaults -- a construction fills unprovided defaulted fields: the
# default's node stamps its resolved member/parent type, once the owner has
# actually been constructed (during the body walk).
stampCtorDefaults: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
} is {
    dnids: ListVal zast.nodeid
    owners: ListVal ztypes.tid
    for each de: st.walk.pendingDefault.owner.iterateItems loop {
        dk: de.key
        dnids.append dk
        dv: de.value
        owners.append dv
    }
    di: u64
    dn: dnids.length
    for di < dn loop {
        ow: owners.get i: di
        cgot: st.walk.consts.constructedTypes.get key: ow
        isCon: cgot.or d: false
        if isCon then {
            nd: dnids.get i: di
            ido: st.walk.pendingDefault.id.get key: nd
            idv: ido.or d: ztypes.tid.zero
            if idv.notZero then {
                nd2: dnids.get i: di
                ztyping.nodeTypeSet tbl: st.typing.nodeType nid: nd2 tid: idv
            } else {
                nd3: dnids.get i: di
                ngId: zast.nameid
                ngo: st.walk.pendingDefault.name.get key: nd3
                if ngo.some then {
                    ngId = ngo
                }
                if ngId.notZero then {
                    nrt: (
                        (walkLookupTyperefById :st :scope :ast :unitDecl baseId: ngId).or
                        d: ztypes.tid.zero
                    )
                    if nrt.notZero then {
                        nd4: dnids.get i: di
                        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: nd4 tid: nrt
                    }
                }
            }
        }
        di = di + 1
    }
}

# unitHasObjectMethodBody -- true when a unit body holds an objectdef with a method-body.
unitHasObjectMethodBody: function {ast: Ast.view defId: zast.nodeid} out bool is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: defId
    for each bm: (zast.kidsOf :ast span: bodyIds) loop {
        bmNode: ast.nodes.get i: bm
        if bmNode.namedoperation when (
            bodies.objectdefHasMethodBodies
            :ast
            op: (ast.nodes.get i: bmNode.operation)
        ) then return true
    }
    return false
}

# demandChildDecls -- demand every declaration `declId` holds, as uses of each
# would: a check of the main unit's own declarations reaching a namespace
demandChildDecls: function {st: zenv.ZSymbolTable declId: ztypes.declid} is {
    n: st.typing.declChildSlots :declId
    i: u64
    for i < n loop {
        did: st.typing.declChildAt :declId index: i
        i = i + 1
        if did.notZero then demandDecl :st declId: did
    }
}

# demandDecl -- a reference found this declaration: queue it for resolution
# unless it is resolved, mid-resolution, already queued, or a prelude
# re-export already followed to its target. The mark lives on the
# declaration, so the walk that finds a definition also finds its state.
demandDecl: function {st: zenv.ZSymbolTable declId: ztypes.declid} is {
    if (st.typing.declIsPending :declId) then return
    if (st.typing.declIsResolving :declId) then return
    if (st.typing.declIsResolved :declId) then return
    decl: st.typing.decls.get i: declId
    if decl.parent == st.typing.coreUnitRoot when decl.typeId.notZero then return
    decl.drop
    st.typing.declSetPending :declId mark: true
    st.walk.resolve.pendingDefs.append from: declId
}

# demandDefinition -- a bare name written in `scope` demands the definition
# the environment walk finds for it, if any: a local variable, a member, or
# an unknown name finds nothing and demands nothing.
demandDefinition: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    nameId: zast.nameid
} is {
    hit: envLookup :st :scope :nameId
    if hit.declId.notZero then demandDecl :st declId: hit.declId
}

# demandUnitMember -- a qualified `unit.member` demands exactly that unit's
# member; the chain is not walked. A name the unit does not define directly
# may be an exported alias (`perimeter: perimImpl`), whose edge hangs under
# the unit's public block.
demandUnitMember: function {
    st: zenv.ZSymbolTable
    unitNameId: zast.nameid
    nameId: zast.nameid
} is {
    ro: st.typing.declFindChild parentDeclId: st.typing.programRoot nameId: unitNameId
    if ro.notZero then {
        d: st.typing.declFindChild parentDeclId: ro :nameId
        if d.notZero then {
            demandDecl :st declId: d
            return
        }
        pub: st.typing.declPublicNsOf owner: ro
        if pub.notZero then {
            e: st.typing.declFindChild parentDeclId: pub :nameId
            if e.notZero then {
                # a definition the block itself makes resolves with the
                # block, a nested unit (its constants key on the block's
                # id); an edge names a sibling of the unit, demanded as such
                ep: st.typing.declParentOf declId: e
                if ep == pub then {
                    demandDecl :st declId: pub
                } else {
                    demandDecl :st declId: e
                }
            }
        }
    }
}

# markUnitReached -- the FIRST declaration demanded from a unit marks the unit
# reached (unitsReached), which the C backend reads for what a reached unit
# needs of its toolchain: a requirement in its implementation file applies
# only to a program that reaches the unit.
markUnitReached: function {st: zenv.ZSymbolTable declId: ztypes.declid} is {
    own: memberaccess.owningUnitDecl :st :declId
    if own.isZero then return
    st.typing.unitsReached.add item: own
}

# resolveDemandedReexport -- a re-export is a definition like any other, and
# resolving it means FOLLOWING its target. Without this a re-export of a re-export
# stops at the first hop: the second alias is demanded, resolveDef has no leg for
# a bare dotted alias, and the chain ends there.
resolveDemandedReexport: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rf: ztypes.declid
    declId: ztypes.declid
    puDecl: ztypes.declid
    defNameText: StringView
    opId: zast.nodeid
} is {
    # A re-export is a definition like any other, and resolving it means
    # following its target -- which is what resolveAliasKey does, from the
    # declaration. Without this a re-export of a re-export stops at the
    # first hop: the second alias is demanded, resolveDef has no leg for a
    # dotted target that names a NESTED unit, and the chain reads as a
    # member the parent does not have.
    isRx: false
    rdo: st.typing.decls.get i: declId
    if rdo.kind.reexportDecl then isRx = true
    rdo.drop
    if isRx then {
        resolveAliasKey :st :ast :declId
    } else {
        resolveDef :st scope: rf :ast unitDecl: puDecl defName: defNameText defnId: opId
    }
    # A unit-level CONSTANT is a definition like any other, and resolveDef
    # has no leg for the shapes one takes -- a bare literal, a suffixed
    # one, a constant expression. Its type and its value are registered
    # here, where the demanding reference is asking. The eager tier
    # walks every definition of every unit instead, so exactly one of the
    # two speaks.
    if st.typing.eagerAll then return
    (
        statics.resolveConstantMember
        :st
        scope: rf
        :ast
        unitDecl: puDecl
        defName: defNameText
        defnId: opId
    )
}

# resolveDemandedNamespace -- a demanded `unit { … }` resolves as the namespace it
# is. A DEMAND for one has to reach the same door the enclosing walk does, or its
# members never resolve.
resolveDemandedNamespace: function {
    st: zenv.ZSymbolTable
    ast: Ast
    declId: ztypes.declid
    dParent: ztypes.declid
    puDecl: ztypes.declid
    puNm: zast.nameid
    defNameText: StringView
    opId: zast.nodeid
} is {
    # A unit is RESOLVED when its unitdef node carries an id; the DEFINED
    # mark on its Decl answers a different question and can be laid by a
    # path that never resolved it as a unit. So the mark does not gate this
    # leg -- only the resolution itself is skipped when the unit is already
    # built, and the debts below are owed however it got there.
    alreadyU: false
    unid: unitdefNodeId :ast nId: opId
    unT: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: unid
    if unid.notZero when unT.notZero then alreadyU = true
    if alreadyU.not then {
        # edged under the declaration it is written in: the file unit, a
        # namespace, or a template
        parentTid: st.typing.declTypeOf declId: dParent
        (
            resolveNamespaceUnit
            :st
            :ast
            unitDecl: puDecl
            defName: defNameText
            :parentTid
            parentDeclId: dParent
            unitOpId: opId
        )
    }
    st.typing.declSetResolved :declId
    # its constants, as the enclosing unit's walk resolves a namespace that
    # was already built when it ran: a unit materialised on demand -- a hidden
    # subunit, first named from a body -- came after that walk, and its
    # members were marked defined with no constant ever resolved. A use then
    # met a value that typed to nothing, and the definition's own failure (a
    # literal beyond i64) read as an unknown reference at the use.
    (
        resolveConstantDefsIn
        :st
        scope: dParent
        :ast
        unitDecl: puDecl
        unitdefId: opId
        ownerDeclId: declId
    )
    # Signatures are resolved; the member bodies are owed a walk, which the
    # top-level drain does.
    st.walk.resolve.nsBodiesOwed.append (ztyping.nsbody unitName: puNm unitOp: opId)
    # The members just resolved recorded their signature type-refs the way
    # every definition does, and a unit materialises at whatever point
    # something first asks for it -- which can be after the post-demand
    # stamp pass. Stamp them here, as the drain stamps what it resolved:
    # unstamped, a re-exported function's return type reads as nothing and
    # its call sites reach the emitter bare.
    stampPendingTyperefs :st :ast unitDecl: st.typing.mainUnitRoot
}

# resolveDemandedDecl -- resolve one demanded declaration now, unless it is
# already resolved or mid-resolution: a prelude re-export follows its alias
# to the target; otherwise the dispatch is the unit sweeps' -- a namespace
# or subunit through resolveNamespaceUnit, a template through
# resolveInlineGenericUnit, every other definition through resolveDef.
resolveDemandedDecl: function {
    st: zenv.ZSymbolTable
    ast: Ast
    declId: ztypes.declid
} is {
    st.typing.declSetPending :declId mark: false
    if (st.typing.declIsResolving :declId) then return
    if (st.typing.declIsResolved :declId) then return
    markUnitReached :st :declId
    # a demanded declaration resolves in the scope it is written in -- its
    # parent -- whatever scope the demand came from
    rf: st.typing.declParentOf :declId
    dName: zast.nameid
    dParent: ztypes.declid
    dNode: zast.nodeid
    dTid: ztypes.tid
    decl: st.typing.decls.get i: declId
    dName = decl.name
    dParent = decl.parent
    dNode = decl.node
    dTid = decl.typeId
    decl.drop
    if (declAtProgramTop typing: st.typing parentDeclId: dParent) then return
    puNm: zast.nameid
    pdo: st.typing.decls.get i: dParent
    puNm = pdo.name
    pdo.drop
    defNameText: zast.nameTextCopy :ast ref: dName
    # the file unit the definition is written in, by id: a namespace may share
    # its name with a top-level unit, which a lookup by name would answer
    puDecl: unitRootOfDecl typing: st.typing declId: dParent
    # a TEMPLATE's member: the template's own resolution minted every method
    # and type (resolveInlineGenericUnit), and its constants resolve together,
    # keyed on the template and evaluated in its rf. Every other member -- a
    # list, a nested unit, an alias -- resolves below in the template's
    # scope, as a namespace's does: the template's own walk reads it, and each
    # instance builds its own from it.
    if (declDeclaresTemplate :st :ast declId: dParent) then {
        if dTid.isZero then {
            resolveTemplateConstants :st scope: rf :ast tmplDeclId: dParent
        }
        if dTid.notZero or (st.typing.declTypeOf :declId).notZero then {
            st.typing.declSetResolved :declId
            return
        }
    }
    if dParent == st.typing.coreUnitRoot then {
        if dTid.isZero then {
            resolveAliasKey :st :ast :declId
        }
        return
    }
    if dNode.isZero then return
    opId: zast.nodeid
    nop: ast.nodes.get i: dNode
    if nop.namedoperation then opId = nop.operation
    if opId.isZero then return
    isNs: zast.unitOpDeclaresUnit :ast :opId
    isTmpl: zast.unitOpKindIs :ast :opId k: zast.unitkind.template
    if isNs then {
        (
            resolveDemandedNamespace
            :st
            :ast
            :declId
            :dParent
            :puDecl
            :puNm
            defNameText: defNameText.stringView
            :opId
        )
    } else if isTmpl then {
        parentTid: st.typing.declTypeOf declId: dParent
        (
            declare.resolveInlineGenericUnit
            :st
            :ast
            unitDecl: puDecl
            defName: defNameText.stringView
            :parentTid
            parentDeclId: dParent
            unitOpId: opId
        )
        st.typing.declSetResolved :declId
    } else if (isUnitOp op: (ast.nodes.get i: opId)) then {
        # an inline `unit { ... }` resolves as the namespace it is. The walk
        # reaches one when it walks the enclosing unit; a DEMAND for one has to
        # reach the same door, or the members never resolve and their
        # constants never fold.
        alreadyI: false
        uni: unitdefNodeId :ast nId: opId
        uniT: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: uni
        if uni.notZero when uniT.notZero then alreadyI = true
        if alreadyI.not then {
            parentTid: st.typing.declTypeOf declId: dParent
            (
                resolveNamespaceUnit
                :st
                :ast
                unitDecl: puDecl
                defName: defNameText.stringView
                :parentTid
                parentDeclId: dParent
                unitOpId: opId
            )
        }
        st.typing.declSetResolved :declId
        return
    } else {
        (
            resolveDemandedReexport
            :st
            :ast
            :rf
            :declId
            :puDecl
            defNameText: defNameText.stringView
            :opId
        )
        # a namespace member resolves alone, wherever a use first names it,
        # and is read at once: its signature's type-refs are stamped now, as
        # a whole namespace's were when it resolved together
        if (declIsNamespace :st :ast declId: dParent) then stampResolvedOnDemand :st :ast
    }
}

# stampResolvedOnDemand -- stamp the type-refs a definition resolved outside a
# drain recorded, as a drain stamps what it resolves: an unstamped signature
# reads its return type as nothing at every call site. Before the type-ref pass
# has run, and inside a drain, the stamping waits for them.
stampResolvedOnDemand: function {st: zenv.ZSymbolTable ast: Ast} is {
    if st.walk.resolve.typerefPassRan.not or st.walk.resolve.drainingDefs then return
    stampPendingTyperefs :st :ast unitDecl: st.typing.mainUnitRoot
}

# resolveDemandedDefs -- resolve every demanded declaration, in discovery
# order, including the ones each resolution demands in turn: a definition's
# body is scanned once its own resolution completes, so a callee is never
# resolved inside its caller's grey window. A drain that is already running
# resolves whatever a nested request queued, so the nested call returns.
resolveDemandedDefs: function {st: zenv.ZSymbolTable ast: Ast} is {
    if st.walk.resolve.drainingDefs then return
    if st.walk.resolve.pendingDefs.length == 0 then return
    st.walk.resolve.drainingDefs = true
    # a drain runs in a neutral resolution context: it may be requested from
    # inside a body walk, whose template / containment state belongs to that
    # body, not to the definitions resolved here (each of which resolves in
    # the scope of its own declaration)
    savedMode: st.mode
    pMs: st.typing.curMonoStamp
    pMf: st.walk.fn.curMonoFnTid
    st.mode.inContainmentEdge = false
    st.mode.genericWalk = false
    st.typing.curMonoStamp = ztypes.tid.zero
    st.walk.fn.curMonoFnTid = ztypes.tid
    i: u64
    for i < st.walk.resolve.pendingDefs.length loop {
        d: st.walk.resolve.pendingDefs.get :i
        i = i + 1
        resolveDemandedDecl :st :ast declId: d
    }
    st.walk.resolve.pendingDefs = ListVal ztypes.declid
    # after the post-demand stamp pass, a drain stamps what it recorded
    if st.walk.resolve.typerefPassRan then {
        stampPendingTyperefs :st :ast unitDecl: st.typing.mainUnitRoot
    }
    st.mode = savedMode
    st.typing.curMonoStamp = pMs
    st.walk.fn.curMonoFnTid = pMf
    st.walk.resolve.drainingDefs = false
}

# scanCallsInNode -- the body-walk pre-pass: every name a subtree references
# demands the definition the scanning unit's environment holds for it, so the
# callee is resolved before the walk runs. A bare callable or atom walks the
# unit's scopes (unit, then prelude); a qualified unit.member goes straight to
# that unit's member; `return` pulls return and never. A local variable or a
# member finds no definition and demands nothing.
scanCallsInNode: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast.view
    node: astnode.view
} is {
    # Four of the twenty arms demand into the unit scope and one arm runs per
    # node, so each binds it itself: hoisting it cost every OTHER arm a lookup
    # it never read. It must be a BINDING, never inline in the demand call --
    # `demandDefinition :st scope: (unitScopeOf :st ...)` lends st twice in one
    # call and is E0200.
    match (
        node
    ) case call then {
        demandCalleeName :st :scope :ast calleeId: node.callable
        # the callee then the arguments, which is childIds' order for a call,
        # walked through the node's own fields so no list is built for it
        scanCallsAt :st :scope :ast nid: node.callable
        scanCallsInSpan :st :scope :ast span: node.arguments
    } case atomid then {
        # bare body identifiers demand main-unit definitions (unit constants,
        # lists); non-definition names never match a demanded def.
        scN: ast.names.texts.get i: node.name
        if (statics.isNumericLiteralName name: scN.stringView).not then {
            aFr: unitScopeOf typing: st.typing declId: scope
            demandDefinition :st scope: aFr nameId: node.name
        }
    } case statement then {
        # the block shapes descend through their OWN children: the generic arm
        # below builds a list per node visited, and these are most of the nodes
        # there are
        scanCallsInSpan :st :scope :ast span: node.statements
    } case statementline then {
        scanCallsAt :st :scope :ast nid: node.statementline
    } case assignment then {
        scanCallsAt :st :scope :ast nid: node.value
    } case ifexpr then {
        # Deliberately branch-blind. This pass runs before resolveConstantDefs,
        # so no fold exists yet and a dead clause's names are demanded anyway.
        # Over-demanding is CONSERVATIVE, and the invariant it protects is that
        # the constant fold may only ever remove EMISSION -- never change which
        # names resolve, and never be the thing that reports an error from a
        # branch that cannot run. That is why a reached `error` is reported by
        # the evaluator, which visits only the winning branch, and not by a
        # walk like this one, which sees every arm.
        scanCallsInSpan :st :scope :ast span: node.clauses
        scanCallsAt :st :scope :ast nid: node.elseclause
    } case forexpr then {
        demandNever :st :scope
        # conditions, body, postconditions -- childIds' order for a for, walked
        # through the node's own fields. scanCallsAt skips an absent body
        # exactly as childIds omits it.
        scanCallsInSpan :st :scope :ast span: node.conditions
        scanCallsAt :st :scope :ast nid: node.body
        scanCallsInSpan :st :scope :ast span: node.postconditions
    } case doexpr then {
        doFr: demandNever :st :scope
        if (flow.blockHasBreak :ast n: (ast.nodes.get i: node.statement)) then {
            demandDefinition :st scope: doFr nameId: zast.wellKnown.slot.tyOptionval
        }
        scanCallsAt :st :scope :ast nid: node.statement
    } case namedoperation then {
        scanCallsAt :st :scope :ast nid: node.operation
    } case atomstring then {
        scanCallsInSpan :st :scope :ast span: node.stringparts
    } case ifclause then {
        scanCallsInSpan :st :scope :ast span: node.conditions
        scanCallsAt :st :scope :ast nid: node.statement
    } case caseexpr then {
        scanCallsAt :st :scope :ast nid: node.subject
        scanCallsInSpan :st :scope :ast span: node.clauses
        scanCallsAt :st :scope :ast nid: node.elseclause
    } case reassignment then {
        scanCallsAt :st :scope :ast nid: node.topath
        scanCallsAt :st :scope :ast nid: node.value
    } case withexpr then {
        scanCallsAt :st :scope :ast nid: node.value
        scanCallsAt :st :scope :ast nid: node.body
    } case swapstmt then {
        scanCallsAt :st :scope :ast nid: node.lhs
        scanCallsAt :st :scope :ast nid: node.rhs
    } case dottedpath then {
        demandPathNames :st :scope :ast parentId: node.parent childId: node.child
        # the member selector is never a definition to demand
        scanCallsAt :st :scope :ast nid: node.parent
    } case caseclause then {
        # the arm pattern is never a definition to demand
        scanCallsAt :st :scope :ast nid: node.statement
    } case functiondef then null case objectdef then null case unitdef then null case program then null case listblock then null case labelvalue then null else {
        scanCallsIn :st :scope :ast ids: (zast.childIds :ast n: node)
    }
}

# scanCallsInSpan -- scanCallsInNode over every child a span names, without
# building a list to hold them. scanCallsIn is the list-taking twin, for a
# caller that already has one; this is the shape the node walk wants, because a
# walk that materialises a list per NODE allocates one per node.
scanCallsInSpan: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast.view
    span: zast.kidspan
} is {
    for each c: (zast.kidsOf :ast :span) loop {
        scanCallsInNode :st :scope :ast node: (ast.nodes.get i: c)
    }
}

# walk a list of children looking only for calls, which is what seeds the
# demands a lazy walk then satisfies
scanCallsIn: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast.view
    ids: (ListVal zast.nodeid).view
} is {
    for each c: ids loop {
        scanCallsInNode :st :scope :ast node: (ast.nodes.get i: c)
    }
}

# demandCalleeName -- what a CALL demands before its parts are walked. `return`
# is the one callee that demands two things: itself, and the `never` its
# diverging form produces. Every other callee demands the name it spells.
demandCalleeName: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast.view
    calleeId: zast.nodeid
} is {
    nameId: atomNameId :ast n: (ast.nodes.get i: calleeId)
    fr: unitScopeOf typing: st.typing declId: scope
    if nameId == zast.wellKnown.slot.wkReturn then {
        demandDefinition :st scope: fr nameId: zast.wellKnown.slot.wkReturn
        demandSystemNever :st
        return
    }
    if nameId.notZero then demandDefinition :st scope: fr :nameId
}

# demandPathNames -- what a DOTTED PATH demands: the name its root spells, and
# -- when that root names a unit rather than a value -- the member behind the
# dot as well, because `io.stdout` demands exactly that member and nothing else
# in `io`. The selector on a value is a member read and demands nothing.
demandPathNames: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast.view
    parentId: zast.nodeid
    childId: zast.nodeid
} is {
    rootId: atomNameId :ast n: (ast.nodes.get i: parentId)
    bn: zast.nameTextAt :ast ref: rootId
    if bn.length == 0 then return
    fr: unitScopeOf typing: st.typing declId: scope
    demandDefinition :st scope: fr nameId: rootId
    if (statics.nameDenotesUnit :st :scope nameId: rootId).not then return
    membId: atomNameId :ast n: (ast.nodes.get i: childId)
    mn: zast.nameTextAt :ast ref: membId
    if mn.length > 0 then demandUnitMember :st unitNameId: rootId nameId: membId
}

# demandNever -- every loop can end without producing a value, so `never` is
# demanded wherever one appears. Returns the unit scope it demanded into, which
# a `do` loop needs again for its break type.
demandNever: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
} out ztypes.declid is {
    fr: unitScopeOf typing: st.typing declId: scope
    demandSystemNever :st
    return fr
}

# demandSystemNever -- the system unit's `never`, the type a diverging form and an
# ending loop produce. Named by its unit, not looked up where the form is written:
# a `never` the program declares is its own type, demanded only by a use.
demandSystemNever: function {st: zenv.ZSymbolTable} is {
    sysId: zast.wellKnown.slot.unSystem
    demandUnitMember :st unitNameId: sysId nameId: zast.wellKnown.slot.tyNever
}

# scanCallsAt -- scan the node at `nid` for call demands, and nothing at all
# when there is no node there. The id-taking entry: every arm below reaches a
# child by id, and spelling the row read at each of them said nothing.
scanCallsAt: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast.view
    nid: zast.nodeid
} is {
    if nid.notZero then scanCallsInNode :st :scope :ast node: (ast.nodes.get i: nid)
}

# scanDefCalls -- scan a functiondef's body for call demands. A type's method
# bodies are scanned one at a time, when each is walked (checkFunctionBodyIn):
# a method is used per member, and scanning every body when its owner resolved
# demanded whatever an unused method calls.
scanDefCalls: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast.view
    op: astnode.view
} is {
    if op.functiondef then scanCallsAt :st :scope :ast nid: op.body
}

# scanMainBodyCalls -- record call-target demands for every function body in the
# main unit (the body walk reaches them; demand must precede the pass).
scanMainBodyCalls: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    program: Ast.view
    rootOnly: bool
} is {
    {
        unitDecl: st.typing.mainUnitRoot
        for each uId: program.units loop {
            opId: zast.nodeid
            eager: false
            u: program.nodes.get i: uId
            if u.namedoperation then {
                uc1z: unitDeclOfNameOrOwn :st :scope nameId: u.name
                if uc1z == unitDecl then eager = true
                opId = u.operation
            }
            if eager when opId.notZero then {
                scanUnitCalls :st :scope ast: program unitdefId: opId :rootOnly
            }
        }
    }
}

# scanUnitCalls -- scan each function definition's body in a unit for call demands.
scanUnitCalls: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast.view
    unitdefId: zast.nodeid
    rootOnly: bool
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    for each bmId: (zast.kidsOf :ast span: bodyIds) loop {
        bm: ast.nodes.get i: bmId
        if bm.namedoperation then {
            scanIt: true
            if rootOnly when bm.name != zast.wellKnown.slot.wkMain then scanIt = false
            if scanIt then {
                scanDefCalls :st :scope :ast op: (ast.nodes.get i: bm.operation)
            }
        }
    }
}

# demandReturnNever -- the builtins a walked or synthesized body uses without
# naming them in source: system's `return` and its `never` result.
demandReturnNever: function {st: zenv.ZSymbolTable} is {
    sysId: zast.wellKnown.slot.unSystem
    demandUnitMember :st unitNameId: sysId nameId: zast.wellKnown.slot.wkReturn
    demandSystemNever :st
}

# seed the demand set from `main`: the walk resolves only what a reference
# reaches, so something has to name the first thing
seedBodyWalkDemands: function {st: zenv.ZSymbolTable scope: ztypes.declid program: Ast.view} is {
    {
        unitDecl: st.typing.mainUnitRoot
        found: false
        uiter: program.units.iterate
        for uId: uiter loop {
            u: program.nodes.get i: uId
            if u.namedoperation then {
                uc2z: unitDeclOfNameOrOwn :st :scope nameId: u.name
                if uc2z == unitDecl when (unitHasObjectMethodBody ast: program defId: u.operation
                ) then found = true
            }
        }
        if found then demandReturnNever :st
    }
}

# resolveDemands -- resolve everything the program has demanded so far, and
# everything those resolutions demand in turn: the body-walk seeds first, then
# the queue to exhaustion. Each unit's one-time implementation pass runs from the
# drain the first time one of its definitions resolves.
resolveDemands: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    program: Ast
} is {
    seedBodyWalkDemands :st :scope :program
    {
        resolveDemandedDefs :st ast: program
    }
}

# declAtProgramTop -- is this parent id the top of the declaration tree: no
# parent at all, or the program root whose children are the file units? The
# question every walk out of a file unit asks.
declAtProgramTop: function {typing: ztyping.ZTyping.view parentDeclId: ztypes.declid} out bool is {
    return parentDeclId.isZero or (parentDeclId == typing.programRoot)
}

# scanMainForInstantiations -- collect every unit's instantiation requests.
# Its own function scope bounds the program.units iterator so it releases before the
# mono-creation pass (which iterates program.units again).
scanMainForInstantiations: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    program: Ast.view
    reqs: List InstReq
} is {
    {
        uiter: program.units.iterate
        for uId: uiter loop {
            u: program.nodes.get i: uId
            if u.namedoperation then {
                rd: ztypes.declid
                ro: st.typing.declFindChild parentDeclId: st.typing.programRoot nameId: u.name
                if ro.notZero then rd = ro
                (
                    instantiate.collectMainInstantiations
                    :st
                    ast: program
                    o: (program.nodes.get i: u.operation)
                    unitDecl: (unitDeclOfNameOrOwn :st :scope nameId: u.name)
                    scopeDeclId: rd
                    :reqs
                )
            }
        }
    }
}

# isUnitOp -- true when a binding's operation is an inline `unit {...}` definition.
isUnitOp: function {op: astnode.view} out bool is {
    match (
        op
    ) case unitdef then {
        return true
    } else {
        return false
    }
}

# memberIsRestricted -- the two restrictions that hold a definition back, either
# of which is enough. A scope declaration -- a unit or a template -- is exempt
# from both: it is a property of the DECLARATION, not a body, and a nested
# namespace's template is reached through the scope or not at all.
memberIsRestricted: function {
    ast: Ast
    opId: zast.nodeid
    # the definition's name id
    mName: zast.nameid
    speculative: bool
    rootOnly: bool
} out bool is {
    if (isUnitOp op: (ast.nodes.get i: opId)) then return false
    if speculative when (declare.isFunctionDefOp op: (ast.nodes.get i: opId)).not then return true
    if rootOnly when mName != zast.wellKnown.slot.wkMain then return true
    return false
}

# resolveOrdinaryMember -- a unit member that is neither a nested scope nor a
# template: the definition itself, and the alias edge a re-export carries.
resolveOrdinaryMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    ownerDeclId: ztypes.declid
    mName: StringView
    bmNode: argref
    speculative: bool
} is {
    md: st.typing.declFindChild parentDeclId: ownerDeclId nameId: bmNode.name
    # a `public:` block's reference entry (`:x`, `alias: x`) is an edge to a
    # sibling of the enclosing unit, which resolves as that unit's definition,
    # not as a member here
    mdp: st.typing.declParentOf declId: md
    if md.notZero when mdp != ownerDeclId then return
    isRx: false
    isDone: false
    mdo: st.typing.decls.get i: md
    if mdo.kind.reexportDecl then isRx = true
    if mdo.resolved then isDone = true
    mdo.drop
    # A `public:` block's re-export (`Circle: impl.Circle`) is followed when a
    # use reaches it, and not before: following every one when the block
    # resolved demanded each unit a re-export names and minted every type in
    # it, for a program that names one of them
    if isRx when (declIsPublicBlock :st declId: ownerDeclId) when (
        flow.eagerAt
        :st
        declId: ownerDeclId
    ).not then return
    # A re-export whose target is a DOTTED path is resolved by following it,
    # which is resolveAliasKey's job -- resolveDef has no leg for a dotted target
    # naming a NESTED unit, and marking the alias DEFINED after it did nothing is
    # what stopped a re-export of a re-export at its first hop. A bare target
    # (`ECHO: LIB`) names a sibling of this same unit and is an ordinary
    # definition: resolveDef is what FOLDS it, and following it instead leaves
    # the constant unfolded.
    if isRx when (ast.nodes.get i: bmNode.operation).dottedpath then {
        resolveAliasKey :st :ast declId: md
    } else if isDone.not then {
        resolveDef :st :scope :ast :unitDecl defName: mName defnId: bmNode.operation
    }
    # the eager tier reaches a BARE re-export through resolveDef, not
    # resolveAliasKey, so the value node's reference edge is recorded here as
    # well. Both legs, one call: which of the two resolved it is not something
    # the editor's answer should depend on.
    if isRx then {
        rxTid: st.typing.declTypeOf declId: md
        stampAliasValue :st :ast declId: md tid: rxTid
    }
    if md.notZero when speculative.not then {
        st.typing.declSetResolved declId: md
    }
}

# declIsPublicBlock -- the declaration is a unit's `public:` block.
declIsPublicBlock: function {st: zenv.ZSymbolTable.view declId: ztypes.declid} out bool is {
    if declId.isZero then return false
    d: st.typing.decls.get i: declId
    return d.kind.publicNs
}

# resolveUnitMemberAt -- one member of a unit body, dispatched by KIND. A unit
# body that declares a generic param parses as `template`, and only
# resolveInlineGenericUnit marks it generic, registers its params and stamps its
# def node. `--eager` overrides the restrictions.
resolveUnitMemberAt: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    ownerDeclId: ztypes.declid
    ownerTid: ztypes.tid
    memberId: zast.nodeid
    speculative: bool
    rootOnly: bool
} is {
    bmNode: argRefAt :ast nid: memberId
    if bmNode.nid.isZero then return
    mName: zast.nameTextCopy :ast ref: bmNode.name
    if mName.length == 0 then return
    if st.typing.eagerAll.not when (
        memberIsRestricted
        :ast
        opId: bmNode.operation
        mName: bmNode.name
        :speculative
        :rootOnly
    ) then return
    if (zast.unitOpKindIs :ast opId: bmNode.operation k: zast.unitkind.template) then {
        # the template is a child of THIS unit: the mint funnel reaches the
        # enclosing owner through the scope
        (
            declare.resolveInlineGenericUnit
            :st
            :ast
            :unitDecl
            defName: mName.stringView
            parentTid: ownerTid
            parentDeclId: ownerDeclId
            unitOpId: bmNode.operation
        )
        return
    }
    if (isUnitOp op: (ast.nodes.get i: bmNode.operation)) then {
        (
            resolveNamespaceUnit
            :st
            :ast
            :unitDecl
            defName: mName.stringView
            parentTid: ownerTid
            parentDeclId: ownerDeclId
            unitOpId: bmNode.operation
        )
        return
    }
    (
        resolveOrdinaryMember
        :st
        :ast
        :unitDecl
        :scope
        :ownerDeclId
        mName: mName.stringView
        :bmNode
        :speculative
    )
}

# resolveUnitMembers -- resolve the definition signatures in ONE unit's body,
# whatever kind of unit it is. A file unit, an inline `m: unit { }`, a hidden
# subunit and a `public:` block differ only in who supplies the owner, so the
# walk takes the owner's Decl and type id and never asks a name for them.
#
# `speculative` is the one fact the two entries differ on: the main FILE unit's
# body is walked before anything asks for it, a nested unit's (under --eager;
# otherwise resolveUnitScopes) because something demanded the unit. Both of the
# file walk's peculiarities follow from it -- it resolves only what a
# declaration needs (a function, a unit or an interface), and it does not mark
# what it touched as DEFINED, having resolved it on nobody's behalf. `rootOnly`
# narrows the eager set once more for the main unit, where demand starts at
# `main` and everything else waits to be asked for.
resolveUnitMembers: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    ownerDeclId: ztypes.declid
    ownerTid: ztypes.tid
    unitOpId: zast.nodeid
    speculative: bool
    rootOnly: bool
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitOpId
    i: u64
    for i < bodyIds.count loop {
        bm: zast.kidAt kids: ast.kids span: bodyIds :i
        i = i + 1
        (
            resolveUnitMemberAt
            :st
            :ast
            :unitDecl
            scope: ownerDeclId
            :ownerDeclId
            :ownerTid
            memberId: bm
            :speculative
            :rootOnly
        )
    }
}

# resolveUnitScopes -- resolve the scopes ONE unit's body declares: its nested
# namespaces and templates, and none of its other members.
resolveUnitScopes: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    ownerDeclId: ztypes.declid
    ownerTid: ztypes.tid
    unitOpId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitOpId
    i: u64
    for i < bodyIds.count loop {
        bm: zast.kidAt kids: ast.kids span: bodyIds :i
        i = i + 1
        op: (argRefAt :ast nid: bm).operation
        if op.notZero when (isUnitOp op: (ast.nodes.get i: op)) then {
            (
                resolveUnitMemberAt
                :st
                :ast
                :unitDecl
                scope: ownerDeclId
                :ownerDeclId
                :ownerTid
                memberId: bm
                speculative: false
                rootOnly: false
            )
        }
    }
}

# resolveNamespaceUnit -- resolve a namespace unit: an inline `m: unit { }` or a
# hidden subunit, which are the same node after parsing. Its members are
# children of ITS type id, not of the enclosing unit's, so two namespaces may
# each declare a `twice` without colliding. Members go through resolveDef, so a
# constant, a record, a class and a nested namespace all resolve the way a file
# unit's members do -- which is the whole point: a unit is one concept however
# it was written.
resolveNamespaceUnit: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    parentTid: ztypes.tid
    parentDeclId: ztypes.declid
    unitOpId: zast.nodeid
} is {
    nameRef: zast.poolFind pool: ast.names text: defName
    if nameRef.isZero then return
    udnid: unitdefNodeId :ast nId: unitOpId
    if udnid.isZero then return
    # st.reg.newType has no dedup and a namespace can be demanded again after it
    # resolved, so the node stamp is what makes a second visit a no-op.
    uid: ztypes.tid
    prev: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: udnid
    if prev.notZero then uid = prev
    declId: st.typing.declFindChild :parentDeclId nameId: nameRef
    if uid.isZero then {
        uid = st.reg.newType name: defName typetype: ztypes.ztypetype.unitType
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: udnid tid: uid
        if parentTid.notZero then {
            st.typing.setMemberType parentTypeId: parentTid nameId: nameRef childTypeId: uid
        }
        if declId.notZero then {
            st.typing.declSetType :declId typeId: uid
            # written in a generic unit, it is generic over that unit's
            # parameters: each instance of the unit has its own instance of it
            if (st.reg.genericParamNamesOf tdecl: parentDeclId).length > 0 then {
                st.reg.setGeneric typeId: uid value: true
                declare.registerUnitParamsOn :st :ast tdecl: declId unitTmpl: parentDeclId
            }
        }
    }
    resolveNamespaceMembers :st :ast :unitDecl :declId :uid :unitOpId :parentDeclId
    # A namespace's constants are NOT folded here. Each one declares itself
    # when something reads it (probeScopeTyperef's constant leg), the way every
    # other definition of this unit waits to be demanded. Folding them up front
    # was the last eager tier left inside the lazy one.
}

# resolveNamespaceMembers -- the members of the namespace `declId` (type `uid`)
# that resolve with it. A namespace is a scope: its members resolve when a use
# names them, as a file unit's do; only the scopes it declares -- nested
# namespaces and templates -- are properties of the declaration and resolve
# with it. `--eager` resolves every member, and a check of the main unit's own
# declarations demands every member of a namespace written in it, which
# resolves each the way a use would.
resolveNamespaceMembers: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    declId: ztypes.declid
    uid: ztypes.tid
    unitOpId: zast.nodeid
    # the declaration the namespace is written in
    parentDeclId: ztypes.declid
} is {
    if st.typing.eagerAll then {
        (
            resolveUnitMembers
            :st
            :ast
            :unitDecl
            ownerDeclId: declId
            ownerTid: uid
            :unitOpId
            speculative: false
            rootOnly: false
        )
    } else {
        resolveUnitScopes :st :ast :unitDecl ownerDeclId: declId ownerTid: uid :unitOpId
        if declId.notZero when (flow.eagerAt :st declId: parentDeclId) then (
            demandChildDecls
            :st
            :declId
        )
    }
}

# resolveMainUnitInstantiations -- resolve generic-unit instantiation bindings
# (intmath: (genmath t: i64)) into mono UNIT types. Two passes avoid nested
# program.units iteration: collect requests (separate fn), then create each mono.
# resolve every generic instantiation the program declares, in whichever unit
# it was written.
resolveMainUnitInstantiations: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    program: Ast
} is {
    reqs: List InstReq
    scanMainForInstantiations :st :scope :program :reqs
    for each r: reqs loop {
        rtId: r.tmplId
        # the template has to be RESOLVED before a mono is minted from it:
        # createUnitMono reads the template's id -- for an inline one, the stamp
        # resolveInlineGenericUnit lays on its def node -- to record the mono's
        # generic origin, and a template in a unit the eager pass did not walk
        # has none. The request already carries what it takes to resolve it:
        # instTemplateDecl found the template's Decl at COLLECTION, through the
        # scope the instantiation was written in. resolveInlineGenericUnit
        # self-guards on that Decl's type id, so this is a no-op whenever
        # anything already resolved the template.
        # A Decl parented straight to the program root is a file unit of the
        # template's name, not an inline template: registerUnitRoots has
        # already minted it.
        {
            tpd: st.typing.declParentOf declId: r.tmplDeclId
            tu: r.tmplUnit
            if (declAtProgramTop typing: st.typing parentDeclId: tpd
            ).not when r.tmplOpId.notZero then {
                {
                    rtT: zast.nameTextCopy ast: program ref: rtId
                    parentTid: st.typing.declTypeOf declId: tpd
                    (
                        declare.resolveInlineGenericUnit
                        :st
                        ast: program
                        unitDecl: tu
                        defName: rtT.stringView
                        :parentTid
                        parentDeclId: tpd
                        unitOpId: r.tmplOpId
                    )
                }
            }
        }
        # a request without a template Decl is no instantiation (a unit-level
        # constant CALL the collector also gathers), and neither is one whose
        # template is no generic unit (`B8: (Buffer cap: 8)` names a class
        # instance); the template's Decl was found at collection through the
        # instantiation's own scope
        if r.tmplDeclId.notZero when r.tmplOpId.notZero then {
            {
                bodies.mintUnitMonoOf :st :scope ast: program :r
                (
                    scanTemplateBodyDemands
                    :st
                    :scope
                    ast: program
                    tmplDeclId: r.tmplDeclId
                    templateOpId: r.tmplOpId
                )
            }
        }
    }
}

# resolveTemplateConstants -- a generic template's constant members resolve
# once, keyed on the template's type id and evaluated in the template's scope
# (the way a namespace's do under resolveConstantDefsIn); every instance of
# the template shares them. Idempotent through nsConstsWalked.
resolveTemplateConstants: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    tmplDeclId: ztypes.declid
} is {
    ttid: st.typing.declTypeOf declId: tmplDeclId
    if ttid.isZero then return
    top: zast.nodeid
    decl: st.typing.decls.get i: tmplDeclId
    np: ast.nodes.get i: decl.node
    if np.namedoperation then top = np.operation
    decl.drop
    if top.isZero then return
    fr: unitRootOfDecl typing: st.typing declId: tmplDeclId
    if fr.isZero then return
    resolveConstantDefsIn :st :scope :ast unitDecl: fr unitdefId: top ownerDeclId: tmplDeclId
}

# scanTemplateBodyDemands -- a template's method bodies name definitions the
# way any body does -- a sibling constant, a sibling function, a core type --
# and they resolve in the TEMPLATE's scope, wherever the instantiation was
# written. Demand them from that scope before any instance walk asks; the
# instance walk itself does not scan. Once per template.
scanTemplateBodyDemands: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast.view
    tmplDeclId: ztypes.declid
    templateOpId: zast.nodeid
} is {
    if templateOpId.isZero then return
    if (st.walk.resolve.templateBodiesScanned.has item: templateOpId) then return
    st.walk.resolve.templateBodiesScanned.add item: templateOpId
    rf: scope
    if tmplDeclId.notZero then rf = tmplDeclId
    scanUnitCalls :st scope: rf :ast unitdefId: templateOpId rootOnly: false
}

# stdDeclRo -- the declaration `member` of standard unit `stdUnit`, both
# well-known name ids, read only: what a backend lowers by hand (io's streams,
# os's arguments) asked by declaration, never by spelling. 0 when the program
# does not reach the unit or the unit declares no such member.
stdDeclRo: function {
    ast: Ast.view typing: ztyping.ZTyping.view stdUnit: zast.nameid member: zast.nameid
} out ztypes.tid is {
    ud: unitDeclOfName :typing nameId: stdUnit
    if ud.isZero then return ztypes.tid.zero
    return ((resolveUnitChildRo :ast :typing unitDecl: ud nameId: member).or d: ztypes.tid.zero)
}

# nameClaimedByScopeId -- the probe core shared by the negative-proof chains
# (unknown-reference at value/callable sites, unknown-type at stampTyperefs):
# does a unit-level namespace claim the name -- the unit-name space, the
# current unit's resolved children, or system's children? Callers add their
# context legs (local variables, the typeref walk, the closure-wide unit
# scan) and their own exemptions.
nameClaimedByScopeId: function {
    # the tree the unit's index is read from
    ast: Ast
    # the symbol table the name resolves in
    st: zenv.ZSymbolTable
    # the unit whose scope is asked
    unitDecl: ztypes.declid
    # the scope the question is asked from
    scope: ztypes.declid
    # the name asked about, interned
    nameId: zast.nameid
} out bool is {
    if (statics.nameDenotesUnit :st :scope :nameId) then return true
    # a name the unit DECLARES is claimed whether or not it resolved: a
    # failed declaration is reported once, at the declaration
    declared: st.typing.declFindChild parentDeclId: unitDecl :nameId
    if declared.notZero then return true
    # the current unit's own resolved members (its index), not its SURFACE:
    # a definition its `public:` block makes is reachable qualified, never
    # bare, and must not vouch for a bare name
    ncr: childOfWalkIds typing: st.typing :unitDecl name: nameId
    if ncr.some then {
        return true
    }
    askedName: nameId
    ncs: resolveUnitChild :st :ast unitDecl: st.typing.systemUnitRoot nameId: askedName
    # system's own nested units are private to it: a bare name that is
    # one of them is in scope nowhere else
    if ncs.some when (st.reg.typetypeOf typeId: ncs) != ztypes.ztypetype.unitType then return true
    return false
}

# stampTyperefs -- post-demand pass: stamp every recorded type-ref node with its real
# resolved type. Runs after the demand descent, so system + forward refs are present
# in childOf. pendingTyperef is a sibling field of nodeType (no lock
# conflict). The widened typed_nodes differential reads the resulting nodeType rows.
stampTyperefs: function {st: zenv.ZSymbolTable program: Ast} is {
    {
        stampPendingTyperefs :st ast: program unitDecl: st.typing.mainUnitRoot
        st.walk.resolve.typerefPassRan = true
    }
}

# typerefExcused -- a deferred type-ref that resolved NOWHERE, and whether
# that is a report. A template parameter name is exempt (its pendings feed
# mono substitution and resolve per instantiation; a dead-signature typo that
# collides with one is the accepted blind spot). A name whose declaration the
# environment finds queued or mid-resolution is queued for retry: this pass
# may run in the middle of a drain, before that declaration has resolved. A
# name a scope claims, or that any loaded unit resolves, is known. False means:
# report it.
typerefExcused: function {
    st: zenv.ZSymbolTable
    ast: Ast
    # the type-ref node, which is what a retry queues
    uk: zast.nodeid
    # the scope the ref was written in
    rf: ztypes.declid
    # the unit the ref was written in
    origin: ztypes.declid
    pval: zast.nameid
} out bool is {
    if (st.walk.bounds.gpNames.has item: pval) then return true
    dh: envLookup :st scope: rf nameId: pval
    if dh.declId.notZero then {
        dhWait: (
            (st.typing.declIsPending declId: dh.declId) or
            (st.typing.declIsResolving declId: dh.declId)
        )
        if dhWait then {
            st.walk.resolve.typerefRetry.append from: uk
            return true
        }
    }
    return (nameKnownAt :st :ast :rf :origin nameId: pval)
}

# nameKnownAt -- a name a type-ref's lookup did not reach that is still known: one
# a scope claims, or one any loaded unit resolves (the demand resolvers search
# the closure; the typeref walk does not)
nameKnownAt: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rf: ztypes.declid
    origin: ztypes.declid
    nameId: zast.nameid
} out bool is {
    if (nameClaimedByScopeId :ast :st unitDecl: origin scope: rf :nameId) then return true
    puds: programUnitDecls :st
    for each ud: puds loop {
        unitRoot: resolvedByIds :st :ast unitDecl: ud name: nameId
        if unitRoot.some then return true
    }
    return false
}

# stampOnePendingTyperef -- resolve one deferred type-ref and stamp it. The ref
# resolves in the scope it was WRITTEN in, not in whatever scope the drain runs
# under; one whose declaration is still unresolved is queued for retry rather
# than reported.
stampOnePendingTyperef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    uk: zast.nodeid
    pval: zast.nameid
} is {
    if ((st.walk.noStampNode.get key: uk).or d: false) then return
    # a declaration refused where it is written is no type-ref to resolve
    if (nodeRefused :st nid: uk) then return
    # the type-ref resolves in the scope it was written in
    rf: (st.walk.resolve.pendingTyperefScope.get key: uk).or d: ztypes.declid
    # the scope's unit, as the label the surface / claim probes take
    origin: unitDecl
    originId: zast.nameid
    our: unitRootOfDecl typing: st.typing declId: rf
    if our.notZero then originId = st.typing.declNameOf declId: our
    if originId.notZero then origin = unitDeclOfNameOrOwn :st scope: rf nameId: originId
    # an alias of the type the ref is written in, which the scope it waits in
    # does not see
    if (memberaccess.stampAliasRef :st :ast :uk :pval :origin) then return
    r: statics.walkLookupTyperefFrom :st :ast scope: rf baseId: pval
    if r.some then {
        rt: r
        # a generic type named bare in a type position is its defaults' instance
        if (st.walk.bareTyperefNodes.has item: uk) then {
            di: instantiate.defaultsInstance :st :ast :unitDecl tid: rt scope: rf
            if di.notZero then rt = di
        }
        memberaccess.stampResolvedTyperef :st :ast nid: uk :pval :origin tid: rt
        return
    }
    if (typeargs.stampQualifiedTyperef :st :ast unitDecl: origin scope: rf :uk) then return
    if (typerefExcused :st :ast :uk :rf :origin :pval) then return
    # a field's ref naming a member of its own type whose definition failed and
    # said why where it is written is no unknown name: the ref is refused with
    # it, quietly, and a read of the field reports nothing further
    own: (st.walk.fieldRefOwner.get key: uk).or d: ztypes.declid
    if own.notZero when (memberaccess.memberDefinitionFailed :st :ast root: own nameId: pval) then {
        st.typing.refusedValues.add item: uk
        return
    }
    st.typing.refusedValues.add item: uk
    un: ast.nodes.get i: uk
    pvalT: zast.nameTextAt :ast ref: pval
    um: "Unknown type '\{pvalT}'"
    (
        declare.addResolveErrorAt
        :st
        nodeid: (zast.nodeIdOf n: un)
        lineno: (nodeLine n: un)
        colno: (nodeCol n: un)
        e: zast.err.badReference
        msg: um
        width: pvalT.length
    )
}

# stampPendingTyperefs -- stamp the type-ref nodes recorded since the last
# call (walk.typerefNew, which notePendingTyperef fills in the order
# recorded). The first call is the post-demand pass; a definition
# resolved after it -- from a drain during the body walk -- records its
# type-refs the same way, and the drain re-runs this over the new tail.
stampPendingTyperefs: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
} is {
    # nothing recorded or deferred since the last pass: a definition resolved
    # on demand asks after each one, and most add nothing
    if st.walk.resolve.typerefRetry.length == 0 when (
        st.walk.resolve.typerefNew.length == 0
    ) then return
    # a declaration's type-refs belong to no instance and no template walk,
    # whichever walk asked for them
    prevMono: st.typing.curMonoStamp
    savedMode: st.mode
    st.typing.curMonoStamp = ztypes.tid.zero
    st.mode.genericWalk = false
    stampPendingTyperefsIn :st :ast :unitDecl
    st.typing.curMonoStamp = prevMono
    st.mode = savedMode
}

# sweepGenericParamNames -- add the names of the generic parameters minted since
# the last sweep to st.walk.gpNames. A PARTIAL and a trie NODE wear
# GENERIC_PARAM too, and neither label is a parameter's: a partial's is a spec's
# (`Cell_t`) and a node's is the template's own. Both are names a program may
# itself declare, and interning either here would make a typeref spelled that
# way resolve as a type PARAMETER. Ask the flags: the name shape must not be
# what decides this, which is the whole reason the flags exist.
sweepGenericParamNames: function {st: zenv.ZSymbolTable ast: Ast} is {
    t: st.walk.resolve.gpNamesSwept
    if t.isZero then t = t.next
    last: st.reg.nextTid
    for t < last loop {
        isGp: (st.reg.typetypeOf typeId: t) == ztypes.ztypetype.genericParam
        if isGp when (st.reg.isPartialOf tid: t).not when (st.reg.isTrieNodeOf tid: t).not then {
            gnm: st.reg.nameOf tid: t
            gnmId: nameIdOf :ast name: gnm.stringView
            if gnmId.notZero then st.walk.bounds.gpNames.add item: gnmId
        }
        t = t.next
    }
    st.walk.resolve.gpNamesSwept = t
}

# stampPendingTyperefsIn -- stampPendingTyperefs' pass, in the declaration
# context it sets up.
stampPendingTyperefsIn: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
} is {
    pkeys: ListVal zast.nodeid
    pvals: ListVal zast.nameid
    # entries an earlier pass deferred (their declaration was still
    # unresolved) come first, then the entries recorded since the last pass
    for each rk: st.walk.resolve.typerefRetry loop {
        rv: st.walk.pendingTyperef.get key: rk
        if rv.some then {
            pkeys.append rk
            pvals.append rv
        }
    }
    st.walk.resolve.typerefRetry = ListVal zast.nodeid
    for each nk: st.walk.resolve.typerefNew loop {
        nv: st.walk.pendingTyperef.get key: nk
        if nv.some then {
            pkeys.append nk
            pvals.append nv
        }
    }
    st.walk.resolve.typerefNew = ListVal zast.nodeid
    sweepGenericParamNames :st :ast
    pi: u64
    pcnt: pkeys.length
    for pi < pcnt loop {
        uk: pkeys.get i: pi
        pval: pvals.get i: pi
        pi = pi + 1
        stampOnePendingTyperef :st :ast :unitDecl :uk :pval
    }
}

# reportTypedefClash -- the base refusal recorded for generic typedef instance
# `tid`, reported once, here: the site that names the instance. Line 0 is the
# end-of-check sweep, for an instance no site named.
reportTypedefClash: function {
    ast: Ast
    st: zenv.ZSymbolTable
    tid: ztypes.tid
    at: zast.nodeid
    lineno: u32
    colno: u32
} is {
    co: st.walk.resolve.typedefClash.get key: tid
    if co.some then {
        if co.reported then return
        cl: co
        cl.reported = true
        st.walk.resolve.typedefClash.set key: tid value: cl
        m: (
            conform.constraintUnmetText
            :ast
            :st
            tdecl: cl.baseDecl
            paramName: cl.paramName
            argTid: cl.argTid
        )
        org: st.reg.genericOriginOf :tid
        tdn: numerics.qualifiedTypeName :st tid: org name: (st.reg.nameOf tid: org).stringView
        m.append " (the base of '\{tdn}')"
        declare.reportConstraintUnmet :st :at :lineno :colno msg: m
    }
}

# reportTypedefClashes -- every recorded base refusal no site reported.
reportTypedefClashes: function {ast: Ast st: zenv.ZSymbolTable} is {
    ks: ListVal ztypes.tid
    for each ce: st.walk.resolve.typedefClash.iterateItems loop {
        if ce.value.reported.not then ks.append from: ce.key
    }
    for each k: ks loop {
        reportTypedefClash :ast :st tid: k at: zast.nodeid lineno: 0 colno: 0
    }
}

# checkGenericBounds -- a bound names a type the program declares, and one that
# HAS a `.generic`: the spec gives it to a union, a variant, a protocol, a facet
# and a numeric type. A name the kinds classify (`anyval`, `RefHashable`, a
# width) is a family and answers for itself; anything else was taken on trust,
# so `T: Bogus.generic` constrained nothing and `T: Pt.generic` -- a record --
# constrained nothing either. Demand-driven: a declaration nothing reaches is
# not checked.
checkGenericBounds: function {ast: Ast.view st: zenv.ZSymbolTable} is {
    # collected while the bound table is read and reported after: the report
    # lends st
    keys: ListVal zast.nodeid
    for each be: st.walk.bounds.genericBoundName.iterateItems loop {
        keys.append from: be.key
    }
    bad: ListVal zast.nodeid
    msgs: List String
    for each k: keys loop {
        nm: (st.walk.bounds.genericBoundName.get key: k).or d: zast.nameid
        fr: (st.walk.bounds.genericBoundScope.get key: k).or d: ztypes.declid
        m: boundRefusalText :ast :st nid: k nameId: nm scope: fr
        if m.length > 0 then {
            bad.append from: k
            msgs.append m
        }
    }
    bi: u64
    for bi < bad.length loop {
        tn: ast.nodes.get i: (bad.get i: bi)
        bnm: zast.nameTextAt :ast ref: (atomNameId :ast n: tn)
        (
            declare.addResolveErrorAt
            :st
            nodeid: (zast.nodeIdOf n: tn)
            lineno: (nodeLine n: tn)
            colno: (nodeCol n: tn)
            e: zast.err.badReference
            msg: (msgs.get i: bi).copy
            width: bnm.length
        )
        bi = bi + 1
    }
}

# boundRefusalText -- why the bound spelled at `nid` cannot bound anything, ""
# when it can. A bound the kinds classify is a family (`anyval`, `RefHashable`,
# a width) and answers for itself; anything else must name a declaration, and
# only a union, a variant, a protocol, a facet or a numeric type HAS a
# `.generic` (spec). A qualified bound (`io.Reader`) is looked up in the unit
# its qualifier names.
boundRefusalText: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    nid: zast.nodeid
    nameId: zast.nameid
    scope: ztypes.declid
} out String is {
    if nameId.isZero then return "".string
    qn: (st.walk.bounds.genericBoundQual.get key: nid).or d: zast.nameid
    if (declare.boundIsFamily :st tdecl: scope :nameId qualId: qn) then return "".string
    bt: zast.nameTextAt :ast ref: nameId
    if qn.notZero then {
        qual: conform.boundQualifierUnit :st :scope qualId: qn
        # the qualifier names no unit, so it is what does not exist
        if qual.isZero then return (unknownBoundText bt: (zast.nameTextAt :ast ref: qn).stringView)
        qd: declOfUnitDefIds typing: st.typing unitDecl: qual :nameId
        if qd.isZero then return (unknownBoundText bt: bt.stringView)
        return (boundFamilyRefusal :ast :st declId: qd bt: bt.stringView)
    }
    # a unit is a declaration like any other, and names no type to bound with
    if (unitDeclOfName typing: st.typing :nameId).notZero then {
        return (boundHasNoGenericText bt: bt.stringView what: "unit")
    }
    ud: unitRootOfDecl typing: st.typing declId: scope
    d0: declOfUnitDefIds typing: st.typing unitDecl: ud :nameId
    if d0.notZero then return (boundFamilyRefusal :ast :st declId: d0 bt: bt.stringView)
    to: walkLookupTyperefByIdRo :ast typing: st.typing unitDecl: ud :scope baseId: nameId
    if to.some then {
        return (boundTypeRefusal :ast :st tid: to bt: bt.stringView)
    }
    if st.typing.coreUnitRoot.notZero then {
        dc: declOfUnitDefIds typing: st.typing unitDecl: st.typing.coreUnitRoot :nameId
        if dc.notZero then return (boundFamilyRefusal :ast :st declId: dc bt: bt.stringView)
    }
    return (unknownBoundText bt: bt.stringView)
}

# unknownBoundText -- the report a bound naming no declaration earns.
unknownBoundText: function {bt: StringView} out String is {
    return "Unknown type '\{bt}'"
}

# boundHasNoGenericText -- the report a bound naming a declaration of a family
# that has no `.generic` earns; `what` names that family.
boundHasNoGenericText: function {bt: StringView what: StringView} out String is {
    return "a \{what} has no '.generic': '\{bt}' cannot bound a parameter"
}

# boundFamilyRefusal -- the refusal a bound naming declaration `declId` earns,
# from the family that declaration declares, or from a union's members.
boundFamilyRefusal: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    declId: ztypes.declid
    bt: StringView
} out String is {
    tt: declDefTypetype :st :ast :declId
    match (
        tt
    ) case some then {
        m: boundTypetypeRefusal :tt :bt
        if (m.length > 0) or (tt != ztypes.ztypetype.unionType) then return m
        return (unionBoundMemberRefusal :ast :st tid: (st.typing.declTypeOf :declId) :bt)
    } case none then {
        return "".string
    }
}

# boundTypeRefusal -- the same question asked of a resolved type id.
boundTypeRefusal: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
    bt: StringView
} out String is {
    tt: st.reg.typetypeOf typeId: tid
    m: boundTypetypeRefusal :tt :bt
    if (m.length > 0) or (tt != ztypes.ztypetype.unionType) then return m
    return (unionBoundMemberRefusal :ast :st :tid :bt)
}

# unionBoundMemberRefusal -- a union bound admits reference types only, so a
# value-type member is one no argument can ever satisfy it through: the bound
# is refused where it is spelled, naming that member. A union nothing has
# resolved is not read -- resolving here would reach emission, and every
# instantiation resolves its bound first.
unionBoundMemberRefusal: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    tid: ztypes.tid
    bt: StringView
} out String is {
    if tid.isZero then return "".string
    parts: ListVal ztypes.tid
    variantPayloadTids typing: st.typing :tid :parts
    for each p: parts loop {
        pt: p
        if (st.reg.isValtypeOf tid: pt) then {
            pn: specWrittenName :st :ast tid: pt
            return "a union bound admits reference types only: '\{bt}' cannot bound a parameter, since its member '\{pn}' is a value type"
        }
    }
    return "".string
}

# boundTypetypeRefusal -- the families that have no `.generic`.
boundTypetypeRefusal: function {tt: ztypes.ztypetype bt: StringView} out String is {
    if tt == ztypes.ztypetype.classType then return (boundHasNoGenericText :bt what: "class")
    if tt == ztypes.ztypetype.unitType then return (boundHasNoGenericText :bt what: "unit")
    if tt == ztypes.ztypetype.recordType then return (boundHasNoGenericText :bt what: "record")
    return "".string
}

# checkHashKeys -- every type a hashable bound admitted as a Map or Set key,
# checked EXACTLY against the key's spec, `hash: {t: this.view} out u64` and
# `==: {t: this.view rhs: K} out bool` with K the key's own type (or admitted
# by a generic `==`'s bound). The bound admits by name, and a member that only
# shares the name compiled to C the C compiler refused. A reference type's
# declared members are checked, and a value type's WRITTEN ones: a generated
# member is correct by construction, so its parts are checked in its place.
# Run once the members are resolved, as checkImplementations is; admission holds
# no source node, so a finding is reported at the member.
checkHashKeys: function {ast: Ast st: zenv.ZSymbolTable} is {
    keys: ListVal ztypes.tid
    for each k: st.walk.hashKeys loop keys.append from: k
    seen: IdSet ztypes.tid
    for each k: keys loop {
        conform.checkHashKey :ast :st tid: k :seen depth: 0
    }
}

# variantPayloadTids -- the payload types of `tid`'s arms in declaration order,
# for a variant or a union; an arm that carries nothing contributes none.
variantPayloadTids: function {
    typing: ztyping.ZTyping.view tid: ztypes.tid parts: ListVal ztypes.tid
} is {
    od: typing.declIdOfType typeId: tid
    if od.isZero then return
    n: typing.declChildSlots declId: od
    i: u64
    for i < n loop {
        did: typing.declChildAt declId: od index: i
        i = i + 1
        pt: ztypes.tid
        if did.notZero then {
            dr: typing.decls.get i: did
            if dr.kind.armDecl then pt = dr.typeId
        }
        if pt.notZero when pt != typing.nullTypeId then parts.append pt
    }
}

# declNamesInstantiation -- a unit-level definition whose value instantiates a
# generic template (`B8: (Buffer cap: 8)`) or a generic unit (`wi: (wrap t:
# i64)`): it names the instance, a type. Read off what resolution already
# recorded, so nothing is resolved to answer. A call-shaped CONSTANT is a value
# even when its type is an instance: `AT: G.indexOf "#"` is an option.
declNamesInstantiation: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    if (st.walk.resolve.instantiatedAliases.has item: declId) then return true
    dt: ztypes.tid
    isCall: false
    ddo: st.typing.decls.get i: declId
    dt = ddo.typeId
    dn: ast.nodes.get i: ddo.node
    if dn.namedoperation then isCall = (ast.nodes.get i: dn.operation).call
    if isCall.not or dt.isZero then return false
    if (st.reg.typetypeOf typeId: dt) != ztypes.ztypetype.unitType then return false
    return (st.reg.genericOriginOf tid: dt).notZero
}

# scopeMemberTid -- the type of member `nameId` of the scope `root`, resolving
# it first when nothing has: a namespace's member resolves when a use first
# names it, and this read is that use. Zero when the scope declares none.
scopeMemberTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    root: ztypes.declid
    nameId: zast.nameid
} out ztypes.tid is {
    r: probeScopeTyperef :st :ast :root :nameId
    if r.notZero then return r
    md: st.typing.declFindChild parentDeclId: root :nameId
    if md.isZero or (st.typing.declIsResolved declId: md) then return r
    # a constant folds and a re-export follows its target inside the probe,
    # which is their resolution: neither is resolved a second time here
    mk: (st.typing.decls.get i: md).kind
    if mk.constDecl or mk.reexportDecl then return r
    resolveDemandedDecl :st :ast declId: md
    stampResolvedOnDemand :st :ast
    return (probeScopeTyperef :st :ast :root :nameId)
}

# memberIsList -- member `nameId` of `parentTid` is a list its `as` block
# declares, a value and no arm.
memberIsList: function {
    st: zenv.ZSymbolTable.view parentTid: ztypes.tid nameId: zast.nameid
} out bool is {
    d: st.typing.declMemberIdOf parentTypeId: parentTid :nameId
    if d.isZero then return false
    return (st.typing.decls.get i: d).kind.staticListDecl
}

# checkBareGenericReturns -- refuse a function's declared return that names a
# generic type without its arguments. The typeref pass alone
# stamps a return, and it stamps an application's head the same way, so the
# return node is asked here itself: a name, marked or not, never an application;
# `this` and `type` name the type being declared.
checkBareGenericReturns: function {ast: Ast st: zenv.ZSymbolTable} is {
    ri: u64
    for ri < st.typing.funcReturnNode.length loop {
        checkBareGenericReturnAt :ast :st slot: ri
        ri = ri + 1
    }
}

# checkBareGenericReturnAt -- checkBareGenericReturns for the function at
# `slot` of the table of declared returns.
checkBareGenericReturnAt: function {ast: Ast st: zenv.ZSymbolTable slot: u64} is {
    rn: (st.typing.funcReturnNode.valueAt i: slot).or d: zast.nodeid
    if rn.isZero then return
    fk: st.typing.funcReturnNode.keyAt i: slot
    n: ast.nodes.get i: rn
    if n.call then return
    root: rootNameIdOf :ast :n
    if (root == zast.wellKnown.slot.wkThis) or (root == zast.wellKnown.slot.wkType) then return
    # a return naming the function's own generic parameter (`out n`) names
    # no generic type, and its name is no type to look up: looked up, a
    # method's `n: anynumber.generic` would resolve as a constant
    fd: st.typing.declIdOfType typeId: fk
    if fd.notZero when (st.reg.genericParamTidOf tdecl: fd paramName: root).some then return
    rsc: (st.walk.resolve.pendingTyperefScope.get key: rn).or d: ztypes.declid
    rtd: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: rn
    rtb: (
        instantiate.bareGenericType
        :st
        :ast
        unitDecl: ztypes.declid
        tid: rtd
        nid: rn
        scope: rsc
        thisName: ""
    )
    # a generic type's name, stamped with its defaults' instance: that
    # instance is what the function returns
    if rtb != rtd then ztyping.nodeTypeSet tbl: st.typing.nodeType nid: rn tid: rtb
    nameT: (statics.walkLookupTyperefFrom :st :ast scope: rsc baseId: root).or d: ztypes.tid.zero
    if nameT.notZero when (st.reg.genericOriginOf tid: rtb) == nameT when fk.notZero then {
        st.reg.setReturnType typeId: fk value: rtb
    }
}

# recordDeclaredReturns -- record, on each function whose type does not say
# what it returns, the type its written return resolved to. Every type-ref
# stamp is final here, so from here on a function's type answers for its
# return alone: the emitter reads no return node.
recordDeclaredReturns: function {st: zenv.ZSymbolTable} is {
    ri: u64
    for ri < st.typing.funcReturnNode.length loop {
        fk: st.typing.funcReturnNode.keyAt i: ri
        rn: (st.typing.funcReturnNode.valueAt i: ri).or d: zast.nodeid
        ri = ri + 1
        if rn.notZero when (st.reg.returnTypeOf tid: fk).isZero then {
            nt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: rn
            if nt.notZero then st.reg.setReturnType typeId: fk value: nt
        }
    }
}

# returnsNullValue -- the value `return` is handed types as `null`: the bare
# `null`, or a call answering nothing. Walked here, where nothing else will
# walk it.
returnsNullValue: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    arg: argref
} out bool is {
    if (
        namesNullTypeAt
        :st
        :ast
        :unitDecl
        scope: st.curScope
        nameId: (zast.atomNameIdOf n: (ast.nodes.get i: arg.operation))
    ) then {
        stampGate :st nid: arg.operation tid: st.typing.nullTypeId
        return true
    }
    errN: st.typing.errors.length
    vt: checkValueAt :st :unitDecl :ast nid: arg.operation
    return (st.typing.errors.length == errN) and vt.notZero and (vt == st.typing.nullTypeId)
}

# walkOwnerMethods -- check one type member's method bodies (the shared
# core of the demand-time walk and the completion sweep).
walkOwnerMethods: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    ast: Ast
    memId: zast.nodeid
    # the owner type's name, interned
    nameId: zast.nameid
    # the owner's type when the caller already holds it -- a type a namespace
    # declares, which the file unit's definitions do not reach; the zero tid
    # resolves it
    knownTid: ztypes.tid.zero
} is {
    mem: argRefAt :ast nid: memId
    if mem.nid.notZero then {
        # a demand walk of the owner's method bodies is its own scope: a
        # dotted-base suppression live at the TRIGGERING reference must
        # not leak into the walked bodies
        savedMode: st.mode
        st.mode.suppressBareCtor = false
        st.mode.suppressFnAutoCall = false
        # outside-in: the owner type resolves BEFORE anything reads it. A body
        # walked ahead of its owner binds `this` to notype, and every check that
        # hangs off the receiver -- member reads, the declared return type --
        # silently stops asking.
        owTid: knownTid
        if owTid.isZero then owTid = forceUnitDef :st :scope :ast :unitDecl :memId
        bodies.scanMemberSignatures :st :scope :unitDecl :ast opId: mem.operation
        canWalk: bodies.objectdefHasMethodBodies :ast op: (ast.nodes.get i: mem.operation)
        # an owner that will not resolve is not walked at all: its own
        # resolution reports its own error, while a body walk on notype only
        # cascades that failure into every line of every method.
        if canWalk when owTid.isZero then canWalk = false
        if canWalk then {
            prev: st.walk.fn.synthLabel.copy
            prevU: st.walk.fn.synthOwnerUnit
            prevN: st.walk.fn.synthOwnerName
            prevThis: st.walk.fn.currentThisTid
            (
                bodies.checkMethodBodies
                :st
                :scope
                :unitDecl
                :ast
                typeNameId: nameId
                typeTid: owTid
                opId: mem.operation
            )
            st.walk.fn.synthLabel = prev.take
            st.walk.fn.synthOwnerUnit = prevU
            st.walk.fn.synthOwnerName = prevN
            st.walk.fn.currentThisTid = prevThis
        }
        st.mode = savedMode
    }
}

# walkStaticFnRefs -- walk the body of each function a static value refers to
# (constOfFnRef) that nothing has walked yet; true when any was walked. A walk
# can evaluate a static value that names another, so the list is read to its
# end as it grows.
walkStaticFnRefs: function {st: zenv.ZSymbolTable scope: ztypes.declid ast: Ast} out bool is {
    walked: false
    i: u64
    for i < st.walk.staticFnRefs.length loop {
        fd: st.walk.staticFnRefs.get :i
        i = i + 1
        if (st.typing.declIsWalked declId: fd) then continue
        (
            bodies.walkDeclaredDef
            :st
            :scope
            :ast
            unitDecl: (unitRootOfDecl typing: st.typing declId: fd)
            declId: fd
        )
        walked = true
    }
    return walked
}

# walkLateUsedBodies -- walk each deferred member a use reached after its
# owner's walk; true when any was walked. The owner walks once, gating each
# bodied member on a use (bodiedMemberDeferred), and a use found later -- in a
# namespace or subunit walked after the owner, which the walk order decides --
# reached a member nothing walked: its template body was emitted unstamped.
walkLateUsedBodies: function {st: zenv.ZSymbolTable ast: Ast} out bool is {
    walked: false
    i: u64
    # a walk can defer more, so the length is read each round
    for i < st.walk.resolve.deferred.length loop {
        dj: st.walk.resolve.deferred.get :i
        if (lateBodyOwed :st d: dj.decl) then {
            (
                bodies.walkDeferredBody
                :st
                :ast
                declId: dj.decl
                scope: dj.scope
                unitDecl: dj.unitDecl
                mono: dj.mono
            )
            walked = true
        }
        i = i + 1
    }
    return walked
}

# walkUnitTemplateBodies -- body-walk a generic unit template's functions with
# the generic param UNBOUND (no st.define of the arg), so a `match t` subject
# resolves to 0 and checkCase stamps it as a genericParam (against the bare unit
# name) for the emitter to dissect. Mirrors checkUnitBodies' fn loop (index-based
# so it never holds the iterator lock while passing unitBody).
walkUnitTemplateBodies: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    unitdefId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    # the template's own declaration, off its unitdef node's stamp: the scope
    # its members' bodies are walked in
    tdecl: ztypes.declid
    tun: unitdefNodeId :ast nId: unitdefId
    if tun.notZero then {
        tnt: ztyping.nodeTypeAt tbl: st.typing.nodeType nid: tun
        if tnt.notZero then tdecl = st.typing.declIdOfType typeId: tnt
    }
    # a generic FILE unit is a root, named by `unitDecl`
    if tdecl.isZero then {
        tro: unitDecl
        if tro.notZero then tdecl = tro
    }
    # a template-time walk: the generic parameter resolves to its
    # GENERIC_PARAM id in the template's scope, and stamps of that type stay
    # out of the global table -- each instance walks its own clone of the body
    # (instanceBodyAt), which the emitter emits with the instance's stamps (the rule every template walk
    # follows; the `match t` marker writes past it on purpose)
    savedMode: st.mode
    st.mode.genericWalk = true
    bn: bodyIds.count.u64
    bi: u64
    for bi < bn loop {
        bmId: zast.kidAt kids: ast.kids span: bodyIds i: bi
        bi = bi + 1
        bm: argRefAt :ast nid: bmId
        if bm.nid.notZero when (declare.isFunctionDefOp op: (ast.nodes.get i: bm.operation)) then {
            dn: zast.nameTextCopy :ast ref: bm.name
            fdecl: ztypes.declid
            if tdecl.notZero then fdecl = (
                st.typing.declFindChild
                parentDeclId: tdecl
                nameId: bm.name
            )
            cfbFr: bodies.fnRefAt :ast nid: bm.operation
            (
                bodies.checkFunctionBody
                :st
                :scope
                :unitDecl
                defName: dn.stringView
                defNameId: zast.nameid
                fn: cfbFr
                thisName: ""
                thisTid: ztypes.tid
                :ast
                declId: fdecl
            )
        }
    }
    st.mode = savedMode
}

# walkGenericUnitTemplates -- stamp `match t`/`match cap` in every generic unit
# template (file-level units and inline `unit {}` bindings) via an unbound
# body walk. Runs after the main-unit body check. Unit op ids and
# names are lifted out of node views before program is passed on (lock-safe).
walkGenericUnitTemplates: function {st: zenv.ZSymbolTable scope: ztypes.declid program: Ast} is {
    {
        n: program.units.length
        ui: u64
        for ui < n loop {
            uId: program.units.get i: ui
            ui = ui + 1
            uop: zast.nodeid
            un: String
            u: program.nodes.get i: uId
            if u.namedoperation then {
                uop = u.operation
                un = zast.poolTextCopy pool: program.names ref: u.name
            }
            if uop.notZero then {
                if (zast.unitIsGeneric ast: program unitId: uop) then {
                    homeUnit: (
                        unitDeclOfNameOrOwn
                        :st
                        :scope
                        nameId: (nameIdOf ast: program name: un.stringView)
                    )
                    (
                        walkUnitTemplateBodies
                        :st
                        :scope
                        ast: program
                        unitDecl: homeUnit
                        unitdefId: uop
                    )
                }
                ibody: zast.unitBodyIdsAt ast: program unitId: uop
                ibn: ibody.count.u64
                ibi: u64
                for ibi < ibn loop {
                    ibmId: zast.kidAt kids: program.kids span: ibody i: ibi
                    ibi = ibi + 1
                    bop: zast.nodeid
                    isU: false
                    {
                        bm: program.nodes.get i: ibmId
                        if bm.namedoperation when (
                            isUnitOp
                            op: (program.nodes.get i: bm.operation)
                        ) then {
                            isU = true
                            bop = bm.operation
                        }
                    }
                    if isU when (zast.unitIsGeneric ast: program unitId: bop) then {
                        # an INLINE template's members resolve in the FILE unit
                        # it is written in -- its own name is no file unit, and
                        # naming it only ever meant "the scope of the walk",
                        # which is this unit
                        hUnitDecl: (
                            unitDeclOfNameOrOwn
                            :st
                            :scope
                            nameId: (nameIdOf ast: program name: un.stringView)
                        )
                        (
                            walkUnitTemplateBodies
                            :st
                            :scope
                            ast: program
                            unitDecl: hUnitDecl
                            unitdefId: bop
                        )
                    }
                }
            }
        }
    }
}

# walkNamespaceOwner -- the method bodies of a type a namespace declares, once,
# in the scope of the type's own declaration.
walkNamespaceOwner: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    nsDecl: ztypes.declid
    memId: zast.nodeid
    nameId: zast.nameid
} is {
    od: st.typing.declFindChild parentDeclId: nsDecl :nameId
    if od.isZero then return
    otid: st.typing.declTypeOf declId: od
    # a type nothing resolved is not emitted either
    if otid.isZero then return
    if (st.typing.declIsWalked declId: od) then return
    st.typing.declSetWalked declId: od
    prevMono: st.typing.curMonoStamp
    st.typing.curMonoStamp = ztypes.tid.zero
    walkOwnerMethods :st scope: od :unitDecl :ast :memId :nameId knownTid: otid
    st.typing.curMonoStamp = prevMono
}

# checkBodies -- the body-walk pass, mirroring check()'s top-level
# loop: walk the main unit's function bodies, main first, then the others in
# body order. Runs after demand resolution so referenced types are already
# resolved.
checkBodies: function {st: zenv.ZSymbolTable scope: ztypes.declid program: Ast} is {
    {
        unitDecl: unitDeclOfNameOrOwn :st :scope nameId: st.reg.regMainUnitId
        mainIdx: u64
        found: false
        i0: u64
        for each uId: program.units loop {
            u: program.nodes.get i: uId
            if u.namedoperation then {
                uc5z: unitDeclOfNameOrOwn :st :scope nameId: u.name
                if uc5z == unitDecl when found.not then {
                    mainIdx = i0
                    found = true
                }
            }
            i0 = i0 + 1
        }
        if found then {
            muId: program.units.get i: mainIdx
            mOpId: zast.nodeid
            mu: program.nodes.get i: muId
            if mu.namedoperation then mOpId = mu.operation
            if mOpId.notZero then {
                bodies.checkUnitBodies :st :scope :unitDecl unitdefId: mOpId ast: program
            }
        }
        # a body walk can demand definitions the signatures never reached
        # (a type constructed only inside a late-resolved owner's method):
        # resolve them before the completion pass walks their owners
        resolveDemandedDefs :st ast: program
        walkOwedNamespaceBodies :st :scope ast: program
        walkLateResolvedOwners :st :scope ast: program
        # a member used only after its owner walked is walked now, and an
        # instance's walk is a use like any other; each walk can demand in
        # turn, so the completion passes run until a round walks nothing
        more: true
        for more loop {
            walkStaticFnRefs :st :scope ast: program
            markGeneratedEqParts :st ast: program
            for (walkLateUsedBodies :st ast: program) loop {
                resolveDemandedDefs :st ast: program
                walkOwedNamespaceBodies :st :scope ast: program
                walkLateResolvedOwners :st :scope ast: program
                markGeneratedEqParts :st ast: program
            }
            # the instance sweep walks each instance member used so far, and a
            # use it or a late walk finds after that is the next round's
            bodies.stampUnitMonoTemplates :st :scope :program
            markGeneratedEqParts :st ast: program
            more = (
                (lateBodyPending :st) or
                st.walk.instanceUseOwed or
                (walkStaticFnRefs :st :scope ast: program)
            )
        }
    }
}

# lateBodyPending -- a deferred member a use has reached and nothing has walked.
lateBodyPending: function {st: zenv.ZSymbolTable.view} out bool is {
    for each dj: st.walk.resolve.deferred loop {
        if (lateBodyOwed :st d: dj.decl) then return true
    }
    return false
}

# lateBodyOwed -- deferred member `d` is used and no walk has walked its body:
# its owner's walk deferred it, and no other route reached it since.
lateBodyOwed: function {st: zenv.ZSymbolTable.view d: ztypes.declid} out bool is {
    return (st.walk.usedMemberDecl.has item: d) and (st.typing.declIsWalked declId: d).not
}

# markGeneratedEqParts -- every value type the program has is emitted with its
# generated `==`, which calls each part's own; a part's written `==` is used by
# it. Swept once per type, from the watermark the last sweep left.
markGeneratedEqParts: function {st: zenv.ZSymbolTable ast: Ast.view} is {
    t: st.walk.resolve.eqPartsSwept
    last: st.reg.nextTid
    for t < last loop {
        isVal: (st.reg.isValtypeOf tid: t) and (st.reg.isGenericOf tid: t).not
        if isVal when (
            st.typing.declMemberIsSynth
            parentTypeId: t
            nameId: zast.wellKnown.slot.wkOpEq
        ) then {
            conform.markValOpUsed :ast :st tid: t nameId: zast.wellKnown.slot.wkOpEq depth: 0
        }
        t = t.next
    }
    st.walk.resolve.eqPartsSwept = t
}

# walkOwedNamespaceBodies -- walk the member bodies of every namespace or
# hidden subunit the demand path resolved. The main unit's own namespaces are
# walked by checkUnitBodies; a DEPENDENCY's are reached only here, and without
# this their bodies arrive at the emitter unstamped -- a loud E0500 where a
# diagnostic belongs.
#
# Drained in rounds because a body can demand a deeper subunit: each round
# resolves what the last one demanded, so a subunit of a subunit is walked by
# the round after its parent, to any depth. Deterministic: demand order.
walkOwedNamespaceBodies: function {st: zenv.ZSymbolTable scope: ztypes.declid ast: Ast} is {
    for st.walk.resolve.nsBodiesOwed.length > 0 loop {
        round: ListVal ztyping.nsbody
        for (
            st.walk.resolve.nsBodiesOwed.length > 0
        ) loop round.append st.walk.resolve.nsBodiesOwed.pop
        for each rec: round loop {
            unitDecl: unitDeclOfNameOrOwn :st :scope nameId: rec.unitName
            bodies.checkNamespaceBodies :ast :st :scope :unitDecl unitdefId: rec.unitOp
        }
        # a walked body demands definitions of its own; resolving them here is
        # what puts the next depth on the list
        resolveDemandedDefs :st :ast
    }
}

# walkLateOwnerMember -- one member the demand walk never reached. It is walked
# only when it is an owner with method bodies AND this compile has a reason to
# care about its dead code; the walked mark is set last, because it is what
# emission reads and it must be earned by a walk that actually happened.
walkLateOwnerMember: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    ownDecl: ztypes.declid
    memId: zast.nodeid
} is {
    swm: argRefAt :ast nid: memId
    if swm.nid.isZero then return
    swd: declOfUnitDefIds typing: st.typing :unitDecl nameId: swm.name
    if (st.typing.declIsWalked declId: swd) then return
    # the owner's definition row
    isOwner: false
    hasBodies: false
    swop: ast.nodes.get i: swm.operation
    if swop.objectdef when (zast.itemsHaveGenericParam :ast items: swop.asItems
    ).not then isOwner = true
    hasBodies = bodies.objectdefHasMethodBodies :ast op: swop
    if isOwner.not then return
    if hasBodies.not then return
    # Whose dead code it is decides whether this compile
    # cares. An owner in the program's OWN unit is worth
    # reporting on: the author wrote it and can fix it. A
    # DEPENDENCY's unreached type is not -- a build must not
    # spend time probing definitions the program cannot
    # reach, in code it does not own, and its body names
    # siblings nothing demanded, so checking it reports
    # valid references as unknown. `--eager` -- and so
    # emitted-check, zls and `zl lint --full` -- checks
    # everything regardless, which is the point of it.
    # Asked HERE, not per member: resolvedByIds RESOLVES as
    # it walks, so probing every member of every unit
    # settles types this compile never needed.
    if st.typing.eagerAll.not then {
        swRo: resolvedByIds :st :ast :unitDecl name: swm.name
        if swRo.none then return
    }
    # the walked mark is what emission reads, so it is earned by a walk that
    # can happen: resolve first, and a miss marks nothing.
    swTid: forceUnitDef :st :scope :ast unitDecl: ownDecl :memId
    if swTid.isZero then return
    st.typing.declSetWalked declId: swd
    walkOwnerMethods :st :scope unitDecl: ownDecl :ast :memId nameId: swm.name
}

# walkLateOwnersInUnit -- every member of one unit. The unit's own declaration
# is resolved ONCE here: the name belongs to the unit and not to the member, so
# asking for it inside the member loop asked the same question five times per
# member and got the same answer every time.
walkLateOwnersInUnit: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitName: zast.nameid
    body: zast.kidspan
} is {
    unitDecl: unitDeclOfName typing: st.typing nameId: unitName
    ownDecl: unitDeclOfNameOrOwn :st :scope nameId: unitName
    i: u64
    n: body.count.u64
    for i < n loop {
        memId: zast.kidAt kids: ast.kids span: body :i
        i = i + 1
        walkLateOwnerMember :st :scope :ast :unitDecl :ownDecl :memId
    }
}

# walkLateResolvedOwners -- complete the demand walk: the owners it left
# unwalked, unit by unit. A type can resolve AFTER its unit's walk has already
# run -- zvfs.ZVfs and DentryTable do it in astdemo, and a typedef constant does
# it in its own unit -- and nothing re-walks that unit, so its methods would be
# emitted with nothing stamped (E0500, "unhandled binding type"). The walk is
# what stamps a body, so the completion pass is not optional; it is the price of
# walking a unit once rather than to a fixpoint. A type NOTHING reached is not
# checked here: a definition the program cannot reach is not the compiler's to
# spend time on, and reporting on it is a LINT concern. So the keep test is
# `resolved` alone. Template owners are skipped: their bodies check per
# instantiation. Deterministic: unit load order, declaration order.
walkLateResolvedOwners: function {st: zenv.ZSymbolTable scope: ztypes.declid ast: Ast} is {
    swN: ast.units.length
    swI: u64
    for swI < swN loop {
        swuId: ast.units.get i: swI
        swI = swI + 1
        swu: argRefAt :ast nid: swuId
        if swu.nid.notZero then {
            swBody: zast.unitBodyIdsAt :ast unitId: swu.operation
            walkLateOwnersInUnit :st :scope :ast unitName: swu.name body: swBody
        }
    }
}

# recordLiteralDecl -- name the literal type a node WORE, for tooling, in the
# last moment it is knowable: the fold below overwrites the stamp with i64/f64
# and nothing afterwards can tell an unpinned literal from a plain integer.
# toolRefDecl, never refDecl -- the emitter reads the latter in five places and
# an entry added there for an editor moved the emitted C.
recordLiteralDecl: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    nid: zast.nodeid
    tid: ztypes.tid
} is {
    sd: surfaceDeclOfTypeId :st :ast :tid
    if sd.isZero then return
    st.typing.toolRefDecl.set key: nid value: sd
}

# foldLiteralStamps -- replace literal-typed node stamps with their concrete
# defaults (i64 / f64 / StringView) after the body walk: the unregistered pseudo ids
# and the lists' registered intliteral/floatliteral element shells.
# Symbol-table entries keep their literal ids.
foldLiteralStamps: function {st: zenv.ZSymbolTable program: Ast} is {
    intId: stdTid ast: program :st wk: zast.wellKnown.slot.tyI64
    floatId: stdTid ast: program :st wk: zast.wellKnown.slot.tyF64
    textId: stdTid ast: program :st wk: zast.wellKnown.slot.tyStringView
    nn: st.typing.nodeType.length
    ni: zast.nodeid
    for ni.u64 < nn loop {
        fv: st.typing.nodeType.get i: ni
        to: literalStampFold :st :fv :intId :floatId :textId
        if to.notZero then {
            # the declaration a tool reads is the literal type's own
            recordLiteralDecl :st ast: program nid: ni tid: fv
            ztyping.nodeTypeSet tbl: st.typing.nodeType nid: ni tid: to
        }
        ni = ni.next
    }
}

# literalStampFold -- the concrete type a literal stamp folds to: i64 for an
# integer literal, f64 for a float one, StringView for a string literal no
# destination pinned; the zero tid for any
# other stamp, or a default the program does not reach.
literalStampFold: function {
    st: zenv.ZSymbolTable.view
    fv: ztypes.tid
    intId: ztypes.tid
    floatId: ztypes.tid
    textId: ztypes.tid
} out ztypes.tid is {
    if fv == st.reg.literalIntTid then return intId
    if fv == st.reg.literalFloatTid then return floatId
    if fv == st.reg.literalTextTid then return textId
    return ztypes.tid.zero
}

# resolvedTidOr -- the type `name` resolves to from `unitDecl`, 0 for none.
resolvedTidOr: function {
    st: zenv.ZSymbolTable ast: Ast unitDecl: ztypes.declid name: zast.nameid
} out ztypes.tid is {
    return ((resolvedByIds :st :ast :unitDecl :name).or d: ztypes.tid.zero)
}

# resolveInstantiatedAlias -- `Strs: (List String)`: a unit-level definition
# whose value INSTANTIATES a generic template NAMES the resulting mono, exactly
# as the bare (`Same: Holder`) and dotted (`Nd: zast.astnode`) forms name a type.
# The alias shares the mono's canonical id and mints nothing of its own, so the
# id is recorded on the Decl and on the unit's member index the way
# resolveAliasKeyIn records the other two forms. false when the instantiation
# does not resolve, which leaves the caller's diagnostic to fire.
resolveInstantiatedAlias: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    defn: callref
} out bool is {
    mt: (
        resolveMonoRefInline
        :st
        :scope
        :ast
        :unitDecl
        thisName: ""
        enclDecl: ztypes.declid
        opNid: defn.nid
        nid: zast.nodeid
    )
    if mt.isZero then return false
    mtid: mt
    adecl: declOfUnitDef :st :scope :unitDecl nameId: (nameIdOf :ast name: defName)
    if adecl.notZero then {
        st.typing.declSetType declId: adecl typeId: mtid
        st.walk.resolve.instantiatedAliases.add item: adecl
    }
    cu: st.typing.declTypeOf declId: (statics.constOwnerDeclFor :st :scope :ast :unitDecl :defName)
    if cu.notZero then {
        (
            st.typing.setMemberType
            parentTypeId: cu
            nameId: (zast.poolFind pool: ast.names text: defName)
            childTypeId: mtid
        )
    }
    return true
}

# reportAliasCycle -- a unit-level definition whose value names the definition
# itself, directly or through another: no value or type can come out of it.
reportAliasCycle: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    declId: ztypes.declid
    dnode: zast.nodeid
} is {
    if (st.walk.resolve.aliasCyclesReported.has item: declId) then return
    st.walk.resolve.aliasCyclesReported.add item: declId
    dn: ast.nodes.get i: dnode
    nm: zast.nameTextAt :ast ref: (st.typing.declNameOf :declId)
    mc: "'\{nm}' is defined in terms of itself"
    hc: "a definition's value may not name the definition, directly or through another one".string
    nc: String
    (
        addErrorWithHint
        :st
        nodeid: (zast.nodeIdOf n: dn)
        lineno: (nodeLine n: dn)
        colno: (nodeCol n: dn)
        e: zast.err.constError
        msg: mc
        note: nc
        hint: hc
        width: nm.length
    )
}

# resolve a unit's compile-time constant definitions.
resolveConstantDefsInUnit: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    unitdefId: zast.nodeid
} is {
    rd: ztypes.declid
    ro: unitDecl
    if ro.notZero then rd = ro
    resolveConstantDefsIn :st :scope :ast :unitDecl :unitdefId ownerDeclId: rd
}

# resolveConstantDefsIn -- the walk resolveConstantDefsInUnit drives, once for
# the file unit and once for each namespace or template nested in it, with
# `ownerDeclId` as the scope: a nested unit's constants key on that unit
# (constOwnerDeclFor climbs the scope's chain), the file unit's on the unit.
resolveConstantDefsIn: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    unitdefId: zast.nodeid
    ownerDeclId: ztypes.declid
} is {
    if (st.walk.resolve.nsConstsWalked.has item: unitdefId) then return
    st.walk.resolve.nsConstsWalked.add item: unitdefId
    rf: scope
    if ownerDeclId.notZero then rf = ownerDeclId
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    {
        i: u64
        for i < bodyIds.count loop {
            bm: zast.kidAt kids: ast.kids span: bodyIds :i
            i = i + 1
            bmNode: argRefAt :ast nid: bm
            if bmNode.nid.notZero then {
                defName: zast.nameTextCopy :ast ref: bmNode.name
                # a generic template's constants are its own too, keyed on the
                # template's id (the def-node stamp resolveInlineGenericUnit
                # lays); a template nothing resolved yet has none to key on
                # and is skipped, and its members' demand resolves them
                if (zast.unitOpHasBody :ast opId: bmNode.operation) then {
                    ct: ztypes.tid
                    un: unitdefNodeId :ast nId: bmNode.operation
                    if un.notZero then {
                        ct = (
                            ztypes.tid.create
                            from: (ztyping.nodeTypeAt tbl: st.typing.nodeType nid: un)
                        )
                    }
                    if ct.notZero then {
                        ownerDecl: (
                            st.typing.declFindChild
                            parentDeclId: ownerDeclId
                            nameId: bmNode.name
                        )
                        (
                            resolveConstantDefsIn
                            :st
                            scope: rf
                            :ast
                            :unitDecl
                            unitdefId: bmNode.operation
                            ownerDeclId: ownerDecl
                        )
                    }
                } else if defName.length > 0 then {
                    # a template's generic PARAMETER (`t: anyval.generic`,
                    # `cap: u32.generic`) is a parameter, not a constant; a
                    # `public:` block's reference entry is an edge to a
                    # sibling, whose own unit resolves it
                    isEdge: false
                    ed: st.typing.declFindChild parentDeclId: ownerDeclId nameId: bmNode.name
                    edp: st.typing.declParentOf declId: ed
                    if ed.notZero when edp != ownerDeclId then isEdge = true
                    # a `public:` block's re-export (`Circle: impl.Circle`) is
                    # followed when a use reaches it: resolved here it demanded
                    # each unit the block names and minted every type in them
                    if (declIsPublicBlock :st declId: ownerDeclId) when (
                        isReexportShaped
                        :ast
                        opId: bmNode.operation
                    ) then isEdge = true
                    # and so is an alias of an instance (`i256: (fixedint.int
                    # words: 4)`): folded here it minted and walked the instance
                    if (declIsPublicBlock :st declId: ownerDeclId) when (
                        isApplicationShaped
                        :ast
                        opId: bmNode.operation
                    ) then isEdge = true
                    # a constant whose fold is under way further up the stack
                    # is left to that fold: the walk only makes sure each
                    # member folds, and is no read that could close a cycle
                    if isEdge.not when (
                        statics.constFoldOpen
                        :st
                        scope: rf
                        :unitDecl
                        nameId: bmNode.name
                    ) then isEdge = true
                    if isEdge.not when (
                        declare.isGenericParam
                        :ast
                        op: (ast.nodes.get i: bmNode.operation)
                    ).not then {
                        (
                            statics.resolveConstantMember
                            :st
                            scope: rf
                            :ast
                            :unitDecl
                            defName: defName.stringView
                            defnId: bmNode.operation
                        )
                    }
                }
            }
        }
    }
}

# isApplicationShaped -- the definition applies a type to its generic arguments
# (`(fixedint.int words: 4)`): a call of a name or a path whose every argument is
# labelled, the shape an instance alias has and a constant does not
isApplicationShaped: function {ast: Ast.view opId: zast.nodeid} out bool is {
    n: ast.nodes.get i: opId
    if n.call.not then return false
    cn: ast.nodes.get i: n.callable
    if (cn.dottedpath or cn.atomid).not then return false
    if n.arguments.count == 0 then return false
    for each aId: (zast.kidsOf :ast span: n.arguments) loop {
        a: ast.nodes.get i: aId
        if a.namedoperation.not then return false
        if a.name.isZero then return false
    }
    return true
}

# isReexportShaped -- the definition only names another one: a dotted path or a
# bare name, but not a numeric literal or a conversion of one (`5`, `5.u8`),
# which are constants of their own
isReexportShaped: function {ast: Ast.view opId: zast.nodeid} out bool is {
    root: rootNameIdOf :ast n: (ast.nodes.get i: opId)
    if root.isZero then return false
    if (isNumericLiteralNameAt :ast ref: root) then return false
    n: ast.nodes.get i: opId
    return n.dottedpath or n.atomid
}

# resolveConstantDefs -- materialise every unit's constant definitions, so a
# constant is a member of the unit that declares it and `unit.NAME` resolves
# across units the way
# `unit.fn` does. Runs post-demand so the numeric defaults are already resolved.
resolveConstantDefs: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    program: Ast
} is {
    # the eager tier's answer to "what are this program's constants": every
    # definition of every unit, so one nothing references is still checked.
    # The lazy tier resolves a constant where it is demanded, in
    # resolveDemandedDecl, and this walk does not run at all.
    if st.typing.eagerAll.not then return
    {
        # stage (unit name, unit body) first: the call below takes an exclusive
        # lock on program, which cannot run while the unit-row iteration
        # holds a shared one
        unms: List String
        uops: ListVal zast.nodeid
        {
            uiter: program.units.iterate
            for uId: uiter loop {
                u: program.nodes.get i: uId
                if u.namedoperation then {
                    nm: zast.poolTextAt pool: program.names ref: u.name
                    if nm.length > 0 then {
                        unms.append nm.copy
                        uop: u.operation
                        uops.append uop
                    }
                }
            }
        }
        ui: u64
        un: unms.length
        for ui < un loop {
            unm: unms.get i: ui
            unmId: nameIdOf ast: program name: unm.stringView
            udU: unitDeclOfNameOrOwn :st :scope nameId: unmId
            (
                resolveConstantDefsInUnit
                :st
                :scope
                ast: program
                unitDecl: udU
                unitdefId: (uops.get i: ui)
            )
            ui = ui + 1
        }
    }
}

# surfaceDeclOfTypeId -- the Decl a READER means by a type's name. Writing `u8`
# navigates to core's re-export line, not to the record in `system.z` that
# declIdOfType returns, so a navigation driven by a TYPE ID has to make the same
# jump or the two routes to one type disagree. A type core does not re-export
# answers with its own declaration.
surfaceDeclOfTypeId: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    tid: ztypes.tid
} out ztypes.declid is {
    own: st.typing.declIdOfType typeId: tid
    if own.isZero then return own
    if st.typing.coreUnitRoot.isZero then return own
    tn: st.reg.nameOf :tid
    nameId: zast.poolFind pool: ast.names text: tn.stringView
    if nameId.isZero then return own
    cx: st.typing.declFindChild parentDeclId: st.typing.coreUnitRoot :nameId
    if cx.isZero then return own
    # the re-export has to name THIS type's own unit: a user type may be named
    # `u8`, and the spelling alone would hand it core's `u8`. Unit identity is
    # the Decl id, never the name.
    dk: reexportTargetIdsOf typing: st.typing :ast declId: cx
    if (
        (unitDeclOfName typing: st.typing nameId: dk.unitName) ==
        (unitDeclOfTid reg: st.reg typing: st.typing :tid)
    ) then return cx
    return own
}

# unitDeclOfTid -- the top-level unit root Decl that owns type `tid`'s
# declaration (declIdOfType -> parent walk to the parentless unit root); 0
# when the type has no declaration. An instance of a generic type, and each
# member it copies, is minted in no unit and answers 0; a unit instance's copy
# lies under its template, whose unit it answers. The id-valued unit-identity
# primitive: compare unit ownership by this, not by name.
unitDeclOfTid: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
} out ztypes.declid is {
    if (reg.genericOriginOf :tid).notZero when (
        (reg.typetypeOf typeId: tid) != ztypes.ztypetype.unitType
    ) then return ztypes.declid.zero
    cur: typing.declIdOfType typeId: tid
    for cur.notZero loop {
        par: ztypes.declid
        isU: false
        selfT: ztypes.tid
        decl: typing.decls.get i: cur
        par = decl.parent
        if decl.kind.unitDecl then isU = true
        selfT = decl.typeId
        if (declAtProgramTop :typing parentDeclId: par) then {
            # a FILE unit's own tid links to its own root under the program
            # root: the unit is not "defined in" a unit (inline units and
            # root-proxied synths do report the enclosing unit)
            if selfT == tid then return ztypes.declid.zero
            if isU then return cur
            return ztypes.declid.zero
        }
        cur = par
    }
    return ztypes.declid.zero
}

# unitNameViewOfTid -- the defining unit's name BORROWED rather than copied.
# The view pins the registry for its binding's scope, so a caller that compares
# the name, interpolates it once, or hands it straight to another call keeps
# nothing and should pay nothing. unitNameOfTid is the owning twin, for a caller
# that keeps the String.
unitNameViewOfTid: function {
    reg: ztypes.ZTypeRegistry.view
    typing: ztyping.ZTyping.view
    tid: ztypes.tid
} outx StringView is {
    ud: unitDeclOfTid :reg :typing :tid
    if ud.u64 == 0 then return ""
    utid: ztypes.tid
    decl: typing.decls.get i: ud
    utid = decl.typeId
    if utid.isZero then return ""
    return (reg.nameViewOf tid: utid)
}

# --- the environment ---


# unitDeclOfNameOrOwn -- the Decl of the FILE unit a unit's name denotes, or of
# the unit an alias in scope names (`c: inner`, unitOfBinding), or, for a name
# that is neither (a nested unit's or a template's own name, spelled as the
# walk's unit), the unit `scope` lies in. unitDeclOfName is the door whose miss
# is 0; the two are not interchangeable. A name WRITTEN in source is resolved by
# unitWrittenAt, where the scope may hide a file unit.
unitDeclOfNameOrOwn: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    if nameId.isZero then return ztypes.declid.zero
    r: unitDeclOfName typing: st.typing :nameId
    if r.notZero then return r
    ua: unitOfAliasType :st :scope :nameId
    if ua.notZero then return ua
    return (unitRootOfDecl typing: st.typing declId: scope)
}

# unitWrittenAt -- the unit a name written in `scope` names: the file unit it
# reaches (fileUnitNamedAt), else the unit an alias in scope names, else, as
# unitDeclOfNameOrOwn answers, the unit `scope` lies in.
unitWrittenAt: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    if nameId.isZero then return ztypes.declid.zero
    r: fileUnitNamedAt :st :scope :nameId
    if r.notZero then return r
    ua: unitOfAliasType :st :scope :nameId
    if ua.notZero then return ua
    return (unitRootOfDecl typing: st.typing declId: scope)
}

# unitOfAliasType -- the unit an alias in scope names (`c: inner`), read off the
# type the alias resolved to: a unit's own type, never an instance of a generic
# unit (`intmath: (mathops t: i64)`), whose members are the instance's. 0 for any
# other name, and for an alias not resolved yet.
unitOfAliasType: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    h: envLookup :st :scope :nameId
    if h.declId.isZero then return ztypes.declid.zero
    bt: st.typing.declTypeOf declId: h.declId
    if bt.isZero then return ztypes.declid.zero
    if (st.reg.typetypeOf typeId: bt) != ztypes.ztypetype.unitType then return ztypes.declid.zero
    if (st.reg.typeById.get i: bt).genericOriginId.some then return ztypes.declid.zero
    return (st.typing.declIdOfType typeId: bt)
}

# fileUnitNamedAt -- the FILE unit a bare name written in `scope` reaches: the
# program root's child of that name, unless the scope, an enclosing unit or
# `core` binds the name first and so hides it. Names resolve from the scope
# outward and reach the file units last, whether or not a unit is loaded yet.
# 0 when no file unit is reached.
fileUnitNamedAt: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    fu: unitDeclOfName typing: st.typing :nameId
    if fu.isZero or scope.isZero then return fu
    h: envLookup :st :scope :nameId
    if h.declId.isZero or (h.declId == fu) then return fu
    return ztypes.declid.zero
}

# unitDeclOfName -- the Decl of the FILE unit a name denotes: the program
# root's child of that name, or 0. THE ONE DOOR from a unit's name to its
# declaration -- everything downstream compares and looks up by id, where two
# units sharing a name are two answers rather than declFindChild's last-wins
# coin flip. The empty name is the prelude-only probe and has no unit.
unitDeclOfName: function {
    typing: ztyping.ZTyping.view
    nameId: zast.nameid
} out ztypes.declid is {
    if nameId.isZero then return ztypes.declid.zero
    return (typing.declFindChild parentDeclId: typing.programRoot :nameId)
}

# nsScopeOf -- the NESTED unit scope a name written in unit `unitDecl`
# resolves from -- scopeFor's answer when it is not the unit's own root --
# or 0 at the top level of the unit. The scope the members of a namespace or
# template are declared in, as against the file unit.
nsScopeOf: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    scope: ztypes.declid
} out ztypes.declid is {
    f: typeargs.scopeFor typing: st.typing :scope :unitDecl
    if f.isZero then return f
    if f == unitDecl then return ztypes.declid.zero
    return f
}

# unitScopeOf -- the nearest scope at or above `declId` that a bare-name walk
# consults: a unit (file, inline, subunit, template) or a `public:` block. A
# type or function declaration is transparent to bare names -- members are
# reached through `this` or a qualified path, never bare -- so the walk climbs
# through it. 0 when `declId` is 0 or has no such ancestor.
unitScopeOf: function {
    typing: ztyping.ZTyping.view
    declId: ztypes.declid
} out ztypes.declid is {
    cur: declId
    for cur.notZero loop {
        # the row carries the answer (declSetUnitScope, laid at index time):
        # a body, a function, a local is not a unit scope, and no walk touches
        # the node
        if (typing.declIsUnitScope declId: cur) then return cur
        cur = typing.declParentOf declId: cur
    }
    return ztypes.declid.zero
}

# declDefIsNative -- the definition this declaration records is a NATIVE
# object (`record is native`, `class is native`): the runtime owns its
# layout, so it holds nothing by value.
declDefIsNative: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    dn: zast.nodeid
    decl: st.typing.decls.get i: declId
    dn = decl.node
    if dn.isZero then return false
    np: ast.nodes.get i: dn
    if np.namedoperation.not then return false
    opNode: ast.nodes.get i: np.operation
    match (
        opNode
    ) case objectdef then {
        return opNode.isNative
    } else {
        return false
    }
}

# declDeclaresTemplate -- does this declaration declare a generic template
# unit (`m: unit { t: anyval.generic ... }`)? Read off the def node's
# kind, like declDeclaresUnit; a template is a scope of its own -- its
# members and generic parameters are its children -- that the unit
# predicates deliberately exclude.
declDeclaresTemplate: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    dn: zast.nodeid
    decl: st.typing.decls.get i: declId
    dn = decl.node
    if dn.isZero then return false
    np: ast.nodes.get i: dn
    if np.namedoperation.not then return false
    return (zast.unitOpKindIs :ast opId: np.operation k: zast.unitkind.template)
}

# declIsNamespace -- the declaration is a namespace: an inline `m: unit { }`, a
# hidden subunit or a `public:` block. A template is not one, and neither is a
# type, though both are scopes.
declIsNamespace: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out bool is {
    if declId.isZero then return false
    dn: (st.typing.decls.get i: declId).node
    if dn.isZero then return false
    np: ast.nodes.get i: dn
    if np.namedoperation.not then return false
    return (zast.unitOpDeclaresUnit :ast opId: np.operation)
}

# envTypeIdOf -- the environment's answer for a bare name as a type id: the
# declaration `scope`'s chain reaches, when it is minted. 0 when the
# scope is unset, the name is unknown to the chain, or the declaration is
# not resolved yet (a probe cannot mint; the demand scans see to that).
envTypeIdOf: function {
    st: zenv.ZSymbolTable.view
    scope: ztypes.declid
    nameId: zast.nameid
} out ztypes.tid is {
    if scope.isZero then return ztypes.tid.zero
    eh: envLookup :st :scope :nameId
    if eh.declId.isZero then return ztypes.tid.zero
    return (st.typing.declTypeOf declId: eh.declId)
}

# reexportUnitOf -- for a prelude Decl whose value is a unit-rooted dotted
# alias (`List: collections.ListRef`), the name id of the unit it names; the
# zero id for a bare alias, a type-rooted value (`true: bool.true`), or a real
# definition.
reexportUnitOf: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    declId: ztypes.declid
} out zast.nameid is {
    decl: st.typing.decls.get i: declId
    nop: ast.nodes.get i: decl.node
    if nop.namedoperation then {
        dk: dottedDefTargetIds :ast n: (ast.nodes.get i: nop.operation)
        if dk.unitName.notZero then {
            dkr: fileUnitNamedAt :st scope: (st.typing.declParentOf :declId) nameId: dk.unitName
            if dkr.notZero then return dk.unitName
        }
    }
    return zast.nameid.zero
}

# programUnitDecls -- every FILE unit's Decl, in load order: the program root's
# children, one per unit name (registerUnitRoots rejects a repeated one).
programUnitDecls: function {st: zenv.ZSymbolTable.view} out ListVal ztypes.declid is {
    result: ListVal ztypes.declid
    ro: st.typing.decls.get i: st.typing.programRoot
    for each c: ro.children.iterateItems loop result.append c.value
    return result
}

# declProbeUnitChildRoot -- the same probe from an already-resolved unit root.
# Callers on a per-reference path resolve the root once and come here; only the
# name-taking wrapper above pays a pool probe.
declProbeUnitChildRoot: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitRoot: ztypes.declid
    nameId: zast.nameid
} out ztypes.tid is {
    if nameId.isZero then return ztypes.tid.zero
    cid: st.typing.declFindChild parentDeclId: unitRoot :nameId
    if cid.isZero then return ztypes.tid.zero
    ctid: ztypes.tid
    isRx: false
    isC: false
    decl: st.typing.decls.get i: cid
    ctid = decl.typeId
    if decl.kind.reexportDecl then isRx = true
    if decl.kind.constDecl then isC = true
    decl.drop
    if ctid.notZero then return ctid
    if isRx then {
        # a re-export not yet resolved: mint once through the alias,
        # cache on the Decl (covers value re-exports like core.false)
        return (resolveAliasKey :st :ast declId: cid)
    }
    if isC then {
        statics.constFoldDecl :st :ast declId: cid
        rt: st.typing.declTypeOf declId: unitRoot
        if rt.notZero then {
            co: st.typing.declChildOfId parentTypeId: rt :nameId
            if co.some then {
                return co
            }
        }
    }
    return ztypes.tid.zero
}

# probeScopeTyperef -- one scope's answer for a type name: the Decl-tree
# child's minted id (a not-yet-touched re-export minted through its alias),
# else the unit type's member index, which also serves the pre-index window
# (no root yet) and members that are not Decls (unit monos, namespace
# bindings). 0 when the scope has no such name yet -- the caller moves to the
# next scope.
probeScopeTyperef: function {
    ast: Ast
    st: zenv.ZSymbolTable
    root: ztypes.declid
    nameId: zast.nameid
} out ztypes.tid is {
    if nameId.isZero then return ztypes.tid.zero
    if root.isZero then return ztypes.tid.zero
    dt: declProbeUnitChildRoot :st :ast unitRoot: root :nameId
    if dt.notZero then return dt
    # the scope's own member index, keyed on the unit id its ROOT DECL
    # carries. Every unit root has one -- a file unit's is stamped where the
    # roots are indexed, a nested unit's where resolveNamespaceUnit mints it
    # -- so the scope answers the same way whichever kind of unit it is.
    rt: st.typing.declTypeOf declId: root
    if rt.isZero then return ztypes.tid.zero
    co: st.typing.declChildOfId parentTypeId: rt :nameId
    if co.some then {
        return co
    }
    return ztypes.tid.zero
}

# probeScopeTyperefRo -- probeScopeTyperef's read half: the Decl child's
# already-minted id, else the unit type's member index. Never mints; a name
# whose id only a mint leg could produce answers 0.
probeScopeTyperefRo: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    root: ztypes.declid
    nameId: zast.nameid
    depth: u64
} out ztypes.tid is {
    if nameId.isZero then return ztypes.tid.zero
    if root.isZero then return ztypes.tid.zero
    if depth > 8 then return ztypes.tid.zero
    cid: typing.declFindChild parentDeclId: root :nameId
    if cid.notZero then {
        ctid: ztypes.tid
        isRx: false
        decl: typing.decls.get i: cid
        ctid = decl.typeId
        if decl.kind.reexportDecl then isRx = true
        if ctid.notZero then return ctid
        if isRx then {
            # a re-export the walk never touched: follow the target by
            # reading the ids off its def node -- never lay the edge
            alTgt: reexportTargetIdsOf :typing :ast declId: cid
            if alTgt.unitName.notZero then {
                return (
                    probeScopeTyperefRo
                    :ast
                    :typing
                    root: (unitDeclOfName :typing nameId: alTgt.unitName)
                    nameId: alTgt.defName
                    depth: depth + 1
                )
            }
        }
    }
    rt: typing.declTypeOf declId: root
    if rt.isZero then return ztypes.tid.zero
    co: typing.declChildOfId parentTypeId: rt :nameId
    if co.some then {
        return co
    }
    return ztypes.tid.zero
}

# walkLookupTyperefRo -- the post-typecheck read-only environment walk: the
# nearest scope that holds the name answers (nearestScopeOf), from what
# resolution already minted, and an outer scope never stands in for it. The
# emitter consumes and never demands, so the mint legs (re-export aliases,
# const folds, in-place demands) have nothing left to do by the time it asks.
walkLookupTyperefRo: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    unitDecl: ztypes.declid
    scope: ztypes.declid
    base: StringView
} out optionval ztypes.tid is {
    baseId: zast.poolFind pool: ast.names text: base
    if baseId.isZero then return (optionval.none ztypes.tid)
    return (walkLookupTyperefByIdRo :typing :scope :ast :unitDecl :baseId)
}

# walkLookupTyperefByIdRo -- walkLookupTyperefRo for a name already interned:
# the same read-only scope walk, answering only ids resolution minted.
walkLookupTyperefByIdRo: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    unitDecl: ztypes.declid
    scope: ztypes.declid
    baseId: zast.nameid
} out optionval ztypes.tid is {
    if baseId.isZero then return (optionval.none ztypes.tid)
    at: nearestScopeOf :typing scope: (typeargs.scopeFor :typing :scope :unitDecl) :baseId
    if at.isZero then return (optionval.none ztypes.tid)
    r: probeScopeTyperefRo :ast :typing root: at nameId: baseId depth: 0
    if r.isZero then return (optionval.none ztypes.tid)
    return (optionval.some r)
}

# resolveUnitChildRo -- resolveUnitChild's read half: the already-minted
# Decl-tree answer, else the unit type's member index. Never mints.
resolveUnitChildRo: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out optionval ztypes.tid is {
    r: probeScopeTyperefRo :ast :typing root: unitDecl :nameId depth: 0
    if r.notZero then return (optionval.some r)
    return (optionval.none ztypes.tid)
}

# declOfUnitDefIds -- declOfUnitDef for a caller holding BOTH ids: unit
# root by id, then the child edge. No name is interned and no key is built.
declOfUnitDefIds: function {
    typing: ztyping.ZTyping.view
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    if nameId.isZero then return ztypes.declid.zero
    ro: unitDecl
    if ro.notZero then {
        d: typing.declFindChild parentDeclId: ro :nameId
        if d.notZero then return d
        # a definition the unit's `public:` block makes is on its surface
        pb: typing.declPublicNsOf owner: ro
        if pb.notZero then return (typing.declFindChild parentDeclId: pb :nameId)
    }
    return ztypes.declid.zero
}

# childOfWalkIds -- the two-segment walk with both segments already interned.
childOfWalkIds: function {
    typing: ztyping.ZTyping.view
    unitDecl: ztypes.declid
    name: zast.nameid
} out optionval ztypes.tid is {
    ro: typing.declTypeOf declId: unitDecl
    if ro.notZero then {
        return (typing.declChildOfId parentTypeId: ro nameId: name)
    }
    return (optionval.none ztypes.tid)
}

# unitchildhit -- resolvedByIdsRo's answer, and whether it was reached by
# following a re-export: that answer is the one resolvedByIds lays on the unit's
# member index.
unitchildhit: record {
    # the type `unit.name` resolves to; none on a miss
    tid: optionval ztypes.tid
    # reached through a re-export of another unit's definition
    viaReexport: bool
}

# resolvedByIds -- resolve a `unit.name` id pair to its type id: resolvedByIdsRo,
# and where the answer came through a re-export, the unit->alias edge laid so
# later probes resolve through childOf.
resolvedByIds: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    name: zast.nameid
} out optionval ztypes.tid is {
    h: unitChildHit typing: st.typing :ast :unitDecl :name
    if h.viaReexport then {
        tgo: h.tid
        if tgo.some then {
            uro: st.typing.declTypeOf declId: unitDecl
            if uro.notZero when name.notZero then (
                st.typing.setMemberType
                parentTypeId: uro
                nameId: name
                childTypeId: tgo
            )
        }
    }
    return h.tid
}

# resolvedByIdsRo -- resolve a `unit.name` id pair to its type id without
# writing: the member-index walk, the public-block surface, then the re-export
# target read. The post-typecheck readers hold views and never lay the edge.
resolvedByIdsRo: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    unitDecl: ztypes.declid
    name: zast.nameid
} out optionval ztypes.tid is {
    return (unitChildHit :typing :ast :unitDecl :name).tid
}

# unitChildHit -- the one read both resolvedByIds forms make: the member-index
# walk, the public-block surface, then the re-export target.
unitChildHit: function {
    ast: Ast.view
    typing: ztyping.ZTyping.view
    unitDecl: ztypes.declid
    name: zast.nameid
} out unitchildhit is {
    none: unitchildhit tid: optionval.none ztypes.tid viaReexport: false
    wo: childOfWalkIds :typing :unitDecl :name
    if wo.some then {
        return (unitchildhit tid: optionval.some wo viaReexport: false)
    }
    alDecl: declOfUnitDefIds :typing :unitDecl nameId: name
    # a definition the unit's `public:` block makes: on the unit's surface,
    # so `unit.name` reaches it, but NOT laid on the unit's member index --
    # that index also answers bare names written inside the unit, and the
    # block's definitions are reached from there by `public.name` alone
    {
        alT: typing.declTypeOf declId: alDecl
        alP: typing.declParentOf declId: alDecl
        alRoot: ztypes.declid
        if unitDecl.notZero then alRoot = unitDecl
        if alT.notZero when alP.notZero when alP != alRoot then {
            return (unitchildhit tid: optionval.some alT viaReexport: false)
        }
    }
    alTgt: reexportTargetIdsOf :typing :ast declId: alDecl
    if alTgt.unitName.notZero then {
        tgo: (
            childOfWalkIds
            :typing
            unitDecl: (unitDeclOfName :typing nameId: alTgt.unitName)
            name: alTgt.defName
        )
        if tgo.some then {
            return (unitchildhit tid: optionval.some tgo viaReexport: true)
        }
    }
    return none
}

# resolve one name inside a unit, which is the single step every dotted path
# is built from
resolveUnitChild: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out optionval ztypes.tid is {
    dt: declProbeUnitChildRoot :st :ast unitRoot: unitDecl :nameId
    if dt.notZero then return (optionval.some dt)
    ro: st.typing.declTypeOf declId: unitDecl
    if ro.notZero then {
        co: st.typing.declChildOfId parentTypeId: ro :nameId
        if co.some then {
            return (optionval.some co)
        }
    }
    # miss: the alias follow lays the unit->alias edge, so the next probe
    # resolves through childOf above
    return (resolvedByIds :st :ast :unitDecl name: nameId)
}

# nearestScopeOf -- the scope the type-ref walk answers `baseId` from: the first,
# from `scope` (0: the prelude alone) through each enclosing unit scope outward
# to core, that declares the name or holds it in its unit type's member index.
# The nearest declaration wins whatever its state: an outer scope never answers
# a name a nearer one declares. Zero when no scope holds it.
nearestScopeOf: function {
    typing: ztyping.ZTyping.view
    scope: ztypes.declid
    baseId: zast.nameid
} out ztypes.declid is {
    cur: scope
    for cur.notZero loop {
        if cur == typing.coreUnitRoot then {
            cur = ztypes.declid
        } else {
            if (scopeHoldsName :typing root: cur nameId: baseId) then return cur
            cur = unitScopeOf :typing declId: (typing.declParentOf declId: cur)
        }
    }
    core: typing.coreUnitRoot
    if core.notZero when (scopeHoldsName :typing root: core nameId: baseId) then return core
    return ztypes.declid
}

# scopeHoldsName -- whether the unit scope `root` declares `nameId`, or holds it
# in its unit type's member index (a unit mono, a namespace binding).
scopeHoldsName: function {
    typing: ztyping.ZTyping.view
    root: ztypes.declid
    nameId: zast.nameid
} out bool is {
    if (typing.declFindChild parentDeclId: root :nameId).notZero then return true
    rt: typing.declTypeOf declId: root
    if rt.isZero then return false
    return (typing.declChildOfId parentTypeId: rt :nameId).some
}

# canonShellTid -- the canonical id for a SHELL stamp value, 0 to leave
# the stamp alone. Mirrors canonicalizeShellChildren's shell detection
# (no defining unit, not a generic param / scalar shell);
# memoized per shell id.
canonShellTid: function {
    ast: Ast
    st: zenv.ZSymbolTable
    cache: (IdMapV ztypes.tid v: ztypes.tid)
    tid: ztypes.tid
    unitDecl: ztypes.declid
    scope: ztypes.declid
} out ztypes.tid is {
    if tid.isZero then return ztypes.tid.zero
    co: cache.get key: tid
    if co.some then {
        return co
    }
    res: ztypes.tid
    ok: (st.reg.typetypeOf typeId: tid) != ztypes.ztypetype.genericParam
    # a registered mono is inherently canonical (its name resolves back to
    # itself); only a homeless placeholder shell needs the name lookup
    if ok when (st.reg.genericOriginOf :tid).notZero then ok = false
    if ok when (unitDeclOfTid reg: st.reg typing: st.typing :tid).notZero then ok = false
    if ok then {
        nmNode: st.reg.nameOf :tid
        if nmNode.length > 0 then {
            rid: shellResolveByName :st :scope :ast fromUnit: unitDecl name: nmNode.stringView
            if rid.notZero when rid != tid then res = rid
        }
    }
    kc: tid
    vc: res
    cache.set key: kc value: vc
    return res
}

# canonicalizeShellNodeStamps -- checkBodies runs BEFORE the shell-child
# canonicalization, so expression nodes typed through a then-shell edge
# carry the shell id in nodeType (and dpTaggedParent):
# the emitter reads receiver types from those stamps, and a shell has no
# origin/children to dispatch on. Rebind them to the canonical type the way
# canonicalizeShellChildren rebinds the members.
canonicalizeShellNodeStamps: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
} is {
    cache: IdMapV ztypes.tid v: ztypes.tid
    nameCount: st.typing.nodeType.length
    ci: zast.nodeid
    for ci.u64 < nameCount loop {
        cv: st.typing.nodeType.get i: ci
        if cv.notZero then {
            rid: canonShellTid :ast :st :scope :cache tid: cv :unitDecl
            if rid.notZero then {
                ztyping.nodeTypeSet tbl: st.typing.nodeType nid: ci tid: rid
            }
        }
        ci = ci.next
    }
    dKeys: ListVal zast.nodeid
    dIns: ListVal ztypes.tid
    for each edKeys: st.typing.dpTaggedParent.iterateItems loop {
        dKeys.append edKeys.key
        dIns.append edKeys.value
    }
    canonShellRows :ast :st :unitDecl :scope :cache rows: dIns
    di: u64
    for di < dKeys.length loop {
        st.typing.dpTaggedParent.set key: (dKeys.get i: di) value: (dIns.get i: di)
        di = di + 1
    }
    pKeys: ListVal zast.nodeid
    pIns: ListVal ztypes.tid
    for each epKeys: st.typing.dpArmPredicate.iterateItems loop {
        pKeys.append epKeys.key
        pIns.append epKeys.value
    }
    canonShellRows :ast :st :unitDecl :scope :cache rows: pIns
    pi: u64
    for pi < pKeys.length loop {
        st.typing.dpArmPredicate.set key: (pKeys.get i: pi) value: (pIns.get i: pi)
        pi = pi + 1
    }
    tKeys: ListVal zast.nodeid
    tIns: ListVal ztypes.tid
    for each etKeys: st.typing.dpTagRead.iterateItems loop {
        tKeys.append etKeys.key
        tIns.append etKeys.value
    }
    canonShellRows :ast :st :unitDecl :scope :cache rows: tIns
    ti: u64
    for ti < tKeys.length loop {
        st.typing.dpTagRead.set key: (tKeys.get i: ti) value: (tIns.get i: ti)
        ti = ti + 1
    }
    gKeys: ListVal zast.nodeid
    gIns: ListVal ztypes.tid
    for each egKeys: st.typing.postGuardTid.iterateItems loop {
        gKeys.append egKeys.key
        gIns.append egKeys.value
    }
    canonShellRows :ast :st :unitDecl :scope :cache rows: gIns
    gi: u64
    for gi < gKeys.length loop {
        st.typing.postGuardTid.set key: (gKeys.get i: gi) value: (gIns.get i: gi)
        gi = gi + 1
    }
    anids: ListVal ztypes.tid
    avals: ListVal ztypes.tid
    aKeys: ListVal ztypes.tid
    aIns: ListVal ztypes.tid
    for each a: st.typing.tagAccessor.iterateItems loop {
        aKeys.append a.key
        aIns.append a.value.tid
    }
    ai: u64
    for ai < aKeys.length loop {
        resolvedTid: canonShellTid :ast :st :scope :cache tid: (aIns.get i: ai) :unitDecl
        if resolvedTid.notZero then {
            anids.append (aKeys.get i: ai)
            avals.append resolvedTid
        }
        ai = ai + 1
    }
    # only the type is canonicalised: each entry keeps its name
    w: u64
    for w < anids.length loop {
        k6: anids.get i: w
        acc: st.typing.tagAccessor.get key: k6
        if acc.some then {
            row: ztyping.tagaccessor name: acc.name tid: (avals.get i: w)
            st.typing.tagAccessor.set key: k6 value: row
        }
        w = w + 1
    }
}

# canonShellRows -- re-point a collected column of stamp values at the
# canonical shell type of each, in place; a row that resolves to nothing keeps
# what it had. The column is collected by the caller because a table cannot be
# passed beside the symbol table that owns it, and writing under a live
# iteration would set a row the walk is still standing in.
canonShellRows: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    cache: (IdMapV ztypes.tid v: ztypes.tid)
    rows: ListVal ztypes.tid
} is {
    i: u64
    for i < rows.length loop {
        rid: canonShellTid :ast :st :scope :cache tid: (rows.get :i) :unitDecl
        if rid.notZero then rows.set :i val: rid
        i = i + 1
    }
}

# shellResolveByName -- the emitter's shell resolution order for `name` seen
# from `fromUnit`: the unit's own child, the system unit's, then the type-ref
# walk. 0 when nothing resolves.
shellResolveByName: function {
    ast: Ast
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    fromUnit: ztypes.declid
    name: StringView
} out ztypes.tid is {
    nameId: zast.poolFind pool: ast.names text: name
    r1: resolveUnitChild :st :ast unitDecl: fromUnit :nameId
    if r1.some then {
        return r1
    }
    r2: resolveUnitChild :st :ast unitDecl: st.typing.systemUnitRoot :nameId
    if r2.some then {
        return r2
    }
    r3: bodies.walkLookupTyperef :st :scope :ast unitDecl: fromUnit base: name
    if r3.some then {
        return r3
    }
    return ztypes.tid.zero
}

# memberTypeIsShell -- whether a member's recorded type may be a SHELL: a type
# stamped by name before its declaration resolved, which the pass below
# rebinds. A generic parameter, a mono, a unit, a unit mono's own substituted
# functions (minted per instance with no declaration of their own; resolving
# them by name in the template's unit would rebind them to the template's
# methods) and a member minted as the owner's own -- a synthesized `create`,
# which resolving by name rebinds to whatever `create` the scope declares --
# are not shells.
memberTypeIsShell: function {
    st: zenv.ZSymbolTable
    # the owning type and the member's recorded type
    rpt: ztypes.tid
    cto: ztypes.tid
} out bool is {
    if cto.isZero then return false
    ct: cto
    if (st.reg.ownerTidOf tid: ct) == rpt then return false
    if (st.reg.typetypeOf typeId: ct) == ztypes.ztypetype.genericParam then return false
    if (st.reg.genericOriginOf tid: ct).notZero then return false
    if (unitDeclOfTid reg: st.reg typing: st.typing tid: ct).notZero then return false
    pt: rpt
    ptOrigin: st.reg.genericOriginOf tid: pt
    ptIsUnit: (st.reg.typetypeOf typeId: pt) == ztypes.ztypetype.unitType
    if ptIsUnit when ptOrigin.notZero then return false
    return true
}

# shellNameToResolve -- the name a shell resolves by: the recorded type's name.
shellNameToResolve: function {st: zenv.ZSymbolTable cto: ztypes.tid} out String is {
    return (st.reg.nameOf tid: cto)
}

# shellChildScope -- where a member's shell resolves: the scope its parent
# type is declared in. A specialisation has no declaration of its own yet
# and keeps the scope it is given.
shellChildScope: function {
    st: zenv.ZSymbolTable rpt: ztypes.tid scope: ztypes.declid
} out ztypes.declid is {
    pt: rpt
    if (st.reg.genericOriginOf tid: pt).notZero then return scope
    pdo: st.typing.declIdOfType typeId: pt
    if pdo.isZero then return scope
    return pdo
}

# canonicalizeShellChildren -- rebind every member whose declared type is a
# SHELL id (a name-minted reference with no defining unit) to the canonical
# type, resolved in the member's parent's defining unit with the emitter's
# resolution order. Runs post-resolution so the emitter reads canonical child
# ids and never re-resolves a child by name.
canonicalizeShellChildren: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
} is {
    # stage every member first: the loop rebinds member types as it goes, and
    # a declaration write cannot run while an enumeration of the typing is open
    owns: ListVal ztypes.tid
    nms: ListVal zast.nameid
    ctds: ListVal ztypes.tid
    st.typing.declAllMemberRows lastTid: st.reg.nextTid owners: owns names: nms tids: ctds
    ri: u64
    rn: owns.length
    for ri < rn loop {
        rpt: owns.get i: ri
        rnm: nms.get i: ri
        cto: ctds.get i: ri
        ri = ri + 1
        if (memberTypeIsShell :st :rpt :cto) then {
            nmNode: shellNameToResolve :st :cto
            if nmNode.length > 0 then {
                # the child's name resolves in the unit of its parent type
                pu: unitDecl
                puo: unitDeclOfTid reg: st.reg typing: st.typing tid: rpt
                if puo.notZero then pu = puo
                rf: shellChildScope :st :rpt :scope
                rid: shellResolveByName :st scope: rf :ast fromUnit: pu name: nmNode.stringView
                if rid.notZero when rid != cto then {
                    st.typing.setMemberType parentTypeId: rpt nameId: rnm childTypeId: rid
                }
            }
        }
    }
}

# unitFileNote -- the note an unknown member of a unit carries: the file the
# unit resolved to. A report written in one unit about another (core's
# `print: io.print`, when a project's own io.z is the `io` it reaches) then
# says which file that other unit is. "" when the file is not known.
unitFileNote: function {
    st: zenv.ZSymbolTable.view ast: Ast.view unitDecl: ztypes.declid
} out String is {
    if unitDecl.isZero then return "".string
    d: st.typing.decls.get i: unitDecl
    if d.node.isZero then return "".string
    p: st.typing.filePaths.get key: (ast.rowFile.get i: d.node)
    match (
        p
    ) case some then {
        return "unit '\{zast.nameTextAt :ast ref: d.name}' is \{p}"
    } case none then {
        return "".string
    }
}

# typecheck -- entry point. Registers a UNIT type per unit and resolves the main
# unit's definition signatures, then demand-resolves the cross-unit types those
# signatures referenced. The registry is supplied by the caller, read by the dumper.
# typecheck -- the entry point: index every unit's declarations, resolve from
# the program's `main` outward (or every definition under `eager`), walk the
# bodies, and return the walk state whose `typing` and `reg` hold the result.
typecheck: function {
    program: Ast
    reg: ztypes.ZTypeRegistry.take
    # where demand starts besides what uses reach
    reach: checkreach
    requireMain: bool
    dumpRows: bool
    # each loaded file's path as a location shows it (filePathsOf)
    filePaths: (IdMapR zvfs.fsno V: String).take
} out zenv.ZSymbolTable is {
    nodeEstT: u64
    nodeEstT = program.nodes.length
    ty: ztyping.newTyping nodeEst: nodeEstT
    ty.filePaths = filePaths.take
    ty.eagerAll = reach.everything
    ty.mainUnitAll = reach.mainUnit
    ty.requireMain = requireMain
    ty.dumpRows = dumpRows
    muNid: nameIdOf ast: program name: program.mainUnitName.stringView
    reg.setMainUnit nameId: muNid
    st: zenv.newSymbolTable :reg typing: ty
    # every unit's root type and name, then the def index -- every top-level
    # name of every unit, marked not yet typechecked -- BEFORE any resolution,
    # so a reference always finds its declaration and never mints a shell for
    # a name that has one. Generator lowering indexes what it synthesizes.
    memberaccess.lowerDeclaredGenerators :st :program
    registerUnitRoots :st :program
    declare.indexUnitDefs :st scope: ztypes.declid :program
    {
        (
            declare.declareCanonicalType
            :st
            scope: ztypes.declid
            ast: program
            unitDecl: st.typing.systemUnitRoot
            ownerNameId: zast.nameid
            name: "never"
            typetype: ztypes.ztypetype.neverType
        )
        st.typing.nullTypeId = (
            declare.declareCanonicalType
            :st
            scope: ztypes.declid
            ast: program
            unitDecl: st.typing.systemUnitRoot
            ownerNameId: zast.nameid
            name: "null"
            typetype: ztypes.ztypetype.nullType
        )
        # `bool` RESOLVED ONCE, HERE. methodReturnOf answers it for a
        # synthesised comparison and holds no ast to look it up with, and
        # resolving it where such a member is minted means minting DURING
        # record and variant resolution -- which pulls bool ahead of the demand
        # order and broke an unrelated compile-time fold in quadfloat. Before
        # any user type is resolved there is no order
        # to disturb, and both the lazy and the eager tier pass through here.
        stdTid ast: program :st wk: zast.wellKnown.slot.wkBool
    }
    # the main unit's passes run in the main unit's scope; a walk that enters
    # another declaration sets its own and restores this one
    # the main unit's root is the scope the program-level passes resolve in
    rf: ztypes.declid
    mro: st.typing.declFindChild parentDeclId: st.typing.programRoot nameId: st.reg.regMainUnitId
    if mro.notZero then rf = mro
    registerAndResolveMain :st scope: rf :program
    resolveMainUnitInstantiations :st scope: rf :program
    # read before the call: `.not` is a receiver call on the field, and `st`
    # is lent to the same call
    rootOnlyMain: st.typing.eagerAll.not
    scanMainBodyCalls :st scope: rf :program rootOnly: rootOnlyMain
    demandAllDefs :st :program
    resolveDemands :st scope: rf :program
    resolveConstantDefs :st scope: rf :program
    bodies.completeUnitInstantiations :st scope: rf :program
    declare.applyUnitVisibility :st :program
    stampTyperefs :st :program
    checkBodies :st scope: rf :program
    walkGenericUnitTemplates :st scope: rf :program
    {
        ctorUnit: unitDeclOfNameOrOwn :st scope: rf nameId: st.reg.regMainUnitId
        stampCtorDefaults ast: program :st scope: rf unitDecl: ctorUnit
    }
    foldLiteralStamps :st :program
    {
        canonUnit: unitDeclOfNameOrOwn :st scope: rf nameId: st.reg.regMainUnitId
        canonicalizeShellChildren ast: program :st scope: rf unitDecl: canonUnit
        canonicalizeShellNodeStamps ast: program :st scope: rf unitDecl: canonUnit
        statics.foldInstanceConstants ast: program :st
        checkGenericBounds ast: program :st
        numerics.checkUnionArmSlots ast: program :st
        checkImplementations ast: program :st
        checkHashKeys ast: program :st
        conform.checkSpecStandIns ast: program :st
        checkBareGenericReturns ast: program :st
        recordDeclaredReturns :st
        reportTypedefClashes ast: program :st
        numerics.checkWideConstants ast: program :st
        memberaccess.markAggsReached ast: program :st
        stampAliasValues :st ast: program
        conform.stampGenericBounds :st ast: program
        stampGenericParams :st ast: program
    }
    return st
}
