# declare -- indexing a unit and declaring its definitions, members and
# visibility. An implementation subunit of ztypecheck.

# addResolveError -- a diagnostic raised from the resolution core, which
# holds no source node: location-free, deduped by message.
addResolveError: function {st: zenv.ZSymbolTable e: zast.err msg: String} is {
    dup: false
    for each pe: st.typing.errors loop {
        if pe.msg.stringView == msg then dup = true
    }
    if dup.not then {
        en: String
        eh: String
        st.typing.noteReport
        st.typing.errors.append (
            zast.ErrorData
            nodeid: zast.nodeid
            lineno: 0
            colno: 0
            width: 1
            err: e
            msg: msg.copy
            fsno: zvfs.fsno
            note: en
            hint: eh
        )
    }
}

# addResolveErrorAt -- a resolution-time diagnostic: addErrorWithHint with no note and
# no hint, so a re-entrant resolution pass reports through the same dedup.
addResolveErrorAt: function {
    st: zenv.ZSymbolTable
    nodeid: zast.nodeid
    lineno: u32
    colno: u32
    e: zast.err
    msg: String
    width: u64
} is {
    addErrorWithHint :st :nodeid :lineno :colno :e msg: msg.copy note: String hint: String :width
}

# indexUnitDefs -- pre-scan every unit's top-level definitions into a
# (unit.name) -> typetype index BEFORE resolution, so a reference can declare the
# ONE canonical record id (declare-before-bind) instead of an anonymous shell. No
# ids minted here. Dotted-path aliases and the null/never empty types keep their
# existing post-demand handling (defTypetypeOf returns none for them).
indexUnitDefs: function {st: zenv.ZSymbolTable scope: ztypes.declid program: Ast} is {
    {
        unitCount: program.units.length
        unitIdx: u64
        for unitIdx < unitCount loop {
            ruId: program.units.get i: unitIdx
            unitIdx = unitIdx + 1
            resolve.indexOneUnitDef :st :program :ruId
        }
        st.walk.defNodeIndexBuilt = true
        cro: (
            st.typing.declFindChild
            parentDeclId: st.typing.programRoot
            nameId: zast.wellKnown.slot.unCore
        )
        if cro.notZero then st.typing.coreUnitRoot = cro
        {
            clo: (
                st.typing.declFindChild
                parentDeclId: st.typing.programRoot
                nameId: zast.wellKnown.slot.unCollections
            )
            if clo.notZero then st.typing.collectionsUnitRoot = clo
            mro: (
                st.typing.declFindChild
                parentDeclId: st.typing.programRoot
                nameId: st.reg.regMainUnitId
            )
            if mro.notZero then st.typing.mainUnitRoot = mro
            # the fourth anchor is established here with the rest: every unit
            # the checker names outright is an id from this point on, and a
            # spelling never decides which one it meant
            sro: (
                st.typing.declFindChild
                parentDeclId: st.typing.programRoot
                nameId: zast.wellKnown.slot.unSystem
            )
            if sro.notZero then st.typing.systemUnitRoot = sro
            tro: (
                st.typing.declFindChild
                parentDeclId: st.typing.programRoot
                nameId: zast.wellKnown.slot.unThread
            )
            if tro.notZero then st.walk.threadUnitRoot = tro
        }
        # a type minted before the def index existed has no def link; link any
        # still-unlinked named system def now
        cu: ztypes.tid
        tidMark: st.reg.nextTid
        for cu < tidMark loop {
            unl: false
            if (st.typing.declIdOfType typeId: cu).isZero then unl = true
            if unl then {
                cnm: st.reg.nameOf tid: cu
                if cnm.length > 0 then {
                    (
                        linkDeclType
                        :st
                        :scope
                        ast: program
                        unitDecl: st.typing.systemUnitRoot
                        name: cnm.stringView
                        tid: cu
                    )
                }
            }
            cu = cu.next
        }
    }
}

# indexUnitBody -- index one unit's top-level defs, in body order.
indexUnitBody: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitopId: zast.nodeid
    unitDeclId: ztypes.declid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitopId
    {
        publicDeclId: ztypes.declid
        publicOpId: zast.nodeid
        vx19: u64
        for vx19 < bodyIds.count loop {
            bmId: zast.kidAt kids: ast.kids span: bodyIds i: vx19
            vx19 = vx19 + 1
            bm: argRefAt :ast nid: bmId
            if bm.nid.notZero then {
                defDeclId: (
                    indexDeclDef
                    :st
                    :ast
                    parentDeclId: unitDeclId
                    nameRef: bm.name
                    nopNodeId: bm.nid
                    opNodeId: bm.operation
                )
                if (zast.unitOpKindIs :ast opId: bm.operation k: zast.unitkind.publicNs) then {
                    publicDeclId = defDeclId
                    publicOpId = bm.operation
                }
            }
        }
        if publicDeclId.notZero then {
            (
                indexDeclPublicEntries
                :st
                :ast
                ownerDeclId: unitDeclId
                pubDeclId: publicDeclId
                pubOpId: publicOpId
            )
        }
    }
}

# indexDeclDef -- create the Decl for one definition (a namedoperation's
# name + operation) under parentDeclId, descending into the definition's
# own namespace (function params, object members, nested unit bodies).
# Returns the new DeclId.
indexDeclDef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    parentDeclId: ztypes.declid
    nameRef: zast.nameid
    nopNodeId: zast.nodeid
    opNodeId: zast.nodeid
} out ztypes.declid is {
    defDecl: ztypes.declid
    opNid: opNodeId
    opArm: rowArmAt :ast nid: opNid
    match (
        opArm
    ) case listblock then {
        defDecl = (
            st.typing.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.staticListDecl
            node: nopNodeId
        )
        indexDeclStaticListInner :st :ast declId: defDecl staticListNodeId: opNodeId
    } case functiondef then {
        defDecl = (
            st.typing.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.funcDecl
            node: nopNodeId
        )
        indexDeclFnInner :st :ast declId: defDecl fnNodeId: opNodeId
    } case objectdef then {
        defDecl = (
            st.typing.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.typeDecl
            node: nopNodeId
        )
        indexDeclObjInner :st :ast declId: defDecl objNodeId: opNodeId
    } case unitdef then {
        if (zast.unitOpKindIs :ast opId: opNodeId k: zast.unitkind.publicNs) then {
            # the exported-namespace block: entries become name -> sibling
            # edges, filled by indexDeclPublicEntries after the unit walk.
            # Any block anywhere -- a nested unit's, a hidden subunit's --
            # restricts a surface, so the visibility check is armed.
            defDecl = (
                st.typing.declNew
                name: nameRef
                parent: parentDeclId
                kind: ztyping.declkind.publicNs
                node: nopNodeId
            )
            st.walk.privacySeen = true
        } else {
            defDecl = (
                st.typing.declNew
                name: nameRef
                parent: parentDeclId
                kind: ztyping.declkind.unitDecl
                node: nopNodeId
            )
            # a namespace, subunit or template is a lookup scope
            if (zast.unitOpHasBody :ast opId: opNodeId) then (
                st.typing.declSetUnitScope
                declId: defDecl
            )
            npub: ztypes.declid
            npubOp: zast.nodeid
            bodyIds: zast.unitBodyIdsAt :ast unitId: opNodeId
            vx29: u64
            for vx29 < bodyIds.count loop {
                nmId: zast.kidAt kids: ast.kids span: bodyIds i: vx29
                vx29 = vx29 + 1
                nm: argRefAt :ast nid: nmId
                if nm.nid.notZero then {
                    nd: (
                        indexDeclDef
                        :st
                        :ast
                        parentDeclId: defDecl
                        nameRef: nm.name
                        nopNodeId: nm.nid
                        opNodeId: nm.operation
                    )
                    if (zast.unitOpKindIs :ast opId: nm.operation k: zast.unitkind.publicNs) then {
                        npub = nd
                        npubOp = nm.operation
                    }
                }
            }
            # a nested unit's `public:` block fills its namespace after the
            # body walk, as a file unit's does (entries name later siblings)
            if npub.notZero then {
                (
                    indexDeclPublicEntries
                    :st
                    :ast
                    ownerDeclId: defDecl
                    pubDeclId: npub
                    pubOpId: npubOp
                )
            }
        }
    } case dottedpath then {
        # a cross-unit re-export alias: its own Decl and node; shares the
        # target's type id once minting routes through the Decl layer. A
        # numeric literal at its root is a typed constant (`Q: 0.25.f64`),
        # which keeps its constDecl as the bare literal does
        dkind: ztyping.declkind.reexportDecl
        if (isNumericLiteralNameAt :ast ref: (rootNameIdOf :ast n: (ast.nodes.get i: opNid))) then {
            dkind = ztyping.declkind.constDecl
        }
        defDecl = st.typing.declNew name: nameRef parent: parentDeclId kind: dkind node: nopNodeId
    } case atomid then {
        # a bare name aliases too (`Same: Holder`), exactly as the dotted form
        # does -- the target just lives in THIS unit, so the alias-follow reads
        # the enclosing unit for the missing segment. A numeric literal is the
        # unit-constant shape and keeps its constDecl.
        ar: valuechecks.atomRefAt :ast nid: opNid
        anm: zast.nameTextAt :ast ref: ar.name
        akind: ztyping.declkind.reexportDecl
        if (statics.isNumericLiteralName name: anm.stringView
        ) then akind = ztyping.declkind.constDecl
        defDecl = st.typing.declNew name: nameRef parent: parentDeclId kind: akind node: nopNodeId
    } else {
        defDecl = (
            st.typing.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.constDecl
            node: nopNodeId
        )
    }
    return defDecl
}

# indexDeclFnInner -- parameter and as-member Decls under a function
# declaration (parameters are in the tree: a navigable signature).
indexDeclFnInner: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    declId: ztypes.declid
    fnNodeId: zast.nodeid
} is {
    fn: ast.nodes.get i: fnNodeId
    if fn.functiondef then {
        for each pId: (zast.kidsOf :ast span: fn.parameters) loop {
            pn: ast.nodes.get i: pId
            if pn.namedoperation then {
                (
                    st.typing.declNew
                    name: pn.name
                    parent: declId
                    kind: ztyping.declkind.paramDecl
                    node: pn.nodeid
                )
            }
        }
        for each aId: (zast.kidsOf :ast span: fn.asItems) loop {
            an: ast.nodes.get i: aId
            if an.namedoperation then {
                (
                    indexDeclAsMember
                    :st
                    :ast
                    parentDeclId: declId
                    nameRef: an.name
                    nopNodeId: an.nodeid
                    opNodeId: an.operation
                )
            }
        }
    }
}

# indexDeclStaticListInner -- member Decls under a list (enum) declaration: one arm
# per element, named the way resolveStaticList names it, so an unnamed element
# takes its ordinal.
indexDeclStaticListInner: function {
    st: zenv.ZSymbolTable
    ast: Ast
    declId: ztypes.declid
    staticListNodeId: zast.nodeid
} is {
    nrefs: ListVal zast.nameid
    nodes: ListVal zast.nodeid
    ords: ListVal u64
    {
        dn: ast.nodes.get i: staticListNodeId
        if dn.listblock then {
            ord: u64
            for each eId: (zast.kidsOf :ast span: dn.elements) loop {
                en: ast.nodes.get i: eId
                if en.namedoperation then {
                    nrefs.append en.name
                    nodes.append en.nodeid
                    ords.append ord
                }
                ord = ord + 1
            }
        }
    }
    i: u64
    n: nrefs.length
    for i < n loop {
        nr: nrefs.get :i
        nd: nodes.get :i
        od: ords.get :i
        i = i + 1
        if nr.isZero then {
            ots: "\{od}"
            nr = ast.internString text: ots.stringView
        }
        st.typing.declNew name: nr parent: declId kind: ztyping.declkind.armDecl node: nd
    }
}

# indexDeclObjInner -- member Decls under a type declaration: is-block
# entries (fields; arms for variant/union kinds) and as-block members.
indexDeclObjInner: function {
    st: zenv.ZSymbolTable
    ast: Ast
    declId: ztypes.declid
    objNodeId: zast.nodeid
} is {
    ob: objRefAt :ast nid: objNodeId
    if ob.kind.dataDef or ob.kind.choiceDef then st.typing.staticTypesSeen = true
    if ob.kind.choiceDef then st.walk.choiceNames.add item: (st.typing.declNameOf :declId)
    if ob.nid.notZero then {
        isArm: ob.kind.variantDef or ob.kind.unionDef or ob.kind.choiceDef
        kIit: u64
        for kIit < ob.nis loop {
            iId: zast.objIsItemAt :ast nid: ob.nid i: kIit
            kIit = kIit + 1
            itemNode: argRefAt :ast nid: iId
            if itemNode.nid.notZero then {
                if isArm then {
                    (
                        st.typing.declNew
                        name: itemNode.name
                        parent: declId
                        kind: ztyping.declkind.armDecl
                        node: itemNode.nid
                    )
                } else {
                    (
                        indexDeclAsMember
                        :st
                        :ast
                        parentDeclId: declId
                        nameRef: itemNode.name
                        nopNodeId: itemNode.nid
                        opNodeId: itemNode.operation
                    )
                }
            }
        }
        publicDeclId: ztypes.declid
        publicOpId: zast.nodeid
        kAit: u64
        for kAit < ob.nas loop {
            aId: zast.objAsItemAt :ast nid: ob.nid i: kAit
            kAit = kAit + 1
            an: argRefAt :ast nid: aId
            if an.nid.notZero then {
                if (zast.unitOpKindIs :ast opId: an.operation k: zast.unitkind.publicNs) then {
                    # the type's exported-namespace block: a publicNs Decl whose
                    # edges (public name -> internal member Decl) are filled after
                    # all members are indexed. Mirrors the unit `public:` block.
                    publicDeclId = (
                        st.typing.declNew
                        name: an.name
                        parent: declId
                        kind: ztyping.declkind.publicNs
                        node: an.nid
                    )
                    publicOpId = an.operation
                } else {
                    (
                        indexDeclAsMember
                        :st
                        :ast
                        parentDeclId: declId
                        nameRef: an.name
                        nopNodeId: an.nid
                        opNodeId: an.operation
                    )
                }
            }
        }
        if publicDeclId.notZero then {
            (
                indexDeclPublicEntries
                :st
                :ast
                ownerDeclId: declId
                pubDeclId: publicDeclId
                pubOpId: publicOpId
            )
        }
    }
}

# indexDeclAsMember -- one as-block member Decl: a method when the member
# is a function (with its own parameter Decls), a field-like entry
# otherwise (generic parameters, tag specs, member constants).
indexDeclAsMember: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    parentDeclId: ztypes.declid
    nameRef: zast.nameid
    nopNodeId: zast.nodeid
    opNodeId: zast.nodeid
} is {
    opNode: ast.nodes.get i: opNodeId
    if (typeref.asOpIsTypeShaped :ast :opNode) then st.walk.asTypeShapedNames.add item: nameRef
    match (
        opNode
    ) case functiondef then {
        md: (
            st.typing.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.methodDecl
            node: nopNodeId
        )
        indexDeclFnInner :st :ast declId: md fnNodeId: opNodeId
    } else {
        (
            st.typing.declNew
            name: nameRef
            parent: parentDeclId
            kind: ztyping.declkind.fieldDecl
            node: nopNodeId
        )
    }
}

# indexDeclPublicEntries -- fill a publicNs Decl's namespace. A `public:`
# block is a unit body: an entry that REFERENCES a sibling of the enclosing
# unit -- `:member`, or `alias: member` naming one -- becomes an exposed
# name -> sibling-declaration edge (no fresh row); any other entry is a
# DEFINITION of the block (a constant, a function, a type, an alias to a
# name outside the unit) and is indexed under the block like a nested
# unit's member. Runs after the unit's body walk so entries naming later
# siblings bind.
indexDeclPublicEntries: function {
    st: zenv.ZSymbolTable
    ast: Ast
    ownerDeclId: ztypes.declid
    pubDeclId: ztypes.declid
    pubOpId: zast.nodeid
} is {
    # the block's arm and entries are read as plain values: the index walk
    # below lends ast
    isUnit: false
    popArm: rowArmAt :ast nid: pubOpId
    if popArm.unitdef then isUnit = true
    if isUnit then {
        bodyIds: zast.unitBodyIdsAt :ast unitId: pubOpId
        vx39: u64
        for vx39 < bodyIds.count loop {
            mId: zast.kidAt kids: ast.kids span: bodyIds i: vx39
            vx39 = vx39 + 1
            m: argRefAt :ast nid: mId
            nested: refuseNestedVisibility :st :ast :m
            if m.nid.notZero when nested.not then {
                # the entry's value row is read through a view scoped to this
                # block: the index walk below lends ast
                iref: m.name
                isRef: false
                isLabel: false
                {
                    mop: ast.nodes.get i: m.operation
                    if mop.labelvalue then {
                        isRef = true
                        isLabel = true
                    }
                    if mop.atomid then {
                        iref = mop.name
                        isRef = true
                    }
                }
                tgt: ztypes.declid
                if isRef then tgt = st.typing.declFindChild parentDeclId: ownerDeclId nameId: iref
                if tgt.notZero then {
                    (
                        st.typing.declAddChildEdge
                        parentDeclId: pubDeclId
                        nameId: m.name
                        childDeclId: tgt
                    )
                    # the entry's value node (`:m` labelvalue / `alias: m`
                    # atom) is a navigable reference to the sibling def
                    memberaccess.stampRefDecl :st nid: m.operation declId: tgt
                } else if isLabel.not then {
                    (
                        indexDeclDef
                        :st
                        :ast
                        parentDeclId: pubDeclId
                        nameRef: m.name
                        nopNodeId: m.nid
                        opNodeId: m.operation
                    )
                }
            }
        }
    }
}

# linkDeclType -- record the canonical id on the indexed Decl and the Decl on
# the type, at the mint funnel. References that mint outside the def index (literal shells,
# forward names) find no Decl and no-op.
linkDeclType: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    scope: ztypes.declid
    name: StringView
    tid: ztypes.tid
} is {
    nid: nameIdOf :ast :name
    resolve.linkDeclTypeId :st :scope :unitDecl nameId: nid :tid
}

# declareCanonicalType -- get-or-declare the ONE canonical id for `unit.name` as a
# childOf edge under its unit, linked to its Decl. The single convergence point for both a
# reference (resolveAtomType) and the definition (resolveRecord and the other
# definition resolvers): whoever runs first mints; the rest reuse the same id. It
# declares the name only, so a demanded body still resolves lazily.
declareCanonicalType: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    # the type that owns this one when it is a member (`Type.method`), by
    # interned name id; 0 for a free definition. `name` is always the
    # definition's OWN name -- no qualified name is built, and none is parsed.
    ownerNameId: zast.nameid
    name: StringView
    typetype: ztypes.ztypetype
} out ztypes.tid is {
    # a spelling that reaches here as text is interned first, so the id form
    # can mint it by the same spelling
    nid: zast.poolFind pool: ast.names text: name
    if nid.isZero then nid = ast.internString text: name
    return (
        resolve.declareCanonicalTypeId
        :st
        :scope
        :ast
        :unitDecl
        :ownerNameId
        nameId: nid
        :typetype
    )
}

# asItemCanAlias -- the `as` item `item` of the type declared by `tdecl` has a
# value that may name a type: it is no method, generic parameter,
# implementation, tag spec, shorthand or opt-out (`create: null`).
asItemCanAlias: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    tdecl: ztypes.declid
    item: argref
} out bool is {
    if item.operation.isZero or (item.name == zast.wellKnown.slot.wkTag) then return false
    if (zast.implementBaseOf :ast opId: item.operation).notZero then return false
    if (zast.isGenericParamOp :ast opId: item.operation) then return false
    op: ast.nodes.get i: item.operation
    if op.functiondef or (isLabelValue :op) then return false
    return (namesNullType :st :ast ownerDecl: tdecl nameId: (zast.atomNameIdOf n: op)).not
}

# isLabelValue -- true when a node is a bare `:X` label-value (an anonymous
# implementation marker in an as-block parses as a namedoperation wrapping one).
isLabelValue: function {op: astnode.view} out bool is {
    match (
        op
    ) case labelvalue then {
        return true
    } else {
        return false
    }
}

# collectMentions -- every bare name a subtree reads, added to `into` by id: an
# atom, a `:name` argument (`name: name`), and the base of a dotted path. The
# selector after a dot names a member, not something in scope, and a match
# arm's payload binding is a name bound, not read; every other node is walked
# through its children (zast.childIds). checkTypedefShape asks it for the names
# a typedef's base reads.
collectMentions: function {ast: Ast.view n: astnode.view into: (IdSet zast.nameid).borrow} is {
    match (
        n
    ) case atomid then {
        into.add item: n.name
    } case labelvalue then {
        into.add item: n.name
    } case dottedpath then {
        collectMentions :ast n: (ast.nodes.get i: n.parent) :into
    } case caseclause then {
        collectMentions :ast n: (ast.nodes.get i: n.statement) :into
    } else {
        kids: zast.childIds :ast :n
        for each k: kids loop {
            collectMentions :ast n: (ast.nodes.get i: k) :into
        }
    }
}

# isBareGenericParam -- a generic-param definition in direct dotted form
# (`t: anyval.generic`); wrapped shapes (a def whose payload merely contains a
# constraint) are not unit-level generic params.
isBareGenericParam: function {ast: Ast.view op: astnode.view} out bool is {
    match (
        op
    ) case dottedpath then {
        return (zast.markerKindOfLeaf :ast leaf: op.child).genericBound
    } else {
        return false
    }
}

# isGenericParam -- true when a type-expr is a generic-parameter constraint
# (`u64.generic` / `anyval.generic`): a dottedpath whose leaf is `generic`,
# peeling a parameterized `call` around it.
isGenericParam: function {ast: Ast.view op: astnode.view} out bool is {
    match (
        op
    ) case call then {
        return (isGenericParam :ast op: (ast.nodes.get i: op.callable))
    } case dottedpath then {
        return (zast.markerKindOfLeaf :ast leaf: op.child).genericBound
    } else {
        return false
    }
}

# declOfFnDef -- the Decl of a resolved function definition: a free
# function's unit child, or a method's member Decl under its owner (the
# defName arrives owner-composed -- "u8.+" -- and the owner may be the
# DECLARING protocol rather than thisName, so the owner splits at the
# composed name's last dot). 0 when unindexed (synthesized functions).
declOfFnDef: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
    scope: ztypes.declid
    ownerNameId: zast.nameid
    defName: StringView
    thisName: StringView
} out ztypes.declid is {
    if thisName.length == 0 then return (
        declOfUnitDef
        :st
        :scope
        :unitDecl
        nameId: (nameIdOf :ast name: defName)
    )
    mown: declOfUnitDef :st :scope :unitDecl nameId: (nameIdOf :ast name: thisName)
    if ownerNameId.notZero when (
        zast.poolTextEq
        pool: ast.names
        ref: ownerNameId
        s: thisName
    ).not then {
        malt: declOfUnitDef :st :scope :unitDecl nameId: ownerNameId
        if malt.notZero then mown = malt
    }
    if mown.u64 == 0 then return ztypes.declid.zero
    return (
        st.typing.declFindChild
        parentDeclId: mown
        nameId: (zast.poolFind pool: ast.names text: defName)
    )
}

# recordGenericParamRef -- note that node `nid` spells the generic parameter
# `name` of the template `scope`, for stampGenericParams to resolve once at the
# end. Recording only: a generic parameter lives outside the name-resolution
# table, so making one a real type-ref here would bind a user type that merely
# shares its name, and the stamp would reach emission.
recordGenericParamRef: function {
    st: zenv.ZSymbolTable
    nid: zast.nodeid
    scope: ztypes.declid
    name: zast.nameid
} is {
    if nid.isZero then return
    if scope.isZero then return
    if name.isZero then return
    st.walk.bounds.genericParamName.set key: nid value: name
    st.walk.bounds.genericParamScope.set key: nid value: scope
}

# genericDefaultNode -- the node a generic parameter's `default:` names, in
# the call form `(anyval.generic default: i64)`; 0 when it has none.
genericDefaultNode: function {ast: Ast.view n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case call then {
        for each aId: (zast.kidsOf :ast span: n.arguments) loop {
            arg: argRefAt :ast nid: aId
            if arg.nid.notZero when arg.name == zast.wellKnown.slot.wkDefault then {
                return arg.operation
            }
        }
        return zast.nodeid
    } else {
        return zast.nodeid
    }
}

# genericParamDesc -- the bound written at generic-parameter operation `op`,
# classified: its family, or the declaration it names. `tdecl` is the
# declaration the bound's names resolve in.
genericParamDesc: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    tdecl: ztypes.declid
    op: astnode.view
} out ztypes.constraintdesc is {
    cb: genericConstraintBase :ast n: op
    cbId: genericConstraintBaseId :ast n: op
    if cbId.isZero then cbId = (
        familyBoundLeafId
        :ast
        :st
        :tdecl
        :op
    )
    k: ztypes.constraintkind.none
    if cb.length > 0 then k = constraintKindForId id: cbId
    # a family's name a declaration in scope takes -- a unit's own
    # `StringLike` -- names that declaration, as any name does; the system
    # and core units' own are the families
    if k != ztypes.constraintkind.other when (
        boundNameShadowsFamily
        :ast
        :st
        :tdecl
        :op
    ) then k = ztypes.constraintkind.other
    # a bound written as a type application names the instance it builds,
    # and is found through that node rather than a name
    ba: genericBoundApplication :ast n: op
    if ba.notZero then k = ztypes.constraintkind.other
    # a bound no kind classifies is a DECLARATION, and what it admits is
    # that declaration's business: its name is kept so the check can find it
    bn: zast.nameid
    bq: zast.nameid
    if k == ztypes.constraintkind.other then {
        bn = atomNameId :ast n: (ast.nodes.get i: (
            genericBoundAtomId
            :ast
            n: op
        )
        )
        bq = genericBoundQualifierId :ast n: op
    }
    return (
        ztypes.constraintdesc
        kind: k
        numKind: (constraintIntKindId id: cbId)
        boundName: bn
        boundQual: bq
        boundApp: ba
        defaultNode: (genericDefaultNode :ast n: op)
    )
}

# registerGenericParamOne -- record one member's generic-param declaration.
registerGenericParamOne: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    tdecl: ztypes.declid
    m: astnode.view
} is {
    if m.namedoperation when (isGenericParam :ast op: (ast.nodes.get i: m.operation)) then {
        cd: genericParamDesc :ast :st :tdecl op: (ast.nodes.get i: m.operation)
        (
            st.reg.addGenericParam
            :tdecl
            paramName: m.name
            kind: cd.kind
            numKind: cd.numKind
            boundName: cd.boundName
            boundQual: cd.boundQual
            boundApp: cd.boundApp
            defaultNode: cd.defaultNode
        )
        # the BOUND names a real declaration -- `anyval`, a protocol -- but
        # everything above reads it as TEXT and maps it to a constraint kind,
        # because that is all the compiler needs from it. Nothing then stamps
        # the atom that SPELLS it, so an editor asking what `anyval` is in
        # `t: anyval.generic` had no answer while the same name in a return
        # type had one. Recorded here and resolved at the end, for TOOLING
        # only: this must not resolve as a type-ref, or a retired bound would
        # start reporting an unknown type and the stamp would reach emission.
        (
            recordGenericBoundAtom
            :ast
            :st
            :tdecl
            op: (ast.nodes.get i: m.operation)
            base: (genericConstraintBase :ast n: (ast.nodes.get i: m.operation)).stringView
        )
        # and the parameter itself, keyed to the OPERATION node -- what
        # Spans keys a declaration's own row to.
        recordGenericParamRef :st nid: m.operation scope: tdecl name: m.name
    }
}

# recordGenericBoundAtom -- the node a bound is SPELLED at, and the unit a
# qualified one resolves in, recorded for the passes that report on bounds
# (checkGenericBounds) and for tooling. This must not resolve
# as a type-ref: resolution here would reach emission.
recordGenericBoundAtom: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    tdecl: ztypes.declid
    op: astnode.view
    base: StringView
} is {
    bnid: genericBoundAtomId :ast n: op
    if bnid.isZero then return
    bnm: atomNameId :ast n: (ast.nodes.get i: bnid)
    if bnm.isZero then bnm = nameIdOf :ast name: base
    st.walk.bounds.genericBoundName.set key: bnid value: bnm
    st.walk.bounds.genericBoundScope.set key: bnid value: tdecl
    qn: genericBoundQualifierId :ast n: op
    if qn.notZero then st.walk.bounds.genericBoundQual.set key: bnid value: qn
}

# boundNameShadowsFamily -- the bound at `op` is a bare name that a declaration
# in the template's scope chain takes, outside the system and core units.
boundNameShadowsFamily: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    tdecl: ztypes.declid
    op: astnode.view
} out bool is {
    if (genericBoundQualifierId :ast n: op).notZero then return false
    bnid: genericBoundAtomId :ast n: op
    if bnid.isZero then return false
    return (familyNameTaken :st :tdecl nameId: (atomNameId :ast n: (ast.nodes.get i: bnid)))
}

# familyNameTaken -- a bare bound name written on template `tdecl` reaches a
# type the program declares rather than the family the system and core units
# declare under that name: a unit's own `anyval` or `u32` is that unit's type,
# and bounds as one.
familyNameTaken: function {
    # the checked program
    st: zenv.ZSymbolTable.view
    # the template the bound is written on
    tdecl: ztypes.declid
    # the bound's name, interned
    nameId: zast.nameid
} out bool is {
    if nameId.isZero then return false
    d: memberaccess.declInScope :st scopeDeclId: (st.typing.declParentOf declId: tdecl) :nameId
    if d.isZero then return false
    ur: unitRootOfDecl typing: st.typing declId: d
    if (ur == st.typing.systemUnitRoot) or (ur == st.typing.coreUnitRoot) then return false
    return (st.typing.decls.get i: d).kind.typeDecl
}

# genericBoundQualifierId -- the name a qualified bound is reached through
# (`io` in `io.Reader.generic`), 0 for a bare one.
genericBoundQualifierId: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    match (
        n
    ) case call then {
        return (genericBoundQualifierId :ast n: (ast.nodes.get i: n.callable))
    } case dottedpath then {
        r: zast.nameid
        pn: ast.nodes.get i: n.parent
        if pn.dottedpath then r = atomNameId :ast n: (ast.nodes.get i: pn.parent)
        return r
    } else {
        return zast.nameid.zero
    }
}

# genericBoundApplication -- the type application a bound is written as
# (`(Getter v: i64).generic`), 0 for a bound written as a name. A DEFAULTED
# bound is a call over the same path and answers for its callable.
genericBoundApplication: function {ast: Ast.view n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case call then {
        return (genericBoundApplication :ast n: (ast.nodes.get i: n.callable))
    } case dottedpath then {
        if (ast.nodes.get i: n.parent).call then return n.parent
        return zast.nodeid
    } else {
        return zast.nodeid
    }
}

# genericConstraintBase -- the constraint name of a `u64.generic`-style param
# declaration: the dotted parent, spelled whole when it is itself a path
# (`io.Reader`). A DEFAULTED bound is a call over the same path -- `(T.generic
# default: i64)` -- and answers for its callable, or the bound would register
# as no constraint at all.
genericConstraintBase: function {ast: Ast.view n: astnode.view} out String is {
    match (
        n
    ) case call then {
        return (genericConstraintBase :ast n: (ast.nodes.get i: n.callable))
    } case dottedpath then {
        pn: ast.nodes.get i: n.parent
        an: typeargs.atomName :ast n: pn
        if an.length > 0 then return an
        return (statics.typeExprText :ast nid: n.parent)
    } else {
        return "".string
    }
}

# genericConstraintBaseId -- genericConstraintBase's name id: the dotted parent's
# own name when it is a bare name, 0 for a bound named through a path.
genericConstraintBaseId: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    match (
        n
    ) case call then {
        return (genericConstraintBaseId :ast n: (ast.nodes.get i: n.callable))
    } case dottedpath then {
        return (atomNameId :ast n: (ast.nodes.get i: n.parent))
    } else {
        return zast.nameid
    }
}

# familyBoundLeafId -- the family a bound written through the unit that
# declares the families names (`system.u64.generic`, `core.anyval.generic`):
# its leaf, which names that family as the bare name does. 0 for any other
# bound, a bare one included.
familyBoundLeafId: function {
    ast: Ast.view
    st: zenv.ZSymbolTable.view
    tdecl: ztypes.declid
    op: astnode.view
} out zast.nameid is {
    q: genericBoundQualifierId :ast n: op
    if q.isZero then return zast.nameid.zero
    qd: resolve.fileUnitNamedAt :st scope: (st.typing.declParentOf declId: tdecl) nameId: q
    if qd.isZero then return zast.nameid.zero
    if qd != st.typing.systemUnitRoot when qd != st.typing.coreUnitRoot then {
        return zast.nameid.zero
    }
    return (atomNameId :ast n: (ast.nodes.get i: (genericBoundAtomId :ast n: op)))
}

# genericBoundAtomId -- the node the bound is SPELLED at, for a report: the
# dotted parent, or its own leaf when the parent is itself a path. 0 when the
# declaration spells no bound.
genericBoundAtomId: function {ast: Ast.view n: astnode.view} out zast.nodeid is {
    match (
        n
    ) case call then {
        return (genericBoundAtomId :ast n: (ast.nodes.get i: n.callable))
    } case dottedpath then {
        pid: n.parent
        leaf: zast.nodeid
        pn: ast.nodes.get i: pid
        if pn.dottedpath then leaf = pn.child
        if leaf.notZero then return leaf
        return pid
    } else {
        return zast.nodeid
    }
}

# registerGenericParams -- record a type's generic-param names (keyed by
# the template's DeclId) so method-param resolution can drop params typed by them.
registerGenericParams: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    tdecl: ztypes.declid
    items: zast.kidspan
} is {
    for each rid: (zast.kidsOf :ast span: items) loop {
        rm: ast.nodes.get i: rid
        registerGenericParamOne :st :ast :tdecl m: rm
    }
}

# nestedTemplateUnit -- the generic unit template a type definition is written
# in: a type inside `cells: unit { t: anyval.generic ... }`, or inside a
# generic FILE unit (its parameters at the file's top), is generic over the
# unit's parameters, and every instance of the unit has its own. 0 for a type
# written anywhere else.
nestedTemplateUnit: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    scope: ztypes.declid
    unitDecl: ztypes.declid
    nameId: zast.nameid
} out ztypes.declid is {
    none: ztypes.declid
    td: declOfUnitDef :st :unitDecl :scope :nameId
    if td.isZero then return none
    pd: st.typing.declParentOf declId: td
    if pd.isZero then return none
    if (instantiate.declIsUnitTemplate :st :ast declId: pd) then return pd
    return none
}

# registerUnitParamsOn -- a type nested in a generic unit takes the unit's
# parameters as its own, their parameter types included, so its members'
# references to them are its parameters and its instances bind them. Copied
# from the unit's own registration, not re-read from its source: a re-read
# records the unit's bounds again under the type, and each is then reported
# twice.
registerUnitParamsOn: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    tdecl: ztypes.declid
    unitTmpl: ztypes.declid
} is {
    for each pn: (st.reg.genericParamNamesOf tdecl: unitTmpl) loop {
        cd: st.reg.genericParamConstraintOf tdecl: unitTmpl paramName: pn
        (
            st.reg.addGenericParam
            :tdecl
            paramName: pn
            kind: cd.kind
            numKind: cd.numKind
            boundName: cd.boundName
            boundQual: cd.boundQual
            boundApp: cd.boundApp
            defaultNode: cd.defaultNode
        )
        ut: genericParamTidMint :st :ast tdecl: unitTmpl nameId: pn
        st.reg.setGenericParamTid :tdecl paramName: pn tid: ut
    }
}

# pathOwnership -- the ownership a param/field/return type expr declares via a
# dotted-path marker leaf, or none. Fields take the non-owned markers (which make
# the slot static) or `take`/`hold`; params take any of the four grid markers.
pathOwnership: function {ast: Ast.view n: astnode.view} out optionval ztypes.zparamownership is {
    match (
        n
    ) case dottedpath then {
        cid: atomNameId :ast n: (ast.nodes.get i: n.child)
        if (
            cid == zast.wellKnown.slot.wkBorrow
        ) then return (optionval.some ztypes.zparamownership.borrowMode)
        if (
            cid == zast.wellKnown.slot.wkTake
        ) then return (optionval.some ztypes.zparamownership.takeMode)
        if (
            cid == zast.wellKnown.slot.wkView
        ) then return (optionval.some ztypes.zparamownership.viewMode)
        if (
            cid == zast.wellKnown.slot.wkHold
        ) then return (optionval.some ztypes.zparamownership.holdMode)
        return (optionval.none ztypes.zparamownership)
    } else {
        return (optionval.none ztypes.zparamownership)
    }
}

# baseTypeNameId -- the underlying base type name of a type expr, as its name
# id, peeling `.borrow`/`.private`/etc. dotted-path markers
# (`Container.private.borrow` -> `Container`, `this.borrow` -> `this`); the
# atom name for a bare atom; zero otherwise.
baseTypeNameId: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    match (
        n
    ) case atomid then {
        return n.name
    } case labelvalue then {
        return n.name
    } case dottedpath then {
        if (isStripMarkerId nameId: (atomNameId :ast n: (ast.nodes.get i: n.child))) then {
            return (baseTypeNameId :ast n: (ast.nodes.get i: n.parent))
        }
        return zast.nameid.zero
    } else {
        return zast.nameid.zero
    }
}

# genericApplHeadId -- the head type name id of a generic application
# `(List of: T)` / `(Option t: T)` (the callable's atom name); zero for a
# non-application expr.
genericApplHeadId: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    match (
        n
    ) case call then {
        return (atomNameId :ast n: (ast.nodes.get i: n.callable))
    } else {
        return zast.nameid.zero
    }
}

# fieldHeadNameId -- a field type's head name id: baseTypeNameId, falling back
# to the generic-application head so a `(List of: astnode)` / `(Option t: astnode)`
# field is recognized (List/Option) for the destructor-cleanup decision.
fieldHeadNameId: function {ast: Ast.view n: astnode.view} out zast.nameid is {
    b: baseTypeNameId :ast :n
    if b.notZero then return b
    return (genericApplHeadId :ast :n)
}

# numericParamRefTid -- a type reference's numeric argument that is a bare name
# of a numeric generic parameter of the declaration enclosing it: that
# parameter's GENERIC_PARAM type, which makes the reference a partial each
# instance completes with its own value. 0 for any other argument.
numericParamRefTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    # the scope the reference is resolved in, whose enclosing template is asked
    # when no enclosing declaration is given
    scope: ztypes.declid
    # the enclosing type's name, asked last: a signature's reference is
    # recorded with its owner's name and no declaration
    thisName: StringView
    enclDecl: ztypes.declid
    arg: argref
} out ztypes.tid is {
    # a bare name, or the pun `(fx :n)` whose value is the name it labels
    nameId: atomNameId :ast n: (ast.nodes.get i: arg.operation)
    if nameId.isZero then return ztypes.tid
    owner: enclDecl
    if owner.isZero then owner = statics.numericParamOwnerFrom :st :scope :nameId
    if owner.isZero when thisName.length > 0 then {
        tto: bodies.walkLookupTyperef :st :scope :ast :unitDecl base: thisName
        if tto.some then {
            owner = st.typing.declIdOfType typeId: tto
        }
    }
    if owner.isZero then return ztypes.tid
    if (st.reg.genericParamConstraintOf tdecl: owner paramName: nameId
    ).numKind.has.not then return ztypes.tid
    recordGenericParamRef :st nid: arg.operation scope: owner name: nameId
    return (genericParamTidMint :st :ast tdecl: owner :nameId)
}

# returnMarkerAt -- the marker the return type `oId` carries: `out T.borrow`
# hands back a mutable reference into the receiver, `out T.view` a readonly
# one -- both pin the receiver for the result binding's scope -- and `out
# T.hold` an OWNED result the caller may only read, which is not a reference:
# the binding keeps its destructor. noneMode for any other return.
returnMarkerAt: function {ast: Ast.view oId: zast.nodeid} out ztypes.zparamownership is {
    if oId.isZero then return ztypes.zparamownership.noneMode
    m: pathOwnership :ast n: (ast.nodes.get i: oId)
    if m.some when m.isReference or (m == ztypes.zparamownership.holdMode) then return m
    return ztypes.zparamownership.noneMode
}

# returnHasBorrowMarker -- the return type `oId` hands back a reference:
# `.borrow` or `.view`.
returnHasBorrowMarker: function {ast: Ast.view oId: zast.nodeid} out bool is {
    return (returnMarkerAt :ast :oId).isReference
}

# returnNamesThis -- the return type is the enclosing type itself (`out this`,
# with or without a marker), which is what a constructor writes.
returnNamesThis: function {ast: Ast.view oId: zast.nodeid} out bool is {
    if oId.isZero then return false
    return (rootNameIdOf :ast n: (ast.nodes.get i: oId)) == zast.wellKnown.slot.wkThis
}

# pinHonestyAt -- checkPinHonesty on a type whose members may not be attached
# yet: they are attached on demand, and a return type reached only through
# this signature has had no other reason to. Asked of the generic origin,
# where a mono's members live.
pinHonestyAt: function {
    # where a refused return clause is reported
    st: zenv.ZSymbolTable
    # the tree whose function row carries the `out`/`outx` and its marker
    ast: Ast
    # the scope the members are forced in
    # the declaration whose return clause is judged
    fnode: fnref
    # the resolved return type
    retTid: ztypes.tid
    # the name the refusal underlines
    defName: StringView
    # the function's name id when the walk holds one -- zero when `defName` is a
    # composed method label
    defNameId: zast.nameid
} is {
    probe: retTid
    go: st.reg.genericOriginOf tid: retTid
    if go.notZero then probe = go
    # a valtype holds no reference, so only a reftype is asked -- and only
    # one with no member attached yet is forced: forcing a system type's
    # members demands every conversion it declares, which is how a program
    # came to reach the wide-integer and half-float units it never named
    if (st.reg.isReftypeOf tid: probe).not then return
    if (st.typing.declRowSlots ownerTid: probe) == 0 then (
        conform.forceAllMembers
        :st
        :ast
        tid: probe
    )
    checkPinHonesty :st :ast :fnode :retTid :defName :defNameId
}

# checkMemberDeclEagerly -- the declaration rules that need no resolved types,
# run where a type's methods are attached so a method never demanded still
# reports: the return-pin rules and the `out this` honesty rule.
checkMemberDeclEagerly: function {
    # the symbol table the reports go to
    st: zenv.ZSymbolTable
    # the tree the declaration is read from
    ast: Ast.view
    # the method whose declaration is checked
    fnode: fnref
    # the enclosing type
    thisTid: ztypes.tid
    # the name to underline when the type turns out to hold a reference
    defName: StringView
} is {
    checkReturnPins :st :ast :fnode fid: ztypes.tid.zero :defName
    checkThisPinHonesty :st :ast :fnode :thisTid :defName
}

# checkThisPinHonesty -- checkPinHonesty for an `out this`, eagerly where the
# methods are attached: the enclosing type is the return type, and it is known
# before any body is walked.
checkThisPinHonesty: function {
    # the table a member's eager refusal lands in
    st: zenv.ZSymbolTable
    # the tree the member's row is read from
    ast: Ast.view
    # the method whose declaration is checked
    fnode: fnref
    # the enclosing type
    thisTid: ztypes.tid
    # the member's name, for the report width
    defName: StringView
} is {
    if (returnNamesThis :ast oId: fnode.returntype).not then return
    checkPinHonesty :st :ast :fnode retTid: thisTid :defName defNameId: zast.nameid
}

# defNameWidth -- the caret width for a definition's name: the label's when
# the caller spelt one, else the interned name's.
defNameWidth: function {ast: Ast.view defName: StringView defNameId: zast.nameid} out u32 is {
    if defName.length > 0 then return defName.length.u32.orPanic
    return (zast.nameTextAt :ast ref: defNameId).length.u32.orPanic
}

# checkPinHonesty -- an OWNED `out T` whose type declares a non-owned field
# hands back a value holding a reference into an input. Unless the declaration
# says `outx`, nothing keeps that input locked and the field dangles the moment
# the caller writes or drops it. `outx` states the pin on the SIGNATURE, where
# a reader can see it, rather than leaving it to what the parameters happen to
# be marked. A mono is asked through its generic origin, so `out (OptionView T)`
# -- whose `some` arm is a borrow -- answers as OptionView does.
checkPinHonesty: function {
    # the table an `out this` refusal lands in
    st: zenv.ZSymbolTable
    # the tree whose row spells the `out this`
    ast: Ast.view
    # the method whose `out this` is judged
    fnode: fnref
    # the resolved return type
    retTid: ztypes.tid
    # the method's name, underlined by the report
    defName: StringView
    # the id behind `defName` when there is one: the report's caret width comes
    # from it when the label is empty
    defNameId: zast.nameid
} is {
    if retTid.isZero then return
    if fnode.pins then return
    # a reference return is a different contract, checked by checkReturnPins
    if (returnHasBorrowMarker :ast oId: fnode.returntype) then return
    probe: retTid
    go: st.reg.genericOriginOf tid: retTid
    if go.notZero then probe = go
    # a valtype holds no reference
    if (st.reg.isReftypeOf tid: probe).not then return
    if (moves.typeHasNonOwnedField :st :ast tid: probe).not then return
    (
        addResolveErrorAt
        :st
        nodeid: fnode.nid
        lineno: fnode.lineno
        colno: fnode.colno
        e: zast.err.ownerError
        msg: "an owned `out` result whose type declares a non-owned field must be `outx` -- the result holds a reference into an input, and only `outx` keeps that source locked for the result's lifetime".string
        width: (defNameWidth :ast :defName :defNameId)
    )
}

# fnHasPinnableInput -- does any parameter (the receiver included) give the
# result something to keep locked? A `.borrow`/`.view` marker says so; an
# unmarked parameter is `.borrow` by default when its type is a reftype, and a
# bare `:this` receiver always is. Asks the recorded parameter types, so it
# runs once the signature is resolved.
fnHasPinnableInput: function {
    # the tree the parameter markers are read from
    ast: Ast.view
    # the symbol table the parameter types are recorded in
    st: zenv.ZSymbolTable.view
    # the function whose parameters are asked
    fnode: fnref
    # the function's type id, whose children are its parameters
    fid: ztypes.tid
} out bool is {
    thisNm: st.reg.thisParamNameIdOf tid: fid
    kP: u64
    for kP < fnode.nparams loop {
        pmId: zast.fnParamAt :ast nid: fnode.nid i: kP
        kP = kP + 1
        pm: ast.nodes.get i: pmId
        if pm.namedoperation then {
            po: pathOwnership :ast n: (ast.nodes.get i: pm.operation)
            match (
                po
            ) case some then {
                if po == ztypes.zparamownership.borrowMode then return true
                if po == ztypes.zparamownership.viewMode then return true
            } case none then {
                if thisNm.notZero when pm.name == thisNm then return true
                pto: st.typing.declChildOfId parentTypeId: fid nameId: pm.name
                if pto.some when (st.reg.isReftypeOf tid: pto) then return true
            }
        }
    }
    return false
}

# checkReturnPins -- what a declaration says about the locks its result keeps,
# checked at every function/method declaration. A reference return (`.borrow`/
# `.view`) keeps its sources locked for the result's lifetime, so it is written
# `outx`: a plain `out` reference is refused with the fix-it. `outx` with
# nothing pinnable -- no `.borrow`/`.view` parameter, no receiver, no reftype
# parameter at all -- pins nothing and is refused; that half needs the
# parameter types, so it runs where they are recorded (`fid` set).
checkReturnPins: function {
    # the tree the return's marker is read from (a reference return is another rule's)
    ast: Ast.view
    # the table the honesty refusal lands in and the registry the members are read from
    st: zenv.ZSymbolTable
    # the declaration whose owned return is judged
    fnode: fnref
    # the function's type id, zero at the eager pass before types are recorded
    fid: ztypes.tid
    # the declared name the refusal underlines
    defName: StringView
} is {
    pinsHere: fnode.pins
    if (returnHasBorrowMarker :ast oId: fnode.returntype) when fnode.pins.not then {
        (
            addResolveErrorAt
            :st
            nodeid: fnode.nid
            lineno: fnode.lineno
            colno: fnode.colno
            e: zast.err.ownerError
            msg: "a reference return keeps its sources locked for the result's lifetime -- write `outx T.borrow` / `outx T.view`, not `out`".string
            width: defName.length
        )
        return
    }
    if pinsHere when fid.notZero when (fnHasPinnableInput :ast :st :fnode :fid).not then {
        (
            addResolveErrorAt
            :st
            nodeid: fnode.nid
            lineno: fnode.lineno
            colno: fnode.colno
            e: zast.err.ownerError
            msg: "`outx` pins nothing here: no parameter or receiver is `.borrow` or `.view` -- write `out`, or mark the source the result reads through (e.g. `t: this.view`)".string
            width: defName.length
        )
    }
}

# registerFnGenericParam -- record the function's OWN generic parameter: the
# canonical per-(function, parameter) tid, stamped on the parameter node so
# every reference in the signature resolves to the same type.
registerFnGenericParam: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    fid: ztypes.tid
    fnDecl: ztypes.declid
    ptn: zast.nameid
    fnParam: bool
    pm: argref
} is {
    if fnParam then {
        # the template's own param: bind the canonical
        # per-(template,param) tid as the child so holder
        # inference and the idSubs clone substitution ride it.
        # No node stamp (fn monos re-walk the SHARED template
        # AST) and no typeref/demand recording (a user type
        # coincidentally named like the param must not bind).
        fpt: genericParamTidMint :st :ast tdecl: fnDecl nameId: ptn
        st.typing.setMemberType parentTypeId: fid nameId: pm.name childTypeId: fpt
    }
}

# registerGenericOrReceiverParam -- record a parameter that is not an ordinary
# value: the function's own generic parameter, the enclosing type's, or the
# `this` receiver. Each binds a type without taking an argument slot.
registerGenericOrReceiverParam: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    fid: ztypes.tid
    fnDecl: ztypes.declid
    receiverEnclDecl: ztypes.declid
    thisName: StringView
    genParam: bool
    fnParam: bool
    ptn: zast.nameid
    isRecvP: bool
    pm: argref
} is {
    # A dropped RECEIVER still records its alias: the vtable
    # emitters and methodReceiverIsView ask which parameter is the
    # receiver, and on a bodyless spec this is the only chance.
    if isRecvP then {
        # BIND the copy: an owned `String` return consumed inline
        # has no scope to die in and leaks on every dropped
        # receiver. The keep branch below binds `pname` for the
        # same reason.
        rcvNm: zast.nameTextAt :ast ref: pm.name
        st.reg.setThisParamName typeId: fid nameId: pm.name
        # ... and its MARKER. The name alone tells a caller which
        # parameter is the receiver; only the ownership row tells
        # it whether the call reads or writes, which is what
        # methodReceiverIsView asks. A bodyless spec has no other
        # chance to record it.
        rcvOw: pathOwnership :ast n: (ast.nodes.get i: pm.operation)
        if rcvOw.some then {
            (
                st.typing.setChildOwnership
                pool: ast.names
                parentTypeId: fid
                name: rcvNm.stringView
                ownership: rcvOw
            )
        }
    }
    registerFnGenericParam :st :ast :fid :fnDecl :ptn :fnParam :pm
    # the parameter's type IS a generic parameter -- the function's own
    # (fnParam) or the enclosing type's (genParam). Neither leg records a
    # type-ref, and the fn leg writes no node stamp either, so this is the only
    # point at which the node that spells it is known.
    paramScope: ztypes.declid
    if fnParam then paramScope = fnDecl
    if genParam then paramScope = receiverEnclDecl
    if paramScope.notZero then {
        recordGenericParamRef :st nid: pm.operation scope: paramScope name: ptn
    }
    if genParam then {
        # the unit's own param: stamp the param node with the
        # canonical per-(enclosing,param) tid (get-or-mint). No
        # member type -- unit template methods stay childless (emit
        # `(void)`); unit bodies clone, so the stamp is per-clone.
        paramTid: genericParamTidMint :st :ast tdecl: receiverEnclDecl nameId: ptn
        paramNid: stampNodeId n: (ast.nodes.get i: pm.operation)
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: paramNid tid: paramTid
        if thisName.length != 0 then {
            st.typing.setMemberType parentTypeId: fid nameId: pm.name childTypeId: paramTid
        }
    }
    # a MARKED generic parameter (`s: T.view`) keeps its marker beside the
    # canonical type: the ownership row is what a call's argument reads. The
    # row needs the member laid above, and a receiver recorded its own.
    if isRecvP.not then {
        gOw: pathOwnership :ast n: (ast.nodes.get i: pm.operation)
        if gOw.some then {
            st.typing.setChildOwnershipId parentTypeId: fid nameId: pm.name ownership: gOw
        }
    }
}

# registerFnGenericParams -- record a generic function's own parameter list on
# its declaration, so the signature walk and every later instantiation agree on
# which names are parameters.
registerFnGenericParams: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    fnDecl: ztypes.declid
    fid: ztypes.tid
    fnode: fnref
    # the generic type the function is a method of, 0 for any other function:
    # an item naming one of its parameters is a method bound, not a parameter
    ownerD: ztypes.declid
} is {
    st.reg.setGeneric typeId: fid value: true
    # Function templates register their param constraints like type
    # templates do (checkGenericCall checks satisfaction per call).
    # the as-items are read through a view scoped to this block
    {
        fn: ast.nodes.get i: fnode.nid
        if fn.functiondef then {
            for each rid: (zast.kidsOf :ast span: fn.asItems) loop {
                rm: ast.nodes.get i: rid
                if (isOwnerParamItem :st :ast :ownerD m: rm).not then (
                    registerGenericParamOne
                    :st
                    :ast
                    tdecl: fnDecl
                    m: rm
                )
            }
        }
    }
}

# genericOwnerDecl -- the declaration of the generic TYPE a method (owner
# `ownerNameId`) belongs to; 0 for a free function, a method of a type with no
# parameters, and a function of a generic unit -- whose own `as` item naming
# the unit's parameter is a parameter of its own, inferred from its arguments.
genericOwnerDecl: function {
    st: zenv.ZSymbolTable.view
    unitDecl: ztypes.declid
    scope: ztypes.declid
    ownerNameId: zast.nameid
} out ztypes.declid is {
    none: ztypes.declid
    if ownerNameId.isZero then return none
    od: declOfUnitDef :st :scope :unitDecl nameId: ownerNameId
    if od.isZero then return none
    if (
        (st.reg.typetypeOf typeId: (st.typing.decls.get i: od).typeId) == ztypes.ztypetype.unitType
    ) then {
        return none
    }
    if (st.reg.genericParamNamesOf tdecl: od).length == 0 then return none
    return od
}

# isOwnerParamItem -- `as` item `m` of a method of generic type `ownerD`
# names one of the type's own parameters: a METHOD BOUND, which adds a bound
# to that parameter for this method only, rather than a parameter of its own.
isOwnerParamItem: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    ownerD: ztypes.declid
    m: astnode.view
} out bool is {
    if ownerD.isZero then return false
    if m.namedoperation.not then return false
    if (isGenericParam :ast op: (ast.nodes.get i: m.operation)).not then return false
    return (st.reg.isGenericParamOf tdecl: ownerD name: m.name)
}

# fnHasOwnGenericParam -- `as` items `items` declare a generic parameter of
# the function's own: one that is no method bound (isOwnerParamItem).
fnHasOwnGenericParam: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    items: zast.kidspan
    ownerD: ztypes.declid
} out bool is {
    for each rid: (zast.kidsOf :ast span: items) loop {
        rm: ast.nodes.get i: rid
        if (isOwnerParamItem :st :ast :ownerD m: rm) then continue
        if rm.namedoperation when (isGenericParam :ast op: (ast.nodes.get i: rm.operation)) then {
            return true
        }
    }
    return false
}

# registerMethodBounds -- the method bounds a method of generic type `ownerD`
# writes: each recorded on the method (ZTypeRegistry.addMethodBound), its
# bound's names resolving from the method, and its spelling recorded for the
# report on a bound that names nothing (checkGenericBounds).
registerMethodBounds: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    fnDecl: ztypes.declid
    ownerD: ztypes.declid
    fnode: fnref
} is {
    fn: ast.nodes.get i: fnode.nid
    if fn.functiondef.not then return
    for each rid: (zast.kidsOf :ast span: fn.asItems) loop {
        rm: ast.nodes.get i: rid
        bounds: isOwnerParamItem :st :ast :ownerD m: rm
        if bounds when rm.namedoperation then {
            op: ast.nodes.get i: rm.operation
            cd: genericParamDesc :ast :st tdecl: fnDecl :op
            st.reg.addMethodBound mdecl: fnDecl paramName: rm.name bound: cd
            (
                recordGenericBoundAtom
                :ast
                :st
                tdecl: fnDecl
                :op
                base: (genericConstraintBase :ast n: op).stringView
            )
            # the name is the TYPE's parameter
            recordGenericParamRef :st nid: rm.operation scope: ownerD name: rm.name
        }
    }
}

# recordFnBodyPresence -- note whether a function has a body: a bodyless one is
# a spec method, which the emitter renders as a vtable slot rather than code.
recordFnBodyPresence: function {
    st: zenv.ZSymbolTable
    fid: ztypes.tid
    fnode: fnref
} is {
    {
        fhbV: fnode.body.notZero
        fhbK: fid
        st.walk.fn.hasBody.set key: fhbK value: fhbV
    }
}

# receiverOwnerDecl -- the declaration a method's receiver belongs to: its owner
# type for a method, the enclosing unit for a free function.
receiverOwnerDecl: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
    rf: ztypes.declid
    thisName: StringView
} out ztypes.declid is {
    receiverEnclDecl: ztypes.declid
    if thisName.length != 0 then {
        receiverEnclDecl = (
            declOfUnitDef
            :st
            scope: rf
            :unitDecl
            nameId: (nameIdOf :ast name: thisName)
        )
    } else {
        ero: unitDecl
        if ero.notZero then receiverEnclDecl = ero
    }
    return receiverEnclDecl
}

# fnSignatureScope -- the scope a function's signature resolves in: a METHOD's
# own declaration, under its owner's, since a free function's caller has
# already entered its scope. A method the name index cannot place keeps the
# caller's scope.
fnSignatureScope: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
    scope: ztypes.declid
    ownerNameId: zast.nameid
    defName: StringView
} out ztypes.declid is {
    rf: scope
    if ownerNameId.notZero then {
        od: declOfUnitDef :st scope: rf :unitDecl nameId: ownerNameId
        if od.notZero then {
            fd: st.typing.declFindChild parentDeclId: od nameId: (nameIdOf :ast name: defName)
            if fd.notZero then rf = fd
        }
    }
    return rf
}

# resolveFunction -- resolve a function definition signature into a FUNCTION
# type: a child per parameter (param name -> type-ref shell, `this` params bound
# to thisName), its defining unit (source-types filter), and a `{unit}.{name}`
# entry in the resolved name-view. Returns the FUNCTION type id (a record method
# binds it as a child; a free function discards it).
resolveFunction: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    # a method's owner, by interned name id; 0 for a free function
    ownerNameId: zast.nameid
    defName: StringView
    fnId: zast.nodeid
    thisName: StringView
    skipThisType: bool
} out ztypes.tid is {
    # a METHOD's signature resolves in the scope of its declaration, under
    rf: fnSignatureScope :st :ast :unitDecl :scope :ownerNameId :defName
    fid: (
        declareCanonicalType
        :st
        scope: rf
        :ast
        :unitDecl
        :ownerNameId
        name: defName
        typetype: ztypes.ztypetype.functionType
    )
    fnode: bodies.fnRefAt :ast nid: fnId
    st.reg.setNative typeId: fid value: fnode.isNative
    recordFnBodyPresence :st :fid :fnode
    dfid: fid
    rfid: fid
    # the as-items are read through a view scoped to this block: the walks
    # below lend ast
    isgen: false
    # a method of a generic type may bound the type's own parameters
    ownerD: genericOwnerDecl :st :unitDecl scope: rf :ownerNameId
    # the `as` items' values, for the ones that are no generic parameter
    asOps: ListVal zast.nodeid
    {
        fn: ast.nodes.get i: fnId
        if fn.functiondef then {
            isgen = fnHasOwnGenericParam :st :ast items: fn.asItems :ownerD
            for each faId: (zast.kidsOf :ast span: fn.asItems) loop {
                fa: ast.nodes.get i: faId
                if fa.namedoperation then asOps.append from: fa.operation
            }
        }
    }
    # an `as` item naming a member its type does not declare names nothing
    for each faOp: asOps loop {
        if (typeref.refuseMisplacedImplement :st :ast nid: faOp).not then (
            typeref.reportMissingTypeMember
            :st
            scope: rf
            :ast
            :unitDecl
            op: faOp
        )
    }
    fnDecl: declOfFnDef :st scope: rf :ast :unitDecl :ownerNameId :defName :thisName
    # link the declaration to its type up front: the parameter loop below
    # records ownership and defaults on member declarations, which needs the
    # owner reachable from its type id.
    if fnDecl.notZero then st.typing.declSetType declId: fnDecl typeId: dfid
    if ownerD.notZero when fnDecl.notZero then registerMethodBounds :st :ast :fnDecl :ownerD :fnode
    if isgen then {
        registerFnGenericParams :st :ast :fnDecl :fid :fnode :ownerD
    }
    receiverEnclDecl: receiverOwnerDecl :st :ast :unitDecl :rf :thisName
    sgkPrev: st.walk.bounds.sigGenericDecl
    if isgen then st.walk.bounds.sigGenericDecl = fnDecl
    # the signature is the function's scope: its parameters are in it
    spPrev: st.walk.sigFnNode
    st.walk.sigFnNode = fnId
    sfPrev: st.walk.sigFnName
    st.walk.sigFnName = nameIdOf :ast name: defName
    kP: u64
    for kP < fnode.nparams loop {
        pmId: zast.fnParamAt :ast nid: fnId i: kP
        kP = kP + 1
        (
            typeargs.resolveFunctionParam
            :st
            :ast
            :unitDecl
            :rf
            :fid
            :fnDecl
            :receiverEnclDecl
            :isgen
            :thisName
            :skipThisType
            :pmId
        )
    }
    (
        typeargs.finishFunctionSignature
        :st
        :ast
        :unitDecl
        :rf
        :fid
        :dfid
        :isgen
        :fnDecl
        :receiverEnclDecl
        :defName
        :thisName
        :fnode
    )
    st.walk.bounds.sigGenericDecl = sgkPrev
    st.walk.sigFnNode = spPrev
    st.walk.sigFnName = sfPrev
    return rfid
}

# resolveMethodFn -- resolve one method as-item (a namedoperation whose operation
# is a functiondef) into a qualified `{type}.{method}` FUNCTION type, `this`
# params bound to thisName. Returns its type id, or none for a non-function
# as-item (tag spec / generic param), which the caller skips. A facet/protocol
# spec method passes `skipThis`: its `this` resolves to nothing, so the spec
# keeps only its real params.
resolveMethodFn: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    ownerNameId: zast.nameid
    mname: StringView
    thisName: StringView
    opId: zast.nodeid
    skipThis: false
} out optionval ztypes.tid is {
    arm: rowArmAt :ast nid: opId
    match (
        arm
    ) case functiondef then {
        mid: (
            resolveFunction
            :st
            :scope
            :ast
            :unitDecl
            :ownerNameId
            defName: mname
            fnId: opId
            :thisName
            skipThisType: skipThis
        )
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: opId tid: mid
        return (optionval.some mid)
    } else {
        return (optionval.none ztypes.tid)
    }
}

# resolveMethodFnLazy -- resolveMethodFn under the member-demand mode. The item
# is still reported AS a method, carrying no type yet; forceMemberDecl mints the
# signature when a consumer first needs it. `lazyOk` is false where the caller
# READS the returned id rather than only recording it -- a generic class's
# methods feed st.reg.setGeneric, and a unit template's feed declLinkTemplateMethod.
resolveMethodFnLazy: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    ownerNameId: zast.nameid
    mname: StringView
    thisName: StringView
    opId: zast.nodeid
    lazyOk: bool
} out optionval ztypes.tid is {
    isFnDef: false
    arm: rowArmAt :ast nid: opId
    if arm.functiondef then isFnDef = true
    if lazyOk when isFnDef when (flow.eagerAt :st declId: unitDecl).not then return (
        optionval.some
        ztypes.tid.zero
    )
    return (resolveMethodFn :st :scope :ast :unitDecl :ownerNameId :mname :thisName :opId)
}

# functiondefIsNative -- an is-block method marked `is native` (no body to
# check or emit; its members come from the native materializer).
functiondefIsNative: function {op: astnode.view} out bool is {
    match (
        op
    ) case functiondef then {
        return op.isNative
    } else {
        return false
    }
}

# markGenericMethod -- a generic template's as-block method is a per-instance
# clone candidate: mintMono's clone loop is gated on isgeneric and substitutes
# the signature for each instance. A NATIVE method has nothing to substitute --
# the runtime owns its layout and the sized-record arms replace its member in
# place -- so only the non-native ones are marked.
markGenericMethod: function {
    st: zenv.ZSymbolTable
    op: astnode.view
    mid: ztypes.tid
    isgen: bool
} is {
    if isgen.not then return
    if (functiondefIsNative :op) then return
    st.reg.setGeneric typeId: mid value: true
}

# isFunctionDefOp -- true when an is-block item's operation is a functiondef (a
# method), false for a field type-ref. Gates generic-class method production without
# resolving the function: a generic class never gets a method FUNCTION type of its
# own, only its instances do.
isFunctionDefOp: function {op: astnode.view} out bool is {
    match (
        op
    ) case functiondef then {
        return true
    } else {
        return false
    }
}

# asbinding -- how a type's `as {}` block binds one member name: to `null`,
# which strikes a compiler-provided member off the type, and to anything else,
# which declares it.
asbinding: record {
    # an item of the name is bound to something other than `null`
    declared: bool
    # an item of the name is bound to `null`
    struck: bool
}

# asBindingOf -- how the as-block `asItems` binds `nameId`. Keyed by NAME ID:
# `==`, `!=`, `hash`, `create` all have well-known pool ids, so this compares
# what the pool already interned rather than the text it interned from. The
# `null` is looked up from `ownerDecl`, so a user type named `null` is not one.
asBindingOf: function {
    # the declarations an operand is looked up in
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    # the declaration whose as-block it is
    ownerDecl: ztypes.declid
    asItems: zast.kidspan
    nameId: zast.nameid
} out asbinding is {
    r: asbinding declared: false struck: false
    for each amId: (zast.kidsOf :ast span: asItems) loop {
        am: ast.nodes.get i: amId
        if am.namedoperation when am.name == nameId then {
            vn: atomNameId :ast n: (ast.nodes.get i: am.operation)
            if (namesNullType :st :ast :ownerDecl nameId: vn) then {
                r.struck = true
            } else {
                r.declared = true
            }
        }
    }
    return r
}

# refuseValtypeCopy -- a value type's `.copy` is the compiler's byte copy: a
# valtype holds no reftype, so copying its bytes copies the whole value, and
# the copy can be neither written in the `as` block nor struck off with `copy:
# null`. A value that must never be duplicated is a class.
refuseValtypeCopy: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    asItems: zast.kidspan
    defName: StringView
} is {
    for each amId: (zast.kidsOf :ast span: asItems) loop {
        am: ast.nodes.get i: amId
        if am.namedoperation when am.name == zast.wellKnown.slot.wkCopy then {
            (
                addErrorWithHint
                :st
                nodeid: am.nodeid
                lineno: am.lineno
                colno: am.colno
                e: zast.err.typeError
                msg: "'\{defName}' is a value type: its `.copy` is the compiler's byte copy, which cannot be written or struck off"
                note: "a value type holds no reftype, so copying its bytes copies the whole value".string
                hint: "a value that must never be duplicated is a class".string
                width: 4
            )
        }
    }
}

# eqNullOptOut -- true when a type's `as {}` block opts out of equality by
# declaring `==: null` or `!=: null` (mirrors the `create: null` opt-out): the
# record / variant synthetic `==` / `!=` is then suppressed, so a comparison on
# the type resolves no method and is a hard error.
eqNullOptOut: function {
    # the declarations the `==: null` operand is looked up in
    st: zenv.ZSymbolTable.view
    # the tree holding the as-block
    ast: Ast.view
    # the declaration whose as-block may strike equality off
    ownerDecl: ztypes.declid
    # the as-block's items
    asItems: zast.kidspan
} out bool is {
    eq: asBindingOf :st :ast :ownerDecl :asItems nameId: zast.wellKnown.slot.wkOpEq
    if eq.struck then return true
    return (asBindingOf :st :ast :ownerDecl :asItems nameId: zast.wellKnown.slot.wkOpNe).struck
}

# attachAsConstant -- an `as`-section member that is not a function is a constant
# of the type when its value folds: a literal, a string, an expression, an `if`,
# another constant. One that does not fold is still a constant, never a field,
# unless its value may name a type. The type owns it as a unit owns its constants -- folded
# through the same channel, keyed on the type -- so the member's type is the
# value's. A generic parameter, the tag spec, an implementation and an opt-out
# (`create: null`) are not values and are not asked (asItemNamesNoValue).
attachAsConstant: function {
    st: zenv.ZSymbolTable
    ast: Ast
    parentId: ztypes.tid
    item: argref
} is {
    if item.operation.isZero then return
    tdecl: st.typing.declIdOfType typeId: parentId
    if (asItemNamesNoValue :st :ast typeDecl: tdecl :item) then return
    md: st.typing.declMemberIdOf parentTypeId: parentId nameId: item.name
    if md.isZero then return
    # an alias names a type, not a value; asked before the fold, which would
    # declare an application's instance (`Elems: (ListVal t)`) as the member's
    # type and so make it a field
    if (memberaccess.asMemberIsAlias :st :ast :tdecl :md) then return
    # only an instance has a value for a constant over the template's numeric
    # parameter: each instance folds it, and says why it does not
    # (foldInstanceConstant)
    if (instanceOnlyAsConstant :st :ast :parentId :item) then {
        st.typing.markAsConstDecl declId: md
        return
    }
    statics.constFoldDecl :ast :st declId: md
    folded: statics.constValueOfDecl :st declId: md
    if folded.kind.none then {
        reported: reportAsMemberNotConstant :st :ast :parentId :item
        if reported.not then reported = statics.reportUnknownAsHead :st :ast :parentId :item
        if reported.not then reported = reportAsConstruction :st :ast :parentId :item
        # a bare name or a path that names a type and is no alias -- the item's
        # own name, say -- is attachMarkers' to refuse
        if reported.not when (instantiate.valueMayNameType :st :ast :parentId node: item.operation
        ) then return
    }
    st.typing.markAsConstDecl declId: md
}

# instanceOnlyAsConstant -- the `as` constant `item` of the template
# `parentId` reads one of the template's numeric generic parameters, which
# only an instance has a value for.
instanceOnlyAsConstant: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    parentId: ztypes.tid
    item: argref
} out bool is {
    if (st.reg.genericOriginOf tid: parentId).notZero then return false
    tdecl: st.typing.declIdOfType typeId: parentId
    if (st.reg.genericNumericParamCountOf :tdecl) == 0 then return false
    return (statics.constReadsNumericParam :st :ast owner: tdecl opId: item.operation)
}

# reportAsConstruction -- an `as` item whose value constructs a type that is not
# generic (`origin: (Pt x: 0)`): no type application, and no constant either,
# since only a data value is built outside a function. True when it reported.
reportAsConstruction: function {
    st: zenv.ZSymbolTable
    ast: Ast
    parentId: ztypes.tid
    item: argref
} out bool is {
    headNid: zast.nodeid
    {
        vn: ast.nodes.get i: item.operation
        if vn.call.not then return false
        headNid = vn.callable
    }
    td: st.typing.declIdOfType typeId: parentId
    if td.isZero then return false
    htpl: (
        typeargs.typeApplicationTemplate
        :st
        scope: td
        :ast
        unitDecl: (unitRootOfDecl typing: st.typing declId: td)
        callableNid: headNid
    )
    if htpl.isZero or (st.reg.isGenericOf tid: htpl) then return false
    if (st.reg.typetypeOf typeId: htpl).isUserFamily.not then return false
    nm: zast.nameTextCopy :ast ref: item.name
    (
        addErrorWithHint
        :st
        nodeid: item.nid
        lineno: item.lineno
        colno: item.colno
        e: zast.err.typeError
        msg: "a type constant takes a constant value, not a construction".string
        note: "".string
        hint: "construct it inside a function, or make '\{nm}' a function that returns the value"
        width: nm.length
    )
    return true
}

# reportAsMemberNotConstant -- an `as` item whose value is a bare name the type's
# own scope declares as something with no value -- a field, a method: the E0600
# a constant reading a run-time value gets. Such a name is found in the type's
# scope and stops there, so it is no implementation label and no type either.
# True when it reported.
reportAsMemberNotConstant: function {
    st: zenv.ZSymbolTable
    ast: Ast
    parentId: ztypes.tid
    item: argref
} out bool is {
    vnId: zast.nameid
    ln: u32
    co: u32
    vn: ast.nodes.get i: item.operation
    vnId = zast.atomNameIdOf n: vn
    ln = nodeLine n: vn
    co = nodeCol n: vn
    if vnId.isZero then return false
    # its own name: the nearest declaration is the item being made
    if vnId == item.name then {
        sn: zast.nameTextAt :ast ref: vnId
        (
            addErrorWithHint
            :st
            nodeid: item.operation
            lineno: ln
            colno: co
            e: zast.err.constError
            msg: "'\{sn}' is defined in terms of itself"
            note: "".string
            hint: "a definition's value may not name the definition; the shorthand `:\{sn}` names `\{sn}` as it is named outside it"
            width: sn.length
        )
        return true
    }
    ownDecl: st.typing.declIdOfType typeId: parentId
    if (st.typing.declFindChild parentDeclId: ownDecl nameId: vnId).isZero then return false
    vt: zast.nameTextAt :ast ref: vnId
    (
        addErrorWithHint
        :st
        nodeid: item.operation
        lineno: ln
        colno: co
        e: zast.err.constError
        msg: "'\{vt}' has no compile-time value"
        note: "an `as` constant is evaluated at compile time; a field or a method has no value there".string
        hint: "".string
        width: vt.length
    )
    return true
}

# namesNullType -- whether the bare name `nameId`, written in the definition
# `ownerDecl` declares, names the null type: its nearest declaration is the
# system unit's own `null`, reached directly or through re-exports (core's
# `null: system.null`). Read from the declarations, so nothing is resolved or
# minted. A record a nearer scope declares under the name is that record, so an
# opt-out (`create: null`) and a payload-less arm are written with the system's
# `null` only.
namesNullType: function {
    # the declarations the name is looked up in, never resolved
    st: zenv.ZSymbolTable.view
    # the tree the re-exports are read from
    ast: Ast.view
    # the declaration whose definition the name is written in
    ownerDecl: ztypes.declid
    # the name, interned; 0 when the operand is no bare name
    nameId: zast.nameid
} out bool is {
    if ownerDecl.isZero then return false
    return (
        resolve.namesNullTypeAt
        :st
        :ast
        unitDecl: (unitRootOfDecl typing: st.typing declId: ownerDecl)
        scope: (st.typing.declParentOf declId: ownerDecl)
        :nameId
    )
}

# attachInterfaceAsConstants -- a protocol's or a facet's `as` constants. An
# interface declares its specs in the `is` block, so nothing else walks its
# `as` items; each one that is not a function is asked as any type's is. A
# generic parameter is no constant: registerInterfaceGenerics has it.
attachInterfaceAsConstants: function {
    st: zenv.ZSymbolTable
    ast: Ast
    parentId: ztypes.tid
    fnode: objref
} is {
    k: u64
    for k < fnode.nas loop {
        itemId: zast.objAsItemAt :ast nid: fnode.nid i: k
        k = k + 1
        item: argRefAt :ast nid: itemId
        if item.nid.isZero or item.operation.isZero then continue
        if (ast.nodes.get i: item.operation).functiondef then continue
        if (zast.isGenericParamOp :ast opId: item.operation) then continue
        attachAsConstant :st :ast :parentId :item
    }
}

# refuseInterfaceBodyParam -- a generic parameter in a protocol's or a facet's
# body, reported at its name.
refuseInterfaceBodyParam: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    parentId: ztypes.tid
    item: argref
} is {
    kind: "protocol"
    if (st.reg.typetypeOf typeId: parentId) == ztypes.ztypetype.facetType then kind = "facet"
    pn: zast.nameTextAt :ast ref: item.name
    (
        addError
        :st
        nodeid: item.nid
        lineno: item.lineno
        colno: item.colno
        e: zast.err.genericError
        msg: "'\{pn}' is a generic parameter: a \{kind} declares its parameters in its `as` block, as every type does, and its body holds only its specs"
    )
}

# methodsAreTemplate -- the methods of `objId` belong to a generic template: its
# `as` block declares a generic parameter, or it is a type a generic unit
# declares, generic over the unit's parameters.
methodsAreTemplate: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    objId: zast.nodeid
    parentId: ztypes.tid
} out bool is {
    onA: ast.nodes.get i: objId
    if onA.objectdef when (zast.itemsHaveGenericParam :ast items: onA.asItems) then return true
    return (st.reg.isGenericOf tid: parentId)
}

# attachMethods -- resolve an as-block's method items (namedoperation -> functiondef)
# as children of `parentId`, returning whether one is named `create` (so the caller
# skips the synth create). Takes the item list by value so its iterator's lock is
# released on return -- letting attachMarkers re-scan the same list (cf. resolveUnion).
attachMethods: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    parentId: ztypes.tid
    objId: zast.nodeid
} out bool is {
    hasCreate: false
    # a generic template's methods are cloned BY ID into every instance
    # (mintMono reads a member list), so a template's signatures resolve eagerly
    agen: methodsAreTemplate :st :ast :objId :parentId
    orf: objRefAt :ast nid: objId
    kAiter: u64
    for kAiter < orf.nas loop {
        amId: zast.objAsItemAt :ast nid: objId i: kAiter
        kAiter = kAiter + 1
        am: argRefAt :ast nid: amId
        if am.nid.notZero then {
            mname: zast.nameTextCopy :ast ref: am.name
            if am.name == zast.wellKnown.slot.wkCreate then hasCreate = true
            {
                mop: ast.nodes.get i: am.operation
                if mop.functiondef then {
                    (
                        checkMemberDeclEagerly
                        :st
                        :ast
                        fnode: (fnRefOf fnode: mop)
                        thisTid: parentId
                        defName: mname.stringView
                    )
                }
            }
            ownerNmId: nameIdOf :ast name: defName
            # a function a field of the type is declared by was resolved when
            # the field attached (fieldHeadMemberTid), and keeps that signature
            mido: st.typing.declChildOfId parentTypeId: parentId nameId: am.name
            if mido.none then mido = (
                resolveMethodFnLazy
                :st
                :scope
                :ast
                :unitDecl
                ownerNameId: ownerNmId
                mname: mname.stringView
                thisName: defName
                opId: am.operation
                lazyOk: agen.not
            )
            match (
                mido
            ) case some then {
                st.typing.setMemberType parentTypeId: parentId nameId: am.name childTypeId: mido
                markGenericMethod :st op: (ast.nodes.get i: am.operation) mid: mido isgen: agen
            } case none then {
                attachAsConstant :st :ast :parentId item: am
            }
        }
    }
    return hasCreate
}

# asItemIsNoMarker -- an `as` item that is not an implementation marker although it
# may name a type: one already folded to a constant of the type, or one whose
# bare value names a member of the type's own scope.
asItemIsNoMarker: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    parentId: ztypes.tid
    item: zast.nameid
    op: zast.nodeid
} out bool is {
    ptid: parentId
    itemDecl: st.typing.declMemberIdOf parentTypeId: ptid nameId: item
    if (st.typing.isAsConstDecl declId: itemDecl) then return true
    vnId: zast.atomNameIdOf n: (ast.nodes.get i: op)
    if vnId.isZero then return false
    ownDecl: st.typing.declIdOfType typeId: ptid
    return (st.typing.declFindChild parentDeclId: ownDecl nameId: vnId).notZero
}

# asItemMarkerTarget -- the facet or protocol an `X.implement` item implements,
# or none. An item naming a type bare -- an interface as any other -- is
# refused here as no member an `as` section holds (asItemNamesPlainType,
# asItemTypeNameRefused), so it implements nothing.
asItemMarkerTarget: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    unitDecl: ztypes.declid
    ast: Ast
    parentId: ztypes.tid
    item: zast.nameid
    op: zast.nodeid
    # the item is written `X.implement`; `op` is its X
    implemented: bool
} out optionval ztypes.tid is {
    mtid: (
        conform.markerTargetId
        :st
        :scope
        :unitDecl
        :ast
        opNid: op
        ownerDecl: (st.typing.declIdOfType typeId: parentId)
    )
    if implemented then return (conform.implementTargetOf :st :scope :unitDecl :ast target: mtid :op
    )
    refused: false
    match (
        mtid
    ) case some then {
        refused = asItemNamesPlainType :st :ast :parentId :item
    } case none then {
        if (isLabelValue op: (ast.nodes.get i: op)).not then {
            asItemTypeNameRefused :st :scope :ast :unitDecl :parentId :item :op
            # a member the path's type does not declare is the value's error,
            # where it is written: the member has no type, and a read of it --
            # a field declared by it among them -- reports nothing further
            # (memberDefinitionFailed)
            if (typeref.reportMissingTypeMember :st :scope :ast :unitDecl :op) then (
                st.typing.refusedValues.add
                item: op
            )
        }
    }
    if refused then return (optionval.none ztypes.tid)
    return mtid
}

# asItemNamesPlainType -- an `as` item naming a type bare, the tag spec aside:
# `extra: i64`, `Elem: String`, `m: sizer`. An `as` member is a constant, an
# implementation (`m: sizer.implement`) or a generic parameter, and a field
# belongs in the type's body -- reported here. True when it reported.
asItemNamesPlainType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    parentId: ztypes.tid
    item: zast.nameid
} out bool is {
    if item == zast.wellKnown.slot.wkTag then return false
    reportAsItemTypeName :st :ast :parentId :item
    return true
}

# asItemTypeNameRefused -- an `as` item no marker target answered for, whose bare
# value still names a type: a class (`Elem: String`) or a native record the
# marker walk does not reach (`extra: i64`) is refused as asItemNamesPlainType
# refuses the rest.
asItemTypeNameRefused: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    parentId: ztypes.tid
    item: zast.nameid
    op: zast.nodeid
} is {
    vnId: zast.atomNameIdOf n: (ast.nodes.get i: op)
    if vnId.isZero then return
    if (isNumericLiteralNameAt :ast ref: vnId) then return
    # `create: null` opts out of a member; null is no type an item declares
    if (namesNullType :st :ast ownerDecl: (st.typing.declIdOfType typeId: parentId) nameId: vnId
    ) then return
    if (walkLookupTyperefById :st :scope :ast :unitDecl baseId: vnId).none then return
    asItemNamesPlainType :st :ast :parentId :item
}

# reportAsItemTypeName -- the E0100 for an `as` item whose value is a type name
# that is no implementation.
reportAsItemTypeName: function {
    st: zenv.ZSymbolTable
    ast: Ast
    parentId: ztypes.tid
    item: zast.nameid
} is {
    md: st.typing.declMemberIdOf parentTypeId: parentId nameId: item
    if md.isZero then return
    ar: argRefAt :ast nid: (st.typing.decls.get i: md).node
    # refused where it is written, the item declares no member a read or a
    # construction asks of again (markerTargetId): an application's type, which
    # its value declares when read, goes with it
    st.typing.refusedValues.add item: ar.operation
    st.typing.setMemberType parentTypeId: parentId nameId: item childTypeId: ztypes.tid.zero
    it: zast.nameTextAt :ast ref: item
    (
        addErrorWithHint
        :st
        nodeid: ar.nid
        lineno: ar.lineno
        colno: ar.colno
        e: zast.err.typeError
        msg: "'\{it}' names a type: an `as` member is a constant, an alias of another type, an implementation or a generic parameter"
        note: "".string
        hint: "a field belongs in the type's body".string
        width: it.length
    )
}

# attachMarkers -- resolve an as-block's implementations (`m:
# measurable.implement`, `r: io.Reader.implement`) as children of `parentId`,
# run AFTER the methods so markers take later positions; an item naming a type
# bare is refused (asItemMarkerTarget). Returns whether any marker target owns a
# destructor (a protocol), so a class holder keeps its own.
attachMarkers: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    parentId: ztypes.tid
    objId: zast.nodeid
} out bool is {
    needsDtor: false
    orf: objRefAt :ast nid: objId
    ptdecl: st.typing.declIdOfType typeId: parentId
    kMiter: u64
    for kMiter < orf.nas loop {
        mmId: zast.objAsItemAt :ast nid: objId i: kMiter
        kMiter = kMiter + 1
        # the marker is read through a view scoped to this block (an owned
        # copy of its operation's name): the recordings below lend ast
        isMarker: false
        implemented: false
        mmOp: zast.nodeid
        mmName: zast.nameid
        cnm: String
        {
            mm: ast.nodes.get i: mmId
            # a method is no marker, and is asked nothing more
            if mm.namedoperation when (ast.nodes.get i: mm.operation).functiondef.not then {
                isMarker = true
                mmOp = mm.operation
                mmName = mm.name
                # `r: Reader.implement` names its interface before the marker
                ib: zast.implementBaseOf :ast opId: mmOp
                if ib.notZero then {
                    mmOp = ib
                    implemented = true
                }
                cnm = zast.nameTextCopy :ast ref: (atomNameId :ast n: (ast.nodes.get i: mmOp))
            }
        }
        # a member already folded to a constant of the type is no marker, and
        # neither is a name the type's own scope declares -- reported as having
        # no value where the constant was asked for
        if isMarker when implemented.not when (
            asItemIsNoMarker
            :st
            :ast
            :parentId
            item: mmName
            op: mmOp
        ) then isMarker = false
        # an alias names a type, which it is asked for where it is read
        if isMarker when implemented.not when (
            memberaccess.asMemberIsAlias
            :st
            :ast
            tdecl: ptdecl
            md: (st.typing.declFindChild parentDeclId: ptdecl nameId: mmName)
        ) then isMarker = false
        if isMarker then {
            # `tag: tag` is not a field of the numeric record that carries it:
            # it designates the discriminator STORAGE type so a sum type can
            # spell `u8.tag`. A program declaring no sum type never names it,
            # so it resolves when something does -- forceMemberDecl.
            lazyTag: false
            if st.typing.eagerAll.not when mmName == zast.wellKnown.slot.wkTag then {
                opName: atomNameId :ast n: (ast.nodes.get i: mmOp)
                if opName == zast.wellKnown.slot.wkTag then lazyTag = true
            }
            if (statics.isNumericLiteralName name: cnm.stringView).not when lazyTag.not then {
                (
                    typeref.recordTyperef
                    :st
                    :scope
                    :ast
                    :unitDecl
                    thisName: ""
                    nid: mmOp
                )
            }
            mtid: optionval.none ztypes.tid
            if lazyTag.not then mtid = (
                asItemMarkerTarget
                :st
                :scope
                :unitDecl
                :ast
                :parentId
                item: mmName
                op: mmOp
                :implemented
            )
            if mtid.some then {
                st.typing.setMemberType parentTypeId: parentId nameId: mmName childTypeId: mtid
                # only an `X.implement` item implements; a bare item answered
                # here is the tag spec, which names the tag's storage type
                if implemented then {
                    mlbl: zast.nameTextCopy :ast ref: mmName
                    if (st.reg.needsDestructor typeId: mtid) then needsDtor = true
                    (
                        conform.recordImplementation
                        :st
                        :ast
                        implTypeId: parentId
                        specTypeId: mtid
                        label: mlbl.stringView
                        labelNameId: mmName
                        markerOp: mmOp
                    )
                }
            }
        }
    }
    return needsDtor
}

# recordIsTypedef -- true when a definition is a `typedef`. Such a type gets no
# field child and synthesizes `create`+`borrow` instead of `create`/`==`/`!=`.
recordIsTypedef: function {rnode: objref} out bool is {
    return rnode.kind == zast.objectkind.typedefDef
}

# objectTypedefBaseNode -- the type reference a typedef wraps, its single
# is-item. Zero when the object is not a typedef.
objectTypedefBaseNode: function {ast: Ast.view onode: objref} out zast.nodeid is {
    if (recordIsTypedef rnode: onode).not then return zast.nodeid
    return (zast.objIsItemAt :ast nid: onode.nid i: 0)
}

# objectTypedefBaseId -- the base type name of a typedef (the wrapper's base),
# or zero when the object is not a typedef.
objectTypedefBaseId: function {ast: Ast.view onode: objref} out zast.nameid is {
    bn: objectTypedefBaseNode :ast :onode
    if bn.isZero then return zast.nameid.zero
    # a base named through its unit (`pr.Cell`) is named by the member it reaches
    bnn: ast.nodes.get i: bn
    match (
        bnn
    ) case dottedpath then {
        return (atomNameId :ast n: (ast.nodes.get i: bnn.child))
    } else null
    return (typeargs.paramTypeBaseNameId :ast op: (ast.nodes.get i: bn))
}

# objectTypedefBaseTid -- the base type id of a typedef, or 0 when the object
# is not a typedef or its base does not resolve. A base naming the typedef's
# own generic parameter (`List t`) is the PARTIAL under the typedef's
# declaration, as a generic class's field is; a parameterized base
# (`(List of: u8)`) resolves through the spec trie, which materializes the
# instance; a bare atom (`String`) resolves through the unit ladder.
objectTypedefBaseTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    ownerTid: ztypes.tid
    onode: objref
} out ztypes.tid is {
    bn: objectTypedefBaseNode :ast :onode
    if bn.isZero then return ztypes.tid.zero
    pt: typeargs.partialFieldTid :st :ast :unitDecl :scope :ownerTid oId: bn
    if pt.notZero then return pt
    memberIdAt: (
        resolve.resolveMonoRefInline
        :st
        :scope
        :ast
        :unitDecl
        thisName: ""
        enclDecl: ztypes.declid
        opNid: bn
        nid: zast.nodeid
    )
    if memberIdAt.notZero then return memberIdAt
    # a base named through its unit (`pr.Sh`) is the type the path reaches, not
    # the unit its root names
    if (ast.nodes.get i: bn).dottedpath then {
        dtid: resolve.resolveDottedArgTid :st :scope :ast nid: bn
        if dtid.notZero then return dtid
    }
    anId: rootNameIdOf :ast n: (ast.nodes.get i: bn)
    if anId.isZero then return ztypes.tid.zero
    return (resolve.resolveAtomType :st :scope :ast :unitDecl nameId: anId thisName: "")
}

# fnFieldFlaggableName -- an is-block FUNCTION member that should become a struct
# fnptr slot (a spec field / method / method-ref), excluding the constructor and
# comparison synthetics so they stay free functions / ctors.
fnFieldFlaggableName: function {nameId: zast.nameid} out bool is {
    if nameId == zast.wellKnown.slot.wkCreate then return false
    if nameId == zast.wellKnown.slot.wkOpEq then return false
    return nameId != zast.wellKnown.slot.wkOpNe
}

# aliasentry -- one `alias: member` line of a `public:` block: the name the
# block exposes, the member it stands for, and where it is written. Five
# parallel lists said this before, indexed in lockstep at every use.
aliasentry: record {
    # the name the block exposes
    pub: zast.nameid
    # the member that name stands for
    internal: zast.nameid
    # the source line of the entry
    line: u32
    # the source column of the entry
    col: u32
    # the entry's own node
    node: zast.nodeid
}

# refuseNestedVisibility -- a visibility block describes the unit or type it
# stands in; one inside a `public:` block would describe the interface, which
# has none. True when the entry `m` was such a block and was reported.
refuseNestedVisibility: function {st: zenv.ZSymbolTable ast: Ast.view m: argref} out bool is {
    if m.nid.isZero then return false
    isPubB: zast.unitOpKindIs :ast opId: m.operation k: zast.unitkind.publicNs
    if isPubB.not then return false
    (
        addResolveErrorAt
        :st
        nodeid: m.nid
        lineno: m.lineno
        colno: m.colno
        e: zast.err.typeError
        msg: "a `public:` block cannot hold a `public:` block".string
        width: 6
    )
    return true
}

# scanPublicEntry -- one entry of a `public:` block. Every entry exports its
# own name; an entry spelled as a bare atom whose name DIFFERS from the atom's
# is a rename and is recorded as one. `badMsg` is what any other shape is
# reported as, and "" means it is not an error here -- a TYPE's interface
# admits only those two shapes, while a unit's block also holds its own
# definitions.
scanPublicEntry: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    nid: zast.nodeid
    pubIds: IdSet zast.nameid
    aliases: ListVal aliasentry
    badMsg: StringView
} is {
    bn: ast.nodes.get i: nid
    if bn.namedoperation.not then return
    ent: argRefAt :ast :nid
    if (refuseNestedVisibility :st :ast m: ent) then return
    pubIds.add item: bn.name
    bop: ast.nodes.get i: bn.operation
    match (
        bop
    ) case labelvalue then null case atomid then {
        if bn.name != bop.name then aliases.append from: (
            aliasentry
            pub: bn.name
            internal: bop.name
            line: bn.lineno
            col: bn.colno
            node: bn.nodeid
        )
    } else {
        if badMsg.length > 0 then (
            addResolveErrorAt
            :st
            nodeid: bn.nodeid
            lineno: bn.lineno
            colno: bn.colno
            e: zast.err.typeError
            msg: badMsg.string
            width: 1
        )
    }
}

# scanPublicBlock -- scanPublicEntry over every entry of one `public:` block.
scanPublicBlock: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    body: zast.kidspan
    pubIds: IdSet zast.nameid
    aliases: ListVal aliasentry
    badMsg: StringView
} is {
    for each bId: (zast.kidsOf :ast span: body) loop {
        scanPublicEntry :st :ast nid: bId :pubIds :aliases :badMsg
    }
}

# scanTypeAsBlock -- one `as`-item that may be a visibility block. `private:`
# cannot be redefined, because private already includes every field and method
# of the type; `public:` names the interface, and its entries are read here.
# Answers true when the item WAS a public block.
scanTypeAsBlock: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    n: astnode.view
    pubIds: IdSet zast.nameid
    aliases: ListVal aliasentry
} out bool is {
    if n.namedoperation.not then return false
    if (zast.unitOpKindIs :ast opId: n.operation k: zast.unitkind.publicNs).not then return false
    opNode: ast.nodes.get i: n.operation
    if opNode.unitdef then (
        scanPublicBlock
        :st
        :ast
        body: opNode.body
        :pubIds
        :aliases
        badMsg: "a public interface entry must be ':member' or 'alias: member'"
    )
    return true
}

# scanTypeAsMember -- one `as`-item that is an ordinary definition rather than a
# visibility block: a member the interface may name, and one a `public:` block
# that does not name it excludes.
scanTypeAsMember: function {
    ast: Ast.view
    n: astnode.view
    memberIds: IdSet zast.nameid
    excl: ListVal zast.nameid
    pubIds: IdSet zast.nameid
} is {
    if n.namedoperation.not then return
    if (zast.unitOpKindIs :ast opId: n.operation k: zast.unitkind.publicNs) then return
    memberIds.add item: n.name
    if (pubIds.has item: n.name).not then excl.append from: n.name
}

# checkRenameAlias -- a `public:` rename must name a member this type has, and
# must not collide with one. Answers whether the alias stands.
checkRenameAlias: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    al: aliasentry
    memberIds: IdSet zast.nameid
} out bool is {
    if (memberIds.has item: al.internal).not then {
        iTxt: zast.nameTextAt :ast ref: al.internal
        (
            addResolveErrorAt
            :st
            nodeid: al.node
            lineno: al.line
            colno: al.col
            e: zast.err.typeError
            msg: "public interface exposes '\{iTxt}', which is not a member of this type"
            width: 1
        )
        return false
    }
    if (memberIds.has item: al.pub) then {
        pTxt: zast.nameTextAt :ast ref: al.pub
        (
            addResolveErrorAt
            :st
            nodeid: al.node
            lineno: al.line
            colno: al.col
            e: zast.err.typeError
            msg: "public alias '\{pTxt}' collides with a member of the same name"
            width: 1
        )
        return false
    }
    return true
}

# installRenameAliases -- validate the renames against the now-known member set
# and record that the type has one, which is what turns the rename machinery on.
installRenameAliases: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    aliases: (ListVal aliasentry).view
    memberIds: IdSet zast.nameid
} is {
    for each al: aliases loop {
        if (checkRenameAlias :st :ast :al :memberIds) then st.typing.renameSeen = true
    }
}

# scanVisibility -- one AST-only pass over a type's `public:` block filling two
# out-lists (with-scoped iterators, no lock outlives the scan): `excl` = pool
# ids of USER-declared members NOT in the block (empty when there is no block --
# the all-public default; synthesized members are never listed); `grants` = pool
# ids of fields whose declared type is a `.private` handle (independent of any
# `public:` block). The resolver applies both once the members are registered.
scanVisibility: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    onode: objref
    excl: ListVal zast.nameid
    grants: ListVal zast.nameid
} is {
    pubIds: IdSet zast.nameid
    memberIds: IdSet zast.nameid
    aliases: ListVal aliasentry
    pubFound: false
    kAiter: u64
    for kAiter < onode.nas loop {
        aId: zast.objAsItemAt :ast nid: onode.nid i: kAiter
        kAiter = kAiter + 1
        if (
            scanTypeAsBlock
            :st
            :ast
            n: (ast.nodes.get i: aId)
            :pubIds
            :aliases
        ) then pubFound = true
    }
    kFiter: u64
    for kFiter < onode.nis loop {
        fId: zast.objIsItemAt :ast nid: onode.nid i: kFiter
        kFiter = kFiter + 1
        (
            memberaccess.scanTypeField
            :st
            :ast
            n: (ast.nodes.get i: fId)
            :memberIds
            :grants
            :excl
            :pubIds
            :pubFound
        )
    }
    if pubFound.not then return
    kA2iter: u64
    for kA2iter < onode.nas loop {
        a2Id: zast.objAsItemAt :ast nid: onode.nid i: kA2iter
        kA2iter = kA2iter + 1
        scanTypeAsMember :ast n: (ast.nodes.get i: a2Id) :memberIds :excl :pubIds
    }
    installRenameAliases :st :ast :aliases :memberIds
}

# applyGrantsPrivate -- mark each `.private`-typed field as a friend handle.
applyGrantsPrivate: function {
    st: zenv.ZSymbolTable parentId: ztypes.tid grants: (ListVal zast.nameid).view
} is {
    gi: u64
    gn: grants.length
    for gi < gn loop {
        st.typing.setChildGrantsPrivateId parentTypeId: parentId nameId: (grants.get i: gi)
        gi = gi + 1
    }
}

# scanUnitMember -- one top-level member of a unit, sorted into what it is: a
# `private:` block (which cannot be redefined -- private already includes every
# definition), a `public:` block (whose entries the interface is read from), or
# an ordinary definition (which is a member the interface may name). Returns
# true when it was a public block, which is what tells the caller the unit
# declares an interface at all.
scanUnitMember: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    nid: zast.nodeid
    pubIds: IdSet zast.nameid
    aliases: ListVal aliasentry
    memberIds: IdSet zast.nameid
    memberNameList: ListVal zast.nameid
} out bool is {
    um: ast.nodes.get i: nid
    if um.namedoperation.not then return false
    if (zast.unitOpKindIs :ast opId: um.operation k: zast.unitkind.publicNs).not then {
        memberIds.add item: um.name
        memberNameList.append from: um.name
        return false
    }
    uop: ast.nodes.get i: um.operation
    if uop.unitdef.not then return false
    # "" for badMsg: an atom naming no sibling is not a malformed entry here but
    # a DEFINITION of the block (`MAX: 10`), which a unit's public block may hold
    scanPublicBlock :st :ast body: uop.body :pubIds :aliases badMsg: ""
    return true
}

# scanUnitVisibility -- restrict a file unit's public interface. A `public:`
# block lists the exposed top-level definitions; unlisted defs become private
# (E0101 when referenced from another unit) and `alias: internal` entries
# expose a def under a different public name. A unit exposes its members
# through its publicNs declaration subtree, exactly as a type does.
scanUnitVisibility: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitdefId: zast.nodeid
} is {
    pubIds: IdSet zast.nameid
    memberIds: IdSet zast.nameid
    memberNameList: ListVal zast.nameid
    aliases: ListVal aliasentry
    pubFound: false
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    for each umId: (zast.kidsOf :ast span: bodyIds) loop {
        sawPub: scanUnitMember :st :ast nid: umId :pubIds :aliases :memberIds :memberNameList
        if sawPub then pubFound = true
    }
    if pubFound.not then return
    for each mnidU: memberNameList loop {
        if (pubIds.has item: mnidU).not then st.walk.privacySeen = true
    }
    for each alU: aliases loop {
        okU: true
        # an atom naming no sibling is not a rename but a definition of the
        # block, resolved in the block's scope like any alias
        if (memberIds.has item: alU.internal).not then okU = false
        if okU when (memberIds.has item: alU.pub) then {
            pTxtU: zast.nameTextAt :ast ref: alU.pub
            (
                addResolveErrorAt
                :st
                nodeid: alU.node
                lineno: alU.line
                colno: alU.col
                e: zast.err.typeError
                msg: "public alias '\{pTxtU}' collides with a definition of the same name"
                width: 1
            )
            okU = false
        }
        if okU then st.typing.renameSeen = true
    }
}

# applyUnitVisibility -- run scanUnitVisibility for every file unit that
# declares a `public:` block, after all unit members are registered.
applyUnitVisibility: function {
    st: zenv.ZSymbolTable
    program: Ast.view
} is {
    {
        for each uIdV: program.units loop {
            opIdV: zast.nodeid
            nmV: zast.nameid
            ruV: program.nodes.get i: uIdV
            if ruV.namedoperation then {
                opIdV = ruV.operation
                nmV = ruV.name
            }
            if opIdV.notZero then {
                utidV: ztypes.tid
                {
                    uidoV: (
                        st.typing.declTypeOf
                        declId: (
                            st.typing.declFindChild
                            parentDeclId: st.typing.programRoot
                            nameId: nmV
                        )
                    )
                    if uidoV.notZero then utidV = uidoV
                }
                if utidV.notZero then {
                    scanUnitVisibility :st ast: program unitdefId: opIdV
                    # the entry `main` of the primary unit must stay public:
                    # a `public:` block that omits it hides the entry point
                    if nmV == st.reg.regMainUnitId when (
                        memberaccess.declMemberIsPrivate
                        :st
                        tid: utidV
                        nameId: zast.wellKnown.slot.wkMain
                    ) then {
                        mnid: zast.nodeid
                        mnln: u32
                        mncl: u32
                        {
                            mIds: zast.unitBodyIdsAt ast: program unitId: opIdV
                            mref: program.names.find s: "main"
                            for each memberIdAt: (zast.kidsOf ast: program span: mIds) loop {
                                mn: program.nodes.get i: memberIdAt
                                if mn.namedoperation when (
                                    mn.name == mref
                                ) when mref.notZero then {
                                    mnid = mn.nodeid
                                    mnln = mn.lineno
                                    mncl = mn.colno
                                }
                            }
                        }
                        mmsg: "the entry 'main' must be public".string
                        if mnid.notZero then {
                            (
                                addResolveErrorAt
                                :st
                                nodeid: mnid
                                lineno: mnln
                                colno: mncl
                                e: zast.err.notPublic
                                msg: mmsg
                                width: 4
                            )
                        } else {
                            addResolveError :st e: zast.err.notPublic msg: mmsg
                        }
                    }
                }
            }
        }
    }
}

# fieldHeadMemberTid -- the type of the member of a field's own type that the
# field's type-ref names (`x: helper`), resolved now: a function there makes the
# field a slot defaulting to it. The fields attach before the type's `as` block
# does, so a function is forced in either tier: the eager one resolves the `as`
# block only after the fields. None when the name is no member of the type, or
# names one carrying no type.
fieldHeadMemberTid: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    ownerTid: ztypes.tid
    nameId: zast.nameid
} out optionval ztypes.tid is {
    forceMemberOf :st :ast parentTypeId: ownerTid :nameId
    if st.typing.eagerAll then {
        md: st.typing.declMemberIdOf parentTypeId: ownerTid :nameId
        if md.notZero when (st.typing.decls.get i: md).kind.methodDecl then {
            conform.forceMemberDecl :st :ast memberDeclId: md
        }
    }
    hmd: st.typing.declMemberIdOf parentTypeId: ownerTid :nameId
    if hmd.isZero or (st.typing.decls.get i: hmd).kind.methodDecl.not then {
        return (optionval.none ztypes.tid)
    }
    stdtypes.markMemberUsed :st :ownerTid :nameId
    return (
        resolvedByIdsMember
        :st
        :ast
        :unitDecl
        defId: (zast.poolFind pool: ast.names text: defName)
        memberId: nameId
    )
}

# refuseSelfNamedMember -- a field or an arm whose value starts with its own
# name (`nodeid: nodeid`, `k: k.view`): the nearest declaration of a name is
# the one being made, so the value names the member itself, which is no type.
# The `:nodeid` shorthand says what was meant -- the name as it is named
# outside the declaration. True when it refused.
refuseSelfNamedMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    ownerTid: ztypes.tid
    fm: argref
} out bool is {
    if fm.operation.isZero then return false
    vn: ast.nodes.get i: fm.operation
    head: zast.nameid
    if vn.atomid then head = atomNameId :ast n: (ast.nodes.get i: fm.operation)
    if vn.dottedpath then head = rootNameIdOf :ast n: (ast.nodes.get i: fm.operation)
    if head.isZero then return false
    if head != fm.name then return false
    od: st.typing.declIdOfType typeId: ownerTid
    md: st.typing.declFindChild parentDeclId: od nameId: fm.name
    what: "a field".string
    if md.notZero then what = memberaccess.memberKindPhrase :st :ast tdecl: od :md
    nn: zast.nameTextAt :ast ref: fm.name
    tn: st.reg.nameOf tid: ownerTid
    (
        addErrorWithHint
        :st
        nodeid: fm.operation
        lineno: (nodeLine n: (ast.nodes.get i: fm.operation))
        colno: (nodeCol n: (ast.nodes.get i: fm.operation))
        e: zast.err.typeError
        msg: "'\{nn}' is \{what} of '\{tn}', not a type"
        note: "".string
        hint: "the shorthand `:\{nn}` names the type `\{nn}` as it is named outside the declaration"
        width: nn.length
    )
    st.typing.refusedValues.add item: fm.operation
    return true
}

# attachRecordField -- an isItem that is not a method is a FIELD: resolve its
# type-ref (which may name a SIBLING method, an fn-ptr slot defaulting to it),
# attach it, and record the marker and default the declaration carries.
attachRecordField: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    rid: ztypes.tid
    fm: argref
    fname: StringView
} is {
    if (refuseStringDefault :st :ast what: "field" nameId: fm.name :fm) then return
    refuseSelfNamedMember :st :ast ownerTid: rid :fm
    memberaccess.refuseMarkedFunctionType :st :ast :unitDecl :scope typeNid: fm.operation
    ftnR: fieldHeadNameId :ast n: (ast.nodes.get i: fm.operation)
    # a field's type-ref can name a SIBLING function (an fn-ptr
    # slot defaulting to it), which is a member like any other
    mrefR: fieldHeadMemberTid :st :ast :unitDecl :defName ownerTid: rid nameId: ftnR
    handledR: false
    if mrefR.some then {
        st.typing.setMemberType parentTypeId: rid nameId: fm.name childTypeId: mrefR
        if (st.reg.typetypeOf typeId: mrefR) == ztypes.ztypetype.functionType then {
            st.typing.setChildFnptrField pool: ast.names parentTypeId: rid name: fname
        }
        pdkR: stampNodeId n: (ast.nodes.get i: fm.operation)
        pdoR: rid
        st.walk.pendingDefault.owner.set key: pdkR value: pdoR
        pdk2R: stampNodeId n: (ast.nodes.get i: fm.operation)
        pdiR: mrefR
        st.walk.pendingDefault.id.set key: pdk2R value: pdiR
        handledR = true
    }
    if handledR.not then (
        memberaccess.attachDeclaredField
        :st
        :scope
        :ast
        :unitDecl
        :defName
        :rid
        :fm
        :fname
    )
}

# synthValueMembers -- the comparison pair and the `hash` a record or variant
# carries without declaring them, on its as-block's terms: `==: null` strikes
# the pair, and a declared `==` or `!=` keeps its own (synthComparisonMember
# decides per name); `hash: null` strikes the hash, and a declared `hash` is the
# type's own. `pairOk` is false for a type that takes no comparison pair (a
# typedef); `hashOk` is false where the type already holds a `hash` (an
# instance, its template's copy). Whether a program may USE the hash is decided
# where it is used (valHashMissingPart): it hashes the parts, so it agrees with
# `==` only when `==` is generated too, and every part has a hash of its own.
synthValueMembers: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    ownerTid: ztypes.tid
    # the declaration whose as-block states the terms
    ownerDecl: ztypes.declid
    asItems: zast.kidspan
    pairOk: bool
    eqDecl: bool
    neDecl: bool
    hashOk: bool
} is {
    if pairOk when (eqNullOptOut :st :ast :ownerDecl :asItems).not then (
        stdtypes.synthComparisonPair
        :st
        :ownerTid
        :eqDecl
        :neDecl
    )
    if hashOk.not then return
    h: asBindingOf :st :ast :ownerDecl :asItems nameId: zast.wellKnown.slot.wkHash
    if h.struck.not when h.declared.not then stdtypes.synthHashMember :st rid: ownerTid
}

# checkTypedefShape -- what a typedef's as-block may not declare. It has no
# constructor of its own: it is built from its base, and a user `create` was
# never called. Every generic parameter is a part of the base, so each must
# appear in the base type; one that does not could never be derived from the
# value the typedef is built from.
checkTypedefShape: function {st: zenv.ZSymbolTable ast: Ast.view onode: objref} is {
    bn: objectTypedefBaseNode :ast :onode
    if bn.isZero then return
    # the names the base reads, collected once for every parameter to ask
    baseNames: IdSet zast.nameid
    collectMentions :ast n: (ast.nodes.get i: bn) into: baseNames
    kAiter: u64
    for kAiter < onode.nas loop {
        amId: zast.objAsItemAt :ast nid: onode.nid i: kAiter
        kAiter = kAiter + 1
        am: argRefAt :ast nid: amId
        if am.nid.isZero then continue
        amOp: ast.nodes.get i: am.operation
        nm: zast.nameTextAt :ast ref: am.name
        if am.name == zast.wellKnown.slot.wkCreate when (isFunctionDefOp op: amOp) then {
            (
                addErrorWithHint
                :st
                nodeid: am.nid
                lineno: am.lineno
                colno: am.colno
                e: zast.err.typeError
                msg: "a typedef declares no `create`: it is built from its base".string
                note: String
                hint: "remove it; the typedef is constructed as `T x` or `T.create from: x`".string
                width: 6
            )
        }
        if (isGenericParam :ast op: amOp) when (baseNames.has item: am.name).not then {
            (
                addErrorWithHint
                :st
                nodeid: am.nid
                lineno: am.lineno
                colno: am.colno
                e: zast.err.typeError
                msg: "generic parameter '\{nm}' is not used in the typedef's base type"
                note: "a typedef's parameters are the parts of its base, derived from the value it is built from".string
                hint: "use '\{nm}' in the base type, or remove it"
                width: nm.length
            )
        }
    }
}

# recordTypedefBase -- `X: typedef T` records the base it wraps: the name it is
# written with, then the type, when it resolves here.
recordTypedefBase: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    rnode: objref
    rid: ztypes.tid
} is {
    checkTypedefShape :st :ast onode: rnode
    tdb: objectTypedefBaseId :ast onode: rnode
    if tdb.notZero then {
        named: ztyping.typedefbase name: tdb tid: ztypes.tid.zero
        st.typing.setTypedefBase tid: rid base: named
    }
    tdt: objectTypedefBaseTid :st :scope :ast :unitDecl ownerTid: rid onode: rnode
    if (refuseTypedefOfItself :st own: rid base: tdt onode: rnode) then return
    if tdt.notZero then {
        st.typing.setTypedefBase tid: rid base: (ztyping.typedefbase name: tdb tid: tdt)
    }
}

# objAsItemsOf -- an object definition's as-block items; an empty span when
# the node is not an objectdef.
objAsItemsOf: function {ast: Ast nid: zast.nodeid} out zast.kidspan is {
    od: ast.nodes.get i: nid
    if od.objectdef then return od.asItems
    return (zast.kidspan first: 0 count: 0)
}

# recordisdecls -- which of the members the checker would otherwise
# synthesise the record's `is` block declared itself.
recordisdecls: record {
    create: bool
    eq: bool
    ne: bool
}

# refuseGenericFnptrField -- a function written in an `is` section is a field:
# each instance holds one function, of one type, so it declares no type
# parameters of its own. A generic function is a method, in the `as` section.
refuseGenericFnptrField: function {st: zenv.ZSymbolTable ast: Ast.view fm: argref} out bool is {
    if (fnFieldFlaggableName nameId: fm.name).not then return false
    op: ast.nodes.get i: fm.operation
    if op.functiondef.not then return false
    if (zast.itemsHaveGenericParam :ast items: op.asItems).not then return false
    nm: zast.nameTextAt :ast ref: fm.name
    (
        addError
        :st
        nodeid: fm.nid
        lineno: fm.lineno
        colno: fm.colno
        e: zast.err.genericError
        msg: "'\{nm}' is written in the `is` section, so it is a field holding one function, and a field cannot declare type parameters: declare it in the `as` section to make it a method"
    )
    return true
}

# attachRecordIsItems -- each item of a record's `is` block: a method body
# resolves as a member (a flaggable name also marks an fnptr field); anything
# else is a field.
attachRecordIsItems: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    rnode: objref
    rid: ztypes.tid
    isgen: bool
} out recordisdecls is {
    got: recordisdecls create: false eq: false ne: false
    rt: rid
    ownerNmId: nameIdOf :ast name: defName
    kFiter: u64
    for kFiter < rnode.nis loop {
        fmId: zast.objIsItemAt :ast nid: rnode.nid i: kFiter
        kFiter = kFiter + 1
        fm: argRefAt :ast nid: fmId
        if fm.nid.notZero when (refuseGenericFnptrField :st :ast :fm).not then {
            fname: zast.nameTextCopy :ast ref: fm.name
            mido: (
                resolveMethodFnLazy
                :st
                :scope
                :ast
                :unitDecl
                ownerNameId: ownerNmId
                mname: fname.stringView
                thisName: defName
                opId: fm.operation
                lazyOk: isgen.not
            )
            if mido.none then {
                (
                    attachRecordField
                    :st
                    :scope
                    :ast
                    :unitDecl
                    :defName
                    :rid
                    :fm
                    fname: fname.stringView
                )
            } else {
                got.create = got.create or (fm.name == zast.wellKnown.slot.wkCreate)
                got.eq = got.eq or (fm.name == zast.wellKnown.slot.wkOpEq)
                got.ne = got.ne or (fm.name == zast.wellKnown.slot.wkOpNe)
                st.typing.setMemberType parentTypeId: rt nameId: fm.name childTypeId: mido
                if (fnFieldFlaggableName nameId: fm.name) then {
                    (
                        st.typing.setChildFnptrField
                        pool: ast.names
                        parentTypeId: rt
                        name: fname.stringView
                    )
                }
            }
        }
    }
    return got
}

# resolveRecord -- resolve a record ObjectDef into a RECORD valtype. A normal
# record: a child per field (field name -> type-ref shell), a child per as-block
# method, then synthesized `create`/`==`/`!=`. A typedef over a valtype
# (`x: typedef u64`): no field child, the methods, then `create`+`borrow`. Synth
# children are shallow FUNCTION shells (JOIN-only). Generics arrive later.
resolveRecord: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    rnode: objref
} is {
    rid: (
        declareCanonicalType
        :st
        :scope
        :ast
        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.recordType
    )
    rt: rid
    # `record is native` on the TYPE: the runtime supplies the layout, so
    # routing can ask the declaration whether a type is runtime-backed instead
    # of comparing its name. Mirrors resolveClass.
    st.reg.setNative typeId: rt value: rnode.isNative
    pvExcl_rrid: ListVal zast.nameid
    pvGrants_rrid: ListVal zast.nameid
    scanVisibility :st :ast onode: rnode excl: pvExcl_rrid grants: pvGrants_rrid
    st.reg.setValtype typeId: rt value: true
    asItems: objAsItemsOf :ast nid: rnode.nid
    isgen: zast.itemsHaveGenericParam :ast items: asItems
    unitTmpl: nestedTemplateUnit :st :ast :scope :unitDecl nameId: (nameIdOf :ast name: defName)
    if rnode.kind == zast.objectkind.dataDef then {
        st.reg.setStatic typeId: rt value: true
        refuseStaticShape :st :defName :rnode ownParams: isgen inGenericUnit: unitTmpl.notZero
    }
    if unitTmpl.notZero then isgen = true
    ridDecl: st.typing.declIdOfType typeId: rid
    # BOTH NAMES, INDEPENDENTLY (synthComparisonPair): asking about `==` alone
    # would replace a type's own `!=` with the synth shell.
    eqAsR: (
        asBindingOf
        :st
        :ast
        ownerDecl: ridDecl
        :asItems
        nameId: zast.wellKnown.slot.wkOpEq
    ).declared
    neAsR: (
        asBindingOf
        :st
        :ast
        ownerDecl: ridDecl
        :asItems
        nameId: zast.wellKnown.slot.wkOpNe
    ).declared
    refuseValtypeCopy :st :ast :asItems :defName
    crB: asBindingOf :st :ast ownerDecl: ridDecl :asItems nameId: zast.wellKnown.slot.wkCreate
    if crB.struck then {
        st.walk.createOptOut.add item: rid
    }
    if isgen then {
        st.reg.setGeneric typeId: rt value: true
        typeDecl: declOfUnitDef :st :scope :unitDecl nameId: (nameIdOf :ast name: defName)
        registerGenericParams :st :ast tdecl: typeDecl items: asItems
        if unitTmpl.notZero then registerUnitParamsOn :st :ast tdecl: typeDecl :unitTmpl
        refuseReftypeBounds :st :ast tdecl: typeDecl what: "record" items: asItems
    }
    istd: recordIsTypedef :rnode
    if istd then recordTypedefBase :st :scope :ast :unitDecl :rnode :rid
    isDecls: recordisdecls create: false eq: false ne: false
    if istd.not then isDecls = (
        attachRecordIsItems
        :st
        :scope
        :ast
        :unitDecl
        :defName
        :rnode
        :rid
        :isgen
    )
    hasCreateAs: attachMethods :st :scope :ast :unitDecl :defName parentId: rt objId: rnode.nid
    attachMarkers :st :scope :ast :unitDecl parentId: rid objId: rnode.nid
    if isDecls.create.not when hasCreateAs.not then {
        createId: (
            st.reg.newType
            name: "create"
            ownerTid: rid
            typetype: ztypes.ztypetype.functionType
        )
        (
            st.typing.declSynthMemberTyped
            parentTypeId: rt
            nameId: zast.wellKnown.slot.wkCreate
            kind: ztyping.declkind.methodDecl
            childTypeId: createId
        )
        conform.materializeCreateParams :st :ast typeTid: rid :createId
    }
    # a member the SOURCE declares, by either block: the decl tree does not
    # carry them yet at this point
    if isgen.not then (
        synthValueMembers
        :st
        :ast
        ownerTid: rid
        ownerDecl: ridDecl
        :asItems
        pairOk: istd.not
        eqDecl: eqAsR or isDecls.eq
        neDecl: neAsR or isDecls.ne
        hashOk: true
    )
    if pvExcl_rrid.length > 0 then st.walk.privacySeen = true
    applyGrantsPrivate :st parentId: rid grants: pvGrants_rrid
}

# sumMethodNameRejected -- a variant or union as-block method whose name cannot
# become a member: the reserved discriminator name. (One that repeats an arm's
# name is refused by the parser: a definition's `is` and `as` members are one
# namespace.) True when it was rejected and reported.
sumMethodNameRejected: function {
    st: zenv.ZSymbolTable
    am: argref
} out bool is {
    if am.name == zast.wellKnown.slot.wkTag then {
        mr: "'tag' is a reserved member name".string
        (
            addResolveErrorAt
            :st
            nodeid: am.nid
            lineno: am.lineno
            colno: am.colno
            e: zast.err.reservedMember
            msg: mr
            width: 3
        )
        return true
    }
    return false
}

# attachSumMethods -- a variant's or a union's asItems are its methods. A name that collides
# with one of its ARM names is rejected here: an arm read and a method call spell
# the same at the use site.
attachSumMethods: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    vnode: objref
    sumTid: ztypes.tid
    isgen: bool
} is {
    kAiter: u64
    for kAiter < vnode.nas loop {
        amId: zast.objAsItemAt :ast nid: vnode.nid i: kAiter
        kAiter = kAiter + 1
        am: argRefAt :ast nid: amId
        if am.nid.notZero then {
            mname: zast.nameTextCopy :ast ref: am.name
            ownerNmId: nameIdOf :ast name: defName
            mido: (
                resolveMethodFnLazy
                :st
                :scope
                :ast
                :unitDecl
                ownerNameId: ownerNmId
                mname: mname.stringView
                thisName: defName
                opId: am.operation
                lazyOk: isgen.not
            )
            match (
                mido
            ) case some then {
                if (sumMethodNameRejected :st :am).not then {
                    st.typing.setMemberType parentTypeId: sumTid nameId: am.name childTypeId: mido
                    markGenericMethod :st op: (ast.nodes.get i: am.operation) mid: mido :isgen
                }
            } else {
                # a generic template's tag accessor is its instances'
                (
                    memberaccess.detectTagAccessor
                    :st
                    :scope
                    :ast
                    :unitDecl
                    :defName
                    ownerId: sumTid
                    :am
                )
                if isgen.not then attachAsConstant :st :ast parentId: sumTid item: am
            }
        }
    }
}

# recordTagBase -- the storage a variant or union's `as` block declares for its
# discriminator (`k: u16.tag`), for the backend to honour. The type has `arms`
# arms, which that storage must be able to number.
recordTagBase: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    objId: zast.nodeid
    ownerId: ztypes.tid
    arms: u64
} is {
    # none when nothing is declared: distinct from tid.zero, a data-sourced tag,
    # whose constants set their own width and whose enum must stay the storage
    tb: memberaccess.variantTagBaseTid :st :scope :ast :unitDecl :objId
    declared: ztypes.tid
    listSourced: false
    if tb.some then {
        st.typing.variantTagBase.set key: ownerId value: tb
        declared = tb
        listSourced = declared.isZero
    }
    if listSourced.not then numerics.refuseTagTooNarrow :st :ast :objId :arms :declared
}

# attachVariantTag -- the discriminator member a concrete variant carries: the
# custom tag type its `as` block names, or the default one. A 2-arm sum also
# records which arm the zero discriminator selects.
attachVariantTag: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    vnode: objref
    variantTid: ztypes.tid
    armCountV: u64
    allNullV: bool
} is {
    tagId: (
        mintSumTag
        :st
        :defName
        source: (unionCustomTagId :st :scope :ast :unitDecl objId: vnode.nid)
    )
    # NOT the atomic pair: a tag member is declared by the
    # sweep that discovers it and RE-TYPED here once the
    # tag's own type is known
    (
        st.typing.declSynthMember
        parentTypeId: variantTid
        nameId: zast.wellKnown.slot.wkTag
        kind: ztyping.declkind.fieldDecl
    )
    (
        st.typing.setMemberType
        parentTypeId: variantTid
        nameId: zast.wellKnown.slot.wkTag
        childTypeId: tagId
    )
    # the shape, for whatever backend reads it: every arm written `null`,
    # so the value is an ordinal and nothing needs a tagged struct -- and a
    # discriminator whose values ARE those ordinals.
    if allNullV when armCountV > 0 when (
        memberaccess.variantTagIsOrdinalPlain
        :st
        :scope
        :ast
        :unitDecl
        objId: vnode.nid
    ) then {
        st.typing.ordinalVariant.set key: variantTid value: armCountV
    }
}

# mintSumTag -- the type of sum `defName`'s `tag` member, a tag type of its
# own. A tag the `as` block sources from a list (`tag: levels.tag`) takes its
# arms' values from that list's row.
mintSumTag: function {
    st: zenv.ZSymbolTable
    defName: StringView
    # the list the values come from; a zero row for the default tag
    source: tagsource
} out ztypes.tid is {
    tagName: "\{defName}:tag:data"
    tagId: st.reg.newType name: tagName.stringView typetype: ztypes.ztypetype.tagType
    if source.row == 0 then return tagId
    st.typing.tagSourceAggs.set key: tagId value: source.row
    st.walk.tagSourceDecls.set key: tagId value: source.decl
    return tagId
}

# resolveVariant -- resolve a variant ObjectDef into a VARIANT valtype: a child per
# arm (arm name -> payload type-ref shell; a `null` arm -> the `null` shell), a
# synthesized `tag` child (the `{name}:tag:data` discriminator wrapper), any as-block
# methods, then synthesized `==`/`!=`. Variants have no `create` (bare construction is
# disabled). List-sourced tags + generics arrive later.
resolveVariant: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    vnode: objref
} is {
    variantTid: (
        declareCanonicalType
        :st
        :scope
        :ast
        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.variantType
    )
    vvid: variantTid
    # `variant is native` on the TYPE: the runtime supplies the layout, so
    # routing can ask the declaration rather than compare a name. Mirrors
    # resolveRecord and resolveClass.
    st.reg.setNative typeId: variantTid value: vnode.isNative
    pvExcl_vvid: ListVal zast.nameid
    pvGrants_vvid: ListVal zast.nameid
    scanVisibility :st :ast onode: vnode excl: pvExcl_vvid grants: pvGrants_vvid
    st.reg.setValtype typeId: variantTid value: true
    # a choice's values are static: set before its arms resolve, so an arm may
    # carry an untyped number (fieldSlotTid)
    isChoice: vnode.kind == zast.objectkind.choiceDef
    if isChoice then st.reg.setStatic typeId: variantTid value: true
    vDecl: st.typing.declIdOfType typeId: variantTid
    isgen: false
    onIsgen: ast.nodes.get i: vnode.nid
    if onIsgen.objectdef then {
        isgen = zast.itemsHaveGenericParam :ast items: onIsgen.asItems
    }
    unitTmplV: nestedTemplateUnit :st :ast :scope :unitDecl nameId: (nameIdOf :ast name: defName)
    if isChoice then (
        refuseStaticShape
        :st
        :defName
        rnode: vnode
        ownParams: isgen
        inGenericUnit: unitTmplV.notZero
    )
    if unitTmplV.notZero then isgen = true
    eqAsV: false
    neAsV: false
    {
        onEqAsV: ast.nodes.get i: vnode.nid
        if onEqAsV.objectdef then {
            eqAsV = (
                asBindingOf
                :st
                :ast
                ownerDecl: vDecl
                asItems: onEqAsV.asItems
                nameId: zast.wellKnown.slot.wkOpEq
            ).declared
            neAsV = (
                asBindingOf
                :st
                :ast
                ownerDecl: vDecl
                asItems: onEqAsV.asItems
                nameId: zast.wellKnown.slot.wkOpNe
            ).declared
        }
    }
    vAsItems: zast.kidspan first: 0 count: 0
    vOn: ast.nodes.get i: vnode.nid
    if vOn.objectdef then vAsItems = vOn.asItems
    refuseValtypeCopy :st :ast asItems: vAsItems :defName
    if isgen then {
        st.reg.setGeneric typeId: variantTid value: true
        typeDecl: declOfUnitDef :st :scope :unitDecl nameId: (nameIdOf :ast name: defName)
        {
            onRg: ast.nodes.get i: vnode.nid
            if onRg.objectdef then {
                registerGenericParams :st :ast tdecl: typeDecl items: onRg.asItems
                if unitTmplV.notZero then (
                    registerUnitParamsOn
                    :st
                    :ast
                    tdecl: typeDecl
                    unitTmpl: unitTmplV
                )
                (
                    refuseReftypeBounds
                    :st
                    :ast
                    tdecl: typeDecl
                    what: "variant"
                    items: onRg.asItems
                )
            }
        }
    }
    # an ORDINAL variant: every arm written `null`, so nothing distinguishes one
    # value but which arm it is. Recorded for the backend at the end of the loop.
    allNullV: true
    armCountV: u64
    firstArmV: zast.nameid
    secondArmV: zast.nameid
    kFiter: u64
    for kFiter < vnode.nis loop {
        fmId: zast.objIsItemAt :ast nid: vnode.nid i: kFiter
        kFiter = kFiter + 1
        fm: argRefAt :ast nid: fmId
        if fm.nid.notZero then {
            armCountV = armCountV + 1
            if armCountV == 1 then firstArmV = fm.name
            if armCountV == 2 then secondArmV = fm.name
            anV: atomNameId :ast n: (ast.nodes.get i: fm.operation)
            if (namesNullType :st :ast ownerDecl: vDecl nameId: anV).not then allNullV = false
            if fm.name == zast.wellKnown.slot.wkTag then {
                mt: "'tag' is a reserved member name".string
                (
                    addResolveErrorAt
                    :st
                    nodeid: fm.nid
                    lineno: fm.lineno
                    colno: fm.colno
                    e: zast.err.reservedMember
                    msg: mt
                    width: 3
                )
            }
            # skip only the offending arm: aborting the whole definition would
            # leave every LATER arm unresolved and report each use of one as a
            # missing member, burying the real mistake under its own fallout
            armPayloadV: "String"
            if isChoice then armPayloadV = "text"
            armBadV: refuseStringArmPayload :st :ast :fm payload: armPayloadV
            if armBadV then continue
            if (refuseSelfNamedMember :st :ast ownerTid: variantTid :fm) then continue
            # an arm over the variant's own parameter (`(Cell t: t)`) is a
            # partial, as a field's is
            cid: (
                memberaccess.fieldSlotTid
                :st
                :ast
                :unitDecl
                :scope
                ownerTid: variantTid
                oId: fm.operation
                thisName: defName
            )
            if (memberaccess.refuseArmPayload :st :ast :fm :defName :cid :isChoice) then continue
            st.typing.setMemberType parentTypeId: variantTid nameId: fm.name childTypeId: cid
            (
                typeref.recordTyperef
                :st
                :scope
                :ast
                :unitDecl
                thisName: ""
                nid: fm.operation
            )
        }
    }
    # Both arm names of a 2-arm sum, whatever the arms carry and whether or not
    # the type is generic: a template's arms ARE its monos'.
    #
    # Positional: which of these is the FALSY arm is a separate question, asked
    # of the discriminator by ztyping.sumPairZeroArm.
    if armCountV == 2 then {
        st.typing.sumPairFirstArm.set key: variantTid value: firstArmV
        st.typing.sumPairSecondArm.set key: variantTid value: secondArmV
    }
    # the discriminator's declared storage, so a backend can honour it; a
    # generic template's is its instances'
    recordTagBase :st :scope :ast :unitDecl objId: vnode.nid ownerId: variantTid arms: armCountV
    if isgen.not then {
        (
            attachVariantTag
            :st
            :ast
            :unitDecl
            :scope
            :defName
            :vnode
            :variantTid
            :armCountV
            :allNullV
        )
    }
    attachSumMethods :st :ast :unitDecl :scope :defName :vnode sumTid: variantTid :isgen
    attachMarkers :st :scope :ast :unitDecl parentId: variantTid objId: vnode.nid
    if isgen.not then (
        synthValueMembers
        :st
        :ast
        ownerTid: variantTid
        ownerDecl: vDecl
        asItems: vAsItems
        pairOk: true
        eqDecl: eqAsV
        neDecl: neAsV
        hashOk: true
    )
    if pvExcl_vvid.length > 0 then st.walk.privacySeen = true
    applyGrantsPrivate :st parentId: vvid grants: pvGrants_vvid
}

# unionCustomTagId -- a sum's list-sourced tag, if any: an `as { tag:
# <list>.tag }` item whose `<list>` is a list. A zero row when there is none
# (the sum then synthesizes its own tag).
unionCustomTagId: function {
    ast: Ast
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    objId: zast.nodeid
} out tagsource is {
    orf: objRefAt :ast nid: objId
    kIter: u64
    for kIter < orf.nas loop {
        amId: zast.objAsItemAt :ast nid: objId i: kIter
        kIter = kIter + 1
        am: argRefAt :ast nid: amId
        if am.nid.notZero then {
            r: resolve.unionCustomTagOfArm :st :scope :ast :unitDecl :am
            if r.row != 0 then return r
        }
    }
    return (tagsource row: 0 decl: ztypes.declid)
}

# refuseStaticShape -- a data type or a choice declares its layout by its
# fields or arms and is concrete: it cannot be native, take type parameters,
# or be declared in a generic unit, since each instance of that unit would
# need its own.
refuseStaticShape: function {
    st: zenv.ZSymbolTable
    defName: StringView
    rnode: objref
    # whether it declares type parameters of its own
    ownParams: bool
    inGenericUnit: bool
} is {
    noun: "data type"
    parts: "fields"
    if rnode.kind == zast.objectkind.choiceDef then {
        noun = "choice"
        parts = "arms"
    }
    msg: String
    if rnode.isNative then msg = "'\{defName}' is a \{noun}: its \{parts} declare its layout, so it cannot be native"
    if ownParams then msg = "'\{defName}' is a \{noun}: a \{noun} cannot take type parameters"
    if inGenericUnit then msg = "'\{defName}' is a \{noun}: a \{noun} cannot be declared in a generic unit"
    if msg.length == 0 then return
    (
        addError
        :st
        nodeid: rnode.nid
        lineno: rnode.lineno
        colno: rnode.colno
        e: zast.err.typeError
        :msg
    )
}

# refuseReftypeBounds -- a valtype template's parameter bound must admit
# valtypes only: a field or arm typed by the parameter is a record field or
# a variant arm of every mono, and refuseReftypeMember's rule reaches it
# through the bound. The parameter stays registered; only the bound is
# reported.
refuseReftypeBounds: function {
    st: zenv.ZSymbolTable
    ast: Ast
    tdecl: ztypes.declid
    what: StringView
    items: zast.kidspan
} is {
    bi: u64
    bn: items.count.u64
    for bi < bn loop {
        bid: zast.kidAt kids: ast.kids span: items i: bi
        bi = bi + 1
        fm: argRefAt :ast nid: bid
        if fm.nid.notZero when (
            isGenericParam
            :ast
            op: (ast.nodes.get i: fm.operation)
        ) when (conform.boundAdmitsReftype :st :ast :tdecl :fm) then {
            pn: zast.nameTextAt :ast ref: fm.name
            mb: "a \{what}'s type parameter holds valtypes; bound '\{pn}' with 'anyval.generic'"
            (
                addResolveErrorAt
                :st
                nodeid: fm.nid
                lineno: fm.lineno
                colno: fm.colno
                e: zast.err.typeError
                msg: mb
                width: pn.length
            )
        }
    }
}

# attachUnionArm -- resolve one union isItem into an arm: its payload type, the
# ordinal it carries, and the diagnostics an ill-formed arm earns. Answers the
# arm's tid, or 0 for a null (payload-less) arm.
attachUnionArm: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    uid: ztypes.tid
    defName: StringView
    fm: argref
} is {
    aname: zast.nameTextCopy :ast ref: fm.name
    if fm.name == zast.wellKnown.slot.wkTag then {
        mt: "'tag' is a reserved member name".string
        (
            addResolveErrorAt
            :st
            nodeid: fm.nid
            lineno: fm.lineno
            colno: fm.colno
            e: zast.err.reservedMember
            msg: mt
            width: 3
        )
    }
    # A `(Box T)` arm collapses to T: the arm child IS the boxed valtype, and
    # the arm is recorded as boxed -- a heap cell, where a bare valtype arm is
    # stored in the union's slot when it fits (checkUnionArmSlots). Only the
    # builtin Box collapses: the callee is resolved where the arm is written,
    # so a user class named Box resolves as an ordinary parameterized arm.
    armTe: fm.operation
    armOpId: fm.operation
    # the arm's call shape is read as plain values: the lookup below lends ast
    acr: statics.callRefAt :ast nid: armOpId
    if acr.nid.notZero then {
        calleeName: atomNameId :ast n: (ast.nodes.get i: acr.callable)
        ct: (
            (walkLookupTyperefById :st :scope :ast :unitDecl baseId: calleeName).or
            d: ztypes.tid.zero
        )
        isBx: false
        if ct.notZero when (
            ct == (stdtypes.stdTidRo :ast :st wk: zast.wellKnown.slot.tyBox)
        ) then isBx = true
        if isBx then {
            kB: u64
            for kB < acr.nargs loop {
                baId: zast.callArgAt :ast nid: acr.nid i: kB
                kB = kB + 1
                ba: argRefAt :ast nid: baId
                if ba.nid.notZero when armTe == fm.operation then armTe = ba.operation
            }
        }
    }
    # an arm over the union's own parameter is a partial, as a field's is
    cid: (
        memberaccess.fieldSlotTid
        :st
        :ast
        :unitDecl
        :scope
        ownerTid: uid
        oId: armTe
        thisName: defName
    )
    # a payload refused where it is written has no type to judge; a generic
    # parameter has no family until an instance binds it (`anyval.generic` is a
    # value type, and `(Box t)` is how a wide one is held)
    boxesParam: cid.notZero and ((st.reg.typetypeOf typeId: cid) == ztypes.ztypetype.genericParam)
    if armTe != fm.operation when cid.notZero when boxesParam.not when (st.reg.isValtypeOf tid: cid
    ).not then {
        bxw: typeargs.atomName :ast n: (ast.nodes.get i: armTe)
        mbx: "'\{bxw}' is already a reftype; a union arm holds it directly -- drop the Box"
        (
            addResolveErrorAt
            :st
            nodeid: fm.nid
            lineno: fm.lineno
            colno: fm.colno
            e: zast.err.typeError
            msg: mbx
            width: aname.length
        )
    }
    st.typing.setMemberType parentTypeId: uid nameId: fm.name childTypeId: cid
    if armTe != fm.operation then {
        st.walk.boxedArms.add item: (st.typing.armKey parentTypeId: uid nameId: fm.name)
    }
    # An arm's marker is the payload's, not the union's: the shell
    # resolve above strips it, so record it per member the way a class
    # field does. `view` / `hold` are what a match arm reads back.
    alk: pathOwnership :ast n: (ast.nodes.get i: fm.operation)
    if alk.some then {
        (
            st.typing.setChildOwnership
            pool: ast.names
            parentTypeId: uid
            name: aname.stringView
            ownership: alk
        )
    }
    (
        typeref.recordTyperef
        :st
        :scope
        :ast
        :unitDecl
        thisName: ""
        nid: armTe
    )
}

# resolveUnion -- resolve a union ObjectDef into a UNION reference type: a child
# per arm (arm name -> payload type-ref shell; a `null` arm -> the `null` shell),
# a synthesized `tag` child (the `{name}:tag:data` discriminator wrapper), then any
# as-block methods. Unions are reference types (is_valtype false); they have no
# `create` (bare construction is disabled) and no `==`/`!=`. A union keeps a
# destructor unless every arm is `null` (Priority elides it; IntResult/Result/Typed
# keep it). A list-sourced tag (`as { tag: <list>.tag }`) becomes the `tag` child in
# place of the synth wrapper; generics arrive later.
resolveUnion: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    vnode: objref
} is {
    uid: (
        declareCanonicalType
        :st
        :scope
        :ast
        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.unionType
    )
    uuid: uid
    pvExcl_uuid: ListVal zast.nameid
    pvGrants_uuid: ListVal zast.nameid
    scanVisibility :st :ast onode: vnode excl: pvExcl_uuid grants: pvGrants_uuid
    st.reg.setValtype typeId: uid value: false
    uDecl: st.typing.declIdOfType typeId: uid
    isgen: false
    onIsgen: ast.nodes.get i: vnode.nid
    if onIsgen.objectdef then {
        isgen = zast.itemsHaveGenericParam :ast items: onIsgen.asItems
    }
    unitTmplU: nestedTemplateUnit :st :ast :scope :unitDecl nameId: (nameIdOf :ast name: defName)
    if unitTmplU.notZero then isgen = true
    if isgen then {
        st.reg.setGeneric typeId: uid value: true
        typeDecl: declOfUnitDef :st :scope :unitDecl nameId: (nameIdOf :ast name: defName)
        {
            onRg: ast.nodes.get i: vnode.nid
            if onRg.objectdef then {
                registerGenericParams :st :ast tdecl: typeDecl items: onRg.asItems
            }
        }
        if unitTmplU.notZero then (
            registerUnitParamsOn
            :st
            :ast
            tdecl: typeDecl
            unitTmpl: unitTmplU
        )
    }
    allNull: true
    armCountU: u64
    firstArmU: zast.nameid
    secondArmU: zast.nameid
    kFiter: u64
    for kFiter < vnode.nis loop {
        fmId: zast.objIsItemAt :ast nid: vnode.nid i: kFiter
        kFiter = kFiter + 1
        fm: argRefAt :ast nid: fmId
        if fm.nid.notZero then {
            armCountU = armCountU + 1
            if armCountU == 1 then firstArmU = fm.name
            if armCountU == 2 then secondArmU = fm.name
            anU: atomNameId :ast n: (ast.nodes.get i: fm.operation)
            if (namesNullType :st :ast ownerDecl: uDecl nameId: anU).not then allNull = false
            armBadU: refuseStringArmPayload :st :ast :fm
            if armBadU then continue
            if (refuseSelfNamedMember :st :ast ownerTid: (st.typing.declTypeOf declId: uDecl) :fm
            ) then continue
            attachUnionArm :st :ast :unitDecl :scope :uid :defName :fm
        }
    }
    # both arm names of a 2-arm sum -- the union half of the same record the
    # variant resolver writes. Option and Result are the reason it exists.
    if armCountU == 2 then {
        st.typing.sumPairFirstArm.set key: uid value: firstArmU
        st.typing.sumPairSecondArm.set key: uid value: secondArmU
    }
    # the discriminator's declared storage, so a backend can honour it; a
    # generic template's is its instances'
    recordTagBase :st :scope :ast :unitDecl objId: vnode.nid ownerId: uid arms: armCountU
    if isgen.not then {
        tagId: (
            mintSumTag
            :st
            :defName
            source: (unionCustomTagId :st :scope :ast :unitDecl objId: vnode.nid)
        )
        # NOT the atomic pair: a tag member is declared by the
        # sweep that discovers it and RE-TYPED here once the
        # tag's own type is known
        (
            st.typing.declSynthMember
            parentTypeId: uid
            nameId: zast.wellKnown.slot.wkTag
            kind: ztyping.declkind.fieldDecl
        )
        (
            st.typing.setMemberType
            parentTypeId: uid
            nameId: zast.wellKnown.slot.wkTag
            childTypeId: tagId
        )
    }
    attachSumMethods :st :ast :unitDecl :scope :defName :vnode sumTid: uid :isgen
    attachMarkers :st :scope :ast :unitDecl parentId: uid objId: vnode.nid
    if allNull.not then {
        st.reg.setNeedsDestructor typeId: uid
    }
    if pvExcl_uuid.length > 0 then st.walk.privacySeen = true
    applyGrantsPrivate :st parentId: uuid grants: pvGrants_uuid
}

# resolveClassMethodDecl -- resolve a method declared in a class's `is` block:
# its signature, and the member entry that makes it reachable from the type.
resolveClassMethodDecl: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    cid: ztypes.tid
    isgen: bool
    fm: argref
} is {
    if (refuseGenericFnptrField :st :ast :fm) then return
    if (isFunctionDefOp op: (ast.nodes.get i: fm.operation)) then {
        fname: zast.nameTextCopy :ast ref: fm.name
        produces: false
        if isgen.not then {
            produces = true
        } else {
            if (functiondefIsNative op: (ast.nodes.get i: fm.operation)).not then {
                produces = true
            } else {
                # Flipped collection families resolve their native
                # method decls like user template methods; create is
                # special-cased.
                if unitDecl == st.typing.collectionsUnitRoot then {
                    prodSkipL: fm.name == zast.wellKnown.slot.wkCreate
                    if prodSkipL.not then produces = true
                }
            }
        }
        if produces then {
            ownerNmId: nameIdOf :ast name: defName
            mido: (
                resolveMethodFnLazy
                :st
                :scope
                :ast
                :unitDecl
                ownerNameId: ownerNmId
                mname: fname.stringView
                thisName: defName
                opId: fm.operation
                lazyOk: isgen.not
            )
            if mido.some then {
                st.typing.setMemberType parentTypeId: cid nameId: fm.name childTypeId: mido
                if isgen then st.reg.setGeneric typeId: mido value: true
                if (fnFieldFlaggableName nameId: fm.name) then {
                    (
                        st.typing.setChildFnptrField
                        pool: ast.names
                        parentTypeId: cid
                        name: fname.stringView
                    )
                }
            }
        }
    }
}

# refuseNumericParamName -- a field or parameter named like a numeric generic
# parameter of its owner. The owner's `as` and body are one scope, and a read of
# the name through a value would mean two things.
refuseNumericParamName: function {
    st: zenv.ZSymbolTable
    ast: Ast
    ownerTid: ztypes.tid
    dm: argref
} is {
    if (isGenericParam :ast op: (ast.nodes.get i: dm.operation)) then return
    tdecl: st.typing.declIdOfType typeId: ownerTid
    if (st.reg.genericParamConstraintOf :tdecl paramName: dm.name).numKind.has.not then return
    pn: zast.nameTextAt :ast ref: dm.name
    tn: specWrittenName :st :ast tid: ownerTid
    (
        addErrorWithHint
        :st
        nodeid: dm.nid
        lineno: dm.lineno
        colno: dm.colno
        e: zast.err.typeError
        msg: "'\{pn}' is a numeric generic parameter of '\{tn}', so a member cannot have its name"
        note: String
        hint: "rename the member; the parameter is read as `\{pn}`"
        width: pn.length
    )
}

# recordMemberRefField -- record a field declared as a reference to a member
# that already exists: it takes that member's type, and a function-typed one
# becomes a function-pointer slot.
recordMemberRefField: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    cid: ztypes.tid
    fname: StringView
    mref: ztypes.tid
    fm: argref
} is {
    fieldOwn: pathOwnership :ast n: (ast.nodes.get i: fm.operation)
    st.typing.setMemberType parentTypeId: cid nameId: fm.name childTypeId: mref
    if (st.reg.typetypeOf typeId: mref) == ztypes.ztypetype.functionType then {
        st.typing.setChildFnptrField pool: ast.names parentTypeId: cid name: fname
    }
    if fieldOwn.some then {
        (
            st.typing.setChildOwnership
            pool: ast.names
            parentTypeId: cid
            name: fname
            ownership: fieldOwn
        )
    }
    # a sibling-member ref default: the construction fill
    # stamps the default's node with the member's type.
    pdk: stampNodeId n: (ast.nodes.get i: fm.operation)
    pdo: cid
    st.walk.pendingDefault.owner.set key: pdk value: pdo
    fieldNid: stampNodeId n: (ast.nodes.get i: fm.operation)
    pdi: mref
    st.walk.pendingDefault.id.set key: fieldNid value: pdi
}

# rootIsStringLiteral -- a value path whose ROOT is a string literal, unwrapping
# expressions and dotted segments the way rootNameIdOf does. `"hi"`, `"hi".string`
# and an interpolated `"a\{n}"` all answer true; a type name or a numeric literal
# answers false.
rootIsStringLiteral: function {ast: Ast.view n: astnode.view} out bool is {
    match (
        n
    ) case atomstring then {
        return true
    } case dottedpath then {
        return (rootIsStringLiteral :ast n: (ast.nodes.get i: n.parent))
    } else {
        return false
    }
}

# refuseStringDefault -- a field or parameter declared by VALUE carries a
# DEFAULT, and a default is a COMPILE-TIME CONSTANT. A string that folds is
# one -- a StringView of static program memory, emitted as its `_zcsN` -- but
# two string shapes build their value at run time and so are no default: an
# interpolated literal, and an owned copy (`"x".string`, `.copy`), which
# allocates. Each is refused where it is written, rather than reaching the
# fold, whose failure would name neither shape.
refuseStringDefault: function {
    # where the string-literal refusal lands
    st: zenv.ZSymbolTable
    # the tree the declaration is read from
    ast: Ast.view
    # what was declared, for the message: `field` or `parameter`
    what: StringView
    # the declared name's pool id. Read AFTER the shape test, as a view: this
    # runs on every declaration in the tree and reports on almost none, so a
    # copy here would cost an allocation per declaration for a name almost
    # never named.
    nameId: zast.nameid
    # the declaration, whose root is tested
    fm: argref
} out bool is {
    fop: ast.nodes.get i: fm.operation
    if (rootIsStringLiteral :ast n: fop).not then return false
    built: stringBuiltAtRunTime :ast n: fop
    if built.length == 0 then return false
    fname: zast.nameTextAt :ast ref: nameId
    fp: zast.posOf n: fop
    md: "\{what} '\{fname}' is defaulted to \{built}, which is built at run time -- a default must be a compile-time constant"
    hd: "default it to a plain string, which is a StringView; or name the type (`\{fname}: String`) and pass the text in"
    nd: String
    (
        addErrorWithHint
        :st
        nodeid: fm.nid
        lineno: fp.line
        colno: fp.col
        e: zast.err.typeError
        msg: md
        note: nd
        hint: hd
        width: 1
    )
    return true
}

# stringBuiltAtRunTime -- what a string-rooted declaration builds at run time,
# as a diagnostic names it: an interpolated string, or an owned copy of one. ""
# for a string that folds.
stringBuiltAtRunTime: function {ast: Ast.view n: astnode.view} out String is {
    match (
        n
    ) case atomstring then {
        for each pnId: (zast.kidsOf :ast span: n.stringparts) loop {
            pn: ast.nodes.get i: pnId
            if pn.stringchunk.not then return "an interpolated string".string
        }
        return "".string
    } case dottedpath then {
        cId: atomNameId :ast n: (ast.nodes.get i: n.child)
        if (cId == zast.wellKnown.slot.wkString) or (cId == zast.wellKnown.slot.wkCopy) then {
            return "an owned String".string
        }
        return (stringBuiltAtRunTime :ast n: (ast.nodes.get i: n.parent))
    } else {
        return "".string
    }
}

# refuseStringArmPayload -- a variant or union ARM declares the TYPE of what it
# carries, and a string literal is a value, not a type. It named no type and
# left the arm with none, which nothing reported: constructing the arm said
# "expected ?, got StringView", and merely MATCHING on the sum emitted C naming
# an undeclared struct with no diagnostic at all.
#
# Sibling of refuseStringDefault and deliberately worded apart from it: a field
# declared by value carries a DEFAULT, while an arm declares a payload type and
# has no default to carry.
refuseStringArmPayload: function {
    # where the arm's refusal is recorded
    st: zenv.ZSymbolTable
    # the tree the arm's declaration is read from
    ast: Ast.view
    # the arm's declaration, whose root is tested and whose name the message
    # names
    fm: argref
    # the payload type the hint offers: a choice carries text
    payload: "String"
} out bool is {
    aop: ast.nodes.get i: fm.operation
    if (rootIsStringLiteral :ast n: aop).not then return false
    aname: zast.nameTextAt :ast ref: fm.name
    ap: zast.posOf n: aop
    ma: "arm '\{aname}' is declared by a string literal -- an arm declares the TYPE of its payload"
    ha: "name the payload's type (`\{aname}: \{payload}`), or `null` for an arm that carries nothing"
    na: String
    (
        addErrorWithHint
        :st
        nodeid: fm.nid
        lineno: ap.line
        colno: ap.col
        e: zast.err.typeError
        msg: ma
        note: na
        hint: ha
        width: 1
    )
    return true
}

# resolveClassFieldEntry -- resolve a class member that is not a method: a
# reference to an already-declared member, or a field slot of its own. True
# when owning it gives the class a destructor.
resolveClassFieldEntry: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    cid: ztypes.tid
    fm: argref
} out bool is {
    needsDtor: false
    fname: zast.nameTextCopy :ast ref: fm.name
    if (
        refuseStringDefault
        :st
        :ast
        what: "field"
        nameId: fm.name
        :fm
    ) then return false
    refuseSelfNamedMember :st :ast ownerTid: cid :fm
    ftn: fieldHeadNameId :ast n: (ast.nodes.get i: fm.operation)
    # A NON-OWNED field marker (lock / borrow / view) makes the
    # slot static: it is set in the constructor, never reassigned,
    # the constructor locks the caller's argument rather than
    # taking it, and the field holds no destructor. An OWNED one
    # (take / hold) is an ordinary field on all three counts --
    # `hold` freezes the contents, not the slot.
    borrowedField: false
    fieldOwn: pathOwnership :ast n: (ast.nodes.get i: fm.operation)
    if fieldOwn.some then {
        # This test is INVERTED: anything not named here becomes a
        # borrowed field, so a new owned mode must be listed or it is
        # silently treated as non-owned.
        fOwned: (
            (fieldOwn == ztypes.zparamownership.takeMode) or
            (fieldOwn == ztypes.zparamownership.holdMode)
        )
        if fOwned.not then borrowedField = true
    }
    mref: fieldHeadMemberTid :st :ast :unitDecl :defName ownerTid: cid nameId: ftn
    match (
        mref
    ) case some then {
        recordMemberRefField :st :ast :cid fname: fname.stringView :mref :fm
    } case none then {
        if (
            memberaccess.resolveNamedFieldSlot
            :st
            :ast
            :unitDecl
            :scope
            :defName
            :cid
            fname: fname.stringView
            :borrowedField
            :fm
        ) then needsDtor = true
    }
    if borrowedField then refuseValueBorrowField :st :ast :cid nameId: fm.name :fm
    return needsDtor
}

# refuseValueBorrowField -- a `.borrow` field of a VALUE type: the class holds
# its copy, as a binding of one does, so the marker says a borrow that does not
# happen and is refused where the field is declared (refuseValueBorrow's rule).
refuseValueBorrowField: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    cid: ztypes.tid
    nameId: zast.nameid
    fm: argref
} is {
    fop: ast.nodes.get i: fm.operation
    # a `.borrow` WRITTEN on the field; a generator's state is the lowering's
    # own class, whose `#resume_input` borrows the caller's argument whatever
    # its type
    if fop.dottedpath.not or (zast.markerKindOf :ast n: fop).borrowMarker.not then return
    if (moves.definedAsGenerator :st :ast tid: cid) then return
    ft: (
        (st.typing.declChildOfId parentTypeId: cid :nameId).or
        d: ztypes.tid.zero
    )
    if ft.isZero or (st.reg.isValtypeOf tid: ft).not then return
    tn: specWrittenName :st :ast tid: ft
    (
        addErrorWithHint
        :st
        nodeid: fm.operation
        lineno: (nodeLine n: fop)
        colno: (nodeCol n: fop)
        e: zast.err.ownerError
        msg: "'\{tn}' is a value type: the field holds its copy, so `.borrow` has nothing to borrow"
        note: "".string
        hint: "drop the marker; a `.borrow` parameter is what refers to the caller's value".string
        width: 1
    )
}

# resolveClassField -- resolve one field of a class: its declared type, its
# default, its visibility, and whether owning it makes the class need a
# destructor. True when this field does.
resolveClassField: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    cid: ztypes.tid
    isgen: bool
    fmId: zast.nodeid
} out bool is {
    needsDtor: false
    fm: argRefAt :ast nid: fmId
    if fm.nid.notZero then {
        if (isFunctionDefOp op: (ast.nodes.get i: fm.operation)) then {
            resolveClassMethodDecl :st :ast :unitDecl :scope :defName :cid :isgen :fm
        } else {
            if (
                resolveClassFieldEntry
                :st
                :ast
                :unitDecl
                :scope
                :defName
                :cid
                :fm
            ) then needsDtor = true
        }
    }
    return needsDtor
}

# attachGenericAsConstants -- a generic class's `as` constants: a concrete class
# attaches them with its methods, which a template does not.
attachGenericAsConstants: function {
    st: zenv.ZSymbolTable
    ast: Ast
    cid: ztypes.tid
    cnode: objref
} is {
    k: u64
    for k < cnode.nas loop {
        item: argRefAt :ast nid: (zast.objAsItemAt :ast nid: cnode.nid i: k)
        k = k + 1
        if item.nid.isZero or item.operation.isZero then continue
        if (isFunctionDefOp op: (ast.nodes.get i: item.operation)) then continue
        attachAsConstant :st :ast parentId: cid :item
    }
}

# resolveClassAsMethods -- resolve the methods a class declares in its `as`
# block: each signature, and the member entry that makes it reachable from the
# type. Native declarations in a generic collection family resolve like a
# user template's, which is why the walk asks the unit and not the name.
resolveClassAsMethods: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    cid: ztypes.tid
    isgen: bool
    cnode: objref
} is {
    if isgen then attachGenericAsConstants :st :ast :cid :cnode
    itemIdx: u64
    for itemIdx < cnode.nas loop {
        amP4Id: zast.objAsItemAt :ast nid: cnode.nid i: itemIdx
        itemIdx = itemIdx + 1
        item: argRefAt :ast nid: amP4Id
        if item.nid.notZero when (isFunctionDefOp op: (ast.nodes.get i: item.operation)) then {
            itemName: zast.nameTextCopy :ast ref: item.name
            produces: false
            isNative: functiondefIsNative op: (ast.nodes.get i: item.operation)
            if isgen then {
                if isNative then {
                    if unitDecl == st.typing.collectionsUnitRoot then {
                        skipCreate: item.name == zast.wellKnown.slot.wkCreate
                        if skipCreate.not then produces = true
                    }
                } else {
                    produces = true
                }
            }
            if produces then {
                ownerNmId: nameIdOf :ast name: defName
                methodTid: (
                    resolveMethodFn
                    :st
                    :scope
                    :ast
                    :unitDecl
                    ownerNameId: ownerNmId
                    mname: itemName.stringView
                    thisName: defName
                    opId: item.operation
                )
                if methodTid.some then {
                    (
                        st.typing.setMemberType
                        parentTypeId: cid
                        nameId: item.name
                        childTypeId: methodTid
                    )
                    st.reg.setGeneric typeId: methodTid value: true
                }
            }
        }
    }
}

# resolveClassCreate -- give a class its constructor surface: the declared
# `create`, or the synthesised field-wise one when it declares none.
resolveClassCreate: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    cid: ztypes.tid
    isgen: bool
    cnode: objref
} out bool is {
    needsDtor: false
    hasCreate: false
    if isgen.not then {
        hcAs: attachMethods :st :scope :ast :unitDecl :defName parentId: cid objId: cnode.nid
        if hcAs then hasCreate = true
    }
    # a generic template's marker holds for every instance, each checked at the
    # end of typecheck (checkImplementations)
    mNeedsDtor: attachMarkers :st :scope :ast :unitDecl parentId: cid objId: cnode.nid
    if mNeedsDtor then needsDtor = true
    if hasCreate.not when isgen.not then {
        createId: (
            st.reg.newType
            name: "create"
            ownerTid: cid
            typetype: ztypes.ztypetype.functionType
        )
        (
            st.typing.declSynthMemberTyped
            parentTypeId: cid
            nameId: zast.wellKnown.slot.wkCreate
            kind: ztyping.declkind.methodDecl
            childTypeId: createId
        )
        conform.materializeCreateParams :st :ast typeTid: cid :createId
    }
    return needsDtor
}

# resolveClassTypedefBase -- record the base a typedef class wraps: its name id
# and its type, and whether the wrapper inherits the base's destructor. True
# when it does.
resolveClassTypedefBase: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    cid: ztypes.tid
    cnode: objref
} out bool is {
    needsDtor: false
    checkTypedefShape :st :ast onode: cnode
    tdbase: objectTypedefBaseId :ast onode: cnode
    baseTid: objectTypedefBaseTid :st :scope :ast :unitDecl ownerTid: cid onode: cnode
    # the base the typedef resolved to answers for itself -- one reached through
    # its unit (`(pr.GBox t: i64)`) included
    if (refuseTypedefOfItself :st own: cid base: baseTid onode: cnode) then return false
    if (memberaccess.fieldTypeNeedsCleanup :st tid: baseTid isBorrowed: false) then needsDtor = true
    if tdbase.notZero or baseTid.notZero then {
        st.typing.setTypedefBase tid: cid base: (ztyping.typedefbase name: tdbase tid: baseTid)
    }
    return needsDtor
}

# refuseTypedefOfItself -- a typedef whose base is the typedef, directly or
# through other typedefs (`tag: typedef tag`): there is no type at the end of
# the chain, and every walk down it would never finish. Refused, and the base
# is not recorded. True when it refused.
refuseTypedefOfItself: function {
    st: zenv.ZSymbolTable
    own: ztypes.tid
    base: ztypes.tid
    onode: objref
} out bool is {
    t: base
    steps: u64
    for t.notZero while t != own while steps < 64 loop {
        t = st.typing.typedefBaseTidOf tid: t
        steps = steps + 1
    }
    if t != own then return false
    (
        addError
        :st
        nodeid: onode.nid
        lineno: onode.lineno
        colno: 1
        e: zast.err.typeError
        msg: "'\{st.reg.nameOf tid: own}' is a typedef of itself: a typedef wraps another type"
    )
    return true
}

# finishClassDef -- the class walk's tail: the as-block methods, the create
# path (which may require a destructor), the destructor flag, and the privacy
# exclusions and grants.
finishClassDef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    cid: ztypes.tid
    ccid: ztypes.tid
    isgen: bool
    cnode: objref
    needsDtorIn: bool
    pvExcl: (ListVal zast.nameid).view
    pvGrants: (ListVal zast.nameid).view
} is {
    needsDtor: needsDtorIn
    resolveClassAsMethods :st :ast :unitDecl :scope :defName :cid :isgen :cnode
    cobj: ast.nodes.get i: cnode.nid
    if cobj.objectdef when (
        asBindingOf
        :st
        :ast
        ownerDecl: (st.typing.declIdOfType typeId: cid)
        asItems: cobj.asItems
        nameId: zast.wellKnown.slot.wkCreate
    ).struck then {
        st.walk.createOptOut.add item: cid
    }
    if (
        resolveClassCreate
        :st
        :ast
        :unitDecl
        :scope
        :defName
        :cid
        :isgen
        :cnode
    ) then needsDtor = true
    if needsDtor then {
        st.reg.setNeedsDestructor typeId: cid
    }
    if pvExcl.length > 0 then st.walk.privacySeen = true
    applyGrantsPrivate :st parentId: ccid grants: pvGrants
}

# resolveClass -- resolve a class ObjectDef into a CLASS reference type: a child per
# field (field name -> type-ref shell), a child per as-block method, then a synthesized
# `create` child (LAST). Classes are reference types (is_valtype false); they get
# `create` but NO `==`/`!=` (unlike records). A class keeps a destructor when any field
# owns heap data (fieldTypeNeedsCleanup), else none. A typedef over a reftype
# (`Path: typedef String`) gets no field child, synth `create`+`borrow`, and inherits
# needs_destructor from the wrapped base (List -> yes, ListView -> no). Custom /
# `null` create, generics + protocols come later.
resolveClass: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    # the class's name, interned
    nameId: zast.nameid
    cnode: objref
} is {
    cid: (
        declareCanonicalType
        :st
        :scope
        :ast
        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.classType
    )
    ccid: cid
    # `class is native` on the TYPE: the runtime supplies the layout and every
    # method, so routing can ask the declaration whether a type is
    # runtime-backed instead of comparing its unit's name. Mirrors
    # resolveFunction, which has always written the function-path flag.
    st.reg.setNative typeId: cid value: cnode.isNative
    pvExcl_ccid: ListVal zast.nameid
    pvGrants_ccid: ListVal zast.nameid
    scanVisibility :st :ast onode: cnode excl: pvExcl_ccid grants: pvGrants_ccid
    st.reg.setValtype typeId: cid value: false
    # the system's String owns its bytes, whatever its native layout declares
    needsDtor: (unitDecl == st.typing.systemUnitRoot) and (nameId == zast.wellKnown.slot.tyString)
    isgen: false
    onIsgen: ast.nodes.get i: cnode.nid
    if onIsgen.objectdef then {
        isgen = zast.itemsHaveGenericParam :ast items: onIsgen.asItems
    }
    unitTmplC: nestedTemplateUnit :st :ast :scope :unitDecl nameId: (nameIdOf :ast name: defName)
    if unitTmplC.notZero then isgen = true
    if isgen then {
        st.reg.setGeneric typeId: cid value: true
        typeDecl: declOfUnitDef :st :scope :unitDecl nameId: (nameIdOf :ast name: defName)
        {
            onRg: ast.nodes.get i: cnode.nid
            if onRg.objectdef then {
                registerGenericParams :st :ast tdecl: typeDecl items: onRg.asItems
            }
        }
        if unitTmplC.notZero then (
            registerUnitParamsOn
            :st
            :ast
            tdecl: typeDecl
            unitTmpl: unitTmplC
        )
    }
    istd: recordIsTypedef rnode: cnode
    if istd when (resolveClassTypedefBase :st :ast :unitDecl :scope :cid :cnode
    ) then needsDtor = true
    # a `typedef` declarator's one is-item is its base, not a field: its inner
    # refs (the u8 in `(ListVal u8)`) still stamp
    kFiter: u64
    if cnode.kind == zast.objectkind.typedefDef then {
        kFiter = cnode.nis
        (
            typeref.recordTyperef
            :st
            :scope
            :ast
            :unitDecl
            thisName: ""
            nid: (objectTypedefBaseNode :ast onode: cnode)
        )
    }
    for kFiter < cnode.nis loop {
        fmId: zast.objIsItemAt :ast nid: cnode.nid i: kFiter
        kFiter = kFiter + 1
        if (resolveClassField :st :ast :unitDecl :scope :defName :cid :isgen :fmId) then {
            needsDtor = true
        }
    }
    # Flipped iterator families: their only method decl (`call`) lives in
    # the as-block; produce it like the isItems loop does. attachMethods
    # stays non-generic-only (it also handles const-clone members and
    # generator synthesis, which native decls never need).
    (
        finishClassDef
        :st
        :ast
        :unitDecl
        :scope
        :defName
        :cid
        :ccid
        :isgen
        :cnode
        needsDtorIn: needsDtor
        pvExcl: pvExcl_ccid
        pvGrants: pvGrants_ccid
    )
}

# markInstanceSpecMethod -- every method of a generic interface is its
# instances' own: each instance clones it with the parameters substituted, in
# its parameters as in its return (a return typed by one already marks it;
# `fits: function {t: this.view limit: n}` returns none).
markInstanceSpecMethod: function {st: zenv.ZSymbolTable fnId: ztypes.tid} is {
    st.reg.setGeneric typeId: fnId value: true
}

# registerInterfaceGenerics -- a protocol's or a facet's generic parameters,
# declared in its `as` block as every type's are, registered so
# isGenericParamOf answers for a spec member typed by one rather than resolving
# it as an ordinary name; one written in the body, which holds only the specs,
# is refused. True, with the type marked generic, when it declares any.
registerInterfaceGenerics: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    tid: ztypes.tid
    fnode: objref
} out bool is {
    tdecl: declOfUnitDef :st :scope :unitDecl nameId: (nameIdOf :ast name: defName)
    od: ast.nodes.get i: fnode.nid
    if od.objectdef.not then return false
    k: u64
    for k < fnode.nis loop {
        itemId: zast.objIsItemAt :ast nid: fnode.nid i: k
        k = k + 1
        item: argRefAt :ast nid: itemId
        if item.nid.notZero when (zast.isGenericParamOp :ast opId: item.operation) then {
            refuseInterfaceBodyParam :st :ast parentId: tid :item
        }
    }
    if (zast.itemsHaveGenericParam :ast items: od.asItems).not then return false
    st.reg.setGeneric typeId: tid value: true
    registerGenericParams :st :ast :tdecl items: od.asItems
    return true
}

# resolveFacet -- resolve a facet ObjectDef into a FACET valtype: a child per
# is-block spec method (the `:this` receiver dropped), then synthesized `create` +
# `borrow` FUNCTION shells (JOIN-only, no own row). Facets are value types
# (is_valtype true), no destructor, no `==`/`!=`. Generic facets arrive later.
resolveFacet: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    fnode: objref
} is {
    fid: (
        declareCanonicalType
        :st
        :scope
        :ast
        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.facetType
    )
    ffid: fid
    pvExcl_ffid: ListVal zast.nameid
    pvGrants_ffid: ListVal zast.nameid
    scanVisibility :st :ast onode: fnode excl: pvExcl_ffid grants: pvGrants_ffid
    st.reg.setValtype typeId: fid value: true
    attachInterfaceAsConstants :st :ast parentId: fid :fnode
    isgen: registerInterfaceGenerics :st :ast :unitDecl :scope :defName tid: fid :fnode
    # `type` INSIDE AN INTERFACE IS THE INTERFACE. Reading it as the first
    # recorded CONFORMER makes a spec member's parameter concrete: the vtable
    # slot comes out typed `bool (*op_eq)(void*, pt)` and there is no uniform
    # signature to emit at all once a second type implements. Which
    # implementer won depended on which one the unit's `main` happened to
    # mention first, so the layout of an interface depended on source order.
    #
    # A member that mentions it is not part of the dispatchable surface -- the
    # emitters omit its slot and the checker refuses the call -- but that is a
    # decision about the MEMBER, taken where the member is used, rather than a
    # rewriting of what its type means.
    specThisStr: defName.string
    dropThis: true
    kSiter: u64
    for kSiter < fnode.nis loop {
        smId: zast.objIsItemAt :ast nid: fnode.nid i: kSiter
        kSiter = kSiter + 1
        sm: argRefAt :ast nid: smId
        if sm.nid.notZero then {
            refuseSpecWithoutReceiver :st :ast :sm :defName kind: "facet"
            mname: zast.nameTextCopy :ast ref: sm.name
            ownerNmId: nameIdOf :ast name: defName
            sido: (
                resolveMethodFn
                :st
                :scope
                :ast
                :unitDecl
                ownerNameId: ownerNmId
                mname: mname.stringView
                thisName: specThisStr.stringView
                opId: sm.operation
                skipThis: dropThis
            )
            if sido.some then {
                st.typing.setMemberType parentTypeId: fid nameId: sm.name childTypeId: sido
                if isgen then markInstanceSpecMethod :st fnId: sido
            }
        }
    }
    if isgen.not then {
        createId: (
            st.reg.newType
            name: "create"
            ownerTid: fid
            typetype: ztypes.ztypetype.functionType
        )
        (
            st.typing.declSynthMemberTyped
            parentTypeId: fid
            nameId: zast.wellKnown.slot.wkCreate
            kind: ztyping.declkind.methodDecl
            childTypeId: createId
        )
    }
    if pvExcl_ffid.length > 0 then st.walk.privacySeen = true
    applyGrantsPrivate :st parentId: ffid grants: pvGrants_ffid
}

# refuseSpecWithoutReceiver -- a spec `sm` of an interface (`kind` says which:
# a protocol or a facet) that declares no `this` parameter is refused: a value
# of the interface calls each spec on the value it holds, through its vtable,
# and a function with no receiver has nothing to be called on there. It
# belongs in the implementing type's namespace, as a constructor does.
refuseSpecWithoutReceiver: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    sm: argref
    defName: StringView
    kind: StringView
} is {
    if (ast.nodes.get i: sm.operation).functiondef.not then return
    if (memberaccess.functionNamesReceiver :ast fnId: sm.operation) then return
    mname: zast.nameTextCopy :ast ref: sm.name
    n: ast.nodes.get i: sm.nid
    (
        addErrorWithHint
        :st
        nodeid: sm.nid
        lineno: (nodeLine :n)
        colno: (nodeCol :n)
        e: zast.err.typeError
        msg: "'\{mname}' in \{kind} '\{defName}' takes no receiver: a \{kind} value calls each spec on the value it holds"
        note: "".string
        hint: "give it a receiver (`t: this.view`), or declare it on each implementing type".string
        width: mname.length
    )
}

# resolveProtocol -- resolve a protocol ObjectDef into a PROTOCOL reftype: a child
# per is-block spec method (the `:this` receiver dropped), then synth `create` +
# `borrow` FUNCTION shells, then an unconditional destructor (a protocol wraps heap
# data). Reference type (is_valtype false), no `==`/`!=`. A generic protocol
# registers its parameters -- they sit in the IS block, not an `as` block -- so a
# spec member typed by one resolves as the parameter.
resolveProtocol: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    defName: StringView
    # the protocol's name, interned
    nameId: zast.nameid
    fnode: objref
} is {
    pid: (
        declareCanonicalType
        :st
        :scope
        :ast
        :unitDecl
        ownerNameId: zast.nameid
        name: defName
        typetype: ztypes.ztypetype.protocolType
    )
    ppid: pid
    pvExcl_ppid: ListVal zast.nameid
    pvGrants_ppid: ListVal zast.nameid
    scanVisibility :st :ast onode: fnode excl: pvExcl_ppid grants: pvGrants_ppid
    st.reg.setValtype typeId: pid value: false
    attachInterfaceAsConstants :st :ast parentId: pid :fnode
    isgen: registerInterfaceGenerics :st :ast :unitDecl :scope :defName tid: pid :fnode
    # A protocol spec receiver is normally dropped (resolves to nothing). The reference
    # resolves StringViewable NESTED inside String's `:StringViewable` marker, so its
    # spec `:this` binds to the enclosing String -- mirror that for the system protocol.
    specThisStr: defName.string
    dropThis: true
    if unitDecl == st.typing.systemUnitRoot when (
        nameId == zast.wellKnown.slot.tyStringViewable
    ) then {
        specThisStr = "String".string
        dropThis = false
    }
    # `type` inside a protocol is the protocol, for the reason resolveFacet
    # states at length. `StringViewable` keeps its exception: it is the one interface the
    # system unit declares whose spec receiver IS a concrete type.
    kSiter: u64
    for kSiter < fnode.nis loop {
        smId: zast.objIsItemAt :ast nid: fnode.nid i: kSiter
        kSiter = kSiter + 1
        sm: argRefAt :ast nid: smId
        if sm.nid.notZero then {
            refuseSpecWithoutReceiver :st :ast :sm :defName kind: "protocol"
            mname: zast.nameTextCopy :ast ref: sm.name
            ownerNmId: nameIdOf :ast name: defName
            sido: (
                resolveMethodFn
                :st
                :scope
                :ast
                :unitDecl
                ownerNameId: ownerNmId
                mname: mname.stringView
                thisName: specThisStr.stringView
                opId: sm.operation
                skipThis: dropThis
            )
            if sido.some then {
                st.typing.setMemberType parentTypeId: pid nameId: sm.name childTypeId: sido
                if isgen then markInstanceSpecMethod :st fnId: sido
            }
        }
    }
    if isgen.not then {
        createId: (
            st.reg.newType
            name: "create"
            ownerTid: pid
            typetype: ztypes.ztypetype.functionType
        )
        (
            st.typing.declSynthMemberTyped
            parentTypeId: pid
            nameId: zast.wellKnown.slot.wkCreate
            kind: ztyping.declkind.methodDecl
            childTypeId: createId
        )
    }
    # a protocol's own markers (`:Crossing`) hold for every value of it
    attachMarkers :st :scope :ast :unitDecl parentId: pid objId: fnode.nid
    st.reg.setNeedsDestructor typeId: pid
    if pvExcl_ppid.length > 0 then st.walk.privacySeen = true
    applyGrantsPrivate :st parentId: ppid grants: pvGrants_ppid
}

# registerEmptyType -- register a native bottom type (null -> NULL, never -> NEVER) as a
# valtype with a single synth `create` child: they are `record is native` in source but
# carry a distinct typetype and only a create child.
registerEmptyType: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    scope: ztypes.declid
    name: StringView
    tt: ztypes.ztypetype
} out ztypes.tid is {
    ex0: resolve.resolvedByIds :st :ast :unitDecl name: (zast.poolFind pool: ast.names text: name)
    if ex0.some then {
        st.reg.setValtype typeId: ex0 value: true
        emptyTid: (
            st.reg.newType
            name: "create"
            ownerTid: ex0
            typetype: ztypes.ztypetype.functionType
        )
        (
            st.typing.declSynthMemberTyped
            parentTypeId: ex0
            nameId: zast.wellKnown.slot.wkCreate
            kind: ztyping.declkind.methodDecl
            childTypeId: emptyTid
        )
        return ex0
    }
    nid: st.reg.newType :name typetype: tt
    st.reg.setValtype typeId: nid value: true
    ccid: st.reg.newType name: "create" ownerTid: nid typetype: ztypes.ztypetype.functionType
    (
        st.typing.declSynthMemberTyped
        parentTypeId: nid
        nameId: zast.wellKnown.slot.wkCreate
        kind: ztyping.declkind.methodDecl
        childTypeId: ccid
    )
    linkDeclType :st :scope :ast :unitDecl :name tid: nid
    return nid
}

# refuseEmptyObjectDef -- AN EMPTY OBJECT DEFINITION IS AN ERROR. With no
# fields and no members there is nothing to hold and nothing to call: the
# emitter writes no struct for one (an empty struct is not C), so every use of
# it as a value produced C the compiler rejected while zc exited 0.
#
# A record or a class holds its data in fields, so members alone do not make
# one: with none it has no layout, members or generic parameters or not. The
# other kinds -- a generator, a union or variant (arms), a protocol, facet or
# unit (members) -- declare what they are through their `as` block. A protocol
# with no specs at all is a MARKER: a type implements say something about
# itself (`thread.ThreadBound`), and nothing is ever called through it.
#
# `is native` is the exception, and the only one: the runtime owns those
# layouts, and the markers the compiler declares this way -- `null`, `never`,
# `anyval`, `AnyRef`, `Box` -- are deliberately empty. `null` and `never` parse as
# empty records, which is why the marker and not the shape has to be the test.
refuseEmptyObjectDef: function {
    st: zenv.ZSymbolTable
    defName: StringView
    defn: objref
} is {
    if defn.nis > 0 then return
    if defn.isNative then return
    if defn.kind == zast.objectkind.protocolDef then return
    holdsData: (
        (defn.kind == zast.objectkind.recordDef) or
        (defn.kind == zast.objectkind.classDef) or
        (defn.kind == zast.objectkind.dataDef)
    )
    if defn.nas > 0 when holdsData.not then return
    msg: "'\{defName}' is an empty object definition — it declares no fields and no members"
    hint: "give it a field, give it a member, or mark it `is native` when the runtime owns its layout".string
    if defn.nas > 0 then {
        msg = "'\{defName}' declares no fields — a record, class or data type holds its data in fields"
        hint = "give it a field, or mark it `is native` when the runtime owns its layout".string
    }
    # a data type cannot be native (refuseDataShape)
    if defn.kind == zast.objectkind.dataDef then hint = "give it a field".string
    note: String
    (
        addErrorWithHint
        :st
        nodeid: defn.nid
        lineno: defn.lineno
        colno: defn.colno
        e: zast.err.typeError
        :msg
        :note
        :hint
        width: defName.length
    )
}

# resolveObjectDef -- a record / class / generator / union / variant / facet /
# protocol / unit definition, routed to its family's resolver. A generic one
# resolves its constraint bounds first: a bound names a type the body then
# relies on. A generator routes to the CLASS resolver: its `is` fields are class
# fields and go through resolveClassFieldEntry, which is the whole point of the
# form -- per-field ownership comes out right because it is declared, not
# inferred.
resolveObjectDef: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    rf: ztypes.declid
    defName: StringView
    # the definition's name, interned
    nameId: zast.nameid
    defn: objref
} is {
    # a refused definition still resolves, as the fieldless type it was
    # written as: the error is its report, and a use of it -- through its
    # unit too (`kit.Mark`) -- reads the type rather than a missing member
    refuseEmptyObjectDef :st :defName :defn
    match (
        defn.kind
    ) case recordDef then {
        # the empty types are the system unit's own declarations; a record
        # another unit names `null` or `never` is an ordinary record
        isSys: unitDecl == st.typing.systemUnitRoot
        if isSys when nameId == zast.wellKnown.slot.tyNull then {
            (
                registerEmptyType
                :st
                scope: rf
                :ast
                :unitDecl
                name: "null"
                tt: ztypes.ztypetype.nullType
            )
        } else {
            if isSys when nameId == zast.wellKnown.slot.tyNever then {
                nvid: (
                    registerEmptyType
                    :st
                    scope: rf
                    :ast
                    :unitDecl
                    name: "never"
                    tt: ztypes.ztypetype.neverType
                )
                ztyping.nodeTypeSet tbl: st.typing.nodeType nid: defn.nid tid: nvid
            } else {
                resolveRecord :st scope: rf :ast :unitDecl :defName rnode: defn
            }
        }
    } case dataDef then {
        resolveRecord :st scope: rf :ast :unitDecl :defName rnode: defn
    } case variantDef then {
        resolveVariant :st scope: rf :ast :unitDecl :defName vnode: defn
    } case choiceDef then {
        resolveVariant :st scope: rf :ast :unitDecl :defName vnode: defn
    } case unionDef then {
        resolveUnion :st scope: rf :ast :unitDecl :defName vnode: defn
    } case classDef then {
        resolveClass :st scope: rf :ast :unitDecl :defName :nameId cnode: defn
    } case generatorDef then {
        resolveClass :st scope: rf :ast :unitDecl :defName :nameId cnode: defn
    } case typedefDef then {
        if (resolve.typedefDefIsReftype :st :ast :unitDecl :defName) then {
            resolveClass :st scope: rf :ast :unitDecl :defName :nameId cnode: defn
        } else {
            resolveRecord :st scope: rf :ast :unitDecl :defName rnode: defn
        }
    } case facetDef then {
        resolveFacet :st scope: rf :ast :unitDecl :defName fnode: defn
    } case protocolDef then {
        resolveProtocol :st scope: rf :ast :unitDecl :defName :nameId fnode: defn
    } else null
    objrid: (
        resolve.resolvedByIds
        :st
        :ast
        :unitDecl
        name: (zast.poolFind pool: ast.names text: defName)
    )
    if objrid.some then {
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: defn.nid tid: objrid
    }
}

# registerUnitGenericParams -- a generic FILE unit's own parameters: registered
# against its root Decl, each with a canonical per-(unit, param) GENERIC_PARAM
# tid the definition's value node carries, so template signatures and bodies
# stamp it. Run for EVERY unit, not only an eagerly-resolved one: it is a
# property of the declaration, and a unit that is resolved on demand has the
# same parameters as one that is not.
registerUnitGenericParams: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    unitDecl: ztypes.declid
    scope: ztypes.declid
    unitdefId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitdefId
    if (zast.unitIsGeneric :ast unitId: unitdefId) then {
        unitRootDecl: ztypes.declid
        unitRoot: unitDecl
        if unitRoot.notZero then unitRootDecl = unitRoot
        registerGenericParams :st :ast tdecl: unitRootDecl items: bodyIds
        # Each generic-param name gets a canonical per-(unit,param)
        # GENERIC_PARAM tid (get-or-mint), attributed to the unit; the
        # param definition's value node carries it so template signatures
        # and bodies stamp it.
        for each gmId: (zast.kidsOf :ast span: bodyIds) loop {
            gm: ast.nodes.get i: gmId
            if gm.namedoperation when (
                isBareGenericParam
                :ast
                op: (ast.nodes.get i: gm.operation)
            ) then {
                paramName: zast.nameTextAt :ast ref: gm.name
                paramTid: (
                    ztypes.tid.create
                    from: (genericParamTidMint :st :ast tdecl: unitRootDecl nameId: gm.name)
                )
                linkDeclType :st :scope :ast :unitDecl name: paramName.stringView tid: paramTid
                gpnid: stampNodeId n: (ast.nodes.get i: gm.operation)
                ztyping.nodeTypeSet tbl: st.typing.nodeType nid: gpnid tid: paramTid
            }
        }
    }
}

# attachMonoUnitFuncs -- add a JOIN-only FUNCTION shell child per function
# in the template unit's body. The mono function rows are defined_in_unit=NULL (excluded
# from the filtered dump), so no params are resolved -- only the names matter for the JOIN.
attachMonoUnitFuncs: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    monoId: ztypes.tid
    templateOpId: zast.nodeid
} is {
    bodyIds: zast.unitBodyIdsAt :ast unitId: templateOpId
    {
        for each fm: (zast.kidsOf :ast span: bodyIds) loop {
            fmNode: ast.nodes.get i: fm
            if fmNode.namedoperation when (
                isFunctionDefOp
                op: (ast.nodes.get i: fmNode.operation)
            ) then {
                fn: zast.nameTextAt :ast ref: fmNode.name
                shellId: (
                    st.reg.newType
                    name: fn.stringView
                    ownerTid: monoId
                    typetype: ztypes.ztypetype.functionType
                )
                (
                    st.typing.declSynthMember
                    parentTypeId: monoId
                    nameId: fmNode.name
                    kind: ztyping.declkind.methodDecl
                )
                (
                    st.typing.setMemberType
                    parentTypeId: monoId
                    nameId: fmNode.name
                    childTypeId: shellId
                )
            }
        }
    }
}

# resolveInlineGenericUnit -- resolve an inline generic unit (mathops: unit { t:
# anyval.generic; add; double }) into a UNIT type (is_generic) whose functions are mangled
# {unit}_{fn} FUNCTION children (with their generic-param types KEPT -- unlike a generic
# FILE unit, an inline template's params are not suppressed).
resolveInlineGenericUnit: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    defName: StringView
    parentTid: ztypes.tid
    parentDeclId: ztypes.declid
    unitOpId: zast.nodeid
} is {
    # a template's members resolve in the template's own scope
    rf: st.typing.declFindChild :parentDeclId nameId: (zast.poolFind pool: ast.names text: defName)
    if rf.isZero then rf = parentDeclId
    bodyIds: zast.unitBodyIdsAt :ast unitId: unitOpId
    # this template's own Decl, under the parent the CALLER names: the unit
    # root for a top-level template, the namespace's Decl for a nested one.
    # A (unit, name) walk reaches only the first.
    defNameId: zast.poolFind pool: ast.names text: defName
    templateDecl: st.typing.declFindChild :parentDeclId nameId: defNameId
    # st.reg.newType has no dedup and a template can be demanded again after it
    # resolved, so a second visit must mint nothing at all. resolveNamespaceUnit
    # carries the equivalent node-stamp guard. The Decl below records
    # the id this minted, so it is the durable "already done" mark.
    if (st.typing.declTypeOf declId: templateDecl).notZero then return
    {
        uid: st.reg.newType name: defName typetype: ztypes.ztypetype.unitType
        did: uid
        rid: uid
        if (zast.unitIsGeneric :ast unitId: unitOpId) then {
            st.reg.setGeneric typeId: uid value: true
            registerGenericParams :st :ast tdecl: templateDecl items: bodyIds
            # written in a generic unit, it is generic over that unit's
            # parameters too, after its own: each instance of the unit has its own
            # instances of it
            if (instantiate.declIsUnitTemplate :st :ast declId: parentDeclId) then (
                registerUnitParamsOn
                :st
                :ast
                tdecl: templateDecl
                unitTmpl: parentDeclId
            )
            # the unit node and each bare generic-param def stamp, and the
            # param name resolves so signature t-refs stamp. Unconditional --
            # createUnitMono falls back to this def-node stamp to find a template
            # with no childOf edge, so laying it is a property of resolving the
            # template, not of which walk got here.
            udnid: resolve.unitdefNodeId :ast nId: unitOpId
            ztyping.nodeTypeSet tbl: st.typing.nodeType nid: udnid tid: uid
            for each gmId: (zast.kidsOf :ast span: bodyIds) loop {
                gm: argRefAt :ast nid: gmId
                if gm.nid.notZero when (
                    isBareGenericParam
                    :ast
                    op: (ast.nodes.get i: gm.operation)
                ) then {
                    paramTid: genericParamTidMint :st :ast tdecl: templateDecl nameId: gm.name
                    gpnid: stampNodeId n: (ast.nodes.get i: gm.operation)
                    ztyping.nodeTypeSet tbl: st.typing.nodeType nid: gpnid tid: paramTid
                    # the parameter's own declaration carries the
                    # GENERIC_PARAM id, as a generic file unit's does: the
                    # template's rf answers `t` with the parameter, not
                    # with the constraint its definition names
                    paramDecl: st.typing.declFindChild parentDeclId: templateDecl nameId: gm.name
                    if paramDecl.notZero then {
                        st.typing.declSetType declId: paramDecl typeId: paramTid
                    }
                }
            }
        }
        if templateDecl.notZero then {
            st.typing.declSetType declId: templateDecl typeId: did
        }
        # A non-generic inline unit is a real type; lay its unit->def childOf edge
        # (a generic template must NOT get one -- its id is the pre-instantiation
        # template, which would shadow instance lookups).
        if (zast.unitIsGeneric :ast unitId: unitOpId).not when parentTid.notZero then {
            st.typing.setMemberType parentTypeId: parentTid nameId: defNameId childTypeId: rid
        }
        j: u64
        for j < bodyIds.count loop {
            bm: zast.kidAt kids: ast.kids span: bodyIds i: j
            j = j + 1
            bmNode: argRefAt :ast nid: bm
            if bmNode.nid.notZero then {
                fn: zast.nameTextCopy :ast ref: bmNode.name
                ownerNmId: nameIdOf :ast name: defName
                mido: (
                    resolveMethodFn
                    :st
                    scope: rf
                    :ast
                    :unitDecl
                    ownerNameId: ownerNmId
                    mname: fn.stringView
                    thisName: ""
                    opId: bmNode.operation
                )
                match (
                    mido
                ) case some then {
                    (
                        declLinkTemplateMethod
                        :st
                        tmplDeclId: templateDecl
                        memberNameId: bmNode.name
                        fnTid: mido
                    )
                    (
                        st.typing.setMemberType
                        parentTypeId: uid
                        nameId: bmNode.name
                        childTypeId: mido
                    )
                } case none then {
                    # a type the unit declares is a template over its parameters
                    resolveUnitNestedType :st :ast :unitDecl scope: rf :bmNode
                }
            }
        }
    }
}

# resolveUnitNestedType -- a type definition in a generic unit's body resolves
# once, in the unit's scope, as a template over the unit's parameters.
resolveUnitNestedType: function {
    st: zenv.ZSymbolTable
    ast: Ast
    unitDecl: ztypes.declid
    scope: ztypes.declid
    bmNode: argref
} is {
    isObj: false
    op: ast.nodes.get i: bmNode.operation
    isObj = op.objectdef
    if isObj.not then return
    td: st.typing.declFindChild parentDeclId: scope nameId: bmNode.name
    if td.isZero then return
    if (st.typing.declIsResolved declId: td) then return
    tn: zast.nameTextCopy :ast ref: bmNode.name
    resolve.resolveDef :st :scope :ast :unitDecl defName: tn.stringView defnId: bmNode.operation
    st.typing.declSetResolved declId: td
}

# registerMonoFnParams -- register a mono unit fn's generic-param-typed params
# (a: t -> a: argId) on the mono FUNCTION type, sourced from the template fn's
# AST. The template fn stays childless -- only the instance carries substituted
# param children.
registerMonoFnParams: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    op: astnode.view
    fnId: ztypes.tid
    subs: (IdMapV zast.nameid v: ztypes.tid).view
} is {
    if op.functiondef then {
        for each ppmId: (zast.kidsOf :ast span: op.parameters) loop {
            ppm: ast.nodes.get i: ppmId
            if ppm.namedoperation then {
                pptn: atomNameId :ast n: (ast.nodes.get i: ppm.operation)
                # the function's own generic parameter is nearer than the unit's
                if (fnDeclaresGeneric :ast op: (ast.nodes.get i: op.nodeid) nameId: pptn
                ) then continue
                ppgo: subs.get key: pptn
                if ppgo.some then {
                    st.typing.setMemberType parentTypeId: fnId nameId: ppm.name childTypeId: ppgo
                }
            }
        }
    }
}

# fnDeclaresGeneric -- the function definition `op` declares `nameId` as its own
# generic parameter (`as { t: anyval.generic }`).
fnDeclaresGeneric: function {ast: Ast.view op: astnode.view nameId: zast.nameid} out bool is {
    if nameId.isZero then return false
    match (
        op
    ) case functiondef then {
        k: u64
        for k < op.asItems.count loop {
            gi: argRefAt :ast nid: (zast.kidAt kids: ast.kids span: op.asItems i: k)
            k = k + 1
            if gi.name == nameId when (isGenericParam :ast op: (ast.nodes.get i: gi.operation)
            ) then {
                return true
            }
        }
        return false
    } else {
        return false
    }
}

# buildUnitMonoMember -- substitute one member of a generic unit's body into the
# monomorphised instance: its own generic parameters bound to the instantiation's
# arguments, its type resolved in the TEMPLATE's scope (lexical scoping -- the
# instantiating unit is not where the template's names live).
buildUnitMonoMember: function {
    st: zenv.ZSymbolTable
    ast: Ast
    rf: ztypes.declid
    tmplUnitName: ztypes.declid
    tmplNameId: zast.nameid
    monoId: ztypes.tid
    tplId: ztypes.tid
    fmNode: argref
    subs: (IdMapV zast.nameid v: ztypes.tid).view
} is {
    if (isFunctionDefOp op: (ast.nodes.get i: fmNode.operation)) then {
        fn: zast.nameTextCopy :ast ref: fmNode.name
        srcId: ztypes.tid
        tfo: st.typing.declChildOfId parentTypeId: tplId nameId: fmNode.name
        match (
            tfo
        ) case some then {
            srcId = tfo
        } case none then {
            mo0: (
                resolveMethodFn
                :st
                scope: rf
                :ast
                unitDecl: tmplUnitName
                ownerNameId: tmplNameId
                mname: fn.stringView
                thisName: ""
                opId: fmNode.operation
            )
            {
                mo0v: mo0.or d: ztypes.tid.zero
                templateDecl: declOfUnitDef :st scope: rf unitDecl: tmplUnitName nameId: tmplNameId
                (
                    declLinkTemplateMethod
                    :st
                    tmplDeclId: templateDecl
                    memberNameId: fmNode.name
                    fnTid: mo0v
                )
            }
            if mo0.some then {
                srcId = mo0
                st.typing.setMemberType parentTypeId: tplId nameId: fmNode.name childTypeId: mo0
            }
        }
        newFnId: (
            st.reg.newType
            name: fn.stringView
            ownerTid: monoId
            typetype: ztypes.ztypetype.functionType
        )
        # declare and edge the method before filling its parameters:
        # edging claims the method's own function type for its
        # declaration, which is what the parameter writes below --
        # here and in registerMonoFnParams -- reach through
        (
            st.typing.declSynthMember
            parentTypeId: monoId
            nameId: fmNode.name
            kind: ztyping.declkind.methodDecl
        )
        st.typing.setMemberType parentTypeId: monoId nameId: fmNode.name childTypeId: newFnId
        instantiate.recordUnitMemberCopy :st :monoId :tplId nameId: fmNode.name copy: newFnId
        if srcId.notZero then {
            (
                statics.fillMonoMethodSignature
                :st
                :ast
                :rf
                :tmplUnitName
                :fmNode
                :srcId
                :newFnId
                :subs
                :monoId
                :tplId
            )
            instantiate.copyReturnMarkers :st fromFn: srcId toFn: newFnId
        }
        registerMonoFnParams :st :ast op: (ast.nodes.get i: fmNode.operation) fnId: newFnId :subs
        if srcId.notZero then keepMonoFnGeneric :st :srcId :newFnId
    }
}

# keepMonoFnGeneric -- a unit function with type parameters of its own stays a
# template on the unit's instance, as a generic method does on a type's
# instance (cloneGenericMemberInto): its calls mint instances of the instance's
# copy, over the parameters the template function declares. The copy's
# declaration is the template function's, through which its instances bind
# their arguments, and so is its written return, which each call substitutes.
# A copy with no parameters of its own keeps neither: read back through the
# template's declaration it would name the template's own function.
keepMonoFnGeneric: function {st: zenv.ZSymbolTable srcId: ztypes.tid newFnId: ztypes.tid} is {
    srcDecl: st.typing.declIdOfType typeId: srcId
    if (st.reg.genericParamCountOf tdecl: srcDecl) == 0 then return
    newDecl: st.typing.declIdOfType typeId: newFnId
    if newDecl.isZero then return
    st.reg.setGeneric typeId: newFnId value: true
    st.reg.copyGenericParams from: srcDecl to: newDecl
    st.typing.unitFnTemplate.set key: newFnId value: srcId
    frn: (st.typing.funcReturnNode.get key: srcId).or d: zast.nodeid
    if frn.notZero then st.typing.funcReturnNode.set key: newFnId value: frn
}

# checkString -- a non-interpolated string literal types as textliteral, which
# its destination converts; an interpolated one (any non-chunk part) types as
# String, since it must allocate to splice the values, and each interpolated
# sub-expression is walked + stamped.
checkString: function {
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    ast: Ast
    node: strref
} out ztypes.tid is {
    result: ztypes.tid
    hasInterp: false
    k: u64
    for k < node.nparts loop {
        partId: zast.stringPartAt :ast nid: node.nid i: k
        k = k + 1
        arm: rowArmAt :ast nid: partId
        match (
            arm
        ) case stringchunk then null else {
            hasInterp = true
            moves.checkInterpPart :st :unitDecl :ast :partId
        }
    }
    # the runtime value is always the SYSTEM String/StringView (the interp
    # machinery and the literal pool build system strings), so the stamp is
    # canonical even in a unit that shadows the name
    tyOpt: optionval.none ztypes.tid
    if hasInterp then {
        tyOpt = stdtypes.stdTidOpt :ast :st wk: zast.wellKnown.slot.tyString
    } else {
        tyOpt = optionval.some st.reg.literalTextTid
    }
    if tyOpt.some then {
        result = tyOpt
        setk: result
        stampGate :st nid: node.nid tid: setk
    }
    return result
}

# mintMonoTagShape -- give a monomorphised sum type its discriminator: the tag
# width its template declares, and for a variant the ordinal each arm carries.
mintMonoTagShape: function {
    st: zenv.ZSymbolTable
    mid: ztypes.tid
    tt: ztypes.ztypetype
    name: StringView
} is {
    wantTag: tt.isSum
    if wantTag then {
        tagId: mintSumTag :st defName: name source: (tagsource row: 0 decl: ztypes.declid)
        (
            st.typing.declSynthMember
            parentTypeId: mid
            nameId: zast.wellKnown.slot.wkTag
            kind: ztyping.declkind.fieldDecl
        )
        (
            st.typing.setMemberType
            parentTypeId: mid
            nameId: zast.wellKnown.slot.wkTag
            childTypeId: tagId
        )
    }
}

# synthInstanceValueMembers -- the comparison pair and the `hash` an instance of
# a generic record or variant carries. The template itself is given none -- its
# fields have no types yet -- so the instance takes them on the template's
# terms: `==: null` strikes the pair, a member the template writes keeps its
# own, and `hash: null` strikes the hash. str and array own theirs.
synthInstanceValueMembers: function {
    ast: Ast
    st: zenv.ZSymbolTable
    templateId: ztypes.tid
    mid: ztypes.tid
    tt: ztypes.ztypetype
} is {
    isRec: tt == ztypes.ztypetype.recordType
    if isRec.not when tt != ztypes.ztypetype.variantType then return
    if isRec when (
        (templateId == (stdTid :ast :st wk: zast.wellKnown.slot.tyStr)) or
        (templateId == (stdTid :ast :st wk: zast.wellKnown.slot.tyArray))
    ) then return
    mt: mid
    forceMemberOf :st :ast parentTypeId: mt nameId: zast.wellKnown.slot.wkOpEq
    forceMemberOf :st :ast parentTypeId: mt nameId: zast.wellKnown.slot.wkOpNe
    forceMemberOf :st :ast parentTypeId: mt nameId: zast.wellKnown.slot.wkHash
    hasHash: (st.typing.declChildOfId parentTypeId: mt nameId: zast.wellKnown.slot.wkHash).some
    (
        synthValueMembers
        :st
        :ast
        ownerTid: mid
        ownerDecl: (st.typing.declIdOfType typeId: templateId)
        asItems: (templateAsItems :st :ast :templateId)
        pairOk: true
        eqDecl: false
        neDecl: false
        hashOk: hasHash.not
    )
}

# templateAsItems -- the as-block items a template's own declaration writes,
# empty when there is no declaration to read.
templateAsItems: function {
    st: zenv.ZSymbolTable.view ast: Ast templateId: ztypes.tid
} out zast.kidspan is {
    none: zast.kidspan first: 0 count: 0
    td: st.typing.declIdOfType typeId: templateId
    if td.isZero then return none
    dn: (st.typing.decls.get i: td).node
    ar: argRefAt :ast nid: dn
    if ar.nid.isZero then return (objAsItemsOf :ast nid: dn)
    return (objAsItemsOf :ast nid: ar.operation)
}

# constraintKindForId -- classify a constraint by its bound's NAME ID once, at
# registration; the checks then compare the tag. These are the names the system
# and core units declare the families under; a bound whose bare name reaches a
# program's own declaration instead is no family, which both readers ask of
# familyNameTaken. A scalar name is a numeric bound; any other name, or a bound
# named through a path (id 0), is a declaration the bound check finds by name.
constraintKindForId: function {id: zast.nameid} out ztypes.constraintkind is {
    if id == zast.wellKnown.slot.tyAnyval then return ztypes.constraintkind.valType
    if id == zast.wellKnown.slot.tyAnyRef then return ztypes.constraintkind.refType
    if id == zast.wellKnown.slot.tyValhashable then return ztypes.constraintkind.valHashable
    if id == zast.wellKnown.slot.tyRefHashable then return ztypes.constraintkind.refHashable
    if id == zast.wellKnown.slot.tyStaticindex then return ztypes.constraintkind.staticIndex
    if id == zast.wellKnown.slot.tyStaticmember then return ztypes.constraintkind.staticMember
    if id == zast.wellKnown.slot.tyStringLike then return ztypes.constraintkind.stringLike
    if (constraintIntKindId :id).has then return ztypes.constraintkind.numeric
    return ztypes.constraintkind.other
}

# constraintIntKindId -- the integer type an integer-scalar generic-param bound
# names (`u32`, `i64`, `c8`), by its name id; `has` false for any other bound, a
# float or a 128-bit type included (a numeric argument on such a parameter stays
# on the name-keyed path).
constraintIntKindId: function {id: zast.nameid} out ztypes.suffixinfo is {
    nk: scalarKindOfNameId :id
    if nk.has.not then return nk
    if (ztypes.isFloatKind k: nk.kind) then nk.has = false
    if (
        (nk.kind == ztypes.numkind.i128Type) or (nk.kind == ztypes.numkind.u128Type)
    ) then nk.has = false
    return nk
}

# scalarKindOfNameId -- the scalar kind name id `id` spells, by its position in
# zast.wellKnown's ty* run; `has` false for any other name.
scalarKindOfNameId: function {id: zast.nameid} out ztypes.suffixinfo is {
    if (memberaccess.isScalarNameId :id).not then return (
        ztypes.suffixinfo
        has: false
        kind: ztypes.numkind.i64Type
        len: 0
    )
    return (ztypes.numkindAt k: id.u64 - zast.wellKnown.slot.tyI8.u64)
}

# reportConstraintUnmet -- a constraint refusal, at the call that inferred the
# argument when there is one, else with no position.
reportConstraintUnmet: function {
    st: zenv.ZSymbolTable
    at: zast.nodeid
    lineno: u32
    colno: u32
    msg: String
} is {
    if lineno == 0 then {
        # minted with no position of its own: the statement that asked for it
        if st.walk.bounds.siteLine == 0 then {
            addResolveError :st e: zast.err.genericError :msg
            return
        }
        (
            addResolveErrorAt
            :st
            nodeid: st.walk.bounds.siteNid
            lineno: st.walk.bounds.siteLine
            colno: st.walk.bounds.siteCol
            e: zast.err.genericError
            :msg
            width: 1
        )
        return
    }
    addResolveErrorAt :st nodeid: at :lineno :colno e: zast.err.genericError :msg width: 1
}

# boundIsFamily -- the bound is one of the families, which answer for
# themselves: a family's name, written qualified or reaching no declaration of
# the program's own (familyNameTaken).
boundIsFamily: function {
    # the checked program
    st: zenv.ZSymbolTable.view
    # the template the bound is written on
    tdecl: ztypes.declid
    # the bound's name, interned
    nameId: zast.nameid
    # the unit name a qualified bound is reached through, 0 for a bare one
    qualId: zast.nameid
} out bool is {
    if (constraintKindForId id: nameId) == ztypes.constraintkind.other then return false
    if qualId.notZero then return true
    return (familyNameTaken :st :tdecl :nameId).not
}

# genericParamInScope -- the GENERIC_PARAM type a bare name denotes when it is a
# type parameter of a declaration at or enclosing `scope`, recorded against node
# `nid`, or the target when it is an alias of an enclosing type. 0 when no
# enclosing declaration has a parameter or an alias of that name, and for a
# numeric parameter, which is a value.
genericParamInScope: function {
    st: zenv.ZSymbolTable
    ast: Ast
    scope: ztypes.declid
    nameId: zast.nameid
    nid: zast.nodeid
} out ztypes.tid is {
    if nameId.isZero then return ztypes.tid.zero
    cur: scope
    for cur.notZero loop {
        if (st.reg.isGenericParamOf tdecl: cur name: nameId) then {
            if (st.reg.genericParamConstraintOf tdecl: cur paramName: nameId
            ).numKind.has then return ztypes.tid.zero
            recordGenericParamRef :st :nid scope: cur name: nameId
            return (genericParamTidMint :st :ast tdecl: cur :nameId)
        }
        # an enclosing type's alias, as near as its parameters
        at: memberaccess.typeDeclAliasTid :st :ast decl: cur :nameId
        if at.notZero then return at
        cur = st.typing.declParentOf declId: cur
    }
    return ztypes.tid.zero
}

# genericParamTidMint -- the canonical GENERIC_PARAM type of `tdecl`'s parameter
# `nameId`, minted on first ask.
genericParamTidMint: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    tdecl: ztypes.declid
    nameId: zast.nameid
} out ztypes.tid is {
    po: st.reg.genericParamTidOf :tdecl paramName: nameId
    if po.some then {
        return po
    }
    pt: ztypes.tid
    nT: zast.nameTextAt :ast ref: nameId
    pt = st.reg.newType name: nT.stringView typetype: ztypes.ztypetype.genericParam
    st.reg.setGenericParamTid :tdecl paramName: nameId tid: pt
    return pt
}

# genericParamSubjectTid -- the GENERIC_PARAM type a `match t` subject names,
# once the declaration that owns the parameter is known. 0 when the
# declaration has no parameter of that name.
genericParamSubjectTid: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    casenode: caseref
    gdecl: ztypes.declid
    gid: zast.nameid
} out ztypes.tid is {
    subjT: genericParamTidMint :st :ast tdecl: gdecl nameId: gid
    gsnid: stampNodeId n: (ast.nodes.get i: casenode.subject)
    if gsnid.notZero when subjT.notZero then {
        # direct write, NOT stampGate: this genericParam stamp IS
        # the dissection marker the emitter dispatches on -- it
        # must replace the substituted stamp the general subject walk
        # wrote (the canonical param tid is in monoParamSubst now, so
        # stampGate substitutes it)
        setgs: subjT
        ztyping.nodeTypeSet tbl: st.typing.nodeType nid: gsnid tid: setgs
    }
    return subjT
}

# rowarm -- which arm a value or statement row holds: the dispatch tag that
# checkValueAt and checkStmtInner read without keeping the row view.
rowarm: variant {
    # the row holds a call
    call: null
    # the row holds an atomid
    atomid: null
    # the row holds an atomstring
    atomstring: null
    # the row holds a dottedpath
    dottedpath: null
    # the row holds a caseexpr
    caseexpr: null
    # the row holds an ifexpr
    ifexpr: null
    # the row holds a forexpr
    forexpr: null
    # the row holds a labelvalue
    labelvalue: null
    # the row holds a doexpr
    doexpr: null
    # the row holds a withexpr
    withexpr: null
    # the row holds a reassignment
    reassignment: null
    # the row holds a swapstmt
    swapstmt: null
    # the row holds an assignment
    assignment: null
    # the row holds a stringchunk
    stringchunk: null
    # the row holds a functiondef
    functiondef: null
    # the row holds an objectdef
    objectdef: null
    # the row holds a list definition, `list { ... }`
    listblock: null
    # the row holds an unitdef
    unitdef: null
    # the row holds an other
    other: null
}

# rowArmAt -- the arm tag of row `nid`; the row view is this frame's and
# dies here.
rowArmAt: function {ast: Ast.view nid: zast.nodeid} out rowarm is {
    n: ast.nodes.get i: nid
    match (
        n
    ) case call then {
        return rowarm.call
    } case atomid then {
        return rowarm.atomid
    } case atomstring then {
        return rowarm.atomstring
    } case dottedpath then {
        return rowarm.dottedpath
    } case caseexpr then {
        return rowarm.caseexpr
    } case ifexpr then {
        return rowarm.ifexpr
    } case forexpr then {
        return rowarm.forexpr
    } case labelvalue then {
        return rowarm.labelvalue
    } case doexpr then {
        return rowarm.doexpr
    } case withexpr then {
        return rowarm.withexpr
    } case reassignment then {
        return rowarm.reassignment
    } case swapstmt then {
        return rowarm.swapstmt
    } case assignment then {
        return rowarm.assignment
    } case stringchunk then {
        return rowarm.stringchunk
    } case functiondef then {
        return rowarm.functiondef
    } case objectdef then {
        return rowarm.objectdef
    } case listblock then {
        return rowarm.listblock
    } case unitdef then {
        return rowarm.unitdef
    } else {
        return rowarm.other
    }
}

# fnRefOf -- the function row `fnode` as plain values.
fnRefOf: function {fnode: zast.functionrow.view} out fnref is {
    return (
        fnref
        nid: fnode.nodeid
        returntype: fnode.returntype
        nparams: fnode.parameters.count
        body: fnode.body
        isNative: fnode.isNative
        pins: fnode.pins
        lineno: fnode.lineno
        colno: fnode.colno
    )
}

# objref -- what a definition walk reads of an object-definition row: the
# kind, the is/as item counts, the native flag and the position, as plain
# values. Items are read by index through zast.objIsItemAt / objAsItemAt.
objref: record {
    # the type definition node this was read from
    nid: zast.nodeid
    # which of the six object definitions it is
    kind: zast.objectkind
    # how many is-block members it has
    nis: u64
    # how many as-block members
    nas: u64
    # whether the runtime owns the layout
    isNative: bool
    # the line to report this type definition against
    lineno: u32
    # the column to report this type definition against
    colno: u32
}

# objRefOf -- the object-definition row `o` as plain values.
objRefOf: function {o: zast.objectdefrow.view} out objref is {
    return (
        objref
        nid: o.nodeid
        kind: o.kind
        nis: o.isItems.count
        nas: o.asItems.count
        isNative: o.isNative
        lineno: o.lineno
        colno: o.colno
    )
}

# objRefAt -- the object-definition row `nid` as plain values (all zero for
# any other arm).
objRefAt: function {ast: Ast.view nid: zast.nodeid} out objref is {
    n: ast.nodes.get i: nid
    if n.objectdef then return (objRefOf o: n)
    zn: zast.nodeid
    return (
        objref
        nid: zn
        kind: zast.objectkind.recordDef
        nis: 0
        nas: 0
        isNative: false
        lineno: 0
        colno: 0
    )
}

# asItemNamesNoValue -- the `as` item `item` of the type declared by `typeDecl`
# is no value of the type: a method, a generic parameter, an implementation
# (`r: Reader.implement`, or a label marker `:Reader`), the tag spec, or an
# opt-out (`create: null`). Every other item is a constant.
asItemNamesNoValue: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    typeDecl: ztypes.declid
    item: argref
} out bool is {
    if item.name == zast.wellKnown.slot.wkTag then return true
    if (zast.implementBaseOf :ast opId: item.operation).notZero then return true
    op: ast.nodes.get i: item.operation
    if op.functiondef or (isBareGenericParam :ast :op) or (isLabelValue :op) then return true
    return (namesNullType :st :ast ownerDecl: typeDecl nameId: (zast.atomNameIdOf n: op))
}

# typedefOverNumericDecl -- the callee `callableId` names a declaration written
# `X: typedef <numeric type>`, read off the DECLARATION: a shape question asked
# before the typedef's own type may have resolved (a signature naming a constant
# reaches it early), which the parse already answers.
typedefOverNumericDecl: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
    scope: ztypes.declid
    callableId: zast.nodeid
} out bool is {
    cnId: atomNameId :ast n: (ast.nodes.get i: callableId)
    if cnId.isZero then return false
    return (namesNumericTypedefDecl :st :ast :unitDecl :scope nameId: cnId depth: 0)
}

# namesNumericTypedefDecl -- `nameId` names a unit declaration written `X:
# typedef B`, where B is a scalar or, by the same question, a typedef over one
# (`deep: typedef plain`): by the written names, the shape the parse answers;
# numericTypedefNamed then asks the resolved chain itself. A chain deeper than
# any written one answers no, and the construction is refused as no numeric
# typedef's.
namesNumericTypedefDecl: function {
    st: zenv.ZSymbolTable.view
    ast: Ast.view
    unitDecl: ztypes.declid
    scope: ztypes.declid
    nameId: zast.nameid
    depth: u64
} out bool is {
    if depth > 64 then return false
    d: declOfUnitDef :st :unitDecl :scope :nameId
    if d.isZero then return false
    dn: (st.typing.decls.get i: d).node
    if dn.isZero then return false
    opId: zast.nodeid
    {
        n: ast.nodes.get i: dn
        if n.namedoperation then opId = n.operation
    }
    if opId.isZero then return false
    o: objRefAt :ast nid: opId
    if o.nid.isZero then return false
    b: objectTypedefBaseId :ast onode: o
    if b.isZero then return false
    if (memberaccess.isScalarNameId id: b) then return true
    return (namesNumericTypedefDecl :st :ast :unitDecl :scope nameId: b depth: depth + 1)
}

# numericTypedefNamed -- the typedef over a numeric type the callee `callableId`
# names, 0 when it names anything else.
numericTypedefNamed: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    callableId: zast.nodeid
} out ztypes.tid is {
    # the declaration answers first, so nothing is minted for a callee that
    # is no typedef; the type then resolves on demand, as a reference's would
    if (typedefOverNumericDecl :st :ast :unitDecl :scope :callableId).not then return ztypes.tid
    cnId: atomNameId :ast n: (ast.nodes.get i: callableId)
    tdTid: (
        ztypes.tid.create
        from: (resolve.resolveNamedTypeId :st :ast :unitDecl :scope nameId: cnId thisName: "")
    )
    if (st.typing.typedefBaseTidOf tid: tdTid).isZero then return ztypes.tid
    end: conform.typedefChaseTid typing: st.typing tid: tdTid
    if (numerics.isNumericTid :st tid: end).not then return ztypes.tid
    return tdTid
}

# refuseTypedefArgument -- the refusal a typedef's construction gives an
# argument of type `got` where its base is `base`: in a body
# (callchecks.checkCastFromType) and in a constant (constOfNumericTypedef) alike
refuseTypedefArgument: function {
    st: zenv.ZSymbolTable
    ast: Ast.view
    base: ztypes.tid
    got: ztypes.tid
    valueId: zast.nodeid
    vl: u32
    vc: u32
} is {
    en: specWrittenName :st :ast tid: base
    an: specWrittenName :st :ast tid: got
    (
        addErrorWithHint
        :st
        nodeid: valueId
        lineno: vl
        colno: vc
        e: zast.err.callError
        msg: "argument 'from' type mismatch: expected \{en}, got \{an}"
        note: "a typedef is constructed from exactly its base type".string
        hint: "convert the value to \{en} first"
        width: 1
    )
}

# constOfNumericTypedef -- a typedef over a numeric type applied to one value
# (`NONE: rid 0`, `rid from: 0`): that value, carrying the typedef as its type.
# A typedef costs nothing at run time, so its constant is its base's. The rule
# is a body's: a typedef constructs from exactly its base, or from itself. A
# typed value must be one of the two; an untyped literal fits a scalar base as
# a literal written there would, and a typedef base (`deep: typedef plain`)
# takes no literal. noConst when the callee is no numeric typedef.
constOfNumericTypedef: function {
    st: zenv.ZSymbolTable
    scope: ztypes.declid
    ast: Ast
    unitDecl: ztypes.declid
    callableId: zast.nodeid
    args: (ListVal zast.nodeid).view
} out ztypes.cval is {
    if args.length != 1 then return ztypes.noConst
    tdTid: numericTypedefNamed :st :scope :ast :unitDecl :callableId
    if tdTid.isZero then return ztypes.noConst
    base: st.typing.typedefBaseTidOf tid: tdTid
    # the one argument: written bare, or labelled `from`
    valueId: args.get i: 0
    {
        an: ast.nodes.get i: valueId
        if an.namedoperation then {
            # a positional argument is a named operation with no name
            if an.name.notZero when (an.name == zast.wellKnown.slot.wkFrom).not then {
                return ztypes.noConst
            }
            valueId = an.operation
        }
    }
    v: statics.evalConstNode :st :scope :ast :unitDecl nid: valueId
    if (v.kind.ivalKind or v.kind.fvalKind).not then return ztypes.noConst
    vl: nodeLine n: (ast.nodes.get i: valueId)
    vc: nodeCol n: (ast.nodes.get i: valueId)
    if v.numTid.notZero when v.numTid != base when v.numTid != tdTid then {
        refuseTypedefArgument :st :ast :base got: v.numTid :valueId :vl :vc
        return ztypes.noConst
    }
    if v.numTid.isZero when (st.typing.typedefBaseTidOf tid: base).notZero then {
        lit: st.reg.literalIntTid
        if v.kind.fvalKind then lit = st.reg.literalFloatTid
        refuseTypedefArgument :st :ast :base got: lit :valueId :vl :vc
        return ztypes.noConst
    }
    fm: numerics.constFitsType :st :v target: base
    if fm.length > 0 then {
        addError :st nodeid: valueId lineno: vl colno: vc e: zast.err.typeError msg: fm
        return ztypes.noConst
    }
    r: v
    r.numTid = tdTid
    return r
}

# declLinkTemplateMethod -- a generic unit template's method is minted under a
# mangled `Tmpl_fn` name that no top-level def carries, so linkDeclType cannot
# find a declaration for it and the function type ends up with none. Bind the
# template's own method declaration to that type, which makes its parameters --
# indexed in AST order at pre-index time -- reachable from the type id. The
# template's Decl is passed IN: a template declared inside a namespace is not a
# child of its unit root, so no (unit, name) pair reaches it.
declLinkTemplateMethod: function {
    st: zenv.ZSymbolTable
    tmplDeclId: ztypes.declid
    memberNameId: zast.nameid
    fnTid: ztypes.tid
} is {
    if fnTid.isZero then return
    if (st.typing.declIdOfType typeId: fnTid).notZero then return
    if tmplDeclId.isZero then return
    md: st.typing.declFindChild parentDeclId: tmplDeclId nameId: memberNameId
    if md.isZero then return
    st.typing.declSetType declId: md typeId: fnTid
}

# resolvedByIdsMember -- `unit.def.member` from ids: the unit-level
# definition, then one more child edge. It serves the unit's two
# three-segment keys, so the walk needs no arbitrary segment count.
resolvedByIdsMember: function {
    ast: Ast.view
    st: zenv.ZSymbolTable
    unitDecl: ztypes.declid
    defId: zast.nameid
    memberId: zast.nameid
} out optionval ztypes.tid is {
    decl: resolve.resolvedByIds :st :ast :unitDecl name: defId
    if decl.some then {
        return (st.typing.declChildOfId parentTypeId: decl nameId: memberId)
    }
    return (optionval.none ztypes.tid)
}
